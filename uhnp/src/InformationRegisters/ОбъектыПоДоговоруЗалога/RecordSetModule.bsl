
Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТипыИнвентарныйУчет = Новый Массив; 
	ТипыИнвентарныйУчет.Добавить(ВстраиваниеУХКлиентСервер.ПолучитьТипОС());
	ТипыИнвентарныйУчет.Добавить(Тип("СправочникСсылка.НематериальныеАктивы"));
	ТипыИнвентарныйУчет.Добавить(Тип("СправочникСсылка.ОбъектыСтроительства"));
	
	Для каждого Запись Из ЭтотОбъект Цикл
	
		Если Запись.Период > Запись.ДатаОкончания Тогда
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(
								"Дата окончания залога объекта не может быть меньше даты начала!",
								Отказ);
			
		КонецЕсли;
							
		Если (Запись.Количество = 0) И (ТипыИнвентарныйУчет.Найти(ТипЗнч(Запись.ОбъектЗалога)) <> Неопределено) Тогда
		    Запись.Количество = 1; //у объектов инвентарного учета колонку Количество можно скрыть
		КонецЕсли;					
	
	КонецЦикла;
	
КонецПроцедуры
 
