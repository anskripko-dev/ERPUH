#Область ПрограммныйИнтерфейс

Процедура ЗаписатьОбъектыЗалога(ОбъектЗалога, МенеджерЗаписи, Отказ = Ложь) Экспорт

	Если МенеджерЗаписи.ДоговорЗалога.Пустая() Тогда
		
		Если МенеджерЗаписи.Выбран() Тогда
			
			Попытка
				
				МенеджерЗаписи.Удалить();
				
			Исключение
				
				ОбщегоНазначенияУХ.СообщитьОбОшибке("Не удалось удалить информацию об объекте залога", Отказ);
				Сообщить(ОписаниеОшибки());
				
			КонецПопытки;
		
		КонецЕсли;
		
	Иначе
		
		МенеджерЗаписи.ОбъектЗалога = ОбъектЗалога;
		Попытка
			
			МенеджерЗаписи.Записать();
			
		Исключение
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке("Не удалось сохранить информацию об объекте залога", Отказ);
			Сообщить(ОписаниеОшибки());
			
		КонецПопытки;	
		
	КонецЕсли;

КонецПроцедуры


