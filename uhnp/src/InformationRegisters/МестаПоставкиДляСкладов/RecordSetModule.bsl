#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
	
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	мСклады = ЭтотОбъект.ВыгрузитьКолонку("Склад");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(МестаПоставкиДляСкладов.Склад) КАК Склад
		|ИЗ
		|	РегистрСведений.МестаПоставкиДляСкладов КАК МестаПоставкиДляСкладов
		|ГДЕ
		|	МестаПоставкиДляСкладов.Склад В(&мСклады)";
	
	Запрос.УстановитьПараметр("мСклады", мСклады);	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Отказ = Истина;
		
		ВыборкаЗаписей = РезультатЗапроса.Выбрать();
		ТекстОшибки = "";
		Пока ВыборкаЗаписей.Следующий() Цикл
			ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", ", ") + ВыборкаЗаписей.Склад;
		КонецЦикла;
		
		Сообщение = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru = 'Для складов: %ТекстОшибки% уже установлено место поставки.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТекстОшибки%", Строка(ТекстОшибки));
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры


#КонецЕсли