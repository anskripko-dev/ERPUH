#Область СлужебныйПрограммныйИнтерфейс

// Функция возвращает информацию о ключе
Функция ИнформацияОКлюче() Экспорт

	//
	Результат = Новый Структура;
	Результат.Вставить("СправочникМенеджер", Справочники.КлючиАналитикиПланированияПоставки);
	Результат.Вставить("СправочникМетаданные", Метаданные.Справочники.КлючиАналитикиПланированияПоставки);
	Результат.Вставить("СправочникИмя", Результат.СправочникМетаданные.Имя);
	Результат.Вставить("РегистрМетаданные", Метаданные.РегистрыСведений.АналитикаПланированияПоставки);
	Результат.Вставить("РегистрМенеджер", РегистрыСведений.АналитикаПланированияПоставки);
	Результат.Вставить("РегистрИмя", Результат.РегистрМетаданные.Имя);
	
	Результат.Вставить("ИмяПоляАналитика", "АналитикаПланированияПоставки");
	
	КонтрольУХКлючи.ДобавитьИзмеренияКлюча(Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает наименование ключа
Функция ПолучитьПолноеНаименованиеКлючаАналитики(МенеджерЗаписи) Экспорт
	
	Поля = Новый Массив;
	Поля.Добавить(СокрЛП(МенеджерЗаписи.Поставщик));
	Поля.Добавить(СокрЛП(МенеджерЗаписи.НоменклатураПоставщика));
	Поля.Добавить(СокрЛП(МенеджерЗаписи.СтранаПроисхождения));
	Поля.Добавить(СокрЛП(МенеджерЗаписи.СтранаПроизводителя));
	Поля.Добавить(СокрЛП(МенеджерЗаписи.СтавкаНДС));
	Поля.Добавить(СокрЛП(МенеджерЗаписи.Склад));
	Возврат СтрСоединить(Поля, "; ");
	
КонецФункции

// Функция получает элемент справочника - ключ аналитики планирования потребностей.
//
// Параметры:
//	ПараметрыАналитики     - Выборка, Структура - Содержит полями "Поставщик, НоменклатураПоставщика, СтавкаНДС, Склад, СтраныПроисхождения, СтранаПроизводителя":
//		* Поставщик    	   		- СправочникСсылка.Контрагенты
//		* НоменклатураПоставщика- ОпределяемыйТип.УсловиеОпалты
//		* СтавкаНДС        		- ПеречислениеСсылка.СтавкиНДС
//		* Склад            		- СправочникСсылка.Склады
//		* СтраныПроисхождения	- СправочникСсылка.ДоговорыКонтрагентов
//		* СтранаПроизводителя	- СправочникСсылка.ДоговорыКонтрагентов
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиАналитикиПланированияПоставки - Созданный элемент справочника.
//
Функция ЗначениеКлючаАналитики(ПараметрыАналитики) Экспорт

	КлючАналитики = Неопределено;
	
	НаборЗаписей = ПолучитьНаборЗаписей(ПараметрыАналитики);
	
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0
			И Не ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;

		Если НаборЗаписей.Количество() > 0
			И ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			КлючАналитики = НаборЗаписей[0].КлючАналитики;
		Иначе
			КлючАналитики = СоздатьКлючАналитики(ПараметрыАналитики);
		КонецЕсли;
	Иначе
		КлючАналитики = Справочники.КлючиАналитикиПланированияПоставки.ПустаяСсылка();
	КонецЕсли;

	Возврат КлючАналитики;
КонецФункции

// Функция получает элемент справочника - ключ аналитики планирования.
//
// Параметры:
//	ПараметрыАналитики - Выборка или Структура  с полями "Поставщик, НоменклатураПоставщика, СтавкаНДС, Склад, СтраныПроисхождения, СтранаПроизводителя".
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиАналитикиПланированияПоставки - Созданный элемент справочника.
//
Функция СоздатьКлючАналитики(ПараметрыАналитики, ЗаписьПриОбновленииИБ = Ложь) Экспорт
	
	Возврат КонтрольУХКлючи.СоздатьКлючАналитики(ИнформацияОКлюче(), ПараметрыАналитики);
	
КонецФункции

// Возвращает параметры генерации ключей аналитики. Используется в обработчиках обновления.
// Возвращаемое значение:
//	Структура - Структура содержит поля: ЕстьНеобработанныеКлючи, ИзмененаАналитика, СоздаватьНовыеКлючи.
Функция ПараметрыЗаполненияКлючейАналитики() Экспорт
	Возврат Новый Структура("ИзмененаАналитика,СоздаватьВКлючи", Ложь, Истина);
КонецФункции

// Заполняет поле АналитикаПланированияПоставки в коллекции, содержащей место поставки, СтавкаНДС, Склад,
// СтраныПроисхождения, СтранаПроизводителя.
//
// Параметры:
//
//	Коллекция - ТабличнаяЧасть - Коллекция, в которой производится заполнение аналитики учета потребностей.
//
//	ИменаПолей - Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля берется из имени ключа.
//		секция идентификации {Поставщик, НоменклатураПоставщика, СтавкаНДС, Склад, СтраныПроисхождения, СтранаПроизводителя, АналитикаПланированияПоставки},
//	
//	ПараметрыЗаполнения - Структура - см. метод ПараметрыЗаполненияКлючейАналитики()
//
// Пример 1:
//	ИменаПолей = РегистрыСведений.АналитикаПланированияПоставки.ИменаПолейКоллекцииПоУмолчанию();
//	РегистрыСведений.АналитикаПланированияПоставки.ЗаполнитьВКоллекции(ДвиженияОперации, ИменаПолей);
//
// Пример 2:
//	РегистрыСведений.АналитикаПланированияПоставки.ЗаполнитьВКоллекции(ДвиженияОперации);
//
Процедура ЗаполнитьВКоллекции(Коллекция, 
								ИменаПолей = Неопределено, ДополнитьКлюч = Ложь, ПараметрыЗаполнения = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = ПараметрыЗаполненияКлючейАналитики();
	КонецЕсли;
	
	Если ДополнитьКлюч Тогда
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейДополненияКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
	Иначе
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		
		Если ЗначениеЗаполнено(ИменаПолей.СтавкаНДС)
			И ТипЗнч(ИменаПолей.СтавкаНДС) = Тип("Структура")
			И ИменаПолей.СтавкаНДС.Свойство("Значение") Тогда
			Запрос.УстановитьПараметр("СтавкаНДС", ИменаПолей.СтавкаНДС.Значение);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИменаПолей.Склад)
			И ТипЗнч(ИменаПолей.Склад) = Тип("Структура")
			И ИменаПолей.Склад.Свойство("Значение") Тогда
			Запрос.УстановитьПараметр("Склад", ИменаПолей.Склад.Значение);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИменаПолей.СтранаПроисхождения)
			И ТипЗнч(ИменаПолей.СтранаПроисхождения) = Тип("Структура")
			И ИменаПолей.СтранаПроисхождения.Свойство("Значение") Тогда
			Запрос.УстановитьПараметр("СтранаПроисхождения", ИменаПолей.СтранаПроисхождения.Значение);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИменаПолей.СтранаПроизводителя)
			И ТипЗнч(ИменаПолей.СтранаПроизводителя) = Тип("Структура")
			И ИменаПолей.СтранаПроизводителя.Свойство("Значение") Тогда
			Запрос.УстановитьПараметр("СтранаПроизводителя", ИменаПолей.СтранаПроизводителя.Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.АналитикаПланированияПоставки) Тогда
			Если ПараметрыЗаполнения.СоздаватьВКлючи Тогда
				КлючАналитики = ЗначениеКлючаАналитики(Выборка);
			Иначе
				ТекстИсключения = НСтр("ru = 'Ошибка при заполнении ключей в коллекции: есть аналитики, по которым ключи еще не созданы.'");
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.КлючиАналитикиПланированияПоставки,
					,
					ТекстИсключения);
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
		Иначе
			КлючАналитики = Выборка.АналитикаПланированияПоставки;
		КонецЕсли;

		ПараметрыЗаполнения.ИзмененаАналитика = Истина;
		Если НЕ ПараметрыЗаполнения.ЗаполнятьКлючВКоллекции Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДополнитьКлюч Тогда
			Коллекция[Выборка.Индекс][ИменаПолей.ЗаполняемаяАналитикаПоставки] = КлючАналитики;
		Иначе
			Коллекция[Выборка.Индекс][ИменаПолей.АналитикаПланированияПоставки] = КлючАналитики;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики планирования потребностей.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля должно браться из имени ключа.
//		секция идентификации {Поставщик, НоменклатураПоставщика, СтавкаНДС, Склад, СтраныПроисхождения, СтранаПроизводителя, АналитикаПланированияПоставки},
//			все ключи заданы.
//
Функция ИменаПолейКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Поставщик",				"Поставщик");
	ИменаПолей.Вставить("НоменклатураПоставщика",	"НоменклатураПоставщика");
	ИменаПолей.Вставить("СтавкаНДС",				"СтавкаНДС");
	ИменаПолей.Вставить("Склад",					"Склад");
	ИменаПолей.Вставить("СтранаПроисхождения",		"СтранаПроисхождения");
	ИменаПолей.Вставить("СтранаПроизводителя",		"СтранаПроизводителя");
	ИменаПолей.Вставить("АналитикаПланированияПоставки",		"АналитикаПланированияПоставки");
	
	Возврат ИменаПолей;
КонецФункции

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики планирования потребностей.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//
Функция ИменаПолейДополненияКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("АналитикаПланированияПоставки", "АналитикаПланированияПоставки");
	ИменаПолей.Вставить("ЗаполняемаяАналитикаПоставки", "АналитикаПланированияПоставки");
	ИменаПолей.Вставить("Поставщик", "");
	ИменаПолей.Вставить("НоменклатураПоставщика", "");
	ИменаПолей.Вставить("СтавкаНДС", "");
	ИменаПолей.Вставить("Склад", "");
	ИменаПолей.Вставить("СтранаПроисхождения", "");
	ИменаПолей.Вставить("СтранаПроизводителя", "");
	
	Возврат ИменаПолей;   
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прочее

Функция ПолучитьНаборЗаписей(ПараметрыАналитики)
	
	// В параметрах аналитики могут быть не все свойства
	СтруктураАналитики = Новый Структура("Поставщик, НоменклатураПоставщика, СтавкаНДС, Склад, СтранаПроисхождения, СтранаПроизводителя");
	ЗаполнитьЗначенияСвойств(СтруктураАналитики, ПараметрыАналитики);
	Если НЕ ЗначениеЗаполнено(СтруктураАналитики.Поставщик) 
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.СтавкаНДС) Тогда
		Возврат Неопределено
	Иначе
		НаборЗаписей = РегистрыСведений.АналитикаПланированияПоставки.СоздатьНаборЗаписей();
		
		Для Каждого КлючЗначение Из СтруктураАналитики Цикл
			НаборЗаписей.Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
		КонецЦикла;
		
		НоваяСтрока = НаборЗаписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураАналитики, "Поставщик, НоменклатураПоставщика, СтавкаНДС, Склад, СтранаПроисхождения, СтранаПроизводителя");
		Возврат НаборЗаписей;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеКлючейАналитикиВКоллекции

Функция ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Коллекция.НомерСтроки - 1 КАК Индекс,
	|	&ПолеАналитикаПланирования КАК АналитикаПланированияПоставки,
	|	&ПолеПоставщик КАК Поставщик,
	|	&ПолеНоменклатураПоставщика КАК НоменклатураПоставщика,
	|	&ПолеСтавкаНДС КАК СтавкаНДС,
	|	&ПолеСклад КАК Склад,
	|	&ПолеСтраныПроисхождения КАК СтранаПроисхождения,
	|	&ПолеСтранаПроизводителя КАК СтранаПроизводителя
	|
	|ПОМЕСТИТЬ Коллекция
	|ИЗ &Коллекция КАК Коллекция
	|;
	|
	|ВЫБРАТЬ
	|	Коллекция.Индекс,
	|	Аналитика.КлючАналитики КАК АналитикаПланированияПоставки,
	|	Коллекция.Поставщик,
	|	Коллекция.НоменклатураПоставщика,
	|	Коллекция.СтавкаНДС,
	|	Коллекция.Склад,
	|	Коллекция.СтранаПроисхождения,
	|	Коллекция.СтранаПроизводителя
	|ИЗ
	|	Коллекция КАК Коллекция
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПоставки КАК Аналитика
	|		ПО Аналитика.Поставщик = Коллекция.Поставщик
	|		И Аналитика.НоменклатураПоставщика = Коллекция.НоменклатураПоставщика
	|		И Аналитика.СтавкаНДС = Коллекция.СтавкаНДС
	|		И Аналитика.Склад = Коллекция.Склад
	|		И Аналитика.СтранаПроисхождения = Коллекция.СтранаПроисхождения
	|		И Аналитика.СтранаПроизводителя = Коллекция.СтранаПроизводителя
	|ГДЕ
	|	Аналитика.КлючАналитики ЕСТЬ NULL
	|	ИЛИ Аналитика.КлючАналитики <> Коллекция.АналитикаПланированияПоставки
	|	ИЛИ Аналитика.КлючАналитики = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПоставки.ПустаяСсылка)";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаПланирования",	"Коллекция." + ИменаПолей.АналитикаПланированияПоставки);
	
	// Поле Поставщик может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.Поставщик) Тогда
		Если ТипЗнч(ИменаПолей.Поставщик) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПоставщик", ИменаПолей.Поставщик.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПоставщик", "Коллекция." + ИменаПолей.Поставщик);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПоставщик", "ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)");
	КонецЕсли; 
	
	// Поле НоменклатураПоставщика может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.НоменклатураПоставщика) Тогда
		Если ТипЗнч(ИменаПолей.НоменклатураПоставщика) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНоменклатураПоставщика", ИменаПолей.НоменклатураПоставщика.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНоменклатураПоставщика", "Коллекция." + ИменаПолей.НоменклатураПоставщика);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНоменклатураПоставщика", "ЗНАЧЕНИЕ(Справочник.НоменклатураПоставщиков.ПустаяСсылка)");
	КонецЕсли; 
	
	// Поле СтавкаНДС может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.СтавкаНДС) Тогда
		Если ТипЗнч(ИменаПолей.СтавкаНДС) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтавкаНДС", ИменаПолей.СтавкаНДС.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтавкаНДС", "Коллекция." + ИменаПолей.СтавкаНДС);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтавкаНДС", "ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)");
	КонецЕсли; 
	
	// Поле Склад может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.Склад) Тогда
		Если ТипЗнч(ИменаПолей.Склад) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСклад", ИменаПолей.Склад.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСклад", "Коллекция." + ИменаПолей.Склад);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСклад", "ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)");
	КонецЕсли; 
	
	// Поле СтраныПроисхождения может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.СтранаПроисхождения) Тогда
		Если ТипЗнч(ИменаПолей.СтранаПроисхождения) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтраныПроисхождения", ИменаПолей.СтранаПроисхождения.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтраныПроисхождения", "Коллекция." + ИменаПолей.СтранаПроисхождения);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтраныПроисхождения", "ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)");
	КонецЕсли; 
	
	// Поле СтранаПроизводителя может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.СтранаПроизводителя) Тогда
		Если ТипЗнч(ИменаПолей.СтранаПроизводителя) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтранаПроизводителя", ИменаПолей.СтранаПроизводителя.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтранаПроизводителя", "Коллекция." + ИменаПолей.СтранаПроизводителя);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтранаПроизводителя", "ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
КонецФункции

Функция ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Коллекция.НомерСтроки - 1 	КАК Индекс,
	|	&ПолеАналитика            	КАК АналитикаПланированияПоставки,
	|	&ПолеПриемник             	КАК АналитикаПоставкиПриемник,
	|	&ПолеПоставщик		  	  	КАК Поставщик,
	|	&ПолеНоменклатураПоставщика	КАК НоменклатураПоставщика,
	|	&ПолеСтавкаНДС			  	КАК СтавкаНДС,
	|	&ПолеСклад		  	  	  	КАК Склад,
	|	&ПолеСтраныПроисхождения	КАК СтранаПроисхождения,
	|	&ПолеСтранаПроизводителя	КАК СтранаПроизводителя
	|ПОМЕСТИТЬ ВтКоллекция
	|ИЗ &Коллекция КАК Коллекция
	|;
	|ВЫБРАТЬ
	|	Коллекция.Индекс                       КАК Индекс,
	|	Коллекция.АналитикаПланированияПоставки КАК АналитикаПланированияПоставки,
	|	Коллекция.АналитикаПоставкиПриемник КАК АналитикаПоставкиПриемник,
	|	ВЫБОР КОГДА Коллекция.Поставщик = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.Поставщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.Поставщик
	|	КОНЕЦ                                КАК Поставщик,
	
	|	ВЫБОР КОГДА Коллекция.НоменклатураПоставщика = &ПустаяНоменклатураПоставщика
	|		ТОГДА ЕСТЬNULL(Аналитика.НоменклатураПоставщика, &ПустаяНоменклатураПоставщика)
	|		ИНАЧЕ Коллекция.НоменклатураПоставщика
	|	КОНЕЦ                                КАК НоменклатураПоставщика,
	
	|	ВЫБОР КОГДА Коллекция.СтавкаНДС = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.СтавкаНДС, ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.СтавкаНДС
	|	КОНЕЦ                                КАК СтавкаНДС,
	|	ВЫБОР КОГДА Коллекция.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.Склад, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.Склад
	|	КОНЕЦ                                КАК Склад,
	|	ВЫБОР КОГДА Коллекция.СтранаПроисхождения = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.СтранаПроисхождения
	|	КОНЕЦ                                КАК СтранаПроисхождения,
	|	ВЫБОР КОГДА Коллекция.СтранаПроизводителя = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.СтранаПроизводителя, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.СтранаПроизводителя
	|	КОНЕЦ                                КАК СтранаПроизводителя
	|ПОМЕСТИТЬ Коллекция
	|ИЗ
	|	ВтКоллекция КАК Коллекция
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПоставки КАК Аналитика
	|	ПО Коллекция.АналитикаПланированияПоставки = Аналитика.КлючАналитики
	|;
	|ВЫБРАТЬ
	|	Коллекция.Индекс КАК Индекс,
	|	Ключи.КлючАналитики КАК АналитикаПланированияПоставки,
	|	Коллекция.Поставщик КАК Поставщик,
	|	Коллекция.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	Коллекция.СтавкаНДС КАК СтавкаНДС,
	|	Коллекция.Склад КАК Склад,
	|	Коллекция.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Коллекция.СтранаПроизводителя КАК СтранаПроизводителя
	|ИЗ
	|	Коллекция КАК Коллекция
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПоставки КАК Ключи
	|	ПО Ключи.Поставщик = Коллекция.Поставщик
	|		И Ключи.НоменклатураПоставщика = Коллекция.НоменклатураПоставщика
	|		И Ключи.СтавкаНДС = Коллекция.СтавкаНДС
	|		И Ключи.Склад = Коллекция.Склад
	|		И Ключи.СтранаПроисхождения = Коллекция.СтранаПроисхождения
	|		И Ключи.СтранаПроизводителя = Коллекция.СтранаПроизводителя
	|ГДЕ
	|	Ключи.КлючАналитики ЕСТЬ NULL
	|	ИЛИ Ключи.КлючАналитики <> Коллекция.АналитикаПланированияПоставки
	|	ИЛИ Коллекция.АналитикаПоставкиПриемник = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПоставки.ПустаяСсылка)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустаяНоменклатураПоставщика", "ЗНАЧЕНИЕ(Справочник.НоменклатураПоставщиков.ПустаяСсылка)");
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика", "Коллекция." + ИменаПолей.АналитикаПланированияПоставки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриемник", "Коллекция." + ИменаПолей.ЗаполняемаяАналитикаПоставки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПоставщик", ?(ЗначениеЗаполнено(ИменаПолей.Поставщик),"Коллекция." + ИменаПолей.Поставщик, "ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНоменклатураПоставщика", ?(ЗначениеЗаполнено(ИменаПолей.НоменклатураПоставщика),"Коллекция." + ИменаПолей.НоменклатураПоставщика, "ЗНАЧЕНИЕ(Справочник.НоменклатураПоставщиков.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтавкаНДС", ?(ЗначениеЗаполнено(ИменаПолей.СтавкаНДС),"Коллекция." + ИменаПолей.СтавкаНДС, "ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСклад", ?(ЗначениеЗаполнено(ИменаПолей.Склад),"Коллекция." + ИменаПолей.Склад, "ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтраныПроисхождения", ?(ЗначениеЗаполнено(ИменаПолей.СтранаПроисхождения),"Коллекция." + ИменаПолей.СтранаПроисхождения, "ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтранаПроизводителя", ?(ЗначениеЗаполнено(ИменаПолей.СтранаПроизводителя),"Коллекция." + ИменаПолей.СтранаПроизводителя, "ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)"));
	
	Возврат ТекстЗапроса;
КонецФункции

#КонецОбласти

