
Процедура ЗагрузкаЗамен() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ

				   // НАЧАЛО Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170
	               |	Замены.ГУИДОбъекта КАК ГУИДОбъекта,
	               |	Замены.ТипОбъекта КАК ТипОбъекта
	               |ПОМЕСТИТЬ ЗаписиНаУдаление
	               |ИЗ
	               |	РегистрСведений.тн_Замены КАК Замены
	               |ГДЕ
	               |	&УсловиеЗамены
	               |	И Замены.ДатаЗаписи <> ДАТАВРЕМЯ(1, 1, 1)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   // КОНЕЦ Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170
				   
	               |	Замены.ГУИДОбъекта КАК ГУИДОбъекта,
	               |	Замены.ТипОбъекта КАК ТипОбъекта,
	               |	Замены.ГУИДОбъектаЦБ КАК ГУИДОбъектаЦБ,
	               |	Замены.ТипОбъектаЦБ КАК ТипОбъектаЦБ

				   // НАЧАЛО Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170
	               |   ,НЕ ЗаписиНаУдаление.ГУИДОбъекта ЕСТЬ NULL КАК Удалить
				   // КОНЕЦ Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170
				   
	               |ИЗ
    			   // НАЧАЛО Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170
				   //|	РегистрСведений.тн_Замены КАК Замены";
	               |	РегистрСведений.тн_Замены КАК Замены
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЗаписиНаУдаление КАК ЗаписиНаУдаление
	               |		ПО Замены.ГУИДОбъекта = ЗаписиНаУдаление.ГУИДОбъекта
	               |			И Замены.ТипОбъекта = ЗаписиНаУдаление.ТипОбъекта";

	ДнейХранения = Константы.тн_КоличествоДнейДляХраненияИсторииПоЗаменам.Получить();
	
	Если ДнейХранения = 0 Тогда
		УсловиеЗамены = "ЛОЖЬ";
	Иначе
		
		Запрос.УстановитьПараметр("ДатаУдаления", НачалоДня(ТекущаяДатаСеанса() - ДнейХранения * 24 * 60 * 60));
		УсловиеЗамены = "Замены.ДатаЗаписи <= &ДатаУдаления";
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЗамены", УсловиеЗамены);
	// КОНЕЦ Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Метаданные.Справочники.Найти(Выборка.ТипОбъекта) = Неопределено
			Или Метаданные.Справочники.Найти(Выборка.ТипОбъектаЦБ) = Неопределено Тогда
			Продолжить;   			
		КонецЕсли;
		
		ЧтоЗаменить = Справочники[Выборка.ТипОбъекта].ПолучитьСсылку(Выборка.ГУИДОбъекта);
		НаЧтоЗаменить = Справочники[Выборка.ТипОбъектаЦБ].ПолучитьСсылку(Выборка.ГУИДОбъектаЦБ);
		
		Если Не ОбщегоНазначенияУХ.СсылкаСуществует(ЧтоЗаменить)
			Или Не ОбщегоНазначенияУХ.СсылкаСуществует(НаЧтоЗаменить) Тогда

			// НАЧАЛО Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170
			Если Выборка.Удалить И НЕ ОбщегоНазначенияУХ.СсылкаСуществует(ЧтоЗаменить) Тогда
				
				ЗаписьРегистра = РегистрыСведений.тн_Замены.СоздатьМенеджерЗаписи();
				ЗаписьРегистра.ГУИДОбъекта = Новый УникальныйИдентификатор(Выборка.ГУИДОбъекта); 
				ЗаписьРегистра.ТипОбъекта = Выборка.ТипОбъекта; 
				ЗаписьРегистра.Прочитать();
				ЗаписьРегистра.Удалить();
				
			КонецЕсли;
			// КОНЕЦ Одинец Р.Ю. 22.01.2024 Выполнение задач № 000048170

			Продолжить;
		КонецЕсли;
			
		НЗ = РегистрыСведений.тн_ЗаменяемыеОбъекты.СоздатьМенеджерЗаписи();
		НЗ.Объект = ЧтоЗаменить;
		
		НЗ.Прочитать();
		
		НЗ.Объект = ЧтоЗаменить; 			
		НЗ.ОбъектЦБ = НаЧтоЗаменить;
		
		НЗ.Записать();
			
	КонецЦикла;
		
КонецПроцедуры // ЗагрузкаЗамен()

Процедура ОчиститьЗамененные() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаменяемыеОбъекты.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.тн_ЗаменяемыеОбъекты КАК ЗаменяемыеОбъекты
	|ГДЕ
	|	ЗаменяемыеОбъекты.Объект = ЗаменяемыеОбъекты.ОбъектЦБ";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.тн_ЗаменяемыеОбъекты.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Значение = Выборка.Объект;
		НаборЗаписей.Отбор.Объект.Использование = Истина;
		НаборЗаписей.Записать();
			
	КонецЦикла;
		
КонецПроцедуры // ОчиститьЗамененные()           

//Ведутенко С.А. 29.09.2023 Выполнение задач № 000047019
//
Процедура УстановитьОбъектЦБ(Объект) Экспорт    
	
	МенеджерЗаписи  = РегистрыСведений.тн_ЗаменяемыеОбъекты.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.Прочитать(); 				
	
	Если МенеджерЗаписи.Выбран() Тогда 					
		МенеджерЗаписи.ОбъектЦБ = Объект;
		МенеджерЗаписи.Записать();					
	КонецЕсли;
	
КонецПроцедуры  

//Ведутенко С.А. 29.09.2023 Выполнение задач № 000047019
//
Процедура УстановитьСнятьВРаботе(Объект, ВРаботе) Экспорт    
	
	МенеджерЗаписи  = РегистрыСведений.тн_ЗаменяемыеОбъекты.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.Прочитать(); 				
	
	Если МенеджерЗаписи.Выбран() Тогда 					
		МенеджерЗаписи.ВРаботе = ВРаботе;
		МенеджерЗаписи.Записать();					
	КонецЕсли;
	
КонецПроцедуры  