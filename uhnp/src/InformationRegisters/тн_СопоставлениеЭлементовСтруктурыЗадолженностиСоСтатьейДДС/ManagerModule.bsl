
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Борисенко Игорь 25.07.2022 Выполнение задач №000042018
Функция ВернутьЭлементСтруктурыЗадолженности(СтатьяДДС = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(СтатьяДДС) Тогда
		Возврат Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтатьяДДС", СтатьяДДС);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тн_СопоставлениеЭлементовСтруктурыЗадолженностиСоСтатьейДДС.ЭлементыСтруктурыЗадолженности КАК ЭлементыСтруктурыЗадолженности
	|ИЗ
	|	РегистрСведений.тн_СопоставлениеЭлементовСтруктурыЗадолженностиСоСтатьейДДС КАК тн_СопоставлениеЭлементовСтруктурыЗадолженностиСоСтатьейДДС
	|ГДЕ
	|	тн_СопоставлениеЭлементовСтруктурыЗадолженностиСоСтатьейДДС.СтатьяДДС = &СтатьяДДС";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЭлементыСтруктурыЗадолженности = Выборка.ЭлементыСтруктурыЗадолженности;
	Иначе
		ЭлементыСтруктурыЗадолженности = Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
	КонецЕсли;
	
	Возврат ЭлементыСтруктурыЗадолженности;
	
КонецФункции    

#КонецЕсли