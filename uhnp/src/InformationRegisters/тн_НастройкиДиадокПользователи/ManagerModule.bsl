#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Османов Нагим 26.07.2022 Выполнение задач №000042020
Функция ПолучитьНастройкуПользователя(Пользователь, НаименованиеНастройки) Экспорт
	
	НастройкаРегистра = Метаданные.РегистрыСведений.тн_НастройкиДиадокПользователи.Ресурсы.Найти(НаименованиеНастройки);
	Если НастройкаРегистра = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ
	|	тн_НастройкиДиадокПользователи.%1 КАК ЗначениеНастройки
	|ИЗ
	|	РегистрСведений.тн_НастройкиДиадокПользователи КАК тн_НастройкиДиадокПользователи
	|ГДЕ
	|	тн_НастройкиДиадокПользователи.Пользователь = &Пользователь",
	НаименованиеНастройки);
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.ЗначениеНастройки;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Османов Нагим 26.07.2022 Выполнение задач №000042020
Функция ПолучитьНастройкуТекущегоПользователя(НаименованиеНастройки) Экспорт

	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Возврат ПолучитьНастройкуПользователя(Пользователь, НаименованиеНастройки);
	
КонецФункции

#КонецЕсли