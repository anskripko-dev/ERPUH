//~ Чекордина Ирина 06.06.2025 Выполнение задач №000053932: +БазаРеспондентИД
//Процедура ДобавитьСообщение(ТекстСообщения, ТипЗапроса, СвойстваСообщения, ИДСообщения = Неопределено) Экспорт // Юдина (Гутарова) Екатерина 04.04.2024 Выполнение задач №000049104  
Процедура ДобавитьСообщение(ТекстСообщения, ТипЗапроса, СвойстваСообщения, ИДСообщения = Неопределено, БазаРеспондентИД = Неопределено) Экспорт
		
	РегистрыСведений.ТН_Интеграция_ПриоритетыОбработкиСообщенийRMQ.ДобавитьТипЗапроса(ТипЗапроса);
	
	МенеджерЗаписи = РегистрыСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ.СоздатьМенеджерЗаписи();
	
	// Измерения 
	// НАЧАЛО Юдина (Гутарова) Екатерина 04.04.2024 Выполнение задач №000049104 
	//МенеджерЗаписи.ИДСообщения 					= Строка(Новый УникальныйИдентификатор); 
	МенеджерЗаписи.ИДСообщения 					= ?(ЗначениеЗаполнено(ИДСообщения), ИДСообщения, Строка(Новый УникальныйИдентификатор));
	// КОНЕЦ Юдина (Гутарова) Екатерина 04.04.2024 Выполнение задач №000049104 
	// Ресурсы
	МенеджерЗаписи.ТекстСообщения 				= ТекстСообщения;
	// НАЧАЛО Юдина Екатерина 28.10.2024 Выполнение задач №000051341
	МенеджерЗаписи.ХешСумма = ИнтеграцияИС.ХешированиеДанныхSHA256(ТекстСообщения);
	// КОНЕЦ Юдина Екатерина 28.10.2024 Выполнение задач №000051341 
	
	// Реквизиты
	МенеджерЗаписи.ТипЗапроса 					= ТипЗапроса;
	МенеджерЗаписи.СвойстваСообщения 			= СвойстваСообщения;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//МенеджерЗаписи.ДатаСообщения 				= тн_Интеграция_УПП.ТекущаяДатаСервера();
	МенеджерЗаписи.ДатаСообщения 				= ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	МенеджерЗаписи.УниверсальнаяДатаСообщения	= ТекущаяУниверсальнаяДатаВМиллисекундах();
	// НАЧАЛО Чекордина Ирина 06.06.2025 Выполнение задач №000053932
	МенеджерЗаписи.БазаРеспондентИД				= БазаРеспондентИД;
	// КОНЕЦ Чекордина Ирина 06.06.2025 Выполнение задач №000053932
	
	МенеджерЗаписи.Записать();
		
КонецПроцедуры // ДобавитьСообщение()

Процедура УдалитьСообщение(ИДСообщения) Экспорт
	
	РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.УдалитьСтатус(ИДСообщения);
	
	МенеджерЗаписи = РегистрыСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ.СоздатьМенеджерЗаписи();	
	МенеджерЗаписи.ИДСообщения = ИДСообщения; 	
	МенеджерЗаписи.Удалить();
		
КонецПроцедуры // УдалитьСообщение()

