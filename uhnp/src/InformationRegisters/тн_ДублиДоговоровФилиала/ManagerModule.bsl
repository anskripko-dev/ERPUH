Функция ПолучитьДоговорГоловнойОрганизации(ДоговорФилиала) Экспорт 
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	тн_ДублиДоговоровФилиала.ДоговорГоловнойОрганизации КАК ДоговорГоловнойОрганизации
	               |ИЗ
	               |	РегистрСведений.тн_ДублиДоговоровФилиала КАК тн_ДублиДоговоровФилиала
	               |ГДЕ
	               |	тн_ДублиДоговоровФилиала.ДоговорФилиала = &ДоговорФилиала
	               |	И тн_ДублиДоговоровФилиала.ДоговорФилиала.Организация <> тн_ДублиДоговоровФилиала.ДоговорГоловнойОрганизации.Организация";
	
	Запрос.УстановитьПараметр("ДоговорФилиала", ДоговорФилиала);
	Выборка = Запрос.Выполнить().Выбрать();				
	Если Выборка.Следующий() Тогда 
		Результат = Выборка.ДоговорГоловнойОрганизации; 	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

