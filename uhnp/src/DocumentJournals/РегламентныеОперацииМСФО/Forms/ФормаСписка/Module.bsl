
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда		
		
		ТипВНА = "ДокументСсылка.РегламентнаяОперацияПериодаВНАМСФО";
		ТипПовтор = "ДокументСсылка.ПовторениеКорректировокПрошлыхПериодов";
		
	Иначе 
		
		ТипВНА = "Неопределено";
		ТипПовтор = "Неопределено";
		
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("РегламентнаяОперацияПериодаВНАМСФО", Тип(ТипВНА));
	Список.Параметры.УстановитьЗначениеПараметра("ПовторениеКорректировокПрошлыхПериодов", Тип(ТипПовтор));   
	
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРасчетСебестоимости", 
													НСтр("ru = 'Расчет Себестоимости'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстПереоценкаВалютныхАктивовОбязательств", 
													НСтр("ru = 'Переоценка валютных активов обязательств'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРеклассОтложенныхНалогов", 
													НСтр("ru = 'Рекласс отложенных налогов'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРасчетОтложенныхНалогов", 
													НСтр("ru = 'Расчет отложенных налогов'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРасчетРасчетФинансовогоРезультата", 
													НСтр("ru = 'Расчет финансового результата'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРеформацияБаланса", 
													НСтр("ru = 'Реформация баланса'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРеклассРеклассАПСчетов", 
													НСтр("ru = 'Рекласс активно-пассивных счетов'"));		
	Список.Параметры.УстановитьЗначениеПараметра("ТекстПовторениеКорректировокПрошлыхПериодов",  
													НСтр("ru = 'Повторение корректировок прошлых периодов'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРегламентнаяОперацияПериодаВНАМСФО",  
													НСтр("ru = 'Регламентная операция периода по внеоборотным активам'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстРегламентнаяОперацияПериодаПоФинансовымИнструментамМСФО",  
													НСтр("ru = 'Регламентная операция периода по финансовым инструментам'"));
	Список.Параметры.УстановитьЗначениеПараметра("ТекстПрочиеОперации",  
													НСтр("ru = 'Прочие операции'"));
		
КонецПроцедуры
