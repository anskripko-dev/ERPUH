
#Область СлужебныйПрограммныйИнтерфейс

#Область ВложенныеФормы

Функция ПараметрыВложеннойФормы(ПараметрыВложеннойФормы = Неопределено) Экспорт

	Если ПараметрыВложеннойФормы = Неопределено Тогда
		ПараметрыВложеннойФормы = Новый Структура("КоманднаяПанельВложеннойФормы", Новый Структура);
	КонецЕсли; 
	
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.Вставить("ДобавленныеКоманды", Новый Массив);
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.Вставить("ПараметрыПанели", 	Новый Структура); 
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.Вставить("ПараметрыФормы", 	Новый Структура);
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.ПараметрыПанели.Вставить("Имя", 		"ПанельУправленияПараметрами");
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.ПараметрыПанели.Вставить("Заголовок", "Командная панель вложенной формы");
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.ПараметрыПанели.Вставить("Вид", 		"ОбычнаяГруппа");
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.ПараметрыПанели.Вставить("Родитель", Неопределено);
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.ПараметрыПанели.Вставить("ПередЭлементом", Неопределено);
	
	Возврат ПараметрыВложеннойФормы;

КонецФункции // ПараметрыВложеннойФормы()

Функция КомандаВложеннойФормы(ИмяКоманды, Заголовок, Вид, Пометка, Действие, Группа) Экспорт

	Команда = Новый Структура("ИмяКоманды, Заголовок, Вид, Пометка, Действие, Группа");
	Команда.ИмяКоманды 	= ИмяКоманды; 
	Команда.Заголовок 	= Заголовок;
	Команда.Вид 		= Вид;
	Команда.Пометка 	= Пометка; 
	Команда.Действие 	= Действие;
	Команда.Группа 		= Группа;
	
	Возврат Команда;

КонецФункции // КомандаВложеннойФормы()    

