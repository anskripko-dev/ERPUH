// Белоконенко Денис 13.12.2022 Выполнение задач №000043671
Функция ДанныеДляОткрытияФормыДокумента(ДокументСсылка) Экспорт
	
	РезультатФункции = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Диадок_Документы.*
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	Диадок_Документы.Документ = &Документ
	|	И НЕ Диадок_Документы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();   
	// НАЧАЛО Мещеряков Алексей 23.05.2025 Выполнение задач №000053776
	
	//// НАЧАЛО Мещеряков Алексей 09.01.2025 Выполнение задач №000052237
	////ОбработкаКонтур = Обработки.КонтурЭДО.Создать(); 
	//ОбработкаКонтур = Обработки.КонтурЭДО_4_47.Создать(); 
	//// КОНЕЦ Мещеряков Алексей 09.01.2025 Выполнение задач №000052237

	ОбработкаКонтур = Обработки.КонтурДиадок.Создать();
	
	// КОНЕЦ Мещеряков Алексей 23.05.2025 Выполнение задач №000053776 
	
	ОбработкаКонтур.ИнициализироватьОбщийКонтекст();
	МодульЯдро = ОбработкаКонтур.Модуль_Ядро();
	
	СтрокиСпискаСтрокой = МодульЯдро.КолонкиСпискаДокументовСтрокой();
	СтруктураДанныхСтрокиСпискаСтрокой = Новый Структура(СтрокиСпискаСтрокой);
	ЗаполнитьЗначенияСвойств(СтруктураДанныхСтрокиСпискаСтрокой, Выборка);
	
	Возврат СтруктураДанныхСтрокиСпискаСтрокой;
	
КонецФункции

