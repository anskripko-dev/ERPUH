КонецПроцедуры

//Федоров С 03.09.2021 Выполнение задач №000038925
//Получаем уникальный идентификатор из шестидесятичетырехричного числа
Функция КонвертироватьЧисло64вГуид(Число64) Экспорт 
	
	число16 = ПолучитьЧисло16изЧисла2(ПолучитьЧисло2изЧисла64(Число64));
	если стрДлина(число16)>64 тогда 
		число16 = прав(Число16, 64);
	КонецЕсли;
	
	возврат  ПолучитьГуидИзЧисла16(Число16);
	
КонецФункции	

//Федоров С 03.09.2021 Выполнение задач №000038925
//Получаем уникальный идентификатор из шестнадцатиричного числа
Функция ПолучитьГуидИзЧисла16(Число16) Экспорт 
	
	Возврат сред(Число16, 1, 8)+"-"+сред(Число16, 9, 4)+"-"+сред(Число16, 13, 4)+"-"+сред(число16, 17, 4)+"-"+сред(число16, 21, 20)+"-"+сред(число16, 41, 4)+"-"+сред(число16, 45, 4)+"-"+сред(число16, 49, 4)+"-"+сред(число16, 53, 12);
	
КонецФункции

