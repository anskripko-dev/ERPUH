	               |ГДЕ
	               |	тн_РазрешенияСопоставленияЭДО.Пользователь = &ТекущийПользователь
	               |	И тн_РазрешенияСопоставленияЭДО.ДатаРазрешения <= &ТекущаяДата
	               |	И ДОБАВИТЬКДАТЕ(тн_РазрешенияСопоставленияЭДО.ДатаРазрешения, ДЕНЬ, тн_РазрешенияСопоставленияЭДО.СрокРазрешения) > &ТекущаяДата
	               |	И тн_РазрешенияСопоставленияЭДО.КонецПериодаРазрешения > &ДатаСФ
	               |	И &ДатаСФ > тн_РазрешенияСопоставленияЭДО.НачалоПериодаРазрешения";
	
	Запрос.УстановитьПараметр("ДатаСФ",ДатаСФ);
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата()); 
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДатаСервера());
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Запрос.УстановитьПараметр("ТекущийПользователь",Пользователи.ТекущийПользователь());
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции	

