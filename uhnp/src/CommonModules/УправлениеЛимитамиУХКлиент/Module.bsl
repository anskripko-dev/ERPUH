#Область СлужебныйПрограммныйИнтерфейс

Процедура НавигационнаяКомандаВложеннойФормы(Форма, Команда) Экспорт
	
	Если Форма.ВладелецФормы = Неопределено Тогда
		ОсновнаяФорма = Форма;
	Иначе
		ОсновнаяФорма = Форма.ВладелецФормы;
	КонецЕсли;
	
	ВложенныеФормы = ОсновнаяФорма.ВложенныеФормы;
	ПараметрыФормы = ВложенныеФормы.НайтиПоЗначению(Команда.Имя);
	Если ПараметрыФормы <> Неопределено Тогда
		АктивнаяФорма = ВложенныеФормы.НайтиПоЗначению(Команда.Имя).Представление;
	
		ОсновноеОкно = Форма.Окно;
		Для Каждого ФормаСодержимого Из ОсновноеОкно.Содержимое Цикл
			Если ФормаСодержимого.ИмяФормы = АктивнаяФорма Тогда
				ФормаСодержимого.Активизировать();
				Оповестить("НавигационнаяКомандаВложеннойФормы", Команда, ФормаСодержимого);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Оповестить("НавигационнаяКомандаВложеннойФормы", Команда, ОсновнаяФорма);
	
КонецПроцедуры

#Область Отчеты

Процедура ОтчетПоЛимитамРасшифровать(Форма, Команда) Экспорт
	
	Расшифровка = Форма.ОтчетТабличныйДокумент.ВыделенныеОбласти[0].Расшифровка;
	
	Если Расшифровка <> Неопределено Тогда
		СтандартнаяОбработка = Истина;
		
		ОбработатьРасшифровку(Форма, Форма.Элементы.ОтчетТабличныйДокумент, Расшифровка, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

