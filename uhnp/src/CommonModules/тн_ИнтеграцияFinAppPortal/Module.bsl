Функция НайтиВидСообщенияПортал(ЗначениеПоиска)
	
	ЗначениеПеречисления = Перечисления.тн_ВидыСообщенийPortal.ПустаяСсылка();
	
	Если Не Метаданные.Перечисления.тн_ВидыСообщенийPortal.ЗначенияПеречисления.Найти(ЗначениеПоиска) = Неопределено Тогда
		ЗначениеПеречисления = Перечисления.тн_ВидыСообщенийPortal[ЗначениеПоиска];	
	КонецЕсли;
	
	Возврат ЗначениеПеречисления;
	
