	Запрос = Новый Запрос;
	Запрос.Текст = 
	// НАЧАЛО Белоконенко Денис 20.05.2022 Выполнение задач №000041324
		//"ВЫБРАТЬ
		//|	КадроваяИсторияСотрудниковСрезПоследних.ГоловнаяОрганизация КАК Организация,
		//|	КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписанию
		//|ПОМЕСТИТЬ вт_КадровыеДанные
		//|ИЗ
		//|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&ДатаПроверки, ФизическоеЛицо = &ФизЛицо) КАК КадроваяИсторияСотрудниковСрезПоследних
		//|;
		//|
		//|////////////////////////////////////////////////////////////////////////////////
		//|ВЫБРАТЬ
		//|	вт_КадровыеДанные.Организация КАК Организация,
		//|	ЕСТЬNULL(МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение
		//|ИЗ
		//|	вт_КадровыеДанные КАК вт_КадровыеДанные
		//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозицииШтатногоРасписанияВСтруктуреПредприятия
		//|		ПО вт_КадровыеДанные.ДолжностьПоШтатномуРасписанию = МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Позиция";		
		
	// НАЧАЛО Белоконенко Денис 08.02.2023 Выполнение задач №000044324
		//"ВЫБРАТЬ
		//|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК Организация,
		//|	ТекущиеКадровыеДанныеСотрудников.тнПодразделение КАК Подразделение
		//|ИЗ
		//|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		//|ГДЕ
		//|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизЛицо";
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК Организация,
		|	ТекущиеКадровыеДанныеСотрудников.тнПодразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|ГДЕ
		|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизЛицо
		|	И ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация = &Организация
		|	И ТекущиеКадровыеДанныеСотрудников.ДатаПриема <= &ДатаПроверки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТекущиеКадровыеДанныеСотрудников.ДатаПриема УБЫВ";
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация = &Организация", "");		
	КонецЕсли;	
		
	Запрос.УстановитьПараметр("Организация", Организация);
    // КОНЕЦ Белоконенко Денис 08.02.2023 Выполнение задач №000044324
	// КОНЕЦ Белоконенко Денис 20.05.2022 Выполнение задач №000041324
	
