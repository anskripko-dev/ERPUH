// Гутарова Екатерина 16.05.2022 Выполнение задач №000041245
//
Функция ПолучитьПечатнуюФормуАвансовогоОтчета(ДокументСсылка, ИмяПечатнойФормы, СтруктураСообщения) Экспорт
	
	printedFile = Новый Структура("type, name, contentBase64");
	
	ТабДок = Неопределено;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		
		ПараметрыПечати = Новый Структура; 
		ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь); 

		ДанныеПечати = УправлениеПечатью.СформироватьПечатныеФормы("Документ.АвансовыйОтчет", ИмяПечатнойФормы, ДокументСсылка,ПараметрыПечати);
		
		Если ДанныеПечати.Свойство("КоллекцияПечатныхФорм") Тогда
			
			КоллекцияПечатныхФорм = ДанныеПечати.КоллекцияПечатныхФорм;
			Если ЗначениеЗаполнено(КоллекцияПечатныхФорм) И КоллекцияПечатныхФорм.Количество() > 0 Тогда
				ТабДок = КоллекцияПечатныхФорм[0].ТабличныйДокумент;
			КонецЕсли;
			
		Иначе
			
			Если СтруктураСообщения.Свойство("errorMessage") Тогда
				СтруктураСообщения.errorMessage = "Форма " + ИмяПечатнойФормы + " не предназначена для формата PDF.";
			КонецЕсли;
			
			Возврат printedFile;
			
		КонецЕсли;
		
	Иначе
		Возврат printedFile;
	КонецЕсли;
	
	ДвоичныеДанные = Неопределено;
	
	Если ТипЗнч(ТабДок) = Тип("ТабличныйДокумент") Тогда
		
		ПотокВПамяти = Новый ПотокВПамяти;
		ТабДок.Записать(ПотокВПамяти, ТипФайлаТабличногоДокумента.PDF);
		ДвоичныеДанные = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
				
	Иначе
		
		Если СтруктураСообщения.Свойство("errorMessage") Тогда
			СтруктураСообщения.errorMessage = "Форма " + ИмяПечатнойФормы + " не предназначена для формата PDF.";
		КонецЕсли;
		
		Возврат printedFile;
		
	КонецЕсли;
			
	Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		
		printedFile.type = "PDF";
		printedFile.name = "Act.PDF";
		printedFile.contentBase64 = Base64Строка(ДвоичныеДанные);
		
	КонецЕсли;
	
	Возврат printedFile;
	
КонецФункции // ЗаполнитьАтрибутОбъектаXDTO()

// Гутарова Екатерина 16.05.2022 Выполнение задач №000041245
//
Процедура ЗаполнитьАтрибутОбъектаXDTO(СвойствоXDTO, ИмяАтрибута, ЗначениеАтрибута)
	
	ТипBoolean  = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema","boolean");	
	ТипDateTime = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema","dateTime");
	ТипDate		= ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema","date");
	
	ТекущееСвойствоXDTO = СвойствоXDTO.Свойства().Получить(ИмяАтрибута);
		
	Если Не (ТекущееСвойствоXDTO.ЗначениеПоУмолчанию = Неопределено) Тогда 
		ЗначениеПоУмолчанию = ТекущееСвойствоXDTO.ЗначениеПоУмолчанию.Значение;	
	Иначе
		
		Если ТекущееСвойствоXDTO.Тип = ТипBoolean Тогда 
			ЗначениеПоУмолчанию = Ложь;	
		ИначеЕсли ТекущееСвойствоXDTO.Тип = ТипDateTime Тогда
			ЗначениеПоУмолчанию = Дата(1,1,1,0,0,0);
		ИначеЕсли ТекущееСвойствоXDTO.Тип = ТипDate Тогда
			ЗначениеПоУмолчанию = Дата(1,1,1);
		Иначе 	
			ЗначениеПоУмолчанию = "";
		КонецЕсли;					
		
	КонецЕсли;
	
	Если (ЗначениеАтрибута = NULL) Или (ЗначениеАтрибута = Неопределено) Тогда 
		СвойствоXDTO[ИмяАтрибута] = ЗначениеПоУмолчанию;
	Иначе
		СвойствоXDTO[ИмяАтрибута] = ЗначениеАтрибута;	
	КонецЕсли;
																						
КонецПроцедуры // ЗаполнитьАтрибутОбъектаXDTO()

// Гутарова Екатерина 16.05.2022 Выполнение задач №000041245
//
Функция ПоместитьСтруктуруВОбъектXDTO(Данные, ОбъектXDTO)
	
	Для Каждого КлючИзначение Из Данные Цикл 
		
		ИмяАтрибута       = КлючИзначение.Ключ;
		ЗначениеАтрибута  = КлючИзначение.Значение;
		
		Если ТипЗнч(ЗначениеАтрибута) = Тип("Структура") Тогда
			ОбъектАтрибута			= ФабрикаXDTO.Создать(ОбъектXDTO.Свойства().Получить(ИмяАтрибута).Тип);
			ОбъектXDTO[ИмяАтрибута] = ПоместитьСтруктуруВОбъектXDTO(ЗначениеАтрибута, ОбъектАтрибута);
		Иначе 
			ЗаполнитьАтрибутОбъектаXDTO(ОбъектXDTO, ИмяАтрибута, ЗначениеАтрибута); 	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбъектXDTO;
	
КонецФункции // ПоместитьСтруктуруВОбъектXDTO() 

