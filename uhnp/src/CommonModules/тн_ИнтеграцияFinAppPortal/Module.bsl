Функция РезультатЗапросаДанныхСПортала(ПараметрыФормирования) Экспорт
	
	РезультатЗапросаДанных =  Новый Структура();
	
	ДатаНачалаОжидания = ТекущаяДатаСеанса();
	ИнтервалПроверкиСекунд = 3;
	ВремяОжиданияОтветаСекунд = 900;
	
	ИдентификаторЗапроса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФормирования, "ИдентификаторЗапроса");
	ВидСообщения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФормирования, "ВидСообщения");  
	ВремяОжиданияОтветаСекунд = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФормирования, "ВремяОжиданияОтветаСекунд");
	
	ДатаЗавершенияОжидания = ДатаНачалаОжидания + ВремяОжиданияОтветаСекунд;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_ЗапросыRabbitMQ.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
		|	тн_ЗапросыRabbitMQ.ВидСообщения КАК ВидСообщения,
		|	тн_ЗапросыRabbitMQ.XML_ПакетВходящий КАК XML_ПакетВходящий,
		|	тн_ЗапросыRabbitMQ.ЕстьОшибки КАК ЕстьОшибки,
		|	тн_ЗапросыRabbitMQ.ТекстОшибки КАК ТекстОшибки,
		|	тн_ЗапросыRabbitMQ.ОтветПолучен КАК ОтветПолучен
		|ИЗ
		|	РегистрСведений.тн_ЗапросыRabbitMQ КАК тн_ЗапросыRabbitMQ
		|ГДЕ
		|	тн_ЗапросыRabbitMQ.ИдентификаторЗапроса = &ИдентификаторЗапроса
		|	И тн_ЗапросыRabbitMQ.ВидСообщения = &ВидСообщения";
	
	Пока Истина Цикл
		
		Если ТекущаяДатаСеанса() > ДатаЗавершенияОжидания Тогда
			
			РезультатВыполнения = Новый Структура();
			РезультатВыполнения.Вставить("Статус", "Ошибка");
			РезультатВыполнения.Вставить("КраткоеПредставлениеОшибки", "Превышено время ожидания ответного сообщения");
			
			ВызватьИсключение ("Не удалось получить данные с портала! Превышено время ожидания ответного сообщения.");
			
		КонецЕсли; 
		
		ОбщегоНазначенияБТС.Пауза(ИнтервалПроверкиСекунд);
				
		Запрос.УстановитьПараметр("ВидСообщения", ВидСообщения);
		Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса); 
		РезультатВыполненияЗапросыRabbitMQ = Запрос.Выполнить();
		
		Если РезультатВыполненияЗапросыRabbitMQ.Пустой() Тогда 
			
			Продолжить; 
			
		Иначе 
			
			Выборка = РезультатВыполненияЗапросыRabbitMQ.Выбрать();
			Выборка.Следующий();
			
			Если Выборка.ОтветПолучен Тогда 
				
				РезультатЗапросаДанных.Вставить("Результат", Выборка.XML_ПакетВходящий);
				РезультатЗапросаДанных.Вставить("ЕстьОшибки", Выборка.ЕстьОшибки);
				РезультатЗапросаДанных.Вставить("ТекстОшибки", Выборка.ТекстОшибки);
				Возврат РезультатЗапросаДанных;

			Иначе 
				
				Продолжить; 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат РезультатЗапросаДанных;

КонецФункции  //РезультатЗапросаДанныхСПортала()

//Сафиуллина З.Р. 19.02.2025 Выполнение задач №000052637
//
Процедура ОбработатьОтветноеСообщениеПортал(СообщениеXDTO, ТекстСообщенияJSON, Профиль, ТегXDTO) Экспорт
	
	ВидСообщенияОтвета = НайтиВидСообщенияПортал(ТегXDTO);
	ДанныеДляЛогирования = ДанныеДляЛогирования(ВидСообщенияОтвета,,, Профиль.ВестиЛоги, Перечисления.тн_ВидыИнтеграций.Портал_Получение);
	ЗаписатьЛогРаботы("Запрос", ДанныеДляЛогирования, ТекстСообщенияJSON, Перечисления.тн_ВидыСобытийИнтеграции.ПолученПакет);	
	
	Параметры = Новый Структура;
	Параметры.Вставить("Профиль", Профиль);
	Параметры.Вставить("ДанныеДляЛогирования", ДанныеДляЛогирования);
	
	ТегЗапроса = СтрЗаменить(ТегXDTO, "response", "request"); 
	ВидСообщенияЗапроса = НайтиВидСообщенияПортал(ТегЗапроса);
	
	Попытка
		
		Результат = Новый Структура("Успех,ОписаниеОшибки", Истина, "");
		
		ТекстСообщенияJSON_Структура = СтрЗаменить(ТекстСообщенияJSON, "#", "");
		
		СтруктураОтветногоСообщения = тн_Интеграция_УПП.ПолучитьСтруктуруДанныхJSON(ТекстСообщенияJSON_Структура);
		
		ИдентификаторЗапроса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтветногоСообщения.value[ТегXDTO], "idRequest");
		СтруктураЗаписи = Новый Структура();
		СтруктураЗаписи.Вставить("XML_ПакетВходящий", ТекстСообщенияJSON);
		СтруктураЗаписи.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса); 
		СтруктураЗаписи.Вставить("ВидСообщения", ВидСообщенияЗапроса);
		ЕстьОшибки 	= Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтветногоСообщения.value[ТегXDTO], "success");
		Если ЕстьОшибки Тогда 
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтветногоСообщения.value[ТегXDTO], "errorMessage");
		Иначе
			ТекстОшибки = "";
		КонецЕсли;
		СтруктураЗаписи.Вставить("ЕстьОшибки", ЕстьОшибки);
		СтруктураЗаписи.Вставить("ТекстОшибки", ТекстОшибки);
		
		РегистрыСведений.тн_ЗапросыRabbitMQ.ОбновитьЗаписьПриПолученииСообщения(СтруктураЗаписи);
		
	Исключение
		
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки +  """: " + ОписаниеОшибки() + Символы.ПС;	
		
	КонецПопытки;
	
	Если Результат.Успех Тогда
		ЗаписатьЛогРаботы("Ответ", ДанныеДляЛогирования, "Объекты типа: " + ТегXDTO + " успешно обработаны", Перечисления.тн_ВидыСобытийИнтеграции.ОбработкаЗавершена);
		тн_Интеграция_ERP_УХ.ОтправитьIntegrationTicket(СообщениеXDTO, ТекстСообщенияJSON, Параметры); 
	Иначе
		ОписаниеОшибки = "Ошибка получения объектов типа " + ТегXDTO + " описание ошибки: " + Символы.ПС + Результат.ОписаниеОшибки;		
		ЗаписатьЛогРаботы("Ошибка", ДанныеДляЛогирования, ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры  //ОбработатьОтветноеСообщениеПортал()

