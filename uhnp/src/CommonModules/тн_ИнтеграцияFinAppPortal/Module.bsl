Функция ПолучитьРазделениеСуточных(СуточныеСодержание, РазъезднойХарактерРаботы) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_СуточныеРазделениеОблагаемыеНеОблагаемые.СодержаниеСуточныхСФП КАК СодержаниеСуточныхСФП,
		|	тн_СуточныеРазделениеОблагаемыеНеОблагаемые.СодержаниеНеОблагается КАК СодержаниеНеОблагается,
		|	тн_СуточныеРазделениеОблагаемыеНеОблагаемые.СуммаНеОблагается КАК СуммаНеОблагается,
		|	тн_СуточныеРазделениеОблагаемыеНеОблагаемые.СодержаниеОблагается КАК СодержаниеОблагается,
		|	тн_СуточныеРазделениеОблагаемыеНеОблагаемые.СуммаОблагается КАК СуммаОблагается
		|ИЗ
		|	РегистрСведений.тн_СуточныеРазделениеОблагаемыеНеОблагаемые КАК тн_СуточныеРазделениеОблагаемыеНеОблагаемые
		|ГДЕ   
		// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277  
		//|	тн_СуточныеРазделениеОблагаемыеНеОблагаемые.СодержаниеСуточныхСФП = &СодержаниеСуточныхСФП";  
		|	тн_СуточныеРазделениеОблагаемыеНеОблагаемые.РазъезднойХарактерРаботы = &РазъезднойХарактерРаботы
		|	И тн_СуточныеРазделениеОблагаемыеНеОблагаемые.СодержаниеСуточныхСФП = &СодержаниеСуточныхСФП";
		// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277
	
	Запрос.УстановитьПараметр("СодержаниеСуточныхСФП", СуточныеСодержание);
    // НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
    Запрос.УстановитьПараметр("РазъезднойХарактерРаботы", РазъезднойХарактерРаботы);	
	// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277 

	РезультатЗапроса = Запрос.Выполнить(); 
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

