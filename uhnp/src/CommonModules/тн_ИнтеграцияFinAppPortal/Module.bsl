// Белоконенко Денис 29.11.2021 Выполнение задач №000039663
// Получаем ссылку по различным вариантам поиска.
//
// Параметры:
//  МенеджерОбъекта - Менеджер искомого объекта
//  ВариантПоиска - Строка. Варианты значений (по гуиду, по коду, по реквизиту);
//  ЗначениеПоиска - Строка. Поисковое значение
//	РезультатОшибок - Структура. Результат записи ошибок
//	ЗаписыватьОшибкуЕслиНеНашли - Булево. Если ИСТИНА, то записываем ошибку в РезультатОшибок
//	ИмяРеквизитаПоиска - Строка. Имя реквизита если ВариантПоиска = "по реквизиту" 
//
// Возвращаемое значение:
//  Ссылка. Пустая ссылка если не нашли
//  Неопределено. Если возникла исключительная ситуация или не предусмотрен такой вариант поиска 
Функция ПолучитьСсылкуНаОбъект(МенеджерОбъекта, ВариантПоиска, ЗначениеПоиска, РезультатОшибок, ЗаписыватьОшибкуЕслиНеНашли = Истина, ИмяРеквизитаПоиска = "")
	НаименованиеОбъекта = Строка(МенеджерОбъекта);
	НаименованиеОбъекта = Прав(НаименованиеОбъекта, СтрДлина(НаименованиеОбъекта) - СтрНайти(НаименованиеОбъекта, "."));
	                         
	СсылкаНаОбъект = Неопределено;
	
	Если ВариантПоиска = "по гуиду" тогда
		Попытка
			УИД = Новый УникальныйИдентификатор(ЗначениеПоиска);		
		Исключение
			//если переданный ключ сообщения не является гуидом, не используем его в качестве ключа записи
			
			РезультатОшибок.Успех = Ложь;
			РезультатОшибок.ОписаниеОшибки = РезультатОшибок.ОписаниеОшибки + "Переданный ключ сообщения не является гуидом: " + ЗначениеПоиска + ": " + ОписаниеОшибки() + Символы.ПС;
			Возврат Неопределено;		
		КонецПопытки;
		
		СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку(УИД);
		// НАЧАЛО Белоконенко Денис 08.02.2023 Выполнение задач №000044324
		//Если Найти(Строка(СсылкаНаОбъект), "<Объект не найден") <> 0 тогда
		Если Не ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
		// КОНЕЦ Белоконенко Денис 08.02.2023 Выполнение задач №000044324
			СсылкаНаОбъект = МенеджерОбъекта.ПустаяСсылка();
			Если ЗаписыватьОшибкуЕслиНеНашли  тогда
				РезультатОшибок.Успех = Ложь;
				РезультатОшибок.ОписаниеОшибки = РезультатОшибок.ОписаниеОшибки + "Не найдена ссылка на объект "+НаименованиеОбъекта+" по ГУИДу: " + ЗначениеПоиска + Символы.ПС;		
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ВариантПоиска = "по коду" тогда
		СсылкаНаОбъект = МенеджерОбъекта.НайтиПоКоду(ЗначениеПоиска);
		Если ЗаписыватьОшибкуЕслиНеНашли и НЕ ЗначениеЗаполнено(СсылкаНаОбъект) тогда
			РезультатОшибок.Успех = Ложь;
			РезультатОшибок.ОписаниеОшибки = РезультатОшибок.ОписаниеОшибки + "Не найдена ссылка на объект "+НаименованиеОбъекта+" по коду: " + ЗначениеПоиска + Символы.ПС;
		КонецЕсли;
	ИначеЕсли ВариантПоиска = "по реквизиту" тогда
		СсылкаНаОбъект = МенеджерОбъекта.НайтиПоРеквизиту(ИмяРеквизитаПоиска, ЗначениеПоиска);
		Если ЗаписыватьОшибкуЕслиНеНашли и НЕ ЗначениеЗаполнено(СсылкаНаОбъект) тогда
			РезультатОшибок.Успех = Ложь;
			РезультатОшибок.ОписаниеОшибки = РезультатОшибок.ОписаниеОшибки + "Не найдена ссылка на объект "+НаименованиеОбъекта+" по реквизиту "+ИмяРеквизитаПоиска+": " + ЗначениеПоиска + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СсылкаНаОбъект;
КонецФункции

//Сафиуллина З.Р. 21.02.2025 Выполнение задач №000052637: + Экспорт
//// Белоконенко Денис 29.11.2021 Выполнение задач №000039663
//Функция ЗаписатьЛогРаботы(ВидЛога, ДанныеДляЛогирования, ОбъектЛогирования, Событие = "")
Функция ЗаписатьЛогРаботы(ВидЛога, ДанныеДляЛогирования, ОбъектЛогирования, Событие = "") Экспорт
	
	ВидСообщения					= ДанныеДляЛогирования.ВидСообщения; 
	УникальныйИдентификаторЗапроса	= ДанныеДляЛогирования.ИдентификаторЗапроса;
	ИдентификаторИсточникаВызова	= ДанныеДляЛогирования.ИдентификаторИсточникаВызова;
	ВидИнтеграции					= ДанныеДляЛогирования.ВидИнтеграции;
	
	
	Если (ОбъектЛогирования <> Неопределено) 
	   И ЗначениеЗаполнено(ИдентификаторИсточникаВызова) Тогда 
	   		
		ТекстЛога = Строка(ИдентификаторИсточникаВызова) + Символы.ПС + Строка(ОбъектЛогирования);
		
	Иначе 
		
		ТекстЛога = ОбъектЛогирования;
		
	КонецЕсли;	
	
	Если ВидЛога = "Запрос" Тогда 
		
		Если ДанныеДляЛогирования.ВестиЛоги Тогда
				
			РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогСообщенияВходящего(ВидИнтеграции, УникальныйИдентификаторЗапроса, ТекстЛога, ВидСообщения, Событие);

		КонецЕсли;  
			
	ИначеЕсли ВидЛога = "Ответ" Тогда 
		
		Если ДанныеДляЛогирования.ВестиЛоги Тогда
	
			РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогСообщенияИсходящего(ВидИнтеграции, УникальныйИдентификаторЗапроса, ТекстЛога, ВидСообщения, Событие);

		КонецЕсли; 
			
	ИначеЕсли ВидЛога = "Ошибка" Тогда 
										
		РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ВидИнтеграции, УникальныйИдентификаторЗапроса, Перечисления.тн_ВидыСобытийИнтеграции.Ошибка, ТекстЛога, ВидСообщения);								
				
	КонецЕсли;	
				
КонецФункции

