
// Белоконенко Денис 29.11.2021 Выполнение задач №000039663
Функция ПрочитатьОбъектXDTO_FinApp_Portal(СообщениеXDTO, Параметры) Экспорт
	Результат = Новый Структура("Успех,ОписаниеОшибки,ДопРезультаты", Истина, "",Новый Структура());
	
	Если СообщениеXDTO.Свойства().Получить("advanceReport") <> Неопределено Тогда //Авансовый отчет
		Результат.ДопРезультаты.Вставить("id1c", "");
		Результат.ДопРезультаты.Вставить("documentNumber", "");
		// НАЧАЛО Белоконенко Денис 18.01.2023 Выполнение задач №000044013
		Результат.ДопРезультаты.Вставить("Ссылка", Неопределено);
		// КОНЕЦ  Белоконенко Денис 18.01.2023 Выполнение задач №000044013		
		
		// НАЧАЛО Белоконенко Денис 29.11.2021 Выполнение задач №000039664
		// Опечатка
		//Параметры.Вставить("ИмяТипаПакетаОтветногоXDTO", "responceAdvanceReport");
		//Параметры.Вставить("ИмяТипаОтветногоXDTO", "responceAdvanceReport_v1");
		Параметры.Вставить("ИмяТипаПакетаОтветногоXDTO", "responseAdvanceReport");
		Параметры.Вставить("ИмяТипаОтветногоXDTO", "responseAdvanceReport_v1");
		// КОНЕЦ Белоконенко Денис 29.11.2021 Выполнение задач №000039664
		
		Если Параметры.ПроизводственноеПодразделение = Справочники.тн_ПроизводственныеПодразделения.ФинансовыйПомощник тогда
			Попытка
				УИД = Новый УникальныйИдентификатор(СообщениеXDTO.advanceReport.id);		
			Исключение
				//если переданный ключ сообщения не является гуидом, не используем его в качестве ключа записи
				
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = "Переданный ключ сообщения не является гуидом: " + СообщениеXDTO.advanceReport.id + ": " + ОписаниеОшибки();
				Возврат Результат;		
			КонецПопытки;
			
			АвансовыйОтчетСсылка 				= Документы.АвансовыйОтчет.ПолучитьСсылку(УИД);
			АвансовыйОтчетОбъект 				= АвансовыйОтчетСсылка.ПолучитьОбъект();
			Если АвансовыйОтчетОбъект = Неопределено тогда
				АвансовыйОтчетОбъект 			= Документы.АвансовыйОтчет.СоздатьДокумент();
				АвансовыйОтчетОбъект.УстановитьСсылкуНового(АвансовыйОтчетСсылка);
			КонецЕсли; 
			//НАЧАЛО Блинова М.А. 21.11.2025 Выполнение задач №000055905 
			//проставляем по умолчанию
			АвансовыйОтчетОбъект.ЦенаВключаетНДС = Истина;
			//КОНЕЦ Блинова М.А. 21.11.2025 Выполнение задач №000055905
			//НАЧАЛО Блинова М.А. 20.01.2023 Выполнение задач №000044043
			Иначе 
			//КОНЕЦ Блинова М.А. 20.01.2023 Выполнение задач №000044043
				АвансовыйОтчетСсылка = ПолучитьСсылкуНаОбъект(Документы.АвансовыйОтчет, "по реквизиту", 
				СообщениеXDTO.advanceReport.id, Результат, Ложь, "тн_IDДокументаПортала");
			Если ЗначениеЗаполнено(АвансовыйОтчетСсылка) тогда
				АвансовыйОтчетОбъект 			= АвансовыйОтчетСсылка.ПолучитьОбъект();
			Иначе
			    АвансовыйОтчетОбъект 			= Документы.АвансовыйОтчет.СоздатьДокумент();
			КонецЕсли;
			АвансовыйОтчетОбъект.тн_IDДокументаПортала = СообщениеXDTO.advanceReport.id;
			//НАЧАЛО Блинова М.А. 15.12.2022 Выполнение задач №000043538
			//АвансовыйОтчетОбъект.Комментарий = СообщениеXDTO.advanceReport.comment;
			//КОНЕЦ Блинова М.А. 15.12.2022 Выполнение задач №000043538
		КонецЕсли;
		
		// НАЧАЛО Гутарова Екатерина 20.09.2023 Выполнение задач №000046914 
		//АвансовыйОтчетОбъект.Дата = СообщениеXDTO.advanceReport.date;			
		АвансовыйОтчетОбъект.Дата = тн_Интеграция_ERP_УХ.ПолучитьДату(СообщениеXDTO.advanceReport.date);
		// КОНЕЦ Гутарова Екатерина 20.09.2023 Выполнение задач №000046914
		АвансовыйОтчетОбъект.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		//НАЧАЛО Блинова М.А. 14.12.2022 Выполнение задач №000043538
		//АвансовыйОтчетОбъект.Комментарий = СообщениеXDTO.advanceReport.comment;
		//КОНЕЦ Блинова М.А. 14.12.2022 Выполнение задач №000043538
		ПодотчетноеЛицо = ПолучитьСсылкуНаОбъект(Справочники.ФизическиеЛица,	"по реквизиту", 
			Строка(СообщениеXDTO.advanceReport.employeeID), Результат, Истина, "тн_ЕКС");
 		// НАЧАЛО Белоконенко Денис 08.02.2023 Выполнение задач №000044324
		ОрганизацияПоАвансовомуОтчету = Неопределено;
		// КОНЕЦ  Белоконенко Денис 08.02.2023 Выполнение задач №000044324
			
		Если Параметры.ПроизводственноеПодразделение = Справочники.тн_ПроизводственныеПодразделения.Портал тогда 
			АвансовыйОтчетОбъект.тн_ЛицоСогласования = ПолучитьСсылкуНаОбъект(Справочники.ФизическиеЛица, "по реквизиту", 
				Строка(СообщениеXDTO.advanceReport.responsibleID), Результат, Ложь, "тн_ЕКС"); 
				//НАЧАЛО Блинова М.А. 15.12.2022 Выполнение задач №000043181 
				АвансовыйОтчетОбъект.тн_КомандировкаДатаНачала = СообщениеXDTO.advanceReport.businessTripStartDate;
				АвансовыйОтчетОбъект.тн_КомандировкаДатаОкончания = СообщениеXDTO.advanceReport.businessTripEndDate;
				//КОНЕЦ Блинова М.А. 15.12.2022 Выполнение задач №000043181 
		//НАЧАЛО Блинова М.А. 15.12.2022 Выполнение задач №000043538
		Иначе 
		    Если СообщениеXDTO.advanceReport.Trip <> Неопределено Тогда
				АвансовыйОтчетОбъект.тн_КомандировкаДатаНачала = СообщениеXDTO.advanceReport.Trip.StartDate;
				АвансовыйОтчетОбъект.тн_КомандировкаДатаОкончания = СообщениеXDTO.advanceReport.Trip.EndDate;
			КонецЕсли;	
        //КОНЕЦ Блинова М.А. 15.12.2022 Выполнение задач №000043538
			// НАЧАЛО Белоконенко Денис 08.02.2023 Выполнение задач №000044324
			ОрганизацияПоАвансовомуОтчету = ПолучитьСсылкуНаОбъект(Справочники.Организации, "по гуиду", 
				СообщениеXDTO.advanceReport.idOrganization, Результат, Истина);
			// КОНЕЦ  Белоконенко Денис 08.02.2023 Выполнение задач №000044324
		КонецЕсли;
		
		//НАЧАЛО Блинова М.А. 15.12.2022 Выполнение задач №000043538
		АвансовыйОтчетОбъект.Комментарий = СообщениеXDTO.advanceReport.comment;
		//КОНЕЦ Блинова М.А. 15.12.2022 Выполнение задач №000043538
		АвансовыйОтчетОбъект.ПодотчетноеЛицо = ПодотчетноеЛицо;   
				
		// НАЧАЛО Белоконенко Денис 24.08.2022 Выполнение задач №000042363
		//АвансовыйОтчетОбъект.Статус = Перечисления.СтатусыАвансовогоОтчета.Утвержден;
		// НАЧАЛО Егоров Петр 12.04.2023 Выполнение задач №000045150
		//АвансовыйОтчетОбъект.Статус = Перечисления.СтатусыАвансовогоОтчета.Подготовлен;
		Если Параметры.ПроизводственноеПодразделение = Справочники.тн_ПроизводственныеПодразделения.Портал Тогда
			АвансовыйОтчетОбъект.Статус = Перечисления.СтатусыАвансовогоОтчета.Подготовлен;
		Иначе 
			АвансовыйОтчетОбъект.Статус = Перечисления.СтатусыАвансовогоОтчета.Утвержден;
			//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
			//АвансовыйОтчетОбъект.ДатаУтверждения = тн_Интеграция_УПП.ТекущаяДатаСервера(); 
			АвансовыйОтчетОбъект.ДатаУтверждения = ТекущаяДатаСервера();
			//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
		КонецЕсли;
		// КОНЕЦ  Егоров Петр 12.04.2023 Выполнение задач №000045150
		// КОНЕЦ Белоконенко Денис 24.08.2022 Выполнение задач №000042363
		АвансовыйОтчетОбъект.Валюта = Справочники.Валюты.НайтиПоКоду("643");
		
		// НАЧАЛО Белоконенко Денис 08.02.2023 Выполнение задач №000044324
		//КадровыеДанныеФизЛица = ПолучитьКадровыеДанныеФизЛица(ПодотчетноеЛицо, СообщениеXDTO.advanceReport.date);
		КадровыеДанныеФизЛица = ПолучитьКадровыеДанныеФизЛица(ПодотчетноеЛицо, ОрганизацияПоАвансовомуОтчету, СообщениеXDTO.advanceReport.date);
		// КОНЕЦ  Белоконенко Денис 08.02.2023 Выполнение задач №000044324
		ЗаполнитьЗначенияСвойств(АвансовыйОтчетОбъект, КадровыеДанныеФизЛица);					
		
		// НАЧАЛО Белоконенко Денис 19.09.2022 Выполнение задач №000042651
		//Если Параметры.ПроизводственноеПодразделение = Справочники.тн_ПроизводственныеПодразделения.ФинансовыйПомощник тогда
		//	АвансовыйОтчетОбъект.Подразделение = ПолучитьСсылкуНаОбъект(Справочники.СтруктураПредприятия, "по гуиду", 
		//		СообщениеXDTO.advanceReport.idFinancialResponsibilityCenter, Результат, Истина);
		//Иначе
		//	АвансовыйОтчетОбъект.Подразделение = КадровыеДанныеФизЛица.Подразделение;
		//КонецЕсли;		
		Если Не ЗначениеЗаполнено(КадровыеДанныеФизЛица.Подразделение) Тогда
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + 
				"Не удалось найти подразделение в регистре ""Текущие кадровые данные сотрудников""" + Символы.ПС;	
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 19.09.2022 Выполнение задач №000042651		
		
		// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277
		РазъезднойХарактерРаботы = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПодотчетноеЛицо, "тн_РазъезднойХарактерРаботы");
		// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277
		
		АвансовыйОтчетОбъект.ПрочиеРасходы.Очистить();   
		// НАЧАЛО Гутарова Екатерина 23.11.2022 Выполнение задач №000043427	
		ЕстьКомандировка = Ложь;
		ЕстьПредставительские = Ложь;
		// КОНЕЦ Гутарова Екатерина 23.11.2022 Выполнение задач №000043427
		// НАЧАЛО Майдан Василий 24.05.2023 Выполнение задач №000045541
		ЕстьПрочиеЗакупки = Ложь;
		// КОНЕЦ Майдан Василий 24.05.2023 Выполнение задач №000045541  
		
		// НАЧАЛО Гутарова Екатерина 27.10.2023 Выполнение задач №000047298
		//Для каждого СтрокаРасхода из СообщениеXDTO.advanceReport.costs цикл  
		Если Параметры.ПроизводственноеПодразделение = Справочники.тн_ПроизводственныеПодразделения.Портал Тогда
			ДанныеЗатрат = СообщениеXDTO.advanceReport.costs;
		Иначе 
			ДанныеЗатрат = СообщениеXDTO.advanceReport.costs.cost;
		КонецЕсли;
		Для каждого СтрокаРасхода Из ДанныеЗатрат Цикл 
        // КОНЕЦ Гутарова Екатерина 27.10.2023 Выполнение задач №000047298
			НоваяСтрокаРасхода = АвансовыйОтчетОбъект.ПрочиеРасходы.Добавить();
			НоваяСтрокаРасхода.ДатаВходящегоДокумента 		= СтрокаРасхода.documentDate;
			НоваяСтрокаРасхода.НомерВходящегоДокумента 		= СтрокаРасхода.documentNumber;
			НоваяСтрокаРасхода.Содержание 					= СтрокаРасхода.content;
			НоваяСтрокаРасхода.Сумма 						= СтрокаРасхода.actualCosts;  
			// НАЧАЛО Юдина (Гутарова) Екатерина 13.05.2024 Выполнение задач №000049514
			НоваяСтрокаРасхода.СуммаСНДС 					= СтрокаРасхода.actualCosts;  
			// КОНЕЦ Юдина (Гутарова) Екатерина 13.05.2024 Выполнение задач №000049514
			// НАЧАЛО Егоров Петр 12.04.2023 Выполнение задач №000045150
			//НоваяСтрокаРасхода.СтавкаНДС					= Перечисления.СтавкиНДС.БезНДС; 
			НоваяСтрокаРасхода.СтавкаНДС					= Справочники.СтавкиНДС.БезНДС; 
			// КОНЕЦ  Егоров Петр 12.04.2023 Выполнение задач №000045150
			// НАЧАЛО Гутарова Екатерина 23.11.2022 Выполнение задач №000043427
			СтруктураСодержания = Документы.АвансовыйОтчет.ПолучитьСоответствиеПоСодержанию(СтрокаРасхода.content);  
			Если СтруктураСодержания.Количество() > 0 Тогда 
				НоваяСтрокаРасхода.НаименованиеВходящегоДокумента = СтруктураСодержания.Наименование;	
				ЕстьКомандировка      = ?(ЕстьКомандировка = Истина, ЕстьКомандировка, СтруктураСодержания.Командировка);
				ЕстьПредставительские = ?(ЕстьПредставительские = Истина, ЕстьПредставительские, СтруктураСодержания.Представительские);
				// НАЧАЛО Майдан Василий 24.05.2023 Выполнение задач №000045541
				ЕстьПрочиеЗакупки	  = ?(ЕстьПрочиеЗакупки = Истина, ЕстьПрочиеЗакупки, СтруктураСодержания.ПрочиеЗакупки);
				// КОНЕЦ Майдан Василий 24.05.2023 Выполнение задач №000045541
			КонецЕсли;
			// КОНЕЦ Гутарова Екатерина 23.11.2022 Выполнение задач №000043427	
			
			// Разные методы поиска статьи для фин помощника и портала.
			Если Параметры.ПроизводственноеПодразделение = Справочники.тн_ПроизводственныеПодразделения.ФинансовыйПомощник тогда
				НоваяСтрокаРасхода.СтатьяРасходов = ПолучитьСсылкуНаОбъект(ПланыВидовХарактеристик.СтатьиРасходов, "по коду", 
					СтрокаРасхода.idErpCostBudget, Результат);
			Иначе
				НоваяСтрокаРасхода.СтатьяРасходов 			= Константы.тн_СтатьяРасходовПриЗагрузкеАвансовыхОтчетовPortal.Получить();
				Если НЕ ЗначениеЗаполнено(НоваяСтрокаРасхода.СтатьяРасходов) тогда
					Результат.Успех = Ложь;
					Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "Не заполнена константа ""Статья расходов при загрузке авансовых отчетов portal (тн)"""+Символы.ПС;
				КонецЕсли;	
			КонецЕсли;

			НоваяСтрокаРасхода.АналитикаРасходов 			= ПолучитьАналитикуРасходовПоУмолчанию(НоваяСтрокаРасхода.СтатьяРасходов, АвансовыйОтчетОбъект);
			НоваяСтрокаРасхода.Подразделение                = АвансовыйОтчетОбъект.Подразделение; 
			// НАЧАЛО Белышев Игорь 10.01.2023 Выполнение задач №000043904
			Если СтрНайти(НРег(НоваяСтрокаРасхода.Содержание),"суточные") > 0 Тогда
				
				// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277
				//РазделенияСуточных = ПолучитьРазделениеСуточных(НоваяСтрокаРасхода.Содержание);  
				РазделенияСуточных = ПолучитьРазделениеСуточных(НоваяСтрокаРасхода.Содержание, РазъезднойХарактерРаботы); 
				// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277
				ОбщаяСуммаСуточных = СтрокаРасхода.actualCosts;
				
				Если РазделенияСуточных <> Неопределено Тогда
					Выборка = РазделенияСуточных.Выбрать();
					Пока Выборка.Следующий() Цикл
						СуммаЗаСуточные = Выборка.СуммаНеОблагается + Выборка.СуммаОблагается;
						КоличествоДней = ОбщаяСуммаСуточных / ?(СуммаЗаСуточные = 0, 1, СуммаЗаСуточные); 
						
						Если (Цел(КоличествоДней) - КоличествоДней) = 0 Тогда
							НоваяСтрокаРасхода.Сумма = Выборка.СуммаНеОблагается * КоличествоДней;
							НоваяСтрокаРасхода.Содержание = Выборка.СодержаниеНеОблагается;
							// НАЧАЛО Юдина (Гутарова) Екатерина 13.05.2024 Выполнение задач №000049514
							НоваяСтрокаРасхода.СуммаСНДС = НоваяСтрокаРасхода.Сумма;  
							// КОНЕЦ Юдина (Гутарова) Екатерина 13.05.2024 Выполнение задач №000049514
							НоваяСтрокаРасходаСуточные = АвансовыйОтчетОбъект.ПрочиеРасходы.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаРасходаСуточные,НоваяСтрокаРасхода);
							НоваяСтрокаРасходаСуточные.Сумма = Выборка.СуммаОблагается * КоличествоДней;
							// НАЧАЛО Юдина (Гутарова) Екатерина 13.05.2024 Выполнение задач №000049514
							НоваяСтрокаРасходаСуточные.СуммаСНДС = НоваяСтрокаРасходаСуточные.Сумма;  
							// КОНЕЦ Юдина (Гутарова) Екатерина 13.05.2024 Выполнение задач №000049514
							НоваяСтрокаРасходаСуточные.Содержание = Выборка.СодержаниеОблагается;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли; 
			// КОНЕЦ Белышев Игорь 10.01.2023 Выполнение задач №000043904
		КонецЦикла;		
		
		// НАЧАЛО Гутарова Екатерина 23.11.2022 Выполнение задач №000043427	
		Если ЕстьКомандировка Тогда 
			АвансовыйОтчетОбъект.НазначениеАванса = "Командировка";
		ИначеЕсли ЕстьПредставительские Тогда
			АвансовыйОтчетОбъект.НазначениеАванса = "Представительские расходы";
		// НАЧАЛО Майдан Василий 24.05.2023 Выполнение задач №000045541
		ИначеЕсли ЕстьПрочиеЗакупки Тогда   
			АвансовыйОтчетОбъект.НазначениеАванса = "Прочие закупки";
		// КОНЕЦ Майдан Василий 24.05.2023 Выполнение задач №000045541
		Иначе 
			АвансовыйОтчетОбъект.НазначениеАванса = "Прочие расходы";
		КонецЕсли;
		// КОНЕЦ Гутарова Екатерина 23.11.2022 Выполнение задач №000043427
	    // НАЧАЛО Юдина (Гутарова) Екатерина 25.10.2024 Выполнение задач №000051314 
		АвансовыйОтчетОбъект.ДополнительныеСвойства.Вставить("БлокироватьЗаписьВЗакрытомПериоде");
		// КОНЕЦ Юдина (Гутарова) Екатерина 25.10.2024 Выполнение задач №000051314
		Попытка
			Если Результат.Успех тогда
				АвансовыйОтчетОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Результат.ДопРезультаты.id1c 		   = СообщениеXDTO.advanceReport.id;
				Результат.ДопРезультаты.documentNumber = АвансовыйОтчетОбъект.Номер;
				// НАЧАЛО Белоконенко Денис 18.01.2023 Выполнение задач №000044013
				Результат.ДопРезультаты.Ссылка 		   = АвансовыйОтчетОбъект.Ссылка;
				// КОНЕЦ  Белоконенко Денис 18.01.2023 Выполнение задач №000044013 
				// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
				// НАЧАЛО Егоров Петр 10.06.2025 Выполнение задач №000054028
				//РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(АвансовыйОтчетОбъект.Ссылка);
				РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(АвансовыйОтчетОбъект.Ссылка,
				АвансовыйОтчетОбъект.Организация,АвансовыйОтчетОбъект.Дата);
				// КОНЕЦ Егоров Петр 10.06.2025 Выполнение задач №000054028
				// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
			КонецЕсли;
		Исключение
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = "Не удалось создать документ с id " + СообщениеXDTO.advanceReport.id + ": " + ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;
	                       
	Возврат Результат;
КонецФункции	

