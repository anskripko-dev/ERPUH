
// Функция позволяет определить периодичность бюджетирования в зависимости от вида бюджета.
//
// Параметры:
//  ВидБюджета	 - 	ПеречислениеСсылка.ПредназначенияЭлементовСтруктурыОтчета - Вид бюджета, для которого
// необходимо получить периодичность.
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.Периодичность - Периодичность бюджетов.
//
Функция ПолучитьПериодичностьБюджетирования(ВидБюджета=Неопределено) Экспорт
	
	Возврат Константы.ПериодичностьБюджетирования.Получить();
	
КонецФункции // ПолучитьПериодичностьБюджетирования()

// Возвращает признак возможности создания ОФД по документу-источнику
Функция ЗаполнениеОФДРазрешено(ИсточникСсылка) Экспорт
	
	Результат = Истина;
	
	// 
	ТипИсточника = ТипЗнч(ИсточникСсылка);
	Если ТипИсточника = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда
		// В ОФД попадают только проведенные банком СписанияБДС
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсточникСсылка, "ПроведеноБанком");
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
		// В ОФД попадают только проведенные банком СписанияБДС
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсточникСсылка, "ПроведеноБанком");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ОбъектыСПредопределеннымиПравиламиГенерации(Результат, УчитыватьНастройкиФункциональныхОпций = Истина) Экспорт
	
	Если (НЕ УчитыватьНастройкиФункциональныхОпций) ИЛИ (ПолучитьФункциональнуюОпцию("АвтоматическиФормироватьОФДПоДокументамДДС")) Тогда
		
		Результат.Добавить("Документ.ПоступлениеБезналичныхДенежныхСредств");
		Результат.Добавить("Документ.СписаниеБезналичныхДенежныхСредств");
		Результат.Добавить("Документ.ПриходныйКассовыйОрдер");
		Результат.Добавить("Документ.РасходныйКассовыйОрдер");
	КонецЕсли;
	
	Если (НЕ УчитыватьНастройкиФункциональныхОпций) ИЛИ (ПолучитьФункциональнуюОпцию("АвтоматическиФормироватьОФДПоДокументамПТУРТУ")) Тогда
		Результат.Добавить("Документ.ПриобретениеТоваровУслуг");
		Результат.Добавить("Документ.ПриобретениеУслугПрочихАктивов");
		Результат.Добавить("Документ.РеализацияТоваровУслуг");
		Результат.Добавить("Документ.ВозвратТоваровПоставщику");
		Результат.Добавить("Документ.ВозвратТоваровОтКлиента");
		Результат.Добавить("Документ.АктВыполненныхРабот");
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

