Функция ДоговораИВидыОперацийУХ()
	
	Результат = Новый Массив;
	
	Результат.Добавить("ДоговорКредитаДепозита");
	Результат.Добавить("ДоговорЗаймаСотруднику");
	Результат.Добавить("ЦеннаяБумага");
    Результат.Добавить("Договор");
	
	Возврат Результат;
	
КонецФункции     

Процедура УстановитьВидимостьДоговоров(Форма, ВидОперацииУХ)
	
	Элементы = Форма.Элементы;
	ВидДоговора = ВидыОперацийУХКлиентСерверПовтИспПереопределяемый.ВидДоговора(ВидОперацииУХ); 

	Элементы.Договор.Видимость 					= ВидДоговора = "Договор";	
	Элементы.ДоговорКредитаДепозита.Видимость 	= ВидДоговора = "ДоговорКредитаДепозита";
	Элементы.ДоговорЗаймаСотруднику.Видимость 	= ВидДоговора = "ДоговорЗаймаСотруднику";
	Элементы.ЦеннаяБумага.Видимость 			= ВидДоговора = "ЦеннаяБумага";

КонецПроцедуры

Процедура ДобавитьДоговорВидОперации(Результат, ИмяРеквизитаДоговора, ВидОперации)
	
	//
	Если Результат[ИмяРеквизитаДоговора] = неопределено Тогда
		Результат.Вставить(ИмяРеквизитаДоговора, Новый Массив);
	КонецЕсли;
	
	Результат[ИмяРеквизитаДоговора].Добавить(ВидОперации);
	
КонецПроцедуры

