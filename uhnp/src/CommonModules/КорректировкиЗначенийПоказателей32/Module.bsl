		|	И Трансляция.ПериодОтражения.ДатаНачала > &ДатаЗапретаОбщая
		|;"; 
		Запрос.УстановитьПараметр("ДатаЗапретаОбщая",ДанныеЗапрета.ДатаЗапретаОбщая);
		
	КонецЕсли;
	
	ТекстЗапроса=ТекстЗапроса+"
