	             |	&ШаблонТрансляции КАК ШаблонТрансляции
	             |ИЗ
	             |	ДокументыТрансляции КАК ДокументыТрансляции
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
	             |		ПО ДокументыТрансляции.ИсходныйДокумент = Хозрасчетный.Регистратор
	             |			И (Хозрасчетный.СчетДт = &Cчет)
	             |			И (Хозрасчетный.СчетКт = &КоррCчет)
	             |
	             |ОБЪЕДИНИТЬ
	             |
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ДокументыТрансляции.ДокументТрансляции,
	             |	ДокументыТрансляции.Организация,
	             |	ДокументыТрансляции.ДатаДокумента, 
				 |	ДокументыТрансляции.ИсходныйДокумент,
	             |	&СоответствиеСчетов,
	             |	&ШаблонТрансляции
	             |ИЗ
	             |	ДокументыТрансляции КАК ДокументыТрансляции
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
	             |		ПО ДокументыТрансляции.ИсходныйДокумент = Хозрасчетный.Регистратор
	             |			И (Хозрасчетный.СчетДт = &КоррCчет)
	             |			И (Хозрасчетный.СчетКт = &Cчет)";
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("ШаблонТрансляции",ДанныеДляИзменения.ШаблонТрансляции);
	Запрос.УстановитьПараметр("СоответствиеСчетов",ДанныеДляИзменения.СоответствиеСчетов); 
	Запрос.УстановитьПараметр("Cчет",ДанныеДляИзменения.СчетИсточникСсылка);
	Запрос.УстановитьПараметр("КоррCчет",ДанныеДляИзменения.КоррСчетИсточникСсылка);
	
	ДанныеДляЗаписи=Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей=РегистрыСведений.ДокументыДляПовторнойТрансляции.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ШаблонТрансляции.Установить(ДанныеДляИзменения.ШаблонТрансляции);
	НаборЗаписей.Отбор.СоответствиеСчетов.Установить(ДанныеДляИзменения.СоответствиеСчетов);
	
	НаборЗаписей.Загрузить(ДанныеДляЗаписи);
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры // УстановитьПризнакПовторнойТрансляцииПоКорреспонденции()

Процедура ОтметитьТрансляциюДокумента(ДокументТрансляции) Экспорт
	
	НаборЗаписей=РегистрыСведений.ДокументыДляПовторнойТрансляции.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументТрансляции.Установить(ДокументТрансляции);
	НаборЗаписей.Записать();
		
КонецПроцедуры // ОтметитьТрансляциюДокумента() 

Функция ОпределитьНеобходимостьПерезаполнения(ОбъектТрансляции) Экспорт

	Если ТипЗнч(ОбъектТрансляции)=Тип("Структура") Тогда
		
		Возврат ИнформацияОбработкиТрансляция(ОбъектТрансляции);
		
	Иначе
		
		Возврат ИнформацияОбработкиИсходныйДокумент(ОбъектТрансляции);
		
	КонецЕсли;	
	
КонецФункции // ОпределитьНеобходимостьПерезаполнения() 

Функция ИнформацияОбработкиТрансляция(ОбъектТрансляции)
	
	Если ЗначениеЗаполнено(ОбъектТрансляции.ИсходныйДокумент) Тогда
		
		Возврат ИнформацияОбработкиПодокументнаяТрансляция(ОбъектТрансляции);
		
	Иначе
		
		Возврат ИнформацияОбработкиСводнаяТрансляция(ОбъектТрансляции);
		
	КонецЕсли;
			
КонецФункции // ИнформацияОбработкиТрансляция()

Функция ИнформацияОбработкиПодокументнаяТрансляция(ОбъектТрансляции)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	&ТекстИзмененШаблон КАК ТекстОбработки,
	             |	ДокументыДляПовторнойТрансляции.ИсходныйДокумент КАК ИсходныйДокумент
	             |ИЗ
	             |	РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции
	             |ГДЕ
	             |	ДокументыДляПовторнойТрансляции.ДокументТрансляции = &ДокументТрансляции
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	&ТекстИсходныеДанные,
	             |	ОтражениеДокументовПоШаблонам.ИсходныйДокумент
	             |ИЗ
	             |	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |ГДЕ
	             |	(ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения = &ДокументТрансляции
	             |				И ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения = НЕОПРЕДЕЛЕНО
	             |			ИЛИ ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения = &ДокументТрансляции)
	             |	И НЕ ОтражениеДокументовПоШаблонам.ОтраженоВСледующемПериоде
	             |	И ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Нет)";
	
	Запрос.УстановитьПараметр("ДокументТрансляции",ОбъектТрансляции.Ссылка);
	Запрос.УстановитьПараметр("ИсходныйДокумент",ОбъектТрансляции.ИсходныйДокумент);
	Запрос.УстановитьПараметр("ПараметрПроведен",ОбъектТрансляции.Проведен);
	Запрос.УстановитьПараметр("ТекстИзмененШаблон",НСтр("ru = ' изменены настройки трансляции'"));
	Запрос.УстановитьПараметр("ТекстИсходныеДанные",НСтр("ru = ' изменены данные исходного документа'"));
	
	ТекстСообщения="";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ТекстСообщения=ТекстСообщения+","+Результат.ТекстОбработки;
		
	КонецЦикла;
	
	Возврат Сред(ТекстСообщения,2);
	
КонецФункции // ИнформацияОбработкиПодокументнаяТрансляция()

Функция ИнформацияОбработкиСводнаяТрансляция(ОбъектТрансляции)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ДокументыСводнойТрансляции.ЕстьРасхождения КАК ЕстьРасхождения,
	|	ДокументыСводнойТрансляции.ИзмененыИсходныеДанные КАК ИзмененыИсходныеДанные,
	|	ДокументыСводнойТрансляции.ИзмененШаблонКорректировки КАК ИзмененШаблонКорректировки
	|ИЗ
	|	РегистрСведений.ДокументыСводнойТрансляции КАК ДокументыСводнойТрансляции
	|ГДЕ
	|	ДокументыСводнойТрансляции.ДокументТрансляции = &ДокументТрансляции"; 
	
	Запрос.УстановитьПараметр("ДокументТрансляции",ОбъектТрансляции.Ссылка);
	
	ТекстСообщения="";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Если Результат.ИзмененыИсходныеДанные Тогда
			
			ТекстСообщения=ТекстСообщения+","+НСтр("ru = ' изменены исходные данные'");
			
		КонецЕсли;
		
		Если Результат.ИзмененШаблонКорректировки Тогда
			
			ТекстСообщения=ТекстСообщения+","+НСтр("ru = ' изменены настройки трансляции'");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Сред(ТекстСообщения,2); 
	
КонецФункции // ИнформацияОбработкиСводнаяТрансляция()

Функция ИнформацияОбработкиИсходныйДокумент(ИсходныйДокумент)
	
	МетаданныеИсточника = ИсходныйДокумент.Метаданные();
		
	Если ОбщегоНазначенияУХ.ЕстьРеквизитОбъектаМД("Сценарий", МетаданныеИсточника) Тогда
		
		ДанныеОбъекта=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходныйДокумент,"Организация,Дата,Сценарий");		
		РабочийСценарий=ДанныеОбъекта.Сценарий;
		
	Иначе
		
		ДанныеОбъекта=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходныйДокумент,"Организация,Дата");
		РабочийСценарий=Константы.СценарийМСФО.Получить();
		
	КонецЕсли;
	
	ДанныеУчетнойПолитики=ПолучитьДанныеУчетнойПолитики(ДанныеОбъекта.Организация,РабочийСценарий,ДанныеОбъекта.Дата);
	
	Если ДанныеУчетнойПолитики.СпособТрансляции=Перечисления.СпособыТрансляции.СводныеПоДатам Тогда
		
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для организации %1 и периода %2 установлен способ трансляции ""Сводные по датам""'"), ИсходныйДокумент.Организация,Формат(ИсходныйДокумент.Дата,"ДФ=dd.MM.yy"));
		
	КонецЕсли;	
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	&ТекстИзмененШаблон КАК ТекстОбработки,
	             |	ДокументыДляПовторнойТрансляции.ИсходныйДокумент КАК ИсходныйДокумент
	             |ИЗ
	             |	РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции
	             |ГДЕ
	             |	ДокументыДляПовторнойТрансляции.ИсходныйДокумент = &ИсходныйДокумент
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	&ТекстИсходныеДанные,
	             |	ОтражениеДокументовПоШаблонам.ИсходныйДокумент
	             |ИЗ
	             |	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |ГДЕ
	             |	ОтражениеДокументовПоШаблонам.ИсходныйДокумент = &ИсходныйДокумент
	             |	И НЕ ОтражениеДокументовПоШаблонам.ОтраженоВСледующемПериоде
				 |	И ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Нет)";
	
	Запрос.УстановитьПараметр("ИсходныйДокумент",ИсходныйДокумент);
	Запрос.УстановитьПараметр("ТекстИзмененШаблон",НСтр("ru = ' изменены настройки трансляции'"));
	Запрос.УстановитьПараметр("ТекстИсходныеДанные",НСтр("ru = ' отражение документа по шаблонам не выполнено'"));
	
	ТекстСообщения="";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ТекстСообщения=ТекстСообщения+","+Результат.ТекстОбработки;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		
		Возврат НСтр("ru = 'Требуется отражение по шаблонам:'")+Сред(ТекстСообщения,2);
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
		
КонецФункции // ИнформацияОбработкиТрансляция()


Процедура ХозрасчетныйПередЗаписьюУХПередЗаписью(Источник, Отказ, РежимЗаписи) Экспорт
	
	Если Источник.Количество()>0 Тогда
						
		Для Каждого ЭлементОтбора ИЗ Источник.Отбор Цикл
			
			Если ЭлементОтбора.Имя="Регистратор" Тогда
				
				ИсходныйДокумент=ЭлементОтбора.Значение;
				Прервать
				
			КонецЕсли;
			
		КонецЦикла;
	
		Если ОтражениеПоНСБУЗаблокировано(ИсходныйДокумент) Тогда
			
			Источник.УстановитьАктивность(Ложь);
						
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписиИсходногоДокументаТрансляцииПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("ПометкаУдаленияПередЗаписью") Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ПометкаУдаления = Источник.ДополнительныеСвойства.ПометкаУдаленияПередЗаписью Тогда		
		Возврат;	
	КонецЕсли;
	
	Если Источник.ПометкаУдаления Тогда
		
		УстановитьПометкуУдаленияПоИсходномуДокументу(Источник.Ссылка);
		
	Иначе
		
		СнятьПометкуУдаленияПоИсходномуДокументу(Источник.Ссылка);
		
	КонецЕсли;

КонецПроцедуры  

Процедура УстановитьПометкуУдаленияПоИсходномуДокументу(ИсходныйДокументСсылка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ ОбщегоНазначенияУХ.ЕстьРеквизитОбъектаМД("Организация", ИсходныйДокументСсылка.Метаданные()) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	Трансляция.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Трансляция КАК Трансляция
	|ГДЕ
	|	Трансляция.ИсходныйДокумент = &ИсходныйДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТрансформационнаяКорректировка.Ссылка
	|ИЗ
	|	Документ.ТрансформационнаяКорректировка КАК ТрансформационнаяКорректировка
	|ГДЕ
	|	ТрансформационнаяКорректировка.ИсходныйДокумент = &ИсходныйДокумент";
	
	Запрос.УстановитьПараметр("ИсходныйДокумент",ИсходныйДокументСсылка);
	Результат=Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	ДанныеДокумента=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходныйДокументСсылка,"Организация,Дата");
	
	ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(ДанныеДокумента.Организация);
	
	Если ДанныеЗакрытияПериода.ДатаЗакрытияПериода>=ДанныеДокумента.Дата Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЕстьОтражениеВСледующемПериоде=Ложь;
	
	НаборЗаписей=РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИсходныйДокумент.Установить(ИсходныйДокументСсылка);
	
	НаборЗаписей.Прочитать();
	МассивЗаписейКУдалению=Новый Массив;
	МассивДокументовОтражения=Новый Массив;
	
	Для Каждого СтрокаЗапись ИЗ НаборЗаписей Цикл
		
		Если СтрокаЗапись.ОтраженоВСледующемПериоде Тогда
			
			Возврат;
			
		КонецЕсли;
			
		Если ЗначениеЗаполнено(СтрокаЗапись.ДокументПервогоОтражения) 
			И ЗначениеЗаполнено(СтрокаЗапись.ДокументПоследнегоОтражения) Тогда
			
			Продолжить;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаЗапись.ДокументПервогоОтражения) 
			И (НЕ ЗначениеЗаполнено(СтрокаЗапись.ДокументСторноПервогоОтражения)) Тогда // Один раз отражался до закрытия периода
			
			МассивЗаписейКУдалению.Добавить(СтрокаЗапись);
			МассивДокументовОтражения.Добавить(СтрокаЗапись.ДокументПервогоОтражения);
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаЗапись.ДокументПоследнегоОтражения) Тогда // Один раз отражался после закрытия периода
			
			МассивЗаписейКУдалению.Добавить(СтрокаЗапись);
			МассивДокументовОтражения.Добавить(СтрокаЗапись.ДокументПоследнегоОтражения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивЗаписейКУдалению.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого ЗаписьКУдалению ИЗ МассивЗаписейКУдалению Цикл
		
		НаборЗаписей.Удалить(ЗаписьКУдалению);
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
	Для Каждого ДокументОтражения ИЗ МассивДокументовОтражения Цикл
		
		ДокументОбъект=ДокументОтражения.ПолучитьОбъект();
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		
	КонецЦикла;
			
КонецПроцедуры // УстановитьПометкуУдаленияПоИсходномуДокументу() 

Процедура СнятьПометкуУдаленияПоИсходномуДокументу(ИсходныйДокументСсылка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	Трансляция.Ссылка КАК Ссылка
	             |ИЗ
	             |	Документ.Трансляция КАК Трансляция
	             |ГДЕ
	             |	Трансляция.ИсходныйДокумент = &ИсходныйДокумент
	             |	И Трансляция.ПометкаУдаления
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ТрансформационнаяКорректировка.Ссылка
	             |ИЗ
	             |	Документ.ТрансформационнаяКорректировка КАК ТрансформационнаяКорректировка
	             |ГДЕ
	             |	ТрансформационнаяКорректировка.ИсходныйДокумент = &ИсходныйДокумент
	             |	И ТрансформационнаяКорректировка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИсходныйДокумент",ИсходныйДокументСсылка);
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ДокументОбъект=Результат.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ПометкаУдаления=Ложь;
		ДокументОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры // СнятьПометкуУдаленияПоИсходномуДокументу() 

Процедура ПередЗаписьюИсходногоДокументаТрансляцииПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если ГрупповоеПерепроведение(Источник) Тогда
		Возврат;
	КонецЕсли; 
		
	Источник.ДополнительныеСвойства.Вставить("ПометкаУдаленияПередЗаписью",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ПометкаУдаления"));
	
КонецПроцедуры 

Функция ГрупповоеПерепроведение(Объект) Экспорт

	Перем Результат;
	
	Если Объект.ДополнительныеСвойства.Свойство("ГрупповоеПерепроведение", Результат) Тогда
		Если Результат <> Ложь Тогда
			Результат = Истина;
		КонецЕсли;
	Иначе
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции
