		|			И ДокументыТрансляцииШаблон.ДатаНачалаОтражения > ДатыЗапретаОрганизации.ДатаЗапрета
		|;";
		
		Запрос.УстановитьПараметр("ДатыЗапретаОрганизации",ДанныеЗапрета.ДатыЗапретаОрганизации);
	Иначе
