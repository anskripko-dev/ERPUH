Функция ПолучитьДанныеУчетнойПолитики(Организация,Сценарий,Период) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика КАК УчетнаяПолитика,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ВалютаУчета КАК ВалютаУчета,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ВалютаУчетаДоп КАК ВалютаУчетаДоп,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции.НаправлениеТрансляции КАК НаправлениеТрансляции,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции,
	             |	УчетныеПолитикиМСФО.Период КАК Период,
	             |	ВЫБОР
	             |		КОГДА УчетныеПолитикиМСФО.Организация = &Организация
	             |			ТОГДА 1
	             |		ИНАЧЕ 0
	             |	КОНЕЦ КАК СтепеньСоответствия,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ВалютаИсточник КАК ВалютаИсточник,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ВалютаИсточникДоп КАК ВалютаИсточникДоп,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ПланСчетовУчета КАК ПланСчетовУчета,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ДействиеПриИзмененииВЗакрытомПериоде КАК ДействиеВЗакрытомПериоде,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика.БезКорреспонденции КАК БезКорреспонденции
	             |ИЗ
	             |	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
	             |ГДЕ
	             |	(УчетныеПолитикиМСФО.Организация = &Организация
	             |			ИЛИ УчетныеПолитикиМСФО.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	             |	И УчетныеПолитикиМСФО.Сценарий = &Сценарий
	             |	И УчетныеПолитикиМСФО.Период <= &Период
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	УчетныеПолитикиМСФО.Период УБЫВ,
	             |	СтепеньСоответствия УБЫВ";
	
	Запрос.УстановитьПараметр("Период",?(ЗначениеЗаполнено(Период),Период,ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Сценарий",?(ЗначениеЗаполнено(Сценарий),Сценарий,Справочники.Сценарии.Факт));
	
	УстановитьПривилегированныйРежим(Истина);//читаем в тч пустую УП
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("ВалютаУчета",			Результат.ВалютаУчета);
		СтруктураПараметров.Вставить("ВалютаУчетаДоп",		Результат.ВалютаУчетаДоп);
		СтруктураПараметров.Вставить("ВалютаИсточник",		Результат.ВалютаИсточник);
		СтруктураПараметров.Вставить("ВалютаИсточникДоп",	Результат.ВалютаИсточникДоп);
		СтруктураПараметров.Вставить("ШаблонТрансляции",	Результат.ШаблонТрансляции);
		СтруктураПараметров.Вставить("СпособТрансляции",	Результат.СпособТрансляции);
		СтруктураПараметров.Вставить("УчетнаяПолитика",		Результат.УчетнаяПолитика);
		СтруктураПараметров.Вставить("НаправлениеТрансляции",Результат.НаправлениеТрансляции);
		СтруктураПараметров.Вставить("ПланСчетовУчета",		Результат.ПланСчетовУчета);
		СтруктураПараметров.Вставить("ДействиеВЗакрытомПериоде",Результат.ДействиеВЗакрытомПериоде);
		СтруктураПараметров.Вставить("БезКорреспонденции",Результат.БезКорреспонденции);

		
		
		Возврат СтруктураПараметров;
		
	Иначе
		
		ВалютаПоУмолчанию=Константы.ВалютаУправленческогоУчета.Получить(); 
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("ВалютаУчета",			ВалютаПоУмолчанию);
		СтруктураПараметров.Вставить("ВалютаУчетаДоп",		ВалютаПоУмолчанию);
		СтруктураПараметров.Вставить("ВалютаИсточник",		ВалютаПоУмолчанию);
		СтруктураПараметров.Вставить("ВалютаИсточникДоп",	ВалютаПоУмолчанию);
				
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		             |	ШаблоныТрансляций.Ссылка КАК Ссылка,
		             |	ШаблоныТрансляций.НаправлениеТрансляции КАК НаправлениеТрансляции,
		             |	ШаблоныТрансляций.ПланСчетовПриемник КАК ПланСчетовПриемник
		             |ИЗ
		             |	Справочник.ШаблоныТрансляций КАК ШаблоныТрансляций
		             |ГДЕ
		             |	ШаблоныТрансляций.РегистрБухгалтерииПриемник = &МСФО
		             |	И ШаблоныТрансляций.РегистрБухгалтерииИсточник = &Хозрасчетный";
		
		Запрос.УстановитьПараметр("МСФО",			Справочники.РегистрыБухгалтерииБД.НайтиПоНаименованию("МСФО",			Истина,,Справочники.ТипыБазДанных.ТекущаяИБ));
		Запрос.УстановитьПараметр("Хозрасчетный",	Справочники.РегистрыБухгалтерииБД.НайтиПоНаименованию("Хозрасчетный",	Истина,,Справочники.ТипыБазДанных.ТекущаяИБ));
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			СтруктураПараметров.Вставить("ШаблонТрансляции",Результат.Ссылка);
			СтруктураПараметров.Вставить("НаправлениеТрансляции",Результат.НаправлениеТрансляции);
			СтруктураПараметров.Вставить("ПланСчетовУчета",Результат.ПланСчетовПриемник);
			
		Иначе
			
			СтруктураПараметров.Вставить("ШаблонТрансляции",Справочники.ШаблоныТрансляций.ПустаяСсылка());
			СтруктураПараметров.Вставить("НаправлениеТрансляции",Перечисления.НаправленияТрансляцииДанных.ПустаяСсылка());
			СтруктураПараметров.Вставить("ПланСчетовУчета",Справочники.ПланыСчетовБД.ПолучитьПланСчетовБД());
			
		КонецЕсли;
		
		СтруктураПараметров.Вставить("СпособТрансляции",Перечисления.СпособыТрансляции.СводныеПоДатам);
		СтруктураПараметров.Вставить("УчетнаяПолитика");
		СтруктураПараметров.Вставить("БезКорреспонденции",Ложь);
		СтруктураПараметров.Вставить("ДействиеВЗакрытомПериоде",Перечисления.ДействияПриИзмененииВЗакрытомПериодеМСФО.ОтразитьВОткрытомПериоде);
	
		Возврат СтруктураПараметров;
		
	КонецЕсли;
				
КонецФункции // ПолучитьУчетнуюПолитику()

Функция ПолучитьПланСчетовОрганизации(Организация,Сценарий,Период) Экспорт
	
	Возврат ПолучитьДанныеУчетнойПолитики(Организация,Сценарий,Период).ПланСчетовУчета;	
			
КонецФункции // ПолучитьПланСчетовОрганизации() 


Функция ПолучитьТаблицаДанныхТрансляции(Организация,ИмяРегистра,Период,Сценарий=Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ШаблоныТрансляций.Ссылка КАК ШаблоныТрансляций
	             |ПОМЕСТИТЬ ВозможныеШаблоны
	             |ИЗ
	             |	Справочник.ШаблоныТрансляций КАК ШаблоныТрансляций
	             |ГДЕ
	             |	ШаблоныТрансляций.РегистрБухгалтерииИсточник = &РегистрБухгалтерииИсточник
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	УчетныеПолитикиМСФО.Период КАК Период,
	             |	УчетныеПолитикиМСФО.Организация КАК Организация,
	             |	УчетныеПолитикиМСФО.Сценарий КАК Сценарий,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика КАК УчетнаяПолитика,
	             |	ВЫБОР
	             |		КОГДА УчетныеПолитикиМСФО.Организация = &Организация
	             |			ТОГДА 1
	             |		ИНАЧЕ 0
	             |	КОНЕЦ КАК УровеньСоответствия
	             |ПОМЕСТИТЬ УчетныеПолитикиОрганизации
	             |ИЗ
	             |	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
	             |ГДЕ
	             |	(УчетныеПолитикиМСФО.Организация = &Организация
	             |			ИЛИ УчетныеПолитикиМСФО.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	             |	И УчетныеПолитикиМСФО.Период <= &Период
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	УчетныеПолитикиОрганизации.Сценарий КАК Сценарий,
	             |	МАКСИМУМ(УчетныеПолитикиОрганизации.Период) КАК Период
	             |ПОМЕСТИТЬ ДатыСценариев
	             |ИЗ
	             |	УчетныеПолитикиОрганизации КАК УчетныеПолитикиОрганизации
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	УчетныеПолитикиОрганизации.Сценарий
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ДатыСценариев.Сценарий КАК Сценарий,
	             |	ДатыСценариев.Период КАК Период,
	             |	МАКСИМУМ(УчетныеПолитикиОрганизации.УровеньСоответствия) КАК УровеньСоответствия
	             |ПОМЕСТИТЬ ДатыСценариевСоответствие
	             |ИЗ
	             |	ДатыСценариев КАК ДатыСценариев
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетныеПолитикиОрганизации КАК УчетныеПолитикиОрганизации
	             |		ПО ДатыСценариев.Сценарий = УчетныеПолитикиОрганизации.Сценарий
	             |			И ДатыСценариев.Период = УчетныеПолитикиОрганизации.Период
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	ДатыСценариев.Сценарий,
	             |	ДатыСценариев.Период
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	УчетныеПолитикиОрганизации.Сценарий КАК Сценарий,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика КАК УчетнаяПолитика,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика.ДействиеПриИзмененииВЗакрытомПериоде КАК ДействиеВЗакрытомПериоде
	             |ПОМЕСТИТЬ УчетныеПолитики
	             |ИЗ
	             |	ДатыСценариевСоответствие КАК ДатыСценариевСоответствие
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетныеПолитикиОрганизации КАК УчетныеПолитикиОрганизации
	             |		ПО ДатыСценариевСоответствие.Сценарий = УчетныеПолитикиОрганизации.Сценарий
	             |			И ДатыСценариевСоответствие.Период = УчетныеПолитикиОрганизации.Период
	             |			И ДатыСценариевСоответствие.УровеньСоответствия = УчетныеПолитикиОрганизации.УровеньСоответствия
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	&Организация КАК Организация,
	             |	ЛОЖЬ КАК Обработано,
	             |	УчетныеПолитики.Сценарий КАК Сценарий,
	             |	УчетныеПолитики.УчетнаяПолитика КАК УчетнаяПолитика,
	             |	УчетныеПолитики.ШаблонТрансляции КАК ШаблонТрансляции,
	             |	ВЫБОР
	             |		КОГДА &ЭтоБП
	             |			ТОГДА &СпособТрансляции
	             |		ИНАЧЕ УчетныеПолитики.СпособТрансляции
	             |	КОНЕЦ КАК СпособТрансляции,
	             |	УчетныеПолитики.ДействиеВЗакрытомПериоде КАК ДействиеВЗакрытомПериоде
	             |ИЗ
	             |	УчетныеПолитики КАК УчетныеПолитики
	             |ГДЕ
	             |	(&ЭтоБП
	             |			ИЛИ УчетныеПолитики.СпособТрансляции <> ЗНАЧЕНИЕ(Перечисление.СпособыТрансляции.СводныеПоДатам))
	             |	И УчетныеПолитики.ШаблонТрансляции В
	             |			(ВЫБРАТЬ
	             |				ВозможныеШаблоны.ШаблоныТрансляций
	             |			ИЗ
	             |				ВозможныеШаблоны)";
	
	Если НЕ Сценарий=Неопределено Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|	И УчетныеПолитики.Сценарий=&Сценарий";
		Запрос.УстановитьПараметр("Сценарий",Сценарий);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("РегистрБухгалтерииИсточник",КэшируемыеПроцедурыУХ.ПолучитьОписаниеРегистраТекущейИБ(ИмяРегистра));
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Период",Период);
	Запрос.УстановитьПараметр("ЭтоБП",НЕ ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом());
	Запрос.УстановитьПараметр("СпособТрансляции",Константы.СпособТрансляции.Получить());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
		
КонецФункции // ПолучитьМассивДанныхТрансляция() 

Функция ПолучитьТаблицаДанныхТрансляцииРегистров(Организация,Период)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ШаблоныТрансляций.Ссылка КАК ШаблоныТрансляций
	             |ПОМЕСТИТЬ ВозможныеШаблоны
	             |ИЗ
	             |	Справочник.ШаблоныТрансляций КАК ШаблоныТрансляций
	             |ГДЕ
	             |	ШаблоныТрансляций.НаправлениеТрансляции = ЗНАЧЕНИЕ(Перечисление.НаправленияТрансляцииДанных.ФинансовыеРегистрыВРегистрБухгалтерии)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	УчетныеПолитикиМСФО.Период КАК Период,
	             |	УчетныеПолитикиМСФО.Организация КАК Организация,
	             |	УчетныеПолитикиМСФО.Сценарий КАК Сценарий,
	             |	УчетныеПолитикиМСФО.УчетнаяПолитика КАК УчетнаяПолитика,
	             |	ВЫБОР
	             |		КОГДА УчетныеПолитикиМСФО.Организация = &Организация
	             |			ТОГДА 1
	             |		ИНАЧЕ 0
	             |	КОНЕЦ КАК УровеньСоответствия
	             |ПОМЕСТИТЬ УчетныеПолитикиОрганизации
	             |ИЗ
	             |	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
	             |ГДЕ
	             |	(УчетныеПолитикиМСФО.Организация = &Организация
	             |			ИЛИ УчетныеПолитикиМСФО.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	             |	И УчетныеПолитикиМСФО.Период <= &Период
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	УчетныеПолитикиОрганизации.Сценарий КАК Сценарий,
	             |	МАКСИМУМ(УчетныеПолитикиОрганизации.Период) КАК Период
	             |ПОМЕСТИТЬ ДатыСценариев
	             |ИЗ
	             |	УчетныеПолитикиОрганизации КАК УчетныеПолитикиОрганизации
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	УчетныеПолитикиОрганизации.Сценарий
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ДатыСценариев.Сценарий КАК Сценарий,
	             |	ДатыСценариев.Период КАК Период,
	             |	МАКСИМУМ(УчетныеПолитикиОрганизации.УровеньСоответствия) КАК УровеньСоответствия
	             |ПОМЕСТИТЬ ДатыСценариевСоответствие
	             |ИЗ
	             |	ДатыСценариев КАК ДатыСценариев
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетныеПолитикиОрганизации КАК УчетныеПолитикиОрганизации
	             |		ПО ДатыСценариев.Сценарий = УчетныеПолитикиОрганизации.Сценарий
	             |			И ДатыСценариев.Период = УчетныеПолитикиОрганизации.Период
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	ДатыСценариев.Сценарий,
	             |	ДатыСценариев.Период
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	УчетныеПолитикиОрганизации.Сценарий КАК Сценарий,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика КАК УчетнаяПолитика,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции,
	             |	УчетныеПолитикиОрганизации.УчетнаяПолитика.ДействиеПриИзмененииВЗакрытомПериоде КАК ДействиеВЗакрытомПериоде
	             |ПОМЕСТИТЬ УчетныеПолитики
	             |ИЗ
	             |	ДатыСценариевСоответствие КАК ДатыСценариевСоответствие
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетныеПолитикиОрганизации КАК УчетныеПолитикиОрганизации
	             |		ПО ДатыСценариевСоответствие.Сценарий = УчетныеПолитикиОрганизации.Сценарий
	             |			И ДатыСценариевСоответствие.Период = УчетныеПолитикиОрганизации.Период
	             |			И ДатыСценариевСоответствие.УровеньСоответствия = УчетныеПолитикиОрганизации.УровеньСоответствия
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	&Организация КАК Организация,
	             |	ЛОЖЬ КАК Обработано,
	             |	УчетныеПолитики.Сценарий КАК Сценарий,
	             |	УчетныеПолитики.УчетнаяПолитика КАК УчетнаяПолитика,
	             |	УчетныеПолитики.ШаблонТрансляции КАК ШаблонТрансляции,
	             |	УчетныеПолитики.ДействиеВЗакрытомПериоде КАК ДействиеВЗакрытомПериоде,
	             |	УчетныеПолитики.СпособТрансляции КАК СпособТрансляции
	             |ИЗ
	             |	УчетныеПолитики КАК УчетныеПолитики
	             |ГДЕ
	             |	УчетныеПолитики.СпособТрансляции <> ЗНАЧЕНИЕ(Перечисление.СпособыТрансляции.СводныеПоДатам)
	             |	И УчетныеПолитики.ШаблонТрансляции В
	             |			(ВЫБРАТЬ
	             |				ВозможныеШаблоны.ШаблоныТрансляций
	             |			ИЗ
	             |				ВозможныеШаблоны)";
	
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Период",Период);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
		
КонецФункции // ПолучитьМассивДанныхТрансляция()

Функция ПолучитьСпособТрансляции(Организация,Период,Сценарий) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции
	|ИЗ
	|	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
	|ГДЕ
	|	УчетныеПолитикиМСФО.Сценарий = &Сценарий
	|	И (УчетныеПолитикиМСФО.Организация = &Организация
	|			ИЛИ УчетныеПолитикиМСФО.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И УчетныеПолитикиМСФО.Период <= &Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	УчетныеПолитикиМСФО.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Период",		Период);
	Запрос.УстановитьПараметр("Сценарий",	Сценарий);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Возврат Результат.СпособТрансляции;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
			
КонецФункции // ПолучитьМассивДанныхТрансляция()


Функция ВозможнаТрансляцияПоДокументам(Организация) Экспорт

	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетныеПолитикиМСФО.УчетнаяПолитика КАК УчетнаяПолитика
	|ИЗ
	|	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
	|ГДЕ
	|	(УчетныеПолитикиМСФО.Организация = &Организация
	|			ИЛИ УчетныеПолитикиМСФО.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции <> ЗНАЧЕНИЕ(Перечисление.СпособыТрансляции.СводныеПоДатам)";
	
	Запрос.УстановитьПараметр("Организация",Организация);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // ВозможнаТрансляцияПоДокументам()

Функция ПроверитьВозможностьТрансляцииВЗакрытомПериоде(ИсходныйДокумент,Организация,Период,ДатаЗакрытияПериода,ТаблицаДанныхТрансляции)
	
	ТекстОшибки="";
	
	Если Период>=ДатаЗакрытияПериода Тогда
		
		Возврат "";
		
	Иначе
		
		Для Каждого Строка ИЗ ТаблицаДанныхТрансляции Цикл
			
			Если Строка.ДействиеВЗакрытомПериоде=Перечисления.ДействияПриИзмененииВЗакрытомПериодеМСФО.ЗапретитьИзменения Тогда
				
				ТекстОшибки=ТекстОшибки+Символы.ПС+ПолучитьТекстЗапретаИзменения(
					Организация,
					Строка.Сценарий,
					Строка.УчетнаяПолитика,
					ИсходныйДокумент,
					ДатаЗакрытияПериода);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Сред(ТекстОшибки,2);
					
КонецФункции // ПроверитьВозможностьТрансляцииВЗакрытомПериоде()

Функция ПолучитьТекстЗапретаИзменения(Организация,Сценарий,УчетнаяПолитика,Документ,ДатаЗакрытияПериода) Экспорт

	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Организация %1, сценарий %2, учетная политика %3, документ %4. Установлен запрет на изменение данных НСБУ в закрытом периоде МСФО: %5'"),
					Организация,
					Сценарий,
					УчетнаяПолитика,
					Документ,
					ДатаЗакрытияПериода);
		
КонецФункции // ПолучитьТекстЗапретаИзменения()
				
Функция ПолучитьТекстБезОтражения(Организация,Сценарий,УчетнаяПолитика,Документ,ДатаЗакрытияПериода) Экспорт

	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Организация %1, сценарий %2, учетная политика %3, документ %4. При изменении данных НСБУ в закрытом периоде МСФО: %5 изменения в МСФО не отражаются'"),
					Организация,
					Сценарий,
					УчетнаяПолитика,
					Документ,
					ДатаЗакрытияПериода);
	
	
КонецФункции // ПолучитьТекстБезОтражения()	

Функция ПолучитьТаблицуЗаписей(НаборЗаписей) Экспорт
	
    ТаблицаЗаписей=НаборЗаписей.Выгрузить().СкопироватьКолонки();
	
	Возврат ТаблицаЗаписей;	
	
КонецФункции // ПолучитьТаблицуЗаписей() 

Процедура ПроверитьУстановитьДатуОтражения(ДанныеОбъекта) Экспорт
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.ДатаОтражения) Тогда
		
		Возврат;
		
	Иначе
		
		ДанныеОбъекта.ДатаОтражения=ДанныеОбъекта.ПериодОтражения.ДатаОкончания;
		
	КонецЕсли;		
	
КонецПроцедуры // ПроверитьУстановитьДатуОтражения()

Процедура ОбработатьНаборЗаписейПоПериодам(НаборЗаписей,ДанныеЗакрытияПериода) Экспорт

	МассивКУдалению=Новый Массив; 
	
	ТекТаблицаЗаписей=НаборЗаписей.Выгрузить();
	
	Для Каждого ДанныеОбъекта ИЗ ТекТаблицаЗаписей Цикл 
		
		ПроверитьУстановитьДатуОтражения(ДанныеОбъекта);
		
	КонецЦикла;
	
	ТекТаблицаЗаписей.Сортировать("ДатаОтражения Возр");
	
	Для Индекс=0 ПО ТекТаблицаЗаписей.Количество()-1 Цикл
		
		ДанныеОбъекта=ТекТаблицаЗаписей[Индекс];	
		
		Если ДанныеОбъекта.ДатаЗакрытияПериодаОтражения>ДанныеЗакрытияПериода.ДатаЗакрытияПериода Тогда // Повторно открыт период, по которому были произведены корректировки в следующих периодах
			
			Если Индекс=0 Тогда
				
				ОчиститьДанныеОбъекта(ДанныеОбъекта);
				
				Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ДокументПервогоОтражения) Тогда
					
					МассивКУдалению.Добавить(ДанныеОбъекта);
					
				Иначе
					
					ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода="";
					ДанныеОбъекта.ДатаЗакрытияПериодаОтражения="";
					
				КонецЕсли;
				
			Иначе
				
				ОчиститьДанныеОбъекта(ДанныеОбъекта,Истина);
				МассивКУдалению.Добавить(ДанныеОбъекта);
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка ИЗ МассивКУдалению Цикл
		
		ТекТаблицаЗаписей.Удалить(Строка);
		
	КонецЦикла; 
	
	Если ТекТаблицаЗаписей.Количество()>0 Тогда
		
		ТекТаблицаЗаписей[ТекТаблицаЗаписей.Количество()-1].ОтраженоВСледующемПериоде=Ложь;
		
	КонецЕсли;
	
	НаборЗаписей.Загрузить(ТекТаблицаЗаписей);
			
КонецПроцедуры // ОбработатьНаборЗаписейПоПериодам()
			
Процедура ОчиститьДанныеОбъекта(ДанныеОбъекта,ПолнаяОчистка=Ложь) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументСторноПервогоОтражения) Тогда
		
		ДокументОбъект=ДанныеОбъекта.ДокументСторноПервогоОтражения.ПолучитьОбъект(); 
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		ДанныеОбъекта.ДокументСторноПервогоОтражения=Неопределено;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПоследнегоОтражения) Тогда
		
		ДокументОбъект=ДанныеОбъекта.ДокументПоследнегоОтражения.ПолучитьОбъект(); 
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		ДанныеОбъекта.ДокументПоследнегоОтражения=Неопределено;
		
	КонецЕсли;
	
	Если ПолнаяОчистка И ЗначениеЗаполнено(ДанныеОбъекта.ДокументПервогоОтражения) Тогда
		
		ДокументОбъект=ДанныеОбъекта.ДокументПервогоОтражения.ПолучитьОбъект(); 
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		ДанныеОбъекта.ДокументПервогоОтражения=Неопределено;
		
	КонецЕсли;	
	
КонецПроцедуры // ОчиститьДанныеОбъекта(ДанныеОбъекта)			
				

Процедура ВыполнитьТрансляциюДокумента(ИсходныйДокумент,Организация,ИмяРегистра,ДанныеПроведения,Источник,Отказ)
	
	ДанныеПроведения.Вставить("Организация",Организация);
	ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(ДанныеПроведения.Организация);
	ДанныеЗакрытияПериода.Вставить("Период",ДанныеПроведения.Период);
	
	ТаблицаДанныхТрансляции= ПолучитьТаблицаДанныхТрансляции(Организация,ИмяРегистра,ДанныеПроведения.Период);
	
	ТекстОшибки=ПроверитьВозможностьТрансляцииВЗакрытомПериоде(ИсходныйДокумент,ДанныеПроведения.Организация,ДанныеПроведения.Период,ДанныеЗакрытияПериода.ДатаЗакрытияПериода,ТаблицаДанныхТрансляции);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,Отказ,,СтатусСообщения.ОченьВажное,,ИсходныйДокумент);
		Возврат;
		
	КонецЕсли;
	
	НаборЗаписей=РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИсходныйДокумент.Установить(ИсходныйДокумент);
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.Трансляция.Установить(Истина); 
	
	ТаблицаЗаписей=ПолучитьТаблицуЗаписей(НаборЗаписей); 
	
	НаборЗаписей.Прочитать(); 
	
	ОбработатьНаборЗаписейПоПериодам(НаборЗаписей,ДанныеЗакрытияПериода);
	
	Если НаборЗаписей.Количество()=0 Тогда
		
		Для Каждого ДанныеТрансляции ИЗ ТаблицаДанныхТрансляции Цикл 
			
			ДобавитьОбъектВОбработку(ДанныеПроведения,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеТрансляции),ТаблицаЗаписей,ИсходныйДокумент,ДанныеЗакрытияПериода);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого ДанныеОбъекта Из НаборЗаписей Цикл 
						
			Если ДанныеОбъекта.ОтраженоВСледующемПериоде Тогда 
								
				Продолжить;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.Сценарий) Тогда
				
				ДанныеОбъекта.Сценарий=ДанныеОбъекта.УдалитьСценарий;
				
			КонецЕсли; 
				
			МассивДанныхТрансляции=ТаблицаДанныхТрансляции.НайтиСтроки(Новый Структура("Организация,Сценарий,ШаблонТрансляции",ДанныеОбъекта.Организация,ДанныеОбъекта.Сценарий,ДанныеОбъекта.ШаблонОперации));
			
			Если МассивДанныхТрансляции.Количество()=0 Тогда // Изменились настройки учетной политики
				
				ОтменитьОбработкуОбъекта(ДанныеОбъекта,ИсходныйДокумент,Отказ);
				
				Если Отказ Тогда
					
					Возврат;
					
				КонецЕсли;
				
			Иначе	
				
				ДанныеОбъекта.ПериодОтбора=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ДанныеПроведения.Период,КэшируемыеПроцедурыУХ.ПолучитьПериодичностьТрансляцииПроводок(),0);
				ДанныеОбъекта.УчетнаяПолитика=МассивДанныхТрансляции[0].УчетнаяПолитика; 
				
				Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПоследнегоОтражения) Тогда 
					
					Если ДанныеОбъекта.ДатаОтражения<=ДанныеЗакрытияПериода.ДатаЗакрытияПериода Тогда
						
						ДанныеОбъекта.ОтраженоВСледующемПериоде=Истина;
						ДобавитьОбъектВОбработку(ДанныеПроведения,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(МассивДанныхТрансляции[0]),ТаблицаЗаписей,ИсходныйДокумент,ДанныеЗакрытияПериода,ДанныеОбъекта.ДокументПоследнегоОтражения);
						
					Иначе
						
						ОбработатьДанныеОбъекта(ДанныеОбъекта,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(МассивДанныхТрансляции[0]),ДанныеЗакрытияПериода,Отказ,Не ДанныеПроведения.Активность); 
						
						Если Отказ Тогда
							
							Возврат;
							
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе		
					
					ОбработатьДанныеОбъекта(ДанныеОбъекта,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(МассивДанныхТрансляции[0]),ДанныеЗакрытияПериода,Отказ,Не ДанныеПроведения.Активность); 
					
					Если Отказ Тогда
						
						Возврат;
						
					КонецЕсли;
					
				КонецЕсли;
				
				МассивДанныхТрансляции[0].Обработано=Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
		МассивДанныхТрансляции=ТаблицаДанныхТрансляции.НайтиСтроки(Новый Структура("Обработано",Ложь));
		
		Для Каждого ДанныеТрансляции ИЗ МассивДанныхТрансляции Цикл // Изменились настройки учетной политики
			
			ДобавитьОбъектВОбработку(ДанныеПроведения,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеТрансляции),ТаблицаЗаписей,ИсходныйДокумент,ДанныеЗакрытияПериода);
			
		КонецЦикла;
		
	КонецЕсли; 
	
	ОбработатьТаблицуЗаписей(НаборЗаписей,ТаблицаЗаписей,ДанныеЗакрытияПериода,Отказ);	
	
	НаборЗаписей.Записать(Истина);
	
	Если ТаблицаДанныхТрансляции.Количество()=0 Тогда
		
		УправлениеОтчетамиУХ.УстановитьПризнакДляСводнойТрансляции(Источник);
		Возврат;
		
	КонецЕсли;
		
КонецПроцедуры // ВыполнитьТрансляциюДокумента() 

Функция ПолучитьОрганизацииИсточника(Источник,РабочийПериод)
	
	МассивОрганизаций=Новый Массив;
	
	Для Каждого Строка ИЗ Источник Цикл
		
		Если МассивОрганизаций.Найти(Строка.Организация)=Неопределено Тогда
			
			МассивОрганизаций.Добавить(Строка.Организация);
			
		КонецЕсли;
		
		Если Строка.Период<РабочийПериод Тогда
			
			РабочийПериод=Строка.Период;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивОрганизаций;
	
КонецФункции // ПолучитьОрганизацииИсточника() 

Процедура ПриИзмененииРегистраБухгалтерииТрансляция(Источник, Отказ, РежимЗаписи) Экспорт
	
	ИмяРегистра=Источник.Метаданные().Имя;
	
	Если Источник.Количество()>0 Тогда
				
		ДанныеПроведения=Новый Структура("Регистратор,Активность",,Истина);
		ЗаполнитьЗначенияСвойств(ДанныеПроведения,Источник[0]);
		
		РабочийПериод=Источник[0].Период;
		
		ИсходныйДокумент=ДанныеПроведения.Регистратор;
		
		Если ОтражениеПоНСБУЗаблокировано(ИсходныйДокумент) Тогда // Транслируем неактивные записи
			
			ДанныеПроведения.Активность=Истина;
			Источник.УстановитьАктивность(Ложь);

			
		КонецЕсли;
				
		МассивОрганизаций=ПолучитьОрганизацииИсточника(Источник,РабочийПериод);
			
		ДанныеПроведения.Вставить("Период",РабочийПериод);
		
		Для Каждого Организация ИЗ МассивОрганизаций Цикл
			
			Если ДанныеПроведения.Активность Тогда 
				
				ВыполнитьТрансляциюДокумента(ИсходныйДокумент,Организация,ИмяРегистра,ДанныеПроведения,Источник,Отказ);
				Обработки.КорректировкиЗначенийПоказателей.ПроверитьОбработатьКорректировкиПоШаблонам(ИсходныйДокумент,Отказ,Ложь,ИмяРегистра);
				
			Иначе
				
				ОтменитьОтражениеДокумента(ИсходныйДокумент,Организация,Отказ);
				Обработки.КорректировкиЗначенийПоказателей.ПроверитьОбработатьКорректировкиПоШаблонам(ИсходныйДокумент,Отказ,Истина,ИмяРегистра);
				
			КонецЕсли;	
			
		КонецЦикла;
				
	Иначе
				
		Для Каждого ЭлементОтбора ИЗ Источник.Отбор Цикл
			
			Если ЭлементОтбора.Имя="Регистратор" Тогда
				
				ИсходныйДокумент=ЭлементОтбора.Значение;
				Прервать
				
			КонецЕсли;
			
		КонецЦикла;
		
		МассивОрганизаций=ПолучитьМассивОрганизацийРегистр(ИсходныйДокумент); 
		
		Для Каждого Организация ИЗ МассивОрганизаций Цикл
			
			ОтменитьОтражениеДокумента(ИсходныйДокумент,Организация,Отказ);
			Обработки.КорректировкиЗначенийПоказателей.ПроверитьОбработатьКорректировкиПоШаблонам(ИсходныйДокумент,Отказ,Истина,ИмяРегистра);
		
		КонецЦикла;
			
	КонецЕсли;
		
КонецПроцедуры // ПриИзмененииРегистраБухгалтерииТрансляция() 

Процедура ОтменитьОтражениеДокумента(ИсходныйДокумент,Организация,Отказ,Трансляция=Истина) Экспорт
	
	ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(Организация);
	
	НаборЗаписей=РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИсходныйДокумент.Установить(ИсходныйДокумент);
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.Трансляция.Установить(Трансляция);
	
	НаборЗаписей.Прочитать();
	
	ОбработатьНаборЗаписейПоПериодам(НаборЗаписей,ДанныеЗакрытияПериода);
	
	ТаблицаЗаписей=ПолучитьТаблицуЗаписей(НаборЗаписей);
	
	Для Каждого ДанныеОбъекта ИЗ НаборЗаписей Цикл 
		
		Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.Сценарий) Тогда
			
			ДанныеОбъекта.Сценарий=ДанныеОбъекта.УдалитьСценарий;
			
		КонецЕсли; 
		
		Если ДанныеОбъекта.ОтраженоВСледующемПериоде Тогда
			
			Продолжить;
			
		КонецЕсли; 
		
		///////////////////////////////////////////////////////////////////
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПоследнегоОтражения) Тогда 
			
			Если ДанныеОбъекта.ДатаОтражения<=ДанныеЗакрытияПериода.ДатаЗакрытияПериода Тогда
				
				ДанныеОбъекта.ОтраженоВСледующемПериоде=Истина;
				
				НоваяСтрока=ТаблицаЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ДанныеОбъекта);
				НоваяСтрока.ДокументПервогоОтражения=ДанныеОбъекта.ДокументПоследнегоОтражения;
				НоваяСтрока.ДокументСторноПервогоОтражения=Неопределено;
				НоваяСтрока.ДокументПоследнегоОтражения=Неопределено;
								
			Иначе
				
				ОтменитьОбработкуОбъекта(ДанныеОбъекта,ИсходныйДокумент,Отказ); 
				
				Если Отказ Тогда
					
					Возврат;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
						
			ОтменитьОбработкуОбъекта(ДанныеОбъекта,ИсходныйДокумент,Отказ); 
			
		КонецЕсли;
		
		Если Отказ Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Для Каждого Строка ИЗ ТаблицаЗаписей Цикл
		
		ДанныеОбъекта=НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(ДанныеОбъекта,Строка);	
		ОтменитьОбработкуОбъекта(ДанныеОбъекта,ИсходныйДокумент,Отказ); 
		ДанныеОбъекта.ДатаОтражения=ДанныеОбъекта.ПериодОтражения.ДатаОкончания;
		
		Если Отказ Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
		
	
	НаборЗаписей.Записать(Истина);
		
КонецПроцедуры // ОтменитьТрансляциюДокумента() 

Функция ПолучитьМассивОрганизацийРегистр(ИсходныйДокумент,Трансляция=Истина) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОтражениеДокументовПоШаблонам.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	|ГДЕ
	|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент = &ИсходныйДокумент
	|	И ОтражениеДокументовПоШаблонам.Трансляция = &Трансляция";
	
    Запрос.УстановитьПараметр("ИсходныйДокумент",ИсходныйДокумент);
	Запрос.УстановитьПараметр("Трансляция",Трансляция);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");
	
КонецФункции // ПолучитьМассивОрганизацийРегистр() 

Процедура ДобавитьОбъектВОбработку(ДанныеПроведения,ДанныеТрансляции,ТаблицаЗаписей,ИсходныйДокумент,ДанныеЗакрытияПериода,ПредыдущаяТрансляция=Неопределено) Экспорт
	
	Если ДанныеТрансляции.Свойство("ДействиеВЗакрытомПериоде")
		И ДанныеПроведения.Период<ДанныеЗакрытияПериода.ДатаЗакрытияПериода 
		И ДанныеТрансляции.ДействиеВЗакрытомПериоде=Перечисления.ДействияПриИзмененииВЗакрытомПериодеМСФО.НеОтражать Тогда
		
		ТекстСообщения=ПолучитьТекстБезОтражения(ДанныеПроведения.Организация,
			ДанныеТрансляции.Сценарий,
			ДанныеТрансляции.УчетнаяПолитика,
			ИсходныйДокумент,
			ДанныеЗакрытияПериода.ДатаЗакрытияПериода); 
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Внимание,,ИсходныйДокумент);
		
		Возврат;
		
	КонецЕсли;
	
	ДанныеОбъекта=ТаблицаЗаписей.Добавить();
	ДанныеОбъекта.ИсходныйДокумент	=ИсходныйДокумент;
	ДанныеОбъекта.Организация		=ДанныеПроведения.Организация;
	ДанныеОбъекта.Сценарий			=ДанныеТрансляции.Сценарий;
	ДанныеОбъекта.УчетнаяПолитика	=ДанныеТрансляции.УчетнаяПолитика;
	ДанныеОбъекта.ШаблонОперации	=ДанныеТрансляции.ШаблонТрансляции;
	ДанныеОбъекта.СпособТрансляции	=ДанныеТрансляции.СпособТрансляции; 
		
	Если ДанныеПроведения.Свойство("ПериодОтбора") Тогда
		
		ДанныеОбъекта.ПериодОтбора		= ДанныеПроведения.ПериодОтбора;

	Иначе
		
		ДанныеОбъекта.ПериодОтбора		=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ДанныеПроведения.Период,КэшируемыеПроцедурыУХ.ПолучитьПериодичностьТрансляцииПроводок(),0);
						
	КонецЕсли;
	
	Если ДанныеПроведения.Свойство("Трансляция") Тогда
		
		ДанныеОбъекта.Трансляция		= ДанныеПроведения.Трансляция;

	Иначе
		
		ДанныеОбъекта.Трансляция=Истина;
						
	КонецЕсли;
	
	ДанныеОбъекта.ДокументПервогоОтражения = ПредыдущаяТрансляция; 
				
КонецПроцедуры // ДобавитьОбъектВОбработку()  

Процедура ОбработатьТаблицуЗаписей(НаборЗаписей,ТаблицаЗаписей,ДанныеЗакрытияПериода,Отказ) Экспорт
	
	Для Каждого Строка ИЗ ТаблицаЗаписей Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ИсходныйДокумент) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ДанныеОбъекта=НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(ДанныеОбъекта,Строка);
		
		ДанныеТрансляции=Новый Структура;
		ДанныеТрансляции.Вставить("СпособТрансляции",Строка.СпособТрансляции);
		
		ОбработатьДанныеОбъекта(ДанныеОбъекта,ДанныеТрансляции,ДанныеЗакрытияПериода,Отказ);

	КонецЦикла;
	
КонецПроцедуры // ОбработатьТаблицуЗаписей() 

Процедура ОбработатьДанныеОбъекта(ДанныеОбъекта,ДанныеТрансляции,ДанныеЗакрытияПериода,Отказ,ПроведениеОтменено=Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.Сценарий) Тогда
		
		ДанныеОбъекта.Сценарий=ДанныеОбъекта.УдалитьСценарий;
		
	КонецЕсли; 
	
	Если НЕ ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		
		Если НЕ ДанныеТрансляции.Свойство("СпособТрансляции") Тогда
			
			ДанныеТрансляции.Вставить("СпособТрансляции",Константы.СпособТрансляции.Получить());
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ИсходныйДокумент) Тогда
		
		Возврат;
		
	КонецЕсли;
			
	Если НЕ ДанныеЗакрытияПериода.Свойство("Период") Тогда
		
		Период=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.ИсходныйДокумент,"Дата");
		
	Иначе
		
		Период=ДанныеЗакрытияПериода.Период;
		
	КонецЕсли;
	
	Если ДанныеТрансляции.Свойство("ДействиеВЗакрытомПериоде") Тогда
		
		Если ДанныеЗакрытияПериода.ДатаЗакрытияПериода>Период Тогда
			
			Если ДанныеТрансляции.ДействиеВЗакрытомПериоде=Перечисления.ДействияПриИзмененииВЗакрытомПериодеМСФО.ЗапретитьИзменения Тогда
				
				ТекстСообщения=ПолучитьТекстЗапретаИзменения(ДанныеОбъекта.Организация,ДанныеОбъекта.Сценарий,ДанныеТрансляции.УчетнаяПолитика,ДанныеОбъекта.ИсходныйДокумент,ДанныеЗакрытияПериода.ДатаЗакрытияПериода);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,Отказ,,СтатусСообщения.ОченьВажное,,ДанныеОбъекта.ИсходныйДокумент);
				Возврат;
				
			ИначеЕсли ДанныеТрансляции.ДействиеВЗакрытомПериоде=Перечисления.ДействияПриИзмененииВЗакрытомПериодеМСФО.НеОтражать Тогда
				
				ТекстСообщения=ПолучитьТекстБезОтражения(ДанныеОбъекта.Организация,ДанныеОбъекта.Сценарий,ДанныеТрансляции.УчетнаяПолитика,ДанныеОбъекта.ИсходныйДокумент,ДанныеЗакрытияПериода.ДатаЗакрытияПериода);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Внимание,,ДанныеОбъекта.ИсходныйДокумент);
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеЗакрытияПериода=Неопределено Тогда
		
		ДанныеОбъекта.ПериодОтражения=ДанныеОбъекта.ПериодОтбора;
		ДанныеОбъекта.ДатаЗакрытияПериодаОтражения="";
		ДанныеОбъекта.ДатаЗаписиДоЗакрытияПериода=ТекущаяДатаСеанса();
		ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода="";
			
	ИначеЕсли ДанныеЗакрытияПериода.ДатаЗакрытияПериода<Период Тогда 
		
		ДанныеОбъекта.ПериодОтражения=ДанныеОбъекта.ПериодОтбора;
		ДанныеОбъекта.ДатаЗакрытияПериодаОтражения=ДанныеЗакрытияПериода.ДатаЗакрытияПериода;
		ДанныеОбъекта.ДатаЗаписиДоЗакрытияПериода=ТекущаяДатаСеанса();
		ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода="";
		
	Иначе
		
		ДанныеОбъекта.ПериодОтражения=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ДанныеЗакрытияПериода.ДатаЗакрытияПериода,КэшируемыеПроцедурыУХ.ПолучитьПериодичностьТрансляцииПроводок(),1);
		ДанныеОбъекта.ДатаЗакрытияПериодаОтражения=ДанныеЗакрытияПериода.ДатаЗакрытияПериода;
		ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода=ТекущаяДатаСеанса();
		
	КонецЕсли;
	
	ДанныеОбъекта.ДатаОтражения=ДанныеОбъекта.ПериодОтражения.ДатаОкончания;
	
	ДанныеОбъекта.ПроведениеОтменено=ПроведениеОтменено;
	ДанныеОбъекта.ОбработкаВыполнена=Перечисления.ДаНет.нет;
	ДанныеОбъекта.ОтражениеФоновымЗаданием=(ДанныеТрансляции.СпособТрансляции=Перечисления.СпособыТрансляции.ПоДокументамФоновоеЗадание);
	
	Если ДанныеТрансляции.СпособТрансляции=Перечисления.СпособыТрансляции.ПоДокументамПриПроведении
		И (НЕ ОтражениеПоШаблонамЗаблокировано(ДанныеОбъекта.ИсходныйДокумент)) Тогда
		
		РегистрыСведений.ОтражениеДокументовПоШаблонам.ВыполнитьОтражениеОбъекта(ДанныеОбъекта);
		
	КонецЕсли;
		
КонецПроцедуры // ОбработатьДанныеОбъекта()

Процедура ОтменитьОбработкуОбъекта(ДанныеОбъекта,ИсходныйДокумент,Отказ) Экспорт
	
	Период=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсходныйДокумент,"Дата");
	
	ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(ДанныеОбъекта.Организация);	
	ДанныеУчетнойПолитики=КорректировкиЗначенийПоказателей32.ПолучитьДанныеУчетнойПолитики(ДанныеОбъекта.Организация,ДанныеОбъекта.Сценарий,Период);
	
	Если ДанныеЗакрытияПериода.ДатаЗакрытияПериода>Период Тогда
		
		Если ДанныеУчетнойПолитики.ДействиеВЗакрытомПериоде=Перечисления.ДействияПриИзмененииВЗакрытомПериодеМСФО.ЗапретитьИзменения Тогда
			
			ТекстСообщения=ПолучитьТекстЗапретаИзменения(ДанныеОбъекта.Организация,ДанныеОбъекта.Сценарий,ДанныеУчетнойПолитики.УчетнаяПолитика,ИсходныйДокумент,ДанныеЗакрытияПериода.ДатаЗакрытияПериода);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,Отказ,,СтатусСообщения.ОченьВажное,,ИсходныйДокумент);
			
			Возврат;
			
		ИначеЕсли ДанныеУчетнойПолитики.ДействиеВЗакрытомПериоде=Перечисления.ДействияПриИзмененииВЗакрытомПериодеМСФО.НеОтражать Тогда
			
			ТекстСообщения=ПолучитьТекстБезОтражения(ДанныеОбъекта.Организация,ДанныеОбъекта.Сценарий,ДанныеУчетнойПолитики.УчетнаяПолитика,ИсходныйДокумент,ДанныеЗакрытияПериода.ДатаЗакрытияПериода);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Внимание,,ИсходныйДокумент);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
				
	ДанныеОбъекта.ПроведениеОтменено=Истина;
	ДанныеОбъекта.ОбработкаВыполнена=Перечисления.ДаНет.нет;
	
	Если ДанныеЗакрытияПериода=Неопределено Тогда
		
		ДанныеОбъекта.ПериодОтражения=ДанныеОбъекта.ПериодОтбора;
		ДанныеОбъекта.ДатаЗакрытияПериодаОтражения="";
		ДанныеОбъекта.ДатаЗаписиДоЗакрытияПериода=ТекущаяДатаСеанса();
		ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода="";
		
	ИначеЕсли ДанныеЗакрытияПериода.ДатаЗакрытияПериода<Период Тогда 
		
		ДанныеОбъекта.ПериодОтражения=ДанныеОбъекта.ПериодОтбора;
		ДанныеОбъекта.ДатаЗакрытияПериодаОтражения=ДанныеЗакрытияПериода.ДатаЗакрытияПериода;
		ДанныеОбъекта.ДатаЗаписиДоЗакрытияПериода=ТекущаяДатаСеанса();
		ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода="";
		
	Иначе
		
		ДанныеОбъекта.ПериодОтражения=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ДанныеЗакрытияПериода.ДатаЗакрытияПериода,КэшируемыеПроцедурыУХ.ПолучитьПериодичностьТрансляцииПроводок(),1);
		ДанныеОбъекта.ДатаЗакрытияПериодаОтражения=ДанныеЗакрытияПериода.ДатаЗакрытияПериода;
		ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода=ТекущаяДатаСеанса();		
		
	КонецЕсли;

	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		
		СпособТрансляции=ДанныеУчетнойПолитики.СпособТрансляции;
		
	Иначе
		
		СпособТрансляции=Константы.СпособТрансляции.Получить();
		
	КонецЕсли;
	
	Если НЕ ОтражениеПоШаблонамЗаблокировано(ДанныеОбъекта.ИсходныйДокумент) Тогда
		
		РегистрыСведений.ОтражениеДокументовПоШаблонам.ВыполнитьОтражениеОбъекта(ДанныеОбъекта); 
		
	КонецЕсли;
		
КонецПроцедуры // ОтменитьОбработкуОбъекта() 

Функция ПолучитьДанныеЗакрытияПериода(Организация,КэшДанныхЗакрытия)
	
	ДанныеЗакрытияПериода=КэшДанныхЗакрытия.Получить(Организация);
	
	Если ДанныеЗакрытияПериода=Неопределено Тогда
		
		ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(Организация);
		КэшДанныхЗакрытия.Вставить(Организация,ДанныеЗакрытияПериода);
		
	КонецЕсли;
	
	Возврат ДанныеЗакрытияПериода;
			
КонецФункции // ПолучитьДанныеЗакрытияПериода()

Функция ПолучитьЗапросДанныхКОбработке(МассивДокументов,ВключаяОбработанные)
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ОтражениеДокументовПоШаблонам.Организация КАК Организация,
	             |	ОтражениеДокументовПоШаблонам.ШаблонОперации КАК ШаблонОперации,
	             |	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент
	             |ИЗ
	             |	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |		ПО ОтражениеДокументовПоШаблонам.ИсходныйДокумент = ДокументыНеОтражаемыеПоШаблонам.Документ
	             |ГДЕ
	             |	ОтражениеДокументовПоШаблонам.ИсходныйДокумент В(&МассивДокументов)
	             |	И ЕСТЬNULL(ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО, ЛОЖЬ) = ЛОЖЬ
	             |	И ИСТИНА";
	
	Если НЕ ВключаяОбработанные Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"ИСТИНА","ОтражениеДокументовПоШаблонам.ОбработкаВыполнена=ЗНАЧЕНИЕ(Перечисление.ДаНет.Нет)");		
		
	КонецЕсли;
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивДокументов",МассивДокументов);
	
	Возврат Запрос.Выполнить().Выбрать();
		
КонецФункции // ПолучитьЗапросДанныхКОбработке() 

Процедура ОтразитьДокументыПоШаблонам() Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент
	|ИЗ
	|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	|ГДЕ
	|	ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.нет)
	|	И ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием";
	
	МассивДокументов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИсходныйДокумент");
	ОбработатьМассивДокументов(МассивДокументов,Новый Структура("ВключаяОбработанные",ЛОЖЬ));
		
КонецПроцедуры // ОтразитьДокументыПоШаблонам()

Процедура ВыполнитьПовторнуюТрансляцию() Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ДокументыДляПовторнойТрансляции.ДокументТрансляции КАК ДокументТрансляции
	|ИЗ
	|	РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокументыСводнойТрансляции.ДокументТрансляции
	|ИЗ
	|	РегистрСведений.ДокументыСводнойТрансляции КАК ДокументыСводнойТрансляции
	|ГДЕ
	|	(ДокументыСводнойТрансляции.ИзмененыИсходныеДанные
	|			ИЛИ ДокументыСводнойТрансляции.ИзмененШаблонКорректировки)";
	
	МассивДокументов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументТрансляции");
	ОбработатьМассивДокументов(МассивДокументов,Новый Структура("ОтборПроводок",Неопределено));	
	
КонецПроцедуры // ВыполнитьПовторнуюТрансляцию() 

Функция ОбработатьМассивДокументов(МассивДокументов,ПараметрыОбработки) Экспорт
	
	Если МассивДокументов.Количество()<20 Тогда
		
		Если ПараметрыОбработки.Свойство("ОтборПроводок") Тогда
			
			ОбновитьДокументыТрансляции(МассивДокументов,ПараметрыОбработки.ОтборПроводок);
			
			
		Иначе
			
			ВыполнитьОбработкуМассиваДокументов(МассивДокументов,ПараметрыОбработки.ВключаяОбработанные);
			
		КонецЕсли;
		
		Возврат Новый Структура("Статус","Выполнено");
		
	КонецЕсли;
			
	ИдентификаторФормы = Новый УникальныйИдентификатор;

	Если ПараметрыОбработки.Свойство("ОтборПроводок") Тогда
		
		ИмяПроцедуры="КорректировкиЗначенийПоказателей32.ОбновитьДокументыТрансляции";
		ПараметрПроцедуры=ПараметрыОбработки.ОтборПроводок;
		НаименованиеФоновогоЗадания=НСтр("ru = 'Обновление документов трансляции'");
		
	Иначе
		
		ИмяПроцедуры="КорректировкиЗначенийПоказателей32.ВыполнитьОбработкуМассиваДокументов";
		ПараметрПроцедуры=ПараметрыОбработки.ВключаяОбработанные;
		НаименованиеФоновогоЗадания=НСтр("ru = 'Отражение документов по шаблонам'");
		
	КонецЕсли;
			
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеФоновогоЗадания;
	
	МассивПорций    = Новый Массив;
	ПорцияОбъектов  = Новый Массив;
	СчетчикОбъектов = 0;
	
	КоличествоПотоковДлительныхОпераций = ДлительныеОперации.ДопустимоеКоличествоПотоков();
	 
	Если КоличествоПотоковДлительныхОпераций > 0 Тогда
		ЧислоОбъектовВПорции = Цел(МассивДокументов.Количество() / КоличествоПотоковДлительныхОпераций);
	Иначе
		ЧислоОбъектовВПорции = МассивДокументов.Количество();
	КонецЕсли;
		
	Для Каждого Документ Из МассивДокументов Цикл
		Если СчетчикОбъектов = ЧислоОбъектовВПорции Тогда
			МассивПорций.Добавить(ПорцияОбъектов);
			ПорцияОбъектов  = Новый Массив;
			СчетчикОбъектов = 0;
		КонецЕсли;
				
		ПорцияОбъектов.Добавить(Документ);
		
		СчетчикОбъектов = СчетчикОбъектов + 1;
	КонецЦикла;
	
	Если ПорцияОбъектов.Количество() > 0 Тогда
		МассивПорций.Добавить(ПорцияОбъектов);
	КонецЕсли;
	
	ПараметрыМетода      = Новый Соответствие;
	ВерхняяГраницаПорций = МассивПорций.ВГраница();
		
	Для ИндексПорции = 0 По ВерхняяГраницаПорций Цикл
		
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(МассивПорций[ИндексПорции]);
		МассивПараметров.Добавить(ПараметрПроцедуры);		
		ПараметрыМетода.Вставить(ИндексПорции, МассивПараметров);
		
	КонецЦикла;
		
	РезультатВыполнения = ДлительныеОперации.ВыполнитьПроцедуруВНесколькоПотоков(ИмяПроцедуры,
		ПараметрыВыполнения, ПараметрыМетода);
		
	Возврат РезультатВыполнения;
	
КонецФункции // ОбработатьМассивДокументов()

Процедура ВыполнитьОбработкуМассиваДокументов(МассивДокументов,ВключаяОбработанные) Экспорт 
	
	КэшДанныхЗакрытия=Новый Соответствие;
	
	РезультатЗапроса=ПолучитьЗапросДанныхКОбработке(МассивДокументов,ВключаяОбработанные);
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		ДанныеЗакрытияПериода=ПолучитьДанныеЗакрытияПериода(РезультатЗапроса.Организация,КэшДанныхЗакрытия);
		
		НаборЗаписей=РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИсходныйДокумент.Установить(РезультатЗапроса.ИсходныйДокумент);
		НаборЗаписей.Отбор.ШаблонОперации.Установить(РезультатЗапроса.ШаблонОперации);
		НаборЗаписей.Отбор.Организация.Установить(РезультатЗапроса.Организация);
		ТаблицаЗаписей=КорректировкиЗначенийПоказателей32.ПолучитьТаблицуЗаписей(НаборЗаписей);
		
		НаборЗаписей.Прочитать();
		
		КорректировкиЗначенийПоказателей32.ОбработатьНаборЗаписейПоПериодам(НаборЗаписей,ДанныеЗакрытияПериода);
		
		Отказ=Ложь;
		
		Для Каждого ДанныеОбъекта ИЗ НаборЗаписей Цикл
			
			Если ДанныеОбъекта.ОтраженоВСледующемПериоде Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ДанныеОбъекта.ОбработкаВыполнена=Перечисления.ДаНет.нет;
			ДанныеОбъекта.ПроведениеОтменено=Ложь;
			
			Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПоследнегоОтражения) 
				И ДанныеОбъекта.ДатаОтражения<=ДанныеЗакрытияПериода.ДатаЗакрытияПериода Тогда
				
				ДанныеОтражения=Обработки.КорректировкиЗначенийПоказателей.ПолучитьСтруктуруОтражения(ДанныеОбъекта);
				ДанныеОтражения.Вставить("СпособТрансляции",Перечисления.СпособыТрансляции.ПоДокументамПриПроведении);
				
				ДанныеОбъекта.ОтраженоВСледующемПериоде=Истина;
				КорректировкиЗначенийПоказателей32.ДобавитьОбъектВОбработку(ДанныеОтражения,ДанныеОтражения,ТаблицаЗаписей,РезультатЗапроса.ИсходныйДокумент,ДанныеЗакрытияПериода,ДанныеОбъекта.ДокументПоследнегоОтражения);
				
			Иначе		
				
				КорректировкиЗначенийПоказателей32.ОбработатьДанныеОбъекта(ДанныеОбъекта,Новый Структура("СпособТрансляции",Перечисления.СпособыТрансляции.ПоДокументамПриПроведении),ДанныеЗакрытияПериода,Отказ,ДанныеОбъекта.ПроведениеОтменено);
				
				Если Отказ Тогда
					
					Возврат;
					
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЦикла;
		
		КорректировкиЗначенийПоказателей32.ОбработатьТаблицуЗаписей(НаборЗаписей,ТаблицаЗаписей,ДанныеЗакрытияПериода,Отказ);
		НаборЗаписей.Записать(Истина); 
		
	КонецЦикла;
		
КонецПроцедуры // ВыполнитьОбработкуМассиваДокументов() 

Процедура ОбновитьДокументыТрансляции(МассивДокументов,ОтборПроводок) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	Трансляция.Ссылка КАК Ссылка,
	             |	Трансляция.ПериодОтчета КАК ПериодОтчета,
	             |	Трансляция.Сценарий КАК Сценарий,
	             |	Трансляция.Организация КАК Организация,
	             |	Трансляция.ПериодОтражения КАК ПериодОтражения,
	             |	Трансляция.ШаблонКорректировки КАК ШаблонКорректировки,
	             |	Трансляция.УчетнаяПолитика КАК УчетнаяПолитика
	             |ИЗ
	             |	Документ.Трансляция КАК Трансляция
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |		ПО Трансляция.ИсходныйДокумент = ДокументыНеОтражаемыеПоШаблонам.Документ
	             |ГДЕ
	             |	НЕ(Трансляция.ПометкаУдаления
	             |				ИЛИ Трансляция.Сторнирование)
	             |	И Трансляция.Ссылка В(&МассивДокументов)
	             |	И ЕСТЬNULL(ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО, ЛОЖЬ) = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("МассивДокументов",МассивДокументов);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		КорректировкиЗначенийПоказателей32.ОбработатьКорректировкиПоПараметрам(Перечисления.ВидыДокументовЭтапа.ДокументыТрансляции,
			Результат.ПериодОтчета,
			Результат.Сценарий,
			Результат.Организация,
			Результат.ШаблонКорректировки,
			,
			Результат.Ссылка,
			Результат.ПериодОтражения,,Результат.УчетнаяПолитика,ОтборПроводок);
	
	
	КонецЦикла;	
	
	
КонецПроцедуры // ОбновитьДокументыТрансляции()

Функция ОтражениеПоШаблонамЗаблокировано(ИсходныйДокумент) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ДокументыНеОтражаемыеПоШаблонам.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	|ГДЕ
	|	ДокументыНеОтражаемыеПоШаблонам.Документ = &ИсходныйДокумент
	|	И ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО";
	
	Запрос.УстановитьПараметр("ИсходныйДокумент",ИсходныйДокумент);
	Результат=Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции // ОтражениеПоШаблонамЗаблокировано()

Функция ОтражениеПоНСБУЗаблокировано(ИсходныйДокумент) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ДокументыНеОтражаемыеПоШаблонам.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	|ГДЕ
	|	ДокументыНеОтражаемыеПоШаблонам.Документ = &ИсходныйДокумент
	|	И ДокументыНеОтражаемыеПоШаблонам.НеОтражатьНСБУ";
	
	Запрос.УстановитьПараметр("ИсходныйДокумент",ИсходныйДокумент);
	Результат=Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции // ОтражениеПоШаблонамЗаблокировано()

Процедура ВключитьИОтразитьПоШаблонам(ИсходныйДокумент,Отказ) Экспорт 
		
	НачатьТранзакцию();
	
	НаборЗаписей=РегистрыСведений.ДокументыНеОтражаемыеПоШаблонам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ИсходныйДокумент);
	НаборЗаписей.Прочитать(); 
		
	Если НаборЗаписей.Количество()=1 Тогда
		
		Если НаборЗаписей[0].НеОтражатьНСБУ Тогда
			
			НаборЗаписей[0].НеОтражатьМСФО=Ложь;
			
		Иначе
			
			НаборЗаписей.Очистить();
			
		КонецЕсли;
		
	КонецЕсли;
			
	НаборЗаписей.Записать(Истина); 
	
	МассивДокументов=Новый Массив;
	МассивДокументов.Добавить(ИсходныйДокумент);
	КорректировкиЗначенийПоказателей32.ВыполнитьОбработкуМассиваДокументов(МассивДокументов,Истина);
	
	ДокументОбъект=ИсходныйДокумент.ПолучитьОбъект();
	Обработки.КорректировкиЗначенийПоказателей.ПроверитьОбработатьКорректировкиПоШаблонам(ДокументОбъект,Отказ);
	
	Если Отказ Тогда
		
		ОтменитьТранзакцию();
		
	Иначе
		
		ЗафиксироватьТранзакцию();
			
	КонецЕсли;		
	
КонецПроцедуры // ВключитьИОтразитьПоШаблонам() 

Процедура ВключитьОтражениеПоНСБУ(ИсходныйДокумент,Отказ) Экспорт 
		
	НачатьТранзакцию(); 
	
	НаборЗаписей=РегистрыСведений.ДокументыНеОтражаемыеПоШаблонам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ИсходныйДокумент);
	НаборЗаписей.Прочитать(); 
		
	Если НаборЗаписей.Количество()=1 Тогда
		
		Если НаборЗаписей[0].НеОтражатьМСФО Тогда
			
			НаборЗаписей[0].НеОтражатьНСБУ=Ложь;
			
		Иначе
			
			НаборЗаписей.Очистить();
			
		КонецЕсли;
		
	КонецЕсли;
			
	НаборЗаписей.Записать(Истина); 
	
	ПроводкиДокумента = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	ПроводкиДокумента.Отбор.Регистратор.Установить(ИсходныйДокумент);
	ПроводкиДокумента.Прочитать();
	ПроводкиДокумента.УстановитьАктивность(Истина);
	
	Попытка
		
		ПроводкиДокумента.Записать();
		
	Исключение
		
		Отказ=Истина;
		ОтменитьТранзакцию();
		Возврат;
		
	КонецПопытки;
		
	ЗафиксироватьТранзакцию();
						
КонецПроцедуры // ВключитьОтражениеПоНСБУ() 

Процедура ОтключитьОтражениеПоНСБУ(ИсходныйДокумент,Отказ) Экспорт
	
	НачатьТранзакцию(); 
	
	НаборЗаписей=РегистрыСведений.ДокументыНеОтражаемыеПоШаблонам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ИсходныйДокумент);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество()=1 Тогда
		
		НаборЗаписей[0].НеОтражатьНСБУ=Истина;
		
	Иначе
		
		НоваяСтрока=НаборЗаписей.Добавить();	
		НоваяСтрока.Документ=ИсходныйДокумент;
		НоваяСтрока.НеОтражатьНСБУ=Истина;
		
		МетаданныеОбъекта=НоваяСтрока.Документ.Метаданные(); 
				
		Если МетаданныеОбъекта.Реквизиты.Найти("Организация")=Неопределено Тогда 
			НоваяСтрока.ДатаДокумента=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Документ,"Дата");
		Иначе
			
			ДанныеДокумента=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСтрока.Документ,"Организация,Дата");
			НоваяСтрока.ДатаДокумента=ДанныеДокумента.Дата;
			НоваяСтрока.Организация	=ДанныеДокумента.Организация

		КонецЕсли;
		
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
	
	ПроводкиДокумента = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	ПроводкиДокумента.Отбор.Регистратор.Установить(ИсходныйДокумент);
	ПроводкиДокумента.Прочитать();
	ПроводкиДокумента.УстановитьАктивность(Ложь);
	
	Попытка
		
		ПроводкиДокумента.Записать();
		
	Исключение
		
		Отказ=Истина;
		ОтменитьТранзакцию();
		Возврат;
		
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры // ОтключитьОтражениеПоНСБУ()

Процедура ОтключитьИОтменитьОтражение(ИсходныйДокумент,Отказ) Экспорт
	
	НачатьТранзакцию();
	
	// Трансляция
	
	МассивОрганизаций=КорректировкиЗначенийПоказателей32.ПолучитьМассивОрганизацийРегистр(ИсходныйДокумент); 
	
	Для Каждого Организация ИЗ МассивОрганизаций Цикл
		
		КорректировкиЗначенийПоказателей32.ОтменитьОтражениеДокумента(ИсходныйДокумент,Организация,Отказ,Истина);
			
	КонецЦикла; 
	
	// Операции по шаблонам
	
	ДокументОбъект=ИсходныйДокумент.ПолучитьОбъект();
	Обработки.КорректировкиЗначенийПоказателей.ПроверитьОбработатьКорректировкиПоШаблонам(ДокументОбъект,Отказ,Истина);
	
	Если НЕ Отказ Тогда
		
		НаборЗаписей=РегистрыСведений.ДокументыНеОтражаемыеПоШаблонам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(ИсходныйДокумент);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество()=1 Тогда
			
			НаборЗаписей[0].НеОтражатьМСФО=Истина;
			
		Иначе
			
			НоваяСтрока=НаборЗаписей.Добавить();	
			НоваяСтрока.Документ=ИсходныйДокумент;
			НоваяСтрока.НеОтражатьМСФО=Истина;
			
			МетаданныеОбъекта=НоваяСтрока.Документ.Метаданные(); 
			
			Если МетаданныеОбъекта.Реквизиты.Найти("Организация")=Неопределено Тогда 
				НоваяСтрока.ДатаДокумента=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Документ,"Дата");
			Иначе
				
				ДанныеДокумента=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСтрока.Документ,"Организация,Дата");
				НоваяСтрока.ДатаДокумента=ДанныеДокумента.Дата;
				НоваяСтрока.Организация	=ДанныеДокумента.Организация
				
			КонецЕсли;
			
		КонецЕсли;
			
		НаборЗаписей.Записать(Истина);		
		ЗафиксироватьТранзакцию();
		
	Иначе
		
		ОтменитьТранзакцию();
		
	КонецЕсли;
		
КонецПроцедуры // ОтключитьИОтменитьОтражение()

Процедура ИзменитьОтражениеПоШаблонам(МассивДокументов,ВключитьОтражение) Экспорт 
	
	Если ВключитьОтражение Тогда
		
		ВключитьОтражениеПоШаблонам(МассивДокументов);
		
	Иначе
		
		ОтключитьОтражениеПоШаблонам(МассивДокументов);
		
	КонецЕсли;
		
КонецПроцедуры // ИзменитьОтражениеПоШаблонам() 

Процедура ВключитьОтражениеПоШаблонам(МассивДокументов)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ДокументыНеОтражаемыеПоШаблонам.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	|ГДЕ
	|	ДокументыНеОтражаемыеПоШаблонам.Документ В(&МассивДокументов)
	|	И ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО"; 
	
	Запрос.УстановитьПараметр("МассивДокументов",МассивДокументов);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ВключитьИОтразитьПоШаблонам(Результат.Документ,Ложь);
		
	КонецЦикла;
			
КонецПроцедуры // ВключитьОтражениеПоШаблонам() 

Процедура ОтключитьОтражениеПоШаблонам(МассивДокументов) 
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ДокументыНеОтражаемыеПоШаблонам.Документ КАК Документ
	             |ИЗ
	             |	РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |ГДЕ
	             |	ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО";
	
	ОбработанныеОбъекты=Запрос.Выполнить().Выгрузить();
	ОбработанныеОбъекты.Индексы.Добавить("Документ");
	
	Для Каждого Документ ИЗ МассивДокументов Цикл
		
		Если ОбработанныеОбъекты.Найти(Документ,"Документ")=Неопределено Тогда
			
			ОтключитьИОтменитьОтражение(Документ,Ложь);
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры // ОтключитьОтражениеПоШаблонам() 


Функция ОбработатьКорректировкиПоПараметрам(ВидКорректировки,
											ПериодСценария, 
											Сценарий, 
											Организация, 
											ШаблонКорректировки, 
											ДатаНачалаРасчетная,
											ДокументКорректировки=Неопределено,
											ПериодОтражения=Неопределено,
											ИсходныйДокумент=Неопределено,
											УчетнаяПолитика=Неопределено,
											ОтборПроводок=Неопределено) Экспорт
		
	ИмяОбъектаМетаданных = ?(ВидКорректировки = Перечисления.ВидыДокументовЭтапа.ДокументыТрансляции, "Трансляция", "ТрансформационнаяКорректировка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыКорректировки.Ссылка КАК ДокументКорректировки,
	|	ДокументыКорректировки.ПометкаУдаления КАК ПометкаУдаления,	
	|	ДокументыКорректировки.НеВноситьИзменения КАК НеВноситьИзменения
	|ИЗ
	|	Документ." + ИмяОбъектаМетаданных + " КАК ДокументыКорректировки
	|ГДЕ";
	
	Если ДокументКорректировки=Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст+"
		|	ДокументыКорректировки.Организация 				= &Организация
		|	И ДокументыКорректировки.ПериодОтчета 			= &ПериодОтчета
		|	И ДокументыКорректировки.Сценарий 				= &Сценарий
		|	И ДокументыКорректировки.ШаблонКорректировки 	= &ШаблонКорректировки";
		
		Запрос.УстановитьПараметр("Организация",        	Организация);
		Запрос.УстановитьПараметр("ПериодОтчета",       	ПериодСценария);
		Запрос.УстановитьПараметр("Сценарий",           	Сценарий);
		Запрос.УстановитьПараметр("ШаблонКорректировки",	ШаблонКорректировки);
		
	Иначе
		
		Запрос.Текст = Запрос.Текст+"
		|ДокументыКорректировки.Ссылка = &ДокументКорректировки";
		Запрос.УстановитьПараметр("ДокументКорректировки",ДокументКорректировки);
		
	КонецЕсли;
	
	Если НЕ ИсходныйДокумент=Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст+"
		|	И ДокументыКорректировки.ИсходныйДокумент = &ИсходныйДокумент";
		Запрос.УстановитьПараметр("ИсходныйДокумент",	ИсходныйДокумент);		
		
	КонецЕсли;
	
	Если НЕ ПериодОтражения=Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст+"
		|	И ДокументыКорректировки.ПериодОтражения = &ПериодОтражения";
		Запрос.УстановитьПараметр("ПериодОтражения",	ПериодОтражения);		
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|И (НЕ ДокументыКорректировки.Сторнирование)";
		
	ЗначениеВыполнения = Запрос.Выполнить();
	
	Если ЗначениеВыполнения.Пустой() Тогда
				
		КлючевыеРеквизиты = Новый Структура;
		КлючевыеРеквизиты.Вставить("Организация",			Организация);
		КлючевыеРеквизиты.Вставить("ПериодОтчета",			ПериодСценария);
		КлючевыеРеквизиты.Вставить("ПериодОтражения",		?(ПериодОтражения=Неопределено,ПериодСценария,ПериодОтражения));
		КлючевыеРеквизиты.Вставить("Сценарий",				Сценарий);
		КлючевыеРеквизиты.Вставить("ИсходныйДокумент",		ИсходныйДокумент);
		КлючевыеРеквизиты.Вставить("ШаблонКорректировки",	ШаблонКорректировки);
		КлючевыеРеквизиты.Вставить("Состояние",				Перечисления.СостоянияОтчетов.Запланирован);
		КлючевыеРеквизиты.Вставить("ИмяОбъектаМетаданных",	ИмяОбъектаМетаданных);
		КлючевыеРеквизиты.Вставить("РасчетДатыОтраженияВУчете",	Перечисления.СпособыРасчетаДатыОтраженияВУчете.ДатаОкончанияПериода);
		
		Если НЕ ЗначениеЗаполнено(УчетнаяПолитика) Тогда
			
			ДанныеУчетнойПолитики=ПолучитьДанныеУчетнойПолитики(Организация,КлючевыеРеквизиты.Сценарий,КлючевыеРеквизиты.ПериодОтражения.ДатаНачала);
			ОсновнаяВалюта=ДанныеУчетнойПолитики.ВалютаУчета;
			КлючевыеРеквизиты.Вставить("УчетнаяПолитика",	ДанныеУчетнойПолитики.УчетнаяПолитика);
			
		Иначе
			
			КлючевыеРеквизиты.Вставить("УчетнаяПолитика",УчетнаяПолитика);
			ОсновнаяВалюта=УчетнаяПолитика.ВалютаУчета;
			
		КонецЕсли;
						
		КлючевыеРеквизиты.Вставить("ОсновнаяВалюта", ОсновнаяВалюта);
		
		ОбработкаОбъект = Обработки.КорректировкиЗначенийПоказателей.Создать();
		ЗаполнитьЗначенияСвойств(ОбработкаОбъект, КлючевыеРеквизиты);
		ОбработкаОбъект.ОтборПроводок=ОтборПроводок;
		ОбработкаОбъект.ИнициализироватьКонтекст();
		
		Если ИмяОбъектаМетаданных = "ТрансформационнаяКорректировка" Тогда
			
			ОбработкаОбъект.ЗаполнитьПоШаблонуТрансформации();
			
		ИначеЕсли ИмяОбъектаМетаданных = "Трансляция" Тогда
			
			ОбработкаОбъект.ЗаполнитьПоШаблонуТрансляции();
			
		КонецЕсли;
		
		ОбработкаОбъект.ДанныеПараметрикиАктуальны = Ложь;
		
		ОбработкаОбъект.ДокументОбъект = Документы[ИмяОбъектаМетаданных].СоздатьДокумент();
		
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
			
			ОбработкаОбъект.ДокументОбъект.Дата=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсходныйДокумент,"Дата");
			
		Иначе
			
			ОбработкаОбъект.ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ДатаНачалаРасчетная), ДатаНачалаРасчетная, ТекущаяДата());
			
		КонецЕсли;
		
		ОбработкаОбъект.ДокументОбъект.УстановитьНовыйНомер();
		
		ЗаполнитьЗначенияСвойств(ОбработкаОбъект.ДокументОбъект, ОбработкаОбъект, , "Ссылка,Номер,Дата");
		
		Попытка
			
			ОбработкаОбъект.ЗаполнитьАвтоматически();
			ОбработкаОбъект.ЗаписатьРабочийОбъект(РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Проведение);
			
		Исключение
			
			Если ТранзакцияАктивна() Тогда
				ВызватьИсключение;
			КонецЕсли;
			
			СтрокаШаблона = НСтр("ru = 'Не удалось записать документ %1: '");
			
			Если ЗначениеЗаполнено(СтрокаШаблона) тогда
				ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(СтрокаШаблона, ОбработкаОбъект.ДокументОбъект) + ОписаниеОшибки(),,, СтатусСообщения.Важное);
			КонецЕсли;
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	Иначе
		
		Результат = ЗначениеВыполнения.Выбрать();
		
		Пока Результат.Следующий() Цикл
			
			ОбработкаОбъект=Обработки.КорректировкиЗначенийПоказателей.Создать();
			ДокументОбъект=Результат.ДокументКорректировки.ПолучитьОбъект();
			
			Если ДокументОбъект.ПометкаУдаления Тогда
				
				ДокументОбъект.УстановитьПометкуУдаления(Ложь);
				
			КонецЕсли;				
			
			ОбработкаОбъект.ОтборПроводок=ОтборПроводок;
			
			Попытка
				ДокументОбъект.Заблокировать();
				Заблокирован=Истина;
			Исключение
				
				Если ТранзакцияАктивна() Тогда
					ВызватьИсключение;
				КонецЕсли;
				
				СтрокаШаблона = НСтр("ru = 'Не удалось заблокировать объект %1: '");
				
				Если ЗначениеЗаполнено(СтрокаШаблона) тогда
					ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(СтрокаШаблона, ДокументОбъект) + ОписаниеОшибки(),,, СтатусСообщения.Важное);
				КонецЕсли;	
					
				Возврат Неопределено;
			КонецПопытки;
			
			ДокументОбъект.ПериодОтчета		= ПериодСценария;
			ДокументОбъект.ПериодОтражения	= ?(ПериодОтражения=Неопределено,ПериодСценария,ПериодОтражения); 
			
			Если ЗначениеЗаполнено(УчетнаяПолитика) Тогда
				
				ДокументОбъект.УчетнаяПолитика=УчетнаяПолитика;
				
			КонецЕсли;
			
			Если ИмяОбъектаМетаданных="ТрансформационнаяКорректировка" Тогда
				
				ЗаполнитьЗначенияСвойств(ОбработкаОбъект,ДокументОбъект);
				
			Иначе	
				
				ЗаполнитьЗначенияСвойств(ОбработкаОбъект,ДокументОбъект,,"РедактируемыеЗаписи");
				
			КонецЕсли;
			
			ОбработкаОбъект.ДанныеПараметрикиАктуальны=Ложь;			
			ОбработкаОбъект.ДокументОбъект=ДокументОбъект;
			ОбработкаОбъект.ИмяОбъектаМетаданных=ИмяОбъектаМетаданных;
			
			Попытка
				
				ОбработкаОбъект.ИнициализироватьКонтекст();	
				ОбработкаОбъект.ЗаполнитьАвтоматически();
				ОбработкаОбъект.ЗаписатьРабочийОбъект(РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись);
				
			Исключение
				
				Если ТранзакцияАктивна() Тогда
					ВызватьИсключение;
				КонецЕсли;
				
				СтрокаШаблона = НСтр("ru = 'Не удалось записать документ %1: '");
				
				Если ЗначениеЗаполнено(СтрокаШаблона) тогда
					ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(СтрокаШаблона, ОбработкаОбъект.ДокументОбъект) + ОписаниеОшибки(),,, СтатусСообщения.Важное);
				КонецЕсли;
				
				Возврат Неопределено;
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ОбработкаОбъект.Ссылка;
	
КонецФункции 

Функция ОпределитьТаблицуФинансовыхРегистров(МетаданныеДокумента=Неопределено) Экспорт
	
	МассивРегистровУчета=КэшируемыеПроцедурыУХ.МассивРегистровФинансовогоУчета();
	
	Если МассивРегистровУчета.Количество()=0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТаблицаРегистровОбъекта=Новый ТаблицаЗначений;
	ТаблицаРегистровОбъекта.Колонки.Добавить("ИмяРегистра");
	ТаблицаРегистровОбъекта.Колонки.Добавить("Обороты",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТаблицаРегистровОбъекта.Колонки.Добавить("ПараметрыОтраженияДвижений"); 
		
	Если МетаданныеДокумента=Неопределено Тогда 
		
		Для Каждого ИмяРегистра ИЗ МассивРегистровУчета Цикл
			
			НоваяСтрока=ТаблицаРегистровОбъекта.Добавить();
			НоваяСтрока.ИмяРегистра=ИмяРегистра;
			
			МетаданныеРегистра=Метаданные.РегистрыНакопления[ИмяРегистра];
			МенеджерРегистра = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеРегистра.ПолноеИмя()); // РегистрНакопленияМенеджер - 
			
			НоваяСтрока.ПараметрыОтраженияДвижений = МенеджерРегистра.ПараметрыОтраженияДвиженийВФинансовомУчете();	
			НоваяСтрока.Обороты=(МетаданныеРегистра.ВидРегистра=Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
			
		КонецЦикла;
				
	Иначе
		
		Для Каждого Движение ИЗ МетаданныеДокумента.Движения Цикл
			
			Если НЕ МассивРегистровУчета.Найти(Движение.Имя)=Неопределено Тогда
				
				НоваяСтрока=ТаблицаРегистровОбъекта.Добавить();
				НоваяСтрока.ИмяРегистра=Движение.Имя;
				НоваяСтрока.Обороты=(Движение.ВидРегистра=Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
				
				МенеджерРегистра = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("РегистрНакопления."+Движение.Имя);
				НоваяСтрока.ПараметрыОтраженияДвижений = МенеджерРегистра.ПараметрыОтраженияДвиженийВФинансовомУчете();
				
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаРегистровОбъекта;
		
КонецФункции // ОпределитьМассивФинансовыхРегистров()

Процедура ВыполнитьТрансляциюРегистровПоОбъекту(ИсходныйОбъект,ТаблицаФинансовыхРегистров,ДанныеУчетнойПолитики,Отказ) Экспорт
	
	ТаблицаКорреспонденции=ПолучитьТаблицуКорреспонденцииРегистров(,ИсходныйОбъект.Ссылка); 
	
	Если ТаблицаКорреспонденции.Количество()>0 Тогда
		
		ИсходныйДокумент=ИсходныйОбъект.Ссылка;
		Организация		=ИсходныйОбъект.Организация; 
		
		ДанныеПроведения=Новый Структура;
		ДанныеПроведения.Вставить("Регистратор",ИсходныйДокумент);
		ДанныеПроведения.Вставить("Организация",ИсходныйДокумент.Организация);
		ДанныеПроведения.Вставить("Период",ИсходныйДокумент.Дата);
		ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(ДанныеПроведения.Организация);
		
		ТаблицаДанныхТрансляции= ПолучитьТаблицаДанныхТрансляцииРегистров(Организация,ИсходныйОбъект.Дата);
		
		ТекстОшибки=ПроверитьВозможностьТрансляцииВЗакрытомПериоде(ИсходныйДокумент,ДанныеПроведения.Организация,ДанныеПроведения.Период,ДанныеЗакрытияПериода.ДатаЗакрытияПериода,ТаблицаДанныхТрансляции);
		
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,Отказ,,СтатусСообщения.ОченьВажное,,ИсходныйДокумент);
			Возврат;
			
		КонецЕсли;
		
		НаборЗаписей=РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИсходныйДокумент.Установить(ИсходныйДокумент);
		НаборЗаписей.Отбор.Трансляция.Установить(Истина);
		
		ТаблицаЗаписей=ПолучитьТаблицуЗаписей(НаборЗаписей);
		
		НаборЗаписей.Прочитать();
		
		ОбработатьНаборЗаписейПоПериодам(НаборЗаписей,ДанныеЗакрытияПериода);
		
		Если НаборЗаписей.Количество()=0 Тогда
						
			Для Каждого ДанныеТрансляции ИЗ ТаблицаДанныхТрансляции Цикл
				
				ДобавитьОбъектВОбработку(ДанныеПроведения,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеТрансляции),ТаблицаЗаписей,ИсходныйДокумент,ДанныеЗакрытияПериода);
				
			КонецЦикла;
			
		Иначе
						
			Для Каждого ДанныеОбъекта Из НаборЗаписей Цикл
				
				Если ДанныеОбъекта.ОтраженоВСледующемПериоде Тогда
					
					Продолжить;
					
				КонецЕсли;
					
				МассивДанныхТрансляции=ТаблицаДанныхТрансляции.НайтиСтроки(Новый Структура("Организация,Сценарий,ШаблонТрансляции",ДанныеОбъекта.Организация,ДанныеОбъекта.Сценарий,ДанныеОбъекта.ШаблонОперации));
				
				Если МассивДанныхТрансляции.Количество()=0 Тогда // Изменились настройки учетной политики
					
					ОтменитьОбработкуОбъекта(ДанныеОбъекта,ИсходныйДокумент,Отказ);
					
					Если Отказ Тогда
						
						Возврат;
						
					КонецЕсли;
					
				Иначе	
					
					ДанныеОбъекта.ПериодОтбора=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ДанныеПроведения.Период,КэшируемыеПроцедурыУХ.ПолучитьПериодичностьТрансляцииПроводок(),0);
					ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(ДанныеОбъекта.Организация);
					ДанныеОбъекта.УчетнаяПолитика=МассивДанныхТрансляции[0].УчетнаяПолитика;
					
					Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПоследнегоОтражения) 
						И ДанныеОбъекта.ДатаОтражения<=ДанныеЗакрытияПериода.ДатаЗакрытияПериода Тогда
						
						ДанныеОбъекта.ОтраженоВСледующемПериоде=Истина;
						ДобавитьОбъектВОбработку(ДанныеПроведения,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(МассивДанныхТрансляции[0]),ТаблицаЗаписей,ИсходныйДокумент,ДанныеЗакрытияПериода,ДанныеОбъекта.ДокументПоследнегоОтражения);
						
					Иначе		
						
						ОбработатьДанныеОбъекта(ДанныеОбъекта,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(МассивДанныхТрансляции[0]),ДанныеЗакрытияПериода,Отказ); 
						
						Если Отказ Тогда
							
							Возврат;
							
						КонецЕсли;
						
					КонецЕсли;
					
					МассивДанныхТрансляции[0].Обработано=Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
			МассивДанныхТрансляции=ТаблицаДанныхТрансляции.НайтиСтроки(Новый Структура("Обработано",Ложь));
			
			Для Каждого ДанныеТрансляции ИЗ МассивДанныхТрансляции Цикл // Изменились настройки учетной политики
					
				ДобавитьОбъектВОбработку(ДанныеПроведения,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеТрансляции),ТаблицаЗаписей,ИсходныйДокумент,ДанныеЗакрытияПериода);
				
			КонецЦикла;
			
		КонецЕсли; 
		
		ОбработатьТаблицуЗаписей(НаборЗаписей,ТаблицаЗаписей,ДанныеЗакрытияПериода,Отказ);
				
		НаборЗаписей.Записать(Истина);
				
	Иначе
						
		ИсходныйДокумент=ИсходныйОбъект.Ссылка;
		
		МассивОрганизаций=ПолучитьМассивОрганизацийРегистр(ИсходныйДокумент);
		
		Для Каждого Организация ИЗ МассивОрганизаций Цикл
			
			ОтменитьОтражениеДокумента(ИсходныйДокумент,Организация,Отказ);
			
		КонецЦикла;
				
	КонецЕсли;
		
КонецПроцедуры // ВыполнитьТрансляциюРегистровПоОбъекту() 

Функция ТрансляцияВРегистрБухгалтерии(НаправлениеТрансляции) Экспорт
	
	Возврат НаправлениеТрансляции=Перечисления.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии
		ИЛИ НаправлениеТрансляции=Перечисления.НаправленияТрансляцииДанных.ФинансовыеРегистрыВРегистрБухгалтерии;
	
КонецФункции // ТрансляцияВРегистрБухгалтерии()
	
Функция ПолучитьТекстПоляДтКт(Дт=Истина,ПараметрыОтраженияДвижений,Обороты)

	ТекстУсловия=?(Дт,ПараметрыОтраженияДвижений.УсловиеДебет,ПараметрыОтраженияДвижений.УсловиеКредит);
	
	Если НЕ ПустаяСтрока(ТекстУсловия) Тогда
		
		Возврат ТекстУсловия;
		
	ИначеЕсли Обороты Тогда
		
		Возврат "ЛОЖЬ";
		
	Иначе
		
		Если ПараметрыОтраженияДвижений.ИнверсияДвижений Тогда
			
			Возврат ?(Дт,"ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)","ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
			
		Иначе
			
			Возврат ?(Дт,"ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)","ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)");
			
		КонецЕсли;
		
	КонецЕсли;

КонецФункции // ПолучитьТекстПоляДтКт() 

Функция ПолучитьТаблицуКорреспонденцииРегистров(ПериодОтчета=Неопределено,ИсходныйДокумент=Неопределено,Организация=Неопределено) 
	
	Если Метаданные.ОбщиеМодули.Найти("МеждународныйУчетПоДаннымФинансовыхРегистров")=Неопределено Тогда
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;
	
	МодульОперативногоУчета=ОбщегоНазначения.ОбщийМодуль("МеждународныйУчетПоДаннымФинансовыхРегистров");
	
	КомпоновщикНастроек=Новый КомпоновщикНастроекКомпоновкиДанных;
		
	ПараметрыЗапроса = МодульОперативногоУчета.ПараметрыЗапросаДанныхФинансовыхРегистров();
	ПараметрыЗапроса.Вставить("КлючВарианта","АнализКорреспонденцийПоДокументам");
	ПараметрыЗапроса.Вставить("ДополнительныйОтбор", КомпоновщикНастроек.ФиксированныеНастройки.Отбор);
	ПараметрыЗапроса.Вставить("Регистратор");
	ПараметрыЗапроса.Вставить("ТипРегистратора");
  
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ПараметрыЗапроса.Вставить("Организация",Организация);
		
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
		
		ПараметрыЗапроса.Вставить("Регистратор",ИсходныйДокумент);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодОтчета) Тогда
		
		ПараметрыЗапроса.Вставить("ДатаНачала",ПериодОтчета.ДатаНачала);
		ПараметрыЗапроса.Вставить("ДатаОкончания",КонецДня(ПериодОтчета.ДатаОкончания));
		
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("ПланСчетов"); 
	ПараметрыЗапроса.Вставить("ОбъектУчетаДт");
	ПараметрыЗапроса.Вставить("ОбъектУчетаКт");
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса.Регистратор) Тогда
		
		ТипДокумента = ТипЗнч(ПараметрыЗапроса.Регистратор);
		ИмяОбработкиОтражениеВУчете="ОтражениеДокументовВМеждународномУчете";
		
		КомандаДокументыОперативногоУчета = Метаданные.Обработки[ИмяОбработкиОтражениеВУчете].Команды.ПроводкиДокументаОперативногоУчета; 
		Если НЕ КомандаДокументыОперативногоУчета.ТипПараметраКоманды.СодержитТип(ТипДокумента) Тогда
			Возврат Новый ТаблицаЗначений;	
		КонецЕсли;
		
	КонецЕсли;
		
	ТаблицаКорреспонденцииОбщ=МодульОперативногоУчета.ЗапросАнализаКорреспонденцийОперативногоУчета(ПараметрыЗапроса).Выполнить().Выгрузить();
		
	Запрос=Новый Запрос;
	ТекстЗапроса="Выбрать * Поместить ТаблицаКорреспонденцииОбщ ИЗ &ТаблицаКорреспонденцииОбщ КАК ТаблицаКорреспонденцииОбщ
	|;
	|ВЫБРАТЬ * ИЗ ТаблицаКорреспонденцииОбщ ГДЕ (НЕ (ОбъектУчетаДт=&ТекстПараметр ИЛИ ОбъектУчетаКт=&ТекстПараметр))";
	
	Запрос.Текст=СтрЗаменить(ТекстЗапроса,"&ТекстПараметр","Значение(ПланВидовХарактеристик.СтатьиАктивовПассивов.ПустаяСсылка)");
	Запрос.УстановитьПараметр("ТаблицаКорреспонденцииОбщ",ТаблицаКорреспонденцииОбщ);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьТаблицуКорреспонденцииРегистров()

Процедура ТранслироватьДанныеРегистров(ДанныеОбъекта) Экспорт
	
	ТаблицаКорреспонденцииОбщая=ПолучитьТаблицуКорреспонденцииРегистров(ДанныеОбъекта.ПериодОтчета,ДанныеОбъекта.ИсходныйДокумент,ДанныеОбъекта.Организация);	
	ТаблицаКорреспонденцииОбщая.Свернуть("ОбъектУчетаДт,ОбъектУчетаКт,ИмяРегистраДт,ИмяРегистраКт,Регистратор,ИдентификаторФинЗаписи");
	
	ТаблицаКорреспонденции=ТаблицаКорреспонденцииОбщая.Скопировать();
	ТаблицаКорреспонденции.Свернуть("ОбъектУчетаДт,ОбъектУчетаКт,ИмяРегистраДт,ИмяРегистраКт");
	
	ЗапросДанные=Новый Запрос;
	ЗапросДанные.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
	ЗапросДанные.Текст="ВЫБРАТЬ
	                   |	ТаблицаКорреспонденцииОбщая.ОбъектУчетаДт КАК ОбъектУчетаДт,
	                   |	ТаблицаКорреспонденцииОбщая.ОбъектУчетаКт КАК ОбъектУчетаКт,
	                   |	ТаблицаКорреспонденцииОбщая.ИмяРегистраДт КАК ИмяРегистраДт,
