#Область Менеджер

Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	МетаданныеДокумента = Метаданные.Документы.ОжидаемоеПоступлениеДенежныхСредств;
	
	Если ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
		
		КомандаСоздатьНаОсновании						= КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер				= МетаданныеДокумента.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление			= ОбщегоНазначения.ПредставлениеОбъекта(МетаданныеДокумента);
		КомандаСоздатьНаОсновании.РежимЗаписи			= "Проводить";
		
	КонецЕсли;
			
КонецПроцедуры

#Область ИсточникиДляКонтроляДокумента

Процедура ОбработкаЗаполненияЗаказКлиентаУХОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ТипДанныхЗаполнения <> 
						Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда 
		Возврат;				
	КонецЕсли;         
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Контрагент");
	СтруктураРеквизитов.Вставить("Партнер");
	СтруктураРеквизитов.Вставить("Организация");   
	СтруктураРеквизитов.Вставить("Подразделение");   
	СтруктураРеквизитов.Вставить("НаправлениеДеятельности");
	СтруктураРеквизитов.Вставить("ВалютаВзаиморасчетов");
	СтруктураРеквизитов.Вставить("ЦенаВключаетНДС", "ВерсияСоглашения.ЦенаВключаетНДС"); 
	СтруктураРеквизитов.Вставить("ГруппаФинансовогоУчета", "ВерсияСоглашения.ГруппаФинансовогоУчета");
	
    РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, СтруктураРеквизитов);

	Источник.Договор 			= ДанныеЗаполнения;
	Источник.Контрагент 		= РеквизитыДоговора.Контрагент;   
	Источник.Партнер 			= РеквизитыДоговора.Партнер;
	Источник.Организация 		= РеквизитыДоговора.Организация;
	Источник.Подразделение 		= РеквизитыДоговора.Подразделение;
	Источник.Валюта 			= РеквизитыДоговора.ВалютаВзаиморасчетов;
	Источник.ЦенаВключаетНДС 	= РеквизитыДоговора.ЦенаВключаетНДС;  
	Источник.НаправлениеДеятельности 	= РеквизитыДоговора.НаправлениеДеятельности;  
	Источник.ГруппаФинансовогоУчета 	= РеквизитыДоговора.ГруппаФинансовогоУчета;  

	АналитикиПланированияДокументов.ЗаполнитьАналитикиПланированияПоДоговору(ДанныеЗаполнения, Источник);

КонецПроцедуры

