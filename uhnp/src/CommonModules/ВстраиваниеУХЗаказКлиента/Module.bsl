Процедура ДобавитьИЗаполнитьРеквизитФормыДоговорОснование(Форма, Основание) Экспорт    
	
	ДобавляемыеРеквизиты = Новый Массив();
	ФормыУХ.СоздатьДобавитьРеквизитФормы(
		Форма,
		ДобавляемыеРеквизиты,
		"ДоговорОснование",
		"СправочникСсылка.ДоговорыКонтрагентов");
	Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;   
	
	Форма["ДоговорОснование"] = Основание; 
		
КонецПроцедуры

#КонецОбласти

