		ИЛИ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Аукцион")
		ИЛИ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросКотировок")
		ИЛИ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.КонкурентныеПереговоры")
		Тогда
		ОбъектСпособ.Конкурентный = Истина;  
	ИначеЕсли ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗакупкаУЕдинственногоПоставщика") Тогда
		ОбъектСпособ.Конкурентный = Ложь;  
	ИначеЕсли ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросПредложенийУМсп")
		ИЛИ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросКотировокУМсп")
		ИЛИ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.КонкурсУМсп")
		ИЛИ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.АукционУМсп")
		Тогда
		ОбъектСпособ.МСП = Истина;
		ОбъектСпособ.Конкурентный = Истина;
	КонецЕсли;        
	Если ОбъектСпособ.ЭлектроннаяФорма И НЕ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросПредложенийУМсп")
		И НЕ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросКотировокУМсп")
		И НЕ  ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.КонкурсУМсп")
		И НЕ ОбъектСпособ.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.АукционУМсп")
 	Тогда
		ОбъектСпособ.Наименование = СокрЛП(ОбъектСпособ.СпособыВыбораПоставщика) + " электронный";             
	Иначе
		ОбъектСпособ.Наименование = СокрЛП(ОбъектСпособ.СпособыВыбораПоставщика) ;             
	КонецЕсли;
	
	ОбъектСпособ.НаименованиеЕИС = ОбъектСпособ.СпособыВыбораПоставщика;
	
КонецПроцедуры

Функция НайтиКатегориюЗакупок(ТоварнаяКатегория) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КатегорииЗакупокТоварныхКатегорий.КатегорияЗакупки КАК КатегорияЗакупки
	               |ИЗ
	               |	РегистрСведений.КатегорииЗакупокТоварныхКатегорий КАК КатегорииЗакупокТоварныхКатегорий
	               |ГДЕ
	               |	КатегорииЗакупокТоварныхКатегорий.ТоварнаяКатегория = &ТоварнаяКатегория";
	Запрос.УстановитьПараметр("ТоварнаяКатегория",ТоварнаяКатегория);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.КатегорияЗакупки;
	КонецЦикла;
	Возврат Неопределено;
	
	
КонецФункции

Процедура ЗаменаТоварныхКатегорийДокументовЗакупки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокаПланаЗакупокНоменклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СтрокаПланаЗакупок.Номенклатура КАК СтрокаПланаЗакупокНоменклатура
	|ГДЕ
	|	(ТИПЗНАЧЕНИЯ(СтрокаПланаЗакупокНоменклатура.Номенклатура) = ТИП(справочник.ТоварныеКатегории)
	|			ИЛИ ТИПЗНАЧЕНИЯ(СтрокаПланаЗакупокНоменклатура.Ссылка.ТоварнаяКатегория) = ТИП(справочник.ТоварныеКатегории)
	|				И СтрокаПланаЗакупокНоменклатура.Ссылка.ТоварнаяКатегория <> ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка))"; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаПлана = Выборка.Ссылка.ПолучитьОбъект();
		Если ТипЗНЧ(СтрокаПлана.ТоварнаяКатегория) = Тип("СправочникСсылка.ТоварныеКатегории") И
			ЗначениеЗаполнено(СтрокаПлана.ТоварнаяКатегория) Тогда
			КатегорияЗакупок = НайтиКатегориюЗакупок(СтрокаПлана.ТоварнаяКатегория);
			Если КатегорияЗакупок <> Неопределено Тогда     
				СтрокаПлана.ТоварнаяКатегория = КатегорияЗакупок;
			КонецЕсли;	
		КонецЕсли;
		
		Для Каждого СтрокаНоменклатуры ИЗ СтрокаПлана.Номенклатура Цикл
			Если ТипЗНЧ(СтрокаНоменклатуры.Номенклатура) = Тип("СправочникСсылка.ТоварныеКатегории") И
				ЗначениеЗаполнено(СтрокаНоменклатуры.Номенклатура) Тогда 
				КатегорияЗакупок = НайтиКатегориюЗакупок(СтрокаНоменклатуры.Номенклатура);
				Если КатегорияЗакупок <> Неопределено Тогда
					СтрокаНоменклатуры.Номенклатура = КатегорияЗакупок;	
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	  
		
		Попытка
			СтрокаПлана.ОбменДанными.Загрузка=Истина;
			
			СтрокаПлана.Записать(РежимЗаписиДокумента.Запись);
			Сообщить(СтрокаПлана);  
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить версию строки плана закупок %1'"),СтрокаПлана.Номер);
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.СтрокаПланаЗакупок,
			, 
			ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;	
	
	//
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Лоты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лоты.Номенклатура КАК Лоты
	|ГДЕ
	|	(ТИПЗНАЧЕНИЯ(Лоты.Номенклатура) = ТИП(справочник.ТоварныеКатегории)
	|			ИЛИ (ТИПЗНАЧЕНИЯ(Лоты.Ссылка.ТоварнаяКатегория) = ТИП(справочник.ТоварныеКатегории))
	|	И  Лоты.Ссылка.ТоварнаяКатегория <> ЗНачение(Справочник.ТоварныеКатегории.ПустаяСсылка))"; 
	
	
	Выборка = Запрос.Выполнить().Выбрать();
