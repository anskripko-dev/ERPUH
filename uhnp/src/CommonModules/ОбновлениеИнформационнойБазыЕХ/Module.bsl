	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ВерсияОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		
		Для каждого СтрокаГрафика Из  ВерсияОбъект.ГрафикРасчетов Цикл

			Если СтрокаГрафика.СтатьяБюджета = Неопределено
					И ЗначениеЗаполнено(СтрокаГрафика.ВидБюджета) Тогда
					
				СтрокаГрафика.СтатьяБюджета = СоответствиеСтатей[СтрокаГрафика.ВидБюджета];		
			
			КонецЕсли;
			
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВерсияОбъект);

	КонецЦикла;

