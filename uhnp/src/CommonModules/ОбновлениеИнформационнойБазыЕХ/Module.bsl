Процедура СоздатьСправочникСпособыВыбораПоставщикаНаСервере() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Перечисление.Ссылка КАК Ссылка
	               |ИЗ
	               |	Перечисление.СпособыВыбораПоставщика КАК Перечисление
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыВыбораПоставщика КАК СпособВыбораПоставщика
	               |		ПО (СпособВыбораПоставщика.СпособыВыбораПоставщика = Перечисление.Ссылка)
	               |ГДЕ
	               |	СпособВыбораПоставщика.Ссылка ЕСТЬ NULL
	               |	И Перечисление.Ссылка <> ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.УдалитьКонкурсУМсп)
	               |	И Перечисление.Ссылка <> ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.УдалитьАукционУМсп)
	               |	И Перечисление.Ссылка <> ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.УдалитьЗапросКотировокУМсп)
	               |	И Перечисление.Ссылка <> ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.УдалитьЗапросПредложенийУМсп)
				   |	И Перечисление.Ссылка <> ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.Редукцион)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл    
		Если Выборка.Ссылка = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Конкурс") Тогда
			
			
			Способ = Справочники.СпособыВыбораПоставщика.СоздатьЭлемент();
			Способ.СпособыВыбораПоставщика = Выборка.Ссылка;   
			Способ.ШаблонМероприятий = Справочники.ШаблоныМероприятий.ЗакупочнаяПроцедура_Конкурс;
			СпособыВыбораПоставщикаПриИзмененииНаСервере(Способ,Ложь); 
			Способ.ОбменДанными.Загрузка=Истина;  
			Способ.ТиповойСпособ = Истина;
			Попытка
				
				Способ.Записать();
				
			Исключение
				ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось записать способ выбора поставщика %1'"), 
				Способ.Наименование);
				ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.СтрокаПланаЗакупок,
				, 
				ТекстСообщения);
				
			КонецПопытки;   

			Способ = Справочники.СпособыВыбораПоставщика.СоздатьЭлемент();
			Способ.СпособыВыбораПоставщика = Выборка.Ссылка;   
			Способ.ШаблонМероприятий = Справочники.ШаблоныМероприятий.ЗакупочнаяПроцедура_Конкурс;
			СпособыВыбораПоставщикаПриИзмененииНаСервере(Способ,Истина); 
			Способ.ОбменДанными.Загрузка=Истина;  
			Способ.ТиповойСпособ = Истина;
			Попытка
				
				Способ.Записать();
				
			Исключение
				ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось записать способ выбора поставщика %1'"), 
				Способ.Наименование);
				ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.СтрокаПланаЗакупок,
				, 
				ТекстСообщения);
				
			КонецПопытки;
			
		ИначеЕсли Выборка.Ссылка = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗакупкаУЕдинственногоПоставщика") Тогда
			
			Способ = Справочники.СпособыВыбораПоставщика.СоздатьЭлемент();
			Способ.ШаблонМероприятий = Справочники.ШаблоныМероприятий.ЗакупочнаяПроцедура_ЗакупкаУЕдинственногоПоставщика;
			Способ.СпособыВыбораПоставщика = Выборка.Ссылка;
			СпособыВыбораПоставщикаПриИзмененииНаСервере(Способ,Ложь); 
			Способ.ОбменДанными.Загрузка=Истина;  
			Способ.ТиповойСпособ = Истина;
			Попытка
				
				Способ.Записать();
				
			Исключение
				ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось записать способ выбора поставщика %1'"), 
				Способ.Наименование);
				ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.СтрокаПланаЗакупок,
				, 
				ТекстСообщения);
				
