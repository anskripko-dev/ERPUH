		Попытка
			Лоты = Документы.Лот.СоздатьДокумент();
			Лоты.ЗакупочнаяПроцедура = ВыборкаЛотов.Лот.Владелец;  
			ЗаполнитьЗначенияСвойств(Лоты,ВыборкаЛотов.лот,,"Номенклатура");             
			Лоты.Дата = ВыборкаЛотов.Лот.СтрокаПланаЗакупок.Дата + 1;  
			Лоты.СтрокаПланаЗакупок =  ВыборкаЛотов.Лот.СтрокаПланаЗакупок; 
			ВыборкаСтрокНоменклатуры = ВыборкаЛотов.Выбрать(); 
			Пока ВыборкаСтрокНоменклатуры.Следующий() Цикл
				СтрокаНоменклатуры = Лоты.Номенклатура.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНоменклатуры,ВыборкаСтрокНоменклатуры);
				СтрокаНоменклатуры.ДатаПоставки = ВыборкаСтрокНоменклатуры.ПериодПотребности.ДатаНачала;   
			КонецЦикла;
			Лоты.Записать(РежимЗаписиДокумента.Проведение);  

		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить версию лота закупок %1'"),Лоты.Номер);
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.Лот,
			, 
			ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла; 
	Если СквозноеПланирование Тогда
		Константы.СквозноеПланированиеПотребности.Установить(Истина);	
	КонецЕсли;
	
КонецПроцедуры


Процедура ПроставитьЗначениеЛотовДоговоров() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланированиеПотребностей.АналитикаПланирования.ОбъектПланирования.Объект КАК Лот
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(ПланированиеПотребностей.АналитикаПланирования.ОбъектПланирования.Объект) = ТИП(Документ.Лот)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПланированиеПотребностей.АналитикаПланирования.ОбъектПланирования.Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка КАК Ссылка,
	               |	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Лот КАК Лот,
	               |	ВТ.Лот КАК ДокументЛот
	               |ИЗ
	               |	Документ.ВерсияСоглашенияКоммерческийДоговор.Номенклатура КАК ВерсияСоглашенияКоммерческийДоговорНоменклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	               |		ПО ВерсияСоглашенияКоммерческийДоговорНоменклатура.Лот.СтрокаПланаЗакупок = ВТ.Лот.СтрокаПланаЗакупок
	               |		Левое СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	               |		ПО ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка = ПланированиеПотребностей.Регистратор
	               |    ГДЕ ПланированиеПотребностей.Регистратор IS NULL
	               |СГРУППИРОВАТЬ ПО
	               |	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка,
	               |	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Лот,
	               |	ВТ.Лот";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Каждого Выборка ИЗ РезультатЗапроса Цикл   
		Попытка
			
			ВерсияСоглашения = Выборка.Ссылка.ПолучитьОбъект();
			Для Каждого Строка ИЗ ВерсияСоглашения.Номенклатура Цикл
				Отбор = Новый Структура();			                      
				Отбор.Вставить("Лот",Строка.Лот);
				СтрокиЛота = РезультатЗапроса.НайтиСтроки(Отбор);
				Для Каждого СтрокаЛот ИЗ СтрокиЛота Цикл
					Строка.Лот = СтрокаЛот.ДокументЛот;
				КонецЦикла;	 
			КонецЦикла;              
			ВерсияСоглашения.ОбменДанными.Загрузка = Истина;
			ВерсияСоглашения.Записать(РежимЗаписиДокумента.Запись);  
		Исключение 
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить версию договора %1'"),ВерсияСоглашения.Номер);
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ВерсияСоглашенияКоммерческийДоговор,
			, 
			ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;		
	
КонецПроцедуры 

Процедура ПроставитьЗначениеЛотовПредложений() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	               |	ПредложениеПоставщика.Ссылка КАК ПредложениеПоставщика,
	               |	ПредложениеПоставщика.УдалитьЛот КАК УдалитьЛот
	               |ИЗ
	               |	Документ.ПредложениеПоставщика КАК ПредложениеПоставщика
	               |ГДЕ
	               |	ПредложениеПоставщика.УдалитьЛот <> ЗНАЧЕНИЕ(Справочник.Лоты.ПустаяСсылка)
	               |	И ЕстьNull(ПредложениеПоставщика.Лот,Неопределено) = Неопределено";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Предложение = Выборка.ПредложениеПоставщика.ПолучитьОбъект();
		Предложение.Лот = Выборка.УдалитьЛот;
		Предложение.ОбменДанными.Загрузка = Истина;
		Попытка
		Предложение.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ШаблонСообщения = НСтр(
				"ru = 'Не удалось записать лот в предложении поставщика %1'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения,
				Предложение,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ПредложениеПоставщика,
				Предложение.Номер, 
				ТекстСообщения);
		КонецПопытки;			
		
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерезаполнитьПротоколВыбораПобедителей()  Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Ссылка КАК ПротоколВыбораПобедителей,
	|	Лоты.Ссылка КАК СправочникЛот,
	|	ДокументЛот.Ссылка КАК ДокументЛот
	|ИЗ
	|	Справочник.Лоты КАК Лоты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПротоколВыбораПобедителей.ПредложенияПобедителей КАК ПротоколВыбораПобедителейРаспределениеПоПотребностям
	|		ПО Лоты.Ссылка = ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей.Обороты(, , Регистратор, ) КАК ПланированиеПотребностей
	|		ПО Лоты.СтрокаПланаЗакупок = ПланированиеПотребностей.Регистратор
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лот КАК ДокументЛот
	|		ПО Лоты.СтрокаПланаЗакупок = ДокументЛот.СтрокаПланаЗакупок 
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей1
	|		ПО ПротоколВыбораПобедителейРаспределениеПоПотребностям.Ссылка = ПланированиеПотребностей1.Регистратор
	
	|ГДЕ
	|	НЕ Лоты.ПометкаУдаления
	|	И Лоты.СтрокаПланаЗакупок <> ЗНАЧЕНИЕ(Документ.СтрокаПланаЗакупок.ПустаяСсылка)
	|	И НЕ Лоты.Владелец.ПометкаУдаления
	|	И ПротоколВыбораПобедителейРаспределениеПоПотребностям.Ссылка.Проведен
    |   И ПланированиеПотребностей1.Регистратор IS Null
	|СГРУППИРОВАТЬ ПО
	|	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Ссылка,
	|	Лоты.Ссылка,
	|	ДокументЛот.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПротоколВыбораПобедителей";
	Выборка = Запрос.Выполнить().Выгрузить();
	Для Каждого Протокол ИЗ Выборка Цикл   
		Попытка
			
			ПротоколВыбора = Протокол.ПротоколВыбораПобедителей.ПолучитьОбъект();
			Для Каждого Номенклатура ИЗ ПротоколВыбора.РаспределениеПоПотребностям Цикл
				Если Протокол.СправочникЛот = Номенклатура.Лот Тогда
					Номенклатура.Лот = Протокол.ДокументЛот;
				КонецЕсли;	
			КонецЦикла;
			
			Для Каждого ПредложенияПобедителей ИЗ ПротоколВыбора.ПредложенияПобедителей Цикл
				Если Протокол.СправочникЛот = ПредложенияПобедителей.Лот Тогда
					ПредложенияПобедителей.Лот = Протокол.ДокументЛот;
				КонецЕсли;	
			КонецЦикла;
			
			ПротоколВыбора.ОбменДанными.Загрузка=Истина;
			ПротоколВыбора.Записать(РежимЗаписиДокумента.Запись);  
			ПротоколВыбора = Протокол.ПротоколВыбораПобедителей.ПолучитьОбъект();
			ПротоколВыбора.ОбменДанными.Загрузка=Истина;
			
			
			ДополнительныеСвойства = Новый Структура;
			ДополнительныеСвойства.Вставить("ТаблицыДляДвижений",Новый Структура());
			
			Документы.ПротоколВыбораПобедителей.ИнициализироватьДанныеДокумента(ПротоколВыбора.Ссылка, ДополнительныеСвойства);
			ПротоколВыбора.Движения.ПланированиеПотребностей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПланированиеПотребностей);
			ПротоколВыбора.Движения.ПланированиеПотребностей.Записать();	
			ПротоколВыбора.Записать(РежимЗаписиДокумента.Запись);
			
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить протокол выбора %1'"),ПротоколВыбора.Номер);
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ПротоколВыбораПобедителей,
			, 
			ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;	
КонецПроцедуры

