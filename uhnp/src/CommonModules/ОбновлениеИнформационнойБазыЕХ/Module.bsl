	Исключение
		ОтменитьТранзакцию();       
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("ОбновлениеИнформационнойБазыУХ.ОбновитьИспользованиеСПЗ", 
								УровеньЖурналаРегистрации.Ошибка, 
								Метаданные.Справочники.Организации,,
