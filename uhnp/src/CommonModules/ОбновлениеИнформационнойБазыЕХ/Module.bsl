		СтрокаПланаЗакупок = Выборка.СтрокаПланаЗакупок.ПолучитьОбъект();
		Для Каждого СтрокаНоменклатуры ИЗ  СтрокаПланаЗакупок.Номенклатура Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.ПериодПотребности) ИЛИ НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.Сумма) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаНоменклатуры.ДатаПоставки = СтрокаНоменклатуры.ПериодПотребности.ДатаНачала;
			
		КонецЦикла;	     
		СтрокаПланаЗакупок.ОбменДанными.Загрузка=Истина;
			
		СтрокаПланаЗакупок.Записать(РежимЗаписиДокумента.Запись);
			
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить версию строки плана закупок %1'"),СтрокаПланаЗакупок.Номер);
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.СтрокаПланаЗакупок,
				, 
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРегистрСведенийИсторияСогласованияОбъектов() Экспорт
	
	НаборЗаписей = РегистрыСведений.ИсторияСогласованияОбъектов.СоздатьНаборЗаписей();
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		Возврат;
	КонецПопытки;
	
	ЗапросПоИстории = Новый Запрос("ВЫБРАТЬ
	|	ИсторияВыполненияПроцессов.Период КАК Период,
	|	ИсторияВыполненияПроцессов.ДокументПроцесса КАК ДокументПроцесса,
	|	ИсторияВыполненияПроцессов.ДокументПроцесса.КлючевойОбъектПроцесса КАК ОбъектСогласования,
	|	ИсторияВыполненияПроцессов.ЭтапПроцесса КАК ЭтапПроцесса,
	|	ИсторияВыполненияПроцессов.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	ИсторияВыполненияПроцессов.Пользователь КАК Пользователь,
	|	ИсторияВыполненияПроцессов.Событие КАК Событие,
	|	ИсторияВыполненияПроцессов.Комментарий КАК Комментарий,
	|	ИсторияВыполненияПроцессов.КомментарийСистемы КАК КомментарийСистемы,
	|	ИсторияВыполненияПроцессов.ПериодСортировкиМс КАК ПериодСортировкиМс
	|ИЗ
	|	РегистрСведений.ИсторияВыполненияПроцессов КАК ИсторияВыполненияПроцессов
	|ГДЕ
	|	ИсторияВыполненияПроцессов.ДокументПроцесса.КлючевойОбъектПроцесса <> НЕОПРЕДЕЛЕНО
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период");
	
	ВыборкаПоИстории = ЗапросПоИстории.Выполнить().Выбрать();
	
	Пока ВыборкаПоИстории.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(ВыборкаПоИстории.ОбъектСогласования) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрНайти(ВыборкаПоИстории.ОбъектСогласования, "<Объект не найден>") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Метаданные.ОпределяемыеТипы.ОбъектыДляСогласования.Тип.СодержитТип(ТипЗнч(ВыборкаПоИстории.ОбъектСогласования)) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись = РегистрыСведений.ИсторияСогласованияОбъектов.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = ВыборкаПоИстории.Период;
		НоваяЗапись.ОбъектСогласования = ВыборкаПоИстории.ОбъектСогласования;
		НоваяЗапись.ДатаНачалаСогласования = ВыборкаПоИстории.ДокументПроцесса.Дата;
		НоваяЗапись.ЭтапПроцесса = ВыборкаПоИстории.ЭтапПроцесса;
		НоваяЗапись.ИдентификаторСообщения = ВыборкаПоИстории.ИдентификаторСообщения;
		НоваяЗапись.Прочитать();
		
		Если Не НоваяЗапись.Выбран() Тогда
			
			//Измерения
			НоваяЗапись.Период = ВыборкаПоИстории.Период;
			НоваяЗапись.ОбъектСогласования = ВыборкаПоИстории.ОбъектСогласования;
			НоваяЗапись.ДатаНачалаСогласования = ВыборкаПоИстории.ДокументПроцесса.Дата;
			НоваяЗапись.ЭтапПроцесса = ВыборкаПоИстории.ЭтапПроцесса;
			НоваяЗапись.ИдентификаторСообщения = ВыборкаПоИстории.ИдентификаторСообщения;
			
			//Ресурсы
			НоваяЗапись.Пользователь = ВыборкаПоИстории.Пользователь;
			НоваяЗапись.Событие = ВыборкаПоИстории.Событие;
			НоваяЗапись.Комментарий = ВыборкаПоИстории.Комментарий;
			НоваяЗапись.КомментарийСистемы = ВыборкаПоИстории.КомментарийСистемы;
			
			//Реквизиты
			НоваяЗапись.ПериодСортировкиМс = ВыборкаПоИстории.ПериодСортировкиМс;
			
			Попытка
				НоваяЗапись.Записать();
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке(); 
				ШаблонСообщения = НСтр("ru = 'Ошибка при заполнении регистра сведений ""ИсторияСогласованияОбъектов"", по причине:
				|%1'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				ЗаписьЖурналаРегистрации(
					ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.РегистрыСведений.ИсторияСогласованияОбъектов,
					, 
					ТекстСообщения);
					
				Возврат;
			КонецПопытки;
				
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры 

Процедура ОбновитьДанныеДляКонтроляНСИ(Параметры=Неопределено) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СоответствиеВнешнимИБ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		СправочникОбъект=Результат.Ссылка.ПолучитьОбъект();
		СправочникОбъект.ОпределитьТаблицыАналитик();
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		
	КонецЦикла;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБД.Ссылка КАК Ссылка
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		СправочникОбъект=Результат.Ссылка.ПолучитьОбъект();
		
		СправочникОбъект.ВидКонтроляНСИ=?(СправочникОбъект.Контролируемый,Перечисления.ВидыКонтроляНСИ.ИзмененияПоЗаявкам,Перечисления.ВидыКонтроляНСИ.НеКонтролировать);
		СправочникОбъект.ПоставщикПотребительНСИ=?(СправочникОбъект.ЦентрализованныйКлассификатор,Перечисления.ПоставщикПотребительНСИ.Поставщик,Перечисления.ПоставщикПотребительНСИ.ПоставщикПотребитель);

		
		СправочникОбъект.ТипКонтроляНСИ=Справочники.СправочникиБД.ПолучитьТипКонтроляНСИ(СправочникОбъект.ВидКонтроляНСИ,СправочникОбъект.ПоставщикПотребительНСИ);
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		
	КонецЦикла;	
	
	ТекущийТипБД=Справочники.ТипыБазДанных.ТекущаяИБ.ПолучитьОбъект();
	ТекущийТипБД.ВерсияПлатформы=Перечисления.ПлатформыВнешнихИнформационныхБаз.Предприятие83;
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекущийТипБД);
	
	ТекущаяБД=Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ.ПолучитьОбъект();
	ТекущаяБД.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ;
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекущаяБД);
	
КонецПроцедуры // ОбновитьДанныеДляКонтроляНСИ()

Процедура ЗаполнениеПредопределенныхДанныхМСФО_ПереходНа32(Параметры=Неопределено) Экспорт
	
	Параметры = Новый Структура("ОбъектыСНачальнымЗаполнением", Новый Массив);
	ОбновлениеИнформационнойБазыБМ.ПриОпределенииНастроек(Параметры); // получим МД
	
	ДопПараметры = Новый Структура("НовыеОбъекты", Новый Массив); // формат БСП
