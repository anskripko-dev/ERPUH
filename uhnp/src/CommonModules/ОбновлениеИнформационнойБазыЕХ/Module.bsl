		ДопПараметры.НовыеОбъекты.Добавить(Источник.ПолноеИмя());
	КонецЦикла;
	
	ОбновлениеИнформационнойБазыСлужебный.НачальноеЗаполнениеПредопределенныхДанных(
		Ложь, ДопПараметры);
	
КонецПроцедуры

