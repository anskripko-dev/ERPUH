	|		ПО ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка = ПланированиеПотребностей.Регистратор
	|ГДЕ
	|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка.Проведен
    |	И ПланированиеПотребностей.Регистратор ЕСТЬ NULL
	|СГРУППИРОВАТЬ ПО
	|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл	

		Попытка               
			ВерсияСоглашенияКоммерческийДоговор = Выборка.ВерсияСоглашенияКоммерческийДоговор.ПолучитьОбъект();
			ВерсияСоглашенияКоммерческийДоговор.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок");
			ВерсияСоглашенияКоммерческийДоговор.ОбменДанными.Загрузка = Истина;
			ВерсияСоглашенияКоммерческийДоговор.Записать(РежимЗаписиДокумента.Запись);  
			ДополнительныеСвойства = Новый Структура;
			ДополнительныеСвойства.Вставить("ТаблицыДляДвижений",Новый Структура());
			Документы.ВерсияСоглашенияКоммерческийДоговор.ИнициализироватьДанныеДокумента(ВерсияСоглашенияКоммерческийДоговор.Ссылка, ДополнительныеСвойства);
			ВерсияСоглашенияКоммерческийДоговор.Движения.ПланированиеПотребностей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПланированиеПотребностей);  		
			ВерсияСоглашенияКоммерческийДоговор.Движения.ПланированиеПотребностей.Записать();
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить версию соглашения коммерческий договор %1'"),ВерсияСоглашенияКоммерческийДоговор.Номер);
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ВерсияСоглашенияКоммерческийДоговор,
				, 
				ТекстСообщения);
			
		КонецПопытки;

	КонецЦикла;
	
КонецПроцедуры

