	ДокументОбъект.ЗначениеРеквизитаСостоянияЧерновик		 = Перечисления.СостоянияСогласования.Черновик;
	ДокументОбъект.Записать();
КонецПроцедуры		// ЗадатьНастройкиДокументаРаспоряжениеНаПеремещениеДенежныхСредств()

