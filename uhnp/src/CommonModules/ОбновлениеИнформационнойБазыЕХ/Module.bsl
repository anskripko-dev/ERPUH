	|	ВТ_ПараметрыОтчета.Аналитика4 КАК Аналитика4,
	|	ВТ_ПараметрыОтчета.Аналитика5 КАК Аналитика5,
	|	ВТ_ПараметрыОтчета.Аналитика6 КАК Аналитика6,
	|	ВТ_ПараметрыОтчета.КодПараметра КАК КодПараметра,
	|	ВТ_ПараметрыОтчета.ЗначениеПараметра КАК ЗначениеПараметра
	|ИЗ
	|	ВТ_ПараметрыОтчета КАК ВТ_ПараметрыОтчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровОтчетов КАК ЗначенияПараметровОтчетов
	|		ПО ВТ_ПараметрыОтчета.ВидОтчета = ЗначенияПараметровОтчетов.ВидОтчета
	|			И ВТ_ПараметрыОтчета.Организация = ЗначенияПараметровОтчетов.Организация
	|			И ВТ_ПараметрыОтчета.Сценарий = ЗначенияПараметровОтчетов.Сценарий
	|			И ВТ_ПараметрыОтчета.Проект = ЗначенияПараметровОтчетов.Проект
	|			И ВТ_ПараметрыОтчета.Аналитика1 = ЗначенияПараметровОтчетов.Аналитика1
	|			И ВТ_ПараметрыОтчета.Аналитика2 = ЗначенияПараметровОтчетов.Аналитика2
	|			И ВТ_ПараметрыОтчета.Аналитика3 = ЗначенияПараметровОтчетов.Аналитика3
	|			И ВТ_ПараметрыОтчета.Аналитика4 = ЗначенияПараметровОтчетов.Аналитика4
	|			И ВТ_ПараметрыОтчета.Аналитика5 = ЗначенияПараметровОтчетов.Аналитика5
	|			И ВТ_ПараметрыОтчета.Аналитика6 = ЗначенияПараметровОтчетов.Аналитика6
	|			И ВТ_ПараметрыОтчета.КодПараметра = ЗначенияПараметровОтчетов.КодПараметра
	|ГДЕ
	|	ЗначенияПараметровОтчетов.Период ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПараметрыОтчета.ВидОтчета,
	|	ВТ_ПараметрыОтчета.Организация,
	|	ВТ_ПараметрыОтчета.Сценарий,
	|	ВТ_ПараметрыОтчета.Проект,
	|	ВТ_ПараметрыОтчета.Аналитика1,
	|	ВТ_ПараметрыОтчета.Аналитика2,
	|	ВТ_ПараметрыОтчета.Аналитика3,
	|	ВТ_ПараметрыОтчета.Аналитика4,
	|	ВТ_ПараметрыОтчета.Аналитика5,
	|	ВТ_ПараметрыОтчета.Аналитика6,
	|	ВТ_ПараметрыОтчета.КодПараметра,
	|	ВТ_ПараметрыОтчета.ЗначениеПараметра");
	
	Выборка = ЗапросПоПараметрам.Выполнить().Выбрать();
	ЗаписьПараметров = РегистрыСведений.ЗначенияПараметровОтчетов.СоздатьМенеджерЗаписи();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЗаписьПараметров, Выборка);
		ЗаписьПараметров.Прочитать();
		Если ЗаписьПараметров.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЗаписьПараметров, Выборка);
		ЗаписьПараметров.Период = ТекущаяДата();
		
		Попытка
			ЗаписьПараметров.Записать();	
		Исключение
		КонецПопытки;
	КонецЦикла;
	
