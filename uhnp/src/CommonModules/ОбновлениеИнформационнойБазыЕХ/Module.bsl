			КатегорияЗакупок = НайтиКатегориюЗакупок(Лоты.ТоварнаяКатегория);
			Если КатегорияЗакупок <> Неопределено Тогда     
				Лоты.ТоварнаяКатегория = КатегорияЗакупок;
			КонецЕсли;	
		КонецЕсли;
		
