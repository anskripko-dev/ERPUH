Процедура ЗаполнитьВидДенежныхСредствВПредставлениеПлатежногоКалендаря()Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря КАК ВерсияПлатежногоКалендаря,
		|	ПредставлениеПлатежногоКалендаря.Пользователь КАК Пользователь,
		|	ПредставлениеПлатежногоКалендаря.Активна КАК Активна,
		|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
		|	ПредставлениеПлатежногоКалендаря.ПулЛиквидности КАК ПулЛиквидности,
		|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
		|	ПредставлениеПлатежногоКалендаря.Банк КАК Банк,
		|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
		|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
		|	ПредставлениеПлатежногоКалендаря.Инструмент КАК Инструмент,
		|	ПредставлениеПлатежногоКалендаря.Приоритет КАК Приоритет,
		|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации КАК ИдентификаторДобавившейОперации,
		|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
		|	ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
		|ИЗ
		|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
		|ГДЕ
		|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,ВыборкаДетальныеЗаписи);
		МЗ.Прочитать();
		
		Если ТипЗнч(ВыборкаДетальныеЗаписи.БанковскийСчетКасса) = Тип("СправочникСсылка.Кассы") тогда
			ВидДенежныхСредств = Перечисления.ФормыОплаты.Наличная;
		Иначе
			ВидДенежныхСредств = Перечисления.ФормыОплаты.Безналичная;
		КонецЕсли;
		МЗ.ВидДенежныхСредств = ВидДенежныхСредств;
		МЗ.Записать();
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьЛимитыРамочныхДоговоровКредитовЗаймов() Экспорт
	
	ЗаполнитьСтатьиВерсий();
	// документы ОФД
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Бюджет.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОтражениеФактическихДанныхБюджетирования.БюджетДвиженияДенежныхСредств КАК Бюджет
		|ГДЕ
		|	Бюджет.ТолькоИзменитьСостояниеПозиции = ЛОЖЬ
		|	И Бюджет.ДоговорКонтрагента.ВидДоговораУХ = ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.Кредит)
		|	И Бюджет.ДоговорКонтрагента.ВерсияСоглашения.ЭтоКредитнаяЛиния
		|	И Бюджет.Ссылка.Проведен = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		ДокументСсылка 	= ВыборкаДетальныеЗаписи.Ссылка;
		НаборЗаписей 	= РегистрыНакопления.ЛимитыРамочныхДоговоровКредитовЗаймов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Ссылка);  
		
		ДополнительныеСвойства = Новый Структура;
		ПроведениеСерверОПК.ИнициализироватьДополнительныеСвойстваДляПроведения(ДокументСсылка, ДополнительныеСвойства);
		Документы.ОтражениеФактическихДанныхБюджетирования.ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства);
		НаборЗаписей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений["ТаблицаЛимитыРамочныхДоговоровКредитовЗаймов"]);
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
		
	КонецЦикла;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсияСоглашенияКредит.Ссылка КАК Ссылка,
		|	ВерсияСоглашенияКредит.Дата КАК Дата
		|ИЗ
		|	Документ.ВерсияСоглашенияКредит КАК ВерсияСоглашенияКредит
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКредитовИДепозитов КАК ДоговорыКредитовИДепозитов
		|		ПО (ДоговорыКредитовИДепозитов.ВерсияСоглашения = ВерсияСоглашенияКредит.Ссылка)
		|ГДЕ
		|	ВерсияСоглашенияКредит.ЭтоКредитнаяЛиния
		|	И ВерсияСоглашенияКредит.Проведен = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		НаборЗаписей = РегистрыНакопления.ЛимитыРамочныхДоговоровКредитовЗаймов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Ссылка);  
		
		ДополнительныеСвойства = Новый Структура;
		ПроведениеСерверУХ.ИнициализироватьДополнительныеСвойстваДляПроведения(ДокументСсылка, ДополнительныеСвойства);
		ВидБюджетаДоговора = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств;
		ПараметрыОперПланирования = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджетаДоговора, ВыборкаДетальныеЗаписи.Дата);
		
		ДополнительныеСвойства.ДляПроведения.Вставить("ПараметрыОперПланирования", ПараметрыОперПланирования);
		ДополнительныеСвойства.ДляПроведения.Вставить("КонтролироватьПериодыПланирования", Истина);
		ДополнительныеСвойства.ДляПроведения.Вставить("КонтролироватьПериодыЛимитирования", Ложь);
		
		Документы.ВерсияСоглашенияКредит.ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства);
		
		НаборЗаписей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений["ТаблицаЛимитыРамочныхДоговоровКредитовЗаймов"]);
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
		
	КонецЦикла;
	
	// ПокрытиеПотребностиВФинансировании
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПокрытиеПотребностиВФинансировании.Ссылка КАК Ссылка,
		|	ПокрытиеПотребностиВФинансировании.Дата КАК Дата
		|ИЗ
		|	Документ.ПокрытиеПотребностиВФинансировании КАК ПокрытиеПотребностиВФинансировании
		|ГДЕ
		|	(ПокрытиеПотребностиВФинансировании.ОсновнойВариантФинансирования.ВидФинансирования = ЗНАЧЕНИЕ(Перечисление.ВидыФинансирования.ТраншВнутригрупповогоЗайма)
		|			ИЛИ ПокрытиеПотребностиВФинансировании.ОсновнойВариантФинансирования.ВидФинансирования = ЗНАЧЕНИЕ(Перечисление.ВидыФинансирования.ТраншКредитнойЛинии))
		|	И ПокрытиеПотребностиВФинансировании.Проведен = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокументСсылка = ВыборкаДетальныеЗаписи.Ссылка;
	
		НаборЗаписей = РегистрыНакопления.ЛимитыРамочныхДоговоровКредитовЗаймов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Ссылка);  
		
   		ДополнительныеСвойства = Новый Структура;
		ПроведениеСерверУХ.ИнициализироватьДополнительныеСвойстваДляПроведения(ДокументСсылка, ДополнительныеСвойства);

		ВидБюджетаДоговора = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств;    	
		ПараметрыОперПланирования = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджетаДоговора, ВыборкаДетальныеЗаписи.Дата);  
		
		ДополнительныеСвойства.ДляПроведения.Вставить("ПараметрыОперПланирования", ПараметрыОперПланирования);
		ДополнительныеСвойства.ДляПроведения.Вставить("КонтролироватьПериодыПланирования", 	Истина);
		ДополнительныеСвойства.ДляПроведения.Вставить("КонтролироватьПериодыЛимитирования", Ложь);
		
		Документы.ПокрытиеПотребностиВФинансировании.ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства);
		
		НаборЗаписей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений["ТаблицаЛимитыРамочныхДоговоровКредитовЗаймов"]);
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);

	КонецЦикла;
	
КонецПроцедуры

Процедура РеестрПлатежейЗаполнитьРеквизитыВзаиморасчетов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеестрПлатежейЗаявкиНаОплату.Ссылка КАК РеестрПлатежей,
	|	РеестрПлатежейЗаявкиНаОплату.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	|	РеестрПлатежейЗаявкиНаОплату.ИдентификаторПозиции КАК ИдентификаторПозиции
	|ПОМЕСТИТЬ ВТ_РеестрПлатежей
	|ИЗ
	|	Документ.РеестрПлатежей.ЗаявкиНаОплату КАК РеестрПлатежейЗаявкиНаОплату
	|ГДЕ
	|	РеестрПлатежейЗаявкиНаОплату.СуммаВзаиморасчетов = 0
	|	И РеестрПлатежейЗаявкиНаОплату.ВалютаВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОплату,
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	РазмещениеЗаявок.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	РазмещениеЗаявок.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	|ПОМЕСТИТЬ ВТ_РазмещениеЗаявок
	|ИЗ
	|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|ГДЕ
	|	(РазмещениеЗаявок.ЗаявкаНаОперацию, РазмещениеЗаявок.ИдентификаторПозиции) В
	|			(ВЫБРАТЬ
	|				ВТ_РеестрПлатежей.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	|				ВТ_РеестрПлатежей.ИдентификаторПозиции КАК ИдентификаторПозиции
	|			ИЗ
	|				ВТ_РеестрПлатежей КАК ВТ_РеестрПлатежей)";
	
	Запрос.Выполнить();    

    ТаблицыЗапроса = Новый Структура;    
	
	Для Каждого ТекущаяТаблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		ТаблицыЗапроса.Вставить(ТекущаяТаблица.ПолноеИмя, ТекущаяТаблица.ПолучитьДанные().Выгрузить());
	КонецЦикла;   
	
	Если ТаблицыЗапроса.ВТ_РеестрПлатежей.Количество() = 0 
		Или ТаблицыЗапроса.ВТ_РазмещениеЗаявок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
   
	ТаблицыЗапроса.ВТ_РеестрПлатежей.Свернуть("РеестрПлатежей");   
	
	ПараметрыОтбора = Новый Структура("ЗаявкаНаОплату, ИдентификаторПозиции");

	Для Каждого ТекущийДокумент Из ТаблицыЗапроса.ВТ_РеестрПлатежей Цикл
		
		ДокументОбъект = ТекущийДокумент.РеестрПлатежей.ПолучитьОбъект();
		
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.ЗаявкиНаОплату Цикл
			
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаВзаиморасчетов) 
				И ЗначениеЗаполнено(СтрокаТабличнойЧасти.ВалютаВзаиморасчетов) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТабличнойЧасти);
			СтрокиРазмещения = ТаблицыЗапроса.ВТ_РазмещениеЗаявок.НайтиСтроки(ПараметрыОтбора); 
			
			Если СтрокиРазмещения.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;   
			
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокиРазмещения[0],,"ЗаявкаНаОплату, ИдентификаторПозиции");   		

		КонецЦикла;		
		
		Если ДокументОбъект.Модифицированность() Тогда
			Попытка
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
			Исключение
				ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось заполнить реквизиты взаиморасчетов в документе ""%1""
				|%2'"),
				ТекущийДокумент.РеестрПлатежей,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				,
				, 
				ТекстСообщения);
			КонецПопытки;
			
		КонецЕсли;  
		
	КонецЦикла;  

КонецПроцедуры 

Процедура ОбновитьРазмещениеВнешнейИБ(Параметры=Неопределено) Экспорт
	
