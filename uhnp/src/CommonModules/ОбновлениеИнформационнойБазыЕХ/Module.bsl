			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ЗаказПоставщику,
				, 
				ТекстСообщения);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьДвиженияПланированияПоЗаказамПоставщикуБезТовараДоговора() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПоставщику.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности КАК ЗапасыИПотребности
	               |		ПО ЗаказПоставщику.Ссылка = ЗапасыИПотребности.Регистратор
				   |		Левое СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
				   |		ПО ЗаказПоставщику.Ссылка = ПланированиеПотребностей.Регистратор
				   |ГДЕ
				   |	ЗаказПоставщику.Ссылка.Проведен И ПланированиеПотребностей.Регистратор is null
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказПоставщику.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Попытка
		Заказ = Выборка.Ссылка.ПолучитьОбъект();
		ДополнительныеСвойства = Новый Структура;
		ДополнительныеСвойства.Вставить("ТаблицыДляДвижений",Новый Структура());
		УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ИнициализироватьДанныеЗаказа(Заказ.Ссылка, ДополнительныеСвойства, ,Ложь);
		Заказ.Движения.ПланированиеПотребностей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПланированиеПотребностей);
		Заказ.Движения.ПланированиеПотребностей.Записать();	   
		
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить заказ поставщику %1'"),Выборка.Ссылка.Номер);
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ЗаказПоставщику,
				, 
				ТекстСообщения);
				
		КонецПопытки;
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ДобавитьДвиженияПланированияПоПоступлению() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеТоваровУслуг.Ссылка КАК ПоступлениеТоваровУслуг
	               |ИЗ
	               |	Документ.ПриобретениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей.Остатки КАК ПланированиеПотребностейОстатки
	               |		ПО (ПоступлениеТоваровУслуг.Договор = ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект.Ссылка
	               |				ИЛИ ПоступлениеТоваровУслуг.ЗаказПоставщику = ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект.Ссылка)
	               |		Левое СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	               |		ПО ПоступлениеТоваровУслуг.Ссылка = ПланированиеПотребностей.Регистратор
				   |ГДЕ
	               |	ПоступлениеТоваровУслуг.Проведен
				   |	И ПланированиеПотребностей.Регистратор ЕСТЬ NULL				   
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступлениеТоваровУслуг.Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ПоступлениеТоваровУслуг = Выборка.ПоступлениеТоваровУслуг.ПолучитьОбъект();
			ДополнительныеСвойства = Новый Структура;
			ДополнительныеСвойства.Вставить("ТаблицыДляДвижений",Новый Структура());
