Процедура ОбновитьДоговораНаДатуОперации() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка КАК ВерсияДоговора
	               |ИЗ
	               |	Документ.ВерсияСоглашенияКоммерческийДоговор.Номенклатура КАК ВерсияСоглашенияКоммерческийДоговорНоменклатура
	               |ГДЕ
	               |	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |	И ВерсияСоглашенияКоммерческийДоговорНоменклатура.ДатаПоставки = ДАТАВРЕМЯ(1, 1, 1)
				   |	И ВерсияСоглашенияКоммерческийДоговорНоменклатура.Сумма <> 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Версия = Выборка.ВерсияДоговора.ПолучитьОбъект();
		Для Каждого СтрокаНоменклатуры ИЗ Версия.Номенклатура Цикл
			
			СтрокаНоменклатуры.ДатаПоставки = СтрокаНоменклатуры.ПериодПотребности.ДатаНачала;
			
		КонецЦикла;	     
		Версия.ОбменДанными.Загрузка=Истина;
		Попытка
			
			Версия.Записать(РежимЗаписиДокумента.Запись);
			
		Исключение
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Не удалось обновить версию договора %1'"), 
			Версия.Наименование, 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), 
			Символы.ПС),,,СтатусСообщения.Внимание);
			
		КонецПопытки;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбновитьСтрокиПланаЗакупокИЗакупочныеПроцедурыСпособВыбораПоставщика() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтрокаПланаЗакупок.Ссылка КАК СтрокаПланаЗакупок,
	               |	СпособВыбора.Ссылка КАК СпособВыбораПоставщика
	               |ИЗ
	               |	Документ.СтрокаПланаЗакупок КАК СтрокаПланаЗакупок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыВыбораПоставщика КАК СпособВыбора
	               |		ПО СтрокаПланаЗакупок.СпособВыбораПоставщика = СпособВыбора.СпособыВыбораПоставщика
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(СтрокаПланаЗакупок.СпособВыбораПоставщика) = ТИП(Перечисление.СпособыВыбораПоставщика)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл   
		
		Попытка
		СтрокаПланаЗакупок = Выборка.СтрокаПланаЗакупок.ПолучитьОбъект();
		СтрокаПланаЗакупок.СпособВыбораПоставщика = Выборка.СпособВыбораПоставщика;
		СтрокаПланаЗакупок.ОбменДанными.Загрузка=Истина;
		СтрокаПланаЗакупок.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить версию строки плана закупок %1'"),СтрокаПланаЗакупок.Номер);
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.СтрокаПланаЗакупок,
				, 
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗакупочныеПроцедуры.Ссылка КАК ЗакупочнаяПроцедура,
	               |	СпособВыбора.Ссылка КАК СпособВыбораПоставщика
	               |ИЗ
	               |	Справочник.ЗакупочныеПроцедуры КАК ЗакупочныеПроцедуры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыВыбораПоставщика КАК СпособВыбора
	               |		ПО ЗакупочныеПроцедуры.УдалитьСпособВыбораПоставщика = СпособВыбора.СпособыВыбораПоставщика
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(ЗакупочныеПроцедуры.УдалитьСпособВыбораПоставщика) = ТИП(Перечисление.СпособыВыбораПоставщика)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл   
		
		Попытка
		ЗакупочнаяПроцедура = Выборка.ЗакупочнаяПроцедура.ПолучитьОбъект();
		ЗакупочнаяПроцедура.СпособВыбораПоставщика = Выборка.СпособВыбораПоставщика;
		ЗакупочнаяПроцедура.ОбменДанными.Загрузка=Истина;
		ЗакупочнаяПроцедура.Записать();
			
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить закупочную процедуру %1'"),ЗакупочнаяПроцедура.Код);
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.ЗакупочныеПроцедуры,
				, 
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры


