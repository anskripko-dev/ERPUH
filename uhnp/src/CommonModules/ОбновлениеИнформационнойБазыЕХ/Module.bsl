			ОбъектРазница.СчетОтражения = СчетОтражения;
		КонецЕсли;
		
		Если ОбъектРазница.Модифицированность() Тогда
			ЗаписатьОбъект(ОбъектРазница);		
		КонецЕсли;		
		
	КонецЦикла; 

КонецПроцедуры

