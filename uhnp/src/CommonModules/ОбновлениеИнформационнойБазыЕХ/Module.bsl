	               |	ПотребностиВНоменклатуре.Приоритет КАК Приоритет,
	               |	ПотребностиВНоменклатуре.Номенклатура КАК Номенклатура,
	               |	ПотребностиВНоменклатуре.Характеристика КАК Характеристика,
	               |	ПотребностиВНоменклатуре.МестоПоставки КАК МестоПоставки,
	               |	ПотребностиВНоменклатуре.Проект КАК Проект,
	               |	ПотребностиВНоменклатуре.Менеджер КАК Менеджер,
	               |	ПотребностиВНоменклатуре.ДоговорСПокупателем КАК ДоговорСПокупателем,
	               |	ПотребностиВНоменклатуре.УдалитьСтавкаНДС КАК УдалитьСтавкаНДС,
	               |	ПотребностиВНоменклатуре.СтавкаНДС КАК СтавкаНДС,
	               |	ПотребностиВНоменклатуре.КлючиАналитикиПланированияСтатейБюджетов КАК КлючиАналитикиПланированияСтатейБюджетов,
	               |	ПотребностиВНоменклатуре.Валюта КАК Валюта,
	               |	ПотребностиВНоменклатуре.КоличествоПотребность КАК КоличествоПотребность,
	               |	ПотребностиВНоменклатуре.СуммаПотребность КАК СуммаПотребность,
	               |	ПотребностиВНоменклатуре.КоличествоВОбеспечении КАК КоличествоВОбеспечении,
	               |	ПотребностиВНоменклатуре.СуммаВОбеспечении КАК СуммаВОбеспечении,
	               |	ПотребностиВНоменклатуре.КоличествоВнеПлана КАК КоличествоВнеПлана,
	               |	ПотребностиВНоменклатуре.СуммаВнеПлана КАК СуммаВнеПлана,
	               |	ПотребностиВНоменклатуре.Коэффициент КАК Коэффициент,
	               |	ПотребностиВНоменклатуре.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрНакопления.ПотребностиВНоменклатуре КАК ПотребностиВНоменклатуре
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПотребностиПлана КАК ВТ_ПотребностиПлана
	               |		ПО ПотребностиВНоменклатуре.Организация = ВТ_ПотребностиПлана.Организация
	               |			И ПотребностиВНоменклатуре.ПериодПотребности = ВТ_ПотребностиПлана.ПериодПотребности
	               |			И ПотребностиВНоменклатуре.Номенклатура = ВТ_ПотребностиПлана.Номенклатура
	               |			И ПотребностиВНоменклатуре.Характеристика = ВТ_ПотребностиПлана.Характеристика
	               |			И ПотребностиВНоменклатуре.МестоПоставки = ВТ_ПотребностиПлана.МестоПоставки
	               |			И ПотребностиВНоменклатуре.Валюта = ВТ_ПотребностиПлана.Валюта
	               |			И ПотребностиВНоменклатуре.Проект = ВТ_ПотребностиПлана.Проект
	               |			И ПотребностиВНоменклатуре.Менеджер = ВТ_ПотребностиПлана.Менеджер
	               |			И ПотребностиВНоменклатуре.Приоритет = ВТ_ПотребностиПлана.Приоритет
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(ПотребностиВНоменклатуре.Регистратор) = ТИП(документ.СтрокаПланаЗакупок)
	               |	И НЕ ПотребностиВНоменклатуре.Регистратор.ВнеПлановойПотребности
	               |ИТОГИ ПО
	               |	Регистратор";
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		Попытка
			СтрокаПлана = Выборка.Регистратор.ПолучитьОбъект();
			Для Каждого Номенклатура ИЗ СтрокаПлана.Номенклатура Цикл
				НоменклатураВыборки = Выборка.Выбрать();
				Пока НоменклатураВыборки.Следующий() Цикл  
					Если Номенклатура.Организация = НоменклатураВыборки.Организация И
						Номенклатура.ПериодПотребности = НоменклатураВыборки.ПериодПотребности И	
						Номенклатура.Номенклатура = НоменклатураВыборки.Номенклатура И	
						Номенклатура.Характеристика = НоменклатураВыборки.Характеристика И	
						Номенклатура.МестоПоставки = НоменклатураВыборки.МестоПоставки И	
						СтрокаПлана.ВалютаДокумента = НоменклатураВыборки.Валюта И	
						Номенклатура.Проект = НоменклатураВыборки.Проект И	
						Номенклатура.Приоритет = НоменклатураВыборки.Приоритет Тогда	
						Номенклатура.АналитикаИсточника = НоменклатураВыборки.АналитикаИсточника;  
						Номенклатура.АналитикаПланирования = НоменклатураВыборки.АналитикаПланирования; 
						Номенклатура.СтатьяБюджета = НоменклатураВыборки.АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета;
						Номенклатура.Аналитика1 = НоменклатураВыборки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика1;
						Номенклатура.Аналитика2 = НоменклатураВыборки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика2;
						Номенклатура.Аналитика3 = НоменклатураВыборки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика3;
						Номенклатура.Аналитика4 = НоменклатураВыборки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика4;
						Номенклатура.Аналитика5 = НоменклатураВыборки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика5;
						Номенклатура.Аналитика6 = НоменклатураВыборки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика6;
						
					КонецЕсли;
				КонецЦикла;	                
			КонецЦикла;
			СтрокаПлана.ОбменДанными.Загрузка=Истина; 
			СтрокаПлана.Записать(РежимЗаписиДокумента.Запись);
			СтрокаПлана = Выборка.Регистратор.ПолучитьОбъект(); 
			СтрокаПлана.ОбменДанными.Загрузка = Истина; 
			
 			ДополнительныеСвойства = Новый Структура;
			ДополнительныеСвойства.Вставить("ТаблицыДляДвижений",Новый Структура());

			Документы.СтрокаПланаЗакупок.ИнициализироватьДанныеДокумента(СтрокаПлана.Ссылка, ДополнительныеСвойства);
			СтрокаПлана.Движения.ПланированиеПотребностей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПланированиеПотребностей);
			СтрокаПлана.Движения.ПланированиеПотребностей.Записать();	

			
		Исключение
			
			ТекстСообщения =СтрШаблон(Нстр("ru = 'Не удалось обновить версию строки плана закупок %1'"),СтрокаПлана.Номер);
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.СтрокаПланаЗакупок,
				, 
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;	
	
КонецПроцедуры	


Процедура СоздатьДвиженияПоСтрокамЗакупок() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	               |	Лоты.СтрокаПланаЗакупок КАК СтрокаПланаЗакупок
	               |ИЗ
	               |	Справочник.Лоты КАК Лоты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПротоколВыбораПобедителей.РаспределениеПоПотребностям КАК ПротоколВыбораПобедителейРаспределениеПоПотребностям
	               |		ПО Лоты.Ссылка = ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей.Обороты(, , Регистратор, ) КАК ПланированиеПотребностей
				   |		ПО Лоты.СтрокаПланаЗакупок = ПланированиеПотребностей.Регистратор
				   |ГДЕ
	               |	НЕ Лоты.ПометкаУдаления
	               |	И Лоты.СтрокаПланаЗакупок <> ЗНАЧЕНИЕ(Документ.СтрокаПланаЗакупок.ПустаяСсылка)
	               |	И НЕ Лоты.Владелец.ПометкаУдаления
	               |	И Лоты.СтрокаПланаЗакупок.Проведен  
			       |	И ПланированиеПотребностей.Регистратор ЕСТЬ NULL
	               |СГРУППИРОВАТЬ ПО
