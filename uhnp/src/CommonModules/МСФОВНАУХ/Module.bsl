#Область ТекстЗапроса_ПрофилиНСБУ

Функция ТекстЗапроса_ПрофилиНСБУ(НомераТаблиц, ЭтоМСФО = Ложь)
	
	НомераТаблиц.Вставить("втПрофилиМСФО", НомераТаблиц.Количество());
	
	Если ЭтоМСФО Тогда
	
		Возврат
		"ВЫБРАТЬ
		|	т.Ссылка КАК ПрофильНСБУ,
		|	т.Ссылка КАК ПрофильМСФО
		|ПОМЕСТИТЬ втПрофилиМСФО
		|ИЗ
		|	Справочник.СпособыОтраженияРасходовПоАмортизацииМСФО КАК т
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПрофильНСБУ";
		
	ИначеЕсли ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
	
		Возврат
		"ВЫБРАТЬ
		|	т.СтатьяРасходов КАК СтатьяРасходов,
		|	т.АналитикаРасходов КАК АналитикаРасходов,
		|	т.Подразделение КАК Подразделение,
		|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	МАКСИМУМ(т.ПрофильРаспределенияНСБУ) КАК ПрофильНСБУ,
		|	МАКСИМУМ(т.Ссылка) КАК ПрофильМСФО
		|ПОМЕСТИТЬ втПрофилиМСФО
		|ИЗ
		|	Справочник.СпособыОтраженияРасходовПоАмортизацииМСФО КАК т
		|
		|СГРУППИРОВАТЬ ПО
		|	т.СтатьяРасходов,
		|	т.АналитикаРасходов,
		|	т.Подразделение,
		|	т.НаправлениеДеятельности
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтатьяРасходов,
		|	АналитикаРасходов,
		|	Подразделение,
		|	НаправлениеДеятельности";
	
	КонецЕсли;
	
	Возврат
	"ВЫБРАТЬ
	|	т.ПрофильРаспределенияНСБУ КАК ПрофильНСБУ,
	|	МАКСИМУМ(т.Ссылка) КАК ПрофильМСФО
	|ПОМЕСТИТЬ втПрофилиМСФО
	|ИЗ
	|	Справочник.СпособыОтраженияРасходовПоАмортизацииМСФО КАК т
	|ГДЕ
	|	т.ПрофильРаспределенияНСБУ <> ЗНАЧЕНИЕ(Справочник.СпособыОтраженияРасходовПоАмортизации.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ПрофильРаспределенияНСБУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПрофильНСБУ";
	
