	ДополнительныеПоля = Новый Структура();
	
	ДополнительныеПоля.Вставить("ПараметрыУчетаВНА",			"ПараметрыУчетаВНА");
	ДополнительныеПоля.Вставить("ДатаПринятияКУчетуНСБУ", 		"ДатаСобытияНСБУ");
