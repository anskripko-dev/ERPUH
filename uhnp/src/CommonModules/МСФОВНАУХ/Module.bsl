	|		ВЫБОР
	|			КОГДА т.Ссылка В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчетаОбесцененияВНА КАК т)
	|				ТОГДА ""ОВНА""
	|			ИНАЧЕ ""НЗС""
	|		КОНЕЦ КАК РольСчета
	|	ИЗ
	|		ПланСчетов.Хозрасчетный КАК т
	|	ГДЕ
	|		т.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОборудованиеКУстановке), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВложенияВоВнеоборотныеАктивы))
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.Ссылка,
	|		ЗНАЧЕНИЕ(Перечисление.ТипыВНА.ОсновноеСредство),
	|		ВЫБОР
	|			КОГДА т.Ссылка В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчетаОбесцененияВНА КАК т)
	|				ТОГДА ""ОВНА""
	|			КОГДА т.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.АмортизацияОсновныхСредств))
	|				ТОГДА ""НАВНА""
	|			КОГДА т.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыбытиеОС), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыбытиеМЦ))
	|				ТОГДА ""ВВНА""
	|			ИНАЧЕ ""ВНА""
	|		КОНЕЦ
	|	ИЗ
	|		ПланСчетов.Хозрасчетный КАК т
	|	ГДЕ
	|		т.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновныеСредства), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.АмортизацияОсновныхСредств), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ДоходныеВложенияВ_МЦ))
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.Ссылка,
	|		ЗНАЧЕНИЕ(Перечисление.ТипыВНА.НематериальныйАктив),
	|		ВЫБОР
	|			КОГДА т.Ссылка В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
