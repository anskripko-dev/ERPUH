Функция ТипыВНАДляОстатков()

	ТипыВНА = Новый Массив;
	ТипыВНА.Добавить("НематериальныеАктивы");
	ТипыВНА.Добавить("ОбъектыСтроительства");
	ТипыВНА.Добавить("Номенклатура");
	
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		
		ТипыВНА.Добавить("ОбъектыЭксплуатации");
		
	Иначе 
		
		ТипыВНА.Добавить("ОсновныеСредства");
		ТипыВНА.Добавить("РасходыБудущихПериодов");
		
	КонецЕсли;
	
	Возврат ТипыВНА;

КонецФункции

Функция ТекстЗапроса_УчитываемыеВНА(НомераТаблиц, УчитываемыеВНА = Истина)
	
	НомераТаблиц.Вставить("втУчитываемыеВНА", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.ВНА КАК ВНА,
	|	т.ГруппаВНА КАК ПараметрыУчетаВНА
	|ПОМЕСТИТЬ втУчитываемыеВНА
	|ИЗ
	|	РегистрСведений.ПараметрыУчетаВНАМСФО.СрезПоследних(
	|			&ДатаНачала,
	|			Организация = &Организация
	|				И Сценарий = &Сценарий
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.МСФО)
	|				И Активность 
	|				И &УчитываемыеВНА) КАК т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УчитываемыеВНА", ?(УчитываемыеВНА, "ИСТИНА", "ЛОЖЬ"));
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапроса_КлассыСПараметрами(НомераТаблиц)

	НомераТаблиц.Вставить("втКлассыСПараметрами", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК КлассВНА,
	|	т.ПараметрыУчетаВНА КАК ПараметрыУчетаВНА
	|ПОМЕСТИТЬ втКлассыСПараметрами
	|ИЗ
	|	Справочник.КлассыВНА КАК т
	|ГДЕ
	|	т.ПараметрыУчетаВНА <> ЗНАЧЕНИЕ(Справочник.ГруппыВНАМСФО.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлассВНА";
	

КонецФункции

Функция ТекстЗапроса_ПараметрыУчетаВНАПоУмолчанию(НомераТаблиц, ТипыВНА)
	
	НомераТаблиц.Вставить("втПараметрыУчетаВНАПоУмолчанию", НомераТаблиц.Количество());
	ТекстЗапроса = Новый Массив;
	
	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(т.ВНА КАК Справочник.НематериальныеАктивы) КАК ВНА,
	|	ВЫРАЗИТЬ(т.ВНА КАК Справочник.НематериальныеАктивы).ЭтоГруппа КАК ЭтоГруппа,
	|	т.ПараметрыУчетаВНА КАК ПараметрыУчетаВНА
	|ПОМЕСТИТЬ втПараметрыУчетаВНАПоУмолчанию
	|ИЗ
	|	РегистрСведений.ПараметрыУчетаВНАПоУмолчанию КАК т
	|ГДЕ
	|	т.ВНА ССЫЛКА Справочник.НематериальныеАктивы
	|	И ЕСТЬNULL(НЕ т.ВНА.КлассВНА В
	|					(ВЫБРАТЬ
	|						вт.КлассВНА
	|					ИЗ
	|						втКлассыСПараметрами КАК вт), ИСТИНА)
	|	И НЕ т.ВНА В
	|				(ВЫБРАТЬ
	|					т.ВНА
	|				ИЗ
	|					втУчитываемыеВНА КАК т)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Ссылка,
	|	т.ЭтоГруппа,
	|	т.КлассВНА.ПараметрыУчетаВНА
	|ИЗ
	|	Справочник.НематериальныеАктивы КАК т
	|ГДЕ
	|	т.КлассВНА В
	|			(ВЫБРАТЬ
	|				вт.КлассВНА
	|			ИЗ
	|				втКлассыСПараметрами КАК вт)";
	
	Для каждого ИмяТипа Из ТипыВНА Цикл
		ТекстЗапроса.Добавить(СтрЗаменить(ШаблонЗапроса, "НематериальныеАктивы", ИмяТипа));
		Если ТекстЗапроса.ВГраница() = 0 Тогда
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "ПОМЕСТИТЬ втПараметрыУчетаВНАПоУмолчанию", "");
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ") + " ИНДЕКСИРОВАТЬ ПО ЭтоГруппа, ВНА";
	
КонецФункции

Функция ТекстЗапроса_втПриоритетыПараметровВНА(НомераТаблиц, ТипыВНА)
	
	НомераТаблиц.Вставить("втПриоритетыПараметровВНА", НомераТаблиц.Количество());
	
	ТекстЗапроса = Новый Массив;
	ТекстЗапроса.Добавить(ТекстЗапроса_ПараметрыЭлементовПоУмолчанию());
	
	ШаблонЗапроса = ШаблонЗапроса_ПриоритетыТаблицыВНА();
	Для каждого ИмяТипа Из ТипыВНА Цикл
		ТекстЗапроса.Добавить(СтрЗаменить(ШаблонЗапроса, "НематериальныеАктивы", ИмяТипа));
	КонецЦикла;

	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ");

КонецФункции

Функция ТекстЗапроса_ПараметрыЭлементовПоУмолчанию()

	Возврат
	"ВЫБРАТЬ
	|	т.ВНА КАК ВНА,
	|	0 КАК Приоритет,
	|	т.ВНА КАК ГруппаВНА,
	|	т.ПараметрыУчетаВНА КАК ПараметрыУчетаВНА
	|ПОМЕСТИТЬ втПриоритетыПараметровВНА
	|ИЗ
	|	втПараметрыУчетаВНАПоУмолчанию КАК т
	|ГДЕ
	|	НЕ т.ЭтоГруппа";

КонецФункции	

Функция ШаблонЗапроса_ПриоритетыТаблицыВНА()

	Возврат
	"ВЫБРАТЬ
	|	ТаблицаВНА.Ссылка КАК ВНА,
	|	ВЫБОР т.ВНА
	|		КОГДА ТаблицаВНА.Родитель
	|			ТОГДА 1
	|		КОГДА ТаблицаВНА.Родитель.Родитель
	|			ТОГДА 2
	|		КОГДА ТаблицаВНА.Родитель.Родитель.Родитель
	|			ТОГДА 3
	|		КОГДА ТаблицаВНА.Родитель.Родитель.Родитель.Родитель
	|			ТОГДА 4
	|		КОГДА ТаблицаВНА.Родитель.Родитель.Родитель.Родитель.Родитель
	|			ТОГДА 5
	|		ИНАЧЕ 6
	|	КОНЕЦ КАК Приоритет,
	|	т.ВНА КАК ГруппаВНА,
	|	т.ПараметрыУчетаВНА КАК ПараметрыУчетаВНА
	|ИЗ
	|	втПараметрыУчетаВНАПоУмолчанию КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НематериальныеАктивы КАК ТаблицаВНА
	|		ПО (т.ВНА ССЫЛКА Справочник.НематериальныеАктивы)
	|			И (т.ЭтоГруппа)
	|			И (НЕ ТаблицаВНА.ЭтоГруппа)
	|			И (ВЫРАЗИТЬ(т.ВНА КАК Справочник.НематериальныеАктивы) В (ТаблицаВНА.Родитель, ТаблицаВНА.Родитель.Родитель, ТаблицаВНА.Родитель.Родитель.Родитель, ТаблицаВНА.Родитель.Родитель.Родитель.Родитель))";

КонецФункции

Функция ТекстЗапроса_втВНА(НомераТаблиц)
	
	НомераТаблиц.Вставить("втВНА", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	втПриоритеты.ВНА КАК ВНА,
	|	МАКСИМУМ(втПриоритеты.ВНА.КлассВНА) КАК КлассВНА,
	|	МАКСИМУМ(втПриоритеты.ПараметрыУчетаВНА) КАК ПараметрыУчетаВНА,
	|	МАКСИМУМ(втПриоритеты.ПараметрыУчетаВНА.ПараметрыУчетаНЗС) КАК ПараметрыУчетаНЗС,
	|	NULL КАК СобытиеВНА,
	|	ЛОЖЬ КАК ЕстьВУчете
	|ПОМЕСТИТЬ втВНА
	|ИЗ
	|	(ВЫБРАТЬ
	|		втПриоритеты.ВНА КАК ВНА,
	|		МИНИМУМ(втПриоритеты.Приоритет) КАК Приоритет
	|	ИЗ
	|		втПриоритетыПараметровВНА КАК втПриоритеты
	|	ГДЕ
	|		НЕ втПриоритеты.ВНА В
	|					(ВЫБРАТЬ
	|						т.ВНА
	|					ИЗ
	|						втУчитываемыеВНА КАК т)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		втПриоритеты.ВНА) КАК МинПриоритет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПриоритетыПараметровВНА КАК втПриоритеты
	|		ПО МинПриоритет.ВНА = втПриоритеты.ВНА
	|			И МинПриоритет.Приоритет = втПриоритеты.Приоритет
	|
	|СГРУППИРОВАТЬ ПО
	|	втПриоритеты.ВНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.ВНА,
	|	т.ВНА.КлассВНА,
	|	т.ПараметрыУчетаВНА,
	|	т.ПараметрыУчетаВНА.ПараметрыУчетаНЗС,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.МодернизацияВНА),
	|	ИСТИНА
	|ИЗ
	|	втУчитываемыеВНА КАК т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА,
	|	ЕстьВУчете";

КонецФункции

#КонецОбласти

#Область ТекстЗапроса_СчетаВНАНСБУ

Функция ТекстЗапроса_СчетаОбесцененияВНАМСФО(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСчетаОбесцененияВНА", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	т.СчетНакопленногоОбесценения.СчетСсылка КАК Счет
	|ПОМЕСТИТЬ втСчетаОбесцененияВНА
	|ИЗ
	|	Справочник.ПараметрыОбесцененияВНАМСФО КАК т
	|ГДЕ
	|	НЕ т.ПометкаУдаления";

КонецФункции

Функция ТекстЗапроса_втСчетаВНАМСФО(НомераТаблиц)

	НомераТаблиц.Вставить("втСчетаВНА", НомераТаблиц.Количество());
	
	//РольСчета: ВНА(НЗС, ВНА), Амортизация(НАВНА), Переоценка(ПВНА), Обесценение(ОВНА), Выбытие(ВВНА), 79(ВХР), 91(ПДР) 
		
	//ПСВНА - первоначальная стоимость ВНА(01, 03, 04, 07, 08, 97.21)
	//НАВНА - накопленная амортизация ВНА(02, 05)
	//ОВНА - обесценение ВНА(02.08)
	//ПВНА - переоценка ВНА(83)
	//ПД, ПР - прочие доходы(91.01), прочие расходы(91.02)
	//АВНА - амортизируемый ВНА(01,03,04)
	//НЗС - незавершенное строительство и другие вложения в ВНА(07, 08)
	//ВХР - внутрихозяйственные расчеты(79)

	Возврат
	"ВЫБРАТЬ
	|	СчетаБД.Ссылка КАК СчетИБ,
	|	СчетаВНА.Счет КАК Счет,
	|	СчетаВНА.ТипВНА КАК ТипВНА,
	|	СчетаВНА.РольСчета КАК РольСчета,
	|	ВидСубконто1.ТолькоОбороты КАК ТолькоОбороты1,
	|	ВидСубконто2.ТолькоОбороты КАК ТолькоОбороты2,
	|	ВидСубконто3.ТолькоОбороты КАК ТолькоОбороты3
	|ПОМЕСТИТЬ втСчетаВНА
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.СчетУчетаПервоначальнойСтоимости.СчетСсылка КАК Счет,
	|		МАКСИМУМ(т.ТипВНА) КАК ТипВНА,
	|		ВЫБОР
	|			КОГДА МАКСИМУМ(т.СчетУчетаПервоначальнойСтоимости.СчетСсылка) В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчетаОбесцененияВНА КАК т)
	|				ТОГДА ""ОВНА""
	|			ИНАЧЕ ""НЗС""
	|		КОНЕЦ КАК РольСчета
	|	ИЗ
	|		Справочник.ГруппыВНАМСФО КАК т
	|	ГДЕ
	|		НЕ т.ПометкаУдаления
	|	
	|	СГРУППИРОВАТЬ ПО
	|		т.СчетУчетаПервоначальнойСтоимости.СчетСсылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.СчетНакопленнойАмортизации.СчетСсылка,
	|		МАКСИМУМ(т.ТипВНА),
	|		ВЫБОР
	|			КОГДА МАКСИМУМ(т.СчетНакопленнойАмортизации.СчетСсылка) В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчетаОбесцененияВНА КАК т)
	|				ТОГДА ""ОВНА""
	|			ИНАЧЕ ""НАВНА""
	|		КОНЕЦ
	|	ИЗ
	|		Справочник.ГруппыВНАМСФО КАК т
	|	ГДЕ
	|		НЕ т.ПометкаУдаления
	|	
	|	СГРУППИРОВАТЬ ПО
	|		т.СчетНакопленнойАмортизации.СчетСсылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.СчетНакопленнойПереоценки.СчетСсылка,
	|		МАКСИМУМ(ЗНАЧЕНИЕ(Перечисление.ТипыВНА.НематериальныйАктив)),
	|		ВЫБОР
	|			КОГДА МАКСИМУМ(т.СчетНакопленнойПереоценки.СчетСсылка) В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчетаОбесцененияВНА КАК т)
	|				ТОГДА ""ОВНА""
	|			ИНАЧЕ ""ПВНА""
	|		КОНЕЦ
	|	ИЗ
	|		Справочник.ПараметрыПереоценкиВНАМСФО КАК т
	|	ГДЕ
	|		НЕ т.ПометкаУдаления
	|	
	|	СГРУППИРОВАТЬ ПО
	|		т.СчетНакопленнойПереоценки.СчетСсылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.Ссылка,
	|		NULL,
	|		""ПДР""
	|	ИЗ
	|		ПланСчетов.МСФО КАК т
	|	ГДЕ
	|		т.РазделПланаСчетов В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ВнереализационныеДоходыИРасходы))) КАК СчетаВНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБД
	|		ПО СчетаВНА.Счет = СчетаБД.СчетСсылка
	|			И (НЕ СчетаБД.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.МСФО.ВидыСубконто КАК ВидСубконто1
	|		ПО СчетаВНА.Счет = ВидСубконто1.Ссылка
	|			И (ВидСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.МСФО.ВидыСубконто КАК ВидСубконто2
	|		ПО СчетаВНА.Счет = ВидСубконто2.Ссылка
	|			И (ВидСубконто2.НомерСтроки = 2)
