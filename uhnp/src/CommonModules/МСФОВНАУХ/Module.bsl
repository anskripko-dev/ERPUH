Процедура ТекстЗапроса_ПУВНА(ТекстЗапроса, НомераТаблиц, УчитываемыеВНА = Истина) Экспорт
	
	ТипыВНА = ТипыВНАДляОстатков();
	
	ТекстЗапроса.Добавить(ТекстЗапроса_УчитываемыеВНА(НомераТаблиц, УчитываемыеВНА));
	ТекстЗапроса.Добавить(ТекстЗапроса_КлассыСПараметрами(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПараметрыУчетаВНАПоУмолчанию(НомераТаблиц, ТипыВНА));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПриоритетыПараметровВНА(НомераТаблиц, ТипыВНА));
	ТекстЗапроса.Добавить(ТекстЗапроса_втВНА(НомераТаблиц));

КонецПроцедуры

Процедура ТекстЗапроса_СчетаВНАНСБУ(ТекстЗапроса, НомераТаблиц, ЭтоМСФО = Ложь) Экспорт
	
	Если ЭтоМСФО Тогда
		
		ТекстЗапроса.Добавить(ТекстЗапроса_СчетаОбесцененияВНАМСФО(НомераТаблиц));
		ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаВНАМСФО(НомераТаблиц));
		Возврат;
		
	КонецЕсли;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_СчетаОбесцененияВНА(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаВНА(НомераТаблиц));
	
КонецПроцедуры

Процедура ТекстЗапроса_ПараметрыВНАРСБУ(ТекстЗапроса, НомераТаблиц, ЭтоМСФО = Ложь) Экспорт
		
	Если ЭтоМСФО Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_ПараметрыВНАНСБУ_УХ(НомераТаблиц));
	ИначеЕсли ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_ПараметрыВНАРСБУ_ЕРП(НомераТаблиц));
	Иначе 
		ТекстЗапроса.Добавить(ТекстЗапроса_ПараметрыВНАРСБУ_БП(НомераТаблиц));
	КонецЕсли;
	
КонецПроцедуры

Процедура ТекстЗапроса_ПрофилиМСФОНСБУ(ТекстЗапроса, НомераТаблиц, ЭтоМСФО = Ложь) Экспорт
	ТекстЗапроса.Добавить(ТекстЗапроса_ПрофилиНСБУ(НомераТаблиц, ЭтоМСФО));
КонецПроцедуры

