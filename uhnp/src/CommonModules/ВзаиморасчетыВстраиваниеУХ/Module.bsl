Процедура ДобавитьРеквизитСохранятьАвторасчетСрокаОплатыУХ(Форма, ДобавляемыеРеквизиты)
	ФормыУХ.СоздатьДобавитьРеквизитФормы(Форма, ДобавляемыеРеквизиты, "СохранятьАвторасчетСрокаОплатыУХ", "Булево");
КонецПроцедуры

Процедура ДобавитьКомандуОткрытьГрафикРасчетовНаФорму(Форма, ГруппаЭлементов)
	
	Команды = Форма.Команды;
	Элементы = Форма.Элементы;
	
	// график расчетов
	Параметры = ВзаиморасчетыВстраиваниеУХКлиентСервер.ПараметрыСозданияКомандыОткрытьГрафикРасчетов();
	
	Команда = Команды.Добавить(Параметры.Команда.Имя);
	ЗаполнитьЗначенияСвойств(Команда, Параметры.Команда,,"Имя");
		
	Кнопка = Элементы.Добавить(Параметры.Элемент.Имя, Параметры.Элемент.Тип, ГруппаЭлементов);
	ЗаполнитьЗначенияСвойств(Кнопка, Параметры.Элемент,,"Имя");
	
	ВзаиморасчетыВстраиваниеУХКлиентСервер.УстановитьВидимостьКомандыОткрытияГрафикаРасчетовДляНакладных(Форма);

КонецПроцедуры	

Процедура УничтожитьВременныеТаблицы(ТаблицыДляУничтожения, ТекстЗапроса)
		
	ТаблицыДляУничтоженияРезультат = Новый Массив;
	
	Для Каждого ИмяТаблицы Из ТаблицыДляУничтожения Цикл  
		
		Если СтрНайти(ТекстЗапроса, "ПОМЕСТИТЬ "+ИмяТаблицы) > 0 Тогда 
			
			
			ТаблицыДляУничтоженияРезультат.Добавить("УНИЧТОЖИТЬ "+ИмяТаблицы);	
			
		КонецЕсли;
		
	КонецЦикла;     
	
	Если ТаблицыДляУничтоженияРезультат.Количество() Тогда
		
		ТекстЗапроса = ТекстЗапроса+"
		|;
		|";
		
		ТекстЗапроса = ТекстЗапроса +"
		|
		|"+СтрСоединить(ТаблицыДляУничтоженияРезультат,";");
	КонецЕсли;	
	
КонецПроцедуры

Функция НовыйСтруктураПараметровЗапросаПереопределенияКурсовВалют()

	ПараметрыЗапроса = Новый Структура; 
	ПараметрыЗапроса.Вставить("ДатаНачала",Дата("00010101"));
	ПараметрыЗапроса.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	ПараметрыЗапроса.Вставить("ИспользоватьКурсыВалютыРасчетовЗаПериод", Ложь);
	Возврат ПараметрыЗапроса;

КонецФункции // НовыйСтруктураПараметровЗапросаПереопределенияКурсовВалют()

#КонецОбласти