	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентамиПоСрокам КАК РасчетыПоСрокам
	|		ПО ВтКРасчету.ЭтоРасчетыСКлиентами
	|			И ВтКРасчету.АналитикаУчетаПоПартнерам = РасчетыПоСрокам.АналитикаУчетаПоПартнерам
	|			И ВтКРасчету.ОбъектРасчетов = РасчетыПоСрокам.ОбъектРасчетов
	|			И ВтКРасчету.Валюта = РасчетыПоСрокам.Валюта
	|			И ВтКРасчету.РасчетныйДокумент = РасчетыПоСрокам.РасчетныйДокумент
	|			И ВтКРасчету.ДатаПлановогоПогашения = РасчетыПоСрокам.ДатаПлановогоПогашения
	|			И РасчетыПоСрокам.Активность
	|СГРУППИРОВАТЬ ПО
	|	ВтКРасчету.ЭтоРасчетыСКлиентами,
	|	ВтКРасчету.АналитикаУчетаПоПартнерам,
	|	ВтКРасчету.ОбъектРасчетов,
	|	ВтКРасчету.Валюта,
	|	ВтКРасчету.РасчетныйДокумент,
	|	ВтКРасчету.ДатаПлановогоПогашения,
	|	ВтКРасчету.ДатаВозникновения,
	|	ВтКРасчету.ВариантКурсаДоговора,
	|	ВтКРасчету.ПредоплатаОстаток,
	|	ВтКРасчету.ПредоплатаРеглОстаток,
	|	ВтКРасчету.ПредоплатаУпрОстаток,
	|	ВтКРасчету.ДолгРеглОстаток,
	|	ВтКРасчету.ДолгРеглОстатокРасчетный,
	|	ВтКРасчету.ДолгУпрОстаток,
	|	ВтКРасчету.ДолгУпрОстатокРасчетный"; 
	
	Возврат ИтоговыйТекстЗапроса;
	
КонецФункции

Функция ЗаменитьТекстЗапроса_ТребуетсяПереоценка(ТекстЗапросаВход, РегистрыДляРасчета) Экспорт   
	
	ТекстЗапросаЭталон = "";
	Если РегистрыДляРасчета.Свойство("РасчетыСПоставщикамиПоСрокам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыСКлиентамиПоСрокам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыСПоставщикамиПоДокументам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыСКлиентамиПоДокументам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыПоФинансовымИнструментам")
		ИЛИ РегистрыДляРасчета.Свойство("РезервыПоСомнительнымДолгам")
		ИЛИ РегистрыДляРасчета.Свойство("ПроцентныеРасходыДисконтирования") Тогда
		ТекстЗапросаЭталон = ТекстЗапросаЭталон + 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АналитикаУчетаПоПартнерам.КлючАналитики КАК КлючАналитики,
		|	АналитикаУчетаПоПартнерам.Организация КАК Организация,
		//++ НЕ УТ

		//++ Локализация
		|	ВЫБОР 
		|		КОГДА НастройкиУчетаНалогаНаПрибыль.ДатаНезависимогоПризнанияДоходовРасходов ЕСТЬ NULL
		|			ИЛИ НастройкиУчетаНалогаНаПрибыль.ДатаНезависимогоПризнанияДоходовРасходов = ДАТАВРЕМЯ(1,1,1)
		|		ТОГДА
		|			ДАТАВРЕМЯ(3000,1,1)
		|		ИНАЧЕ
		|			НастройкиУчетаНалогаНаПрибыль.ДатаНезависимогоПризнанияДоходовРасходов
		|	КОНЕЦ КАК ДатаНачалаПрименения67ФЗ,
		//-- Локализация

		//-- НЕ УТ
		|	АналитикаУчетаПоПартнерам.Организация.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета,
		|	АналитикаУчетаПоПартнерам.Договор                                    КАК Договор,
		|	ЕСТЬNULL(
		|		АналитикаУчетаПоПартнерам.Договор.ВариантКурсаДоговора, 
		|		ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.Переменный))            КАК ВариантКурсаДоговора

		|ПОМЕСТИТЬ втКлючиАналитикиПоПартнерам
		|ИЗ
		|	РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам
		//++ НЕ УТ

		//++ Локализация
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаНалогаНаПрибыль.СрезПоследних(&НаДату,) КАК НастройкиУчетаНалогаНаПрибыль
		|	ПО АналитикаУчетаПоПартнерам.Организация = НастройкиУчетаНалогаНаПрибыль.Организация
		//-- Локализация

		//-- НЕ УТ
		|ГДЕ
		|	(АналитикаУчетаПоПартнерам.Организация В (&Организация) ИЛИ &ВсеОрганизации)
		|	И (АналитикаУчетаПоПартнерам.КлючАналитики В (&АналитикаУчетаПоПартнерам) ИЛИ &ПоВсемАналитикам)
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючАналитики
		|;
		|
		|"
	КонецЕсли;
	
	ТекстЗапросаЭталон = ТекстЗапросаЭталон + 
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Период,
	|	КурсыВалютСрезПоследних.БазоваяВалюта,
	|	КурсыВалютСрезПоследних.Валюта,
	|	КурсыВалютСрезПоследних.КурсЧислитель,
	|	КурсыВалютСрезПоследних.КурсЗнаменатель
	|ПОМЕСТИТЬ втКурсы
	|ИЗ
	|	РегистрСведений.ОтносительныеКурсыВалют.СрезПоследних(&НаДату,) КАК КурсыВалютСрезПоследних"
	+"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ТекстЗапросаЭталон = ТекстЗапросаЭталон + 
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.Период,
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.Договор,
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.КурсЧислитель,
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.КурсЗнаменатель
	|ПОМЕСТИТЬ втКурсыПоДоговорам
	|ИЗ
	|	РегистрСведений.КурсыВалютРасчетовПоДоговорам.СрезПоследних(&НаДату,) КАК КурсВалютРасчетовПоДоговорамСрезПоследних"
	+" 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";    	
	
	Если ТекстЗапросаЭталон <> ТекстЗапросаВход тогда 
		ВызватьИсключение НСтр("ru = 'Документ: РасчетКурсовыхРазниц
									|Функция: ТребуетсяПереоценка
									|Ошибка: После обновления ERP изменился текст запроса'"); 
	КонецЕсли;    
	
	ИтоговыйТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор
	|ПОМЕСТИТЬ ВТ_Договоры
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.ВариантКурсаДоговораУХ = ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.УстановленныйВДоговоре)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.КурсПлатежаНеМенее <> 0
	|				И ДоговорыКонтрагентов.КурсПлатежаНеМенееВВалютеОплаты <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьКоридорВалютМинимум,
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.КурсПлатежаНеБолее <> 0
	|				И ДоговорыКонтрагентов.КурсПлатежаНеБолееВВалютеОплаты <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьКоридорВалютМаксимум,
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.КурсПлатежаНеМенееВВалютеОплаты = 0
	|			ТОГДА 1
	|		ИНАЧЕ ДоговорыКонтрагентов.КурсПлатежаНеМенее / ДоговорыКонтрагентов.КурсПлатежаНеМенееВВалютеОплаты
	|	КОНЕЦ КАК КурсПлатежаМинимум,
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.КурсПлатежаНеБолееВВалютеОплаты = 0
	|			ТОГДА 1
	|		ИНАЧЕ ДоговорыКонтрагентов.КурсПлатежаНеБолее / ДоговорыКонтрагентов.КурсПлатежаНеБолееВВалютеОплаты
	|	КОНЕЦ КАК КурсПлатежаМаксимум,
	|	ДоговорыКонтрагентов.СдвигДатыФиксацииКурсаПлатежа КАК СдвигДатыФиксацииКурсаПлатежа,
	|	ДоговорыКонтрагентов.ДатаФиксацииКурсаПлатежа КАК ДатаФиксацииКурсаПлатежа,
	|	ДоговорыКонтрагентов.ОсновнаяВалютаПлатежей КАК ВалютаПлатежей,
	|	ДоговорыКонтрагентов.Ссылка КАК Договор,
	|	ДоговорыКонтрагентов.СпособОпределенияКурсаПлатежа КАК СпособОпределенияКурсаПлатежа,
	|	ВалютаРегламентированногоУчета.Значение КАК ВалютаРегламентированногоУчета,
	|	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	|ПОМЕСТИТЬ ВТ_ИсходныеДанные
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов,
	|	Константа.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Договоры.Договор
	|			ИЗ
	|				ВТ_Договоры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&НаДату, ДЕНЬ, -ВТ_ИсходныеДанные.СдвигДатыФиксацииКурсаПлатежа), ДЕНЬ) КАК ДатаКурса,
	|	ВТ_ИсходныеДанные.Договор КАК Договор,
	|	ВЫБОР КОГДА ВТ_ИсходныеДанные.ЕстьКоридорВалютМинимум ИЛИ ВТ_ИсходныеДанные.ЕстьКоридорВалютМаксимум ТОГДА
	|		ИСТИНА
	|	ИНАЧЕ 
	|		ЛОЖЬ
	|	КОНЕЦ КАК УчитыватьКоридорВалют,
	|	ВТ_ИсходныеДанные.КурсПлатежаМинимум КАК КурсПлатежаМинимум,
	|	ВТ_ИсходныеДанные.КурсПлатежаМаксимум КАК КурсПлатежаМаксимум,
	|	ВТ_ИсходныеДанные.ЕстьКоридорВалютМинимум КАК ЕстьКоридорВалютМинимум,
	|	ВТ_ИсходныеДанные.ЕстьКоридорВалютМаксимум КАК ЕстьКоридорВалютМаксимум,
	|	0 КАК КурсЧислительВалютыДоговора,
	|	0 КАК КурсЗнаменательВалютыДоговора,
	|	ВТ_ИсходныеДанные.СпособОпределенияКурсаПлатежа КАК СпособОпределенияКурсаПлатежа,
	|	ВТ_ИсходныеДанные.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета,
	|	ВТ_ИсходныеДанные.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	|ПОМЕСТИТЬ ВТ_ДанныеДляРасчетаКурса
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|ГДЕ
	|	ВТ_ИсходныеДанные.СпособОпределенияКурсаПлатежа = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ИсходныеДанные.ДатаФиксацииКурсаПлатежа,
	|	ВТ_ИсходныеДанные.Договор,
	|	ЛОЖЬ,
	|	ВТ_ИсходныеДанные.КурсПлатежаМинимум,
	|	ВТ_ИсходныеДанные.КурсПлатежаМаксимум,
	|	ВТ_ИсходныеДанные.ЕстьКоридорВалютМинимум,
	|	ВТ_ИсходныеДанные.ЕстьКоридорВалютМаксимум,
	|	0,
	|	0,
	|	ВТ_ИсходныеДанные.СпособОпределенияКурсаПлатежа,
	|	ВТ_ИсходныеДанные.ВалютаРегламентированногоУчета,
	|	ВТ_ИсходныеДанные.ВалютаВзаиморасчетов
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|ГДЕ
	|	ВТ_ИсходныеДанные.СпособОпределенияКурсаПлатежа = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияКурсаПлатежа.КурсНаФиксированнуюДату)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КурсыВалютыРасчетов.Период,
	|	ВТ_ИсходныеДанные.Договор,
	|	ЛОЖЬ,
	|	ВТ_ИсходныеДанные.КурсПлатежаМинимум,
	|	ВТ_ИсходныеДанные.КурсПлатежаМаксимум,
	|	ВТ_ИсходныеДанные.ЕстьКоридорВалютМинимум,
	|	ВТ_ИсходныеДанные.ЕстьКоридорВалютМаксимум,
	|	ЕСТЬNULL(КурсыВалютыРасчетов.КурсЧислитель, 0),
	|	ЕСТЬNULL(КурсыВалютыРасчетов.КурсЗнаменатель, 0),
	|	ВТ_ИсходныеДанные.СпособОпределенияКурсаПлатежа,
	|	ВТ_ИсходныеДанные.ВалютаРегламентированногоУчета,
	|	ВТ_ИсходныеДанные.ВалютаВзаиморасчетов
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалютРасчетовПоДоговорам.СрезПоследних(&НаДату, ) КАК КурсыВалютыРасчетов
	|		ПО ВТ_ИсходныеДанные.Договор = КурсыВалютыРасчетов.Договор  
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(&НаДату, ) КАК ВерсииГрафиковРасчетовСрезПоследних
	|		ПО КурсыВалютыРасчетов.Договор = ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика 
	|		И КурсыВалютыРасчетов.Договор.Организация = ВерсииГрафиковРасчетовСрезПоследних.Организация 
	|ГДЕ
	| 	ВерсииГрафиковРасчетовСрезПоследних.ВерсияГрафика.СпособОпределенияКурсаПлатежа = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтносительныеКурсыВалют.Валюта КАК Валюта,
	|	ВТ_ДанныеДляРасчетаКурса.ВалютаРегламентированногоУчета КАК БазоваяВалюта,
	|	МАКСИМУМ(ОтносительныеКурсыВалют.Период) КАК Период,
	|	ВТ_ДанныеДляРасчетаКурса.Договор КАК Договор
	|ПОМЕСТИТЬ ВТ_ПериодыКурсовВалют
	|ИЗ
	|	ВТ_ДанныеДляРасчетаКурса КАК ВТ_ДанныеДляРасчетаКурса
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтносительныеКурсыВалют КАК ОтносительныеКурсыВалют
	|		ПО (ОтносительныеКурсыВалют.Период <= ВТ_ДанныеДляРасчетаКурса.ДатаКурса)
	|			И ВТ_ДанныеДляРасчетаКурса.ВалютаРегламентированногоУчета = ОтносительныеКурсыВалют.БазоваяВалюта
	|			И (ВТ_ДанныеДляРасчетаКурса.СпособОпределенияКурсаПлатежа <> ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс))
	|			И ВТ_ДанныеДляРасчетаКурса.ВалютаВзаиморасчетов = ОтносительныеКурсыВалют.Валюта

	|СГРУППИРОВАТЬ ПО
	|	ОтносительныеКурсыВалют.Валюта,
	|	ВТ_ДанныеДляРасчетаКурса.ВалютаРегламентированногоУчета,
	|	ВТ_ДанныеДляРасчетаКурса.Договор
	|;

	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПериодыКурсовВалют.Валюта КАК Валюта,
	|	ВТ_ПериодыКурсовВалют.БазоваяВалюта КАК БазоваяВалюта,
	|	ВТ_ПериодыКурсовВалют.Период КАК Период,
	|	ВТ_ПериодыКурсовВалют.Договор КАК Договор,
	|	ОтносительныеКурсыВалют.КурсЧислитель КАК КурсЧислитель,
	|	ОтносительныеКурсыВалют.КурсЗнаменатель КАК КурсЗнаменатель
	|ПОМЕСТИТЬ ВТ_КурсыВалют
	|ИЗ
	|	ВТ_ПериодыКурсовВалют КАК ВТ_ПериодыКурсовВалют
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтносительныеКурсыВалют КАК ОтносительныеКурсыВалют
	|		ПО ВТ_ПериодыКурсовВалют.Период = ОтносительныеКурсыВалют.Период
	|			И ВТ_ПериодыКурсовВалют.Валюта = ОтносительныеКурсыВалют.Валюта
	|			И ВТ_ПериодыКурсовВалют.БазоваяВалюта = ОтносительныеКурсыВалют.БазоваяВалюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеДляРасчетаКурса.Договор КАК Договор,
	|	ВТ_ДанныеДляРасчетаКурса.ДатаКурса КАК ДатаКурса,
	|	ВТ_ДанныеДляРасчетаКурса.УчитыватьКоридорВалют КАК УчитыватьКоридорВалют,
	|	ВТ_ДанныеДляРасчетаКурса.КурсПлатежаМинимум КАК КурсПлатежаМинимум,
	|	ВТ_ДанныеДляРасчетаКурса.КурсПлатежаМаксимум КАК КурсПлатежаМаксимум,
	|	ВТ_ДанныеДляРасчетаКурса.ЕстьКоридорВалютМинимум КАК ЕстьКоридорВалютМинимум,
	|	ВТ_ДанныеДляРасчетаКурса.ЕстьКоридорВалютМаксимум КАК ЕстьКоридорВалютМаксимум,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_КурсыВалют.КурсЧислитель, ВТ_ДанныеДляРасчетаКурса.КурсЧислительВалютыДоговора) = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ВТ_КурсыВалют.КурсЧислитель, ВТ_ДанныеДляРасчетаКурса.КурсЧислительВалютыДоговора)
	|	КОНЕЦ КАК КурсЧислительВалютыДоговора,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_КурсыВалют.КурсЗнаменатель, ВТ_ДанныеДляРасчетаКурса.КурсЗнаменательВалютыДоговора) = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ВТ_КурсыВалют.КурсЗнаменатель, ВТ_ДанныеДляРасчетаКурса.КурсЗнаменательВалютыДоговора)
	|	КОНЕЦ КАК КурсЗнаменательВалютыДоговора
	|ПОМЕСТИТЬ ВТ_ОбъектыРасчетовСКурсами
	|ИЗ
	|	ВТ_ДанныеДляРасчетаКурса КАК ВТ_ДанныеДляРасчетаКурса
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КурсыВалют КАК ВТ_КурсыВалют
	|		ПО (ВТ_КурсыВалют.Договор = ВТ_ДанныеДляРасчетаКурса.Договор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОбъектыРасчетовСКурсами.Договор КАК Договор,
	|	ВТ_ОбъектыРасчетовСКурсами.ДатаКурса КАК ДатаКурса,
	|	ВТ_ОбъектыРасчетовСКурсами.УчитыватьКоридорВалют КАК УчитыватьКоридорВалют,
	|	ВЫБОР
	|		КОГДА ВТ_ОбъектыРасчетовСКурсами.УчитыватьКоридорВалют
	|			ТОГДА ВЫБОР
	|					КОГДА ВТ_ОбъектыРасчетовСКурсами.ЕстьКоридорВалютМинимум
	|							И ВТ_ОбъектыРасчетовСКурсами.КурсЧислительВалютыДоговора / ВТ_ОбъектыРасчетовСКурсами.КурсЗнаменательВалютыДоговора < ВТ_ОбъектыРасчетовСКурсами.КурсПлатежаМинимум
	|						ТОГДА ВТ_ОбъектыРасчетовСКурсами.КурсПлатежаМинимум
	|					КОГДА ВТ_ОбъектыРасчетовСКурсами.ЕстьКоридорВалютМаксимум
	|							И ВТ_ОбъектыРасчетовСКурсами.КурсЧислительВалютыДоговора / ВТ_ОбъектыРасчетовСКурсами.КурсЗнаменательВалютыДоговора > ВТ_ОбъектыРасчетовСКурсами.КурсПлатежаМаксимум
	|						ТОГДА ВТ_ОбъектыРасчетовСКурсами.КурсПлатежаМаксимум
	|					ИНАЧЕ ВТ_ОбъектыРасчетовСКурсами.КурсЧислительВалютыДоговора
	|				КОНЕЦ
	|		ИНАЧЕ ВТ_ОбъектыРасчетовСКурсами.КурсЧислительВалютыДоговора
	|	КОНЕЦ КАК КурсЧислительВалютыДоговора,
	|	ВЫБОР
	|		КОГДА ВТ_ОбъектыРасчетовСКурсами.УчитыватьКоридорВалют
	|			ТОГДА 1
	|		ИНАЧЕ ВТ_ОбъектыРасчетовСКурсами.КурсЗнаменательВалютыДоговора
	|	КОНЕЦ КАК КурсЗнаменательВалютыДоговора
	|ПОМЕСТИТЬ ВТ_ОбъектыРасчетовСКурсамиСУчетомКоридора
	|ИЗ
	|	ВТ_ОбъектыРасчетовСКурсами КАК ВТ_ОбъектыРасчетовСКурсами";  
	
	
	ИтоговыйТекстЗапроса = ИтоговыйТекстЗапроса+ ОбщегоНазначения.РазделительПакетаЗапросов();
	
	Если РегистрыДляРасчета.Свойство("РасчетыСПоставщикамиПоСрокам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыСКлиентамиПоСрокам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыСПоставщикамиПоДокументам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыСКлиентамиПоДокументам")
		ИЛИ РегистрыДляРасчета.Свойство("РасчетыПоФинансовымИнструментам")
		ИЛИ РегистрыДляРасчета.Свойство("РезервыПоСомнительнымДолгам")
		ИЛИ РегистрыДляРасчета.Свойство("ПроцентныеРасходыДисконтирования") Тогда
 		ИтоговыйТекстЗапроса = ИтоговыйТекстЗапроса +  
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АналитикаУчетаПоПартнерам.КлючАналитики КАК КлючАналитики,
		|	АналитикаУчетаПоПартнерам.Организация КАК Организация,
		//++ НЕ УТ

		//++ Локализация
		|	ВЫБОР 
		|		КОГДА НастройкиУчетаНалогаНаПрибыль.ДатаНезависимогоПризнанияДоходовРасходов ЕСТЬ NULL
		|			ИЛИ НастройкиУчетаНалогаНаПрибыль.ДатаНезависимогоПризнанияДоходовРасходов = ДАТАВРЕМЯ(1,1,1)
		|		ТОГДА
		|			ДАТАВРЕМЯ(3000,1,1)
		|		ИНАЧЕ
		|			НастройкиУчетаНалогаНаПрибыль.ДатаНезависимогоПризнанияДоходовРасходов
		|	КОНЕЦ КАК ДатаНачалаПрименения67ФЗ,
		//-- Локализация

		//-- НЕ УТ
		|	АналитикаУчетаПоПартнерам.Организация.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета,
		|	АналитикаУчетаПоПартнерам.Договор                                    КАК Договор,
		|	ЕСТЬNULL(
		|		АналитикаУчетаПоПартнерам.Договор.ВариантКурсаДоговора, 
		|		ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.Переменный))            КАК ВариантКурсаДоговора

		|ПОМЕСТИТЬ втКлючиАналитикиПоПартнерам
		|ИЗ
		|	РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам
		//++ НЕ УТ

		//++ Локализация
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаНалогаНаПрибыль.СрезПоследних(&НаДату,) КАК НастройкиУчетаНалогаНаПрибыль
		|	ПО АналитикаУчетаПоПартнерам.Организация = НастройкиУчетаНалогаНаПрибыль.Организация
		//-- Локализация

		//-- НЕ УТ
		|ГДЕ
		|	(АналитикаУчетаПоПартнерам.Организация В (&Организация) ИЛИ &ВсеОрганизации)
		|	И (АналитикаУчетаПоПартнерам.КлючАналитики В (&АналитикаУчетаПоПартнерам) ИЛИ &ПоВсемАналитикам)
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючАналитики
		|;
		|
		|"
	КонецЕсли;
	
 	ИтоговыйТекстЗапроса = ИтоговыйТекстЗапроса +  
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Период,
	|	КурсыВалютСрезПоследних.БазоваяВалюта,
	|	КурсыВалютСрезПоследних.Валюта,
	|	КурсыВалютСрезПоследних.КурсЧислитель,
	|	КурсыВалютСрезПоследних.КурсЗнаменатель
	|ПОМЕСТИТЬ втКурсы
	|ИЗ
	|	РегистрСведений.ОтносительныеКурсыВалют.СрезПоследних(&НаДату,) КАК КурсыВалютСрезПоследних"
	+"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
 	ИтоговыйТекстЗапроса = ИтоговыйТекстЗапроса +  
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.ДатаКурса,
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.Договор,
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.КурсЧислительВалютыДоговора КАК КурсЧислитель,
	|	КурсВалютРасчетовПоДоговорамСрезПоследних.КурсЗнаменательВалютыДоговора КАК КурсЗнаменатель
	|ПОМЕСТИТЬ втКурсыПоДоговорам
	|ИЗ
	|	ВТ_ОбъектыРасчетовСКурсамиСУчетомКоридора КАК КурсВалютРасчетовПоДоговорамСрезПоследних"
	+" 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";    	
	
	Возврат ИтоговыйТекстЗапроса;
	
КонецФункции

Функция ЗаменитьТекстЗапроса_ТекстЗапросаВременнаяТаблицаЗадолженность(ТекстЗапросаВход)Экспорт
	//Доработать запрос	  
	//Момент времени в полях запроса использовать нельзя
	Возврат ТекстЗапросаВход;
	
	ТекстЗапросаЭталон =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектыРасчетов.Ссылка                                       КАК ОбъектРасчетов,
	|	ВЫБОР КОГДА ОбъектыРасчетов.ТипОбъектаРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектовРасчетов.Накладная)
	|				И ЕСТЬNULL(ОбъектыРасчетов.Договор.ВариантКурсаДоговора, ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.Переменный))
	|					= ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.ФиксированныйНаДатуОтгрузки)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.ФиксированныйНаДатуОтгрузки)
	|		ИНАЧЕ ЕСТЬNULL(ОбъектыРасчетов.Договор.ВариантКурсаДоговора, ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.Переменный))
	|	КОНЕЦ                                                        КАК ВариантКурсаДоговора,
	|	Задолженность.ВалютаВзаиморасчетов                           КАК ВалютаВзаиморасчетов,
	|	ОбъектыРасчетов.Объект                                       КАК Объект,
	|	ОбъектыРасчетов.Организация                                  КАК Организация,
	|	ОбъектыРасчетов.Партнер                                      КАК Партнер,
	|	ОбъектыРасчетов.Контрагент                                   КАК Контрагент,
	|	ОбъектыРасчетов.Договор                                      КАК Договор,
	|	ОбъектыРасчетов.ТипРасчетов                                  КАК ТипРасчетов,
	|	ОбъектыРасчетов.НаправлениеДеятельности                      КАК НаправлениеДеятельности,
	|	ОбъектыРасчетов.НалогообложениеНДС                           КАК НалогообложениеНДС,
	|	ОбъектыРасчетов.Подразделение                                КАК Подразделение,
	|	ОбъектыРасчетов.УникальныйИдентификатор                      КАК УникальныйИдентификатор,
	|	ЕСТЬNULL(ОбъектыРасчетов.НаправлениеДеятельности.УчетДоходов, ЛОЖЬ)               КАК УчетДоходов,
	|	ЕСТЬNULL(ОбъектыРасчетов.НаправлениеДеятельности.УчетРасчетовСПоставщиками, ЛОЖЬ) КАК УчетРасчетовСПоставщиками
	|ПОМЕСТИТЬ ДанныеОбъектаРасчетов
	|ИЗ
	|	Документ.КорректировкаЗадолженности.Задолженность КАК Задолженность
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|		ПО Задолженность.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
	|ГДЕ
	|	Задолженность.Ссылка = &Ссылка
	|ИНДЕКСИРОВАТЬ ПО
	|	ВариантКурсаДоговора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ОбъектРасчетов                                      КАК ОбъектРасчетов,
	|	ВложенныйЗапрос.ВалютаВзаиморасчетов                                КАК ВалютаВзаиморасчетов,
	|	МАКСИМУМ(ВложенныйЗапрос.КурсЧислительВалютыВзаиморасчетов)         КАК КурсЧислительВалютыВзаиморасчетов,
	|	МАКСИМУМ(ВложенныйЗапрос.КурсЗнаменательВалютыВзаиморасчетов)       КАК КурсЗнаменательВалютыВзаиморасчетов,
	|	МАКСИМУМ(ВложенныйЗапрос.КурсЧислительВалютыУправленческогоУчета)   КАК КурсЧислительВалютыУправленческогоУчета,
	|	МАКСИМУМ(ВложенныйЗапрос.КурсЗнаменательВалютыУправленческогоУчета) КАК КурсЗнаменательВалютыУправленческогоУчета
	|ПОМЕСТИТЬ КурсыВалют
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеОбъектаРасчетов.ОбъектРасчетов                             КАК ОбъектРасчетов,
	|		ДанныеОбъектаРасчетов.ВалютаВзаиморасчетов                       КАК ВалютаВзаиморасчетов,
	|		КурсыИВалютыДокументов.КурсЧислительВалютыВзаиморасчетов         КАК КурсЧислительВалютыВзаиморасчетов,
	|		КурсыИВалютыДокументов.КурсЗнаменательВалютыВзаиморасчетов       КАК КурсЗнаменательВалютыВзаиморасчетов,
	|		КурсыИВалютыДокументов.КурсЧислительВалютыУправленческогоУчета   КАК КурсЧислительВалютыУправленческогоУчета,
	|		КурсыИВалютыДокументов.КурсЗнаменательВалютыУправленческогоУчета КАК КурсЗнаменательВалютыУправленческогоУчета
	|	
	|	ИЗ
	|		РегистрСведений.ВалютыИКурсыДокументов КАК КурсыИВалютыДокументов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеОбъектаРасчетов КАК ДанныеОбъектаРасчетов
	|				ПО ДанныеОбъектаРасчетов.Объект = КурсыИВалютыДокументов.Документ
	|					И ДанныеОбъектаРасчетов.ВариантКурсаДоговора = ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.ФиксированныйНаДатуОтгрузки)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеОбъектаРасчетов.ОбъектРасчетов                                КАК ОбъектРасчетов,
	|		ДанныеОбъектаРасчетов.ВалютаВзаиморасчетов                          КАК ВалютаВзаиморасчетов,
	|		КурсыВалютРасчетовПоДоговорамСрезПоследних.КурсЧислитель            КАК КурсЧислительВалютыВзаиморасчетов,
	|		КурсыВалютРасчетовПоДоговорамСрезПоследних.КурсЗнаменатель          КАК КурсЗнаменательВалютыВзаиморасчетов,
	|		0                                                                   КАК КурсЧислительВалютыУправленческогоУчета,
	|		0                                                                   КАК КурсЗнаменательВалютыУправленческогоУчета
	|	ИЗ
	|		РегистрСведений.КурсыВалютРасчетовПоДоговорам.СрезПоследних(&МоментВремени, Договор В (ВЫБРАТЬ Договор ИЗ ДанныеОбъектаРасчетов)) КАК КурсыВалютРасчетовПоДоговорамСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеОбъектаРасчетов КАК ДанныеОбъектаРасчетов
	|				ПО ДанныеОбъектаРасчетов.Договор = КурсыВалютРасчетовПоДоговорамСрезПоследних.Договор
	|					И ДанныеОбъектаРасчетов.ВариантКурсаДоговора = ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.УстановленныйВДоговоре)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеОбъектаРасчетов.ОбъектРасчетов                                КАК ОбъектРасчетов,
	|		ДанныеОбъектаРасчетов.ВалютаВзаиморасчетов                          КАК ВалютаВзаиморасчетов,
	|		0                                                                   КАК КурсЧислительВалютыВзаиморасчетов,
	|		0                                                                   КАК КурсЗнаменательВалютыВзаиморасчетов,
	|		КурсыВалютРасчетовПоДоговорамСрезПоследних.КурсЧислитель            КАК КурсЧислительВалютыУправленческогоУчета,
	|		КурсыВалютРасчетовПоДоговорамСрезПоследних.КурсЗнаменатель          КАК КурсЗнаменательВалютыУправленческогоУчета
	|	ИЗ
	|		РегистрСведений.КурсыВалютРасчетовПоДоговорам.СрезПоследних(&МоментВремени, Договор В (ВЫБРАТЬ Договор ИЗ ДанныеОбъектаРасчетов)) КАК КурсыВалютРасчетовПоДоговорамСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеОбъектаРасчетов КАК ДанныеОбъектаРасчетов
