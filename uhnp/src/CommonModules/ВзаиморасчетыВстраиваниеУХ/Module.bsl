	ИтоговыйТекстЗапроса = ИтоговыйТекстЗапроса+ ОбщегоНазначения.РазделительПакетаЗапросов();
	
 	ИтоговыйТекстЗапроса = ИтоговыйТекстЗапроса +  	
	"ВЫБРАТЬ
	|	ОсновныеПараметрыРасчета.ТипРасчетов КАК ТипРасчетов,
