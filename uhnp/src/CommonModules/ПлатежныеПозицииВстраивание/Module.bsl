// Процедура выполняет действия при изменении организации документа-заявки.
//   1 - Замена организации в 1-й позиции
//   2 - Очистка реквизита БанковскийСчетКасса
Процедура УстановитьПлатежнуюВедомость(Форма) Экспорт
	
	Объект = Форма.Объект;
	РеквизитыЗаявки = Форма.РеквизитыДокумента;
	
	ПлатежнаяВедомость = ЗаявкиНаОперации.РеквизитЗаявки(Объект, РеквизитыЗаявки.ПлатежнаяВедомость);

	РеквизитыКУстановке = Новый Структура;
	РеквизитыКУстановке.Вставить("ПлатежнаяВедомость",ПлатежнаяВедомость);
	
	Операции = ПлатежныеПозицииКлиентСервер.ОперацииПлатежнойПозиции(Форма);
	
	Для Каждого П1 Из Операции.Основная Цикл
		ЗаполнитьЗначенияСвойств(П1, РеквизитыКУстановке);
	КонецЦикла;
	
	Для Каждого П2 Из Операции.Встречная Цикл
		ЗаполнитьЗначенияСвойств(П2, РеквизитыКУстановке);
	КонецЦикла;

КонецПроцедуры

