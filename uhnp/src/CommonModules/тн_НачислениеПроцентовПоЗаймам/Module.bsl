
// Климов Антон 10.11.2022 Выполнение задач №000043309
//
// Пересчитывает график начисления процентов и сумму процентов в графике платежей в зависимости от суммы погашения/выдачи основного долга
// и записывает график в текущую версию соглашения.                                                                   
// Используются движения по РН "Расчет по финансовым инструментам" документов ПоступлениеБезналичныхДенежныхСредств и СписаниеБезналичныхДенежныхСредств
Процедура тн_РасчетПоФинансовымИнструментамПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Регистратор = Источник.Отбор.Регистратор.Значение;
	ЭтоПоступлениеСписаниеБДС = (ТипЗнч(Регистратор) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") 
	// НАЧАЛО Белышев Игорь 11.01.2023 Выполнение задач №000043956 
	Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
	Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
	// КОНЕЦ Белышев Игорь 11.01.2023 Выполнение задач №000043956
	Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств"));
	Если ЭтоПоступлениеСписаниеБДС Тогда
		Если Регистратор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаЗаймов
			// НАЧАЛО Белышев Игорь 11.01.2023 Выполнение задач №000043956 
			Или Регистратор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствПоКредитам 
			Или Регистратор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоКредитам 
			// КОНЕЦ Белышев Игорь 11.01.2023 Выполнение задач №000043956
			Или Регистратор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствПоЗаймамВыданным Тогда
			
			РасшифровкаПлатежа = Регистратор.РасшифровкаПлатежа;
			// НАЧАЛО Борисенко Игорь 05.03.2024 Выполнение задач №000048730
			//Если НЕ РасшифровкаПлатежа.Количество() Тогда
			Если РасшифровкаПлатежа.Количество() = 0 Тогда
			// КОНЕЦ Борисенко Игорь 05.03.2024 Выполнение задач №000048730
				Возврат;
			КонецЕсли;
			// НАЧАЛО Борисенко Игорь 05.03.2024 Выполнение задач №000048730
			Если Не ЗначениеЗаполнено(РасшифровкаПлатежа[0].ДоговорКредитаДепозита) Тогда
				Возврат;
			КонецЕсли;
			// КОНЕЦ Борисенко Игорь 05.03.2024 Выполнение задач №000048730
			ВерсияСоглашенияСсылка = РасшифровкаПлатежа[0].ДоговорКредитаДепозита.ВерсияСоглашения;
			// НАЧАЛО Борисенко Игорь 05.03.2024 Выполнение задач №000048730
			Если Не ОбщегоНазначения.СсылкаСуществует(ВерсияСоглашенияСсылка) Тогда
				Возврат;
			КонецЕсли;
			// КОНЕЦ Борисенко Игорь 05.03.2024 Выполнение задач №000048730
			ВерсияСоглашенияОбъект = ВерсияСоглашенияСсылка.ПолучитьОбъект();
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВерсияСоглашенияСсылка.Метаданные().ПолноеИмя());
			ОписаниеГрафика = МенеджерОбъекта.ОписаниеГрафика(ВерсияСоглашенияСсылка.ДоговорКонтрагента.ВидДоговораУХ);
			ОперацииГрафика = РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафика, ВерсияСоглашенияОбъект);
			ОбъектРасчетов = ВерсияСоглашенияОбъект.ДоговорКонтрагента;
			
			// НАЧАЛО Белоконенко Денис 17.04.2023 Выполнение задач №000043956
			//ТаблицаФакт = ПолучитьТаблицуФакт(ВерсияСоглашенияСсылка, Регистратор.Дата); 
			ДатаОкончанияДействия = ВерсияСоглашенияСсылка.ДатаОкончанияДействия;
			Если ЗначениеЗаполнено(ДатаОкончанияДействия) Тогда
				ДатаПолученияФакта = ДатаОкончанияДействия;
			Иначе
				ДатаПолученияФакта = Дата(3999, 1, 1); // все данные	
			КонецЕсли;
			ТаблицаФакт = ПолучитьТаблицуФакт(ВерсияСоглашенияСсылка, ДатаПолученияФакта);
			// КОНЕЦ Белоконенко Денис 17.04.2023 Выполнение задач №000043956
			ВерсияСоглашенияОбъект.ГрафикРасчетов.Очистить();
			ВерсияСоглашенияОбъект.Проценты.Очистить();
			СуммаОстаткаОбязательств = ВерсияСоглашенияОбъект.Сумма;
			РабочаяТаблицаГрафика = ВерсияСоглашенияОбъект.ГрафикРасчетов;
			// НАЧАЛО Белышев Игорь 11.01.2023 Выполнение задач №000043956 
			//ОперацияПриход = ОперацииГрафика[ОписаниеГрафика["ОсновнойДолг"].КолонкаПриходОперация];
			//РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(РабочаяТаблицаГрафика, СуммаОстаткаОбязательств, ВерсияСоглашенияОбъект.ДатаНачалаДействия,,ОперацияПриход);
			// КОНЕЦ Белышев Игорь 11.01.2023 Выполнение задач №000043956 
			Для Каждого СтрокаФакт Из ТаблицаФакт Цикл
				// НАЧАЛО Климов Антон 07.09.2023 Выполнение задач №000046779
				//РабочаяТаблицаГрафика = ВерсияСоглашенияОбъект.ГрафикРасчетов;
				//Если СтрокаФакт.КолонкаСекции = Перечисления.ВидыДвиженийПриходРасход.Расход Тогда
				//	ОперацияРасход = ОперацииГрафика[ОписаниеГрафика["ОсновнойДолг"].КолонкаРасходОперация];
				//	РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(РабочаяТаблицаГрафика, СтрокаФакт.Сумма,	СтрокаФакт.Дата,,ОперацияРасход); 
				//	СуммаОстаткаОбязательств = СуммаОстаткаОбязательств - СтрокаФакт.Сумма;
				//ИначеЕсли СтрокаФакт.КолонкаСекции = Перечисления.ВидыДвиженийПриходРасход.Приход Тогда
				//	ОперацияПриход = ОперацииГрафика[ОписаниеГрафика["ОсновнойДолг"].КолонкаПриходОперация];
				//	РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(РабочаяТаблицаГрафика, СтрокаФакт.Сумма,	СтрокаФакт.Дата,,ОперацияПриход);
				//	СуммаостаткаОбязательств = СуммаОстаткаОбязательств + СтрокаФакт.Сумма;
				//КонецЕсли;
				Операция = ОперацииГрафика[ОписаниеГрафика["ОсновнойДолг"]["Колонка"+СтрокаФакт.КолонкаСекции+"Операция"]];
				РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(РабочаяТаблицаГрафика, СтрокаФакт.Сумма,	СтрокаФакт.Дата,,Операция); 
				СуммаОстаткаОбязательств = СуммаОстаткаОбязательств - СтрокаФакт.Сумма;
				// КОНЕЦ  Климов Антон 07.09.2023 Выполнение задач №000046779
			КонецЦикла;
			// НАЧАЛО Белышев Игорь 11.01.2023 Выполнение задач №000043956 
			//ОперацияРасход = ОперацииГрафика[ОписаниеГрафика["ОсновнойДолг"].КолонкаРасходОперация];
			//РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(РабочаяТаблицаГрафика, СуммаОстаткаОбязательств,	ВерсияСоглашенияОбъект.ДатаОкончанияДействия,,ОперацияРасход);
			// КОНЕЦ Белышев Игорь 11.01.2023 Выполнение задач №000043956 
			
			ПересчитатьГрафик(ВерсияСоглашенияОбъект, ОписаниеГрафика, ОперацииГрафика, Отказ); 
			ВерсияСоглашенияОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Климов Антон 10.11.2022 Выполнение задач №000043309
Функция ПолучитьТаблицуФакт(ОбъектРасчетов, Дата) Экспорт

	Если Не ЗначениеЗаполнено(ОбъектРасчетов) Тогда		
		ТаблицаФакт = Новый ТаблицаЗначений;
		Возврат ТаблицаФакт;		
	КонецЕсли;
	
	ТаблицаФакт = ПолучитьФактРасчетыПоДоговору(ОбъектРасчетов, Дата); 
	Возврат ТаблицаФакт;

КонецФункции

// Климов Антон 10.11.2022 Выполнение задач №000043309
Функция ТаблицаОписанияГрафика(ОписаниеГрафика, ОперацииГрафика)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяСекции", 						Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(200))); // ОсновнойДолгПолучение, ОсновнойДолгВозврат
	Таблица.Колонки.Добавить("КолонкаСекции", 					Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход")); // Приход, Расход
	Таблица.Колонки.Добавить("ЭлементСтруктурыЗадолженности", 	Новый ОписаниеТипов("ПеречислениеСсылка.ЭлементыСтруктурыЗадолженности")); // ОсновнойДолг
	Таблица.Колонки.Добавить("Операция", 						Новый ОписаниеТипов("СправочникСсылка.ОперацииГрафиковДоговоров"));
	Таблица.Колонки.Добавить("ВидБюджета", 						Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыБюджетов"));
	Таблица.Колонки.Добавить("НаправлениеВзаиморасчетов", 		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход")); // вид движения в регистр РасчетыСКонтрагентамиГрафики
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("КолонкаПриход");
	МассивКолонок.Добавить("КолонкаРасход");
	
	Для каждого СекцияГрафика Из ОписаниеГрафика Цикл
		
		ПараметрыСекции = СекцияГрафика.Значение;
		Для каждого ИмяКолонки Из МассивКолонок Цикл
			
			Операция = ПараметрыСекции[ИмяКолонки + "Операция"];
			ПараметрыОперации = ОперацииГрафика.Получить(Операция);
			
			Строка = Таблица.Добавить();
			Строка.ИмяСекции 						= ПараметрыСекции[ИмяКолонки]; // ОсновнойДолгПолучение
			Строка.ЭлементСтруктурыЗадолженности 	= ПараметрыСекции.ЭлементСтруктурыЗадолженности; // ОсновнойДолг
			Строка.Операция 						= Операция; // КредитПолученный_ОсновнойДолгПолучение		 
			Строка.КолонкаСекции 					= ПараметрыОперации.КолонкаСекции; // Приход
			Строка.НаправлениеВзаиморасчетов 		= ПараметрыОперации.НаправлениеВзаиморасчетов; // Расход - рост задолженности
			Строка.ВидБюджета 						= ПараметрыОперации.ВидБюджета;	 
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Климов Антон 10.11.2022 Выполнение задач №000043309
Процедура ПересчитатьГрафик(ВерсияСоглашенияОбъект, ОписаниеГрафика, ОперацииГрафика, Отказ)
	
	СтруктураДействий = Новый Структура;                    
	МассивСекций = Новый Массив;
	МассивСекций.Добавить("Проценты");
	СекцииГрафика = Новый Структура;
	СекцииГрафика.Вставить("СекцииГрафика", МассивСекций);
	СтруктураДействий.Вставить("Пересчитать", СекцииГрафика);
	ФинансовыеИнструментыУХ.ПересчетГрафика(ВерсияСоглашенияОбъект,0,ОписаниеГрафика, ОперацииГрафика, СтруктураДействий, Отказ);
	
КонецПроцедуры

// Климов Антон 10.11.2022 Выполнение задач №000043309
Функция ПолучитьФактРасчетыПоДоговору(ВерсияСоглашения, Дата)

	Запрос = Новый Запрос;
	// НАЧАЛО Климов Антон 07.09.2023 Выполнение задач №000046779
	//Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//               |	ВЫБОР
	//               |		КОГДА РасчетыПоФинансовымИнструментамОбороты.СуммаОборот < 0
	//               |			ТОГДА -РасчетыПоФинансовымИнструментамОбороты.СуммаОборот
	//               |		ИНАЧЕ РасчетыПоФинансовымИнструментамОбороты.СуммаОборот
	//               |	КОНЕЦ КАК Сумма,
	//               |	НАЧАЛОПЕРИОДА(РасчетыПоФинансовымИнструментамОбороты.Период, ДЕНЬ) КАК Дата,
	//               |	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг) КАК ЭлементСтруктурыЗадолженности,
	//               |	ВЫБОР
	//               |		КОГДА РасчетыПоФинансовымИнструментамОбороты.СуммаОборот > 0
	//			   // НАЧАЛО Белышев Игорь 11.01.2023 Выполнение задач №000043956 
	//			   //|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	//			   //|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	//			   |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	//			   |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	//			   // НАЧАЛО Белышев Игорь 11.01.2023 Выполнение задач №000043956 
	//               |	КОНЕЦ КАК КолонкаСекции
	//               |ИЗ
	//               |	РегистрНакопления.РасчетыПоФинансовымИнструментам.Обороты(&НачалоПериода, &ОкончаниеПериода, Регистратор, Договор = &Договор) КАК РасчетыПоФинансовымИнструментамОбороты
	//               |ГДЕ
	//               |	РасчетыПоФинансовымИнструментамОбороты.ТипСуммы = &ТипСуммы
	//               |	И РасчетыПоФинансовымИнструментамОбороты.СуммаОборот <> 0";
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА РасчетыПоФинансовымИнструментамОбороты.СуммаОборот < 0
	|			ТОГДА -РасчетыПоФинансовымИнструментамОбороты.СуммаОборот
	|		ИНАЧЕ РасчетыПоФинансовымИнструментамОбороты.СуммаОборот
	|	КОНЕЦ КАК Сумма,
	|	НАЧАЛОПЕРИОДА(РасчетыПоФинансовымИнструментамОбороты.Период, ДЕНЬ) КАК Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг) КАК ЭлементСтруктурыЗадолженности,
	|	РасчетыПоФинансовымИнструментамОбороты.Регистратор КАК Регистратор,
	|	РасчетыПоФинансовымИнструментамОбороты.Договор.ВидДоговораУХ КАК ДоговорВидДоговораУХ,
	|	ВЫБОР
	|		КОГДА РасчетыПоФинансовымИнструментамОбороты.Договор.ВидДоговораУХ = ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.ЗаемВыданный)
	|			ТОГДА ВЫБОР
	|					КОГДА РасчетыПоФинансовымИнструментамОбороты.СуммаОборот > 0
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|				КОНЕЦ
	|		КОГДА РасчетыПоФинансовымИнструментамОбороты.Договор.ВидДоговораУХ = ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.ЗаемПолученный)
	|				ИЛИ РасчетыПоФинансовымИнструментамОбороты.Договор.ВидДоговораУХ = ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.Кредит)
	|			ТОГДА ВЫБОР
	|					КОГДА РасчетыПоФинансовымИнструментамОбороты.СуммаОборот < 0
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|				КОНЕЦ
	|	КОНЕЦ КАК КолонкаСекции
	|ИЗ
