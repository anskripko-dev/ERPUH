#Область ПрограммныйИнтерфейс

// Обработка заполнения (общая) для документов цессии
//
// Параметры:
//  Объект			 - ДокументОбъект	 - объект заполнения
//  ДанныеЗаполнения - Структура	 - данные для заполнения
//
Процедура ОбработкаЗаполнения(Объект, ДанныеЗаполнения = Неопределено) Экспорт

	Если ДанныеЗаполнения <> Неопределено
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект, ДанныеЗаполнения);
		Если ДанныеЗаполнения.Свойство("ИсходныйДокумент") Тогда
             Объект.ТекущаяЗадолженность.Загрузить(ДанныеЗаполнения.ИсходныйДокумент.ТекущаяЗадолженность.Выгрузить());
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("ИсходныйДоговор") Тогда
			ВстречныйДоговор = ДоговорыКонтрагентовФормыУХВызовСервера.ПолучитьВстречныйДоговор(ДанныеЗаполнения.ИсходныйДоговор);
			Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЦессияДолжника") Тогда
				Объект.ДоговорСЦессионарием = ВстречныйДоговор;	 
				Объект.ДоговорСЦедентом = ДоговорЦедента(Объект.Цедент,Объект.Организация); 
			Иначе
				Объект.ДоговорЦессии	= ВстречныйДоговор;
			КонецЕсли;
		КонецЕсли;	
		 
	КонецЕсли;

	Объект.Дата 			= ТекущаяДатаСеанса();
	Объект.Ответственный 	= Пользователи.ТекущийПользователь();  
	Объект.ВидОбязательства	= Перечисления.ВидыОбязательств.ЗадолженностьПоДоговоруКуплиПродажи;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "СтавкаНДС") Тогда
// УХ_встраивание ++
		// Объект.СтавкаНДС 	=  УчетНДСКлиентСервер.СтавкаНДСПоУмолчанию(Объект.Дата, Истина);
		Объект.СтавкаНДС 	=  УчетНДСУП.СтавкаНДСПоУмолчанию(Объект.Организация, Объект.Дата, Истина);
// УХ_встраивание --		
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
	
		Объект.ВалютаДокумента = ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуУправленческогоУчета();
	
	КонецЕсли;	
	
КонецПроцедуры

// Возвращает сумму обязательств должника
//
// Параметры:
//  Организация			 - СправочникОрганизации - организация
//  Контрагент			 - СправочникКонтрагенты - контрагент
//  ДоговорКонтрагента	 - СправочникДоговоровКонтрагентов - договор контрагента
// 
// Возвращаемое значение:
//  Массив - массив структур с задолженностями 
//
Функция СуммаОбязательстваДолжника(Организация, Контрагент, ДоговорКонтрагента, ВидОбязательства) Экспорт
	
	ПорядокРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента, "ПорядокРасчетов");
	
	Запрос 			= Новый Запрос;                                                                    
	Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов 
		ИЛИ ВидОбязательства = Перечисления.ВидыОбязательств.ЗадолженностьПоДоговоруЗайма Тогда
		Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	СУММА(РасчетыСКонтрагентамиФактОстатки.СуммаОстаток) КАК Сумма,
		|	РасчетыСКонтрагентамиФактОстатки.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности,
		|	РасчетыСКонтрагентамиФактОстатки.ОбъектРасчетов КАК ОбъектРасчетов
		|ИЗ
		|	РегистрНакопления.РасчетыСКонтрагентамиФакт.Остатки(
		|			,
		|			Контрагент = &Контрагент
		|				И ДоговорКонтрагента = &ДоговорКонтрагента
		|				И Организация = &Организация) КАК РасчетыСКонтрагентамиФактОстатки
		|ГДЕ
		|	РасчетыСКонтрагентамиФактОстатки.СуммаОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКонтрагентамиФактОстатки.ЭлементСтруктурыЗадолженности,
		|	РасчетыСКонтрагентамиФактОстатки.ОбъектРасчетов";
	Иначе
	  	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	СУММА(РасчетыСКлиентамиОстатки.СуммаОстаток) КАК Сумма,
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг) КАК ЭлементСтруктурыЗадолженности,
		|	РасчетыСКлиентамиОстатки.ОбъектРасчетов.Объект КАК ОбъектРасчетов
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами.Остатки(
		|			,
		|			АналитикаУчетаПоПартнерам.Организация = &Организация
		|				И АналитикаУчетаПоПартнерам.Контрагент = &Контрагент
		|				И АналитикаУчетаПоПартнерам.Договор = &ДоговорКонтрагента) КАК РасчетыСКлиентамиОстатки
		|ГДЕ
		|	РасчетыСКлиентамиОстатки.СуммаОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКлиентамиОстатки.ОбъектРасчетов";

	КонецЕсли;
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Контрагент", 		Контрагент); 
	Запрос.УстановитьПараметр("Организация", 		Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса.Выгрузить());

КонецФункции

// Возвращает массив кредиторской задолженности по договору 
//
// Параметры:
//  Организация			 - СправочникОрганизации	 - организация отбора
//  Контрагент			 - СправочникКонтрагенты	 - контрагент 
//  ДоговорКонтрагента	 - СправочникДоговорыКонтрагентов - договор контрагента
// 
// Возвращаемое значение:
//  Массив - массив структур с объектами задолженности и суммой
//
Функция МассивКредиторскойЗадолженности(Организация, Контрагент, ДоговорКонтрагента) Экспорт
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	СУММА(РасчетыСКонтрагентамиФактОстатки.СуммаОстаток)*-1 КАК Сумма,
		|	РасчетыСКонтрагентамиФактОстатки.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности
		|ИЗ
		|	РегистрНакопления.РасчетыСКонтрагентамиФакт.Остатки(
		|			,
		|			Контрагент = &Контрагент
		|				И ДоговорКонтрагента = &ДоговорКонтрагента
		|				И Организация = &Организация) КАК РасчетыСКонтрагентамиФактОстатки
		|ГДЕ
		|	РасчетыСКонтрагентамиФактОстатки.СуммаОстаток < 0
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКонтрагентамиФактОстатки.ЭлементСтруктурыЗадолженности";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Контрагент", 		Контрагент); 
	Запрос.УстановитьПараметр("Организация", 		Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса.Выгрузить());

КонецФункции

Процедура СоздатьВходящуюЦессиюВГО(ДокументЦессия) Экспорт
	
	АвтоматическиСоздавать = ПолучитьФункциональнуюОпцию("АвтоматическиСоздаватьВнутригрупповыеДоговорыИЦессии");
	
	Если НЕ АвтоматическиСоздавать Тогда
		Возврат;		                          	
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦессияИсходящая.Ссылка КАК ИсходныйДокумент,
		|	ЦессияИсходящая.Ссылка КАК ДокументОснование,
		|	ЦессияИсходящая.Контрагент.ОрганизационнаяЕдиница КАК Организация,
		|	Контрагенты.Ссылка КАК Контрагент,
		|	ЦессияИсходящая.СуммаДокумента КАК СуммаДокумента,
		|	ЦессияИсходящая.ВалютаДокумента КАК ВалютаДокумента,
		|	ЦессияИсходящая.СуммаОбязательства КАК СуммаОбязательства,
		|	ЦессияИсходящая.ДоговорЦессии КАК ИсходныйДоговор,
		|	ЦессияИсходящая.Должник КАК Должник,
		|	ЦессияИсходящая.СтавкаНДС КАК СтавкаНДС,
		|	ЦессияИсходящая.СуммаНДС КАК СуммаНДС,
		|	ЦессияИсходящая.ДоговорДолжника КАК ДоговорДолжника
		|ИЗ
		|	Документ.ЦессияИсходящая КАК ЦессияИсходящая
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЦессияВходящая КАК ЦессияВходящая
		|		ПО ЦессияИсходящая.Контрагент.ОрганизационнаяЕдиница = ЦессияВходящая.Организация
		|			И (ЦессияВходящая.ДокументОснование = ЦессияИсходящая.Ссылка)
		|			И (ЦессияВходящая.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО (Контрагенты.ОрганизационнаяЕдиница = ЦессияИсходящая.Организация)
		|ГДЕ
		|	ЦессияИсходящая.Контрагент.ОрганизационнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	И ЦессияВходящая.Ссылка ЕСТЬ NULL
		|	И ЦессияИсходящая.Проведен
		|	И ЦессияИсходящая.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументЦессия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураЗаполнения = СтруктураЗаполненияДокумента();
		ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, ВыборкаДетальныеЗаписи);
		НоваяЦессия = Документы.ЦессияВходящая.СоздатьДокумент();
		НоваяЦессия.Заполнить(СтруктураЗаполнения);
		Попытка
			НоваяЦессия.Записать(РежимЗаписиДокумента.Проведение);
		Исключение                                                
			НоваяЦессия.Записать();
		КонецПопытки;	
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЦессиюДолжникаВГО(ДокументЦессия) Экспорт
	
	АвтоматическиСоздавать = ПолучитьФункциональнуюОпцию("АвтоматическиСоздаватьВнутригрупповыеДоговорыИЦессии");
	
	Если НЕ АвтоматическиСоздавать Тогда
		Возврат;		                          	
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦессияВходящая.Ссылка КАК ИсходныйДокумент,
		|	ЦессияВходящая.Ссылка КАК ДокументОснование,
		|	ЦессияВходящая.Должник.ОрганизационнаяЕдиница КАК Организация,
		|	ЦессияВходящая.Контрагент КАК Цедент,
		|	ЦессияВходящая.СуммаОбязательства КАК СуммаДокумента,
		|	ЦессияВходящая.ВалютаДокумента КАК ВалютаДокумента,
		|	ЦессияВходящая.СуммаОбязательства КАК СуммаОбязательства,
		|	ЦессияВходящая.ДоговорДолжника КАК ДоговорДолжника, 
		|	ЦессияВходящая.ДоговорДолжника КАК ИсходныйДоговор,
		|	Контрагенты.Ссылка КАК Цессионарий
		|ИЗ
		|	Документ.ЦессияВходящая КАК ЦессияВходящая
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЦессияДолжника КАК ЦессияДолжника
		|		ПО ЦессияВходящая.Должник.ОрганизационнаяЕдиница = ЦессияДолжника.Организация
		|			И (ЦессияДолжника.ДокументОснование = ЦессияВходящая.Ссылка)
		|			И (ЦессияДолжника.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО (Контрагенты.ОрганизационнаяЕдиница = ЦессияВходящая.Организация)
		|ГДЕ
		|	ЦессияВходящая.Должник.ОрганизационнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	И ЦессияДолжника.Ссылка ЕСТЬ NULL
		|	И ЦессияВходящая.Проведен
		|	И ЦессияВходящая.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументЦессия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураЗаполнения = СтруктураЗаполненияДокумента();
		ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, ВыборкаДетальныеЗаписи);
		НоваяЦессия = Документы.ЦессияДолжника.СоздатьДокумент();
		НоваяЦессия.Заполнить(СтруктураЗаполнения);
		Попытка
			НоваяЦессия.Записать(РежимЗаписиДокумента.Проведение);
		Исключение                                                
			НоваяЦессия.Записать();
		КонецПопытки;		
	КонецЦикла;
	
КонецПроцедуры

Функция МожноСоздаватьДокументыРегУчета()  Экспорт
	
	Если Не ЗначениеЗаполнено(Константы.НоменклатураОтраженияЦессии.Получить()) Тогда
		
		ТекстСообщения = НСтр("ru = 'В настройках казначейства не заполнена номенклатура отражения цессии. Для продолжения необходимо заполнить'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(Константы.СтатьяОтраженияЦессии.Получить()) Тогда
		
		ТекстСообщения = НСтр("ru = 'В настройках казначейства не заполнена статья активов/пассивов отражения цессии. Для продолжения необходимо заполнить'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;  

	Если Не ЗначениеЗаполнено(Константы.СтатьяДоходовЦессии.Получить()) Тогда
		
		ТекстСообщения = НСтр("ru = 'В настройках казначейства не заполнена статья доходов отражения цессии. Для продолжения необходимо заполнить'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Константы.СтатьяРасходовЦессии.Получить()) Тогда
		
		ТекстСообщения = НСтр("ru = 'В настройках казначейства не заполнена статья расходов отражения цессии. Для продолжения необходимо заполнить'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // ()

Функция РеквизитыЦессионарий() Экспорт
	
	СтруктураРеквизитов = Новый Структура; 
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("Контрагент"); 
	СтруктураРеквизитов.Вставить("ВалютаДокумента"); 
	СтруктураРеквизитов.Вставить("ДоговорЦессии");    
	СтруктураРеквизитов.Вставить("Подразделение", "ДоговорЦессии.Подразделение");    
	СтруктураРеквизитов.Вставить("ПорядокРасчетов","ДоговорЦессии.ПорядокРасчетов");       
	СтруктураРеквизитов.Вставить("Партнер", "ДоговорЦессии.Партнер"); 
	СтруктураРеквизитов.Вставить("СуммаОбязательства");   
	СтруктураРеквизитов.Вставить("СуммаДокумента"); 
	СтруктураРеквизитов.Вставить("СтавкаНДС");     
	СтруктураРеквизитов.Вставить("СуммаНДС");     
	СтруктураРеквизитов.Вставить("Должник");
	СтруктураРеквизитов.Вставить("ДоговорДолжника");  
	СтруктураРеквизитов.Вставить("ПартнерДолжника", "ДоговорДолжника.Партнер");

    Возврат СтруктураРеквизитов;
	
КонецФункции // ()

Функция РеквизитыЦедент() Экспорт
	
	СтруктураРеквизитов = Новый Структура; 
	СтруктураРеквизитов.Вставить("Организация");
