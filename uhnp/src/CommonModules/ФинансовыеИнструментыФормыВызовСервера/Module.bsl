Процедура ЗаполнитьКэшируемыеЗначения(СтрокаЦБ, СтруктураДействий, КэшируемыеЗначения)

	Если Не СтруктураДействий.Свойство("ЗаполнитьКэшируемыеЗначения") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЦеннойБумаги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		СтрокаЦБ.ФинансовыйИнструмент, "Номинал,ВидФинансовогоИнструмента,ПараметрыЦеннойБумаги");
	
	Номинал 					= ?(ЗначениеЗаполнено(ДанныеЦеннойБумаги.Номинал), ДанныеЦеннойБумаги.Номинал, 0);//приводим к числу
	ДатаДокумента 				= НачалоДня(КэшируемыеЗначения.КонтекстДокумента.Дата);//купон выплачивается в конце дня	
	ДатаНачалаКупонногоПериода 	= Дата(1,1,1);
	ДатаВыплатыКупона 			= Дата(3999,12,31);
	ТекущийКупон 				= 0;
		
	Если ЗначениеЗаполнено(ДанныеЦеннойБумаги) 
		И ТипЗнч(ДанныеЦеннойБумаги.ПараметрыЦеннойБумаги) = Тип("ДокументСсылка.ВерсияГрафикаЦеннойБумаги")
		И ДанныеЦеннойБумаги.ПараметрыЦеннойБумаги.График.Количество() Тогда
		
		ТабличнаяЧастьГрафик = ДанныеЦеннойБумаги.ПараметрыЦеннойБумаги.График;
		
		ДатаНачалаКупонногоПериода 	= ТабличнаяЧастьГрафик[0].Дата;
		ДатаВыплатыКупона 			= ТабличнаяЧастьГрафик[ТабличнаяЧастьГрафик.Количество() - 1].Дата;
	 
		Для Инд = 0 По ТабличнаяЧастьГрафик.Количество() - 1 Цикл
			
			ТекущаяСтрока = ТабличнаяЧастьГрафик[Инд];
			Если ТекущаяСтрока.Дата < ДатаДокумента Тогда
				Продолжить;//ищем текущую строку в графике
			КонецЕсли;
			
			Если Инд = 0 Тогда
				ПредыдущаяСтрока = ТекущаяСтрока;
			Иначе
				ПредыдущаяСтрока = ТабличнаяЧастьГрафик[Инд-1];
			КонецЕсли;
			
			ДатаНачалаКупонногоПериода 	= ПредыдущаяСтрока.Дата;
			Номинал 					= ПредыдущаяСтрока.ОсновнойДолгОстаток;
			Если ТекущаяСтрока.Дата = ДатаДокумента Тогда
				Номинал = ТекущаяСтрока.ОсновнойДолгОстаток;
			КонецЕсли;
			
			Для й = инд По ТабличнаяЧастьГрафик.Количество() - 1 Цикл //ищем строку погашения купона
				СтрокаВыплатыКупона = ТабличнаяЧастьГрафик[й];
				Если СтрокаВыплатыКупона.ПроцентыУплачено <> 0 Тогда
					ДатаВыплатыКупона 	= СтрокаВыплатыКупона.Дата;
					ТекущийКупон		= СтрокаВыплатыКупона.ПроцентыУплачено;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Прервать;
			
		КонецЦикла;
	КонецЕсли;
	
	КурсРасчетовИзНоминала = 1;
	Если ЗначениеЗаполнено(СтрокаЦБ.ДоговорКонтрагента)
		И ЗначениеЗаполнено(СтрокаЦБ.ФинансовыйИнструмент)
		И ЗначениеЗаполнено(СтрокаЦБ.Дата) Тогда
	
		ВалютаРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			СтрокаЦБ.ДоговорКонтрагента, "ВалютаВзаиморасчетов");
		ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			СтрокаЦБ.ФинансовыйИнструмент, "ВалютаНоминала");
			
		Если ЗначениеЗаполнено(ВалютаНоминала) И ЗначениеЗаполнено(ВалютаРасчетов) Тогда
			//1000000 дает необходимую точность
			КурсРасчетовИзНоминала = РаботаСКурсамиВалют.ПересчитатьВВалюту(
				1000000, ВалютаНоминала, ВалютаРасчетов, СтрокаЦБ.Дата)/1000000;
			
		КонецЕсли;
			
	КонецЕсли;
	
	КэшируемыеЗначения.Вставить("ДатаНачалаКупонногоПериода",	ДатаНачалаКупонногоПериода);
	КэшируемыеЗначения.Вставить("ДатаВыплатыКупона", 			ДатаВыплатыКупона);
	КэшируемыеЗначения.Вставить("Номинал", 						Номинал);
	КэшируемыеЗначения.Вставить("ТекущийКупон", 				ТекущийКупон);
	КэшируемыеЗначения.Вставить("КурсРасчетовИзНоминала", 		КурсРасчетовИзНоминала);
	
КонецПроцедуры

Процедура ЗаполнитьКоличество(СтрокаЦБ, СтруктураДействий, КэшируемыеЗначения)

	Если Не СтруктураДействий.Свойство("ЗаполнитьКоличество") Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЦБ.Количество = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(СтрокаЦБ.ФинансовыйИнструмент, "Количетво");

КонецПроцедуры

Процедура ЗаполнитьНКД(СтрокаЦБ, СтруктураДействий, КэшируемыеЗначения)

	ЗначенияДействия = Неопределено;
	
	Если Не СтруктураДействий.Свойство("ЗаполнитьНКД", ЗначенияДействия) Тогда
		Возврат;
	КонецЕсли;
	
	НКД_Ед = ФинансоваяМатематика.ПолучитьНКД(
		КэшируемыеЗначения.ТекущийКупон, 
		КэшируемыеЗначения.КонтекстДокумента.Дата,
		КэшируемыеЗначения.ДатаВыплатыКупона,
		КэшируемыеЗначения.ДатаНачалаКупонногоПериода,
		Неопределено);
	
	СтрокаЦБ.НКД = СтрокаЦБ.Количество
		* НКД_Ед
		* КэшируемыеЗначения.КурсРасчетовИзНоминала;

КонецПроцедуры

Процедура РассчитатьСтоимостьНоминала(СтрокаЦБ, СтруктураДействий, КэшируемыеЗначения)

	Если Не СтруктураДействий.Свойство("РассчитатьСтоимостьНоминала") Тогда
		Возврат;
	КонецЕсли;
	
	СтоимостьНоминала = СтрокаЦБ.Количество 
		* КэшируемыеЗначения.Номинал 
		* КэшируемыеЗначения.КурсРасчетовИзНоминала;
	
	КэшируемыеЗначения.Вставить("СтоимостьНоминала", СтоимостьНоминала);
	
КонецПроцедуры

Процедура РассчитатьПремию(СтрокаЦБ, СтруктураДействий, КэшируемыеЗначения)
	
	Если Не СтруктураДействий.Свойство("РассчитатьПремию") Тогда
		Возврат;
	КонецЕсли;
	
	СтоимостьНоминала = СтрокаЦБ.Количество 
		* КэшируемыеЗначения.Номинал 
		* КэшируемыеЗначения.КурсРасчетовИзНоминала;
		
	СтрокаЦБ.Премия = СтрокаЦБ.Стоимость - СтоимостьНоминала - СтрокаЦБ.НКД;
	
КонецПроцедуры

Процедура РассчитатьСтоимость(СтрокаЦБ, СтруктураДействий, КэшируемыеЗначения)
	
	Если Не СтруктураДействий.Свойство("РассчитатьСтоимость") Тогда
		Возврат;
	КонецЕсли;
	
	СтоимостьНоминала = СтрокаЦБ.Количество 
		* КэшируемыеЗначения.Номинал 
		* КэшируемыеЗначения.КурсРасчетовИзНоминала;
		
	СтрокаЦБ.Стоимость = СтрокаЦБ.Премия + СтоимостьНоминала + СтрокаЦБ.НКД;
	
КонецПроцедуры

Функция СоздатьШаблонГрафика(ЕстьПроценты, ЕстьКомиссии, ЕстьШтрафы)
	
	ТабГрафик = Новый ТаблицаЗначений;		
	
	отДата = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя);
	отЧисло = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,2);
	
	ТабГрафик.Колонки.Добавить("Дата", отДата);
	ТабГрафик.Колонки.Добавить("ОсновнойДолгПолучение", отЧисло);
	ТабГрафик.Колонки.Добавить("ОсновнойДолгВозврат", отЧисло);
	
	Если ЕстьПроценты Тогда
		ТабГрафик.Колонки.Добавить("ПроцентыНачислено", отЧисло);
		ТабГрафик.Колонки.Добавить("ПроцентыУплачено", отЧисло);
	КонецЕсли;
	
	Если ЕстьКомиссии Тогда
		ТабГрафик.Колонки.Добавить("КомиссииНачислено", отЧисло);
		ТабГрафик.Колонки.Добавить("КомиссииУплачено", отЧисло);
	КонецЕсли;
	
	Если ЕстьШтрафы Тогда
		ТабГрафик.Колонки.Добавить("КомиссииНачислено", отЧисло);
		ТабГрафик.Колонки.Добавить("КомиссииУплачено", отЧисло);
	КонецЕсли;
	
	Возврат ТабГрафик;

КонецФункции

Процедура СвернутьГрафик(График, ЕстьПроценты = Истина, ЕстьКомиссии = Истина, ЕстьШтрафы = Истина)
	
	КолонкиСумм = "ОсновнойДолгПолучение,ОсновнойДолгВозврат" 
					+ ?(ЕстьПроценты, 	",ПроцентыНачислено,ПроцентыУплачено", 	"")
					+ ?(ЕстьКомиссии,	",КомиссииНачислено,КомиссииУплачено",	"")
					+ ?(ЕстьШтрафы, 	",ШтрафыНачислено,ШтрафыУплачено", 		"");
	
	График.Свернуть("Дата", КолонкиСумм);
	График.Сортировать("Дата");
	
	отЧисло = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18, 2);
	
	График.Колонки.Добавить("ОсновнойДолгОстаток", отЧисло);
	
	Если ЕстьПроценты Тогда
		График.Колонки.Добавить("ПроцентыОстаток", отЧисло);
	КонецЕсли;
	
	Если ЕстьКомиссии Тогда
		График.Колонки.Добавить("КомиссииОстаток", отЧисло);
	КонецЕсли;
	
	Если ЕстьШтрафы Тогда
		График.Колонки.Добавить("ШтрафыОстаток", отЧисло);
	КонецЕсли;
	
КонецПроцедуры

