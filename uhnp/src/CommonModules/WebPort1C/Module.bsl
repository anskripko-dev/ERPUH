Функция ПолучитьИнформациюОБазе() Экспорт 
	
	СведенияИБ = Новый Структура;
	
	СведенияИБ.Вставить("НазваниеКонфигурации", Метаданные.Имя); 
	СведенияИБ.Вставить("ВерсияКонфигурации", Метаданные.Версия);
		
	СистемнаяИнформация = Новый СистемнаяИнформация;
	СведенияИБ.Вставить("ВерсияОС", СистемнаяИнформация.ВерсияОС);
	СведенияИБ.Вставить("ВерсияПлатформы", СистемнаяИнформация.ВерсияПриложения);
	СведенияИБ.Вставить("РазрядностьПлатформы", Строка(СистемнаяИнформация.ТипПлатформы));
	
	Возврат СведенияИБ;
	
КонецФункции
