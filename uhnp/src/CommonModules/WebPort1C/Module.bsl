Функция ПолучитьПодключениеКЗаводу(ПроизводственноеПодразделение, ОписаниеОшибкиСоединения = "",РезерноеСоединение= ложь) Экспорт   //НАЧАЛО Кропачев 06.04.2017 ВЗ000024264
	// Устанавливаем соединение с удаленной базой
	// Настройки подключения
	
	//НАЧАЛО Кропачев 06.04.2017 ВЗ000024264 
	//WSDL = ПроизводственноеПодразделение.WSDL_WebPort1C_УдаленноеПодключение;
	Если РезерноеСоединение тогда
		WSDL = ПроизводственноеПодразделение.WSDL_WebPort1C_УдаленноеПодключениеРезервное;
	Иначе
	    WSDL = ПроизводственноеПодразделение.WSDL_WebPort1C_УдаленноеПодключение;
	КонецЕсли; 
 	//КОНЕЦ Кропачев 06.04.2017 ВЗ000024264

	Если Сред(WSDL,СтрДлина(WSDL)-4,5)<>"?wsdl" Тогда
		WSDL = WSDL + "?wsdl";
	КонецЕсли;
	
	// НАЧАЛО	Абрамкин П.Ю. (БИТ) 19-05-2016 Выполнение задач 000020831					
	//Пользователь = ПроизводственноеПодразделение.WSDL_Пользователь;
	//Пароль = ПроизводственноеПодразделение.WSDL_Пароль;
