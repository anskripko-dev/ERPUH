	Пароль = ПроизводственноеПодразделение.WSDL_WebPort1C_Пароль;
	// КОНЕЦ	Абрамкин П.Ю. (БИТ) 19-05-2016 Выполнение задач 000020831					
	
	Попытка
		WS_Определение = Новый WSОпределения(WSDL, Пользователь, Пароль);
	Исключение

		// Борисенко И.Н. 23.07.2021 Выполнение задач №000035594: закомментировал
		
		//// НАЧАЛО	Абрамкин П.Ю. (БИТ) 19-05-2016 Выполнение задач 000020831					
		////ОбщегоНазначения.СообщитьОбОшибке("Не удалось создать WS_Определение. Вероятно, недоступен или не функционирует веб-сервер завода, к которому вы пытаетесь обращаться. " + Символы.ПС + ОписаниеОшибки());
		//ОписаниеОшибкиСоединения = ОписаниеОшибки();
		//ОбщегоНазначения.СообщитьИнформацию("Не удалось создать WS_Определение. Вероятно, недоступен или не функционирует"
		//	+ " веб-сервер завода, к которому вы пытаетесь обращаться. " + Символы.ПС + ОписаниеОшибкиСоединения);		
		Возврат неопределено;
		// КОНЕЦ	Абрамкин П.Ю. (БИТ) 19-05-2016 Выполнение задач 000020831					
		
	КонецПопытки;		
	
	WS_КоллекцияСервисов 	= WS_Определение.Сервисы;
	WS_Сервис               = WS_КоллекцияСервисов[0];
	URI						= WS_Сервис.URIПространстваИмен;
	ИмяСервиса				= WS_Сервис.Имя;
	Порт                    = WS_Сервис.Имя + "Soap";
	
	Прокси 	= Новый WSПрокси(WS_Определение, 
						URI,
						ИмяСервиса,
						Порт);

	
	Прокси.Пользователь = Пользователь;
	Прокси.Пароль 		= Пароль;
	
	Возврат Прокси;
	
КонецФункции

