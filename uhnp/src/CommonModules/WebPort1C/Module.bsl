Функция ПолучитьПараметрыСоединения(ПроизводственноеПодразделение, ВозвращатьПрокси = Ложь) Экспорт
	
	//АнглийскийЯзык = ПараметрыСеанса.АнглийскийЯзык = Истина;
	// НАЧАЛО Борисенко И.Н. 23.07.2021 Выполнение задач №000035594
	//Если ТипЗнч(ПроизводственноеПодразделение) <> Тип("СправочникСсылка.ПроизводственныеПодразделения") 
	Если ТипЗнч(ПроизводственноеПодразделение) <> Тип("СправочникСсылка.тн_ПроизводственныеПодразделения") 
	// КОНЕЦ Борисенко И.Н. 23.07.2021 Выполнение задач №000035594
		ИЛИ НЕ ЗначениеЗаполнено(ПроизводственноеПодразделение) Тогда 
		
		Возврат Новый Структура("Адрес, ПулСоединений, ФлагОшибки, ТекстОшибки", 
		"", "", ИСТИНА, НСтр("en = 'Department is not specified'; ru = 'Не указано производственное подразделение'"));
	КонецЕсли;
	
	
	ОписаниеОшибкиСоединения = "";
	Прокси = WebPort1c.ПолучитьПодключениеКЗаводу(ПроизводственноеПодразделение, ОписаниеОшибкиСоединения);
	
	Если Прокси = Неопределено тогда
		Возврат Новый Структура("Адрес, ПулСоединений, ФлагОшибки, ТекстОшибки", "", "", ИСТИНА, 
		НСтр("en = 'Connection could not be established because '; ru = 'Соединение не установлено по причине '") 
		+ ОписаниеОшибкиСоединения);
	Иначе 
		Возврат Новый Структура("ФлагОшибки, ТекстОшибки, Прокси", ЛОЖЬ, "", Прокси);
	КонецЕсли;	
	
	
КонецФункции

