Функция ВыполнитьФункцию(ИмяФункции, Параметры) Экспорт 
	
	СписокПараметров = Десериализовать(Параметры);
	
	Результат = ВызватьФункциюСтрокой(ИмяФункции, СписокПараметров);
	
	Результат = Сериализовать(Результат);

	Возврат Результат;

КонецФункции // ВыполнитьФункцию()

Функция ВыполнитьФункциюБезСериализацииРезултата(ИмяФункции, Параметры) Экспорт 
	
	СписокПараметров = Десериализовать(Параметры);
	
	Результат = ВызватьФункциюСтрокой(ИмяФункции, СписокПараметров);
	
	Возврат Результат;

КонецФункции // ВыполнитьФункцию()

Функция ВыполнитьФункциюВУдаленнойБазе(ИмяФункции, СписокПараметров, Прокси) Экспорт

	ПараметрыСтрокой 	= Сериализовать(СписокПараметров);
	
	РезультатСтрокой 	= Прокси.CallFunction(ИмяФункции, ПараметрыСтрокой,Неопределено);
	
	Результат			= Десериализовать(РезультатСтрокой);
	
	Возврат Результат; 

КонецФункции // ВыполнитьФункциюВУдаленнойБазе()


Функция Сериализовать(Значение)Экспорт  

	НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
	ЗаписьXml = Новый  ЗаписьXML;
    ЗаписьXml.УстановитьСтроку();
 	НовыйСериализаторXDTO.ЗаписатьXML(ЗаписьXml, Значение, НазначениеТипаXML.Явное); 

	Возврат  ЗаписьXml.Закрыть();
	
КонецФункции 

Функция Десериализовать(Значение) 

	НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO); 
	ЧтениеXml = Новый ЧтениеXml;
	ЧтениеXml.УстановитьСтроку(Значение);

   	ДесериализованныеПараметры = НовыйСериализаторXDTO.ПрочитатьXML(ЧтениеXml);
	Возврат  ДесериализованныеПараметры;
	
КонецФункции 


// Выполнение экспортных функций в локальной базе 1С
//
// Параметры:
// ИмяФункции - имя вызываемой функции
// Параметры - массив со значениеям параметров вызываемой функции
//
// Возвращаемое значение:
// Функция возвращает результат выполнения вызываемой функции
//
Функция ВызватьФункциюСтрокой(ИмяФункции, Параметры) 
	Строка = "Результат = " + ИмяФункции + "(";
    СчётчикПараметров = Параметры.Количество() - 1;
	Если ТипЗНЧ(Параметры) = Тип("Массив") Тогда
			Для Счетчик = 0 По СчётчикПараметров Цикл
				Строка = Строка + "Параметры[" + Счетчик + "], ";
			КонецЦикла;
		Иначе 	
			Для Счетчик = 0 По СчётчикПараметров Цикл
				Строка = Строка + "Параметры[" + Счетчик + "].Значение, ";
			КонецЦикла;
		КонецЕсли;
		
	Если СчётчикПараметров +1 > 0 Тогда
		Строка = Лев(Строка, СтрДлина(Строка) - 2);
	КонецЕсли;
	
	Строка = Строка + ");";
	
	Результат = "";
	
	//СтруктураСтатистики = СтатистикаДокументов.ПолучитьСтруктуруФиксацииПроизвольнойСтатистики(ИмяФункции); 

	Выполнить(Строка);
	
	//СтатистикаДокументов.ЗаписатьДанныеПроизвольнойСтатистики(СтруктураСтатистики); 

	Возврат Результат;
	
КонецФункции

