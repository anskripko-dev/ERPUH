
#Область ПрограммныйИнтерфейс

// Возвращает параметры обработки этапов для дальнейшей их обработки
// 
// Возвращаемое значение:
//	- Структура - Структура параметров
//
Функция ПараметрыОбработкиЭтапов() Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	// Ключевые срезы
	СтруктураПараметров.Вставить("Этап", Неопределено);
	СтруктураПараметров.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	СтруктураПараметров.Вставить("Сценарий", Справочники.Сценарии.ПустаяСсылка());
	СтруктураПараметров.Вставить("ВерсияРегламента", Справочники.ВерсииЗначенийПоказателей.ПустаяСсылка());
	СтруктураПараметров.Вставить("ПериодОтчета", Справочники.Периоды.ПустаяСсылка());
	СтруктураПараметров.Вставить("ПериодОкончания", Справочники.Периоды.ПустаяСсылка());
	СтруктураПараметров.Вставить("ШаблонПроцесса", Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка());
	СтруктураПараметров.Вставить("УправлениеПериодом", Документы.УправлениеПериодомСценария.ПустаяСсылка());
	
	// Данные этапа
	СтруктураПараметров.Вставить("ОтветственныйЗаЭтап", Справочники.Пользователи.ПустаяСсылка());
	
	// Служебные параметры
	СтруктураПараметров.Вставить("ВыводитьСообщения", Ложь);
	СтруктураПараметров.Вставить("Отказ", Ложь);

	// Параметры выполняемых действий
	СтруктураПараметров.Вставить("СоздаватьДокументы", Ложь);
	СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
	СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ПустаяСсылка());
	СтруктураПараметров.Вставить("УстанавливатьСтатусДокументов", Ложь);
	
	СтруктураПараметров.Вставить("ДополнительныеОтборы", Новый Структура);
	
	Возврат СтруктураПараметров;
	
КонецФункции

// Возвращает запрос по данным этапов
//
// Параметры:
//  СтруктураПараметров - Структура - Структура параметров полученная функцией ПараметрыОбработкиЭтапов()
// 
// Возвращаемое значение:
//   - Запрос - Запрос по данным этапов
//
Функция ЗапросПоДаннымЭтапов(СтруктураПараметров) Экспорт
	
	// Дополним структуру параметров недостающими параметрами
	ДополнитьСтруктуруПараметров(СтруктураПараметров);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументУправлениеПериодомСценария.Ссылка КАК УправлениеПериодом,
		|	ДокументУправлениеПериодомСценария.ПериодЗакрыт КАК ПериодЗакрыт,
		|	ВерсииРегламентовПодготовкиОтчетности.Ссылка КАК ВерсияРегламента,
		|	ШаблоныУниверсальныхПроцессов.Ссылка КАК ШаблонПроцесса,
		|	ЭтапыУниверсальныхПроцессов.Ссылка КАК Этап,
		|	ЭтапыУниверсальныхПроцессов.Наименование КАК Наименование,
		|	ЭтапыУниверсальныхПроцессов.ДлительностьПлановая КАК ДлительностьПлановая,
		|	ЭтапыУниверсальныхПроцессов.ТипОрганизацийЭтапа КАК ТипОрганизацийЭтапа,
		|	ЭтапыУниверсальныхПроцессов.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ЭтапыУниверсальныхПроцессов.КритерийУтвержденияЭтапа КАК КритерийУтвержденияЭтапа,
		|	ЭтапыУниверсальныхПроцессов.ДействиеПоРасписанию <> ЗНАЧЕНИЕ(Перечисление.ДействияЭтапаПоРасписанию.ПустаяСсылка) КАК ЕстьДействиеПоРасписанию,
		|	ЭтапыУниверсальныхПроцессов.Ответственный КАК ОтветственныйЗаЭтап,
		|	ОрганизационныеЕдиницыЭтаповПроцессов.ОрганизационнаяЕдиница КАК Организация,
		|	ЕСТЬNULL(СостоянияПроцессаПодготовкиОтчетности.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияПроцессаПодготовкиОтчетности.НеЗапущен)) КАК СостояниеПроцесса,
		|	ЕСТЬNULL(СостоянияПроцессаПодготовкиОтчетности.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачалаПроцесса,
		|	ЕСТЬNULL(СостоянияПроцессаПодготовкиОтчетности.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияПроцесса,
		|	ЕСТЬNULL(СостоянияЭтаповПроцессаПодготовкиОтчетности.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен)) КАК СостояниеЭтапа,
		|	ЕСТЬNULL(СостоянияЭтаповПроцессаПодготовкиОтчетности.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончания,
		|	ЕСТЬNULL(УровниЭтаповУниверсальныхПроцессов.Уровень, 0) КАК Уровень
		|ПОМЕСТИТЬ втДанныеЭтапов
		|ИЗ
		|	Документ.УправлениеПериодомСценария КАК ДокументУправлениеПериодомСценария
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииРегламентовПодготовкиОтчетности
		|		ПО ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры = ВерсииРегламентовПодготовкиОтчетности.Ссылка
		|			И (ВерсииРегламентовПодготовкиОтчетности.ИспользоватьПроцесс)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныУниверсальныхПроцессов КАК ШаблоныУниверсальныхПроцессов
		|		ПО (ШаблоныУниверсальныхПроцессов.Ссылка = ВерсииРегламентовПодготовкиОтчетности.ШаблонПроцесса)
		|			И (ШаблоныУниверсальныхПроцессов.НазначениеПроцесса = ЗНАЧЕНИЕ(Перечисление.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
		|		ПО (ЭтапыУниверсальныхПроцессов.Владелец = ШаблоныУниверсальныхПроцессов.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОрганизационныеЕдиницыЭтаповПроцессов КАК ОрганизационныеЕдиницыЭтаповПроцессов
		|		ПО (ЭтапыУниверсальныхПроцессов.Ссылка = ОрганизационныеЕдиницыЭтаповПроцессов.ЭтапПроцесса)
		|			И (ОрганизационныеЕдиницыЭтаповПроцессов.ВерсияРегламентаПодготовкиОтчетности = ВерсииРегламентовПодготовкиОтчетности.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПроцессаПодготовкиОтчетности КАК СостоянияПроцессаПодготовкиОтчетности
		|		ПО ДокументУправлениеПериодомСценария.Ссылка = СостоянияПроцессаПодготовкиОтчетности.УправлениеПериодомСценария
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЭтаповПроцессаПодготовкиОтчетности КАК СостоянияЭтаповПроцессаПодготовкиОтчетности
		|		ПО (ЭтапыУниверсальныхПроцессов.Ссылка = СостоянияЭтаповПроцессаПодготовкиОтчетности.Этап)
		|			И (СостоянияЭтаповПроцессаПодготовкиОтчетности.Организация = ОрганизационныеЕдиницыЭтаповПроцессов.ОрганизационнаяЕдиница)
		|			И (СостоянияЭтаповПроцессаПодготовкиОтчетности.УправлениеПериодомСценария = ДокументУправлениеПериодомСценария.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УровниЭтаповУниверсальныхПроцессов КАК УровниЭтаповУниверсальныхПроцессов
		|		ПО (ЭтапыУниверсальныхПроцессов.Ссылка = УровниЭтаповУниверсальныхПроцессов.Этап)
		|ГДЕ
		|	НЕ ЭтапыУниверсальныхПроцессов.ЭтоГруппа
		|	И НЕ ЭтапыУниверсальныхПроцессов.ДинамическийЭтап";
	
	// Основные отборы
	ДобавитьОтборВЗапрос(Запрос, СтруктураПараметров, "УправлениеПериодом", "ДокументУправлениеПериодомСценария.Ссылка");
	ДобавитьОтборВЗапрос(Запрос, СтруктураПараметров, "ВерсияРегламента", "ВерсииРегламентовПодготовкиОтчетности.Ссылка");
	ДобавитьОтборВЗапрос(Запрос, СтруктураПараметров, "ШаблонПроцесса", "ШаблоныУниверсальныхПроцессов.Ссылка");
	ДобавитьОтборВЗапрос(Запрос, СтруктураПараметров, "Организация", "ОрганизационныеЕдиницыЭтаповПроцессов.ОрганизационнаяЕдиница");
	ДобавитьОтборВЗапрос(Запрос, СтруктураПараметров, "Этап", "ЭтапыУниверсальныхПроцессов.Ссылка");
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.Этап) Тогда
		Запрос.Текст = Запрос.Текст + " 
		|	И НЕ ЭтапыУниверсальныхПроцессов.ПометкаУдаления";
	КонецЕсли;
	
	// Дополнительные отборы
	ДобавитьОтборВЗапрос(Запрос, СтруктураПараметров.ДополнительныеОтборы, "СостояниеПроцесса",
		"СостоянияПроцессаПодготовкиОтчетности.Состояние");
	ДобавитьОтборВЗапрос(Запрос, СтруктураПараметров.ДополнительныеОтборы, "НеСостояниеЭтапа",
		"НЕ ЕСТЬNULL(СостоянияЭтаповПроцессаПодготовкиОтчетности.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен))");
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов();
	
	Возврат Запрос;

КонецФункции

// Возвращает запрос по данным этапов с документами этапов
//
// Параметры:
//  СтруктураПараметров - Структура - Структура параметров полученная функцией ПараметрыОбработкиЭтапов()
// 
// Возвращаемое значение:
//   - Запрос - Запрос по данным этапов с документами
//
Функция ЗапросПоДаннымЭтаповДокументов(СтруктураПараметров) Экспорт
	
	СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Неопределено);
	Запрос = ЗапросПоДаннымЭтапов(СтруктураПараметров);
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтапов.Этап КАК Этап,
		|	ДанныеЭтапов.ТипОрганизацийЭтапа КАК ТипОрганизацийЭтапа,
		|	ДанныеЭтапов.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ДанныеЭтапов.КритерийУтвержденияЭтапа КАК КритерийУтвержденияЭтапа,
		|	ДанныеЭтапов.Уровень КАК Уровень,
		|	ДанныеЭтапов.Организация КАК Организация,
		|	ДанныеЭтапов.ВерсияРегламента КАК ВерсияРегламента,
		|	ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента КАК ШаблонДокумента,
		|	ЭтапыПроцессовФормируемыеДокументы.Контрольный КАК Контрольный,
		|	Организации.ЭлиминирующаяОрганизация КАК ЭлиминирующаяОрганизация,
		|	ДокументыБД.Ссылка КАК ДокументБД,
		|	ДокументыБД.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
		|	ДокументыБД.ИспользоватьШаблоны КАК ИспользоватьШаблоны,
		|	ДокументыБД.РеквизитШаблонаДокумента КАК РеквизитШаблонаДокумента,
		|	ДокументыБД.РеквизитРазделенияПоОрганизациям КАК РеквизитРазделенияПоОрганизациям,
		|	ДокументыБД.Согласуется КАК Согласуется,
		|	ДокументыБД.ЗначениеРеквизитаСостоянияУтвержден КАК СостояниеУтвержден,
		|	ДокументыБД.ЗначениеРеквизитаСостоянияЧерновик КАК СостояниеЧерновик,
		|	ЕСТЬNULL(ЗначенияАналитикОбъектов.Проект, ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)) КАК Проект,
		|	ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика1, НЕОПРЕДЕЛЕНО) КАК Аналитика1,
		|	ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика2, НЕОПРЕДЕЛЕНО) КАК Аналитика2,
		|	ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика3, НЕОПРЕДЕЛЕНО) КАК Аналитика3,
		|	ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика4, НЕОПРЕДЕЛЕНО) КАК Аналитика4,
		|	ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика5, НЕОПРЕДЕЛЕНО) КАК Аналитика5,
		|	ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика6, НЕОПРЕДЕЛЕНО) КАК Аналитика6
		|ПОМЕСТИТЬ втВсеЭтапыОрганизации
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов.ФормируемыеДокументы КАК ЭтапыПроцессовФормируемыеДокументы
		|		ПО ДанныеЭтапов.Этап = ЭтапыПроцессовФормируемыеДокументы.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ДанныеЭтапов.Организация = Организации.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБД КАК ДокументыБД
		|		ПО (ЭтапыПроцессовФормируемыеДокументы.ДокументБД = ДокументыБД.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияАналитикОбъектов КАК ЗначенияАналитикОбъектов
		|		ПО ДанныеЭтапов.Этап = ЗначенияАналитикОбъектов.ОбъектУчета
		|			И (ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента = ЗначенияАналитикОбъектов.ШаблонДокумента)
		|ГДЕ
		|	ИСТИНА";
		
	// Дополнительные отборы
	ДополнительныеОтборы = СтруктураПараметров.ДополнительныеОтборы;
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы, "ДокументБД", "ДокументыБД.Ссылка");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы, "ШаблонДокумента", "ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы,
		"Проект", "ЕСТЬNULL(ЗначенияАналитикОбъектов.Проект, ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка))");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы,
		"Аналитика1", "ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика1, НЕОПРЕДЕЛЕНО)");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы,
		"Аналитика2", "ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика2, НЕОПРЕДЕЛЕНО)");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы,
		"Аналитика3", "ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика3, НЕОПРЕДЕЛЕНО)");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы,
		"Аналитика4", "ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика4, НЕОПРЕДЕЛЕНО)");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы,
		"Аналитика5", "ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика5, НЕОПРЕДЕЛЕНО)");
	ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы,
		"Аналитика6", "ЕСТЬNULL(ЗначенияАналитикОбъектов.Аналитика6, НЕОПРЕДЕЛЕНО)");
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ВсеЭтапыОрганизации.ДокументБД КАК ДокументБД,
		|	МАКСИМУМ(ВсеЭтапыОрганизации.ИмяОбъектаМетаданных) КАК ИмяОбъектаМетаданных,
		|	МАКСИМУМ(ВсеЭтапыОрганизации.ИспользоватьШаблоны) КАК ИспользоватьШаблоны,
		|	МАКСИМУМ(ВсеЭтапыОрганизации.РеквизитШаблонаДокумента) КАК РеквизитШаблонаДокумента,
		|	МАКСИМУМ(ВсеЭтапыОрганизации.РеквизитРазделенияПоОрганизациям) КАК РеквизитРазделенияПоОрганизациям,
		|	МАКСИМУМ(ВсеЭтапыОрганизации.Согласуется) КАК Согласуется
		|ИЗ
		|	втВсеЭтапыОрганизации КАК ВсеЭтапыОрганизации
		|
		|СГРУППИРОВАТЬ ПО
		|	ВсеЭтапыОрганизации.ДокументБД";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Нет данных этапа
		Возврат Неопределено;
	КонецЕсли;
	
	НуженПоискПоследнегоПоДате = Ложь;
	ПервыйЗапрос = Истина;
	ШаблонЗапроса = 
		"ВЫБРАТЬ
		|	ВсеЭтапыОрганизации.Этап КАК Этап,
		|	ВсеЭтапыОрганизации.Организация КАК Организация,
		|	ВсеЭтапыОрганизации.Проект КАК Проект,
		|	ВсеЭтапыОрганизации.Аналитика1 КАК Аналитика1,
		|	ВсеЭтапыОрганизации.Аналитика2 КАК Аналитика2,
		|	ВсеЭтапыОрганизации.Аналитика3 КАК Аналитика3,
		|	ВсеЭтапыОрганизации.Аналитика4 КАК Аналитика4,
		|	ВсеЭтапыОрганизации.Аналитика5 КАК Аналитика5,
		|	ВсеЭтапыОрганизации.Аналитика6 КАК Аналитика6,
		|	ВсеЭтапыОрганизации.ДокументБД КАК ДокументБД,
		|	ВсеЭтапыОрганизации.ШаблонДокумента КАК ШаблонДокумента,
		|	ВсеЭтапыОрганизации.Согласуется КАК Согласуется,
		|	ДокументыЭтапа.Ссылка КАК Документ,
		|	ДокументыЭтапа.Дата КАК Дата,
		|	ДокументыЭтапа.Проведен КАК Проведен
		|ПОМЕСТИТЬ втДокументыЭтапов
		|ИЗ
		|	Документ.НастраиваемыйОтчет КАК ДокументыЭтапа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВсеЭтапыОрганизации КАК ВсеЭтапыОрганизации
		|		ПО &Соединение
		|ГДЕ
		|	ДокументыЭтапа.Сценарий = &Сценарий
		|	И ДокументыЭтапа.ПериодОтчета = &ПериодОтчета";
	
	Запрос.УстановитьПараметр("Сценарий", СтруктураПараметров.Сценарий);
	Запрос.УстановитьПараметр("ПериодОтчета", СтруктураПараметров.ПериодОтчета);
		
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "НастраиваемыйОтчет", ВыборкаДетальныеЗаписи.ИмяОбъектаМетаданных);
		Если ПервыйЗапрос Тогда
			Запрос.Текст = ТекстЗапроса;
			ПервыйЗапрос = Ложь;
		Иначе
			Запрос.Текст = Запрос.Текст + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|" + СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ втДокументыЭтапов", "");
		КонецЕсли;
		
		ТекстСоединения = 
			"ВсеЭтапыОрганизации.Организация = ДокументыЭтапа." + ВыборкаДетальныеЗаписи.РеквизитРазделенияПоОрганизациям + "
			|		И ВсеЭтапыОрганизации.ИмяОбъектаМетаданных = """ + ВыборкаДетальныеЗаписи.ИмяОбъектаМетаданных + """";
		
		Если ВыборкаДетальныеЗаписи.ИспользоватьШаблоны Тогда
			ТекстСоединения = ТекстСоединения + "
			|		И ВсеЭтапыОрганизации.ШаблонДокумента = ДокументыЭтапа." + ВыборкаДетальныеЗаписи.РеквизитШаблонаДокумента;
		Иначе
			НуженПоискПоследнегоПоДате = Истина;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ИмяОбъектаМетаданных = "НастраиваемыйОтчет" Тогда
			
			// Добавляем соединение по ключевым аналитикам
			ТекстСоединения = ТекстСоединения + "
			|		И ДокументыЭтапа.Проект = ВсеЭтапыОрганизации.Проект
			|		И ДокументыЭтапа.Аналитика1 = ВсеЭтапыОрганизации.Аналитика1
			|		И ДокументыЭтапа.Аналитика2 = ВсеЭтапыОрганизации.Аналитика2
			|		И ДокументыЭтапа.Аналитика3 = ВсеЭтапыОрганизации.Аналитика3
			|		И ДокументыЭтапа.Аналитика4 = ВсеЭтапыОрганизации.Аналитика4
			|		И ДокументыЭтапа.Аналитика5 = ВсеЭтапыОрганизации.Аналитика5
			|		И ДокументыЭтапа.Аналитика6 = ВсеЭтапыОрганизации.Аналитика6";
			
		КонецЕсли;
		
		ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы, "ДокументСсылка", "ДокументыЭтапа.Ссылка");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Соединение", ТекстСоединения);
		
	КонецЦикла;
	
	Если НуженПоискПоследнегоПоДате Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "втДокументыЭтапов", "втДокументыЭтаповВсе")
			+ ОбщегоНазначения.РазделительПакетаЗапросов() + 
			"ВЫБРАТЬ
			|	ДокументыЭтапов.Этап КАК Этап,
			|	ДокументыЭтапов.Организация КАК Организация,
			|	ДокументыЭтапов.Проект КАК Проект,
			|	ДокументыЭтапов.Аналитика1 КАК Аналитика1,
			|	ДокументыЭтапов.Аналитика2 КАК Аналитика2,
			|	ДокументыЭтапов.Аналитика3 КАК Аналитика3,
			|	ДокументыЭтапов.Аналитика4 КАК Аналитика4,
			|	ДокументыЭтапов.Аналитика5 КАК Аналитика5,
			|	ДокументыЭтапов.Аналитика6 КАК Аналитика6,
			|	ДокументыЭтапов.ДокументБД КАК ДокументБД,
			|	ДокументыЭтапов.ШаблонДокумента КАК ШаблонДокумента,
			|	МАКСИМУМ(ДокументыЭтапов.Дата) КАК Дата
			|ПОМЕСТИТЬ втМаксимальныеДатыДокументовЭтапов
			|ИЗ
			|	втДокументыЭтаповВсе КАК ДокументыЭтапов
			|
			|СГРУППИРОВАТЬ ПО
			|	ДокументыЭтапов.Этап,
			|	ДокументыЭтапов.Организация,
			|	ДокументыЭтапов.Проект,
			|	ДокументыЭтапов.Аналитика1,
			|	ДокументыЭтапов.Аналитика2,
			|	ДокументыЭтапов.Аналитика3,
			|	ДокументыЭтапов.Аналитика4,
			|	ДокументыЭтапов.Аналитика5,
			|	ДокументыЭтапов.Аналитика6,
			|	ДокументыЭтапов.ДокументБД,
			|	ДокументыЭтапов.ШаблонДокумента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДокументыЭтапов.Этап КАК Этап,
			|	ДокументыЭтапов.Организация КАК Организация,
			|	ДокументыЭтапов.Проект КАК Проект,
			|	ДокументыЭтапов.Аналитика1 КАК Аналитика1,
			|	ДокументыЭтапов.Аналитика2 КАК Аналитика2,
			|	ДокументыЭтапов.Аналитика3 КАК Аналитика3,
			|	ДокументыЭтапов.Аналитика4 КАК Аналитика4,
			|	ДокументыЭтапов.Аналитика5 КАК Аналитика5,
			|	ДокументыЭтапов.Аналитика6 КАК Аналитика6,
			|	ДокументыЭтапов.ДокументБД КАК ДокументБД,
			|	ДокументыЭтапов.ШаблонДокумента КАК ШаблонДокумента,
			|	ДокументыЭтапов.Согласуется КАК Согласуется,
			|	ДокументыЭтапов.Документ КАК Документ,
			|	ДокументыЭтапов.Дата КАК Дата,
			|	ДокументыЭтапов.Проведен КАК Проведен
			|ПОМЕСТИТЬ втДокументыЭтапов
			|ИЗ
			|	втДокументыЭтаповВсе КАК ДокументыЭтапов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныеДатыДокументовЭтапов КАК МаксимальныеДатыДокументовЭтапов
			|		ПО ДокументыЭтапов.Этап = МаксимальныеДатыДокументовЭтапов.Этап
			|			И ДокументыЭтапов.ДокументБД = МаксимальныеДатыДокументовЭтапов.ДокументБД
			|			И ДокументыЭтапов.ШаблонДокумента = МаксимальныеДатыДокументовЭтапов.ШаблонДокумента
			|			И ДокументыЭтапов.Организация = МаксимальныеДатыДокументовЭтапов.Организация
			|			И ДокументыЭтапов.Проект = МаксимальныеДатыДокументовЭтапов.Проект
			|			И ДокументыЭтапов.Аналитика1 = МаксимальныеДатыДокументовЭтапов.Аналитика1
			|			И ДокументыЭтапов.Аналитика2 = МаксимальныеДатыДокументовЭтапов.Аналитика2
			|			И ДокументыЭтапов.Аналитика3 = МаксимальныеДатыДокументовЭтапов.Аналитика3
			|			И ДокументыЭтапов.Аналитика4 = МаксимальныеДатыДокументовЭтапов.Аналитика4
			|			И ДокументыЭтапов.Аналитика5 = МаксимальныеДатыДокументовЭтапов.Аналитика5
			|			И ДокументыЭтапов.Аналитика6 = МаксимальныеДатыДокументовЭтапов.Аналитика6
			|			И ДокументыЭтапов.ДокументБД = МаксимальныеДатыДокументовЭтапов.ДокументБД
			|			И ДокументыЭтапов.Дата = МаксимальныеДатыДокументовЭтапов.Дата";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + 
		"ВЫБРАТЬ
		|	РегистрСостоянийОбъектов.Объект КАК Объект,
		|	РегистрСостоянийОбъектов.СостояниеОбъекта КАК Состояние
		|ПОМЕСТИТЬ втСостоянияОбъектов
		|ИЗ
		|	РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних(
		|			,
		|			Объект В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					Документы.Документ
		|				ИЗ
		|					втДокументыЭтапов КАК Документы)) КАК РегистрСостоянийОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеЭтапыОрганизации.Этап КАК Этап,
		|	ВсеЭтапыОрганизации.Уровень КАК Уровень,
		|	ВсеЭтапыОрганизации.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ВсеЭтапыОрганизации.Организация КАК Организация,
		|	ВсеЭтапыОрганизации.Проект КАК Проект,
		|	ВсеЭтапыОрганизации.Аналитика1 КАК Аналитика1,
		|	ВсеЭтапыОрганизации.Аналитика2 КАК Аналитика2,
		|	ВсеЭтапыОрганизации.Аналитика3 КАК Аналитика3,
		|	ВсеЭтапыОрганизации.Аналитика4 КАК Аналитика4,
		|	ВсеЭтапыОрганизации.Аналитика5 КАК Аналитика5,
		|	ВсеЭтапыОрганизации.Аналитика6 КАК Аналитика6,
		|	ВсеЭтапыОрганизации.ТипОрганизацийЭтапа КАК ТипОрганизацийЭтапа,
		|	ВсеЭтапыОрганизации.ЭлиминирующаяОрганизация КАК ЭлиминирующаяОрганизация,
		|	ВсеЭтапыОрганизации.КритерийУтвержденияЭтапа КАК КритерийУтвержденияЭтапа,
		|	ВсеЭтапыОрганизации.Контрольный КАК Контрольный,
		|	ВсеЭтапыОрганизации.ДокументБД КАК ДокументБД,
		|	ВсеЭтапыОрганизации.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
		|	ВсеЭтапыОрганизации.ИспользоватьШаблоны КАК ИспользоватьШаблоны,
		|	ВсеЭтапыОрганизации.РеквизитШаблонаДокумента КАК РеквизитШаблонаДокумента,
		|	ВсеЭтапыОрганизации.РеквизитРазделенияПоОрганизациям КАК РеквизитРазделенияПоОрганизациям,
		|	ВсеЭтапыОрганизации.Согласуется КАК Согласуется,
		|	ВсеЭтапыОрганизации.СостояниеУтвержден КАК СостояниеУтвержден,
		|	ВсеЭтапыОрганизации.СостояниеЧерновик КАК СостояниеЧерновик,
		|	ВсеЭтапыОрганизации.ШаблонДокумента КАК ШаблонДокумента,
		|	ЕСТЬNULL(ДокументыЭтапов.Документ, НЕОПРЕДЕЛЕНО) КАК Документ,
		|	ВЫБОР
		|		КОГДА ВсеЭтапыОрганизации.Согласуется
		|			ТОГДА ЕСТЬNULL(СостоянияОбъектов.Состояние, ВсеЭтапыОрганизации.СостояниеЧерновик)
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ДокументыЭтапов.Проведен
		|					ТОГДА ВсеЭтапыОрганизации.СостояниеУтвержден
		|				ИНАЧЕ ВсеЭтапыОрганизации.СостояниеЧерновик
		|			КОНЕЦ
		|	КОНЕЦ КАК Состояние,
		|	ЕСТЬNULL(РегистрМатрицыПолномочий.Исполняющий, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Исполняющий,
		|	ЕСТЬNULL(РегистрМатрицыПолномочий.Согласование, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Согласование
		|ПОМЕСТИТЬ втДанныеЭтаповДокументов
		|ИЗ
		|	втВсеЭтапыОрганизации КАК ВсеЭтапыОрганизации
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДокументыЭтапов КАК ДокументыЭтапов
		|		ПО ВсеЭтапыОрганизации.Этап = ДокументыЭтапов.Этап
		|			И ВсеЭтапыОрганизации.ДокументБД = ДокументыЭтапов.ДокументБД
		|			И ВсеЭтапыОрганизации.ШаблонДокумента = ДокументыЭтапов.ШаблонДокумента
		|			И ВсеЭтапыОрганизации.Организация = ДокументыЭтапов.Организация
		|			И ВсеЭтапыОрганизации.Проект = ДокументыЭтапов.Проект
		|			И ВсеЭтапыОрганизации.Аналитика1 = ДокументыЭтапов.Аналитика1
		|			И ВсеЭтапыОрганизации.Аналитика2 = ДокументыЭтапов.Аналитика2
		|			И ВсеЭтапыОрганизации.Аналитика3 = ДокументыЭтапов.Аналитика3
		|			И ВсеЭтапыОрганизации.Аналитика4 = ДокументыЭтапов.Аналитика4
		|			И ВсеЭтапыОрганизации.Аналитика5 = ДокументыЭтапов.Аналитика5
		|			И ВсеЭтапыОрганизации.Аналитика6 = ДокументыЭтапов.Аналитика6
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСостоянияОбъектов КАК СостоянияОбъектов
		|		ПО (СостоянияОбъектов.Объект = ДокументыЭтапов.Документ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрМатрицыПолномочий КАК РегистрМатрицыПолномочий
		|		ПО ВсеЭтапыОрганизации.ДокументБД = РегистрМатрицыПолномочий.ДокументБД
		|			И ВсеЭтапыОрганизации.ШаблонДокумента = РегистрМатрицыПолномочий.ШаблонДокументаБД
		|			И ВсеЭтапыОрганизации.Организация = РегистрМатрицыПолномочий.Организация
		|			И (РегистрМатрицыПолномочий.ВерсияРегламентаПодготовкиОтчетности = ВсеЭтапыОрганизации.ВерсияРегламента)";
	
	// Дополнительные отборы
	Если ДополнительныеОтборы.Свойство("ДокументСсылка") И ЗначениеЗаполнено(ДополнительныеОтборы.ДокументСсылка) Тогда
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	ДокументыЭтапов.Документ = &ДокументСсылка";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов();
	
	Возврат Запрос;
	
КонецФункции

// Обработка этапа по переданным параметрам
//
// Параметры:
//	СтруктураПараметров	 - Структура - Структура полученная при помощи функции ПараметрыОбработкиЭтапов()
//	Действие			 - Строка - Строковое представление выполняемых действий. Возможны варианты:
//		ОтменитьОбработкуЭтапа
//		НачатьОбработкуЭтапа
//		ЗавершитьОбработкуЭтапа
//		СоздатьДокументыЭтапа
//		ОбработатьЭтап
//		ОбработатьЭтапыДоТекущего
//		ОбработатьИЗавершитьЭтапыДоТекущего
//
Процедура ОбработатьЭтап(СтруктураПараметров, Действие, ВызовИзРегламентногоЗадания = Ложь) Экспорт
	
	// Дополним структуру параметров недостающими параметрами
	ДополнитьСтруктуруПараметров(СтруктураПараметров);
	СтруктураПараметров.Отказ = Ложь;
	СтруктураПараметров.ДополнительныеОтборы.Вставить("СостояниеПроцесса", Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен);
	
	// Установим настройки обработки этапов, в зависимости от выполняемого действия
	Если Действие = "ОтменитьОбработкуЭтапов" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		СтруктураПараметров.Вставить("УстанавливатьСтатусДокументов", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОтменитьОбработкуЭтапа" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Последователи");
		
	ИначеЕсли Действие = "НачатьОбработкуЭтапа" Тогда
		
		// Получим предшественников текущего этапа с организациями
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
		// Проверим, что все предыдущие этапы завершены
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			Если НЕ СтрокаТаблицы.ТекущийЭтап Тогда
				// Есть незавершенные этапы нижнего уровня
				ТекстСообщения = НСтр("ru = 'Невозможно начать обработку этапа ""%1"", т. к. есть незавершенный подчиненный этап: ""%2""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					СтруктураПараметров.Этап, СтрокаТаблицы.Этап);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		// Отменим все этапы-последователи
		СтруктураПараметровКопия = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураПараметров);
		ОбработатьЭтап(СтруктураПараметровКопия, "ОтменитьОбработкуЭтапа");
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Неопределено);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ЗавершитьОбработкуЭтапа" Тогда
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		// Получим предшественников текущего этапа с организациями
		ТекущийЭтап = СтруктураПараметров.Этап;
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
		// Проверим, что все предыдущие этапы завершены
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			Если НЕ СтрокаТаблицы.ТекущийЭтап Тогда
				// Есть незавершенные этапы нижнего уровня
				ТекстСообщения = НСтр("ru = 'Невозможно завершить этап ""%1"", т. к. есть незавершенный подчиненный этап: ""%2""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ТекущийЭтап, СтрокаТаблицы.Этап);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Действие = "СоздатьДокументыЭтапа" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОбработатьЭтап" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОбработатьЭтапыДоТекущего" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
	ИначеЕсли Действие = "ОбработатьИЗавершитьЭтапыДоТекущего" Тогда
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		СтруктураПараметров.Вставить("УстанавливатьСтатусДокументов", Истина);
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
	КонецЕсли;
	
	ИспользоватьМногопоточностьДляЗаполненияОтчетности = Ложь;
	
	Если СтруктураПараметров.Свойство("ШаблонПроцесса") И ЗначениеЗаполнено(СтруктураПараметров.ШаблонПроцесса) Тогда
		ИспользоватьМногопоточностьДляШаблона = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПараметров.ШаблонПроцесса, "ИспользоватьМногопоточностьДляЗаполненияОтчетности");
		
		Если Не (ОбщегоНазначения.ИнформационнаяБазаФайловая() Или ОбщегоНазначения.РазделениеВключено()) Тогда
			ИспользоватьМногопоточностьДляЗаполненияОтчетности = ИспользоватьМногопоточностьДляШаблона;
		Иначе 
			ИспользоватьМногопоточностьДляЗаполненияОтчетности = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Обрабатываем все этапы таблицы
	Если ВызовИзРегламентногоЗадания И ИспользоватьМногопоточностьДляЗаполненияОтчетности Тогда
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне();
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обработка документов этапов подготовки отчетности'");
		
		ПараметрыПроцедуры = Новый Соответствие;
		
		ИмяПроцедуры = "УправлениеПроцессамиПодготовкиОтчетности.ОбработатьДокументыЭтаповВНесколькоПотоков";
		тЭтапыОрганизации.Колонки.Добавить("ЭтапОбработан", Новый ОписаниеТипов("Булево"));
		// Обрабатываем все этапы таблицы
		Если тЭтапыОрганизации.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ТекущийУровень = тЭтапыОрганизации[0].Уровень;
		ТекущийЭтап    = тЭтапыОрганизации[0].Этап;
		СоответствиеЭтапов = Новый Массив;
		ТЗТекущегоЭтапа = тЭтапыОрганизации.СкопироватьКолонки();
		НомерСтроки = 0;
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			Если СтрокаТаблицы.Уровень = ТекущийУровень И СтрокаТаблицы.Этап = ТекущийЭтап Тогда
				НоваяСтрока = ТЗТекущегоЭтапа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			Иначе
				СоответствиеЭтапов.Добавить(ТЗТекущегоЭтапа);
				ТЗТекущегоЭтапа = тЭтапыОрганизации.СкопироватьКолонки();
				НоваяСтрока = ТЗТекущегоЭтапа.Добавить();
				ТекущийУровень = СтрокаТаблицы.Уровень;
				ТекущийЭтап    = СтрокаТаблицы.Этап;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки = тЭтапыОрганизации.Количество() Тогда
				СоответствиеЭтапов.Добавить(ТЗТекущегоЭтапа);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Стр Из СоответствиеЭтапов Цикл
			ПараметрыПроцедуры = Новый Соответствие;
			Для Каждого СтрокаТаблицы Из Стр Цикл
				
				НоваяСтруктураПараметров = ОбщегоНазначения.СкопироватьРекурсивно(
					СтруктураПараметров);
				ЗаполнитьЗначенияСвойств(НоваяСтруктураПараметров, СтрокаТаблицы);
				МассивПараметров = Новый Массив;
				МассивПараметров.Добавить(НоваяСтруктураПараметров);
				ПараметрыПроцедуры.Вставить(НоваяСтруктураПараметров.Организация.Наименование + Новый УникальныйИдентификатор, МассивПараметров);
				
			КонецЦикла;
			ИдентификаторРезультата = Новый УникальныйИдентификатор();
			ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторРезультата);
			ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обработка документов этапов подготовки отчетности'");
			ПараметрыВыполнения.ОжидатьЗавершение = Неопределено;
	
			ИмяПроцедуры = "УправлениеПроцессамиПодготовкиОтчетности.ОбработатьДокументыЭтаповВНесколькоПотоков";
			
			Результат = ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков(ИмяПроцедуры,
				ПараметрыВыполнения, ПараметрыПроцедуры);
				
			Если Результат.Статус = "Выполнено" Тогда
				РезультатМногопоточнойДлительнойОперации = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
				Для Каждого Стр Из РезультатМногопоточнойДлительнойОперации Цикл
					РезультатДлительнойОперации = ПолучитьИзВременногоХранилища(Стр.Значение.АдресРезультата);
					СтруктураПараметров.Отказ = РезультатДлительнойОперации.Отказ;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
			
	Иначе
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураПараметров, СтрокаТаблицы);
			// Обрабатываем этапы подготовки отчетности
			ОбработатьДокументыЭтапа(СтруктураПараметров);
				
			Если Действие = "СоздатьДокументыЭтапа" Тогда
				// При создании документов менять состояние
				Продолжить;
			КонецЕсли;
			
			// Меням состояние этапа
			УстановитьСостояниеЭтапа(СтруктураПараметров, СтруктураПараметров.Отказ);
			
			Если СтруктураПараметров.Отказ
				И СтруктураПараметров.УстанавливатьСостояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
				// Если требуется утверждать этапы, то останавливаемся
				Возврат;
			КонецЕсли;
			
		КонецЦикла;
	
		
	КонецЕсли;
	
КонецПроцедуры
	
// Обработка этапа по переданным параметрам
//
// Параметры:
//	СтруктураПараметров	 - Структура - Структура полученная при помощи функции ПараметрыОбработкиЭтапов()
//	Действие			 - Строка - Строковое представление выполняемых действий. Возможны варианты:
//		ОтменитьОбработкуЭтапа
//		НачатьОбработкуЭтапа
//		ЗавершитьОбработкуЭтапа
//		СоздатьДокументыЭтапа
//		ОбработатьЭтап
//		ОбработатьЭтапыДоТекущего
//		ОбработатьИЗавершитьЭтапыДоТекущего
//
Функция ОбработатьЭтапВФоне(СтруктураПараметров, Действие, ИдентификаторРезультата = Неопределено) Экспорт
	
	// Дополним структуру параметров недостающими параметрами
	ДополнитьСтруктуруПараметров(СтруктураПараметров);
	СтруктураПараметров.Отказ = Ложь;
	СтруктураПараметров.ДополнительныеОтборы.Вставить("СостояниеПроцесса", Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен);
	
	// Установим настройки обработки этапов, в зависимости от выполняемого действия
	Если Действие = "ОтменитьОбработкуЭтапов" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		СтруктураПараметров.Вставить("УстанавливатьСтатусДокументов", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОтменитьОбработкуЭтапа" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Последователи");
		
	ИначеЕсли Действие = "НачатьОбработкуЭтапа" Тогда
		
		// Получим предшественников текущего этапа с организациями
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
		// Проверим, что все предыдущие этапы завершены
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			Если НЕ СтрокаТаблицы.ТекущийЭтап Тогда
				// Есть незавершенные этапы нижнего уровня
				ТекстСообщения = НСтр("ru = 'Невозможно начать обработку этапа ""%1"", т. к. есть незавершенный подчиненный этап: ""%2""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					СтруктураПараметров.Этап, СтрокаТаблицы.Этап);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
		// Отменим все этапы-последователи
		СтруктураПараметровКопия = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураПараметров);
		ОбработатьЭтап(СтруктураПараметровКопия, "ОтменитьОбработкуЭтапа");
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Неопределено);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ЗавершитьОбработкуЭтапа" Тогда
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		// Получим предшественников текущего этапа с организациями
		ТекущийЭтап = СтруктураПараметров.Этап;
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
		// Проверим, что все предыдущие этапы завершены
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			Если НЕ СтрокаТаблицы.ТекущийЭтап Тогда
				// Есть незавершенные этапы нижнего уровня
				ТекстСообщения = НСтр("ru = 'Невозможно завершить этап ""%1"", т. к. есть незавершенный подчиненный этап: ""%2""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ТекущийЭтап, СтрокаТаблицы.Этап);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Действие = "СоздатьДокументыЭтапа" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОбработатьЭтап" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОбработатьЭтапыДоТекущего" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
	ИначеЕсли Действие = "ОбработатьИЗавершитьЭтапыДоТекущего" Тогда
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		СтруктураПараметров.Вставить("УстанавливатьСтатусДокументов", Истина);
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
	КонецЕсли;
	
	Если ИдентификаторРезультата = Неопределено Тогда 
		ИдентификаторРезультата = Новый УникальныйИдентификатор;
	КонецЕсли;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторРезультата);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обработка документов этапов подготовки отчетности'");
	
	ПараметрыПроцедуры = Новый Соответствие;
	
	ИмяПроцедуры = "УправлениеПроцессамиПодготовкиОтчетности.ОбработатьДокументыЭтаповВНесколькоПотоков";
	
	// Обрабатываем все этапы таблицы
	Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
		НоваяСтруктураПараметров = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураПараметров);
		ЗаполнитьЗначенияСвойств(НоваяСтруктураПараметров, СтрокаТаблицы);
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(НоваяСтруктураПараметров);
		
		Если Действие = "СоздатьДокументыЭтапа" Тогда
			// При создании документов менять состояние
			Продолжить;
		КонецЕсли;
		
		ПараметрыПроцедуры.Вставить(НоваяСтруктураПараметров.Организация.Наименование + Новый УникальныйИдентификатор, МассивПараметров);
		
	КонецЦикла;
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуруВНесколькоПотоков(ИмяПроцедуры,
		ПараметрыВыполнения, ПараметрыПроцедуры);
	
КонецФункции

Функция ОбработатьДокументыЭтаповВНесколькоПотоков(СтруктураПараметров) Экспорт
	
	КоличествоДокументов = 0;
	// Обрабатываем этапы подготовки отчетности
	ОбработатьДокументыЭтапа(СтруктураПараметров, КоличествоДокументов);
	
	// Меням состояние этапа
	УстановитьСостояниеЭтапа(СтруктураПараметров, СтруктураПараметров.Отказ);
	ОбщегоНазначения.СообщитьПользователю(
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Обработано документов:%1'"),
			КоличествоДокументов));
	ДлительныеОперации.СообщитьПрогресс(, КоличествоДокументов);
	
	Если СтруктураПараметров.Отказ
		И СтруктураПараметров.УстанавливатьСостояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
		// Если требуется утверждать этапы, то останавливаемся
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции

// По имени объекта метаданных определят, что это объект процесса подготовки отчетности
//
// Параметры:
//  Наименование - Строка - Наименование объекта метаданных
// 
// Возвращаемое значение:
//   - Булево - "Истина" - объекта процесса подготовки отчетности, "Ложь" - в противном случае
//
Функция ЭтоДокументПроцессаПодготовкиОтчетности(Наименование) Экспорт
	
	Если Метаданные.Документы.Найти(Наименование) = Неопределено Тогда
		// Это не документ
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.ОпределяемыеТипы.ДокументыПроцессаПодготовкиОтчетности.Тип.СодержитТип(Тип("ДокументОбъект." + Наименование));
	
КонецФункции

// Функция - Ключевой срез в рамках процесса подготовки отчетности
//
// Параметры:
//  ДанныеКлючевогоСреза	 - Структура - Структура с данными проверяемого среза
//  ИмяОбъектаМетаданного	 - Строка - Имя документа метаданных для которого осуществляется проверка
// 
// Возвращаемое значение:
//   - Булево - "Истина" - ключевой срез в рамках процесса, "Ложь" - иначе
//
Функция КлючевойСрезВРамкахПроцессаПодготовкиОтчетности(ДанныеКлючевогоСреза, ИмяОбъектаМетаданного="НастраиваемыйОтчет") Экспорт
	
	ДанныеДокументаБД = БюджетированиеИОтчетностьПовтИсп.ДанныеДокументаБД(ИмяОбъектаМетаданного);
	Если НЕ ДанныеДокументаБД.ИспользуетсяВПроцессе Тогда
		Возврат Истина;
	КонецЕсли;
	
	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ДанныеКлючевогоСреза);
	СтруктураПараметров.ДополнительныеОтборы.Вставить("ДокументБД", ДанныеДокументаБД.Ссылка);
	СтруктураПараметров.ДополнительныеОтборы.Вставить("СостояниеПроцесса", Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен);
	
	Запрос = ЗапросПоДаннымЭтаповДокументов(СтруктураПараметров);
	Если Запрос = Неопределено Тогда
		// Не найден запущенный процесс по срезу
		Возврат Истина;
	КонецЕсли;
	
	// Необходимо также выполнить проверку, что документ находится в рамках процесса подготовки отчетности
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтапов.Этап КАК Этап
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов
		|		ПО (ДанныеЭтаповДокументов.Этап = ДанныеЭтапов.Этап)
		|			И (ДанныеЭтаповДокументов.Организация = ДанныеЭтапов.Организация)
		|ГДЕ
		|	ИСТИНА";
		
	ДобавитьОтборВЗапрос(Запрос, ДанныеКлючевогоСреза, ДанныеДокументаБД.РеквизитРазделенияПоОрганизациям, "ДанныеЭтапов.Организация");
	ДобавитьОтборВЗапрос(Запрос, ДанныеКлючевогоСреза, ДанныеДокументаБД.РеквизитШаблонаДокумента, "ДанныеЭтаповДокументов.ШаблонДокумента");
	ДобавитьОтборВЗапрос(Запрос, ДанныеКлючевогоСреза, "Проект", "ДанныеЭтаповДокументов.Проект");
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ДобавитьОтборВЗапрос(Запрос, ДанныеКлючевогоСреза, "Аналитика" + Сч, "ДанныеЭтаповДокументов.Аналитика" + Сч);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

#Область ПроцессПодготовкиОтчетности

// Запускает процесс подготовки отчетности
//
// Параметры:
//  УправлениеПериодом	 - ДокументСсылка.УправлениеПериодомСценария - Документ управления периодом
//  ЕстьОшибкиНастройки	 - Булево - Изменяемый параметр, возвращает признак того, что есть ошибки настроек данных регламента
// 
// Возвращаемое значение:
//   - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ЗапуститьПроцессПодготовкиОтчетности(УправлениеПериодом, ЕстьОшибкиНастройки = Ложь) Экспорт
	
	Если НЕ ИспользуетсяПроцессПодготовкиОтчетности(УправлениеПериодом) Тогда
		ТекстСообщения = Нстр("ru = 'В связанном регламенте подготовки отчетности не используется процесс подготовки отчетности.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// Получим ключевые параметры
	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	СтруктураПараметров.Вставить("УправлениеПериодом", УправлениеПериодом);
	ДополнитьСтруктуруПараметров(СтруктураПараметров);
	
	Если ЕстьОшибкиНастройки Тогда
		ТекстСообщения = Нстр("ru = 'Имеются ошибки настройки правил заполнения отчетов.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		ОповеститьОтветственных(Справочники.ВидыСобытийОповещений.ОшибкаПриЗапускеПроцесса, УправлениеПериодом);
		Возврат Ложь;
	КонецЕсли;
	
	// Заполним организационные единицы
	Если НЕ ЗаполнитьОрганизационныеЕдиницыЭтапов(СтруктураПараметров.ВерсияРегламента) Тогда
		ОповеститьОтветственных(Справочники.ВидыСобытийОповещений.ОшибкаПриЗапускеПроцесса, УправлениеПериодом);
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим, что нет дублирующих строк в этапах процесса
	Если ЕстьДублиСтрокВЭтапахПроцесса(СтруктураПараметров) Тогда
		ОповеститьОтветственных(Справочники.ВидыСобытийОповещений.ОшибкаПриЗапускеПроцесса, УправлениеПериодом);
		Возврат Ложь;
	КонецЕсли;
	
	// Установим состояние процесса подготовки отчетности
	МенеджерЗаписи = РегистрыСведений.СостоянияПроцессаПодготовкиОтчетности.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УправлениеПериодомСценария = УправлениеПериодом;
	МенеджерЗаписи.Состояние = Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен;
	ДатаНачалаПроцесса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправлениеПериодом, "ДатаНачалаПроцесса");
	Если НЕ ЗначениеЗаполнено(ДатаНачалаПроцесса) Тогда
		ДатаНачалаПроцесса = ТекущаяДатаСеанса();
	КонецЕсли;
	МенеджерЗаписи.ДатаНачала = ДатаНачалаПроцесса;
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось записать регистр сведений ""Состояния процесса подготовки отчетности"", по причине: %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		ОповеститьОтветственных(Справочники.ВидыСобытийОповещений.ОшибкаПриЗапускеПроцесса, УправлениеПериодом);
		Возврат Ложь;
	КонецПопытки;
	
	// Отменим обработку этапа, если она уже была выполнена ранее
	ОбработатьЭтап(СтруктураПараметров, "ОтменитьОбработкуЭтапов");
	
	Если СтруктураПараметров.Отказ Тогда
		ОповеститьОтветственных(Справочники.ВидыСобытийОповещений.ОшибкаПриЗапускеПроцесса, УправлениеПериодом);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Останавливает процесс подготовки отчетности
//
// Параметры:
//  УправлениеПериодом	 - ДокументСсылка.УправлениеПериодомСценария - Документ управления периодом
// 
// Возвращаемое значение:
//   - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ОстановитьПроцессПодготовкиОтчетности(УправлениеПериодом) Экспорт
	
	Если НЕ ИспользуетсяПроцессПодготовкиОтчетности(УправлениеПериодом) Тогда
		ТекстСообщения = Нстр("ru = 'В связанном регламенте подготовки отчетности не используется процесс подготовки отчетности.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// Получим ключевые параметры
	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	СтруктураПараметров.Вставить("УправлениеПериодом", УправлениеПериодом);
	
	// Отменим обработку всех этапов
	ОбработатьЭтап(СтруктураПараметров, "ОтменитьОбработкуЭтапов");
	Если СтруктураПараметров.Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Установим состояние процесса подготовки отчетности
	МенеджерЗаписи = РегистрыСведений.СостоянияПроцессаПодготовкиОтчетности.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УправлениеПериодомСценария = УправлениеПериодом;
	МенеджерЗаписи.Состояние = Перечисления.СостоянияПроцессаПодготовкиОтчетности.НеЗапущен;
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось запустить процесс подготовки отчетности: %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Проверяет, запущен ли процесс подготовки отчетности
//
// Параметры:
//  Источник - Ссылка - Ссылка на объект отчетности
// 
// Возвращаемое значение:
//   - Булево - "Истина" - процесс запущен, "Ложь" - процесс не запущен
//
Функция ЗапущенПроцессПодготовкиОтчетности(Источник) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	СтруктураПараметров.ДополнительныеОтборы.Вставить("СостояниеПроцесса", Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен);
	
	Если ТипЗнч(Источник) = Тип("ДокументСсылка.УправлениеПериодомСценария") Тогда
		СтруктураПараметров.Вставить("УправлениеПериодом", Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ВерсииРегламентовПодготовкиОтчетности") Тогда
		СтруктураПараметров.Вставить("ВерсияРегламента", Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ШаблоныУниверсальныхПроцессов") Тогда
		СтруктураПараметров.Вставить("ШаблонПроцесса", Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ЭтапыУниверсальныхПроцессов") Тогда
		СтруктураПараметров.Вставить("Этап", Источник);
	КонецЕсли;
	
	Запрос = ЗапросПоДаннымЭтапов(СтруктураПараметров);
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ 
		|	ДанныеЭтапов.СостояниеПроцесса КАК СостояниеПроцесса
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Проверяет, что используется процесс подготовки отчетности
//
// Параметры:
//  УправлениеПериодом	 - ДокументСсылка.УправлениеПериодомСценария - Документ управления периодом
// 
// Возвращаемое значение:
//   - Булево - "Истина" - процесс используется, "Ложь" - процесс не используется
//
Функция ИспользуетсяПроцессПодготовкиОтчетности(УправлениеПериодом) Экспорт
	
	Если НЕ ЗначениеЗаполнено(УправлениеПериодом) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УправлениеПериодом", УправлениеПериодом);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсииРегламентовПодготовкиОтчетности.ШаблонПроцесса КАК ШаблонПроцесса
		|ИЗ
		|	Документ.УправлениеПериодомСценария КАК УправлениеПериодомСценария
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииРегламентовПодготовкиОтчетности
		|		ПО УправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры = ВерсииРегламентовПодготовкиОтчетности.Ссылка
		|			И (НЕ ВерсииРегламентовПодготовкиОтчетности.ПометкаУдаления)
		|			И (ВерсииРегламентовПодготовкиОтчетности.ИспользоватьПроцесс)
		|ГДЕ
		|	УправлениеПериодомСценария.Ссылка = &УправлениеПериодом";
	
	Результат = Запрос.Выполнить();
	Возврат НЕ Результат.Пустой();
	
КонецФункции

// Возвращает шаблон процесса подготовки отчетности
//
// Параметры:
//  ВерсияРегламента - СправочникСсылка.ВерсииРегламентовПодготовкиОтчетности - Регламент
// 
// Возвращаемое значение:
//   - СправочникСсылка.ШаблоныУниверсальныхПроцессов - Возвращаемый элемент
//
Функция ШаблонПроцессаПодготовкиОтчетности(ВерсияРегламента) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВерсияРегламента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВерсияРегламента", ВерсияРегламента);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсииРегламентовПодготовкиОтчетности.ШаблонПроцесса КАК ШаблонПроцесса
		|ИЗ
		|	Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииРегламентовПодготовкиОтчетности
		|ГДЕ
		|	ВерсииРегламентовПодготовкиОтчетности.Ссылка = &ВерсияРегламента
		|	И НЕ ВерсииРегламентовПодготовкиОтчетности.ПометкаУдаления
		|	И ВерсииРегламентовПодготовкиОтчетности.ИспользоватьПроцесс";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ШаблонПроцесса;
	
КонецФункции

#КонецОбласти

#Область ОбработкаЭтаповПодготовкиОтчетности

// Рассчитывает уровни этапов, результат записывается в регистр сведений "УровниЭтаповУниверсальныхПроцессов"
//
// Параметры:
//	ШаблонПроцесса	 - СправочникСсылка.ШаблоныУниверсальныхПроцессов - Шаблон процесса для которого будут обрабатываться этапы
//	Отказ			 - Булево - В случае ошибки устанавливается в значение Истина
//
Процедура РассчитатьУровниЭтапов(ШаблонПроцесса, Отказ=Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭтапыУниверсальныхПроцессов.Ссылка КАК Этап,
		|	ЕСТЬNULL(УровниЭтаповУниверсальныхПроцессов.Уровень, 0) КАК Уровень
		|ПОМЕСТИТЬ втВсеЭтапы
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УровниЭтаповУниверсальныхПроцессов КАК УровниЭтаповУниверсальныхПроцессов
		|		ПО (УровниЭтаповУниверсальныхПроцессов.Этап = ЭтапыУниверсальныхПроцессов.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныУниверсальныхПроцессов КАК ШаблоныУниверсальныхПроцессов
		|		ПО ЭтапыУниверсальныхПроцессов.Владелец = ШаблоныУниверсальныхПроцессов.Ссылка
		|ГДЕ
		|	НЕ ЭтапыУниверсальныхПроцессов.ПометкаУдаления
		|	И ЭтапыУниверсальныхПроцессов.Владелец = &Владелец
		|	И ШаблоныУниверсальныхПроцессов.НазначениеПроцесса = ЗНАЧЕНИЕ(Перечисление.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Этап КАК Этап,
		|	ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Ссылка КАК ЭтапПоследователь,
		|	0 КАК Уровень
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов.ЭтапыПредшественники КАК ЭтапыУниверсальныхПроцессовЭтапыПредшественники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВсеЭтапы КАК ВсеЭтапы
		|		ПО ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Этап = ВсеЭтапы.Этап";
	
	Запрос.УстановитьПараметр("Владелец", ШаблонПроцесса);

	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	тзЭтапы = РезультатЗапроса.Получить(0).Выгрузить();
	тзЭтапыПоследователи = РезультатЗапроса.Получить(1).Выгрузить();
	
	Для Каждого СтрокаЭтап Из тзЭтапы Цикл
		Уровень = РассчитатьУровеньЭтапаРекурсивно(СтрокаЭтап.Этап, тзЭтапыПоследователи);
		НайденныеСтроки = тзЭтапыПоследователи.НайтиСтроки(Новый Структура("Этап", СтрокаЭтап.Этап));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Уровень = Уровень;
		КонецЦикла;
		Если Уровень <> СтрокаЭтап.Уровень Тогда
			МенеджерЗаписи = РегистрыСведений.УровниЭтаповУниверсальныхПроцессов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Этап = СтрокаЭтап.Этап;
			МенеджерЗаписи.Уровень = Уровень;
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстСообщения = НСтр("ru = 'Не удалось записать уровень этапа ""%1"", по причине: %2'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					СтрокаЭтап.Этап, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет организационные единицы этапов, результат записывает в регистр сведений "ОрганизационныеЕдиницыЭтаповПроцессов"
//
// Параметры:
//  ВерсияРегламента - СправочникСсылка.ВерсииРегламентовПодготовкиОтчетности - Регламент
//  Этап			 - СправочникСсылка.ЭтапыУниверсальныхПроцессов - Этап
// 
// Возвращаемое значение:
//   - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ЗаполнитьОрганизационныеЕдиницыЭтапов(ВерсияРегламента, Этап=Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВерсияРегламента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Получим организации регламента
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиница КАК ОрганизационнаяЕдиница,
		|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиницаРодитель КАК ОрганизационнаяЕдиницаРодитель,
		|	ЕСТЬNULL(ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы.ВидОрганизационнойЕдиницы, ЗНАЧЕНИЕ(Справочник.ВидыОрганизационныхЕдиниц.ПустаяСсылка)) КАК ВидОрганизационнойЕдиницы,
		|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиница.ЭлиминирующаяОрганизация КАК ЭлиминирующаяОрганизация
		|ПОМЕСТИТЬ втОрганизационныеЕдиницыРегламента
		|ИЗ
		|	Справочник.ВерсииРегламентовПодготовкиОтчетности.СтруктураГруппы КАК ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности.ОрганизационныеЕдиницы КАК ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы
		|		ПО ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.Ссылка = ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы.Ссылка
		|			И ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиница = ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы.ОрганизационнаяЕдиница
		|ГДЕ
		|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.Ссылка = &ВерсияРегламента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОрганизационныеЕдиницыРегламента.ОрганизационнаяЕдиница КАК ОрганизационнаяЕдиница,
		|	ВЫБОР
		|		КОГДА КОЛИЧЕСТВО(ОрганизационныеЕдиницыРегламентаРодитель.ОрганизационнаяЕдиницаРодитель) > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
		|		КОГДА ОрганизационныеЕдиницыРегламента.ЭлиминирующаяОрганизация
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Элиминирующая)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Обычная)
		|	КОНЕЦ КАК ТипОрганизационнойЕдиницы,
		|	ОрганизационныеЕдиницыРегламента.ВидОрганизационнойЕдиницы КАК ВидОрганизационнойЕдиницы
		|ИЗ
		|	втОрганизационныеЕдиницыРегламента КАК ОрганизационныеЕдиницыРегламента
		|		ЛЕВОЕ СОЕДИНЕНИЕ втОрганизационныеЕдиницыРегламента КАК ОрганизационныеЕдиницыРегламентаРодитель
		|		ПО ОрганизационныеЕдиницыРегламента.ОрганизационнаяЕдиница = ОрганизационныеЕдиницыРегламентаРодитель.ОрганизационнаяЕдиницаРодитель
		|
		|СГРУППИРОВАТЬ ПО
		|	ОрганизационныеЕдиницыРегламента.ОрганизационнаяЕдиница,
		|	ОрганизационныеЕдиницыРегламента.ВидОрганизационнойЕдиницы,
		|	ОрганизационныеЕдиницыРегламента.ЭлиминирующаяОрганизация";
	
	Запрос.УстановитьПараметр("ВерсияРегламента", ВерсияРегламента);
	
	тОрганизацииРегламента = Запрос.Выполнить().Выгрузить();
	Если тОрганизацииРегламента.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = Справочники.ЭтапыУниверсальныхПроцессов.ПолучитьМакет("ОтборОрганизационныхЕдиниц");
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор());
	
	ОрганизационныеЕдиницыОтборСКД = Новый КомпоновщикНастроекКомпоновкиДанных;
	ОрганизационныеЕдиницыОтборСКД.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	
	ВнешниеНаборыДанных = Новый Структура;
	
	// Получим и запишем организации для каждого этапа процесса
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЭтапыУниверсальныхПроцессов.Ссылка КАК Этап,
		|	ЭтапыУниверсальныхПроцессов.ТипОрганизацийЭтапа КАК ТипОрганизацийЭтапа,
		|	ЭтапыУниверсальныхПроцессов.ОрганизационныеЕдиницыОтбор КАК ОрганизационныеЕдиницыОтбор
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
		|ГДЕ
		|	НЕ ЭтапыУниверсальныхПроцессов.ПометкаУдаления
		|	И НЕ ЭтапыУниверсальныхПроцессов.ЭтоГруппа
		|	И НЕ ЭтапыУниверсальныхПроцессов.ДинамическийЭтап";
	
	Если ЗначениеЗаполнено(Этап) Тогда
		// По конкретному этапу
		Запрос.Текст = Запрос.Текст + "
		|	И ЭтапыУниверсальныхПроцессов.Ссылка = &Этап";
		Запрос.УстановитьПараметр("Этап", Этап);
	Иначе
		// По этапам шаблона регламента процесса
		Запрос.Текст = Запрос.Текст + "
		|	И ЭтапыУниверсальныхПроцессов.Владелец В (ВЫБРАТЬ
		|		ВерсииРегламентовПодготовкиОтчетности.ШаблонПроцесса КАК ШаблонПроцесса
		|	ИЗ
		|		Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииРегламентовПодготовкиОтчетности
		|	ГДЕ
		|		ВерсииРегламентовПодготовкиОтчетности.Ссылка = &ВерсияРегламента)";
		Запрос.УстановитьПараметр("Этап", Этап);
	КонецЕсли;
	
	Отказ = Ложь;
	ВыборкаПоЭтапам = Запрос.Выполнить().Выбрать();
	Пока ВыборкаПоЭтапам.Следующий() Цикл
		
		НастройкиСКД = ВыборкаПоЭтапам.ОрганизационныеЕдиницыОтбор.Получить();
		Если НастройкиСКД = Неопределено Тогда
			НастройкиСКД = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		КонецЕсли;
		
		ОрганизационныеЕдиницыОтборСКД.ЗагрузитьНастройки(НастройкиСКД);

		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, 
			ОрганизационныеЕдиницыОтборСКД.ПолучитьНастройки(),,,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
			
		тОрганизацииРегламентаСОтбором = тОрганизацииРегламента.Скопировать(
			Новый Структура("ТипОрганизационнойЕдиницы", ВыборкаПоЭтапам.ТипОрганизацийЭтапа));
		ВнешниеНаборыДанных.Вставить("ТЗДанные", тОрганизацииРегламентаСОтбором);
		
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);
		
		тОрганизацииЭтапа = Новый ТаблицаЗначений;
		ПроцессорВывода.УстановитьОбъект(тОрганизацииЭтапа);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
		Если тОрганизацииЭтапа.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось сформировать список организаций для этапа ""%1"".
			|	В настройках этапа установлены противоречивые отборы, либо отборы не соответствующие структуре организаций регламента ""%2"".'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				ВыборкаПоЭтапам.Этап, ВерсияРегламента);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
		Иначе
			
			// Обновим организации в регистре "ОрганизационныеЕдиницыЭтаповПроцессов"
			НаборЗаписей = РегистрыСведений.ОрганизационныеЕдиницыЭтаповПроцессов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВерсияРегламентаПодготовкиОтчетности.Установить(ВерсияРегламента);
			НаборЗаписей.Отбор.ЭтапПроцесса.Установить(ВыборкаПоЭтапам.Этап);
			
			Для Каждого СтрокаТаблицы Из тОрганизацииЭтапа Цикл
				нЗапись = НаборЗаписей.Добавить();
				нЗапись.ВерсияРегламентаПодготовкиОтчетности = ВерсияРегламента;
				нЗапись.ОрганизационнаяЕдиница = СтрокаТаблицы.ОрганизационнаяЕдиница;
				нЗапись.ЭтапПроцесса = ВыборкаПоЭтапам.Этап;
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать();
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстСообщения = НСтр("ru = 'Не удалось записать список организаций для этапа ""%1"", по причине: %2'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ВыборкаПоЭтапам.Этап, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
				Прервать;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НЕ Отказ;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиПодписок

// Процедура - Обработать связанный этап при изменении состояния объекта
//
// Параметры:
//  Источник		 - ДокументСсылка - Ссылка на документ для которого изменилось состояние
//  СостояниеОбъекта - ПеречислениеСсылка.СостоянияОтчетов - Новое состояние документа
//  Отказ			 - Булево - Если отказ от записи устанавливается в значение "Истина"
//
Процедура ОбработатьСвязанныйЭтапПриИзмененииСостоянияОбъекта(Источник, СостояниеОбъекта, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВыборкаПоЭтапам = ВыборкаПоЭтапамДокумента(Источник);
	Если ВыборкаПоЭтапам = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Пока ВыборкаПоЭтапам.Следующий() Цикл
		СтруктураПараметров = ПараметрыОбработкиЭтапов();
		СтруктураПараметров.ВыводитьСообщения = Истина;
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, ВыборкаПоЭтапам);
		Если СостояниеОбъекта = Перечисления.СостоянияОтчетов.Утвержден Тогда
			// Проверим, не надо ли закрыть связанный с объектом этап
			УстановитьСостояниеЭтапаПоУтвержденнымДокументам(СтруктураПараметров, Отказ);
		ИначеЕсли ВыборкаПоЭтапам.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен
			ИЛИ ВыборкаПоЭтапам.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен Тогда
			// Связанный с объектом этап необходимо открыть
			СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке);
			УстановитьСостояниеЭтапа(СтруктураПараметров, Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Обработчик подписки "ПриЗаписиОбъектаПроцессаПодготовкиОтчетности"
//
// Параметры:
//  Источник - ДокументОбъект - Записываемый документ
//  Отказ	 - Булево - Если отказ от записи устанавливается в значение "Истина"
//
Процедура ПриЗаписиОбъектаПроцессаПодготовкиОтчетности(Источник, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВыборкаПоЭтапам = ВыборкаПоЭтапамДокумента(Источник, Отказ);
	Если ВыборкаПоЭтапам = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Проверен = Ложь;
	Пока ВыборкаПоЭтапам.Следующий() Цикл
		
		// Проверим, можно ли записать документ
		Если ВыборкаПоЭтапам.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
			
			ТекстСообщения = НСтр("ru = 'Документ ""%1"" участвует в этапе подготовки отчетности ""%2"", который находится в состоянии ""Завершен"".
			|Для изменения документа откройте указанный этап процесса подготовки отчетности.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Источник, ВыборкаПоЭтапам.Этап);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
			Проверен = Истина;
		
		// Проверим связанные этапы, если документ не согласуется
		ИначеЕсли НЕ ВыборкаПоЭтапам.Согласуется Тогда
		
			СтруктураПараметров = ПараметрыОбработкиЭтапов();
			СтруктураПараметров.ВыводитьСообщения = Истина;
			ЗаполнитьЗначенияСвойств(СтруктураПараметров, ВыборкаПоЭтапам);
			Если Источник.Проведен Тогда
				// Проверим, не надо ли закрыть связанный с объектом этап
				УстановитьСостояниеЭтапаПоУтвержденнымДокументам(СтруктураПараметров, Отказ);
				Проверен = Истина;
			ИначеЕсли ВыборкаПоЭтапам.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
				// Связанный с объектом этап необходимо открыть
				СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке);
				УстановитьСостояниеЭтапа(СтруктураПараметров, Отказ);
				Проверен = Истина
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Проверен И НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Источник)) Тогда
		// Защита от перезаписи объекта в одной транзакции
		Источник.ДополнительныеСвойства.Вставить("ДокументПроцессаПодготовкиОтчетностиПроверен", Истина);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик подписки "ОбработкаПроверкиЗаполненияОбъектаНастройкиПроцессаПодготовкиОтчетности"
//
// Параметры:
//  Источник				 - Объект - Проверяемый документ
//  Отказ					 - Булево - Если отказ от записи устанавливается в значение "Истина"
//  ПроверяемыеРеквизиты	 - Массив - Массив проверяемых реквизитов
//
Процедура ОбработкаПроверкиЗаполненияОбъектаНастройкиПроцессаПодготовкиОтчетности(Источник, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	Если Источник.ОбменДанными.Загрузка 
		ИЛИ Источник.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.ШаблоныУниверсальныхПроцессов")
		И (Источник.ЭтоГруппа ИЛИ НЕ Источник.ШаблонПроцессаПодготовкиОтчетности) Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ЗакрытиеПериода") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗапущенПроцессПодготовкиОтчетности(Источник.Ссылка) Тогда
		
		ТекстСообщения = НСтр("ru = 'Объект ""%1"" связан с процессом подготовки отчетности, который находится в состоянии ""Запущен"".
		|Для изменения объекта остановите процесс подготовки отчетности.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Источник);
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиРегламентныхЗаданий

// Обработка регламентного задания ВыполнениеДействийПоРасписаниюЭтапов
//
// Параметры:
//	Этап - СправочникСсылка.ЭтапыУниверсальныхПроцессов - Этап для обработки 
//
Процедура ВыполнитьДействияПоРасписаниюЭтапов(Этап = Неопределено) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ВыполнениеДействийПоРасписаниюЭтапов);

	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	СтруктураПараметров.Вставить("Этап", Этап);
	СтруктураПараметров.ДополнительныеОтборы.Вставить("СостояниеПроцесса", Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен);
	СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
	
	Запрос = ЗапросПоДаннымЭтапов(СтруктураПараметров);
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтапов.Уровень КАК Уровень,
		|	ДанныеЭтапов.УправлениеПериодом КАК УправлениеПериодом,
		|	ДанныеЭтапов.Этап КАК Этап,
		|	ДанныеЭтапов.Организация КАК Организация,
		|	ЭтапыУниверсальныхПроцессов.ДействиеПоРасписанию КАК ДействиеПоРасписанию
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
		|		ПО ДанныеЭтапов.Этап = ЭтапыУниверсальныхПроцессов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыРегламентныхЗаданий КАК ИдентификаторыРегламентныхЗаданий
		|		ПО ДанныеЭтапов.Этап = ИдентификаторыРегламентныхЗаданий.Объект
		|ГДЕ
		|	НЕ ДанныеЭтапов.ПериодЗакрыт
		|	И ДанныеЭтапов.ЕстьДействиеПоРасписанию
		|	И НЕ ЭтапыУниверсальныхПроцессов.ПометкаУдаления
		|	И &ОтборПоЭтапуИдентификатору
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеЭтапов.Уровень,
		|	ДанныеЭтапов.ПорядковыйНомер
		|ИТОГИ ПО
		|	УправлениеПериодом,
		|	Уровень,
		|	Этап";
	
	Если ЗначениеЗаполнено(Этап) Тогда
		// Задание по одному этапу
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ОтборПоЭтапуИдентификатору", "");
	Иначе
		// По этапам без отдельного регламентного задания
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоЭтапуИдентификатору", "ИдентификаторыРегламентныхЗаданий.УникальныйИдентификатор ЕСТЬ NULL");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	КэшОбработанныхЭтапов = Новый Соответствие;
	
	ВыборкаУправлениеПериодом = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаУправлениеПериодом.Следующий() Цикл
	
		ВыборкаУровень = ВыборкаУправлениеПериодом.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаУровень.Следующий() Цикл
	
			ВыборкаЭтап = ВыборкаУровень.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЭтап.Следующий() Цикл
				Действие = Неопределено;
	 			МассивОрганизаций = Новый Массив;
				ВыборкаДетальныеЗаписи = ВыборкаЭтап.Выбрать();
				СтруктураПараметров = ПараметрыОбработкиЭтапов();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					МассивОрганизаций.Добавить(ВыборкаДетальныеЗаписи.Организация);
					Действие = КэшОбработанныхЭтапов.Получить(ВыборкаДетальныеЗаписи.ДействиеПоРасписанию);
					Если Действие = Неопределено Тогда
						ИндексПеречисления = Перечисления.ДействияЭтапаПоРасписанию.Индекс(ВыборкаДетальныеЗаписи.ДействиеПоРасписанию);
						Действие = ВыборкаДетальныеЗаписи.ДействиеПоРасписанию.Метаданные().ЗначенияПеречисления.Получить(ИндексПеречисления).Имя;
						КэшОбработанныхЭтапов.Вставить(ВыборкаДетальныеЗаписи.ДействиеПоРасписанию, Действие);
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(СтруктураПараметров, ВыборкаДетальныеЗаписи);
				КонецЦикла;
				СтруктураПараметров.Вставить("Организация", МассивОрганизаций);
				Если Действие <> Неопределено Тогда
					ОбработатьЭтап(СтруктураПараметров, Действие, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

// Процедура - Обработать регламентные задания этапов
//
// Параметры:
//	Этап				 - СправочникСсылка.ЭтапыУниверсальныхПроцессов - Этап для отбора
//  УправлениеПериодом	 - ДокументСсылка.УправлениеПериодомСценария - Документ управления периодом
//	Отказ				 - Булево - В случае ошибки устанавливается в значение Истина
//
Процедура ОбработатьРегламентныеЗаданияЭтапов(Этап = Неопределено, УправлениеПериодом = Неопределено, Отказ = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	СтруктураПараметров.Вставить("Этап", Этап);
	СтруктураПараметров.Вставить("УправлениеПериодом", УправлениеПериодом);
	
	Запрос = ЗапросПоДаннымЭтапов(СтруктураПараметров);
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтапов.Этап КАК Этап,
		|	МАКСИМУМ(ДанныеЭтапов.СостояниеПроцесса = ЗНАЧЕНИЕ(Перечисление.СостоянияПроцессаПодготовкиОтчетности.Запущен)) КАК ПроцессЗапущен
		|ПОМЕСТИТЬ втВсеЭтапы
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|ГДЕ
		|	ДанныеЭтапов.ЕстьДействиеПоРасписанию
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеЭтапов.Этап
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЭтапыУниверсальныхПроцессов.Ссылка КАК Этап,
		|	ЭтапыУниверсальныхПроцессов.РасписаниеАвтоматическогоВыполнения КАК РасписаниеАвтоматическогоВыполнения,
		|	ИдентификаторыРегламентныхЗаданий.УникальныйИдентификатор КАК ИдентификаторРегламентногоЗадания,
		|	ВЫБОР
		|		КОГДА ЭтапыУниверсальныхПроцессов.ПометкаУдаления
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ВсеЭтапы.ПроцессЗапущен
		|	КОНЕЦ КАК ПроцессЗапущен
		|ИЗ
		|	втВсеЭтапы КАК ВсеЭтапы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
		|		ПО ВсеЭтапы.Этап = ЭтапыУниверсальныхПроцессов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыРегламентныхЗаданий КАК ИдентификаторыРегламентныхЗаданий
		|		ПО ВсеЭтапы.Этап = ИдентификаторыРегламентныхЗаданий.Объект";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ПроцессЗапущен Тогда
			Расписание = ВыборкаДетальныеЗаписи.РасписаниеАвтоматическогоВыполнения.Получить();
			Если Расписание = Неопределено Тогда
				// Необходимо удалить регламентное задание
				УдалитьРегламентноеЗадание(ВыборкаДетальныеЗаписи.Этап, ВыборкаДетальныеЗаписи.ИдентификаторРегламентногоЗадания, Отказ);
			Иначе
				// Необходимо создать или обновить регламентное задание
				ОбновитьРегламентноеЗадание(ВыборкаДетальныеЗаписи.Этап, Расписание, ВыборкаДетальныеЗаписи.ИдентификаторРегламентногоЗадания, Отказ);
			КонецЕсли;
		Иначе
			// Необходимо удалить регламентное задание
			УдалитьРегламентноеЗадание(ВыборкаДетальныеЗаписи.Этап, ВыборкаДетальныеЗаписи.ИдентификаторРегламентногоЗадания, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
	
#КонецОбласти

#Область Оповещения

// Оповещает ответственных лиц о событиях в процессе подготовки отчетности
//
// Параметры:
//	ВидСобытияОповещения - СправочникСсылка.ВидыСобытийОповещений - Вид события
//	ПараметрыОбработки	 - Произвольный - Коллекция с параметрами обработки
//	Отказ				 - Булево - В случае ошибки устанавливается в значение Истина
//
Процедура ОповеститьОтветственных(ВидСобытияОповещения, ПараметрыОбработки, Отказ = Ложь) Экспорт
	
	Если НЕ НеобходимоОповещение(ВидСобытияОповещения) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	СтруктураПараметров.Вставить("УправлениеПериодом", ПараметрыОбработки.УправлениеПериодомСценария);
	ДополнитьСтруктуруПараметров(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("КлючевойОбъектПроцесса", СтруктураПараметров.УправлениеПериодом);
	СтруктураПараметров.Вставить("ШаблонПроцесса", СтруктураПараметров.ШаблонПроцесса);
	
	КатегорияСобытия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидСобытияОповещения, "КатегорияСобытия");
	Если КатегорияСобытия = Справочники.КатегорииСобытийОповещений.СобытияВыполненияПроцесса Тогда
		Источник = СтруктураПараметров.ШаблонПроцесса;
	ИначеЕсли КатегорияСобытия = Справочники.КатегорииСобытийОповещений.СобытияПроцессаПодготовкиОтчетности Тогда
		
		Источник = ПараметрыОбработки.Этап;
		СтруктураПараметров.Вставить("Организация", ПараметрыОбработки.Организация);
		СтруктураПараметров.Вставить("Этап", ПараметрыОбработки.Этап);
		
		Если ВидСобытияОповещения = Справочники.ВидыСобытийОповещений.ТребуетсяЗаполнитьОтчетыПоЭтапу Тогда
			ОповеститьОтветственныхПоДокументам(ВидСобытияОповещения, СтруктураПараметров, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ МодульУправленияОповещениямиУХ.ОповеститьПользователей(ВидСобытияОповещения, , Источник, , СтруктураПараметров, , , Истина) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Процедура ДополнитьСтруктуруПараметров(СтруктураПараметров) Экспорт
		
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.УправлениеПериодом)
		И ЗначениеЗаполнено(СтруктураПараметров.Сценарий)
		И ЗначениеЗаполнено(СтруктураПараметров.ПериодОтчета) Тогда
		
		ДанныеУПС = БюджетированиеИОтчетностьПовтИсп.НайтиУправлениеПериодомСценария(СтруктураПараметров.Сценарий, СтруктураПараметров.ПериодОтчета);
		
		СтруктураПараметров.Вставить("УправлениеПериодом", ДанныеУПС.УправлениеПериодом);
		СтруктураПараметров.Вставить("ВерсияРегламента", ДанныеУПС.ВерсияРегламента);
		СтруктураПараметров.Вставить("ПериодОкончания", ДанныеУПС.ПериодСценарияОкончание);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураПараметров.УправлениеПериодом)
		И НЕ (ЗначениеЗаполнено(СтруктураПараметров.Сценарий)
		И ЗначениеЗаполнено(СтруктураПараметров.ПериодОтчета)
		И ЗначениеЗаполнено(СтруктураПараметров.ПериодОкончания)
		И ЗначениеЗаполнено(СтруктураПараметров.ВерсияРегламента)) Тогда
		
		ДанныеУПС = БюджетированиеИОтчетностьПовтИсп.ДанныеУправленияПериодомСценария(СтруктураПараметров.УправлениеПериодом);
		
		СтруктураПараметров.Вставить("Сценарий", ДанныеУПС.Сценарий);
		СтруктураПараметров.Вставить("ПериодОтчета", ДанныеУПС.ПериодСценария);
		СтруктураПараметров.Вставить("ВерсияРегламента", ДанныеУПС.ВерсияРегламента);
		СтруктураПараметров.Вставить("ПериодОкончания", ДанныеУПС.ПериодСценарияОкончание);
		СтруктураПараметров.Вставить("ШаблонПроцесса", ДанныеУПС.ШаблонПроцесса);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСостояниеЭтапаПоУтвержденнымДокументам(СтруктураПараметров, Отказ)
	
	Запрос = ЗапросПоДаннымЭтаповДокументов(СтруктураПараметров);
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтаповДокументов.Этап КАК Этап,
		|	ДанныеЭтаповДокументов.Организация КАК Организация,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА ДанныеЭтаповДокументов.КритерийУтвержденияЭтапа = ЗНАЧЕНИЕ(Перечисление.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УтвержденыКонтрольныеДокументы)
		|				ТОГДА ВЫБОР
		|						КОГДА ДанныеЭтаповДокументов.Контрольный
		|							ТОГДА ДанныеЭтаповДокументов.Состояние = ДанныеЭтаповДокументов.СостояниеУтвержден
		|						ИНАЧЕ ИСТИНА
		|					КОНЕЦ
		|			ИНАЧЕ ДанныеЭтаповДокументов.Состояние = ДанныеЭтаповДокументов.СостояниеУтвержден
		|		КОНЕЦ) КАК УтвержденыВсеКонтрольныеДокументы
		|ИЗ
		|	втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеЭтаповДокументов.Этап,
		|	ДанныеЭтаповДокументов.Организация";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураПараметров.Вставить("Этап", Выборка.Этап);
		СтруктураПараметров.Вставить("Организация", Выборка.Организация);
		Если Выборка.УтвержденыВсеКонтрольныеДокументы Тогда
			СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		Иначе
			СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке);
		КонецЕсли;
		УстановитьСостояниеЭтапа(СтруктураПараметров, Отказ);
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьСостояниеЭтапа(СтруктураПараметров, Отказ = Ложь)
	
	Если Отказ Тогда
		Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ЗавершенСОшибкой;
	ИначеЕсли НЕ ЗначениеЗаполнено(СтруктураПараметров.УстанавливатьСостояние) Тогда
		// Не меняем состояние
		Возврат;
	Иначе
		Состояние = СтруктураПараметров.УстанавливатьСостояние;
	КонецЕсли;
	
	// Найдем текущее состояние этапа
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияЭтаповПроцессаПодготовкиОтчетности.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.СостоянияЭтаповПроцессаПодготовкиОтчетности КАК СостоянияЭтаповПроцессаПодготовкиОтчетности
		|ГДЕ
		|	СостоянияЭтаповПроцессаПодготовкиОтчетности.УправлениеПериодомСценария = &УправлениеПериодом
		|	И СостоянияЭтаповПроцессаПодготовкиОтчетности.Организация = &Организация
		|	И СостоянияЭтаповПроцессаПодготовкиОтчетности.Этап = &Этап";
	
	Запрос.УстановитьПараметр("УправлениеПериодом", СтруктураПараметров.УправлениеПериодом);
	Запрос.УстановитьПараметр("Этап", СтруктураПараметров.Этап);
	Запрос.УстановитьПараметр("Организация", СтруктураПараметров.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		// Есть уже записи в регистре
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Если ВыборкаДетальныеЗаписи.Состояние = Состояние Тогда
			// Состояние такое же
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.СостоянияЭтаповПроцессаПодготовкиОтчетности.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УправлениеПериодомСценария = СтруктураПараметров.УправлениеПериодом;
	МенеджерЗаписи.Организация = СтруктураПараметров.Организация;
	МенеджерЗаписи.Этап = СтруктураПараметров.Этап;
	МенеджерЗаписи.Состояние = Состояние;
	Если Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
		МенеджерЗаписи.ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось изменить состояние этапа ""%1"", по причине: %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			СтруктураПараметров.Этап, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
		Возврат;
	КонецПопытки;
		
	Если СтруктураПараметров.ВыводитьСообщения Тогда
		ТекстСообщения = НСтр("ru = 'Этап ""%1"" по организации ""%2"" переведен в состояние ""%3""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			СтруктураПараметров.Этап, СтруктураПараметров.Организация, Состояние);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

Функция ВыборкаПоЭтапамДокумента(Источник, Отказ = Ложь)
	
	// Проверим, что это объект подготовки отчетности
	ТипЗначенияИсточника = ТипЗнч(Источник);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначенияИсточника);
	ИмяОбъектаМетаданного = ОбъектМетаданных.Имя;
	Если НЕ ЭтоДокументПроцессаПодготовкиОтчетности(ИмяОбъектаМетаданного) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получим имена ключевых реквизитов
	ДанныеДокументаБД = БюджетированиеИОтчетностьПовтИсп.ДанныеДокументаБД(ИмяОбъектаМетаданного);
	Если НЕ ДанныеДокументаБД.ИспользуетсяВПроцессе Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураПараметров = ПараметрыОбработкиЭтапов();
	
	НеобходимыеРеквизиты = "Ссылка, Сценарий, ПериодОтчета, " + ДанныеДокументаБД.РеквизитРазделенияПоОрганизациям;
	Если ДанныеДокументаБД.ИспользоватьШаблоны Тогда
		НеобходимыеРеквизиты = НеобходимыеРеквизиты + ", " + ДанныеДокументаБД.РеквизитШаблонаДокумента;
	КонецЕсли;
	Если ОбъектМетаданных.Реквизиты.Найти("УправлениеПериодом") <> Неопределено Тогда
		НеобходимыеРеквизиты = НеобходимыеРеквизиты + ", УправлениеПериодом";
	КонецЕсли;
	Если ИмяОбъектаМетаданного = "НастраиваемыйОтчет" Тогда
		НеобходимыеРеквизиты = НеобходимыеРеквизиты + ", Проект";
		Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			НеобходимыеРеквизиты = НеобходимыеРеквизиты + ", Аналитика" + Сч;
		КонецЦикла;
	КонецЕсли;
	
	// Получим данные документа
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗначенияИсточника) Тогда
		
		// Передана ссылка на документ
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, НеобходимыеРеквизиты);
		
	Иначе
		
		// Передан объект
		Если Источник.ОбменДанными.Загрузка Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Источник.ДополнительныеСвойства.Свойство("ЭтоЗакрытиеПериода")
			И Источник.ДополнительныеСвойства.ЭтоЗакрытиеПериода Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Источник.ДополнительныеСвойства.Свойство("ДокументПроцессаПодготовкиОтчетностиПроверен")
			И Источник.ДополнительныеСвойства.ДокументПроцессаПодготовкиОтчетностиПроверен Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДанныеДокумента = Новый Структура(НеобходимыеРеквизиты);
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, Источник);
		
	КонецЕсли;
	
	СтруктураПараметров.Вставить("Сценарий", ДанныеДокумента.Сценарий);
	СтруктураПараметров.Вставить("ПериодОтчета", ДанныеДокумента.ПериодОтчета);
	СтруктураПараметров.ДополнительныеОтборы.Вставить("ДокументБД", ДанныеДокументаБД.Ссылка);
	СтруктураПараметров.ДополнительныеОтборы.Вставить("СостояниеПроцесса", Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен);
	
	Если ДанныеДокумента.Свойство("УправлениеПериодом") И ЗначениеЗаполнено(ДанныеДокумента.УправлениеПериодом) Тогда
		ДанныеУПС = БюджетированиеИОтчетностьПовтИсп.ДанныеУправленияПериодомСценария(ДанныеДокумента.УправлениеПериодом);
	Иначе
		ДанныеУПС = БюджетированиеИОтчетностьПовтИсп.НайтиУправлениеПериодомСценария(ДанныеДокумента.Сценарий, ДанныеДокумента.ПериодОтчета);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеУПС.УправлениеПериодом) Тогда
		// Не удалось определить документ управления периодом
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДанныеУПС.ЗапрещатьДокументыВнеПроцесса = ЛОЖЬ Тогда
		СтруктураПараметров.Вставить("Организация", ДанныеДокумента[ДанныеДокументаБД.РеквизитРазделенияПоОрганизациям]);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("ДокументСсылка", ДанныеДокумента.Ссылка);
	КонецЕсли;
	
	Запрос = ЗапросПоДаннымЭтаповДокументов(СтруктураПараметров);
	Если Запрос = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДанныеУПС.ЗапрещатьДокументыВнеПроцесса = ЛОЖЬ Тогда
		
		// Просто проверяем существущие этапы по документу
		Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	ДанныеЭтапов.УправлениеПериодом КАК УправлениеПериодом,
			|	ДанныеЭтапов.СостояниеЭтапа КАК СостояниеЭтапа,
			|	ДанныеЭтапов.Этап КАК Этап,
			|	ДанныеЭтапов.Организация КАК Организация,
			|	ДанныеЭтаповДокументов.Согласуется КАК Согласуется
			|ИЗ
			|	втДанныеЭтапов КАК ДанныеЭтапов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов
			|		ПО (ДанныеЭтаповДокументов.Этап = ДанныеЭтапов.Этап)
			|			И (ДанныеЭтаповДокументов.Организация = ДанныеЭтапов.Организация)";
			
		РезультатЗапроса = Запрос.Выполнить();
		
	Иначе
		
		// Необходимо также выполнить проверку, что документ находится в рамках процесса подготовки отчетности
		Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	ДанныеЭтапов.УправлениеПериодом КАК УправлениеПериодом,
			|	ДанныеЭтапов.СостояниеЭтапа КАК СостояниеЭтапа,
			|	ДанныеЭтапов.Этап КАК Этап,
			|	ДанныеЭтапов.Организация КАК Организация,
			|	ЕСТЬNULL(ДанныеЭтаповДокументов.Согласуется, ЛОЖЬ) КАК Согласуется
			|ИЗ
			|	втДанныеЭтапов КАК ДанныеЭтапов
			|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов
			|		ПО (ДанныеЭтаповДокументов.Этап = ДанныеЭтапов.Этап)
			|			И (ДанныеЭтаповДокументов.Организация = ДанныеЭтапов.Организация)
			|ГДЕ
			|	ИСТИНА";
			
		ДобавитьОтборВЗапрос(Запрос, ДанныеДокумента, ДанныеДокументаБД.РеквизитРазделенияПоОрганизациям, "ДанныеЭтапов.Организация");
		ДобавитьОтборВЗапрос(Запрос, ДанныеДокумента, ДанныеДокументаБД.РеквизитШаблонаДокумента, "ДанныеЭтаповДокументов.ШаблонДокумента");
		ДобавитьОтборВЗапрос(Запрос, ДанныеДокумента, "Проект", "ДанныеЭтаповДокументов.Проект");
		Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			ДобавитьОтборВЗапрос(Запрос, ДанныеДокумента, "Аналитика" + Сч, "ДанныеЭтаповДокументов.Аналитика" + Сч);
		КонецЦикла;
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			// Не найден этап для данного документа
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = 'Не найден этап процесса подготовки отчетности для документа ""%1"". Ввод документов по регламенту ""%2"" вне этапов процесса запрещен.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				ДанныеДокумента.Ссылка, ДанныеУПС.ВерсияРегламента);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

Функция ДанныеЭтапа(СтруктураПараметров) Экспорт
	
	Запрос = ЗапросПоДаннымЭтапов(СтруктураПараметров);
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтапов.Уровень КАК Уровень,
		|	ДанныеЭтапов.Этап КАК Этап,
		|	ДанныеЭтапов.Организация КАК Организация,
		|	ДанныеЭтапов.ОтветственныйЗаЭтап КАК ОтветственныйЗаЭтап
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДанныеЭтапаСоСвязями(СтруктураПараметров, ТипСвязи = "Предшественники") Экспорт
	
	// Получим все этапы
	СтруктураПараметровВсеЭтапы = ПараметрыОбработкиЭтапов();
	ЗаполнитьЗначенияСвойств(СтруктураПараметровВсеЭтапы, СтруктураПараметров,
		"УправлениеПериодом, ДополнительныеОтборы");
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДанныеЭтапов.Уровень КАК Уровень,
		|	ДанныеЭтапов.Этап КАК Этап,
		|	ДанныеЭтапов.Организация КАК Организация,
		|	ДанныеЭтапов.ТипОрганизацийЭтапа КАК ТипОрганизацийЭтапа,
		|	ДанныеЭтапов.ВерсияРегламента КАК ВерсияРегламента,
		|	ДанныеЭтапов.ОтветственныйЗаЭтап КАК ОтветственныйЗаЭтап
		|ПОМЕСТИТЬ втТекущийЭтап
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|ГДЕ
		|	ДанныеЭтапов.Этап = &Этап";
	
	Если ЗначениеЗаполнено(СтруктураПараметров.Организация) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И ДанныеЭтапов.Организация В (&Организация)";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса +
		";
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ТекущийЭтап.Уровень) КАК Уровень
		|ПОМЕСТИТЬ втУровеньТекущегоЭтапа
		|ИЗ
		|	втТекущийЭтап КАК ТекущийЭтап
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОрганизацииВерсии.ОрганизационнаяЕдиница КАК Организация
		|ПОМЕСТИТЬ втСвязанныеОрганизацииВсе
		|ИЗ
		|	втТекущийЭтап КАК ТекущийЭтап
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности.ОрганизационныеЕдиницы КАК ОрганизацииВерсии
		|		ПО ТекущийЭтап.ВерсияРегламента = ОрганизацииВерсии.Ссылка
		|			И ТекущийЭтап.Организация = ОрганизацииВерсии.ОрганизационнаяЕдиницаРодитель
		|			И (ТекущийЭтап.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
		|				ИЛИ ТекущийЭтап.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Элиминирующая))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОрганизацииВерсии.ОрганизационнаяЕдиницаРодитель
		|ИЗ
		|	втТекущийЭтап КАК ТекущийЭтап
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности.ОрганизационныеЕдиницы КАК ОрганизацииВерсии
		|		ПО ТекущийЭтап.ВерсияРегламента = ОрганизацииВерсии.Ссылка
		|			И ТекущийЭтап.Организация = ОрганизацииВерсии.ОрганизационнаяЕдиница
		|			И (ТекущийЭтап.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Обычная))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТекущийЭтап.Организация
		|ИЗ
		|	втТекущийЭтап КАК ТекущийЭтап
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СвязанныеОрганизации.Организация КАК Организация
		|ПОМЕСТИТЬ втСвязанныеОрганизации
		|ИЗ
		|	втСвязанныеОрганизацииВсе КАК СвязанныеОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИСТИНА КАК ТекущийЭтап,
		|	ТекущийЭтап.Уровень КАК Уровень,
		|	ТекущийЭтап.Этап КАК Этап,
		|	ТекущийЭтап.Организация КАК Организация,
		|	ТекущийЭтап.ОтветственныйЗаЭтап КАК ОтветственныйЗаЭтап
		|ИЗ
		|	втТекущийЭтап КАК ТекущийЭтап
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	ДанныеЭтапов.Уровень,
		|	ДанныеЭтапов.Этап,
		|	ДанныеЭтапов.Организация,
		|	ДанныеЭтапов.ОтветственныйЗаЭтап
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСвязанныеОрганизации КАК СвязанныеОрганизации
		|		ПО ДанныеЭтапов.Организация = СвязанныеОрганизации.Организация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втУровеньТекущегоЭтапа КАК УровеньТекущегоЭтапа
		|		ПО ДанныеЭтапов.Уровень < УровеньТекущегоЭтапа.Уровень
		|
		|УПОРЯДОЧИТЬ ПО
		|	Уровень";
	
	Если ТипСвязи = "Последователи" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<", ">");
		ТекстЗапроса = ТекстЗапроса + " УБЫВ";
	КонецЕсли;
	
	Запрос = ЗапросПоДаннымЭтапов(СтруктураПараметровВсеЭтапы);
	
	Запрос.Текст = Запрос.Текст + ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Этап", СтруктураПараметров.Этап);
	Запрос.УстановитьПараметр("Организация", СтруктураПараметров.Организация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьОтборВЗапрос(Запрос, ДополнительныеОтборы, ИмяОтбора, ПолеЗапроса)
	
	ЗначениеОтбора = Неопределено;
	ДополнительныеОтборы.Свойство(ИмяОтбора, ЗначениеОтбора);
	Если НЕ ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеОтбора) = Тип("Массив") Тогда
		Если ЗначениеОтбора.Количество() = 0 Тогда
			Возврат;
		ИначеЕсли ЗначениеОтбора.Количество() = 1 Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И " + ПолеЗапроса + " = &" + ИмяОтбора;
			Запрос.УстановитьПараметр(ИмяОтбора, ЗначениеОтбора.Получить(0));
		Иначе
			Запрос.Текст = Запрос.Текст + "
			|	И " + ПолеЗапроса + " В (&" + ИмяОтбора + ")";
			Запрос.УстановитьПараметр(ИмяОтбора, ЗначениеОтбора);
		КонецЕсли;
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	И " + ПолеЗапроса + " = &" + ИмяОтбора;
		Запрос.УстановитьПараметр(ИмяОтбора, ЗначениеОтбора);
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьДублиСтрокВЭтапахПроцесса(СтруктураПараметров)
	
	Запрос = ЗапросПоДаннымЭтапов(СтруктураПараметров);
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтапов.Организация КАК Организация,
		|	ЭтапыПроцессовФормируемыеДокументы.ДокументБД КАК ДокументБД,
		|	ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента КАК ШаблонДокумента
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов.ФормируемыеДокументы КАК ЭтапыПроцессовФормируемыеДокументы
		|		ПО ДанныеЭтапов.Этап = ЭтапыПроцессовФормируемыеДокументы.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеЭтапов.Организация,
		|	ЭтапыПроцессовФормируемыеДокументы.ДокументБД,
		|	ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Нет дублирующих строк
		Возврат Ложь;
	КонецЕсли;
	
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		ТекстСообщения = НСтр("ru = 'Обнаружены дубли строк в различных этапах процесса:
		|	Организация: ""%1""
		|	Документ БД: ""%2""
		|	Шаблон документа: ""%3""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			ВыборкаЗапроса.Организация, ВыборкаЗапроса.ДокументБД, ВыборкаЗапроса.ШаблонДокумента);
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#Область ОбработкаДокументов

Процедура ОбработатьДокументыЭтапа(СтруктураПараметров, КоличествоДокументов = 0)
	
	Запрос = ЗапросПоДаннымЭтаповДокументов(СтруктураПараметров);
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ДанныеЭтаповДокументов.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
		|	ДанныеЭтаповДокументов.ИспользоватьШаблоны КАК ИспользоватьШаблоны,
		|	ДанныеЭтаповДокументов.РеквизитШаблонаДокумента КАК РеквизитШаблонаДокумента,
		|	ДанныеЭтаповДокументов.РеквизитРазделенияПоОрганизациям КАК РеквизитРазделенияПоОрганизациям,
		|	ДанныеЭтаповДокументов.Согласуется КАК Согласуется,
		|	ДанныеЭтаповДокументов.СостояниеУтвержден КАК СостояниеУтвержден,
		|	ДанныеЭтаповДокументов.СостояниеЧерновик КАК СостояниеЧерновик,
		|	ДанныеЭтаповДокументов.ШаблонДокумента КАК ШаблонДокумента,
		|	ДанныеЭтаповДокументов.Документ КАК Документ,
		|	ДанныеЭтаповДокументов.Проект КАК Проект,
		|	ДанныеЭтаповДокументов.Аналитика1 КАК Аналитика1,
		|	ДанныеЭтаповДокументов.Аналитика2 КАК Аналитика2,
		|	ДанныеЭтаповДокументов.Аналитика3 КАК Аналитика3,
		|	ДанныеЭтаповДокументов.Аналитика4 КАК Аналитика4,
		|	ДанныеЭтаповДокументов.Аналитика5 КАК Аналитика5,
		|	ДанныеЭтаповДокументов.Аналитика6 КАК Аналитика6,
		|	ДанныеЭтаповДокументов.Состояние КАК Состояние
		|ИЗ
		|	втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов";
		
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		Если СтруктураПараметров.Отказ И ЗначениеЗаполнено(СтруктураПараметров.УстанавливатьСостояние) Тогда
			// Если требуется менять статус этапа, то при ошибке расчета прекращаем обработку этапов
			Возврат;
		КонецЕсли;
		
		КоличествоДокументов = КоличествоДокументов + 1;
		
		// СОЗДАЕМ ДОКУМЕНТ
		Если ВыборкаЗапроса.Документ = Неопределено Тогда
			// Документ еще ны был создан
			Если СтруктураПараметров.УстанавливатьСостояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен Тогда
				// Документа нет, этап просто переводим в состояние "Не активен"
				Продолжить;
			КонецЕсли;
			ДокументОбъект = СоздатьДокументОтчетности(СтруктураПараметров, ВыборкаЗапроса);
		Иначе
			ДокументОбъект = ВыборкаЗапроса.Документ.ПолучитьОбъект();
		КонецЕсли;
		
		// ЗАПОЛНЯЕМ ДОКУМЕНТ
		Если СтруктураПараметров.ЗаполнятьДокументы 
			И ВыборкаЗапроса.Состояние <> ВыборкаЗапроса.СостояниеУтвержден Тогда
			
			Если ДокументОбъект = Неопределено Тогда
				
				// Документ не удалось создать
				ТекстСообщения = НСтр("ru = 'Не удалось создать документ по шаблону: ""%1""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ВыборкаЗапроса.ШаблонДокумента);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Продолжить;
				
			ИначеЕсли ДокументОбъект.ПометкаУдаления Тогда 
				
				// Не обрабатываем помеченный на удаление документ
				ТекстСообщения = НСтр("ru = 'Не удалось обработать документ ""%1"" так как он помечен на удаление'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					Строка(ДокументОбъект));
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Продолжить;
			
			КонецЕсли;
			
			// Заполняем документы
			Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.НастраиваемыйОтчет") Тогда
				ОбработатьЭкземплярОтчета(СтруктураПараметров, ДокументОбъект);
			ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.Трансляция") Тогда
				ОбработатьДокументКорректировки(СтруктураПараметров, ДокументОбъект, "Трансляция");
			ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ТрансформационнаяКорректировка") Тогда
				ОбработатьДокументКорректировки(СтруктураПараметров, ДокументОбъект, "ТрансформационнаяКорректировка");
			ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.Элиминация") Тогда
				ОбработатьДокументЭлиминации(СтруктураПараметров, ДокументОбъект);
			Иначе
				ОбработатьДокументПроцесса(СтруктураПараметров, ДокументОбъект);
			КонецЕсли;
			
			Если СтруктураПараметров.ВыводитьСообщения И НЕ СтруктураПараметров.Отказ Тогда
				ТекстСообщения = НСтр("ru = 'Заполнен документ ""%1""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ДокументОбъект);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			
		Иначе
			
			Если ДокументОбъект = Неопределено Тогда
				// Документа нет, ничего более не делаем
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		// МЕНЯЕМ СОСТОЯНИЕ ДОКУМЕНТА
		Если ВыборкаЗапроса.Согласуется И НЕ СтруктураПараметров.Отказ Тогда
			
			Если СтруктураПараметров.УстанавливатьСтатусДокументов Тогда
				
				// Необходимо поменять состояние согласования
				Если СтруктураПараметров.УстанавливатьСостояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
					НовоеСостояниеДокумента = ВыборкаЗапроса.СостояниеУтвержден;
				Иначе
					НовоеСостояниеДокумента = ВыборкаЗапроса.СостояниеЧерновик;
				КонецЕсли;
				
			ИначеЕсли СтруктураПараметров.ЗаполнятьДокументы Тогда
				
				// СДокумент заполнили, переведем его в статус "Черновик"
				НовоеСостояниеДокумента = ВыборкаЗапроса.СостояниеЧерновик;
				
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ВыборкаЗапроса.Состояние = НовоеСостояниеДокумента Тогда
				// Смена статуса не требуется
				Продолжить;
			КонецЕсли;
			
			// Проверим, нет ли по документу запущенного процесса согласования
			СогласующийДокумента = МодульУправленияПроцессамиУХ.ПолучитьОтветственногоЗаТипОбъекта(ДокументОбъект.Ссылка, , , , , Истина);
			Если ЗначениеЗаполнено(СогласующийДокумента) Тогда
				ТекстСообщения = НСтр("ru = 'Документ ""%1"" находится на согласовании у ""%2"". Перевод в состояние ""%3"" невозможен.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ДокументОбъект.Ссылка, СогласующийДокумента, НовоеСостояниеДокумента);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Продолжить;
			КонецЕсли;
			
			// Проверим, что настраиваемый отчет не с ручным заполнением
			Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.НастраиваемыйОтчет") Тогда
				СпособФормированияОтчета = Документы.НастраиваемыйОтчет.ЗначениеНастройкиОбработкиДокумента(ДокументОбъект, "СпособФормированияОтчета");
				Если СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.РучноеЗаполнение
					И СтруктураПараметров.УстанавливатьСостояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
					// При утверждении отчетов, прерываем обработку, т. к. согласовать ручной отчет должен пользователь вручную
					ТекстСообщения = НСтр("ru = 'Для документа ""%1"" установлен способ формирования ""%2"". Перевод в состояние ""%3"" невозможен.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						Строка(ДокументОбъект), Перечисления.СпособыФормированияОтчетов.РучноеЗаполнение, ВыборкаЗапроса.СостояниеУтвержден);
					ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			// Выполним переопределяемый обработчик
			РезультатОбработки = УправлениеПроцессамиПодготовкиОтчетностиПереопределяемый.ИзменитьСостояниеДокументаПроцесса(СтруктураПараметров, ДокументОбъект);
			Если РезультатОбработки Тогда
				Продолжить;
			КонецЕсли;
			
			// Сменим состояние
			Если НЕ УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(ДокументОбъект.Ссылка, НовоеСостояниеДокумента, , 
				Пользователи.ТекущийПользователь(), , , , , , , Новый Структура("ПроверятьСостояниеЭтапа", Ложь)) Тогда
				СтруктураПараметров.Отказ = Истина;
			КонецЕсли;
			
			Если СтруктураПараметров.ВыводитьСообщения И НЕ СтруктураПараметров.Отказ Тогда
				ТекстСообщения = НСтр("ru = 'Документ ""%1"" переведен в состояние ""%2""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
					ДокументОбъект, НовоеСостояниеДокумента);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Функция СоздатьДокументОтчетности(СтруктураПараметров, ДанныеДокументаБД)
	
	// Выполним переопределяемый обработчик
	ДокументОбъект = УправлениеПроцессамиПодготовкиОтчетностиПереопределяемый.СоздатьДокументПроцесса(СтруктураПараметров, ДанныеДокументаБД);
	Если ЗначениеЗаполнено(ДокументОбъект) Тогда
		Возврат ДокументОбъект;
	КонецЕсли;
	
	// Создадим документ
	ДокументОбъект = Документы[ДанныеДокументаБД.ИмяОбъектаМетаданных].СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.УстановитьНовыйНомер();
	ДокументОбъект.ПериодОтчета = СтруктураПараметров.ПериодОтчета;
	ДокументОбъект.Сценарий = СтруктураПараметров.Сценарий;
	
	ДокументОбъект[ДанныеДокументаБД.РеквизитРазделенияПоОрганизациям] = СтруктураПараметров.Организация;
	Если ДанныеДокументаБД.ИспользоватьШаблоны Тогда
		ДокументОбъект[ДанныеДокументаБД.РеквизитШаблонаДокумента] = ДанныеДокументаБД.ШаблонДокумента;
		ДокументОбъект.Заполнить(ДанныеДокументаБД.ШаблонДокумента);
	КонецЕсли;
	
	// Данные управления периодом
	Если ОбщегоНазначенияУХ.ЕстьРеквизитОбъекта("УправлениеПериодом", ДокументОбъект) Тогда
		
		Если Не ЗначениеЗаполнено(СтруктураПараметров.УправлениеПериодом) Тогда
			ДополнитьСтруктуруПараметров(СтруктураПараметров);
		КонецЕсли;
		
		ДокументОбъект.УправлениеПериодом = СтруктураПараметров.УправлениеПериодом;
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.УправлениеПериодом) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить документ управления периодом по параметрам:
				|	Сценарий: %1,
				|	Период отчета: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				СтруктураПараметров.Сценарий, СтруктураПараметров.ПериодОтчета);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
		Если ОбщегоНазначенияУХ.ЕстьРеквизитОбъекта("ПериодОкончания", ДокументОбъект) Тогда
			ДокументОбъект.ПериодОкончания = СтруктураПараметров.ПериодОкончания;
		КонецЕсли;
		
	КонецЕсли;
	
	// Для настраиваемого отчета заполним проект и аналитики
	Если ДанныеДокументаБД.ИмяОбъектаМетаданных = "НастраиваемыйОтчет" Тогда
		
		ДанныеВидаОтчета = БюджетированиеИОтчетностьПовтИсп.ДанныеВидаОтчета(ДокументОбъект.ВидОтчета);
		
		Если ДанныеВидаОтчета.РазделениеПоПроектам Тогда
			ДокументОбъект.Проект = ДанныеДокументаБД.Проект;
		КонецЕсли;
		
		Для Сч = 1 По ДанныеВидаОтчета.МаксКлючевыхАналитик Цикл
			ДокументОбъект["Аналитика" + Сч] = ДанныеДокументаБД["Аналитика" + Сч];
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		ДокументОбъект.Записать();
		Если ДанныеДокументаБД.Согласуется Тогда
			Если НЕ УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(ДокументОбъект.Ссылка, ДанныеДокументаБД.СостояниеЧерновик) Тогда
				СтруктураПараметров.Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось записать документ ""%1"", по причине: %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
		Возврат Неопределено;
	КонецПопытки;
	
	Если СтруктураПараметров.ВыводитьСообщения Тогда
		ТекстСообщения = НСтр("ru = 'Создан новый документ: %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			ДокументОбъект.Ссылка);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат ДокументОбъект;
	
КонецФункции

Процедура ОбработатьЭкземплярОтчета(СтруктураПараметров, ДокументОбъект)
	
	// Заполняем отчет по регламенту
	ОбработкаРасчета = Обработки.РасчетИЗаписьПоказателей.Создать();
	Результат = ОбработкаРасчета.ЗаполнитьДанныеПоПериодам(ДокументОбъект, , , Истина);
	Если НЕ Результат Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось рассчитать документ ""%1"" по регламенту'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			ДокументОбъект);
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
		Возврат;
	КонецЕсли;
	
	// Выведем сообщение, если необходимо
	Если СтруктураПараметров.ВыводитьСообщения Тогда
		ТекстСообщения = НСтр("ru = 'Документ ""%1"" рассчитан по регламенту'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			ДокументОбъект);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.СведенияОбИзмененииДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = ДокументОбъект.Ссылка;
	МенеджерЗаписи.ПоследнийРедактировавший = СтруктураПараметров.ОтветственныйЗаЭтап;
	МенеджерЗаписи.ДатаИзменения = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура ОбработатьДокументКорректировки(СтруктураПараметров, ДокументОбъект, ИмяОбъектаМетаданных)
	
	ОбработкаОбъект = Обработки.КорректировкиЗначенийПоказателей.Создать();
	
	ЗаполнитьЗначенияСвойств(ОбработкаОбъект, ДокументОбъект);
	ОбработкаОбъект.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных;
	
	ДанныеШаблона = Обработки.УстановкаСоответствияСчетов.ПолучитьДанныеШаблона(ОбработкаОбъект.ШаблонКорректировки);
	ОбработкаОбъект.НаправлениеТрансляции = ДанныеШаблона.НаправлениеТрансляции;
	
	ОбработкаОбъект.ИнициализироватьКонтекст();
	
	Если ИмяОбъектаМетаданных = "ТрансформационнаяКорректировка" Тогда
		
		ОбработкаОбъект.ЗаполнитьПоШаблонуТрансформации();
		
	ИначеЕсли ИмяОбъектаМетаданных = "Трансляция" Тогда
		
		ОбработкаОбъект.ЗаполнитьПоШаблонуТрансляции();
		
	КонецЕсли;
	
	ОбработкаОбъект.ДанныеПараметрикиАктуальны = Ложь;
	Если ОбработкаОбъект.ДокументОбъект = Неопределено Тогда
		// Нет объекта для заполнения, подставим рабочий объект
		ОбработкаОбъект.ДокументОбъект = ДокументОбъект;
	КонецЕсли;
	
	ОбработкаОбъект.ЗаполнитьАвтоматически();
	
	// Перенесем рассчитанные значения из объекта обработки в объект документа
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ОбработкаОбъект);
	
	// Запишем объект
	ОбработкаОбъект.ЗаписатьРабочийОбъект(РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Проведение, СтруктураПараметров.Отказ);
	
КонецПроцедуры

Процедура ОбработатьДокументЭлиминации(СтруктураПараметров, ДокументОбъект)
	
	МСФОУХ.ОбработкаЗаполнения(ДокументОбъект, СтруктураПараметров);
	Если ЗначениеЗаполнено(СтруктураПараметров.УстанавливатьСостояние) Тогда
		МСФОУХ.ПровестиДокумент(ДокументОбъект, Истина, СтруктураПараметров.Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументПроцесса(СтруктураПараметров, ДокументОбъект)
	
	// Выполним переопределяемый обработчик
	РезультатОбработки = УправлениеПроцессамиПодготовкиОтчетностиПереопределяемый.ОбработатьДокументПроцесса(СтруктураПараметров, ДокументОбъект);
	Если РезультатОбработки Тогда
		Возврат;
	КонецЕсли;
	
	// Проведем документ
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось провести документ ""%1"", по причине: %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область УровниЭтапов

Функция РассчитатьУровеньЭтапаРекурсивно(Этап, тзЭтапыПоследователи, Знач Уровень=0)

	УровеньВходящий = Уровень;
	
	НайденныеСтроки = тзЭтапыПоследователи.НайтиСтроки(Новый Структура("ЭтапПоследователь", Этап));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Уровень = 0 Тогда
			Если ЕстьЦикличныеСсылки(НайденнаяСтрока.Этап, НайденнаяСтрока.Этап, тзЭтапыПоследователи) Тогда
				ТекУровень = 0;
			Иначе
				ТекУровень = РассчитатьУровеньЭтапаРекурсивно(НайденнаяСтрока.Этап, тзЭтапыПоследователи, УровеньВходящий);
			КонецЕсли;
		Иначе
			ТекУровень = НайденнаяСтрока.Уровень;
		КонецЕсли;
		Уровень = Макс(Уровень, ТекУровень);
	КонецЦикла;
	
	Возврат Уровень+1;
	
КонецФункции

Функция ЕстьЦикличныеСсылки(ЭтапИсходный, Этап, тзЭтапыПоследователи, Счетчик = 0)
	
	Если Счетчик = 1000 Тогда
		Возврат Истина;
	КонецЕсли;
	Счетчик = Счетчик + 1;
	Результат = Ложь;
	
	НайденныеСтроки = тзЭтапыПоследователи.НайтиСтроки(Новый Структура("ЭтапПоследователь", Этап));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Этап = ЭтапИсходный Тогда
			Возврат Истина;
		КонецЕсли;
		Результат = Макс(Результат, ЕстьЦикличныеСсылки(ЭтапИсходный, НайденнаяСтрока.Этап, тзЭтапыПоследователи, Счетчик));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РегламентныеЗаданияЭтапов

Процедура ОбновитьРегламентноеЗадание(Этап, Расписание, ИдентификаторРегламентногоЗадания, Отказ)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторРегламентногоЗадания) Тогда
		// Нет задания
		РегламентноеЗадание = Неопределено;
	Иначе
		// АПК:760-выкл
		РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторРегламентногоЗадания);
		// АПК:760-вкл.
	КонецЕсли;
	
	НовоеЗадание = Ложь;
	Если РегламентноеЗадание = Неопределено Тогда
		НовоеЗадание = Истина;
		// АПК:760-выкл
		РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание("ВыполнениеДействийПоРасписаниюЭтапов");
		// АПК:760-вкл.
	КонецЕсли;
	
	НаименованиеЗадания = НСтр("ru = 'Выполнение действий по расписанию этапа: ""%1""'");
	НаименованиеЗадания = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НаименованиеЗадания, Этап);
	РегламентноеЗадание.Наименование = НаименованиеЗадания;
	РегламентноеЗадание.Расписание = Расписание;
	
	ПараметрыЗадания = Новый Массив();
	ПараметрыЗадания.Добавить(Этап);
	РегламентноеЗадание.Параметры = ПараметрыЗадания;
	
	НачатьТранзакцию();
	Попытка
		
		РегламентноеЗадание.Записать();
		
		Если НовоеЗадание Тогда
			МенеджерЗаписи = РегистрыСведений.ИдентификаторыРегламентныхЗаданий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = Этап;
			МенеджерЗаписи.УникальныйИдентификатор = РегламентноеЗадание.УникальныйИдентификатор;
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось записать регламентное задание ""%1"", по причине: %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			РегламентноеЗадание, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
		
	КонецПопытки;

КонецПроцедуры

Процедура УдалитьРегламентноеЗадание(Этап, ИдентификаторРегламентногоЗадания, Отказ)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторРегламентногоЗадания) Тогда
		// Нет идентификатора
		Возврат;
	КонецЕсли;
	
	// АПК:760-выкл
	РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторРегламентногоЗадания);
	// АПК:760-вкл.
	
	НачатьТранзакцию();
	Попытка
		
		Если РегламентноеЗадание <> Неопределено Тогда
			РегламентноеЗадание.Удалить();
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ИдентификаторыРегламентныхЗаданий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(Этап);
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось удалить регламентное задание ""%1"", по причине: %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			РегламентноеЗадание, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Оповещения

Функция НеобходимоОповещение(ВидСобытияОповещения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИСТИНА КАК НеобходимоОповещение
		|ИЗ
		|	РегистрСведений.НастройкиОповещений КАК НастройкиОповещений
		|ГДЕ
		|	НастройкиОповещений.ВидСобытияОповещения = &ВидСобытияОповещения
		|	И НастройкиОповещений.ОповещениеВключено";
	
	Запрос.УстановитьПараметр("ВидСобытияОповещения", ВидСобытияОповещения);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ОповеститьОтветственныхПоДокументам(ВидСобытияОповещения, СтруктураПараметров, Отказ)
	
	// Отбираем экземпляры отчета текущего этапа по текущей организации
	СтруктураПараметров.Вставить("ДокументБД", Справочники.ДокументыБД.НайтиПоНаименованию("НастраиваемыйОтчет"));
	
	Запрос = ЗапросПоДаннымЭтаповДокументов(СтруктураПараметров);
	Запрос.Текст = Запрос.Текст + 
		"ВЫБРАТЬ
		|	ДанныеЭтаповДокументов.ШаблонДокумента КАК ВидОтчета,
		|	ДанныеЭтаповДокументов.Документ КАК Документ
		|ИЗ
		|	втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов";
		
	Результат = Запрос.Выполнить();
	ВыборкаЗапроса = Результат.Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаЗапроса.Документ) Тогда
			СтруктураПараметров.Вставить("ВидОтчета", ВыборкаЗапроса.ВидОтчета);
			СтруктураПараметров.Вставить("Документ", ВыборкаЗапроса.Документ);
			Если НЕ МодульУправленияОповещениямиУХ.ОповеститьПользователей(ВидСобытияОповещения, , ВыборкаЗапроса.Документ, , СтруктураПараметров, , , Истина) Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
	
