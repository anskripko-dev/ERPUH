Процедура ПодключаемаяКоманда_СледующийЭтапПТУ(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды)
	
	Если Не ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() 
		Или ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		Возврат; // только для УХ
	КонецЕсли;
	
	Если Не СтрНачинаетсяС(НастройкиФормы.ИмяФормы, "Документ.ПоступлениеТоваровУслуг.Форма") Тогда
		Возврат;
	КонецЕсли;
	
	Команда = Команды.Добавить();
	
	Команда.Идентификатор = "СледующийЭтапЗакупкиУХ";
	Команда.ТипПараметра = Новый ОписаниеТипов("ДокументСсылка.ПоступлениеТоваровУслуг");
	Команда.ТолькоВоВсехДействиях = Истина;
	Команда.ОтображениеКнопки = ОтображениеКнопки.Картинка;
	Команда.Назначение = "ДляОбъекта";
	Команда.ИзменяетВыбранныеОбъекты = Истина;
	Команда.МножественныйВыбор = Ложь;
	Команда.РежимЗаписи = "Записывать";

	Команда.Представление = НСтр("ru = 'Создать на основании этапа'");
	Команда.Обработчик = "МСФОКлиентУХ.ОткрытьСледующийЭтапБУУХ_Подключаемый";
	Команда.Вид = "КоманднаяПанель";
	Команда.Картинка = БиблиотекаКартинок.СоздатьДокумент;
	
	ЭтапыИсточники = Новый СписокЗначений;
	ЭтапыИсточники.Добавить(ПредопределенноеЗначение("Справочник.ЭтапыРаздельнойЗакупки.НакладнаяПередОрдером"));
	ЭтапыИсточники.Добавить(ПредопределенноеЗначение("Справочник.ЭтапыРаздельнойЗакупки.ОрдерПередНакладной"));
	
	Команда.ЕстьУсловияВидимости = Истина;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(
		Команда, "ЭтапРаздельнойЗакупки", ЭтапыИсточники, ВидСравненияКомпоновкиДанных.ВСписке);
		
КонецПроцедуры

Функция ДобавитьПодключаемуюКоманду(Команды, Идентификатор, ТипПараметра)
	
	Команда = Команды.Добавить();
	
	Команда.Идентификатор = Идентификатор;
	Команда.ТипПараметра = ТипПараметра;
	
	Команда.Важность = "Обычное";
	Команда.Порядок = 10;
	Команда.ОтображениеКнопки = ОтображениеКнопки.КартинкаИТекст;
	Команда.Назначение = "ДляОбъекта";
	//Команда.ФункциональныеОпции = "";
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.МножественныйВыбор = Ложь;
	Команда.РежимЗаписи = "Записывать";
	
	Возврат Команда;

КонецФункции

Процедура ПодключаемаяКоманда_ОбновитьГрафикиПоКотировке(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды)
	
	Если Не СтрНачинаетсяС(НастройкиФормы.ИмяФормы, "Справочник.ВидыКотировокФинансовыхИнструментов.Форма") Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОбъектов = Новый Массив;
	Для каждого СтрокаИсточник Из Источники.Строки Цикл
		Если ЗначениеЗаполнено(СтрокаИсточник.ТипСсылкиДанных) Тогда
			ТипыОбъектов.Добавить(СтрокаИсточник.ТипСсылкиДанных);
		КонецЕсли;
	КонецЦикла;
	
	ТипПараметра = Новый ОписаниеТипов(ТипыОбъектов);
	
	Команда = ДобавитьПодключаемуюКоманду(Команды, "ОбновитьГрафикиПоКотировке", ТипПараметра);
	Команда.Важность = "Важное";
	Команда.Назначение = "";
	
	Команда.Представление = НСтр("ru = 'Обновить графики ценных бумаг по котировке'");
	Команда.Обработчик = "ФинансовыеИнструментыФормыВызовСервера.ОбновитьГрафикиПоКотировке_Подключаемый";
	Команда.Вид = "ПерейтиУХ";
	Команда.Картинка = БиблиотекаКартинок.Обновить;
	//Команда.ДополнительныеПараметры = ДопПараметры;

	Список = Новый СписокЗначений;
	Список.Добавить(ПредопределенноеЗначение("Перечисление.ТипыКотировокФинансовыхИнструментов.РыночнаяСтавкаПроцента"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.ТипыКотировокФинансовыхИнструментов.БанковскаяСтавкаПроцента"));
	
	Команда.ЕстьУсловияВидимости = Истина;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(
		Команда, "ТипКотировки", Список, ВидСравненияКомпоновкиДанных.ВСписке);

КонецПроцедуры

#КонецОбласти

Функция НовыйНабор(Наборы, ОбъектМетаданных, Идентификатор, Используется = Истина)
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Набор = Наборы.Строки.Добавить();
	
	Набор.Идентификатор	= Новый УникальныйИдентификатор(Идентификатор);
	Набор.Имя 			= СтрЗаменить(ОбъектМетаданных.ПолноеИмя(), ".", "_");
	Набор.Используется	= Используется;
	
	Возврат Набор;
	
КонецФункции

#КонецОбласти
