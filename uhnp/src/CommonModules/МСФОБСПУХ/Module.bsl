Процедура ПроверитьПриЗаполненииВидовОграничений(ОбъектыПроверки, ПараметрыПроверки, Исключения)
	
	УточнениеЧтение = НСтр("ru = 'Тип не включен на чтение в <УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных>'"); 
	УточнениеЗапись = НСтр("ru = 'Тип не включен на изменение в <УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных>'");
	
	ОписаниеДоступа = "";
	УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(ОписаниеДоступа);
	Для каждого ТекМД Из ОбъектыПроверки Цикл

		Если Исключения.Найти(ТекМД.Ключ.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНайти(ОписаниеДоступа, "Документ." + ТекМД.Ключ.Имя + ".Чтение.Организации") = 0 Тогда
			Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
			ЗаписатьПроблему(Ид, УточнениеЧтение, ПараметрыПроверки);
		КонецЕсли;
		
		Если СтрНайти(ОписаниеДоступа, "Документ." + ТекМД.Ключ.Имя + ".Изменение.Организации") = 0 Тогда
			Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
			ЗаписатьПроблему(Ид, УточнениеЗапись, ПараметрыПроверки);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПриЗаполненииСписковСОграничениемДоступа(ОбъектыПроверки, ПараметрыПроверки, Исключения)
	
	УточнениеОшибки = НСтр("ru = 'Тип не включен на чтение в <УправлениеДоступомБМ.ПриЗаполненииСписковСОграничениемДоступа>'"); 
	
	Списки = Новый Соответствие;
	
	УправлениеДоступомБМ.ПриЗаполненииСписковСОграничениемДоступа(Списки);
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		МодульУправлениеДоступомУХ = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступомУХ");
		МодульУправлениеДоступомУХ.ПриЗаполненииСписковСОграничениемДоступа(Списки);
	КонецЕсли;
	
	Для каждого ТекМД Из ОбъектыПроверки Цикл

		Если Исключения.Найти(ТекМД.Ключ.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Списки.Получить(ТекМД.Ключ) = Неопределено Тогда
			Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
			ЗаписатьПроблему(Ид, УточнениеОшибки, ПараметрыПроверки);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

