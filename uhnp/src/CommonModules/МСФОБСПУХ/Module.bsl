Процедура ПодключаемаяКоманда_ПерейтиИзДокументаМСФО(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды)
	
	МСФО = Метаданные.РегистрыБухгалтерии.МСФО;
	
	ТипыОбъектов = Новый Массив;
	Для каждого СтрокаИсточник Из Источники.Строки Цикл
		
		Если Не СтрокаИсточник.Вид = "ДОКУМЕНТ" Тогда 
			Продолжить;
		КонецЕсли;

		Если Не ОбщегоНазначения.ОбъектМетаданныхДоступенПоФункциональнымОпциям(СтрокаИсточник.Метаданные) Тогда
			Продолжить;
		КонецЕсли;
	
		Если СтрНайти(СтрокаИсточник.ПолноеИмя, "МСФО") > 0 Тогда
			ТипыОбъектов.Добавить(СтрокаИсточник.ТипСсылкиДанных);
		ИначеЕсли СтрокаИсточник.Метаданные.Движения.Содержит(МСФО) Тогда
			ТипыОбъектов.Добавить(СтрокаИсточник.ТипСсылкиДанных);
		КонецЕсли;
		
	КонецЦикла;
	
	ТипыОбъектов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТипыОбъектов);
	
	Если ТипыОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипПараметра = Новый ОписаниеТипов(ТипыОбъектов);
	
	Команда = ДобавитьПодключаемуюКоманду(Команды, "УПМСФО", ТипПараметра);
	Команда.Представление = НСтр("ru = 'Учетная политика МСФО'");
	Команда.Вид = "Отчеты";
	Команда.Важность = "СмТакже";
	Команда.ТолькоВоВсехДействиях = Истина;
	Команда.Картинка = БиблиотекаКартинок.Документ;
	Команда.Обработчик = "МСФОКлиентУХ.ПерейтиИзДокумента_Подключаемый";
	
	Команда = ДобавитьПодключаемуюКоманду(Команды, "АОСВМСФО", ТипПараметра);
	Команда.Представление = НСтр("ru = 'Аналитическая ОСВ МСФО'");
	Команда.Вид = "Отчеты";
	Команда.Важность = "СмТакже";
	Команда.ТолькоВоВсехДействиях = Истина;
	Команда.Картинка = БиблиотекаКартинок.НастраиваемыеОтчеты;
	Команда.Обработчик = "МСФОКлиентУХ.ПерейтиИзДокумента_Подключаемый";
	
	//Команда = ДобавитьПодключаемуюКоманду(Команды, "ОСВМСФО", ТипПараметра);
	//Команда.Представление = НСтр("ru = 'ОСВ МСФО'");
	//Команда.Вид = "ПерейтиУХ";
	//Команда.Картинка = БиблиотекаКартинок.Отчет;
	//Команда.Обработчик = "МСФОКлиентУХ.ПерейтиИзДокумента_Подключаемый";
	
	Команда = ДобавитьПодключаемуюКоманду(Команды, "УОП", ТипПараметра);
	Команда.Представление = НСтр("ru = 'Управление отчетным периодом'");
	Команда.Вид = "Отчеты";
	Команда.Важность = "СмТакже";
	Команда.ТолькоВоВсехДействиях = Истина;
	Команда.Картинка = БиблиотекаКартинок.УправлениеПериодомСценария_32;
	Команда.Обработчик = "МСФОКлиентУХ.ПерейтиИзДокумента_Подключаемый";
	
КонецПроцедуры

Процедура ПодключаемаяКоманда_ЗагрузкаДанныхУХ(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды)

	ИмяОбъекта = Лев(НастройкиФормы.ИмяФормы, СтрНайти(НастройкиФормы.ИмяФормы, ".",,, 2) - 1);//до второй точки
	
	Если ИмяОбъекта = "Документ.РезервыПоДЗИАвансамВыданным" Тогда
		
		ФГА = Справочники.ФиксированныеГруппыАналитик.РезервыДЗ_НачислениеРезерваМСФО;
		ДопПараметры = Новый Структура("ИмяОбъекта, ИмяТЧ, ФГА", ИмяОбъекта, "Резервы", ФГА);
		
	ИначеЕсли ИмяОбъекта = "Документ.РезервыПоЗапасам" Тогда
		
		ФГА = Справочники.ФиксированныеГруппыАналитик.РезервыМПЗ_НачислениеРезерваМСФО;
