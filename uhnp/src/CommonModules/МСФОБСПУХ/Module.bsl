
#Область ПрограммныйИнтерфейс

#Область БСП_КонтрольВеденияУчета

// См. КонтрольВеденияУчетаПереопределяемый.ПриОпределенииПроверок.
Процедура ПриОпределенииПроверок(ГруппыПроверок, Проверки) Экспорт
	
	ГруппаПроверок = ГруппыПроверок.Добавить();
	ГруппаПроверок.Наименование					= НСтр("ru = 'МСФО'");
	ГруппаПроверок.Идентификатор				= ИдентификаторГруппыПроверок();
	ГруппаПроверок.КонтекстПроверокВеденияУчета	= ГруппаПроверок.Идентификатор;
	
	ПриОпределенииПроверок_БСП(ГруппыПроверок, Проверки);
	ПриОпределенииПроверок_РУ(ГруппыПроверок, Проверки);
	
КонецПроцедуры

// См. ИнтеграцияПодсистемБСП.ПриОпределенииОбъектовИсключаемыхИзПроверки
Процедура ПриОпределенииОбъектовИсключаемыхИзПроверки(Объекты) Экспорт
	Объекты.Добавить(Метаданные.Справочники.ФиксированныеГруппыАналитик);
КонецПроцедуры

#Область ОбработчикПроверки

#Область ОбработчикПроверки_БСП

// Запускает проверку по ее идентификатору
//
// Параметры:
//   Проверка            - СправочникСсылка.ПравилаПроверкиУчета, Строка - исполняемая проверка или ее идентификатор.
//   ПараметрыПроверки   - см. АудитСостоянияСистемы.ИнициализироватьПараметрыПроверки
//
Процедура ОбработчикПроверки_ВерсионируемыеДанные(Проверка, ПараметрыПроверки) Экспорт
	
	РодителиМД = РодителиМД("Справочники, Документы, ПланыВидовХарактеристик, ПланыСчетов");
	
	Исключения = Новый Массив;
	Исключения.Добавить("ДополнительныеРеквизитыИСведения");
	
	ПодсистемаПроверки = Метаданные.Подсистемы.ПодсистемыУХ.Подсистемы.ОбъектыМСФО;
	ОбъектыПроверки = ОбъектыПодсистемы(ПодсистемаПроверки, РодителиМД);

	ПодсистемаПроверки = Метаданные.Подсистемы.УчетМСФО.Подсистемы.Найти("ТрансляцияИТрансформация");
	ОбъектыПроверки = ОбъектыПодсистемы(ПодсистемаПроверки, РодителиМД, ОбъектыПроверки);
	
	ПодсистемаПроверки = Метаданные.Подсистемы.Найти("КонсолидацияПоМСФО");
	ОбъектыПроверки = ОбъектыПодсистемы(ПодсистемаПроверки, РодителиМД, ОбъектыПроверки);
	
	ТипСсылки 		= Метаданные.ОпределяемыеТипы.ВерсионируемыеДанные.Тип;
	ТипОбъекты 		= Метаданные.ОпределяемыеТипы.ВерсионируемыеДанныеОбъект.Тип;
	ТипДокументы	= Метаданные.ПодпискиНаСобытия.ЗаписатьВерсиюДокументаУХ.Источник;
	
	УточнениеСсылка = НСтр("ru = 'Тип не включен в <ВерсионируемыеДанные>'"); 
	УточнениеОбъект = НСтр("ru = 'Тип не включен в <ВерсионируемыеДанныеОбъект>'");
	ОшибкаДокумент = НСтр("ru = 'Тип не включен в <ЗаписатьВерсиюДокументаУХ>'");

	Для каждого ТекМД Из ОбъектыПроверки Цикл

		Если Исключения.Найти(ТекМД.Ключ.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПолноеИмя = ТекМД.Ключ.ПолноеИмя();
			
		Если Не ТипСсылки.СодержитТип(Тип(СтрЗаменить(ПолноеИмя, ".",  "Ссылка."))) Тогда
			Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
			ЗаписатьПроблему(Ид, УточнениеСсылка, ПараметрыПроверки);
		КонецЕсли;
		
		Если Метаданные.Справочники.Найти(ТекМД.Ключ.Имя) <> Неопределено Тогда
			
			// ВерсионируемыеДанныеОбъект - только для справочников
			Если Не ТипОбъекты.СодержитТип(Тип(СтрЗаменить(ПолноеИмя, ".",  "Объект."))) Тогда
				Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
				ЗаписатьПроблему(Ид, УточнениеОбъект, ПараметрыПроверки);
			КонецЕсли;
			
		ИначеЕсли Метаданные.Документы.Найти(ТекМД.Ключ.Имя) <> Неопределено Тогда
			
			// ЗаписатьВерсиюДокументаУХ - только для документов
			Если Не ТипДокументы.СодержитТип(Тип(СтрЗаменить(ПолноеИмя, ".",  "Объект."))) Тогда
				Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
				ЗаписатьПроблему(Ид, ОшибкаДокумент, ПараметрыПроверки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
 	
КонецПроцедуры

 // Запускает проверку по ее идентификатору
//
// Параметры:
//   Проверка            - СправочникСсылка.ПравилаПроверкиУчета, Строка - исполняемая проверка или ее идентификатор.
//   ПараметрыПроверки   - см. АудитСостоянияСистемы.ИнициализироватьПараметрыПроверки
//
Процедура ОбработчикПроверки_УправлениеДоступом(Проверка, ПараметрыПроверки) Экспорт
	
	РодителиМД = РодителиМД("Документы");

	Исключения = Новый Массив;
	
	ПодсистемаПроверки = Метаданные.Подсистемы.ПодсистемыУХ.Подсистемы.ОбъектыМСФО;
	ОбъектыПроверки = ОбъектыПодсистемы(ПодсистемаПроверки, РодителиМД);
	
	ПодсистемаПроверки = Метаданные.Подсистемы.УчетМСФО.Подсистемы.Найти("ТрансляцияИТрансформация");
	ОбъектыПроверки = ОбъектыПодсистемы(ПодсистемаПроверки, РодителиМД, ОбъектыПроверки);
	
	ПодсистемаПроверки = Метаданные.Подсистемы.Найти("КонсолидацияПоМСФО");
	ОбъектыПроверки = ОбъектыПодсистемы(ПодсистемаПроверки, РодителиМД, ОбъектыПроверки);
	
	ВладелецЗначенийКлючейДоступа = Метаданные.ОпределяемыеТипы.ВладелецЗначенийКлючейДоступа.Тип;
	ВладелецЗначенийКлючейДоступаДокумент = Метаданные.ОпределяемыеТипы.ВладелецЗначенийКлючейДоступаДокумент.Тип;
	
	УточнениеСсылка = НСтр("ru = 'Тип не включен в <ВладелецЗначенийКлючейДоступа>'"); 
	УточнениеОбъект = НСтр("ru = 'Тип не включен в <ВладелецЗначенийКлючейДоступаДокумент>'");
	
	Для каждого ТекМД Из ОбъектыПроверки Цикл
		
		Если Исключения.Найти(ТекМД.Ключ.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолноеИмя = ТекМД.Ключ.ПолноеИмя();
			
		Если Не ВладелецЗначенийКлючейДоступа.СодержитТип(Тип(СтрЗаменить(ПолноеИмя, ".",  "Ссылка."))) Тогда
			Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
			ЗаписатьПроблему(Ид, УточнениеСсылка, ПараметрыПроверки);
		КонецЕсли;
		
		Если Метаданные.Справочники.Найти(ТекМД.Ключ.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// ВерсионируемыеДанныеОбъект - только для справочников
		Если Не ВладелецЗначенийКлючейДоступаДокумент.СодержитТип(Тип(СтрЗаменить(ПолноеИмя, ".",  "Объект."))) Тогда
			Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекМД.Ключ);
			ЗаписатьПроблему(Ид, УточнениеОбъект, ПараметрыПроверки);
		КонецЕсли;
		
	КонецЦикла;
	
	Исключения.Добавить("УчетнаяПолитикаМСФО");//у документа нет РЛС тк нет организации в шапке
	
	ПроверитьПриЗаполненииВидовОграничений(ОбъектыПроверки, ПараметрыПроверки, Исключения);
	ПроверитьПриЗаполненииСписковСОграничениемДоступа(ОбъектыПроверки, ПараметрыПроверки, Исключения)
	
КонецПроцедуры

