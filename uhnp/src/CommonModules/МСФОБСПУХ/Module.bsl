// Возвращает признак вхождения переданного объекта метаданных в переданную подсистему
//
// Параметры:
//   ПолноеИмяИлиМетаданныеПодсистемы - Строка           - полное имя подсистемы с учетом родительских подсистем через "."
//                                    - ОбъектМетаданных - сама подсистема
//   ОбъектМетаданных                 - ОбъектМетаданных - объект метаданных для которого определяется принадлежность к подсистеме
//
// Возвращаемое значение:
//   Булево - признак вхождения объекта метаданных в подсистему
//
Функция СодержитсяВПодсистеме(ПолноеИмяИлиМетаданныеПодсистемы, ОбъектМетаданных)
	
	Если ТипЗнч(ПолноеИмяИлиМетаданныеПодсистемы) = Тип("Строка") Тогда
		
		ИменаПодсистем = СтрРазделить(ПолноеИмяИлиМетаданныеПодсистемы, ".");
		Если ИменаПодсистем.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		МетаданныеПодсистемы = Метаданные;
		
		Для Каждого ИмяПодсистемы Из ИменаПодсистем Цикл
			МетаданныеПодсистемы = МетаданныеПодсистемы.Подсистемы[ИмяПодсистемы];
		КонецЦикла;
		
	Иначе
		
		МетаданныеПодсистемы = ПолноеИмяИлиМетаданныеПодсистемы;
		
	КонецЕсли;
	
	Если МетаданныеПодсистемы.Состав.Содержит(ОбъектМетаданных) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого ПодчиненнаяПодсистема Из МетаданныеПодсистемы.Подсистемы Цикл
		Если СодержитсяВПодсистеме(ПодчиненнаяПодсистема, ОбъектМетаданных) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция РодителиМД(ИменаРодители)
	
	ИменаМД = Новый Структура(ИменаРодители);
	
	РодителиМД = Новый Массив;
	Для каждого ТекущееИмя Из ИменаМД Цикл
		РодителиМД.Добавить(Метаданные[ТекущееИмя.Ключ]);
	КонецЦикла;
	
	Возврат РодителиМД;

КонецФункции

Функция ОбъектыПодсистемы(ПодсистемаДляОбработки = Неопределено, РодителиМД, Результат = Неопределено)
	
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
	КонецЕсли;
	
	Если ПодсистемаДляОбработки = Неопределено Тогда
		Возврат Результат;// нет подсистемы
	КонецЕсли;
	
	СоставПодсистемы = ПодсистемаДляОбработки.Состав;
	Для каждого ТекущияОбъект Из СоставПодсистемы Цикл
		
		Если СтрНачинаетсяС(ТекущияОбъект.Имя, "Удалить") Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ТекущийРодитель Из РодителиМД Цикл
			
			//Если ТекущийРодитель.Содержит(ТекущияОбъект) Тогда//82%
			Если ТекущийРодитель.Найти(ТекущияОбъект.Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекущийРодитель.Содержит(ТекущияОбъект) Тогда
			
				Результат.Вставить(ТекущияОбъект, Истина);
				Прервать;
			
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	Для каждого ТекущаяПодсистема Из ПодсистемаДляОбработки.Подсистемы Цикл
		ОбъектыПодсистемы(ТекущаяПодсистема, РодителиМД, Результат);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УдалитьОбъектыПодсистемы(Результат, УдаляемыеОбъекты)

	Для каждого _ Из УдаляемыеОбъекты Цикл
		Результат.Удалить(_.Ключ);
	КонецЦикла;

КонецФункции

Функция ЗаписатьПроблему(ПроблемныйОбъект, УточнениеПроблемы, ПараметрыПроверки, Ответственный = Неопределено)

	Проблема = КонтрольВеденияУчета.ОписаниеПроблемы(ПроблемныйОбъект, ПараметрыПроверки);
	Проблема.Ответственный = Ответственный;
	Проблема.УточнениеПроблемы = УточнениеПроблемы;
	
	КонтрольВеденияУчета.ЗаписатьПроблему(Проблема, ПараметрыПроверки);

КонецФункции

