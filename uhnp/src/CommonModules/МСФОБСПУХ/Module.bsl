Функция ИменаПравТипаМетаданных(ИмяТипаМетаданных = "Документы", ТолькоПросмотр = Истина)

	Если ИмяТипаМетаданных = "Документы" Тогда
		
		Возврат ИменаПрав("Добавление, Изменение, Редактирование", ТолькоПросмотр, Истина, Истина);
		
	ИначеЕсли ИмяТипаМетаданных = "Справочники" 
		ИЛИ ИмяТипаМетаданных = "ПланыВидовХарактеристик" Тогда

		Возврат ИменаПрав("Добавление, Изменение, Редактирование", ТолькоПросмотр, Истина, Истина);
	
	ИначеЕсли ИмяТипаМетаданных = "РегистрыНакопления" Тогда
		
		Возврат ИменаПрав("Изменение, Редактирование", ТолькоПросмотр);
		
	ИначеЕсли ИмяТипаМетаданных = "РегистрыСведений" Тогда
		
		Возврат ИменаПрав("Изменение, Редактирование", ТолькоПросмотр);
		
	ИначеЕсли ИмяТипаМетаданных = "РегистрыБухгалтерии" Тогда
		
		Возврат ИменаПрав("Изменение, Редактирование", ТолькоПросмотр);
		
	ИначеЕсли ИмяТипаМетаданных = "Обработки" Тогда
		
		Возврат ИменаПрав("Просмотр", Ложь);
		
	ИначеЕсли ИмяТипаМетаданных = "Отчеты" Тогда
		
		Возврат ИменаПрав("Просмотр", Ложь);
		
	ИначеЕсли ИмяТипаМетаданных = "Константы" Тогда
		
		Возврат ИменаПрав("Изменение", ТолькоПросмотр);
		
	ИначеЕсли ИмяТипаМетаданных = "ЖурналыДокументов" Тогда
		
		Возврат ИменаПрав("Чтение, Просмотр", Ложь);

	ИначеЕсли ИмяТипаМетаданных = "ОбщиеКоманды" Тогда

		Возврат ИменаПрав("Просмотр", Ложь);

	КонецЕсли;

	Возврат Новый Структура;
	
КонецФункции

Функция ИменаПрав(ИменаТолькоПросмотр, ТолькоПросмотр = Истина, ДобавитьКакСправочник = Ложь, ДобавитьИсторию = Ложь)
	
	ИменаПрав = Новый Структура(ИменаТолькоПросмотр);
	Для каждого _ Из ИменаПрав Цикл
		ИменаПрав.Вставить(_.Ключ, Не ТолькоПросмотр);
	КонецЦикла;
	
	Если ДобавитьКакСправочник Тогда
		
		ИменаПрав.Вставить("Чтение",		Истина);
		ИменаПрав.Вставить("Просмотр",		Истина);

		ИменаПрав.Вставить("Удаление",		Ложь);
		ИменаПрав.Вставить("ВводПоСтроке",	Истина);

	КонецЕсли;
	
	Возврат ИменаПрав;
	
КонецФункции

Функция ПроцессорПроверкиРоли(ПараметрыПроверки = Неопределено)

	Процессор = Новый Структура(
		"КэшПоляОбъектов, ИсключенияПроверки, ИменаТиповМетаданных",
		Новый Соответствие, Новый Соответствие);
		
	ПроверитьРЛС = Истина;
	
	ИменаТиповМетаданных = Новый Структура(
	"Документы, Справочники, ПланыВидовХарактеристик,
	|РегистрыНакопления, РегистрыСведений, РегистрыБухгалтерии,
	|Обработки, Отчеты,
	|Константы, ЖурналыДокументов, ОбщиеКоманды", ПроверитьРЛС);
	
	Процессор.Вставить("ИменаТиповМетаданных",	ИменаТиповМетаданных);
	Процессор.Вставить("ПараметрыПроверки",		ПараметрыПроверки);
	
	Возврат Процессор;
	
КонецФункции

Процедура ПроверитьРоль(МетаданныеРоль, ТолькоПросмотр = Истина, ОбъектыРоли = Неопределено, ПроцессорПроверкиРоли = Неопределено)
	
	Процессор = ПроцессорПроверкиРоли;
	Если Процессор = Неопределено Тогда
		Процессор = ПроцессорПроверкиРоли();
	КонецЕсли;

	ОпределитьДоступ = (ОбъектыРоли = Неопределено);
	КэшПоляОбъектов = Новый Соответствие;
	
	Для Каждого ТипМетаданных Из Процессор.ИменаТиповМетаданных Цикл
	
		ИменаПрав = ИменаПравТипаМетаданных(ТипМетаданных.Ключ, ТолькоПросмотр);
		
		ПроверитьРЛС = (ТипМетаданных.Значение = Истина);
		ЕстьИдентификатор = (ТипМетаданных.Ключ <> "ОбщиеКоманды");
		
		Для Каждого ОбъектМетаданных Из Метаданные[ТипМетаданных.Ключ] Цикл
			
			Если Процессор.ИсключенияПроверки.Получить(ОбъектМетаданных) <> Неопределено Тогда
				Продолжить; //исключен МД
			КонецЕсли;
			
			ДолженБытьДоступ = Ложь;
			Если ОпределитьДоступ Тогда
				ДолженБытьДоступ = Истина;//когда роль передается без объектов
			Иначе 
				ДолженБытьДоступ = ОбъектыРоли.Получить(ОбъектМетаданных) <> Неопределено;
			КонецЕсли;
			
			Для Каждого ПравоРоли Из ИменаПрав Цикл
				
				ПараметрыДоступа = ПолучитьПараметрыДоступа(
					ОбъектМетаданных, МетаданныеРоль, ПравоРоли, ПроверитьРЛС, КэшПоляОбъектов);
				
				УточнениеОбъект = ПолучитьУточнениеОшибки(
					ПараметрыДоступа, ДолженБытьДоступ И ПравоРоли.Значение, ПроверитьРЛС, МетаданныеРоль, ПравоРоли);
					
				Если УточнениеОбъект = Неопределено Тогда
					Продолжить;//нет ошибки
				КонецЕсли;
				
				Если ЕстьИдентификатор Тогда
					Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОбъектМетаданных);
				Иначе
					Ид = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеРоль);
				КонецЕсли;
				ЗаписатьПроблему(Ид, УточнениеОбъект, Процессор.ПараметрыПроверки);

			КонецЦикла;
		
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьУточнениеОшибки(ПараметрыДоступа, ДолженБытьДоступ, ПроверитьРЛС, МетаданныеРоль, ПравоРоли)
	
	ИмяРоли = МетаданныеРоль.Имя;
	
	Если ДолженБытьДоступ Тогда
		
		Если Не ПараметрыДоступа.Доступность Тогда
			Шаблон = НСтр("ru = 'Для роли <%1> требуется добавить право <%2>'");
		ИначеЕсли (ПравоРоли.Ключ <> "Чтение") И (ПравоРоли.Ключ <> "Добавление") И (ПравоРоли.Ключ <> "Изменение") Тогда
			Возврат Неопределено;//нет ошибки, нет РЛС
		ИначеЕсли ПроверитьРЛС И Не ПараметрыДоступа.ОграничениеУсловием Тогда
			Шаблон = НСтр("ru = 'Для роли <%1> требуется у права <%2> добавить ограничение доступа (RLS)'");
		ИначеЕсли Не ПроверитьРЛС И ПараметрыДоступа.ОграничениеУсловием Тогда
			Шаблон = НСтр("ru = 'Для роли <%1> требуется у права <%2> удалить ограничение доступа (RLS)'");
		Иначе 
			Возврат Неопределено;//нет ошибки
		КонецЕсли;
		
	Иначе //Не ДолженБытьДоступ
		
		Если ПараметрыДоступа.Доступность Тогда
			Шаблон = НСтр("ru = 'Для роли <%1> требуется удалить право <%2>'");
		Иначе 
			Возврат Неопределено;//нет ошибки
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрШаблон(Шаблон, МетаданныеРоль.Имя, ПравоРоли.Ключ);
	
КонецФункции

Функция ПолучитьПараметрыДоступа(ОбъектМетаданных, МетаданныеРоль, ПравоРоли, ПроверитьРЛС, КэшПоляОбъектов)
	
	Если ПроверитьРЛС Тогда
		
		Возврат ПараметрыДоступаПрава(
			ПравоРоли.Ключ, ОбъектМетаданных, КэшПоляОбъектов, МетаданныеРоль);
		
	КонецЕсли;
		
	ЕстьПраво = ПравоДоступа(ПравоРоли.Ключ, ОбъектМетаданных, МетаданныеРоль);
	Возврат Новый Структура(
		"Доступность, ОграничениеУсловием", ЕстьПраво, Ложь);

КонецФункции

//См. Отчет.ПраваРолей
Функция ПараметрыДоступаПрава(ИмяПрава, ОбъектМетаданных, КэшПоляОбъектов, Роль)
	
	Поля = КэшПоляОбъектов.Получить(ОбъектМетаданных);
	
	Если Поля = Неопределено Тогда
		Поля = РегистрыСведений.ПраваРолей.ВсеПоляОграниченияДоступаОбъектаМетаданных(
			ОбъектМетаданных, ОбъектМетаданных.ПолноеИмя());
		КэшПоляОбъектов.Вставить(ОбъектМетаданных, Поля);
	КонецЕсли;
	
	Возврат ПараметрыДоступа(ИмяПрава, ОбъектМетаданных, Поля, Роль);
	
КонецФункции

