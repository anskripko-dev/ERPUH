
#Область СлужебныйПрограммныйИнтерфейс

#Область ФормаСтатьиБюджета
	
// Действия, при изменении вида аналитики в таблице видов аналитик
Процедура ВидыАналитикПриИзменении(Форма, УстанавливатьПризнакКонтроляАналитики = Истина) Экспорт
	
	АналитикиСтатейБюджетовУХКлиентСервер.ВычислитьМаксимальныйНомерЗаполненнойАналитики(Форма);
	Форма.Модифицированность = Истина;
	
	Если УстанавливатьПризнакКонтроляАналитики = Истина Тогда
		Для Каждого Строка Из Форма.ВидыАналитик Цикл
			Если Строка.НомерАналитики > Форма.МаксимальныйНомерЗаполненнойАналитики Тогда
				Строка.КонтролироватьАналитику = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


Процедура ДекорацияБлокирующиеСсылкиНажатие(СтатьяСсылка) Экспорт
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("БлокированныйОбъект", СтатьяСсылка);
	ДопПараметры.Вставить("БлокирующиеСсылки", АналитикиСтатейБюджетовУХВызовСервера.БлокирующиеСсылки(СтатьяСсылка));
	
	ОткрытьФорму("ОбщаяФорма.СписокБлокирующихСсылок", ДопПараметры, ЭтотОбъект, ,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура КонтролироватьАналитикуСтатьиПриИзменении(Форма) Экспорт
	
	ТекущиеДанные = Форма.Элементы.ВидыАналитик.ТекущиеДанные;
	Если ТекущиеДанные.КонтролироватьАналитику = 2 Тогда
		ТекущиеДанные.КонтролироватьАналитику = 0;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Форма.КонтрольЛимитов) Тогда
		Форма.КонтрольЛимитов = Форма.КонтрольЛимитовБюджет;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Форма.КонтрольРезервов) Тогда
		Форма.КонтрольРезервов = Форма.КонтрольРезервовБюджет;
	КонецЕсли;
	Форма.КонтролироватьСтатью = Истина;

КонецПроцедуры

Процедура ПослеЗаписиСтатьиБюджета(Форма) Экспорт
	
	Если Форма.ВладелецФормы <> Неопределено Тогда
		ОповеститьОбИзменении(Форма.Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменениеГодаФормыСтатьиНачало(Форма, Команда) Экспорт
	
	Завершение = Новый ОписаниеОповещения("ИзмененииГодаФормыСтатьиЗавершение", 
											ЭтотОбъект,
											Новый Структура("Форма, Команда", Форма, Команда));
	ИмяЭлемента = "ПараметрыЛимитированияГод";										
	Если Форма.Модифицированность Тогда
		ЗначениеКонтроля = Форма.Элементы[ИмяЭлемента].СписокВыбора.НайтиПоЗначению(Форма[ИмяЭлемента]);
		ПредставлениеГода = СтрЗаменить(ЗначениеКонтроля.Представление, " ", "");
		ПоказатьВопрос(Завершение, 
						СтрШаблон(НСтр("ru = 'Сохранить изменение параметров лимитирования статьи на %1?'"), ПредставлениеГода) ,
						РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		ВыполнитьОбработкуОповещения(Завершение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры  

Процедура ИзмененииГодаФормыСтатьиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда 
		
		Если ДополнительныеПараметры.Форма.Модифицированность Тогда
			ДополнительныеПараметры.Форма.Записать();
		КонецЕсли;
		ИзменениеГодаФормыСтатьи(ДополнительныеПараметры);
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		
		ИзменениеГодаФормыСтатьи(ДополнительныеПараметры);
	
	КонецЕсли;

КонецПроцедуры

Процедура ИзменениеГодаФормыСтатьи(Знач ДополнительныеПараметры)
	
	Элементы = ДополнительныеПараметры.Форма.Элементы;
	Команда = ДополнительныеПараметры.Команда;
	Форма = ДополнительныеПараметры.Форма;
	
	ИмяЭлемента = "ПараметрыЛимитированияГод";
	
	Если Команда.Имя = "ДобавитьГод" Тогда
		
		ЗначениеКонтроля = Элементы[ИмяЭлемента].СписокВыбора.НайтиПоЗначению(Форма[ИмяЭлемента]); 
		Если ЗначениеКонтроля = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НомерЭлемента = Элементы[ИмяЭлемента].СписокВыбора.Индекс(ЗначениеКонтроля);
		
		Если НомерЭлемента <> 0 Тогда
			НовоеЗначение = Элементы[ИмяЭлемента].СписокВыбора.Получить(НомерЭлемента - 1); 
			ИзменениеГодаФормыСтатьиУстановкаГода(НовоеЗначение, ДополнительныеПараметры);
		КонецЕсли;
		
	ИначеЕсли Команда.Имя = "ОтнятьГод" Тогда
		
		ЗначениеКонтроля = Элементы[ИмяЭлемента].СписокВыбора.НайтиПоЗначению(Форма[ИмяЭлемента]); 
		Если ЗначениеКонтроля = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НомерЭлемента = Элементы[ИмяЭлемента].СписокВыбора.Индекс(ЗначениеКонтроля);
		
		Если Элементы[ИмяЭлемента].СписокВыбора.Количество() > НомерЭлемента + 1 Тогда
			НовоеЗначение = Элементы[ИмяЭлемента].СписокВыбора.Получить(НомерЭлемента + 1);
			ИзменениеГодаФормыСтатьиУстановкаГода(НовоеЗначение, ДополнительныеПараметры);
		КонецЕсли;
		
	ИначеЕсли Команда.Имя = "ВыбранныйГод" Тогда
		Оповещение = Новый ОписаниеОповещения("ИзменениеГодаФормыСтатьиУстановкаГода", 
																ЭтотОбъект,
																ДополнительныеПараметры);										
		Форма.ПоказатьВыборИзМеню(Оповещение, Элементы[ИмяЭлемента].СписокВыбора); //, Элементы[ИмяЭлемента].Родитель);  	
	КонецЕсли;

КонецПроцедуры

Процедура ИзменениеГодаФормыСтатьиУстановкаГода(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ДополнительныеПараметры.Форма["ПараметрыЛимитированияГод"] = ВыбранныйЭлемент.Значение;
		ДополнительныеПараметры.Форма.Элементы["ВыбранныйГод"].Заголовок = ВыбранныйЭлемент.Представление;	
	КонецЕсли;
	
	Оповестить("ИзменениеГодаФормыСтатьи", , ДополнительныеПараметры.Форма);

КонецПроцедуры

Процедура ИзменениеКонтрольЛимитов(Форма, ИмяЭлемента) Экспорт
	
	Элементы = Форма.Элементы;  
	
	Если ИмяЭлемента = "КонтрольРезервов" Тогда
		КонтрольУХКлиентСервер.ПриИзмененииКонтроляРезервов(Форма["КонтрольЛимитов"] , Форма["КонтрольРезервов"]);	
	ИначеЕсли ИмяЭлемента = "КонтрольЛимитов" Тогда
		КонтрольУХКлиентСервер.ПриИзмененииКонтроляЛимитов(Форма["КонтрольЛимитов"] , Форма["КонтрольРезервов"]);
	КонецЕсли;
	
	Форма.КонтролироватьСтатью = Форма["КонтрольЛимитов"] <> ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка");
	Если Не Форма.КонтролироватьСтатью Тогда
		Для НомерСтроки = 1 По Форма.МаксимальныйНомерЗаполненнойАналитики Цикл
			Форма.ВидыАналитик[НомерСтроки-1].КонтролироватьАналитику = 2; //
		КонецЦикла;
	Иначе
		Для НомерСтроки = 1 По Форма.МаксимальныйНомерЗаполненнойАналитики Цикл
			Форма.ВидыАналитик[НомерСтроки-1].КонтролироватьАналитику = Форма.ВидыАналитик[НомерСтроки-1].КонтролироватьАналитикуБюджет; 
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВидБюджетаНажатие(Форма, Элемент, СтандартнаяОбработка) Экспорт

	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ВидБюджетаЗавершение", ЭтотОбъект, Новый Структура("Форма", Форма));
	Форма.ПоказатьВыборИзМеню(Оповещение, Форма.ВидыБюджета);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВидБюджетаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ДополнительныеПараметры.Форма.ПараметрыЛимитированияВидБюджета = ВыбранныйЭлемент.Значение; 
		Оповестить("ИзменениеПараметрыЛимитированияВидБюджета", , ДополнительныеПараметры.Форма); 
	КонецЕсли;

КонецПроцедуры

Процедура НажатиеЗамкаСтатьи(Знач Форма) Экспорт
	
	ТекстВопроса = НСтр("ru = 'Для того чтобы не допустить рассогласования данных в программе,
						|параметры контроля не доступны для редактирования.
						|
						|Перед тем, как разрешить их редактирование, рекомендуется оценить последствия,
						|проверив все места использования этого элемента в программе.
						|Поиск мест использования может занять длительное время.'");
	
	ПоказатьВопрос(Новый ОписаниеОповещения("НажатиеЗамкаСтатьиЗавершение", 
					ЭтотОбъект, 
					Новый Структура("Форма", Форма)), 
					ТекстВопроса, 
					РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

Процедура НажатиеЗамкаСтатьиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Форма.Элементы["КонтрольСтатьи"].ТолькоПросмотр 		= Ложь;
		Форма.Элементы["КонтрольЛимитов"].ТолькоПросмотр 		= Ложь;
		Форма.Элементы["КонтрольРезервов"].ТолькоПросмотр 		= Ложь;
		Форма.Элементы["КонтролироватьСтатью"].ТолькоПросмотр 	= Ложь;
		Форма.Элементы["ВидыАналитикКонтролироватьАналитику"].ТолькоПросмотр 	= Ложь;
		Форма.Элементы["ЗапретРедактированияПараметровКонтроля"].Видимость 		= Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытий
	
Процедура ПриИзмененииСтатьиБюджета(Форма, ИмяЭлемента) Экспорт
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ОписаниеФормы") Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеФормы = Форма.ОписаниеФормы;
	Если ОписаниеФормы = Неопределено 
		ИЛИ ТипЗнч(ОписаниеФормы) <> Тип("ФиксированнаяСтруктура") 
		ИЛИ Не ОписаниеФормы.Свойство("СтатьиБюджетов") 
		ИЛИ ТипЗнч(ОписаниеФормы.СтатьиБюджетов) <> Тип("Соответствие")	Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатьи = ОписаниеФормы.СтатьиБюджетов[ИмяЭлемента];
	Если ОписаниеСтатьи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//
	Если ОписаниеСтатьи.ЭтоТаблица Тогда
		Таблица = АналитикиСтатейБюджетовУХКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, ОписаниеСтатьи.ПутьКДанным);
		ИмяЭлементаТаблицаФормы = ОписаниеСтатьи.ЭлементыФормы.Получить(ИмяЭлемента).ИмяТаблицыФормы;
		СтрокаТаблицы = Таблица.НайтиПоИдентификатору(Форма.Элементы[ИмяЭлементаТаблицаФормы].ТекущаяСтрока);
		ЗначениеСтатьи = СтрокаТаблицы[ОписаниеСтатьи.ИмяРеквизита];
		ДанныеВидАналитики	= СтрокаТаблицы;
		ДанныеАналитика		= СтрокаТаблицы;
	Иначе
		ПутьКДанным = ОписаниеСтатьи.ИмяРеквизита;
		Если ЗначениеЗаполнено(ОписаниеСтатьи.ПутьКДанным) Тогда
			ПутьКДанным = ОписаниеСтатьи.ПутьКДанным + "." + ПутьКДанным;
		КонецЕсли;
		ЗначениеСтатьи = АналитикиСтатейБюджетовУХКлиентСервер.ПолучитьЗначениеПоПутиКДанным(Форма, ПутьКДанным);
		ДанныеВидАналитики	= АналитикиСтатейБюджетовУХКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, ОписаниеСтатьи.Аналитики.ВидАналитикиПуть);
		ДанныеАналитика		= АналитикиСтатейБюджетовУХКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, ОписаниеСтатьи.Аналитики.АналитикаПуть);
	КонецЕсли;
	
	Если ОписаниеСтатьи.ТолькоЛимитируемыеАналитики Тогда
		ПараметрыЛимитирования = АналитикиСтатейБюджетовУХКлиентСервер.ПолучитьПараметрыЛимитированияСтатьиБюджета(Форма, ИмяЭлемента);
	КонецЕсли;
	
	АналитикиСтатейБюджетовУХКлиентСервер.ЗаполнитьСведенияОВидахАналитик(ЗначениеСтатьи, ДанныеВидАналитики, ОписаниеСтатьи, ПараметрыЛимитирования);
	
	Действия = Новый Структура("ПривестиЗначенияАналитик");
	АналитикиСтатейБюджетовУХКлиентСервер.ОбработатьЗначенияАналитик(Форма, ОписаниеСтатьи, ДанныеВидАналитики, ДанныеАналитика, Действия);
	
	АналитикиСтатейБюджетовУХКлиентСервер.НастроитьПоляВводаАналитик(Форма, ОписаниеСтатьи, ДанныеВидАналитики);
	АналитикиСтатейБюджетовУХКлиентСервер.НастроитьСвязиАналитик(Форма, ОписаниеСтатьи, ДанныеВидАналитики, ДанныеАналитика);
		
КонецПроцедуры

Процедура ПриИзмененииАналитикиСтатьиБюджета(Форма, ИмяЭлемента) Экспорт
	АналитикиСтатейБюджетовУХКлиентСервер.ИнициализироватьСвязиАналитикСтатьиБюджета(Форма, ИмяЭлемента, Истина);
КонецПроцедуры

Процедура ПриАктивизацииСтрокиТаблицыФормы(Форма, ИмяЭлемента) Экспорт
	НастроитьПоляВводаТаблицыФормы(Форма, ИмяЭлемента);
КонецПроцедуры

Процедура ПередНачаломИзмененияСтрокиТаблицыФормы(Форма, ИмяЭлемента) Экспорт
	НастроитьПоляВводаТаблицыФормы(Форма, ИмяЭлемента);
КонецПроцедуры

#КонецОбласти 

Процедура НавигационнаяКомандаВложеннойФормы(Форма, Команда) Экспорт
	
	Если Форма.ВладелецФормы = Неопределено Тогда
		ОсновнаяФорма = Форма;
	Иначе
		ОсновнаяФорма = Форма.ВладелецФормы;
	КонецЕсли;
	
	ВложенныеФормы = ОсновнаяФорма.ВложенныеФормы;
	ПараметрыФормы = ВложенныеФормы.НайтиПоЗначению(Команда.Имя);
	Если ПараметрыФормы <> Неопределено Тогда
		АктивнаяФорма = ВложенныеФормы.НайтиПоЗначению(Команда.Имя).Представление;
		
		ОсновноеОкно = Форма.Окно;
		Для Каждого ФормаСодержимого Из ОсновноеОкно.Содержимое Цикл
			Если ФормаСодержимого.ИмяФормы = АктивнаяФорма Тогда
				ФормаСодержимого.Активизировать();
				Оповестить("НавигационнаяКомандаВложеннойФормы", Команда, ФормаСодержимого);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Оповестить("НавигационнаяКомандаВложеннойФормы", Команда, ОсновнаяФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НастроитьПоляВводаТаблицыФормы(Форма, ИмяЭлемента)
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ОписаниеФормы") Тогда
		Возврат; // нет описания формы
	КонецЕсли;
	
	ОписаниеФормы = Форма.ОписаниеФормы;
	Если ОписаниеФормы = Неопределено ИЛИ ТипЗнч(ОписаниеФормы) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОписаниеФормы.Свойство("СтатьиБюджетов") ИЛИ ТипЗнч(ОписаниеФормы.СтатьиБюджетов) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыНаТаблицеФормы = ОписаниеФормы.ТаблицыФормы[ИмяЭлемента];
	Если РеквизитыНаТаблицеФормы = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОписаниеСтатьи Из РеквизитыНаТаблицеФормы Цикл
		
		Если НЕ ОписаниеСтатьи.ЭтоТаблица Тогда
			Продолжить;
		КонецЕсли;
		
		АналитикиСтатейБюджетовУХКлиентСервер.НастроитьПоляВводаАналитик(Форма, ОписаниеСтатьи, Форма.Элементы[ИмяЭлемента].ТекущиеДанные);
		АналитикиСтатейБюджетовУХКлиентСервер.НастроитьСвязиАналитик(Форма, ОписаниеСтатьи, Форма.Элементы[ИмяЭлемента].ТекущиеДанные, Форма.Элементы[ИмяЭлемента].ТекущиеДанные);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

