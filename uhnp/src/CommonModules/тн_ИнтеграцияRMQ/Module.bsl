		// НАЧАЛО Луконин Е.А. 01.09.2025 Выполнение задач №000054975
		//СообщениеОбъект.Записать(); 
		УдалятьСообщениеRMQПослеПодтвержденияОДоставке = РегистрыСведений.ТН_Интеграция_НастройкиКлючаМаршрутизацииRMQ.ПолучитьЗначениеРесурса(СообщениеСсылка.КлючМаршрутизации, "УдалятьСообщениеRMQПослеПодтвержденияОДоставке", Ложь);
		Если УдалятьСообщениеRMQПослеПодтвержденияОДоставке Тогда
			СообщениеОбъект.Удалить();
		Иначе
			СообщениеОбъект.Доставлено = Истина;
			СообщениеОбъект.Записать();
		КонецЕсли;
		// КОНЕЦ Луконин Е.А. 01.09.2025 Выполнение задач №000054975
	Исключение
