// См. БизнесПроцессыИЗадачиПереопределяемый.ПриОпределенииБизнесПроцессов.
Процедура ПриОпределенииБизнесПроцессов(ПодключенныеБизнесПроцессы) Экспорт  
	ИмяПроцесса = "ЭкспертизаЗаявкиНаЗакупку"; 
	Процесс = Метаданные.БизнесПроцессы.Найти(ИмяПроцесса); 
	Если Процесс <> Неопределено Тогда
		ПодключенныеБизнесПроцессы.Вставить(Процесс.ПолноеИмя(), "");
	КонецЕсли;        
	ИмяПроцесса = "КорректировкаЗаявкиНаЗакупку"; 
	Процесс = Метаданные.БизнесПроцессы.Найти(ИмяПроцесса); 
	Если Процесс <> Неопределено Тогда
		ПодключенныеБизнесПроцессы.Вставить(Процесс.ПолноеИмя(), "");
	КонецЕсли;
КонецПроцедуры

