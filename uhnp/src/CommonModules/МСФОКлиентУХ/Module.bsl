#Область ДокументыМСФО

Процедура ВыписатьСчетФактуру(Форма, Команда) Экспорт
	
	РеквизитыСФ = СоздатьСчетФактуруВыданный(Форма);
	
	Если РеквизитыСФ <> Неопределено Тогда 
		МСФОКлиентСерверУХ.ЗаполнитьПоСчетФактуре(Форма, РеквизитыСФ);
	КонецЕсли;
		
КонецПроцедуры

Процедура ОткрытьСчетФактуруМСФО(Форма, СтандартнаяОбработка = Ложь) Экспорт

	СтандартнаяОбработка = Ложь;

	Если НЕ ЗначениеЗаполнено(Форма.Параметры.Ключ) ИЛИ Форма.Модифицированность Тогда
		ОбъектЗаписан = Форма.Записать();
		
		Если НЕ ОбъектЗаписан Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СчетФактура = Форма.КэшируемыеЗначения.СчетФактура;
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		Параметры = Новый Структура("Ключ", СчетФактура);
	Иначе
		Если Форма.Объект.ПометкаУдаления Тогда
			
			ТекстОшибки = НСтр("ru = 'Счет-фактуру нельзя вводить на основании документа, помеченного на удаление.'");
			ПоказатьПредупреждение(, ТекстОшибки);
			
			Возврат;
			
		КонецЕсли;

		Параметры = Новый Структура("Основание", Форма.Параметры.Ключ);
	КонецЕсли;
	
	ОткрытьФорму("Документ.СчетФактураМСФО.ФормаОбъекта", Параметры, Форма);

КонецПроцедуры

#КонецОбласти

