	Если ПолучитьПодсистемуКазначейство() Тогда 
		ОбщийМодульДенежныеСредстваВстраиваниеУХКлиентСервер = ПолучитьМодульДенежныеСредстваВстраиваниеУХКлиентСервер();
		Возврат ОбщийМодульДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаКонтрагентов();
	Иначе
		Возврат Тип("СправочникСсылка.БанковскиеСчетаКонтрагентов");
	КонецЕсли;

КонецФункции

Функция ПодставитьИмяТаблицыБанковскогоСчетаОрганизацийВТекстЗапроса(ТекстЗапроса) Экспорт
	Если ПолучитьПодсистемуКазначейство() Тогда 
		ОбщийМодульДенежныеСредстваВстраиваниеУХКлиентСервер = ПолучитьМодульДенежныеСредстваВстраиваниеУХКлиентСервер();
		Возврат ОбщийМодульДенежныеСредстваВстраиваниеУХКлиентСервер.ПодставитьИмяТаблицыБанковскогоСчетаОрганизацийВТекстЗапроса(ТекстЗапроса);
	Иначе
		Возврат ТекстЗапроса;
	КонецЕсли;

КонецФункции

#Область Подписки
	
Процедура ОбработкаПолученияДанныхВыбораОрганизацииОбработкаПолученияДанныхВыбора(Источник, ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	Если Параметры.Отбор.Свойство("ВалютаЛимитирования") 
		И Параметры.Отбор.Свойство("СпособОпределенияВалютыЛимитирования")
		И Параметры.Отбор.СпособОпределенияВалютыЛимитирования = ПредопределенноеЗначение("Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаЛимитированияЦФО") Тогда
		
		СтандартнаяОбработка = Ложь;
		ЦФО = ВстраиваниеОПКВызовСервера.ЦФОПоВалютеЛимитирования(Параметры.Отбор.ВалютаЛимитирования, Параметры.СтрокаПоиска, Параметры.СпособПоискаСтроки);
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(ЦФО);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
#КонецОбласти

