#Область ПрограммныйИнтерфейс

#Область Справочник_Организации

Процедура ОбработкаПолученияФормыОрганизации(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	Если ВидФормы = "ФормаСписка" Тогда
		Возврат;
	ИначеЕсли ВидФормы = "ФормаВыбора" Тогда
		
    	ТипОЕ = ОрганизацииВызовСервераУХ.ТипОЕ(Параметры);
		Если ТипОЕ.Количество() Тогда
			Параметры.Отбор.Вставить("ТипОЕ", ТипОЕ);	
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		Возврат;//ЕРПУХ
	ИначеЕсли Не УчетМСФОПовтИспУХ.ЕстьРСБУ() Тогда
		Возврат;//ВЕ
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Параметры.Свойство("Ключ") И ЗначениеЗаполнено(Параметры.Ключ)
		ИЛИ Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		
		ВыбраннаяФорма = "ФормаОрганизации";
		
	ИначеЕсли Не (Параметры.Свойство("ОтключитьФормуУХ") И Параметры.ОтключитьФормуУХ = Истина) Тогда 
		
		// Новая организация
		ВыбраннаяФорма = "ФормаВыбораТипаОрганизации";
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ФормыБМ

Процедура ПолеФормыПриИзменении(Форма, Элемент) Экспорт

	Если Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		ПолеФормыПриИзменении_ДоговорыКонтрагентов(Форма, Элемент);
	ИначеЕсли Форма.ИмяФормы = "Справочник.Организации.Форма.ФормаОрганизации" Тогда
		ПолеФормыПриИзменении_Организации(Форма, Элемент);
	ИначеЕсли Форма.ИмяФормы = "Справочник.ЦенныеБумаги.Форма.ФормаЭлемента" Тогда
		ПолеФормыПриИзменении_ЦенныеБумаги(Форма, Элемент);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолеФормыПриИзменении_ДоговорыКонтрагентов(Форма, Элемент)

	Элементы 	= Форма.Элементы;
	Ссылка 		= Форма.Объект.Ссылка;
	
	Если Элемент = Элементы.ПараметрыУчетаФИ Тогда
		УправлениеФормой_ДоговорыКонтрагентов(Форма);
	ИначеЕсли Элемент = Форма.Команды.ХеджируемыеДоговоры Тогда
		
		Если Ссылка.Пустая() Тогда
			Сообщение = НСтр("ru = 'Для ввода информации о хеджируемых договорах необходимо записать текущий договор'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
			Возврат; 
		КонецЕсли;
		
		ВидСвязи = ПредопределенноеЗначение("Справочник.ВидыСвязейОбъектов.ДоговорНаПокупкуВалюты");
		Отбор = Новый Структура("СвязанныйДоговор, ВидСвязи", Ссылка, ВидСвязи);
		#Если Клиент Тогда
		ОткрытьФорму("РегистрСведений.СвязанныеДоговоры.ФормаСписка", Новый Структура("Отбор", Отбор), Форма, Истина);
		#КонецЕсли
		
	ИначеЕсли Элемент = Форма.Команды.ОбъектыПоФИ Тогда
		
		Если Ссылка.Пустая() Тогда
			Сообщение = НСтр("ru = 'Для ввода информации о финансируемых объектах необходимо записать текущий договор'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
			Возврат; 
		КонецЕсли;
		
		Отбор = Новый Структура("ОбъектыПоФИ", Ссылка);
		#Если Клиент Тогда
		ОткрытьФорму("РегистрСведений.ОбъектыПоФИ.ФормаСписка", Новый Структура("Отбор", Отбор), Форма, Истина);
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолеФормыПриИзменении_Организации(Форма, Элемент)
	
	Если Элемент.Имя = "УПМСФО0" Тогда
		
		ОткрытьУстановкуУП(Форма, Неопределено);	
		
	ИначеЕсли СтрНачинаетсяС(Элемент.Имя, "УПМСФО") Тогда
		
		Если СтрЗаканчиваетсяНа(Элемент.Имя, "История") Тогда
		
			СтандартнаяОбработка = Ложь;
			
			Организация = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Форма.Объект.Ссылка);
			Организация.Добавить(ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
			Отбор = Новый Структура("Организация", Организация);
			
			#Если Клиент Тогда
				ОткрытьФорму("РегистрСведений.УчетныеПолитикиМСФО.ФормаСписка", Новый Структура("Отбор", Отбор));
			#КонецЕсли
				
		ИначеЕсли СтрЗаканчиваетсяНа(Элемент.Имя, "Установить") Тогда
			
			СтандартнаяОбработка = Ложь;
			
			НомерУП = СтрЗаменить(Элемент.Имя, "УПМСФО", "");
			НомерУП = СтрЗаменить(НомерУП, "Установить", "");
				
			ОткрытьУстановкуУП(Форма, Число(НомерУП));
						
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОткрытьУстановкуУП(Форма, НомерУП = Неопределено)
	
	Если ЗначениеЗаполнено(НомерУП) И ЗначениеЗаполнено(Форма.УчетныеПолитикиМСФО) Тогда
		ПараметрыУП = Форма.УчетныеПолитикиМСФО.Получить(НомерУП-1); 
	Иначе
		СценарийМСФО = ПредопределенноеЗначение("Справочник.Сценарии.Факт");
		#Если Клиент Тогда
			СценарийМСФО = ОбщегоНазначенияКлиент.ОбщийМодуль("УчетМСФОПовтИспУХ").ПолучитьСценарийМСФО();
		#КонецЕсли
		ПараметрыУП = Новый Структура("Сценарий, УчетнаяПолитика", СценарийМСФО);
	КонецЕсли;
	
	ЗначенияЗаполненияУП = Новый Структура("Сценарий, Период, Организация, УчетнаяПолитика",
		ПараметрыУП.Сценарий, ТекущаяДата(), Форма.Объект.Ссылка, ПараметрыУП.УчетнаяПолитика);
		
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполненияУП);
	#Если Клиент Тогда                                                                  
		ДопПараметры = Новый Структура("Форма", Форма);
		Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбновитьУПМСФО", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("РегистрСведений.УчетныеПолитикиМСФО.ФормаЗаписи", ПараметрыФормы, Форма, Истина, ,,Оповещение);
	#КонецЕсли

КонецПроцедуры

Процедура Подключаемый_ОбновитьУПМСФО(РезультатЗакрытия, ДополнительныеПараметры) Экспорт 

	Форма = ДополнительныеПараметры.Форма;
	
	Форма.УчетныеПолитикиМСФО = Неопределено;//надо перезаполнить УПМСФО
	УправлениеФормой(Форма);

КонецПроцедуры

Процедура ПолеФормыПриИзменении_ЦенныеБумаги(Форма, Элемент)

КонецПроцедуры

Процедура УправлениеФормой(Форма) Экспорт
	
	Если Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		УправлениеФормой_ДоговорыКонтрагентов(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.Организации.Форма.ФормаОрганизации" Тогда
		УправлениеФормой_Организации(Форма);
	КонецЕсли;
		
КонецПроцедуры	

Процедура УправлениеФормой_ДоговорыКонтрагентов(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Элементы.ПараметрыУчетаФИ.Видимость = 
		Не ЗначениеЗаполнено(Объект.Дата)
		Или Не ЗначениеЗаполнено(Объект.СрокДействия)
		Или (ОбщегоНазначенияКлиентСерверУХ.РазностьДатВДнях(Объект.СрокДействия, Объект.Дата) >= 365);
	
	ВидОФХ = Неопределено;
	РеквизитыВидаФИ = Новый Структура("ПроизводныйФИ,СпособУчета,СпрС",Ложь, Ложь, Ложь);
		
	Если Не Объект.ПараметрыУчетаФИ.Пустая() Тогда		
		
		ВидОФХ = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ПараметрыУчетаФИ, "ВидОбъектаФинансовогоХарактера");
		РеквизитыВидаФИ = ОбщегоНазначенияУХ.ПолучитьЗначенияРеквизитов(ВидОФХ, "ПроизводныйФИ,СпособУчета");
		РеквизитыВидаФИ.Вставить("СпрС", РеквизитыВидаФИ.СпособУчета = ПредопределенноеЗначение("Перечисление.СпособыУчетаФинансовыхИнструментов.ПоСправедливойСтоимости"));
				
	КонецЕсли;
	
	Элементы.УровеньИерархииСправедливойСтоимости.Видимость = РеквизитыВидаФИ.СпрС;
	Если Не РеквизитыВидаФИ.СпрС Тогда
		Объект.УровеньИерархииСправедливойСтоимости = ПредопределенноеЗначение("Перечисление.УровеньИерархииСправедливойСтоимости.ПустаяСсылка");
	КонецЕсли;
		
	Элементы.ХеджируемыеДоговоры.Видимость = РеквизитыВидаФИ.ПроизводныйФИ;
	Элементы.Котировка.Видимость = РеквизитыВидаФИ.ПроизводныйФИ;

КонецПроцедуры

Процедура УправлениеФормой_Организации(Форма)
	
	Элементы = Форма.Элементы;
	
	Если Элементы.Найти("УПМСФО1") = Неопределено
		ИЛИ ЗначениеЗаполнено(Форма.УчетныеПолитикиМСФО) Тогда
		Возврат;		
	КонецЕсли;
	
	УПМСФО = МСФОВызовСервераУХ.ПараметрыУПМСФО(Форма.Объект.Ссылка);
	Форма.УчетныеПолитикиМСФО = Новый ФиксированныйМассив(УПМСФО);
	НетУП = Истина;
	
	Для НомерУП = 1 По 3 Цикл
		
		Имя = "УПМСФО" + НомерУП;
			
		Форма[Имя] = Неопределено;
		Если (УПМСФО.Количество() >= НомерУП) И ЗначениеЗаполнено(УПМСФО[НомерУП-1].УчетнаяПолитика) Тогда
			Форма[Имя] = УПМСФО[НомерУП-1].УчетнаяПолитика;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "Группа" + Имя, "Видимость", ЗначениеЗаполнено(Форма[Имя]));
				
		Если Не ЗначениеЗаполнено(Форма[Имя]) Тогда
			Продолжить;
		КонецЕсли;		
		
		ТекущаяУП = УПМСФО[НомерУП-1];
		НетУП = Ложь;
		
		Заголовок = НСтр("ru = 'Учетная политика <%1> действует с %2 (сценарий <%3>)'");
		Заголовок = СтрШаблон(Заголовок, ТекущаяУП.УчетнаяПолитика, Формат(ТекущаяУП.ПрименяетсяС, "ДЛФ=D"), ТекущаяУП.Сценарий);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "Группа" + Имя, "Заголовок", Заголовок);
		
		ТекстУП = Новый Массив;
		ДобавитьФорматСсылки(ТекстУП, НСтр("ru = 'План счетов учета: '"), 			ТекущаяУП.ПланСчетовУчета);
		ДобавитьФорматСсылки(ТекстУП, НСтр("ru = 'Валюта учета: '"), 				ТекущаяУП.ВалютаУчета);
		ДобавитьФорматСсылки(ТекстУП, НСтр("ru = 'Дополнительная валюта учета: '"),	ТекущаяУП.ВалютаУчетаДоп);
		ДобавитьФорматСсылки(ТекстУП, НСтр("ru = 'Шаблон трансляции: '"), 			ТекущаяУП.ШаблонТрансляции);
		ДобавитьФорматСсылки(ТекстУП, НСтр("ru = 'Модель учета: '"), 				ТекущаяУП.МодельУчетаМСФО, Ложь);
		ДобавитьФорматСсылки(ТекстУП, НСтр("ru = 'Способ трансляции: '"),			ТекущаяУП.СпособТрансляции, Ложь);
	    Форма[Имя + "_Описание"] = Новый ФорматированнаяСтрока(ТекстУП);
		
		Высота = СтрЧислоСтрок(Форма[Имя + "_Описание"]) + 2;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Имя + "_Описание", "Высота", Высота);

	КонецЦикла;
    		
	Элементы.ГруппаНетУП.Видимость = НетУП;

КонецПроцедуры

Функция ДобавитьФорматСсылки(УПМСФО, ЗаголовокСсылки = Неопределено, ЗначениеСсылки = Неопределено, 
							ДобавитьСсылку = Истина, ПереносСтроки = Истина)

	Если ЗаголовокСсылки <> Неопределено Тогда
		УПМСФО.Добавить(?(ПереносСтроки И УПМСФО.Количество(), Символы.ПС, "") + ЗаголовокСсылки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеСсылки) Тогда
		СсылкаФ = ?(ДобавитьСсылку, ПолучитьНавигационнуюСсылку(ЗначениеСсылки), Неопределено);
		УПМСФО.Добавить(Новый ФорматированнаяСтрока(Строка(ЗначениеСсылки), ,  , , СсылкаФ));
	ИначеЕсли ЗаголовокСсылки <> Неопределено Тогда
		УПМСФО.Добавить(НСтр("ru = '<Не установлено>'"));
	КонецЕсли;
	
	Возврат УПМСФО;

КонецФункции

#КонецОбласти

#Область Документ_ПлатежноеПоручение

Процедура ПереопределитьПолучаемуюФормуДокументаДДСУХ(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	//** ВстраиваниеУХВызовСервера.ПереопределитьПолучаемуюФормуДокументаДДС(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область Документ_УведомлениеОСпецрежимахНалогообложения

Процедура ПолучениеФормыУведомленияОКонтролируемыхИООбработкаПолученияФормы(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		Ключ = Неопределено;
		ВидУведомления = Неопределено;
		Если Параметры.Свойство("Ключ", Ключ) ИЛИ Параметры.Свойство("ВидУведомления", ВидУведомления) Тогда
			Если ТипЗнч(Ключ) = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения") Тогда
				ВидУведомления = Ключ.ВидУведомления;
			КонецЕсли;
			Если ВидУведомления = ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.ФормаУ_ИО") 
					ИЛИ ВидУведомления = ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.ФормаКИК") Тогда
				ВыбраннаяФорма = "ФормаДокументаУХ";
				СтандартнаяОбработка = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область Справочник_ДоговорыКонтрагентов

Процедура ДоговорыКонтрагентовОбработкаПолученияФормы(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	ВстраиваниеУХВызовСервера.ДоговорыКонтрагентовОбработкаПолученияФормы(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка);
КонецПроцедуры

Функция ПараметрыВыбораДоговора(ЭтоПокупка = Истина, Прочие = Истина) Экспорт
	
	Если ЭтоПокупка Тогда
		ХО = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика");
	Иначе
		ХО = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияПрочихАктивов");	
	КонецЕсли;

	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ПараметрВыбора("Отбор.ХозяйственнаяОперация", ХО));
	
КонецФункции

#КонецОбласти

#Область Справочник_ДоговорыКонтрагентов_ИменаРеквизитов_БМНМ

Функция ИмяРеквизитаКонтрагент(ТипФИ = Неопределено) Экспорт
	
	Если ТипФИ = Тип("СправочникСсылка.ЦенныеБумаги") Тогда
		Возврат "Эмитент";
	Иначе	
		Возврат "Контрагент";
	КонецЕсли;
	
КонецФункции

Функция ИмяРеквизитаВидДоговора(ВидДоговораУХ = Неопределено) Экспорт

