Функция ПрочитатьJSONСтроку(СтрокаJSON, ИмяПакета, ИмяТипаПакета)
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	ТипКонтейнерXDTO 		= ТН_ИнтеграцияПовтИсп.ПолучитьТипОбъектаXDTOПоИмени(ИмяПакета, ИмяТипаПакета);
	КонтейнерXDTO 			= ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON, ТипКонтейнерXDTO); 	
	
	СвойстваКонтейнераXDTO 	= КонтейнерXDTO.Свойства();
	Результат 				= Новый Структура;
	
	Для Каждого СвойствоКонтейнера Из СвойстваКонтейнераXDTO Цикл
		
		ИмяСвойстваXDTO = СвойствоКонтейнера.Имя;
		
		Если ТипЗнч(КонтейнерXDTO[ИмяСвойстваXDTO]) = Тип("ОбъектXDTO") Тогда  
			Результат.Вставить(ИмяСвойстваXDTO, СтруктураОбъектаИзОбъектаXDTO(КонтейнерXDTO[ИмяСвойстваXDTO]));
		Иначе	
			Результат.Вставить(ИмяСвойстваXDTO, КонтейнерXDTO[ИмяСвойстваXDTO]);
		КонецЕсли;
		
	КонецЦикла;
				   
	Возврат Результат; 
	
КонецФункции

Функция СтруктураОбъектаИзОбъектаXDTO(ОбъектXDTO)
	
	СтруктураОбъекта = Новый Структура;	
	СвойстваXDTO     = ОбъектXDTO.Свойства();
	
	Для Каждого СвойствоXDTO Из СвойстваXDTO Цикл
		
		ЭлементСвойства = ОбъектXDTO[СвойствоXDTO.Имя];
		
		Если ТипЗнч(ЭлементСвойства) = Тип("ОбъектXDTO") Тогда
			СтруктураОбъекта.Вставить(СвойствоXDTO.Имя, СтруктураОбъектаИзОбъектаXDTO(ЭлементСвойства));	
		ИначеЕсли ТипЗнч(ЭлементСвойства) = Тип("СписокXDTO") Тогда
			
			Список = Новый Массив;
			
			Для Каждого ЭлементСписка Из ЭлементСвойства Цикл
				Список.Добавить(СтруктураОбъектаИзОбъектаXDTO(ЭлементСписка));
			КонецЦикла;
			
			СтруктураОбъекта.Вставить(СвойствоXDTO.Имя, Список);
			
		Иначе			
			СтруктураОбъекта.Вставить(СвойствоXDTO.Имя, ЭлементСвойства);			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураОбъекта; 
	
КонецФункции 

Функция ПолучитьВидСообщенияПоЗаголовку(СвойстваСообщения, ИмяПеречисления, ПрефиксСообщения = "")
			
	tn_message_format = Неопределено;
		
	Если СвойстваСообщения.Свойство("Заголовки") Тогда
		
		tn_message_format = СвойстваСообщения.Заголовки.Получить("tn_message_format");
		
	КонецЕсли;	
	
	Если tn_message_format = Неопределено Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ВидСообщенияСтрока = СтрЗаменить(НРег(tn_message_format), ПрефиксСообщения, "");
	
	ВидСообщения = ПолучитьЗначениеПеречисления(ИмяПеречисления, ВидСообщенияСтрока);
	
	Возврат ВидСообщения;
	
КонецФункции

Функция ПолучитьЗначениеПеречисления(ИмяПеречисления, ЗначениеПоиска)
	
	ЗначениеПеречисления = Неопределено;
	Если Не Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления.Найти(ЗначениеПоиска) = Неопределено Тогда
		ЗначениеПеречисления = Перечисления[ИмяПеречисления][ЗначениеПоиска];	
	КонецЕсли;
	
	Возврат ЗначениеПеречисления;
	
КонецФункции

Функция ПоместитьЗначениеВСтрокуJSON(Данные, ИмяПакета, ИмяТипаПакета)
	
	Контейнер = ТН_Интеграция.СоздатьКонтейнерXDTO(ИмяПакета, ИмяТипаПакета);	
	
	ПоместитьСтруктуруВОбъектXDTO(Данные, Контейнер);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	
	ФабрикаXDTO.ЗаписатьJSON(ЗаписьJSON, Контейнер, НазначениеТипаXML.Неявное);		
	
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// Стандартно формируется JSON вида:
	//
	//{
	//"#value": {	- "лишняя" строка №2
	//...
	//}
	//}				- "лишняя" последняя строка
	//
	// Необходимо убрать строку №2 ('"#value": {') и последнюю строку (закрывающую скобку).
	
	МассивСтрок = СтрРазделить(СтрокаJSON, Символы.ПС);
	
	МассивСтрок.Удалить(1);							// убираем строку №2
	МассивСтрок.Удалить(МассивСтрок.ВГраница());	// убираем последнюю строку
	
	СтрокаJSON = СтрСоединить(МассивСтрок, Символы.ПС);
	
	Возврат СтрокаJSON;
	
КонецФункции

Функция ПоместитьСтруктуруВОбъектXDTO(Данные, ОбъектXDTO)
	
	Для Каждого КлючИзначение Из Данные Цикл 
		
		ИмяАтрибута       = КлючИзначение.Ключ;
		ЗначениеАтрибута  = КлючИзначение.Значение;
		
		Если ТипЗнч(ЗначениеАтрибута) = Тип("Структура") Тогда
			ОбъектАтрибута			= ФабрикаXDTO.Создать(ОбъектXDTO.Свойства().Получить(ИмяАтрибута).Тип);
			ОбъектXDTO[ИмяАтрибута] = ПоместитьСтруктуруВОбъектXDTO(ЗначениеАтрибута, ОбъектАтрибута);
		ИначеЕсли ТипЗнч(ЗначениеАтрибута) = Тип("Массив") Тогда
			ОбъектXDTO[ИмяАтрибута] = ПоместитьМассивВОбъектXDTO(ЗначениеАтрибута, ОбъектXDTO, ИмяАтрибута);
		//ИначеЕсли ТипЗнч(ЗначениеАтрибута) = Тип("ТаблицаЗначений") Тогда
		//	ТН_ИнтеграцияСервисЗапросНаПлатеж.ПоместитьТаблицуЗначенийВКонтейнерXDTO(ЗначениеАтрибута, ОбъектXDTO, ИмяАтрибута);
		Иначе 
			ЗаполнитьАтрибутОбъектаXDTO(ОбъектXDTO, ИмяАтрибута, ЗначениеАтрибута); 	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ПоместитьМассивВОбъектXDTO(Данные, ОбъектXDTO, ИмяСвойстваСпискаXDTO)
	
	ОбъектСписка	= ФабрикаXDTO.Создать(ОбъектXDTO.Свойства().Получить(ИмяСвойстваСпискаXDTO).Тип);
	СписокXDTO 		= ОбъектСписка[ОбъектСписка.Свойства()[0].Имя];
	ТипЭлемента 	= СписокXDTO.ВладеющееСвойство.Тип;
	
	Для Каждого ЭлементДанных Из Данные Цикл
		
		ЭлементСписка = ФабрикаXDTO.Создать(ТипЭлемента);
		
		Если ТипЗнч(ЭлементДанных) = Тип("Структура") Тогда
			ПоместитьСтруктуруВОбъектXDTO(ЭлементДанных, ЭлементСписка);
		КонецЕсли;
		
		СписокXDTO.Добавить(ЭлементСписка);
		
	КонецЦикла; 
	
	Возврат ОбъектСписка;
	
КонецФункции

Процедура ЗаполнитьАтрибутОбъектаXDTO(СвойствоXDTO, ИмяАтрибута, ЗначениеАтрибута)
	
	ТипBoolean  = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "boolean");	
	ТипDateTime = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "dateTime");
	ТипDate		= ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "date");
	
	ТекущееСвойствоXDTO = СвойствоXDTO.Свойства().Получить(ИмяАтрибута);
		
	Если Не (ТекущееСвойствоXDTO.ЗначениеПоУмолчанию = Неопределено) Тогда 
		ЗначениеПоУмолчанию = ТекущееСвойствоXDTO.ЗначениеПоУмолчанию.Значение;	
	Иначе
		
		Если ТекущееСвойствоXDTO.Тип = ТипBoolean Тогда 
			ЗначениеПоУмолчанию = Ложь;	
		ИначеЕсли ТекущееСвойствоXDTO.Тип = ТипDateTime Тогда
			ЗначениеПоУмолчанию = Дата(1,1,1,0,0,0);
		ИначеЕсли ТекущееСвойствоXDTO.Тип = ТипDate Тогда
			ЗначениеПоУмолчанию = Дата(1,1,1);
		Иначе 	
			ЗначениеПоУмолчанию = "";
		КонецЕсли;					
		
	КонецЕсли;
	
	Если (ЗначениеАтрибута = NULL) ИЛИ (ЗначениеАтрибута = Неопределено) Тогда 
		СвойствоXDTO[ИмяАтрибута] = ЗначениеПоУмолчанию;
	Иначе
		СвойствоXDTO[ИмяАтрибута] = ЗначениеАтрибута;	
	КонецЕсли;
																						
КонецПроцедуры

