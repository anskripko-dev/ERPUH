
#Область ОтправкаСообщений

Функция ОтправитьПакет(Идентификатор, СообщениеСтрока, УИД, Заголовок, ВидСообщения, ПрофильПодключения, КлючМаршрутизации)
	
	СтруктураВозврата = Новый Структура("Результат, ОписаниеОшибки", Истина, "");
		
	Попытка
					
		СерверОчередейRabbitMQ	= ПрофильПодключения.СерверОчередейRMQ;
		ТочкаОбменаRabbitMQ    	= Справочники.ТочкиОбменаRMQ.ТекущаяБаза.Наименование;
		
		СвойстваСообщения		= Новый Структура;
		СвойстваСообщения.Вставить("Headers", Новый Структура("tn_message_format", Заголовок));
		СвойстваСообщения.Вставить("УИД", УИД); 
		СвойстваСообщения.Вставить("Type", Заголовок);
		
		// НАЧАЛО Тулинов Владимир 26.12.2025 Выполнение задач №000056267
		СвойстваСообщения.Вставить("MessageId", Строка(УИД));
		// КОНЕЦ Тулинов Владимир 26.12.2025 Выполнение задач №000056267
		
		НачатьТранзакцию();

		Попытка
			
			Справочники.ИсходящиеСообщения.Отправить(СообщениеСтрока, ТочкаОбменаRabbitMQ, КлючМаршрутизации, СерверОчередейRabbitMQ, СвойстваСообщения, ВидСообщения);
			
			ЗафиксироватьТранзакцию();
						
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = "Не удалось отправить сообщение по причине: " + ОписаниеОшибки();
			ЛогСообщенияОшибки(ВидСообщения, "Ошибка", Идентификатор, ТекстОшибки);
				
		КонецПопытки;
							
	Исключение
		
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.ОписаниеОшибки = "Произошла исключительная ситуация при отправке сообщения по причине: " + ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти

#Область ФормированиеДанныхВыгрузки

Функция ОтправитьСообщение(ВидСообщения, ПараметрыСообщения = Неопределено) Экспорт 

	Результат = Новый Структура("Успех, ОписаниеОшибки", Истина, "");

	ПрофильRabbitMQ = Справочники.ТН_ПрофилиПодключений.RabbitMQ;
		
	Если ПрофильRabbitMQ.Использование Тогда
	
		ДанныеСообщения = Неопределено;	
		КлючСообщения 	= Неопределено;
		ИмяМетода 		= Строка(ВидСообщения);
		
		Попытка
			
			МетодИВерсия = ТН_Интеграция.РазложитьВидСообщенияНаМетодИВерсию(ИмяМетода);
			ИмяВыполняемогоМетода = МетодИВерсия.ИмяМетода;
					
			Выполнить("ДанныеСообщения = Получить_" + ИмяВыполняемогоМетода + "(ПараметрыСообщения)");
			
			Если ДанныеСообщения = Неопределено Тогда
				
				Возврат Результат;
				
			КонецЕсли;
			
			УИД = Новый УникальныйИдентификатор(ДанныеСообщения.headers.messageGUID);	
			СтрокаJSON 				= ПоместитьЗначениеВСтрокуJSON(ДанныеСообщения, "tn_ExchangeBetweenCentralizedIS", ИмяМетода);   
			КлючМаршрутизации 		= ТН_ИнтеграцияПовтИсп.XDTO_XMLСтрока(ПараметрыСообщения.КлючМаршрутизации);
			КлючСообщения			= ЛогИсходящегоСообщения(СтрокаJSON, ВидСообщения);
			Заголовок = "1cTo1c_" + ИмяМетода;
			РезультатОтправки 		= ОтправитьПакет(КлючСообщения, СтрокаJSON, УИД, Заголовок, ВидСообщения, ПрофильRabbitMQ, КлючМаршрутизации);
			
			Если НЕ РезультатОтправки.Результат Тогда
				
				ВызватьИсключение РезультатОтправки.ОписаниеОшибки;	
				
			КонецЕсли;
			
			// НАЧАЛО Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
			Если ВидСообщения = Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.requestPersons_v1 Тогда
				ДобавитьЗаписьЗапросыRabbitMQПриОтправкеСообщения(УИД, ВидСообщения, СтрокаJSON);
			КонецЕсли;
			// КОНЕЦ Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
			
		Исключение
			
			Результат.Успех				= Ложь;
			Результат.ОписаниеОшибки 	= ОписаниеОшибки();
			
			ЛогСообщенияОшибки(ВидСообщения, "Ошибка", КлючСообщения, Результат.ОписаниеОшибки);
						
		КонецПопытки;                                                                   																	  
		
	Иначе
		
		Результат.Успех				= Ложь;
		Результат.ОписаниеОшибки 	= "Невозможно отправить сообщение. Выключено использование профиля: ""ТН_ПрофилиПодключений.RabbitMQ""";	
		
	КонецЕсли;
	
	// НАЧАЛО Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
	Если ВидСообщения = Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.requestPersons_v1 Тогда
		Результат.Вставить("ИдентификаторЗапроса", УИД);
	КонецЕсли;
	// КОНЕЦ Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
	
	Возврат Результат;
	
КонецФункции

// Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
Функция Получить_requestPersons(ПараметрыСообщения)
	
	//headers
	
	headers = Headers();
	
	//requestPersons
	
	СтруктураRequestPersons = Новый Структура;
	СтруктураRequestPersons.Вставить("uec", ПараметрыСообщения.uec); 
	СтруктураRequestPersons.Вставить("email", ПараметрыСообщения.Email);
	
	ПакетRequestPersons = Новый Структура;         
	ПакетRequestPersons.Вставить("headers"			, headers);                 
	ПакетRequestPersons.Вставить("requestPersons"	, СтруктураRequestPersons);
	
	Возврат ПакетRequestPersons;
	
КонецФункции

#КонецОбласти

#Область ЧтениеСообщений

Процедура ПолучениеСообщений(ТекстСообщенияJSON, СвойстваСообщения) Экспорт 
	
	КлючСообщения = Неопределено;
	ВидСообщения = ПолучитьВидСообщенияПоЗаголовку(СвойстваСообщения, "ТН_ВидыСообщений_ОбменМеждуЦИС", "1cto1c_");
	
	Если ВидСообщения = Неопределено Тогда		
		
		ЛогСообщенияОшибки(, "Ошибка", , "Не удалось определить вид интеграции ""ТН_ВидыСообщений_ОбменМеждуЦИС""."); 
		Возврат;	
		
	КонецЕсли;
	
	ИмяМетода = Строка(ВидСообщения);
	ИмяМетодаСВерсией = ИмяМетода;	
	ИмяМетода = ТН_Интеграция.ПолучитьИмяМетодаБезВерсии(ИмяМетода);
	
	Результат = Неопределено;
	
	КлючСообщения = ЛогВходящегоСообщения(ТекстСообщенияJSON, ВидСообщения, "ПолученПакет");
	
	Попытка
		
		ДанныеСообщения = ПрочитатьJSONСтроку(ТекстСообщенияJSON, "tn_ExchangeBetweenCentralizedIS", ИмяМетодаСВерсией);		
		
		Выполнить("Результат = Создать_" + ИмяМетода + "(ДанныеСообщения)");
		
		Если Не Результат.Успех Тогда
			
			ЛогСообщенияОшибки(ВидСообщения, "Ошибка", КлючСообщения, Результат.ОписаниеОшибки); 
				
		КонецЕсли;  	
		
		// НАЧАЛО Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
		Если ВидСообщения = Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.responsePersons_v1 Тогда
			ОбновитьЗаписьЗапросыRabbitMQПриПолученииСообщения(ВидСообщения, ТекстСообщенияJSON, ДанныеСообщения, Результат);
		КонецЕсли;
		// КОНЕЦ Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
		
	Исключение
		
		ЛогСообщенияОшибки(ВидСообщения, "Ошибка", КлючСообщения, ОписаниеОшибки()); 
		
	КонецПопытки;
	
КонецПроцедуры 

// Обработка запроса из ЦБ с дальнейшим созданием ответного сообщения
//
Функция Создать_requestInfobase(ДанныеСообщения)
	
	ВидДействия = ДанныеСообщения.requestTypeOnConnect;
	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("ВидДействия", ВидДействия);		
	ПараметрыСообщения.Вставить("КлючМаршрутизации", Справочники.тн_ПроизводственныеПодразделения.УПП_ЦБ);
	
	// По ролевой моделе будем отправлять набор сообщений из-за большого количества записей
	Если ВидДействия = "ПолучитьРолиИПраваИнформационнойБазы" Тогда
		Результат = ОтправкаНабораСообщений(ПараметрыСообщения);
	Иначе	
		Результат = ОтправитьСообщение(Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.responseInfobase_v1, ПараметрыСообщения);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // Создать_requestInfobase()

// Отправляется набор сообщений, разделенных для уменьшения размера
//
Функция ОтправкаНабораСообщений(ПараметрыСообщения)
	
	СписокМетаданных = Новый СписокЗначений;
	СписокМетаданных.Добавить("Справочники");
	СписокМетаданных.Добавить("Документы");
	СписокМетаданных.Добавить("РегистрыСведений");
	СписокМетаданных.Добавить("Прочее");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ТаблицаПравРолей.ТипОбъектаМетаДанных КАК Строка(100)) КАК ТипОбъектаМетаДанных,
	               |	ВЫРАЗИТЬ(ТаблицаПравРолей.Право КАК Строка(100)) КАК Право,
	               |	ВЫРАЗИТЬ(ТаблицаПравРолей.ОбъектМетаДанных КАК Строка(100)) КАК ОбъектМетаДанных,
	               |	ВЫРАЗИТЬ(ТаблицаПравРолей.ИмяОбъектаМетаданных КАК Строка(100)) КАК ИмяОбъектаМетаданных,
	               |	ВЫРАЗИТЬ(ТаблицаПравРолей.Роль КАК Строка(100)) КАК Роль,
	               |	ВЫРАЗИТЬ(ТаблицаПравРолей.Роль_Синоним КАК Строка(100)) КАК Роль_Синоним,
	               |	ТаблицаПравРолей.Использование КАК Использование
	               |ПОМЕСТИТЬ ТаблицаПравРолей
	               |ИЗ
	               |	&ТаблицаПравРолей КАК ТаблицаПравРолей
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаПравРолей.ТипОбъектаМетаДанных КАК ТипОбъектаМетаДанных,
	               |	ТаблицаПравРолей.Право КАК Право,
	               |	ТаблицаПравРолей.ОбъектМетаДанных КАК ОбъектМетаДанных,
	               |	ТаблицаПравРолей.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
	               |	ТаблицаПравРолей.Роль КАК Роль,
	               |	ТаблицаПравРолей.Роль_Синоним КАК Роль_Синоним,
	               |	ТаблицаПравРолей.Использование КАК Использование
	               |ИЗ
	               |	ТаблицаПравРолей КАК ТаблицаПравРолей
	               |ИТОГИ ПО
	               |	Право";

	ПараметрыОтчета = Новый Соответствие; 
	
	// Получим список прав и ролей из отчета в разере метаданных, так как записей много и разом сервер не съедает
	Для Каждого ПараметрОтбора Из СписокМетаданных Цикл
		
		ПараметрыОтчета.Вставить("Параметр", ПараметрОтбора.Значение); 
		ТаблицаПравРолей = Отчеты.тн_ОтчетРолеваяМодельИБ.ПолучитьСписокПравИРолей( , , , ПараметрыОтчета);
		
		Запрос.УстановитьПараметр("ТаблицаПравРолей", ТаблицаПравРолей);
		ВыборкаПрава = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Право");
		МассивЗаписей = Новый Массив;
		ТекущееПраво = Неопределено;
		ТекущийТип = Неопределено;
		
		Пока ВыборкаПрава.Следующий() Цикл
			
			Если МассивЗаписей.Количество() > 0 Тогда
				
				ПараметрыСообщения.Вставить("typeMetadata", СокрЛП(ТекущийТип));
				ПараметрыСообщения.Вставить("access", СокрЛП(ТекущееПраво));
				ПараметрыСообщения.Вставить("objectsAndRoles", МассивЗаписей);
				Результат = ОтправитьСообщение(Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.responseInfobase_v1, ПараметрыСообщения);
				
				МассивЗаписей = Новый Массив;
				
			КонецЕсли;
			
			ТекущееПраво = ВыборкаПрава.Право; 
			ТекущийТип = ВыборкаПрава.ТипОбъектаМетаДанных; 
			Выборка = ВыборкаПрава.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				СтруктураЗаписи = Новый Структура;
				СтруктураЗаписи.Вставить("objectMetadata", СокрЛП(Выборка.ОбъектМетаДанных));
				СтруктураЗаписи.Вставить("nameMetadata", СокрЛП(Выборка.ИмяОбъектаМетаданных));
				СтруктураЗаписи.Вставить("role", СокрЛП(Выборка.Роль));
				СтруктураЗаписи.Вставить("roleSyn", СокрЛП(Выборка.Роль_Синоним));
				СтруктураЗаписи.Вставить("enable", Выборка.Использование);
				МассивЗаписей.Добавить(СтруктураЗаписи);
				
			КонецЦикла;
		КонецЦикла;

		// Отправим остаток записей
		Если МассивЗаписей.Количество() > 0 Тогда
			
			ПараметрыСообщения.Вставить("typeMetadata", СокрЛП(ТекущийТип));
			ПараметрыСообщения.Вставить("access", СокрЛП(ТекущееПраво));
			ПараметрыСообщения.Вставить("objectsAndRoles", МассивЗаписей);
			Результат = ОтправитьСообщение(Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.responseInfobase_v1, ПараметрыСообщения);
			
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции // ОтправкаНабораСообщений()

//	Создание ответного сообщения в ЦБ
//
Функция Получить_responseInfobase(ДанныеСообщения)
	
	// Заполним ответный пакет
	ВидДействия	= ДанныеСообщения.ВидДействия;

	// headers
	// НАЧАЛО Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
	//headers = Новый Структура;
	//headers.Вставить("messageGUID",	Строка(Новый УникальныйИдентификатор));	// Уникальный uid отправляемого пакета
	//headers.Вставить("sendDateUTC",	ДатаВUTC(ТекущаяДатаСеанса()));			// Дата отправки пакета
	//headers.Вставить("systemSender", КлючОтправителя());			        // Уникальный uid системы отправителя
	headers = Headers();
	// КОНЕЦ Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888

	ПакетResponseInfobase = Новый Структура;         
	ПакетResponseInfobase.Вставить("headers", headers);                 
	ПакетResponseInfobase.Вставить("requestTypeOnConnect", ВидДействия);                 
	
	Если ВидДействия = "ПолучитьПользователейИнформационныхБаз" Тогда
		
		// Получим список пользователей из отчета
		ТаблицаПользователей = Отчеты.тн_СписокПользователейИБ.СформироватьСписокПользователей();
		
		// Заполним массив структур
		МассивЗаписей = Новый Массив;
		
		Для Каждого СтрокаТЗ Из ТаблицаПользователей Цикл
			
			СтруктураЗаписи = Новый Структура;
			СтруктураЗаписи.Вставить("name", СтрокаТЗ.Имя);
			СтруктураЗаписи.Вставить("fullName", СтрокаТЗ.ПолноеИмя);
			СтруктураЗаписи.Вставить("nameAD", СтрокаТЗ.ПользовательОС);
			СтруктураЗаписи.Вставить("isAuthOpenID", СтрокаТЗ.АутентификацияOpenID);
			СтруктураЗаписи.Вставить("isAuthAD", СтрокаТЗ.АутентификацияОС);
			СтруктураЗаписи.Вставить("isAuth1C", СтрокаТЗ.АутентификацияСтандартная);
			СтруктураЗаписи.Вставить("isChangePassLock", СтрокаТЗ.ЗапрещеноИзменятьПароль);
			СтруктураЗаписи.Вставить("isPassword", СтрокаТЗ.ПарольУстановлен);
			СтруктураЗаписи.Вставить("showInList", СтрокаТЗ.ПоказыватьВСпискеВыбора);
			СтруктураЗаписи.Вставить("role", СтрокаТЗ.Роль);
			МассивЗаписей.Добавить(СтруктураЗаписи);
			
		КонецЦикла;
		
		ПакетResponseInfobase.Вставить("userAccounts", МассивЗаписей);
		
	ИначеЕсли ВидДействия = "ПолучитьВерсииИнформационныхБаз" Тогда
		
		// Получим сведения из существующей функции
		СведенияИБ = WebPort1C.ПолучитьИнформациюОБазе();
		
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("confName", СведенияИБ.НазваниеКонфигурации);
		СтруктураЗаписи.Вставить("confVersion", СведенияИБ.ВерсияКонфигурации);
		СтруктураЗаписи.Вставить("osVersion", СведенияИБ.ВерсияОС);
		СтруктураЗаписи.Вставить("appVersion", СведенияИБ.ВерсияПлатформы);
		СтруктураЗаписи.Вставить("appBitDepth", СведенияИБ.РазрядностьПлатформы);
		
		ПакетResponseInfobase.Вставить("infoBaseVersion", СтруктураЗаписи);

	ИначеЕсли ВидДействия = "ПолучитьРолиИПраваИнформационнойБазы" Тогда
		
		// Все данные по этому виду действия подготовлены ранее 
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("typeMetadata", ДанныеСообщения.typeMetadata);
		СтруктураЗаписи.Вставить("access", ДанныеСообщения.access);
		СтруктураЗаписи.Вставить("objectsAndRoles", ДанныеСообщения.objectsAndRoles);
		
		ПакетResponseInfobase.Вставить("objectAccesses", СтруктураЗаписи);

	ИначеЕсли ВидДействия = "ПолучитьСтатистикуПоЗаменам" Тогда
		
		// Получим количество контрагентов к замене
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаменяемыеОбъекты.Объект) КАК КоличествоНезамененныхОбъектов
		               |ИЗ
		               |	РегистрСведений.тн_ЗаменяемыеОбъекты КАК ЗаменяемыеОбъекты
		               |ГДЕ
		               |	ЗаменяемыеОбъекты.Объект ССЫЛКА Справочник.Контрагенты
		               |	И НЕ ЗаменяемыеОбъекты.Объект = ЗаменяемыеОбъекты.ОбъектЦБ";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			ВыборкаДетальныеЗаписи.Следующий();
			КоличествоНезамененныхОбъектов = ВыборкаДетальныеЗаписи.КоличествоНезамененныхОбъектов;
			
		Иначе
			КоличествоНезамененныхОбъектов = 0;
		КонецЕсли;
		
		ПакетResponseInfobase.Вставить("counterpartyReplacements", КоличествоНезамененныхОбъектов);

	Иначе	
		ЛогСообщенияОшибки(Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.responseInfobase_v1, "Ошибка", headers.messageGUID, "Не определен вид действия: " + ВидДействия);
	КонецЕсли;

	Возврат ПакетResponseInfobase;
		
КонецФункции // Получить_responseInfobase()

