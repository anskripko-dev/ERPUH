Функция Headers()
	
	headers = Новый Структура;
	headers.Вставить("messageGUID", 	Строка(Новый УникальныйИдентификатор));	// Уникальный uid отправляемого пакета
	headers.Вставить("sendDateUTC",		ДатаВUTC(ТекущаяДатаСеанса()));			// Дата отправки пакета
	headers.Вставить("systemSender", 	КлючОтправителя());				        // Уникальный uid системы отправителя
	
	Возврат headers;
	
КонецФункции

// Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
Функция ПолучитьСсылкуОбъектаПоID(СтрокаGUID, ИмяОбъекта, ОбъектМенеджер, ВернутьПустуюСсылку = Истина)
	
	Если ПустаяСтрока(СтрокаGUID) Тогда
		Если ВернутьПустуюСсылку Тогда
			Возврат ОбъектМенеджер[ИмяОбъекта].ПустаяСсылка();
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	НовыйGUID = Новый УникальныйИдентификатор(СтрокаGUID);	
	СсылкаОбъект = ОбъектМенеджер[ИмяОбъекта].ПолучитьСсылку(НовыйGUID);
	
	Если ВернутьПустуюСсылку
		И (НЕ ЗначениеЗаполнено(СсылкаОбъект) 
			ИЛИ СтрНайти(НРег(Строка(СсылкаОбъект)), "<объект не найден>") > 0) Тогда
		СсылкаОбъект = ОбъектМенеджер[ИмяОбъекта].ПустаяСсылка();
	КонецЕсли;
	
	Возврат СсылкаОбъект;
	
КонецФункции

// Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
Процедура ДобавитьЗаписьЗапросыRabbitMQПриОтправкеСообщения(ИдентификаторСообщения, ВидСообщения, ТекстСообщенияJSON)
	
	ПараметрыЗаписи = Неопределено;
	
	Если ВидСообщения = Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.requestPersons_v1 Тогда
	
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("ИдентификаторЗапроса"	, ИдентификаторСообщения);
		ПараметрыЗаписи.Вставить("ВидСообщения"			, ВидСообщения);
		ПараметрыЗаписи.Вставить("ТекстСообщения"		, ТекстСообщенияJSON);
		
	КонецЕсли;
	
	Если ПараметрыЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.тн_ЗапросыRabbitMQ.ДобавитьЗаписьПриОтправкеСообщения(ПараметрыЗаписи);
	
КонецПроцедуры

// Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
Процедура ОбновитьЗаписьЗапросыRabbitMQПриПолученииСообщения(ВидСообщения, ТекстСообщенияJSON, ДанныеСообщения, Результат) 
	
	ПараметрыЗаписи = Неопределено;
	
	Если ВидСообщения = Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.responsePersons_v1 Тогда
	
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("ИдентификаторЗапроса"	, ДанныеСообщения.headers.messageGUID);
		ПараметрыЗаписи.Вставить("ВидСообщения"			, Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.requestPersons_v1);
		ПараметрыЗаписи.Вставить("XML_ПакетВходящий"	, ТекстСообщенияJSON);
		ПараметрыЗаписи.Вставить("ИдентификаторОбъекта"	, ДанныеСообщения.responsePersons.personGUID);
		
		ТекстОшибки = "";
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Результат.Свойство("ОписаниеОшибки", ТекстОшибки);
		КонецЕсли;
		ПараметрыЗаписи.Вставить("ТекстОшибки", ТекстОшибки);
	КонецЕсли;
	
	Если ПараметрыЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.тн_ЗапросыRabbitMQ.ОбновитьЗаписьПриПолученииСообщения(ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти