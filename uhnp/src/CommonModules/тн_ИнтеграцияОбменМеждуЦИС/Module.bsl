Функция Создать_responsePersons(ДанныеСообщения)
	
	Результат = Новый Структура("Успех, ОписаниеОшибки", Истина, "");
	
	СтруктураФизЛицо = ДанныеСообщения.responsePersons;    
	
	Если СтруктураФизЛицо.personGUID <> "00000000-0000-0000-0000-000000000000" Тогда
		
		// Поиск Элемента в текущей базе
		ФизЛицо = ПолучитьСсылкуОбъектаПоID(СтруктураФизЛицо.personGUID, "ФизическиеЛица", Справочники, Ложь); 
		
		Объект_ФизЛицо = ФизЛицо.ПолучитьОбъект();
		
		Если Объект_ФизЛицо = Неопределено Тогда
			
			НачатьТранзакцию();
			
			Попытка
				
				Объект_ФизЛицо = Справочники.ФизическиеЛица.СоздатьЭлемент(); 
				Объект_ФизЛицо.УстановитьСсылкуНового(ФизЛицо); 
				Объект_ФизЛицо.ОбменДанными.Загрузка = Истина;
				Объект_ФизЛицо.Родитель = Справочники.ФизическиеЛица.тн_ФедеральныеСотрудники;
				Объект_ФизЛицо.тн_ЕКС = СтруктураФизЛицо.uec;
				Объект_ФизЛицо.Код = СтруктураФизЛицо.code;
				Объект_ФизЛицо.ИНН = СтруктураФизЛицо.inn;
				Объект_ФизЛицо.Наименование = СокрЛП(СтруктураФизЛицо.lastName + " " + СтруктураФизЛицо.firstName + " " + СтруктураФизЛицо.patronymic);
				Объект_ФизЛицо.ФИО = Объект_ФизЛицо.Наименование;
				Объект_ФизЛицо.ПометкаУдаления = СтруктураФизЛицо.isDelete;
				Объект_ФизЛицо.тн_ЯвляетсяОбъектомЦБ = Истина;
				
				УправлениеКонтактнойИнформациейСлужебный.ДобавитьКонтактнуюИнформацию(Объект_ФизЛицо,
																						СтруктураФизЛицо.email,
																						Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица,
																						ТекущаяДатаСеанса(),
																						Истина);
																						
				Объект_ФизЛицо.Записать();
				
				НоваяЗаписьФИО = РегистрыСведений.ФИОФизическихЛиц.СоздатьМенеджерЗаписи();
				НоваяЗаписьФИО.Период 	= ТекущаяДатаСеанса();
				НоваяЗаписьФИО.ФизическоеЛицо 	= Объект_ФизЛицо.Ссылка;
				НоваяЗаписьФИО.Фамилия  = СокрЛП(СтруктураФизЛицо.lastName);
				НоваяЗаписьФИО.Имя   	= СокрЛП(СтруктураФизЛицо.firstName);
				НоваяЗаписьФИО.Отчество	= СокрЛП(СтруктураФизЛицо.patronymic);
				НоваяЗаписьФИО.Записать(Истина);
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = ОписаниеОшибки();
				
			КонецПопытки;
			
		Иначе
			Если СтруктураФизЛицо.isDelete Тогда			
				Объект_ФизЛицо.ПометкаУдаления = Истина;
			Иначе
				Объект_ФизЛицо.тн_ЯвляетсяОбъектомЦБ = Истина;
			КонецЕсли;
			Если Объект_ФизЛицо.Модифицированность() Тогда
				Попытка
					Объект_ФизЛицо.ОбменДанными.Загрузка = Истина;
					Объект_ФизЛицо.Записать();
				Исключение
					Результат.Успех = Ложь;
					Результат.ОписаниеОшибки = ОписаниеОшибки();
				КонецПопытки; 
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

