//Качикина 20.12.2024 Выполнение задач №000052118- добавила ПровестиПовторно 
//// Борисенко Игорь 07.08.2023 Выполнение задач №000046471
//// НАЧАЛО Борисенко Игорь 28.08.2023 Выполнение задач №000046673
////Процедура ОтменитьПроведение_ПометитьНаУдаление_СвязанныеПрочиеДоходыРасходы(Объект, Отказ, Результат)
//Процедура ОтменитьПроведение_ПометитьНаУдаление_СвязанныеПрочиеДоходыРасходы(Объект, Отказ, Результат) Экспорт
//// КОНЕЦ Борисенко Игорь 28.08.2023 Выполнение задач №000046673  
Процедура ОтменитьПроведение_ПометитьНаУдаление_СвязанныеПрочиеДоходыРасходы(Объект, Отказ, Результат, ПровестиПовторно=Ложь) Экспорт
	
	ТипДокумента = ТипЗнч(Объект);
	МогутБытьСвязанныеДокументы   = ТипДокумента = Тип("ДокументОбъект.РеализацияТоваровУслуг")
								Или ТипДокумента = Тип("ДокументОбъект.РеализацияУслугПрочихАктивов")
								Или ТипДокумента = Тип("ДокументОбъект.ПриобретениеТоваровУслуг")
								Или ТипДокумента = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов")
								Или ТипДокумента = Тип("ДокументОбъект.КорректировкаЗадолженности");
								
	Если  МогутБытьСвязанныеДокументы Тогда
									
		УИД = Объект.Ссылка.УникальныйИдентификатор();
		СвязаннаяСсылка = Документы.ПрочиеДоходыРасходы.ПолучитьСсылку(УИД);
		СвязанныйОбъект = СвязаннаяСсылка.ПолучитьОбъект();
		
		//НАЧАЛО Качикина 20.12.2024 Выполнение задач №000052118
		Если СвязанныйОбъект <> Неопределено И НЕ СвязанныйОбъект.Проведен
			И ПровестиПовторно Тогда
			
			Попытка
				// НАЧАЛО Чекордина Ирина 20.08.2025 Выполнение задач №000054856
				СвязанныйОбъект.ПометкаУдаления = Ложь;
				// КОНЕЦ Чекордина Ирина 20.08.2025 Выполнение задач №000054856
				СвязанныйОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение 
				Отказ = Истина;
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Не удалось привести в соответствие документ: """ + Строка(СвязанныйОбъект) + """: " + ОписаниеОшибки() + Символы.ПС;
			КонецПопытки;
					
		//НАЧАЛО Качикина 06.02.2025 Выполнение задач №000052559
		//Иначе  
		ИначеЕсли Не ПровестиПовторно Тогда 
		//КОНЕЦ Качикина 06.02.2025 Выполнение задач №000052559
		//КОНЕЦ Качикина 20.12.2024 Выполнение задач №000052118
		Если СвязанныйОбъект <> Неопределено 
			И СвязанныйОбъект.ПометкаУдаления = Ложь
			Тогда
				
			Попытка
				
				Если СвязанныйОбъект.Проведен Тогда
					СвязанныйОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				
				Если СвязанныйОбъект.ПометкаУдаления <> Объект.ПометкаУдаления Тогда
					СвязанныйОбъект.ПометкаУдаления = Объект.ПометкаУдаления;
					СвязанныйОбъект.ОбменДанными.Загрузка = Истина;
					СвязанныйОбъект.Записать();
				КонецЕсли;
				
				СвязанныйОбъект.ДополнительныеСвойства.Вставить("OperationType", "НачислениеРетроБонусов_ПрочиеРасходы");
				Документы.ПрочиеДоходыРасходы.ОтменитьПроведение_ПометитьНаУдаление_СвязанныеДокументы(СвязанныйОбъект, Ложь, Объект.ПометкаУдаления);

				СвязанныйОбъект.ДополнительныеСвойства.Вставить("OperationType", "ПокупкаКомиссияСоСторнировкойПредварительныхНачислений_РеклассификацияРасходов");
				Документы.ПрочиеДоходыРасходы.ОтменитьПроведение_ПометитьНаУдаление_СвязанныеДокументы(СвязанныйОбъект, Ложь, Объект.ПометкаУдаления);
				
			Исключение 
				
				Отказ = Истина;
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Не удалось распровести/пометить на удаление: """ + Строка(СвязанныйОбъект) + """: " + ОписаниеОшибки() + Символы.ПС;
				
			КонецПопытки;
			
		КонецЕсли; //ПрочиеДоходыРасходы не помечен на удаление 
		//НАЧАЛО Качикина 20.12.2024 Выполнение задач №000052118
		КонецЕсли;
		//КОНЕЦ Качикина 20.12.2024 Выполнение задач №000052118
	КонецЕсли; //МогутБытьСвязанныеДокументы
	
КонецПроцедуры

// Борисенко Игорь 13.09.2023 Выполнение задач №000046846
Процедура ОтменитьПроведение_ПометитьНаУдаление_Лишний_РеализацияТоваровУслуг_ВнутреннееПотребление(Объект, Отказ, Результат)
	
	УИД = Объект.Ссылка.УникальныйИдентификатор();
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		СвязаннаяСсылка = Документы.ВнутреннееПотребление.ПолучитьСсылку(УИД);
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ВнутреннееПотребление") Тогда
		СвязаннаяСсылка = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(УИД);
	КонецЕсли;

	Если Не ОбщегоНазначения.СсылкаСуществует(СвязаннаяСсылка) Тогда
		Возврат; //ничего удалять
	КонецЕсли;
	
	СвязанныйОбъект = СвязаннаяСсылка.ПолучитьОбъект();
	
	Если СвязанныйОбъект <> Неопределено 
		И СвязанныйОбъект.ПометкаУдаления = Ложь
		Тогда
			
		Попытка
			
			Если СвязанныйОбъект.Проведен Тогда
				СвязанныйОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			
			СвязанныйОбъект.ПометкаУдаления = Истина;
			СвязанныйОбъект.ОбменДанными.Загрузка = Истина;
			СвязанныйОбъект.Записать();
			
		Исключение 
			
			Отказ = Истина;
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Не удалось распровести/пометить на удаление: """ + Строка(СвязанныйОбъект) + """: " + ОписаниеОшибки() + Символы.ПС;
			
		КонецПопытки;
		
	КонецЕсли; //ПрочиеДоходыРасходы не помечен на удаление
	
КонецПроцедуры

// Гутарова Екатерина 20.04.2022 Выполнение задач №000041060
//
Функция ПолучитьВзаимозачетЗадолженностиФакторинг(Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаимозачетЗадолженности.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности КАК ВзаимозачетЗадолженности
	|ГДЕ
	|	ВзаимозачетЗадолженности.тн_ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектВЗ = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		ОбъектВЗ = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОбъектВЗ.Ссылка);
		Ссылка = МенеджерОбъекта.ПолучитьСсылку();
		ОбъектВЗ.УстановитьСсылкуНового(Ссылка);  
		ОбъектВЗ.тн_ДокументОснование = Объект.Ссылка;
	КонецЕсли;
	
	ОбъектВЗ.Дата                 = Объект.Дата;
	ОбъектВЗ.Организация          = Объект.Организация;
	ОбъектВЗ.КонтрагентКредитор   = Объект.Контрагент;
	ОбъектВЗ.КонтрагентДебитор    = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Объект.ДополнительныеСвойства.buyerGuid));
	ОбъектВЗ.ВидОперации          = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный; 
	ОбъектВЗ.Ответственный        = Объект.Ответственный;
	ОбъектВЗ.ТипДебитора          = Перечисления.ТипыУчастниковВзаимозачета.Клиент;  
	// НАЧАЛО Гутарова Екатерина 25.01.2024 Выполнение задач №000048231
	//ОбъектВЗ.ТипКредитора       = Перечисления.ТипыУчастниковВзаимозачета.Клиент;
	ОбъектВЗ.ТипКредитора         = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
	 // КОНЕЦ Гутарова Екатерина 25.01.2024 Выполнение задач №000048231
	ОбъектВЗ.Комментарий          = "Создано автоматически на основании документа " + Объект.Номер;
   
	Если ОбъектВЗ.ДебиторскаяЗадолженность.Количество() = 0 Тогда
		СтрокаДЗ = ОбъектВЗ.ДебиторскаяЗадолженность.Добавить();
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Объект.Организация);
	ВалютаУправленческогоУчета     = Константы.ВалютаУправленческогоУчета.Получить();
	
