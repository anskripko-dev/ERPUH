// Чекордина Ирина 26.08.2024 Выполнение задач №000050623
Процедура ЗафиксироватьОтсутствующиеОбъектыСправочников(Ссылка, БазаРеспондентСсылка, ИДСообщения)
		
	МассивОтсутствующихОбъектовСправочников = Новый Массив;
	ТипДанных = "";

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		
		ТипДанных = "Справочники.Номенклатура";
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПриобретениеТоваровУслугТовары.Номенклатура КАК НоменклатураСсылка
			|ИЗ
			|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
			|ГДЕ
			|	ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
			
		Пока Выборка.Следующий() Цикл
			Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.НоменклатураСсылка) Тогда
				МассивОтсутствующихОбъектовСправочников.Добавить(XMLСтрока(Выборка.НоменклатураСсылка));
			КонецЕсли;
		КонецЦикла; 
		
	КонецЕсли;
	
	Если МассивОтсутствующихОбъектовСправочников.Количество() > 0 Тогда
		Дата = ТекущаяДатаСеанса();
		НЗ = РегистрыСведений.тн_ОтсутствующиеДанныеСправочников.СоздатьНаборЗаписей();
		НЗ.Отбор.ОбъектЗагрузки.Установить(Ссылка);
		НЗ.Отбор.ИДСообщения.Установить(ИДСообщения);
		Для Каждого ГУИДОбъекта Из МассивОтсутствующихОбъектовСправочников Цикл
			Запись = НЗ.Добавить();
			Запись.ОбъектЗагрузки = Ссылка;
			Запись.ДатаСообщения = Дата;
			Запись.ТипДанных = ТипДанных;
			Запись.ГУИД = ГУИДОбъекта;
			Запись.БазаИсточникИД = БазаРеспондентСсылка;
			Запись.ИДСообщения = ИДСообщения;
		КонецЦикла;
		НЗ.Записать();
	КонецЕсли;
		
КонецПроцедуры

