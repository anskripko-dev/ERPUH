// Борисенко Игорь 30.03.2022 Выполнение задач №000040817
Процедура ОбработатьСообщениеRMQ_ВПотоке(МассивИД) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ИДСообщения КАК ИДСообщения,
		|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ТекстСообщения КАК ТекстСообщения,
		// НАЧАЛО Белоконенко Денис 18.04.2023 Выполнение задач №000045229
		|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.УниверсальнаяДатаСообщения КАК УниверсальнаяДатаСообщения,
		// КОНЕЦ Белоконенко Денис 18.04.2023 Выполнение задач №000045229
		|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.СвойстваСообщения КАК СвойстваСообщения
		|ИЗ
		|	РегистрСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ КАК тн_Интеграция_ОчередьОбработкиСообщенийRMQ
		|ГДЕ
		|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ИДСообщения В(&МассивИД)";
	
	Запрос.УстановитьПараметр("МассивИД", МассивИД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл		
		РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.ИзменитьСтатус(ВыборкаДетальныеЗаписи.ИДСообщения, Истина);			
	КонецЦикла;
	
	ВыборкаДетальныеЗаписи.Сбросить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Отказ = Ложь;
		ТекстСообщенияJSON = ВыборкаДетальныеЗаписи.ТекстСообщения;
		СвойстваСообщения = ДесериализоватьДанные(ВыборкаДетальныеЗаписи.СвойстваСообщения); 
		
		//НАЧАЛО Ведутенко С.А. 21.02.2024 Выполнение задач №000048568
			
		Если ТипЗнч(СвойстваСообщения) = Тип("Строка") И ПустаяСтрока(СвойстваСообщения) Тогда
			СвойстваСообщения = Неопределено;
		КонецЕсли;
		
		//КОНЕЦ  Ведутенко С.А. 21.02.2024 Выполнение задач №000048568
		
		ОбработкаСообщенияRMQИзПромежуточногоРегистра = Истина;
		// НАЧАЛО Белоконенко Денис 18.04.2023 Выполнение задач №000045229
		//ПолучениеСообщенийRMQ(ТекстСообщенияJSON, СвойстваСообщения,, Отказ,, ОбработкаСообщенияRMQИзПромежуточногоРегистра);
		ПолучениеСообщенийRMQ(ТекстСообщенияJSON, СвойстваСообщения,, Отказ,, ОбработкаСообщенияRMQИзПромежуточногоРегистра, ВыборкаДетальныеЗаписи.УниверсальнаяДатаСообщения);
		// КОНЕЦ Белоконенко Денис 18.04.2023 Выполнение задач №000045229		
		
		Если Не Отказ Тогда
			РегистрыСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ.УдалитьСообщение(ВыборкаДетальныеЗаписи.ИДСообщения);
		// НАЧАЛО Борисенко Игорь 30.08.2022 Выполнение задач №000042441
		Иначе //Если КоличествоПопыток превысило предельное, тогда снимаем статус ВРаботе
			КоличествоПопыток = Константы.тн_Интеграция_КоличествоПопытокПовторнойОбработкиСообщенийRMQ.Получить();
			
			МенеджерЗаписи = РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИДСообщения = ВыборкаДетальныеЗаписи.ИДСообщения;
			МенеджерЗаписи.Прочитать();
			
			Если МенеджерЗаписи.КоличествоПопыток >= КоличествоПопыток Тогда
				//РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.ИзменитьСтатус(ВыборкаДетальныеЗаписи.ИДСообщения, Ложь);                                 
				
				МенеджерЗаписи.ВРаботе = Ложь;     
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
		// КОНЕЦ Борисенко Игорь 30.08.2022 Выполнение задач №000042441
		КонецЕсли;
		
	КонецЦикла;
	   	         			
КонецПроцедуры // ОбработатьСообщениеRMQ_ВПотоке()

