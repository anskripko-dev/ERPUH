// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
//Документ загружается из УПП "как есть"- с несколькими складами разных групп в тч
//
//Затем:
//
//Если в тч Реализации несколько Складов и они принадлежат разным группам складов тогда
//- выгрузка будет разбита на несколько Реализаций - в каждой будут склады только из одной группы
//- УИД УПП будет совпадать только для "первой" Реализации ЕРП УХ; для остальных сгенерированы
//- номера Реализаций будут содержать постфикс с доп.номером
//
//Корректировка Реализаций:
//- выгрузка будет разбита на несколько Корректировок - в каждой будут склады только из одной группы
//- УИД УПП будет совпадать только для "первой" Реализации ЕРП УХ; для остальных сгенерированы
//- номера Корректировок будут содержать постфикс с доп.номером
//
//РеализацияОтгруженных:
//- статус "Отгружено" установить для каждой связанной Реализации
//
//СчФ Выданные:
//- если СчФ сформирована на осн. нескольких Реализаций/Корректировок (в ЕРП УХ), то она все равно выгружается одной, 
//а все связанные Реализации перечисляются в ее тч ДокументыОснования
//
//- связь между связанными Реализациями/Корректировками держится через рс тн_ЕдиныйДокументУПП
//
Процедура ПроверитьРазбитьДокументыПоСкладам(Объект, Отказ) Экспорт
	
	ЭтоРеализация = Ложь; ЭтоКорректировкаРеализации = Ложь; ЭтоСчФВыданный = Ложь;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ЭтоРеализация = Истина;
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		ЭтоКорректировкаРеализации = Истина;
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.СчетФактураВыданный") Тогда
		ЭтоСчФВыданный = Истина;
	Иначе
		Возврат; //не предусмотренный вариант
	КонецЕсли;
	
	ВыборкаГр = Неопределено;
	Если ЭтоРеализация Или ЭтоКорректировкаРеализации Тогда
		
		Если НесколькоСкладовРазныхГрупп(Объект, ВыборкаГр) Тогда
		Иначе
	
			//Если в тч несколько складов, то в шапке нужно указать ГруппуСкладов
			тз = Объект.Товары.Выгрузить(,"Склад");
			тз.Свернуть("Склад",);
			Если тз.Количество() > 1 Тогда
				ГруппаСкладов = тз[0].Склад.Родитель;
				тн_Интеграция_ERP_УХ.ПроверитьУстановить_ВыборГруппы(ГруппаСкладов, Отказ);
				Объект.Склад = ГруппаСкладов;
			КонецЕсли;
					
			Возврат; //Документ разбивать по складам не нужно
		КонецЕсли;
		
		//Несколько складов разных групп
		
		//В текущем документе оставляем строки первой группы складов; УИД этого документа связан с УИД документа в УПП
		//Для остальных групп складов создаем доп.документы
		
		//Сохраним содержание исходного документа, для создания доп.документв; содержание исходного Объект будет скорректировано в контексте ПервыйДокОб
		ИсходныйДокОб = Объект.Скопировать();
		ИсходныйДокОб.Номер 	= Объект.Номер;
		ИсходныйДокОб.Дата 		= Объект.Дата;
		ИсходныйДокОб.Проведен 	= Объект.Проведен;
		// НАЧАЛО Хоменко Вадим 03.08.2021 Выполнение задач №000035594
		Если ЭтоРеализация Тогда
			ИсходныйДокОб.Статус 	= Объект.Статус;
		КонецЕсли;
		// КОНЕЦ Хоменко Вадим 03.08.2021 Выполнение задач №000035594 
		ИсходныйДокОб.Товары.Загрузить(Объект.Товары.Выгрузить());
		Если ЭтоКорректировкаРеализации Тогда
			ИсходныйДокОб.Расхождения.Загрузить(Объект.Расхождения.Выгрузить());
		КонецЕсли;
		
		пп = 0; ПервыйДокОб = Неопределено; масДокументов = Новый Массив;
		Пока ВыборкаГр.Следующий() Цикл
			пп = пп + 1;
			
			Если пп = 1 Тогда
				ПервыйДокОб = Объект;
				ДокОбъект = ПолучитьСоздатьДопДокумент(Объект, пп, Отказ);
			Иначе
				ДокОбъект = ПолучитьСоздатьДопДокумент(ИсходныйДокОб, пп, Отказ);
			КонецЕсли;
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			СкорректироватьДокументПоТекущемуСкладу(ДокОбъект, ВыборкаГр, пп, Отказ);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			масДокументов.Добавить(ДокОбъект.Ссылка);
		КонецЦикла; //По группам складов
		
		Зарегистрировать_тн_ЕдиныйДокументУПП(ПервыйДокОб.Ссылка, масДокументов, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		//Проверяем/корректируем основания СчФ
		ПроверитьСкорректироватьОснованияСчФВыданный(Неопределено, ПервыйДокОб.Ссылка, масДокументов, Отказ);
		
	ИначеЕсли ЭтоСчФВыданный Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДокументыОснования", Объект.ДокументыОснования.Выгрузить());
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ ОснованияСчФ
		|ИЗ
		|	&ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тн_ЕдиныйДокументУПП.ДополнительныйДокумент КАК ДополнительныйДокумент
		|ИЗ
		|	РегистрСведений.тн_ЕдиныйДокументУПП КАК тн_ЕдиныйДокументУПП
		|ГДЕ
		|	тн_ЕдиныйДокументУПП.ДокументУИД В
		|			(ВЫБРАТЬ
		|				ОснованияСчФ.ДокументОснование
		|			ИЗ
		|				ОснованияСчФ)";
		масДокументов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДополнительныйДокумент");
		
		// НАЧАЛО Борисенко И.Н. 19.08.2021 Выполнение задач №000039141
		Если масДокументов.Количество() = 0 Тогда
			Возврат; //основания не зарегистрированы в рс тн_ЕдиныйДокументУПП - делить не нужно
		КонецЕсли;
		// КОНЕЦ Борисенко И.Н. 19.08.2021 Выполнение задач №000039141
		
		ПроверитьСкорректироватьОснованияСчФВыданный(Объект, Неопределено, масДокументов, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
Функция НесколькоСкладовРазныхГрупп(Объект, ВыборкаГр)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", Объект.Товары.Выгрузить());
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Склад КАК Склад
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Склады.Ссылка КАК Склад,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Склады.Родитель.Наименование, ""Без родителя"") = ""Без родителя""
	|			ТОГДА Товары.Склад
	|		ИНАЧЕ ЕСТЬNULL(Склады.Родитель, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК Группа,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Склады.Родитель.Наименование, ""Без родителя"") = ""Без родителя""
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ЕСТЬNULL(Склады.Родитель.ЭтоГруппа, ЛОЖЬ)
	|	КОНЕЦ КАК ЭтоГруппа
	|ПОМЕСТИТЬ Склады
	|ИЗ
	|	Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|		ПО Товары.Склад = Склады.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Склады.Группа КАК Группа,
	|	Склады.Склад КАК Склад
	|ИЗ
	|	Склады КАК Склады
	|ИТОГИ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Склад)
	|ПО
	|	Группа";
	ВыборкаГр = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаГр.Количество() > 1 Тогда
		Возврат Истина; 
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
Функция ПолучитьСоздатьДопДокумент(Объект, пп, Отказ)
	
	//Номер документа
	Номер = НомерДокумента11Символов(Объект.Номер + "_" + Строка(пп));
	
	Если пп = 1 Тогда
		Док = Объект.Ссылка;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Док = Документы.РеализацияТоваровУслуг.НайтиПоНомеру(Номер, Объект.Дата);
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		Док = Документы.КорректировкаРеализации.НайтиПоНомеру(Номер, Объект.Дата);
		
	Иначе
		Отказ = Истина;
		Возврат Неопределено; //не предусмотренный вариант
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Док) Тогда
		//перезаполним данными последней выгрузки
		
		Если пп = 1 Тогда
			ДокОбъект = Объект;
		Иначе
			ДокОбъект = Док.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(ДокОбъект, Объект);
			ДокОбъект.Товары.Загрузить(Объект.Товары.Выгрузить());
			Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
				ДокОбъект.Расхождения.Загрузить(Объект.Расхождения.Выгрузить());
			КонецЕсли;
			
			ДокОбъект.ОбменДанными.Загрузка = Ложь;
		КонецЕсли;		
		
	Иначе
		//создаем новый
		ДокОбъект = Объект.Скопировать();
		ДокОбъект.Товары.Загрузить(Объект.Товары.Выгрузить());
		Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
			ДокОбъект.Расхождения.Загрузить(Объект.Расхождения.Выгрузить());
		КонецЕсли;
		
		ДокОбъект.ОбменДанными.Загрузка = Ложь;
		
	КонецЕсли;
	
	ДокОбъект.Дата 		= Объект.Дата;
	ДокОбъект.Номер 	= Номер;
	ДокОбъект.Проведен 	= Объект.Проведен;
	
	// НАЧАЛО Хоменко В.В. 30.07.2021 Выполнение задачи №000035594
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		ПроверитьСкорректироватьОснованиеКорректировкаРеализации(ДокОбъект);	
	КонецЕсли;
	// КОНЕЦ Хоменко В.В. 30.07.2021 Выполнение задачи №000035594
		
	Возврат ДокОбъект;
	
КонецФункции

// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
Процедура СкорректироватьДокументПоТекущемуСкладу(ДокОбъект, ВыборкаГр, пп, Отказ)
	
	//Если в текущей выборке один склад, то в шапке прописываем непосредственно склад, а не его групп,
	//в противном случае, в шапке прописываем группу; 
	//		для этой группы проверяем/устанавливаем ВыборГруппы 
	//		проверяем/устанавливаем функц.опцию ИспользоватьСкладыВТабличнойЧастиДокументовПродажи
	
	КолСкладов = ВыборкаГр.Склад;
	
	ВыборкаСкл = ВыборкаГр.Выбрать();
	
	Если КолСкладов = 1 Тогда	//один склад в тч
		ВыборкаСкл.Следующий();
		
		ДокОбъект.Склад = ВыборкаСкл.Склад;
	Иначе	//несколько складов в тч тз одной группы
		
		Если ЗначениеЗаполнено(ВыборкаГр.Группа) И ВыборкаГр.ЭтоГруппа Тогда
			
			ПроверитьУстановитьФункцОпцию_ИспользоватьСкладыВТабличнойЧастиДокументовПродажи(Отказ);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			ПроверитьУстановить_ВыборГруппы(ВыборкаГр.Группа, Отказ);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		
			ДокОбъект.Склад = ВыборкаГр.Группа;
		Иначе //Склады без родителя
			ВыборкаСкл.Следующий();
			
		    ДокОбъект.Склад = ВыборкаСкл.Склад;
		КонецЕсли;
	КонецЕсли;
		
	//Товары: фильтр по складу
	инд = 0;
	Пока инд < ДокОбъект.Товары.Количество() Цикл
		СтрокаТовары = ДокОбъект.Товары[инд];
		
		Если СтрокаТовары.Склад <> ВыборкаСкл.Склад И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовары.Склад, "Родитель") <> ВыборкаГр.Группа Тогда
			ДокОбъект.Товары.Удалить(инд);
		Иначе
			инд = инд + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаРеализации") И ДокОбъект.Расхождения.Количество() > 0 Тогда
		инд = 0;
		Пока инд < ДокОбъект.Расхождения.Количество() Цикл
			СтрокаРасхождения = ДокОбъект.Расхождения[инд];
			
			Если СтрокаРасхождения.Склад <> ВыборкаСкл.Склад И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРасхождения.Склад, "Родитель") <> ВыборкаГр.Группа Тогда
				ДокОбъект.Расхождения.Удалить(инд);
			Иначе
				инд = инд + 1;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	//Пересчет СуммаДокумента
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		
		// НАЧАЛО Борисенко И.Н. 10.08.2021 Выполнение задач №000039141
		//Удалим строки тч Товары с пустым Количеством
		масТовары = ДокОбъект.Товары.НайтиСтроки(Новый Структура("Количество", 0));
		Для каждого СтрокаТовары Из масТовары Цикл
			ДокОбъект.Товары.Удалить(СтрокаТовары);
		КонецЦикла;
		// КОНЕЦ Борисенко И.Н. 10.08.2021 Выполнение задач №000039141
		
		ДокОбъект.СуммаДокумента = ДокОбъект.тн_ПолучитьСуммуДокумента();
	Иначе
		ДокОбъект.СуммаДокумента = ДокОбъект.ПолучитьСуммуДокумента();
	КонецЕсли;
	
	//Запись
	Попытка
		
		Если Не ДокОбъект.ОбменДанными.Загрузка Тогда
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			ДокОбъект.ОбменДанными.Загрузка = Ложь;
		КонецЕсли;
		
		Если ДокОбъект.Проведен И Не ДокОбъект.ОбменДанными.Загрузка Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
	Исключение
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
Процедура ПроверитьУстановитьФункцОпцию_ИспользоватьСкладыВТабличнойЧастиДокументовПродажи(Отказ)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСкладыВТабличнойЧастиДокументовПродажи") Тогда
		Попытка
			Константы.ИспользоватьСкладыВТабличнойЧастиДокументовПродажи.Установить(Истина);
		Исключение
			Отказ = Истина;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
Процедура ПроверитьУстановить_ВыборГруппы(ГруппаСкл, Отказ) Экспорт
	
	Если ЗначениеЗаполнено(ГруппаСкл)
		И ГруппаСкл.ВыборГруппы <> Перечисления.ВыборГруппыСкладов.РазрешитьВЗаказахИНакладных Тогда
		
		Об = ГруппаСкл.ПолучитьОбъект();
		Об.ВыборГруппы = Перечисления.ВыборГруппыСкладов.РазрешитьВЗаказахИНакладных;
		
		Попытка
			Об.Записать();
		Исключение
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
// НАЧАЛО Борисенко Игорь 20.06.2023 Выполнение задач №000045883
//Функция НомерДокумента11Символов(Знач Номер, ДлинаНомера = 0)
Функция НомерДокумента11Символов(Знач Номер, ДлинаНомера = 0) Экспорт
// КОНЕЦ Борисенко Игорь 20.06.2023 Выполнение задач №000045883
	
	Номер = СокрЛП(Номер);
	
	Если ДлинаНомера = 0 Тогда
		ДлинаНомера = 11;
	КонецЕсли;
	
	Если СтрДлина(Номер) <= ДлинаНомера Тогда
		Возврат Номер;
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 20.06.2025 Выполнение задач №000054157
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Номер) Тогда
		Возврат Прав(Номер, ДлинаНомера);
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 20.06.2025 Выполнение задач №000054157
	
	//Отрежем первую цифру (сохраним префикс, а первая цифра, скорее всего, будет "0")
	Для НомерСимвола = 1 по СтрДлина(Номер) Цикл

		Символ = Сред(Номер, НомерСимвола, 1);
		
		Если СтрНайти("1234567890", Символ) > 0 Тогда
			//это первая цифра, этот символ удаляем из номера
			
			Номер = ?(НомерСимвола = 1, "", Лев(Номер, НомерСимвола - 1)) + Сред(Номер, НомерСимвола + 1);
			
			Если СтрДлина(Номер) <= ДлинаНомера Тогда
				Возврат Номер;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	//Цифр не нашлось - отрезаем крайний левый символ
	Возврат Прав(Номер, ДлинаНомера);
	
КонецФункции

// Юдина Екатерина 03.02.2026 Выполнение задач №000056624 
//
//// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011 +Экспорт
//Процедура Зарегистрировать_тн_ЕдиныйДокументУПП(ПервыйДок, масДокументов, Отказ)
Процедура Зарегистрировать_тн_ЕдиныйДокументУПП(ПервыйДок, масДокументов, Отказ, НеПроводитьДокумент = Ложь) Экспорт
	
	Набор = РегистрыСведений.тн_ЕдиныйДокументУПП.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументУИД.Установить(ПервыйДок);
	
	//Пометим на удаление неактуальные документы
	Набор.Прочитать();
	Для каждого Запись Из Набор Цикл
		Если масДокументов.Найти(Запись.ДополнительныйДокумент) = Неопределено Тогда //это неактуальный документ
			
			об = Запись.ДополнительныйДокумент.ПолучитьОбъект();
			Попытка
				Если об.Проведен Тогда
					об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;  
				// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056624
				Если ТипЗнч(об) = Тип("ДокументОбъект.ПроизводствоБезЗаказа") Тогда   
					об.УстановитьПометкуУдаления(Истина);	
				Иначе
				// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056624 
					об.ПометкаУдаления(Истина); 
				// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056624
				КонецЕсли;
				// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056624 
			Исключение
				Отказ = Истина;
				Возврат;
			КонецПопытки;
			
		КонецЕсли;
	КонецЦикла;
	
	//Запишем актуальный набор
	Набор.Очистить();
	
	Для каждого Док Из масДокументов Цикл
		Запись = Набор.Добавить();
		Запись.ДокументУИД = ПервыйДок;
		Запись.ДополнительныйДокумент = Док;   
		// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056624
		Если Не НеПроводитьДокумент Тогда
		// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056624 
			// НАЧАЛО Гутарова Екатерина 11.03.2024 Выполнение задач №000048815 
			ДокументОбъект = Док.ПолучитьОбъект();
			ДокументОбъект.тн_СвязанныйДокумент = ПервыйДок;  
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			Попытка
				ДокументОбъект.Записать();
			Исключение 
				Отказ = Истина;
			КонецПопытки;
			// КОНЕЦ Гутарова Екатерина 11.03.2024 Выполнение задач №000048815 
		// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056624 
		КонецЕсли;
		// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056624 
		
	КонецЦикла;
	
	Попытка
		Набор.Записать();
	Исключение
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

// Хоменко В.В. 30.07.2021 Выполнение задачи №000035594
Процедура ПроверитьСкорректироватьОснованиеКорректировкаРеализации(ДокОбъект)
	
	Если Не ЗначениеЗаполнено(ДокОбъект.ДокументОснование) Тогда 
		Возврат; 
	КонецЕсли;
	
	//Ищем постфикс переданного документа
	Номер = ДокОбъект.Номер;
	ПостфиксНомерСимв = СтрНайти(Номер, "_");
	Если ПостфиксНомерСимв > 0 Тогда
		ПостфиксДокумента = Сред(Номер, ПостфиксНомерСимв);	
	Иначе
		Возврат;
	КонецЕсли;
	
	//Ищем постфикс его основания
	НомерОснования = ДокОбъект.ДокументОснование.Номер;
	ПостфиксНомерСимв = СтрНайти(НомерОснования, "_");
	Если ПостфиксНомерСимв > 0 Тогда
		ПостфиксОснования = Сред(НомерОснования, ПостфиксНомерСимв);	
	Иначе
		Возврат;
	КонецЕсли;
	
	//Если постфиксы совпадают - ничего не делаем
	Если ПостфиксДокумента = ПостфиксОснования Тогда
		Возврат;
	КонецЕсли;
	
	//Если постфиксы разные, ищем док основание с нужным постфиксом
	НужныйНомерОснования = СтрЗаменить(НомерОснования, ПостфиксОснования, ПостфиксДокумента);
	НужныйДокументОснование = Документы[ДокОбъект.ДокументОснование.Метаданные().Имя].НайтиПоНомеру(НужныйНомерОснования, ДокОбъект.ДокументОснование.Дата); 
	
	//Если не найден - оставляем основание без изменений
	Если Не ЗначениеЗаполнено(НужныйДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ДокОбъект.ДокументОснование = НужныйДокументОснование;
		
КонецПроцедуры

// Борисенко И.Н. 28.05.2021 Выполнение задачи №000038011
Процедура ПроверитьСкорректироватьОснованияСчФВыданный(ОбСчФ = Неопределено, ПервыйДок = Неопределено, масДокументов, Отказ)
	
	СчФ = ?(ОбСчФ = Неопределено, Неопределено, ОбСчФ.Ссылка);
	
	//Найдем СчФ и ее ДокументыОснования
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчФ", СчФ);
	Если ОбСчФ <> Неопределено Тогда
		Запрос.УстановитьПараметр("СчФДокументыОснования", ОбСчФ.ДокументыОснования.Выгрузить());
	Иначе
		тз = Новый ТаблицаЗначений;
		тз.Колонки.Добавить("ДокументОснование", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
		Запрос.УстановитьПараметр("СчФДокументыОснования", тз);
	КонецЕсли;
	Запрос.УстановитьПараметр("ПервыйДок", ПервыйДок);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ ОснованияСчФ
	|ИЗ
	|	&СчФДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчФПервогоДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления
	|	И (СчетФактураВыданныйДокументыОснования.Ссылка = &СчФ
	|			ИЛИ СчетФактураВыданныйДокументыОснования.ДокументОснование = &ПервыйДок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчФПервогоДокумента.Ссылка КАК Ссылка,
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	СчФПервогоДокумента КАК СчФПервогоДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ПО СчФПервогоДокумента.Ссылка = СчетФактураВыданныйДокументыОснования.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&СчФ,
	|	СчФДокументыОснования.ДокументОснование
	|ИЗ
	|	ОснованияСчФ КАК СчФДокументыОснования
	|ИТОГИ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументОснование)
	|ПО
	|	Ссылка";
	ВыборкаСчФ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НужноПереписать = Ложь;
	Если ВыборкаСчФ.Следующий() Тогда
		СчФ = ВыборкаСчФ.Ссылка;
		
		Если ВыборкаСчФ.ДокументОснование <> масДокументов.Количество() Тогда                 //или количество документов не совпадет
			НужноПереписать = Истина;
			
		Иначе
		
			ВыборкаОсн = ВыборкаСчФ.Выбрать();
			Пока ВыборкаОсн.Следующий() Цикл
			
				Если масДокументов.Найти(ВыборкаОсн.ДокументОснование) = Неопределено Тогда   //или не найдем один из документов
					НужноПереписать = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЕсли;
	
	//Перепишем
	Если НужноПереписать и ЗначениеЗаполнено(СчФ) Тогда
		
		Если ОбСчФ = Неопределено Тогда
			ОбСчФ = СчФ.ПолучитьОбъект();
		КонецЕсли;
		
		ОбСчФ.ДокументыОснования.Очистить();
		
		Для каждого Док Из масДокументов Цикл
			СтрокаДокументыОснования = ОбСчФ.ДокументыОснования.Добавить();
			СтрокаДокументыОснования.ДокументОснование = Док;
		КонецЦикла;
		
		Попытка
			Если ОбСчФ.Проведен И Не ОбСчФ.ОбменДанными.Загрузка Тогда
				ОбСчФ.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ОбСчФ.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		Исключение
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// Борисенко И.Н. 30.05.2021 Выполнение задачи №000038011
Функция ПолучитьДокументыРазбитыеПоРазнымСкладам(ПервыйДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПервыйДокумент", ПервыйДокумент);
	Запрос.Текст =
	"ВЫБРАТЬ 
	|	тн_ЕдиныйДокументУПП.ДополнительныйДокумент КАК ДополнительныйДокумент
	|ИЗ
	|	РегистрСведений.тн_ЕдиныйДокументУПП КАК тн_ЕдиныйДокументУПП
	|ГДЕ
	|	тн_ЕдиныйДокументУПП.ДокументУИД = &ПервыйДокумент ";
	масДокументов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДополнительныйДокумент");
	
	Возврат масДокументов;
	
КонецФункции

// Белоконенко Денис 19.01.2023 Выполнение задач №000044034
Процедура ЗаписатьНомерИДатуВходящегоВДокументыОснованияСФ(СФ) Экспорт
	НомерВходящегоДокумента = СФ.Номер;
	// НАЧАЛО Белоконенко Денис 02.03.2023 Выполнение задач №000044618
	//ДатаВходящегоДокумента  = СФ.Дата;
	ДатаВходящегоДокумента  = СФ.ДатаСоставления;
	// КОНЕЦ Белоконенко Денис 02.03.2023 Выполнение задач №000044618
	
	Для Каждого СтрокаДокументОснование Из СФ.ДокументыОснования Цикл
		Если ЗначениеЗаполнено(СтрокаДокументОснование.ДокументОснование) Тогда
			
			ОбъектДокОснование = СтрокаДокументОснование.ДокументОснование.ПолучитьОбъект();
			ОбъектДокОснование.ОбменДанными.Загрузка = Истина;
			
			Попытка
				Если ТипЗнч(СтрокаДокументОснование.ДокументОснование) = Тип("ДокументСсылка.ОтчетПереработчика") Тогда
					ОбъектДокОснование.НомерПоДаннымПартнера = НомерВходящегоДокумента;
					ОбъектДокОснование.ДатаПоДаннымПартнера = ДатаВходящегоДокумента; 
					
					УИДОтчета = СтрокаДокументОснование.ДокументОснование.УникальныйИдентификатор();
					ПриобретениеУслугСсылка 				= Документы.ПриобретениеУслугПрочихАктивов.ПолучитьСсылку(УИДОтчета);
					ПриобретениеУслугОбъект 				= ПриобретениеУслугСсылка.ПолучитьОбъект();
					Если ПриобретениеУслугОбъект <> Неопределено Тогда
						ПриобретениеУслугОбъект.НомерВходящегоДокумента = НомерВходящегоДокумента;
						ПриобретениеУслугОбъект.ДатаВходящегоДокумента	= ДатаВходящегоДокумента;
						ПриобретениеУслугОбъект.ОбменДанными.Загрузка 	= Истина;
						ПриобретениеУслугОбъект.Записать();
					КонецЕсли;
					
				Иначе	
					ОбъектДокОснование.НомерВходящегоДокумента = НомерВходящегоДокумента;
					ОбъектДокОснование.ДатаВходящегоДокумента = ДатаВходящегоДокумента; 
				КонецЕсли;
				
				ОбъектДокОснование.Записать();
			Исключение
				ОбщегоНазначения.СообщитьПользователю("Не удалось записать документ основания СФ");	
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Белоконенко Денис 19.01.2023 Выполнение задач №000044034
Процедура ЗаполнитьСФПоОснованию(ОбъектСФ, СсылкаОснование) Экспорт
	ДатаСоставления = ОбъектСФ.ДатаСоставления;
	// НАЧАЛО Белоконенко Денис 31.05.2023 Выполнение задач №000045657
	ИсходныйДокумент = Неопределено;
	// КОНЕЦ Белоконенко Денис 31.05.2023 Выполнение задач №000045657
	
	// НАЧАЛО Белоконенко Денис 27.03.2023 Выполнение задач №000044945
	Если ОбъектСФ.ДокументыОснования.Количество() > 0 Тогда
		СуммыДокументаСФ = Новый Структура("Сумма,СуммаНДС,СуммаУвеличение,СуммаУменьшение,СуммаНДСУвеличение,СуммаНДСУменьшение",0,0,0,0,0,0);		
		ЗаполнитьЗначенияСвойств(СуммыДокументаСФ, ОбъектСФ.ДокументыОснования[0]);
		// НАЧАЛО Белоконенко Денис 31.05.2023 Выполнение задач №000045657
		ИсходныйДокумент = ОбъектСФ.ДокументыОснования[0].ИсходныйДокумент;
		// КОНЕЦ Белоконенко Денис 31.05.2023 Выполнение задач №000045657
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 27.03.2023 Выполнение задач №000044945
	// НАЧАЛО Белоконенко Денис 31.01.2023 Выполнение задач №000044172
	ГуидДокументаОснованияСтрока = Строка(СсылкаОснование.УникальныйИдентификатор()); 
	ОбъектСФ.ДокументыОснования.Очистить();
	// КОНЕЦ  Белоконенко Денис 31.01.2023 Выполнение задач №000044172
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", 	СсылкаОснование);
	ДанныеЗаполнения.Вставить("Исправление", 		ОбъектСФ.Исправление);
	ДанныеЗаполнения.Вставить("Корректировочный", 	ОбъектСФ.Корректировочный);
	
	ОбъектСФ.Заполнить(ДанныеЗаполнения);
	ЗаполнитьЗначенияСвойств(ОбъектСФ, ДанныеЗаполнения);
	
	// НАЧАЛО Белоконенко Денис 24.03.2023 Выполнение задач №000044918
	// По возвратам типовой функионал подтягивает все СФ в связке (ПТУ, Корректировки, Возвраты). Оставляем только ПТУ.
	Если ТипЗнч(СсылкаОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		МассивИсходныхДокументов = ОбъектСФ.ДокументыОснования.ВыгрузитьКолонку("ИсходныйДокумент");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СчетФактураПолученныйДокументыОснования.Ссылка КАК СсылкаСФ
			|ИЗ
			|	Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученныйДокументыОснования
			|ГДЕ
			|	СчетФактураПолученныйДокументыОснования.Ссылка В(&МассивСсылок)
			|	И НЕ СчетФактураПолученныйДокументыОснования.ДокументОснование ССЫЛКА Документ.ПриобретениеТоваровУслуг
			|
			|СГРУППИРОВАТЬ ПО
			|	СчетФактураПолученныйДокументыОснования.Ссылка";
		
		Запрос.УстановитьПараметр("МассивСсылок", МассивИсходныхДокументов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтрокаНаУдаление = ОбъектСФ.ДокументыОснования.Найти(Выборка.СсылкаСФ, "ИсходныйДокумент");
			ОбъектСФ.ДокументыОснования.Удалить(СтрокаНаУдаление);
		КонецЦикла;
		
		// НАЧАЛО Белоконенко Денис 31.05.2023 Выполнение задач №000045657
		ОбъектСФ.РучнаяКорректировкаСуммДокумента = Истина;
		// КОНЕЦ Белоконенко Денис 31.05.2023 Выполнение задач №000045657
		
		// НАЧАЛО Белоконенко Денис 27.03.2023 Выполнение задач №000044945
		// Возвраты по старым первичным документам, которые искуственно присутствуют без движений, возвращает нулевую сумму.
		// Заполняем суммы с сообщения. Ставим РучнаяКорректировкаСуммДокумента, чтобы типовой функционал не обнулял сумму при проведении.
		Если ОбъектСФ.ДокументыОснования.Количество() > 0 И
			ОбъектСФ.ДокументыОснования[0].Сумма = 0 И
			ОбъектСФ.ДокументыОснования[0].СуммаУвеличение = 0 И
			ОбъектСФ.ДокументыОснования[0].СуммаУменьшение = 0 Тогда		
			ЗаполнитьЗначенияСвойств(ОбъектСФ.ДокументыОснования[0], СуммыДокументаСФ);
			// НАЧАЛО Белоконенко Денис 31.05.2023 Выполнение задач №000045657
			//ОбъектСФ.РучнаяКорректировкаСуммДокумента = Истина;
			// КОНЕЦ Белоконенко Денис 31.05.2023 Выполнение задач №000045657
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 27.03.2023 Выполнение задач №000044945		
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 24.03.2023 Выполнение задач №000044918	
	
	ОбъектСФ.ДатаСоставления = ДатаСоставления;
	// НАЧАЛО Белоконенко Денис 31.01.2023 Выполнение задач №000044172
	Если ОбъектСФ.ДокументыОснования.Количество() > 0 Тогда
		ОбъектСФ.ДокументыОснования[0].тн_ГуидДокументаОснования = ГуидДокументаОснованияСтрока;
		// НАЧАЛО Белоконенко Денис 31.05.2023 Выполнение задач №000045657
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
			ОбъектСФ.ДокументыОснования[0].ИсходныйДокумент = ИсходныйДокумент;
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 31.05.2023 Выполнение задач №000045657
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 31.01.2023 Выполнение задач №000044172
КонецПроцедуры

#КонецОбласти

// Белоконенко Денис 22.12.2021 Выполнение задач №000039896
Функция СопоставитьСтавкуНДСИзУПП(НДС_УПП) Экспорт
	
	// НАЧАЛО Чекордина Ирина 10.11.2025 Выполнение задач №000055726
	//Если НДС_УПП = "НДС18" тогда
	Если НДС_УПП = "НДС22" Тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("22%", Истина);
	ИначеЕсли НДС_УПП = "НДС22_122" Тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("22/122", Истина);
	ИначеЕсли НДС_УПП = "ПоБилетам" И ТекущаяДатаСеанса() >= Дата(2026, 01, 01) Тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("22%", Истина);
	ИначеЕсли НДС_УПП = "НДС18" Тогда	
	// КОНЕЦ Чекордина Ирина 10.11.2025 Выполнение задач №000055726	
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("18%", Истина);
	ИначеЕсли НДС_УПП = "НДС18_118" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("18/118", Истина);
	ИначеЕсли НДС_УПП = "НДС10" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("10%", Истина);
	ИначеЕсли НДС_УПП = "НДС10_110" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("10/110", Истина);
	ИначеЕсли НДС_УПП = "НДС0" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("0%", Истина);
	ИначеЕсли НДС_УПП = "БезНДС" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.БезНДС;
	//НАЧАЛО Сафиуллина З.Р. 19.11.2024 Выполнение задач №000051681
	//ИначеЕсли НДС_УПП = "НДС20" тогда
	ИначеЕсли НДС_УПП = "НДС20" ИЛИ НДС_УПП = "ПоБилетам" Тогда
	//КОНЕЦ Сафиуллина З.Р. 19.11.2024 Выполнение задач №000051681
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20%", Истина);
	ИначеЕсли НДС_УПП = "НДС20_120" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20/120", Истина);
	// НАЧАЛО Егоров Петр 19.02.2025 Выполнение задач №000052695
	 ИначеЕсли НДС_УПП = "НДС5" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("5%", Истина); 
	ИначеЕсли НДС_УПП = "НДС5_105" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("5/105", Истина);
    ИначеЕсли НДС_УПП = "НДС7" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("7%", Истина);
    ИначеЕсли НДС_УПП = "НДС7_107" тогда
		СпрСтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("7/107", Истина);
	// КОНЕЦ Егоров Петр 19.02.2025 Выполнение задач №000052695
	Иначе
		СпрСтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка();
