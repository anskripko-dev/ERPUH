		НС.Сумма                    = Строка.sumBonusesMP; 
		НС.СуммаУпр                 = Строка.sumBonusesMP; 
		// НАЧАЛО Юдина Екатерина 22.10.2025 Выполнение задач №000055582
		НС.ДатаОтражения            = ОбъектПрочиеРасходы.Дата; 
		// КОНЕЦ Юдина Екатерина 22.10.2025 Выполнение задач №000055582

