КонецФункции

// Борисенко Игорь 10.06.2022 Выполнение задач №000041384
Функция КонтрольОбменов_ПолучитьАдресаЭП(ВидРассылки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидРассылки", ВидРассылки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тн_ПолучателиРассылкиОСостоянииОбмена.ВидРассылки КАК ВидРассылки,
	|	тн_ПолучателиРассылкиОСостоянииОбмена.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты,
	|	тн_ПолучателиРассылкиОСостоянииОбмена.Активно КАК Активно
	|ИЗ
	|	РегистрСведений.тн_ПолучателиРассылкиОСостоянииОбмена КАК тн_ПолучателиРассылкиОСостоянииОбмена
	|ГДЕ
	|	тн_ПолучателиРассылкиОСостоянииОбмена.ВидРассылки = &ВидРассылки
	|	И тн_ПолучателиРассылкиОСостоянииОбмена.Активно";
	
	УстановитьПривилегированныйРежим(Истина);
	масАдресовЭП = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("АдресЭлектроннойПочты");
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат масАдресовЭП;
	
КонецФункции

// Борисенко Игорь 10.06.2022 Выполнение задач №000041384
Процедура КонтрольОбменов_СформироватьПисьмаНаОтправку(ПараметрыРассылки, Ошибка)
			
	Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	Письмо.Дата						= ТекущаяДатаСеанса();
	Письмо.Важность					= ПараметрыРассылки.Важность;
	Письмо.СтатусПисьма				= Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее;
	Письмо.Кодировка				= "utf-8";
	Письмо.УчетнаяЗапись			= УправлениеЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	Письмо.ОтправительПредставление = Строка(Письмо.УчетнаяЗапись);
	Письмо.Автор					= ПараметрыРассылки.Автор;
	Письмо.Ответственный			= Письмо.Автор;
	Письмо.Тема						= ПараметрыРассылки.Тема;
	Письмо.ТипТекста				= Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст;
	Письмо.ВзаимодействиеОснование	= Неопределено;
	Письмо.УдалятьПослеОтправки		= Ложь;
	Письмо.ЕстьВложения				= Истина;
	Письмо.Текст 					= ПараметрыРассылки.ТекстПисьма;		
	
	НастройкиПользователя = Взаимодействия.ПолучитьПараметрыРаботыПользователяДляИсходящегоЭлектронногоПисьма(Письмо.УчетнаяЗапись, Письмо.ТипТекста, Истина);
	ЗаполнитьЗначенияСвойств(Письмо, НастройкиПользователя);
	
	//Адресаты
	масАдресовЭП = КонтрольОбменов_ПолучитьАдресаЭП(ПараметрыРассылки.ВидРассылки);
	Если масАдресовЭП.Количество() = 0 Тогда
		
		ИмяСобытия = ПараметрыРассылки.Тема;
		Уровень = УровеньЖурналаРегистрации.Ошибка;
		Комментарий = "Не заданы адреса ЭП";
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, Уровень,,,Комментарий); 

		Ошибка = Истина;
		Возврат;
		
	КонецЕсли;
	
	Для каждого АдресЭП Из масАдресовЭП Цикл

		НоваяСтрока = Письмо["ПолучателиПисьма"].Добавить();
		НоваяСтрока.Адрес			= АдресЭП;
		НоваяСтрока.Представление	= АдресЭП;
		НоваяСтрока.Контакт			= АдресЭП;
		
	КонецЦикла;
	Письмо.СписокПолучателейПисьма	= ВзаимодействияКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(Письмо.ПолучателиПисьма, Ложь);
			
	// Вложения
	ДополнительныеПараметры = Новый Структура;
	РазмерВложений = 0;
	
	Если ПараметрыРассылки.ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		
		ФорматыСохранения = Новый Массив;
		ФорматыСохранения.Добавить("XLSX");
		
		ВыбранныеПараметры = Новый Структура;
		ВыбранныеПараметры.Вставить("ФорматыСохранения"				, ФорматыСохранения);
		ВыбранныеПараметры.Вставить("УпаковатьВАрхив"				, Ложь);
		ВыбранныеПараметры.Вставить("ИменаМакетов"					, "АктСверкиВзаимныхРасчетов");
		ВыбранныеПараметры.Вставить("ПереводитьИменаФайловВТранслит", Ложь);
		ВыбранныеПараметры.Вставить("ИмяФайла"						, ПараметрыРассылки.ИмяФайла); 
		
		ФайлыВоВременномХранилище = ПоместитьТабличныеДокументыВоВременноеХранилище(ВыбранныеПараметры, ПараметрыРассылки.ТабличныйДокумент, РазмерВложений);
		
		Письмо.Размер = РазмерВложений + СтрДлина(Письмо.Тема) * 2 + СтрДлина(Письмо.Текст) * 2;
		
		Письмо.Записать();
		
		ПрисоединитьПечатныеФормыКОбъекту(ФайлыВоВременномХранилище, Письмо.Ссылка);
		
	Иначе //без вложения
		
		Письмо.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 11.06.2022 Выполнение задач №000041384
Функция ПоместитьТабличныеДокументыВоВременноеХранилище(ПереданныеНастройки, ТабличныйДокумент, РазмерВложений)
	
	Результат = Новый Массив;
	
	ИмяВременногоКаталога = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременногоКаталога);
	
	ТипФайла = ТипФайлаТабличногоДокумента.XLSX;
	ИмяФайла = ПереданныеНастройки.ИмяФайла;
	ПолноеИмяФайла = УникальноеИмяФайла(ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременногоКаталога) + ИмяФайла);
	ТабличныйДокумент.Записать(ПолноеИмяФайла, ТипФайла);
				
	ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
	
	Размер = ДвоичныеДанные.Размер() * 1.5;
	РазмерВложений = РазмерВложений + Размер;
				
	УникальныйИдентификаторХранилища = Новый УникальныйИдентификатор;
	ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторХранилища);
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("Представление", ИмяФайла);
	ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
	Результат.Добавить(ОписаниеФайла);
	
	УдалитьФайлы(ИмяВременногоКаталога);
	
	Возврат Результат;
	
КонецФункции

// Борисенко Игорь 11.06.2022 Выполнение задач №000041384
Процедура ПрисоединитьПечатныеФормыКОбъекту(ФайлыВоВременномХранилище, ОбъектДляПрисоединения)
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		Для Каждого Файл Из ФайлыВоВременномХранилище Цикл
			ПараметрыФайла = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайла.ВладелецФайлов = ОбъектДляПрисоединения;
			ПараметрыФайла.ИмяБезРасширения = Файл.Представление;
			МодульРаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Файл.АдресВоВременномХранилище, , НСтр("ru = 'Печатная форма';
																									 |en = 'Print form'"));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 11.06.2022 Выполнение задач №000041384
Функция УникальноеИмяФайла(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	Расширение = Файл.Расширение;
	ИмяКаталога = Файл.Путь;
	
	Счетчик = 1;
	Пока Файл.Существует() Цикл
		Счетчик = Счетчик + 1;
		Файл = Новый Файл(ИмяКаталога + ИмяБезРасширения + " (" + Счетчик + ")" + Расширение);
	КонецЦикла;
	
	Возврат Файл.ПолноеИмя;

КонецФункции

