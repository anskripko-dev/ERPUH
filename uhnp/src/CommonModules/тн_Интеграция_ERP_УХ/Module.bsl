			// НАЧАЛО Гутарова Екатерина 20.04.2022 Выполнение задач №000041060
			КонецЦикла;
		    // КОНЕЦ Гутарова Екатерина 20.04.2022 Выполнение задач №000041060

		КонецЕсли;
		
		// НАЧАЛО Борисенко Игорь 06.03.2022 Выполнение задач №000040516
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 06.03.2022 Выполнение задач №000040516
		
