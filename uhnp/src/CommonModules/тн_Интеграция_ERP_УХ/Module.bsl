// Борисенко И.Н. 15.01.2022 Выполнение задачи №000039277
Функция ДатаИзСтрокиUTC(ДатаСтрока) Экспорт
	//"0001-01-01T00:00:00.00Z"
	
	Если СтрДлина(ДатаСтрока) >= 19 Тогда
		
		Год = Сред(ДатаСтрока, 1, 4);
		Мес = Сред(ДатаСтрока, 6, 2);
		Ден = Сред(ДатаСтрока, 9, 2);
		Час = Сред(ДатаСтрока, 12, 2);
		Мин = Сред(ДатаСтрока, 15, 2);
		Сек = Сред(ДатаСтрока, 18, 2);
		
		Возврат Дата(Год,Мес,Ден,Час,Мин,Сек);
		
	КонецЕсли;
	
КонецФункции

