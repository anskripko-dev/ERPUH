//Качикина 15.08.2025 Выполнение задач №000054730 
Процедура ПодменитьОрганизациюПриЗагрузкеДанных(Объект_XDTO, сТип, Менеджер, УИДОбъекта, Результат); 
	
	Если ТипЗнч(Объект_XDTO)<>Тип("ОбъектXDTO") Тогда
		Возврат;
	КонецЕсли;
	
	//1. МассивОбъектовДляПодмены - здесь перечисляем объекты метаданных, в которых нужна подмена (соответствует сТип.Менеджер) 
	МассивОбъектовДляПодмены = Новый Массив;
	МассивОбъектовДляПодмены.Добавить("Документы"); //подмена Организаций возможна для всех документов
	//НАЧАЛО Качикина 18.08.2025 Выполнение задач №00054731
	МассивОбъектовДляПодмены.Добавить("Справочники.БанковскиеСчетаОрганизаций");
	МассивОбъектовДляПодмены.Добавить("Справочники.Кассы");
	МассивОбъектовДляПодмены.Добавить("Справочники.ДоговорыКонтрагентов");
	
	ПодменаТолькоДляНовыхОбъектов = Ложь;
	//КОНЕЦ Качикина 18.08.2025 Выполнение задач №00054731
	ВозможнаПодменаОрганизации = Ложь;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДатаПодмены = ТекущаяДата();
	ДатаПодмены = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	СвойстваОбъект_XDTO = Объект_XDTO.Свойства();
	
	Для Каждого ЭлементДляПодмены Из МассивОбъектовДляПодмены Цикл 
		Если СтрНайти(сТип.Менеджер,ЭлементДляПодмены)<>0 Тогда
			ВозможнаПодменаОрганизации = Истина;
			//НАЧАЛО Качикина 13.01.2026 Выполнение задач №000056360
			//Если СтрНайти(сТип.Менеджер,"Документы")<>0
			//	И  СвойстваОбъект_XDTO.Получить("date") <> Неопределено Тогда 
				//Дата_Объект_XDTO = Объект_XDTO.date;
				//Если ТипЗнч(Дата_Объект_XDTO) = Тип("Строка") Тогда
				//	Дата_Объект_XDTO = ПолучитьДату(Дата_Объект_XDTO);
				//КонецЕсли;
			  Если СтрНайти(сТип.Менеджер,"Документы")<>0 Тогда
				СвойстваОбъект_XDTO_Дата = СвойстваОбъект_XDTO.Получить("date");
				Если СвойстваОбъект_XDTO_Дата <> Неопределено Тогда	
				//Дата может быть типа dataTime(тогда приводим к универсальному времени) и date (тогда берем время как есть) 
				ДатаБезВремени = СвойстваОбъект_XDTO_Дата.Тип.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema"	
								И СвойстваОбъект_XDTO_Дата.Тип.Имя = "date";	
				Дата_Объект_XDTO = ПолучитьДату(Объект_XDTO.date,,ДатаБезВремени);
			//КОНЕЦ Качикина 13.01.2026 Выполнение задач №000056360
				Если ТипЗнч(Дата_Объект_XDTO) = Тип("Дата") Тогда
					ДатаПодмены = Дата_Объект_XDTO;	
				КонецЕсли;
			    //НАЧАЛО Качикина 13.01.2026 Выполнение задач №000056360 
				КонецЕсли;
				//КОНЕЦ Качикина 13.01.2026 Выполнение задач №000056360
			//НАЧАЛО Качикина 18.08.2025 Выполнение задач №000054731
			ИначеЕсли СтрНайти(сТип.Менеджер,"Справочники")<>0 Тогда
				//для справочников подменяем только для НОВЫХ элементов
				ПодменаТолькоДляНовыхОбъектов = Истина;	
			//КОНЕЦ Качикина 18.08.2025 Выполнение задач №000054731
			КонецЕсли;
			Прервать;	
		КонецЕсли;
	КонецЦикла;
	
	//НАЧАЛО Качикина 18.08.2025 Выполнение задач №000054731
	//проверяем, существует ли передаваемый объект в базе
	Если ПодменаТолькоДляНовыхОбъектов Тогда
		СсылкаНаОбъект = Менеджер.ПолучитьСсылку(УИДОбъекта);
		Если СсылкаНаОбъект <> Неопределено И ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
			ВозможнаПодменаОрганизации =Ложь;	
		КонецЕсли;  
	КонецЕсли;
	//КОНЕЦ Качикина 18.08.2025 Выполнение задач №000054731

	Если ВозможнаПодменаОрганизации Тогда
		
		//2. Получаем имя свойства в пакете, которое соответствует Организации
		Свойство_Организация = "organizationGuid"; 
		
		//СоответствиеОбъектаИСвойства - если Организация в объекте <> organizationGuid
		СоответствиеОбъектаИСвойства = Новый Соответствие;
		СоответствиеОбъектаИСвойства.Вставить("Справочники.БанковскиеСчетаОрганизаций","OwnerGuid");
		Свойство_Исключение = СоответствиеОбъектаИСвойства.Получить(сТип.Менеджер);
		Если ЗначениеЗаполнено(Свойство_Исключение) Тогда
			Свойство_Организация = Свойство_Исключение; 	
		КонецЕсли;
		
		//3. Получаем настройки для Организации-филиала (Организации из УПП)
		//НАЧАЛО Качикина 12.01.2026 Выполнение задач №000056322
		//Если СвойстваОбъект_XDTO.Получить(Свойство_Организация) <> Неопределено Тогда
		Если СвойстваОбъект_XDTO.Получить(Свойство_Организация) <> Неопределено 
			И Объект_XDTO[Свойство_Организация] <> Неопределено Тогда
		//КОНЕЦ Качикина 12.01.2026 Выполнение задач №000056322
			
			ОрганизацияИсточник =  Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Объект_XDTO[Свойство_Организация]));
			
			НастройкиЗагрузкиДанныхВЕРП =  РегистрыСведений.тн_НастройкиЗагрузкиДанныхВЕРП.НастройкиЗагрузкиДанныхВЕРП(ОрганизацияИсточник); 
			
			Если НастройкиЗагрузкиДанныхВЕРП <> Неопределено Тогда
				
				//4. Подмена Организации на Головную организацию
				// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056618
				//Если ЗначениеЗаполнено(НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация)
				//	И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <> Дата(1,1,1)
				//	И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <= ДатаПодмены  Тогда 
				//НАЧАЛО Качикина 09.02.2026 Выполнение задач №000056689
				//ЗаданыНастройкиЗагрузкиДанныхВЕРП = ЗначениеЗаполнено(НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация)
				//И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <> Дата(1,1,1)
				//И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <= ДатаПодмены; 
				ЗаданыНастройкиЗагрузкиДанныхВЕРП = РегистрыСведений.тн_НастройкиЗагрузкиДанныхВЕРП.ЗаданыНастройкиЗагрузкиДанныхВЕРП(НастройкиЗагрузкиДанныхВЕРП, ДатаПодмены);
				//КОНЕЦ Качикина 09.02.2026 Выполнение задач №000056689
				Если ЗаданыНастройкиЗагрузкиДанныхВЕРП Тогда				
				// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056618
					
					//запомним организацию-источник
					Результат.НастройкиЗагрузкиДанныхВЕРП.Вставить("ОрганизацияИсточник", ОрганизацияИсточник);
					//подменяем филиал на головную организацию
					Объект_XDTO[Свойство_Организация] = Строка(НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация.УникальныйИдентификатор()); 
					
					// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056618	
					#Область Старый_код  
					// КонецЕсли;
					//// НАЧАЛО Юдина Екатерина 06.10.2025 Выполнение задач №000055376   
					//Свойство_Договор = "contractGuid"; 
					//Если СвойстваОбъект_XDTO.Получить(Свойство_Договор) <> Неопределено
					//	//НАЧАЛО Качикина 12.01.2026 Выполнение задач №000056322 
