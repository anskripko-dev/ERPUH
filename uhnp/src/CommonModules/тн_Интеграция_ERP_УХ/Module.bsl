Процедура ПодменитьДоговорПриЗагрузкеДанных(Объект_XDTO, КэшДоговоров, Свойство_Договор) 
	
	ДоговорИсточникГУИД = Объект_XDTO[Свойство_Договор];
	ДоговорГоловнойОрганизацииГУИД = КэшДоговоров.Получить(ДоговорИсточникГУИД);
	Если ЗначениеЗаполнено(ДоговорГоловнойОрганизацииГУИД) Тогда 
		Объект_XDTO[Свойство_Договор] = ДоговорГоловнойОрганизацииГУИД;	
	Иначе
		ДоговорИсточник = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ДоговорИсточникГУИД));								
		Выборка = РегистрыСведений.тн_ДублиДоговоровФилиала.Выбрать(Новый Структура("ДоговорФилиала", ДоговорИсточник));				
		Если Выборка.Следующий() 
			И ЗначениеЗаполнено(Выборка.ДоговорГоловнойОрганизации) Тогда 
			Объект_XDTO[Свойство_Договор] = Строка(Выборка.ДоговорГоловнойОрганизации.УникальныйИдентификатор());
			КэшДоговоров.Вставить(ДоговорИсточникГУИД, Объект_XDTO[Свойство_Договор]); 
		КонецЕсли;
	КонецЕсли;
	
