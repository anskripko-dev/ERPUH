// НАЧАЛО Белоконенко Денис 24.08.2022 Выполнение задач №000042360
Функция ПолучитьОрганизацияПоИНН_КПП(ИНН, КПП, ИскатьТолькоПоИНН = Истина) Экспорт
// КОНЕЦ Белоконенко Денис 24.08.2022 Выполнение задач №000042360
	ПустаяСсылка = Справочники.Организации.ПустаяСсылка();
	
	// НАЧАЛО Белоконенко Денис 24.08.2022 Выполнение задач №000042360
	Если ИскатьТолькоПоИНН И Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат ПустаяСсылка;
	ИначеЕсли Не ИскатьТолькоПоИНН И Не ЗначениеЗаполнено(ИНН) И Не ЗначениеЗаполнено(КПП) Тогда
	// КОНЕЦ Белоконенко Денис 24.08.2022 Выполнение задач №000042360
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|	И Организации.КПП = &КПП
	|	И НЕ Организации.ПометкаУдаления";
	
	// НАЧАЛО Белоконенко Денис 24.08.2022 Выполнение задач №000042360
	Если ИскатьТолькоПоИНН Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Организации.КПП = &КПП", "");
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 24.08.2022 Выполнение задач №000042360
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат ПустаяСсылка;
	КонецЕсли;
	
КонецФункции

// Юдина Екатерина 20.01.2026 Выполнение задач №000056454 +УчитыватьРегНомер
////Сафиуллина З.Р. 10.02.2025 Выполнение задач №000052471: изм. значение по умолчанию параметра ТипДоговора
////// НАЧАЛО Белоконенко Денис 01.11.2022 Выполнение задач №000043186
//////// Белоконенко Денис 02.06.2022 Выполнение задач №000041465
//////Функция ПолучитьКонтрагентПоИНН_КПП(ИНН, КПП) Экспорт
////Функция ПолучитьКонтрагентПоИНН_КПП(ИНН, КПП, ТипДоговора) Экспорт
////// КОНЕЦ Белоконенко Денис 01.11.2022 Выполнение задач №000043186	
//Функция ПолучитьКонтрагентПоИНН_КПП(ИНН, КПП, ТипДоговора = Неопределено) Экспорт
Функция ПолучитьКонтрагентПоИНН_КПП(ИНН, КПП, ТипДоговора = Неопределено, УчитыватьРегНомер = Ложь) Экспорт
	
	ПустаяСсылка = Справочники.Контрагенты.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ИНН) И Не ЗначениеЗаполнено(КПП) Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.Текст = 
	// НАЧАЛО Белоконенко Денис 01.11.2022 Выполнение задач №000043186
	//"ВЫБРАТЬ
	//|	Контрагенты.Ссылка КАК Ссылка
	//|ИЗ
	//|	Справочник.Контрагенты КАК Контрагенты
	//|ГДЕ
	//|	Контрагенты.ИНН = &ИНН
	//|	И Контрагенты.КПП = &КПП
	//|	И НЕ Контрагенты.ПометкаУдаления";	
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|		ПО Контрагенты.Партнер = Партнеры.Ссылка
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И &УсловиеПартнера";
	
	Если ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПартнера", "Партнеры.Клиент");
		//НАЧАЛО Сафиуллина З.Р. 10.02.2025 Выполнение задач №000052471
	ИначеЕсли ТипДоговора = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПартнера", "Истина");
		//КОНЕЦ Сафиуллина З.Р. 10.02.2025 Выполнение задач №000052471	
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПартнера", "Партнеры.Поставщик");
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 01.11.2022 Выполнение задач №000043186
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		// НАЧАЛО Юдина Екатерина 20.01.2026 Выполнение задач №000056454 
		//Возврат Выборка.Ссылка;     
		Контрагент = Выборка.Ссылка;	
		// КОНЕЦ Юдина Екатерина 20.01.2026 Выполнение задач №000056454 
	Иначе     
		// НАЧАЛО Юдина Екатерина 20.01.2026 Выполнение задач №000056454 
		Контрагент = ПустаяСсылка;	
		//Возврат ПустаяСсылка; 
		// КОНЕЦ Юдина Екатерина 20.01.2026 Выполнение задач №000056454 
	КонецЕсли;  
	
	// НАЧАЛО Юдина Екатерина 20.01.2026 Выполнение задач №000056454   
	Если Не ЗначениеЗаполнено(Контрагент)
		И Не ЗначениеЗаполнено(КПП)
		И УчитыватьРегНомер Тогда   
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И Контрагенты.КПП = &КПП","");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"Контрагенты.ИНН = &ИНН","Контрагенты.РегистрационныйНомер = &ИНН");
				
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Контрагент = Выборка.Ссылка;	
		КонецЕсли;  
		
	КонецЕсли; 
	
	Возврат Контрагент;
	// КОНЕЦ Юдина Екатерина 20.01.2026 Выполнение задач №000056454 
	
КонецФункции

