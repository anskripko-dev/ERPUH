			ДатыСТипомDate.Добавить(НРег(Свойство.Имя))
	КонецЕсли;
	КонецЦикла;
	//КОНЕЦ Блинова М.А. 26.08.2025 Выполнение задач №000054919
	
	// НАЧАЛО Юдина Екатерина 23.01.2026 Выполнение задач №000056511 
	СоответствиеОбъектаИКлючаПроверки = Новый Соответствие;
