 
// Хохлов Владимир 13.08.2020 ВЗ №000035546
Функция ДобавитьЗаголовокСообщенияJSON(ТекстСообщенияJSON, tn_message_format)
	// НАЧАЛО Белоконенко Денис 29.11.2021 Выполнение задач №000039663
	Если СтрНайти(ТекстСообщенияJSON, "#ns") > 0 и СтрНайти(ТекстСообщенияJSON, "#type") > 0 и
		СтрНайти(ТекстСообщенияJSON, "#value") > 0 тогда
		Возврат ТекстСообщенияJSON;
	КонецЕсли;			
	// КОНЕЦ Белоконенко Денис 29.11.2021 Выполнение задач №000039663
	Если СтрНайти(tn_message_format, "integrationTicket") > 0 Тогда
		URIПростанстваИмен = "tn_IntegrationTicket";
	// НАЧАЛО Белоконенко Денис 29.11.2021 Выполнение задач №000039663
	// НАЧАЛО Белоконенко Денис 03.08.2022 Выполнение задач №000042167
	ИначеЕсли СтрНайти(tn_message_format, "portalto1c") > 0 Тогда
	// КОНЕЦ Белоконенко Денис 03.08.2022 Выполнение задач №000042167	
		URIПростанстваИмен = "tn_Integration_Portal";
		tn_message_format = "listObject";
	// КОНЕЦ Белоконенко Денис 29.11.2021 Выполнение задач №000039663
	// НАЧАЛО Белоконенко Денис 29.11.2021 Выполнение задач №000039664
	// НАЧАЛО Белоконенко Денис 03.08.2022 Выполнение задач №000042167
	ИначеЕсли СтрНайти(tn_message_format, "finappto1c") > 0 Тогда
	// КОНЕЦ Белоконенко Денис 03.08.2022 Выполнение задач №000042167	
		URIПростанстваИмен = "tn_Integration_FinApp";
		tn_message_format = "listObject";
	// КОНЕЦ Белоконенко Денис 29.11.2021 Выполнение задач №000039664
	
	//НАЧАЛО Одинец Роман 14.02.2025 Выполнение задач №000048970
	ИначеЕсли СтрНайти(tn_message_format, "1cTo1c_") > 0 Тогда

		tn_message_format = СтрЗаменить(tn_message_format, "1cTo1c_", "");		
			
		Если Не ТН_ИнтеграцияПовтИсп.ПолучитьТипОбъектаXDTOПоИмени("tn_RTU", tn_message_format) = Неопределено Тогда
			URIПростанстваИмен = "tn_RTU";			
		Иначе     
			URIПростанстваИмен = "tn_ExchangeBetweenCentralizedIS";			      					
		КонецЕсли;
	// КОНЕЦ Одинец Роман 14.02.2025 Выполнение задач №000048970
	
	КонецЕсли; 
	
	Возврат "{
			|""#ns"": """ + URIПростанстваИмен + """,
			|""#type"": """ + tn_message_format + """,
			|""#value"": 
			|" + ТекстСообщенияJSON + "
			|}";
КонецФункции

// Борисенко И.Н. 27.08.2020 Выполнение задач №000035594
Функция ЗаписатьЛогРаботы(ВидЛога, ДанныеДляЛогирования, ОбъектЛогирования, Событие = "")
	
	ВидСообщения					= ДанныеДляЛогирования.ВидСообщения; 
	УникальныйИдентификаторЗапроса	= ДанныеДляЛогирования.ИдентификаторЗапроса;
	ИдентификаторИсточникаВызова	= ДанныеДляЛогирования.ИдентификаторИсточникаВызова;
	ВидИнтеграции					= ДанныеДляЛогирования.ВидИнтеграции;
	// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	Если ДанныеДляЛогирования.Свойство("БазаРеспондентИД") Тогда
		БазаРеспондентИД				= ДанныеДляЛогирования.БазаРеспондентИД;
	Иначе
		БазаРеспондентИД				= "";
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	// НАЧАЛО Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	Если ДанныеДляЛогирования.Свойство("ИДСообщения") Тогда
		ИДСообщения	= ДанныеДляЛогирования.ИДСообщения;
	Иначе
		ИДСообщения	= "";
	КонецЕсли;
    // КОНЕЦ Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	
	Если (ОбъектЛогирования <> Неопределено) 
	   И ЗначениеЗаполнено(ИдентификаторИсточникаВызова) Тогда 
	   		
		ТекстЛога = Строка(ИдентификаторИсточникаВызова) + Символы.ПС + Строка(ОбъектЛогирования);
		
	Иначе 
		
		ТекстЛога = ОбъектЛогирования;
		
	КонецЕсли;	
	
	Если ВидЛога = "Запрос" Тогда 
		
		Если ДанныеДляЛогирования.ВестиЛоги Тогда
				
			// НАЧАЛО Чекордина Ирина 10.12.2025 Выполнение задач №000056084
			//// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
			//РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогСообщенияВходящего(ВидИнтеграции, УникальныйИдентификаторЗапроса, ТекстЛога, ВидСообщения, Событие, , БазаРеспондентИД);
			//// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
			РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогСообщенияВходящего(ВидИнтеграции, УникальныйИдентификаторЗапроса, ТекстЛога, ВидСообщения, Событие, , БазаРеспондентИД, ИДСообщения);
			// КОНЕЦ Чекордина Ирина 10.12.2025 Выполнение задач №000056084
			
		КонецЕсли;  
			
	ИначеЕсли ВидЛога = "Ответ" Тогда 
		
		Если ДанныеДляЛогирования.ВестиЛоги Тогда
	
			// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
			РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогСообщенияИсходящего(ВидИнтеграции, УникальныйИдентификаторЗапроса, ТекстЛога, ВидСообщения, Событие, , БазаРеспондентИД);
			// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384

		КонецЕсли; 
			
	ИначеЕсли ВидЛога = "Ошибка" Тогда 
										
		// НАЧАЛО Чекордина Ирина 10.12.2025 Выполнение задач №000056084
		//// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
		//РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ВидИнтеграции, УникальныйИдентификаторЗапроса, Перечисления.тн_ВидыСобытийИнтеграции.Ошибка, ТекстЛога, ВидСообщения, БазаРеспондентИД);								
		//// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
		РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ВидИнтеграции, УникальныйИдентификаторЗапроса, Перечисления.тн_ВидыСобытийИнтеграции.Ошибка, ТекстЛога, ВидСообщения, БазаРеспондентИД, ИДСообщения);								
		// КОНЕЦ Чекордина Ирина 10.12.2025 Выполнение задач №000056084
		
	КонецЕсли;	
				
КонецФункции

// Борисенко И.Н. 27.08.2020 Выполнение задач №000035594
Функция ПолучитьДанныеДляЛогирования(ВидСообщения = "", АдресЭлектроннойПочтыДляУведомленияОбОшибках = "", ИДИсточника = "", ВестиЛоги = Ложь)
	
	ДанныеДляЛогирования = Новый Структура;
	ДанныеДляЛогирования.Вставить("ВидСообщения", 									ВидСообщения);
	ДанныеДляЛогирования.Вставить("ИдентификаторЗапроса", 							Новый УникальныйИдентификатор);
	ДанныеДляЛогирования.Вставить("АдресЭлектроннойПочтыДляУведомленияОбОшибках",	АдресЭлектроннойПочтыДляУведомленияОбОшибках);
	ДанныеДляЛогирования.Вставить("ИдентификаторИсточникаВызова", 					ИДИсточника);
	ДанныеДляЛогирования.Вставить("ВестиЛоги", 										ВестиЛоги);
	ДанныеДляЛогирования.Вставить("ВидИнтеграции",									Перечисления.тн_ВидыИнтеграций.ERP_УХ_Получение);
	// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	ДанныеДляЛогирования.Вставить("БазаРеспондентИД", 								"");
	// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	// НАЧАЛО Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	ДанныеДляЛогирования.Вставить("ИДСообщения", 									"");
	// КОНЕЦ Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	
	Возврат ДанныеДляЛогирования;
	
КонецФункции

// Борисенко И.Н. 27.08.2020 Выполнение задач №000035594
Функция ПрочитатьСообщениеJSON(ТекстСообщенияJSON, ДанныеДляЛогирования, Отказ, ОписаниеОшибки)
	
	СообщениеXDTO = Неопределено;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстСообщенияJSON);
	
	Попытка
		СообщениеXDTO = ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON);
	Исключение  
		ОписаниеОшибки = "Ошибка при преобразовании содержимого ответа в ОбъектJSON:" + ОписаниеОшибки();  
		Отказ = Истина;
	КонецПопытки;
	
	Возврат СообщениеXDTO;
	
КонецФункции

// Борисенко Игорь 19.08.2024 Выполнение задач №000050564
Процедура ПометитьНаУдалениеНеАктуальныеОбъекты(СообщениеXDTO, ТекстСообщенияJSON, ДанныеДляЛогирования, БазаРеспондентИД)
	
	тз = ТЗ_ЗагружаемыеТипы(,БазаРеспондентИД);
	ДанныеДляЛогирования.ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.markForDeletion;

	ТегXDTO = "markForDeletion";
	Для Каждого Объект_XDTO Из СообщениеXDTO[ТегXDTO] Цикл 
		
		Для каждого сТип Из тз Цикл
			СтрокаПоиска = """" + сТип.ТегXDTO + """";
			Если СтрНайти(ТекстСообщенияJSON,СтрокаПоиска) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрНайти(сТип.ПредставлениеТипа, "Док") = 0 Тогда
				Продолжить; //только для документов
			КонецЕсли;
			

			Результат = Новый Структура("Успех,ОписаниеОшибки", Истина, "");
			Объект = ПолучитьОбъект(Объект_XDTO, сТип, Результат);
			Если НЕ Результат.Успех ИЛИ Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			//Устанавливаем пометку удаления
			Попытка
				
				Если Объект.Проведен Тогда
					Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				
				Объект.УстановитьПометкуУдаления(Истина);
				
			Исключение
				
				//НАЧАЛО Качикина 21.12.2025 Выполнение задач №000056120
				//ЗарегистрироватьОшибкуПроведения(Объект, сТип, СообщениеXDTO.headers.messageGUID, ОписаниеОшибки());
				ЗарегистрироватьОшибкуПроведения(Объект, сТип, СообщениеXDTO.headers.messageGUID, 
								ОписаниеОшибки(), , Перечисления.тн_ТипыОшибокОбмена.ОшибкаРаспроведенияПометкиНаУдаление);
				//КОНЕЦ Качикина 21.12.2025 Выполнение задач №000056120
				
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Не удалось записать  Объект "+сТип.Менеджер+": """ + Строка(Объект) + """: " + ОписаниеОшибки() + Символы.ПС;
				
			КонецПопытки;
			
			Если Результат.Успех Тогда
				ЗаписатьЛогРаботы("Ответ", ДанныеДляЛогирования, "Объекты типа: "+сТип.ПредставлениеТипа+" успешно обработаны", Перечисления.тн_ВидыСобытийИнтеграции.ОбработкаЗавершена);
				
				//ОтправитьIntegrationTicket(СообщениеXDTO, ТекстСообщенияJSON, Параметры);
				
			Иначе
				Отказ = Истина;
				
				ОписаниеОшибки = "Ошибка получения объектов типа "+сТип.ПредставлениеТипа+" описание ошибки: " + Символы.ПС + Результат.ОписаниеОшибки;		
				ЗаписатьЛогРаботы("Ошибка", ДанныеДляЛогирования, ОписаниеОшибки);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Юдина Екатерина 04.12.2025 Выполнение задач №000056033 +СтруктураПоиска  
//// Борисенко И.Н. 27.08.2020 Выполнение задач №000035594
//// НАЧАЛО Борисенко Игорь 30.03.2022 Выполнение задач №000040817
//// НАЧАЛО Белоконенко Денис 18.04.2023 Выполнение задач №000045229
////Процедура ПолучениеСообщенийRMQ(ТекстСообщенияJSON, СвойстваСообщения, ПодпискаНаОчередь = Неопределено, Отказ = Ложь, ВернутьВОчередь = Ложь, ОбработкаСообщенияRMQИзПромежуточногоРегистра = Ложь) Экспорт
//Процедура ПолучениеСообщенийRMQ(ТекстСообщенияJSON, СвойстваСообщения, ПодпискаНаОчередь = Неопределено, Отказ = Ложь, ВернутьВОчередь = Ложь, ОбработкаСообщенияRMQИзПромежуточногоРегистра = Ложь, ВерсияСообщения = Неопределено) Экспорт
Процедура ПолучениеСообщенийRMQ(ТекстСообщенияJSON, СвойстваСообщения, ПодпискаНаОчередь = Неопределено, Отказ = Ложь, ВернутьВОчередь = Ложь, ОбработкаСообщенияRMQИзПромежуточногоРегистра = Ложь, ВерсияСообщения = Неопределено, СтруктураПоиска = Неопределено) Экспорт
// КОНЕЦ Белоконенко Денис 18.04.2023 Выполнение задач №000045229
// КОНЕЦ Борисенко Игорь 30.03.2022 Выполнение задач №000040817
	
	Профиль = Справочники.тн_ПрофилиПодключений.ERP_УХ;
		
	// НАЧАЛО Борисенко Игорь 26.10.2021 Выполнение задач №000039141
	Параметры =	ВернутьПараметрыОбмена();
	// КОНЕЦ Борисенко Игорь 26.10.2021 Выполнение задач №000039141
	Параметры.Вставить("Лог_ВидИнтеграции", Перечисления.тн_ВидыИнтеграций.ERP_УХ_Получение);
	ДанныеДляЛогирования = ПолучитьДанныеДляЛогирования(Параметры.Лог_ВидСообщения, , , Параметры.Профиль.ВестиЛоги);
	// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	ДанныеДляЛогирования_Заполнить_БазаРеспондентИД(ДанныеДляЛогирования, ТекстСообщенияJSON, СвойстваСообщения);
	// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384	
	Параметры.Вставить("ДанныеДляЛогирования", ДанныеДляЛогирования);

	// НАЧАЛО Борисенко Игорь 24.06.2022 Выполнение задач №000041435
	БазаРеспондентИД = ДанныеДляЛогирования.БазаРеспондентИД;
	// КОНЕЦ Борисенко Игорь 24.06.2022 Выполнение задач №000041435
	
	tn_message_format = ПолучитьФорматСообщения(СвойстваСообщения);
		
	Если tn_message_format <> Неопределено Тогда
		ТекстСообщенияJSON = ДобавитьЗаголовокСообщенияJSON(ТекстСообщенияJSON, tn_message_format);
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 29.11.2021 Выполнение задач №000039663	
		
	ОписаниеОшибки = "";
	СообщениеXDTO = ПрочитатьСообщениеJSON(ТекстСообщенияJSON, Параметры.ДанныеДляЛогирования, Отказ, ОписаниеОшибки);
	
	// НАЧАЛО Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	ИДСообщения = "";
	Если СообщениеXDTO <> Неопределено Тогда
		Попытка
			ИДСообщения = СообщениеXDTO.headers.messageGUID;    
		Исключение
		КонецПопытки;       
	КонецЕсли;
	ДанныеДляЛогирования.Вставить("ИДСообщения", ИДСообщения);
	Параметры.Вставить("ДанныеДляЛогирования", ДанныеДляЛогирования);
	// КОНЕЦ Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	
	ВернутьВОчередьПринудительно = Ложь;
	
	Если Не Отказ Тогда
		
		URIПространстваИмен = СообщениеXDTO.Тип().URIПространстваИмен;
		
		Если URIПространстваИмен = Метаданные.ПакетыXDTO.тн_Интеграция_ERP_УХ.ПространствоИмен Тогда
			//сообщение ERP
			
			// НАЧАЛО Борисенко Игорь 19.08.2024 Выполнение задач №000050564
			Если СтрНайти(ТекстСообщенияJSON,"markForDeletion") > 0 Тогда //Это пометка удаления неактуальных объектов
				ПометитьНаУдалениеНеАктуальныеОбъекты(СообщениеXDTO, ТекстСообщенияJSON, ДанныеДляЛогирования, БазаРеспондентИД);
				Возврат;
			КонецЕсли;
			// КОНЕЦ Борисенко Игорь 19.08.2024 Выполнение задач №000050564
			
			Если СтрНайти(ТекстСообщенияJSON,"reestr") > 0 Тогда //Это реестр сверки объектов
				СвормироватьРеестрСверкиЗагруженныхОбъектов(СообщениеXDTO, ТекстСообщенияJSON, Профиль);
				Возврат;
			КонецЕсли;
			
			// НАЧАЛО ГенатулинМА 03.11.21 Выполнение задачи №000039202
			Если СтрНайти(ТекстСообщенияJSON, "dataVerificationResponse") > 0 Тогда //Это сообщение Автосверки данных-ответ
				ОбработатьОтветноеСообщениеАвтосверки(СообщениеXDTO, ТекстСообщенияJSON, Профиль);
