	// КОНЕЦ Юдина Екатерина 22.10.2025 Выполнение задач №000055582 
	
	Возврат СтруктураРезультат;
	
КонецФункции     

// Юдина Екатерина 22.10.2025 Выполнение задач №000055582
//
Функция ПолучитьПрочиеДоходыРасходыИМ(Объект) Экспорт
	
	ПрочиеДоходыРасходы = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрочиеДоходыРасходы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПрочиеДоходыРасходы КАК ПрочиеДоходыРасходы
	|ГДЕ
	|	ПрочиеДоходыРасходы.тн_СвязанныйДокумент = &ДокументОснование
	|	И ПрочиеДоходыРасходы.Основание = &Основание";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);     
	Запрос.УстановитьПараметр("Основание", "Бонусные баллы по маркетинговым программам РТиУ");

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПрочиеДоходыРасходы = Выборка.Ссылка; 
	КонецЕсли;      
	
	Возврат ПрочиеДоходыРасходы;
	
КонецФункции

// Белоконенко Денис 30.10.2025 Выполнение задач №000055366
Функция ПолучитьСтруктуруДокументовКорректировкаРегистров(Объект)
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Объект", Объект);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкаРегистров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
	|ГДЕ
	|	КорректировкаРегистров.тн_СвязанныйДокумент = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектКорректировкаРегистров = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектКорректировкаРегистров.ТаблицаРегистров.Очистить();
	Иначе
		ОбъектКорректировкаРегистров = Документы.КорректировкаРегистров.СоздатьДокумент();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОбъектКорректировкаРегистров.Ссылка);
		Ссылка = МенеджерОбъекта.ПолучитьСсылку();
		ОбъектКорректировкаРегистров.УстановитьСсылкуНового(Ссылка);  
		ОбъектКорректировкаРегистров.тн_СвязанныйДокумент = Объект.Ссылка;
	КонецЕсли;
		
    ЗаполнитьЗначенияСвойств(ОбъектКорректировкаРегистров, Объект, ,"Номер, тн_СвязанныйДокумент, Организация");
	
	ОбъектКорректировкаРегистров.Операция 			= Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
	ОбъектКорректировкаРегистров.Ответственный 		= Пользователи.ТекущийПользователь(); 
	ОбъектКорректировкаРегистров.ПометкаУдаления 	= Не Объект.ДополнительныеСвойства.Posted;
	
	РегистрЗаписи = ОбъектКорректировкаРегистров.ТаблицаРегистров.Добавить();
	РегистрЗаписи.Имя = "ПрочиеДоходы";
	
	ОбъектКорректировкаРегистров.Записать();
	
	СтруктураРезультат.Вставить("ОбъектКорректировкаРегистров", ОбъектКорректировкаРегистров);
	ЗаписатьСвязанныеОбъекты(ОбъектКорректировкаРегистров, Объект);
	
	Возврат СтруктураРезультат;	
	
КонецФункции

 // Юдина (Гутарова) Екатерина 16.10.2024 Выполнение задач №000051189
//
Процедура ЗаписатьСвязанныеОбъекты(ДокументОбъект, Объект)  
	
	Если ДокументОбъект.Ссылка.Проведен
		И ДокументОбъект.ДополнительныеСвойства.Свойство("Posted")
		// НАЧАЛО Юдина Екатерина 25.05.2026 Выполнение задач №000057754 
		И Не Объект.ПометкаУдаления
		// КОНЕЦ Юдина Екатерина 25.05.2026 Выполнение задач №000057754
		И Не ДокументОбъект.ДополнительныеСвойства.Posted Тогда  
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
	ИначеЕсли Объект.ПометкаУдаления И Не ДокументОбъект.Ссылка.ПометкаУдаления  Тогда 
		Если ДокументОбъект.Ссылка.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокументОбъект.ПометкаУдаления = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры
	
