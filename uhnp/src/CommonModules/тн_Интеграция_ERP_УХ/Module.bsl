					Для Каждого Свойство Из  Объект_XDTO[КлЗн.Значение.Тег].string.ВладеющееСвойство.Тип.Свойства Цикл 
						Если Свойство.Тип.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema"	И Свойство.Тип.Имя = "date" Тогда
							ДатыСТипомDate.Добавить(НРег(Свойство.Имя))
						КонецЕсли;
					КонецЦикла;
					//КОНЕЦ Блинова М.А. 26.08.2025 Выполнение задач №000054919
					Для каждого сXDTO Из  Объект_XDTO[КлЗн.Значение.Тег].string Цикл
						с = ТЧ.Добавить();
						//НАЧАЛО Блинова М.А. 26.08.2025 Выполнение задач №000054919
						//ЗаполнитьОбъект(с, сXDTO, сТип, Результат, КлЗн.Ключ) 
