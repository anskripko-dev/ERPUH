	Сч = 0;
	
	Реестр = Новый ТаблицаЗначений;
	Реестр.Колонки.Добавить("guid");
	Реестр.Колонки.Добавить("type");
	Реестр.Колонки.Добавить("description");
	Реестр.Колонки.Добавить("posted");
	Реестр.Колонки.Добавить("Ссылка");
	Реестр.Колонки.Добавить("Ошибка");
	
	//Сверка реестра
	Для Каждого Объект_XDTO Из СообщениеXDTO[ТегXDTO] Цикл
		Сч = Сч + 1;
		
		СтрокаРеестр = Реестр.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРеестр, Объект_XDTO);
