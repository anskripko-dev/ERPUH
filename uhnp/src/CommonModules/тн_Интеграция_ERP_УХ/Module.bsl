//Качикина 06.10.2025 Выполнение задач №000055386
Процедура ВыполнитьДопДействияПослеЗаписи(Документ)
	
	Если  Документ.ОбменДанными.Загрузка = Истина
		И Документ.Проведен = Ложь
		И ТипЗнч(Документ) = Тип("ДокументОбъект.ОтчетБанкаПоОперациямЭквайринга") Тогда
		//документ должен записываться в РС РеестрДокументов
		//при ручной записи он туда попадает, но при обмене мы записываем в режиме ОбменДанными.Загрузка 
		
		
		//ОМ ПроведениеДокументов.ЗаписатьДокумент()
		Отказ = Ложь;
		Свойства = Неопределено;
		МенеджерДокумента = Документы[Документ.Метаданные().Имя];
		
		МеханизмыДокумента    = ПроведениеДокументов.УчетныеМеханизмыДокумента(МенеджерДокумента);
		МеханизмыКонфигурации = ПроведениеДокументов.УчетныеМеханизмыКонфигурации();
		
		ДвижимыеРегистры    = Новый Структура;
		Механизмы           = Новый СписокЗначений; 
		
		Для каждого Механизм Из МеханизмыДокумента Цикл 
			//нас интересует только РеестрДокументов, проверяем, двигает ли документ его
			Если Механизм = "РеестрДокументов" Тогда 
				МодульМеханизма = ОбщегоНазначения.ОбщийМодуль(МеханизмыКонфигурации[Механизм]);
				
				ПараметрыМеханизма = МодульМеханизма.ПараметрыДляПроведенияДокумента(Документ, Свойства);
				ПараметрыМеханизма.Вставить("МодульМеханизма", МодульМеханизма);
				
				Для каждого Регистр Из ПараметрыМеханизма.НезависимыеРегистры Цикл  
					Если Регистр.Имя = "РеестрДокументов" Тогда  				
						ДвижимыеРегистры.Вставить(Регистр.Имя);
					КонецЕсли;
				КонецЦикла;
				
				Механизмы.Добавить(ПараметрыМеханизма, Механизм); 
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Механизмы.СортироватьПоПредставлению();
		
		//ТаблицыДляДвижений = ПроведениеДокументов.ТаблицыДляДвижений()
		ТаблицыДляДвижений = МенеджерДокумента.ДанныеДокументаДляПроведения(Документ, ДвижимыеРегистры, Неопределено);
		
		МенеджерВременныхТаблиц = Неопределено;
		
		//ПроведениеДокументов.ЗаписатьДвиженияНезависимыхРегистров()
		Если ЗначениеЗаполнено(ТаблицыДляДвижений) Тогда
			Для Каждого Механизм Из Механизмы Цикл
				Если ЗначениеЗаполнено(Механизм.Значение.НезависимыеРегистры) Тогда
					Механизм.Значение.МодульМеханизма.ЗаписатьДанные(ТаблицыДляДвижений, Документ.Ссылка, МенеджерВременныхТаблиц, Отказ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

