// Борисенко И.Н. 25.10.2020 Выполнение задач №000035594   
//Блинова М.А. 26.08.2025 Выполнение задач №000054919
//Процедура ЗаполнитьЗначениеРеквизита(Объект, ИмяРеквизита, ЗначениеРеквизита)  
Процедура ЗаполнитьЗначениеРеквизита(Объект, ИмяРеквизита, ЗначениеРеквизита, ДатаБезВремени = Ложь)

	//Для справочников не все реквизиты заполняются для группы/элементов
	
	ТипЗначения = ТипЗнч(Объект);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	ЭтоСправочник = Метаданные.Справочники.Содержит(ОбъектМетаданных);
	Если ЭтоСправочник 
	// КОНЕЦ Борисенко Игорь 11.02.2022 Выполнение задач №000040356
		// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
		И СтрНайти(ТипЗнч(Объект), "Справочник табличная часть строка") = 0
		// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
		// НАЧАЛО Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		И ИмяРеквизита <> "Наименование" И ИмяРеквизита <> "Код" И ИмяРеквизита <> "Родитель" И ИмяРеквизита <> "Владелец" И ИмяРеквизита <> "ПометкаУдаления" Тогда
		// КОНЕЦ Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		
		Использование = Объект.Метаданные().Реквизиты[ИмяРеквизита].Использование;
		ИспользованиеРеквизита = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита;
		
		Если Объект.ЭтоГруппа 
			И (Использование = ИспользованиеРеквизита.ДляГруппы Или Использование = ИспользованиеРеквизита.ДляГруппыИЭлемента) Тогда
			
			// НАЧАЛО Борисенко И.Н. 05.04.2022 Выполнение задач №000040750
			Если ТипЗнч(Объект[ИмяРеквизита]) = Тип("Дата") Тогда
				//НАЧАЛО Блинова М.А. 26.08.2025 Выполнение задач №000054919
				//Объект[ИмяРеквизита] = ПолучитьДату(ЗначениеРеквизита); 
				Объект[ИмяРеквизита] = ПолучитьДату(ЗначениеРеквизита, ,ДатаБезВремени);
				//КОНЕЦ Блинова М.А. 26.08.2025 Выполнение задач №000054919
			Иначе
				Объект[ИмяРеквизита] = ЗначениеРеквизита;
			КонецЕсли;
			// КОНЕЦ Борисенко И.Н. 05.04.2022 Выполнение задач №000040750
			
		ИначеЕсли Не Объект.ЭтоГруппа 
			И (Использование = ИспользованиеРеквизита.ДляЭлемента Или Использование = ИспользованиеРеквизита.ДляГруппыИЭлемента) Тогда
			
			// НАЧАЛО Борисенко И.Н. 05.04.2022 Выполнение задач №000040750
			Если ТипЗнч(Объект[ИмяРеквизита]) = Тип("Дата") Тогда
				//НАЧАЛО Блинова М.А. 26.08.2025 Выполнение задач №000054919
				//Объект[ИмяРеквизита] = ПолучитьДату(ЗначениеРеквизита); 
				Объект[ИмяРеквизита] = ПолучитьДату(ЗначениеРеквизита, ,ДатаБезВремени);
				//КОНЕЦ Блинова М.А. 26.08.2025 Выполнение задач №000054919
			Иначе
				Объект[ИмяРеквизита] = ЗначениеРеквизита;
			КонецЕсли;
			// КОНЕЦ Борисенко И.Н. 05.04.2022 Выполнение задач №000040750
			
		Иначе
			//не заполняем
		КонецЕсли;
		
	Иначе //заполняем без условий
		
		// НАЧАЛО Борисенко И.Н. 16.01.2022 Выполнение задач №000039277
		Если ТипЗнч(Объект[ИмяРеквизита]) = Тип("Дата") Тогда
			//НАЧАЛО Блинова М.А. 26.08.2025 Выполнение задач №000054919
			//Объект[ИмяРеквизита] = ПолучитьДату(ЗначениеРеквизита); 
			Объект[ИмяРеквизита] = ПолучитьДату(ЗначениеРеквизита, , ДатаБезВремени);
			//КОНЕЦ Блинова М.А. 26.08.2025 Выполнение задач №000054919		
		Иначе
			Объект[ИмяРеквизита] = ЗначениеРеквизита;
		КонецЕсли;
		// КОНЕЦ Борисенко И.Н. 16.01.2022 Выполнение задач №000039277
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОбъект_(Guid, Менеджер, Иерархия=Ложь, isFolder=Ложь, ПроцедураПолученияОбъекта=Ложь, Результат=Неопределено, ДомПоля = Неопределено) Экспорт //Для вызова из других модулей
	
	Объект_XDTO = Новый Структура("guid, isFolder", Guid, isFolder);
	Если ДомПоля <> Неопределено Тогда
	   Для каждого КлЗн Из ДомПоля Цикл
	       Объект_XDTO.Вставить(КлЗн.Ключ, КлЗн.Значение); 
	   КонецЦикла;
	КонецЕсли;
	
	Возврат ПолучитьОбъект(Объект_XDTO
						, Новый Структура("Менеджер, Иерархия, ПроцедураПолученияОбъекта", Менеджер, Иерархия, ПроцедураПолученияОбъекта)
						, ?(Результат=Неопределено, Новый Структура("Успех, ОписаниеОшибки", Истина, ""), Результат));
	
КонецФункции
 
// НАЧАЛО Белоконенко Денис 18.04.2023 Выполнение задач №000045229
//Функция ПолучитьОбъект(Объект_XDTO, сТип, Результат, ИгнорироватьПроцедуруПолученияОбъекта = Ложь) Экспорт
Функция ПолучитьОбъект(Объект_XDTO, сТип, Результат, ИгнорироватьПроцедуруПолученияОбъекта = Ложь, ВерсияСообщения = Неопределено) Экспорт
// КОНЕЦ Белоконенко Денис 18.04.2023 Выполнение задач №000045229
	
	сУИД = Объект_XDTO.guid;
	
	// НАЧАЛО Борисенко Игорь 29.11.2023 Выполнение задач №000047646
	ДлинаУИД = 36;
	Если ЗначениеЗаполнено(сУИД) И СтрДлина(сУИД) <> ДлинаУИД Тогда
		сУИД = "00000000-0000-0000-0000-000000000000";
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 29.11.2023 Выполнение задач №000047646
	
	Если ЗначениеЗаполнено(сУИД) И сУИД <> "00000000-0000-0000-0000-000000000000" Тогда
		
		Попытка
			УИД = Новый УникальныйИдентификатор(сУИД);
		Исключение
			//если переданный ключ сообщения не является гуидом, не используем его в качестве ключа записи
			
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Переданный ключ "+сТип.Менеджер+" не является гуидом: """ + сУИД + """: " + ОписаниеОшибки() + Символы.ПС;
			Возврат Неопределено;
		КонецПопытки;
		
	Иначе
		//если переданный ключ сообщения не является гуидом, не используем его в качестве ключа записи
		
		Если сТип.Менеджер = "Справочники.УпаковкиЕдиницыИзмерения" Тогда
			//Борисенко И.Н., 12.07.2021: пропускаем: для строк с пустой ЕдИзмерения будет прописана ЕдХранения
		Иначе
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Переданный ключ "+сТип.Менеджер+" не является гуидом: """ + сУИД + """: " + Символы.ПС;
		КонецЕсли;
		
		Возврат Неопределено;
	КонецЕсли;
		
	Менеджер = Вычислить(сТип.Менеджер);	
	
	//НАЧАЛО Сафиуллина З.Р. 24.03.2026 Выполнение задач №000057135
	// НАЧАЛО Чекордина Ирина 15.05.2026 Выполнение задач №000057671
	//Если НЕ Результат.Свойство("НастройкиЗагрузкиДанныхВЕРП") Тогда
	Если Не ИгнорироватьПроцедуруПолученияОбъекта Тогда // если не повторный вызов из ММ объекта, когда подмена уже произведена
	// КОНЕЦ Чекордина Ирина 15.05.2026 Выполнение задач №000057671
	//КОНЕЦ Сафиуллина З.Р. 24.03.2026 Выполнение задач №000057135
		//НАЧАЛО Качикина 15.08.2025 Выполнение задач №000054730  
		Результат.Вставить("НастройкиЗагрузкиДанныхВЕРП", Новый Структура());
		ПодменитьОрганизациюПриЗагрузкеДанных(Объект_XDTO, сТип, Менеджер, УИД, Результат);
		//КОНЕЦ Качикина 15.08.2025 Выполнение задач №000054730
	//НАЧАЛО Сафиуллина З.Р. 24.03.2026 Выполнение задач №000057135
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 24.03.2026 Выполнение задач №000057135

	// НАЧАЛО Юдина Екатерина 31.01.2025 Выполнение задач №000052460 	
	Если ТипЗнч(сТип) = Тип("СтрокаТаблицыЗначений") 
		И сТип.Владелец().Колонки.Найти("ТегXDTO") <> Неопределено
		И сТип.ТегXDTO = "documentChangingParametersFixedAssets" 
		И Объект_XDTO.Свойства().Получить("operationType") <> Неопределено
		И Объект_XDTO.operationType = "ИзменениеСпособовОтраженияРасходовПоАмортизацииОС" Тогда	
		сТип.ПроцедураПолученияОбъекта = Ложь;
	КонецЕсли;
	// КОНЕЦ Юдина Екатерина 31.01.2025 Выполнение задач №000052460 	
	
	Если сТип.ПроцедураПолученияОбъекта И Не ИгнорироватьПроцедуруПолученияОбъекта Тогда
		Объект = Менеджер.ПолучитьОбъект(УИД, сТип, Объект_XDTO, Результат);
	Иначе	
		Ссылка = Менеджер.ПолучитьСсылку(УИД);
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	// НАЧАЛО Белоконенко Денис 18.04.2023 Выполнение задач №000045229
	Если Объект <> Неопределено Тогда
		ВозможностьЗаписи = РегистрыСведений.тн_ЗагруженныеОбъекты.ПроверитьВозможностьЗаписиОбъектаПоВерсии(Объект.Ссылка, ВерсияСообщения);
		Если Не ВозможностьЗаписи Тогда
			Возврат Неопределено; //Пропускаем объект	
		КонецЕсли;
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 18.04.2023 Выполнение задач №000045229
	
	// НАЧАЛО Белоконенко Денис 03.02.2025 Выполнение задач №000052504
	// НАЧАЛО Чекордина Ирина 14.04.2025 Выполнение задач №000053396
	//Если Результат.НастройкиЗаписиИсточникаОбъекта.ХранитьЗаписи Тогда		
	Если Результат.Свойство("НастройкиЗаписиИсточникаОбъекта") И Результат.НастройкиЗаписиИсточникаОбъекта.ХранитьЗаписи Тогда	
	// КОНЕЦ Чекордина Ирина 14.04.2025 Выполнение задач №000053396
	
		СтурктураЗначенийЗаписи = РегистрыСведений.тн_ИсточникиЗагруженныхОбъектов.ПолучитьСтурктуруЗначенийЗаписи();
			
		Если Объект <> Неопределено Тогда
			РегистрыСведений.тн_ИсточникиЗагруженныхОбъектов.ПроверкаЭлементаНаСоответствиеБазыИсточника(Объект.Ссылка, Результат.БазаРеспондентСсылка, СтурктураЗначенийЗаписи);
			
			Если СтурктураЗначенийЗаписи.ЗапретитьЗагрузку Тогда 					
				ОписаниеОшибки = сУИД + " Объект уже загружен с другой базы респондента: " + СтурктураЗначенийЗаписи.БазаРеспондентИсточник;
				
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ОписаниеОшибки + Символы.ПС;
				
				Возврат Неопределено; //Пропускаем объект 					
			КонецЕсли;
		Иначе // Новый объект, первая запись
			СтурктураЗначенийЗаписи.НужнаЗапись = Истина;	
		КонецЕсли;
		
		Результат.НастройкиЗаписиИсточникаОбъекта.Вставить("СтурктураЗначенийЗаписи", СтурктураЗначенийЗаписи);
	КонецЕсли;	
	// КОНЕЦ Белоконенко Денис 03.02.2025 Выполнение задач №000052504	
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 05.08.2024 Выполнение задач №000050408   
	Если ТипЗнч(сТип) = Тип("СтрокаТаблицыЗначений") 
		И сТип.Владелец().Колонки.Найти("ТегXDTO") <> Неопределено
		И сТип.ТегXDTO = "documentReceiptFromProcessor" 
		И сТип.Менеджер = "Документы.ОтчетПереработчика"
		И Объект_XDTO.notCreateReport = Истина Тогда  
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Не создаем документ ""Отчет переработчика"" т.к. notCreateReport = Истина" + Символы.ПС;
		
		Возврат Неопределено;            
	КонецЕсли;
	
	Если ТипЗнч(сТип) = Тип("СтрокаТаблицыЗначений") 
		И сТип.Владелец().Колонки.Найти("ТегXDTO") <> Неопределено
		И сТип.ТегXDTO = "documentReceiptFromProcessor" 
		И сТип.Менеджер = "Документы.ПоступлениеОтПереработчика"
		И Объект_XDTO.notCreateReceipt = Истина Тогда  
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Не создаем документ ""Поступление от переработчика"" т.к. notCreateReceipt = Истина" + Символы.ПС;
		
		Возврат Неопределено;            
	КонецЕсли;	
	// КОНЕЦ Юдина (Гутарова) Екатерина 05.08.2024 Выполнение задач №000050408
	
	// НАЧАЛО Гутарова Екатерина 06.08.2023 Выполнение задач №000046448
	Если ТипЗнч(сТип) = Тип("ТаблицаЗначений") 
		И сТип.Владелец().Колонки.Найти("ТегXDTO") <> Неопределено
		И сТип.ТегXDTO = "catalogNomenclatureWithCost" 
		И Объект = Неопределено Тогда  
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Номенклатура с гуидом """ + сУИД + """ не найдена в базе!" + Символы.ПС;
		
		Возврат Неопределено;            
	КонецЕсли;
	// КОНЕЦ Гутарова Екатерина 06.08.2023 Выполнение задач №000046448 
	
	// НАЧАЛО Князева Анна 13.03.2024 Выполнение задач №000048095 
	Если ТипЗнч(сТип) = Тип("СтрокаТаблицыЗначений")
		И сТип.Владелец().Колонки.Найти("ТегXDTO") <> Неопределено
		И сТип.ТегXDTO = "documentVacationReserves" 
		И "Док. " + Объект_XDTO.documentType <> сТип.ПредставлениеТипа Тогда
		
		Возврат Неопределено; 
		
	КонецЕсли;
	// КОНЕЦ Князева Анна 13.03.2024 Выполнение задач №000048095
	
	// НАЧАЛО Борисенко Игорь 19.08.2024 Выполнение задач №000050563
	//Номенклатуру с ТипНоменклатуры = Работа не переписываем
	ЭтоРабота = ТипЗнч(Объект) = Тип("СправочникОбъект.Номенклатура") И Не Объект.ЭтоГруппа И Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа;
	Если ЭтоРабота Тогда
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = СтрШаблон("%1 *** Номенклатура: %2 не была загружена, запрещено перезагружать номенклатуру с типом ""Работа""", Результат.ОписаниеОшибки, Объект);
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 19.08.2024 Выполнение задач №000050563
	
	Если Объект = Неопределено И (НЕ сТип.ПроцедураПолученияОбъекта Или ИгнорироватьПроцедуруПолученияОбъекта) Тогда
		Если СтрНайти(сТип.Менеджер, "Документы.")>0 Тогда
			Объект = Менеджер.СоздатьДокумент();
		ИначеЕсли сТип.Иерархия и НЕ сТип.ИерархияЭлементов И Объект_XDTO.Свойства().Получить("isFolder") <> Неопределено И Объект_XDTO.isFolder Тогда
			Объект = Менеджер.СоздатьГруппу();
		Иначе
			Объект = Менеджер.СоздатьЭлемент();
		КонецЕсли;
		Объект.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции 

Функция ПолучитьСсылкуРеквизита(с, Объект_XDTO, Объект, сТип, Результат)
	
	сУИД = Объект_XDTO[с.Тег];
	Менеджер = Вычислить(с.Менеджер);
	ЭтоРодитель = СтрНайти(с.Тег, "parentGuid")>0;
	
	Если ЗначениеЗаполнено(сУИД) И сУИД <> "00000000-0000-0000-0000-000000000000" Тогда
		
		Попытка
			УИД = Новый УникальныйИдентификатор(сУИД);
			
		Исключение
			//если переданный ключ сообщения не является гуидом, не используем его в качестве ключа записи
			
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Переданный ключ сообщения не является гуидом: """ + сУИД + """: " + ОписаниеОшибки() + Символы.ПС;
			Возврат Неопределено;
			
		КонецПопытки;
		
		Ссылка = Менеджер.ПолучитьСсылку(УИД);
		
		Если ЭтоРодитель Тогда
			
			Если Ссылка.Пустая() Тогда
				
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "***В справочнике: "+с.Менеджер+" Не удалось найти родителя для элемента: "+Объект.Наименование+" по УИД: """ + сУИД + """: " +Символы.ПС;
				Возврат Неопределено;
				
			Иначе
				
				Родитель = Ссылка.ПолучитьОбъект();
				
				Если Родитель = Неопределено Тогда
					
					Попытка
						
						Если Объект_XDTO.parentName<>"" И Объект_XDTO.parentName<>Неопределено Тогда
							
							Если сТип.ИерархияЭлементов Тогда
								Родитель = Менеджер.СоздатьЭлемент();
							Иначе
								Родитель = Менеджер.СоздатьГруппу();
							КонецЕсли;
							
							Родитель.УстановитьСсылкуНового(Ссылка);
							Родитель.Наименование = Объект_XDTO.parentName;
							Родитель.ОбменДанными.Загрузка = Истина;
							
							Попытка
								Родитель.Записать();
							Исключение
								Результат.Успех = Ложь;
								Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "***В справочнике: "+с.Менеджер+" Не удалось записать родителя: "+Объект_XDTO.parentName+" для элемента: "+Объект.Наименование+" по УИД: """ + сУИД + """: " +Символы.ПС;
								Возврат Неопределено;
							КонецПопытки;
							
							Возврат Родитель.Ссылка;
							
						Иначе
							Возврат Неопределено
						КонецЕсли;
						
					Исключение
						Возврат Неопределено
					КонецПопытки;
					
				Иначе
					Возврат Родитель.Ссылка;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Ссылка;
		
	КонецЕсли;
	
КонецФункции // ()

Процедура ПередПроведениемОбщая(Объект, сТип, Отказ, Результат)
	
	Если сТип.ПроцедураДоЗаполнения Тогда
		Выполнить(сТип.Менеджер+".ДозаполнитьОбъект(Объект, Отказ, Результат)");
	КонецЕсли;
	
	Если Объект.Метаданные().Реквизиты.Найти("Соглашение")<>Неопределено Тогда
		
		Если ТипЗнч(Объект.Соглашение) = Тип("СправочникСсылка.СоглашенияСКлиентами") И НЕ ЗначениеЗаполнено(Объект.Соглашение) Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			|	СоглашенияСКлиентами.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
			|ГДЕ
			|	СоглашенияСКлиентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСКлиентами.Действует)
			// НАЧАЛО Борисенко И.Н. 02.03.2021 Выполнение задач №000035594
			|	И СоглашенияСКлиентами.Контрагент = &Контрагент");
			// КОНЕЦ Борисенко И.Н. 02.03.2021 Выполнение задач №000035594
			Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Объект.Соглашение = Выборка.Ссылка;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.Соглашение) Тогда
				Объект.Заполнить(Объект.Соглашение);
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(Объект.Соглашение) = Тип("СправочникСсылка.СоглашенияСПоставщиками") И НЕ ЗначениеЗаполнено(Объект.Соглашение) Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			|	СоглашенияСПоставщиками.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СоглашенияСПоставщиками КАК СоглашенияСПоставщиками
			|ГДЕ
			|	СоглашенияСПоставщиками.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСПоставщиками.Действует)
			|	И СоглашенияСПоставщиками.Контрагент = &Контрагент");
			Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Объект.Соглашение = Выборка.Ссылка;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.Соглашение) Тогда
				Объект.Заполнить(Объект.Соглашение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.Метаданные().Реквизиты.Найти("ГруппаФинансовогоУчета")<>Неопределено Тогда
		
		Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
		
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			|	ГруппыФинансовогоУчетаРасчетов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ГруппыФинансовогоУчетаРасчетов КАК ГруппыФинансовогоУчетаРасчетов
			|ГДЕ
			|	ГруппыФинансовогоУчетаРасчетов.РасчетыСПоставщиками
			|	И ГруппыФинансовогоУчетаРасчетов.Наименование ПОДОБНО ""%базовая%""");
			Выборка = Запрос.Выполнить().Выбрать();
