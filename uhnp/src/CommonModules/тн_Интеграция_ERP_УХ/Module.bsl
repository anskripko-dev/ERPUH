		Если Параметры.Лог_ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена Тогда  
			
			Параметры.Лог_ВидСообщения                  = ПолучитьВидСообщенияЛогированияИзТекстаСообщения(ТекстСообщенияJSON);  
			Параметры.ДанныеДляЛогирования.ВидСообщения = Параметры.Лог_ВидСообщения;   
			
			// Запись нужна, чтобы в сообщении ошибки, которое заменит запись был отлогирован входящий пакет
			ЗаписатьЛогРаботы("Запрос", Параметры.ДанныеДляЛогирования, ТекстСообщенияJSON);	
			
		КонецЕсли;                    
		// КОНЕЦ Юдина Екатерина 14.05.2025 Выполнение задач №000053673
		
		ЗаписатьЛогРаботы("Ошибка", Параметры.ДанныеДляЛогирования, ОписаниеОшибки);
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 31.03.2022 Выполнение задач №000040817
	Если Не ОбработкаСообщенияRMQИзПромежуточногоРегистра Тогда
	// КОНЕЦ Борисенко Игорь 31.03.2022 Выполнение задач №000040817
	Если (Отказ И ПодпискаНаОчередь<>Неопределено И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПодпискаНаОчередь, "ВозвращатьСообщениеВОчередьПриОшибке")) Или ВернутьВОчередьПринудительно Тогда
		ВернутьВОчередь = Истина;
