// Борисенко Игорь 08.06.2022 Выполнение задач №000041384
Процедура ДанныеДляЛогирования_Заполнить_БазаРеспондентИД(ДанныеДляЛогирования, ТекстСообщенияJSON, СвойстваСообщения = Неопределено) Экспорт
	
	Если СвойстваСообщения <> Неопределено И ТипЗнч(СвойстваСообщения) = Тип("Структура") И СвойстваСообщения.Свойство("ИмяПриложения") Тогда
		
		ДанныеДляЛогирования.Вставить("БазаРеспондентИД", СвойстваСообщения.ИмяПриложения);
		
	Иначе //Получаем БазаРеспондентИД из текста сообщения
		
		поз_systemSender = СтрНайти(ТекстСообщенияJSON, """systemSender"": """);
		Если поз_systemSender > 0 Тогда
			смещениеИД = 17;
			длинаИД = 36;
			БазаРеспондентИД = Сред(ТекстСообщенияJSON, поз_systemSender + смещениеИД, длинаИД);

			ДанныеДляЛогирования.Вставить("БазаРеспондентИД", БазаРеспондентИД);
		КонецЕсли;
		
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 04.10.2022 Выполнение задач №000042800
	БазаРеспондент_Дополнить(ДанныеДляЛогирования);
	// КОНЕЦ Борисенко Игорь 04.10.2022 Выполнение задач №000042800
	
КонецПроцедуры

// Борисенко Игорь 04.10.2022 Выполнение задач №000042800
Процедура БазаРеспондент_Дополнить(ДанныеДляЛогирования) Экспорт
	
	Если ДанныеДляЛогирования.Свойство("БазаРеспондентИД") Тогда
		БазаРеспондентИД = ДанныеДляЛогирования.БазаРеспондентИД;
	Иначе
		ДанныеДляЛогирования.Вставить("БазаРеспондентСсылка", Неопределено);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БазаРеспондентИД", БазаРеспондентИД);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тн_ИДБазРеспондентов.Наименование КАК ИмяБазы,
	|	тн_ИДБазРеспондентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.тн_ИДБазРеспондентов КАК тн_ИДБазРеспондентов
	|ГДЕ
	|	тн_ИДБазРеспондентов.systemSender = &БазаРеспондентИД
	|	И НЕ тн_ИДБазРеспондентов.ПометкаУдаления";
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		ДанныеДляЛогирования.Вставить("БазаРеспондентИД", Выборка.ИмяБазы); //в читабельном виде
		ДанныеДляЛогирования.Вставить("БазаРеспондентСсылка", Выборка.Ссылка);
	Иначе
		ДанныеДляЛогирования.Вставить("БазаРеспондентИД", БазаРеспондентИД); //в цифровом виде (УИН)
		ДанныеДляЛогирования.Вставить("БазаРеспондентСсылка", Неопределено);
	КонецЕсли;
	
КонецПроцедуры

