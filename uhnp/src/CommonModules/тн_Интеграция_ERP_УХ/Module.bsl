		Если Не ЗначениеЗаполнено(ДокументПередачи) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Запрос.Текст =
		// НАЧАЛО Белоконенко Денис 10.06.2024 Выполнение задач №000049831
		//"ВЫБРАТЬ
		//|	ПартииТМЦВЭксплуатации.Ссылка КАК Ссылка
		//|ИЗ
		//|	Справочник.ПартииТМЦВЭксплуатации КАК ПартииТМЦВЭксплуатации
		//|ГДЕ
		//|	(ПартииТМЦВЭксплуатации.Документ = &ДокументПередачи
		//|				И ПартииТМЦВЭксплуатации.ФизическоеЛицо = &ФизическоеЛицо
		//|			ИЛИ ПартииТМЦВЭксплуатации.ИнвентарныйНомер = &ДокументПередачиНомер
		//|	)";  
		
		"ВЫБРАТЬ
		|	ТМЦВЭксплуатации.Партия КАК Ссылка
		|ИЗ
		|	РегистрНакопления.ТМЦВЭксплуатации КАК ТМЦВЭксплуатации
		|ГДЕ
		|	ТМЦВЭксплуатации.ФизическоеЛицо = &ФизическоеЛицо
		|	И ТМЦВЭксплуатации.Активность
		|	И ТМЦВЭксплуатации.Регистратор = &ДокументПередачи
		|	И ТМЦВЭксплуатации.Номенклатура = &Номенклатура";	
		
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		// КОНЕЦ Белоконенко Денис 10.06.2024 Выполнение задач №000049831
	КонецЕсли;
