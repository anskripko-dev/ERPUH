//Процедура ДобавитьЛогОчередиОжидания(ИДСообщения, ВидДокумента, ГУИД) Экспорт
Процедура ДобавитьЛогОчередиОжидания(ИДСообщения, ВидДокумента, ГУИД, БазаРеспондентИД = "") Экспорт	
	
	НаборЗаписей = РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.ИДСообщения.Установить(ИДСообщения); 
	// НАЧАЛО Белоконенко Денис 13.03.2025 Выполнение задач №000053020
	НаборЗаписей.Отбор.ГУИД.Установить(ГУИД);
	// КОНЕЦ Белоконенко Денис 13.03.2025 Выполнение задач №000053020	
	
	Запись = НаборЗаписей.Добавить();
	Запись.ВидДокумента = ВидДокумента;
	Запись.ИДСообщения  = ИДСообщения;
	Запись.ГУИД         = ГУИД;
	// НАЧАЛО Чекордина Ирина 30.12.2025 Выполнение задач №000056058
	Запись.БазаРеспондентИД = БазаРеспондентИД;
	// КОНЕЦ Чекордина Ирина 30.12.2025 Выполнение задач №000056058
	
	НаборЗаписей.Записать(Истина);
	
	// НАЧАЛО Белоконенко Денис 23.09.2025 Выполнение задач №000055225
	// После записи в очередь ожидания, снимаем статус в Работе, иначе зависает в этом статусе 
	РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.ИзменитьСтатус(ИДСообщения, Ложь);
