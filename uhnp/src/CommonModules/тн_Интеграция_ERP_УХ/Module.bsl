					Перечисления.тн_ВидыСобытийИнтеграции.ОбработкаЗавершена);
				// КОНЕЦ  Белоконенко Денис 29.11.2021 Выполнение задач №000039664
			Иначе
				// НАЧАЛО Борисенко Игорь 27.01.2024 Выполнение задач №000048249
				//ВернутьВОчередьПринудительно = Истина;			
				// КОНЕЦ Борисенко Игорь 27.01.2024 Выполнение задач №000048249
				ОписаниеОшибки = "Ошибка получения объектов. "+" Описание ошибки: " + Символы.ПС + Результат.ОписаниеОшибки;		
				// НАЧАЛО Белоконенко Денис 29.11.2021 Выполнение задач №000039664
				РегистрыСведений.тн_Интеграция_ЛогСообщений.ДобавитьЛогСообщенияВходящего(Параметры.ДанныеДляЛогирования.ВидИнтеграции,
					Параметры.ДанныеДляЛогирования.ИдентификаторЗапроса, 
					ТекстСообщенияJSON, 
					Параметры.ДанныеДляЛогирования.ВидСообщения, 
					Перечисления.тн_ВидыСобытийИнтеграции.Ошибка,
					ОписаниеОшибки);
				// КОНЕЦ  Белоконенко Денис 29.11.2021 Выполнение задач №000039664
			КонецЕсли;
			
			Параметры.ДанныеДляЛогирования.ВидИнтеграции = Перечисления.тн_ВидыИнтеграций.finApp_Отправка;
			Параметры.ДанныеДляЛогирования.ВидСообщения  = Перечисления.тн_ВидыСообщенийFinApp.responseAdvanceReport;
			//Отправка отметки "Сообщение доставлено"
			тн_ИнтеграцияFinAppPortal.ОтправитьОтветноеСообщениеFinAppPortal(СообщениеXDTO, ТекстСообщенияJSON, Параметры, Результат);
			
		// КОНЕЦ  Белоконенко Денис 29.11.2021 Выполнение задач №000039664
		
		// НАЧАЛО Одинец Роман 14.02.2025 Выполнение задач №000048970
		ИначеЕсли URIПространстваИмен = Метаданные.ПакетыXDTO.тн_ОбменМеждуЦИС.ПространствоИмен Тогда

			тн_ИнтеграцияОбменМеждуЦИС.ПолучениеСообщений(ТекстСообщенияJSON, СвойстваСообщения);
		// КОНЕЦ Одинец Роман 14.02.2025 Выполнение задач №000048970
		
		Иначе
			//неучтенный тип сообщения
			Отказ = Истина;
			// НАЧАЛО Борисенко Игорь 27.01.2024 Выполнение задач №000048249
			//ВернутьВОчередьПринудительно = Истина;
			// КОНЕЦ Борисенко Игорь 27.01.2024 Выполнение задач №000048249
			
			// НАЧАЛО Борисенко Игорь 06.09.2022 Выполнение задач №000042522
			ЗаписатьЛогРаботы("Ошибка", Параметры.ДанныеДляЛогирования, "Неучтенный формат сообщения. Общий модуль: тн_Интеграция_ERP_УХ.ПолучениеСообщенийRMQ(). Тип сообщения: " + URIПространстваИмен);
			// КОНЕЦ Борисенко Игорь 06.09.2022 Выполнение задач №000042522
			
		КонецЕсли;
	
	Иначе
		//не смогли прочитать сообщение
		Отказ = Истина;
		// НАЧАЛО Борисенко Игорь 27.01.2024 Выполнение задач №000048249
		//ВернутьВОчередьПринудительно = Истина;
		// КОНЕЦ Борисенко Игорь 27.01.2024 Выполнение задач №000048249
		
