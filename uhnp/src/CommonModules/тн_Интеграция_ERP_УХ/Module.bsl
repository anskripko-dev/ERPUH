//Функция ПолучитьДату(ЗначениеДаты) Экспорт
//	
//	Если ТипЗнч(ЗначениеДаты) = Тип("Строка")
//		И СтрНайти(ЗначениеДаты,"00Z") > 0
//		Тогда
//		// НАЧАЛО Борисенко Игорь 29.03.2022 Выполнение задач №000040750
//		УниверсальноеВремя = ДатаИзСтрокиUTC(ЗначениеДаты);
//		Возврат МестноеВремя(УниверсальноеВремя);
//		// КОНЕЦ Борисенко Игорь 29.03.2022 Выполнение задач №000040750
//	Иначе
//		Возврат ЗначениеДаты;
//	КонецЕсли;
//		
//КонецФункции
//Блинова М.А. 26.08.2025 Выполнение задач №000054919
//Функция ПолучитьДату(ЗначениеДаты, Смещение = NULL) Экспорт
Функция ПолучитьДату(ЗначениеДаты, Смещение = NULL, ДатаБезВремени = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеДаты) = Тип("Строка")
		И СтрНайти(ЗначениеДаты,"00Z") > 0
		Тогда
		
		УниверсальноеВремя = ДатаИзСтрокиUTC(ЗначениеДаты);
		
		Если Смещение = Неопределено Тогда
			
			//смещение по умолчанию (по часовому поясу сервера)
			Возврат МестноеВремя(УниверсальноеВремя);

		ИначеЕсли Смещение = Null Тогда
			
			//смещение неизвестно, оставляем дату без смещения
			Возврат УниверсальноеВремя;

		Иначе
			
			ЧасовойПояс = "GMT" + Смещение;
			Возврат МестноеВремя(УниверсальноеВремя, ЧасовойПояс);

		КонецЕсли;
		
	// НАЧАЛО Климов Антон 23.06.2023 Выполнение задач №000045946
	ИначеЕсли ТипЗнч(ЗначениеДаты) = Тип("Строка")
		И Не СтрНайти(ЗначениеДаты,"00Z") Тогда
		Возврат УниверсальноеВремя(ДатаИзСтрокиUTC(ЗначениеДаты));
	// КОНЕЦ  Климов Антон 23.06.2023 Выполнение задач №000045946
		
	Иначе   
	//НАЧАЛО Блинова М.А. 26.08.2025 Выполнение задач №000054919
		//надо проверять все приходящие даты без времени с типом date, чтоб они не смещались назад      
		Если НЕ ДатаБезВремени Тогда 
			//КОНЕЦ Блинова М.А. 26.08.2025 Выполнение задач №000054919
			Возврат УниверсальноеВремя(ЗначениеДаты); //ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON) преобразует часовой пояс дат в местое время по серверу --> возвращаем часовой пояс на место (обратно в универсальное время, т.к. даты передаются без смещения)
			//НАЧАЛО Блинова М.А. 26.08.2025 Выполнение задач №000054919
		Иначе 
			Возврат ЗначениеДаты;		
		КонецЕсли; 
	//КОНЕЦ Блинова М.А. 26.08.2025 Выполнение задач №000054919

	КонецЕсли;
		
КонецФункции
