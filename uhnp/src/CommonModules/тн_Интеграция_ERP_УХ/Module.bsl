//// Борисенко Игорь 07.03.2023 Выполнение задач №000044682
//Процедура УдалитьЗаписьОшибкиПроведенияДокументовПриЗагрузке(ДокументСсылка)
Процедура УдалитьЗаписьОшибкиПроведенияДокументовПриЗагрузке(ДокументСсылка, ВерсияСообщения = Неопределено)
	
	//НАЧАЛО Сафиуллина З.Р. 14.11.2025 Выполнение задач №000055693
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(ДокументСсылка);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если НЕ Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
    	Возврат;
	КонецЕсли;
	
	УдалитьОшибкуСтаройВерсииДокумента = Ложь;
	Если ВерсияСообщения <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	тн_ОшибкиПроведенияДокументовПриЗагрузке.ДокументСсылка КАК ДокументСсылка
			|ИЗ
			|	РегистрСведений.тн_ОшибкиПроведенияДокументовПриЗагрузке КАК тн_ОшибкиПроведенияДокументовПриЗагрузке
			|ГДЕ
			|	тн_ОшибкиПроведенияДокументовПриЗагрузке.ДокументСсылка = &ДокументСсылка
			|	И тн_ОшибкиПроведенияДокументовПриЗагрузке.УниверсальнаяДатаСообщения <> 0
			|	И тн_ОшибкиПроведенияДокументовПриЗагрузке.УниверсальнаяДатаСообщения < &ВерсияСообщения";
		
		Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		Запрос.УстановитьПараметр("ВерсияСообщения", ВерсияСообщения);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			УдалитьОшибкуСтаройВерсииДокумента = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	Если ВерсияСообщения = Неопределено ИЛИ УдалитьОшибкуСтаройВерсииДокумента Тогда
	//КОНЕЦ Сафиуллина З.Р. 14.11.2025 Выполнение задач №000055693
	
		Набор = РегистрыСведений.тн_ОшибкиПроведенияДокументовПриЗагрузке.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументСсылка.Установить(ДокументСсылка);
		Набор.Записать();                  
		
		// НАЧАЛО Юдина Екатерина 17.12.2025 Выполнение задач №000056166   
		Если ОбщегоНазначенияПовтИспУХ.ПолучитьЗначениеКонстанты("тн_ВключитьДополнительноеЛогированиеВЖурналРегистрации") Тогда 
			
			ЗаписьЖурналаРегистрации("Удаление ошибки проведения", УровеньЖурналаРегистрации.Информация, Метаданные.РегистрыСведений.тн_ОшибкиПроведенияДокументовПриЗагрузке,
			    ДокументСсылка, "тн_УдалитьЗаписьОшибкиПроведенияДокументовПриЗагрузке; Версия сообщения=" + Строка(ВерсияСообщения) + "; УдалитьОшибкуСтаройВерсииДокумента=" + Строка(УдалитьОшибкуСтаройВерсииДокумента));
			
		КонецЕсли;	
		// КОНЕЦ Юдина Екатерина 17.12.2025 Выполнение задач №000056166
		
	//НАЧАЛО Сафиуллина З.Р. 14.11.2025 Выполнение задач №000055693
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 14.11.2025 Выполнение задач №000055693
КонецПроцедуры

