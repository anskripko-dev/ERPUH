// Гутарова Екатерина 20.09.2023 Выполнение задач №000046925 
//
Процедура ПерезаполнитьАналитикуНоменклатуры(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлючиАналитикиУчетаНоменклатуры.Ссылка КАК Ссылка,
		|	КлючиАналитикиУчетаНоменклатуры.Наименование КАК Наименование,
		|	КлючиАналитикиУчетаНоменклатуры.Номенклатура.Наименование КАК Номенклатура,
		|	КлючиАналитикиУчетаНоменклатуры.Характеристика.Наименование КАК Характеристика,
		|	КлючиАналитикиУчетаНоменклатуры.Серия КАК Серия,
		|	КлючиАналитикиУчетаНоменклатуры.Назначение КАК Назначение,
		|	КлючиАналитикиУчетаНоменклатуры.СтатьяКалькуляции.Наименование КАК СтатьяКалькуляции,
		|	КлючиАналитикиУчетаНоменклатуры.МестоХранения КАК МестоХранения
		|ИЗ
		|	Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
		|ГДЕ
		|	КлючиАналитикиУчетаНоменклатуры.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если СтрНайти(Выборка.Наименование, Выборка.Номенклатура) > 0 Тогда
			Продолжить;
		КонецЕсли;	
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.Наименование =  СокрЛП(Выборка.Номенклатура) + "; " 
				+ ?(ЗначениеЗаполнено(Выборка.Характеристика), СокрЛП(Выборка.Характеристика) + "; ", "")
				+ ?(ЗначениеЗаполнено(Выборка.Серия), СокрЛП(Выборка.Серия) + "; ", "")
				+ ?(ЗначениеЗаполнено(Выборка.Назначение), СокрЛП(Выборка.Назначение) + "; ", "")
				+ ?(ЗначениеЗаполнено(Выборка.СтатьяКалькуляции), СокрЛП(Выборка.СтатьяКалькуляции) + "; ", "")
				+ СокрЛП(Выборка.МестоХранения);  
			
			Попытка
				СправочникОбъект.Записать();
			Исключение
					ТекстСообщения = СтрШаблон("Не удалось изменить наименование справочника ""Ключи аналитики учета номенклатуры"" по номенклатуре %1 по причине: %2",
					                         Номенклатура, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					                         УровеньЖурналаРегистрации.Ошибка,
					                         Метаданные.Справочники.КлючиАналитикиУчетаНоменклатуры,,
					                         ТекстСообщения);
			КонецПопытки;
			
	КонецЦикла;
	
КонецПроцедуры

