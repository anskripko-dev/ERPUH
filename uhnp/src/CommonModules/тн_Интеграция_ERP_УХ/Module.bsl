//Блинова М.А. 01.07.2024 Выполнение задач №000050014
Функция НайтиСсылкуСправочникаПоУИД(Знач УИД, Знач ВидДокумента = "", Путь = "") Экспорт
		
	// Проверяем все типы	
		Для Каждого Менеджер Из Справочники Цикл   
			Попытка                               
				
				Результат = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				Если Результат <> Неопределено 
					И ОбщегоНазначения.СсылкаСуществует(Результат) Тогда 
					Возврат Результат;	
				КонецЕсли;
				
			Исключение
			КонецПопытки;
		КонецЦикла;
			
	Возврат Неопределено;
		
КонецФункции // НайтиСсылкуПоУИД 
                                                                                 //КонецЕсли;

Функция НайтиСсылкуПоУИД(Знач УИД, Знач ВидДокумента = "", Путь = "") Экспорт
		
	Если (СтрНайти(НРег(ВидДокумента), НРег("СчетФактураПолученный")) <> 0  
		Или СтрНайти(НРег(ВидДокумента), НРег("СчетФактураВыданнный")))
				И СтрНайти(НРег(Путь), НРег("BaseDocumentGuid"))  <> 0 Тогда
		
		ВидДокумента = СтрЗаменить(ВидДокумента,"Документ.","");
		МассивТипов = Новый Массив;       
		
		Попытка                               
			Для Каждого Стр Из  Метаданные.Документы[ВидДокумента].ТабличныеЧасти.ДокументыОснования.Реквизиты.ДокументОснование.Тип.Типы() Цикл
				МассивТипов.Добавить(Стр);
			КонецЦикла;  
		Исключение 
			Для Каждого Стр Из  Метаданные.Документы[ВидДокумента].Реквизиты.ДокументОснование.Тип.Типы() Цикл
				МассивТипов.Добавить(Стр);
			КонецЦикла;  
		КонецПопытки;

		Для Каждого ТипДокумента Из МассивТипов Цикл   
			Попытка                               
				Результат = Документы[Метаданные.НайтиПоТипу(ТипДокумента).Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				Если Результат <> Неопределено 
					И ОбщегоНазначения.СсылкаСуществует(Результат) Тогда 
					Возврат Результат;	
				КонецЕсли;
				
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		// НАЧАЛО Борисенко Игорь 07.02.2025 Выполнение задач №000052580
		Если СтрНайти(НРег(ВидДокумента), НРег("СчетФактураПолученный")) <> 0 Тогда
			//Для СчетФактураПолученный основание м.б. ОтчетПереработчика, который был сформирован документом тн_ЕдиныйПолучениеУслугПоПереработке (можно найти по УИД); 
			//ОтчетПереработчика по УИД не найти
			
			ЕдиныйПолучениеУслугПоПереработке = Документы.тн_ЕдиныйПолучениеУслугПоПереработке.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
			Если ЕдиныйПолучениеУслугПоПереработке <> Неопределено 
				И ОбщегоНазначения.СсылкаСуществует(ЕдиныйПолучениеУслугПоПереработке) Тогда
				
				ОтчетПереработчика = Документы.тн_ЕдиныйПолучениеУслугПоПереработке.ВернутьОтчетПереработчика(ЕдиныйПолучениеУслугПоПереработке);
				Если ОтчетПереработчика <> Неопределено 
					И ОбщегоНазначения.СсылкаСуществует(ОтчетПереработчика) Тогда
					
					Возврат ОтчетПереработчика;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 07.02.2025 Выполнение задач №000052580
		
	Иначе
		// Проверяем все типы	
		Для Каждого Менеджер Из Документы Цикл   
			Попытка                               
				
				Результат = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				Если Результат <> Неопределено 
					И ОбщегоНазначения.СсылкаСуществует(Результат) Тогда 
					Возврат Результат;	
				КонецЕсли;
				
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		// НАЧАЛО Белоконенко Денис 13.03.2025 Выполнение задач №000053020
		//Поиск по справочникам
		РезультатПоСправочнику = НайтиСсылкуСправочникаПоУИД(УИД, ВидДокумента, Путь);
		Если РезультатПоСправочнику <> Неопределено Тогда
			Возврат РезультатПоСправочнику; 
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 13.03.2025 Выполнение задач №000053020		
		
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции // НайтиСсылкуПоУИД

