//Функция ПроверитьНаличиеСуществующихЗависимыхОбъектов(СообщениеXDTO,сТип)
Функция ПроверитьНаличиеСуществующихЗависимыхОбъектов(СообщениеXDTO, сТип, БазаРеспондентИД)	
	
	Результат = Новый Структура;
	// НАЧАЛО Белоконенко Денис 13.03.2025 Выполнение задач №000053020
	//Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Успех", Истина);
	// КОНЕЦ Белоконенко Денис 13.03.2025 Выполнение задач №000053020
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тн_Интеграция_НастройкиЗагрузкиЗависимыхОбъектов.ПутьКРеквизиту КАК ПутьКРеквизиту
	|ИЗ
	|	РегистрСведений.тн_Интеграция_НастройкиЗагрузкиЗависимыхОбъектов КАК тн_Интеграция_НастройкиЗагрузкиЗависимыхОбъектов
	|ГДЕ
	|	тн_Интеграция_НастройкиЗагрузкиЗависимыхОбъектов.ВидДокумента = &ВидДокумента";
	//НАЧАЛО Сафиуллина З.Р. 05.09.2025 Выполнение задач №000055027
	Если сТип.ТегXDTO = "documentSaleOfShippedGoods" Тогда
		ВидДокумента = "Документ.РеализацияОтгруженныхТоваров";
	Иначе
	//КОНЕЦ Сафиуллина З.Р. 05.09.2025 Выполнение задач №000055027
		ВидДокумента = СтрЗаменить(сТип.Менеджер, "Документы", "Документ");
	//НАЧАЛО Сафиуллина З.Р. 05.09.2025 Выполнение задач №000055027
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 05.09.2025 Выполнение задач №000055027	
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПутьКРеквизиту = Выборка.ПутьКРеквизиту;
		МассивРеквизитов = СтрРазделить(ПутьКРеквизиту,".",Ложь);
		Попытка   
			// НАЧАЛО Белоконенко Денис 13.03.2025 Выполнение задач №000053020
			Для Каждого ОбъектXDTO Из СообщениеXDTO[сТип.ТегXDTO] Цикл
			// КОНЕЦ Белоконенко Денис 13.03.2025 Выполнение задач №000053020
			//НАЧАЛО Сафиуллина З.Р. 26.11.2024 Выполнение задач №000051681
			//Если МассивРеквизитов.Количество() > 0 Тогда 
			Если МассивРеквизитов.Количество() > 1 Тогда
			//КОНЕЦ Сафиуллина З.Р. 26.11.2024 Выполнение задач №000051681
				// НАЧАЛО Белоконенко Денис 13.03.2025 Выполнение задач №000053020
				//СтрокаУИД = СообщениеXDTO[сТип.ТегXDTO][0];
				СтрокаУИД = ОбъектXDTO;
				// КОНЕЦ Белоконенко Денис 13.03.2025 Выполнение задач №000053020
				Для Индекс = 0 По МассивРеквизитов.Количество() - 1 Цикл	
					Если Индекс =  МассивРеквизитов.Количество() - 1 Тогда 
						Для Каждого Строка Из СтрокаУИД Цикл
							// НАЧАЛО Борисенко Игорь 13.01.2025 Выполнение задач №000052262
							Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка, МассивРеквизитов[Индекс]) Тогда
							// КОНЕЦ Борисенко Игорь 13.01.2025 Выполнение задач №000052262
							СтрокаПроверкиУИД = Строка[МассивРеквизитов[Индекс]];
							// НАЧАЛО Борисенко Игорь 13.01.2025 Выполнение задач №000052262
							Иначе
								СтрокаПроверкиУИД = Неопределено;
							КонецЕсли;
							// КОНЕЦ Борисенко Игорь 13.01.2025 Выполнение задач №000052262
							//НАЧАЛО Сафиуллина З.Р. 04.12.2024 Выполнение задач №000051681
							Если СтрокаПроверкиУИД = Неопределено  Тогда
								Продолжить;
							КонецЕсли;
							//КОНЕЦ Сафиуллина З.Р. 04.12.2024 Выполнение задач №000051681
							УИД = Новый УникальныйИдентификатор(СтрокаПроверкиУИД); 
							ВидДокументаОжидаемый = "";
							Если сТип.ТегXDTO = "documentFactureGiven" Тогда
								Если Строка.baseDocumentType = "РеализацияТоваровУслуг" Тогда
									ПроверяемыйДокумент = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(УИД);  
									ВидДокументаОжидаемый = "Документ.РеализацияТоваровУслуг";
									//НАЧАЛО Малахов В.С. 13.08.2025 Выполнение задач №000054772
									//Если Не ОбщегоНазначения.СсылкаСуществует(ПроверяемыйДокумент) Тогда
									Если Не ОбщегоНазначения.СсылкаСуществует(ПроверяемыйДокумент) или Общегоназначения.ЗначениеРеквизитаОбъекта(ПроверяемыйДокумент, "ПометкаУдаления") Тогда
									//КОНЕЦ Малахов В.С. 13.08.2025 Выполнение задач №000054772										
										//НАЧАЛО Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
										ПроверяемыйДокумент = Документы.РеализацияУслугПрочихАктивов.ПолучитьСсылку(УИД); //ВидДокументаОжидаемый менять не нужно, т.к. проверка загрузки проверяемого документа происходит по УникальныйИдентификатор!
										Если Не ОбщегоНазначения.СсылкаСуществует(ПроверяемыйДокумент) Тогда	
										//КОНЕЦ  Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
										
											//Возможно были услуги по нескольким подразделениям --> они передаются отдельными РТиУ со своими ГУИД
											НомерПодразделения = 0;
											ПрекратитьПоискРТиУ = Ложь;
											Пока Не ПрекратитьПоискРТиУ Цикл
												НомерПодразделения = НомерПодразделения + 1;
												ПостфиксУИД = тн_Интеграция_ERP_УХ.НомерДокумента11Символов("0000" + СтрЗаменить(Строка(НомерПодразделения),Символы.НПП,""),4);
												УИД_с_УчетомПодразделения = Новый УникальныйИдентификатор(Лев(СтрокаПроверкиУИД, 32) + ПостфиксУИД);
												ПроверяемыйДокумент = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(УИД_с_УчетомПодразделения);
												Если Не ОбщегоНазначения.СсылкаСуществует(ПроверяемыйДокумент) Тогда
													//НАЧАЛО Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
													//// НАЧАЛО Борисенко Игорь 23.12.2024 Выполнение задач №000052128
													////в РТиУ УПП м.б. заполнена тч Услуги, на основании которой сформирован док. РеализацияУслугПрочихАктивов с тем же УИД - его тоже нужно прикрепить к СчФ
													////РТиУ не был найден, поищем среди РеализацияУслугПрочихАктивов
													//ПроверяемыйДокумент = Документы.РеализацияУслугПрочихАктивов.ПолучитьСсылку(УИД);
													//Если ОбщегоНазначения.СсылкаСуществует(ПроверяемыйДокумент) Тогда
													//// КОНЕЦ Борисенко Игорь 23.12.2024 Выполнение задач №000052128
													//КОНЕЦ  Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
													ПрекратитьПоискРТиУ = Истина; 
													//НАЧАЛО Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
													//// НАЧАЛО Борисенко Игорь 23.12.2024 Выполнение задач №000052128
													//КонецЕсли;
													//// КОНЕЦ Борисенко Игорь 23.12.2024 Выполнение задач №000052128
													//КОНЕЦ  Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
												КонецЕсли;
											КонецЦикла;
											
										//НАЧАЛО Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
										КонецЕсли;
										//КОНЕЦ  Ведутенко С.А. 17.01.2025 Выполнение задач №000052307
											
									КонецЕсли;
									
								ИначеЕсли Строка.baseDocumentType = "КорректировкаРеализации" Тогда
									ПроверяемыйДокумент = Документы.КорректировкаРеализации.ПолучитьСсылку(УИД);
									ВидДокументаОжидаемый = "Документ.КорректировкаРеализации";
								ИначеЕсли Строка.baseDocumentType = "ПередачаОС" Тогда
									ПроверяемыйДокумент = Документы.РеализацияУслугПрочихАктивов.ПолучитьСсылку(УИД);  
									ВидДокументаОжидаемый = "Документ.РеализацияУслугПрочихАктивов";
								ИначеЕсли Строка.baseDocumentType = "ВозвратТоваровОтПокупателя" Тогда
									ПроверяемыйДокумент = Документы.ВозвратТоваровОтКлиента.ПолучитьСсылку(УИД);
									ВидДокументаОжидаемый = "Документ.ВозвратТоваровОтКлиента";
								Иначе 
									ПроверяемыйДокумент = НайтиСсылкуПоУИД(СтрокаПроверкиУИД, ВидДокумента, ПутьКРеквизиту); 
									//НАЧАЛО Блинова М.А. 05.07.2024 Выполнение задач №000050117
									ВидДокументаОжидаемый = "Документ." + Строка.baseDocumentType;
									//КОНЕЦ Блинова М.А. 05.07.2024 Выполнение задач №000050117
								КонецЕсли;
							//НАЧАЛО Блинова М.А. 01.07.2024 Выполнение задач №000050060
						    ИначеЕсли сТип.ТегXDTO = "documentPaymentIncoming" Или сТип.ТегXDTO = "documentPaymentWriting" Тогда 
							    //тут проверяем справочник 
								// НАЧАЛО Борисенко Игорь 30.05.2025 Выполнение задач №000053873
								//Если СтрокаПроверкиУИД <> "00000000-0000-0000-0000-000000000000", значит в платежке не должен быть заполнен договор, 
								//например, в операциях: ПереводНаДругойСчетВИнойВалюте, ВозвратНалогов
								
								ДолженБытьСвязанныйДоговор = ЗначениеЗаполнено(СтрокаПроверкиУИД) И СтрокаПроверкиУИД <> "00000000-0000-0000-0000-000000000000";
								Если ДолженБытьСвязанныйДоговор Тогда
								// КОНЕЦ Борисенко Игорь 30.05.2025 Выполнение задач №000053873
								ПроверяемыйДокумент = НайтиСсылкуСправочникаПоУИД(СтрокаПроверкиУИД, ВидДокумента, ПутьКРеквизиту);
								ВидДокументаОжидаемый = "Справочник.ДоговорыКонтрагентов";
