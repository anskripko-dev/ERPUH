	Для Каждого сXDTO Из Объект_XDTO.tableRecords.string Цикл
		
		Запись = НаборРС.Добавить();
		ЗаполнитьОбъект(Запись, сXDTO, сТип, Результат, , НаборРС, Объект_XDTO);
		
	КонецЦикла;		
	
	Отказ = Ложь;
	Если сТип.ПроцедураДоЗаполнения Тогда
		
		Выполнить(сТип.Менеджер + ".ДозаполнитьОбъект(НаборРС, Отказ, Результат)");
		
	КонецЕсли;
	
	// НАЧАЛО Белоконенко Денис 05.05.2023 Выполнение задач №000045412 
	//Попытка
	//	
	//	НаборРС.ОбменДанными.Загрузка = Истина;
	//	НаборРС.Записать();
	//	
	//	НаборРС.ОбменДанными.Загрузка = Ложь;
	//	НаборРС.Записать();
	//	
	//Исключение
	//	
	//	Результат.Успех = Ложь;
	//	ИнформацияОбОшибке = ОписаниеОшибки();
	//	Результат.ОписаниеОшибки = СтрШаблон("%1 *** Не удалось создать Объект %2: %3 %4",
	//										Результат.ОписаниеОшибки,
	//										сТип.Менеджер,
	//										ИнформацияОбОшибке,
	//										Символы.ПС);
	//	
	//КонецПопытки;	
	
	Если сТип.ИспользоватьЗаписьПоРегистратору Тогда
		ТЗ_НаборРС = НаборРС.Выгрузить();
		
		МассивРегистраторов = ТЗ_НаборРС.ВыгрузитьКолонку("Регистратор");	
		МассивРегистраторов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивРегистраторов);
		
		Для Каждого Регистратор Из МассивРегистраторов Цикл
			НаборРС = РегистрыСведений[ИмяРег].СоздатьНаборЗаписей();
			НаборРС.Отбор.Регистратор.Установить(Регистратор);
			
			ДанныеНабораМассив = ТЗ_НаборРС.НайтиСтроки(Новый Структура("Регистратор", Регистратор));
			
			Для Каждого ДанныеНабора Из ДанныеНабораМассив Цикл
				Если ДанныеНабора.Активность Тогда
					Запись = НаборРС.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, ДанныеНабора);
				КонецЕсли;
			КонецЦикла;
			
			ЗаписатьНаборРегистрСведений(НаборРС, сТип, Результат);
		КонецЦикла;
	Иначе
		ЗаписатьНаборРегистрСведений(НаборРС, сТип, Результат);
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 05.05.2023 Выполнение задач №000045412
	
КонецПроцедуры

// Османов Нагим 30.09.2022 Выполнение задач №000042773
Процедура ЗагрузитьРегистрСведений_МенеджерЗаписей(сТип, Объект_XDTO, Результат)
	
	МенеджерЗаписи = Неопределено;
	ИмяРег = СокрЛП(СтрЗаменить(сТип.ПредставлениеТипа, "рег.", ""));
	
	Попытка
		
		Для Каждого сXDTO Из Объект_XDTO.tableRecords.string Цикл
			
			Выполнить(сТип.Менеджер + ".ПолучитьЗаписьРС(МенеджерЗаписи, сXDTO)");
			ЗаполнитьОбъект(МенеджерЗаписи, сXDTO, сТип, Результат, , МенеджерЗаписи, Объект_XDTO);

			Отказ = Ложь;
			Если сТип.ПроцедураДоЗаполнения Тогда
				Выполнить(сТип.Менеджер + ".ДозаполнитьОбъект(МенеджерЗаписи, Отказ, Результат, сXDTO)");
			КонецЕсли;
			
			Если МенеджерЗаписи <> Неопределено Тогда
				// НАЧАЛО Борисенко Игорь 20.01.2025 Выполнение задач №000052323
				Если сТип.ОтключитьПроверкуДатыЗапрета = Истина Тогда
					ПроверкаДатЗапретаОтключена = ДатыЗапретаИзменения.ПроверкаДатЗапретаОтключена();
					ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(Истина);
				КонецЕсли;
				// КОНЕЦ Борисенко Игорь 20.01.2025 Выполнение задач №000052323
				МенеджерЗаписи.Записать();
				// НАЧАЛО Борисенко Игорь 20.01.2025 Выполнение задач №000052323
				Если сТип.ОтключитьПроверкуДатыЗапрета = Истина Тогда
					ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(ПроверкаДатЗапретаОтключена); //Восстанавливаем состояние проверки ДатыЗапрета
				КонецЕсли;
				// КОНЕЦ Борисенко Игорь 20.01.2025 Выполнение задач №000052323
			КонецЕсли;
			
		КонецЦикла; //по записям
		
	Исключение
		
		Результат.Успех = Ложь;
		ИнформацияОбОшибке = ОписаниеОшибки();
		Результат.ОписаниеОшибки = СтрШаблон("%1 *** Не удалось создать Объект %2: %3 %4",
											Результат.ОписаниеОшибки,
											сТип.Менеджер,
											ИнформацияОбОшибке,
											Символы.ПС);
		
	КонецПопытки;
	
КонецПроцедуры

// Белоконенко Денис 05.05.2023 Выполнение задач №000045412
Процедура ЗаписатьНаборРегистрСведений(НаборРС, сТип, Результат)
	
	// НАЧАЛО Борисенко Игорь 20.01.2025 Выполнение задач №000052323
	Если сТип.ОтключитьПроверкуДатыЗапрета = Истина Тогда
		ПроверкаДатЗапретаОтключена = ДатыЗапретаИзменения.ПроверкаДатЗапретаОтключена();
		ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(Истина);
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 20.01.2025 Выполнение задач №000052323
	
	Попытка
		
		НаборРС.ОбменДанными.Загрузка = Истина;
		НаборРС.Записать();
		
		НаборРС.ОбменДанными.Загрузка = Ложь;
		НаборРС.Записать();
		
	Исключение
		
		Результат.Успех = Ложь;
		ИнформацияОбОшибке = ОписаниеОшибки();
		Результат.ОписаниеОшибки = СтрШаблон("%1 *** Не удалось создать Объект %2: %3 %4",
		Результат.ОписаниеОшибки,
		сТип.Менеджер,
		ИнформацияОбОшибке,
		Символы.ПС);
		
	КонецПопытки;
	
	// НАЧАЛО Борисенко Игорь 20.01.2025 Выполнение задач №000052323
	Если сТип.ОтключитьПроверкуДатыЗапрета = Истина Тогда
		ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(ПроверкаДатЗапретаОтключена); //Восстанавливаем состояние проверки ДатыЗапрета
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 20.01.2025 Выполнение задач №000052323
	
КонецПроцедуры

// Борисенко И.Н. 17.05.2021 Выполнение задач №000037864
// НАЧАЛО Борисенко Игорь 22.03.2022 Выполнение задач №000040623
// НАЧАЛО Белоконенко Денис 18.04.2023 Выполнение задач №000045229
//Процедура ЗарегистрироватьОбъектКакЗагруженный(Ссылка, Объект)
Процедура ЗарегистрироватьОбъектКакЗагруженный(Ссылка, Объект, Версия)
// КОНЕЦ Белоконенко Денис 18.04.2023 Выполнение задач №000045229
// КОНЕЦ Борисенко Игорь 22.03.2022 Выполнение задач №000040623
	
	Запись = РегистрыСведений.тн_ЗагруженныеОбъекты.СоздатьМенеджерЗаписи();
	Запись.Объект = Ссылка;
	// НАЧАЛО Борисенко Игорь 22.03.2022 Выполнение задач №000040623
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары")
		Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.ВозвратТоваровПоставщику")
			И Объект.ДополнительныеСвойства.operationType = "ВозвратНаЗавод"
		Тогда
		Запись.РазрешитьРедактирование = Истина;
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 22.03.2022 Выполнение задач №000040623
	// НАЧАЛО Белоконенко Денис 18.04.2023 Выполнение задач №000045229
	Если Версия = Неопределено Тогда
		Запись.Версия = РегистрыСведений.тн_ЗагруженныеОбъекты.ПолучитьВерсиюОбъекта(Ссылка);
	Иначе
		Запись.Версия = Версия;
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 18.04.2023 Выполнение задач №000045229
	
	Запись.Записать(Истина);
	
КонецПроцедуры

// Борисенко И.Н. 24.12.2020 Выполнение задач №000035594
Процедура ЗаполнитьЕдиницыИзмеренияТабличнойЧасти(Объект, ТЧОбъекта, ДопСвойстваТЧОбъекта, Результат, масПолейКоличество = Неопределено, масПолейЦена = Неопределено) Экспорт
	
	Для каждого СтрокаТЧ Из ТЧОбъекта Цикл
		Если Не СтрокаТЧ.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
			// НАЧАЛО Борисенко И.Н. 24.09.2021 Выполнение задач №000039141
			СтрокаТЧ.Упаковка = Неопределено;
			// КОНЕЦ Борисенко И.Н. 24.09.2021 Выполнение задач №000039141
			Продолжить;
		КонецЕсли;
		
		сДоп = ДопСвойстваТЧОбъекта[СтрокаТЧ.НомерСтроки-1];
		Если ЗначениеЗаполнено(сДоп.codeMeasure) Тогда
			
			ЕдУПП = тн_Интеграция_ERP_УХ.ПолучитьОбъект_(сДоп.measureGuid, "Справочники.УпаковкиЕдиницыИзмерения"
				,,, Истина, Результат, Новый Структура("code", сДоп.codeMeasure));
				
		Иначе
			ЕдУПП = Неопределено; //в УПП для Номенклатуры не заполнена БазоваяЕдИзм, соответственно, при выгрузке для строки документа не смогли определить codeMeasure
		КонецЕсли;
				
		Если ЕдУПП = Неопределено Тогда
			ЕдУПП = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		Иначе
			ЕдУПП = ЕдУПП.Ссылка;
		КонецЕсли;
			
		//Единицы номенклатуры
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", СтрокаТЧ.Номенклатура);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Номенклатура.ВесЕдиницаИзмерения КАК ВесЕдиницаИзмерения,
		|	Номенклатура.ВесЧислитель КАК ВесЧислитель,
		|	Номенклатура.ВесЗнаменатель КАК ВесЗнаменатель,
		|	Номенклатура.ОбъемЕдиницаИзмерения КАК ОбъемЕдиницаИзмерения,
		|	Номенклатура.ОбъемЧислитель КАК ОбъемЧислитель,
		|	Номенклатура.ОбъемЗнаменатель КАК ОбъемЗнаменатель,
		|	Номенклатура.ПлощадьЕдиницаИзмерения КАК ПлощадьЕдиницаИзмерения,
		|	Номенклатура.ПлощадьЧислитель КАК ПлощадьЧислитель,
		|	Номенклатура.ПлощадьЗнаменатель КАК ПлощадьЗнаменатель,
		|	Номенклатура.ДлинаЕдиницаИзмерения КАК ДлинаЕдиницаИзмерения,
		|	Номенклатура.ДлинаЧислитель КАК ДлинаЧислитель,
		|	Номенклатура.ДлинаЗнаменатель КАК ДлинаЗнаменатель
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
		ВыборкаНом = Запрос.Выполнить().Выбрать();
		ВыборкаНом.Следующий();
		
		ЕдХран = ВыборкаНом.ЕдиницаИзмерения;
		
		Если Не ЗначениеЗаполнено(ЕдХран) Тогда //не сможем пересчитать Кол. в ЕдХранения
			//Логируем
			Профиль = Справочники.тн_ПрофилиПодключений.ERP_УХ;
			Если Профиль.ВестиЛоги Тогда
				ТекстСообщения = СокрЛП(Объект) + " строка " + СтрокаТЧ.НомерСтроки + ": не определена Ед.Измер. (см. ЕдИзм для Номенклатуры в УПП).";
				ДанныеДляЛогирования = ПолучитьДанныеДляЛогирования(Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена, , , Профиль.ВестиЛоги);
				ЗаписатьЛогРаботы("Ошибка", ДанныеДляЛогирования, ТекстСообщения, Перечисления.тн_ВидыСобытийИнтеграции.Ошибка);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		//1. Определим Упаковку и соответствующие ей Кол. и Цены
		Если 	 ЕдУПП = ЕдХран
			Или (ЕдУПП = ВыборкаНом.ВесЕдиницаИзмерения 	И ЗначениеЗаполнено(ВыборкаНом.ВесЕдиницаИзмерения))
			Или (ЕдУПП = ВыборкаНом.ОбъемЕдиницаИзмерения 	И ЗначениеЗаполнено(ВыборкаНом.ОбъемЕдиницаИзмерения))
			Или (ЕдУПП = ВыборкаНом.ПлощадьЕдиницаИзмерения	И ЗначениеЗаполнено(ВыборкаНом.ПлощадьЕдиницаИзмерения))
			Или (ЕдУПП = ВыборкаНом.ДлинаЕдиницаИзмерения 	И ЗначениеЗаполнено(ВыборкаНом.ДлинаЕдиницаИзмерения))
			Тогда	
			//Оставляем ЕдУПП, а также Кол. и Цены ей соответствующие (если есть отдельное поле "Количество" для ЕдХранения, то пересчитаем его след.шагом)
			Ед = ЕдУПП;
			
		Иначе
			//Пересчитываем Кол. и Цены в ЕдХран
			Ед = ЕдХран;
			
			КоэфПересчетаВЕдИзмХранения = ?(сДоп.coefficient = 0, 1, сДоп.coefficient);
			//НАЧАЛО Качикина 06.10.2025 Выполнение задач №000055383 
			//для пересчета всех количественных полей используем неокругленное количество, переданное из УПП
			ПересчетОтКоличестваУПП = ДопСвойстваТЧОбъекта.Колонки.Найти("quantity")<> Неопределено
									И ТипЗнч(Объект) = Тип("ДокументОбъект.КорректировкаРеализации"); 
			//КОНЕЦ Качикина 06.10.2025 Выполнение задач №000055383

			//Пересчет Количества
			Если масПолейКоличество <> Неопределено Тогда
				Для каждого Поле Из масПолейКоличество Цикл
					//НАЧАЛО Качикина 06.10.2025 Выполнение задач №000055383  
					//СтрокаТЧ[Поле] = СтрокаТЧ[Поле] * КоэфПересчетаВЕдИзмХранения;
					СтрокаТЧКоличество	= ?(ПересчетОтКоличестваУПП, сДоп.quantity, СтрокаТЧ[Поле]);
					СтрокаТЧ[Поле]		= СтрокаТЧКоличество * КоэфПересчетаВЕдИзмХранения;
					//КОНЕЦ Качикина 06.10.2025 Выполнение задач №000055383
				КонецЦикла;
				
				Если ДопСвойстваТЧОбъекта.Колонки.Найти("quantityBeforeChange") <> Неопределено Тогда 		//в док.КорректировкаПриобретения и КорректировкаРеализации
					сДоп.quantityBeforeChange = сДоп.quantityBeforeChange * КоэфПересчетаВЕдИзмХранения;    //чтобы при заполнении тч Расхождения сравнивать количества в одинаковых ЕИ
				КонецЕсли;
			КонецЕсли;
		
			//Пересчет Цена
			Если масПолейЦена <> Неопределено Тогда
				Для каждого Поле Из масПолейЦена Цикл
					СтрокаТЧ[Поле] = СтрокаТЧ[Поле] / КоэфПересчетаВЕдИзмХранения;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаТЧ.Упаковка = Ед;
		
		//2. если есть отдельное поле "Количество" для ЕдХранения, то пересчитаем его
		Если ЗначениеЗаполнено(СтрокаТЧ.Упаковка) И ЗначениеЗаполнено(ЕдХран) И СтрокаТЧ.Упаковка <> ЕдХран
			И масПолейКоличество <> Неопределено И масПолейКоличество.Найти("КоличествоУпаковок") <> Неопределено И масПолейКоличество.Найти("Количество") <> Неопределено Тогда
			
			Числитель = 0;
			Знаменатель = 0;
			Если СтрокаТЧ.Упаковка 		= ВыборкаНом.ОбъемЕдиницаИзмерения Тогда
				Числитель 				= ВыборкаНом.ОбъемЧислитель;
				Знаменатель 			= ВыборкаНом.ОбъемЗнаменатель;
			ИначеЕсли СтрокаТЧ.Упаковка = ВыборкаНом.ПлощадьЕдиницаИзмерения Тогда
				Числитель 				= ВыборкаНом.ПлощадьЧислитель;
				Знаменатель 			= ВыборкаНом.ПлощадьЗнаменатель;
			ИначеЕсли СтрокаТЧ.Упаковка = ВыборкаНом.ВесЕдиницаИзмерения Тогда
				Числитель 				= ВыборкаНом.ВесЧислитель;
				Знаменатель 			= ВыборкаНом.ВесЗнаменатель;
			ИначеЕсли СтрокаТЧ.Упаковка = ВыборкаНом.ДлинаЕдиницаИзмерения Тогда
				Числитель 				= ВыборкаНом.ДлинаЧислитель;
				Знаменатель 			= ВыборкаНом.ДлинаЗнаменатель;
			КонецЕсли;
			
			СтрокаТЧ.Количество = СтрокаТЧ.КоличествоУпаковок 
				* ?(Знаменатель = 0, 1, Знаменатель)
				/ ?(Числитель = 0, 1, Числитель); 
			
		КонецЕсли;
		
		Если масПолейКоличество <> Неопределено И масПолейКоличество.Найти("КоличествоУпаковок") <> Неопределено И масПолейКоличество.Найти("Количество") <> Неопределено Тогда
			
			// НАЧАЛО Борисенко И.Н. 09.08.2021 Выполнение задач №000039141
			// НАЧАЛО Шабалкина Е 22.12.2021 Выполнение задач №000039896
			  ПараметрыОкругления = НоменклатураСервер.ПараметрыПроверкиЗаполненияКоличества();
			// КОНЕЦ Шабалкина Е 22.12.2021 Выполнение задач №000039896
  
			Если ЕстьТабличнаяЧастьОбъекта("Товары", Объект.Метаданные()) Тогда
				ПараметрыОкругления.ИмяТЧ = "Товары";
			// НАЧАЛО Шабалкина Е 22.12.2021 Выполнение задач №000039896
				НоменклатураСервер.ОкруглитьКоличествоШтучныхТоваров(Объект,,ПараметрыОкругления);
			КонецЕсли;
			Если ЕстьТабличнаяЧастьОбъекта("Расхождения", Объект.Метаданные()) Тогда
				ПараметрыОкругления.ИмяТЧ = "Расхождения";
			// НАЧАЛО Шабалкина Е 22.12.2021 Выполнение задач №000039896
				НоменклатураСервер.ОкруглитьКоличествоШтучныхТоваров(Объект,,ПараметрыОкругления);
			// КОНЕЦ Шабалкина Е 22.12.2021 Выполнение задач №000039896

			КонецЕсли;
			Если ЕстьТабличнаяЧастьОбъекта("Продукция", Объект.Метаданные()) Тогда
				ПараметрыОкругления.ИмяТЧ = "Продукция";
			// НАЧАЛО Шабалкина Е 22.12.2021 Выполнение задач №000039896
				НоменклатураСервер.ОкруглитьКоличествоШтучныхТоваров(Объект,,ПараметрыОкругления);
			// КОНЕЦ Шабалкина Е 22.12.2021 Выполнение задач №000039896
			КонецЕсли;
			Если ЕстьТабличнаяЧастьОбъекта("Материалы", Объект.Метаданные()) Тогда
				ПараметрыОкругления.ИмяТЧ = "Материалы";
			// НАЧАЛО Шабалкина Е 22.12.2021 Выполнение задач №000039896
			    НоменклатураСервер.ОкруглитьКоличествоШтучныхТоваров(Объект,,ПараметрыОкругления);
			// КОНЕЦ Шабалкина Е 22.12.2021 Выполнение задач №000039896
			КонецЕсли;
			// КОНЕЦ Борисенко И.Н. 09.08.2021 Выполнение задачи №000039141
		КонецЕсли;
		
	КонецЦикла; //ТЧОбъекта
	
