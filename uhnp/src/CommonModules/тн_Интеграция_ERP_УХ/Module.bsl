	КонецЕсли;	
	// КОНЕЦ Юдина Екатерина 25.05.2026 Выполнение задач №000057754
	
	// НАЧАЛО Юдина Екатерина 22.10.2025 Выполнение задач №000055582
	Если Объект_XDTO <> Неопределено Тогда          
		ОбъектПрочиеРасходы.ДополнительныеСвойства.Вставить("Posted", Объект_XDTO.Posted); 
	Иначе 
	// КОНЕЦ Юдина Екатерина 22.10.2025 Выполнение задач №000055582
		ОбъектПрочиеРасходы.ДополнительныеСвойства.Вставить("Posted", Объект.ДополнительныеСвойства.Posted);		
	// НАЧАЛО Юдина Екатерина 22.10.2025 Выполнение задач №000055582
	КонецЕсли; 
	// КОНЕЦ Юдина Екатерина 22.10.2025 Выполнение задач №000055582
	
	СтруктураРезультат.Вставить("ОбъектПрочиеРасходы", ОбъектПрочиеРасходы); 
	// НАЧАЛО Юдина Екатерина 22.10.2025 Выполнение задач №000055582
	Если Объект_XDTO = Неопределено Тогда          
