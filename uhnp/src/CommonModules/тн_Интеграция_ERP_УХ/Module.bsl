// Гутарова Екатерина 20.04.2022 Выполнение задач №000041060
//
Функция ВернутьГруппуФинансовогоУчетаРасчетов(КодСчетаУчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПорядокОтраженияНаСчетахУчета.АналитикаУчета КАК ГруппаФинУчета
	               |ИЗ
	               |	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокОтраженияНаСчетахУчета
	               |ГДЕ
	               |	ПорядокОтраженияНаСчетахУчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКлиентами)
	               |	И ПорядокОтраженияНаСчетахУчета.СчетУчета = &СчетУчета
	               |	И ПорядокОтраженияНаСчетахУчета.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |	И ТИПЗНАЧЕНИЯ(ПорядокОтраженияНаСчетахУчета.АналитикаУчета) = ТИП(Справочник.ГруппыФинансовогоУчетаРасчетов)
	               |	И НЕ ПорядокОтраженияНаСчетахУчета.АналитикаУчета = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)";		
	
	Запрос.УстановитьПараметр("СчетУчета", ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчетаУчета)); 
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ГруппаФинансовогоУчета = Выборка.ГруппаФинУчета;
	Иначе 
		ГруппаФинансовогоУчета = Справочники.ГруппыФинансовогоУчетаРасчетов.СоздатьЭлемент();
		
		ГФУСсылка = Справочники.ГруппыФинансовогоУчетаРасчетов.ПолучитьСсылку();
		ГруппаФинансовогоУчета.УстановитьСсылкуНового(ГФУСсылка);
		
		ГруппаФинансовогоУчета.Наименование = "Расчеты с клиентами " + КодСчетаУчета;
		ГруппаФинансовогоУчета.РасчетыСКлиентами = Истина;
		ГруппаФинансовогоУчета.ОбменДанными.Загрузка = Истина;
		
		Попытка
			ГруппаФинансовогоУчета.Записать();	
		Исключение
			ГруппаФинансовогоУчета = Неопределено;
		КонецПопытки;
		
		Если ГруппаФинансовогоУчета <> Неопределено Тогда
			
			Набор = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СоздатьНаборЗаписей();
			Набор.Отбор.АналитикаУчета.Установить(ГруппаФинансовогоУчета);
			Запись = Набор.Добавить();
			Запись.ВидСчета = Перечисления.ВидыСчетовРеглУчета.РасчетыСКлиентами;
			Запись.АналитикаУчета = ГруппаФинансовогоУчета;
			Запись.СчетУчета =  ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчетаУчета);
			
			Набор.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГруппаФинансовогоУчета;
	
КонецФункции

// Гутарова Екатерина 03.04.2023 Выполнение задач №000045033
//
Функция ПолучитьПриходныйОрдерНаТовары(Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриходныйОрдерНаТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары КАК ПриходныйОрдерНаТовары
	|ГДЕ
	|	ПриходныйОрдерНаТовары.Распоряжение = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектОрдер = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		ОбъектОрдер = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОбъектОрдер.Ссылка);
		Ссылка = МенеджерОбъекта.ПолучитьСсылку();
		ОбъектОрдер.УстановитьСсылкуНового(Ссылка);  
		ОбъектОрдер.Распоряжение = Объект.Ссылка;
	КонецЕсли;

	ОбъектОрдер.Дата                  = Объект.Дата;    
	ОбъектОрдер.Склад                 = Объект.Склад;    
	ОбъектОрдер.Отправитель           = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.Контрагент);
	ОбъектОрдер.СкладскаяОперация     = Перечисления.СкладскиеОперации.ПриемкаОтПоставщика; 
	ОбъектОрдер.Ответственный         = Объект.Менеджер; 
	ОбъектОрдер.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	ОбъектОрдер.Статус                = Перечисления.СтатусыПриходныхОрдеров.Принят;
	ОбъектОрдер.Комментарий           = "Создано автоматически на основании документа Приобретение товаров и услуг " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy");
	
	ОбъектОрдер.Товары.Загрузить(Объект.Товары.Выгрузить(,"Номенклатура, Характеристика, Назначение, Упаковка, КоличествоУпаковок, Количество, СтатусУказанияСерий, Серия"));
	
	//НАЧАЛО Сафиуллина З.Р. 31.05.2024 Выполнение задач №000049649 
	//ОбъектОрдер.ДополнительныеСвойства.Вставить("Posted", Объект.ДополнительныеСвойства.Posted);
	Если Объект.ДополнительныеСвойства.Свойство("toCreateOrder") И Объект.ДополнительныеСвойства.toCreateOrder = Истина Тогда
		ПроводитьОрдер =  Истина;
	Иначе
		ПроводитьОрдер = Объект.ДополнительныеСвойства.Posted;
	КонецЕсли;
	
	ОбъектОрдер.ДополнительныеСвойства.Вставить("Posted", ПроводитьОрдер); 
	//КОНЕЦ Сафиуллина З.Р. 31.05.2024 Выполнение задач №000049649
	
	Возврат ОбъектОрдер;
	
КонецФункции  

// Юдина (Гутарова) Екатерина 15.07.2024 Выполнение задач №000050218  
//
Функция ПолучитьСтруктуруДокументовОтчетКомитентуПоЗакупкам(Объект)

	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Объект", Объект);
	
	// СФ Вознаграждение
	СчетаФактуры = Документы.СчетФактураПолученный.СчетаФактурыПоОснованию(Объект.Ссылка, Объект.Организация, Неопределено, Ложь);
	Если СчетаФактуры.Количество() > 0 Тогда
		ОбъектСФ = СчетаФактуры[0].Ссылка.ПолучитьОбъект();  
	Иначе
		ОбъектСФ = Документы.СчетФактураПолученный.СоздатьДокумент();    
		СтрокаОснования = ОбъектСФ.ДокументыОснования.Добавить();
		СтрокаОснования.ДокументОснование = Объект.Ссылка;
		
		ОбъектСФ.Номер           = Объект.НомерВходящегоДокумента;
		ОбъектСФ.Дата            = Объект.Дата;
		ОбъектСФ.ДатаСоставления = Объект.Дата;
		ОбъектСФ.Валюта          = Объект.Валюта;  
		ОбъектСФ.Организация     = Объект.Организация; 
		ОбъектСФ.Контрагент      = Объект.Контрагент; 
		ОбъектСФ.КодВидаОперации = "01";  
		ОбъектСФ.СоставленКомиссионеромОтИмениПродавца = Ложь;
		СтруктураКА = ОбщегоНазначенияУХ.ПолучитьЗначенияРеквизитов(Объект.Контрагент, "ИНН, КПП");
		ОбъектСФ.КППКонтрагента  = СтруктураКА.ИНН;   
		ОбъектСФ.ИННКонтрагента  = СтруктураКА.КПП;   
		
		ОбъектСФ.ДополнительныеСвойства.Вставить("Posted", Объект.ДополнительныеСвойства.Posted); 	
		СтруктураРезультат.Вставить("ОбъектСФВознаграждение", ОбъектСФ); 	
	КонецЕсли;

	тзУслуги = Новый ТаблицаЗначений;
	Если Объект.ДополнительныеСвойства.Свойство("ДопСвойстваТЧОбъекта_TableServices") Тогда
		
		тзУслуги = Объект.ДополнительныеСвойства.ДопСвойстваТЧОбъекта_TableServices;
		СтруктураЗаполнения = РегистрыСведений.тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам.ПолучитьДанныеДляЗаполненияДокумента(Объект.Контрагент, Перечисления.тн_ВидыДокументовОтчетКомитентаПоЗакупкам.Услуги);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПриобретениеУслугПрочихАктивов.Ссылка                           КАК Ссылка,  
		|	ПриобретениеУслугПрочихАктивов.тн_ПоставщикПоАгентскомуДоговору КАК тн_ПоставщикПоАгентскомуДоговору,
		|	ПриобретениеУслугПрочихАктивовРасходы.СуммаНДС                  КАК СуммаНДС,
		|	ПриобретениеУслугПрочихАктивовРасходы.Сумма                     КАК Сумма,
		|	ПриобретениеУслугПрочихАктивовРасходы.Содержание                КАК Содержание
		|ИЗ
		|	Документ.ПриобретениеУслугПрочихАктивов.Расходы КАК ПриобретениеУслугПрочихАктивовРасходы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеУслугПрочихАктивов КАК ПриобретениеУслугПрочихАктивов
		|		ПО ПриобретениеУслугПрочихАктивовРасходы.Ссылка = ПриобретениеУслугПрочихАктивов.Ссылка
		|ГДЕ
		|	ПриобретениеУслугПрочихАктивов.тн_СвязанныйДокумент = &ДокументОснование";
		Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
		Результат = Запрос.Выполнить();
		Выборка   = Результат.Выбрать(); 
		МассивДокументов = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		НомерДокумента = 1;
		МассивОбработанныхДокументов = Новый Массив; 
		Для Каждого СтрокаУслуги Из тзУслуги Цикл 
			// Приобретение Услуги
			Выборка.Сбросить();
			Если Выборка.НайтиСледующий(Новый Структура("Содержание, СуммаНДС, Сумма, тн_ПоставщикПоАгентскомуДоговору", СтрокаУслуги.nomenclatureName, СтрокаУслуги.sumVAT, СтрокаУслуги.sum, Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаУслуги.AgentGuid))))
				И МассивОбработанныхДокументов.Найти(Выборка.Ссылка) = Неопределено Тогда			
				ОбъектПриобретение = Выборка.Ссылка.ПолучитьОбъект(); 	
				МассивОбработанныхДокументов.Добавить(Выборка.Ссылка); 
				Ссылка = Выборка.Ссылка;
			Иначе
				ОбъектПриобретение = Документы.ПриобретениеУслугПрочихАктивов.СоздатьДокумент(); 
				МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОбъектПриобретение.Ссылка);     		
				Ссылка = МенеджерОбъекта.ПолучитьСсылку();
				ОбъектПриобретение.УстановитьСсылкуНового(Ссылка);  
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОбъектПриобретение, Объект, ,"Номер");  
			ОбъектПриобретение.тн_СвязанныйДокумент             = Объект.Ссылка;
			ОбъектПриобретение.тн_ПоставщикПоАгентскомуДоговору = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаУслуги.AgentGuid));
			ОбъектПриобретение.НомерВходящегоДокумента          = СтрокаУслуги.documentFactureNumber; 
			ОбъектПриобретение.ДатаВходящегоДокумента           = СтрокаУслуги.documentFactureDate;
			ОбъектПриобретение.тн_УпрУчетНДС                    = Истина;  
			ОбъектПриобретение.ЦенаВключаетНДС                  = Истина; 
			ОбъектПриобретение.НалогообложениеНДС               = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			ОбъектПриобретение.ЗакупкаПодДеятельность           = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;     
			ОбъектПриобретение.НаименованиеВходящегоДокумента   = "Отчет агента";
			ОбъектПриобретение.Подразделение                    = Справочники.СтруктураПредприятия.тн_ОтражатьТолькоВРегламентированномУчете; 
			ОбъектПриобретение.Комментарий                      = "Услуга третьих лиц " + ОбъектПриобретение.тн_ПоставщикПоАгентскомуДоговору + " (" + Формат(ОбъектПриобретение.Дата,"ДФ='MMMM yyyy'") + ")." + 
			Символы.ПС + СтрЗаменить(Объект.Комментарий, "Агентская комиссия.", "");
			
			ОбъектПриобретение.Расходы.Очистить();		
			СтрокаРасходы = ОбъектПриобретение.Расходы.Добавить();
			
			СтрокаРасходы.Содержание = СтрокаУслуги.nomenclatureName;
			СтрокаРасходы.Количество = СтрокаУслуги.quantity;
			СтрокаРасходы.Цена       = СтрокаУслуги.price;
			СтрокаРасходы.Сумма      = СтрокаУслуги.sum;
			СтрокаРасходы.СуммаНДС   = СтрокаУслуги.sumVAT;   
			СтрокаРасходы.СтавкаНДС  = тн_ОбщегоНазначения.ПолучитьНДСИзСтроки(СтрокаУслуги.vat_rate);  
			Если СтруктураЗаполнения <> Неопределено Тогда
				СтрокаРасходы.Подразделение = СтруктураЗаполнения.ПодразделениеПолучатель;
				СтрокаРасходы.СтатьяРасходов =  СтруктураЗаполнения.Статья;
				СтрокаРасходы.АналитикаРасходов =  СтруктураЗаполнения.Аналитика;
			КонецЕсли;
			СтрокаРасходы.СуммаСНДС = ?(Объект.ЦенаВключаетНДС, СтрокаУслуги.sum, СтрокаУслуги.sum + СтрокаУслуги.sumVAT);
			ОбъектПриобретение.ДополнительныеСвойства.Вставить("Posted", Объект.ДополнительныеСвойства.Posted); 	
			СтруктураРезультат.Вставить("ОбъектПриобретение" + НомерДокумента, ОбъектПриобретение); 
			
			// СФ Услуги
			СчетаФактуры = Документы.СчетФактураПолученный.СчетаФактурыПоОснованию(Ссылка, ОбъектПриобретение.Организация, Неопределено, Ложь);
			Если СчетаФактуры.Количество() > 0 Тогда
				ОбъектСФ = СчетаФактуры[0].Ссылка.ПолучитьОбъект();  
			Иначе
				ОбъектСФ = Документы.СчетФактураПолученный.СоздатьДокумент();     
			КонецЕсли;    
			
			ОбъектСФ.ДокументыОснования.Очистить();
			СтрокаОснования = ОбъектСФ.ДокументыОснования.Добавить();
			СтрокаОснования.ДокументОснование = Ссылка;
			
			ОбъектСФ.Номер           = СтрокаУслуги.documentFactureNumber; 
			ОбъектСФ.Дата            = СтрокаУслуги.documentFactureDate;
			ОбъектСФ.ДатаСоставления = СтрокаУслуги.documentFactureDate;
			ОбъектСФ.Валюта          = ОбъектПриобретение.Валюта;  
			ОбъектСФ.Организация     = ОбъектПриобретение.Организация; 
			ОбъектСФ.Контрагент      = ОбъектПриобретение.Контрагент;  
			ОбъектСФ.КодВидаОперации = "01";
			ОбъектСФ.СоставленКомиссионеромОтИмениПродавца = Истина; 
			СтруктураКА = ОбщегоНазначенияУХ.ПолучитьЗначенияРеквизитов(ОбъектПриобретение.Контрагент, "ИНН, КПП");
			ОбъектСФ.КППКонтрагента  = СтруктураКА.ИНН;   
			ОбъектСФ.ИННКонтрагента  = СтруктураКА.КПП;   
			
			ОбъектСФ.Продавцы.Очистить();
			СтрокаПродавцы = ОбъектСФ.Продавцы.Добавить();
			СтрокаПродавцы.Продавец = ОбъектПриобретение.тн_ПоставщикПоАгентскомуДоговору; 
			
			ОбъектСФ.ДополнительныеСвойства.Вставить("Posted", Объект.ДополнительныеСвойства.Posted); 	
			СтруктураРезультат.Вставить("ОбъектСФ" + НомерДокумента, ОбъектСФ); 
			НомерДокумента = НомерДокумента + 1;  
			
		КонецЦикла;
		
	КонецЕсли;    
	
	МассивДокументов = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивДокументов, МассивОбработанныхДокументов);

	Для Каждого Документ Из МассивДокументов Цикл		
		ДокументОбъект = Документ.ПолучитьОбъект(); 
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокументОбъект.ПометкаУдаления = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
	
	Для Каждого Элемент Из СтруктураРезультат Цикл		
		
		ДокументОбъект = Элемент.Значение;
		
		// НАЧАЛО Юдина (Гутарова) Екатерина 16.10.2024 Выполнение задач №000051189
