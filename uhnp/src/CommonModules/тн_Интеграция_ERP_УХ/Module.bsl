// Мещеряков Алексей 02.07.2025 Выполнение задач №000054271
//
Процедура ОчисткаРегистраОшибкиПроведенияДокументовПриЗагрузкеОтСтарыхЗаписей() Экспорт
	
	ДействующиеДаты = ДатыЗапретаИзмененияСлужебный.ЗначениеПараметраСеансаДействующиеДатыЗапретаИзменения(); 
	ПараметрыСообщенияОЗапрете = ДатыЗапретаИзменения.ПараметрыСообщенияОЗапрете();
	
	НаборЗаписей = РегистрыСведений.тн_ОшибкиПроведенияДокументовПриЗагрузке.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	МассивУдалений = Новый Массив;
	
	ЧислоМесяцев = Константы.тн_КоличествоМесяцевОтДатыЗапретаПоАктуализацииДокументов.Получить();
	
	Для Каждого Запись Из НаборЗаписей Цикл                                                              
		
		Если ТипЗнч(Запись.ДокументСсылка) = Тип("ДокументСсылка.Сторно") Тогда
			ЗначниеРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ДокументСсылка,"СторнируемыйДокумент");
			Если ЗначниеРеквизита = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(Запись.ДокументСсылка) Тогда
        	МассивУдалений.Добавить(Запись);
			Продолжить;
		КонецЕсли;  
		
        ДокОбъект = Запись.ДокументСсылка.ПолучитьОбъект();		
		
		УсловиеНаДатуЗапрета = ДатыЗапретаИзмененияСлужебный.ИзменениеЗапрещено(ДокОбъект,Запись.ДокументСсылка,Null,ЧислоМесяцев);
		
		Если УсловиеНаДатуЗапрета Тогда
			МассивУдалений.Добавить(Запись);
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для Каждого ЗаписьНаУдаление Из МассивУдалений Цикл
		НаборЗаписей.Удалить(ЗаписьНаУдаление);
	КонецЦикла;	
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

//~ Качикина 21.12.2025 Выполнение задач №000056120: +ТипОшибки
//~ Сафиуллина З.Р. 14.11.2025 Выполнение задач №000055693: + параметр ВерсияСообщения
