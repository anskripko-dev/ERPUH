// Борисенко Игорь 17.02.2025 Выполнение задач №000052652
Процедура ПредварительноПометитьНаУдалениеДокументыСоСтаршимиНомерами_ПоНомерамСПостфиксомДатам(Отказ, Результат = Неопределено,Объект, ДлинаПостфикса = 0) Экспорт
	
	НомерДок = Объект.Номер;
	ДатаДок = Объект.Дата;
	
	поз = СтрНайти(НомерДок, "_", НаправлениеПоиска.СКонца);
	Если поз > 0 Тогда
		ОсноваНомера = Лев(НомерДок, поз - 1);
		
		ПодСтрокаПП = СтрЗаменить(Сред(НомерДок, поз + 1),Символы.НПП, "");
		Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ПодСтрокаПП) Тогда
			ппТекДок = Число(ПодСтрокаПП);
			
			Если Объект.ДополнительныеСвойства.Свойство("numberOfRelatedDoc") Тогда
				КоличествоСвязанныхДокументов = Объект.ДополнительныеСвойства.numberOfRelatedDoc;
			Иначе
				КоличествоСвязанныхДокументов = 0;
			КонецЕсли;
			пп = Макс(ппТекДок, КоличествоСвязанныхДокументов); //чтобы не удалялись связанные документы с меньшим постфиксом

			ОстановитьПоиск = Ложь;
			Пока ОстановитьПоиск = Ложь Цикл
				пп = пп + 1;
				
				Если ДлинаПостфикса = 0 Тогда
					//ДлинаПостфикса определяется длиной чсилового значения постфикса 
					ПостфиксНомера = СтрЗаменить(пп, Символы.НПП, "");
				Иначе
					СтрокаПП = "0000" + СтрЗаменить(Строка(пп), Символы.НПП, "");
					ПостфиксНомера = тн_Интеграция_ERP_УХ.НомерДокумента11Символов(СтрокаПП, ДлинаПостфикса);
				КонецЕсли;
				СтаршийНомер = СтрШаблон("%1_%2", ОсноваНомера, ПостфиксНомера);
				СтаршийНомер = тн_Интеграция_ERP_УХ.НомерДокумента11Символов(СтаршийНомер);
				
				ИмяТипаДок = Объект.Метаданные().Имя;
				СсылкаСтаршегоНомера = Документы[ИмяТипаДок].НайтиПоНомеру(СтаршийНомер, ДатаДок);
				
				Если СсылкаСтаршегоНомера <> Неопределено И ОбщегоНазначения.СсылкаСуществует(СсылкаСтаршегоНомера) Тогда
					
					Если Не СсылкаСтаршегоНомера.ПометкаУдаления Тогда
						
						Попытка
							
							ОбъектСтаршегоНомера = СсылкаСтаршегоНомера.ПолучитьОбъект();
							
							Если ОбъектСтаршегоНомера.Проведен Тогда
								ОбъектСтаршегоНомера.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							КонецЕсли;
							
							Если Не ОбъектСтаршегоНомера.ПометкаУдаления Тогда
								ОбъектСтаршегоНомера.УстановитьПометкуУдаления(Истина);
							КонецЕсли;
							
						Исключение
							
							Отказ = Истина;
							
							Если Результат <> Неопределено Тогда
								Результат.Успех = Ложь;
							
								ТекстСообщения = СтрШаблон("Не удалось пометить на удаление: %1", ОбъектСтаршегоНомера);
								Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ТекстСообщения;
							КонецЕсли;
							
						КонецПопытки;
						
					КонецЕсли;
					
				Иначе
					ОстановитьПоиск = Истина;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 17.02.2025 Выполнение задач №000052652
Функция НайтиДокументПоТипу(ПараметрыПоиска, Отказ, Результат) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	сТип = тн_Интеграция_ERP_УХ_ПовтИсп.ТипЗагружаемогоОбъекта_По_ТегXDTO(ПараметрыПоиска.type);

	Если сТип <> Неопределено Тогда

		Если СтрНайти(сТип.Менеджер, "Документы.")>0 Тогда
			
			СтруктураЗагружаемыхСвойств = Новый Структура();
			
			Менеджер = Вычислить(сТип.Менеджер);
			Менеджер.ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип, СтруктураЗагружаемыхСвойств);
			
			Если сТип.ПроцедураПолученияОбъекта Тогда
				
				Объект_XDTO = Новый Структура();
				Объект_XDTO.Вставить("Number"		, ПараметрыПоиска.Number); 
				Объект_XDTO.Вставить("Date"			, ПараметрыПоиска.Date); 
				Объект_XDTO.Вставить("operationType", ПараметрыПоиска.operationType); 
				// НАЧАЛО Борисенко Игорь 14.05.2025 Выполнение задач №000053672
				Объект_XDTO.Вставить("guid"			, ПараметрыПоиска.УИД);
				// КОНЕЦ Борисенко Игорь 14.05.2025 Выполнение задач №000053672
				
				Попытка
					об = Менеджер.ПолучитьОбъект(ПараметрыПоиска.УИД, сТип, Объект_XDTO, Результат);
					Ссылка = об.Ссылка;
				Исключение
						
					Если Результат <> Неопределено Тогда
						Отказ = Истина;
						Результат.Успех = Ложь;
					
						ТекстСообщения = СтрШаблон("Не удалось получить объект: %1 № %2 от %3", ПараметрыПоиска.type, ПараметрыПоиска.Number, ПараметрыПоиска.Date);
						Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ТекстСообщения;
					КонецЕсли;
					
					Возврат Неопределено;
				КонецПопытки;
				
			Иначе
				Ссылка = Менеджер.ПолучитьСсылку(ПараметрыПоиска.УИД);
			КонецЕсли;
			
			Возврат Ссылка;

		КонецЕсли;
				
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Борисенко Игорь 17.02.2025 Выполнение задач №000052652
#КонецОбласти

// Борисенко Игорь 30.10.2023 Выполнение задач №000047318
Процедура ПредварительноПометитьНаУдалениеСвязанныйДокументПоУИД(ИмяТипаДокумента, ОбъектУИД, Отказ, Результат) Экспорт
	
	СсылкаСвязанныйДокумент = Документы[ИмяТипаДокумента].ПолучитьСсылку(ОбъектУИД);
	Если ОбщегоНазначения.СсылкаСуществует(СсылкаСвязанныйДокумент) Тогда
		ОбъектСвязанныйДокумент = СсылкаСвязанныйДокумент.ПолучитьОбъект();
		Попытка
			ОбъектСвязанныйДокумент.УстановитьПометкуУдаления(Истина);
		Исключение
			Отказ = Истина;
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = ?(Результат.ОписаниеОшибки = "", "", Символы.ПС) + СтрШаблон(" Не удалось пометить на удаление: %1", ОбъектСвязанныйДокумент);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Гутарова Екатерина 14.09.2023 Выполнение задач №000046862
//
Функция ПолучитьСвязанныйДокумент(Номер, Дата, ВидОперации, ТипДокумента, Ссылка = Неопределено, тн_ВходящийГУИД = "") Экспорт
	
	СвязанныйДокумент = Неопределено;
	
	// НАЧАЛО Гутарова Екатерина 11.03.2024 Выполнение задач №000048815
	//Если ВидОперации = "КомиссияКредитногоКомитета" Тогда
	Если ВидОперации = "КомиссияКредитногоКомитета"
		Или ВидОперации = "РаспределениеПроизводственныхЗатрат"
		Или ВидОперации = "ПеремещениеВЭксплуатации"
		Или ВидОперации = "ПоступлениеДенежныхДокументов"
		Или ВидОперации = "ВыбытиеДенежныхДокументов" 
		Или ВидОперации = "ПринятиеКУчетуОС2_4"  
		Или ВидОперации = "ПеремещениеОС2_4"    
		Или ВидОперации = "АвансовыйОтчет"		
		Или ВидОперации = "ВзаимозачетЗадолженности" Тогда
		
		КолПрефикс = СтрНайти(Номер, "0");
		Префикс = Лев(Номер, КолПрефикс - 1);
		НомерБезПрефикса = Прав(Номер, СтрДлина(Номер) - (КолПрефикс - 1));  
	    // КОНЕЦ Гутарова Екатерина 11.03.2024 Выполнение задач №000048815
		
        СпецСимвол = "_";
		ДлинаСпецСимвол	= СтрДлина(СпецСимвол);
		КолСпецСимволов = СтрДлина(Номер) - СтрНайти(Номер, СпецСимвол) + ДлинаСпецСимвол;
		КолПрефикс = КолСпецСимволов - 2;
		
		// НАЧАЛО Гутарова Екатерина 11.03.2024 Выполнение задач №000048815
		//НомерСвязанногоДокумента = Лев(Номер, СтрДлина(Номер) - КолСпецСимволов); 
		НомерСвязанногоДокумента = Лев(НомерБезПрефикса, СтрДлина(НомерБезПрефикса) - КолСпецСимволов); 
		// КОНЕЦ Гутарова Екатерина 11.03.2024 Выполнение задач №000048815  
		
		Пока КолПрефикс > 0 Цикл   
			НомерСвязанногоДокумента = "0" + НомерСвязанногоДокумента;
			КолПрефикс = КолПрефикс - 1;
		КонецЦикла;
		
		// НАЧАЛО Гутарова Екатерина 11.03.2024 Выполнение задач №000048815
		//СвязанныйДокумент = Документы[ТипДокумента].НайтиПоНомеру(НомерСвязанногоДокумента + "_1", Дата);
		СвязанныйДокумент = Документы[ТипДокумента].НайтиПоНомеру(Префикс + НомерСвязанногоДокумента + "_1", Дата);
		// КОНЕЦ Гутарова Екатерина 11.03.2024 Выполнение задач №000048815 
		
	ИначеЕсли ВидОперации = "НачислениеБонусовИШтрафовПоОтгрузкеВКредит_Бонусы" 
		Или ВидОперации = "НачислениеБонусовИШтрафовПоОтгрузкеВКредит_Штрафы" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Данные.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ТипДокумента + " КАК Данные
		|ГДЕ
		|	Данные.тн_ВходящийГУИД = &тн_ВходящийГУИД
		|	И Не Данные.Ссылка = &Ссылка";
		
		Если Не ТипЗнч(Ссылка) = Тип("ДокументСсылка." + ТипДокумента) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Не Данные.Ссылка = &Ссылка", "");	
		КонецЕсли;  
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка); 
		Запрос.УстановитьПараметр("тн_ВходящийГУИД", тн_ВходящийГУИД);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СвязанныйДокумент = Выборка.Ссылка;
		КонецЕсли;
		
	// НАЧАЛО Гутарова Екатерина 11.03.2024 Выполнение задач №000048815
	ИначеЕсли ВидОперации = "ПринятиеКУчетуОС_ВнутреннееПотребление" Тогда   
		
		СвязанныйДокумент = Документы[ТипДокумента].НайтиПоНомеру(Номер, Дата);
		
	// КОНЕЦ Гутарова Екатерина 11.03.2024 Выполнение задач №000048815	
		
	КонецЕсли;
	
	Возврат СвязанныйДокумент; 
		
КонецФункции 

//Качикина 24.05.2024 Выполнение задач №000049481 
//ИмяДокументаИсточника - наименование строкой документа-источника в базе УПП 
//ИмяТекущегоДокумента - наименование строкой документа, который сейчас создаем в базе ЕРП
//ОбъектУИД - ун. идентификатор документа, который сейчас создаем в базе ЕРП
Процедура УстановкаПометкиУдаленияДляЗагруженныхРанееДокументов(ИмяДокументаИсточника, ИмяТекущегоДокумента,ОбъектУИД, Отказ, Результат)
	
	МассивПомечаемыхДокументов = Новый Массив;
	
	//1. Формируем массив документов, которые потом по ОбъектУИД будем помечать на удаление 
	Если ИмяДокументаИсточника  = "ВозвратТоваровПоставщику" Тогда
		
		Если ИмяТекущегоДокумента =  "documentReturningGoodsToSupplier"  Тогда //"ВозвратТоваровПоставщику"
				МассивПомечаемыхДокументов.Добавить("СборкаТоваров"); //documentKitGoods
				МассивПомечаемыхДокументов.Добавить("ПриходныйОрдерНаТовары"); //documentReceiptOrder
				МассивПомечаемыхДокументов.Добавить("ПередачаСырьяПереработчику"); //documentTransferMaterialsToProcessor
				МассивПомечаемыхДокументов.Добавить("РеализацияТоваровУслуг");  //documentSaleOfGoodsAndServices
		ИначеЕсли ИмяТекущегоДокумента =  "documentKitGoods" Тогда //"СборкаТоваров"
				МассивПомечаемыхДокументов.Добавить("ВозвратТоваровПоставщику");//documentReturningGoodsToSupplier
				МассивПомечаемыхДокументов.Добавить("ПередачаСырьяПереработчику");//documentTransferMaterialsToProcessor
				МассивПомечаемыхДокументов.Добавить("РеализацияТоваровУслуг");//documentSaleOfGoodsAndServices
		ИначеЕсли ИмяТекущегоДокумента =  "documentReceiptOrder" Тогда //"ПриходныйОрдерНаТовары"  
				МассивПомечаемыхДокументов.Добавить("ВозвратТоваровПоставщику");//documentReturningGoodsToSupplier
				МассивПомечаемыхДокументов.Добавить("ПередачаСырьяПереработчику");//documentTransferMaterialsToProcessor
				МассивПомечаемыхДокументов.Добавить("РеализацияТоваровУслуг");//documentSaleOfGoodsAndServices
		ИначеЕсли ИмяТекущегоДокумента =  "documentTransferMaterialsToProcessor" Тогда //"ПередачаСырьяПереработчику" 
				МассивПомечаемыхДокументов.Добавить("ВозвратТоваровПоставщику");//documentReturningGoodsToSupplier
				МассивПомечаемыхДокументов.Добавить("СборкаТоваров");//documentKitGoods
				МассивПомечаемыхДокументов.Добавить("ПриходныйОрдерНаТовары");//documentReceiptOrder
				МассивПомечаемыхДокументов.Добавить("РеализацияТоваровУслуг");//documentSaleOfGoodsAndServices
		ИначеЕсли ИмяТекущегоДокумента =  "documentSaleOfGoodsAndServices" Тогда //"РеализацияТоваровУслуг" 
				МассивПомечаемыхДокументов.Добавить("ВозвратТоваровПоставщику"); //documentReturningGoodsToSupplier
				МассивПомечаемыхДокументов.Добавить("СборкаТоваров");//documentKitGoods
				МассивПомечаемыхДокументов.Добавить("ПриходныйОрдерНаТовары");//documentReceiptOrder
				МассивПомечаемыхДокументов.Добавить("ПередачаСырьяПереработчику");//documentTransferMaterialsToProcessor
		КонецЕсли;

	КонецЕсли;
	
	//2. Ставим пометку на удаление для ранее загруженных документов
	Для каждого ИмяТипаДокумента из МассивПомечаемыхДокументов Цикл
		
		ПредварительноПометитьНаУдалениеСвязанныйДокументПоУИД(ИмяТипаДокумента, ОбъектУИД, Отказ, Результат);
				
	КонецЦикла;
	
