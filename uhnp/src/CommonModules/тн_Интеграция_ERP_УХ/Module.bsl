		Ссылка = Неопределено;
		
		сУИД = Объект_XDTO.guid;
		
		Если ЗначениеЗаполнено(сУИД) И сУИД <> "00000000-0000-0000-0000-000000000000" Тогда
			
			Попытка
				УИД = Новый УникальныйИдентификатор(сУИД);
				
				type = Объект_XDTO.type;
				Если СтрНайти(type, "Справочник.") Тогда
					ИмяМенеджер = СтрЗаменить(type, "Справочник.", "Справочники.");
					
				ИначеЕсли СтрНайти(type, "Документ.") Тогда
					ИмяМенеджер = СтрЗаменить(type, "Документ.", "Документы.");
					
				Иначе
					Продолжить; //не Справочник и не Документ
					
				КонецЕсли;
				
				Менеджер = Вычислить(ИмяМенеджер);	
				Ссылка = Менеджер.ПолучитьСсылку(УИД);
				
				Если Ссылка <> Менеджер.ПустаяСсылка() Тогда
					СтрокаРеестр.Ссылка  = Ссылка;
					СтрокаРеестр.Ошибка = Ложь;
					
					Если СтрНайти(type, "Документ.") Тогда
						Если Ссылка.Проведен <> Объект_XDTO.posted Тогда
							СтрокаРеестр.Ошибка = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			Исключение
				//если переданный ключ сообщения не является гуидом, не используем его в качестве ключа записи
				
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Переданный ключ " + Объект_XDTO.type + " не является гуидом: """ + сУИД + """: " + ОписаниеОшибки() + Символы.ПС;
			КонецПопытки;
			
		Иначе
			//если переданный ключ сообщения не является гуидом, не используем его в качестве ключа записи
			
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + "*** Переданный ключ " + Объект_XDTO.type + " не является гуидом: """ + сУИД + """: " + Символы.ПС;
		КонецЕсли;
			
		Если НЕ Результат.Успех Тогда
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	//Анализ проведенной сверки реестра
	масОшибок = Реестр.НайтиСтроки(Новый Структура("Ошибка", Истина));
	РеестрОшибок = Реестр.Скопировать(масОшибок);
	
	Если Результат.Успех Тогда
		ЗаписатьЛогРаботы("Ответ", ДанныеДляЛогирования, "Объекты типа: " + ТегXDTO + " успешно обработаны", Перечисления.тн_ВидыСобытийИнтеграции.ОбработкаЗавершена);
	Иначе
					//БИН
		//ВернутьВОчередьПринудительно = Истина;
					//БИН
		
		ОписаниеОшибки = "Ошибка получения объектов типа " + "reestr" + " описание ошибки: " + Символы.ПС + Результат.ОписаниеОшибки;		
		ЗаписатьЛогРаботы("Ошибка", ДанныеДляЛогирования, ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

