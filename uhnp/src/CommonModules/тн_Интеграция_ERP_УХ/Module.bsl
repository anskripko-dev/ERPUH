// Борисенко Игорь 25.06.2025 Выполнение задач №000054205
Процедура ПометитьНаУдалениеНеАктуальныйДокумент(Отказ, Результат, ЗагружаемыйДокумент = Неопределено, НеактуальныйДок) Экспорт
	
	Если ОбщегоНазначения.СсылкаСуществует(НеактуальныйДок) Тогда
		ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НеактуальныйДок, "ПометкаУдаления");
		
		Если Не ПометкаУдаления Тогда
			обНеактуальныйДок = НеактуальныйДок.ПолучитьОбъект();

			Попытка
				Если обНеактуальныйДок.Проведен Тогда
					обНеактуальныйДок.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				обНеактуальныйДок.УстановитьПометкуУдаления(Истина);
				
			Исключение
				Отказ = Истина;
				
				Если Результат <> Неопределено Тогда
					Результат.Успех = Ложь;
					
					Если ЗагружаемыйДокумент = Неопределено Тогда
						ТекстСообщения = СтрШаблон("Не удалось пометить на удаление: %1%2%3", СокрЛП(обНеактуальныйДок), Символы.ПС, ОписаниеОшибки());
					Иначе
						ТекстСообщения = СтрШаблон("При загрузке: %1 не удалось пометить на удаление: %2%3%4", СокрЛП(ЗагружаемыйДокумент), СокрЛП(обНеактуальныйДок), Символы.ПС, ОписаниеОшибки());
					КонецЕсли;
					
					Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ТекстСообщения;
				КонецЕсли;
				
			КонецПопытки;
					
		КонецЕсли; //еще не помечен на удаление
	КонецЕсли; //неактуальный документ существует
		
КонецПроцедуры

// Борисенко Игорь 17.10.2023 Выполнение задач №000047191
Процедура ПредварительноПометитьНаУдалениеДокументыСоСтаршимиНомерами_ПоУидСПостфиксом(Отказ, Результат = Неопределено,Объект, ДлинаПостфикса = 4) Экспорт
	
	НомерДок = Объект.Номер;
	// НАЧАЛО Белоконенко Денис 16.10.2025 Выполнение задач №000055530
	МассивУдаляемыхОбъектов = Новый Массив;
	// КОНЕЦ Белоконенко Денис 16.10.2025 Выполнение задач №000055530	
	
	поз = СтрНайти(НомерДок, "_", НаправлениеПоиска.СКонца);
	Если поз > 0 Тогда
		
		ПодСтрокаПП = СтрЗаменить(Сред(НомерДок, поз + 1),Символы.НПП, "");
		Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ПодСтрокаПП) Тогда
			ппТекДок = Число(ПодСтрокаПП);
			
			// НАЧАЛО Борисенко Игорь 09.09.2024 Выполнение задач №000050748
			//пп = ппТекДок;
			
			Если Объект.ДополнительныеСвойства.Свойство("numberOfRelatedDoc") Тогда
				КоличествоСвязанныхДокументов = Объект.ДополнительныеСвойства.numberOfRelatedDoc;
				// НАЧАЛО Борисенко Игорь 26.03.2025 Выполнение задач №000053164
				Если КоличествоСвязанныхДокументов = Неопределено Тогда
					КоличествоСвязанныхДокументов = 0;
				КонецЕсли;
				// КОНЕЦ Борисенко Игорь 26.03.2025 Выполнение задач №000053164
			Иначе
				КоличествоСвязанныхДокументов = 0;
			КонецЕсли;
			пп = Макс(ппТекДок, КоличествоСвязанныхДокументов); //чтобы не удалялись связанные документы с меньшим постфиксом
			// КОНЕЦ Борисенко Игорь 09.09.2024 Выполнение задач №000050748
			ОстановитьПоиск = Ложь;
			Пока ОстановитьПоиск = Ложь Цикл
				пп = пп + 1;
				
				СтрокаПП = "0000" + СтрЗаменить(Строка(пп), Символы.НПП, "");
				ПостфиксУид = тн_Интеграция_ERP_УХ.НомерДокумента11Символов(СтрокаПП, ДлинаПостфикса);
				
				УидДок = Объект.Ссылка.УникальныйИдентификатор();
				УидСтаршегоНомера = Лев(УидДок, 32) + ПостфиксУид;
				
				ИмяТипаДок = Объект.Метаданные().Имя;
				СсылкаСтаршегоНомера = Документы[ИмяТипаДок].ПолучитьСсылку(Новый УникальныйИдентификатор(УидСтаршегоНомера));
				
