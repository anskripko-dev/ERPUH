				ЗначениеРеквизита = Вычислить(КлЗн.Значение.Код1с);
			Исключение
				ЗначениеРеквизита = Неопределено;
			КонецПопытки;
			ЗаполнитьЗначениеРеквизита(Объект, КлЗн.Ключ, ЗначениеРеквизита);
			
		ИначеЕсли ТипЗнч(КлЗн.Значение) = Тип("Структура") И КлЗн.Значение.Свойство("ПоляТЧ") И СтрНайти(КлЗн.Ключ, "ДопСвойстваТЧОбъекта") = 0 Тогда	
