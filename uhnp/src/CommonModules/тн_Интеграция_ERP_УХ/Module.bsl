Функция ОбъектуРазрешеноИгнорироватьДатуЗапрета(ЗНАЧ ИмяМенеджер) Экспорт
	
	Если ТипЗнч(ИмяМенеджер) = Тип("Строка") Тогда
		
		ИмяМенеджер = ВРег(ИмяМенеджер);
		Если СтрНайти(ИмяМенеджер, "СПРАВОЧНИКИ.") > 0 Тогда
			ИмяМенеджер = СтрЗаменить(ИмяМенеджер, "СПРАВОЧНИКИ.", "СПРАВОЧНИК.");
		ИначеЕсли СтрНайти(ИмяМенеджер, "ДОКУМЕНТЫ.") > 0 Тогда
			ИмяМенеджер = СтрЗаменить(ИмяМенеджер, "ДОКУМЕНТЫ.", "ДОКУМЕНТ.");
		ИначеЕсли СтрНайти(ИмяМенеджер, "РЕГИСТРЫСВЕДЕНИЙ.") > 0 Тогда
			ИмяМенеджер = СтрЗаменить(ИмяМенеджер, "РЕГИСТРЫСВЕДЕНИЙ.", "РЕГИСТРСВЕДЕНИЙ.");
		Иначе
			Возврат Ложь; //Не предусмотренный случай
		КонецЕсли;
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяМенеджер);
	Иначе
		МенеджерОбъекта = ИмяМенеджер;
	КонецЕсли;
	
	МассивМенеджеров = тн_Интеграция_ERP_УХ_ПовтИсп.МенеджерыОбъектовКоторымРазрешеноИгнорированиеДатыЗапретаРедактирования();
	
	Возврат МассивМенеджеров.Найти(МенеджерОбъекта) <> Неопределено;
	
КонецФункции

