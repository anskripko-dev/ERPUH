		ЗагрузитьРегистрСведений_МенеджерЗаписей(сТип, Объект_XDTO, Результат);
		
	КонецЕсли;
		
КонецПроцедуры

// Османов Нагим 30.09.2022 Выполнение задач №000042773
Процедура ЗагрузитьРегистрСведений_НаборЗаписей(сТип, Объект_XDTO, Результат)
	
	ИмяРег = СокрЛП(СтрЗаменить(сТип.ПредставлениеТипа, "рег.", ""));
	
