//// НАЧАЛО Борисенко Игорь 30.08.2023 Выполнение задач №000046701
////Процедура ЗарегистрироватьОшибкуПроведения(Объект, сТип, messageGUID, ОписаниеОшибки)
//Процедура ЗарегистрироватьОшибкуПроведения(Объект, сТип, messageGUID, ОписаниеОшибки) Экспорт
//// КОНЕЦ Борисенко Игорь 30.08.2023 Выполнение задач №000046701
//Процедура ЗарегистрироватьОшибкуПроведения(Объект, сТип, messageGUID, ОписаниеОшибки, ВерсияСообщения = Неопределено) Экспорт
Процедура ЗарегистрироватьОшибкуПроведения(Объект, сТип, messageGUID, ОписаниеОшибки, ВерсияСообщения = Неопределено, ТипОшибки = Неопределено) Экспорт

    // НАЧАЛО Юдина Екатерина 16.10.2025 Выполнение задач №000055519
	//Если СтрНайти(сТип.Менеджер, "Документы.") = 0 Тогда  
	Если СтрНайти(сТип.Менеджер, "Документы.") = 0 
		Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда   
	// КОНЕЦ Юдина Екатерина 16.10.2025 Выполнение задач №000055519	
		Возврат;
	КонецЕсли;
	// НАЧАЛО Морозов А.В. (Код-Эксперт) 21.01.2026 Выполнение задач №000056469
	Если Не Объект.ДополнительныеСвойства.Свойство("Posted") И СтрНайти(сТип.Менеджер, "Документы.ПроизводствоБезЗаказа") <> 0 Тогда
		Объект.ДополнительныеСвойства.Вставить("Posted", Истина);
	КонецЕсли;
	// КОНЕЦ Морозов А.В. (Код-Эксперт) 21.01.2026 Выполнение задач №000056469		
	Если Не Объект.ДополнительныеСвойства.Свойство("Posted") Тогда
		Возврат;
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 14.06.2023 Выполнение задач №000045823
	//Если Объект.ДополнительныеСвойства.Posted <> Объект.Проведен Тогда
	// КОНЕЦ Борисенко Игорь 14.06.2023 Выполнение задач №000045823
	//Регистрируем ошибку проведения
	
	Запись = РегистрыСведений.тн_ОшибкиПроведенияДокументовПриЗагрузке.СоздатьМенеджерЗаписи();
	
	Запись.ДокументСсылка = Объект.Ссылка;
	Запись.ИДСообщения = messageGUID;
	Запись.ТребуемоеСостояниеПроведения = Объект.ДополнительныеСвойства.Posted;
