 #Область ОсновныеРеквизитыДляЗаполненияДокументовСЗавода 
 
// Белоконенко Денис 02.06.2022 Выполнение задач №000041465
Процедура ЗаполнитьОсновныеРеквизитыЗавода(ОсновныеРеквизиты, ДополнительныеСвойства) Экспорт
	ОсновныеРеквизиты.Вставить("Организация", 	
		ПолучитьОрганизацияПоИНН_КПП(ДополнительныеСвойства.organizationINN, ДополнительныеСвойства.organizationKPP));		
	ОсновныеРеквизиты.Вставить("Контрагент",  	
		// НАЧАЛО Белоконенко Денис 01.11.2022 Выполнение задач №000043186
		//ПолучитьКонтрагентПоИНН_КПП(ДополнительныеСвойства.counterpartyINN, ДополнительныеСвойства.counterpartyKPP));
		ПолучитьКонтрагентПоИНН_КПП(ДополнительныеСвойства.counterpartyINN, ДополнительныеСвойства.counterpartyKPP, ДополнительныеСвойства.ТипДоговора));
		// НАЧАЛО Белоконенко Денис 01.11.2022 Выполнение задач №000043186
	// НАЧАЛО Борисенко Игорь 19.07.2023 Выполнение задач №000046267	
	//ОсновныеРеквизиты.Вставить("Договор", 		
	//	ПолучитьДоговорПоОсновнымРеквизитам(ДополнительныеСвойства.contractNumber, ДополнительныеСвойства.contractDate, 
	//	ДополнительныеСвойства.ТипДоговора, ОсновныеРеквизиты.Контрагент, ОсновныеРеквизиты.Организация));
	Дата = ДополнительныеСвойства.contractDate;
	Если ТипЗнч(Дата) = Тип("Строка") Тогда
		Дата = тн_Интеграция_ERP_УХ.ДатаИзСтрокиUTC(Дата); 
	КонецЕсли;
	ОсновныеРеквизиты.Вставить("Договор", 		
		ПолучитьДоговорПоОсновнымРеквизитам(ДополнительныеСвойства.contractNumber, Дата, 
		ДополнительныеСвойства.ТипДоговора, ОсновныеРеквизиты.Контрагент, ОсновныеРеквизиты.Организация));
	// КОНЕЦ Борисенко Игорь 19.07.2023 Выполнение задач №000046267
	ОсновныеРеквизиты.Вставить("Склад", 		ПолучитьЕдиныйСкладОбменаСЗаводами());
	ОсновныеРеквизиты.Вставить("Подразделение", ПолучитьПодразделениеДляОтраженияВРегУчете());
	ОсновныеРеквизиты.Вставить("НоменклатураПродажиПоПереработке", ПолучитьНоменклатуруДляПродажиУслугПоПереработке());
КонецПроцедуры

