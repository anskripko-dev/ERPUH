Функция ВернутьВидыСообщенийЗапрещенныеКЗагрузке(БазаРеспондентИД, GUIDОрганизации)
	
	МассивВидовСообщенийЗапрещенныхКЗагрузке = Новый Массив;
	//НАЧАЛО Сафиуллина З.Р. 16.09.2025 Выполнение задач №000055082
	Если ЗначениеЗаполнено(GUIDОрганизации) Тогда
		Попытка
			УИД = Новый УникальныйИдентификатор(GUIDОрганизации);
			ОрганизацияСсылка = Справочники.Организации.ПолучитьСсылку(УИД);
			Если Не ОбщегоНазначения.СсылкаСуществует(ОрганизацияСсылка) Тогда
				ОрганизацияСсылка = Справочники.Организации.ПустаяСсылка();
			КонецЕсли;
		Исключение
			ОрганизацияСсылка = Справочники.Организации.ПустаяСсылка();
		КонецПопытки;
	Иначе
		ОрганизацияСсылка = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 16.09.2025 Выполнение задач №000055082
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БазаРеспондентИД", БазаРеспондентИД);
	//НАЧАЛО Сафиуллина З.Р. 16.09.2025 Выполнение задач №000055082
	//Запрос.Текст =
	//"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	тн_ИДБазРеспондентовЗапретыНаЗгрузку.ВидСообщения КАК ВидСообщения
	//|ИЗ
	//|	Справочник.тн_ИДБазРеспондентов.ЗапретыНаЗгрузку КАК тн_ИДБазРеспондентовЗапретыНаЗгрузку
	//|ГДЕ
	//|	(тн_ИДБазРеспондентовЗапретыНаЗгрузку.Ссылка.systemSender = &БазаРеспондентИД
	//|			ИЛИ тн_ИДБазРеспондентовЗапретыНаЗгрузку.Ссылка.Наименование = &БазаРеспондентИД)"; 
	Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
	Запрос.Текст =
	 "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	 |	тн_ИДБазРеспондентовЗапретыНаЗагрузку.ВидСообщения КАК ВидСообщения
	 |ПОМЕСТИТЬ ВТ_ЗапрещенныеВидыСообщений
	 |ИЗ
	 |	Справочник.тн_ИДБазРеспондентов.ЗапретыНаЗагрузку КАК тн_ИДБазРеспондентовЗапретыНаЗагрузку
	 |ГДЕ
	 |	(тн_ИДБазРеспондентовЗапретыНаЗагрузку.Ссылка.Наименование = &БазаРеспондентИД
	 |			ИЛИ тн_ИДБазРеспондентовЗапретыНаЗагрузку.Ссылка.systemSender = &БазаРеспондентИД)
	 |	И НЕ тн_ИДБазРеспондентовЗапретыНаЗагрузку.Ссылка.ПометкаУдаления
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	 |	тн_ИДБазРеспондентовРазрешенныеОрганизации.ВидСообщения КАК ВидСообщения,
	 |	тн_ИДБазРеспондентовРазрешенныеОрганизации.Организация КАК Организация
	 |ПОМЕСТИТЬ ВТ_РазрешенныеОрганизации
	 |ИЗ
	 |	Справочник.тн_ИДБазРеспондентов.РазрешенныеОрганизации КАК тн_ИДБазРеспондентовРазрешенныеОрганизации
	 |ГДЕ
	 |	(тн_ИДБазРеспондентовРазрешенныеОрганизации.Ссылка.Наименование = &БазаРеспондентИД
	 |			ИЛИ тн_ИДБазРеспондентовРазрешенныеОрганизации.Ссылка.systemSender = &БазаРеспондентИД)
	 |	И тн_ИДБазРеспондентовРазрешенныеОрганизации.Организация = &Организация
	 |	И НЕ тн_ИДБазРеспондентовРазрешенныеОрганизации.Ссылка.ПометкаУдаления
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВТ_ЗапрещенныеВидыСообщений.ВидСообщения КАК ВидСообщения
	 |ИЗ
	 |	ВТ_ЗапрещенныеВидыСообщений КАК ВТ_ЗапрещенныеВидыСообщений
	 |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РазрешенныеОрганизации КАК ВТ_РазрешенныеОрганизации
	 |		ПО ВТ_ЗапрещенныеВидыСообщений.ВидСообщения = ВТ_РазрешенныеОрганизации.ВидСообщения
	 |ГДЕ
	 |	ВТ_РазрешенныеОрганизации.Организация ЕСТЬ NULL";
	//КОНЕЦ Сафиуллина З.Р. 16.09.2025 Выполнение задач №000055082 
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		МассивВидовСообщенийЗапрещенныхКЗагрузке.Добавить(тн_Интеграция_УПП.ИмяЗначенияПеречисленияПоСсылке(Выборка.ВидСообщения));
	КонецЦикла;
	
	Возврат МассивВидовСообщенийЗапрещенныхКЗагрузке;
	
КонецФункции

Процедура ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип) Экспорт
	
	с = Новый Структура();
	
	//////////////////////////////////////////////////////////////////////////////////
	//Обработка без использования менеджеров объектов
	Если СтрНайти(сТип.Менеджер, "тн_Интеграция_ERP_УХ.РеализацияОтгруженныхТоваров")>0 Тогда
		
		РеализацияОтгруженныхТоваров_ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип, с);
		сТип.СоотвТеговИРеквизитов = с;
		
		Возврат;
	КонецЕсли;
	
	// НАЧАЛО Белоконенко Денис 02.06.2022 Выполнение задач №000041465
	Если СтрНайти(сТип.Менеджер, "тн_Интеграция_ERP_УХ.КаркасРеализацияГП")>0 Тогда
		
		КаркасРеализацияГП_ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип, с);
		сТип.СоотвТеговИРеквизитов = с;
		
		Возврат;
	КонецЕсли;
    // КОНЕЦ Белоконенко Денис 02.06.2022 Выполнение задач №000041465
	
	// НАЧАЛО Гутарова Екатерина 06.04.2023 Выполнение задач №000045095	 
	Если СтрНайти(сТип.Менеджер, "тн_Интеграция_ERP_УХ.ОтчетКомитентуОПродажах")>0 Тогда
		
		ОтчетКомитентуОПродажах_ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип, с);
		сТип.СоотвТеговИРеквизитов = с;
		
		Возврат;
	КонецЕсли;
    // КОНЕЦ Гутарова Екатерина 06.04.2023 Выполнение задач №000045095
	// НАЧАЛО Гутарова Екатерина 06.08.2023 Выполнение задач №000046448	
	Если СтрНайти(сТип.Менеджер, "тн_Интеграция_ERP_УХ.СтатьяЗатратНоменклатуры")>0 Тогда
		
		СтатьяЗатратНоменклатуры_ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип, с);
		сТип.СоотвТеговИРеквизитов = с;
		
		Возврат;
	КонецЕсли;
    // КОНЕЦ Гутарова Екатерина 06.08.2023 Выполнение задач №000046448		
	
	//////////////////////////////////////////////////////////////////////////////////
	//Справочники
	
	// НАЧАЛО Борисенко Игорь 01.02.2024 Выполнение задач №000048311
	//Если СтрНайти(сТип.Менеджер, "Справочники.")>0 Тогда
	Если СтрНайти(сТип.Менеджер, "Справочники.") > 0
		Или СтрНайти(сТип.Менеджер, "ПланыВидовХарактеристик.") > 0
		Тогда
	// КОНЕЦ Борисенко Игорь 01.02.2024 Выполнение задач №000048311
		с.Вставить("Наименование", "name");
		// НАЧАЛО Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		с.Вставить("ПометкаУдаления", "deletionMark");
		// КОНЕЦ Борисенко Игорь 01.05.2022 Выполнение задач №000041127
	КонецЕсли;
		
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//Документы
	
	Если СтрНайти(сТип.Менеджер, "Документы.")>0 Тогда
		с.Вставить("ДопСвойстваОбъекта_Posted", "Posted");
		// НАЧАЛО Борисенко Игорь 31.03.2023 Выполнение задач №000045010
		с.Вставить("ДопСвойстваОбъекта_deletionMark", "deletionMark");
		// КОНЕЦ Борисенко Игорь 31.03.2023 Выполнение задач №000045010
		с.Вставить("Номер", 		"Number");
		с.Вставить("Дата", 			"Date");
		// НАЧАЛО Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		с.Вставить("ПометкаУдаления", "deletionMark");
		// КОНЕЦ Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		с.Вставить("Организация", 	Новый Структура("Тег, Менеджер", "OrganizationGuid","Справочники.Организации"));
		с.Вставить("Контрагент", 	Новый Структура("Тег, Менеджер", "counterpartyGuid", "Справочники.Контрагенты"));
		с.Вставить("Подразделение", Новый Структура("Тег, Менеджер", "DepartmentGuid", 	"Справочники.СтруктураПредприятия"));
		// НАЧАЛО Борисенко Игорь 21.12.2023 Выполнение задач №000047903
		ИмяДокумента = СтрЗаменить(сТип.Менеджер, "Документы.", "");
		ОбъектМетаданных = Метаданные.Документы[ИмяДокумента];
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Автор", ОбъектМетаданных) Тогда
			с.Вставить("Автор"			, Новый Структура("Тег, Менеджер", "userGuid","Справочники.Пользователи"));
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Ответственный", ОбъектМетаданных) Тогда
			с.Вставить("Ответственный"	, Новый Структура("Тег, Менеджер", "userGuid","Справочники.Пользователи"));
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 21.12.2023 Выполнение задач №000047903
		// НАЧАЛО Белоконенко Денис 15.08.2024 Выполнение задач №000050268
		ЭлементСоставаОбщегоРеквизита = Метаданные.ОбщиеРеквизиты.тн_ПредставлениеДокументаУПП.Состав.Найти(ОбъектМетаданных);
		Если ЭлементСоставаОбщегоРеквизита <> Неопределено 
			И ЭлементСоставаОбщегоРеквизита.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать Тогда
			с.Вставить("тн_ПредставлениеДокументаУПП"	, "presentation");
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 15.08.2024 Выполнение задач №000050268		
	КонецЕсли;
	
	Выполнить(сТип.Менеджер + ".ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип, с)");
	
	Если сТип.Иерархия Тогда
		с.Вставить("Родитель",	Новый Структура("Тег, Менеджер", "parentGuid", сТип.Менеджер));
	КонецЕсли;
	
	сТип.СоотвТеговИРеквизитов = с;
	
	// НАЧАЛО Борисенко Игорь 12.03.2025 Выполнение задач №000052995
	Если тн_Интеграция_ERP_УХ.ОбъектуРазрешеноИгнорироватьДатуЗапрета(сТип.Менеджер) Тогда
		сТип.ОтключитьПроверкуДатыЗапрета = Истина;
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 12.03.2025 Выполнение задач №000052995
	
КонецПроцедуры // ()

