	ДатаПодмены = ТекущаяДатаСервера();
    //КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
    // КОНЕЦ Юдина Екатерина 23.01.2026 Выполнение задач №000056511
	
	Для каждого КлЗн Из СоотвТеговИРеквизитов Цикл       
				
		Если СтрНайти(КлЗн.Ключ, "ДопСвойстваОбъекта")=1 Тогда
			//Доп.свойство шапки
			
			Объект.ДополнительныеСвойства.Вставить(КлЗн.Значение, Объект_XDTO[КлЗн.Значение]);
			
		ИначеЕсли ТипЗнч(КлЗн.Значение) = Тип("Структура") И КлЗн.Значение.Свойство("Менеджер") Тогда
			//Ссылочное свойство
			
			Ссылка = ПолучитьСсылкуРеквизита(КлЗн.Значение, Объект_XDTO, Объект, сТип, Результат);
			//Объект[КлЗн.Ключ] = Неопределено; 
			
			// НАЧАЛО Юдина Екатерина 23.01.2026 Выполнение задач №000056511 
			Если КлЗн.Ключ = КлючПроверки Тогда    
				
				НастройкиЗагрузкиДанныхВЕРП = РегистрыСведений.тн_НастройкиЗагрузкиДанныхВЕРП.НастройкиЗагрузкиДанныхВЕРП(Ссылка); 
				
				Если НастройкиЗагрузкиДанныхВЕРП <> Неопределено 
					И ЗначениеЗаполнено(НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация)
					И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <> Дата(1,1,1)
					И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <= ДатаПодмены 
					И Объект[КлючПроверки] = НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация Тогда 
					
					Продолжить;  
					
				КонецЕсли;
			КонецЕсли;	
			// КОНЕЦ Юдина Екатерина 23.01.2026 Выполнение задач №000056511
			
			ЗаполнитьЗначениеРеквизита(Объект, КлЗн.Ключ, Неопределено);
