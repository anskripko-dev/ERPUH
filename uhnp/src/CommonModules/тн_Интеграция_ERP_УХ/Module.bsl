	Если ОбщегоНазначенияПовтИспУХ.ПолучитьЗначениеКонстанты("тн_ВключитьДополнительноеЛогированиеВЖурналРегистрации") Тогда
		
		ЗаписьЖурналаРегистрации("Добавление РС_ОчередьОжиданияЗагрузкиЗависимыхОбъектов", УровеньЖурналаРегистрации.Информация, 
		    Метаданные.РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов, , Строка(ВидДокумента) + "/" + Строка(ГУИД) + "/" + Строка(ИДСообщения));
		
	КонецЕсли;	
	// КОНЕЦ Юдина Екатерина 17.12.2025 Выполнение задач №000056166
	
КонецПроцедуры

// Шичкин Егор 22.12.2022 Выполнение задач №000043264
Процедура ОтметитьВыгруженныеДокументы(Сообщение, Параметры)

	СообщениеXDTO = ПрочитатьСообщениеJSON(Сообщение, "", Ложь, "");
	
	УИД = Новый УникальныйИдентификатор(СообщениеXDTO.guid);
	СФАванс = Документы.СчетФактураВыданныйАванс.ПолучитьСсылку(УИД);
	Если Не СФАванс.Пустая() Тогда
		
		СФАвансОбъект = СФАванс.ПолучитьОбъект();
		
		Если СФАвансОбъект <> Неопределено Тогда
			
			СФАвансОбъект.тн_ВыгруженВОКССбыт = Истина;
			СФАвансОбъект.ОбменДанными.Загрузка = Истина;
			
			Попытка 
				СФАвансОбъект.Записать();
			Исключение
				ЗаписатьЛогРаботы("Ошибка", Параметры.ДанныеДляЛогирования, "Не удалось записать отметку Выгружен в ОКС-Сбыт: " + СообщениеXDTO.guid);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 26.10.2021 Выполнение задач №000039141
Функция ВернутьПараметрыОбмена() Экспорт
	
	//Параметры выполнения обмена
	Параметры = Новый Структура;
	
	Параметры.Вставить("УзелПланаОбмена", тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас());             	//значение не важно
	Параметры.Вставить("ИспользоватьБлокировкиТранзакции", Ложь);
	
	// - xdto-пакет
	Параметры.Вставить("ИмяПакетаXDTO"		, "tn_integrationERP");
	Параметры.Вставить("ИмяТипаXDTO"		, "listObject");
	
	// - транспорт (RabbitMQ)
	Параметры.Вставить("Профиль"			, Справочники.тн_ПрофилиПодключений.ERP_УХ);
	Параметры.Вставить("ФорматСообщения"	, "JSON");
	Параметры.Вставить("ТочкаОбменаRabbitMQ", Справочники.ТочкиОбменаRMQ.ТекущаяБаза);
	Параметры.Вставить("КлючМаршрутизации"	, XMLСтрока(Справочники.тн_ПроизводственныеПодразделения.УПП_Каркас)); 	//значение не важно
	
	// - логирование
	Параметры.Вставить("Лог_ВидСообщения"	, Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена);
	Параметры.Вставить("Лог_ВидИнтеграции"	, Перечисления.тн_ВидыИнтеграций.ERP_УХ_Отправка);
	
	Возврат Параметры;
	
КонецФункции

