		// НАЧАЛО Борисенко Игорь 17.09.2024 Выполнение задач №000050836
		//Если Объект.Дата < ДатаНачалаВеденияУчета Тогда
		
		ТипыДокументовДопускающихЗагрузкуВЗакрытыйПериод = Новый Массив;
		ТипыДокументовДопускающихЗагрузкуВЗакрытыйПериод.Добавить(Тип("ДокументОбъект.ПервичныйДокумент"));
		ТипыДокументовДопускающихЗагрузкуВЗакрытыйПериод.Добавить(Тип("ДокументОбъект.СчетФактураВыданный"));
		ТипыДокументовДопускающихЗагрузкуВЗакрытыйПериод.Добавить(Тип("ДокументОбъект.СчетФактураПолученный"));
		
		Если Объект.Дата < ДатаНачалаВеденияУчета 
			И ТипыДокументовДопускающихЗагрузкуВЗакрытыйПериод.Найти(ТипЗнч(Объект)) = Неопределено
			Тогда
		// КОНЕЦ Борисенко Игорь 17.09.2024 Выполнение задач №000050836
			Объект.ОбменДанными.Загрузка = Ложь;
			Если Объект.Проведен Тогда
				Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Объект.ПометкаУдаления = Истина;
			Объект.Записать(РежимЗаписиДокумента.Запись);
		Иначе
		// КОНЕЦ Белоконенко Денис 22.02.2023 Выполнение задач №000044552
		
		//Записываем или Проводим
		
		Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			Объект.ОбменДанными.Загрузка = Истина;
		Иначе
			Объект.ОбменДанными.Загрузка = Ложь;
		КонецЕсли;
		
		// НАЧАЛО Борисенко Игорь 25.04.2023 Выполнение задач №000045286
		//Объект.Записать(РежимЗаписи);
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Если Не ОбщегоНазначения.СсылкаСуществует(Объект.Ссылка) Тогда
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.ОбменДанными.Загрузка = Ложь;
			КонецЕсли;

			// НАЧАЛО Борисенко Игорь 07.09.2023 Выполнение задач №000046776
			Если ВызыватьПроведениеСПроверкойЗаполненностиРеквизитов Тогда
			// КОНЕЦ Борисенко Игорь 07.09.2023 Выполнение задач №000046776

			МассивПроводимыхДокументов = Новый Массив;
			// НАЧАЛО Борисенко Игорь 20.12.2023 Выполнение задач №000047885
			//МассивПроводимыхДокументов.Добавить(Объект.Ссылка);
			МассивПроводимыхДокументов.Добавить(Объект);
			// КОНЕЦ Борисенко Игорь 20.12.2023 Выполнение задач №000047885
			// НАЧАЛО Борисенко Игорь 30.08.2023 Выполнение задач №000046702
			//ОбщегоНазначения.ПровестиДокументы(МассивПроводимыхДокументов); //Здесь в т.ч. вызывается ОбработкаПроверкиЗаполнения()
			// НАЧАЛО Борисенко Игорь 20.12.2023 Выполнение задач №000047885
			//НепроведенныеДокументы = ОбщегоНазначения.ПровестиДокументы(МассивПроводимыхДокументов); //Здесь в т.ч. вызывается ОбработкаПроверкиЗаполнения()
			НепроведенныеДокументы = тн_ПровестиДокументы(МассивПроводимыхДокументов); //Здесь в т.ч. вызывается ОбработкаПроверкиЗаполнения()
			// КОНЕЦ Борисенко Игорь 20.12.2023 Выполнение задач №000047885
			
			Если НепроведенныеДокументы.Количество() > 0 Тогда
				ОписаниеОшибки = НепроведенныеДокументы[0].ОписаниеОшибки;
				
				// НАЧАЛО Борисенко Игорь 08.11.2023 Выполнение задач №000047396
				Для Каждого НепроведенныйДокумент Из НепроведенныеДокументы Цикл
					ДокументСсылка = НепроведенныйДокумент.Ссылка;
					Если ДокументСсылка.Проведен Тогда
						//Отменяем проведение
						ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
						ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					КонецЕсли;
				КонецЦикла;
				// КОНЕЦ Борисенко Игорь 08.11.2023 Выполнение задач №000047396
		
			КонецЕсли;
			// КОНЕЦ Борисенко Игорь 30.08.2023 Выполнение задач №000046702
			// НАЧАЛО Борисенко Игорь 07.08.2023 Выполнение задач №000046471
			// НАЧАЛО Борисенко Игорь 30.08.2023 Выполнение задач №000046705
			//Объект = МассивПроводимыхДокументов[0].ПолучитьОбъект();
			Объект.Прочитать();
			// КОНЕЦ Борисенко Игорь 30.08.2023 Выполнение задач №000046705
			// КОНЕЦ Борисенко Игорь 07.08.2023 Выполнение задач №000046471
			
			// НАЧАЛО Князева Анна 03.06.2025 Выполнение задач №000053907
			ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ОтражениеЗарплатыВФинансовомУчете") Тогда 
				СтруктураПроверкиЗаполнения = Документы.ОтражениеЗарплатыВФинансовомУчете.ПроверкаЗаполненностиСпособовОтражения(Объект);
				
				Если СтруктураПроверкиЗаполнения.Успех Тогда
					Объект.Записать(РежимЗаписи); 
				Иначе
					ОписаниеОшибки = СтруктураПроверкиЗаполнения.ОписаниеОшибки; 
				КонецЕсли;
			// КОНЕЦ Князева Анна 03.06.2025 Выполнение задач №000053907

			// НАЧАЛО Борисенко Игорь 07.09.2023 Выполнение задач №000046776
			Иначе
				Объект.Записать(РежимЗаписи);
			КонецЕсли;
			// КОНЕЦ Борисенко Игорь 07.09.2023 Выполнение задач №000046776
		Иначе
			Объект.Записать(РежимЗаписи);
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 25.04.2023 Выполнение задач №000045286

		Объект.ОбменДанными.Загрузка = Ложь;
		
		// НАЧАЛО Белоконенко Денис 22.02.2023 Выполнение задач №000044552
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 22.02.2023 Выполнение задач №000044552
	КонецЕсли;
	
КонецПроцедуры

// НАЧАЛО Борисенко Игорь 20.12.2023 Выполнение задач №000047885
// На основе типовой ОбщегоНазначения.ПровестиДокументы(), но может работать с ДокументОбъект (а не только с ДокументСсылка), сохраняя Объект.ДополнительныеСвойства
Функция тн_ПровестиДокументы(Документы)

	НепроведенныеДокументы = Новый Массив;

	Для Каждого ДокументСсылка Из Документы Цикл

		ВыполненоУспешно = Ложь;

		Если ДокументСсылка <> ДокументСсылка.Ссылка Тогда //Передан ДокументОбъект, а не ДокументСсылка
			ДокументОбъект = ДокументСсылка;
			ДокументСсылка = ДокументСсылка.Ссылка;
		Иначе
			//Типовой код
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		КонецЕсли;

		Если ДокументОбъект.ПроверитьЗаполнение() Тогда
			РежимПроведения = РежимПроведенияДокумента.Неоперативный;
			Если ДокументОбъект.Дата >= НачалоДня(ТекущаяДатаСеанса())
				И ДокументСсылка.Метаданные().ОперативноеПроведение = Метаданные.СвойстваОбъектов.ОперативноеПроведение.Разрешить Тогда
				РежимПроведения = РежимПроведенияДокумента.Оперативный;
			КонецЕсли;
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);
				ВыполненоУспешно = Истина;
			Исключение
				ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
		Иначе
			ПредставлениеОшибки = НСтр("ru = 'Поля документа не заполнены.';
			|en = 'Document fields cannot be empty.'");
		КонецЕсли;

		Если Не ВыполненоУспешно Тогда
			НепроведенныеДокументы.Добавить(Новый Структура("Ссылка,ОписаниеОшибки", ДокументСсылка, ПредставлениеОшибки));
		КонецЕсли;

	КонецЦикла;

	Возврат НепроведенныеДокументы;

КонецФункции

// Белоконенко Денис 01.11.2022 Выполнение задач №000043186
Процедура ПослеПроведенияДополнительныеМетоды(Объект, Результат)
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") И
		Объект.ДополнительныеСвойства.Свойство("ДопСвойстваТЧОбъекта_TableReceiptOrder") Тогда		
		Выполнить("Документы.ПриобретениеТоваровУслуг.тн_ЗаполнитьРаспоряжениеПриходногоОрдера(Объект.ДополнительныеСвойства.ДопСвойстваТЧОбъекта_TableReceiptOrder, Объект.Ссылка, Результат)");			
	// НАЧАЛО Белоконенко Денис 30.10.2025 Выполнение задач №000055366 
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.КорректировкаЗадолженности")
		И Объект.ДополнительныеСвойства.Свойство("operationType")
		И (Объект.ДополнительныеСвойства.operationType = "ПретензияРублиОКС"
		Или Объект.ДополнительныеСвойства.operationType = "ПретензияВалюта") Тогда 
		        
		Выполнить("Документы.КорректировкаРегистров.ЗаполнитьДвиженияСторноПоПретензиямПриЗагрузке(Объект, Результат)");
	// КОНЕЦ Белоконенко Денис 30.10.2025 Выполнение задач №000055366		
	КонецЕсли;    
	
	// НАЧАЛО Юдина Екатерина 17.06.2025 Выполнение задач №000054100   
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда	
		Если Объект.Товары.Количество() > 0 
			И Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНаЭкспорт 
			И тн_ОбщегоНазначения.ПрименяетсяОпределениеКодаОперацииПоРСКодыВидаОперацийОтгрузки(Объект.Организация, Объект.Дата) Тогда
			Выполнить("Документы.РеализацияТоваровУслуг.тн_ПерезаполнитьСведенияТаможенныхДекларацийЭкспорт(Объект.Ссылка, Результат)");			
		КонецЕсли;  
	КонецЕсли; 
	// КОНЕЦ Юдина Екатерина 17.06.2025 Выполнение задач №000054100 
	
КонецПроцедуры

Процедура ВставитьДополнительныеСвойстваТЧ(Объект, Объект_XDTO, КлЗн)
	//Создадим таблицу значений, которую наполним значениями доп.полей и затем сохраним тз в доп.свойства
	
	СтруктураДопСвойства = КлЗн.Значение;
	
	тзДопСвойства = Новый ТаблицаЗначений;
	Для каждого ПолеТЧ Из СтруктураДопСвойства.ПоляТЧ Цикл
		тзДопСвойства.Колонки.Добавить(ПолеТЧ.Ключ);
	КонецЦикла;
	
	Объект_XDTO_ТЧ = Объект_XDTO[СтруктураДопСвойства.ТегТЧ];
	
	Если Объект_XDTO_ТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаXDTO_ТЧ Из  Объект_XDTO_ТЧ.string Цикл
		
		СтрокаТЗ = тзДопСвойства.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, СтрокаXDTO_ТЧ);
		
	КонецЦикла;
	
	Объект.ДополнительныеСвойства.Вставить(КлЗн.Ключ, тзДопСвойства);
	
КонецПроцедуры       

// Юдина (Гутарова) Екатерина 16.10.2024 Выполнение задач №000051189 
//  
// Создает структуру, которую наполняет значениями доп.полей и затем сохраняет ее в доп.свойства объекта
// 
Процедура ВставитьДополнительныеСвойстваЭлемента(Объект, Объект_XDTO, КлЗн, сТип, Результат)
	
	СтруктураДопСвойства = КлЗн.Значение;
	СтруктураРезультат = Новый Структура;
	Объект_XDTO_Элемента = Объект_XDTO[СтруктураДопСвойства.Тег];
	
	Если Объект_XDTO_Элемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПолеЭлемента Из СтруктураДопСвойства.ПоляЭлемента Цикл
		
		ЗначениеРеквизита = Неопределено;
		
		Если ТипЗнч(ПолеЭлемента.Значение) = Тип("Структура") 
			И ПолеЭлемента.Значение.Свойство("Менеджер") Тогда 
			
			ЗначениеРеквизита = ПолучитьСсылкуРеквизита(ПолеЭлемента.Значение, Объект_XDTO_Элемента, Объект, сТип, Результат);
			
		ИначеЕсли ТипЗнч(ПолеЭлемента.Значение) = Тип("Структура") 
			И ПолеЭлемента.Значение.Свойство("Код1с") Тогда	
			
			Тег = Вычислить("Объект_XDTO." + ПолеЭлемента.Значение.Тег);
			Попытка
				ЗначениеРеквизита = Вычислить(ПолеЭлемента.Значение.Код1с);
			Исключение
				ЗначениеРеквизита = Неопределено;
			КонецПопытки;      
			
		Иначе	   
			
			ЗначениеРеквизита = Объект_XDTO_Элемента[ПолеЭлемента.Ключ];
			
		КонецЕсли;
		СтруктураРезультат.Вставить(ПолеЭлемента.Ключ, ЗначениеРеквизита);
		
	КонецЦикла;
	
	Объект.ДополнительныеСвойства.Вставить(КлЗн.Ключ, СтруктураРезультат);
	
КонецПроцедуры   
		
// Османов Нагим 30.09.2022 Выполнение задач №000042773
Процедура ЗагрузитьРегистрСведений(сТип, Объект_XDTO, Результат)
	
