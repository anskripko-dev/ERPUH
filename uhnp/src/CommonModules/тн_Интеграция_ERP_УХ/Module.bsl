// Борисенко Игорь 30.03.2022 Выполнение задач №000040817
Процедура ПолучениеСообщенийRMQ_БезОбработки(ТекстСообщенияJSON, СвойстваСообщения = Неопределено, ПодпискаНаОчередь = Неопределено, Отказ = Ложь, ВернутьВОчередь = Ложь, ПовторнаяОбработка = Ложь) Экспорт

	tn_message_format = ПолучитьФорматСообщения(СвойстваСообщения); 	
	Если tn_message_format <> Неопределено Тогда
		ТекстСообщенияJSON = ДобавитьЗаголовокСообщенияJSON(ТекстСообщенияJSON, tn_message_format);
	КонецЕсли;  

	// НАЧАЛО Борисенко Игорь 01.09.2022 Выполнение задач №000042471
	// Контроль дублей по тексту сообщения
	ДубльИД = НайтиДубльСообщения(ТекстСообщенияJSON);
	Если ДубльИД <> Неопределено Тогда
		
		//Логируем информацию о дубле
		Параметры =    ВернутьПараметрыОбмена();
		Параметры.Вставить("Лог_ВидИнтеграции", Перечисления.тн_ВидыИнтеграций.ERP_УХ_Получение);
		ДанныеДляЛогирования = ПолучитьДанныеДляЛогирования(Параметры.Лог_ВидСообщения, , , Параметры.Профиль.ВестиЛоги);
		ДанныеДляЛогирования_Заполнить_БазаРеспондентИД(ДанныеДляЛогирования, ТекстСообщенияJSON, СвойстваСообщения);
		Параметры.Вставить("ДанныеДляЛогирования", ДанныеДляЛогирования);
		// НАЧАЛО Юдина Екатерина 28.10.2024 Выполнение задач №000051341
		//ОписаниеОшибки = "Отказ принятия в очередь дубля для: " + ДубльИД;
		ОписаниеОшибки = "Отказ принятия в очередь дубля для: " + ДубльИД + Символы.ПС + ТекстСообщенияJSON;
		// КОНЕЦ Юдина Екатерина 28.10.2024 Выполнение задач №000051341       
		
		// НАЧАЛО Юдина Екатерина 14.05.2025 Выполнение задач №000053673 
		Если Параметры.Лог_ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена Тогда  
			Параметры.Лог_ВидСообщения                  = ПолучитьВидСообщенияЛогированияИзТекстаСообщения(ТекстСообщенияJSON);  
			ДанныеДляЛогирования.ВидСообщения = Параметры.Лог_ВидСообщения;   
		КонецЕсли;                    
		// КОНЕЦ Юдина Екатерина 14.05.2025 Выполнение задач №000053673
		ЗаписатьЛогРаботы("Ошибка", ДанныеДляЛогирования, ОписаниеОшибки);
		
		Возврат; //не ставим в очередь
		
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 01.09.2022 Выполнение задач №000042471
	
	ТипЗапроса = "";
	Если СвойстваСообщения.Свойство("Тип") Тогда
		ТипЗапроса = СвойстваСообщения.Тип;
	КонецЕсли;
	// НАЧАЛО Борисенко Игорь 20.07.2022 Выполнение задач №000041905
	поз = СтрНайти(ТипЗапроса, "_v");
	Если поз > 0 Тогда
		//Отрезаем "версию json"
		ТипЗапроса = Лев(ТипЗапроса, поз - 1);
		
		//Отрезаем "имена баз-корреспондентов"
		поз = СтрНайти(ТипЗапроса, "_");
		Если поз > 0 Тогда
			ТипЗапроса = Сред(ТипЗапроса, поз + 1);
		КонецЕсли;
		
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 20.07.2022 Выполнение задач №000041905
	
	// НАЧАЛО Борисенко Игорь 09.05.2022 Выполнение задач №000041174
	//Если ТипЗапроса не получен из свойств сообщений, тогда найдем его из текста сообщения
	Если Не ЗначениеЗаполнено(ТипЗапроса) Тогда
		
		ТекстПоиска = Лев(ТекстСообщенияJSON, 500);
		позТипа = СтрНайти(ТекстПоиска, "catalog");
		Если позТипа = 0 Тогда
			позТипа = СтрНайти(ТекстПоиска, "document");
		КонецЕсли;
		Если позТипа = 0 Тогда
			позТипа = СтрНайти(ТекстПоиска, "registr");
		КонецЕсли;
		
		Если позТипа > 0 Тогда
			ТекстПоиска = Сред(ТекстПоиска,позТипа);
			позКонца = СтрНайти(ТекстПоиска,": [");
			
			Если позКонца > 0 Тогда
				ТипЗапроса = Лев(ТекстПоиска, позКонца - 2);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 09.05.2022 Выполнение задач №000041174
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 04.04.2024 Выполнение задач №000049104  				
	// РегистрыСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ДобавитьСообщение(ТекстСообщенияJSON, ТипЗапроса, СериализоватьДанные(СвойстваСообщения));
	// КОНЕЦ Юдина (Гутарова) Екатерина 04.04.2024 Выполнение задач №000049104  				
	
	//Отправка отметки "Сообщение доставлено"
	Параметры =	ВернутьПараметрыОбмена();
	Параметры.Вставить("Лог_ВидИнтеграции", Перечисления.тн_ВидыИнтеграций.ERP_УХ_Получение);
	ДанныеДляЛогирования = ПолучитьДанныеДляЛогирования(Параметры.Лог_ВидСообщения, , , Параметры.Профиль.ВестиЛоги);
	// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	ДанныеДляЛогирования_Заполнить_БазаРеспондентИД(ДанныеДляЛогирования, ТекстСообщенияJSON, СвойстваСообщения);
	// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	Параметры.Вставить("ДанныеДляЛогирования", ДанныеДляЛогирования);
	
	ЕстьОшибка = Ложь;
	ОписаниеОшибки = "";
	СообщениеXDTO = ПрочитатьСообщениеJSON(ТекстСообщенияJSON, Параметры.ДанныеДляЛогирования, ЕстьОшибка, ОписаниеОшибки);
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 04.04.2024 Выполнение задач №000049104 
	ИДСообщения = Неопределено;
	Если СообщениеXDTO <> Неопределено Тогда
		Попытка
			ИДСообщения = СообщениеXDTO.headers.messageGUID;    
		Исключение
		КонецПопытки;       
	КонецЕсли;
	
	// НАЧАЛО Чекордина Ирина 06.06.2025 Выполнение задач №000053932
