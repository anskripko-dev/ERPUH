	Отражение.Аналитика2Поставка 			= неопределено;
	Отражение.Аналитика3Поставка 			= неопределено;
	Отражение.Аналитика4Поставка 			= неопределено;
	Отражение.Аналитика5Поставка 			= неопределено;
	Отражение.Аналитика6Поставка 			= неопределено;

	Отражение.ВидБюджета					= ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
	Отражение.ДокументПланирования			= Документы.Резервирование.ПустаяСсылка();
	Отражение.СтатьяБюджета	  				= КэшируемыеПроцедурыОПК.ПустаяСтатьяДвиженияДенежныхСредств();
	Отражение.Аналитика1		  			= неопределено;
	Отражение.Аналитика2		  			= неопределено;
	Отражение.Аналитика3		  			= неопределено;
	Отражение.Аналитика4		  			= неопределено;
	Отражение.Аналитика5		  			= неопределено;
	Отражение.Аналитика6		  			= неопределено;
	
