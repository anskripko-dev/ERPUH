Процедура ЗаполнитьНоменклатуруЗаказаПоставщикуПоДоговору(
										ЗаказПоставщикуОбъект) Экспорт
	РезультатЗапроса = ПолучитьРезультатЗапросаОстатковДляЗаказаПоставщику(
		ЗаказПоставщикуОбъект);
      
	Товары = ПланированиеПотребностей.ЗаменаСтатейИАналитикПоНастройкамЛимитов(ЗаказПоставщикуОбъект.Дата,РезультатЗапроса.Выгрузить());	
	Товары.Колонки.Добавить("СтатьяБюджетаБДДС",);
	Товары.Колонки.Добавить("АналитикаБДДС1",);
	Товары.Колонки.Добавить("АналитикаБДДС2",);
	Товары.Колонки.Добавить("АналитикаБДДС3",);
	Товары.Колонки.Добавить("АналитикаБДДС4",);
	Товары.Колонки.Добавить("АналитикаБДДС5",);
	Товары.Колонки.Добавить("АналитикаБДДС6",);	 
	ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(ЗаказПоставщикуОбъект.Дата);	
	
	Для Каждого Строка ИЗ Товары Цикл      
		
		УпаковкаНоменклатура = Неопределено;
		ПараметрыПересчета = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.НормализоватьПараметрыПересчетаЕдиниц(Строка, УпаковкаНоменклатура);
		Если ЗначениеЗаполнено(ПараметрыПересчета.Номенклатура) Тогда
			
			КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
			
			ДанныеУпаковки = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьКоэффициентУпаковки(ПараметрыПересчета.Упаковка, КэшированныеЗначения, ПараметрыПересчета.Номенклатура);
			Количество = Строка.КоличествоУпаковок * ДанныеУпаковки.Коэффициент;
		    

			Если ДанныеУпаковки.НужноОкруглятьКоличество
				И ПараметрыПересчета.НужноОкруглять Тогда
				Строка.Количество = Окр(Количество, 0 ,РежимОкругления.Окр15как20);
			Иначе
				Строка.Количество = Количество;
			КонецЕсли;
		ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка, "КоличествоУпаковок") Тогда
			Строка.Количество = Строка.КоличествоУпаковок;
		КонецЕсли;
		
		Если ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов Тогда 	
		Строка.СтатьяБюджетаБДР= Строка.СтатьяБюджета;
		Строка.АналитикаБДР1 	 = Строка.Аналитика1;	
		Строка.АналитикаБДР2 	 = Строка.Аналитика2;	
		Строка.АналитикаБДР3 	 = Строка.Аналитика3;	
		Строка.АналитикаБДР4 	 = Строка.Аналитика4;	
		Строка.АналитикаБДР5 	 = Строка.Аналитика5;	
		Строка.АналитикаБДР6 	 = Строка.Аналитика6;
		ИначеЕсли ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда 	
		Строка.СтатьяБюджетаБДДС= Строка.СтатьяБюджета;
		Строка.АналитикаБДДС1 	 = Строка.Аналитика1;	
		Строка.АналитикаБДДС2 	 = Строка.Аналитика2;	
		Строка.АналитикаБДДС3 	 = Строка.Аналитика3;	
		Строка.АналитикаБДДС4 	 = Строка.Аналитика4;	
		Строка.АналитикаБДДС5 	 = Строка.Аналитика5;	
		Строка.АналитикаБДДС6 	 = Строка.Аналитика6;
        КонецЕсли;
		
	КонецЦикла;	
	ЗаказПоставщикуОбъект.Товары.Загрузить(Товары);
	ДоговорКонтрагента = ПолучитьДоговор(ЗаказПоставщикуОбъект);
	//ЗаказПоставщикуОбъект.ЭтапыГрафикаОплаты.Загрузить(ДоговорКонтрагента.ВерсияСоглашения.ЭтапыГрафикаОплаты.Выгрузить());
	Для каждого Стр Из ЗаказПоставщикуОбъект.Товары Цикл   
		Стр.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
			Стр.СуммаСНДС, 
			Истина,
				Стр.СтавкаНДС.Ставка);   
		Если ЗаказПоставщикуОбъект.ЦенаВключаетНДС Тогда		
			Стр.Сумма = Стр.СуммаСНДС;       
		Иначе
			Стр.Сумма = Стр.СуммаСНДС - Стр.СуммаНДС;       
		КонецЕсли;	
		Если НЕ ЗаказПоставщикуОбъект.ЦенаВключаетНДС Тогда
			// пересчитаем цену без НДС, т.к. в запросе она с НДС
			Количество = ?(Стр.Количество = 0, 1, Стр.Количество);
			Стр.Цена = Окр(Стр.Сумма / Количество, 2);
		КонецЕсли;
		// Все места поставки в ТЧ одинаковы
	КонецЦикла;
	ЗаказПоставщикуОбъект.СуммаДокумента = 
		ЗаказПоставщикуОбъект.Товары.Итог("СуммаСНДС");
	ЗаказПоставщикуОбъект.СуммаНДС = 
		ЗаказПоставщикуОбъект.Товары.Итог("СуммаНДС");
КонецПроцедуры

// Возвращает массив содержащий подмножество значений
// перечисления ВариантыИспользованияХарактеристикНоменклатуры
// соотвествующие использованию характеристик.
//
Функция ПолучитьЗначенияИспользованияХарактеристик() Экспорт
	мРезультат = Новый Массив;
	мРезультат.Добавить(
		Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры);
	мРезультат.Добавить(
		Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры);
	мРезультат.Добавить(
		Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры);
	Возврат мРезультат;
КонецФункции

// Возвращает Истина, если ИспользованиеХарактеристик - это значение,
