
#Область ПрограммныйИнтерфейс  

Процедура ИнициализироватьДанныеЗаказа(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено, ПриобретениеФинансовыхУслуг = Ложь) Экспорт

	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапросПоЗаказу(Запрос, ДокументСсылка);  
	
	Если ПриобретениеФинансовыхУслуг Тогда
		ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ТаблицаОперацииБюджетов");
		Возврат;
	КонецЕсли;
	
	// Заказ поставщику
	ИменаРеквизитов 	= "ГрафикДоговора, ПорядокРасчетов";
	РеквизитыДоговора 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Запрос.Параметры.Договор, ИменаРеквизитов);
	РеквизитыДоговора.Вставить("Договор", Запрос.Параметры.Договор);
	Если НЕ ЗначениеЗаполнено(РеквизитыДоговора) Тогда
		Возврат;
	КонецЕсли;                                        
	
	ПорядокРасчетовПоЗаказам = РеквизитыДоговора.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
	
	// Планирование потребностей пишется всегда
	ПараметрыПланирования = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ПодготовитьПараметрыПланированияПотребностейЗаказа(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
	ПараметрыПланирования.Вставить("ДокументРезервирования", Истина);
	ПараметрыПланирования.Вставить("ТолькоПланыПоПоставке", Истина);
	ПараметрыПланирования.Вставить("ОтражатьВБюджетах", Истина);

	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	
	Если РеквизитыДоговора.ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикПоставок
			И ПланированиеПотребностей.СквозноеПланированиеПотребностей()
			И РеквизитыДоговора.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда
		ПараметрыПланирования.Вставить("ТолькоПланыПоПоставке", Ложь);
	КонецЕсли;
	
	ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений;
	ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры,, ПараметрыПланирования);
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросПоЗаказу(Запрос, Объект)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, "Ссылка, Дата, Проведен, Валюта, Организация, Контрагент, Договор");
	Для Каждого КлючЗначение Из РеквизитыДокумента Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла; 
	
КонецПроцедуры       

Процедура СформироватьСписокРегистровДляКонтроля(Источник)
	
	Массив = Новый Массив;
	Источник.ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);

КонецПроцедуры

Процедура ИнициализироватьДанныеПоступления(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт

	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ИнициализироватьЗапросПоступления(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	//ТекстЗапроса_ТаблицаОперацииБюджетов(Запрос, ТекстыЗапроса, Регистры);
	ТаблицаОперацииБюджетов(Запрос, ТекстыЗапроса, Регистры);
	
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);

КонецПроцедуры

Процедура ТаблицаОперацииБюджетов(Запрос, ТекстыЗапроса, Регистры) Экспорт
	
	ИмяРегистра = "ТаблицаОперацииБюджетов2";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Ссылка КАК Регистратор,
	|	Запрос.Раздел КАК Раздел,
	|	Запрос.ВидБюджета КАК ВидБюджета,
	|	Запрос.ДатаОперации КАК ДатаОперации,
	|	Запрос.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	Запрос.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	Запрос.АналитикаПотребностей КАК АналитикаПотребностей,
	|	Запрос.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	Запрос.АналитикаПартнеров КАК АналитикаПартнеров,
	|	Запрос.ДокументПланирования КАК ДокументПланирования,
	|	Запрос.АналитикаИсточника КАК АналитикаИсточника,
	|	Запрос.Валюта КАК Валюта,
	|	СУММА(Запрос.ЗапланированоКоличество) КАК ЗапланированоКоличество,
	|	СУММА(Запрос.Запланировано) КАК Запланировано,
	|	СУММА(Запрос.ИсполненоКоличество) КАК ЗаявленоКоличество,
	|	СУММА(Запрос.Исполнено) КАК Заявлено
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_ПланыДокумента.РазделИсточника КАК Раздел,
	|		ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|		ВТ_ПланыДокумента.ДатаОперацииИсточника КАК ДатаОперации,
	|		ВТ_ПланыДокумента.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|		ВТ_ПланыДокумента.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|		ВТ_ПланыДокумента.АналитикаПотребностей КАК АналитикаПотребностей,
	|		ВТ_ПланыДокумента.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|		ВТ_ПланыДокумента.АналитикаПартнеров КАК АналитикаПартнеров,
	|		ВТ_ПланыДокумента.ДокументПланированияИсточника КАК ДокументПланирования,
	|		ВТ_ПланыДокумента.АналитикаИсточника КАК АналитикаИсточника,
	|		ВТ_ПланыДокумента.Валюта КАК Валюта,
	|		0 КАК ЗапланированоКоличество,
	|		0 КАК Запланировано,
	|		ВТ_ПланыДокумента.КоличествоИсточника КАК ИсполненоКоличество,
	|		ВТ_ПланыДокумента.СуммаИсточника КАК Исполнено
	|	ИЗ
	|		ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_ПланыДокумента.Раздел,
	|		ВТ_ПланыДокумента.ВидБюджета,
	|		ВТ_ПланыДокумента.ДатаОперации,
	|		ВТ_ПланыДокумента.АналитикаСтруктуры,
	|		ВТ_ПланыДокумента.АналитикаСтатейБюджетов,
	|		ВТ_ПланыДокумента.АналитикаПотребностей,
	|		ВТ_ПланыДокумента.АналитикаНоменклатуры,
	|		ВТ_ПланыДокумента.АналитикаПартнеров,
	|		ВТ_ПланыДокумента.ДокументПланирования,
	|		ВТ_ПланыДокумента.АналитикаИсточника,
	|		ВТ_ПланыДокумента.Валюта,
	|		ВТ_ПланыДокумента.Количество,
	|		ВТ_ПланыДокумента.Сумма,
	|		0,
	|		0
	|	ИЗ
	|		ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_ПланыДокумента.Раздел,
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
	|		ДОБАВИТЬКДАТЕ(ВТ_ПланыДокумента.ДатаОперации, ДЕНЬ, ВТ_ОтносительныеДниОплаты.День),
	|		ВТ_ПланыДокумента.АналитикаСтруктуры,
	|		ВТ_ПланыДокумента.АналитикаСтатейБюджетов,
	|		ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка),
	|		ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка),
	|		ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаПоПартнерам.ПустаяСсылка),
	|		ВТ_ПланыДокумента.ДокументПланирования,
	|		ЗНАЧЕНИЕ(Справочник.КлючиИсточникаОперацийБюджетов.ПустаяСсылка),
	|		ВТ_ПланыДокумента.Валюта,
	|		0,
	|		ВЫРАЗИТЬ(ВТ_ПланыДокумента.Сумма * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)),
	|		0,
	|		0
	|	ИЗ
	|		ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
	|			ПО ВТ_ПланыДокумента.ВариантОплаты = ВТ_ОтносительныеДниОплаты.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_ПланыДокумента.РазделИсточника,
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
	|		ДОБАВИТЬКДАТЕ(ВТ_ПланыДокумента.ДатаОперацииИсточника, ДЕНЬ, ВТ_ОтносительныеДниОплаты.День),
	|		ВТ_ПланыДокумента.АналитикаСтруктуры,
	|		ВТ_ПланыДокумента.АналитикаСтатейБюджетов,
	|		ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка),
	|		ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка),
	|		ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаПоПартнерам.ПустаяСсылка),
	|		ВТ_ПланыДокумента.ДокументПланированияИсточника,
	|		ЗНАЧЕНИЕ(Справочник.КлючиИсточникаОперацийБюджетов.ПустаяСсылка),
	|		ВТ_ПланыДокумента.Валюта,
	|		0,
	|		-ВЫРАЗИТЬ(ВТ_ПланыДокумента.СуммаИсточника * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)),
	|		0,
	|		0
	|	ИЗ
	|		ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
	|			ПО ВТ_ПланыДокумента.ВариантОплатыИсточника = ВТ_ОтносительныеДниОплаты.Ссылка) КАК Запрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.АналитикаНоменклатуры,
	|	Запрос.ДокументПланирования,
	|	Запрос.АналитикаПотребностей,
	|	Запрос.АналитикаИсточника,
	|	Запрос.ДатаОперации,
	|	Запрос.Раздел,
	|	Запрос.Валюта,
	|	Запрос.ВидБюджета,
	|	Запрос.АналитикаСтатейБюджетов,
	|	Запрос.АналитикаПартнеров,
	|	Запрос.АналитикаСтруктуры";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

Процедура ОтразитьОперацииЗаказа(ДополнительныеСвойства, Движения, Отказ) Экспорт

	Таблица= ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОперацииБюджетов2;
	
	Если Отказ ИЛИ Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Движения.ОперацииБюджетов2.Записывать = Истина;
	Движения.ОперацииБюджетов2.Загрузить(Таблица);
	
КонецПроцедуры

// Получить вид операции поступления по виду операции реализации.
//
// Параметры:
//  ВидОперацииРеализации - ПеречислениеСсылка.ВидыОперацийРеализацияТоваров - вид операции реализации.
// 
// Возвращаемое значение:
//   - ПеречислениеСсылка.ВидыОперацийПоступленияТоваров
//
Функция ПолучитьВидОперацииПоступленияПоВидуОперацииРеализации(ВидОперацииРеализации) Экспорт
	ВидПоступленияПоРеализации = Новый Соответствие;
	ВидПоступленияПоРеализации.Вставить(
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийРеализацияТоваровОборудование(),
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийПоступлениеТоваровУслугОборудование());
	ВидПоступленияПоРеализации.Вставить(
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийРеализацияТоваровОтгрузкаБезПереходаПраваСобственности(),
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийПоступлениеТоваровУслугТовары());
	ВидПоступленияПоРеализации.Вставить(
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийРеализацияТоваровПродажаКомиссия(),
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийПоступлениеТоваровУслугПокупкаКомиссия());
	ВидПоступленияПоРеализации.Вставить(
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийРеализацияТоваровТовары(),
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийПоступлениеТоваровУслугПокупкаКомиссия());
	ВидПоступленияПоРеализации.Вставить(
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийРеализацияТоваровУслуги(),
		ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийПоступлениеТоваровУслугУслуги());
	ВидОперацииПоступления = ВидПоступленияПоРеализации[ВидОперацииРеализации];
	Если ВидОперацииПоступления <> Неопределено Тогда
		Возврат ВидОперацииПоступления;
	КонецЕсли;
	
	Возврат ВзаиморасчетыВстраиваниеУХКлиентСервер.ВидыОперацийПоступлениеТоваровУслугПустаяСсылка();
КонецФункции

Функция ДополнитьСтрокиЗаказаПоПТУ(СтрокаТоваров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", СтрокаТоваров.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", СтрокаТоваров.Характеристика);
	Запрос.УстановитьПараметр("КодСтроки", СтрокаТоваров.КодСтроки);
	Запрос.УстановитьПараметр("ЗаказПоставщику", СтрокаТоваров.ЗаказПоставщику);
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ЗаказПоставщикуТовары.ЦФО КАК ЦФО,
	                |	ЗаказПоставщикуТовары.Проект КАК Проект,
	                |	ЗаказПоставщикуТовары.СтатьяБюджетаБДДС КАК СтатьяБюджетаБДДС,
	                |	ЗаказПоставщикуТовары.АналитикаБДДС1 КАК АналитикаБДДС1,
	                |	ЗаказПоставщикуТовары.АналитикаБДДС2 КАК АналитикаБДДС2,
	                |	ЗаказПоставщикуТовары.АналитикаБДДС3 КАК АналитикаБДДС3,
	                |	ЗаказПоставщикуТовары.АналитикаБДДС4 КАК АналитикаБДДС4,
	                |	ЗаказПоставщикуТовары.АналитикаБДДС5 КАК АналитикаБДДС5,
	                |	ЗаказПоставщикуТовары.АналитикаБДДС6 КАК АналитикаБДДС6,
	                |	ЗаказПоставщикуТовары.СтатьяБюджетаБДР КАК СтатьяБюджетаБДР,
	                |	ЗаказПоставщикуТовары.АналитикаБДР1 КАК АналитикаБДР1,
	                |	ЗаказПоставщикуТовары.АналитикаБДР2 КАК АналитикаБДР2,
	                |	ЗаказПоставщикуТовары.АналитикаБДР3 КАК АналитикаБДР3,
	                |	ЗаказПоставщикуТовары.АналитикаБДР4 КАК АналитикаБДР4,
	                |	ЗаказПоставщикуТовары.АналитикаБДР5 КАК АналитикаБДР5,
	                |	ЗаказПоставщикуТовары.АналитикаБДР6 КАК АналитикаБДР6,
	                |	ЗаказПоставщикуТовары.СтранаПроизводителя КАК СтранаПроизводителя,
	                |	ЗаказПоставщикуТовары.СтраныПроисхождения КАК СтранаПроисхождения223ФЗ
	                |ИЗ
	                |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	                |ГДЕ
	                |	ЗаказПоставщикуТовары.КодСтроки = &КодСтроки
	                |	И ЗаказПоставщикуТовары.Номенклатура = &Номенклатура
	                |	И ЗаказПоставщикуТовары.Характеристика = &Характеристика
	                |	И ЗаказПоставщикуТовары.Ссылка = &ЗаказПоставщику";  
 	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТоваров,Выборка); 
		Возврат СтрокаТоваров;
	КонецЦикла;	
КонецФункции	
	
//{{MRG[ <-> ]
