// Функция - План потребностей 
//
// Параметры:
//  Объект					 - ДокументСсылка, ДокументОбъект, ДанныеФормыСтруктура	 - 
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц - 
// 
// Возвращаемое значение:
//   Структура - Структура с изменениями документа и менеджером временных таблиц 
//
Функция ПодготовитьПараметрыПланированияПотребностейЗаказа(Объект, МенеджерВременныхТаблиц) Экспорт
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", МенеджерВременныхТаблиц);
	ПараметрыПланирования.Вставить("Этап", Перечисления.ЭтапыПланированияПотребностей.ЗаказыПоставщикам);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры", Истина);
	ПараметрыПланирования.Вставить("ИзменениеПоставки", Истина);
	ПараметрыПланирования.Вставить("ИзменениеПартнера", Истина);
	ПараметрыПланирования.Вставить("ИзменениеСтруктуры",	Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Этап", 			ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДвиженияДенежныхСредств", 	КэшируемыеПроцедурыОПК.ПустаяСтатьяДвиженияДенежныхСредств());
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДоходовИРасходов",			КэшируемыеПроцедурыОПК.ПустаяСтатьяДоходовИРасходов());
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Дата"));
	КвалификаторДаты = Новый КвалификаторыДаты(ЧастиДаты.Дата);    
	ОписаниеДаты = Новый ОписаниеТипов(Массив,КвалификаторДаты); 
  	ОписаниеЧисла = Новый ОписаниеТипов("Число",
        Новый КвалификаторыЧисла(15, 2)); 	
	Запросы = Новый Массив;     
  	ПланОплаты = Новый ТаблицаЗначений;
    ПланОплаты.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ВерсияСоглашенияКоммерческийДоговор"));
    ПланОплаты.Колонки.Добавить("ПроцентПлатежа", ОписаниеЧисла);    
    ПланОплаты.Колонки.Добавить("СуммаПлатежа", ОписаниеЧисла);
    ПланОплаты.Колонки.Добавить("СуммаОтгрузок", ОписаниеЧисла);
    ПланОплаты.Колонки.Добавить("СуммаЗадолженности", ОписаниеЧисла);
    ПланОплаты.Колонки.Добавить("ВариантОплаты");
    ПланОплаты.Колонки.Добавить("СуммаПлатежей", ОписаниеЧисла);
    ПланОплаты.Колонки.Добавить("Комментарий");
    ПланОплаты.Колонки.Добавить("Замещен");
    ПланОплаты.Колонки.Добавить("Сдвиг");
    ПланОплаты.Колонки.Добавить("ВариантОтсчета");
	
    ПланОплаты.Колонки.Добавить("ДатаПлатежа", ОписаниеДаты);
    ПланОплаты.Колонки.Добавить("ДатаПоступления", ОписаниеДаты);
	ПланОплатыКопия = ПланОплаты.Скопировать();               
	
	ТипСтатей = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);	
	Если  ТипСтатей<> Неопределено И ТипСтатей.ТипЗначения.СодержитТип(ТипЗНЧ(Справочники.СтатьиДоходовИРасходов.ПустаяСсылка())) Тогда
		СтатьяБДР = Истина;
	Иначе
		СтатьяБДР = Ложь;
	КонецЕсли;	

	Запрос.УстановитьПараметр("СтатьяБДР",СтатьяБДР);  	
	ТекстЗапроса ="ВЫБРАТЬ
	              |	&ОбъектПланирования КАК Документ,
	              |	ПланОплаты.ПроцентПлатежа КАК ПроцентОплат,
	              |	ПланОплаты.ДатаПлатежа КАК ДатаПлатежа,
	              |	ПланОплаты.ДатаПоступления КАК ДатаПоступления
	              |ПОМЕСТИТЬ ВТ_ПланыОплат
	              |ИЗ
	              |	&ПланОплаты КАК ПланОплаты
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	              |	&Этап КАК Этап,
	              |	&ОбъектПланирования КАК ОбъектПланирования,
	              |	ВЫБОР
	              |		КОГДА Коллекция.Ссылка.ПоступлениеОднойДатой
	              |				И Коллекция.Ссылка.ДатаПоступления <> ДАТАВРЕМЯ(1, 1, 1)
	              |			ТОГДА Коллекция.Ссылка.ДатаПоступления
	              |		ИНАЧЕ Коллекция.ДатаОтгрузки
	              |	КОНЕЦ КАК ДатаОперации,
	              |	&Валюта КАК Валюта,
	              |	&УсловиеОплаты КАК УсловиеОплаты,
	              |	&Организация КАК Организация,
	              |	&Контрагент КАК Контрагент,
	              |	&Договор КАК ДоговорКонтрагента,
	              |	ВЫБОР
	              |		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	              |			ТОГДА &Договор
	              |		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоЗаказамНакладным)
	              |			ТОГДА &Ссылка
	              |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	              |	КОНЕЦ КАК ОбъектРасчетов,
	              |	&Контрагент КАК Поставщик,
	              |	Коллекция.Номенклатура КАК Номенклатура,
	              |	Коллекция.Характеристика КАК Характеристика,
	              |	ВЫБОР
	              |		КОГДА Коллекция.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	              |			ТОГДА Коллекция.Номенклатура.ЕдиницаИзмерения
	              |		ИНАЧЕ Коллекция.Упаковка
	              |	КОНЕЦ КАК ЕдиницаИзмерения,
	              |	1 КАК Коэффициент,
	              |	Коллекция.КоличествоУпаковок КАК Количество,  
			      |	Выразить(Коллекция.СуммаСНДС/Коллекция.КоличествоУпаковок как число(15, 2)) КАК Цена,
	              |	ВЫБОР
	              |		КОГДА &СтатьяБДР
	              |			ТОГДА Коллекция.СуммаСНДС - Коллекция.СуммаНДС
	              |		ИНАЧЕ Коллекция.СуммаСНДС
	              |	КОНЕЦ КАК Сумма,
	              |	Коллекция.СуммаСНДС КАК СуммаПоПотребности,
	              |	Коллекция.Склад КАК Склад,
	              |	Коллекция.СтавкаНДС КАК СтавкаНДС,
	              |	Коллекция.НоменклатураПартнера КАК НоменклатураПоставщика,
	              |	Коллекция.СтраныПроисхождения КАК СтранаПроисхождения,
	              |	Коллекция.СтранаПроизводителя КАК СтранаПроизводителя,
	              |	Коллекция.Назначение КАК Назначение,
	              |	ВЫРАЗИТЬ(Коллекция.АналитикаПланирования.ОбъектПланирования.Объект КАК Справочник.ДоговорыКонтрагентов).Организация КАК ОрганизацияПредыдущегоЭтапа,
	              |	ВЫРАЗИТЬ(Коллекция.АналитикаПланирования.ОбъектПланирования.Объект КАК Справочник.ДоговорыКонтрагентов).Контрагент КАК КонтрагентПредыдущегоЭтапа,
	              |	ВЫРАЗИТЬ(Коллекция.АналитикаПланирования.ОбъектПланирования.Объект КАК Справочник.ДоговорыКонтрагентов) КАК ДоговорКонтрагентаПредыдущегоЭтапа,
	              |	ВЫБОР
	              |		КОГДА ВЫРАЗИТЬ(Коллекция.АналитикаПланирования.ОбъектПланирования.Объект КАК Справочник.ДоговорыКонтрагентов).ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	              |			ТОГДА ВЫРАЗИТЬ(Коллекция.АналитикаПланирования.ОбъектПланирования.Объект КАК Справочник.ДоговорыКонтрагентов)
	              |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	              |	КОНЕЦ КАК ОбъектРасчетовПредыдущегоЭтапа,
	              |	Коллекция.АналитикаПланирования КАК АналитикаПредыдущегоЭтапа,
	              |	Коллекция.АналитикаИсточника КАК АналитикаИсточника,
	              |	ВЫБОР
	              |		КОГДА &ВидБюджетаСтатей = НЕОПРЕДЕЛЕНО
	              |				ИЛИ &ВидБюджетаСтатей = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	              |			ТОГДА Коллекция.СтатьяБюджетаБДДС
	              |		ИНАЧЕ Коллекция.СтатьяБюджетаБДР
	              |	КОНЕЦ КАК СтатьяБюджета,
	              |	ВЫБОР
	              |		КОГДА &ВидБюджетаСтатей = НЕОПРЕДЕЛЕНО
