Процедура ЗаполнитьПоступлениеТоваровУслугИзЗаказаПоставщику(
												ПоступлениеОбъект,
												ЗаказПоставщику, 
												ТекстЗаполнения, 
												СтандартнаяОбработка)
	ДоговорКонтрагента = ПолучитьДоговор(ПоступлениеОбъект);
	// Заполним реквизиты шапки по документу основанию.
	ПоступлениеОбъект.ЗаказПоставщику = ЗаказПоставщику;   
	ПоступлениеОбъект.ВидОперации = 
		ОпределитьВидОперацииПоступленияТоваровИзЗаказаПоставщику(
			ЗаказПоставщику);
	// Заполним реквизиты из стандартного набора по документу основанию.
	МодульЗаполнениеДокументов = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеДокументов");
	МодульЗаполнениеДокументов.ЗаполнитьПоОснованию(
		ПоступлениеОбъект, ЗаказПоставщику, Истина);
	ДанныеЗаполнения = ПолучитьДанныеДляЗаполненияПоступленияИзЗаказа(
		ПоступлениеОбъект, ЗаказПоставщику);
	СкопироватьНоменклатуру(ПоступлениеОбъект, ДанныеЗаполнения);
	Если ЗаказПоставщику.Товары.Количество() > 0 Тогда
		ПоступлениеОбъект.Склад = ЗаказПоставщику.Товары[0].Склад;
	КонецЕсли;	
	// Заполнение реквизитов, специфичных для документа:
	Если ЗначениеЗаполнено(ПоступлениеОбъект.Организация)
			И ЗначениеЗаполнено(ПоступлениеОбъект.Контрагент)
			И ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Документы["ПоступлениеТоваровУслуг"].ЗаполнитьСчетаУчетаРасчетов(ПоступлениеОбъект);
	КонецЕсли;
КонецПроцедуры

