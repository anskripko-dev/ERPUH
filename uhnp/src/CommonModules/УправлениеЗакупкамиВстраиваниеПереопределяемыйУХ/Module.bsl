	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = ТипЗнч(Документы.ЗаказПоставщику.ПустаяСсылка()) Тогда
		// Это ссылка
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, ИменаРеквизитов);
		ПараметрыПланирования.Вставить("ДокументПланирования", Объект);
		ДокументСсылка = Объект;
		
