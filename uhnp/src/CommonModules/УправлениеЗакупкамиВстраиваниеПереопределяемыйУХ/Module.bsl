        РеквизитыДоговора = Новый Структура;
		РеквизитыДоговора.Вставить("ГрафикДоговора",Неопределено);
		РеквизитыДоговора.Вставить("ПорядокРасчетов",Неопределено);
		Запросы.Добавить(ТекстЗапроса);
	Иначе
		// Объект или Форма
		РеквизитыДокумента = Объект;
		ПараметрыПланирования.Вставить("ДокументПланирования", Объект.Ссылка);
		ДокументСсылка = Объект.Ссылка;
		
		// Реквизиты договора
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, ИменаРеквизитовДоговора);
		
		// Табличная часть
		РеквизитыТабличнойЧасти = "ДатаОтгрузки,Упаковка, Проект, МестоПоставки, Приоритет, Менеджер, Договор, "
			+ "Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, Количество,КоличествоУпаковок, Цена, СуммаНДС,СуммаСНДС, "
			+ "Склад, СтавкаНДС, НоменклатураПоставщика, СтраныПроисхождения, СтранаПроизводителя, "
			+ "АналитикаПланирования,Отменено, АналитикаИсточника";

		Коллекция = Объект.Товары.Выгрузить(, РеквизитыТабличнойЧасти);
		Коллекция.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка");
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Товары ИЗ &Коллекция КАК Коллекция");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ЗаказПоставщику.", "ВТ_");
		Запросы.Добавить(ТекстЗапроса);
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_Товары");
	КонецЕсли;

	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ПорядокРасчетов", РеквизитыДоговора.ПорядокРасчетов);
	Если РеквизитыДоговора.ГрафикДоговора <> Перечисления.ГрафикиДоговора.ГрафикПоставок 
			ИЛИ ПланированиеПотребностей.СквозноеПланированиеПотребностей() Тогда
		
		Если РеквизитыДоговора.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным Тогда
			АктуальныйГрафик = ДоговорыКонтрагентовФормыУХВызовСервера.АктуальнаяВерсияГрафикаРасчетов(ДокументСсылка);
			Если ЗначениеЗаполнено(АктуальныйГрафик) Тогда
				Отражение = ПолучитьОтражениеПоАналитикамИзГрафикаПоЗаказу(АктуальныйГрафик);
			Иначе
				Отражение = ПолучитьОтражениеПоАналитикамИзДоговора(РеквизитыДокумента.Договор);
			КонецЕсли;
		Иначе  
				
			Отражение = ПолучитьОтражениеПоАналитикамИзДоговора(РеквизитыДокумента.Договор);    
		КонецЕсли;
	Иначе
		Отражение = ПолучитьОтражениеПоАналитикамПоУмолчанию();
	КонецЕсли; 
	ПараметрОрганизация = Запрос.Параметры.Организация;
	Для Каждого КлючЗначение Из Отражение Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;  
	Если Запрос.Параметры.Организация = Неопределено Тогда
		Запрос.Параметры.Организация = ПараметрОрганизация;
	КонецЕсли;	   
	Если Запрос.Параметры.ЦФО = Неопределено Тогда  
		Запрос.Параметры.ЦФО = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	Если Запрос.Параметры.Проект = Неопределено Тогда
		Запрос.Параметры.Проект = Справочники.Проекты.ПустаяСсылка();
	КонецЕсли;	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	
	ПараметрыПланирования.Вставить("ОбъектПланирования", ОбъектыПланирования.ПолучитьОбъектПланирования(ПараметрыПланирования.ДокументПланирования));
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	Запрос.Выполнить();
	
	Возврат ПараметрыПланирования;
	
КонецФункции

Функция ПодготовитьПараметрыПланированияПотребностейПоступления(Объект, МенеджерВременныхТаблиц) Экспорт
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", МенеджерВременныхтаблиц);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры", Истина);
	ПараметрыПланирования.Вставить("Этап", Перечисления.ЭтапыПланированияПотребностей.Исполнено);
	ПараметрыПланирования.Вставить("ДокументПланирования", Объект.Ссылка);
	ПараметрыПланирования.Вставить("ОбъектПланирования", ОбъектыПланирования.ПолучитьОбъектПланирования(Объект.Ссылка));
	ПараметрыПланирования.Вставить("РегистрацияФакта", Истина);
	ПараметрыПланирования.Вставить("ИзменениеПартнера", Истина);
	ПараметрыПланирования.Вставить("ИзменениеПоставки", Истина);

	ТипОбъекта = ТипЗнч(Объект); 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Этап", ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);

	Запрос.УстановитьПараметр("ВалютаДокумента", Объект.Валюта);
	//Запрос.УстановитьПараметр("УсловиеОплаты", Объект.Договор.УсловиеОплаты);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);    
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);    
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Объект.Договор);    
	Запрос.УстановитьПараметр("ЗаказПоставщику", Объект.ЗаказПоставщику);    
