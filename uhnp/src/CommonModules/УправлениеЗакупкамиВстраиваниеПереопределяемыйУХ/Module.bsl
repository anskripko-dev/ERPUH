Процедура ОбработкаПроведенияЗаказПоставщику(Источник, Отказ, РежимПроведения) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ТипСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Источник.Дата);	
	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Источник.Дата) <> Неопределено Тогда
		Для Каждого Строка ИЗ Источник.Товары Цикл
			Если ТипСтатьи = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств")
				 И НЕ ЗначениеЗаполнено(Строка.СтатьяБюджетаБДДС) Тогда
				ТекстСообщения = НСтр("ru = 'Необходимо заполнить поле ""Статья бюджета"" в таблице по номенклатуре'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				Возврат;
			КонецЕсли;	
			Если ТипСтатьи = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов")
				 И НЕ ЗначениеЗаполнено(Строка.СтатьяБюджетаБДР) Тогда
				ТекстСообщения = НСтр("ru = 'Необходимо заполнить поле ""Статья бюджета"" в таблице по номенклатуре'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				Возврат;
			КонецЕсли;				
		КонецЦикла;   
	КонецЕсли;
	
	ДоговорКонтрагента = ПолучитьДоговор(Источник);
	ПриобретениеФинансовыхУслуг = Ложь;
	ПроведениеСерверОПК.ИнициализироватьДополнительныеСвойстваДляПроведения(Источник.Ссылка, Источник.ДополнительныеСвойства, РежимПроведения);
	Источник.ДополнительныеСвойства.Вставить("ЭтоНовый",Источник.ЭтоНовый());
	Источник.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимПроведения);
	ИнициализироватьДанныеЗаказа(Источник.Ссылка, Источник.ДополнительныеСвойства, , ПриобретениеФинансовыхУслуг);
	//ПроведениеСерверОПК.ПодготовитьНаборыЗаписейКПроведению(Источник);   
	           
	ПроведениеСерверОПК.ПодготовитьНаборыЗаписейКПроведению(Источник);
	                               
	Если ПриобретениеФинансовыхУслуг Тогда
		ОтразитьОперацииЗаказа(Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
	Иначе
		//ПланированиеПотребностей.ОтразитьАналитикиБюджетов(Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
		//ПланированиеПотребностей.ОтразитьПланированиеПотребностей(Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
	КонецЕсли;         
	//Источник.ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
                                         
	
	ПланированиеПотребностей.ОтразитьДвиженияПланирования(Источник.ДополнительныеСвойства, Источник.Движения, Отказ);	
	ПланированиеПотребностей.СформироватьСписокРегистровДляКонтроля(Источник);	
	ПроведениеСерверОПК.ЗаписатьНаборыЗаписей(Источник);

	ПроведениеСерверОПК.ВыполнитьКонтрольРезультатовПроведения(Источник, Отказ); 

	ПроведениеСерверОПК.ОчиститьДополнительныеСвойстваДляПроведения(Источник.ДополнительныеСвойства);
	
КонецПроцедуры 

Функция РезультатКонтроляГрафика(График, СуммаДокумента, Информировать = Истина)  Экспорт

	Запрос = Новый Запрос; 
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА ГрафикРасчетов.ОперацияГрафика.КолонкаСекции = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|				ТОГДА ГрафикРасчетов.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПрихода,
	|	СУММА(ВЫБОР
	|			КОГДА ГрафикРасчетов.ОперацияГрафика.КолонкаСекции = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|				ТОГДА ГрафикРасчетов.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаРасхода,
	|	0 КАК СуммаПоЗаказу
	|ПОМЕСТИТЬ ВТСуммы
	|ИЗ
	|	Документ.ГрафикРасчетовСПокупателемПоставщиком.ГрафикРасчетов КАК ГрафикРасчетов
	|ГДЕ
	|	ГрафикРасчетов.Ссылка = &График
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	0,
	|	&СуммаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВременнаяТаблица.СуммаПрихода) КАК СуммаПрихода,
	|	СУММА(ВременнаяТаблица.СуммаРасхода) КАК СуммаРасхода,
	|	СУММА(ВременнаяТаблица.СуммаПоЗаказу) КАК СуммаПоЗаказу
	|ИЗ
	|	ВТСуммы КАК ВременнаяТаблица";
	
	Запрос.УстановитьПараметр("График", График);  
	Запрос.УстановитьПараметр("СуммаДокумента", СуммаДокумента);  

	Результат = Запрос.Выполнить(); 
	
	Если Результат.Пустой() Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	РезультатПроверки = Истина; 
	
	СуммаРасхода  = 0;
	СуммаПоЗаказу = 0;
	СуммаПрихода  = 0;
	
	Пока Выборка.Следующий() Цикл   	
		
		Если Выборка.СуммаПоЗаказу <> 0 
			И Выборка.СуммаПрихода = 0 Тогда 		
			
			РезультатПроверки = Ложь;   
			
			Если Информировать Тогда    
				ТекстСообщения = НСтр("ru = 'Не совпадают даты в графике и заказе. Обновите график расчетов'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;

		КонецЕсли;	
		
		СуммаРасхода  = СуммаРасхода  + Выборка.СуммаРасхода;
		СуммаПоЗаказу = СуммаПоЗаказу + Выборка.СуммаПоЗаказу;
		СуммаПрихода  = СуммаПрихода  + Выборка.СуммаПрихода;  
		
	КонецЦикла;  
	
	Если СуммаРасхода <> СуммаПоЗаказу
		ИЛИ СуммаПрихода <> СуммаПоЗаказу Тогда    	
		
		РезультатПроверки = Ложь; 
		
		Если Информировать Тогда  
			ТекстСообщения = НСтр("ru = 'Не совпадают суммы в графике и заказе. Обновите график расчетов'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат РезультатПроверки;

КонецФункции // ()

