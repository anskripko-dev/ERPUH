		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	НастройкаЗаменыНоменклатуры_ЗаполнитьНаборЗаписей(
		НаборЗаписей, 
		ВыборкаДетальныеЗаписи);
	НаборЗаписей.Записать(Истина);
