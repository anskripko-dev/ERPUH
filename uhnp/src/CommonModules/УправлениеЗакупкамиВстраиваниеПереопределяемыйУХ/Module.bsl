Процедура ОбработкаПроведенияПоступлениеТоваровУслуг(
										ПТУОбъект,
										Отказ,
										РежимПроведения) Экспорт
										
	Если ПТУОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПоступлениеТоваровУслугЗаполнитьДвиженияПланПоставокПоДоговорам(
	ПТУОбъект, 
	Отказ, 
	РежимПроведения);  
	#Область УХ_Встраивание
	Если ЗначениеЗаполнено(ПТУОбъект.ЗаказПоставщику) Тогда  
		ПТУОбъект.Движения.Записать();       
		
		Ошибки = Новый Соответствие;
		Заказы = Новый Массив;
		Заказы.Добавить(ПТУОбъект.ЗаказПоставщику);
		РегистрыСведений.СостоянияЗаказовПоставщикам.ОтразитьСостоянияЗаказов(Заказы,Ошибки);	
		Если Ошибки.Получить(ПТУОбъект.ЗаказПоставщику) <> Неопределено Тогда
			Отказ = Истина;
		КонецЕсли;       
		
	КонецЕсли;	
	#КонецОбласти
	
		
КонецПроцедуры

Процедура РеализацияТоваровУслугУХПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Константы.ФормироватьВстречныйДокументУХ.Получить() = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ФоновыеЗадания.Выполнить("УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ПерезаполнитьВстречныйПТУ", 
								ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Источник.Ссылка));
	
КонецПроцедуры

Процедура ПерезаполнитьВстречныйПТУ(РТУ) Экспорт 
	
	Док = ВстраиваниеУХВызовСервера.ПолучитьПТУ(РТУ);
	
	Если Не ЗначениеЗаполнено(Док) Тогда
		        
		НовыйДокумент = Документы["ПоступлениеТоваровУслуг"].СоздатьДокумент();
	ИначеЕсли Не Док.Проведен Тогда
		
		НовыйДокумент = Док.ПолучитьОбъект();
		
	Иначе 
		
		ШаблонОшибки = НСтр("ru = 'Документ поступления <%1> не был перезаполнен, т.к. он был проведен'");
		Сообщить(СтрШаблон(ШаблонОшибки, Док, ОписаниеОшибки()));
		
		Возврат;
		
	КонецЕсли;
	
	УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ЗаполнитьПоступлениеТоваровУслугИзРеализации(
		НовыйДокумент, РТУ, "", Истина);
	
	Попытка
		
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);		
				
	Исключение
		
		ШаблонОшибки = НСтр("ru = 'Не удалось сформировать поступление по продаже <%1> по причине: %2'");
			Сообщить(СтрШаблон(ШаблонОшибки, Док, ОписаниеОшибки()));	
		
	КонецПопытки;

КонецПроцедуры

Процедура ОбработкаЗаполненияПоступлениеТоваровУслуг(Источник, 
											ДанныеЗаполнения, 
											ТекстЗаполнения, 
											СтандартнаяОбработка) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ДанныеЗаполнения <> Неопределено
			И ТипДанныхЗаполнения <> Тип("Структура") Тогда
		Если ТипЗнч(ДанныеЗаполнения) =
							Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			ЗаполнитьПоступлениеТоваровУслугИзЗаказаПоставщику(Источник,
				ДанныеЗаполнения, 
				ТекстЗаполнения, 
				СтандартнаяОбработка);
		ИначеЕсли ТипЗнч(ДанныеЗаполнения) =
					Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			ЗаполнитьПоступлениеТоваровУслугИзРеализации(Источник,
				ДанныеЗаполнения, 
				ТекстЗаполнения, 
				СтандартнаяОбработка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведенияДокументаИсполненияДоговора(Источник, Отказ, РежимПроведения) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ДоговорКонтрагента = ПолучитьДоговор(Источник);
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Лот = ЦентрализованныеЗакупкиУХ.ПолучитьЛотДоговора(ДоговорКонтрагента);
		Если НЕ ЗначениеЗаполнено(Лот) Тогда
			// Записываем проводки только в рамках лота
			Возврат;
		КонецЕсли;
		
		СуммаДокумента = Источник.СуммаДокумента;
		ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		Если Источник.Валюта <> ВалютаРеглУчета Тогда
			КоэффициентПересчетаВалюты = РаботаСКурсамиВалют.ПересчитатьВВалюту(1, Источник.ВалютаДокумента, ВалютаРеглУчета, Источник.Дата);
		Иначе
			КоэффициентПересчетаВалюты = 1;
		КонецЕсли;
		СуммаРуб = СуммаДокумента * КоэффициентПересчетаВалюты;
			
		НаборЗаписей = РегистрыСведений.ИсполнениеДоговоровСПоставщиками.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Источник.Ссылка);
		НаборЗаписей.Отбор.ДоговорКонтрагента.Установить(ДоговорКонтрагента);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДоговорКонтрагента = ДоговорКонтрагента;
		НоваяЗапись.Дата = Источник.Дата;
		НоваяЗапись.ВидОперациии = ПолучитьВидОперацииИсполненияДоговораПоТипуДокумента(ТипЗнч(Источник));
		НоваяЗапись.Документ = Источник.Ссылка;
		
		НоваяЗапись.Сумма = СуммаДокумента;
		НоваяЗапись.СуммаРегл = СуммаРуб;
		НоваяЗапись.Курс = КоэффициентПересчетаВалюты;
		НоваяЗапись.ЭтоАванс = Ложь;
		
		НоваяЗапись.Лот = Лот;
		НоваяЗапись.ВалютаДокумента = Источник.Валюта;
		
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведенияДокументаИсполненияДоговора(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.ИсполнениеДоговоровСПоставщиками.ОчиститьПоДокументу(
	Источник.Ссылка);
	РегистрыСведений.ПоступлениеНоменклатуры.ОчиститьПоДокументу(
	Источник.Ссылка);    
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЗаказПоставщику", Источник.Метаданные()) Тогда
		Если ЗначениеЗаполнено(Источник.ЗаказПоставщику) Тогда
			Ошибки = Новый Соответствие;
			Заказы = Новый Массив;
			Заказы.Добавить(Источник.ЗаказПоставщику);
			РегистрыСведений.СостоянияЗаказовПоставщикам.ОтразитьСостоянияЗаказов(Заказы,Ошибки);	
			Если Ошибки.Получить(Источник.ЗаказПоставщику) <> Неопределено Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведенияВозвратТоваровПоставщику(
										Источник,
										Отказ,
										РежимПроведения) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	ДоговорКонтрагента = ПолучитьДоговор(Источник);
	ПоступлениеСсылка = Источник.Сделка;
	Если ЗначениеЗаполнено(Источник.ДокументПоступления.ЗаказПоставщику) Тогда
		ЗаказПоставщику = Источник.ДокументПоступления.ЗаказПоставщику;	
	Иначе
		ЗаказПоставщику = Источник.ДокументПоступления.Договор;
	КонецЕсли;	
	Источник.ДополнительныеСвойства.ПроведениеДокументов.МенеджерВременныхТаблицКонтроля = Новый МенеджерВременныхТаблиц;		
		
		
	Если ЗначениеЗаполнено(Источник.ДокументПоступления.ЗаказПоставщику) Тогда  
		ОбъектЗаполнения = Источник.ДокументПоступления.ЗаказПоставщику;
	ИначеЕсли  Документы.ВерсияСоглашенияКоммерческийДоговор.ЕстьПланПоставокНоменклатуры(ДоговорКонтрагента.ВерсияСоглашения) Тогда
		ОбъектЗаполнения = ДоговорКонтрагента;
	КонецЕсли;	
 
	Источник.ДополнительныеСвойства.Вставить("ТаблицыДляДвижений", Новый Структура);


	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапросВозврата(Запрос, Источник);

	ПараметрыПланирования = ПодготовитьПараметрыПланированияВозвратаПоступления(Источник, Запрос.МенеджерВременныхТаблиц);
	ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
	//Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	Регистры = Неопределено;	
	//////////////////////////////////////////////////////////////////////////////
	//// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений;
	ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры, Ложь);
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, Источник.ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	Источник.Движения.ПланированиеПотребностей.Очистить();
	Если Источник.ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаПланированиеПотребностей") Тогда
		 Источник.Движения.ПланированиеПотребностей.Загрузить(Источник.ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПланированиеПотребностей);
	КонецЕсли;	  
	Источник.Движения.ПланированиеПотребностей.Записать();
КонецПроцедуры


