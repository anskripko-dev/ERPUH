	               |	ВЫРАЗИТЬ(ВТ_ОстаткиПоЗаказам.Сумма / ВТ_ОстаткиПоЗаказам.Количество КАК ЧИСЛО(15, 2)),
	               |	ВТ_ОстаткиПоЗаказам.АналитикаПланирования.АналитикаПоставки.СтавкаНДС,
	               |	ВТ_ОстаткиПоЗаказам.АналитикаПланирования.АналитикаПоставки.СтранаПроисхождения,
	               |	ВТ_ОстаткиПоЗаказам.АналитикаПланирования.АналитикаПоставки.СтранаПроизводителя,
	               |	ВТ_ОстаткиПоЗаказам.АналитикаПланирования.АналитикаПоставки.НоменклатураПоставщика,
	               |	ВТ_ОстаткиПоЗаказам.АналитикаПланирования.АналитикаПоставки.СтранаПроисхождения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СкладПоступления.Склад КАК Склад
	               |ИЗ
	               |	ВТ_СкладПоступления КАК ВТ_СкладПоступления";
	мРезультатовЗапроса = Запрос.ВыполнитьПакет();
	ДанныеДляЗаполнения = Новый Структура;     
	                                                
	ДанныеДляЗаполнения.Вставить("ЗаказПоставщику",ЗаказПоставщику );
	ДанныеДляЗаполнения.Вставить("Товары", мРезультатовЗапроса[2].Выгрузить());
	ДанныеДляЗаполнения.Вставить("Услуги", мРезультатовЗапроса[3].Выгрузить());
	ДанныеДляЗаполнения.Вставить("мСклады", 
		мРезультатовЗапроса[4].Выгрузить().ВыгрузитьКолонку("Склад"));
	Возврат ДанныеДляЗаполнения;


КонецФункции

Процедура СкопироватьНоменклатуру(ПоступлениеОбъект, ДанныеЗаполнения)
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоступлениеОбъект.Товары.Загрузить(ДанныеЗаполнения.Товары);
	ПоступлениеОбъект.Услуги.Загрузить(ДанныеЗаполнения.Услуги);
КонецПроцедуры

Процедура ОбработатьСтрокуТабличнойЧастиПоступления(
										ПоступлениеОбъект,
										СтрокаТЧ,
										ЗначениеЗаполненияОтражениеВУСН)
КонецПроцедуры

Процедура УстановитьСкладПоступленияПоЗаказу(ПоступлениеОбъект, ДанныеЗаполнения)
	Если ДанныеЗаполнения = Неопределено 
				ИЛИ ЗначениеЗаполнено(ПоступлениеОбъект.Склад) Тогда
		Возврат;
	КонецЕсли;
	мСклады = ДанныеЗаполнения.мСклады;
	Если мСклады.Количество() > 0 Тогда
		ПоступлениеОбъект.Склад = мСклады[0];
	КонецЕсли;
КонецПроцедуры

Процедура ВозвратТоваровПоставщикуЗаполнитьДвиженияПланПоставокПоДоговорам(
														ВозвратПоставщикуОбъект, 
														Отказ, 
														РежимПроведения)
	ВозвратПоставщикуОбъект.Движения.ПланПоставокПоДоговорам.Записывать =
		Истина;
//{{MRG[ <-> ]
	ДоговорКонтрагента = ПолучитьДоговор(ВозвратПоставщикуОбъект);
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//	ПоступлениеСсылка = ВозвратПоставщикуОбъект.ДокументПоступления;
//}}MRG[ <-> ]
	ПоступлениеСсылка = ВозвратПоставщикуОбъект.Сделка;
	Если МожноПровестиВозвратТоваровПоставщику(ВозвратПоставщикуОбъект)
			И НЕ ЗначениеЗаполнено(ПоступлениеСсылка.ЗаказПоставщику)Тогда
		ПостоянныеЗначенияРегистра = Новый Структура;
		ПостоянныеЗначенияРегистра.Вставить("ВидДвижения",
			ВидДвиженияНакопления.Приход);
		ПостоянныеЗначенияРегистра.Вставить("Период",
			ВозвратПоставщикуОбъект.Дата);
		ПостоянныеЗначенияРегистра.Вставить("Договор",
//{{MRG[ <-> ]
			ДоговорКонтрагента);
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//			ВозвратПоставщикуОбъект.Договор);
//}}MRG[ <-> ]
		РезультатЗапроса =
			ПолучитьРезультатЗапросаВозвратПоПлануПоставок(
				ВозвратПоставщикуОбъект);
		ВыборкаНоменклатура = РезультатЗапроса.Выбрать(
					ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНоменклатура.Следующий() Цикл
			ВыборкаХарактеристик = ВыборкаНоменклатура.Выбрать(
//{{MRG[ <-> ]
				ОбходРезультатаЗапроса.ПоГруппировкам);
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//					ОбходРезультатаЗапроса.ПоГруппировкам);
//}}MRG[ <-> ]
			Пока ВыборкаХарактеристик.Следующий() Цикл
				Если МожноВернутьНоменклатуруПоПТиУ(
//{{MRG[ <-> ]
									ВыборкаХарактеристик, Отказ) Тогда
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//								ВыборкаХарактеристик, Отказ) Тогда
//}}MRG[ <-> ]
					ДобавитьВРегистрДвиженияНоменклатурыПоАналитикамЗапроса(
						ВозвратПоставщикуОбъект.Движения.ПланПоставокПоДоговорам,
						ПостоянныеЗначенияРегистра,
						ВыборкаХарактеристик.Выбрать(ОбходРезультатаЗапроса.Прямой),
						Истина,
						ВыборкаХарактеристик.КоличествоРаспределить,
						ВыборкаХарактеристик.СуммаРаспределить);
//{{MRG[ <-> ]
					КонецЕсли;
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//				КонецЕсли;
//}}MRG[ <-> ]
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьРезультатЗапросаВозвратПоПлануПоставок(
												ВозвратПоставщикуОбъект)
	ДоговорКонтрагента = ПолучитьДоговор(ВозвратПоставщикуОбъект);
