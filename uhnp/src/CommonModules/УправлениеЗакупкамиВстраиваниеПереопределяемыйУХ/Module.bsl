//{{MRG[ <-> ]
		|	НоменклатураДокумента.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//		|	НоменклатураДокумента.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
