	Запрос.УстановитьПараметр("ГраницаДокумента",Новый Граница(Объект.МоментВремени(), ВидГраницы.Исключая)); 
	ОбъектСписания = Новый СписокЗначений;             
	ЗаказыПоставщику = Объект.Товары.Выгрузить(,"ЗаказПоставщику");
	Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
		ОбъектСписания.Добавить(ОбъектыПланирования.ПолучитьОбъектПланирования(Объект.ЗаказПоставщику)); 
	Иначе
		ЗаполненоПоЗаказам = Ложь;
		Для Каждого СтрокаЗаказа ИЗ ЗаказыПоставщику Цикл       
			Если ЗначениеЗаполнено(СтрокаЗаказа.ЗаказПоставщику) Тогда
				ЗаполненоПоЗаказам = Истина;		
				ОбъектСписания.Добавить(ОбъектыПланирования.ПолучитьОбъектПланирования(СтрокаЗаказа.ЗаказПоставщику)); 
