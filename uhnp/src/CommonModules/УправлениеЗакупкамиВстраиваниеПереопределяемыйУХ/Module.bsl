Процедура ИнициализироватьДанныеДокументаПоступления(ДокументСсылка, ДополнительныеСвойства, Отказ, Регистры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапросПоступления(Запрос, ДокументСсылка);
	ПараметрыПланирования = ПодготовитьПараметрыПланированияПотребностейПоступления(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);      
	Если ПараметрыПланирования = Ложь Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	Если Запрос.Параметры.ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоНакладным Тогда
		ПараметрыПланирования.Вставить("ТолькоПланыПоПоставке", Истина);
	КонецЕсли;
	ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений;
	ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры,, ПараметрыПланирования);
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);

КонецПроцедуры

Процедура ЗаполнитьПоступлениеТоваровУслугИзРеализации(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
						

	Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	
	Если Не ЗначениеЗаполнено(ДанныеЗаполнения.Организация) Или Не ЗначениеЗаполнено(ДанныеЗаполнения.Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	ОрганизацияКонтрагент = ОрганизацииВызовСервераУХ.КонтрагентПоОрганизации(ДанныеЗаполнения.Организация);
	КонтрагентОрганизация = ДанныеЗаполнения.Контрагент.ОрганизационнаяЕдиница;
	Если Не ЗначениеЗаполнено(ОрганизацияКонтрагент) Или Не ЗначениеЗаполнено(КонтрагентОрганизация) Тогда
		Возврат;
	КонецЕсли;
	
	// Заполним реквизиты шапки по документу основанию.
	ЗаполнениеДокументов.Заполнить(Источник, ДанныеЗаполнения, Истина);
	
	Источник.ВидОперации = ПолучитьВидОперацииПоступленияПоВидуОперацииРеализации(ДанныеЗаполнения.ВидОперации);
	Если НЕ ЗначениеЗаполнено(Источник.ВидОперации) Тогда         
		ПокупкаКомиссия = "Перечисление.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия";
		Источник.ВидОперации = ПредопределенноеЗначение(ПокупкаКомиссия);
	КонецЕсли;
	
	Источник.Организация 		= КонтрагентОрганизация;
	Источник.Контрагент 		= ОрганизацияКонтрагент;
	Источник.Договор 			= ВстраиваниеУХВызовСервера.ПолучитьДоговорКонтрагентаВГО(ДанныеЗаполнения.Договор);
	Источник.ДокументОснование 	= ДанныеЗаполнения;
	Источник.Дата 				= ДанныеЗаполнения.Дата;
	Источник.УстановитьНовыйНомер();
	
	Источник.Комментарий 		= "";
	
	Если ЗначениеЗаполнено(Источник.Организация)
		И ЗначениеЗаполнено(Источник.Контрагент)
		И ЗначениеЗаполнено(Источник.ДоговорКонтрагента) Тогда
		Документы["ПоступлениеТоваровУслуг"].ЗаполнитьСчетаУчетаРасчетов(Источник);
	КонецЕсли;
	
	Источник.Товары.Очистить();
	Для Каждого СтрокаРеализации Из ДанныеЗаполнения.Товары Цикл
		НоваяСтрока = Источник.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРеализации);
	КонецЦикла;

	Источник.Услуги.Очистить();
	Для Каждого СтрокаРеализации Из ДанныеЗаполнения.Услуги Цикл
		НоваяСтрока = Источник.Услуги.Добавить();
	Источник.Склад = ДанныеЗаполнения.Склад;
	Источник.Партнер 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Контрагент, "Партнер");
	Источник.ЗаполнитьУсловияЗакупокПоУмолчанию(Ложь);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРеализации);
	КонецЦикла;
	
	УсловияЗакупок = ЗакупкиСервер.ПолучитьУсловияЗакупок(Источник.Соглашение, Истина, Истина);
	Источник.ЗаполнитьУсловияЗакупок(УсловияЗакупок);
	
	Параметры = Новый Структура("Объект, КомпонентыОбмена, ОбъектМодифицирован", Источник, ПолучитьКомпонентыОбмена(), Истина);
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокументаВозврата(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	

	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапросВозврата(Запрос, ДокументСсылка);
	ПараметрыПланирования = ПодготовитьПараметрыПланированияВозвратаПоступления(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
	ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений;
	ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры, Ложь);
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);

КонецПроцедуры

Функция ПодготовитьПараметрыПланированияВозвратаПоступления(Объект, МенеджерВременныхТаблиц) Экспорт
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", МенеджерВременныхтаблиц);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры", Ложь);
	ПараметрыПланирования.Вставить("ДокументПланирования", Объект.Ссылка);
	ПараметрыПланирования.Вставить("РегистрацияФакта", Истина);
 	ПараметрыПланирования.Вставить("ОтражатьВБюджетах",Ложь);
	
	ТипОбъекта = ТипЗнч(Объект);
    ДоговорКонтрагента = ПолучитьДоговор(Объект);
	Если  ЗначениеЗаполнено(Объект.ДокументПоступления.ЗаказПоставщику) Тогда	
		ОбъектЗаполнения = Объект.ДокументПоступления.ЗаказПоставщику;       
		ПараметрыПланирования.Вставить("Этап", Перечисления.ЭтапыПланированияПотребностей.ЗаказыПоставщикам);
	ИначеЕсли  Документы.ВерсияСоглашенияКоммерческийДоговор.ЕстьПланПоставокНоменклатуры(ДоговорКонтрагента.ВерсияСоглашения) Тогда
		ОбъектЗаполнения = ДоговорКонтрагента;       
		ПараметрыПланирования.Вставить("Этап", Перечисления.ЭтапыПланированияПотребностей.Законтрактовано);    
	Иначе 
		ОбъектЗаполнения = Объект.ДокументПоступления.ЗаказПоставщику;       
		ПараметрыПланирования.Вставить("Этап", Перечисления.ЭтапыПланированияПотребностей.Исполнено);    		
	КонецЕсли;
	ПараметрыПланирования.Вставить("ОбъектПланирования", ОбъектыПланирования.ПолучитьОбъектПланирования(ОбъектЗаполнения.Ссылка));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	//Запрос.УстановитьПараметр("Этап", ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	Запрос.УстановитьПараметр("ВалютаДокумента", Объект.Валюта);
	//Запрос.УстановитьПараметр("УсловиеОплаты", ДоговорКонтрагента.УсловиеОплаты);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);    
	Запрос.УстановитьПараметр("ВнеПлановойПотребности",  Ложь);  
	Запрос.УстановитьПараметр("ДатаОперации",  Объект.Дата);
	Запрос.УстановитьПараметр("Проект",  Справочники.Проекты.ПустаяСсылка());
	Запрос.УстановитьПараметр("МестоПоставки",  Справочники.МестаПоставки.ПустаяСсылка());
	Запрос.УстановитьПараметр("Склад",   			Объект.Склад);
	Запрос.УстановитьПараметр("ГраницаДокумента",	Новый Граница(Объект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ВидБюджета", 		ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	ОбъектСписания = ОбъектыПланирования.ПолучитьОбъектПланирования(Объект.ДокументПоступления);
	
	Запрос.УстановитьПараметр("ПТУ",Объект.ДокументПоступления);
	Если ТипОбъекта = Тип("ДанныеФормыСтруктура")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект."+Объект.Метаданные().Имя) Тогда
		ДанныеТовары = Объект.Товары.Выгрузить();
		
		Запрос.УстановитьПараметр("Возврат",Объект.Ссылка);
		
		Запрос.Текст =	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		              	|	ВозвратТоваровПоставщикуТовары.Номенклатура КАК Номенклатура,
		              	|	СУММА(ВозвратТоваровПоставщикуТовары.Сумма) КАК Сумма,
		              	|	СУММА(ВозвратТоваровПоставщикуТовары.Количество) КАК Количество,
		              	|	ВозвратТоваровПоставщикуТовары.СтранаПроизводителя КАК СтранаПроизводителя,
		              	|	ВозвратТоваровПоставщикуТовары.СтранаПроисхождения223ФЗ КАК СтранаПроисхождения223ФЗ,
		              	|	ВозвратТоваровПоставщикуТовары.СтранаПроисхождения223ФЗ КАК СтранаПроисхождения,
		              	|	ВозвратТоваровПоставщикуТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		              	|	ВозвратТоваровПоставщикуТовары.Характеристика КАК Характеристика,
		              	|	ВозвратТоваровПоставщикуТовары.НоменклатураПартнера КАК НоменклатураПоставщика,
		              	|	ВозвратТоваровПоставщикуТовары.Цена КАК Цена,
		              	|	ВозвратТоваровПоставщикуТовары.Ссылка.Валюта КАК ВалютаДокумента,
		              	|	ВозвратТоваровПоставщикуТовары.СтавкаНДС КАК СтавкаНДС,
		              	|	ВозвратТоваровПоставщикуТовары.ДокументПоступления КАК ДокументПоступления,
		              	|	1 КАК Коэффициент
		              	|ПОМЕСТИТЬ ПотребностиВНоменклатуре
		              	|ИЗ
		              	|	Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары
		              	|ГДЕ
		              	|	ВозвратТоваровПоставщикуТовары.Ссылка = &Возврат
		              	|
		              	|СГРУППИРОВАТЬ ПО
		              	|	ВозвратТоваровПоставщикуТовары.Номенклатура,
						|	ВозвратТоваровПоставщикуТовары.ДокументПоступления,
		              	|	ВозвратТоваровПоставщикуТовары.Характеристика,
		              	|	ВозвратТоваровПоставщикуТовары.СтранаПроизводителя,
		              	|	ВозвратТоваровПоставщикуТовары.СтранаПроисхождения223ФЗ,
		              	|	ВозвратТоваровПоставщикуТовары.Номенклатура.ЕдиницаИзмерения,
		              	|	ВозвратТоваровПоставщикуТовары.НоменклатураПартнера,
		              	|	ВозвратТоваровПоставщикуТовары.Цена,
		              	|	ВозвратТоваровПоставщикуТовары.Ссылка.Валюта,
		              	|	ВозвратТоваровПоставщикуТовары.СтавкаНДС,
		              	|	ВозвратТоваровПоставщикуТовары.СтранаПроисхождения223ФЗ
		              	|;
		              	|
		              	|////////////////////////////////////////////////////////////////////////////////
		              	|ВЫБРАТЬ
		              	|	ПотребностиВНоменклатуре.Цена КАК Цена,
		              	|	ПотребностиВНоменклатуре.Номенклатура КАК Номенклатура,
		              	|	ПотребностиВНоменклатуре.Характеристика КАК Характеристика,
		              	|	ПотребностиВНоменклатуре.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		              	|	ПотребностиВНоменклатуре.СтавкаНДС КАК СтавкаНДС,
		              	|	ПотребностиВНоменклатуре.Коэффициент КАК Коэффициент,
		              	|	ПланированиеПотребностейОстатки.АналитикаИсточника КАК АналитикаИсточника,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования КАК АналитикаПланирования,
		              	|	МАКСИМУМ(ЕСТЬNULL(ПланированиеПотребностейОстатки.КоличествоОстаток, 0)) КАК КоличествоОстаток,
		              	|	МАКСИМУМ(ЕСТЬNULL(ПланированиеПотребностейОстатки.СуммаОстаток, 0)) КАК СуммаОстаток,
		              	|	МАКСИМУМ(ЕСТЬNULL(ПотребностиВНоменклатуре.Количество, 0)) КАК КоличествоРаспределить,
		              	|	МАКСИМУМ(ЕСТЬNULL(ПотребностиВНоменклатуре.Сумма, 0)) КАК СуммаРаспределить,
		              	|	ПотребностиВНоменклатуре.ВалютаДокумента КАК Валюта,
		              	|	ПотребностиВНоменклатуре.НоменклатураПоставщика КАК НоменклатураПоставщика,
		              	|	ПотребностиВНоменклатуре.СтранаПроизводителя КАК СтранаПроизводителя,
		              	|	ПотребностиВНоменклатуре.СтранаПроисхождения КАК СтранаПроисхождения,
		              	|	&Склад КАК Склад,
		              	|	АналитикиБюджетов.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетовПоставки.СтатьяБюджета КАК СтатьяБюджетаПоставка,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетовПоставки.Аналитика1 КАК Аналитика1Поставка,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетовПоставки.Аналитика2 КАК Аналитика2Поставка,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетовПоставки.Аналитика3 КАК Аналитика3Поставка,
						|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетовПоставки.Аналитика4 КАК Аналитика4Поставка,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетовПоставки.Аналитика5 КАК Аналитика5Поставка,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетовПоставки.Аналитика6 КАК Аналитика6Поставка,
						|	ПотребностиВНоменклатуре.ДокументПоступления КАК  ДокументПоступления, 
						|	Значение(Справочник.ОбъектыПланирования.ПустаяСсылка) КАК ОбъектСписания,
						|   Значение(Перечисление.ЭтапыПланированияПотребностей.ПустаяСсылка) КАК ЭТАП
		              	|ИЗ
		              	|	ПотребностиВНоменклатуре КАК ПотребностиВНоменклатуре
		              	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей.Остатки(&ГраницаДокумента, ) КАК ПланированиеПотребностейОстатки
		              	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиБюджетов КАК АналитикиБюджетов
		              	|			ПО ПланированиеПотребностейОстатки.АналитикаИсточника = АналитикиБюджетов.АналитикаПланирования
		              	|		ПО ПотребностиВНоменклатуре.Номенклатура = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура
		              	|			И ПотребностиВНоменклатуре.Коэффициент = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент
		              	|			И ПотребностиВНоменклатуре.СтранаПроисхождения = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПоставки.СтранаПроисхождения
		              	|			И ПотребностиВНоменклатуре.НоменклатураПоставщика = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПоставки.НоменклатураПоставщика
		              	|			И ПотребностиВНоменклатуре.Характеристика = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Характеристика
		              	|			И ПотребностиВНоменклатуре.Цена = ПланированиеПотребностейОстатки.АналитикаПланирования.Цена
		              	|			И (ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПоставки.Склад = &Склад) 
						|			И (ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект = &ПТУ
		              	|				ИЛИ ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект = ПотребностиВНоменклатуре.ДокументПоступления)
		              	|ГДЕ
		              	|	НЕ &ВнеПлановойПотребности
		              	|
		              	|СГРУППИРОВАТЬ ПО              
						|	ПотребностиВНоменклатуре.ДокументПоступления,
		              	|	ПотребностиВНоменклатуре.Цена,
		              	|	ПотребностиВНоменклатуре.Номенклатура,
		              	|	ПотребностиВНоменклатуре.Характеристика,
		              	|	ПотребностиВНоменклатуре.ЕдиницаИзмерения,
		              	|	ПотребностиВНоменклатуре.СтавкаНДС,
		              	|	ПотребностиВНоменклатуре.Коэффициент,
		              	|	ПланированиеПотребностейОстатки.АналитикаИсточника,
		              	|	ПланированиеПотребностейОстатки.АналитикаПланирования,
