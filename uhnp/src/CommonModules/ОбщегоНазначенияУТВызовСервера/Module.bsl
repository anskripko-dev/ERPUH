	//++ НЕ УТ
	Если ПолучитьФункциональнуюОпцию("УправлениеТорговлей") Тогда
	//-- НЕ УТ
		
		ИмяПодсистемыПланирования = "Планирование";
		
	//++ НЕ УТ
	Иначе
		
		ИмяПодсистемыПланирования = "БюджетированиеИПланирование";
		
	КонецЕсли;
	//-- НЕ УТ
	
	Возврат ИмяПодсистемыПланирования;
	
