Функция ApiKey(Профиль) Экспорт 
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Профиль) Тогда 
		
		ДанныеБП = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Профиль, "ApiKey");
		Если ЗначениеЗаполнено(ДанныеБП) Тогда
			Результат = ДанныеБП;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции//ApiKey()

// Одинец Роман 26.06.2024 Выполнение задач №000048970
Функция XDTO_XMLСтрока(Ссылка, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт 
	
	Если ЗначениеПоУмолчанию = Неопределено 
		И ВозвращатьПоУмолчаниюПустойУникальныйИдентификатор(Ссылка) Тогда
			
		ЗначениеПоУмолчанию = "00000000-0000-0000-0000-000000000000";				
			
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Ссылка), XMLСтрока(Ссылка), ЗначениеПоУмолчанию);
	
КонецФункции // XDTO_XMLСтрока()

// Одинец Роман 26.06.2024 Выполнение задач №000048970
Функция ВозвращатьПоУмолчаниюПустойУникальныйИдентификатор(Ссылка) 
		
	Возврат Ссылка = Неопределено Или Ссылка = Null
				Или Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка))
				Или Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка));
	
КонецФункции // ВозвращатьПоУмолчаниюПустойУникальныйИдентификатор()