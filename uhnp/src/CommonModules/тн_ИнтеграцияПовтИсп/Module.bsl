
Функция ПолучитьАдресОбщегоМакета(ИмяМакета) Экспорт 
	ИмяМакетаКомпоненты = ПолучитьОбщийМакет(ИмяМакета);
	Адрес = ПоместитьВоВременноеХранилище(ИмяМакетаКомпоненты);
	Возврат Адрес;	
КонецФункции

// Соколов Александр 25.10.2017 Выполнение задач №000026360
Функция ПолучитьИмяМакетаСВнешнейКомпонентой(ИмяКомпоненты, ВерсияКомпоненты = 1) Экспорт
	
	Результат = "";
	
	Если ИмяКомпоненты = "CompressComponent" Тогда 
		
		Если ВерсияКомпоненты = 2 Тогда 
			Результат = "CompressComponent_New";
		Иначе 
			Результат = "CompressComponent";
		КонецЕсли;
		
	Иначе 
		
		Результат = ИмяКомпоненты;
		
	КонецЕсли;
	
	Возврат Результат;
	                  	
КонецФункции

Функция ПолучитьТипОбъектаXDTOПоИмени(URLПространстваИмен, ИмяТипаXDTO) Экспорт 
	
	Результат = Неопределено;
	
	ПакетXDTO = ФабрикаXDTO.Пакеты.Получить(URLПространстваИмен);
	
	Если ПакетXDTO = Неопределено Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ТипОбъектаXDTO = ПакетXDTO.Получить(ИмяТипаXDTO);
	
	Если ТипОбъектаXDTO = Неопределено Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Возврат ТипОбъектаXDTO;
	
КонецФункции

