#Область Запрос_Распределение

Функция НастройкиРаспределения(ТекстЗапроса, ИмяТаблицы = "втРаспределение", 
	ИменаГруппировок = "УзелИсточник, УзелПриемник", 
	ПутиСумм = "Распределение:База;РаспределениеВО:БазаВО",
	ПолеНомерРаспределения = "НомерРаспределения",
	УничтожатьТаблицы = Истина) Экспорт

	Возврат Новый Структура(
		"ТекстЗапроса, ИмяТаблицы, ИменаГруппировок, ПутиСумм, ПолеНомерРаспределения, УничтожатьТаблицы", 
		ТекстЗапроса, ИмяТаблицы, ИменаГруппировок, ПутиСумм, ПолеНомерРаспределения, УничтожатьТаблицы); 

КонецФункции

Функция ДобавитьТекстыЗапросовРаспределений(ТекстЗапроса, НомераТаблиц, НастройкиРаспределения) Экспорт
	
	ИмяТаблицы = НастройкиРаспределения.ИмяТаблицы;
	
	ИмяТаблицыДо = ИмяТаблицы + "_До";
	НомераТаблиц.Вставить(ИмяТаблицыДо, НомераТаблиц.Количество());
	ТекстДо = СтрЗаменить(НастройкиРаспределения.ТекстЗапроса, ИмяТаблицы, ИмяТаблицыДо);
	ТекстЗапроса.Добавить(ТекстДо);
	
	ИмяТаблицыНеточности = ИмяТаблицы + "_Неточности";
	НомераТаблиц.Вставить(ИмяТаблицыНеточности, НомераТаблиц.Количество());
	ТекстЗапроса.Добавить(ТекстЗапроса_втНеточностиРаспределений(
		НастройкиРаспределения, ИмяТаблицыДо, ИмяТаблицыНеточности));
	
	НомераТаблиц.Вставить(ИмяТаблицы, НомераТаблиц.Количество());
	ТекстЗапроса.Добавить(ТекстЗапроса_втРезультатыРаспределений(
		НастройкиРаспределения, ИмяТаблицы, ИмяТаблицыДо, ИмяТаблицыНеточности));
		
	УничтожатьТаблицы = НастройкиРаспределения.УничтожатьТаблицы;
	Если УничтожатьТаблицы Тогда
		
		ТекстЗапроса.Добавить(ТекстЗапроса_УничтожитьТаблицу(
			НомераТаблиц, ИмяТаблицыДо, УничтожатьТаблицы));
			
		ТекстЗапроса.Добавить(ТекстЗапроса_УничтожитьТаблицу(
			НомераТаблиц, ИмяТаблицыНеточности, УничтожатьТаблицы));
		
	КонецЕсли;

КонецФункции

#КонецОбласти

