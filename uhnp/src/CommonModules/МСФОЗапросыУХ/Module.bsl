Функция ТекстЗапроса_ДоступныеОтборы(НомераТаблиц)

	НомераТаблиц.Вставить("ДоступныеОтборы", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.ПолеБД КАК Поле,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ВЫБОР
	|				КОГДА СТРНАЙТИ(т.ПолеБД, ""."") = 0
	|					ТОГДА т.ПолеБД
	|				ИНАЧЕ ЛЕВ(т.ПолеБД, СТРНАЙТИ(т.ПолеБД, ""."") - 1)
	|			КОНЕЦ КАК СТРОКА(300))) КАК Поле_Основание,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ВЫБОР
	|				КОГДА СТРНАЙТИ(т.ПолеБД, ""."") = 0
	|					ТОГДА """"
	|				ИНАЧЕ ПОДСТРОКА(т.ПолеБД, СТРНАЙТИ(т.ПолеБД, ""."") + 1, ДЛИНАСТРОКИ(т.ПолеБД))
	|			КОНЕЦ КАК СТРОКА(300))) КАК Поле_Остаток,
	|	МАКСИМУМ(втПутиСубконто.СторонаДт) КАК ЭтоОтборПоДебету,
	|	ВЫБОР
	|		КОГДА втСпособыВычисления.СписокИерархия < 2
	|				И СТРНАЙТИ(т.ПолеБД, ""."") = 0
	|			ТОГДА NULL
	|		ИНАЧЕ ЕСТЬNULL(ВидыСубконтоСчет.ВидСубконтоСсылка, ВидыСубконтоКорСчет.ВидСубконтоСсылка)
	|	КОНЕЦ КАК ВидСубконтоСсылка,
	|	МАКСИМУМ(втСпособыВычисления.СписокИерархия) КАК СписокИерархия,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(ВидыСубконтоСчет.ТипДанных, ВидыСубконтоКорСчет.ТипДанных) КАК СТРОКА(200))) КАК ТипДанных,
	|	МАКСИМУМ(ЕСТЬNULL(ВидыСубконтоСчет.НомерСтроки, ВидыСубконтоКорСчет.НомерСтроки)) КАК _ПримерНомерСубконто,
	|	МАКСИМУМ(ИД.Счет) КАК _ПримерСчет,
	|	МАКСИМУМ(т.ИмяПараметра) КАК _ПримерИмяПараметра,
	|	МАКСИМУМ(т.Ссылка) КАК _ПримерСсылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.СпособВычисленияПараметра) КАК _СпособВычисленияПараметра
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов.ТаблицаПараметровОтбораБД КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИсточникиДанныхДляРасчетов КАК ИД
	|		ПО т.Ссылка = ИД.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПутиСубконто КАК втПутиСубконто
	|		ПО (т.ПолеБД ПОДОБНО втПутиСубконто.ИмяСубконто + ""%"")
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСпособыВычисления КАК втСпособыВычисления
	|		ПО т.СпособВычисленияПараметра = втСпособыВычисления.Способ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидыСубконтоСчет
	|		ПО (ИД.Счет = ВидыСубконтоСчет.Ссылка)
	|			И (втПутиСубконто.НомерСубконто = ВидыСубконтоСчет.Номер)
	|			И (втПутиСубконто.СторонаДт = ИД.ТрансляцияДебет)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидыСубконтоКорСчет
	|		ПО (ИД.КоррСчет = ВидыСубконтоКорСчет.Ссылка)
	|			И (втПутиСубконто.НомерСубконто = ВидыСубконтоКорСчет.Номер)
	|			И (втПутиСубконто.СторонаДт <> ИД.ТрансляцияДебет)
	|ГДЕ
	|	ИД.НазначениеРасчетов В
	|			(ВЫБРАТЬ
	|				т.Ссылка
	|			ИЗ
	|				Справочник.ПравилаОбработки КАК т
	|			ГДЕ
	|				т.Владелец В (&ШаблонТрансляции))
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ПолеБД,
	|	ВЫБОР
	|		КОГДА втСпособыВычисления.СписокИерархия < 2
	|				И СТРНАЙТИ(т.ПолеБД, ""."") = 0
	|			ТОГДА NULL
	|		ИНАЧЕ ЕСТЬNULL(ВидыСубконтоСчет.ВидСубконтоСсылка, ВидыСубконтоКорСчет.ВидСубконтоСсылка)
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поле";
	
