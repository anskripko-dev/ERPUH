#Область Общие

Функция ТекстЗапроса_УничтожитьТаблицу(НомераТаблиц, ИмяТаблицы = "втВЗП", УничтожитьТаблицы = Истина) Экспорт
	
	Если Не УничтожитьТаблицы Тогда
		Возврат "";
	КонецЕсли;
	
	НомераТаблиц.Вставить("УНИЧТОЖИТЬ_" + ИмяТаблицы, НомераТаблиц.Количество());
	
	Возврат "УНИЧТОЖИТЬ " + ИмяТаблицы;

КонецФункции

Функция ЗаменитьПараметрыЗапроса(ТекстЗапроса, ПараметрыЗамены) Экспорт

	Для Каждого Параметр Из ПараметрыЗамены Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&" + Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ДобавитьЗапросПоШаблону(ТекстЗапроса, ШаблонЗапроса, Процессор) Экспорт
	
	ТекстПоШаблону = ШаблонЗапроса;
	Для каждого Замена Из Процессор.ПараметрыЗамены Цикл
		ТекстПоШаблону = СтрЗаменить(ТекстПоШаблону, Замена.Ключ, Замена.Значение);
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Запрос_Трансляция

Функция НастройкиШаблонаТрансляции(ШаблонТрансляцииИлиШаблонВГО = Неопределено) Экспорт
	
	Результат = Новый Структура;
	
	ШаблонТрансляции = ПолучитьШаблонТрансляции(ШаблонТрансляцииИлиШаблонВГО);
	
	НомераТаблиц = Новый Структура;
	
	ТекстЗапроса = Новый Массив;
	ТекстЗапроса.Добавить(ТекстЗапроса_втСпособыВычисления(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПутиСубконто(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_ДоступныеОтборы(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_ДоступныеПути(НомераТаблиц));
	
	Запрос = Новый Запрос(СтрСоединить(ТекстЗапроса, ПроведениеСерверУХ.РазделительЗапросовВПакете()));
	Запрос.УстановитьПараметр("ШаблонТрансляции", ШаблонТрансляции);
	
	ПроведениеСерверУХ.ДополнитьТаблицамиИзПакетаЗапросов(
		Результат, Запрос, НомераТаблиц);
	
	ЧислоСтрок = Результат.ДоступныеОтборы.Количество()-1;
	Для й = 0 По ЧислоСтрок Цикл
		
		
		СтрокаТаб = Результат.ДоступныеОтборы.Получить(ЧислоСтрок-й);
		
		Если Не ЗначениеЗаполнено(СтрокаТаб.ТипДанных) Тогда
			Продолжить;
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТаб.Поле_Остаток) Тогда
			Продолжить;
		ИначеЕсли СтрНайти(СтрокаТаб.ТипДанных, ";") > 0 Тогда
			ПроверитьСоставноеПолеТрансляции(СтрокаТаб); //** у составного типа могут быть ошибки
		Иначе 
			ПроверитьПростоеПолеТрансляции(СтрокаТаб);
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Функция НовыйПроцессорТрансляцииЗапросом(ШаблонТрансляции = Неопределено) Экспорт

	Процессор = Новый Структура;
	
	Если ШаблонТрансляции = Неопределено Тогда
		ШаблонТрансляции = МСФОВызовСервераУХ.ЗначениеУП(
			"ШаблонТрансляции", Справочники.Организации.ПустаяСсылка());
	КонецЕсли;
	
	Процессор.Вставить("ШаблонТрансляции", ШаблонТрансляции);
	Процессор.Вставить("ИмяТаблицыИсточника", "ТаблицаИсточник"); // таблица-источник проводок 
	
	// ключ: поле-источник таблицы полей, или (Ключ:Поле-приемник(СубконтоДт1), Значение:поле-источник таблицы полей(Субконто1))
	Процессор.Вставить("ПоляПриемники", ПоляПриемникиТрансляции()); 
	Процессор.Вставить("ПоляИсточники", ПоляИсточникаТрансляции());
	Процессор.Вставить("ПутиИсключения", Новый Массив);
	
	Процессор.Вставить("ДоступныеОтборы");// пути отборов трансляции из КэшТрансляции
	Процессор.Вставить("ДоступныеПути");  // пути полей трансляции из КэшТрансляции
	
	Процессор.Вставить("СтороныТрансляции", Новый Структура);
	ПодготовитьСторонуТрансляции(Процессор);
	
	// замены параметров в запросе с соединениями трансляции
	Процессор.Вставить("ЗаменыПараметров", Новый Структура); 
	
	Возврат Процессор;

КонецФункции

Функция ТекстЗапроса_втСпособыВычисления(НомераТаблиц) Экспорт

	НомераТаблиц.Вставить("втСпособыВычисления", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение) КАК Способ,
	|	ЛОЖЬ КАК ЭтоНе,
	|	0 КАК СписокИерархия
	|ПОМЕСТИТЬ втСпособыВычисления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений),
	|	ЛОЖЬ,
	|	1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВычисленияПараметровОперандов.СписокПоИерархии),
	|	ЛОЖЬ,
	|	2
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению),
	|	ИСТИНА,
	|	0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений),
	|	ИСТИНА,
	|	1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии),
	|	ИСТИНА,
	|	2
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Способ";
	
КонецФункции

Функция ДобавитьЗапросыТрансляции(ТекстЗапроса, НомераТаблиц, ТекстЗапросаСчетаИсточники = Неопределено) Экспорт

	ТекстЗапроса.Добавить(ТекстЗапроса_втСоответствияТрансляции(НомераТаблиц, ТекстЗапросаСчетаИсточники));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втСпособыВычисления(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втОтборыПолей(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втЗначенияОтборовТрансляции(НомераТаблиц));	
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втПолучениеПолей(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПравилаПолей(НомераТаблиц));
	
КонецФункции

Функция ПодготовитьЗаменыПараметровТрансляции(Процессор) Экспорт

	ПодготовитьКэшТрансляции(Процессор);
	УдалитьПутиИсключения(Процессор);
	
	Для каждого ИмяСтороны Из Процессор.СтороныТрансляции Цикл
		
		ПодготовитьСторонуТрансляции(Процессор, ИмяСтороны.Ключ, ИмяСтороны.Значение);
		
		ДобавитьЗаменыПолейВыбораТрансляции(Процессор);
		
		ДобавитьОтборыСтороныТрансляции(Процессор);
		ДобавитьОтборОперандаТрансляции(Процессор);
		ДобавитьЗаменуОтбораТрансляции(Процессор);
	
	КонецЦикла;
	
	Возврат Процессор.ЗаменыПараметров
	
КонецФункции

Функция ПоляПриемникиТрансляцииДтКт() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("СчетДт", 					"Счет");
	Результат.Вставить("СубконтоДт1",				"Субконто1");
	Результат.Вставить("СубконтоДт2",				"Субконто2");
	Результат.Вставить("СубконтоДт3",				"Субконто3");
	Результат.Вставить("ВалютаДт",					"Валюта");
	Результат.Вставить("ПодразделениеДт",			"Подразделение");
	Результат.Вставить("НаправлениеДеятельностиДт",	"НаправлениеДеятельности");
	
	Результат.Вставить("СчетКт", 					"Счет");
	Результат.Вставить("СубконтоКт1",				"Субконто1");
	Результат.Вставить("СубконтоКт2",				"Субконто2");
	Результат.Вставить("СубконтоКт3",				"Субконто3");
	Результат.Вставить("ВалютаКт",					"Валюта");
	Результат.Вставить("ПодразделениеКт",			"Подразделение");
	Результат.Вставить("НаправлениеДеятельностиКт",	"НаправлениеДеятельности");
	
	Результат.Вставить("Регистратор",	"Регистратор");
	Результат.Вставить("Организация",	"Организация");
	
	Возврат Результат;

КонецФункции

