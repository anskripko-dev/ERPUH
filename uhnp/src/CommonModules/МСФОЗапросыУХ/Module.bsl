Функция ПроверитьСоставноеПолеТрансляции(СтрокаТаб, ПолноеИмяРегистра = "РегистрБухгалтерии.МСФО")
	
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Субконто КАК т
	|ГДЕ
	|	ЛОЖЬ
	|	И НЕ т.Значение ЕСТЬ NULL";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрБухгалтерии.МСФО", ПолноеИмяРегистра);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "т.Значение", "т.Значение." + СтрокаТаб.Поле_Остаток);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Попытка
		Результат = Запрос.Выполнить().Пустой();
	Исключение
		ОбработатьОшибкуТрансляции(СтрокаТаб);
	КонецПопытки;

КонецФункции

Функция ПроверитьПростоеПолеТрансляции(СтрокаТаб)
	
	ЭтоОшибка = Ложь;
		
	ОбъектМД = Метаданные.НайтиПоПолномуИмени(СтрокаТаб.ТипДанных);
	Если ОбъектМД <> Неопределено Тогда
		
		Ссылка =  ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(
			СтрокаТаб.ТипДанных).ПустаяСсылка();
		
	КонецЕсли;
	
	Если СтрНайти(СтрокаТаб.Поле_Остаток, ".") = 0 Тогда
		
		ЭтоОшибка = Не ОбщегоНазначенияКлиентСервер
			.ЕстьРеквизитИлиСвойствоОбъекта(Ссылка, СтрокаТаб.Поле_Остаток);
			
		Если ЭтоОшибка Тогда
			ОбработатьОшибкуТрансляции(СтрокаТаб);
		КонецЕсли;
			
	Иначе
		
		Попытка
			Проверка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Ссылка, СтрокаТаб.Поле_Остаток);
		Исключение
			ОбработатьОшибкуТрансляции(СтрокаТаб);
		КонецПопытки;
		
	КонецЕсли;

КонецФункции

Процедура ОбработатьОшибкуТрансляции(СтрокаТаб)
	
	Таб = СтрокаТаб.Владелец();
	Таб.Удалить(СтрокаТаб);

КонецПроцедуры

