Процедура СоздатьРеквизитыТаблицыДокументыКИмпорту(Форма) Экспорт

	МассивДобавляемыхРеквизитов = Новый Массив;
	
	ПутьКТаблице = "ДокументыКИмпорту";
	
	НовыйРеквизит = Новый РеквизитФормы("ДокументПланирования", Новый ОписаниеТипов("ДокументСсылка.ОжидаемоеПоступлениеДенежныхСредств"), ПутьКТаблице);
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("ИдентификаторПозиции", Новый ОписаниеТипов("УникальныйИдентификатор"), ПутьКТаблице);
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("ИдентификаторПлатежа", ОбщегоНазначения.ОписаниеТипаСтрока(25), ПутьКТаблице);
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
КонецПроцедуры

#КонецОбласти 

Процедура СоздатьЭлементВидОперацииУХ(Форма) Экспорт
	
	Объект = Форма.Объект;
	ОбъектМетаданных = Объект.Ссылка.Метаданные();
	Реквизит = ОбъектМетаданных.Реквизиты.ВидОперацииУХ;
	ПараметрыВыбора = Новый Массив(Реквизит.ПараметрыВыбора);
	
	Элементы = Форма.Элементы;
	
	Элемент = Элементы.Вставить("ВидОперацииУХ", Тип("ПолеФормы"), Элементы.ГруппаВидОперации, Элементы.РасчетыПриОплате);
	Элемент.ПутьКДанным = "Объект.ВидОперацииУХ";
	Элемент.Вид 		= ВидПоляФормы.ПолеВвода; 
	Элемент.УстановитьДействие("ПриИзменении","ВидОперацииУХПриИзменении");
	Элемент.Заголовок 	= НСтр("ru = 'Вид операции'");
	
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	
	Элементы.ВидОперации.Видимость = Ложь;

КонецПроцедуры

