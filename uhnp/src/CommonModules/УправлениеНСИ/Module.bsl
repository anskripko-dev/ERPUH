#Область ПрограммныйИнтерфейс

// Функция проверяет, контролируется ли указанный справочник системой управления НСИ.
//
// Параметры:
//  СправочникМетаданные - ОбъектМетаданных: Справочник - Справочник, который необходимо проверить.
// 
// Возвращаемое значение:
//  Булево - Истина, если справочник контролируется системой НСИ.
//
Функция ЭтоКонтролируемыйСправочник(СправочникМетаданные) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Контролируется
	|ИЗ
	|	Справочник.СправочникиБД КАК СправочникиБД
	|ГДЕ
	|	СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	|	И СправочникиБД.Наименование = &Наименование
	|	И НЕ СправочникиБД.ТипКонтроляНСИ = ЗНАЧЕНИЕ(Перечисление.ТипыКонтроляНСИ.НеКонтролируется)";

	Запрос.УстановитьПараметр("Наименование", СправочникМетаданные.Имя);
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Функция возвращает данные объекта НСИ
//
// Параметры:
//  ИмяОбъекта	 - Строка - Имя объекта метаданных, для которого требуется получить параметры.
// 
// Возвращаемое значение:
//  Структура, Неопределено - Структура параметров объекта НСИ, или Неопределено, если описание объекта не найдено.
//
Функция ПолучитьДанныеОбъектаНСИ(ИмяОбъекта) Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("УправлениеНСИВнутренний") <> Неопределено Тогда
		
		МодульУправлениеНСИВнутренний = ОбщегоНазначения.ОбщийМодуль("УправлениеНСИВнутренний");
		Возврат МодульУправлениеНСИВнутренний.ПолучитьДанныеОбъектаНСИ(ИмяОбъекта);
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБД.Ссылка КАК Ссылка,
	             |	ИСТИНА КАК ЕстьРеквизитыНСИ,
	             |	СправочникиБД.Наименование КАК Наименование,
	             |	ВЫБОР
	             |		КОГДА СправочникиБД.ВидИерархии = ЗНАЧЕНИЕ(Перечисление.ВидИерархии.ИерархияГруппИЭлементов)
	             |			ТОГДА ИСТИНА
	             |		ИНАЧЕ ЛОЖЬ
	             |	КОНЕЦ КАК УчитыватьГруппы,
	             |	СправочникиБД.ВидИерархии КАК ВидИерархии,
	             |	СправочникиБД.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	              |	СправочникиБД.СогласованиеСвязанныхОбъектов КАК СогласованиеСвязанныхОбъектов,
	             |	СправочникиБД.ТипКонтроляНСИ КАК ТипКонтроляНСИ
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	СправочникиБД.Наименование = &Наименование
	             |	И СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)";
	
	Запрос.УстановитьПараметр("Наименование",ИмяОбъекта);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат=Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()>0 Тогда
		
		СтруктураКонтроля=ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Результат[0]);
		СтруктураКонтроля.Вставить("КонтролироватьАктивность",
				СтруктураКонтроля.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ЗаявкиНаИзменениеНСИ
				ИЛИ СтруктураКонтроля.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ИзмененияПоВерсиям);
				
		СтруктураКонтроля.Вставить("ВыборНеАктивных",СтруктураКонтроля.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ЗаявкиНаИзменениеНСИ
				И (СтруктураКонтроля.СогласованиеСвязанныхОбъектов=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьОтдельно
				ИЛИ СтруктураКонтроля.СогласованиеСвязанныхОбъектов=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьСинхронно));
		
		Возврат СтруктураКонтроля;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
				 			 	
КонецФункции // ПолучитьДанныеОбъектаНСИ()

Процедура УстановитьРеквизитыКонтроляНСИВнешняяИБ(Объект,ОписаниеОбъекта,Отказ)
	
	Если ОписаниеОбъекта.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.НеКонтролируется Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ОписаниеОбъекта.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ИзмененияЗапрещены  Тогда
		
		ТекстОшибки=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Элементы справочника %1 загружаются из централизованной базы %2. Интерактивное изменение справочника запрещено.'"),ОписаниеОбъекта.Наименование,ОписаниеОбъекта.ЦентрализованнаяБазаНСИ);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
		Возврат;
		
	КонецЕсли;
			
	ТекстОшибки=ПроверитьКонтролируемыеРеквизитыОбъекта(Объект,ОписаниеОбъекта);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		
		ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Запись объекта отменена по причине: %1'"),ТекстОшибки);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);			
		Возврат
		
	КонецЕсли; 
	
	Если Объект.НСИ_НеАктивный ИЛИ ОписаниеОбъекта.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ПроверятьЗаполнениеРеквизитов Тогда
		
		Возврат;
		
	КонецЕсли;
								
	Если НЕ Объект.ЭтоНовый() Тогда // Проверим возможность записи измененного объекта
			
		ДанныеИзменений=ПолучитьСтруктуруИзмененийОбъекта(Новый Структура("Объект,Ссылка",Объект,Объект.Ссылка));
		
		Если ДанныеИзменений.Количество()>0 Тогда
			
			ОбщегоНазначения.СообщитьПользователю(Нстр("ru = 'Объект контролируется системой ЦНСИ.
			|Для изменения воспользуйтесь заявкой на изменение НСИ.'"),,,,Отказ);		
			
		КонецЕсли;
		
	Иначе
		
		Объект.НСИ_НеАктивный=Истина;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьРеквизитыКонтроляНСИВнешняяИБ() 

Процедура УстановитьРеквизитыКонтроляНСИ(Объект, Отказ) Экспорт
	
	Если Объект.ОбменДанными.Загрузка=Истина Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ДополнительныеСвойства.Свойство("ОтключитьКонтрольНСИ") Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Если НЕ Объект.Модифицированность() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	УправлятьНСИ = ПолучитьФункциональнуюОпцию("УправлениеНСИ");
	
	Если НЕ УправлятьНСИ Тогда
		Возврат;
	КонецЕсли; 
	
	МетаданныеОбъекта=Объект.Метаданные();	
	ИмяОбъекта=МетаданныеОбъекта.Имя;

	ОписаниеОбъекта = УправлениеНСИ.ПолучитьДанныеОбъектаНСИ(ИмяОбъекта);
	
	Если ОписаниеОбъекта=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
			
	Если НЕ ОписаниеОбъекта.ЕстьРеквизитыНСИ Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ОписаниеОбъекта.ЦентрализованнаяБазаНСИ) Тогда
		
		УстановитьРеквизитыКонтроляНСИВнешняяИБ(Объект,ОписаниеОбъекта,Отказ);
		
	ИначеЕсли Метаданные.ОбщиеМодули.Найти("УправлениеНСИВнутренний") <> Неопределено Тогда
		
		МодульУправлениеНСИВнутренний = ОбщегоНазначения.ОбщийМодуль("УправлениеНСИВнутренний");
		МодульУправлениеНСИВнутренний.УстановитьРеквизитыКонтроляНСИТекущаяИБ(Объект,ОписаниеОбъекта,Отказ);
								
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь);	
			
КонецПроцедуры // УстановитьРеквизитыКонтроляНСИ()

Функция СравнитьТаблицыЗначений(ТаблицаЗначений1, ТаблицаЗначений2,СтруктураПропускаемыхЗначений=Неопределено,СтруктураКолонокПоиска=Неопределено) Экспорт
	
	Если ТипЗнч(ТаблицаЗначений1) <> Тип("ТаблицаЗначений") ИЛИ ТипЗнч(ТаблицаЗначений2) <> Тип("ТаблицаЗначений") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если ТаблицаЗначений1.Количество() <> ТаблицаЗначений2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если ТаблицаЗначений1.Колонки.Количество() <> ТаблицаЗначений2.Колонки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим поля
	Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
		Если ТаблицаЗначений2.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла; 
	Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
		Если ТаблицаЗначений1.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла; 
	
	// сформируем строку индекса для оптимизации поиска по таблице значений
	СтрокаИндекса = "";
	Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
		Если СтрокаИндекса = "" Тогда
			СтрокаИндекса = Колонка.Имя;
		Иначе
			СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	// добавим индекс
	ТаблицаЗначений2.Индексы.Добавить(СтрокаИндекса);
	
	// Проверим записи
	Для каждого СтрокаТаблицы Из ТаблицаЗначений1 Цикл
		
		СтруктураПоиска = Новый Структура;
				
		Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
						
			Если НЕ (СтруктураКолонокПоиска=Неопределено ИЛИ СтруктураКолонокПоиска.Свойство(Колонка.Имя)) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если СтруктураПропускаемыхЗначений=Неопределено 
				ИЛИ НЕ(СтруктураПропускаемыхЗначений.Свойство(Колонка.Имя) И (СтруктураПропускаемыхЗначений[Колонка.Имя]=СтрокаТаблицы[Колонка.Имя] ИЛИ СтруктураПропускаемыхЗначений[Колонка.Имя]=Неопределено)) Тогда
				
				СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
							
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтруктураПоиска.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиТаблицы2 = ТаблицаЗначений2.НайтиСтроки(СтруктураПоиска);
		Если СтрокиТаблицы2.Количество() <> 1 Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЦикла;
	
	// сформируем строку индекса для оптимизации поиска по таблице значений
	СтрокаИндекса = "";
	Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
		Если СтрокаИндекса = "" Тогда
			СтрокаИндекса = Колонка.Имя;
		Иначе
			СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	// добавим индекс
	ТаблицаЗначений1.Индексы.Добавить(СтрокаИндекса);
	
	Для каждого СтрокаТаблицы Из ТаблицаЗначений2 Цикл
		
		СтруктураПоиска = Новый Структура;
		
		Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
			
			Если НЕ (СтруктураКолонокПоиска=Неопределено ИЛИ СтруктураКолонокПоиска.Свойство(Колонка.Имя)) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если СтруктураПропускаемыхЗначений=Неопределено 
				ИЛИ НЕ(СтруктураПропускаемыхЗначений.Свойство(Колонка.Имя) И (СтруктураПропускаемыхЗначений[Колонка.Имя]=СтрокаТаблицы[Колонка.Имя] ИЛИ СтруктураПропускаемыхЗначений[Колонка.Имя]=Неопределено)) Тогда
				
				СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
							
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтруктураПоиска.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиТаблицы1 = ТаблицаЗначений1.НайтиСтроки(СтруктураПоиска);
		Если СтрокиТаблицы1.Количество() <> 1 Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // СравнитьТаблицыЗначений()

Функция ПолучитьСтруктуруСравненияОбъектов(ИсходныйОбъект,НовыйОбъект) Экспорт
	
	ОписаниеОбъекта = УправлениеНСИ.ПолучитьДанныеОбъектаНСИ(ИсходныйОбъект.Метаданные().Имя);
	
	Если ОписаниеОбъекта=Неопределено Тогда
		
		Возврат Новый Структура;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СправочникиБДРеквизиты.Имя КАК Имя
	|ИЗ
	|	Справочник.СправочникиБД.Реквизиты КАК СправочникиБДРеквизиты
	|ГДЕ
	|	СправочникиБДРеквизиты.Ссылка = &Ссылка
	|	И НЕ СправочникиБДРеквизиты.ИзменениеБезСогласования";
	
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	
	МассивСогласуемыхРеквизитов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Имя"); 
	
	ИзменениеРеквизитов=Новый ТаблицаЗначений;
	ИзменениеРеквизитов.Колонки.Добавить("ИмяРеквизита");
	ИзменениеРеквизитов.Колонки.Добавить("ИсходноеЗначение");
	ИзменениеРеквизитов.Колонки.Добавить("НовоеЗначение");
	
	ИзменениеТЧ=Новый ТаблицаЗначений;
	ИзменениеТЧ.Колонки.Добавить("ТабличнаяЧасть");
	ИзменениеТЧ.Колонки.Добавить("НовоеЗначение");
	
	СтруктураИсходный	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходныйОбъект,МассивСогласуемыхРеквизитов);
	СтруктураНовый		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НовыйОбъект,МассивСогласуемыхРеквизитов);

	Для Каждого КлючИЗначение ИЗ СтруктураИсходный Цикл
				
		Если ТипЗнч(КлючИЗначение.Значение)=Тип("Строка") Тогда
			
			РезультатПроверки=(СокрЛП(СтруктураНовый[КлючИЗначение.Ключ])=СокрЛП(КлючИЗначение.Значение));
			
		Иначе
			
			РезультатПроверки=(СтруктураНовый[КлючИЗначение.Ключ]=КлючИЗначение.Значение);
			
		КонецЕсли;
				
		Если НЕ РезультатПроверки Тогда
			
			НоваяСтрока=ИзменениеРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита=КлючИЗначение.Ключ;
			НоваяСтрока.ИсходноеЗначение=КлючИЗначение.Значение;
			НоваяСтрока.НовоеЗначение=СтруктураНовый[КлючИЗначение.Ключ];
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБДСогласуемыеТЧ.ОписаниеТЧ.Имя КАК ОписаниеТЧИмя,
	             |	СправочникиБДСогласуемыеТЧ.ОписаниеТЧ КАК ОписаниеТЧ
	             |ИЗ
	             |	Справочник.СправочникиБД.СогласуемыеТЧ КАК СправочникиБДСогласуемыеТЧ
	             |ГДЕ
	             |	СправочникиБДСогласуемыеТЧ.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ТЧИсходный=ИсходныйОбъект[Результат.ОписаниеТЧИмя].Выгрузить();
		ТЧНовый=НовыйОбъект[Результат.ОписаниеТЧИмя].Выгрузить();
		
		Если Результат.ОписаниеТЧИмя="КонтактнаяИнформация" Тогда
			
			СтруктураКолонокПоиска=Новый Структура;
			СтруктураКолонокПоиска.Вставить("Тип");
			СтруктураКолонокПоиска.Вставить("Вид");
			СтруктураКолонокПоиска.Вставить("Представление");
			СтруктураКолонокПоиска.Вставить("ДействуетС");
			
		Иначе
			
			СтруктураКолонокПоиска=Неопределено;
			
		КонецЕсли;
				
		Если НЕ СравнитьТаблицыЗначений(ТЧИсходный,ТЧНовый,,СтруктураКолонокПоиска) Тогда
			
			НоваяСтрока=ИзменениеТЧ.Добавить();
			НоваяСтрока.ТабличнаяЧасть=Результат.ОписаниеТЧ;
			НоваяСтрока.НовоеЗначение=Новый ХранилищеЗначения(ТЧНовый);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураИзменений=Новый Структура;
	
	Если ИзменениеРеквизитов.Количество()>0 Тогда
		
		СтруктураИзменений.Вставить("ИзменениеРеквизитов",ИзменениеРеквизитов);
		
	КонецЕсли; 
	
	Если ИзменениеТЧ.Количество()>0 Тогда
		
		СтруктураИзменений.Вставить("ИзменениеТЧ",ИзменениеТЧ);
		
	КонецЕсли; 
	
	Возврат СтруктураИзменений;
	
КонецФункции // ПолучитьСтруктуруСравненияОбъектов() 

Функция ПолучитьСтруктуруИзмененийОбъекта(ДанныеОбъекта) Экспорт
	
	Объект=ДанныеОбъекта.Объект;
	Ссылка=ДанныеОбъекта.Ссылка;
	
	ОписаниеОбъекта = УправлениеНСИ.ПолучитьДанныеОбъектаНСИ(Ссылка.Метаданные().Имя);
	
	Если ОписаниеОбъекта=Неопределено Тогда
		
		Возврат Новый Структура;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СправочникиБДРеквизиты.Имя КАК Имя
	|ИЗ
	|	Справочник.СправочникиБД.Реквизиты КАК СправочникиБДРеквизиты
	|ГДЕ
	|	СправочникиБДРеквизиты.Ссылка = &Ссылка
	|	И НЕ СправочникиБДРеквизиты.ИзменениеБезСогласования";
	
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	
	МассивСогласуемыхРеквизитов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Имя");
	
	ИзменениеРеквизитов=Новый ТаблицаЗначений;
	ИзменениеРеквизитов.Колонки.Добавить("ИмяРеквизита");
	ИзменениеРеквизитов.Колонки.Добавить("ИсходноеЗначение");
	ИзменениеРеквизитов.Колонки.Добавить("НовоеЗначение");
	
	ИзменениеТЧ=Новый ТаблицаЗначений;
	ИзменениеТЧ.Колонки.Добавить("ТабличнаяЧасть");
	ИзменениеТЧ.Колонки.Добавить("НовоеЗначение");
	
	СтруктураТек=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,МассивСогласуемыхРеквизитов);
	
	Для Каждого КлючИЗначение ИЗ СтруктураТек Цикл
				
		Если ТипЗнч(КлючИЗначение.Значение)=Тип("Строка") Тогда
			
			РезультатПроверки=(СокрЛП(Объект[КлючИЗначение.Ключ])=СокрЛП(КлючИЗначение.Значение));
			
		Иначе
			
			РезультатПроверки=(Объект[КлючИЗначение.Ключ]=КлючИЗначение.Значение);
			
		КонецЕсли;
				
		Если НЕ РезультатПроверки Тогда
			
			НоваяСтрока=ИзменениеРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита=КлючИЗначение.Ключ;
			НоваяСтрока.ИсходноеЗначение=КлючИЗначение.Значение;
			НоваяСтрока.НовоеЗначение=Объект[КлючИЗначение.Ключ];
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБДСогласуемыеТЧ.ОписаниеТЧ.Имя КАК ОписаниеТЧИмя,
	             |	СправочникиБДСогласуемыеТЧ.ОписаниеТЧ КАК ОписаниеТЧ
	             |ИЗ
	             |	Справочник.СправочникиБД.СогласуемыеТЧ КАК СправочникиБДСогласуемыеТЧ
	             |ГДЕ
	             |	СправочникиБДСогласуемыеТЧ.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ТЧСсылка=Ссылка[Результат.ОписаниеТЧИмя].Выгрузить();
		ТЧОбъект=ТЧСсылка.СкопироватьКолонки();
		
		Для Каждого Строка ИЗ Объект[Результат.ОписаниеТЧИмя] Цикл
			
			НоваяСтрока=ТЧОбъект.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
		КонецЦикла; 
		
		Если Результат.ОписаниеТЧИмя="КонтактнаяИнформация" Тогда
			
			СтруктураКолонокПоиска=Новый Структура;
			СтруктураКолонокПоиска.Вставить("Тип");
			СтруктураКолонокПоиска.Вставить("Вид");
			СтруктураКолонокПоиска.Вставить("Представление");
			СтруктураКолонокПоиска.Вставить("ДействуетС");
			
		Иначе
			
			СтруктураКолонокПоиска=Неопределено;
			
		КонецЕсли;
				
		Если НЕ СравнитьТаблицыЗначений(ТЧСсылка,ТЧОбъект,,СтруктураКолонокПоиска) Тогда
			
			НоваяСтрока=ИзменениеТЧ.Добавить();
			НоваяСтрока.ТабличнаяЧасть=Результат.ОписаниеТЧ;
			НоваяСтрока.НовоеЗначение=Новый ХранилищеЗначения(ТЧОбъект);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураИзменений=Новый Структура;
	
	Если ИзменениеРеквизитов.Количество()>0 Тогда
		
		СтруктураИзменений.Вставить("ИзменениеРеквизитов",ИзменениеРеквизитов);
		
	КонецЕсли; 
	
	Если ИзменениеТЧ.Количество()>0 Тогда
		
		СтруктураИзменений.Вставить("ИзменениеТЧ",ИзменениеТЧ);
		
	КонецЕсли; 
	
	Возврат СтруктураИзменений;	
		
КонецФункции // ПолучитьСтруктуруИзмененийОбъекта() 

Функция ПолучитьСтруктуруРеквизитовОбъекта(МетаданныеОбъекта) Экспорт
	
	ОписаниеОбъекта = УправлениеНСИ.ПолучитьДанныеОбъектаНСИ(МетаданныеОбъекта.Имя);
	СтруктураРеквизитов=Новый Структура;
	
	Если ОписаниеОбъекта=Неопределено Тогда
		
		Возврат СтруктураРеквизитов;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБДРеквизиты.Имя КАК Имя
	             |ИЗ
	             |	Справочник.СправочникиБД.Реквизиты КАК СправочникиБДРеквизиты
	             |ГДЕ
	             |	СправочникиБДРеквизиты.Ссылка = &Ссылка
	             |	И НЕ СправочникиБДРеквизиты.ИзменениеБезСогласования
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СправочникиБДСогласуемыеТЧ.ОписаниеТЧ.Имя КАК ОписаниеТЧИмя
	             |ИЗ
	             |	Справочник.СправочникиБД.СогласуемыеТЧ КАК СправочникиБДСогласуемыеТЧ
	             |ГДЕ
	             |	СправочникиБДСогласуемыеТЧ.Ссылка = &Ссылка
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	СправочникиБДВладельцы.Ссылка.Наименование КАК ПодчиненныйСправочник
	             |ИЗ
	             |	Справочник.СправочникиБД.Владельцы КАК СправочникиБДВладельцы
	             |ГДЕ
	             |	СправочникиБДВладельцы.ТипДанных ПОДОБНО &ТаблицаВладелец
	             |	И СправочникиБДВладельцы.Ссылка.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |	И НЕ СправочникиБДВладельцы.Ссылка.ПометкаУдаления
	             |	И НЕ СправочникиБДВладельцы.Ссылка.ОтсутствуетВКонфигурации";
	
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	Запрос.УстановитьПараметр("ТаблицаВладелец",МетаданныеОбъекта.ПолноеИмя());
	Результат=Запрос.ВыполнитьПакет();
	
	СтруктураРеквизитов.Вставить("Реквизиты",Результат[0].Выгрузить().ВыгрузитьКолонку("Имя"));
	СтруктураРеквизитов.Вставить("ТабличныеЧасти",Результат[1].Выгрузить().ВыгрузитьКолонку("ОписаниеТЧИмя"));
	СтруктураРеквизитов.Вставить("ПодчиненныеСправочники",Результат[2].Выгрузить().ВыгрузитьКолонку("ПодчиненныйСправочник"));
		
			
	Возврат СтруктураРеквизитов;
		
КонецФункции // ПолучитьСтруктуруРеквизитовОбъекта() 

Функция ПроверитьКонтролируемыеРеквизитыОбъекта(Объект,Знач ОписаниеОбъекта=Неопределено,РежимПроверки=Ложь) Экспорт
	
	Если ОписаниеОбъекта=Неопределено Тогда
				
		ОписаниеОбъекта = УправлениеНСИ.ПолучитьДанныеОбъектаНСИ(Объект.Метаданные().Имя);
		
		Если ОписаниеОбъекта=Неопределено Тогда
			
			Возврат "";
			
		КонецЕсли;
		
	КонецЕсли;
			
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СправочникиБДРеквизиты.Имя,
	|	СправочникиБДРеквизиты.Обязательный,
	|	СправочникиБДРеквизиты.КонтрольУникальности
	|ИЗ
	|	Справочник.СправочникиБД.Реквизиты КАК СправочникиБДРеквизиты
	|ГДЕ
	|	СправочникиБДРеквизиты.Ссылка = &Ссылка
	|	И (СправочникиБДРеквизиты.Обязательный
	|			ИЛИ СправочникиБДРеквизиты.КонтрольУникальности)";
	
	Если ОписаниеОбъекта.УчитыватьГруппы И Объект.ЭтоГруппа Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|	И (СправочникиБДРеквизиты.Использование=ЗНАЧЕНИЕ(Перечисление.ИспользованиеРеквизита.ДляГруппы)
		|ИЛИ СправочникиБДРеквизиты.Использование=ЗНАЧЕНИЕ(Перечисление.ИспользованиеРеквизита.ДляГруппыИЭлемента))";
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+"
		|И (НЕ СправочникиБДРеквизиты.Использование=ЗНАЧЕНИЕ(Перечисление.ИспользованиеРеквизита.ДляГруппы))";
		
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	
	ТабКонтролируемыхРеквизитов=Запрос.Выполнить().Выгрузить();
	
	Если ТабКонтролируемыхРеквизитов.Количество()=0 Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	ЗапросУникальность=Новый Запрос;
	ТекстОтбор="";
	ТекстНезаполненныеРеквизиты="";
	ТекстУникальныеРеквизиты="";
	
	Для Каждого Строка ИЗ ТабКонтролируемыхРеквизитов Цикл
		
		Если Строка.Обязательный И НЕ ЗначениеЗаполнено(Объект[Строка.Имя]) Тогда
			
			ТекстНезаполненныеРеквизиты=ТекстНезаполненныеРеквизиты+Символы.ПС+Строка.Имя;
			
		КонецЕсли;
		
		Если Строка.КонтрольУникальности Тогда
			
			ТекстОтбор=ТекстОтбор+"КонтролируемыйОбъект."+Строка.Имя+"=&"+Строка.Имя+" И ";
			ТекстУникальныеРеквизиты=ТекстУникальныеРеквизиты+Символы.ПС+Строка.Имя+": "+Объект[Строка.Имя];
			ЗапросУникальность.УстановитьПараметр(Строка.Имя,Объект[Строка.Имя]);
			
		КонецЕсли;
		
	КонецЦикла;
		
	Если НЕ ПустаяСтрока(ТекстНезаполненныеРеквизиты) Тогда
		
		Если РежимПроверки Тогда
			
			Возврат НСтр("ru='При проверке элемента справочника обнаружены следующие незаполненные реквизиты, отмеченные как обязательные: '")+ТекстНезаполненныеРеквизиты;
			
		Иначе	
			
			Возврат НСтр("ru='При записи элемента справочника обнаружены следующие незаполненные реквизиты, отмеченные как обязательные: '")+ТекстНезаполненныеРеквизиты;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстОтбор) Тогда
		Возврат "";
	КонецЕсли;
	
	ЗапросУникальность.Текст="ВЫБРАТЬ Первые 1
	|	КонтролируемыйОбъект.Ссылка
	|ИЗ
	|	Справочник."+ОписаниеОбъекта.Наименование+" КАК КонтролируемыйОбъект
	|ГДЕ "+ТекстОтбор+"
	|	КонтролируемыйОбъект.Ссылка <> &Ссылка";
	
	ЗапросУникальность.УстановитьПараметр("Ссылка",Объект.Ссылка);
	Результат=ЗапросУникальность.Выполнить();
		
	Если НЕ Результат.Пустой() Тогда
		
		Возврат НСтр("ru='В базе данных уже присутствует запись с уникальными реквизитами: '")+ТекстУникальныеРеквизиты;
		
	КонецЕсли;	
	
КонецФункции // ПолучитьТаблицуКонтролируемыхРеквизитов() 

	
#КонецОбласти  

Процедура ВыгрузитьСсылкиЗаявокНаИзменениеНСИ(МассивЗаявок=Неопределено) Экспорт
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза КАК Ссылка,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза.СправочникБД.GUIDТекущейИБ КАК GUIDТекущейИБ,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБазаНомер КАК Номер,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБазаДата КАК Дата,
				 |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаРодитель КАК ЗаявкаРодитель
	             |ПОМЕСТИТЬ ЗаявкиАдресация
	             |ИЗ
	             |	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	             |ГДЕ
	             |	&Параметр1
	             |	И НЕ СоответствиеЗаявокНаИзменениеНСИ.ОбменВыполнен
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ЗаявкиАдресация.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	             |	ЗаявкиАдресация.GUIDТекущейИБ КАК GUIDТекущейИБ
	             |ПОМЕСТИТЬ Адресация
	             |ИЗ
	             |	ЗаявкиАдресация КАК ЗаявкиАдресация
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ЗаявкиАдресация.Ссылка КАК Ссылка,
	             |	ЗаявкиАдресация.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	             |	ЗаявкиАдресация.GUIDТекущейИБ КАК GUIDТекущейИБ,
	             |	ЗаявкиАдресация.Номер КАК Номер,
	             |	ЗаявкиАдресация.Дата КАК Дата,
				 |	ЗаявкиАдресация.ЗаявкаРодитель КАК ЗаявкаРодитель
	             |ИЗ
	             |	ЗаявкиАдресация КАК ЗаявкиАдресация
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	Адресация.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	             |	Адресация.GUIDТекущейИБ КАК GUIDТекущейИБ
	             |ИЗ
	             |	Адресация КАК Адресация";
	
	Если ЗначениеЗаполнено(МассивЗаявок) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза В (&МассивЗаявок)");
		Запрос.УстановитьПараметр("МассивЗаявок",МассивЗаявок);
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","ИСТИНА");
		
	КонецЕсли;
	
	Запрос.Текст=ТекстЗапроса;
	
	Результат=Запрос.ВыполнитьПакет();
	
	ТабЗаявок=Результат[2].Выгрузить();
	ТабАдресации=Результат[3].Выгрузить();
	
	Для Каждого Строка ИЗ ТабАдресации Цикл
		
		ДанныеОбмена=Новый Структура("ЦентрализованнаяБазаНСИ,GUIDТекущейИБ",Строка.ЦентрализованнаяБазаНСИ,Строка.GUIDТекущейИБ);
		ЗаявкиДляОбмена=ТабЗаявок.Скопировать(ДанныеОбмена);
		
		Если МассивЗаявок=Неопределено Тогда
			
			ВыгрузитьДанныеЗаявокНаИзменениеНСИ(ДанныеОбмена,ЗаявкиДляОбмена);
			
		Иначе
			
			ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Выгрузка ссылок заявок на изменение НСИ. Внешняя ИБ %1'"),Строка.ЦентрализованнаяБазаНСИ);
			КлючЗадания=Новый УникальныйИдентификатор;
			
			ПараметрыЗадания=Новый Массив;
			ПараметрыЗадания.Добавить(ДанныеОбмена);
			ПараметрыЗадания.Добавить(ЗаявкиДляОбмена);
			
			ФоновыеЗадания.Выполнить("УправлениеНСИ.ВыгрузитьДанныеЗаявокНаИзменениеНСИ",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры // ВыгрузитьСсылкиЗаявокНаИзменениеНСИ()

Процедура ВыгрузитьДанныеЗаявокНаИзменениеНСИ(ДанныеДляОбмена,ЗаявкиДляОбмена) Экспорт
		
	ИспользуемаяИБ=ДанныеДляОбмена.ЦентрализованнаяБазаНСИ;
	ТекСоединениеВИБ = ПодключениеКВИБУХ.ПолучитьСоединение(ИспользуемаяИБ, 1);
	ИспользоватьWS=(ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy"));
	
	Если ТекСоединениеВИБ=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьWS ИЛИ ТипЗнч(ТекСоединениеВИБ)=Тип("Строка") Тогда
		
		СтруктураДанных=Новый Структура;
		
	Иначе
		
		СтруктураДанных=ТекСоединениеВИБ.NewObject("Структура");
		
	КонецЕсли;
	
	СтруктураДанных.Вставить("GUIDТекущейИБ",ДанныеДляОбмена.GUIDТекущейИБ);
				
	СтруктураДанных.Вставить("ТаблицаЗаявок",ВИБ_ПолучитьРабочуюТаблицуЗаявок(ТекСоединениеВИБ,ЗаявкиДляОбмена));
	
	РезультатЗаполнения=Экспорт_ЗаполнитьДанныеЗаявокНаИзменениеНСИ(ТекСоединениеВИБ,СтруктураДанных); 
	
	Если РезультатЗаполнения=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого Строка ИЗ ЗаявкиДляОбмена Цикл
		
		НаборЗаписей=РегистрыСведений.СоответствиеЗаявокНаИзменениеНСИ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗаявкаДочерняяБаза.Установить(Строка.Ссылка);
		
		НаборЗаписей.Прочитать();
		
		Если РезультатЗаполнения.Свойство("ИнформацияОбОшибке") Тогда
			
			НаборЗаписей[0].ЕстьОшибкиОбмена=Истина;
			НаборЗаписей[0].ИнформацияОбОшибке=Новый ХранилищеЗначения(РезультатЗаполнения.ИнформацияОбОшибке);
			
		Иначе
			
			НаборЗаписей[0].ОбменВыполнен=Истина;
			
		КонецЕсли;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;		
		
КонецПроцедуры // ВыгрузитьЗаявкиНаИзменениеНСИ()

Функция ВИБ_ПолучитьРабочуюТаблицуЗаявок(ТекСоединениеВИБ,ТаблицаДанных) Экспорт
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") ИЛИ ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		ТаблицаВыгрузки=Новый ТаблицаЗначений;
		ТаблицаВыгрузки.Колонки.Добавить("Ссылка",			РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОписаниеТиповСтроки(40));
		ТаблицаВыгрузки.Колонки.Добавить("Номер",			РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОписаниеТиповСтроки(10));
		ТаблицаВыгрузки.Колонки.Добавить("Дата",    		РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя));
		ТаблицаВыгрузки.Колонки.Добавить("ЗаявкаРодитель",	РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОписаниеТиповСтроки(40));

		
	Иначе
		
		ТаблицаВыгрузки=ТекСоединениеВИБ.NewObject("ТаблицаЗначений");
		ТаблицаВыгрузки.Колонки.Добавить("Ссылка",			РаботаСОбъектамиМетаданныхВнешнийУХ.ВИБ_ПолучитьОписаниеТиповСтроки(ТекСоединениеВИБ,40));
		ТаблицаВыгрузки.Колонки.Добавить("Номер",			РаботаСОбъектамиМетаданныхВнешнийУХ.ВИБ_ПолучитьОписаниеТиповСтроки(ТекСоединениеВИБ,10));
		ТаблицаВыгрузки.Колонки.Добавить("Дата",    		РаботаСОбъектамиМетаданныхВнешнийУХ.ВИБ_ПолучитьОписаниеТиповДата(ТекСоединениеВИБ,ЧастиДаты.ДатаВремя));
		ТаблицаВыгрузки.Колонки.Добавить("ЗаявкаРодитель",	РаботаСОбъектамиМетаданныхВнешнийУХ.ВИБ_ПолучитьОписаниеТиповСтроки(ТекСоединениеВИБ,40));
		
	КонецЕсли;
		
	Для Каждого Строка ИЗ ТаблицаДанных Цикл
		
		НоваяСтрока=ТаблицаВыгрузки.Добавить();
		НоваяСтрока.Номер=Строка.Номер;
		НоваяСтрока.Дата=Строка.Дата;
		НоваяСтрока.Ссылка=XMLСтрока(Строка.Ссылка);
		НоваяСтрока.ЗаявкаРодитель=Строка.ЗаявкаРодитель;
		
	КонецЦикла;
	
	Возврат ТаблицаВыгрузки; 
		
КонецФункции // ВИБ_ПолучитьРабочуюЗаявок() 

Функция Экспорт_ЗаполнитьДанныеЗаявокНаИзменениеНСИ(ТекСоединениеВИБ,СтруктураДанных)
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
						
		Возврат ТекСоединениеВИБ.FillDataOfMDMApplication(Новый ХранилищеЗначения(СтруктураДанных, Новый СжатиеДанных(9))).Получить();
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"FillDataOfMDMApplication",СтруктураДанных);
		
	Иначе
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.FillDataOfMDMApplication(ТекСоединениеВИБ,СтруктураДанных);
		
	КонецЕсли;
	
КонецФункции // Экспорт_ЗаполнитьДанныеЗаявокНаИзменениеНСИ()


Функция ВыполнитьЗаменуЭлементов(ПравильныйЭлемент, МассивДублей, УдалятьДубли=Истина, ТаблицаДокументовСОшибками = Неопределено) Экспорт
	
	ТаблицаПоиска = ОбщегоНазначения.МестаИспользования(МассивДублей);
	ТаблицаСсылок = ТаблицаПоиска.Скопировать(Новый Структура("ЭтоСлужебныеДанные", Ложь));
	
	Если НЕ ТаблицаДокументовСОшибками = Неопределено Тогда
	
		Если ПроверитьНаличиеВозможныхОшибокСДублямиАналитик(ТаблицаДокументовСОшибками, ПравильныйЭлемент, МассивДублей, ТаблицаСсылок) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	НачатьТранзакцию();
	
	БылиИсключения = Ложь;
	
	ОбрабатываемаяСсылка = Неопределено;
		
	ПараметрыОбъектов = Новый Структура;
	
	Для Каждого РегистрБухгалтерии ИЗ Метаданные.РегистрыБухгалтерии Цикл
		ПараметрыОбъектов.Вставить(РегистрБухгалтерии.Имя+"Субконто", РегистрБухгалтерии.ПланСчетов.МаксКоличествоСубконто);
		ПараметрыОбъектов.Вставить(РегистрБухгалтерии.Имя+"Корреспонденция", РегистрБухгалтерии.Корреспонденция);		
	КонецЦикла;
	
	ПараметрыОбъектов.Вставить("Объект", Неопределено);	
		
	Для Каждого СтрокаТаблицы Из ТаблицаСсылок Цикл
		
		Ссылка = СтрокаТаблицы.Ссылка;
		
		Если ОбрабатываемаяСсылка <> СтрокаТаблицы.Данные Тогда
			
			Если ОбрабатываемаяСсылка <> Неопределено и ПараметрыОбъектов.Объект <> Неопределено Тогда
				
				ПараметрыОбъектов.Объект.ОбменДанными.Загрузка = Истина;
	
				Попытка
					ПараметрыОбъектов.Объект.Записать();
				Исключение 
					
					ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
					

					ОтменитьТранзакцию();
					Возврат Ложь;
				КонецПопытки;
				
				ПараметрыОбъектов.Объект = Неопределено;
				
			КонецЕсли;
			
			ОбрабатываемаяСсылка = СтрокаТаблицы.Данные;
			
		КонецЕсли;
		
			
		Если Метаданные.Документы.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Если ПараметрыОбъектов.Объект = Неопределено Тогда
				ПараметрыОбъектов.Объект = СтрокаТаблицы.Данные.ПолучитьОбъект();
			КонецЕсли;
			
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И ПараметрыОбъектов.Объект[Реквизит.Имя] = Ссылка Тогда
					ПараметрыОбъектов.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;
				
			Для Каждого ТЧ ИЗ СтрокаТаблицы.Метаданные.ТабличныеЧасти Цикл
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
							СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
			Для Каждого Движение ИЗ СтрокаТаблицы.Метаданные.Движения Цикл
				
				ЭтоДвижениеРегистраБухгалтерии = Метаданные.РегистрыБухгалтерии.Содержит(Движение);
				ЕстьКорреспонденция = ЭтоДвижениеРегистраБухгалтерии и ПараметрыОбъектов[Движение.Имя + "Корреспонденция"];
				
				НаборЗаписей  = ПараметрыОбъектов.Объект.Движения[Движение.Имя];
				НаборЗаписей.Прочитать();
				НадоЗаписывать = Ложь;
				ТаблицаНабора = НаборЗаписей.Выгрузить();
				Для Каждого Измерение ИЗ Движение.Измерения Цикл
					
					Если Измерение.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						
						Если ЭтоДвижениеРегистраБухгалтерии И (НЕ Измерение.Балансовый) Тогда
							
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Измерение.Имя+"Дт");
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти[Измерение.Имя+"Дт"] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
								СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Измерение.Имя+"Дт");
							КонецЦикла;
							
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Измерение.Имя+"Кт");
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти[Измерение.Имя+"Кт"] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
								СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Измерение.Имя+"Кт");
							КонецЦикла;
							
							
						Иначе
							
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Измерение.Имя);
							
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти[Измерение.Имя] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
								СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Измерение.Имя);
							КонецЦикла;
							
						КонецЕсли;
						
					КонецЕсли; 
					
				КонецЦикла;
				
				ЕСли Метаданные.РегистрыСведений.Содержит(Движение) Тогда
					Для Каждого Ресурс ИЗ Движение.Ресурсы Цикл
						Если Ресурс.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Ресурс.Имя);
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти[Ресурс.Имя] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
								СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Ресурс.Имя);
							КонецЦикла;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Для Каждого Реквизит ИЗ Движение.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
							НадоЗаписывать = Истина;
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, Реквизит.Имя);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
				
				Если Метаданные.РегистрыБухгалтерии.Содержит(Движение) Тогда
					
					Для ИндексСубконто = 1 по ПараметрыОбъектов[Движение.Имя + "Субконто"] Цикл
						Если ЕстьКорреспонденция Тогда
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, "СубконтоДт"+ИндексСубконто);
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти["СубконтоДт"+ИндексСубконто] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
								СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, "СубконтоДт"+ИндексСубконто);
							КонецЦикла;
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, "СубконтоКт"+ИндексСубконто);
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти["СубконтоКт"+ИндексСубконто] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
								СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, "СубконтоКт"+ИндексСубконто);
							КонецЦикла;
						Иначе
							СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, "Субконто"+ИндексСубконто);
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти["Субконто"+ИндексСубконто] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
								СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, "Субконто"+ИндексСубконто);
							КонецЦикла;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;

				Если НадоЗаписывать Тогда
					НаборЗаписей.Загрузить(ТаблицаНабора);
					НаборЗаписей.ОбменДанными.Загрузка = Истина;
					Попытка
						НаборЗаписей.Записать();
					Исключение
						ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());	
						ОтменитьТранзакцию();
						Возврат Ложь;
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Для Каждого Последовательность ИЗ Метаданные.Последовательности Цикл
				Если Последовательность.Документы.Содержит(СтрокаТаблицы.Метаданные) Тогда
					НадоЗаписывать = Ложь;
					НаборЗаписи = Последовательности[Последовательность.Имя].СоздатьНаборЗаписей();
					НаборЗаписи.Отбор.Регистратор.Установить(СтрокаТаблицы.Данные);
					НаборЗаписи.Прочитать();
					
					Если НаборЗаписи.Количество() > 0 Тогда
						Для Каждого Измерение ИЗ Последовательность.Измерения Цикл
							Если Измерение.Тип.СодержитТип(ТипЗнч(Ссылка)) И НаборЗаписи[0][Измерение.Имя]=Ссылка Тогда
								НаборЗаписи[0][Измерение.Имя] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
							КонецЕсли;
						КонецЦикла;					
						Если НадоЗаписывать Тогда
								НаборЗаписи.ОбменДанными.Загрузка = Истина;
									Попытка
								НаборЗаписи.Записать();
							Исключение
								ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
								ОтменитьТранзакцию();
								Возврат Ложь;
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
			
		ИначеЕсли Метаданные.Справочники.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Если ПараметрыОбъектов.Объект = Неопределено Тогда
				ПараметрыОбъектов.Объект = СтрокаТаблицы.Данные.ПолучитьОбъект();
			КонецЕсли;
			
			Если СтрокаТаблицы.Метаданные.Владельцы.Содержит(Ссылка.Метаданные()) И ПараметрыОбъектов.Объект.Владелец = Ссылка Тогда
				ПараметрыОбъектов.Объект.Владелец = ПравильныйЭлемент;
			КонецЕсли;
			
			Если СтрокаТаблицы.Метаданные.Иерархический И ПараметрыОбъектов.Объект.Родитель = Ссылка Тогда
				ПараметрыОбъектов.Объект.Родитель = ПравильныйЭлемент;
			КонецЕсли;
			
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И ПараметрыОбъектов.Объект[Реквизит.Имя] = Ссылка Тогда
					ПараметрыОбъектов.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.СтандартныеРеквизиты Цикл
				
				Если Реквизит.Имя="Ссылка" Тогда
					Продолжить;
				КонецЕсли;
				
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И ПараметрыОбъектов.Объект[Реквизит.Имя] = Ссылка Тогда
					ПараметрыОбъектов.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;
				
			Для Каждого ТЧ ИЗ СтрокаТаблицы.Метаданные.ТабличныеЧасти Цикл
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
							СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(СтрокаТаблицы.Метаданные)
				  ИЛИ Метаданные.ПланыСчетов.Содержит(СтрокаТаблицы.Метаданные)
				  ИЛИ Метаданные.ПланыВидовРасчета.Содержит(СтрокаТаблицы.Метаданные)
				  ИЛИ Метаданные.Задачи.Содержит(СтрокаТаблицы.Метаданные)
				  ИЛИ Метаданные.БизнесПроцессы.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Если ПараметрыОбъектов.Объект = Неопределено Тогда
				ПараметрыОбъектов.Объект = СтрокаТаблицы.Данные.ПолучитьОбъект();
			КонецЕсли;
						
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И ПараметрыОбъектов.Объект[Реквизит.Имя] = Ссылка Тогда
					ПараметрыОбъектов.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.СтандартныеРеквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И ПараметрыОбъектов.Объект[Реквизит.Имя] = Ссылка Тогда
					ПараметрыОбъектов.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;

			Если  Метаданные.ПланыСчетов.Содержит(СтрокаТаблицы.Метаданные)
				ИЛИ Метаданные.ПланыВидовРасчета.Содержит(СтрокаТаблицы.Метаданные) Тогда
				
				Для Каждого ТЧ ИЗ СтрокаТаблицы.Метаданные.СтандартныеТабличныеЧасти Цикл
					Для Каждого Реквизит Из ТЧ.СтандартныеРеквизиты Цикл
						Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
							СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
							Пока СтрокаТабЧасти <> Неопределено Цикл
								СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
								СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
							КонецЦикла;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				
			КонецЕсли;
						
			Для Каждого ТЧ ИЗ СтрокаТаблицы.Метаданные.ТабличныеЧасти Цикл
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
							СтрокаТабЧасти = ПараметрыОбъектов.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
			
		ИначеЕсли Метаданные.Константы.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Константы[СтрокаТаблицы.Метаданные.Имя].Установить(ПравильныйЭлемент);
			
			
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(СтрокаТаблицы.Метаданные) Тогда	
			
			СтруктураИзмерений = Новый Структура;
			НаборЗаписей = РегистрыСведений[СтрокаТаблицы.Метаданные.Имя].СоздатьНаборЗаписей();
			Для Каждого Измерение ИЗ СтрокаТаблицы.Метаданные.Измерения Цикл
				НаборЗаписей.Отбор[Измерение.Имя].Установить(СтрокаТаблицы.Данные[Измерение.Имя]);
				СтруктураИзмерений.Вставить(Измерение.Имя);
			КонецЦикла;
			Если СтрокаТаблицы.Метаданные.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				НаборЗаписей.Отбор["Период"].Установить(СтрокаТаблицы.Данные.Период);
			КонецЕсли;
			
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				ТаблицаНабора = НаборЗаписей.Выгрузить();
				НаборЗаписей.Очистить();	
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
							
				Попытка
					
					НаборЗаписей.Записать();
					
					Для Каждого Колонка ИЗ ТаблицаНабора.Колонки Цикл
						Если ТаблицаНабора[0][Колонка.Имя] = Ссылка Тогда
							ТаблицаНабора[0][Колонка.Имя] = ПравильныйЭлемент;
							Если СтруктураИзмерений.Свойство(Колонка.Имя) Тогда
								НаборЗаписей.Отбор[Колонка.Имя].Установить(ПравильныйЭлемент);
							КонецЕсли;
							
						КонецЕсли;
					КонецЦикла;
					
					НаборЗаписей.Загрузить(ТаблицаНабора);
					НаборЗаписей.Записать();
									
				Исключение
					
					ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
					ОтменитьТранзакцию();
					Возврат Ложь;
								
				КонецПопытки;
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru = 'Ссылки типа %Метаданные% не заменяются'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Метаданные%", Строка(СтрокаТаблицы.Метаданные));
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
		КонецЕсли;
			
	КонецЦикла;
	
	Если ПараметрыОбъектов.Объект <> Неопределено Тогда
		ПараметрыОбъектов.Объект.ОбменДанными.Загрузка = Истина;
		Попытка
			ПараметрыОбъектов.Объект.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Если УдалятьДубли Тогда
		
		Для Каждого Элемент ИЗ МассивДублей Цикл
			
			ОбъектДубль=Элемент.ПолучитьОбъект();
			ОбъектДубль.ПометкаУдаления=Истина;
			ОбъектДубль.ОбменДанными.Загрузка=Истина;
			
			Попытка
				
				ОбъектДубль.Записать();
				
			Исключение
				
				ТекстСообщения = НСтр("ru = 'Не удалось записать объект %ОбъектДубль%:
                                       |				%ОписаниеОшибки%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОбъектДубль%", Строка(ОбъектДубль));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
				
				ОтменитьТранзакцию();
				Возврат Ложь;
				
			КонецПопытки;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	Возврат Истина;
	
КонецФункции 

// Процедура выдает список ЭО, по которым замена ссылок будет невозможна или дублирования
// строк в регистре сведений
//
Функция ПроверитьНаличиеВозможныхОшибокСДублямиАналитик(ТаблицаДокументовСОшибками, ПравильныйЭлемент, МассивДублей, ТаблицаСсылок)
	
	Таблица = ТаблицаДокументовСОшибками.Выгрузить();
	Таблица.Очистить();
	
	Для каждого Стр Из ТаблицаСсылок Цикл
		
		Если Метаданные.РегистрыСведений.Содержит(Стр.Метаданные) 
			И СтрНайти(Стр.Метаданные.Имя, "ЗначенияПоказателей") = 1  //обрабатываем только РС по показателям
			И НЕ Стр.Метаданные.Измерения.Найти("Аналитика1") = Неопределено //исключаем РС, которые не двигаются через ЭО
			Тогда
			
			Запрос = Новый Запрос();
			
			ТекстЗапроса = "ВЫБРАТЬ СУММА(1) как СчетчикЗаписей, Табл.Версия.Регистратор как Регистратор";
			Для каждого Измерение из Стр.Метаданные.Измерения Цикл
				Если СтрНайти(Измерение.Имя, "Аналитика") = 1 Тогда
					ТекстЗапроса = ТекстЗапроса + ", ВЫБОР Когда Табл." + Измерение.Имя + " В (&МассивДублей, &ПравильныйЭлемент) 
									|	ТОГДА &ПравильныйЭлемент ИНАЧЕ Табл." + Измерение.Имя + " КОНЕЦ КАК " + Измерение.Имя;
				Иначе
					ТекстЗапроса = ТекстЗапроса + ", Табл." + Измерение.Имя;   				
                КонецЕсли;
			КонецЦикла;
			
			ТекстЗапроса = ТекстЗапроса + " ИЗ РегистрСведений." + Стр.Метаданные.Имя 
						+ " КАК Табл ГДЕ Табл.Версия.Регистратор = &Регистратор И (";
			
			Для каждого Измерение из Стр.Метаданные.Измерения Цикл   
				Если СтрНайти(Измерение.Имя, "Аналитика") = 1 Тогда
					ТекстЗапроса = ТекстЗапроса + " Табл." + Измерение.Имя + " В (&МассивДублей, &ПравильныйЭлемент) ИЛИ";
				КонецЕсли;
			КонецЦикла;
			
			ТекстЗапроса = ТекстЗапроса + " ЛОЖЬ) СГРУППИРОВАТЬ ПО Табл.Версия.Регистратор";
			
			Для каждого Измерение из Стр.Метаданные.Измерения Цикл  
				Если СтрНайти(Измерение.Имя, "Аналитика") = 1 Тогда
					ТекстЗапроса = ТекстЗапроса + ", ВЫБОР Когда Табл." + Измерение.Имя + " В (&МассивДублей, &ПравильныйЭлемент) 
									|	ТОГДА &ПравильныйЭлемент ИНАЧЕ Табл." + Измерение.Имя + " КОНЕЦ ";
				Иначе
					ТекстЗапроса = ТекстЗапроса + ", Табл." + Измерение.Имя;  				
                КонецЕсли;
			КонецЦикла;
			
			ТекстЗапроса = ТекстЗапроса + " ИМЕЮЩИЕ СУММА(1) > 1";
				
			Запрос.УстановитьПараметр("Регистратор", 		Стр.Данные.Версия.Регистратор);
			Запрос.УстановитьПараметр("ПравильныйЭлемент", 	ПравильныйЭлемент);
			Запрос.УстановитьПараметр("МассивДублей", 		МассивДублей);
			
			Запрос.Текст = ТекстЗапроса;
				
			Если НЕ Запрос.Выполнить().Пустой() Тогда
				НовСтрока = Таблица.Добавить();
				НовСтрока.ИмяРегистра = Стр.Метаданные.Имя;
				НовСтрока.Документ = Стр.Данные.Версия.Регистратор;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Таблица.Свернуть("Документ,ИмяРегистра");
	
	ТаблицаДокументовСОшибками.Загрузить(Таблица);
	
	Возврат ТаблицаДокументовСОшибками.Количество() > 0;

КонецФункции // ПроверитьНаличиеВозможныхОшибокСДублямиАналитик()

 Функция ПолучитьРодительскуюЗаявку(ЗаявкаСсылка) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка КАК Ссылка,
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка.ВидОперации КАК ВидОперации,
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка.СправочникБД.СогласованиеСвязанныхОбъектов КАК СогласованиеСвязанныхОбъектов
	|ИЗ
	|	Документ.ЗаявкаНаИзменениеНСИ.ЗаявкиНаИзменениеСвязанныхОбъектов КАК ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов
	|ГДЕ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект = &ЗаявкаНаСвязанныйОбъект";
	
	Запрос.УстановитьПараметр("ЗаявкаНаСвязанныйОбъект",ЗаявкаСсылка);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() 
		И (Результат.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта
		ИЛИ Результат.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта) Тогда
		
		Возврат Новый Структура("ЗаявкаРодитель,СпособСогласования",Результат.Ссылка,Результат.СогласованиеСвязанныхОбъектов);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции // ПроверитьОбработатьРодительскуюЗаявку()

