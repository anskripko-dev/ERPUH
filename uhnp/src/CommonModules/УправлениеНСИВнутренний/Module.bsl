Процедура ОтметитьИзменениеКонтролируемогоЭлемента(Объект, Отказ) Экспорт
	
	Если Объект.ОбменДанными.Загрузка=Истина Тогда
		
		Возврат;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	УправлятьНСИ = КэшируемыеПроцедурыУХ.ИспользоватьУправлениеНСИ();
	
	Если НЕ УправлятьНСИ Тогда
		Возврат;
	КонецЕсли;

	МетаданныеОбъекта = Объект.Метаданные();
	ИмяОбъекта = МетаданныеОбъекта.Имя;
	
	Если КэшируемыеПроцедурыУХ.НеКонтролироватьНСИ(ИмяОбъекта) Тогда
		
		Возврат;
	
	КонецЕсли;
				
	ТекОбъект = Справочники.СправочникиБД.НайтиПоНаименованию(ИмяОбъекта,,, Справочники.ТипыБазДанных.ТекущаяИБ);
	
	Если ТекОбъект.ЕстьРеквизитНСИ_НеАктивный И Объект.НСИ_НеАктивный Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ (ТекОбъект.Контролируемый ИЛИ ОбъектВыгружается(ТекОбъект)) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТипОбъектаКонсолидации="Справочник";
	ИмяОбъектаМетаданных=ИмяОбъекта;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВнешниеИнформационныеБазы.Ссылка КАК ИспользуемаяИБ,
	|	НастройкиСоответствия.НастройкаСоответствия КАК НастройкаСоответствия
	|ИЗ
	|	Справочник.ВнешниеИнформационныеБазы КАК ВнешниеИнформационныеБазы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			СоответствиеВнешнимИБ.Владелец КАК Владелец,
	|			СоответствиеВнешнимИБ.Ссылка КАК НастройкаСоответствия
	|		ИЗ
	|			Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СправочникиБД КАК СправочникиБД
	|				ПО (СоответствиеВнешнимИБ.ТипОбъектаКонсолидации = ""Справочник"")
	|					И СоответствиеВнешнимИБ.ИмяОбъектаМетаданных = СправочникиБД.Наименование
	|					И (СправочникиБД.Владелец = &ТекущаяИБ)
	|		ГДЕ
	|			СоответствиеВнешнимИБ.ИмяОбъектаМетаданных = &ИмяОбъектаМетаданных
	|			И СоответствиеВнешнимИБ.ТипОбъектаКонсолидации = &ТипОбъектаКонсолидации
	|			И НЕ СоответствиеВнешнимИБ.Владелец.ВерсияПлатформы = &Платформа77
	|			И НЕ СоответствиеВнешнимИБ.СинхронизацияПоGUID
	|			И НЕ СоответствиеВнешнимИБ.ПометкаУдаления) КАК НастройкиСоответствия
	|		ПО ВнешниеИнформационныеБазы.ТипБД = НастройкиСоответствия.Владелец
	|ГДЕ
	|	ВнешниеИнформационныеБазы.ЭкспортироватьЭлементыНСИ
	|	И НЕ ВнешниеИнформационныеБазы.ПометкаУдаления";
	
	Если Объект.ЭтоНовый() И ЗначениеЗаполнено(Объект.НСИ_ВИБ) Тогда // Нет необходимости выгрузки в ИБ справочника, только что загруженного из нее же
		Запрос.Текст=Запрос.Текст+"
		|И (НЕ ВнешниеИнформационныеБазы.Ссылка=&БазаЗагрузки)";
		
		Запрос.УстановитьПараметр("БазаЗагрузки",Объект.НСИ_ВИБ);
		
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ТекущаяИБ",Справочники.ТипыБазДанных.ТекущаяИБ);
	Запрос.УстановитьПараметр("ТипОбъектаКонсолидации",ТипОбъектаКонсолидации);
	Запрос.УстановитьПараметр("ИмяОбъектаМетаданных",ИмяОбъектаМетаданных);
	Запрос.УстановитьПараметр("Платформа77",Перечисления.ПлатформыВнешнихИнформационныхБаз.Предприятие77);
	
	Результат=Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей=РегистрыСведений.ИзмененныеОбъектыДляВыгрузки.СоздатьНаборЗаписей();

	ТаблицаВИБ=Результат.Выбрать();
	
	Пока ТаблицаВИБ.Следующий() Цикл
		
		НаборЗаписей.Отбор.НастройкаСоответствия.Установить(ТаблицаВИБ.НастройкаСоответствия);
		НаборЗаписей.Отбор.ИспользуемаяИБ.Установить(ТаблицаВИБ.ИспользуемаяИБ);
		НаборЗаписей.Отбор.Элемент.Установить(Объект.Ссылка);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество()=0 Тогда
			
			НоваяСтрока=НаборЗаписей.Добавить();
			НоваяСтрока.ИспользуемаяИБ=ТаблицаВИБ.ИспользуемаяИБ;
			НоваяСтрока.НастройкаСоответствия=ТаблицаВИБ.НастройкаСоответствия;
			НоваяСтрока.Элемент=Объект.Ссылка;
			
			НаборЗаписей.Записать();
						
		КонецЕсли;
		
	КонецЦикла;
	
	ВыгрузитьИзмененныйОбъектПоНастройке(Объект,ТекОбъект);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры // ОтметитьИзменениеКонтролируемогоЭлемента()

Функция ОбъектВыгружается(СправочникБД)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	             |	ПараметрыОбменаНСИ.Ссылка КАК Ссылка
	             |ИЗ
	             |	Справочник.ПараметрыОбменаНСИ КАК ПараметрыОбменаНСИ
	             |ГДЕ
	             |	ПараметрыОбменаНСИ.ОписаниеОбъектаМетаданных = &СправочникБД
	             |	И НЕ ПараметрыОбменаНСИ.ПометкаУдаления
	             |	И ПараметрыОбменаНСИ.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ВыгрузкаЗагрузка.Выгрузка)";
	
	Запрос.УстановитьПараметр("СправочникБД",СправочникБД);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции // ОбъектВыгружается() 

Функция НеКонтролируетсяНСИ(МетаданныеОбъекта) Экспорт

	ИмяОбъекта = МетаданныеОбъекта.Имя; 
	
	Если КэшируемыеПроцедурыУХ.НеКонтролироватьНСИ(ИмяОбъекта) Тогда		
		
		Возврат Истина;
		
	КонецЕсли;
	
	Если (НЕ Метаданные.ОбщиеРеквизиты.НСИ_НеАктивный.Состав.Найти(МетаданныеОбъекта).Использование=Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать)
		И МетаданныеОбъекта.Реквизиты.Найти("НСИ_НеАктивный")=Неопределено Тогда		
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции // НеКонтролируетсяНСИ() 

Процедура ВыгрузитьИзмененныйОбъектПоНастройке(Объект,ОписаниеОбъекта)
	
	Если ОписаниеОбъекта.ЕстьРеквизитНСИ_НеАктивный
		И Объект.НСИ_НеАктивный Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ПараметрыОбменаНСИ.Ссылка КАК Ссылка,
	             |	ПараметрыОбменаНСИ.АдресацияОбменаНСИ.(
	             |		АдресОбмена КАК АдресОбмена,
	             |		Отбор КАК Отбор
	             |	) КАК АдресацияОбменаНСИ,
	             |	ПараметрыОбменаНСИ.СпособВыбораИБ КАК СпособВыбораИБ,
	             |	ПараметрыОбменаНСИ.НастройкаОтбора КАК НастройкаОтбора,
	             |	ПараметрыОбменаНСИ.ОписаниеОбъектаМетаданных КАК ОписаниеОбъектаМетаданных
	             |ИЗ
	             |	Справочник.ПараметрыОбменаНСИ КАК ПараметрыОбменаНСИ
	             |ГДЕ
	             |	ПараметрыОбменаНСИ.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ВыгрузкаЗагрузка.Выгрузка)
	             |	И ПараметрыОбменаНСИ.СпособЗапуска = ЗНАЧЕНИЕ(Перечисление.СпособыЗапускаОбменаНСИ.ПриЗаписиИзмененного)
	             |	И ПараметрыОбменаНСИ.ОписаниеОбъектаМетаданных = &ОписаниеОбъектаМетаданных
	             |	И НЕ ПараметрыОбменаНСИ.Отключен
	             |	И НЕ ПараметрыОбменаНСИ.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ОписаниеОбъектаМетаданных",ОписаниеОбъекта);
	
	Результат=Запрос.Выполнить().Выбрать(); 
	
	СписокОтбора=Новый СписокЗначений;
	СписокОтбора.Добавить(Объект.Ссылка);
	
	Пока Результат.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Результат.НастройкаОтбора) Тогда
			
			МассивЭлементов=Справочники.СохраненныеНастройкиОтборов.ПолучитьТаблицуЭлементовПоОтбору(Результат.НастройкаОтбора,
																	Ложь).ВыгрузитьКолонку("Ссылка");
																	
			Если МассивЭлементов.Найти(Объект.Ссылка)=Неопределено Тогда														
				
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ТаблицаПараметров=Справочники.ПараметрыОбменаНСИ.ПолучитьПараметрыВыгрузкиНСИ(Результат);
		
		Для Каждого СтрокаНастройки Из ТаблицаПараметров Цикл
			
			ИнтеграцияСВнешнимиСистемамиУХ.ВыгрузитьОбъектыВВИБ(СтрокаНастройки.ИспользуемаяИБ,СтрокаНастройки.НастройкаСоответствия,СписокОтбора);
			
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры // ВыгрузитьИзмененныйОбъектПоНастройке()

Функция ПолучитьИмяВерсииСоглашения(ДоговорКонтрагента)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента.ВидДоговораУХ,"ИмяДокумента");
	
КонецФункции // ПолучитьИмяВерсииСоглашения() 

Процедура УстановитьРеквизитыКонтроляНСИТекущаяИБ(Объект,ОписаниеОбъекта,Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	МетаданныеОбъекта=Объект.Метаданные();	
	ИмяОбъекта=МетаданныеОбъекта.Имя;
	
	Если НеКонтролируетсяНСИ(МетаданныеОбъекта) Тогда
		
		Возврат;
		
	КонецЕсли;	
			
	Если ОписаниеОбъекта.РазделятьПоОрганизациям Тогда
		ТекОрганизация = Объект.Организация;
	Иначе
		ТекОрганизация = Неопределено;
	КонецЕсли;
			
    ТребуетсяСогласованиеЭлементов = (НЕ ОписаниеОбъекта.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.НеКонтролируется);
				
	ТекущийПользователь = Пользователи.АвторизованныйПользователь();
	
	КонтролироватьНСИ=ТребуетсяСогласованиеЭлементов И (НЕ Объект.ОбменДанными.Загрузка);
	
	Если КонтролироватьНСИ Тогда 
		
		ТекстОшибки=УправлениеНСИ.ПроверитьКонтролируемыеРеквизитыОбъекта(Объект,ОписаниеОбъекта);
		
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда 
			
			ТекстОшибки=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Запись объекта %1 (%2) отменена по причине:
			|%3'"),Объект,ОписаниеОбъекта.Наименование,ТекстОшибки);
	
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,Отказ,,СтатусСообщения.Внимание);
			
			Возврат
			
		КонецЕсли;
		
		Если ОписаниеОбъекта.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ПроверятьЗаполнениеРеквизитов Тогда
			
			Возврат;
			
		КонецЕсли;
		
		Если Справочники.СправочникиБД.ЭтоДоговорКонтрагента(ОписаниеОбъекта.Наименование) Тогда
			
			ИмяДокумента=ПолучитьИмяВерсииСоглашения(Объект);
			
			Исполнители = УправлениеОтчетамиУХ.ПолучитьОтветственногоЗаТипОбъекта(Документы[ИмяДокумента].ПустаяСсылка(),ТекОрганизация,ОписаниеОбъекта.Ссылка,"Исполнитель", Истина);
			Согласующие = УправлениеОтчетамиУХ.ПолучитьОтветственногоЗаТипОбъекта(Документы[ИмяДокумента].ПустаяСсылка(),ТекОрганизация,ОписаниеОбъекта.Ссылка,"Согласующий", Истина);
		
		Иначе
			
			Исполнители = УправлениеОтчетамиУХ.ПолучитьОтветственногоЗаТипОбъекта(Документы.ЗаявкаНаИзменениеНСИ.ПустаяСсылка(),ТекОрганизация,ОписаниеОбъекта.Ссылка,"Исполнитель", Истина);
			Согласующие = УправлениеОтчетамиУХ.ПолучитьОтветственногоЗаТипОбъекта(Документы.ЗаявкаНаИзменениеНСИ.ПустаяСсылка(),ТекОрганизация,ОписаниеОбъекта.Ссылка,"Согласующий", Истина);
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если НЕ Объект.ЭтоНовый() Тогда // Проверим возможность записи измененного объекта
		
		Если (НЕ КонтролироватьНСИ) ИЛИ ОписаниеОбъекта.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ИзмененияПоВерсиям Тогда	
			
			УстановитьОтметкуРедактирования(Объект,ТекущийПользователь,ОписаниеОбъекта.ЕстьРеквизитыИсторииИзменений);
			УстановитьПривилегированныйРежим(Ложь);
			Возврат;
			
		Иначе	
							
			Если Объект.НСИ_НеАктивный 
				ИЛИ Согласующие.Найти(ТекущийПользователь) <> Неопределено Тогда			
				УстановитьОтметкуРедактирования(Объект,ТекущийПользователь,ОписаниеОбъекта.ЕстьРеквизитыИсторииИзменений);
			Иначе
				
				Если Объект.ПометкаУдаления И (НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка,"ПометкаУдаления")) Тогда
					
					ТекстОшибки=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Записываемый объект %1 (%2) контролируется системой ЦНСИ.
						|Для установки пометки удаления воспользуйтесь заявкой на удаление НСИ.'"),Объект,ОписаниеОбъекта.Наименование);
						
						ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,Отказ,,СтатусСообщения.Внимание);
					
				Иначе	
					
					ДанныеИзменений=УправлениеНСИ.ПолучитьСтруктуруИзмененийОбъекта(Новый Структура("Объект,Ссылка",Объект,Объект.Ссылка));
					
					Если ДанныеИзменений.Количество()=0 Тогда
						
						УстановитьОтметкуРедактирования(Объект,ТекущийПользователь,ОписаниеОбъекта.ЕстьРеквизитыИсторииИзменений);
						
					Иначе	
						
						ТекстОшибки=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Записываемый объект %1 (%2) контролируется системой ЦНСИ.
						|Для изменения воспользуйтесь заявкой на изменение НСИ.'"),Объект,ОписаниеОбъекта.Наименование);
						
						ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,Отказ,,СтатусСообщения.Внимание);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
						
	Иначе
		
		Если КонтролироватьНСИ Тогда
				
			Если Исполнители.Найти(ТекущийПользователь) <> Неопределено ИЛИ Исполнители.Количество() = 0 Тогда
				
				Если ОписаниеОбъекта.ЕстьРеквизитыИсторииИзменений Тогда
					
					Объект.НСИ_Автор=ТекущийПользователь;
					Объект.НСИ_ДатаИзменения=ТекущаяДата();
					Объект.НСИ_ПоследнийРедактировавший=ТекущийПользователь;
					
				КонецЕсли;
				
				Объект.НСИ_НеАктивный = (Согласующие.Найти(ТекущийПользователь) = Неопределено);
								
			Иначе	
				
				ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Текущий пользователь не имеет права создавать объект %1'"), 
					Объект),Отказ,,СтатусСообщения.Внимание);
				
				УстановитьПривилегированныйРежим(Ложь);
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ОписаниеОбъекта.ЕстьРеквизитНСИ_ВИБ
			И ЗначениеЗаполнено(Объект.НСИ_ВИБ) 
			И Объект.НСИ_ВИБ.НСИ_ТребуетСинхронизации Тогда
			
			Объект.НСИ_ТребуетСинхронизации=Истина;
			Объект.НСИ_НеАктивный=Истина;
			
		КонецЕсли;
		
	КонецЕсли;		
	
КонецПроцедуры // УстановитьРеквизитыКонтроляНСИТекущаяИБ()

Процедура УстановитьОтметкуРедактирования(Объект,ТекущийПользователь,ЕстьРеквизитыИсторииИзменений) Экспорт
	
	Если ЕстьРеквизитыИсторииИзменений Тогда
		
		Объект.НСИ_ДатаИзменения=ТекущаяДата();
		Объект.НСИ_ПоследнийРедактировавший=ТекущийПользователь;
		
	КонецЕсли;
		
КонецПроцедуры // УстановитьОтметкуРедактирования()

Процедура ВыполнитьДействияПриОбработкеЗаявки(СправочникОбъект,Отказ,ЕстьРеквизитыИсторииИзменений) Экспорт
	
	Если ЕстьРеквизитыИсторииИзменений Тогда
		ТекущийПользователь = Пользователи.АвторизованныйПользователь();
		УстановитьОтметкуРедактирования(СправочникОбъект,ТекущийПользователь,Истина);
	КонецЕсли;
	
	ОтметитьИзменениеКонтролируемогоЭлемента(СправочникОбъект,Отказ);
		
КонецПроцедуры // ВыполнитьДействияПриОбработкеЗаявки() 

Процедура ОбработатьУстановкуСтатусаЗаявкиНСИ(ЗаявкаСсылка, ТекСостояние,Отказ) Экспорт
	
	Если ТекСостояние = Перечисления.СостоянияСогласования.Отклонена  Тогда
		ОбъектЗаявки = ЗаявкаСсылка.ПолучитьОбъект();
		ОбъектЗаявки.ВыполнитьДействияПоОбъекту(Отказ, Истина);
	ИначеЕсли ТекСостояние = Перечисления.СостоянияСогласования.Утверждена Тогда
		ОбъектЗаявки = ЗаявкаСсылка.ПолучитьОбъект();
		ОбъектЗаявки.ВыполнитьДействияПоОбъекту(Отказ, Ложь);
		
		Если НЕ Отказ Тогда
			
			ПроверитьОбработатьРодительскуюЗаявку(ЗаявкаСсылка);
			
		КонецЕсли;
		
	КонецЕсли;			
	
КонецПроцедуры // ОбработатьУстановкуСтатусаЗаявкиНСИ() 

Функция ПолучитьРодительскуюЗаявку(ЗаявкаСсылка) Экспорт
	
    Возврат УправлениеНСИ.ПолучитьРодительскуюЗаявку(ЗаявкаСсылка);
	
КонецФункции // ПолучитьРодительскуюЗаявку() 

Процедура ПроверитьОбработатьРодительскуюЗаявку(ЗаявкаСсылка)
	
	ДанныеЗаявкиРодитель=ПолучитьРодительскуюЗаявку(ЗаявкаСсылка);
	
	Если ДанныеЗаявкиРодитель=Неопределено
		ИЛИ (Не ДанныеЗаявкиРодитель.СпособСогласования=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьОтдельно) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект
	|ПОМЕСТИТЬ ТабСвязанныхЗаявок
	|ИЗ
	|	Документ.ЗаявкаНаИзменениеНСИ.ЗаявкиНаИзменениеСвязанныхОбъектов КАК ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов
	|ГДЕ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект,
	|	ВЫБОР
	|		КОГДА РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА СоответствиеЗаявокНаИзменениеНСИ.Состояние ЕСТЬ NULL
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)
	|					ИНАЧЕ СоответствиеЗаявокНаИзменениеНСИ.Состояние
	|				КОНЕЦ
	|		ИНАЧЕ РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта
	|	КОНЕЦ КАК СостояниеСогласования
	|ИЗ
	|	ТабСвязанныхЗаявок КАК ТабСвязанныхЗаявок
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних(, ) КАК РегистрСостоянийОбъектовСрезПоследних
	|		ПО ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект = РегистрСостоянийОбъектовСрезПоследних.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	|		ПО ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект = СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза
	|ГДЕ
	|	НЕ ВЫБОР
	|				КОГДА РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта ЕСТЬ NULL
	|					ТОГДА ВЫБОР
	|							КОГДА СоответствиеЗаявокНаИзменениеНСИ.Состояние ЕСТЬ NULL
	|								ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)
	|							ИНАЧЕ СоответствиеЗаявокНаИзменениеНСИ.Состояние
	|						КОНЕЦ
	|				ИНАЧЕ РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта
	|			КОНЕЦ = ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Утверждена)";
	
	Запрос.УстановитьПараметр("Ссылка",ДанныеЗаявкиРодитель.ЗаявкаРодитель);
		
	Результат=Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		
		МодульУправленияПроцессамиУХ.ПринятьКОбработке(,ДанныеЗаявкиРодитель.ЗаявкаРодитель);
		
	КонецЕсли;	
	
КонецПроцедуры // ПроверитьОбработатьРодительскуюЗаявку() 

Функция ПолучитьМассивСвязанныхЗаявок(ЗаявкаНаИзменениеНСИ) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект
	|ИЗ
	|	Документ.ЗаявкаНаИзменениеНСИ.ЗаявкиНаИзменениеСвязанныхОбъектов КАК ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов
	|ГДЕ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ЗаявкаНаИзменениеНСИ);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаявкаНаСвязанныйОбъект");
	
	
КонецФункции // ПолучитьМассивСвязанныхЗаявок()

Функция ЕстьСинхронноеСогласованиеОбъектов(ЗаявкаНаИзменениеНСИ) Экспорт

	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ЗаявкаНаИзменениеНСИ.ВидОперации КАК ВидОперации,
	|	ЗаявкаНаИзменениеНСИ.СправочникБД.СогласованиеСвязанныхОбъектов КАК СогласованиеСвязанныхОбъектов
	|ИЗ
	|	Документ.ЗаявкаНаИзменениеНСИ КАК ЗаявкаНаИзменениеНСИ
	|ГДЕ
	|	ЗаявкаНаИзменениеНСИ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ЗаявкаНаИзменениеНСИ);
	
	ДанныеЗаявки=Запрос.Выполнить().Выгрузить()[0];
	
	Возврат (ДанныеЗаявки.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта
			ИЛИ ДанныеЗаявки.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта)
			И ДанныеЗаявки.СогласованиеСвязанныхОбъектов=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьСинхронно;
	
КонецФункции // ПолучитьСпособСогласованияСвязанныхОбъектов() 

Процедура ОбработатьУстановкуСтатусаВерсииСоглашения(ВерсияСоглашения, ТекСостояние,Отказ) Экспорт
	
	Если ТекСостояние = Перечисления.СостоянияСогласования.Утверждена Тогда
		
		ИзменяемыйДоговор=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВерсияСоглашения,"ДоговорКонтрагента");
		
		Если ТипЗнч(ИзменяемыйДоговор)=Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			
			ОбъектДоговор = ИзменяемыйДоговор.ПолучитьОбъект();
			ОбъектДоговор.НСИ_НеАктивный=Ложь;
			ОбъектДоговор.ОбменДанными.Загрузка=Истина;
			ОбъектДоговор.Записать();
			
		КонецЕсли;
		
	КонецЕсли;			
	
КонецПроцедуры // ОбработатьУстановкуСтатусаЗаявкиНСИ() 

Функция ЭтоВерсияСоглашения(Ссылка) Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("ДоговорыКонтрагентовВстраиваниеУХКлиентСервер")=Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	МодульДоговоры=ОбщегоНазначения.ОбщийМодуль("ДоговорыКонтрагентовВстраиваниеУХКлиентСервер");		
	
	Возврат МодульДоговоры.ЭтоВерсияСоглашения(Ссылка);
						
КонецФункции

// Функция возвращает данные объекта НСИ
//
// Параметры:
//  ИмяОбъекта	 - Строка - Имя объекта метаданных, для которого требуется получить параметры.
// 
// Возвращаемое значение:
//  Структура, Неопределено - Структура параметров объекта НСИ, или Неопределено, если описание объекта не найдено.
//
Функция ПолучитьДанныеОбъектаНСИ(ИмяОбъекта) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБД.ЕстьРеквизитыИсторииИзменений
	             |		ИЛИ СправочникиБД.ЕстьРеквизитНСИ_НеАктивный КАК ЕстьРеквизитыНСИ,
	             |	СправочникиБД.ЕстьРеквизитНСИ_ВИБ КАК ЕстьРеквизитНСИ_ВИБ,
	             |	СправочникиБД.ЕстьРеквизитНСИ_ВИБ КАК ЕстьРеквизитыИсторииИзменений,
	             |	СправочникиБД.РазделятьПоОрганизациям КАК РазделятьПоОрганизациям,
	             |	СправочникиБД.ТипКонтроляНСИ КАК ТипКонтроляНСИ,
	             |	СправочникиБД.Ссылка КАК Ссылка,
	             |	СправочникиБД.Наименование КАК Наименование,
	             |	ВЫБОР
	             |		КОГДА СправочникиБД.ВидИерархии = ЗНАЧЕНИЕ(Перечисление.ВидИерархии.ИерархияГруппИЭлементов)
	             |			ТОГДА ИСТИНА
	             |		ИНАЧЕ ЛОЖЬ
	             |	КОНЕЦ КАК УчитыватьГруппы,
	             |	СправочникиБД.ИерархическийСправочник КАК ИерархическийСправочник,
	             |	СправочникиБД.ВидИерархии КАК ВидИерархии,
	             |	СправочникиБД.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	             |	СправочникиБД.СогласованиеСвязанныхОбъектов КАК СогласованиеСвязанныхОбъектов
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	СправочникиБД.Наименование = &Наименование
	             |	И СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)";
	
	Запрос.УстановитьПараметр("Наименование",ИмяОбъекта);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат=Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()>0 Тогда
		
		СтруктураКонтроля=ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Результат[0]);
		СтруктураКонтроля.Вставить("КонтролироватьАктивность",
				СтруктураКонтроля.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ЗаявкиНаИзменениеНСИ
				ИЛИ СтруктураКонтроля.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ИзмененияПоВерсиям); 
				
		СтруктураКонтроля.Вставить("ВыборНеАктивных",СтруктураКонтроля.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ЗаявкиНаИзменениеНСИ
				И (СтруктураКонтроля.СогласованиеСвязанныхОбъектов=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьОтдельно
				ИЛИ СтруктураКонтроля.СогласованиеСвязанныхОбъектов=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьСинхронно));
		
		Возврат СтруктураКонтроля;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
				 			 	
КонецФункции // ПолучитьДанныеОбъектаНСИ()
