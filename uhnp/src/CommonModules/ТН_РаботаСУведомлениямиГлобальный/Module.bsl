#Область ПрограммныйИнтерфейс

Процедура ПроверитьУведомления() Экспорт
	
	Если Не ТН_РаботаСУведомлениями.ЕстьПравоЧтенияУведомлений() Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьУведомления = ТН_РаботаСУведомлениями.ЗначениеКонстанты("ТН_ИспользоватьУведомления"); 
	
	Если ИспользоватьУведомления Тогда
		
		СписокУведомлений = ТН_РаботаСУведомлениями.ПолучитьСписокУведомлений();
		
		Если СписокУведомлений.Количество() Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СписокУведомлений", СписокУведомлений);
			
			ОткрытьФорму("ОбщаяФорма.ТН_ФормаУведомлений", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 
			
			Для Каждого Уведомление Из СписокУведомлений Цикл 
				
				РеквизитыУведомления = ТН_РаботаСУведомлениями.ЗначенияРеквизитовУведомления(Уведомление, "Автор,Код");
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьУведмоление", ТН_РаботаСУведомлениямиКлиент, Уведомление);
				
				ПоказатьОповещениеПользователя(Строка(Уведомление),
											ОписаниеОповещения,
											"Новое уведомление от " + РеквизитыУведомления.Автор,
											БиблиотекаКартинок.ДиалогВосклицание,
											СтатусОповещенияПользователя.Важное,
											РеквизитыУведомления.Код);
											
			КонецЦикла;
										
		КонецЕсли;
		
	КонецЕсли;
	
	ИнтервалПроверкиУведомлений = ТН_РаботаСУведомлениями.ЗначениеКонстанты("ТН_ИнтервалПроверкиУведомлений");
	Если ИнтервалПроверкиУведомлений > 0 Тогда	
		ПодключитьОбработчикОжидания("ПроверитьУведомления", ИнтервалПроверкиУведомлений, Истина);
	КонецЕсли;  
	
КонецПроцедуры   

#КонецОбласти
