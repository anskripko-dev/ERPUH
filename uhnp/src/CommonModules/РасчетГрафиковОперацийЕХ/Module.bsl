////////////////////////////////////////////////////////////////////////////////
// Модуль содержит процедуры и функции, необходимые для расчета графиков платежей.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция ВариантыОплатыАванса() Экспорт 
	
	Варианты = Новый Массив;   
	
	Варианты.Добавить(Перечисления.ВариантыОплаты.Аванс);
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыКлиентом.АвансДоОбеспечения);
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыКлиентом.ПредоплатаДоОтгрузки);
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыПоставщику.АвансДоПодтверждения);
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыПоставщику.ПредоплатаДоПоступления);
	
	Возврат Варианты;
	
КонецФункции     

Функция ЭтоЭтапАванса(ВариантОплаты) Экспорт 
	
	Возврат ВариантыОплатыАванса().Найти(ВариантОплаты) <> Неопределено;
			
КонецФункции

Функция ПолучитьГрафикЭтаповОплатыПоСоглашению(Знач ОбщаяСумма, Знач БазоваяДата, Знач ВерсияСоглашения, ТолькоПостоплата = Ложь) Экспорт 

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Дата", , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Результат.Колонки.Добавить("Сумма", , РаботаСКурсамиВалют.ОписаниеТипаДенежногоПоля());
	
	Если ОбщаяСумма = 0 Или Не ЗначениеЗаполнено(ВерсияСоглашения) Тогда
		Возврат Результат;
	КонецЕсли;  
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВерсияСоглашения, "ЭтапыГрафикаОплаты")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВерсияСоглашения, "ПроизводственныеКалендари") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЭтапыГрафикаОплаты = ВерсияСоглашения.ЭтапыГрафикаОплаты;  
	ПроизводственныйКалендарь = ВерсияСоглашения.ПроизводственныеКалендари.ВыгрузитьКолонку("ПроизводственныйКалендарь");
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВерсияСоглашения, "СпособРасчетаКоличестваДней") Тогда
		СпособРасчетаКоличестваДней = ВерсияСоглашения.СпособРасчетаКоличестваДней; 
	Иначе     
		СпособРасчетаКоличестваДней = Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням; 
	КонецЕсли;
	
	МассивКоэффициентов = ЭтапыГрафикаОплаты.ВыгрузитьКолонку("ПроцентПлатежа");
	РаспределенныеСуммы = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ОбщаяСумма, МассивКоэффициентов);
		
	Для Каждого ЭтапОплаты Из ВерсияСоглашения.ЭтапыГрафикаОплаты Цикл
		
		Если ТолькоПостоплата И ЭтоЭтапАванса(ЭтапОплаты.ВариантОплаты) Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексЭтапа = ЭтапыГрафикаОплаты.Индекс(ЭтапОплаты);
		
		НоваяОплата = Результат.Добавить();
		НоваяОплата.Дата = ДатаОплатыПоЭтапуСоглашения(БазоваяДата, ЭтапОплаты, СпособРасчетаКоличестваДней, ПроизводственныйКалендарь);
		НоваяОплата.Сумма = РаспределенныеСуммы[ИндексЭтапа];
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМаксимальныйСрокОплаты(ВерсияСоглашения) Экспорт 
		
	Если Не ВерсияСоглашения.Свойство("ЭтапыГрафикаОплаты") Тогда
		Возврат 0;	
	КонецЕсли;  
	
	ЭтапыГрафикаОплаты = ВерсияСоглашения.ЭтапыГрафикаОплаты.Выгрузить();

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапыГрафикаОплаты.ВариантОплаты КАК ВариантОплаты,
	|	ЭтапыГрафикаОплаты.Сдвиг КАК Сдвиг,
	|	ЭтапыГрафикаОплаты.ПроцентПлатежа КАК ПроцентПлатежа,
	|	ЭтапыГрафикаОплаты.ВариантОтсчета КАК ВариантОтсчета
	|ПОМЕСТИТЬ ВТ_ЭтапыГрафикаОплаты
	|ИЗ
	|	&ЭтапыГрафикаОплаты КАК ЭтапыГрафикаОплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВТ_ЭтапыГрафикаОплаты.Сдвиг), 0) КАК Срок
	|ИЗ
	|	ВТ_ЭтапыГрафикаОплаты КАК ВТ_ЭтапыГрафикаОплаты
	|ГДЕ
	|	ВТ_ЭтапыГрафикаОплаты.ВариантОплаты В(&ВариантыПостоплата)";
	
	Запрос.УстановитьПараметр("ЭтапыГрафикаОплаты", ЭтапыГрафикаОплаты);
	Запрос.УстановитьПараметр("ВариантыПостоплата", ВариантыПостоплата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Срок = 0;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Срок = ВыборкаДетальныеЗаписи.Срок;
	КонецЕсли;
	
	Возврат Срок; 
	
КонецФункции

Функция ПолучитьПроцентАванса(ВерсияСоглашения) Экспорт 
	
	Если Не ВерсияСоглашения.Свойство("ЭтапыГрафикаОплаты") Тогда
		Возврат 0;	
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапыГрафикаОплаты.ВариантОплаты КАК ВариантОплаты,
	|	ЭтапыГрафикаОплаты.Сдвиг КАК Сдвиг,
	|	ЭтапыГрафикаОплаты.ПроцентПлатежа КАК ПроцентПлатежа,
	|	ЭтапыГрафикаОплаты.ВариантОтсчета КАК ВариантОтсчета
	|ПОМЕСТИТЬ ВТ_ЭтапыГрафикаОплаты
	|ИЗ
	|	&ЭтапыГрафикаОплаты КАК ЭтапыГрафикаОплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВТ_ЭтапыГрафикаОплаты.ПроцентПлатежа), 0) КАК ПроцентПлатежа
	|ИЗ
	|	ВТ_ЭтапыГрафикаОплаты КАК ВТ_ЭтапыГрафикаОплаты
	|ГДЕ
	|	ВТ_ЭтапыГрафикаОплаты.ВариантОплаты В(&ВариантыАванс)";
	
	Запрос.УстановитьПараметр("ЭтапыГрафикаОплаты", ВерсияСоглашения.ЭтапыГрафикаОплаты.Выгрузить());
	Запрос.УстановитьПараметр("ВариантыАванс",  ВариантыОплатыАванса());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ПроцентПлатежа = 0;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ПроцентПлатежа = ВыборкаДетальныеЗаписи.ПроцентПлатежа;
	КонецЕсли;
	
	Возврат ПроцентПлатежа;
	
КонецФункции

Функция ДатаАвансаПоНакладной(ВерсияСоглашения, ДатаПоступления) Экспорт 

	ДатаАванса = Дата(1, 1, 1);
	ЭтапыОплаты = ВерсияСоглашения.ЭтапыГрафикаОплаты;
	
	ПроизводственныйКалендарь = ВерсияСоглашения.ПроизводственныеКалендари.ВыгрузитьКолонку("ПроизводственныйКалендарь");
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВерсияСоглашения, "СпособРасчетаКоличестваДней") Тогда
		СпособРасчетаКоличестваДней = ВерсияСоглашения.СпособРасчетаКоличестваДней; 
	Иначе     
		СпособРасчетаКоличестваДней = Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням; 
	КонецЕсли;
	
	Для Каждого Этап ИЗ ЭтапыОплаты Цикл
		Если ЭтоЭтапАванса(Этап.ВариантОплаты) Тогда     		
			ДатаАванса = РасчетГрафиковОперацийУХ.ДатаОтБазовойДатыСоСдвигом(ДатаПоступления, -Этап.Сдвиг, СпособРасчетаКоличестваДней, ПроизводственныйКалендарь); 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДатаАванса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
Функция ВариантыПостоплата() 

	Варианты = Новый Массив;
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки);
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыКлиентом.КредитСдвиг);
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыПоставщику.КредитПослеПоступления);
	Варианты.Добавить(Перечисления.ВариантыКонтроляОплатыПоставщику.КредитСдвиг);
	
	Возврат Варианты;

КонецФункции   

Функция ДатаОплатыПоЭтапуСоглашения(БазоваяДата, ЭтапОплаты, СпособРасчетаКоличестваДней, ПроизводственныйКалендарь)
	
	КоличествоДней = ЭтапОплаты.Сдвиг;
	
	Если ЭтоЭтапАванса(ЭтапОплаты.ВариантОплаты) Тогда 
		КоличествоДней = -КоличествоДней;
	КонецЕсли;
	
	Возврат РасчетГрафиковОперацийУХ.ДатаОтБазовойДатыСоСдвигом(БазоваяДата, КоличествоДней, СпособРасчетаКоличестваДней, ПроизводственныйКалендарь);
	
КонецФункции

#КонецОбласти
