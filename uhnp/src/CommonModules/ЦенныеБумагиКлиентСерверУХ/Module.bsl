
#Область ПрограммныйИнтерфейс

Процедура УстановитьЗаголовокФормы(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ТекстЗаголовка = "";
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ТекстЗаголовка = Строка(Объект.Ссылка);
		Если ЗначениеЗаполнено(Объект.ВидФинансовогоИнструмента) Тогда
			ТекстЗаголовка = ТекстЗаголовка + СтрШаблон(" (%1)", Объект.ВидФинансовогоИнструмента);
		КонецЕсли;
		
	Иначе
		
		ТекстЗаголовка = ?(ЗначениеЗаполнено(Объект.ВидФинансовогоИнструмента),
			Строка(Объект.ВидФинансовогоИнструмента),
			НСтр("ru = 'Ценная бумага'")) + НСтр("ru = ' (создание)'");
			
	КонецЕсли;
	
	Форма.Заголовок = ТекстЗаголовка;

КонецПроцедуры

Процедура УстановитьПараметрыЦеннойБумаги(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если ЗначениеЗаполнено(Объект.ФинансовыйИнструмент) Тогда
		
		КонтекстФИ = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(
			Объект.ФинансовыйИнструмент,
			"ЭтоБиржевойРынок, ДисконтнаяЦБ, ВидФинансовогоИнструмента");
		
		Форма.ДисконтнаяЦБ = КонтекстФИ.ДисконтнаяЦБ;	
		Форма.ЭтоБиржевойРынок = КонтекстФИ.ЭтоБиржевойРынок;
		Форма.ВидФинансовогоИнструмента = КонтекстФИ.ВидФинансовогоИнструмента;
		
	Иначе
		
		Форма.ДисконтнаяЦБ = Ложь;	
		Форма.ЭтоБиржевойРынок = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИмяДокумента(ВидФинансовогоИнструмента) Экспорт
	
	Если ЭтоВексель(ВидФинансовогоИнструмента) Тогда
		Возврат "ПараметрыЦеннойБумагиВексель";
	Иначе 
		Возврат "ВерсияГрафикаЦеннойБумаги";
	КонецЕсли;
	
КонецФункции

Функция ЭтоОблигация(ВидФинансовогоИнструмента) Экспорт
	Возврат ВидФинансовогоИнструмента = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхИнструментов.Облигация");
КонецФункции

Функция ЭтоВексель(ВидФинансовогоИнструмента) Экспорт
	Возврат ВидФинансовогоИнструмента = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхИнструментов.Вексель");
КонецФункции

