Процедура ЗаполнитьРеквизитыОбъектаПоБанкуРасчетов(Объект, БанковскийСчет)Экспорт
	
	Если БанковскийСчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить() ;
	
	Если ЗначениеЗаполнено(БанковскийСчет) 
		И ЗначениеЗаполнено(БанковскийСчет.БанкДляРасчетов) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Банки.Наименование
			|	 КАК НаименованиеБанкаПосредникаВал,
			|	ВЫБОР
			|		КОГДА Банки.АдресМеждународный = """"
			|			ТОГДА Банки.Адрес
			|		ИНАЧЕ Банки.АдресМеждународный
			|	КОНЕЦ КАК АдресБанкаПосредникаВал,
			|	NULL КАК НаименованиеБанкаПлательщикаВал,
			|	NULL КАК АдресБанкаПлательщикаВал,
			|	NULL КАК ГородСтранаБанкаПлательщикаВал
			|ПОМЕСТИТЬ ВТ_Объединение
			|ИЗ
			|	Справочник.КлассификаторБанков КАК Банки
			|ГДЕ
			|	Банки.Ссылка = &БанкДляРасчетов
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	NULL,
			|	NULL,
			|	NULL,
			|	Банки.Наименование,
			|	ВЫБОР
			|		КОГДА Банки.АдресМеждународный = """"
			|			ТОГДА Банки.Адрес
			|		ИНАЧЕ Банки.АдресМеждународный
			|	КОНЕЦ
			|ИЗ
			|	Справочник.КлассификаторБанков КАК Банки
			|ГДЕ
			|	Банки.Ссылка = &Банк
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(ВТ_Объединение.НаименованиеБанкаПосредникаВал) КАК НаименованиеБанкаПосредникаВал,
			|	МАКСИМУМ(ВТ_Объединение.АдресБанкаПосредникаВал) КАК АдресБанкаПосредникаВал,
			|	МАКСИМУМ(ВТ_Объединение.НаименованиеБанкаПлательщикаВал) КАК НаименованиеБанкаПлательщикаВал,
			|	МАКСИМУМ(ВТ_Объединение.АдресБанкаПлательщикаВал) КАК АдресБанкаПлательщикаВал,
			|	МАКСИМУМ(ВТ_Объединение.ГородСтранаБанкаПлательщикаВал) КАК ГородСтранаБанкаПлательщикаВал
			|ИЗ
			|	ВТ_Объединение КАК ВТ_Объединение";
		
		Запрос.УстановитьПараметр("Банк", БанковскийСчет.Банк);
		Запрос.УстановитьПараметр("БанкДляРасчетов", БанковскийСчет.БанкДляРасчетов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Объект, ВыборкаДетальныеЗаписи); 
		КонецЕсли;;
		
	КонецЕсли;

КонецПроцедуры

