	               |				ТОГДА ВТ_ДенежныеСредстваОстатки.СуммаКонечныйОстаток
	               |			ИНАЧЕ ВЫБОР
	               |					КОГДА ВТ_ДенежныеСредстваОстатки.Период <= ВТ_ДниВПериоде.ДатаГрафика
	               |						ТОГДА ВТ_ДенежныеСредстваОстатки.СуммаОборот
	               |					ИНАЧЕ 0
	               |				КОНЕЦ
	               |		КОНЕЦ) КАК Сумма
	               |ПОМЕСТИТЬ ВТ_ОстаткиДенежныхСредствПоДням
	               |ИЗ
	               |	ВТ_ДниВПериоде КАК ВТ_ДниВПериоде
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДенежныеСредстваОстатки КАК ВТ_ДенежныеСредстваОстатки
	               |		ПО ВТ_ДниВПериоде.ДатаГрафика >= ВТ_ДенежныеСредстваОстатки.Период
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса ССЫЛКА Справочник.БанковскиеСчетаОрганизаций
	               |				ТОГДА (ВЫРАЗИТЬ(ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса КАК Справочник.БанковскиеСчетаОрганизаций)) <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
	               |			КОГДА ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса ССЫЛКА Справочник.Кассы
	               |				ТОГДА (ВЫРАЗИТЬ(ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса КАК Справочник.Кассы)) <> ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
	               |			ИНАЧЕ ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса <> НЕОПРЕДЕЛЕНО
	               |		КОНЕЦ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДниВПериоде.ДатаГрафика,
	               |	ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_ДниВПериоде.ДатаГрафика,
	               |	ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса,
	               |	СУММА(0)
	               |ИЗ
	               |	ВТ_ДниВПериоде КАК ВТ_ДниВПериоде
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДенежныеСредстваОстатки КАК ВТ_ДенежныеСредстваОстатки
	               |		ПО (ИСТИНА)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДниВПериоде.ДатаГрафика,
	               |	ВТ_ДенежныеСредстваОстатки.БанковскийСчетКасса
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОстаткиДенежныхСредствПоДням.ДатаГрафика КАК ДатаГрафика,
	               |	ВТ_ОстаткиДенежныхСредствПоДням.БанковскийСчетКасса КАК БанковскийСчетКасса,
	               |	СУММА(ВТ_ОстаткиДенежныхСредствПоДням.Сумма) КАК Сумма
	               |ПОМЕСТИТЬ ВТ_ОстаткиДенежныхСредствПоДнямИтоговая
	               |ИЗ
	               |	ВТ_ОстаткиДенежныхСредствПоДням КАК ВТ_ОстаткиДенежныхСредствПоДням
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ОстаткиДенежныхСредствПоДням.ДатаГрафика,
	               |	ВТ_ОстаткиДенежныхСредствПоДням.БанковскийСчетКасса
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОстаткиДенежныхСредствПоДнямИтоговая.БанковскийСчетКасса КАК БанковскийСчетКасса,
	               |	СУММА(ВТ_ОстаткиДенежныхСредствПоДнямИтоговая.Сумма) / КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ОстаткиДенежныхСредствПоДнямИтоговая.ДатаГрафика) КАК СреднедневнойОстаток
	               |ПОМЕСТИТЬ ВТ_СреднедневнойОстаток
	               |ИЗ
	               |	ВТ_ОстаткиДенежныхСредствПоДнямИтоговая КАК ВТ_ОстаткиДенежныхСредствПоДнямИтоговая
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ОстаткиДенежныхСредствПоДнямИтоговая.БанковскийСчетКасса
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ГлубинаОвердрафта.БанковскийСчет КАК БанковскийСчет,
	               |	ВТ_ГлубинаОвердрафта.ГлубинаОвердрафта КАК ГлубинаОвердрафта,
	               |	0 КАК СреднедневнойОстаток
	               |ПОМЕСТИТЬ ВТ_ПодготовленныеДанные
	               |ИЗ
	               |	ВТ_РасчетыСКонтрагентамиПоДоговорамОДМНО КАК ВТ_ГлубинаОвердрафта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_СреднедневнойОстаток.БанковскийСчетКасса,
	               |	0,
	               |	ВТ_СреднедневнойОстаток.СреднедневнойОстаток
	               |ИЗ
	               |	ВТ_СреднедневнойОстаток КАК ВТ_СреднедневнойОстаток";
	
	
	Возврат ТекстЗапроса;

КонецФункции

Процедура ТекстЗапросаДенежныеСредства(Запрос, ТекстыЗапроса) Экспорт
	
	ИмяРегистра = "ДенежныеСредства";
	
	Документы.ОтражениеФактическихДанныхБюджетирования.УстановитьПараметрыЗапросаКоэффициентыВалют(Запрос);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	&Организация КАК Организация,
	|	&ВидДенежныхСредств КАК ВидДенежныхСредств,
	|	ВЫБОР
	|		КОГДА &ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ТаблицаДвиженияДенежныхСредств.Сумма КАК Сумма
	|ИЗ
	|	ТаблицаДвиженияДенежныхСредств КАК ТаблицаДвиженияДенежныхСредств
	|ГДЕ
	|	НЕ &БанковскийСчетКасса В (Неопределено, ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка), ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка))";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

//Добавляет в структуру заполнения новые значения
Процедура ДозаполнитьЗначенияЗаполненияДокумента(ЗначенияЗаполнения) Экспорт
	
	Если ТипЗнч(ЗначенияЗаполнения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
    Если ЗначенияЗаполнения.Свойство("ВидОперации") Тогда  
		ЗначенияЗаполнения.Вставить("ВидОперацииУХ", Справочники.ВидыОперацийУХ.ВидОперацииУХПоХозяйственнойОперации(ЗначенияЗаполнения.ВидОперации, Истина));	
	КонецЕсли;   

	Если ЗначенияЗаполнения.Свойство("ВидОперацииУХ") Тогда
    	СтатьяБюджета = ВидыОперацийУХВызовСервераПовтИсп.ОсновнаяСтатьяБюджетаПоВидуОперации(ЗначенияЗаполнения.ВидОперацииУХ); 
		
		Если ЗначенияЗаполнения.Свойство("СтатьяБюджета") Тогда
			Если Не ЗначениеЗаполнено(ЗначенияЗаполнения.СтатьяБюджета) Тогда 
				ЗначенияЗаполнения.Вставить("СтатьяБюджета", СтатьяБюджета);	
			КонецЕсли;
		Иначе 
			ЗначенияЗаполнения.Вставить("СтатьяБюджета", СтатьяБюджета);	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначенияЗаполнения.Свойство("ВалютаДокумента") Тогда  
		ЗначенияЗаполнения.Вставить("ВалютаВзаиморасчетов", ЗначенияЗаполнения.ВалютаДокумента);	
	КонецЕсли;
	Если ЗначенияЗаполнения.Свойство("Организация") Тогда  
		ЗначенияЗаполнения.Вставить("ЦФО", ЗначенияЗаполнения.Организация);	
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеВходящегоОстаткаПлатежногоКалендаря() Экспорт
	Возврат Нстр("ru = 'Входящий остаток'");
КонецФункции

Процедура ЗаполнитьЭлементСтруктурыЗадолженностиВТЧ(РасшифровкаПлатежа, Ссылка) Экспорт
	
	Для каждого Строка ИЗ РасшифровкаПлатежа Цикл
		
		Если Не ЗначениеЗаполнено(Строка.ЭлементСтруктурыЗадолженности) Тогда
		
			МассивЭлементов = ЗаявкиНаОперацииВызовСервера.ЭлементыСтруктурыЗадолженностиПоДоговору(Строка.ДоговорКонтрагента, Ссылка);
			Если МассивЭлементов.Количество() = 1 Тогда 
				Строка.ЭлементСтруктурыЗадолженности = МассивЭлементов[0];
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция МожноСоздатьВыплатыПоРасчетномуДокументу(РасчетныйДокумент) Экспорт
	
	МожноСоздатьВедомости = Истина;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", РасчетныйДокумент);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СписаниеСРасчетногоСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
	|ГДЕ
	|	СписаниеСРасчетногоСчета.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеДивидендов)
	|	И СписаниеСРасчетногоСчета.Проведен
	|	И (СписаниеСРасчетногоСчета.НачислениеДивидендов = &Ссылка
	|			ИЛИ СписаниеСРасчетногоСчета.ДокументОснование = &Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РасходныйКассовыйОрдер.Ссылка
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВыплатаДивидендов)
	|	И РасходныйКассовыйОрдер.Проведен
	|	И (РасходныйКассовыйОрдер.НачислениеДивидендов = &Ссылка
	|			ИЛИ РасходныйКассовыйОрдер.ДокументОснование = &Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручение.Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|ГДЕ
	|	ПлатежноеПоручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеДивидендов)
	|	И ПлатежноеПоручение.Проведен
	|	И (ПлатежноеПоручение.НачислениеДивидендов = &Ссылка
	|			ИЛИ ПлатежноеПоручение.ДокументОснование = &Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
	|ГДЕ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Проведен
	|	И ЗаявкаНаРасходованиеДенежныхСредств.НачислениеДивидендов = &Ссылка
	|	И ЗаявкаНаРасходованиеДенежныхСредств.ВидОперацииУХ = ЗНАЧЕНИЕ(Справочник.ВидыОперацийУХ.ПеречислениеДивидендов)";
	
	МожноСоздатьВедомости = Запрос.Выполнить().Пустой();
	
	Возврат МожноСоздатьВедомости;
	
КонецФункции

Процедура ЗаменитьСтатусОплатыНаСостояниеОбъекта(ДокументСсылка,СтатусОплаты) Экспорт

	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		СтатусОплаты = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(ДокументСсылка)
	КонецЕсли;	

КонецПроцедуры

Процедура ЗаполнитьПоДокументуПланирования(Документ, ДанныеЗаполнения)Экспорт

	Если ДанныеЗаполнения.Свойство("ДокументПланирования",) И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументПланирования) Тогда
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Ссылка);
		
		ЕстьРасшифровкаПлатежа = МенеджерОбъекта.ЕстьРасшифровкаПлатежа(Документ.ВидОперации);

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОжидаемоеПоступлениеДенежныхСредств.ЦФО КАК ЦФО,
			|	ОжидаемоеПоступлениеДенежныхСредств.Проект КАК Проект,
			|	ОжидаемоеПоступлениеДенежныхСредств.ДвиженияОперации.(
			|		СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|		Аналитика1 КАК АналитикаБДДС1,
			|		Аналитика2 КАК АналитикаБДДС2,
			|		Аналитика3 КАК АналитикаБДДС3,
			|		Аналитика4 КАК АналитикаБДДС4,
			|		Аналитика5 КАК АналитикаБДДС5,
			|		Аналитика6 КАК АналитикаБДДС6,
			|		Сумма КАК СуммаПлатежа,
			|		Сумма КАК СуммаВзаиморасчетов,
			|		СтавкаНДС КАК СтавкаНДС,
			|		СуммаНДС КАК СуммаНДС,
			|		ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности
			|	) КАК ДвиженияОперации
			|ИЗ
			|	Документ.ОжидаемоеПоступлениеДенежныхСредств КАК ОжидаемоеПоступлениеДенежныхСредств
			|ГДЕ
			|	ОжидаемоеПоступлениеДенежныхСредств.Ссылка = &ДокументПланирования";
		
		Запрос.УстановитьПараметр("ДокументПланирования", ДанныеЗаполнения.ДокументПланирования);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		РеквизитыДанныхЗаполнения = "ДокументПланирования,ИдентификаторПозиции";
		
		Если ЕстьРасшифровкаПлатежа Тогда 

			РасшифровкаПлатежа = Документ.РасшифровкаПлатежа;
			
			Если РасшифровкаПлатежа.Количество() = 1 Тогда
				
				СтрокаРасшифровки = РасшифровкаПлатежа.Выгрузить()[0];
				ИсходныеДанныеСтрокиРасшифровки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаРасшифровки);

			КонецЕсли;
			
			РасшифровкаПлатежа.Очистить();
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Если ЕстьРасшифровкаПлатежа Тогда
				
				ДвиженияОперации = ВыборкаДетальныеЗаписи.ДвиженияОперации.Выбрать();
			
				Пока ДвиженияОперации.Следующий() Цикл
					
					НовСтрРасшифровка =	РасшифровкаПлатежа.Добавить();
					
					Если ИсходныеДанныеСтрокиРасшифровки <> Неопределено Тогда
					
						ЗаполнитьЗначенияСвойств(НовСтрРасшифровка, ИсходныеДанныеСтрокиРасшифровки);
						
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(НовСтрРасшифровка, ВыборкаДетальныеЗаписи);
					ЗаполнитьЗначенияСвойств(НовСтрРасшифровка, ДвиженияОперации);
					ЗаполнитьЗначенияСвойств(НовСтрРасшифровка, ДанныеЗаполнения, РеквизитыДанныхЗаполнения);
				КонецЦикла;

				
			Иначе
				
				ЗаполнитьЗначенияСвойств(Документ, ВыборкаДетальныеЗаписи);
				ЗаполнитьЗначенияСвойств(Документ, ДанныеЗаполнения, РеквизитыДанныхЗаполнения);

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СвойстваСтрокРасшифровкиПлатежаСервер(СвойстваПлатежа, Знач ПараметрыПлатежа, Знач ПолучатьДоговор) Экспорт
	
	Если ПараметрыПлатежа <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ПараметрыПлатежа.ДоговорКонтрагента) Тогда
			СтатьяДвиженияДенежныхСредств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПлатежа.ДоговорКонтрагента, "СтатьяДвиженияДенежныхСредств");
			Если ЗначениеЗаполнено(СтатьяДвиженияДенежныхСредств) Тогда 
				
				СвойстваПлатежа.СтатьяДвиженияДенежныхСредств = СтатьяДвиженияДенежныхСредств;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
