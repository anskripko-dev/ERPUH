Процедура ДополнитьМатрицуВесовЛиквидности(МатрицаВесовЛиквидностиВход) Экспорт
	
	ГоризонтыПланированияЛиквидности = Новый Массив;
	ГоризонтыПланированияЛиквидности.Добавить(Перечисления.ГоризонтыПланированияЛиквидности.ОперативноеПланирование);	
	ГоризонтыПланированияЛиквидности.Добавить(Перечисления.ГоризонтыПланированияЛиквидности.ПерспективноеПланирование);	
	ГоризонтыПланированияЛиквидности.Добавить(Перечисления.ГоризонтыПланированияЛиквидности.ТактическоеПланирование);	
	
	ВидыДвиженийПриходРасход = Новый Массив;
	ВидыДвиженийПриходРасход.Добавить(Перечисления.ВидыДвиженийПриходРасход.Расход);	
	ВидыДвиженийПриходРасход.Добавить(Перечисления.ВидыДвиженийПриходРасход.Приход);	
	
	Для Каждого ВидДвиженияПриходРасход Из ВидыДвиженийПриходРасход Цикл  
		
		Для Каждого ГоризонтПланирования Из ГоризонтыПланированияЛиквидности Цикл 
			
			НовСтр = МатрицаВесовЛиквидностиВход.Добавить();
			НовСтр.ПриходРасход = ВидДвиженияПриходРасход;
			НовСтр.ГоризонтПланированияЛиквидности = ГоризонтПланирования;
			НовСтр.Вес = 1;     
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НазначениеПлатежаСотрудникам(Объект) Экспорт
	
	Перем СписокФизЛиц;
	Перем НомерРеестра, ДатаРеестра;
	Перем НомерДоговора, ДатаДоговора;
	
	
	ТекстНазначенияПлатежа = "";
	ТекстПолучатель = "";
	
	ЕстьПереключательСписокФизЛиц = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект,"СписокФизЛиц");  
	Если ЕстьПереключательСписокФизЛиц Тогда   
		СписокФизЛиц = Объект.СписокФизЛиц;	
	КонецЕсли;
	СписокСотрудников = ?(ЕстьПереключательСписокФизЛиц, СписокФизЛиц, Ложь);
	НомерРеестра = Объект.НомерВходящегоДокумента;
	ДатаРеестра = Объект.ДатаВходящегоДокумента;
	НомерДоговора = Объект.НомерДоговораСБанком;
	ДатаДоговора = Объект.ДатаДоговораСБанком;
	
	Если ЗначениеЗаполнено(Объект.ПодотчетноеЛицо)
		И НЕ СписокСотрудников Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ФИО = "";
		
		ДанныеФизЛица = Новый Структура("ФИО,Пол"); 
		ЗаполнитьЗначенияСвойств(ДанныеФизЛица, Объект);
		
		Если ФизическиеЛицаЗарплатаКадры.Просклонять(ДанныеФизлица.ФИО, 2, ФИО, ДанныеФизлица.Пол, Объект.ПодотчетноеЛицо) Тогда
			ТекстПолучатель = СтрШаблон(НСтр("ru = 'Для зачисления на счет %1';
											|en = 'For bank receipt %1'"), ФИО);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	Иначе
		
		Если Объект.ПеречислениеСотрудникуЧерезБанк Тогда
			
			ПустойНомер = НСтр("ru = '___';
								|en = '___'");
			ПустаяДата = НСтр("ru = '__.__.20__ г.';
								|en = '__/__/20__'");
			
			ТекстПолучатель = СтрШаблон(
								НСтр("ru = 'Для зачисления в соответствии с реестром № %1 от %2 на основании договора № %3 от %4';
									|en = 'To deposit in accordance with registry No. %1 dated %2 based on contract No. %3 dated %4'"),
								?(НомерРеестра <> Неопределено, НомерРеестра, ПустойНомер),
								?(ДатаРеестра <> Неопределено, 
									Формат(ДатаРеестра, НСтр("ru = 'Л=ru_RU; ДФ=''dd.MM.yyyy """"г.""""''';
															|en = 'L=en_US''; DF=MM/dd/yyyy'")),
									ПустаяДата),
								?(НомерДоговора <> Неопределено, НомерДоговора, ПустойНомер),
								?(ДатаДоговора <> Неопределено,
									Формат(ДатаДоговора, НСтр("ru = 'Л=ru_RU; ДФ=''dd.MM.yyyy """"г.""""''';
																|en = 'L=en_US''; DF=MM/dd/yyyy'")),
									ПустаяДата));
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если ТекстПолучатель = "" Тогда
		ТекстПолучатель = НСтр("ru = 'Оплата без указания назначения';
								|en = 'Payment without purpose specification'");
	КонецЕсли;
	
	ТекстНазначенияПлатежа = ТекстНазначенияПлатежа + ТекстПолучатель;
	
	РеквизитыВалюты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Валюта, "Код, Наименование");
	
	Если РеквизитыВалюты.Код = "643" Тогда
		ВалютаДляПечати = НСтр("ru = 'руб.';
								|en = 'rub.'");
	Иначе
		ВалютаДляПечати = СокрЛП(РеквизитыВалюты.Наименование);
	КонецЕсли;
	
	ТекстСумма = "Сумма " + Формат(Объект.СуммаДокумента, "ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ=") + ВалютаДляПечати;
	ТекстНазначенияПлатежа = ТекстНазначенияПлатежа + Символы.ПС + ТекстСумма;
	
	ТаблицаРасшифровкаПлатежа = Объект.РасшифровкаПлатежа.Выгрузить(, "СтавкаНДС, СуммаНДС");
	ТекстСуммаНДС = ДенежныеСредстваСервер.ТекстСуммаНДСПлатежа(Объект.Организация, Объект.Валюта, ТаблицаРасшифровкаПлатежа, Истина);
	
	ДлинаТекстаПолучателей = СтрДлина(ТекстНазначенияПлатежа);
	ДлинаТекстаНДС = СтрДлина(ТекстСуммаНДС);
	
	Если ДлинаТекстаПолучателей + ДлинаТекстаНДС > 210 Тогда
		
		ДлинаТекстаПолучателей = 207 - ДлинаТекстаНДС;
		ТекстНазначенияПлатежа = Лев(ТекстНазначенияПлатежа, ДлинаТекстаПолучателей);
		ТекстПоискаПоследнегоНазначения = ТекстНазначенияПлатежа;
		ПозицияПоследнейЗапятой = 0;
		ПозицияЗапятой = СтрНайти(ТекстПоискаПоследнегоНазначения, ",");
		
		Пока НЕ ПозицияЗапятой = 0 Цикл
			
			ПозицияПоследнейЗапятой = ПозицияПоследнейЗапятой + ПозицияЗапятой;
			ТекстПоискаПоследнегоНазначения = Сред(ТекстПоискаПоследнегоНазначения, ПозицияЗапятой + 1);
			ПозицияЗапятой = СтрНайти(ТекстПоискаПоследнегоНазначения, ",");
			
		КонецЦикла;
		
		ТекстНазначенияПлатежа = Лев(ТекстНазначенияПлатежа, ПозицияПоследнейЗапятой - 1) + "...";
		
	КонецЕсли;
	
	ТекстНазначенияПлатежа = СокрЛП(ТекстНазначенияПлатежа) + Символы.ПС + СокрЛП(ТекстСуммаНДС);
	
	Возврат ТекстНазначенияПлатежа;
	
КонецФункции

Функция ОпределитьПлатежСКонвертацией(Объект) Экспорт
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Объект.БанковскийСчет) 
		И ЗначениеЗаполнено(Объект.ВалютаОплаты) Тогда
		
		ВалютаСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.БанковскийСчет, "ВалютаДенежныхСредств");
		ВалютаПлатежа = Объект.ВалютаОплаты;
		Результат = ВалютаСчета <> ВалютаПлатежа;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


#КонецОбласти

