// Возвращает текст запроса для заполнения таблицы заявок обработки Генерация кассовых ордеров.
Функция ПолучитьТекстЗапросаТаблицаКассовыеОрдера() Экспорт
	РезультатФункции = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию,
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	РазмещениеЗаявок.БанковскийСчетКасса КАК Касса,
	|	РазмещениеЗаявок.ДатаИсполнения КАК Дата,
	|	ВЫБОР
	|		КОГДА РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|			ТОГДА РазмещениеЗаявок.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаПриход,
	|	ВЫБОР
	|		КОГДА РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.РАсход)
	|			ТОГДА РазмещениеЗаявок.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаРасход,
	|	РазмещениеЗаявок.Контрагент КАК Контрагент,
	|	РазмещениеЗаявок.Организация КАК Организация,
	|	ЕСТЬNULL(РазмещениеЗаявок.ДоговорКонтрагента, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК ДоговорКонтрагента,
	|	РазмещениеЗаявок.ВалютаОплаты КАК Валюта,
	|	ИСТИНА КАК СоздаватьКассовыеОрдера
	|ИЗ
	|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних КАК СостоянияИсполненияДокументовПланированияСрезПоследних
	|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = СостоянияИсполненияДокументовПланированияСрезПоследних.ДокументПланирования
	|			И РазмещениеЗаявок.ИдентификаторПозиции = СостоянияИсполненияДокументовПланированияСрезПоследних.ИдентификаторПозиции
	|			И (СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения = ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.НеОбработана))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних КАК РегистрСостоянийОбъектовСрезПоследних
	|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = РегистрСостоянийОбъектовСрезПоследних.Объект
	|			И (РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта = ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Утверждена))
	|ГДЕ
	|	РазмещениеЗаявок.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
	|	И РазмещениеЗаявок.ДатаИсполнения МЕЖДУ &ДатаНачало И &ДатаОкончание
	|	И РазмещениеЗаявок.Проведен";
	Возврат РезультатФункции;
КонецФункции		// ПолучитьТекстЗапросаТаблицаКассовыеОрдера()

// Формирует документы Приходных и Расходных кассовых ордеров и возвращает соответствие созданных 
// к исходным документам.
Функция СоздатьКассовыеОрдераПоВыгрузке(ДокументыКВыгрузкеВход) Экспорт
	РезультатФункции = Новый Соответствие;
	Для Каждого ТекДокумент Из ДокументыКВыгрузкеВход Цикл
		Попытка
			Если ТекДокумент.СуммаПриход > 0 Тогда
				СоздаваемыйДокумент = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
			Иначе
				СоздаваемыйДокумент = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();
			КонецЕсли;
			МассивОснование = Новый Массив;
			МассивОснование.Добавить(ТекДокумент.ЗаявкаНаОперацию);
			СтруктураЗаполнения = Новый Структура;
			СтруктураЗаполнения.Вставить("Касса",									 ТекДокумент.Касса);
			СтруктураЗаполнения.Вставить("БанковскийСчетКасса",						 ТекДокумент.Касса);
			СтруктураЗаполнения.Вставить("ДокументОснование",						 МассивОснование);
			СтруктураЗаполнения.Вставить("ИдентификаторПозиции",					 ТекДокумент.ИдентификаторПозиции);
			СтруктураЗаполнения.Вставить("НесколькоЗаявокНаРасходованиеСредств",	 Ложь);
			СтруктураЗаполнения.Вставить("Сумма",									 ТекДокумент.СуммаРасход);
			СоздаваемыйДокумент.Заполнить(СтруктураЗаполнения);
			СоздаваемыйДокумент.Дата = Мин(ТекДокумент.Дата, ТекущаяДатаСеанса());			// Если заявка просрочена - берём текущую дату.
			СоздаваемыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			
			РезультатФункции.Вставить(ТекДокумент, СоздаваемыйДокумент.Ссылка);
		Исключение
			ТекстСообщения = НСтр("ru = 'При создании документа на основании заявки %Заявка% произошли ошибки: %ОписаниеОшибки%. Документ пропущен'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Заявка%", Строка(ТекДокумент.ЗаявкаНаОперацию));
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецПопытки
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// СоздатьКассовыеОрдераПоВыгрузке()

// Формирует документы СписаниеБезналичныхСредств по массиву исходных документов ДокументыКВыгрузкеВход.
Функция СоздатьСписаниеБезналичныхСредствПоВыгрузке(ДокументыКВыгрузкеВход, ГенерацияПоРееструПлатежейВход) Экспорт
	
	РезультатФункции = Новый Массив;

	Для Каждого ТекДокумент Из ДокументыКВыгрузкеВход Цикл
		Попытка
			СоздаваемыйДокумент = Документы.СписаниеБезналичныхДенежныхСредств.СоздатьДокумент();
			Если ГенерацияПоРееструПлатежейВход Тогда
				СоздаваемыйДокумент.ДополнительныеСвойства.Вставить("ВызовИзРеестраПлатежей", Истина);
			КонецЕсли; 
			МассивОснование = Новый Массив;
			МассивОснование.Добавить(ТекДокумент.ЗаявкаНаОперацию);
			СтруктураЗаполнения = Новый Структура;
			СтруктураЗаполнения.Вставить("БанковскийСчетКасса",						 ТекДокумент.СчетОрганизации);
			СтруктураЗаполнения.Вставить("ДокументОснование",						 МассивОснование);
			СтруктураЗаполнения.Вставить("ИдентификаторПозиции",					 ТекДокумент.ИдентификаторПозиции);
			СтруктураЗаполнения.Вставить("НесколькоЗаявокНаРасходованиеСредств",	 Ложь);
			СтруктураЗаполнения.Вставить("Сумма",									 ТекДокумент.СуммаДокумента);
			СоздаваемыйДокумент.Заполнить(СтруктураЗаполнения);
			СоздаваемыйДокумент.Дата = ТекДокумент.Дата;  
			СоздаваемыйДокумент.ИдентификаторПозиции = ТекДокумент.ИдентификаторПозиции;  
			
			Если Не ЗначениеЗаполнено(СоздаваемыйДокумент.НазначениеПлатежа) Тогда
				ДенежныеСредстваСервер.ЗаполнитьТекстНазначенияПлатежа(СоздаваемыйДокумент);  
			КонецЕсли;
			
			Если ТипЗнч(ТекДокумент.ЗаявкаНаОперацию) = Тип("ДокументСсылка.ЗаявкаНаКомандировку") 
				И ТекДокумент.ВидОперации = Справочники.ВидыОперацийУХ.ПеречислениеПодотчетномуЛицу Тогда
				СоздаваемыйДокумент.ДатаАвансовогоОтчета = СоздаваемыйДокумент.Дата + 7 * 24 * 3600;
        	КонецЕсли;			
			
			СоздаваемыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			РезультатФункции.Добавить(СоздаваемыйДокумент.Ссылка);
		Исключение
			ТекстСообщения = НСтр("ru = 'При создании документа на основании заявки %Заявка% произошли ошибки: %ОписаниеОшибки%. Документ пропущен'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Заявка%", Строка(ТекДокумент.ЗаявкаНаОперацию));
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецПопытки
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции		// СоздатьСписаниеБезнаоичныхСредствПоВыгрузке()

Функция СоздатьСписаниеБезналичныхСредствПоВыгрузкеОбъединено(ДокументыКВыгрузкеВход, ГенерацияПоРееструПлатежейВход) Экспорт

	РезультатФункции = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаГенерацияПлатежныхПоручений();
	
	МассивИдентификаторовОбщий = Новый Массив;     	
	Для Каждого СтрокаДокумент Из ДокументыКВыгрузкеВход Цикл
		МассивИдентификаторовОбщий.Добавить(СтрокаДокумент.ИдентификаторПозиции);							
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("МассивИдентификаторовОбщий", МассивИдентификаторовОбщий);
	
	МассивРезультатов 		= Запрос.ВыполнитьПакет();
	ДанныеШапка 			= МассивРезультатов[0].Выгрузить();
	ДанныеРасшифровка 		= МассивРезультатов[1].Выгрузить();
	ДанныеСгруппированные 	= МассивРезультатов[2].Выбрать();
	ДокументПланирования	= Документы.ЗаявкаНаРасходованиеДенежныхСредств.ПустаяСсылка();
	
	Пока ДанныеСгруппированные.Следующий() Цикл
		
		// Создание документа платежное поручение 
		ДокументОбъект = Документы.СписаниеБезналичныхДенежныхСредств.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Дата",				ДанныеСгруппированные.Дата);
		СтруктураОтбора.Вставить("ВалютаДокумента",		ДанныеСгруппированные.ВалютаДокумента);
		СтруктураОтбора.Вставить("Организация",			ДанныеСгруппированные.Организация);
		СтруктураОтбора.Вставить("Контрагент",						ДанныеСгруппированные.Контрагент);
		СтруктураОтбора.Вставить("БанковскийСчет",					ДанныеСгруппированные.БанковскийСчет);
		СтруктураОтбора.Вставить("БанковскийСчетКонтрагента",		ДанныеСгруппированные.БанковскийСчетКонтрагента);
		СтруктураОтбора.Вставить("ВидОперацииУХ",					ДанныеСгруппированные.ВидОперацииУХ);  
		СтруктураОтбора.Вставить("Подразделение",					ДанныеСгруппированные.Подразделение); 
		Если ЗначениеЗаполнено(ДанныеСгруппированные.ПодотчетноеЛицо) Тогда
			СтруктураОтбора.Вставить("ПодотчетноеЛицо",	ДанныеСгруппированные.ПодотчетноеЛицо);		
		КонецЕсли;
		
		СтруктураОтбора.Вставить("ТипНалога", ДанныеСгруппированные.ТипНалога);
		СтруктураОтбора.Вставить("КодБК", ДанныеСгруппированные.КодБК);
		СтруктураОтбора.Вставить("КодОКАТО", ДанныеСгруппированные.КодОКАТО);
		СтруктураОтбора.Вставить("ПоказательДаты", ДанныеСгруппированные.ПоказательДаты);
		СтруктураОтбора.Вставить("ПоказательНомера", ДанныеСгруппированные.ПоказательНомера);
		СтруктураОтбора.Вставить("ПоказательОснования", ДанныеСгруппированные.ПоказательОснования);
		СтруктураОтбора.Вставить("ПоказательПериода", ДанныеСгруппированные.ПоказательПериода);
		СтруктураОтбора.Вставить("ПоказательТипа", ДанныеСгруппированные.ПоказательТипа);
		СтруктураОтбора.Вставить("СтатусСоставителя", ДанныеСгруппированные.СтатусСоставителя);
			
		ПоискШапка = ДанныеШапка.НайтиСтроки(СтруктураОтбора); 
		МассивИдентификаторов = Новый Массив; 
		
		// Заполняем данные расшифровки по всем входящим документам
		Для Каждого СтрокаШапки Из ПоискШапка Цикл
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаШапки); 
			ДокументОбъект.Валюта = СтрокаШапки.ВалютаДокумента;
			ДокументПланирования = СтрокаШапки.ДокументПланирования;			
			
			НеобходимПересчетВВалюту = Ложь;
			Если СтрокаШапки.ПлатежСКонвертацией Тогда     
				
				Если Не ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.КонвертацияВалюты Тогда		
					
					Если ЗначениеЗаполнено(ДокументОбъект.БанковскийСчет) Тогда			
						РеквизитыБанковскогоСчета = 
							Справочники.БанковскиеСчетаОрганизаций.ПолучитьРеквизитыБанковскогоСчетаОрганизации(ДокументОбъект.БанковскийСчет);
						
						НеобходимПересчетВВалюту = Не (ДокументОбъект.Валюта = РеквизитыБанковскогоСчета.Валюта);
						
						Если НеобходимПересчетВВалюту Тогда
							ДокументОбъект.Валюта = РеквизитыБанковскогоСчета.Валюта;
							ДокументОбъект.ПлатежСКонвертацией = Ложь;				
						КонецЕсли;			
						
					КонецЕсли;
					
				КонецЕсли;			
				
				ВалютаОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.БанковскийСчет, "ВалютаДенежныхСредств");
				ВалютаКонтрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.БанковскийСчетКонтрагента, "ВалютаДенежныхСредств");
				
				Если ВалютаОрганизация = ВалютаКонтрагент Тогда
					ДокументОбъект.ПлатежСКонвертацией = Ложь;
				КонецЕсли;	
				
			КонецЕсли;

			Если Не СтрокаШапки.ВалютаДокумента = ДокументОбъект.Валюта Тогда
				Коэффициенты = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентыПересчетаВалюты(
					СтрокаШапки.ВалютаДокумента, ДокументОбъект.Валюта, ДокументОбъект.Дата, ДокументОбъект.Организация);			
				
				СтрокаШапки.КурсПлатежа = Коэффициенты.КоэффициентПересчетаВВалютуВзаиморасчетов;
			КонецЕсли;
			
			Если ТипЗнч(СтрокаШапки.ДокументПланирования) = Тип("ДокументСсылка.ЗаявкаНаКомандировку") 
				И ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику Тогда
				ДокументОбъект.ПодотчетноеЛицо = СтрокаШапки.Контрагент; 
				ДокументОбъект.ДатаАвансовогоОтчета = ДокументОбъект.Дата + 7 * 24 * 3600;
        	КонецЕсли;
			
			ПоискРасшифровка = ДанныеРасшифровка.НайтиСтроки(Новый Структура("ИдентификаторПозиции", СтрокаШапки.ИдентификаторПозиции));
			Для Каждого СтрокаРасшифровки Из ПоискРасшифровка Цикл
				
				НоваяСтрока = ДокументОбъект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасшифровки);
				НоваяСтрока.СуммаВзаиморасчетов = СтрокаРасшифровки.Сумма;
				
				Если СтрокаШапки.КурсПлатежа = 0 ИЛИ СтрокаШапки.КратностьПлатежа = 0 Тогда
					НоваяСтрока.Сумма = НоваяСтрока.СуммаВзаиморасчетов;
					НоваяСтрока.КурсЧислительВзаиморасчетов 		= 1;
					НоваяСтрока.КурсЗнаменательВзаиморасчетов 		= 1;
				Иначе
					НоваяСтрока.Сумма = НоваяСтрока.СуммаВзаиморасчетов * СтрокаШапки.КурсПлатежа / СтрокаШапки.КратностьПлатежа;
					НоваяСтрока.КурсЧислительВзаиморасчетов 		= СтрокаШапки.КурсПлатежа;
					НоваяСтрока.КурсЗнаменательВзаиморасчетов 		= СтрокаШапки.КратностьПлатежа; 
					Если ЗначениеЗаполнено(НоваяСтрока.СтавкаНДС) Тогда
						ЗначениеСтавки = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(НоваяСтрока.СтавкаНДС, "Ставка");
						НоваяСтрока.СуммаНДС = Окр(УчетНДСКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, Истина, ЗначениеСтавки), 2);					
					КонецЕсли;
				КонецЕсли;
				
				Если ДокументОбъект.ОчередностьПлатежа > СтрокаРасшифровки.ОчередностьПлатежа Тогда
					ДокументОбъект.ОчередностьПлатежа = СтрокаРасшифровки.ОчередностьПлатежа;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента 	= ДокументОбъект.РасшифровкаПлатежа.Итог("Сумма");
		Если ДокументОбъект.РасшифровкаПлатежа.Количество() > 0 Тогда
			
			ПоследняяСтрока = ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1];
			РасхождениеСумм = ДокументОбъект.СуммаДокумента - ДокументОбъект.РасшифровкаПлатежа.Итог("Сумма");
			ПоследняяСтрока.Сумма = ПоследняяСтрока.Сумма + РасхождениеСумм;
			ДокументОбъект.СтатьяДвиженияДенежныхСредств = ДокументОбъект.РасшифровкаПлатежа[0].СтатьяДвиженияДенежныхСредств;
		
		КонецЕсли;	
		
		Если ДокументОбъект.СписокФизЛиц И ДокументОбъект.ПеречислениеСотрудникуЧерезБанк Тогда 
			Если ДокументОбъект.РасшифровкаПлатежа.Количество() > 1 Тогда                   
				Для каждого СтрокаРасшифровка Из ДокументОбъект.РасшифровкаПлатежа Цикл
					ЛицевыеСчетаСотрудников = СтрокаРасшифровка.ЗаявкаНаРасходованиеДенежныхСредств.ЛицевыеСчетаСотрудников.Выгрузить();
					ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ЛицевыеСчетаСотрудников, ДокументОбъект.ЛицевыеСчетаСотрудников);	
				КонецЦикла;
			ИначеЕсли ТипЗнч(ДокументОбъект.ДокументПланирования) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
				ЛицевыеСчетаСотрудников = ДокументОбъект.ДокументПланирования.ЛицевыеСчетаСотрудников.Выгрузить();
				ДокументОбъект.ЛицевыеСчетаСотрудников.Загрузить(ЛицевыеСчетаСотрудников);	
			КонецЕсли;
		КонецЕсли;		
		
		// Если у нас перевод со счета на счет - получим счет получателя из 2-й позиции.
		Если ВидыОперацийУХКлиентСерверПовтИсп.ЭтоПеремещениеВнутриОрганизации(ДанныеСгруппированные.ВидОперацииУХ) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	РазмещениеЗаявок.БанковскийСчетКасса КАК СчетКонтрагента,
			|	РазмещениеЗаявок.ЗаявкаНаОперацию.ВалютаКонвертации КАК ВалютаКонвертации,
			|	РазмещениеЗаявок.Сумма КАК СуммаЗачисления
			|ИЗ
			|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
			|ГДЕ
			|	РазмещениеЗаявок.ЗаявкаНаОперацию = &ЗаявкаНаОперацию
			|	И РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)";
			Запрос.УстановитьПараметр("ЗаявкаНаОперацию", ДокументПланирования);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка)
			КонецЕсли;
			
		КонецЕсли;

		Если ГенерацияПоРееструПлатежейВход Тогда
			ДокументОбъект.ДополнительныеСвойства.Вставить("ВызовИзРеестраПлатежей", Истина);
		КонецЕсли; 
		
		ДокументОбъект.ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
		ДокументОбъект.ОчередностьПлатежа = 5;
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь(); 
		ДенежныеСредстваСервер.ЗаполнитьТекстНазначенияПлатежа(ДокументОбъект);
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			РезультатФункции.Добавить(ДокументОбъект.Ссылка);
		Исключение
			ТекстСообщения = НСтр("ru = 'При создании документа на основании заявок произошли ошибки: %1. Документ пропущен'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецПопытки
	
	КонецЦикла; 
	
	Возврат РезультатФункции;
	
КонецФункции

#Область ЗаполнениеНаОснованииЗаявкиНаРасходованиеДС

// Процедура заполняет документ на основании заявок на расходование денежных средств.
//
// Параметры:
//	ДанныеЗаполнения - Структура - Данные заполнения
//	ТабличнаяЧасть - ТабличнаяЧасть - Табличная часть документа
//	ФормаОплаты - ПеречислениеСсылка.ФормыОплаты - Фактическая форма оплаты (зависит от вводимого документа оплаты).
//
Процедура ЗаполнитьДокументПоЗаявкамНаРасходованиеДенежныхСредств(ДанныеЗаполнения, ТабличнаяЧасть, ФормаОплаты) Экспорт
	
КонецПроцедуры


#КонецОбласти 

Функция ПредставлениеДатыПлатежногоКалендаря(Дата, ДатаНачалаПериода, ГоризонтОперативногоПланирования, ПериодичностьОперативногоПланирования, Знач ФорматДатыПоДням = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ФорматДатыПоДням) Тогда
		ФорматДатыПоДням = Нстр("ru = 'ДФ=''dd.MM.yy, ддд'''");
	КонецЕсли;
	
	Если Дата > ГоризонтОперативногоПланирования Тогда
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ДатаНачала = ОбщегоНазначенияУХ.ДатаНачалаПериода(Дата, ПериодичностьОперативногоПланирования);
		ДатаОкончания = КонецДня(ОбщегоНазначенияУХ.ДатаКонцаПериода(Дата, ПериодичностьОперативногоПланирования));
		ПредставлениеДаты = ПредставлениеПериода(ДатаНачала, ДатаОкончания, "Л=" + КодОсновногоЯзыка);
	ИначеЕсли Дата >= ДатаНачалаПериода Тогда
		ПредставлениеДаты = Формат(Дата, ФорматДатыПоДням);
	Иначе
		ПредставлениеДаты = Нстр("ru = 'Входящий остаток'");
	КонецЕсли;
		
	Возврат ПредставлениеДаты;
	
КонецФункции	

Процедура ПередЗаписьюСправочникаБанковскиеСчетаУХПередЗаписью(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() Тогда
		
		Если Не ЗначениеЗаполнено(Источник.ВидСчета) Тогда
			Источник.ВидСчета = "Расчетный";
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.ПроизводственныйКалендарь) Тогда
		Источник.ПроизводственныйКалендарь = Константы.ПроизводственныйКалендарьПоУмолчанию.Получить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюВладельцаОсновнойБанковскийСчетУХ(Источник, Отказ) Экспорт
	
	Источник.ДополнительныеСвойства.Вставить("ЭтоНовый", Источник.ЭтоНовый());
	Источник.ДополнительныеСвойства.Вставить("ИзменилсяОсновнойБанковскийСчет", Ложь);
	
	Если Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	СтарыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник.Ссылка, 
		"ОсновнойБанковскийСчет, ОсновнойБанковскийСчет.ВалютаДенежныхСредств");
	
	Если СтарыеРеквизиты.ОсновнойБанковскийСчет <> Источник.ОсновнойБанковскийСчет Тогда 
		
		Если ЗначениеЗаполнено(СтарыеРеквизиты.ОсновнойБанковскийСчет)
			И Не ЗначениеЗаполнено(Источник.ОсновнойБанковскийСчет) Тогда
			
			РегистрыСведений.БанковскиеСчетаПоУмолчанию.УстановитьБанковскийСчет(
				Источник.Ссылка, 
				СтарыеРеквизиты.ОсновнойБанковскийСчетВалютаДенежныхСредств,
				Перечисления.ФормыОплаты.Безналичная, 
				Неопределено);
		КонецЕсли;	
			
		Источник.ДополнительныеСвойства.Вставить("ИзменилсяОсновнойБанковскийСчет", Истина); 
		
	КонецЕсли;		  
		
КонецПроцедуры

Процедура ПриЗаписиВладельцаОсновнойБанковскийСчетУХ(Источник, Отказ) Экспорт
	
	ЭтоНовый = Источник.ДополнительныеСвойства.ЭтоНовый;
	ИзменилсяОсновнойБанковскийСчет = Источник.ДополнительныеСвойства.ИзменилсяОсновнойБанковскийСчет;
	
	Если (ЭтоНовый ИЛИ ИзменилсяОсновнойБанковскийСчет)
		И ЗначениеЗаполнено(Источник.ОсновнойБанковскийСчет) Тогда
		
		Если Источник.ДополнительныеСвойства.Свойство("ВалютаБанковскогоСчетаУХ") Тогда
			// запись из формы, счет может быть еще не записан в базу
			ВалютаДенежныхСредств = Источник.ДополнительныеСвойства.ВалютаБанковскогоСчетаУХ;
		Иначе	
			ВалютаДенежныхСредств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.ОсновнойБанковскийСчет, "ВалютаДенежныхСредств");
		КонецЕсли;	
			
		Если НЕ ЗначениеЗаполнено(ВалютаДенежныхСредств) Тогда
			Возврат;
		КонецЕсли;	
		
		РегистрыСведений.БанковскиеСчетаПоУмолчанию.УстановитьБанковскийСчет(
			Источник.Ссылка, 
			ВалютаДенежныхСредств,
			Перечисления.ФормыОплаты.Безналичная, 
			Источник.ОсновнойБанковскийСчет);
	КонецЕсли;
		
КонецПроцедуры

Функция СведенияОЗапросеПодъемаДанных() Экспорт
	
	СведенияОЗапросе = Новый Структура;
	
	ТекстЗапросаПредставлениеПлатежногоКалендаря 			= ТекстЗапросаПодъемДанныхПредставлениеПлатежногоКалендаря();
	ТекстЗапросаДополнительныеСведенияПлатежногоКалендаря 	= ТекстЗапросаПодъемДанныхДополнительныеСведенияПлатежногоКалендаря();
	
	ТекстыЗапроса = Новый Массив;                                       
	ТекстыЗапроса.Добавить(ТекстЗапросаПредставлениеПлатежногоКалендаря);
	ТекстыЗапроса.Добавить(ТекстЗапросаДополнительныеСведенияПлатежногоКалендаря);
	
	ТекстыЗапроса.Добавить("ВЫБРАТЬ
	                       |	ЗНАЧЕНИЕ(Справочник.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка) КАК ВерсияПлатежногоКалендаря,
	                       |	&Пользователь КАК Пользователь,
	                       |	ИСТИНА КАК Активна,
	                       |	ВТ_ВходныеДанные.Инструмент КАК Инструмент,
	                       |	ВТ_ВходныеДанные.БанковскийСчетКасса КАК БанковскийСчетКасса,
	                       |	ВТ_ВходныеДанные.Валюта КАК Валюта,
	                       |	ВТ_ВходныеДанные.Банк КАК Банк,
	                       |	ВТ_ВходныеДанные.Дата КАК Дата,
	                       |	СУММА(ВТ_ВходныеДанные.Сумма) КАК Сумма,
	                       |	ВТ_ВходныеДанные.Организация КАК Организация,
	                       |	ВТ_ВходныеДанные.Приоритет КАК Приоритет,
	                       |	ВТ_ВходныеДанные.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
	                       |	ВТ_ВходныеДанные.КрайняяДата КАК КрайняяДата,
	                       |	ВТ_ВходныеДанные.ИсточникДанных КАК ИсточникДанных,
	                       |	ВТ_ВходныеДанные.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	                       |	ВТ_ВходныеДанные.ФиксированныйБанковскийСчет КАК ФиксированныйБанковскийСчет,
	                       |	ВТ_ВходныеДанные.ПулЛиквидности КАК ПулЛиквидности,
	                       |	ВТ_ВходныеДанные.ВидДенежныхСредств КАК ВидДенежныхСредств,
	                       |	ВТ_ВходныеДанные.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	                       |ИЗ
	                       |	ВТ_ВходныеДанные КАК ВТ_ВходныеДанные
						   |ГДЕ
	                       |	ВЫБОР
	                       |			КОГДА &ЭтоБазоваяФункциональность
	                       |				ТОГДА ВТ_ВходныеДанные.Дата <= &ОкончаниеПериодаОтбора
	                       |			ИНАЧЕ ИСТИНА
	                       |		КОНЕЦ
	                       | 	                       
	                       |СГРУППИРОВАТЬ ПО
	                       |	ВТ_ВходныеДанные.Инструмент,
	                       |	ВТ_ВходныеДанные.БанковскийСчетКасса,
	                       |	ВТ_ВходныеДанные.Валюта,
	                       |	ВТ_ВходныеДанные.Банк,
	                       |	ВТ_ВходныеДанные.Дата,
	                       |	ВТ_ВходныеДанные.Организация,
	                       |	ВТ_ВходныеДанные.Приоритет,
	                       |	ВТ_ВходныеДанные.РазделПлатежногоКалендаря,
	                       |	ВТ_ВходныеДанные.КрайняяДата,
	                       |	ВТ_ВходныеДанные.ИсточникДанных,
	                       |	ВТ_ВходныеДанные.ИдентификаторЗаписи,
	                       |	ВТ_ВходныеДанные.ФиксированныйБанковскийСчет,
	                       |	ВТ_ВходныеДанные.ПулЛиквидности,
	                       |	ВТ_ВходныеДанные.ВидДенежныхСредств,
	                       |	ВТ_ВходныеДанные.СтатьяДвиженияДенежныхСредств");
					
	ТекстыЗапроса.Добавить("ВЫБРАТЬ
	                       |	&Пользователь КАК Пользователь,
	                       |	ЗНАЧЕНИЕ(Справочник.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка) КАК ВерсияПлатежногоКалендаря,
	                       |	ВТ_ПодготовленныеДанные.БанковскийСчет КАК БанковскийСчет,
	                       |	СУММА(ВЫБОР
	                       |			КОГДА ВТ_ПодготовленныеДанные.ГлубинаОвердрафта < 0
	                       |				ТОГДА -ВТ_ПодготовленныеДанные.ГлубинаОвердрафта
