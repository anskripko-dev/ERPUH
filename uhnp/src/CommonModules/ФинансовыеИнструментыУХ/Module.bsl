Процедура Добавить_ТекстЗапроса_СчетаДокумента(МассивТекстовЗапроса, НомераТаблиц, Параметры)
	
	МенеджерДокумента = Документы[Параметры.ИмяДокумента];
	Если Параметры.ИмяДокумента = "НачисленияПоФинансовымИнструментам" Тогда
		МассивТекстовЗапроса.Добавить(МенеджерДокумента.ТекстЗапроса_СчетаДокумента(НомераТаблиц, МассивТекстовЗапроса));
	Иначе
		МассивТекстовЗапроса.Добавить(МенеджерДокумента.ТекстЗапроса_СчетаДокумента(НомераТаблиц));
	КонецЕсли;

КонецПроцедуры

Функция ТекстЗапроса_втОстатки(НомераТаблиц)

	//если счет НКД и счет учета ФИ совпадают, тогда возможен остаток НКД на счете ФИ, его спишем отдельно, для этого отделим рыночную стоимость от НКД
	
	НомераТаблиц.Вставить("втОстатки", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Дата КАК Дата,
	|	т.ВидОперации КАК ВидОперации,
	|	т.ФинансовыйИнструмент КАК ФинансовыйИнструмент,
	|	т.Валюта КАК Валюта,
	|	т.Счет КАК Счет,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	т.СуммаОстаток КАК СуммаОстаток,
	|	т.ОстатокВВалюте КАК ОстатокВВалюте,
	|	т.ОстатокБУ КАК ОстатокБУ,
	|	т.ОстатокНУ КАК ОстатокНУ,
	|	т.ОстатокПР КАК ОстатокПР,
	|	т.ОстатокВР КАК ОстатокВР,
	|	ВЫБОР
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокВВалюте
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокВВалюте * т.КоличествоСписание / т.КоличествоОстаток КАК ЧИСЛО(18, 0))
	|	КОНЕЦ КАК СписаниеВВалюте,
	|	ВЫБОР
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокБУ
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокБУ * т.КоличествоСписание / т.КоличествоОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеБУ,
	|	ВЫБОР
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокНУ
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокНУ * т.КоличествоСписание / т.КоличествоОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеНУ,
	|	ВЫБОР
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокПР
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокПР * т.КоличествоСписание / т.КоличествоОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеПР,
	|	ВЫБОР
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокВР
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокВР * т.КоличествоСписание / т.КоличествоОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеВР,
	|	ВЫБОР
	|		КОГДА НЕ т.СтоимостьВключаетНКД
	|			ТОГДА 0
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокВВалюте
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокВВалюте * т.КоличествоСписание / т.КоличествоОстаток * (т.СуммаОстаток - т.РыночнаяСтоимостьПартий) / т.СуммаОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеНКД_ВВалюте,
	|	ВЫБОР
	|		КОГДА НЕ т.СтоимостьВключаетНКД
	|			ТОГДА 0
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокБУ
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокБУ * т.КоличествоСписание / т.КоличествоОстаток * (т.СуммаОстаток - т.РыночнаяСтоимостьПартий) / т.СуммаОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеНКД_БУ,
	|	ВЫБОР
	|		КОГДА НЕ т.СтоимостьВключаетНКД
	|			ТОГДА 0
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокНУ
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокНУ * т.КоличествоСписание / т.КоличествоОстаток * (т.СуммаОстаток - т.РыночнаяСтоимостьПартий) / т.СуммаОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеНКД_НУ,
	|	ВЫБОР
	|		КОГДА НЕ т.СтоимостьВключаетНКД
	|			ТОГДА 0
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокПР
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокПР * т.КоличествоСписание / т.КоличествоОстаток * (т.СуммаОстаток - т.РыночнаяСтоимостьПартий) / т.СуммаОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеНКД_ПР,
	|	ВЫБОР
	|		КОГДА НЕ т.СтоимостьВключаетНКД
	|			ТОГДА 0
	|		КОГДА т.СписаниеВсейСуммы
	|			ТОГДА т.ОстатокВР
	|		ИНАЧЕ ВЫРАЗИТЬ(т.ОстатокВР * т.КоличествоСписание / т.КоличествоОстаток * (т.СуммаОстаток - т.РыночнаяСтоимостьПартий) / т.СуммаОстаток КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СписаниеНКД_ВР,
	|	т.ЭтоСчетФИ КАК ЭтоСчетФИ,
	|	т.СтоимостьВключаетНКД КАК СтоимостьВключаетНКД,
	|	т.РыночнаяСтоимостьПартий КАК РыночнаяСтоимостьПартий,
	|	т.КоличествоОстаток КАК КоличествоОстаток,
	|	т.КоличествоСписание КАК КоличествоСписание,
	|	т.СписаниеВсейСуммы КАК СписаниеВсейСуммы
	|ПОМЕСТИТЬ втОстатки
	|ИЗ
	|	(ВЫБРАТЬ
	|		втСобытия.Дата КАК Дата,
	|		втСобытия.ВидОперации КАК ВидОперации,
	|		ХозрасчетныйОстатки.Субконто1 КАК ФинансовыйИнструмент,
	|		ХозрасчетныйОстатки.Валюта КАК Валюта,
	|		ХозрасчетныйОстатки.Счет КАК Счет,
	|		ЕСТЬNULL(ХозрасчетныйОстатки.Подразделение, НЕОПРЕДЕЛЕНО) КАК Подразделение,
	|		ЕСТЬNULL(ХозрасчетныйОстатки.НаправлениеДеятельности, НЕОПРЕДЕЛЕНО) КАК НаправлениеДеятельности,
	|		ХозрасчетныйОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|		ХозрасчетныйОстатки.ВалютнаяСуммаОстаток КАК ОстатокВВалюте,
	|		ХозрасчетныйОстатки.СуммаОстаток КАК ОстатокБУ,
	|		ХозрасчетныйОстатки.СуммаНУОстаток КАК ОстатокНУ,
	|		ХозрасчетныйОстатки.СуммаПРОстаток КАК ОстатокПР,
	|		ХозрасчетныйОстатки.СуммаВРОстаток КАК ОстатокВР,
	|		ВЫБОР
	|			КОГДА ХозрасчетныйОстатки.Счет.Валютный
	|				ТОГДА ХозрасчетныйОстатки.ВалютнаяСуммаОстаток
	|			ИНАЧЕ ХозрасчетныйОстатки.СуммаОстаток
	|		КОНЕЦ КАК СуммаОстаток,
	|		втСписаниеПартийДляДисконта.РыночнаяСтоимость КАК РыночнаяСтоимостьПартий,
	|		НЕ СовпадаютСчета_ФИ_НКД.СчетУчетаФИ ЕСТЬ NULL КАК ЭтоСчетФИ,
	|		ЕСТЬNULL(втСписаниеПартийДляДисконта.РыночнаяСтоимость, 0) <> 0
	|			И ЕстьNULL(СовпадаютСчета_ФИ_НКД.СчетНкдСовпадает, ЛОЖЬ)
	|			И ЕСТЬNULL(ВЫБОР
	|					КОГДА ХозрасчетныйОстатки.Счет.Валютный
	|						ТОГДА ХозрасчетныйОстатки.ВалютнаяСуммаОстаток
	|					ИНАЧЕ ХозрасчетныйОстатки.СуммаОстаток
	|				КОНЕЦ, 0) <> 0 КАК СтоимостьВключаетНКД,
	|		втСобытия.Количество КАК КоличествоСписание,
	|		ЕСТЬNULL(втСобытия.Количество, 0) >= ЕСТЬNULL(ХозрасчетныйОстатки.КоличествоОстаток, 0)
	|			ИЛИ ЕСТЬNULL(ХозрасчетныйОстатки.КоличествоОстаток, 0) = 0
	|			ИЛИ ЕСТЬNULL(втСобытия.Количество, 0) = 0 КАК СписаниеВсейСуммы
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.Остатки(
	|				&ПериодДоДокумента,
	|				Счет В
	|					(ВЫБРАТЬ
	|						т.Ссылка
	|					ИЗ
	|						ПланСчетов.Хозрасчетный.ВидыСубконто КАК т
	|					ГДЕ
	|						т.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги)),
	|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги),
	|				Организация = &Организация
	|					И Субконто1 В
	|						(ВЫБРАТЬ
	|							т.ФинансовыйИнструмент
	|						ИЗ
	|							втСобытия КАК т
	|						ГДЕ
	|							т.ЭтоПродажа)) КАК ХозрасчетныйОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|				СчетУчетаФИ.Счет КАК СчетУчетаФИ,
	|				СчетНКД.Счет КАК СчетНКД,
	|				СчетУчетаФИ.Счет = ЕСТЬNULL(СчетНКД.Счет, НЕОПРЕДЕЛЕНО) КАК СчетНкдСовпадает
	|			ИЗ
	|				втСчетаДокумента КАК СчетУчетаФИ
	|					ЛЕВОЕ СОЕДИНЕНИЕ втСчетаДокумента КАК СчетНКД
	|					ПО СчетУчетаФИ.Счет = СчетНКД.Счет
	|						И (СчетНКД.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетНКД))
	|			ГДЕ
	|				СчетУчетаФИ.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФИ)) КАК СовпадаютСчета_ФИ_НКД
	|			ПО ХозрасчетныйОстатки.Счет = СовпадаютСчета_ФИ_НКД.СчетУчетаФИ
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				СУММА(т.Стоимость) КАК Стоимость,
	|				СУММА(т.РыночнаяСтоимость) КАК РыночнаяСтоимость
	|			ИЗ
	|				втСписаниеПартий КАК т) КАК втСписаниеПартийДляДисконта
	|			ПО (ИСТИНА)
	|			ЛЕВОЕ СОЕДИНЕНИЕ втСобытия КАК втСобытия
	|			ПО ХозрасчетныйОстатки.Субконто1 = втСобытия.ФинансовыйИнструмент) КАК т";

КонецФункции

Функция ТекстЗапроса_ОшибкиПроводок(НомераТаблиц, СписокФИ = Ложь) Экспорт

	НомераТаблиц.Вставить("ОшибкиПроводок", НомераТаблиц.Количество());

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаПроводок.ФинансовыйИнструмент КАК ФинансовыйИнструмент,
	|	&Ссылка КАК Ссылка,
	|	втСчетДт.Счет КАК СчетДт,
	|	втСчетКт.Счет КАК СчетКт,
	|	ТаблицаПроводок.СчетДт КАК ВидСчетаДт,
	|	ТаблицаПроводок.СчетКт КАК ВидСчетаКт,
	|	ТаблицаПроводок.Комментарий КАК Комментарий
	|ИЗ
	|	втТаблицаПроводок КАК ТаблицаПроводок
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаФИ КАК втСчетДт
	|		ПО ТаблицаПроводок.СчетДт = втСчетДт.ВидСчетаФИ
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаФИ КАК втСчетКт
	|		ПО ТаблицаПроводок.СчетКт = втСчетКт.ВидСчетаФИ
	|ГДЕ
	|	(ЕСТЬNULL(втСчетДт.Счет, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|			ИЛИ ЕСТЬNULL(втСчетКт.Счет, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка))
	|	И ТаблицаПроводок.Сумма <> 0";
		
	Если СписокФИ Тогда //НачисленияПоФинансовымИнструментам
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФинансовыйИнструмент", "ТаблицаПроводок.ФИ");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
		
КонецФункции

