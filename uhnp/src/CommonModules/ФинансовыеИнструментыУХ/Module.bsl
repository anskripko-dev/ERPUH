#Область АктуализироватьГрафикиЦенныхБумаг

Процедура ОбновитьГрафик_ВерсияГрафикаЦеннойБумаги(Процессор)

	Если Не Процессор.Облигации Или Не Процессор.ГрафикЦБ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	т.ФинансовыйИнструмент КАК ФинансовыйИнструмент
	|ИЗ
	|	Документ.ВерсияГрафикаЦеннойБумаги КАК т
	|ГДЕ
	|	т.ТипПроцентнойСтавки = ЗНАЧЕНИЕ(Перечисление.ТипыСтавокДляРасчетаПериодическихОпераций.Плавающая)
	|	И т.ФинансовыйИнструмент.СрокПогашения >= &Дата
	|	И &ОтборВидКотировки");
	
	Запрос.УстановитьПараметр("Дата", 				Процессор.Дата);
	Запрос.УстановитьПараметр("ОтборВидКотировки",	Процессор.ОтборВидКотировки);
	
	Если ЗначениеЗаполнено(Процессор.ОтборВидКотировки) Тогда
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ОтборВидКотировки", 
			"т.ФинансовыйИнструмент.ПараметрыЦеннойБумаги.ИндикативнаяСтавка В (&ОтборВидКотировки)");
	КонецЕсли;
	
	КэшируемыеЗначения = Новый Структура;
	КэшируемыеЗначения.Вставить("ПараметрыГрафика", ФинансовыеИнструментыФормыКлиентСервер.ПолучитьПараметрыГрафикаЦБ());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ФИ = Выборка.ФинансовыйИнструмент;
		
		ЗаполнитьОсновнойДолгЦБ = Новый Структура(
				"ДатаВыпуска, ДатаПогашения, ОсновнойДолгПолучение, ОсновнойДолгВозврат",
				ФИ.ДатаВыпуска, 
				ФИ.СрокПогашения, 
				ФИ.Номинал, 
				?(ФИ.ДисконтнаяЦБ, ФИ.ЦенаВыпуска, ФИ.Номинал)
			);

		СтрукутураДействий = Новый Структура(
			"ЗаполнитьОсновнойДолгЦБ, ЗаполнитьПроценты, СвернутьГрафик, РассчитатьСальдо",
			ЗаполнитьОсновнойДолгЦБ);
			
		Если Не ФИ.ДисконтнаяЦБ Тогда
			СтрукутураДействий.Вставить("РассчитатьПроценты");
		КонецЕсли;
		
		КэшируемыеЗначения.ПараметрыГрафика.Вставить("Финансовыйинструмент", Выборка.ФинансовыйИнструмент);
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Объект.График.Загрузить(
			ФинансовыеИнструментыФормыВызовСервера
				.ПолучитьГрафик(СтрукутураДействий, Объект, КэшируемыеЗначения.ПараметрыГрафика));

		Объект.Записать();

		ТекстСообщения = НСтр("ru = 'Обновлен график ценной бумаги (в <%1>) по котировке'");
		СообщитьОЗаписи(СтрШаблон(ТекстСообщения, ФИ), ФИ);

	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьГрафик_ГрафикиДокументовЦБ(Процессор)

	Если Не Процессор.ГрафикДокумента Или Не Процессор.Облигации Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьТолькоВыбранные = Новый Структура(
		"РасчетыСКонтрагентамиГрафики, РасшифровкиГрафиковЦБ",
		Истина, Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК ВерсияФИ,
	|	т.ФинансовыйИнструмент КАК ФИ,
	|	Документы.Ссылка КАК ДокументФИ
	|ИЗ
	|	Документ.ВерсияГрафикаЦеннойБумаги КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЖурналДокументов.ОперацииСЦеннымиБумагами КАК Документы
	|		ПО т.ФинансовыйИнструмент = Документы.ФинансовыйИнструмент
	|ГДЕ
	|	т.ТипПроцентнойСтавки = ЗНАЧЕНИЕ(Перечисление.ТипыСтавокДляРасчетаПериодическихОпераций.Плавающая)
	|	И т.ФинансовыйИнструмент.СрокПогашения >= &Дата
	|	И Документы.Проведен
	|	И &ОтборВидКотировки
	|
	|УПОРЯДОЧИТЬ ПО
	|	т.Дата");
	
	Запрос.УстановитьПараметр("Дата", Процессор.Дата);
	Запрос.УстановитьПараметр("ОтборВидКотировки",	Процессор.ОтборВидКотировки);

	Если ЗначениеЗаполнено(Процессор.ОтборВидКотировки) Тогда
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ОтборВидКотировки", 
			"т.ФинансовыйИнструмент.ПараметрыЦеннойБумаги.ИндикативнаяСтавка В (&ОтборВидКотировки)");
	КонецЕсли;

	РежимПроведения = РежимПроведенияДокумента.Неоперативный;
	РежимЗаписи = РежимЗаписиДокумента.Проведение;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Отказ = Ложь;
		
		Объект = Выборка.ДокументФИ.ПолучитьОбъект();
		
		Объект.ОбменДанными.Загрузка = Истина;
		
		Объект.ДополнительныеСвойства.Вставить(
			"ПропуститьПроверкуРучныхКорректировок", Истина);

		Объект.ДополнительныеСвойства.Вставить(
			"ЗаписатьТолькоВыбранные", ЗаписатьТолькоВыбранные);
		
		ПроведениеСерверУХ.ПередЗаписью(
			Объект, Отказ, РежимЗаписи, РежимПроведения);
		
		ВстраиваниеУХФинансовыеИнструменты.ОбработкаПроведения(
			Объект, Отказ, РежимПроведения);

		ТекстСообщения = НСтр("ru = 'Обновлен график ценной бумаги (в <%1>) по котировке'");
		СообщитьОЗаписи(СтрШаблон(ТекстСообщения, Выборка.ДокументФИ), Выборка.ДокументФИ);

	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьГрафик_ГрафикиДокументовВексели(Процессор)

	Если Не Процессор.ГрафикДокумента Или Не Процессор.Вексели Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьТолькоВыбранные = Новый Структура(
		"РасчетыСКонтрагентамиГрафики, РасшифровкиГрафиковЦБ",
		Истина, Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК ВерсияФИ,
	|	т.ФинансовыйИнструмент КАК ФИ,
	|	Документы.Ссылка КАК ДокументФИ
	|ИЗ
	|	Документ.ВерсияГрафикаЦеннойБумаги КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЖурналДокументов.ОперацииСВекселями КАК Документы
	|		ПО т.ФинансовыйИнструмент = Документы.Вексель
	|ГДЕ
	|	т.ТипПроцентнойСтавки = ЗНАЧЕНИЕ(Перечисление.ТипыСтавокДляРасчетаПериодическихОпераций.Плавающая)
	|	И т.ФинансовыйИнструмент.СрокПогашения >= &Дата
	|	И Документы.Проведен
	|	И &ОтборВидКотировки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документы.Дата");
	
	Запрос.УстановитьПараметр("Дата", Процессор.Дата);
	Запрос.УстановитьПараметр("ОтборВидКотировки",	Процессор.ОтборВидКотировки);

	Если ЗначениеЗаполнено(Процессор.ОтборВидКотировки) Тогда
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ОтборВидКотировки", 
			"т.ФинансовыйИнструмент.ПараметрыЦеннойБумаги.ИндикативнаяСтавка В (&ОтборВидКотировки)");
	КонецЕсли;

	РежимПроведения = РежимПроведенияДокумента.Неоперативный;
	РежимЗаписи = РежимЗаписиДокумента.Проведение;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ТипЗнч(Выборка.ДокументФИ) = Тип("ДокументСсылка.ПоступлениеВекселя") Тогда
			
			Объект = Выборка.ДокументФИ.ПолучитьОбъект();
			
			Объект.ОбменДанными.Загрузка = Истина;
		
			ЦенныеБумагиУХ.ОбновитьГрафикНачисленийПоВекселю(Объект);
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			
		ИначеЕсли ТипЗнч(Выборка.ДокументФИ) = Тип("ДокументСсылка.АкцептПротестПереводногоВекселя") Тогда
			
			Объект = Выборка.ДокументФИ.ПолучитьОбъект();
			
			Объект.ОбменДанными.Загрузка = Истина;
		
			Документы.АкцептПротестПереводногоВекселя.ОбновитьРасходНаСервере(Объект);
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			
		КонецЕсли;
		
		Отказ = Ложь;
		Объект = Выборка.ДокументФИ.ПолучитьОбъект();
		
		Объект.ОбменДанными.Загрузка = Истина;
		
		Объект.ДополнительныеСвойства.Вставить(
			"ПропуститьПроверкуРучныхКорректировок", Истина);
		Объект.ДополнительныеСвойства.Вставить(
			"ЗаписатьТолькоВыбранные", ЗаписатьТолькоВыбранные);
		
		ПроведениеСерверУХ.ПередЗаписью(
			Объект, Отказ, РежимЗаписи, РежимПроведения);
		
		ВстраиваниеУХФинансовыеИнструменты.ОбработкаПроведения(
			Объект, Отказ, РежимПроведенияДокумента.Неоперативный);

		ТекстСообщения = НСтр("ru = 'Обновлен график ценной бумаги (в <%1>) по котировке'");
		СообщитьОЗаписи(СтрШаблон(ТекстСообщения, Выборка.ДокументФИ), Выборка.ДокументФИ);

	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОЗаписи(ТекстСообщения, Ссылка, СообщитьПользователю = Истина, ЗаписатьЖР = Истина)

	Если СообщитьПользователю = Истина Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка);
	КонецЕсли;

	Если ЗаписатьЖР = Истина Тогда
		
		ИмяСобытия = НСтр("ru = 'Обновление графиков ценных бумаг'", ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Информация,
			Ссылка.Метаданные(),
			Ссылка,
			ТекстСообщения);
			
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроведениеЦБ_Устарело

Процедура ПроверитьДатуЦБ(ДокументОбъект, Отказ, Выданный = Истина, Погашение = Истина, РежимЗаписи = Неопределено) Экспорт

	Если (РежимЗаписи <> Неопределено) И (РежимЗаписи <> РежимЗаписиДокумента.Проведение) Тогда
		Возврат;
	КонецЕсли;

	Если (Не Выданный) И (ДокументОбъект.Дата < НачалоДня(ДокументОбъект.ФинансовыйИнструмент.ДатаВыпуска)) Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Дата операции по полученной ценной бумаге не может быть раньше даты выпуска'"), Отказ);
	ИначеЕсли (Выданный) И (Не Погашение) И (ДокументОбъект.Дата > КонецДня(ДокументОбъект.ФинансовыйИнструмент.ДатаВыпуска)) Тогда 
		ТекстСообщения = НСтр("ru = 'Дата операции (%ДатаОперации%) по выданной ценной бумаге не может быть позже даты выпуска (%ДатаВыпуска%)'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДатаОперации%", Строка(ДокументОбъект.Дата));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДатаВыпуска%", Строка(КонецДня(ДокументОбъект.ФинансовыйИнструмент.ДатаВыпуска)));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
	КонецЕсли;
	
	Если Погашение Тогда
		
		Если Выданный И (ДокументОбъект.Дата < НачалоДня(ДокументОбъект.ФинансовыйИнструмент.СрокПогашения)) Тогда
			//ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Дата операции погашения по выданной ценной бумаге не может быть раньше срока погашения'"), Отказ);
		ИначеЕсли (Не Выданный) И (ДокументОбъект.Дата > КонецДня(ДокументОбъект.ФинансовыйИнструмент.СрокПогашения)) Тогда
			
			Если ДокументОбъект.ФинансовыйИнструмент.ВидФинансовогоИнструмента = Перечисления.ВидыФинансовыхИнструментов.Облигация Тогда
				ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Дата операции погашения по полученной облигации не может позже срока погашения'"), Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
