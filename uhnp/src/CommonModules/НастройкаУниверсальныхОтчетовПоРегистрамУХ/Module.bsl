Функция СформироватьСтрокуОтборов(ТабПравилаВычисленияПараметров) Экспорт
	
	СтрокаОтбор="";
	
	Для Каждого СтрОтбор ИЗ ТабПравилаВычисленияПараметров Цикл
		
		Если СтрОтбор.ИмяПараметра="Регистратор" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если (Не СтрОтбор.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется) Тогда
			
			Если СтрОтбор.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение Тогда
				
				СтрокаОтбор=СтрокаОтбор+", "+СтрОтбор.ПолеБД+" = "+СтрОтбор.УточнениеСпособаОпределения;
				
			ИначеЕсли СтрОтбор.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению Тогда
				
				СтрокаОтбор=СтрокаОтбор+", "+СтрОтбор.ПолеБД+" <> "+СтрОтбор.УточнениеСпособаОпределения;
				
			ИначеЕсли СтрОтбор.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.Больше Тогда
				
				СтрокаОтбор=СтрокаОтбор+", "+СтрОтбор.ПолеБД+" > "+СтрОтбор.УточнениеСпособаОпределения;
				
			ИначеЕсли СтрОтбор.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.БольшеИлиРавно Тогда
				
				СтрокаОтбор=СтрокаОтбор+", "+СтрОтбор.ПолеБД+" >= "+СтрОтбор.УточнениеСпособаОпределения;
				
			ИначеЕсли СтрОтбор.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.Меньше Тогда
				
				СтрокаОтбор=СтрокаОтбор+", "+СтрОтбор.ПолеБД+" < "+СтрОтбор.УточнениеСпособаОпределения;
				
			ИначеЕсли СтрОтбор.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.МеньшеИлиРавно Тогда
				
				СтрокаОтбор=СтрокаОтбор+", "+СтрОтбор.ПолеБД+" <= "+СтрОтбор.УточнениеСпособаОпределения;
				
			Иначе
				
				СтрокаОтбор=СтрокаОтбор+", "+СтрОтбор.ПолеБД+" "+СтрОтбор.СпособВычисленияПараметра+" "+ОбщегоНазначенияУХ.ПолучитьСтрокуИзСпискаЗначенийПоПредставлению(СтрОтбор.УточнениеСпособаОпределения);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
				
	Возврат Сред(СтрокаОтбор,2);				 
	 
КонецФункции // СформироватьСтрокуОтборов()

Процедура СформироватьТекстОтбораИтог(ПараметрыОтчета) Экспорт
	
	ТекстОтбораИтог=?(ЗначениеЗаполнено(ПараметрыОтчета.ТекстОтбораИсточник)," И "+ПараметрыОтчета.ТекстОтбораИсточник,"");
	
	ТаблицаЗамены=Новый ТаблицаЗначений;
	ТаблицаЗамены.Колонки.Добавить("ТекстЗамены");
	ТаблицаЗамены.Колонки.Добавить("НоваяСтрока");
	ТаблицаЗамены.Колонки.Добавить("ДлинаСтроки");
	
	Для Каждого СтрПараметр ИЗ ПараметрыОтчета.ИспользуемыеПараметры Цикл
		
		Если (НЕ ПустаяСтрока(СтрПараметр.КонструкцияОтбора)) И СтрНайти(ПараметрыОтчета.ТекстОтбораИсточник,СтрПараметр.ИмяПараметра)=0 Тогда
			
			ТекстОтбораИтог=ТекстОтбораИтог+" И "+СтрПараметр.КонструкцияОтбора;
			
		КонецЕсли; 
		
		НоваяСтрока=ТаблицаЗамены.Добавить();
		НоваяСтрока.ТекстЗамены="&"+СтрПараметр.ИмяПараметра;
		НоваяСтрока.НоваяСтрока=СтрПараметр.ПредставлениеПараметра;
		НоваяСтрока.ДлинаСтроки=СтрДлина(НоваяСтрока.ТекстЗамены);
		
		НоваяСтрока=ТаблицаЗамены.Добавить();
		НоваяСтрока.ТекстЗамены=СтрПараметр.ПолеБД;
		НоваяСтрока.НоваяСтрока=?(ПустаяСтрока(СтрПараметр.ПредставлениеПоля),СтрПараметр.ПолеБД,СтрПараметр.ПредставлениеПоля);
		НоваяСтрока.ДлинаСтроки=СтрДлина(НоваяСтрока.ТекстЗамены);
				
	КонецЦикла;
	
	ТекстОтбораИтог=Сред(ТекстОтбораИтог,СтрДлина("И")+2);
	
	СтрокаОтборовИтог=ТекстОтбораИтог; 
	
	ТаблицаЗамены.Сортировать("ДлинаСтроки Убыв");
	
	Для Каждого Строка ИЗ ТаблицаЗамены Цикл
		
		СтрокаОтборовИтог=СтрЗаменить(СтрокаОтборовИтог,Строка.ТекстЗамены,Строка.НоваяСтрока);
		
	КонецЦикла;
	
	Пока Истина Цикл 
		
		ПозицияВыразить=СтрНайти(СтрокаОтборовИтог,"ВЫРАЗИТЬ(");
		
		Если ПозицияВыразить=0 Тогда
			
			Прервать;
			
		КонецЕсли;
		
		УдалитьКонструкциюВыразить(СтрокаОтборовИтог,ПозицияВыразить);
		
	КонецЦикла;

	ПеревестиТекстСтрокиОтборов(СтрокаОтборовИтог);
	
	ПараметрыОтчета.Вставить("ТекстОтбораИтог",		ТекстОтбораИтог);
	ПараметрыОтчета.Вставить("СтрокаОтборовИтог",	СтрокаОтборовИтог);
				
КонецПроцедуры // СформироватьТекстОтбораИтог() 

Процедура УдалитьКонструкциюВыразить(СтрокаОтборовИтог,ПозицияВыразить)
	
	ТекстУдаление="";
	ТекстВставки="";
	
	ЕстьНачалоВставки=Ложь;
	ЕстьОписаниеПоля=Истина;
	
	Для Индекс=ПозицияВыразить ПО СтрДлина(СтрокаОтборовИтог) Цикл
		
		ТекСимвол=Сред(СтрокаОтборовИтог,Индекс,1);
		
		Если ТекСимвол=")" Тогда
			
			ТекстУдаление=ТекстУдаление+ТекСимвол;
			Прервать;
			
		ИначеЕсли ТекСимвол="(" Тогда
			
			ТекстУдаление=ТекстУдаление+ТекСимвол;
			ЕстьНачалоВставки=Истина;
			
		ИначеЕсли ТекСимвол=" " И (НЕ ЕстьОписаниеПоля) Тогда
			
			ТекстУдаление=ТекстУдаление+ТекСимвол;
			ЕстьНачалоВставки=Ложь;
			
		Иначе
			
			ТекстУдаление=ТекстУдаление+ТекСимвол;
			
			Если ЕстьНачалоВставки Тогда
				
				ТекстВставки=ТекстВставки+ТекСимвол;
				
			КонецЕсли;
			
			Если ТекСимвол="[" Тогда
				
				ЕстьОписаниеПоля=Истина;
				
			ИначеЕсли ТекСимвол="]" Тогда
				
				ЕстьОписаниеПоля=Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаОтборовИтог=СтрЗаменить(СтрокаОтборовИтог,ТекстУдаление,ТекстВставки);
		
КонецПроцедуры // УдалитьКонструкциюВыразить() 

Функция ПеревестиТекстСтрокиОтборов(СтрокаОтборовИтог)
	
	СтрокаОтборовИтог=СтрЗаменить(СтрокаОтборовИтог," И "," "+НСтр("ru = 'И'; en = 'AND';tr = 'VE'")+" ");
	СтрокаОтборовИтог=СтрЗаменить(СтрокаОтборовИтог," ИЛИ "," "+НСтр("ru = 'ИЛИ'; en = 'OR';tr = 'VEYA'")+" ");
	СтрокаОтборовИтог=СтрЗаменить(СтрокаОтборовИтог," НЕ "," "+НСтр("ru = 'НЕ'; en = 'NOT';tr = 'değil'")+" ");
	СтрокаОтборовИтог=СтрЗаменить(СтрокаОтборовИтог," В("," "+НСтр("ru = 'В'; en = 'IN';tr = 'İÇİNDE'")+"(");
	СтрокаОтборовИтог=СтрЗаменить(СтрокаОтборовИтог," В ИЕРАРХИИ("," "+НСтр("ru = 'В ИЕРАРХИИ'; en = 'IN HIERARHY';tr = 'HİYERARŞİ İÇİNDE'")+"(");
		
КонецФункции  // 

