// Хоменко Вадим 20.10.2021 Выполнение задач №000039297
Процедура тн_ПроверкаРеквизитовПечатиПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не Источник.Организация = Справочники.Организации.УправленческаяОрганизация
		И ЭтоКонтрагентГруппыТехнНиколь(Источник.Контрагент) Тогда
		
		ТолькоЗаписатьНеПроводить = ПроверитьЗаполнениеВкладкиПечать(Источник);
		
		Если ТолькоЗаписатьНеПроводить Тогда
			Текст = "Документ " + Источник.Ссылка 
				+ " только записан (не проведен), т.к. есть незаполненные поля на вкладке ""Реквизиты печати ТН""!";
				ОбщегоНазначения.СообщитьПользователю(Текст, Источник.Ссылка,,, Отказ);
				
			Если Источник.Проведен Тогда
			   	РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
			Иначе	
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли; 	
		КонецЕсли; 
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Хоменко Вадим 20.10.2021 Выполнение задач №000039297
//
// Возвращает Истину если Контрагент в структуре компании принадлежит
// к группе предопределенной ТехноНиколь
//
// Параметры:
//  КонтрагентСсылка - СправочникСсылка.Контрагенты - проверямый Контрагент.
//
// Возвращаемое значение:
//   Булево   
//
Функция ЭтоКонтрагентГруппыТехнНиколь(КонтрагентСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.тн_Принадлежность В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.тн_СтруктураКомпании.ТехноНиколь))
	|	И Контрагенты.Ссылка = &КонтрагентСсылка";
	
	Запрос.УстановитьПараметр("КонтрагентСсылка", КонтрагентСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();

КонецФункции

// Хоменко Вадим 20.10.2021 Выполнение задач №000039297
//
// Проверяет заполненность полей на вкладке "Печать" документов 
// КорректировкаПриобретения или ВозвратТоваровПоставщику
// Возвращает Истина в случае когда присутствует ошибка заполнения
//
// Параметры:
//  ПроверяемыйДокумент  - ДокументОбъект.КорректировкаПриобретения, 
//  	ДокументОбъект.ВозвратТоваровПоставщику - документ в котором проверяется заполнение вкладки "Печать",
Функция ПроверитьЗаполнениеВкладкиПечать(ПроверяемыйДокумент)
	
	ТипДокумента = ТипЗнч(ПроверяемыйДокумент);
	ЭтоКорректировкаПриобретения = (ТипДокумента = Тип("ДокументОбъект.КорректировкаПриобретения"));
	ЭтоВозваратТоваровПоставщику = (ТипДокумента = Тип("ДокументОбъект.ВозвратТоваровПоставщику"));
	
	Поля = Новый ТаблицаЗначений;
	Поля.Колонки.Добавить("Имя");
	Поля.Колонки.Добавить("Данные");
	
	Если ЭтоВозваратТоваровПоставщику
		ИЛИ ЭтоКорректировкаПриобретения Тогда
	
		Поле = Поля.Добавить();
		Поле.Имя = "Филиал";
		Поле.Данные = ПроверяемыйДокумент.тн_Филиал;
		
		Поле = Поля.Добавить();
		Поле.Имя = "Подразделение организации";
		Поле.Данные = ПроверяемыйДокумент.тн_ПодразделениеОрганизации;
		
		Поле = Поля.Добавить();
		Поле.Имя = "Номер претензии";
		Поле.Данные = ПроверяемыйДокумент.тн_НомерПретензии;
		
		Поле = Поля.Добавить();
		Поле.Имя = "Дата претензии";
		Поле.Данные = ПроверяемыйДокумент.тн_ДатаПретензии;
		
		Поле = Поля.Добавить();
		Поле.Имя = "Причина претензии";
		Поле.Данные = ПроверяемыйДокумент.тн_ПричинаПретензии;
		
		Поле = Поля.Добавить();
		Поле.Имя = "Заключение комиссии";
		Поле.Данные = ПроверяемыйДокумент.тн_ЗаключениеКомиссии;

		Поле = Поля.Добавить();
		Поле.Имя = "Расчетный счет";
		Поле.Данные = ПроверяемыйДокумент.тн_РасчетныйСчет;
		
	КонецЕсли;

	Если ЭтоКорректировкаПриобретения Тогда
		
		Поле = Поля.Добавить();
		Поле.Имя = "Вх. номер";
		Поле.Данные = ПроверяемыйДокумент.НомерВходящегоДокумента;
		
		Поле = Поля.Добавить();
		Поле.Имя = "Вх. дата";
		Поле.Данные = ПроверяемыйДокумент.ДатаВходящегоДокумента;
		
	КонецЕсли;
	
	ВсеПоляЗаполнены = Истина;
	
	Для каждого Поле Из Поля Цикл
		
		ПолеЗаполнено = ЗначениеЗаполнено(Поле.Данные);
		
		ВсеПоляЗаполнены = ВсеПоляЗаполнены И ПолеЗаполнено;
		
		Если НЕ ПолеЗаполнено Тогда
			
			Текст = СтрШаблон("Документ %1: на вкладке ""Реквизиты печати ТН"" не заполнено поле ""%2""", ПроверяемыйДокумент, Поле.Имя);
			ОбщегоНазначения.СообщитьПользователю(Текст, ПроверяемыйДокумент.Ссылка);
		
		КонецЕсли;	
	
	КонецЦикла;
	
	ЕстьОшибкаЗаполнения = НЕ ВсеПоляЗаполнены;
	
	Возврат ЕстьОшибкаЗаполнения; 

КонецФункции

#КонецОбласти
