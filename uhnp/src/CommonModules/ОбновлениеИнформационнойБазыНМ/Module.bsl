Процедура ПереносПрисоединенныхФайлов(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОрганизацииУдалитьПубликуемыеФайлыНалоговогоМониторинга.Файл КАК Файл
		|ИЗ
		|	Справочник.Организации.УдалитьПубликуемыеФайлыНалоговогоМониторинга КАК ОрганизацииУдалитьПубликуемыеФайлыНалоговогоМониторинга";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Объект = ВыборкаДетальныеЗаписи.Файл.ПолучитьОбъект();
		Объект.ОтображаетсяВНалоговомМониторинге = Истина;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	КонецЦикла;

КонецПроцедуры

Процедура ИзменениеРесурсаПериод(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеквизитыПоУмолчаниюНалоговогоМониторинга.Период КАК Период,
		|	РеквизитыПоУмолчаниюНалоговогоМониторинга.Пользователь КАК Пользователь,
		|	РеквизитыПоУмолчаниюНалоговогоМониторинга.УдалитьНалоговыйПериод КАК НалоговыйПериод
		|ИЗ
		|	РегистрСведений.РеквизитыПоУмолчаниюНалоговогоМониторинга КАК РеквизитыПоУмолчаниюНалоговогоМониторинга";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Менеджер = РегистрыСведений.РеквизитыПоУмолчаниюНалоговогоМониторинга.СоздатьМенеджерЗаписи();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Менеджер.Период = ВыборкаДетальныеЗаписи.Период;
		Менеджер.Пользователь = ВыборкаДетальныеЗаписи.Пользователь;
		Менеджер.Прочитать();
		Менеджер.НачалоПериода = Менеджер.УдалитьНалоговыйПериод.ДатаНачала;
		Менеджер.ОкончаниеПериода = Менеджер.УдалитьНалоговыйПериод.ДатаОкончания;
		Менеджер.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереносФайловМероприятийВПрисоединенные(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Мероприятие.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Мероприятие КАК Мероприятие";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Объект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		СоответствиеФайлам = РаботаСФайлами.СконвертироватьФайлыВПрисоединенные(ВыборкаДетальныеЗаписи.Ссылка);
		Для каждого Строка Из Объект.Стадии Цикл
			Строка.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			Вложения = Строка.УдалитьВложения.Получить();
			Если ТипЗнч(Вложения) = Тип("ТаблицаЗначений") Тогда
				Для каждого Строка2 Из Вложения Цикл
					НоваяСтрока = Объект.ИтоговыеДокументы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка2);
					НоваяСтрока.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
					Если ЗначениеЗаполнено(Строка2.ИДФайла) Тогда
						Файл = Справочники.Файлы.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка2.ИДФайла));
						НоваяСтрока.СсылкаНаФайл = СоответствиеФайлам.Получить(Файл);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновлениеВложенийСтадий(Параметры = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтадииМероприятийТипыИтоговыхДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтадииМероприятий.ТипыИтоговыхДокументов КАК СтадииМероприятийТипыИтоговыхДокументов
		|ГДЕ
		|	НЕ(СтадииМероприятийТипыИтоговыхДокументов.УдалитьТипИтоговогоДокумента = ЗНАЧЕНИЕ(Справочник.СправочникиБД.ПустаяСсылка)
		|				ИЛИ СтадииМероприятийТипыИтоговыхДокументов.УдалитьТипИтоговогоДокумента = ЗНАЧЕНИЕ(Справочник.ДокументыБД.ПустаяСсылка))
		|
		|СГРУППИРОВАТЬ ПО
		|	СтадииМероприятийТипыИтоговыхДокументов.Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Объект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Для каждого Стр Из Объект.ТипыИтоговыхДокументов Цикл
			Если НЕ ЗначениеЗаполнено(Стр.УдалитьТипИтоговогоДокумента) Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Стр.УдалитьТипИтоговогоДокумента) = Тип("СправочникСсылка.СправочникиБД") Тогда
				Стр.ТипИтоговогоДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Справочник." + Стр.УдалитьТипИтоговогоДокумента.Наименование, Ложь);
			ИначеЕсли ТипЗнч(Стр.УдалитьТипИтоговогоДокумента) = Тип("СправочникСсылка.ДокументыБД") Тогда
				Стр.ТипИтоговогоДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ." + Стр.УдалитьТипИтоговогоДокумента.Наименование, Ложь);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Стр.ТипИтоговогоДокумента) Тогда
				ЗаписьЖурналаРегистрации("Обновление.СтадииМероприятий", УровеньЖурналаРегистрации.Предупреждение, , ВыборкаДетальныеЗаписи.Ссылка, "В ограничениях типа вложения стадии мероприятия указан несуществующий объект метаданных " + Стр.УдалитьТипИтоговогоДокумента.Наименование);
			КонецЕсли;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьФункциональнуюОпциюВитрины(Параметры = Неопределено) Экспорт
	Константы.ВитринаНалоговогоМониторинга.Установить(Истина);
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыФункцииДляИспользованияВОбработчикахОбновления

////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции для использования в обработчиках обновления.

// Записывает изменения в переданном объекте.
// Для использования в обработчиках обновления.
//
// Параметры:
//   Данные                            - Произвольный - объект, набор записей или менеджер константы, который
//                                                      необходимо записать.
//   РегистрироватьНаУзлахПлановОбмена - Булево       - включает регистрацию на узлах планов обмена при записи объекта.
//   ВключитьБизнесЛогику              - Булево       - включает бизнес-логику при записи объекта.
//
Процедура ЗаписатьДанные(Знач Данные, Знач РегистрироватьНаУзлахПлановОбмена = Ложь, 
	Знач ВключитьБизнесЛогику = Ложь) Экспорт
	
	Данные.ОбменДанными.Загрузка = Не ВключитьБизнесЛогику;
	Если Не РегистрироватьНаУзлахПлановОбмена Тогда
		Данные.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		Данные.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	КонецЕсли;
	
	Данные.Записать();
	
КонецПроцедуры

// Записывает изменения в переданном объекте ссылочного типа.
// Для использования в обработчиках обновления.
//
// Параметры:
//   Объект                            - Произвольный - записываемый объект ссылочного типа. Например, СправочникОбъект.
//   РегистрироватьНаУзлахПлановОбмена - Булево       - включает регистрацию на узлах планов обмена при записи объекта.
//   ВключитьБизнесЛогику              - Булево       - включает бизнес-логику при записи объекта.
//
Процедура ЗаписатьОбъект(Знач Объект, Знач РегистрироватьНаУзлахПлановОбмена = Неопределено, 
	Знач ВключитьБизнесЛогику = Ложь) Экспорт
	
	Если РегистрироватьНаУзлахПлановОбмена = Неопределено И Объект.ЭтоНовый() Тогда
		РегистрироватьНаУзлахПлановОбмена = Истина;
	Иначе
		РегистрироватьНаУзлахПлановОбмена = Ложь;
	КонецЕсли;
	
	Объект.ОбменДанными.Загрузка = Не ВключитьБизнесЛогику;
	Если Не РегистрироватьНаУзлахПлановОбмена Тогда
		Объект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		Объект.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	КонецЕсли;
	
	Объект.Записать();
	
КонецПроцедуры

#КонецОбласти