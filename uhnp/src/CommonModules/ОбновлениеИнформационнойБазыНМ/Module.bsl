Процедура ЗаполнитьВидыЗапрашиваемойОтчетностиНалоговогоМониторинга2(Параметры = Неопределено) Экспорт
	Макет = Справочники.ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга.ПолучитьМакет("МакетЗаполнения");
	Инд = 2;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга КАК ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга";
	
	РезультатЗапроса = Запрос.Выполнить();
	ЭтоОбновление = НЕ РезультатЗапроса.Пустой();

	Пока ЭтоОбновление Цикл
		Код = Макет.Область(Инд, 1, Инд, 1).Текст;
		Инд = Инд + 1;
		Если ПустаяСтрока(Код) Тогда
			Прервать;
		КонецЕсли;
		Ссылка = Справочники.ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга.НайтиПоКоду(Код);
		Если Ссылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		НовОбъект = Ссылка.ПолучитьОбъект();
		НовОбъект.ПометкаУдаления = Истина;
		Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовОбъект);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Макет = Справочники.ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга.ПолучитьМакет("Классификатор");
	Инд = 2;
	Пока Истина Цикл
		Код = Макет.Область(Инд, 1, Инд, 1).Текст;
		Если ПустаяСтрока(Код) Тогда
			Прервать;
		КонецЕсли;
		Наименование = Макет.Область(Инд, 2, Инд, 2).Текст;
		Ссылка = Справочники.ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга.НайтиПоКоду(Код);
		Если Ссылка.Пустая() Тогда
			НовОбъект = Справочники.ВидыЗапрашиваемойОтчетностиНалоговогоМониторинга.СоздатьЭлемент();
		Иначе
			НовОбъект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		НовОбъект.Код = Код;
		НовОбъект.Наименование = Наименование;
		Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовОбъект);
		Исключение
		КонецПопытки;
		Инд = Инд + 1;
	КонецЦикла;
КонецПроцедуры

