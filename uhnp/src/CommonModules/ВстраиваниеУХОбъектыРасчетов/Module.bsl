 Процедура ФормаВыбора_ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	 
	Параметры = Форма.Параметры;
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Договор") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
				Форма.СписокОбъектовРасчетов,
				"Договор",
				Параметры.Отбор.Договор,
				ВидСравненияКомпоновкиДанных.Равно,
				,
				Истина);
	КонецЕсли;
	
КонецПроцедуры

