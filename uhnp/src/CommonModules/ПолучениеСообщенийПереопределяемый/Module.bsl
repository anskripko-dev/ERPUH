	////// Подсистема.ДемонстрацияРаботы
	//ПолучениеСообщенийСлужебный.ДобавитьОбработчикСообщения(Обработчики, "ТН_ИнтеграцияЕЗУП3.ПолучениеСообщенийОбменаЕУЗП3_RMQ", 2);
	//// КОНЕЦ Гурин Максим 07.02.2019 Выполнение задач №000031116
	////НАЧАЛО БИТ Качикина 01.10.2019 Задача№ 000031998 
	//ПолучениеСообщенийСлужебный.ДобавитьОбработчикСообщения(Обработчики, "ТН_Интеграция_ОбщегоНазначения.ПолучениеСообщенийОбменаОКС_RMQ", 2);
	////КОНЕЦ БИТ Качикина 01.10.2019 Задача№ 000031998
	//
	//// НАЧАЛО Хохлов Владимир 08.12.2019 ВЗ №000033366
	//ПолучениеСообщенийСлужебный.ДобавитьОбработчикСообщения(Обработчики, "ТН_ИнтеграцияСервисСогласования.ПолучениеСообщенийОбменаСервисСогласования", 2);
	//// КОНЕЦ Хохлов Владимир 08.12.2019 ВЗ №000033366
	ПолучениеСообщенийСлужебный.ДобавитьОбработчикСообщения(Обработчики, "тн_ИнтеграцияRMQ.ПолучениеСообщенийRMQ", 2);
	// КОНЕЦ Калинин А. 09.12.2019 Выполнение задач №000033580

	// НАЧАЛО Борисенко И.Н. 27.08.2020 Выполнение задач №000035594
	ПолучениеСообщенийСлужебный.ДобавитьОбработчикСообщения(Обработчики, "тн_Интеграция_ЕРП_УХ.ПолучениеСообщенийRMQ", 2);
	// КОНЕЦ Борисенко И.Н. 27.08.2020 Выполнение задач №000035594
	
КонецПроцедуры

// Возвращается версия протокола обработчика сообщения по умолчанию
//
//  Возвращаемое значение:
//   Число - версия протокола
//
Функция ВерсияПротоколаПоУмолчанию() Экспорт
	
	Возврат 1;
	
КонецФункции
