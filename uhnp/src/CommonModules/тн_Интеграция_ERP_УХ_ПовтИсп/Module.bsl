// Белоконенко Денис 15.07.2025 Выполнение задач №000053911
Функция ВернутьУзелОбменаПоКлючуМаршрутизации(КлючМаршрутизации) Экспорт
	
	Если КлючМаршрутизации = Справочники.тн_ПроизводственныеПодразделения.ОКС_Сбыт Тогда
		УзелОбмена = ВернутьУзелОбмена_ОКС();
	ИначеЕсли КлючМаршрутизации = Справочники.тн_ПроизводственныеПодразделения.ЗУП Тогда
		УзелОбмена = ВернутьУзелОбмена_ЗУП(); 
	ИначеЕсли КлючМаршрутизации = Справочники.тн_ПроизводственныеПодразделения.УПП_ЦБ Тогда
		УзелОбмена = ВернутьУзелОбмена_ЦБ();
	Иначе // Остальные на базе УПП Каркас
		УзелОбмена = ВернутьУзелОбмена_Каркас();
	КонецЕсли;
	
	Возврат УзелОбмена;
	
КонецФункции

