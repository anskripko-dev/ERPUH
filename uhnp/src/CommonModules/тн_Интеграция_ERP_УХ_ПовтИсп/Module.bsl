// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Функция ДобавитьСтрокуОписания(ТипОбъектаОписания, ИмяТипаЭлементаXDTO, ИмяОбъектаМетаданных, Описание, РодительскаяСтрока, Параметры, ДопСвойства = Неопределено)
	
	СтрокаОписания = РодительскаяСтрока.Строки.Добавить();
	
	//Обязательные (основные) свойства
	СтрокаОписания.ТипОбъектаОписания 	= ТипОбъектаОписания;
	СтрокаОписания.ИмяТипаЭлементаXDTO 	= ИмяТипаЭлементаXDTO;
	СтрокаОписания.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных;
	СтрокаОписания.Описание 			= Описание;
	
	//Доп. свойства
	Если ТипЗнч(ДопСвойства) = Тип("Строка") Тогда
		
		Если ДопСвойства = "ЭтоСсылка" Тогда
			СтрокаОписания.ЭтоСсылка = Истина;
		ИначеЕсли ДопСвойства = "ТребуетсяУточнение" Тогда
			СтрокаОписания.ТребуетсяУточнение = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДопСвойства) = Тип("Структура") Тогда
		
		Для каждого ДопСвойство Из ДопСвойства Цикл
			СтрокаОписания[ДопСвойство.Ключ] = ДопСвойство.Значение;
		КонецЦикла;
		
	КонецЕсли;
	
	//Свойства xdto
	Если СтрокаОписания.Родитель <> Неопределено Тогда
		СтрокаОписания.РодительскийXDTO 	= СтрокаОписания.Родитель.ЭлементXDTO;
	КонецЕсли;
	ЗаполнитьПараметрыXDTO(Параметры, СтрокаОписания);
	
	// НАЧАЛО Борисенко Игорь 29.04.2022 Выполнение задач №000041127
	// Для всех объектов типа catalog и document добавляем поле deletionMark
	НужноДобавить_deletionMark = ИмяТипаЭлементаXDTO = "guid" 
		И (
				СтрНайти(НРег(СтрокаОписания.Родитель.ИмяОбъектаМетаданных),"справочник.") > 0
			Или СтрНайти(НРег(СтрокаОписания.Родитель.ИмяОбъектаМетаданных),"документ.") > 0
			Или	СтрНайти(НРег(СтрокаОписания.Родитель.ИмяОбъектаМетаданных),"catalog") > 0
			Или СтрНайти(НРег(СтрокаОписания.Родитель.ИмяОбъектаМетаданных),"document") > 0
		);
	Если НужноДобавить_deletionMark Тогда
		СтрокаОписания_deletionMark = ДобавитьСтрокуОписания("Свойство", "deletionMark", "ПометкаУдаления", "Пометка удаления", РодительскаяСтрока, Параметры);
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 29.04.2022 Выполнение задач №000041127
	
	Возврат СтрокаОписания;
	
КонецФункции

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Процедура ЗаполнитьПараметрыXDTO(Параметры, СтрокаОписания)
	
	URLПространстваИмен = Параметры.ИмяПакетаXDTO;
	ИмяТипаКонтейнераXDTO = Параметры.ИмяТипаXDTO;
	ИмяТипаЭлементаXDTO = СтрокаОписания.ИмяТипаЭлементаXDTO;
	
	РодительскийXDTO = СтрокаОписания.РодительскийXDTO;
	Если ТипЗнч(РодительскийXDTO) = Тип("ТипОбъектаXDTO") Тогда //для свойств объекта
		ИмяТипаКонтейнераXDTO = РодительскийXDTO.Имя;
		
		Если РодительскийXDTO.Свойства.Количество() = 1 И РодительскийXDTO.Свойства[0].Имя = "string" Тогда // Это строка табличной части
			СтрокаТЧXDTO = РодительскийXDTO.Свойства[0].Тип;
			ЭлементXDTO = СтрокаТЧXDTO.Свойства.Получить(ИмяТипаЭлементаXDTO);
		Иначе
			ЭлементXDTO = РодительскийXDTO.Свойства.Получить(ИмяТипаЭлементаXDTO);
		КонецЕсли;
		
	Иначе //для объекта
	
		ПакетXDTO = ФабрикаXDTO.Пакеты.Получить(URLПространстваИмен);
		ТипКонтейнерXDTO = ПакетXDTO.Получить(ИмяТипаКонтейнераXDTO);

		Если ТипКонтейнерXDTO = Неопределено Тогда 
			тн_Интеграция_УПП.СообщитьИнформациюПользователю("В xdto-пакете: " + URLПространстваИмен + " не определен тип: " + ИмяТипаКонтейнераXDTO);
			Возврат;
			
		Иначе
			
			КонтейнерXDTO = ФабрикаXDTO.Создать(ТипКонтейнерXDTO);
			
			ЭлементXDTO = ТипКонтейнерXDTO.Свойства.Получить(ИмяТипаЭлементаXDTO);
			
		КонецЕсли;          	                	
		
	КонецЕсли;
	
	Если ЭлементXDTO = Неопределено Тогда 
		тн_Интеграция_УПП.СообщитьИнформациюПользователю("В xdto-пакете: " + URLПространстваИмен + " для контейнера: " + ИмяТипаКонтейнераXDTO + " не определен элемент: " + ИмяТипаЭлементаXDTO);
		Возврат;
	Иначе
		ЗаполнитьЗначенияСвойств(СтрокаОписания, ЭлементXDTO);
		СтрокаОписания.ЭлементXDTO = ЭлементXDTO.Тип;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

