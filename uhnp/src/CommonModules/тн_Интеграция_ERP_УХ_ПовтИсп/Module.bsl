Функция ВернутьПараметрыОбмена_Каркас() Экспорт
	
	//Параметры выполнения обмена
	Параметры = Новый Структура;
	
	Параметры.Вставить("УзелПланаОбмена", ВернутьУзелОбмена_Каркас());
	Параметры.Вставить("ИспользоватьБлокировкиТранзакции", Ложь);
	//НАЧАЛО Ведутенко С.А. 21.08.2025 Выполнение задач №000054799
	Параметры.Вставить("ВыгрузкаПланаОбмена", Ложь);
	//КОНЕЦ  Ведутенко С.А. 21.08.2025 Выполнение задач №000054799
	
	// - xdto-пакет
	Параметры.Вставить("ИмяПакетаXDTO"		, "tn_integrationERP");
	Параметры.Вставить("ИмяТипаXDTO"		, "listObject");
	Параметры.Вставить("ДеревоОписаний"		, СформироватьДеревоОписанийОбъектов(Параметры));
	
	// - транспорт (RabbitMQ)
	Параметры.Вставить("Профиль"			, Справочники.тн_ПрофилиПодключений.УПП_Каркас);
	Параметры.Вставить("ФорматСообщения"	, "JSON");
	Параметры.Вставить("ТочкаОбменаRabbitMQ", Справочники.ТочкиОбменаRMQ.ТекущаяБаза);
	Параметры.Вставить("КлючМаршрутизации"	, XMLСтрока(Справочники.тн_ПроизводственныеПодразделения.УПП_Каркас));
	
	// - логирование
	Параметры.Вставить("Лог_ВидСообщения"	, Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена);
	Параметры.Вставить("Лог_ВидИнтеграции"	, Перечисления.тн_ВидыИнтеграций.ERP_УХ_Отправка);
	
	Возврат Параметры;
	
КонецФункции

