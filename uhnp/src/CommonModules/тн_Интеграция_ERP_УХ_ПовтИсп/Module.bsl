// Борисенко Игорь 27.10.2023 Выполнение задач №000047300
Функция ЗначениеДополнительнойНастройкиПоОрганизации(ДатаСреза, Организация, ИмяНастройки) Экспорт
	
	Если Не ЕстьДополнительнаяНастройкаПоОрганизациям(ИмяНастройки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = ВыборкаДополнительныхНастроеПоОрганизации(ДатаСреза, Организация);
	Если Выборка.Следующий() Тогда
		Возврат Выборка[ИмяНастройки];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Борисенко Игорь 27.10.2023 Выполнение задач №000047300
Функция ВыборкаДополнительныхНастроеПоОрганизации(ДатаСреза, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.тн_ДополнительныеНастройкиПоОрганизациям.СрезПоследних(&ДатаСреза, Организация = &Организация) КАК тн_ДополнительныеНастройкиПоОрганизациямСрезПоследних";
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Выборка;
	
КонецФункции

// Борисенко Игорь 27.10.2023 Выполнение задач №000047300
Функция ЕстьДополнительнаяНастройкаПоОрганизациям(ИмяНастройки) Экспорт
	
	ЕстьНастройка = Метаданные.РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям.Ресурсы.Найти(ИмяНастройки) <> Неопределено;
	
	Возврат ЕстьНастройка;
	
КонецФункции

// Юдина (Гутарова) Екатерина 16.10.2024 Выполнение задач №000051189
//   
// Получает срез последних по регистру "Доп. настройки по организациям" для указанных через запятую ресурсов.
//
Функция ПолучитьСтруктуруНастроекПоОрганизации(ДатаСреза, Организация, ИмяНастроек) Экспорт
	
	СтруктураНастроек = Новый Структура(ИмяНастроек);
	
	МассивНастроек = СтрРазделить(ИмяНастроек, ",", Ложь);
	
	Если ЗначениеЗаполнено(МассивНастроек) Тогда     
		Выборка = ВыборкаДополнительныхНастроеПоОрганизации(ДатаСреза, Организация);  
		
		Если Выборка.Следующий() Тогда
			
			Для Каждого ИмяНастройки Из МассивНастроек Цикл 	
				
				СтруктураНастроек.Вставить(ИмяНастройки, Выборка[ИмяНастройки]); 
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЕсли;     
	
	Возврат	СтруктураНастроек;
	
КонецФункции

