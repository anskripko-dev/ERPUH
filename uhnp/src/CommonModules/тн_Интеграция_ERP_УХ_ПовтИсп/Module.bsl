// Борисенко Игорь 01.02.2024 Выполнение задач №000048304
Функция ПолучитьЗначениеКонстанты(ИмяКонстанты) Экспорт
    
    УстановитьПривилегированныйРежим(Истина);
    
    Попытка
        Значение = ПланыВидовХарактеристик.тн_Константы[ИмяКонстанты].Значение;
    Исключение
        стрСообщение = НСтр("ru = 'Отсуствует константа: %1. Необходимо сообщить разработчику об инциденте'");
        стрСообщение = СтрШаблон(стрСообщение, ИмяКонстанты);
        ОбщегоНазначения.СообщитьПользователю(стрСообщение);
        Возврат Неопределено;
    КонецПопытки;
    Если Значение = Неопределено Тогда
        Типы = ПланыВидовХарактеристик.тн_Константы[ИмяКонстанты].ТипЗначения.Типы();
        Если Типы.Количество() = 1 Тогда
            Если Типы[0] = Тип("Булево") Тогда
                Возврат Ложь;    
            ИначеЕсли Типы[0] = Тип("Число") Тогда
                Возврат 0;
            ИначеЕсли Типы[0] = Тип("Строка") Тогда
                Возврат "";
            ИначеЕсли Типы[0] = Тип("Дата") Тогда
                Возврат Дата(1,1,1);
            КонецЕсли;
        Иначе
            Возврат Значение;
        КонецЕсли;
    Иначе
        Возврат Значение;
    КонецЕсли;
    
КонецФункции
 
// Борисенко Игорь 01.02.2024 Выполнение задач №000048304
Функция ПолучитьЗначенияСпискаКонстант(Знач ИменаКонстант, ВозвращатьМассив = Ложь) Экспорт
    
    УстановитьПривилегированныйРежим(Истина);
    
    ЗначенияКонстант = Новый Структура;
    
    ИменаКонстант = СтрЗаменить(ИменаКонстант, " ", "");
    СписокКонстант = СтрРазделить(ИменаКонстант, ",", Ложь);
    
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("СписокКонстант", СписокКонстант);
    Запрос.Текст =
    "ВЫБРАТЬ
    |	тн_Константы.ИмяПредопределенныхДанных КАК ИмяКонстанты,
    |	тн_Константы.Значение КАК Значение
    |ИЗ
    |	ПланВидовХарактеристик.тн_Константы КАК тн_Константы
    |ГДЕ
    |	тн_Константы.ИмяПредопределенныхДанных В(&СписокКонстант)";
    Результат = Запрос.Выполнить();
    
    Если ВозвращатьМассив Тогда
        Возврат Результат.Выгрузить().ВыгрузитьКолонку("Значение");
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗначенияКонстант.Вставить(Выборка.ИмяКонстанты, Выборка.Значение);
    КонецЦикла;
    
    Возврат ЗначенияКонстант;
    
КонецФункции

