Функция СтруктураДопПараметровПоСчетамЭквайринга(УИД_БанковскийСчет) Экспорт
	
	СтруктураДопПараметров = Новый Структура();
	СтруктураДопПараметров.Вставить("ЭтоТорговыйЭквайринг", Ложь);
	СтруктураДопПараметров.Вставить("ВыборкаПоСчетамЭквайринга", Неопределено);
	
	Если ЗначениеЗаполнено(УИД_БанковскийСчет) Тогда 
		
		Если ТипЗнч(УИД_БанковскийСчет)=Тип("СправочникСсылка.БанковскиеСчетаОрганизаций") Тогда
			БанковскийСчет = УИД_БанковскийСчет; 
		Иначе
			БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД_БанковскийСчет));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(БанковскийСчет) Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("БанковскийСчетЭквайринга", БанковскийСчет);	
			
			Запрос.Текст ="ВЫБРАТЬ
						|	*
						|ИЗ
						|	РегистрСведений.тн_СчетаЭквайринга КАК тн_СчетаЭквайринга
						|ГДЕ
						|	тн_СчетаЭквайринга.БанковскийСчетЭквайринга = &БанковскийСчетЭквайринга";
			
			УстановитьПривилегированныйРежим(Истина);
			Выборка = Запрос.Выполнить().Выбрать();
			УстановитьПривилегированныйРежим(Ложь);
			
			Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.БанковскийСчетЭквайринга) Тогда
				СтруктураДопПараметров.ЭтоТорговыйЭквайринг = Истина;
				СтруктураДопПараметров.ВыборкаПоСчетамЭквайринга = Выборка;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураДопПараметров;
		
