	ОписаниеОбъекта = ОписаниеОбъектаИзКэша(Кэш, ШаблонОписания);
	Если ОписаниеОбъекта <> Неопределено Тогда
		Возврат ОписаниеОбъекта;
	КонецЕсли;
	
	Если ТипЗнч(ТекСоединениеВИБ)=Тип("Строка") Тогда
		
