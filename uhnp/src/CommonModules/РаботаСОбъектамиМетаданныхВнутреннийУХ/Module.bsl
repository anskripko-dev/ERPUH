		Возврат ОписаниеОбъекта;
	КонецЕсли;
		
	Если ТипЗнч(ТекСоединениеВИБ)=Тип("Строка") Тогда
		
		Возврат ПолучитьОписаниеОбъекта1СШина(ТекСоединениеВИБ,ШаблонОписания);
		
	Иначе
		
		Возврат ТекСоединениеВИБ.GetPropertiesOfMetadataObject(Новый ХранилищеЗначения(ШаблонОписания, Новый СжатиеДанных(9))).Получить();
		
	КонецЕсли;
	
