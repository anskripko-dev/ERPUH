Процедура ПриЧтенииНаСервере(Форма, Объект)
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		Если ТипЗнч(Объект) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			ГруппаДляКнопкиПроцесс = ОпределитьГруппуКнопкиПОД(Форма);
		Иначе
			ГруппаДляКнопкиПроцесс = Неопределено;
		КонецЕсли;
		
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриЧтенииНаСервере(Форма, Объект, , ГруппаДляКнопкиПроцесс);
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, Объект)
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		Если ТипЗнч(Объект) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			Источник = Новый Структура;
			Источник.Вставить("Ссылка", Объект);
			Источник.Вставить("ИсточникОтчета", РегламентированнаяОтчетностьВызовСервера.ИсточникОтчета(Форма.ИмяФормы));
			ГруппаДляКнопкиПроцесс = ОпределитьГруппуКнопкиПОД(Форма);
		Иначе
			Источник = Объект;
			ГруппаДляКнопкиПроцесс = Неопределено;
		КонецЕсли;
		
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриСозданииНаСервере(Форма, Источник, , ГруппаДляКнопкиПроцесс);
	КонецЕсли;
КонецПроцедуры

Функция ОпределитьГруппуКнопкиПОД(Форма)
	Если Форма.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет Или Форма.КоманднаяПанель.Видимость = Ложь Тогда
		ГруппаКнопки = Форма.Элементы.Найти("ГруппаКнопки");
		Если ТипЗнч(ГруппаКнопки) = Тип("ГруппаФормы") Тогда 
			Возврат ГруппаКнопки;
		КонецЕсли;
	КонецЕсли;
	Возврат Форма.КоманднаяПанель;
КонецФункции

#КонецОбласти

#Область БлокировкаОткрытыхВДругомСеансеОтчетов

Процедура ЗапретРедактированияОткрытогоОтчета(Форма, МассивНедоступных)
	Форма.СтруктураРеквизитовФормы.Вставить("ЗаблокированоВДругомСеансе", Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов") Тогда
		МодульЗапретРедактированияРеквизитовОбъектов = ОбщегоНазначения.ОбщийМодуль("ЗапретРедактированияРеквизитовОбъектов");
		МодульЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(Форма,,
			НСтр("ru = '<Не используется>';
				|en = '<Not used>'"), Форма.СтруктураРеквизитовФормы.мСохраненныйДок);
	КонецЕсли;
	
	ПараметрыЗапретаРедактированияРеквизитов = Неопределено;
	РеквизитыФормы = Форма.ПолучитьРеквизиты();
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		Если РеквизитФормы.Имя = "ПараметрыЗапретаРедактированияРеквизитов" Тогда
			ПараметрыЗапретаРедактированияРеквизитов = РеквизитФормы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрыЗапретаРедактированияРеквизитов = Неопределено Тогда
		БлокируемыеРеквизиты = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Форма.СтруктураРеквизитовФормы.мСохраненныйДок).ПолучитьБлокируемыеРеквизитыОбъекта();
		
		Для Каждого БлокируемыйРеквизит Из БлокируемыеРеквизиты Цикл
			БлокируемыеЭлементы = СтрРазделить(БлокируемыйРеквизит, ";,");
			Если БлокируемыеЭлементы.Количество() > 1 Тогда
				БлокируемыеЭлементы.Удалить(0);
			КонецЕсли;
			Для Каждого БлокируемыйЭлемент Из БлокируемыеЭлементы Цикл
				ЭлементФормы = Форма.Элементы.Найти(БлокируемыйЭлемент);
				Если ЭлементФормы <> Неопределено Тогда
					Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы")
					   И ЭлементФормы.Вид <> ВидПоляФормы.ПолеНадписи
					 Или ТипЗнч(ЭлементФормы) = Тип("ТаблицаФормы") Тогда
						ЭлементФормы.ТолькоПросмотр = Истина;
					Иначе
						ЭлементФормы.Доступность = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ИменаПолейТабличногоДокумента = СтрРазделить("ТабличныйДокумент;ПолеТабличногоДокументаФормаОтчета", ";");
	Для Каждого ИмяПоляТабличногоДокумента Из ИменаПолейТабличногоДокумента Цикл
		ЭлементФормыПолеТабличногоДокумента = Форма.Элементы.Найти(ИмяПоляТабличногоДокумента);
		Если НЕ ЭлементФормыПолеТабличногоДокумента = Неопределено Тогда
			ЭлементФормыПолеТабличногоДокумента.ЧерноБелыйПросмотр = Истина;
			ЭлементФормыПолеТабличногоДокумента.УстановитьДействие("Выбор",
				"Отключенный_" + ЭлементФормыПолеТабличногоДокумента.ПолучитьДействие("Выбор"));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элт Из СтрРазделить("Обновить;РазрешитьРедактированиеРеквизитовОбъекта;ОтправитьВКонтролирующийОрган;Выгрузить", ";") Цикл
		Элемент = Форма.Элементы.Найти(Элт);
		Если Элемент <> Неопределено Тогда
			Элемент.Видимость = Ложь; 
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(МассивНедоступных) = Тип("Массив") Тогда 
		Для Каждого Элт Из МассивНедоступных Цикл 
			Элемент = Форма.Элементы.Найти(Элт);
			Если Элемент <> Неопределено Тогда
				Элемент.Доступность = Ложь; 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Блокирует отчет если он открыт другим пользователем
// Либо установлена дата запрета изменения
// Форма - форма рег.отчета
// СписокНедоступных - массив из имен элементов, которые надо сделать недоступными, если стандартная обработка их не видит
//                     или строка с разделителями ; (точка с запятой)
Процедура БлокировкаИлиЗапретРедактированияОтчета(Форма, СписокНедоступных = Неопределено) Экспорт 
	Попытка
		Если ПравоДоступа("Изменение", Метаданные.Документы.РегламентированныйОтчет) Тогда 
			ЗаблокироватьДанныеДляРедактирования(Форма.СтруктураРеквизитовФормы.мСохраненныйДок, , Форма.УникальныйИдентификатор);
			
			НеобходимаБлокировка = Ложь;
			Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДатыЗапретаИзменения")
				И ТипЗнч(Форма.СтруктураРеквизитовФормы.мСохраненныйДок) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
				МодульДатыЗапретаИзменения = ОбщегоНазначения.ОбщийМодуль("ДатыЗапретаИзменения");
				РегОтчетОбъект = Форма.СтруктураРеквизитовФормы.мСохраненныйДок.ПолучитьОбъект();
				ОписаниеОшибки = "";
				Если Не РегОтчетОбъект.ЭтоНовый() И МодульДатыЗапретаИзменения.ИзменениеЗапрещено(РегОтчетОбъект, Неопределено, ОписаниеОшибки) Тогда 
					ОписаниеОшибки = "Отчет открыт в режиме ""только просмотр""" + Символы.ПС + ОписаниеОшибки;
					НеобходимаБлокировка = Истина;
				КонецЕсли;
			КонецЕсли;
		Иначе
			НеобходимаБлокировка = Истина;
			ОписаниеОшибки = "Отсутствуют права на запись, отчет открыт в режиме только просмотр";
		КонецЕсли;
	Исключение
		НеобходимаБлокировка = Истина;
		ОписаниеОшибки = ИнформацияОбОшибке().Причина.Описание;
	КонецПопытки;
	
	Если НеобходимаБлокировка Тогда 
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Если ТипЗнч(СписокНедоступных) = Тип("Массив") Тогда 
			БлокируемыеРеквизиты = СписокНедоступных;
		ИначеЕсли ТипЗнч(СписокНедоступных) = Тип("Строка") Тогда 
			БлокируемыеРеквизиты = СтрРазделить(СписокНедоступных, ";", Ложь);
		Иначе
			БлокируемыеРеквизиты = Неопределено;
		КонецЕсли;
		ЗапретРедактированияОткрытогоОтчета(Форма, БлокируемыеРеквизиты);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ЗапретРедактированияСданныхОтчетов

// Вызывается из процедуры "ПриИнициализацииФормыРегламентированногоОтчетаОбщиеДействия"
// размещенной в модуле "РегламентированнаяОтчетностьКлиентСервер".
//
Процедура ЗапретитьРедактированиеРеквизитовСданногоОтчета(Форма, КонтролирующийОрган = "ФНС") Экспорт
	
	СвойстваФормы = Новый Структура("СтруктураРеквизитовФормы");
	ЗаполнитьЗначенияСвойств(СвойстваФормы, Форма);
	
	СохраненныйДок = Неопределено;
	Если НЕ (ТипЗнч(СвойстваФормы.СтруктураРеквизитовФормы) = Тип("Структура")
		И СвойстваФормы.СтруктураРеквизитовФормы.Свойство("мСохраненныйДок", СохраненныйДок)
		И ЗначениеЗаполнено(СохраненныйДок)) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусОтправки = Неопределено;
	СостояниеСдачиОтчетности = Неопределено;
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОпределитьСтатусИСостояниеСдачиОтчетности(
		СохраненныйДок, СохраненныйДок.Организация, КонтролирующийОрган, СостояниеСдачиОтчетности, СтатусОтправки);
		
	СтатусОтправкиВЖурнале = СохраненныйСтатусОтправкиРеглОтчета(СохраненныйДок);
	
	ЗапретитьРедактированиеПользователем = ((СтрНачинаетсяС(СтатусОтправки, "Сдано")
		И СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота)
		ИЛИ СтатусОтправки = ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения()) И СтрНайти(СтатусОтправки, СтатусОтправкиВЖурнале) = 1;
	
	Если ЗапретитьРедактированиеПользователем Тогда
		Попытка
			
			// Обработчик подсистемы запрета редактирования реквизитов объектов.
			Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов") Тогда
				МодульЗапретРедактированияРеквизитовОбъектов = ОбщегоНазначения.ОбщийМодуль("ЗапретРедактированияРеквизитовОбъектов");
				МодульЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(Форма,,
					НСтр("ru = 'Разрешить редактирование отчета';
						|en = 'Allow report editing'"), СохраненныйДок);
			КонецЕсли;
			
			ПараметрыЗапретаРедактированияРеквизитов = Неопределено; // заполнен, если форма потготовлена.
			РеквизитыФормы = Форма.ПолучитьРеквизиты();
			Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
				Если РеквизитФормы.Имя = "ПараметрыЗапретаРедактированияРеквизитов" Тогда
					ПараметрыЗапретаРедактированияРеквизитов = РеквизитФормы;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ПараметрыЗапретаРедактированияРеквизитов = Неопределено Тогда
				
				БлокируемыеРеквизиты = 
					ОбщегоНазначения.МенеджерОбъектаПоСсылке(СохраненныйДок.Ссылка).ПолучитьБлокируемыеРеквизитыОбъекта();
				
				// Блокировка редактирования элементов формы, связанных с заданными реквизитами.
				Для Каждого БлокируемыйРеквизит Из БлокируемыеРеквизиты Цикл
					БлокируемыеЭлементы = СтрРазделить(БлокируемыйРеквизит, ";,");
					Если БлокируемыеЭлементы.Количество() > 1 Тогда
						БлокируемыеЭлементы.Удалить(0);
					КонецЕсли;
					Для Каждого БлокируемыйЭлемент Из БлокируемыеЭлементы Цикл
						ЭлементФормы = Форма.Элементы.Найти(БлокируемыйЭлемент);
						Если ЭлементФормы <> Неопределено Тогда
							Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы")
							   И ЭлементФормы.Вид <> ВидПоляФормы.ПолеНадписи
							 Или ТипЗнч(ЭлементФормы) = Тип("ТаблицаФормы") Тогда
								ЭлементФормы.ТолькоПросмотр = Истина;
							Иначе
								ЭлементФормы.Доступность = Ложь;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				
			КонецЕсли;
			
			ИменаПолейТабличногоДокумента = СтрРазделить("ТабличныйДокумент;ПолеТабличногоДокументаФормаОтчета", ";");
			
			Для Каждого ИмяПоляТабличногоДокумента Из ИменаПолейТабличногоДокумента Цикл
				ЭлементФормыПолеТабличногоДокумента = Форма.Элементы.Найти(ИмяПоляТабличногоДокумента);
				Если НЕ ЭлементФормыПолеТабличногоДокумента = Неопределено Тогда
					ЭлементФормыПолеТабличногоДокумента.ЧерноБелыйПросмотр = Истина;
					ЭлементФормыПолеТабличногоДокумента.УстановитьДействие("Выбор",
						"Отключенный_" + ЭлементФормыПолеТабличногоДокумента.ПолучитьДействие("Выбор"));
				КонецЕсли;
			КонецЦикла;
			
			ТекущееСостояние = ТекущееСостояниеОтправки(СохраненныйДок, КонтролирующийОрган);
			ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СохраненныйДок);
			Если ТекущееСостояние <> Неопределено И ЗначениеЗаполнено(ЦиклОбмена) Тогда
				СвойстваФормы.СтруктураРеквизитовФормы.Вставить("ПоследнийЦиклОбмена", ЦиклОбмена);
				ИзменитьЗаголовокКнопкиПечати = Истина;
				
				Если ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ОтчетностьПФР Тогда
					ИзменитьЗаголовокКнопкиПечати = Ложь;
				КонецЕсли;
				
				// Подготовка кнопок печати.
				ЭлементПоказатьБланк = Форма.Элементы.Найти("ПоказатьБланк");
				Если ЭлементПоказатьБланк <> Неопределено И ИзменитьЗаголовокКнопкиПечати Тогда
					КомандаПоказатьБланк = Форма.Команды.Найти(ЭлементПоказатьБланк.ИмяКоманды);
					Если КомандаПоказатьБланк <> Неопределено Тогда
						ЗаголовокУточнение = "(со штампом ЭП)";
						Если ЗначениеЗаполнено(ЭлементПоказатьБланк.Заголовок) Тогда
							ЭлементПоказатьБланк.Заголовок = ЭлементПоказатьБланк.Заголовок + " " + ЗаголовокУточнение;
						Иначе
							КомандаПоказатьБланк.Заголовок = КомандаПоказатьБланк.Заголовок + " " + ЗаголовокУточнение;
						КонецЕсли;
					КонецЕсли;
					
					Если Форма.Элементы.Найти("Печать") <> Неопределено
					   И Форма.Элементы.Найти("ПоказатьСДвухмернымШтрихкодомPDF417") <> Неопределено Тогда
						Если Форма.СтруктураРеквизитовФормы.Свойство("мПечатьБезШтрихкодаРазрешена") Тогда
							Форма.СтруктураРеквизитовФормы.мПечатьБезШтрихкодаРазрешена = Истина;
							РегламентированнаяОтчетностьКлиентСервер.ПоказатьКнопкиПечати(Форма);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			// Доступность элемента регулируется из модуля формы, поэтому - скрываем его.
			ЭлементОбновить = Форма.Элементы.Найти("Обновить");
			Если ЭлементОбновить <> Неопределено Тогда
				ЭлементОбновить.Видимость = Ложь; 
			КонецЕсли;
			
			Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СвойстваФормы.СтруктураРеквизитовФормы, "ЗаблокированоВДругомСеансе", Ложь) Тогда
				ЭлементРазрешитьРедактирование = Форма.Элементы.Найти("РазрешитьРедактированиеРеквизитовОбъекта");
				Если ЭлементРазрешитьРедактирование <> Неопределено Тогда
					ЭлементРазрешитьРедактирование.Видимость = Ложь; 
				КонецЕсли;
			КонецЕсли;
			
			Если СтатусОтправкиВЖурнале <> Неопределено Тогда
				ЭлементНаименованиеЭтапа = Форма.Элементы.Найти("НаименованиеЭтапа");
				Если ЭлементНаименованиеЭтапа <> Неопределено Тогда
					ЭлементНаименованиеЭтапа.Заголовок = СтатусОтправкиВЖурнале;
				КонецЕсли;
			КонецЕсли;
			
			Форма.СтруктураРеквизитовФормы.Вставить("ЗаблокированоВДругомСеансе", Истина);
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Установка запрета редактирования сданного регламентированного отчета';
					|en = 'Prevent the submitted local accounting report from being edited'"), 
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Вызывается из процедур, вызванных обработчиком команды "РазрешитьРедактированиеРеквизитовОбъекта"
// размещенной в форме регламентированного отчета.
//
Процедура РазрешитьРедактированиеРеквизитовОтчета(Форма) Экспорт
	
	ИменаПолейТабличногоДокумента = СтрРазделить("ТабличныйДокумент;ПолеТабличногоДокументаФормаОтчета;ПредставлениеУведомления", ";");
	
	Для Каждого ИмяПоляТабличногоДокумента Из ИменаПолейТабличногоДокумента Цикл
		ЭлементФормыПолеТабличногоДокумента = Форма.Элементы.Найти(ИмяПоляТабличногоДокумента);
		Если НЕ ЭлементФормыПолеТабличногоДокумента = Неопределено Тогда
			// Включить действие "Выбор" в поле табличного документа.
			ЭлементФормыПолеТабличногоДокумента.УстановитьДействие("Выбор",
				СтрЗаменить(ЭлементФормыПолеТабличногоДокумента.ПолучитьДействие("Выбор"), "Отключенный_", ""));
		КонецЕсли;
	КонецЦикла;
	
	// Восстановить заголовок кнопки печати.
	ЭлементПоказатьБланк = Форма.Элементы.Найти("ПоказатьБланк");
	Если ЭлементПоказатьБланк <> Неопределено Тогда
		КомандаПоказатьБланк = Форма.Команды.Найти(ЭлементПоказатьБланк.ИмяКоманды);
		Если КомандаПоказатьБланк <> Неопределено Тогда
			Если ЗначениеЗаполнено(ЭлементПоказатьБланк.Заголовок) Тогда
				ЭлементПоказатьБланк.Заголовок = СокрП(СтрРазделить(ЭлементПоказатьБланк.Заголовок, "(")[0]);
			Иначе
				КомандаПоказатьБланк.Заголовок = СокрП(СтрРазделить(КомандаПоказатьБланк.Заголовок, "(")[0]);
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	
	// Удалить ссылку на последний цикл обмена - не будут выводиться в печатных формах штампы ЭП.
	Если Форма.СтруктураРеквизитовФормы.Свойство("ПоследнийЦиклОбмена") Тогда
		Форма.СтруктураРеквизитовФормы.Удалить("ПоследнийЦиклОбмена"); 
	КонецЕсли;
	
	Форма.СтруктураРеквизитовФормы.Вставить("ЗаблокированоВДругомСеансе", Ложь);
КонецПроцедуры

#КонецОбласти

#Область РегистрацииВНалоговомОргане

Процедура ЗаполнитьСведенияОПредставителеАвансовогоПлатежаАкциза(
		Форма,
		РегистрацииВНалоговомОргане = Неопределено, 
		КПП = Неопределено) Экспорт
		
	СтруктураРеквизитовФормы = Форма.СтруктураРеквизитовФормы;
	
	Области = Форма.ТабличныйДокумент.Области;
	СтруктураРеквизитовФормы.УполномоченноеЛицоПредставителя = "";
	СтруктураРеквизитовФормы.НаименованиеОрганизацииПредставителя = "";
	ДокументПредставителя = "";
	ТипПодписанта = "1";
	Если ЗначениеЗаполнено(РегистрацииВНалоговомОргане) Тогда
		Если ТипЗнч(РегистрацииВНалоговомОргане) = Тип("Строка") Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			                      |	РегистрацииВНалоговомОргане.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
			                      |ГДЕ
			                      |	РегистрацииВНалоговомОргане.Код = &Код
			                      |	И РегистрацииВНалоговомОргане.КПП = &КПП
			                      |	И РегистрацииВНалоговомОргане.Владелец = &Владелец");
			Запрос.УстановитьПараметр("Код", РегистрацииВНалоговомОргане);
			Запрос.УстановитьПараметр("Владелец", СтруктураРеквизитовФормы.Организация);
			Запрос.УстановитьПараметр("КПП", КПП);
		Иначе
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			                      |	РегистрацииВНалоговомОргане.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
			                      |ГДЕ
			                      |	РегистрацииВНалоговомОргане.Ссылка = &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", РегистрацииВНалоговомОргане);
		КонецЕсли;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			ДанныеПредставителя = РегистрацияВНОСервер.ДанныеРегистрации(Выборка.Ссылка);
			
			Если ЗначениеЗаполнено(ДанныеПредставителя.Представитель) Тогда
				ТипПредставителя = ТипЗнч(ДанныеПредставителя.Представитель);
				Если НЕ РегламентированнаяОтчетность.ПредставительЯвляетсяФизЛицом(ДанныеПредставителя.Представитель) Тогда
					СтруктураРеквизитовФормы.УполномоченноеЛицоПредставителя = СокрЛП(ДанныеПредставителя.УполномоченноеЛицоПредставителя);
					СтруктураРеквизитовФормы.НаименованиеОрганизацииПредставителя = СокрЛП(ДанныеПредставителя.Представитель);
					СтруктураРеквизитовФормы.ИННПредставителя = СокрЛП(ДанныеПредставителя.Представитель.ИНН);
					СтруктураРеквизитовФормы.КПППредставителя = СокрЛП(ДанныеПредставителя.Представитель.КПП);
				Иначе
					СтруктураРеквизитовФормы.УполномоченноеЛицоПредставителя = СокрЛП(ДанныеПредставителя.Представитель);
					СтруктураРеквизитовФормы.ИННПредставителя = СокрЛП(ДанныеПредставителя.Представитель.ИНН);
				КонецЕсли;
				ДокументПредставителя = СокрЛП(ДанныеПредставителя.ДокументПредставителя);
				ТипПодписанта = "2";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипПодписанта = "1" Тогда
		СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(СтруктураРеквизитовФормы.Организация, Форма.ДатаПодписи, "ФИОРук, ФИО");
		СтруктураРеквизитовФормы.УполномоченноеЛицоПредставителя = СокрЛП(?(ЗначениеЗаполнено(СведенияОбОрганизации.ФИОРук), СведенияОбОрганизации.ФИОРук, СведенияОбОрганизации.ФИО));
	КонецЕсли;
	
	Области.ПрПодп.Значение = ТипПодписанта;
	Области.ФИОРук.Значение = СтруктураРеквизитовФормы.УполномоченноеЛицоПредставителя;
	Области.НаимДокументаПП.Значение = ДокументПредставителя;
	
	Форма.Модифицированность = Истина;
	
КонецПроцедуры

Функция ПолучитьПоКодамСведенияОПредставителеПрибыль(Организация, КодНО, КПП = Неопределено) Экспорт
	
	ТипПодписанта = "1";
	флПредставительЮрЛицо = Истина;
	НаименованиеОрганизацииПредставителя = "";
	ФИОПредставителя = "";
	ПредставительСсылка = Неопределено;
	ДокументПредставителя = "";
	
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	РегистрацииВНалоговомОргане.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	               |ГДЕ
	               |	РегистрацииВНалоговомОргане.Владелец = &Организация
	               |	И РегистрацииВНалоговомОргане.Код = &КодНО
	               |	И РегистрацииВНалоговомОргане.ПометкаУдаления = &ПометкаУдаления";
				   
	Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);			   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КодНО", КодНО);
	
	Если КПП <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + " И РегистрацииВНалоговомОргане.КПП = &КПП";
		Запрос.УстановитьПараметр("КПП", КПП);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ДанныеПредставителя = РегистрацияВНОСервер.ДанныеРегистрации(Выборка.Ссылка);
		Если ЗначениеЗаполнено(ДанныеПредставителя.Представитель) Тогда
			ТипПодписанта = "2";
			ПредставительСсылка = ДанныеПредставителя.Представитель;
			ДокументПредставителя = ДанныеПредставителя.ДокументПредставителя;
			
			Если НЕ РегламентированнаяОтчетность.ПредставительЯвляетсяФизЛицом(ДанныеПредставителя.Представитель) Тогда
				флПредставительЮрЛицо = Истина;
				НаименованиеОрганизацииПредставителя = СокрЛП(ПредставительСсылка);
				ФИОПредставителя = СокрЛП(ДанныеПредставителя.УполномоченноеЛицоПредставителя);
			Иначе
				флПредставительЮрЛицо = Ложь;
				ФИОПредставителя = СокрЛП(ПредставительСсылка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("ТипПодписанта, флПредставительЮрЛицо, НаименованиеОрганизацииПредставителя, ФИОПредставителя, ПредставительСсылка, ДокументПредставителя", 
							 ТипПодписанта, флПредставительЮрЛицо, НаименованиеОрганизацииПредставителя, ФИОПредставителя, ПредставительСсылка, ДокументПредставителя);
							 
КонецФункции //ПолучитьПоКодамСведенияОПредставителе

#КонецОбласти

#Область РегистрацииВОрганеСтатистики

Функция ИспользуютсяРегистрацииВОрганеСтатистики() Экспорт
	
	Возврат РегламентированнаяОтчетностьКлиентСервер.ИспользуютсяРегистрацииВОрганеСтатистики();
	
КонецФункции

Процедура ВывестиШапкуРегистрацияРеспондента(ТабличноеПоле) Экспорт
	
	Если Не ИспользуютсяРегистрацииВОрганеСтатистики() Тогда
		Возврат;
	КонецЕсли;
	
	Шапка = Новый ТабличныйДокумент;
	
	ПустаяСтрока = Шапка.ПолучитьОбласть("R1");
	ПустаяСтрока.Область(1, 1).ШиринаКолонки = 1;
	ПустаяСтрока.Область(1, 2).ШиринаКолонки = 4;
	ПустаяСтрока.Область(1, 3).ШиринаКолонки = 2;
	ПустаяСтрока.Область(1, 4).ШиринаКолонки = 38;
	ПустаяСтрока.Область(1, 5).ШиринаКолонки = 4;
	ПустаяСтрока.Область(1, 6).ШиринаКолонки = 21;
	ПустаяСтрока.Область(1, 7).ШиринаКолонки = 56;
	ПустаяСтрока.Область(1, 8).ШиринаКолонки = 11;
	
	Цвета = КоллекцияЦветовРаскраски();
	
	ОбластьСтроки = Шапка.ПолучитьОбласть("R2");
	
	ОбластьФлаг = ОбластьСтроки.Область(1, 3);
	ОбластьФлаг.СодержитЗначение = Истина;
	ОбластьФлаг.Имя = "ИсключитьДанныеТОСП";
	ОбластьФлаг.ТипЗначения = Новый ОписаниеТипов("Булево");
	ОбластьФлаг.Формат = "БЛ=' '; БИ=V";
	ОбластьФлаг.Значение = ОбластьФлаг.ТипЗначения.ПривестиЗначение();

	ОбластьИсключить = ОбластьСтроки.Область(1, 4);
	ОбластьИсключить.Имя = "ИсключитьДанныеТОСП_Заголовок";	
	ОбластьИсключить.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	
	ОбластьЗаголовок = ОбластьСтроки.Область(1, 6);
	ОбластьЗаголовок.Текст = НСтр("ru = 'Регистрация респондента';
									|en = 'Register a respondent'");
	
	ОбластьРегистрация = ОбластьСтроки.Область(1, 7);
	ОбластьРегистрация.СодержитЗначение = Истина;
	ОбластьРегистрация.Имя = "РегистрацияРеспондента";
	ОбластьРегистрация.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0));
	ОбластьРегистрация.Значение = ОбластьРегистрация.ТипЗначения.ПривестиЗначение();
	Попытка
		ОбластьРегистрация.УстановитьЭлементУправления(Тип("ПолеФормы"));
	Исключение
		ОбластьРегистрация.УстановитьЭлементУправления(Тип("ПолеВвода"));
	КонецПопытки;
	ОбластьРегистрация.Защита = Ложь;
	ОбластьРегистрация.ЦветФона = Цвета.ЦветЗаполняетсяОднозначноВручную;
	ОбластьРегистрация.ГраницаСнизу  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ОбластьРегистрация.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ОбластьРегистрация.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ОбластьРегистрация.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	ОбластьСостав = ОбластьСтроки.Область(1, 8);
	ОбластьСостав.Имя = "СоставРегистрации";
	ОбластьСостав.Текст = НСтр("ru = 'См. состав';
								|en = 'See content'");
	ОбластьСостав.Гиперссылка = Истина;
	ОбластьСостав.Защита = Ложь;
	ОбластьСостав.ЦветТекста = ЦветаСтиля.ЦветГиперссылкиБРО;
	ОбластьСостав.Шрифт = Новый Шрифт(ОбластьСостав.Шрифт,,,,,Истина);
	ОбластьСостав.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	ОбластьВывода = Шапка.Вывести(ПустаяСтрока);
	ОбластьВывода = Шапка.Вывести(ОбластьСтроки);
	ОбластьВывода = Шапка.Вывести(ПустаяСтрока);
	
	Шапка.Область("R1:R3").Имя = "ШапкаРегистрацияРеспондента";
	ТабличноеПоле.Вывести(Шапка);
	
КонецПроцедуры

Процедура ОбновитьОбластьРегистрацииРеспондента(Форма, ИмяТД = "ПолеТабличногоДокументаФормаОтчета") Экспорт
	
	Если ВидимостьОбластиРегистрацииРеспондента(Форма, ИмяТД) Тогда
		ОбщийМодульРегистрацииВОрганеСтатистикиКлиентСервер = ОбщегоНазначения.ОбщийМодуль("РегистрацииВОрганеСтатистикиКлиентСервер");
		ОбщийМодульРегистрацииВОрганеСтатистикиКлиентСервер.ОбновитьОбластьИсключитьТОСП(Форма, ИмяТД);
	КонецЕсли;
	
КонецПроцедуры

Функция ВидимостьОбластиРегистрацииРеспондента(Форма, ИмяТД = "ПолеТабличногоДокументаФормаОтчета") Экспорт
	
	Результат = Ложь;
	Если Не ИспользуютсяРегистрацииВОрганеСтатистики() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТабДок = Форма[ИмяТД];
	ОблВыборРегистрации = ТабДок.Области.Найти("ШапкаРегистрацияРеспондента");
	ОблВыборТОСП = ТабДок.Области.Найти("ШапкаОбособленныеПодразделения");
	Если ОблВыборРегистрации <> Неопределено И ОблВыборТОСП <> Неопределено Тогда
		Если Форма.РегистрацияРеспондента <> Неопределено Тогда
			ТабДок.УдалитьОбласть(ОблВыборТОСП, ТипСмещенияТабличногоДокумента.ПоВертикали);
			Результат = Истина;
		Иначе
			ТабДок.УдалитьОбласть(ОблВыборРегистрации, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПодключениеОтсутствующихВКонфигурацииОтчетовВВидеПатчей

Функция СинонимОтчетаДляДереваОтчетов(ИмяОтчета) Экспорт 
	ОтчетМенеджер = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если ТипЗнч(ОтчетМенеджер) = Тип("ОбъектМетаданных") Тогда 
		Возврат ?(ТипЗнч(ОтчетМенеджер.ОсновнаяФорма) = Тип("ОбъектМетаданных"),
			ОтчетМенеджер.ОсновнаяФорма.Синоним, ОтчетМенеджер.Синоним);
	КонецЕсли;
КонецФункции

Процедура ДополнитьДеревоОтчетовЭлементамиПатчей(ДеревоВсехИспользуемыхОтчетов) Экспорт 
	Попытка
		ТаблицаОписания = ПустаяТаблицаОписанияОбъектовРегламентированнойОтчетности();
		Для Каждого Отчет Из Метаданные.Отчеты Цикл 
			Если ТипЗнч(Отчет.РасширениеКонфигурации()) = Тип("РасширениеКонфигурации")
				И СтрНачинаетсяС(Отчет.Имя, "EF_") Тогда 
				Попытка
					Отчеты[Отчет.Имя].ДополнитьДеревоОтчетовЭлементамиПатчей(ТаблицаОписания, Отчет.Имя);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаОписанияОтчетов = ТаблицаОписания.Скопировать(Новый Структура("ВидДокумента, ЯвляетсяАктуальным", Перечисления.СтраницыЖурналаОтчетность.Отчеты, Истина));
		Для Каждого Стр Из ТаблицаОписанияОтчетов Цикл
			ЗначенияКолонок = Новый Структура;
			ЗначенияКолонок.Вставить("Наименование", Стр.Наименование);
			ЗначенияКолонок.Вставить("ПолноеИмя", Метаданные.НайтиПоТипу(Стр.ТипОбъекта).ПолноеИмя());
			ЗначенияКолонок.Вставить("ТипПолучателя", Стр.ВидКонтролирующегоОргана);
			ЗначенияКолонок.Вставить("Категория", Стр.ГруппаВДереве);
			ЗначенияКолонок.Вставить("ЭтоГруппа", Ложь);
			ЗначенияКолонок.Вставить("Ссылка", Справочники.РегламентированныеОтчеты.ПустаяСсылка());
			ЗначенияКолонок.Вставить("ВидОО", Стр.ВидЭлектронногоПредставления);
			
			ДобавитьОтчетВДеревоРегламентированныхОтчетов(ДеревоВсехИспользуемыхОтчетов, ЗначенияКолонок);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("НеУдалосьПоказатьНовыеРегОтчеты");
	КонецПопытки;
КонецПроцедуры

Функция ИсточникОтчетаПоСинониму(Отчет) Экспорт
	СтрОтб = Новый Структура("Наименование, ПолноеИмя, Ссылка");
	ЗаполнитьЗначенияСвойств(СтрОтб, Отчет);
	Если СтрОтб.Ссылка = Справочники.РегламентированныеОтчеты.ПустаяСсылка()
		И СтрОтб.ПолноеИмя = "Документ.РегламентированныйОтчет"
		И ЗначениеЗаполнено(СтрОтб.Наименование) Тогда 
		
		Для Каждого Отч Из Метаданные.Отчеты Цикл 
			Если СтрНачинаетсяС(Отч.Имя, "EF_") И СинонимОтчетаДляДереваОтчетов(Отч.Имя) = СтрОтб.Наименование Тогда
				Возврат Отч.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат "";
КонецФункции

#КонецОбласти

#Область НовыеМеханизмыПечати

Функция МакетыВАрхиве(ИмяФормы, ИмяМакетаАрхива) Экспорт
	СоответствиеИспользуемыхМакетов = Новый Соответствие;
	Если ЭтоВнешнийОтчет(ИмяФормы) Тогда 
		ДвоичныеДанныеМакета = РегламентированнаяОтчетностьВызовСервера.ОбъектОтчета(ИмяФормы).ПолучитьМакет(ИмяМакетаАрхива);
	Иначе
		АрхивТабличныхДокументов = Неопределено;
		ИмяОтчета = СтрРазделить(ИмяФормы, ".")[1];
		Для Каждого Макет Из Метаданные.Отчеты[ИмяОтчета].Макеты Цикл 
			Если СтрНачинаетсяС(Макет.Имя, "EF_") И СтрЗаканчиваетсяНа(Макет.Имя, ИмяМакетаАрхива) Тогда 
				АрхивТабличныхДокументов = Макет;
				Прервать;
			ИначеЕсли Макет.Имя = ИмяМакетаАрхива Тогда
				АрхивТабличныхДокументов = Макет;
			КонецЕсли;
		КонецЦикла;
		
		Если АрхивТабличныхДокументов = Неопределено Тогда 
			Возврат СоответствиеИспользуемыхМакетов;
		Иначе
			ДвоичныеДанныеМакета = Отчеты[ИмяОтчета].ПолучитьМакет(АрхивТабличныхДокументов.Имя);
		КонецЕсли;
	КонецЕсли;
	
	ЧтениеZipФайла = Новый ЧтениеZipФайла(Новый ПотокВПамяти(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанныеМакета)));
	КаталогВременныхФайлов = КаталогВременныхФайлов();
	Для Каждого Элт Из ЧтениеZipФайла.Элементы Цикл
		ИмяФайлаДляРаспаковки = КаталогВременныхФайлов + Элт.Имя;
		ЧтениеZipФайла.Извлечь(Элт, КаталогВременныхФайлов, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		Если НРег(Элт.Расширение) = "mxl" Тогда 
			ТекущийТабличныйДокумент = Новый ТабличныйДокумент;
			ТекущийТабличныйДокумент.Прочитать(ИмяФайлаДляРаспаковки);
			СоответствиеИспользуемыхМакетов.Вставить(Элт.ИмяБезРасширения, ТекущийТабличныйДокумент);
		ИначеЕсли НРег(Элт.Расширение) = "tif" Тогда 
			СоответствиеИспользуемыхМакетов.Вставить(Элт.ИмяБезРасширения, Новый ДвоичныеДанные(ИмяФайлаДляРаспаковки));
		КонецЕсли;
		УдалитьФайлы(ИмяФайлаДляРаспаковки);
	КонецЦикла;
	
	ЧтениеZipФайла.Закрыть();
	Возврат СоответствиеИспользуемыхМакетов;
КонецФункции

Функция СтраницаЗаполнена(Данные, ИсключаемыеДанные = "") Экспорт 
	МассивИсключаемых = СтрРазделить(ИсключаемыеДанные, ",", Ложь);
	Для Каждого КЗ Из Данные Цикл
		Если МассивИсключаемых.Найти(КЗ.Ключ) = Неопределено И ЗначениеЗаполнено(КЗ.Значение) Тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПустаяСкопированнаяСтруктура(Исходник)
	Результат = Новый Структура;
	Для Каждого КЗ Из Исходник Цикл 
		Результат.Вставить(КЗ.Ключ, "");
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура МногострочнаяЧастьВДанные(Данные, МногострочнаяЧасть, Начало, Конец) Экспорт 
	ДанныеИсходные = ПустаяСкопированнаяСтруктура(МногострочнаяЧасть[Начало - 1].Значение);
	Для Инд = Начало По Конец Цикл 
		ТекущиеДанные = ?(Инд > МногострочнаяЧасть.Количество(), ДанныеИсходные, МногострочнаяЧасть[Инд - 1].Значение);
		Постфикс = "_" + (1 + Инд - Начало);
		Для Каждого КЗ Из ТекущиеДанные Цикл 
			Данные.Вставить(КЗ.Ключ + Постфикс, ТекущиеДанные[КЗ.Ключ]);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ДополнитьДанныеДляПечати(Данные, ДляДополнения) Экспорт 
	Для Каждого КЗ Из ДляДополнения Цикл 
		Данные.Вставить(КЗ.Ключ, ДляДополнения[КЗ.Ключ]);
	КонецЦикла;
КонецПроцедуры

Функция ПустоеЗначениеТипа(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда 
		Возврат "";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда 
		Возврат 0;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда 
		Возврат Дата('00010101');
	Иначе
		ТекущийТип = Новый Массив;
		ТекущийТип.Добавить(ТипЗнч(Значение));
		ОТ = Новый ОписаниеТипов(ТекущийТип);
		Возврат ОТ.ПривестиЗначение(Неопределено);
	КонецЕсли;
КонецФункции

Процедура ОчисткаДанныхДляПечати(Данные) Экспорт 
	Для Каждого КЗ Из Данные Цикл 
		Если ЗначениеЗаполнено(КЗ.Значение) Тогда 
			Данные.Вставить(КЗ.Ключ, ПустоеЗначениеТипа(КЗ.Значение));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЗаполненнаяМногострочнаяЧасть(МногострочнаяЧасть) Экспорт 
	Результат = Новый СписокЗначений;
	Для Каждого Стр Из МногострочнаяЧасть Цикл 
		Если СтраницаЗаполнена(Стр.Данные) Тогда 
			Результат.Добавить(Стр.Данные);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПустаяМногострочнаяЧасть(МногострочнаяЧасть) Экспорт 
	Результат = Новый СписокЗначений;
	Для Каждого Стр Из МногострочнаяЧасть Цикл 
		ПустаяСтруктура = ОбщегоНазначения.СкопироватьРекурсивно(Стр.Данные);
		ОчисткаДанныхДляПечати(ПустаяСтруктура);
		Результат.Добавить(ПустаяСтруктура);
		Прервать;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НовыйПустойЛист()
	ПечатнаяФорма = Новый ТабличныйДокумент;
	ПечатнаяФорма.ОтображатьЗаголовки = Ложь;
	ПечатнаяФорма.ОтображатьСетку     = Ложь;
	ПечатнаяФорма.ЧерноБелыйПросмотр  = Истина;
	ПечатнаяФорма.ЧерноБелаяПечать    = Истина;
	ПечатнаяФорма.Автомасштаб         = Истина;
	ПечатнаяФорма.ПолеСверху = 5;
	ПечатнаяФорма.ПолеСправа = 5;
	ПечатнаяФорма.ПолеСнизу  = 5;
	ПечатнаяФорма.ПолеСлева  = 5;
	ПечатнаяФорма.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	Возврат ПечатнаяФорма;
КонецФункции

Функция ПустойМакетИзСписка(ИмяФормы, СписокИспользуемыхМакетов, ИмяМакета) Экспорт 
	Если ТипЗнч(СписокИспользуемыхМакетов) = Тип("Соответствие") Тогда 
		МакетПФ = СписокИспользуемыхМакетов[ИмяМакета];
		Если ТипЗнч(МакетПФ) = Тип("ТабличныйДокумент") Тогда
			Результат = НовыйПустойЛист();
			Результат.Вывести(МакетПФ);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = НовыйПустойЛист();
	Результат.Вывести(РегламентированнаяОтчетностьВызовСервера.ОбъектОтчета(ИмяФормы).ПолучитьМакет(ИмяМакета));
	Возврат Результат;
КонецФункции

Процедура НапечататьСтруктуру(ПечатнаяФорма, Данные, КонтекстПечати) Экспорт 
	Для Каждого КЗ Из Данные Цикл 
		Если ЗначениеЗаполнено(КЗ.Значение) Тогда 
			ТипЗнчКЗЗначение = ТипЗнч(КЗ.Значение);
			Если ТипЗнчКЗЗначение = Тип("Число") Тогда 
				ЧислоВОбластиМакета(КЗ.Значение, КЗ.Ключ, ПечатнаяФорма, КонтекстПечати)
			ИначеЕсли ТипЗнчКЗЗначение = Тип("Строка") Тогда
				СтрокаВОбластиМакета(КЗ.Значение, КЗ.Ключ, ПечатнаяФорма, КонтекстПечати);
			ИначеЕсли ТипЗнчКЗЗначение = Тип("Дата") Тогда
				ДатаВОбластиМакета(КЗ.Значение, КЗ.Ключ, ПечатнаяФорма, КонтекстПечати);
			Иначе
				СтрокаВОбластиМакета(КонтекстПечати.ОТС.ПривестиЗначение(КЗ.Значение), КЗ.Ключ, ПечатнаяФорма, КонтекстПечати);
			КонецЕсли;
		Иначе
			СтрокаВОбластиМакета("", КЗ.Ключ, ПечатнаяФорма, КонтекстПечати);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЧислоВОбластиМакета(Число, ПрефиксПараметра, ПечатнаяФорма, КонтекстПечати)
	ЦелЧисло = Цел(Число);
	Если Число = ЦелЧисло Тогда 
		Строка = ?(ЗначениеЗаполнено(ЦелЧисло), Лев(Формат(ЦелЧисло, "ЧГ=") + КонтекстПечати["ОстатокСтроки"], 32), "");
		СтрокаВОбластиМакета(Строка, ПрефиксПараметра, ПечатнаяФорма, КонтекстПечати);
	Иначе
		ТочкаПройдена = Ложь;
		ДоЗапятой = 0;
		ПослеЗапятой = 0;
		Индекс = 0;
		ПраваяЧастьОбласти = -1;
		
		ПрПарам = ПрефиксПараметра + "_";
		Пока Истина Цикл 
			Индекс = Индекс + 1;
			Обл = ПечатнаяФорма.Области.Найти(ПрПарам + Индекс);
			Если Обл = Неопределено Тогда 
				Прервать;
			КонецЕсли;
			
			Если ТочкаПройдена Тогда 
				ПослеЗапятой = ПослеЗапятой + 1;
			ИначеЕсли Индекс > 1 Тогда
				Если (ПраваяЧастьОбласти + 1 <> Обл.Лево) Тогда 
					ТочкаПройдена = Истина;
					ПослеЗапятой = 1;
				Иначе
					ПраваяЧастьОбласти = Обл.Право;
					ДоЗапятой = ДоЗапятой + 1;
				КонецЕсли;
			Иначе
				ПраваяЧастьОбласти = Обл.Право;
				ДоЗапятой = 1;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(ДоЗапятой) Или Не ЗначениеЗаполнено(Число) Тогда 
			СтрокаВОбластиМакета("", ПрефиксПараметра, ПечатнаяФорма, КонтекстПечати);
		Иначе
			Остаток = (Число - ЦелЧисло);
			Остаток = ?(Остаток < 0, -1*Остаток, Остаток);
			ДЧ = "";
			Пока ЗначениеЗаполнено(Остаток - Цел(Остаток)) И СтрДлина(ДЧ) < ПослеЗапятой Цикл 
				Остаток = Остаток * 10;
				ДЧ = ДЧ + Формат(Цел(Остаток), "ЧЦ=1; ЧН=0");
				Остаток = (Остаток - Цел(Остаток));
				Остаток = ?(Остаток < 0, -1*Остаток, Остаток);
			КонецЦикла;
			Строка = Лев(Формат(ЦелЧисло, "ЧН=0; ЧГ=") + КонтекстПечати["ОстатокСтрокиЧисло"], ДоЗапятой) 
				+ Лев(ДЧ + КонтекстПечати["ОстатокСтрокиЧисло"], ПослеЗапятой);
			СтрокаВОбластиМакета(Строка, ПрефиксПараметра, ПечатнаяФорма, КонтекстПечати);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ДатаВОбластиМакета(Дата, ПрефиксПараметра, ПечатнаяФорма, КонтекстПечати)
	СтрокаВОбластиМакета(Формат(Дата, КонтекстПечати["ФорматДатыПоУмолчанию"]), ПрефиксПараметра, ПечатнаяФорма, КонтекстПечати);
КонецПроцедуры

Процедура СтрокаВОбластиМакета(Строка, ПрефиксПараметра, ПечатнаяФорма, КонтекстПечати)
	СтрокаКПечати = Строка + КонтекстПечати["ОстатокСтроки"];
	
	Индекс = 0;
	ПрПарам = ПрефиксПараметра + "_";
	Пока Истина Цикл 
		Индекс = Индекс + 1;
		Обл = ПечатнаяФорма.Области.Найти(ПрПарам + Индекс);
		Если Обл = Неопределено Тогда 
			Прервать;
		КонецЕсли;
		Обл.Текст = Сред(СтрокаКПечати, Индекс, 1);
	КонецЦикла;
КонецПроцедуры

Процедура ПоложитьПФВСписокЛистов(Листы, ПечатнаяФорма, Наименование, КонтекстПечати) Экспорт 
	Если КонтекстПечати.Автонумерация Тогда 
		СтрокаВОбластиМакета(Прав("000" + Формат(Листы.Количество() + 1, "ЧГ="), 3), "НомСтр", ПечатнаяФорма, КонтекстПечати);
	КонецЕсли;
	
	Лист = Новый Массив;
	Лист.Добавить(ПоместитьВоВременноеХранилище(ПечатнаяФорма, Новый УникальныйИдентификатор));
	Лист.Добавить(Новый УникальныйИдентификатор);
	Лист.Добавить(Наименование);
	Листы.Добавить(Лист, Наименование);
КонецПроцедуры

Функция БлокЗаполнен(Данные, Показатели) Экспорт 
	БлокЗаполнен = Ложь;
	Для Каждого Поле Из СтрРазделить(Показатели, ",", Ложь) Цикл 
		Если Данные.Свойство(Поле) Тогда 
			БлокЗаполнен = БлокЗаполнен Или ЗначениеЗаполнено(Данные[Поле]);
		КонецЕсли;
	КонецЦикла;
	Возврат БлокЗаполнен;
КонецФункции

Функция КонтекстПечатиДекларацииПоУмолчанию() Экспорт 
	КонтекстПечати = Новый Структура;
	КонтекстПечати.Вставить("ОТС", Новый ОписаниеТипов("Строка"));
	КонтекстПечати.Вставить("СимволПоУмолчанию", "-");
	КонтекстПечати.Вставить("ФорматДатыПоУмолчанию", "ДФ=ddMMyyyy");
	КонтекстПечати.Вставить("Автонумерация", Истина);
	
	ОстатокСтроки = КонтекстПечати["СимволПоУмолчанию"];
	Для Инд = 1 По 600 Цикл 
		ОстатокСтроки = ОстатокСтроки + КонтекстПечати["СимволПоУмолчанию"];
	КонецЦикла;
	
	КонтекстПечати.Вставить("ОстатокСтроки", ОстатокСтроки);
	КонтекстПечати.Вставить("ОстатокСтрокиЧисло", Лев(ОстатокСтроки, 20));
	Возврат КонтекстПечати;
КонецФункции

#КонецОбласти

#Область ПредложениеКонвертацииОтчетаПриОткрытии

Процедура ФормированиеДанныхПоАктуальностиФормы(Форма, КонтролирующийОрган = "ФНС") Экспорт 
	СвойстваФормы = Новый Структура("СтруктураРеквизитовФормы");
	ЗаполнитьЗначенияСвойств(СвойстваФормы, Форма);
	Если ТипЗнч(СвойстваФормы.СтруктураРеквизитовФормы) <> Тип("Структура") Тогда 
		Возврат;
	КонецЕсли;
	
	Форма.СтруктураРеквизитовФормы.КонвертацияИзФормыОнлайнБлокировок = 
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "КонвертацияИзФормыОнлайнБлокировок", Ложь);
	
	СохраненныйДок = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СвойстваФормы.СтруктураРеквизитовФормы, "мСохраненныйДок");
	Если ТипЗнч(СохраненныйДок) <> Тип("ДокументСсылка.РегламентированныйОтчет") Или НЕ ЗначениеЗаполнено(СохраненныйДок)
		Или ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СвойстваФормы.СтруктураРеквизитовФормы, "ЗаблокированоВДругомСеансе", Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СохраненныйДок,
		"Организация,ДатаНачала,ДатаОкончания,ВыбраннаяФорма,ИсточникОтчета");
	СтатусОтправки = Неопределено;
	СостояниеСдачиОтчетности = Неопределено;
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОпределитьСтатусИСостояниеСдачиОтчетности(
		СохраненныйДок, РеквизитыДокумента.Организация, КонтролирующийОрган, СостояниеСдачиОтчетности, СтатусОтправки);
		
	СтатусОтправкиВЖурнале = СохраненныйСтатусОтправкиРеглОтчета(СохраненныйДок);
	Если СтатусОтправки <> ИнтерфейсыВзаимодействияБРОКлиентСервер.СтатусВРаботеСтрокой() 
		Или СостояниеСдачиОтчетности <> Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат Тогда 
		Возврат;
	КонецЕсли;
	
	МенеджерОтчета = ?(СтрНачинаетсяС(НРег(Форма.ИмяФормы), "внешний"),
		РегламентированнаяОтчетностьВызовСервера.ОбъектОтчета(Форма.ИмяФормы), Отчеты[РеквизитыДокумента.ИсточникОтчета]);
	ТаблицаФормОтчета = МенеджерОтчета.ТаблицаФормОтчета();
	
	ФормаАктуальна = Ложь;
	Для Каждого Стр Из ТаблицаФормОтчета.НайтиСтроки(Новый Структура("ФормаОтчета", РеквизитыДокумента.ВыбраннаяФорма)) Цикл 
		Если НачалоДня(Стр.ДатаНачалоДействия) <= РеквизитыДокумента.ДатаНачала 
			И (КонецДня(Стр.ДатаКонецДействия) >= РеквизитыДокумента.ДатаОкончания Или Не ЗначениеЗаполнено(Стр.ДатаКонецДействия)) Тогда 
			ФормаАктуальна = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ФормаАктуальна Тогда 
		Возврат;
	КонецЕсли;
	
	ФормыСМеханизмомКонвертации = МенеджерОтчета.СписокФормСМеханизмомКонвертации();
	АктуальныеФормы = Новый Массив;
	Для Каждого Стр Из ТаблицаФормОтчета Цикл 
		Если НачалоДня(Стр.ДатаНачалоДействия) <= РеквизитыДокумента.ДатаНачала 
			И (КонецДня(Стр.ДатаКонецДействия) >= РеквизитыДокумента.ДатаОкончания Или Не ЗначениеЗаполнено(Стр.ДатаКонецДействия)) Тогда 
			
			Форма.СтруктураРеквизитовФормы.АктуальныеФормы.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Стр));
			АктуальныеФормы.Добавить(Стр.ФормаОтчета);
			Если ФормыСМеханизмомКонвертации.Найти(Стр.ФормаОтчета) <> Неопределено Тогда 
				Форма.СтруктураРеквизитовФормы.ДоступныеДляКонвертацииФормы.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Стр))
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Форма.СтруктураРеквизитовФормы.ДоступныеДляКонвертацииФормы) 
		И Не ЗначениеЗаполнено(Форма.СтруктураРеквизитовФормы.АктуальныеФормы) Тогда 
		Возврат;
	КонецЕсли;
	
	Форма.СтруктураРеквизитовФормы.ЕстьАктуальныеФормы = НаличиеАктуальныхФорм(РеквизитыДокумента, АктуальныеФормы);
	Форма.СтруктураРеквизитовФормы.ПредлагатьКонвертацию = ЗначениеЗаполнено(Форма.СтруктураРеквизитовФормы.ДоступныеДляКонвертацииФормы);
КонецПроцедуры

Функция ЗапросАктуальныхФорм(РеквизитыДокумента, АктуальныеФормы) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегламентированныйОтчет.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РегламентированныйОтчет КАК РегламентированныйОтчет
	|ГДЕ
	|	РегламентированныйОтчет.Организация = &Организация
	|	И РегламентированныйОтчет.ДатаНачала = &ДатаНачала
	|	И РегламентированныйОтчет.ДатаОкончания = &ДатаОкончания
	|	И РегламентированныйОтчет.ИсточникОтчета = &ИсточникОтчета
	|	И РегламентированныйОтчет.ВыбраннаяФорма В(&АктуальныеФормы)";
	
	Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("ДатаНачала", РеквизитыДокумента.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", РеквизитыДокумента.ДатаОкончания);
	Запрос.УстановитьПараметр("ИсточникОтчета", РеквизитыДокумента.ИсточникОтчета);
	Запрос.УстановитьПараметр("АктуальныеФормы", АктуальныеФормы);
	Возврат Запрос;
КонецФункции

Функция НаличиеАктуальныхФорм(РеквизитыДокумента, АктуальныеФормы)
	Запрос = ЗапросАктуальныхФорм(РеквизитыДокумента, АктуальныеФормы);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

Процедура СозданиеСтандартныхРеквизитовОсновнойФормы(Форма) Экспорт 
	ОписаниеТиповБулево = Новый ОписаниеТипов("Булево");
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КонвертацияИзФормыОнлайнБлокировок", ОписаниеТиповБулево));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Форма["КонвертацияИзФормыОнлайнБлокировок"] = 
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "КонвертацияИзФормыОнлайнБлокировок", Ложь);
КонецПроцедуры

