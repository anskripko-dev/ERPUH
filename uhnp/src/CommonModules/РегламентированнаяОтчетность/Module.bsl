// Функция выполняет сопоставление кодов ОКУД статистических отчетов
// и назначенных Росстатом требований
//
// Параметры:
//  МассивОКУД - Массив - массив ОКУД статистических отчетов (7 знаков)
//
// Возвращаемое значение:
//  Неопределено, ТаблицаЗначений - Требования росстата по ОКУД:
// * ОКУД - строка - запрошенный код ОКУД из параметра 
// * Требования - массив - идентификаторы правил списка задач
//                (см. РегламентированнаяОтчетностьПовтИсп.ИсполнителиТребованийРосстата())
Функция ТребованияРосстатаПоОКУД(МассивОКУД) Экспорт
	
	// Необходимо установить соответствие между кодом ОКУД формы Росстата и конкретными правилами списка задач (требованиями),
	// которые определяют периодичность и сроки сдачи этой формы. По одноЙ форме (коду ОКУД) может быть несколько правил,
	// т.к. для разных групп респондентов форма может быть одна, но периодичность ее сдачи разная. Поэтому и правил,
	// связанных с одной формой, может быть несколько.
	// 
	// Алгоритм получения соответствия следующий:
	// Шаг 1.Получить соответствие правила и регл. отчета (исполнителя правила)
	// Шаг 2 По каждому регл. отчету из шага 1 определить ОКУД этого отчета. К найденному ОКУД в таблице результата
	//       дописать правило с шага 1:
	//   Шаг 2.1 Определить ОКУД через метод модуля менеджера регл. отчета.
	//   Шаг 2.2 По найденному ОКУД находим строку результирующей таблицы
	//   Шаг 2.3 Добавляем в требования по данному ОКУД правило из соответствия с шага 1
	// Шаг 3 Дополнить результат данными прямого сопоставления - на тот случай, если отчет не реализован в конфигурации,
	//       а правило (требование) есть
	
	Если Не ЗначениеЗаполнено(МассивОКУД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТЗРезультат = Новый ТаблицаЗначений;
	ТЗРезультат.Колонки.Добавить("ОКУД");
	ТЗРезультат.Колонки.Добавить("Требования"); // массив
	
	Для Каждого ОКУД Из МассивОКУД Цикл
		СтрокаРезультата = ТЗРезультат.Добавить();
		СтрокаРезультата.ОКУД = ОКУД;
		СтрокаРезультата.Требования = Новый Массив;
	КонецЦикла;
	
	// Шаг 1
	ИсполнителиТребований = РегламентированнаяОтчетностьПовтИсп.ИсполнителиТребованийРосстата();
	
	ТЗИсполнителиТребований = Новый ТаблицаЗначений;
	ТЗИсполнителиТребований.Колонки.Добавить("ИДОтчета");
	ТЗИсполнителиТребований.Колонки.Добавить("Требование");
	
	Для Каждого КлючИЗначение Из ИсполнителиТребований Цикл
		НовСтр = ТЗИсполнителиТребований.Добавить();
		НовСтр.ИДОтчета   = КлючИЗначение.Значение;
		НовСтр.Требование = КлючИЗначение.Ключ;
	КонецЦикла;
	
	// Шаг 2
	ТЗОтчеты = ТЗИсполнителиТребований.Скопировать();
	ТЗОтчеты.Свернуть("ИДОтчета");
	
	Для Каждого Отчет Из ТЗОтчеты Цикл
		
		ИмяОтчета = Отчет.ИДОтчета;
		
		Если Метаданные.Отчеты.Найти(ИмяОтчета) <> Неопределено Тогда
			
			ОКУДыОтчета = Новый ТаблицаЗначений;
			ОКУДыОтчета.Колонки.Добавить("ОКУД");
			
			// Шаг 2.1
			Для Каждого СтрДФ Из Отчеты[ИмяОтчета].ДеревоФормИФорматов().Строки Цикл
				НовСтр = ОКУДыОтчета.Добавить();
				НовСтр.ОКУД = ?(СтрДлина(СтрДФ.Код) = 6, "0" + СтрДФ.Код, СтрДФ.Код);
			КонецЦикла;
			
			ОКУДыОтчета.Свернуть("ОКУД");
			
			Для Каждого ОКУДОтчета Из ОКУДыОтчета Цикл
				
				// Шаг 2.2
				СтрокаРезультата = ТЗРезультат.Найти(ОКУДОтчета.ОКУД, "ОКУД");
				Если СтрокаРезультата = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				// Шаг 2.3
				НайденныеСтроки = ТЗИсполнителиТребований.НайтиСтроки(Новый Структура("ИДОтчета", ИмяОтчета));
				Для Каждого СтрокаТребования Из НайденныеСтроки Цикл
					Если СтрокаРезультата.Требования.Найти(СтрокаТребования.Требование) = Неопределено Тогда
						СтрокаРезультата.Требования.Добавить(СтрокаТребования.Требование);
					КонецЕсли;
				КонецЦикла;
					
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Шаг 3
	Для Каждого ТребованияПоОКУД Из РегламентированнаяОтчетностьПовтИсп.НеподдерживаемыеТребованияРосстата() Цикл
		СтрокаРезультата = ТЗРезультат.Найти(ТребованияПоОКУД.Ключ, "ОКУД");
		Если СтрокаРезультата = Неопределено Или СтрокаРезультата.Требования.Количество() > 0 Тогда
			// Не требуется или уже заполнена по данным отчета-исполнителя требования
			Продолжить;
		КонецЕсли;
		СтрокаРезультата.Требования = ТребованияПоОКУД.Значение;
	КонецЦикла;
	
	Возврат ТЗРезультат;
	
КонецФункции

