// Возвращает все строки дерева значений на всех уровнях подчиненности для итеративной обработки.
// 
// Параметры:
//  ИсходноеДеревоЗначений - ДеревоЗначений
// 
// Возвращаемое значение:
//  Массив Из СтрокаДереваЗначений
// 
Функция ВсеСтрокиДереваЗначений(ИсходноеДеревоЗначений) Экспорт
	
	Строки = Новый Массив();
	
	ОчередьОбхода = Новый Массив();
	ОчередьОбхода.Добавить(ИсходноеДеревоЗначений);
	
	Пока ОчередьОбхода.Количество() > 0 Цикл
		УзелДерева = ОчередьОбхода[0];
		ОчередьОбхода.Удалить(0);
		Для Каждого СтрокаДерева Из УзелДерева.Строки Цикл
			Строки.Добавить(СтрокаДерева);
			ОчередьОбхода.Добавить(СтрокаДерева);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

