Функция ОбщаяЧастьСсылкиНаИзмененияЗаконодательства(ИсточникОтчета) Экспорт
	
	Перем УИДКонфигурации;
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("ИсточникОтчета", ИсточникОтчета);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РегламентированныеОтчеты.УИДОтчета КАК УИДОтчета
		|ИЗ
		|	Справочник.РегламентированныеОтчеты КАК РегламентированныеОтчеты
		|ГДЕ
		|	РегламентированныеОтчеты.ИсточникОтчета = &ИсточникОтчета";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РегламентированнаяОтчетностьПереопределяемый.ПолучитьУИДКонфигурации(УИДКонфигурации);
		ОбщаяЧастьСсылкиНаИзмененияЗаконодательства = СтрШаблон(
			"https://v8.1c.ru/lawmonitor/?reg-report-form=%1&only-report=Y&user-configuration=%2",
			Выборка.УИДОтчета, УИДКонфигурации);
	Иначе
		ОбщаяЧастьСсылкиНаИзмененияЗаконодательства = "";
	КонецЕсли;
	
	Возврат ОбщаяЧастьСсылкиНаИзмененияЗаконодательства;
	
КонецФункции

Функция ПредставлениеСсылкиИзмененияЗаконодательства() Экспорт
	
	Возврат НСтр("ru = 'Изменения законодательства';
				|en = 'Legislation changes'");
	
КонецФункции

Функция АдресВXML(КонтактнаяИнформация, ВидАдреса) Экспорт
	
	Данные = Новый Структура("Тип, Вид", Перечисления.ТипыКонтактнойИнформации.Адрес, ВидАдреса);
	
	Результат = КонтактнаяИнформация.НайтиСтроки(Данные);
	
	Если Результат.Количество() > 0 Тогда
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(Результат[0].ЗначенияПолей, Результат[0].Представление, ВидАдреса);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возращает код тарифа или размер тарифа страховых взносов в процентах по коду категории и отчетному году.
//
// Параметры:
//  КодКатегории - Строка - код из приложения № 8 - Приказ ФНС России от 10.10.2016 N ММВ-7-11/551@
//                          "Об утверждении формы расчета по страховым взносам, порядка его заполнения,
//                          а также формата представления расчета по страховым взносам в электронной форме".
//  ОтчетныйГод - Число - четырехзначное число, соответствующее отчетному году.
//  ВернутьРазмерТарифа - Булево - если "Истина", то возвращается размер тарифа в процентах, иначе - код тарифа.
//
// Возвращаемое значение:
//  Строка, Число, Неопределено - код тарифа("Строка"), размер тарифа ("Число"),"Неопределено" - в случаях,
//                                если: соответствие коду категории не найдено, ошибка, функционал не определен.
//
Функция КодИлиРазмерТарифаПоКодуКатегории(КодКатегории, ОтчетныйГод, ВернутьРазмерТарифа = Ложь) Экспорт
	
	КодИлиРазмерТарифа = Неопределено;
	
	Попытка
		
		РегламентированнаяОтчетностьПереопределяемый.ПолучитьКодИлиРазмерТарифаПоКодуКатегории(
			КодКатегории, ОтчетныйГод, КодИлиРазмерТарифа, ВернутьРазмерТарифа);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
			?(ВернутьРазмерТарифа,
				НСтр("ru = 'Получение размера тарифа СВ в процентах по коду категории';
					|en = 'Receive IC tariff amount in percent by category code'"),
				НСтр("ru = 'Получение кода тарифа СВ по коду категории';
					|en = 'Receive IC tariff code by category code'")),
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	Возврат КодИлиРазмерТарифа;
	
КонецФункции

// Возращает размер дополнительного тарифа страховых взносов в процентах по его коду и отчетному году.
//
// Параметры:
//  КодТарифа - Строка - код из приложения № 5 (с 21-го по 27-й) - Приказ ФНС России от 10.10.2016 N ММВ-7-11/551@
//                       "Об утверждении формы расчета по страховым взносам, порядка его заполнения,
//                       а также формата представления расчета по страховым взносам в электронной форме".
//  ОтчетныйГод - Число - четырехзначное число, соответствующее отчетному году.
//
// Возвращаемое значение:
//  Число, Неопределено - размер тарифа ("Число"),"Неопределено" - в случае, если соответствие коду тарифа не найдено.
//
Функция РазмерДополнительногоТарифаПоКоду(КодТарифа, ОтчетныйГод) Экспорт
	
	Если ОтчетныйГод < 2017 Тогда
		Возврат 0;
	КонецЕсли;
	
	СоответствиеЗначенияТарифаИКода = Новый Соответствие;
	СоответствиеЗначенияТарифаИКода.Вставить("21", 9.00);
	СоответствиеЗначенияТарифаИКода.Вставить("22", 6.00);
	СоответствиеЗначенияТарифаИКода.Вставить("23", 8.00);
	СоответствиеЗначенияТарифаИКода.Вставить("24", 7.00);
	СоответствиеЗначенияТарифаИКода.Вставить("25", 6.00);
	СоответствиеЗначенияТарифаИКода.Вставить("26", 4.00);
	СоответствиеЗначенияТарифаИКода.Вставить("27", 2.00);
	
	Возврат СоответствиеЗначенияТарифаИКода[КодТарифа];
	
КонецФункции

Процедура УдалитьСигнатуруBOM(ФайлВыгрузки) Экспорт
	
	Если ТипЗнч(ФайлВыгрузки) <> Тип("ДвоичныеДанные") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВыгрузки64 = Base64Строка(ФайлВыгрузки);
	Если Лев(ТекстВыгрузки64, 4) = "77u/" Тогда
		ТекстВыгрузки64 = Сред(ТекстВыгрузки64, 5);
		ФайлВыгрузки = Base64Значение(ТекстВыгрузки64);
	КонецЕсли;
	
КонецПроцедуры

Функция ПризнакиВключения(РазделыОтчета)
	
	Признаки = Новый ДеревоЗначений;
	Признаки.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Признаки.Колонки.Добавить("Название", Новый ОписаниеТипов("Строка"));
	Признаки.Колонки.Добавить("ВключенВОтчет", Новый ОписаниеТипов("Булево"));
	
	ДобавитьПризнакиВключенияРазделов(РазделыОтчета, Признаки);
	
	Возврат Признаки;
	
КонецФункции

Процедура ДобавитьПризнакиВключенияРазделов(РазделыОтчета, Признаки)
	
	Для Каждого ОписаниеРаздела Из РазделыОтчета.Строки Цикл
		СтрокаПризнака = Признаки.Строки.Добавить();
		СтрокаПризнака.Идентификатор = ОписаниеРаздела.ИмяСтраницы;
		СтрокаПризнака.Название = ОписаниеРаздела.Представление;
		СтрокаПризнака.ВключенВОтчет = (ОписаниеРаздела.ПоказатьСтраницу = 1);
		
		Если ОписаниеРаздела.Строки.Количество() <> 0 Тогда
			ДобавитьПризнакиВключенияРазделов(ОписаниеРаздела, СтрокаПризнака);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьПризнакиВключения(РазделыОтчета, ПризнакиВключения)
	
	Для Каждого СтрокаПризнака Из ПризнакиВключения.Строки Цикл
		ОписаниеРаздела = РазделыОтчета.Строки.Найти(СтрокаПризнака.Идентификатор, "ИмяСтраницы");
		Если ОписаниеРаздела <> Неопределено Тогда
			ОписаниеРаздела.ПоказатьСтраницу = ?(СтрокаПризнака.ВключенВОтчет, 1, 0);
			
			Если СтрокаПризнака.Строки.Количество() <> 0 Тогда
				ИзменитьПризнакиВключения(ОписаниеРаздела, СтрокаПризнака)
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОтображаетсяРазделДопФайловБухотчетности(ФормаВПриложении) Экспорт
	
	Результат =  Ложь;
	
	Для Каждого СтрокаУровня1 Из ФормаВПриложении.мДеревоВыбранныхСтраниц.ПолучитьЭлементы() Цикл
		ЭтоЗакладкаДополнительныхФайлов = (СтрокаУровня1.ИмяСтраницы = "ДополнительныеФайлы");
		Если НЕ ЭтоЗакладкаДополнительныхФайлов Тогда
			Продолжить;
		КонецЕсли;
		
		Пометка = СтрокаУровня1.ПоказатьСтраницу;
		Результат = (Пометка = 1);
		Прервать;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура СпрятатьЭлемент(ЭлементыФормы, ИмяЭлемента)
	Элемент = ЭлементыФормы.Найти(ИмяЭлемента);
	Если Не Элемент = Неопределено Тогда 
		Элемент.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьНадписьВыгрузкаНедоступна(Форма)
	
	НовыйЭлемент = Форма.Элементы.Добавить("НадписьВыгрузкаНедоступна", Тип("ДекорацияФормы"));
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Возможность выгрузки, отправки, проверки контрольных соотношений будет доступна после публикации Росстатом шаблона электронного представления";
	НовыйЭлемент.ЦветТекста = Новый Цвет(255, 0, 0);
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	
	МестоРасположения = ?(Форма.Элементы.Найти("ГруппаПанельОтправки") <> Неопределено,
						  Форма.Элементы.Найти("ГруппаПанельОтправки"),
						  Форма.Элементы.Найти("Отчет"));
	
	Если МестоРасположения = Неопределено Тогда
		Форма.Элементы.Переместить(НовыйЭлемент, Форма);
	Иначе
		Форма.Элементы.Переместить(НовыйЭлемент, Форма, МестоРасположения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВерсиюФорматаВыгрузки(Форма) Экспорт
	
	Перем ВерсияФорматаВыгрузки;
	
	Разложение = СтрРазделить(Форма.ИмяФормы, ".");
	мОбъектОтчета = РегламентированнаяОтчетностьВызовСервера.ОбъектОтчета(Форма.ИмяФормы);
	Если СтрНайти(Форма.ИмяФормы, "Внешний") <> 0 Тогда 
		ВерсияФорматаВыгрузки = мОбъектОтчета.ВерсияФорматаВыгрузки(
			Форма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, Разложение[3]);
	Иначе
		ВерсияФорматаВыгрузки = Отчеты[Разложение[1]].ВерсияФорматаВыгрузки(
			Форма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, Разложение[3]);
	КонецЕсли;
	
	Макеты = мОбъектОтчета.Метаданные().Макеты;
	Макет = "";
	Если (Форма.СтруктураРеквизитовФормы.Свойство("ИмяМакетаСхемыВыгрузки", Макет) И Макеты.Найти(Макет) = Неопределено)
		Или (Форма.СтруктураРеквизитовФормы.Свойство("ИмяМакетаАтрибутовВыгрузки", Макет) И Макеты.Найти(Макет) = Неопределено)
		Или (Форма.СтруктураРеквизитовФормы.Свойство("ИмяМакетаШаблона", Макет) И Макеты.Найти(Макет) = Неопределено) Тогда
		ВерсияФорматаВыгрузки = Неопределено;
	КонецЕсли;
	
	//В случае принудительно установленного запрета выгрузки в макете
	Если Форма.СтруктураРеквизитовФормы.Свойство("ИмяМакетаАтрибутовВыгрузки", Макет) И Макеты.Найти(Макет) <> Неопределено Тогда
		ДопАтрибуты = СформироватьСтруктуруДопАтрибутов(Форма.ИмяФормы, Макет);
		Если УстановленЗапретВыгрузкиВМакетеАтрибутов(ДопАтрибуты) Тогда
			ВерсияФорматаВыгрузки = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВерсияФорматаВыгрузки;
	
КонецФункции

Функция УстановленЗапретВыгрузкиВМакетеАтрибутов(ДопАтрибуты) Экспорт
	
	Выгрузка = "";
	УстановленЗапрет = Ложь;
	
	Если ДопАтрибуты.Свойство("upload", Выгрузка) И Выгрузка = "false" Тогда
		УстановленЗапрет = Истина;
	КонецЕсли;
	
	Возврат УстановленЗапрет;
	
КонецФункции

Процедура БлокировкаКнопокПриОтстутствииФорматаРосстата(Форма) Экспорт
	
	ВерсияФорматаВыгрузки = ПолучитьВерсиюФорматаВыгрузки(Форма);
	
	Если ВерсияФорматаВыгрузки <> Перечисления.ВерсииФорматовВыгрузки.ВерсияФСГС Тогда 
		СпрятатьЭлемент(Форма.Элементы, "ФормаПроверитьКонтрольныеСоотношенияИзШаблона");
		СпрятатьЭлемент(Форма.Элементы, "ПроверитьВыгрузку");
		СпрятатьЭлемент(Форма.Элементы, "ПроверитьВИнтернете");
		СпрятатьЭлемент(Форма.Элементы, "ОтправитьЧерезПредставителя");
		СпрятатьЭлемент(Форма.Элементы, "ОтправитьВКонтролирующийОрган");
		СпрятатьЭлемент(Форма.Элементы, "Выгрузить");
		СпрятатьЭлемент(Форма.Элементы, "Загрузить");
		СпрятатьЭлемент(Форма.Элементы, "Сравнить");
		
		СпрятатьЭлемент(Форма.Элементы, "Проверка");
		СпрятатьЭлемент(Форма.Элементы, "Отправка");
		
		ДобавитьНадписьВыгрузкаНедоступна(Форма);
	КонецЕсли;
КонецПроцедуры

Функция ВидимостьОбластиДанныеПредыдущегоПериода(Форма, ИмяТД = "ПолеТабличногоДокументаФормаОтчета") Экспорт
	
	Если ПолучитьВерсиюФорматаВыгрузки(Форма) = Неопределено Тогда
		
		ТабДок = Форма[ИмяТД];
		ОблДанные = ТабДок.Области.Найти("ДанныеПредыдущегоПериода");
		Если ОблДанные <> Неопределено Тогда
			ТабДок.УдалитьОбласть(ОблДанные, ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Добавляет строки в структуру многострочных частей бухгалтерской отчетности.
// 
// Параметры:
//   Параметры - см. РегламентированнаяОтчетность.ПараметрыДополненияСтруктурыМногострочныхЧастей;
//   СтруктураМногострочныхЧастей - Структура - состав многострочных частей бухгалтерской отчетности.
//
Процедура ДополнитьСтруктуруМногострочныхЧастей(Параметры, СтруктураМногострочныхЧастей) Экспорт
	
	РегламентированнаяОтчетностьПереопределяемый.ДополнитьСтруктуруМногострочныхЧастей(
		Параметры, СтруктураМногострочныхЧастей);
	
КонецПроцедуры

// Конструктор параметров процеруры РегламентированнаяОтчетность.ДополнитьСтруктуруМногострочныхЧастей.
// 
// Возвращаемое значение:
//   Структура:
//     * Организация - СправочникСсылка.Организации -
//     * ГруппаОрганизаций - СписокЗначений из СправочникСсылка.Организации -
//     * мДатаНачалаПериодаОтчета - Дата -
//     * мДатаКонцаПериодаОтчета - Дата -
//
Функция ПараметрыДополненияСтруктурыМногострочныхЧастей() Экспорт
	
	Параметры = Новый Структура();
	Параметры.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Параметры.Вставить("ГруппаОрганизаций", Новый СписокЗначений());
	Параметры.Вставить("мДатаНачалаПериодаОтчета", '0001-01-01');
	Параметры.Вставить("мДатаКонцаПериодаОтчета", '0001-01-01');
	
	Возврат Параметры;
	
КонецФункции

Функция АдресВJSON(КонтактнаяИнформация, ВидАдреса) Экспорт
	
	Данные = Новый Структура("Тип, Вид", Перечисления.ТипыКонтактнойИнформации.Адрес, ВидАдреса);
	
	Результат = КонтактнаяИнформация.НайтиСтроки(Данные);
	
	Если Результат.Количество() > 0 Тогда
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВJSON(Результат[0].ЗначенияПолей, ВидАдреса);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Конструктор дерева форм и форматов регламентированного отчета, используемого в механизмах онлайн-блокировки.
//
// Возвращаемое значение:
//  ДеревоЗначений:
//    * Код - Строка
//    * ДатаПриказа - Дата
//    * НомерПриказа - Строка
//    * ДатаНачалаДействия - Дата
//    * ДатаОкончанияДействия - Дата
//    * ИмяОбъекта - Строка
//    * Описание - Строка
//
Функция НовоеДеревоФормИФорматов() Экспорт
	
	ФормыИФорматы = Новый ДеревоЗначений;
	ФормыИФорматы.Колонки.Добавить("Код",                   Новый ОписаниеТипов("Строка"));
	ФормыИФорматы.Колонки.Добавить("ДатаПриказа",           Новый ОписаниеТипов("Дата"));
	ФормыИФорматы.Колонки.Добавить("НомерПриказа",          Новый ОписаниеТипов("Строка"));
	ФормыИФорматы.Колонки.Добавить("ДатаНачалаДействия",    Новый ОписаниеТипов("Дата"));
	ФормыИФорматы.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	ФормыИФорматы.Колонки.Добавить("ИмяОбъекта",            Новый ОписаниеТипов("Строка"));
	ФормыИФорматы.Колонки.Добавить("Описание",              Новый ОписаниеТипов("Строка"));
	
	Возврат ФормыИФорматы;
	
КонецФункции

Функция ВывестиПоказательМинпромторгВXML(Узел, ЗначениеПоказателя, ФорматПредставленияНуля = "") Экспорт 
	
	МинШирина = Узел.МинРазмерность;
	МаксШирина = Узел.МаксРазмерность;
	
	Если Узел.Формат = "T" ИЛИ Узел.Формат = "Т" Тогда      // учтем оба варианта: кириллицу и латиницу
		Если ЗначениеЗаполнено(ЗначениеПоказателя) Тогда
			Если МинШирина = 10 И МаксШирина = 10 И ТипЗнч(ЗначениеПоказателя) = Тип("Дата") Тогда 
				Узел.Значение = Формат(ЗначениеПоказателя, "ДФ=yyyy-MM-dd");
			Иначе 
				Узел.Значение = ?(МаксШирина < СтрДлина(СокрЛП(ЗначениеПоказателя)), СокрЛП(Лев(СокрЛП(ЗначениеПоказателя), МаксШирина)), СокрЛП(ЗначениеПоказателя));
			КонецЕсли;
		Иначе
			Узел.Значение = Неопределено;
		КонецЕсли;  
		
	ИначеЕсли Узел.Формат = "Д" Тогда      
		Если ЗначениеЗаполнено(ЗначениеПоказателя) Тогда
			Если МинШирина = 10 И МаксШирина = 10 И ТипЗнч(ЗначениеПоказателя) = Тип("Дата") Тогда 
				Узел.Значение = Формат(ЗначениеПоказателя, "ДФ=yyyy-MM-dd");
			Иначе 
				Узел.Значение = ?(МаксШирина < СтрДлина(СокрЛП(ЗначениеПоказателя)), СокрЛП(Лев(СокрЛП(ЗначениеПоказателя), МаксШирина)), СокрЛП(ЗначениеПоказателя));
			КонецЕсли;
		Иначе
			Узел.Значение = Неопределено;
		КонецЕсли;

	ИначеЕсли Узел.Формат = "B" ИЛИ Узел.Формат = "В" Тогда // учтем оба варианта: кириллицу и латиницу
		Если ЗначениеЗаполнено(ЗначениеПоказателя) Тогда
			Узел.Значение = ?(ТипЗнч(ЗначениеПоказателя) = Тип("Строка"), СокрЛП(ЗначениеПоказателя), ?(Булево(0 + ЗначениеПоказателя), "true", "false"));
		Иначе
			Узел.Значение = Неопределено;
		КонецЕсли;
	ИначеЕсли Узел.Формат = "N" Тогда
		СтрокаФормата = "ЧРД=.;ЧН=0;ЧГ=;";
		Если Узел.МаксРазмерность <> 0 И Узел.МаксРазмерность <> 99999 Тогда
			СтрокаФормата = СтрокаФормата + "ЧЦ=" + Формат(Узел.МаксРазмерность, "ЧГ=") + ";";
		КонецЕсли;
		Если Узел.МинРазмерность <> 99999 Тогда
			СтрокаФормата = СтрокаФормата + "ЧДЦ=" + Формат(Узел.МинРазмерность, "ЧГ=") + ";";
		КонецЕсли;
		Узел.Значение = ЧислоПоФормату(ЗначениеПоказателя, СтрокаФормата, Истина);
		Если СтрНайти(ФорматПредставленияНуля, "ЧН=") > 0 Тогда
			Узел.Показатели = Новый Структура("ЧН" + СокрЛП(Узел.Ключ), ФорматПредставленияНуля);
		КонецЕсли;
	ИначеЕсли Узел.Формат = "gYear" Тогда
		Если ТипЗнч(ЗначениеПоказателя) = Тип("Дата") Тогда
			Если ЗначениеЗаполнено(ЗначениеПоказателя) Тогда
				Узел.Значение = СокрЛП(Формат(ЗначениеПоказателя, "ДФ=гггг"));
			Иначе
				Узел.Значение = Неопределено;
			КонецЕсли;
		Иначе
			Узел.Значение = Прав(СокрЛП(ЗначениеПоказателя), 4);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеИнициализацииПоследнегоОтчета(Организация) Экспорт 
	Результат = Новый Структура();
	Результат.Вставить("IDOrg");
	Результат.Вставить("NaimenovanieSubektaDeyatelnostiVSferePromyshlennostiZnachenie");
	Результат.Вставить("NaimenovanieSubektaDeyatelnostiVSferePromyshlennostiPrimechanie");
	Результат.Вставить("OGRNZnachenie");
	Результат.Вставить("OGRNPrimechanie");
	Результат.Вставить("INNZnachenie");
	Результат.Вставить("INNPrimechanie");
	Результат.Вставить("AdresOficialnogoSajtaZnachenie");
	Результат.Вставить("AdresOficialnogoSajtaiPrimechanie");
	Результат.Вставить("NaimenovanieGolovnojOrganizaciiZnachenie");
	Результат.Вставить("NaimenovanieGolovnojOrganizaciiPrimechanie");
	Результат.Вставить("FakticheskijAdresZnachenie");
	Результат.Вставить("FakticheskijAdresPrimechanie");
	Результат.Вставить("OtraslZnachenie");
	Результат.Вставить("OtraslID");
	Результат.Вставить("OtraslPrimechanie");
	Результат.Вставить("Familiya");
	Результат.Вставить("Imya");
	Результат.Вставить("Otchestvo");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегламентированныйОтчет.ДанныеОтчета КАК ДанныеОтчета,
	|	РегламентированныйОтчет.ДатаПодписи КАК ДатаПодписи
	|ИЗ
	|	Документ.РегламентированныйОтчет КАК РегламентированныйОтчет
	|ГДЕ
	|	РегламентированныйОтчет.Организация = &Организация
	|	И РегламентированныйОтчет.ИсточникОтчета В(&ИсточникОтчета)
	|	И НЕ РегламентированныйОтчет.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПодписи УБЫВ";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИсточникОтчета", РегламентированнаяОтчетностьПовтИсп.ПолучитьОтборДляМинпромторга());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ДанныеОтчета = Выборка.ДанныеОтчета.Получить();
		
		Если Не ДанныеОтчета.Свойство("ПоказателиОтчета")
			Или ТипЗнч(ДанныеОтчета.ПоказателиОтчета) <> Тип("Структура") Тогда 
			
			Возврат Результат;
		КонецЕсли;
		
		Если ДанныеОтчета.ПоказателиОтчета.Свойство("ПолеТабличногоДокументаТитульный")
			И ТипЗнч(ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный) = Тип("Структура") Тогда 
			
			ЗаполнитьЗначенияСвойств(Результат, ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный);
			Возврат Результат;
		КонецЕсли;
		Если ДанныеОтчета.ПоказателиОтчета.Свойство("ПолеТабличногоДокументаФормаОтчета")
			И ТипЗнч(ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаФормаОтчета) = Тип("Структура") Тогда 
			
			ЗаполнитьЗначенияСвойств(Результат, ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаФормаОтчета);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#Область ПолучениеАктуальногоФорматаИзСервисаРосстата

Функция ПолучитьТекущуюТаблицуФорматов() Экспорт 
	Попытка
		ТекущиеНастройки = ХранилищеСистемныхНастроек.Загрузить("РегистрСведений.ШаблоныЭВФОтчетовСтатистики", "ПоследниеРезультаты");
		
		Если ТипЗнч(ТекущиеНастройки) = Тип("Структура") 
			И ТекущиеНастройки.Свойство("Таблица")
			И ТипЗнч(ТекущиеНастройки.Таблица) = Тип("ТаблицаЗначений") 
			И ТекущиеНастройки.Свойство("ДатаВремя")
			И ТипЗнч(ТекущиеНастройки.ДатаВремя) = Тип("Дата") Тогда
			
			Дельта = ТекущаяДатаСеанса() - ТекущиеНастройки.ДатаВремя;
			
			Если (Дельта < 1800) И (Дельта > 0) Тогда
				Возврат ТекущиеНастройки.Таблица;
			КонецЕсли;
		КонецЕсли;
		
		ШаблоныЭВФОтчетовСтатистики = ОбщегоНазначения.ОбщийМодуль("РегистрыСведений.ШаблоныЭВФОтчетовСтатистики");
		Если ШаблоныЭВФОтчетовСтатистики = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		СвойстваМодуля = Неопределено;
		Таблица = ШаблоныЭВФОтчетовСтатистики.СписокШаблоновСервисаВебСбора(СвойстваМодуля, Истина, Ложь, Истина);
		Возврат Таблица;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Процедура ОбновитьШаблоныЧерезВебСервисНаСервере(Контекст, ИмяМакета) Экспорт
	Попытка
		Если СтрНачинаетсяС(Контекст.ИмяФормы, "Внешний") Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(Контекст.УникальныйИдентификатор);
		ПараметрыЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Получение актуальной версии макета через веб-сервис Росстата';
															|en = 'Receive the relevant template version via Russian Federal State Statistics web service'");
		ПараметрыЗапуска.ДополнительныйРезультат = Ложь;
		ПараметрыЗапуска.ОжидатьЗавершение = 0;
		
		ПараметрыВыполнения = Новый Структура("АттрибутыВыгрузки", РегламентированнаяОтчетность.СформироватьСтруктуруДопАтрибутов(Контекст.ИмяФормы, ИмяМакета));
		Результат = ДлительныеОперации.ВыполнитьВФоне("РегламентированнаяОтчетность.ОбновитьШаблоныЧерезВебСервисНаСервереВФоне", ПараметрыВыполнения, ПараметрыЗапуска);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура ОбновитьШаблоныЧерезВебСервисНаСервереВФоне(ПараметрыКоманды, АдресРезультата = Неопределено) Экспорт
	Попытка
		ШаблоныЭВФОтчетовСтатистики = ОбщегоНазначения.ОбщийМодуль("РегистрыСведений.ШаблоныЭВФОтчетовСтатистики");
		АттрибутыВыгрузки = ПараметрыКоманды.АттрибутыВыгрузки;
		ОКУД = "";
		КодШаблона = "";
		ВерсияШаблона = "";
		АттрибутыВыгрузки.Свойство("OKUD", ОКУД);
		АттрибутыВыгрузки.Свойство("code", КодШаблона);
		АттрибутыВыгрузки.Свойство("version", ВерсияШаблона);
		Если Не ЗначениеЗаполнено(КодШаблона) Или Не ЗначениеЗаполнено(ОКУД) Или Не ЗначениеЗаполнено(ВерсияШаблона) Тогда
			Возврат;
		КонецЕсли;
		
		КодШаблонаБезКодаФормы = Лев(КодШаблона, СтрДлина(КодШаблона) - 6) + Прав(КодШаблона, 3);
		
		ТаблицаФорматов = ПолучитьТекущуюТаблицуФорматов();
		ОтобранныеСтроки = ТаблицаФорматов.НайтиСтроки(Новый Структура("ОКУД", ОКУД));
		
		КодыШаблонов = Новый Массив;
		ТФК = ТаблицаФорматов.СкопироватьКолонки();
		Для Каждого СтрокаТаблицыФорматов Из ОтобранныеСтроки Цикл
			ДлинаКодаОтобранногоШаблона = СтрДлина(СтрокаТаблицыФорматов.Код);
			Если ДлинаКодаОтобранногоШаблона = СтрДлина(КодШаблона) И КодШаблонаБезКодаФормы = 
				Лев(СтрокаТаблицыФорматов.Код, ДлинаКодаОтобранногоШаблона - 6) + Прав(СтрокаТаблицыФорматов.Код, 3)
				И ДатаВерсии(СтрокаТаблицыФорматов.Версия) > ДатаВерсии(ВерсияШаблона) Тогда
				
				КодыШаблонов.Добавить(СтрокаТаблицыФорматов.Код);
				ЗаполнитьЗначенияСвойств(ТФК.Добавить(), СтрокаТаблицыФорматов);
			КонецЕсли;
		КонецЦикла;
		
		Если КодыШаблонов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	РАЗНОСТЬДАТ(&ТекущаяДата, ШаблоныЭВФОтчетовСтатистики.ДатаДобавления, СЕКУНДА) КАК РазностьДат
			|ИЗ
			|	РегистрСведений.ШаблоныЭВФОтчетовСтатистики КАК ШаблоныЭВФОтчетовСтатистики
			|ГДЕ
			|	ШаблоныЭВФОтчетовСтатистики.ОКУД = &ОКУД
			|	И ШаблоныЭВФОтчетовСтатистики.КодШаблона В (&КодыШаблонов)
			|УПОРЯДОЧИТЬ ПО
			|	РазностьДат ВОЗР";
		Запрос.УстановитьПараметр("ОКУД", ОКУД);
		Запрос.УстановитьПараметр("КодыШаблонов", КодыШаблонов);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() > 0 И Таблица[0].РазностьДат < 3600 И Таблица[0].РазностьДат > -3600 Тогда
			Возврат;
		КонецЕсли;
		
		АдресВременногоХранилища = ПоместитьВоВременноеХранилище(Неопределено);
		ШаблоныЭВФОтчетовСтатистики.ЗагрузитьШаблоныЧерезСервисВебСбора(Новый Структура("СвойстваШаблонов, ТихийРежим", ТФК, Истина), АдресВременногоХранилища, "");
		ШаблоныЭВФОтчетовСтатистики.ЗагрузитьШаблоны(АдресВременногоХранилища, 0, Истина);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура ОбновитьШаблоныСпискомЧерезВебСервисНаСервереВФоне(ПараметрыКоманды, АдресРезультата = Неопределено) Экспорт
	
	ПоместитьВоВременноеХранилище(Ложь, АдресРезультата);
	
	Попытка
		
		ШаблоныЭВФОтчетовСтатистики = ОбщегоНазначения.ОбщийМодуль("РегистрыСведений.ШаблоныЭВФОтчетовСтатистики");
		
		СписокШаблонов = ПараметрыКоманды.СписокШаблонов;
		Если НЕ ЗначениеЗаполнено(СписокШаблонов)Тогда
			Возврат;
		КонецЕсли;
		
		ТаблицаФорматов = ПолучитьТекущуюТаблицуФорматов();
		Если НЕ ЗначениеЗаполнено(ТаблицаФорматов)Тогда
			Возврат;
		КонецЕсли;
		
		ТаблицаОтобранных = ТаблицаФорматов.СкопироватьКолонки();
		Для Каждого СтрокаТаблицыФорматов Из ТаблицаФорматов Цикл
			Если НЕ СтрНачинаетсяС(СокрЛ(СтрокаТаблицыФорматов.ИмяФормы), "(")
				  И СписокШаблонов.НайтиПоЗначению(СтрокаТаблицыФорматов.ОКУД) <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаОтобранных.Добавить(), СтрокаТаблицыФорматов);
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаОтобранных.Сортировать("ОКУД Возр, Код Убыв, ДатаОбновления Убыв");
		
		КоличествоСтрокВТаблице = ТаблицаОтобранных.Количество();
		Для НомСтроки = 1 По КоличествоСтрокВТаблице Цикл
			Инд = КоличествоСтрокВТаблице - НомСтроки;
			СтрокаТаблицы = ТаблицаОтобранных[Инд];
			Если Инд > 0 Тогда
				Если (СтрокаТаблицы.Код  = ТаблицаОтобранных[Инд - 1].Код
				    И СтрокаТаблицы.ОКУД = ТаблицаОтобранных[Инд - 1].ОКУД)
					ИЛИ НЕ СтрНачинаетсяС(СтрокаТаблицы.Код,
						?(Лев(СтрокаТаблицы.ОКУД, 1) = "0", Сред(СтрокаТаблицы.ОКУД, 2), СтрокаТаблицы.ОКУД)) Тогда
					ТаблицаОтобранных.Удалить(СтрокаТаблицы);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ТаблицаОтобранных)Тогда
			Возврат;
		КонецЕсли;
		
		АдресВременногоХранилища = ПоместитьВоВременноеХранилище(Неопределено);
		ШаблоныЭВФОтчетовСтатистики.ЗагрузитьШаблоныЧерезСервисВебСбора(
			Новый Структура("СвойстваШаблонов, ТихийРежим", ТаблицаОтобранных, Истина), АдресВременногоХранилища, "");
		ШаблоныЭВФОтчетовСтатистики.ЗагрузитьШаблоны(АдресВременногоХранилища, 0, Истина);
		
		ПоместитьВоВременноеХранилище(Истина, АдресРезультата);
		
	Исключение
		
		ОписаниеОшибки = ИнформацияОбОшибке().Описание;
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Получение списка XML-шаблонов через веб-сервис Росстата';
										|en = 'Retrieving a XML templates list through the Rosstat web service'"),
			УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ИзменитьВерсиюФорматаСПроверкойСовместимостиШаблонов(Форма, ИмяМакетаАттрибутов, ИмяМакетаШаблона, ПараметрыВыгрузки) Экспорт
	Попытка
		Если СтрНачинаетсяС(Форма.ИмяФормы, "Внешний") Тогда
			Возврат;
		КонецЕсли;
		
		ДопАтрибуты = РегламентированнаяОтчетность.СформироватьСтруктуруДопАтрибутов(Форма.ИмяФормы, ИмяМакетаАттрибутов);
		Если (НЕ ДопАтрибуты.Свойство("OKUD"))
		 ИЛИ (НЕ ДопАтрибуты.Свойство("code"))
		 ИЛИ (НЕ ЗначениеЗаполнено(ДопАтрибуты.code)) Тогда
			Возврат;
		КонецЕсли;
		
		ИмяПоследнейФормыОчета = РегламентированнаяОтчетностьВызовСервера.ИмяФормыРеглОтчетаДействующейВОтчетномПериоде(
			РегламентированнаяОтчетностьВызовСервера.ИсточникОтчета(Форма.ИмяФормы), ДобавитьМесяц(ТекущаяДатаСеанса(), 24));
		
		ЭтоПоследняяРеализацияОтчета = СтрЗаканчиваетсяНа(Форма.ИмяФормы, ИмяПоследнейФормыОчета);
		
		Если ЭтоПоследняяРеализацияОтчета Тогда
			// В запросе будут отобраны шаблоны с любым "idf" длиной 3 символа в составе кода.
			КодШаблона = Лев(ДопАтрибуты.code, СтрДлина(ДопАтрибуты.code) - 6) + "___" + Прав(ДопАтрибуты.code, 3);
		Иначе
			// В запросе будут отобраны шаблоны с кодом равным коду текущего шаблона формы отчета.
			КодШаблона = ДопАтрибуты.code;
		КонецЕсли;
		
		КодФормыШаблона = Сред(ДопАтрибуты.code, СтрДлина(ДопАтрибуты.code) - 5, 3);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	РАЗНОСТЬДАТ(&ТекущаяДата, ШаблоныЭВФОтчетовСтатистики.ДатаДобавления, СЕКУНДА) КАК РазностьДат,
			|	ШаблоныЭВФОтчетовСтатистики.КодШаблона КАК КодШаблона,
			|	ШаблоныЭВФОтчетовСтатистики.Версия КАК Версия,
			|	ШаблоныЭВФОтчетовСтатистики.Шаблон КАК Шаблон,
			|	ШаблоныЭВФОтчетовСтатистики.Шифр КАК Шифр,
			|	ПОДСТРОКА(ШаблоныЭВФОтчетовСтатистики.Версия, 7, 4)
			|	+ ПОДСТРОКА(ШаблоныЭВФОтчетовСтатистики.Версия, 4, 2)
			|	+ ПОДСТРОКА(ШаблоныЭВФОтчетовСтатистики.Версия, 1, 2) КАК ВерсияСортировка
			|ИЗ
			|	РегистрСведений.ШаблоныЭВФОтчетовСтатистики КАК ШаблоныЭВФОтчетовСтатистики
			|ГДЕ
			|	ШаблоныЭВФОтчетовСтатистики.ОКУД = &ОКУД
			|	И ШаблоныЭВФОтчетовСтатистики.КодШаблона ПОДОБНО &КодШаблона
			|УПОРЯДОЧИТЬ ПО
			|	ВерсияСортировка УБЫВ,
			|	КодШаблона УБЫВ,
			|	РазностьДат УБЫВ";
		Запрос.УстановитьПараметр("ОКУД", ДопАтрибуты.OKUD);
		Запрос.УстановитьПараметр("КодШаблона", КодШаблона);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ОбъектОтчетаСтатистики = РегламентированнаяОтчетностьВызовСервера.ОбъектОтчета(Форма.ИмяФормы);
		
		НовыйКодФормы = "";
		ЗаменитьФормат = Ложь;
		Пока Выборка.Следующий() Цикл
			
			КодФормыШаблонаВыб = Сред(Выборка.КодШаблона, СтрДлина(Выборка.КодШаблона) - 5, 3);
			Если (ДатаВерсии(Выборка.Версия) <= ДатаВерсии(ДопАтрибуты.version)) ИЛИ (КодФормыШаблона > КодФормыШаблонаВыб) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ (Выборка.РазностьДат < 3600 И Выборка.РазностьДат > -3600) Тогда
				Продолжить;
			КонецЕсли;
			
			ИтоговоеИмяШаблона = ИмяМакетаШаблона;
			Для Каждого Мкт Из ОбъектОтчетаСтатистики.Метаданные().Макеты Цикл 
				Если СтрНачинаетсяС(Мкт.Имя, "EF_")
					И СтрЗаканчиваетсяНа(Мкт.Имя, ИмяМакетаШаблона) Тогда 
					ИтоговоеИмяШаблона = Мкт.Имя;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ УниверсальныйОтчетСтатистики.СравнитьСтруктурыШаблонов(Выборка.Шаблон,
				ОбъектОтчетаСтатистики.ПолучитьМакет(ИтоговоеИмяШаблона)) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ПроверкаФорматаПоПериодуПрименения(ПараметрыВыгрузки, Выборка.Версия) Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйКодФормы = Формат(Число("0" + КодФормыШаблонаВыб), "ЧН=; ЧГ=");
			
			ЗаменитьФормат = Истина;
			Прервать;
		КонецЦикла;
		
		Если НЕ ЗаменитьФормат Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыВыгрузки.ВерсияШаблона = Выборка.Версия;
		ПараметрыВыгрузки.Вставить("ПроизведенаЗаменаФормата", Истина);
		ПараметрыВыгрузки.Вставить("ПроизведенаЗаменаФормата_ОКУД", ДопАтрибуты.OKUD);
		
		Если ЭтоПоследняяРеализацияОтчета Тогда
			ПараметрыВыгрузки.Вставить("КодШаблона", Выборка.КодШаблона);
			ПараметрыВыгрузки.Вставить("КодФормы",   НовыйКодФормы);
			ПараметрыВыгрузки.Вставить("ШифрФормы",  Выборка.Шифр);
			ИмяФайлаВыгрузки = "";
			Если ПараметрыВыгрузки.Свойство("ИмяФайла", ИмяФайлаВыгрузки) И ЗначениеЗаполнено(ИмяФайлаВыгрузки) Тогда
				ПараметрыВыгрузки["ИмяФайла"] = ИмяФайлаВыгрузкиСНовымКодомФормы(ИмяФайлаВыгрузки, НовыйКодФормы);
			КонецЕсли;
			ПараметрыВыгрузки.Вставить("ПроизведенаЗаменаФормата_КодШаблона", Выборка.КодШаблона);
			ПараметрыВыгрузки.Вставить("ПроизведенаЗаменаФормата_КодФормы", НовыйКодФормы);
			ПараметрыВыгрузки.Вставить("ПроизведенаЗаменаФормата_ШифрФормы", Выборка.Шифр);
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Версия формата выгрузки была изменена на ';
													|en = 'Export format version was changed to'") + Выборка.Версия);
		Комментарий = НСтр("ru = 'Для отчета ';
							|en = 'For report'") + Форма.ИмяФормы + НСтр("ru = ' версия формата выгрузки была изменена с ';
																		|en = ' export format version was changed from'") + ДопАтрибуты.version + НСтр("ru = ' на ';
																																						|en = ' to'") + Выборка.Версия;
		ЗаписьЖурналаРегистрации("ЗаменаФорматаРосстатаПоИнформацииСервиса", УровеньЖурналаРегистрации.Информация, , , Комментарий);
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьДанныеШаблона(Форма, ИмяМакетаАттрибутов, ИмяМакетаШаблона, ПараметрыВыгрузки, НоваяВерсия) Экспорт
	Попытка
		Если СтрНачинаетсяС(Форма.ИмяФормы, "Внешний") Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДопАтрибуты = РегламентированнаяОтчетность.СформироватьСтруктуруДопАтрибутов(Форма.ИмяФормы, ИмяМакетаАттрибутов);
		Если (НЕ ДопАтрибуты.Свойство("OKUD"))
		 ИЛИ (НЕ ДопАтрибуты.Свойство("code"))
		 ИЛИ (НЕ ЗначениеЗаполнено(ДопАтрибуты.code)) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ИмяПоследнейФормыОчета = РегламентированнаяОтчетностьВызовСервера.ИмяФормыРеглОтчетаДействующейВОтчетномПериоде(
			РегламентированнаяОтчетностьВызовСервера.ИсточникОтчета(Форма.ИмяФормы), ДобавитьМесяц(ТекущаяДатаСеанса(), 24));
		
		ЭтоПоследняяРеализацияОтчета = СтрЗаканчиваетсяНа(Форма.ИмяФормы, ИмяПоследнейФормыОчета);
		
		Если ЭтоПоследняяРеализацияОтчета Тогда
			// В запросе будут отобраны шаблоны с любым "idf" длиной 3 символа в составе кода.
			КодШаблона = Лев(ДопАтрибуты.code, СтрДлина(ДопАтрибуты.code) - 6) + "___" + Прав(ДопАтрибуты.code, 3);
		Иначе
			// В запросе будут отобраны шаблоны с кодом равным коду текущего шаблона формы отчета.
			КодШаблона = ДопАтрибуты.code;
		КонецЕсли;
		
		КодФормыШаблона = Сред(ДопАтрибуты.code, СтрДлина(ДопАтрибуты.code) - 5, 3);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	РАЗНОСТЬДАТ(&ТекущаяДата, ШаблоныЭВФОтчетовСтатистики.ДатаДобавления, СЕКУНДА) КАК РазностьДат,
			|	ШаблоныЭВФОтчетовСтатистики.КодШаблона КАК КодШаблона,
			|	ШаблоныЭВФОтчетовСтатистики.Версия КАК Версия,
			|	ШаблоныЭВФОтчетовСтатистики.Шаблон КАК Шаблон,
			|	ПОДСТРОКА(ШаблоныЭВФОтчетовСтатистики.Версия, 7, 4)
			|	+ ПОДСТРОКА(ШаблоныЭВФОтчетовСтатистики.Версия, 4, 2)
			|	+ ПОДСТРОКА(ШаблоныЭВФОтчетовСтатистики.Версия, 1, 2) КАК ВерсияСортировка
			|ИЗ
			|	РегистрСведений.ШаблоныЭВФОтчетовСтатистики КАК ШаблоныЭВФОтчетовСтатистики
			|ГДЕ
			|	ШаблоныЭВФОтчетовСтатистики.ОКУД = &ОКУД
			|	И ШаблоныЭВФОтчетовСтатистики.КодШаблона ПОДОБНО &КодШаблона
			|УПОРЯДОЧИТЬ ПО
			|	ВерсияСортировка УБЫВ,
			|	КодШаблона УБЫВ,
			|	РазностьДат УБЫВ";
		Запрос.УстановитьПараметр("ОКУД", ДопАтрибуты.OKUD);
		Запрос.УстановитьПараметр("КодШаблона", КодШаблона);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ОбъектОтчетаСтатистики = РегламентированнаяОтчетностьВызовСервера.ОбъектОтчета(Форма.ИмяФормы);
		
		ЗаменитьФормат = Ложь;
		Пока Выборка.Следующий() Цикл
			
			КодФормыШаблонаВыб = Сред(Выборка.КодШаблона, СтрДлина(Выборка.КодШаблона) - 5, 3);
			Если (ДатаВерсии(Выборка.Версия) <= ДатаВерсии(ДопАтрибуты.version)) ИЛИ (КодФормыШаблона > КодФормыШаблонаВыб) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ (Выборка.РазностьДат < 3600 И Выборка.РазностьДат > -3600) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ УниверсальныйОтчетСтатистики.СравнитьСтруктурыШаблонов(Выборка.Шаблон,
				ОбъектОтчетаСтатистики.ПолучитьМакет(ИмяМакетаШаблона)) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ПроверкаФорматаПоПериодуПрименения(ПараметрыВыгрузки, Выборка.Версия) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаменитьФормат = Истина;
			Прервать;
		КонецЦикла;
		
		Если НЕ ЗаменитьФормат Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		НоваяВерсия = Выборка.Версия;
		Возврат Выборка.Шаблон;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ПроверкаФорматаПоПериодуПрименения(ПараметрыДляПроверки, ВерсияШаблона) Экспорт
	
	РезультатПроверки = Истина;
	
	СохраненныйДокумент = Неопределено;
	
	Если ПараметрыДляПроверки.Свойство("Ссылка",   СохраненныйДокумент)
	 ИЛИ ПараметрыДляПроверки.Свойство("Документ", СохраненныйДокумент) Тогда
		Если ТипЗнч(СохраненныйДокумент) <> Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			Возврат РезультатПроверки;
		КонецЕсли;
	Иначе
		Возврат РезультатПроверки;
	КонецЕсли;
	
	ИсточникОтчета = ВРег(СохраненныйДокумент.ИсточникОтчета);
	ВыбраннаяФорма = ВРег(СохраненныйДокумент.ВыбраннаяФорма);
	
	ДатаКонцаПериодаОтчета = КонецДня(СохраненныйДокумент.ДатаОкончания);
	
	СведенияОФормате = Новый Структура("Код,ДатаПриказа,НомерПриказа,ИмяОбъекта", ВерсияШаблона, '00010101', "", "");
	
	Если НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.МеханизмОнлайнСервисовВключен() Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	СведенияПоБлокировке = ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.ПроверкаФорматаПоПериодуПримененияСервер(
			ПараметрыДляПроверки, ДатаКонцаПериодаОтчета, ВыбраннаяФорма, ИсточникОтчета, СведенияОФормате);
	
	Возврат СведенияПоБлокировке.РезультатПроверки;
	
КонецФункции

Функция ИмяФайлаВыгрузкиСНовымКодомФормы(ИмяФайлаВыгрузки, НовыйКодФормы)
	
	НовоеИмяФайлаВыгрузки = ИмяФайлаВыгрузки;
	
	ЧастиИмениФайла = СтрРазделить(ИмяФайлаВыгрузки, "_");
	Если ЧастиИмениФайла.ВГраница() > 0 Тогда
		Если СтрДлина(ЧастиИмениФайла[1]) = 3 Тогда
			ЧастиИмениФайла[1] = Прав("000" + НовыйКодФормы, 3);
		Иначе
			ЧастиИмениФайла[1] = НовыйКодФормы;
		КонецЕсли;
		
		НовоеИмяФайлаВыгрузки = СтрСоединить(ЧастиИмениФайла, "_");
	КонецЕсли;
	
	Возврат НовоеИмяФайлаВыгрузки;
	
КонецФункции

Функция ДатаВерсии(СтрДата)
	
	Разделители = "-.,/";
	
	ДлинаСтроки = СтрДлина(СтрДата);
	
	МассивПолей = Новый Массив;
	МассивПолей.Добавить("");
	
	Для НС = 1 По ДлинаСтроки Цикл
		Сим = Сред(СтрДата, НС, 1);
		Если СтрНайти(Разделители, Сим) > 0 Тогда
			МассивПолей.Добавить("");
		ИначеЕсли СтрНайти("0123456789", Сим) > 0 Тогда
			МассивПолей[МассивПолей.ВГраница()] = МассивПолей[МассивПолей.ВГраница()] + Сим;
		КонецЕсли;
	КонецЦикла;
	
	День  = Макс(1, Число("0" + СокрЛП(МассивПолей[0])));
	Месяц = Макс(1, Число("0" + ?(МассивПолей.ВГраница() < 1, "1", СокрЛП(МассивПолей[1]))));
	Год   = Макс(1, Число("0" + ?(МассивПолей.ВГраница() < 2, "1", СокрЛП(МассивПолей[2]))));
	
	Возврат Дата(Год, Месяц, День);
	
КонецФункции

#КонецОбласти

#Область ПроцессыОбработкиДокументов

Процедура ПриИнициализации(Форма, Объект) Экспорт
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		Ссылка = ?(ОбщегоНазначения.ЗначениеСсылочногоТипа(Объект), Объект, Объект.Ссылка);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			ПриЧтенииНаСервере(Форма, Объект);
		Иначе
			ПриСозданииНаСервере(Форма, Объект);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписьюНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
	
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
	
		МодульПроцессыОбработкиДокументов.ПередЗаписьюНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
	
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
	
