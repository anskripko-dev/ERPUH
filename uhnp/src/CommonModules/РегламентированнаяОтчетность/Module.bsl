				ВидКИ = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
			КонецЕсли;
		КонецЕсли;
		КИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, ВидКИ, ТекущаяДатаСеанса(), Ложь);
