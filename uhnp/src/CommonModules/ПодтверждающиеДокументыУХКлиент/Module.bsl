#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьОформлениеСтроки(СтрокаТабличнойЧасти) Экспорт
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитовОбъекта = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(СтрокаТабличнойЧасти.ВидДокумента,
									 "ПрисоединенныйФайл, ОбъектСистемы");
	
	Если  ЗначенияРеквизитовОбъекта.ПрисоединенныйФайл = Неопределено Тогда
		СтрокаТабличнойЧасти.НаличиеФайла 		= Ложь;
	Иначе
		СтрокаТабличнойЧасти.НаличиеФайла 		= ЗначенияРеквизитовОбъекта.ПрисоединенныйФайл;
	КонецЕсли; 
	
	СтрокаТабличнойЧасти.НаличиеОбъекта 	= ЗначенияРеквизитовОбъекта.ОбъектСистемы;  	
	
	Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Файл) Тогда
		ЗначенияРеквизитовФайла = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(СтрокаТабличнойЧасти.Файл,
									 "ИндексКартинки");  
		СтрокаТабличнойЧасти.ИндексКартинки 	= ЗначенияРеквизитовФайла.ИндексКартинки;  		
	Иначе
		СтрокаТабличнойЧасти.ИндексКартинки 	= 2;  
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Файл) Тогда
	    СтрокаТабличнойЧасти.НомерКартинкиПодписанЗашифрован = -1;
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ПодписанЭП");
	СтруктураРеквизитов.Вставить("Зашифрован");
 
	ЗначенияРеквизитовФайла = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(СтрокаТабличнойЧасти.Файл,
									 СтруктураРеквизитов);
 	Если  ЗначенияРеквизитовФайла.ПодписанЭП
				И ЗначенияРеквизитовФайла.Зашифрован
				Тогда 	СтрокаТабличнойЧасти.НомерКартинкиПодписанЗашифрован = 2;
	ИначеЕсли ЗначенияРеквизитовФайла.Зашифрован 
				Тогда 	СтрокаТабличнойЧасти.НомерКартинкиПодписанЗашифрован = 1;
	ИначеЕсли ЗначенияРеквизитовФайла.ПодписанЭП
				Тогда 	СтрокаТабличнойЧасти.НомерКартинкиПодписанЗашифрован = 0;
	Иначе  				СтрокаТабличнойЧасти.НомерКартинкиПодписанЗашифрован = -1;
		
	КонецЕсли;

КонецПроцедуры  

Процедура ОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник, ДобавляетсяФайлПодтверждающегоДокумента)  Экспорт

	 Если ИмяСобытия = "Запись_Файл"
			И Параметр.Свойство("Владелец")
			И Параметр.ЭтоНовый
			И ДобавляетсяФайлПодтверждающегоДокумента Тогда
			
		Форма.Элементы.ПодтверждающиеДокументыУХ.ТекущиеДанные.Файл = Источник[0];
		ДобавляетсяФайлПодтверждающегоДокумента = Ложь;
	КонецЕсли;

КонецПроцедуры  

Процедура РедактироватьФайл(ТекущиеДанные, УникальныйИдентификатор) Экспорт
		
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;                                         
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Файл) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Файл не указан.';
				|en = 'File is not specified.'"));
			Возврат;
	КонецЕсли;
			
	РеквизитыФайла = ПодтверждающиеДокументыУХВызовСервера.РеквизитыПодтверждающегоДокумента(ТекущиеДанные.Файл);
	
	Если РеквизитыФайла.Зашифрован Тогда
		Возврат;
	КонецЕсли;
			
	ДанныеФайла = ПодтверждающиеДокументыУХВызовСервера.ПолучитьДанныеФайла(ТекущиеДанные.Файл, УникальныйИдентификатор);	
	РаботаСФайламиСлужебныйКлиент.РедактироватьСОповещением(Неопределено, ТекущиеДанные.Файл);
	
КонецПроцедуры    

Процедура Подписать(ТекущиеДанные, УникальныйИдентификатор) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;                                         
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Файл) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Файл не указан.';
				|en = 'File is not specified.'"));
			Возврат;
	КонецЕсли;

	РеквизитыФайла = ПодтверждающиеДокументыУХВызовСервера.РеквизитыПодтверждающегоДокумента(ТекущиеДанные.Файл);

	Если РеквизитыФайла.ФайлРедактируется
		ИЛИ РеквизитыФайла.Зашифрован Тогда
		Возврат;
	КонецЕсли;

	РаботаСФайламиКлиент.ПодписатьФайл(ТекущиеДанные.Файл, УникальныйИдентификатор);

КонецПроцедуры

Процедура ОткрытьФайлДляПросмотра(ТекущиеДанные, УникальныйИдентификатор) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;                                         
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Файл) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Файл не указан.';
				|en = 'File is not specified.'"));
			Возврат;
	КонецЕсли;
			
	РеквизитыФайла = ПодтверждающиеДокументыУХВызовСервера.РеквизитыПодтверждающегоДокумента(ТекущиеДанные.Файл);
	
	Если РеквизитыФайла.Зашифрован Тогда
		Возврат;
	КонецЕсли;
			
	ДанныеФайла = ПодтверждающиеДокументыУХВызовСервера.ПолучитьДанныеФайла(ТекущиеДанные.Файл, УникальныйИдентификатор);
	РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла, РеквизитыФайла.ФайлРедактируется);

КонецПроцедуры

Процедура Зашифровать(ТекущиеДанные, УникальныйИдентификатор) Экспорт

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;                                         
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Файл) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Файл не указан.';
				|en = 'File is not specified.'"));
			Возврат;
	КонецЕсли;
  	
	ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ПолучитьДанныеФайлаИКоличествоВерсий(ТекущиеДанные.Файл);
	
	Если ЗначениеЗаполнено(ДанныеФайла.Редактирует)
		ИЛИ ДанныеФайла.Зашифрован Тогда
		// Файл может быть изменен в другом сеансе.
		ОповеститьОбИзменении(ТекущиеДанные.Файл);
		Возврат;
	КонецЕсли;
	
	РаботаСФайламиСлужебныйКлиент.Зашифровать(Неопределено, ДанныеФайла, УникальныйИдентификатор);

КонецПроцедуры 

Процедура Расшифровать(ТекущиеДанные, УникальныйИдентификатор) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;                                         
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Файл) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Файл не указан.';
				|en = 'File is not specified.'"));
			Возврат;
	КонецЕсли;
 
	РеквизитыФайла = ПодтверждающиеДокументыУХВызовСервера.РеквизитыПодтверждающегоДокумента(ТекущиеДанные.Файл);
	
	Если РеквизитыФайла.Зашифрован Тогда
		Возврат;
	КонецЕсли;
  
	ОбъектСсылка = ТекущиеДанные.Файл;
	ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ПолучитьДанныеФайлаИКоличествоВерсий(ОбъектСсылка);
	
	РаботаСФайламиСлужебныйКлиент.Расшифровать(
		Неопределено,
		ДанныеФайла.Ссылка,
		УникальныйИдентификатор,
		ДанныеФайла);
		
КонецПроцедуры

Процедура УстановитьВидКнопкиФайлов(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	
	Если Элементы.Найти("ФормаОбщаяКомандаПрисоединенныеФайлыУХ") = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	Если Форма.ИспользоватьПодтверждающиеДокументы Тогда
		Элементы.ФормаОбщаяКомандаПрисоединенныеФайлыУХ.ПоложениеВКоманднойПанели =  ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю; 	
	Иначе
		Элементы.ФормаОбщаяКомандаПрисоединенныеФайлыУХ.ПоложениеВКоманднойПанели =  ПоложениеКнопкиВКоманднойПанели.Авто; 	
	КонецЕсли;

КонецПроцедуры

