Функция ПолучитьФайлыСИдентификаторами(ЭлектронныйДокумент, РаспакованныеФайлы, УстанавливатьУИДПриОтсутствии = Истина)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("МассивНовыхФайлов"     , Новый Массив);
	СтруктураВозврата.Вставить("СоответствиеИмениИХеша", Новый Соответствие);
	
	СоответствиеИменФайлов = Новый Соответствие;
	
	ТаблицаФайлов = Новый ТаблицаЗначений;
	ТаблицаФайлов.Колонки.Добавить("ИмяФайла", ОбщегоНазначения.ОписаниеТипаСтрока(300));
	ТаблицаФайлов.Колонки.Добавить("ХешФайла", ОбщегоНазначения.ОписаниеТипаСтрока(200));
	ТаблицаФайлов.Колонки.Добавить("ИдентификаторФайла", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТаблицаФайлов.Колонки.Добавить("ЭлектронныйДокумент", ОбщегоНазначения.ОписаниеТипаВсеСсылки());
		
	Для Каждого стрФайл Из РаспакованныеФайлы Цикл
		ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
		ХешированиеДанных.ДобавитьФайл(стрФайл.Значение.ПолноеИмя);
		
		НС                     = ТаблицаФайлов.Добавить();
		НС.ЭлектронныйДокумент = ЭлектронныйДокумент;
		НС.ИмяФайла            = стрФайл.Значение.Имя;		
		НС.ХешФайла            = СтрЗаменить(ХешированиеДанных.ХешСумма, " ", "");
		
		СоответствиеИменФайлов.Вставить(стрФайл.Значение.Имя, стрФайл.Значение);	
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаФайлов", ТаблицаФайлов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаФайлов.ИмяФайла КАК ИмяФайла,
	|	ТаблицаФайлов.ХешФайла КАК ХешФайла,
	|	ТаблицаФайлов.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ПОМЕСТИТЬ втСоответствиеФайлов
	|ИЗ
	|	&ТаблицаФайлов КАК ТаблицаФайлов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСоответствиеФайлов.ИмяФайла КАК ИмяФайла,
	|	втСоответствиеФайлов.ХешФайла КАК ХешФайла,
	|	втСоответствиеФайлов.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	тн_ИдентификаторыФайловЭлектронныхДокументов.ИдентификаторФайла КАК ИдентификаторФайла
	|ПОМЕСТИТЬ втДокументыРегистра
	|ИЗ
	|	втСоответствиеФайлов КАК втСоответствиеФайлов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_ИдентификаторыФайловЭлектронныхДокументов КАК тн_ИдентификаторыФайловЭлектронныхДокументов
	|		ПО втСоответствиеФайлов.ЭлектронныйДокумент = тн_ИдентификаторыФайловЭлектронныхДокументов.ЭлектронныйДокумент
	|			И втСоответствиеФайлов.ХешФайла = тн_ИдентификаторыФайловЭлектронныхДокументов.ХешФайла
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДокументыРегистра.ИмяФайла КАК ИмяФайла,
	|	втДокументыРегистра.ХешФайла КАК ХешФайла,
	|	ЕСТЬNULL(втДокументыРегистра.ИдентификаторФайла, """") КАК ИдентификаторФайла
	|ИЗ
	|	втДокументыРегистра КАК втДокументыРегистра";
	
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	
	МассивНовыхФайлов      = Новый Массив;
	СоответствиеИмениИХеша = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ИмяФайла    = Выборка.ИмяФайла;
		ТекущийФайл = СоответствиеИменФайлов[ИмяФайла];
		Если Не ТекущийФайл = Неопределено Тогда
			СтруктураФайла = ИнициализироватьСтруктуруФайла();
			
			СтруктураФайла.Файл  = ТекущийФайл;
			ТекущийИдентификатор = Выборка.ИдентификаторФайла;
			
			Если УстанавливатьУИДПриОтсутствии И Не ЗначениеЗаполнено(ТекущийИдентификатор) Тогда
				ТекущийИдентификатор = Строка(Новый УникальныйИдентификатор);	
			КонецЕсли;
			
			СтруктураФайла.ИдентификаторФайла = ТекущийИдентификатор;
			
			МассивНовыхФайлов.Добавить(СтруктураФайла);
			СоответствиеИмениИХеша.Вставить(ИмяФайла, Выборка.ХешФайла);
		КонецЕсли;
	КонецЦикла; 
	
	СтруктураВозврата.МассивНовыхФайлов      = МассивНовыхФайлов;
	СтруктураВозврата.СоответствиеИмениИХеша = СоответствиеИмениИХеша;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьДанныеПрофиляХраненияФайловЭД(ОператорЭДО) Экспорт
	
	ДанныеПрофиля = Новый Структура;
	ДанныеПрофиля.Вставить("КоличествоДокументовВПакете", 0);
	ДанныеПрофиля.Вставить("СпособОтправки", "RabbitMQ");
	ДанныеПрофиля.Вставить("Используется", Ложь);
	ДанныеПрофиля.Вставить("Ссылка", Неопределено);
	ДанныеПрофиля.Вставить("НаименованиеСхемы", "systemsToeda_create_document_v1");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОператорЭДО", ОператорЭДО);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	тн_ПрофилиХраненияФайловЭД.КоличествоДокументовВПакете КАК КоличествоДокументовВПакете,
	|	тн_ПрофилиХраненияФайловЭД.СпособОтправки КАК СпособОтправки,
	|	тн_ПрофилиХраненияФайловЭД.Используется КАК Используется,
	|	тн_ПрофилиХраненияФайловЭД.Ссылка КАК Ссылка,
	|	тн_ПрофилиХраненияФайловЭД.НаименованиеСхемы КАК НаименованиеСхемы
	|ИЗ
	|	Справочник.тн_ПрофилиХраненияФайловЭД КАК тн_ПрофилиХраненияФайловЭД
	|ГДЕ
	|	НЕ тн_ПрофилиХраненияФайловЭД.ПометкаУдаления
	|	И тн_ПрофилиХраненияФайловЭД.Используется
	|	И тн_ПрофилиХраненияФайловЭД.ОператорЭДО = &ОператорЭДО";
	
	Выборка = Запрос.Выполнить().Выбрать();;
	
	Если Выборка.Следующий() Тогда
		ДанныеПрофиля.КоличествоДокументовВПакете = Выборка.КоличествоДокументовВПакете;
		ДанныеПрофиля.СпособОтправки = Выборка.СпособОтправки;
		ДанныеПрофиля.Используется = Выборка.Используется;
		ДанныеПрофиля.Ссылка = Выборка.Ссылка;
		ДанныеПрофиля.НаименованиеСхемы = Выборка.НаименованиеСхемы;
	КонецЕсли;
	
	Возврат ДанныеПрофиля;
	
КонецФункции

Функция ИнициализироватьСтруктуруПараметровЗаписиВыгруженногоЭД()
	
	Структура = Новый Структура;
	Структура.Вставить("ЭлектронныйДокумент"   , Неопределено);
	Структура.Вставить("ПрофильХранения"       , Неопределено);
	Структура.Вставить("ДатаВыгрузки"          , Дата(1, 1, 1));
	Структура.Вставить("ИдентификаторСообщения", "");
	
	Возврат Структура;
	
КонецФункции

Процедура ЗафиксироватьВыгрузкуВРегистре(СтруктураПараметров, ТаблицаОтправленныхФайлов)
	
	// Фиксация факта выгрузки в архив
	МЗ = РегистрыСведений.тн_ВыгруженныеЭлектронныеДокументы.СоздатьМенеджерЗаписи();
	
	МЗ.ЭлектронныйДокумент = СтруктураПараметров.ЭлектронныйДокумент;
	МЗ.ПрофильХранения = СтруктураПараметров.ПрофильХранения;
	
	МЗ.ДатаВыгрузки = СтруктураПараметров.ДатаВыгрузки;
	МЗ.ИдентификаторСообщения = СтруктураПараметров.ИдентификаторСообщения;
	
	Попытка
		
		МЗ.Записать();
			
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации("Запись состояния выгрузки в архив ЭДО",
			УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
	КонецПопытки;
	
	// Фиксация файлов ЭД и подписей, выгруженных в архив
	Если ТипЗнч(ТаблицаОтправленныхФайлов) = Тип("ТаблицаЗначений") Тогда

		Для Каждого стрФайл Из ТаблицаОтправленныхФайлов Цикл
			
			МЗ                     = РегистрыСведений.тн_ИдентификаторыФайловЭлектронныхДокументов.СоздатьМенеджерЗаписи();
			МЗ.ЭлектронныйДокумент = стрФайл.ЭлектронныйДокумент;
			МЗ.ХешФайла            = стрФайл.ХешФайла;
			МЗ.ИмяФайла            = стрФайл.ИмяФайла;
			МЗ.ИдентификаторФайла  = стрФайл.ИдентификаторФайла;
			
			Попытка      
				МЗ.Записать();
			Исключение
				ТекстОшибки = СтрШаблон("Электронный документ: %1. Не записать отправленные файлы ЭД по причине: %2", 
								стрФайл.ЭлектронныйДокумент, ОписаниеОшибки());
								
				ЛогСообщенияОшибки(Перечисления.ТН_ВидыСообщенийTN_EDA.CreateDocument,
					"Ошибка", Новый УникальныйИдентификатор, ТекстОшибки);
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПодписиФайлаПоИмени(ИмяБезРасширения, МассивПодписей)
	
	ПодписиФайла = Новый Массив;
	
	Для Каждого стрФайлПодписи Из МассивПодписей Цикл
		
		ТекФайл = стрФайлПодписи.Файл;
		Если СтрНайти(ТекФайл.ИмяБезРасширения, ИмяБезРасширения) > 0 Тогда
			
			ПодписиФайла.Добавить(стрФайлПодписи);	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПодписиФайла
	
КонецФункции

// Возвращает расширения файлов подписи.
// 
// Возвращаемое значение:
//  Массив из Строка 
Функция ЭтоФайлПодписи(ПроверяемоеРасширение)
	
	МассивРасширений = Новый Массив;
	МассивРасширений.Добавить(".p7s");
	МассивРасширений.Добавить(".sig");
	МассивРасширений.Добавить(".sign");
	МассивРасширений.Добавить(".sgn");
	
	НайденноеРасширение = МассивРасширений.Найти(ПроверяемоеРасширение);
	
	Возврат НайденноеРасширение <> Неопределено;
	
КонецФункции

Функция ПолучитьКаталогФайла(ВсеКаталоги, ПолноеИмя, ЭтоКаталог)
	
	МассивПутей = СтрРазделить(ПолноеИмя, ПолучитьРазделительПути(), Ложь);
	
	Если НЕ ЭтоКаталог Тогда
		МассивПутей.Удалить(МассивПутей.Количество() - 1);
	КонецЕсли;
	
	ТекущийУровень = ВсеКаталоги;
	Для Счетчик = 0 По МассивПутей.Количество() - 1 Цикл
		ИмяКаталога = МассивПутей[0];
		НашлиКаталог = ТекущийУровень[ИмяКаталога];
		Если НашлиКаталог = Неопределено Тогда
			НашлиКаталог = Новый Соответствие();
			ТекущийУровень.Вставить(ИмяКаталога, НашлиКаталог);
		КонецЕсли;
		
		ТекущийУровень = НашлиКаталог;
		
	КонецЦикла;
	
	Возврат ТекущийУровень;
	
КонецФункции

Функция ПолучитьСодержимоеАрхива(ДанныеКонтейнера, ИдентификаторДокумента, РежимВосстановления = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Истина);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Файлы", Новый Соответствие);
	Результат.Вставить("ВременныйКаталог", "");
	
	Если РежимВосстановления = Неопределено Тогда
		РежимВосстановления = РежимВосстановленияПутейФайловZIP.НеВосстанавливать;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(ДанныеКонтейнера) Тогда
		ДанныеКонтейнера = ПолучитьИзВременногоХранилища(ДанныеКонтейнера);
	КонецЕсли;
	
	Попытка
				
		ВременныйКаталог = ПолучитьИмяВременногоФайла() + ИдентификаторДокумента + ПолучитьРазделительПути();
		СоздатьКаталог(ВременныйКаталог);
		
		ИмяФайлаАрхива = ВременныйКаталог + ИдентификаторДокумента + ".zip";
		ДанныеКонтейнера.Записать(ИмяФайлаАрхива);
		
		ЧтениеZIP = Новый ЧтениеZipФайла(ИмяФайлаАрхива);
		ЧтениеZIP.ИзвлечьВсе(ВременныйКаталог, РежимВосстановления);
		ЧтениеZIP.Закрыть();
		
		РаспакованныеФайлы = НайтиФайлы(ВременныйКаталог, ПолучитьМаскуВсеФайлыСервера(), Истина);
				
		Для Каждого СтрокаМассива Из РаспакованныеФайлы Цикл
			ПолноеИмя = СтрЗаменить(СтрокаМассива.ПолноеИмя, ВременныйКаталог, "");
			ЭтоКаталог = СтрокаМассива.ЭтоКаталог();
			
			Если СтрокаМассива.ПолноеИмя = ИмяФайлаАрхива Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущийКаталог = ПолучитьКаталогФайла(Результат.Файлы, ПолноеИмя, ЭтоКаталог);
			
			Если НЕ ЭтоКаталог Тогда
				ТекущийКаталог.Вставить(СтрокаМассива.Имя, СтрокаМассива);
			КонецЕсли;
			
		КонецЦикла;
		
		Результат.ВременныйКаталог = ВременныйКаталог;
		
	Исключение
		Результат.Выполнено = Ложь;
		Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Попытка
		Файл = Новый Файл(ВременныйКаталог);
		
		Если НЕ Результат.Выполнено И Файл.Существует() Тогда
			УдалитьФайлы(ВременныйКаталог);
		КонецЕсли;
		
	Исключение
		Результат.Ошибка = Результат.Ошибка + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ДатаВUTC(ДатаВходящая, Смещение = Неопределено, КонецСекунды = Ложь) 
	
	Постфикс = ?(КонецСекунды, ".99Z", ".00Z");
	
	Дата 		  = "0001-01-01T00:00:00" + Постфикс;
	ФорматВремени = "ДФ=yyyy-MM-ddTHH:mm:ss" + Постфикс;
	
	Если ЗначениеЗаполнено(ДатаВходящая) Тогда
				
		Если Смещение = Неопределено Тогда
			
			//смещение по умолчанию (по часовому поясу сервера)
			Дата = Формат(УниверсальноеВремя(ДатаВходящая), ФорматВремени);
			
		ИначеЕсли Смещение = Null Тогда
			
			//смещение неизвестно, оставляем дату без изменений
			Дата = Формат(ДатаВходящая, ФорматВремени);
			
		Иначе
			
			ЧасовойПояс = "GMT" + Смещение;
			
			Дата = Формат(УниверсальноеВремя(ДатаВходящая, ЧасовойПояс), ФорматВремени);
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Дата;
	
КонецФункции

Функция ВыполнитьМетодEDA(ПрофильПодключения, Идентификатор, СообщениеСтрока, СтрокаHTTP, Метод, ВидСообщения) Экспорт
		
	СтруктураВозврата = Новый Структура("Успех, ОписаниеОшибки, Результат", Истина, "", Неопределено);
	
	ДанныеПрофиляПодключения = ТН_Интеграция.ПолучитьПараметрыПрофиля(ПредопределенноеЗначение("Справочник.тн_ПрофилиПодключений.EDA"));
	
	Прокси = ТН_Интеграция.УстановитьСоединениеССервером(ДанныеПрофиляПодключения, СтруктураВозврата.ОписаниеОшибки);
	
	Если Прокси = Неопределено Тогда
		
		РегистрыСведений.ТН_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ДанныеПрофиляПодключения.ВидИнтеграции, Идентификатор, ПредопределенноеЗначение("Перечисление.ТН_ВидыСобытийИнтеграции.Ошибка"), СтруктураВозврата.ОписаниеОшибки, ВидСообщения);
		СтруктураВозврата.Успех = Ложь; 
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	ЗаголовокHTTP = Новый Соответствие();
	
	Для Каждого Параметр Из ПрофильПодключения.ДополнительныеПараметры Цикл 
		
		ЗаголовокHTTP.Вставить(Параметр.Ключ, Параметр.Значение);
		
	КонецЦикла;
		
	Если ЗаголовокHTTP.Получить("Authorization") = Неопределено Тогда
		
		ЗаголовокHTTP.Вставить("Authorization", СтрШаблон("System %1", ДанныеПрофиляПодключения.ApiKey));
		
	КонецЕсли;
	
	HTTPЗапрос = Новый HTTPЗапрос(СтрокаHTTP, ЗаголовокHTTP);
	
	Если Не СообщениеСтрока = "" Тогда
		
		HTTPЗапрос.УстановитьТелоИзСтроки(СообщениеСтрока, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
	КонецЕсли;
	
	УспешныйКодСостояния = 200;
	
	Попытка 
		
		HTTPОтвет = Прокси.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		Ответ     = HTTPОтвет.ПолучитьТелоКакСтроку();
		
		ДобавитьЛогСообщенияИсходящего(ДанныеПрофиляПодключения.ВидИнтеграции, СообщениеСтрока, Ответ, ВидСообщения, ПредопределенноеЗначение("Перечисление.ТН_ВидыСобытийИнтеграции.ОбработкаЗавершена"), Идентификатор); 
		
		Если Ответ = "" И HTTPОтвет.КодСостояния = УспешныйКодСостояния Тогда 
			
			Возврат СтруктураВозврата;
			
		ИначеЕсли Ответ = "" И Не HTTPОтвет.КодСостояния = УспешныйКодСостояния Тогда
			
			ТекстОшибки = "Код состояния: " + Строка(HTTPОтвет.КодСостояния);
			РегистрыСведений.ТН_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ДанныеПрофиляПодключения.ВидИнтеграции, Идентификатор, ПредопределенноеЗначение("Перечисление.ТН_ВидыСобытийИнтеграции.Ошибка"), ТекстОшибки, ВидСообщения);
			
			СтруктураВозврата.Успех          = Ложь;
			СтруктураВозврата.ОписаниеОшибки = ТекстОшибки;
			
			Возврат СтруктураВозврата;
			
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = "Не удалось отправить сообщение по причине: " + ОписаниеОшибки();
		РегистрыСведений.ТН_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ДанныеПрофиляПодключения.ВидИнтеграции, Идентификатор, ПредопределенноеЗначение("Перечисление.ТН_ВидыСобытийИнтеграции.Ошибка"), ТекстОшибки, ВидСообщения);
		
		СтруктураВозврата.Успех          = Ложь;
		СтруктураВозврата.ОписаниеОшибки = ТекстОшибки;
		
		Возврат СтруктураВозврата;
		
	КонецПопытки;
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Ответ);
		Результат = ПрочитатьJSON(ЧтениеJSON);
		
	Исключение
		
		ТекстОшибки = "Не удалось отправить сообщение по причине: " + Ответ;
		РегистрыСведений.ТН_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ДанныеПрофиляПодключения.ВидИнтеграции, Идентификатор, ПредопределенноеЗначение("Перечисление.ТН_ВидыСобытийИнтеграции.Ошибка"), ТекстОшибки, ВидСообщения);
		
		СтруктураВозврата.Успех          = Ложь;
		СтруктураВозврата.ОписаниеОшибки = ТекстОшибки;
		
	КонецПопытки;
	
	ЧтениеJSON.Закрыть();
	
	Если Не Результат = Неопределено Тогда
		
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			
			Если Результат.Свойство("message") Тогда
				
				ТекстОшибки = "Не удалось отправить сообщение по причине: " + Результат.message;
				РегистрыСведений.ТН_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ДанныеПрофиляПодключения.ВидИнтеграции, Идентификатор, ПредопределенноеЗначение("Перечисление.ТН_ВидыСобытийИнтеграции.Ошибка"), ТекстОшибки, ВидСообщения);
				
				СтруктураВозврата.Успех          = Ложь;
				СтруктураВозврата.ОписаниеОшибки = ТекстОшибки;
				
			Иначе
				
				СтруктураВозврата.Результат = Результат;
				
			КонецЕсли;
		Иначе
			
			СтруктураВозврата.Результат = Результат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
		
КонецФункции

Процедура ДобавитьЛогСообщенияИсходящего(ВидИнтеграции, XML_Пакет = Неопределено, XML_ПакетВходящий = Неопределено, ВидСообщения = "", ВидСобытия = "", ТекущийКлючЗаписи = Неопределено)
	
	Если Не ЗначениеЗаполнено(ТекущийКлючЗаписи) Тогда
		ТекущийКлючЗаписи = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ТН_Интеграция_ЛогСообщений.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.ВидИнтеграции.Установить(ВидИнтеграции);
	НаборЗаписей.Отбор.Ключ.Установить(ТекущийКлючЗаписи);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда 
		Запись = НаборЗаписей[0];
	Иначе 
		Запись = НаборЗаписей.Добавить();
	КонецЕсли;
	
	Запись.Период                              = ТекущаяДатаСеанса();
	Запись.Ключ                                = ТекущийКлючЗаписи;
	Запись.ВидИнтеграции                       = ВидИнтеграции;
	
	Если НЕ (XML_Пакет = Неопределено) Тогда 
		Запись.XML_ПакетИсходящий = XML_Пакет;
	КонецЕсли;
	
	Если НЕ (XML_ПакетВходящий = Неопределено) Тогда 
		Запись.XML_ПакетВходящий = XML_ПакетВходящий;
	КонецЕсли;
	
	Запись.УниверсальнаяДатаИсходящееСообщение = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если ЗначениеЗаполнено(ВидСообщения) Тогда 
		Запись.ВидСообщения = ВидСообщения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидСобытия) Тогда 
		Запись.ВидСобытия = ВидСобытия;
	КонецЕсли;
		
	НаборЗаписей.Записать(Истина);
			
КонецПроцедуры

Функция УИДСсылки(СсылкаНаОбъект)
	
	Возврат ?(ЗначениеЗаполнено(СсылкаНаОбъект), Строка(СсылкаНаОбъект.УникальныйИдентификатор()), "");
	
КонецФункции

Процедура УдалитьРегистрациюВыгруженныхЭД(УзелОбмена, СписокВыгруженныхЭД)
	
	Если СписокВыгруженныхЭД.Количество() Тогда
		
		Для Каждого ВыгруженныйЭД Из СписокВыгруженныхЭД Цикл
			
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ВыгруженныйЭД);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЛогОшибки(ОписаниеОшибки, ИмяОператора)
	
	КлючСообщения = Новый УникальныйИдентификатор;
	ВидИнтеграции = Перечисления.ТН_ВидыИнтеграций.TN_EDA;
	ВидСобытия    = Перечисления.ТН_ВидыСобытийИнтеграции.Ошибка;
	
	РегистрыСведений.ТН_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ВидИнтеграции, КлючСообщения, ВидСобытия, ОписаниеОшибки, ИмяОператора);
	
КонецПроцедуры

Процедура УдалитьРегистрациюВыгруженныхЭДДляУзла(УзелОбмена, СписокВыгруженныхЭД, ИмяОператора)
		
	РезультатЗапросаСписокЭДДляУдаленияРегистрации = ПолучитьРезультатЗапросаЭДДляУдаленияРегистрации_Диадок(УзелОбмена, СписокВыгруженныхЭД);
	
	Если Не РезультатЗапросаСписокЭДДляУдаленияРегистрации.Пустой() Тогда
				
		СписокЭДДляУдаленияРегистрации = Новый Массив;
				
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		
		Попытка
			
			ИмяСправочника = "Диадок_Документы";
			
			БлокировкаДанных                 = Новый БлокировкаДанных;
			ЭлементБлокировки                = БлокировкаДанных.Добавить("Справочник." + ИмяСправочника);
			ЭлементБлокировки.Режим          = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатЗапросаСписокЭДДляУдаленияРегистрации;
			
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "ИзмененныйОбъект");							
			БлокировкаДанных.Заблокировать();
						
			ВыборкаИзменения = РезультатЗапросаСписокЭДДляУдаленияРегистрации.Выбрать();
			
			Пока ВыборкаИзменения.Следующий() Цикл
				
				СписокЭДДляУдаленияРегистрации.Добавить(ВыборкаИзменения.ИзмененныйОбъект); 
				
			КонецЦикла;
			
			УдалитьРегистрациюВыгруженныхЭД(УзелОбмена, СписокЭДДляУдаленияРегистрации);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = СтрШаблон("Ошибка в методе ""УдалитьРегистрациюВыгруженныхЭДДляУзла"" по узлу %1 для оператора %2: %3", УзелОбмена, ИмяОператора
				, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ДобавитьЛогОшибки(ТекстОшибки, ИмяОператора);
			
		КонецПопытки;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ИнициализироватьОбработкуДиадок()
	
	КонтурЭДО = Обработки.КонтурДиадок.Создать();
	
	КонтурЭДО.ИнициализироватьОбщийКонтекст();
	
	Ядро 		   = КонтурЭДО.Модуль_Ядро();
	Идентификаторы = Ядро.Контракт_Идентификаторы();
	
	Логин  = Ядро.ОбщиеНастройки_Прочитать("СлужебнаяУчетнаяЗаписьЛогин");
	Пароль = Ядро.ОбщиеНастройки_Прочитать("СлужебнаяУчетнаяЗаписьПароль");
	
	Ядро.Авторизация_ПоПаролю(Логин, Пароль);
	
	Результат = Новый Структура;
	
	Результат.Вставить("Ядро", Ядро);
	Результат.Вставить("КонтурЭДО", КонтурЭДО);
	Результат.Вставить("Идентификаторы", Идентификаторы);
	
	Возврат Результат;
	
КонецФункции

Функция ИнициализироватьСтруктуруФайла()
	
	СтруктураФайла = Новый Структура;
	СтруктураФайла.Вставить("Файл", Неопределено);
	СтруктураФайла.Вставить("ИдентификаторФайла", "");
	
	Возврат СтруктураФайла;
	
КонецФункции

