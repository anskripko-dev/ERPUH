Функция ПолучитьКодСтраныПодписанта(Сертификат)
	
	СтранаПодписанта = "ru";
	
	Если Не ЗначениеЗаполнено(Сертификат) Тогда
		
		Возврат СтранаПодписанта;
		
	КонецЕсли;	
		
	Субъект = Неопределено;
	Сертификат.Свойство("Субъект", Субъект);
	
	Если Не ЗначениеЗаполнено(Субъект) Тогда
		
		Возврат СтранаПодписанта;
		
	КонецЕсли;
	
	СтранаПодписантаСертификата = Неопределено;
	Субъект.Свойство("C", СтранаПодписантаСертификата);
	
	Если ЗначениеЗаполнено(СтранаПодписантаСертификата) Тогда
		
		СтранаПодписанта = НРег(СтранаПодписантаСертификата);
		
	Иначе
		
		АлгоритмКлюча = Неопределено;
		
		Сертификат.Свойство("АлгоритмКлюча", АлгоритмКлюча);
		
		Если Не АлгоритмКлюча = Неопределено Тогда
						
			OID = Неопределено;
			АлгоритмКлюча.Свойство("oid", OID);
			
			Если ЗначениеЗаполнено(OID) Тогда
				
				СоответствиеOID = ПолучитьСоответствиеАлгоритмовПодписиПоСтранам();
				НайденныйИдентификатор = СоответствиеOID[OID];
				
				Если ЗначениеЗаполнено(НайденныйИдентификатор) Тогда
					
					СтранаПодписанта = НайденныйИдентификатор;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат СтранаПодписанта;
	
КонецФункции

