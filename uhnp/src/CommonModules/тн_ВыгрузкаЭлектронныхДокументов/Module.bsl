	СоответствиеТипов.Вставить("UniversalTransferDocumentRevision"  , "УПД ДОП (исправление)");
	СоответствиеТипов.Вставить("InvoiceCorrection"                  , "КСФ");
	СоответствиеТипов.Вставить("InvoiceCorrectionRevision"          , "КСФ (исправление)");
