
#Область ЗапускРегламентногоЗадания

Процедура ВыполнитьВыгрузкуЭлектронныхДокументов() Экспорт
	
	ВыгрузитьЭлектронныеДокументы();
	
КонецПроцедуры

Процедура ВыгрузитьЭлектронныеДокументы(ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		
		ДополнительныеПараметры = Новый Структура;
		
	КонецЕсли;
	
	СписокУзловОбмена = Новый Массив;	
	
	ВыборкаУзлов = ПланыОбмена.ЭлектронныеДокументы.Выбрать();
	
	Пока ВыборкаУзлов.Следующий() Цикл
		
		УзелОбмена = ВыборкаУзлов.Ссылка;
		
		Если УзелОбмена <> ПланыОбмена.ЭлектронныеДокументы.ЭтотУзел() Тогда
			
			СписокУзловОбмена.Добавить(УзелОбмена);
			ПланыОбмена.ВыбратьИзменения(УзелОбмена, 1);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка
		
		ОбработатьДанныеДляДиадок(СписокУзловОбмена, ДополнительныеПараметры)	
		
	Исключение
		
		ДобавитьЛогОшибки("Ошибка в методе ""ВыгрузитьЭлектронныеДокументы"": " + ОписаниеОшибки(), "Диадок");
		
	КонецПопытки;
		
КонецПроцедуры

#КонецОбласти		  

#Область ОбработкаДанных_ОператорДиадок

Процедура ОбработатьДанныеДляДиадок(СписокУзлов, ДополнительныеПараметры)
	
	ДанныеПрофиля = ПолучитьДанныеПрофиляХраненияФайловЭД(Перечисления.тн_ОператорыЭДО.Диадок);
	
	Если Не ДанныеПрофиля.Используется Тогда
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	СписокДопУсловий = Новый Массив;
	Если ДополнительныеПараметры.Свойство("СписокЭД") Тогда
		
		СписокДопУсловий.Добавить("Диадок_ДокументыИзменения.Ссылка В (&СписокЭД)");
		Запрос.УстановитьПараметр("СписокЭД", ДополнительныеПараметры.СписокЭД);
		РазмерПорцииДанных = 0;
	Иначе
		РазмерПорцииДанных = ДанныеПрофиля.КоличествоДокументовВПакете;
	КонецЕсли;
	
	СпособОтправкиСообщения = ДанныеПрофиля.СпособОтправки;
	
	Если СпособОтправкиСообщения = "RabbitMQ" Тогда
		ПрофильПодключенияRMQ = Справочники.тн_ПрофилиПодключений.RabbitMQ;
		Если Не ПрофильПодключенияRMQ.Использование Тогда
			ДобавитьЛогОшибки("Документы не выгружены в электронный архив, т.к. профиль RMQ выключен", "Диадок");
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	ТекстЗапроса = ПолучитьТекстЗапросаПоИзменениямДляОператора_Диадок(РазмерПорцииДанных);
		
	Если ДополнительныеПараметры.Свойство("ДатаНачала") Тогда
		
		СписокДопУсловий.Добавить("Диадок_ДокументыИзменения.Ссылка.ДатаЗагрузки >= &ДатаНачала");
		Запрос.УстановитьПараметр("ДатаНачала", ДополнительныеПараметры.ДатаНачала);
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("ДатаОкончания") Тогда
		
		СписокДопУсловий.Добавить("Диадок_ДокументыИзменения.Ссылка.ДатаЗагрузки <= &ДатаОкончания");
		Запрос.УстановитьПараметр("ДатаОкончания", ДополнительныеПараметры.ДатаОкончания);
		
	КонецЕсли;	
	
	Если СписокДопУсловий.Количество() Тогда
		
		СтрокаДополнительныеУсловия = СтрСоединить(СписокДопУсловий, " И ");	
		
	Иначе
		
		СтрокаДополнительныеУсловия = "ИСТИНА";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДополнительныеУсловия", СтрокаДополнительныеУсловия);
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СписокУзлов", СписокУзлов); 
	
	СписокЗавершающихСтатусов = ПолучитьМассивЗавершающихСтатусов();
	
	Запрос.УстановитьПараметр("СписокЗавершающихСтатусов", СписокЗавершающихСтатусов);
	
	МассивДляСнятияСРегистрации = Новый Массив;
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
						
		Попытка
			
			ДанныеДиадок = ИнициализироватьОбработкуДиадок();
			
		Исключение
			
			ДобавитьЛогОшибки("Ошибка инициализации обработки ""КонтурЭДО"" (метод ""ОбработатьДанныеДляДиадок""): " + ОписаниеОшибки(), "Диадок");
			
			Возврат;
			
		КонецПопытки; 
				
		ВыборкаУзел = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаУзел.Следующий() Цикл
						
			УзелОбмена = ВыборкаУзел.Узел;
							
			Выборка = ВыборкаУзел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Выборка.Следующий() Цикл
				
				ИдентификаторДляЛогов = СтрЗаменить(Выборка.id, " ", "");
				LetterIdДляЛогов = СтрЗаменить(Выборка.LetterId, " ", "");
				BoxIdДляЛогов = СтрЗаменить(Выборка.BoxId, " ", "");
				
				Если Не (ЗначениеЗаполнено(Выборка.id) И ЗначениеЗаполнено(Выборка.LetterId)) Тогда
					
					ТекстОшибки = СтрШаблон("Электронный документ Диадок %1 заполнен некорректно. 
											| ID=%2, LetterId=%3, Документ учета=%4",
											Строка(Выборка.ЭлектронныйДокумент), 
											ИдентификаторДляЛогов, 
											LetterIdДляЛогов, 
											Выборка.ДокументВладелец);
					ДобавитьЛогОшибки(ТекстОшибки, "Диадок");
					
					Продолжить;
					
				КонецЕсли; 
				
				// Получение файлов архива
				// НАЧАЛО Смирнов Д.А. 28.11.2025 Выполнение задач №000055967
				//ДД = ПолучитьАрхивДокументооборотаДиадок(ДанныеДиадок, Выборка.BoxId, Выборка.LetterId, Выборка.id);
				Попытка
					ДД = ПолучитьАрхивДокументооборотаДиадок(ДанныеДиадок, Выборка.BoxId, Выборка.LetterId, Выборка.id);
				Исключение
					ТекстОшибки = СтрШаблон("Не удалось получить архив документа из API Диадок (метод ""ОбработатьДанныеДляДиадок"") 
											|ДокументДиадок=%1, ID=%2, LetterId=%3, Документ учета=%4",
											Строка(Выборка.ЭлектронныйДокумент), 
											ИдентификаторДляЛогов, 
											LetterIdДляЛогов, 
											Выборка.ДокументВладелец);
					ДобавитьЛогОшибки(ТекстОшибки, "Диадок");
					
					Продолжить;
				КонецПопытки;
				// КОНЕЦ Смирнов Д.А. 28.11.2025 Выполнение задач №000055967	
				
				Если Не ТипЗнч(ДД) = Тип("ДвоичныеДанные") Тогда
					
					ТекстОшибки = СтрШаблон("Не удалось получить архив документа из API Диадок (метод ""ОбработатьДанныеДляДиадок"") 
											|ДокументДиадок=%1, ID=%2, LetterId=%3, Документ учета=%4",
											Строка(Выборка.ЭлектронныйДокумент), 
											ИдентификаторДляЛогов, 
											LetterIdДляЛогов, 
											Выборка.ДокументВладелец);
					ДобавитьЛогОшибки(ТекстОшибки, "Диадок");
					
					Продолжить;
					
				КонецЕсли;
				
				ДокументДиадок = Выборка.ЭлектронныйДокумент;
				
				// Формирование данных для отправки в EDA
				АдресДвоичныхДанныхАрхива = ПоместитьВоВременноеХранилище(ДД, Новый УникальныйИдентификатор);
				СтруктураФайловАрхива     = ПолучитьСодержимоеАрхива(АдресДвоичныхДанныхАрхива, Выборка.id);
				
				СтруктураДанныеПакетаXDTO = ПолучитьJSONДляОтправкиВАрхив(Выборка, СтруктураФайловАрхива, МассивДляСнятияСРегистрации, ДанныеДиадок);
				
				ДанныеПакетаXDTO = СтруктураДанныеПакетаXDTO.ДанныеПакетаXDTO;
				
				Если Не ЗначениеЗаполнено(ДанныеПакетаXDTO) Тогда
					
					ТекстОшибки = СтрШаблон("Для электронного документа Диадок %1 не удалось сформировать сообщение JSON. 
											|ID=%2, LetterId=%3, Документ учета=%4",
											Строка(Выборка.ЭлектронныйДокумент), 
											ИдентификаторДляЛогов, 
											LetterIdДляЛогов, 
											Выборка.ДокументВладелец);
					
					ДобавитьЛогОшибки(ТекстОшибки, "Диадок");
					
					Продолжить;	
					
				КонецЕсли;
				
				ТаблицаОтправленныхФайлов = СтруктураДанныеПакетаXDTO.ТаблицаОтправленныхФайлов;
				
				// Отправка данных в архив выбранным в профиле способом
				Если СпособОтправкиСообщения = "RabbitMQ" Тогда
					ПараметрыСообщения = Новый Структура;
					ПараметрыСообщения.Вставить("КлючМаршрутизации", Справочники.тн_ПроизводственныеПодразделения.ЭлектронныйАрхивЭДО);
					Ответ = ОтправитьСообщение(ДанныеПрофиля.НаименованиеСхемы, ДанныеПакетаXDTO, Перечисления.ТН_ВидыСообщенийTN_EDA.CreateDocument, ПараметрыСообщения); 
					
					Если Ответ.Успех Тогда
						
						ПараметрыЗаписи = ИнициализироватьСтруктуруПараметровЗаписиВыгруженногоЭД();					
						ПараметрыЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
						ПараметрыЗаписи.ПрофильХранения = ДанныеПрофиля.Ссылка;
						
						ПараметрыЗаписи.ДатаВыгрузки = ТекущаяДатаСеанса();
						Если ЗначениеЗаполнено(Ответ.ИсходящееСообщение) Тогда
							ПараметрыЗаписи.ИдентификаторСообщения = Ответ.ИсходящееСообщение;
						КонецЕсли;
						
						ЗафиксироватьВыгрузкуВРегистре(ПараметрыЗаписи, ТаблицаОтправленныхФайлов);
						
						МассивДляСнятияСРегистрации.Добавить(Выборка.ЭлектронныйДокумент);
						УдалитьРегистрациюВыгруженныхЭДДляУзла(УзелОбмена, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.ЭлектронныйДокумент), "Диадок");
						
					Иначе
						
						Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
							ТекстОшибки = СтрШаблон("Для электронного документа Диадок %1 не удалось отправить сообщение в ТН-EDA. 
													|ID=%2, LetterId=%3, Документ учета=%4
													|По причине: %5", 
													Строка(Выборка.ЭлектронныйДокумент), 
													ИдентификаторДляЛогов, 
													LetterIdДляЛогов, 
													Выборка.ДокументВладелец,
													Ответ.ОписаниеОшибки);
													
							ДобавитьЛогОшибки(ТекстОшибки, "Диадок");
						КонецЕсли;
						
					КонецЕсли;
				
				Иначе
					// RestAPI
					ПрофильПодключения = ПредопределенноеЗначение("Справочник.тн_ПрофилиПодключений.EDA");
					СообщениеСтрока = ПоместитьЗначениеВСтрокуJSON(ДанныеПакетаXDTO, "tn_eda", ДанныеПрофиля.НаименованиеСхемы);
					Результат = ВыполнитьМетодEDA(ПрофильПодключения, Новый УникальныйИдентификатор, СообщениеСтрока, "api/system/v1/documents", "POST", Перечисления.ТН_ВидыСообщенийTN_EDA.CreateDocument);
					
					Если Результат.Успех Тогда
						
						ПараметрыЗаписи = ИнициализироватьСтруктуруПараметровЗаписиВыгруженногоЭД();					
						ПараметрыЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
						ПараметрыЗаписи.ПрофильХранения = ДанныеПрофиля.Ссылка;
						
						ПараметрыЗаписи.ДатаВыгрузки = ТекущаяДатаСеанса();
						ПараметрыЗаписи.ИдентификаторСообщения = Результат.ID_EDA; 
						
						ЗафиксироватьВыгрузкуВРегистре(ПараметрыЗаписи, ТаблицаОтправленныхФайлов);
						
						МассивДляСнятияСРегистрации.Добавить(Выборка.ЭлектронныйДокумент);
						УдалитьРегистрациюВыгруженныхЭДДляУзла(УзелОбмена, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.ЭлектронныйДокумент), "Диадок");
						
					Иначе
						
						Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
							ТекстОшибки = СтрШаблон("Для электронного документа Диадок %1 не удалось отправить сообщение в ТН-EDA. 
													|ID=%2, LetterId=%3, Документ учета=%4
													|По причине: %5", 
													Строка(Выборка.ЭлектронныйДокумент), 
													ИдентификаторДляЛогов, 
													LetterIdДляЛогов, 
													Выборка.ДокументВладелец,
													Ответ.ОписаниеОшибки);
													
							ДобавитьЛогОшибки(ТекстОшибки, "Диадок");
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если МассивДляСнятияСРегистрации.Количество() > 0 Тогда
				УдалитьРегистрациюВыгруженныхЭДДляУзла(УзелОбмена, МассивДляСнятияСРегистрации, "Диадок");
			КонецЕсли;
			
		КонецЦикла;
		
		ДанныеДиадок.КонтурЭДО.ЗавершитьРаботуМодуля();
				
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьТекстЗапросаПоИзменениямДляОператора_Диадок(РазмерПорцииДанных = 0)
	
	ВыбратьПервые = ?(РазмерПорцииДанных = 0, "", "ПЕРВЫЕ " + Формат(РазмерПорцииДанных, "ЧГ="));
	
	ТекстЗапроса =
	//Для отладки в консоли запросов обратите внимание, что по умолчанию "ПЕРВЫЕ 1"!!! Замена происходит ниже,
	//чтобы иметь возможность заходить в конструктор запроса
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	Диадок_ДокументыИзменения.Узел КАК Узел,
	|	Диадок_ДокументыИзменения.Ссылка КАК ИзмененныйОбъект,
	|	Диадок_ДокументыИзменения.Ссылка.ОрганизацияДиадок КАК ОрганизацияДиадок,
	|	Диадок_ДокументыИзменения.Ссылка.КонтрагентДиадок КАК КонтрагентДиадок,
	|	Диадок_ДокументыИзменения.Ссылка.Статус В (&СписокЗавершающихСтатусов) КАК ЭДОЗавершен,
	|	Диадок_ДокументыИзменения.Ссылка.LetterId КАК LetterId
	|ПОМЕСТИТЬ ВТ_СписокОбъектов
	|ИЗ
	|	Справочник.Диадок_Документы.Изменения КАК Диадок_ДокументыИзменения
	|ГДЕ
	|	Диадок_ДокументыИзменения.Узел В(&СписокУзлов)
	|	И Диадок_ДокументыИзменения.НомерСообщения = 1
	|	И &ДополнительныеУсловия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_СписокОбъектов.Узел КАК Узел,
	|	ВТ_СписокОбъектов.ИзмененныйОбъект КАК ИзмененныйОбъект,
	|	ВТ_СписокОбъектов.ОрганизацияДиадок КАК ОрганизацияДиадок,
	|	ВТ_СписокОбъектов.КонтрагентДиадок КАК КонтрагентДиадок,
	|	ВТ_СписокОбъектов.ЭДОЗавершен КАК ЭДОЗавершен,
	|	ВТ_СписокОбъектов.ИзмененныйОбъект.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_СписокИзмененныхОбъектов
	|ИЗ
	|	ВТ_СписокОбъектов КАК ВТ_СписокОбъектов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_СписокИзмененныхОбъектов.Узел КАК Узел,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект КАК ЭлектронныйДокумент,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.DocumentId КАК id,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.ИмяФайла КАК name,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.Статус КАК original_status,
	|	ВЫБОР
	|		КОГДА ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.ДатаЗагрузки
	|		ИНАЧЕ ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.ДатаДокумента
	|	КОНЕЦ КАК issued_at_utc,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.НомерДокумента КАК number,
	|	ВЫБОР
	|		КОГДА ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.Направление = ""Входящее""
	|			ТОГДА ""incoming""
	|		КОГДА ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.Направление = ""Исходящее""
	|			ТОГДА ""outgoing""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК direction,
	|	""ДИАДОК"" КАК edo_operator,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.ТипДокумента КАК edo_type,
	|	ВТ_СписокИзмененныхОбъектов.ЭДОЗавершен КАК edo_completed,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.СуммаДокумента КАК amount,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.Валюта КАК currency,
	|	ЛОЖЬ КАК confidential,
	|	ВЫРАЗИТЬ(ВТ_СписокИзмененныхОбъектов.ОрганизацияДиадок.СвязанныйСправочник1 КАК Справочник.Организации).ИНН КАК inn,
	|	ВЫРАЗИТЬ(ВТ_СписокИзмененныхОбъектов.ОрганизацияДиадок.СвязанныйСправочник1 КАК Справочник.Организации).КПП КАК kpp,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.BoxId КАК BoxId,
	|	ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.LetterId КАК LetterId,
	|	ВТ_СписокИзмененныхОбъектов.Документ КАК ДокументВладелец,
	|	Диадок_ДокументыСвязанные.DocumentId КАК LinkedDocumentId
	|ИЗ
	|	ВТ_СписокИзмененныхОбъектов КАК ВТ_СписокИзмененныхОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы КАК Диадок_ДокументыСвязанные
	|		ПО ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект.LetterId = Диадок_ДокументыСвязанные.LetterId
	|			И (НЕ ВТ_СписокИзмененныхОбъектов.ИзмененныйОбъект = Диадок_ДокументыСвязанные.Ссылка)
	|ИТОГИ
	|	МАКСИМУМ(id),
	|	МАКСИМУМ(name),
	|	МАКСИМУМ(original_status),
	|	МАКСИМУМ(issued_at_utc),
	|	МАКСИМУМ(number),
	|	МАКСИМУМ(direction),
	|	МАКСИМУМ(edo_operator),
	|	МАКСИМУМ(edo_type),
	|	МАКСИМУМ(edo_completed),
	|	МАКСИМУМ(amount),
	|	МАКСИМУМ(currency),
	|	МАКСИМУМ(confidential),
	|	МАКСИМУМ(inn),
	|	МАКСИМУМ(kpp),
	|	МАКСИМУМ(BoxId),
	|	МАКСИМУМ(LetterId),
	|	МАКСИМУМ(ДокументВладелец)
	|ПО
	|	Узел,
	|	ЭлектронныйДокумент";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПЕРВЫЕ 1", ВыбратьПервые);
	        
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьРезультатЗапросаЭДДляУдаленияРегистрации_Диадок(УзелОбмена, СписокВыгруженныхЭД)
	
	СписокЭДДляУдаленияРегистрации = Новый Массив;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Диадок_ДокументыИзменения.Ссылка КАК ИзмененныйОбъект
	|ИЗ
	|	Справочник.Диадок_Документы.Изменения КАК Диадок_ДокументыИзменения
	|ГДЕ
	|	Диадок_ДокументыИзменения.Узел = &УзелОбмена
	|	И Диадок_ДокументыИзменения.Ссылка В(&СписокВыгруженныхЭД)
	|	И Диадок_ДокументыИзменения.НомерСообщения = 1";	
	
	Запрос.УстановитьПараметр("СписокВыгруженныхЭД", СписокВыгруженныхЭД);
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат;

КонецФункции

