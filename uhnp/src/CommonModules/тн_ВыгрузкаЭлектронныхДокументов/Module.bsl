Функция ПолучитьСвязанныеДокументы(ВыборкаДокумент)
	
	//У диадок не хранятся квитанции, поэтому будет только linked_ids
		
	МассивСвязанных = Новый Массив;
	
	ВыборкаСвязанныеИдентификаторы = ВыборкаДокумент.Выбрать();
	
	Пока ВыборкаСвязанныеИдентификаторы.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаСвязанныеИдентификаторы.LinkedDocumentId) Тогда
			
			МассивСвязанных.Добавить(ВыборкаСвязанныеИдентификаторы.LinkedDocumentId);	
			
		КонецЕсли;
		
	КонецЦикла;                                                                   
	
	Возврат МассивСвязанных;
	
КонецФункции

Функция ПолучитьПросматривающих(ВыборкаДокумент)
	
	viewers = Новый Массив;	
	
	viewer = Новый Структура;
	viewer.Вставить("type", "entity");
	viewer.Вставить("tax_id", ВыборкаДокумент.inn);
	viewer.Вставить("kpp", ВыборкаДокумент.kpp);
	
	viewers.Добавить(viewer);
	
	Возврат viewers;
	
КонецФункции

Функция ПолучитьДанныеДокумента(ВыборкаДокумент)
	
	ПрофильПодключения = Справочники.тн_ПрофилиПодключений.EDA;
	Идентификатор      = Новый УникальныйИдентификатор;
	
	//Структура, где есть массивы: revoke_ids и linked_ids
	linked_ids = ПолучитьСвязанныеДокументы(ВыборкаДокумент);
	
	//Массив с атрибутами: type, tax_id, kpp
	viewers = ПолучитьПросматривающих(ВыборкаДокумент);
	
	//Если документ имеет статус НеСформирован или НеПолучен, то такой документ нужго снимать с регистрации до тех пор, 
	//пока он не будет получен или сформирован.
	
	СтатусEDA = ПолучитьСтатусEDA_Диадок(ВыборкаДокумент.original_status);
	
	Если Не ЗначениеЗаполнено(СтатусEDA) Тогда
		
		ОшибкаСтатуса = "Не удалось определить статус '" + Строка(ВыборкаДокумент.СостояниеСсылка) + "'"
			+ Символы.ПС + "Для документа: " + ВыборкаДокумент.name;
		
		РегистрыСведений.ТН_Интеграция_ЛогСообщений.ДобавитьЛогОшибки(ПрофильПодключения.ВидИнтеграции, 
			Идентификатор, ПредопределенноеЗначение("Перечисление.ТН_ВидыСобытийИнтеграции.Ошибка"), ОшибкаСтатуса, Перечисления.ТН_ВидыСообщенийTN_EDA.CreateDocument);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	document = Новый Структура;
	document.Вставить("id"           , ВыборкаДокумент.id);
	document.Вставить("system_id"    , XMLСтрока(Справочники.тн_ПроизводственныеПодразделения.НайтиПоКоду(800)));
	document.Вставить("external_id"  , УИДСсылки(ВыборкаДокумент.ЭлектронныйДокумент));
	document.Вставить("group"        , ПолучитьГруппуДокумента_Диадок(ВыборкаДокумент.edo_type));
	document.Вставить("name"         , ВыборкаДокумент.name);
	document.Вставить("status"       , СтатусEDA);
	document.Вставить("issued_at_utc", ДатаВUTC(ВыборкаДокумент.issued_at_utc));
	
	Если ЗначениеЗаполнено(ВыборкаДокумент.original_status) Тогда
		document.Вставить("original_status", ВыборкаДокумент.original_status);
	КонецЕсли; 
	
	//Если ЗначениеЗаполнено(ВыборкаДокумент.updated_at_utc) Тогда
	//	document.Вставить("updated_at_utc", ДатаВUTC(ВыборкаДокумент.updated_at_utc));
	//КонецЕсли;
		
	Если ЗначениеЗаполнено(ВыборкаДокумент.number) Тогда
		document.Вставить("number", ВыборкаДокумент.number);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыборкаДокумент.direction) Тогда
		document.Вставить("direction", ВыборкаДокумент.direction);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыборкаДокумент.edo_operator) Тогда
		document.Вставить("edo_operator", ВыборкаДокумент.edo_operator);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыборкаДокумент.edo_type) Тогда
		document.Вставить("edo_type", ВыборкаДокумент.edo_type);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыборкаДокумент.edo_completed) Тогда
		document.Вставить("edo_completed", ВыборкаДокумент.edo_completed);
	КонецЕсли; 
	
	//Идентификатор госконтракта
	Если ЗначениеЗаполнено(ВыборкаДокумент.ДокументВладелец) Тогда
		
		Попытка
			ДоговорДокумента = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ПолучитьДоговор(ВыборкаДокумент.ДокументВладелец);
		Исключение
			ДоговорДокумента = Неопределено;	
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ДоговорДокумента) Тогда
			
			ИдентификаторГосКонтракта = ДоговорДокумента.ИдентификаторГосКонтракта;
			
			Если ЗначениеЗаполнено(ИдентификаторГосКонтракта) Тогда
				
				document.Вставить("state_contract_id", ИдентификаторГосКонтракта);
				
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ВыборкаДокумент.amount) Тогда
		СуммаДокумента = Окр(ВыборкаДокумент.amount);

		document.Вставить("amount", СуммаДокумента);
	КонецЕсли; 

	Если ЗначениеЗаполнено(ВыборкаДокумент.currency) Тогда
		ВалютаДокумента = ПолучитьНаименованиеВалютыПоКоду(ВыборкаДокумент.currency);
		Если ЗначениеЗаполнено(ВалютаДокумента) Тогда
			document.Вставить("currency", ВалютаДокумента);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаДокумент.confidential) Тогда
		document.Вставить("confidential", ВыборкаДокумент.confidential);
	КонецЕсли; 
	
	Если linked_ids.Количество() > 0 Тогда
		related_documents = Новый Структура;
		related_documents.Вставить("linked_ids", linked_ids);
		
		document.Вставить("related_documents", related_documents);
	КонецЕсли; 
	
	Если viewers.Количество() > 0 Тогда
		document.Вставить("viewers", viewers);
	КонецЕсли; 
	
	Возврат document;
	
КонецФункции

// Получить наименование валюты по коду с учетом кэша.
// 
// Параметры:
//  КодВалюты - Строка - Код валюты
// 
// Возвращаемое значение:
//  Строка, Произвольный - Получить наименование валюты по коду с учетом кэша
Функция ПолучитьНаименованиеВалютыПоКоду(КодВалюты)
		
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("КодВалюты", СокрЛП(КодВалюты));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Валюты.Наименование
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Код = &КодВалюты
	|	И Не Валюты.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	НаименованиеВалюты = СокрЛП(СтрЗаменить(Выборка.Наименование, ".", ""));
	
	Возврат ?(СтрДлина(НаименованиеВалюты) = 3, НаименованиеВалюты, "RUB");
	
КонецФункции

Функция ПолучитьДанныеФайлов(ВыборкаДокумент, СтруктураФайловАрхива, ДанныеДиадок)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("МассивФайловJSON", Новый Массив);
	СтруктураВозврата.Вставить("ТаблицаОтправленныхФайлов", Неопределено);
	
	ТаблицаОтправленныхФайлов = Новый ТаблицаЗначений;
	ТаблицаОтправленныхФайлов.Колонки.Добавить("ЭлектронныйДокумент");
	ТаблицаОтправленныхФайлов.Колонки.Добавить("ИмяФайла");
	ТаблицаОтправленныхФайлов.Колонки.Добавить("ИдентификаторФайла");
	ТаблицаОтправленныхФайлов.Колонки.Добавить("ХешФайла");
	
	Если Не ТипЗнч(СтруктураФайловАрхива) = Тип("Структура") Тогда
		
		Возврат СтруктураВозврата;	
		
	КонецЕсли;
	
	МассивФайловJSON = Новый Массив;
	
	Файлы     = Неопределено;
	Выполнено = Неопределено;
	
	СтруктураФайловАрхива.Свойство("Файлы"    , Файлы);
	СтруктураФайловАрхива.Свойство("Выполнено", Выполнено);
	
	Если Выполнено = Истина Тогда
		
		ИдентификаторЭД = ВыборкаДокумент.id;
		ЭлектронныйДокумент = ВыборкаДокумент.ЭлектронныйДокумент;
		
		Если ТипЗнч(Файлы) = Тип("Соответствие") Тогда
			
			СтруктураФайлов        = ПолучитьФайлыСИдентификаторами(ЭлектронныйДокумент, Файлы);
			МассивНовыхФайлов      = СтруктураФайлов.МассивНовыхФайлов;
			СоответствиеИмениИХеша = СтруктураФайлов.СоответствиеИмениИХеша;
			СоответствиеФайлов     = ОтделитьПодписиОтОстальныхФайлов_Диадок(МассивНовыхФайлов);
						
			МассивФайлов   = СоответствиеФайлов["МассивФайлов"];
			МассивПодписей = СоответствиеФайлов["МассивПодписей"];
			
			Для Каждого стрФайл Из МассивФайлов Цикл
				
				ТекущийФайл = стрФайл.Файл;
				
				РасширениеФайла    = ?(ЗначениеЗаполнено(ТекущийФайл.Расширение), ТекущийФайл.Расширение, ".pdf");
				ИмяБезРасширения   = ТекущийФайл.ИмяБезРасширения;
				ИдентификаторФайла = стрФайл.ИдентификаторФайла;
				Если Не ЗначениеЗаполнено(ИдентификаторФайла) Тогда
					ИдентификаторФайла = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
				
				ИмяФайла = ТекущийФайл.Имя;
				
				НСВыгруженныйФайл = ТаблицаОтправленныхФайлов.Добавить();
				НСВыгруженныйФайл.ЭлектронныйДокумент = ЭлектронныйДокумент;
				НСВыгруженныйФайл.ИмяФайла = ИмяФайла;
				НСВыгруженныйФайл.ИдентификаторФайла = Строка(ИдентификаторФайла);
				НСВыгруженныйФайл.ХешФайла = СоответствиеИмениИХеша[ИмяФайла];
				
				МассивПодписантов  = Новый Массив;
								
				Двоичные = Новый ДвоичныеДанные(ТекущийФайл.ПолноеИмя);
				Контент = Base64Строка(Двоичные);
				Контент = СтрЗаменить(СтрЗаменить(Контент, Символы.ПС, ""), Символы.ВК, "");
				
				СтруктураФайла = Новый Структура;
				
				СтруктураФайла.Вставить("id"     , ИдентификаторФайла);
				СтруктураФайла.Вставить("type"   , СтрЗаменить(РасширениеФайла, ".", ""));
				СтруктураФайла.Вставить("name"   , ИмяБезРасширения);
				СтруктураФайла.Вставить("content", Контент);
				
				МассивПодписейФайла = ПолучитьПодписиФайлаПоИмени(ИмяБезРасширения, МассивПодписей);
				
				Если МассивПодписейФайла.Количество() > 0 Тогда
					
					Для Каждого стрПодпись Из МассивПодписейФайла Цикл
						
						ТекПодпись = стрПодпись.Файл;
						ДвоичныеДанныеПодписи = Новый ДвоичныеДанные(ТекПодпись.ПолноеИмя); 
						
						Если Не ТипЗнч(ДвоичныеДанныеПодписи) = Тип("ДвоичныеДанные") Тогда
							
							Продолжить;	
							
						КонецЕсли;
						
						ДДПодписи = Новый ДвоичныеДанные(ТекПодпись.ПолноеИмя);
						КонтентПодписи = Base64Строка(ДДПодписи);
						КонтентПодписи = СтрЗаменить(СтрЗаменить(КонтентПодписи, Символы.ПС, ""), Символы.ВК, "");
						
						Сертификат = ДанныеДиадок.Ядро.ПолучитьСертификатИзПодписи(ДвоичныеДанныеПодписи);
						
						Если Не ЗначениеЗаполнено(Сертификат) Тогда
							
							Продолжить;
							
						КонецЕсли;	
							
						Субъект = Неопределено;
						Сертификат.Свойство("Субъект", Субъект);
						
						Если Не ЗначениеЗаполнено(Субъект) Тогда
							
							Продолжить;
							
						КонецЕсли;	
												
						Если Субъект.Свойство("ИННЮЛ") Тогда
							
							ТипПодписанта = "entity";
							ИНН = Субъект.ИННЮЛ;
							
						Иначе
							
							ТипПодписанта = "individual";
							ИНН = Субъект.ИНН;
							
						КонецЕсли;
						
						СтруктураПодписанта = Новый Структура;
						СтруктураПодписанта.Вставить("type", ТипПодписанта);
						СтруктураПодписанта.Вставить("tax_id", ИНН);
						//СтруктураПодписи.Вставить("kpp", "");
						//СтруктураПодписи.Вставить("authority_type", );
						//СтруктураПодписи.Вставить("authority_id", );
						// НАЧАЛО Смирнов Д.А. 27.11.2025 Выполнение задач №000055967
						//СтруктураПодписанта.Вставить("country", НРег(Субъект.C));
						СтруктураПодписанта.Вставить("country", ПолучитьКодСтраныПодписанта(Сертификат));
						// КОНЕЦ Смирнов Д.А. 27.11.2025 Выполнение задач №000055967	
						
						ИмяПодписи = ТекПодпись.Имя;
						
						ИдентификаторПодписи = стрПодпись.ИдентификаторФайла;
						Если Не ЗначениеЗаполнено(ИдентификаторПодписи) Тогда
							ИдентификаторПодписи = Строка(Новый УникальныйИдентификатор);
						КонецЕсли;
						
						НСВыгруженнаяПодпись = ТаблицаОтправленныхФайлов.Добавить();
						НСВыгруженнаяПодпись.ЭлектронныйДокумент = ЭлектронныйДокумент;
						НСВыгруженнаяПодпись.ИмяФайла = ИмяПодписи;
						НСВыгруженнаяПодпись.ИдентификаторФайла = ИдентификаторПодписи;
						НСВыгруженнаяПодпись.ХешФайла = СоответствиеИмениИХеша[ИмяПодписи];
						
						СтруктураПодписи = Новый Структура;
						СтруктураПодписи.Вставить("content", КонтентПодписи);
						СтруктураПодписи.Вставить("type", "qualified_electronic_signature");
					
						Если Субъект.Свойство("SN") И Субъект.Свойство("G") Тогда // SN - Фамилия, G - Имя и отчество
							
							ФИО = Субъект.SN + " " + Субъект.G;
							
						ИначеЕсли Субъект.Свойство("CN") Тогда // Наименование организации
							
							ФИО = Субъект.CN;
							
						Иначе
							
							ФИО = "";
							
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ФИО) Тогда
							
							СтруктураПодписи.Вставить("fio", ФИО);	
							
						КонецЕсли;
						
						СтруктураПодписанта.Вставить("signature", СтруктураПодписи);
						
						МассивПодписантов.Добавить(СтруктураПодписанта);
						
					КонецЦикла;
					
					Если МассивПодписантов.Количество() > 0 Тогда
						
						СтруктураФайла.Вставить("signatories", МассивПодписантов);
						
					КонецЕсли;
						
				КонецЕсли;
				
				МассивФайловJSON.Добавить(СтруктураФайла);
				
			КонецЦикла;
						
		КонецЕсли;
				
	КонецЕсли;
	
	СтруктураВозврата.ТаблицаОтправленныхФайлов = ТаблицаОтправленныхФайлов;
	СтруктураВозврата.МассивФайловJSON          = МассивФайловJSON;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьJSONДляОтправкиВАрхив(ВыборкаДокумент, СтруктураФайловАрхива, МассивДляСнятияСРегистрации, ДанныеДиадок)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ДанныеПакетаXDTO", Неопределено);
	СтруктураВозврата.Вставить("ТаблицаОтправленныхФайлов", Неопределено);
	
	ДанныеПакетаXDTO = Новый Структура;
	
	// headers
	headers = Новый Структура;
	headers.Вставить("messageGUID" , Строка(Новый УникальныйИдентификатор()));								// Уникальный uid отправляемого пакета
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//headers.Вставить("sendDateUTC" , тн_Интеграция_УПП.ДатаВUTC(тн_Интеграция_УПП.ТекущаяДатаСервера()));	// Дата отправки пакета
	headers.Вставить("sendDateUTC" , тн_Интеграция_УПП.ДатаВUTC(ТекущаяДатаСервера()));	// Дата отправки пакета
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	headers.Вставить("systemSender", тн_Интеграция_УПП.КлючОтправителя());									// Уникальный uid системы отправителя
	
	ДанныеПакетаXDTO.Вставить("headers", headers);
	
	СтруктураФайлов = ПолучитьДанныеФайлов(ВыборкаДокумент, СтруктураФайловАрхива, ДанныеДиадок);
	
	ТаблицаОтправленныхФайлов = СтруктураФайлов.ТаблицаОтправленныхФайлов;
	files = СтруктураФайлов.МассивФайловJSON;
		
	Попытка      
		
		УдалитьФайлы(СтруктураФайловАрхива.ВременныйКаталог);
		
	Исключение
		
		ТекстОшибки = СтрШаблон("Не получилось удалить временный каталог '%1' распакованного архива
								|по причине: %2.
								|BoxID = %3
								|LetterId = %4
								|DocumentId = %5", 
								Строка(СтруктураФайловАрхива.ВременныйКаталог),
								ОписаниеОшибки(),
								ВыборкаДокумент.BoxId,
								ВыборкаДокумент.LetterId,
								ВыборкаДокумент.id);
								
		ДобавитьЛогОшибки(ТекстОшибки, "Диадок");
		
	КонецПопытки;
	
	document = ПолучитьДанныеДокумента(ВыборкаДокумент);
	
	ДанныеПакетаXDTO.Вставить("document", document);
	ДанныеПакетаXDTO.Вставить("files"   , files);
	
	СтруктураВозврата.ДанныеПакетаXDTO = ДанныеПакетаXDTO;
	СтруктураВозврата.ТаблицаОтправленныхФайлов = ТаблицаОтправленныхФайлов;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПоместитьЗначениеВСтрокуJSON(Данные, ИмяПакета, ИмяТипаПакета) Экспорт
	
	Контейнер = ТН_Интеграция.СоздатьКонтейнерXDTO(ИмяПакета, ИмяТипаПакета);	
	
	ПоместитьСтруктуруВОбъектXDTO(Данные, Контейнер);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	
	ФабрикаXDTO.ЗаписатьJSON(ЗаписьJSON, Контейнер, НазначениеТипаXML.Неявное);		
	
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	МассивСтрок = СтрРазделить(СтрокаJSON, Символы.ПС);
	
	МассивСтрок.Удалить(1);
	МассивСтрок.Удалить(МассивСтрок.ВГраница());
	
	СтрокаJSON = СтрСоединить(МассивСтрок, Символы.ПС);
	
	//СтрокаJSON = СкорректироватьПредставлениеПустыхСписковJSON(СтрокаJSON, МассивИменПустыхСписков);
	
	Возврат СтрокаJSON;
	
КонецФункции

Функция ПоместитьСтруктуруВОбъектXDTO(Данные, ОбъектXDTO)
	
	Для Каждого КлючИзначение Из Данные Цикл 
		
		ИмяАтрибута       = КлючИзначение.Ключ;
		ЗначениеАтрибута  = КлючИзначение.Значение;
		
		Если ТипЗнч(ЗначениеАтрибута) = Тип("Структура") Тогда
			
			ОбъектАтрибута			= ФабрикаXDTO.Создать(ОбъектXDTO.Свойства().Получить(ИмяАтрибута).Тип);
			ОбъектXDTO[ИмяАтрибута] = ПоместитьСтруктуруВОбъектXDTO(ЗначениеАтрибута, ОбъектАтрибута);
			
		ИначеЕсли ТипЗнч(ЗначениеАтрибута) = Тип("Массив") Тогда 
			
			ОбъектXDTO[ИмяАтрибута] = ПоместитьМассивВОбъектXDTO(ЗначениеАтрибута, ОбъектXDTO, ИмяАтрибута);
						
		Иначе
			
			ЗаполнитьАтрибутОбъектаXDTO(ОбъектXDTO, ИмяАтрибута, ЗначениеАтрибута);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ПоместитьМассивВОбъектXDTO(Данные, ОбъектXDTO, ИмяСвойстваСпискаXDTO)
	
	ОбъектСписка = ФабрикаXDTO.Создать(ОбъектXDTO.Свойства().Получить(ИмяСвойстваСпискаXDTO).Тип);
	СписокXDTO 	 = ОбъектСписка[ОбъектСписка.Свойства()[0].Имя];
	ТипЭлемента  = СписокXDTO.ВладеющееСвойство.Тип;
	
	Для Каждого ЭлементДанных Из Данные Цикл
		
		ЭлементСписка = ФабрикаXDTO.Создать(ТипЭлемента);
		
		Если ТипЗнч(ЭлементДанных) = Тип("Структура") Тогда
			
			ПоместитьСтруктуруВОбъектXDTO(ЭлементДанных, ЭлементСписка);
			
		КонецЕсли;
		
		Если ЭлементСписка = Неопределено Тогда 
			
			ЭлементСписка = ЭлементДанных;
			
		КонецЕсли;
		
		СписокXDTO.Добавить(ЭлементСписка);
		
	КонецЦикла; 
	
	Возврат ОбъектСписка;
	
КонецФункции

Процедура ЗаполнитьАтрибутОбъектаXDTO(СвойствоXDTO, ИмяАтрибута, ЗначениеАтрибута)
	
	ТипBoolean  = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema","boolean");	
	ТипDateTime = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema","dateTime");
	ТипDate		= ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema","date");
	
	ТекущееСвойствоXDTO = СвойствоXDTO.Свойства().Получить(ИмяАтрибута);
		
	Если Не (ТекущееСвойствоXDTO.ЗначениеПоУмолчанию = Неопределено) Тогда
		
		ЗначениеПоУмолчанию = ТекущееСвойствоXDTO.ЗначениеПоУмолчанию.Значение;
		
	Иначе
		
		Если ТекущееСвойствоXDTO.Тип = ТипBoolean Тогда
			
			ЗначениеПоУмолчанию = Ложь;
			
		ИначеЕсли ТекущееСвойствоXDTO.Тип = ТипDateTime Тогда
			
			ЗначениеПоУмолчанию = Дата(1, 1, 1, 0, 0, 0);
			
		ИначеЕсли ТекущееСвойствоXDTO.Тип = ТипDate Тогда 
			
			ЗначениеПоУмолчанию = Дата(1, 1, 1);
			
		Иначе 
			
			ЗначениеПоУмолчанию = "";
			
		КонецЕсли;					
		
	КонецЕсли;
	
	Если (ЗначениеАтрибута = NULL) ИЛИ (ЗначениеАтрибута = Неопределено) Тогда
		
		СвойствоXDTO[ИмяАтрибута] = ЗначениеПоУмолчанию;
		
	Иначе
		
		СвойствоXDTO[ИмяАтрибута] = ЗначениеАтрибута;
		
	КонецЕсли;
																						
КонецПроцедуры

