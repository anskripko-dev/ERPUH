		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ТаблицаСерий.СерияНоменклатурыДляЦенообразования, ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка))
		|	КОНЕЦ КАК СерияЦО,
		|	ВЫБОР
		|		КОГДА
		|			ТаблицаВидовНоменклатуры.НастройкиКлючаЦенПоУпаковке = ЗНАЧЕНИЕ(Перечисление.ВариантОтбораДляКлючаЦен.НеИспользовать)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|		ИНАЧЕ ТаблицаТовары.Упаковка
		|	КОНЕЦ КАК УпаковкаЦО
		|ПОМЕСТИТЬ ТаблицаТоварыДоп
		|ИЗ
		|	ВтИсточникДанных КАК ТаблицаТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТаблицаНоменклатуры
		|		ПО ТаблицаТовары.Номенклатура = ТаблицаНоменклатуры.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ТаблицаХарактеристик
		|		ПО ТаблицаТовары.Характеристика = ТаблицаХарактеристик.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК ТаблицаСерий
		|		ПО &ПолеСерия = ТаблицаСерий.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ТаблицаВидовНоменклатуры
		|		ПО ТаблицаНоменклатуры.ВидНоменклатуры = ТаблицаВидовНоменклатуры.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	ХарактеристикаЦО,
		|	СерияЦО,
		|	УпаковкаЦО,
		|	ВидЦены";
		
	КонецЕсли;
	
	Если ПакетнаяОбработкаТабличнойЧастиСервер.ЕстьКолонкаВИсточникеДанных("ВидЦены", КэшированныеЗначения) Тогда
		ПолеВидЦены = "ТаблицаТовары.ВидЦены";
	Иначе
		ПолеВидЦены = "ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ПолеВидЦены",
		ПолеВидЦены);
	
	Если ПакетнаяОбработкаТабличнойЧастиСервер.ЕстьКолонкаВИсточникеДанных("Серия", КэшированныеЗначения) Тогда
		ПолеСерия = "ТаблицаТовары.Серия";
	Иначе
		ПолеСерия = "ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ПолеСерия",
		ПолеСерия);
	
	Результат.Добавить(ТекстЗапроса, "ТаблицаТоварыДоп");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ВидЦены КАК ВидЦены,
	|	МИНИМУМ(ВложенныйЗапрос.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ ВременнаяТаблицаВидыЦен
	|ИЗ
	|	&ТекстЗапросаИсточникаУсловияПродаж КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.ВидЦены <> ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ВидЦены";
	
	ЗаполнятьПоСоглашению = ЗначениеЗаполнено(ПараметрыДействия.Соглашение);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаИсточникаУсловияПродаж",
		ТекстЗапросаИсточникаУсловияПродаж(ЗаполнятьПоСоглашению));
	
	Результат.Добавить(ТекстЗапроса, "ВременнаяТаблицаВидыЦен");
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВременнаяТаблицаВидыЦен.Приоритет), 0) + 1 КАК Значение
	|ПОМЕСТИТЬ СдвигНизкогоПриоритета
	|ИЗ
	|	ВременнаяТаблицаВидыЦен КАК ВременнаяТаблицаВидыЦен";
	Результат.Добавить(ТекстЗапроса, "СдвигНизкогоПриоритета");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаОтбора.ИдентификаторСтрокиВТ КАК ИдентификаторСтрокиВТ,
	|	ТаблицаОтбора.Номенклатура КАК Номенклатура,
	|	ТаблицаОтбора.Упаковка КАК Упаковка,
	|	ТаблицаОтбора.ХарактеристикаЦО КАК ХарактеристикаЦО,
	|	ТаблицаОтбора.СерияЦО КАК СерияЦО,
	|	ТаблицаОтбора.УпаковкаЦО КАК УпаковкаЦО,
	|	&ЗначениеВидаЦенПоИсточнику КАК ВидЦены,
	|	ЕСТЬNULL(МИНИМУМ(ВременнаяТаблицаВидыЦен.Приоритет), 0) КАК Приоритет
	|ПОМЕСТИТЬ ТаблицаОтбора
	|ИЗ
	|	ТаблицаТоварыДоп КАК ТаблицаОтбора
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаВидыЦен КАК ВременнаяТаблицаВидыЦен
	|		ПО (ИСТИНА)
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОтбора.ИдентификаторСтрокиВТ,
	|	ТаблицаОтбора.Номенклатура,
	|	ТаблицаОтбора.Упаковка,
	|	ТаблицаОтбора.ХарактеристикаЦО,
	|	ТаблицаОтбора.СерияЦО,
	|	ТаблицаОтбора.УпаковкаЦО,
	|	&ЗначениеВидаЦенПоИсточнику
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторСтрокиВТ,
	|	Номенклатура,
	|	Упаковка,
	|	ХарактеристикаЦО,
	|	СерияЦО,
	|	УпаковкаЦО,
	|	ВидЦены";
	
	Если ЗаполнятьПоСоглашению Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ЗначениеВидаЦенПоИсточнику",
			"ВременнаяТаблицаВидыЦен.ВидЦены");
		
	Иначе
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ЗначениеВидаЦенПоИсточнику",
			"ВЫБОР
			|		КОГДА ВременнаяТаблицаВидыЦен.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
			|		ИЛИ ВременнаяТаблицаВидыЦен.ВидЦены ЕСТЬ NULL
			|			ТОГДА ТаблицаОтбора.ВидЦены
			|		ИНАЧЕ ВременнаяТаблицаВидыЦен.ВидЦены
			|	КОНЕЦ");
		
	КонецЕсли;
	
	Результат.Добавить(ТекстЗапроса, "ТаблицаОтбора");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КурсыВалютыЦены.Валюта КАК Валюта,
	|	КурсыВалютыЦены.КурсЧислитель КАК КурсЧислитель,
	|	КурсыВалютыЦены.КурсЗнаменатель КАК КурсЗнаменатель
	|ПОМЕСТИТЬ ТаблицаКурсовВалют
	|ИЗ
	|	РегистрСведений.ОтносительныеКурсыВалют.СрезПоследних(&Дата, БазоваяВалюта = &БазоваяВалюта) КАК КурсыВалютыЦены
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта";
	
	Результат.Добавить(ТекстЗапроса, "ТаблицаКурсовВалют");
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦен.Номенклатура КАК Номенклатура,
	|	ТаблицаЦен.ХарактеристикаЦО КАК ХарактеристикаЦО,
	|	ТаблицаЦен.СерияЦО КАК СерияЦО,
	|	ТаблицаЦен.Упаковка КАК Упаковка,
	|	ТаблицаЦен.УпаковкаЦО КАК УпаковкаЦО,
	|	ТаблицаЦен.ВидЦены КАК ВидЦены,
	|	ТаблицаЦен.Валюта КАК Валюта,
	|	ТаблицаЦен.Цена КАК Цена
	|ПОМЕСТИТЬ ЦеныНоменклатурыСрезПоследних
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(КОНЕЦПЕРИОДА(&Дата, ДЕНЬ), (Номенклатура, ХарактеристикаЦО, СерияЦО,
	|		УпаковкаЦО, ВидЦены) В
	|		(ВЫБРАТЬ
	|			ТаблицаОтбора.Номенклатура,
	|			ТаблицаОтбора.ХарактеристикаЦО,
	|			ТаблицаОтбора.СерияЦО,
	|			ТаблицаОтбора.УпаковкаЦО,
	|			ТаблицаОтбора.ВидЦены
	|		ИЗ
	|			ТаблицаОтбора КАК ТаблицаОтбора)) КАК ТаблицаЦен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаЦО,
	|	СерияЦО,
	|	УпаковкаЦО,
	|	ВидЦены";
	
	Результат.Добавить(ТекстЗапроса, "ЦеныНоменклатурыСрезПоследних");
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОтбора.ИдентификаторСтрокиВТ КАК ИдентификаторСтрокиВТ,
	|	ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки1, 1) * ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) /
	|		ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки2, 1) * ВЫБОР
	|		КОГДА &Валюта <> ЦеныНоменклатурыСрезПоследних.Валюта
	|			ТОГДА ВЫБОР
	|				КОГДА ЕСТЬNULL(КурсыВалютыЦены.КурсЗнаменатель, 0) > 0
	|				И ЕСТЬNULL(КурсыВалютыЦены.КурсЧислитель, 0) > 0
	|				И ЕСТЬNULL(КурсыВалюты.КурсЗнаменатель, 0) > 0
	|				И ЕСТЬNULL(КурсыВалюты.КурсЧислитель, 0) > 0
	|					ТОГДА КурсыВалютыЦены.КурсЧислитель * КурсыВалюты.КурсЗнаменатель / (КурсыВалюты.КурсЧислитель *
	|						КурсыВалютыЦены.КурсЗнаменатель)
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Цена,
	|	ТаблицаОтбора.ВидЦены КАК ВидЦены,
	|	ТаблицаОтбора.Номенклатура КАК Номенклатура,
	|	ТаблицаОтбора.ХарактеристикаЦО КАК ХарактеристикаЦО,
	|	ТаблицаОтбора.СерияЦО КАК СерияЦО,
	|	ТаблицаОтбора.УпаковкаЦО КАК УпаковкаЦО,
	|	ТаблицаОтбора.Приоритет
	|	// Если цена не найдена, то нужно заполнять вид цены и пустую цену. Такое заполнение должно иметь более низкий приоритет заполнения
	|		+ ВЫБОР КОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура ЕСТЬ NULL ТОГДА 
	|			СдвигНизкогоПриоритета.Значение 
	|		ИНАЧЕ
	|			0
	|		КОНЕЦ КАК Приоритет
	|ПОМЕСТИТЬ ТаблицаРезультата
	|ИЗ
	|	ТаблицаОтбора КАК ТаблицаОтбора
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныНоменклатурыСрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ТаблицаОтбора.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|		И ТаблицаОтбора.ХарактеристикаЦО = ЦеныНоменклатурыСрезПоследних.ХарактеристикаЦО
	|		И ТаблицаОтбора.СерияЦО = ЦеныНоменклатурыСрезПоследних.СерияЦО
	|		И ТаблицаОтбора.УпаковкаЦО = ЦеныНоменклатурыСрезПоследних.УпаковкаЦО
	|		И ТаблицаОтбора.ВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦены
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКурсовВалют КАК КурсыВалютыЦены
	|		ПО ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютыЦены.Валюта
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКурсовВалют КАК КурсыВалюты
	|		ПО КурсыВалюты.Валюта = &Валюта
	|		ЛЕВОЕ СОЕДИНЕНИЕ СдвигНизкогоПриоритета КАК СдвигНизкогоПриоритета
	|		ПО Истина
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторСтрокиВТ,
	|	Номенклатура,
	|	ХарактеристикаЦО,
	|	СерияЦО,
	|	УпаковкаЦО,
	|	ВидЦены";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковки1",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"ВЫРАЗИТЬ(ТаблицаОтбора.Упаковка КАК Справочник.УпаковкиЕдиницыИзмерения)",
			"ВЫРАЗИТЬ(ТаблицаОтбора.Номенклатура КАК Справочник.Номенклатура)"));
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковки2",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"ЦеныНоменклатурыСрезПоследних.Упаковка",
			"ЦеныНоменклатурыСрезПоследних.Номенклатура"));
		
	Результат.Добавить(ТекстЗапроса, "ТаблицаРезультата");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаРезультата.ИдентификаторСтрокиВТ КАК ИдентификаторСтрокиВТ,
	|	МИНИМУМ(ТаблицаРезультата.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ ТаблицаРезультатаПриоритеты
	|ИЗ
	|	ТаблицаРезультата КАК ТаблицаРезультата
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаРезультата.ИдентификаторСтрокиВТ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторСтрокиВТ";
	
	Результат.Добавить(ТекстЗапроса, "ТаблицаРезультатаПриоритеты");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаРезультата.ИдентификаторСтрокиВТ КАК ИдентификаторСтрокиВТ,
	|	ТаблицаРезультата.ВидЦены КАК ВидЦены,
	|	ТаблицаРезультата.Цена КАК Цена
	|ПОМЕСТИТЬ ЗаполнитьУсловияПродажПредварительная
	|ИЗ
	|	ТаблицаРезультата КАК ТаблицаРезультата
	|ГДЕ
	|	(ТаблицаРезультата.ИдентификаторСтрокиВТ, ТаблицаРезультата.Приоритет) В
	|		(ВЫБРАТЬ
	|			Приоритеты.ИдентификаторСтрокиВТ КАК ИдентификаторСтрокиВТ,
	|			Приоритеты.Приоритет КАК Приоритет
	|		ИЗ
	|			ТаблицаРезультатаПриоритеты КАК Приоритеты)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторСтрокиВТ";
	
	Результат.Добавить(ТекстЗапроса, "ЗаполнитьУсловияПродажПредварительная");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВтИсточникДанных.ИдентификаторСтрокиВТ КАК ИдентификаторСтрокиВТ,
	|	ЕСТЬNULL(ТаблицаПредварительная.ВидЦены, ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)) КАК ВидЦены,
	|	ЕСТЬNULL(ТаблицаПредварительная.Цена, 0) КАК Цена
	|ИЗ
	|	ВтИсточникДанных КАК ВтИсточникДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаполнитьУсловияПродажПредварительная КАК ТаблицаПредварительная
	|		ПО ВтИсточникДанных.ИдентификаторСтрокиВТ = ТаблицаПредварительная.ИдентификаторСтрокиВТ";
	
	Результат.Добавить(ТекстЗапроса, "ЗаполнитьУсловияПродаж");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти
