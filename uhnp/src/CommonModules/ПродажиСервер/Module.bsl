// Добавляет запрос в пакет запросов для получения данных, необходимых для заполнения назначения материалов 
// при обработке строк табличной части.
//
// Параметры:
//  СтруктураДействий - см. ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ.СтруктураДействий
//  ОписаниеЗапроса - см. ПакетнаяОбработкаТабличнойЧастиСервер.ОписаниеЗапроса
//  КэшированныеЗначения - см. ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения
//
Процедура ДополнитьТекстЗапросаНазначениеМатериаловПоЗаказуДавальца(СтруктураДействий, ОписаниеЗапроса, КэшированныеЗначения) Экспорт
	
	Если ПакетнаяОбработкаТабличнойЧастиСервер.ТребуетсяВыполнитьДействие(
		"ЗаполнитьНазначениеМатериалыВСтрокеСверхЗаказа",
		СтруктураДействий,
		КэшированныеЗначения) Тогда
	
		ТекстЗапроса = "
			|ВЫБРАТЬ
			|	ИсточникДанных.ИдентификаторСтрокиВТ КАК ИдентификаторСтрокиВТ,
			|	ЕСТЬNULL(ДокЗаказДавальца.НазначениеМатериалы, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение,
			|	ЕСТЬNULL(ДокЗаказДавальцаИзПараметровДействия.НазначениеМатериалы, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК НазначениеПоЗаказуДавальцаИзПараметров
			|ИЗ
			|	ВтИсточникДанных КАК ИсточникДанных
			|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца КАК ДокЗаказДавальца
			|		ПО ДокЗаказДавальца.Ссылка = ИсточникДанных.ЗаказДавальца
			|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца КАК ДокЗаказДавальцаИзПараметровДействия
			|		ПО ДокЗаказДавальца.Ссылка = &ДокЗаказДавальцаИзПараметровДействия";
		
		Если Не ПакетнаяОбработкаТабличнойЧастиСервер.ЕстьКолонкаВИсточникеДанных("ЗаказДавальца", КэшированныеЗначения) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИсточникДанных.ЗаказДавальца", "&ДокЗаказДавальцаИзПараметровДействия");
		КонецЕсли;
		
		ОписаниеЗапроса.ТекстыЗапросов.Добавить(ТекстЗапроса, "НазначениеМатериаловПоЗаказуДавальца");
		ОписаниеЗапроса.ПараметрыЗапроса.Вставить("ДокЗаказДавальцаИзПараметровДействия", СтруктураДействий.ЗаполнитьНазначениеМатериалыВСтрокеСверхЗаказа);
		ОписаниеЗапроса.ПривилегированныйРежим = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

