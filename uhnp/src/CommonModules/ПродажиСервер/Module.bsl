// Формирует запрос для контроля завершения оформления отчетов по заказу давальца
//
// Параметры:
// ТекстЗапроса - Строка - текстовая строка, к которой необходимо добавить текст запроса.
//
Процедура СформироватьЗапросКонтрольОформленияОтчетов(ТекстЗапроса)

	ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	Данные.Валюта КАК Валюта,
		|	СУММА(Данные.Сумма) КАК Сумма,
		|	СУММА(Данные.Сумма) > 0 КАК ЕстьНеоформленныеОтчеты
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗаказДавальца.Валюта КАК Валюта,
		|		ЗаказДавальца.СуммаДокумента КАК Сумма
		|	ИЗ
		|		Документ.ЗаказДавальца КАК ЗаказДавальца
		|	ГДЕ
		|		ЗаказДавальца.Ссылка = &Ссылка
		|		И ЗаказДавальца.Проведен
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ОтчетДавальцуПродукция.ЗаказДавальца.Валюта КАК Валюта,
		|		-ОтчетДавальцуПродукция.СуммаВзаиморасчетов КАК Сумма
		|	ИЗ
		|		Документ.ОтчетДавальцу.Продукция КАК ОтчетДавальцуПродукция
		|	ГДЕ
		|		ОтчетДавальцуПродукция.ЗаказДавальца = &Ссылка
		|		И ОтчетДавальцуПродукция.Ссылка.Проведен) КАК Данные
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|		ВременнаяТаблицаДокументПродажи КАК Документ
		|	ПО
		|		ИСТИНА
		|СГРУППИРОВАТЬ ПО
		|	Данные.Валюта
		|;
		|";
	
КонецПроцедуры

