
Процедура тн_ПроверитьДатуЗапретаИзмененияПередЗаписьюНабораЗаписейРегистраОстаткиПоНЗСиОСПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Регистратор = Источник.Отбор.Регистратор.Значение;  
	
	Если ОбщегоНазначенияУХ.ЕстьРеквизитОбъекта("Организация", Регистратор)
		И ОбщегоНазначенияУХ.ЕстьРеквизитОбъекта("Дата", Регистратор) Тогда
		
		тн_ПроверитьДатуЗапрета(Регистратор.Дата, Регистратор.Организация);
		
	КонецЕсли;

КонецПроцедуры  // тн_ПроверитьДатуЗапретаИзмененияПередЗаписьюНабораЗаписейРегистраОстаткиПоНЗСиОСПередЗаписью()

Процедура тн_ПроверитьДатуЗапрета(Период, Организация) Экспорт
	
	Если тн_НайденЗапретИзмененияДанных(Период, Организация) Тогда
	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				"Не удалось записать данные в регистр ""Остатки по НЗС и ОС (тн)"" в периоде %1 из-за установленной даты запрета по организации: %2",
				Формат(Период,"ДФ='MMMM yyyy'"), Организация);
				
		ЗаписьЖурналаРегистрации("Запись движений по регистру ""Остатки по НЗС и ОС (тн)""", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
КонецПроцедуры  // тн_ПроверитьДатуЗапрета()    

Функция тн_НайденЗапретИзмененияДанных(Период, Организация) Экспорт
	
	НайденЗапрет = Ложь;  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_ДатыЗапретаИзмененияРНОстаткиПоНЗСиОС.Организация КАК Организация,
		|	тн_ДатыЗапретаИзмененияРНОстаткиПоНЗСиОС.ДатаЗапрета КАК ДатаЗапрета
		|ИЗ
		|	РегистрСведений.тн_ДатыЗапретаИзмененияРНОстаткиПоНЗСиОС КАК тн_ДатыЗапретаИзмененияРНОстаткиПоНЗСиОС
		|ГДЕ
		|	тн_ДатыЗапретаИзмененияРНОстаткиПоНЗСиОС.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаЗапрета = КонецДня(Выборка.ДатаЗапрета);
		Если Период <= ДатаЗапрета Тогда
			НайденЗапрет = Истина;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат НайденЗапрет;
	
КонецФункции //тн_НайденЗапретИзмененияДанных()
