Функция НоваяПодпись() Экспорт 
	
	Подпись = НСтр("ru = 'С уважением%1';
					|en = 'Yours faithfully%1'");
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	ДанныеПользователя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АвторизованныйПользователь, "Наименование, Служебный");
	Если ДанныеПользователя.Служебный Тогда
		ПредставлениеПользователя = ".";
		
	Иначе
		ПредставлениеПользователя = ", " + ДанныеПользователя.Наименование + ".";  	
	КонецЕсли;
	
	Подпись = СтрШаблон(Подпись, ПредставлениеПользователя);
	
	Возврат Подпись;
	
КонецФункции

// Получает номер картинки из соответствию статуса и предопределенного номера. 
// Требуется для получения картинки из набора.
// 
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыОбменСБанками
//  
// Возвращаемое значение:
//  Число
//
Функция ПолучитьСтатусЧисломДляКартинки(Статус) Экспорт 

	Если Статус =  Перечисления.СтатусыОбменСБанками.ОшибкаПередачи Тогда
		Возврат 9   
	ИначеЕсли Статус =  Перечисления.СтатусыОбменСБанками.ОтклоненБанком 
			Или Статус =  Перечисления.СтатусыОбменСБанками.НеПодтвержден Тогда
		Возврат 6 
	Иначе
		Возврат 0;
	КонецЕсли;  
	
КонецФункции

