//  Проверяет количество типов писем по настройке обмена с банком
//
// Параметры:
//  НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками
//
// Возвращаемое значение:
//  Булево
//
Функция ПроверкаТиповПисемБольшеОдного(НастройкаОбмена) Экспорт 
	
	Если Не ЗначениеЗаполнено(НастройкаОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Владелец",НастройкаОбмена);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	ТипыПисемОбменСБанками.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТипыПисемОбменСБанками КАК ТипыПисемОбменСБанками
	|ГДЕ
	|	НЕ ТипыПисемОбменСБанками.ПометкаУдаления
	|	И ТипыПисемОбменСБанками.Владелец = &Владелец";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
	Всего = ВыборкаДетальныеЗаписи.Количество();
	Если Всего > 1 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;  
	
КонецФункции  

// Проверяет доступность функциональности отправки почтовых сообщений.
