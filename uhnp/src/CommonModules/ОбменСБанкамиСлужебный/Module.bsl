Функция СведенияОТипахПисемПоНастройкеОбмена(НастройкаОбмена) Экспорт
	
	СведенияОТипахПисем = Новый Структура;
	СведенияОТипахПисем.Вставить("ОдинТипПисьма", Ложь);
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Владелец",НастройкаОбмена);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТипыПисемОбменСБанками.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТипыПисемОбменСБанками КАК ТипыПисемОбменСБанками
	|ГДЕ
	|	НЕ ТипыПисемОбменСБанками.ПометкаУдаления
	|	И ТипыПисемОбменСБанками.Владелец = &Владелец";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда      
		СведенияОТипахПисем.Вставить("ОдинТипПисьма", ВыборкаДетальныеЗаписи.Количество()=1);  
		СведенияОТипахПисем.Вставить("ТипПисьмаПоНастройке", ВыборкаДетальныеЗаписи.Ссылка);  	
	КонецЕсли; 
	
	Возврат СведенияОТипахПисем; 
	
