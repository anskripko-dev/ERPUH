		ТекстБанк = ТекстБанк + DataRequest.Bank.Name + ", ";
	КонецЕсли;
	ТекстБанк = ТекстБанк + НСтр("ru = 'БИК:';
								|en = 'BIC:'") + " " + Строка(ЗначениеСвойстваXDTO(DataRequest.Bank, "BIC"));

	НомерСчета = DataRequest.Account + ТекстБанк;
	РеквизитыСчета = Новый СписокЗначений;
	РеквизитыСчета.Добавить(НомерСчета, "НомерСчета");
	ДеревоЭлектронногоДокументаБЭД.ДобавитьРеквизитыТЧОбъекта(НовыйЭД, "СтрокаТЧ", РеквизитыСчета);

