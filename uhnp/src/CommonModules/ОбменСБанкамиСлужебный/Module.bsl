// Отмечает исполненные платежные документы
//
// Параметры:
//  НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками - текущая настройка обмена с банком
//  ПрограммаБанка - ПеречислениеСсылка.ПрограммыБанка - текущая программа банка
//  МассивВнешнихИдентификаторов - Массив - содержит идентификаторы платежных документов.
//  НомерСчета - Строка - номер счета.
//
Процедура ОтметитьИсполненныеПлатежныеДокументы(НастройкаОбмена, ПрограммаБанка, МассивВнешнихИдентификаторов, НомерСчета=Неопределено)
	
	Запрос = ЗапросНеисполненныхПлатежныхПоручений(
		НастройкаОбмена, ПрограммаБанка, МассивВнешнихИдентификаторов, НомерСчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УстановитьСостоянияОбменСБанкамиПлатежИсполнен(Выборка);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗапросНеисполненныхПлатежныхПоручений(
	НастройкаОбмена,
	ПрограммаБанка,
	МассивВнешнихИдентификаторов,
	НомерСчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СообщениеОбменСБанками.Ссылка КАК Ссылка,
	|	СостоянияОбменСБанками.СсылкаНаОбъект КАК СсылкаНаОбъектАктуальная,
	|	СвязанныеОбъектыОбменСБанками.СсылкаНаОбъект КАК СсылкаНаОбъектНеАктуальная
	|ИЗ
	|	Документ.СообщениеОбменСБанками КАК СообщениеОбменСБанками
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОбменСБанками КАК СостоянияОбменСБанками
	|		ПО (СостоянияОбменСБанками.СообщениеОбмена = СообщениеОбменСБанками.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеОбъектыОбменСБанками КАК СвязанныеОбъектыОбменСБанками
	|		ПО (СвязанныеОбъектыОбменСБанками.СообщениеОбмена = СообщениеОбменСБанками.Ссылка)
	|ГДЕ
	|	СообщениеОбменСБанками.НастройкаОбмена = &НастройкаОбмена
	|	И СообщениеОбменСБанками.ВидЭД В (ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПлатежноеПоручение),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПлатежноеТребование),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПоручениеНаПереводВалюты),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПоручениеНаПокупкуВалюты),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПоручениеНаПродажуВалюты),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.РаспоряжениеНаОбязательнуюПродажуВалюты))
	|	И СообщениеОбменСБанками.ВнешнийИдентификатор В (&МассивИдентификаторов)
	|	И СообщениеОбменСБанками.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Доставлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Исполнен), ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Обработан),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Отправлен), ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Подтвержден),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Принят), ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Приостановлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.ЧастичноПодписан),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.НеПодтвержден))
	|	И ИСТИНА";

	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивВнешнихИдентификаторов);
	Запрос.УстановитьПараметр("НастройкаОбмена", НастройкаОбмена);
	
	Если ЗначениеЗаполнено(НомерСчета) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИСТИНА", "И СообщениеОбменСБанками.НомерСчета = &НомерСчета");
		Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	КонецЕсли;

	Если ПрограммаБанка = Перечисления.ПрограммыБанка.АсинхронныйОбмен Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВнешнийИдентификатор", "Идентификатор");
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция МассивИдентификаторовВыпискиБанка(НастройкаОбмена, Выписка)

	МассивВнешнихИдентификаторов = Новый Массив;
	Для Каждого СтрокаТЧ Из Выписка.Операции Цикл
		Если СтрокаТЧ.НаправлениеПлатежа = "1" Тогда
			Если ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторДокумента) Тогда
				МассивВнешнихИдентификаторов.Добавить(СтрокаТЧ.ИдентификаторДокумента);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивВнешнихИдентификаторов;

КонецФункции

Функция ТаблицаСИдентификаторамиВыпискиБанка(НастройкаОбмена, Выписка)
	
	Индекс = 0;
	ТаблицаОпераций = НоваяТаблицаОпераций();
	Для Каждого СтрокаТЧ Из Выписка.Операции Цикл
		// НаправлениеПлатежа (DC) - Признак дебета/кредита.
		// "1" - Операция по дебету (списание со счета).
		Если СтрокаТЧ.НаправлениеПлатежа = "1" Тогда // т.к. ищем платежные поручения, фильтруем по операциям списания
			НоваяСтрока = ТаблицаОпераций.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ.Получатель);
			НоваяСтрока.ИндексСтроки = Индекс;
			НоваяСтрока.ИдентификаторЗаполнен = ЗначениеЗаполнено(НоваяСтрока.ИдентификаторДокумента);
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаОпераций;
	
КонецФункции

Функция ТаблицаНеИсполненныхПлатежныхПоручений(НастройкаОбмена,
											   ПрограммаБанка,
											   МассивВнешнихИдентификаторов,
											   ТаблицаОпераций,
											   НомерСчета)
	
	Если МассивВнешнихИдентификаторов.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОпераций.ИндексСтроки КАК ИндексСтроки,
	|	ТаблицаОпераций.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ТаблицаОпераций.ИдентификаторЗаполнен КАК ИдентификаторЗаполнен
	|ПОМЕСТИТЬ ВТ_ТаблицаОпераций
	|ИЗ
	|	&ТаблицаОпераций КАК ТаблицаОпераций
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СообщениеОбменСБанками.Ссылка КАК Ссылка,
	|	СостоянияОбменСБанками.СсылкаНаОбъект КАК СсылкаНаОбъектАктуальная,
	|	СвязанныеОбъектыОбменСБанками.СсылкаНаОбъект КАК СсылкаНаОбъектНеАктуальная,
	|	СообщениеОбменСБанками.ВнешнийИдентификатор КАК ИдентификаторДокумента
	|ПОМЕСТИТЬ ВТ_СообщенияОбмена
	|ИЗ
	|	Документ.СообщениеОбменСБанками КАК СообщениеОбменСБанками
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОбменСБанками КАК СостоянияОбменСБанками
	|		ПО (СостоянияОбменСБанками.СообщениеОбмена = СообщениеОбменСБанками.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеОбъектыОбменСБанками КАК СвязанныеОбъектыОбменСБанками
	|		ПО (СвязанныеОбъектыОбменСБанками.СообщениеОбмена = СообщениеОбменСБанками.Ссылка)
	|ГДЕ
	|	СообщениеОбменСБанками.НастройкаОбмена = &НастройкаОбмена
	|	И СообщениеОбменСБанками.ВидЭД В (ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПлатежноеПоручение), ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПлатежноеТребование), ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПоручениеНаПереводВалюты), ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПоручениеНаПокупкуВалюты), ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПоручениеНаПродажуВалюты), ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.РаспоряжениеНаОбязательнуюПродажуВалюты))
	|	И СообщениеОбменСБанками.ВнешнийИдентификатор В(&МассивИдентификаторов)
	|	И СообщениеОбменСБанками.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Доставлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Исполнен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Обработан),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Отправлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Подтвержден),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Принят),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Приостановлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.ЧастичноПодписан),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.НеПодтвержден),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.ОтклоненБанком))
	|	И &УсловиеПоНомеруСчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СообщениеОбменСБанками.Ссылка КАК Ссылка,
	|	СообщениеОбменСБанками.СсылкаНаОбъектАктуальная КАК СсылкаНаОбъектАктуальная,
	|	СообщениеОбменСБанками.СсылкаНаОбъектНеАктуальная КАК СсылкаНаОбъектНеАктуальная,
	|	СообщениеОбменСБанками.ИдентификаторДокумента КАК ИдентификаторДокумента
	|ИЗ
	|	ВТ_СообщенияОбмена КАК СообщениеОбменСБанками
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОпераций.ИндексСтроки КАК ИндексСтроки,
	|	СообщенияОбмена.ИдентификаторДокумента ЕСТЬ НЕ NULL  КАК ИдентификаторНайден
	|ИЗ
	|	ВТ_ТаблицаОпераций КАК ТаблицаОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СообщенияОбмена КАК СообщенияОбмена
	|		ПО (ТаблицаОпераций.ИдентификаторЗаполнен)
	|			И ТаблицаОпераций.ИдентификаторДокумента = СообщенияОбмена.ИдентификаторДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИндексСтроки";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивВнешнихИдентификаторов);
	Запрос.УстановитьПараметр("ТаблицаОпераций", ТаблицаОпераций);
	Запрос.УстановитьПараметр("НастройкаОбмена", НастройкаОбмена);
	
	Если ЗначениеЗаполнено(НомерСчета) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&УсловиеПоНомеруСчета",
			"СообщениеОбменСБанками.НомерСчета = &НомерСчета");
		Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоНомеруСчета", Истина);
	КонецЕсли;
	
	Если ПрограммаБанка = Перечисления.ПрограммыБанка.АсинхронныйОбмен Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВнешнийИдентификатор", "Идентификатор");
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	КоличествоПакетов = Результат.Количество();
	
	ТаблицаНеИсполненныхПлатежныхПоручений = Результат[КоличествоПакетов - 2].Выгрузить();
	
	// Обновим таблицу отметками об найденных по идентификаторам операциях.
	ТаблицаОперацийИдентификаторы = Результат[КоличествоПакетов - 1].Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаблицаОперацийИдентификаторы Цикл
		ТаблицаОпераций[СтрокаТаблицы.ИндексСтроки].ИдентификаторНайден = СтрокаТаблицы.ИдентификаторНайден;
	КонецЦикла;
	
	Возврат ТаблицаНеИсполненныхПлатежныхПоручений;
	
КонецФункции

Функция ЗапросНеисполненныхПлатежныхПорученийПоРеквизитам(НастройкаОбмена,
														  ПрограммаБанка,
														  ТаблицаОпераций,
														  НомерСчета)
	
	КодЭДПП = КодЭД(Перечисления.ВидыЭДОбменСБанками.ПлатежноеПоручение);
	ТаблицаДляЗапроса = НоваяТаблицаОпераций();
	Для Каждого СтрокТаблицы Из ТаблицаОпераций Цикл
		Если СтрокТаблицы.ИдентификаторНайден Или СтрокТаблицы.КодВидаЭД <> КодЭДПП Тогда // только для Платежных поручений
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДляЗапроса.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокТаблицы);
	КонецЦикла;
	
	Если ТаблицаДляЗапроса.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОпераций.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОпераций.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОпераций.СуммаДокумента КАК СуммаДокумента,
	|	ТаблицаОпераций.ИНН КАК ИНН,
	|	ТаблицаОпераций.КПП КАК КПП,
	|	ТаблицаОпераций.РасчСчет КАК НомерСчета
	|ПОМЕСТИТЬ Документы
	|ИЗ
	|	&ТаблицаОпераций КАК ТаблицаОпераций
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерДокумента,
	|	ДатаДокумента,
	|	СуммаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СообщениеОбменСБанками.Ссылка КАК Ссылка,
	|	СостоянияОбменСБанками.СсылкаНаОбъект КАК СсылкаНаОбъектАктуальная,
	|	СвязанныеОбъектыОбменСБанками.СсылкаНаОбъект КАК СсылкаНаОбъектНеАктуальная,
	|	СообщениеОбменСБанками.ДатаДокументаОтправителя КАК ДатаДокументаОтправителя,
	|	СообщениеОбменСБанками.ДатаИзмененияВнешнегоСтатуса КАК ДатаИзмененияВнешнегоСтатуса,
	|	СообщениеОбменСБанками.ДатаИзмененияСтатуса КАК ДатаИзмененияСтатуса,
	|	СообщениеОбменСБанками.НомерДокументаОтправителя КАК НомерДокументаОтправителя,
	|	СообщениеОбменСБанками.СуммаДокумента КАК СуммаДокумента,
	|	СообщениеОбменСБанками.ИННКонтрагента КАК ИННКонтрагента,
	|	СообщениеОбменСБанками.КППКонтрагента КАК КППКонтрагента,
	|	СообщениеОбменСБанками.НомерСчетаКонтрагента КАК НомерСчетаКонтрагента,
	|	Документы.ИНН КАК ИНН,
	|	Документы.КПП КАК КПП,
	|	Документы.НомерСчета КАК НомерСчета
	|ИЗ
	|	Документ.СообщениеОбменСБанками КАК СообщениеОбменСБанками
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документы КАК Документы
	|		ПО (НАЧАЛОПЕРИОДА(СообщениеОбменСБанками.ДатаДокументаОтправителя, ДЕНЬ) = Документы.ДатаДокумента)
	|			И СообщениеОбменСБанками.НомерДокументаОтправителя = Документы.НомерДокумента
	|			И СообщениеОбменСБанками.СуммаДокумента = Документы.СуммаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОбменСБанками КАК СостоянияОбменСБанками
	|		ПО (СостоянияОбменСБанками.СообщениеОбмена = СообщениеОбменСБанками.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеОбъектыОбменСБанками КАК СвязанныеОбъектыОбменСБанками
	|		ПО (СвязанныеОбъектыОбменСБанками.СообщениеОбмена = СообщениеОбменСБанками.Ссылка)
	|ГДЕ
	|	СообщениеОбменСБанками.НастройкаОбмена = &НастройкаОбмена
	|	И СообщениеОбменСБанками.ВидЭД = ЗНАЧЕНИЕ(Перечисление.ВидыЭДОбменСБанками.ПлатежноеПоручение)
	|	И СообщениеОбменСБанками.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Доставлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Исполнен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Обработан),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Отправлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Подтвержден),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Принят),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.Приостановлен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.ЧастичноПодписан),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.НеПодтвержден),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОбменСБанками.ОтклоненБанком))
	|	И &УсловиеПоНомеруСчета";
	
	Запрос.УстановитьПараметр("ТаблицаОпераций", ТаблицаДляЗапроса);
	Запрос.УстановитьПараметр("НастройкаОбмена", НастройкаОбмена);
	
	Если ЗначениеЗаполнено(НомерСчета) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&УсловиеПоНомеруСчета",
			"СообщениеОбменСБанками.НомерСчета = &НомерСчета");
		Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоНомеруСчета", Истина);
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

// Определяет и отмечает исполненные платежные документы
//
// Параметры:
//  НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками - текущая настройка обмена с банком
//  ДанныеВыписки   - ТаблицаЗначений  - содержит данные выписки в виде таблицы значений.
//
Процедура ОпределитьИсполненныеПлатежныеПорученияПоРеквизитам(НастройкаОбмена, ДанныеВыписки, ТаблицаСИдентификаторами)
	
	ПрограммаБанка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаОбмена, "ПрограммаБанка");
	
	Если ЗначениеЗаполнено(ДанныеВыписки.НомерСчета) Тогда
		ОтметитьИсполненныеПлатежныеДокументыПоРеквизитам(
			НастройкаОбмена, ПрограммаБанка, ТаблицаСИдентификаторами, ДанныеВыписки.НомерСчета);
	Иначе
		ОтметитьИсполненныеПлатежныеДокументыПоРеквизитам(НастройкаОбмена, ПрограммаБанка, ТаблицаСИдентификаторами);
	КонецЕсли;
	
КонецПроцедуры

// Отмечает исполненные платежные документы
//
// Параметры:
//  НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками - текущая настройка обмена с банком
//  ПрограммаБанка  - ПеречислениеСсылка.ПрограммыБанка - текущая программа банка
//  ТаблицаОпераций - ТаблицаЗначений - содержит реквизиты платежных документов в виде таблицы значений
//  НомерСчета      - Строка - номер счета.
//
Процедура ОтметитьИсполненныеПлатежныеДокументыПоРеквизитам(НастройкаОбмена,
															ПрограммаБанка,
															ТаблицаОпераций,
															НомерСчета = Неопределено)
	
	Запрос = ЗапросНеисполненныхПлатежныхПорученийПоРеквизитам(
		НастройкаОбмена, ПрограммаБанка, ТаблицаОпераций, НомерСчета);
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработанныеДокументы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ОбработанныеДокументы[Выборка.Ссылка] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработанныеДокументы.Вставить(Выборка.Ссылка, Истина);
		
		ИННКонтрагента = Выборка.ИННКонтрагента;
		КППКонтрагента = Выборка.КППКонтрагента;
		НомерСчетаКонтрагента = Выборка.НомерСчетаКонтрагента;
		Если Не ЗначениеЗаполнено(Выборка.ИННКонтрагента) И Не ЗначениеЗаполнено(Выборка.КППКонтрагента)
			И Не ЗначениеЗаполнено(Выборка.НомерСчетаКонтрагента) Тогда
			// Если в документе реквизиты контрагента не заполнены, то получим их из исходного файла.
			Попытка
				ДвоичныеДанныеФайла = ОбменСБанкамиСлужебныйВызовСервера.ДвоичныеДанныеПрисоединенногоФайла(Выборка.Ссылка);
			Исключение
				// Обработка не требуется, при отсутствии данных файла оставляем платежное поручение несопоставленным с выпиской.
				ДвоичныеДанныеФайла = Неопределено;
			КонецПопытки;
			
			Если ДвоичныеДанныеФайла <> Неопределено Тогда
				Результат = СформироватьДеревоРазбора(Перечисления.ВидыЭДОбменСБанками.ПлатежноеПоручение, ДвоичныеДанныеФайла);
				ДеревоРазбора = Результат.ДеревоРазбора;
				СтрокаОбъекта = Результат.СтрокаОбъекта;
				ИННКонтрагента = ЗначениеРеквизитаСтрокиДереваРазбора(ДеревоРазбора, СтрокаОбъекта, "ПолучательИНН");
				КППКонтрагента = ЗначениеРеквизитаСтрокиДереваРазбора(ДеревоРазбора, СтрокаОбъекта, "ПолучательКПП");
				НомерСчетаКонтрагента = ЗначениеРеквизитаСтрокиДереваРазбора(ДеревоРазбора, СтрокаОбъекта, "ПолучательРасчСчет");
			КонецЕсли;
		КонецЕсли;
		
		// Для сопоставленных в запросе документов по номеру и дате, дополнительно
		// проверяем совпадение ИНН, КПП и счета контрагента из выписки и из платежного поручения.
		НомерСчетаСовпадает = Выборка.НомерСчета = НомерСчетаКонтрагента;
		ИННСовпадают = РеквизитЗаполнен(Выборка.ИНН) = РеквизитЗаполнен(ИННКонтрагента)
			И Выборка.ИНН = ИННКонтрагента;
		ПроверятьКПП = РеквизитЗаполнен(Выборка.КПП) И РеквизитЗаполнен(КППКонтрагента);
		КППСовпадают = Ложь;
		Если ПроверятьКПП Тогда
			КППСовпадают = Выборка.КПП = КППКонтрагента;
		КонецЕсли;
		
		КонтрагентСовпадает = НомерСчетаСовпадает И ИННСовпадают И (Не ПроверятьКПП Или КППСовпадают);
		
		Если Не КонтрагентСовпадает Тогда
			Продолжить;
		КонецЕсли;
		
		УстановитьСостоянияОбменСБанкамиПлатежИсполнен(Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Отмечает исполненные платежные документы
//
// Параметры:
//  НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками - текущая настройка обмена с банком
//  ПрограммаБанка - ПеречислениеСсылка.ПрограммыБанка - текущая программа банка
//  МассивВнешнихИдентификаторов - Массив - содержит идентификаторы платежных документов
//  ТаблицаОперацийСИдентификаторами - ТаблицаЗначений - операции выписки с идентификаторами исполненных ПП
//  НомерСчета - Строка - номер счета.
//
Процедура ОтметитьИсполненныеПлатежныеДокументыПоИдентификаторам(НастройкаОбмена,
																 ПрограммаБанка,
																 МассивВнешнихИдентификаторов,
																 ТаблицаОперацийСИдентификаторами,
																 НомерСчета = Неопределено)
	
	ТаблицаНеИсполненныхПлатежныхПоручений = ТаблицаНеИсполненныхПлатежныхПоручений(
		НастройкаОбмена, ПрограммаБанка, МассивВнешнихИдентификаторов, ТаблицаОперацийСИдентификаторами, НомерСчета);
	
	Для Каждого СтрокаТаблицы Из ТаблицаНеИсполненныхПлатежныхПоручений Цикл
		УстановитьСостоянияОбменСБанкамиПлатежИсполнен(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьСостоянияОбменСБанкамиПлатежИсполнен(Запись)
	
	СтруктураПараметров = Новый Структура("Статус", Перечисления.СтатусыОбменСБанками.Подтвержден);
		ОбменСБанкамиСлужебныйВызовСервера.ИзменитьСообщениеОбмена(Запись.Ссылка, СтруктураПараметров);
	// Если электронный документ не актуален, но в выписке операция отражена, то необходимо вернуть актуальный ЭД.
	Если Не ЗначениеЗаполнено(Запись.СсылкаНаОбъектАктуальная)
			И ЗначениеЗаполнено(Запись.СсылкаНаОбъектНеАктуальная) Тогда
		МенеджерЗаписи = РегистрыСведений.СостоянияОбменСБанками.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.СсылкаНаОбъект  = Запись.СсылкаНаОбъектНеАктуальная;
		МенеджерЗаписи.СообщениеОбмена = Запись.Ссылка;
		МенеджерЗаписи.Состояние = Перечисления.СостоянияОбменСБанками.ПлатежИсполнен;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция НоваяТаблицаОпераций()
	
	МетаданныеДокумента = Метаданные.Документы.СообщениеОбменСБанками.Реквизиты;
	ТаблицаОпераций = Новый ТаблицаЗначений;
	ТаблицаОпераций.Колонки.Добавить("ИндексСтроки",
		ОбщегоНазначения.ОписаниеТипаЧисло(10, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаОпераций.Колонки.Добавить("НомерДокумента",  МетаданныеДокумента.НомерДокументаОтправителя.Тип);
	ТаблицаОпераций.Колонки.Добавить("ДатаДокумента",   МетаданныеДокумента.ДатаДокументаОтправителя.Тип);
	ТаблицаОпераций.Колонки.Добавить("ИНН",             МетаданныеДокумента.ИННКонтрагента.Тип);
	ТаблицаОпераций.Колонки.Добавить("КПП",             МетаданныеДокумента.КППКонтрагента.Тип);
	ТаблицаОпераций.Колонки.Добавить("РасчСчет",        МетаданныеДокумента.НомерСчетаКонтрагента.Тип);
	ТаблицаОпераций.Колонки.Добавить("СуммаДокумента",  МетаданныеДокумента.СуммаДокумента.Тип);
	ТаблицаОпераций.Колонки.Добавить("КодВидаЭД",       ОбщегоНазначения.ОписаниеТипаСтрока(2));
	ТаблицаОпераций.Колонки.Добавить("ИдентификаторДокумента", МетаданныеДокумента.Идентификатор.Тип);
	ТаблицаОпераций.Колонки.Добавить("ИдентификаторЗаполнен",  Новый ОписаниеТипов("Булево"));
	ТаблицаОпераций.Колонки.Добавить("ИдентификаторНайден",    Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаОпераций;
	
КонецФункции

