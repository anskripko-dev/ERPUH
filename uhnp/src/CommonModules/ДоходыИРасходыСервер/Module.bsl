// Формирует текст запроса дополнения таблицы "ТаблицаОтражениеДокументовВРеглУчете".
//
// Параметры:
// 	ЕстьВтПартииПрочихРасходов - Булево - Признак наличия временной таблицы;
// 	ИмяПериода - Строка - имя периода параметра "Период" в принимаемом запросе, должно устанавливаться в методе
// 		модуля менеджера документа "ЗаполнитьПараметрыИнициализации". По умолчанию - "Период".
//
// Возвращаемое значение:
// 	Строка - Текст запроса
Функция ДополнитьТекстЗапросаТаблицаОтражениеДокументовВРеглУчете(ЕстьВтПартииПрочихРасходов = Истина, ИмяПериода = "Период") Экспорт
	
	ШаблонЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&ПереопределяемоеИмяПериодаДокумента КАК Период,
	|	Строки.ОрганизацияПолучатель КАК Организация,
	|	НАЧАЛОПЕРИОДА(Строки.Период, ДЕНЬ) КАК ДатаОтражения
	|ИЗ
	|	&ПереопределяемоеИмяТаблицы КАК Строки
	|ГДЕ
	|	Строки.ОрганизацияПолучатель <> Строки.Организация";
	
	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить(СтрЗаменить(ШаблонЗапроса, "&ПереопределяемоеИмяТаблицы", "ВтПрочиеРасходы"));
	Если ЕстьВтПартииПрочихРасходов Тогда
		ТекстыЗапроса.Добавить(СтрЗаменить(ШаблонЗапроса, "&ПереопределяемоеИмяТаблицы", "ВтПартииПрочихРасходов"));
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&ПереопределяемоеИмяПериодаДокумента КАК Период,
		|	Строки.Организация КАК Организация,
		|	НАЧАЛОПЕРИОДА(СтрокиОфлайн.Период, ДЕНЬ) КАК ДатаОтражения
		|ИЗ
		|	ВтПартииПрочихРасходов КАК Строки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииПрочихРасходов КАК СтрокиОфлайн
		|			ПО СтрокиОфлайн.Регистратор = &Ссылка
		|				И СтрокиОфлайн.Период <> Строки.Период
		|				И СтрокиОфлайн.РасчетПартий";
		ТекстыЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении(Истина));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПереопределяемоеИмяПериодаДокумента", "&" + ИмяПериода);
	Возврат ТекстЗапроса;
	
КонецФункции

//-- НЕ УТ

