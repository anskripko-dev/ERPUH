#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаОбъектыДляЗамены(СОтборомПоПериоду)
	
	Если СОтборомПоПериоду Тогда
		
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Справочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Справочник
		|ГДЕ
		|	Справочник.СтавкаНДС = &ТекущаяСтавка
		|	И Справочник.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Закрыт)
		|	И НЕ Справочник.ПометкаУдаления
		|	И (Справочник.ДатаОкончанияДействия >= &Период
		|			ИЛИ Справочник.ДатаОкончанияДействия = &ПустаяДата)
		|";
		
	Иначе
		
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Справочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Справочник
		|ГДЕ
		|	Справочник.СтавкаНДС = &ТекущаяСтавка
		|	И НЕ Справочник.ПометкаУдаления
		|";
		
	КонецЕсли;
		
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ЗаблокироватьИЗаписатьСправочник(СправочникОбъект, СтавкаНДС, ТекущаяСтавкаНДС, ЭлементБлокировки)
	
	Если СправочникОбъект.СтавкаНДС <> ТекущаяСтавкаНДС Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(ЭлементБлокировки);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Ссылка", СправочникОбъект.Ссылка);
	Блокировка.Заблокировать();
	
	СправочникОбъект.СтавкаНДС = СтавкаНДС;
	СправочникОбъект.ОбменДанными.Загрузка = Истина;
	
	СправочникОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти
