	Возврат ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.МногопериоднаяОтчетность");

КонецФункции

// Возвращает данные вида отчета
//
// Параметры:
//  ВидОтчета	 - СправочникСсылка.ВидыОтчетов - Ссылка на вид отчета
// 
// Возвращаемое значение:
//   - Структура - Структура с данными вида отчета
//
Функция ДанныеВидаОтчета(ВидОтчета) Экспорт
	
	ДанныеВидаОтчета = Новый Структура;
	ДанныеВидаОтчета.Вставить("ВидОтчета", Справочники.ВидыОтчетов.ПустаяСсылка());
	ДанныеВидаОтчета.Вставить("РазделениеПоПроектам", Ложь);
	ДанныеВидаОтчета.Вставить("СохранятьИсториюИзменений", Ложь);
	ДанныеВидаОтчета.Вставить("МаксКлючевыхАналитик", 0);
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ДанныеВидаОтчета.Вставить("ВидАналитики" + Сч, Неопределено);
		ДанныеВидаОтчета.Вставить("ТипЗначенияАналитики" + Сч, Неопределено);
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ВидОтчета) Тогда
		Возврат ДанныеВидаОтчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыОтчетов.Ссылка КАК ВидОтчета,
		|	ВидыОтчетов.РазделениеПоПроектам КАК РазделениеПоПроектам,
		|	ВидыОтчетов.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
		|	ВидыОтчетов.КоличествоАналитик КАК МаксКлючевыхАналитик,
		|	ВидыОтчетов.ВидАналитики1 КАК ВидАналитики1,
		|	ВидыОтчетов.ВидАналитики2 КАК ВидАналитики2,
		|	ВидыОтчетов.ВидАналитики3 КАК ВидАналитики3,
		|	ВидыОтчетов.ВидАналитики4 КАК ВидАналитики4,
		|	ВидыОтчетов.ВидАналитики5 КАК ВидАналитики5,
		|	ВидыОтчетов.ВидАналитики6 КАК ВидАналитики6,
		|	ВидыОтчетов.ВидАналитики1.ТипЗначения КАК ТипЗначенияАналитики1,
		|	ВидыОтчетов.ВидАналитики2.ТипЗначения КАК ТипЗначенияАналитики2,
		|	ВидыОтчетов.ВидАналитики3.ТипЗначения КАК ТипЗначенияАналитики3,
		|	ВидыОтчетов.ВидАналитики4.ТипЗначения КАК ТипЗначенияАналитики4,
		|	ВидыОтчетов.ВидАналитики5.ТипЗначения КАК ТипЗначенияАналитики5,
		|	ВидыОтчетов.ВидАналитики6.ТипЗначения КАК ТипЗначенияАналитики6
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	ВидыОтчетов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ВидОтчета);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеВидаОтчета, Выборка);
	КонецЕсли;
	
	Возврат ДанныеВидаОтчета;

КонецФункции

