Функция ПраваДоступаБюджетирование() Экспорт
	
	ПраваДоступа = Новый Структура;
	ПраваДоступа.Вставить("НастраиваемыйОтчет_Изменение",			Ложь);
	ПраваДоступа.Вставить("УправлениеПериодомСценария_Изменение",	Ложь);
	
	ПраваДоступа.Вставить("БланкиОтчетов_Изменение",				Ложь);
	
	ПраваДоступа.Вставить("ОписаниеВерсий_Удаление",				Ложь);
	
	ПраваДоступа.Вставить("ПериодическиеКурсы_Изменение",			Ложь);
	
	Если НЕ ИспользуетсяМногопериоднаяОтчетность() Тогда
		Возврат ПраваДоступа;
	КонецЕсли;
	
	ПраваДоступа.Вставить("НастраиваемыйОтчет_Изменение",			ПравоДоступа("Изменение", Метаданные.Документы.НастраиваемыйОтчет));
	ПраваДоступа.Вставить("УправлениеПериодомСценария_Изменение",	ПравоДоступа("Изменение", Метаданные.Документы.УправлениеПериодомСценария));
	
	ПраваДоступа.Вставить("БланкиОтчетов_Изменение",				ПравоДоступа("Изменение", Метаданные.Справочники.БланкиОтчетов));
	
	ПраваДоступа.Вставить("ОписаниеВерсий_Удаление",				ПравоДоступа("Удаление", Метаданные.Справочники.ОписаниеВерсий));
	
	ПраваДоступа.Вставить("ПериодическиеКурсы_Изменение",			ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПериодическиеКурсы));

	Возврат ПраваДоступа;
	
КонецФункции

