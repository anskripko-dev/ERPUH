Процедура ЗаполнитьПоДокументуПланирования(Объект, Знач ДанныеЗаполнения)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Резервирование") Тогда
		ЗаявкиНаОперации.ЗаполнитьПоДокументуОперативныйПлан(Объект, ДанныеЗаполнения);
	Иначе
		ЗаявкиНаОперации.ЗаполнитьЗаявкуПоДокументуПланирования(Объект, ДанныеЗаполнения);
	КонецЕсли;

КонецПроцедуры // ЗаполнитьПоДокументуПланирования() 

Процедура ЗаполнитьТабличнуюЧастьПоСтруктуре(Объект, ИмяТЧ, Знач ДанныеЗаполнения)
	
	ИмяТЧ = "РасшифровкаПлатежа";
	
	НоваяСтрока = Объект[ИмяТЧ].Добавить();
	НоваяСтрока.СтатьяДвиженияДенежныхСредств = ДанныеЗаполнения.СтатьяБюджета;		
	
	Для Сч = 1 По 3 Цикл
		Если ДанныеЗаполнения.Свойство("Аналитика" + Сч) Тогда
			НоваяСтрока["Аналитика" + Сч] = ДанныеЗаполнения["Аналитика" + Сч];
		КонецЕсли;
	КонецЦикла; 
	
	Если ДанныеЗаполнения.Свойство("СтавкаНДС") Тогда
		НоваяСтрока.СтавкаНДС = ДанныеЗаполнения.СтавкаНДС;	
	КонецЕсли;   
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьПоДокументуПланирования(Объект, ИмяТЧ)
	
	РасшифровкаИсходная = Объект.ДокументПланирования.ДвиженияОперации.Выгрузить();
	
	РасшифровкаИсходная.Свернуть("СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3","Сумма, Количество");
	
	РасшифровкаИсходная.ЗаполнитьЗначения(0, "Сумма,Количество");
	
	РасшифровкаИсходная.Колонки.СтатьяБюджета.Имя = "СтатьяДвиженияДенежныхСредств";
	
	Объект[ИмяТЧ].Загрузить(РасшифровкаИсходная);
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьПоДоговоруКонтрагента(Объект, ИмяТЧ, Знач ДанныеЗаполнения = Неопределено) Экспорт
	
	Если Не Объект[ИмяТЧ].Количество() Тогда
		Объект[ИмяТЧ].Добавить();
	КонецЕсли;
	
	//
	Если ДанныеЗаполнения = Неопределено Тогда
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("СтатьяДвиженияДенежныхСредств", "СтатьяДвиженияДенежныхСредств");
		СтруктураРеквизитов.Вставить("Аналитика1", "АналитикаБДДС1");
		СтруктураРеквизитов.Вставить("Аналитика2", "АналитикаБДДС2");
		СтруктураРеквизитов.Вставить("Аналитика3", "АналитикаБДДС3");
		
		ДанныеЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, СтруктураРеквизитов);
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Объект[ИмяТЧ] Цикл
		ЗаполнитьЗначенияСвойств(ТекСтрока, ДанныеЗаполнения, "СтатьяДвиженияДенежныхСредств, Аналитика1, Аналитика2, Аналитика3");
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПоДоговоруКонтрагента(Объект, Знач Договор)
	
	//
	ОМ = ЗаявкиНаОперации;
	РеквизитыЗаявки = ОМ.РеквизитыДокументаЗаявка(ТипЗнч(Объект.Ссылка));
	
	РеквизитыДоговора = Новый Структура;
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		РеквизитыДоговора.Вставить("Контрагент", "Владелец");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		РеквизитыДоговора.Вставить("Организация");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ЦФО) Тогда
		РеквизитыДоговора.Вставить("ЦФО", "ОсновнойЦФО");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Проект) Тогда
		РеквизитыДоговора.Вставить("Проект", "ОсновнойПроект");
	КонецЕсли;
	
	РеквизитыДоговора.Вставить("ВалютаДокумента", "ВалютаВзаиморасчетов");
	РеквизитыДоговора.Вставить("ВалютаОплаты", "ОсновнаяВалютаПлатежей");
	
	Если Не ЗначениеЗаполнено(ОМ.РеквизитЗаявки(Объект, РеквизитыЗаявки.БанковскийСчетКонтрагента)) Тогда
		РеквизитыДоговора.Вставить(РеквизитыЗаявки.БанковскийСчетКонтрагента.ИмяРеквизита, "БанковскийСчетКонтрагента");
	КонецЕсли;
	
	РеквизитыДоговора.Вставить("ИдентификаторПлатежа");
	//РеквизитыДоговора.Вставить("РасчетыВУсловныхЕдиницахВалюта");
	РеквизитыДоговора.Вставить("ЗапретПлатежаВПрочихВалютах");
	РеквизитыДоговора.Вставить("СпособОпределенияКурсаПлатежа");
	РеквизитыДоговора.Вставить("ДатаФиксацииКурсаПлатежа");
	РеквизитыДоговора.Вставить("СдвигДатыФиксацииКурсаПлатежа");
	РеквизитыДоговора.Вставить("КурсПлатежа");
	РеквизитыДоговора.Вставить("КратностьПлатежа");
	РеквизитыДоговора.Вставить("ФиксированныйСчетОрганизации");
	РеквизитыДоговора.Вставить("ФиксированныйСчетКонтрагента");
	РеквизитыДоговора.Вставить("ГосударственныйКонтракт");
	РеквизитыДоговора.Вставить("КурсПлатежаНеБолее");
	РеквизитыДоговора.Вставить("КурсПлатежаНеМенее");
	РеквизитыДоговора.Вставить("КурсПлатежаНеБолееВВалютеОплаты");
	РеквизитыДоговора.Вставить("КурсПлатежаНеМенееВВалютеОплаты");
	РеквизитыДоговора.Вставить("БанковскийСчет");
	РеквизитыДоговора.Вставить("Организация"); 	

	Если ЗначениеЗаполнено(РеквизитыДоговора) Тогда
		
		СтруктураРеквизитовДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, РеквизитыДоговора);
		ЗаполнитьЗначенияСвойств(Объект, СтруктураРеквизитовДоговора);
		
		ВалютаРегламентированногоУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРеквизитовДоговора.Организация, "ВалютаРегламентированногоУчета");
		Объект.ПлатежВУсловныхЕдиницах = СтруктураРеквизитовДоговора.ВалютаОплаты <> СтруктураРеквизитовДоговора.ВалютаДокумента ИЛИ СтруктураРеквизитовДоговора.ВалютаОплаты <> ВалютаРегламентированногоУчета;
		
		Если ЗначениеЗаполнено(Объект.ВалютаОплаты) И ЗначениеЗаполнено(Объект.Валюта) Тогда   	
			
			ПараметрыКурса = ПлатежныеПозицииКлиентСервер.СтруктураПараметровРасчетаКурса();
			ЗаполнитьЗначенияСвойств(ПараметрыКурса, Объект);
			ПараметрыКурса.ВалютаДокумента = Объект.Валюта;    
			ПараметрыКурса.ДатаПлатежа = Объект.ЖелательнаяДатаПлатежа;
			ПлатежныеПозиции.ЗаполнитьПараметрыКурса(ПараметрыКурса, Объект);

			СтруктураКурса = ДвиженияБюджетированиеУХ.ПолучитьАктуальныйКурсПоПараметрам(ПараметрыКурса);
			
			Объект.КурсПлатежа = СтруктураКурса.Курс;
			Объект.КратностьПлатежа = СтруктураКурса.Кратность; 
		КонецЕсли;  
		
		Для каждого СтрокаРасшифровкаПлатежа Из Объект.РасшифровкаПлатежа Цикл 
			Если Не ЗначениеЗаполнено(СтрокаРасшифровкаПлатежа.ЦФО) Тогда
				СтрокаРасшифровкаПлатежа.ЦФО = Объект.ЦФО;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаРасшифровкаПлатежа.Проект) Тогда
				СтрокаРасшифровкаПлатежа.Проект = Объект.Проект;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоДоговоруКредитаДепозита(Объект, Знач Договор)
	
	ОМ = ЗаявкиНаОперации;
	РеквизитыЗаявки = ОМ.РеквизитыДокументаЗаявка(ТипЗнч(Объект.Ссылка));
	
	РеквизитыДоговора = Новый Структура;
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		РеквизитыДоговора.Вставить("Контрагент");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		РеквизитыДоговора.Вставить("Организация");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		РеквизитыДоговора.Вставить("Валюта", "ВалютаВзаиморасчетов");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВалютаОплаты) Тогда
		РеквизитыДоговора.Вставить("ВалютаОплаты", "ОсновнаяВалютаПлатежей");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.БанковскийСчетКонтрагента) Тогда	
		РеквизитыДоговора.Вставить("БанковскийСчетКонтрагента");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.БанковскийСчет) Тогда
		РеквизитыДоговора.Вставить("БанковскийСчет");
	КонецЕсли;
			
	Если ЗначениеЗаполнено(РеквизитыДоговора) Тогда
		СтруктураРеквизитовДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, РеквизитыДоговора);
		ЗаполнитьЗначенияСвойств(Объект, СтруктураРеквизитовДоговора);
	КонецЕсли;
	
	Объект.ПлатежВУсловныхЕдиницах = Объект.Валюта <> Объект.ВалютаОплаты;
	
	Если Объект.ПлатежВУсловныхЕдиницах Тогда
		Объект.СпособОпределенияКурсаПлатежа = Перечисления.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа;	
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьПоДоговоруАренды(Объект, Знач Договор)
	
	РеквизитыДоговора = Новый Структура;	
	РеквизитыДоговора.Вставить("ВалютаВзаиморасчетов");
	РеквизитыДоговора.Вставить("ВалютаОплаты", "ВалютаВзаиморасчетов");
	РеквизитыДоговора.Вставить("Организация");  
	Если Не ЗначениеЗаполнено(Объект.ЦФО) Тогда
		РеквизитыДоговора.Вставить("ЦФО", "ОсновнойЦФО");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Проект) Тогда
		РеквизитыДоговора.Вставить("Проект", "ОсновнойПроект");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыДоговора) Тогда
		
		СтруктураРеквизитовДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, РеквизитыДоговора);     
		СтруктураРеквизитовДоговора.Вставить("Валюта", СтруктураРеквизитовДоговора.ВалютаВзаиморасчетов);
		
		ЗаполнитьЗначенияСвойств(Объект, СтруктураРеквизитовДоговора);
		
		ВалютаРегламентированногоУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРеквизитовДоговора.Организация, "ВалютаРегламентированногоУчета");
		
		Если ЗначениеЗаполнено(Объект.ВалютаОплаты) И ЗначениеЗаполнено(Объект.Валюта) Тогда   	
			
			ПараметрыКурса = ПлатежныеПозицииКлиентСервер.СтруктураПараметровРасчетаКурса();
			ЗаполнитьЗначенияСвойств(ПараметрыКурса, Объект);
			ПараметрыКурса.ВалютаДокумента = Объект.Валюта;    
			ПараметрыКурса.ДатаПлатежа = Объект.ЖелательнаяДатаПлатежа;
			ПлатежныеПозиции.ЗаполнитьПараметрыКурса(ПараметрыКурса, Объект);

			СтруктураКурса = ДвиженияБюджетированиеУХ.ПолучитьАктуальныйКурсПоПараметрам(ПараметрыКурса);
			
			Объект.КурсПлатежа = СтруктураКурса.Курс;
			Объект.КратностьПлатежа = СтруктураКурса.Кратность; 
		КонецЕсли;  
		
		Для каждого СтрокаРасшифровкаПлатежа Из Объект.РасшифровкаПлатежа Цикл 
			
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровкаПлатежа, СтруктураРеквизитовДоговора); 
			ЭСЗПоУмолчанию = ДоговорыКонтрагентовВстраиваниеУХ.ПолучитьЭлементСтруктурыЗадолженностиПоДоговоруПоУмолчанию(Объект, Договор); 
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровкаПлатежа, ЭСЗПоУмолчанию);
	
			Если Не ЗначениеЗаполнено(СтрокаРасшифровкаПлатежа.ЦФО) Тогда
				СтрокаРасшифровкаПлатежа.ЦФО = Объект.ЦФО;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаРасшифровкаПлатежа.Проект) Тогда
				СтрокаРасшифровкаПлатежа.Проект = Объект.Проект;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьСтавкуНДСПоДоговору(Организация, Договор)  Экспорт
	
	ЭтоРасчетыСКлиентами = Ложь;
	ОбъектыРасчетов = Новый Массив;
	ОбъектыРасчетов.Добавить(Договор);
	
	ТаблицаНДС = ДенежныеСредстваСервер.РасшифровкаПлатежаНДС(Организация, Неопределено, Неопределено, ОбъектыРасчетов, ЭтоРасчетыСКлиентами);
	Если ТаблицаНДС.Количество() = 1 Тогда
		Возврат ТаблицаНДС[0].СтавкаНДС;
	Иначе
		Возврат Справочники.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Вызывается из ОМ.ВстраиваниеУХОжидаемоеПоступлениеДС
Процедура ЗаполнитьДоговорКонтрагента(Объект) Экспорт

	Перем ДоговорКонтрагента;   
	
	ЭтоЗаявка = ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств");
	ДопустимыеВидыДоговоров = ВидыОперацийУХВызовСервераПовтИсп.ВидыДоговоров(Объект.ВидОперацииУХ);
	
	ЭтоКредитЗаймДепозит = Ложь; 
	ЭтоАренда = Ложь;
	
	Для Каждого ЭлементКоллеции Из ДопустимыеВидыДоговоров Цикл
		
		Если УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорАренды(ЭлементКоллеции) Тогда
			ЭтоАренда = Истина;	
		КонецЕсли;

		Если УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорДепозит(ЭлементКоллеции)
			Или УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорКредит(ЭлементКоллеции) 
			Или УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорЗаем(ЭлементКоллеции) Тогда
			
			ЭтоКредитЗаймДепозит = Истина;
			
		КонецЕсли;	
		
		Если ЭтоАренда Или ЭтоКредитЗаймДепозит Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 	
	
	Если ЭтоАренда Тогда
		ДоговорКонтрагента = Объект.ДоговорАренды;	
	КонецЕсли;

	Если ЭтоКредитЗаймДепозит Тогда
		ДоговорКонтрагента = Объект.ДоговорКредитаДепозита;	
	КонецЕсли;   
	
	Если Не ЭтоАренда И Не ЭтоКредитЗаймДепозит Тогда
		Если ЗначениеЗаполнено(Объект.Договор) Тогда
			ДоговорКонтрагента = Объект.Договор;
		КонецЕсли;	
	КонецЕсли;   

	Объект.ДоговорКонтрагента = ДоговорКонтрагента; 

	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) И ЭтоЗаявка Тогда
		Для каждого СтрокаРасшифровка Из Объект.РасшифровкаПлатежа Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаРасшифровка.ДоговорКонтрагента) Тогда
				СтрокаРасшифровка.ДоговорКонтрагента = Объект.ДоговорКонтрагента;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	
	//Очистить неиспользуемые договора
	МассивРеквизитов = Новый Массив; 
	Если ЭтоАренда Тогда
		МассивРеквизитов.Добавить("ДоговорКредитаДепозита");
	ИначеЕсли ЭтоКредитЗаймДепозит Тогда
		МассивРеквизитов.Добавить("ДоговорАренды");    
	Иначе
		МассивРеквизитов.Добавить("ДоговорАренды");  
		МассивРеквизитов.Добавить("ДоговорКредитаДепозита"); 
	КонецЕсли;
	
	ДенежныеСредстваСервер.ОчиститьНеиспользуемыеРеквизиты(Объект, МассивРеквизитов, Новый Массив);

КонецПроцедуры

Процедура ЗаполнитьТипСуммыКредитаДепозита(Объект)
	
	МассивВсехРеквизитов = Новый Массив;
	МассивРеквизитовОперации = Новый Массив;
	
	Документы.ЗаявкаНаРасходованиеДенежныхСредств.ЗаполнитьИменаРеквизитовПоХозяйственнойОперации(
		Объект, МассивВсехРеквизитов, МассивРеквизитовОперации);
		
	Если МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.ТипСуммыКредитаДепозита") <> Неопределено Тогда
		
		Для каждого Строка Из Объект.РасшифровкаПлатежа Цикл
			Строка.ТипСуммыКредитаДепозита = ЗаявкиНаОперацииКлиентСервер.ТипСуммыКредитаДепозитаПоЭлементуСтруктурыЗадолженности(
				Строка.ЭлементСтруктурыЗадолженности);
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьПлатежныеПозицииПоДаннымДокумента(Форма)
	Объект = Форма.Объект;
	НоваяПлатежнаяПозиция = ПлатежныеПозиции.НоваяПлатежнаяПозицияПоДаннымДокумента(Объект);
	Форма.ПлатежнаяПозиция.Загрузить(НоваяПлатежнаяПозиция);
	ПлатежныеПозицииКлиентСервер.ОбновитьПредставлениеПлатежнойПозиции(Форма);
КонецПроцедуры

// процедура ЗаполнитьПараметрыДействия()
// заполняет параметры для синхронизации документа ожидаемое поступление денежных средств 
Функция ЗаполнитьПараметрыДействия(Объект)

	ПараметрыДействия = Новый Структура("Проведен, ПометкаУдаления", 
									Объект.Проведен, Объект.ПометкаУдаления);
	Возврат ПараметрыДействия;

КонецФункции // ЗаполнитьПараметрыДействия()

Процедура ЗаполнитьЦФОПроект(Объект)
	
	ОднаСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Количество() = 1;
	
	Если НЕ Объект.ОплатаПоДоговоруПоставки Тогда
		
		Для каждого СтрокаДвижения Из Объект.РасшифровкаПлатежа Цикл
			СтрокаДвижения.ЦФО 		= Объект.ЦФО;			
		    СтрокаДвижения.Проект 	= Объект.Проект;
		КонецЦикла;                                                    
		
	ИначеЕсли ОднаСтрокаРасшифровки Тогда 
		
		Для каждого СтрокаДвижения Из Объект.РасшифровкаПлатежа Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаДвижения.ЦФО) Тогда
				СтрокаДвижения.ЦФО 		= Объект.ЦФО;			
			КонецЕсли;                 
			Если НЕ ЗначениеЗаполнено(СтрокаДвижения.Проект) Тогда
		    	СтрокаДвижения.Проект 	= Объект.Проект;
			КонецЕсли;	
		КонецЦикла;                                                    
				
	КонецЕсли;

КонецПроцедуры

Функция ДанныеЗаполненияРезервирование(ДокументРезервирование)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Резервирование.ВидБюджета КАК ВидБюджета,
	|	Резервирование.ВидОперации КАК ВидОперации,
	|	Резервирование.ВариантНастройки КАК ВариантНастройки,
	|	Резервирование.ВалютаДокумента КАК ВалютаДокумента,
	|	Резервирование.ВалютаДокумента КАК ВалютаВзаиморасчетов,
	|	Резервирование.СуммаДокумента КАК СуммаДокумента,
	|	Резервирование.СуммаДокумента КАК Сумма,
	|	Резервирование.СуммаДокумента КАК СуммаВзаиморасчетов,
	|	Резервирование.ДатаНачала КАК ДатаНачала,
	|	Резервирование.ДатаОкончания КАК ДатаОкончания,
	|	Резервирование.ЦФО КАК ЦФО,
	|	Резервирование.Проект КАК Проект,
	|	Резервирование.Организация КАК Организация,
	|	Резервирование.Контрагент КАК Контрагент,
	|	Резервирование.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Резервирование.СтатьяБюджета КАК СтатьяБюджета,
	|	Резервирование.Аналитика1 КАК Аналитика1,
	|	Резервирование.Аналитика2 КАК Аналитика2,
	|	Резервирование.Аналитика3 КАК Аналитика3,
	|	Резервирование.Аналитика4 КАК Аналитика4,
	|	Резервирование.Аналитика5 КАК Аналитика5,
	|	ЛОЖЬ КАК ФормаОплатыНаличная,
	|	ИСТИНА КАК ФормаОплатыБезналичная
	|ИЗ
	|	Документ.Резервирование КАК Резервирование
	|ГДЕ
	|	Резервирование.Ссылка = &ДокументРезервирование";
	
	Запрос.УстановитьПараметр("ДокументРезервирование", ДокументРезервирование);     
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеЗаполнения = Новый Структура;
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ДанныеЗаполнения.Вставить(Колонка.Имя);
	КонецЦикла;
	
	ВыборкаДетальныхЗаписей = РезультатЗапроса.Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыборкаДетальныхЗаписей.Следующий();
	
	ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, ВыборкаДетальныхЗаписей);
	
	ДанныеЗаполнения.Вставить("ЖелательнаяДатаПлатежа", ТекущаяДатаСеанса());
		
	РеквизитыДокумента = Новый Структура;
	Для Каждого ЭлементКоллекции Из ДанныеЗаполнения Цикл
		
		Если Не ЗначениеЗаполнено(ЭлементКоллекции.Значение) Тогда
			Продолжить;
		КонецЕсли; 
		
		РеквизитыДокумента.Вставить(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
		
	КонецЦикла;   
	
	Возврат РеквизитыДокумента;
 
КонецФункции // ()

