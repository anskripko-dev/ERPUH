// Климов Антон 21.02.2022 Выполнение задач №000040445
Процедура тн_ПриПроведенииУпрУчетНДСОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	// НАЧАЛО Борисенко Игорь 07.09.2022 Выполнение задач №000042546
	//Попытка
	//            ФлагОснования = Источник.ДокументОснование.тн_УпрУчетНДС;
	//Исключение
	//            ФлагОснования = Ложь;
	//КонецПопытки;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДокументОснование", Источник.Метаданные())
		И ЗначениеЗаполнено(Источник.ДокументОснование)
		И ОбщегоНазначения.ЕстьРеквизитОбъекта("тн_УпрУчетНДС", Источник.ДокументОснование.Метаданные()) Тогда
		ФлагОснования = Источник.ДокументОснование.тн_УпрУчетНДС;
	Иначе
		ФлагОснования = Ложь;
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 07.09.2022 Выполнение задач №000042546
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.КорректировкаПриобретения") И ФлагОснования Тогда
		ВидДвижения = ВидДвиженияНакопления.Приход;
		СуммаНДС = Источник.Расхождения.Итог("СуммаНДС");
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.КорректировкаРеализации") И ФлагОснования Тогда
		ВидДвижения = ВидДвиженияНакопления.Расход;
		СуммаНДС = Источник.Расхождения.Итог("СуммаНДС");
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ВидДвижения = ВидДвиженияНакопления.Расход;
		СуммаНДС = Источник.Товары.Итог("СуммаНДС");
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
		ВидДвижения = ВидДвиженияНакопления.Приход;
		СуммаНДС = Источник.Товары.Итог("СуммаНДС");
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияУслугПрочихАктивов") Тогда
		ВидДвижения = ВидДвиженияНакопления.Расход;
		СуммаНДС = Источник.Доходы.Итог("СуммаНДС");
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") Тогда
		ВидДвижения = ВидДвиженияНакопления.Приход;
		СуммаНДС = Источник.Расходы.Итог("СуммаНДС");
	// НАЧАЛО Климов Антон 16.06.2022 Выполнение задач №000041605
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ВозвратТоваровПоставщику") Тогда
		ВидДвижения = ВидДвиженияНакопления.Приход;
		СуммаНДС = - Источник.Товары.Итог("СуммаНДС");
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ОтчетПереработчика") Тогда
		ВидДвижения = ВидДвиженияНакопления.Приход;
		СуммаНДС = Источник.Услуги.Итог("СуммаНДС");
	// КОНЕЦ  Климов Антон 16.06.2022 Выполнение задач №000041605
	Иначе
		СуммаНДС = 0;
	КонецЕсли;
	
	Если Не Отказ И Источник.тн_УпрУчетНДС И СуммаНДС<>0 Тогда
		СтатьяНДСОтл = Константы.тн_СтатьяНДСОтложенный.Получить();
		Если СтатьяНДСОтл = Неопределено 
			Или СтатьяНДСОтл = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПустаяСсылка() Тогда
			ОбщегоНазначения.СообщитьПользователю("Не установлена статья учета НДС отложенного. Движения по упр. учету НДС отложенный не сделаны.");
			Возврат;
		КонецЕсли;
		ДвиженияАП = Источник.Движения.ПрочиеАктивыПассивы;
		ДвиженияАП.Прочитать();
		НовДвижениеАП = ДвиженияАП.Добавить();
		НовДвижениеАП.ВидДвижения = ВидДвижения;
		НовДвижениеАП.Период = Источник.Дата;
		НовДвижениеАП.Организация = Источник.Организация;
		НовДвижениеАП.Подразделение = Источник.Подразделение;
		НовДвижениеАП.Сумма = СуммаНДС;
		НовДвижениеАП.Аналитика = Источник.Контрагент;
		НовДвижениеАП.Статья = СтатьяНДСОтл;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВидимостьФлагаУпрУчетаНДС

// Климов Антон 21.02.2022 Выполнение задач №000040445
// Устанавливает свойство Видимость элемента формы в значение Видимость.
// Ищет элемент с именем ИмяРеквизита, если не находит, создает поле флага.
// Параметры: 	Форма 		- Форма для размещения/поиска реквизита
//				Реквизит 	- Структура:
//						Имя			- строка - Имя реквизита на форме
//						Заголовок 	- Строка - Заголовок реквизита
//				Видимость 	- Булево - Признак видимости флага	
Процедура тн_СоздатьУстановитьВидимостьЭлементаНаФорме(Форма, Реквизит, Видимость)
	
	ИмяРеквизита = СокрЛП(Реквизит.Имя);
	Заголовок = СокрЛП(Реквизит.Заголовок);
	РеквизитЭлемент = Форма.Элементы.Найти(ИмяРеквизита);
	
	Если РеквизитЭлемент = Неопределено Тогда
		ГруппаРазмещенияЭлемента = Форма.Элементы.Найти("тн_ГруппаУпрУчетНДС");
		РеквизитЭлемент = Форма.Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ГруппаРазмещенияЭлемента);
		РеквизитЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		РеквизитЭлемент.Заголовок = Заголовок;
		РеквизитЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		РеквизитЭлемент.ПутьКДанным = "Объект." + ИмяРеквизита;
	КонецЕсли;
	
	РеквизитЭлемент.Видимость = Видимость;
	
КонецПроцедуры

// Климов Антон 21.02.2022 Выполнение задач №000040445
Функция тн_ВидимостьФлагаУпрУчетНДС (ОбъектФорма)
	
	ТипДокумента = ТипЗнч(ОбъектФорма.Объект.Ссылка);
	ВидимостьФлага = Ложь;
	Если (ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Или 
		ТипДокумента = Тип("ДокументСсылка.КорректировкаПриобретения")) И 
		(ОбъектФорма.Объект.ВидКорректировки = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок Или 
		ОбъектФорма.Объект.ВидКорректировки = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон) Тогда   
		// НАЧАЛО Юдина Екатерина 14.08.2025 Выполнение задач №000054791  
		//ВидимостьФлага = ОбъектФорма.Объект.ДокументОснование.тн_УпрУчетНДС; 
		Если ЗначениеЗаполнено(ОбъектФорма.Объект.ДокументОснование) Тогда
			ВидимостьФлага = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ОбъектФорма.Объект.ДокументОснование, "тн_УпрУчетНДС");
        КонецЕсли;
		// КОНЕЦ Юдина Екатерина 14.08.2025 Выполнение задач №000054791
	КонецЕсли;
	Если ТипДокумента = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
		ВидимостьФлага = (ОбъектФорма.Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту) Или
		(ОбъектФорма.Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияВнеоборотныхАктивов);

	КонецЕсли;
	Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Или 
		ТипДокумента = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Или
		// НАЧАЛО Климов Антон 16.06.2022 Выполнение задач №000041605
		ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Или
		ТипДокумента = Тип("ДокументСсылка.ОтчетПереработчика") Или
		// КОНЕЦ  Климов Антон 16.06.2022 Выполнение задач №000041605
		ТипДокумента = Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов") Тогда
		ВидимостьФлага = Истина;                                                                                                       
	КонецЕсли;

	Возврат ВидимостьФлага;
	
КонецФункции

// Климов Антон 21.02.2022 Выполнение задач №000040445
Процедура тн_УстановитьВидимостьФлагаУпрУчетНДС(ОбъектФорма) Экспорт
	
	Видимость = тн_ВидимостьФлагаУпрУчетНДС(ОбъектФорма);
	Если Не Видимость Тогда
		ОбъектФорма.Объект.тн_УпрУчетНДС = Ложь;
	КонецЕсли;
	
	Реквизит = Новый Структура("Имя, Заголовок", "тн_УпрУчетНДС", "Упр. учет (НДС)");
	тн_СоздатьУстановитьВидимостьЭлементаНаФорме(ОбъектФорма, Реквизит, Видимость);
	
КонецПроцедуры

#КонецОбласти
