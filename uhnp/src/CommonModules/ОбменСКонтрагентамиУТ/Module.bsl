			СтрокаГрузоотправителя = ТаблицаГрузоотправителей.Добавить();
			СтрокаГрузоотправителя.ОнЖе = Истина;
		ИначеЕсли СведенияОПоставщиках.Количество() > 0 Тогда
			Для Каждого СведенияОГрузоотправителе Из СведенияОПоставщиках Цикл
				ДанныеГрузоотправителя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОГрузоотправителе,
					ПриоритетыВидовКИГрузоотправителя,,
