
Процедура ПереоценкаВалютныхАктивовИОбязательствПриПроведенииОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Реквизиты = Источник.ДополнительныеСвойства.ДляПроведения.Реквизиты;
	ТаблицаРазниц = Источник.ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПроводок.СкопироватьКолонки();

	// НАЧАЛО Юдина Екатерина 14.05.2025 Выполнение задач №000053679   
	ОрганизацияБУ = тн_Интеграция_ERP_УХ_ПовтИсп.ЗначениеДополнительнойНастройкиПоОрганизации(Реквизиты.Период, Реквизиты.Организация, "ОрганизацияПереоценкаБУ"); 
	Если Не ЗначениеЗаполнено(ОрганизацияБУ) Тогда 
		Возврат;   
	Иначе
		Реквизиты.Вставить("ОрганизацияБУ", ОрганизацияБУ);
	КонецЕсли;
	// КОНЕЦ Юдина Екатерина 14.05.2025 Выполнение задач №000053679	
	
	Запрос = Новый Запрос;
	ТекстЗапроса = Новый Массив;
	ТекстЗапроса.Добавить(ТекстЗапросаРасчетыСПоставщикамиИПокупателями());
	ТекстЗапроса.Добавить(ТекстЗапросаРасчетыСПодотчетнымиЛицами());
	ТекстЗапроса = СтрСоединить(ТекстЗапроса, ПроведениеСерверУХ.РазделительЗапросовВПакете());
    Запрос.Текст = ТекстЗапроса;
	УстановитьПараметрыЗапроса(Запрос, Реквизиты);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаПоставщикиИПокупатели = РезультатЗапроса[6].Выбрать();
	ЗаполнитьТаблицуРазниц(ВыборкаПоставщикиИПокупатели, Реквизиты, ТаблицаРазниц);
	ВыборкаПодотчетныеЛица = РезультатЗапроса[13].Выбрать();
	ЗаполнитьТаблицуРазниц(ВыборкаПодотчетныеЛица, Реквизиты, ТаблицаРазниц);
	//НАЧАЛО Блинова М.А. 01.08.2025 Выполнение задач №000054301  
	Если Реквизиты.ФункциональнаяВалюта = Реквизиты.ВалютаПредставления Тогда
		Для Каждого СтрокаТаблицаРазниц Из ТаблицаРазниц Цикл
			СтрокаТаблицаРазниц.СуммаВВалютеОтчетности = СтрокаТаблицаРазниц.СуммаВФункциональнойВалюте;
		КонецЦикла;  
	КонецЕсли;
	//КОНЕЦ Блинова М.А. 01.08.2025 Выполнение задач №000054301

	Если ТаблицаРазниц.Количество() > 0 Тогда
		МСФОВызовСервераУХ.ОтразитьДвиженияПоТаблицеПроводок(Источник.Движения, ТаблицаРазниц, Реквизиты, Отказ, Ложь); 
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаРасчетыСПоставщикамиИПокупателями()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ХозрасчетныйВидыСубконто.Ссылка КАК СчетБУ,
	|	МАКСИМУМ(ХозрасчетныйВидыСубконто.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_СчетаБУСКонтрагентомИДоговором
	|ИЗ
	|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ХозрасчетныйВидыСубконто.НомерСтроки = 1
	|					И ХозрасчетныйВидыСубконто.ВидСубконто = &ВидСубконтоКонтрагентХозр
	|				ТОГДА ИСТИНА
	|			КОГДА ХозрасчетныйВидыСубконто.НомерСтроки = 2
	|					И ХозрасчетныйВидыСубконто.ВидСубконто = &ВидСубконтоДоговорХозр
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И ХозрасчетныйВидыСубконто.Ссылка.Валютный
	|	И ХозрасчетныйВидыСубконто.Ссылка.ИсключитьСуммуБУИзПереоценкиПоПлануСчетов
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйВидыСубконто.Ссылка
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ХозрасчетныйВидыСубконто.НомерСтроки) > 1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МСФОВидыСубконто.Ссылка КАК СчетУУ,
	|	МАКСИМУМ(МСФОВидыСубконто.НомерСтроки) КАК НомерСтроки,
	|	МСФОВидыСубконто.Ссылка.СчетаУчетаКурсовыхРазниц КАК СчетаУчетаКурсовыхРазниц
	|ПОМЕСТИТЬ ВТ_СчетаУУСКонтрагентомИДоговором
	|ИЗ
	|	ПланСчетов.МСФО.ВидыСубконто КАК МСФОВидыСубконто
	|ГДЕ
	|	ВЫБОР
	|			КОГДА МСФОВидыСубконто.НомерСтроки = 1
	|					И МСФОВидыСубконто.ВидСубконто = &ВидСубконтоКонтрагентКорп
	|				ТОГДА ИСТИНА
	|			КОГДА МСФОВидыСубконто.НомерСтроки = 2
	|					И МСФОВидыСубконто.ВидСубконто = &ВидСубконтоДоговорКорп
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И МСФОВидыСубконто.Ссылка.Валютный
	|	И НЕ МСФОВидыСубконто.Ссылка.СчетаУчетаКурсовыхРазниц = ЗНАЧЕНИЕ(Справочник.СчетаУчетаКурсовыхРазниц.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	МСФОВидыСубконто.Ссылка,
	|	МСФОВидыСубконто.Ссылка.СчетаУчетаКурсовыхРазниц
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(МСФОВидыСубконто.НомерСтроки) > 1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетУУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тн_СопоставлениеСчетовБУ_УУ.СчетБУ КАК СчетБУ,
	|	тн_СопоставлениеСчетовБУ_УУ.СчетУУ КАК СчетУУ
	|ПОМЕСТИТЬ ВТ_СчетаПереоценки
	|ИЗ
	|	РегистрСведений.тн_СопоставлениеСчетовБУ_УУ КАК тн_СопоставлениеСчетовБУ_УУ
	|ГДЕ
	|	тн_СопоставлениеСчетовБУ_УУ.ПереоценкаУУРавнаБУ
	|	И тн_СопоставлениеСчетовБУ_УУ.СчетБУ В
	|			(ВЫБРАТЬ
	|				ВТ_СчетаБУСКонтрагентомИДоговором.СчетБУ КАК СчетБУ
	|			ИЗ
	|				ВТ_СчетаБУСКонтрагентомИДоговором КАК ВТ_СчетаБУСКонтрагентомИДоговором)
	|	И тн_СопоставлениеСчетовБУ_УУ.СчетУУ В
	|			(ВЫБРАТЬ
	|				ВТ_СчетаУУСКонтрагентомИДоговором.СчетУУ КАК СчетУУ
	|			ИЗ
	|				ВТ_СчетаУУСКонтрагентомИДоговором КАК ВТ_СчетаУУСКонтрагентомИДоговором)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет КАК Счет,
	|	ХозрасчетныйОстатки.Субконто1 КАК Контрагент,
	|	ХозрасчетныйОстатки.Субконто2 КАК Договор,
	|	ХозрасчетныйОстатки.Валюта КАК Валюта,
	|	ХозрасчетныйОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
	|	ХозрасчетныйОстатки.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ ВТ_ДанныеБУОстатки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_СчетаПереоценки.СчетБУ КАК СчетБУ
	|				ИЗ
	|					ВТ_СчетаПереоценки КАК ВТ_СчетаПереоценки),
	|			&СубконтоХозрасчетные,
	// НАЧАЛО Юдина Екатерина 14.05.2025 Выполнение задач №000053679   
	|           Организация = &ОрганизацияБУ И
	// КОНЕЦ Юдина Екатерина 14.05.2025 Выполнение задач №000053679   
	|			НЕ Валюта В (&СписокВалют)) КАК ХозрасчетныйОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеБУОстатки.Счет КАК Счет,
	|	ВТ_ДанныеБУОстатки.Контрагент КАК Контрагент,
	|	ВТ_ДанныеБУОстатки.Договор КАК Договор,
	|	ВТ_ДанныеБУОстатки.Валюта КАК Валюта,
	|	ВТ_ДанныеБУОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
	|	ВТ_ДанныеБУОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ВТ_СчетаПереоценки.СчетУУ КАК СчетУУ
	|ПОМЕСТИТЬ ВТ_ДанныеБУ
	|ИЗ
	|	ВТ_ДанныеБУОстатки КАК ВТ_ДанныеБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СчетаПереоценки КАК ВТ_СчетаПереоценки
	|		ПО ВТ_ДанныеБУОстатки.Счет = ВТ_СчетаПереоценки.СчетБУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетУУ,
	|	Контрагент,
	|	Договор,
	|	Валюта,
	|	ВалютнаяСуммаОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МСФООстатки.Счет КАК Счет,
	|	МСФООстатки.Субконто1 КАК Контрагент,
	|	МСФООстатки.Субконто2 КАК Договор,
	|	МСФООстатки.Валюта КАК Валюта,
	|	МСФООстатки.СуммаВВалютеОстаток КАК ВалютнаяСуммаОстаток,
	|	МСФООстатки.СуммаВВалютеУчетаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ ВТ_ДанныеУУ
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_СчетаПереоценки.СчетУУ КАК СчетУУ
	|				ИЗ
	|					ВТ_СчетаПереоценки КАК ВТ_СчетаПереоценки),
	|			&СубконтоКорпоративные,    
	// НАЧАЛО Юдина Екатерина 14.05.2025 Выполнение задач №000053679   
	|           Организация = &ОрганизацияУУ И
	// КОНЕЦ Юдина Екатерина 14.05.2025 Выполнение задач №000053679   
	|			НЕ Валюта В (&СписокВалют)) КАК МСФООстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	Контрагент,
	|	Договор,
	|	Валюта,
	|	ВалютнаяСуммаОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Счет
	|		ИНАЧЕ ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаУбытка
	|	КОНЕЦ КАК СчетДт,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Контрагент
	|		ИНАЧЕ ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаУбыткаСубконто1
	|	КОНЕЦ КАК СубконтоДт1,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Договор
	|		ИНАЧЕ ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаУбыткаСубконто2
	|	КОНЕЦ КАК СубконтоДт2,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаУбыткаСубконто3
	|	КОНЕЦ КАК СубконтоДт3,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаПрибыли
	|		ИНАЧЕ ВТ_ДанныеУУ.Счет
	|	КОНЕЦ КАК СчетКт,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаПрибылиСубконто1
	|		ИНАЧЕ ВТ_ДанныеУУ.Контрагент
	|	КОНЕЦ КАК СубконтоКт1,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаПрибылиСубконто2
	|		ИНАЧЕ ВТ_ДанныеУУ.Договор
	|	КОНЕЦ КАК СубконтоКт2,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Счет.СчетаУчетаКурсовыхРазниц.СчетУчетаПрибылиСубконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СубконтоКт3,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеУУ.Валюта
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВалютаДт,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВТ_ДанныеУУ.Валюта
	|	КОНЕЦ КАК ВалютаКт,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток > 0
	|			ТОГДА ВТ_ДанныеБУ.СуммаОстаток - ВТ_ДанныеУУ.СуммаОстаток
	|		ИНАЧЕ ВТ_ДанныеУУ.СуммаОстаток - ВТ_ДанныеБУ.СуммаОстаток
	|	КОНЕЦ КАК СуммаВФункциональнойВалюте
	|ИЗ
	|	ВТ_ДанныеБУ КАК ВТ_ДанныеБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДанныеУУ КАК ВТ_ДанныеУУ
	|		ПО ВТ_ДанныеБУ.СчетУУ = ВТ_ДанныеУУ.Счет
	|			И ВТ_ДанныеБУ.Контрагент = ВТ_ДанныеУУ.Контрагент
	|			И ВТ_ДанныеБУ.Договор = ВТ_ДанныеУУ.Договор
	|			И ВТ_ДанныеБУ.Валюта = ВТ_ДанныеУУ.Валюта
	|			И ВТ_ДанныеБУ.ВалютнаяСуммаОстаток = ВТ_ДанныеУУ.ВалютнаяСуммаОстаток
	|			И ВТ_ДанныеБУ.СуммаОстаток <> ВТ_ДанныеУУ.СуммаОстаток";   
	
	Возврат ТекстЗапроса;
	
КонецФункции  

Функция ТекстЗапросаРасчетыСПодотчетнымиЛицами() 
	
	ТекстЗапроса =
	 "ВЫБРАТЬ
	 |	ХозрасчетныйВидыСубконто.Ссылка КАК СчетБУ,
	 |	МАКСИМУМ(ХозрасчетныйВидыСубконто.НомерСтроки) КАК НомерСтроки
	 |ПОМЕСТИТЬ ВТ_СчетаБУСРаботниками
	 |ИЗ
	 |	ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто
	 |ГДЕ
	 |	ВЫБОР
	 |			КОГДА ХозрасчетныйВидыСубконто.НомерСтроки = 1
	 |					И ХозрасчетныйВидыСубконто.ВидСубконто = &ВидСубконтоРаботникиХозр
	 |				ТОГДА ИСТИНА
	 |			ИНАЧЕ ЛОЖЬ
	 |		КОНЕЦ
	 |	И ХозрасчетныйВидыСубконто.Валютный
	 |	И ХозрасчетныйВидыСубконто.Ссылка.ИсключитьСуммуБУИзПереоценкиПоПлануСчетов
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ХозрасчетныйВидыСубконто.Ссылка
	 |
	 |ИМЕЮЩИЕ
	 |	МАКСИМУМ(ХозрасчетныйВидыСубконто.НомерСтроки) = 1
	 |
	 |ИНДЕКСИРОВАТЬ ПО
	 |	СчетБУ
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	МСФОВидыСубконто.Ссылка КАК СчетУУ,
	 |	МАКСИМУМ(МСФОВидыСубконто.НомерСтроки) КАК НомерСтроки,
	 |	МСФОВидыСубконто.Ссылка.СчетаУчетаКурсовыхРазниц КАК СчетаУчетаКурсовыхРазниц
	 |ПОМЕСТИТЬ ВТ_СчетаУУСРаботниками
	 |ИЗ
