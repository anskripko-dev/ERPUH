Процедура УстановитьПараметрыЗапроса(Запрос, Реквизиты)
	
	Запрос.УстановитьПараметр("ВидСубконтоДоговорКорп", ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникДоговораКонтрагентов);
	Запрос.УстановитьПараметр("ВидСубконтоДоговорХозр", ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	Запрос.УстановитьПараметр("ВидСубконтоКонтрагентКорп", ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникКонтрагенты);
	Запрос.УстановитьПараметр("ВидСубконтоКонтрагентХозр", ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты); 
	
	ВидСубконтоКорпРаботники = ВидСубконтоКорпоративныеРаботники();
	Запрос.УстановитьПараметр("ВидСубконтоРаботникиКорп", ВидСубконтоКорпРаботники);
	Запрос.УстановитьПараметр("ВидСубконтоРаботникиХозр", ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.РаботникиОрганизаций);

	СубконтоКорпоративные = Новый Массив;
	СубконтоКорпоративные.Добавить(ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникКонтрагенты);
	СубконтоКорпоративные.Добавить(ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникДоговораКонтрагентов); 
	СубконтоХозрасчетные = Новый Массив;
	СубконтоХозрасчетные.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	СубконтоХозрасчетные.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	Запрос.УстановитьПараметр("СубконтоКорпоративные", СубконтоКорпоративные);
	Запрос.УстановитьПараметр("СубконтоХозрасчетные", СубконтоХозрасчетные);
	
	СписокВалют = Новый Массив;
	СписокВалют.Добавить(Константы.ВалютаРегламентированногоУчета.Получить());
	СписокВалют.Добавить(Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("СписокВалют", СписокВалют); 
	
	Запрос.УстановитьПараметр("Период", Новый Граница(Реквизиты.Дата));  
	
	// НАЧАЛО Юдина Екатерина 14.05.2025 Выполнение задач №000053679    
	Запрос.УстановитьПараметр("ОрганизацияУУ", Реквизиты.Организация); 
	Запрос.УстановитьПараметр("ОрганизацияБУ", Реквизиты.ОрганизацияБУ); 
	// КОНЕЦ Юдина Екатерина 14.05.2025 Выполнение задач №000053679   
	
КонецПроцедуры

Функция ВидСубконтоКорпоративныеРаботники()
	
	ВидСубконтоРаботники = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду("РаботОрган"); 
	Если НЕ ЗначениеЗаполнено(ВидСубконтоРаботники) Тогда
		ВызватьИсключение "Не найден вид субконто (корпоративный) ""Работники организаций""!";
	КонецЕсли;
	
	Возврат ВидСубконтоРаботники;

КонецФункции 

Процедура ЗаполнитьТаблицуРазниц(Выборка, Реквизиты, ТаблицаРазниц)
	
	Пока Выборка.Следующий() Цикл
		СтрокаРазницы = ТаблицаРазниц.Добавить(); 
		ЗаполнитьЗначенияСвойств(СтрокаРазницы, Выборка);
		СтрокаРазницы.ВидОперации = Реквизиты.ВидОперации; 
		СтрокаРазницы.Период = Реквизиты.Дата;
	КонецЦикла;

КонецПроцедуры