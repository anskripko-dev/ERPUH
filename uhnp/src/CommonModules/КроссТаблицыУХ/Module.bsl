КонецФункции

Процедура ОбновитьКолонкиРесурсыПериоды(ОписаниеКТ, АктивныеПериоды, ДобавляемыеРеквизиты, УдаляемыеРеквизиты, СуществующиеРеквизиты, СуществующиеРеквизитыТаблицы)
	
	ИмяРеквизитаКроссТаблицы = ОписаниеКТ.Реквизиты.КроссТаблица;
	Поля = ОписаниеКТ.Схема.Поля;
	
	Для каждого ОписаниеПоля Из Поля Цикл
		
		СтруктураПоля = ОписаниеПоля.Значение;
		
		Если СтруктураПоля.Свойство("СоздаватьРеквизит") Тогда
			СоздаватьРеквизит = СтруктураПоля.СоздаватьРеквизит;
		Иначе
			СоздаватьРеквизит = Истина;
		КонецЕсли;
		
		Если НЕ СоздаватьРеквизит Тогда
			Продолжить;
		КонецЕсли;
		
		ПрефиксРеквизитаКолонки = СтруктураПоля.ПрефиксРеквизитаКолонки;
		Если СтруктураПоля.Свойство("УдалятьРеквизитыТаблицы") Тогда
			УдалятьРеквизитыТаблицы = СтруктураПоля.УдалятьРеквизитыТаблицы;
		Иначе
			УдалятьРеквизитыТаблицы = Ложь;
		КонецЕсли;
		Если СтруктураПоля.Свойство("ТипЭлемента") Тогда
			ТипЭлемента = СтруктураПоля.ТипЭлемента;
		Иначе
			ТипЭлемента = "Число";
		КонецЕсли;
		Если СтруктураПоля.Свойство("СоздаватьИтоговыеРеквизиты") Тогда
			СоздаватьИтоговыеРеквизиты = СтруктураПоля.СоздаватьИтоговыеРеквизиты;
		Иначе
			СоздаватьИтоговыеРеквизиты = Ложь;
		КонецЕсли;
		Если СтруктураПоля.Свойство("РасширенныйФорматЧислаДаты") Тогда
			РасширенныйФорматЧислаДаты = СтруктураПоля.РасширенныйФорматЧислаДаты;
		Иначе
			РасширенныйФорматЧислаДаты = Ложь;
		КонецЕсли;
				
		Если СоздаватьИтоговыеРеквизиты И ТипЭлемента <> "Число" И ТипЗнч(ТипЭлемента) <> Тип("ОписаниеТипов") Тогда
			СоздаватьИтоговыеРеквизиты = Ложь;
		КонецЕсли;
		
		Если ТипЗнч(ТипЭлемента) = Тип("ОписаниеТипов") Тогда
			ОписаниеТипов = ТипЭлемента;
		ИначеЕсли ТипЭлемента = "Булево" Тогда
			ОписаниеТипов = Новый ОписаниеТипов("Булево");
		ИначеЕсли ТипЭлемента = "Дата" Тогда
			
			Если РасширенныйФорматЧислаДаты Тогда
				ОписаниеТипов = ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя);
			Иначе
				ОписаниеТипов = ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата);
			КонецЕсли;
		Иначе
			
			Если РасширенныйФорматЧислаДаты Тогда
				ОписаниеТипов = ОбщегоНазначения.ОписаниеТипаЧисло(15, 5);
			Иначе
				ОписаниеТипов = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3); 
			КонецЕсли; 
			
		КонецЕсли;
		
		// Удаление реквизитов
		Если УдалятьРеквизитыТаблицы Тогда
			Для Каждого КлючЗначение Из СуществующиеРеквизитыТаблицы Цикл
				Если СтрНайти(КлючЗначение.Значение.Имя, ПрефиксРеквизитаКолонки) Тогда
					УдаляемыеРеквизиты.Добавить(ИмяРеквизитаКроссТаблицы + "." + КлючЗначение.Значение.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Создание реквизитов  таблицы
		Для каждого СтрокаПериода Из АктивныеПериоды Цикл
			
			ИмяИскомогоРеквизита = ПрефиксРеквизитаКолонки + СтрокаПериода.ИмяКолонки;
			Если СуществующиеРеквизитыТаблицы[ИмяИскомогоРеквизита] = Неопределено Тогда
				Реквизит = Новый РеквизитФормы(ИмяИскомогоРеквизита, ОписаниеТипов, ИмяРеквизитаКроссТаблицы, СтрокаПериода.Заголовок);
				ДобавляемыеРеквизиты.Добавить(Реквизит);
			КонецЕсли; 
			
		КонецЦикла;
		
		// Создаем итоговые реквизиты 
		Если СоздаватьИтоговыеРеквизиты Тогда
			
			ПрефиксРеквизита = СтрШаблон(НСтр("ru='Итого %1'"), СтруктураПоля.СвойстваЭлемента.Заголовок);
			
			Для каждого СтрокаПериода Из АктивныеПериоды Цикл
				
				ИмяИскомогоРеквизита = СтрЗаменить(ИмяРеквизитаКроссТаблицы + ПрефиксРеквизитаКолонки + СтрокаПериода.ИмяКолонки, ".", "_");
				Если СуществующиеРеквизиты[ИмяИскомогоРеквизита] = Неопределено Тогда
				
					Реквизит = Новый РеквизитФормы(ИмяИскомогоРеквизита, ОписаниеТипов, , ПрефиксРеквизита + " " + СтрокаПериода.Заголовок);
					ДобавляемыеРеквизиты.Добавить(Реквизит);
				
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДвиженияОперации(ОписаниеКТ, Периоды, Данные)

	АктивныеПериоды = Периоды.НайтиСтроки(Новый Структура("Активная", Истина));   
	
	ПараметрыИтераций = ОпределитьПараметрыИтераций(АктивныеПериоды);
	
	ИтоговаяТаблицаДвижений = Неопределено;  
	Для Итерация = 1 По ПараметрыИтераций.КоличествоИтераций Цикл  	
		
		ТекущиеАктивныеПериоды = ЗаполнитьТекущиеАктивныеПериоды(АктивныеПериоды, ПараметрыИтераций, Итерация);
		
		ТаблицаДанных = ПолучитьДвиженияОперацииАктивныеПериоды(ОписаниеКТ, ТекущиеАктивныеПериоды, Данные);	
		
		Если Итерация = 1 Тогда
			ИтоговаяТаблицаДвижений = ТаблицаДанных;
		Иначе
			ЗаполнитьТаблицуДвижений(ТекущиеАктивныеПериоды, ТаблицаДанных, ИтоговаяТаблицаДвижений, ОписаниеКТ, "НомерСтрокиДляСортировки"); 	    		
		КонецЕсли;     
		
	КонецЦикла;   
	
	Возврат ИтоговаяТаблицаДвижений;    
   		
КонецФункции

Функция ПолучитьДвиженияОперацииАктивныеПериоды(ОписаниеКТ, АктивныеПериоды, Данные)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		
		ВременныйДокумент = Документы.ОперативныйПлан.СоздатьДокумент();
		ВременныйДокумент.ДвиженияОперации.Загрузить(Данные);
		ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(
			Запрос, "ВТ_ДвиженияОперации", ВременныйДокумент.ДвиженияОперации.Выгрузить());
	Иначе
		Запрос.УстановитьПараметр("Ссылка", Данные);
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
		|	ДанныеДокумента.Номенклатура КАК Номенклатура,
		|	ДанныеДокумента.Характеристика КАК Характеристика,
		|	ДанныеДокумента.Цена КАК Цена,
		|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ДанныеДокумента.Коэффициент КАК Коэффициент,
		|	ДанныеДокумента.СтатьяБюджета КАК СтатьяБюджета,
		|	ДанныеДокумента.Аналитика1 КАК Аналитика1,
		|	ДанныеДокумента.Аналитика2 КАК Аналитика2,
		|	ДанныеДокумента.Аналитика3 КАК Аналитика3,
		|	ДанныеДокумента.Аналитика4 КАК Аналитика4,
		|	ДанныеДокумента.Аналитика5 КАК Аналитика5,
		|	ДанныеДокумента.Аналитика6 КАК Аналитика6,
		|	ДанныеДокумента.МестоПоставки КАК МестоПоставки,
		|	ДанныеДокумента.Валюта КАК Валюта,
		|	ДанныеДокумента.ПриходРасход КАК ПриходРасход,
		|	ДанныеДокумента.Контрагент КАК Контрагент,
		|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ДанныеДокумента.ЦФО КАК ЦФО,
		|	ДанныеДокумента.Проект КАК Проект,
		|	ДанныеДокумента.Организация КАК Организация,
		|	ДанныеДокумента.ИсходнаяНоменклатура КАК ИсходнаяНоменклатура,
		|	ДанныеДокумента.Менеджер КАК Менеджер,
		|	ДанныеДокумента.Приоритет КАК Приоритет,
		|	ДанныеДокумента.СуммаИсходное КАК СуммаИсходное,
		|	ДанныеДокумента.СуммаИзменение КАК СуммаИзменение,
		|	ДанныеДокумента.Сумма КАК Сумма,
		|	ДанныеДокумента.КоличествоИсходное КАК КоличествоИсходное,
		|	ДанныеДокумента.КоличествоИзменение КАК КоличествоИзменение,
		|	ДанныеДокумента.Количество КАК Количество,
		|	ДанныеДокумента.Период КАК Период
		|ПОМЕСТИТЬ ВТ_ДвиженияОперации
		|ИЗ
		|	Документ.ОперативныйПлан.ДвиженияОперации КАК ДанныеДокумента
		|ГДЕ
		|	ДанныеДокумента.Ссылка = &Ссылка";
		
		Если ТипЗнч(Данные) = Тип("ДокументСсылка.Резервирование") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ОперативныйПлан.ДвиженияОперации", "Документ.Резервирование.ДвиженияОперации");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеДокумента.ИсходнаяНоменклатура", "Неопределено");
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.Выполнить();
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.Характеристика КАК Характеристика,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Коэффициент КАК Коэффициент,
	|	ДанныеДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ДанныеДокумента.Аналитика1 КАК Аналитика1,
	|	ДанныеДокумента.Аналитика2 КАК Аналитика2,
	|	ДанныеДокумента.Аналитика3 КАК Аналитика3,
	|	ДанныеДокумента.Аналитика4 КАК Аналитика4,
	|	ДанныеДокумента.Аналитика5 КАК Аналитика5,
	|	ДанныеДокумента.Аналитика6 КАК Аналитика6,
	|	ДанныеДокумента.МестоПоставки КАК МестоПоставки,
	|	ДанныеДокумента.Валюта КАК Валюта,
	|	ДанныеДокумента.ПриходРасход КАК ПриходРасход,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДанныеДокумента.ЦФО КАК ЦФО,
	|	ДанныеДокумента.Проект КАК Проект,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.ИсходнаяНоменклатура КАК ИсходнаяНоменклатура,
	|	ДанныеДокумента.Менеджер КАК Менеджер,
	|	ДанныеДокумента.Приоритет КАК Приоритет,
	|	МИНИМУМ(ДанныеДокумента.НомерСтроки) КАК НомерСтрокиДляСортировки,
	|	&ОперативныйПланДвиженияОперации
	|ПОМЕСТИТЬ ВТ_КроссТаблица
	|ИЗ
	|	ВТ_ДвиженияОперации КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.СуммаИсходное <> 0
	|		ИЛИ ДанныеДокумента.СуммаИзменение <> 0
	|		ИЛИ ДанныеДокумента.КоличествоИсходное <> 0
	|		ИЛИ ДанныеДокумента.КоличествоИзменение <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Аналитика6,
	|	ДанныеДокумента.Номенклатура,
	|	ДанныеДокумента.Аналитика1,
	|	ДанныеДокумента.ЕдиницаИзмерения,
	|	ДанныеДокумента.Аналитика3,
	|	ДанныеДокумента.Аналитика5,
	|	ДанныеДокумента.МестоПоставки,
	|	ДанныеДокумента.Валюта,
	|	ДанныеДокумента.ПриходРасход,
	|	ДанныеДокумента.Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента,
	|	ДанныеДокумента.ЦФО,
	|	ДанныеДокумента.Проект,
	|	ДанныеДокумента.Организация,
	|	ДанныеДокумента.ИсходнаяНоменклатура,
	|	ДанныеДокумента.Коэффициент,
	|	ДанныеДокумента.СтатьяБюджета,
	|	ДанныеДокумента.Аналитика2,
	|	ДанныеДокумента.Характеристика,
	|	ДанныеДокумента.Аналитика4,
	|	ДанныеДокумента.Приоритет,
	|	ДанныеДокумента.Менеджер,
	|	ДанныеДокумента.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КроссТаблица.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ВТ_КроссТаблица.Номенклатура ССЫЛКА Справочник.ТоварныеКатегории
	|			ТОГДА ЛОЖЬ
	|		КОГДА ВЫРАЗИТЬ(ВТ_КроссТаблица.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик В (ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать), ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ПустаяСсылка))
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ХарактеристикиИспользуются,
	|	ВТ_КроссТаблица.Характеристика КАК Характеристика,
	|	ВТ_КроссТаблица.Цена КАК Цена,
	|	ВТ_КроссТаблица.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_КроссТаблица.Коэффициент КАК Коэффициент,
	|	ВТ_КроссТаблица.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_КроссТаблица.Аналитика1 КАК Аналитика1,
	|	ВТ_КроссТаблица.Аналитика2 КАК Аналитика2,
	|	ВТ_КроссТаблица.Аналитика3 КАК Аналитика3,
	|	ВТ_КроссТаблица.Аналитика4 КАК Аналитика4,
	|	ВТ_КроссТаблица.Аналитика5 КАК Аналитика5,
	|	ВТ_КроссТаблица.Аналитика6 КАК Аналитика6,
	|	ВТ_КроссТаблица.МестоПоставки КАК МестоПоставки,
	|	ВТ_КроссТаблица.Валюта КАК Валюта,
	|	ВТ_КроссТаблица.ПриходРасход КАК ПриходРасход,
	|	ВТ_КроссТаблица.Контрагент КАК Контрагент,
	|	ВТ_КроссТаблица.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВТ_КроссТаблица.ЦФО КАК ЦФО,
	|	ВТ_КроссТаблица.Проект КАК Проект,
	|	ВТ_КроссТаблица.Организация КАК Организация,
	|	ВТ_КроссТаблица.ИсходнаяНоменклатура КАК ИсходнаяНоменклатура,
	|	ВТ_КроссТаблица.Менеджер КАК Менеджер,
	|	ВТ_КроссТаблица.Приоритет КАК Приоритет,
	|	ВТ_КроссТаблица.НомерСтрокиДляСортировки КАК НомерСтрокиДляСортировки,
	|	&ВТ_КроссТаблица
	|ИЗ
	|	ВТ_КроссТаблица КАК ВТ_КроссТаблица
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиДляСортировки";
	
	// Дополняем поля
	ШаблонОперативныйПланДвиженияОперации = 	
	"СУММА(ВЫБОР
	|		КОГДА ДанныеДокумента.Период = &%1
	|			ТОГДА %2ДанныеДокумента.%3
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК %4";
	ШаблонВТ_КроссТаблица = "ВТ_КроссТаблица.%1 КАК %1";
	ШаблонВТ_КроссТаблицаИтог = "ВТ_КроссТаблица.%1";
	
	ПоляОперативныйПланДвиженияОперации = Новый Массив;
	ПоляВТ_КроссТаблица 				= Новый Массив; 
	ПоляИтог							= Новый Соответствие;
	
	Для Каждого КлючИЗначение Из ОписаниеКТ.Схема.Итоги Цикл
		ПоляИтог.Вставить(КлючИЗначение.Ключ, Новый Массив);
	КонецЦикла;
	
	Для Каждого АктивныйПериод Из АктивныеПериоды Цикл
		
		ИдентификаторСтроки = Формат(АктивныйПериод.ПолучитьИдентификатор(), "ЧГ=0");
		ИмяПериода = СтрШаблон("Период%1", ИдентификаторСтроки); 
		
		Запрос.УстановитьПараметр(ИмяПериода, АктивныйПериод.Период);

		Для Каждого ОписаниеПоля Из ОписаниеКТ.Схема.Поля Цикл  
			
			ЗначениеОписанияПоля = ОписаниеПоля.Значение;
			ИмяПоляВыборки = ЗначениеОписанияПоля.ПрефиксРеквизитаКолонки + АктивныйПериод.ИмяКолонки;
			// Изменение при переносе между резервами отображается как +, а хранится как -
			Если ОписаниеКТ.Схема.ЭтоПереносМеждуДокументамиРезервирования
				И ЗначениеОписанияПоля.ИмяПоказателя = ОписаниеКТ.Схема.Показатели.Изменение.Имя Тогда
				ЗначениеТЧ = "-";
			Иначе
				ЗначениеТЧ = "";
			КонецЕсли;
			
			ПолеДвижения = СтрШаблон(ШаблонОперативныйПланДвиженияОперации, 
										ИмяПериода,
										ЗначениеТЧ,
										ОписаниеПоля.Значение.ИмяРеквизитаТЧ,
										ИмяПоляВыборки);
								
			ПоляОперативныйПланДвиженияОперации.Добавить(ПолеДвижения);
			ПоляВТ_КроссТаблица.Добавить(СтрШаблон(ШаблонВТ_КроссТаблица, ИмяПоляВыборки));
			
			КоллекцияПолейИтога = ПоляИтог.Получить(ОписаниеПоля.Значение.ИмяРеквизитаТЧ);
			Если КоллекцияПолейИтога <> Неопределено Тогда
				КоллекцияПолейИтога.Добавить(ИмяПоляВыборки);
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	ПоляОперативныйПланДвиженияОперацииСтрокой = СтрСоединить(ПоляОперативныйПланДвиженияОперации, ", " + Символы.ПС + Символы.Таб);
	ПоляВТ_КроссТаблицаСтрокой = СтрСоединить(ПоляВТ_КроссТаблица, ", " + Символы.ПС + Символы.Таб);
	
	Для Каждого КлючИЗначение Из ПоляИтог Цикл
		ПоляСумма = СтрСоединить(КлючИЗначение.Значение, " + "); 
		Если ПоляСумма = "" Тогда 
			ПолеИтогСтрокой = "0 КАК " + КлючИЗначение.Ключ;  			
		Иначе
			ПолеИтогСтрокой = ПоляСумма + " КАК " + КлючИЗначение.Ключ;  
		КонецЕсли;
		
		Если ПоляВТ_КроссТаблицаСтрокой = "" Тогда 
			ПоляВТ_КроссТаблицаСтрокой = ПолеИтогСтрокой;
		Иначе
			ПоляВТ_КроссТаблицаСтрокой = ПоляВТ_КроссТаблицаСтрокой + ", " + Символы.ПС + Символы.Таб + ПолеИтогСтрокой;			
		КонецЕсли;	
	КонецЦикла;
	
	Если ПоляОперативныйПланДвиженияОперацииСтрокой = "" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперативныйПланДвиженияОперации", "Истина ");
	Иначе	
	    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперативныйПланДвиженияОперации", ПоляОперативныйПланДвиженияОперацииСтрокой);
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВТ_КроссТаблица",                 ПоляВТ_КроссТаблицаСтрокой);	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();   
	
КонецФункции  

Процедура ЗаполнитьТаблицуДвижений(ТекущиеАктивныеПериоды, ТаблицаДанных, ИтоговаяТаблицаДвижений, ОписаниеКТ, Ключ)    
	
	СписокКолонок = Новый Массив;
	Для Каждого АктивныйПериод Из ТекущиеАктивныеПериоды Цикл
		Для Каждого ОписаниеПоля Из ОписаниеКТ.Схема.Поля Цикл
			
			ИмяКолонки = ОписаниеПоля.Значение.ПрефиксРеквизитаКолонки + АктивныйПериод.ИмяКолонки;	 
			СписокКолонок.Добавить(ИмяКолонки);	
			
			Если ИтоговаяТаблицаДвижений.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
				ИтоговаяТаблицаДвижений.Колонки.Добавить(ИмяКолонки, ОписаниеПоля.Значение.ТипЭлемента);	
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла; 
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл
		
		СтрокаТаблицыДвижений = ИтоговаяТаблицаДвижений.Найти(СтрокаТаблицыДанных[Ключ], Ключ);	
		
		СписокСвойств = СтрСоединить(СписокКолонок, ",");
		Если Не СтрокаТаблицыДвижений = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДвижений, СтрокаТаблицыДанных, СписокСвойств);	  
			СтрокаТаблицыДвижений.Сумма = СтрокаТаблицыДвижений.Сумма + СтрокаТаблицыДанных.Сумма;
		КонецЕсли;
		
	КонецЦикла;   		
	
КонецПроцедуры 

Функция ПолучитьДвиженияОперацииПоТаблицеЗначений(ОписаниеКТ, Периоды, Данные)
	
	АктивныеПериоды = Периоды.НайтиСтроки(Новый Структура("Активная", Истина)); 
	
	ПараметрыИтераций = ОпределитьПараметрыИтераций(АктивныеПериоды);
	
	ИтоговаяТаблицаДвижений = Неопределено;  
	Для Итерация = 1 По ПараметрыИтераций.КоличествоИтераций Цикл  	
		
		ТекущиеАктивныеПериоды = ЗаполнитьТекущиеАктивныеПериоды(АктивныеПериоды, ПараметрыИтераций, Итерация);
		
		ТаблицаДанных = ПолучитьДвиженияОперацииПоТаблицеЗначенийАктивныеПериоды(ОписаниеКТ, ТекущиеАктивныеПериоды, Данные);	
		
		Если Итерация = 1 Тогда
			ИтоговаяТаблицаДвижений = ТаблицаДанных;
		Иначе
			ЗаполнитьТаблицуДвижений(ТекущиеАктивныеПериоды, ТаблицаДанных, ИтоговаяТаблицаДвижений, ОписаниеКТ, "СтатьяБюджета"); 	    		
		КонецЕсли;     
		
	КонецЦикла;   
	
	Возврат ИтоговаяТаблицаДвижений;
	
КонецФункции

Функция ПолучитьДвиженияОперацииПоТаблицеЗначенийАктивныеПериоды(ОписаниеКТ, АктивныеПериоды, Данные)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Данные", Данные);
	
	// Собираем запрос динамическии, так как не всегда в данных есть ресурс количество.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	&ПоляОсновнойТаблицы
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	&Данные КАК ОперативныйПланДвиженияОперации
		|ГДЕ
		|	&УсловияОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&ОперативныйПланДвиженияОперации
		|ПОМЕСТИТЬ ВТ_КроссТаблица
		|ИЗ
		|	Таблица КАК ОперативныйПланДвиженияОперации
		|ГДЕ
		|	&УсловияОтбора
		|СГРУППИРОВАТЬ ПО
		|	&ПоляГруппировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&ВТ_КроссТаблица
		|ИЗ
		|	ВТ_КроссТаблица КАК ВТ_КроссТаблица";
	
	// Доплняем поля
	ШаблонОперативныйПланДвиженияОперации = 
		"СУММА(ВЫБОР
		|		КОГДА ОперативныйПланДвиженияОперации.Период = &%2
		|			ТОГДА ОперативныйПланДвиженияОперации.%3
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК %1";
	ШаблонОперативныйПланДвиженияОперацииОсновныеПоля = "ОперативныйПланДвиженияОперации.%1 КАК %1";
	ШаблонОперативныйПланДвиженияОперацииУсловия      = "ОперативныйПланДвиженияОперации.%1 <> 0";
	ШаблонВТ_КроссТаблица                             = "ВТ_КроссТаблица.%1 КАК %1";   
	ШаблонВТ_КроссТаблицаИтог                         = "ВТ_КроссТаблица.%1";
	
	ПоляОтбора                          = Новый Массив;
	ПоляГруппировки                     = Новый Массив;
	ПоляТаблицыДанных                   = Новый Массив;
	ПоляОперативныйПланДвиженияОперации = Новый Массив;
	ПоляВТ_КроссТаблица                 = Новый Массив; 
	ПоляИтог                            = Новый Соответствие;
	ПоляТолькоВТаблицеДанных            = Новый Массив;
	
	Для Каждого Поле Из ОписаниеКТ.Схема.Поля Цикл
		
		ОписаниеПоля = Поле.Значение;
		
		ПоляТолькоВТаблицеДанных.Добавить(ОписаниеПоля.ИмяРеквизитаТЧ);
		
		Если ОписаниеПоля.ИмяПоказателя = "Изменение" Или ОписаниеПоля.ИмяПоказателя = "Исходное" Тогда
			ПоляОтбора.Добавить(
				Строковыефункцииклиентсервер.ПодставитьПараметрыВСтроку(ШаблонОперативныйПланДвиженияОперацииУсловия, ОписаниеПоля.ИмяРеквизитаТЧ));
		КонецЕсли;
		
	КонецЦикла;
	
	ПоляТолькоВТаблицеДанных.Добавить("Период"); 
	ПоляТолькоВТаблицеДанных.Добавить("КоличествоОборот");
	ПоляТолькоВТаблицеДанных.Добавить("СуммаОборот");


	Для Каждого Колонка Из Данные.Колонки Цикл  
					
      	
		ПоляТаблицыДанных.Добавить(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОперативныйПланДвиженияОперацииОсновныеПоля, Колонка.Имя));
			
		Если ПоляТолькоВТаблицеДанных.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляОперативныйПланДвиженияОперации.Добавить(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОперативныйПланДвиженияОперацииОсновныеПоля, Колонка.Имя));
			
		ПоляВТ_КроссТаблица.Добавить(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВТ_КроссТаблица, Колонка.Имя));
			
		ПоляГруппировки.Добавить("ОперативныйПланДвиженияОперации." + Колонка.Имя);
		
	КонецЦикла;
	
	ПоляОсновнойТаблицыСтрокой = СтрСоединить(ПоляТаблицыДанных, ", " + Символы.ПС + Символы.Таб);
	Запрос.Текст               = СтрЗаменить(Запрос.Текст, "&ПоляОсновнойТаблицы", ПоляОсновнойТаблицыСтрокой);
	
	ПоляОтбораСтрокой = СтрСоединить(ПоляОтбора, Символы.ПС + " ИЛИ " + Символы.Таб);
	Запрос.Текст      = СтрЗаменить(Запрос.Текст, "&УсловияОтбора", ПоляОтбораСтрокой);
	
	Для Каждого КлючИЗначение Из ОписаниеКТ.Схема.Итоги Цикл
		ПоляИтог.Вставить(КлючИЗначение.Ключ, Новый Массив);
	КонецЦикла;
	
	ИскатьПериодыПоДате = Данные.Колонки.Период.ТипЗначения.СодержитТип(Тип("Дата"));
	Для Каждого АктивныйПериод Из АктивныеПериоды Цикл
		
		ИдентификаторСтроки = Формат(АктивныйПериод.ПолучитьИдентификатор(), "ЧГ=0");
		ИмяПериода = СтрШаблон("Период%1", ИдентификаторСтроки);    
		
		Если ИскатьПериодыПоДате Тогда
			Запрос.УстановитьПараметр(ИмяПериода, АктивныйПериод.ДатаНачала);
		Иначе
			Запрос.УстановитьПараметр(ИмяПериода, АктивныйПериод.Период);
		КонецЕсли;
		
		Для Каждого ОписаниеПоля Из ОписаниеКТ.Схема.Поля Цикл  
			
			ИмяПоляВыборки = ОписаниеПоля.Значение.ПрефиксРеквизитаКолонки + АктивныйПериод.ИмяКолонки;
			
			ПолеДвижения = СтрШаблон(ШаблонОперативныйПланДвиженияОперации, 
										ИмяПоляВыборки, 
										ИмяПериода, 
										ОписаниеПоля.Значение.ИмяРеквизитаТЧ);
								
			ПоляОперативныйПланДвиженияОперации.Добавить(ПолеДвижения);
			ПоляВТ_КроссТаблица.Добавить(СтрШаблон(ШаблонВТ_КроссТаблица, ИмяПоляВыборки));
			
			КоллекцияПолейИтога = ПоляИтог.Получить(ОписаниеПоля.Значение.ИмяРеквизитаТЧ);
			Если КоллекцияПолейИтога <> Неопределено Тогда
				КоллекцияПолейИтога.Добавить(ИмяПоляВыборки);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПоляОперативныйПланДвиженияОперацииСтрокой = СтрСоединить(ПоляОперативныйПланДвиженияОперации, ", " + Символы.ПС + Символы.Таб);
	ПоляВТ_КроссТаблицаСтрокой = СтрСоединить(ПоляВТ_КроссТаблица, ", " + Символы.ПС + Символы.Таб);
	
	ПоляГруппировкиСтрокой = СтрСоединить(ПоляГруппировки, ", " + Символы.ПС + Символы.Таб);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляГруппировки", ПоляГруппировкиСтрокой);
	
	Для Каждого КлючИЗначение Из ПоляИтог Цикл
		ПоляСумма = СтрСоединить(КлючИЗначение.Значение, " + ");
		ПолеИтогСтрокой = ПоляСумма + " КАК " + КлючИЗначение.Ключ;
		ПоляВТ_КроссТаблицаСтрокой = ПоляВТ_КроссТаблицаСтрокой + ", " + Символы.ПС + Символы.Таб + ПолеИтогСтрокой;
	КонецЦикла;

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОперативныйПланДвиженияОперации", ПоляОперативныйПланДвиженияОперацииСтрокой);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВТ_КроссТаблица",                 ПоляВТ_КроссТаблицаСтрокой);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТаблицаПлановИзКроссТаблицы(ПараметрыЗаполнения, Реквизиты = "") Экспорт
	
	ТаблицаПериоды = ПараметрыЗаполнения.Периоды;
	АктивныеПериоды = ТаблицаПериоды.НайтиСтроки(Новый Структура("Активная", Истина));  
		
	ПараметрыИтераций = ОпределитьПараметрыИтераций(АктивныеПериоды);
	
	ИтоговаяТаблицаДвижений = Неопределено;  
	Для Итерация = 1 По ПараметрыИтераций.КоличествоИтераций Цикл  		

		ТекущиеАктивныеПериоды = ЗаполнитьТекущиеАктивныеПериоды(АктивныеПериоды, ПараметрыИтераций, Итерация);
		
		МенеджерВременныхТаблиц = ТаблицаПлановИзКроссТаблицыАктивныеПериоды(ПараметрыЗаполнения, ТекущиеАктивныеПериоды, Реквизиты);	  
		
		ТаблицаДанных = МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ДвиженияОперации").ПолучитьДанные().Выгрузить();
	
		Если Итерация = 1 Тогда
			ИтоговаяТаблицаДвижений = ТаблицаДанных;
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаДанных, ИтоговаяТаблицаДвижений);
		КонецЕсли;     
		
	КонецЦикла;   
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ДвиженияОперации", ИтоговаяТаблицаДвижений); 
	
	Возврат Запрос.МенеджерВременныхТаблиц;                 
	
КонецФункции

Функция ТаблицаПлановИзКроссТаблицыАктивныеПериоды(ПараметрыЗаполнения, АктивныеПериоды, Реквизиты)
	
	ОписаниеКТ     = ПараметрыЗаполнения.ОписаниеКТ;
	Расшифровка    = ПараметрыЗаполнения.Расшифровка;
	КроссТаблица   = ПараметрыЗаполнения.КроссТаблица;
	Объект         = ПараметрыЗаполнения.Объект;
	Аналитики      = ОписаниеКТ.Схема.Аналитики;
	
	КолонкиДляВыгрузки  = Новый Массив;
	СписокРеквизитов    = Новый Массив;
	ТолькоВыбранныеПоля = Ложь;
	Если Не ПустаяСтрока(Реквизиты) Тогда
		СписокРеквизитов = СтрРазделить(СтрЗаменить(Реквизиты, " ", ""), ",", Ложь);
		ТолькоВыбранныеПоля = Истина;
	КонецЕсли;
	
	ПоляШапкиДляЗаполнения = ОписаниеКТ.Схема.Аналитики.Шапка;
	
	ЕстьВалютаВШапке = КроссТаблицыУХКлиентСервер.ЕстьАналитикаШапки(ОписаниеКТ, "Валюта");
	Если ЕстьВалютаВШапке Тогда
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, "Валюта,", "");
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, ",Валюта", "");
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, ",Валюта,", "");
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, "Валюта", ""); // Если она одна в шапке
	КонецЕсли; 
	
	ВалютаДокумента = Объект.ВалютаДокумента;
	
	ДанныеШапки = Новый Структура(ПоляШапкиДляЗаполнения);
	ЗаполнитьЗначенияСвойств(ДанныеШапки, Объект, ПоляШапкиДляЗаполнения); 
	
	// Если тип составной и значение не заполнено, то падает при загрузке таблицы во временную таблицу, т.к. тип не определен
	РеквизитыОбъекта = Объект.Ссылка.Метаданные().Реквизиты;
	Для Каждого ЗначениеШапки Из ДанныеШапки Цикл  	
		
		Если Не ЗначениеШапки.Значение = Неопределено Тогда  
			Продолжить;
		КонецЕсли;
		
		ОписаниеМетаданные = РеквизитыОбъекта.Найти(ЗначениеШапки.Ключ);  		
		Если Не ОписаниеМетаданные = Неопределено Тогда
			
			Типы = ОписаниеМетаданные.Тип.Типы();   
			
			Если Не Типы.Количество() = 0 Тогда
                ДанныеШапки.Вставить(ЗначениеШапки.Ключ, ОбщегоНазначенияУХ.ПустоеЗначениеТипа(Типы[0]));     
			КонецЕсли;
			
		КонецЕсли; 	
		
	КонецЦикла;
	
	ДанныеНеИспользуется = Новый Структура(ОписаниеКТ.Схема.Аналитики.НеИспользуется);
	
	// Доп.реквизиты Номенклатуры               
	ИмяРеквизита = "Номенклатура";
	ЕстьНоменклатура 				= ОписаниеКТ.Схема.СтруктураАналитик.Свойство(ИмяРеквизита);
	НоменклатураВШапке              = ОписаниеКТ.Схема.Аналитики.мШапка.Найти(ИмяРеквизита) <> Неопределено;
	НоменклатураВСтроке             = ОписаниеКТ.Схема.Аналитики.мСтрока.Найти(ИмяРеквизита) <> Неопределено;
	НоменклатураВРасшифровке        = ОписаниеКТ.Схема.Аналитики.мРасшифровка.Найти(ИмяРеквизита) <> Неопределено;
	СписокДопРеквизитовНоменклатуры = ОписаниеКТ.Схема.ДопРеквизитыНоменклатуры;
	ДопРеквизитыНоменклатурыВШапке  = Новый Структура(СписокДопРеквизитовНоменклатуры);
	ЗаполнитьЗначенияСвойств(ДопРеквизитыНоменклатурыВШапке, Объект, СписокДопРеквизитовНоменклатуры);
	
	Параметры = Новый Структура;
	Параметры.Вставить("НоменклатураВШапке", 				НоменклатураВШапке);
	Параметры.Вставить("НоменклатураВСтроке", 				НоменклатураВСтроке);
	Параметры.Вставить("НоменклатураВРасшифровке", 			НоменклатураВРасшифровке);
	Параметры.Вставить("СписокДопРеквизитовНоменклатуры",	СписокДопРеквизитовНоменклатуры);
	Параметры.Вставить("ДопРеквизитыНоменклатурыВШапке",	ДопРеквизитыНоменклатурыВШапке);
	Параметры.Вставить("ДанныеНеИспользуется", 				ДанныеНеИспользуется);
	Параметры.Вставить("ВалютаДокумента", 					ВалютаДокумента);
	Параметры.Вставить("ЕстьВалютаВШапке",					ЕстьВалютаВШапке);
	Параметры.Вставить("ПоляШапкиДляЗаполнения",			ПоляШапкиДляЗаполнения);
	
	Запрос = Новый Запрос;
	ШаблонПоляДО = "ВТ_ДвиженияОперации.%1 КАК %1";
	ШаблонПоляКТ = "КроссТаблица.%1 КАК %2";
	ШаблонПараметраКТ = "%1 КАК %2";
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СчПериодов = 0;
	
	ТекстыЗапросов = Новый Массив;
	ТЗКроссТаблица = КроссТаблица.Выгрузить();
	Для Каждого СтрокаПериод Из АктивныеПериоды Цикл
		
		ПоляДляЗапросаКТ = Новый Массив;
		
		Если ОписаниеКТ.ЕстьРасшифровка Тогда
			ИДПериода = Новый УникальныйИдентификатор(СтрЗаменить(СтрокаПериод.ИмяКолонки, "_", "-")); 
			Запрос.УстановитьПараметр("ИДПериода" + Строка(СчПериодов), ИДПериода);
		КонецЕсли;
		
		ШаблонЗапроса = ШаблонТекстаЗапроса(Строка(СчПериодов), ОписаниеКТ.ЕстьРасшифровка);
		
		Если ТекстыЗапросов.Количество() > 0 Тогда
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "ПОМЕСТИТЬ ВТ_ДвиженияОперации", "");
		КонецЕсли;
		
		Для Каждого Реквизит Из Аналитики.мСтрока Цикл
			
			Если КолонкиДляВыгрузки.Найти(Реквизит) = Неопределено Тогда
				КолонкиДляВыгрузки.Добавить(Реквизит);
			КонецЕсли;
			
			Если ТолькоВыбранныеПоля И СписокРеквизитов.Найти(Реквизит) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПоляДляЗапросаКТ.Добавить(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, Реквизит, Реквизит));
			
		КонецЦикла;
		
		Для Каждого Параметр Из Аналитики.мШапка Цикл
			
			Если ТолькоВыбранныеПоля И СписокРеквизитов.Найти(Параметр) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Параметр = "Валюта" Тогда
				Запрос.УстановитьПараметр("Валюта", Объект.ВалютаДокумента);
			Иначе
				Если  СтрНайти(Параметр, "Аналитика") <> 0 И НЕ ЗначениеЗаполнено(ДанныеШапки[Параметр]) Тогда
					ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПараметраКТ, "НЕОПРЕДЕЛЕНО", Параметр));
					Продолжить;
				Иначе
					Запрос.УстановитьПараметр(Параметр, ДанныеШапки[Параметр]);
				КонецЕсли;
			КонецЕсли;
			ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПараметраКТ, "&" + Параметр, Параметр));
						
		КонецЦикла;
		
		Для Каждого Ресурс Из ОписаниеКТ.Схема.Ресурсы Цикл
			
			Если Ресурс.Ключ = "Сумма" Или Ресурс.Ключ = "Количество" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТолькоВыбранныеПоля И СписокРеквизитов.Найти(Ресурс.Ключ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если КолонкиДляВыгрузки.Найти(Ресурс.Ключ) = Неопределено Тогда
				КолонкиДляВыгрузки.Добавить(Ресурс.Ключ);
			КонецЕсли;
			
			ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, Ресурс.Ключ, Ресурс.Ключ));
			
		КонецЦикла;
		
		Если ОписаниеКТ.ЕстьРасшифровка Тогда
			
			Для Каждого ПолеРасшифровки Из ОписаниеКТ.Схема.Аналитики.мРасшифровка Цикл
				
				ШаблонРасшифровки = СтрЗаменить(ШаблонПоляКТ, "КроссТаблица", "Расшифровка");
				ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонРасшифровки, ПолеРасшифровки, ПолеРасшифровки));
						
			КонецЦикла;
			
		КонецЕсли;
		
		// Связанные с номенклатурой колонки 
		Если ОписаниеКТ.Схема.Ресурсы.Свойство("Количество") Тогда
			Если Параметры.НоменклатураВШапке Тогда
				
				Для Каждого ДопРеквизит Из ДопРеквизитыНоменклатурыВШапке Цикл
					
					Если ТолькоВыбранныеПоля И СписокРеквизитов.Найти(ДопРеквизит.Ключ) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, "&" + ДопРеквизит.Ключ, ДопРеквизит.Ключ));
					
					Если Не ЗначениеЗаполнено(ДанныеШапки[ДопРеквизит.Значение]) Тогда
						Запрос.УстановитьПараметр(ДопРеквизит.Ключ, "");
					Иначе
						Запрос.УстановитьПараметр(ДопРеквизит.Ключ, ДопРеквизит.Ключ.Значение);
					КонецЕсли;

				КонецЦикла;
				
			ИначеЕсли Параметры.НоменклатураВСтроке Тогда
				
				Для Каждого ДопРеквизит Из ДопРеквизитыНоменклатурыВШапке Цикл
					
					Если ТолькоВыбранныеПоля И СписокРеквизитов.Найти(ДопРеквизит.Ключ) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Если КолонкиДляВыгрузки.Найти(ДопРеквизит.Ключ) = Неопределено Тогда
						КолонкиДляВыгрузки.Добавить(ДопРеквизит.Ключ);
					КонецЕсли;
					
					ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, ДопРеквизит.Ключ, ДопРеквизит.Ключ));
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		СчПериодов = СчПериодов + 1;
		Если СтрокаПериод.НомерКолонки <= 0 Тогда 
			Продолжить; 
		КонецЕсли;
		
		ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "Период0", "Период" + Строка(СчПериодов));
		
		Для каждого КлючЗначение Из ОписаниеКТ.Схема.Поля Цикл 
			
			ОписаниеПоля = КлючЗначение.Значение;
			
			Если ТолькоВыбранныеПоля И СписокРеквизитов.Найти(ОписаниеПоля.ИмяРеквизитаТЧ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если КолонкиДляВыгрузки.Найти(ОписаниеПоля.ПрефиксРеквизитаКолонки + СтрокаПериод.ИмяКолонки) = Неопределено Тогда
				КолонкиДляВыгрузки.Добавить(ОписаниеПоля.ПрефиксРеквизитаКолонки + СтрокаПериод.ИмяКолонки);
			КонецЕсли;
			
			ЭтоПереносМеждуРезервами = Ложь;
			// Изменение при переносе между резервами отображается как +, а хранится как -
			Если ОписаниеКТ.Схема.ЭтоПереносМеждуДокументамиРезервирования
				И ОписаниеПоля.ИмяПоказателя = ОписаниеКТ.Схема.Показатели.Изменение.Имя Тогда
				ЭтоПереносМеждуРезервами = Истина;
			КонецЕсли;
			
			ШаблонПоляПоказателяКТ = ?(ЭтоПереносМеждуРезервами, "-", "") + ШаблонПоляКТ;
			
			ПоляДляЗапросаКТ.Добавить(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонПоляПоказателяКТ, 
					ОписаниеПоля.ПрефиксРеквизитаКолонки + СтрокаПериод.ИмяКолонки,
					ОписаниеПоля.ИмяРеквизитаТЧ));
					
		КонецЦикла;
				
		ПоляТаблицыКТСтрокой = СтрСоединить(ПоляДляЗапросаКТ, ", " + Символы.ПС + Символы.Таб);
		ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "&ПоляТаблицыКТ", ПоляТаблицыКТСтрокой); 
				
		ТекстыЗапросов.Добавить(ШаблонЗапроса);
		
		Запрос.УстановитьПараметр("Период" + Строка(СчПериодов), СтрокаПериод.Период);
	КонецЦикла;
	
	Если ОписаниеКТ.ЕстьРасшифровка Тогда
		ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(
			Запрос,	"ВТ_Расшифровка",
			Расшифровка.Выгрузить(, ОписаниеКТ.Схема.Аналитики.Расшифровка + ",ИДСтроки,ИДПериода"));
	КонецЕсли;
	
	КолонкиДляВыгрузкиСтрокой = СтрСоединить(КолонкиДляВыгрузки, ",");
	ТЗКроссТаблица = КроссТаблица.Выгрузить(, КолонкиДляВыгрузкиСтрокой + ",НомерСтроки, ИДСтроки");
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТКроссТаблица", ТЗКроссТаблица);
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
	Запрос.Выполнить();
	
	Возврат Запрос.МенеджерВременныхТаблиц;           
	
КонецФункции

Функция ШаблонТекстаДвиженийОперации(СхемаКТ)
	
	Если СхемаКТ.ЭтоПланирование Или СхемаКТ.ЭтоПланированиеРезервирование Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВТ_ДвиженияОперации.НомерСтроки КАК НомерСтроки,
		|	ВТ_ДвиженияОперации.Период КАК Период,
		|	АналитикаПланированияСтатейБюджетов.КлючАналитики КАК АналитикаСтатейБюджетов,
		|	АналитикаПланированияПотребностей.КлючАналитики КАК АналитикаПотребностей,
		|	АналитикаПланированияСтруктуры.КлючАналитики КАК АналитикаСтруктуры,
		|	АналитикаПланированияНоменклатуры.КлючАналитики КАК АналитикаНоменклатуры,
		|	АналитикаПланированияРасчетовСКонтрагентами.КлючАналитики КАК АналитикаПартнеров,
		|	&ПоляДвиженияОперации
		|ИЗ
		|	ВТ_ДвиженияОперации КАК ВТ_ДвиженияОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов
		|		ПО ВТ_ДвиженияОперации.СтатьяБюджета = АналитикаПланированияСтатейБюджетов.СтатьяБюджета
		|			И ВТ_ДвиженияОперации.Аналитика1 = АналитикаПланированияСтатейБюджетов.Аналитика1
		|			И ВТ_ДвиженияОперации.Аналитика2 = АналитикаПланированияСтатейБюджетов.Аналитика2
		|			И ВТ_ДвиженияОперации.Аналитика3 = АналитикаПланированияСтатейБюджетов.Аналитика3
		|			И ВТ_ДвиженияОперации.Аналитика4 = АналитикаПланированияСтатейБюджетов.Аналитика4
		|			И ВТ_ДвиженияОперации.Аналитика5 = АналитикаПланированияСтатейБюджетов.Аналитика5
		|			И ВТ_ДвиженияОперации.Аналитика6 = АналитикаПланированияСтатейБюджетов.Аналитика6
		|			И ВТ_ДвиженияОперации.ПриходРасход = АналитикаПланированияСтатейБюджетов.ПриходРасход
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПотребностей КАК АналитикаПланированияПотребностей
		|		ПО ВТ_ДвиженияОперации.МестоПоставки = АналитикаПланированияПотребностей.МестоПоставки
		|			И ВТ_ДвиженияОперации.Приоритет = АналитикаПланированияПотребностей.Приоритет
		|			И ВТ_ДвиженияОперации.Менеджер = АналитикаПланированияПотребностей.Менеджер
		|			И ВТ_ДвиженияОперации.ДоговорКонтрагента = АналитикаПланированияПотребностей.Назначение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры
		|		ПО ВТ_ДвиженияОперации.ЦФО = АналитикаПланированияСтруктуры.ЦФО
		|			И ВТ_ДвиженияОперации.Проект = АналитикаПланированияСтруктуры.Проект
		|			И ВТ_ДвиженияОперации.Организация = АналитикаПланированияСтруктуры.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияНоменклатуры КАК АналитикаПланированияНоменклатуры
		|		ПО ВТ_ДвиженияОперации.Номенклатура = АналитикаПланированияНоменклатуры.Номенклатура
		|			И ВТ_ДвиженияОперации.Характеристика = АналитикаПланированияНоменклатуры.Характеристика
		|			И ВТ_ДвиженияОперации.ЕдиницаИзмерения = АналитикаПланированияНоменклатуры.ЕдиницаИзмерения
		|			И ВТ_ДвиженияОперации.Коэффициент = АналитикаПланированияНоменклатуры.Коэффициент
		|			И (АналитикаПланированияНоменклатуры.ИсходнаяНоменклатура = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияРасчетовСКонтрагентами КАК АналитикаПланированияРасчетовСКонтрагентами
		|		ПО ВТ_ДвиженияОперации.Организация = АналитикаПланированияРасчетовСКонтрагентами.Организация
		|			И ВТ_ДвиженияОперации.Контрагент = АналитикаПланированияРасчетовСКонтрагентами.Контрагент
		|			И ВТ_ДвиженияОперации.ДоговорКонтрагента = АналитикаПланированияРасчетовСКонтрагентами.Договор
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки,
		|	Период";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВТ_ДвиженияОперации.НомерСтроки КАК НомерСтроки,
		|	ВТ_ДвиженияОперации.Период КАК Период,
		|	&ПоляДвиженияОперации
		|ИЗ
		|	ВТ_ДвиженияОперации КАК ВТ_ДвиженияОперации
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки,
		|	Период";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ШаблонТекстаЗапроса(СтрокаПериода, ЕстьРасшифровка = Ложь)
	
	Если ЕстьРасшифровка Тогда
		ШаблонТекста = 
			"ВЫБРАТЬ
			|	КроссТаблица.НомерСтроки КАК НомерСтроки,
			|	&Период0 КАК Период,
			|	&ПоляТаблицыКТ
			|ПОМЕСТИТЬ ВТ_ДвиженияОперации
			|ИЗ
			|	ВТКроссТаблица КАК КроссТаблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Расшифровка КАК Расшифровка
			|		ПО КроссТаблица.ИДСтроки = Расшифровка.ИДСтроки
			|ГДЕ
			|	Расшифровка.ИДПериода = &ИДПериода";   
		ШаблонТекста = СтрЗаменить(ШаблонТекста, "&ИДПериода", "&ИДПериода" + СтрокаПериода);
	Иначе
		ШаблонТекста = 
			"ВЫБРАТЬ
			|	КроссТаблица.НомерСтроки КАК НомерСтроки,
			|	&Период0 КАК Период,
			|	&ПоляТаблицыКТ
			|ПОМЕСТИТЬ ВТ_ДвиженияОперации
			|ИЗ
			|	ВТКроссТаблица КАК КроссТаблица";
	КонецЕсли;
	
	Возврат ШаблонТекста;
	
КонецФункции

Процедура ЗаполнитьТаблицуИзКроссТаблицы(ПараметрыЗаполнения) Экспорт
	
	ТаблицаПериоды = ПараметрыЗаполнения.Периоды;
	Объект = ПараметрыЗаполнения.Объект;
	
	РезультатВТаблицуЗначений = ПараметрыЗаполнения.Свойство("Результат");
	
	Если Не ЗначениеЗаполнено(Объект.ВариантНастройки) Тогда
		Возврат;
	КонецЕсли; 
	
	АктивныеПериоды = ТаблицаПериоды.НайтиСтроки(Новый Структура("Активная", Истина));
	
	ПараметрыИтераций = ОпределитьПараметрыИтераций(АктивныеПериоды);
	                          
	ТаблицаРезультат = Неопределено;  
	Для Итерация = 1 По ПараметрыИтераций.КоличествоИтераций Цикл  	
		
		ТекущиеАктивныеПериоды = ЗаполнитьТекущиеАктивныеПериоды(АктивныеПериоды, ПараметрыИтераций, Итерация);
		
		ТаблицаДанных = ЗаполнитьТаблицуИзКроссТаблицыАктивныеПериоды(ПараметрыЗаполнения, ТекущиеАктивныеПериоды);	
		
		Если Итерация = 1 Тогда                                                
			ТаблицаРезультат = ТаблицаДанных;
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаДанных, ТаблицаРезультат);
		КонецЕсли;     
		
	КонецЦикла;   

	Если РезультатВТаблицуЗначений Тогда
		ПараметрыЗаполнения.Результат = ТаблицаРезультат;
	Иначе
		Объект.ДвиженияОперации.Загрузить(ТаблицаРезультат);
	КонецЕсли;       	
	
КонецПроцедуры

Функция ЗаполнитьТаблицуИзКроссТаблицыАктивныеПериоды(ПараметрыЗаполнения, АктивныеПериоды)
	
	ТаблицаПериоды = ПараметрыЗаполнения.Периоды;
	ОписаниеКТ     = ПараметрыЗаполнения.ОписаниеКТ;
	Расшифровка    = ПараметрыЗаполнения.Расшифровка;
	КроссТаблица   = ПараметрыЗаполнения.КроссТаблица;
	Объект         = ПараметрыЗаполнения.Объект;
	Аналитики      = ОписаниеКТ.Схема.Аналитики;
	
	РезультатВТаблицуЗначений = ПараметрыЗаполнения.Свойство("Результат");
	
	ПоляАналитик        = Новый Массив;           
	КолонкиДляВыгрузки  = Новый Массив;
	СписокРеквизитов    = Новый Массив;
	
	ПоляШапкиДляЗаполнения = ОписаниеКТ.Схема.Аналитики.Шапка;
	
	ЕстьВалютаВШапке = КроссТаблицыУХКлиентСервер.ЕстьАналитикаШапки(ОписаниеКТ, "Валюта");
	
	Если ЕстьВалютаВШапке Тогда
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, "Валюта,", "");
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, ",Валюта", "");
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, ",Валюта,", "");
		ПоляШапкиДляЗаполнения = СтрЗаменить(ПоляШапкиДляЗаполнения, "Валюта", ""); // Если она одна в шапке
	КонецЕсли; 
	
	ВалютаДокумента = Объект.ВалютаДокумента;
	
	ДанныеШапки = Новый Структура(ПоляШапкиДляЗаполнения);
	ЗаполнитьЗначенияСвойств(ДанныеШапки, Объект, ПоляШапкиДляЗаполнения); 
	
	// Доп.реквизиты Номенклатуры
	НоменклатураВШапке              = ОписаниеКТ.Схема.Аналитики.мШапка.Найти("Номенклатура") <> Неопределено;
	НоменклатураВСтроке             = ОписаниеКТ.Схема.Аналитики.мСтрока.Найти("Номенклатура") <> Неопределено;
	НоменклатураВРасшифровке        = ОписаниеКТ.Схема.Аналитики.мРасшифровка.Найти("Номенклатура") <> Неопределено;
	СписокДопРеквизитовНоменклатуры = ОписаниеКТ.Схема.ДопРеквизитыНоменклатуры;
	ДопРеквизитыНоменклатурыВШапке  = Новый Структура(СписокДопРеквизитовНоменклатуры);
	ЗаполнитьЗначенияСвойств(ДопРеквизитыНоменклатурыВШапке, Объект, СписокДопРеквизитовНоменклатуры);
	
	Параметры = Новый Структура;
	Параметры.Вставить("НоменклатураВШапке",              НоменклатураВШапке);
	Параметры.Вставить("НоменклатураВСтроке",             НоменклатураВСтроке);
	Параметры.Вставить("НоменклатураВРасшифровке",        НоменклатураВРасшифровке);
	Параметры.Вставить("СписокДопРеквизитовНоменклатуры", СписокДопРеквизитовНоменклатуры);
	Параметры.Вставить("ДопРеквизитыНоменклатурыВШапке",  ДопРеквизитыНоменклатурыВШапке);
	Параметры.Вставить("ВалютаДокумента",                 ВалютаДокумента);
	Параметры.Вставить("ЕстьВалютаВШапке",                ЕстьВалютаВШапке);
	Параметры.Вставить("ПоляШапкиДляЗаполнения",          ПоляШапкиДляЗаполнения);
	
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИменаПолейДвиженияОперации = Новый Массив;
	ПоляДвиженияОперации      = Новый Массив;
	ШаблонПоляДО = "ВТ_ДвиженияОперации.%1 КАК %1";
	ШаблонПоляКТ = "КроссТаблица.%1 КАК %2";
	ШаблонПараметраКТ = "%1 КАК %2";
	
	Для Каждого Аналитика Из Аналитики.мСтрока Цикл
		ПоляДвиженияОперации.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонПоляДО, Аналитика));
			ИменаПолейДвиженияОперации.Добавить(Аналитика);
	КонецЦикла;
	
	Для Каждого Аналитика Из Аналитики.мРасшифровка Цикл
		ПоляДвиженияОперации.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонПоляДО, Аналитика));
			ИменаПолейДвиженияОперации.Добавить(Аналитика);
	КонецЦикла;
	
	Для Каждого Аналитика Из Аналитики.мШапка Цикл
		ПоляДвиженияОперации.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонПоляДО, Аналитика));
			ИменаПолейДвиженияОперации.Добавить(Аналитика);
	КонецЦикла;
	
	Для Каждого Поле Из ОписаниеКТ.Схема.Поля Цикл
		ЗначениеПоля = Поле.Значение;
		ПоляДвиженияОперации.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонПоляДО, ЗначениеПоля.ИмяРеквизитаТЧ));
			ИменаПолейДвиженияОперации.Добавить(ЗначениеПоля.ИмяРеквизитаТЧ);
	КонецЦикла;
		
	Если ОписаниеКТ.Схема.Ресурсы.Свойство("Количество") Тогда
		Если Параметры.НоменклатураВШапке Тогда
			
			Для Каждого ДопРеквизит Из ДопРеквизитыНоменклатурыВШапке Цикл
				
				ПоляДвиженияОперации.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонПоляДО, ДопРеквизит.Ключ));
				
			КонецЦикла;
			
		ИначеЕсли Параметры.НоменклатураВСтроке Тогда
			
			Для Каждого ДопРеквизит Из ДопРеквизитыНоменклатурыВШапке Цикл
				
				ПоляДвиженияОперации.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонПоляДО, ДопРеквизит.Ключ));
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	// Обязательные поля, которые учавствуют в соединении с регистрами ключей.
	ОбязательныеПоляЗапроса = Новый Соответствие;
	ОбязательныеПоляЗапроса.Вставить("Организация", 		КэшируемыеПроцедурыОПК.ПустаяОрганизация());
	ОбязательныеПоляЗапроса.Вставить("Аналитика1", 			"НЕОПРЕДЕЛЕНО");
	ОбязательныеПоляЗапроса.Вставить("Аналитика2", 			"НЕОПРЕДЕЛЕНО");
	ОбязательныеПоляЗапроса.Вставить("Аналитика3", 			"НЕОПРЕДЕЛЕНО");
	ОбязательныеПоляЗапроса.Вставить("Аналитика4", 			"НЕОПРЕДЕЛЕНО");
	ОбязательныеПоляЗапроса.Вставить("Аналитика5", 			"НЕОПРЕДЕЛЕНО");
	ОбязательныеПоляЗапроса.Вставить("Аналитика6",			"НЕОПРЕДЕЛЕНО");
	ОбязательныеПоляЗапроса.Вставить("ПриходРасход",  		Перечисления.ВидыДвиженийПриходРасход.ПустаяСсылка());
	ОбязательныеПоляЗапроса.Вставить("МестоПоставки",		Справочники.МестаПоставки.ПустаяСсылка());
	ОбязательныеПоляЗапроса.Вставить("Менеджер",			КэшируемыеПроцедурыОПК.ПустоеФизическоеЛицо());
	ОбязательныеПоляЗапроса.Вставить("Контрагент",			КэшируемыеПроцедурыОПК.ПустойКонтрагент());
	ОбязательныеПоляЗапроса.Вставить("ДоговорКонтрагента",	КэшируемыеПроцедурыОПК.ПустойДоговор());
	ОбязательныеПоляЗапроса.Вставить("ЦФО",					КэшируемыеПроцедурыОПК.ПустойЦФО());
	ОбязательныеПоляЗапроса.Вставить("Проект",				КэшируемыеПроцедурыОПК.ПустойПроект());
	ОбязательныеПоляЗапроса.Вставить("Организация",			КэшируемыеПроцедурыОПК.ПустаяОрганизация());
	ОбязательныеПоляЗапроса.Вставить("Номенклатура",		КэшируемыеПроцедурыОПК.ПустаяНоменклатура());
	ОбязательныеПоляЗапроса.Вставить("Характеристика",		КэшируемыеПроцедурыОПК.ПустаяХарактетистикаНоменклатуры());
	ОбязательныеПоляЗапроса.Вставить("ЕдиницаИзмерения",	КэшируемыеПроцедурыОПК.ПустаяЕдиницаИзмерения());
	ОбязательныеПоляЗапроса.Вставить("Коэффициент", 		1);
	ОбязательныеПоляЗапроса.Вставить("Приоритет",   		Справочники.ПриоритетыПотребностей.Обычный);
	
	ДополнительныеПоля = Новый Массив;
	// Если после формирования таблицы не хватает полей для соединения с регистрами ключей - будем дополнять из этого массива.
	Для Каждого КлючЗначение Из ОбязательныеПоляЗапроса Цикл
		Если ИменаПолейДвиженияОперации.Найти(КлючЗначение.Ключ) = Неопределено Тогда
			ДополнительныеПоля.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	СчПериодов = 0;
	
	ТекстыЗапросов = Новый Массив;
	ТЗКроссТаблица = КроссТаблица.Выгрузить();
	// Формироване таблицы движений.
	Для Каждого СтрокаПериод Из АктивныеПериоды Цикл
		
		ПоляДляЗапросаКТ = Новый Массив;
		
		Если ОписаниеКТ.ЕстьРасшифровка Тогда
			ИДПериода = Новый УникальныйИдентификатор(СтрЗаменить(СтрокаПериод.ИмяКолонки, "_", "-")); 
			Запрос.УстановитьПараметр("ИДПериода" + Строка(СчПериодов), ИДПериода);
		КонецЕсли;
		
		ШаблонЗапроса = ШаблонТекстаЗапроса(Строка(СчПериодов), ОписаниеКТ.ЕстьРасшифровка);
		
		Если ТекстыЗапросов.Количество() > 0 Тогда
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "ПОМЕСТИТЬ ВТ_ДвиженияОперации", "");
		КонецЕсли;
		
		Для Каждого Реквизит Из Аналитики.мСтрока Цикл
			
			Если КолонкиДляВыгрузки.Найти(Реквизит) = Неопределено Тогда
				КолонкиДляВыгрузки.Добавить(Реквизит);
			КонецЕсли;
			
			ПоляДляЗапросаКТ.Добавить(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, Реквизит, Реквизит));
				
			// проверка доп полей
			ПроверкаДопПоля = ДополнительныеПоля.Найти(Реквизит);
			Если ПроверкаДопПоля <> Неопределено Тогда
				ДополнительныеПоля.Удалить(ПроверкаДопПоля);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Параметр Из Аналитики.мШапка Цикл
			
			ПроверкаДопПоля = ДополнительныеПоля.Найти(Параметр);
			Если ПроверкаДопПоля <> Неопределено Тогда
				ДополнительныеПоля.Удалить(ПроверкаДопПоля);
			КонецЕсли;
			
			Если Параметр = "Валюта" Тогда
				Запрос.УстановитьПараметр("Валюта", Объект.ВалютаДокумента);
			Иначе
				Запрос.УстановитьПараметр(Параметр, ДанныеШапки[Параметр]);
			КонецЕсли;
			ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПараметраКТ, "&" + Параметр, Параметр));
						
		КонецЦикла;
		
		Для Каждого Ресурс Из ОписаниеКТ.Схема.Ресурсы Цикл
			
			// Удаляем из доп полей, если уже есть, чтобы не было дублирования поля в запросе.
			ПроверкаДопПоля = ДополнительныеПоля.Найти(Параметр);
			Если ПроверкаДопПоля <> Неопределено Тогда
				ДополнительныеПоля.Удалить(ПроверкаДопПоля);
			КонецЕсли;
			
			Если Ресурс.Ключ = "Сумма" Или Ресурс.Ключ = "Количество" Тогда
				Продолжить;
			КонецЕсли;
			
			Если КолонкиДляВыгрузки.Найти(Ресурс.Ключ) = Неопределено Тогда
				КолонкиДляВыгрузки.Добавить(Ресурс.Ключ);
			КонецЕсли;
			
			ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, Ресурс.Ключ, Ресурс.Ключ));
			
		КонецЦикла;
		
		Если ОписаниеКТ.ЕстьРасшифровка Тогда
			
			Для Каждого ПолеРасшифровки Из ОписаниеКТ.Схема.Аналитики.мРасшифровка Цикл
				
				ШаблонРасшифровки = СтрЗаменить(ШаблонПоляКТ, "КроссТаблица", "Расшифровка");
				ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонРасшифровки, ПолеРасшифровки, ПолеРасшифровки));
						
			КонецЦикла;
			
		КонецЕсли;
		
		// Связанные с номенклатурой колонки 
		Если ОписаниеКТ.Схема.Ресурсы.Свойство("Количество") Тогда
			Если Параметры.НоменклатураВШапке Тогда
				
				Для Каждого ДопРеквизит Из ДопРеквизитыНоменклатурыВШапке Цикл
					
					ПроверкаДопПоля = ДополнительныеПоля.Найти(ДопРеквизит.Ключ);
					Если ПроверкаДопПоля <> Неопределено Тогда
						ДополнительныеПоля.Удалить(ПроверкаДопПоля);
					КонецЕсли;
					
					ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, "&" + ДопРеквизит.Ключ, ДопРеквизит.Ключ));
						
					Если Не ЗначениеЗаполнено(ДанныеШапки[ДопРеквизит.Значение]) Тогда
						Запрос.УстановитьПараметр(ДопРеквизит.Ключ, "");
					Иначе
						Запрос.УстановитьПараметр(ДопРеквизит.Ключ, ДопРеквизит.Ключ.Значение);
					КонецЕсли;

				КонецЦикла;
				
			ИначеЕсли Параметры.НоменклатураВСтроке Тогда
				
				Для Каждого ДопРеквизит Из ДопРеквизитыНоменклатурыВШапке Цикл
					
					ПроверкаДопПоля = ДополнительныеПоля.Найти(ДопРеквизит.Ключ);
					Если ПроверкаДопПоля <> Неопределено Тогда
						ДополнительныеПоля.Удалить(ПроверкаДопПоля);
					КонецЕсли;
					
					Если КолонкиДляВыгрузки.Найти(ДопРеквизит.Ключ) = Неопределено Тогда
						КолонкиДляВыгрузки.Добавить(ДопРеквизит.Ключ);
					КонецЕсли;
					
					ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляКТ, ДопРеквизит.Ключ, ДопРеквизит.Ключ));
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		СчПериодов = СчПериодов + 1;
		Если СтрокаПериод.НомерКолонки <= 0 Тогда 
			Продолжить; 
		КонецЕсли;
		
		ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "Период0", "Период" + Строка(СчПериодов));
		
		Для каждого КлючЗначение Из ОписаниеКТ.Схема.Поля Цикл 
			
			ОписаниеПоля = КлючЗначение.Значение;
			
			Если КолонкиДляВыгрузки.Найти(ОписаниеПоля.ПрефиксРеквизитаКолонки + СтрокаПериод.ИмяКолонки) = Неопределено Тогда
				КолонкиДляВыгрузки.Добавить(ОписаниеПоля.ПрефиксРеквизитаКолонки + СтрокаПериод.ИмяКолонки);
			КонецЕсли;
			
			ЭтоПереносМеждуРезервами = Ложь;
			// Изменение при переносе между резервами отображается как +, а хранится как -
			Если ОписаниеКТ.Схема.ЭтоПереносМеждуДокументамиРезервирования
				И ОписаниеПоля.ИмяПоказателя = ОписаниеКТ.Схема.Показатели.Изменение.Имя Тогда
				ЭтоПереносМеждуРезервами = Истина;
			КонецЕсли;
			
			ШаблонПоляПоказателяКТ = ?(ЭтоПереносМеждуРезервами, "-", "") + ШаблонПоляКТ;
			
			ПоляДляЗапросаКТ.Добавить(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонПоляПоказателяКТ, 
					ОписаниеПоля.ПрефиксРеквизитаКолонки + СтрокаПериод.ИмяКолонки,
					ОписаниеПоля.ИмяРеквизитаТЧ));
					
		КонецЦикла;
		
		Для Каждого ДопПоле Из ДополнительныеПоля Цикл
			
			ПоляДляЗапросаКТ.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПараметраКТ, "&" + ДопПоле, ДопПоле));
			Запрос.УстановитьПараметр(ДопПоле, ОбязательныеПоляЗапроса[ДопПоле]);
			
		КонецЦикла;
		
		ПоляТаблицыКТСтрокой = СтрСоединить(ПоляДляЗапросаКТ, ", " + Символы.ПС + Символы.Таб);
		ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "&ПоляТаблицыКТ", ПоляТаблицыКТСтрокой); 
		
		ТекстыЗапросов.Добавить(ШаблонЗапроса);
		
		Запрос.УстановитьПараметр("Период" + Строка(СчПериодов), СтрокаПериод.Период);
	КонецЦикла;
	
	Если ОписаниеКТ.ЕстьРасшифровка Тогда
		ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(
			Запрос,
			"ВТ_Расшифровка",
			Расшифровка.Выгрузить(, ОписаниеКТ.Схема.Аналитики.Расшифровка + ",ИДСтроки,ИДПериода"));
	КонецЕсли;
		
	КолонкиДляВыгрузкиСтрокой = СтрСоединить(КолонкиДляВыгрузки, ",");
	ТЗКроссТаблица = КроссТаблица.Выгрузить(, КолонкиДляВыгрузкиСтрокой + ",НомерСтроки, ИДСтроки");
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТКроссТаблица", ТЗКроссТаблица);
	Запрос.Текст     = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	РезультатЗапроса = Запрос.Выполнить();
	
	ШаблонТекстаЗапросаДвиженийОперации = ШаблонТекстаДвиженийОперации(ОписаниеКТ.Схема);
	
	ПоляПоляДвиженияОперацииСтрокой = СтрСоединить(ПоляДвиженияОперации, ", " + Символы.ПС + Символы.Таб);
	Запрос.Текст = СтрЗаменить(ШаблонТекстаЗапросаДвиженийОперации, "&ПоляДвиженияОперации", ПоляПоляДвиженияОперацииСтрокой);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРезультат = РезультатЗапроса.Выгрузить();   
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура ЗагрузитьДанныеВКроссТаблицу(ДокументОбъект, ОписаниеКТ, Форма, ДвиженияОперации) Экспорт
	
	ЗаполнитьКроссТаблицуИзТаблицы( 
		Форма[ОписаниеКТ.Реквизиты.КроссТаблица],
		Форма[ОписаниеКТ.Реквизиты.Расшифровка],
		ПолучитьДвиженияОперацииПоТаблицеЗначений(ОписаниеКТ, Форма[ОписаниеКТ.Реквизиты.Периоды], ДвиженияОперации),
		ОписаниеКТ,
		Форма[ОписаниеКТ.Реквизиты.Периоды]);
		
	// 
	Если (ОписаниеКТ.Схема.ЭтоВводЛимитов ИЛИ ОписаниеКТ.Схема.ЭтоРезервирование)
		И ПолучитьРасположениеАналитики(ОписаниеКТ, "СтатьяБюджета") = "ВСтроке" Тогда
		ЗаполнитьУровеньКонтроляСтатьиБюджета(ОписаниеКТ, Форма);
	КонецЕсли;
		
	КроссТаблицыУХКлиентСервер.РассчитатьИтогиКолонокИОбщие(ОписаниеКТ, Форма);
	
	КроссТаблицыУХКлиентСервер.РассчитатьНомерСтрокиКроссТаблицы(ОписаниеКТ, Форма);
	
	// Заполняем дополнительные реквизиты аналитик статьи бюджета движения ресурсов
	ИнициализироватьЗначенияДопРеквизитовКТ(ОписаниеКТ, Форма, ДокументОбъект.ВидБюджета);
	
КонецПроцедуры

Функция ОпределитьПараметрыИтераций(АктивныеПериоды) Экспорт
	
	МаксимальноеКоличествоПериодов = 100;
	КоличествоОбщее   	= АктивныеПериоды.Количество();
	КоличествоИтераций 	= Цел(КоличествоОбщее / МаксимальноеКоличествоПериодов) + 1;  

	ПараметрыИтераций = Новый Структура;
	ПараметрыИтераций.Вставить("МаксимальноеКоличествоПериодов", МаксимальноеКоличествоПериодов);	
	ПараметрыИтераций.Вставить("КоличествоОбщее", КоличествоОбщее);
	ПараметрыИтераций.Вставить("КоличествоИтераций", КоличествоИтераций);
	
	Возврат ПараметрыИтераций;
	
КонецФункции  

Функция ЗаполнитьТекущиеАктивныеПериоды(АктивныеПериоды, ПараметрыИтераций, Итерация) Экспорт
	
	ТекущиеАктивныеПериоды = Новый Массив;
	
	ИндексНач = (Итерация - 1) * ПараметрыИтераций.МаксимальноеКоличествоПериодов;
	ИндексКон = Итерация * ПараметрыИтераций.МаксимальноеКоличествоПериодов - 1;
	
	Для Индекс = ИндексНач По ИндексКон Цикл
		Если Индекс < ПараметрыИтераций.КоличествоОбщее Тогда
			ТекущиеАктивныеПериоды.Добавить(АктивныеПериоды[Индекс]);
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат ТекущиеАктивныеПериоды;
	
КонецФункции
	
#КонецОбласти
