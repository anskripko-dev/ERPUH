// Урубков И. 15.12.2025 Выполнение задач №000056054
//
// Возвращает номер версии подсистемы ОбновлениеИнформационнойБазы_ТН.
//
// Возвращаемое значение:
//  Строка - номер сборки.
//
Функция ВерсияПодсистемы() Экспорт
	
	ВерсияВКомментарии = СокрЛП(Метаданные.Комментарий);
	
	ВерсияТекущегоРелиза = СтрЗаменить(ВерсияВКомментарии,"R", "");
	
	Попытка
		
		НомерВерсииРелизаПриведенныйКЧислу = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Лев(ВерсияТекущегоРелиза, 3));
		
		Если Не ЗначениеЗаполнено(НомерВерсииРелизаПриведенныйКЧислу) Тогда
			// для тестового контура комментарий не заполнен, версия всегда будет 1.0.0.0
			НомерВерсииРелизаПриведенныйКЧислу = 1;
		КонецЕсли;
		
		Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(НомерВерсииРелизаПриведенныйКЧислу) Тогда
			ЗаписьЖурналаРегистрации("ОбновлениеИнформационнойБазы_ТН", УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка расчета версии подсистемы ""ОбновлениеИнформационнойБазы_ТН""");
		КонецЕсли;
		
		ИтоговаяВерсия = СтрШаблон("%1.%2.%3.%4", НомерВерсииРелизаПриведенныйКЧислу, 0, 0, 0);
		
	Исключение
		
		ТекстОшибки = СтрШаблон("%1 %2", "Ошибка расчета версии подсистемы ""ОбновлениеИнформационнойБазы_ТН""", ПодробноеПредставлениеОшибки(ОписаниеОшибки()));
		ЗаписьЖурналаРегистрации("ОбновлениеИнформационнойБазы_ТН", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	Возврат ИтоговаяВерсия;
	
КонецФункции

