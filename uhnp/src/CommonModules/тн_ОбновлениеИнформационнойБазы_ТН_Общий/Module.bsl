Функция ЗаполнитьОбработчикиОбновленияТН(ОбработчикиОбновления, ТекущаяВерсияИБ) Экспорт
	
	ОбработчикиОбновленияТН = ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления();
	
	Если ТипЗнч(ОбработчикиОбновления) = Тип("ТаблицаЗначений") 
		И ОбработчикиОбновления.Колонки.Найти("ВыполнениеОбработчиковОбновленияТН") <> Неопределено Тогда
		
		ПараметрыПоиска = Новый Структура("ВыполнениеОбработчиковОбновленияТН", Истина);
		
		НайденныеСтроки = ОбработчикиОбновления.НайтиСтроки(ПараметрыПоиска);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			СтрокаОбработчика = ОбработчикиОбновленияТН.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбработчика, НайденнаяСтрока);
			СтрокаОбработчика.Версия = ТекущаяВерсияИБ;
			СтрокаОбработчика.ВерсияРегистрации = ТекущаяВерсияИБ;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ОбработчикиОбновленияТН;
	
КонецФункции

// Добавляет в "ВыполняемыеОбработчики" данные обработчиков, которые не зафиксированы в РС ТН_ОбработчикиОбновления как выполненные
Процедура ДобавитьНеВыполненныеОбработчикиОбновленияТН(ВыполняемыеОбработчики, ТаблицаОбработчиков, ТекущаяВерсияИБ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ТаблицаОбработчиков.Процедура КАК СТРОКА(250)) КАК Процедура,
		|	ТаблицаОбработчиков.НомерВЗ КАК НомерВЗ
		|ПОМЕСТИТЬ втТаблицаОбработчиков
		|ИЗ
		|	&ТаблицаОбработчиков КАК ТаблицаОбработчиков
		|ГДЕ
		|	ТаблицаОбработчиков.ВыполнениеОбработчиковОбновленияТН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СОКРЛП(втТаблицаОбработчиков.Процедура) КАК Процедура,
		|	втТаблицаОбработчиков.НомерВЗ КАК НомерВЗ
		|ИЗ
		|	втТаблицаОбработчиков КАК втТаблицаОбработчиков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТН_ОбработчикиОбновления КАК ТН_ОбработчикиОбновления
		|		ПО втТаблицаОбработчиков.Процедура = ТН_ОбработчикиОбновления.Процедура
		|			И втТаблицаОбработчиков.НомерВЗ = ТН_ОбработчикиОбновления.НомерВЗ
		|ГДЕ
		|	ТН_ОбработчикиОбновления.НомерВЗ ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СОКРЛП(втТаблицаОбработчиков.Процедура),
		|	втТаблицаОбработчиков.НомерВЗ
		|ИЗ
		|	втТаблицаОбработчиков КАК втТаблицаОбработчиков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТН_ОбработчикиОбновления КАК ТН_ОбработчикиОбновления
		|		ПО втТаблицаОбработчиков.Процедура = ТН_ОбработчикиОбновления.Процедура
		|			И втТаблицаОбработчиков.НомерВЗ = ТН_ОбработчикиОбновления.НомерВЗ
		|ГДЕ
		|	НЕ ТН_ОбработчикиОбновления.Выполнено
		|	И НЕ ТН_ОбработчикиОбновления.ВРаботе";
	
	Запрос.УстановитьПараметр("ТаблицаОбработчиков", ТаблицаОбработчиков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Процедура", Выборка.Процедура);
		ПараметрыПоиска.Вставить("НомерВЗ", Выборка.НомерВЗ);
		
		НайденныеСтроки = ТаблицаОбработчиков.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			
			СтрокаДЗ = ВыполняемыеОбработчики.Строки.Добавить();
			СтрокаДЗ.Версия = ТекущаяВерсияИБ;
		
			СтрокаОбработчика = СтрокаДЗ.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбработчика, НайденнаяСтрока);
			СтрокаОбработчика.Версия = ТекущаяВерсияИБ;
			СтрокаОбработчика.ВерсияРегистрации = ТекущаяВерсияИБ;
			
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры

