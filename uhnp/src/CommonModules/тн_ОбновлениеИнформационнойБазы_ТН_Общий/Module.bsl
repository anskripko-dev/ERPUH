Процедура СоздатьПредопределеннуюСтатьюРасходов(Наименование, ИмяПредопределенныхДанных, ТипЗначения) Экспорт

	ЗаписатьИзменения = Ложь;
	ОТ = Новый ОписаниеТипов(ТипЗначения); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатьиРасходов.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиРасходов
	|ГДЕ
	|	СтатьиРасходов.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных";
	
	Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", ИмяПредопределенныхДанных);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда      
		СтатьяРасходовОбъект = Результат.Ссылка.ПолучитьОбъект();	
		ЗаписатьИзменения = НЕ (СтатьяРасходовОбъект.Наименование = Наименование
							И СтатьяРасходовОбъект.ВариантРаспределенияРасходовУпр = Перечисления.ВариантыРаспределенияРасходов.НаСебестоимостьТоваров
							И СтатьяРасходовОбъект.ТипРасходов = Перечисления.ТипыРасходов.ЗакупкаТоваров
							И СтатьяРасходовОбъект.ТипЗначения = ОТ); 
	Иначе
		СтатьяРасходовОбъект = ПланыВидовХарактеристик.СтатьиРасходов.СоздатьЭлемент();		
		СтатьяРасходовОбъект.ИмяПредопределенныхДанных = ИмяПредопределенныхДанных;
		ЗаписатьИзменения = Истина;
	КонецЕсли;
	
	Если ЗаписатьИзменения Тогда
		
		СтатьяРасходовОбъект.Наименование= Наименование;
		СтатьяРасходовОбъект.ВариантРаспределенияРасходовУпр = Перечисления.ВариантыРаспределенияРасходов.НаСебестоимостьТоваров;
		СтатьяРасходовОбъект.ТипРасходов = Перечисления.ТипыРасходов.ЗакупкаТоваров;
		СтатьяРасходовОбъект.ТипЗначения = ОТ;
		
		СтатьяРасходовОбъект.ОбменДанными.Загрузка = Истина;
		
		Попытка
			СтатьяРасходовОбъект.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.ПланыВидовХарактеристик.СтатьиРасходов,,
			"Ошибка при выполнении обработчика обновления тн_ОбновлениеИнформационнойБазы_ТН_Общий.СоздатьПредопределеннуюСтатьюРасходов: " 
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры  

