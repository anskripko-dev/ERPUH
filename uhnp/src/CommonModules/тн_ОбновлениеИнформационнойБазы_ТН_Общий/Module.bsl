// Урубков И. 02.09.2025 Выполнение задач №000054387
//
Процедура ИсключитьВыполненныеОбработчикиТН(ИтерацияОбновления, ОбрабатываемыеОбработчики) Экспорт
	
	Если Не ЭтоМодульОбработчиковОбнолвенияТН(ИтерацияОбновления.ИмяОсновногоСерверногоМодуля) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполненныеОбработчикиТН = ПолучитьВыполненныеОбработчики();
	ВыборкаВыполненныеОбработчикиТН = РезультатВыполненныеОбработчикиТН.Выбрать();
	
	Версия = Метаданные.Версия;
	
	Для Каждого СтрокаОбработчика Из ОбрабатываемыеОбработчики.Строки Цикл
		
		Если СтрокаОбработчика.Версия <> ВерсияКонфигурацииОбработчикаСлужебная() Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиДляУдаления = Новый Массив;
		
		Для Каждого СтрокаОбработчикаТН Из СтрокаОбработчика.Строки Цикл
			
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("Процедура", СтрокаОбработчикаТН.Процедура);
			ПараметрыПоиска.Вставить("НомерВЗ"	, СтрокаОбработчикаТН.НомерВЗ);
			
			ВыборкаВыполненныеОбработчикиТН.Сбросить();
			Если ВыборкаВыполненныеОбработчикиТН.НайтиСледующий(ПараметрыПоиска) Тогда
				СтрокиДляУдаления.Добавить(СтрокаОбработчикаТН);
			Иначе
				СтрокаОбработчикаТН.Версия = Версия;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрокиДляУдаления.Количество() > 0 Тогда
			
			Для Каждого ТекущаяСтрока Из СтрокиДляУдаления Цикл
				СтрокаОбработчика.Строки.Удалить(ТекущаяСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

