// Юдина Екатерина 22.01.2026 Выполнение задач №000056489
//
Процедура ЗаполнитьПрофилиГруппДоступаПоСоответствию(СоответствиеПрофилейИРолей) 
	
	Для Каждого Строка Из СоответствиеПрофилейИРолей Цикл
		
		Профиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(Строка.Ключ, Истина);  
		
		Если ЗначениеЗаполнено(Профиль) Тогда
			ПрофильОбъект = Профиль.ПолучитьОбъект();
			ОбъектИзменен = Ложь;		
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИдентификаторыОбъектовМетаданных.Ссылка КАК Роль
			|ИЗ
			|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
			|ГДЕ
			|	ИдентификаторыОбъектовМетаданных.ПолноеИмя В(&МассивРолей)
			|	И Не ИдентификаторыОбъектовМетаданных.ПометкаУдаления";
			
			Запрос.УстановитьПараметр("МассивРолей", Строка.Значение);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Если ПрофильОбъект.Роли.Найти(Выборка.Роль, "Роль") = Неопределено Тогда				
					НС = ПрофильОбъект.Роли.Добавить();
					НС.Роль = Выборка.Роль;   
					ОбъектИзменен = Истина;
				КонецЕсли;      
			КонецЦикла;
			
			Если ОбъектИзменен Тогда   
				Попытка
					ПрофильОбъект.Записать(); 
				Исключение  
					ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
						Метаданные.Справочники.ПрофилиГруппДоступа,,
						СтрШаблон("Ошибка при выполнении обработчика обновления тн_ОбновлениеИнформационнойБазы_ТН_Общий.ЗаполнитьПрофилиГруппыДоступаПоСоответствию: %1",
						ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
				КонецПопытки;				
			КонецЕсли;
			
		Иначе
			ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Информация, 
				Метаданные.Справочники.ПрофилиГруппДоступа,,
				СтрШаблон("При выполнении обработчика обновления тн_ОбновлениеИнформационнойБазы_ТН_Общий.ЗаполнитьПрофилиГруппыДоступаПоСоответствию не был найден профиль группы доступа %1."));
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

