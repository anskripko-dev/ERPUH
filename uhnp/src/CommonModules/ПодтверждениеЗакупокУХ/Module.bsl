				
#Область ПрограммныйИнтерфейс

Функция НоменклатураПотвержденияОбъемаЗакупок(Источник)  Экспорт  
	
	Если ТипЗнч(Источник) = ТипЗнч(Документы.ЗаказПоставщику.ПустаяСсылка()) Тогда
		Возврат ДанныеПодтвержденияОбъемаЗакупокПоСсылке(Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		Возврат ДанныеПодтвержденияОбъемаЗакупокПоОбъекту(Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура") И Источник.Свойство("Товары")  Тогда
		Возврат ДанныеПодтвержденияОбъемаЗакупокПоОбъекту(Источник);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ()

Процедура ОтразитьПодтвержденныеОбъемыЗакупок(ДополнительныеСвойства, Движения, Отказ) Экспорт

	ТаблицаПодтвержденныеОбъемыЗакупок = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПодтвержденныеОбъемыЗакупок;

	
	Если Отказ ИЛИ ТаблицаПодтвержденныеОбъемыЗакупок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ПодтвержденныеОбъемыЗакупок.Записывать = Истина;
	Движения.ПодтвержденныеОбъемыЗакупок.Загрузить(ТаблицаПодтвержденныеОбъемыЗакупок);
	
КонецПроцедуры

Функция ИмяПериода(Период, Периодичность) Экспорт

	Если Периодичность = Перечисления.Периодичность.Год Тогда
		Возврат Формат(Период,"Л=ru; ДФ='yyyy ""г.""'");
	ИначеЕсли Периодичность = Перечисления.Периодичность.Полугодие Тогда		
	    Возврат Формат(Период,"Л=ru; ДФ='ММ.гггг ""г.""'"); 
	ИначеЕсли Периодичность = Перечисления.Периодичность.Квартал Тогда		
	    Возврат Формат(Период,"Л=ru; ДФ='к ""квартал"" гггг ""г.""'");
    Иначе
	   	Возврат Формат(Период,"Л=ru; ДФ='MMMM гггг ""г.""'");
	КонецЕсли;

КонецФункции // ()

Процедура ДобавитьТекстЗапросаПодтвержденныеОбъемыЗакупок(ТекстыЗапроса) Экспорт
	
	ИмяРегистра = "ПодтвержденныеОбъемыЗакупок";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Ссылка КАК Ссылка,
	|	ДоговорНоменклатура.Номенклатура КАК Номенклатура,
	|	ДоговорНоменклатура.Организация КАК Организация,
	|	ДоговорНоменклатура.Количество КАК Законтрактовано,
	|	ДоговорНоменклатура.ДатаПоставки КАК Период,
	|	ДоговорНоменклатура.АналитикаПланирования.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	НастройкаПодтвержденияЗакупки.Периодичность КАК Периодичность,
	|	ДоговорНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДоговорНоменклатура.Характеристика КАК Характеристика,
	|	ДоговорНоменклатура.Коэффициент КАК Коэффициент
	|ИЗ
	|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВерсияСоглашенияКоммерческийДоговор.Номенклатура КАК ДоговорНоменклатура
	|		ПО ДоговорНоменклатура.АналитикаПланирования.АналитикаСтруктуры.ЦФО = НастройкаПодтвержденияЗакупки.ЦФО
	|			И (ДоговорНоменклатура.Номенклатура.КатегорияЗакупок = НастройкаПодтвержденияЗакупки.Номенклатура)
	|ГДЕ
	|	ДоговорНоменклатура.Ссылка = &Ссылка
	|	И ДоговорНоменклатура.Количество <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Ссылка,
	|	ДоговорНоменклатура.Номенклатура,
	|	ДоговорНоменклатура.Организация,
	|	ДоговорНоменклатура.Сумма,
	|	ДоговорНоменклатура.ДатаПоставки,
	|	ДоговорНоменклатура.АналитикаПланирования.АналитикаСтруктуры.ЦФО,
	|	НастройкаПодтвержденияЗакупки.Периодичность,
	|	ДоговорНоменклатура.ЕдиницаИзмерения,
	|	ДоговорНоменклатура.Характеристика,
	|	ДоговорНоменклатура.Коэффициент
	|ИЗ
	|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВерсияСоглашенияКоммерческийДоговор.Номенклатура КАК ДоговорНоменклатура
	|		ПО ДоговорНоменклатура.АналитикаПланирования.АналитикаСтруктуры.ЦФО = НастройкаПодтвержденияЗакупки.ЦФО
	|			И (ДоговорНоменклатура.Номенклатура = НастройкаПодтвержденияЗакупки.Номенклатура)
	|ГДЕ
	|	ДоговорНоменклатура.Ссылка = &Ссылка
	|	И ДоговорНоменклатура.Сумма <> 0";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

КонецПроцедуры

Функция ПериодПоПериодичности(Период, Периодичность) Экспорт
   	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Периоды.Ссылка КАК Ссылка,
		|	Периоды.Периодичность КАК Периодичность,
		|	Периоды.ДатаНачала КАК ДатаНачала
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.ДатаНачала = &ДатаНачала
		|	И Периоды.Периодичность = &Периодичность";
	
	Запрос.УстановитьПараметр("ДатаНачала", 	Период);
	Запрос.УстановитьПараметр("Периодичность", 	Периодичность);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	РезультатСсылка = Справочники.Периоды.ПустаяСсылка();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РезультатСсылка = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат РезультатСсылка;	

КонецФункции // ()

Функция ПолучитьТаблицуПодтвержденныеОбъемыЗакупок(ДокументСсылка)  Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
		|	ЗаказПоставщикуТовары.Количество КАК Запланировано,
		|	ЗаказПоставщикуТовары.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой
		|			ТОГДА ЗаказПоставщикуТовары.Ссылка.ДатаПоступления
		|		ИНАЧЕ ЗаказПоставщикуТовары.ДатаОтгрузки
		|	КОНЕЦ КАК Период,
		|	ЗаказПоставщикуТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	1 КАК Коэффициент,
		|	ЗаказПоставщикуТовары.АналитикаПланирования.АналитикаСтруктуры.ЦФО КАК ЦФО,
		|	ЗаказПоставщикуТовары.АналитикаПланирования.АналитикаСтруктуры.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|		ПО НастройкаПодтвержденияЗакупки.ЦФО = ЗаказПоставщикуТовары.АналитикаПланирования.АналитикаСтруктуры.ЦФО
		|			И НастройкаПодтвержденияЗакупки.Номенклатура = ЗаказПоставщикуТовары.Номенклатура.КатегорияЗакупок
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции // ()

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции
Функция ДанныеПодтвержденияОбъемаЗакупокПоСсылке(Источник)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
		|	ЗаказПоставщикуТовары.Номенклатура.КатегорияЗакупок КАК ТоварнаяКатегория,
		|	НастройкаПодтвержденияЗакупки.ЦФО КАК ЦФО,
		|	НастройкаПодтвержденияЗакупки.Периодичность КАК Периодичность,
		|	ВЫБОР  		
		|		КОГДА НЕ ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой И НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.ДатаОтгрузки, ГОД)
		|		КОГДА НЕ ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой и НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.ДатаОтгрузки, КВАРТАЛ)
		|		КОГДА НЕ ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой и НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.ДатаОтгрузки, МЕСЯЦ)  
		|		КОГДА ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой И НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.Ссылка.ДатаПоступления, ГОД) 
		|		КОГДА ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой и НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.Ссылка.ДатаПоступления, КВАРТАЛ)
		|		КОГДА ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой и НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.Ссылка.ДатаПоступления, МЕСЯЦ)  		
		|	КОНЕЦ КАК Период,
		|	ЗаказПоставщикуТовары.Количество КАК Количество,
		|	ЗаказПоставщикуТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	1 КАК Коэффициент,
		|	ЗаказПоставщикуТовары.ДатаОтгрузки КАК ДатаПоставки
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|		ПО ЗаказПоставщикуТовары.Номенклатура.КатегорияЗакупок = НастройкаПодтвержденияЗакупки.Номенклатура
		|			И ЗаказПоставщикуТовары.АналитикаИсточника.АналитикаСтруктуры.ЦФО = НастройкаПодтвержденияЗакупки.ЦФО
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Источник);
	
	РезультатЗапроса 		= Запрос.Выполнить();
	
	Возврат  РезультатЗапроса.Выгрузить();	
	
	
КонецФункции

Функция ДанныеПодтвержденияОбъемаЗакупокПоОбъекту(Источник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Выразить(ЗаказПоставщикуТовары.Номенклатура как Справочник.Номенклатура) КАК Номенклатура,
		|	ЗаказПоставщикуТовары.Количество КАК Количество,
		|	ЗаказПоставщикуТовары.ДатаПоступления КАК ДатаПоставки,
		|	Выразить(ЗаказПоставщикуТовары.АналитикаИсточника Как Справочник.КлючиАналитикПланирования) КАК АналитикаИсточника		
		|ПОМЕСТИТЬ ВТТовары
		|ИЗ
		|	&Товары КАК ЗаказПоставщикуТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
		|	ЗаказПоставщикуТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЗаказПоставщикуТовары.Номенклатура.КатегорияЗакупок КАК ТоварнаяКатегория,  
		|	1 КАК Коэффициент,
		|	НастройкаПодтвержденияЗакупки.ЦФО КАК ЦФО,
		|	НастройкаПодтвержденияЗакупки.Периодичность КАК Периодичность,
		|	ВЫБОР
		|		КОГДА НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.ДатаПоставки, ГОД)
		|		КОГДА НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.ДатаПоставки, КВАРТАЛ)
		|		КОГДА НастройкаПодтвержденияЗакупки.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.ДатаПоставки, МЕСЯЦ)
		|	КОНЕЦ КАК Период,
		|	ЗаказПоставщикуТовары.Количество КАК Количество,
		|	ЗаказПоставщикуТовары.ДатаПоставки КАК ДатаПоставки
		|ИЗ
		|	ВТТовары КАК ЗаказПоставщикуТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|		ПО ЗаказПоставщикуТовары.Номенклатура.КатегорияЗакупок = НастройкаПодтвержденияЗакупки.Номенклатура
		|			И ЗаказПоставщикуТовары.АналитикаИсточника.АналитикаСтруктуры.ЦФО = НастройкаПодтвержденияЗакупки.ЦФО";
	
	Запрос.УстановитьПараметр("Товары", Источник.Товары.Выгрузить());
	
	РезультатЗапроса 		= Запрос.Выполнить();
	
	Возврат  РезультатЗапроса.Выгрузить();	
	
КонецФункции
#КонецОбласти
