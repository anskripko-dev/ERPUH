// Функция создает команду формы
Функция СоздатьКоманду(Форма, ИмяКоманды, Заголовок, Действие, Картинка = Неопределено, Отображение = Неопределено) Экспорт
	
	Элементы = Форма.Элементы;
	Команды = Форма.Команды;
	
	Команда = Команды.Найти(ИмяКоманды);
	Если Команда = Неопределено Тогда
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Заголовок = Заголовок;
		Если Картинка <> Неопределено Тогда
			Команда.Картинка = Картинка;
			Команда.Отображение = ОтображениеКнопки.КартинкаИТекст;
		КонецЕсли;
		Команда.Действие = Действие;
	КонецЕсли;
	
	Возврат Команда;
	
КонецФункции

// Функция создает простые поля и кнопки формы
Функция СоздатьПоляКнопки(Форма, ИменаПолейКнопок, Родитель, ОбъектДляПолей = "Объект.", СобытияЭлемента = Неопределено) Экспорт
	
	Элементы = Форма.Элементы;
	Команды = Форма.Команды;
	
	Контекст = Форма;
	Если ЗначениеЗаполнено(ОбъектДляПолей) Тогда
		Путь = Лев(ОбъектДляПолей, СтрДлина(ОбъектДляПолей)-1);
		Контекст = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, Путь);
	КонецЕсли;
	
	СобытиеКоманды = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СобытияЭлемента, "ПриИзменении");
	ПараметрыЭлемента = Новый Структура("ОтображениеПодсказки", ОтображениеПодсказки.Кнопка);
	ПараметрыФлажка = Новый Структура("ОтображениеПодсказки, ПоложениеЗаголовка", 
		ОтображениеПодсказки.Кнопка, ПоложениеЗаголовкаЭлементаФормы.Право);
	
	ИменаЭлементов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаПолейКнопок, ",", Истина, Истина);
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		
		КомандаФормы = Форма.Команды.Найти(ИмяЭлемента);
		Если КомандаФормы = Неопределено Тогда
			
			ЗначениеЭлемента = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Контекст, ИмяЭлемента);
			Если ТипЗнч(ЗначениеЭлемента) = Тип("Булево") Тогда
				СоздатьПолеФормы(Элементы, ИмяЭлемента, , ОбъектДляПолей + ИмяЭлемента, ВидПоляФормы.ПолеФлажка, Родитель,, ПараметрыФлажка, СобытияЭлемента);
			Иначе 
				СоздатьПолеФормы(Элементы, ИмяЭлемента, , ОбъектДляПолей + ИмяЭлемента,, Родитель,, ПараметрыЭлемента, СобытияЭлемента);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
			
		Если СобытиеКоманды <> Неопределено Тогда
			КомандаФормы.Действие = СобытиеКоманды;			
		КонецЕсли;
		СоздатьКнопкуФормы(Элементы, ИмяЭлемента, , ИмяЭлемента, ВидКнопкиФормы.Гиперссылка, Родитель);
			
	КонецЦикла;
	
КонецФункции

// Функция создает свертываемую группу формы
// Параметры:
//  Элементы - ВсеЭлементыФормы
//
Функция СоздатьСвертываемуюГруппуФормы(Элементы, Имя, Заголовок = "", Вид = Неопределено, Родитель, ВставитьПередЭлементом = Неопределено, ПараметрыЭлемента = Неопределено, События = Неопределено) Экспорт
	
   	НоваяГруппа = СоздатьГруппуФормы(Элементы, Имя, Заголовок, Вид, Родитель, ВставитьПередЭлементом, ПараметрыЭлемента, События);
	НоваяГруппа.Отображение 			= ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.Группировка 			= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяГруппа.Поведение 				= ПоведениеОбычнойГруппы.Свертываемая;
	НоваяГруппа.ОтображениеУправления 	= ОтображениеУправленияОбычнойГруппы.Картинка;
	
	НоваяГруппа.Скрыть(); //свернем группу
	
	Возврат НоваяГруппа;
	
КонецФункции

// Функция создает группу формы
// Параметры:
//  Элементы - ВсеЭлементыФормы
//
Функция СоздатьСкрытуюГруппу(Элементы, Имя, ГруппировкаВертикально = Истина, Родитель, ВставитьПередЭлементом = Неопределено, ПараметрыЭлемента = Неопределено, События = Неопределено) Экспорт
	
	Группа = СоздатьГруппуФормы(Элементы, Имя,,, Родитель, ВставитьПередЭлементом, ПараметрыЭлемента);
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = Ложь;
	
	Если ГруппировкаВертикально = Истина Тогда
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ИначеЕсли ГруппировкаВертикально = Ложь Тогда
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;	
	КонецЕсли;	
	
	Возврат Группа;
	
КонецФункции

// Функция возвращает Истина, если элементы УХ на форму уже добавлены
