// Проверить существование реквизита формы, и если он отсутствует, создает
//  и добавляет его в массив ДобавляемыеРеквизиты.
//
// Параметры:
//  Форма - УправляемаяФорма - форма, для которой нужно проверить
//						  	существование реквизита.
//  ДобавляемыеРеквизиты - Массив - массив реквизитов формы, в который
//  						будет добавлен реквизит.
//  Имя - Строка - имя реквизита формы. 
//  ТипРеквизита - Строка | Массив(Тип) | ОписаниеТипов - описание типа
//							реквизита. Параметр будет передан в конструктор
//							объекта ОписаниеТипов.
//  Путь - Строка - Путь к создаваемому реквизиту. Не включает имя реквизита. 
//  Заголовок - Строка - заголовок. Если не указан, то будет использовано имя.
//  СохраняемыеДанные - Булево - Реквизит содержит сохраняемые данные.
//							Истина - сохраняемый реквизит формы.
//							Значение по умолчанию: Ложь.
//
Процедура СоздатьДобавитьРеквизитФормы(Форма,
								ДобавляемыеРеквизиты,
								Имя,
								ТипРеквизита,
								Путь="",
								Заголовок="",
								СохраняемыеДанные=Ложь) Экспорт
	РеквизитСуществует =
		ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
			Форма, Имя);
	Если НЕ РеквизитСуществует Тогда 
		ОписаниеТиповРеквизита = Новый ОписаниеТипов(ТипРеквизита);
		Реквизит = Новый РеквизитФормы(
			Имя, ОписаниеТиповРеквизита, Путь, Заголовок, СохраняемыеДанные);
		ДобавляемыеРеквизиты.Добавить(Реквизит);
	КонецЕсли;
КонецПроцедуры

Функция РазместитьВГруппе(Родитель, ПараметрыПолейВвода = неопределено) Экспорт
	Результат = Новый Структура("Размещение, Родитель, ПередЭлементом", "Родитель", Родитель);
	Результат.Вставить("ПараметрыПолейВвода", ?(ПараметрыПолейВвода=неопределено, Новый Структура, ПараметрыПолейВвода));
	Возврат Результат;
КонецФункции

Функция РазместитьПередЭлементом(Элемент, Родитель = "", ПараметрыПолейВвода = неопределено) Экспорт
	Результат = Новый Структура("Размещение, ПередЭлементом, Родитель", "ПередЭлементом", Элемент);
	Результат.ПередЭлементом = Элемент;
	Если ТипЗнч(Элемент) = Тип("Строка") Тогда
		Результат.Родитель = Родитель;
	Иначе
		Результат.Родитель = Элемент.Родитель;
	КонецЕсли;
	Результат.Вставить("ПараметрыПолейВвода", ?(ПараметрыПолейВвода=неопределено, Новый Структура, ПараметрыПолейВвода));
	Возврат Результат;
КонецФункции

Функция РазместитьВГруппеСтрокой(Родитель, ПараметрыПолейВвода = неопределено) Экспорт
	Результат = Новый Структура("Размещение, Родитель, ПередЭлементом", "Родитель");
	Если ТипЗнч(Родитель) = Тип("Строка") Тогда
		Результат.Родитель = Родитель;
	Иначе
		Результат.Родитель = Родитель.Имя;
	КонецЕсли;
	Результат.Вставить("ПараметрыПолейВвода", ?(ПараметрыПолейВвода=неопределено, Новый Структура, ПараметрыПолейВвода));
	Возврат Результат;
КонецФункции

Функция РазместитьПередЭлементомСтрокой(Элемент, Родитель = "", ПараметрыПолейВвода = неопределено) Экспорт
	Результат = Новый Структура("Размещение, ПередЭлементом, Родитель", "ПередЭлементом");
	Если ТипЗнч(Элемент) = Тип("Строка") Тогда
		Результат.ПередЭлементом = Элемент;
		Результат.Родитель = Родитель;
	Иначе
		Результат.ПередЭлементом = Элемент.Имя;
		Результат.Родитель = Элемент.Родитель.Имя;
	КонецЕсли;
	Результат.Вставить("ПараметрыПолейВвода", ?(ПараметрыПолейВвода=неопределено, Новый Структура, ПараметрыПолейВвода));
	Возврат Результат;
КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПараметрПоИмени(Массив, Имя)
	
	Поз = 0;
	Пока Поз < Массив.Количество() Цикл
		Параметр = Массив[Поз];
		Если Параметр.Имя = Имя Тогда
			Возврат Поз;
		КонецЕсли;
		Поз = Поз + 1;
	КонецЦикла;
	
	Возврат неопределено;
	
КонецФункции

#КонецОбласти

// 3.2

Процедура ОформитьЭлементыТаблицыФормы(ЭлементТаблицыФормы) Экспорт
	
	Для Каждого Элемент Из ЭлементТаблицыФормы.ПодчиненныеЭлементы Цикл
		ОформитьФонЭлементаПоПросмотру(Элемент);
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//    Элемент - ПолеФормы
Процедура ОформитьФонЭлементаПоПросмотру(Знач Элемент, Знач ТолькоПросмотр = Неопределено) Экспорт
	
	Если ТипЗнч(Элемент) <> Тип("ПолеФормы") Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.Вид = ВидПоляФормы.ПолеНадписи Тогда 
		Если Элемент.Вид = ВидПоляФормы.ПолеНадписи Тогда
			Если Элемент.Гиперссылка Тогда
				Элемент.ЦветТекста = ЦветаСтиля.ГиперссылкаЦвет;
				Элемент.Шрифт = Новый Шрифт(,,,, Истина);
			КонецЕсли;
			ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе
		ТолькоПросмотр = Элемент.ТолькоПросмотр;
	КонецЕсли;
	
	Элемент.ЦветФона = ? (ТолькоПросмотр, ЦветаСтиля.АльтернативныйЦветФонаПоля, ЦветаСтиля.ДобавленныйРеквизитФон);
	
КонецПроцедуры

Функция НачатьИзменениеРеквизитовФормы(Форма) Экспорт
	
	РеквизитыФормы = Новый Структура;
	РеквизитыФормы.Вставить("Добавляемые",	Новый Массив);  
	РеквизитыФормы.Вставить("Удаляемые", 	Новый Массив);  
	
	Возврат РеквизитыФормы;

КонецФункции

Процедура ЗавершитьИзменениеРеквизитовФормы(Форма, РеквизитыФормы) Экспорт
	
	Если РеквизитыФормы.Добавляемые.Количество() > 0 
		ИЛИ РеквизитыФормы.Удаляемые.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(РеквизитыФормы.Добавляемые, РеквизитыФормы.Удаляемые);
	КонецЕсли; 
	
КонецПроцедуры