//Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
Функция ПолучитьНДСИзСтроки(СтрокаНДС) Экспорт
	
	Если СтрокаНДС = "БезНДС" Тогда
		Возврат Справочники.СтавкиНДС.БезНДС;
	КонецЕсли;
	
	ЧислоНДС = СтрЗаменить(СтрокаНДС, "НДС", "");
	// НАЧАЛО Борисенко Игорь 29.07.2022 Выполнение задач №000042100: вместо "0%" подбирает "БезНДС"
	//НДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка",ТолькоЦифры(ЧислоНДС));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЧислоНДС", ТолькоЦифры(ЧислоНДС));
	Запрос.УстановитьПараметр("ЕстьСлеш", СтрНайти(СтрокаНДС, "/") > 0);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтавкиНДС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Ставка = &ЧислоНДС
	|	И СтавкиНДС.Ссылка <> ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС)
	|	И ВЫБОР
	|			КОГДА &ЕстьСлеш
	|				ТОГДА СТРНАЙТИ(СтавкиНДС.Наименование, ""/"") > 0
	|			ИНАЧЕ СТРНАЙТИ(СтавкиНДС.Наименование, ""/"") = 0
	|		КОНЕЦ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НДС = Выборка.Ссылка;
	Иначе
		НДС = Неопределено;
	КонецЕсли;
	
	// КОНЕЦ Борисенко Игорь 29.07.2022 Выполнение задач №000042100
	Если ЗначениеЗаполнено(НДС) Тогда
		Возврат НДС;
	Иначе
		Возврат Справочники.СтавкиНДС.БезНДС;
	КонецЕсли;
	
КонецФункции

