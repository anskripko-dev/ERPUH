		//ИндексXfs = 0;
		//ОбработкаХМЛ(ПапкаOpenXML+"\xl\styles.xml","styles",ИндексXfs);
		//
		////Связываем ясейки с нужным стилем (форматом) и преобразовываем их содержание
		//ОбработкаХМЛ(ПапкаOpenXML + "\xl\worksheets\sheet1.xml","sheet1",ИндексXfs);
		
		//Собираем все форматы из файла
		СписокФорматов = СобратьФорматыИзФайла(ПапкаOpenXML);
		
