// Борисенко Игорь 16.04.2025 Выполнение задач №000053436
Процедура ВырезатьФорматИзСтроки(Элемент_si)
	
	Текст = Элемент_si.ТекстовоеСодержимое;
	позФормат = СтрНайти(НРег(Текст), "формат") - 1;
	Если позФормат > 0 Тогда
		Элемент_si.ТекстовоеСодержимое = СокрЛП(Лев(Текст, позФормат));
	КонецЕсли;
	
КонецПроцедуры

// Белоконенко Денис 20.10.2025 Выполнение задач №000055268
Функция ПолучитьФорматИзСтроки(Текст)
	
	позФормат = СтрНайти(НРег(Текст), "формат");
	
	ТекстПослеФормат = "";
	
	Если позФормат > 0 Тогда
			
		//Вырезаем часть после слова "формат"
		ТекстПослеФормат = Сред(Текст, позФормат + 6); // +6 = длина "формат"
		ТекстПослеФормат = СокрЛП(ТекстПослеФормат);
	КонецЕсли;	
	
	Возврат ТекстПослеФормат;
	
КонецФункции

// Борисенко Игорь 16.04.2025 Выполнение задач №000053436
Функция ПоучитьЧислоЕксель(Дата)
	
	Возврат ((Дата-'19000101000000')/86400) + 2;
	
КонецФункции	

// Белоконенко Денис 20.10.2025 Выполнение задач №000055268
Функция СобратьФорматыИзФайла(ПапкаOpenXML)
	
	СписокФорматов = Новый Массив;
	
	//Читаем sharedStrings чтобы найти все форматы
	ПолныйПуть = ПапкаOpenXML + "\xl\sharedStrings.xml";
		
	ОбъектXML = Новый ЧтениеXML;
	ОбъектXML.ОткрытьФайл(ПолныйПуть);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ОбъектXML);
	ОбъектXML.Закрыть();
	
	Элементы_si = ДокументDOM.ПолучитьЭлементыПоИмени("si");
	
	Для Каждого Элемент_si Из Элементы_si Цикл
		
		Формат = ПолучитьФорматИзСтроки(Элемент_si.ТекстовоеСодержимое);
					
		//Добавляем в список, если формат не пустой
		Если Формат <> "" Тогда
			СписокФорматов.Добавить(Формат);
		КонецЕсли;
					
	КонецЦикла;
	
	СписокФорматов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокФорматов);
	
	Возврат СписокФорматов;
	
КонецФункции

//Блинова М.А. 23.11.2025 Выполнение задач №000055915
Функция СделатьЗапросРазрешенным(Текст) Экспорт
	
	НовыйТекст = Текст;

    ПозицияНайти = Найти(нРег(НовыйТекст), "разрешенные");
    Пока ПозицияНайти > 0 Цикл
        //удаляем найденные разрешенные
        НовыйТекст = Лев(НовыйТекст, ПозицияНайти - 1) + Сред(НовыйТекст, ПозицияНайти + 11);
        
        ПозицияНайти = Найти(нРег(НовыйТекст), "разрешенные");
    КонецЦикла;
		
	ПозицияВыбрать = Найти(нРег(НовыйТекст), "выбрать");
		
	Если ПозицияВыбрать > 0 Тогда
		ЗаменяющаяСтрока = Лев(НовыйТекст, ПозицияВыбрать + СтрДлина("выбрать") - 1) + " Разрешенные" + Сред(НовыйТекст, ПозицияВыбрать + СтрДлина("выбрать"));
		Возврат ЗаменяющаяСтрока;
	Иначе
		Возврат Текст;
	КонецЕсли;
	
КонецФункции
