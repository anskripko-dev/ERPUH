// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Функция ДатаВходитВПериод(ПроверяемаяДата, ДатаНачала, ДатаОкончания) Экспорт 
	
	РезультатПроверки = Истина;
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		Если ПроверяемаяДата < НачалоДня(ДатаНачала) Тогда
			РезультатПроверки = Ложь;
		КонецЕсли; 
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		Если ПроверяемаяДата > КонецДня(ДатаОкончания) Тогда
			РезультатПроверки = Ложь;
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат РезультатПроверки; 
	
КонецФункции 

// Юдина Екатерина 03.04.2026 Выполнение задач №000057268
//
Функция ПреобразоватьМассивВТаблицуЗначений(МассивДанных) Экспорт
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	
	Для Каждого ЭлементМассива Из МассивДанных Цикл
		Если ТаблицаДанных.Колонки.Количество() = 0 Тогда
			Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
				ТаблицаДанных.Колонки.Добавить(ЗначениеСтруктуры.Ключ);
			КонецЦикла;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДанных.Добавить();
		Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
			НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаДанных;   
	
КонецФункции

