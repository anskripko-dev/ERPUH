////Качикина 07.10.2024 Выполнение задач №000051011
//Процедура ДобавитьКнопкуИКомандуНаФорму(Элементы, Команды, ИмяКоманды, Заголовок) Экспорт
Процедура ДобавитьКнопкуИКомандуНаФорму(Элементы, Команды, ИмяКоманды, Заголовок, ЭлементРодитель = Неопределено) Экспорт
	 
	Команда			  = Команды.Добавить(ИмяКоманды); 
