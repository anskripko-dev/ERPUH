// Белоконенко Денис 28.02.2024 Выполнение задач №000048653
Функция ПолучитьПоследнийАвансовыйСФ(Документ) Экспорт
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		ДокументОснование = Документ.ДокументОснование;
	Иначе
		ДокументОснование = Документ;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СчетФактураВыданныйАванс.Ссылка.НомерИсправления КАК НомерИсправления,
		|	СчетФактураВыданныйАванс.ДокументОснование КАК ДокументОснование,
		|	СчетФактураВыданныйАванс.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СчетФактураВыданныйАванс КАК СчетФактураВыданныйАванс
		|ГДЕ
		|	СчетФактураВыданныйАванс.ДокументОснование = &ДокументОснование
		|	И СчетФактураВыданныйАванс.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерИсправления УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Документы.СчетФактураВыданныйАванс.ПустаяСсылка(); 
	КонецЕсли;
	
КонецФункции

