// Иванов ВЮ (Код-Эксперт) 16.04.2025 Выполнение задач №000053434
Процедура ЗаполнитьРеквизит_тн_НалогообложениеНДС(Источник, Отказ, Замещение)
	
	//НАЧАЛО Сафиуллина З.Р. 09.09.2025 Выполнение задач №000055076
	Если Источник.ОбменДанными.Загрузка = Ложь Тогда
		Возврат;
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 09.09.2025 Выполнение задач №000055076
	
	МетаданныеОбъекта = Источник.Метаданные();
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.СчетФактураПолученный") Тогда
		
		// Значение реквизита усланавливаем из договора контрагента, из "НалогообложениеНДС" или "ЗакупкаПодДеятельность":
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Договор", МетаданныеОбъекта)
			И ЗначениеЗаполнено(Источник.Договор)
			И НЕ Источник.Договор.ПолучитьОбъект() = Неопределено Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник.Договор, "НалогообложениеНДС") Тогда
				Источник.тн_НалогообложениеНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Договор, "НалогообложениеНДС");
			ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник.Договор, "ЗакупкаПодДеятельность") Тогда
				Источник.тн_НалогообложениеНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Договор, "ЗакупкаПодДеятельность");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//Блинова М.А. 23.11.2023 Выполнение задач №000047251
Процедура тн_ЗаписатьДобавленныеДокументыПоСтаройАрхитектуреВзаиморасчетов(Источник, Отказ, Замещение) Экспорт   
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// проверка наличия регистатора
	ИсточникМетаданные = Источник.Метаданные();
	Если Не ОбщегоНазначения.ЭтоРегистрНакопления(ИсточникМетаданные)	Тогда
		Возврат;
	КонецЕсли;
	
   СтараяАрхитектураВзаиморасчетов = Константы.НеНоваяАрхитектураВзаиморасчетов.Получить(); 
   НоваяАрхитектураВзаиморасчетов = Константы.НоваяАрхитектураВзаиморасчетов.Получить();
   Если НоваяАрхитектураВзаиморасчетов И НЕ СтараяАрхитектураВзаиморасчетов  Тогда
	   Возврат;
   КонецЕсли;
   
   ДобавляемыйДокумент = Источник.Отбор.Регистратор;
   НаборЗаписей = РегистрыСведений.тн_ДобавленныеДокументыПоСтаройАрхитектуреВзаиморасчетов.СоздатьНаборЗаписей();
   НаборЗаписей.Отбор.ДокументВзаиморасчетов.Установить(ДобавляемыйДокумент.Значение);
   НаборЗаписей.Прочитать();
   Если НаборЗаписей.Количество() = 0 Тогда
	    НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДокументВзаиморасчетов = ДобавляемыйДокумент.Значение;
   КонецЕсли;
  НаборЗаписей.Записать();
   
КонецПроцедуры	

