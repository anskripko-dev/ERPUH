Функция ЯвляетсяОбъектомЦБ(Ссылка) Экспорт
	
	МетаданныеСправочника = Ссылка.Метаданные();
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("тн_ЯвляетсяОбъектомЦБ", МетаданныеСправочника) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "тн_ЯвляетсяОбъектомЦБ") = Истина; 
	ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("ЯвляетсяОбъектомЦБ", МетаданныеСправочника) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ЯвляетсяОбъектомЦБ") = Истина; 
	Иначе
		Возврат Ложь;
	КонецЕсли;  
	
КонецФункции

// Юдина Екатерина 04.12.2025 Выполнение задач №000056034
//
// Процедура устанавливает доступность элементов формы для федеральных элементов справочника   
//
Процедура ДоступностьЭлементовФормы(Форма, Ссылка, ОсновнойРеквизитФормы = "Объект") Экспорт
		
	Если ЯвляетсяОбъектомЦБ(Ссылка) Тогда
		
		Запрос = Новый Запрос;                         
		ИмяОбъектаМетаданных = Ссылка.Метаданные().Имя;
		Запрос.УстановитьПараметр("ИмяОбъектовМетаданных", "Справочник." + ИмяОбъектаМетаданных);
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПравилаИнтеграционнойСхемыРеквизитыСхем.ИмяТаблицы КАК ИмяТаблицы,
		|	ПравилаИнтеграционнойСхемыРеквизитыСхем.ИмяРеквизита КАК ИмяРеквизита
		|ИЗ
		|	Справочник.тн_ПравилаИнтеграционнойСхемы КАК ПравилаИнтеграционнойСхемы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.тн_ПравилаИнтеграционнойСхемы.РеквизитыСхем КАК ПравилаИнтеграционнойСхемыРеквизитыСхем
		|		ПО ПравилаИнтеграционнойСхемы.Ссылка = ПравилаИнтеграционнойСхемыРеквизитыСхем.Ссылка
		|ГДЕ
		|	ПравилаИнтеграционнойСхемы.ИмяОбъектовМетаданных = &ИмяОбъектовМетаданных
		|	И НЕ ПравилаИнтеграционнойСхемыРеквизитыСхем.РазрешенаПравка
		|	И НЕ ПравилаИнтеграционнойСхемы.ПометкаУдаления";
				
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда 
			
			Элементы = Форма.Элементы;
			
			ТаблицаСоответствийРеквизитовФормыиРеквизитовОбъектов = Новый ТаблицаЗначений;
			ТаблицаСоответствийРеквизитовФормыиРеквизитовОбъектов.Колонки.Добавить("ИмяРеквизитаФормы");
			ТаблицаСоответствийРеквизитовФормыиРеквизитовОбъектов.Колонки.Добавить("ИмяРеквизитаОбъекта");
						
			Для Каждого Элемент Из Элементы Цикл
				
				Если ТипЗнч(Элемент) = Тип("ПолеФормы") 
					И ЗначениеЗаполнено(Элемент.ПутьКДанным) Тогда
					НоваяСтрокаТЗ = ТаблицаСоответствийРеквизитовФормыиРеквизитовОбъектов.Добавить();
					НоваяСтрокаТЗ.ИмяРеквизитаФормы = Элемент.Имя;
					НоваяСтрокаТЗ.ИмяРеквизитаОбъекта = Элемент.ПутьКДанным;
				КонецЕсли;
				
			КонецЦикла; 
			
			ПрефиксПутиКДанным = ОсновнойРеквизитФормы + ?(ЗначениеЗаполнено(ОсновнойРеквизитФормы),".","");
			
			Результат = РезультатЗапроса.Выбрать();
			
			Пока Результат.Следующий() Цикл
				
				// Проверяем реквизиты объекта
				Отбор = Новый Структура;    				
				Отбор.Вставить("ИмяРеквизитаОбъекта", ПрефиксПутиКДанным + Результат.ИмяРеквизита);
				
				НайденныеСтрокиСоответствий = ТаблицаСоответствийРеквизитовФормыиРеквизитовОбъектов.НайтиСтроки(Отбор);
				
				Для Каждого Строка Из НайденныеСтрокиСоответствий Цикл 
					
					Попытка
						Элементы[Строка.ИмяРеквизитаФормы].ТолькоПросмотр = Истина;
					Исключение
						Элементы[Строка.ИмяРеквизитаФормы].Доступность = Ложь;
					КонецПопытки;
					
				КонецЦикла;
				
				// Проверяем реквизиты формы
				Отбор = Новый Структура;    				
				Отбор.Вставить("ИмяРеквизитаОбъекта", Результат.ИмяРеквизита);
				
				НайденныеСтрокиСоответствий = ТаблицаСоответствийРеквизитовФормыиРеквизитовОбъектов.НайтиСтроки(Отбор);
				
				Для Каждого Строка Из НайденныеСтрокиСоответствий Цикл 
					
					Попытка
						Элементы[Строка.ИмяРеквизитаФормы].ТолькоПросмотр = Истина;
					Исключение
						Элементы[Строка.ИмяРеквизитаФормы].Доступность = Ложь;
					КонецПопытки;
					
				КонецЦикла; 
				
				// Проверяем реквизиты формы  
				Если ОсновнойРеквизитФормы <> "Объект" Тогда   
					
					Отбор = Новый Структура;    				
					Отбор.Вставить("ИмяРеквизитаОбъекта", ОсновнойРеквизитФормы + Результат.ИмяРеквизита);
					
					НайденныеСтрокиСоответствий = ТаблицаСоответствийРеквизитовФормыиРеквизитовОбъектов.НайтиСтроки(Отбор);
					
					Для Каждого Строка Из НайденныеСтрокиСоответствий Цикл 
						
						Попытка
							Элементы[Строка.ИмяРеквизитаФормы].ТолькоПросмотр = Истина;
						Исключение
							Элементы[Строка.ИмяРеквизитаФормы].Доступность = Ложь;
						КонецПопытки;
						
					КонецЦикла;  
					
				КонецЕсли;
			
			КонецЦикла;	
			
		КонецЕсли;  
		
	КонецЕсли;    
	
	// НАЧАЛО Юдина Екатерина 03.03.2026 Выполнение задач №000056915
	ИмяРеквизитаЯвляетсяОбъектомЦБ = "";
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("тн_ЯвляетсяОбъектомЦБ", Ссылка.Метаданные()) Тогда
		ИмяРеквизитаЯвляетсяОбъектомЦБ = "тн_ЯвляетсяОбъектомЦБ";
	ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("тн_ЯвляетсяОбъектомЦБ", Ссылка.Метаданные()) Тогда 
		ИмяРеквизитаЯвляетсяОбъектомЦБ = "ЯвляетсяОбъектомЦБ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРеквизитаЯвляетсяОбъектомЦБ) Тогда
		Попытка
			Форма.Элементы[ИмяРеквизитаЯвляетсяОбъектомЦБ].ТолькоПросмотр = Истина; 
		Исключение
		КонецПопытки;
	КонецЕсли;	
    // КОНЕЦ Юдина Екатерина 03.03.2026 Выполнение задач №000056915
	
КонецПроцедуры

