	Результат = Новый Структура("Адрес, Ошибка", "", "");
	
	Попытка
		
		//Получаем исходный файл с клиента
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
		ПутьКФайлуСервер = ПолучитьИмяВременногоФайла("xml"); 
