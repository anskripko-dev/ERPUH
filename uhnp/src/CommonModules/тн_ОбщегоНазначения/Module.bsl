// Ситалов Дмитрий 16.03.2023 Выполнение задач №000044812
// очистка движений, если в документе установлен признак тн_НеОтражатьВРегУчете
Процедура тн_ПередЗаписьюДвиженийПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// проверка наличия регистатора
	ИсточникМетаданные = Источник.Метаданные();
	Если Не (ОбщегоНазначения.ЭтоРегистрНакопления(ИсточникМетаданные)
		Или ОбщегоНазначения.ЭтоРегистрСведений(ИсточникМетаданные) 
			И ИсточникМетаданные.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору)
	Тогда
		Возврат;
	КонецЕсли;
	
	ТипыДокументовДляПроверки = Новый Массив;
	ТипыДокументовДляПроверки.Добавить(Тип("ДокументСсылка.ВзаимозачетЗадолженности"));
	ТипыДокументовДляПроверки.Добавить(Тип("ДокументСсылка.КорректировкаЗадолженности"));
	
	Регистратор = Источник.Отбор.Регистратор.Значение;
	Если ТипыДокументовДляПроверки.Найти(ТипЗнч(Регистратор)) <> Неопределено Тогда
		
		тн_НеОтражатьВРегУчете = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "тн_НеОтражатьВРегУчете");
		Если тн_НеОтражатьВРегУчете = Истина Тогда
			Источник.Очистить();
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

