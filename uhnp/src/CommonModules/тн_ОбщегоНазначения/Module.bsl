//Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
Функция ТолькоЦифры(Строка)
	
	НоваяСтрока = "";
	
	Для сч = 1 по СтрДлина(Строка) Цикл
		А = Прав(Лев(Строка,сч),1);
		Если СтрНайти("0123456789",А,НаправлениеПоиска.СНачала,1,1) > 0 Тогда
			НоваяСтрока = НоваяСтрока + А;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ?(НоваяСтрока = "",0,Число(НоваяСтрока));
	
КонецФункции

// Османов Нагим 26.04.2022 Выполнение задач №000041051
//
//Описание функции.
//
// Параметры
//  ФизическоеЛицо  – СправочникСсылка.ФизическиеЛица – физическое лицо, по которому
//                 необходимо получить подразделение
//  Организация  – СправочникСсылка.Организации – Организация, в которой ищется сотрудник по физическому лицу
//                 Если Неопределено, то подставляется организация по умолчанию
//
// Возвращаемое значение:
//   Подразделение - СправочникСсылка.СтруктураПредприятия
//
Функция ПолучитьПодразделениеПоФизическомуЛицу(ФизическоеЛицо, Организация = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	НайденноеПодразделение = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТекущиеКадровыеДанныеСотрудников.тнПодразделение КАК Подразделение
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|ГДЕ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизическоеЛицо
	|	И ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1)
	|	И (ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация = &Организация
	|			ИЛИ ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация = &Организация)";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			НайденноеПодразделение = Выборка.Подразделение;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НайденноеПодразделение;
	
КонецФункции // ПолучитьПодразделениеПоФизическомуЛицу()

// Белоконенко Денис 25.07.2022 Выполнение задач №000042024
Функция ПолучитьПользователяПоНомеруЕКСФизЛица(НомерЕКС) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ПО Пользователи.ФизическоеЛицо = ФизическиеЛица.Ссылка
		|ГДЕ
		|	ФизическиеЛица.тн_ЕКС = &НомерЕКС";
	
	Запрос.УстановитьПараметр("НомерЕКС", НомерЕКС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;	
КонецФункции

// Гутарова Екатерина 23.11.2022 Выполнение задач №000043427
//
// Получает данные по физическому лицу из регистра "Текущие кадровые данные сотрудников".
//
// Параметры:
//  ФизическоеЛицо  – СправочникСсылка.ФизическиеЛица – физическое лицо, по которому
//                 необходимо получить данные
//  Организация  – СправочникСсылка.Организации – Организация, в которой ищется сотрудник по физическому лицу
//                 Если Неопределено, то подставляется организация по умолчанию 
//  Ключ  – Строка – Необходимые к получению данные из регистра "Текущие кадровые данные сотрудников".
//  Например: "Организация, Подразделение"
//
// Возвращаемое значение:
//   РезультатСтруктура - Структура
//
Функция ПолучитьДанныеФизЛица(ФизическоеЛицо, Организация = Неопределено, Ключ = "ТекущаяДолжность") Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	РезультатСтруктура = Новый Структура(Ключ,);    
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|ГДЕ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизическоеЛицо
	|	И ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РезультатСтруктура, Выборка);	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатСтруктура;
	
КонецФункции 

// Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
//
Функция ЭтоТабличныйОбъект(ИмяОбъектаМетаданных) Экспорт
	
	МассивТабличныхОбъектов = Новый Массив;
	МассивТабличныхОбъектов.Добавить("РегистрСведений");
	МассивТабличныхОбъектов.Добавить("РегистрНакопления");
	МассивТабличныхОбъектов.Добавить("РегистрБухгалтерии");
	МассивТабличныхОбъектов.Добавить("РегистрРасчета");
	
	ТипОбъектаМетаданных = Лев(ИмяОбъектаМетаданных, СтрНайти(ИмяОбъектаМетаданных, ".") - 1);
	
	Возврат Не МассивТабличныхОбъектов.Найти(ТипОбъектаМетаданных) = Неопределено;
	
КонецФункции    

// Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
//
Функция ПолучитьМассивПолейБлокировокТабличногоОбъекта(ИмяОбъектаМетаданных) Экспорт
	
	МассивПолейБлокировок = Новый Массив;    
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяОбъектаМетаданных);
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат МассивПолейБлокировок;
	КонецЕсли;
	
	Если Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта) Тогда 
		МассивПолейБлокировок = ПолучитьМассивПолейБлокировокРегистраСведений(МетаданныеОбъекта);
	Иначе
		МассивПолейБлокировок = ПолучитьМассивПолейБлокировокПодчиненныхРегистров(МетаданныеОбъекта);			
	КонецЕсли;  
	
	Возврат МассивПолейБлокировок;
	
КонецФункции       

// Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
//
Функция ПолучитьМассивПолейБлокировокРегистраСведений(МетаданныеОбъекта)
	
	МассивПолейБлокировок = Новый Массив;
	
	Если МетаданныеОбъекта.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		МассивПолейБлокировок.Добавить("Регистратор");	
		Возврат МассивПолейБлокировок;
	КонецЕсли;
	
	Если Не МетаданныеОбъекта.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический 
		И МетаданныеОбъекта.ОсновнойОтборПоПериоду Тогда
		МассивПолейБлокировок.Добавить("Период");	
	КонецЕсли;                                   
	
	Для Каждого ИзмерениеРегистра Из МетаданныеОбъекта.Измерения Цикл
		
		Если ИзмерениеРегистра.ОсновнойОтбор Тогда
			МассивПолейБлокировок.Добавить(ИзмерениеРегистра.Имя);	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивПолейБлокировок;
	
КонецФункции

// Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
//
Функция ПолучитьМассивПолейБлокировокПодчиненныхРегистров(МетаданныеОбъекта)
	
	МассивПолейБлокировок = Новый Массив;
	МассивПолейБлокировок.Добавить("Регистратор");	

	Возврат МассивПолейБлокировок;
	
КонецФункции

