//Блинова М.А. 27.11.2023 Выполнение задач №000047564
Функция ПолучитьРуководителяПодразделенияОрганизации(ПодразделениеОрганизации, ДатаДокумента) Экспорт
	
	ДанныеРуководителя = Новый Структура();
	РегистрацияВФНС = Справочники.ПодразделенияОрганизаций.РегистрацияВНалоговомОргане(ПодразделениеОрганизации, ДатаДокумента);
	
	Если НЕ РегистрацияВФНС = Неопределено Тогда 
		ДанныеРуководителяВФНС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РегистрацияВФНС, "Представитель, УполномоченноеЛицоПредставителя, ДокументПредставителя"); 
		Если НЕ ЗначениеЗаполнено(ДанныеРуководителяВФНС.Представитель) Тогда
			ДанныеРуководителя.Вставить("Руководитель", Справочники.ФизическиеЛица.ПустаяСсылка());
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке("Для подразделения организации не указан руководитель.");
		ИначеЕсли ТипЗнч(ДанныеРуководителяВФНС.Представитель) = Тип("СправочникСсылка.ФизическиеЛица") 
			Или НЕ ЗначениеЗаполнено(ДанныеРуководителяВФНС.УполномоченноеЛицоПредставителя) Тогда
			
			ДанныеРуководителя.Вставить("Руководитель", ДанныеРуководителяВФНС.Представитель);
		ИначеЕсли ТипЗнч(ДанныеРуководителяВФНС.Представитель) = Тип("СправочникСсылка.Контрагенты") Тогда
			ДанныеРуководителя.Вставить("Руководитель", ДанныеРуководителяВФНС.УполномоченноеЛицоПредставителя);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеРуководителяВФНС.ДокументПредставителя) Тогда 
			ДанныеРуководителя.Вставить("Должность",	"");
			ДанныеРуководителя.Вставить("Доверенность", "");
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке("Для подразделения организации не указаны должность руководителя и данные доверенности.");
		Иначе
			ДанныеДоверенности = ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(ДанныеРуководителяВФНС.ДокументПредставителя, Символы.ПС);
			
			Если ДанныеДоверенности.Количество() = 1 Тогда 
				ДанныеРуководителя.Вставить("Доверенность", ДанныеДоверенности[0]);
				ДанныеРуководителя.Вставить("Должность",	"");
				
				ОбщегоНазначенияУХ.СообщитьОбОшибке("Для подразделения организации не указана должность руководителя");
			ИначеЕсли ДанныеДоверенности.Количество() > 1 Тогда 
				ДанныеРуководителя.Вставить("Доверенность", ДанныеДоверенности[0]);
				ДанныеРуководителя.Вставить("Должность",	ДанныеДоверенности[1]);
			КонецЕсли;
		КонецЕсли;
		
		Возврат ДанныеРуководителя;
	Иначе 
		ДанныеРуководителя.Вставить("Руководитель", Справочники.ФизическиеЛица.ПустаяСсылка());
		ОбщегоНазначенияУХ.СообщитьОбОшибке("В документе не указано подразделение организации, невозможно найти данные для руководителя и доверенности");
		Возврат ДанныеРуководителя;
	КонецЕсли;
	
КонецФункции

