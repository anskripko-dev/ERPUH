//Качикина 04.10.2024 Выполнение задач №000050874
Процедура ПометитьНаУдалениеДокументСозданныйПоСхеме(ДокументСсылка,СхемаФормированияДокументов) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	тн_РезультатыАвтоматическогоФормированияДокументов.СформированныйДокумент КАК СформированныйДокумент
	               |ИЗ
	               |	РегистрСведений.тн_РезультатыАвтоматическогоФормированияДокументов КАК тн_РезультатыАвтоматическогоФормированияДокументов
	               |ГДЕ
	               |	тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор = &ДокументИнициатор";
	Запрос.УстановитьПараметр("ДокументИнициатор",ДокументСсылка);
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл 
		СформированныйДокумент = Результат.СформированныйДокумент; 
		Если ЗначениеЗаполнено(СформированныйДокумент) И НЕ СформированныйДокумент.ПометкаУдаления Тогда
			Попытка
				СформированныйДокументОбъект = СформированныйДокумент.ПолучитьОбъект(); 
				СформированныйДокументОбъект.УстановитьПометкуУдаления(Истина);
			Исключение 
				стрОписание = "Не удалось пометить на удаление документ "+ Строка(СформированныйДокумент)
								+" (документ инициатор "+Строка(ДокументСсылка)
								+", схема формирования документов "+Строка(СхемаФормированияДокументов)+")";
				ЗаписьЖурналаРегистрации("Создание документов по схемам формирования документов", УровеньЖурналаРегистрации.Ошибка, , , стрОписание);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Юдина (Гутарова) Екатерина 23.08.2024 Выполнение задач №000050605 
//
Функция НайтиНаибольшуюНаименьшуюДатуМассива(Массив, ИскатьНаибольшуюДату = Ложь) Экспорт 
	
	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;  
	
	ИскомаяДата = Массив[0].Дата;
	Для Каждого Элемент Из Массив Цикл  
		Если Не ИскатьНаибольшуюДату Тогда
			Если Элемент.Дата < ИскомаяДата Тогда
				ИскомаяДата = Элемент.Дата;
			КонецЕсли;
		Иначе   
			Если Элемент.Дата > ИскомаяДата Тогда
				ИскомаяДата = Элемент.Дата;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ИскомаяДата;
	
КонецФункции   

// Юдина (Гутарова) Екатерина 25.09.2024 Выполнение задач №000050931
//
Процедура ВывестиКолонкуСНомерамиСчетов(ТабДок, КодСтроки, КодКолонки, СтрокаНачала) Экспорт 
	
	ТабДок.ВставитьОбласть(ТабДок.Область(КодКолонки), ТабДок.Область(КодКолонки), 
	ТипСмещенияТабличногоДокумента.ПоГоризонтали);	  
	
	ТабДок.Область(КодСтроки + КодКолонки).Текст = "Номер счета";   
	ТабДок.Область(КодСтроки + КодКолонки).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	ТабДок.Область(КодКолонки).ШиринаКолонки = 8;
	
	Для НомерСтроки = СтрокаНачала По ТабДок.ВысотаТаблицы Цикл    
		
		ТекстПоиска = ТабДок.Область("R"+ СтрЗаменить(НомерСтроки, Символы.НПП, "") + КодКолонки).Текст;   
		
		СтрокаОтчета = Справочники.СтрокиОтчетов.НайтиПоНаименованию(ТекстПоиска, Истина);
		
		Если ЗначениеЗаполнено(СтрокаОтчета) Тогда 
			
			НачалоКода = СтрНайти(СтрокаОтчета.Код, "_");
			КонецКода = СтрНайти(СтрокаОтчета.Код, "_", , , 2);  
			Код = Сред(СтрокаОтчета.Код, НачалоКода + 1, ?(ЗначениеЗаполнено(КонецКода), КонецКода - (НачалоКода + 1), СтрДлина(СтрокаОтчета.Код)));
			
			Если Не ЕстьЦифрыВСтроке(Код) Тогда
				Код = ""; 
			КонецЕсли;        		
			
			ТабДок.Область("R"+ СтрЗаменить(НомерСтроки, Символы.НПП, "") + КодКолонки).Текст = Код;   
		Иначе
			ТабДок.Область("R"+ СтрЗаменить(НомерСтроки, Символы.НПП, "") + КодКолонки).Текст = "";   
		КонецЕсли;
		
	КонецЦикла;  
	
КонецПроцедуры 
 
// Юдина (Гутарова) Екатерина 25.09.2024 Выполнение задач №000050931
//
Функция ЕстьЦифрыВСтроке(Строка) Экспорт
	
	СтрокаБезЦифр = СтрСоединить(СтрРазделить(Строка, "0123456789", Ложь), "");
	Возврат СтрДлина(Строка) <> СтрДлина(СтрокаБезЦифр);
	
КонецФункции

