Процедура ОбновитьСписокКодовВидаОперации(Период, СписокВыбора) Экспорт
	
	СписокВыбора.Очистить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КодыВидаОперацийОтгрузкиСрезПоследних.Код КАК Код,
	               |	КодыВидаОперацийОтгрузкиСрезПоследних.ВидОперации КАК ВидОперации,
	               |	КодыВидаОперацийОтгрузкиСрезПоследних.Описание КАК Описание,
	               |	ВЫБОР
	               |		КОГДА КодыВидаОперацийОтгрузкиСрезПоследних.Сырьевой
	               |			ТОГДА ""Сырьевой товар""
	               |		ИНАЧЕ ""Несырьевой товар""
	               |	КОНЕЦ КАК ВидТовара
	               |ИЗ
	               |	РегистрСведений.тн_КодыВидаОперацийОтгрузки.СрезПоследних(&Период, ) КАК КодыВидаОперацийОтгрузкиСрезПоследних";
    Запрос.УстановитьПараметр("Период", Период);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокВыбора.Добавить(Выборка.Код, Выборка.Код + " - (" + Строка(Выборка.ВидОперации) +", " + Выборка.ВидТовара + " ) " + Выборка.Описание);	
		
	КонецЦикла;	
			
КонецПроцедуры

