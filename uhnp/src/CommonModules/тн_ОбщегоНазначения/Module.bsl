		ОбъектРеклассификация.ПометкаУдаления = Истина;
		ОбъектРеклассификация.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	 
КонецПроцедуры

//Блинова М.А. 15.11.2024 Выполнение задач №000051645
Процедура ЗаполнитьКонтрагентаВПартнере() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Контрагенты.Ссылка) КАК Ссылка,
		|	Контрагенты.Партнер КАК Партнер
		|ПОМЕСТИТЬ ВременнаяТаблица
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|
		|СГРУППИРОВАТЬ ПО
		|	Контрагенты.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблица.Ссылка КАК Ссылка,
		|	ВременнаяТаблица.Партнер КАК Партнер
		|ПОМЕСТИТЬ ВТ_КоличествоБольшеОдного
		|ИЗ
		|	ВременнаяТаблица КАК ВременнаяТаблица
		|ГДЕ
		|	ВременнаяТаблица.Ссылка > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КоличествоБольшеОдного.Партнер КАК Партнер,
		|	Контрагенты.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ИсключаемыеКонтрагенты
		|ИЗ
		|	ВТ_КоличествоБольшеОдного КАК ВТ_КоличествоБольшеОдного
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ВТ_КоличествоБольшеОдного.Партнер = Контрагенты.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Партнер КАК Партнер
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсключаемыеКонтрагенты КАК ВТ_ИсключаемыеКонтрагенты
		|		ПО (ВТ_ИсключаемыеКонтрагенты.Ссылка = Контрагенты.Ссылка)
		|ГДЕ
		|	Контрагенты.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
		|	И ВТ_ИсключаемыеКонтрагенты.Ссылка ЕСТЬ NULL
		|	И Контрагенты.Партнер.тн_Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Попытка
			ПартнерСсылка = ВыборкаДетальныеЗаписи.Партнер;
			ПартнерОбъект = ПартнерСсылка.ПолучитьОбъект();
			ПартнерОбъект.тн_Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
			ПартнерОбъект.Записать();	
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры 

//Сафиуллина З.Р. 02.12.2024 Выполнение задач №000051888
//
Процедура ПроизвестиЗаменуСубконтоПоВидамНалогов(ДатаНачала, ДатаОкончания) Экспорт
	
	Статистика = Новый Структура("КОбработке, Обработано, КоличествоОшибок", 0, 0, 0);
	СоответствиеСчетов = Новый Соответствие;
	СоответствиеТипаВидуНалога = Новый Соответствие;
	
	Для Каждого ТипНалога Из Перечисления.УдалитьТипыНалогов Цикл
		ИмяПредопрЭлемента = "Справочник.ВидыНалоговВзносов." + тн_Интеграция_УПП.ИмяЗначенияПеречисленияПоСсылке(ТипНалога);
		ВидНалога = ОбщегоНазначения.ПредопределенныйЭлемент(ИмяПредопрЭлемента);
		СоответствиеТипаВидуНалога.Вставить(ТипНалога, ВидНалога);
	КонецЦикла;
	
	СоответствиеТипаВидуНалога.Вставить(Перечисления.УдалитьТипыНалогов.ПустаяСсылка(), Справочники.ВидыНалоговВзносов.ПустаяСсылка());
	
	Запрос = Новый Запрос;   
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МСФОВидыСубконто.Ссылка КАК Счет
		|ИЗ
		|	ПланСчетов.МСФО.ВидыСубконто КАК МСФОВидыСубконто
		|ГДЕ
		|	МСФОВидыСубконто.ВидСубконто = &ВидСубконто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МСФОСубконто.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрБухгалтерии.МСФО.Субконто КАК МСФОСубконто
		|ГДЕ
		|	МСФОСубконто.Вид = &ВидСубконто
		|	И МСФОСубконто.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ МСФОСубконто.Значение ССЫЛКА Справочник.ВидыНалоговВзносов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду("ТипыНалого");
	Запрос.УстановитьПараметр("ВидСубконто", ВидСубконто);  
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", ДатаОкончания);
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И МСФОСубконто.Период МЕЖДУ &НачалоПериода И &КонецПериода", "");
	КонецЕсли;
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет(); 
	
	ВыборкаСчетов = РезультатыЗапросов[0].Выбрать();
	Пока ВыборкаСчетов.Следующий() Цикл
		СоответствиеСчетов.Вставить(ВыборкаСчетов.Счет, Истина);
	КонецЦикла;
	
	Выборка = РезультатыЗапросов[1].Выбрать();
	
	Статистика.КОбработке = Выборка.Количество();
	
	Пока Выборка.Следующий() Цикл  
		
		НаборЗаписей = РегистрыБухгалтерии.МСФО.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Если СоответствиеСчетов.Получить(Запись.СчетДт) = Истина Тогда
				Запись.СубконтоДт[ВидСубконто] =  СоответствиеТипаВидуНалога.Получить(Запись.СубконтоДт[ВидСубконто]); 
			КонецЕсли;
			Если СоответствиеСчетов.Получить(Запись.СчетКт) = Истина Тогда
				Запись.СубконтоКт[ВидСубконто] =  СоответствиеТипаВидуНалога.Получить(Запись.СубконтоКт[ВидСубконто]);
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
			Статистика.Обработано = Статистика.Обработано + 1;
			
		Исключение
			ЗаписьЖурналаРегистрации("Изменение субконто ""Типы налогов"" в проводках МСФО",
				УровеньЖурналаРегистрации.Ошибка,,,
				"Ошибка при записи проводок упр.учета документа " + Выборка.Регистратор + " : " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Статистика.КоличествоОшибок = Статистика.КоличествоОшибок + 1;
		КонецПопытки;
		
		ВсегоОбработано = Статистика.Обработано + Статистика.КоличествоОшибок;
		Если ВсегоОбработано % 50 = 0 Тогда
			ДлительныеОперации.СообщитьПрогресс(Окр(ВсегоОбработано / Статистика.КОбработке * 100, 1), Строка(Выборка.Регистратор));
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстСообщения = СтрШаблон("Обработано %1 документов из %2, ошибок %3", Статистика.Обработано, Статистика.КОбработке, Статистика.КоличествоОшибок);
    ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры   //ПроизвестиЗаменуСубконтоПоВидамНалогов()

// Чекордина Ирина 12.08.2025 Выполнение задач №000054723
Функция ПреобразоватьТаблицуПоГруппамЦФО(ЗначенияПоказателей, ВерсияРегламента, ИмяЗаменяемойАналитики) Экспорт
	
	Если ТипЗнч(ВерсияРегламента) <> Тип("СправочникСсылка.ВерсииРегламентовПодготовкиОтчетности")
		Или ТипЗнч(ИмяЗаменяемойАналитики) <> Тип("Строка")
		Или ЗначенияПоказателей.Колонки.Найти(ИмяЗаменяемойАналитики) = Неопределено Тогда
		Возврат ЗначенияПоказателей;
	КонецЕсли;
		
	СоответствиеГруппЦФО = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиница КАК ЦФО,
		|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиницаРодитель КАК ГруппаЦФО
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Справочник.ВерсииРегламентовПодготовкиОтчетности.СтруктураГруппы КАК ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы
		|ГДЕ
		|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.Ссылка = &ВерсияРегламента
		|	И ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиницаРодитель <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ЦФО КАК ЦФО,
		|	ВТ.ГруппаЦФО КАК ГруппаЦФО
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ1
		|		ПО ВТ.ГруппаЦФО = ВТ1.ЦФО
		|ГДЕ
		|	НЕ ВТ.ЦФО В
		|				(ВЫБРАТЬ
		|					ВТ.ГруппаЦФО
		|				ИЗ
		|					ВТ КАК ВТ)";
	
	Запрос.УстановитьПараметр("ВерсияРегламента", ВерсияРегламента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ЗначенияПоказателей;
	КонецЕсли;
		
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СоответствиеГруппЦФО.Вставить(Выборка.ЦФО, Выборка.ГруппаЦФО);
	КонецЦикла;
	
    тЗначенияПоказателей = ЗначенияПоказателей.Скопировать();
	
	Для Каждого Элемент Из СоответствиеГруппЦФО Цикл
		
		НайденныеСтроки = тЗначенияПоказателей.НайтиСтроки(Новый Структура(ИмяЗаменяемойАналитики, Элемент.Ключ));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Для Каждого Стр Из НайденныеСтроки Цикл
				Стр[ИмяЗаменяемойАналитики] = Элемент.Значение;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	КолонкиДляСвертки = "";
	КолонкиСуммирования = "";
	Для Каждого Колонка Из тЗначенияПоказателей.Колонки Цикл
		Если Колонка.Имя <> "Значение" И Колонка.Имя <> "ЗначениеВалюта" Тогда
			КолонкиДляСвертки = КолонкиДляСвертки + ?(ЗначениеЗаполнено(КолонкиДляСвертки), ", ", "") + Колонка.Имя;
		Иначе
			КолонкиСуммирования = КолонкиСуммирования + ?(ЗначениеЗаполнено(КолонкиСуммирования), ", ", "") + Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	
	тЗначенияПоказателей.Свернуть(КолонкиДляСвертки, КолонкиСуммирования);
	               
	Возврат тЗначенияПоказателей;
	
КонецФункции

