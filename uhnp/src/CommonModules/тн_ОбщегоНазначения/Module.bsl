// Белоконенко Денис 28.01.2026 Выполнение задач №000056425 
//
// Выполняет настройку формы при создании на сервере:
// добавляет реквизиты, элементы управления и страницу с составом комиссии
//
// Параметры:
//	Форма        	- ФормаКлиентскогоПриложения - Форма, в которую добавляются элементы,
//	ЭлементГруппы 	- ГруппаФормы  - Родительская группа, в которую помещается поле ввода приказа,
//	ЭлементСтраница - ГруппаФормы  - Страница, на которую следует поместить таблицу комиссии.
//					  Если не указана, создается новая группа страниц
//
Процедура ПриказНаКомиссиюПриСозданииНаСервере(Форма, ЭлементГруппы, ЭлементСтраница = Неопределено) Экспорт
	
	// Инициализация переменных
	СтруктураИмен = ПриказНаКомиссиюПолучитьИменаРеквизитов();
	
	ИмяРеквизита = СтруктураИмен.ИмяРеквизита;
	ИмяТЧ = СтруктураИмен.ИмяТЧ;
	ИмяСтраницаТЧ = СтруктураИмен.ИмяСтраницаТЧ;
	
	Элементы = Форма.Элементы; 
	Объект = Форма.Объект;
	
	ТаблицаКомиссии = ПриказНаКомиссиюПолучитьТаблицу(Объект[ИмяРеквизита]);
	КолСтрокТаблицы = ТаблицаКомиссии.Количество();
	
	// Создание реквизитов формы для хранения таблицы комиссии
	ДобавляемыеРеквизиты = Новый Массив;
		
	РеквизитФормы = Новый РеквизитФормы(ИмяТЧ, Новый ОписаниеТипов("ТаблицаЗначений"));	
	ДобавляемыеРеквизиты.Добавить(РеквизитФормы); 
	
	Для Каждого Колонка Из ТаблицаКомиссии.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		
		РеквизитФормы = Новый РеквизитФормы(ИмяКолонки, Колонка.ТипЗначения, ИмяТЧ, Колонка.Заголовок); 
			
		ДобавляемыеРеквизиты.Добавить(РеквизитФормы);	
	КонецЦикла;
			
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);		
	Форма[ИмяТЧ].Загрузить(ТаблицаКомиссии);
	
	// Элементы шапки формы
	Если Элементы.Найти(ИмяРеквизита) = Неопределено Тогда
		ПолеФормы 						= Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ЭлементГруппы);
		ПолеФормы.Вид 					= ВидПоляФормы.ПолеВвода;
		ПолеФормы.МаксимальнаяШирина 	= 28;
		ПолеФормы.Заголовок 			= "Приказ на комиссию";
		ПолеФормы.ПутьКДанным 			= СтрШаблон("Объект.%1", ИмяРеквизита);
		ПолеФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииПриказНаКомиссию");
	КонецЕсли;
	
	// Формирование структуры страниц (вкладок) формы
	Если ЭлементСтраница = Неопределено Тогда 
		// Создадим контейнер для вкладок
		Страницы 				= Элементы.Добавить("тн_Страницы", Тип("ГруппаФормы"), Форма); 
		Страницы.Вид 			= ВидГруппыФормы.Страницы; 
		
		// Вкладка "Основное"
		СтраницаФормы 			= Элементы.Добавить("тн_СтраницаОсновное", Тип("ГруппаФормы"), Страницы);
		СтраницаФормы.Заголовок = "Основное";
		СтраницаФормы.Вид 		= ВидГруппыФормы.Страница;
		
		// Перенесем все корневые элементы формы на новую вкладку "Основное"
		ПриказНаКомиссиюПеренестиЭлементыНаСтраницу(Форма, Элементы, СтраницаФормы); 
		
		СтраницаРасположения 	= Страницы;
	Иначе
		СтраницаРасположения 	= ЭлементСтраница; 
	КонецЕсли;
	
	// Создание страницы для ТЧ о сведениях о комиссии
	Если Элементы.Найти(ИмяСтраницаТЧ) = Неопределено Тогда
		СтраницаФормы 			= Элементы.Добавить(ИмяСтраницаТЧ, Тип("ГруппаФормы"), СтраницаРасположения);
		СтраницаФормы.Заголовок = ПриказНаКомиссиюПолучитьЗаголовокСтраницы(КолСтрокТаблицы);
		СтраницаФормы.Вид 		= ВидГруппыФормы.Страница; 				
	КонецЕсли;
	
	// Элементы ТЧ 
	Если Элементы.Найти(ИмяТЧ) = Неопределено Тогда	
		
		ЭлементТаблица 						= Элементы.Добавить(ИмяТЧ, Тип("ТаблицаФормы"), Элементы[ИмяСтраницаТЧ]);
		ЭлементТаблица.ПутьКДанным			= ИмяТЧ;
		ЭлементТаблица.ТолькоПросмотр		= Истина;
		
		Для Каждого Колонка Из ТаблицаКомиссии.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			
			ЭлементКолонка				= Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), ЭлементТаблица);  
			ЭлементКолонка.Вид 			= ВидПоляФормы.ПолеВвода;
			ЭлементКолонка.ПутьКДанным 	= СтрШаблон("%1.%2", ИмяТЧ, ИмяКолонки);
			ЭлементКолонка.Заголовок	= Колонка.Заголовок;  
		КонецЦикла;
						
	КонецЕсли;
	
КонецПроцедуры

// Белоконенко Денис 28.01.2026 Выполнение задач №000056425
Процедура ПриИзмененииПриказНаКомиссиюНаСервере(Форма) Экспорт
	
	Элементы = Форма.Элементы; 
	Объект = Форма.Объект;	
	
	СтруктураИмен 	= ПриказНаКомиссиюПолучитьИменаРеквизитов();		
	ТаблицаКомиссии = ПриказНаКомиссиюПолучитьТаблицу(Объект[СтруктураИмен.ИмяРеквизита]);
	КолСтрокТаблицы = ТаблицаКомиссии.Количество();
	
	Форма[СтруктураИмен.ИмяТЧ].Загрузить(ТаблицаКомиссии);
	
	Если Элементы.Найти(СтруктураИмен.ИмяСтраницаТЧ) <> Неопределено Тогда		
		Элементы[СтруктураИмен.ИмяСтраницаТЧ].Заголовок	= ПриказНаКомиссиюПолучитьЗаголовокСтраницы(КолСтрокТаблицы);
	КонецЕсли;  
	
КонецПроцедуры 

#КонецОбласти  

#Область ПриказНаКомиссию_Печать

// Белоконенко Денис 28.01.2026 Выполнение задач №000056425
//
// Формирует и выводит блок подписей членов комиссии в табличный документ.
// Выводит председателя комиссии, членов комиссии, а также пустые строки для подписей в соответствии с минимальным количеством
//
// Параметры:
//	Приказ - ДокументСсылка.тн_ПриказНаКомиссиюПоИнвентаризации - Ссылка на документ приказа
//	ТабличныйДокумент - ТабличныйДокумент - Табличный документ, в который выводится печатная форма.
//	ОбластьПодпись - ОбластьЯчеекТабличногоДокумента - Область макета для вывода подписи одного лица.
//	ДопПараметры - Структура - Необязательный. Содержит дополнительные настройки:
//					- ПредседательКомиссии - Строка - Заголовок для председателя.
//					- НеВыводитьЗаголовокЧленыКомиссии - Булево - Признак скрытия заголовка "Члены комиссии".
//					- МинКоличествоПодписей - Число - Минимальное количество строк подписей (по умолчанию 3).
//					- СоответствияПараметров - Структура - Соответствие имен параметров макета.
//
Процедура ПриказНаКомиссиюВыводЧленовКомиссииНаПечать(Приказ, ТабличныйДокумент, ОбластьПодпись, ДопПараметры = Неопределено) Экспорт
	
	ЕстьДопНастройки = ТипЗнч(ДопПараметры) = Тип("Структура");
	
	// Варианты заголовков разделов с подписями печатной формы	
	ЗаголовокРазделаПодписей = Новый Структура();
	Если ЕстьДопНастройки И ДопПараметры.Свойство("ПредседательКомиссии") Тогда
		ЗаголовокРазделаПодписей.Вставить("ПредседательКомиссии", ДопПараметры.ПредседательКомиссии);
	Иначе
		ЗаголовокРазделаПодписей.Вставить("ПредседательКомиссии", НСтр("ru = 'Председатель комиссии';
			|en = 'Commission chairperson'")); 
	КонецЕсли;
	
	Если ЕстьДопНастройки И ДопПараметры.Свойство("НеВыводитьЗаголовокЧленыКомиссии") Тогда 
		ЗаголовокРазделаПодписей.Вставить("ЧленыКомиссии",		  "");
	Иначе
		ЗаголовокРазделаПодписей.Вставить("ЧленыКомиссии",        НСтр("ru = 'Члены комиссии';
			|en = 'Commission members'"));	
	КонецЕсли;
	
	МинКоличествоПодписей = 3; // По умолчанию
	Если ЕстьДопНастройки И ДопПараметры.Свойство("МинКоличествоПодписей") Тогда
		МинКоличествоПодписей = ДопПараметры.МинКоличествоПодписей;
	КонецЕсли;  
	
	// Имена параметров области
	СоответствияПараметров = Новый Структура;
	СоответствияПараметров.Вставить("ФИО", "РасшифровкаПодписи");
	СоответствияПараметров.Вставить("Должность", "Должность");
	СоответствияПараметров.Вставить("ЗаголовокРазделаПодписей", "ЗаголовокРазделаПодписей");
	
	Если ЕстьДопНастройки И ДопПараметры.Свойство("СоответствияПараметров") Тогда
		Для Каждого Параметр Из ДопПараметры.СоответствияПараметров	Цикл
			СоответствияПараметров[Параметр.Ключ] = Параметр.Значение;		
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЧленыПриказаНаКомиссию.ФИО.Представление КАК ФИО,
	|	ЧленыПриказаНаКомиссию.Должность.Представление КАК Должность,
	|	ЧленыПриказаНаКомиссию.СтепеньЧленства = ЗНАЧЕНИЕ(Перечисление.тн_СтепеньЧленстваВКомиссии.Председатель) КАК Председатель
	|ИЗ
	|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации.ЧленыКомиссии КАК ЧленыПриказаНаКомиссию
	|ГДЕ
	|	ЧленыПриказаНаКомиссию.Ссылка = &Приказ";
	
	Запрос.УстановитьПараметр("Приказ", Приказ);
	
	ТаблицаИнвентаризационнаяКомиссия = Запрос.Выполнить().Выгрузить();
	
	// Выведем подпись председателя инвентаризационной комиссии		
	ПредседательКомиссии = ТаблицаИнвентаризационнаяКомиссия.Найти(Истина, "Председатель");
	
	Если ПредседательКомиссии <> Неопределено И ПредседательКомиссии.Председатель Тогда
				
		ОбластьПодпись.Параметры[СоответствияПараметров.ЗаголовокРазделаПодписей] 	= ЗаголовокРазделаПодписей.ПредседательКомиссии;
		ОбластьПодпись.Параметры[СоответствияПараметров.Должность]                	= ПредседательКомиссии.Должность;
		ОбластьПодпись.Параметры[СоответствияПараметров.ФИО]       					= ПредседательКомиссии.ФИО;
		
	Иначе
		
		ОбластьПодпись.Параметры[СоответствияПараметров.ЗаголовокРазделаПодписей] 	= ЗаголовокРазделаПодписей.ПредседательКомиссии;
		ОбластьПодпись.Параметры[СоответствияПараметров.Должность]                	= "";
		ОбластьПодпись.Параметры[СоответствияПараметров.ФИО]       					= "";
		
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьПодпись);
	
	// Выведем подписи членов комиссии
	ВыводитьЗаголовок = Истина;
	
	КоличествоЧленовКомиссии = 0;
	
	// Сначала выведем членов комиссии из выборки
	Для каждого ЧленКомиссии Из ТаблицаИнвентаризационнаяКомиссия Цикл
		
		Если ЧленКомиссии.Председатель Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ОбщегоНазначенияБПВызовСервера.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, ОбластьПодпись) Тогда
			
			// Выведем разрыв страницы
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ВыводитьЗаголовок = Истина; // на новой странице выведем заголовок набора подписей
			
		КонецЕсли;
		
		КоличествоЧленовКомиссии = КоличествоЧленовКомиссии + 1;
		
		ОбластьПодпись.Параметры[СоответствияПараметров.ЗаголовокРазделаПодписей] 	= ?(ВыводитьЗаголовок, ЗаголовокРазделаПодписей.ЧленыКомиссии, "");
		ОбластьПодпись.Параметры[СоответствияПараметров.Должность]                	= ЧленКомиссии.Должность;
		ОбластьПодпись.Параметры[СоответствияПараметров.ФИО]       					= ЧленКомиссии.ФИО;
		
		ТабличныйДокумент.Вывести(ОбластьПодпись);
		
		ВыводитьЗаголовок = Ложь; // в следующей итерации вывод заголовка не нужен
		
	КонецЦикла;
	
	// Затем выведем пустые места для подписей, как в форме, утвержденной Госкомстатом.
	Если КоличествоЧленовКомиссии < МинКоличествоПодписей Тогда
		
		Если НЕ ОбщегоНазначенияБПВызовСервера.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, ОбластьПодпись) Тогда
			
			// Выведем разрыв страницы
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ВыводитьЗаголовок = Истина; // на новой странице выведем заголовок набора подписей
			
		КонецЕсли;
		
		Для Итератор = КоличествоЧленовКомиссии + 1 По МинКоличествоПодписей Цикл
			
			ОбластьПодпись.Параметры[СоответствияПараметров.ЗаголовокРазделаПодписей] 	= ?(ВыводитьЗаголовок, ЗаголовокРазделаПодписей.ЧленыКомиссии, "");
			ОбластьПодпись.Параметры[СоответствияПараметров.Должность]                	= "";
			ОбластьПодпись.Параметры[СоответствияПараметров.ФИО]       					= "";
			
			ТабличныйДокумент.Вывести(ОбластьПодпись);
			
			ВыводитьЗаголовок = Ложь; // в следующей итерации вывод заголовка не нужен
			
		КонецЦикла;
		
	КонецЕсли; 
		
КонецПроцедуры

// Белоконенко Денис 28.01.2026 Выполнение задач №000056425 
//
// Определяет, требуется ли печать приказа на комиссию для указанного документа.
//
// Параметры:
//	СсылкаДок - ДокументСсылка - Ссылка на документ.
//
// Возвращаемое значение:
//	Структура:
//	 - ТребуетсяПечать - Булево - Истина, если приказ заполнен.
//	 - Приказ - ДокументСсылка.тн_ПриказНаКомиссиюПоИнвентаризации - Ссылка на приказ.
//
Функция ТребуетсяПечатьСПриказа(СсылкаДок) Экспорт	
	
	ИменаРеквизитов = ПриказНаКомиссиюПолучитьИменаРеквизитов();
	Приказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаДок, ИменаРеквизитов.ИмяРеквизита);
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТребуетсяПечать", ЗначениеЗаполнено(Приказ));
	СтруктураВозврата.Вставить("Приказ", Приказ);
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти

#Область ПриказНаКомиссию_СлужебныеПроцедурыФункции
  
// Белоконенко Денис 28.01.2026 Выполнение задач №000056425
Функция ПриказНаКомиссиюПолучитьЗаголовокСтраницы(КолСтрокТаблицы)
	Если КолСтрокТаблицы = 0 Тогда
		ЗаголовокСтраницы = "Инвентаризационная комиссия по приказу";
	Иначе
		ЗаголовокСтраницы = СтрШаблон("Инвентаризационная комиссия по приказу (%1)", КолСтрокТаблицы);
	КонецЕсли; 
	
	Возврат ЗаголовокСтраницы; 
КонецФункции

// Белоконенко Денис 28.01.2026 Выполнение задач №000056425
Функция ПриказНаКомиссиюПолучитьТаблицу(ПриказНаКомиссию)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЧленыКомиссии.ФИО КАК ФИО,
		|	ЧленыКомиссии.СтепеньЧленства КАК СтепеньЧленства,
		|	ЧленыКомиссии.Должность КАК Должность
		|ИЗ
		|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации.ЧленыКомиссии КАК ЧленыКомиссии
		|ГДЕ
		|	ЧленыКомиссии.Ссылка = &ПриказНаКомиссию";
	
	Запрос.УстановитьПараметр("ПриказНаКомиссию", ПриказНаКомиссию);
	
	ТаблицаКомиссии = Запрос.Выполнить().Выгрузить();
	
	Колонка = ТаблицаКомиссии.Колонки.Найти("СтепеньЧленства");
	Если Колонка <> Неопределено Тогда
		Колонка.Заголовок = "Степень членства";
	КонецЕсли;
	
	Возврат ТаблицаКомиссии;
	
КонецФункции

// Белоконенко Денис 28.01.2026 Выполнение задач №000056425
Функция ПриказНаКомиссиюПолучитьИменаРеквизитов() Экспорт
	
	СтруктураИмен = Новый Структура();
	СтруктураИмен.Вставить("ИмяРеквизита", "тн_ПриказНаКомиссиюПоИнвентаризации");
	СтруктураИмен.Вставить("ИмяТЧ", "тн_СведенияПриказаНаКомиссию"); 
	СтруктураИмен.Вставить("ИмяСтраницаТЧ", "тн_СтраницаСведенияПриказаНаКомиссию");
	
	Возврат СтруктураИмен;
	
КонецФункции   

// Белоконенко Денис 28.01.2026 Выполнение задач №000056425
Процедура ПриказНаКомиссиюПеренестиЭлементыНаСтраницу(Форма, Элементы, СтраницаФормы)
	
	// 1. Создаем массив для безопасного перебора
	МассивЭлементов = Новый Массив;
	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ЭлементФормы.Родитель = Форма Тогда // Только те, что в корне формы
			МассивЭлементов.Добавить(ЭлементФормы);
		КонецЕсли;
	КонецЦикла;   
	
	// 2. Переносим Элементы на новую страницу
	Для Каждого ЭлементФормы Из МассивЭлементов Цикл 
		ПропускЭлемента = ЭлементФормы.Имя = "тн_Страницы" Или
			ЭлементФормы.Имя = "тн_СтраницаОсновное";			
		
		Если ПропускЭлемента Тогда
			Продолжить;		
		КонецЕсли;     
		
		// Меняем родителя
		ОбщегоНазначенияБЭД.ПереместитьЭлемент(Элементы, ЭлементФормы.Имя, СтраницаФормы.Имя);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

