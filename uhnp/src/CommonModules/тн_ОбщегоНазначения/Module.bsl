Функция ПрименяетсяОпределениеКодаОперацииПоРСКодыВидаОперацийОтгрузки(Организация, Период) Экспорт
	
	ПараметрыУчетнойПолитики = НастройкиНалоговУчетныхПолитик.ДействующиеПараметрыНалоговУчетныхПолитикНаДату(
		"НастройкиУчетаНДС",
		Организация,
		Период,
		Ложь);
		
	Результат = Не ПараметрыУчетнойПолитики = Неопределено И ПараметрыУчетнойПолитики.тн_ОпределятьКодыОперацииПоРСКодыВидаОперацийОтгрузки;

	Возврат Результат;

КонецФункции

// Юдина Екатерина 17.06.2025 Выполнение задач №000054100
//  
Функция ЗаполнитьКодВидаОперацииОтгрузки(Организация, СписокДокументов) Экспорт 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СписокДокументов.Ссылка КАК Документ,
	               |	СписокДокументов.Дата КАК Дата,
	               |	СписокДокументов.Номенклатура КАК Номенклатура,
	               |	СписокДокументов.Контрагент КАК Контрагент,
	               |	СписокДокументов.Договор КАК Договор,
	               |	СписокДокументов.Сумма КАК Сумма,
	               |	СписокДокументов.ПометкаВыделения КАК ПометкаВыделения,
	               |	СписокДокументов.ИдентификаторСтроки КАК ИдентификаторСтроки
	               |ПОМЕСТИТЬ втСписокДокументовПредварительно
	               |ИЗ
	               |	&СписокДокументов КАК СписокДокументов
	               |ГДЕ
	               |	СписокДокументов.ПометкаВыделения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СписокДокументов.Документ КАК Документ,
	               |	СписокДокументов.Дата КАК Дата,
	               |	ВЫРАЗИТЬ(СписокДокументов.Контрагент КАК Справочник.Контрагенты).СтранаРегистрации КАК СтранаРегистрации,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(СписокДокументов.Договор КАК Справочник.ДоговорыКонтрагентов).тн_ОтгрузкаВСвободнуюТаможеннуюЗону
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.тн_ВидыОперацийОтгрузки.СвободнаяТаможеннаяЗона)
	               |		КОГДА ВЫРАЗИТЬ(СписокДокументов.Договор КАК Справочник.ДоговорыКонтрагентов).тн_ОтгрузкаВСтрануНеЕАЭС  
				   |		    ИЛИ НЕ ВЫРАЗИТЬ(СписокДокументов.Контрагент КАК Справочник.Контрагенты).СтранаРегистрации.УчастникЕАЭС
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.тн_ВидыОперацийОтгрузки.ЭкспортЗаПределыЕАЭС)
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВЫРАЗИТЬ(СписокДокументов.Контрагент КАК Справочник.Контрагенты).СтранаРегистрации.УчастникЕАЭС
	               |					ТОГДА ЗНАЧЕНИЕ(Перечисление.тн_ВидыОперацийОтгрузки.ЭкспортВСтраныЕАЭС)
	               |				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.тн_ВидыОперацийОтгрузки.ПустаяСсылка)
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ВидОперации,
	               |	СписокДокументов.Номенклатура КАК Номенклатура,
	               |	СписокДокументов.Контрагент КАК Контрагент,
	               |	СписокДокументов.Договор КАК Договор,
	               |	СписокДокументов.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ЕСТЬNULL(ВЫРАЗИТЬ(СписокДокументов.Номенклатура КАК Справочник.Номенклатура).КодТНВЭД.СырьевойТовар, ЛОЖЬ) КАК Сырьевой,
	               |	СписокДокументов.ПометкаВыделения КАК ПометкаВыделения,
	               |	СписокДокументов.Сумма КАК Сумма
	               |ПОМЕСТИТЬ втСписокДокументов
	               |ИЗ
	               |	втСписокДокументовПредварительно КАК СписокДокументов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	НАЧАЛОПЕРИОДА(втСписокДокументов.Дата, ДЕНЬ) КАК Дата
	               |ПОМЕСТИТЬ вт_ДатыПродаж
	               |ИЗ
	               |	втСписокДокументов КАК втСписокДокументов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(тн_Оффшоры.Период) КАК Период,
	               |	тн_Оффшоры.Страна КАК Страна,
	               |	вт_ДатыПродаж.Дата КАК Дата
	               |ПОМЕСТИТЬ вт_ДатыОффшоров
	               |ИЗ
	               |	РегистрСведений.тн_Оффшоры КАК тн_Оффшоры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ДатыПродаж КАК вт_ДатыПродаж
	               |		ПО тн_Оффшоры.Период <= вт_ДатыПродаж.Дата
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	тн_Оффшоры.Страна,
	               |	вт_ДатыПродаж.Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(ВзаимозависимыеЛица.Период) КАК Период,
	               |	ВзаимозависимыеЛица.Контрагент КАК Контрагент,
	               |	вт_ДатыПродаж.Дата КАК Дата
	               |ПОМЕСТИТЬ вт_ДатыВзаимозависимыхЛиц
	               |ИЗ
	               |	РегистрСведений.ВзаимозависимыеЛица КАК ВзаимозависимыеЛица
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ДатыПродаж КАК вт_ДатыПродаж
	               |		ПО ВзаимозависимыеЛица.Период <= вт_ДатыПродаж.Дата
	               |			И (ВзаимозависимыеЛица.Организация = &Организация)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаимозависимыеЛица.Контрагент,
	               |	вт_ДатыПродаж.Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(тн_КодыВидаОперацийОтгрузки.Период) КАК Период,
	               |	тн_КодыВидаОперацийОтгрузки.ВидОперации КАК ВидОперации,
	               |	тн_КодыВидаОперацийОтгрузки.Оффшор КАК Оффшор,
	               |	тн_КодыВидаОперацийОтгрузки.Сырьевой КАК Сырьевой,
	               |	тн_КодыВидаОперацийОтгрузки.Взаимозависимость КАК Взаимозависимость,
	               |	вт_ДатыПродаж.Дата КАК Дата
	               |ПОМЕСТИТЬ вт_ДатыКодыВидаОперацийОтгрузки
	               |ИЗ
	               |	РегистрСведений.тн_КодыВидаОперацийОтгрузки КАК тн_КодыВидаОперацийОтгрузки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ДатыПродаж КАК вт_ДатыПродаж
	               |		ПО тн_КодыВидаОперацийОтгрузки.Период <= вт_ДатыПродаж.Дата
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	тн_КодыВидаОперацийОтгрузки.ВидОперации,
	               |	тн_КодыВидаОперацийОтгрузки.Оффшор,
	               |	тн_КодыВидаОперацийОтгрузки.Сырьевой,
	               |	тн_КодыВидаОперацийОтгрузки.Взаимозависимость,
	               |	вт_ДатыПродаж.Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	втСписокДокументов.Документ КАК Документ,
	               |	втСписокДокументов.Дата КАК Дата,
	               |	втСписокДокументов.Номенклатура КАК Номенклатура,
	               |	втСписокДокументов.Контрагент КАК Контрагент,
	               |	втСписокДокументов.Договор КАК Договор,
	               |	втСписокДокументов.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	втСписокДокументов.ВидОперации КАК ВидОперации,
	               |	втСписокДокументов.Сырьевой КАК Сырьевой,
	               |	ЕСТЬNULL(ВзаимозависимыеЛица.ТипВзаимозависимости, ЛОЖЬ) В (&МассивТипВзаимозависимости) КАК Взаимозависимость,
	               |	ЕСТЬNULL(тн_Оффшоры.Оффшор, ЛОЖЬ) КАК Оффшор,
	               |	втСписокДокументов.ПометкаВыделения КАК ПометкаВыделения,
	               |	втСписокДокументов.Сумма КАК Сумма
	               |ПОМЕСТИТЬ втПодготовленныйСписокДокументов
	               |ИЗ
	               |	втСписокДокументов КАК втСписокДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ДатыОффшоров КАК вт_ДатыОффшоров
	               |		ПО втСписокДокументов.СтранаРегистрации = вт_ДатыОффшоров.Страна
	               |			И (НАЧАЛОПЕРИОДА(втСписокДокументов.Дата, ДЕНЬ) = вт_ДатыОффшоров.Дата)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_Оффшоры КАК тн_Оффшоры
	               |		ПО втСписокДокументов.СтранаРегистрации = тн_Оффшоры.Страна
	               |			И (вт_ДатыОффшоров.Период = тн_Оффшоры.Период)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ДатыВзаимозависимыхЛиц КАК вт_ДатыВзаимозависимыхЛиц
	               |		ПО втСписокДокументов.Контрагент = вт_ДатыВзаимозависимыхЛиц.Контрагент
	               |			И (НАЧАЛОПЕРИОДА(втСписокДокументов.Дата, ДЕНЬ) = вт_ДатыВзаимозависимыхЛиц.Дата)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВзаимозависимыеЛица КАК ВзаимозависимыеЛица
	               |		ПО (ВзаимозависимыеЛица.Организация = &Организация)
	               |			И втСписокДокументов.Контрагент = ВзаимозависимыеЛица.Контрагент
	               |			И (вт_ДатыВзаимозависимыхЛиц.Период = ВзаимозависимыеЛица.Период)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	втПодготовленныйСписокДокументов.Документ КАК Ссылка,
	               |	втПодготовленныйСписокДокументов.Номенклатура КАК Номенклатура,
	               |	втПодготовленныйСписокДокументов.Контрагент КАК Контрагент,
	               |	втПодготовленныйСписокДокументов.Договор КАК Договор,
	               |	втПодготовленныйСписокДокументов.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ЕСТЬNULL(тн_КодыВидаОперацийОтгрузки.Код, """") КАК тн_КодВидаОперации,
	               |	втПодготовленныйСписокДокументов.Дата КАК Дата,
	               |	втПодготовленныйСписокДокументов.ПометкаВыделения КАК ПометкаВыделения,
	               |	втПодготовленныйСписокДокументов.Сумма КАК Сумма
	               |ИЗ
	               |	втПодготовленныйСписокДокументов КАК втПодготовленныйСписокДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ДатыКодыВидаОперацийОтгрузки КАК вт_ДатыКодыВидаОперацийОтгрузки
	               |		ПО втПодготовленныйСписокДокументов.ВидОперации = вт_ДатыКодыВидаОперацийОтгрузки.ВидОперации
	               |			И втПодготовленныйСписокДокументов.Оффшор = вт_ДатыКодыВидаОперацийОтгрузки.Оффшор
	               |			И втПодготовленныйСписокДокументов.Сырьевой = вт_ДатыКодыВидаОперацийОтгрузки.Сырьевой
	               |			И втПодготовленныйСписокДокументов.Взаимозависимость = вт_ДатыКодыВидаОперацийОтгрузки.Взаимозависимость
	               |			И (НАЧАЛОПЕРИОДА(втПодготовленныйСписокДокументов.Дата, ДЕНЬ) = вт_ДатыКодыВидаОперацийОтгрузки.Дата)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_КодыВидаОперацийОтгрузки КАК тн_КодыВидаОперацийОтгрузки
	               |		ПО (тн_КодыВидаОперацийОтгрузки.ВидОперации = вт_ДатыКодыВидаОперацийОтгрузки.ВидОперации)
	               |			И (тн_КодыВидаОперацийОтгрузки.Оффшор = вт_ДатыКодыВидаОперацийОтгрузки.Оффшор)
	               |			И (тн_КодыВидаОперацийОтгрузки.Сырьевой = вт_ДатыКодыВидаОперацийОтгрузки.Сырьевой)
	               |			И (тн_КодыВидаОперацийОтгрузки.Взаимозависимость = вт_ДатыКодыВидаОперацийОтгрузки.Взаимозависимость)
	               |			И (вт_ДатыКодыВидаОперацийОтгрузки.Период = тн_КодыВидаОперацийОтгрузки.Период)";
	
	масТипВзаимозависимости = Новый Массив;
	масТипВзаимозависимости.Добавить(Перечисления.ТипыВзаимозависимости.ВзаимозависимыПоКодексу);
	масТипВзаимозависимости.Добавить(Перечисления.ТипыВзаимозависимости.СамостоятельноеПризнаниеВзаимозависимости);
	масТипВзаимозависимости.Добавить(Перечисления.ТипыВзаимозависимости.ВзаимозависимостьПоРешениюСуда);
	
	Запрос.УстановитьПараметр("МассивТипВзаимозависимости", масТипВзаимозависимости); 
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов); 
	Запрос.УстановитьПараметр("Организация", Организация); 
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

