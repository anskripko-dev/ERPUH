//Сафиуллина З.Р. 05.02.2026 Выполнение задач №000056642
//
Процедура СвернутьТабличнуюЧасть(ТекОбъект, ИмяТЧ, МассивИменРесурсов) Экспорт
	
	МетаданныеТЧ = ТекОбъект.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ);
	
	Если МетаданныеТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаГруппировки = "";
	СтрокаСуммирования = "";
	
	Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
		
		ИмяРеквизита = РеквизитТЧ.Имя;
		
		Если МассивИменРесурсов.Найти(ИмяРеквизита) <> Неопределено Тогда
			СтрокаСуммирования = СтрокаСуммирования + ?(ПустаяСтрока(СтрокаСуммирования), "", ",") + ИмяРеквизита;
		Иначе
			СтрокаГруппировки = СтрокаГруппировки + ?(ПустаяСтрока(СтрокаГруппировки), "", ",") + ИмяРеквизита;
		КонецЕсли;
		
	КонецЦикла;
	
	ТЗ = ТекОбъект[ИмяТЧ].Выгрузить();
	ТЗ.Свернуть(СтрокаГруппировки, СтрокаСуммирования);
	ТекОбъект[ИмяТЧ].Загрузить(ТЗ);
	
КонецПроцедуры //СвернутьТабличнуюЧасть()

//Качикина 05.03.2026 Выполнение задач №000056633     
//процедура блокирует все элементы формы кроме СписокРеквизитовИсключений
Процедура ДоступностьЭлементовФормыИсключаяРеквизиты(ЭлементыФормы, СписокРеквизитовИсключений) Экспорт 

	ОбщийСписокИсключений = Новый СписокЗначений; 
	ОбщийСписокИсключений.Добавить("ФормаПровести");
	ОбщийСписокИсключений.Добавить("ФормаПровестиИЗакрыть");
	ОбщийСписокИсключений.Добавить("ФормаЗаписать");  
	ОбщийСписокИсключений.Добавить("КнопкаИзменитьРеквизитыБезПерепроведения"); 
	ОбщийСписокИсключений.Добавить("ФормаОбработкаОтражениеДокументовВРеглУчетеПроводкиРеглУчета");
	ОбщийСписокИсключений.Добавить("ФормаОбщаяКомандаПоказатьИсториюТрансляции");    
	Для Каждого ЭлСЗ Из СписокРеквизитовИсключений Цикл
		ОбщийСписокИсключений.Добавить(ЭлСЗ.Значение);		
	КонецЦикла;
		 	 	
	Для Каждого ТекЭлемент Из ЭлементыФормы Цикл
		
		ТипЗначенияЭлемента = ТипЗнч(ТекЭлемент);
		Если  ТипЗначенияЭлемента = Тип("ДекорацияФормы")
			Или ТипЗначенияЭлемента = Тип("ГруппаФормы")
			Или ТипЗначенияЭлемента = Тип("ТаблицаФормы") Тогда
			Продолжить;
		КонецЕсли;  
		
		РодительИмя = ТекЭлемент.Родитель.Имя; 
		Если Не ТипЗнч(ТекЭлемент.Родитель) = Тип("ФормаКлиентскогоПриложения") 
			И (СтрНайти(РодительИмя, "ПодменюПечать") <> 0
			Или СтрНайти(РодительИмя, "ПоказатьВСписке") <> 0
			Или СтрНайти(РодительИмя, "ПодменюОтчеты") <> 0
			Или СтрНайти(РодительИмя, "ПодменюСоздатьНаОсновании") <> 0) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбщийСписокИсключений.НайтиПоЗначению(ТекЭлемент.Имя) = Неопределено Тогда
			//блокируем
			Попытка
				ТекЭлемент.ТолькоПросмотр = Истина;
			Исключение
				ТекЭлемент.Доступность = Ложь;
			КонецПопытки;	    
		Иначе  
			//устанавливаем доступность
			Попытка
				ТекЭлемент.ТолькоПросмотр = Ложь;
			Исключение
				ТекЭлемент.Доступность = Истина;
			КонецПопытки;    	
		КонецЕсли;    
		
	КонецЦикла; 
	
КонецПроцедуры

