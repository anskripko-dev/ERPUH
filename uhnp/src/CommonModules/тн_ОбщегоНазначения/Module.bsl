//Функция РаспоковатьZipФайл(ПутьКФайлуСервер)
Функция РаспоковатьZipФайл(ПутьКФайлуСервер) Экспорт	
	
	//СоздатьКаталогOpenXML
	ИмяВременногоКаталога = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременногоКаталога);       
	ПапкаOpenXML = ИмяВременногоКаталога + ПолучитьРазделительПути();
	
	ЧтениеZIP = Новый ЧтениеZipФайла;
	ЧтениеZIP.Открыть(ПутьКФайлуСервер);
	ЧтениеZIP.ИзвлечьВсе(ПапкаOpenXML);
	ЧтениеZIP.Закрыть();
	
	Возврат ПапкаOpenXML;
	
КонецФункции

