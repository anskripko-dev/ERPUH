		Уровень = УровеньЖурналаРегистрации.Ошибка;
		Комментарий = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, Уровень,,,Комментарий);
		// КОНЕЦ Белоконенко Денис 10.12.2025 Выполнение задач №000056102
	КонецПопытки;
	
	Возврат Результат;
	
