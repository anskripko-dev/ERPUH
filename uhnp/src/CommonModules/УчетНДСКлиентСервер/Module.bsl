// Применяется 176 ФЗ.
// 
// Параметры:
//  Период - Дата -  дата для проверки применения 176 ФЗ
// 
// Возвращаемое значение:
//  Булево - Применяется 176 ФЗ
Функция Применяется176ФЗ(Период) Экспорт
	
	Возврат Период >='20250101';
	
КонецФункции

// Эта функция служат для определения, какая ставка НДС должна быть подставлена в документы
// 
// Параметры:
//  Период - Дата - Период, на который нужно получить ставку.
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.СтавкиНДС - Общая ставка НДС
Функция ОбщаяСтавкаНДС(Период) Экспорт
	
	Если Период < '20190101' Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18");
	ИначеЕсли Период < '20260101' Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
	Иначе
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
	КонецЕсли;
	
КонецФункции

