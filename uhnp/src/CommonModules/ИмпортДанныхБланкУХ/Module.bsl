
////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Импорт бланка с произвольным количеством колонок (редакция 4.0)
//

Функция ИмпортироватьДанныеИзМакета(ОбъектРасчета) Экспорт
	
	МассивПериодов		= ОбъектРасчета.МассивПериодов;
	КоличествоПериодов  = МассивПериодов.Количество();
		
	ЭталонныйМакет = Новый ТабличныйДокумент;
	текНаборЗаписей = РасширениеБизнесЛогикиУХ.ПолучитьНаборЗаписейРегистраНастройкиАналитическихБланков();
	текНаборЗаписей.Отбор.Бланк.Установить(ОбъектРасчета.БланкДляИмпорта);
	текНаборЗаписей.Прочитать();
	Если текНаборЗаписей.Количество() =1 Тогда
		ЗначениеСохраняемойНастройки = текНаборЗаписей[0].ХранилищеДополнительныхНастроек.Получить();
		Если  ЗначениеСохраняемойНастройки.Свойство("ТабДокМакет") Тогда
			ЭталонныйМакет.Вывести(ЗначениеСохраняемойНастройки.ТабДокМакет);
		КонецЕсли;
	КонецЕсли;
	
	ИсходныйМакет = Неопределено;
	Параметры = Новый Массив();
	Параметры.Добавить(ИсходныйМакет);
	Параметры.Добавить(ЭталонныйМакет);
	Параметры.Добавить(ОбъектРасчета.БланкДляИмпорта);
	Параметры.Добавить(ОбъектРасчета.ПериодОтчета.Периодичность);
	Параметры.Добавить(КоличествоПериодов);
	Параметры.Добавить(Ложь);
	Параметры.Добавить(ОбъектРасчета);
	ОбщегоНазначения.ВыполнитьМетодКонфигурации("АналитическийБланкУХСервер.ЗаполнитьШаблонМакетаДляВыгрузки", Параметры);
		
	ИсходныйМакет = Параметры[0];
	
	Если ИсходныйМакет = Неопределено Тогда
		ТекстСообщения = Нстр("ru = 'Ошибка получения шаблона бланка для загрузки данных.'");
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ИмпортироватьДанныеИзМакета", , , ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ТабРасшифровки=Новый ТаблицаЗначений;
	ТабРасшифровки.Колонки.Добавить("Строка");
	ТабРасшифровки.Колонки.Добавить("Колонка");
	ТабРасшифровки.Колонки.Добавить("Текст");
	
	ТабРасшифровки.Колонки.Добавить("Расшифровка");
	
	НомерКолонкиНачало=0;
	НомерСтрокиНачало=0;
	НомерКолонкиНачалоПоказателей=0;
	НомерКолонкиОкончаниеПоказателей=0;
	
	ТаблицаСтрок=Новый Таблицазначений;
	ТаблицаСтрок.Колонки.Добавить("СтрокаОтчета");
	ТаблицаСтрок.Колонки.Добавить("СтрокаОтчетаНаименование");
	ТаблицаСтрок.Колонки.Добавить("ПравилаИспользованияПолейЗапроса");
	
	ТаблицаПоказателей=Новый ТаблицаЗначений;
	ТаблицаПоказателей.Колонки.Добавить("СтрокаОтчета");
	ТаблицаПоказателей.Колонки.Добавить("НомерКолонки");
	ТаблицаПоказателей.Колонки.Добавить("ИмяКолонки");
	ТаблицаПоказателей.Колонки.Добавить("ПоказательОтчета");
	ТаблицаПоказателей.Колонки.Добавить("ПериодОтчета");
		
	ШаблонТаблицыИспользованияПолей=Новый ТаблицаЗначений;
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("Синоним");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("НомерКолонки");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("Поле");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("АналитикаОперанда");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("КодАналитики");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("РеквизитАналитики");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("ТаблицаАналитики");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("НеИспользоватьДляСинхронизации",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("СоздаватьПриНеудачномПоискеПриИмпорте",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("РазделятьПоОрганизациям");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("ОбновлятьРеквизитыПриИмпорте");
	ШаблонТаблицыИспользованияПолей.Колонки.Добавить("ТипЗначения");
	
	ОписаниеСтроки=Неопределено;
	
	Для Нкол = 1 По ИсходныйМакет.ШиринаТаблицы Цикл
		
		Для Нстр = 1 ПО ИсходныйМакет.ВысотаТаблицы Цикл
			
			РабочаяОбласть = ИсходныйМакет.Область(Нстр, Нкол, Нстр, Нкол);
			
			ЭтоЯчейкаСРасшифровкойБезПоказателя = (ТипЗнч(РабочаяОбласть.Расшифровка) = Тип("ФиксированнаяСтруктура")
				И РабочаяОбласть.Расшифровка.Свойство("СтрокаОтчета") И НЕ РабочаяОбласть.Расшифровка.Свойство("ПоказательСсылка"));
			
			ЭтоЯчейкаСРасшифровкойПоказателя = (ТипЗнч(РабочаяОбласть.Расшифровка) = Тип("ФиксированнаяСтруктура")
				И РабочаяОбласть.Расшифровка.Свойство("ПоказательСсылка"));
			
			Если ЭтоЯчейкаСРасшифровкойБезПоказателя Тогда
				
				Если НомерСтрокиНачало = 0 Тогда
					НомерКолонкиНачало = Нкол;
					НомерСтрокиНачало = Нстр;
					Прервать;
				КонецЕсли;
				
			ИначеЕсли ЭтоЯчейкаСРасшифровкойПоказателя Тогда
				
				НомерКолонкиНачалоПоказателей = Нкол;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НомерКолонкиНачалоПоказателей > 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	НомерКолонкиОкончаниеПоказателей = ИсходныйМакет.ШиринаТаблицы;
	
	Если НомерСтрокиНачало=0 Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'В бланке импорта %1 не найдены области строк. Импорт невозможен.'"), 
			ОбъектРасчета.БланкДляИмпорта);
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ИмпортироватьДанныеИзМакета", , , ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;
	
	Для НомСтр=НомерСтрокиНачало По ИсходныйМакет.ВысотаТаблицы Цикл
		
		РабочаяОбласть=ИсходныйМакет.Область(НомСтр,НомерКолонкиНачало,НомСтр,НомерКолонкиНачало);
		
		Если ТипЗнч(РабочаяОбласть.Расшифровка)=Тип("ФиксированнаяСтруктура")
			И РабочаяОбласть.Расшифровка.Свойство("СтрокаОтчета") Тогда
			
			НоваяСтрока=ТаблицаСтрок.Добавить();
			НоваяСтрока.СтрокаОтчета					= РабочаяОбласть.Расшифровка.СтрокаОтчета;
			НоваяСтрока.СтрокаОтчетаНаименование		= СокрЛП(РабочаяОбласть.Расшифровка.СтрокаОтчетаНаименование);
			НоваяСтрока.ПравилаИспользованияПолейЗапроса= ШаблонТаблицыИспользованияПолей.СкопироватьКолонки();
	
			Для НомКол=НомерКолонкиНачалоПоказателей ПО НомерКолонкиОкончаниеПоказателей Цикл
				
				РабочаяОбласть=ИсходныйМакет.Область(НомСтр,НомКол,НомСтр,НомКол);
				
				Если ТипЗнч(РабочаяОбласть.Расшифровка)=Тип("ФиксированнаяСтруктура")
					И РабочаяОбласть.Расшифровка.Свойство("ПоказательСсылка")
					И ОбъектРасчета.мПоказатели.Найти(РабочаяОбласть.Расшифровка.ПоказательСсылка) <> Неопределено
					Тогда
					
					СтрПоказатель=ТаблицаПоказателей.Добавить();
					СтрПоказатель.ПоказательОтчета=РабочаяОбласть.Расшифровка.ПоказательСсылка;
					СтрПоказатель.ПериодОтчета=РабочаяОбласть.Расшифровка.ПериодОтчета;
					СтрПоказатель.НомерКолонки=НомКол;
					СтрПоказатель.СтрокаОтчета=НоваяСтрока.СтрокаОтчета;
					СтрПоказатель.ИмяКолонки="_"+НомКол;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Для НомКол=НомерКолонкиНачало ПО НомерКолонкиНачалоПоказателей-1 Цикл
				
				РабочаяОбласть=ИсходныйМакет.Область(НомСтр,НомКол,НомСтр,НомКол);
					
				Если ТипЗнч(РабочаяОбласть.Расшифровка)=Тип("ФиксированнаяСтруктура") Тогда
					
					СтрПравило=НоваяСтрока.ПравилаИспользованияПолейЗапроса.Добавить();
					СтрПравило.НомерКолонки		 = НомКол;
					СтрПравило.КодАналитики		 = РабочаяОбласть.Расшифровка.ТекущаяАналитика;
					СтрПравило.АналитикаОперанда = РабочаяОбласть.Расшифровка.ТекущаяАналитикассылка;
					СтрПравило.РеквизитАналитики = РабочаяОбласть.Расшифровка.ТекущаяАналитикаКлюч;
					СтрПравило.Поле				 = СтрПравило.КодАналитики+"."+СтрПравило.РеквизитАналитики;
					СтрПравило.Синоним			 = СтрПравило.КодАналитики+"vzv"+СтрПравило.РеквизитАналитики;
					СтрПравило.РеквизитАналитики = РабочаяОбласть.Расшифровка.ТекущаяАналитикаКлюч; 
					СтрПравило.НеиспользоватьДляСинхронизации=НеИспользоватьДляСинхронизации(СтрПравило.АналитикаОперанда,СтрПравило.РеквизитАналитики);
					
					ДанныеОбъекта=ОбщегоНазначенияУХ.ПолучитьДанныеОбъектаБД(СтрПравило.АналитикаОперанда);
					
					ЗаполнитьЗначенияСвойств(СтрПравило,ДанныеОбъекта);
					
					СтрПравило.ТаблицаАналитики=ДанныеОбъекта.ТипОбъектаМетаданных+"."+ДанныеОбъекта.ИмяОбъектаМетаданных;
					
					Если ДанныеОбъекта.ТипОбъектаМетаданных = "Перечисление" Тогда
						СтрПравило.ТипЗначения = ОбщегоНазначения.ОписаниеТипаСтрока(256);
					Иначе
						СтрПравило.ТипЗначения=ПолучитьТипЗначенияРеквизита(ДанныеОбъекта.ОбъектМетаданных,СтрПравило.РеквизитАналитики);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДанных=Новый Структура;
	СтруктураДанных.Вставить("НомерСтрокиНачало",				НомерСтрокиНачало);
	СтруктураДанных.Вставить("НомерКолонкиНачало",				НомерКолонкиНачало);
	СтруктураДанных.Вставить("НомерКолонкиНачалоПоказателей",	НомерКолонкиНачалоПоказателей);
	СтруктураДанных.Вставить("НомерКолонкиОкончаниеПоказателей",НомерКолонкиОкончаниеПоказателей);
	
	/////////////////////////////////////////
	// Получим данные из файла
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	Попытка
		
		ПолучитьИзВременногоХранилища(ОбъектРасчета.АдресХранилищаФайла).Записать(ИмяВременногоФайла);
		КаталогФайлов = ФайловаяСистема.СоздатьВременныйКаталог();
		
		ФайлАрхива = Новый ЧтениеZipФайла;
		ФайлАрхива.Открыть(ИмяВременногоФайла);
		ФайлАрхива.ИзвлечьВсе(КаталогФайлов, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		
		Если ТипЗнч(ОбъектРасчета.ИмяЛиста) = Тип("Строка") Или ОбъектРасчета.ИмяЛиста = Неопределено Тогда
			
			ФайлРабочейКниги = КаталогФайлов + "xl" + ПолучитьРазделительПути() + "workbook.xml";
			ЧтениеXML        = Новый ЧтениеXML;
			ЧтениеXML.ОткрытьФайл(ФайлРабочейКниги);
			
			ПостроительDOM = Новый ПостроительDOM;
			ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);
			Разыменователь = Новый РазыменовательПространствИменDOM(ДокументDOM);
			
			ЧтениеXML.Закрыть();
			
			ЭлементыSheets = ДокументDOM.ПолучитьЭлементыПоИмени("sheet");
			НомерТекущегоЛиста = 1;
			Для Каждого Sheet Из ЭлементыSheets Цикл
				ИмяЛиста = Sheet.ПолучитьАтрибут("name");
				Если ИмяЛиста = ОбъектРасчета.ИмяЛиста Тогда
					ОбъектРасчета.ИмяЛиста = НомерТекущегоЛиста;
					Прервать;
				КонецЕсли;
				НомерТекущегоЛиста = НомерТекущегоЛиста + 1;
			КонецЦикла;
			
			// Если не указано имя листа, то выбираем единственный лист в файле.
			Если ЭлементыSheets.Количество() = 1 И ПустаяСтрока(ОбъектРасчета.ИмяЛиста) Тогда
				ОбъектРасчета.ИмяЛиста = 1;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПустаяСтрока(ОбъектРасчета.ИмяЛиста) Тогда
			
			ТекстСообщения = Нстр("ru = 'Не указано имя листа файла Microsoft Excel'");
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ПолучитьДанныеИзФайла", , , ТекстСообщения);
			Возврат Ложь;
			
		КонецЕсли;
		
	Исключение
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Ошибка разбора файла Microsoft Excel: %1'"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ПолучитьДанныеИзФайла", , , ТекстСообщения);
		Возврат Ложь;
		
	КонецПопытки;
	
	Результат = РазобратьДанныеЛиста(
		ОбъектРасчета,
		ТаблицаСтрок,
		ТаблицаПоказателей,
		СтруктураДанных,
		КаталогФайлов);
		
	Попытка
		РаботаСФайламиУХ.УдалитьФайлыАсинхронно(ИмяВременногоФайла);
		РаботаСФайламиУХ.УдалитьФайлыАсинхронно(КаталогФайлов);
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ПолучитьДанныеИзФайла", , , ТекстСообщения);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьДанныеЛиста(ОбъектРасчета, ТаблицаСтрок, ТаблицаПоказателей, СтруктураДанных, КаталогФайлов = "")
		
	СтроковыеЗначенияXLSX = ДанныеФайлаSharedStringsXML(КаталогФайлов);
	
	ФайлЛиста = КаталогФайлов + "xl" + ПолучитьРазделительПути() 
		+ "worksheets" + ПолучитьРазделительПути() + "sheet" + ОбъектРасчета.ИмяЛиста + ".xml";
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлЛиста);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	Разыменователь = Новый РазыменовательПространствИменDOM(ДокументDOM);
	
	ЧтениеXML.Закрыть();
	
	ЭлементыROW = ДокументDOM.ПолучитьЭлементыПоИмени("row");
	
	ИменаКолонокXLSX = Новый Массив;
	
	Dimension        = ДокументDOM.ПолучитьЭлементыПоИмени("Dimension");
	ДиапазонДанных   = ЗначениеАтрибутаУзлаDOM(Dimension[0], "ref");
	ДиапазонКолонок  = УдалитьЦифрыИзСтроки(ДиапазонДанных);
	ПоследняяКолонка = Сред(ДиапазонКолонок, Найти(ДиапазонКолонок ,":") + 1);
	НомерПоследнейКолонки = НомерКолонкиПоИмени(ПоследняяКолонка);
	
	ТаблицаДанныхXLSX = Новый ТаблицаЗначений;
	
	Для НомерКолонки = 1 По НомерПоследнейКолонки Цикл
		ИмяКолонки = ИмяКолонкиПоНомеру(НомерКолонки);
		ИменаКолонокXLSX.Добавить(ИмяКолонки);
		ТаблицаДанныхXLSX.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	
	ВсегоКолонок = ИменаКолонокXLSX.Количество();

	ТаблицаСтрок.Колонки.Добавить("СтрокаДанныеНачало");
	ТаблицаСтрок.Колонки.Добавить("СтрокаДанныеОкончание");
	
	РабочаяСтрока = ТаблицаСтрок[0];
	РабочаяСтрока.СтрокаДанныеНачало = СтруктураДанных.НомерСтрокиНачало;
	
	ТекНаименованиеСтроки = РабочаяСтрока.СтрокаОтчетаНаименование;
	
	// Разбираем файл по областям, относящимся к данным каждой строки.
	СмещениеСтрок = СтруктураДанных.НомерСтрокиНачало;
	НачалоПоиска  = СтруктураДанных.НомерСтрокиНачало;
	
	Для Индекс = 1 По ТаблицаСтрок.Количество()-1 Цикл
		
		РабочаяСтрока = ТаблицаСтрок[Индекс];
		Результат = НайтиНомерСтрокиВXML(ДокументDOM, Разыменователь,
			СтроковыеЗначенияXLSX, РабочаяСтрока.СтрокаОтчетаНаименование);
		
		Если НЕ Результат = Неопределено Тогда
			
			РабочаяСтрока.СтрокаДанныеНачало = Результат.Row;
			НачалоПоиска = РабочаяСтрока.СтрокаДанныеНачало;
			
			ТаблицаСтрок[Индекс-1].СтрокаДанныеОкончание = РабочаяСтрока.СтрокаДанныеНачало - 1;
			
		Иначе
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'В файле %1 не найдена строка %2. Импорт остановлен.'"),
				ОбъектРасчета.ХранимыйФайл.Наименование, РабочаяСтрока.СтрокаОтчетаНаименование);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.РазобратьДанныеЛиста", , , ТекстСообщения);
			Возврат Ложь;
			
		КонецЕсли;
		
		Результат = Неопределено;
			
	КонецЦикла;
	
	// Заполним таблицу по данным строк в файле XLSX.
	НомерСтроки = 0;
	Для Каждого ЭлементСтрока ИЗ ЭлементыROW Цикл
		
		НомерСтроки = Строковыефункцииклиентсервер.СтрокаВЧисло(ЭлементСтрока.ПолучитьАтрибут("r"));
		Если НомерСтроки = Неопределено Или НомерСтроки < СмещениеСтрок Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДанныхXLSX.Добавить();
		
		ЭлементыCOL = ЭлементСтрока.ДочерниеУзлы;
		КоличествоДочернихУзлов = ЭлементСтрока.ДочерниеУзлы.Количество();
		Для Каждого ЭлементКолонка Из ЭлементыCOL Цикл
			
			ИмяКолонки =  ЭлементКолонка.ПолучитьАтрибут("r");
			ИмяКолонкиБезЦифр = УдалитьЦифрыИзСтроки(ИмяКолонки);
			ИндексКолонки = ИменаКолонокXLSX.Найти(ИмяКолонкиБезЦифр) + 1;
			
			ЗначениеЯчейки = ЗначениеВЯчейке(ЭлементКолонка, ИменаКолонокXLSX, СтроковыеЗначенияXLSX);
			Если ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
				НоваяСтрока[ИндексКолонки - 1] = ЗначениеЯчейки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если РабочаяСтрока.ПравилаИспользованияПолейЗапроса.Количество() = 0 Тогда
		// Это синтетика
		РабочаяСтрока.СтрокаДанныеОкончание = РабочаяСтрока.СтрокаДанныеНачало;
	Иначе
		// Т.к. в шапке могут быть объединенные строки, берем максимальный номер строки с данными.
		РабочаяСтрока.СтрокаДанныеОкончание = НомерСтроки;
	КонецЕсли;
	
	// Получаем и записываем значения.
	ОбъектРасчета.тИзмененныеПоказатели = УправлениеРасчетомПоказателей.ОписаниеТаблицыИзмененныхПоказателей();
	ТипЧислоПоказателя = КэшируемыеПроцедурыУХ.ПолучитьОписаниеТиповЧисла(18, 5);
	
	Для ИндексСтроки = 0 По ТаблицаСтрок.Количество()-1 Цикл

		Строка = ТаблицаСтрок[ИндексСтроки];
		
		ШаблонТаблицыПоказателей = Новый ТаблицаЗначений;
		
		ПоказателиСтроки = ТаблицаПоказателей.Скопировать(Новый Структура("СтрокаОтчета",Строка.СтрокаОтчета));
		Если ПоказателиСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Показатель Из ПоказателиСтроки Цикл
			
			ШаблонТаблицыПоказателей.Колонки.Добавить(
				Показатель.ИмяКолонки,
				КэшируемыеПроцедурыУХ.ПолучитьОписаниеТипаПоТипуПоказателя(Показатель.ПоказательОтчета.ТипЗначения));
			
		КонецЦикла;
		
		// Записываем синтетические значения
		ТекТаблицаПоказателейСинтетика = ШаблонТаблицыПоказателей.Скопировать();
		СтрокаСинтетика                = ТекТаблицаПоказателейСинтетика.Добавить();
		
		ТекущаяСтрока = ЭлементыROW[Строка.СтрокаДанныеНачало - 1];
		ЯчейкиСтроки  = ТекущаяСтрока.ДочерниеУзлы;
		
		Если СтруктураДанных.НомерКолонкиНачалоПоказателей = СтруктураДанных.НомерКолонкиОкончаниеПоказателей Тогда
			
			ТекТаблицаПоказателейСинтетика[0][0] = ТаблицаДанныхXLSX[Строка.СтрокаДанныеНачало - СмещениеСтрок][СтруктураДанных.НомерКолонкиНачалоПоказателей - 1];
			
		Иначе
			
			Для Каждого СтрПоказатель Из ПоказателиСтроки Цикл
				
				Если ТаблицаДанныхXLSX.Колонки.Количество() <= СтрПоказатель.НомерКолонки - 1 Тогда
					Прервать;
				КонецЕсли;
			
				ТекТаблицаПоказателейСинтетика[0][СтрПоказатель.ИмяКолонки] =
					ТаблицаДанныхXLSX[Строка.СтрокаДанныеНачало - СмещениеСтрок][СтрПоказатель.НомерКолонки - 1];
			
			КонецЦикла;
			
		КонецЕсли;
		
		Если Строка.СтрокаДанныеНачало = Строка.СтрокаДанныеОкончание Тогда
			//Это синтетика без аналитики
			ДобавитьСтрокиДляЗаписиЧерезЛог(ОбъектРасчета, ТекТаблицаПоказателейСинтетика, ПоказателиСтроки);
		КонецЕсли;
		
		Если Строка.СтрокаДанныеНачало=Строка.СтрокаДанныеОкончание
			ИЛИ Строка.ПравилаИспользованияПолейЗапроса.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Синхронизируем значения аналитических раскрытий
		НомерКолонкиНачало    = Строка.ПравилаИспользованияПолейЗапроса[0].НомерКолонки;
		НомерКолонкиОкончание = Строка.ПравилаИспользованияПолейЗапроса[Строка.ПравилаИспользованияПолейЗапроса.Количество()-1].НомерКолонки;
		
		Если ИндексСтроки=ТаблицаСтрок.Количество()-1 Тогда
			
			ЕстьЗаполненнаяАналитика = Ложь;
			
			Для НомерКолонкиПроверка = НомерКолонкиНачало ПО НомерКолонкиОкончание Цикл
				
				НовоеЗначение = ТаблицаДанныхXLSX[Строка.СтрокаДанныеНачало +1 - СмещениеСтрок][НомерКолонкиПроверка];
				
				Если ЗначениеЗаполнено(НовоеЗначение) Тогда
					
					ЕстьЗаполненнаяАналитика = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ЕстьЗаполненнаяАналитика Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ТаблицаАналитики = Новый ТаблицаЗначений;
		СоответствиеКолонок = Новый Соответствие;
		
		Для Индекс=0 ПО Строка.ПравилаИспользованияПолейЗапроса.Количество()-1  Цикл
			ТаблицаАналитики.Колонки.Добавить(Строка.ПравилаИспользованияПолейЗапроса[Индекс].Синоним,Строка.ПравилаИспользованияПолейЗапроса[Индекс].ТипЗначения);
			СоответствиеКолонок.Вставить(Строка.ПравилаИспользованияПолейЗапроса[Индекс].НомерКолонки-НомерКолонкиНачало,Строка.ПравилаИспользованияПолейЗапроса[Индекс].Синоним);
		КонецЦикла;
		
		Для Индекс=(Строка.СтрокаДанныеНачало+1) ПО Строка.СтрокаДанныеОкончание Цикл
			СтрАналитика=ТаблицаАналитики.Добавить();
		КонецЦикла;

		Если НомерКолонкиНачало = НомерКолонкиОкончание
			И (Строка.СтрокаДанныеНачало + 1) = Строка.СтрокаДанныеОкончание Тогда // Одна ячейка
			ТаблицаАналитики[0][0] = ТаблицаДанныхXLSX[Строка.СтрокаДанныеНачало + 1 - СмещениеСтрок][НомерКолонкиНачало - 1];
		Иначе
			
			МассивАналитик = Новый Массив;
			
			Для НомерКолонки = НомерКолонкиНачало По НомерКолонкиОкончание Цикл
				МассивКолонка  = Новый Массив;
				Для НомерСтроки = Строка.СтрокаДанныеНачало+1 По Строка.СтрокаДанныеОкончание Цикл
					
					НовоеЗначение = ТаблицаДанныхXLSX[НомерСтроки - СмещениеСтрок][НомерКолонки - 1];
					МассивКолонка.Добавить(НовоеЗначение);
				КонецЦикла;
				МассивАналитик.Добавить(МассивКолонка);
			КонецЦикла;
			
			Для Индекс = 0 По МассивАналитик.Количество()-1 Цикл
				
				ИмяКолонки=СоответствиеКолонок.Получить(Индекс);
				
				Если ИмяКолонки=Неопределено Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				Если ТаблицаАналитики.Колонки[ИмяКолонки].ТипЗначения.Типы()[0]=Тип("Строка") Тогда
					
					Для НомСтр = 0 ПО ТаблицаАналитики.Количество()-1 Цикл
						
						НовоеЗначение = ТаблицаДанныхXLSX[Строка.СтрокаДанныеНачало + 1 + НомСтр - СмещениеСтрок][НомерКолонкиНачало + Индекс - 1];
						
						ТаблицаАналитики[НомСтр][ИмяКолонки] = НовоеЗначение;
						
					КонецЦикла;
					
				Иначе
					
					ТаблицаАналитики.ЗагрузитьКолонку(МассивАналитик[Индекс],ИмяКолонки);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ДобавитьКолонкуНомерСтроки(ТаблицаАналитики);
		
		Если ТаблицаАналитики.Количество()>0 Тогда
			
			ТабГруппыРаскрытия = ТрансформироватьВнешниеДанные(ОбъектРасчета,ТаблицаАналитики,Строка.ПравилаИспользованияПолейЗапроса);
			
			Если ТабГруппыРаскрытия.Количество()=0 Тогда // ошибки при синхронизации аналитик
				ТекстСообщения = Нстр("ru = 'Ошибка при синхронизации аналитик.'");
				ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.РазобратьДанныеЛиста", , , ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		// Получаем таблицу значений показателей
		ТекТаблицаПоказателейАналитика = ШаблонТаблицыПоказателей.СкопироватьКолонки();
		
		Для Индекс=(Строка.СтрокаДанныеНачало+1) По Строка.СтрокаДанныеОкончание Цикл
			СтрАналитика=ТекТаблицаПоказателейАналитика.Добавить();
		КонецЦикла;
		
		Если (Строка.СтрокаДанныеНачало+1) = Строка.СтрокаДанныеОкончание
			И СтруктураДанных.НомерКолонкиНачалоПоказателей = СтруктураДанных.НомерКолонкиОкончаниеПоказателей Тогда
			ТекТаблицаПоказателейАналитика[0][0] = ТаблицаДанныхXLSX[Строка.СтрокаДанныеОкончание - СмещениеСтрок][СтруктураДанных.НомерКолонкиНачалоПоказателей - 1];
		Иначе
			
			Для Каждого СтрПоказатель ИЗ ПоказателиСтроки Цикл
				
				ТипЗначения = ТекТаблицаПоказателейАналитика.Колонки.Найти(СтрПоказатель.ИмяКолонки).ТипЗначения;
				
				МассивКолонка = Новый Массив;
				
				Для НомерСтроки = Строка.СтрокаДанныеНачало+1 По Строка.СтрокаДанныеОкончание Цикл
					
					Если ТаблицаДанныхXLSX.Колонки.Количество() <= СтрПоказатель.НомерКолонки - 1 Тогда
						Прервать;
					КонецЕсли;
					
					НовоеЗначение = ТаблицаданныхXLSX[НомерСтроки - СмещениеСтрок][СтрПоказатель.НомерКолонки - 1];
					Если ТипЗначения = ТипЧислоПоказателя Тогда
						НовоеЗначение = ОбщегоНазначенияУХ.ВыполнитьПреобразованиеТипов(НовоеЗначение, "Строка", "Число");
					ИначеЕсли ТипЗначения = Новый ОписаниеТипов("Дата") Тогда
						// Excel хранит только значение смещения в днях даты от 01.01.1900.
						Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(НовоеЗначение) Тогда
							ПорядковыйНомерДня = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(НовоеЗначение);
							// Обход ошибки Excel с порядковым номером 29 февраля 1900 года(такого дня не существет).
							Если ПорядковыйНомерДня < 30 Тогда
								СмещениеДатыВДнях = (ПорядковыйНомерДня - 1) * 86400;
							Иначе
								СмещениеДатыВДнях = (ПорядковыйНомерДня - 2) * 86400;
							КонецЕсли;
							НовоеЗначение = Дата(1900, 01, 01) + СмещениеДатыВДнях;
						Иначе
							НовоеЗначение = ОбщегоНазначенияУХ.ВыполнитьПреобразованиеТипов(НовоеЗначение, "Строка", "Дата");
						КонецЕсли;
					КонецЕсли;
					
					МассивКолонка.Добавить(НовоеЗначение);
				КонецЦикла;
				
				МассивПоказателей = Новый Массив;
				МассивПоказателей.Добавить(МассивКолонка);
				
				ТекТаблицаПоказателейАналитика.ЗагрузитьКолонку(МассивПоказателей[0], СтрПоказатель.ИмяКолонки);
				
			КонецЦикла;
				
		КонецЕсли;
		
		ДобавитьКолонкуНомерСтроки(ТекТаблицаПоказателейАналитика);
		
		ДобавитьСтрокиДляЗаписиЧерезЛог(ОбъектРасчета, ТекТаблицаПоказателейАналитика, ПоказателиСтроки, ТабГруппыРаскрытия);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция НайтиНомерСтрокиВXML(ДокументDOM, Разыменователь, СтроковыеЗначенияXLSX, НаименованиеСтроки)
	
	ИндексСтроки = СтроковыеЗначенияXLSX.Найти(НаименованиеСтроки);
	
	Если ИндексСтроки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗаголовокГруппировки = ДокументDOM.ВычислитьВыражениеXPath(
		"//*[starts-with(local-name(), 'c') and @t='s']",
		ДокументDOM,
		Разыменователь);
	Результат = Неопределено;
	
	Пока Истина Цикл
		ТекущийЗаголовокГруппировки = ЗаголовокГруппировки.ПолучитьСледующий();
		Если ТекущийЗаголовокГруппировки = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ТекущийЗаголовокГруппировки.ТекстовоеСодержимое = Формат(ИндексСтроки, "ЧН=0; ЧГ=0") Тогда
			РодительскийУзел = ТекущийЗаголовокГруппировки.РодительскийУзел;
			НомерСтроки      = Число(РодительскийУзел.ПолучитьАтрибут("r"));
			Результат        = Новый Структура("Row", НомерСтроки);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		СтроковыеЗначенияXLSX[ИндексСтроки] = НСтр("ru='_не найден_'") + СтроковыеЗначенияXLSX[ИндексСтроки];
		Возврат НайтиНомерСтрокиВXML(ДокументDOM, Разыменователь, СтроковыеЗначенияXLSX, НаименованиеСтроки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НеИспользоватьДляСинхронизации(ВидАналитики, ИмяРеквизита)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыСубконтоКорпоративныеРеквизитыДляСинхронизации.Ключ КАК Ключ
		|ИЗ
		|	ПланВидовХарактеристик.ВидыСубконтоКорпоративные.РеквизитыДляСинхронизации КАК ВидыСубконтоКорпоративныеРеквизитыДляСинхронизации
		|ГДЕ
		|	ВидыСубконтоКорпоративныеРеквизитыДляСинхронизации.Ссылка = &Ссылка
		|	И ВидыСубконтоКорпоративныеРеквизитыДляСинхронизации.ИмяРеквизита = &ИмяРеквизита";
	
	Запрос.УстановитьПараметр("Ссылка", ВидАналитики);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат НЕ Результат.Ключ;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТипЗначенияРеквизита(ОбъектМетаданных, ИмяРеквизита)
	
	Если ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		
		Возврат ОбъектМетаданных.СтандартныеРеквизиты[ИмяРеквизита].Тип;
		
	Иначе
		
		Возврат ОбъектМетаданных.Реквизиты[ИмяРеквизита].Тип;
		
	КонецЕсли;
	
КонецФункции

Функция ТрансформироватьВнешниеДанные(КонтекстОтчета, ТаблицаДанных, ПравилаИспользованияПолей, ИспользуемаяИБ=Неопределено)
	
	РежимРасшифровки = ?(ЗначениеЗаполнено(РежимРасшифровки), РежимРасшифровки, Ложь);
	
	МассивАналитик=Новый Массив;
	
	Результат = ЗаполнитьАналитикуПоПравилам(КонтекстОтчета,ТаблицаДанных,ПравилаИспользованияПолей,МассивАналитик,КонтекстОтчета.Организация);
	
	Если ТаблицаДанных.Количество()>0 И Результат.Количество()=0 Тогда
		
		ФлагОшибкиИмпорта=Истина;
		Возврат Результат;
		
	КонецЕсли;
	
	// Проверим, все ли аналитики найдены
	КэшОпределенныхЗначений = Новый Структура;
	Для Каждого Аналитика Из МассивАналитик Цикл
		
		ТекТаблица = Новый ТаблицаЗначений;
		
		Для Каждого Элемент Из ПравилаИспользованияПолей.Скопировать(Новый Структура("КодАналитики", Аналитика), "РеквизитАналитики").ВыгрузитьКолонку("РеквизитАналитики") Цикл
			ТекТаблица.Колонки.Добавить(Элемент);	
		КонецЦикла;
		
		ТекТаблица.Колонки.Добавить("СсылкаНаЭлементСправочника");
		
		КэшОпределенныхЗначений.Вставить(Аналитика, ТекТаблица);
		
	КонецЦикла;
	
	ДанныеВидыСубконто=Новый Соответствие;
	
	Для Каждого Строка ИЗ ПравилаИспользованияПолей Цикл
		
		ДанныеВидыСубконто.Вставить(Строка.АналитикаОперанда,ОбщегоНазначенияУХ.ПолучитьДанныеОбъектаБД(Строка.АналитикаОперанда));
		
	КонецЦикла;
	
	Для Каждого СтрДанные Из Результат Цикл
		
		Для Каждого Аналитика ИЗ МассивАналитик Цикл
			
			СтруктураПоиска=Новый Структура("КодАналитики",Аналитика);
			МассивДанныхАналитики=ПравилаИспользованияПолей.НайтиСтроки(СтруктураПоиска);
			
			ТекВидСубконто=ДанныеВидыСубконто[МассивДанныхАналитики[0].АналитикаОперанда];
	
			Если СтрДанные[Аналитика]= Null Тогда
				
				ИмяСправочника=СтрЗаменить(МассивДанныхАналитики[0].ТаблицаАналитики,"Справочник.","");
				ТаблицаСправочника=МассивДанныхАналитики[0].ТаблицаАналитики;
				ВидСубконто=МассивДанныхАналитики[0].АналитикаОперанда;
				ЭтоПеречисление = СтрНачинаетсяС(ИмяСправочника, "Перечисление.");
				
				ПустоеЗначениеАналитики = Истина; // Признак того, что импортируется запись с неопределенным значением аналитики.
				
				Для Каждого СтрПоля Из МассивДанныхАналитики Цикл
					Если ЗначениеЗаполнено(СтрДанные[СтрПоля.Синоним]) Тогда
						ПустоеЗначениеАналитики = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ПустоеЗначениеАналитики Тогда
					СтрДанные[Аналитика] = ПустаяСсылка(ИмяСправочника, ЭтоПеречисление);
				ИначеЕсли ТекВидСубконто.СоздаватьПриНеудачномПоискеПриИмпорте И НЕ РежимРасшифровки Тогда
					СтруктураЗаписи = Новый Структура;
					
					ЕстьСоответствиеПоКоду = Ложь;
					
					Для Каждого СтрПоля ИЗ МассивДанныхАналитики Цикл 
						
						Если СтрПоля.РеквизитАналитики="Код" Тогда
							
							ЕстьСоответствиеПоКоду=Истина;
							
						КонецЕсли;
						
						СтруктураЗаписи.Вставить(СтрПоля.РеквизитАналитики, СтрДанные[СтрПоля.Синоним]);
						
					КонецЦикла;
					
					НайденныеСтроки = КэшОпределенныхЗначений[Аналитика].НайтиСтроки(СтруктураЗаписи);
					Если НайденныеСтроки.Количество() = 0 Тогда
						Попытка
							ЭлСпр = Справочники[ИмяСправочника].СоздатьЭлемент();
							Если ТаблицаСправочника = "Справочник.ПроизвольныйКлассификаторУХ" Тогда
								ЭлСпр.Владелец = ВидСубконто;
								Если ТекВидСубконто.РазделятьПоОрганизациям Тогда
									ЭлСпр.Организация = КонтекстОтчета.Организация;
								КонецЕсли;
							КонецЕсли;
							
							ЗаполнитьЗначенияСвойств(ЭлСпр, СтруктураЗаписи);
							
							Если Не ЕстьСоответствиеПоКоду Тогда
								ЭлСпр.УстановитьНовыйКод();
							КонецЕсли;
							
							Если ОбщегоНазначенияУХ.ЕстьРеквизитОбъекта("ВИБ",ЭлСпр) Тогда
								ЭлСпр.ВИБ=ИспользуемаяИБ;
							КонецЕсли;
							
							ЭлСпр.Записать();
							СтрДанные[Аналитика]=ЭлСпр.Ссылка;
							СтруктураЗаписи.Вставить("СсылкаНаЭлементСправочника", ЭлСпр.Ссылка);
							
							НоваяСтрока = КэшОпределенныхЗначений[Аналитика].Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураЗаписи);
							НоваяСтрока.СсылкаНаЭлементСправочника = ЭлСпр.Ссылка;
							
						Исключение
							
							ФлагОшибкиИмпорта = Истина;
							
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Не удалось создать элемент справочника %1:
								|%2
								|Свойства элемента:%3'"),
								ИмяСправочника, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС);
								
							Для Каждого СтрПоля ИЗ МассивДанныхАналитики Цикл	
								ТекстСообщения = ТекстСообщения + (СтрПоля.Поле+" - "+СтрДанные[СтрПоля.Синоним])+Символы.ПС;
							КонецЦикла;
								
							ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ТрансформироватьВнешниеДанные", , , ТекстСообщения);
						
						КонецПопытки;
						
					Иначе
						СтрДанные[Аналитика] = НайденныеСтроки[0].СсылкаНаЭлементСправочника;
					КонецЕсли;
					
				Иначе // если флажок создания при неудачном поиске не взведен...
					
					СтрДанные[Аналитика] = ПустаяСсылка(ИмяСправочника, ЭтоПеречисление);
					
					Если КонтекстОтчета.Свойство("ТихийРежим") Тогда
						ФлагОшибкиИмпорта = Истина;
					КонецЕсли;
						
					ТекстЗначенияРеквизитов = "";
					
					Для Каждого СтрПоля ИЗ МассивДанныхАналитики Цикл
						
						Если НЕ СтрПоля.НеИспользоватьДляСинхронизации Тогда
							
							ТекстЗначенияРеквизитов = ТекстЗначенияРеквизитов+(СтрПоля.Поле+" - "+СтрДанные[СтрПоля.Синоним])+Символы.ПС;
							
						КонецЕсли;
							
					КонецЦикла;
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Не удается найти значение аналитики %1
					|Значения реквизитов аналитики: 
					|%2'"), Аналитика, ТекстЗначенияРеквизитов);
					
					ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ТрансформироватьВнешниеДанные", , , ТекстСообщения);
					
				КонецЕсли;
				
			ИначеЕсли ТекВидСубконто.ОбновлятьРеквизитыПриИмпорте И НЕ РежимРасшифровки Тогда
				
				ЕстьИзменения=Ложь;
				
				СтруктураЗаписи = Новый Структура;
				
				Для Каждого СтрПоля ИЗ МассивДанныхАналитики Цикл 
					
					Если НЕ СокрЛП(СтрДанные[Аналитика][СтрПоля.РеквизитАналитики])=СокрЛП(СтрДанные[СтрПоля.Синоним]) Тогда
						
						СтруктураЗаписи.Вставить(СтрПоля.РеквизитАналитики, СтрДанные[СтрПоля.Синоним]);
						
						ЕстьИзменения=Истина;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЕстьИзменения Тогда
					
					ТекОбъект = СтрДанные[Аналитика].ПолучитьОбъект();
					
					ЗаполнитьЗначенияСвойств(ТекОбъект, СтруктураЗаписи);
					
					Попытка
						
						ТекОбъект.Записать();
						
					Исключение
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Не удалось обновить данные по элементу справочника %1'"),
							ТекОбъект.Наименование);
						
						ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ТрансформироватьВнешниеДанные", , , ТекстСообщения);
						
					КонецПопытки;
					
					ТекОбъект = Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат Результат;
		
КонецФункции

Функция ПустаяСсылка(ИмяСправочника, ЭтоПеречисление)
	
	Если ЭтоПеречисление Тогда
		ИмяПеречисления = СтрРазделить(ИмяСправочника, ".")[1];
		Возврат Перечисления[ИмяПеречисления].ПустаяСсылка();
	Иначе
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьАналитикуПоПравилам(ОбъектРасчета,ТаблицаДанных,ПравилаИспользованияПолей,МассивАналитик, Организация = Неопределено)
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Если ПравилаИспользованияПолей.Количество()=0
		ИЛИ (ПравилаИспользованияПолей.Количество()=1 И ПустаяСтрока(ПравилаИспользованияПолей[0].КодАналитики)) Тогда
		
		Возврат ТаблицаДанных;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	ТекстВыбор="";
	ТекстСоединенияТаблица="";
	ТекстСоединенияРеквизиты="";
	ТекстСоединенияКонтрагент="";
	ТекстСоединенияОрганизация="";
	ТекстСоединенияОрганизацияДоговор="";
	
	Аналитика="";
	ТекстСвертка="";
	
	ТекстИменКолонок = "";
	Для Инд = 0 По ТаблицаДанных.Колонки.Количество() - 1 Цикл
		
		ТекстИменКолонок = ТекстИменКолонок + ", " + ТаблицаДанных.Колонки[Инд].Имя;
		
	КонецЦикла;
	
	ТекстИменКолонок = Сред(ТекстИменКолонок, 2);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыУничтоженияВТ = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаВТ_ВременнаяТаблица(ТекстыУничтоженияВТ));
	
	ТабГруппировкиДубли=Новый ТаблицаЗначений;
	ТабГруппировкиДубли.Колонки.Добавить("КодАналитики");
	ТабГруппировкиДубли.Колонки.Добавить("ТаблицаАналитики");
	ТабГруппировкиДубли.Колонки.Добавить("МассивПолей");
	
	Запрос=Новый Запрос;
	
	Для Каждого СтрПоле ИЗ ПравилаИспользованияПолей Цикл
		
		Если ПустаяСтрока(СтрПоле.КодАналитики) ИЛИ СтрПоле.НеИспользоватьДляСинхронизации Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СтрГруппировкиДубли=ТабГруппировкиДубли.Найти(СтрПоле.КодАналитики,"КодАналитики");
		
		Если СтрГруппировкиДубли=Неопределено Тогда
			
			СтрГруппировкиДубли=ТабГруппировкиДубли.Добавить();
			ЗаполнитьЗначенияСвойств(СтрГруппировкиДубли,СтрПоле);
			
			МассивПолей=Новый Массив;
			МассивПолей.Добавить(СтрПоле.Синоним);
			
			СтрГруппировкиДубли.МассивПолей=МассивПолей;
			
		Иначе
			
			СтрГруппировкиДубли.МассивПолей.Добавить(СтрПоле.Синоним);
			
		КонецЕсли;
			
		Если НЕ СтрПоле.КодАналитики=Аналитика Тогда
			
			Если СтрНайти(СтрПоле.ТаблицаАналитики, "Перечисление") > 0 Тогда
				
				ЗначенияПеречисления = НовыеЗначенияПеречисления(СтрПоле);
				ТекстыЗапросов.Добавить(ТекстЗапросаВТ_ЗначенияПеречисления(СтрПоле.КодАналитики, ТекстыУничтоженияВТ));
				Запрос.УстановитьПараметр("ЗначенияПеречисления" + СтрПоле.КодАналитики, ЗначенияПеречисления);
				
				ТекстСоединенияТаблица=ТекстСоединенияТаблица+Сред(ТекстСоединенияРеквизиты,(СтрДлина("И")+2))+"
				|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Перечисления"+СтрПоле.КодАналитики+" КАК Таблица"+СтрПоле.КодАналитики+" ПО";
				
			Иначе
				
				ТекстСоединенияТаблица=ТекстСоединенияТаблица+Сред(ТекстСоединенияРеквизиты,(СтрДлина("И")+2))+"
				|	ЛЕВОЕ СОЕДИНЕНИЕ "+СтрПоле.ТаблицаАналитики+" КАК Таблица"+СтрПоле.КодАналитики+" ПО";
				
			КонецЕсли;
			
			ТекстВыбор=ТекстВыбор+"
			|	Таблица"+СтрПоле.КодАналитики+".Ссылка КАК "+СтрПоле.КодАналитики + ", ";
			
			ТекстСвертка=ТекстСвертка+","+СтрПоле.КодАналитики;
			МассивАналитик.Добавить(СтрПоле.КодАналитики);
			
			Если СтрПоле.КодАналитики="АналитикаДоговорКонтрагента" Тогда
				
				ТекстСоединенияТаблица=ТекстСоединенияТаблица+"#ВладелецКонтрагент#"+"#ОрганизацияДоговор";
				
			КонецЕсли;
			
			Если СтрПоле.КодАналитики="АналитикаБанковскийСчетКасса" Тогда
				
				ТекстСоединенияТаблица=ТекстСоединенияТаблица+"#ВладелецОрганизация#";
				
			КонецЕсли;
			
			ТекстСоединенияРеквизиты="";
			Аналитика=СтрПоле.КодАналитики;
			
		КонецЕсли;
		
		ТекстСоединенияРеквизиты=ТекстСоединенияРеквизиты+" И "+"ВТ."+СтрПоле.Синоним+" = Таблица"+СтрПоле.КодАналитики+"."+СтрПоле.РеквизитАналитики;
		
		Если Аналитика="АналитикаКонтрагент" Тогда
			ТекстСоединенияКонтрагент=ТекстСоединенияКонтрагент+" И "+"ВТ."+СтрПоле.Синоним+"=АналитикаДоговорКонтрагента.Владелец"+"."+СтрПоле.РеквизитАналитики;
		КонецЕсли;
		
		Если Аналитика="АналитикаОрганизация" Тогда
			ТекстСоединенияОрганизация=ТекстСоединенияОрганизация+" И "+"ВТ."+СтрПоле.Синоним+"=АналитикаБанковскийСчетКасса.Владелец"+"."+СтрПоле.РеквизитАналитики;
			ТекстСоединенияОрганизацияДоговор=ТекстСоединенияОрганизацияДоговор+" И "+"ВТ."+СтрПоле.Синоним+"=АналитикаДоговорКонтрагента.Организация."+СтрПоле.РеквизитАналитики;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрПоле.АналитикаОперанда) И СтрПоле.АналитикаОперанда.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ")) Тогда
			
			ТекстСоединенияРеквизиты = ТекстСоединенияРеквизиты + " И Таблица" + СтрПоле.КодАналитики + ".Владелец = &" 
			+ СтрПоле.КодАналитики + "Владелец";
			Если СтрПоле.РазделятьПоОрганизациям Тогда 
				ТекстСоединенияРеквизиты = ТекстСоединенияРеквизиты + " И Таблица" + СтрПоле.КодАналитики + ".Организация = &" + СтрПоле.КодАналитики + "Организация";
				Запрос.УстановитьПараметр(СтрПоле.КодАналитики + "Организация", Организация);
			КонецЕсли;
			
			Запрос.УстановитьПараметр(СтрПоле.КодАналитики + "Владелец", СтрПоле.АналитикаОперанда); 
			
		ИначеЕсли СтрПоле.ТаблицаАналитики="Справочник.СчетаБД" ИЛИ СтрПоле.ТаблицаАналитики="Справочник.КорреспонденцииВГО" Тогда
			
			ТекстСоединенияРеквизиты = ТекстСоединенияРеквизиты + " И Таблица" + СтрПоле.КодАналитики + ".Владелец = &" 
			+ СтрПоле.КодАналитики + "Владелец";
			
			Если ЗначениеЗаполнено(ОбъектРасчета.ВидОтчета.ПланСчетов) Тогда
				
				Запрос.УстановитьПараметр(СтрПоле.КодАналитики + "Владелец", ОбъектРасчета.ВидОтчета.ПланСчетов);
				
			Иначе
				
				Запрос.УстановитьПараметр(СтрПоле.КодАналитики + "Владелец", УправлениеОтчетамиУХ.ПолучитьПланСчетовОрганизации(ОбъектРасчета.Организация,ОбъектРасчета.Сценарий,ОбъектРасчета.ПериодОтчета));			
				
			КонецЕсли;
		
		ИначеЕсли СтрПоле.ТаблицаАналитики="Справочник.ПодразделенияОрганизаций"  Тогда
			
			ТекстСоединенияРеквизиты = ТекстСоединенияРеквизиты + " И Таблица" + СтрПоле.КодАналитики + ".Владелец = &" 
			+ СтрПоле.КодАналитики + "Владелец";
			
			Запрос.УстановитьПараметр(СтрПоле.КодАналитики + "Владелец", Организация);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТекстСоединенияКонтрагент) Тогда
		
		ТекстСоединенияТаблица=СтрЗаменить(ТекстСоединенияТаблица,"#ВладелецКонтрагент#",Сред(ТекстСоединенияКонтрагент,(СтрДлина("И")+2))+" И ")
		
	Иначе
		
		ТекстСоединенияТаблица=СтрЗаменить(ТекстСоединенияТаблица,"#ВладелецКонтрагент#","");
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстСоединенияОрганизация) Тогда
		
		ТекстСоединенияТаблица=СтрЗаменить(ТекстСоединенияТаблица,"#ВладелецОрганизация#",Сред(ТекстСоединенияОрганизация,(СтрДлина("И")+2))+" И ")
		
	Иначе
		
		ТекстСоединенияТаблица=СтрЗаменить(ТекстСоединенияТаблица,"#ВладелецОрганизация#","");
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстСоединенияОрганизацияДоговор) Тогда
		
		ТекстСоединенияТаблица=СтрЗаменить(ТекстСоединенияТаблица,"#ОрганизацияДоговор",Сред(ТекстСоединенияОрганизацияДоговор,(СтрДлина("И")+2))+" И ")
		
	Иначе
		
		ТекстСоединенияТаблица=СтрЗаменить(ТекстСоединенияТаблица,"#ОрганизацияДоговор","");
		
	КонецЕсли;
	
	ТекстСоединенияТаблица=ТекстСоединенияТаблица+Сред(ТекстСоединенияРеквизиты,(СтрДлина("И")+2));
	
	ТекстВыбор = "ВЫБРАТЬ ВТ.* " + ?(СтрДлина(ТекстВыбор) > 2,", " + Лев(ТекстВыбор, СтрДлина(ТекстВыбор) - 2), "");
	
	ТекстыЗапросов.Добавить(ТекстЗапросаВТ_РезультатыРасчета(ТекстВыбор, ТекстСоединенияТаблица, ТекстыУничтоженияВТ));
	ТекстыЗапросов.Добавить("ВЫБРАТЬ * ИЗ РезультатыРасчета");
	ПоследнийПакетИндекс = ТекстыЗапросов.ВГраница();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТекстыЗапросов, ТекстыУничтоженияВТ);
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВнешнийИсточник", ТаблицаДанных);
	РезЗапроса = Запрос.ВыполнитьПакет();
	
	ТабРезультат = РезЗапроса[ПоследнийПакетИндекс].Выгрузить();
		
	Если НЕ ТабРезультат.Количество()=ТаблицаДанных.Количество() Тогда // Некорректная синхронизация с возникновением дублирующихся строк
		
		СоответствиеТаблицДублей=ПолучитьСоответствиеТаблицДублей(ТабРезультат,ТабГруппировкиДубли);
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'При импорте данных из файла %1 
			|возникли неоднозначности при синхронизации реквизитов аналитик, приводящие к дублированию данных. 
			|Импорт прекращен.'"),
			ОбъектРасчета.ХранимыйФайл.Наименование);
		
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ЗаполнитьАналитикуПоПравилам", , , ТекстСообщения);
		
		Для Каждого КлючИЗначение ИЗ СоответствиеТаблицДублей Цикл
			
			Для Каждого Строка ИЗ КлючИЗначение.Значение Цикл
				
				СтрРеквизиты="";
				
				Для Каждого Колонка ИЗ КлючИЗначение.Значение.Колонки Цикл
					
					Если Колонка.Имя="КоличествоДублей" Тогда
						
						Продолжить;
						
					КонецЕсли;
					
					СтрРеквизиты=СтрРеквизиты+", "+Колонка.Имя+": "+Строка[Колонка.Имя];
					
				КонецЦикла;
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = '%1Количество дублей: %2'"), 
					КлючИЗначение.Ключ+Символы.ПС+Сред(СтрРеквизиты,(СтрДлина("И")+2))+Символы.ПС, Строка.КоличествоДублей);
				
				ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("ОбщийМодуль.ИмпортДанныхБланкУХ.ЗаполнитьАналитикуПоПравилам", , , ТекстСообщения);

			КонецЦикла;
			
		КонецЦикла;
			
		ТабРезультат.Очистить();
			
	КонецЕсли;
	
	Возврат ТабРезультат;
		
КонецФункции

Функция ТекстЗапросаВТ_ВременнаяТаблица(ТекстыУничтоженияВТ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ *
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ &ВнешнийИсточник КАК ВнешнийИсточник";
	
	ТекстыУничтоженияВТ.Добавить("УНИЧТОЖИТЬ ВременнаяТаблица");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ЗначенияПеречисления(КодАналитики, ТекстыУничтоженияВТ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗначенияПеречисления.Ссылка КАК Ссылка,
	|	ЗначенияПеречисления.Наименование КАК Наименование
	|ПОМЕСТИТЬ ВТ_Перечисления" + КодАналитики + "
	|ИЗ &ЗначенияПеречисления" + КодАналитики + " КАК ЗначенияПеречисления";
	
	ТекстыУничтоженияВТ.Добавить("УНИЧТОЖИТЬ ВТ_Перечисления" + КодАналитики);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_РезультатыРасчета(ТекстВыбор, ТекстСоединенияТаблица, ТекстыУничтоженияВТ)
	
	ТекстЗапроса = ТекстВыбор + "
	|ПОМЕСТИТЬ РезультатыРасчета
	|ИЗ ВременнаяТаблица КАК ВТ" + ТекстСоединенияТаблица;
	
	ТекстыУничтоженияВТ.Добавить("УНИЧТОЖИТЬ РезультатыРасчета");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция НовыеЗначенияПеречисления(СтрПоле)
	
	ЗначенияПеречисления = Новый ТаблицаЗначений;
	
	ИмяПеречисления = СтрРазделить(СтрПоле.ТаблицаАналитики, ".")[1];
	ТипПеречисления = Новый ОписаниеТипов("ПеречислениеСсылка." + ИмяПеречисления);
	ЗначенияПеречисления.Колонки.Добавить("Ссылка", ТипПеречисления);
	ЗначенияПеречисления.Колонки.Добавить("Наименование", СтрПоле.ТипЗначения);
	
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		
		НоваяСтрока = ЗначенияПеречисления.Добавить();
		НоваяСтрока.Ссылка = Перечисления[ИмяПеречисления][ЗначениеПеречисления.Имя];
		НоваяСтрока.Наименование = ЗначениеПеречисления.Синоним;
		
	КонецЦикла;
	
	Возврат ЗначенияПеречисления;
	
КонецФункции

Функция ПолучитьСоответствиеТаблицДублей(ТабРезультат,ТабГруппировкиДубли) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст="Выбрать * Поместить ТабРезультат ИЗ &ТабРезультат КАК ТабРезультат";
	Запрос.УстановитьПараметр("ТабРезультат",ТабРезультат);
	
	Запрос.Выполнить();
	
	СоответствиеТаблицДублей=Новый Соответствие;
	
	Для Каждого Строка ИЗ ТабГруппировкиДубли Цикл
		
		ТекстВыборка="";
		ТекстГруппировка="";
		
		Для Каждого Поле ИЗ Строка.МассивПолей Цикл
			
			ТекстПоле=Поле;
			ТекстПсевдоним="";
			
			МассивПутей=ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(Поле,"vzv");
			
			Для Индекс=1 ПО МассивПутей.Количество()-1 Цикл
				
				ТекстПсевдоним=ТекстПсевдоним+"_"+МассивПутей[Индекс];
				
			КонецЦикла;
				
			ТекстВыборка=ТекстВыборка+",ТабРезультат."+Поле+" КАК "+Сред(ТекстПсевдоним,2);
			ТекстГруппировка=ТекстГруппировка+",ТабРезультат."+Поле;
			
		КонецЦикла;
		
		Запрос.Текст="ВЫБРАТЬ "+Сред(ТекстВыборка,2)+", КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТабРезультат."+Строка.КодАналитики+") КАК КоличествоДублей
		|ИЗ ТабРезультат КАК ТабРезультат
		|СГРУППИРОВАТЬ ПО "+Сред(ТекстГруппировка,2)+"
		|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТабРезультат."+Строка.КодАналитики+")>1";
		
		Результат=Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество()>0 Тогда
			
			СоответствиеТаблицДублей.Вставить(Строка.ТаблицаАналитики,Результат);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СоответствиеТаблицДублей;
	
КонецФункции

Процедура ДобавитьКолонкуНомерСтроки(ТаблицаДанных)
	
	ТаблицаДанных.Колонки.Добавить("НомерСтроки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
	
	Для Индекс=0 ПО ТаблицаДанных.Количество()-1 Цикл
		
		ТаблицаДанных[Индекс].НомерСтроки=Индекс;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ДобавитьСтрокиДляЗаписиЧерезЛог(ОбъектРасчета, ТаблицаПоказателей, ПоказателиСтроки, ТаблицаРаскрытий=Неопределено)
	
	Если ТаблицаРаскрытий=Неопределено Тогда // Пишем синтетические значения;
		
		РабочаяТаблица=ТаблицаПоказателей;
		СинтетическоеЗначение=Истина;
		
	Иначе
		
		Запрос=Новый Запрос;
		Запрос.Текст="Выбрать * Поместить ТаблицаПоказателей ИЗ &ТаблицаПоказателей КАК ТаблицаПоказателей
		|Индексировать ПО ТаблицаПоказателей.НомерСтроки
		|;
		|Выбрать * Поместить ТаблицаРаскрытий ИЗ &ТаблицаРаскрытий КАК ТаблицаРаскрытий
		|Индексировать ПО ТаблицаРаскрытий.НомерСтроки
		|;
		|ВЫБРАТЬ";
		
		ТекстПоля="";
		
		Для Индекс=1 По 6 Цикл
			
			Если НЕ ТаблицаРаскрытий.Колонки.Найти("Аналитика"+Индекс)=Неопределено Тогда
				
				ТекстПоля=ТекстПоля+",
				|ТаблицаРаскрытий.Аналитика"+Индекс;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ТаблицаРаскрытий.Колонки.Найти("АналитикаВалюта")=Неопределено Тогда
			
			ТекстПоля=ТекстПоля+",
			|ТаблицаРаскрытий.АналитикаВалюта";
			
		КонецЕсли;
		
		Для Каждого Показатель ИЗ ПоказателиСтроки Цикл
			
			ТекстПоля=ТекстПоля+",
			|ТаблицаПоказателей."+Показатель.ИмяКолонки;
			
		КонецЦикла;
		
		Запрос.Текст=Запрос.Текст+Сред(ТекстПоля,2)+"
		|ИЗ ТаблицаРаскрытий КАК ТаблицаРаскрытий
		|Внутреннее соединение ТаблицаПоказателей КАК ТаблицаПоказателей
		|ПО ТаблицаРаскрытий.НомерСтроки=ТаблицаПоказателей.НомерСтроки";
		
		Запрос.УстановитьПараметр("ТаблицаПоказателей",	ТаблицаПоказателей);
		Запрос.УстановитьПараметр("ТаблицаРаскрытий",	ТаблицаРаскрытий);
		
		РабочаяТаблица=Запрос.Выполнить().Выгрузить();
		
		СинтетическоеЗначение=Ложь;
		
	КонецЕсли;
	
	Для Каждого Строка ИЗ РабочаяТаблица Цикл
		
		Для Каждого Показатель ИЗ ПоказателиСтроки Цикл
			
			ЗначениеПоказателя=Строка[Показатель.ИмяКолонки];
			
			НоваяСтрока = ОбъектРасчета.тИзмененныеПоказатели.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбъектРасчета);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.ПериодОтчета = Показатель.ПериодОтчета;
			НоваяСтрока.Показатель = Показатель.ПоказательОтчета;
			
			Если ТипЗнч(ЗначениеПоказателя) = Тип("Число") Тогда
				НоваяСтрока.Значение = ЗначениеПоказателя;
			Иначе
				НоваяСтрока.ЗначениеНечисловое = ЗначениеПоказателя;
			КонецЕсли;
			
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ИмяКолонкиПоНомеру(НомерКолонки)
	
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	ИмяКолонки = "";
	
	ТекущийНомерКолонки = НомерКолонки;
	
	Пока ТекущийНомерКолонки > 0 Цикл
		Остаток = (ТекущийНомерКолонки - 1)%26;
		
		Буква = Сред(Алфавит, Остаток + 1, 1);
		ИмяКолонки = Буква + ИмяКолонки;
		
		ТекущийНомерКолонки = Цел((ТекущийНомерКолонки - Остаток)/26);
	КонецЦикла;
	
	Возврат ИмяКолонки;
	
КонецФункции

Функция НомерКолонкиПоИмени(ИмяКолонкиXLSX)
	
	ТекущееИмяКолонки = ИмяКолонкиXLSX;
	
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	ДлинаНомера = СтрДлина(ТекущееИмяКолонки);
	
	НомерКолонки = 0;
	
	Для Сч = 1 По ДлинаНомера Цикл
		Позиция = Найти(Алфавит, Сред(ТекущееИмяКолонки, (ДлинаНомера + 1 - Сч), 1));
		НомерКолонки = НомерКолонки + Позиция * Pow(26, Сч - 1);
	КонецЦикла;
	
	Возврат НомерКолонки;
	
КонецФункции

Функция ЗначениеВЯчейке(ЯчейкаСтроки, ИменаКолонокXLSX, СтроковыеЗначенияXLSX)
	
	ЗначениеЯчейки = Неопределено;
	Если ЯчейкаСтроки.ЕстьДочерниеУзлы()
		И (ВРег(ЯчейкаСтроки.ПервыйДочерний.ИмяУзла) = "V"
		ИЛИ ВРег(ЯчейкаСтроки.ПервыйДочерний.ИмяУзла) = "F") Тогда
		
		Если ВРег(ЯчейкаСтроки.ПервыйДочерний.ИмяУзла) = "F" Тогда
			Если ВРег(ЯчейкаСтроки.ПоследнийДочерний.ИмяУзла) = "V" Тогда
				ЗначениеЯчейки = СокрЛП(ЯчейкаСтроки.ПоследнийДочерний.ТекстовоеСодержимое);
			КонецЕсли;
		Иначе
			ЗначениеЯчейки = СокрЛП(ЯчейкаСтроки.ТекстовоеСодержимое);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
			
			ТипЗначения = ЗначениеАтрибутаУзлаDOM(ЯчейкаСтроки, "t");
			
			Если ВРег(ТипЗначения) = "S" Тогда
				
				Если СтроковыеЗначенияXLSX.Количество() <> 0 Тогда
					ЗначениеЯчейки = СтроковыеЗначенияXLSX[
						СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЗначениеЯчейки)];
				Иначе
					ЗначениеЯчейки = "";
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначениеЯчейки;
	
КонецФункции

Функция ДанныеФайлаSharedStringsXML(КаталогФайлов)
	
	СтроковыеЗначенияXLSX = Новый Массив;
	
	Файл = Новый Файл(КаталогФайлов + "xl" + ПолучитьРазделительПути() + "sharedStrings.xml");
	Если НЕ Файл.Существует() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(Файл.ПолноеИмя);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ЧтениеXML.Закрыть();
	
	ЭлементыSharedStrings = ДокументDOM.ПолучитьЭлементыПоИмени("sst");
	
	Если ЭлементыSharedStrings.Количество() > 0 Тогда
		ЭлементыКоллекции = ЭлементыSharedStrings[0].ДочерниеУзлы;
		Для Каждого Элемент Из ЭлементыКоллекции Цикл
			СтроковыеЗначенияXLSX.Добавить(Элемент.ТекстовоеСодержимое);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтроковыеЗначенияXLSX;
	
КонецФункции

Функция ЗначениеАтрибутаУзлаDOM(УзелDOM, ИмяАтрибута)
	
	Атрибут = УзелDOM.Атрибуты.ПолучитьИменованныйЭлемент(ИмяАтрибута);

	Если Атрибут = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Атрибут.Значение;
	КонецЕсли;
	
КонецФункции

Функция УдалитьЦифрыИзСтроки(Строка) Экспорт
	Возврат СтрСоединить(СтрРазделить(Строка, "0123456789", Ложь), "");
КонецФункции