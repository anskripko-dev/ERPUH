// Белоконенко Денис 13.12.2022 Выполнение задач №000043671
Функция РежимыОтображенияДокументов()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДляОтправки",	"ОтправкаПакетов");
	Результат.Вставить("Исходящее",		"ОтправленныеДокументы");
	Результат.Вставить("Входящее",		"ПолученныеДокументы");
	
	Возврат Результат
	
КонецФункции 

// Белоконенко Денис 13.12.2022 Выполнение задач №000043671
Функция НайтиОткрытуюФормуПоКлючу(КлючУникальностиФормы)
	ОткрытыеОкна = ПолучитьОкна();
	
	Для Каждого ОкноПриложения Из ОткрытыеОкна Цикл
		Если Не ОкноПриложения.Основное И Не ОкноПриложения.НачальнаяСтраница Тогда
			Для Каждого СодежимоеФормы Из ОкноПриложения.Содержимое Цикл
				Если ТипЗнч(СодежимоеФормы) = Тип("ФормаКлиентскогоПриложения") И 
					СодежимоеФормы.КлючУникальности = КлючУникальностиФормы Тогда
					Возврат СодежимоеФормы;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции        

// Белоконенко Денис 13.12.2022 Выполнение задач №000043671
Процедура ОткрытьДокументВПодсистемеДиадок(ФормаУправляемаяДиадок) Экспорт 
	// НАЧАЛО Мещеряков Алексей 04.03.2026 Выполнение задач №000056945
//	ДанныеДокумента = ФормаУправляемаяДиадок.Параметры.РезультатИнициализации.тн_ДанныеДокумента;
    ДанныеДокумента = ФормаУправляемаяДиадок.РезультатИнициализации.тн_ДанныеДокумента;
	// КОНЕЦ Мещеряков Алексей 04.03.2026 Выполнение задач №000056945
	
	РежимыОтображенияДокументов = РежимыОтображенияДокументов();
	РежимОтображенияДокумента = РежимыОтображенияДокументов[ДанныеДокумента.Направление];
	
	СтрокаСписка = Новый Структура(ФормаУправляемаяДиадок.СтруктураДанныхСтрокиСпискаСтрокой);
	ЗаполнитьЗначенияСвойств(СтрокаСписка, ДанныеДокумента);
	
	КлючПакетаДокументов = ДанныеДокумента.Документ;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца",	Истина);
	ПараметрыФормы.Вставить("Ключ",								РежимОтображенияДокумента + " " + ДанныеДокумента.LetterId);
	ПараметрыФормы.Вставить("СтрокаСписка",						СтрокаСписка);
	ПараметрыФормы.Вставить("ВыбранныеФайлы",					Неопределено);
	ПараметрыФормы.Вставить("РежимОтображенияДокументов",		РежимОтображенияДокумента);
	ПараметрыФормы.Вставить("ЭтоНовыйПакет",					Ложь); 
	// НАЧАЛО Мещеряков Алексей 09.01.2025 Выполнение задач №000052237
	ПараметрыФормы.Вставить("РежимФормы",					"ОтображениеПакета");
	// КОНЕЦ Мещеряков Алексей 09.01.2025 Выполнение задач №000052237
	ФормаУправляемаяДиадок.мОткрытьФорму("ФормаПакетаУправляемая", ПараметрыФормы, , ФормаУправляемаяДиадок, КлючПакетаДокументов);

КонецПроцедуры  
