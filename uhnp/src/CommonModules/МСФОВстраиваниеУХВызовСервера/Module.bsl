Функция ТекстЗапроса_АналитикаУчетаФИ(НомераТаблиц) Экспорт
	
	НомераТаблиц.Вставить("втАналитикаФИ",	НомераТаблиц.Количество());

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	МСФООбороты.Субконто1 КАК ФИ,
	|	МАКСИМУМ(&ЦФО) КАК Подразделение,
	|	МАКСИМУМ(&НаправлениеДеятельности) КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втАналитикаФИ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&ДатаОкончания,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.Ссылка
	|				ИЗ
	|					ПланСчетов.Хозрасчетный.ВидыСубконто КАК т
	|				ГДЕ
	|					т.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры)),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры),
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						т.ФИ
	|					ИЗ
	|						втСведенияФИ КАК т)
	|				И &ИспользуютсяТК = ЛОЖЬ) КАК МСФООбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	МСФООбороты.Субконто1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МСФООбороты.Субконто1,
	|	МАКСИМУМ(&ЦФО),
	|	МАКСИМУМ(&НаправлениеДеятельности)
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&ДатаОкончания,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.Ссылка
	|				ИЗ
	|					ПланСчетов.Хозрасчетный.ВидыСубконто КАК т
	|				ГДЕ
	|					т.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги)),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги),
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						т.ФИ
	|					ИЗ
	|						втСведенияФИ КАК т)
	|				И &ИспользуютсяТК = ЛОЖЬ) КАК МСФООбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	МСФООбороты.Субконто1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ФИ";
	
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЦФО", "МСФООбороты.Подразделение.Организация");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельности", "МСФООбороты.НаправлениеДеятельности");
		
	Иначе 
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЦФО", "МСФООбороты.Подразделение.ЦФО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельности", "НЕОПРЕДЕЛЕНО");
			
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДоработатьЗапросФиБМ(ТекстЗапроса)

	Если УчетМСФОПовтИспУХ.ЕстьРСБУ() Тогда
		Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
			Возврат;//УХ, ЕРПУХ 
		КонецЕсли;
	КонецЕсли;
	
	//в ВЕ, БМ и НМ нет версий соглашений

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДатаНачалаДействия", "Дата");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВерсияСоглашения.ДатаОкончанияДействия", "СрокДействия");
	
	ТекстДляЗамены = 
	"ДоговорыДКЗ.ИспользоватьГрафикРасчетов = Ложь";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстДляЗамены, "ИСТИНА");
	
КонецПроцедуры

Функция ТекстЗапроса_втВозможныеПараметрыУчетаФИ(НомераТаблиц)

	НомераТаблиц.Вставить("втВозможныеПараметрыУчетаФИ", НомераТаблиц.Количество());
		
	Возврат 
	"ВЫБРАТЬ
	|	т.Ссылка КАК ПараметрыУчетаФИ
	|ПОМЕСТИТЬ втВозможныеПараметрыУчетаФИ
	|ИЗ
	|	Справочник.ПараметрыУчетаФинансовыхИнструментовМСФО КАК т
	|ГДЕ
	|	т.ВидОбъектаФинансовогоХарактера.СпособУчета = ЗНАЧЕНИЕ(Перечисление.СпособыУчетаФинансовыхИнструментов.ПоСправедливойСтоимости)";

КонецФункции

Функция ТекстЗапроса_втФИ_ДоговорыКонтрагентов()

	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК ФИ,
	|	ИСТИНА КАК ЭтоДоговор,
	|	т.Контрагент КАК Контрагент,
	|	т.ВалютаВзаиморасчетов КАК Валюта,
	|	т.ПараметрыУчетаФИ КАК ПараметрыУчетаФИ,
	|	т.ВерсияСоглашения.ДатаНачалаДействия КАК ДатаНачала,
	|	т.ВерсияСоглашения.ДатаОкончанияДействия КАК ДатаОкончания,
	|	ВЫБОР
	|		КОГДА т.Котировка = ЗНАЧЕНИЕ(Справочник.ВидыКотировокФинансовыхИнструментов.ПустаяСсылка)
	|			ТОГДА т.Ссылка
	|		ИНАЧЕ т.Котировка
	|	КОНЕЦ КАК Котировка,
	|	ВЫБОР
	|		КОГДА т.Котировка = ЗНАЧЕНИЕ(Справочник.ВидыКотировокФинансовыхИнструментов.ПустаяСсылка)
	|			ТОГДА т.ВалютаВзаиморасчетов
	|		ИНАЧЕ т.Котировка.Валюта
	|	КОНЕЦ КАК ВалютаКотировки,
	|	т.Сумма КАК Номинал
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК т
	|ГДЕ
	|	т.Организация = &Организация
	|	И т.ПараметрыУчетаФИ В
	|			(ВЫБРАТЬ
	|				т.ПараметрыУчетаФИ
	|			ИЗ
	|				втВозможныеПараметрыУчетаФИ КАК т)
	|	И ВЫБОР
	|			КОГДА т.ВерсияСоглашения.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ т.ВерсияСоглашения.ДатаОкончанияДействия >= &ДатаНачалаПериода
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА т.ВерсияСоглашения.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ т.ВерсияСоглашения.ДатаНачалаДействия <= &ДатаОкончанияПериода
	|		КОНЕЦ";


КонецФункции

Функция ТекстЗапроса_втФИ_ЦенныеБумаги()
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК ФИ,
	|	ЛОЖЬ КАК ЭтоДоговор,
	|	МАКСИМУМ(т.Эмитент) КАК Контрагент,
	|	МАКСИМУМ(т.ВалютаНоминала) КАК Валюта,
	|	МАКСИМУМ(т.ПараметрыУчетаФИ) КАК ПараметрыУчетаФИ,
	|	МАКСИМУМ(т.ДатаВыпуска) КАК ДатаНачала,
	|	МАКСИМУМ(т.СрокПогашения) КАК ДатаОкончания,
	|	МАКСИМУМ(ЕСТЬNULL(ВидыКотировокФинансовыхИнструментов.Ссылка, т.Ссылка)) КАК Котировка,
	|	МАКСИМУМ(ЕСТЬNULL(ВидыКотировокФинансовыхИнструментов.ФункциональнаяВалюта, т.ВалютаНоминала)) КАК ВалютаКотировки,
	|	МАКСИМУМ(т.Номинал) КАК Номинал
	|ПОМЕСТИТЬ втФИ
	|ИЗ
	|	Справочник.ЦенныеБумаги КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыКотировокФинансовыхИнструментов КАК ВидыКотировокФинансовыхИнструментов
	|		ПО т.Ссылка = ВидыКотировокФинансовыхИнструментов.ЦеннаяБумага
	|ГДЕ
	|	т.ПараметрыУчетаФИ В
	|			(ВЫБРАТЬ
	|				т.ПараметрыУчетаФИ
	|			ИЗ
	|				втВозможныеПараметрыУчетаФИ КАК т)
	|	И ВЫБОР
	|			КОГДА т.СрокПогашения = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ т.СрокПогашения >= &ДатаНачалаПериода
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА т.ДатаВыпуска = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ т.ДатаВыпуска <= &ДатаОкончанияПериода
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Ссылка";

КонецФункции

#КонецОбласти
