Функция ТестЗапроса_Взаиморасчеты(Запрос, ТекстыЗапроса, Регистры)
	
	ХозяйственнаяОперация = "РеализацияКлиенту";
	#Область Продажа
	
	Если ХозяйственнаяОперация = "РеализацияКлиенту" Тогда
		
		ТекстПродажа = 
		"ВЫБРАТЬ
		|	&Ссылка КАК Ссылка,
		|	&Организация КАК Организация,
		|	Таблица.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
		|	Таблица.ОбъектРасчетов КАК ОбъектРасчетов,
		|	Таблица.Период КАК ДатаПлатежа,
		|	НЕОПРЕДЕЛЕНО КАК ЗаказПродажи,
		|	ЛОЖЬ КАК НакладнаяПоЗаказам,
		|	Таблица.СуммаВВалюте КАК СуммаВзаиморасчетов,
		|	Таблица.СуммаВВалюте КАК Сумма,
		|	0 КАК СуммаВзаиморасчетовПоТаре,
		|	Таблица.ДоговорКонтрагента.ПорядокРасчетов КАК ПорядокРасчетов,
		|	Таблица.Период КАК ДатаРегистратора,
		|	Таблица.ОбъектРасчетов.Номер КАК НомерРегистратора,
		|	Таблица.Валюта КАК ВалютаВзаиморасчетов,
		|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПрочихАктивов) КАК ХозяйственнаяОперация,
		|	Таблица.Период КАК ДатаКурса,
		|	Таблица.Валюта КАК ВалютаДокумента,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки) КАК ВариантОплаты,
		|	ЛОЖЬ КАК СверхЗаказа,
		|	НЕОПРЕДЕЛЕНО КАК СвязанныйДокумент
		|ИЗ
		|	втПроводки КАК Таблица
		|ГДЕ
		|	ВЫБОР
		|			КОГДА Таблица.ОснованиеПоступленияЗадолженность = ИСТИНА
		|				ТОГДА Таблица.ТипСчетаДтФИ <> ""К""
		|			ИНАЧЕ Таблица.ТипСчетаДтФИ = ""К""
		|		КОНЕЦ
		|	И Таблица.АналитикаУчетаПоПартнерам <> НЕОПРЕДЕЛЕНО
		|	И Таблица.ОбъектРасчетов <> ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка)";
		
	Иначе
		ТекстПродажа = "";
	КонецЕсли;
	
	#КонецОбласти
	
	#Область УвеличениеПланаОплат
	
	ТекстПланированиеОплат = 
	"ВЫБРАТЬ
	|	&Ссылка КАК Ссылка,
	|	&Организация КАК Организация,
	|	Таблица.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
	|	Таблица.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Таблица.Период КАК ДатаРегистратора,
	|	Таблица.ОбъектРасчетов.Номер КАК НомерРегистратора,
	|	Таблица.ДоговорКонтрагента.ПорядокРасчетов КАК ПорядокРасчетов,
	|	Таблица.Валюта КАК ВалютаВзаиморасчетов,
	|	Таблица.Валюта КАК ВалютаДокумента,
	|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПрочихАктивов) КАК ХозяйственнаяОперация,
