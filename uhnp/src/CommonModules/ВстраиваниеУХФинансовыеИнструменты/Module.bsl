Процедура УстановитьПараметры(Запрос) Экспорт

	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета",	Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета",		Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("ВалютаФинОтчетности",			Константы.ВалютаФинОтчетности.Получить());
	
	РасчетСебестоимостиПрикладныеАлгоритмы.ЗаполнитьПараметрыИнициализации(Запрос, Запрос.Параметры);
	Запрос.УстановитьПараметр("СтатьяАП_ЦФ", ПланыВидовХарактеристик.СтатьиАктивовПассивов.УпрБалансЦелевоеФинансирование);
	Запрос.УстановитьПараметр("НоваяАрхитектураВзаиморасчетов", ПолучитьФункциональнуюОпцию("НоваяАрхитектураВзаиморасчетов"));

	Запрос.УстановитьПараметр("ИспользоватьУчетПрочихДоходовРасходов", 
		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПрочихДоходовРасходов")); 
		
	ЗначенияПараметровПроведения = ЗначенияПараметровПроведения(Запрос.Параметры);
	Для каждого КлючИЗначение Из ЗначенияПараметровПроведения Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла; 
	
КонецПроцедуры

Функция ТекстЗапроса_втПроводки(НомераТаблиц, ИмяДокумента)

	НомераТаблиц.Вставить("втПроводки", НомераТаблиц.Количество());
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерПроводки,
	|	втСобытия.ОснованиеПоступленияЗадолженность КАК ОснованиеПоступленияЗадолженность,
	|	втСобытия.Валюта КАК Валюта,
	|	втСобытия.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	втСобытия.Контрагент КАК Контрагент,
	|	втСобытия.ВидЦенности КАК ВидЦенности,
	|	втСобытия.ВидДеятельностиНДС КАК ВидДеятельностиНДС,
	|	втСобытия.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	втСобытия.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	втСобытия.ОбъектРасчетов КАК ОбъектРасчетов,
	|	втСобытия.ОбъектРасчетовОснование КАК ОбъектРасчетовОснование,
	|	втСобытия.ОбъектРасчетовТипРасчетов КАК ОбъектРасчетовТипРасчетов,
	|	втСобытия.ОбъектРасчетовОснованиеТипРасчетов КАК ОбъектРасчетовОснованиеТипРасчетов,
	|	втСчетДт.Статья КАК СтатьяДт,
	|	втСчетДт.Аналитика КАК АналитикаДт,
	|	втСчетКт.Статья КАК СтатьяКт,
	|	втСчетКт.Аналитика КАК АналитикаКт,
	|	втСобытия.РасчетыПоДоговорам КАК РасчетыПоДоговорам,
	|	втСобытия.Подразделение КАК Подразделение,
	|	втСобытия.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаПроводок.ФинансовыйИнструмент КАК ФинансовыйИнструмент,
	|	ТаблицаПроводок.Период КАК Период,
	|	&Организация КАК Организация,
	|	втСчетДт.Подразделение КАК ПодразделениеДт,
	|	втСчетДт.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	втСчетКт.Подразделение КАК ПодразделениеКт,
	|	втСчетКт.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	ВЫБОР
	|		КОГДА НЕ втСчетДт.СчетВалютный
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &ВалютаДт
	|		КОГДА втСчетДт.ЭтоСчетУчета
	|			ТОГДА &ВалютаНоминала
	|		ИНАЧЕ &ВалютаДт
	|	КОНЕЦ КАК ВалютаДт,
	|	ВЫБОР
	|		КОГДА НЕ втСчетКт.СчетВалютный
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &ВалютаКт
	|		КОГДА втСчетКт.ЭтоСчетУчета
	|			ТОГДА &ВалютаНоминала
	|		ИНАЧЕ &ВалютаКт
	|	КОНЕЦ КАК ВалютаКт,
	|	ВЫБОР
	|		КОГДА втСчетДт.СчетКоличественный
	|			ТОГДА ТаблицаПроводок.Количество
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК КоличествоДт,
	|	ВЫБОР
	|		КОГДА втСчетКт.СчетКоличественный
	|			ТОГДА ТаблицаПроводок.Количество
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК КоличествоКт,
	|	ТаблицаПроводок.Сумма КАК СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаБУ
	|		ИНАЧЕ &СуммаБУ
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаУУ
	|		ИНАЧЕ &СуммаУУ
	|	КОНЕЦ КАК СуммаУУ,
	|	ВЫБОР
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаФО
	|		ИНАЧЕ &СуммаФО
	|	КОНЕЦ КАК СуммаФО,
	|	ВЫБОР
	|		КОГДА НЕ втСчетДт.СчетНалоговыйУчет
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаНУДт
	|		КОГДА втСчетДт.ЭтоПереоценкаФИ
	|				ИЛИ втСчетКт.ЭтоПереоценкаФИ
	|			ТОГДА NULL
	|		ИНАЧЕ &СуммаНУДт
	|	КОНЕЦ КАК СуммаНУДт,
	|	ВЫБОР
	|		КОГДА НЕ втСчетКт.СчетНалоговыйУчет
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаНУКт
	|		КОГДА втСчетДт.ЭтоПереоценкаФИ
	|				ИЛИ втСчетКт.ЭтоПереоценкаФИ
	|			ТОГДА NULL
	|		ИНАЧЕ &СуммаНУКт
	|	КОНЕЦ КАК СуммаНУКт,
	|	ВЫБОР
	|		КОГДА НЕ втСчетДт.СчетНалоговыйУчет
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаПРДт
	|		КОГДА втСчетДт.ЭтоПереоценкаФИ
	|				ИЛИ втСчетКт.ЭтоПереоценкаФИ
	|			ТОГДА NULL
	|		ИНАЧЕ &СуммаПРДт
	|	КОНЕЦ КАК СуммаПРДт,
	|	ВЫБОР
	|		КОГДА НЕ втСчетКт.СчетНалоговыйУчет
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаПРКт
	|		КОГДА втСчетДт.ЭтоПереоценкаФИ
	|				ИЛИ втСчетКт.ЭтоПереоценкаФИ
	|			ТОГДА NULL
	|		ИНАЧЕ &СуммаПРКт
	|	КОНЕЦ КАК СуммаПРКт,
	|	ВЫБОР
	|		КОГДА НЕ втСчетДт.СчетНалоговыйУчет
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаВРДт
	|		КОГДА втСчетДт.ЭтоПереоценкаФИ
	|				ИЛИ втСчетКт.ЭтоПереоценкаФИ
	|			ТОГДА &СуммаНУДт
	|		ИНАЧЕ &СуммаВРДт
	|	КОНЕЦ КАК СуммаВРДт,
	|	ВЫБОР
	|		КОГДА НЕ втСчетКт.СчетНалоговыйУчет
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &СуммаВРКт
	|		КОГДА втСчетДт.ЭтоПереоценкаФИ
	|				ИЛИ втСчетКт.ЭтоПереоценкаФИ
	|			ТОГДА &СуммаНУКт
	|		ИНАЧЕ &СуммаВРКт
	|	КОНЕЦ КАК СуммаВРКт,
	|	втСчетДт.СчетНалоговыйУчет КАК СчетДтНУ,
	|	втСчетКт.СчетНалоговыйУчет КАК СчетКтНУ,
	|	втСчетДт.ЭтоПереоценкаФИ
	|		ИЛИ втСчетКт.ЭтоПереоценкаФИ КАК ЭтоПереоценкаФИ,
	|	ВЫБОР
	|		КОГДА НЕ втСчетДт.СчетВалютный
	|			ТОГДА NULL
	|		КОГДА &ЕстьСуммыПроводки
	|			ТОГДА &ВалютнаяСуммаДт
	|		КОГДА втСчетДт.ЭтоСчетУчета
	|			ТОГДА &ВалютнаяСуммаДт
	|		ИНАЧЕ &ВалютнаяСуммаДт
	|	КОНЕЦ КАК ВалютнаяСуммаДт,
	|	ВЫБОР
	|		КОГДА втСчетКт.СчетВалютный
	|				И втСчетКт.ЭтоСчетУчета
	|			ТОГДА &ВалютнаяСуммаКт
	|		КОГДА втСчетКт.СчетВалютный
	|			ТОГДА &ВалютнаяСуммаКт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ВалютнаяСуммаКт,
	|	втСчетДт.Счет КАК СчетДт,
	|	ТаблицаПроводок.СчетДт КАК СчетДтФИ,
	|	втСчетДт.ТипСчета КАК ТипСчетаДтФИ,
	|	втСчетДт.Субконто1 КАК СубконтоДт1,
	|	втСчетДт.Субконто2 КАК СубконтоДт2,
	|	втСчетДт.Субконто3 КАК СубконтоДт3,
	|	ЕСТЬNULL(втСчетДт.ВидСубконто1, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)) КАК ВидСубконтоДт1,
	|	ЕСТЬNULL(втСчетДт.ВидСубконто2, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)) КАК ВидСубконтоДт2,
	|	ЕСТЬNULL(втСчетДт.ВидСубконто3, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)) КАК ВидСубконтоДт3,
	|	втСчетКт.Счет КАК СчетКт,
	|	ТаблицаПроводок.СчетКт КАК СчетКтФИ,
	|	втСчетКт.ТипСчета КАК ТипСчетаКтФИ,
	|	втСчетКт.Субконто1 КАК СубконтоКт1,
	|	втСчетКт.Субконто2 КАК СубконтоКт2,
	|	втСчетКт.Субконто3 КАК СубконтоКт3,
	|	ЕСТЬNULL(втСчетКт.ВидСубконто1, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)) КАК ВидСубконтоКт1,
	|	ЕСТЬNULL(втСчетКт.ВидСубконто2, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)) КАК ВидСубконтоКт2,
	|	ЕСТЬNULL(втСчетКт.ВидСубконто3, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПустаяСсылка)) КАК ВидСубконтоКт3,
	|	ТаблицаПроводок.Комментарий КАК Содержание
	|ПОМЕСТИТЬ втПроводки
	|ИЗ
	|	втТаблицаПроводок КАК ТаблицаПроводок
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаФИ КАК втСчетДт
	|		ПО ТаблицаПроводок.СчетДт = втСчетДт.ВидСчетаФИ
	|			И (&УсловиеСчетДт)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаФИ КАК втСчетКт
	|		ПО ТаблицаПроводок.СчетКт = втСчетКт.ВидСчетаФИ
	|			И (&УсловиеСчетКт)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСобытия КАК втСобытия
	|		ПО ТаблицаПроводок.ФинансовыйИнструмент = втСобытия.ФинансовыйИнструмент
	|			И ТаблицаПроводок.Период = втСобытия.Дата
	|ГДЕ
	|	ТаблицаПроводок.Сумма <> 0
	|	И НЕ втСчетДт.Счет ЕСТЬ NULL
	|	И НЕ втСчетКт.Счет ЕСТЬ NULL
	|	И втСчетДт.Счет <> втСчетКт.Счет";
	
	Если ИмяДокумента = "НачисленияПоФинансовымИнструментам" Тогда //НачисленияКредитовИДепозитов
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСчетДт", "ТаблицаПроводок.ФинансовыйИнструмент = втСчетДт.ФинансовыйИнструмент");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСчетКт", "ТаблицаПроводок.ФинансовыйИнструмент = втСчетКт.ФинансовыйИнструмент");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФинансовыйИнструмент", "ТаблицаПроводок.ФИ");
		
	Иначе 
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСчетДт", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСчетКт", "ИСТИНА");

	КонецЕсли;
	ЕстьСуммыПроводки = (ИмяДокумента = "ПродажаЦеннойБумаги");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕстьСуммыПроводки", ?(ЕстьСуммыПроводки, "ИСТИНА", "ЛОЖЬ"));
	
	ТипЧисел = "ЧИСЛО(15, 2)";//РБ.Хозрасчетный
	
	Если ЕстьСуммыПроводки Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВалютаДт", "ТаблицаПроводок.ВалютаДт");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВалютаКт", "ТаблицаПроводок.ВалютаКт");
		
		ЗаменитьВыразить(ТекстЗапроса, "&ВалютнаяСуммаДт", "ТаблицаПроводок.ВалютнаяСуммаДт");
		ЗаменитьВыразить(ТекстЗапроса, "&ВалютнаяСуммаКт", "ТаблицаПроводок.ВалютнаяСуммаКт");
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаБУ", "ТаблицаПроводок.Сумма");
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаУУ", "ТаблицаПроводок.Сумма * втСобытия.КроссКурсУУИзРасчетов");
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаФО", "ТаблицаПроводок.Сумма * втСобытия.КроссКурсФОИзРасчетов");
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаНУДт", "ТаблицаПроводок.СуммаНУДт");
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаНУКт", "ТаблицаПроводок.СуммаНУКт");
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаПРДт", "ТаблицаПроводок.СуммаПРДт");
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаПРКт", "ТаблицаПроводок.СуммаПРКт");
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаВРДт", "ТаблицаПроводок.СуммаВРДт");
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаВРКт", "ТаблицаПроводок.СуммаВРКт");

	Иначе
		
		СуммаРеглИзРасчетов = "ТаблицаПроводок.Сумма * втСобытия.КроссКурсРеглИзРасчетов";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВалютаДт", "ТаблицаПроводок.Валюта");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВалютаКт", "ТаблицаПроводок.Валюта");
		
		ЗаменитьВыразить(ТекстЗапроса, "&ВалютнаяСуммаДт", "ТаблицаПроводок.Сумма");
		ЗаменитьВыразить(ТекстЗапроса, "&ВалютнаяСуммаКт", "ТаблицаПроводок.Сумма");
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаБУ", СуммаРеглИзРасчетов);
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаУУ", "ТаблицаПроводок.Сумма * втСобытия.КроссКурсУУИзРасчетов");
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаФО", "ТаблицаПроводок.Сумма * втСобытия.КроссКурсФОИзРасчетов");
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаНУДт", СуммаРеглИзРасчетов);
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаНУКт", СуммаРеглИзРасчетов);
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаПРДт", "0");//в пост обработке ЕРП требуется 0(NULL - ошибка) в ПР, ВР
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаПРКт", "0");
		
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаВРДт", "0");
		ЗаменитьВыразить(ТекстЗапроса, "&СуммаВРКт", "0");

	КонецЕсли;
	
	ВалютаНоминала = "ТаблицаПроводок.ФинансовыйИнструмент.ВалютаНоминала";
	Если ИмяДокумента = "ПоступлениеИнвестиций" ИЛИ (ИмяДокумента = "ВыбытиеИнвестиций") Тогда
		ВалютаНоминала = "ТаблицаПроводок.Валюта";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВалютаНоминала", ВалютаНоминала);

	Возврат ТекстЗапроса;

КонецФункции

