#Область ПрограммныйИнтерфейс

#Область ЕдиныеРеквизиты 

// Сохраняет или восстанавливает значение единого реквзита в зависимости от значения флага использования.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма
//  ВосстановитьЗначение  - Булево - Признак использования единого реквизита.
//  ИмяРеквизита		  - Строка - Имя единого реквизита.
//
Процедура СохранитьВосстановитьЕдиноеЗначение(Форма, Знач ВосстановитьЗначение, Знач ИмяРеквизита) Экспорт
	
	Если ВосстановитьЗначение Тогда
		Форма[ИмяРеквизита] = Форма[ИмяРеквизита+"СтароеЗначение"];
	Иначе
		Форма[ИмяРеквизита+"СтароеЗначение"] = Форма[ИмяРеквизита];
		Форма[ИмяРеквизита] = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Изменяет значение переключателя использования единого реквизита, если значение единого реквизита не заполнено.
//
// Параметры: 
//  Форма - ФормаКлиентскогоПриложения - форма
//  ИмяПереключателя  	- Строка - Имя переключателя.
//  ИмяРеквизита		- Строка - Имя единого реквизита.
//
Процедура ПроверкаОчисткиЕдиногоРеквизита(Форма, Знач ИмяПереключателя, Знач ИмяРеквизита) Экспорт
	
	Если Не ЗначениеЗаполнено(Форма[ИмяРеквизита]) Тогда
		Форма[ИмяПереключателя] = Ложь;   
		КонтрольЛимитовФормыКлиентСервер.НастроитьЗависимыеЭлементыФормы(Форма,ИмяПереключателя);
	КонецЕсли;

КонецПроцедуры    

// Изменяет зависимые реквизиты ТЧ при изменении значения единого реквизита
//
// Параметры:   
//  Форма 							- ФормаКлиентскогоПриложения - форма
//  ИмяЕдиногоРеквизита		  		- Строка - Имя единого реквизита
//  ИмяТЧ		  					- Строка - Имя табличной части.
//
Процедура ПриИзмененииЕдиногоРеквизита(Форма, ИмяЕдиногоРеквизита, ИмяТЧ) Экспорт
			
	СоответствиеЕдиныхРеквизитов = ПолучитьСоответствиеЕдиныхРеквизитов(Форма); 
	
	ИмяРеквизита = СоответствиеЕдиныхРеквизитов[ИмяЕдиногоРеквизита];
	Если ИмяРеквизита = неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Форма[ИмяРеквизита + "СтароеЗначение"]) Тогда
		ПоляШапки = Новый Структура(ИмяРеквизита, Форма[ИмяРеквизита + "СтароеЗначение"]); 
	Иначе
		ПоляШапки = Новый Структура(ИмяРеквизита, Форма[ИмяРеквизита]);
	КонецЕсли;
	
	Объект = Форма.Объект;
	Для Каждого Строка Из Объект[ИмяТЧ] Цикл
		ЗаполнитьЗначенияСвойств(Строка, ПоляШапки); 
	КонецЦикла;          
	
КонецПроцедуры

// Возвращает соответсвие переключателей использования единых реквизитов и имен единых реквизитов формы
//
// Параметры:   
//  Форма 							- ФормаКлиентскогоПриложения - форма
//
Функция ПолучитьСоответствиеЕдиныхРеквизитов(Форма)

	ЕдиныеРеквизиты = Новый Соответствие; 
	
	ДокументСсылка = Форма.Объект.Ссылка;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаПланов") ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов") Тогда 	
		
		ЕдиныеРеквизиты = ПолучитьСоответствиеЕдиныхРеквизитовКорректировкаЛимитов();
			
	КонецЕсли;
	
	Возврат ЕдиныеРеквизиты;

КонецФункции 

// Возвращает соответсвие переключателей использования единых реквизитов и имен единых реквизитов для документов "Корректировка лимитов" и "Заявка на корректировку лимитов"
//
Функция ПолучитьСоответствиеЕдиныхРеквизитовКорректировкаЛимитов()
	
	ЕдиныеРеквизиты = Новый Соответствие; 
	
	ЕдиныеРеквизиты.Вставить("ЕдиныйПериод", "НачалоПериода");
	ЕдиныеРеквизиты.Вставить("ЕдиныйЦФО", "ЦФО"); 
	ЕдиныеРеквизиты.Вставить("ЕдиныйПроект", "Проект");
	ЕдиныеРеквизиты.Вставить("ЕдинаяВалюта", "Валюта");
	ЕдиныеРеквизиты.Вставить("ЕдиныйПриходРасход", "ПриходРасход");
	
	Возврат ЕдиныеРеквизиты;

КонецФункции 	

#КонецОбласти

#КонецОбласти
