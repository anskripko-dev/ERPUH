#Область ПрограммныйИнтерфейс

// Иванов ВЮ (Код-Эксперт) 23.12.2024 Выполнение задач №000050329
// Вызывается из ОМ "ПриобретениеТоваровУслугЛокализация.ЗарегистрироватьУчетныеМеханизмы()"
Процедура ЗарегистрироватьУчетныеМеханизмы(МеханизмыДокумента) Экспорт
	
	МеханизмыДокумента.Добавить("тн_АкцизыПоПриобретеннымЦенностям");
	
КонецПроцедуры // ЗарегистрироватьУчетныеМеханизмы()

// Иванов ВЮ (Код-Эксперт) 23.12.2024 Выполнение задач №000050329
// Вызывается из ОМ "ПроведениеДокументовЛокализация.тн_ДополнитьУчетныеМеханизмыКонфигурации()"
Процедура ДополнитьУчетныеМеханизмыКонфигурации(МеханизмыКонфигурации) Экспорт
	
	МеханизмыКонфигурации.Вставить("тн_АкцизыПоПриобретеннымЦенностям", "РегистрыНакопления.тн_АкцизыПоПриобретеннымЦенностям"); 
	
КонецПроцедуры // ДополнитьУчетныеМеханизмыКонфигурации()

// Иванов ВЮ (Код-Эксперт) 23.12.2024 Выполнение задач №000050329
Процедура ДополнитьТекстыЗапросовПроведения_РН_тн_АкцизыПоПриобретеннымЦенностям(
	Запрос, ТекстыЗапроса, Регистры) Экспорт
	
	ДокументСсылка = Запрос.Параметры.Ссылка;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация");
	
	Если НЕ ИспользуетсяНачислениеАкцизов(РеквизитыДокумента.Дата, РеквизитыДокумента.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРегистра = "тн_АкцизыПоПриобретеннымЦенностям";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	СправочникНоменклатура.тн_АкцизнаяГруппа КАК АкцизнаяГруппа,
	|	СправочникНоменклатура.тн_КоэффициентЕдиницыАкциза КАК КоэффициентЕдиницыАкциза,
	|	СУММА(ПриобретениеТоваровУслугТовары.Количество) КАК Количество,
	|	ПриобретениеТоваровУслуг.Организация КАК Организация
	|ПОМЕСТИТЬ ТЧ_Товары
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО ПриобретениеТоваровУслугТовары.Номенклатура = СправочникНоменклатура.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|		ПО ПриобретениеТоваровУслугТовары.Ссылка = ПриобретениеТоваровУслуг.Ссылка
	|ГДЕ
	|	ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка
	|	И СправочникНоменклатура.ПодакцизныйТовар
	|	И СправочникНоменклатура.тн_АкцизнаяГруппа <> ЗНАЧЕНИЕ(Справочник.тн_АкцизныеГруппы.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	СправочникНоменклатура.тн_АкцизнаяГруппа,
	|	ПриобретениеТоваровУслугТовары.Номенклатура,
	|	СправочникНоменклатура.тн_КоэффициентЕдиницыАкциза,
	|	ПриобретениеТоваровУслуг.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	АкцизнаяГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тн_СтавкиАкцизовСрезПоследних.АкцизнаяГруппа КАК АкцизнаяГруппа,
	|	тн_СтавкиАкцизовСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	тн_СтавкиАкцизовСрезПоследних.Количество КАК Количество,
	|	тн_СтавкиАкцизовСрезПоследних.СтавкаАкциза КАК СтавкаАкциза
	|ПОМЕСТИТЬ ВТ_СтавкиАкцизов
	|ИЗ
	|	РегистрСведений.тн_СтавкиАкцизов.СрезПоследних(
	|			&Период,
	|			АкцизнаяГруппа В
	|				(ВЫБРАТЬ
	|					ТЧ_Товары.АкцизнаяГруппа КАК АкцизнаяГруппа
	|				ИЗ
	|					ТЧ_Товары КАК ТЧ_Товары)) КАК тн_СтавкиАкцизовСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	АкцизнаяГруппа,
	|	ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ_Товары.Период КАК Период,
	|	ТЧ_Товары.Организация КАК Организация,
	|	ТЧ_Товары.ВидДвижения КАК ВидДвижения,
	|	ТЧ_Товары.АкцизнаяГруппа КАК АкцизнаяГруппа,
	|	ТЧ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_СтавкиАкцизов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ТЧ_Товары.КоэффициентЕдиницыАкциза = 0
	|			ТОГДА 0
	|		ИНАЧЕ ТЧ_Товары.Количество / ТЧ_Товары.КоэффициентЕдиницыАкциза
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТЧ_Товары.КоэффициентЕдиницыАкциза = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_СтавкиАкцизов.СтавкаАкциза * ВТ_СтавкиАкцизов.Количество * ТЧ_Товары.Количество / ТЧ_Товары.КоэффициентЕдиницыАкциза
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ВТ_НачисленияАкцизов
	|ИЗ
	|	ТЧ_Товары КАК ТЧ_Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СтавкиАкцизов КАК ВТ_СтавкиАкцизов
	|		ПО ТЧ_Товары.АкцизнаяГруппа = ВТ_СтавкиАкцизов.АкцизнаяГруппа
	|ГДЕ
	|	ВТ_СтавкиАкцизов.Количество > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТЧ_Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_СтавкиАкцизов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НачисленияАкцизов.Организация КАК Организация,
	|	ВТ_НачисленияАкцизов.АкцизнаяГруппа КАК АкцизнаяГруппа,
	|	ВТ_НачисленияАкцизов.ВидДвижения КАК ВидДвижения,
	|	ВТ_НачисленияАкцизов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_НачисленияАкцизов.Количество КАК Количество,
	|	ВТ_НачисленияАкцизов.Номенклатура КАК Номенклатура,
	|	ВТ_НачисленияАкцизов.Период КАК Период,
	|	ВТ_НачисленияАкцизов.Сумма КАК Сумма
	|ИЗ
	|	ВТ_НачисленияАкцизов КАК ВТ_НачисленияАкцизов";
	
	Если НЕ ПустаяСтрока(ТекстЗапроса) Тогда
		ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	КонецЕсли;
	
КонецПроцедуры // ДополнитьТекстыЗапросовПроведения_РН_тн_АкцизыПоПриобретеннымЦенностям()

// Иванов ВЮ (Код-Эксперт) 23.12.2024 Выполнение задач №000050329
Функция ТекстОтраженияВРеглУчете() Экспорт
	
	Возврат
	"ВЫБРАТЬ
	|	ДокументыКОтражению.Ссылка КАК Ссылка,
	|	ДокументыКОтражению.Период КАК Период,
	|	ДокументыКОтражению.Ссылка.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(СуммаАкциза.Сумма, 0) КАК Сумма,
	|	ЕСТЬNULL(СуммаАкциза.Сумма, 0) КАК СуммаУУ,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПрочиеАктивыПассивы) КАК ВидСчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаДт,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаДт,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.АкцизыПоОплаченнымМатериальнымЦенностям) КАК СчетДт,
	|	ДокументыКОтражению.Ссылка.Контрагент КАК СубконтоДт1,
	|	ДокументыКОтражению.Ссылка КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоДт3,
	|	0 КАК ВалютнаяСуммаДт,
	|	0 КАК КоличествоДт,
	|	0 КАК СуммаНУДт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПрочиеАктивыПассивы) КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	НЕОПРЕДЕЛЕНО КАК НаправлениеДеятельностиКт,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Акцизы) КАК СчетКт,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыПлатежейВГосБюджет.Налог) КАК СубконтоКт1,
	|	ЕСТЬNULL(тн_РегистрацияВНалоговомОргане.РегистрацияВНалоговомОргане, ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)) КАК СубконтоКт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт3,
	|	0 КАК ВалютнаяСуммаКт,
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	""Начисленные акцизы (тн)"" КАК Содержание
	|ИЗ
	|	ДокументыКОтражению КАК ДокументыКОтражению
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			тн_АкцизыПоПриобретеннымЦенностям.Регистратор КАК Регистратор,
	|			СУММА(тн_АкцизыПоПриобретеннымЦенностям.Сумма) КАК Сумма
	|		ИЗ
	|			РегистрНакопления.тн_АкцизыПоПриобретеннымЦенностям КАК тн_АкцизыПоПриобретеннымЦенностям
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыКОтражению КАК ДокументыКОтражению
	|				ПО тн_АкцизыПоПриобретеннымЦенностям.Регистратор = ДокументыКОтражению.Ссылка
	|		
	|		СГРУППИРОВАТЬ ПО
	|			тн_АкцизыПоПриобретеннымЦенностям.Регистратор) КАК СуммаАкциза
	|		ПО ДокументыКОтражению.Ссылка = СуммаАкциза.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ тн_РегистрацияВНалоговомОргане КАК тн_РегистрацияВНалоговомОргане
	|		ПО ДокументыКОтражению.Ссылка = тн_РегистрацияВНалоговомОргане.Ссылка";
	
КонецФункции // ТекстОтраженияВРеглУчете()

// Иванов ВЮ (Код-Эксперт) 23.12.2024 Выполнение задач №000050329
Функция ТекстЗапросаВТОтраженияВРеглУчете() Экспорт
	
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыКОтражению.Ссылка КАК Ссылка,
	|	НастройкиПоОрганизациям.Период КАК Период,
	|	НастройкиПоОрганизациям.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_СрезПоПериодамВедетсяНачислениеПоАкцизамПоОрганизациям
	|ИЗ
	|	ДокументыКОтражению КАК ДокументыКОтражению
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_ДополнительныеНастройкиПоОрганизациям КАК НастройкиПоОрганизациям
	|		ПО ДокументыКОтражению.Период >= НастройкиПоОрганизациям.Период
	|			И ДокументыКОтражению.Ссылка.Организация = НастройкиПоОрганизациям.Организация
	|ГДЕ
	|	ДокументыКОтражению.Период >= НастройкиПоОрганизациям.ДатаНачалаНачисленияАкцизов
	|	И НЕ НастройкиПоОрганизациям.ДатаНачалаНачисленияАкцизов = ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_СрезПоПериодам.Ссылка КАК Ссылка,
	|	ВТ_СрезПоПериодам.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_ВедетсяНачислениеПоАкцизамПоОрганизациям
	|ИЗ
	|	ВТ_СрезПоПериодамВедетсяНачислениеПоАкцизамПоОрганизациям КАК ВТ_СрезПоПериодам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.тн_ДополнительныеНастройкиПоОрганизациям КАК НастройкиПоОрганизациям
	|		ПО ВТ_СрезПоПериодам.Период = НастройкиПоОрганизациям.Период
	|			И ВТ_СрезПоПериодам.Организация = НастройкиПоОрганизациям.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыКОтражению.Период КАК Период,
	|	ДокументыКОтражению.Ссылка КАК Ссылка,
	|	ТекущаяРегистрация.СтруктурнаяЕдиница КАК Организация,
	|	МАКСИМУМ(ЕСТЬNULL(ТекущаяРегистрация.Период, ДАТАВРЕМЯ(1, 1, 1))) КАК ПериодПоРС
	|ПОМЕСТИТЬ ВТ_СрезПоПериодамИсторийРегистрацииВНалоговомОргане
	|ИЗ
	|	ДокументыКОтражению КАК ДокументыКОтражению
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВедетсяНачислениеПоАкцизамПоОрганизациям КАК ВТ_ВедетсяНачислениеПоАкцизамПоОрганизациям
	|		ПО ДокументыКОтражению.Ссылка = ВТ_ВедетсяНачислениеПоАкцизамПоОрганизациям.Ссылка
	|			И ДокументыКОтражению.Ссылка.Организация = ВТ_ВедетсяНачислениеПоАкцизамПоОрганизациям.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияРегистрацийВНалоговомОргане КАК ТекущаяРегистрация
	|		ПО ДокументыКОтражению.Период >= ТекущаяРегистрация.Период
	|			И ДокументыКОтражению.Ссылка.Организация = ТекущаяРегистрация.СтруктурнаяЕдиница
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ТекущаяРегистрация.СтруктурнаяЕдиница) = ТИП(Справочник.Организации)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыКОтражению.Период,
	|	ДокументыКОтражению.Ссылка,
	|	ТекущаяРегистрация.СтруктурнаяЕдиница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_СрезПоПериодам.Период КАК Период,
	|	ВТ_СрезПоПериодам.Ссылка КАК Ссылка,
	|	ВТ_СрезПоПериодам.Организация КАК Организация,
	|	ЕСТЬNULL(ИсторияРегистрацийВНалоговомОргане.РегистрацияВНалоговомОргане, ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)) КАК РегистрацияВНалоговомОргане,
	|	ЕСТЬNULL(ИсторияРегистрацийВНалоговомОргане.РегистрацияВНалоговомОргане.КодРегиона, СТРОКА(2)) КАК КодРегиона
	|ПОМЕСТИТЬ ВТ_ТекущаяРегистрацияОрганизации
	|ИЗ
	|	ВТ_СрезПоПериодамИсторийРегистрацииВНалоговомОргане КАК ВТ_СрезПоПериодам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияРегистрацийВНалоговомОргане КАК ИсторияРегистрацийВНалоговомОргане
	|		ПО ВТ_СрезПоПериодам.ПериодПоРС = ИсторияРегистрацийВНалоговомОргане.Период
	|			И ВТ_СрезПоПериодам.Организация = ИсторияРегистрацийВНалоговомОргане.СтруктурнаяЕдиница
	|;
	|
