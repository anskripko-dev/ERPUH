// Иванов ВЮ (Код-Эксперт) 23.12.2024 Выполнение задач №000050329
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъектаЗавершениеПеред(Форма, Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив") И Результат.Количество() > 0 Тогда
		
		ИмяГруппыПолейАкциза = ИмяГруппыПолейАкцизаНаФорме();
		ИндексЭлемента = Результат.Найти(ИмяГруппыПолейАкциза);
		
		Если ИндексЭлемента <> Неопределено Тогда
			
			Результат.Удалить(ИндексЭлемента);
			
			ЭлементыФормы = Форма.Элементы;
			
			Если НЕ ЭлементыФормы.Найти(ИмяГруппыПолейАкциза) = Неопределено Тогда
				СнятьОграничениеПросмотраЭлементовАкциза(ЭлементыФормы[ИмяГруппыПолейАкциза]);;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // Подключаемый_РазрешитьРедактированиеРеквизитовОбъектаЗавершениеПеред()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура ВывестиСтрокуАкцизнаяГруппаВКарточкеНоменклатурыНаФормеЭлементаСправочникаНоменклатуры(
	ТабличныйДокументПраво, Объект) Экспорт
	
	Если НайтиРеквизитАкцизнаяГруппаСправочникаНоменклатура() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.ПодакцизныйТовар Тогда
		Возврат;
	КонецЕсли;
	
	Область = Новый ТабличныйДокумент;
	ЯчейкиСтроки = Область.Область(1, 2, 1, 21);
	ЯчейкиСтроки.Объединить();
	ЯчейкиСтроки.Текст = СтрШаблон("Акцизная группа (тн): %1", Объект[ИмяРеквизитаАкцизнаяГруппаСправочникаНоменклатура()]);
	ЯчейкиСтроки.Расшифровка = ИмяРеквизитаАкцизнаяГруппаСправочникаНоменклатура();
	
	ТабличныйДокументПраво.Вывести(Область);
	
	Область = Новый ТабличныйДокумент;
	ЯчейкиСтроки = Область.Область(1, 2, 1, 21);
	ЯчейкиСтроки.Объединить();
	ЯчейкиСтроки.Текст = СтрШаблон("Коэффициент единицы акциза (тн): %1", Объект[ИмяРеквизитаКоэффициентЕдиницыАкцизаСправочникаНоменклатура()]);
	ЯчейкиСтроки.Расшифровка = ИмяРеквизитаКоэффициентЕдиницыАкцизаСправочникаНоменклатура();
	
	ТабличныйДокументПраво.Вывести(Область);
	
КонецПроцедуры // ВывестиСтрокуАкцизнаяГруппаВКарточкеНоменклатурыНаФормеЭлементаСправочникаНоменклатуры()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура ВывестиГруппуПолейАкцизаНаФормеЭлементаСправочникаНоменклатуры(Форма) Экспорт
	
	РеквизитАкцизнаяГруппа = НайтиРеквизитАкцизнаяГруппаСправочникаНоменклатура();
	Если РеквизитАкцизнаяГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыФормы = Форма.Элементы;
	
	ИмяГруппыПолей = ИмяГруппыПолейАкцизаНаФорме();
	ГруппаПолейАкциза = ЭлементыФормы.Найти(ИмяГруппыПолей);
	
	Если ГруппаПолейАкциза = Неопределено Тогда
		
		ПараметрыЭлемента = Новый Структура;
		ПараметрыЭлемента.Вставить("Отображение", ОтображениеОбычнойГруппы.Нет);
		ПараметрыЭлемента.Вставить("ОтображатьЗаголовок", Ложь);
		ПараметрыЭлемента.Вставить("Группировка", ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда);
		
		ГруппаПолейАкциза =
			ФормыУХ.СоздатьГруппуФормы(
				ЭлементыФормы,
				ИмяГруппыПолей,
				"",
				ВидГруппыФормы.ОбычнаяГруппа,
				ЭлементыФормы.ПодакцизныйТовар.Родитель,
				ЭлементыФормы.ПодакцизныйТовар,
				ПараметрыЭлемента);
		
		ЭлементыФормы.Переместить(
			ЭлементыФормы.ПодакцизныйТовар, 
			ЭлементыФормы.ПодакцизныйТовар.Родитель,
			ГруппаПолейАкциза);
		
	КонецЕсли;
	
	ТекстОшибкиВыводаПоля = "Ошибка вывода на форму поля %1.";
	
	// Поле "Акцизная группа (тн)":
	
	ПолеАкцизнаяГруппа = НайтиСоздатьПолеАкцизнаяГруппаНаФорме(Форма, ГруппаПолейАкциза);
	Если ПолеАкцизнаяГруппа = Неопределено Тогда
		ТекстСообщения = СтрШаблон(ТекстОшибкиВыводаПоля, РеквизитАкцизнаяГруппа.Синоним);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	// Поле "Коэффициент единицы акциза (тн)":
	
	РеквизитКоэффициентЕдиницыАкциза = НайтиРеквизитКоэффициентЕдиницыАкцизаСправочникаНоменклатура();
	Если НЕ РеквизитКоэффициентЕдиницыАкциза = Неопределено Тогда
		
		ПолеКоэффициентЕдиницыАкциза = НайтиСоздатьПолеКоэффициентЕдиницыАкцизаНаФорме(Форма, ГруппаПолейАкциза);
		Если ГруппаПолейАкциза = Неопределено Тогда
			ТекстСообщения = СтрШаблон(ТекстОшибкиВыводаПоля, РеквизитКоэффициентЕдиницыАкциза.Синоним);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьВидимостьГруппыПолейАкцизаНаФорме(Форма);
	
КонецПроцедуры // ВывестиГруппуПолейАкцизаНаФормеЭлементаСправочникаНоменклатуры()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура ВывестиГруппуПолейФлаговАкцизаНаФормеРазблокированиеРеквизитовСправочникаНоменклатуры(Форма, ЭтоПодакцизныйТовар) Экспорт
	
	Если НЕ ЭтоПодакцизныйТовар Тогда
		Возврат;
	КонецЕсли;
	
	Если НайтиРеквизитАкцизнаяГруппаСправочникаНоменклатура() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыФормы = Форма.Элементы;
	
	РеквизитыФормы = ФормыУХ.НачатьИзменениеРеквизитовФормы(Форма);
	
	// Реквизит формы "тп_ГруппаПолейАкциза":
	
	ИмяГруппыПолей = ИмяГруппыПолейАкцизаНаФорме();
	ЗаголовокРеквизитаАкцизнаяГруппа = "Разрешить редактирование Акцизной группы (тн)""";
	
	ФормыУХ.СоздатьДобавитьРеквизитФормы(Форма,
		РеквизитыФормы.Добавляемые,
		ИмяГруппыПолей,
		Новый ОписаниеТипов("Булево"),
		"",
		ЗаголовокРеквизитаАкцизнаяГруппа,
		ЛОЖЬ);
	ФормыУХ.ЗавершитьИзменениеРеквизитовФормы(Форма, РеквизитыФормы);
	
	Форма[ИмяГруппыПолей] = Истина;
	Форма.ИменаРеквизитовФормы.Добавить(ИмяГруппыПолей, ИмяГруппыПолей);
	
	// Элемент формы "тп_ГруппаПолейАкциза":
	
	ПараметрыЭлемента = Новый Структура;
	ПараметрыЭлемента.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Право);
	
	ПолеФлажкаАкцизнаяГруппа =
		ФормыУХ.СоздатьПолеФормы(
			ЭлементыФормы,
			ИмяГруппыПолей,
			ЗаголовокРеквизитаАкцизнаяГруппа,
			ИмяГруппыПолей,
			ВидПоляФормы.ПолеФлажка,
			Форма,
			ЭлементыФормы.ПодакцизныйТовар,
			ПараметрыЭлемента);
	
	ЭлементыФормы.Переместить(
			ЭлементыФормы.ПодакцизныйТовар, 
			ЭлементыФормы.ПодакцизныйТовар.Родитель,
			ПолеФлажкаАкцизнаяГруппа);
	
КонецПроцедуры // ВывестиГруппуПолейФлаговАкцизаНаФормеРазблокированиеРеквизитовСправочникаНоменклатуры()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура ПодакцизныйТоварПриИзмененииНаФормеЭлементаСправочникаНоменклатура(Форма) Экспорт
	
	ОбновитьВидимостьГруппыПолейАкцизаНаФорме(Форма);
	
КонецПроцедуры // ПодакцизныйТоварПриИзмененииНаФормеЭлементаСправочникаНоменклатура()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура ФормаЭлементаСправочникаНоменклатура_ПриСозданииНаСервереПосле(Форма) Экспорт
	
	РеквизитАкцизнаяГруппа = НайтиРеквизитАкцизнаяГруппаСправочникаНоменклатура();
	Если НЕ РеквизитАкцизнаяГруппа = Неопределено Тогда
		ИмяРеквизита = РеквизитАкцизнаяГруппа.Имя;
		ФормыУХ.ДобавитьРеквизитВПараметрыЗапретаРедактирования(Форма, ИмяРеквизита, ИмяРеквизита);
	КонецЕсли;
	
	РеквизитКоэффициентЕдиницыАкциза = НайтиРеквизитКоэффициентЕдиницыАкцизаСправочникаНоменклатура();
	Если НЕ РеквизитКоэффициентЕдиницыАкциза = Неопределено Тогда
		ИмяРеквизита = РеквизитКоэффициентЕдиницыАкциза.Имя;
		ФормыУХ.ДобавитьРеквизитВПараметрыЗапретаРедактирования(Форма, ИмяРеквизита, ИмяРеквизита);
	КонецЕсли;
	
КонецПроцедуры // ФормаЭлементаСправочникаНоменклатура_ПриСозданииНаСервереПосле()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура ИспользованиеЭлементовФормыСправочникаНоменклатура(ВидимостьЭлементов, Объект, РежимВидимостиПоказатьТолькоВажные, РежимПроверкиИспользованияРеквизитов) Экспорт
	
	Если РежимПроверкиИспользованияРеквизитов Тогда
		Возврат;
	КонецЕсли;
	
	ВидимостьЭлементов.Вставить(ИмяГруппыПолейАкцизаНаФорме(), Объект.ПодакцизныйТовар);
	
	ИмяРеквизитаАкцизнаяГруппа = ИмяРеквизитаАкцизнаяГруппаСправочникаНоменклатура();
	Если ВидимостьЭлементов.Свойство(ИмяРеквизитаАкцизнаяГруппа) Тогда
		ВидимостьЭлементов.Удалить(ИмяРеквизитаАкцизнаяГруппа);
	КонецЕсли;
	
	ИмяРеквизитаКоэффициентЕдиницыАкциза = ИмяРеквизитаКоэффициентЕдиницыАкцизаСправочникаНоменклатура();
	Если ВидимостьЭлементов.Свойство(ИмяРеквизитаКоэффициентЕдиницыАкциза) Тогда
		ВидимостьЭлементов.Удалить(ИмяРеквизитаКоэффициентЕдиницыАкциза);
	КонецЕсли;
	
КонецПроцедуры // ИспользованиеЭлементовФормыСправочникаНоменклатура()

#КонецОбласти

