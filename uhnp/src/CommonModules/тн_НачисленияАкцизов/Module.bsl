// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура ОбновитьВидимостьГруппыПолейАкцизаНаФорме(Форма)
	
	Если НайтиРеквизитАкцизнаяГруппаСправочникаНоменклатура() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаПолейАкциза = Форма.Элементы.Найти(ИмяГруппыПолейАкцизаНаФорме());
	
	Если ГруппаПолейАкциза = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаПолейАкциза.Видимость = Форма.Объект.ПодакцизныйТовар;
	
	Если ГруппаПолейАкциза.Видимость Тогда
		СнятьОграничениеПросмотраЭлементовАкциза(ГруппаПолейАкциза);
	КонецЕсли;
	
КонецПроцедуры // ОбновитьВидимостьГруппыПолейАкцизаНаФорме()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Процедура СнятьОграничениеПросмотраЭлементовАкциза(ГруппаПолейАкциза)
	
	ГруппаПолейАкциза.ТолькоПросмотр = Ложь;
	Для Каждого ПодчиненныйЭлемент Из ГруппаПолейАкциза.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ПолеФормы") Тогда
			ПодчиненныйЭлемент.ТолькоПросмотр = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // СнятьОграничениеПросмотраЭлементовАкциза()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Функция НайтиСоздатьПолеАкцизнаяГруппаНаФорме(Форма, ГруппаПолейАкциза)
	
	ЭлементыФормы = Форма.Элементы;
	
	РеквизитАкцизнаяГруппа = НайтиРеквизитАкцизнаяГруппаСправочникаНоменклатура();
	Если РеквизитАкцизнаяГруппа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолеАкцизнаяГруппа = ЭлементыФормы.Найти(РеквизитАкцизнаяГруппа.Имя);
	
	Если ПолеАкцизнаяГруппа = Неопределено Тогда
		
		ПараметрыЭлемента = Новый Структура;
		ПутьКДанным = "Объект." + РеквизитАкцизнаяГруппа.Имя;
		
		ПолеАкцизнаяГруппа =
			ФормыУХ.СоздатьПолеФормы(
				ЭлементыФормы,
				РеквизитАкцизнаяГруппа.Имя,
				РеквизитАкцизнаяГруппа.Синоним,
				ПутьКДанным,
				ВидПоляФормы.ПолеВвода,
				ГруппаПолейАкциза,
				Неопределено,
				ПараметрыЭлемента);
		
	КонецЕсли;
	
	Возврат ПолеАкцизнаяГруппа;
	
КонецФункции // НайтиСоздатьПолеАкцизнаяГруппаНаФорме()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Функция НайтиСоздатьПолеКоэффициентЕдиницыАкцизаНаФорме(Форма, ГруппаПолейАкциза)
	
	ЭлементыФормы = Форма.Элементы;
	
	РеквизитКоэффициентЕдиницыАкциза = НайтиРеквизитКоэффициентЕдиницыАкцизаСправочникаНоменклатура();
	Если РеквизитКоэффициентЕдиницыАкциза = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолеКоэффициентЕдиницыАкциза = ЭлементыФормы.Найти(РеквизитКоэффициентЕдиницыАкциза.Имя);
	
	Если ПолеКоэффициентЕдиницыАкциза = Неопределено Тогда
		
		ПараметрыЭлемента = Новый Структура;
		ПутьКДанным = "Объект." + РеквизитКоэффициентЕдиницыАкциза.Имя;
		
		ПолеКоэффициентЕдиницыАкциза =
			ФормыУХ.СоздатьПолеФормы(
				ЭлементыФормы,
				РеквизитКоэффициентЕдиницыАкциза.Имя,
				РеквизитКоэффициентЕдиницыАкциза.Синоним,
				ПутьКДанным,
				ВидПоляФормы.ПолеВвода,
				ГруппаПолейАкциза,
				Неопределено,
				ПараметрыЭлемента);
		
		ФормыУХ.СоздатьДекорациюФормы(
			ЭлементыФормы,
			"тн_НадписьЕдиницыХранения",
			Форма.Объект.ЕдиницаИзмерения,
			ВидДекорацииФормы.Надпись,
			ГруппаПолейАкциза,
			Неопределено,
			ПараметрыЭлемента);
		
	КонецЕсли;
	
	Возврат ПолеКоэффициентЕдиницыАкциза;
	
КонецФункции // НайтиСоздатьПолеКоэффициентЕдиницыАкцизаНаФорме()

