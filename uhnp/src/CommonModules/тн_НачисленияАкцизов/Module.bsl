// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Функция ОпределитьТекущуюРегистрациюОрганизацииВНалоговомОргане(Организация, Дата, Отказ)
	
	РегистрацияВНалоговомОргане = Неопределено;
	
	НалоговыйУчетОбособленныхПодразделений.ОпределитьТекущуюРегистрациюОрганизацииВНалоговомОргане(
		РегистрацияВНалоговомОргане,
		Организация,
		Дата);
	
	Если НЕ ЗначениеЗаполнено(РегистрацияВНалоговомОргане) Тогда
		ТекстСообщения = СтрШаблон("Отсутствует регистрация организации %1 в налоговом органе на дату %2.",
							Организация,
							Дата);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	
	Возврат РегистрацияВНалоговомОргане;
	
КонецФункции // ОпределитьТекущуюРегистрациюОрганизацииВНалоговомОргане()

// Иванов ВЮ (Код-Эксперт) 21.12.2024 Выполнение задач №000050329
Функция ИспользуетсяНачислениеАкцизов(Дата, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.тн_ДополнительныеНастройкиПоОрганизациям.СрезПоследних(&Дата, Организация = &Организация) КАК Т
	|ГДЕ
	|	Т.ДатаНачалаНачисленияАкцизов <= &Дата
	|	И НЕ Т.ДатаНачалаНачисленияАкцизов = ДАТАВРЕМЯ(1, 1, 1)";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции // ИспользуетсяНачислениеАкцизов()

