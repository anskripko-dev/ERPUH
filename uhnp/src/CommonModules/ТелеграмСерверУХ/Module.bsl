	Возврат РезультатФункции;
	
КонецФункции		//СоответствиеДанныхЭтапов()

Процедура ЗаписатьИсториюСообщений(ТекстСообщения, НомерСообщения, Пользователь, ТелеграмИмя, ТелеграмФамилия)
	
	МенеджерЗаписи = РегистрыСведений.ТелеграмИсторияСообщений.СоздатьМенеджерЗаписи();
		
	МенеджерЗаписи.НомерСообщения = НомерСообщения;
	МенеджерЗаписи.Пользователь = Пользователь;
	
	МенеджерЗаписи.Сообщение = СокрЛП(ТекстСообщения);
	МенеджерЗаписи.ТелеграмИмя = ТелеграмИмя;
	МенеджерЗаписи.ТелеграмФамилия = ТелеграмФамилия;
		
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры		//ЗаписатьИсториюСообщений()

Процедура ОчиститьИсториюСообщений(Пользователь = Неопределено, МассивНомеровСообщений = Неопределено, ТелеграмИмя = Неопределено, ТелеграмФамилия = Неопределено) Экспорт
	
	ЗапросПоИсторииСообщений = Новый Запрос;
	УсловиеПользователь = "";
	УсловиеНомераСообщений = "";
	УсловиеТелеграмИмя = "";
	УсловиеТелеграмФамилия = "";
	
	Если Пользователь <> неопределено тогда
		ЗапросПоИсторииСообщений.УстановитьПараметр("Пользователь", Пользователь);
		УсловиеПользователь = "
	|	ТелеграмИсторияСообщений.Пользователь = &Пользователь";
	КонецЕсли;
	
	Если МассивНомеровСообщений <> неопределено тогда
		ЗапросПоИсторииСообщений.УстановитьПараметр("МассивНомеровСообщений", МассивНомеровСообщений);
		УсловиеНомераСообщений = "
	|	И НЕ ТелеграмИсторияСообщений.НомерСообщения В (&МассивНомеровСообщений)";
	КонецЕсли;
		
	Если ТелеграмИмя <> неопределено тогда
		УсловиеТелеграмИмя = "
	|	И ТелеграмИсторияСообщений.ТелеграмИмя ПОДОБНО ""%ПараметрТелеграмИмя%""
	|	И НЕ ТелеграмИсторияСообщений.ТелеграмИмя ПОДОБНО ""%[-!-я]%ПараметрТелеграмИмя%""
	|	И НЕ ТелеграмИсторияСообщений.ТелеграмИмя ПОДОБНО ""%ПараметрТелеграмИмя%[-!-я]%""";
		
		УсловиеТелеграмИмя = СтрЗаменить(УсловиеТелеграмИмя, "ПараметрТелеграмИмя", ТелеграмИмя);
	КонецЕсли;
	
	Если ТелеграмФамилия <> неопределено тогда
		УсловиеТелеграмФамилия = "
	|	И ТелеграмИсторияСообщений.ТелеграмФамилия ПОДОБНО ""%ПараметрТелеграмФамилия%""
	|	И НЕ ТелеграмИсторияСообщений.ТелеграмФамилия ПОДОБНО ""%[-!-я]%ПараметрТелеграмФамилия%""
	|	И НЕ ТелеграмИсторияСообщений.ТелеграмФамилия ПОДОБНО ""%ПараметрТелеграмФамилия%[-!-я]%""";
		
		УсловиеТелеграмФамилия = СтрЗаменить(УсловиеТелеграмФамилия, "ПараметрТелеграмФамилия", ТелеграмФамилия);
	КонецЕсли;
		
	ОбщееУсловие = УсловиеПользователь + УсловиеНомераСообщений + УсловиеТелеграмИмя + УсловиеТелеграмФамилия;
	Если Лев(ОбщееУсловие, 3 + СтрДлина("И")) = Символы.ПС + Символы.Таб + ВРег("И ") тогда
		ОбщееУсловие = Символы.ПС + Символы.Таб + Сред(ОбщееУсловие, 4 + СтрДлина("И"));
	КонецЕсли;
		
	ЗапросПоИсторииСообщений.Текст = "ВЫБРАТЬ
	|	ТелеграмИсторияСообщений.НомерСообщения КАК НомерСообщения,
	|	ТелеграмИсторияСообщений.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.ТелеграмИсторияСообщений КАК ТелеграмИсторияСообщений
	|ГДЕ" + ОбщееУсловие;
	
	ВыборкаПоИсторииСообщений = ЗапросПоИсторииСообщений.Выполнить().Выбрать();
	Пока ВыборкаПоИсторииСообщений.Следующий() Цикл
		Запись = РегистрыСведений.ТелеграмИсторияСообщений.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаПоИсторииСообщений);
		Запись.Удалить();
	КонецЦикла;
	
КонецПроцедуры		//ОчиститьИсториюСообщений()

Функция ПроверитьНаличиеСообщенияПоID(НомерСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	1 КАК СообщениеПрочитано
	|ИЗ
	|	РегистрСведений.ТелеграмИсторияСообщений КАК ТелеграмИсторияСообщений
	|ГДЕ
	|	ТелеграмИсторияСообщений.НомерСообщения = &НомерСообщения";
	
	ЗАпрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаЗапроса.Количество() > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;  
	
КонецФункции		//ПроверитьНаличиеСообщенияПоID()

Функция ХранилищеФайлаИзИнформационнойБазы(ФайлСсылка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДвоичныеДанныеФайлов.Файл,
	|	ДвоичныеДанныеФайлов.ДвоичныеДанныеФайла
	|ИЗ
	|	РегистрСведений.ДвоичныеДанныеФайлов КАК ДвоичныеДанныеФайлов
	|ГДЕ
	|	ДвоичныеДанныеФайлов.Файл = &ФайлСсылка";
	
	Запрос.УстановитьПараметр("ФайлСсылка", ФайлСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.ДвоичныеДанныеФайла, Неопределено);
	
КонецФункции		//ХранилищеФайлаИзИнформационнойБазы()

Процедура ДеактивироватьСообщенияТелеграм() Экспорт
	
	ЗапросНавигационныеСсылки = Новый Запрос("ВЫБРАТЬ
	|	ТелеграмНавигационныеСсылки.УИДСообщения КАК УИДСообщения,
	|	ТелеграмНавигационныеСсылки.УИДКнопки КАК УИДКнопки
	|ИЗ
	|	РегистрСведений.ТелеграмНавигационныеСсылки КАК ТелеграмНавигационныеСсылки
	|ГДЕ
	|	ТелеграмНавигационныеСсылки.Дата < &ДатаУдаления");
	
	ЗапросНавигационныеСсылки.УстановитьПараметр("ДатаУдаления", ТекущаяДата() - 86400 * 35);
	
	ВыборкаНавигационныеСсылки = ЗапросНавигационныеСсылки.Выполнить().Выбрать();
	ЗаписьНавигационныеСсылки = РегистрыСведений.ТелеграмНавигационныеСсылки.СоздатьМенеджерЗаписи();
	
	Пока ВыборкаНавигационныеСсылки.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЗаписьНавигационныеСсылки, ВыборкаНавигационныеСсылки);
		ЗаписьНавигационныеСсылки.Удалить();
	КонецЦикла;
	
КонецПроцедуры		//ДеактивироватьСообщенияТелеграм()

Процедура ДобавитьКомандуВложенияСписок(Форма) Экспорт

	АвторизованныйПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
	ГруппаКоманд = Форма.Элементы.Найти("ФормаСогласованиеУХ");
	
	Если НЕ ТИПЗНЧ(АвторизованныйПользователь) = ТИП("СправочникСсылка.ВнешниеПользователи") И АвторизованныйПользователь.ОповещатьЧерезТелеграм И ГруппаКоманд <> Неопределено тогда
		
		Если ГруппаКоманд.ПодчиненныеЭлементы.Количество() > 0 тогда
			ИмяКомандыВложенияСогласования = МодульСогласованияДокументовУХ.ДобавитьКомандуФормы("ВложенияСогласованияСписок", Форма, "Телеграм16х16", НСтр("ru = 'Вложения в Telegram'"));
			ВложенияСогласования = МодульСогласованияДокументовУХ.ДобавитьЭлементКоманды(Форма.Элементы, "ВложенияСогласованияСписок", ИмяКомандыВложенияСогласования, ГруппаКоманд);	
			Форма.Команды["ВложенияСогласованияСписок"].Действие = "ВложенияСогласования_Подключаемый";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры		//ДобавитьКомандуВложенияСписок()

Процедура ДобавитьКомандуВложенияОбъект(Форма) Экспорт

	АвторизованныйПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
	ГруппаКоманд = Форма.Элементы.Найти("ФормаСогласованиеУХ");
		
	Если (АвторизованныйПользователь.ОповещатьЧерезТелеграм ИЛИ АвторизованныйПользователь.ОповещатьПоEmail) И ГруппаКоманд <> Неопределено Тогда
				
		УсловиеСогласующего = НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Согласующий");
		Если Не УсловиеСогласующего Тогда 
			Если Форма.Согласующий <> МодульУправленияПроцессамиУХ.СогласующийНеОпределенПредставление() Тогда
				УсловиеСогласующего = Истина;
			КонецЕсли;
		КонецЕсли;
			
		Если ГруппаКоманд.ПодчиненныеЭлементы.Количество() > 0 И УсловиеСогласующего тогда
			ИмяКомандыВложенияСогласования = МодульСогласованияДокументовУХ.ДобавитьКомандуФормы("ВложенияСогласованияОбъект", Форма, "ВложенияСогласования", НСтр("ru = 'Вложения согласования'"));
			ВложенияСогласования = МодульСогласованияДокументовУХ.ДобавитьЭлементКоманды(Форма.Элементы, "ВложенияСогласованияОбъект", ИмяКомандыВложенияСогласования, ГруппаКоманд);	
			Форма.Команды["ВложенияСогласованияОбъект"].Действие = "ВложенияСогласования_Подключаемый";
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры		//ДобавитьКомандуВложенияОбъект()

Процедура ИсточникНастраиваемыйОтчет(Источник, СписокТабличныхДокументов) Экспорт
	
	Если Не ТипЗнч(Источник) = Тип("ДокументСсылка.НастраиваемыйОтчет") тогда
		Возврат;
	КонецЕсли;
		
	ИсточникОбъект = Источник.ПолучитьОбъект();
		
	Если ОбщегоНазначенияПовтИспУХ.ИспользуетсяМногопериоднаяОтчетность() Тогда
		СписокТабличныхДокументовЭО = ПроверитьВозможностьОтображенияВТекущемРежимеМногопериодная(ИсточникОбъект);
	Иначе	
		СписокТабличныхДокументовЭО = ПроверитьВозможностьОтображенияВТекущемРежиме(ИсточникОбъект);
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из СписокТабличныхДокументовЭО Цикл
		СписокТабличныхДокументов.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
		
КонецПроцедуры

Процедура ОтобразитьВВыбраннойВалюте(РабочийОбъект, ПолеТабличногоДокументаМакет, ПересчитатьВсе = Ложь)
				
	// формируем структуру параметров
	РабочийОбъект.СформироватьСтруктуруПараметров();
		
	Если НЕ РабочийОбъект.ОсновнаяВалюта=РабочийОбъект.мТекущаяВалюта Тогда 
		
		РабочийОбъект.ЗаполнитьПараметрыВМакете(ПолеТабличногоДокументаМакет, РабочийОбъект.мТекущаяВалюта);
		РабочийОбъект.ОбновитьЗначенияПоказателей(РабочийОбъект.мПоказателиВВалюте, ПолеТабличногоДокументаМакет);
		
	Иначе
		
		РабочийОбъект.ЗаполнитьПараметрыВМакете(ПолеТабличногоДокументаМакет);
		РабочийОбъект.ОбновитьЗначенияПоказателей(РабочийОбъект.мПоказатели, ПолеТабличногоДокументаМакет);
			
	КонецЕсли;
		
КонецПроцедуры		//ОтобразитьВВыбраннойВалюте()

Процедура ОбновитьОтображениеЯзыков(РабочийОбъект, ПолеТабличногоДокументаМакет, НомерОсновногоЯзыка, СпособВыводаФорма)
	
	СтруктураЯзыков=Новый Структура;
	СтруктураЯзыков.Вставить("ОсновнойЯзык",НомерОсновногоЯзыка);
	
	СтруктураЯзыков.Вставить("ВыводитьДополнительныйЯзык1", Ложь);
	СтруктураЯзыков.Вставить("ВыводитьДополнительныйЯзык2", Ложь);
	
	Если НЕ ТипЗнч(СпособВыводаФорма)=Тип("Строка") Тогда
		ДополнительныеЯзыкиУХ.ПеревестиТекстыОбластей(ПолеТабличногоДокументаМакет, 0, НомерОсновногоЯзыка, РабочийОбъект.ВидОтчета);
	КонецЕсли;
	
	ЯзыкОтображения=НомерОсновногоЯзыка;
			
КонецПроцедуры		// ОбновитьОтображениеЯзыков()

Функция ПроверитьВозможностьОтображенияВТекущемРежиме(РабочийОбъект = Неопределено, НужнаПроверка=Истина)
		
	РабочийОбъект.ПроверитьКонтекстИнициализирован();
	
	ТекущийДелитель = ПолучитьЗначениеДелителяСервер(РабочийОбъект);
	ТекущаяТочность = РабочийОбъект.УровеньТочности;
	
	ПолеТабличногоДокументаМакет = Новый ТабличныйДокумент;
	ПолеТабличногоДокументаМакет.АвтоМасштаб = Истина;
	ПолеТабличногоДокументаМакет.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		
	ЯзыкОтображения=РабочийОбъект.глОсновнойЯзык;
			
	РабочийОбъект.РежимКорректировки = Ложь;
		
	Если СтрНайти(РабочийОбъект.СпособВывода,"Бланк") > 0 И НЕ РабочийОбъект.ШаблонОтчета.Пустая() Тогда
		
		МакетОснование = Неопределено;
				
		РабочийОбъект.СгенерироватьМакет(ПолеТабличногоДокументаМакет, РабочийОбъект.ШаблонОтчета);

		ОтобразитьВВыбраннойВалюте(РабочийОбъект, ПолеТабличногоДокументаМакет, Истина);
		
		Если ЯзыкОтображения > 0 Тогда
			
			ОбновитьОтображениеЯзыков(РабочийОбъект, ПолеТабличногоДокументаМакет, ЯзыкОтображения, РабочийОбъект.СпособВывода);
			
		КонецЕсли;
					
	КонецЕсли;
		
	СписокТабличныхДокументов = Новый СписокЗначений();
	СписокТабличныхДокументов.Добавить(ПолеТабличногоДокументаМакет, Строка(РабочийОбъект.ШаблонОтчета));
	
	Возврат СписокТабличныхДокументов;
	
КонецФункции		//ПроверитьВозможностьОтображенияВТекущемРежиме()

Процедура УдалитьПустыеКолонки(ТабличныйДокумент)
	
	ВысотаТаблицы = ТабличныйДокумент.ВысотаТаблицы;
	ШиринаТаблицы = ТабличныйДокумент.ШиринаТаблицы;
	
	ПустыеКолонки = Новый Массив;
	
	Для НомерКолонки = 1 По ШиринаТаблицы Цикл
		
		ВсеЯчейкиПустые = Истина;
		Для НомерСтроки = 1 По ВысотаТаблицы Цикл
			
			Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
			Если Не ПустаяСтрока(Ячейка.Текст) Тогда
				ВсеЯчейкиПустые = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВсеЯчейкиПустые Тогда
			ПустыеКолонки.Добавить(НомерКолонки);
		КонецЕсли;
		
	КонецЦикла;
	
	ВГраница = ПустыеКолонки.ВГраница();
	Для Индекс = 0 По ВГраница Цикл
		
		НомерКолонки = ПустыеКолонки[ВГраница - Индекс];
		Область = ТабличныйДокумент.Область(, НомерКолонки, , НомерКолонки);
		ТабличныйДокумент.УдалитьОбласть(Область, ТипСмещенияТабличногоДокумента.ПоВертикали);
		
	КонецЦикла;
	
КонецПроцедуры		//УдалитьПустыеКолонки()

Функция ПроверитьВозможностьОтображенияВТекущемРежимеМногопериодная(РабочийОбъект)

	ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
	
	КэшБланков = Новый ТаблицаЗначений();
	КэшБланков.Колонки.Добавить("Бланк");
	КэшБланков.Колонки.Добавить("РежимБланка");
	КэшБланков.Колонки.Добавить("Скрытый", ОписаниеТипаБулево);
	КэшБланков.Колонки.Добавить("Обновлен", ОписаниеТипаБулево);
	КэшБланков.Колонки.Добавить("ЭтоОсновнойБланк", ОписаниеТипаБулево);
	КэшБланков.Колонки.Добавить("Выведен", ОписаниеТипаБулево);
	КэшБланков.Колонки.Добавить("ИмяСтраницы");
	КэшБланков.Колонки.Добавить("ИмяОбъекта");
	КэшБланков.Колонки.Добавить("ИмяМакета");
	КэшБланков.Колонки.Добавить("УстановленаРасшифровкаДиаграммы", ОписаниеТипаБулево);
	
	Если СтрНайти(РабочийОбъект.СпособВывода, "Бланк") > 0 И РабочийОбъект.ШаблонОтчета.Пустая() Тогда
		
		Возврат Новый СписокЗначений;
		
	ИначеЕсли НЕ РабочийОбъект.СпособВывода = "СводнаяТаблица" И (РабочийОбъект.ШаблонОтчета.Пустая() ИЛИ РабочийОбъект.ШаблонОтчета.РежимБланка <> 2) Тогда
		
		БланкДляОтображения = Документы.НастраиваемыйОтчет.ЗначениеНастройкиОбработкиДокумента(РабочийОбъект, "БланкДляОтображения");
		
		Если ЗначениеЗаполнено(БланкДляОтображения) Тогда
			РабочийОбъект.ШаблонОтчета = БланкДляОтображения;
			РабочийОбъект.СпособВывода = "Бланк";
			СоздатьОбъектыДополнительныхБланков(РабочийОбъект, КэшБланков);
			СписокТабличныхДокументов = ВывестиДанныеЭкземпляра(РабочийОбъект,,Ложь,Ложь, КэшБланков);
		КонецЕсли;
		
	ИначеЕсли РабочийОбъект.СпособВывода = "СводнаяТаблица" И РабочийОбъект.ШаблонОтчета.Пустая() Тогда
		
		Возврат Новый СписокЗначений;
		
	ИначеЕсли РабочийОбъект.СпособВывода = "СводнаяТаблица" Тогда
		
		СоздатьОбъектыДополнительныхБланков(РабочийОбъект, КэшБланков);
		СписокТабличныхДокументов = ВывестиДанныеЭкземпляра(РабочийОбъект,,Ложь,Ложь, КэшБланков);
		
	Иначе
		
		СоздатьОбъектыДополнительныхБланков(РабочийОбъект, КэшБланков);
		СписокТабличныхДокументов = ВывестиДанныеЭкземпляра(РабочийОбъект,,Ложь,Ложь, КэшБланков);
		
	КонецЕсли;
	
	Возврат СписокТабличныхДокументов;
	
КонецФункции

Процедура СоздатьОбъектыДополнительныхБланков(РабочийОбъект, КэшБланков)
		
	МассивБланковДиаграмм = Новый Массив;	

	//Добавляем осовной бланк в кэш
	КэшБланков.Очистить();
	нСтрокаКэшаБланков 					= КэшБланков.Добавить();
	нСтрокаКэшаБланков.Бланк    		= РабочийОбъект.ШаблонОтчета;
	нСтрокаКэшаБланков.ЭтоОсновнойБланк = Истина;
	нСтрокаКэшаБланков.ИмяСтраницы      = "ОсновнойМакет";
	нСтрокаКэшаБланков.ИмяОбъекта       = "ОбъектАналитическогоБланка";
	нСтрокаКэшаБланков.ИмяМакета        = "ПолеТабличногоДокументаМакет";
	
	ТекущийОбъектАБ    					= "ОбъектАналитическогоБланка";
	ТекущийМакет 	   					= "ПолеТабличногоДокументаМакет";
	
	Если РабочийОбъект.ШаблонОтчета.РежимБланка = 2 Тогда
		Обработки.АналитическийБланк.ЗаполнитьБланкиДиаграмм(РабочийОбъект.ШаблонОтчета, МассивБланковДиаграмм);
	КонецЕсли;
	
	Если НЕ РабочийОбъект.ШаблонОтчета.Пустая() И РабочийОбъект.ШаблонОтчета.РежимБланка = 2 Тогда //Это МП Бланк	
		
		ИндексБланка = 1;
				
		//Добавляем дополнительные бланки
		Для Каждого СтрБланк Из РабочийОбъект.ШаблонОтчета.ДополнительныеБланки Цикл											
						
			нСтрокаКэшаБланков 					= КэшБланков.Добавить();
			нСтрокаКэшаБланков.Бланк    		= СтрБланк.Бланк;
			нСтрокаКэшаБланков.ИмяСтраницы      = "Бланк_"+ИндексБланка;
			нСтрокаКэшаБланков.ИмяОбъекта       = "ОбъектАналитическогоБланка";
			нСтрокаКэшаБланков.ИмяМакета        = "ПолеТабличногоДокументаМакет";
			нСтрокаКэшаБланков.Скрытый          = Ложь;
			
			ИндексБланка = ИндексБланка + 1;						
			Обработки.АналитическийБланк.ЗаполнитьБланкиДиаграмм(СтрБланк.Бланк, МассивБланковДиаграмм);
			
		КонецЦикла;				
						
	КонецЕсли;
		
КонецПроцедуры		//СоздатьОбъектыДополнительныхБланков()

Функция ВывестиДанныеЭкземпляра(РабочийОбъект=Неопределено,НужнаПроверка=Истина,ОбновитьВерсии,ВывестиДополнительныеБланки = Истина, КэшБланков)
			
	ТекущийДелитель = ПолучитьЗначениеДелителяСервер(РабочийОбъект);
	ТекущаяТочность = РабочийОбъект.УровеньТочности;
		
	СписокТабличныхДокументовРез = Новый СписокЗначений;
	СтруктураПараметров = Новый Структура("ТекущийДелитель, ТекущаяТочность", ТекущийДелитель, ТекущаяТочность);
							
	Если  НЕ РабочийОбъект.ШаблонОтчета.Пустая() И НЕ РабочийОбъект.ШаблонОтчета.РежимБланка = 1 Тогда
			
		//Сбросим кэш актуальности бланков
		Для Каждого СтрКэш Из КэшБланков Цикл	
			
			СтрКэш.Выведен = Ложь;	
				
			МассивСтраниц = Новый Массив();
			МассивСтраниц.Добавить(СтрКэш.ИмяСтраницы);
			
			СписокТабличныхДокументов = ВывестиБланки(РабочийОбъект, СтруктураПараметров, Ложь, МассивСтраниц, КэшБланков);
			
			Для Каждого ТабличныйДокументЭлемент Из СписокТабличныхДокументов Цикл
				СписокТабличныхДокументовРез.Добавить(ТабличныйДокументЭлемент.Значение, ТабличныйДокументЭлемент.Представление);	
			КонецЦикла;
			
		КонецЦикла;
				
	ИначеЕсли НЕ РабочийОбъект.ШаблонОтчета.Пустая() И РабочийОбъект.ШаблонОтчета.РежимБланка = 1 Тогда 
						         
		ТабличныйДокументРез = ВывестиМакетАналитическийБланкСводнаяТаблица(РабочийОбъект, СтруктураПараметров);
		СписокТабличныхДокументовРез.Добавить(ТабличныйДокументРез, Строка(РабочийОбъект.ШаблонОтчета));
		
	КонецЕсли;
	
	Возврат СписокТабличныхДокументовРез;
			
КонецФункции		//ВывестиДанныеЭкземпляра()

Функция ПолучитьЗначениеДелителяСервер(РабочийОбъект)
	
	Если РабочийОбъект.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1000000") Тогда
		ТекущийДелитель = 1000000;
	ИначеЕсли РабочийОбъект.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1000") Тогда
		ТекущийДелитель =  1000;
	Иначе
		ТекущийДелитель =  1;
	КонецЕсли;
	
	Возврат ТекущийДелитель;
	
КонецФункции		//ПолучитьЗначениеДелителяСервер()

Функция ВывестиБланки(РабочийОбъект, СтруктураПараметров, ДанныеДиаграмм = Ложь, МассивСтраниц, КэшБланков)
	
	КлючевыеПараметры = Новый Структура;
	КлючевыеПараметры.Вставить("Сценарий", РабочийОбъект.Сценарий);
	КлючевыеПараметры.Вставить("ПериодОтчета", РабочийОбъект.ПериодОтчета);
	КлючевыеПараметры.Вставить("ПериодОкончания", РабочийОбъект.ПериодОкончания);
	КлючевыеПараметры.Вставить("Валюта", РабочийОбъект.ОсновнаяВалюта);
	КлючевыеПараметры.Вставить("ИспользоватьБыстрыйОтборПоОрганизации", Истина);
	КлючевыеПараметры.Вставить("Организация", РабочийОбъект.Организация);
	КлючевыеПараметры.Вставить("Проект", РабочийОбъект.Проект);
	
	КлючевыеПараметры.Вставить("ИспользоватьБыстрыйОтборПоАналитикамВерсии",Истина);
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		КлючевыеПараметры.Вставить("Аналитика"+Инд, РабочийОбъект["Аналитика"+Инд]);
	КонецЦикла;	
	
	КлючевыеПараметры.Вставить("УровеньТочности", СтруктураПараметров.ТекущаяТочность);
	КлючевыеПараметры.Вставить("ТекущийДелитель", СтруктураПараметров.ТекущийДелитель);
	КлючевыеПараметры.Вставить("НомерОсновногоЯзыка", ПараметрыСеанса.ЯзыкОтчетности);
	КлючевыеПараметры.Вставить("ТекущееПравило", РабочийОбъект.ПравилоОбработки);
		
	тСтрокаАналитик = "";
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		тСтрокаАналитик = тСтрокаАналитик + "Аналитика"+Инд+",";
	КонецЦикла;	

	УникальныйИдентификатор  = Новый УникальныйИдентификатор();
	
	оЛогИзмененныхДанных 			= Обработки.ЗаписьПоказателяСРасчетомЗависимых.Создать();
	ЛогИзмененныхДанных  			= оЛогИзмененныхДанных.ТаблицаИзмененныхПоказателей.Выгрузить();	
	ЛогИзмененныхДанных.Индексы.Добавить("Сценарий,ПериодОтчета,Организация,Проект,АналитикаВалюта,"+тСтрокаАналитик+"ПоказательОтчета");
	логИзмененныхКомментариев  		= оЛогИзмененныхДанных.ТаблицаИзмененныхПоказателей.Выгрузить();
	логИзмененныхДанныхАдрес 		= ПоместитьВоВременноеХранилище(ЛогИзмененныхДанных, УникальныйИдентификатор);		
	логИзмененныхКомментариевАдрес 	= ПоместитьВоВременноеХранилище(логИзмененныхКомментариев, УникальныйИдентификатор);
		
	КлючевыеПараметры.Вставить("логИзмененныхДанныхАдрес", логИзмененныхДанныхАдрес);
	КлючевыеПараметры.Вставить("логИзмененныхКомментариевАдрес", логИзмененныхКомментариевАдрес);
	КлючевыеПараметры.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КлючевыеПараметры.Вставить("ДополнительныеПараметрыАдрес","");
	КлючевыеПараметры.Вставить("ИдентификаторСеанса", УникальныйИдентификатор);
	
	СписокТабличныхДокументов = СформироватьБланки(КлючевыеПараметры, МассивСтраниц, ДанныеДиаграмм, КэшБланков);
	
	Возврат СписокТабличныхДокументов;
	
КонецФункции		//ВывестиБланки()

Функция ВывестиМакетАналитическийБланкСводнаяТаблица(РабочийОбъект, ДополнительныеПараметры)
		
	МакетОснование=Неопределено;	
		
	ОтчетАБ = Обработки.АналитическийБланк.Создать();
	
	ОтчетАБ.РежимСводнойТаблицы     = Истина;
	ОтчетАБ.Сценарий				= РабочийОбъект.Сценарий;
	ОтчетАБ.ПериодОтчета			= РабочийОбъект.ПериодОтчета;
	ОтчетАБ.ПериодОтчетаОкончание 	= РабочийОбъект.ПериодОкончания;
	ОтчетАБ.Организация 			= РабочийОбъект.Организация;
	ОтчетАБ.Проект 			 		= РабочийОбъект.Проект;
	
	ВыбраннаяВалюта 				= РабочийОбъект.ОсновнаяВалюта;
	ОтчетАБ.Валюта 			 		= ВыбраннаяВалюта;
	
	ОтчетАБ.Валюта 			 		= ВыбраннаяВалюта;		
	ОтчетАБ.ЕдиницаИзмерения 		= РабочийОбъект.ЕдиницаИзмерения;
	ОтчетАБ.ТекущееПравило          = РабочийОбъект.ПравилоОбработки;
	
	тСтрокаАналитик = "";
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		тСтрокаАналитик = тСтрокаАналитик + "Аналитика"+Инд+",";
	КонецЦикла;	

	УникальныйИдентификатор  = Новый УникальныйИдентификатор();
	
	оЛогИзмененныхДанных 			= Обработки.ЗаписьПоказателяСРасчетомЗависимых.Создать();
	ЛогИзмененныхДанных  			= оЛогИзмененныхДанных.ТаблицаИзмененныхПоказателей.Выгрузить();	
	ЛогИзмененныхДанных.Индексы.Добавить("Сценарий,ПериодОтчета,Организация,Проект,АналитикаВалюта,"+тСтрокаАналитик+"ПоказательОтчета");
	логИзмененныхКомментариев  		= оЛогИзмененныхДанных.ТаблицаИзмененныхПоказателей.Выгрузить();
	логИзмененныхДанныхАдрес 		= ПоместитьВоВременноеХранилище(ЛогИзмененныхДанных, УникальныйИдентификатор);		
	логИзмененныхКомментариевАдрес 	= ПоместитьВоВременноеХранилище(логИзмененныхКомментариев, УникальныйИдентификатор);
	
	ОтчетАБ.логИзмененныхКомментариевАдрес = логИзмененныхКомментариевАдрес;
		
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ОтчетАБ["Аналитика"+Инд] = РабочийОбъект["Аналитика"+Инд];
	КонецЦикла;		
	
	ТабличныйДокументРезультат = Новый ТабличныйДокумент;
	ТабличныйДокументРезультат.АвтоМасштаб = Истина;
	ТабличныйДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПолеТабличногоДокументаМакет", ТабличныйДокументРезультат);
	СтруктураПараметров.Вставить("ОбновитьДанные",Истина);
	СтруктураПараметров.Вставить("ДополнительныеНастройки", ОтчетАБ.СТ_ДополнительныеНастройки_Объект); 
	СтруктураПараметров.Вставить("ТекущаяТочность", ДополнительныеПараметры.ТекущаяТочность);
	СтруктураПараметров.Вставить("ТекущийДелитель", ДополнительныеПараметры.ТекущийДелитель);
	
	НомерОсновногоЯзыка = ПараметрыСеанса.ЯзыкОтчетности;
	СтруктураПараметров.Вставить("НомерОсновногоЯзыка", НомерОсновногоЯзыка);
	
	ВариантСводнойТаблицы = Справочники.ВариантыСводныхТаблиц.НайтиПоРеквизиту("Бланк", РабочийОбъект.ШаблонОтчета);
		
	//Закэшированные настройки макета
	СтруктураНастроекАналитическогоБланкаАдрес = "";
	СтруктураНастроекАналитическогоБланка  = Новый Структура;
	
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	Если  текНаборЗаписей.Количество() =1 Тогда			
		ЗначениеСохраняемойНастройки = текНаборЗаписей[0].ХранилищеДополнительныхНастроек.Получить();	
		СтруктураНастроекАналитическогоБланка.Вставить("НастройкиАналитическихБланков",ЗначениеСохраняемойНастройки);
		
		текНаборЗаписей = РегистрыСведений.КэшГруппОтборовПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("КэшГруппОтборовПоказателей",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.РасшифровкаГруппОтборов.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("РасшифровкаГруппОтборов",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.КэшИменОбластейПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("КэшИменОбластейПоказателей",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.КэшИменОбластейПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("КэшРаскрываемыхОбластей",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.НастройкиРаскрываемыхОбластей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("НастройкиРаскрываемыхОбластей",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.НастройкиТаблицРаскрываемыхОбластей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("НастройкиТаблицРаскрываемыхОбластей",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.КэшИменФормул.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("КэшИменФормул",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.КэшФормулОбластейПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("КэшФормулОбластейПоказателей",текНаборЗаписей.Выгрузить());
		
		текНаборЗаписей = РегистрыСведений.РасшифровкаФормулОбластейПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		СтруктураНастроекАналитическогоБланка.Вставить("РасшифровкаФормулОбластейПоказателей",текНаборЗаписей.Выгрузить());
		
		СтруктураНастроекАналитическогоБланкаАдрес = ПоместитьВоВременноеХранилище(СтруктураНастроекАналитическогоБланка, УникальныйИдентификатор);
		
		СтруктураПараметров.Вставить("СтруктураНастроекВарианта", ПолучитьИзВременногоХранилища(СтруктураНастроекАналитическогоБланкаАдрес));
	Иначе	
		СтруктураПараметров.Вставить("СтруктураНастроекВарианта", ""); 
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ЗаголовокСводнойТаблицы", РабочийОбъект.ШаблонОтчета);

	//Офоомление групп иерарахии по нужному шаблону
	СтруктураОформления  = Новый Структура;
	Обработки.АналитическийБланкСводнаяТаблица.УстановитьШаблонУсловногоОформления(СтруктураОформления);
	СтруктураПараметров.Вставить("СтруктураОформления",СтруктураОформления);
	
	ОтчетАБ.ПолучитьРезультирующийМакет(СтруктураПараметров);
	ОтчетАБ.НомерОсновногоЯзыка		= НомерОсновногоЯзыка;
	ОтчетАБ.ТекущийДелитель = ДополнительныеПараметры.ТекущийДелитель;
	ОтчетАБ.ТекущаяТочность = ДополнительныеПараметры.ТекущаяТочность;
	ОтчетАБ.ИдентификаторСеанса 	= УникальныйИдентификатор;
		
	ТабличныйДокументРезультат = СтруктураПараметров.ПолеТабличногоДокументаМакет;
	
	УстановитьФиксациюОбластей(ТабличныйДокументРезультат);
	ВосстановитьГруппировкиСтрок(ТабличныйДокументРезультат);
		
	Возврат ТабличныйДокументРезультат;
	
КонецФункции		//ВывестиМакетАналитическийБланкСводнаяТаблица()

Процедура УстановитьФиксациюОбластей(ПолеТабличногоДокументаМакет)
	
	ПолеТабличногоДокументаМакет.ФиксацияСлева = 1;
	Для ИндСтроки = 2 По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл	
		Если ТипЗнч(ПолеТабличногоДокументаМакет.Область(ИндСтроки,1,ИндСтроки,1).Расшифровка) = Тип("Структура") Тогда
			ПолеТабличногоДокументаМакет.ФиксацияСверху = ИндСтроки-1;
			Прервать;
		КонецЕсли;		
	КонецЦикла;	
	
КонецПроцедуры		//УстановитьФиксациюОбластей()

Процедура ВосстановитьГруппировкиСтрок(ПолеТабличногоДокументаМакет);
	
	Для Инд =1 по ПолеТабличногоДокументаМакет.КоличествоУровнейГруппировокСтрок() Цикл	
		ПолеТабличногоДокументаМакет.Область(1,0,ПолеТабличногоДокументаМакет.ВысотаТаблицы,0).Разгруппировать();
	КонецЦикла;

	ТЗГрупп = Новый ТаблицаЗначений;
	ТЗГрупп.Колонки.Добавить("ИндексНачалаСтроки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
	ТЗГрупп.Колонки.Добавить("ИндексОкончанияСтроки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(3));
	ТЗГрупп.Колонки.Добавить("УровеньТекущейОбласти",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(3));
	ТЗГрупп.Колонки.Добавить("УровеньГруппировкиТекущейОбласти",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));	
	ТЗГрупп.Колонки.Добавить("ГруппаОткрыта",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());

	УровеньПоследнейСтроки = 0;
	МассивНомеровГрупп = Новый Массив;
	МассивУдаляемыхСтрок = Новый Массив;
	Сч = 0;
	
	Для  СтрокаТаблицы =ПолеТабличногоДокументаМакет.ФиксацияСверху+1  По ПолеТабличногоДокументаМакет.ВысотаТаблицы+1 Цикл 
			
		ТекущаяОбласть    =  ПолеТабличногоДокументаМакет.Область(СтрокаТаблицы,1,СтрокаТаблицы,1);
		СледующаяОбласть  =  ПолеТабличногоДокументаМакет.Область(СтрокаТаблицы+1,1,СтрокаТаблицы+1,1);
		ПредыдущаяОбласть =  ПолеТабличногоДокументаМакет.Область(СтрокаТаблицы-1,1,СтрокаТаблицы-1,1);
		
		Если  ТекущаяОбласть.Отступ<ПредыдущаяОбласть.Отступ Тогда //Закрываем все открытые группы с уровнем большим текущего  	
			ОткрытыеСтроки = ТЗГрупп.НайтиСтроки(Новый Структура("ГруппаОткрыта",Истина));
			Для Каждого оСтр Из ОткрытыеСтроки Цикл
				Если  оСтр.УровеньГруппировкиТекущейОбласти > ТекущаяОбласть.Отступ Тогда
					оСтр.ГруппаОткрыта = Ложь;
					ПолеТабличногоДокументаМакет.Область(оСтр.ИндексНачалаСтроки,0,СтрокаТаблицы-1,0).Сгруппировать();
					Если Лев(ПолеТабличногоДокументаМакет.Область(оСтр.ИндексНачалаСтроки,0,СтрокаТаблицы-1,0).Имя,7)<>"Удалить" Тогда 
						ПолеТабличногоДокументаМакет.Область(оСтр.ИндексНачалаСтроки,0,СтрокаТаблицы-1,0).Имя = "ОбластьСтроки_"+Строка(Новый УникальныйИдентификатор);
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	 	
		КонецЕсли;	
		
		Если СледующаяОбласть.Отступ > ТекущаяОбласть.Отступ Тогда //Открываем группу
			
			МассивНомеровГрупп.Добавить(СтрокаТаблицы);
					
			Нгруппа = ТЗГрупп.Добавить();
			Нгруппа.УровеньТекущейОбласти = ПолеТабличногоДокументаМакет.Область(СтрокаТаблицы,1,СтрокаТаблицы,1).Отступ;
			Нгруппа.ИндексНачалаСтроки = СтрокаТаблицы+1;
			Нгруппа.ИндексОкончанияСтроки = СтрокаТаблицы;
			Нгруппа.УровеньГруппировкиТекущейОбласти = (ПолеТабличногоДокументаМакет.Область(СтрокаТаблицы,1,СтрокаТаблицы,1).Отступ)+2;
			Нгруппа.ГруппаОткрыта = Истина;	
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры		//ВосстановитьГруппировкиСтрок()

Функция СформироватьБланки(КлючевыеПараметры, МассивСтраниц, ДанныеДиаграмм = Ложь, КэшБланков)

	СписокТабличныхДокументов = Новый СписокЗначений;
	
	Если Не ЗначениеЗаполнено(КлючевыеПараметры.Сценарий) Тогда
		Возврат СписокТабличныхДокументов;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(КлючевыеПараметры.ПериодОтчета) Тогда
		Возврат СписокТабличныхДокументов;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(КлючевыеПараметры.ПериодОкончания) Тогда
		Возврат СписокТабличныхДокументов;
	КонецЕсли;	

	Если Не ЗначениеЗаполнено(КлючевыеПараметры.Валюта) Тогда
		Возврат СписокТабличныхДокументов;
	КонецЕсли;
	
	Если КлючевыеПараметры.ИспользоватьБыстрыйОтборПоОрганизации И Не ЗначениеЗаполнено(КлючевыеПараметры.Организация) Тогда
		Возврат СписокТабличныхДокументов;
	КонецЕсли;

	Если КлючевыеПараметры.Свойство("тОрганизации") Тогда
		КлючевыеПараметры.тОрганизации.Очистить();
		Если  КлючевыеПараметры.ИспользоватьБыстрыйОтборПоОрганизации Тогда
			КлючевыеПараметры.тОрганизации.Добавить(КлючевыеПараметры.Организация);
		КонецЕсли;  
	КонецЕсли;
					
	//Выводим бланки
	ИндексБланка = 0;
	Для Каждого Страница Из МассивСтраниц Цикл		
		
		СтрБланк  = КэшБланков.НайтиСтроки(Новый Структура("ИмяСтраницы",Страница))[0];
				
		Если СтрБланк.ИмяОбъекта = "ОбъектАналитическогоБланка" тогда 
			ОтчетАБ 					= Обработки.АналитическийБланк.Создать();
		ИначеЕсли СтрБланк.ИмяОбъекта = "ОбъектСводнаяТаблица" тогда
			//ОтчетАБ 					= Обработки.АналитическийБланкСводнаяТаблица.Создать();
			Продолжить;
		КонецЕсли;
	
		ОтчетАБ.Бланк 			 		= СтрБланк.Бланк;
		ОтчетАБ.Сценарий				= КлючевыеПараметры.Сценарий;
		ОтчетАБ.ПериодОтчета			= КлючевыеПараметры.ПериодОтчета;
		ОтчетАБ.ПериодОтчетаОкончание 	= КлючевыеПараметры.ПериодОкончания;
		ОтчетАБ.Организация 			= КлючевыеПараметры.Организация;
		ОтчетАБ.Проект 			 		= КлючевыеПараметры.Проект;
		ОтчетАБ.Валюта 			 		= КлючевыеПараметры.Валюта;		
		ОтчетАБ.ИдентификаторСеанса     = КлючевыеПараметры.ИдентификаторСеанса;
		
		Если КлючевыеПараметры.Свойство("ЕдиницаИзмерения") Тогда
			ОтчетАБ.ЕдиницаИзмерения 		= КлючевыеПараметры.ЕдиницаИзмерения;
		КонецЕсли;	
		Если КлючевыеПараметры.Свойство("ПравилоОбработки") Тогда
			ОтчетАБ.ТекущееПравило 			= КлючевыеПараметры.ПравилоОбработки;
		КонецЕсли;	
				
		Если КлючевыеПараметры.Свойство("ИспользоватьБыстрыйОтборПоАналитикамВерсии") Тогда
			ОтчетАБ.ИспользоватьБыстрыйОтборПоАналитикамВерсии = Истина;
			Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
				Если КлючевыеПараметры.Свойство("Аналитика"+Инд) Тогда
					ОтчетАБ["Аналитика"+Инд] = КлючевыеПараметры["Аналитика"+Инд];
				КонецЕсли;	
			КонецЦикла;		
		КонецЕсли;
		
		ТабличныйДокументРезультат = Новый ТабличныйДокумент;
		ТабличныйДокументРезультат.АвтоМасштаб = Истина;
		ТабличныйДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		
		СтруктураПараметров     = Новый Структура;
		СтруктураПараметров.Вставить("ПолеТабличногоДокументаМакет", ТабличныйДокументРезультат);
		СтруктураПараметров.Вставить("ОбновитьДанные",Истина);
		СтруктураПараметров.Вставить("ДополнительныеНастройки",ОтчетАБ.СТ_ДополнительныеНастройки_Объект); 
		СтруктураПараметров.Вставить("ТекущаяТочность",КлючевыеПараметры.УровеньТочности);
		СтруктураПараметров.Вставить("ТекущийДелитель",КлючевыеПараметры.ТекущийДелитель);
		СтруктураПараметров.Вставить("НомерОсновногоЯзыка",КлючевыеПараметры.НомерОсновногоЯзыка);
		
		ДополнительныеПараметры = Неопределено;
		Если ЗначениеЗаполнено(КлючевыеПараметры.ДополнительныеПараметрыАдрес) Тогда
			ДополнительныеПараметры  = ПолучитьИзВременногоХранилища(КлючевыеПараметры.ДополнительныеПараметрыАдрес);
		КонецЕсли;
		
		Если Не ДополнительныеПараметры = Неопределено И ДополнительныеПараметры.Свойство("СписокВерсий") Тогда
			СтруктураПараметров.Вставить("СписокВерсий",ДополнительныеПараметры.СписокВерсий);
		КонецЕсли;	
		
		Если Не ДополнительныеПараметры = Неопределено И ДополнительныеПараметры.Свойство("ПараметрыБазовойВерсии") Тогда
			СтруктураПараметров.Вставить("ПараметрыБазовойВерсии",ДополнительныеПараметры.ПараметрыБазовойВерсии);
		КонецЕсли;	
		
		Если КлючевыеПараметры.Свойство("логИзмененныхДанныхАдрес") Тогда
			ОтчетАБ.логИзмененныхДанныхАдрес 		= КлючевыеПараметры.логИзмененныхДанныхАдрес;
		КонецЕсли;
		Если КлючевыеПараметры.Свойство("логИзмененныхКомментариевАдрес") Тогда
			ОтчетАБ.логИзмененныхКомментариевАдрес 		= КлючевыеПараметры.логИзмененныхКомментариевАдрес;
		КонецЕсли;
        Если КлючевыеПараметры.Свойство("УникальныйИдентификатор")  Тогда
			ОтчетАБ.ИдентификаторСеанса 		= КлючевыеПараметры.УникальныйИдентификатор;
		КонецЕсли;
        Если КлючевыеПараметры.Свойство("ТекущееПравило") Тогда
			ОтчетАБ.ТекущееПравило 		= КлючевыеПараметры.ТекущееПравило;
		КонецЕсли;

		ОтчетАБ.ПолучитьРезультирующийМакет(СтруктураПараметров);
		ОтчетАБ.НомерОсновногоЯзыка		= КлючевыеПараметры.НомерОсновногоЯзыка;
		ОтчетАБ.ТекущийДелитель 		= КлючевыеПараметры.ТекущийДелитель;
		ОтчетАБ.ТекущаяТочность 		= КлючевыеПараметры.УровеньТочности;
				
		ИндексБланка = ИндексБланка +1;			
		
		тБланкКэш 			= КэшБланков.НайтиСтроки(Новый Структура("Бланк",СтрБланк.Бланк))[0];
		тБланкКэш.Выведен   = Истина;
		тБланкКэш.Обновлен  = Истина;
		
		УдалитьПустыеКолонки(СтруктураПараметров.ПолеТабличногоДокументаМакет);
		СписокТабличныхДокументов.Добавить(СтруктураПараметров.ПолеТабличногоДокументаМакет, Строка(СтрБланк.Бланк));
		
	КонецЦикла;

	Возврат СписокТабличныхДокументов;
	
КонецФункции		//СформироватьБланки()

#КонецОбласти

#Область ОбщиеКоманды

