Процедура ОбновитьНастройкуИндивидуальныхВложений(ИсточникОбъект)
	
	ИсточникСсылка = ИсточникОбъект.Ссылка;
	
	//Зарегистрировать все новые вложения 
	ЗапросПоВложеннымФайлам = Новый Запрос("ВЫБРАТЬ
	|	ТелеграмВложенныеФайлы.ИмяФайла КАК ИмяФайла,
	|	ТелеграмВложенныеФайлы.Использование КАК Использование
	|ИЗ
	|	РегистрСведений.ТелеграмВложенныеФайлы КАК ТелеграмВложенныеФайлы
	|ГДЕ
	|	ТелеграмВложенныеФайлы.ВладелецФайла = &ВладелецФайла");
	
	ЗапросПоВложеннымФайлам.УстановитьПараметр("ВладелецФайла", ИсточникСсылка);
	
	ТаблицаЗарегистрированныхВложений = ЗапросПоВложеннымФайлам.Выполнить().Выгрузить();
	ТаблицаВложений = ПолучитьТаблицуВложенныхФайлов(ИсточникСсылка, Ложь);
	
	Для Каждого Вложение Из ТаблицаВложений Цикл
		
		ИмяФайла = Вложение.ИмяФайла;
		
		Если ТаблицаЗарегистрированныхВложений.Найти(ИмяФайла, "ИмяФайла") = Неопределено тогда
			Попытка
				Запись = РегистрыСведений.ТелеграмВложенныеФайлы.СоздатьМенеджерЗаписи();
				Запись.ВладелецФайла = ИсточникСсылка;
				Запись.ИмяФайла = ИмяФайла;
				Запись.Использование = Ложь;
				Запись.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Вложение Из ТаблицаЗарегистрированныхВложений Цикл
		
		ИмяФайла = Вложение.ИмяФайла;
		
		Если ТаблицаВложений.Найти(ИмяФайла, "ИмяФайла") = Неопределено тогда
			Попытка
				Запись = РегистрыСведений.ТелеграмВложенныеФайлы.СоздатьМенеджерЗаписи();
				Запись.ВладелецФайла = ИсточникСсылка;
				Запись.ИмяФайла = ИмяФайла;
								
				Запись.Удалить();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры		//ОбновитьНастройкуИндивидуальныхВложений()

Процедура ПослеЗаписиНаСервереТип(ИсточникОбъект) Экспорт
	
	ОбновитьНастройкуСтандартныхВложений(ИсточникОбъект);
	
КонецПроцедуры		//ПослеЗаписиНаСервереТип()

Процедура ОбновитьНастройкуСтандартныхВложений(ИсточникОбъект)
	
	ИсточникСсылка = ИсточникОбъект.Ссылка;
	
	ЗапросПоВложеннымФормам = Новый Запрос("ВЫБРАТЬ
	|	ТелеграмСтандартныеПечатныеФормы.ИдентификаторКоманды КАК ИдентификаторКоманды
	|ИЗ
	|	РегистрСведений.ТелеграмСтандартныеПечатныеФормы КАК ТелеграмСтандартныеПечатныеФормы
	|ГДЕ
	|	ТелеграмСтандартныеПечатныеФормы.ТипОбъекта = &Источник");
	
	ЗапросПоВложеннымФормам.УстановитьПараметр("Источник", ИсточникСсылка);
	ТаблицаЗарегистрированныхВложений = ЗапросПоВложеннымФормам.Выполнить().Выгрузить();
		
	ОбъектМетаданныхДокумент = Метаданные.Документы.Найти(ИсточникСсылка.ИмяОбъектаМетаданных);
	ОбъектМетаданныхСправочник = Метаданные.Справочники.Найти(ИсточникСсылка.ИмяОбъектаМетаданных);
	
	Если ОбъектМетаданныхДокумент <> Неопределено Тогда
		ОбъектМетаданных = ОбъектМетаданныхДокумент;
	ИначеЕсли ОбъектМетаданныхСправочник <> Неопределено Тогда
		ОбъектМетаданных = ОбъектМетаданныхСправочник;
	Иначе
		Возврат;
	КонецЕсли;
	
	Попытка
		КомандыПечати = УправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
	Исключение
		Возврат;
	КонецПопытки;
	
	Для Каждого КомандаПечати Из КомандыПечати Цикл
				
		Если КомандаПечати.СписокФорм <> "" Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторКоманды = КомандаПечати.УникальныйИдентификатор;
		ИмяПечатнойФормы = КомандаПечати.Представление;
		
		Если ТаблицаЗарегистрированныхВложений.Найти(ИдентификаторКоманды, "ИдентификаторКоманды") = Неопределено тогда
			Попытка
				Запись = РегистрыСведений.ТелеграмСтандартныеПечатныеФормы.СоздатьМенеджерЗаписи();
				Запись.ТипОбъекта = ИсточникСсылка;
				Запись.ИдентификаторКоманды = ИдентификаторКоманды;
				Запись.ИмяПечатнойФормы = ИмяПечатнойФормы;
				Запись.Использование = Истина;
				
				Запись.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры		//ОбновитьНастройкуСтандартныхВложений()

Функция ПолучитьСписокПечатныхФормДляВложенияВТелеграмСсылка(Источник) Экспорт
	
	Результат = Новый СписокЗначений;
	
	ТипОбъектаСсылка = ПолучитьСсылкуТипа(Источник);
	Если НЕ ЗначениеЗаполнено(ТипОбъектаСсылка) тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗапросВложений = Новый Запрос("ВЫБРАТЬ
	|	ТелеграмИндивидуальныеПечатныеФормы.ИдентификаторКоманды КАК ИдентификаторКоманды,
	|	ТелеграмИндивидуальныеПечатныеФормы.Использование КАК Использование,
	|	ТелеграмИндивидуальныеПечатныеФормы.ИмяПечатнойФормы КАК ИмяПечатнойФормы
	|ПОМЕСТИТЬ ВТИндивидуальныеПечатныеФормы
	|ИЗ
	|	РегистрСведений.ТелеграмИндивидуальныеПечатныеФормы КАК ТелеграмИндивидуальныеПечатныеФормы
	|ГДЕ
	|	ТелеграмИндивидуальныеПечатныеФормы.ВладелецФайла = &Источник
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторКоманды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТелеграмСтандартныеПечатныеФормы.ИдентификаторКоманды КАК ИдентификаторКоманды,
	|	ТелеграмСтандартныеПечатныеФормы.Использование КАК Использование,
	|	ТелеграмСтандартныеПечатныеФормы.ИмяПечатнойФормы КАК ИмяПечатнойФормы
	|ПОМЕСТИТЬ ВТСтандартныеПечатныеФормы
	|ИЗ
	|	РегистрСведений.ТелеграмСтандартныеПечатныеФормы КАК ТелеграмСтандартныеПечатныеФормы
	|ГДЕ
	|	ТелеграмСтандартныеПечатныеФормы.ТипОбъекта = &ТипОбъектаСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторКоманды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ИндивидуальныеПечатныеФормы.ИдентификаторКоманды, СтандартныеПечатныеФормы.ИдентификаторКоманды) КАК ИдентификаторКоманды,
	|	ЕСТЬNULL(ИндивидуальныеПечатныеФормы.Использование, СтандартныеПечатныеФормы.Использование) КАК Использование,
	|	ЕСТЬNULL(ИндивидуальныеПечатныеФормы.ИмяПечатнойФормы, СтандартныеПечатныеФормы.ИмяПечатнойФормы) КАК Представление,
	|	ВЫБОР
	|		КОГДА СтандартныеПечатныеФормы.ИдентификаторКоманды ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	ВТИндивидуальныеПечатныеФормы КАК ИндивидуальныеПечатныеФормы
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТСтандартныеПечатныеФормы КАК СтандартныеПечатныеФормы
	|		ПО ИндивидуальныеПечатныеФормы.ИдентификаторКоманды = СтандартныеПечатныеФормы.ИдентификаторКоманды
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТелеграмВложенныеФайлы.ИмяФайла,
	|	ТелеграмВложенныеФайлы.Использование,
	|	ТелеграмВложенныеФайлы.ИмяФайла,
	|	2
	|ИЗ
	|	РегистрСведений.ТелеграмВложенныеФайлы КАК ТелеграмВложенныеФайлы
	|ГДЕ
	|	ТелеграмВложенныеФайлы.ВладелецФайла = &Источник
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Представление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТИндивидуальныеПечатныеФормы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСтандартныеПечатныеФормы");
	
	ОбновитьНастройкуСтандартныхВложений(ТипОбъектаСсылка);
	ОбновитьНастройкуИндивидуальныхВложений(Источник);
		
	ЗапросВложений.УстановитьПараметр("Источник", Источник);
	ЗапросВложений.УстановитьПараметр("ТипОбъектаСсылка", ТипОбъектаСсылка);
		
	Выборка = ЗапросВложений.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		ЭлементСписка = Результат.Добавить(Выборка.ИдентификаторКоманды, Выборка.Представление, Выборка.Использование);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции		//ПолучитьСписокПечатныхФормДляВложенияВТелеграмСсылка()

Функция ПолучитьСписокПечатныхФормДляВложенияВТелеграмТип(ТипОбъектаСсылка, ОбновлятьНастройкуВложений = Истина) Экспорт
	
	Результат = Новый СписокЗначений;
	
	ЗапросВложений = Новый Запрос("ВЫБРАТЬ
	|	ТелеграмСтандартныеПечатныеФормы.ИдентификаторКоманды КАК ИдентификаторКоманды,
	|	ТелеграмСтандартныеПечатныеФормы.Использование КАК Использование,
	|	ТелеграмСтандартныеПечатныеФормы.ИмяПечатнойФормы КАК Представление
	|ИЗ
	|	РегистрСведений.ТелеграмСтандартныеПечатныеФормы КАК ТелеграмСтандартныеПечатныеФормы
	|ГДЕ
	|	ТелеграмСтандартныеПечатныеФормы.ТипОбъекта = &ТипОбъектаСсылка");
	
	Если ОбновлятьНастройкуВложений тогда
		ОбновитьНастройкуСтандартныхВложений(ТипОбъектаСсылка);
	КонецЕсли;
	
	ЗапросВложений.УстановитьПараметр("ТипОбъектаСсылка", ТипОбъектаСсылка);
	
	Выборка = ЗапросВложений.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		ЭлементСписка = Результат.Добавить(Выборка.ИдентификаторКоманды, Выборка.Представление, Выборка.Использование);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции		//ПолучитьСписокПечатныхФормДляВложенияВТелеграмТип()

Процедура ОбработатьСписокВыбораВложенийСсылка(Список, Источник) Экспорт
	
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ТипОбъектаСсылка = ПолучитьСсылкуТипа(Источник);
	
	Если НЕ ЗначениеЗаполнено(ТипОбъектаСсылка) тогда
		Возврат;
	КонецЕсли;
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипЗнч(ТипОбъектаСсылка));
	
	ТаблицаВыбранныхЗначений = Новый ТаблицаЗначений;
	ТаблицаВыбранныхЗначений.Колонки.Добавить("ТипОбъекта", Новый ОписаниеТипов(МассивТипов));
	ТаблицаВыбранныхЗначений.Колонки.Добавить("ИдентификаторКоманды", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТаблицаВыбранныхЗначений.Колонки.Добавить("Использование", Новый ОписаниеТипов("Булево"));
	ТаблицаВыбранныхЗначений.Колонки.Добавить("ИмяПечатнойФормы", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(255)));
	
	Для Каждого ЭлементСписка Из Список Цикл
		СтрокаВыбраныхЗначений = ТаблицаВыбранныхЗначений.Добавить();
		СтрокаВыбраныхЗначений.ТипОбъекта = ТипОбъектаСсылка;
		СтрокаВыбраныхЗначений.ИдентификаторКоманды = ЭлементСписка.Значение;
		СтрокаВыбраныхЗначений.Использование = ЭлементСписка.Пометка;
		СтрокаВыбраныхЗначений.ИмяПечатнойФормы = ЭлементСписка.Представление;
	КонецЦикла;
	
	ЗапросПоСтандартнымНастройкам = Новый Запрос("ВЫБРАТЬ
	|	ВыбранныеЗначения.ТипОбъекта КАК ТипОбъекта,
	|	ВыбранныеЗначения.ИдентификаторКоманды КАК ИдентификаторКоманды,
	|	ВыбранныеЗначения.Использование КАК Использование,
	|	ВыбранныеЗначения.ИмяПечатнойФормы КАК ИмяПечатнойФормы
	|ПОМЕСТИТЬ ВТВыбранныеЗначения
	|ИЗ
	|	&ВыбранныеЗначения КАК ВыбранныеЗначения
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТипОбъекта,
	|	ИдентификаторКоманды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыбранныеЗначения.ТипОбъекта КАК ТипОбъекта,
	|	ВыбранныеЗначения.ИдентификаторКоманды КАК ИдентификаторКоманды,
	|	ВыбранныеЗначения.Использование КАК Использование,
	|	ЕСТЬNULL(ТелеграмСтандартныеПечатныеФормы.Использование, НЕОПРЕДЕЛЕНО) КАК ИспользованиеПоУмолчанию,
	|	ВыбранныеЗначения.ИмяПечатнойФормы КАК ИмяПечатнойФормы
	|ИЗ
	|	ВТВыбранныеЗначения КАК ВыбранныеЗначения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТелеграмСтандартныеПечатныеФормы КАК ТелеграмСтандартныеПечатныеФормы
	|		ПО (ТелеграмСтандартныеПечатныеФормы.ТипОбъекта = ВыбранныеЗначения.ТипОбъекта)
	|			И (ТелеграмСтандартныеПечатныеФормы.ИдентификаторКоманды = ВыбранныеЗначения.ИдентификаторКоманды)
	|			И (ТелеграмСтандартныеПечатныеФормы.Использование = ВыбранныеЗначения.Использование)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТВыбранныеЗначения");
	
	ЗапросПоСтандартнымНастройкам.УстановитьПараметр("ВыбранныеЗначения", ТаблицаВыбранныхЗначений);
	ЗапросПоСтандартнымНастройкам.УстановитьПараметр("ТипОбъекта", ТипОбъектаСсылка);
	
	ВыборкаНастроек = ЗапросПоСтандартнымНастройкам.Выполнить().Выбрать();
		
	Пока ВыборкаНастроек.Следующий() Цикл
				
		Если ВыборкаНастроек.Использование = ВыборкаНастроек.ИспользованиеПоУмолчанию Тогда
			Запись = РегистрыСведений.ТелеграмИндивидуальныеПечатныеФормы.СоздатьМенеджерЗаписи();
			Запись.ВладелецФайла = Источник;
			Запись.ИдентификаторКоманды = ВыборкаНастроек.ИдентификаторКоманды;				
			Запись.Удалить();
			
			Продолжить;
		КонецЕсли;
				
		ПозицияТочки = СтрНайти(ВыборкаНастроек.ИмяПечатнойФормы, ".");
		
		Если ПозицияТочки > 0 И (ПозицияТочки = СтрДлина(ВыборкаНастроек.ИмяПечатнойФормы) - 3 
			ИЛИ ПозицияТочки = СтрДлина(ВыборкаНастроек.ИмяПечатнойФормы) - 4) тогда
			
			Запись = РегистрыСведений.ТелеграмВложенныеФайлы.СоздатьМенеджерЗаписи();
			Запись.ВладелецФайла = Источник;
			Запись.ИмяФайла = ВыборкаНастроек.ИмяПечатнойФормы;
			Запись.Использование = ВыборкаНастроек.Использование;
			
			Запись.Записать();
		Иначе
			Запись = РегистрыСведений.ТелеграмИндивидуальныеПечатныеФормы.СоздатьМенеджерЗаписи();
			Запись.ВладелецФайла = Источник;
			Запись.ИдентификаторКоманды = ВыборкаНастроек.ИдентификаторКоманды;
			Запись.ИмяПечатнойФормы = ВыборкаНастроек.ИмяПечатнойФормы;
			Запись.Использование = ВыборкаНастроек.Использование;
				
			Запись.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры		//ОбработатьСписокВыбораВложенийСсылка()

Процедура ОбработатьСписокВыбораВложенийТип(Список, ТипОбъектаСсылка) Экспорт
	
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого ЭлементСписка Из Список Цикл
		Запись = РегистрыСведений.ТелеграмСтандартныеПечатныеФормы.СоздатьМенеджерЗаписи();
		Запись.ТипОбъекта = ТипОбъектаСсылка;
		Запись.ИдентификаторКоманды = ЭлементСписка.Значение;
		Запись.ИмяПечатнойФормы = ЭлементСписка.Представление;
		Запись.Использование = ЭлементСписка.Пометка;
		
		Запись.Записать();
	КонецЦикла;
	
КонецПроцедуры		//ОбработатьСписокВыбораВложенийТип()

Функция ПолучитьПользователяБотаЗадачИОповещений() Экспорт
	
	ИмяПользователя = ПользователиУХ.ПолучитьПредставлениеБотаЗадачИОповещений();
		
	ПользовательБотИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательБотИБ = Неопределено Тогда
		
		ПользовательБотИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		ПользовательБотИБ.Имя = ИмяПользователя;
		ПользовательБотИБ.ПолноеИмя = ИмяПользователя;
		ПользовательБотИБ.Пароль = Строка(Новый УникальныйИдентификатор);
		ПользовательБотИБ.ЗапрещеноИзменятьПароль = Истина;
		ПользовательБотИБ.ПоказыватьВСпискеВыбора = Ложь;
		ПользовательБотИБ.Язык = ЯзыкПоКоду(ОбщегоНазначения.КодОсновногоЯзыка());
		ПользовательБотИБ.Роли.Добавить(Метаданные.Роли.АдминистраторСистемы);
		ПользовательБотИБ.Роли.Добавить(Метаданные.Роли.ПолныеПрава);
		
		Попытка
			ПользовательБотИБ.Записать();
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя информационной базы для системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	// Обновление пользователя - элемента справочника Пользователи.
	ОписаниеПользователяИБ = Новый Структура;
	ОписаниеПользователяИБ.Вставить("Действие", "Записать");
	ОписаниеПользователяИБ.Вставить("Имя", ПользовательБотИБ.Имя);
	ОписаниеПользователяИБ.Вставить("АутентификацияСтандартная", Истина);
	ОписаниеПользователяИБ.Вставить("ПоказыватьВСпискеВыбора", ПользовательБотИБ.ПоказыватьВСпискеВыбора);
	ОписаниеПользователяИБ.Вставить("УникальныйИдентификатор", ПользовательБотИБ.УникальныйИдентификатор);
		
	Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ", ПользовательБотИБ.УникальныйИдентификатор);
	Если Пользователь.Пустая() Тогда
		
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.Пользователи.ПолноеИмя());
						
			Блокировка.Заблокировать();
			
			ПользовательБот = Справочники.Пользователи.СоздатьЭлемент();
				
			ПользовательБот.Наименование = ПользовательБотИБ.Имя;
			ПользовательБот.Служебный = Истина;
			ПользовательБот.ОповещатьЧерезСистемуВзаимодействия = Истина;
			ПользовательБот.ОповещатьЧерезТелеграм = Истина;
			ПользовательБот.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);
			ПользовательБот.Записать();
			
			ЗафиксироватьТранзакцию();
			Пользователь = ПользовательБот.Ссылка;
		Исключение
			ОтменитьТранзакцию();
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Если НЕ Пользователь.ОповещатьЧерезТелеграм Тогда
		
		ПользовательОбъект = Пользователь.ПолучитьОбъект();
		ПользовательОбъект.ОповещатьЧерезСистемуВзаимодействия = Истина;
		ПользовательОбъект.ОповещатьЧерезТелеграм = Истина;
		
		Попытка
			ПользовательОбъект.Записать();
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	ГруппаДоступа = Справочники.ГруппыДоступа.Администраторы;	
	Если ГруппаДоступа.Пользователи.Найти(Пользователь, "Пользователь") = Неопределено Тогда
		
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.ГруппыДоступа");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ГруппаДоступа);
			Блокировка.Заблокировать();
			
			ГруппаДоступаОбъект = ГруппаДоступа.ПолучитьОбъект();
			ЗаблокироватьДанныеДляРедактирования(ГруппаДоступаОбъект.Ссылка, ГруппаДоступаОбъект.ВерсияДанных);
			
			ГруппаДоступаОбъект.Пользователи.Добавить().Пользователь = Пользователь;
						
			ГруппаДоступаОбъект.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			РазблокироватьДанныеДляРедактирования(ГруппаДоступаОбъект.Ссылка);
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
		
		РазблокироватьДанныеДляРедактирования(ГруппаДоступаОбъект.Ссылка);
		
	КонецЕсли;
		
	РЗТелеграмПолучениеДанных = РегламентныеЗадания.НайтиПредопределенное("ТелеграмПолучениеДанных");
	Если РЗТелеграмПолучениеДанных.ИмяПользователя <> ИмяПользователя Тогда
		РЗТелеграмПолучениеДанных.ИмяПользователя = ИмяПользователя;
		
		Попытка
			РЗТелеграмПолучениеДанных.Записать();
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
		
	Возврат Пользователь;
	
КонецФункции		//ПолучитьПользователяБотаЗадачИОповещений()

Функция ЯзыкПоКоду(Знач КодЯзыка)
	
	Для каждого Язык Из Метаданные.Языки Цикл
		Если Язык.КодЯзыка = КодЯзыка Тогда
			Возврат Язык;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции		//ЯзыкПоКоду()

#КонецОбласти
