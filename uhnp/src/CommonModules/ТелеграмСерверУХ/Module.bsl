
#Область Настройки

Процедура ПодключениеТелеграмДляОповещений(ТекущийПользователь = Неопределено) Экспорт
	
	Если ТекущийПользователь = Неопределено Тогда
		ТекущийПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ТекущийПользователь) = Тип("СправочникСсылка.ВнешниеПользователи") И ТекущийПользователь.ОповещатьЧерезТелеграм Тогда		
		ПолучитьПользователяБотаЗадачИОповещений();
	КонецЕсли;
	
	ПолучитьНастройкиTelegram();
	
КонецПроцедуры		//ПодключениеТелеграмДляОповещений()

Функция ПолучитьИдентификаторРегламентногоЗаданияОтправка() Экспорт
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь(, Истина) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав доступа.
		                             |
		                             |Работа с регламентными и фоновыми заданиями
		                             |выполняется только администраторами.'");
	КонецЕсли;
	
	Возврат РегламентныеЗадания.НайтиПредопределенное("ОтправкаОповещенийСобытий").УникальныйИдентификатор;
	
КонецФункции		//ПолучитьИдентификаторРегламентногоЗаданияОтправка()

Функция ПолучитьИдентификаторРегламентногоЗаданияПолучение() Экспорт
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь(, Истина) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав доступа.
		                             |
		                             |Работа с регламентными и фоновыми заданиями
		                             |выполняется только администраторами.'");
	КонецЕсли;
	
	Возврат РегламентныеЗадания.НайтиПредопределенное("ТелеграмПолучениеДанных").УникальныйИдентификатор;
	
КонецФункции		//ПолучитьИдентификаторРегламентногоЗаданияПолучение()

Функция ПолучитьТелеграмБотаПоУмолчанию() Экспорт
		
	Возврат Справочники.ТелеграмБоты.БотЗадачИОповещений;
	
КонецФункции		//ПолучитьТелеграмБотаПоУмолчанию()

Функция ПолучитьТокенТелеграмБота() Экспорт
		
	Возврат Справочники.ТелеграмБоты.БотЗадачИОповещений.Token;
	
КонецФункции		//ПолучитьТокенТелеграмБота()

Функция ПолучитьТелеграмАПИПоУмолчанию() Экспорт
	
	Возврат "api.telegram.org";
	
КонецФункции		//ПолучитьТелеграмАПИПоУмолчанию()

Функция ПолучитьНастройкиПользователя(Пользователь) Экспорт
	
	СтруктураНастроек = Новый Структура("ТелеграмБот, ТелеграмИмя, ТелеграмФамилия, УИДПользователя, Телефон, Использование, Администратор");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТелеграмПользователи.ТелеграмБот КАК ТелеграмБот,
	               |	ТелеграмПользователи.ТелеграмИмя КАК ТелеграмИмя,
	               |	ТелеграмПользователи.ТелеграмФамилия КАК ТелеграмФамилия,
	               |	ТелеграмПользователи.УИДПользователя КАК УИДПользователя,
	               |	ТелеграмПользователи.Телефон КАК Телефон,
	               |	ТелеграмПользователи.Администратор КАК Администратор
	               |ИЗ
	               |	РегистрСведений.ТелеграмПользователи КАК ТелеграмПользователи
	               |ГДЕ
	               |	ТелеграмПользователи.Пользователь = &Пользователь
	               |	И ТелеграмПользователи.ТелеграмБот = &ТелеграмБот";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("ТелеграмБот", ПолучитьТелеграмБотаПоУмолчанию());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка);
		Возврат СтруктураНастроек;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции		//ПолучитьНастройкиПользователя()

Функция ПолучитьНастройкиTelegram(ТелеграмБот = Неопределено) Экспорт
	
	ТелеграмБот = ?(ТелеграмБот = Неопределено, ПолучитьТелеграмБотаПоУмолчанию(), ТелеграмБот);
		
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ТелеграмБот","");
	СтруктураНастроек.Вставить("api","");
	СтруктураНастроек.Вставить("token","");
	СтруктураНастроек.Вставить("AdminChatId", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТелеграмНастройки.ТелеграмБот КАК ТелеграмБот,
	               |	ТелеграмНастройки.Api КАК api,
	               |	ТелеграмНастройки.Token КАК token,
	               |	ТелеграмНастройки.AdminChatId КАК AdminChatId
	               |ИЗ
	               |	РегистрСведений.ТелеграмНастройки КАК ТелеграмНастройки
	               |ГДЕ
	               |	ТелеграмНастройки.ТелеграмБот = &ТелеграмБот";
	
	Запрос.УстановитьПараметр("ТелеграмБот", ТелеграмБот);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаЗапроса.Следующий() Тогда
		
		Если СокрЛП(ВыборкаЗапроса.api) = "" тогда
			ЗаписьНастроек = РегистрыСведений.ТелеграмНастройки.СоздатьМенеджерЗаписи();
			ЗаписьНастроек.ТелеграмБот = ТелеграмБот;
			ЗаписьНастроек.Прочитать();
			
			Если ЗаписьНастроек.Выбран() Тогда
				ЗаписьНастроек.Api = ПолучитьТелеграмАПИПоУмолчанию();
				
				Попытка
					ЗаписьНастроек.Записать();
					ЗаполнитьЗначенияСвойств(СтруктураНастроек, ЗаписьНастроек);
				Исключение
					ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось установить корректные настройки для работы с Telegram: %1'"), ОписаниеОшибки());
					ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
				КонецПопытки;
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(СтруктураНастроек, ВыборкаЗапроса);
		КонецЕсли;
		
	Иначе
				
		ЗаписьНастроек = РегистрыСведений.ТелеграмНастройки.СоздатьМенеджерЗаписи();
		
		ЗаписьНастроек.ТелеграмБот = ТелеграмБот;
		ЗаписьНастроек.Api = ПолучитьТелеграмАПИПоУмолчанию();
		ЗаписьНастроек.Token = ТелеграмБот.Token;
		ЗаписьНастроек.AdminChatId = 0;
		
		Попытка
			ЗаписьНастроек.Записать();
			ЗаполнитьЗначенияСвойств(СтруктураНастроек, ЗаписьНастроек);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось установить корректные настройки для работы с Telegram: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат СтруктураНастроек;
	
КонецФункции		//ПолучитьНастройкиTelegram()

#КонецОбласти

#Область ФункцииОбменаСообщениями

Процедура СоздатьСообщение(Параметры, Отказ=Ложь) Экспорт
	
	ПользовательБот = ПолучитьПользователяБотаЗадачИОповещений();
	Если ПользовательБот = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТелеграмПользователи.УИДПользователя КАК УИДПользователя
	               |ИЗ
	               |	РегистрСведений.ТелеграмПользователи КАК ТелеграмПользователи
	               |ГДЕ
	               |	ТелеграмПользователи.Пользователь = &Пользователь
	               |	И ТелеграмПользователи.ТелеграмБот = &ТелеграмБот";
	
	Запрос.УстановитьПараметр("Пользователь", Параметры.Пользователь);
	Запрос.УстановитьПараметр("ТелеграмБот", ПолучитьТелеграмБотаПоУмолчанию());
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		ОтправитьСообщениеПользователю(ВыборкаЗапроса.УИДПользователя, Параметры, Отказ);	
	КонецЦикла;
	
КонецПроцедуры		//СоздатьСообщение()

Процедура ОтправитьСообщениеПользователю(УИДПользователя, Параметры, Отказ=Ложь)
	
	Если Не ЗначениеЗаполнено(УИДПользователя) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = ПолучитьНастройкиTelegram();
	Если Не ЗначениеЗаполнено(СтруктураНастроек.token) тогда
		ТекстСообщения = НСтр("ru = 'В настройках Telegram-бота не заполнен ""token"";'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);		
		Возврат;
	КонецЕсли;

	СписокТабличныхДокументов = Новый СписокЗначений;
	
	ПолучитьСписокПечатныхФормОбъекта(Параметры.Источник, СписокТабличныхДокументов, Истина);	
	ИсточникНастраиваемыйОтчет(Параметры.Источник, СписокТабличныхДокументов);
	
	Если ТипЗнч(Параметры.Источник) = Тип("ДокументСсылка.НастраиваемыйОтчет") тогда
		ОриентацияСтраницыДокумента = ОриентацияСтраницы.Ландшафт;
	Иначе
		ОриентацияСтраницыДокумента = ОриентацияСтраницы.Портрет;
	КонецЕсли;
	
	ТаблицаФайлов = Новый ТаблицаЗначений;
	ТаблицаФайлов.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("ДвоичныеДанные", Новый ОписаниеТипов("ДвоичныеДанные"));
	
	ШаблонОбластиЗаголовка = Документы.НастраиваемыйОтчет.ПолучитьМакет("ШаблонЗаголовковВывода").ПолучитьОбласть("ОбластьВыводаЗаголовкаНовогоОтчетаФайл");
	
	ТабличныйДокументВременный = Новый ТабличныйДокумент;
	ТабличныйДокументВременный.ОриентацияСтраницы = ОриентацияСтраницыДокумента;
	ТабличныйДокументВременный.АвтоМасштаб = Истина;
		
	Пакет = Новый ПакетОтображаемыхДокументов;
	Пакет.КоличествоЭкземпляров = 1;
	
	Для Каждого ТабличныйДокументЭлемент Из СписокТабличныхДокументов Цикл
		
		ТабличныйДокументВременный.Очистить();
		
		ТабличныйДокументОбъединенный = Новый ТабличныйДокумент;
		ТабличныйДокументОбъединенный.ОриентацияСтраницы = ОриентацияСтраницыДокумента;
		ТабличныйДокументОбъединенный.АвтоМасштаб = Истина;
		
		ШаблонОбластиЗаголовка.Параметры.БланкОтчета = ТабличныйДокументЭлемент.Представление;
		ОбластьЯчеек = ТабличныйДокументВременный.Вывести(ШаблонОбластиЗаголовка);
		ОбластьЯчеек.СоздатьФорматСтрок();
		ТабличныйДокументОбъединенный.Вывести(ТабличныйДокументВременный);
		
		ТабличныйДокументВременный.Очистить();
		
		ОбластьЯчеек = ТабличныйДокументВременный.Вывести(ТабличныйДокументЭлемент.Значение);
		ОбластьЯчеек.СоздатьФорматСтрок();
		ТабличныйДокументОбъединенный.Вывести(ТабличныйДокументВременный);
			
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
		
		ЭлементПакета = Пакет.Состав.Добавить();
		ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ТабличныйДокументОбъединенный, УникальныйИдентификатор);
		ЭлементПакета.Наименование = ТабличныйДокументЭлемент.Представление;
		
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
	Пакет.ЗаписатьФайлДляПечати(ИмяВременногоФайла);
	
	СтрокаФайлов = ТаблицаФайлов.Добавить();
	
	СтрокаФайлов.ИмяФайла = ИмяВременногоФайла;
	СтрокаФайлов.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		
	ТекстСообщения = Параметры.ТекстСообщения;
	СписокКнопок = Новый СписокЗначений;
	
	ТекстСогласовано = НСтр("ru = 'Согласовано'", ОбщегоНазначения.КодОсновногоЯзыка());
	ТекстВозвращеноИнициатору = НСтр("ru = 'Возвращено инициатору'", ОбщегоНазначения.КодОсновногоЯзыка());
	ТекстВозвращеноНаПредыдущийЭтапСогласования = НСтр("ru = 'Возвращено на предыдущий этап согласования'", ОбщегоНазначения.КодОсновногоЯзыка());
	ТекстПринятьКИсполнению = НСтр("ru = 'Принять к исполнению'", ОбщегоНазначения.КодОсновногоЯзыка());
	ТекстОтменитьПринятиеКИсполнению = НСтр("ru = 'Отменить принятие к исполнению'", ОбщегоНазначения.КодОсновногоЯзыка());
	ТекстНеУказан = НСтр("ru = '<Не указан>'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Для Каждого ЭлементДокумента Из Параметры.ФорматированныйДокумент.Элементы Цикл
				
		Для Каждого ПодчиненныйЭлемент Из ЭлементДокумента.Элементы Цикл
			
			Если ТипЗнч(ПодчиненныйЭлемент) <> Тип("ТекстФорматированногоДокумента") тогда
				Продолжить;
			КонецЕсли;			
			Если ПодчиненныйЭлемент.НавигационнаяСсылка = "" тогда
				Продолжить;
			КонецЕсли;
						
			ТекстЭлемента = ПодчиненныйЭлемент.Текст;
			НавигационнаяСсылкаЭлемента = ПодчиненныйЭлемент.НавигационнаяСсылка;
							
			Если ТекстЭлемента = ТекстСогласовано 
				ИЛИ ТекстЭлемента = ТекстВозвращеноНаПредыдущийЭтапСогласования
				ИЛИ ТекстЭлемента = ТекстВозвращеноИнициатору
				ИЛИ ТекстЭлемента = ТекстПринятьКИсполнению
				ИЛИ ТекстЭлемента = ТекстОтменитьПринятиеКИсполнению тогда
											
				Уточнение = "";
				ИндексТекущегоЭлемента = ЭлементДокумента.Элементы.Индекс(ПодчиненныйЭлемент);
				Если ИндексТекущегоЭлемента + 3 < ЭлементДокумента.Элементы.Количество() тогда
					Если ТипЗнч(ЭлементДокумента.Элементы[ИндексТекущегоЭлемента + 3]) = Тип("ТекстФорматированногоДокумента") тогда
						Если НЕ ЗначениеЗаполнено(ЭлементДокумента.Элементы[ИндексТекущегоЭлемента + 3].Текст) тогда
							Если ТекстЭлемента = ТекстСогласовано тогда	
								ТекстСообщения = СокрЛП(СтрЗаменить(ТекстСообщения, Символы.ПС + "[" + ТекстЭлемента + "]" + Символы.ПС + " " + Символы.ПС, ""));
								Продолжить;
							ИначеЕсли ТекстЭлемента = ТекстВозвращеноНаПредыдущийЭтапСогласования тогда								
								ТекстСообщения = СокрЛП(СтрЗаменить(ТекстСообщения, Символы.ПС + "[" + ТекстЭлемента + "]" + Символы.ПС + " " + Символы.ПС, ""));								
								Продолжить;
							Иначе
								Уточнение = Символы.ПС + ТекстНеУказан;
								ТекстСообщения = СокрЛП(СтрЗаменить(ТекстСообщения, "[" + ТекстЭлемента + "]", "[" + ТекстЭлемента + "]" + Уточнение));
							КонецЕсли;	
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли ИндексТекущегоЭлемента + 3 = ЭлементДокумента.Элементы.Количество() И ТекстЭлемента = ТекстВозвращеноИнициатору тогда
					Уточнение = Символы.ПС + ТекстНеУказан;
					ТекстСообщения = СокрЛП(СтрЗаменить(ТекстСообщения, "[" + ТекстЭлемента + "]", "[" + ТекстЭлемента + "]" + Уточнение));
				КонецЕсли;
												
				СписокКнопок.Добавить(ТекстЭлемента, НавигационнаяСсылкаЭлемента);			
			КонецЕсли;
						
		КонецЦикла;
				
	КонецЦикла;
			
	Строки = Новый Массив;
		
	Для каждого Кнопка ИЗ СписокКнопок Цикл
		УИДКнопки = Строка(Новый УникальныйИдентификатор());
		
		ТекстКнопки = Кнопка.Значение;
		
		Кнопки = Новый Массив;
		Кнопки.Добавить(Новый Структура("text, callback_data", ТекстКнопки, УИДКнопки));
		                                                                                            
		Строки.Добавить(Кнопки);
		
		ЗаписьНавигационныеСсылки = РегистрыСведений.ТелеграмНавигационныеСсылки.СоздатьМенеджерЗаписи();
		ЗаписьНавигационныеСсылки.УИДСообщения = Параметры.ИдентификаторОповещения;
		ЗаписьНавигационныеСсылки.УИДКнопки = УИДКнопки;
		ЗаписьНавигационныеСсылки.Дата = ТекущаяДата();
		ЗаписьНавигационныеСсылки.ТекстКнопки = ТекстКнопки;
		ЗаписьНавигационныеСсылки.НавигационнаяСсылка = Кнопка.Представление;
		ЗаписьНавигационныеСсылки.Пользователь = Параметры.Пользователь;
		ЗаписьНавигационныеСсылки.УИДПользователя = УИДПользователя;
		
