		Попытка
			HTTPСоединение = Новый HTTPСоединение(СтруктураНастроек.api,443,,,,,Новый ЗащищенноеСоединениеOpenSSL());
			HTTPЗапрос = Новый HTTPЗапрос(Приемник);
			HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
