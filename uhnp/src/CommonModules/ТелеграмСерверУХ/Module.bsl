			ОбщегоНазначенияУХ.СообщитьОбОшибке(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Отказ);
		КонецПопытки
		
	КонецЕсли;
	
КонецПроцедуры		//ОтправитьСообщениеПользователю()

Функция ПолучитьТаблицуВложенныхФайлов(ВладелецФайлов, ТолькоРазрешенные) Экспорт
	
	ИмяСправочникаХранилищаФайлов = Неопределено;
	
	Попытка
		ИмяСправочникаХранилищаФайлов = РаботаСФайламиСлужебный.ИмяСправочникаХраненияФайлов(
			ВладелецФайлов);
	Исключение
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(ИмяСправочникаХранилищаФайлов) тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка,
	|	Файлы.ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА Файлы.ПометкаУдаления = ИСТИНА
	|			ТОГДА ЕСТЬNULL(Файлы.ИндексКартинки, 2) + 1
	|		ИНАЧЕ ЕСТЬNULL(Файлы.ИндексКартинки, 2)
	|	КОНЕЦ КАК ИндексКартинки,
	|	Файлы.Наименование КАК Наименование,
	|	ВЫРАЗИТЬ(Файлы.Описание КАК СТРОКА(500)) КАК Описание,
	|	Файлы.Автор,
	|	Файлы.ДатаСоздания,
	|	Файлы.Изменил КАК Отредактировал,
	|	ДОБАВИТЬКДАТЕ(Файлы.ДатаМодификацииУниверсальная, СЕКУНДА, &СекундДоМестногоВремени) КАК ДатаИзменения,
	|	ВЫРАЗИТЬ(Файлы.Размер / 1024 КАК ЧИСЛО(10, 0)) КАК Размер,
	|	Файлы.ПодписанЭП,
	|	Файлы.Зашифрован,
	|	ВЫБОР
	|		КОГДА Файлы.ПодписанЭП
	|				И Файлы.Зашифрован
	|			ТОГДА 2
	|		КОГДА Файлы.Зашифрован
	|			ТОГДА 1
	|		КОГДА Файлы.ПодписанЭП
	|			ТОГДА 0
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК НомерКартинкиПодписанЗашифрован,
	|	ВЫБОР
	|		КОГДА НЕ Файлы.Редактирует В (&ПустыеПользователи)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ФайлРедактируется,
	|	ВЫБОР
	|		КОГДА Файлы.Редактирует = &ТекущийПользователь
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ФайлРедактируетТекущийПользователь,
	|	ВЫБОР
	|		КОГДА НЕ Файлы.Редактирует В (&ПустыеПользователи)
	|				И Файлы.Редактирует <> &ТекущийПользователь
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ФайлРедактируетДругойПользователь,
	|	Файлы.Расширение КАК Расширение,
	|	ВЫБОР
	|		КОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись <> НЕОПРЕДЕЛЕНО
	|				И Файлы.Редактирует = НЕОПРЕДЕЛЕНО
	|			ТОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись
	|		ИНАЧЕ Файлы.Редактирует
	|	КОНЕЦ КАК Редактирует,
	|	Файлы.Редактирует КАК РедактируетПользователь,
	|	Файлы.ВладелецФайла КАК ВладелецФайла,
	|	Файлы.ХранитьВерсии КАК ХранитьВерсии,
	|	Файлы.Наименование + ""."" + Файлы.Расширение КАК ИмяФайла
	|ИЗ
	|	&ИмяСправочника КАК Файлы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыСинхронизацииФайловСОблачнымСервисом КАК СтатусыСинхронизацииФайловСОблачнымСервисом
	|		ПО Файлы.Ссылка = СтатусыСинхронизацииФайловСОблачнымСервисом.Файл
	|		&СоединениеНеОтправлять
	|ГДЕ
	|	Файлы.ВладелецФайла = &ВладелецФайлов
	|	И Файлы.ПометкаУдаления = ЛОЖЬ
	|	&Служебный
	|	&ЭтоГруппа
	|	&УсловиеНеОтправлять";
		
	ПолноеИмяСправочника = "Справочник." + ИмяСправочникаХранилищаФайлов;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяСправочника", ПолноеИмяСправочника);
	
	ЕстьРеквизитСлужебный = РаботаСФайламиСлужебный.ЕстьРеквизитСлужебный(ИмяСправочникаХранилищаФайлов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Служебный", ?(ЕстьРеквизитСлужебный, "И Файлы.Служебный = ЛОЖЬ", ""));
	
	ТипСправочникаСФайлами = Тип("СправочникСсылка." + ИмяСправочникаХранилищаФайлов);
	МетаданныеСправочникаСФайлами = Метаданные.НайтиПоТипу(ТипСправочникаСФайлами);
	ВозможностьСоздаватьГруппыФайлов = МетаданныеСправочникаСФайлами.Иерархический;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоГруппа",
		?(ВозможностьСоздаватьГруппыФайлов, "И Файлы.ЭтоГруппа = ЛОЖЬ", ""));
		
	СоединениеНеОтправлять = "";
	УсловиеНеОтправлять = "";
	
	Если ТолькоРазрешенные Тогда
		СоединениеНеОтправлять = "ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТелеграмВложенныеФайлы КАК ТелеграмВложенныеФайлы
		|		ПО (Файлы.Наименование + ""."" + Файлы.Расширение = ТелеграмВложенныеФайлы.ИмяФайла)
		|			И Файлы.ВладелецФайла = ТелеграмВложенныеФайлы.ВладелецФайла";
		
		УсловиеНеОтправлять = "И ЕСТЬNULL(ТелеграмВложенныеФайлы.Использование, ЛОЖЬ) = ИСТИНА";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеНеОтправлять", СоединениеНеОтправлять);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНеОтправлять", УсловиеНеОтправлять);
	
	ЗапросВложений = Новый Запрос(ТекстЗапроса);
	ЗапросВложений.УстановитьПараметр("ВладелецФайлов", ВладелецФайлов);
	
	ПустыеПользователи = Новый Массив;
	ПустыеПользователи.Добавить(Неопределено);
	ПустыеПользователи.Добавить(Справочники.Пользователи.ПустаяСсылка());
	ПустыеПользователи.Добавить(Справочники.ВнешниеПользователи.ПустаяСсылка());
	ПустыеПользователи.Добавить(Справочники.УчетныеЗаписиСинхронизацииФайлов.ПустаяСсылка());
	
	ЗапросВложений.УстановитьПараметр("ТекущийПользователь", Пользователи.АвторизованныйПользователь());
	ЗапросВложений.УстановитьПараметр("ПустыеПользователи",  ПустыеПользователи);
	
	ДатаУниверсальная = ТекущаяДатаСеанса();
	ЗапросВложений.УстановитьПараметр("СекундДоМестногоВремени",
		МестноеВремя(ДатаУниверсальная, ЧасовойПоясСеанса()) - ДатаУниверсальная);
	
	Возврат ЗапросВложений.Выполнить().Выгрузить();
	
КонецФункции		//ПолучитьТаблицуВложенныхФайлов()

Функция ПолучитьСсылкуТипа(Источник)
	
	ТипОбъектаСсылка = Неопределено;
	МетаданныеИсточника = Источник.Метаданные();
	Если Метаданные.Документы.Найти(МетаданныеИсточника.Имя) <> Неопределено тогда
		ТипОбъектаСсылка = Справочники.ДокументыБД.НайтиПоНаименованию(МетаданныеИсточника.Имя, Истина);
	ИначеЕсли Метаданные.Справочники.Найти(МетаданныеИсточника.Имя) <> Неопределено тогда
		ТипОбъектаСсылка = Справочники.СправочникиБД.НайтиПоНаименованию(МетаданныеИсточника.Имя, Истина);
	КонецЕсли;
	
	Возврат ТипОбъектаСсылка;
	
КонецФункции		//ПолучитьСсылкуТипа()

Процедура ДополнитьСписокМенеджеровПечати(СписокМенеджеровПечати)
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.ЦентрализованныеЗакупки") Тогда
		
		СписокМенеджеровПечати.Добавить(Справочники["ЗакупочныеПроцедуры"]);
		
	КонецЕсли;
	
КонецПроцедуры		//ДополнитьСписокМенеджеровПечати()

Процедура ПолучитьСписокПечатныхФормОбъекта(ВладелецФайлов, СписокТабличныхДокументов, ТолькоРазрешенные) Экспорт
	
	ОбъектМетаданных = ВладелецФайлов.Метаданные();
	ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
	ИсточникМенеджер = Неопределено;
	
	Если НЕ Справочники.СправочникиБД.НайтиПоНаименованию(ИмяОбъектаМетаданных, Истина).Пустая() тогда		
		ИсточникМенеджер = Справочники[ИмяОбъектаМетаданных];
	ИначеЕсли НЕ Справочники.ДокументыБД.НайтиПоНаименованию(ИмяОбъектаМетаданных, Истина).Пустая() тогда		
		ИсточникМенеджер = Документы[ИмяОбъектаМетаданных];
	КонецЕсли;
	
	СписокОбъектовПечати = Новый СписокЗначений();
	УправлениеПечатьюПереопределяемый.ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектовПечати);
	ДополнитьСписокМенеджеровПечати(СписокОбъектовПечати);
			
	Если СписокОбъектовПечати.НайтиПоЗначению(ИсточникМенеджер) <> Неопределено тогда
		
		КомандыПечати = УправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
		
		Если ТолькоРазрешенные Тогда
					
			ЗапросПоВложеннымПечатнымФормам = Новый Запрос("ВЫБРАТЬ
			|	ТелеграмИндивидуальныеПечатныеФормы.ИдентификаторКоманды КАК ИдентификаторКоманды,
			|	ТелеграмИндивидуальныеПечатныеФормы.Использование КАК Использование
			|ПОМЕСТИТЬ ВТИндивидуальныеПечатныеФормы
			|ИЗ
			|	РегистрСведений.ТелеграмИндивидуальныеПечатныеФормы КАК ТелеграмИндивидуальныеПечатныеФормы
			|ГДЕ
			|	ТелеграмИндивидуальныеПечатныеФормы.ВладелецФайла = &ВладелецФайлов
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ИдентификаторКоманды
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТелеграмСтандартныеПечатныеФормы.ИдентификаторКоманды КАК ИдентификаторКоманды,
			|	ТелеграмСтандартныеПечатныеФормы.Использование КАК Использование
			|ПОМЕСТИТЬ ВТСтандартныеПечатныеФормы
			|ИЗ
			|	РегистрСведений.ТелеграмСтандартныеПечатныеФормы КАК ТелеграмСтандартныеПечатныеФормы
			|ГДЕ
			|	ТелеграмСтандартныеПечатныеФормы.ТипОбъекта = &ТипОбъекта
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ИдентификаторКоманды
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(ИндивидуальныеПечатныеФормы.ИдентификаторКоманды, СтандартныеПечатныеФормы.ИдентификаторКоманды) КАК ИдентификаторКоманды
			|ИЗ
			|	ВТИндивидуальныеПечатныеФормы КАК ИндивидуальныеПечатныеФормы
			|		ПОЛНОЕ СОЕДИНЕНИЕ ВТСтандартныеПечатныеФормы КАК СтандартныеПечатныеФормы
			|		ПО ИндивидуальныеПечатныеФормы.ИдентификаторКоманды = СтандартныеПечатныеФормы.ИдентификаторКоманды
			|ГДЕ
			|	ЕСТЬNULL(ИндивидуальныеПечатныеФормы.Использование, СтандартныеПечатныеФормы.Использование) = ЛОЖЬ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ВТИндивидуальныеПечатныеФормы
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ВТСтандартныеПечатныеФормы");
			
			ЗапросПоВложеннымПечатнымФормам.УстановитьПараметр("ТипОбъекта", ПолучитьСсылкуТипа(ВладелецФайлов));
			ЗапросПоВложеннымПечатнымФормам.УстановитьПараметр("ВладелецФайлов", ВладелецФайлов);
			
			ТаблицаВложенийНеОтправлять = ЗапросПоВложеннымПечатнымФормам.Выполнить().Выгрузить();
			
			МассивКомандУдалить = Новый Массив;
			Для Каждого КомандаУдалить Из КомандыПечати Цикл
				Если ТаблицаВложенийНеОтправлять.Найти(КомандаУдалить.УникальныйИдентификатор, "ИдентификаторКоманды") <> Неопределено Тогда
					МассивКомандУдалить.Добавить(КомандаУдалить);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ЭлементУдалить Из МассивКомандУдалить Цикл
				КомандыПечати.Удалить(ЭлементУдалить);
			КонецЦикла;
		
		КонецЕсли;
				
		СписокОбъектов = Новый Массив;
		СписокОбъектов.Добавить(ВладелецФайлов);
		
		НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
				
		Попытка
						
			Для Каждого СтрокаКомандаПечати Из КомандыПечати Цикл
				
				Если СтрокаКомандаПечати.СписокФорм <> ""
					ИЛИ СтрокаКомандаПечати.ЗаголовокФормы <> "" тогда
					
					Продолжить;
				КонецЕсли;
								
				ДанныеПечати = Неопределено;
				Если СтрокаКомандаПечати.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
					Источник = СтрокаКомандаПечати.ДополнительныеПараметры.Ссылка;
					ДанныеПечати = СформироватьВнешнююПечатнуюФорму(Источник, СтрокаКомандаПечати.Идентификатор, СписокОбъектов);
				Иначе
					ДанныеПечати = УправлениеПечатью.СформироватьПечатныеФормы(СтрокаКомандаПечати.МенеджерПечати, СтрокаКомандаПечати.Идентификатор,
					СписокОбъектов, СтрокаКомандаПечати.ДополнительныеПараметры);
				КонецЕсли;
												
				КоллекцияПечатныхФорм = ДанныеПечати.КоллекцияПечатныхФорм;
				
				Для Каждого ПечатнаяФорма Из КоллекцияПечатныхФорм Цикл
					СписокТабличныхДокументов.Добавить(ПечатнаяФорма.ТабличныйДокумент, ПечатнаяФорма.СинонимМакета);
				КонецЦикла;	
				
			КонецЦикла;
						
		Исключение
			Возврат;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры		//ПолучитьСписокПечатныхФормОбъекта()

Функция СформироватьВнешнююПечатнуюФорму(ДополнительнаяОбработкаСсылка, Идентификатор, СписокОбъектов)
	
	ПараметрыИсточника = Новый Структура;
	ПараметрыИсточника.Вставить("ИдентификаторКоманды", Идентификатор);
	ПараметрыИсточника.Вставить("ОбъектыНазначения", СписокОбъектов);
	
	КоллекцияПечатныхФорм = Неопределено;
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
	
	УправлениеПечатью.ПечатьПоВнешнемуИсточнику(ДополнительнаяОбработкаСсылка, ПараметрыИсточника, КоллекцияПечатныхФорм,
	ОбъектыПечати, ПараметрыВывода);
	
	Результат = Новый Структура;
	Результат.Вставить("КоллекцияПечатныхФорм", КоллекцияПечатныхФорм);
	Результат.Вставить("ОбъектыПечати", ОбъектыПечати);
	Результат.Вставить("ПараметрыВывода", ПараметрыВывода);
	
	Возврат Результат;
	
КонецФункции		//СформироватьВнешнююПечатнуюФорму()

Процедура ПрочитатьСообщенияПользователя() Экспорт
	
	СтруктураНастроек = ПолучитьНастройкиTelegram();
	Если Не ЗначениеЗаполнено(СтруктураНастроек.token) тогда
		ТекстСообщения = НСтр("ru = 'В настройках Telegram-бота не заполнен ""token"";'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	ПользовательБот = ПолучитьПользователяБотаЗадачИОповещений();
	Если ПользовательБот = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	HTTPСоединение = Новый HTTPСоединение(СтруктураНастроек.api, 443,,,,, Новый ЗащищенноеСоединениеOpenSSL());	
	
	Источник = "bot" + СтруктураНастроек.token + "/deleteWebhook";	
	HTTPЗапрос = Новый HTTPЗапрос(Источник);
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");	
	HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		
		Источник = "bot" + СтруктураНастроек.token + "/getUpdates";
	    HTTPЗапрос = Новый HTTPЗапрос(Источник);
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");	
		HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
	
		Если HTTPОтвет.КодСостояния = 200 Тогда
			
			Данные = ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
			
			Если Данные.ok И Данные.result.Количество()>0 Тогда
				
				МассивНомеровСообщений = Новый Массив;
				Для каждого СтрокаМассива Из Данные.result  Цикл
					МассивНомеровСообщений.Добавить(СтрокаМассива.update_id);
				КонецЦикла;
				Пользователь = Неопределено;
				
				Для каждого СтрокаМассива Из Данные.result  Цикл
										
					НомерСообщения = СтрокаМассива.update_id;
					
					Если ПроверитьНаличиеСообщенияПоID(НомерСообщения) Тогда
						Продолжить;
					КонецЕсли;
					
					Если СтрокаМассива.Свойство("message") Тогда
						СопоставитьПользователей1СТелеграм(СтруктураНастроек, СтрокаМассива.message.from.first_name, СтрокаМассива.message.from.last_name, СтрокаМассива.message.from.id, НомерСообщения, СтрокаМассива.message.text);
						
					ИначеЕсли СтрокаМассива.Свойство("edited_message") Тогда
						СопоставитьПользователей1СТелеграм(СтруктураНастроек, СтрокаМассива.edited_message.from.first_name, СтрокаМассива.edited_message.from.last_name, СтрокаМассива.edited_message.from.id, НомерСообщения, СтрокаМассива.edited_message.text);
						
					ИначеЕсли СтрокаМассива.Свойство("callback_query") Тогда
						
						ИдентификаторКнопкиСообщения = СтрокаМассива.callback_query.data;
						СопоставитьПользователей1СТелеграм(СтруктураНастроек, СтрокаМассива.callback_query.from.first_name, СтрокаМассива.callback_query.from.last_name, СтрокаМассива.callback_query.from.id, НомерСообщения, ИдентификаторКнопкиСообщения);
												
						НаборЗаписейНавигационныеСсылки = РегистрыСведений.ТелеграмНавигационныеСсылки.СоздатьНаборЗаписей();
						
						НаборЗаписейНавигационныеСсылки.Отбор.УИДКнопки.Значение = ИдентификаторКнопкиСообщения;
						НаборЗаписейНавигационныеСсылки.Отбор.УИДКнопки.ВидСравнения = ВидСравнения.Равно;
						НаборЗаписейНавигационныеСсылки.Отбор.УИДКнопки.Использование = Истина;
						
						НаборЗаписейНавигационныеСсылки.Прочитать();
						
						Если НаборЗаписейНавигационныеСсылки.Количество() = 1 тогда
							
							Пользователь = НаборЗаписейНавигационныеСсылки[0].Пользователь;
							УИДПользователя = НаборЗаписейНавигационныеСсылки[0].УИДПользователя;
							
							ЗаписьТелеграмЧаты = РегистрыСведений.ТелеграмЧаты.СоздатьМенеджерЗаписи();
							ЗаписьТелеграмЧаты.УИДЧата = СтрокаМассива.callback_query.chat_instance;
							ЗаписьТелеграмЧаты.УИДПользователя = УИДПользователя;
							ЗаписьТелеграмЧаты.Пользователь = Пользователь;
							ЗаписьТелеграмЧаты.Записать();
														
							КнопкаПриНажатии(НаборЗаписейНавигационныеСсылки[0].ТекстКнопки, НаборЗаписейНавигационныеСсылки[0].НавигационнаяСсылка, Пользователь, УИДПользователя);
																												
						КонецЕсли;						
					КонецЕсли;	
				КонецЦикла;
				
				ОчиститьИсториюСообщений(Пользователь, МассивНомеровСообщений);
								
			КонецЕсли; 		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры		//ПрочитатьСообщенияПользователя()

Процедура СопоставитьПользователей1СТелеграм(СтруктураНастроек, ТелеграмИмя, ТелеграмФамилия, УИДПользователя, НомерСообщения, ТекстСообщенияВход)

	Если Не ЗначениеЗаполнено(СтруктураНастроек.token) тогда
		ТекстСообщения = НСтр("ru = 'В настройках Telegram-бота не заполнен ""token"";'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	ЗапросПользователи = Новый Запрос("ВЫБРАТЬ
	|	ТелеграмПользователи.ТелеграмБот КАК ТелеграмБот,
	|	ТелеграмПользователи.Пользователь КАК Пользователь,
	|	ТелеграмПользователи.ТелеграмИмя КАК ТелеграмИмя,
	|	ТелеграмПользователи.ТелеграмФамилия КАК ТелеграмФамилия,
	|	ТелеграмПользователи.УИДПользователя КАК УИДПользователя,
	|	ТелеграмПользователи.Телефон КАК Телефон,
	|	ТелеграмПользователи.Администратор КАК Администратор
	|ИЗ
	|	РегистрСведений.ТелеграмПользователи КАК ТелеграмПользователи
	|ГДЕ
	|	ТелеграмПользователи.ТелеграмБот = &ТелеграмБот
	|	И ТелеграмПользователи.ТелеграмИмя ПОДОБНО &ТелеграмИмя
	|	И НЕ ТелеграмПользователи.ТелеграмИмя ПОДОБНО &ТелеграмИмяНе1
	|	И НЕ ТелеграмПользователи.ТелеграмИмя ПОДОБНО &ТелеграмИмяНе2
	|	И ТелеграмПользователи.ТелеграмФамилия ПОДОБНО &ТелеграмФамилия
	|	И НЕ ТелеграмПользователи.ТелеграмФамилия ПОДОБНО &ТелеграмФамилияНе1 
	|	И НЕ ТелеграмПользователи.ТелеграмФамилия ПОДОБНО &ТелеграмФамилияНе2");
	
	СимволыЗамены = Нстр("ru = '%[-!-я]%'");
	ЗапросПользователи.УстановитьПараметр("ТелеграмИмя", 	 "%" + ТелеграмИмя + "%");
	ЗапросПользователи.УстановитьПараметр("ТелеграмИмяНе1",  СимволыЗамены + ТелеграмИмя + "%");
	ЗапросПользователи.УстановитьПараметр("ТелеграмИмяНе2",  "%" + ТелеграмИмя + СимволыЗамены);  
	ЗапросПользователи.УстановитьПараметр("ТелеграмФамилия", "%" + ТелеграмФамилия + "%");
	ЗапросПользователи.УстановитьПараметр("ТелеграмФамилияНе1", СимволыЗамены + ТелеграмФамилия + "%");
	ЗапросПользователи.УстановитьПараметр("ТелеграмФамилияНе2", "%" + ТелеграмФамилия + СимволыЗамены);
	
	ЗапросПользователи.УстановитьПараметр("ТелеграмБот", 	 СтруктураНастроек.ТелеграмБот);
	
	ВыборкаПользователи = ЗапросПользователи.Выполнить().Выбрать();
	ЗаписьПользователи = РегистрыСведений.ТелеграмПользователи.СоздатьМенеджерЗаписи();
	
	Если ВыборкаПользователи.Количество() = 0 тогда
		ОчиститьИсториюСообщений(,, ТелеграмИмя, ТелеграмФамилия);
		Возврат;
	КонецЕсли;
	
	Пока ВыборкаПользователи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаПользователи.УИДПользователя) тогда
			ЗаписатьИсториюСообщений(ТекстСообщенияВход, НомерСообщения, ВыборкаПользователи.Пользователь, ТелеграмИмя, ТелеграмФамилия);
			Продолжить;
		КонецЕсли;
				
		ЗаполнитьЗначенияСвойств(ЗаписьПользователи, ВыборкаПользователи);
		ЗаписьПользователи.УИДПользователя = УИДПользователя;
		
		Попытка
			ЗаписьПользователи.Записать();
			ЗаписатьИсториюСообщений(ТекстСообщенияВход, НомерСообщения, ВыборкаПользователи.Пользователь, ТелеграмИмя, ТелеграмФамилия);
						
			ТекстСообщения = НСтр("ru = 'Соединение с 1С установлено!'");
			
			Приемник = "bot" + СтруктураНастроек.token + "/sendMessage?chat_id=" + Формат(УИДПользователя, "ЧДЦ=; ЧГ=") + "&text=" + ТекстСообщения;
						
			HTTPСоединение  =  Новый HTTPСоединение(СтруктураНастроек.api,443,,,,,Новый ЗащищенноеСоединениеOpenSSL());
			HTTPЗапрос = Новый HTTPЗапрос(Приемник);
			HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры		//СопоставитьПользователей1СТелеграм()

Процедура КнопкаПриНажатии(ДанныеСобытия, ТекстСсылки, Пользователь, УИДПользователя)
		
	ЗначениеСсылкиОбъект = ОбщегоНазначенияУХ.СсылкаНаОбъектИзНавигационнойСсылки("e1c:" + ТекстСсылки);
	Если ЗначениеСсылкиОбъект <> Неопределено Тогда
		Если ЗначениеЗаполнено(ЗначениеСсылкиОбъект) Тогда
			СтандартнаяОбработка = Ложь;
			Если ТипЗнч(ЗначениеСсылкиОбъект) = Тип("СправочникСсылка.Задачи") Тогда
				Если НЕ СистемаВзаимодействияСерверУХ.ЗадачаВыполненаРанее(ЗначениеСсылкиОбъект) Тогда
					
					СтруктураПараметров = Новый Структура;
					
					ПозицияОтносительнойСсылки = СтрНайти(ТекстСсылки, "e1cib/data/");
					УстановитьРежимСогласования(ДанныеСобытия, СтруктураПараметров);								
					
					СистемаВзаимодействияСерверУХ.ДополнитьСтруктуруПараметровФормыСогласования(ЗначениеСсылкиОбъект, СтруктураПараметров);
					Если СтруктураПараметров.ТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЭтапСогласования") Тогда
						ОбработатьСогласование(СтруктураПараметров, ЗначениеСсылкиОбъект, Пользователь);	
					КонецЕсли;
					
				Иначе
					
					СтруктураНастроек = ПолучитьНастройкиTelegram();
					Если Не ЗначениеЗаполнено(СтруктураНастроек.token) тогда
						ТекстСообщения = НСтр("ru = 'В настройках Telegram-бота не заполнен ""token"";'");
						ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		
						Возврат;
					КонецЕсли;
	
					ТекстСообщения = НСтр("ru = 'Задачи были выполнены ранее.'");
					
					Приемник = "bot" + СтруктураНастроек.token + "/sendMessage?chat_id=" + Формат(УИДПользователя, "ЧДЦ=; ЧГ=") + "&text=" + ТекстСообщения;
					
					HTTPСоединение = Новый HTTPСоединение(СтруктураНастроек.api,443,,,,,Новый ЗащищенноеСоединениеOpenSSL());
					HTTPЗапрос = Новый HTTPЗапрос(Приемник);
					HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
										
					Возврат;
					
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Пустое значение. Не переходим.	
		КонецЕсли;
	Иначе
		// Это не навигационная ссылка. Ничего не делаем.
	КонецЕсли;
		
КонецПроцедуры		//КнопкаПриНажатии()

Процедура УстановитьРежимСогласования(ДанныеСобытияВход, СтруктураПараметровВход)
	
	СтруктураПараметровВход.Вставить("ИдентификаторЭлемента", "");
	
	// Получим имя элемента по id-аттрибуту.
	Попытка 
		ИмяЭлемента = "";
		ТекстСогласовано = НСтр("ru = 'Согласовано'", ОбщегоНазначения.КодОсновногоЯзыка());
		ТекстВозвращеноИнициатору = НСтр("ru = 'Возвращено инициатору'", ОбщегоНазначения.КодОсновногоЯзыка());
		ТекстВозвращеноНаПредыдущийЭтапСогласования = НСтр("ru = 'Возвращено на предыдущий этап согласования'", ОбщегоНазначения.КодОсновногоЯзыка());
		ТекстПринятьКИсполнению = НСтр("ru = 'Принять к исполнению'", ОбщегоНазначения.КодОсновногоЯзыка());
		ТекстОтменитьПринятиеКИсполнению = НСтр("ru = 'Отменить принятие к исполнению'", ОбщегоНазначения.КодОсновногоЯзыка());
	
		Если ДанныеСобытияВход = ТекстСогласовано Тогда
			СтруктураПараметровВход.Вставить("ИдентификаторЭлемента", "cpm_accept");
			ИмяЭлемента = "Утвердить";
		ИначеЕсли ДанныеСобытияВход = ТекстВозвращеноИнициатору Тогда
			СтруктураПараметровВход.Вставить("ИдентификаторЭлемента", "cpm_decline");
			ИмяЭлемента = "Отклонить";	
		ИначеЕсли ДанныеСобытияВход = ТекстВозвращеноНаПредыдущийЭтапСогласования Тогда
			СтруктураПараметровВход.Вставить("ИдентификаторЭлемента", "cpm_stepback");
			ИмяЭлемента = "НаШагНазад";
		ИначеЕсли ДанныеСобытияВход = ТекстПринятьКИсполнению Тогда
			СтруктураПараметровВход.Вставить("ИдентификаторЭлемента", "cpm_acceptforexecution");
			ИмяЭлемента = "ПринятьКИсполнению";
		ИначеЕсли ДанныеСобытияВход = ТекстОтменитьПринятиеКИсполнению Тогда
			СтруктураПараметровВход.Вставить("ИдентификаторЭлемента", "cpm_cancelexecution");
			ИмяЭлемента = "ОтменитьПринятиеКИсполнению";
		Иначе
			ИмяЭлемента = "";
		КонецЕсли;
	Исключение
		ИмяЭлемента = "";
	КонецПопытки;
	
	// Установим параметр в структуру.
	Если СокрЛП(ИмяЭлемента) = "Утвердить" Тогда
		СтруктураПараметровВход.Вставить("РежимСогласования", "Утверждение");
	ИначеЕсли СокрЛП(ИмяЭлемента) = "Отклонить" Тогда
		СтруктураПараметровВход.Вставить("РежимСогласования", "Отклонение");
	ИначеЕсли СокрЛП(ИмяЭлемента) = "НаШагНазад" Тогда
		СтруктураПараметровВход.Вставить("РежимСогласования", "НаШагНазад");
	ИначеЕсли СокрЛП(ИмяЭлемента) = "ПринятьКИсполнению" Тогда
		СтруктураПараметровВход.Вставить("РежимСогласования", "ПринятьКИсполнению");
	ИначеЕсли СокрЛП(ИмяЭлемента) = "ОтменитьПринятиеКИсполнению" Тогда
		СтруктураПараметровВход.Вставить("РежимСогласования", "ОтменитьПринятиеКИсполнению");
	Иначе
		СтруктураПараметровВход.Вставить("РежимСогласования", "");
	КонецЕсли;
	
КонецПроцедуры		//УстановитьРежимСогласования()

Процедура ОбработатьСогласование(СтруктураПараметров, Задача, Пользователь)
	
	Если СтруктураПараметров.ИдентификаторЭлемента = "cpm_accept" тогда
		СогласоватьЭтап(Задача, Пользователь);
	ИначеЕсли СтруктураПараметров.ИдентификаторЭлемента = "cpm_stepback" тогда
		ОтклонитьЭтап(Задача, Пользователь);
	ИначеЕсли СтруктураПараметров.ИдентификаторЭлемента = "cpm_decline" тогда
		ВернутьИнициатору(Задача, Пользователь);
	ИначеЕсли СтруктураПараметров.ИдентификаторЭлемента = "cpm_acceptforexecution" тогда
		ПринятьКИсполнению(Задача, Пользователь);
	ИначеЕсли СтруктураПараметров.ИдентификаторЭлемента = "cpm_cancelexecution" тогда	
		ОтменитьПринятиеКИсполнению(Задача, Пользователь);	
	КонецЕсли;
	
КонецПроцедуры		//ОбработатьСогласование()

Процедура СогласоватьЭтап(Задача, Пользователь)
	
	СписокЗадач = Новый СписокЗначений;
	СписокЗадач.Добавить(Задача);
	
	ПакетДокументов = Новый СписокЗначений;
	ПакетДокументов.Добавить(Задача.СвязанныйОбъект);
	
	ТекущийЭтап = ВернутьМассивДляПередачиПоОповещению(СписокЗадач, ПакетДокументов);
	
	СоответствиеДанныхЭтапов = СоответствиеДанныхТекущихЭтапов(ТекущийЭтап);
		
	Для Каждого СтрЭтап ИЗ ТекущийЭтап Цикл
		Замещение = (СтрЭтап.Пользователь <> Пользователь);
		ТекЭтап = СтрЭтап.Этап;
		// Проверим, что заполнен комментарий при утверждении.
		СтруктураДанныхЭтапа = СоответствиеДанныхЭтапов.Получить(ТекЭтап);
		Если СтруктураДанныхЭтапа <> Неопределено Тогда
			ОбязательныйКомментарийПриСогласовании = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбязательныйКомментарийПриСогласовании", Ложь);
		Иначе
			ОбязательныйКомментарийПриСогласовании = Ложь;
		КонецЕсли;
		НовыйКоментарий = "";
		Если (НЕ ОбязательныйКомментарийПриСогласовании) ИЛИ (СокрЛП(НовыйКоментарий) <> "") Тогда
			Если СтрЭтап.ДопСогласование Тогда
				// Виза доп согласующих.
				МодульСогласованияДокументовУХ.УтвердитьЭтапДополнительногоСогласования(СтрЭтап.Пользователь, СтрЭтап.ДокументСогласования, ТекЭтап, СтрЭтап.Комментарий, СтрЭтап.Организация, Замещение);	
			Иначе
				// Непосредственное утверждение.
				ТекущийЭтап_ = Новый Структура();
				ТекущийЭтап_.Вставить("Этап", ТекЭтап);
				ТекущийЭтап_.Вставить("ДокументСогласования", СтрЭтап.ДокументСогласования);
				ТекущийЭтап_.Вставить("Организация", СтрЭтап.Организация);
				ТекущийЭтап_.Вставить("Комментарий", НовыйКоментарий);
				
				МодульУправленияПроцессамиУХ.УтвердитьЭтап(, ТекущийЭтап_, СтрЭтап.ТекущийДокумент, СтрЭтап.Пользователь, Замещение, Неопределено, Ложь);	
			КонецЕсли; 	
		Иначе
			ТекстСообщения = НСтр("ru = 'Требуется ввести комментарий перед утверждением'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКОтправке = СобытияОповещенийСерверУХ.ПолучитьТаблицуОповещенийКОтправке();
	СобытияОповещенийСерверУХ.ОтправитьОповещенияПоСобытиям(ТаблицаКОтправке);
	
КонецПроцедуры		//СогласоватьЭтап()

Процедура ОтклонитьЭтап(Задача, Пользователь)
		
	СписокЗадач = Новый СписокЗначений;
	СписокЗадач.Добавить(Задача);
	
	ПакетДокументов = Новый СписокЗначений;
	ПакетДокументов.Добавить(Задача.СвязанныйОбъект);
	
	ТекущийЭтап = ВернутьМассивДляПередачиПоОповещению(СписокЗадач, ПакетДокументов);
	
	// Обход полученных данных.
	СоответствиеДанныхЭтапов = СоответствиеДанныхТекущихЭтапов(ТекущийЭтап);
	
	Для Каждого СтрЭтап ИЗ ТекущийЭтап Цикл
		ТекЭтап = СтрЭтап.Этап;
		// Проверим, что заполнен комментарий при отклонении.
		СтруктураДанныхЭтапа = СоответствиеДанныхЭтапов.Получить(ТекЭтап);
		Если СтруктураДанныхЭтапа <> Неопределено Тогда
			ОбязательныйКомментарийПриОтклонении = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбязательныйКомментарийПриОтклонении", Ложь);
		Иначе
			ОбязательныйКомментарийПриОтклонении = Ложь;
		КонецЕсли;
		НовыйКоментарий = "";
		Если (НЕ ОбязательныйКомментарийПриОтклонении) ИЛИ (СокрЛП(НовыйКоментарий) <> "") Тогда
			// Виза доп согласующих.
			Если СтрЭтап.ДопСогласование Тогда
				МодульСогласованияДокументовУХ.ПоставитьДопВизу(СтрЭтап.Пользователь, СтрЭтап.ДокументСогласования, СтрЭтап.Этап, Ложь, СтрЭтап.Комментарий, СтрЭтап.Организация);
			Иначе
				// Т.к. отклонить имеет право любой участник согласования, после установки визы доп согласующего продолжаем выполнение по стандартному алгоритму.
			КонецЕсли;  
			// Непосредственное отклонение.
			Замещение = (СтрЭтап.Пользователь <> Пользователь);
			ТекущийЭтап_ = Новый Структура();
			ТекущийЭтап_.Вставить("Этап", СтрЭтап.Этап);
			ТекущийЭтап_.Вставить("ДокументСогласования", СтрЭтап.ДокументСогласования);
			ТекущийЭтап_.Вставить("Организация", СтрЭтап.Организация);
			ТекущийЭтап_.Вставить("Комментарий", "");
			МодульУправленияПроцессамиУХ.ОтклонитьЭтап(,ТекущийЭтап_, СтрЭтап.ТекущийДокумент, СтрЭтап.Пользователь, Замещение, Ложь);
		Иначе
			ТекстСообщения = НСтр("ru = 'Требуется ввести комментарий перед отклонением'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКОтправке = СобытияОповещенийСерверУХ.ПолучитьТаблицуОповещенийКОтправке();
	СобытияОповещенийСерверУХ.ОтправитьОповещенияПоСобытиям(ТаблицаКОтправке);
	
КонецПроцедуры		//ОтклонитьЭтап()

Процедура ВернутьИнициатору(Задача, Пользователь)
		
	СписокЗадач = Новый СписокЗначений;
	СписокЗадач.Добавить(Задача);
	
	ПакетДокументов = Новый СписокЗначений;
	ПакетДокументов.Добавить(Задача.СвязанныйОбъект);
	
	ТекущийЭтап = ВернутьМассивДляПередачиПоОповещению(СписокЗадач, ПакетДокументов);
	
	// Обход полученных данных.
	СоответствиеДанныхЭтапов = СоответствиеДанныхТекущихЭтапов(ТекущийЭтап);
	
	Для Каждого СтрЭтап ИЗ ТекущийЭтап Цикл   
		ТекЭтап = СтрЭтап.Этап;
		// Проверим, что заполнен комментарий при отклонении.
		СтруктураДанныхЭтапа = СоответствиеДанныхЭтапов.Получить(ТекЭтап);
		Если СтруктураДанныхЭтапа <> Неопределено Тогда
			ОбязательныйКомментарийПриОтклонении = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбязательныйКомментарийПриОтклонении", Ложь);
		Иначе
			ОбязательныйКомментарийПриОтклонении = Ложь;
		КонецЕсли;
		НовыйКоментарий = "";
		Если (НЕ ОбязательныйКомментарийПриОтклонении) ИЛИ (СокрЛП(НовыйКоментарий) <> "") Тогда
			// Виза дополнительных согласующих.
			Замещение = (СтрЭтап.Пользователь <> Пользователь);
			Если СтрЭтап.ДопСогласование Тогда
				МодульСогласованияДокументовУХ.ПоставитьДопВизу(СтрЭтап.Пользователь, СтрЭтап.ДокументСогласования, ТекЭтап, Ложь, СтрЭтап.Комментарий, СтрЭтап.Организация);
			Иначе
				// Т.к. отклонить имеет право любой участник согласования, после установки визы доп согласующего продолжаем выполнение по стандартному алгоритму.
			КонецЕсли;  
			// Непосредственное отклонение.
			ТекущийЭтап_ = Новый Структура();
			ТекущийЭтап_.Вставить("Этап",					 ТекЭтап);
			ТекущийЭтап_.Вставить("ДокументСогласования",	 СтрЭтап.ДокументСогласования);
			ТекущийЭтап_.Вставить("Организация",			 СтрЭтап.Организация);
			ТекущийЭтап_.Вставить("Комментарий",			 НовыйКоментарий);
			МодульУправленияПроцессамиУХ.ВернутьДокументНаДоработку(, ТекущийЭтап_, СтрЭтап.ТекущийДокумент, СтрЭтап.Пользователь, Замещение, Ложь);
				
		Иначе
			ТекстСообщения = НСтр("ru = 'Требуется ввести комментарий перед отклонением'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКОтправке = СобытияОповещенийСерверУХ.ПолучитьТаблицуОповещенийКОтправке();
	СобытияОповещенийСерверУХ.ОтправитьОповещенияПоСобытиям(ТаблицаКОтправке);
	
КонецПроцедуры		//ВернутьИнициатору()

Процедура ПринятьКИсполнению(Задача, Пользователь)
		
	// Получения данных для обработки.
	СписокЗадач = Новый СписокЗначений;
	СписокЗадач.Добавить(Задача);
	
	ПакетДокументов = Новый СписокЗначений;
	ПакетДокументов.Добавить(Задача.СвязанныйОбъект);
	
	ТекущийЭтап = ВернутьМассивДляПередачиПоОповещению(СписокЗадач, ПакетДокументов);
		
	// Обход полученных данных.
	СоответствиеДанныхЭтапов = СоответствиеДанныхТекущихЭтапов(ТекущийЭтап);
		
	Для Каждого СтрЭтап ИЗ ТекущийЭтап Цикл
				
		ТекЭтап = СтрЭтап.Этап;
		// Проверим, что заполнен комментарий при утверждении.
		СтруктураДанныхЭтапа = СоответствиеДанныхЭтапов.Получить(ТекЭтап);
		
		Если СтруктураДанныхЭтапа <> Неопределено Тогда
			ОбязательныйКомментарийПриСогласовании = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбязательныйКомментарийПриСогласовании", Ложь);
		Иначе
			ОбязательныйКомментарийПриСогласовании = Ложь;
		КонецЕсли;
		
		НовыйКоментарий = "";
		
		Если (НЕ ОбязательныйКомментарийПриСогласовании) ИЛИ (СокрЛП(НовыйКоментарий) <> "") Тогда
			МодульУправленияПроцессамиУХ.ПринятьЭтапКИсполнению(СтрЭтап.ДокументСогласования, СтрЭтап.Организация, ТекЭтап, Пользователь, НовыйКоментарий, Истина); 	
		Иначе
			ТекстСообщения = НСтр("ru = 'Требуется ввести комментарий перед утверждением'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаКОтправке = СобытияОповещенийСерверУХ.ПолучитьТаблицуОповещенийКОтправке();
	СобытияОповещенийСерверУХ.ОтправитьОповещенияПоСобытиям(ТаблицаКОтправке);
	
КонецПроцедуры

