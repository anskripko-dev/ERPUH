		ТекстДляОтправки = ТекстДляОтправки + ИдентификаторЧата + Символы.ПС;
		
		ТекстДляОтправки = ТекстДляОтправки + "--"+Boundary + Символы.ПС;		
		Файл = Новый Файл(ВложенныйФайл.ИмяФайла);
		ИмяФайлаПечатныеФормы = НСтр("ru = 'Печатные формы.pdf'");
		ТекстДляОтправки = ТекстДляОтправки + "Content-Disposition: form-data; name=""document""; filename=""" + ИмяФайлаПечатныеФормы + """" + Символы.ПС;
		
		ФайлОтправкиНачало.ЗаписатьСтроку(ТекстДляОтправки );
		ФайлОтправкиНачало.Закрыть();
		
		МассивФайловДляОбъединения.Очистить();
		
		МассивФайловДляОбъединения.Добавить(ИмяФайлаОтправкиНачало);
		
		МассивФайловДляОбъединения.Добавить(СокрЛП(ИмяФайла));
		
		ТекстДляОтправки = "" + Символы.ПС;
		ТекстДляОтправки = ТекстДляОтправки + "--"+Boundary+"--";
		ФайлаОтправкиКонец.ЗаписатьСтроку(ТекстДляОтправки);
		ФайлаОтправкиКонец.Закрыть();
		МассивФайловДляОбъединения.Добавить(ИмяФайлаОтправкиКонец);
		
		ИмяФайлаОтправки = ПолучитьИмяВременногоФайла("txt");
		
		ОбъединитьФайлы(МассивФайловДляОбъединения, ИмяФайлаОтправки);
		
		HTTPЗапрос.УстановитьИмяФайлаТела(ИмяФайлаОтправки);
		
		Попытка
			HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Исключение		
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Отказ);
		КонецПопытки;
		
	КонецЦикла;
	
	Для Каждого ВложенныйФайл Из ТаблицаФайлов Цикл
		Попытка
			УдалитьФайлы(ВложенныйФайл.ИмяФайла);
		Исключение
		КонецПопытки;
	КонецЦикла;
		
	Если Строки.Количество() > 0 тогда
		
