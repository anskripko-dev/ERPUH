			КонецЕсли;
			
		КонецЕсли;
		
		МенеджерЗаписи.Записать(Истина);
		
		ДобавитьЗаписьВлогПроцесса(ДокументПроцесса, ЭтапПроцесса, ПользовательРабочий, Комментарий, Перечисления.ВидыОповещенийПользователейУХ.ЭтапПринятКИсполнению);
				
