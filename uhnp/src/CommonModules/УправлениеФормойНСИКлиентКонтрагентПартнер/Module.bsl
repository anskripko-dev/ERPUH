Процедура ВвестиЗаявкуНаСогласованиеИзменений_Контрагент(Форма,АдресДанныхОбъекта,ПоказыватьЗаявку=Истина,Партнер=Неопределено) Экспорт
		
	Если Не ЗначениеЗаполнено(Форма.КонтрагентПартнера) Тогда
				
		Возврат;
		
	КонецЕсли;
	
	ТекЗаявка=УправлениеФормойНСИВызовСервера.ПолучитьЗаявкуНСИИзменение(АдресДанныхОбъекта); 
	
	Если Не ПоказыватьЗаявку Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекЗаявка<>Неопределено Тогда
			
		ПоказатьЗначение(, ТекЗаявка); 
		
	ИначеЕсли Не Партнер=Неопределено Тогда
		
		ЗаявкаПартнер=УправлениеФормойНСИСерверКонтрагентПартнер.ПолучитьЗаявкуСвязанныйОбъект(Партнер);
		
		Если НЕ ЗаявкаПартнер=Неопределено Тогда
			
			ПоказатьЗначение(, ЗаявкаПартнер);
			
		КонецЕсли;
				
	КонецЕсли;
				
КонецПроцедуры // ВвестиЗаявкуНаРегистрацию()



Процедура ПоказатьРеквизитыЦНСИ_Контрагент(Форма) Экспорт
	
	Пар = Новый Структура("Ссылка, ИмяФормы", Форма.КонтрагентПартнера, Форма.ИмяФормы); 
	ИмяФормыИзменения="ОбщаяФорма.ФормаИзмененияРеквизитовНСИ";
	ОткрытьФорму(ИмяФормыИзменения,Пар,Форма);
		
КонецПроцедуры // ПоказатьРеквизитыЦНСИ()

Процедура ВвестиЗаявкуНаУдаление_Контрагент(Форма) Экспорт
	
	ТекЗаявка=УправлениеФормойНСИВызовСервера.ПолучитьЗаявкуНСИУдаление(Форма.КонтрагентПартнера);
	
	Если ТекЗаявка<>Неопределено Тогда 
		ПоказатьЗначение(, ТекЗаявка);
	КонецЕсли;
			
КонецПроцедуры // ВвестиЗаявкуНаРегистрацию()

