#Область Трассировка

// Функция - ВТ - Возвращает структуру с таблицами запроса, в том числе и временными
//
// Параметры:
//  ЗапросМенеджер	 - Запрос, МенеджерВременныхТаблиц - Запрос или Менеджер временных таблиц
// 
// Возвращаемое значение:
//   - Структура - Структура с таблицами запроса
//
Функция ВТ(Знач ЗапросМенеджер) Экспорт
	
	Если ТипЗнч(ЗапросМенеджер) = Тип("Запрос") Тогда
		Если ЗапросМенеджер.МенеджерВременныхТаблиц = Неопределено Тогда			
			Запрос = Новый Запрос;
			Запрос.Текст = ЗапросМенеджер.Текст;
			Для Каждого Параметр Из ЗапросМенеджер.Параметры Цикл
				Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);	
			КонецЦикла;
			ЗапросМенеджер = Новый МенеджерВременныхТаблиц;
			Запрос.МенеджерВременныхТаблиц = ЗапросМенеджер;
			Запрос.Выполнить();
		Иначе
			ЗапросМенеджер = ЗапросМенеджер.МенеджерВременныхТаблиц;
		КонецЕсли;		
	КонецЕсли;
	Если ТипЗнч(ЗапросМенеджер) <> Тип("МенеджерВременныхТаблиц") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результаты = Новый Структура;
	
	Для Каждого Таблица Из ЗапросМенеджер.Таблицы Цикл		
		Результаты.Вставить(Таблица.ПолноеИмя,Таблица.ПолучитьДанные().Выгрузить());	
	КонецЦикла;
	
	Возврат Результаты;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиПодписок

// Обработчик подписки "ПриЗаписиОбъектаПараметрическойНастройки"
//
// Параметры:
//  Источник - СправочникСсылка - Объект параметрической настройки
//  Отказ	 - Булево - В случае ошибки устанавливается в значение "Ложь"
//
Процедура ПриЗаписиОбъектаПараметрическойНастройки(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСтруктуруРасчетаПоказателей(Источник.Ссылка, Отказ);
	
КонецПроцедуры
	
#КонецОбласти

// Очищает версии и данные параметрики текущего отчета 
//
// Параметры:
//  ОбъектРасчета					 - Структура - Структура с данными для расчета 
//  УдалятьВерсии					 - Булево - Признак того, что необходимо удалить версии
//  УдалятьПараметрикуНовогоДвижка	 - Булево - Признак того, что необходимо очистить данные параметрики расширенного алгоритма пересчета показателей
//  УдалятьПараметрикуСтарогоДвижка	 - Булево - Признак того, что необходимо очистить данные параметрики классического алгоритма пересчета показателей 
//
// Возвращаемое значение:
//	Булево - Истина, если не было ошибок в работе функции, Ложь - был ошибки
//
Функция ОчиститьСтарыеДанные(ОбъектРасчета, УдалятьВерсии=Истина, УдалятьПараметрикуНовогоДвижка=Истина, УдалятьПараметрикуСтарогоДвижка=Ложь) Экспорт
	
	Если УдалятьПараметрикуНовогоДвижка Тогда
		ОчиститьСтруктуруРасчетаПоказателей(ОбъектРасчета.ПравилоОбработки);
	КонецЕсли;
	Если УдалятьПараметрикуСтарогоДвижка Тогда
		УправлениеОтчетамиУХ.ОчиститьЗаписиРегистраПараметрическихНастроек(ОбъектРасчета.ПравилоОбработки);
	КонецЕсли;
	
	Если УдалятьВерсии Тогда
		
		Запрос = Новый Запрос;
		
		Если ОбъектРасчета.Свойство("Регистратор")
			И ЗначениеЗаполнено(ОбъектРасчета.Регистратор) Тогда
			
			// Удаляем версии по конкретному регистратору
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ОписаниеВерсий.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ОписаниеВерсий КАК ОписаниеВерсий
				|ГДЕ
				|	ОписаниеВерсий.Регистратор = &Регистратор";
			
			Запрос.УстановитьПараметр("Регистратор", ОбъектРасчета.Регистратор);
			
		Иначе
	
			// Удаляем версии по ключевому срезу
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ВерсииЗначенийПоказателей.Владелец КАК Ссылка
				|ИЗ
				|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
				|ГДЕ
				|	ВерсииЗначенийПоказателей.ВидОтчета = &ВидОтчета
				|	И ВерсииЗначенийПоказателей.Организация = &Организация
				|	И ВерсииЗначенийПоказателей.Сценарий = &Сценарий
				|	И ВерсииЗначенийПоказателей.Проект = &Проект
				|	И ВерсииЗначенийПоказателей.ПериодОтчета В(&МассивПериодов)";
			
			Запрос.УстановитьПараметр("ВидОтчета", ОбъектРасчета.ВидОтчета);
			Запрос.УстановитьПараметр("Организация", ОбъектРасчета.Организация);
			Запрос.УстановитьПараметр("Сценарий", ОбъектРасчета.Сценарий);
			Запрос.УстановитьПараметр("Проект", ОбъектРасчета.Проект);
		
			Если ОбъектРасчета.МассивПериодов = Неопределено Тогда
				ОбъектРасчета.Вставить("МассивПериодов", УправлениеОтчетамиУХ.ПолучитьМассивПериодов(
					Новый Структура("ПериодОтчета, ПериодОкончания",ОбъектРасчета.ПериодОтчета,ОбъектРасчета.ПериодОкончания)));
			КонецЕсли;
			Запрос.УстановитьПараметр("МассивПериодов", ОбъектРасчета.МассивПериодов);
		
			Если ОбъектРасчета.МаксАналитикОтчета = Неопределено Тогда
				ДанныеВидаОтчета = БюджетированиеИОтчетностьПовтИсп.ДанныеВидаОтчета(ОбъектРасчета.ВидОтчета);
				ОбъектРасчета.МаксАналитикОтчета = ДанныеВидаОтчета.МаксКлючевыхАналитик;
			КонецЕсли;
		
			Для Сч = 1 По ОбъектРасчета.МаксАналитикОтчета Цикл
				Запрос.Текст = Запрос.Текст + "
				|	И ВерсииЗначенийПоказателей.Аналитика" + Сч + " = &Аналитика" + Сч;
				Запрос.УстановитьПараметр("Аналитика" + Сч, ОбъектРасчета["Аналитика" + Сч]);
			КонецЦикла;
			
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			// Начнем транзакцию, если необходимо
			СозданаТранзакция = Не ТранзакцияАктивна();
			Если СозданаТранзакция Тогда
				НачатьТранзакцию();
			КонецЕсли;
			
			Попытка
				
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("Справочник.ОписаниеВерсий");
				ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
				ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
				Блокировка.Заблокировать();
			
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл		
					СпрОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
					СпрОбъект.Удалить();
				КонецЦикла;
				
				Если СозданаТранзакция Тогда
					ЗафиксироватьТранзакцию();
				КонецЕсли;
				
			Исключение
				
				Если СозданаТранзакция Тогда
					ОтменитьТранзакцию();
				КонецЕсли;

				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке),,,СтатусСообщения.Внимание);
				Возврат Ложь;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

// Процедура - Очищает регистр сведений "ХранилищаПараметрическойНастройкиРасширенный" для связанных правил расчета
//
// Параметры:
//  ДанныеСсылка - СправочникСсылка - Ссылка на изменяемый объект
//  Отказ		 - Булево - В случае ошибки устанавливается в значение "Ложь"
//
Процедура ОчиститьСтруктуруРасчетаПоказателей(ДанныеСсылка = Неопределено, Отказ = Ложь) Экспорт
	
	Если ТипЗнч(ДанныеСсылка) = Тип("СправочникСсылка.ПравилаОбработки") Тогда
		
		РегистрыСведений.ХранилищаПараметрическойНастройкиРасширенный.ОчиститьЗаписи(ДанныеСсылка);
		Возврат;
		
	ИначеЕсли ТипЗнч(ДанныеСсылка) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПравилаОбработки.Ссылка КАК ПравилоОбработки
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|ГДЕ
		|	ПравилаОбработки.Владелец = &Ссылка";
	
	ИначеЕсли ТипЗнч(ДанныеСсылка) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
	
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПравилаОбработки.Ссылка КАК ПравилоОбработки
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|ГДЕ
		|	ПравилаОбработки.Владелец В
		|			(ВЫБРАТЬ
		|				СправочникДанные.Владелец КАК Владелец
		|			ИЗ
		|				Справочник.ПоказателиОтчетов КАК СправочникДанные
		|			ГДЕ
		|				СправочникДанные.Ссылка = &Ссылка)";
		
	ИначеЕсли ТипЗнч(ДанныеСсылка) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПравилаОбработки.Ссылка КАК ПравилоОбработки
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|ГДЕ
		|	ПравилаОбработки.Владелец В
		|			(ВЫБРАТЬ
		|				СправочникДанные.Владелец КАК Владелец
		|			ИЗ
		|				Справочник.ГруппыРаскрытия КАК СправочникДанные
		|			ГДЕ
		|				СправочникДанные.Ссылка = &Ссылка)";
		
	ИначеЕсли ТипЗнч(ДанныеСсылка) = Тип("СправочникСсылка.КолонкиОтчетов") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПравилаОбработки.Ссылка КАК ПравилоОбработки
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|ГДЕ
		|	ПравилаОбработки.Владелец В
		|			(ВЫБРАТЬ
		|				СправочникДанные.Владелец КАК Владелец
		|			ИЗ
		|				Справочник.КолонкиОтчетов КАК СправочникДанные
		|			ГДЕ
		|				СправочникДанные.Ссылка = &Ссылка)";
		
	ИначеЕсли ТипЗнч(ДанныеСсылка) = Тип("СправочникСсылка.СтрокиОтчетов") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПравилаОбработки.Ссылка КАК ПравилоОбработки
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|ГДЕ
		|	ПравилаОбработки.Владелец В
		|			(ВЫБРАТЬ
		|				СправочникДанные.Владелец КАК Владелец
		|			ИЗ
		|				Справочник.СтрокиОтчетов КАК СправочникДанные
		|			ГДЕ
		|				СправочникДанные.Ссылка = &Ссылка)";
		
	Иначе
		РегистрыСведений.ХранилищаПараметрическойНастройкиРасширенный.ОчиститьЗаписи(, Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДанныеСсылка);
	РезультатЗапроса = Запрос.Выполнить(); 
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			РегистрыСведений.ХранилищаПараметрическойНастройкиРасширенный.ОчиститьЗаписи(ВыборкаЗапроса.ПравилоОбработки, Отказ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Функция - Получить описание таблицы измененных показателей
// 
// Возвращаемое значение:
//   - ТаблицаЗначений - пустая таблица для таблицы измененных показателей
//
Функция ОписаниеТаблицыИзмененныхПоказателей() Экспорт
	
	КолонкиТаблицы = "ПравилоОбработки,Показатель,Сценарий,Организация,Проект,ПериодОтчета,Валюта,ИспользуемаяИБ,СпособФормированияОтчета";
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		КолонкиТаблицы = КолонкиТаблицы + ",Аналитика" + Сч;
	КонецЦикла;
	
	КолонкиТаблицы = КолонкиТаблицы + ",АналитикаВалюта,Значение,ЗначениеВалюта";
	
	тЛогИзмененныхПоказателей = РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетов.СоздатьНаборЗаписей().ВыгрузитьКолонки(КолонкиТаблицы);
	тЛогИзмененныхПоказателей.Колонки.Добавить("ЗначениеНечисловое", Метаданные.РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетовНечисловые.Реквизиты.Значение.Тип);
	
	Возврат тЛогИзмененныхПоказателей;
	
КонецФункции

// Функция - Получить описание лога измененных показателей
// 
// Возвращаемое значение:
//   - ТаблицаЗначений - пустая таблица для лога измененных показателей
//
Функция ОписаниеЛогаИзмененныхПоказателей() Экспорт
	
	тЛогИзмененныхПоказателей = РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетов.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	тЛогИзмененныхПоказателей.Колонки.Добавить("ВидЗначения", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0,ДопустимыйЗнак.Неотрицательный));
	
	МассивТипов = Новый Массив;
	Для Каждого ТекТип Из Метаданные.РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетовНечисловые.Реквизиты.Значение.Тип.Типы() Цикл
		МассивТипов.Добавить(ТекТип);	
	КонецЦикла;
	ОписаниеВсеТипы = Новый ОписаниеТипов(
		Метаданные.РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетов.Реквизиты.Значение.Тип,
		МассивТипов);
		
	тЛогИзмененныхПоказателей.Колонки.Удалить(тЛогИзмененныхПоказателей.Колонки.Найти("Значение"));
	тЛогИзмененныхПоказателей.Колонки.Добавить("Значение", ОписаниеВсеТипы);
	
	Возврат тЛогИзмененныхПоказателей;
	
КонецФункции

// Процедура - Очистить лог измененных показателей
//
// Параметры:
//  ИдентификаторСеанса	 - УникальныйИдентификатор - Отбор по уникальному идентификатору
//  НомерТранзакции		 - Число - Отбор по номеру транзакции 
//
Процедура ОчиститьЛогИзмененныхПоказателей(ИдентификаторСеанса = Неопределено, НомерТранзакции = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетов.СоздатьНаборЗаписей();
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		НаборЗаписей.Отбор.УникальныйИдентификаторСеанса.Установить(ИдентификаторСеанса);
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерТранзакции) Тогда
		НаборЗаписей.Отбор.НомерТранзакции.Установить(НомерТранзакции);		
	КонецЕсли;	
	НаборЗаписей.Записать(Истина);
	
	НаборЗаписей = РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетовНечисловые.СоздатьНаборЗаписей();
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		НаборЗаписей.Отбор.УникальныйИдентификаторСеанса.Установить(ИдентификаторСеанса);		
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерТранзакции) Тогда
		НаборЗаписей.Отбор.НомерТранзакции.Установить(НомерТранзакции);		
	КонецЕсли;
	НаборЗаписей.Записать(Истина); 
	
	НаборЗаписей = РегистрыСведений.ЛогИзмененныхКомментариевПоказателейОтчетов.СоздатьНаборЗаписей();
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		НаборЗаписей.Отбор.УникальныйИдентификаторСеанса.Установить(ИдентификаторСеанса);		
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерТранзакции) Тогда
		НаборЗаписей.Отбор.НомерТранзакции.Установить(НомерТранзакции);		
	КонецЕсли;
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Функция - Проверяет наличие записей в логе измененных показателей
//
// Параметры:
//  ИдентификаторСеанса	 - Строка, УникальныйИдентификатор - Отбор по уникальному идентификатору
// 
// Возвращаемое значение:
//   Булево - Истина, если есть данные в логе измененных показателей
//
Функция ЕстьДанныеВЛогеИзмененныхПоказателей(Знач ИдентификаторСеанса = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		Возврат Ложь;	
	ИначеЕсли ТипЗнч(ИдентификаторСеанса) = Тип("Строка") Тогда
		ИдентификаторСеанса = Новый УникальныйИдентификатор(ИдентификаторСеанса);		
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗначенияПоказателей.НомерЗаписи КАК НомерЗаписи
		|ИЗ
		|	РегистрСведений.ЛогИзмененныхЗначенийПоказателейОтчетов КАК ЗначенияПоказателей
		|ГДЕ
		|	ЗначенияПоказателей.УникальныйИдентификаторСеанса = &УникальныйИдентификаторСеанса
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗначенияПоказателей.НомерЗаписи
		|ИЗ
		|	РегистрСведений.ЛогИзмененныхЗначенийПоказателейОтчетовНечисловые КАК ЗначенияПоказателей
		|ГДЕ
		|	ЗначенияПоказателей.УникальныйИдентификаторСеанса = &УникальныйИдентификаторСеанса";
	
	Запрос.УстановитьПараметр("УникальныйИдентификаторСеанса", ИдентификаторСеанса);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

