#Область СлужебныйПрограммныйИнтерфейс

// Процедура - При встриваниеии внутри процедуры может быть переопределена структура источника для проверки
//
// Параметры:
//  Проверка			 - Структура	 - Описание проверки
//  СтруктураИсточник	 - Структура	 - Описание источника для проверки
//
Процедура СтруктураИсточник(Проверка, СтруктураИсточник) Экспорт
	
	Если Проверка.ВидКонтроля = ПланыВидовХарактеристик.ВидыКонтроляДокументов.КонтрольРасходовПоДоговору Тогда
		СтруктураИсточник.ДанныеДляПроверки.Колонки.Добавить("ОбъектРасчетов", Новый ОписаниеТипов("СправочникСсылка.ОбъектыРасчетов"));
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает запрос для получения исполнения по контрагенту по роли Поставщик
Функция ТекстЗапроса_ТекущаяЗадолженностьКонтрагентаПоЕгоРоли() Экспорт
	
	#Область УХ
	Возврат 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.РолиКонтрагентов.Поставщики) КАК РольКонтрагента,
	|	ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.СПоставщиком) КАК ВидДоговораУХ,
	|	1 КАК Коффициент
	|ПОМЕСТИТЬ ВТ_РолиВидыДоговоров
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.РолиКонтрагентов.Покупатели),
	|	ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.СПокупателем),
	|	-1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыСПоставщикамиПоСрокамОстатки.Контрагент КАК Контрагент,
	|	РасчетыСПоставщикамиПоСрокамОстатки.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	РасчетыСПоставщикамиПоСрокамОстатки.СуммаОстаток * ВТ_РолиВидыДоговоров.Коффициент КАК ЗадолженностьТекущая,
	|	РасчетыСПоставщикамиПоСрокамОстатки.Валюта КАК Валюта,
	|	ВалютаУправленческогоУчета.Значение КАК ВалютаУпручета
	|ПОМЕСТИТЬ ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов
	|ИЗ
	|	Константа.ВалютаУправленческогоУчета КАК ВалютаУправленческогоУчета,
	|	ВТ_РолиВидыДоговоров КАК ВТ_РолиВидыДоговоров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКонтрагентамиФакт.Остатки(
	|				,
	|				Контрагент = &Контрагент
	|					И ДоговорКонтрагента.ВидДоговораУХ В
	|						(ВЫБРАТЬ
	|							ВТ_РолиВидыДоговоров.ВидДоговораУХ КАК ВидДоговораУХ
	|						ИЗ
	|							ВТ_РолиВидыДоговоров КАК ВТ_РолиВидыДоговоров
	|						ГДЕ
	|							ВТ_РолиВидыДоговоров.РольКонтрагента = &РольКонтрагента)) КАК РасчетыСПоставщикамиПоСрокамОстатки
	|		ПО (ВТ_РолиВидыДоговоров.РольКонтрагента = &РольКонтрагента)
	|			И ВТ_РолиВидыДоговоров.ВидДоговораУХ = РасчетыСПоставщикамиПоСрокамОстатки.ДоговорКонтрагента.ВидДоговораУХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов.Контрагент КАК Контрагент,
	|	ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов.ВалютаУпручета КАК ВалютаУпручета,
	|	СУММА(ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов.ЗадолженностьТекущая * ВТ_КоэффициентыПересчета.Коэффициент) КАК ЗадолженностьТекущая
	|ПОМЕСТИТЬ ВТ_ЗадолженностьКонтрагента
	|ИЗ
	|	ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов КАК ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоэффициентыПересчета КАК ВТ_КоэффициентыПересчета
	|		ПО ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов.Валюта = ВТ_КоэффициентыПересчета.ВалютаВзаиморасчетов
	|			И ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов.ВалютаУпручета = ВТ_КоэффициентыПересчета.ВалютаУпрУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов.Контрагент,
	|	ВТ_ЗадолженностьКонтрагентаВВалютеВзаиморасчетов.ВалютаУпручета";
	
	#КонецОбласти 
	
КонецФункции

// Функция возвращает текст запроса для получения исполнения по договору
Функция ТекстЗапроса_ИсполнениеПоДоговору() Экспорт
	
	Возврат 
	"ВЫБРАТЬ
	|	РасчетыСКонтрагентамиФактОбороты.Организация КАК Организация,
	|	РасчетыСКонтрагентамиФактОбороты.Контрагент КАК Контрагент,
	|	РасчетыСКонтрагентамиФактОбороты.ДоговорКонтрагента КАК Договор,
	|	РасчетыСКонтрагентамиФактОбороты.Валюта КАК Валюта,
	|	СУММА(ВЫБОР
	|			КОГДА &Оплата = ИСТИНА
	|				ТОГДА РасчетыСКонтрагентамиФактОбороты.СуммаПриход
	|			ИНАЧЕ РасчетыСКонтрагентамиФактОбороты.СуммаРасход
	|		КОНЕЦ) КАК Исполнено
	|ПОМЕСТИТЬ ВТ_Исполнено
	|ИЗ
	|	РегистрНакопления.РасчетыСКонтрагентамиФакт.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Организация = &Организация
	|				И Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &Договор) КАК РасчетыСКонтрагентамиФактОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыСКонтрагентамиФактОбороты.Организация,
	|	РасчетыСКонтрагентамиФактОбороты.Контрагент,
	|	РасчетыСКонтрагентамиФактОбороты.ДоговорКонтрагента,
	|	РасчетыСКонтрагентамиФактОбороты.Валюта";
	
КонецФункции

// Возвращает массив типов ДокументСсылка, для которых не надо формировать подключаемую команду КонтрольДокументов
Процедура ТипыДокументовИсключенияДляПодключаемойКоманды(Исключения) Экспорт
	
	Исключения.Добавить(Тип("ДокументСсылка.ВводОстатковВзаиморасчетовПоАренде"));
	Исключения.Добавить(Тип("ДокументСсылка.ЗаключениеДоговораАренды"));
	Исключения.Добавить(Тип("ДокументСсылка.ИзменениеУсловийДоговораАренды"));
	Исключения.Добавить(Тип("ДокументСсылка.ЗаявкаНаКомандировку"));     
	Исключения.Добавить(Тип("ДокументСсылка.АктВыполненныхРабот"));  
	Исключения.Добавить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));    
	Исключения.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг")); 
	Исключения.Добавить(Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов")); 
	Исключения.Добавить(Тип("ДокументСсылка.ЗаказКлиента")); 

	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		Исключения, РаботаСДоговорамиКонтрагентовУХ.ТипыВерсийСоглашений());
	
КонецПроцедуры

