
#Область ПрограммныйИнтерфейс

// Возвращает данные вида отчета
//
// Параметры:
//  ВидОтчета	 - СправочникСсылка.ВидыОтчетов - Ссылка на вид отчета
// 
// Возвращаемое значение:
//   - Структура - Структура с данными вида отчета
//
Функция ДанныеВидаОтчета(ВидОтчета) Экспорт
	
	ДанныеВидаОтчета = Новый Структура;
	ДанныеВидаОтчета.Вставить("ВидОтчета", Справочники.ВидыОтчетов.ПустаяСсылка());
	ДанныеВидаОтчета.Вставить("РазделениеПоПроектам", Ложь);
	ДанныеВидаОтчета.Вставить("СохранятьИсториюИзменений", Ложь);
	ДанныеВидаОтчета.Вставить("МаксКлючевыхАналитик", 0);
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ДанныеВидаОтчета.Вставить("ВидАналитики" + Сч, Неопределено);
		ДанныеВидаОтчета.Вставить("ТипЗначенияАналитики" + Сч, Неопределено);
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ВидОтчета) Тогда
		Возврат ДанныеВидаОтчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыОтчетов.Ссылка КАК ВидОтчета,
		|	ВидыОтчетов.РазделениеПоПроектам КАК РазделениеПоПроектам,
		|	ВидыОтчетов.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
		|	ВидыОтчетов.КоличествоАналитик КАК МаксКлючевыхАналитик,
		|	ВидыОтчетов.ВидАналитики1 КАК ВидАналитики1,
		|	ВидыОтчетов.ВидАналитики2 КАК ВидАналитики2,
		|	ВидыОтчетов.ВидАналитики3 КАК ВидАналитики3,
		|	ВидыОтчетов.ВидАналитики4 КАК ВидАналитики4,
		|	ВидыОтчетов.ВидАналитики5 КАК ВидАналитики5,
		|	ВидыОтчетов.ВидАналитики6 КАК ВидАналитики6,
		|	ВидыОтчетов.ВидАналитики1.ТипЗначения КАК ТипЗначенияАналитики1,
		|	ВидыОтчетов.ВидАналитики2.ТипЗначения КАК ТипЗначенияАналитики2,
		|	ВидыОтчетов.ВидАналитики3.ТипЗначения КАК ТипЗначенияАналитики3,
		|	ВидыОтчетов.ВидАналитики4.ТипЗначения КАК ТипЗначенияАналитики4,
		|	ВидыОтчетов.ВидАналитики5.ТипЗначения КАК ТипЗначенияАналитики5,
		|	ВидыОтчетов.ВидАналитики6.ТипЗначения КАК ТипЗначенияАналитики6
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	ВидыОтчетов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ВидОтчета);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеВидаОтчета, Выборка);
	КонецЕсли;
	
	Возврат ДанныеВидаОтчета;

КонецФункции

// Возращает документ УправлениеПериодомСценария по входным данным
//
// Параметры:
//  Сценарий - СправочникСсылка.Сценарии - Сценарий
//  Период	 - СправочникСсылка.Периоды - Период
// 
// Возвращаемое значение:
//   - Структура - Структура с данными
//
Функция НайтиУправлениеПериодомСценария(Сценарий, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументУправлениеПериодомСценария.Ссылка КАК УправлениеПериодом
		|ИЗ
		|	Документ.УправлениеПериодомСценария КАК ДокументУправлениеПериодомСценария
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Периоды КАК ПериодыСценарияНачало
		|		ПО ДокументУправлениеПериодомСценария.ПериодСценария = ПериодыСценарияНачало.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Периоды КАК ПериодыСценарияОкончание
		|		ПО ДокументУправлениеПериодомСценария.ПериодСценарияОкончание = ПериодыСценарияОкончание.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Периоды КАК Периоды
		|		ПО (ПериодыСценарияНачало.Периодичность = Периоды.Периодичность)
		|			И (ПериодыСценарияНачало.ДатаНачала <= Периоды.ДатаНачала)
		|			И (ПериодыСценарияОкончание.ДатаОкончания >= Периоды.ДатаОкончания)
		|ГДЕ
		|	ДокументУправлениеПериодомСценария.Сценарий = &Сценарий
		|	И Периоды.Ссылка = &Период";
			
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	Запрос.УстановитьПараметр("Период", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		УправлениеПериодом = Выборка.УправлениеПериодом;
	Иначе
		УправлениеПериодом = Неопределено;
	КонецЕсли;
	
	Возврат ДанныеУправленияПериодомСценария(УправлениеПериодом);
	
КонецФункции

// Возвращает данные управления периодом сценария
//
// Параметры:
//  УправлениеПериодом	 - ДокументСсылка.УправлениеПериодомСценария - Документ для которого собираются данные
// 
// Возвращаемое значение:
//   - Структура - Структура с данными
//
Функция ДанныеУправленияПериодомСценария(УправлениеПериодом) Экспорт
	
	СтруктураДанных = Новый Структура("УправлениеПериодом, ПериодЗакрыт, Сценарий, Периодичность, ПериодСценария, 
		|ДатаНачала, ПериодСценарияОкончание, ДатаОкончания,
		|ВерсияРегламента, ГруппаВидовОтчетов, ПересчитыватьЗависимыеПоказатели, 
		|ЗаполнятьПустыеАналитики, ШаблонПроцесса, ЗапрещатьДокументыВнеПроцесса");
	
	Если НЕ ЗначениеЗаполнено(УправлениеПериодом) Тогда
		Возврат СтруктураДанных;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументУправлениеПериодомСценария.Ссылка КАК УправлениеПериодом,
		|	ДокументУправлениеПериодомСценария.ПериодЗакрыт КАК ПериодЗакрыт,
		|	ДокументУправлениеПериодомСценария.Сценарий КАК Сценарий,
		|	ПериодыСценарияНачало.Периодичность КАК Периодичность,
		|	ПериодыСценарияНачало.Ссылка КАК ПериодСценария,
		|	ПериодыСценарияНачало.ДатаНачала КАК ДатаНачала,
		|	ПериодыСценарияОкончание.Ссылка КАК ПериодСценарияОкончание,
		|	ПериодыСценарияОкончание.ДатаОкончания КАК ДатаОкончания,
		|	ВерсииРегламентовПодготовкиОтчетности.Ссылка КАК ВерсияРегламента,
		|	ВерсииРегламентовПодготовкиОтчетности.ВидОтчета КАК ГруппаВидовОтчетов,
		|	ВерсииРегламентовПодготовкиОтчетности.АвтоматическиПересчитыватьЗависимыеПоказатели КАК ПересчитыватьЗависимыеПоказатели,
		|	ВерсииРегламентовПодготовкиОтчетности.ПодставлятьЗначенияАналитикПоУмолчанию КАК ЗаполнятьПустыеАналитики,
		|	ВерсииРегламентовПодготовкиОтчетности.ШаблонПроцесса КАК ШаблонПроцесса,
		|	ВерсииРегламентовПодготовкиОтчетности.ЗапрещатьДокументыВнеПроцесса КАК ЗапрещатьДокументыВнеПроцесса
		|ИЗ
		|	Документ.УправлениеПериодомСценария КАК ДокументУправлениеПериодомСценария
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Периоды КАК ПериодыСценарияНачало
		|		ПО ДокументУправлениеПериодомСценария.ПериодСценария = ПериодыСценарияНачало.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Периоды КАК ПериодыСценарияОкончание
		|		ПО ДокументУправлениеПериодомСценария.ПериодСценарияОкончание = ПериодыСценарияОкончание.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииРегламентовПодготовкиОтчетности
		|		ПО ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры = ВерсииРегламентовПодготовкиОтчетности.Ссылка
		|ГДЕ
		|	ДокументУправлениеПериодомСценария.Ссылка = &УправлениеПериодом";
			
	Запрос.УстановитьПараметр("УправлениеПериодом", УправлениеПериодом);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

// Возвращает таблицу с настройкам валют отчетности
//
// Параметры:
//  УправлениеПериодом	 - ДокументСсылка.УправлениеПериодомСценария - Управление периодом
//  Организация			 - СправочникСсылка.Организации - Организация
//  ВидОтчета			 - СправочникСсылка.ВидыОтчетов - Вид отчета
// 
// Возвращаемое значение:
//   - ТаблицаЗначений - Таблица с настройками валют отчетности
//
Функция ВалютыОтчетности(УправлениеПериодом, Организация, ВидОтчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВалютыОтчетностиСрезПоследних.ОсновнаяВалюта КАК ОсновнаяВалюта,
		|	ВалютыОтчетностиСрезПоследних.Валюта КАК Валюта,
		|	ВалютыОтчетностиСрезПоследних.Валюта.Представление КАК ВалютаПредставление
		|ИЗ
		|	РегистрСведений.ВалютыОтчетности.СрезПоследних(
		|			,
		|			Регламент В
		|					(ВЫБРАТЬ
		|						УправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры КАК ВерсияОрганизационнойСтруктуры
		|					ИЗ
		|						Документ.УправлениеПериодомСценария КАК УправлениеПериодомСценария
		|					ГДЕ
		|						УправлениеПериодомСценария.Ссылка = &УправлениеПериодом)
		|				И (ШаблонДокументаБД = &ШаблонДокументаБД
		|					ИЛИ ШаблонДокументаБД = НЕОПРЕДЕЛЕНО)
		|				И Организация = &Организация
		|				И Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютыОтчетностиСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОсновнаяВалюта УБЫВ,
		|	ВалютыОтчетностиСрезПоследних.Валюта.Код";
	
	Запрос.УстановитьПараметр("УправлениеПериодом",	УправлениеПериодом);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ШаблонДокументаБД",	ВидОтчета);
		
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Данные документа по справочнику "ДокументыБД"
//
// Параметры:
//  ИмяОбъектаМетаданного	 - Строка - Имя документа метаданных
// 
// Возвращаемое значение:
//   - Структура - Структура с данными документа
//
Функция ДанныеДокументаБД(ИмяОбъектаМетаданного) Экспорт

	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Ссылка", Неопределено);
	СтруктураДанных.Вставить("ИспользуетсяВПроцессе", Ложь);
	СтруктураДанных.Вставить("ИспользоватьШаблоны", Ложь);
	СтруктураДанных.Вставить("РеквизитШаблонаДокумента", "");
	СтруктураДанных.Вставить("РеквизитРазделенияПоОрганизациям", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументыБД.Ссылка КАК Ссылка,
		|	ДокументыБД.ИспользуетсяВПроцессе КАК ИспользуетсяВПроцессе,
		|	ДокументыБД.ИспользоватьШаблоны КАК ИспользоватьШаблоны,
		|	ДокументыБД.РеквизитШаблонаДокумента КАК РеквизитШаблонаДокумента,
		|	ДокументыБД.РеквизитРазделенияПоОрганизациям КАК РеквизитРазделенияПоОрганизациям,
		|	ДокументыБД.Согласуется КАК Согласуется
		|ИЗ
		|	Справочник.ДокументыБД КАК ДокументыБД
		|ГДЕ
		|	ДокументыБД.Наименование = &ИмяОбъектаМетаданного";
	
	Запрос.УстановитьПараметр("ИмяОбъектаМетаданного", ИмяОбъектаМетаданного);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
	КонецЦикла;
	
	Возврат СтруктураДанных;
	
КонецФункции

// Получает данные параметрической настройки расширенный
//
// Параметры:
//  ИсточникПараметрическойНастройки - СправочникСсылка.ПравилаОбработки - Правило обработки по 
//		которому построена параметрическая настройка
//  ТипПараметрическойНастройки		 - ПеречислениеСсылка.ТипПараметрическойНастройки - Тип настройки
//  ДатаАктуальности				 - Дата - Дата актуальности параметрической настройки
// 
// Возвращаемое значение:
//  Структура - Параметрическая настройка для расчета показателей
//
Функция ПолучитьДанныеПараметрическойНастройкиРасширенный(ИсточникПараметрическойНастройки, ТипПараметрическойНастройки, ДатаАктуальности) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ХранилищаПараметрическойНастройкиРасширенный.ДанныеПараметрическойНастройки
		|ИЗ
		|	РегистрСведений.ХранилищаПараметрическойНастройкиРасширенный КАК ХранилищаПараметрическойНастройкиРасширенный
		|ГДЕ
		|	ХранилищаПараметрическойНастройкиРасширенный.ИсточникПараметрическойНастройки = &ИсточникПараметрическойНастройки
		|	И ХранилищаПараметрическойНастройкиРасширенный.ТипПараметрическойНастройки = &ТипПараметрическойНастройки";
	
	Запрос.УстановитьПараметр("ИсточникПараметрическойНастройки", ИсточникПараметрическойНастройки);
	Запрос.УстановитьПараметр("ТипПараметрическойНастройки", ТипПараметрическойНастройки);
	
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	Возврат Результат.ДанныеПараметрическойНастройки.Получить();
	
КонецФункции

#КонецОбласти

