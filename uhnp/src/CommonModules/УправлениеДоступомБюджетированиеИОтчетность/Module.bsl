
#Область СлужебныйПрограммныйИнтерфейс

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Справочники.ВерсииЗначенийПоказателей, Истина);
	Списки.Вставить(Метаданные.Справочники.ОписаниеВерсий, Истина);
	Списки.Вставить(Метаданные.Справочники.ХранимыеФайлыОрганизаций, Истина);
	
	Списки.Вставить(Метаданные.Документы.КорректировкаЗначенийПоказателей, Истина);
	Списки.Вставить(Метаданные.Документы.НастраиваемыйОтчет, Истина);
	Списки.Вставить(Метаданные.Документы.РакурсДанных, Истина);

КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных.
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание = Описание + "
	|Справочник.ВерсииЗначенийПоказателей.Чтение.Организации
	|Справочник.ОписаниеВерсий.Чтение.Организации
	|Справочник.ХранимыеФайлыОрганизаций.Чтение.Организации
	
	|Документ.КорректировкаЗначенийПоказателей.Чтение.Организации
	|Документ.КорректировкаЗначенийПоказателей.Изменение.Организации
	|Документ.НастраиваемыйОтчет.Чтение.Организации
	|Документ.НастраиваемыйОтчет.Изменение.Организации
	|Документ.РакурсДанных.Чтение.Организации
	|Документ.РакурсДанных.Изменение.Организации
	|";
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииПоставляемыхПрофилейГруппДоступа.
Процедура ПриЗаполненииПоставляемыхПрофилейГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт
	
	ДобавитьОписаниеПапкиПрофиля_БюджетированиеИОтчетность(ОписанияПрофилей, ПараметрыОбновления);
	ДобавитьОписаниеПрофиля_РаботаСНастраиваемойОтчетностью(ОписанияПрофилей, ПараметрыОбновления);
	ДобавитьОписаниеПрофиля_ПросмотрНастраиваемойОтчетности(ОписанияПрофилей, ПараметрыОбновления);
	
КонецПроцедуры
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьОписаниеПапкиПрофиля_БюджетированиеИОтчетность(ОписанияПрофилей, ПараметрыОбновления)
	
	ОписаниеПапки = УправлениеДоступом.НовоеОписаниеПапкиПрофилейГруппДоступа();
	ОписаниеПапки.Имя			= "БюджетированиеИОтчетность";
	ОписаниеПапки.Идентификатор	= "7b8b5ed6-94ac-46a8-aace-69b5b68a849b";
	ОписаниеПапки.Наименование	= НСтр("ru = 'Бюджетирование и отчетность'");
	
	ОписанияПрофилей.Добавить(ОписаниеПапки);
	
КонецПроцедуры

Процедура ДобавитьОписаниеПрофиля_РаботаСНастраиваемойОтчетностью(ОписанияПрофилей, ПараметрыОбновления)
	
	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Идентификатор = "c0cb16f1-6b8f-4e41-a1a4-a0de4aa48c86";
	ОписаниеПрофиля.Родитель = "БюджетированиеИОтчетность";
	
	ОписаниеПрофиля.Наименование = НСтр("ru = 'Работа с настраиваемой отчетностью (экземпляры отчетов, корректировки, сводная таблица)'");
	
	ОписаниеПрофиля.Описание = НСтр("ru = 'Раздельный доступ к работе с данными настраиваемой отчетности в разрезе видов отчетов, бланков отчетов, бланков сводных таблиц,
		|пользователей и организационных единиц.'");
	
	УправлениеДоступомБМ.ДобавитьБазовыеРолиБПУХ(ОписаниеПрофиля);
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы") Тогда
		ОписаниеПрофиля.Роли.Добавить("БазовыеПраваЗарплатаКадры");
	КонецЕсли;
	
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваБюджетированиеИОтчетность");
	ОписаниеПрофиля.Роли.Добавить("ДобавлениеИзменениеБюджетированиеИОтчетность");
	ОписаниеПрофиля.Роли.Добавить("НастройкаОбработкиШаблоновДокументов");
	
	ДобавитьРолиНаЧтениеАналитикНастраиваемойОтчетности(ОписаниеПрофиля);
	
	ОписаниеПрофиля.ВидыДоступа.Добавить("Организации");
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);
		
КонецПроцедуры

Процедура ДобавитьОписаниеПрофиля_ПросмотрНастраиваемойОтчетности(ОписанияПрофилей, ПараметрыОбновления)
	
	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Идентификатор = "33d9f74d-529c-4c37-a654-1eb0f7745716";
	ОписаниеПрофиля.Родитель = "БюджетированиеИОтчетность";
	
	ОписаниеПрофиля.Наименование = НСтр("ru = 'Просмотр настраиваемой отчетности (экземпляры отчетов, корректировки, сводная таблица)'");
	
	ОписаниеПрофиля.Описание = НСтр("ru = 'Просмотр настраиваемой отчетности в разрезе видов отчетов, бланков отчетов, бланков сводных таблиц,
		|пользователей и организационных единиц.'");
	
	УправлениеДоступомБМ.ДобавитьБазовыеРолиБПУХ(ОписаниеПрофиля);
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы") Тогда
		ОписаниеПрофиля.Роли.Добавить("БазовыеПраваЗарплатаКадры");
	КонецЕсли;
	
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваБюджетированиеИОтчетность");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеБюджетированиеИОтчетность");
	
	ДобавитьРолиНаЧтениеАналитикНастраиваемойОтчетности(ОписаниеПрофиля);
	
	ОписаниеПрофиля.ВидыДоступа.Добавить("Организации");
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);
		
КонецПроцедуры

Процедура ДобавитьРолиНаЧтениеАналитикНастраиваемойОтчетности(ОписаниеПрофиля)
	
	// Роли для чтения данных некоторых аналитик
	ОписаниеПрофиля.Роли.Добавить("ЧтениеЦенНоменклатуры");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеСтатейДоходовИРасходов");
	
	Если ОбщегоНазначенияКлиентСерверУХ.ИмяКонфигурации() = "УправлениеХолдингомERP" Тогда
		// ERP УХ
		ОписаниеПрофиля.Роли.Добавить("ЧтениеОрганизацийИБанковскихСчетовОрганизаций");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеИнформацииПоПартнерам");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеДоговоровКонтрагентов");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеИнформацииПоНоменклатуре");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеНормативноСправочнойИнформации");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеФизическихЛиц");
	Иначе
		// УХ, Perform
		ОписаниеПрофиля.Роли.Добавить("ЧтениеБанковскихСчетов");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеКонтрагентов");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеНоменклатуры");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеОрганизаций");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеСпискаФизическихЛиц");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеСтатейДвиженияДенежныхСредств");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

