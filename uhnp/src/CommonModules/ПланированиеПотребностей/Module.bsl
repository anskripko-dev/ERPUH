		|			И Коллекция.Характеристика = АналитикаПланированияНоменклатуры.Характеристика
		|			И Коллекция.ЕдиницаИзмерения = АналитикаПланированияНоменклатуры.ЕдиницаИзмерения
		|			И Коллекция.Коэффициент = АналитикаПланированияНоменклатуры.Коэффициент
		|			И (АналитикаПланированияНоменклатуры.ИсходнаяНоменклатура = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка))
		|ГДЕ
		|	АналитикаПланированияНоменклатуры.КлючАналитики ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	Коллекция.Номенклатура,
		|	Коллекция.Характеристика,
		|	Коллекция.ЕдиницаИзмерения,
		|	Коллекция.Коэффициент";
		ВыполнитьКлючеваниеНоменклатуры(Запрос.Выполнить());
		
	КонецЕсли;
	
	
	ИзменениеПоставки = ПараметрыПланирования.Свойство("ИзменениеПоставки") И ПараметрыПланирования.ИзменениеПоставки = Истина;
	Если ИзменениеПоставки Тогда
		//
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Коллекция.Склад КАК Склад,
		|	Коллекция.СтавкаНДС КАК СтавкаНДС,
		|	Коллекция.СтранаПроисхождения КАК СтранаПроисхождения,
		|	Коллекция.СтранаПроизводителя КАК СтранаПроизводителя,
		|	Коллекция.Поставщик КАК Поставщик,
		|	Коллекция.НоменклатураПоставщика КАК НоменклатураПоставщика,
		|	МИНИМУМ(Коллекция.НомерСтроки) КАК НомерСтроки,
		|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПоставки.ПустаяСсылка) КАК АналитикаПоставки
		|ИЗ
		|	ВТ_ПланыДокументаДляОбработки КАК Коллекция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПоставки КАК АналитикаПланированияПоставки
		|		ПО Коллекция.Склад = АналитикаПланированияПоставки.Склад
		|			И Коллекция.СтавкаНДС = АналитикаПланированияПоставки.СтавкаНДС
		|			И Коллекция.СтранаПроисхождения = АналитикаПланированияПоставки.СтранаПроисхождения
		|			И Коллекция.СтранаПроизводителя = АналитикаПланированияПоставки.СтранаПроизводителя
		|			И Коллекция.Поставщик = АналитикаПланированияПоставки.Поставщик
		|			И Коллекция.НоменклатураПоставщика = АналитикаПланированияПоставки.НоменклатураПоставщика
		|ГДЕ
		|	АналитикаПланированияПоставки.КлючАналитики ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	Коллекция.Склад,
		|	Коллекция.СтавкаНДС,
		|	Коллекция.СтранаПроисхождения,
		|	Коллекция.СтранаПроизводителя,
		|	Коллекция.Поставщик,
		|	Коллекция.НоменклатураПоставщика";
		ВыполнитьКлючеваниеПоставки(Запрос.Выполнить());
		
	КонецЕсли;
	
	ИзменениеПотребностей = ПараметрыПланирования.Свойство("ИзменениеПотребностей") И ПараметрыПланирования.ИзменениеПотребностей = Истина;
	
	Если ИзменениеПотребностей Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Коллекция.МестоПоставки КАК МестоПоставки,
		|	Коллекция.Приоритет КАК Приоритет,
		|	Коллекция.Менеджер КАК Менеджер,
		|	Коллекция.Назначение КАК Назначение,
		|	МИНИМУМ(Коллекция.НомерСтроки) КАК НомерСтроки,
		|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка) КАК АналитикаПотребностей
		|ИЗ
		|	ВТ_ПланыДокументаДляОбработки КАК Коллекция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПотребностей КАК АналитикаПланированияПотребностей
		|		ПО Коллекция.МестоПоставки = АналитикаПланированияПотребностей.МестоПоставки
		|			И Коллекция.Приоритет = АналитикаПланированияПотребностей.Приоритет
		|			И Коллекция.Менеджер = АналитикаПланированияПотребностей.Менеджер
		|			И Коллекция.Назначение = АналитикаПланированияПотребностей.Назначение
		|ГДЕ
		|	АналитикаПланированияПотребностей.КлючАналитики ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	Коллекция.МестоПоставки,
		|	Коллекция.Приоритет,
		|	Коллекция.Менеджер,
		|	Коллекция.Назначение";
		
		ВыполнитьКлючеваниеПотребностей(Запрос.Выполнить());

	КонецЕсли;
	
	Если ПараметрыПланирования.ИзменениеПартнера Тогда
		//Запрос.Текст = ТекстЗапроса_КлючеваниеВзаиморасчетов("ВТ_ПланыДокументаДляОбработки");
		
		Запросы = Новый Массив;
		
		Запросы.Добавить( 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Коллекция.Организация КАК Организация,
		|	Коллекция.Контрагент КАК Контрагент,
		|	Коллекция.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Коллекция.ОбъектРасчетов КАК ОбъектРасчетов
		|ИЗ
		|	ВТ_ПланыДокументаДляОбработки КАК Коллекция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияРасчетовСКонтрагентами КАК АналитикаПланированияРасчетовСКонтрагентами
		|		ПО Коллекция.Организация = АналитикаПланированияРасчетовСКонтрагентами.Организация
		|			И Коллекция.Контрагент = АналитикаПланированияРасчетовСКонтрагентами.Контрагент
		|			И Коллекция.ДоговорКонтрагента = АналитикаПланированияРасчетовСКонтрагентами.Договор
		|			И Коллекция.ОбъектРасчетов = АналитикаПланированияРасчетовСКонтрагентами.ОбъектРасчетов
		|ГДЕ
		|	Коллекция.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)");

		Запросы.Добавить( 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Коллекция.ОрганизацияПредыдущегоЭтапа КАК Организация,
		|	Коллекция.КонтрагентПредыдущегоЭтапа КАК Контрагент,
		|	Коллекция.ДоговорКонтрагентаПредыдущегоЭтапа КАК ДоговорКонтрагента,
		|	Коллекция.ОбъектРасчетовПредыдущегоЭтапа КАК ОбъектРасчетов
		|ИЗ
		|	ВТ_ПланыДокументаДляОбработки КАК Коллекция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияРасчетовСКонтрагентами КАК АналитикаПланированияРасчетовСКонтрагентами
		|		ПО Коллекция.ОрганизацияПредыдущегоЭтапа = АналитикаПланированияРасчетовСКонтрагентами.Организация
		|			И Коллекция.КонтрагентПредыдущегоЭтапа = АналитикаПланированияРасчетовСКонтрагентами.Контрагент
		|			И Коллекция.ДоговорКонтрагентаПредыдущегоЭтапа = АналитикаПланированияРасчетовСКонтрагентами.Договор
		|			И Коллекция.ОбъектРасчетовПредыдущегоЭтапа = АналитикаПланированияРасчетовСКонтрагентами.ОбъектРасчетов
		|ГДЕ
		|	Коллекция.КонтрагентПредыдущегоЭтапа <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)");
		
		ТекстВложенногоЗапроса = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстОбъединитьВсеЗапроса());
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	0 КАК НомерСтроки,
		|	Коллекция.Организация КАК Организация,
		|	Коллекция.Контрагент КАК Контрагент,
		|	Коллекция.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Коллекция.ОбъектРасчетов КАК ОбъектРасчетов,
		|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияРасчетовСКонтрагентами.ПустаяСсылка) КАК АналитикаПартнеров
		|ИЗ
		|	ВТ_АналитикиПарнеров КАК Коллекция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияРасчетовСКонтрагентами КАК АналитикаПланированияРасчетовСКонтрагентами
		|		ПО Коллекция.Организация = АналитикаПланированияРасчетовСКонтрагентами.Организация
		|			И Коллекция.Контрагент = АналитикаПланированияРасчетовСКонтрагентами.Контрагент
		|			И Коллекция.ДоговорКонтрагента = АналитикаПланированияРасчетовСКонтрагентами.Договор
		|			И Коллекция.ОбъектРасчетов = АналитикаПланированияРасчетовСКонтрагентами.ОбъектРасчетов
		|ГДЕ
		|	АналитикаПланированияРасчетовСКонтрагентами.КлючАналитики ЕСТЬ NULL";

		ТекстДляЗамены = "ВТ_АналитикиПарнеров";
		ТекстЗамены = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстОбъединитьВсеЗапроса());
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, ТекстДляЗамены, "("+ТекстЗамены+")");
		
		ВыполнитьКлючеваниеВзаиморасчетов(Запрос.Выполнить());
	КонецЕсли;
	
	// 6. Пересоединиться
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Коллекция.НомерСтроки КАК НомерСтроки,
	|	Коллекция.АналитикаИсточника КАК АналитикаИсточника,
	|	Коллекция.АналитикаПредыдущегоЭтапа КАК АналитикаПредыдущегоЭтапа,
	|	Коллекция.Этап КАК Этап,
	|	Коллекция.ОбъектПланирования КАК ОбъектПланирования,
	|	Коллекция.УсловиеОплаты КАК УсловиеОплаты,
	|	Коллекция.АналитикаПредыдущегоЭтапа.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	Коллекция.АналитикаПредыдущегоЭтапа.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	Коллекция.АналитикаПредыдущегоЭтапа.АналитикаПотребностей КАК АналитикаПотребностей,  
	|	ISNULL(Коллекция.АналитикаПредыдущегоЭтапа.АналитикаСтатейБюджетов, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтатейБюджетов.ПустаяСсылка)) КАК АналитикаСтатейБюджетов,
	|	Коллекция.АналитикаПредыдущегоЭтапа.АналитикаПоставки КАК АналитикаПоставки,            	
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияРасчетовСКонтрагентами.ПустаяСсылка) КАК АналитикаПартнеров,
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияРасчетовСКонтрагентами.ПустаяСсылка) КАК АналитикаПартнеровПредыдущегоЭтапа,
	|	НАЧАЛОПЕРИОДА(Коллекция.ДатаОперации, ДЕНЬ) КАК ДатаОперации,
	|	Коллекция.Валюта КАК Валюта,      
	|	ISNULL(АналитикаПланированияСтатейБюджетовПоставки.КлючАналитики, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтатейБюджетовПоставки.ПустаяСсылка)) КАК АналитикаСтатейБюджетовПоставки,
	|	Коллекция.Количество КАК Количество,
	|	Коллекция.Сумма КАК Сумма, 
	|	Коллекция.СуммаПоПотребности КАК СуммаПоПотребности,
	|	Коллекция.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДляОбработки2
	|ИЗ
	|	ВТ_ПланыДокументаДляОбработки КАК Коллекция";
	Если ИзменениеНоменклатуры Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Коллекция.АналитикаПредыдущегоЭтапа.АналитикаНоменклатуры", 
			"ЕСТЬNULL(АналитикаПланированияНоменклатуры.КлючАналитики, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка))");
		ТекстЗапроса = ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияНоменклатуры КАК АналитикаПланированияНоменклатуры
		|		ПО Коллекция.Номенклатура = АналитикаПланированияНоменклатуры.Номенклатура
		|			И Коллекция.Характеристика = АналитикаПланированияНоменклатуры.Характеристика
		|			И Коллекция.ЕдиницаИзмерения = АналитикаПланированияНоменклатуры.ЕдиницаИзмерения
		|			И Коллекция.Коэффициент = АналитикаПланированияНоменклатуры.Коэффициент
		|			И (АналитикаПланированияНоменклатуры.ИсходнаяНоменклатура = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка))";
	КонецЕсли;
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокументаДляОбработки")<>Неопределено И
		Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокументаДляОбработки").Колонки.Найти("СтатьяБюджета") <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов
		|	ПО Коллекция.СтатьяБюджета = АналитикаПланированияСтатейБюджетов.СтатьяБюджета


		|	И ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) = АналитикаПланированияСтатейБюджетов.ПриходРасход
		|	И Коллекция.Аналитика1 = АналитикаПланированияСтатейБюджетов.Аналитика1
		|	И Коллекция.Аналитика2 = АналитикаПланированияСтатейБюджетов.Аналитика2
		|	И Коллекция.Аналитика3 = АналитикаПланированияСтатейБюджетов.Аналитика3
		|	И Коллекция.Аналитика4 = АналитикаПланированияСтатейБюджетов.Аналитика4
		|	И Коллекция.Аналитика5 = АналитикаПланированияСтатейБюджетов.Аналитика5
		|	И Коллекция.Аналитика6 = АналитикаПланированияСтатейБюджетов.Аналитика6
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетовПоставки КАК АналитикаПланированияСтатейБюджетовПоставки
		|	ПО Коллекция.СтатьяБюджетаПоставка = АналитикаПланированияСтатейБюджетовПоставки.СтатьяБюджета
		|	И ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) = АналитикаПланированияСтатейБюджетовПоставки.ПриходРасход
		|	И Коллекция.Аналитика1Поставка = АналитикаПланированияСтатейБюджетовПоставки.Аналитика1
		|	И Коллекция.Аналитика2Поставка = АналитикаПланированияСтатейБюджетовПоставки.Аналитика2
		|	И Коллекция.Аналитика3Поставка = АналитикаПланированияСтатейБюджетовПоставки.Аналитика3
		|	И Коллекция.Аналитика4Поставка = АналитикаПланированияСтатейБюджетовПоставки.Аналитика4
		|	И Коллекция.Аналитика5Поставка = АналитикаПланированияСтатейБюджетовПоставки.Аналитика5
		|	И Коллекция.Аналитика6Поставка = АналитикаПланированияСтатейБюджетовПоставки.Аналитика6";
		ТекстЗапроса = 	СтрЗаменить(ТекстЗапроса,"Коллекция.АналитикаПредыдущегоЭтапа.АналитикаСтатейБюджетов","АналитикаПланированияСтатейБюджетов.КлючАналитики");  
	КонецЕсли;

	Если ИзменениеПоставки Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Коллекция.АналитикаПредыдущегоЭтапа.АналитикаПоставки", 
			"ЕСТЬNULL(АналитикаПланированияПоставки.КлючАналитики, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПоставки.ПустаяСсылка))");
		ТекстЗапроса = ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПоставки КАК АналитикаПланированияПоставки
		|		ПО Коллекция.Склад = АналитикаПланированияПоставки.Склад
		|			И Коллекция.СтавкаНДС = АналитикаПланированияПоставки.СтавкаНДС
		|			И Коллекция.СтранаПроисхождения = АналитикаПланированияПоставки.СтранаПроисхождения
		|			И Коллекция.СтранаПроизводителя = АналитикаПланированияПоставки.СтранаПроизводителя
		|			И Коллекция.Поставщик = АналитикаПланированияПоставки.Поставщик
		|			И Коллекция.НоменклатураПоставщика = АналитикаПланированияПоставки.НоменклатураПоставщика";
	КонецЕсли;

	Если ИзменениеПотребностей Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Коллекция.АналитикаПредыдущегоЭтапа.АналитикаПотребностей", 
			"ЕСТЬNULL(АналитикаПланированияПотребностей.КлючАналитики, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка))");
		ТекстЗапроса = ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПотребностей КАК АналитикаПланированияПотребностей
		|		ПО Коллекция.МестоПоставки = АналитикаПланированияПотребностей.МестоПоставки
		|			И ((Коллекция.Приоритет = АналитикаПланированияПотребностей.Приоритет 
		|			И ЗНАЧЕНИЕ(Справочник.ПриоритетыПотребностей.ПустаяСсылка) <>  Коллекция.Приоритет) 
		|			ИЛИ (ЗНАЧЕНИЕ(Справочник.ПриоритетыПотребностей.Обычный) =  АналитикаПланированияПотребностей.Приоритет И 
