	|	ВТ_ПланыНовые.МестоПоставки КАК МестоПоставки,
	|	ВТ_ПланыНовые.Приоритет КАК Приоритет,
	|	ВТ_ПланыНовые.Менеджер КАК Менеджер,
	|	ВТ_ПланыНовые.Назначение КАК Назначение,
	|	ВТ_ПланыНовые.УсловиеОплаты КАК УсловиеОплаты,
	|	ВТ_ПланыНовые.Номенклатура КАК Номенклатура,
	|	ВТ_ПланыНовые.Характеристика КАК Характеристика,
	|	ВТ_ПланыНовые.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_ПланыНовые.Коэффициент КАК Коэффициент,
	|	ВТ_ПланыНовые.ДокументПланирования КАК ДокументПланирования,
	|	ВТ_ПланыНовые.Валюта КАК Валюта,
	|	ВТ_ПланыНовые.Сумма КАК Сумма,
	|	ВТ_ПланыНовые.Количество КАК Количество,
	|	ВТ_ПланыНовые.Задача КАК Задача,
	|	ВТ_ПланыНовые.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	ВТ_ИзмененияОбщаяТаблица КАК ВТ_ИзмененияОбщаяТаблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПланыНовые КАК ВТ_ПланыНовые
	|		ПО ВТ_ИзмененияОбщаяТаблица.ВидБюджета = ВТ_ПланыНовые.ВидБюджета
	|			И ВТ_ИзмененияОбщаяТаблица.ИдентификаторСтроки = ВТ_ПланыНовые.ИдентификаторСтроки
	|			И ВТ_ИзмененияОбщаяТаблица.Период = ВТ_ПланыНовые.Период
	|			И ВТ_ИзмененияОбщаяТаблица.ЦФО = ВТ_ПланыНовые.ЦФО
	|			И ВТ_ИзмененияОбщаяТаблица.Проект = ВТ_ПланыНовые.Проект
	|			И ВТ_ИзмененияОбщаяТаблица.Организация = ВТ_ПланыНовые.Организация
	|			И ВТ_ИзмененияОбщаяТаблица.СтатьяБюджета = ВТ_ПланыНовые.СтатьяБюджета
	|			И ВТ_ИзмененияОбщаяТаблица.Аналитика1 = ВТ_ПланыНовые.Аналитика1
	|			И ВТ_ИзмененияОбщаяТаблица.Аналитика2 = ВТ_ПланыНовые.Аналитика2
	|			И ВТ_ИзмененияОбщаяТаблица.Аналитика3 = ВТ_ПланыНовые.Аналитика3
	|			И ВТ_ИзмененияОбщаяТаблица.Аналитика4 = ВТ_ПланыНовые.Аналитика4
	|			И ВТ_ИзмененияОбщаяТаблица.Аналитика5 = ВТ_ПланыНовые.Аналитика5
	|			И ВТ_ИзмененияОбщаяТаблица.Аналитика6 = ВТ_ПланыНовые.Аналитика6
	|			И ВТ_ИзмененияОбщаяТаблица.ПриходРасход = ВТ_ПланыНовые.ПриходРасход
	|			И ВТ_ИзмененияОбщаяТаблица.МестоПоставки = ВТ_ПланыНовые.МестоПоставки
	|			И ВТ_ИзмененияОбщаяТаблица.Приоритет = ВТ_ПланыНовые.Приоритет
	|			И ВТ_ИзмененияОбщаяТаблица.Менеджер = ВТ_ПланыНовые.Менеджер
	|			И ВТ_ИзмененияОбщаяТаблица.Назначение = ВТ_ПланыНовые.Назначение
	|			И ВТ_ИзмененияОбщаяТаблица.УсловиеОплаты = ВТ_ПланыНовые.УсловиеОплаты
	|			И ВТ_ИзмененияОбщаяТаблица.Номенклатура = ВТ_ПланыНовые.Номенклатура
	|			И ВТ_ИзмененияОбщаяТаблица.Характеристика = ВТ_ПланыНовые.Характеристика
	|			И ВТ_ИзмененияОбщаяТаблица.ЕдиницаИзмерения = ВТ_ПланыНовые.ЕдиницаИзмерения
	|			И ВТ_ИзмененияОбщаяТаблица.Коэффициент = ВТ_ПланыНовые.Коэффициент
	|			И ВТ_ИзмененияОбщаяТаблица.ДокументПланирования = ВТ_ПланыНовые.ДокументПланирования
	|			И ВТ_ИзмененияОбщаяТаблица.Валюта = ВТ_ПланыНовые.Валюта
	|			И ВТ_ИзмененияОбщаяТаблица.Задача = ВТ_ПланыНовые.Задача
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задача,
	|	ДокументПланирования";
	
	//
	Результат = Запрос.ВыполнитьПакет();
	
	СписокЗадачДокументовПланирования = Результат[1].Выгрузить();
	ВсеПланыИсходные = Результат[2].Выгрузить();
	ВсеПланыНовые = Результат[3].Выгрузить();
	
	СтруктураПоиска = Новый Структура("Задача, ДокументПланирования");
	
	СформированныеПроцессы = Новый Массив;
	
	Для Каждого СтрокаЗадача Из СписокЗадачДокументовПланирования Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаЗадача);
		
		ПланыИсходные = ВсеПланыИсходные.Скопировать(СтруктураПоиска);
		ПланыНовые    = ВсеПланыНовые.Скопировать(СтруктураПоиска);
		
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("Предмет", 				СтрокаЗадача.ДокументПланирования);
		ДанныеЗаполнения.Вставить("ГлавнаяЗадача",			СтрокаЗадача.Задача);
		ДанныеЗаполнения.Вставить("ПланыДокументаИсходные",	ВсеПланыИсходные.Скопировать(СтруктураПоиска));
		ДанныеЗаполнения.Вставить("ПланыДокументаНовые",	ВсеПланыНовые.Скопировать(СтруктураПоиска));
		
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("БизнесПроцесс.КорректировкаЗаявкиНаЗакупку");		
		Процесс = Менеджер.СоздатьБизнесПроцесс();
		Процесс.Заполнить(ДанныеЗаполнения);
		СформированныеПроцессы.Добавить(Процесс);
		
	КонецЦикла;
	
	//
	Для Каждого Процесс Из СформированныеПроцессы Цикл
		Процесс.Записать();
		Процесс.Старт();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	//
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Истина);
	Результат.Вставить("ТекстСообщения", НСтр("ru = 'все ОК'"));
	
	Возврат Результат;
	
КонецФункции

// ПараметрыПотребностей - Возвращает параметры потребности (направление, ответственное ЦФО, товарная категория)
//
// Параметры:
//  Организация	 - СправочникСсылка.Организации	 - Организация потребностей
//  Потребности	 - Массив	 - Массив с номенклатурой/товарными категориями 
//  ИмяСвойства	 - Строка	 - ЦФО, ТоварнаяКатегория, ФункциональноеНаправление - строка с одним или несколькими свойствами потребностей разделенными запятыми
// 
// Возвращаемое значение:
//  Соответствие - Соответствие потребности и её параметров, при указании нескольких свойств в качестве значения
//                 используется структура
//
Функция ПараметрыПотребностей(Знач Организация, Знач Потребности, Знач ИмяСвойства, Знач ПараметрыЗапроса = Неопределено) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
		ЗначенияАдрессацииПоУмолчанию = ЗначенияАдрессацииПоУмолчанию(Организация);
	Иначе
		ЗначенияАдрессацииПоУмолчанию = Новый ТаблицаЗначений;
		ЗначенияАдрессацииПоУмолчанию.Колонки.Добавить("Организация");
		ЗначенияАдрессацииПоУмолчанию.Колонки.Добавить("ФункциональноеНаправление");
		ЗначенияАдрессацииПоУмолчанию.Колонки.Добавить("ЦФО");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Потребности
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&Потребности)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТоварныеКатегории.Ссылка
		|ИЗ
		|	Справочник.КатегорииЗакупок КАК ТоварныеКатегории
		|ГДЕ
		|	ТоварныеКатегории.Ссылка В(&Потребности)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Потребности.Ссылка КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА Потребности.Ссылка ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Потребности.Ссылка КАК Справочник.Номенклатура).КатегорияЗакупок, ЗНАЧЕНИЕ(Справочник.КатегорииЗакупок.ПустаяСсылка))
		|		ИНАЧЕ ВЫРАЗИТЬ(Потребности.Ссылка КАК Справочник.КатегорииЗакупок)
		|	КОНЕЦ КАК КатегорияЗакупок
		|ПОМЕСТИТЬ ВТ_НоменклатураИТК
		|ИЗ
		|	Потребности КАК Потребности
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииЗакупок КАК КатегорииЗакупок
		|		ПО Потребности.Ссылка = КатегорииЗакупок.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_НоменклатураИТК.Номенклатура КАК Номенклатура,
		|	ВТ_НоменклатураИТК.КатегорияЗакупок КАК КатегорияЗакупок,
		|	&ПолеЦФО,
		|	&ДополнительныеПоля,
		|	ЕСТЬNULL(ВТ_НоменклатураИТК.КатегорияЗакупок.ФункциональноеНаправление, ЗНАЧЕНИЕ(Справочник.ФункциональныеНаправления.ПустаяСсылка)) КАК ФункциональноеНаправление
		|ИЗ
		|	ВТ_НоменклатураИТК КАК ВТ_НоменклатураИТК" 
		// Для работы конструктора
		 + Символы.ПС +
		 "&ОтветственныеЗаФункциональныеНаправления"
		 + Символы.ПС +
		"&ДополнительныеИсточники"; 
		 
	Если Не ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ТоварныеКатегории", "Справочник.КатегорииЗакупок");  
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтветственныеЗаФункциональныеНаправления", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦФО,", "");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦФО,", "ЕСТЬNULL(ОтвественныеЗаФункциональныеНаправления.ЦФО,ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК ЦФО,");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтветственныеЗаФункциональныеНаправления", 
													"ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаФункциональныеНаправления КАК ОтвественныеЗаФункциональныеНаправления
													|		ПО ВТ_НоменклатураИТК.КатегорияЗакупок.ФункциональноеНаправление = ОтвественныеЗаФункциональныеНаправления.ФункциональноеНаправление
													|			И (ОтвественныеЗаФункциональныеНаправления.Организация = &Организация)");	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("Потребности", 		Потребности);  
	
	ДополнительныеПоля = Новый Массив;     
	ДополнительныеИсточники = Новый Массив;
	
	Если СтрНайти(ВРег(ИмяСвойства), "СТАТЬЯБЮДЖЕТА") >0 ИЛИ СтрНайти(ВРег(ИмяСвойства), "УСЛОВИЕОПЛАТЫ") >0 Тогда
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.СтатьяБюджета КАК СтатьяБюджета");  
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.Аналитика1 КАК Аналитика1");      
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.Аналитика2 КАК Аналитика2");
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.Аналитика3 КАК Аналитика3");
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.Аналитика4 КАК Аналитика4");
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.Аналитика5 КАК Аналитика5");
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.Аналитика6 КАК Аналитика6");
		ДополнительныеПоля.Добавить("ПараметрыСтатейПоУмолчанию.УсловиеОплаты КАК УсловиеОплаты");

		ДополнительныеИсточники.Добавить(  "		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатьиТоварныхКатегорий КАК ПараметрыСтатейПоУмолчанию
											|		ПО ВТ_НоменклатураИТК.КатегорияЗакупок = ПараметрыСтатейПоУмолчанию.ТоварнаяКатегория
											|		И ПараметрыСтатейПоУмолчанию.ВидБюджета = &ВидБюджета");
	КонецЕсли;   
	
	Если СтрНайти(ВРег(ИмяСвойства), ВРег("ПроводитьЭкспертизу")) >0 Тогда
		ДополнительныеПоля.Добавить("ISNULL(ВложенныйЗапросПроводитьЭкспертизу.ПроводитьЭкспертизу, ИСТИНА) КАК ПроводитьЭкспертизу");  

		ДополнительныеИсточники.Добавить(  "		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
											|			ПотребностиДокумента.КатегорияЗакупок КАК КатегорияЗакупок,
											|			ВЫБОР
											|				КОГДА ЭкспертизаПоВсемТК.Значение = ЛОЖЬ
											|					ТОГДА ЕСТЬNULL(НастройкиЭкспертизыТоварныхКатегорий.ПроводитьЭкспертизу, ЛОЖЬ)
											|				ИНАЧЕ ИСТИНА
											|			КОНЕЦ КАК ПроводитьЭкспертизу
											|		ИЗ
											|			ВТ_НоменклатураИТК КАК ПотребностиДокумента
											|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЭкспертизыТоварныхКатегорий КАК НастройкиЭкспертизыТоварныхКатегорий
											|				ПО ПотребностиДокумента.КатегорияЗакупок = НастройкиЭкспертизыТоварныхКатегорий.ТоварнаяКатегория
											|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.ЭкспертизаПоВсемТК КАК ЭкспертизаПоВсемТК
											|				ПО (ИСТИНА)) КАК ВложенныйЗапросПроводитьЭкспертизу
											|				ПО ВТ_НоменклатураИТК.КатегорияЗакупок = ВложенныйЗапросПроводитьЭкспертизу.ТоварнаяКатегория");
	КонецЕсли;
	
	Если ДополнительныеПоля.Количество() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительныеПоля,", 		СтрСоединить(ДополнительныеПоля, ", ") + ", ");   
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительныеПоля,", 		"");	
	КонецЕсли;                                                                                 
	Если ДополнительныеИсточники.Количество() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительныеИсточники", 	СтрСоединить(ДополнительныеИсточники, Символы.ПС)); 
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительныеИсточники", 	"");
	КонецЕсли; 
	
	Если ПараметрыЗапроса <> Неопределено Тогда  
		Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеЗапроса = РезультатЗапроса.Выгрузить();  
	ДанныеЗапроса.Индексы.Добавить("Номенклатура"); 
	
	Результат = Новый Соответствие;
	СтруктураПоиска = Новый Структура("ФункциональноеНаправление");  
	Свойства = СтрРазделить(ИмяСвойства, ", ", Ложь);
	
	Для Каждого Потребность Из Потребности Цикл  
		
		Параметры = ДанныеЗапроса.Найти(Потребность, "Номенклатура"); 
		
		Если Параметры = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
			Если Не ЗначениеЗаполнено(Параметры.ЦФО) И СтрНайти(ВРег(ИмяСвойства), "ЦФО")>0 Тогда   
				
				СтруктураПоиска.ФункциональноеНаправление = Параметры.ФункциональноеНаправление;
				Значения = ЗначенияАдрессацииПоУмолчанию.НайтиСтроки(СтруктураПоиска);
				Если Значения.Количество() Тогда
					Параметры.ЦФО = Значения[0].ЦФО;
				Иначе
					СтруктураПоиска.ФункциональноеНаправление = Справочники.ФункциональныеНаправления.ПустаяСсылка();
					Значения = ЗначенияАдрессацииПоУмолчанию.НайтиСтроки(СтруктураПоиска);
					Если Значения.Количество() Тогда
						Параметры.ЦФО = Значения[0].ЦФО;
					КонецЕсли;	
				КонецЕсли;
				
			КонецЕсли; 
		КонецЕсли;
		
		Если Свойства.Количество() = 1 Тогда
			Результат.Вставить(Потребность, Параметры[ИмяСвойства]);
		Иначе                               
			СвойстваПотребности = Новый Структура(ИмяСвойства);
			ЗаполнитьЗначенияСвойств(СвойстваПотребности, Параметры, ИмяСвойства);
			Результат.Вставить(Потребность, СвойстваПотребности);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции // ПараметрыПотребностей()    


// ПараметрыПотребности - Возвращает параметры потребности (направление, ответственное ЦФО, товарная категория)
//
// Параметры:
//  Организация	 - СправочникСсылка.Организации	 - Организация потребностей
//  Потребность	 - СправочникСсылка.Номенклатура, СправочникСсылка.ТоварныеКатегории	 - Массив с номенклатурой/товарными категориями 
//  ИмяСвойства	 - Строка	 - ЦФО, ТоварнаяКатегория, ФункциональноеНаправление - строка с одним или несколькими свойствами потребностей разделенными запятыми
// 
// Возвращаемое значение:
//  ЦФО, ТоварнаяКатегория, ФункциональноеНаправление - Параметры потребности, при указании нескольких свойств в
//                                                      качестве значения используется структура
//
Функция ПараметрыПотребности(Знач Организация, Знач Потребность, Знач ИмяСвойства, Знач ПараметрыЗапроса = Неопределено) Экспорт 
	
	Потребности = Новый Массив;
	Потребности.Добавить(Потребность);
	Результат = ПараметрыПотребностей(Организация, Потребности, ИмяСвойства, ПараметрыЗапроса);
	Возврат Результат[Потребность];
	
КонецФункции // ПараметрыПотребностей()    

Функция ДоступныеСтатьиПотребности(Потребность) Экспорт   
	
	ФункциональноеНаправление = ПараметрыПотребности(Неопределено, Потребность, "ФункциональноеНаправление");

	Результат = ДоступныеСтатьиФункциональногоНаправления(ФункциональноеНаправление);
	
	Возврат Результат;

КонецФункции

Функция ДоступныеСтатьиФункциональногоНаправления(Знач ФункциональноеНаправление) Экспорт 
	
	Перем Запрос, Результат, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатьиДоходовИРасходов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтатьиДоходовИРасходов КАК СтатьиДоходовИРасходов
	|ГДЕ
	|	СтатьиДоходовИРасходов.ФункциональноеНаправление = &ФункциональноеНаправление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьиДвиженияРесурсов.Ссылка
	|ИЗ
	|	Справочник.СтатьиДвиженияРесурсов КАК СтатьиДвиженияРесурсов
	|ГДЕ
	|	СтатьиДвиженияРесурсов.ФункциональноеНаправление = &ФункциональноеНаправление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	СтатьиДвиженияДенежныхСредств.ФункциональноеНаправление = &ФункциональноеНаправление";
	
	Запрос.УстановитьПараметр("ФункциональноеНаправление", ФункциональноеНаправление);
	
	РезультатЗапроса = Запрос.Выполнить();    
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Новый Массив;
	Иначе
		Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	Возврат Результат;

КонецФункции // ДоступныеСтатьиПотребности()

Процедура УстановитьДоступныеСтатьиЭлементаПоПараметруПотребностей(Форма, ИмяЭлемента, Параметр, ДоступныеСтатьи = Неопределено) Экспорт
	
	Если ТипЗнч(Параметр) = Тип("СправочникСсылка.ФункциональныеНаправления") Тогда    
		ФункциональноеНаправление = Параметр;
	Иначе              
		ФункциональноеНаправление = ПараметрыПотребности(Неопределено, Параметр, "ФункциональноеНаправление");
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(ФункциональноеНаправление) Тогда
		Форма.Элементы[ИмяЭлемента].ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);	
		Возврат;
	КонецЕсли;
	Статьи = ДоступныеСтатьиФункциональногоНаправления(ФункциональноеНаправление);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(Статьи));
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Форма.Элементы[ИмяЭлемента].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
	Если ДоступныеСтатьи <> Неопределено Тогда
		ДоступныеСтатьи = Статьи;
	КонецЕсли;

КонецПроцедуры // УстановитьДоступныеСтатьиЭлемента()

Функция СпособЗаполненияСтатьи() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ПравилоЗаполненияСтатьиБюджета.Получить();
	
