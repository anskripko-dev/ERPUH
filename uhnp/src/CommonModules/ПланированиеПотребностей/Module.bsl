// Функция - возвращает параметры для отражения заявок на закупку в бюджетах
// 
// Возвращаемое значение:
//  Структура - виды бюджетов и типы статей бюджетов, по которым производится планирование поставок
//
Функция ОтражениеВБюджетахПоставок(ДатаСреза) Экспорт
	
	ОтражениеВБюджетах = Новый Структура;
	ОтражениеВБюджетах.Вставить("ВидБюджета", 			ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	ОтражениеВБюджетах.Вставить("ВидБюджетаЗависимый", 	ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	ОтражениеВБюджетах.Вставить("ВидБюджетаТипСтатьи",  ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов.ТипЗначения);
	
	ВидБюджетаЗакупок = ИспользуемыеВидыБюджетовЗакупок(ДатаСреза);
	ОтражениеВБюджетах.Вставить("ВидБюджетаЗависимыйТипСтатьи", ?(ВидБюджетаЗакупок = Неопределено, Неопределено, ВидБюджетаЗакупок.ТипЗначения));
	ОтражениеВБюджетах.Вставить("ВидБюджетаЗакупок", ВидБюджетаЗакупок);	
	Возврат ОтражениеВБюджетах;  
	
КонецФункции
// 
Процедура СинхронизироватьПометкуУдаленияСвязанныхСЗаявкойОбъектов(Объект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Установить активность по документамм РегистраторВерсииПланаДокумента
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаявкаНаЗакупку", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПланированиеПотребностей.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	|ГДЕ
	|	ПланированиеПотребностей.КорректировкаДокумента = &ЗаявкаНаЗакупку
	|	И ПланированиеПотребностей.Регистратор ССЫЛКА Документ.РегистраторВерсииПланаДокумента";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Пометка = НЕ Объект.ПометкаУдаления;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыНакопления.ПланированиеПотребностей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		НаборЗаписей.УстановитьАктивность(Пометка);
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		НаборЗаписей.УстановитьАктивность(Пометка);
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.АналитикиБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		НаборЗаписей.УстановитьАктивность(Пометка);
		НаборЗаписей.Записать(Истина);
		
