		ПараметрыАналитик.Вставить("Аналитика3БДР", Неопределено);
		ПараметрыАналитик.Вставить("Аналитика4БДР", Неопределено);
		ПараметрыАналитик.Вставить("Аналитика5БДР", Неопределено);
		ПараметрыАналитик.Вставить("Аналитика6БДР", Неопределено);

		ПараметрыАналитик.Вставить("СтатьяБюджетаБДДС", Неопределено);
