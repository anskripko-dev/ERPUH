				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиБюджетов КАК АналитикиБюджетов
				|		ПО АналитикиПланирования.АналитикаИсточника = АналитикиБюджетов.АналитикаПланирования
				|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
				|		ПО (ВЫРАЗИТЬ(АналитикиПланирования.АналитикаПредыдущегоЭтапа КАК Справочник.КлючиАналитикПланирования).ОбъектПланирования.Объект = ВТ_ОтносительныеДниОплаты.Ссылка)
				|       И АналитикиПланирования.АналитикаПредыдущегоЭтапа.ДатаОперации = ВТ_ОтносительныеДниОплаты.ДатаПоступления");   
				КонецЕсли;				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Запросы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Запрос.ДатаОперации КАК Период,
	|	Запрос.ВидБюджета КАК ВидБюджета,
	|	Запрос.СтатьяБюджета КАК СтатьяБюджета,
	|	Запрос.Аналитика1 КАК Аналитика1,
	|	Запрос.Аналитика2 КАК Аналитика2,
	|	Запрос.Аналитика3 КАК Аналитика3,
	|	Запрос.Аналитика4 КАК Аналитика4,
	|	Запрос.Аналитика5 КАК Аналитика5,
	|	Запрос.Аналитика6 КАК Аналитика6,
	|	Запрос.ПриходРасход КАК ПриходРасход,
	|	Запрос.Организация КАК Организация,
	|	Запрос.ЦФО КАК ЦФО,
	|	Запрос.Проект КАК Проект,
	|	Запрос.ДатаОперации КАК ДатаОперации,
	|	Запрос.Валюта КАК Валюта,
	|	Запрос.ДокументПланирования КАК ДокументПланирования,
	|	Запрос.ДокументРезервирования КАК ДокументРезервирования,
	|	Запрос.Сумма КАК Сумма,
	|	Запрос.ТипСрока КАК ТипСрока,
	|	Запрос.День КАК День
	|ПОМЕСТИТЬ ВТ_СводныеДанные
	|ИЗ
	|	ВТ_Данные КАК Запрос";  	

	ТекстПодзапросов = СтрСоединить(Запросы, "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_Данные", "("+ТекстПодзапросов+")");
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();     
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Запрос.ДатаОперации КАК Период,
	|	Запрос.ВидБюджета КАК ВидБюджета,
	|	Запрос.СтатьяБюджета КАК СтатьяБюджета,
	|	Запрос.Аналитика1 КАК Аналитика1,
	|	Запрос.Аналитика2 КАК Аналитика2,
	|	Запрос.Аналитика3 КАК Аналитика3,
	|	Запрос.Аналитика4 КАК Аналитика4,
	|	Запрос.Аналитика5 КАК Аналитика5,
	|	Запрос.Аналитика6 КАК Аналитика6,
	|	Запрос.ПриходРасход КАК ПриходРасход,
	|	Запрос.Организация КАК Организация,
	|	Запрос.ЦФО КАК ЦФО,
	|	Запрос.Проект КАК Проект,
	|	Запрос.ДатаОперации КАК ДатаОперации,
	|	Запрос.Валюта КАК Валюта,
	|	Запрос.ДокументПланирования КАК ДокументПланирования,
	|	Запрос.ДокументРезервирования КАК ДокументРезервирования,
	|	СУММА(Запрос.Сумма) КАК Сумма,
	|	Запрос.ТипСрока КАК ТипСрока,
	|	Запрос.День КАК День
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	ВТ_СводныеДанные КАК Запрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.ДокументПланирования,
	|	Запрос.ДокументРезервирования,
	|	Запрос.ДатаОперации,
	|	Запрос.ВидБюджета,
	|	Запрос.СтатьяБюджета,
	|	Запрос.Аналитика1,
	|	Запрос.Аналитика2,
