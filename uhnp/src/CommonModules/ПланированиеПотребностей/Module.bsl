Процедура ПрименитьСпособыРасчетаКоличестваДнейВПериоде(Запрос, ПараметрыПланирования)

	ВТ_СводныеДанные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_СводныеДанные");     
	
	Если ВТ_СводныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСводныеДанные = ВТ_СводныеДанные.ПолучитьДанные().Выгрузить();  
	
	Если ТаблицаСводныеДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПроизводственныеКалендариЗаполнены = ПараметрыПланирования.Свойство("ПроизводственныеКалендари") 
										И Не ПараметрыПланирования.ПроизводственныеКалендари.Количество() = 0;
	
	ДлинаСуток = 86400;  
	Для Каждого СтрокаТаблицы Из ТаблицаСводныеДанные Цикл  
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаОперации) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.ТипСрока = Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням Тогда   		
			СтрокаТаблицы.ДатаОперации = СтрокаТаблицы.ДатаОперации + (ДлинаСуток * СтрокаТаблицы.День);   	
		ИначеЕсли СтрокаТаблицы.ТипСрока = Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоРабочимДням Тогда   			
			Если ПроизводственныеКалендариЗаполнены Тогда
				СтрокаТаблицы.ДатаОперации = КалендарныеГрафикиУХ.ПолучитьДатуПоКалендарю(
					ПараметрыПланирования.ПроизводственныеКалендари, СтрокаТаблицы.ДатаОперации, СтрокаТаблицы.День);    
			Иначе
				СтрокаТаблицы.ДатаОперации = СтрокаТаблицы.ДатаОперации + (ДлинаСуток * СтрокаТаблицы.День); 		
			КонецЕсли;
		КонецЕсли;   			
		
		СтрокаТаблицы.Период = СтрокаТаблицы.ДатаОперации;
		
	КонецЦикла; 
	
	ВТ_ПланыДокумента = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокумента");    
	
	ВременнаяТаблицаЗапроса = ?(ВТ_ПланыДокумента = Неопределено, "ВТ_СводныеДанные", "ВТ_ПланыДокумента");
	
	Запрос.Текст = "УНИЧТОЖИТЬ " + ВременнаяТаблицаЗапроса;
	Запрос.Выполнить();

	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, ВременнаяТаблицаЗапроса, ТаблицаСводныеДанные);    
                                            
КонецПроцедуры

Процедура ПолучитьПланыПоДокументуПланирования(ДокументПланирования, МенеджерВременныхТаблиц) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если Метаданные.ОпределяемыеТипы.ВерсияСоглашения.Тип.СодержитТип(ТипЗнч(ДокументПланирования)) Тогда
		Запрос.УстановитьПараметр("ДокументПланирования", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументПланирования, "ДоговорКонтрагента"));
	Иначе
		Запрос.УстановитьПараметр("ДокументПланирования", ДокументПланирования);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОперацииБюджетовОбороты.Период КАК Период,
	|	ОперацииБюджетовОбороты.Период КАК ДатаОперации,
	|	ОперацииБюджетовОбороты.ВидБюджета КАК ВидБюджета,
	|	ОперацииБюджетовОбороты.ОбъектПланирования.Объект КАК ДокументПланирования,
	|	ОперацииБюджетовОбороты.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	ОперацииБюджетовОбороты.АналитикаСтруктуры.Проект КАК Проект,
	|	ОперацииБюджетовОбороты.АналитикаСтруктуры.Организация КАК Организация,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|	ОперацииБюджетовОбороты.ПриходРасход КАК ПриходРасход,
	|	ОперацииБюджетовОбороты.Валюта КАК Валюта,
	|	ОперацииБюджетовОбороты.СуммаОборот КАК Сумма
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов.Обороты(
	|			,
	|			,
	|			День,
	|			ОбъектПланирования.Объект = &ДокументПланирования) КАК ОперацииБюджетовОбороты";
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Функция - Планы движения денежных средств возвращает план движения денежных средств для переданных планов поставки
//
// Параметры:
//  ПланыДокумента	 - ТаблицаЗначений	 - План поставок
// 
// Возвращаемое значение:
//  ТаблицаЗначений - План движения денежных средств
//
Функция ПланыДвиженияДенежныхСредств(ПланыДокумента) Экспорт
	
	Реквизиты = Новый Массив;
	
	ИменаРеквизитов = "ЦФО, Проект, Валюта, ДатаОперации, УсловиеОплаты, Сумма, СтатьяБюджета, "+АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
	ПланыДокументаРазвернутые = ПланыДокумента.Скопировать(, ИменаРеквизитов);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ПланыДокументаРазвернутые", ПланыДокументаРазвернутые); 
	
	Запросы = Новый Массив;
	
	Запросы.Добавить(ОперативноеПланированиеКонтроль.ТекстЗапроса_ГрафикОплатПоУсловиюОплаты());
	
	//
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	0 КАК НомерСтроки,
	|	Запрос.ВидБюджета КАК ВидБюджета,
	|	Запрос.ВидБюджета.Предназначение КАК Предназначение,
	|	Запрос.ЦФО КАК ЦФО,
	|	Запрос.Проект КАК Проект,
	|	Запрос.ДатаОперации КАК ДатаОперации,
	|	Запрос.СтатьяБюджета КАК СтатьяБюджета,
	|	Запрос.Аналитика1 КАК Аналитика1,
	|	Запрос.Аналитика2 КАК Аналитика2,
	|	Запрос.Аналитика3 КАК Аналитика3,
	|	Запрос.Аналитика4 КАК Аналитика4,
	|	Запрос.Аналитика5 КАК Аналитика5,
	|	Запрос.Аналитика6 КАК Аналитика6,
	|	Запрос.ПриходРасход КАК ПриходРасход,
	|	Запрос.Валюта КАК Валюта,
	|	СУММА(Запрос.Запланировано) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
	|		ДОБАВИТЬКДАТЕ(ВТ_ПланыДокумента.ДатаОперации, ДЕНЬ, ВТ_ОтносительныеДниОплаты.День) КАК ДатаОперации,
	|		ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|		ВТ_ПланыДокумента.Проект КАК Проект,
	|		ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|		ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|		ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|		ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|		ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|		ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|		ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
	|		ВТ_ПланыДокумента.Валюта КАК Валюта,
	|		ВЫРАЗИТЬ(ВТ_ПланыДокумента.Сумма * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)) КАК Запланировано
	|	ИЗ
	|		ВТ_ПланыДокументаРазвернутые КАК ВТ_ПланыДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
	|			ПО ВТ_ПланыДокумента.УсловиеОплаты = ВТ_ОтносительныеДниОплаты.Ссылка) КАК Запрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.ЦФО,
	|	Запрос.Проект,
	|	Запрос.СтатьяБюджета,
	|	Запрос.Аналитика1,
	|	Запрос.Аналитика2,
	|	Запрос.Аналитика3,
	|	Запрос.Аналитика4,
	|	Запрос.Аналитика5,
	|	Запрос.Аналитика6,
	|	Запрос.ПриходРасход,
	|	Запрос.ДатаОперации,
	|	Запрос.Валюта,
	|	Запрос.ВидБюджета
	|
	|ИМЕЮЩИЕ
	|	СУММА(Запрос.Запланировано) <> 0";

	Запросы.Добавить(ТекстЗапроса);
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	ПланыДокументаБДДС = Запрос.Выполнить().Выгрузить();

	//
	Номер = 0;
	Для Каждого Строка Из ПланыДокументаБДДС Цикл
		Номер = Номер + 1;
		Строка.НомерСтроки = Номер;
	КонецЦикла;
	
	Возврат ПланыДокументаБДДС;
	
КонецФункции

Процедура ПрименитьКорректировкуЗаявкиНаЗакупку(БизнесПроцесс) Экспорт
	
	ЭтапПолучатель = Перечисления.ЭтапыПланированияПотребностей.ЗаявкиНаЗакупку;  
	
	ВидБюджетаПланирования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БизнесПроцесс.Предмет, "ВидБюджетаПланирования"); 
	
	ПараметрыВерсии = Новый Структура;
	ПараметрыВерсии.Вставить("СоздаватьНовуюВерсию",	Истина);
	ПараметрыВерсии.Вставить("РазвернутыеАналитики",	Истина);
	ПараметрыВерсии.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	ПараметрыВерсии.Вставить("ДокументПланирования",	БизнесПроцесс.Предмет);
	ПараметрыВерсии.Вставить("ОбъектПланирования",		ОбъектыПланирования.НайтиОбъектПланирования(БизнесПроцесс.Предмет));
	ПараметрыВерсии.Вставить("ЭтапПолучатель",	 		ЭтапПолучатель);
	ПараметрыВерсии.Вставить("ДатаДокумента",			ТекущаяДатаСеанса());   
	ПараметрыВерсии.Вставить("ОтражатьВБюджетах", 		ЗначениеЗаполнено(ВидБюджетаПланирования));          
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("БизнесПроцесс.КорректировкаЗаявкиНаЗакупку");
	Менеджер.ПланыДокументаВоВременнуюТаблицу(БизнесПроцесс, ПараметрыВерсии);
	
	ФункциональноеНаправление = БизнесПроцесс.ФункциональноеНаправление;
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ФункциональноеНаправление", ФункциональноеНаправление);
	Номенклатура = БизнесПроцесс.ГлавнаяЗадача.БизнесПроцесс.ФункциональныеНаправления.Выгрузить(СтруктураПоиска, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	
	ПараметрыВерсии.Вставить("ФункциональноеНаправление", ФункциональноеНаправление);
	ПараметрыВерсии.Вставить("Номенклатура", Номенклатура);
	ПараметрыВерсии.Вставить("ИсточникВерсии", БизнесПроцесс);   
	
	ПараметрыПроведения = ПараметрыПроведения();
	ПараметрыПроведения.Вставить("ИзменениеНоменклатуры", Истина);
	ПараметрыПроведения.Вставить("ИзменениеПотребностей", Истина);
	ПараметрыПроведения.Вставить("ИзменениеСтруктуры",	  Истина);
	ПараметрыПроведения.Вставить("ИзменениеВалюты", 	  Истина);
	ПараметрыПроведения.Вставить("ИзменениеДатыОперации", Истина); 
	ПараметрыПроведения.Вставить("ИзменениеПоставки",	  	Истина); 
	ПараметрыПроведения.Вставить("ОтражатьВБюджетах", 		ЗначениеЗаполнено(ВидБюджетаПланирования)); 
	ПараметрыВерсии.Вставить("ПараметрыПроведения", ПараметрыПроведения);
		
	КорректировкаЗаявкиНаЗакупку_ЗаписатьВерсиюПлановДокумента(ПараметрыВерсии);
	
КонецПроцедуры

Функция ПланыДокумента(Объект, МенеджерВременныхТаблиц, ДляКонтроля = Ложь) Экспорт
	
	Если МенеджерВременныхТаблиц = неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	ТипОбъекта = ТипЗнч(Объект);
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	ПараметрыПланирования = Менеджер.ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц);
	Если ДляКонтроля = Истина Тогда
		ПараметрыПланирования.Вставить("ДокументРезервирования", Истина);
	КонецЕсли;
	ПодготовитьПланыДокумента(ПараметрыПланирования);
	
	Возврат МенеджерВременныхТаблиц;
	
КонецФункции

