	Возврат Блокировка;
	
КонецФункции

Процедура ЗаписатьВерсиюПлановДокумента(ПараметрыВерсии, ДополнительныеСвойства = Неопределено)  
	
	Если ДополнительныеСвойства = Неопределено Тогда
		ДополнительныеСвойства = Новый Структура;
	КонецЕсли;
	
	Если НЕ ПараметрыВерсии.Свойство("ЭтапОтправитель") Тогда
		ЭтапОтправитель = Новый Массив;
		ЭтапОтправитель.Добавить(Перечисления.ЭтапыПланированияПотребностей.ЗаявкиНаЗакупку);
		ПараметрыВерсии.Вставить("ЭтапОтправитель", ЭтапОтправитель);
	КонецЕсли;
	
	Если ПараметрыВерсии.Свойство("ПараметрыПроведения") Тогда
		ПараметрыПроведения = ПараметрыВерсии.ПараметрыПроведения;
	Иначе
		ПараметрыПроведения = ПараметрыПроведения();
		ПараметрыПроведения.Вставить("ИзменениеНоменклатуры", Истина);
		ПараметрыПроведения.Вставить("ИзменениеПотребностей", Истина);
		ПараметрыПроведения.Вставить("ИзменениеСтруктуры",	  Истина);
		ПараметрыПроведения.Вставить("ИзменениеПоставки",	  Ложь);
		ПараметрыПроведения.Вставить("ИзменениеВалюты", 	  Истина);
		ПараметрыПроведения.Вставить("ИзменениеДатыОперации", Истина);
		ПараметрыПроведения.ОтражатьВБюджетах = Истина;
	КонецЕсли;    
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	//
	ПараметрыВерсии.Вставить("ДокументРегистратор",	 неопределено);
	ПараметрыВерсии.Вставить("СоздаватьНовуюВерсию", Истина);
	
	// Если не создаем новую версию, но источник последенй версии не текущий документ
	ИнформацияОВерсии = ИнформацияОПоследнейВерсии(ПараметрыВерсии.ОбъектПланирования);
	Если ИнформацияОВерсии <> неопределено
			И ПараметрыВерсии.ИсточникВерсии = ИнформацияОВерсии.ИсточникВерсии Тогда
		ПараметрыВерсии.СоздаватьНовуюВерсию = Ложь;
	Иначе
		ИнформацияОВерсии = ПолучитьНовыйДокументРегистратор(ПараметрыВерсии.ДокументПланирования);
	КонецЕсли;
	ПараметрыВерсии.ДокументРегистратор = ИнформацияОВерсии.ДокументРегистратор;
	ПараметрыВерсии.ДатаДокумента = ИнформацияОВерсии.ДокументРегистраторДата; 
	
	ТипЗаявка = "ДокументСсылка.ЗаявкаНаОбеспечение";                             
	Опция = "ПроводитьЭкспертизуЗаявокНаЗакупку";
	Если ТипЗнч(ПараметрыВерсии.ИсточникВерсии) = Тип(ТипЗаявка) И ПолучитьФункциональнуюОпцию(Опция) Тогда
		
		ТоварныеКатегорииКорректировок = ТоварныеКатегорииКорректировокЗаявки(ПараметрыВерсии);  
		ПараметрыВерсии.Вставить("ТоварныеКатегорииКорректировок", ТоварныеКатегорииКорректировок);  
		ВТ_ПланыДокументаДобавленныеВручную = ПараметрыВерсии.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокументаДобавленныеВручную");
		
		Если ВТ_ПланыДокументаДобавленныеВручную <> Неопределено Тогда
			ПланыДокументаДобавленныеВручную = ВТ_ПланыДокументаДобавленныеВручную.ПолучитьДанные().Выгрузить();  
			
			ПараметрыПотребностей = ПараметрыПотребностей(Неопределено, ПланыДокументаДобавленныеВручную.ВыгрузитьКолонку("Номенклатура"), "ТоварнаяКатегория"); 
			СтрокиДляЗаписи = Новый Массив;
			Для Каждого СтрокаПлана Из ПланыДокументаДобавленныеВручную Цикл 
				ПараметрыПотребности = ПараметрыПотребностей.Получить(СтрокаПлана.Номенклатура); 
				Если ПараметрыПотребностей <> Неопределено Тогда   
					Если ТоварныеКатегорииКорректировок.Найти(ПараметрыПотребности) = Неопределено Тогда
						СтрокиДляЗаписи.Добавить(СтрокаПлана);
					КонецЕсли;
				Иначе
					СтрокиДляЗаписи.Добавить(СтрокаПлана);
				КонецЕсли;
			КонецЦикла; 
			
			ПланыДокументаДобавленныеВручную = ПланыДокументаДобавленныеВручную.Скопировать(СтрокиДляЗаписи);
			
		КонецЕсли;   
		
		Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТ_ПланыДокументаДобавленныеВручную");
		Запрос.МенеджерВременныхТаблиц = ПараметрыВерсии.МенеджерВременныхТаблиц;
		Запрос.Выполнить();
		ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ПланыДокументаДобавленныеВручную", ПланыДокументаДобавленныеВручную);
		
	КонецЕсли;
	
	ПодготовитьДанныеПланированияДокумента(ПараметрыПроведения, ПараметрыВерсии.МенеджерВременныхТаблиц);
	
		
	Блокировка = БлокировкаДанныхПоОбъектуПланирования(ПараметрыВерсии);
	Блокировка.Заблокировать();
	
	//
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыВерсии.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыВерсии.ОбъектПланирования);
	Запрос.УстановитьПараметр("ДокументПланирования", ПараметрыВерсии.ДокументПланирования);
	Запрос.УстановитьПараметр("ДокументРегистратор", ПараметрыВерсии.ДокументРегистратор);
	//Запрос.УстановитьПараметр("Дата", ПараметрыВерсии.ДатаДокумента);
	Запрос.УстановитьПараметр("Дата", ПараметрыВерсии.ДатаДокумента);
	
	//
	Запрос.УстановитьПараметр("ЭтапОтправитель", ПараметрыВерсии.ЭтапОтправитель);
	Запрос.УстановитьПараметр("ЭтапПолучатель", ПараметрыВерсии.ЭтапПолучатель);
	Запрос.УстановитьПараметр("РегистрироватьПланы", Ложь);
	
	//
	#Область ИмитацияОбъектаПриПроведении
	Объект = Новый Структура;
	Объект.Вставить("ДополнительныеСвойства", ДополнительныеСвойства);
	Объект.Вставить("Движения", Новый Массив);
	Движения = Новый Структура;
	
	//ПланированиеПотребностей
	НаборЗаписей = РегистрыНакопления.ПланированиеПотребностей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ПараметрыВерсии.ДокументРегистратор);
	НаборЗаписей.ДополнительныеСвойства.Вставить("РассчитыватьИзменения", 
												ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Объект.ДополнительныеСвойства, 
																								"РассчитыватьИзменения", Ложь));
	Объект.Движения.Добавить(НаборЗаписей);
	Движения.Вставить("ПланированиеПотребностей", НаборЗаписей);

	//АналитикиБюджетов
	НаборЗаписей = РегистрыСведений.АналитикиБюджетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ПараметрыВерсии.ДокументРегистратор);
	НаборЗаписей.ДополнительныеСвойства.Вставить("РассчитыватьИзменения", 
												ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Объект.ДополнительныеСвойства, 
																								"РассчитыватьИзменения", Ложь));
	Объект.Движения.Добавить(НаборЗаписей);
	Движения.Вставить("АналитикиБюджетов", НаборЗаписей);
		
	//ОперацииБюджетов
	НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ПараметрыВерсии.ДокументРегистратор);
	НаборЗаписей.ДополнительныеСвойства.Вставить("РассчитыватьИзменения", 
												ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Объект.ДополнительныеСвойства, 
																								"РассчитыватьИзменения", Ложь));
	Объект.Движения.Добавить(НаборЗаписей);
	Движения.Вставить("ОперацииБюджетов", НаборЗаписей);
	
	#КонецОбласти
	
	ПроведениеСерверОПК.ИнициализироватьДополнительныеСвойстваДляПроведения(ПараметрыВерсии.ДокументПланирования, Объект.ДополнительныеСвойства, РежимПроведенияДокумента.Неоперативный);
	
	ТекстыЗапроса = Новый СписокЗначений;
	//ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса);
	ПодготовитьТаблицыПланированияДляЗаявкиНаЗакупку(Запрос, ТекстыЗапроса);
	
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, Объект.ДополнительныеСвойства.ТаблицыДляДвижений, Истина);   
	
	ТипЗаявка = "ДокументСсылка.ЗаявкаНаОбеспечение";
	Если ТипЗнч(ПараметрыВерсии.ИсточникВерсии) = Тип(ТипЗаявка) Тогда
		ДобавитьДвиженияСторноПланированияПотребностей(Объект, ПараметрыВерсии, Запрос.Параметры.Дата); 
	КонецЕсли;

	ИменаТаблиц = Новый Структура("ТаблицаПланированиеПотребностей,ТаблицаОперацииБюджетов, ТаблицаАналитикиБюджетов");
	
	Для Каждого КлючЗначение Из ИменаТаблиц Цикл
		ИмяТаблицы = КлючЗначение.Ключ;
		
		// Добавить информацию об источнике версии
		Если НЕ Объект.ДополнительныеСвойства.ТаблицыДляДвижений.Свойство(ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		
		Таблица = Объект.ДополнительныеСвойства.ТаблицыДляДвижений[ИмяТаблицы];
		
		// ПланыПоДокументу
		ТипЗначения = ТипЗнч(ПараметрыВерсии.ДокументПланирования);
		ОписаниеТипа = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗначения));
		Таблица.Колонки.Добавить("КорректировкаДокумента", ОписаниеТипа);
		Таблица.ЗаполнитьЗначения(ПараметрыВерсии.ДокументПланирования, "КорректировкаДокумента");
		
		// ИсточникВерсии
		ТипЗначения = ТипЗнч(ПараметрыВерсии.ИсточникВерсии);
		ОписаниеТипа = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗначения));
		Таблица.Колонки.Добавить("ИсточникВерсии", ОписаниеТипа);
		Таблица.ЗаполнитьЗначения(ПараметрыВерсии.ИсточникВерсии, "ИсточникВерсии");
		
	КонецЦикла;
	
	ПроведениеСерверОПК.ПодготовитьНаборыЗаписейКПроведению(Объект);
	Отказ = Ложь;
	

	ОтразитьДвиженияПланирования(Объект.ДополнительныеСвойства, Движения, Отказ);
	
	Для Каждого НаборЗаписей Из Объект.Движения Цикл
		Если НаборЗаписей.Записывать Тогда
			НаборЗаписей.Записать(Истина);
		КонецЕсли;
	КонецЦикла;
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("РегистрСведений.СостоянияЗаявокНаЗакупку");
	Менеджер.ОбновитьПараметрыЗаявки(ПараметрыВерсии.ДокументПланирования);
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура ДобавитьДвиженияСторноПланированияПотребностей(Знач Объект, Знач ПараметрыВерсии, Знач ПериодСторно)    
	
	Опция = "ПроводитьЭкспертизуЗаявокНаЗакупку";
	Если Не ПолучитьФункциональнуюОпцию(Опция) Тогда
		Возврат;
	КонецЕсли;   
	Если Не Объект.ДополнительныеСвойства.Свойство("НедоступныеФункциональныеНаправления") Тогда
		Возврат;
	КонецЕсли;
	
	ТоварныеКатегорииКорректировок = ПараметрыВерсии.ТоварныеКатегорииКорректировок;
	
	ЗапросСторно = Новый Запрос;
	ЗапросСторно.УстановитьПараметр("ОбъектПланирования", ПараметрыВерсии.ОбъектПланирования); 
	ЗапросСторно.УстановитьПараметр("Регистратор", ПараметрыВерсии.ДокументРегистратор);  
	ЗапросСторно.УстановитьПараметр("НедоступныеФункциональныеНаправления", Объект.ДополнительныеСвойства.НедоступныеФункциональныеНаправления);
	ЗапросСторно.УстановитьПараметр("ТоварныеКатегорииКорректировок", ТоварныеКатегорииКорректировок);
	
	Запросы = Новый Массив;
	Запросы.Добавить(ТекстЗапроса_ПланПотребностейПоЗаявкеНаЗакупку(ОбщегоНазначенияКлиентСервер.МассивЗначений("ВТ_ДанныеБезДопРеквизитов.АналитикаПланирования", 
																												"ВТ_ДанныеБезДопРеквизитов.АналитикаИсточника", 
																												"ВТ_ДанныеБезДопРеквизитов.Период"), 
																	ОбщегоНазначенияКлиентСервер.МассивЗначений("Запрос.Регистратор <> &Регистратор", 
																												"Запрос.ИсточникВерсии ССЫЛКА Документ.ЗаявкаНаОбеспечение",
																												"Не Запрос.ТоварнаяКатегория В (&ТоварныеКатегорииКорректировок)")));   
	
	ЗапросСторно.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());  
	Результат = ЗапросСторно.ВыполнитьПакет();  
	
	ТаблицаСторно = Результат[1].Выгрузить(); 
	
	ТаблицаСторноНормализованная = ТаблицаСторно.Скопировать(, "АналитикаПланирования, АналитикаИсточника, ПриходРасход, Сумма, Количество");
	ТаблицаСторноНормализованная.Свернуть("АналитикаПланирования, АналитикаИсточника, ПриходРасход", "Сумма, Количество");   
	
	Для Каждого ДвижениеСторно Из ТаблицаСторноНормализованная Цикл  
		Движение = Объект.ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПланированиеПотребностей.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, ДвижениеСторно);
		Движение.Период = ПериодСторно;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	КонецЦикла;

КонецПроцедуры

Функция ТоварныеКатегорииКорректировокЗаявки(Знач ПараметрыВерсии)
	
	Перем ЗапросСторно, Запросы, Результат, ТаблицаСторноТК, ТоварныеКатегорииКорректировок;
	
	ЗапросСторно = Новый Запрос;
	ЗапросСторно.УстановитьПараметр("ОбъектПланирования", ПараметрыВерсии.ОбъектПланирования); 
	ЗапросСторно.УстановитьПараметр("Регистратор", ПараметрыВерсии.ДокументРегистратор);  
	
	Запросы = Новый Массив;
	Запросы.Добавить(ТекстЗапроса_ПланПотребностейПоЗаявкеНаЗакупку(ОбщегоНазначенияКлиентСервер.МассивЗначений("ВТ_ДанныеБезДопРеквизитов.АналитикаПланирования", 
																												"ВТ_ДанныеБезДопРеквизитов.АналитикаИсточника", 
																												"ВТ_ДанныеБезДопРеквизитов.Период",
																												"ВТ_ДанныеБезДопРеквизитов.ТоварнаяКатегория"), 
																	ОбщегоНазначенияКлиентСервер.МассивЗначений("Запрос.Регистратор <> &Регистратор", 
																												"Не Запрос.ИсточникВерсии ССЫЛКА Документ.ЗаявкаНаОбеспечение")));  
	
	ЗапросСторно.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());  
	Результат = ЗапросСторно.ВыполнитьПакет();  
	
	ТаблицаСторноТК = Результат[1].Выгрузить();  
	ТоварныеКатегорииКорректировок = ТаблицаСторноТК.ВыгрузитьКолонку("ТоварнаяКатегория");
	Возврат ТоварныеКатегорииКорректировок;

КонецФункции

Процедура КорректировкаЗаявкиНаЗакупку_ЗаписатьВерсиюПлановДокумента(ПараметрыВерсии, ДополнительныеСвойства = Неопределено) Экспорт   
	
	Если ДополнительныеСвойства = Неопределено Тогда
		ДополнительныеСвойства = Новый Структура;
	КонецЕсли;

	Если НЕ ПараметрыВерсии.Свойство("ЭтапОтправитель") Тогда
		ЭтапОтправитель = Новый Массив;
		ЭтапОтправитель.Добавить(Перечисления.ЭтапыПланированияПотребностей.ЗаявкиНаЗакупку); 
		ЭтапОтправитель.Добавить(Перечисления.ЭтапыПланированияПотребностей.ЗаявкиСогласованные); 
		ПараметрыВерсии.Вставить("ЭтапОтправитель", ЭтапОтправитель);
	КонецЕсли;
	
	Если ПараметрыВерсии.Свойство("ПараметрыПроведения") Тогда
		ПараметрыПроведения = ПараметрыВерсии.ПараметрыПроведения;
	Иначе
		ПараметрыПроведения = ПараметрыПроведения();
		ПараметрыПроведения.Вставить("ИзменениеНоменклатуры", Истина);
		ПараметрыПроведения.Вставить("ИзменениеПотребностей", Истина);
		ПараметрыПроведения.Вставить("ИзменениеСтруктуры",	  Истина);
		ПараметрыПроведения.Вставить("ИзменениеПоставки",	  Ложь);
		ПараметрыПроведения.Вставить("ИзменениеВалюты", 	  Истина);
		ПараметрыПроведения.Вставить("ИзменениеДатыОперации", Истина);
		ПараметрыПроведения.ОтражатьВБюджетах = Истина;
	КонецЕсли;
	
	ПодготовитьДанныеПланированияДокумента(ПараметрыПроведения, ПараметрыВерсии.МенеджерВременныхТаблиц);
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Блокировка = БлокировкаДанныхПоОбъектуПланирования(ПараметрыВерсии);
	Блокировка.Заблокировать();    
	ЗаявкаСсылка = ПараметрыВерсии.ДокументПланирования; 
	ЗаблокироватьДанныеДляРедактирования(ЗаявкаСсылка);

	//
	ПараметрыВерсии.Вставить("ДокументРегистратор",	 неопределено);
	
	Если НЕ ПараметрыВерсии.СоздаватьНовуюВерсию Тогда
		// Если не создаем новую версию, но источник последенй версии не текущий документ
		ИнформацияОПоследнейВерсии = ИнформацияОПоследнейВерсии(ПараметрыВерсии.ОбъектПланирования);
		Если ИнформацияОПоследнейВерсии = неопределено
				ИЛИ ПараметрыВерсии.ИсточникВерсии <> ИнформацияОПоследнейВерсии.ИсточникВерсии Тогда
			ПараметрыВерсии.СоздаватьНовуюВерсию = Истина;
		Иначе
			ПараметрыВерсии.ДокументРегистратор = ИнформацияОПоследнейВерсии.ДокументРегистратор;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыВерсии.СоздаватьНовуюВерсию Тогда
		ИнформацияОВерсии = ПолучитьНовыйДокументРегистратор(ПараметрыВерсии.ДокументПланирования);
		ПараметрыВерсии.ДокументРегистратор = ИнформацияОВерсии.ДокументРегистратор;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыВерсии.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыВерсии.ОбъектПланирования);
	Запрос.УстановитьПараметр("ДокументПланирования", ПараметрыВерсии.ДокументПланирования);
	Запрос.УстановитьПараметр("ДокументРегистратор", ПараметрыВерсии.ДокументРегистратор);
	Запрос.УстановитьПараметр("Дата", ПараметрыВерсии.ДатаДокумента);
	
	//
	Запрос.УстановитьПараметр("ЭтапОтправитель", ПараметрыВерсии.ЭтапОтправитель);
	Запрос.УстановитьПараметр("ЭтапПолучатель", ПараметрыВерсии.ЭтапПолучатель);
	Запрос.УстановитьПараметр("РегистрироватьПланы", Ложь);
	
	//
	#Область ИмитацияОбъектаПриПроведении
	Объект = Новый Структура;
	Объект.Вставить("ДополнительныеСвойства", ДополнительныеСвойства);
	Объект.Вставить("Движения", Новый Массив);
	Движения = Новый Структура;
	
	//ПланированиеПотребностей
	НаборЗаписей = РегистрыНакопления.ПланированиеПотребностей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ПараметрыВерсии.ДокументРегистратор);
	Объект.Движения.Добавить(НаборЗаписей);
	Движения.Вставить("ПланированиеПотребностей", НаборЗаписей);

	//АналитикиБюджетов
	НаборЗаписей = РегистрыСведений.АналитикиБюджетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ПараметрыВерсии.ДокументРегистратор);
	Объект.Движения.Добавить(НаборЗаписей);
	Движения.Вставить("АналитикиБюджетов", НаборЗаписей);
		
	//ОперацииБюджетов
	НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ПараметрыВерсии.ДокументРегистратор);
	Объект.Движения.Добавить(НаборЗаписей);
	Движения.Вставить("ОперацииБюджетов", НаборЗаписей);
	
	#КонецОбласти
	
	ПроведениеСерверОПК.ИнициализироватьДополнительныеСвойстваДляПроведения(ПараметрыВерсии.ДокументПланирования, Объект.ДополнительныеСвойства, РежимПроведенияДокумента.Неоперативный);
	
	ТекстыЗапроса = Новый СписокЗначений;
	ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса);
	
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, Объект.ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
	ИменаТаблиц = Новый Структура("ТаблицаПланированиеПотребностей,ТаблицаОперацииБюджетов, ТаблицаАналитикиБюджетов");
	
	Для Каждого КлючЗначение Из ИменаТаблиц Цикл
		ИмяТаблицы = КлючЗначение.Ключ;
		
		// Добавить информацию об источнике версии
		Если НЕ Объект.ДополнительныеСвойства.ТаблицыДляДвижений.Свойство(ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		
		Таблица = Объект.ДополнительныеСвойства.ТаблицыДляДвижений[ИмяТаблицы];
		
		// ПланыПоДокументу
		ТипЗначения = ТипЗнч(ПараметрыВерсии.ДокументПланирования);
		ОписаниеТипа = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗначения));
		Таблица.Колонки.Добавить("КорректировкаДокумента", ОписаниеТипа);
		Таблица.ЗаполнитьЗначения(ПараметрыВерсии.ДокументПланирования, "КорректировкаДокумента");
		
		// ИсточникВерсии
		ТипЗначения = ТипЗнч(ПараметрыВерсии.ИсточникВерсии);
		ОписаниеТипа = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗначения));
		Таблица.Колонки.Добавить("ИсточникВерсии", ОписаниеТипа);
		Таблица.ЗаполнитьЗначения(ПараметрыВерсии.ИсточникВерсии, "ИсточникВерсии");
		
	КонецЦикла;
	
	ПроведениеСерверОПК.ПодготовитьНаборыЗаписейКПроведению(Объект);
	Отказ = Ложь;
	

	ОтразитьДвиженияПланирования(Объект.ДополнительныеСвойства, Движения, Отказ);
	
	Для Каждого НаборЗаписей Из Объект.Движения Цикл
		Если НаборЗаписей.Записывать Тогда
			НаборЗаписей.Записать(Истина);
		КонецЕсли;
	КонецЦикла;
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("РегистрСведений.СостоянияЗаявокНаЗакупку");
	Менеджер.ОбновитьПараметрыЗаявки(ПараметрыВерсии.ДокументПланирования);
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Функция ПолучитьДокументРегистратор(ОбъектПланирования, СоздаватьНовуюВерсию)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектПланирования);
	
	// 4. Установка регистратора
	Если НЕ СоздаватьНовуюВерсию Тогда
		
		// Записать на существующий регистратор
		ИнформацияОПоследнейВерсии = ИнформацияОПоследнейВерсии(ОбъектПланирования);
		Если ИнформацияОПоследнейВерсии <> неопределено  Тогда
			Возврат ИнформацияОПоследнейВерсии.ДокументРегистратор;
		КонецЕсли;
		
	КонецЕсли;
	
	// Свободные регистраторы
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистраторВерсииПланаДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РегистраторВерсииПланаДокумента КАК РегистраторВерсииПланаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	|		ПО (ПланированиеПотребностей.Регистратор = РегистраторВерсииПланаДокумента.Ссылка)
	|ГДЕ
	|	ПланированиеПотребностей.Регистратор ЕСТЬ NULL";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		
		// Создаем новый документ регистратор
		Док = Документы.РегистраторВерсииПланаДокумента.СоздатьДокумент();
		Док.Дата = ТекущаяДатаСеанса();
		Док.Записать(РежимЗаписиДокумента.Запись);
		Возврат Док.Ссылка;
		
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Ссылка.ПолучитьОбъект();
		Док.Дата = ТекущаяДатаСеанса();
		Док.Записать(РежимЗаписиДокумента.Запись);
		Возврат Док.Ссылка;
	КонецЦикла;
		
КонецФункции

Функция ПолучитьНовыйДокументРегистратор(ОбъектПланирования)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("ОбъектПланирования, ИсточникВерсии, ДокументРегистратор, ДокументРегистраторДата");
	Результат.ОбъектПланирования = ОбъектПланирования;
	
	Запрос = Новый Запрос;
	
	// Свободные регистраторы
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РегистраторВерсииПланаДокумента КАК Документ
	|ГДЕ
	|	НЕ Документ.Ссылка В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ДанныеРегистра.Регистратор
	|				ИЗ
	|					РегистрНакопления.ПланированиеПотребностей КАК ДанныеРегистра
	|				ГДЕ
	|					ДанныеРегистра.Регистратор ССЫЛКА Документ.РегистраторВерсииПланаДокумента)";
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Док = Документы.РегистраторВерсииПланаДокумента.СоздатьДокумент();
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Док = Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Док.Дата = ТекущаяДатаСеанса();
	Док.Записать(РежимЗаписиДокумента.Запись);
	
	Результат.ДокументРегистратор = Док.Ссылка;
	Результат.ДокументРегистраторДата = Док.Дата;
	
	Возврат Результат
	
КонецФункции

