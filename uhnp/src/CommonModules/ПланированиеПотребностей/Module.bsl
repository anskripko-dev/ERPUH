		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &Условия", "");		
	КонецЕсли;  
	
	Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий КАК Комментарий", "ВЫРАЗИТЬ(ЕСТЬNULL(КомментарииАналитикПотребностей.Комментарий, """") КАК СТРОКА(1000)) КАК Комментарий"); 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий", "ВЫРАЗИТЬ(ЕСТЬNULL(КомментарииАналитикПотребностей.Комментарий, """") КАК СТРОКА(1000))"); 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЛЕВОЕ СОЕДИНЕНИЕ ПодстановкаКомментариевАналитик
												 |		ПО (Истина)", 
												"|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КомментарииАналитикПотребностей КАК КомментарииАналитикПотребностей
												 |		ПО ВТ_ДанныеБезДопРеквизитов.АналитикаПланирования = КомментарииАналитикПотребностей.АналитикаПланирования");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий КАК Комментарий", "ВЫРАЗИТЬ("""" КАК СТРОКА(1000)) КАК Комментарий");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий", "ВЫРАЗИТЬ("""" КАК СТРОКА(1000))"); 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЛЕВОЕ СОЕДИНЕНИЕ ПодстановкаКомментариевАналитик
												 |		ПО (Истина)", 
												"");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция - Зафиксировать результат группового изменения заявок на закупку
//  РазвернутыеАналитики - Булево			 - Ложь - в ТаблицаПланов только ключи, Истина в ТаблицаПланов реквизиты (Статья, ЦФО, Номенклатура и т.д.)
//
// Параметры:
//  ТаблицаПлановИсходная	 - ТаблицаЗначений	 - Таблица планов документа
//		Задача			 	 - ЗадачаСсылка		 - Задача, на основании которой создавать корректировку
//		ДокументПланирования - ДокументСсылка	 - Документ планирования
//		АналитикиПланирования- <разные>			 - Развернутые аналитики планирования (см. БП.КорректировкаЗаявкиНаЗакупку.ТЧ.ПланыДокументаИсходные)
//		Количество			 -					 - Исходное
//		Сумма				 -					 - Исходная
//  ТаблицаПлановНовая	 	 - ТаблицаЗначений	 - Таблица планов документа
//		Задача			 	 - ЗадачаСсылка		 - Задача, на основании которой создавать корректировку
//		ДокументПланирования - ДокументСсылка	 - Документ планирования
//		АналитикиПланирования- <разные>			 - Развернутые аналитики планирования (см. БП.КорректировкаЗаявкиНаЗакупку.ТЧ.ПланыДокументаИсходные)
//		Количество			 -					 - Количество
//		Сумма				 -					 - Сумма
//		
// Возвращаемое значение:
//  Структура - Результат
//
Функция ЗафиксироватьРезультатГрупповогоИзмененияЗаявокНаЗакупку(ТаблицаПлановИсходная, ТаблицаПлановНовая) Экспорт
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ПланыИсходные", ТаблицаПлановИсходная);
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ПланыНовые", ТаблицаПлановНовая);
	
