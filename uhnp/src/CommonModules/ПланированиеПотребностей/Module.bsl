КонецПроцедуры

Процедура ТаблицаАналитикиБюджетов(Запрос, ТекстыЗапроса, Регистры)
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_АналитикиБюджетов") = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРегистра = "ТаблицаАналитикиБюджетов";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_АналитикиБюджетов.АналитикаПланирования КАК АналитикаПланирования,
	|	ВТ_АналитикиБюджетов.ВидБюджета КАК ВидБюджета,
	|	ВТ_АналитикиБюджетов.ВидБюджетаЗависимый КАК ВидБюджетаЗависимый,
	|	ВТ_АналитикиБюджетов.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ВТ_АналитикиБюджетов.АналитикаСтатейБюджетовЗависимый КАК АналитикаСтатейБюджетовЗависимый
	|ИЗ
	|	ВТ_АналитикиБюджетов КАК ВТ_АналитикиБюджетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиБюджетов КАК АналитикиБюджетов
	|		ПО ВТ_АналитикиБюджетов.АналитикаПланирования = АналитикиБюджетов.АналитикаПланирования
	|			И &ОбъектПланирования = АналитикиБюджетов.АналитикаПланирования.ОбъектПланирования
	|ГДЕ
	|	АналитикиБюджетов.АналитикаПланирования ЕСТЬ NULL
	|	ИЛИ АналитикиБюджетов.Регистратор = &ДокументРегистратор";
	Если НЕ Запрос.Параметры.Свойство("ДокументРегистратор")
		И Запрос.Параметры.Свойство("Ссылка") Тогда
		Запрос.УстановитьПараметр("ДокументРегистратор", Запрос.Параметры.Ссылка);
	КонецЕсли;
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

Процедура ТаблицаОперацийБюджетов(Запрос, ТекстыЗапроса, Регистры)
	
	Если Запрос.Параметры.Свойство("ОтражатьВБюджетах") И Запрос.Параметры.ОтражатьВБюджетах = ЛОЖЬ Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Запрос.Параметры.Свойство("ФормироватьОперацииБюджетовПоПредыдущемуЭтапу") Тогда
		Запрос.УстановитьПараметр("ФормироватьОперацииБюджетовПоПредыдущемуЭтапу", Истина);
	КонецЕсли;
	
	Если НЕ Запрос.Параметры.Свойство("ТолькоПланыПоПоставке") Тогда
		Запрос.УстановитьПараметр("ТолькоПланыПоПоставке", Ложь);
	КонецЕсли;
	
	Если НЕ Запрос.Параметры.Свойство("РегистрироватьИсполнениеПоБюджету") Тогда
		Запрос.УстановитьПараметр("РегистрироватьИсполнениеПоБюджету", Новый Массив); // Установлен ранее только для документов исполнения
	КонецЕсли;
	
	ИмяРегистра = "ТаблицаОперацииБюджетов";
	
	ЕстьДобавленные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланированиеПотребностей_Добавлено") <> неопределено;
	ЕстьПотребности = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланированиеПотребностей_Перенос") <> неопределено;
	
	Запросы = Новый Массив;
	
	Если ЕстьДобавленные Тогда

		Если НЕ ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		Запросы.Добавить(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования).ОбъектПланирования КАК ОбъектПланирования,
		|	ДОБАВИТЬКДАТЕ(ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования).ДатаОперации, ДЕНЬ, ВТ_ОтносительныеДниОплаты.День) КАК ДатаОперации,
		|	АналитикиБюджетов.ВидБюджетаЗависимый КАК ВидБюджета,
		|	АналитикиБюджетов.АналитикаСтатейБюджетовЗависимый КАК АналитикаСтатейБюджетов,
		|	неопределено КАК АналитикаПартнеров,
		|	ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования) КАК АналитикаПланирования,
		|	0 КАК Количество,
		|	ВЫРАЗИТЬ(Добавлено.СуммаПоПотребности * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)) КАК Сумма,
		|	0 КАК КоличествоИсполнено,
		|	0 КАК СуммаИсполнено
		|ИЗ
		|	ВТ_ПланированиеПотребностей_Добавлено КАК Добавлено
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АналитикиБюджетов КАК АналитикиБюджетов
		|		ПО Добавлено.АналитикаИсточника = АналитикиБюджетов.АналитикаПланирования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
		|		ПО (ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования).УсловиеОплаты = ВТ_ОтносительныеДниОплаты.Ссылка)
		|ГДЕ
		|	АналитикиБюджетов.ВидБюджетаЗависимый <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка) 
		|   И ТИПЗНАЧЕНИЯ(Добавлено.АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета) = ТИП(Справочник.СтатьиДвиженияДенежныхСредств)");
		Иначе
		Запросы.Добавить(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования).ОбъектПланирования КАК ОбъектПланирования,
		|	ВТ_ОтносительныеДниОплаты.День  КАК ДатаОперации,	
		|	АналитикиБюджетов.ВидБюджетаЗависимый КАК ВидБюджета,
		|	АналитикиБюджетов.АналитикаСтатейБюджетовЗависимый КАК АналитикаСтатейБюджетов,
		|	неопределено КАК АналитикаПартнеров,
		|	ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования) КАК АналитикаПланирования,
		|	0 КАК Количество,
		|	ВЫРАЗИТЬ(Добавлено.СуммаПоПотребности * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)) КАК Сумма,
		|	0 КАК КоличествоИсполнено,
		|	0 КАК СуммаИсполнено
		|ИЗ
		|	ВТ_ПланированиеПотребностей_Добавлено КАК Добавлено
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АналитикиБюджетов КАК АналитикиБюджетов
		|		ПО Добавлено.АналитикаИсточника = АналитикиБюджетов.АналитикаПланирования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
		|		ПО Добавлено.АналитикаПланирования.ОбъектПланирования.Объект = ВТ_ОтносительныеДниОплаты.Ссылка	
		|		И Добавлено.АналитикаПланирования.ДатаОперации = ВТ_ОтносительныеДниОплаты.ДатаПоступления	
		|ГДЕ
		|	АналитикиБюджетов.ВидБюджетаЗависимый <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка) 
		|   И (ТИПЗНАЧЕНИЯ(Добавлено.АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета) = ТИП(Справочник.СтатьиДвиженияДенежныхСредств)
        |   ИЛИ ТИПЗНАЧЕНИЯ(Добавлено.АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета) = ТИП(Справочник.СтатьиДвиженияРесурсов))");
		КонецЕсли;
		Запросы.Добавить(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования).ОбъектПланирования КАК ОбъектПланирования,
		|	ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования).ДатаОперации КАК ДатаОперации,
		|	АналитикиБюджетов.ВидБюджетаЗависимый КАК ВидБюджета,
		|	АналитикиБюджетов.АналитикаСтатейБюджетовЗависимый КАК АналитикаСтатейБюджетов,
		|	неопределено КАК АналитикаПартнеров,
		|	ВЫРАЗИТЬ(Добавлено.АналитикаПланирования КАК Справочник.КлючиАналитикПланирования) КАК АналитикаПланирования,
