		|	Коллекция.Поставщик,
		|	Коллекция.НоменклатураПоставщика";
		ВыполнитьКлючеваниеПоставки(Запрос.Выполнить());
		
	КонецЕсли;
	
	// 6. Пересоединиться
	ТекстЗапроса = 
