Функция БлокировкаДанныхПоРегистраторамВерсииПланов(ИсточникДанных)
	
	Блокировка = Новый БлокировкаДанных;

	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ПланированиеПотребностей.НаборЗаписей");
