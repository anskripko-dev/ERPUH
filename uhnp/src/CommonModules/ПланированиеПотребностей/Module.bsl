	|	СУММА(Запрос.СуммаИсполнено) КАК СуммаИсполнено,
	|	СУММА(Запрос.КоличествоИсполнено) КАК КоличествоИсполнено,
	|	&Дата КАК ДатаРегистрации
	|ИЗ
	|	&Коллекция КАК Запрос
	|ГДЕ
	|	&РегистрироватьПланы = ИСТИНА
	|	И (&ТолькоПланыПоПоставке = ЛОЖЬ
	|			ИЛИ Запрос.ВидБюджета <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств))
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.ОбъектПланирования,
	|	Запрос.ДатаОперации,
	|	Запрос.ВидБюджета,
	|	Запрос.АналитикаСтатейБюджетов,
	|	Запрос.АналитикаСтатейБюджетов.ПриходРасход,
	|	Запрос.АналитикаПланирования.Валюта,
	|	Запрос.АналитикаПланирования.АналитикаСтруктуры,
	|	Запрос.АналитикаПартнеров,
	|	ВЫБОР
	|		КОГДА Запрос.ВидБюджета В (&ВидыБюджетаСНоменклатурой)
	|			ТОГДА Запрос.АналитикаПланирования.АналитикаНоменклатуры
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Запрос.ВидБюджета В (&ВидыБюджетаСНоменклатурой)
	|			ТОГДА Запрос.АналитикаПланирования.АналитикаПотребностей
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Запрос.ВидБюджета В (&ВидыБюджетаСНоменклатурой)
	|			ТОГДА Запрос.АналитикаПланирования.АналитикаПоставки
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ";
	
	ТекстПодзапросов = СтрСоединить(Запросы, "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Коллекция", "("+ТекстПодзапросов+")");
	
	ВидыБюджетаСНоменклатурой = Новый Массив;
	ВидыБюджетаСНоменклатурой.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	Запрос.УстановитьПараметр("ВидыБюджетаСНоменклатурой", ВидыБюджетаСНоменклатурой);

	Если НЕ Запрос.Параметры.Свойство("РегистрироватьПланы") Тогда
		Запрос.УстановитьПараметр("РегистрироватьПланы", Истина);
	КонецЕсли;
	
	//
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
КонецПроцедуры

#КонецОбласти

