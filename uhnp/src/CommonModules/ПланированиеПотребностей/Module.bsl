		КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Запросы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Запрос.ДатаОперации ЕСТЬ NULL
	|			ТОГДА &Дата
	|		ИНАЧЕ Запрос.ДатаОперации
