	Возврат Результат
	
КонецФункции

// Функция - Возвращает последний документ-регистратор
//
// Параметры:
//  ДокументПланирования - 	 - 
//  СоздаватьНовуюВерсию - 	 - 
// 
// Возвращаемое значение:
//   неопределено, Структура - 
//			* ДокументРегистратор	- ДокументСсылка.РегистраторВерсииПланаДокумента - 
//			* ДокументПланирования	- ДокументСсылка.ЗаявкаНаЗакупку - Документ планирования
//			* ИсточникВерсии		- ДокументСсылка - Документ, инициировавший новую версию плана
//
Функция ИнформацияОПоследнейВерсии(ОбъектПланирования)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("ДокументПланирования", ДокументПланирования);
	Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектПланирования);
	
	// Записать на существующий регистратор
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистраторВерсииПланаДокумента.Ссылка КАК ДокументРегистратор,
	|	РегистраторВерсииПланаДокумента.Дата КАК ДокументРегистраторДата,
	|	ПланированиеПотребностей.Период КАК Период,
	|	ПланированиеПотребностей.АналитикаПланирования.ОбъектПланирования КАК ОбъектПланирования,
	|	ПланированиеПотребностей.ИсточникВерсии КАК ИсточникВерсии
	|ПОМЕСТИТЬ ВТ_ВерсииДокументаПланирования
	|ИЗ
	|	Документ.РегистраторВерсииПланаДокумента КАК РегистраторВерсииПланаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	|		ПО (ПланированиеПотребностей.АналитикаПланирования.ОбъектПланирования = &ОбъектПланирования)
	|			И (ПланированиеПотребностей.Регистратор = РегистраторВерсииПланаДокумента.Ссылка)
	|;
	|                       
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_ВерсииДокументаПланирования.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ПоследнийДокумент
	|ИЗ
	|	ВТ_ВерсииДокументаПланирования КАК ВТ_ВерсииДокументаПланирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ВерсииДокументаПланирования.ДокументРегистратор КАК ДокументРегистратор,
	|	ВТ_ВерсииДокументаПланирования.ДокументРегистраторДата КАК ДокументРегистраторДата,
	|	ВТ_ВерсииДокументаПланирования.ОбъектПланирования КАК ОбъектПланирования,
	|	ВТ_ВерсииДокументаПланирования.ИсточникВерсии КАК ИсточникВерсии
	|ИЗ
	|	ВТ_ВерсииДокументаПланирования КАК ВТ_ВерсииДокументаПланирования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПоследнийДокумент КАК ВТ_ПоследнийДокумент
	|		ПО ВТ_ВерсииДокументаПланирования.Период = ВТ_ПоследнийДокумент.Период";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Результат = Новый Структура("ОбъектПланирования, ИсточникВерсии, ДокументРегистратор, ДокументРегистраторДата");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
	Возврат Результат;
	
КонецФункции

Функция НормализоватьПланыДокумента(ПланыДокумента, ПараметрыВерсии)
	
	Планы = ПланыДокумента.Скопировать();
	Планы.Колонки.Добавить("ОбъектПланирования", Новый ОписаниеТипов("СправочникСсылка.ОбъектыПланирования"));
	Если Планы.Колонки.Найти("НомерСтроки") = неопределено Тогда
		Планы.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10,0));
	КонецЕсли;    
	Если Планы.Колонки.Найти("Цена") = неопределено Тогда
		Планы.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	КонецЕсли;    
	
	//
	НомерСтроки = 0;
	Для Каждого Строка Из Планы Цикл
		НомерСтроки = НомерСтроки + 1;
		Строка.НомерСтроки = НомерСтроки;
		
		Если ТипЗнч(Строка.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			Строка.Цена = Строка.Сумма / Строка.Количество;
		Иначе
			Строка.Цена = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Планы.ЗаполнитьЗначения(ПараметрыВерсии.ОбъектПланирования, "ОбъектПланирования");
	
	Планы.ЗаполнитьЗначения(ПараметрыВерсии.ЭтапПолучатель, "Этап");
	
	Возврат Планы;
	
КонецФункции

Функция ПолучитьДобавленныеПотребностиВЗаявкуНаЗакупку(ОбъектПланирования, ПараметрыВерсии)
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыВерсии.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектПланирования);
