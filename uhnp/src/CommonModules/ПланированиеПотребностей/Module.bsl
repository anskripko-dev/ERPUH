	Запрос.Текст = ТекстЗапроса; 
	
	Запрос.Выполнить();       
	Если НЕ ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		ПрименитьСпособыРасчетаКоличестваДнейВПериоде(Запрос, ПараметрыПланирования);
	КонецЕсли;
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ПланыДокумента");
	
КонецПроцедуры

Процедура ПодготовитьПланыДокументаПоПроизвольнымАналитикам(ПараметрыПланирования, МенеджерВременныхТаблиц = Неопределено) Экспорт

	Если Не ПараметрыПланирования.Свойство("ОтражениеВБюджетах") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументПланирования", ПараметрыПланирования.ДокументПланирования);
	
	Для Каждого КлючЗначение Из ПараметрыПланирования.ОтражениеВБюджетах Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Если Не Запрос.Параметры.Свойство("ВидБюджетаЗакупок") Тогда
		Если ЗначениеЗаполнено(ПараметрыПланирования.ДокументПланирования) Тогда
			Запрос.УстановитьПараметр("ВидБюджетаЗакупок", ИспользуемыеВидыБюджетовЗакупок(ПараметрыПланирования.ДокументПланирования.Дата));
		Иначе
			Запрос.УстановитьПараметр("ВидБюджетаЗакупок", ПланыВидовХарактеристик.ВидыБюджетов.ПустаяСсылка());	
		КонецЕсли;		
	
	КонецЕсли;
	
	Если ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда 
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = ПараметрыПланирования.Менеджер;
	КонецЕсли;
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ОтносительныеДниОплаты") = Неопределено Тогда
		ПараметрыУсловийОплатыДляПлановДокумента(Запрос);
	КонецЕсли;
	
	ЕстьДобавленные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокументаДобавленныеВручную") <> Неопределено;
	ЕстьПотребности = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокументаДляОбработки") <> Неопределено;
	ТребуетсяБДДС = Не (ПараметрыПланирования.Свойство("ТолькоПланыПоПоставке") И ПараметрыПланирования.ТолькоПланыПоПоставке = Истина);
	
	ФормироватьОперацииБюджетовПоПредыдущемуЭтапу = ЕстьПотребности И 
		(Не ПараметрыПланирования.Свойство("ФормироватьОперацииБюджетовПоПредыдущемуЭтапу") 
		ИЛИ ПараметрыПланирования.ФормироватьОперацииБюджетовПоПредыдущемуЭтапу = Истина);
	
	Запросы = Новый Массив;
	
	Если ЕстьДобавленные Тогда
		
		Запросы.Добавить(
		"ВЫБРАТЬ
		|	&ДокументПланирования КАК ДокументПланирования,
		|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
		|	Добавлено.ДатаОперации КАК ДатаОперации,
		|	Добавлено.ДатаОперации КАК ДатаОперацииИсходная,
		|	&ВидБюджетаПоставка КАК ВидБюджета,
		|	Добавлено.СтатьяБюджетаПоставка КАК СтатьяБюджета,
		|	Добавлено.Аналитика1Поставка КАК Аналитика1,
		|	Добавлено.Аналитика2Поставка КАК Аналитика2,
		|	Добавлено.Аналитика3Поставка КАК Аналитика3,
		|	Добавлено.Аналитика4Поставка КАК Аналитика4,
		|	Добавлено.Аналитика5Поставка КАК Аналитика5,
		|	Добавлено.Аналитика6Поставка КАК Аналитика6,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход) КАК ПриходРасход,
		|	&Организация КАК Организация,
		|	Добавлено.АналитикаПредыдущегоЭтапа.АналитикаСтруктуры.ЦФО КАК ЦФО,
		|	Добавлено.АналитикаПредыдущегоЭтапа.АналитикаСтруктуры.Проект КАК Проект,
		|	Добавлено.Валюта КАК Валюта,
		|	Добавлено.Сумма КАК Сумма,
		|	Добавлено.СуммаПоПотребности КАК СуммаПоПотребности,
		|	ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаКоличестваДнейВПериоде.ПустаяСсылка) КАК ТипСрока,
		|	0 КАК День
		|ИЗ
		|	ВТ_ПланыДокументаДобавленныеВручную КАК Добавлено");
		
		Если ТребуетсяБДДС Тогда
			
			Если НЕ ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда

			Запросы.Добавить(
			"ВЫБРАТЬ
			|	&ДокументПланирования КАК ДокументПланирования,
			|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
			|	Добавлено.ДатаОперации КАК ДатаОперации,
			|	Добавлено.ДатаОперации КАК ДатаОперацииИсходная,
			|	&ВидБюджета КАК ВидБюджета,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.СтатьяБюджета
			|		ИНАЧЕ &СтатьяБюджета
			|	КОНЕЦ КАК СтатьяБюджета,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика1
			|		ИНАЧЕ &Аналитика1
			|	КОНЕЦ КАК Аналитика1,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика2
			|		ИНАЧЕ &Аналитика2
			|	КОНЕЦ КАК Аналитика2,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика3
			|		ИНАЧЕ &Аналитика3
			|	КОНЕЦ КАК Аналитика3,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика4
			|		ИНАЧЕ &Аналитика4
			|	КОНЕЦ КАК Аналитика4,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика5
			|		ИНАЧЕ &Аналитика5
			|	КОНЕЦ КАК Аналитика5,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика6
			|		ИНАЧЕ &Аналитика6
			|	КОНЕЦ КАК Аналитика6,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
			|	&Организация КАК Организация,
			|	Добавлено.АналитикаПредыдущегоЭтапа.АналитикаСтруктуры.ЦФО КАК ЦФО,
			|	Добавлено.АналитикаПредыдущегоЭтапа.АналитикаСтруктуры.Проект КАК Проект,
			|	Добавлено.Валюта КАК Валюта,
			|	ВЫРАЗИТЬ(Добавлено.Сумма * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)) КАК Сумма,
			|	ВЫРАЗИТЬ(Добавлено.СуммаПоПотребности * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)) КАК СуммаПоПотребности,
			|	ВТ_ОтносительныеДниОплаты.ТипСрока КАК ТипСрока,
			|	ВТ_ОтносительныеДниОплаты.День КАК День
			|ИЗ
			|	ВТ_ПланыДокументаДобавленныеВручную КАК Добавлено
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
			|		ПО Добавлено.УсловиеОплаты = ВТ_ОтносительныеДниОплаты.Ссылка");   
			Иначе
			Запросы.Добавить(
			"ВЫБРАТЬ
			|	&ДокументПланирования КАК ДокументПланирования,
			|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
			|	Добавлено.ДатаОперации КАК ДатаОперации,
			|	Добавлено.ДатаОперации КАК ДатаОперацииИсходная,
			|	&ВидБюджета КАК ВидБюджета,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.СтатьяБюджета
			|		ИНАЧЕ &СтатьяБюджета
			|	КОНЕЦ КАК СтатьяБюджета,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика1
			|		ИНАЧЕ &Аналитика1
			|	КОНЕЦ КАК Аналитика1,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика2
			|		ИНАЧЕ &Аналитика2
			|	КОНЕЦ КАК Аналитика2,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика3
			|		ИНАЧЕ &Аналитика3
			|	КОНЕЦ КАК Аналитика3,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика4
			|		ИНАЧЕ &Аналитика4
			|	КОНЕЦ КАК Аналитика4,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика5
			|		ИНАЧЕ &Аналитика5
			|	КОНЕЦ КАК Аналитика5,
			|	ВЫБОР
			|		КОГДА &ВидБюджетаЗакупок = &ВидБюджета
			|			ТОГДА Добавлено.Аналитика6
			|		ИНАЧЕ &Аналитика6
			|	КОНЕЦ КАК Аналитика6,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
			|	&Организация КАК Организация,
			|	Добавлено.АналитикаПредыдущегоЭтапа.АналитикаСтруктуры.ЦФО КАК ЦФО,
			|	Добавлено.АналитикаПредыдущегоЭтапа.АналитикаСтруктуры.Проект КАК Проект,
			|	Добавлено.Валюта КАК Валюта,
			|	ВЫРАЗИТЬ(Добавлено.Сумма * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)) КАК Сумма,
			|	ВЫРАЗИТЬ(Добавлено.СуммаПоПотребности * ВТ_ОтносительныеДниОплаты.Оплата / 100 КАК ЧИСЛО(18, 2)) КАК СуммаПоПотребности,
			|	ВТ_ОтносительныеДниОплаты.ТипСрока КАК ТипСрока,
			|	ВТ_ОтносительныеДниОплаты.День КАК День
			|ИЗ
			|	ВТ_ПланыДокументаДобавленныеВручную КАК Добавлено
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтносительныеДниОплаты КАК ВТ_ОтносительныеДниОплаты
			|		ПО &ДокументПланирования = ВТ_ОтносительныеДниОплаты.Ссылка И Добавлено.ДатаОперации = ВТ_ОтносительныеДниОплаты.ДатаПоступления");   
			КонецЕсли;			
		КонецЕсли;  
		
	КонецЕсли;

	Если ЕстьПотребности Тогда
		
		Запросы.Добавить(
		"ВЫБРАТЬ
		|	&ДокументПланирования КАК ДокументПланирования,
		|	ВЫБОР
		|		КОГДА АналитикиПланирования.АналитикаПредыдущегоЭтапа.ОбъектПланирования = АналитикиПланирования.ОбъектПланирования
		|			ТОГДА НЕОПРЕДЕЛЕНО
