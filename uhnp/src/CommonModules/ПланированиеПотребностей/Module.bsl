Функция ИмяКонтроляДвижений()
	Возврат ВРег("КонтрольПревышенияПланированияПотребностей");
КонецФункции

Функция ДобавитьКонтрольПланированияПотребностей(МассивКонтролей, Объект, Запрос, ТекстЗапроса)
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	
	МассивКонтролей.Добавить(ИмяКонтроляДвижений());
	ТекстЗапроса = ТекстЗапроса	+ 
	"ВЫБРАТЬ
	|	Регистр.АналитикаИсточника КАК АналитикаИсточника,
	|	Регистр.АналитикаПланирования КАК АналитикаПланирования
	|ИЗ
	|	РегистрНакопления.ПланированиеПотребностей.Остатки(
	|			,
	|			(АналитикаИсточника, АналитикаПланирования) В
	|				(ВЫБРАТЬ
	|					Коллекция.АналитикаИсточника КАК АналитикаИсточника,
	|					Коллекция.АналитикаПланирования КАК АналитикаПланирования
	|				ИЗ
	|					ПланированиеПотребностей_Изменение КАК Коллекция)) КАК Регистр
	|ГДЕ
	|	(Регистр.КоличествоОстаток < 0
	|			ИЛИ Регистр.СуммаОстаток < 0)" 
	+ ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета();
	
КонецФункции

Процедура СообщитьОбОшибкахКонтроляПланированияПотребностей(Объект, Отказ, РезультатЗапроса)
	
	ТекстСообщения = НСтр("ru = 'Превышены плановые значения при планировании потребностей'");
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Объект,,,Отказ);
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

