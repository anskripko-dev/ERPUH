 // Процедура - Параметры условий оплаты для планов документа
//
// Параметры:
//  Запрос	 - Запрос	 - 
//
Процедура ПараметрыУсловийОплатыДляПлановДокумента(Запрос, Пустая = Ложь,ПараметрыПланирования = Неопределено)
	
	Запрос.Текст = ОперативноеПланированиеКонтроль.ТекстЗапроса_ГрафикОплатПоУсловиюОплаты();
	Если Пустая = Истина Тогда
		ТекстЗапроса = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ ВТ_ОтносительныеДниОплаты", "");
		Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ОтносительныеДниОплаты ИЗ ("+ТекстЗапроса+") КАК Запрос ГДЕ ЛОЖЬ";
	КонецЕсли;
	Если ПараметрыПланирования <> Неопределено Тогда
		Запрос.УстановитьПараметр("Ссылка",ПараметрыПланирования.ДокументПланирования);  
	Иначе 
		Запрос.УстановитьПараметр("Ссылка",Неопределено);  
		
	КонецЕсли;	
	
	Запрос.Выполнить();
	
