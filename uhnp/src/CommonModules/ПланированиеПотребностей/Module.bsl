		ПараметрыАналитик.Вставить("Аналитика4БДДС", Неопределено);
		ПараметрыАналитик.Вставить("Аналитика5БДДС", Неопределено);
		ПараметрыАналитик.Вставить("Аналитика6БДДС", Неопределено); 

		ПараметрыАналитик.Вставить("АналитикиПоУмолчанию", Ложь); 
	КонецЕсли;
	
	Для Каждого ПараметрЗапроса Из ПараметрыАналитик Цикл   
