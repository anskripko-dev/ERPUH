Процедура ЗаявкаНаЗакупку_ЗаписатьВерсиюПлановДокумента(Объект, Отказ) Экспорт
	
	Если НЕ Объект.ДополнительныеСвойства.Свойство("ПланыДокумента") Тогда
		Возврат;
	КонецЕсли;
	
	//	
	ПараметрыПроведения = ПараметрыПроведения();  
	
	ПараметрыПроведения.Вставить("ИзменениеНоменклатуры", Истина);
	ПараметрыПроведения.Вставить("ИзменениеПотребностей", Истина);
	ПараметрыПроведения.Вставить("ИзменениеСтруктуры",	  Истина);
	ПараметрыПроведения.Вставить("ИзменениеПоставки",	  Ложь);
	ПараметрыПроведения.Вставить("ИзменениеВалюты", 	  Истина);
	ПараметрыПроведения.Вставить("ИзменениеДатыОперации", Истина); 
	ПараметрыПроведения.Вставить("ИзменениеПоставки",	  Истина);  
	ПараметрыПроведения.ОтражатьВБюджетах = ЗначениеЗаполнено(Объект.ВидБюджетаПланирования); 
	
	ПараметрыВерсии = Новый Структура;
	ПараметрыВерсии.Вставить("ДатаДокумента", 		Объект.Дата);
	ПараметрыВерсии.Вставить("ДокументПланирования",Объект.Ссылка);
	ПараметрыВерсии.Вставить("ОбъектПланирования",	ОбъектыПланирования.ПолучитьОбъектПланирования(Объект.Ссылка, Объект));
	ПараметрыВерсии.Вставить("ИсточникВерсии", 		Объект.Ссылка);
	ПараметрыВерсии.Вставить("ЭтапПолучатель",	 	Перечисления.ЭтапыПланированияПотребностей.ЗаявкиНаЗакупку);
	//ПараметрыВерсии.Вставить("СоздаватьНовуюВерсию",Ложь);
	ПараметрыВерсии.Вставить("РегистрироватьПланы",	Объект.Проведен);   

	ПараметрыВерсии.Вставить("ОтражатьВБюджетах", 	ЗначениеЗаполнено(Объект.ВидБюджетаПланирования));          
	
	ПараметрыВерсии.Вставить("ПараметрыПроведения", ПараметрыПроведения);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПараметрыВерсии.Вставить("МенеджерВременныхТаблиц", Запрос.МенеджерВременныхТаблиц);
	
	ПланыДокумента = Объект.ДополнительныеСвойства.ПланыДокумента;   
	
	ПланыДокумента.Колонки.Добавить("Склад",				Новый ОписаниеТипов("СправочникСсылка.Склады"));   
	ПланыДокумента.Колонки.Добавить("СтранаПроисхождения",	Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
	ПланыДокумента.Колонки.Добавить("СтранаПроизводителя",	Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
	ПланыДокумента.Колонки.Добавить("Поставщик",			Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПланыДокумента.Колонки.Добавить("НоменклатураПоставщика",Новый ОписаниеТипов("СправочникСсылка.НоменклатураПоставщиков"));
	
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ПланыДокументаДобавленныеВручную", 
		НормализоватьПланыДокумента(ПланыДокумента, ПараметрыВерсии));
	ПараметрыВерсии.Вставить("РазвернутыеАналитики", Истина); 
	
	ЗаписатьВерсиюПлановДокумента(ПараметрыВерсии, Объект.ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ЗаявкаНаЗакупку_ПередУдалением(ДокументОбъект, Отказ) Экспорт
	
	ПараметрыВерсии = Новый Структура;
	ПараметрыВерсии.Вставить("ДокументПланирования", ДокументОбъект.Ссылка);
	ПараметрыВерсии.Вставить("ОбъектПланирования",	 ОбъектыПланирования.ПолучитьОбъектПланирования(ДокументОбъект.Ссылка, ДокументОбъект));
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Получаем регистраторы, движения которых необходимо очистить
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыВерсии.ОбъектПланирования);
	Запрос.УстановитьПараметр("ДокументПланирования", ПараметрыВерсии.ДокументПланирования);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеРегистра.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ПланированиеПотребностей КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.АналитикаИсточника.ОбъектПланирования = &ОбъектПланирования
	|	И ДанныеРегистра.Регистратор ССЫЛКА Документ.РегистраторВерсииПланаДокумента
	|	И ДанныеРегистра.КорректировкаДокумента = &ДокументПланирования";
	
	РезультатРегистраторы = Запрос.Выполнить();
	Если РезультатРегистраторы.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Блокировка = БлокировкаДанныхПоРегистраторамВерсииПланов(РезультатРегистраторы);
	Блокировка.Заблокировать();	
	
	//
	НаборЗаписей1 = РегистрыНакопления.ПланированиеПотребностей.СоздатьНаборЗаписей();
	НаборЗаписей2 = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
	НаборЗаписей3 = РегистрыСведений.АналитикиБюджетов.СоздатьНаборЗаписей();
	Выборка = РезультатРегистраторы.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей1.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей1.Записать(Истина);
		
		НаборЗаписей2.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей2.Записать(Истина);
		
		НаборЗаписей3.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей3.Записать(Истина);
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры
	
#КонецОбласти

// Процедура - формирует временную таблицу ВТ_ПланыДокумента по данным сквозного планирования потребностей
//
// Параметры:
//  ПараметрыПланирования	 - Структура - Структура с параметрами планирования	см. функцию ПараметрыПроведения(..)
//  ДопПараметрыИсточника	 - 	 - 
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц - менеджер, в котором будет сформирована временная таблица
//
Процедура ПодготовитьПланыДокумента(ПараметрыПланирования) Экспорт
	
	Если Не ПараметрыПланирования.Свойство("ОтражатьВБюджетах") 
		Или ПараметрыПланирования.ОтражатьВБюджетах = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыПланирования.Менеджер;
	Запрос.УстановитьПараметр("ДокументПланирования", ПараметрыПланирования.ДокументПланирования);
	Запрос.УстановитьПараметр("ИсточникРезервирование", ПараметрыПланирования.ИсточникРезервирование);
