	|			И Коллекция.ДатаОперации = АналитикаПланирования.ДатаОперации
	|			И Коллекция.Валюта = АналитикаПланирования.Валюта
	|			И Коллекция.АналитикаСтруктуры = АналитикаПланирования.АналитикаСтруктуры
	|			И Коллекция.АналитикаПотребностей = АналитикаПланирования.АналитикаПотребностей
	|			И Коллекция.АналитикаПоставки = АналитикаПланирования.АналитикаПоставки
	|			И Коллекция.Цена = АналитикаПланирования.Цена 
	|			И Коллекция.АналитикаСтатейБюджетов = АналитикаПланирования.АналитикаСтатейБюджетов		
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	Коллекция.АналитикаИсточника,
	|	Коллекция.АналитикаПредыдущегоЭтапа,
	|	Коллекция.АналитикаПредыдущегоЭтапа,
	|	ВЫБОР
	|		КОГДА НЕ Коллекция.АналитикаПредыдущегоЭтапа.АналитикаНоменклатуры.Номенклатура ССЫЛКА Справочник.Номенклатура
	|			И Коллекция.АналитикаНоменклатуры.Номенклатура ССЫЛКА Справочник.Номенклатура ТОГДА 0
	|		ИНАЧЕ Коллекция.КоличествоИсточник
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Коллекция.АналитикаПредыдущегоЭтапа.АналитикаНоменклатуры.Номенклатура ССЫЛКА Справочник.Номенклатура
	|			ТОГДА Коллекция.СуммаИсточник 
	//Коллекция.Количество * Коллекция.АналитикаПредыдущегоЭтапа.Цена
	|		ИНАЧЕ Коллекция.СуммаИсточник
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияРасчетовСКонтрагентами.ПустаяСсылка) КАК АналитикаПартнеров
	|ИЗ
	|	ВТ_ПланыДокументаДляОбработки2 КАК Коллекция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокументаДляОбработки2";
	
	Запрос.Выполнить();

КонецПроцедуры

#Область ПодготовкаТаблицДляОтраженияВРегистрах

Процедура ТаблицаПланированиеПотребностей(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ТаблицаПланированиеПотребностей";
	
	Запросы = Новый Массив;
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланированиеПотребностей_Перенос") <> неопределено Тогда
		Запросы.Добавить(
		"ВЫБРАТЬ
		|	Перенесено.ВидДвижения КАК ВидДвижения,
		|	Перенесено.АналитикаИсточника КАК АналитикаИсточника,
		|	Перенесено.АналитикаПланирования КАК АналитикаПланирования,
		|	Перенесено.Количество КАК Количество,
		|	Перенесено.СуммаПоПотребности КАК Сумма
		|ИЗ
		|	ВТ_ПланированиеПотребностей_Перенос КАК Перенесено");
	КонецЕсли;
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланированиеПотребностей_Добавлено") <> неопределено Тогда
		Запросы.Добавить(
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	Добавлено.АналитикаИсточника КАК АналитикаИсточника,
		|	Добавлено.АналитикаПланирования КАК АналитикаПланирования,
		|	Добавлено.Количество КАК Количество,
		|	Добавлено.СуммаПоПотребности КАК Сумма
		|ИЗ
		|	ВТ_ПланированиеПотребностей_Добавлено КАК Добавлено");
	КонецЕсли;
	
	Если Запросы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Запрос.ВидДвижения КАК ВидДвижения,
	|	&Дата КАК Период,
	|	Запрос.АналитикаИсточника КАК АналитикаИсточника,
	|	Запрос.АналитикаПланирования КАК АналитикаПланирования,
	|	СУММА(Запрос.Сумма) КАК Сумма,
	|	СУММА(Запрос.Количество) КАК Количество
	|ИЗ
	|	&Коллекция КАК Запрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.ВидДвижения,
	|	Запрос.АналитикаИсточника,
	|	Запрос.АналитикаПланирования";
	

	ТекстПодзапросов = СтрСоединить(Запросы, "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Коллекция", "("+ТекстПодзапросов+")");
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

