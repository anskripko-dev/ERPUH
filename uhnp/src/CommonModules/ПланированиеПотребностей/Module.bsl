Процедура ПолучитьПланыПоОбъектуПланированияДляЗавершенияЭкспертизы(ОбъектПланирования, ПараметрыВерсии)
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыВерсии.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектПланирования);
	Запрос.УстановитьПараметр("Этап", ПараметрыВерсии.ЭтапПолучатель);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	&Этап КАК Этап,
	|	ПотребностиВНоменклатуре.АналитикаИсточника.ОбъектПланирования КАК ОбъектПланирования,
	|	ПотребностиВНоменклатуре.АналитикаИсточника.ДатаОперации КАК ДатаОперации,
	|	ПотребностиВНоменклатуре.АналитикаИсточника.Валюта КАК Валюта,
	|	ПотребностиВНоменклатуре.АналитикаИсточника.УсловиеОплаты КАК УсловиеОплаты,
	|	ПотребностиВНоменклатуре.КоличествоОборот КАК Количество,
	|	ПотребностиВНоменклатуре.СуммаОборот КАК Сумма,
	|	ПотребностиВНоменклатуре.АналитикаИсточника.Цена КАК Цена,
	|	ПотребностиВНоменклатуре.АналитикаИсточника КАК АналитикаПредыдущегоЭтапа,
	|	ПотребностиВНоменклатуре.АналитикаИсточника КАК АналитикаИсточника
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДляОбработки
	|ИЗ
	|	РегистрНакопления.ПланированиеПотребностей.Обороты(
	|			,
	|			,
	|			,
	|			АналитикаПланирования.ОбъектПланирования = &ОбъектПланирования) КАК ПотребностиВНоменклатуре";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ЗначенияАдрессацииПоУмолчанию(Знач Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтветственныеЗаФункциональныеНаправления.Организация КАК Организация,
	|	ОтветственныеЗаФункциональныеНаправления.ФункциональноеНаправление КАК ФункциональноеНаправление,
	|	ОтветственныеЗаФункциональныеНаправления.ЦФО КАК ЦФО,
	|	1 КАК ПорядокПриоритета
	|ИЗ
	|	РегистрСведений.ОтветственныеЗаФункциональныеНаправления КАК ОтветственныеЗаФункциональныеНаправления
	|ГДЕ
	|	ОтветственныеЗаФункциональныеНаправления.ФункциональноеНаправление = ЗНАЧЕНИЕ(Справочник.ФункциональныеНаправления.ПустаяСсылка)
	|	И ОтветственныеЗаФункциональныеНаправления.ЦФО <> &ПустоеЦФО
	|	И ОтветственныеЗаФункциональныеНаправления.Организация = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтветственныеЗаФункциональныеНаправления.Организация,
	|	ОтветственныеЗаФункциональныеНаправления.ФункциональноеНаправление,
	|	ОтветственныеЗаФункциональныеНаправления.ЦФО,
	|	2
	|ИЗ
	|	РегистрСведений.ОтветственныеЗаФункциональныеНаправления КАК ОтветственныеЗаФункциональныеНаправления
	|ГДЕ
	|	ОтветственныеЗаФункциональныеНаправления.ЦФО <> &ПустоеЦФО
	|	И ОтветственныеЗаФункциональныеНаправления.Организация = &ПустаяОрганизация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтветственныеЗаФункциональныеНаправления.Организация,
	|	ОтветственныеЗаФункциональныеНаправления.ФункциональноеНаправление,
	|	ОтветственныеЗаФункциональныеНаправления.ЦФО,
	|	3
	|ИЗ
	|	РегистрСведений.ОтветственныеЗаФункциональныеНаправления КАК ОтветственныеЗаФункциональныеНаправления
	|ГДЕ
	|	ОтветственныеЗаФункциональныеНаправления.ЦФО <> &ПустоеЦФО
	|	И ОтветственныеЗаФункциональныеНаправления.Организация = &ПустаяОрганизация
	|	И ОтветственныеЗаФункциональныеНаправления.ФункциональноеНаправление = ЗНАЧЕНИЕ(Справочник.ФункциональныеНаправления.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокПриоритета";
	
	Запрос.УстановитьПараметр("ПустаяОрганизация", 	Справочники.Организации.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустоеЦФО", 			Справочники.Организации.ПустаяСсылка()); 
	Запрос.УстановитьПараметр("Организация", 		Организация);
	
	ЗначенияАдрессацииПоУмолчанию = Запрос.Выполнить().Выгрузить();
	ЗначенияАдрессацииПоУмолчанию.Индексы.Добавить("ФункциональноеНаправление");
	Возврат ЗначенияАдрессацииПоУмолчанию;

КонецФункции

Процедура ЗаписатьКомментарииАналитикПланирования(Знач Запрос)
	
	Перем ЗапросКомментарииПланирования, МенеджерЗаписи, РезультатЗапроса;    
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокументаДобавленныеВручную").Колонки.Найти("Комментарий") <> Неопределено Тогда
		ЗапросКомментарииПланирования = Новый Запрос;
		ЗапросКомментарииПланирования.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
		ЗапросКомментарииПланирования.Текст = "ВЫБРАТЬ
		                                      |	ЕСТЬNULL(АналитикаПланирования.КлючАналитики, ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)) КАК АналитикаИсточника,
		                                      |	ЕСТЬNULL(АналитикаПланирования.КлючАналитики, ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)) КАК АналитикаПланирования,
		                                      |	Коллекция.Количество КАК Количество,
		                                      |	Коллекция.Сумма КАК Сумма,
		                                      |	Коллекция.ВидБюджета КАК ВидБюджета,
		                                      |	Коллекция.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
		                                      |	Коллекция.ВидБюджетаЗависимый КАК ВидБюджетаЗависимый,
		                                      |	Коллекция.АналитикаСтатейБюджетовЗависимый КАК АналитикаСтатейБюджетовЗависимый,
		                                      |	Коллекция.АналитикаПартнеров КАК АналитикаПартнеров,
		                                      |	Коллекция.Комментарий КАК Комментарий
		                                      |ИЗ
		                                      |	ВТ_ПланыДокументаДобавленныеВручнуюДляОбработки КАК Коллекция
		                                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланирования КАК АналитикаПланирования
		                                      |		ПО Коллекция.Этап = АналитикаПланирования.Этап
		                                      |			И Коллекция.ОбъектПланирования = АналитикаПланирования.ОбъектПланирования
		                                      |			И Коллекция.АналитикаСтруктуры = АналитикаПланирования.АналитикаСтруктуры
		                                      |			И Коллекция.АналитикаПотребностей = АналитикаПланирования.АналитикаПотребностей
		                                      |			И Коллекция.АналитикаПоставки = АналитикаПланирования.АналитикаПоставки
		                                      |			И Коллекция.УсловиеОплаты = АналитикаПланирования.УсловиеОплаты
		                                      |			И Коллекция.АналитикаНоменклатуры = АналитикаПланирования.АналитикаНоменклатуры
		                                      |			И Коллекция.ДатаОперации = АналитикаПланирования.ДатаОперации
		                                      |			И Коллекция.Валюта = АналитикаПланирования.Валюта
		                                      |			И Коллекция.Цена = АналитикаПланирования.Цена
		                                      |ГДЕ
		                                      |	АналитикаПланирования.КлючАналитики <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)"; 
		РезультатЗапроса = ЗапросКомментарииПланирования.Выполнить().Выбрать();    
		Пока РезультатЗапроса.Следующий() Цикл 
			Если ЗначениеЗаполнено(РезультатЗапроса.Комментарий) Тогда            
				
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("РегистрСведений.КомментарииАналитикПотребностей");
				МенеджерЗаписи = Менеджер.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.АналитикаПланирования = РезультатЗапроса.АналитикаИсточника;
				МенеджерЗаписи.Комментарий = РезультатЗапроса.Комментарий;  
				МенеджерЗаписи.Записать(Истина);                          
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#Область МэппингСтатейБюджета
// Функция по замене статей и аналитик по мэппингу      
// В Параметрах должна передаваться либо табличная часть с таблицей статей и аналитик источника, либо сама статья с
// аналитиками и источником
Функция ЗаменаСтатейИАналитикПоНастройкамЛимитов(Дата = Неопределено, ТаблицаАналитик = Неопределено, СтатьяИсточника = Неопределено,Аналитика1 = Неопределено, Аналитика2 = Неопределено, Аналитика3 = Неопределено, Аналитика4 = Неопределено, Аналитика5 = Неопределено, Аналитика6 = Неопределено) Экспорт
	
	Если Дата = Неопределено  Тогда
		Дата = ТекущаяДата();		
	КонецЕсли;	             
	
	Если ТаблицаАналитик <> Неопределено Тогда
		Возврат ОбработатьМэппингСтатейТаблицы(Дата,ТаблицаАналитик);	
	КонецЕсли;	 
	
	Если СтатьяИсточника <>Неопределено Тогда
		Возврат ПолучитьСтруктураМэппингаПоСтатьеиАналитикам(Дата,СтатьяИсточника,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6);	
	КонецЕсли;
	
КонецФункции         

Функция ОбработатьМэппингСтатейТаблицы(Дата,ТаблицаАналитик)  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСреза",Дата);
	Запрос.УстановитьПараметр("ТаблицаАналитик",ТаблицаАналитик);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаАналитик.СтатьяБюджета КАК СтатьяБюджета,
	               |	ТаблицаАналитик.Аналитика1 КАК Аналитика1,
	               |	ТаблицаАналитик.Аналитика2 КАК Аналитика2,
	               |	ТаблицаАналитик.Аналитика3 КАК Аналитика3,
	               |	ТаблицаАналитик.Аналитика4 КАК Аналитика4,
	               |	ТаблицаАналитик.Аналитика5 КАК Аналитика5,
	               |	ТаблицаАналитик.Аналитика6 КАК Аналитика6, 
	               |	ТаблицаАналитик.СтатьяБюджета КАК СтатьяБюджетаБДР,
	               |	ТаблицаАналитик.Аналитика1 КАК АналитикаБДР1,
	               |	ТаблицаАналитик.Аналитика2 КАК АналитикаБДР2,
	               |	ТаблицаАналитик.Аналитика3 КАК АналитикаБДР3,
	               |	ТаблицаАналитик.Аналитика4 КАК АналитикаБДР4,
	               |	ТаблицаАналитик.Аналитика5 КАК АналитикаБДР5,
	               |	ТаблицаАналитик.Аналитика6 КАК АналитикаБДР6				   
	               |ПОМЕСТИТЬ ТаблицаАналитик
	               |ИЗ
	               |	&ТаблицаАналитик КАК ТаблицаАналитик
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаАналитик.СтатьяБюджета КАК СтатьяБюджета,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.СтатьяБюджетаПриемник КАК СтатьяБюджетаПриемник,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика1Приемник КАК АналитикаПриемник1,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика2Приемник КАК АналитикаПриемник2,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика3Приемник КАК АналитикаПриемник3,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика4Приемник КАК АналитикаПриемник4,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика5Приемник КАК АналитикаПриемник5,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика6Приемник КАК АналитикаПриемник6
	               |ИЗ
	               |	ТаблицаАналитик КАК ТаблицаАналитик
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияСтатейМеждуВидамиБюджета.СрезПоследних(&ДатаСреза, ) КАК СоответствияСтатейМеждуВидамиБюджетаСрезПоследних
	               |		ПО (СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.СтатьяБюджетаИсточник = ТаблицаАналитик.СтатьяБюджета)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика4Приемник,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика5Приемник,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика3Приемник,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика1Приемник,
	               |	ТаблицаАналитик.СтатьяБюджета,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика2Приемник,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.СтатьяБюджетаПриемник,
	               |	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика6Приемник";
	СтатьиСоответствия = Запрос.Выполнить().Выгрузить();
	ТипСтатей = ИспользуемыеВидыБюджетовЗакупок(Дата);	 	
	Если ТипСтатей <> Неопределено И ТипСтатей.ТипЗначения.СодержитТип(ТипЗНЧ(Справочники.СтатьиДоходовИРасходов.ПустаяСсылка())) Тогда
		ПустаяСтатья = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
	ИначеЕсли ТипСтатей <>Неопределено Тогда
		ПустаяСтатья = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	КонецЕсли;	         
		
	Для Каждого СтрокаТаблицы Из ТаблицаАналитик Цикл   
		Если ТипСтатей = Неопределено Тогда
			СтрокаТаблицы.СтатьяБюджета = Неопределено;
			СтрокаТаблицы.Аналитика1 = Неопределено;
			СтрокаТаблицы.Аналитика2 = Неопределено;
			СтрокаТаблицы.Аналитика3 = Неопределено;
			СтрокаТаблицы.Аналитика4 = Неопределено;
			СтрокаТаблицы.Аналитика5 = Неопределено;
			СтрокаТаблицы.Аналитика6 = Неопределено;
			Продолжить;
		КонецЕсли;	
		Если ТипСтатей.ТипЗначения.СодержитТип(ТИПЗНЧ(СтрокаТаблицы.СтатьяБюджета)) Тогда  
        	Продолжить;
		КонецЕсли;
		ПоискПоСтатье = СтатьиСоответствия.НайтиСтроки(Новый Структура("СтатьяБюджета",СтрокаТаблицы.СтатьяБюджета));
		Если ПоискПоСтатье.Количество() = 0 Тогда
			СтрокаТаблицы.СтатьяБюджета = ПустаяСтатья;
			СтрокаТаблицы.Аналитика1 = Неопределено;
			СтрокаТаблицы.Аналитика2 = Неопределено;
			СтрокаТаблицы.Аналитика3 = Неопределено;
			СтрокаТаблицы.Аналитика4 = Неопределено;
			СтрокаТаблицы.Аналитика5 = Неопределено;
			СтрокаТаблицы.Аналитика6 = Неопределено;
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы.СтатьяБюджета = ПоискПоСтатье[0].СтатьяБюджетаПриемник;  
		ИндексАналитики = 1;  
		СтруктураАналитик = Новый Структура;
		СтруктураАналитик.Вставить("Аналитика1",);  
		СтруктураАналитик.Вставить("Аналитика2",);
		СтруктураАналитик.Вставить("Аналитика3",);
		СтруктураАналитик.Вставить("Аналитика4",);
		СтруктураАналитик.Вставить("Аналитика5",);
		СтруктураАналитик.Вставить("Аналитика6",);
		
		Пока ИндексАналитики <= 6 Цикл
			
			СтруктураАналитик["Аналитика" + ИндексАналитики]  = ПоискПоСтатье[0]["АналитикаПриемник"+ИндексАналитики];
			
			Если ТИПЗНЧ(СтруктураАналитик["Аналитика" + ИндексАналитики]) = ТИПЗНЧ(СтрокаТаблицы.Аналитика1) Тогда
				СтруктураАналитик["Аналитика" + ИндексАналитики] = СтрокаТаблицы.Аналитика1;
			КонецЕсли;	

			Если ТИПЗНЧ(СтруктураАналитик["Аналитика" + ИндексАналитики]) = ТИПЗНЧ(СтрокаТаблицы.Аналитика2) Тогда
				СтруктураАналитик["Аналитика" + ИндексАналитики] = СтрокаТаблицы.Аналитика2;
			КонецЕсли;	
			
			Если ТИПЗНЧ(СтруктураАналитик["Аналитика" + ИндексАналитики]) = ТИПЗНЧ(СтрокаТаблицы.Аналитика3) Тогда
				СтруктураАналитик["Аналитика" + ИндексАналитики] = СтрокаТаблицы.Аналитика3;
			КонецЕсли;				

			Если ТИПЗНЧ(СтруктураАналитик["Аналитика" + ИндексАналитики]) = ТИПЗНЧ(СтрокаТаблицы.Аналитика4) Тогда
				СтруктураАналитик["Аналитика" + ИндексАналитики] = СтрокаТаблицы.Аналитика4;
			КонецЕсли;	
			
			Если ТИПЗНЧ(СтруктураАналитик["Аналитика" + ИндексАналитики]) = ТИПЗНЧ(СтрокаТаблицы.Аналитика5) Тогда
				СтруктураАналитик["Аналитика" + ИндексАналитики] = СтрокаТаблицы.Аналитика5;
			КонецЕсли;	
			
			Если ТИПЗНЧ(СтруктураАналитик["Аналитика" + ИндексАналитики]) = ТИПЗНЧ(СтрокаТаблицы.Аналитика6) Тогда
				СтруктураАналитик["Аналитика" + ИндексАналитики] = СтрокаТаблицы.Аналитика6;
			КонецЕсли;				
			ИндексАналитики = ИндексАналитики + 1;	
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы,СтруктураАналитик);
	КонецЦикла;	
	Возврат ТаблицаАналитик;
КонецФункции

Функция ПолучитьСтруктураМэппингаПоСтатьеиАналитикам(Дата,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6)
	
	СтруктураОтвета = Новый Структура();
	ТипСтатей = ИспользуемыеВидыБюджетовЗакупок(Дата);
	Если ТипСтатей.ТипЗначения.СодержитТип(ТИПЗНЧ(СтатьяБюджета)) Тогда  
		СтруктураОтвета.Вставить("СтатьяБюджета",СтатьяБюджета);
		СтруктураОтвета.Вставить("Аналитика1",Аналитика1);
		СтруктураОтвета.Вставить("Аналитика2",Аналитика2);
		СтруктураОтвета.Вставить("Аналитика3",Аналитика3);
		СтруктураОтвета.Вставить("Аналитика4",Аналитика4);
		СтруктураОтвета.Вставить("Аналитика5",Аналитика5);
		СтруктураОтвета.Вставить("Аналитика6",Аналитика6);
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСреза", Дата);
	Запрос.УстановитьПараметр("СтатьяБюджетаИсточник",СтатьяБюджета);
	Запрос.Текст = "ВЫБРАТЬ
	|	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.СтатьяБюджетаПриемник КАК СтатьяБюджета,
	|	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика1Приемник КАК АналитикаПриемник1,
	|	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика2Приемник КАК АналитикаПриемник2,
	|	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика3Приемник КАК АналитикаПриемник3,
	|	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика4Приемник КАК АналитикаПриемник4,
	|	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика5Приемник КАК АналитикаПриемник5,
	|	СоответствияСтатейМеждуВидамиБюджетаСрезПоследних.Аналитика6Приемник КАК АналитикаПриемник6
	|ИЗ
	|	РегистрСведений.СоответствияСтатейМеждуВидамиБюджета.СрезПоследних(&ДатаСреза, СтатьяБюджетаИсточник = &СтатьяБюджетаИсточник) КАК СоответствияСтатейМеждуВидамиБюджетаСрезПоследних";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();    
	
	Если ТипСтатей.ТипЗначения.СодержитТип(ТипЗНЧ(Справочники.СтатьиДоходовИРасходов.ПустаяСсылка())) Тогда
		ПустаяСтатья = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
	Иначе
		ПустаяСтатья = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	КонецЕсли;	
	Если РезультатЗапроса.Количество() = 0 Тогда
		СтруктураОтвета.Вставить("СтатьяБюджета",ПустаяСтатья);
		СтруктураОтвета.Вставить("Аналитика1",Неопределено);
		СтруктураОтвета.Вставить("Аналитика2",Неопределено);
		СтруктураОтвета.Вставить("Аналитика3",Неопределено);
		СтруктураОтвета.Вставить("Аналитика4",Неопределено);
		СтруктураОтвета.Вставить("Аналитика5",Неопределено);
		СтруктураОтвета.Вставить("Аналитика6",Неопределено);
		Возврат СтруктураОтвета;
	КонецЕсли;           
	ВыборкаЗаписей = РезультатЗапроса.Получить(0);      
	СтруктураОтвета.Вставить("СтатьяБюджета",ВыборкаЗаписей.СтатьяБюджета);
	ИндексАналитики = 1;       
	СтруктураАналитик = Новый Структура;
	СтруктураАналитик.Вставить("АналитикаПриемник1",);  
	СтруктураАналитик.Вставить("АналитикаПриемник2",);
	СтруктураАналитик.Вставить("АналитикаПриемник3",);
	СтруктураАналитик.Вставить("АналитикаПриемник4",);
	СтруктураАналитик.Вставить("АналитикаПриемник5",);
	СтруктураАналитик.Вставить("АналитикаПриемник6",);
	
	Пока ИндексАналитики <= 6 Цикл
		
		СтруктураАналитик["АналитикаПриемник" + ИндексАналитики]  = ВыборкаЗаписей["АналитикаПриемник"+ИндексАналитики];
		Если ТИПЗНЧ(ВыборкаЗаписей["АналитикаПриемник"+ИндексАналитики]) = ТИПЗНЧ(Аналитика1) Тогда
			СтруктураАналитик["АналитикаПриемник" + ИндексАналитики]   = Аналитика1;
		КонецЕсли;	
		Если ТИПЗНЧ(ВыборкаЗаписей["АналитикаПриемник"+ИндексАналитики]) = ТИПЗНЧ(Аналитика2) Тогда
			СтруктураАналитик["АналитикаПриемник" + ИндексАналитики]   = Аналитика2;
		КонецЕсли;	
		Если ТИПЗНЧ(ВыборкаЗаписей["АналитикаПриемник"+ИндексАналитики]) = ТИПЗНЧ(Аналитика3) Тогда
			СтруктураАналитик["АналитикаПриемник" + ИндексАналитики]   = Аналитика4;
		КонецЕсли;	
		Если ТИПЗНЧ(ВыборкаЗаписей["АналитикаПриемник"+ИндексАналитики]) = ТИПЗНЧ(Аналитика4) Тогда
			СтруктураАналитик["АналитикаПриемник" + ИндексАналитики]   = Аналитика4;
		КонецЕсли;	
		Если ТИПЗНЧ(ВыборкаЗаписей["АналитикаПриемник"+ИндексАналитики]) = ТИПЗНЧ(Аналитика5) Тогда
			СтруктураАналитик["АналитикаПриемник" + ИндексАналитики]   = Аналитика5;
		КонецЕсли;	
		Если ТИПЗНЧ(ВыборкаЗаписей["АналитикаПриемник"+ИндексАналитики]) = ТИПЗНЧ(Аналитика6) Тогда
			СтруктураАналитик["АналитикаПриемник" + ИндексАналитики]   = Аналитика6;
		КонецЕсли;	

		ИндексАналитики = ИндексАналитики + 1;	
	КонецЦикла;
	СтруктураОтвета.Вставить("Аналитика1",СтруктураАналитик.АналитикаПриемник1);
	СтруктураОтвета.Вставить("Аналитика2",СтруктураАналитик.АналитикаПриемник2);
	СтруктураОтвета.Вставить("Аналитика3",СтруктураАналитик.АналитикаПриемник3);
	СтруктураОтвета.Вставить("Аналитика4",СтруктураАналитик.АналитикаПриемник4);
	СтруктураОтвета.Вставить("Аналитика5",СтруктураАналитик.АналитикаПриемник5);
	СтруктураОтвета.Вставить("Аналитика6",СтруктураАналитик.АналитикаПриемник6);
	
	СтруктураОтвета.Вставить("СтатьяБюджетаБДР",ВыборкаЗаписей.СтатьяБюджета);
	СтруктураОтвета.Вставить("АналитикаБДР1",СтруктураАналитик.АналитикаПриемник1);
	СтруктураОтвета.Вставить("АналитикаБДР2",СтруктураАналитик.АналитикаПриемник2);
	СтруктураОтвета.Вставить("АналитикаБДР3",СтруктураАналитик.АналитикаПриемник3);
	СтруктураОтвета.Вставить("АналитикаБДР4",СтруктураАналитик.АналитикаПриемник4);
	СтруктураОтвета.Вставить("АналитикаБДР5",СтруктураАналитик.АналитикаПриемник5);
	СтруктураОтвета.Вставить("АналитикаБДР6",СтруктураАналитик.АналитикаПриемник6);
	
	Возврат СтруктураОтвета;
	
КонецФункции
#КонецОбласти


#КонецОбласти


