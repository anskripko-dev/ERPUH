Функция ИспользуемыеВидыБюджетовЗакупок(ДатаСреза = Неопределено) Экспорт
	
	Если ДатаСреза = Неопределено
			ИЛИ Не ЗначениеЗаполнено(ДатаСреза) Тогда
		 ДатаСреза = ТекущаяДатаСеанса();
	КонецЕсли;	 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЛимитированияСрезПоследних.Период КАК Период,
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета
	|ПОМЕСТИТЬ ВТ_ПараметрыЛимитирования
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования.СрезПоследних(&ДатаСреза, ) КАК ПараметрыЛимитированияСрезПоследних
	|ГДЕ
	|	ПараметрыЛимитированияСрезПоследних.ПланированиеЗакупок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_ПараметрыЛимитирования.Период) КАК ПериодМаксимальный
	|ПОМЕСТИТЬ ВТ_Периоды
	|ИЗ
	|	ВТ_ПараметрыЛимитирования КАК ВТ_ПараметрыЛимитирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	ВТ_ПараметрыЛимитирования КАК ВТ_ПараметрыЛимитирования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Периоды КАК ВТ_Периоды
	|		ПО ВТ_ПараметрыЛимитирования.Период = ВТ_Периоды.ПериодМаксимальный";

	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий(); 
	
	Возврат ВыборкаДетальныеЗаписи.ВидБюджета;

КонецФункции


