
#Область СлужебныйПрограммныйИнтерфейс

Функция СквозноеПланированиеПотребностей(Параметры =  неопределено) Экспорт
	Возврат ПолучитьФункциональнуюОпцию("СквозноеПланированиеПотребности");
КонецФункции

Функция ЗаполнитьПоДаннымРегистраПотребностей(ПараметрыОтбора) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Коллекция.АналитикаИсточника КАК АналитикаИсточника,
	|	Коллекция.АналитикаПланирования КАК АналитикаПланирования,
	|	Коллекция.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Номенклатура,
	|	Коллекция.АналитикаПланирования.АналитикаНоменклатуры.Характеристика КАК Характеристика,
	|	Коллекция.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Коллекция.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент КАК Коэффициент,
	|	Коллекция.АналитикаПланирования.ДатаОперации КАК ДатаОперации,
	|	Коллекция.АналитикаПланирования.Валюта КАК Валюта,
	|	Коллекция.КоличествоОстаток КАК Количество,
	|	Коллекция.АналитикаПланирования.Цена КАК Цена,
	|	Коллекция.СуммаОстаток КАК Сумма,
	|	Коллекция.КоличествоОстаток КАК КоличествоИсточник,
	|	Коллекция.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмеренияИсточник,
	|	Коллекция.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент КАК КоэффициентИсточник,
	|	Коллекция.АналитикаИсточника.Цена КАК ЦенаИсточник,
	|	Коллекция.СуммаОстаток КАК СуммаИсточник
	|ИЗ
	|	РегистрНакопления.ПланированиеПотребностей.Остатки(, &УсловияПоиска) КАК Коллекция";
	
	УсловияПоиска = Новый Массив;
	Для Каждого КлючЗначение Из ПараметрыОтбора Цикл
		Если КлючЗначение.Ключ = "ОбъектПланирования" Тогда
			УсловияПоиска.Добавить("АналитикаПланирования.ОбъектПланирования = &ОбъектПланирования");
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		ИначеЕсли КлючЗначение.Ключ = "Этап" Тогда
			УсловияПоиска.Добавить("АналитикаПланирования.Этап В (&Этап)");
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		ИначеЕсли КлючЗначение.Ключ = "Организация" Тогда
			УсловияПоиска.Добавить("АналитикаПланирования.АналитикаСтруктуры.Организация = &Организация");
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		ИначеЕсли КлючЗначение.Ключ = "АналитикаИсточника_ЦФО" Тогда
			УсловияПоиска.Добавить("АналитикаИсточника.АналитикаСтруктуры.ЦФО = &АналитикаИсточника_ЦФО");
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловияПоиска", СтрСоединить(УсловияПоиска, " И "));
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПараметрыПроведения() Экспорт
	ПараметрыПроведения = Новый Структура;
	ПараметрыПроведения.Вставить("ИзменениеНоменклатуры", Ложь);
	ПараметрыПроведения.Вставить("ИзменениеПотребностей", Ложь);
	ПараметрыПроведения.Вставить("ИзменениеСтруктуры",	  Ложь);
	ПараметрыПроведения.Вставить("ИзменениеПоставки",	  Ложь);
	ПараметрыПроведения.Вставить("ИзменениеПартнера",	  Ложь);
	ПараметрыПроведения.Вставить("ИзменениеВалюты", 	  Истина);
	ПараметрыПроведения.Вставить("ИзменениеДатыОперации", Истина);
	ПараметрыПроведения.Вставить("ТребуетсяКонтроль", 	  Истина);

	ПараметрыПроведения.Вставить("ОтражатьВБюджетах", 	  СквозноеПланированиеПотребностей());
	
	ПараметрыПроведения.Вставить("РегистрацияФакта", 	  Ложь); 		// Для документов, регистрирующих факт
	ПараметрыПроведения.Вставить("ИсточникРезервирование",Ложь);		// Используется для заявки на закупку. Истина, если закупка 
																 		// оформляется на основании ранее произведенного резервирования.
	ПараметрыПроведения.Вставить("ДокументРезервирования");				// Используется для заявки на закупку. <> неопределено, если закупка 
																 		// оформляется на основании ранее произведенного резервирования.
	ПараметрыПроведения.Вставить("ОбъектРезервирования");				// Используется для заявки на закупку. <> неопределено, если закупка 
																 		// оформляется на основании ранее произведенного резервирования.
	
	Возврат ПараметрыПроведения;
КонецФункции

// Процедура 
//
// Параметры:
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц	 - Запрос с подготовленными временными таблицами ВТ_ПланыДокументаДляОбработки и ВТ_ПланыДокументаИсходные
//
Процедура ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования, МенеджерВременныхТаблиц = неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда 
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = ПараметрыПланирования.Менеджер;
	КонецЕсли;

	ОбработатьДобавленныеПотребности(ПараметрыПланирования, Запрос);
	ОбработатьПотребности(ПараметрыПланирования, Запрос);

    Если НЕ ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		ПараметрыУсловийОплатыДляПлановДокумента(Запрос);
	Иначе 
		ПараметрыУсловийОплатыДляПлановДокумента(Запрос,,ПараметрыПланирования);
	КонецЕсли;
	
КонецПроцедуры

// Процедура 
//
// Параметры:
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц	 - Запрос с подготовленными временными таблицами ВТ_ПланыДокументаДляОбработки и ВТ_ПланыДокументаИсходные
//
Процедура ПодготовитьДанныеПланированияДокументаЗамены(ПараметрыПланирования, МенеджерВременныхТаблиц = неопределено, ИсточникиПолей = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда 
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = ПараметрыПланирования.Менеджер;
	КонецЕсли;

	ОбработатьДобавленныеПотребности(ПараметрыПланирования, Запрос);
	ОбработатьПотребностиДокументаЗамены(ПараметрыПланирования, Запрос, ИсточникиПолей);


	ПараметрыУсловийОплатыДляПлановДокумента(Запрос,,ПараметрыПланирования);
	
КонецПроцедуры

#Область ПередачаЗаказчику

Процедура ПодготовитьДанныеПередачаЗаказчику(МенеджерВременныхТаблиц) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	//
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	Коллекция.АналитикаИсточника КАК АналитикаИсточника,
	|	Коллекция.АналитикаПредыдущегоЭтапа КАК АналитикаПланирования,
	|	Коллекция.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА Коллекция.АналитикаПредыдущегоЭтапа.АналитикаНоменклатуры.Номенклатура ССЫЛКА Справочник.Номенклатура
	|			ТОГДА Коллекция.Количество * Коллекция.АналитикаПредыдущегоЭтапа.Цена
	|		ИНАЧЕ Коллекция.Сумма
	|	КОНЕЦ КАК Сумма, 
	|	ВЫБОР
	|		КОГДА Коллекция.АналитикаПредыдущегоЭтапа.АналитикаНоменклатуры.Номенклатура ССЫЛКА Справочник.Номенклатура
	|			ТОГДА Коллекция.Количество * Коллекция.АналитикаПредыдущегоЭтапа.Цена
	|		ИНАЧЕ Коллекция.Сумма
	|	КОНЕЦ КАК СуммаПоПотребности	
	|ПОМЕСТИТЬ ВТ_ПланированиеПотребностей_Перенос
	|ИЗ
	|	ВТ_ПланыДокументаДляОбработки КАК Коллекция";
	Запрос.Выполнить();
	
	ПараметрыУсловийОплатыДляПлановДокумента(Запрос, Истина);
	
КонецПроцедуры

#КонецОбласти

Процедура ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры = неопределено, ФормироватьОперацииБюджетов = Истина, ПараметрыПланирования = неопределено) Экспорт
	
	ТолькоПланыПоПоставке = Ложь;
	Если ТипЗнч(ПараметрыПланирования) = Тип("Структура") Тогда
		Если ПараметрыПланирования.Свойство("ОтражатьВБюджетах") Тогда
			ФормироватьОперацииБюджетов = ПараметрыПланирования.ОтражатьВБюджетах;
		КонецЕсли;
		Если ПараметрыПланирования.Свойство("ТолькоПланыПоПоставке") Тогда
			ТолькоПланыПоПоставке = ПараметрыПланирования.ТолькоПланыПоПоставке;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТолькоПланыПоПоставке", ТолькоПланыПоПоставке);
	
	ТаблицаПланированиеПотребностей(Запрос, ТекстыЗапроса, Регистры);
	Если ФормироватьОперацииБюджетов = Истина Тогда
		ТаблицаАналитикиБюджетов(Запрос, ТекстыЗапроса, Регистры);
		ТаблицаОперацийБюджетов(Запрос, ТекстыЗапроса, Регистры);
	КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьТаблицыПланированияДляЗаявкиНаЗакупку(Запрос, ТекстыЗапроса, Регистры = неопределено, ФормироватьОперацииБюджетов = Истина) Экспорт
	
	ТаблицаПланированиеПотребностейДляЗаявкиНаЗакупку(Запрос, ТекстыЗапроса, Регистры);
	ТаблицаАналитикиБюджетов(Запрос, ТекстыЗапроса, Регистры);
	Если ФормироватьОперацииБюджетов = Истина Тогда
		ТаблицаОперацийБюджетов(Запрос, ТекстыЗапроса, Регистры);
	КонецЕсли;
КонецПроцедуры

Процедура ОтразитьДвиженияПланирования(ДополнительныеСвойства, Движения, Отказ) Экспорт
	ОтразитьАналитикиБюджетов(ДополнительныеСвойства, Движения, Отказ);
	ОтразитьПланированиеПотребностей(ДополнительныеСвойства, Движения, Отказ);
	ОтразитьОперацииБюджетов(ДополнительныеСвойства, Движения, Отказ);
КонецПроцедуры

Процедура СформироватьСписокРегистровДляКонтроля(Объект) Экспорт
	
	Если НЕ Объект.ДополнительныеСвойства.ДляПроведения.Свойство("РегистрыДляКонтроля") Тогда
		Объект.ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Новый Массив);
	КонецЕсли;
	Объект.ДополнительныеСвойства.ДляПроведения.РегистрыДляКонтроля.Добавить(
		Объект.Движения.ПланированиеПотребностей);
	
КонецПроцедуры

#Область КонтрольДвижений

Процедура ДополнитьМассивКонтролей(МассивКонтролей, Объект, ПакетЗапросов, ТекстЗапроса, ДанныеТаблиц) Экспорт
	
	Если Объект.ДополнительныеСвойства.Свойство("ДляПроведения") = ЛОЖЬ 
		ИЛИ Объект.ДополнительныеСвойства.ДляПроведения.Свойство("РегистрыДляКонтроля") = ЛОЖЬ 
		ИЛИ ТипЗнч(Объект.ДополнительныеСвойства.ДляПроведения.РегистрыДляКонтроля) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Если ПроведениеСерверОПК.ЕстьИзмененияВТаблице(ДанныеТаблиц, "ПланированиеПотребностей_Изменение") Тогда
		ДобавитьКонтрольПланированияПотребностей(МассивКонтролей, Объект, ПакетЗапросов, ТекстЗапроса);
	КонецЕсли;
	
КонецПроцедуры

Функция СообщитьОбОшибкахКонтроляПроведения(ИмяКонтроля, Объект, Отказ, Результат) Экспорт
	
	Если ИмяКонтроля = ИмяКонтроляДвижений() Тогда
		СообщитьОбОшибкахКонтроляПланированияПотребностей(Объект, Отказ, Результат);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#Область ИныеДокументы

Процедура ПодготовитьТаблицуОперацийБюджетовПоПланамДокумента(Запрос, ТаблицыДляДвижений, ИмяВременнойТаблицы) Экспорт
	
	Перем ИменаПолей, ИмяТаблицыДвижений, ТаблицаПланов; 
	
	ИмяТаблицыДвижений = "ТаблицаОперацииБюджетов"; 
	// Таблица потребностей   
	ТаблицаПланов = Запрос.МенеджерВременныхТаблиц.Таблицы[ИмяВременнойТаблицы].ПолучитьДанные().Выгрузить();
	
	Если ТаблицаПланов.Колонки.Найти("АналитикаНоменклатуры") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияНоменклатуры"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаПартнеров") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаПартнеров", 	Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияРасчетовСКонтрагентами"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаПотребностей") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаПотребностей", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияПотребностей"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаСтатейБюджетов") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаСтатейБюджетов", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияСтатейБюджетов"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаСтруктуры") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаСтруктуры", 	Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияСтруктуры"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаПартнеров") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаПартнеров", 	Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияРасчетовСКонтрагентами"));
	КонецЕсли;
	
	Если ТаблицаПланов.Колонки.Найти("НомерСтроки") = неопределено Тогда
		ТаблицаПланов.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(9,0, ДопустимыйЗнак.Неотрицательный));  
		НомерСтроки = 0;
		Для Каждого СтрокаПланов Из ТаблицаПланов Цикл      
			НомерСтроки = НомерСтроки + 1;
			СтрокаПланов.НомерСтроки = НомерСтроки;
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаПланов.Колонки.Найти("ОбъектПланирования") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("ОбъектПланирования", Новый ОписаниеТипов("СправочникСсылка.ОбъектыПланирования"));
		ТребуетсяВыполнитьПолучениеОбъектовПланирования = Истина;
	КонецЕсли;

	Если ТаблицаПланов.Колонки.Найти("ДатаРегистрации") = неопределено Тогда
		ТаблицаПланов.Колонки.Добавить("ДатаРегистрации", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	КонецЕсли;
	
	// КлючиАналитикиПланированияСтруктуры  
	ИменаПолей = РегистрыСведений.АналитикаПланированияСтруктуры.ИменаПолейКоллекцииПоУмолчанию();
	ИменаПолей.АналитикаПланированияСтруктуры = "АналитикаСтруктуры";
	РегистрыСведений.АналитикаПланированияСтруктуры.ЗаполнитьВКоллекции(ТаблицаПланов, ИменаПолей);
	
	// КлючиАналитикиПланированияСтатейБюджетов 
	ИменаПолей = РегистрыСведений.АналитикаПланированияСтатейБюджетов.ИменаПолейКоллекцииПоУмолчанию();
	ИменаПолей.АналитикаПланированияСтатейБюджетов = "АналитикаСтатейБюджетов";
	РегистрыСведений.АналитикаПланированияСтатейБюджетов.ЗаполнитьВКоллекции(ТаблицаПланов, ИменаПолей);
	
	Если ТаблицаПланов.Колонки.Найти("Контрагент") <> неопределено Тогда
		ИменаПолей = РегистрыСведений.АналитикаПланированияРасчетовСКонтрагентами.ИменаПолейКоллекцииПоУмолчанию();
		ИменаПолей.АналитикаПланированияРасчетовСКонтрагентами = "АналитикаПартнеров";
		
		Если НЕ ТаблицаПланов.Колонки.Найти("Организация") <> неопределено Тогда
			ИменаПолей.Организация = неопределено;
		КонецЕсли;

		Если ТаблицаПланов.Колонки.Найти("ДоговорКонтрагента") <> неопределено Тогда
			ИменаПолей.Договор = "ДоговорКонтрагента";
		ИначеЕсли ТаблицаПланов.Колонки.Найти("Договор") <> неопределено Тогда
			ИменаПолей.Договор = "Договор";
		Иначе
			ИменаПолей.Договор = неопределено;
		КонецЕсли;

		ИменаПолей.ОбъектРасчетов = "ОбъектРасчетов";
		Если ТаблицаПланов.Колонки.Найти("ОбъектРасчетов") = неопределено Тогда
	    	ТаблицаПланов.Колонки.Добавить("ОбъектРасчетов", Метаданные.ОпределяемыеТипы.ОбъектРасчетовУХ.Тип);
		КонецЕсли;
		
		РегистрыСведений.АналитикаПланированияРасчетовСКонтрагентами.ЗаполнитьВКоллекции(ТаблицаПланов, ИменаПолей);
	КонецЕсли;
	                                              
	// ОбъектыПланирования
	Если ТребуетсяВыполнитьПолучениеОбъектовПланирования = Истина 
		И ТаблицаПланов.Колонки.Найти("ДокументПланирования") <> неопределено Тогда
		СтруктураПоиска = Новый Структура("ОбъектПланирования", Справочники.ОбъектыПланирования.ПустаяСсылка());
		ДокументыПланирования = ТаблицаПланов.Скопировать(, "ДокументПланирования, ОбъектПланирования");
		ДокументыПланирования.Свернуть("ДокументПланирования, ОбъектПланирования", "");
		Для Каждого СтрокаДокумент Из ДокументыПланирования Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаДокумент.ДокументПланирования) Тогда
				Продолжить;
			КонецЕсли;
			ОбъектПланирования = ОбъектыПланирования.ПолучитьОбъектПланирования(СтрокаДокумент.ДокументПланирования);
			СтруктураПоиска.Вставить("ДокументПланирования", СтрокаДокумент.ДокументПланирования);
			Строки = ТаблицаПланов.НайтиСтроки(СтруктураПоиска);
			Для Каждого Строка Из Строки Цикл
				Строка.ОбъектПланирования = ОбъектПланирования;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ЕстьСуммаИсполнено = ТаблицаПланов.Колонки.Найти("СуммаИсполнено") <> неопределено;
	
	//
	Измерения = "Период,ВидБюджета,ОбъектПланирования,АналитикаСтруктуры,АналитикаСтатейБюджетов,АналитикаНоменклатуры,АналитикаПотребностей,АналитикаПартнеров,ПриходРасход,Валюта,ДатаРегистрации";
	ИменаРесурсов = "Сумма";
	Если ЕстьСуммаИсполнено Тогда
		ИменаРесурсов = ИменаРесурсов + ", СуммаИсполнено";
	КонецЕсли;
	
	ТаблицаПланов.Свернуть(Измерения, ИменаРесурсов);
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Сумма", 0);
	Если ЕстьСуммаИсполнено Тогда
		СтруктураПоиска.Вставить("СуммаИсполнено", 0);
	КонецЕсли;
	
	СтрокиКУдалению = ТаблицаПланов.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		ТаблицаПланов.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	ТаблицыДляДвижений.Вставить(ИмяТаблицыДвижений, ТаблицаПланов);

КонецПроцедуры     

Процедура ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ТаблицыДляДвижений, ИмяВременнойТаблицы) Экспорт
	
	Перем ИменаПолей, ИмяТаблицыДвижений, ТаблицаПланов; 
	
	ИмяТаблицыДвижений = "ТаблицаОперацииБюджетов"; 
	// Таблица потребностей   
	ТаблицаПланов = Запрос.МенеджерВременныхТаблиц.Таблицы[ИмяВременнойТаблицы].ПолучитьДанные().Выгрузить();
	
	Если ТаблицаПланов.Колонки.Найти("АналитикаНоменклатуры") = Неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияНоменклатуры"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаПартнеров") = Неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаПартнеров", 	Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияРасчетовСКонтрагентами"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаПотребностей") = Неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаПотребностей", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияПотребностей"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаСтатейБюджетов") = Неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаСтатейБюджетов", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияСтатейБюджетов"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаСтруктуры") = Неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаСтруктуры", 	Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияСтруктуры"));
	КонецЕсли;
	Если ТаблицаПланов.Колонки.Найти("АналитикаПартнеров") = Неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("АналитикаПартнеров", 	Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПланированияРасчетовСКонтрагентами"));
	КонецЕсли;
	
	Если ТаблицаПланов.Колонки.Найти("НомерСтроки") = неопределено Тогда
		ТаблицаПланов.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(9,0, ДопустимыйЗнак.Неотрицательный));  
		НомерСтроки = 0;
		Для Каждого СтрокаПланов Из ТаблицаПланов Цикл      
			НомерСтроки = НомерСтроки + 1;
			СтрокаПланов.НомерСтроки = НомерСтроки;
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаПланов.Колонки.Найти("ОбъектПланирования") = неопределено Тогда
    	ТаблицаПланов.Колонки.Добавить("ОбъектПланирования", Новый ОписаниеТипов("СправочникСсылка.ОбъектыПланирования"));
		ТребуетсяВыполнитьПолучениеОбъектовПланирования = Истина;
	КонецЕсли;

	Если ТаблицаПланов.Колонки.Найти("ДатаРегистрации") = неопределено Тогда
		ТаблицаПланов.Колонки.Добавить("ДатаРегистрации", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	КонецЕсли;
	
	// КлючиАналитикиПланированияСтруктуры  
	ИменаПолей = РегистрыСведений.АналитикаПланированияСтруктуры.ИменаПолейКоллекцииПоУмолчанию();
	ИменаПолей.АналитикаПланированияСтруктуры = "АналитикаСтруктуры";
	РегистрыСведений.АналитикаПланированияСтруктуры.ЗаполнитьВКоллекции(ТаблицаПланов, ИменаПолей);
	
	// КлючиАналитикиПланированияСтатейБюджетов 
	ИменаПолей = РегистрыСведений.АналитикаПланированияСтатейБюджетов.ИменаПолейКоллекцииПоУмолчанию();
	ИменаПолей.АналитикаПланированияСтатейБюджетов = "АналитикаСтатейБюджетов";
	РегистрыСведений.АналитикаПланированияСтатейБюджетов.ЗаполнитьВКоллекции(ТаблицаПланов, ИменаПолей);
	
	Если ТаблицаПланов.Колонки.Найти("Контрагент") <> неопределено Тогда
		ИменаПолей = РегистрыСведений.АналитикаПланированияРасчетовСКонтрагентами.ИменаПолейКоллекцииПоУмолчанию();
		ИменаПолей.АналитикаПланированияРасчетовСКонтрагентами = "АналитикаПартнеров";
		
		Если НЕ ТаблицаПланов.Колонки.Найти("Организация") <> неопределено Тогда
			ИменаПолей.Организация = неопределено;
		КонецЕсли;

		Если ТаблицаПланов.Колонки.Найти("ДоговорКонтрагента") <> неопределено Тогда
			ИменаПолей.Договор = "ДоговорКонтрагента";
		ИначеЕсли ТаблицаПланов.Колонки.Найти("Договор") <> неопределено Тогда
			ИменаПолей.Договор = "Договор";
		Иначе
			ИменаПолей.Договор = неопределено;
		КонецЕсли;

		ИменаПолей.ОбъектРасчетов = "ОбъектРасчетов";
		Если ТаблицаПланов.Колонки.Найти("ОбъектРасчетов") = неопределено Тогда
	    	ТаблицаПланов.Колонки.Добавить("ОбъектРасчетов", Метаданные.ОпределяемыеТипы.ОбъектРасчетовУХ.Тип);
		КонецЕсли;
		
		РегистрыСведений.АналитикаПланированияРасчетовСКонтрагентами.ЗаполнитьВКоллекции(ТаблицаПланов, ИменаПолей);
	КонецЕсли;
	                                              
	// ОбъектыПланирования
	Если ТребуетсяВыполнитьПолучениеОбъектовПланирования = Истина 
		И ТаблицаПланов.Колонки.Найти("ДокументПланирования") <> неопределено Тогда
		СтруктураПоиска = Новый Структура("ОбъектПланирования", Справочники.ОбъектыПланирования.ПустаяСсылка());
		ДокументыПланирования = ТаблицаПланов.Скопировать(, "ДокументПланирования, ОбъектПланирования");
		ДокументыПланирования.Свернуть("ДокументПланирования, ОбъектПланирования", "");
		Для Каждого СтрокаДокумент Из ДокументыПланирования Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаДокумент.ДокументПланирования) Тогда
				Продолжить;
			КонецЕсли;
			ОбъектПланирования = ОбъектыПланирования.ПолучитьОбъектПланирования(СтрокаДокумент.ДокументПланирования);
			СтруктураПоиска.Вставить("ДокументПланирования", СтрокаДокумент.ДокументПланирования);
			Строки = ТаблицаПланов.НайтиСтроки(СтруктураПоиска);
			Для Каждого Строка Из Строки Цикл
				Строка.ОбъектПланирования = ОбъектПланирования;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ЕстьСуммаИсполнено = ТаблицаПланов.Колонки.Найти("СуммаИсполнено") <> неопределено;
	ЕстьСумма = Не (ТаблицаПланов.Колонки.Найти("Сумма") = Неопределено); 
	ЕстьЛимит = Не (ТаблицаПланов.Колонки.Найти("Лимит") = Неопределено);

	Измерения = "Период,ВидБюджета,ОбъектПланирования,АналитикаСтруктуры,АналитикаСтатейБюджетов,АналитикаНоменклатуры,
				|АналитикаПотребностей,АналитикаПартнеров,ПриходРасход,Валюта,ДатаРегистрации";
	
	ИменаРесурсов = "Сумма";
	Если ЕстьСумма И ЕстьЛимит Тогда
		ИменаРесурсов = "Сумма, Лимит";	  
	ИначеЕсли Не ЕстьСумма И ЕстьЛимит Тогда
		ИменаРесурсов = "Лимит";
	КонецЕсли;   
	
	Если ЕстьСуммаИсполнено Тогда
		ИменаРесурсов = ИменаРесурсов + ", СуммаИсполнено";
	КонецЕсли;
	
	Если ТаблицаПланов.Колонки.Найти("Регистратор") <> неопределено Тогда
		Измерения =  Измерения + ", Регистратор";
	КонецЕсли;  
	
	Если Не ТаблицаПланов.Колонки.Найти("КурсЗаданВОперации") = Неопределено Тогда
		
		Если Не ТаблицаПланов.Колонки.Найти("КратностьЗаявки") = Неопределено 
			И Не ТаблицаПланов.Колонки.Найти("КурсЗаявки") = Неопределено Тогда 
			
			ТаблицаПланов.Колонки.Добавить("Лимит", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(15,2));
			
			Измерения =  Измерения + ", Лимит, КурсЗаданВОперации, КратностьПланирования, КурсПланирования"; 
			
			ПереопределитьКурсКратностьПлатежа(ТаблицаПланов);
			
			Для Каждого СтрокаТаблицыПланов Из ТаблицаПланов Цикл 
				Если СтрокаТаблицыПланов.КратностьЗаявки <> 0 И СтрокаТаблицыПланов.КурсЗаданВОперации Тогда
					СтрокаТаблицыПланов.Лимит = Окр(СтрокаТаблицыПланов.Сумма * (СтрокаТаблицыПланов.КурсЗаявки / СтрокаТаблицыПланов.КратностьЗаявки) , 2, РежимОкругления.Окр15как20);								
				КонецЕсли;
			КонецЦикла; 
			
		ИначеЕсли Не ТаблицаПланов.Колонки.Найти("КратностьПланирования") = Неопределено 
			И Не ТаблицаПланов.Колонки.Найти("КурсПланирования") = Неопределено Тогда 
			
			Измерения =  Измерения + ", КурсЗаданВОперации, КратностьПланирования, КурсПланирования";
			
		КонецЕсли;
		
	КонецЕсли;    
	
	ТаблицаПланов.Свернуть(Измерения, ИменаРесурсов);
	
	СтруктураПоиска = Новый Структура; 
	Если ЕстьСумма Тогда
		СтруктураПоиска.Вставить("Сумма", 0); 
	КонецЕсли;
	Если ЕстьЛимит Тогда
		СтруктураПоиска.Вставить("Лимит", 0);
	КонецЕсли;  
	Если ЕстьСуммаИсполнено Тогда
		СтруктураПоиска.Вставить("СуммаИсполнено", 0);
	КонецЕсли;
	
	СтрокиКУдалению = ТаблицаПланов.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		ТаблицаПланов.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	ТаблицыДляДвижений.Вставить(ИмяТаблицыДвижений, ТаблицаПланов);

КонецПроцедуры     

Процедура ПереопределитьКурсКратностьПлатежа(ТаблицаПланов) 
	
	// Обработка ситуации при которой валюты взаиморасчетов, оплаты и лимитирования отличаются 
	Если ТаблицаПланов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Не ТаблицаПланов[0].КурсЗаданВОперации Тогда
		Возврат;
	КонецЕсли;     
	
	ТаблицаВалютЛимитирования = Новый ТаблицаЗначений;
	ТаблицаВалютЛимитирования.Колонки.Добавить("ДатаОперации", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	ТаблицаВалютЛимитирования.Колонки.Добавить("ВидБюджета", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("ПланВидовХарактеристикСсылка.ВидыБюджетов"));
	ТаблицаВалютЛимитирования.Колонки.Добавить("ЦФО", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Организации"));
	ТаблицаВалютЛимитирования.Колонки.Добавить("Валюта", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Валюты"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаПланов Цикл
		
		НоваяТаблица = ТаблицаВалютЛимитирования.Добавить();
		
		НоваяТаблица.ДатаОперации = СтрокаТаблицы.ДатаРегистрации; 
		НоваяТаблица.ВидБюджета = СтрокаТаблицы.ВидБюджета; 
		НоваяТаблица.ЦФО = СтрокаТаблицы.ЦФО;
		НоваяТаблица.Валюта = СтрокаТаблицы.Валюта;
		
	КонецЦикла;    
	
	Запрос = Новый Запрос;    
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;  	
	
	Запрос.Текст =
	"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Данные ИЗ &ТаблицаВалютЛимитирования КАК Коллекция";
	
	Запрос.УстановитьПараметр("ТаблицаВалютЛимитирования", ТаблицаВалютЛимитирования);
	Запрос.Выполнить();
	
	РезультатЗапроса = КонтрольЛимитовУХ.ОпределитьВалютуЛимитированияПоДокументу(Запрос);	
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
	
	ЗаполнитьДатуПланирования(ТаблицаПланов);	
	
	СтруктураПоиска = Новый Структура("ВидБюджета, ЦФО, Валюта");
	Для Каждого СтрокаТаблицы Из ТаблицаПланов Цикл 
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаПланирования) Тогда
			СтрокаТаблицы.ДатаПланирования = СтрокаТаблицы.Период;
		КонецЕсли;  
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
		
		Если ВыборкаДетальныеЗаписи.НайтиСледующий(СтруктураПоиска) Тогда
			
			ВалютыТекущейСтроки = Новый Массив;
			ВалютыТекущейСтроки.Добавить(СтрокаТаблицы.Валюта);
			ВалютыТекущейСтроки.Добавить(СтрокаТаблицы.ВалютаДокумента);

			Если Не ВалютыТекущейСтроки.Найти(ВыборкаДетальныеЗаписи.ВалютаЛимитирования) = Неопределено
				И Не ВыборкаДетальныеЗаписи.ВалютаЛимитирования = СтрокаТаблицы.Валюта Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыТекущегоКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаТаблицы.Валюта, СтрокаТаблицы.ДатаПланирования);
			ПараметрыНовогоКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВыборкаДетальныеЗаписи.ВалютаЛимитирования, СтрокаТаблицы.ДатаПланирования);
			КроссКурс = РаботаСКурсамиВалютУХ.ПолучитьКроссКурсВалют(ПараметрыТекущегоКурса, ПараметрыНовогоКурса);
			
			СтрокаТаблицы.КурсЗаявки = КроссКурс.Курс; 
			СтрокаТаблицы.КратностьЗаявки = КроссКурс.Кратность; 
			
			СтрокаТаблицы.КурсПланирования = КроссКурс.Курс;
			СтрокаТаблицы.КратностьПланирования = КроссКурс.Кратность;
			
			ВыборкаДетальныеЗаписи.Сбросить();
		КонецЕсли;
		
	КонецЦикла;   
	
КонецПроцедуры  

Процедура ЗаполнитьДатуПланирования(ТаблицаПланов)

	Если ТаблицаПланов.Колонки.Найти("ДатаПланирования") = Неопределено Тогда
		ТаблицаПланов.Колонки.Добавить("ДатаПланирования", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя));	
	КонецЕсли;
	
	ДокументыПланирования = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаПланов Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаПланирования) 
			И ЗначениеЗаполнено(СтрокаТаблицы.ДокументПланирования) 
			И ОбщегоНазначения.ЭтоДокумент(СтрокаТаблицы.ДокументПланирования.Метаданные()) Тогда
			
			ДокументыПланирования.Добавить(СтрокаТаблицы.ДокументПланирования);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДокументыПланирования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ДокументыПланирования, "Дата");

	Для Каждого СтрокаТаблицы Из ТаблицаПланов Цикл
		СтрокаТаблицы.ДатаПланирования = ЗначениеРеквизита.Получить(СтрокаТаблицы.ДокументПланирования);	
	КонецЦикла;
	
КонецПроцедуры
	
#КонецОбласти

#Область ИсточникиДокументов

/// КОНТРОЛЬ ДОКУМЕНТОВ

Функция ИсточникиДокумента(Объект, ДопПараметры = неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
	Источники, 
	КонтрольУХБюджетныеЛимиты, 
	Источник_БюджетныеЛимитыРезервы(Объект, ДопПараметры, МенеджерВременныхТаблиц));
	
	Возврат Источники;
	
КонецФункции

Функция Источник_БюджетныеЛимитыРезервы(Объект, ПараметрыКонтроля, МенеджерВременныхТаблиц) Экспорт

	// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			НЕ ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") 
			И ТипЗнч(ПараметрыКонтроля) = Тип("Структура") 
			И ПараметрыКонтроля.Свойство("ДополнительныеПараметрыКонтроля") Тогда
		ПараметрыПланирования = Менеджер.ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц, ПараметрыКонтроля.ДополнительныеПараметрыКонтроля);
	Иначе
		ПараметрыПланирования = Менеджер.ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц);
	КонецЕсли;
	ПодготовитьПланыДокумента(ПараметрыПланирования);
	
	Возврат ИсточникБюджетныеЛимитыРезервыПоПланамДокументаПланированияПотребностей(Объект, ПараметрыКонтроля, ДопПараметрыИсточника, МенеджерВременныхТаблиц);
	
КонецФункции

// Используется документам, участниками процесса планирования потребностей и документом ЗаявкаНаЗакупку
Функция ИсточникБюджетныеЛимитыРезервыПоПланамДокументаПланированияПотребностей(Объект, ПараметрыКонтроля, ДопПараметрыИсточника, МенеджерВременныхТаблиц) Экспорт
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если ДопПараметрыИсточника.Свойство("КонтролируемыйДокумент") Тогда
		Запрос.УстановитьПараметр("КонтролируемыйДокумент", ДопПараметрыИсточника.КонтролируемыйДокумент);
	Иначе
		Запрос.УстановитьПараметр("КонтролируемыйДокумент", ДопПараметрыИсточника.Ссылка);
	КонецЕсли;
	
	Запросы = Новый Массив;
	Запросы.Добавить(
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ДатаОперации КАК Период,
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ДатаОперации КАК ДатаОперации,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	ВТ_ПланыДокумента.Сумма КАК Сумма
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОперации,
	|	СтатьяБюджета,
	|	Аналитика1,
	|	Аналитика2,
	|	Аналитика3,
	|	Аналитика4,
	|	Аналитика5,
	|	Аналитика6,
	|	ЦФО,
	|	Проект");
	Запросы.Добавить(ТекстЗапроса_ОпределениеСуммЛимитированияЕХ(Запрос));
	Запросы.Добавить("УНИЧТОЖИТЬ ВТ_ПланыДокумента");
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		ПараметрыКонтроля.Вставить("Оповестить", Новый Структура);
		ПараметрыКонтроля.Оповестить.Вставить("ЗагрузитьПланыДДСДокумента", ПоместитьВоВременноеХранилище(РезультатПакет[0].Выгрузить()));
	КонецЕсли;
	
	//
	Источник = Новый Структура;
	Источник.Вставить("Параметры",		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", МенеджерВременныхТаблиц);
	Возврат Источник;
	
КонецФункции

// Используется при контроле документов, участников процесса планирования потребностей и в заявке на закупку
Функция ТекстЗапроса_ОпределениеСуммЛимитированияЕХ(Запрос) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ДатаОперации КАК Период,
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	&ТекстДатаОперации КАК ДатаОперации,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументРезервирования КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументПланирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА ВТ_ПланыДокумента.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Лимит,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументПланирования <> НЕОПРЕДЕЛЕНО
	|				И НЕ ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) В (&ТипыЗаявокНаОперации)
	|				И НЕ ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) В (&ТипыЗаявокКОбеспечению)
	|			ТОГДА ВЫБОР
	|					КОГДА ВТ_ПланыДокумента.ДокументРезервирования <> НЕОПРЕДЕЛЕНО
	|						ТОГДА -ВТ_ПланыДокумента.Сумма
	|					ИНАЧЕ ВТ_ПланыДокумента.Сумма
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Зарезервировано,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументПланирования <> НЕОПРЕДЕЛЕНО
	|				И ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) В (&ТипыЗаявокНаОперации)
	|			ТОГДА ВТ_ПланыДокумента.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|ГДЕ
	|	ВТ_ПланыДокумента.ДокументПланирования = &КонтролируемыйДокумент";

	ВТ_ПланыКолонки = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_ПланыДокумента"].Колонки;
	Если ВТ_ПланыКолонки.Найти("День") <> Неопределено Тогда
		ТекстДатаОперации = "ВЫБОР КОГДА (ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.День) = ТИП(ДАТА) И ВТ_ПланыДокумента.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)) ТОГДА ВЫРАЗИТЬ(ВТ_ПланыДокумента.День КАК ДАТА) ИНАЧЕ ВТ_ПланыДокумента.ДатаОперации КОНЕЦ";
	Иначе
		ТекстДатаОперации = "ВТ_ПланыДокумента.ДатаОперации";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстДатаОперации", ТекстДатаОперации);
	КонтрольЛимитовУХ.УстановитьТипыДокументовДляЗапроса(Запрос);
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ЗаявкаНаЗакупку

// Функция возвращает планы потребностей по заявке на закупку
Функция ПолучитьПланыПоЗаявкеНаЗакупку(ДокументПланирования) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектыПланирования.НайтиОбъектПланирования(ДокументПланирования));

	Запросы = Новый Массив;
	Запросы.Добавить(ТекстЗапроса_ПланПотребностейПоЗаявкеНаЗакупку()); // планы потребностей
	// Запросы.Добавить(Планы движения денежных средств по заявке);
	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	Результат = Запрос.ВыполнитьПакет();
	
	Данные = Новый Структура;
	Данные.Вставить("БюджетЗакупок", Результат[1].Выгрузить());
	//Данные.Вставить("БюджетДвиженияДенежныхСредств", Результат[1].Выгрузить());
	Данные.Вставить("БюджетДвиженияДенежныхСредств", Результат[1].Выгрузить());
	
	Возврат Данные;
	
КонецФункции

Функция Старый_ПолучитьПланыПоЗаявкеНаЗакупку(ДокументПланирования) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектыПланирования.НайтиОбъектПланирования(ДокументПланирования));

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеРегистра.АналитикаПланирования.Этап КАК Раздел,
	|	АналитикиБюджетов.ВидБюджета КАК ВидБюджета,
	|	ДанныеРегистра.АналитикаПланирования.ДатаОперации КАК ДатаОперации,
	|	ДанныеРегистра.АналитикаПланирования.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ДанныеРегистра.АналитикаПланирования.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	АналитикиБюджетов.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	АналитикиБюджетов.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ДанныеРегистра.АналитикаПланирования.Валюта КАК Валюта,
	|	ДанныеРегистра.АналитикаПланирования.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	ДанныеРегистра.АналитикаПланирования.АналитикаСтруктуры.Проект КАК Проект,
	|	ДанныеРегистра.АналитикаПланирования.АналитикаСтруктуры.Организация КАК Организация,
	|	АналитикиБюджетов.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|	АналитикиБюджетов.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|	АналитикиБюджетов.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
