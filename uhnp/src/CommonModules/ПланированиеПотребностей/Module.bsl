	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.АналитикиБюджетов.НаборЗаписей");
	ЭлементБлокировки.ИсточникДанных = ИсточникДанных;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Регистратор", "Регистратор");
