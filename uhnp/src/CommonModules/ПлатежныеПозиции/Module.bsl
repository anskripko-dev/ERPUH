Процедура СвернутьДанныеТаблицыВыдачаПодОтчет(Объект) 
	
	ТаблицаВыдачаПодОтчет = Объект.ВыдачаПодОтчет.Выгрузить();
	
	КолонкиГруппировки = Новый Массив;
	КолонкиГруппировки.Добавить("Сотрудник");
	КолонкиГруппировки.Добавить("ЛицевойСчет");
	
	КолонкиСуммирования = Новый Массив;
	КолонкиСуммирования.Добавить("Сумма"); 
	
	ТаблицаВыдачаПодОтчет.Свернуть(СтрСоединить(КолонкиГруппировки,","),СтрСоединить(КолонкиСуммирования,","));
	ТаблицаВыдачаПодОтчет.Колонки.Добавить("ИдентификаторПозиции"); 
	
	Для Каждого СтрокаТаблицы Из ТаблицаВыдачаПодОтчет Цикл
		
		ПараметрыОтбора = Новый Структура("Сотрудник,ЛицевойСчет");
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТаблицы);
		
		НайденныеСтроки = Объект.ВыдачаПодОтчет.НайтиСтроки(ПараметрыОтбора);
		
		ИдентификаторПозиции = Неопределено;
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			Если ЗначениеЗаполнено(НайденнаяСтрока.ИдентификаторПозиции) Тогда
				ИдентификаторПозиции = Новый УникальныйИдентификатор(НайденнаяСтрока.ИдентификаторПозиции);
			Иначе
				Если ИдентификаторПозиции = Неопределено Тогда
					ИдентификаторПозиции = Новый УникальныйИдентификатор;
				КонецЕсли;
				НайденнаяСтрока.ИдентификаторПозиции = ИдентификаторПозиции;
			КонецЕсли;			
			
		КонецЦикла;
		
		СтрокаТаблицы.ИдентификаторПозиции = ИдентификаторПозиции;		
		
	КонецЦикла;

	Объект.ДополнительныеСвойства.Вставить("ТаблицаВыдачаПодОтчет", ТаблицаВыдачаПодОтчет);	

КонецПроцедуры

Процедура ЗаменитьАналитикиПозиции(Заявка, РазделенныеДвижения)

	ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заявка,"ВидОперацииУХ");
	
	ВстречныйВидОперацииПереводСобственныхСредств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта
										(ВидОперации,"ВстречныйВидОперацииПереводСобственныхСредств");
	
	Если ЗначениеЗаполнено(ВстречныйВидОперацииПереводСобственныхСредств) Тогда
		
		НайдСтроки = РазделенныеДвижения.НайтиСтроки(Новый Структура("Направление", Перечисления.ВидыДвиженийПриходРасход.Приход));
		
		Если НайдСтроки.Количество() Тогда
			
			СтрокаДляЗаменыАналитик = НайдСтроки[0];
			
			Реквизиты = Новый Структура;
			Реквизиты.Вставить("СтатьяДвиженияДенежныхСредств","СтатьяДвиженияДенежныхСредствЗачисление");
			Реквизиты.Вставить("Аналитика1", "АналитикаЗачисления1");
			Реквизиты.Вставить("Аналитика2", "АналитикаЗачисления2");
			Реквизиты.Вставить("Аналитика3", "АналитикаЗачисления3");
			Реквизиты.Вставить("Аналитика4", "АналитикаЗачисления4");
			Реквизиты.Вставить("Аналитика5", "АналитикаЗачисления5");
			Реквизиты.Вставить("Аналитика6", "АналитикаЗачисления6");
			
			ДанныеАналитик = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка, Реквизиты);			
			ЗаполнитьЗначенияСвойств(СтрокаДляЗаменыАналитик, ДанныеАналитик); 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

