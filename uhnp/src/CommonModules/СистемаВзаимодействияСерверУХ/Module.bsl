
Функция ИспользоватьСистемуВзаимодействия(Пользователь) Экспорт      
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.ВнешниеПользователи")  Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Возврат Пользователь.ОповещатьЧерезСистемуВзаимодействия;
КонецФункции

Процедура УдалитьУстаревшиеОбсуждения(ИдентификаторОбсуждения, Пользователь, Отказ) Экспорт
	
	Если НЕ СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторОбсуждения = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	ОтборОбсуждений = Новый ОтборОбсужденийСистемыВзаимодействия();
	Попытка
		МассивОбсуждений = СистемаВзаимодействия.ПолучитьОбсуждения(ОтборОбсуждений);
	Исключение
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
	ИдентификаторПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПользовательИБ.УникальныйИдентификатор);
	
	Для Каждого Обсуждение Из МассивОбсуждений Цикл
		Если НЕ Обсуждение.Участники.Содержит(ИдентификаторПользователяСВ) Тогда
			Продолжить;
		КонецЕсли;
		Если Обсуждение.Идентификатор = ИдентификаторОбсуждения тогда
			Продолжить;
		КонецЕсли;
		Если Обсуждение.Заголовок <> НСтр("ru = 'Мои задачи и оповещения'", ОбщегоНазначения.КодОсновногоЯзыка()) тогда
			Продолжить;
		КонецЕсли;
				
		Обсуждение.Участники.Очистить();
		Обсуждение.Отображаемое = Ложь;
		Обсуждение.Записать();
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИдентификаторОбсуждения(Пользователь) Экспорт
	
	Если НЕ СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ Пользователь.ОповещатьЧерезСистемуВзаимодействия тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПользовательНеУказан = Пользователи.ПолноеИмяНеуказанногоПользователя();
		
	Если Пользователь.Наименование = ПользовательНеУказан Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//Проверка пользователя под которым осуществлен запуск
	ТекущийПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
	Если ТекущийПользователь.Наименование = ПользовательНеУказан Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПустойИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если Пользователь.ИдентификаторПользователяИБ = ПустойИдентификатор Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗапросИдентификатора = Новый Запрос("ВЫБРАТЬ
	|	ИдентификаторыОповещенийПользователей.ИдентификаторОбсуждения КАК ИдентификаторОбсуждения
	|ИЗ
	|	РегистрСведений.ИдентификаторыОповещенийПользователей КАК ИдентификаторыОповещенийПользователей
	|ГДЕ
	|	ИдентификаторыОповещенийПользователей.Пользователь = &Пользователь");
	
	ЗапросИдентификатора.УстановитьПараметр("Пользователь", Пользователь);
	ВыборкаИдентификаторов = ЗапросИдентификатора.Выполнить().Выбрать();
	
	Если ВыборкаИдентификаторов.Следующий() Тогда
		ИдентификаторОбсужденияСтрока = ВыборкаИдентификаторов.ИдентификаторОбсуждения;
	Иначе
		ИдентификаторОбсужденияСтрока = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторОбсужденияСтрока) Тогда
		ИдентификаторОбсуждения = Новый ИдентификаторОбсужденияСистемыВзаимодействия(ИдентификаторОбсужденияСтрока);
		
		Отказ = Ложь;
		ОбсуждениеСоздано = ОбсуждениеСуществует(ИдентификаторОбсуждения, Отказ);
		
		Если Отказ тогда
			Возврат Неопределено;
		ИначеЕсли ОбсуждениеСоздано Тогда
			ДобавитьПользователяВОбсуждение(ИдентификаторОбсуждения, Пользователь);
			ПроверитьОтображениеОбсуждения(ИдентификаторОбсуждения);
		Иначе
			ИдентификаторОбсуждения = СоздатьОбсуждениеБезКонтекста(Пользователь);
		КонецЕсли;
	Иначе
		ИдентификаторОбсуждения = СоздатьОбсуждениеБезКонтекста(Пользователь);
	КонецЕсли;
	
	Возврат ИдентификаторОбсуждения;
	
КонецФункции

Процедура ПроверитьОтображениеОбсуждения(ИдентификаторОбсуждения) Экспорт
	
	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(ИдентификаторОбсуждения);
	
	Если Не Обсуждение.Отображаемое Тогда
		Обсуждение.Отображаемое = Истина;
		Обсуждение.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПользователяВОбсуждение(ИдентификаторОбсуждения, Пользователь) Экспорт

	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(ИдентификаторОбсуждения);
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
	ИдентификаторПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПользовательИБ.УникальныйИдентификатор);
		
	Если Обсуждение.Участники.Содержит(ИдентификаторПользователяСВ) Тогда
		Возврат;
	КонецЕсли;
	
	Обсуждение.Участники.Добавить(ИдентификаторПользователяСВ);	
	Обсуждение.Записать();
	
КонецПроцедуры

Функция СоздатьОбсуждениеБезКонтекста(Пользователь) Экспорт
		
	НовоеОбсуждение = СистемаВзаимодействия.СоздатьОбсуждение();
	НовоеОбсуждение.Групповое = Истина;
	НовоеОбсуждение.Заголовок = НСтр("ru = 'Мои задачи и оповещения'", ОбщегоНазначения.КодОсновногоЯзыка());
	НовоеОбсуждение.Отображаемое = Истина;
	НовоеОбсуждение.Ключ = Строка(Новый УникальныйИдентификатор);
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
	ИдентификаторПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПользовательИБ.УникальныйИдентификатор);
	НовоеОбсуждение.Участники.Добавить(ИдентификаторПользователяСВ);
		
	НовоеОбсуждение.Записать();
	
	МенеджерЗаписи = РегистрыСведений.ИдентификаторыОповещенийПользователей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.ИдентификаторОбсуждения = Строка(НовоеОбсуждение.Идентификатор);
	МенеджерЗаписи.Записать();
		
	Возврат НовоеОбсуждение.Идентификатор;
	
КонецФункции

Функция ОбсуждениеСуществует(ИдентификаторОбсуждения, Отказ) Экспорт
	
	Инд = 0;
	КоличествоПовторов = 10;
	Обсуждение = Неопределено;
	Обсуждение = ПопыткаПолучитьОбсуждение(ИдентификаторОбсуждения, Отказ);
	
	Пока Отказ И Инд < КоличествоПовторов Цикл
		Обсуждение = ПопыткаПолучитьОбсуждение(ИдентификаторОбсуждения, Отказ);		
		Инд = Инд + 1;
	КонецЦикла;
		
	Возврат Обсуждение <> Неопределено;
	
КонецФункции

Функция ПопыткаПолучитьОбсуждение(ИдентификаторОбсуждения, Отказ) Экспорт
	
	Отказ = Ложь;
	
	Попытка
		Возврат СистемаВзаимодействия.ПолучитьОбсуждение(ИдентификаторОбсуждения);
	Исключение
		Отказ = Истина;
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура СоздатьСообщение(Параметры) Экспорт
	
	Если НЕ СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Возврат;
	КонецЕсли;
	
	ПользовательБот = ПолучитьПользователяБотаЗадачИОповещений();
	Если ПользовательБот = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ИдентификаторОбсуждения = ПолучитьИдентификаторОбсуждения(Параметры.Пользователь);
	Если ИдентификаторОбсуждения = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(ИдентификаторОбсуждения);
	
	ОтветственныйПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Параметры.Пользователь.ИдентификаторПользователяИБ);
	ИдентификаторПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ОтветственныйПользовательИБ.УникальныйИдентификатор);
	
	НовоеСообщение = СистемаВзаимодействия.СоздатьСообщение(ИдентификаторОбсуждения);
	ТекстСообщения = Параметры.ТекстСообщения;
	
	Для Каждого ЭлементДокумента Из Параметры.ФорматированныйДокумент.Элементы Цикл
		
		ПервоеДействие = Истина;
		
		Для Каждого ПодчиненныйЭлемент Из ЭлементДокумента.Элементы Цикл
			
			Если ТипЗнч(ПодчиненныйЭлемент) <> Тип("ТекстФорматированногоДокумента") тогда
				Продолжить;
			КонецЕсли;
			Если ПодчиненныйЭлемент.НавигационнаяСсылка = "" тогда
				Продолжить;
			КонецЕсли;
			
			ТекстЭлемента = ПодчиненныйЭлемент.Текст;
			НавигационнаяСсылкаЭлемента = ПодчиненныйЭлемент.НавигационнаяСсылка;
							
			Если ТекстЭлемента = "Согласовано" 
				ИЛИ ТекстЭлемента = "Возвращено на предыдущий этап согласования"
				ИЛИ ТекстЭлемента = "Возвращено инициатору"
				ИЛИ ТекстЭлемента = "Принять к исполнению"
				ИЛИ ТекстЭлемента = "Отменить принятие к исполнению" тогда
							
				Уточнение = "";
				ИндексТекущегоЭлемента = ЭлементДокумента.Элементы.Индекс(ПодчиненныйЭлемент);
				Если ИндексТекущегоЭлемента + 3 < ЭлементДокумента.Элементы.Количество() тогда
					Если ТипЗнч(ЭлементДокумента.Элементы[ИндексТекущегоЭлемента + 3]) = Тип("ТекстФорматированногоДокумента") тогда
						Если ЗначениеЗаполнено(ЭлементДокумента.Элементы[ИндексТекущегоЭлемента + 3].Текст) тогда
							Уточнение = Символы.ПС + ЭлементДокумента.Элементы[ИндексТекущегоЭлемента + 3].Текст;
						ИначеЕсли ТекстЭлемента = "Согласовано" тогда
							Уточнение = "";
						ИначеЕсли ТекстЭлемента = "Возвращено на предыдущий этап согласования" тогда
							Уточнение = "";
						ИначеЕсли ТекстЭлемента = "Принять к исполнению" тогда
							Уточнение = "";
						ИначеЕсли ТекстЭлемента = "Отменить принятие к исполнению" тогда
							Уточнение = "";
						Иначе
							Уточнение = Символы.ПС + "<Не указан>";
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли ИндексТекущегоЭлемента + 3 = ЭлементДокумента.Элементы.Количество() И ТекстЭлемента = "Возвращено инициатору" тогда
					Уточнение = Символы.ПС + "<Не указан>";
				КонецЕсли;
				
				ОтступДействий = ?(ПервоеДействие, "", Символы.ПС + Символы.ПС);
				ПервоеДействие = Ложь;
				НовоеСообщение.Действия.Добавить(ТекстЭлемента + НавигационнаяСсылкаЭлемента, ОтступДействий + ТекстЭлемента + Уточнение);
				
				ТекстСообщения = СокрЛП(СтрЗаменить(ТекстСообщения, "[" + ТекстЭлемента + "]" + Уточнение, ""));
				ТекстСообщения = СокрЛП(СтрЗаменить(ТекстСообщения, "[" + ТекстЭлемента + "]", ""));				
			Иначе
				ТекстСообщения = СтрЗаменить(ТекстСообщения, ТекстЭлемента, НавигационнаяСсылкаЭлемента);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
		
	СпецСимволШапкаСообщения = Символы.НПП + Символы.НПП + Символы.НПП + Символы.НПП + Символы.НПП;
	ПозицияБлокаРешения = СтрНайти(ТекстСообщения, СпецСимволШапкаСообщения);	
	Если ПозицияБлокаРешения > 0 Тогда
		ТекстСообщения = СокрЛП(Лев(ТекстСообщения, ПозицияБлокаРешения - 1));
	КонецЕсли;
		
	ПользовательБотИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ПользовательБот.ИдентификаторПользователяИБ);
	ИдентификаторАвтораСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПользовательБотИБ.УникальныйИдентификатор);
	
	НовоеСообщение.Автор = ИдентификаторАвтораСВ;
	НовоеСообщение.Получатели.Добавить(ИдентификаторПользователяСВ);
	НовоеСообщение.Дата = ТекущаяДата();
	НовоеСообщение.Текст = ТекстСообщения;
	НовоеСообщение.Записать();
	
КонецПроцедуры

Процедура ДополнитьСтруктуруПараметровФормыСогласования(ЗадачаВход, СтруктураПараметров) Экспорт
	// Параметр СогласовываемыйДокумент.
	СвязанныйОбъект = ПолучитьСвязанныйОбъектЗадачи(ЗадачаВход);
	СтруктураПараметров.Вставить("СогласовываемыйДокумент", СвязанныйОбъект);
	// Параметр ДопСогласование.
	ДопСогласование = МодульСогласованияДокументовУХ.ЭтоЗадачаДопСогласования(ЗадачаВход);
	СтруктураПараметров.Вставить("ДопСогласование", ДопСогласование);
	// Параметр СписокЗадач.
	СписокЗадач = Новый СписокЗначений;
	СписокЗадач.Добавить(ЗадачаВход);   
	СтруктураПараметров.Вставить("СписокЗадач",СписокЗадач);
	// Параметр ТипЭтапа.
	ТаблицаПараметровЗадач = Справочники.Задачи.ПолучитьТаблицуПараметровЗадач(СписокЗадач);
	КопияТаблицаПараметров = ТаблицаПараметровЗадач.Скопировать();
	КопияТаблицаПараметров.Свернуть("ЭтапПроцесса");
	ЭтапыПроцесса = КопияТаблицаПараметров.ВыгрузитьКолонку("ЭтапПроцесса");
	Если ЭтапыПроцесса.Количество() = 1 Тогда
		ЭтапЗадачи = ЭтапыПроцесса[0];
		Если ЗначениеЗаполнено(ЭтапЗадачи) Тогда
			СтруктураПараметров.Вставить("ТипЭтапа", ЭтапЗадачи.ТипЭтапа);
		Иначе
			СтруктураПараметров.Вставить("ТипЭтапа", Перечисления.ТипыЭтаповУниверсальныхПроцессов.ПустаяСсылка());
		КонецЕсли;
	Иначе	
		СтруктураПараметров.Вставить("ТипЭтапа", Перечисления.ТипыЭтаповУниверсальныхПроцессов.ПустаяСсылка());
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьСвязанныйОбъектЗадачи(ЗадачаВход)
	Возврат ЗадачаВход.СвязанныйОбъект;
КонецФункции

Функция ЗадачаВыполненаРанее(ЗадачаВход) Экспорт
	СписокЗадач = Новый СписокЗначений;
	СписокЗадач.Добавить(ЗадачаВход);
	РезультатФункции = НЕ Справочники.Задачи.ЗадачиНеВыполнены(СписокЗадач);
	
	Возврат РезультатФункции;
КонецФункции

Функция ПолучитьПользователяБотаЗадачИОповещений() Экспорт
	
	ИмяПользователя = ПользователиУХ.ПолучитьПредставлениеБотаЗадачИОповещений();
		
	ПользовательБотИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательБотИБ = Неопределено Тогда
		
		ПользовательБотИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		ПользовательБотИБ.Имя = ИмяПользователя;
		ПользовательБотИБ.ПолноеИмя = ИмяПользователя;
		ПользовательБотИБ.Пароль = Строка(Новый УникальныйИдентификатор);
		ПользовательБотИБ.ЗапрещеноИзменятьПароль = Истина;
		ПользовательБотИБ.ПоказыватьВСпискеВыбора = Ложь;
		ПользовательБотИБ.Язык = ЯзыкПоКоду(ОбщегоНазначения.КодОсновногоЯзыка());
		ПользовательБотИБ.Роли.Добавить(Метаданные.Роли.ПолныеПрава);
		
		Попытка
			ПользовательБотИБ.Записать();
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя информационной базы для системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	// Обновление пользователя - элемента справочника Пользователи.
	ОписаниеПользователяИБ = Новый Структура;
	ОписаниеПользователяИБ.Вставить("Действие", "Записать");
	ОписаниеПользователяИБ.Вставить("Имя", ПользовательБотИБ.Имя);
	ОписаниеПользователяИБ.Вставить("АутентификацияСтандартная", Истина);
	ОписаниеПользователяИБ.Вставить("ПоказыватьВСпискеВыбора", ПользовательБотИБ.ПоказыватьВСпискеВыбора);
	ОписаниеПользователяИБ.Вставить("УникальныйИдентификатор", ПользовательБотИБ.УникальныйИдентификатор);
		
	Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ", ПользовательБотИБ.УникальныйИдентификатор);
	Если Пользователь.Пустая() Тогда
		
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.Пользователи.ПолноеИмя());
						
			Блокировка.Заблокировать();
			
			ПользовательБот = Справочники.Пользователи.СоздатьЭлемент();
				
			ПользовательБот.Наименование = ПользовательБотИБ.Имя;
			ПользовательБот.Служебный = Истина;
			ПользовательБот.ОповещатьЧерезСистемуВзаимодействия = Истина;
			ПользовательБот.ОповещатьЧерезТелеграм = Истина;
			ПользовательБот.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);
			ПользовательБот.Записать();
			
			ЗафиксироватьТранзакцию();
			Пользователь = ПользовательБот.Ссылка;
		Исключение
			ОтменитьТранзакцию();
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Если НЕ Пользователь.ОповещатьЧерезСистемуВзаимодействия Тогда
		
		ПользовательОбъект = Пользователь.ПолучитьОбъект();
		ПользовательОбъект.ОповещатьЧерезСистемуВзаимодействия = Истина;
		ПользовательОбъект.ОповещатьЧерезТелеграм = Истина;
		
		Попытка
			ПользовательОбъект.Записать();
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	РЗОтправкаОповещенийСобытий = РегламентныеЗадания.НайтиПредопределенное("ОтправкаОповещенийСобытий");
	Если РЗОтправкаОповещенийСобытий.ИмяПользователя <> ИмяПользователя Тогда
		РЗОтправкаОповещенийСобытий.ИмяПользователя = ИмяПользователя;
		
		Попытка
			РЗОтправкаОповещенийСобытий.Записать();
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось получить пользователя системы взаимодействия: %1'"), ОписаниеОшибки());
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
			
	Возврат Пользователь;
	
КонецФункции

Функция ЯзыкПоКоду(Знач КодЯзыка)
	Для каждого Язык Из Метаданные.Языки Цикл
		Если Язык.КодЯзыка = КодЯзыка Тогда
			Возврат Язык;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции