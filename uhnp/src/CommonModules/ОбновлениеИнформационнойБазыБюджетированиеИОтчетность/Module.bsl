		НоваяРоль.Роль = Роль2;
		ПрофильОбъект.Записать();
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Роль2", Роль3);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПрофильОбъект = ВыборкаДетальныеЗаписи.Профиль.ПолучитьОбъект();
		НоваяРоль = ПрофильОбъект.Роли.Добавить();
		НоваяРоль.Роль = Роль3;
		ПрофильОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьСведенияОбИзмененииДокументов(Параметры=Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастраиваемыйОтчет.Ссылка КАК Ссылка,
		|	НастраиваемыйОтчет.УдалитьПоследнийРедактировавший КАК ПоследнийРедактировавший,
		|	НастраиваемыйОтчет.УдалитьДатаИзменения КАК ДатаИзменения
		|ИЗ
		|	Документ.НастраиваемыйОтчет КАК НастраиваемыйОтчет
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Трансляция.Ссылка,
		|	Трансляция.УдалитьПоследнийРедактировавший,
		|	Трансляция.УдалитьДатаИзменения
		|ИЗ
		|	Документ.Трансляция КАК Трансляция
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТрансформационнаяКорректировка.Ссылка,
		|	ТрансформационнаяКорректировка.УдалитьПоследнийРедактировавший,
		|	ТрансформационнаяКорректировка.УдалитьДатаИзменения
		|ИЗ
		|	Документ.ТрансформационнаяКорректировка КАК ТрансформационнаяКорректировка";
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.СведенияОбИзмененииДокументов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = ВыборкаДетальныеЗаписи.Ссылка;
		МенеджерЗаписи.ПоследнийРедактировавший = ВыборкаДетальныеЗаписи.ПоследнийРедактировавший;
		МенеджерЗаписи.ДатаИзменения = ВыборкаДетальныеЗаписи.ДатаИзменения;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИтогиИКурсыПоПоказателям(Параметры=Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоказателиОтчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	(ПоказателиОтчетов.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ПустаяСсылка)
		|			ИЛИ ПоказателиОтчетов.СпособРасчетаИтогаПоПериоду = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателяПоПериоду.ПустаяСсылка)
		|			ИЛИ ПоказателиОтчетов.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.ПустаяСсылка)
		|			ИЛИ ВЫБОР
		|				КОГДА НЕ ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)
		|					ТОГДА НЕ ПоказателиОтчетов.СпособРасчетаИтогаПоПериоду = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателяПоПериоду.НеРассчитывать)
		|							ИЛИ ПоказателиОтчетов.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Сумма)
		|							ИЛИ ПоказателиОтчетов.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Среднее)
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		тОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если тОбъект.ВидКурса = Перечисления.ВидыКурсов.ПустаяСсылка() Тогда
			тОбъект.ВидКурса  = Перечисления.ВидыКурсов.СреднийКурсЗаПериод;
		КонецЕсли;
		
		Если тОбъект.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			Если тОбъект.ВидИтога = Перечисления.ВидыИтоговПоказателя.ПустаяСсылка() Тогда
				тОбъект.ВидИтога = Перечисления.ВидыИтоговПоказателя.Сумма;
			КонецЕсли;
			Если тОбъект.СпособРасчетаИтогаПоПериоду = Перечисления.ВидыИтоговПоказателяПоПериоду.ПустаяСсылка() Тогда
				тОбъект.СпособРасчетаИтогаПоПериоду = Перечисления.ВидыИтоговПоказателяПоПериоду.Сумма;
			КонецЕсли;
		Иначе
			Если тОбъект.ВидИтога = Перечисления.ВидыИтоговПоказателя.ПустаяСсылка()
				ИЛИ тОбъект.ВидИтога = Перечисления.ВидыИтоговПоказателя.Среднее
				ИЛИ тОбъект.ВидИтога = Перечисления.ВидыИтоговПоказателя.Сумма Тогда
				тОбъект.ВидИтога = Перечисления.ВидыИтоговПоказателя.Максимум;
			КонецЕсли;
			тОбъект.СпособРасчетаИтогаПоПериоду = Перечисления.ВидыИтоговПоказателяПоПериоду.НеРассчитывать;
		КонецЕсли;
		
		тОбъект.ОбменДанными.Загрузка = Истина;
		тОбъект.Записать();
		
	КонецЦикла;

КонецПроцедуры

Процедура ВыполнитьПереходНаПроцессПодготовкиОтчетностиВерсии2(Параметры=Неопределено) Экспорт

	#Область ШаблоныУниверсальныхПроцессов
	
	// Рассчитываем уровни этапов
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныУниверсальныхПроцессов.Ссылка КАК Ссылка,
		|	ШаблоныУниверсальныхПроцессов.УдалитьСвязанныйРегламент КАК УдалитьСвязанныйРегламент
		|ИЗ
		|	Справочник.ШаблоныУниверсальныхПроцессов КАК ШаблоныУниверсальныхПроцессов
		|ГДЕ
		|	ШаблоныУниверсальныхПроцессов.НазначениеПроцесса = ЗНАЧЕНИЕ(Перечисление.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности)
		|	И НЕ ШаблоныУниверсальныхПроцессов.ПометкаУдаления
		|	И НЕ ШаблоныУниверсальныхПроцессов.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		// Рассчитаем уровни этапов
		УправлениеПроцессамиПодготовкиОтчетности.РассчитатьУровниЭтапов(ВыборкаДетальныеЗаписи.Ссылка);
		
		// Изменим связь с регламентом подготовки отчетности
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УдалитьСвязанныйРегламент) Тогда
			
			РегламентОбъект = ВыборкаДетальныеЗаписи.УдалитьСвязанныйРегламент.ПолучитьОбъект();
			Если РегламентОбъект.ИспользоватьПроцесс = Ложь
				ИЛИ РегламентОбъект.ШаблонПроцесса <> ВыборкаДетальныеЗаписи.Ссылка Тогда
				РегламентОбъект.ИспользоватьПроцесс = Истина;
				РегламентОбъект.ШаблонПроцесса = ВыборкаДетальныеЗаписи.Ссылка;
				РегламентОбъект.ОбменДанными.Загрузка = Истина;
				РегламентОбъект.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
		СправочникОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		СправочникОбъект.ШаблонПроцессаПодготовкиОтчетности = Истина;
		СправочникОбъект.ОбменДанными.Загрузка = Истина;
		СправочникОбъект.Записать();
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область ЭтапыПроцессаПодготовкиОтчетности
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭтапыУниверсальныхПроцессов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
		|ГДЕ
		|	ЭтапыУниверсальныхПроцессов.Владелец.НазначениеПроцесса = ЗНАЧЕНИЕ(Перечисление.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности)";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЭтапОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		
		Если ЭтапОбъект.ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.ЭтапПроцессаПодготовкиОтчетности Тогда
			
			// Изменим формат хранения отборов организаций
			Если СтрДлина(ЭтапОбъект.УдалитьОрганизационныеЕдиницыОтбор) > 10 Тогда
				НастройкиСКД = ЗначениеИЗСтрокиВнутр(ЭтапОбъект.УдалитьОрганизационныеЕдиницыОтбор);
				ЭтапОбъект.ОрганизационныеЕдиницыОтбор = Новый ХранилищеЗначения(НастройкиСКД);
			КонецЕсли;
			
			// Уберем удаленные критерии утверждения этапа
			Если ЭтапОбъект.КритерийУтвержденияЭтапа = Перечисления.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УдалитьУтвержденыЭкземплярыОтчетовИзРеестра Тогда
				ЭтапОбъект.КритерийУтвержденияЭтапа = Перечисления.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УтвержденыВсеДокументы;
			ИначеЕсли ЭтапОбъект.КритерийУтвержденияЭтапа = Перечисления.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УдалитьУтвержденыЗаполненныеЭкземплярыОтчетов Тогда
				ЭтапОбъект.КритерийУтвержденияЭтапа = Перечисления.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УтвержденыКонтрольныеДокументы;
			КонецЕсли;
			
			// Переведем часы в дни
			ЭтапОбъект.ДлительностьПлановая = Окр(ЭтапОбъект.ДлительностьПлановая / 24);
			
		Иначе
			
			// Переформатируем этапы, отличные от процесса подготовки отчетности
			ЭтапОбъект.ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.ЭтапПроцессаПодготовкиОтчетности;
			ЭтапОбъект.КритерийУтвержденияЭтапа = Перечисления.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УтвержденыВсеДокументы;
			ЭтапОбъект.ДействиеПоРасписанию = Неопределено;
			ЭтапОбъект.ТипОрганизацийЭтапа = Перечисления.ТипыОрганизационныхЕдиниц.Обычная;
			ЭтапОбъект.ФормируемыеДокументы.Очистить();
			ЭтапОбъект.ДоступныеПараметры.Очистить();
			ЭтапОбъект.ЗначенияУсловийОтборов.Очистить();
			ЭтапОбъект.ЗначенияПараметров.Очистить();
			
		КонецЕсли;
		
		ЭтапОбъект.ОбменДанными.Загрузка = Истина;
		ЭтапОбъект.Записать();
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область СостоянияВыполненияПроцессов
	
	// Скопируем состояния этапов процесса подготовки отчетности
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументУправлениеПериодомСценария.Ссылка КАК УправлениеПериодомСценария,
		|	СостоянияВыполненияПроцессовСрезПоследних.ЭтапПроцесса КАК ЭтапПроцесса,
		|	СостоянияВыполненияПроцессовСрезПоследних.Организация КАК Организация,
		|	СостоянияВыполненияПроцессовСрезПоследних.СостояниеЭтапа КАК СостояниеЭтапа,
		|	СостоянияВыполненияПроцессовСрезПоследних.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.УдалитьСостоянияВыполненияПроцессов.СрезПоследних(, ) КАК СостоянияВыполненияПроцессовСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УправлениеПериодомСценария КАК ДокументУправлениеПериодомСценария
		|		ПО СостоянияВыполненияПроцессовСрезПоследних.Сценарий = ДокументУправлениеПериодомСценария.Сценарий
		|			И СостоянияВыполненияПроцессовСрезПоследних.ПериодСценария = ДокументУправлениеПериодомСценария.ПериодСценария
		|ГДЕ
		|	СостоянияВыполненияПроцессовСрезПоследних.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.УдалитьСостоянияЭтаповПроцессов.Выполняется)
		|	ИЛИ СостоянияВыполненияПроцессовСрезПоследних.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.УдалитьСостоянияЭтаповПроцессов.Утвержден)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.СостоянияЭтаповПроцессаПодготовкиОтчетности.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УправлениеПериодомСценария = ВыборкаДетальныеЗаписи.УправлениеПериодомСценария;
		МенеджерЗаписи.Организация = ВыборкаДетальныеЗаписи.Организация;
		МенеджерЗаписи.Этап = ВыборкаДетальныеЗаписи.ЭтапПроцесса;
		Если ВыборкаДетальныеЗаписи.СостояниеЭтапа = Перечисления.УдалитьСостоянияЭтаповПроцессов.Выполняется Тогда
			МенеджерЗаписи.Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке;
		Иначе
			МенеджерЗаписи.Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен;
		КонецЕсли;
		МенеджерЗаписи.ДатаОкончания = ВыборкаДетальныеЗаписи.ДатаОкончания;
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область РегламентныеЗаданияЭтапов
	
	УправлениеПроцессамиПодготовкиОтчетности.ОбработатьРегламентныеЗаданияЭтапов();
	
	#КонецОбласти
	
	#Область УправлениеПериодомСценария
	
	// Установим состояния запуска процесса
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭкземплярПроцесса.Ссылка КАК Ссылка,
		|	ЭкземплярПроцесса.КлючевойОбъектПроцесса КАК КлючевойОбъектПроцесса,
		|	ЭкземплярПроцесса.СостояниеВыполнения КАК СостояниеВыполнения
		|ИЗ
		|	Документ.ЭкземплярПроцесса КАК ЭкземплярПроцесса
		|ГДЕ
		|	ЭкземплярПроцесса.КлючевойОбъектПроцесса ССЫЛКА Документ.УправлениеПериодомСценария
		|	И ЭкземплярПроцесса.НазначениеПроцесса = ЗНАЧЕНИЕ(Перечисление.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности)
		|	И НЕ ЭкземплярПроцесса.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МенеджерЗаписи = РегистрыСведений.СостоянияПроцессаПодготовкиОтчетности.СоздатьМенеджерЗаписи();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		// Проверим, запущен ли процесс
		МенеджерЗаписи.УправлениеПериодомСценария = ВыборкаДетальныеЗаписи.КлючевойОбъектПроцесса;
		Если ВыборкаДетальныеЗаписи.СостояниеВыполнения = Перечисления.СостоянияПроцесса.ВРаботе Тогда
			МенеджерЗаписи.Состояние = Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен;
		ИначеЕсли ВыборкаДетальныеЗаписи.СостояниеВыполнения = Перечисления.СостоянияПроцесса.Завершен Тогда
			МенеджерЗаписи.Состояние = Перечисления.СостоянияПроцессаПодготовкиОтчетности.Завершен;
		Иначе
			МенеджерЗаписи.Состояние = Перечисления.СостоянияПроцессаПодготовкиОтчетности.НеЗапущен;
		КонецЕсли;
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
		
	#КонецОбласти
	
КонецПроцедуры 

Процедура ОбновитьШаблоныОповещенийПроцессаПодготовкиОтчетности(Параметры=Неопределено) Экспорт
	
	ВыставитьКатегорииЭтаповПодготовкиОтчетности();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныОповещений.Ссылка КАК Ссылка,
		|	ШаблоныОповещений.НазначениеОповещения.ИмяПредопределенныхДанных КАК НазначениеОповещенияИмя
		|ИЗ
		|	Справочник.ШаблоныОповещений КАК ШаблоныОповещений
		|ГДЕ
		|	ШаблоныОповещений.НазначениеОповещения В(&НазначениеОповещения)";
	
	НазначениеОповещения = Новый Массив;
	НазначениеОповещения.Добавить(Справочники.ВидыСобытийОповещений.ТребуетсяЗаполнитьОтчетыПоЭтапу);
	НазначениеОповещения.Добавить(Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусВОбработке);
	НазначениеОповещения.Добавить(Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусЗавершен);
	НазначениеОповещения.Добавить(Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусЗавершенСОшибкой);
	НазначениеОповещения.Добавить(Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусНеАктивен);
	Запрос.УстановитьПараметр("НазначениеОповещения", НазначениеОповещения);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ПоставляемыеНастройки = Справочники.ВидыСобытийОповещений.ПоставляемыеНастройкиВидовСобытий();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтрокаНастройки = ПоставляемыеНастройки.Найти(ВыборкаДетальныеЗаписи.НазначениеОповещенияИмя, "ВидСобытия");
		
		ШаблонОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ШаблонОбъект.Шаблон = Новый ХранилищеЗначения(СтрокаНастройки.ШаблонОповещенияПоУмолчанию);
		ШаблонОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


Процедура ВыставитьКатегорииЭтаповПодготовкиОтчетности()
	
	КатегорияПроцессПодготовкиОтчетности = Справочники.КатегорииСобытийОповещений.СобытияПроцессаПодготовкиОтчетности;
	
	ВидСобытияСсылка = Справочники.ВидыСобытийОповещений.ТребуетсяЗаполнитьОтчетыПоЭтапу;
	ВидСобытияОбъект = ВидСобытияСсылка.ПолучитьОбъект();
	КатегорияСобытия = ВидСобытияОбъект.КатегорияСобытия;
	Если (НЕ ЗначениеЗаполнено(КатегорияСобытия)) ИЛИ (КатегорияСобытия <> КатегорияПроцессПодготовкиОтчетности) Тогда
		ВидСобытияОбъект.КатегорияСобытия = КатегорияПроцессПодготовкиОтчетности;
		ВидСобытияОбъект.Записать();
	КонецЕсли;
	
	ВидСобытияСсылка = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусВОбработке;
	ВидСобытияОбъект = ВидСобытияСсылка.ПолучитьОбъект();
	КатегорияСобытия = ВидСобытияОбъект.КатегорияСобытия;
	Если (НЕ ЗначениеЗаполнено(КатегорияСобытия)) ИЛИ (КатегорияСобытия <> КатегорияПроцессПодготовкиОтчетности) Тогда
		ВидСобытияОбъект.КатегорияСобытия = КатегорияПроцессПодготовкиОтчетности;
		ВидСобытияОбъект.Записать();
	КонецЕсли;
	
	ВидСобытияСсылка = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусЗавершен;
	ВидСобытияОбъект = ВидСобытияСсылка.ПолучитьОбъект();
	КатегорияСобытия = ВидСобытияОбъект.КатегорияСобытия;
	Если (НЕ ЗначениеЗаполнено(КатегорияСобытия)) ИЛИ (КатегорияСобытия <> КатегорияПроцессПодготовкиОтчетности) Тогда
		ВидСобытияОбъект.КатегорияСобытия = КатегорияПроцессПодготовкиОтчетности;
		ВидСобытияОбъект.Записать();
	КонецЕсли;
	
	ВидСобытияСсылка = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусЗавершенСОшибкой;
	ВидСобытияОбъект = ВидСобытияСсылка.ПолучитьОбъект();
	КатегорияСобытия = ВидСобытияОбъект.КатегорияСобытия;
	Если (НЕ ЗначениеЗаполнено(КатегорияСобытия)) ИЛИ (КатегорияСобытия <> КатегорияПроцессПодготовкиОтчетности) Тогда
		ВидСобытияОбъект.КатегорияСобытия = КатегорияПроцессПодготовкиОтчетности;
		ВидСобытияОбъект.Записать();
	КонецЕсли;
	
	ВидСобытияСсылка = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусНеАктивен;
	ВидСобытияОбъект = ВидСобытияСсылка.ПолучитьОбъект();
	КатегорияСобытия = ВидСобытияОбъект.КатегорияСобытия;
	Если (НЕ ЗначениеЗаполнено(КатегорияСобытия)) ИЛИ (КатегорияСобытия <> КатегорияПроцессПодготовкиОтчетности) Тогда
		ВидСобытияОбъект.КатегорияСобытия = КатегорияПроцессПодготовкиОтчетности;
		ВидСобытияОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры
