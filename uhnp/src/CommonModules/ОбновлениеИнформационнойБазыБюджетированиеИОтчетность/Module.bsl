		// не БМ, НМ, Perform
		Возврат;
	КонецЕсли;
	
	// Обновление поставляемого профиля
	Профиль = Справочники.ПрофилиГруппДоступа.ПоставляемыйПрофильПоИдентификатору("62730c03-81d6-11e0-a42a-be487808c52b"); // Главный бухгалтер
