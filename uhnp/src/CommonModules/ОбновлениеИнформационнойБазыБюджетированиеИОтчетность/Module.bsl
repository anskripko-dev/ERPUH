Процедура ОбновитьРеквизитыПоказателей(Параметры=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоказателиОтчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)
		|		И НЕ ПоказателиОтчетов.ЧисловойПоказатель";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ПоказательОбъект=Результат.Ссылка.ПолучитьОбъект();
		ПоказательОбъект.ЧисловойПоказатель=Истина;
		ПоказательОбъект.НормализованныйКод=СокрЛП(ПоказательОбъект.Код);
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПоказательОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьПрофильНастраиваемойОтчетности(Параметры=Неопределено) Экспорт
	
	// Обновление поставляемого профиля
	Профиль = Справочники.ПрофилиГруппДоступа.ПоставляемыйПрофильПоИдентификатору("c0cb16f1-6b8f-4e41-a1a4-a0de4aa48c86");
	Справочники.ПрофилиГруппДоступа.ЗаполнитьПоставляемыйПрофиль(Профиль, Истина);
	
	// Добавление роли в существующие профили
	РодительРоли = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоНаименованию("Роли");
	Роль1 = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("Имя","ДобавлениеИзменениеБюджетированиеИОтчетность", РодительРоли);
	Роль2 = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("Имя","БазовыеПраваБюджетированиеИОтчетность", РодительРоли);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПрофилиГруппДоступаРоли.Ссылка КАК Профиль,
		|	МАКСИМУМ(ПрофилиГруппДоступаРоли.Роль = &Роль1) КАК ЕстьРоль1,
		|	МАКСИМУМ(ПрофилиГруппДоступаРоли.Роль = &Роль2) КАК ЕстьРоль2
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрофилиГруппДоступаРоли.Ссылка
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ПрофилиГруппДоступаРоли.Роль = &Роль1) = ИСТИНА И
		|	МАКСИМУМ(ПрофилиГруппДоступаРоли.Роль = &Роль2) = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Роль1", Роль1);
	Запрос.УстановитьПараметр("Роль2", Роль2);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПрофильОбъект = ВыборкаДетальныеЗаписи.Профиль.ПолучитьОбъект();
		НоваяРоль = ПрофильОбъект.Роли.Добавить();
		НоваяРоль.Роль = Роль2;
		ПрофильОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

