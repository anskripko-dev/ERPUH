//Блинова М.А. 17.04.2025 Выполнение задач №000053254
Процедура ОтражениеДокументовПоОстаткамИОборотамНЗС() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.тн_ОтражениеДокументовПоОборотамИОстаткамНЗС);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тн_НеОтраженныеДокументыПоНЗС.Регистратор КАК Регистратор,
	|	СУММА(тн_НеОтраженныеДокументыПоНЗС.СтоимостьУУ) КАК СтоимостьУУ,
	|	МАКСИМУМ(тн_НеОтраженныеДокументыПоНЗС.ПринадлежностьМСФО) КАК ПринадлежностьМСФО,
	|	МАКСИМУМ(тн_НеОтраженныеДокументыПоНЗС.ОперацияМСФО) КАК ОперацияМСФО
	|ПОМЕСТИТЬ ВТ_НеотраженныеПредв
	|ИЗ
	|	РегистрСведений.тн_НеОтраженныеДокументыПоНЗС КАК тн_НеОтраженныеДокументыПоНЗС
	|
	|СГРУППИРОВАТЬ ПО
	|	тн_НеОтраженныеДокументыПоНЗС.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МСФО.Регистратор КАК Регистратор,
	|	МСФО.СчетДт КАК СчетДт,
	|	ВЫБОР
	|		КОГДА МСФО.СчетДт В ИЕРАРХИИ
	|				(ВЫБРАТЬ
	|					тн_СчетаУчетаОС.СчетУчетаОС КАК СчетУчетаОС
	|				ИЗ
	|					РегистрСведений.тн_СчетаУчетаОС КАК тн_СчетаУчетаОС)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОтраженоПоУУНЗС,
	|	МСФО.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	МСФО.Регистратор.ИсходныйДокумент КАК РегистраторИсходныйДокумент
	|ПОМЕСТИТЬ ВТ_МСФОПредв
	|ИЗ
	|	РегистрБухгалтерии.МСФО КАК МСФО
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(МСФО.Регистратор) = ТИП(Документ.ТрансформационнаяКорректировка)
	|	И МСФО.Регистратор.ИсходныйДокумент В
	|			(ВЫБРАТЬ
	|				ВТ_НеотраженныеПредв.Регистратор КАК Регистратор
	|			ИЗ
	|				ВТ_НеотраженныеПредв КАК ВТ_НеотраженныеПредв)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_МСФОПредв.Регистратор КАК Регистратор,
	|	ВТ_МСФОПредв.СчетДт КАК СчетДт,
	|	ВТ_МСФОПредв.ОтраженоПоУУНЗС КАК ОтраженоПоУУНЗС,
	|	СУММА(ВТ_МСФОПредв.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
	|	ВТ_МСФОПредв.РегистраторИсходныйДокумент КАК РегистраторИсходныйДокумент
	|ПОМЕСТИТЬ ВТ_МСФО
	|ИЗ
	|	ВТ_МСФОПредв КАК ВТ_МСФОПредв
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_МСФОПредв.Регистратор,
	|	ВТ_МСФОПредв.СчетДт,
	|	ВТ_МСФОПредв.ОтраженоПоУУНЗС,
	|	ВТ_МСФОПредв.РегистраторИсходныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НеотраженныеПредв.Регистратор КАК Регистратор,
	|	ВТ_НеотраженныеПредв.СтоимостьУУ КАК СтоимостьУУ,
	|	ВТ_МСФО.СчетДт КАК СчетДт,
	|	ВТ_МСФО.ОтраженоПоУУНЗС КАК ОтраженоПоУУНЗС,
	|	ВТ_МСФО.СуммаВВалютеУчета КАК СуммаВВалютеУчета
	|ПОМЕСТИТЬ ВТ_Итоговая
	|ИЗ
	|	ВТ_НеотраженныеПредв КАК ВТ_НеотраженныеПредв
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МСФО КАК ВТ_МСФО
	|		ПО ВТ_НеотраженныеПредв.Регистратор = ВТ_МСФО.РегистраторИсходныйДокумент
	|			И ВТ_НеотраженныеПредв.СтоимостьУУ = ВТ_МСФО.СуммаВВалютеУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тн_НеОтраженныеДокументыПоНЗС.Регистратор КАК Регистратор,
	|	тн_НеОтраженныеДокументыПоНЗС.ОбъектУчета КАК ОбъектУчета,
	|	ВТ_Итоговая.ОтраженоПоУУНЗС КАК ОтраженоПоУУНЗС,
	|	тн_НеОтраженныеДокументыПоНЗС.СтоимостьУУ КАК СтоимостьУУ,
	|	тн_НеОтраженныеДокументыПоНЗС.ПринадлежностьМСФО КАК ПринадлежностьМСФО,
	|	тн_НеОтраженныеДокументыПоНЗС.ОперацияМСФО КАК ОперацияМСФО,
	|	ВТ_Итоговая.СчетДт КАК СчетДт
	|ИЗ
	|	ВТ_Итоговая КАК ВТ_Итоговая
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_НеОтраженныеДокументыПоНЗС КАК тн_НеОтраженныеДокументыПоНЗС
	|		ПО ВТ_Итоговая.Регистратор = тн_НеОтраженныеДокументыПоНЗС.Регистратор
	|ИТОГИ ПО
	|	Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Итоговая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_НеотраженныеПредв
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_МСФО";	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПоДокументам = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоДокументам.Следующий() Цикл
		НачатьТранзакцию();
		ТекущийДокумент = ВыборкаПоДокументам.Регистратор;
		
		Попытка
				// Создаем движения для регистра оборотов
				НаборЗаписейОборотов = РегистрыНакопления.тн_ОборотыПоНЗСиОС.СоздатьНаборЗаписей();
				НаборЗаписейОборотов.Отбор.Регистратор.Значение = ТекущийДокумент; 
				НаборЗаписейОборотов.Прочитать();
				
				// Создаем движения для регистра остатков
				НаборЗаписейОстатков = РегистрыНакопления.тн_ОстаткиПоНЗСиОС.СоздатьНаборЗаписей();
				НаборЗаписейОстатков.Отбор.Регистратор.Значение = ТекущийДокумент; 
				
				//Сохраним записи для обхода
				ТЗОборотов =  НаборЗаписейОборотов.Выгрузить();
				ВыборкаПоОбъектамУчета = ВыборкаПоДокументам.Выбрать();
				
				Пока ВыборкаПоОбъектамУчета.Следующий() Цикл
					Если ВыборкаПоОбъектамУчета.ОтраженоПоУУНЗС Тогда
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("ОбъектУчета", ВыборкаПоОбъектамУчета.ОбъектУчета); 
					ПараметрыОтбора.Вставить("РазделУчета", Перечисления.тн_РазделУчетаМСФО.УУ);
					СтрокиПоУУИОбъекту = ТЗОборотов.НайтиСтроки(ПараметрыОтбора); 				
					Если СтрокиПоУУИОбъекту.Количество() = 0 Тогда
						НоваяЗапись = ТЗОборотов.Добавить(); 
						НоваяЗапись.Период = ТекущийДокумент.Дата;
						НоваяЗапись.Стоимость = ВыборкаПоОбъектамУчета.СтоимостьУУ;
						НоваяЗапись.Организация = ТекущийДокумент.Организация; 
						НоваяЗапись.ОбъектУчета = ВыборкаПоОбъектамУчета.ОбъектУчета; 
						НоваяЗапись.РазделУчета = Перечисления.тн_РазделУчетаМСФО.УУ;
						НоваяЗапись.ОперацияМСФО = ВыборкаПоОбъектамУчета.ОперацияМСФО; 
						НоваяЗапись.ПринадлежностьМСФО = ВыборкаПоОбъектамУчета.ПринадлежностьМСФО;
						НоваяЗапись.Регистратор =  ТекущийДокумент;
                        НоваяЗапись.Активность = Истина;
					Иначе
						Для Каждого СтрокаПоУУиОбъекту Из СтрокиПоУУИОбъекту Цикл  
							СтрокаПоУУиОбъекту.Период = ТекущийДокумент.Дата;
							СтрокаПоУУиОбъекту.Стоимость = ВыборкаПоОбъектамУчета.СтоимостьУУ;
							СтрокаПоУУиОбъекту.Организация = ТекущийДокумент.Организация; 
							СтрокаПоУУиОбъекту.ОбъектУчета = ВыборкаПоОбъектамУчета.ОбъектУчета; 
							СтрокаПоУУиОбъекту.РазделУчета = Перечисления.тн_РазделУчетаМСФО.УУ;
							СтрокаПоУУиОбъекту.ОперацияМСФО = ВыборкаПоОбъектамУчета.ОперацияМСФО; 
							СтрокаПоУУиОбъекту.ПринадлежностьМСФО = ВыборкаПоОбъектамУчета.ПринадлежностьМСФО;  
							СтрокаПоУУиОбъекту.Регистратор =  ТекущийДокумент;
						КонецЦикла;
					КонецЕсли;
					
					НоваяЗапись = НаборЗаписейОстатков.Добавить();
					НоваяЗапись.Период = ТекущийДокумент.Дата;
					НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Приход;
					НоваяЗапись.Стоимость = ВыборкаПоОбъектамУчета.СтоимостьУУ;
					НоваяЗапись.Организация = ТекущийДокумент.Организация; 
					НоваяЗапись.ОбъектУчета = ВыборкаПоОбъектамУчета.ОбъектУчета;										 
                    НоваяЗапись.Регистратор =  ТекущийДокумент; 
				КонецЕсли;	
				КонецЦикла;  
				НаборЗаписейОборотов.Загрузить(ТЗОборотов);
				НаборЗаписейОборотов.Записать();
                НаборЗаписейОстатков.Записать();
					
		//документы отражены
		НаборЗаписей = РегистрыСведений.тн_НеОтраженныеДокументыПоНЗС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Значение = ТекущийДокумент; 
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
КонецЦикла;
		
КонецПроцедуры // ОтражениеДокументовПоОстаткамИОборотамНЗС()

#КонецОбласти  

