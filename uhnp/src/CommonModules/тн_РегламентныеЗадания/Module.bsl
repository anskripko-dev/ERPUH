			ОбработкаОбъект.ИмяОбъектаМетаданных			= ИмяОбъектаМетаданных;
			ОбработкаОбъект.СпособОбработки 				= 1;     
			ОбработкаОбъект.ЭлементДляПоиска				= СтрокаТаблицыЗаменяемыхОбъектов.Объект;
			ОбработкаОбъект.ВариантПоиска					= "И";                        
			ОбработкаОбъект.ТаблицаАналитики				= СтруктураНастройкиЗамены.ТипОбъекта;
			ОбработкаОбъект.ТаблицаРеквизитовДляПоиска	= ТаблицаРеквизитовДляПоиска;
			// НАЧАЛО Николаев Павел 08.11.2024 Выполнение задач №000051555
			//ОбработкаОбъект.ЕстьРеквизитыНСИ		= Ложь;                
			ОбработкаОбъект.ЕстьРеквизитНСИ_ВИБ		= Ложь;                
