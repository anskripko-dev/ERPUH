Процедура тнОчисткаЗапросыRabbitMQ() Экспорт
	
	СрокХранения = Константы.тн_СрокХраненияДанныхЗапросыRabbitMQ.Получить(); 
	
	Если Не ЗначениеЗаполнено(СрокХранения) Тогда 
		Возврат;
	КонецЕсли;
		
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ГраницаОчисткиЗаписей = КонецДня(тн_Интеграция_УПП.ТекущаяДатаСервера() - 86400 * СрокХранения);
    ГраницаОчисткиЗаписей = КонецДня(ТекущаяДатаСервера() - 86400 * СрокХранения);
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ЗапросыRabbitMQ.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
		|	тн_ЗапросыRabbitMQ.ВидСообщения КАК ВидСообщения
		|ИЗ
		|	РегистрСведений.тн_ЗапросыRabbitMQ КАК тн_ЗапросыRabbitMQ
		|ГДЕ
		|	тн_ЗапросыRabbitMQ.ДатаОтправкиЗапроса < &ГраницаОчисткиЗаписей";
	
	Запрос.УстановитьПараметр("ГраницаОчисткиЗаписей", ГраницаОчисткиЗаписей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.тн_ЗапросыRabbitMQ.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.ВидСообщения = Выборка.ВидСообщения;
		МенеджерЗаписи.Удалить();
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

