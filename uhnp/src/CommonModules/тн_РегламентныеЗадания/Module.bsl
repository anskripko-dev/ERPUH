// Белышев Игорь 28.12.2022 Выполнение задач №000043818
Процедура тн_ПроведениеДокументовДляПереотражениявРеглУчете() Экспорт 
	
	// НАЧАЛО Юдина Екатерина 29.04.2026 Выполнение задач №000057518
	//Обработка = Обработки.тн_ПроведениеДокументовДляПереотражениявРеглУчете.Создать();
	//Обработка.ОбработатьДокументы(Ложь);             
	
	СоответствиеДатЗапретаОрганизаций = ПолучитьСоответствиеДатЗапретаОрганизаций();
	Если СоответствиеДатЗапретаОрганизаций.Количество() = 0 Тогда 
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	(Организации.ИспользоватьВРегламентированномУчете
	|			ИЛИ Организации.ИностранныйНалоговыйРезидент
	|				И Организации.ИностраннаяСтруктураБезОбразованияЮрЛица
	|			ИЛИ Организации.ИностранныйНалоговыйРезидент
	|			ИЛИ Организации.ЭлиминирующаяОрганизация)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаДатЗапретаОрганизаций = Новый ТаблицаЗначений;  
	ТаблицаДатЗапретаОрганизаций.Колонки.Добавить("Организация");
	ТаблицаДатЗапретаОрганизаций.Колонки.Добавить("ДатаЗапрета");
	
	// Может быть общей датой раздела, но если не заполнена, то общей датой пользователя/ всех пользователей
	ОбщаяДатаЗапрета = СоответствиеДатЗапретаОрганизаций.Получить(Справочники.Организации.ПустаяСсылка()); 
	
	Пока Выборка.Следующий() Цикл      
		ДатаЗапрета = СоответствиеДатЗапретаОрганизаций.Получить(Выборка.Ссылка);
		Если ДатаЗапрета = Неопределено Тогда 
			Если ОбщаяДатаЗапрета <> Неопределено Тогда
				НС = ТаблицаДатЗапретаОрганизаций.Добавить();
				НС.Организация = Выборка.Ссылка; 
				НС.ДатаЗапрета = ОбщаяДатаЗапрета; 
			КонецЕсли;	
		Иначе    
			НС = ТаблицаДатЗапретаОрганизаций.Добавить();
			НС.Организация = Выборка.Ссылка; 
			НС.ДатаЗапрета = ДатаЗапрета; 
		КонецЕсли;		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОтражениеДокументовВРеглУчете.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТ_Статусы
	|ИЗ
	|	РегистрСведений.ОтражениеДокументовВРеглУчете КАК ОтражениеДокументовВРеглУчете
	|ГДЕ
	|	ОтражениеДокументовВРеглУчете.Период >= &НачалоПериода
	|	И ОтражениеДокументовВРеглУчете.Период < &КонецПериода
	|	И ОтражениеДокументовВРеглУчете.Статус = &СтатусОтражен
	|	И ОтражениеДокументовВРеглУчете.Организация В(&МассивОрганизаций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Хозрасчетный.Регистратор КАК Регистратор,
	|	Хозрасчетный.НомерСтроки КАК НомерСтроки,
	|	Хозрасчетный.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_Хозрасчетный
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Регистратор В
	|			(ВЫБРАТЬ
	|				ВТ_Статусы.Регистратор
	|			ИЗ
	|				ВТ_Статусы КАК ВТ_Статусы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Статусы.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Статусы КАК ВТ_Статусы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Хозрасчетный КАК ВТ_Хозрасчетный
	|		ПО ВТ_Статусы.Регистратор = ВТ_Хозрасчетный.Регистратор
	|ГДЕ
	|	ВТ_Хозрасчетный.Регистратор ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА ВТ_Статусы.Регистратор ССЫЛКА Документ.СчетФактураВыданныйАванс
	|				ТОГДА ВЫРАЗИТЬ(ВТ_Статусы.Регистратор КАК Документ.СчетФактураВыданныйАванс).Сумма <> 0
	|			КОГДА ВТ_Статусы.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.СписаниеНедостачТоваров
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.ПрочееОприходованиеТоваров
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.СборкаТоваров
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.ПроизводствоБезЗаказа
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.ВнутреннееПотребление
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.ПоступлениеТоваровНаСклад
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.СборкаТоваров
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.ПересортицаТоваров
	|					ИЛИ ВТ_Статусы.Регистратор ССЫЛКА Документ.ОприходованиеИзлишковТоваров
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВТ_Статусы.Регистратор.СуммаДокумента <> 0
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Статусы.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Статусы.Регистратор.Дата";
	
	Запрос.УстановитьПараметр("КонецПериода", ТекущаяДатаСервера());
	Запрос.УстановитьПараметр("СтатусОтражен", Перечисления.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВРеглУчете);    
	
	ТаблицаДат = ТаблицаДатЗапретаОрганизаций.Скопировать(,"ДатаЗапрета");
	ТаблицаДат.Свернуть("ДатаЗапрета");
	
	Для Каждого СтрокаДат Из ТаблицаДат Цикл
		
		МассивОрганизаций = Новый Массив;
		
		НайденныеСтроки = ТаблицаДатЗапретаОрганизаций.НайтиСтроки(Новый Структура("ДатаЗапрета", СтрокаДат.ДатаЗапрета));
		Для Каждого Строка Из НайденныеСтроки Цикл 
			МассивОрганизаций.Добавить(Строка.Организация);
		КонецЦикла;
		
		Запрос.УстановитьПараметр("НачалоПериода", СтрокаДат.ДатаЗапрета + 86400);
		Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
		
		Выборка = Запрос.Выполнить().Выбрать();   
		
		Пока Выборка.Следующий() Цикл   
			
			ДокОбъект = Выборка.Регистратор.ПолучитьОбъект(); 
			
			Если ДокОбъект.Проведен Тогда 
				
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);  
					ЗаписьЖурналаРегистрации("Перепроведение документа регламентным заданием ""Проведение документов для переотражения в регл. учете (тн)""",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.РегламентныеЗадания.тн_ПроведениеДокументовДляПереотражениявРеглУчете, 
					Выборка.Регистратор); 
				Исключение   
					ЗаписьЖурналаРегистрации("Фоновое задание. Проведение документов для переотражения в регл. учете (тн)",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.РегламентныеЗадания.тн_ПроведениеДокументовДляПереотражениявРеглУчете, 
					Выборка.Регистратор,
					ОписаниеОшибки()); 
				КонецПопытки;  
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла;	
	// КОНЕЦ Юдина Екатерина 29.04.2026 Выполнение задач №000057518  
	
КонецПроцедуры      

// Юдина Екатерина 29.04.2026 Выполнение задач №000057518
//
Функция ПолучитьСоответствиеДатЗапретаОрганизаций()
	
	СоответствиеДатЗапретаОрганизаций = Новый Соответствие;
	
	ДействующиеДаты = ДатыЗапретаИзмененияСлужебный.ДействующиеДатыЗапрета();     
	Если Не ДействующиеДаты.ЗапретИзмененияИспользуется Тогда
		Возврат СоответствиеДатЗапретаОрганизаций;	
	КонецЕсли;       
	
	СоответствиеПользователей = ДействующиеДаты.ДляПользователей.Адресаты; 
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();

	// По пользователю
    ДополнитьСоответствиеДатЗапретаОрганизацийПоПользователю(СоответствиеПользователей, СоответствиеДатЗапретаОрганизаций, ТекущийПользователь);   
	// По общей дате запрета
	ДополнитьСоответствиеДатЗапретаОрганизацийПоПользователю(СоответствиеПользователей, СоответствиеДатЗапретаОрганизаций, Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей);
	
	Возврат СоответствиеДатЗапретаОрганизаций;	
	
КонецФункции   

// Юдина Екатерина 29.04.2026 Выполнение задач №000057518
//
Процедура ДополнитьСоответствиеДатЗапретаОрганизацийПоПользователю(СоответствиеПользователей, СоответствиеДатЗапретаОрганизаций, Пользователь)
	
	ПустаяОрганизация = Справочники.Организации.ПустаяСсылка();
	Если СоответствиеДатЗапретаОрганизаций.Получить(ПустаяОрганизация) <> Неопределено Тогда 
		 // Определена общая дата запрета, по которой определяется дата всех организаций
		 Возврат;
	КонецЕсли;
	
	ДанныеПоРазделам = СоответствиеПользователей.Получить(Пользователь);
	
	Если ДанныеПоРазделам <> Неопределено Тогда
		
		РазделБУ = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.НайтиПоНаименованию("Бухгалтерский учет", Истина);
		ДанныеПоРазделуБУ = ДанныеПоРазделам.Получить(РазделБУ);
		ОбщаяДатаПользователя = ДанныеПоРазделам.Получить(ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка());
		
		Если ДанныеПоРазделуБУ <> Неопределено Тогда   
			
			Для Каждого Строка Из ДанныеПоРазделуБУ Цикл
				
				Если ТипЗнч(Строка.Ключ) = Тип("СправочникСсылка.Организации") Тогда 
					СоответствиеДатЗапретаОрганизаций.Вставить(Строка.Ключ, Строка.Значение);  
				ИначеЕсли РазделБУ = Строка.Ключ Тогда
					// Общая дата раздела по пользователю
					СоответствиеДатЗапретаОрганизаций.Вставить(ПустаяОрганизация, Строка.Значение);  
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Общая дата для пользователя
		Если СоответствиеДатЗапретаОрганизаций.Получить(ПустаяОрганизация) = Неопределено Тогда
			
			СоответствиеДатЗапретаОрганизаций.Вставить(Справочники.Организации.ПустаяСсылка(), 
				ОбщаяДатаПользователя.Получить(ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка()));
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

