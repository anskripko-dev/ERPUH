Процедура ДобавлениеФизЛицВГруппуОтветственныхЗаОригиналыПервичныхДокументов() Экспорт 
	
	//берем 31 день как последний месяц
	КоличествоДнейВМесяце = 31;    
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДатаОтсечкиПоДокументам = КонецДня(тн_Интеграция_УПП.ТекущаяДатаСервера() - 86400*КоличествоДнейВМесяце); 
	ДатаОтсечкиПоДокументам = КонецДня(ТекущаяДатаСервера() - 86400*КоличествоДнейВМесяце); 
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПриобретениеТоваровУслуг.тн_ОтветственныйСотрудник КАК тн_ОтветственныйСотрудник
		|ПОМЕСТИТЬ ВТ_Предварительная
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
		|ГДЕ
		|	ПриобретениеТоваровУслуг.Дата >= &Дата
		|	И ПриобретениеТоваровУслуг.тн_ОтветственныйСотрудник.Родитель <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.тн_ОтветственныеЗаОригиналыПервичныхДокументов)
		|	И ПриобретениеТоваровУслуг.Проведен
		|	И НЕ ПриобретениеТоваровУслуг.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПриобретениеУслугПрочихАктивов.тн_ОтветственныйСотрудник
		|ИЗ
		|	Документ.ПриобретениеУслугПрочихАктивов КАК ПриобретениеУслугПрочихАктивов
		|ГДЕ
		|	ПриобретениеУслугПрочихАктивов.Дата >= &Дата
		|	И ПриобретениеУслугПрочихАктивов.тн_ОтветственныйСотрудник.Родитель <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.тн_ОтветственныеЗаОригиналыПервичныхДокументов)
		|	И ПриобретениеУслугПрочихАктивов.Проведен
		|	И НЕ ПриобретениеУслугПрочихАктивов.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Предварительная.тн_ОтветственныйСотрудник КАК тн_ОтветственныйСотрудник
		|ИЗ
		|	ВТ_Предварительная КАК ВТ_Предварительная
		|
		|УПОРЯДОЧИТЬ ПО
		|	тн_ОтветственныйСотрудник";
	
	Запрос.УстановитьПараметр("Дата", ДатаОтсечкиПоДокументам);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ФизЛицоОбъект = ВыборкаДетальныеЗаписи.тн_ОтветственныйСотрудник.ПолучитьОбъект();  
		ФизЛицоОбъект.Родитель = Справочники.ФизическиеЛица.тн_ОтветственныеЗаОригиналыПервичныхДокументов; 
		Попытка
			ФизЛицоОбъект.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("ДобавлениеФизЛицВГруппуОтветственныхЗаОригиналыПервичныхДокументов", УровеньЖурналаРегистрации.Ошибка,,,
				"Не удалось переместить физлицо " + ВыборкаДетальныеЗаписи.тн_ОтветственныйСотрудник + " в группу ответственных сотрудников");
			Возврат;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры
