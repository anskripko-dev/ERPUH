
#Область АвтосверкаПоКлючевымТочкам

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Процедура АвтосверкаПоКлючевымТочкам_тн_РегламентныеЗадания() Экспорт
	
	ОбработкаАвтосверка = Обработки.тн_АвтосверкаПоКлючевымПолям.Создать();
	ОбработкаАвтосверка.ЗаполнитьНастройкиСКД_ЗапросДанных();
	ОбработкаАвтосверка.ЗаполнитьСоответствиеКолонокИ_МакетовСКД();
	ОбработкаАвтосверка.ЕстьСохраненныеНастройки = ОбработкаАвтосверка.ЗагрузитьНастройкиОбработки();
	Если Не ОбработкаАвтосверка.ЕстьСохраненныеНастройки Тогда
		ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Ошибка,,,
			"Нет сохраненных настроек для обработки АвтосверкаПоКлючевымТочкам");
		Возврат;
	КонецЕсли;	
	ОбработкаАвтосверка.ЗаполнитьНеСохраняемыеНастройки(ОбработкаАвтосверка.ЕстьСохраненныеНастройки);

	ИдентификаторЗапроса = ПолучитьИдентификаторЗапросаДанныхСервер();
	
	ПараметрыСтруктура = Новый Структура();
	ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	ПараметрыСтруктура.Вставить("ПоДокументам", Ложь);
	ПараметрыСтруктура.Вставить("ОтправкаЗапроса", Истина);
	
	СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура, ОбработкаАвтосверка);
			
	Если ОтправитьСообщениеЗапросСервер(ОбработкаАвтосверка) Тогда
		
		ДобавитьЗаписьДанныеАвтосверкаСервер(ПараметрыСтруктура, ОбработкаАвтосверка);
		//2. Ожидаем ответа
		Попытка
			СтруктураРезультат = Обработки.тн_АвтосверкаПоКлючевымПолям.ПолучитьСтруктуруРезультат(ПараметрыСтруктура);
		Исключение
			ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Ошибка,,,
				"Ошибка при получении ответа");
			Возврат;
		КонецПопытки;
		
		ПриЗавершенииОбработкиОтветногоСообщения(СтруктураРезультат, ОбработкаАвтосверка, ИдентификаторЗапроса);
	КонецЕсли;	
	
	СформироватьПисьмаНаОтправку(ОбработкаАвтосверка);
	
КонецПроцедуры

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Процедура ОбработатьРезультатВыполнения(СтруктураРезультат, ОбработкаОбъект)
		
	ОбработкаОбъект.СообщениеОтветERP_От_ОКС = СтруктураРезультат.Результат;
	ОбработкаОбъект.ПоДокументам = СтруктураРезультат.ПоДокументам;
		
	СтруктураОбработка = ОбработкаОбъект.СформироватьСтруктуруОбработкаОтветаНаЗапрос();
	СтруктураРезультат.Вставить("ТребуетсяДетализация", СтруктураОбработка.ТребуетсяДетализация);
	Если СтруктураОбработка.ТребуетсяДетализация = Истина Тогда
		ОбработкаОбъект.СтруктураСообщенияСверкаПоОстаткам = ЗначениеВСтрокуВнутр(СтруктураОбработка);
	КонецЕсли;
	
КонецПроцедуры

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Процедура ПриЗавершенииОбработкиОтветногоСообщения(СтруктураРезультат, ОбработкаАвтосверка, ИдентификаторЗапроса) 
	
	ОбработатьРезультатВыполнения(СтруктураРезультат, ОбработкаАвтосверка);
	
	//4. Анализируем требуется ли детализация по документам
	Если СтруктураРезультат.ТребуетсяДетализация = Истина Тогда
		ПараметрыСтруктура = Новый Структура();
		ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
		ПараметрыСтруктура.Вставить("ПоДокументам", Истина);
		ПараметрыСтруктура.Вставить("ОтправкаЗапроса", Истина);
		
		СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура, ОбработкаАвтосверка);
		
		Если ОтправитьСообщениеЗапросСервер(ОбработкаАвтосверка) Тогда
			
			ДобавитьЗаписьДанныеАвтосверкаСервер(ПараметрыСтруктура, ОбработкаАвтосверка);
						
			Попытка
				СтруктураРезультат = Обработки.тн_АвтосверкаПоКлючевымПолям.ПолучитьСтруктуруРезультат(ПараметрыСтруктура);
			Исключение
				ВызватьИсключение "Ошибка при получении ответа";
			КонецПопытки;
			ПриЗавершенииОбработкиОтветногоСообщения(СтруктураРезультат, ОбработкаАвтосверка, ИдентификаторЗапроса);
			
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Функция ПолучитьАдресЭППользователей(Пользователи)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователи", Пользователи);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПользователиКонтактнаяИнформация.АдресЭП КАК ПользовательАдресЭП,
	|	ПользователиКонтактнаяИнформация.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|ГДЕ
	|	ПользователиКонтактнаяИнформация.Ссылка В(&Пользователи)
	|	И ПользователиКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И ПользователиКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат.Выбрать();
	КонецЕсли;
	
КонецФункции

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Функция ПолучитьПользователей(НастройкиКомпановки)
	
	МасПользователи = Новый Массив;
	Для Каждого Элемент Из НастройкиКомпановки.Отбор.Элементы Цикл
		МасПользователи.Добавить(Элемент.ПравоеЗначение);
	КонецЦикла;
	
	ВыборкаАдресов = ПолучитьАдресЭППользователей(МасПользователи);
	Возврат ВыборкаАдресов;
	
КонецФункции

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Процедура ДобавитьПисьмо(Письма, ВыборкаАдресов, ТД, ИмяФайла, НастройкиПользователя)
	
	Если ТД.ВысотаТаблицы = 0 Тогда
		Возврат;
	КонецЕсли;   
	
	Письмо = Новый Структура;
	Письмо.Вставить("ИмяОтправителя",	"");
	Письмо.Вставить("Отправитель", Новый Структура("ОтображаемоеИмя, Адрес"));
	Письмо.Вставить("СлепыеКопии", Новый Массив);
	
	ПолучателиПисьма = Новый ТаблицаЗначений;
	ПолучателиПисьма.Колонки.Добавить("Адрес");
	ПолучателиПисьма.Колонки.Добавить("Представление");
	ПолучателиПисьма.Колонки.Добавить("Контакт");
	
	Пока ВыборкаАдресов.Следующий() Цикл
		НоваяСтрока = ПолучателиПисьма.Добавить();
		НоваяСтрока.Адрес				= ВыборкаАдресов.ПользовательАдресЭП;
		НоваяСтрока.Представление		= ВыборкаАдресов.ПользовательАдресЭП;
		НоваяСтрока.Контакт				= ВыборкаАдресов.Ссылка;
	КонецЦикла;
	
	Письмо.Вставить("Получатели", ПолучателиПисьма);
	Письмо.Вставить("ИдентификаторСообщения", Строка(Новый УникальныйИдентификатор));
	Письмо.Вставить("Тема", Строка("Результаты автосверки"));
	Письмо.Вставить("Копии", Новый Массив);
	Письмо.Вставить("ОбратныйАдрес", Новый Массив);
	
	Письмо.Вставить("Вложения", СформироватьВложение(ТД, ИмяФайла));

	Письмо.Вставить("Тексты", Новый Массив);
	Письмо.Вставить("Важность", Перечисления.ВариантыВажностиВзаимодействия.Обычная);
	
	Письмо.Вставить("УведомитьОДоставке", НастройкиПользователя.УведомитьОДоставке);
	Письмо.Вставить("УведомитьОПрочтении", НастройкиПользователя.УведомитьОПрочтении);
	
	Письма.Добавить(Письмо);		
	
КонецПроцедуры	

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Функция СформироватьВложение(ТД, ИмяФайла)   Экспорт
	
	ИмяВременногоКаталога = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременногоКаталога);
	ПолноеИмяФайла = ФайловаяСистема.УникальноеИмяФайла(ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременногоКаталога) + ИмяФайла);
	ТД.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);     
	Вложение = Новый Структура("Данные, ИмяФайла, Идентификатор", Новый ДвоичныеДанные(ПолноеИмяФайла), ИмяФайла, Строка(Новый УникальныйИдентификатор));
	СписокВложений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);  
	УдалитьФайлы(ПолноеИмяФайла);
	Возврат  СписокВложений;

КонецФункции // СформироватьВложение()

// Редько Екатерина 14.03.2022 Выполнение задач №000040638
Процедура СформироватьПисьмаНаОтправку(ОбработкаАвтосверка)
	
	Если ОбработкаАвтосверка.НастройкиКомпоновки_ОТН.Количество()=0 Тогда
		ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
		"Не заполнены настройки компановки для раздела ОТН");
		Возврат;
	КонецЕсли;
	Если ОбработкаАвтосверка.НастройкиКомпоновки_ВРЧ.Количество()=0 Тогда
		ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
		"Не заполнены настройки компановки для раздела ВРЧ");      
		Возврат;
	КонецЕсли;
	Если ОбработкаАвтосверка.НастройкиКомпоновки_ЗТР.Количество()=0 Тогда
		ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
		"Не заполнены настройки компановки для раздела ЗТР");      
		Возврат;
	КонецЕсли;
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	Если ОбработкаАвтосверка.НастройкиКомпоновки_ДС.Количество()=0 Тогда
		ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
		"Не заполнены настройки компановки для раздела ДС");      
		Возврат;
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	Если ОбработкаАвтосверка.НастройкиКомпоновки_РСК.Количество()=0 Тогда
		ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
		"Не заполнены настройки компановки для раздела РСК");      
		Возврат;
	КонецЕсли;
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	НастройкиКомпановкиПользователиОТН = ПолучитьИзВременногоХранилища(ОбработкаАвтосверка.НастройкиКомпоновки_ОТН[0].АдресХранилищаНастроекКомпоновщика_Пользователь);
	НастройкиКомпановкиПользователиВРЧ = ПолучитьИзВременногоХранилища(ОбработкаАвтосверка.НастройкиКомпоновки_ВРЧ[0].АдресХранилищаНастроекКомпоновщика_Пользователь);
	НастройкиКомпановкиПользователиЗТР = ПолучитьИзВременногоХранилища(ОбработкаАвтосверка.НастройкиКомпоновки_ЗТР[0].АдресХранилищаНастроекКомпоновщика_Пользователь);
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	НастройкиКомпановкиПользователиДС  = ПолучитьИзВременногоХранилища(ОбработкаАвтосверка.НастройкиКомпоновки_ДС[0].АдресХранилищаНастроекКомпоновщика_Пользователь);
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	НастройкиКомпановкиПользователиРСК  = ПолучитьИзВременногоХранилища(ОбработкаАвтосверка.НастройкиКомпоновки_РСК[0].АдресХранилищаНастроекКомпоновщика_Пользователь);
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	
	ВыборкаАдресовОТН = ПолучитьПользователей(НастройкиКомпановкиПользователиОТН);
	ВыборкаАдресовВРЧ = ПолучитьПользователей(НастройкиКомпановкиПользователиВРЧ);
	ВыборкаАдресовЗТР = ПолучитьПользователей(НастройкиКомпановкиПользователиЗТР);
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	ВыборкаАдресовДС  = ПолучитьПользователей(НастройкиКомпановкиПользователиДС);
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	ВыборкаАдресовРСК  = ПолучитьПользователей(НастройкиКомпановкиПользователиРСК);
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	
	УчетнаяЗапись =  УправлениеЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	НастройкиПользователя = Взаимодействия.ПолучитьПараметрыРаботыПользователяДляИсходящегоЭлектронногоПисьма(УчетнаяЗапись, Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст, Истина);
	Письма = Новый Массив;
	
	Если ОбработкаАвтосверка.Активно_ОТН Тогда
		Если ВыборкаАдресовОТН = Неопределено Тогда
			ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не заполнены получатели для раздела ОТН");
		Иначе
			ДобавитьПисьмо(Письма, ВыборкаАдресовОТН, ОбработкаАвтосверка.РезультатТД_ОТН, "Результат автосверки ОТН.xls", НастройкиПользователя);
		КонецЕсли;
	КонецЕсли;   
	Если ОбработкаАвтосверка.Активно_ВРЧ Тогда
		Если ВыборкаАдресовВРЧ = Неопределено Тогда
			ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не заполнены получатели для раздела ВРЧ");
		Иначе
			ДобавитьПисьмо(Письма, ВыборкаАдресовВРЧ, ОбработкаАвтосверка.РезультатТД_ВРЧ, "Результат автосверки ВРЧ.xls", НастройкиПользователя);
		КонецЕсли;  
	КонецЕсли; 
	Если ОбработкаАвтосверка.Активно_ЗТР Тогда
		Если ВыборкаАдресовЗТР = Неопределено Тогда
			ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не заполнены получатели для раздела ЗТР");
		Иначе
			ДобавитьПисьмо(Письма, ВыборкаАдресовЗТР, ОбработкаАвтосверка.РезультатТД_ЗТР, "Результат автосверки ЗРЧ.xls", НастройкиПользователя);
		КонецЕсли;	 
	КонецЕсли;
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	Если ОбработкаАвтосверка.Активно_ДС Тогда
		Если ВыборкаАдресовДС = Неопределено Тогда
			ЗаписьЖурналаРегистрации("АвтосверкаПоКлючевымТочкам_ТН_РегламентныеЗадания", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не заполнены получатели для раздела ДС");
		Иначе
			ДобавитьПисьмо(Письма, ВыборкаАдресовДС, ОбработкаАвтосверка.РезультатТД_ДС, "Результат автосверки ДС.xls", НастройкиПользователя);
		КонецЕсли;	 
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
