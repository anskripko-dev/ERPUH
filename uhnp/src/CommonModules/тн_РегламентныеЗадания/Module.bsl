//
Процедура КонтрольТрафикаИсходящихСообщений() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = РегистрыСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.ТекстЗапросаКонтрольПревышениеЛимитаТрафика(Истина); 
	Запрос.УстановитьПараметр("ОтборУзелПланаОбмена", Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		// Превышений лимитов не обнаружено
		Возврат;		
	КонецЕсли;
	
	// Ищем активные фоновые задания по интеграциям с связанными полученными узлами по параметрами поиска ФЗ
	// Найденные фоновые задания завершаем
	
	УстановитьПривилегированныйРежим(Истина);
		
	СоответствиеПараметровПоискаАктивныхФоновыхЗаданий = РегистрыСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.СоответствиеПараметровПоискаАктивныхФоновыхЗаданий();
	ВыборкаТипУзлаПланаОбмена = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Пока ВыборкаТипУзлаПланаОбмена.Следующий() Цикл
		
		ПараметрыПоискаАктивныхФоновыхЗаданий = СоответствиеПараметровПоискаАктивныхФоновыхЗаданий.Получить(ВыборкаТипУзлаПланаОбмена.ТипУзлаПланаОбмена);
		Если ПараметрыПоискаАктивныхФоновыхЗаданий = Неопределено Тогда
			ЗаписьЖурналаРегистрации("Контроль трафика исходящий сообщений",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.РегламентныеЗадания.ТН_Интеграция_КонтрольТрафикаИсходящихСообщений, ,
				СтрШаблон("Для плана обмена %1 не заданы параметры поиска фоновых заданий", Строка(ВыборкаТипУзлаПланаОбмена.ТипУзлаПланаОбмена)));
			Продолжить;
		КонецЕсли;
		
		// Получить активные ФЗ по индивидуальному отбору каждого типа плана обмена
		
		Если ПараметрыПоискаАктивныхФоновыхЗаданий.РежимОтборРЗ Тогда 
			
			МассивАктивныхФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(ПараметрыПоискаАктивныхФоновыхЗаданий.ОтборыФоновыхЗаданий);
			Для Каждого АктивноеФоновоеЗадание Из МассивАктивныхФоновыхЗаданий Цикл
				ОтменаФоновогоЗаданияПриПревышениеЛимитаТрафикаИсходящихСообщений(АктивноеФоновоеЗадание, ПараметрыПоискаАктивныхФоновыхЗаданий, ВыборкаТипУзлаПланаОбмена);
			КонецЦикла;
			
			Если ПараметрыПоискаАктивныхФоновыхЗаданий.РежимШаблонногоПоиска Тогда
				// Может быть включено два режима поиска ФЗ, поэтому РежимОтборРЗ отключаем, очищаем у отбора ФЗ ключ РегламентноеЗадание, т.к. РежимОтборРЗ завершен
				ПараметрыПоискаАктивныхФоновыхЗаданий.РежимОтборРЗ = Ложь;
				ПараметрыПоискаАктивныхФоновыхЗаданий.ОтборыФоновыхЗаданий.Удалить("РегламентноеЗадание");
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПараметрыПоискаАктивныхФоновыхЗаданий.РежимШаблонногоПоиска Тогда
			
			МассивАктивныхФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(ПараметрыПоискаАктивныхФоновыхЗаданий.ОтборыФоновыхЗаданий);
			
			Если ПараметрыПоискаАктивныхФоновыхЗаданий.ПроверкаДетальныхЗаписей Тогда
			
				ВыборкаДетальныеЗаписи = ВыборкаТипУзлаПланаОбмена.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					Для Каждого АктивноеФоновоеЗадание Из МассивАктивныхФоновыхЗаданий Цикл
						ОтменаФоновогоЗаданияПриПревышениеЛимитаТрафикаИсходящихСообщений(АктивноеФоновоеЗадание, ПараметрыПоискаАктивныхФоновыхЗаданий, ВыборкаДетальныеЗаписи);					
					КонецЦикла;		
					
				КонецЦикла;
				
			Иначе
				
				Для Каждого АктивноеФоновоеЗадание Из МассивАктивныхФоновыхЗаданий Цикл
					ОтменаФоновогоЗаданияПриПревышениеЛимитаТрафикаИсходящихСообщений(АктивноеФоновоеЗадание, ПараметрыПоискаАктивныхФоновыхЗаданий, ВыборкаТипУзлаПланаОбмена);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;	
	
КонецПроцедуры

//Ведутенко С.А. 21.08.2025 Выполнение задач № 000054799
//
Процедура ОтменаФоновогоЗаданияПриПревышениеЛимитаТрафикаИсходящихСообщений(АктивноеФоновоеЗадание, ПараметрыПоискаАктивныхФоновыхЗаданий, ДанныеКонтроляТрафика) Экспорт
	
	ФоновоеЗаданиеКОтмене = Неопределено;
	
	Если ПараметрыПоискаАктивныхФоновыхЗаданий.РежимОтборРЗ Тогда
		ФоновоеЗаданиеКОтмене = АктивноеФоновоеЗадание;		
	ИначеЕсли ПараметрыПоискаАктивныхФоновыхЗаданий.РежимШаблонногоПоиска Тогда
		
		// Получить параметры поиска ФЗ
	    ЗначениеПроверяемогоСвойства = АктивноеФоновоеЗадание[ПараметрыПоискаАктивныхФоновыхЗаданий.ИмяСвойстваШаблонногоПоиска];
		СтрокаПоиска = ПараметрыПоискаАктивныхФоновыхЗаданий.ШаблонПоиска;
		
		// Дополнительные действия с шаблоном поиска 
		Если ПараметрыПоискаАктивныхФоновыхЗаданий.ПараметрыЗаменыШаблонаПоиска.Использовать Тогда
			ПодстрокаПоиска  = ПараметрыПоискаАктивныхФоновыхЗаданий.ПараметрыЗаменыШаблонаПоиска.ИмяЗаменяемойПодстроки;
			ИмяКолонкиДанных = ПараметрыПоискаАктивныхФоновыхЗаданий.ПараметрыЗаменыШаблонаПоиска.ИмяЗаменяемойПодстроки;
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ПодстрокаПоиска, ДанныеКонтроляТрафика[ИмяКолонкиДанных]);	
		КонецЕсли;
		
		// Поиск фонового задания по подстроке
		Если Не СтрНайти(ЗначениеПроверяемогоСвойства, СтрокаПоиска) = 0 Тогда
			ФоновоеЗаданиеКОтмене = АктивноеФоновоеЗадание;				
		КонецЕсли;	
		
	Иначе					
		Возврат;	
	КонецЕсли;
	
	Если Не ФоновоеЗаданиеКОтмене = Неопределено Тогда
		
		// Отменить найденное ФЗ
		ФоновоеЗаданиеКОтмене.Отменить();
		
		// Запись в ЖР
		ПредставлениеИнтеграции = ?(ПараметрыПоискаАктивныхФоновыхЗаданий.ПроверкаДетальныхЗаписей, ДанныеКонтроляТрафика.УзелПланаОбмена, ДанныеКонтроляТрафика.ТипУзлаПланаОбмена);
		МассивСообщений = РегистрыСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.МассивСообщенийПревышениеТрафика(ДанныеКонтроляТрафика, ПредставлениеИнтеграции);
		ЗаписьЖурналаРегистрации(СтрШаблон("Фоновое задание. Отмена. Ключ - %1, Наименование - %2", ФоновоеЗаданиеКОтмене.Ключ, ФоновоеЗаданиеКОтмене.Наименование),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегламентныеЗадания[ПараметрыПоискаАктивныхФоновыхЗаданий.ИмяРегламентногоЗадания], ,
			СтрСоединить(МассивСообщений, Символы.ПС));
		
	КонецЕсли;
					
КонецПроцедуры

