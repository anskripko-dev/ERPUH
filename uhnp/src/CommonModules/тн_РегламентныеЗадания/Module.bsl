//Ведутенко С.А. от 28.04.2023 Выполнение задач №000045214
//
Процедура АвтоматическийПоискИЗаменаЗначений() Экспорт
	
	РегистрыСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений.СброситьЗависшиеОшибки();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Настройки.ТипОбъекта КАК ТипОбъекта,
		|	Настройки.КоличествоОбъектовВВыборке КАК КоличествоОбъектовВВыборке,
		|	Настройки.ВыполнятьЗаменыБезТранзакции КАК ВыполнятьЗаменыБезТранзакции,
		|	Настройки.УдалятьФизическиЗамененныеЭлементы КАК УдалятьФизическиЗамененныеЭлементы,
		|	Настройки.УдалятьРегистрациюИзменений КАК УдалятьРегистрациюИзменений,
		|	Настройки.ОтветственныеЛица КАК ОтветственныеЛица
		|ИЗ                                                                                
		
		//НАЧАЛО Ведутенко С.А. 29.09.2023 Выполнение задач №000047019
		
		//|	РегистрСведений.тн_НастройкаАвтоматическогоПоискаИЗаменыЗначений КАК Настройки";
		
		|	РегистрСведений.тн_НастройкаАвтоматическогоПоискаИЗаменыЗначений КАК Настройки
		|ГДЕ
		|	НЕ Настройки.ТиповаяОбработкаЗамен";	
		
		//КОНЕЦ  Ведутенко С.А. 29.09.2023 Выполнение задач №000047019
	
	РезультатЗапроса = Запрос.Выполнить(); 	
	ВыборкаНастройки = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаНастройки.Следующий() Цикл
		
		ДатаНачалаОбработки = ТекущаяДатаСеанса();
		
		Обработка = Обработки.тн_ПоискИЗаменаЗначенийАвто.Создать();
		
		Обработка.ТипОбъекта							= ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВыборкаНастройки.ТипОбъекта).ПустаяСсылка();
		Обработка.ИспользоватьОтборПоТипу				= Истина;
		Обработка.ВыполнятьЗаменыБезТранзакции 			= ВыборкаНастройки.ВыполнятьЗаменыБезТранзакции;
		Обработка.УдалятьФизическиЗамененныеЭлементы 	= ВыборкаНастройки.УдалятьФизическиЗамененныеЭлементы;
		Обработка.УдалятьРегистрациюИзменений 			= ВыборкаНастройки.УдалятьРегистрациюИзменений;
		Обработка.КоличествоОбъектовВВыборке 			= ВыборкаНастройки.КоличествоОбъектовВВыборке;
		Обработка.НеОбрабатыватьОбъектыСОшибками		= Истина;
		
		Обработка.Заполнить();
		Обработка.НайтиСсылки();
		Обработка.ВыполнитьЗамену();
		
		ОтправитьПисьмоОтветственномуЗаАвтоматическийПоискИЗаменуЗначений(ВыборкаНастройки.ТипОбъекта, ВыборкаНастройки.ОтветственныеЛица, ДатаНачалаОбработки);
		
	КонецЦикла;
	 	
КонецПроцедуры // АвтоматическийПоискИЗаменаЗначений()

//Ведутенко С.А. от 28.04.2023 Выполнение задач №000045214
//
Процедура ОтправитьПисьмоОтветственномуЗаАвтоматическийПоискИЗаменуЗначений(ТипОбъекта, ОтветственныеЛица, ДатаНачалаОбработки)
	
	Если ПустаяСтрока(ОтветственныеЛица) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ошибки.ЧтоЗаменять КАК ЧтоЗаменять,
		|	Ошибки.НаЧтоЗаменять КАК НаЧтоЗаменять,
		|	Ошибки.Данные КАК Данные,
		|	Ошибки.ОписаниеОшибки КАК ОписаниеОшибки
		|ИЗ
		|	РегистрСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений КАК Ошибки
		|ГДЕ
		|	//УсловиеПоТипу
		|	И Ошибки.ДатаОшибки МЕЖДУ &ДатаНачалаОбработки И &ДатаОкончанияОбработки
		|
		|
		|ИТОГИ
		|	МИНИМУМ(НаЧтоЗаменять)
		|ПО
		|	ЧтоЗаменять";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоТипу", СтрШаблон("Ошибки.ЧтоЗаменять ССЫЛКА %1", ТипОбъекта));  		
	Запрос.УстановитьПараметр("ДатаНачалаОбработки", ДатаНачалаОбработки);	
	Запрос.УстановитьПараметр("ДатаОкончанияОбработки", ТекущаяДатаСеанса());	
	
	РезультатЗапроса = Запрос.Выполнить();	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	ВыборкаЧтоЗаменять = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТекстПисьма = "";
	Пока ВыборкаЧтоЗаменять.Следующий() Цикл
		
		ТекстПисьма = ТекстПисьма + "Что заменять: 	%1 <br>
								  |На что заменять: %2 <br>
					              |Ошибки: <br><br>";       					  
					  
		ТекстПисьма = СтрШаблон(ТекстПисьма, ВыборкаЧтоЗаменять.ЧтоЗаменять, ВыборкаЧтоЗаменять.НаЧтоЗаменять);
		
		ВыборкаОшибки = ВыборкаЧтоЗаменять.Выбрать();
		
		Пока ВыборкаОшибки.Следующий() Цикл
			
			ТекстПисьма = ТекстПисьма + " 
						|		Данные:	%1 <br>
						|			Описание ошибки: %2 <br><br>";
			
			ТекстПисьма = СтрШаблон(ТекстПисьма, ВыборкаОшибки.Данные, ВыборкаОшибки.ОписаниеОшибки); 		
			
		КонецЦикла;	
		
		ТекстПисьма = ТекстПисьма + "<br><br><br><br>";
		
	КонецЦикла;         
	
	//Параметры письма
	
	ПараметрыРассылки = Новый Структура;
	ПараметрыРассылки.Вставить("Важность", Перечисления.ВариантыВажностиВзаимодействия.Обычная);
	ПараметрыРассылки.Вставить("Автор", "Контроль замен");
	ПараметрыРассылки.Вставить("Тема", "Автоинформатор по ошибкам автоматического поиска и замены значений");
	ПараметрыРассылки.Вставить("ТекстПисьма",  ТекстПисьма);
	
	//Создание письма
	
	Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();   
	Письмо.Дата						= ТекущаяДатаСеанса();
	Письмо.Важность					= ПараметрыРассылки.Важность;
	Письмо.СтатусПисьма				= Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее;
	Письмо.Кодировка				= "utf-8";
	Письмо.УчетнаяЗапись			= УправлениеЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	Письмо.ОтправительПредставление = Строка(Письмо.УчетнаяЗапись);
	Письмо.Автор					= ПараметрыРассылки.Автор;
	Письмо.Ответственный			= Письмо.Автор;
	Письмо.Тема						= ПараметрыРассылки.Тема;
	Письмо.ТипТекста				= Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст;
	Письмо.ВзаимодействиеОснование	= Неопределено;
	Письмо.УдалятьПослеОтправки		= Ложь;
	Письмо.ЕстьВложения				= Ложь;
	Письмо.Текст 					= ПараметрыРассылки.ТекстПисьма;		
	
	//Получатели письма 
	
	МассивПолучателейЭлектроннаяПочта = СтрРазделить(СтрЗаменить(ОтветственныеЛица, " ", ""), ";");
	
	Для каждого АдресЭП Из МассивПолучателейЭлектроннаяПочта Цикл

		НоваяСтрока = Письмо["ПолучателиПисьма"].Добавить();
		НоваяСтрока.Адрес			= АдресЭП;
		НоваяСтрока.Представление	= АдресЭП;
		НоваяСтрока.Контакт			= АдресЭП;
		
	КонецЦикла;
	
	НастройкиПользователя = Взаимодействия.ПолучитьПараметрыРаботыПользователяДляИсходящегоЭлектронногоПисьма(Письмо.УчетнаяЗапись, Письмо.ТипТекста, Истина);
	ЗаполнитьЗначенияСвойств(Письмо, НастройкиПользователя);
	
	Письмо.СписокПолучателейПисьма	= ВзаимодействияКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(Письмо.ПолучателиПисьма, Ложь);
			
	Письмо.Записать();
		
КонецПроцедуры // ОтправитьПисьмоОтветственномуЗаАвтоматическийПоискИЗаменуЗначений()

