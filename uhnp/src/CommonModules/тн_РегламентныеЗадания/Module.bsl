		//НАЧАЛО Ведутенко С.А. 10.10.2023 Выполнение задач №000047109
				
		//СтруктураНастройкиЗамены.Вставить("КоличествоЗаменямыхОбъектовЗадания", ВыборкаНастройки.КоличествоЗаменямыхОбъектовЗадания);
		
		СтруктураНастройкиЗамены.Вставить("КоличествоЗаменяемыхОбъектовЗадания", ВыборкаНастройки.КоличествоЗаменяемыхОбъектовЗадания);
				
		//КОНЕЦ  Ведутенко С.А. 10.10.2023 Выполнение задач №000047109
		
		СтруктураНастройкиЗамены.Вставить("КоличествоФоновыхЗаданий", ВыборкаНастройки.КоличествоФоновыхЗаданий);
		СтруктураНастройкиЗамены.Вставить("УдалятьФизическиЗамененныеЭлементы", ВыборкаНастройки.УдалятьФизическиЗамененныеЭлементы);
		СтруктураНастройкиЗамены.Вставить("РеквизитыПоискаДублей", ВыборкаНастройки.РеквизитыПоискаДублей);
		
		ВыполнитьЗаменыТиповойОбработкой(СтруктураНастройкиЗамены);	
		
	КонецЦикла;
	
КонецПроцедуры    

//Ведутенко С.А. 29.09.2023 Выполнение задач № 000047019
//
Процедура ВыполнитьЗаменыТиповойОбработкой(СтруктураНастройкиЗамены)
	
	Если ПустаяСтрока(СтруктураНастройкиЗамены.ТипОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ %2
		|	тн_ЗаменяемыеОбъекты.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.тн_ЗаменяемыеОбъекты КАК тн_ЗаменяемыеОбъекты
		|ГДЕ
		|	тн_ЗаменяемыеОбъекты.Объект ССЫЛКА %1
		|	И Не тн_ЗаменяемыеОбъекты.Объект = тн_ЗаменяемыеОбъекты.ОбъектЦБ    
		
		//НАЧАЛО Ведутенко С.А. 10.10.2023 Выполнение задач №000047109
		
		//|	И Не тн_ЗаменяемыеОбъекты.ВРаботе", СтруктураНастройкиЗамены.ТипОбъекта, Формат(СтруктураНастройкиЗамены.КоличествоЗаменямыхОбъектовЗадания, "ЧГ=0"));
		
		|	И Не тн_ЗаменяемыеОбъекты.ВРаботе", СтруктураНастройкиЗамены.ТипОбъекта, Формат(СтруктураНастройкиЗамены.КоличествоЗаменяемыхОбъектовЗадания, "ЧГ=0"));
		
		//КОНЕЦ  Ведутенко С.А. 10.10.2023 Выполнение задач №000047109
	
	РезультатЗапроса = Запрос.Выполнить();        
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаЗаменяемыхОбъектов = РезультатЗапроса.Выбрать();
	
	ИтогоКоличествоЗаменяемыхОбъектов = 0;   
	ВсегоКоличествоЗаменяемыхОбъектов = ВыборкаЗаменяемыхОбъектов.Количество();   
   	КоличествоЗаменяемыхОбъектовВПотоке = ОбщегоНазначенияУТКлиентСервер.ОкрВверх(ВсегоКоличествоЗаменяемыхОбъектов / ?(СтруктураНастройкиЗамены.КоличествоФоновыхЗаданий = 0, 1, СтруктураНастройкиЗамены.КоличествоФоновыхЗаданий));      
		
	ТаблицаЗаменяемыхОбъектов = Новый ТаблицаЗначений;	
	
	Для Каждого КолонкаЗапроса Из РезультатЗапроса.Колонки Цикл
		
		ТаблицаЗаменяемыхОбъектов.Колонки.Добавить(КолонкаЗапроса.Имя);	
		
	КонецЦикла;
	
	Пока ВыборкаЗаменяемыхОбъектов.Следующий() Цикл     
		
		РегистрыСведений.тн_ЗаменяемыеОбъекты.УстановитьСнятьВРаботе(ВыборкаЗаменяемыхОбъектов.Объект, Истина);
		
		ИтогоКоличествоЗаменяемыхОбъектов = ИтогоКоличествоЗаменяемыхОбъектов + 1;
		
		ЗаполнитьЗначенияСвойств(ТаблицаЗаменяемыхОбъектов.Добавить(), ВыборкаЗаменяемыхОбъектов);	   
		
		Если ТаблицаЗаменяемыхОбъектов.Количество() = КоличествоЗаменяемыхОбъектовВПотоке 
			Или ИтогоКоличествоЗаменяемыхОбъектов = ВсегоКоличествоЗаменяемыхОбъектов Тогда	
			
			ЗапуститьОбработкуЗаменяемыхОбъектов_ВПотоках(ТаблицаЗаменяемыхОбъектов, СтруктураНастройкиЗамены);	
			
			ТаблицаЗаменяемыхОбъектов.Очистить();
			         
		КонецЕсли; 
				
	КонецЦикла;
	
КонецПроцедуры    

//Ведутенко С.А. 29.09.2023 Выполнение задач № 000047019
//
Процедура ЗапуститьОбработкуЗаменяемыхОбъектов_ВПотоках(ТаблицаЗаменяемыхОбъектов, СтруктураНастройкиЗамены)
	
	НаименованиеФоновогоЗадания = СтрШаблон("Обработка заменяемого объекта %1", СтруктураНастройкиЗамены.ТипОбъекта);
	ПроцедураФоновогоЗадания = "тн_РегламентныеЗадания.ОбработкаЗаменяемыхОбъектов_ВПотоках";
	
	ПараметрыФоновогоЗадания = Новый Массив; 
	ПараметрыФоновогоЗадания.Добавить(ТаблицаЗаменяемыхОбъектов);
	ПараметрыФоновогоЗадания.Добавить(СтруктураНастройкиЗамены);
	
	Попытка     
		
		ФоновыеЗадания.Выполнить(ПроцедураФоновогоЗадания, ПараметрыФоновогоЗадания, , НаименованиеФоновогоЗадания);
		
	Исключение  
		
		ЗаписьЖурналаРегистрации(СтрШаблон("Запуск фонового задания: %1", НаименованиеФоновогоЗадания)
							,УровеньЖурналаРегистрации.Ошибка
							,Метаданные.РегламентныеЗадания.тн_ЗаменаЗначенийТиповойОбработкой
							,
							,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
							
		Для Каждого СтрокаТаблицыЗаменяемыхОбъектов Из ТаблицаЗаменяемыхОбъектов Цикл	
			РегистрыСведений.тн_ЗаменяемыеОбъекты.УстановитьСнятьВРаботе(СтрокаТаблицыЗаменяемыхОбъектов.Объект, Ложь);				
		КонецЦикла;
		
	КонецПопытки;   	
			
КонецПроцедуры

//Ведутенко С.А. 29.09.2023 Выполнение задач № 000047019
//
Процедура ОбработкаЗаменяемыхОбъектов_ВПотоках(ТаблицаЗаменяемыхОбъектов, СтруктураНастройкиЗамены) Экспорт
	
	МассивТипаОбъекта = СтрРазделить(СтруктураНастройкиЗамены.ТипОбъекта, "."); 
	
	Если МассивТипаОбъекта.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъектаКонсолидации = МассивТипаОбъекта[0];
	ИмяОбъектаМетаданных = МассивТипаОбъекта[1];       
	
	ТаблицаРеквизитовДляПоиска = Новый ТаблицаЗначений;
	ТаблицаРеквизитовДляПоиска.Колонки.Добавить("Отображать");
	ТаблицаРеквизитовДляПоиска.Колонки.Добавить("СпособПоиска");
	ТаблицаРеквизитовДляПоиска.Колонки.Добавить("ИмяРеквизита");
	ТаблицаРеквизитовДляПоиска.Колонки.Добавить("СписокНастройки");
	
	Если Не ПустаяСтрока(СтруктураНастройкиЗамены.РеквизитыПоискаДублей) Тогда
		
		МассивРеквизитовПоиска = СтрРазделить(СтруктураНастройкиЗамены.РеквизитыПоискаДублей, ";");
		
		Для Каждого ЭлементМассива Из МассивРеквизитовПоиска Цикл
			
			СтрокаТаблицыРеквизитовДляПоиска = ТаблицаРеквизитовДляПоиска.Добавить();	
			СтрокаТаблицыРеквизитовДляПоиска.Отображать = Истина;
			СтрокаТаблицыРеквизитовДляПоиска.СпособПоиска = "Значение";
			СтрокаТаблицыРеквизитовДляПоиска.ИмяРеквизита = СокрЛП(ЭлементМассива);
			
		КонецЦикла;
		
	КонецЕсли;
		
	Для Каждого СтрокаТаблицыЗаменяемыхОбъектов Из ТаблицаЗаменяемыхОбъектов Цикл
		
		Попытка 
		
			ОбработкаОбъект = Обработки.ПоискИСлияниеДублирующихсяЭлементов.Создать();
			
