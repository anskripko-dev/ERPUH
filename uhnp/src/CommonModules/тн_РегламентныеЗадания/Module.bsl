	СрокХраненения = Константы.тн_СрокХраненияДанныеАвтосверкаПоКлючевымПолям.Получить(); 
	Если ЗначениеЗаполнено(СрокХраненения) Тогда
		
		//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
		//ДатаОтправкиЗапроса = КонецДня(тн_Интеграция_УПП.ТекущаяДатаСервера() - 86400*СрокХраненения); 
		ДатаОтправкиЗапроса = КонецДня(ТекущаяДатаСервера() - 86400*СрокХраненения);
		//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
		
		Запрос 			    = Новый Запрос;
		
		Запрос.УстановитьПараметр("ДатаОтправкиЗапроса", ДатаОтправкиЗапроса); 
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ДанныеАвтосверкаПоКлючевымПолям.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
		|	тн_ДанныеАвтосверкаПоКлючевымПолям.ПоДокументам КАК ПоДокументам
		|ИЗ
		|	РегистрСведений.тн_ДанныеАвтосверкаПоКлючевымПолям КАК тн_ДанныеАвтосверкаПоКлючевымПолям
		|ГДЕ
		|	тн_ДанныеАвтосверкаПоКлючевымПолям.ДатаОтправкиЗапроса < &ДатаОтправкиЗапроса";
		
		Выборка = Запрос.Выполнить().Выбрать();	
		Пока Выборка.Следующий() Цикл
			МенеджерЗаписи = РегистрыСведений.тн_ДанныеАвтосверкаПоКлючевымПолям.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
			МенеджерЗаписи.ПоДокументам = Выборка.ПоДокументам;
			МенеджерЗаписи.Удалить();			
		КонецЦикла;
	КонецЕсли;
	
