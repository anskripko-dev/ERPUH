Процедура ЗагрузитьЗачетыВзаиморасчетыСПортала() Экспорт
	
	МассивОбработок = Новый Массив;
	МассивОбработок.Добавить("тн_ЗагрузкаЗачетовКЦСПортала");
	МассивОбработок.Добавить("тн_ЗагрузкаВыгрузкаВзаиморасчетовСПортала");	
	
	ТекущаяДата = тн_Интеграция_УПП.ТекущаяДатаСервера();

	ПериодЗагрузки = Новый СтандартныйПериод();
	ПериодЗагрузки.ДатаНачала = ДобавитьМесяц(НачалоМесяца(ТекущаяДата), -1);
	ПериодЗагрузки.ДатаОкончания = ТекущаяДата;
	
	Для каждого ИмяОбработки Из МассивОбработок Цикл
				
		Результат = Обработки[ИмяОбработки].ЗагрузитьДанныеСПорталаНаСервере(Новый УникальныйИдентификатор, ПериодЗагрузки, Истина);   
		
		Если Результат.Статус = "Ошибка" Тогда    
			
			ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, ,
				Результат.КраткоеПредставлениеОшибки); 
			
		ИначеЕсли Результат.Статус = "Выполнено" Тогда
			СтруктураРезультат = ПолучитьИзВременногоХранилища(Результат.АдресРезультата); 
			
			Если СтруктураРезультат.ЕстьОшибки Тогда  
				
				ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, ,
					СтруктураРезультат.ТекстОшибки); 
				
			Иначе	
				
				ОбъектОбработка = Обработки[ИмяОбработки].Создать();
				Зачеты = ОбъектОбработка.Зачеты.Выгрузить();  				
				
				Обработки[ИмяОбработки].ЗаполнитьЗачеты(СтруктураРезультат, Зачеты, ПериодЗагрузки);   
				Зачеты.ЗаполнитьЗначения(Истина, "Пометка");  
				
				Обработки[ИмяОбработки].ПроверитьЗаполнениеРеквизитов(Зачеты); 
				Обработки[ИмяОбработки].СоздатьДокументы(Зачеты, Истина); 
				
			КонецЕсли;                 
			
		КонецЕсли; 
		
	КонецЦикла;
			
КонецПроцедуры

