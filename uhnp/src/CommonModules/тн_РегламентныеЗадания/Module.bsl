								ЭлементОбъект.Удалить();					
									
							КонецЦикла;				
						
							ЗафиксироватьТранзакцию();	
						
						Исключение            
							
							ОтменитьТранзакцию();                              
							
							//НАЧАЛО Ведутенко С.А. 10.10.2023 Выполнение задач №000047109
							
							//ЗаписьЖурналаРегистрации(СтрШаблон("Удаление заменяемых объектов: Заменямый объект %1", СтруктураНастройкиЗамены.ТипОбъекта)
							
							ЗаписьЖурналаРегистрации(СтрШаблон("Удаление заменяемых объектов: Заменяемый объект %1", СтруктураНастройкиЗамены.ТипОбъекта)
														
							//КОНЕЦ  Ведутенко С.А. 10.10.2023 Выполнение задач №000047109
							
									,УровеньЖурналаРегистрации.Ошибка
									,
									,
									,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
							
						КонецПопытки;

					КонецЕсли; 
					
				КонецЕсли; 
				
