	КонецПопытки;
	
	Возврат Результат;

КонецФункции // ПолучитьЭлементыКОотправке()

Процедура ЗаписатьДатуОтправкиСообщения(СообщениеСсылка)
	ОбъектСсылка = СообщениеСсылка.ПолучитьОбъект();
	ОбъектСсылка.ДатаВремяОтправки = ОчередьСообщенийВызовСервера.ТекущаяДатаНаСервере();
	ОбъектСсылка.Записать();
КонецПроцедуры	

Функция ЗначениеРеквизитаСсылки(Ссылка, КолонкаЗначения)
	
	Значение = Неопределено;
	
	ИмяМетаданного = Ссылка.Метаданные().ПолноеИмя();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ т." + КолонкаЗначения + " Как Значение
		| ИЗ " + ИмяМетаданного + " Как т 
		| ГДЕ т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);	
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Значение = Выборка.Значение;
	КонецЕсли;
		
	Возврат Значение;
	
КонецФункции

