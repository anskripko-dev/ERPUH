// Тулинов Владимир 18.02.2026 Выполнение задач №000056806
Процедура ИзменитьДанныеПопытокИсходящегоСообщения(ОбъектСообщения)
	
	Если ОбъектСообщения.КоличествоПопыток > 0 Тогда
		
		ОбъектСообщения.КоличествоПопыток = ОбъектСообщения.КоличествоПопыток - 1;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектСообщения.ДатаВремяОтправки)
		И ОбъектСообщения.КоличествоПопытокДоставки > 0 Тогда
		
		ОбъектСообщения.КоличествоПопытокДоставки = ОбъектСообщения.КоличествоПопытокДоставки - 1;
		
		Если ОбъектСообщения.КоличествоПопытокДоставки > 0
			И ОбъектСообщения.КоличествоПопыток = 0 Тогда
			
			ОбъектСообщения.КоличествоПопыток		  = 1;
			ОбъектСообщения.ИнтервалПовторнойОтправки = 1;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Тулинов Владимир 18.02.2026 Выполнение задач №000056806
Функция ОтправлятьСообщение(ОбъектСообщения, ТекущаяДатаНаСервере)
	
	ОтправлятьСообщение = Истина;
	
	Если ЗначениеЗаполнено(ОбъектСообщения.ДатаВремяОтправки) Тогда
		
		Если ОбъектСообщения.Доставлено
			Или ОбъектСообщения.КоличествоПопытокДоставки = 0
			Или ОбъектСообщения.ДатаВремяПопыткиОтправки + ОбъектСообщения.ИнтервалПовторнойДоставки >= ТекущаяДатаНаСервере Тогда
			
			ОтправлятьСообщение = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(ОбъектСообщения.ДатаВремяПопыткиОтправки)
			И (ОбъектСообщения.Доставлено
			Или ОбъектСообщения.КоличествоПопыток = 0
			Или ОбъектСообщения.ДатаВремяПопыткиОтправки + ОбъектСообщения.ИнтервалПовторнойОтправки >= ТекущаяДатаНаСервере) Тогда
			
			ОтправлятьСообщение = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОтправлятьСообщение;
	
КонецФункции
