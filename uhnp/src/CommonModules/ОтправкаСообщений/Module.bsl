Процедура ВыполнитьОтправкуСообщений_ВПотоках(ТаблицаДанныхДляФЗ, КлючФоновогоЗадания)
	
	Отбор = Новый Структура("Ключ, Состояние", КлючФоновогоЗадания, СостояниеФоновогоЗадания.Активно);
	СписокАктивныхФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	
	Если СписокАктивныхФоновыхЗаданий.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;		
				
	ПараметрыФЗ = Новый Массив;
	ПараметрыФЗ.Добавить(ТаблицаДанныхДляФЗ);
	
	Попытка
		ФоновыеЗадания.Выполнить("ОтправкаСообщений.ВыполнитьОтправкуСообщений", ПараметрыФЗ, КлючФоновогоЗадания, КлючФоновогоЗадания);
	Исключение
		ЗаписьЖурналаРегистрации("ОтправкаСообщений.ВыполнитьОтправкуСообщений", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка запуска фонового задания по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки; 
	
КонецПроцедуры

