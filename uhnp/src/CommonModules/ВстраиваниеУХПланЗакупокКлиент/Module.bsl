
#Область СлужебныйПрограммныйИнтерфейс
	
Процедура ОбработкаКоманды(Форма, Команда) Экспорт  
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Если Команда.Имя = "СкопироватьПоСтроке" Тогда  
		Если Объект.КроссТаблица Тогда  
			
			ТаблицаПериодов = Форма.Периоды;
			ТекущиеДанные = Элементы.ТоварыПоПериодам.ТекущиеДанные;   
			ПрефиксЭлемента = "ТоварыПоПериодамПериодыТаблицы";
			
			ИмяЭлемента = СтрЗаменить(Элементы.ТоварыПоПериодам.ТекущийЭлемент.Имя, ПрефиксЭлемента, "");
			
			Если СтрНайти(ИмяЭлемента, "Количество") Тогда
				Префикс = "Количество";
			ИначеЕсли СтрНайти(ИмяЭлемента, "Сумма") Тогда
				Префикс = "Сумма"; 
			ИначеЕсли СтрНайти(ИмяЭлемента, "Цена") Тогда
				Префикс = "Цена";
			Иначе       
				ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru = 'Ошибка определения поля для установки'"));
				Возврат;
			КонецЕсли;  
			
			ИмяКолонки 	= СтрЗаменить(ИмяЭлемента, Префикс+"_", "");  
			Количество 	= ТекущиеДанные["Количество_"+ИмяКолонки];
			Сумма 		= ТекущиеДанные["Сумма_"+ИмяКолонки];
			Цена 		= ТекущиеДанные["Цена_"+ИмяКолонки];
			
			ДанныеПериодов = ТаблицаПериодов.НайтиСтроки(Новый Структура("ИмяКолонки", ИмяКолонки));
			Если ДанныеПериодов.Количество()=0 Тогда 
				ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru = 'Ошибка определения выбранного периода'"));
				Возврат;      
			Иначе
				ДанныеПериода = ДанныеПериодов[0];   
			КонецЕсли;      
			
			Для Каждого ПараметрыПериода Из ТаблицаПериодов Цикл
				Если ПараметрыПериода.ДатаНачала > ДанныеПериода.ДатаНачала Тогда 
					Если Префикс = "Цена" Тогда
						ТекущиеДанные["Цена_"+ПараметрыПериода.ИмяКолонки] = Цена;  
						ТекущиеДанные["Сумма_"+ПараметрыПериода.ИмяКолонки] = ТекущиеДанные["Цена_"+ПараметрыПериода.ИмяКолонки]*ТекущиеДанные["Количество_"+ПараметрыПериода.ИмяКолонки];
					ИначеЕсли Префикс = "Сумма" Тогда   
						ТекущиеДанные["Сумма_"+ПараметрыПериода.ИмяКолонки] = Сумма;
						Если ТекущиеДанные["Цена_"+ПараметрыПериода.ИмяКолонки] = 0 Тогда    
							ТекущиеДанные["Количество_"+ПараметрыПериода.ИмяКолонки] = 0;	
						Иначе
							ТекущиеДанные["Количество_"+ПараметрыПериода.ИмяКолонки] = Сумма/ТекущиеДанные["Цена_"+ПараметрыПериода.ИмяКолонки]; 
						КонецЕсли; 
					Иначе
						ТекущиеДанные["Количество_"+ПараметрыПериода.ИмяКолонки] = Количество;
						ТекущиеДанные["Сумма_"+ПараметрыПериода.ИмяКолонки] = ТекущиеДанные["Цена_"+ПараметрыПериода.ИмяКолонки]*ТекущиеДанные["Количество_"+ПараметрыПериода.ИмяКолонки];	
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Форма.ПодключитьОбработчикОжидания("Подключаемый_ПересчитатьСтроку", 0.1, Истина);
		
КонецПроцедуры

Процедура СкрытьПанельСогласования(Знач Элементы) Экспорт
	
	Перем ФормаСогласованиеУХ, Элемент;
	
	ФормаСогласованиеУХ = Элементы.Найти("ФормаСогласованиеУХ");
	Если ФормаСогласованиеУХ <> Неопределено Тогда                        
		Для Каждого Элемент Из ФормаСогласованиеУХ.ПодчиненныеЭлементы Цикл   
			Элемент.Видимость = Ложь;    
		КонецЦикла;
	КонецЕсли;    
	ФормаСогласованиеУХ.Видимость = Ложь;

КонецПроцедуры

