// Белоконенко Денис 20.12.2025 Выполнение задач №000056202
Процедура ВыбратьФайлСверкиУПП(ФормаОтчета, Команда) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ФормаОтчета", ФормаОтчета);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтотОбъект, ДополнительныеПараметры);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);	
	
КонецПроцедуры        

// Белоконенко Денис 20.12.2025 Выполнение задач №000056202
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	ФормаОтчета = ДополнительныеПараметры.ФормаОтчета;
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу); 
		АдресХранилищаФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ФормаОтчета.УникальныйИдентификатор);
		
		ХранилищеФайла = тн_ОбщегоНазначенияВызовСервера.ПолучитьХранилищеФайлаДанных(АдресХранилищаФайла);
		
		Настройки = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки;
		
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(Настройки, "ФайлДанных", ХранилищеФайла);
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(Настройки, "ПутьКФайлу", ПутьКФайлу);
		
	КонецЕсли;                                      
	
КонецПроцедуры 

