Процедура ИзменитьРеквизитыБезПерепроведения(Объект, Форма) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для изменения реквизитов необходимо записать документ!");
		Возврат;
	КонецЕсли;
	
	//НАЧАЛО Качикина 07.10.2024 Выполнение задач №000051011
	ТипСсылкиОбъекта	= ТипЗнч(Объект.Ссылка); 
	ПараметрыОткрытия	= Новый Структура; 
	Контрагент 			= ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	ПропуститьОбщийКод	= Ложь;   
	СписокРеквизитовДляЗаписи = Новый СписокЗначений; 
	
	Если ТипСсылкиОбъекта = Тип("ДокументСсылка.РеализацияТоваровУслуг") 
			Или ТипСсылкиОбъекта = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов")
			Или ТипСсылкиОбъекта = Тип("ДокументСсылка.КорректировкаРеализации")
			Или ТипСсылкиОбъекта = Тип("ДокументСсылка.ОтчетПереработчика")
			Или ТипСсылкиОбъекта = Тип("ДокументСсылка.ПрочиеДоходыРасходы") Тогда 		
		ПропуститьОбщийКод = Истина;	
	КонецЕсли;
	
	Если НЕ ПропуститьОбщийКод Тогда
	//КОНЕЦ Качикина 07.10.2024 Выполнение задач №000051011
	
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.Бронирование")  Тогда
		Контрагент =  Объект.КонтрагентАгент;
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ВзаимозачетЗадолженности") Тогда
		Контрагент =  Объект.КонтрагентДебитор;
	Иначе
		Контрагент  =  Объект.Контрагент;
	КонецЕсли;		
	
	//НАЧАЛО Качикина 07.10.2024 Выполнение задач №000051011
	//ПараметрыОткрытия = Новый Структура;  
	//КОНЕЦ Качикина 07.10.2024 Выполнение задач №000051011
	// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
	//НАЧАЛО Качикина 31.01.2025 Выполнение задач №000052309
	//// НАЧАЛО Николаев Павел 08.11.2024 Выполнение задач №000051555
	////Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.СверкаВзаиморасчетов") Тогда
	//Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.СверкаВзаиморасчетов2_4") Тогда
	//// КОНЕЦ Николаев Павел 08.11.2024 Выполнение задач №000051555 
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.СверкаВзаиморасчетов2_4")
		Или ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.СверкаВзаиморасчетов2_5_11") Тогда
	//КОНЕЦ Качикина 31.01.2025 Выполнение задач №000052309
		ПараметрыОткрытия.Вставить("тн_СканПолучен", Объект.тн_СканПолучен); 
		ПараметрыОткрытия.Вставить("тн_ОригиналПолучен", Объект.тн_ОригиналПолучен);   
		ПараметрыОткрытия.Вставить("Статус", Объект.Статус); 
	Иначе	
	// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
		ПараметрыОткрытия.Вставить("тн_ОтветственныйСотрудник", ?(ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств"),Объект.тн_ОтветственныйЗаПлатеж, Объект.тн_ОтветственныйСотрудник));
		ПараметрыОткрытия.Вставить("тн_ОсновнойДокументОплаты", Объект.тн_ОсновнойДокументОплаты); 
	// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
	КонецЕсли; 
	// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415  
	
	//НАЧАЛО Качикина 07.10.2024 Выполнение задач №000051011 
	КонецЕсли;
	//КОНЕЦ Качикина 07.10.2024 Выполнение задач №000051011
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 28.05.2024 Выполнение задач №000049669  
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов") Тогда   
		ПараметрыОткрытия.Вставить("Комментарий", Объект.Комментарий); 
	КонецЕсли; 
	// КОНЕЦ Юдина (Гутарова) Екатерина 28.05.2024 Выполнение задач №000049669
	
	//НАЧАЛО Качикина 07.10.2024 Выполнение задач №000051011   	
	Если ТипСсылкиОбъекта = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.ВозвратТоваровПоставщику")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.КорректировкаПриобретения")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.КорректировкаРеализации")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.ОтчетПереработчика") Тогда 	
		
		СписокРеквизитовДляЗаписи.Добавить("тн_УпрУчетНДС");
	КонецЕсли;      
	
	Если ТипСсылкиОбъекта = Тип("ДокументСсылка.ПрочиеДоходыРасходы")
		Или ТипСсылкиОбъекта = Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов") Тогда
        СписокРеквизитовДляЗаписи.Добавить("тн_ЗарегистрироватьВОбмен");
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("СписокРеквизитовДляЗаписи", СписокРеквизитовДляЗаписи);
	ПараметрыОткрытия.Вставить("тн_ПропуститьОбщийКод", ПропуститьОбщийКод);
	//КОНЕЦ Качикина 07.10.2024 Выполнение задач №000051011
	
	ПараметрыОткрытия.Вставить("Контрагент", Контрагент);
	ПараметрыОткрытия.Вставить("Организация", Объект.Организация);
	ПараметрыОткрытия.Вставить("Документ", Объект.Ссылка);  
	
	ОткрытьФорму("ОбщаяФорма.тн_ФормаИзмененияРеквизитовБезПроведения", ПараметрыОткрытия, Форма, Истина);

КонецПроцедуры 

