// 3.0.1.61/КОРР Устанавливается признак использования для аналитик Контрагент и Договор
Процедура ДобавитьВКлючевыеАналитикиКонтрагентИДоговор() экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидыОперативныхПлановНастройкаАналитик.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыОперативныхПланов.НастройкаАналитик КАК ВидыОперативныхПлановНастройкаАналитик
	|ГДЕ
	|	(ВидыОперативныхПлановНастройкаАналитик.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыОперативныхПланов.БюджетДДС)
	|			ИЛИ ВидыОперативныхПлановНастройкаАналитик.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыОперативныхПланов.БюджетБДР))
	|	И (ВидыОперативныхПлановНастройкаАналитик.Аналитика = ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Контрагент)
	|			ИЛИ ВидыОперативныхПлановНастройкаАналитик.Аналитика = ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.ДоговорКонтрагента))
	|	И ВидыОперативныхПлановНастройкаАналитик.Использование <> ЗНАЧЕНИЕ(Перечисление.ИспользованиеАналитик.КлючеваяАналитика)";
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
		
			Спр = Выборка.Ссылка.ПолучитьОбъект();
			
			Для каждого Стр Из Спр.НастройкаАналитик Цикл
				
				Если Стр.Аналитика = Справочники.АналитикиОперативногоПланирования.Контрагент
					ИЛИ Стр.Аналитика = Справочники.АналитикиОперативногоПланирования.ДоговорКонтрагента Тогда
				
					Стр.Использование = Перечисления.ИспользованиеАналитик.КлючеваяАналитика;
				
				КонецЕсли; 
			
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Спр);
		
		КонецЦикла; 
	КонецЕсли;
	
	// Документы
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОперативныйПланНастройкаАналитик.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперативныйПлан.НастройкаАналитик КАК ОперативныйПланНастройкаАналитик
	|ГДЕ
	|	(ОперативныйПланНастройкаАналитик.Ссылка.ВидОперативногоПлана = ЗНАЧЕНИЕ(Справочник.ВидыОперативныхПланов.БюджетДДС)
	|			ИЛИ ОперативныйПланНастройкаАналитик.Ссылка.ВидОперативногоПлана = ЗНАЧЕНИЕ(Справочник.ВидыОперативныхПланов.БюджетБДР))
	|	И (ОперативныйПланНастройкаАналитик.Аналитика = ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Контрагент)
	|			ИЛИ ОперативныйПланНастройкаАналитик.Аналитика = ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.ДоговорКонтрагента))
	|	И ОперативныйПланНастройкаАналитик.Использование <> ЗНАЧЕНИЕ(Перечисление.ИспользованиеАналитик.КлючеваяАналитика)";
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
		
			Док = Выборка.Ссылка.ПолучитьОбъект();
			
			Для каждого Стр Из Док.НастройкаАналитик Цикл
				
				Если Стр.Аналитика = Справочники.АналитикиОперативногоПланирования.Контрагент
					ИЛИ Стр.Аналитика = Справочники.АналитикиОперативногоПланирования.ДоговорКонтрагента Тогда
				
					Стр.Использование = Перечисления.ИспользованиеАналитик.КлючеваяАналитика;
				
				КонецЕсли; 
			
			КонецЦикла;
			
			Док.ОбменДанными.Загрузка = Истина;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Док,,,РежимЗаписиДокумента.Запись);
		
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

// 3.0.1.70/КОРР удаляет аналитику ДокПланирования из настроек видов опер.планов и документов Оперативный план.
Процедура УдалитьАналитикуДокументПланирования() экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидыОперативныхПлановНастройкаАналитик.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыОперативныхПланов.НастройкаАналитик КАК ВидыОперативныхПлановНастройкаАналитик
	|ГДЕ
	|	ВидыОперативныхПлановНастройкаАналитик.Аналитика = ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.ДокументПланирования)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОперативныйПланНастройкаАналитик.Ссылка
	|ИЗ
	|	Документ.ОперативныйПлан.НастройкаАналитик КАК ОперативныйПланНастройкаАналитик
	|ГДЕ
	|	ОперативныйПланНастройкаАналитик.Аналитика = ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.ДокументПланирования)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	АналитикаКУдалению = Справочники.АналитикиОперативногоПланирования.ДокументПланирования;
	
	//
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Поз = 0;
		Пока Поз< Объект.НастройкаАналитик.Количество() Цикл
			
			Строка = Объект.НастройкаАналитик[Поз];
			Если Строка.Аналитика = АналитикаКУдалению Тогда
				Объект.НастройкаАналитик.Удалить(Строка);
			Иначе
				Поз = Поз + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	
	КонецЦикла; 
	
КонецПроцедуры

// 3.1.0.27/ПЕРВ устанавливает аналитикам оперативного планирования связь с пвх.ВидыСубконтоКорпоративные
Процедура ЗаполнитьТипДанныхАналитикиОП() Экспорт
	
	//
	Спр = Справочники.АналитикиОперативногоПланирования.Аналитика1.ПолучитьОбъект();
	Спр.ТипДанных = ПолучитьВидСубконтоПоАналитике(Справочники.АналитикиОперативногоПланирования.Аналитика1);
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Спр);
	
	//
	Спр = Справочники.АналитикиОперативногоПланирования.Аналитика2.ПолучитьОбъект();
	Спр.ТипДанных = ПолучитьВидСубконтоПоАналитике(Справочники.АналитикиОперативногоПланирования.Аналитика2);
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Спр);
	
	//
	Спр = Справочники.АналитикиОперативногоПланирования.Аналитика3.ПолучитьОбъект();
	Спр.ТипДанных = ПолучитьВидСубконтоПоАналитике(Справочники.АналитикиОперативногоПланирования.Аналитика3);
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Спр);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикиОперативногоПланирования.Ссылка КАК Аналитика,
	|	АналитикиОперативногоПланирования.ТипДанных КАК ТипДанных
	|ИЗ
	|	Справочник.АналитикиОперативногоПланирования КАК АналитикиОперативногоПланирования
	|ГДЕ
	|	АналитикиОперативногоПланирования.Предопределенный = ИСТИНА
	|	И АналитикиОперативногоПланирования.ТипДанных = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|	И АналитикиОперативногоПланирования.Ссылка <> ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика1)
	|	И АналитикиОперативногоПланирования.Ссылка <> ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика2)
	|	И АналитикиОперативногоПланирования.Ссылка <> ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика3)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	//
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ВидСубконто = ПолучитьВидСубконтоПоАналитике(Выборка.Аналитика);
		Если НЕ ЗначениеЗаполнено(ВидСубконто) Тогда
			Продолжить;
		КонецЕсли;
		
		//
		Спр = Выборка.Аналитика.ПолучитьОбъект();
		Спр.ТипДанных = ВидСубконто;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Спр);
		
	КонецЦикла;
	
КонецПроцедуры

// 3.1.0.27/ПЕРВ Заполняет признак возможности лимитирования по аналитике
