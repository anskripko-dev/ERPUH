// 3.1.0.27/ПЕРВ Выполняет первоначальное заполнение РегистрСведений.СтруктураОперативногоПланирования
Процедура ЗаполнитьСтруктуруОперативногоПланированияПоУмолчанию() Экспорт
	
	Аналитики = Справочники.АналитикиОперативногоПланирования;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
	|	ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств) КАК Предназначение
	|ПОМЕСТИТЬ ВТ_ВидыБюджетов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов),
	|	ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВидыБюджетов.ВидБюджета КАК ВидБюджета,
	|	ВТ_ВидыБюджетов.Предназначение КАК Предназначение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтруктураОперативногоПланирования.Аналитика) КАК КолвоАналитик
	|ИЗ
	|	ВТ_ВидыБюджетов КАК ВТ_ВидыБюджетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураОперативногоПланирования КАК СтруктураОперативногоПланирования
	|		ПО ВТ_ВидыБюджетов.ВидБюджета = СтруктураОперативногоПланирования.ВидБюджета
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ВидыБюджетов.ВидБюджета,
	|	ВТ_ВидыБюджетов.Предназначение";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КолвоАналитик > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		//
		НЗ = РегистрыСведений.СтруктураОперативногоПланирования.СоздатьНаборЗаписей();
		
		Отбор = НЗ.Отбор.Предназначение;
		Отбор.ВидСравнения = ВидСравнения.Равно;
		Отбор.Значение = Выборка.Предназначение;
		Отбор.Использование = Истина;
		
		НЗ.Прочитать();
		НЗ.Очистить();
		
		// Заполняем структуру бюджета
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.ВидБюджета,			Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Период,				Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Валюта,				Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.ЦФО, 					Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Проект, 				Ложь,	Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.СтатьяБюджета,		Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Аналитика1,			Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Аналитика2, 			Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Аналитика3, 			Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Аналитика4, 			Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Аналитика5, 			Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Аналитика6, 			Истина, Истина);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.Контрагент,			Ложь,	Ложь);
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.ДоговорКонтрагента,	Ложь,	Ложь);
		
		ДобавитьВСтруктуруАналитику(НЗ,	Аналитики.ПриходРасход,		Истина,	Ложь);
		
		Для Каждого Строка Из НЗ Цикл
			Строка.ВидБюджета = Выборка.ВидБюджета;
			Строка.Предназначение = Выборка.Предназначение;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ, Истина);
			
	КонецЦикла;
	
КонецПроцедуры

// 3.1.0.111/КОРР. расширяет аналитики статей  до 6-ти в оперативном планировании
Процедура ОбновитьОперативноеПланированиеДо6Аналитик() Экспорт
	
	ИнициализироватьАналитики456ОперПланирования();
	ОбновитьСтруктуруОперативногоПланированияДо6АналитикСтатьи();
	ДобавитьАналитики456СтатьиВОперативныеПланы();
	
КонецПроцедуры

#КонецОбласти

