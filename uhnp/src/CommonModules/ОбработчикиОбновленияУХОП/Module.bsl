#Область УстановкаСвязиАналитикиСПВХКорп

Функция ПолучитьВидСубконтоПоАналитике(Аналитика)
	
	Аналитики = Справочники.АналитикиОперативногоПланирования;
	ПВХКорп = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные;
	
	Если Аналитика = Аналитики.Аналитика1 Тогда
		Возврат ПВХКорп.ПустаяСсылка();
	ИначеЕсли Аналитика = Аналитики.Аналитика2 Тогда
		Возврат ПВХКорп.ПустаяСсылка();
	ИначеЕсли Аналитика = Аналитики.Аналитика3 Тогда
		Возврат ПВХКорп.ПустаяСсылка();
	ИначеЕсли Аналитика = Аналитики.Валюта Тогда
		Возврат ПВХКорп.СправочникВалюты;
	ИначеЕсли Аналитика = Аналитики.ВидБюджета Тогда
		
		ОТ = Новый ОписаниеТипов("ПеречислениеСсылка.ПредназначенияЭлементовСтруктурыОтчета");
		ВидСубконто = ПВХКорп.ПолучитьПоОписаниюТипов(ОТ);
		Если ВидСубконто = неопределено Тогда
			ВидСубконто = СоздатьПВХКорпПоОписаниюТипов(ОТ, НСтр("ru = 'Виды бюджетов'"));
		КонецЕсли;
		
		Возврат ВидСубконто;
	ИначеЕсли Аналитика = Аналитики.ДоговорКонтрагента Тогда
		Возврат ПВХКорп.СправочникДоговораКонтрагентов;
	ИначеЕсли Аналитика = Аналитики.ДокументПланирования Тогда
		
		ОТ = Новый ОписаниеТипов("ДокументСсылка.ОперативныйПлан");
		ВидСубконто = ПВХКорп.ПолучитьПоОписаниюТипов(ОТ);
		Если ВидСубконто = неопределено Тогда
			ВидСубконто = СоздатьПВХКорпПоОписаниюТипов(ОТ, НСтр("ru = 'Документы планирования'"));
		КонецЕсли;
		
		Возврат ВидСубконто;
	ИначеЕсли Аналитика = Аналитики.Контрагент Тогда
		
		ОТ = Новый ОписаниеТипов("СправочникСсылка.Контрагенты,СправочникСсылка.ФизическиеЛица");
		ВидСубконто = ПВХКорп.ПолучитьПоОписаниюТипов(ОТ);
		Если ВидСубконто = неопределено Тогда
			ВидСубконто = СоздатьПВХКорпПоОписаниюТипов(ОТ, НСтр("ru = 'Контрагенты и Физ.лица'"));
		КонецЕсли;
		
		Возврат ВидСубконто;
	ИначеЕсли Аналитика = Аналитики.Менеджер Тогда
		
		ОТ = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
		ВидСубконто = ПВХКорп.ПолучитьПоОписаниюТипов(ОТ);
		Если ВидСубконто = неопределено Тогда
			ВидСубконто = СоздатьПВХКорпПоОписаниюТипов(ОТ, НСтр("ru = 'Физические лица'"));
		КонецЕсли;
		
		Возврат ВидСубконто;
	ИначеЕсли Аналитика = Аналитики.МестоПоставки Тогда
		Возврат ПВХКорп.МестаПоставки;
	ИначеЕсли Аналитика = Аналитики.ПриходРасход Тогда
		Возврат ПВХКорп.ПриходРасход;
	ИначеЕсли Аналитика = Аналитики.Номенклатура Тогда
		Возврат ПВХКорп.НоменклатураТоварныеГруппы;
	ИначеЕсли Аналитика = Аналитики.Организация Тогда
		Возврат ПВХКорп.ОрганизационныеЕдиницы;
	ИначеЕсли Аналитика = Аналитики.Период Тогда
		Возврат ПВХКорп.ПериодыОтчетов;
	ИначеЕсли Аналитика = Аналитики.Приоритет Тогда
		
		ОТ = Новый ОписаниеТипов("СправочникСсылка.ПриоритетыПотребностей");
		ВидСубконто = ПВХКорп.ПолучитьПоОписаниюТипов(ОТ);
		Если ВидСубконто = неопределено Тогда
			ВидСубконто = СоздатьПВХКорпПоОписаниюТипов(ОТ, НСтр("ru = 'Приоритеты потребностей'"));
		КонецЕсли;
		
		Возврат ВидСубконто;
	ИначеЕсли Аналитика = Аналитики.Проект Тогда
		Возврат ПВХКорп.Проекты;
	ИначеЕсли Аналитика = Аналитики.СтатьяБюджета Тогда
		Возврат ПВХКорп.СтатьиБюджетов;
	ИначеЕсли Аналитика = Аналитики.ЦФО Тогда
		Возврат ПВХКорп.СправочникЦФО;
	Иначе
		Возврат неопределено;
	КонецЕсли;
	
КонецФункции

Функция СоздатьПВХКорпПоОписаниюТипов(ОТ, Имя)
	
	Объект = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СоздатьЭлемент();
	Объект.ТипЗначения = ОТ;
	Объект.Наименование = Имя;
	Объект.УстановитьНовыйКод("УХ");
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	
	Возврат Объект.Ссылка;
	
КонецФункции

#КонецОбласти 

#Область ЗаполнитьСтруктуруОперативногоПланированияПоУмолчанию
	
Процедура ДобавитьВСтруктуруАналитику(НаборЗаписей, Аналитика, ОбязательноеЗаполнение, КонтрольЛимитов)
	
	Запись = НаборЗаписей.Добавить();
	Запись.Аналитика = Аналитика;
	Запись.ОбязательноеЗаполнение = ОбязательноеЗаполнение;
	Запись.КонтрольЛимитов = КонтрольЛимитов;
	
КонецПроцедуры

#КонецОбласти 

#Область РасширениеКоличестваНалитикСтатьиБюджетаДо6
	
Процедура ИнициализироватьАналитики456ОперПланирования()
	
	// Справочник.АналитикиОперативногоПланирования
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикиОперативногоПланирования.Ссылка КАК Ссылка,
	|	АналитикиОперативногоПланирования.ВозможноЛимитирование КАК ВозможноЛимитирование
	|ИЗ
	|	Справочник.АналитикиОперативногоПланирования КАК АналитикиОперативногоПланирования
	|ГДЕ
	|	АналитикиОперативногоПланирования.ВозможноЛимитирование = ЛОЖЬ
	|	И АналитикиОперативногоПланирования.Ссылка В (ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика4), ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика5), ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика6))";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	КонецЦикла;
	
КонецПроцедуры	

Процедура ОбновитьСтруктуруОперативногоПланированияДо6АналитикСтатьи()
	
	// Обновить рс.СтруктураОперативногоПланирования
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыБюджетов.Ссылка КАК ВидБюджета
	|ПОМЕСТИТЬ ВТ_ВсеБюджеты
	|ИЗ
	|	ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|ГДЕ
	|	ВидыБюджетов.Предопределенный = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика1) КАК Аналитика
	|ПОМЕСТИТЬ ВТ_ВсеАналитики
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика2)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика3)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика4)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика5)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика6)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеБюджеты.ВидБюджета КАК ВидБюджета,
	|	ВТ_ВсеАналитики.Аналитика КАК Аналитика
	|ПОМЕСТИТЬ ВТ_ВсеБюджетыАналитики
	|ИЗ
	|	ВТ_ВсеБюджеты КАК ВТ_ВсеБюджеты,
	|	ВТ_ВсеАналитики КАК ВТ_ВсеАналитики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеБюджетыАналитики.ВидБюджета КАК ВидБюджета,
	|	ВТ_ВсеБюджетыАналитики.ВидБюджета.Предназначение КАК Предназначение,
	|	ВТ_ВсеБюджетыАналитики.Аналитика КАК Аналитика,
	|	ИСТИНА КАК ОбязательноеЗаполнение,
	|	ИСТИНА КАК КонтрольЛимитов
	|ИЗ
	|	ВТ_ВсеБюджетыАналитики КАК ВТ_ВсеБюджетыАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураОперативногоПланирования КАК СтруктураОперативногоПланирования
	|		ПО ВТ_ВсеБюджетыАналитики.ВидБюджета.Предназначение = СтруктураОперативногоПланирования.Предназначение
	|			И ВТ_ВсеБюджетыАналитики.Аналитика = СтруктураОперативногоПланирования.Аналитика
	|ГДЕ
	|	СтруктураОперативногоПланирования.Аналитика ЕСТЬ NULL
	|ИТОГИ ПО
	|	ВидБюджета";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаВидБюджета = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидБюджета.Следующий() Цикл
		
		нз = РегистрыСведений.СтруктураОперативногоПланирования.СоздатьНаборЗаписей();
		Отбор = НЗ.Отбор.Предназначение;
		Отбор.ВидСравнения = ВидСравнения.Равно;
		Отбор.Значение = ВыборкаВидБюджета.Предназначение;
		
		нз.Прочитать();
		
		Выборка = ВыборкаВидБюджета.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(нз.Добавить(), Выборка);
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ);
		
	КонецЦикла;
	
КонецПроцедуры

