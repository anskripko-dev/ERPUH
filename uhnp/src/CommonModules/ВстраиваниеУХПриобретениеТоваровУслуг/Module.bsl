Процедура ОбработкаЗаполнения(Объект, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда		
		ЭтапыГрафикаОплаты = Объект.ЗаказПоставщику.ЭтапыГрафикаОплаты.Выгрузить();		
		Объект.ЭтапыГрафикаОплаты.Загрузить(ЭтапыГрафикаОплаты);	
	КонецЕсли;	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
			И ДанныеЗаполнения.Свойство("ДокументОснование")
			И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("Массив") 
			И ДанныеЗаполнения.ДокументОснование.Количество() = 1
			И ТипЗнч(ДанныеЗаполнения.ДокументОснование[0]) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			
			ЗаполнитьЗначенияСвойств(Объект,ДанныеЗаполнения.ДокументОснование[0],"РежимИспользованияГрафика,СпособОпределенияКурсаПлатежа,СпособОпределенияКурсаПлатежа,ДатаФиксацииКурсаПлатежа,СдвигДатыФиксацииКурсаПлатежа,КурсПлатежаНеБолее,КурсПлатежаНеМенее,КурсПлатежаНеМенееВВалютеОплаты,КурсПлатежаНеБолееВВалютеОплаты");

	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтранаПроисхождения(Объект, Отказ) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ВестиУчетПоСтранамКорпоративныеЗакупки")
		//ИЛИ НЕ Объект.Организация.ЗакупкаПоФЗ223 
		Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаУсловия Из Объект.Товары Цикл 
		Если ЗначениеЗаполнено(СтрокаУсловия.Номенклатура) И 
			СтрокаУсловия.Номенклатура.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга")
			И Не ЗНачениеЗаполнено(СтрокаУсловия.СтранаПроизводителя)  Тогда
			ТекстСообщения = НСтр("ru='Не заполнена страна производителя '");
			ТекстСообщения = ТекстСообщения + "по номенклатуре: " + Строка(СтрокаУсловия.Номенклатура) + ",";		
			ТекстСообщения = Лев(ТекстСообщения,СтрДлина(ТекстСообщения)-1);
			КлючДанных = ОбщегоНазначенияУХ.КлючДанныхДляСообщенияПользователю(Объект.Ссылка);
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			КлючДанных,
			,
			,
			Отказ);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

