			НовоеЗначение=НайденныеСтроки[0].Представление;
			
		КонецЕсли;   
		
		Если (ЗначениеЗаполнено(ЗначениеСтар) ИЛИ ЗначениеЗаполнено(НовоеЗначение))
			И НЕ ЗначениеСтар=НовоеЗначение Тогда
			
			НоваяСтрока=ТаблицаЭлементов.Добавить();
			НоваяСтрока.Элемент=ЭлементСтар;
			НоваяСтрока.Заголовок=Заголовок;
			НоваяСтрока.НовоеЗначение=НовоеЗначение;
			НоваяСтрока.ПутьКДанным="New_"+СтрокаИнформация.ИмяРеквизита;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(РеквизитыКДобавлению);
	
	ТекстСравнения=?(ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта,Нстр("ru = ' (новый)'"),Нстр("ru = ' (эталон)'"));
	УправлениеФормойНСИСервер.ОтобразитьИзменениеЭлементов(Форма,ТаблицаЭлементов,ТекстСравнения); 
	
	Если НЕ Форма.Элементы.Найти("ГруппаЮрАдресДопДействия")=Неопределено Тогда
		
		Форма.Элементы.ГруппаЮрАдресДопДействия.Видимость=Ложь;
		
	КонецЕсли;
	
КонецПроцедуры   

Процедура ДобавитьСвязаннуюЗаявкуКонтрагентПартнера(ТекЗаявка,АдресДанныхОбъекта) Экспорт
	
	ДанныеВызова=ПолучитьИзВременногоХранилища(АдресДанныхОбъекта);
	
	Ссылка=ДанныеВызова.Ссылка;
	Объект=ДанныеВызова.Объект;
	КонтрагентПартнера=ДанныеВызова.КонтрагентПартнера;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект
	|ИЗ
	|	Документ.ЗаявкаНаИзменениеНСИ.ЗаявкиНаИзменениеСвязанныхОбъектов КАК ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов
	|ГДЕ
	|	ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект.ИзменяемыйОбъект = &КонтрагентПартнера
	|	И ЗаявкаНаИзменениеНСИЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка = &ТекЗаявка";
	
	Запрос.УстановитьПараметр("ТекЗаявка",ТекЗаявка);
	Запрос.УстановитьПараметр("КонтрагентПартнера",КонтрагентПартнера);
	
	Результат=Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЗаявкаКонтрагентПартнера=УправлениеФормойНСИСервер.СуществуетРабочаяЗаявка(КонтрагентПартнера);
	
	Если ЗаявкаКонтрагентПартнера=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЗаявкаОбъект=ТекЗаявка.ПолучитьОбъект();
	НоваяСтрока=ЗаявкаОбъект.ЗаявкиНаИзменениеСвязанныхОбъектов.Добавить();
	НоваяСтрока.ЗаявкаНаСвязанныйОбъект=ЗаявкаКонтрагентПартнера;
	ЗаявкаОбъект.ОбменДанными.Загрузка=Истина;
	ЗаявкаОбъект.Записать();
		
КонецПроцедуры // ДобавитьСвязаннуюЗаявкуКонтрагентПартнера()

Функция ПолучитьЗаявкуСвязанныйОбъект(СвязанныйОбъект) Экспорт
		
	ЗаявкаСвязанныйОбъект=УправлениеФормойНСИСервер.СуществуетРабочаяЗаявка(СвязанныйОбъект);
	
	Если ЗаявкаСвязанныйОбъект=Неопределено Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Возврат ЗаявкаСвязанныйОбъект;
		
	КонецЕсли;
	
КонецФункции // ПолучитьЗаявкуКонтрагентПартнера() 

