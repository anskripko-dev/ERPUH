
Функция ПолучитьАдресИзмененийКонтрагента(Партнер,ЗаявкаНаИзменениеНСИ)

	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект
	             |ИЗ
	             |	Документ.ЗаявкаНаИзменениеНСИ.ЗаявкиНаИзменениеСвязанныхОбъектов КАК ЗаявкиНаИзменениеСвязанныхОбъектов
	             |ГДЕ
	             |	ЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка = &ЗаявкаНаИзменениеНСИ
	             |	И ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект.ИзменяемыйОбъект ССЫЛКА Справочник.Контрагенты
	             |	И ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект.ИзменяемыйОбъект.Партнер = &Партнер
	             |	И ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта)";
	
	Запрос.УстановитьПараметр("ЗаявкаНаИзменениеНСИ",ЗаявкаНаИзменениеНСИ);
	Запрос.УстановитьПараметр("Партнер",Партнер);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ДокументОбъект=Результат.ЗаявкаНаСвязанныйОбъект.ПолучитьОбъект();
		
		СтруктураИзменений=Новый Структура;
		СтруктураИзменений.Вставить("ИзменениеРеквизитов",ДокументОбъект.ИзменениеРеквизитов.Выгрузить());
		СтруктураИзменений.Вставить("ИзменениеТЧ",ДокументОбъект.ИзменениеТЧ.Выгрузить());
		СтруктураИзменений.Вставить("ИмяОбъекта",ДокументОбъект.ИзменяемыйОбъект.Метаданные().Имя); 
		СтруктураИзменений.Вставить("ВидОперации",ДокументОбъект.ВидОперации);
		
		Возврат ПоместитьВоВременноеХранилище(СтруктураИзменений);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ПолучитьАдресИзмененийКонтрагента()

Функция ПолучитьАдресИзмененийПартнера(Партнер,ЗаявкаНаИзменениеНСИ)
		
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект
	             |ИЗ
	             |	Документ.ЗаявкаНаИзменениеНСИ.ЗаявкиНаИзменениеСвязанныхОбъектов КАК ЗаявкиНаИзменениеСвязанныхОбъектов
	             |ГДЕ
	             |	ЗаявкиНаИзменениеСвязанныхОбъектов.Ссылка = &ЗаявкаНаИзменениеНСИ
	             |	И ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект.ИзменяемыйОбъект ССЫЛКА Справочник.Партнеры
	             |	И ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект.ИзменяемыйОбъект = &Партнер
	             |	И ЗаявкиНаИзменениеСвязанныхОбъектов.ЗаявкаНаСвязанныйОбъект.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта)";
	
	Запрос.УстановитьПараметр("ЗаявкаНаИзменениеНСИ",ЗаявкаНаИзменениеНСИ);
	Запрос.УстановитьПараметр("Партнер",Партнер);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ДокументОбъект=Результат.ЗаявкаНаСвязанныйОбъект.ПолучитьОбъект();
		
		СтруктураИзменений=Новый Структура;
		СтруктураИзменений.Вставить("ИзменениеРеквизитов",ДокументОбъект.ИзменениеРеквизитов.Выгрузить());
		СтруктураИзменений.Вставить("ИзменениеТЧ",ДокументОбъект.ИзменениеТЧ.Выгрузить());
		СтруктураИзменений.Вставить("ИмяОбъекта",ДокументОбъект.ИзменяемыйОбъект.Метаданные().Имя); 
		СтруктураИзменений.Вставить("ВидОперации",ДокументОбъект.ВидОперации);
		
		Возврат ПоместитьВоВременноеХранилище(СтруктураИзменений);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ПолучитьАдресИзмененийКонтрагента()

Процедура ПриСозданииНаСервереНСИ_КонтрагентПартнер(Форма,Параметры) Экспорт
		
	Если Параметры.Свойство("АдресХранилищаИзменений") Тогда
		
		ДанныеИзменения=ПолучитьИзВременногоХранилища(Параметры.АдресХранилищаИзменений); 
		
		Если ДанныеИзменения.ИмяОбъекта="Партнеры" Тогда 
			
			ОтобразитьИзмененияОбъекта_Партнер(Форма,Параметры.АдресХранилищаИзменений);
			
			АдресИзмененийКонтрагент=ПолучитьАдресИзмененийКонтрагента(Параметры.Ключ,Параметры.ЗаявкаНаИзменениеНСИ);
			
			Если НЕ АдресИзмененийКонтрагент=Неопределено Тогда
				
				ОтобразитьИзмененияОбъекта_Контрагент(Форма,АдресИзмененийКонтрагент); 
				
			КонецЕсли;
					
		Иначе
			
			ОтобразитьИзмененияОбъекта_Контрагент(Форма,Параметры.АдресХранилищаИзменений);
			
			АдресИзмененийПартнер=ПолучитьАдресИзмененийПартнера(Параметры.Ключ,Параметры.ЗаявкаНаИзменениеНСИ);
			
			Если НЕ АдресИзмененийПартнер=Неопределено Тогда
				
				ОтобразитьИзмененияОбъекта_Партнер(Форма,АдресИзмененийПартнер); 
				
			КонецЕсли;
	
		КонецЕсли;
		
	Иначе
					
		ДобавитьЭлементыУправленияНСИ_КонтрагентПартнер(Форма);		
		
	КонецЕсли;
		
КонецПроцедуры // ПриСозданииНаСервереНСИ()

Процедура ДобавитьЭлементыУправленияНСИ_КонтрагентПартнер(Форма) Экспорт
	
	ОбъектКонтрагент=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Форма.КонтрагентПартнера,"НСИ_НеАктивный");
	ОбъектКонтрагент.Вставить("Ссылка",Форма.КонтрагентПартнера);
	ОбъектСсылкаКонтрагент=Форма.КонтрагентПартнера; 
	
	ОбъектПартнер=Форма.Объект;
	ОбъектСсылкаПартнер=Форма.Объект.Ссылка;
	
	СтруктураКонтроляКонтрагент=УправлениеФормойНСИСервер.ДанныеКонтроляНСИ(ОбъектСсылкаКонтрагент);
	СтруктураКонтроляПартнер=УправлениеФормойНСИСервер.ДанныеКонтроляНСИ(ОбъектСсылкаПартнер);
		
	Если НЕ (СтруктураКонтроляКонтрагент.КонтролироватьНСИ ИЛИ СтруктураКонтроляПартнер.КонтролироватьНСИ) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОтображатьЗаголовки=Не (СтруктураКонтроляПартнер.ВыборНеАктивных ИЛИ СтруктураКонтроляКонтрагент.ВыборНеАктивных);
	
	НарисоватьЭлементыУправленияНСИ_Партнер(Форма,СтруктураКонтроляПартнер,ОбъектПартнер,ОбъектСсылкаПартнер,ОтображатьЗаголовки);		
	НарисоватьЭлементыУправленияНСИ_Контрагент(Форма,СтруктураКонтроляКонтрагент,ОбъектКонтрагент,ОбъектСсылкаКонтрагент,ОтображатьЗаголовки);
	
	Если СтруктураКонтроляПартнер.ВыборНеАктивных Тогда
		
		Если НЕ Форма.Элементы.Найти("ЦНСИ_ВвестиЗаявкуНаРегистрацию_Контрагент")=Неопределено Тогда
			
			Форма.Элементы.ЦНСИ_ВвестиЗаявкуНаРегистрацию_Контрагент.Видимость=Ложь;
			
		ИначеЕсли НЕ Форма.Элементы.Найти("ЦНСИ_ВвестиЗаявкуНаИзменение_Контрагент")=Неопределено Тогда
			
			Форма.Элементы.ЦНСИ_ВвестиЗаявкуНаИзменение_Контрагент.Видимость=Ложь; 
			
		КонецЕсли;
			
	ИначеЕсли СтруктураКонтроляКонтрагент.ВыборНеАктивных Тогда
		
		Если НЕ Форма.Элементы.Найти("ЦНСИ_ВвестиЗаявкуНаРегистрацию_Партнер")=Неопределено Тогда
			
			Форма.Элементы.ЦНСИ_ВвестиЗаявкуНаРегистрацию_Партнер.Видимость=Ложь;
			
		ИначеЕсли НЕ Форма.Элементы.Найти("ЦНСИ_ВвестиЗаявкуНаИзменение_Партнер")=Неопределено Тогда
			
			Форма.Элементы.ЦНСИ_ВвестиЗаявкуНаИзменение_Партнер.Видимость=Ложь; 
			
		КонецЕсли;
		
	КонецЕсли;
				
КонецПроцедуры // ДобавитьЭлементыУправленияНСИ_КонтрагентПартнер()

Процедура НарисоватьЭлементыУправленияНСИ_Партнер(Форма,СтруктураКонтроляПартнер,ОбъектПартнер,ОбъектСсылкаПартнер,ОтображатьЗаголовки)
	
	Если НЕ СтруктураКонтроляПартнер.СуществующийОбъект Тогда
		
		Если СтруктураКонтроляПартнер.ТребуетсяСогласование Тогда
			
			Если НЕ УправлениеФормойНСИСервер.ВозможноИзменениеОбъекта(СтруктураКонтроляПартнер) Тогда
				
				Возврат;
				
			КонецЕсли;
								
			ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Партнер",
								НСтр("ru = 'Ввести заявку на регистрацию партнера'"),
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Подключаемый_Партнер",
								"Утвердить",,?(ОтображатьЗаголовки,НСтр("ru = 'Партнер'"),""));
			
		КонецЕсли;
		
	Иначе
		
		Если СтруктураКонтроляПартнер.ТребуетсяСогласование Тогда
			
			Если ОбъектПартнер.НСИ_НеАктивный Тогда
				
				Заявка = УправлениеФормойНСИСервер.СуществуетРабочаяЗаявка(ОбъектСсылкаПартнер,Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта);
				
				Если Заявка=Неопределено Тогда
										
					ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Партнер",
								НСтр("ru = 'Ввести заявку на регистрацию партнера'"),
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Подключаемый_Партнер",
								"Утвердить",,?(ОтображатьЗаголовки,НСтр("ru = 'Партнер'"),""));
					
				Иначе
					
					
					ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ПоказатьАктивнуюЗаявку_Партнер",
								НСтр("ru = 'Показать заявку на регистрацию партнера'"),
								"ЦНСИ_ПоказатьАктивнуюЗаявку_Подключаемый_Партнер",
								"Утвердить",,?(ОтображатьЗаголовки,НСтр("ru = 'Партнер'"),""));
					
				КонецЕсли;
							
				Форма.Заголовок=Форма.Заголовок+" ("+НСтр("ru = ' Партнер не активный'")+")";		
							
			Иначе
				
				Если НЕ УправлениеФормойНСИСервер.ВозможноИзменениеОбъекта(СтруктураКонтроляПартнер) Тогда
					
					УправлениеФормойНСИСервер.ДобавитьДекорациюЗапретИзменений(Форма,СтруктураКонтроляПартнер);
					Форма.ТолькоПросмотр=Истина;
					Возврат;
					
				КонецЕсли;
				
				ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ВвестиЗаявкуНаИзменение_Партнер",
								НСтр("ru = 'Ввести заявку на изменение партнера'"),
								"ЦНСИ_ВвестиЗаявкуНаИзменение_Подключаемый_Партнер",
								"ПодсистемаСправочникиИНастройкиУчета",,?(ОтображатьЗаголовки,НСтр("ru = 'Партнер'"),""));
								
			КонецЕсли;
							
		КонецЕсли;
		
		НарисоватьПанельУправленияЦНСИКонтрагентПартнер(Форма,ОбъектПартнер.НСИ_НеАктивный,СтруктураКонтроляПартнер.ТребуетсяСогласование,"Партнер",НСтр("ru = 'Партнер'"));
						
	КонецЕсли;
		
КонецПроцедуры // НарисоватьЭлементыУправленияНСИ_Партнер()

Процедура НарисоватьЭлементыУправленияНСИ_Контрагент(Форма,СтруктураКонтроляКонтрагент,ОбъектКонтрагент,ОбъектСсылкаКонтрагент,ОтображатьЗаголовки)
	
