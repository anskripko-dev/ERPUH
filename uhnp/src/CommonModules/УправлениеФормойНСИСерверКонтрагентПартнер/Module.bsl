				Возврат;
				
			КонецЕсли;
								
			ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Контрагент",
								НСтр("ru = 'Ввести заявку на регистрацию контрагента'"),
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Подключаемый_Контрагент",
								"Утвердить",,?(ОтображатьЗаголовки,НСтр("ru = 'Контрагент'"),""));
			
