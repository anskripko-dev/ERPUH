				Заявка = УправлениеФормойНСИСервер.СуществуетРабочаяЗаявка(ОбъектСсылкаКонтрагент,Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта);
				
				Если Заявка=Неопределено Тогда
										
					ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Контрагент",
								НСтр("ru = 'Ввести заявку на регистрацию контрагента'"),
								"ЦНСИ_ВвестиЗаявкуНаРегистрацию_Подключаемый_Контрагент",
								"Утвердить",,?(ОтображатьЗаголовки,НСтр("ru = 'Контрагент'"),""));
					
				Иначе
					
					
					ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ПоказатьАктивнуюЗаявку_Контрагент",
								НСтр("ru = 'Показать заявку на регистрацию контрагента'"),
								"ЦНСИ_ПоказатьАктивнуюЗаявку_Подключаемый_Контрагент",
								"Утвердить",,?(ОтображатьЗаголовки,НСтр("ru = 'Контрагент'"),""));
					
				КонецЕсли;
							
				Форма.Заголовок=Форма.Заголовок+" ("+НСтр("ru = ' Контрагент не активный'")+")";		
							
			Иначе
				
				Если НЕ УправлениеФормойНСИСервер.ВозможноИзменениеОбъекта(СтруктураКонтроляКонтрагент) Тогда
					
					УправлениеФормойНСИСервер.ДобавитьДекорациюЗапретИзменений(Форма,СтруктураКонтроляКонтрагент);
					Форма.ТолькоПросмотр=Истина;
					Возврат;
					
				КонецЕсли;
				
				ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,
								"ЦНСИ_ВвестиЗаявкуНаИзменение_Контрагент",
								НСтр("ru = 'Ввести заявку на изменение контрагента'"),
								"ЦНСИ_ВвестиЗаявкуНаИзменение_Подключаемый_Контрагент",
								"ПодсистемаСправочникиИНастройкиУчета",,?(ОтображатьЗаголовки,НСтр("ru = 'Контрагент'"),""));
								
			КонецЕсли;
			
		КонецЕсли;
		
		НарисоватьПанельУправленияЦНСИКонтрагентПартнер(Форма,ОбъектКонтрагент.НСИ_НеАктивный,СтруктураКонтроляКонтрагент.ТребуетсяСогласование,"Контрагент",НСтр("ru = 'Контрагент'"));
				
	КонецЕсли;
	
	
КонецПроцедуры // НарисоватьЭлементыУправленияНСИ_Контрагент()



Процедура ДобавитьКомандуФормыЦНСИКонтрагентПартнер(Форма,ИмяКоманды,ЗаголовокКоманды,Обработчик, НаименованиеКартинки = "",ГруппаРодитель=Неопределено,ЗаголовокКнопки="")
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	
	Если НаименованиеКартинки <> "" Тогда
		НоваяКоманда.Картинка = БиблиотекаКартинок[НаименованиеКартинки];
	КонецЕсли;	  
	
	НоваяКоманда.Заголовок 	= ЗаголовокКоманды;
	НоваяКоманда.Подсказка 	= ЗаголовокКоманды;
	НоваяКоманда.Действие	= Обработчик;
	
	ДобавитьЭлементФормыЦНСИКонтрагентПартнер(Форма,ИмяКоманды,ГруппаРодитель,ЗаголовокКнопки);

КонецПроцедуры		// ДобавитьКомандуФормы()

Процедура ДобавитьЭлементФормыЦНСИКонтрагентПартнер(Форма,ИмяКоманды,ГруппаРодитель,Заголовок)
	
	Если ГруппаРодитель=Неопределено Тогда 
		
		АдресДобавления=УправлениеФормойНСИСервер.ОпределитьАдресДобавления(Форма);
		
	Иначе
		
		АдресДобавления=ГруппаРодитель;
		
	КонецЕсли;
	
	Если АдресДобавления.ПодчиненныеЭлементы.Количество()>0 Тогда
		
		ЭлементПодменюНСИ = Форма.Элементы.Вставить(ИмяКоманды, Тип("КнопкаФормы"),АдресДобавления, АдресДобавления.ПодчиненныеЭлементы[0]); 
		
	Иначе
		
		ЭлементПодменюНСИ = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"),АдресДобавления);
		
	КонецЕсли;
		
	ЭлементПодменюНСИ.ИмяКоманды = ИмяКоманды;
	
	Если Не ПустаяСтрока(Заголовок) Тогда	
		
		ЭлементПодменюНСИ.Заголовок=Заголовок;
		ЭлементПодменюНСИ.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
	Иначе
		
		ЭлементПодменюНСИ.Отображение = ОтображениеКнопки.Картинка;
		
	КонецЕсли;
	
	ЭлементПодменюНСИ.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
	ЭлементПодменюНСИ.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
		
КонецПроцедуры // ДобавитьКомандуЦНСИ()

Процедура НарисоватьПанельУправленияЦНСИКонтрагентПартнер(Форма,НСИ_НеАктивный,ТребуетсяСогласование,ИмяОбъекта,Подзаголовок) Экспорт
	
	ЭлементПодменюНСИ=Форма.Элементы.Найти("НСИ_ПодменюУправлениеНСИ_"+ИмяОбъекта);
	
	Если ЭлементПодменюНСИ=Неопределено Тогда
		
		АдресДобавления=УправлениеФормойНСИСервер.ОпределитьАдресДобавления(Форма);
				
		ЭлементПодменюНСИ = Форма.Элементы.Добавить("НСИ_ПодменюУправлениеНСИ_"+ИмяОбъекта, Тип("ГруппаФормы"), АдресДобавления); // ГруппаФормы
		ЭлементПодменюНСИ.Заголовок = НСтр("ru='Управление ЦНСИ'")+" ("+Подзаголовок+")";
		ЭлементПодменюНСИ.Вид       = ВидГруппыФормы.Подменю;
		ЭлементПодменюНСИ.Картинка  = БиблиотекаКартинок.ПодобратьТовары;
		
	КонецЕсли;
		
	Если ТребуетсяСогласование Тогда
		
		Если НЕ НСИ_НеАктивный Тогда
						
			УправлениеФормойНСИСервер.ДобавитьКомандуФормыЦНСИ(Форма,
								"ЦНСИ_ВвестиЗаявкуНаУдаление_"+ИмяОбъекта,
								НСтр("ru = 'Ввести заявку на удаление элемента'"),
								"ЦНСИ_ВвестиЗаявкуНаУдаление_Подключаемый_"+ИмяОбъекта,
								"ПользовательскийМакетУдалить",
								ЭлементПодменюНСИ);
			
			
		КонецЕсли; 
		
	КонецЕсли;
	
	УправлениеФормойНСИСервер.ДобавитьКомандуФормыЦНСИ(Форма,
								"ЦНСИ_ВвестиЗаявкуНаУдалениеДубликата_"+ИмяОбъекта,
								НСтр("ru = 'Ввести заявку на удаление дублирующего элемента'"),
								"ЦНСИ_ВвестиЗаявкуНаУдалениеДубликата_Подключаемый_"+ИмяОбъекта,
								"ПользовательскийМакетУдалить",
								ЭлементПодменюНСИ);

	
	УправлениеФормойНСИСервер.ДобавитьКомандуФормыЦНСИ(Форма,
								"ЦНСИ_ОткрытьСписокЗаявокНаИзменение_"+ИмяОбъекта,
								НСтр("ru = 'Открыть список заявок на изменение элемента'"),
								"ЦНСИ_ОткрытьСписокЗаявокНаИзменение_Подключаемый_"+ИмяОбъекта,
								"УстановитьФлажки",
								ЭлементПодменюНСИ);
								
	Если ИмяОбъекта="Контрагент" Тогда
			УправлениеФормойНСИСервер.ДобавитьКомандуФормыЦНСИ(Форма,
										"ЦНСИ_ПоказатьРеквизитыЦНСИ_"+ИмяОбъекта,
										НСтр("ru = 'Показать реквизиты ЦНСИ'"),
										"ЦНСИ_ПоказатьРеквизитыЦНСИ_Подключаемый_"+ИмяОбъекта,
										"Ресурс",
										ЭлементПодменюНСИ);
	КонецЕсли;
	
			
КонецПроцедуры // НарисоватьПанельУправленияЦНСИ()

Процедура ОтобразитьИзмененияОбъекта_Контрагент(Форма,АдресХранилищаИзменений) Экспорт

	ДанныеИзменения=ПолучитьИзВременногоХранилища(АдресХранилищаИзменений);
	ВидОперации=ДанныеИзменения.ВидОперации;
	
	Если ДанныеИзменения.Свойство("ИзменениеРеквизитов") Тогда
		
		ОтобразитьИзмененияШапки_Контрагент(Форма,ДанныеИзменения.ИзменениеРеквизитов,ВидОперации);
		
	КонецЕсли;
	
	Если ДанныеИзменения.Свойство("ИзменениеТЧ") Тогда 
		
		Для Каждого СтрокаТЧ ИЗ ДанныеИзменения.ИзменениеТЧ Цикл 
			
			ИмяТЧ=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.ТабличнаяЧасть,"Имя");
			
			Если ИмяТЧ="КонтактнаяИнформация" Тогда
				
				ОтобразитьИзменениеКонтактнойИнформации_Контрагент(Форма,СтрокаТЧ,ВидОперации);
				
			ИначеЕсли ИмяТЧ="ДополнительныеРеквизиты" Тогда
				
				УправлениеФормойНСИСервер.ОтобразитьИзменениеДополнительныхРеквизитов(Форма,СтрокаТЧ,ВидОперации);
				
			Иначе
				
				УправлениеФормойНСИСервер.ОтобразитьИзмененияТЧ(Форма,СтрокаТЧ,ВидОперации);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Форма.ТолькоПросмотр=Истина;

КонецПроцедуры // ОтобразитьИзмененияОбъекта()  

Процедура ОтобразитьИзмененияШапки_Контрагент(Форма,ИзменениеРеквизитов,ВидОперации)
	
	РеквизитыОбъекта = УправлениеФормойНСИСервер.ПолучитьОписаниеРеквизитовОбъекта(Форма.КонтрагентПартнера);
	
	ТаблицаЭлементов=Новый ТаблицаЗначений;	
	ТаблицаЭлементов.Колонки.Добавить("Элемент");
	ТаблицаЭлементов.Колонки.Добавить("Заголовок");
	ТаблицаЭлементов.Колонки.Добавить("НовоеЗначение");
	ТаблицаЭлементов.Колонки.Добавить("ПутьКДанным");
	
	РеквизитыКДобавлению=Новый Массив;
	МассивДобавленных=Новый Массив;
		
	Для Каждого Элемент ИЗ Форма.Элементы Цикл
		
		Если НЕ ТипЗнч(Элемент) = Тип("ПолеФормы") тогда
			Продолжить;
		КонецЕсли;
		
		Элемент.ТолькоПросмотр=Истина;
		
		Если СтрНайти(Элемент.ПутьКДанным,"Объект.")>0 Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИмяРеквизита=Элемент.ПутьКДанным;
		
		СтрИзменение=ИзменениеРеквизитов.Найти(ИмяРеквизита,"ИмяРеквизита");
		
		Если СтрИзменение=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ДанныеРеквизита=РеквизитыОбъекта.Найти(ИмяРеквизита,"Имя");
		
		Если ДанныеРеквизита=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Элемент.Заголовок) Тогда
				
			ЗаголовокЭлемента=ДанныеРеквизита.Синоним;
			
		Иначе
			
			ЗаголовокЭлемента=Элемент.Заголовок;
			
		КонецЕсли; 
		
		Если МассивДобавленных.Найти(ИмяРеквизита)=Неопределено Тогда
			
			МассивТипов=Новый Массив;
			МассивТипов.Добавить(ТипЗнч(СтрИзменение.НовоеЗначение));
			
			РеквизитыКДобавлению.Добавить(Новый РеквизитФормы("New_"+ИмяРеквизита,Новый ОписаниеТипов(МассивТипов)));
			
			МассивДобавленных.Добавить(ИмяРеквизита);
			
		КонецЕсли;
		
		НоваяСтрока=ТаблицаЭлементов.Добавить();
		НоваяСтрока.Элемент=Элемент;
		НоваяСтрока.Заголовок=ЗаголовокЭлемента;
		НоваяСтрока.НовоеЗначение=СтрИзменение.НовоеЗначение;
		НоваяСтрока.ПутьКДанным="New_"+ИмяРеквизита; 
					
	КонецЦикла; 
	
	Форма.ИзменитьРеквизиты(РеквизитыКДобавлению);
	
	ТекстСравнения=?(ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта,Нстр("ru = ' (новый)'"),Нстр("ru = ' (эталон)'"));
	УправлениеФормойНСИСервер.ОтобразитьИзменениеЭлементов(Форма,ТаблицаЭлементов,ТекстСравнения);
		
КонецПроцедуры // ОтобразитьИзмененияШапки()

Функция ПолучитьВидКонтактнойИнформацииКонтрагент(ВидКонтактнойИнформации)
	
	Если ВидКонтактнойИнформации=Справочники.ВидыКонтактнойИнформации.EmailПартнера Тогда
		
		Возврат Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		
	ИначеЕсли ВидКонтактнойИнформации=Справочники.ВидыКонтактнойИнформации.ТелефонПартнера Тогда
		
		Возврат Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		
	ИначеЕсли ВидКонтактнойИнформации=Справочники.ВидыКонтактнойИнформации.АдресПартнера Тогда
		
		Возврат Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
		
	Иначе
		
		Возврат ВидКонтактнойИнформации;
		
	КонецЕсли;
	
	
КонецФункции // ПолучитьВидКонтактнойИнформацииКонтрагент() 

Процедура ОтобразитьИзменениеКонтактнойИнформации_Контрагент(Форма, СтрокаТЧ,ВидОперации)
	
	КонтактнаяИнформацияСтар = Форма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов;
	КонтактнаяИнформацияНов = СтрокаТЧ.НовоеЗначение.Получить();
	
	ТаблицаЭлементов=Новый ТаблицаЗначений;	
	ТаблицаЭлементов.Колонки.Добавить("Элемент");
	ТаблицаЭлементов.Колонки.Добавить("Заголовок");
	ТаблицаЭлементов.Колонки.Добавить("НовоеЗначение");
	ТаблицаЭлементов.Колонки.Добавить("ПутьКДанным"); 
	
	РеквизитыКДобавлению=Новый Массив; 
		
	Для каждого СтрокаИнформация Из КонтактнаяИнформацияСтар Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаИнформация.ИмяРеквизита) Тогда
			
			Продолжить;
			
		КонецЕсли; 
		
		Если СтрокаИнформация.Вид.Родитель=Справочники.ВидыКонтактнойИнформации.СправочникПартнеры Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ЗначениеСтар 	= Форма[СтрокаИнформация.ИмяРеквизита];
		ЭлементСтар		= Форма.Элементы[СтрокаИнформация.ИмяРеквизита];
		
		Заголовок=?(ЗначениеЗаполнено(ЭлементСтар.Заголовок),ЭлементСтар.Заголовок,Строка(СтрокаИнформация.Вид));
		
		МассивТипов=Новый Массив;
		МассивТипов.Добавить(ТипЗнч(ЗначениеСтар));
		
		РеквизитыКДобавлению.Добавить(Новый РеквизитФормы("New_"+СтрокаИнформация.ИмяРеквизита,Новый ОписаниеТипов(МассивТипов)));
	
		НайденныеСтроки = КонтактнаяИнформацияНов.НайтиСтроки(Новый Структура("Тип,Вид,ДействуетС", СтрокаИнформация.Тип, ПолучитьВидКонтактнойИнформацииКонтрагент(СтрокаИнформация.Вид),СтрокаИнформация.ДействуетС));
		
		Если НайденныеСтроки.Количество()=0 Тогда
			
			НовоеЗначение=Неопределено;
			
		Иначе
			
			НовоеЗначение=НайденныеСтроки[0].Представление;
			
		КонецЕсли;   
		
		Если (ЗначениеЗаполнено(ЗначениеСтар) ИЛИ ЗначениеЗаполнено(НовоеЗначение))
			И НЕ ЗначениеСтар=НовоеЗначение Тогда
			
			НоваяСтрока=ТаблицаЭлементов.Добавить();
			НоваяСтрока.Элемент=ЭлементСтар;
			НоваяСтрока.Заголовок=Заголовок;
			НоваяСтрока.НовоеЗначение=НовоеЗначение;
			НоваяСтрока.ПутьКДанным="New_"+СтрокаИнформация.ИмяРеквизита;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(РеквизитыКДобавлению);
	
	ТекстСравнения=?(ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта,Нстр("ru = ' (новый)'"),Нстр("ru = ' (эталон)'"));
	УправлениеФормойНСИСервер.ОтобразитьИзменениеЭлементов(Форма,ТаблицаЭлементов,ТекстСравнения); 
	
	Если НЕ Форма.Элементы.Найти("ГруппаЮрАдресДопДействия")=Неопределено Тогда
		
		Форма.Элементы.ГруппаЮрАдресДопДействия.Видимость=Ложь;
		
	КонецЕсли;
	
КонецПроцедуры 

Процедура ОтобразитьИзмененияОбъекта_Партнер(Форма,АдресХранилищаИзменений) Экспорт

	ДанныеИзменения=ПолучитьИзВременногоХранилища(АдресХранилищаИзменений);
	ВидОперации=ДанныеИзменения.ВидОперации;
	
	Если ДанныеИзменения.Свойство("ИзменениеРеквизитов") Тогда
		
