КонецФункции // ПолучитьЗапросПоТаблицамВИБиИменамНастроек() 

Функция ПолучитьСоответствиеСсылок(ДочерняяБаза,ТаблицаЗначенийПолей,Организация,ТолькоПроверка=Ложь)

	РеквизитыИБ=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДочерняяБаза,"ТипБД,УзелИнформационнойБазы");
	
	Если ТаблицаЗначенийПолей.Колонки.Найти("НастройкаСоответствия")=Неопределено Тогда
		
		Запрос=ПолучитьЗапросПоТаблицамВИБ(РеквизитыИБ.УзелИнформационнойБазы);
		
	Иначе
		
		Запрос=ПолучитьЗапросПоТаблицамВИБиИменамНастроек(РеквизитыИБ.УзелИнформационнойБазы);
		
	КонецЕсли;	
		
	ТипБД=РеквизитыИБ.ТипБД;
	
	Запрос.УстановитьПараметр("ТаблицаЗначенийПолей",ТаблицаЗначенийПолей);
	Запрос.УстановитьПараметр("ИспользуемаяИБ",ДочерняяБаза);
	Запрос.УстановитьПараметр("ТипБД",ТипБД); 
	
	Результат=Запрос.ВыполнитьПакет();
	
	Если ЗначениеЗаполнено(РеквизитыИБ.УзелИнформационнойБазы) Тогда
		
		Возврат ВернутьСоответствиеСсылокСУчетомED(Результат,ДочерняяБаза,Организация,ТолькоПроверка);
		
	Иначе
		
		Возврат ВернутьСоответствиеСсылок(Результат,ДочерняяБаза,Организация,ТипБД,ТолькоПроверка)
		
	КонецЕсли;	
	
КонецФункции // ПолучитьСоответствиеСсылок()

Функция ВернутьСоответствиеСсылокСУчетомED(Результат,ДочерняяБаза,Организация,ТолькоПроверка) 	
			
	РабТаблицаЗначенийПолей=Результат[5].Выгрузить();
	ТабНастройкиСоответствия=Результат[6].Выгрузить();
				
	СоответствиеСсылок=Новый Соответствие;
	
	Для Каждого СтрокаСоответствия ИЗ ТабНастройкиСоответствия  Цикл
		
		ИмяПеречисления=Неопределено;
		ИмяПеречисленияВИБ=Неопределено;
		
		Если ЗначениеЗаполнено(СтрокаСоответствия.НастройкаСоответствия) Тогда
			
			МассивДанные=РабТаблицаЗначенийПолей.НайтиСтроки(Новый Структура("НастройкаСоответствия",СтрокаСоответствия.НастройкаСоответствия));
			ТаблицаАналитикиТек=СтрокаСоответствия.ТаблицаАналитикиТек;
			
		Иначе
			
			МассивДанные=РабТаблицаЗначенийПолей.НайтиСтроки(Новый Структура("ТаблицаАналитикиВИБ",СтрокаСоответствия.ТаблицаАналитикиВИБ));
			ТаблицаАналитикиТек=СтрокаСоответствия.ТаблицаАналитикиВИБ;
			
		КонецЕсли; 
		
		Если СтрНайти(ТаблицаАналитикиТек,"Перечисление.")>0 Тогда
			
			ИмяПеречисления=СтрЗаменить(ТаблицаАналитикиТек,"Перечисление.","");
			
		КонецЕсли;
		
		Если СтрНайти(СтрокаСоответствия.ТаблицаАналитикиВИБ,"Перечисление.")>0 Тогда
			
			ИмяПеречисленияВИБ=СтрЗаменить(СтрокаСоответствия.ТаблицаАналитикиВИБ,"Перечисление.","");
	
			Если ЗначениеЗаполнено(СтрокаСоответствия.НастройкаСоответствия)
				И (СтрНайти(СтрокаСоответствия.ТаблицаАналитикиТек,"Справочник.")>0 
				ИЛИ СтрНайти(СтрокаСоответствия.ТаблицаАналитикиТек,"ПланПланВидовХарактеристик.")>0) Тогда
				
				ДанныеДляСинхронизации=ПолучитьДанныеДляСинхронизации(СтрокаСоответствия.НастройкаСоответствия); 
				
			Иначе
				
				ДанныеДляСинхронизации=Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;
		
		МассивСсылок=Новый Массив;
		МассивСчетов=Новый Массив;
		
		Для Каждого СтрокаДанные ИЗ МассивДанные Цикл
			
			Если ЗначениеЗаполнено(СтрокаДанные.ОбъектТекущейИБ) Тогда
				
				 СоответствиеСсылок.Вставить(СтрокаДанные.ПредставлениеGUID,СтрокаДанные.ОбъектТекущейИБ);
				 
			 ИначеЕсли СтрокаСоответствия.СинхронизацияПоGUID Тогда
				 
				 Продолжить;
				 
			 ИначеЕсли НЕ ИмяПеречисления=Неопределено Тогда
				 
				 СоответствиеСсылок.Вставить(СтрокаДанные.ПредставлениеGUID,
						ОбщегоНазначенияУХ.ПолучитьЗначениеПеречисленияПоИмени(ИмяПеречисления,СтрокаДанные.GUID,СтрокаСоответствия.НастройкаСоответствия));		
						
			ИначеЕсли НЕ ИмяПеречисленияВИБ=Неопределено Тогда			
				
				Если НЕ ДанныеДляСинхронизации=Неопределено Тогда
					
					СоответствиеСсылок.Вставить(СтрокаДанные.ПредставлениеGUID,
						ПолучитьЭлементАналитикиДляПеречисления(СтрокаДанные.GUID,ДанныеДляСинхронизации));

				КонецЕсли;			
						
			ИначеЕсли НЕ СтрокаДанные.GUID="00000000-0000-0000-0000-000000000000" Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.НастройкаСоответствия) Тогда
					
					Если СтрНайти(ТаблицаАналитикиТек,"ПланСчетов.")>0 Тогда
						
						МассивСчетов.Добавить(СтрокаДанные.GUID);
						
					КонецЕсли;
					
				Иначе
					
					МассивСсылок.Добавить(СтрокаДанные.GUID);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если (МассивСсылок.Количество()=0
			И МассивСчетов.Количество()=0) ИЛИ ТолькоПроверка Тогда
			
			Продолжить;
			
		КонецЕсли; 
					
		Если ЗначениеЗаполнено(СтрокаСоответствия.НастройкаСоответствия) Тогда
			
			ТекСоответствиеСсылок=ИнтеграцияСВнешнимиСистемамиУХ.ЗагрузитьОбъектыИзВИБ(ДочерняяБаза,
			СтрокаСоответствия.НастройкаСоответствия,Организация,МассивСсылок,Истина,Истина,,,Истина);
			
			Для Каждого КлючИЗначение ИЗ ТекСоответствиеСсылок Цикл
				
				СоответствиеСсылок.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
				
			КонецЦикла;
			
		ИначеЕсли МассивСчетов.Количество()>0 Тогда
			
			ТекСоответствиеСсылок=ИнтеграцияСВнешнимиСистемамиУХ.ПолучитьСоответствиеСчетов(ДочерняяБаза,СтрокаСоответствия.ТаблицаАналитикиВИБ,МассивСчетов);
			
			Для Каждого КлючИЗначение ИЗ ТекСоответствиеСсылок Цикл
				
				СоответствиеСсылок.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
				
			КонецЦикла;		
			
		КонецЕсли;
					
	КонецЦикла;
	
	ПроверитьСинхронизациюОбъектовВИБ(ДочерняяБаза,СоответствиеСсылок,РабТаблицаЗначенийПолей);
	
	Возврат СоответствиеСсылок;	
	
КонецФункции // ВернутьСоответствиеСсылокСУчетомED()  

Функция ВернутьСоответствиеСсылок(Результат,ДочерняяБаза,Организация,ТипБД,ТолькоПроверка)
		
	РабТаблицаЗначенийПолей=Результат[4].Выгрузить();
	ТабНастройкиСоответствия=Результат[5].Выгрузить();		
		
	СоответствиеСсылок=Новый Соответствие;
	
	Для Каждого СтрокаСоответствия ИЗ ТабНастройкиСоответствия  Цикл
		
		ИмяПеречисления=Неопределено;
		ИмяПеречисленияВИБ=Неопределено;
		
		Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.НастройкаСоответствия) Тогда
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для типа информационной базы %1 не найдена настройка соответствия для объекта %2'"),ТипБД,СтрокаСоответствия.ТаблицаАналитикиВИБ),,,СтатусСообщения.Важное);
			Продолжить;
			
		КонецЕсли; 
		
		Если СтрНайти(СтрокаСоответствия.ТаблицаАналитикиТек,"Перечисление.")>0 Тогда
			
			ИмяПеречисления=СтрЗаменить(СтрокаСоответствия.ТаблицаАналитикиТек,"Перечисление.","");
			
		КонецЕсли; 
		
		Если СтрНайти(СтрокаСоответствия.ТаблицаАналитикиВИБ,"Перечисление.")>0 Тогда
			
			ИмяПеречисленияВИБ=СтрЗаменить(СтрокаСоответствия.ТаблицаАналитикиВИБ,"Перечисление.","");
	
			Если (СтрНайти(СтрокаСоответствия.ТаблицаАналитикиТек,"Справочник.")>0 
				ИЛИ СтрНайти(СтрокаСоответствия.ТаблицаАналитикиТек,"ПланПланВидовХарактеристик.")>0) Тогда
				
				ДанныеДляСинхронизации=ПолучитьДанныеДляСинхронизации(СтрокаСоответствия.НастройкаСоответствия);
				
			Иначе
				
				ДанныеДляСинхронизации=Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;
		
		МассивДанные=РабТаблицаЗначенийПолей.НайтиСтроки(Новый Структура("НастройкаСоответствия",СтрокаСоответствия.НастройкаСоответствия));
		МассивСсылок=Новый Массив;
		
		Для Каждого СтрокаДанные ИЗ МассивДанные Цикл
			
			Если ЗначениеЗаполнено(СтрокаДанные.ОбъектТекущейИБ) Тогда
				
				 СоответствиеСсылок.Вставить(СтрокаДанные.ПредставлениеGUID,СтрокаДанные.ОбъектТекущейИБ);
				 
			 ИначеЕсли СтрокаСоответствия.СинхронизацияПоGUID Тогда
				 
				 Продолжить;
				 
			 ИначеЕсли НЕ ИмяПеречисления=Неопределено Тогда
				 
				 СоответствиеСсылок.Вставить(СтрокаДанные.ПредставлениеGUID,
						ОбщегоНазначенияУХ.ПолучитьЗначениеПеречисленияПоИмени(ИмяПеречисления,СтрокаДанные.GUID,СтрокаСоответствия.НастройкаСоответствия));
						
			ИначеЕсли НЕ ИмяПеречисленияВИБ=Неопределено Тогда			
				
				Если НЕ ДанныеДляСинхронизации=Неопределено Тогда
					
					СоответствиеСсылок.Вставить(СтрокаДанные.ПредставлениеGUID,
						ПолучитьЭлементАналитикиДляПеречисления(СтрокаДанные.GUID,ДанныеДляСинхронизации));

				КонецЕсли;	
				
			ИначеЕсли НЕ СтрокаДанные.GUID="00000000-0000-0000-0000-000000000000" Тогда
				
				МассивСсылок.Добавить(СтрокаДанные.GUID);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивСсылок.Количество()=0
			ИЛИ ТолькоПроверка Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТекСоответствиеСсылок=ИнтеграцияСВнешнимиСистемамиУХ.ЗагрузитьОбъектыИзВИБ(ДочерняяБаза,
			СтрокаСоответствия.НастройкаСоответствия,Организация,МассивСсылок,Истина,,,,Истина);
		
		Для Каждого КлючИЗначение ИЗ ТекСоответствиеСсылок Цикл
			
			СоответствиеСсылок.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
			
		КонецЦикла;
					
	КонецЦикла;
	
	ПроверитьСинхронизациюОбъектовВИБ(ДочерняяБаза,СоответствиеСсылок,РабТаблицаЗначенийПолей);
	
	Возврат СоответствиеСсылок;	
	
КонецФункции // ВернутьСоответствиеСсылок() 

Функция ПолучитьДанныеДляСинхронизации(НастройкаСоответствия)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СоответствиеВнешнимИБ.ОписаниеОбъектаТек.СоздаватьПриНеудачномПоискеПриИмпорте КАК СоздаватьПриНеудачномПоискеПриИмпорте,
	             |	СоответствиеВнешнимИБ.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек,
	             |	СоответствиеВнешнимИБ.СоответствиеРеквизитов.(
	             |		РеквизитОбъектаКонсолидации КАК РеквизитОбъектаКонсолидации,
	             |		НеИспользоватьДляСинхронизации КАК НеИспользоватьДляСинхронизации
	             |	) КАК СоответствиеРеквизитов,
	             |	СоответствиеВнешнимИБ.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	             |ГДЕ
	             |	СоответствиеВнешнимИБ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",НастройкаСоответствия);
	
	Возврат Запрос.Выполнить().Выгрузить()[0];
	
		
КонецФункции // ПолучитьДанныеДляСинхронизации() 

Функция ПолучитьЭлементАналитикиДляПеречисления(ИмяПеречисления,ДанныеДляСинхронизации)
	
	ПолеСинхронизации=ДанныеДляСинхронизации.СоответствиеРеквизитов.Найти(ЛОЖЬ,"НеИспользоватьДляСинхронизации").РеквизитОбъектаКонсолидации;
	ОбъектПеречисление=СтрЗаменить(ДанныеДляСинхронизации.ТаблицаАналитикиВИБ,"Перечисление.","");
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ Ссылка ИЗ &ТаблицаАналитикиТек ГДЕ &Отбор";
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТаблицаАналитикиТек",ДанныеДляСинхронизации.ТаблицаАналитикиТек);
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Отбор",ПолеСинхронизации+"=&ИмяПеречисления");
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("ИмяПеречисления",ИмяПеречисления);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Возврат Результат.Ссылка;
		
	КонецЕсли;
	
	Если НЕ ДанныеДляСинхронизации.СоздаватьПриНеудачномПоискеПриИмпорте Тогда
		
		ТекстОшибки=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Не удалось определить элемент таблицы %1 текущей ИБ,'"),ДанныеДляСинхронизации.ТаблицаАналитикиТек);
		ТекстОшибки=ТекстОшибки+Символы.ПС+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'соответствующий значению %1 перечисления внешней ИБ %2'"),ИмяПеречисления,ОбъектПеречисление);		
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,,,СтатусСообщения.Внимание);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ДанныеОбъекта=СтрРазделить(ДанныеДляСинхронизации.ТаблицаАналитикиТек,".");
	ТипОбъектаМетаданных=ДанныеОбъекта[0];
	ИмяОбъектаМетаданных=ДанныеОбъекта[1];
	
	Если ТипОбъектаМетаданных="Справочник" Тогда
		
		НовыйОбъект=Справочники[ИмяОбъектаМетаданных].СоздатьЭлемент();
		
	Иначе
		
		НовыйОбъект=ПланыВидовХарактеристик[ИмяОбъектаМетаданных].СоздатьЭлемент();
		
	КонецЕсли;
	
	НовыйОбъект[ПолеСинхронизации]=ИмяПеречисления;
	
	Попытка
		
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
		
	Исключение
		
		ТекстОшибки=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Не удалось создать элемент таблицы %1 текущей ИБ,'"),ДанныеДляСинхронизации.ТаблицаАналитикиТек);
		ТекстОшибки=ТекстОшибки+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'соответствующий значению %1 перечисления внешней ИБ %2'"),ИмяПеречисления,ОбъектПеречисление);		
		ТекстОшибки=ТекстОшибки+Символы.ПС+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,,,СтатусСообщения.Внимание);
		
		Возврат Неопределено;
		
	КонецПопытки;;
			
КонецФункции // ПолучитьЭлементАналитикиДляПеречисления()

Процедура ПроверитьСинхронизациюОбъектовВИБ(ДочерняяБаза,СоответствиеСсылок,РабТаблицаЗначенийПолей)
	
	МассивОшибок=Новый Массив;
	
	Если СоответствиеСсылок.Количество()<РабТаблицаЗначенийПолей.Количество() Тогда
		
		МассивНеСинхронизированных=Новый  Массив;
		
		Для Каждого СтрокаДанные ИЗ РабТаблицаЗначенийПолей Цикл
			
			СинхронизированныйОбъект=СоответствиеСсылок.Получить(СтрокаДанные.ПредставлениеGUID);
			
			Если СинхронизированныйОбъект=Неопределено И НЕ (СтрокаДанные.GUID="00000000-0000-0000-0000-000000000000" 
				ИЛИ ПустаяСтрока(СтрокаДанные.GUID)) Тогда
				
				МассивНеСинхронизированных.Добавить(Новый Структура("ТаблицаАналитикиВИБ,GUID",СтрокаДанные.ТаблицаАналитикиВИБ,СтрокаДанные.GUID));
				
			КонецЕсли;
		
		КонецЦикла;
		
		Если МассивНеСинхронизированных.Количество()>0 Тогда
			
			МассивОшибок=GetArrayOfSyncErrors(ДочерняяБаза,МассивНеСинхронизированных); 
			
			Если МассивОшибок=Неопределено Тогда
				
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
			
	Для Каждого ТекстОшибки ИЗ МассивОшибок Цикл 
		
		ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Не удалось сопоставить объект текущей ИБ объекту информационной базы %1: '"),ДочерняяБаза);
		ТекстСообщения=ТекстСообщения+Символы.ПС+ТекстОшибки;
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Внимание);
		
	КонецЦикла;
	
КонецПроцедуры // ПроверитьСинхронизациюОбъектовВИБ() 

Функция GetArrayOfSyncErrors(ДочерняяБаза,МассивНеСинхронизированных)
	
	ТекСоединениеВИБ = УправлениеСоединениямиВИБУХ.ПолучитьСоединение(ДочерняяБаза, 1);
	
	СтруктураДанных=Новый Структура;
	СтруктураДанных.Вставить("МассивНеСинхронизированных",МассивНеСинхронизированных);
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда 
		
		Возврат ТекСоединениеВИБ.GetArrayOfSyncErrors(Новый ХранилищеЗначения(СтруктураДанных, Новый СжатиеДанных(9))).Получить();
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"GetArrayOfSyncErrors",СтруктураДанных);
		
	Иначе
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.GetArrayOfSyncErrors(ТекСоединениеВИБ,СтруктураДанных);
		
	КонецЕсли;
		
КонецФункции // GetArrayOfSyncErrors()

Процедура ОтметитьОбменВыполнен(ТаблицаОбмена) Экспорт
	
	
	
КонецПроцедуры // ОтметитьОбменВыполнен()

Функция ПолучитьДанныеЗаявок(ДочерняяБаза,ТаблицаОбмена) Экспорт
	
	ТекСоединениеВИБ = ПодключениеКВИБУХ.ПолучитьСоединение(ДочерняяБаза, 1);
	
	Если ТекСоединениеВИБ=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ТаблицаЗаявок",ТаблицаОбмена);
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
				
		Возврат ТекСоединениеВИБ.GetMDMApplication(Новый ХранилищеЗначения(СтруктураПараметров, Новый СжатиеДанных(9))).Получить(); 
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"GetMDMApplication",СтруктураПараметров);
		
	Иначе
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.GetMDMApplication(ТекСоединениеВИБ,СтруктураПараметров);
		
	КонецЕсли;
		
КонецФункции // ЗагрузитьЗаявкиПоТаблице() 

Процедура ПередатьСтатусПриНеобходимости(ЗаявкаСсылка,ТекСостояние) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза КАК ЗаявкаДочерняяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза КАК ДочерняяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.Состояние КАК Состояние,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза.ТипБД.ОбменДаннымиРегламентнымЗаданием КАК ОбменДаннымиРегламентнымЗаданием
	             |ИЗ
	             |	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	             |ГДЕ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаЦентральнаяБаза = &ЗаявкаЦентральнаяБаза
	             |	И НЕ СоответствиеЗаявокНаИзменениеНСИ.Состояние = &Состояние";
	
	Запрос.УстановитьПараметр("ЗаявкаЦентральнаяБаза",ЗаявкаСсылка);
	Запрос.УстановитьПараметр("Состояние",ТекСостояние);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		НаборЗаписей=РегистрыСведений.СоответствиеЗаявокНаИзменениеНСИ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗаявкаЦентральнаяБаза.Установить(ЗаявкаСсылка);
		НаборЗаписей.Прочитать();
		
		НаборЗаписей[0].Состояние=ТекСостояние;
		НаборЗаписей[0].ТребуетсяПередачаСтатуса=Истина;
		
		НаборЗаписей.Записать();
		
		Если НЕ Результат.ОбменДаннымиРегламентнымЗаданием Тогда
			
			ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Выгрузка статусов заявок, внешняя ИБ %1'"),Результат.ДочерняяБаза);
			КлючЗадания=Новый УникальныйИдентификатор;
			
			ПараметрыЗадания=Новый Массив;
			ПараметрыЗадания.Добавить(Результат.ДочерняяБаза);
			
			ФоновыеЗадания.Выполнить("ОбменДаннымиНСИУХ.ВыгрузитьСтатусыЗаявокДочернихКомпаний",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
			
	//		ВыгрузитьСтатусыЗаявокДочернихКомпаний(Результат.ДочерняяБаза);
			
		КонецЕсли;
		
	КонецЕсли; 
			
	
КонецПроцедуры // ПередатьСтатусПриНеобходимости() 

Процедура ВыгрузитьСтатусыЗаявокДочернихКомпаний(ДочерняяБаза=Неопределено) Экспорт
	
	Запрос=Новый Запрос;
	
	ТекстЗапроса="ВЫБРАТЬ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза КАК ЗаявкаДочерняяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза КАК ДочерняяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.Состояние КАК Состояние,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаЦентральнаяБаза КАК ЗаявкаЦентральнаяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаЦентральнаяБаза.Номер КАК ЗаявкаЦентральнаяБазаНомер,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаЦентральнаяБаза.Дата КАК ЗаявкаЦентральнаяБазаДата
	             |ПОМЕСТИТЬ ЗаявкиКОбработке
	             |ИЗ
	             |	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	             |ГДЕ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ТребуетсяПередачаСтатуса
	             |	И НЕ СоответствиеЗаявокНаИзменениеНСИ.ЕстьОшибкиОбмена
	             |	И &Параметр1
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ЗаявкиКОбработке.ДочерняяБаза КАК ДочерняяБаза
	             |ИЗ
	             |	ЗаявкиКОбработке КАК ЗаявкиКОбработке
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ЗаявкиКОбработке.ДочерняяБаза КАК ДочерняяБаза,
	             |	ЗаявкиКОбработке.ЗаявкаДочерняяБаза КАК ЗаявкаДочерняяБаза,
	             |	ЗаявкиКОбработке.Состояние КАК Состояние,
	             |	ЗаявкиКОбработке.ЗаявкаЦентральнаяБаза КАК ЗаявкаЦентральнаяБаза,
	             |	ЗаявкиКОбработке.ЗаявкаЦентральнаяБазаНомер КАК ЗаявкаЦентральнаяБазаНомер,
	             |	ЗаявкиКОбработке.ЗаявкаЦентральнаяБазаДата КАК ЗаявкаЦентральнаяБазаДата
	             |ИЗ
	             |	ЗаявкиКОбработке КАК ЗаявкиКОбработке";
	
	Если ЗначениеЗаполнено(ДочерняяБаза) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза=&ДочерняяБаза");
		Запрос.УстановитьПараметр("ДочерняяБаза",ДочерняяБаза);
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","ИСТИНА");
		
	КонецЕсли; 
	
	Запрос.Текст=ТекстЗапроса;
	
	Результат=Запрос.ВыполнитьПакет();
	
	ТабАдресации=Результат[1].Выгрузить();
	ТабЗаявок=Результат[2].Выгрузить(); 
	
	Для Каждого Строка ИЗ ТабАдресации Цикл
		
		ТаблицаОбмена=ТабЗаявок.Скопировать(Новый Структура("ДочерняяБаза",Строка.ДочерняяБаза));
		
		ВыгрузитьСтатусыЗаявокНСИ(Строка.ДочерняяБаза,ТаблицаОбмена);
				
	КонецЦикла;	
	
КонецПроцедуры // ЗагрузитьЗаявкиДочернихКомпаний()

