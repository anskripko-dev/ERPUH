КонецПроцедуры // ЗагрузитьЗаявкиДочернихКомпаний()

Процедура ВыгрузитьСтатусыЗаявокНСИ(ДочерняяБаза,ТаблицаОбмена)
	
	ТекСоединениеВИБ = ПодключениеКВИБУХ.ПолучитьСоединение(ДочерняяБаза, 1); 
	
	Если ТекСоединениеВИБ=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ИспользоватьWS=(ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") ИЛИ ТипЗнч(ТекСоединениеВИБ)= Тип("Строка"));
	
	Если ИспользоватьWS Тогда
		
		ТаблицаСтатусов=Новый ТаблицаЗначений;
		
	Иначе
		
		ТаблицаСтатусов=ТекСоединениеВИБ.NewObject("ТаблицаЗначений");
		
	КонецЕсли;
	
	ТаблицаСтатусов.Колонки.Добавить("ЗаявкаДочерняяБаза");
	ТаблицаСтатусов.Колонки.Добавить("ЗаявкаЦентральнаяБаза");
	ТаблицаСтатусов.Колонки.Добавить("Состояние");
	ТаблицаСтатусов.Колонки.Добавить("ЗаявкаЦентральнаяБазаНомер");
	ТаблицаСтатусов.Колонки.Добавить("ЗаявкаЦентральнаяБазаДата");
	ТаблицаСтатусов.Колонки.Добавить("ОбработкаВыполнена");
	
	Для Каждого Строка ИЗ ТаблицаОбмена Цикл
		
		НоваяСтрока=ТаблицаСтатусов.Добавить();
		НоваяСтрока.ЗаявкаДочерняяБаза			= Строка.ЗаявкаДочерняяБаза;
		НоваяСтрока.ЗаявкаЦентральнаяБаза		= XMLСтрока(Строка.ЗаявкаЦентральнаяБаза);
		НоваяСтрока.Состояние					= XMLСтрока(Строка.Состояние); 
		НоваяСтрока.ЗаявкаЦентральнаяБазаНомер	= Строка.ЗаявкаЦентральнаяБазаНомер;
		НоваяСтрока.ЗаявкаЦентральнаяБазаДата	= Строка.ЗаявкаЦентральнаяБазаДата;
		НоваяСтрока.ОбработкаВыполнена			= Ложь;
		
	КонецЦикла;
	
	ОбработаннаяТаблица=ОбработатьТаблицуИзмененныхСтатусов(ТекСоединениеВИБ,ТаблицаСтатусов);
	
	Если НЕ ОбработаннаяТаблица=Неопределено Тогда
		
		Для Каждого Строка ИЗ ОбработаннаяТаблица Цикл
			
			Если Строка.ОбработкаВыполнена Тогда
				
				НаборЗаписей=РегистрыСведений.СоответствиеЗаявокНаИзменениеНСИ.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ДочерняяБаза.Установить(ДочерняяБаза);
				НаборЗаписей.Отбор.ЗаявкаДочерняяБаза.Установить(Строка.ЗаявкаДочерняяБаза);
				
				НаборЗаписей.Прочитать();
				НаборЗаписей[0].ТребуетсяПередачаСтатуса=Ложь;
				НаборЗаписей.Записать();
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ВыгрузитьСтатусыЗаявокНСИ()

Функция ОбработатьТаблицуИзмененныхСтатусов(ТекСоединениеВИБ,ТаблицаСтатусов)
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ТаблицаСтатусов",ТаблицаСтатусов);
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
						
		Возврат ТекСоединениеВИБ.PutMDMApplicationStatus(Новый ХранилищеЗначения(СтруктураПараметров, Новый СжатиеДанных(9))).Получить();
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"PutMDMApplicationStatus",СтруктураПараметров);
		
	Иначе
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.PutMDMApplicationStatus(ТекСоединениеВИБ,СтруктураПараметров);
		
	КонецЕсли;
		
КонецФункции // ОбработатьТаблицуИзмененныхСтатусов()

Процедура ВыгрузитьОшибкиЗаявокНСИ(ДочерняяБаза,ТаблицаОбмена)
	
	ТекСоединениеВИБ = ПодключениеКВИБУХ.ПолучитьСоединение(ДочерняяБаза, 1); 
	
	Если ТекСоединениеВИБ=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ИспользоватьWS=(ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") ИЛИ ТипЗнч(ТекСоединениеВИБ)= Тип("Строка"));
	
	Если ИспользоватьWS Тогда
		
		ТаблицаОшибок=Новый ТаблицаЗначений;
		
	Иначе
		
		ТаблицаОшибок=ТекСоединениеВИБ.NewObject("ТаблицаЗначений");
		
	КонецЕсли;
	
	ТаблицаОшибок.Колонки.Добавить("ЗаявкаДочерняяБаза");
	ТаблицаОшибок.Колонки.Добавить("ИнформацияОбОшибке");
	ТаблицаОшибок.Колонки.Добавить("ОбработкаВыполнена");
	
	Для Каждого Строка ИЗ ТаблицаОбмена Цикл
		
		НоваяСтрока=ТаблицаОшибок.Добавить();
		НоваяСтрока.ЗаявкаДочерняяБаза			= Строка.ЗаявкаДочерняяБаза;
		НоваяСтрока.ИнформацияОбОшибке			= Строка.ИнформацияОбОшибке; 
		НоваяСтрока.ОбработкаВыполнена			= Ложь;
		
	КонецЦикла;
	
	ОбработаннаяТаблица=ОбработатьТаблицуОшибокЗаявок(ТекСоединениеВИБ,ТаблицаОшибок);
	
	Если НЕ ОбработаннаяТаблица=Неопределено Тогда
		
		Для Каждого Строка ИЗ ОбработаннаяТаблица Цикл
			
			Если Строка.ОбработкаВыполнена Тогда
				
				НаборЗаписей=РегистрыСведений.СоответствиеЗаявокНаИзменениеНСИ.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ДочерняяБаза.Установить(ДочерняяБаза);
				НаборЗаписей.Отбор.ЗаявкаДочерняяБаза.Установить(Строка.ЗаявкаДочерняяБаза);
				
				НаборЗаписей.Прочитать();
				НаборЗаписей[0].ТребуетсяПередачаСтатуса=Ложь;
				НаборЗаписей.Записать();
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ВыгрузитьОшибкиЗаявокНСИ() 

Функция ОбработатьТаблицуОшибокЗаявок(ТекСоединениеВИБ,ТаблицаОшибок)
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ТаблицаОшибок",ТаблицаОшибок);
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
						
		Возврат ТекСоединениеВИБ.SetMDMApplicationErrorText(Новый ХранилищеЗначения(СтруктураПараметров, Новый СжатиеДанных(9))).Получить();
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"SetMDMApplicationErrorText",СтруктураПараметров);
		
	Иначе
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.SetMDMApplicationErrorText(ТекСоединениеВИБ,СтруктураПараметров);
		
	КонецЕсли;
		
КонецФункции // ОбработатьТаблицуИзмененныхСтатусов()

Функция ПодготовитьДанныеКонтроляНСИ(НастройкаСоответствия)
	
	ДанныеСоответствия=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаСоответствия,"Владелец,ОписаниеОбъектаВИБ,ОписаниеОбъектаТек");
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ТекущаяБДРеквизиты.Имя КАК Имя,
	             |	ТекущаяБДРеквизиты.Обязательный КАК Обязательный,
	             |	ТекущаяБДРеквизиты.КонтрольУникальности КАК КонтрольУникальности,
	             |	ТекущаяБДРеквизиты.ИзменениеБезСогласования КАК ИзменениеБезСогласования
	             |ПОМЕСТИТЬ РеквизитыКонтроляТек
	             |ИЗ
	             |	Справочник.СправочникиБД.Реквизиты КАК ТекущаяБДРеквизиты
	             |ГДЕ
	             |	ТекущаяБДРеквизиты.Ссылка = &ОбъектТек
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СправочникиБДРеквизиты.Имя КАК Имя,
	             |	СправочникиБДРеквизиты.Синоним КАК Синоним,
	             |	СправочникиБДРеквизиты.Использование КАК Использование
	             |ПОМЕСТИТЬ РеквизитыОбъектаВИБ
	             |ИЗ
	             |	Справочник.СправочникиБД.Реквизиты КАК СправочникиБДРеквизиты
	             |ГДЕ
	             |	СправочникиБДРеквизиты.Ссылка = &ОбъектВИБ
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ТекущаяБДСогласуемыеТЧ.ОписаниеТЧ.Имя КАК ОписаниеТЧИмя
	             |ПОМЕСТИТЬ СогласуемыеТЧТек
	             |ИЗ
	             |	Справочник.СправочникиБД.СогласуемыеТЧ КАК ТекущаяБДСогласуемыеТЧ
	             |ГДЕ
	             |	ТекущаяБДСогласуемыеТЧ.Ссылка = &ОбъектТек
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СоответствиеВнешнимИБСоответствиеРеквизитов.РеквизитОбъектаКонсолидации КАК РеквизитОбъектаТек,
	             |	СоответствиеВнешнимИБСоответствиеРеквизитов.РеквизитОбъектаВнешнейИБ КАК РеквизитОбъектаВИБ,
	             |	РеквизитыОбъектаВИБ.Синоним КАК Синоним,
	             |	РеквизитыОбъектаВИБ.Использование КАК Использование
	             |ПОМЕСТИТЬ СоответствиеРеквизитов
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ.СоответствиеРеквизитов КАК СоответствиеВнешнимИБСоответствиеРеквизитов
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РеквизитыОбъектаВИБ КАК РеквизитыОбъектаВИБ
	             |		ПО СоответствиеВнешнимИБСоответствиеРеквизитов.РеквизитОбъектаВнешнейИБ = РеквизитыОбъектаВИБ.Имя
	             |ГДЕ
	             |	СоответствиеВнешнимИБСоответствиеРеквизитов.Ссылка = &НастройкаСоответствия
	             |	И СоответствиеВнешнимИБСоответствиеРеквизитов.СпособЗаполнения = ЗНАЧЕНИЕ(Перечисление.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаВИБ.Имя КАК ТабличнаяЧастьВИБ,
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаТек.Имя КАК ТабличнаяЧастьТек
	             |ПОМЕСТИТЬ СоответствиеТЧ
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ.СоответствияСвязанныхОбъектов КАК СоответствиеВнешнимИБСоответствияСвязанныхОбъектов
	             |ГДЕ
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.Ссылка = &НастройкаСоответствия
	             |	И СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаВИБ ССЫЛКА Справочник.ТабличныеЧастиБД
	             |	И СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаТек ССЫЛКА Справочник.ТабличныеЧастиБД
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ЕСТЬNULL(СоответствиеРеквизитов.РеквизитОбъектаВИБ, """") КАК Имя,
	             |	ЕСТЬNULL(СоответствиеРеквизитов.Синоним, """") КАК Синоним,
	             |	ЕСТЬNULL(СоответствиеРеквизитов.Использование, ЗНАЧЕНИЕ(Перечисление.ИспользованиеРеквизита.ПустаяСсылка)) КАК Использование,
	             |	РеквизитыКонтроляТек.Обязательный КАК Обязательный,
	             |	РеквизитыКонтроляТек.КонтрольУникальности КАК КонтрольУникальности,
	             |	РеквизитыКонтроляТек.ИзменениеБезСогласования КАК ИзменениеБезСогласования,
	             |	РеквизитыКонтроляТек.Имя КАК ИмяРеквизитаТек
	             |ИЗ
	             |	РеквизитыКонтроляТек КАК РеквизитыКонтроляТек
	             |		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеРеквизитов КАК СоответствиеРеквизитов
	             |		ПО РеквизитыКонтроляТек.Имя = СоответствиеРеквизитов.РеквизитОбъектаТек
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ЕСТЬNULL(СоответствиеТЧ.ТабличнаяЧастьВИБ, """") КАК ИмяТЧ,
	             |	СогласуемыеТЧТек.ОписаниеТЧИмя КАК ИмяТЧТек
	             |ИЗ
	             |	СогласуемыеТЧТек КАК СогласуемыеТЧТек
	             |		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеТЧ КАК СоответствиеТЧ
	             |		ПО СогласуемыеТЧТек.ОписаниеТЧИмя = СоответствиеТЧ.ТабличнаяЧастьТек
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СправочникиБД.Наименование КАК Наименование,
	             |	СправочникиБД.Синоним КАК Синоним,
	             |	СправочникиБД.ИерархическийСправочник КАК ИерархическийСправочник,
	             |	СправочникиБД.ВидИерархии КАК ВидИерархии
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	СправочникиБД.Ссылка = &ОбъектВИБ
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СправочникиБДВладельцы.Имя КАК Имя,
	             |	СправочникиБДВладельцы.ТипДанных КАК ТипДанных
	             |ИЗ
	             |	Справочник.СправочникиБД.Владельцы КАК СправочникиБДВладельцы
	             |ГДЕ
	             |	СправочникиБДВладельцы.Ссылка = &ОбъектВИБ";
	
	Запрос.УстановитьПараметр("ОбъектТек",ДанныеСоответствия.ОписаниеОбъектаТек);
	Запрос.УстановитьПараметр("ОбъектВИБ",ДанныеСоответствия.ОписаниеОбъектаВИБ);
	Запрос.УстановитьПараметр("НастройкаСоответствия",НастройкаСоответствия);
	
	Результат=Запрос.ВыполнитьПакет();
	СтруктураСправочника=Новый Структура;
	ДанныеСправочника=Результат[7].Выгрузить()[0];
	
	СтруктураСправочника=Новый Структура;
	СтруктураСправочника.Вставить("Наименование",				ДанныеСправочника.Наименование);
	СтруктураСправочника.Вставить("Синоним",					ДанныеСправочника.Синоним);
	СтруктураСправочника.Вставить("ИерархическийСправочник",	ДанныеСправочника.ИерархическийСправочник);
   	СтруктураСправочника.Вставить("ВидИерархии",				XMLСтрока(ДанныеСправочника.ВидИерархии));

	ТекТаблицаРеквизитов=Новый ТаблицаЗначений;
	ТекТаблицаРеквизитов.Колонки.Добавить("Имя",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(150));
	ТекТаблицаРеквизитов.Колонки.Добавить("Синоним",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255));
	ТекТаблицаРеквизитов.Колонки.Добавить("Использование",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255));
	ТекТаблицаРеквизитов.Колонки.Добавить("Обязательный",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТекТаблицаРеквизитов.Колонки.Добавить("КонтрольУникальности",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТекТаблицаРеквизитов.Колонки.Добавить("ИзменениеБезСогласования",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТекТаблицаРеквизитов.Колонки.Добавить("ИмяРеквизитаТек",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(150));
	
	ТаблицаРеквизитов=Результат[5].Выгрузить();
	
	ТекстОшибкиРеквизиты="";
	
	Для Каждого Строка ИЗ ТаблицаРеквизитов Цикл 
		
		Если НЕ ЗначениеЗаполнено(Строка.Имя) Тогда
			
			Если Строка.Обязательный ИЛИ Строка.КонтрольУникальности Тогда
				
				ТекстОшибкиРеквизиты=ТекстОшибкиРеквизиты+Символы.ПС+Строка.ИмяРеквизитаТек;
				
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
			
		НоваяСтрока=ТекТаблицаРеквизитов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка,,"Использование");
		НоваяСтрока.Использование=XMLСтрока(Строка.Использование);
		
	КонецЦикла;
	
	СтруктураСправочника.Вставить("Реквизиты",					ТекТаблицаРеквизитов);
	СтруктураСправочника.Вставить("СогласуемыеТЧ",				Результат[6].Выгрузить());
	СтруктураСправочника.Вставить("Владельцы",					Результат[8].Выгрузить());
	
	СтруктураСправочника.Вставить("ТипБД",						ДанныеСоответствия.Владелец);
	
	ТекстОшибкиТЧ="";
		
	Для Каждого Строка ИЗ СтруктураСправочника.СогласуемыеТЧ Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ИмяТЧ) Тогда
			
			ТекстОшибкиТЧ=ТекстОшибкиТЧ+Символы.ПС+Строка.ИмяТЧТек;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ (ПустаяСтрока(ТекстОшибкиРеквизиты) И ПустаяСтрока(ТекстОшибкиТЧ)) Тогда
		
		ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для объекта текущей ИБ %1 не найдено соответствие в объекте %2 типа ИБ %3'"),ДанныеСоответствия.ОписаниеОбъектаТек
		,ДанныеСоответствия.ОписаниеОбъектаВИБ,СтруктураСправочника.ТипБД);
		
		Если Не ПустаяСтрока(ТекстОшибкиРеквизиты) Тогда
			
			ТекстСообщения=ТекстСообщения+Символы.ПС+Нстр("ru = 'Контролируемые реквизиты:'")+ТекстОшибкиРеквизиты;
			
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОшибкиТЧ) Тогда
			
			ТекстСообщения=ТекстСообщения+Символы.ПС+Нстр("ru = 'Контролируемые табличные части:'")+ТекстОшибкиТЧ;
			
		КонецЕсли;
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Внимание);
		
	КонецЕсли;	
	
	Возврат СтруктураСправочника;
		
КонецФункции // ПодготовитьДанныеКонтроляНСИ() 

Процедура ВыгрузитьДанныеКонтроляНСИ(ОписаниеОбъектаТек=Неопределено,ПриЗаписиИзменений=Ложь,ВыполнитьВФоне=Истина,ИспользуемаяИБ=Неопределено) Экспорт

	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	             |	УстановкаПараметровКонтроляНСИ.НастройкаСоответствия КАК НастройкаСоответствия,
	             |	УстановкаПараметровКонтроляНСИ.ИспользуемаяИБ КАК ИспользуемаяИБ,
	             |	УстановкаПараметровКонтроляНСИ.ТипКонтроляНСИ КАК ТипКонтроляНСИ,
				 |	УстановкаПараметровКонтроляНСИ.СогласованиеСвязанныхОбъектов КАК СогласованиеСвязанныхОбъектов,
	             |	УстановкаПараметровКонтроляНСИ.ТипБД.ОбменДаннымиРегламентнымЗаданием КАК ОбменДаннымиРегламентнымЗаданием
	             |ИЗ
	             |	РегистрСведений.УстановкаПараметровКонтроляНСИ КАК УстановкаПараметровКонтроляНСИ
	             |ГДЕ
	             |	&Параметр1
	             |	И &Параметр2
				 |	И &Параметр3
	             |	И НЕ УстановкаПараметровКонтроляНСИ.ЗначениеУстановлено";
	
	Если ПриЗаписиИзменений Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","НЕ УстановкаПараметровКонтроляНСИ.ТипБД.ОбменДаннымиРегламентнымЗаданием");	
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","ИСТИНА");
		
	КонецЕсли;
	
	Если НЕ ОписаниеОбъектаТек=Неопределено Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр2","УстановкаПараметровКонтроляНСИ.ОписаниеОбъектаТек=&ОписаниеОбъектаТек");
		Запрос.УстановитьПараметр("ОписаниеОбъектаТек",ОписаниеОбъектаТек);
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр2","ИСТИНА");
		
	КонецЕсли;
	
	Если НЕ ИспользуемаяИБ=Неопределено Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр3","УстановкаПараметровКонтроляНСИ.ИспользуемаяИБ=&ИспользуемаяИБ");
		Запрос.УстановитьПараметр("ИспользуемаяИБ",ИспользуемаяИБ);
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр3","ИСТИНА");
		
	КонецЕсли;
	
	Запрос.Текст=ТекстЗапроса;
	
	ВыгрузитьНаборДанныхКонтроляНСИ(Запрос.Выполнить().Выгрузить(),ВыполнитьВФоне);
		
КонецПроцедуры // ВыгрузитьДанныеКонтроляНСИ() 

Процедура СоздатьНастройкиПравилКонтроляНСИ(ТипБД,НастройкаСоответствия=Неопределено,КонтролироватьНСИ=Истина) Экспорт

	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	             |	СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ КАК ОписаниеОбъектаВИБ,
	             |	СоответствиеВнешнимИБ.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	СоответствиеВнешнимИБ.Ссылка КАК НастройкаСоответствия,
	             |	СоответствиеВнешнимИБ.Владелец КАК ТипБД
	             |ПОМЕСТИТЬ НастройкиСоответствия
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	             |ГДЕ
	             |	СоответствиеВнешнимИБ.Владелец = &ТипБД
	             |	И &ПараметрНастройкаСоответствия
	             |	И СоответствиеВнешнимИБ.ОписаниеОбъектаТек ССЫЛКА Справочник.СправочникиБД
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СправочникиБД.Ссылка КАК ОписаниеОбъектаТек,
	             |	СправочникиБД.ТипКонтроляНСИ КАК ТипКонтроляНСИ,
	             |	СправочникиБД.ВидКонтроляНСИ КАК ВидКонтроляНСИ,
	             |	СправочникиБД.Синоним КАК Синоним,
	             |	СправочникиБД.ПоставщикПотребительНСИ КАК ПоставщикПотребительНСИ,
	             |	СправочникиБД.СогласованиеСвязанныхОбъектов КАК СогласованиеСвязанныхОбъектов
	             |ПОМЕСТИТЬ КонтролируемыеСправочники
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |	И НЕ СправочникиБД.ПометкаУдаления
	             |	И СправочникиБД.Контролируемый
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	НастройкиСоответствия.НастройкаСоответствия КАК НастройкаСоответствия,
	             |	КонтролируемыеСправочники.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	КонтролируемыеСправочники.ВидКонтроляНСИ КАК ВидКонтроляНСИ,
	             |	КонтролируемыеСправочники.СогласованиеСвязанныхОбъектов КАК СогласованиеСвязанныхОбъектов,
	             |	КонтролируемыеСправочники.Синоним КАК Синоним,
	             |	ВнешниеИнформационныеБазы.Ссылка КАК ИспользуемаяИБ
	             |ИЗ
	             |	НастройкиСоответствия КАК НастройкиСоответствия
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КонтролируемыеСправочники КАК КонтролируемыеСправочники
	             |		ПО НастройкиСоответствия.ОписаниеОбъектаТек = КонтролируемыеСправочники.ОписаниеОбъектаТек
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВнешниеИнформационныеБазы КАК ВнешниеИнформационныеБазы
	             |		ПО НастройкиСоответствия.ТипБД = ВнешниеИнформационныеБазы.ТипБД";
	
	Если НастройкаСоответствия=Неопределено Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрНастройкаСоответствия","ИСТИНА");
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрНастройкаСоответствия","СоответствиеВнешнимИБ.Ссылка = &НастройкаСоответствия");
		Запрос.УстановитьПараметр("НастройкаСоответствия",НастройкаСоответствия);
		
	КонецЕсли;
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("ТипБД",ТипБД);
	
	ОбменДаннымиРегламентнымЗаданием=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТипБД,"ОбменДаннымиРегламентнымЗаданием");
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НаборЗаписей=РегистрыСведений.УстановкаПараметровКонтроляНСИ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ОписаниеОбъектаТек.Установить(Результат.ОписаниеОбъектаТек);
		НаборЗаписей.Отбор.ТипБД.Установить(ТипБД);
		НаборЗаписей.Отбор.НастройкаСоответствия.Установить(Результат.НастройкаСоответствия);
		НаборЗаписей.Отбор.ИспользуемаяИБ.Установить(Результат.ИспользуемаяИБ);
		
		НоваяСтрока=НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
		НоваяСтрока.ТипБД=ТипБД;
		НоваяСтрока.ТипКонтроляНСИ=?(КонтролироватьНСИ,
					Справочники.СправочникиБД.ПолучитьТипКонтроляНСИ(Результат.ВидКонтроляНСИ,Перечисления.ПоставщикПотребительНСИ.ПоставщикПотребитель),
					Перечисления.ТипыКонтроляНСИ.НеКонтролируется);
					
		НоваяСтрока.ПоставщикПотребительНСИ=Перечисления.ПоставщикПотребительНСИ.ПоставщикПотребитель;
		
		НаборЗаписей.Записать(Истина);
		
		Если НЕ ОбменДаннымиРегламентнымЗаданием Тогда
			
			ВыгрузитьДанныеКонтроляНСИ(,Истина,Истина,Результат.ИспользуемаяИБ);
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // СоздатьНастройкиПравилКонтроляНСИ() 

Функция ПолучитьДанныеКонтроляНСИ(НастройкаСоответствия,КэшНастроекСоответствия)

	СтруктураСправочника=КэшНастроекСоответствия.Получить(НастройкаСоответствия);
	
	Если СтруктураСправочника=Неопределено Тогда
		
		СтруктураСправочника=ПодготовитьДанныеКонтроляНСИ(НастройкаСоответствия);
		
		КэшНастроекСоответствия.Вставить(НастройкаСоответствия,СтруктураСправочника);
		
	КонецЕсли;
	
	Возврат СтруктураСправочника; 	
	
КонецФункции // ПолучитьДанныеКонтроляНСИ() 

Процедура ВыгрузитьНаборДанныхКонтроляНСИ(ТаблицаДанныхКонтроля,ВыполнитьВФоне=Истина) Экспорт

	КэшНастроекСоответствия=Новый Соответствие;
	СтруктураИБ=ПолучитьДанныеПодключенияТекущаяИБ();
	
	Для Каждого Строка ИЗ ТаблицаДанныхКонтроля Цикл
		
		СтруктураСправочника=ПолучитьДанныеКонтроляНСИ(Строка.НастройкаСоответствия,КэшНастроекСоответствия);
		
		СтруктураСправочника.Вставить("ТипКонтроляНСИ",XMLСтрока(Строка.ТипКонтроляНСИ));
		СтруктураСправочника.Вставить("СогласованиеСвязанныхОбъектов",XMLСтрока(Строка.СогласованиеСвязанныхОбъектов));
		СтруктураСправочника.Вставить("Контролируемый",(НЕ Строка.ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.НеКонтролируется));
		
		СтруктураКонтроля=Новый Структура;
		СтруктураКонтроля.Вставить("СтруктураСправочника",СтруктураСправочника); 
		
		СтруктураИБ.Вставить("ОбменДаннымиРегламентнымЗаданием",Строка.ОбменДаннымиРегламентнымЗаданием);	
		СтруктураКонтроля.Вставить("СтруктураИБ",СтруктураИБ);  
		
		СтруктураКонтроля.Вставить("GUIDТекущейИБ",XMLСтрока(Строка.ИспользуемаяИБ));
		
		Если ВыполнитьВФоне Тогда
			
			ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Выгрузка правил контроля. Настройка сооответствия: %1, внешняя ИБ %2'"),Строка.НастройкаСоответствия,Строка.ИспользуемаяИБ);
			КлючЗадания=Новый УникальныйИдентификатор;
			
			ПараметрыЗадания=Новый Массив;
			ПараметрыЗадания.Добавить(Строка.ИспользуемаяИБ);
			ПараметрыЗадания.Добавить(СтруктураКонтроля);
			ПараметрыЗадания.Добавить(Строка.НастройкаСоответствия);
			
			ФоновыеЗадания.Выполнить("ОбменДаннымиНСИУХ.ВыгрузитьПравилаКонтроля",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
			
		Иначе
			
			ВыгрузитьПравилаКонтроля(Строка.ИспользуемаяИБ,СтруктураКонтроля,Строка.НастройкаСоответствия);
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ВыгрузитьНаборДанныхКонтроляНСИ() 

Функция ПолучитьДанныеПодключенияТекущаяИБ()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ВнешниеИнформационныеБазы.URIПространстваИмен КАК URIПространстваИмен,
	|	ВнешниеИнформационныеБазы.АутентификацияWindows КАК АутентификацияWindows,
	|	ВнешниеИнформационныеБазы.ИмяWebСервиса КАК ИмяWebСервиса,
	|	ВнешниеИнформационныеБазы.ИмяИБНаСервере КАК ИмяИБНаСервере,
	|	ВнешниеИнформационныеБазы.ИмяСервера КАК ИмяСервера,
	|	ВнешниеИнформационныеБазы.ИспользоватьWS КАК ИспользоватьWS,
	|	ВнешниеИнформационныеБазы.КаталогИБ КАК КаталогИБ,
	|	ВнешниеИнформационныеБазы.Пароль КАК Пароль,
	|	ВнешниеИнформационныеБазы.Пользователь КАК Пользователь,
	|	ВнешниеИнформационныеБазы.ПутьКWebСервису КАК ПутьКWebСервису,
	|	ВнешниеИнформационныеБазы.СтрокаПодключения КАК СтрокаПодключения,
	|	ВнешниеИнформационныеБазы.ТочкаПодключенияWebСервиса КАК ТочкаПодключенияWebСервиса,
	|	ВнешниеИнформационныеБазы.НаименованиеЦентрализованнойБазы КАК Наименование,
	|	ВнешниеИнформационныеБазы.РазмещениеВнешнейИБ КАК РазмещениеВнешнейИБ,
	|	ВнешниеИнформационныеБазы.КодИнформационнойСистемы КАК КодИнформационнойСистемы
	|ИЗ
	|	Справочник.ВнешниеИнформационныеБазы КАК ВнешниеИнформационныеБазы
	|ГДЕ
	|	ВнешниеИнформационныеБазы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ);
	
	ДанныеИБ=Запрос.Выполнить().Выгрузить()[0];
	
	СтруктураИБ=ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеИБ);
	СтруктураИБ.Вставить("РазмещениеВнешнейИБ",XMLСтрока(СтруктураИБ.РазмещениеВнешнейИБ));
	СтруктураИБ.Вставить("GUIDЦентрализованнойБазы",XMLСтрока(Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ));
	
	Возврат СтруктураИБ;
		
КонецФункции // ПолучитьДанныеПодключенияТекущаяИБ() 

Процедура ВыгрузитьПравилаКонтроля(ИспользуемаяИБ,СтруктураКонтроля,НастройкаСоответствия) Экспорт
	
	ТекСоединениеВИБ=ПодключениеКВИБУХ.ПолучитьСоединение(ИспользуемаяИБ, 1);
	
	Если ТекСоединениеВИБ=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	РезультатВыполнения=Истина;
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
		
		РезультатВыполнения= ТекСоединениеВИБ.SetUpControlParameters(Новый ХранилищеЗначения(СтруктураКонтроля, Новый СжатиеДанных(9))).Получить();
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
	
		РезультатВыполнения= РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"SetUpControlParameters",СтруктураКонтроля);
		
	Иначе
		
		РезультатВыполнения= РаботаСОбъектамиМетаданныхВнешнийУХ.SetUpControlParameters(ТекСоединениеВИБ,СтруктураКонтроля);
		
	КонецЕсли;
	
	Если РезультатВыполнения=Истина Тогда
		
		НаборЗаписей=РегистрыСведений.УстановкаПараметровКонтроляНСИ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИспользуемаяИБ.Установить(ИспользуемаяИБ);
		НаборЗаписей.Отбор.НастройкаСоответствия.Установить(НастройкаСоответствия);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей[0].ЗначениеУстановлено=Истина;
		НаборЗаписей.Записать();
		
	КонецЕсли;
				
КонецПроцедуры // ВыгрузитьПравилаКонтроля() 

Процедура ВыполнитьОбменДаннымиНСИЦентральнаяИБ()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ДанныеДляОбмена.ДочерняяБаза КАК ДочерняяБаза,
	|	СУММА(ДанныеДляОбмена.ВыгрузитьПравилаКонтроля) КАК ВыгрузитьПравилаКонтроля,
	|	СУММА(ДанныеДляОбмена.ЗагрузитьЗаявки) КАК ЗагрузитьЗаявки,
	|	СУММА(ДанныеДляОбмена.ВыгрузитьСтатусы) КАК ВыгрузитьСтатусы
	|ИЗ
	|	(ВЫБРАТЬ
	|		УстановкаПараметровКонтроляНСИ.ИспользуемаяИБ КАК ДочерняяБаза,
	|		1 КАК ВыгрузитьПравилаКонтроля,
	|		0 КАК ЗагрузитьЗаявки,
	|		0 КАК ВыгрузитьСтатусы
	|	ИЗ
	|		РегистрСведений.УстановкаПараметровКонтроляНСИ КАК УстановкаПараметровКонтроляНСИ
	|	ГДЕ
	|		НЕ УстановкаПараметровКонтроляНСИ.ЗначениеУстановлено
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза,
	|		0,
	|		1,
	|		0
	|	ИЗ
	|		РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	|	ГДЕ
	|		НЕ СоответствиеЗаявокНаИзменениеНСИ.ОбменВыполнен
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза,
	|		0,
	|		0,
	|		1
	|	ИЗ
	|		РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	|	ГДЕ
	|		СоответствиеЗаявокНаИзменениеНСИ.ТребуетсяПередачаСтатуса) КАК ДанныеДляОбмена
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляОбмена.ДочерняяБаза
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ДанныеДляОбмена.ВыгрузитьПравилаКонтроля) > 0
	|		ИЛИ СУММА(ДанныеДляОбмена.ЗагрузитьЗаявки) > 0
	|		ИЛИ СУММА(ДанныеДляОбмена.ВыгрузитьСтатусы) > 0)";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ПараметрыОбмена=Новый Структура;
		ПараметрыОбмена.Вставить("ВыгрузитьПравилаКонтроля",Результат.ВыгрузитьПравилаКонтроля>0);
		ПараметрыОбмена.Вставить("ЗагрузитьЗаявки",			Результат.ЗагрузитьЗаявки>0);
		ПараметрыОбмена.Вставить("ВыгрузитьСтатусы",		Результат.ВыгрузитьСтатусы>0);
		
		ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Обмен данными контроля НСИ, внешняя ИБ %1'"),Результат.ДочерняяБаза);
		КлючЗадания=Новый УникальныйИдентификатор;
		
		ПараметрыЗадания=Новый Массив;
		ПараметрыЗадания.Добавить(Результат.ДочерняяБаза);
		ПараметрыЗадания.Добавить(ПараметрыОбмена);
		
		ФоновыеЗадания.Выполнить("ОбменДаннымиНСИУХ.ВыполнитьОбменДаннымиНСИИнформационнаяБаза",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
			
	КонецЦикла;	
	
КонецПроцедуры // ВыполнитьОбменДаннымиНСИЦентральнаяИБ()

Процедура ВыполнитьОбменДаннымиНСИДочерняяИБ()

	УправлениеНСИ.ВыгрузитьСсылкиЗаявокНаИзменениеНСИ();
	
КонецПроцедуры // ВыполнитьОбменДаннымиНСИДочерняяИБ() 

Процедура ВыполнитьОбменДаннымиКонтроляНСИ() Экспорт
	
	Если Константы.ЭтоЦентрализованнаяБазаНСИ.Получить() Тогда
		
		ВыполнитьОбменДаннымиНСИЦентральнаяИБ();
		
	Иначе
		
		ВыполнитьОбменДаннымиНСИДочерняяИБ();
		
	КонецЕсли;
			
КонецПроцедуры // ВыполнитьОбменДаннымиНСИ()
	
Процедура ВыполнитьОбменДаннымиНСИИнформационнаяБаза(ИнформационнаяБаза,ПараметрыОбмена) Экспорт
	
	Если ПараметрыОбмена.ВыгрузитьПравилаКонтроля Тогда
		
		ВыгрузитьДанныеКонтроляНСИ(,,Ложь,ИнформационнаяБаза);
		
	КонецЕсли;
	
	Если ПараметрыОбмена.ЗагрузитьЗаявки Тогда
		
		ЗагрузитьЗаявкиДочернихКомпаний(ИнформационнаяБаза);
		
	КонецЕсли; 
	
	Если ПараметрыОбмена.ВыгрузитьСтатусы Тогда
		
		ВыгрузитьСтатусыЗаявокДочернихКомпаний(ИнформационнаяБаза);
		
	КонецЕсли;
	
	
КонецПроцедуры // ВыполнитьОбменДаннымиНСИИнформационнаяБаза()

Процедура ВыполнитьОбменНСИПоПараметрам(Ссылка=Неопределено) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПараметрыОбменаНСИ.Ссылка КАК Ссылка,
	|	ПараметрыОбменаНСИ.НаправлениеОбмена КАК НаправлениеОбмена,
	|	ПараметрыОбменаНСИ.ОписаниеОбъектаМетаданных КАК ОписаниеОбъектаМетаданных,
	|	ПараметрыОбменаНСИ.НастройкаОтбора КАК НастройкаОтбора,
	|	ПараметрыОбменаНСИ.ТолькоИзмененные КАК ТолькоИзмененные,
	|	ПараметрыОбменаНСИ.АдресацияОбменаНСИ.(
	|		АдресОбмена КАК АдресОбмена,
	|		Отбор КАК Отбор
	|	) КАК АдресацияОбменаНСИ,
	|	ПараметрыОбменаНСИ.СпособВыбораИБ КАК СпособВыбораИБ
	|ИЗ
	|	Справочник.ПараметрыОбменаНСИ КАК ПараметрыОбменаНСИ
	|ГДЕ";
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ПараметрыОбменаНСИ.Ссылка=&Ссылка";
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+"
		|	ПараметрыОбменаНСИ.СпособЗапуска=ЗНАЧЕНИЕ(Перечисление.СпособыЗапускаОбменаНСИ.РегламентноеЗадание)
		|	И НЕ ПараметрыОбменаНСИ.Отключен
		|	И НЕ ПараметрыОбменаНСИ.ПометкаУдаления";
		
	КонецЕсли;
					
	ТаблицаОбмена=Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка ИЗ ТаблицаОбмена Цикл
		
		Если ЗначениеЗаполнено(Ссылка) Тогда
			
			ВыполнитьОбменНСИ(Строка);
			
		Иначе
			
			ПараметрыОбмена=ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Строка);
			
			ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Обмен элементами НСИ по настройке %1'"),Строка.Ссылка);
			КлючЗадания=Новый УникальныйИдентификатор;
			
			ПараметрыЗадания=Новый Массив;
			ПараметрыЗадания.Добавить(ПараметрыОбмена);
			
			ФоновыеЗадания.Выполнить("ОбменДаннымиНСИУХ.ВыполнитьОбменНСИ",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
			
		КонецЕсли;
		
	КонецЦикла;	
			
КонецПроцедуры // ВыполнитьОбменПоПараметрам() 

Процедура ВыполнитьОбменНСИ(ПараметрыОбмена) Экспорт

	ПротоколируемыеСобытияУХ.Начать(ПараметрыОбмена.Ссылка);
	
	Если ПараметрыОбмена.НаправлениеОбмена=Перечисления.ВыгрузкаЗагрузка.Выгрузка Тогда
		
		ТаблицаПараметров=Справочники.ПараметрыОбменаНСИ.ПолучитьПараметрыВыгрузкиНСИ(ПараметрыОбмена);
		
		ОбработкаОбмена=Обработки.ОбменНСИ.Создать();
		
		Для Каждого Строка ИЗ ТаблицаПараметров Цикл
			
			НоваяСтрока=ОбработкаОбмена.ПараметрыЭкспортаНСИ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			НоваяСтрока.НастройкаОтбора=ПараметрыОбмена.НастройкаОтбора;
			НоваяСтрока.ТолькоИзмененные=ПараметрыОбмена.ТолькоИзмененные;
			
		КонецЦикла;
		
		ОбработкаОбмена.ВыполнитьВыгрузкуДанных();
			
	Иначе
		
		ТаблицаПараметров=Справочники.ПараметрыОбменаНСИ.ПолучитьПараметрыЗагрузкиНСИ(ПараметрыОбмена);
		
		ОбработкаОбмена=Обработки.ОбменНСИ.Создать();
		
		Для Каждого Строка ИЗ ТаблицаПараметров Цикл
			
			НоваяСтрока=ОбработкаОбмена.ПараметрыИмпортаНСИ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
		КонецЦикла;
		
		ОбработкаОбмена.ВыполнитьЗагрузкуДанных();
		
	КонецЕсли;
	
	ПротоколОшибок=ПротоколируемыеСобытияУХ.Завершить(Нстр("ru = 'Обмен НСИ'"),,ПараметрыОбмена.Ссылка);		
	ПротоколируемыеСобытияУХ.ЗаписатьПротоколВРегистр(ПараметрыОбмена.Ссылка);				

КонецПроцедуры  // ВыполнитьОбменНСИ()

Процедура ОбработатьОбъектыПоПравилам(НастройкиОбработки) Экспорт
	
	ПериодОбработки=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ТекущаяУниверсальнаяДата(),Перечисления.Периодичность.День,0);
	
	Для Каждого СтрокаНастройка ИЗ НастройкиОбработки Цикл
		
		СтруктураПоискаСеанса = Новый Структура;
		СтруктураПоискаСеанса.Вставить("ИспользуемаяИБ",		СтрокаНастройка.ИспользуемаяИБ);
		СтруктураПоискаСеанса.Вставить("ПравилоЗаполнения",		СтрокаНастройка.ПравилоЗаполнения);
		СтруктураПоискаСеанса.Вставить("ОбъектБД",				СтрокаНастройка.ОбъектБД);
		СтруктураПоискаСеанса.Вставить("Организация",			СтрокаНастройка.Организация);
		СтруктураПоискаСеанса.Вставить("Сценарий",				СтрокаНастройка.Сценарий);
		СтруктураПоискаСеанса.Вставить("ОбластьГенерации",		СтрокаНастройка.ОбластьГенерации);
		СтруктураПоискаСеанса.Вставить("ПериодОтчета",			ПериодОбработки);
			
		СтруктураЗаписи = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураПоискаСеанса);
		СтруктураЗаписи.Вставить("СеансОбменаДанными",		Справочники.СеансыОбменаДанными.НайтиСоздатьСеансОбменаДанными(СтруктураПоискаСеанса));
		СтруктураЗаписи.Вставить("ПроводитьДокументы",		СтрокаНастройка.ПроводитьДокументы);
		
		ОбработкаОбъект=Обработки.ГенерацияОбъектовБД.Создать();
		ЗаполнитьЗначенияСвойств(ОбработкаОбъект,СтруктураЗаписи);
		ОбработкаОбъект.ОбработатьОбъектыБД();
		
	КонецЦикла;
	
КонецПроцедуры // ОбработатьОбъектыПоПравилам()

 