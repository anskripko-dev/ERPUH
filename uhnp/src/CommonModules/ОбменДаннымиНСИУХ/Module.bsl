 

Функция ВозможнаНастройкаСоответствия(ЗначениеПоля) Экспорт
	
	ТипЗначенияПоля=ТипЗнч(ЗначениеПоля);
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначенияПоля)
			ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначенияПоля)
			ИЛИ Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначенияПоля)
			Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначенияПоля);
	
КонецФункции // ВозможнаНастройкаСоответствия() 	

Процедура ЗагрузитьЗаявкиДочернихКомпаний(ДочерняяБаза=Неопределено) Экспорт
	
	Запрос=Новый Запрос;
	
	ТекстЗапроса="ВЫБРАТЬ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза КАК ЗаявкаДочерняяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза КАК ДочерняяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаРодитель КАК ЗаявкаРодитель
	             |ПОМЕСТИТЬ ЗаявкиКОбработке
	             |ИЗ
	             |	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	             |ГДЕ
	             |	НЕ СоответствиеЗаявокНаИзменениеНСИ.ОбменВыполнен
	             |	И &Параметр1
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ЗаявкиКОбработке.ДочерняяБаза КАК ДочерняяБаза
	             |ИЗ
	             |	ЗаявкиКОбработке КАК ЗаявкиКОбработке
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ЗаявкиКОбработке.ДочерняяБаза КАК ДочерняяБаза,
	             |	ЗаявкиКОбработке.ЗаявкаДочерняяБаза КАК ЗаявкаДочерняяБаза,
				 |	ЗаявкиКОбработке.ЗаявкаРодитель КАК ЗаявкаРодитель
	             |ИЗ
	             |	ЗаявкиКОбработке КАК ЗаявкиКОбработке";
	
	Если ЗначениеЗаполнено(ДочерняяБаза) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза=&ДочерняяБаза");
		Запрос.УстановитьПараметр("ДочерняяБаза",ДочерняяБаза);
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр1","ИСТИНА");
		
	КонецЕсли; 
	
	Запрос.Текст=ТекстЗапроса;
	
	Результат=Запрос.ВыполнитьПакет();
	
	ТабАдресации=Результат[1].Выгрузить();
	ТабЗаявок=Результат[2].Выгрузить(); 
	
	Для Каждого Строка ИЗ ТабАдресации Цикл
		
		ЕстьОшибки=Ложь;
		
		ТаблицаОбмена=ТабЗаявок.Скопировать(Новый Структура("ДочерняяБаза",Строка.ДочерняяБаза));
		
		ДанныеЗаявок=ПолучитьДанныеЗаявок(Строка.ДочерняяБаза,ТаблицаОбмена);
		
		Если ОбработатьДанныеЗаявок(Строка.ДочерняяБаза,ДанныеЗаявок,ЕстьОшибки) Тогда
					
			ОтметитьОбменВыполнен(ТаблицаОбмена);
			
		КонецЕсли;
		
		Если ЕстьОшибки Тогда
			
			ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Выгрузка ошибок загрузки заявок на изменение НСИ, внешняя ИБ %1'"),Строка.ДочерняяБаза);
			КлючЗадания=Новый УникальныйИдентификатор;
			
			ПараметрыЗадания=Новый Массив;
			ПараметрыЗадания.Добавить(Строка.ДочерняяБаза);
			
			ФоновыеЗадания.Выполнить("ОбменДаннымиНСИУХ.ВыгрузитьОшибкиЗагрузкиЗаявокДочернихКомпаний",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
			
		КонецЕсли;	
			
	КонецЦикла;
	
	
КонецПроцедуры // ЗагрузитьЗаявкиДочернихКомпаний()

Функция ПолучитьРабочуюТаблицуПоДаннымПереноса(ДочерняяБаза,ДанныеДляПереноса,РабочаяТаблица=Неопределено,Организация=Неопределено) Экспорт
	
	Перем ТолькоПроверка;
	
	ДанныеДляПереноса.Свойство("ТолькоПроверка",ТолькоПроверка);
	
	Если ДанныеДляПереноса.Свойство("ПодготовитьДляПомещенияВЗапрос") И РабочаяТаблица=Неопределено Тогда
		
		РабочаяТаблица=ИнтеграцияСВнешнимиСистемамиУХ.ПолучитьРабочуюТаблицуДляЗапроса(ДанныеДляПереноса.ТаблицаПереноса);
		
	КонецЕсли;
	
	Если ДанныеДляПереноса.ТаблицаЗначенийПолей.Количество()=0 Тогда
		
		Если РабочаяТаблица=Неопределено  Тогда
			
			Возврат ДанныеДляПереноса.ТаблицаПереноса; 
			
		Иначе
			
			ОбщегоНазначенияУХ.ЗагрузитьВТаблицуЗначений(ДанныеДляПереноса.ТаблицаПереноса,РабочаяТаблица);
			Возврат РабочаяТаблица;
			
		КонецЕсли;
		
	Иначе
		
		СоответствиеСсылок=ПолучитьСоответствиеСсылок(ДочерняяБаза,ДанныеДляПереноса.ТаблицаЗначенийПолей,Организация,ТолькоПроверка=Истина); 
		
		Возврат ПолучитьРабочуюТаблицу(ДанныеДляПереноса.ТаблицаПереноса,СоответствиеСсылок,РабочаяТаблица);
		
	КонецЕсли;
		
КонецФункции // ПолучитьРабочуюТаблицуПоДаннымПереноса() 

Функция ОбработатьДанныеЗаявок(ДочерняяБаза,ДанныеЗаявок,ЕстьОшибки)
	
	ТаблицаЗначенийПолей=ДанныеЗаявок.Шапка.ТаблицаЗначенийПолей;
	
	ОбщегоНазначенияУХ.ЗагрузитьВТаблицуЗначений(ДанныеЗаявок.ИзменениеРеквизитов.ТаблицаЗначенийПолей,ТаблицаЗначенийПолей);
	
	Для Каждого Строка ИЗ ДанныеЗаявок.ИзменениеТЧ Цикл
		
		ОбщегоНазначенияУХ.ЗагрузитьВТаблицуЗначений(Строка.НовоеЗначение.ТаблицаЗначенийПолей,ТаблицаЗначенийПолей);
		
	КонецЦикла;
	
	ТаблицаЗначенийПолей.Свернуть("GUID,ТаблицаАналитикиВИБ,ПредставлениеGUID");
	
	СоответствиеСсылок=ПолучитьСоответствиеСсылок(ДочерняяБаза,ТаблицаЗначенийПолей,Неопределено);
	
	ДанныеДокументов=Новый Структура;
	ДанныеДокументов.Вставить("Шапка",ПолучитьРабочуюТаблицу(ДанныеЗаявок.Шапка.ТаблицаПереноса,СоответствиеСсылок));
	ДанныеДокументов.Шапка.Колонки.Добавить("ЗаявкаЦентральнаяБаза"); 
	ДанныеДокументов.Шапка.Сортировать("ЕстьРодитель Убыв, Номер Убыв");
	
	ДанныеДокументов.Вставить("ИзменениеРеквизитов",ПолучитьРабочуюТаблицу(ДанныеЗаявок.ИзменениеРеквизитов.ТаблицаПереноса,СоответствиеСсылок));
	
	ИзменениеТЧ=Новый ТаблицаЗначений;		
	ИзменениеТЧ.Колонки.Добавить("НаименованиеТЧ");
	ИзменениеТЧ.Колонки.Добавить("НовоеЗначение");
	ИзменениеТЧ.Колонки.Добавить("Ссылка");
	
	Для Каждого Строка ИЗ ДанныеЗаявок.ИзменениеТЧ Цикл
		
		НоваяСтрока=ИзменениеТЧ.Добавить();
		
		НоваяСтрока.НаименованиеТЧ	= Строка.НаименованиеТЧ;
		НоваяСтрока.Ссылка			= Строка.Ссылка;
		НоваяСтрока.НовоеЗначение	= ПолучитьРабочуюТаблицу(Строка.НовоеЗначение.ТаблицаПереноса,СоответствиеСсылок);
		
	КонецЦикла;

	ДанныеДокументов.Вставить("ИзменениеТЧ",ИзменениеТЧ);
	
	ОбработатьДанныеЗаявокНаИзменениеНСИ(ДанныеДокументов,ДочерняяБаза,ЕстьОшибки);
	
	Возврат Истина;
	
КонецФункции // ОбработатьДанныеЗаявок() 

Функция ПолучитьОписаниеОбъектаТек(ДочерняяБаза,ТипОбъектаВИБ,ИмяОбъектаВИБ)
	
	ТипБД=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДочерняяБаза,"ТипБД");
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СоответствиеВнешнимИБ.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек
	|ИЗ
	|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	|ГДЕ
	|	СоответствиеВнешнимИБ.Владелец = &ТипБД
	|	И НЕ СоответствиеВнешнимИБ.НеИспользоватьПриИмпорте
	|	И СоответствиеВнешнимИБ.ТаблицаАналитикиВИБ = &ТаблицаАналитикиВИБ"; 
	
	Запрос.УстановитьПараметр("ТипБД",ТипБД);
	Запрос.УстановитьПараметр("ТаблицаАналитикиВИБ",?(ПустаяСтрока(ТипОбъектаВИБ),"Справочник",ТипОбъектаВИБ)+"."+ИмяОбъектаВИБ);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Возврат Результат.ОписаниеОбъектаТек;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ПолучитьОписаниеОбъектаТек()

Процедура ЗаписатьИнформациюОшибкиЗагрузки(ТекстОшибки,СтрокаЗаявка,НаборЗаписей,ЕстьОшибки)
	
	СтрокаЗаявка.ИнформацияОбОшибке=ТекстОшибки;
	СтрокаЗаявка.ОбменВыполнен=Истина;
	СтрокаЗаявка.ЕстьОшибкиОбмена=Истина;
	СтрокаЗаявка.ТребуетсяПередачаСтатуса=Истина;
	ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрокаЗаявка.ИнформацияОбОшибке,,,СтатусСообщения.Важное);
	НаборЗаписей.Записать(); 
	
	ЕстьОшибки=Истина;
	
КонецПроцедуры // ЗаписатьИнформациюОшибкиЗагрузки()

Процедура ОбработатьДанныеЗаявокНаИзменениеНСИ(ДанныеДокументов,ДочерняяБаза,ЕстьОшибки)
	
	Для Каждого СтрокаШапка ИЗ ДанныеДокументов.Шапка Цикл 
		
		НаборЗаписей=РегистрыСведений.СоответствиеЗаявокНаИзменениеНСИ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДочерняяБаза.Установить(ДочерняяБаза);
		НаборЗаписей.Отбор.ЗаявкаДочерняяБаза.Установить(СтрокаШапка.Ссылка);
		
		НаборЗаписей.Прочитать();
		СтрокаЗаявка=НаборЗаписей[0];
		
		ПринятьКОбработке=НЕ СтрокаШапка.ЕстьРодитель; 
		ТаблицаАналитики=СтрокаШапка.ТипОбъектаКонсолидации+"."+СтрокаШапка.ИмяОбъектаМетаданных;
        ТекстПредставления=Нстр("ru = 'Заявка с видом операции %1 №%2 от %3, внешняя информационная база %4, объект %5'");
		ПредставлениеЗаявки=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПредставления,
					СтрокаШапка.ВидОперации,СтрокаШапка.Номер,СтрокаШапка.Дата,ДочерняяБаза,ТаблицаАналитики);

			
		Если ЗначениеЗаполнено(СтрокаЗаявка.ЗаявкаЦентральнаяБаза) Тогда
			
			Если СтрокаЗаявка.Состояние=Перечисления.СостоянияСогласования.НаУтверждении
				Или СтрокаЗаявка.Состояние=Перечисления.СостоянияСогласования.Утверждена Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ДокументОбъект=СтрокаЗаявка.ЗаявкаЦентральнаяБаза.ПолучитьОбъект();
			
		Иначе
			
			СправочникБД=ПолучитьОписаниеОбъектаТек(ДочерняяБаза,СтрокаШапка.ТипОбъектаКонсолидации,СтрокаШапка.ИмяОбъектаМетаданных);
			
			Если СправочникБД=Неопределено Тогда
								
				ТекстОшибки=Нстр("ru = ' не найдена настройка соответствия для объекта %1 внешней информационной базы %2'");
				
				ЗаписатьИнформациюОшибкиЗагрузки(ПредставлениеЗаявки+": "+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТаблицаАналитики,ДочерняяБаза),
						СтрокаЗаявка,НаборЗаписей,ЕстьОшибки);
				Продолжить;
				
			КонецЕсли;
			
			ДокументОбъект=Документы.ЗаявкаНаИзменениеНСИ.СоздатьДокумент();
			ДокументОбъект.СправочникБД=СправочникБД;
			ДокументОбъект.ДочерняяБаза=ДочерняяБаза;
			ДокументОбъект.Дата=СтрокаШапка.Дата;
			ДокументОбъект.УстановитьНовыйНомер();
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект,СтрокаШапка,,"Ссылка,Номер");
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.ИзменяемыйОбъект) Тогда
			
			ТекстОшибки=ПредставлениеЗаявки+Нстр("ru = ': не удалось определить изменяемый объект.'");
			ЗаписатьИнформациюОшибкиЗагрузки(ТекстОшибки,СтрокаЗаявка,НаборЗаписей,ЕстьОшибки);
			Продолжить;
			
		КонецЕсли;			
		
		ДокументОбъект.ИзменениеРеквизитов.Очистить();
		ДокументОбъект.ИзменениеТЧ.Очистить();
		
		МассивРеквизиты=ДанныеДокументов.ИзменениеРеквизитов.НайтиСтроки(Новый Структура("Ссылка",СтрокаШапка.Ссылка));
		
		Для Каждого СтрокаРеквизит ИЗ МассивРеквизиты Цикл
			
			НоваяСтрока=ДокументОбъект.ИзменениеРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаРеквизит);
			
		КонецЦикла;  
		
		МассивТЧ=ДанныеДокументов.ИзменениеТЧ.НайтиСтроки(Новый Структура("Ссылка",СтрокаШапка.Ссылка));
		
		ЕстьОписанияТЧ=Истина;
		
		Для Каждого СтрокаТЧ ИЗ МассивТЧ Цикл
			
			ТабличнаяЧасть=ПолучитьОписаниеТабличнойЧастиБД(ДокументОбъект.СправочникБД,СтрокаТЧ.НаименованиеТЧ);
			
			Если ТабличнаяЧасть=Неопределено Тогда
				
				ЕстьОписанияТЧ=Ложь;
				Прервать;
				
			КонецЕсли;
			
			НоваяСтрока=ДокументОбъект.ИзменениеТЧ.Добавить();
			НоваяСтрока.ТабличнаяЧасть=ТабличнаяЧасть;
			НоваяСтрока.НовоеЗначение=Новый ХранилищеЗначения(СтрокаТЧ.НовоеЗначение);
			
		КонецЦикла; 
		
		Если НЕ ЕстьОписанияТЧ Тогда
			
			ТекстОшибки=Нстр("ru = ' не удалось получить описание изменений табличной части %1'");
			ЗаписатьИнформациюОшибкиЗагрузки(ПредставлениеЗаявки+": "+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрокаТЧ.НаименованиеТЧ),
					СтрокаЗаявка,НаборЗаписей,ЕстьОшибки);
			Продолжить;
			
		КонецЕсли;
		
		ТаблицаСвязанныхЗаявок=ПолучитьТаблицуСвязанныхЗаявок(СтрокаШапка.Ссылка); 
		
		Если ТаблицаСвязанныхЗаявок.Количество()>0 Тогда
			
			ЗаявкиЗагружены=Истина;
			ТекстСообщения=ПредставлениеЗаявки+Нстр("ru = ': не загружены связанные заявки'");
			
			Для Каждого СвязаннаяЗаявка ИЗ ТаблицаСвязанныхЗаявок Цикл
				
				Если СвязаннаяЗаявка.ЗаявкаЦентральнаяБаза=Неопределено Тогда
					
					ТекстОшибки=Нстр("ru = '№%1 от %2'");
					ТекстСообщения=ТекстСообщения+Символы.ПС+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СвязаннаяЗаявка.Номер,СвязаннаяЗаявка.Дата);
					ЗаявкиЗагружены=Ложь;
					
				ИначеЕсли ДокументОбъект.ЗаявкиНаИзменениеСвязанныхОбъектов.Найти(СвязаннаяЗаявка.ЗаявкаЦентральнаяБаза,"ЗаявкаНаСвязанныйОбъект")=Неопределено Тогда
					
					НоваяСтрока=ДокументОбъект.ЗаявкиНаИзменениеСвязанныхОбъектов.Добавить();
					НоваяСтрока.ЗаявкаНаСвязанныйОбъект=СвязаннаяЗаявка.ЗаявкаЦентральнаяБаза;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗаявкиЗагружены Тогда
				
				ЗаписатьИнформациюОшибкиЗагрузки(ТекстСообщения,СтрокаЗаявка,НаборЗаписей,ЕстьОшибки);
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Попытка
			
			ДокументОбъект.Записать();
						
			СтрокаЗаявка.ЗаявкаЦентральнаяБаза=ДокументОбъект.Ссылка;
			СтрокаЗаявка.ОбменВыполнен=Истина;
			СтрокаЗаявка.ЕстьОшибкиОбмена=Ложь;
			СтрокаЗаявка.ИнформацияОбОшибке="";
			СтрокаЗаявка.ТребуетсяПередачаСтатуса=Ложь;
			НаборЗаписей.Записать();
			
			СтрокаШапка.ЗаявкаЦентральнаяБаза=СтрокаЗаявка.ЗаявкаЦентральнаяБаза;
			
		Исключение
			
			ЗаписатьИнформациюОшибкиЗагрузки(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),СтрокаЗаявка,НаборЗаписей,ЕстьОшибки);
			Продолжить;
			
		КонецПопытки; 
		
		Если ПринятьКОбработке Тогда 
			
			Если ДокументОбъект.ЗаявкиНаИзменениеСвязанныхОбъектов.Количество()=0 Тогда
				
				МодульУправленияПроцессамиУХ.ПринятьКОбработке(,ДокументОбъект.Ссылка);
				
			Иначе
				
				СпособСогласования=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.СправочникБД,"СогласованиеСвязанныхОбъектов");
				
				Если СпособСогласования=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьСинхронно Тогда
					
					МодульУправленияПроцессамиУХ.ПринятьКОбработке(,ДокументОбъект.Ссылка);
					
				Иначе
					
					Для Каждого СтрокаЗаявка ИЗ ДокументОбъект.ЗаявкиНаИзменениеСвязанныхОбъектов Цикл
						МодульУправленияПроцессамиУХ.ПринятьКОбработке(,СтрокаЗаявка.ЗаявкаНаСвязанныйОбъект);
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
		
КонецПроцедуры // ОбработатьДанныеЗаявокНаИзменениеНСИ()

Функция ПолучитьТаблицуСвязанныхЗаявок(ЗаявкаРодитель)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаЦентральнаяБаза КАК ЗаявкаЦентральнаяБаза,
	|	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБазаНомер КАК Номер,
	|	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБазаДата КАК Дата
	|ИЗ
	|	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	|ГДЕ
	|	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаРодитель = &ЗаявкаРодитель";
	
	Запрос.УстановитьПараметр("ЗаявкаРодитель",ЗаявкаРодитель);
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции // ПолучитьМассивСвязанныхЗаявок() 


Функция ПолучитьОписаниеТабличнойЧастиБД(Владелец,НаименованиеТЧ)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ТабличныеЧастиБД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТабличныеЧастиБД КАК ТабличныеЧастиБД
	|ГДЕ
	|	ТабличныеЧастиБД.Владелец = &Владелец
	|	И ТабличныеЧастиБД.Имя = &Наименование";
	
	Запрос.УстановитьПараметр("Владелец",Владелец);
	Запрос.УстановитьПараметр("Наименование",НаименованиеТЧ);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Возврат Результат.Ссылка;
		
	Иначе
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для объекта %1 не найдена табличная часть %2'"),Владелец,НаименованиеТЧ),,,СтатусСообщения.Важное);
        Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции // ПолучитьОписаниеТабличнойЧастиБД() 
 

Функция ПолучитьРабочуюТаблицу(ИсходнаяТаблица,СоответствиеСсылок,РабочаяТаблица=Неопределено)
	
	Если РабочаяТаблица=Неопределено Тогда
		
		РабочаяТаблица=ИсходнаяТаблица.СкопироватьКолонки();
		
	КонецЕсли;
	
	КоличествоКолонок=ИсходнаяТаблица.Колонки.Количество();
	
	Для Каждого Строка ИЗ ИсходнаяТаблица Цикл
		
		НоваяСтрока=РабочаяТаблица.Добавить();
		
		Для Индекс=0 ПО КоличествоКолонок-1 Цикл
			
			ИсходноеЗначение=Строка[Индекс];
			
			Если ТипЗнч(ИсходноеЗначение)=Тип("Строка") И СтрНайти(ИсходноеЗначение,"_tt_")>0 Тогда
				
				НоваяСтрока[Индекс]=СоответствиеСсылок.Получить(ИсходноеЗначение);
				
			Иначе
				
				НоваяСтрока[Индекс]=ИсходноеЗначение;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
	Возврат РабочаяТаблица;
					
КонецФункции // ПолучитьРабочуюТаблицу()

Функция ПолучитьЗапросПоТаблицамВИБ(УзелИнформационнойБазы)
	
	Запрос=Новый Запрос;
	
	Если НЕ ЗначениеЗаполнено(УзелИнформационнойБазы) Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		|	ТаблицаЗначенийПолей.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТаблицаЗначенийПолей.GUID КАК GUID,
		|	ТаблицаЗначенийПолей.ПредставлениеGUID КАК ПредставлениеGUID
		|ПОМЕСТИТЬ ТаблицаЗначенийПолей
		|ИЗ
		|	&ТаблицаЗначенийПолей КАК ТаблицаЗначенийПолей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеВнешнимИБ.Ссылка КАК НастройкаСоответствия,
		|	СоответствиеВнешнимИБ.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	СоответствиеВнешнимИБ.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
		|	СоответствиеВнешнимИБ.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ПОМЕСТИТЬ НастройкиСоответствия
		|ИЗ
		|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
		|ГДЕ
		|	СоответствиеВнешнимИБ.Владелец = &ТипБД
		|	И НЕ СоответствиеВнешнимИБ.НеИспользоватьПриИмпорте
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаЗначенийПолей.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТаблицаЗначенийПолей.GUID КАК GUID,
		|	ТаблицаЗначенийПолей.ПредставлениеGUID КАК ПредставлениеGUID,
		|	ЕСТЬNULL(НастройкиСоответствия.НастройкаСоответствия, НЕОПРЕДЕЛЕНО) КАК НастройкаСоответствия,
		|	ЕСТЬNULL(НастройкиСоответствия.СинхронизацияПоGUID, ЛОЖЬ) КАК СинхронизацияПоGUID,
		|	НастройкиСоответствия.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ПОМЕСТИТЬ ТабУстановленныеСоответствия
		|ИЗ
		|	ТаблицаЗначенийПолей КАК ТаблицаЗначенийПолей
		|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиСоответствия КАК НастройкиСоответствия
		|		ПО ТаблицаЗначенийПолей.ТаблицаАналитикиВИБ = НастройкиСоответствия.ТаблицаАналитикиВИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеОбъектовТекущейИВнешнихИБ.ОбъектТекущейИБ КАК ОбъектТекущейИБ,
		|	СоответствиеОбъектовТекущейИВнешнихИБ.ОбъектВнешнейИБ КАК ОбъектВнешнейИБ,
		|	СоответствиеОбъектовТекущейИВнешнихИБ.НастройкаСоответствия КАК НастройкаСоответствия
		|ПОМЕСТИТЬ СоответствиеОбъектов
		|ИЗ
		|	РегистрСведений.СоответствиеОбъектовТекущейИВнешнихИБ КАК СоответствиеОбъектовТекущейИВнешнихИБ
		|ГДЕ
		|	СоответствиеОбъектовТекущейИВнешнихИБ.ИспользуемаяИБ = &ИспользуемаяИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТабУстановленныеСоответствия.GUID КАК GUID,
		|	ТабУстановленныеСоответствия.ПредставлениеGUID КАК ПредставлениеGUID,
		|	ТабУстановленныеСоответствия.НастройкаСоответствия КАК НастройкаСоответствия,
		|	ТабУстановленныеСоответствия.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
		|	ЕСТЬNULL(СоответствиеОбъектов.ОбъектТекущейИБ, НЕОПРЕДЕЛЕНО) КАК ОбъектТекущейИБ,
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ИЗ
		|	ТабУстановленныеСоответствия КАК ТабУстановленныеСоответствия
		|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеОбъектов КАК СоответствиеОбъектов
		|		ПО ТабУстановленныеСоответствия.НастройкаСоответствия = СоответствиеОбъектов.НастройкаСоответствия
		|			И ТабУстановленныеСоответствия.GUID = СоответствиеОбъектов.ОбъектВнешнейИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТабУстановленныеСоответствия.НастройкаСоответствия КАК НастройкаСоответствия,
		|	ТабУстановленныеСоответствия.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ИЗ
		|	ТабУстановленныеСоответствия КАК ТабУстановленныеСоответствия";
		
	Иначе 
		
		Запрос.Текст="ВЫБРАТЬ
		|	ТаблицаЗначенийПолей.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТаблицаЗначенийПолей.GUID КАК GUID,
		|	ТаблицаЗначенийПолей.ПредставлениеGUID КАК ПредставлениеGUID
		|ПОМЕСТИТЬ ТаблицаЗначенийПолей
		|ИЗ
		|	&ТаблицаЗначенийПолей КАК ТаблицаЗначенийПолей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеВнешнимИБ.Ссылка КАК НастройкаСоответствия,
		|	СоответствиеВнешнимИБ.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	СоответствиеВнешнимИБ.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
		|	СоответствиеВнешнимИБ.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ПОМЕСТИТЬ НастройкиСоответствия
		|ИЗ
		|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
		|ГДЕ
		|	СоответствиеВнешнимИБ.Владелец = &ТипБД
		|	И НЕ СоответствиеВнешнимИБ.НеИспользоватьПриИмпорте
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаЗначенийПолей.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТаблицаЗначенийПолей.GUID КАК GUID,
		|	ТаблицаЗначенийПолей.ПредставлениеGUID КАК ПредставлениеGUID,
		|	ЕСТЬNULL(НастройкиСоответствия.НастройкаСоответствия, ЗНАЧЕНИЕ(Справочник.СоответствиеВнешнимИБ.ПустаяСсылка)) КАК НастройкаСоответствия,
		|	ЕСТЬNULL(НастройкиСоответствия.СинхронизацияПоGUID, ЛОЖЬ) КАК СинхронизацияПоGUID,
		|	НастройкиСоответствия.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ПОМЕСТИТЬ ТабУстановленныеСоответствия
		|ИЗ
		|	ТаблицаЗначенийПолей КАК ТаблицаЗначенийПолей
		|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиСоответствия КАК НастройкиСоответствия
		|		ПО ТаблицаЗначенийПолей.ТаблицаАналитикиВИБ = НастройкиСоответствия.ТаблицаАналитикиВИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеОбъектовТекущейИВнешнихИБ.ОбъектТекущейИБ КАК ОбъектТекущейИБ,
		|	СоответствиеОбъектовТекущейИВнешнихИБ.ОбъектВнешнейИБ КАК ОбъектВнешнейИБ,
		|	СоответствиеОбъектовТекущейИВнешнихИБ.НастройкаСоответствия КАК НастройкаСоответствия
		|ПОМЕСТИТЬ СоответствиеОбъектов
		|ИЗ
		|	РегистрСведений.СоответствиеОбъектовТекущейИВнешнихИБ КАК СоответствиеОбъектовТекущейИВнешнихИБ
		|ГДЕ
		|	СоответствиеОбъектовТекущейИВнешнихИБ.ИспользуемаяИБ = &ИспользуемаяИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Идентификатор КАК Идентификатор,
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ПубличныеИдентификаторы
		|ИЗ
		|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
		|ГДЕ
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТабУстановленныеСоответствия.GUID КАК GUID,
		|	ТабУстановленныеСоответствия.ПредставлениеGUID КАК ПредставлениеGUID,
		|	ТабУстановленныеСоответствия.НастройкаСоответствия КАК НастройкаСоответствия,
		|	ТабУстановленныеСоответствия.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
		|	ВЫБОР
		|		КОГДА СоответствиеОбъектов.ОбъектТекущейИБ ЕСТЬ NULL
		|			ТОГДА ЕСТЬNULL(ПубличныеИдентификаторы.Ссылка, НЕОПРЕДЕЛЕНО)
		|		ИНАЧЕ СоответствиеОбъектов.ОбъектТекущейИБ
		|	КОНЕЦ КАК ОбъектТекущейИБ,
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ИЗ
		|	ТабУстановленныеСоответствия КАК ТабУстановленныеСоответствия
		|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеОбъектов КАК СоответствиеОбъектов
		|		ПО ТабУстановленныеСоответствия.НастройкаСоответствия = СоответствиеОбъектов.НастройкаСоответствия
		|			И ТабУстановленныеСоответствия.GUID = СоответствиеОбъектов.ОбъектВнешнейИБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПубличныеИдентификаторы КАК ПубличныеИдентификаторы
		|		ПО ТабУстановленныеСоответствия.GUID = ПубличныеИдентификаторы.Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		|	ТабУстановленныеСоответствия.НастройкаСоответствия КАК НастройкаСоответствия,
		|	ТабУстановленныеСоответствия.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
		|	ТабУстановленныеСоответствия.ТаблицаАналитикиТек КАК ТаблицаАналитикиТек
		|ИЗ
		|	ТабУстановленныеСоответствия КАК ТабУстановленныеСоответствия";
		
		Запрос.УстановитьПараметр("УзелИнформационнойБазы",УзелИнформационнойБазы);
			
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции // ПолучитьЗапросПоТаблицамВИБ() 

Функция ПолучитьЗапросПоТаблицамВИБиИменамНастроек(УзелИнформационнойБазы)
	
	Запрос=Новый Запрос;
	
	Если НЕ ЗначениеЗаполнено(УзелИнформационнойБазы) Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		             |	ТаблицаЗначенийПолей.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
		             |	ТаблицаЗначенийПолей.НастройкаСоответствия КАК НаименованиеНастройки,
		             |	ТаблицаЗначенийПолей.GUID КАК GUID,
		             |	ТаблицаЗначенийПолей.ПредставлениеGUID КАК ПредставлениеGUID
		             |ПОМЕСТИТЬ ТаблицаЗначенийПолей
		             |ИЗ
		             |	&ТаблицаЗначенийПолей КАК ТаблицаЗначенийПолей
		             |;
		             |
		             |////////////////////////////////////////////////////////////////////////////////
		             |ВЫБРАТЬ
		             |	СоответствиеВнешнимИБ.Ссылка КАК НастройкаСоответствия,
