Функция ПолучитьКэшированныйТекстЗапросаВНА(ПоляВыбораСтрокой = Неопределено, ТаблицаДляПомещения = Неопределено, ЕстьТУВНА = Ложь) Экспорт

	Отчет = Отчеты.ПараметрыВНА.Создать();
	НастройкиСКД = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	
	Если ПоляВыбораСтрокой <> Неопределено Тогда
		
		НастройкиСКД.Выбор.Элементы.Очистить();
		
		Для каждого ТекущееПолеВыбора Из СтрРазделить(ПоляВыбораСтрокой, ",") Цикл
			ТиповыеОтчетыУХ.ДобавитьВыбранноеПоле(НастройкиСКД.Выбор, СокрЛП(ТекущееПолеВыбора));
		КонецЦикла;
		
	КонецЕсли;
	
	Отчеты.ПараметрыВНА.ЗаполнитьПараметрыСКД(НастройкиСКД, ТекущаяДата(), Неопределено, Неопределено);
	
	//СКД упрощает запрос
	КонтекстЗапроса = Новый Структура("ТекстЗапроса, НомераТаблиц", Новый Массив, Новый Структура); 
	Макет = ТиповыеОтчетыУХ.ПолучитьМакетКомпоновкиДанныхКоллекции(
		Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"), НастройкиСКД, , Ложь, , );
		
	Макет.НаборыДанных.Получить(0).Запрос 
		= Отчеты.ПараметрыВНА.ТекстЗапроса_ПараметрыВНА(
			КонтекстЗапроса, ТаблицаДляПомещения, ЕстьТУВНА);
	
	ТекстЗапроса = Макет.НаборыДанных.Получить(0).Запрос;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&П", "&ГраницаДоДокумента");
	
	Если ТаблицаДляПомещения = Неопределено Тогда
		Возврат ТекстЗапроса;//НомераТаблиц не нужны
	КонецЕсли;
		
	Возврат Новый Структура("Текст, НомераТаблиц", ТекстЗапроса, КонтекстЗапроса.НомераТаблиц);
	
КонецФункции

