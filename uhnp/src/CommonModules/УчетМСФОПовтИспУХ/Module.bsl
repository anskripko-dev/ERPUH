Функция ВалютаРУ(Организация) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ВалютыСтран.Валюта, ВалютаРУ.Значение) КАК Валюта
	|ИЗ
	|	Константа.ВалютаРегламентированногоУчета КАК ВалютаРУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВалютыСтран КАК ВалютыСтран
	|		ПО (ВалютыСтран.Страна = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).СтранаРегистрации)");
	
	Если Не ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВалютаРегламентированногоУчета", "ВалютаУправленческогоУчета");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Валюта;
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");

КонецФункции

