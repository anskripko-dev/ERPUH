			КонецЕсли;
			
		ИначеЕсли Аналитика.Значение = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникВалюты Тогда
			ОбластьСтрокаАналитика = ПолеТабличногоДокументаМакет.Область(ПолеТабличногоДокументаМакет.ВысотаТаблицы,ИндексПоля,ПолеТабличногоДокументаМакет.ВысотаТаблицы,ИндексПоля);
			ПрименитьШаблонОформленияБланка(ОбластьСтрокаАналитика, ШаблонОформленияБланковОтчетов, "Раскрытие_Аналитика_" + Формат(КоличествоАналитик, "ЧГ=0"));
			ОбластьСтрокаАналитика.Отступ = 0;
			
		КонецЕсли;
		
	КонецЦикла;
				
КонецПроцедуры	

Процедура СформироватьМакетыРаскрытияМастер(Результат,Верх,Лево,СтруктураОдинаковыхИмен,ПроверятьНаличиеСлужебныхОбластей = Истина,КартинкаМакета = Неопределено,РежимГенерацииМакета = Ложь,ПолеТабличногоДокументаМакетИзм, ШаблонОформленияБланковОтчетов, ВидОтчетаВход = Неопределено)		
	Если ПроверятьНаличиеСлужебныхОбластей Тогда
		ПроверитьНаличиеСлужебныхОбластей(ПолеТабличногоДокументаМакетИзм);
	КонецЕсли;
	
	АналитическийБланкГенерацияМакетаУХСервер.СформироватьМакетыРаскрытия(ПолеТабличногоДокументаМакетИзм, Результат, Верх, Лево, СтруктураОдинаковыхИмен, КартинкаМакета, РежимГенерацииМакета, ШаблонОформленияБланковОтчетов, ВидОтчетаВход);
КонецПроцедуры	

Процедура ПроверитьНаличиеСлужебныхОбластей(ПолеТабличногоДокументаМакетИзм, ТихийРежим = Ложь) Экспорт
	
	МакетСлужебныхОбластей = Справочники.БланкиОтчетов.ПолучитьМакет("ШаблонСлужебныхОбластей");
	
	Если НЕ ПолеТабличногоДокументаМакетИзм.Область(1,0,1,0).Имя =  "ОбластьНастроекРаскрытийКолонок" Тогда
		
		ОбластьИсточник = МакетСлужебныхОбластей.Область("ОбластьНастроекРаскрытийКолонок");
		ОбластьПриемник = ПолеТабличногоДокументаМакетИзм.Область(1,0,1,0);
		ПолеТабличногоДокументаМакетИзм.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.ПоВертикали);
		
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru = 'Добавлена служебная область, содержащая настройки раскрытий колонок'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;	
		
	Если НЕ ПолеТабличногоДокументаМакетИзм.Область(0,1,0,1).Имя =  "ОбластьНастроекРаскрытийСтрок" Тогда
		
		ОбластьИсточник = МакетСлужебныхОбластей.Область("ОбластьНастроекРаскрытийСтрок");
		ОбластьПриемник = ПолеТабличногоДокументаМакетИзм.Область(0,1,0,1);
		ПолеТабличногоДокументаМакетИзм.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.ПоГоризонтали);
		
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru = 'Добавлена служебная область, содержащая настройки раскрытий строк'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура СгенерироватьПериодыРаскрытияИмпорт(тДеревоВыбранныхКолонок, текПоказатели,СтруктураОдинаковыхИмен,ОбъектАБ, ПолеТабличногоДокументаМакетИзм, ШаблонОформленияБланковОтчетов = Неопределено, ВидОтчетаВход = Неопределено) Экспорт
		
	ПараметрыНовогоМакета = Новый Структура;
	
	ДеревоСтруктуры 	  = Новый ДеревоЗначений;;
    ДеревоСтруктуры.Колонки.Добавить("АналитикаПредставление");
	ДеревоСтруктуры.Колонки.Добавить("СтруктураАналитикСтрока");
			
	КоличествоСтрокМакета 	= 1;
	НачалоОбластиЗаголовка	= 1;
	
	МакетГруппировок        = ПолеТабличногоДокументаМакетИзм.ПолучитьОбласть("ОбластьКолонок");
	ИмяОбластиГруппировок   = "ОбластьКолонок";
	МакетГруппировок.Область(0,1,0,МакетГруппировок.ШиринаТаблицы).Имя = ИмяОбластиГруппировок;
		
	ПараметрыОтбора         = ОбъектАБ.РасшифровкаГруппОтборов.Выгрузить(Новый Структура("УидГруппыОтборов",Неопределено));
	
	СтруктураСортировки     = Новый Структура;
	СтруктураАналитик       = Новый Структура;
	тзСтруктураМакета       = Новый ТаблицаЗначений;
	тзСтруктураМакета.Колонки.Добавить("ВерхОбласти");
	тзСтруктураМакета.Колонки.Добавить("ЛевоОбласти");
    тзСтруктураМакета.Колонки.Добавить("ИмяОбласти");
	
	нСтрокаСтруктуры = тзСтруктураМакета.Добавить();
	нСтрокаСтруктуры.ВерхОбласти = 0;
	нСтрокаСтруктуры.ЛевоОбласти = 1;
	нСтрокаСтруктуры.ИмяОбласти  = ИмяОбластиГруппировок;
	
	//ПериодС
	нПараметрОтбора = ПараметрыОтбора.Добавить();
	нПараметрОтбора.ЗначениеДляПроверкиСтрока 	= ЗначениеВСтрокуВнутр(Неопределено);
	нПараметрОтбора.ЗначениеОтбораСтрока 		= ЗначениеВСтрокуВнутр(Неопределено);
	нПараметрОтбора.Использовать 				= Истина;
	нПараметрОтбора.Отбор 						= Перечисления.ВидыСравненияПоказателейОтчетов.ПериодНачалаОтчета;
	нПараметрОтбора.Поле 						= НСтр("ru = 'Период начала отбора'");
	нПараметрОтбора.ПолеКод 					= "ПериодС";
	нПараметрОтбора.ПорядокОтбора 				= 1;
	нПараметрОтбора.ТипЗначенияСтрока 			= "СправочникСсылка.Периоды";
	
	//ПериодПо
	нПараметрОтбора = ПараметрыОтбора.Добавить();
	нПараметрОтбора.ЗначениеДляПроверкиСтрока 	= ЗначениеВСтрокуВнутр(Неопределено);
	нПараметрОтбора.ЗначениеОтбораСтрока 		= ЗначениеВСтрокуВнутр(Неопределено);
	нПараметрОтбора.Использовать 				= Истина;
	нПараметрОтбора.Отбор 						= Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияОтчета;
	нПараметрОтбора.Поле 						= НСтр("ru = 'Период окончания отбора'");
	нПараметрОтбора.ПолеКод 					= "ПериодПо";
	нПараметрОтбора.ПорядокОтбора 				= 2;
	нПараметрОтбора.ТипЗначенияСтрока 			= "СправочникСсылка.Периоды";
	
	ТзОписанияСтруктуры 					= Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыНастроекАналитик();
	нСтрСтруктуры       					= ТзОписанияСтруктуры.Добавить();
	нСтрСтруктуры.АналитикаПредставление 	= "Период отчета";
	нСтрСтруктуры.АналитикаКод 			 	= "ПериодОтчета";
	
	СтруктураАналитик.Вставить("ПериодОтчета",ТзОписанияСтруктуры);
	
	нСтрокаДерева         						  = ДеревоСтруктуры.Строки.Добавить();
	нСтрокаДерева.СтруктураАналитикСтрока         = ЗначениеВСтрокуВнутр(СтруктураАналитик);
	
	ПараметрыНовогоМакета.Вставить("СтруктураАналитикАдрес"		,ПоместитьВоВременноеХранилище(ДеревоСтруктуры,Новый УникальныйИдентификатор));
	ПараметрыНовогоМакета.Вставить("КоличествоСтрокМакета"		,1);
	ПараметрыНовогоМакета.Вставить("НачалоОбластиЗаголовка"		,0);
	ПараметрыНовогоМакета.Вставить("МакетГруппировок"			,ПоместитьВоВременноеХранилище(МакетГруппировок,Новый УникальныйИдентификатор));
	ПараметрыНовогоМакета.Вставить("ПараметрыОтбораАдрес"		,ПоместитьВоВременноеХранилище(ПараметрыОтбора,Новый УникальныйИдентификатор));
	ПараметрыНовогоМакета.Вставить("ПараметрыОтбораАдрес"		,ПоместитьВоВременноеХранилище(ПараметрыОтбора,Новый УникальныйИдентификатор));
    ПараметрыНовогоМакета.Вставить("СортировкиАдрес"		    ,ПоместитьВоВременноеХранилище(СтруктураСортировки,Новый УникальныйИдентификатор));
    ПараметрыНовогоМакета.Вставить("тзСтруктураМакетаАдрес"		,ПоместитьВоВременноеХранилище(тзСтруктураМакета,Новый УникальныйИдентификатор));
	ПараметрыНовогоМакета.Вставить("текПоказатели"				,ПоместитьВоВременноеХранилище(текПоказатели,Новый УникальныйИдентификатор));
	ПараметрыНовогоМакета.Вставить("СтруктураИерархии"			,Новый Структура);

	
	ТекШирина =  ПолеТабличногоДокументаМакетИзм.ШиринаТаблицы;

	СформироватьМакетыРаскрытияМастер(ПараметрыНовогоМакета, 0, ТекШирина, СтруктураОдинаковыхИмен,,,, ПолеТабличногоДокументаМакетИзм, ШаблонОформленияБланковОтчетов, ВидОтчетаВход);
		
	ОбластьШапкаТаблицы = ПолеТабличногоДокументаМакетИзм.Область("ОбластьШапка");
	ВерхЗаголовка = ПолеТабличногоДокументаМакетИзм.Область("ОбластьШапка").Верх;
	ЛевоЗаголовка = ПолеТабличногоДокументаМакетИзм.Область("ОбластьКолонок").Право+1;
	
	ЯчейкаШаблон = ПолеТабличногоДокументаМакетИзм.Область(ОбластьШапкаТаблицы.Верх, 2, ОбластьШапкаТаблицы.Верх, 2);
			
	ПолеТабличногоДокументаМакетИзм.Область(2,ЛевоЗаголовка,2,ЛевоЗаголовка).Текст = "";
	
	ОбластьФорматирования = ПолеТабличногоДокументаМакетИзм.Область(ВерхЗаголовка + 2, ЛевоЗаголовка, ВерхЗаголовка + 2, ПолеТабличногоДокументаМакетИзм.ШиринаТаблицы);
	ОбластьФорматирования.ЦветФона = Новый Цвет(255, 250, 217);	
	ПрименитьШаблонОформленияБланка(ОбластьФорматирования, ШаблонОформленияБланковОтчетов, "Раскрытие_Период");
	
	ПолеТабличногоДокументаМакетИзм.Область(0,ПолеТабличногоДокументаМакетИзм.Область("ОбластьКолонок").Право+1,0,ПолеТабличногоДокументаМакетИзм.ШиринаТаблицы).ШиринаКолонки = 14;
		
	Для Каждого Колонка Из тДеревоВыбранныхКолонок Цикл		
		ОбластьШапкаКолонка = ПолеТабличногоДокументаМакетИзм.Область(ВерхЗаголовка + 1, ЛевоЗаголовка, ВерхЗаголовка + 1, ЛевоЗаголовка);
		ЗаполнитьЗначенияСвойств(ОбластьШапкаКолонка, ЯчейкаШаблон,, "ВысотаСтроки");		
		ОбластьШапкаКолонка.Текст = Колонка.Представление;
		ОбластьШапкаКолонка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ПрименитьШаблонОформленияБланка(ОбластьШапкаКолонка, ШаблонОформленияБланковОтчетов, "ОбластьШапкаКолонка", ПолеТабличногоДокументаМакетИзм, Истина, Истина);
		
		ЛевоЗаголовка = ЛевоЗаголовка+1;	
	КонецЦикла;
		
КонецПроцедуры	

Процедура СоздатьМакетБланка(Результат, ВидОтчетаВход, БланкДляОтображенияВход, НаименованиеВход, ОбъектАБ, ПолеТабличногоДокументаМакетИзм) Экспорт
		
	Если НЕ Результат.ДополнитьМакет Тогда
		ПолеТабличногоДокументаМакетИзм.Очистить();
	КонецЕсли;
	
	Если Результат.Свойство("ШаблонОформленияБланковОтчетов") Тогда
		
		ЗаполнитьСтандартныеШаблоныОформленияБланковОтчетов();
				
		МакетШаблонаОформления = Результат.ШаблонОформленияБланковОтчетов.Макет.Получить();
		
		ПолеТабличногоДокументаМакетИзм.ФиксацияСверху = МакетШаблонаОформления.ФиксацияСверху + 1;
		ПолеТабличногоДокументаМакетИзм.ФиксацияСлева = МакетШаблонаОформления.ФиксацияСлева + 1;
		
		ОбластьЗаголовок = МакетШаблонаОформления.ПолучитьОбласть("ОбластьЗаголовок");
		ОбластьВертикальныйОтступ = МакетШаблонаОформления.ПолучитьОбласть("ОбластьВертикальныйОтступ");
		ОбластьШапка = МакетШаблонаОформления.ПолучитьОбласть("ОбластьШапка");
		
		//Область заголовка
		ПолеТабличногоДокументаМакетИзм.Вывести(ОбластьЗаголовок);
		
		//Область реквизитов
		Если Результат.ВыводитьРеквизиты Тогда
						
			ПолеТабличногоДокументаМакетИзм.НачатьГруппуСтрок(, Истина);	
			ОбластьРеквизиты = МакетШаблонаОформления.ПолучитьОбласть("ОбластьРеквизиты");
			Для Каждого ВложеннаяОбласть Из ОбластьРеквизиты.Области Цикл
				ВложеннаяОбласть.ВысотаСтроки = 11;
				ВложеннаяОбласть.АвтоВысотаСтроки = Истина;
			КонецЦикла;
			
			ВариантМакета = Результат.ШаблонОформленияБланковОтчетов.ВариантМакета;
			
			//Оформление реквизитов
			Если ВариантМакета = 1 Тогда
				
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(1,1,1,1), Результат.ШаблонОформленияБланковОтчетов, "Организация", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(2,1,2,1), Результат.ШаблонОформленияБланковОтчетов, "ОрганизацияПараметр", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(3,1,3,1), Результат.ШаблонОформленияБланковОтчетов, "Проект", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(4,1,4,1), Результат.ШаблонОформленияБланковОтчетов, "ПроектПараметр", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(5,1,5,1), Результат.ШаблонОформленияБланковОтчетов, "Валюта", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(6,1,6,1), Результат.ШаблонОформленияБланковОтчетов, "ВалютаПараметр", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(7,1,7,1), Результат.ШаблонОформленияБланковОтчетов, "Период", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(8,1,8,1), Результат.ШаблонОформленияБланковОтчетов, "ПериодПараметр", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(9,1,9,1), Результат.ШаблонОформленияБланковОтчетов, "Сценарий", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(10,1,10,1), Результат.ШаблонОформленияБланковОтчетов, "СценарийПараметр", ОбластьРеквизиты,, Истина);
				
			ИначеЕсли ВариантМакета = 2 Тогда
								
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(1,1,1,1), Результат.ШаблонОформленияБланковОтчетов, "Организация", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(2,1,2,1), Результат.ШаблонОформленияБланковОтчетов, "Проект", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(3,1,3,1), Результат.ШаблонОформленияБланковОтчетов, "Валюта", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(4,1,4,1), Результат.ШаблонОформленияБланковОтчетов, "Период", ОбластьРеквизиты,, Истина);
				ПрименитьШаблонОформленияБланка(ОбластьРеквизиты.Область(5,1,5,1), Результат.ШаблонОформленияБланковОтчетов, "Сценарий", ОбластьРеквизиты,, Истина);

			КонецЕсли;
			
			Если НЕ ВидОтчетаВход.РазделениеПоПроектам тогда
				Если ВариантМакета = 1 Тогда
					ОбластьКУдалению = ОбластьРеквизиты.Область(3,0,4,0);
					ПолеТабличногоДокументаМакетИзм.ФиксацияСверху = ?(ПолеТабличногоДокументаМакетИзм.ФиксацияСверху > ОбластьЗаголовок.ВысотаТаблицы + 3, ПолеТабличногоДокументаМакетИзм.ФиксацияСверху - 2, ПолеТабличногоДокументаМакетИзм.ФиксацияСверху);
				ИначеЕсли ВариантМакета = 2 Тогда
					ОбластьКУдалению = ОбластьРеквизиты.Область(2,0,2,0);
					ПолеТабличногоДокументаМакетИзм.ФиксацияСверху = ?(ПолеТабличногоДокументаМакетИзм.ФиксацияСверху > ОбластьЗаголовок.ВысотаТаблицы + 2, ПолеТабличногоДокументаМакетИзм.ФиксацияСверху - 1, ПолеТабличногоДокументаМакетИзм.ФиксацияСверху);
				КонецЕсли;
				
				ОбластьРеквизиты.УдалитьОбласть(ОбластьКУдалению, ТипСмещенияТабличногоДокумента.ПоВертикали);
			КонецЕсли;
			
			ПолеТабличногоДокументаМакетИзм.Вывести(ОбластьРеквизиты);
						
			ПолеТабличногоДокументаМакетИзм.Вывести(ОбластьВертикальныйОтступ);
			ПолеТабличногоДокументаМакетИзм.ЗакончитьГруппуСтрок();
			
		Иначе
			
			ВариантМакета = Результат.ШаблонОформленияБланковОтчетов.ВариантМакета;
			
			Если ВариантМакета = 1 Тогда
				ПолеТабличногоДокументаМакетИзм.ФиксацияСверху = ?(ПолеТабличногоДокументаМакетИзм.ФиксацияСверху > ОбластьЗаголовок.ВысотаТаблицы, Макс(ПолеТабличногоДокументаМакетИзм.ФиксацияСверху - 11, ОбластьЗаголовок.ВысотаТаблицы), ПолеТабличногоДокументаМакетИзм.ФиксацияСверху);
			ИначеЕсли ВариантМакета = 2 Тогда	
				ПолеТабличногоДокументаМакетИзм.ФиксацияСверху = ?(ПолеТабличногоДокументаМакетИзм.ФиксацияСверху > ОбластьЗаголовок.ВысотаТаблицы, Макс(ПолеТабличногоДокументаМакетИзм.ФиксацияСверху - 6, ОбластьЗаголовок.ВысотаТаблицы), ПолеТабличногоДокументаМакетИзм.ФиксацияСверху);
			КонецЕсли;
			
		КонецЕсли;
			
		//Область шапки
		ПолеТабличногоДокументаМакетИзм.Вывести(ОбластьШапка);
				
		ОбластьКУдалению = ПолеТабличногоДокументаМакетИзм.Область(0,2,0,3);
		ПолеТабличногоДокументаМакетИзм.УдалитьОбласть(ОбластьКУдалению, ТипСмещенияТабличногоДокумента.ПоГоризонтали);
												
	Иначе
		
		нТабДок = Справочники.БланкиОтчетов.ПолучитьМакет("ШаблонНовогоБланка");		
		ПолеТабличногоДокументаМакетИзм.Вывести(нТабДок);
		
	КонецЕсли;
				
	ПроверитьНаличиеСлужебныхОбластей(ПолеТабличногоДокументаМакетИзм, Истина);
			
	тДеревоВыбранныхСтрок 			= ПолучитьИзВременногоХранилища(Результат.ДеревоСтрок);
	тДеревоВыбранныхКолонок 		= ПолучитьИзВременногоХранилища(Результат.Колонки);
	
	текПоказатели = ПолучитьТаблицуПоказателейВидаОтчета(ВидОтчетаВход);
	текПоказатели.Индексы.Добавить("Строка,Колонка");
	текПоказатели.Индексы.Добавить("Ссылка");

	кэшРаскрытияПоказателей = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьАналитикиРаскрытияПоказателей(текПоказатели.ВыгрузитьКолонку("Ссылка"));
	кэшРаскрытияПоказателей_ = кэшРаскрытияПоказателей.Скопировать();
	
	ТекСтрокаСверткиПоАналитике = "";
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ТекСтрокаСверткиПоАналитике = ТекСтрокаСверткиПоАналитике+"ВидАналитики"+Инд+",";
		ТекСтрокаСверткиПоАналитике = ТекСтрокаСверткиПоАналитике+"ВидАналитики"+Инд+"Код,";
	КонецЦикла;	
	
	ТекСтрокаСверткиПоАналитике = ТекСтрокаСверткиПоАналитике+"ВидАналитикиВалюта,ВидАналитикиВалютаКод";
	
	//Если не выводим аналитику, то все равно эмулируем иерархию для правильного форматирования шапки.
	Если НЕ Результат.ВыводитьАналитику Тогда 
		Результат.ВыводитьАналтикиВИерархии = Истина;
	КонецЕсли;
		
	кэшРаскрытияПоказателей_.Свернуть(ТекСтрокаСверткиПоАналитике);
	
	СтруктураДанныхАналитик 				= ПолучитьДанныеАналитикМногоПериодногоБланка(БланкДляОтображенияВход, ВидОтчетаВход, кэшРаскрытияПоказателей_);
	глАналитик 								= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхАналитик, "глАналитик", Новый Структура);
	ГлКлючейАналитик 						= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхАналитик, "ГлКлючейАналитик", Новый Структура);
	
	СтруктураОдинаковыхИмен 				= Новый Структура;
	КартинкаМакета          				= БиблиотекаКартинок.НайтиВСодержании;
		
		
	СгенерироватьШапкуТаблицы(БланкДляОтображенияВход,глАналитик, тДеревоВыбранныхКолонок, ГлКлючейАналитик, НаименованиеВход, ПолеТабличногоДокументаМакетИзм, Результат.ШаблонОформленияБланковОтчетов);
	ПодготовитьТаблицыПоДеревуРекурсивноИмпорт(тДеревоВыбранныхСтрок, тДеревоВыбранныхКолонок, глАналитик, ГлКлючейАналитик, кэшРаскрытияПоказателей, текПоказатели, СтруктураОдинаковыхИмен, КартинкаМакета, Результат.ВыводитьАналтикиВИерархии, Результат.ВыводитьАналитику, ПолеТабличногоДокументаМакетИзм, ОбъектАБ, БланкДляОтображенияВход, Результат.ШаблонОформленияБланковОтчетов, ВидОтчетаВход);				
	СгенерироватьПериодыРаскрытияИмпорт(тДеревоВыбранныхКолонок, текПоказатели,СтруктураОдинаковыхИмен, ОбъектАБ, ПолеТабличногоДокументаМакетИзм, Результат.ШаблонОформленияБланковОтчетов, ВидОтчетаВход);
		
	ОбластьКолонки = ПолеТабличногоДокументаМакетИзм.Область("ОбластьКолонок");
	
	Если Результат.ДобавитьИтогПоПериоду Тогда	
		Если Результат.РасположениеИтогов = "Справа" Тогда
			ОбластьКолонкиПриемник      = ПолеТабличногоДокументаМакетИзм.Область(0,ПолеТабличногоДокументаМакетИзм.ШиринаТаблицы+1,0,ПолеТабличногоДокументаМакетИзм.ШиринаТаблицы+тДеревоВыбранныхКолонок.Количество());
			ПолеТабличногоДокументаМакетИзм.ВставитьОбласть(ОбластьКолонки,ОбластьКолонкиПриемник,ТипСмещенияТабличногоДокумента.ПоГоризонтали);
			ОбластьКолонкиПриемник.Имя  = "";
			
			ОформитьОбластьИтогов(ПолеТабличногоДокументаМакетИзм, ОбластьКолонкиПриемник,
				Результат.ШаблонОформленияБланковОтчетов);
			
			ПолеТабличногоДокументаМакетИзм.УдалитьОбласть(ОбластьКолонки,ТипСмещенияТабличногоДокумента.ПоГоризонтали);
			
		Иначе
			
			ОформитьОбластьИтогов(ПолеТабличногоДокументаМакетИзм, ОбластьКолонки,
				Результат.ШаблонОформленияБланковОтчетов);
			ОбластьКолонки.Имя  = "";
			
		КонецЕсли;
		
		ДобавитьОтборыОстаточнымПоказателям(ПолеТабличногоДокументаМакетИзм, тДеревоВыбранныхКолонок, текПоказатели);
		
	Иначе	
		ПолеТабличногоДокументаМакетИзм.УдалитьОбласть(ОбластьКолонки,ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
			
	
	Если Результат.ВыводитьАналтикиВИерархии Тогда	
		Если ПолеТабличногоДокументаМакетИзм.Область("ОбластьМакетаСтрок").Право>2 Тогда
			ОбластьКУдалению =  ПолеТабличногоДокументаМакетИзм.Область(0,3,0,ПолеТабличногоДокументаМакетИзм.Область("ОбластьМакетаСтрок").Право);	
			ПолеТабличногоДокументаМакетИзм.УдалитьОбласть(ОбластьКУдалению,типСмещенияТабличногоДокумента.ПоГоризонтали);	
		КонецЕсли;
	Иначе
		ПолеТабличногоДокументаМакетИзм.Область(0,2,0,2).ШиринаКолонки = 30.38;
	
		Если ПолеТабличногоДокументаМакетИзм.Область("ОбластьМакетаСтрок").Право>2 Тогда
			ОбластьКолонкиАналитики = ПолеТабличногоДокументаМакетИзм.Область(0,3,0,ПолеТабличногоДокументаМакетИзм.Область("ОбластьМакетаСтрок").Право);
			ОбластьКолонкиАналитики.ШиринаКолонки = 30.38;	
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьФильтрПоГруппеБюджета(ВидОтчетаВход,ПолеТабличногоДокументаМакетИзм);
	
	
КонецПроцедуры

Процедура ОформитьОбластьИтогов(ТабДок, ОбластьПоиска, ШаблонОформления)
	
	ОбластьЗаголовка = ТабДок.НайтиТекст("[Период отчета]",, ОбластьПоиска,, Истина);
	Если ОбластьЗаголовка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьЗаголовка.Текст = Нстр("ru = 'ИТОГО'");
	ПрименитьШаблонОформленияБланка(ОбластьЗаголовка, ШаблонОформления,
		"ОбластьШапкаИтого", ТабДок, Истина, Истина);
	
	ОбластьШапкаКолонкаИтого = ТабДок.Область(
		ОбластьЗаголовка.Верх + 1, ОбластьЗаголовка.Лево,
		ОбластьЗаголовка.Верх + 1, ОбластьЗаголовка.Лево);
	ПрименитьШаблонОформленияБланка(ОбластьШапкаКолонкаИтого, ШаблонОформления,
		"ОбластьШапкаКолонкаИтого", ТабДок, Истина, Истина);
	
КонецПроцедуры

Процедура ДобавитьОтборыОстаточнымПоказателям(ТабДок, КолонкиРесурсов, текПоказатели)
	
	ОбластьЗаголовка = ТабДок.НайтиТекст(Нстр("ru = 'ИТОГО'"),,,, Истина);
	Если ОбластьЗаголовка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяКолонкаИтого = ОбластьЗаголовка.Лево;
	ПоследняяКолонкаИтого = ОбластьЗаголовка.Лево + КолонкиРесурсов.Количество() - 1;
	
	Для ИндСтрока = ОбластьЗаголовка.Верх + 2 По ТабДок.ВысотаТаблицы Цикл
		
		Для ИндКолонка = ПерваяКолонкаИтого По ПоследняяКолонкаИтого Цикл
			
			ТекущаяЯчейка = ТабДок.Область(ИндСтрока, ИндКолонка, ИндСтрока, ИндКолонка);
			
			Если ТипЗнч(ТекущаяЯчейка.Расшифровка) = Тип("Структура") И ТекущаяЯчейка.Расшифровка.Свойство("Ссылка") Тогда
				
				текПоказатель = текПоказатели.Найти(ТекущаяЯчейка.Расшифровка.Ссылка, "Ссылка");
				Если текПоказатель = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если текПоказатель.СпособРасчетаИтогаПоПериоду <> Перечисления.ВидыИтоговПоказателяПоПериоду.Остаток Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяРасшифровка = Новый Структура;
				НоваяРасшифровка.Вставить("Ссылка", ТекущаяЯчейка.Расшифровка.Ссылка);
				Если ТекущаяЯчейка.Расшифровка.Свойство("РасшифровкаГруппОтборов") Тогда
					НоваяРасшифровка.Вставить("РасшифровкаГруппОтборов", ТекущаяЯчейка.Расшифровка.РасшифровкаГруппОтборов);
				КонецЕсли;
				
				Обработки.АналитическийБланкСводнаяТаблица.УстановитьОтборыОстаточногоПоказателя(НоваяРасшифровка);
				
				ТекущаяЯчейка.Расшифровка = НоваяРасшифровка;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьФильтрПоГруппеБюджета(ВидОтчетаВход,ПолеТабличногоДокументаМакетИзм)

	//Если строка отчета показателя связана с группой ДДС или БДР по аналитике
	//установим соответсвующий фильтр в бланке при генерации.
	
	Если НЕ Константы.КонтролироватьСоставАналитикСтатейНаУровнеГруппы.Получить() = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоказателиОтчетов.Строка.ГруппаСтатейДляУстановкиАналитикБДДС КАК ГруппаСтатейДляУстановкиАналитикБДДС,
	               |	ПоказателиОтчетов.Строка.ГруппаСтатейДляУстановкиАналитикБДР КАК ГруппаСтатейДляУстановкиАналитикБДР,
	               |	ПоказателиОтчетов.Ссылка КАК Ссылка,
	               |	ПоказателиОтчетов.Строка.АналитикаСтатьи КАК СтрокаАналитикаСтатьи
	               |ИЗ
	               |	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	               |ГДЕ
	               |	ПоказателиОтчетов.Строка.СтатьяУказываетсяВАналитике = ИСТИНА
	               |	И ПоказателиОтчетов.Строка.Предназначение В(&Предназначение)
	               |	И ПоказателиОтчетов.Владелец = &ВидОтчетаВход";
	
	Запрос.УстановитьПараметр("ВидОтчетаВход",ВидОтчетаВход);
	
	Предназначения = Новый Массив;
	Предназначения.Добавить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств);
	Предназначения.Добавить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов);

	
	Запрос.УстановитьПараметр("Предназначение",Предназначения);
	
	тПоказателиСвязанныеСБюджетом = Запрос.Выполнить().Выгрузить();
	тПоказателиСвязанныеСБюджетом.Индексы.Добавить("Ссылка");
	
	Для ИндСтроки = 1 По ПолеТабличногоДокументаМакетИзм.ВысотаТаблицы Цикл
		
		Для ИндКолонки = 1 По ПолеТабличногоДокументаМакетИзм.ШиринаТаблицы Цикл
			
			тЯчейка = ПолеТабличногоДокументаМакетИзм.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки);
			
			Если ТипЗнч(тЯчейка.Расшифровка) = Тип("Структура") 
				И тЯчейка.Расшифровка.Свойство("Ссылка") Тогда
				
				тПоказатель =  тПоказателиСвязанныеСБюджетом.Найти(тЯчейка.Расшифровка.Ссылка,"Ссылка");
				Если НЕ тПоказатель = Неопределено Тогда
					
					Если ЗначениеЗАполнено(тПоказатель.ГруппаСтатейДляУстановкиАналитикБДДС) Тогда
						ЗначениеОтбора =	тПоказатель.ГруппаСтатейДляУстановкиАналитикБДДС;					 
					ИначеЕсли ЗначениеЗАполнено(тПоказатель.ГруппаСтатейДляУстановкиАналитикБДР) Тогда
						ЗначениеОтбора =	тПоказатель.ГруппаСтатейДляУстановкиАналитикБДР;					 
					Иначе	
						Продолжить;
					КонецЕсли;
					
					РасшифровкаГруппОтборов = Новый Структура;	 
					КодАналитики 		= тПоказатель.СтрокаАналитикаСтатьи.Код;
					ОтборАналитики     = Перечисления.ВидыСравненияПоказателейОтчетов.ВИерархии;
					
					РасшифровкаГруппОтборов.Вставить(КодАналитики,Строка(тПоказатель.СтрокаАналитикаСтатьи)+"\"+ЗначениеВСтрокуВнутр(ОтборАналитики)+"\"+ЗначениеВСтрокуВнутр(ЗначениеОтбора));	
					
					тЯчейка.Расшифровка.Вставить("РасшифровкаГруппОтборов",РасшифровкаГруппОтборов);
								
					//Ищем настройки вывода аналитик в служебной области		
					тЯчейкаРаскрытия = ПолеТабличногоДокументаМакетИзм.Область(ИндСтроки,1,ИндСтроки,1);
					Если ТипЗнч(тЯчейкаРаскрытия.Расшифровка) = Тип("Структура")
						И  тЯчейкаРаскрытия.Расшифровка.Свойство("НастройкиАналитикРаскрытия") Тогда
						НастройкиАналитикРаскрытия = ЗначениеИзСтрокиВнутр(тЯчейкаРаскрытия.Расшифровка.НастройкиАналитикРаскрытия);
						Если НЕ НастройкиАналитикРаскрытия.Найти(КодАналитики,"АналитикаКод") = Неопределено Тогда
							
							ПараметрыОтбора = ЗначениеИзСтрокиВнутр(тЯчейкаРаскрытия.Расшифровка.ПараметрыОтбора);
							тОтбор = ПараметрыОтбора.Найти(КодАналитики,"ПолеКод");
							Если Не тОтбор = Неопределено Тогда
								 тОтбор.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ВИерархии;
								 тОтбор.ЗначениеОтбора = ЗначениеОтбора;
								 тОтбор.ЗначениеОтбораСтрока  = ЗначениеВСтрокуВнутр(ЗначениеОтбора);
							КонецЕсли;	
							
							ПараметрыИерархии = Новый Структура;	
							
							тЯчейкаРаскрытия.Расшифровка.Вставить("ПараметрыОтбора",ЗначениеВСтрокуВнутр(ПараметрыОтбора));
							
							тНастройкиИерархии = Новый ТаблицаЗначений;
							тНастройкиИерархии.Колонки.Добавить("ВыводитьИерархиюЭлементов",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
							тНастройкиИерархии.Колонки.Добавить("СкрыватьЭлементыГруппы",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
                            тНастройкиИерархии.Колонки.Добавить("ВыводитьДанныеСУровня",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
                            тНастройкиИерархии.Колонки.Добавить("ВыводитьДанныеДоУровня",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
	
							тНастройкиИерархии.Добавить();
							тНастройкиИерархии[0].ВыводитьИерархиюЭлементов = Истина;			  
							ПараметрыИерархии.Вставить(КодАналитики,тНастройкиИерархии);
							
							тЯчейкаРаскрытия.Расшифровка.Вставить("НастройкиИерархии",ЗначениеВСтрокуВнутр(ПараметрыИерархии));

							
						КонецЕсли;
						
					КонецЕсли;	
					
					
				КонецЕсли;	 
				
				
			КонецЕсли;	 
			
			
		КонецЦикла;			
	КонецЦикла;	
	
	
		
КонецПроцедуры	




#КонецОбласти


Функция ПолучитьТипСортировкуАналитики(КлючАналитики,ТипЗначенияАналиткик) Экспорт
	
	СтруктураОтвета = Новый Структура;
	
	МассивТиповСтрока = Новый Массив;
	
	Для Каждого сТип Из ТипЗначенияАналиткик.Типы() Цикл
		
		МассивТипов  = Новый Массив();
		МассивТипов.Добавить(сТип);
		тОписание 	= 	Новый ОписаниеТипов(МассивТипов);
	
		Если сТип = Тип("Строка") 
			ИЛИ сТип = Тип("Дата")
			ИЛИ сТип = Тип("Булево")
			ИЛИ сТип = Тип("Число") Тогда
			ИмяОбъекта = Строка(сТип);
		Иначе		
			ИмяОбъекта	=	тОписание.ПривестиЗначение().Метаданные().ПолноеИмя();
		КонецЕсли;
			
		Если СтрНайти(ИмяОбъекта,"Справочник")>0 Тогда
			ТипСтрока 				= "СправочникСсылка."+Метаданные.НайтиПоТипу(тОписание.Типы()[0]).Имя;
			АналитикаСортировка     = Строка(КлючАналитики)+".Наименование";
		ИначеЕсли СтрНайти(ИмяОбъекта,"Документ")>0 Тогда	
			ТипСтрока 				= "ДокументСсылка."+Метаданные.НайтиПоТипу(тОписание.Типы()[0]).Имя;
			АналитикаСортировка     = Строка(КлючАналитики)+".Номер";
		ИначеЕсли СтрНайти(ИмяОбъекта,"ПланВидовХарактеристик")>0 Тогда	
			ТипСтрока 				= "ПланВидовХарактеристикСсылка."+Метаданные.НайтиПоТипу(тОписание.Типы()[0]).Имя;
			АналитикаСортировка     = Строка(КлючАналитики)+".Наименование";
	    ИначеЕсли СтрНайти(ИмяОбъекта,"ПланСчетов")>0 Тогда	
			ТипСтрока				= "ПланСчетов.Ссылка"+Метаданные.НайтиПоТипу(тОписание.Типы()[0]).Имя;
			АналитикаСортировка     = Строка(КлючАналитики)+".Наименование";
		ИначеЕсли СтрНайти(ИмяОбъекта,"Перечисление")>0 Тогда	 
			ТипСтрока 				= "ПеречислениеСсылка."+Метаданные.НайтиПоТипу(тОписание.Типы()[0]).Имя;
			АналитикаСортировка     = Строка(КлючАналитики)+".Порядок";
		Иначе	
			//Для простых типов возвращаем само поле.
			ТипСтрока 				= сТип;
			АналитикаСортировка     = КлючАналитики;
		КонецЕсли;
		
		МассивТиповСтрока.Добавить(ТипСтрока);
		
	КонецЦикла;	
	
	ТипСтрокаИтог = СтрСоединить(МассивТиповСтрока,"|");
	
	СтруктураОтвета.Вставить("МассивТиповСтрока",МассивТиповСтрока);
	СтруктураОтвета.Вставить("ТипСтрока",ТипСтрокаИтог);
    СтруктураОтвета.Вставить("АналитикаСортировка",АналитикаСортировка);
	
	Возврат СтруктураОтвета;
	 
КонецФункции	

Функция ПолучитьПредставлениеПоля(ПолеКод) Экспорт
	
	Если ПолеКод = "ПериодС" Тогда
		
		Возврат Нстр("ru = 'Период с'; en = 'Period from'");
		
	ИначеЕсли ПолеКод = "ПериодПо"	Тогда
		
		Возврат Нстр("ru = 'Период по'; en = 'Period to'");
	
	ИначеЕсли ПолеКод = "Сценарий"	Тогда
		
		Возврат Нстр("ru = 'Сценарий'; en = 'Scenario'");
					
	ИначеЕсли ПолеКод = "Организация" Тогда			
				
		Возврат Нстр("ru = 'Организация'; en = 'Company'");
		
	ИначеЕсли ПолеКод = "Проект"	Тогда			
		
		Возврат Нстр("ru = 'Проект'; en = 'Project'");
	
	Иначе	
		
		Возврат ПолеКод;
		
	КонецЕсли;
	
КонецФункции

Функция ПодготовитьМакетШаблоновВывода(тКолонки) Экспорт
		
	СтруктураОтвета = Новый Структура;
	
	ПолеТабличногоДокументаМакетШаблонЗаголовка = Новый ТабличныйДокумент;
	
	Обработка 				= Обработки.НастройкаСтруктурыОтчета;
	
	МакетШаблонаСтроки 		= Обработка.ПолучитьМакет("МакетШаблонОформленияСтроки"); 
	МакетШаблонаКолонки 	= Обработка.ПолучитьМакет("МакетШаблонОформленияКолонки");
	
	//Выводим шапку строк	
	ОбластьЗаголовокШапки = МакетШаблонаСтроки.ПолучитьОбласть("ОбластьШапкаТаблицы");
	
	//Выводим шапку реквизитов строк
	ОбластьЗаголовокКолонки = МакетШаблонаКолонки.ПолучитьОбласть("ОбластьКолонкаШапки");
		
	ПолеТабличногоДокументаМакетШаблонЗаголовка.Вывести(ОбластьЗаголовокШапки);
	
	ПолеТабличногоДокументаМакетШаблонЗаголовка.Область(1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы,1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы).Текст = Нстр("ru = 'Строка'");
		
	Для Каждого СтрКол Из тКолонки Цикл
				
		ПолеТабличногоДокументаМакетШаблонЗаголовка.Присоединить(ОбластьЗаголовокКолонки);
		ПолеТабличногоДокументаМакетШаблонЗаголовка.Область(1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы,1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы).Текст = СтрКол.Представление;
						
		Если СтрКол.КолонкаПометкаНаУдаление Тогда
			тЯчейка 			= ПолеТабличногоДокументаМакетШаблонЗаголовка.Область(1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы,1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы);
			тЯчейка.Шрифт 		= Новый Шрифт(тЯчейка.Шрифт,,,,,,Истина);
			тЯчейка.ЦветТекста  = Новый Цвет(255,0,0);
		КонецЕсли;	
		
	КонецЦикла;	
	
	ПолеТабличногоДокументаМакетШаблонЗаголовка.Область(1,0,1,0).Имя = "ШаблонВыводаЗаголовка";
	
	ПолеТабличногоДокументаМакетШаблонСтроки 			= Новый ТабличныйДокумент;
	ПолеТабличногоДокументаМакетШаблонСтрокиИтог 		= Новый ТабличныйДокумент;
	
	ОбластьЗаголовокСтороки 			= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаСтроки");
	ОбластьЗаголовокПоказателя 			= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаПоказателя");
	
	ОбластьЗаголовокСторокиИтог 		= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаСтрокиИтог");
	ОбластьЗаголовокПоказателяИтог 		= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаПоказателяИтог");
	
	//Выводим шаблон для реквизитов строк
	ПолеТабличногоДокументаМакетШаблонСтроки.Вывести(ОбластьЗаголовокСтороки);
	ПолеТабличногоДокументаМакетШаблонСтрокиИтог.Вывести(ОбластьЗаголовокСторокиИтог);		
	
	//Выводим шаблон для колонок отчета
	Для Каждого СтрКол Из тКолонки Цикл				
		ПолеТабличногоДокументаМакетШаблонСтроки.Присоединить(ОбластьЗаголовокПоказателя);	
		ПолеТабличногоДокументаМакетШаблонСтрокиИтог.Присоединить(ОбластьЗаголовокПоказателяИтог);	
	КонецЦикла;	
	
	ПолеТабличногоДокументаМакетШаблонСтроки.Область(1,0,1,0).Имя = "ШаблонВыводаСтроки";
	ПолеТабличногоДокументаМакетШаблонСтрокиИтог.Область(1,0,1,0).Имя = "ШаблонВыводаСтроки";
	
	СтруктураОтвета.Вставить("ПолеТабличногоДокументаМакетШаблонЗаголовка",ПолеТабличногоДокументаМакетШаблонЗаголовка);
	СтруктураОтвета.Вставить("ПолеТабличногоДокументаМакетШаблонСтроки",ПолеТабличногоДокументаМакетШаблонСтроки);
	СтруктураОтвета.Вставить("ПолеТабличногоДокументаМакетШаблонСтрокиИтог",ПолеТабличногоДокументаМакетШаблонСтрокиИтог);
	
	Возврат СтруктураОтвета;
	
КонецФункции

Процедура ПрименитьШаблонОформленияБланка(Ячейка, ШаблонОформленияБланковОтчетов, ИмяОбласти, ПолеТабличногоДокумента = Неопределено, ИзменятьВысоту = Ложь, ИзменятьШирину = Ложь)
		
	Если ШаблонОформленияБланковОтчетов <> Неопределено Тогда
		ОбластьМакета = ШаблонОформленияБланковОтчетов.ОбластиМакета.Найти(ИмяОбласти, "Имя");
		
		Если ОбластьМакета <> Неопределено Тогда
			Образец = ОбластьМакета.МакетОбласти.Получить().Область(1,1,1,1);
						
			СвойстваЗаполнения = Новый Массив;
			СвойстваЗаполнения.Добавить("АвтоОтметкаНезаполненного");
			СвойстваЗаполнения.Добавить("АвтоОтступ");
			СвойстваЗаполнения.Добавить("ВертикальноеПоложение");
			СвойстваЗаполнения.Добавить("ВертикальноеПоложениеКартинки");
			СвойстваЗаполнения.Добавить("ВесовойКоэффициентШирины");
			СвойстваЗаполнения.Добавить("Видимость");
			СвойстваЗаполнения.Добавить("ВыделятьОтрицательные");
			СвойстваЗаполнения.Добавить("ГоризонтальноеПоложение");
			СвойстваЗаполнения.Добавить("ГоризонтальноеПоложениеКартинки");
			СвойстваЗаполнения.Добавить("ГраницаСверху");
			СвойстваЗаполнения.Добавить("ГраницаСлева");
			СвойстваЗаполнения.Добавить("ГраницаСнизу");
			СвойстваЗаполнения.Добавить("ГраницаСправа");
			СвойстваЗаполнения.Добавить("Заполнение");
			СвойстваЗаполнения.Добавить("Маска");
			СвойстваЗаполнения.Добавить("ОриентацияТекста");
			СвойстваЗаполнения.Добавить("ОтметкаНезаполненного");
			СвойстваЗаполнения.Добавить("ПоложениеТекстаОтносительноКартинки");
			СвойстваЗаполнения.Добавить("РазмерКартинки");
			СвойстваЗаполнения.Добавить("РазмещениеТекста");
			СвойстваЗаполнения.Добавить("РастягиватьПоГоризонтали");
			СвойстваЗаполнения.Добавить("ТипОбласти");
			СвойстваЗаполнения.Добавить("Узор");
			СвойстваЗаполнения.Добавить("Формат");
			СвойстваЗаполнения.Добавить("ФорматРедактирования");
			СвойстваЗаполнения.Добавить("ЦветРамки");
			СвойстваЗаполнения.Добавить("ЦветТекста");
			СвойстваЗаполнения.Добавить("ЦветУзора");
			СвойстваЗаполнения.Добавить("ЦветФона");
			СвойстваЗаполнения.Добавить("Шрифт");
			
			ЗаполнитьСвойства = "";
			
			Для Каждого СвойствоКЗаполнению Из СвойстваЗаполнения Цикл
				
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Ячейка, СвойствоКЗаполнению) 
					И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Образец, СвойствоКЗаполнению) Тогда
					
					ЗаполнитьСвойства = ЗаполнитьСвойства + ", " + СвойствоКЗаполнению;
				КонецЕсли;
			КонецЦикла;
						
			Если СтрДлина(ЗаполнитьСвойства) > 2 Тогда
				ЗаполнитьСвойства = Сред(ЗаполнитьСвойства, 3);
				ЗаполнитьЗначенияСвойств(Ячейка, Образец, ЗаполнитьСвойства);
			КонецЕсли;
						
			Если ПолеТабличногоДокумента <> Неопределено Тогда
				
				ОбластьСтрока = ПолеТабличногоДокумента.Область(Ячейка.Верх, 0, Ячейка.Верх, 0);
				Если ИзменятьВысоту И Образец.ВысотаСтроки > 0 И НЕ Ячейка.АвтоВысотаСтроки
					И НЕ ОбластьСтрока.АвтоВысотаСтроки И ОбластьСтрока.ВысотаСтроки <> Образец.ВысотаСтроки Тогда
					
					ОбластьСтрока.ВысотаСтроки = Образец.ВысотаСтроки;				
				КонецЕсли;
				
				ОбластьКолонка = ПолеТабличногоДокумента.Область(0, Ячейка.Лево, 0, Ячейка.Лево);
				Если ИзменятьШирину И Образец.ШиринаКолонки > 0 И ОбластьКолонка.ШиринаКолонки <> Образец.ШиринаКолонки Тогда
					ОбластьКолонка.ШиринаКолонки = Образец.ШиринаКолонки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОтборПоказателяПоОтборуСКД(ОтборСКД) Экспорт

	ОтборПоказателя = Неопределено;
	
	Если ОтборСКД = ВидСравненияКомпоновкиДанных.Равно   Тогда
		 ОтборПоказателя = Перечисления.ВидыСравненияПоказателейОтчетов.Равно;
	ИначеЕсли ОтборСКД = ВидСравненияКомпоновкиДанных.НеРавно   Тогда 	
		 ОтборПоказателя = Перечисления.ВидыСравненияПоказателейОтчетов.НеРавно;
	ИначеЕсли ОтборСКД = ВидСравненияКомпоновкиДанных.Больше   Тогда 	
		 ОтборПоказателя = Перечисления.ВидыСравненияПоказателейОтчетов.Больше;
	ИначеЕсли ОтборСКД = ВидСравненияКомпоновкиДанных.БольшеИлиРавно   Тогда 	
		 ОтборПоказателя = Перечисления.ВидыСравненияПоказателейОтчетов.БольшеИлиРавно;
