		Форма.Элементы, "ВидДоговораУХ", НСтр("ru = 'Вид договора'"), "ВидДоговораУХ", ВидПоляФормы.ПолеВвода, ГруппаБыстрыеОтборы, 
		ИсходныйЭлементОтборСостояние, ПараметрыЭлемента);
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ЭлементПриИзмененииУХ");
	МассивОтборов = Новый Массив;
	МассивОтборов.Добавить(Новый ПараметрВыбора("Отбор.ТипСправочникаДоговора", "ДоговорыКредитовИДепозитов"));
	
	ПараметрыВыбора = Новый ФиксированныйМассив(МассивОтборов);
	НовыйЭлемент.ПараметрыВыбора = ПараметрыВыбора;

	
	// Добавление элемента СостояниеДоговораУХ.
	ПараметрыЭлемента = Новый Структура;
	ПараметрыЭлемента.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Верх);
	ПараметрыЭлемента.Вставить("КнопкаОчистки", Истина);
	ПараметрыЭлемента.Вставить("КнопкаОткрытия", Ложь);
	ПараметрыЭлемента.Вставить("АвтоМаксимальнаяШирина", Ложь);
	ПараметрыЭлемента.Вставить("МаксимальнаяШирина", 22);
	ПараметрыЭлемента.Вставить("ПодсказкаВвода", НСтр("ru = 'Все'"));
	НовыйЭлемент = ФормыУХ.СоздатьПолеФормы(
		Элементы, "СостояниеДоговораУХ", ЗаголовокРеквизитаСостояниеДоговора, "СостояниеДоговораУХ", 
		ВидПоляФормы.ПолеВвода, ГруппаБыстрыеОтборы, ИсходныйЭлементОтборСостояние, ПараметрыЭлемента);
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ЭлементПриИзмененииУХ");
	
	// Добавление элемента СостояниеСогласования.
	ПараметрыЭлемента = Новый Структура;
	ПараметрыЭлемента.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Верх);
	ПараметрыЭлемента.Вставить("КнопкаОчистки", Истина);
	ПараметрыЭлемента.Вставить("КнопкаОткрытия", Ложь);
	ПараметрыЭлемента.Вставить("АвтоМаксимальнаяШирина", Ложь);
	ПараметрыЭлемента.Вставить("МаксимальнаяШирина", 22);
	ПараметрыЭлемента.Вставить("ПодсказкаВвода", НСтр("ru = 'Все'"));
	НовыйЭлемент = ФормыУХ.СоздатьПолеФормы(
		Элементы, "СостояниеСогласования", ЗаголовокРеквизитаСтатус, "СостояниеСогласования", 
		ВидПоляФормы.ПолеВвода, ГруппаБыстрыеОтборы, ИсходныйЭлементОтборСостояние, ПараметрыЭлемента);
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ЭлементПриИзмененииУХ");
	
	//Добавление группы состояния и статуса
	НовыйЭлементГруппаСостояниеСтатус = Элементы.Вставить("ГруппаСостояниеСтатус", Тип("ГруппаФормы"), Элементы.Список);
	НовыйЭлементГруппаСостояниеСтатус.Группировка = ГруппировкаКолонок.Горизонтальная;
	НовыйЭлементГруппаСостояниеСтатус.Заголовок = НСтр("ru = 'Состояние и статус'");
	
	///Перемещение группы состояний  
	Элементы.Переместить(НовыйЭлементГруппаСостояниеСтатус, Элементы.Список, Элементы.Ответственный);
	
	// Добавление колонки Статус в таблицу.
	НовыйЭлемент = Элементы.Добавить("СписокСостояниеСогласования", Тип("ПолеФормы"), НовыйЭлементГруппаСостояниеСтатус);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Список.СостояниеСогласования";
	НовыйЭлемент.Заголовок = ЗаголовокРеквизитаСтатус;
	
	// Добавление колонки Состояние в таблицу.
	НовыйЭлемент = Элементы.Добавить("Состояние", Тип("ПолеФормы"), НовыйЭлементГруппаСостояниеСтатус);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Список.Состояние";
	НовыйЭлемент.Заголовок = ЗаголовокРеквизитаСостояниеДоговора;
	
	// Добавление колонки Вид договора в таблицу.
	НовыйЭлемент = Форма.Элементы.Добавить("СписокВидДоговораУХ", Тип("ПолеФормы"), Форма.Элементы.Список);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Список.ВидДоговораУХ";
	
	Для Каждого ТекущийЭлемент Из Форма.Элементы.ГруппаОтбор.ПодчиненныеЭлементы Цикл 
		ТекущийЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;	
	КонецЦикла; 
	
КонецПроцедуры

