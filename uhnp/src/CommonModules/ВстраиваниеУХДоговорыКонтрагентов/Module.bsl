	НовыйЭлемент.Заголовок = НСтр("ru = 'Состояние договора'");
	
	// Добавление колонки Состояние в таблицу.
	НовыйЭлемент = Форма.Элементы.Добавить("СписокСостояниеСогласования", Тип("ПолеФормы"), НовыйЭлементГруппаСостояниеСтатус);
