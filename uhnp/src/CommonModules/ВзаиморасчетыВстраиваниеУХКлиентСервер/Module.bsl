Функция ИменаРеквизитовЗаказаПоставщику() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВалютаДокумента", "Валюта");
	Результат.Вставить("ДоговорКонтрагента", "Договор");
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьВидимостьКомандыОткрытияГрафикаРасчетовДляНакладных(Форма) Экспорт
	
	Параметры = ВзаиморасчетыВстраиваниеУХКлиентСервер.ПараметрыСозданияКомандыОткрытьГрафикРасчетов();
	Кнопка = Форма.Элементы.Найти(Параметры.Элемент.Имя);
	Если Кнопка <> Неопределено Тогда
		Объект = Форма.Объект;	
		Видимость = Ложь;
		Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
			Реквизиты = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(Объект.ДоговорКонтрагента, "ПорядокРасчетов,ГрафикДоговора");
			Если Реквизиты.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоНакладным")
				И ДоговорыКонтрагентовВстраиваниеУХКлиентСервер.ИспользуетсяГрафикРасчетовВДоговоре(Реквизиты.ГрафикДоговора)Тогда
				Видимость = Истина
			КонецЕсли;
		КонецЕсли;
		
		Кнопка.Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыСозданияКомандыОткрытьГрафикРасчетов() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("Команда", Новый Структура);
	Параметры.Команда.Вставить("Имя", "ОткрытьГрафикРасчетов");
	Параметры.Команда.Вставить("Заголовок", НСтр("ru = 'Открыть график расчетов'"));
	Параметры.Команда.Вставить("Действие", "Подключаемый_ОткрытьГрафикРасчетов");
	Параметры.Команда.Вставить("ИзменяетСохраняемыеДанные", Ложь);
	
	Параметры.Вставить("Элемент", Новый Структура);
	Параметры.Элемент.Вставить("Имя", Параметры.Команда.Имя);
	Параметры.Элемент.Вставить("ИмяКоманды", Параметры.Команда.Имя);
	Параметры.Элемент.Вставить("Тип", Тип("КнопкаФормы"));
	Параметры.Элемент.Вставить("Вид", ВидКнопкиФормы.Гиперссылка);
	
	Возврат Параметры;
	
КонецФункции

