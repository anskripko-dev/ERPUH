Функция ЗагрузитьПланыДДСДокумента(Параметр, Источник, Форма) Экспорт

	ПланыДДС = ПолучитьИзВременногоХранилища(Параметр.Значение);
	
	Если Не ПланыДДС = Неопределено Тогда
		Форма.ПланыДокументаБДДС.Загрузить(ПланыДДС);	
	КонецЕсли;  
	
КонецФункции

Функция ЗадачаНаИсполнителе(Задача, Выполнена = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗадачаИсполнителяЗадачиПоИсполнителю.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя.ЗадачиПоИсполнителю КАК ЗадачаИсполнителяЗадачиПоИсполнителю
	|ГДЕ
	|	ЗадачаИсполнителяЗадачиПоИсполнителю.Ссылка = &Ссылка
	|	И &Выполнена";                      
	
	Если Выполнена <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Выполнена", "ЗадачаИсполнителяЗадачиПоИсполнителю.Выполнена = &Выполнена");
		Запрос.УстановитьПараметр("Выполнена", Выполнена);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Выполнена", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", Задача);
	РезультатЗапроса = Запрос.Выполнить(); 
	
	ЗадачаНаИсполнителе = Не РезультатЗапроса.Пустой();
	Возврат ЗадачаНаИсполнителе;

КонецФункции

Процедура ОбработатьИзменениеНоменклатурыЗаявкиНаЗакупку(Форма, ДанныеСтроки, ДанныеШапкиРасположеныВОбъекте) Экспорт
	
	//
	ДанныеСтроки.ЭтоНоменклатура = (ТипЗнч(ДанныеСтроки.Номенклатура) = Тип("СправочникСсылка.Номенклатура"));
	
		
	//
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("УстановитьЕдиницуИзменения");
	СтруктураДействий.Вставить("ПересчитатьКоличествоПоКоэффициенту");
	СтруктураДействий.Вставить("УстановитьХарактеристику");
	СтруктураДействий.Вставить(?(ДанныеСтроки.ЭтоНоменклатура, "УстановитьЦену", "УстановитьЦенуТК"));   
	
	ЗаменаИменРеквизитов = Новый Соответствие;    
	ЗаменаИменРеквизитов.Вставить("ДатаОкончания", "ОкончаниеПериода"); //todo msle 2022-05-05 Максимум по дате операции? 
	
	ОбработатьСтрокуТЧ2(Форма, ?(ДанныеШапкиРасположеныВОбъекте, Форма.Объект, Форма),	ДанныеСтроки, СтруктураДействий, ЗаменаИменРеквизитов);
	
КонецПроцедуры

Процедура ОбработатьИзменениеЕдиницыИзмеренияЗаявкиНаЗакупку(Форма, ДанныеСтроки) Экспорт

	СтруктураДействий = Новый Структура("УстановитьКоэффициентЕдиницыИзмерения,ПересчитатьПоКоэффициенту");
	ОбработатьСтрокуТЧ2(Форма, Форма, ДанныеСтроки, СтруктураДействий);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеПлановДокумента(Форма, ПрефиксЭлемента, ИмяРеквизита) Экспорт

	// заполняем массив оформляемых элементов
	ЭлементыНедоступныеДляТоварнойКатегории = Новый Массив;
	ДопРеквизиты = Новый Структура("Цена, Коэффициент, ЕдиницаИзмерения");
	Для каждого КлючЗначение Из ДопРеквизиты Цикл
		ИмяЭлемента = ПрефиксЭлемента + КлючЗначение.Ключ;
		Если Форма.Элементы.Найти(ИмяЭлемента)<> неопределено Тогда
			ЭлементыНедоступныеДляТоварнойКатегории.Добавить(ИмяЭлемента);
		КонецЕсли; 
	КонецЦикла; 
	
	ЭлементыНедоступныеДляТоварнойКатегории.Добавить(ПрефиксЭлемента+"Количество");

	ЭлементыНедоступныеДляНоменклатуры = Новый Массив;
	ЭлементыНедоступныеДляНоменклатуры.Добавить(ПрефиксЭлемента+"Сумма");
	
	// если нечего оформлять, то завершаемся
	Если ЭлементыНедоступныеДляТоварнойКатегории.Количество() > 0 Тогда
		
		// Устанавливаем условное оформление по найденным полям
		ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
		Для каждого ИмяОформляемогоЭлемента Из ЭлементыНедоступныеДляТоварнойКатегории Цикл
			ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяОформляемогоЭлемента);
		КонецЦикла; 
		
		ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита + ".ЭтоНоменклатура");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Ложь;
		                                                             
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",					НСтр("ru = '<Нет>'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",		Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", 			ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
		
	КонецЕсли; 
	
	// если нечего оформлять, то завершаемся
	Если ЭлементыНедоступныеДляНоменклатуры.Количество() > 0 Тогда
		
		// Устанавливаем условное оформление по найденным полям
		ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
		Для каждого ИмяОформляемогоЭлемента Из ЭлементыНедоступныеДляНоменклатуры Цикл
			ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяОформляемогоЭлемента);
		КонецЦикла; 
		
		ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита + ".ЭтоНоменклатура");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Истина;
		                                                             
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",		Истина);
		
	КонецЕсли; 
	
	// Условное оформление характеристик: Не используются.
	ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксЭлемента+"Характеристика");
	
	ГруппаИЛИ = ФормыУХ.НоваяГруппаИЛИ(ЭлементУО.Отбор);
	
	ЭлементОтбора = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита + ".ХарактеристикиИспользуются");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;

	ЭлементОтбора = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита + ".ЭтоНоменклатура");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",					НСтр("ru = '<Характеристики не используются>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",		Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", 			ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);

	// Условное оформление характеристик: Отметка незаполненного.
	ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксЭлемента+"Характеристика");
	
	ГруппаИ = ФормыУХ.НоваяГруппаИ(ЭлементУО.Отбор);

	ЭлементОтбора = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита + ".ЭтоНоменклатура");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	// Добавление отбора использования характеристик.
	ЭлементОтбора = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита + ".ХарактеристикиИспользуются");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	// Добавление отбора незаполненной характеристики.
	ЭлементОтбора = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита + ".Характеристика");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Установка способа оформления.
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	//
	Объект = Форма.Объект; 
	Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда    
		ТипЗаявки = "ДокументСсылка.ЗаявкаНаЗакупку";
		Если ТипЗнч(Объект.Ссылка) = Тип(ТипЗаявки) Тогда
			
			// Условное оформление обязатательных полей таблицы ПланыДокумента
			ТаблицаОбязательныхПолей = ОбязательныеПоляПлановДокумента(Форма);
			
			Для Каждого СтрокаТаблицы Из ТаблицаОбязательныхПолей Цикл   
				
				ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();    
				
				ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксЭлемента+СтрокаТаблицы.ИмяРеквизита);
				
				ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксЭлемента + "." +СтрокаТаблицы.ИмяРеквизита);
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
				ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
				
			КонецЦикла;
			
		КонецЕсли;   
	КонецЕсли;
	
КонецПроцедуры

Функция ОбязательныеПоляПлановДокумента(Форма) Экспорт
	
	ТаблицаОбязательныхПолей = Новый ТаблицаЗначений; 
	ТаблицаОбязательныхПолей.Колонки.Добавить("ИмяРеквизита");
	ТаблицаОбязательныхПолей.Колонки.Добавить("Заголовок");
	ТаблицаОбязательныхПолей.Колонки.Добавить("ЕдиниыйРеквизит");  
	
	РеквизитыФормы = Форма.ПолучитьРеквизиты();
	
	Если РеквизитыФормы.Найти("ДатаОперации") <> Неопределено Тогда
		НовСтр = ТаблицаОбязательныхПолей.Добавить();	
		НовСтр.ИмяРеквизита = "ДатаОперации";
		НовСтр.Заголовок = НСтр("ru = 'Дата операции'");
		НовСтр.ЕдиниыйРеквизит = Форма.ЕдиныйДатаОперации;
	КонецЕсли;	

	Если РеквизитыФормы.Найти("МестоПоставки") <> Неопределено Тогда
		НовСтр = ТаблицаОбязательныхПолей.Добавить();	
		НовСтр.ИмяРеквизита = "МестоПоставки";
		НовСтр.Заголовок = НСтр("ru = 'Место поставки'");
		НовСтр.ЕдиниыйРеквизит = Форма.ЕдиныйМестоПоставки;
	КонецЕсли;	

	Если РеквизитыФормы.Найти("Валюта") <> Неопределено Тогда
		НовСтр = ТаблицаОбязательныхПолей.Добавить();	
		НовСтр.ИмяРеквизита = "Валюта";
		НовСтр.Заголовок = НСтр("ru = 'Валюта'");
		НовСтр.ЕдиниыйРеквизит = Форма.ЕдиныйВалюта;
	КонецЕсли;	

	Если РеквизитыФормы.Найти("УсловиеОплаты") <> Неопределено Тогда
		НовСтр = ТаблицаОбязательныхПолей.Добавить();	
		НовСтр.ИмяРеквизита = "УсловиеОплаты";
		НовСтр.Заголовок = НСтр("ru = 'Условие оплаты'");
		НовСтр.ЕдиниыйРеквизит = Форма.ЕдиныйУсловиеОплаты;
	КонецЕсли;	

	Если РеквизитыФормы.Найти("СтатьяБюджета") <> Неопределено Тогда
		НовСтр = ТаблицаОбязательныхПолей.Добавить();	
		НовСтр.ИмяРеквизита = "СтатьяБюджета";
		НовСтр.Заголовок = НСтр("ru = 'Статья бюджета'");
		НовСтр.ЕдиниыйРеквизит = Форма.ЕдиныйСтатьяБюджета;
	КонецЕсли;
	
	Возврат ТаблицаОбязательныхПолей;

КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСтраницуПлановДенежныхСредств(Форма, Размещение)
	
	ИмяСтраницы = "СтраницаОплаты";
	Если Форма.Элементы.Найти(ИмяСтраницы) <> неопределено Тогда
		Возврат; // уже все есть
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	Команды = Форма.Команды;
	
	Если ТипЗнч(Размещение) = Тип("Структура") Тогда
		Родитель = Размещение.Родитель;
		ПередЭлементом = Размещение.ПередЭлементом;
	Иначе
		Родитель = Размещение;
		ПередЭлементом = неопределено;
	КонецЕсли;
	
	// Добавить Страницу
	Страница = ФормыУХ.СоздатьГруппуФормы(
		Элементы, ИмяСтраницы, НСтр("ru = 'Платежи'"),
		ВидГруппыФормы.Страница, Родитель, ПередЭлементом);
	
	// Таблица формы
	ИмяТаблицы = "ПланыДокументаБДДС";
	ИмяРеквизитаТаблицы = "ПланыДокументаБДДС";
	Таблица = ФормыУХ.СоздатьТаблицуФормы(Элементы, ИмяТаблицы,,ИмяРеквизитаТаблицы, Страница);
	Таблица.ТолькоПросмотр = Истина;
	Таблица.ИзменятьСоставСтрок = Ложь;
	
	// Колонки таблицы контроля 
	ИменаКолонок = "ДатаОперации, ДокументПланирования, СтатьяБюджета,"
		+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1")+","
		+ "ПриходРасход, Организация, ЦФО, Проект, Сумма, Валюта";
	Для Каждого КлючЗначение Из Новый Структура(ИменаКолонок) Цикл
		Колонка = ФормыУХ.СоздатьПолеФормы(Элементы, ИмяТаблицы+КлючЗначение.Ключ, , ИмяРеквизитаТаблицы + "." + КлючЗначение.Ключ,, Таблица);
	КонецЦикла;
	
	Элементы[ИмяТаблицы+"Валюта"].Ширина = 10;
	
КонецПроцедуры

// Перенесена из модуля ЦентрализованныеЗакупкиКлиентСерверУХ
Процедура ОбработатьСтрокуТЧ2(Форма, Объект, ДанныеСтроки, СтруктураДействий, ЗаменаИменРеквизитов=Неопределено)
	
	Если СтруктураДействий.Свойство("УстановитьХарактеристику") Тогда
		Если ЗначениеЗаполнено(ДанныеСтроки.Характеристика) Тогда
			СтруктураДействий.Удалить("УстановитьХарактеристику");
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДляПолучения = ЦентрализованныеЗакупкиКлиентСерверУХ.ЧтоПолучитьНаСервере(Объект, ДанныеСтроки, СтруктураДействий, ЗаменаИменРеквизитов);
	Если ДанныеДляПолучения.Количество() > 0 Тогда
		ЗначенияДанных = ЦентрализованныеЗакупкиВызовСервераУХ.ПолучитьДанныеНаСервере(ДанныеДляПолучения);
	Иначе
		ЗначенияДанных = Новый Структура;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеСтроки, "Характеристика")
		И СтруктураДействий.Свойство("УстановитьХарактеристику") Тогда
		ДанныеСтроки.Характеристика = ЗначенияДанных.Характеристика;
		ДанныеСтроки.ХарактеристикиИспользуются = ЗначенияДанных.ХарактеристикиИспользуются;
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("УстановитьКоэффициентЕдиницыИзмерения") Тогда
		ДанныеСтроки.Коэффициент = ЗначенияДанных.Коэффициент;
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("УстановитьЕдиницуИзменения") Тогда
		ДанныеСтроки.ЕдиницаИзмерения = ЗначенияДанных.ЕдиницаИзмерения;
		ДанныеСтроки.Коэффициент = ЗначенияДанных.Коэффициент;
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ПересчитатьПоКоэффициенту") Тогда
		
		// Пересчитать только выбранную строку
		СтарыйКоэффициент = ?(ДанныеСтроки.СтарыйКоэффициент = 0, 1, ДанныеСтроки.СтарыйКоэффициент);
		Коэффициент = ?(ДанныеСтроки.Коэффициент=0,1, ДанныеСтроки.Коэффициент);
		
		КоэффПересчета = СтарыйКоэффициент / Коэффициент;
		ДанныеСтроки.Цена = Окр(ДанныеСтроки.Цена / КоэффПересчета, 2);
		
		ДанныеСтроки.Количество = Окр(ДанныеСтроки.Количество * КоэффПересчета, 3);
		ДанныеСтроки.СтарыйКоэффициент = ДанныеСтроки.Коэффициент;
		
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("УстановитьЦену") Тогда
		Если ЗначениеЗаполнено(ДанныеСтроки.Номенклатура) Тогда
			ДанныеСтроки.Цена = ЗначенияДанных.Цена * ДанныеСтроки.Коэффициент;
			ДанныеСтроки.Сумма = ДанныеСтроки.Цена * ДанныеСтроки.Количество;
		Иначе
			ДанныеСтроки.Цена = 0;
			ДанныеСтроки.Сумма = 0;
		КонецЕсли;
	ИначеЕсли СтруктураДействий.Свойство("УстановитьЦенуТК") Тогда
		Если ЗначениеЗаполнено(ДанныеСтроки.Номенклатура) Тогда
			//ДанныеСтроки.Цена = ЗначенияДанных.Цена * ДанныеСтроки.Коэффициент;
			//ДанныеСтроки.Сумма = ДанныеСтроки.Цена * ДанныеСтроки.Количество;
		Иначе
			ДанныеСтроки.Цена = 0;
			ДанныеСтроки.Сумма = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
