Процедура ДобавитьРеквизитыФормы(Форма, РеквизитыФормы) Экспорт
	
	// Добавляем таблицу планов БДДС
	ИмяРеквизита = "ПланыДокументаБДДС";
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизита) Тогда
		// Добавляем таблицу планов БДДС

		РеквизитыФормы.Добавляемые.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("ТаблицаЗначений")));
		
		Реквизит = Новый РеквизитФормы("ВидБюджета", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыБюджетов"), ИмяРеквизита, НСтр("ru = 'Вид бюджета'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		
		Реквизит = Новый РеквизитФормы("ПриходРасход", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход"), ИмяРеквизита, НСтр("ru = 'Направление'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		
		Реквизит = Новый РеквизитФормы("СтатьяБюджета", Метаданные.ПланыВидовХарактеристик.ВидыБюджетов.Тип, ИмяРеквизита, НСтр("ru = 'Статья бюджета'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		
		Для Поз = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
			Реквизит = Новый РеквизитФормы("Аналитика"+Поз, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип, ИмяРеквизита);
			РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		КонецЦикла;
		
		Реквизит = Новый РеквизитФормы("Организация", Метаданные.ОпределяемыеТипы.Организация.Тип, ИмяРеквизита, НСтр("ru = 'Организация'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		
		Реквизит = Новый РеквизитФормы("ЦФО", Метаданные.ОпределяемыеТипы.ЦФО.Тип, ИмяРеквизита, НСтр("ru = 'ЦФО'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		
		Реквизит = Новый РеквизитФормы("Проект", Новый ОписаниеТипов("СправочникСсылка.Проекты"), ИмяРеквизита, НСтр("ru = 'Проект'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		
		Реквизит = Новый РеквизитФормы("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"), ИмяРеквизита, НСтр("ru = 'Валюта'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);

		Реквизит = Новый РеквизитФормы("ДатаОперации", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата), ИмяРеквизита, НСтр("ru = 'Дата операции'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);

		Реквизит = Новый РеквизитФормы("Сумма", Метаданные.ОпределяемыеТипы.ДенежнаяСуммаЛюбогоЗнака.Тип, ИмяРеквизита, НСтр("ru = 'Сумма'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);

		Реквизит = Новый РеквизитФормы("ДокументПланирования", Метаданные.ОпределяемыеТипы.ОбъектыПланирования.Тип, ИмяРеквизита, НСтр("ru = 'Документ планирования'"));
		РеквизитыФормы.Добавляемые.Добавить(Реквизит);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЭлементыФормы(Форма, Размещение) Экспорт
