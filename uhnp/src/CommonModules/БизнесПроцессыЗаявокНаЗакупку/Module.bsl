#Область ОбновлениеИнформационнойБазы

Процедура ПервоначальноеЗаполнениеПараметровСогласованияБизнесПроцессовЗаявкиНаЗакупку() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Срок выполнения задач процессов обработки заявки на закупку 
	УстановитьЗначениеКонстантыПоПолномуИмени("Константа.ЭкспертизЗаявокНаЗакупку_ВремяОбработки", 		24);
	УстановитьЗначениеКонстантыПоПолномуИмени("Константа.ЭкспертизаЗаявокНаЗакупку_ВремяОзнакомления", 	24);
	УстановитьЗначениеКонстантыПоПолномуИмени("Константа.КорректировкаЗаявкиНаЗакупку_ВремяОбработки", 	24);
	УстановитьЗначениеКонстантыПоПолномуИмени("Константа.КорректировкаЗаявкиНаЗакупку_ВремяОзнакомления", 24);
	
	// Роль исполнителей ОтветственныйЗаЭкспертизуЗаявокНаЗакупку
	Спр = ПредопределенноеЗначение("Справочник.РолиИсполнителей.ОтветственныйЗаЭкспертизуЗаявокНаЗакупку").ПолучитьОбъект();
	Спр.ИспользуетсяБезОбъектовАдресации = Ложь;
	Спр.ИспользуетсяСОбъектамиАдресации = Истина;
	Спр.ТипыОсновногоОбъектаАдресации = ПланыВидовХарактеристик.ОбъектыАдресацииЗадач.Организации;
	Спр.Назначение.Очистить();
	Строка = Спр.Назначение.Добавить();
	Строка.ТипПользователей = Справочники.Пользователи.ПустаяСсылка();
	
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Спр);
	
КонецПроцедуры

Процедура УстановитьЗначениеКонстантыПоПолномуИмени(Знач ИмяМенеджера, Значение)
	
	Перем Менеджер;
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяМенеджера); 
	Менеджер.Установить(Значение)

КонецПроцедуры

