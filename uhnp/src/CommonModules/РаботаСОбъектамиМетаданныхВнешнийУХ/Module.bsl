// Отправляет сообщение в канал 1С:Шина
// Параметры
// ПараметрыСообщения: Структура
//  - СервисИнтеграции (строка)
//  - КодОтправителя (строка) 
//  - КодПолучателя (строка)
//  - КаналОтправки (строка)
//  - ТипСообщения (строка)
//  - ИдентификаторСообщения (строка)
Функция ОтправитьСообщение1СШина(ПараметрыСообщения,ДанныеДляЗапроса) Экспорт

	ТелоСообщения = ПолучитьБуферДвоичныхДанныхИзСтроки(ЗначениеВСтрокуВнутр(ДанныеДляЗапроса));
	
	МенеджерСервиса=СервисыИнтеграции[ПараметрыСообщения.СервисИнтеграции];
	
	Сообщение=МенеджерСервиса.СоздатьСообщение();
	Сообщение.КодОтправителя=ПараметрыСообщения.КодОтправителя;
	Сообщение.КодПолучателя=ПараметрыСообщения.КодПолучателя;
	
	Если ПараметрыСообщения.Свойство("GUIDТекущейИБ") Тогда
		
		Сообщение.Параметры.Вставить("GUIDТекущейИБ",	ПараметрыСообщения.GUIDТекущейИБ);
		
	КонецЕсли;
	
	Сообщение.Параметры.Вставить("ТипСообщения",			ПараметрыСообщения.ТипСообщения);
	Сообщение.Параметры.Вставить("ИдентификаторСообщения",	ПараметрыСообщения.ИдентификаторСообщения);
	Сообщение.Параметры["РазмерСообщения"] = ТелоСообщения.Размер;
	
	ПотокДанных=Сообщение.ПолучитьТелоКакПоток();
	ПотокДанных.Записать(ТелоСообщения,0,ТелоСообщения.Размер);
	ПотокДанных.Закрыть();
	
	МенеджерСервиса[ПараметрыСообщения.КаналОтправки].ОтправитьСообщение(Сообщение);
	
КонецФункции // ОтправитьСообщение1СШина() 

Функция ПолучитьДанныеИзТелаСообщения(Сообщение) Экспорт
	
	РазмерСообщения = Сообщение.Параметры.Получить("РазмерСообщения");
	
	Если РазмерСообщения <> Неопределено Тогда
		РазмерБуфера = Число(РазмерСообщения);
	Иначе
		РазмерБуфера = 1024;
	КонецЕсли;

	Поток = Сообщение.ПолучитьТелоКакПоток();
	Тело = Новый БуферДвоичныхДанных(0);
	Буфер = Новый БуферДвоичныхДанных(РазмерБуфера);

	Пока Истина Цикл
		Прочитано = Поток.Прочитать(Буфер, 0, РазмерБуфера);
		Если Прочитано > 0 Тогда
			Тело = Тело.Соединить(Буфер);
		КонецЕсли;
		Если Прочитано < РазмерБуфера Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаДанные=ПолучитьСтрокуИзБуфераДвоичныхДанных(Тело);
			
	Возврат ЗначениеИзСтрокиВнутр(СтрокаДанные);
				
КонецФункции // ПолучитьДанныеИзТелаСообщения() 

Функция ВыполнитьДействиеПоСообщению(Сообщение) Экспорт
	
	ДанныеДляЗапроса=ПолучитьДанныеИзТелаСообщения(Сообщение);
	ТекСоединениеВИБ=КонтекстМетаданных();	
	ТипСообщения=Сообщение.Параметры.Получить("ТипСообщения");
	
	Возврат ПолучитьДанныеПоЗапросу(ТекСоединениеВИБ,ДанныеДляЗапроса,ТипСообщения); 
			
КонецФункции // ВыполнитьДействиеПоСообщению() 

Функция ПолучитьДанныеПоЗапросу(ТекСоединениеВИБ,ДанныеДляЗапроса,ИмяФункции) Экспорт

	Перем Результат;
	
	Выполнить "Результат = "+ИмяФункции+"(ТекСоединениеВИБ,ДанныеДляЗапроса)";
	
	Возврат Результат;
		
КонецФункции // ВыполнитьДействиеПоЗапросу()

Процедура ПаузаMS(КоличествоMS)
	
	ВремяНачала=ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Пока Истина Цикл
		
		ТекущееВремя=ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		Если (ТекущееВремя-ВремяНачала)>=КоличествоMS Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПаузаMS() 

Функция ПолучитьОтвет1СШина(ТекСоединениеВИБ,ТипСообщения,СтруктураПараметров) Экспорт

	ПараметрыСообщения=Новый Структура;
	
	ПараметрыСообщения.Вставить("ТипСообщения",		ТипСообщения);
	
	Если ТипЗнч(СтруктураПараметров)=Тип("Структура")
		И СтруктураПараметров.Свойство("GUIDТекущейИБ")
		И (НЕ Константы.ЭтоЦентрализованнаяБазаНСИ.Получить()) Тогда
		
		ПараметрыСообщения.Вставить("GUIDТекущейИБ",СтруктураПараметров.GUIDТекущейИБ);
		ПараметрыСообщения.Вставить("КодОтправителя","");
		ПараметрыСообщения.Вставить("КодПолучателя",	ТекСоединениеВИБ);
		ПараметрыСообщения.Вставить("СервисИнтеграции",	"CPMExchangeExternal");
		ПараметрыСообщения.Вставить("КаналОтправки",	"CPM_Data_Exchange_From_External");
		
	Иначе
		
		ПараметрыСообщения.Вставить("КодОтправителя",	Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ.КодИнформационнойСистемы);
		ПараметрыСообщения.Вставить("КодПолучателя",	ТекСоединениеВИБ);
		ПараметрыСообщения.Вставить("СервисИнтеграции",	"CPMExchangeMaster");
		ПараметрыСообщения.Вставить("КаналОтправки",	"CPM_Data_Exchange_From_CPM");
		
	КонецЕсли;
			
	ИдентификаторСообщения=Новый УникальныйИдентификатор;
	ПараметрыСообщения.Вставить("ИдентификаторСообщения",Строка(ИдентификаторСообщения));	
		
	ОтправитьСообщение1СШина(ПараметрыСообщения,СтруктураПараметров); 
		
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	|	ЖурналОбменаСообщениямиШина.ДанныеОтвета КАК ДанныеОтвета
	|ИЗ
	|	&ЖурналОбменаСообщениями КАК ЖурналОбменаСообщениямиШина
	|ГДЕ
	|	ЖурналОбменаСообщениямиШина.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ЖурналОбменаСообщениями","РегистрСведений.ЖурналОбменаСообщениямиШина");
	Запрос.Текст=ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения",ИдентификаторСообщения);
	
	Для Индекс=1 ПО 3000 Цикл
				
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			ДанныеОтвета = Результат.ДанныеОтвета.Получить();
			
			НаборЗаписей=РегистрыСведений["ЖурналОбменаСообщениямиШина"].СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдентификаторСообщения.Установить(ИдентификаторСообщения);
			НаборЗаписей.Записать();
			
			Возврат ДанныеОтвета;
			
		КонецЕсли;
		
		ПаузаMS(100);
		
	КонецЦикла;	
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ОбщегоНазначенияУХ")=Неопределено Тогда
		
		МодульОбщегоНазначения=ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияУХ");
		
		МодульОбщегоНазначения.СообщитьОбОшибке(Нстр("ru = 'Превышено время ожидания ответа от информационной базы '")+ТекСоединениеВИБ,,,СтатусСообщения.Внимание);
		
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции // ПолучитьОтвет1СШина()



	

#КонецОбласти 

#Область Трансляция

Функция ПолучитьШаблонТаблицыРегистра(ТекСоединениеВИБ,ДанныеОбъекта) 
	
	МаксКоличествоСубконто=ДанныеОбъекта.МаксКоличествоСубконто;
	
	Запрос=ТекСоединениеВИБ.NewObject("Запрос");
	ТекстЗапроса="ВЫБРАТЬ Первые 1
	|	ДвиженияССубконто.Период КАК Период,
	|	ДвиженияССубконто.Регистратор КАК Регистратор,
	|	ДвиженияССубконто.СчетДт.Код КАК СчетДтКод,
	|	ДвиженияССубконто.СчетКт.Код КАК СчетКтКод,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		ТекстЗапроса=ТекстЗапроса+"
		|	ДвиженияССубконто.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|	ДвиженияССубконто.СубконтоКт"+Индекс+" КАК СубконтоКт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоДт"+Индекс+" КАК ВидСубконтоДт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоКт"+Индекс+" КАК ВидСубконтоКт"+Индекс+",";
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	&ТекстРесурсы, 
	|	&ТекстИзмерения,
	|	ДвиженияССубконто.Содержание КАК Содержание,	
	|	ДвиженияССубконто.Активность КАК Активность
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(,,,,) КАК ДвиженияССубконто";
	
	ТекстРесурсы="";
	ТекстИзмерения="";
		
	Для Каждого Ресурс ИЗ ДанныеОбъекта.ДанныеРегистра.Ресурсы Цикл
		
		Если Ресурс.Балансовый Тогда
			ТекстРесурсы=ТекстРесурсы+",
			|ДвиженияССубконто."+Ресурс.Имя+" КАК "+Ресурс.Имя;
		Иначе
			ТекстРесурсы=ТекстРесурсы+",
			|ДвиженияССубконто."+Ресурс.Имя+"Дт КАК "+Ресурс.Имя+"Дт,
			|ДвиженияССубконто."+Ресурс.Имя+"Кт КАК "+Ресурс.Имя+"Кт";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Измерение ИЗ ДанныеОбъекта.ДанныеРегистра.Измерения Цикл
		
		Если Измерение.Балансовый Тогда
			ТекстИзмерения=ТекстИзмерения+",
			|ДвиженияССубконто."+Измерение.Имя+" КАК "+Измерение.Имя;
		Иначе
			ТекстИзмерения=ТекстИзмерения+",
			|ДвиженияССубконто."+Измерение.Имя+"Дт КАК "+Измерение.Имя+"Дт,
			|ДвиженияССубконто."+Измерение.Имя+"Кт КАК "+Измерение.Имя+"Кт";
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстРесурсы",Сред(ТекстРесурсы,3));
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстИзмерения",Сред(ТекстИзмерения,3));
				
	Запрос.Текст=СтрЗаменить(ТекстЗапроса,"Хозрасчетный",ДанныеОбъекта.ДанныеРегистра.Наименование);	
	
	Возврат Запрос.Выполнить().Выгрузить().СкопироватьКолонки();
		
КонецФункции // ПолучитьШаблонТаблицыРегистра() 

Функция ПолучитьДанныеОбъектаCOM(ТекСоединениеВИБ,ЗначениеCOM)
	
	ТипДанных=РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьXMLTypeOf(ТекСоединениеВИБ,ЗначениеCOM);
	
	Если ТипДанных=Неопределено Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	СтрокаТипа=ТипДанных.TypeName;		
	СтруктураОбъекта=Новый Структура("ТипЗначения, Значение", СтрокаТипа, РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьXMLString(ТекСоединениеВИБ,ЗначениеCOM));
	
	Возврат СтруктураОбъекта;
			
КонецФункции // ПолучитьДанныеСсылки() 

Функция ПолучитьДанныеИсточника(ТекСоединениеВИБ,ДанныеОбъекта,СтрокаДанные)
	
	Если НЕ ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ДанныеИсточника=Новый Структура;
	НеТранслируетсяПричина="";
	
	Для Индекс=1 ПО ДанныеОбъекта.ДанныеРегистра.МаксимальноеКоличествоСубконто Цикл
		
		ДанныеИсточника.Вставить("СубконтоДтИсточник"+Индекс,ПолучитьДанныеОбъектаCOM(ТекСоединениеВИБ,СтрокаДанные["СубконтоДт"+Индекс]));
		ДанныеИсточника.Вставить("СубконтоКтИсточник"+Индекс,ПолучитьДанныеОбъектаCOM(ТекСоединениеВИБ,СтрокаДанные["СубконтоКт"+Индекс]));
		
		ДанныеИсточника.Вставить("СубконтоДтИсточник"+Индекс+"Представление",СтрокаДанные["СубконтоДт"+Индекс+"Представление"]);
		ДанныеИсточника.Вставить("СубконтоКтИсточник"+Индекс+"Представление",СтрокаДанные["СубконтоКт"+Индекс+"Представление"]);
			
	КонецЦикла; 
	
	ДанныеИсточника.Вставить("НеТранслируетсяПричина",НеТранслируетсяПричина);
	
	Для Каждого СтрокаРесурс ИЗ ДанныеОбъекта.РесурсыДляОтображения Цикл
		
		Если ЗначениеЗаполнено(СтрокаРесурс.РесурсИсточник)
			И ЗначениеЗаполнено(СтрокаРесурс.РесурсПриемник)
			И СтрокаРесурс.РесурсИсточникБалансовый Тогда
		
			ДанныеИсточника.Вставить(СтрокаРесурс.РесурсИсточник+"_Источник",СтрокаДанные[СтрокаРесурс.РесурсИсточник]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СтрокаДанные.Владелец().Колонки.Найти("Регистратор")=Неопределено Тогда
		
		ДанныеИсточника.Вставить("Регистратор",ПолучитьДанныеОбъектаCOM(ТекСоединениеВИБ,СтрокаДанные.Регистратор));
		ДанныеИсточника.Вставить("РегистраторПредставление",СтрокаДанные.РегистраторПредставление);

		
	КонецЕсли; 
	
	ДанныеИсточника.Вставить("ПериодИсточник",СтрокаДанные.Период);
	
	Для Каждого Измерение ИЗ ДанныеОбъекта.ДанныеРегистра.Измерения Цикл
		
		Если Измерение.Балансовый Тогда
			
			ДанныеИсточника.Вставить(Измерение.Имя+"Источник",ПолучитьДанныеОбъектаCOM(ТекСоединениеВИБ,СтрокаДанные[Измерение.Имя]));
			ДанныеИсточника.Вставить(Измерение.Имя+"ИсточникПредставление",СтрокаДанные[Измерение.Имя+"Представление"]);
					
		Иначе
			
			ДанныеИсточника.Вставить(Измерение.Имя+"ДтИсточник",ПолучитьДанныеОбъектаCOM(ТекСоединениеВИБ,СтрокаДанные[Измерение.Имя+"Дт"]));
			ДанныеИсточника.Вставить(Измерение.Имя+"КтИсточник",ПолучитьДанныеОбъектаCOM(ТекСоединениеВИБ,СтрокаДанные[Измерение.Имя+"Кт"]));
			
			ДанныеИсточника.Вставить(Измерение.Имя+"ДтИсточникПредставление",СтрокаДанные[Измерение.Имя+"ДтПредставление"]);
			ДанныеИсточника.Вставить(Измерение.Имя+"КтИсточникПредставление",СтрокаДанные[Измерение.Имя+"КтПредставление"]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеИсточника.Вставить("СчетДтИсточникКод",ДанныеОбъекта.СчетДтИсточникКод);
	ДанныеИсточника.Вставить("СчетКтИсточникКод",ДанныеОбъекта.СчетКтИсточникКод);
	
	Возврат ДанныеИсточника;
		
КонецФункции // ПолучитьДанныеИсточника() 

Функция GetTranslationData(ТекСоединениеВИБ,ДанныеДляТрансляции) Экспорт
	
	ЗапросТаблица							= ПодготовитьЗапросДляПолученияДанных(ТекСоединениеВИБ, ДанныеДляТрансляции.ДанныеЗапросаКорреспонденция);
	ЗапросТаблица.Text 						= ДанныеДляТрансляции.ДанныеЗапросаКорреспонденция.ТекстЗапроса;
	ЗапросТаблица.МенеджерВременныхТаблиц	= ТекСоединениеВИБ.NewObject("МенеджерВременныхТаблиц");
	ЗапросТаблица.SetParameter("CчетДтИсточникКод",ДанныеДляТрансляции.СчетДтИсточникКод);
	ЗапросТаблица.SetParameter("CчетКтИсточникКод",ДанныеДляТрансляции.СчетКтИсточникКод);
	
	Если ДанныеДляТрансляции.Свойство("ДопОтборИсточник") Тогда
		
		УстановитьПараметрыЗапроса(ТекСоединениеВИБ,ЗапросТаблица,ДанныеДляТрансляции.ДопОтборИсточник.ИспользуемыеПараметры,Неопределено,ДанныеДляТрансляции.ДанныеЗапросаКорреспонденция);
		
	КонецЕсли;	
	
	ТаблицаПроводок=ЗапросТаблица.Выполнить().Выгрузить();
	ТаблицаПроводок.Колонки.Добавить("НомерПроводки",ВИБ_ПолучитьОписаниеТиповЧисла(ТекСоединениеВИБ,9));
	
	НомерПроводки=1;
	
	Для Каждого СтрокаПроводка ИЗ ТаблицаПроводок Цикл
		
		СтрокаПроводка.НомерПроводки=НомерПроводки;
		НомерПроводки=НомерПроводки+1;
			
	КонецЦикла; 

	ЗапросДвижения=ТекСоединениеВИБ.NewObject("Запрос");
	ЗапросДвижения.МенеджерВременныхТаблиц=ТекСоединениеВИБ.NewObject("МенеджерВременныхТаблиц");
	ЗапросДвижения.Текст="ВЫБРАТЬ ТаблицаПроводок.* Поместить ПроводкиПоОтбору
	|ИЗ &ТаблицаПроводок КАК ТаблицаПроводок
	|Индексировать ПО НомерПроводки";
	ЗапросДвижения.Параметры.Вставить("ТаблицаПроводок",ТаблицаПроводок);
	ЗапросДвижения.Выполнить(); 
	
	МассивОбработанных=ТекСоединениеВИБ.NewObject("Массив");
	
	ТаблицаРезультата=ТекСоединениеВИБ.NewObject("ТаблицаЗначений");
	ТаблицаРезультата.Колонки.Добавить("СчетДтПриемникКод");
	ТаблицаРезультата.Колонки.Добавить("СчетКтПриемникКод");
	ТаблицаРезультата.Колонки.Добавить("РабочаяТаблица");
	ТаблицаРезультата.Колонки.Добавить("ИндексТрансляции");
	
	Для Индекс=0 По ДанныеДляТрансляции.РабочаяТаблицаВИБ.Количество()-1 Цикл
		
		РабочаяСтрока=ДанныеДляТрансляции.РабочаяТаблицаВИБ[Индекс]; 
		УстановитьПараметрыЗапроса(ТекСоединениеВИБ, ЗапросДвижения, РабочаяСтрока.ДанныеДляЗапроса.ИспользуемыеПараметры, Неопределено,РабочаяСтрока.ДанныеДляЗапроса);				
		
		ТекстЗапроса=СтрЗаменить(РабочаяСтрока.ДанныеДляЗапроса.ТекстЗапроса,"ВЫБРАТЬ ","ВЫБРАТЬ НомерПроводки КАК НомерПроводки,");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"ГДЕ ","ГДЕ (ПроводкиПоОтбору.НомерПроводки НЕ В(&МассивОбработанных)) И ");
		ТекстЗапроса=ТекстЗапроса+",НомерПроводки";
		
		ЗапросДвижения.УстановитьПараметр("МассивОбработанных",МассивОбработанных);
		ЗапросДвижения.Текст=ТекстЗапроса;
		
		ТаблицаДанных=ЗапросДвижения.Execute().Unload();
		
		Если ТаблицаДанных.Количество()>0 Тогда 
			
			Если ДанныеДляТрансляции.Свойство("ДетальнаяТрансляция") Тогда
				
				ТаблицаДанных.Колонки.Добавить("ДанныеИсточника");
				
			КонецЕсли;
			
			Для Каждого СтрокаПроводка ИЗ ТаблицаДанных Цикл 
				
				МассивОбработанных.Добавить(СтрокаПроводка.НомерПроводки);
				
				Если ДанныеДляТрансляции.Свойство("ДетальнаяТрансляция") Тогда
					
					СтруктураПоиска=ТекСоединениеВИБ.NewObject("Структура");
					СтруктураПоиска.Вставить("НомерПроводки",СтрокаПроводка.НомерПроводки);

					ИсходнаяПроводка=ТаблицаПроводок.НайтиСтроки(СтруктураПоиска).Get(0);	
					СтрокаПроводка.ДанныеИсточника=ПолучитьДанныеИсточника(ТекСоединениеВИБ,ДанныеДляТрансляции,ИсходнаяПроводка);
					
				КонецЕсли;
				
			КонецЦикла;
			
			НоваяСтрока=ТаблицаРезультата.Добавить();
			НоваяСтрока.СчетДтПриемникКод=РабочаяСтрока.СчетДтПриемникКод;
			НоваяСтрока.СчетКтПриемникКод=РабочаяСтрока.СчетКтПриемникКод;
			НоваяСтрока.РабочаяТаблица=ТаблицаДанных;
			НоваяСтрока.ИндексТрансляции=РабочаяСтрока.ИндексТрансляции;
			
		КонецЕсли;
		
		Если МассивОбработанных.Количество()=ТаблицаПроводок.Количество() Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
		
	
	ИтоговаяТаблица=Новый ТаблицаЗначений;
	ИтоговаяТаблица.Колонки.Добавить("СчетДтПриемникКод");
	ИтоговаяТаблица.Колонки.Добавить("СчетКтПриемникКод");
	ИтоговаяТаблица.Колонки.Добавить("ДанныеДляПереноса");
	ИтоговаяТаблица.Колонки.Добавить("ИндексТрансляции");
	
	Для Каждого СтрокаВИБ ИЗ ДанныеДляТрансляции.РабочаяТаблицаВИБ Цикл
		
		СтруктураПоиска=ТекСоединениеВИБ.NewObject("Структура");
		СтруктураПоиска.Вставить("СчетДтПриемникКод",СтрокаВИБ.СчетДтПриемникКод);
		СтруктураПоиска.Вставить("СчетКтПриемникКод",СтрокаВИБ.СчетКтПриемникКод);
		СтруктураПоиска.Вставить("ИндексТрансляции",СтрокаВИБ.ИндексТрансляции);
		
		СтрокиИтог=ТаблицаРезультата.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиИтог.Количество()=0 Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Для Индекс=0 ПО СтрокиИтог.Количество()-1 Цикл
			
			РабочаяСтрока=СтрокиИтог.Get(Индекс);
			
			Если Индекс=0 Тогда
				
				РабочаяТаблицаИтог=РабочаяСтрока.РабочаяТаблица;
				
			Иначе
				
				Для Каждого Строка ИЗ РабочаяСтрока.РабочаяТаблица Цикл
					
					НоваяСтрока=РабочаяТаблицаИтог.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		НоваяСтрока=ИтоговаяТаблица.Добавить();
		НоваяСтрока.СчетДтПриемникКод=СтрокаВИБ.СчетДтПриемникКод;
		НоваяСтрока.СчетКтПриемникКод=СтрокаВИБ.СчетКтПриемникКод;
		НоваяСтрока.ДанныеДляПереноса=ПолучитьДанныеДляПереноса(ТекСоединениеВИБ,РабочаяТаблицаИтог);
		НоваяСтрока.ИндексТрансляции=СтрокаВИБ.ИндексТрансляции;
		
	КонецЦикла; 
	
	Возврат ИтоговаяТаблица; 
	
КонецФункции // GetTranslationData() 

#КонецОбласти 