#КонецОбласти  

#Область Обмен_Шина

Функция ПодготовитьДанныеДляСериализации(ИсходныеДанные) Экспорт
	
	Если ТипЗнч(ИсходныеДанные)=Тип("ТаблицаЗначений") Тогда
		
		Возврат ПреобразоватьТаблицуЗначенийВСтруктуру(ИсходныеДанные);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные)=Тип("Структура") Тогда
		
		Возврат ПодготовитьСтруктуруДляПередачиДанных(ИсходныеДанные);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные)=Тип("Массив") Тогда
		
		Возврат ПодготовитьМассивДляПередачиДанных(ИсходныеДанные);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные)=Тип("Соответствие") Тогда
		
		Возврат ПодготовитьСоответствиеДляПередачиДанных(ИсходныеДанные);
		
	ИначеЕсли ПримитивныйТип(ТипЗнч(ИсходныеДанные)) Тогда
		
		Возврат ИсходныеДанные; 
		
	ИначеЕсли ТипЗнч(ИсходныеДанные)=Тип("ТабличныйДокумент") Тогда
		
		Возврат ЗначениеВСтрокуВнутр(ИсходныеДанные);
		
	Иначе
		
		Возврат Строка(ИсходныеДанные);
		
	КонецЕсли;
		
КонецФункции // ПодготовитьДанныеДляСериализации() 

Функция ПреобразоватьТаблицуЗначенийВСтруктуру(ИсходнаяТаблица) Экспорт
	
	СтруктураКолонок=Новый Структура;
	
	ТипСтрока		= Тип("Строка");
	ТипДата			= Тип("Дата");
	ТипЧисло		= Тип("Число");
	ТипБулево		= Тип("Булево");
	
	Для Каждого Колонка ИЗ ИсходнаяТаблица.Колонки Цикл
		
		СтрокаТип="";
		
		Для Каждого Тип ИЗ Колонка.ТипЗначения.Типы() Цикл
			
			Если Тип=ТипСтрока Тогда
				
				СтрокаТип="Строка"+";"+Колонка.ТипЗначения.КвалификаторыСтроки.Длина;
				
			ИначеЕсли Тип=ТипДата Тогда
				
				СтрокаТип="Дата";
				
			ИначеЕсли Тип=ТипЧисло Тогда 
				
				Разрядность=Колонка.ТипЗначения.КвалификаторыЧисла.Разрядность;
				РазрядностьДробнойЧасти=Колонка.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти;
				
				СтрокаТип="Число"+";"+Разрядность+";"+РазрядностьДробнойЧасти;
				
			ИначеЕсли Тип=ТипБулево Тогда
				
				СтрокаТип="Булево";
				
			КонецЕсли;
			
			Если Не ПустаяСтрока(СтрокаТип) Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураКолонок.Вставить(Колонка.Имя,СтрокаТип);
		
	КонецЦикла;
	
	МассивДанных=Новый Массив;
	
	Для Индекс=0 ПО ИсходнаяТаблица.Количество()-1 Цикл
		
		СтруктураСтрока=Новый Структура;
		ТекущаяСтрока=ИсходнаяТаблица[Индекс];
		
		Для Каждого Элемент ИЗ СтруктураКолонок Цикл
			
			СтруктураСтрока.Вставить(Элемент.Ключ,ПодготовитьДанныеДляСериализации(ТекущаяСтрока[Элемент.Ключ]));
			
		КонецЦикла;
		
		МассивДанных.Вставить(Индекс,СтруктураСтрока);
		
	КонецЦикла;
	
	Возврат Новый Структура("СтруктураКолонок,Данные",СтруктураКолонок,МассивДанных);	
	
КонецФункции // ПреобразоватьТаблицуЗначенийВСтруктуру()

Функция ПреобразоватьСтруктуруВТаблицуЗначений(ИсходнаяСтруктура)
	
	ТаблицаИтог=Новый ТаблицаЗначений;
	
	Для Каждого Элемент ИЗ ИсходнаяСтруктура.СтруктураКолонок Цикл
		
		Если Элемент.Значение="" Тогда
			
			ТаблицаИтог.Колонки.Добавить(Элемент.Ключ);			
			
		Иначе
			
			ДанныеТипа=СтрРазделить(Элемент.Значение,";");
			
			Если ДанныеТипа[0]="Дата" Тогда
				
				ТекущийТип=ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя);
				
			ИначеЕсли ДанныеТипа[0]="Булево" Тогда
				
				ТекущийТип=ПолучитьОписаниеТиповБулево();
				
			ИначеЕсли ДанныеТипа[0]="Строка" Тогда
				
				ТекущийТип=ПолучитьОписаниеТиповСтроки(ДанныеТипа[1]);
				
			Иначе
				
				ТекущийТип=ПолучитьОписаниеТиповЧисла(ДанныеТипа[1],ДанныеТипа[2]);
				
			КонецЕсли;
			
			ТаблицаИтог.Колонки.Добавить(Элемент.Ключ,ТекущийТип);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИсходнаяСтруктура.Данные.Количество()>0 Тогда
				
		Для Индекс=0 ПО ИсходнаяСтруктура.Данные.Количество()-1 Цикл
			
			НоваяСтрока=ТаблицаИтог.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ПолучитьДанныеДляОбработки(ИсходнаяСтруктура.Данные[Индекс]));
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаИтог;
				
КонецФункции // ПреобразоватьСтруктуруВТаблицуЗначений()

Функция ПолучитьДанныеДляОбработки(ИсходныеДанные) Экспорт
	
	Если ТипЗнч(ИсходныеДанные)=Тип("Структура") Тогда
		
		Если ИсходныеДанные.Свойство("СтруктураКолонок") Тогда
			
			Возврат ПреобразоватьСтруктуруВТаблицуЗначений(ИсходныеДанные);
			
		Иначе
			
			Возврат ПодготовитьСтруктуруДляОбработки(ИсходныеДанные); 
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ИсходныеДанные)=Тип("Массив") Тогда
		
		Возврат ПодготовитьМассивДляОбработки(ИсходныеДанные);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные)=Тип("Соответствие") Тогда
		
		Возврат ПодготовитьСоответствиеДляОбработки(ИсходныеДанные);
		
	Иначе
		
		Возврат ИсходныеДанные;
			
	КонецЕсли;
		
КонецФункции // ПодготовитьДанныеДляОбработки() 

Функция ПодготовитьСтруктуруДляОбработки(ИсходнаяСтруктура)
	
	СтруктураОбработки=Новый Структура;
	
	Для Каждого Элемент ИЗ ИсходнаяСтруктура Цикл 
		
		Если Элемент.Ключ="ТаблицаДляОтображения" Тогда
			
			СтруктураОбработки.Вставить(Элемент.Ключ,ЗначениеИзСтрокиВнутр(Элемент.Значение));
			
		Иначе		
			
			СтруктураОбработки.Вставить(Элемент.Ключ,ПолучитьДанныеДляОбработки(Элемент.Значение));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураОбработки;
		
КонецФункции // ПодготовитьСтруктуруДляОбработки()

Функция ПодготовитьСтруктуруДляПередачиДанных(ИсходнаяСтруктура)
	
	СтруктураПередачи=Новый Структура;
	
	Для Каждого Элемент ИЗ ИсходнаяСтруктура Цикл
		
		СтруктураПередачи.Вставить(Элемент.Ключ,ПодготовитьДанныеДляСериализации(Элемент.Значение));
		
	КонецЦикла;
	
	Возврат СтруктураПередачи;
		
КонецФункции // ПодготовитьСтруктуруДляПередачиДанных()

Функция ПодготовитьМассивДляПередачиДанных(ИсходныйМассив)
	
	МассивПередачи=Новый Массив;
	
	Для Индекс=0 По ИсходныйМассив.Количество()-1 Цикл
		
		МассивПередачи.Вставить(Индекс,ПодготовитьДанныеДляСериализации(ИсходныйМассив[Индекс]));
		
	КонецЦикла;
	
	Возврат МассивПередачи;
		
КонецФункции // ПодготовитьМассивДляПередачиДанных()

Функция ПодготовитьМассивДляОбработки(ИсходныйМассив)
	
	МассивОбработки=Новый Массив;
	
	Для Индекс=0 По ИсходныйМассив.Количество()-1 Цикл
		
