
Функция ЭтоТекущаяИБ(База) Экспорт
	
	Возврат База = Неопределено 
	ИЛИ ТипЗнч(База) = Тип("ОбработкаОбъект.РаботаСМетаданнымиУХ");

КонецФункции 

Функция ПолучитьКодЯзыкаДляОписаний() Экспорт
	
	Для Каждого Язык ИЗ Метаданные.Языки Цикл
		
		Если Язык.КодЯзыка="en" Тогда
			
			Возврат Язык.КодЯзыка;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат Метаданные.ОсновнойЯзык.КодЯзыка;	
	
КонецФункции // ПолучитьКодЯзыкаДляОписаний() 

Функция ПолучитьЗначениеИзКэша(Кэш, Ресурс, Ключ, Значение)	Экспорт
	
	Если Кэш = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
		
	КэшРесурса = Кэш.Данные[Ресурс];
	Если КэшРесурса = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КлючДляКэша = КлючДляКэша(Кэш, Ключ);
	
	СтрокаКэша = КэшРесурса.Найти(КлючДляКэша, "Ключ");
	Если СтрокаКэша <> Неопределено Тогда
		Значение = СтрокаКэша.Значение;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции 

Функция КлючДляКэша(Кэш, Ключ)
	
	Если ЭтоCOMПодключениеИзКэша(Кэш) Тогда
		Возврат ПодключениеИзКэша(Кэш).ValueToStringInternal(Ключ);
	Иначе			
		Возврат Ключ;
	КонецЕсли;
	
КонецФункции 

Функция ПодключениеИзКэша(Кэш) Экспорт
	
	База = РаботаСОбъектамиМетаданныхВнешнийУХ.ПараметрИзКэша(Кэш, "СоединениеИБ");	
	Возврат База;
	
КонецФункции


Функция ЭтоCOMПодключениеИзКэша(Кэш) Экспорт
	Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПараметрИзКэша(Кэш, "ЭтоCOMПодключение") = Истина;
КонецФункции

Процедура СохранитьЗначениеВКэш(Кэш, Ресурс, Ключ, Значение) Экспорт	
	
	Если Кэш = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КэшРесурса = Кэш.Данные[Ресурс];
	Если КэшРесурса = Неопределено Тогда
		КэшРесурса = Новый ТаблицаЗначений;
		КэшРесурса.Колонки.Добавить("Ключ");
		КэшРесурса.Колонки.Добавить("Значение");
		КэшРесурса.Индексы.Добавить("Ключ");
		
		Кэш.Данные.Вставить(Ресурс, КэшРесурса);
	КонецЕсли;
	
	КлючДляКэша = КлючДляКэша(Кэш, Ключ);
	
	СтрокаКэша = КэшРесурса.Добавить();
	СтрокаКэша.Ключ = КлючДляКэша;
	СтрокаКэша.Значение = Значение;
	
КонецПроцедуры 

Функция ПараметрИзКэша(Кэш, ИмяПараметра) Экспорт
	Возврат Кэш.Параметры[ИмяПараметра];
КонецФункции 

Функция СохранитьПараметрВКэш(Кэш, ИмяПараметра, ЗначениеПараметра) Экспорт
	Кэш.Параметры.Вставить(ИмяПараметра, ЗначениеПараметра);
КонецФункции

Функция НовыйКэшОбновленияМетаданных() Экспорт
	
	Кэш = Новый Структура;
	Кэш.Вставить("Параметры", Новый Соответствие);
	Кэш.Вставить("Данные", Новый Соответствие);
	Возврат Кэш;
	
КонецФункции

Процедура ИнициализироватьКэш(Кэш, База) Экспорт
	
	ИмяПараметра = "КэшИнициализирован";
	КэшИнициализирован = РаботаСОбъектамиМетаданныхВнешнийУХ.ПараметрИзКэша(Кэш, ИмяПараметра);
	Если КэшИнициализирован = Неопределено Тогда
		СохранитьПодключениеВКэш(Кэш, База);
		Если ЭтоCOMПодключениеИзКэша(Кэш) ИЛИ ЭтоТекущаяИБИзКэша(Кэш) Тогда
			РаботаСОбъектамиМетаданныхВнешнийУХ.СохранитьПараметрВКэш(Кэш, "ПримитивныеXMLТипы", 
				РаботаСОбъектамиМетаданныхВнешнийУХ.ПримитивныеXMLТипыБазы(База));
		КонецЕсли;	
		РаботаСОбъектамиМетаданныхВнешнийУХ.СохранитьПараметрВКэш(Кэш, ИмяПараметра, Истина);
	КонецЕсли;	
	
КонецПроцедуры

Функция ЭтоТекущаяИБИзКэша(Кэш)
	Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПараметрИзКэша(Кэш, "ЭтоТекущаяИБ") = Истина;
КонецФункции

Процедура СохранитьПодключениеВКэш(Кэш, ТекСоединение) Экспорт
	
	ЭтоТекущаяИБ = Ложь;
	ЭтоCOMПодключение = Ложь;
	ЭтоWSПодключение = Ложь;
	
	Если РаботаСОбъектамиМетаданныхВнешнийУХ.ЭтоТекущаяИБ(ТекСоединение) Тогда		
		ЭтоТекущаяИБ = Истина;		
	ИначеЕсли ТипЗнч(ТекСоединение) = Тип("WSProxy")
		ИЛИ ТипЗнч(ТекСоединение) = Тип("Строка") Тогда	
		ЭтоWSПодключение = Истина;
	Иначе
		ЭтоCOMПодключение = Истина;
	КонецЕсли;
	
	РаботаСОбъектамиМетаданныхВнешнийУХ.СохранитьПараметрВКэш(Кэш, "ЭтоТекущаяИБ", ЭтоТекущаяИБ);
	РаботаСОбъектамиМетаданныхВнешнийУХ.СохранитьПараметрВКэш(Кэш, "ЭтоCOMПодключение", ЭтоCOMПодключение);
	РаботаСОбъектамиМетаданныхВнешнийУХ.СохранитьПараметрВКэш(Кэш, "ЭтоWSПодключение", ЭтоWSПодключение);
	
	Если ЭтоCOMПодключение Тогда
		РаботаСОбъектамиМетаданныхВнешнийУХ.СохранитьПараметрВКэш(Кэш, "СоединениеИБ", ТекСоединение);
	КонецЕсли;	
	
КонецПроцедуры 

