#Область  ПрограммныйИнтерфейс

// Функция - Тип ограничения документа базы
//
// Параметры:
//  ВидДокумента - Строка	 - вид документа
// 
// Возвращаемое значение:
//   Массив - массив типов ограничений
//
Функция ТипОграниченияДокументаБазы(ВидДокумента) Экспорт
			
	ТипОграничения 	= Новый Массив;
	ИмяДанных 		= ИмяМетаданныхОбъектаБД(ВидДокумента);
	ТипОграничения.Добавить(Тип(ИмяДанных));
	
	Возврат   ТипОграничения;
	
КонецФункции // ()   

// Процедура - заполняет признаки файлов объектов подтверждающих документов 
//
// Параметры:
//  Объект	 - ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств	- заявка в которой выводим подтверждающие документы
//
Процедура ЗаполнитьПризнакиФайловОбъектов(Объект)  Экспорт

	Запрос = Новый Запрос(          
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Заявка.ВидДокумента КАК ВидДокумента,
	| 	Заявка.Файл КАК Файл
	| ПОМЕСТИТЬ ВТЗаявка
	|ИЗ
	|	&ПодтверждающиеДокументы КАК Заявка
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Заявка.ВидДокумента КАК ВидДокумента,
	|	ЕСТЬNULL(Заявка.ВидДокумента.ПрисоединенныйФайл, ЛОЖЬ) КАК ПрисоединенныйФайл,
	|	ЕСТЬNULL(Заявка.ВидДокумента.ОбъектСистемы, ЛОЖЬ) КАК ОбъектСистемы,
	|	ВЫБОР
	|		КОГДА Заявка.Файл.ПодписанЭП
	|				И Заявка.Файл.Зашифрован
	|			ТОГДА 2
	|		КОГДА Заявка.Файл.Зашифрован
	|			ТОГДА 1
	|		КОГДА Заявка.Файл.ПодписанЭП
	|			ТОГДА 0
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК НомерКартинкиПодписанЗашифрован,
	|	ВЫБОР
	|		КОГДА Заявка.Файл.ПометкаУдаления = ИСТИНА
	|			ТОГДА ЕСТЬNULL(Заявка.Файл.ИндексКартинки, 2) + 1
	|		ИНАЧЕ ЕСТЬNULL(Заявка.Файл.ИндексКартинки, 2)
	|	КОНЕЦ КАК ИндексКартинки
	|ИЗ
	|	ВТЗаявка КАК Заявка
	|");
    Запрос.УстановитьПараметр("ПодтверждающиеДокументы", Объект.ПодтверждающиеДокументыУХ.Выгрузить());

	Выборка = Запрос.Выполнить().Выбрать();
	Для Каждого Стр Из Объект.ПодтверждающиеДокументыУХ Цикл
		Если Выборка.НайтиСледующий(Стр.ВидДокумента, "ВидДокумента") Тогда
			
			Стр.НаличиеФайла 						= Выборка.ПрисоединенныйФайл;
			Стр.НаличиеОбъекта 						= Выборка.ОбъектСистемы;    
			Стр.ИндексКартинки 						= Выборка.ИндексКартинки;    
			Стр.НомерКартинкиПодписанЗашифрован 	= Выборка.НомерКартинкиПодписанЗашифрован;    
	           
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры     

// Процедура - Установить основное оформление табличной части ПодтверждающиеДокументы заявки
//
// Параметры:
//  Форма	- ФормаКлиентскогоПриложения - форма документа ЗаявкаНаРасходованиеДенежныхСредств
//
Процедура УстановитьОсновноеОформлениеЗаявки(Форма) Экспорт
	
		ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПодтверждающиеДокументыУХФайл");
		
		//
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
			ЭлементУО.Отбор,
			"Объект.ПодтверждающиеДокументыУХ.НаличиеФайла", 
			ВидСравненияКомпоновкиДанных.Равно,Ложь,,Истина);
		//
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",					НСтр("ru = '<Не используется>'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",			Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",				ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
		
	    ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПодтверждающиеДокументыУХОбъектСистемы");
		
		//
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
			ЭлементУО.Отбор,
			"Объект.ПодтверждающиеДокументыУХ.НаличиеОбъекта", 
			ВидСравненияКомпоновкиДанных.Равно,Ложь,,Истина);
		//
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",					НСтр("ru = '<Не используется>'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",			Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",				ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
   
КонецПроцедуры

// Функция - Получение массива пропущенных видов подтверждающих документов
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств	 - заявка , которая проверяется
// 
// Возвращаемое значение:
//   - 
//
Функция ПропущенныеВидыПодтверждающихДокументов(ДокументОбъект) Экспорт

	МассивВидов = РегистрыСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидыПодтверждающихДокументовОбязательные(ДокументОбъект.ВидОперацииУХ);
	
	МассивПропущенныхВидов = Новый Массив;
		
	Для каждого МассивВидовЭлемент Из МассивВидов Цикл
		Если  ДокументОбъект.ПодтверждающиеДокументыУХ.НайтиСтроки(Новый Структура("ВидДокумента", МассивВидовЭлемент)).Количество() <> 0  Тогда
			Продолжить;  				
		КонецЕсли;	
		МассивПропущенныхВидов.Добавить(МассивВидовЭлемент);
	КонецЦикла; 
	
	Возврат  МассивПропущенныхВидов;
	
КонецФункции // () 

// Процедура - Обработка проверки заполнения табличной части ПодтверждающиеДокументы заявки 
//
// Параметры:
//  ДокументОбъект	 - 	ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств - заявка
//  Отказ			 - 	Отказ 
//
Процедура ОбработкаПроверкиЗаполнения(ДокументОбъект, Отказ) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПодтверждающиеДокументы") Тогда
		Возврат;	                                                                          
	КонецЕсли;
	ПроверитьПропущенныеВидыЗаявки(ДокументОбъект, Отказ);	
	ПроверитьЗаполнениеПодтверждающихДокументов(ДокументОбъект, Отказ);

КонецПроцедуры

// Процедура - Заполнить виды подтверждающих документов
//
// Параметры:
//  ДокументОбъект			 - ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств - заявка
//  ЗаполнятьРеквизитыФормы	 - Булево	 - признак заполнения реквизитов формы
//
Процедура ЗаполнитьВидыПодтверждающихДокументов(ДокументОбъект, ЗаполнятьРеквизитыФормы = Истина) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПодтверждающиеДокументы") Тогда
		Возврат;	                                                                          
	КонецЕсли;

	Запрос 			= Новый Запрос;
	Запрос.Текст	= 
		"ВЫБРАТЬ
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ КАК ВидОперацииУХ,
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидПодтверждающегоДокумента КАК ВидПодтверждающихДокументов,
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.Обязателен КАК Обязателен,
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидПодтверждающегоДокумента.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидПодтверждающегоДокумента.ОбъектСистемы КАК ОбъектСистемы
		|ИЗ
		|	РегистрСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ КАК ВидыПодтверждающихДокументовПоВидамОперацийУХ
		|ГДЕ
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ = &ВидОперацииУХ";
	
	Запрос.УстановитьПараметр("ВидОперацииУХ", ДокументОбъект.ВидОперацииУХ);
	
	РезультатЗапроса 					= Запрос.Выполнить();
	
	НовыеВидыПодтверждающихДокументов 	= РезультатЗапроса.Выгрузить();
	
	МассивУдаления = Новый Массив;
	
	Для каждого СтрокаПодтверждающиеДокументы Из ДокументОбъект.ПодтверждающиеДокументыУХ  Цикл
	
		Если НовыеВидыПодтверждающихДокументов.НайтиСтроки(Новый Структура("ВидПодтверждающихДокументов", СтрокаПодтверждающиеДокументы.ВидДокумента)).Количество() = 0  Тогда
			
			МассивУдаления.Добавить(СтрокаПодтверждающиеДокументы);			
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Для каждого МассивУдаленияЭлемент Из  МассивУдаления Цикл
  		ДокументОбъект.ПодтверждающиеДокументыУХ.Удалить(МассивУдаленияЭлемент);
	КонецЦикла; 
	
	Для каждого СтрокаТЗ Из НовыеВидыПодтверждающихДокументов Цикл
		Если  ДокументОбъект.ПодтверждающиеДокументыУХ.НайтиСтроки(Новый Структура("ВидДокумента", СтрокаТЗ.ВидПодтверждающихДокументов)).Количество() <> 0  Тогда
			Продолжить;  				
		КонецЕсли;	
		
		СтрокаЗаявка 									= ДокументОбъект.ПодтверждающиеДокументыУХ.Добавить();
		СтрокаЗаявка.ВидДокумента  						= СтрокаТЗ.ВидПодтверждающихДокументов; 
		Если ЗаполнятьРеквизитыФормы Тогда
			СтрокаЗаявка.НаличиеФайла 						= СтрокаТЗ.ПрисоединенныйФайл;
			СтрокаЗаявка.НаличиеОбъекта 					= СтрокаТЗ.ОбъектСистемы;    
			СтрокаЗаявка.ИндексКартинки 					= 2;  
			СтрокаЗаявка.НомерКартинкиПодписанЗашифрован	= -1;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры  

// Процедура - Перенести обнаруженные файлы в заявке из присоединенных файлов
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств	 - заявка
//
Процедура ПеренестиОбнаруженныеФайлы(ДокументОбъект) Экспорт
	     	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаФайлы.ВладелецФайла КАК ВладелецФайла,
		|	ЗаявкаФайлы.Ссылка КАК Файл,
		|	ВЫБОР
		|		КОГДА ЗаявкаФайлы.ПодписанЭП
		|				И ЗаявкаФайлы.Зашифрован
		|			ТОГДА 2
		|		КОГДА ЗаявкаФайлы.Зашифрован
		|			ТОГДА 1
		|		КОГДА ЗаявкаФайлы.ПодписанЭП
		|			ТОГДА 0
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК НомерКартинкиПодписанЗашифрован,
		|	ВЫБОР
		|		КОГДА ЗаявкаФайлы.ПометкаУдаления = ИСТИНА
		|			ТОГДА ЕСТЬNULL(ЗаявкаФайлы.ИндексКартинки, 2) + 1
		|		ИНАЧЕ ЕСТЬNULL(ЗаявкаФайлы.ИндексКартинки, 2)
		|	КОНЕЦ КАК ИндексКартинки
		|ИЗ
		|	Справочник.ЗаявкаНаРасходованиеДенежныхСредствПрисоединенныеФайлы КАК ЗаявкаФайлы
		|ГДЕ
		|	ЗаявкаФайлы.ВладелецФайла = &ВладелецФайла";
	
	Запрос.УстановитьПараметр("ВладелецФайла", ДокументОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если  ДокументОбъект.ПодтверждающиеДокументыУХ.НайтиСтроки(Новый Структура("Файл", ВыборкаДетальныеЗаписи.Файл)).Количество() <> 0  Тогда
			Продолжить;  				
		КонецЕсли;	 
					
		СтрокаЗаявка 									= ДокументОбъект.ПодтверждающиеДокументыУХ.Добавить();
		СтрокаЗаявка.ВидДокумента  						= Справочники.ВидыПодтверждающихДокументовУХ.ПроизвольныйФайл; 
		СтрокаЗаявка.НаличиеФайла 						= Истина;
		СтрокаЗаявка.НаличиеОбъекта 					= Ложь;    
		СтрокаЗаявка.ИндексКартинки 					= ВыборкаДетальныеЗаписи.ИндексКартинки;  
		СтрокаЗаявка.Файл 								= ВыборкаДетальныеЗаписи.Файл;  
		СтрокаЗаявка.НомерКартинкиПодписанЗашифрован	= ВыборкаДетальныеЗаписи.НомерКартинкиПодписанЗашифрован;  
		
	КонецЦикла;

КонецПроцедуры

// Функция - Проверка есть ли не используемые файлы в заявке
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств	 - заявка
// 
// Возвращаемое значение:
//   - 
//
Функция ЕстьНеИспользуемыеФайлы(ДокументОбъект)  Экспорт
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаФайлы.Ссылка КАК Файл,
		|	ЗаявкаФайлы.ВладелецФайла КАК ВладелецФайла
		|ИЗ
		|	Справочник.ЗаявкаНаРасходованиеДенежныхСредствПрисоединенныеФайлы КАК ЗаявкаФайлы
		|ГДЕ
		|	ЗаявкаФайлы.ВладелецФайла = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ПризнакЕстьНеИспользуемыеФайлы = Ложь;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если  ДокументОбъект.ПодтверждающиеДокументыУХ.НайтиСтроки(Новый Структура("Файл", ВыборкаДетальныеЗаписи.Файл)).Количество() <> 0  Тогда
			Продолжить;  				
		КонецЕсли;
		
		ПризнакЕстьНеИспользуемыеФайлы = Истина;
		
	КонецЦикла; 
	
	Возврат ПризнакЕстьНеИспользуемыеФайлы;

КонецФункции

// УХ_Встраивание ++ 
Процедура ОбщиеДоработкиФормыЗаявки(Форма, Элементы, ПараметрыЭлементов)  Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПодтверждающиеДокументы") Тогда
		Возврат;	                                                                          
	КонецЕсли;      
	
	Элементы["СтраницаПодтверждающиеДокументы"].Заголовок = НСтр("ru = 'Подтверждающие документы ГОЗ'"); 
	
	ПараметрыЭлемента = Новый Структура;
	ПараметрыЭлемента.Вставить("ПутьКДаннымЗаголовка", 	"Объект.ПодтверждающиеДокументыУХ.КоличествоСтрок");
	СтраницаПодтверждающиеДокументыУХ = ФормыУХ.СоздатьГруппуФормы(Элементы, "СтраницаПодтверждающиеДокументыУХ", 
		НСтр("ru = 'Подтверждающие документы'"), ВидГруппыФормы.Страница, Элементы.ГруппаСтраницы, Элементы.СтраницаРаспределениеПоСчетам, ПараметрыЭлемента); 
		
	ЭлементПодтверждающиеДокументыУХ = ФормыУХ.СоздатьТаблицуФормы(Элементы, "ПодтверждающиеДокументыУХ", ,"Объект.ПодтверждающиеДокументыУХ", СтраницаПодтверждающиеДокументыУХ);
		
	ГруппаОбнаруженныеФайлы = ФормыУХ.СоздатьГруппуФормы(Элементы, "ГруппаОбнаруженныеФайлы",,, 
