Процедура ПроверитьПропущенныеВидыЗаявки(ДокументОбъект, Отказ) 
	
	МассивПропущенныхВидов = ПропущенныеВидыПодтверждающихДокументов(ДокументОбъект);
	Для каждого МассивЭлемент Из МассивПропущенныхВидов Цикл
		ШаблонСообщения = НСтр("ru = 'Отсутствует обязательный вид подтверждающих документов %1.'");
		ШаблонСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, МассивЭлемент);
		ОбщегоНазначения.СообщитьПользователю(ШаблонСообщения, ДокументОбъект, "ПодтверждающиеДокументыУХ", "Объект", Отказ);
	КонецЦикла;  
	
КонецПроцедуры	

Процедура ПроверитьЗаполнениеПодтверждающихДокументов(ДокументОбъект, Отказ) 
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заявка.Файл КАК Файл,  
		|	Заявка.НомерСтроки КАК НомерСтроки,
		|	Заявка.ОбъектСистемы КАК ОбъектСистемы,
		|	Заявка.ВидДокумента КАК ВидДокумента 
		|ПОМЕСТИТЬ ВТДокументы
		|ИЗ
		|	&ПодтверждающиеДокументы КАК Заявка
		|
        |;
		|ВЫБРАТЬ
   		|	Заявка.Файл КАК Файл, 
		|	Заявка.НомерСтроки КАК НомерСтроки,
		|	Заявка.ОбъектСистемы КАК ОбъектСистемы,
		|	ЕстьNULL(Заявка.ВидДокумента.ПрисоединенныйФайл, ЛОЖЬ) КАК ВидДокументаПрисоединенныйФайл,
		|	ЕстьNULL(Заявка.ВидДокумента.ОбъектСистемы, ЛОЖЬ) КАК ВидДокументаОбъектСистемы,
		|	Заявка.ВидДокумента КАК ВидДокумента    
		|ИЗ
		|	ВТДокументы КАК Заявка
		|	Левое соединение РегистрСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ КАК ВидыПодтверждающихДокументовПоВидамОперацийУХ
		|		ПО ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидПодтверждающегоДокумента = Заявка.ВидДокумента
		|		И ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ = &ВидОперацииУХ
		|ГДЕ
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.Обязателен";
    	
	Запрос.УстановитьПараметр("ПодтверждающиеДокументы", ДокументОбъект.ПодтверждающиеДокументыУХ.Выгрузить());
	Запрос.УстановитьПараметр("ВидОперацииУХ", ДокументОбъект.ВидОперацииУХ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ВидДокументаОбъектСистемы
			И НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОбъектСистемы) Тогда 
			ТекущаяСтрока = СтрШаблон("ПодтверждающиеДокументыУХ[%1].ОбъектСистемы",ВыборкаДетальныеЗаписи.НомерСтроки-1);
			ШаблонСообщения = НСтр("ru = 'Не выбран объект для вида документа %1.'");
			ШаблонСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ВыборкаДетальныеЗаписи.ВидДокумента);
			ОбщегоНазначения.СообщитьПользователю(ШаблонСообщения, ДокументОбъект,
			        		ТекущаяСтрока, "Объект", Отказ);
   		КонецЕсли;  
		
		Если ВыборкаДетальныеЗаписи.ВидДокументаПрисоединенныйФайл
			И НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Файл) Тогда 
			ТекущаяСтрока = СтрШаблон("ПодтверждающиеДокументыУХ[%1].Файл",ВыборкаДетальныеЗаписи.НомерСтроки-1);
			ШаблонСообщения = НСтр("ru = 'Не выбран файл для вида документа %1.'");
			ШаблонСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,  ВыборкаДетальныеЗаписи.ВидДокумента);
			ОбщегоНазначения.СообщитьПользователю(ШаблонСообщения, ДокументОбъект,
			        		ТекущаяСтрока, "Объект", Отказ);
 
		КонецЕсли;
 
	КонецЦикла;
КонецПроцедуры

Функция ИмяМетаданныхОбъектаБД(ВидДокумента) 

	 ОбъектБД 				= ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ВидДокумента, "ОбъектБД");
	 Если ОбъектБД = Неопределено Тогда
	 	 Возврат Неопределено;
	 КонецЕсли; 
	 
	 ОбъектБДНаименование   = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ОбъектБД, 	"Наименование");
	 Если ТипЗнч(ОбъектБД) = Тип("СправочникСсылка.СправочникиБД") Тогда
		 Возврат "СправочникСсылка." + ОбъектБДНаименование;
	 Иначе
		 Возврат "ДокументСсылка." + ОбъектБДНаименование;
	 КонецЕсли; 
	
КонецФункции // ()

