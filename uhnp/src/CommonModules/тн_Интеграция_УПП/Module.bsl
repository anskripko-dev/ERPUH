// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Функция НомерДокумента11Символов(Знач Номер, ДлинаНомера = 0)
	
	Если ДлинаНомера = 0 Тогда
		ДлинаНомера = 11;
	КонецЕсли;
	
	Если СтрДлина(Номер) <= ДлинаНомера Тогда
		Возврат Номер;
	КонецЕсли;
	
	//Длина номера = 12 (или ДлинаНомера + 1)
	//Отрежем первую цифру (сохраним префикс, а первая цифра, скорее всего, будет "0")
	Для НомерСимвола = 1 по СтрДлина(Номер) Цикл
		
		Символ = Сред(Номер, НомерСимвола, 1);
		// НАЧАЛО Борисенко Игорь 06.04.2022 Выполнение задач №000040898
		Если Символ = "" Тогда
			Продолжить;
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 06.04.2022 Выполнение задач №000040898
		
		Если СтрНайти("1234567890", Символ) > 0 Тогда
			//это первая цифра, этот символ удаляем из номера
			
			Номер = ?(НомерСимвола = 1, "", Лев(Номер, НомерСимвола - 1)) + Сред(Номер, НомерСимвола + 1);
			
			Если СтрДлина(Номер) <= ДлинаНомера Тогда
				Возврат Номер;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	//Цифр не нашлось - отрезаем крайний левый символ
	Возврат Прав(Номер, ДлинаНомера);
	
КонецФункции

