Функция ПолучитьРегистрацииЗаВремяВыполненияТекущегоРегламентногоЗадания(Узел, РеглЗаданиеИД)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("РеглЗаданиеИД", РеглЗаданиеИД);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.Узел КАК Узел,
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.РеглЗаданиеИД КАК РеглЗаданиеИД,
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.ВремяНачалаРаботы КАК ВремяНачалаРаботы,
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.ВыгружаемыйОбъектСсылка КАК ВыгружаемыйОбъектСсылка
	|ИЗ
	|	РегистрСведений.тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания КАК тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания
	|ГДЕ
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.Узел = &Узел
	|	И тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.РеглЗаданиеИД = &РеглЗаданиеИД";
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат.Выбрать();
	КонецЕсли;
	
КонецФункции

