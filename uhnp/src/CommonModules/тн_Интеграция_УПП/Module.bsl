		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕОПРЕДЕЛЕНО КАК ПодразделениеРодитель2,", "ЕстьNULL(ВЫРАЗИТЬ(СсылкиИзменения.Ссылка КАК Документ.ПрочиеДоходыРасходы).тн_Подразделение.Родитель.Родитель, НЕОПРЕДЕЛЕНО) КАК ПодразделениеРодитель2,");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕОПРЕДЕЛЕНО КАК ПодразделениеРодитель3,", "ЕстьNULL(ВЫРАЗИТЬ(СсылкиИзменения.Ссылка КАК Документ.ПрочиеДоходыРасходы).тн_Подразделение.Родитель.Родитель.Родитель, НЕОПРЕДЕЛЕНО) КАК ПодразделениеРодитель3,");
		// КОНЕЦ Борисенко Игорь 28.03.2023 Выполнение задач №000044957
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 06.03.2023 Выполнение задач №000044668

	// НАЧАЛО Борисенко Игорь 29.03.2023 Выполнение задач №000044975
	КонецЕсли; //Не ЕстьОтдельныйФильтрВПроцедуреВыгрузки
	// КОНЕЦ Борисенко Игорь 29.03.2023 Выполнение задач №000044975
						
	//НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
    КонецЕсли;
    //КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113

	РезДляБлокировки = Запрос.Выполнить();
	
	//Установить блокировку
	Если Параметры.ИспользоватьБлокировкиТранзакции Тогда
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(Параметры.ИмяОбъектаМетаданных);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
			ЭлементБлокировки.ИсточникДанных = РезДляБлокировки;
	
				//НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
				Если ОбработкаТабличногоОбъекта Тогда       
					
					МассивПолейБлокировок = тн_ОбщегоНазначения.ПолучитьМассивПолейБлокировокТабличногоОбъекта(Параметры.ИмяОбъектаМетаданных);
					
					Если МассивПолейБлокировок.Количество() = 0 Тогда
						Возврат Запрос;	
					КонецЕсли;
					
					ЭлементБлокировки.Область = СтрШаблон("%1%2"
													,Параметры.ИмяОбъектаМетаданных
													,?(Не МассивПолейБлокировок.Найти("Регистратор") = Неопределено, ".НаборЗаписей", ""));
					
					Для Каждого ЭлементМассива Из МассивПолейБлокировок Цикл
						ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ЭлементМассива, ЭлементМассива);		
					КонецЦикла;
					
				Иначе
				//КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
				
					ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
					
				//НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
				КонецЕсли;
				//КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
					
				Блокировка.Заблокировать();
					
		Исключение
			
			ОтменитьТранзакцию();
			
			ОписаниеОшибки = "Не удалось установить блокировку на " + Параметры.ИмяОбъектаМетаданных + "    Причина ---- " + ОписаниеОшибки();		
			ЗаписатьЛогРаботы("Ошибка", Параметры.ДанныеДляЛогирования, ОписаниеОшибки);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

