// Борисенко Игорь 19.04.2022 Выполнение задач №000040622
Процедура ВыгрузитьRMQ_Каркас_Документ_РеализацияТоваровУслуг(Параметры)
	
	ИмяТипаЭлементаXDTO	 = "documentReceipt";

	Параметры.Вставить("ИмяОбъектаМетаданных", "Документ.РеализацияТоваровУслуг"); //РеализацияТоваровУслуг --> ПоступлениеТоваровУслуг
	
	Запрос = НачальныеДействия_ЗапросПоИзмененнымОбъектам(Параметры);
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объекты.Ссылка КАК Ссылка,
	|	Объекты.ПометкаУдаления КАК deletionMark,
	|	Объекты.Проведен КАК Posted,
	|	Объекты.Номер КАК Number,
	|	Объекты.Дата КАК Date,
	|	Объекты.Организация КАК Организация,
	|	Объекты.Подразделение КАК Подразделение,
	|	Объекты.Контрагент КАК Контрагент,
	|	Объекты.Договор КАК Договор,
	|	Объекты.Склад КАК Склад,
	|	Объекты.Валюта КАК Валюта,
	|	Объекты.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	ВЫБОР
	|		КОГДА Объекты.КурсЧислитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ Объекты.КурсЧислитель
	|	КОНЕЦ КАК course,
	|	ВЫБОР
	|		КОГДА Объекты.КурсЗнаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ Объекты.КурсЗнаменатель
	|	КОНЕЦ КАК frequencyRate,
	|	Объекты.ЦенаВключаетНДС КАК VAT_InSum,
	|	ВЫБОР
	|		КОГДА Объекты.НалогообложениеНДС = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК takeVAT,
	|	"""" КАК incomType,
	|	Объекты.ОснованиеНомер КАК incomNumber,
	|	Объекты.ОснованиеДата КАК incomDate,
	|	ИСТИНА КАК reflectInAccounting,
	|	ЛОЖЬ КАК reflectInManagement,
	|	""РеализацияКлиенту"" КАК operationType,
	|	ЕСТЬNULL(Объекты.Контрагент.ИНН, """") КАК counterpartyINN,
	|	ЕСТЬNULL(Объекты.Контрагент.КПП, """") КАК counterpartyKPP,
	|	ЕСТЬNULL(Объекты.Организация.ИНН, """") КАК organizationINN,
	// НАЧАЛО Борисенко Игорь 22.09.2022 Выполнение задач №000042707
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Объекты.Организация.КрупнейшийНалогоплательщик, ЛОЖЬ)
