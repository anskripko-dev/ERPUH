	RegExp = Новый COMОбъект("VBScript.RegExp");
	
	//DateTime
	//"0001-01-01T00:00:00" --> "0001-01-01T00:00:00.00Z"
	Pattern =  """[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}""";
	
	RegExp.Pattern = Pattern;
	RegExp.Global = Истина;
	RegExp.MultiLine = Истина;
	масПодстрокДат = RegExp.Execute(ТекстСообщения);
	
	масЗамененных = Новый Массив;
	
	Для каждого эл Из масПодстрокДат Цикл
		Подстрока = эл.Value;
		Если масЗамененных.Найти(Подстрока) = Неопределено Тогда
			
			Замена = СтрЗаменить(Подстрока, """", "");
			// НАЧАЛО Борисенко Игорь 20.04.2022 Выполнение задач №000040622
			ЗаменаДата = ДатаИзСтрокиUTC(Замена);
