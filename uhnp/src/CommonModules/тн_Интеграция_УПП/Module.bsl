// Борисенко Игорь 20.04.2022 Выполнение задач №000040622
Функция ДатаИзСтрокиUTC(ДатаСтрока) Экспорт
	//"0001-01-01T00:00:00.00Z"
	
	// НАЧАЛО Борисенко Игорь 10.03.2023 Выполнение задач №000044710	
	//Если СтрДлина(ДатаСтрока) >= 19 Тогда
	
	ДлинаГодМесДенЧасМинСек = 19;
	ДлинаГодМесДен = 10;
	
	Если СтрДлина(ДатаСтрока) >= ДлинаГодМесДенЧасМинСек Тогда
	// КОНЕЦ Борисенко Игорь 10.03.2023 Выполнение задач №000044710	
		
		Год = Сред(ДатаСтрока, 1, 4);
		Мес = Сред(ДатаСтрока, 6, 2);
		Ден = Сред(ДатаСтрока, 9, 2);
		Час = Сред(ДатаСтрока, 12, 2);
		Мин = Сред(ДатаСтрока, 15, 2);
		Сек = Сред(ДатаСтрока, 18, 2);
		
		Возврат Дата(Год,Мес,Ден,Час,Мин,Сек);
		
	// НАЧАЛО Борисенко Игорь 10.03.2023 Выполнение задач №000044710	
	ИначеЕсли СтрДлина(ДатаСтрока) >= ДлинаГодМесДен Тогда
		
		Год = Сред(ДатаСтрока, 1, 4);
		Мес = Сред(ДатаСтрока, 6, 2);
		Ден = Сред(ДатаСтрока, 9, 2);
		
		Возврат Дата(Год,Мес,Ден);
		
	Иначе
		Возврат ДатаСтрока;
	// КОНЕЦ Борисенко Игорь 10.03.2023 Выполнение задач №000044710
		
	КонецЕсли;
	
КонецФункции

