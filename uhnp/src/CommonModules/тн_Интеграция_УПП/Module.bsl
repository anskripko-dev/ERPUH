Процедура ВыгрузитьRMQ_ЦБ_Справочник_ОбъектыЭксплуатации(Параметры) Экспорт
	
	ИмяТипаЭлементаXDTO	 = "catalogFixedAssets";
	
	Параметры.Вставить("ИмяОбъектаМетаданных", "Справочник.ОбъектыЭксплуатации");
	
	Запрос = НачальныеДействия_ЗапросПоИзмененнымОбъектам(Параметры);
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Выборка данных
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объекты.Ссылка КАК Ссылка,
	|	Объекты.ПометкаУдаления КАК deletionMark,
	|	Объекты.Код КАК code,
	|	Объекты.Наименование КАК name,
	|	Объекты.Родитель КАК Родитель,
	|	ЕСТЬNULL(Объекты.Родитель.Наименование, """") КАК parentName,
	|	Объекты.ЭтоГруппа КАК isFolder,
	|	Объекты.Изготовитель КАК maker,
	|	Объекты.НомерПаспорта КАК pussportNum,
	|	Объекты.ЗаводскойНомер КАК factoryNum,
	|	Объекты.ДатаВыпуска КАК issueDate,
	|	ЕСТЬNULL(Объекты.КодПоОКОФ.Код, """") КАК kodOKOF,
	|	Объекты.тн_КлассификаторОСУУ КАК КлассификацияОСУУ,
	|	НЕОПРЕДЕЛЕНО КАК АмортизационнаяГруппа,
	|	Объекты.ГруппаОС КАК ГруппаОС,
	|	Объекты.тн_СделатьФедеральным КАК makeFederal
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации КАК Объекты
	|		ПО Измененные.Ссылка = Объекты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК Ссылка,
	|	ТЧ.ПроизводственноеПодразделение КАК ПроизводственноеПодразделение
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации.тн_ПроизводственныеПодразделения КАК ТЧ
	|		ПО Измененные.Ссылка = ТЧ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Измененные";
	
