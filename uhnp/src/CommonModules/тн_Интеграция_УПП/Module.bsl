Процедура тн_ОчисткаИсторииОбменовДанными() Экспорт
	
	СрокХраненения = Константы.тн_СрокХраненияСообщенияRMQВОчередиДляОбработки.Получить(); 
	Если ЗначениеЗаполнено(СрокХраненения) Тогда
		
		ДатаОкончания 	= КонецДня(ТекущаяДатаСервера() - 86400*СрокХраненения);
		Запрос 			= Новый Запрос;
		
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания); 
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ИДСообщения КАК ИДСообщения
		               |ИЗ
		               |	РегистрСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ КАК тн_Интеграция_ОчередьОбработкиСообщенийRMQ
		               |ГДЕ
		               |	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ДатаСообщения < &ДатаОкончания";
		
		Выборка = Запрос.Выполнить().Выбрать();	
		Пока Выборка.Следующий() Цикл
			РегистрыСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ.УдалитьСообщение(Выборка.ИДСообщения);
			// НАЧАЛО Юдина Екатерина 16.10.2025 Выполнение задач №000055524 
			РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.УдалитьСообщение(Выборка.ИДСообщения);
			// КОНЕЦ Юдина Екатерина 16.10.2025 Выполнение задач №000055524
		КонецЦикла;
		
	КонецЕсли;
	// НАЧАЛО Лаганина Н.В. 27.11.2023 Выполнение задач №000047613
	СрокХранененияИсходящиеСообщения = Константы.СрокХраненияСправочникИсходящиеСообщения.Получить(); 
	Если Не ЗначениеЗаполнено(СрокХранененияИсходящиеСообщения) ТОгда
		Попытка
			Константы.СрокХраненияСправочникИсходящиеСообщения.Установить(7); 
		Исключение		
		КонецПопытки; 
	КонецЕсли;
	//очистка справочника ИсходящиеСообщения
	СрокХранененияИсходящиеСообщения = ?(СрокХранененияИсходящиеСообщения, СрокХранененияИсходящиеСообщения, 7); 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсходящиеСообщения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИсходящиеСообщения КАК ИсходящиеСообщения
	|ГДЕ
	|	ИсходящиеСообщения.ДатаВремяОтправки <> &ПустаяДата
	|	И (ИсходящиеСообщения.Доставлено
	|			ИЛИ НЕ(ИсходящиеСообщения.КоличествоПопыток > 0
	|					И ИсходящиеСообщения.ИнтервалПовторнойОтправки > 0))
	|	И ИсходящиеСообщения.ДатаВремяОтправки < &ДатаОкончания";
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	ДатаОкончания = КонецДня(ТекущаяДатаСервера() - 86400*СрокХранененияИсходящиеСообщения); 	
	
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СправочникОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		СправочникОбъект.Удалить();
	КонецЦикла;

