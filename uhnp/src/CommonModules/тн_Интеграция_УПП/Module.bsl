Процедура ВыгрузитьRMQ_Каркас_Справочник_ГруппыФинансовогоУчетаРасчетов(Параметры)
	
	ИмяТипаЭлементаXDTO	 = "catalogFinancialAccountingGroups";

	Параметры.Вставить("ИмяОбъектаМетаданных", "Справочник.ГруппыФинансовогоУчетаРасчетов");
	
	Запрос = НачальныеДействия_ЗапросПоИзмененнымОбъектам(Параметры);
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объекты.Ссылка КАК Ссылка,
	|	Объекты.Наименование КАК name,
	|	Объекты.Родитель КАК Родитель,
	|	ЕСТЬNULL(Объекты.Родитель.Наименование, """") КАК parentName,
	|	Объекты.ЭтоГруппа КАК isFolder,
	|	Объекты.ПометкаУдаления КАК deletionMark,
	|	ЕСТЬNULL(Объекты.Описание, """") КАК details,
	|	ЕСТЬNULL(Объекты.РасчетыВВалюте, ЛОЖЬ) КАК inCurrency
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыФинансовогоУчетаРасчетов КАК Объекты
	|		ПО Измененные.Ссылка = Объекты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Измененные";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO);	
		ЗаполнитьЗначенияСвойств(ЭлементКонтейнераXDTO, Выборка);
		
		ЭлементКонтейнераXDTO.guid 			= ВернутьСтрокуУИД(Выборка.Ссылка);
		ЭлементКонтейнераXDTO.parentGuid	= ВернутьСтрокуУИД(Выборка.Родитель);
		
		Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);	
		Параметры.МасОтправленныхОбъектов.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);
	
КонецПроцедуры

