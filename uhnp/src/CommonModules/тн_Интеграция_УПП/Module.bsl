//Функция ДатаВUTC(Дата) Экспорт
//	
//	// НАЧАЛО Борисенко И.Н. 22.12.2021 Выполнение задач №000039277
//	Если ЗначениеЗаполнено(Дата) Тогда
//		Возврат Формат(УниверсальноеВремя(Дата), "ДФ=yyyy-MM-ddTHH:mm:ss.00Z");
//	Иначе
//		Возврат "0001-01-01T00:00:00.00Z";	
//	КонецЕсли;	
//	// КОНЕЦ Борисенко И.Н. 22.12.2021 Выполнение задач №000039277
//	
//КонецФункции

Функция ДатаВUTC(ДатаВходящая, Смещение = NULL) Экспорт
	
	Дата = "0001-01-01T00:00:00.00Z";
	
	Если ЗначениеЗаполнено(ДатаВходящая) Тогда
		
		ФорматВремени = "ДФ=yyyy-MM-ddTHH:mm:ss.00Z";
		
		Если Смещение = Неопределено Тогда
			
			//смещение по умолчанию (по часовому поясу сервера)
			Дата = Формат(УниверсальноеВремя(ДатаВходящая), ФорматВремени);
			
		ИначеЕсли Смещение = Null Тогда
			
			//смещение неизвестно, оставляем дату без изменений
			Дата = Формат(ДатаВходящая, ФорматВремени);
			
		Иначе
			
			ЧасовойПояс = "GMT" + Смещение;
			
			Дата = Формат(УниверсальноеВремя(ДатаВходящая, ЧасовойПояс), ФорматВремени);
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Дата;
	
КонецФункции
