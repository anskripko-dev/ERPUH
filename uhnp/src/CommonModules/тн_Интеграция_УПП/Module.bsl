// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
Функция ТипСообщения(Параметры, ИмяТипаЭлементаXDTO = "", ДеревоОписаний = Неопределено)
// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	
	ВерсияОписания = "v1";
	// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	Если ИмяТипаЭлементаXDTO <> "" И ДеревоОписаний <> Неопределено Тогда
		СтрокаОписания = ДеревоОписаний.Строки.Найти(ИмяТипаЭлементаXDTO, "ИмяТипаЭлементаXDTO");
		Если СтрокаОписания <> Неопределено Тогда
			Если СтрокаОписания.Версия <> "" Тогда
				ВерсияОписания = СтрокаОписания.Версия;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
		
	ТочкаОбменаRabbitMQ = Справочники.ТочкиОбменаRMQ.ТекущаяБаза;
	
	ИмяБД_лат = "БД не идентифицирована";
	
	// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	Если ТипЗнч(Параметры) = Тип("Строка") Тогда
		ИмяБД_лат = Параметры;
	Иначе
	// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	
	Если Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас() Тогда
		ИмяБД_лат = "Karkas";
	// НАЧАЛО Белоконенко Денис 18.02.2022 Выполнение задач №000040436
	ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ОКС() Тогда
		ИмяБД_лат = "OKS";	
	// КОНЕЦ Белоконенко Денис 18.02.2022 Выполнение задач №000040436
	// НАЧАЛО Борисенко И.Н. 22.01.2022 Выполнение задач №000038257
	ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЗУП() Тогда
		ИмяБД_лат = "ZUP";    
	// КОНЕЦ Борисенко И.Н. 22.01.2022 Выполнение задач №000038257 
	// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
	ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЦБ() Тогда
		ИмяБД_лат = "CB";
	//КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	
	Тип = "1cHoldingManagementTo1c" + ИмяБД_лат + "_" 
	+ ?(ИмяТипаЭлементаXDTO = "", "", ИмяТипаЭлементаXDTO + "_")
	+ ВерсияОписания;
	
	Возврат Тип;
	
КонецФункции

// Борисенко Игорь 27.10.2023 Выполнение задач №000047308
Процедура ПоместитьУспешноОтправленныеОбъекты_К_СнятиюСРегистрации(Параметры)

	МасОбъектовКСнятиюСРегистрации = Параметры.МасОбъектовКСнятиюСРегистрации;
	
	Для каждого Ссылка Из Параметры.МасОтправленныхОбъектов Цикл
		Если МасОбъектовКСнятиюСРегистрации.Найти(Ссылка) = Неопределено Тогда
			МасОбъектовКСнятиюСРегистрации.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Процедура СнятьСРегистрацииУспешноОтправленныеОбъекты(Параметры) Экспорт
	
	Узел = Параметры.УзелПланаОбмена;
	
	// НАЧАЛО Борисенко Игорь 27.10.2023 Выполнение задач №000047308
	//Для каждого Ссылка Из Параметры.МасОтправленныхОбъектов Цикл 
    Если Параметры.Свойство("МасОбъектовКСнятиюСРегистрации") Тогда 
		МассивСнимаемыхСРегистрации = Параметры.МасОбъектовКСнятиюСРегистрации;
	Иначе
		МассивСнимаемыхСРегистрации = Параметры.МасОтправленныхОбъектов;
	КонецЕсли;
	
	Для каждого Ссылка Из МассивСнимаемыхСРегистрации Цикл
		// КОНЕЦ Борисенко Игорь 27.10.2023 Выполнение задач №000047308 
		
		// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113 
		ЭтоРС = СтрНайти(ТипЗнч(Ссылка),"Регистр сведений") > 0;
		ЭтоРН = СтрНайти(ТипЗнч(Ссылка),"Регистр накопления") > 0;
		Если ЭтоРС ИЛИ ЭтоРН Тогда
			Если ЭтоРС Тогда
				ИмяРегистра = Ссылка.Метаданные().Имя;
				Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			Иначе	
				ИмяРегистра = Ссылка.Метаданные().Имя; 
				Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
			КонецЕсли;
			
			Выборка = Ссылка;
			Для Каждого Запись Из Выборка Цикл
				Для Каждого Отбор Из Набор.Отбор Цикл
					Отбор.Значение = Запись[Отбор.Имя];
					Отбор.Использование = Истина;
				КонецЦикла;
				
				ПланыОбмена.УдалитьРегистрациюИзменений(Параметры.УзелПланаОбмена, Набор);
			КонецЦикла;
		Иначе
		//КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
			
			Если ПланыОбмена.ИзменениеЗарегистрировано(Параметры.УзелПланаОбмена, Ссылка) Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(Параметры.УзелПланаОбмена, Ссылка);
			КонецЕсли;  
			// НАЧАЛО Борисенко Игорь 19.03.2024 Выполнение задач №000048907
			УдалитьУспешноВыгруженныеЗаписиИзРегистрацииНаВыгрузкуВоВремяВыполненияРеглЗадания(Параметры.УзелПланаОбмена, Ссылка);
			// КОНЕЦ Борисенко Игорь 19.03.2024 Выполнение задач №000048907
		// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
		КонецЕсли;
		//КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
		
	КонецЦикла;       
	
