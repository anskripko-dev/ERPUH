// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
Процедура НайтиСвязанныеОбъектыДляВыгрузки_ERP_УХ_Рекурсивно(ОсновнойОбъект, МасРегистрируемыхОбъектов, НаправлениеВыгрузки = "Каркас") Экспорт
// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	
	//СтруктураСвязанныхРеквизитов
	
	// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	СтруктураСвязанныхРеквизитов = ПолучитьСтруктуруСвязанныхРеквизитов(ОсновнойОбъект, НаправлениеВыгрузки);
	// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	
	ТипОсновногоОбъекта = ТипЗнч(ОсновнойОбъект);
	
	//Заполняем МасРегистрируемыхОбъектов и рекурсивно выбираем связанные объекты
	Для каждого СвязанныйРеквизит Из СтруктураСвязанныхРеквизитов Цикл
		
		Если ТипЗнч(СвязанныйРеквизит.Значение) = Тип("Структура") Тогда
			//реквизит тч объекта
			
			ИмяТЧ = СвязанныйРеквизит.Ключ;
			// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113  
			Если ИмяТЧ = "Записи" Тогда   
				ТЧ = ОсновнойОбъект;
			Иначе
			// КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113	
				
				ТЧ = ОсновнойОбъект[ИмяТЧ]; 
				
			// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113  
			КонецЕсли;
			// КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113	
			
			СтруктураСвязанныхРеквизитыТЧ = СвязанныйРеквизит.Значение;
			
			Для каждого СтрокаТЧ Из ТЧ Цикл
				Для каждого СвязанныйРеквизитТЧ Из СтруктураСвязанныхРеквизитыТЧ Цикл
					
					СвязанныйОбъект = ПолучитьЗначениеСвязанногоОбъекта(СвязанныйРеквизитТЧ, ТипОсновногоОбъекта, ОсновнойОбъект, СтрокаТЧ);
					ДобавитьВМассивРегистрируемыхОбъектов(МасРегистрируемыхОбъектов, СвязанныйОбъект);
					
				КонецЦикла; //по именам реквизитов
			КонецЦикла; //по строка тч
			
		Иначе 
			//реквизит шапки объекта
			
			СвязанныйОбъект = ПолучитьЗначениеСвязанногоОбъекта(СвязанныйРеквизит, ТипОсновногоОбъекта, ОсновнойОбъект);
			ДобавитьВМассивРегистрируемыхОбъектов(МасРегистрируемыхОбъектов, СвязанныйОбъект);
			
			Если СвязанныйРеквизит.Ключ = "Ссылка" И СвязанныйРеквизит.Значение = "ТребуетсяУточнение" И СвязанныйОбъект = Неопределено Тогда
				Прервать; //В результате уточнения выяснилось, что ОсновнойОбъект выгружать не нужно --> связанные объекты тоже не будет выгружать
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Функция ПолучитьЗначениеСвязанногоОбъекта(СвязанныйРеквизит, ТипОсновногоОбъекта, ОсновнойОбъект, СтрокаТЧ = Неопределено)
	
	Попытка
		Если СтрокаТЧ = Неопределено Тогда 
			СвязанныйОбъект = ОсновнойОбъект[СвязанныйРеквизит.Ключ];
		Иначе
			СвязанныйОбъект = СтрокаТЧ[СвязанныйРеквизит.Ключ];
		КонецЕсли;
	Исключение
		СвязанныйОбъект = Неопределено;
	КонецПопытки;
	
	Возврат СвязанныйОбъект;
	
КонецФункции

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Процедура ДобавитьВМассивРегистрируемыхОбъектов(МасРегистрируемыхОбъектов, СвязанныйОбъект)
	
	ТипОбъекта = ТипЗнч(СвязанныйОбъект);
	
	Если Не ЗначениеЗаполнено(СвязанныйОбъект)
		Или Не Справочники.ТипВсеСсылки().СодержитТип(ТипОбъекта) И  Не Документы.ТипВсеСсылки().СодержитТип(ТипОбъекта) //не справочник и не документ
			
		Тогда
		Возврат;
	КонецЕсли;
	
	Если МасРегистрируемыхОбъектов.Найти(СвязанныйОбъект) = Неопределено Тогда
		
		МасРегистрируемыхОбъектов.Добавить(СвязанныйОбъект);
		
		НайтиСвязанныеОбъектыДляВыгрузки_ERP_УХ_Рекурсивно(СвязанныйОбъект, МасРегистрируемыхОбъектов);
		
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Процедура ЗаполнитьСтруктуруСвязанныхРеквизитовРекурсивно(СтруктураСвязанныхРеквизитов, СтрокиОписаний)
	
	Для каждого СтрокаДерева Из СтрокиОписаний Цикл
		
		// НАЧАЛО Борисенко Игорь 06.06.2022 Выполнение задач №000040622
		Если Не ЗначениеЗаполнено(СтрокаДерева.ИмяОбъектаМетаданных) Тогда 
			Продолжить;
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 06.06.2022 Выполнение задач №000040622
		
		Если СтрокаДерева.ЭтоСсылка Тогда
			СтруктураСвязанныхРеквизитов.Вставить(СтрокаДерева.ИмяОбъектаМетаданных, ?(СтрокаДерева.ТребуетсяУточнение, "ТребуетсяУточнение", ""));
		КонецЕсли;
		
		Если СтрокаДерева.ТипОбъектаОписания = "ТабличнаяЧасть" Тогда
			СтруктураТЧ = Новый Структура;
			ЗаполнитьСтруктуруСвязанныхРеквизитовРекурсивно(СтруктураТЧ, СтрокаДерева.Строки);
			СтруктураСвязанныхРеквизитов.Вставить(СтрокаДерева.ИмяОбъектаМетаданных, СтруктураТЧ);
			
		Иначе
			ЗаполнитьСтруктуруСвязанныхРеквизитовРекурсивно(СтруктураСвязанныхРеквизитов, СтрокаДерева.Строки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599

// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
Функция ПолучитьСтруктуруСвязанныхРеквизитов(ОсновнойОбъект, НаправлениеВыгрузки = "Каркас")
// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	
	СтруктураСвязанныхРеквизитов = Новый Структура;
	
	ИмяТипаОсновногоОбъекта = ПолучитьИмяОбъектаМетаданных(ОсновнойОбъект);
	Если ИмяТипаОсновногоОбъекта = "" Тогда
		Возврат СтруктураСвязанныхРеквизитов;
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	Если НаправлениеВыгрузки = "Каркас" Тогда
	// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_Каркас();
	// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	// НАЧАЛО Белоконенко Денис 18.02.2022 Выполнение задач №000040436
	ИначеЕсли НаправлениеВыгрузки = "ОКС" Тогда
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ОКС();
	// КОНЕЦ Белоконенко Денис 18.02.2022 Выполнение задач №000040436	
	// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	ИначеЕсли НаправлениеВыгрузки = "ЦБ" Тогда
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ЦБ();
	// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	Иначе
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ЗУП();
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	
	ДеревоОписаний = Параметры.ДеревоОписаний;
	
	СтрокаДерева = ДеревоОписаний.Строки.Найти(ИмяТипаОсновногоОбъекта, "ИмяОбъектаМетаданных", Ложь);
	Если СтрокаДерева <> Неопределено Тогда
		ЗаполнитьСтруктуруСвязанныхРеквизитовРекурсивно(СтруктураСвязанныхРеквизитов, СтрокаДерева.Строки);
	КонецЕсли;
	
	Параметры.Удалить("ОсновнойОбъект");
	
	Возврат СтруктураСвязанныхРеквизитов;
	
КонецФункции

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Функция ПолучитьИмяОбъектаМетаданных(Ссылка) Экспорт
	
	ТипОбъекта = ТипЗнч(Ссылка);	
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипОбъекта) Тогда
		ИмяТипаОбъекта = "Справочник." + Ссылка.Метаданные().Имя;
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипОбъекта) Тогда
		ИмяТипаОбъекта = "Документ." + Ссылка.Метаданные().Имя;   
	// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113  
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(Ссылка.Метаданные()) Тогда 
		ИмяТипаОбъекта = "РегистрСведений." + Ссылка.Метаданные().Имя; 
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(Ссылка.Метаданные()) Тогда 
		ИмяТипаОбъекта = "РегистрНакопления." + Ссылка.Метаданные().Имя;
	// КОНЕЦ  Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
	Иначе    
		Возврат ""; 
	КонецЕсли;
	
	Возврат ИмяТипаОбъекта;
	
КонецФункции

