Процедура ОбработатьСообщениеЗапросСверкиВзаиморасчетов(СообщениеXDTO, ТекстСообщенияJSON, Профиль) Экспорт
	
	ДанныеДляЛогирования = ПолучитьДанныеДляЛогирования(Перечисления.ТН_ВидыСообщений_ERP_УХ.reconciliationOfCalculationsRequest, , , Профиль.ВестиЛоги, Перечисления.тн_ВидыИнтеграций.ERP_УХ_Получение);
	ЗаписатьЛогРаботы("Запрос", ДанныеДляЛогирования, ТекстСообщенияJSON, Перечисления.ТН_ВидыСобытийИнтеграции.ПолученПакет);	
	
	ТегXDTO = "reconciliationOfCalculationsRequest";  
	ТегXDTOОтвет = "reconciliationOfCalculationsResponse";
	Результат = Новый Структура("Успех,ОписаниеОшибки", Истина, "");
	ДанныеЗапрос = СтрЗаменить(ТекстСообщенияJSON, "#", "");
	СтруктураВходящегоСообщения = ПолучитьСтруктуруДанныхJSON(ДанныеЗапрос);
	
	СтруктураПараметровЗапросДанных = Новый Структура;
	СтруктураПараметровЗапросДанных.Вставить("ТекстСообщенияJSON", ТекстСообщенияJSON);
	СтруктураПараметровЗапросДанных.Вставить("СообщениеXDTO", СообщениеXDTO);
	
	Ключ_headers = "headers";
	Значение_headers  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураВходящегоСообщения.value, Ключ_headers);
	КлючМаршрутизации = Значение_headers.systemSender;
	
	ДанныеДляЛогирования.Вставить("ВидСообщения", Перечисления.ТН_ВидыСообщений_ERP_УХ.reconciliationOfCalculationsResponse);
	ДанныеДляЛогирования.Вставить("ВидИнтеграции", Перечисления.тн_ВидыИнтеграций.ERP_УХ_Отправка);
	УзелЦБ = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЦБ(); 
	
	Попытка
		
		ОбъектXDTO_ОтветНаЗапросДанных = ПолучитьОбъектXDTOСверкаВзаиморасчетов(СтруктураПараметровЗапросДанных);
		ТекстСообщения = тн_Интеграция.СериализоватьКонтейнерXDTO(ОбъектXDTO_ОтветНаЗапросДанных, , "JSON");
		ЗаменитьПредставлениеФорматов(ТекстСообщения); 
		
		ОтправитьСообщениеОтвет(КлючМаршрутизации, ТекстСообщения, ОбъектXDTO_ОтветНаЗапросДанных, УзелЦБ, ТегXDTOОтвет);
		
	Исключение
		
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки +  """: " + ОписаниеОшибки() + Символы.ПС;	
		
	КонецПопытки;
	
	Если Результат.Успех Тогда
		ЗаписатьЛогРаботы("Ответ", ДанныеДляЛогирования, "Объекты типа: " + ТегXDTO + " успешно обработаны" + Символы.ПС + ТекстСообщения, Перечисления.ТН_ВидыСобытийИнтеграции.ОбработкаЗавершена);
	Иначе
		ОписаниеОшибки = "Ошибка обработки объектов типа " + ТегXDTO + " описание ошибки: " + Символы.ПС + Результат.ОписаниеОшибки;		
		Попытка
			ОбъектXDTO_ОтветНаЗапросДанных = ПолучитьОбъектXDTOСверкаВзаиморасчетов(СтруктураПараметровЗапросДанных, Результат.ОписаниеОшибки);
			ТекстСообщения = тн_Интеграция.СериализоватьКонтейнерXDTO(ОбъектXDTO_ОтветНаЗапросДанных, , "JSON");
			ЗаменитьПредставлениеФорматов(ТекстСообщения); 
			ОтправитьСообщениеОтвет(КлючМаршрутизации, ТекстСообщения, ОбъектXDTO_ОтветНаЗапросДанных, УзелЦБ, "reconciliationOfCalculationsResponse");	
		Исключение
			ОписаниеОшибки = Символы.ПС + ОписаниеОшибки + "Не удалось отправить ответ об ошибке по причине: " + ОписаниеОшибки();	
		КонецПопытки;	
		ЗаписатьЛогРаботы("Ошибка", ДанныеДляЛогирования, ОписаниеОшибки);       
	КонецЕсли;
	
КонецПроцедуры   

