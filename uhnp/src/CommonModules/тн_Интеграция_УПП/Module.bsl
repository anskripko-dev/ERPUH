// Белоконенко Денис 19.09.2024 Выполнение задач №000050614
Функция ПроверкаВозможностиВыгрузкиНабораРегистратораРегистраНЗС(Набор)
	
	ЕстьОграничение = Ложь;
	
	Если Набор.Количество() > 0 Тогда 
		ДатаСрез 	= Набор[0].Период;
		Организация = Набор[0].Организация;		
		ЕстьОграничение = тн_Интеграция_ERP_УХ_ПовтИсп.ЗначениеДополнительнойНастройкиПоОрганизации(ДатаСрез, Организация, "НеВыгружатьРегистрыОСВЦБ");
		
		Если ЕстьОграничение = Неопределено Тогда
			ЕстьОграничение = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьОграничение;
	
КонецФункции

