//Функция ВернутьСтрокуУИД(Ссылка)
Функция ВернутьСтрокуУИД(Ссылка) Экспорт
	
	// НАЧАЛО Борисенко Игорь 21.06.2022 Выполнение задач №000041647
	Если Ссылка = Неопределено Тогда
		Возврат "00000000-0000-0000-0000-000000000000";
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 21.06.2022 Выполнение задач №000041647

	ТипОбъекта = ТипЗнч(Ссылка);
	
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипОбъекта) Тогда //это перечисление
		Возврат ИмяЗначенияПеречисленияПоСсылке(Ссылка);
	КонецЕсли;
	
	//УИД
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Строка(Ссылка.УникальныйИдентификатор())
	Иначе
		Возврат "00000000-0000-0000-0000-000000000000";
	КонецЕсли;
	
КонецФункции

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Функция ИмяЗначенияПеречисленияПоСсылке(Ссылка) Экспорт
	
	// НАЧАЛО Борисенко Игорь 04.03.2024 Выполнение задач №000048702
	Если Ссылка = Неопределено Тогда
		Возврат "";
	ИначеЕсли Ссылка = NULL Тогда
		Возврат "";
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если Не Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		Возврат "";
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 04.03.2024 Выполнение задач №000048702
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.Метаданные().ЗначенияПеречисления[Перечисления[Ссылка.Метаданные().Имя].Индекс(Ссылка)].Имя;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

