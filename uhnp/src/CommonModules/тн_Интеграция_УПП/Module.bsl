			КоличествоДо = 0;
			СуммаДо = 0;
			СуммаНДСДо = 0;
			СтавкаНДСДо = ВыборкаТЧ.СтавкаНДС;
			
			ВыборкаТЧ_ПТУ.Сбросить();
			СтруктураПоиска = Новый Структура("Ссылка, Номенклатура, Упаковка, Склад", Выборка.Ссылка, ВыборкаТЧ.Номенклатура, ВыборкаТЧ.Упаковка, ВыборкаТЧ.Склад); 
			Пока ВыборкаТЧ_ПТУ.НайтиСледующий(СтруктураПоиска) Цикл
				КоличествоДо 	= КоличествоДо + ВыборкаТЧ_ПТУ.Количество;
				СуммаДо 		= СуммаДо + ВыборкаТЧ_ПТУ.Сумма;
				СуммаНДСДо 		= СуммаНДСДо + ВыборкаТЧ_ПТУ.СуммаНДС;
				СтавкаНДСДо		= ВыборкаТЧ_ПТУ.СтавкаНДС;
			КонецЦикла;
			
			XDTO_СтрокаТЧ	= ФабрикаXDTO.Создать(XDTO_ТипСтрокаТЧ);
			
			ЗаполнитьЗначенияСвойств(XDTO_СтрокаТЧ, ВыборкаТЧ);
			
			XDTO_СтрокаТЧ.nomenclatureGuid 		= ВернутьСтрокуУИД(ВыборкаТЧ.Номенклатура); 
			//НАЧАЛО Сафиуллина З.Р. 30.04.2025 Выполнение задач №000053529
			//XDTO_СтрокаТЧ.measureGuid 			= ВернутьСтрокуУИД(ВыборкаТЧ.Упаковка);
			XDTO_СтрокаТЧ.measureGuid 			= ВернутьСтрокуУИД(Неопределено);
			//КОНЕЦ Сафиуллина З.Р. 30.04.2025 Выполнение задач №000053529
			XDTO_СтрокаТЧ.vat_rate				= ИмяЗначенияПеречисленияПоСсылке(ВыборкаТЧ.СтавкаНДС);
			
			XDTO_СтрокаТЧ.quantityBeforeChange 	= КоличествоДо;
			XDTO_СтрокаТЧ.sumBeforeChange 		= СуммаДо;
			XDTO_СтрокаТЧ.vat_rateBeforeChange 	= ИмяЗначенияПеречисленияПоСсылке(СтавкаНДСДо);
			XDTO_СтрокаТЧ.sumVATBeforeChange 	= СуммаНДСДо;
			
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
			
		КонецЦикла; //по ТЧ
		
		ЭлементКонтейнераXDTO[XDTO_ИмяТЧ] = XDTO_ТЧ;
		
		//Добавляем объект в КонтейнерXDTO
		Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);
		
		Параметры.МасОтправленныхОбъектов.Добавить(Выборка.Ссылка);
		
	КонецЦикла; //по Объекту
		
	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);	
КонецПроцедуры

