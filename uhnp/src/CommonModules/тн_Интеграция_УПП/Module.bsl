Процедура ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры)
	Отказ = Ложь;
	ОписаниеОшибки = "";
	
	//Сериалиуем КонтейнерXDTO в JSON-строку
	//
	//*********************** Разделим КонтейнерXDTO по видам объектов ***************************
	//
	ЭтоЭмуляцияВыгрузки = Параметры.Свойство("ЭмуляцияВыгрузки");
	Если ЭтоЭмуляцияВыгрузки Тогда
		СтруктураТекстыСообщений = Новый Структура;
	КонецЕсли;

	ЕстьОбъектыНаВыгрузку = Ложь;
	
	КонтейнерXDTO = Параметры.КонтейнерXDTO;
	headers = КонтейнерXDTO.headers;
	Для каждого ТипОбъектаXDTO Из КонтейнерXDTO.Свойства() Цикл
		
		ЛокальноеИмя = ТипОбъектаXDTO.ЛокальноеИмя;
		Если СтрНайти(ЛокальноеИмя, "catalog") = 0 
			И СтрНайти(ЛокальноеИмя, "document") = 0 
			// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
			И СтрНайти(НРег(ЛокальноеИмя), "registr") = 0  
			// КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
			Тогда
			Продолжить;
		КонецЕсли;
				
		Если КонтейнерXDTO[ЛокальноеИмя].Количество() > 0 Тогда //есть выгружаемые объекты данного вида
			// НАЧАЛО Белоконенко Денис 24.01.2023 Выполнение задач №000044088
			КоличествоВКонтейнереXDTO = КонтейнерXDTO[ЛокальноеИмя].Количество();			
			// КОНЕЦ Белоконенко Денис 24.01.2023 Выполнение задач №000044088
			
			ЕстьОбъектыНаВыгрузку = Истина;
			
			НовыйКонтейнерXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, Параметры.ИмяТипаXDTO);
			НовыйКонтейнерXDTO.headers = headers;
			
			// НАЧАЛО Борисенко Игорь 18.04.2022 Выполнение задач №000040622
			Для каждого ОбъектXDTO Из КонтейнерXDTO[ЛокальноеИмя] Цикл
				НовыйКонтейнерXDTO[ЛокальноеИмя].Добавить(ОбъектXDTO);
			КонецЦикла;
			
			// НАЧАЛО Белоконенко Денис 24.01.2023 Выполнение задач №000044088
			// Странное поведение платформы. 
			// При добавление Объектов XDTO в новый КонтейнерXDTO у старого из коллекции записи пропадают 
			// и остается часть необработанных данных.
			Если КоличествоВКонтейнереXDTO <> КонтейнерXDTO[ЛокальноеИмя].Количество() Тогда
				КоличествоВКонтейнереXDTO = КонтейнерXDTO[ЛокальноеИмя].Количество();
				Пока КонтейнерXDTO[ЛокальноеИмя].Количество() <> 0 Цикл
					НовыйКонтейнерXDTO[ЛокальноеИмя].Добавить(КонтейнерXDTO[ЛокальноеИмя][0]);
					
					// Делаем проверку чтобы не было зацикливания
					Если КоличествоВКонтейнереXDTO = КонтейнерXDTO[ЛокальноеИмя].Количество() Тогда
						КонтейнерXDTO[ЛокальноеИмя].Удалить(0);	
					КонецЕсли;
					
					КоличествоВКонтейнереXDTO = КонтейнерXDTO[ЛокальноеИмя].Количество();
				КонецЦикла;
			КонецЕсли;
			// КОНЕЦ Белоконенко Денис 24.01.2023 Выполнение задач №000044088			
			
			Параметры.ДанныеДляЛогирования.ВидСообщения = ПолучитьВидСообщенияЛогирования(ЛокальноеИмя);
			// КОНЕЦ Борисенко Игорь 18.04.2022 Выполнение задач №000040622
			
			Параметры.КонтейнерXDTO = НовыйКонтейнерXDTO;
			
			ДобавитьСистемныеПараметры(Параметры);
			ТекстСообщения = тн_Интеграция.СериализоватьКонтейнерXDTO(Параметры.КонтейнерXDTO, , Параметры.ФорматСообщения);
			
			ЗаменитьПредставлениеФорматов(ТекстСообщения);
	
			НаправлениеВыгрузки = "";
			Если Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас() Тогда
				НаправлениеВыгрузки = "Каркас";
			// НАЧАЛО Борисенко И.Н. 22.01.2022 Выполнение задач №000038257
			ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЗУП() Тогда
				НаправлениеВыгрузки = "ЗУП";
			// КОНЕЦ Борисенко И.Н. 22.01.2022 Выполнение задач №000038257
			// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
			ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ОКС() Тогда
				НаправлениеВыгрузки = "ОКС";
			ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЦБ() Тогда
				НаправлениеВыгрузки = "ЦБ";
			// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
			КонецЕсли;
			
			Если ЭтоЭмуляцияВыгрузки Тогда
				СтруктураТекстыСообщений.Вставить(ЛокальноеИмя, ТекстСообщения);
				
			Иначе //Отправим пакет в RMQ
				
				Попытка
				
					Если ТекстСообщения <> "" И Параметры.МасОтправленныхОбъектов.Количество() > 0 Тогда
						ОтправитьПакет(ТекстСообщения, Параметры, ЛокальноеИмя);	
						
						ЗаписатьЛогРаботы("Ответ", Параметры.ДанныеДляЛогирования, ТекстСообщения, Перечисления.тн_ВидыСобытийИнтеграции.ОтправленПакет);
						
					Иначе
						// НАЧАЛО Борисенко Игорь 09.02.2022 Выполнение задач №000040313
						//ТекстСообщения = "Зарегистрированных к выгрузке для " + НаправлениеВыгрузки + " объектов нет: " + Параметры.ИмяОбъектаМетаданных;
						//ЗаписатьЛогРаботы("Ответ", Параметры.ДанныеДляЛогирования, ТекстСообщения, Перечисления.тн_ВидыСобытийИнтеграции.ОбработкаЗавершена);
						// КОНЕЦ Борисенко Игорь 09.02.2022 Выполнение задач №000040313
						
					КонецЕсли;
									
				Исключение
					Отказ = Истина;
					ОписаниеОшибки = "Ошибка выгрузки для " + НаправлениеВыгрузки + ": " + Параметры.ИмяОбъектаМетаданных + " - " + ОписаниеОшибки();		
					
				КонецПопытки;
				
				Если Параметры.ИспользоватьБлокировкиТранзакции И ТранзакцияАктивна() Тогда
					Если Отказ Тогда
						ОтменитьТранзакцию();
					Иначе
						ЗафиксироватьТранзакцию();
					КонецЕсли;
				КонецЕсли;
				
				Если Отказ Тогда
					ЗаписатьЛогРаботы("Ошибка", Параметры.ДанныеДляЛогирования, ОписаниеОшибки);
				КонецЕсли;
				
			КонецЕсли; //Эмуляция/Отправка
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭтоЭмуляцияВыгрузки Тогда
		Параметры.Вставить("СтруктураТекстыСообщений", СтруктураТекстыСообщений);
		
		// НАЧАЛО Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		Если Не Параметры.Свойство("СохранитьМенеджерЗапроса") Или Параметры.СохранитьМенеджерЗапроса = Ложь Тогда
		// КОНЕЦ Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
		Параметры.Запрос.МенеджерВременныхТаблиц = Неопределено;
		// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
		// НАЧАЛО Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 01.05.2022 Выполнение задач №000041127
		
	Иначе
		Если Не Отказ Тогда  	
			// НАЧАЛО Борисенко Игорь 27.10.2023 Выполнение задач №000047308
			//СнятьСРегистрацииУспешноОтправленныеОбъекты(Параметры);
			ПоместитьУспешноОтправленныеОбъекты_К_СнятиюСРегистрации(Параметры);
			// КОНЕЦ Борисенко Игорь 27.10.2023 Выполнение задач №000047308 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

