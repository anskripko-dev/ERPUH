// Борисенко И.Н. 03.12.2021 Выполнение задач №000039277
Функция СформироватьОписаниеJSON_для_Объекта(ИмяБД, СтруктураОписаниеJSON, ДеревоОписаний, ЭлСообщение)
	
	СтрокаОписания = ДеревоОписаний.Строки.Найти(ЭлСообщение.Ключ, "ИмяТипаЭлементаXDTO");
	
	Если СтрокаОписания = Неопределено Или СтрокаОписания.ТипОбъектаОписания <> "Объект" Тогда
		СообщитьИнформациюПользователю("Для: " + ЭлСообщение.Ключ + " невозможно сформировать описание json");
		Возврат "";
	КонецЕсли;
	
	ОписаниеJSON = "{";
	Уровень = 1;
	
	//Щапка
	
	// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	ТипОбъекта = ТипСообщения(ИмяБД, СтрокаОписания.ИмяТипаЭлементаXDTO, ДеревоОписаний);
	// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	
	Текст = "`$schema`: `http://json-schema.org/draft-07/schema`," + "
	// НАЧАЛО Борисенко Игорь 01.06.2022 Выполнение задач №000041180
	|" + "`$id`: `" + ТипОбъекта + ".json`," + "
	// КОНЕЦ Борисенко Игорь 01.06.2022 Выполнение задач №000041180
	|" + "`type`: `object`," + "
	|" + "`title`: `" + ТипОбъекта + "`," + "
	// НАЧАЛО Борисенко Игорь 04.07.2022 Выполнение задач №000040622
	|" + "`description`: `Описание формата JSON для передачи данных по " + СтрокаОписания.Описание + " из базы на конфигурации 1С 1С Управление холдингом в базу на конфигурации " + ИмяБД +" `," + "
	// КОНЕЦ Борисенко Игорь 04.07.2022 Выполнение задач №000040622
	|" + "`default`: {}," + "
	|" + "`examples`: [";
	ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
	
	//Пример
	Текст = ЭлСообщение.Значение;
	ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
	ОписаниеJSON = ОписаниеJSON + "
	|],";
	
	//properties Головной узел
	Текст = "`properties`: {" + "
	|" + "	`#ns`: {" + "
	|" + "		`description`: `ns`," + "
	|" + "		`type`: `string`," + "
	|" + "		`maxLength`: 255" + "
	|}," + "
	|" + "	`#type`: {" + "
	|" + "		`type`: `string`," + "
	|" + "		`maxLength`: 255" + "
	|}," + "
	|" + "	`#value`: {" + "
	|" + "		`$ref`: `#/definitions/%23valueERP_DTO`" + "
	|}" + "
	|}," + "
	// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	|`additionalProperties`: false," + "
	// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	|" + "`required`: [" + "
	|" + "	`#ns`," + "
	|" + "	`#type`," + "
	|" + "	`#value`" + "
	|]," + "
	|" + "`definitions`: {" + "
	|" + "	`headers_DTO`: {" + "
	|" + "		`description`: `Заголовок интеграционного сообщения`," + "
	|" + "		`type`: `object`," + "
	|" + "		`examples`: [" + "
	|" + "			{" + "
	|" + "				`messageGUID`: `58985840-835e-47db-b4ca-bccdd6575aa6`," + "
	|" + "				`sendDateUTC`: `2021-12-16T11:37:05.00Z`," + "
	|" + "				`systemSender`: `76c940d1-efa0-4e25-9a77-7daa57038590`" + "
	|}" + "
	|]," + "
	|" + "		`properties`: {" + "
	|" + "			`messageGUID`: {" + "
	|" + "				`description`: `Уникальный uid отправляемого пакета`," + "
	|" + "				`$ref`: `#/definitions/guid`" + "
	|}," + "
	|" + "			`sendDateUTC`: {" + "
	|" + "				`description`: `Дата отправки пакета`," + "
	|" + "				`type`: `string`," + "
	|" + "				`format`: `date-time`" + "
	|}," + "
	|" + "			`systemSender`: {" + "
	|" + "				`description`: `Уникальный uid системы отправителя  - он же routing key для отправки ответа`," + "
	|" + "				`$ref`: `#/definitions/guid`" + "
	|}" + "
	|}," + "
	|" + "		`required`: [" + "
	|" + "			`messageGUID`," + "
	|" + "			`sendDateUTC`," + "
	|" + "			`systemSender`" + "
	|]" + "
	|},";
	ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
	
	//properties Объекта
	ОписатьСвойстваРекурсивно(ОписаниеJSON, СтрокаОписания, Уровень, "#/properties");
	Текст = ",";
	ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
	
	//valueERP_DTO и подвал
	Текст = "	`#valueERP_DTO`: {" + "
	|" + "		`type`: `object`," + "
	|" + "		`properties`: {" + "
	|" + "			`headers`: {" + "
	|" + "				`$ref`: `#/definitions/headers_DTO`" + "
	|}," + "
	|" + "			`" + СтрокаОписания.ИмяТипаЭлементаXDTO + "`: {" + "
	|" + "				`type`: `array`," + "
	|" + "				`items`: {" + "
	|" + "					`$ref`: `#/definitions/" + СтрокаОписания.ИмяТипаЭлементаXDTO + "_element_DTO`" + "
	|}" + "
	|}" + "
	|}," + "
	// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	|`additionalProperties`: false," + "
	// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	|" + "		`required`: [" + "
	|" + "			`headers`," + "
	|" + "			`" + СтрокаОписания.ИмяТипаЭлементаXDTO + "`" + "
	|]" + "
	|}," + "
	|" + "	`guid`: {" + "
	|" + "		`type`: `string`," + "
	|" + "		`chance`: `guid`," + "
	|" + "		`default`: `00000000-0000-0000-0000-000000000000`," + "
	|" + "		`pattern`: `^([0-9A-Fa-f]{8}[-][0-9A-Fa-f]{4}[-][0-9A-Fa-f]{4}[-][0-9A-Fa-f]{4}[-][0-9A-Fa-f]{12})`," + "
	|" + "		`format`: `uuid`," + "
	|" + "		`maxLength`: 36," + "
	|" + "		`minLength`: 36" + "
	|}" + "
	|}" + "
	|}";
	ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
	
	Возврат ОписаниеJSON;
	
КонецФункции

// Борисенко И.Н. 03.12.2021 Выполнение задач №000039277
Функция СформироватьОписаниеJSON(ИмяОбъектаМетаданных, СтрокаУИД, НаправлениеВыгрузки = "Каркас") Экспорт
	
	СтруктураОписаниеJSON = Новый Структура;
	
	// НАЧАЛО Борисенко Игорь 25.01.2022 Выполнение задач №000038257
	Если НаправлениеВыгрузки = "Каркас" Тогда
	// КОНЕЦ Борисенко Игорь 25.01.2022 Выполнение задач №000038257
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_Каркас();
	// НАЧАЛО Борисенко Игорь 25.01.2022 Выполнение задач №000038257
	// НАЧАЛО Борисенко Игорь 22.09.2022 Выполнение задач №000042702
	ИначеЕсли НаправлениеВыгрузки = "ОКС" Тогда
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ОКС();
	// КОНЕЦ Борисенко Игорь 22.09.2022 Выполнение задач №000042702
	// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	ИначеЕсли НаправлениеВыгрузки = "ЦБ" Тогда
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ЦБ();
	// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	Иначе
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ЗУП();
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 25.01.2022 Выполнение задач №000038257
	
	ИмяБД = "БД не идентифицирована";
	Если Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас() Тогда
		ИмяБД = "Karkas";
	// НАЧАЛО Борисенко Игорь 22.09.2022 Выполнение задач №000042702
	ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ОКС() Тогда
		ИмяБД = "OKS";
	// КОНЕЦ Борисенко Игорь 22.09.2022 Выполнение задач №000042702
	// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЦБ() Тогда
		ИмяБД = "CB";
	// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	// НАЧАЛО Борисенко И.Н. 22.01.2022 Выполнение задач №000038257
	ИначеЕсли Параметры.УзелПланаОбмена = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЗУП() Тогда
		ИмяБД = "ZUP";
	// КОНЕЦ Борисенко И.Н. 22.01.2022 Выполнение задач №000038257  
	КонецЕсли;
	
	ДеревоОписаний = Параметры.ДеревоОписаний;
	СтрокаОписания = ДеревоОписаний.Строки.Найти(ИмяОбъектаМетаданных, "ИмяОбъектаМетаданных");
	
	// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
	Если СтрокаОписания = Неопределено Или СтрокаОписания.ТипОбъектаОписания <> "Объект" Тогда
	// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
		СообщитьИнформациюПользователю("Для: " + СтрокаОписания.ИмяТипаЭлементаXDTO + " невозможно сформировать описание json");
		Возврат СтруктураОписаниеJSON;
	КонецЕсли;
	
	Ссылка = ПолучитьСсылкуПоУИД(СтрокаОписания, СтрокаУИД);
	Если Ссылка = Неопределено Тогда
		Возврат СтруктураОписаниеJSON;
	КонецЕсли;
	Параметры.Вставить("Ссылка", Ссылка);
	Параметры.Вставить("ИмяОбъектаМетаданных", СтрокаОписания.ИмяОбъектаМетаданных);
	Параметры.Вставить("ЭмуляцияВыгрузки", Истина);
	
	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(Параметры);
	// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	//АдресВременногоХранилища = СэмулироватьВыгрузкуОбъекта_в_ERP_УХ_НаСервере(АдресВременногоХранилища);
	АдресВременногоХранилища = СэмулироватьВыгрузкуОбъекта_в_ERP_УХ_НаСервере(АдресВременногоХранилища, НаправлениеВыгрузки);
	// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	Параметры = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	
	СтруктураТекстыСообщений = Параметры.СтруктураТекстыСообщений;
	Для каждого ЭлСообщение Из СтруктураТекстыСообщений Цикл
		ОписаниеJSON = СформироватьОписаниеJSON_для_Объекта(ИмяБД, СтруктураОписаниеJSON, ДеревоОписаний, ЭлСообщение);
		СтруктураОписаниеJSON.Вставить(ЭлСообщение.Ключ, ОписаниеJSON); 
	КонецЦикла;
	
	//Удаляем из Параметров свойства эмуляции выгрузки
	Параметры.Удалить("ЭмуляцияВыгрузки");
	Параметры.Удалить("АдресВременногоХранилища");
	Параметры.Удалить("Ссылка");	
	Параметры.Удалить("Запрос");
	
	Возврат СтруктураОписаниеJSON;
	
КонецФункции

// Борисенко И.Н. 03.12.2020 Выполнение задачи №000039277
Процедура ОписатьСвойстваРекурсивно(ОписаниеJSON, СтрокаОписания, Уровень, РодительИД)
	
	id = РодительИД + "/" + СтрокаОписания.ИмяТипаЭлементаXDTO;
	Постфикс = "";
	
	Если СтрокаОписания.ТипОбъектаОписания = "Объект" Тогда
		title = "Структура отправляемого объекта: " + СтрокаОписания.Описание;
		type = "object";
		Постфикс = "_element_DTO";
	ИначеЕсли СтрокаОписания.ТипОбъектаОписания = "ТабличнаяЧасть" Тогда
		title = "Табличная часть: " + СтрокаОписания.Описание;
		type = "array";
	Иначе
		title = СтрокаОписания.Описание;
		type = СтрокаОписания.Тип.Имя;
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 27.06.2022 Выполнение задач №000041647
	ЭтоГуид = СтрокаОписания.ЭтоСсылка 
		Или СтрНайти(НРег(СтрокаОписания.ИмяТипаЭлементаXDTO), "guid") > 0;
	Если ЭтоГуид Тогда
	// КОНЕЦ Борисенко Игорь 27.06.2022 Выполнение задач №000041647
		
		Текст = "`" + СтрокаОписания.ИмяТипаЭлементаXDTO + Постфикс + "`: {" + "
		|" + "`description`: `" + title + "`," + "
		|" + "`$ref`: `#/definitions/guid`";
		ЭтоПоследнийЭлементСвойствОбъекта = Ложь;
		
	Иначе
		
		Текст = "`" + СтрокаОписания.ИмяТипаЭлементаXDTO + Постфикс +"`: {" + "
		|" + "`type`: `" + type + "`";
		ЭтоПоследнийЭлементСвойствОбъекта = Ложь;
		
		// НАЧАЛО Борисенко Игорь 22.02.2022 Выполнение задач №000040452
		// К описаниям строковых полей добавляем "длину строки"
		Если СтрокаОписания.Тип.Имя = "string" Тогда
			
			ДлинаСтроки = ДлинаСтроковогоПоляJSON(СтрокаОписания);
			
			Если ДлинаСтроки <> "" Тогда
				Текст = Текст + ",
				|" + "`maxLength`: " + ДлинаСтроки;
			КонецЕсли;
			
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 22.02.2022 Выполнение задач №000040452
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 10.03.2023 Выполнение задач №000044710
	//Текст = СтрЗаменить(Текст, "`type`: `date`", "`type`: `string`, `format`: `date`");
	//НАЧАЛО Сафиуллина З.Р. 31.03.2025 Выполнение задач №000053226
	//Текст = СтрЗаменить(Текст, "`type`: `date`", "`type`: `string`, `format`: `date-time`");
	Текст = СтрЗаменить(Текст, "`type`: `date`", "`type`: `string`, `format`: `date`");
	//КОНЕЦ Сафиуллина З.Р. 31.03.2025 Выполнение задач №000053226
	// КОНЕЦ Борисенко Игорь 10.03.2023 Выполнение задач №000044710
	Текст = СтрЗаменить(Текст, "`type`: `dateTime`", "`type`: `string`, `format`: `date-time`");
	Текст = СтрЗаменить(Текст, "`type`: `dateUTC`", "`type`: `string`, `format`: `date-time`");
	Текст = СтрЗаменить(Текст, "`double`", "`number`");
	// НАЧАЛО Борисенко Игорь 28.02.2022 Выполнение задач №000040452
	ДлинаСтроки = 25;
	Текст = СтрЗаменить(Текст, "`integer`", "`string`" + ",
	|" + "`maxLength`: " + ДлинаСтроки);
	// КОНЕЦ Борисенко Игорь 28.02.2022 Выполнение задач №000040452
	Текст = СтрЗаменить(Текст, """", "");
	
	ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
	
	Если СтрокаОписания.ТипОбъектаОписания = "Объект" или СтрокаОписания.ТипОбъектаОписания = "ТабличнаяЧасть" Тогда
		ОписаниеJSON = ОписаниеJSON + ",";
		//properties/object/properties
		// НАЧАЛО Борисенко Игорь 12.07.2022 Выполнение задач №000041888
		Если СтрокаОписания.ТипОбъектаОписания = "ТабличнаяЧасть" Тогда
			Текст = "`items`: {
			|`type`: `object`,
			|`properties`: {";
		Иначе
			Текст = "`properties`: {";
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 12.07.2022 Выполнение задач №000041888
		ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
		
		Для каждого ПодчиненнаяСтрока Из СтрокаОписания.Строки Цикл
			ОписатьСвойстваРекурсивно(ОписаниеJSON, ПодчиненнаяСтрока, Уровень, id);
			Если СтрокаОписания.Строки.Индекс(ПодчиненнаяСтрока) = СтрокаОписания.Строки.Количество() - 1 Тогда
				ЭтоПоследнийЭлементСвойствОбъекта = Истина;
				Если Прав(ОписаниеJSON,1) = "," Тогда
					ОписаниеJSON = Лев(ОписаниеJSON, СтрДлина(ОписаниеJSON) - 1); //удалим последнию запятую
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// НАЧАЛО Борисенко Игорь 12.07.2022 Выполнение задач №000041888
		Если СтрокаОписания.ТипОбъектаОписания = "ТабличнаяЧасть" Тогда
			Текст = "},
			|`additionalProperties`: false
			|}";
		Иначе
			Текст = "}"; //properties/object/properties
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 12.07.2022 Выполнение задач №000041888
		// НАЧАЛО Борисенко Игорь 15.02.2022 Выполнение задач №000040659
		Текст = Текст + ",
		|`additionalProperties`: false";
		// КОНЕЦ Борисенко Игорь 15.02.2022 Выполнение задач №000040659
		ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
		
	КонецЕсли;
	
	Если СтрокаОписания.Родитель <> Неопределено Тогда
		ЭтоПоследнийЭлементСвойствОбъекта = СтрокаОписания.Родитель.Строки.Индекс(СтрокаОписания) = СтрокаОписания.Родитель.Строки.Количество() - 1;
	КонецЕсли;
	Если Не ЭтоПоследнийЭлементСвойствОбъекта Тогда
		Текст = "},"; //properties/object
	Иначе
		Текст = "}"; //properties/object
	КонецЕсли;
	ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень);
	
КонецПроцедуры

// Борисенко Игорь 24.02.2022 Выполнение задач №000040452
Функция ДлинаСтроковогоПоляJSON(СтрокаОписания)
	
	ДлинаСтроки = "";
	
	ИмяРеквизита = СтрокаОписания.ИмяОбъектаМетаданных;
	
	Если ИмяРеквизита = "ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код" Тогда
		ДлинаСтроки = 4;
		
	Иначе //Прочие описания реквизитов
	
		ИмяОбъектаМетаданных = СтрокаОписания.Строки.Родитель.Родитель.ИмяОбъектаМетаданных;
		
		Если стрНайти(ИмяОбъектаМетаданных, "Справочник.") > 0 Тогда
			ИмяОбъекта = стрЗаменить(ИмяОбъектаМетаданных, "Справочник.", "");
			МетаданныеОбъекта = Метаданные.Справочники[ИмяОбъекта];
		ИначеЕсли стрНайти(ИмяОбъектаМетаданных, "Документ.") > 0 Тогда
			ИмяОбъекта = стрЗаменить(ИмяОбъектаМетаданных, "Документ.", "");
			МетаданныеОбъекта = Метаданные.Документы[ИмяОбъекта];
		КонецЕсли;
		
		Попытка
			Если МетаданныеОбъекта = Неопределено Тогда
				//тч --> на уровень глубже
				ИмяТЧ = ИмяОбъектаМетаданных;
				ИмяОбъектаМетаданных = СтрокаОписания.Строки.Родитель.Родитель.Родитель.ИмяОбъектаМетаданных;
				Если стрНайти(ИмяОбъектаМетаданных, "Справочник.") > 0 Тогда
					ИмяОбъекта = стрЗаменить(ИмяОбъектаМетаданных, "Справочник.", "");
					МетаданныеОбъекта = Метаданные.Справочники[ИмяОбъекта][ИмяТЧ];
				ИначеЕсли стрНайти(ИмяОбъектаМетаданных, "Документ.") > 0 Тогда
					ИмяОбъекта = стрЗаменить(ИмяОбъектаМетаданных, "Документ.", "");
					МетаданныеОбъекта = Метаданные.Документы[ИмяОбъекта].ТабличныеЧасти[ИмяТЧ];
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				ДлинаСтроки = МетаданныеОбъекта.СтандартныеРеквизиты[ИмяРеквизита].Тип.КвалификаторыСтроки.Длина;
			Исключение
				Попытка
					ДлинаСтроки = МетаданныеОбъекта.Реквизиты[ИмяРеквизита].Тип.КвалификаторыСтроки.Длина;
				Исключение
					ДлинаСтроки = 200;
				КонецПопытки;
			КонецПопытки;
			
		Исключение
			ДлинаСтроки = 200;
		КонецПопытки;
		
	КонецЕсли;
	
	Если ДлинаСтроки = 0 Тогда
		ДлинаСтроки = 200;
	КонецЕсли;
	
	ДлинаСтроки = СтрЗаменить(ДлинаСтроки, Символы.НПП, "");
	
	Возврат ДлинаСтроки;
			
КонецФункции

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Процедура ДобавитьСтрокиJSON(ОписаниеJSON, Текст, Уровень)
	
	ОбрабатываемыйТекст = Новый ТекстовыйДокумент;
	ОбрабатываемыйТекст.ДобавитьСтроку(Текст);
	
	Для НомерСтроки = 1 по ОбрабатываемыйТекст.КоличествоСтрок() Цикл
		Строка = ОбрабатываемыйТекст.ПолучитьСтроку(НомерСтроки);
		Строка = СтрЗаменить(Строка, "`", """");
		
		// НАЧАЛО Борисенко И.Н. 09.10.2021 Выполнение задач №000039277
		Если СокрЛП(Строка) = "}" или СокрЛП(Строка) = "}," или СокрЛП(Строка) = "]" или СокрЛП(Строка) = "]," Тогда //Отдельная закрывающая скобка располагается на предыдущем уровне
		// КОНЕЦ Борисенко И.Н. 09.10.2021 Выполнение задач №000039277
			Уровень = Макс(0, Уровень - 1);
		КонецЕсли;
		
		Отступ = "";
		Для а = 1 по Уровень Цикл
			Отступ = Отступ + "    ";
		КонецЦикла;
		
		Строка = Отступ + Строка;
		
		ОписаниеJSON = ОписаниеJSON + "
		|" + Строка;
		
		//Уточним уровень следующих строк
		// НАЧАЛО Борисенко И.Н. 09.10.2021 Выполнение задач №000039277
		Если СокрЛП(Строка) <> "}" И СокрЛП(Строка) <> "}," И СокрЛП(Строка) <> "]" И СокрЛП(Строка) <> "]," Тогда
		// КОНЕЦ Борисенко И.Н. 09.10.2021 Выполнение задач №000039277
			Для НомерСимвола = 1 по СтрДлина(Строка) Цикл
				Символ = Сред(Строка,НомерСимвола,1);
				
				Если Символ = "{" или Символ = "[" Тогда
					Уровень = Уровень + 1;
				ИначеЕсли Символ = "}" или Символ = "]" Тогда
					Уровень = Уровень - 1;
				КонецЕсли;
				
			КонецЦикла; //по Символам
		КонецЕсли;
		
	КонецЦикла; //НомерСтроки
	
КонецПроцедуры

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Функция ПолучитьСсылкуПоУИД(СтрокаОписания, СтрокаУИД)
	
	Имя1С = СтрокаОписания.ИмяОбъектаМетаданных;
	
	СимволТочка = СтрНайти(Имя1С, ".",,,1);
	Если СимволТочка < 1 Или СтрДлина(Имя1С) <= СимволТочка Тогда
		СообщитьИнформациюПользователю("Невозможно обработать описание для: " + Имя1С);
		Возврат Неопределено;
	КонецЕсли;
	
	ТипОбъекта1С = Лев(Имя1С, СимволТочка-1);
	ИмяОбъекта1С = Сред(Имя1С, СимволТочка+1);
	
	Попытка
		
		Если ТипОбъекта1С = "Справочник" Тогда
			МенеджерОбъектов = Справочники[ИмяОбъекта1С];
			
		ИначеЕсли ТипОбъекта1С = "Документ" Тогда
			МенеджерОбъектов = Документы[ИмяОбъекта1С];
			
		Иначе
			СообщитьИнформациюПользователю("Невозможно обработать описание для: " + Имя1С);
			Возврат Неопределено;
			
		КонецЕсли;
		
	Исключение
		СообщитьИнформациюПользователю("Невозможно обработать описание для: " + Имя1С);
		Возврат Неопределено;
		
	КонецПопытки;
	
	УИД = Новый УникальныйИдентификатор(СтрокаУИД);
	Ссылка = МенеджерОбъектов.ПолучитьСсылку(УИД);
	
	Если Ссылка = Неопределено Тогда
		СообщитьИнформациюПользователю("Для: " + Имя1С + " не найдена ссылка: " + УИД);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

