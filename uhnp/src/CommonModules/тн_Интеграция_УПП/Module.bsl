		ЭлементКонтейнераXDTO.operationSubType          = ИмяЗначенияПеречисленияПоСсылке(Выборка.ХозяйственнаяОперация);
		//КОНЕЦ Сафиуллина З.Р. 01.04.2024 Выполнение задач №000049017
		
