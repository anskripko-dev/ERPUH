Процедура ВыгрузитьRMQ_ЗУП_Документ_ОтражениеЗарплатыВФинансовомУчете(Параметры)
	
	ИмяТипаЭлементаXDTO	 = "documentLocalAccountingPosting";

	Параметры.Вставить("ИмяОбъектаМетаданных", "Документ.ОтражениеЗарплатыВФинансовомУчете");
	
	Запрос = НачальныеДействия_ЗапросПоИзмененнымОбъектам(Параметры);
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объекты.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ОтражениеДокументовВРеглУчете.Статус, НЕОПРЕДЕЛЕНО) КАК Статус
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтражениеЗарплатыВФинансовомУчете КАК Объекты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовВРеглУчете КАК ОтражениеДокументовВРеглУчете
	|			ПО Объекты.Ссылка = ОтражениеДокументовВРеглУчете.Регистратор
	|		ПО Измененные.Ссылка = Объекты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Измененные";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO);	
		ЗаполнитьЗначенияСвойств(ЭлементКонтейнераXDTO, Выборка);
		
		Если Выборка.Статус = Перечисления.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВРеглУчете Тогда
			ОтраженВУчета = Истина;
		ИначеЕсли Выборка.Статус = Перечисления.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВУчетеВручную Тогда
			ОтраженВУчета = Истина;
		Иначе
			ОтраженВУчета = Ложь;
		КонецЕсли;
		
		ЭлементКонтейнераXDTO.guid 			= ВернутьСтрокуУИД(Выборка.Ссылка);
		ЭлементКонтейнераXDTO.reflected 	= ОтраженВУчета;	
		
		Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);	
		Параметры.МасОтправленныхОбъектов.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);
	
КонецПроцедуры

