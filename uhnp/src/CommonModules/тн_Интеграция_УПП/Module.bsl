// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
Процедура ЗарегистрироватьСвязанныеОбъектыДляВыгрузки_ERP_УХ(ОсновнойОбъект, НаправлениеВыгрузки = "Каркас") Экспорт
// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	
	Если ТипЗнч(ОсновнойОбъект) = Тип("Строка") Тогда //АдресВременногоХранилища
		ОсновнойОбъект = ПолучитьИзВременногоХранилища(ОсновнойОбъект);
	КонецЕсли;
	
	МасРегистрируемыхОбъектов = Новый Массив;
	
	//Регистрация связанных объектов
	
	Если НаправлениеВыгрузки = "Каркас" Тогда
		Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас();
	ИначеЕсли НаправлениеВыгрузки = "ЗУП" Тогда
		Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЗУП();
	// НАЧАЛО Белоконенко Денис 18.02.2022 Выполнение задач №000040436
	ИначеЕсли НаправлениеВыгрузки = "ОКС" Тогда
		Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ОКС();
	// КОНЕЦ Белоконенко Денис 18.02.2022 Выполнение задач №000040436
	// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	ИначеЕсли НаправлениеВыгрузки = "ЦБ" Тогда
		Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЦБ();
	// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	КонецЕсли;
	
	РегистрироватьСвязанныеОбъекты = Узел.РегистрироватьСвязанныеОбъекты;
	Если РегистрироватьСвязанныеОбъекты Тогда
		// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
		//НайтиСвязанныеОбъектыДляВыгрузки_ERP_УХ_Рекурсивно(ОсновнойОбъект, МасРегистрируемыхОбъектов);
		НайтиСвязанныеОбъектыДляВыгрузки_ERP_УХ_Рекурсивно(ОсновнойОбъект, МасРегистрируемыхОбъектов, НаправлениеВыгрузки);
		// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
		// НАЧАЛО Гутарова Екатерина 10.10.2023 Выполнение задач №000047113  
		Если НаправлениеВыгрузки = "ЦБ"
			И Метаданные.РегистрыСведений.Содержит(ОсновнойОбъект.Метаданные()) 
			ИЛИ Метаданные.РегистрыНакопления.Содержит(ОсновнойОбъект.Метаданные()) Тогда 
			МасРегистрируемыхОбъектов.Добавить(ОсновнойОбъект);
		КонецЕсли;
		// КОНЕЦ Гутарова Екатерина 10.10.2023 Выполнение задач №000047113	
	Иначе
		МасРегистрируемыхОбъектов.Добавить(ОсновнойОбъект);
		// НАЧАЛО Борисенко Игорь 11.04.2022 Выполнение задач №000040938
		ТипОсновногоОбъекта = ТипЗнч(ОсновнойОбъект);
		НужноРегистрироватьКонтрагента = (ТипОсновногоОбъекта = Тип("ДокументОбъект.ПрочиеДоходыРасходы") Или ТипОсновногоОбъекта = Тип("ДокументСсылка.ПрочиеДоходыРасходы"))
			И ИмяЗначенияПеречисленияПоСсылке(ОсновнойОбъект.ХозяйственнаяОперация) = "тн_ПеревыставлениеЗатрат";
		Если НужноРегистрироватьКонтрагента Тогда
			МасРегистрируемыхОбъектов.Добавить(ОсновнойОбъект.тн_КонтрагентПеревыставления);
		КонецЕсли;
		// КОНЕЦ Борисенко Игорь 11.04.2022 Выполнение задач №000040938
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Узел) Тогда
		Для каждого ОбъектДляРегистрации Из МасРегистрируемыхОбъектов Цикл
			
			Если НаправлениеВыгрузки = "Каркас" Тогда
				ЕстьВПланеОбмена = Метаданные.ПланыОбмена.тн_Интеграция_УПП.Состав.Найти(ОбъектДляРегистрации.Метаданные()) <> Неопределено;
			ИначеЕсли НаправлениеВыгрузки = "ЗУП" Тогда
				ЕстьВПланеОбмена = Метаданные.ПланыОбмена.тн_Интеграция_ЗУП.Состав.Найти(ОбъектДляРегистрации.Метаданные()) <> Неопределено;
			// НАЧАЛО Белоконенко Денис 18.02.2022 Выполнение задач №000040436
			ИначеЕсли НаправлениеВыгрузки = "ОКС" Тогда
				ЕстьВПланеОбмена = Метаданные.ПланыОбмена.тн_Интеграция_УПП_ОКС.Состав.Найти(ОбъектДляРегистрации.Метаданные()) <> Неопределено;
			// КОНЕЦ Белоконенко Денис 18.02.2022 Выполнение задач №000040436				
			// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
			ИначеЕсли НаправлениеВыгрузки = "ЦБ" Тогда
				ЕстьВПланеОбмена = Метаданные.ПланыОбмена.тн_Интеграция_УПП_ЦБ.Состав.Найти(ОбъектДляРегистрации.Метаданные()) <> Неопределено;
			// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
			Иначе
				ЕстьВПланеОбмена = Ложь;
			КонецЕсли;
			
			Если ЕстьВПланеОбмена Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Узел,ОбъектДляРегистрации);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// КОНЕЦ Борисенко Игорь 14.03.2022 Выполнение задач №000040516
	
	// НАЧАЛО Борисенко Игорь 15.11.2023 Выполнение задач №000047492
	РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания(Узел, МасРегистрируемыхОбъектов);
	// КОНЕЦ Борисенко Игорь 15.11.2023 Выполнение задач №000047492
	
КонецПроцедуры

