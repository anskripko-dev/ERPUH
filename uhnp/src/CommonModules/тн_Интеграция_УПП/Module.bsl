Функция ПолучитьОбъектXDTOСверкаВзаиморасчетов(СтруктураПараметров, ТекстОшибки = "")
			
	СообщениеXDTO_ЗапросДанных = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "СообщениеXDTO");
	ТекстСообщенияJSON = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "ТекстСообщенияJSON");
	
	КонтейнерXDTO = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "reconciliationOfCalculationsResponse");
	
	ИмяТипаЭлементаXDTO	 = "headers";
	ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", ИмяТипаЭлементаXDTO);
	КонтейнерXDTO[ИмяТипаЭлементаXDTO] = ЭлементКонтейнераXDTO;
	
	Параметры = Новый Структура();
	Параметры.Вставить("КонтейнерXDTO", КонтейнерXDTO);
	ДобавитьСистемныеПараметры(Параметры);
	
	// НАЧАЛО Юдина Екатерина 14.08.2025 Выполнение задач №000054776
	//КонтейнерXDTO["idRequest"] = СообщениеXDTO_ЗапросДанных.idRequest;       
	ДанныеСообщения = СообщениеXDTO_ЗапросДанных.reconciliationOfCalculationsRequestSettings;
	КонтейнерXDTO["idRequest"] = ДанныеСообщения.idRequest;
	// КОНЕЦ Юдина Екатерина 14.08.2025 Выполнение задач №000054776
	
	Если ЗначениеЗаполнено(ТекстОшибки)Тогда	
		
		КонтейнерXDTO["success"] 		= Ложь;
		КонтейнерXDTO["errorMessage"] 	= ТекстОшибки;   
		
	Иначе
		
		КонтейнерXDTO["success"] = Истина;    
	    // НАЧАЛО Юдина Екатерина 14.08.2025 Выполнение задач №000054776	
		//МассивГУИДКонтрагенты = ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(СообщениеXDTO_ЗапросДанных.counterpartyGuid, ";");
		// КОНЕЦ Юдина Екатерина 14.08.2025 Выполнение задач №000054776
		МассивКонтрагентов = Новый Массив;	
		// НАЧАЛО Юдина Екатерина 14.08.2025 Выполнение задач №000054776
		//Для Каждого СтрокаУИД Из МассивГУИДКонтрагенты Цикл   
		Для Каждого СтрокаУИД Из ДанныеСообщения.counterpartyGuid Цикл  
		// КОНЕЦ Юдина Екатерина 14.08.2025 Выполнение задач №000054776	
			
			Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаУИД));
			Если ЗначениеЗаполнено(Контрагент) Тогда
				МассивКонтрагентов.Добавить(Контрагент);
			КонецЕсли; 
			
		КонецЦикла;   
		// НАЧАЛО Юдина Екатерина 14.08.2025 Выполнение задач №000054776
		//Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(СообщениеXDTO_ЗапросДанных.organizationGuid));
		//МассивКодыСчетов =  ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(СообщениеXDTO_ЗапросДанных.accounts, ";");  
		Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеСообщения.organizationGuid));
		
		МассивКодыСчетов =  ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(ДанныеСообщения.accounts, ";");  
		// КОНЕЦ Юдина Екатерина 14.08.2025 Выполнение задач №000054776

		МассивСчетов = Новый Массив;   
		
		Для Каждого КодСчета Из МассивКодыСчетов Цикл  
			Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчета);
			Если ЗначениеЗаполнено(Счет) Тогда
				МассивСчетов.Добавить(Счет); 
			КонецЕсли;
		КонецЦикла;    
		
		МассивСубконто = Новый Массив;
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = ТекстЗапросаСверкаВзаиморасчетов();  
		// НАЧАЛО Юдина Екатерина 14.08.2025 Выполнение задач №000054776
		//Запрос.УстановитьПараметр("НачалоПериода", тн_Интеграция_ERP_УХ.ПолучитьДату(СообщениеXDTO_ЗапросДанных.dateOfReconciliationOfCalculationsBegin));			   
		//Запрос.УстановитьПараметр("КонецПериода", тн_Интеграция_ERP_УХ.ПолучитьДату(СообщениеXDTO_ЗапросДанных.dateOfReconciliationOfCalculationsEnd));	
		Запрос.УстановитьПараметр("НачалоПериода", тн_Интеграция_ERP_УХ.ПолучитьДату(ДанныеСообщения.dateOfReconciliationOfCalculationsBegin));			   
		Запрос.УстановитьПараметр("КонецПериода", тн_Интеграция_ERP_УХ.ПолучитьДату(ДанныеСообщения.dateOfReconciliationOfCalculationsEnd));	
		// КОНЕЦ Юдина Екатерина 14.08.2025 Выполнение задач №000054776
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
		Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов); 
		Запрос.УстановитьПараметр("МассивСубконто", МассивСубконто);
		
		ВыборкаТЧ = Запрос.Выполнить().Выбрать();
		
		ИмяПакетаXDTO = "tn_integrationERP";
		ИмяТипаЭлементаXDTO = "reconciliationOfCalculationsResponse";
		XDTO_ИмяТЧ = "Table";
		XDTO_ТипТЧ	= ФабрикаXDTO.Тип(ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ);
		XDTO_ТЧ		= ФабрикаXDTO.Создать(XDTO_ТипТЧ);
		
		XDTO_ТипСтрокаТЧ = ФабрикаXDTO.Тип(ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ + "String");
		
		Пока ВыборкаТЧ.Следующий() Цикл
			
			XDTO_СтрокаТЧ = ФабрикаXDTO.Создать(XDTO_ТипСтрокаТЧ);
			
			ЗаполнитьЗначенияСвойств(XDTO_СтрокаТЧ, ВыборкаТЧ);
			XDTO_СтрокаТЧ.organizationGuid = ВернутьСтрокуУИД(ВыборкаТЧ.Организация);
			XDTO_СтрокаТЧ.counterpartyGuid = ВернутьСтрокуУИД(ВыборкаТЧ.Контрагент);
			XDTO_СтрокаТЧ.contractGuid     = ВернутьСтрокуУИД(ВыборкаТЧ.ДоговорКонтрагента); 
			
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
			
		КонецЦикла; 
		
		КонтейнерXDTO[ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ] = XDTO_ТЧ;
		
	КонецЕсли;
	
	Возврат КонтейнерXDTO;
		
КонецФункции    

// Юдина (Гутарова) Екатерина 04.10.2024 Выполнение задач №000051006
//
Функция ТекстЗапросаСверкаВзаиморасчетов()
	
	Возврат 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ХозрасчетныйОстаткиИОбороты.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Субконто2 КАК Справочник.ДоговорыКонтрагентов) КАК ДоговорКонтрагента,
	|	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокДт КАК initialDebitBalanceSum,
	|	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокКт КАК initialCreditBalanceSum,
	|	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт КАК finalDebitBalanceSum,
	|	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокКт КАК finalCreditBalanceSum,
	|	ХозрасчетныйОстаткиИОбороты.Счет.Код КАК accounts,
	|	ВЫБОР
	|		КОГДА ХозрасчетныйОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДСпоАвансамИПредоплатам)
	|				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДСпоАвансамИПредоплатамВыданным)
	|				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыНДСНалоговогоАгента)
	|			ТОГДА ""76.АВ, 76.ВА, 76.НА""
	|		ИНАЧЕ ""60, 62, 76""
	|	КОНЕЦ КАК groupByAccounts
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			,
	|			Счет В ИЕРАРХИИ (&МассивСчетов),
	|			&МассивСубконто,
	|			Организация = &Организация
	|				И Субконто1 В ИЕРАРХИИ (&МассивКонтрагентов)) КАК ХозрасчетныйОстаткиИОбороты";
		
КонецФункции

// Юдина (Гутарова) Екатерина 04.10.2024 Выполнение задач №000051006
//
Функция ОтправитьСообщениеОтвет(КлючМаршрутизации = Неопределено, ТекстСообщения, КонтейнерXDTO, Узел, ИмяТипа) Экспорт
		
	ПараметрыОтправки = Новый Структура();
	// - xdto-пакет
	ПараметрыОтправки.Вставить("ИмяПакетаXDTO"		, "tn_integrationERP");
	ПараметрыОтправки.Вставить("ИмяТипаXDTO"		, ИмяТипа);
	
	// - транспорт (RabbitMQ)
	ПараметрыОтправки.Вставить("Профиль"			, Справочники.тн_ПрофилиПодключений.ERP_УХ);  
    ПараметрыОтправки.Вставить("УзелПланаОбмена"    ,  Узел);
    ПараметрыОтправки.Вставить("ФорматСообщения"	, "JSON");
	ПараметрыОтправки.Вставить("ТочкаОбменаRabbitMQ", Справочники.ТочкиОбменаRMQ.ТекущаяБаза);
	КлючМаршрутизацииСообщения = ?(КлючМаршрутизации = Неопределено, тн_Интеграция_ERP_УХ.КлючОтправителя(), КлючМаршрутизации);
	ПараметрыОтправки.Вставить("КлючМаршрутизации"	, КлючМаршрутизацииСообщения);
	
	// - логирование
	ПараметрыОтправки.Вставить("Лог_ВидСообщения"	, Перечисления.тн_ВидыСообщений_ERP_УХ[ИмяТипа]);
	ПараметрыОтправки.Вставить("Лог_ВидИнтеграции"	, Перечисления.тн_ВидыИнтеграций.ERP_УХ_Отправка);
	ПараметрыОтправки.Вставить("КонтейнерXDTO"      , КонтейнерXDTO);
	
	// НАЧАЛО Юдина Екатерина 14.08.2025 Выполнение задач №000054776
	//ОтправитьПакет(ТекстСообщения, ПараметрыОтправки);  
	ОтправитьПакет(ТекстСообщения, ПараметрыОтправки, ИмяТипа);
    // КОНЕЦ Юдина Екатерина 14.08.2025 Выполнение задач №000054776
	
КонецФункции

