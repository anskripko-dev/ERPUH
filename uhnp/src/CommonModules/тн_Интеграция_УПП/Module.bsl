	|					ИНАЧЕ ТЧПоступление.Ссылка.Распоряжение = ТЧ.Ссылка
	|				КОНЕЦ)
	|		ПО ВТ_РаспоряжениеПТУ.Ссылка = ТЧПоступление.Ссылка
	|ГДЕ
	|	ВТ_РаспоряжениеПТУ.ДокументПТУ = ТЧ.Ссылка
	// КОНЕЦ Белоконенко Денис 17.02.2023 Выполнение задач №000044442
	// НАЧАЛО Белоконенко Денис 05.12.2023 Выполнение задач №000047727
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧПоступление.Ссылка,
	|	ТЧПоступление.Номенклатура,
	|	ТЧПоступление.Упаковка,
	|	ЕСТЬNULL(ТЧПоступление.Упаковка.Код, ЕСТЬNULL(ТЧПоступление.Номенклатура.ЕдиницаИзмерения.Код, """")),
	|	ЕСТЬNULL(ТЧ.СтавкаНДС.ПеречислениеСтавкаНДС.Ссылка, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС))
	// КОНЕЦ Белоконенко Денис 05.12.2023 Выполнение задач №000047727
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Измененные";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	МаксимальныйИндекс = МассивРезультатов.ВГраница();
	
	Выборка = МассивРезультатов[МаксимальныйИндекс - 2].Выбрать();
	ВыборкаТЧ = МассивРезультатов[МаксимальныйИндекс - 1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ВыгружатьВБазуЗавода(Выборка.Ссылка, Параметры.КлючМаршрутизации) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO);
		ЗаполнитьЗначенияСвойств(ЭлементКонтейнераXDTO, Выборка);
		
		ЭлементКонтейнераXDTO.guid	 					= ВернутьСтрокуУИД(Выборка.Ссылка);
		ЭлементКонтейнераXDTO.organizationGuid			= ВернутьСтрокуУИД(Выборка.Организация);
		НаименованиеПодразделения						= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Подразделение, "Наименование");
		Если ЗначениеЗаполнено(НаименованиеПодразделения) Тогда
			ЭлементКонтейнераXDTO.departmentGuid 		= НаименованиеПодразделения;
		Иначе
			ЭлементКонтейнераXDTO.departmentGuid 		= ВернутьСтрокуУИД(Выборка.Подразделение);;
		КонецЕсли;
		ЭлементКонтейнераXDTO.counterpartyGuid			= ВернутьСтрокуУИД(Выборка.Контрагент);
		ЭлементКонтейнераXDTO.contractGuid				= ВернутьСтрокуУИД(Выборка.Договор);
		ЭлементКонтейнераXDTO.storeGuid					= ВернутьСтрокуУИД(Выборка.Склад);
		ЭлементКонтейнераXDTO.currencyGuid				= ВернутьСтрокуУИД(Выборка.Валюта);
		ЭлементКонтейнераXDTO.bankAccountOrgGuid		= ВернутьСтрокуУИД(Неопределено);
		ЭлементКонтейнераXDTO.currencySettlementGuid	= ВернутьСтрокуУИД(Выборка.Валюта);
		ЭлементКонтейнераXDTO.comment					= СтрШаблон("Загружен из ERP - документ Поступление товаров на склад №%1 от %2", Выборка.Number, Формат(Выборка.Date, "ДФ=dd.MM.yyyy"));
		//НАЧАЛО Сафиуллина З.Р. 29.03.2024 Выполнение задач №000049017
		Если ТипЗнч(Выборка.Распоряжение) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			ЭлементКонтейнераXDTO.documentOrderGuid		= ВернутьСтрокуУИД(Выборка.Распоряжение);
		КонецЕсли;
		//КОНЕЦ Сафиуллина З.Р. 29.03.2024 Выполнение задач №000049017
		
		//Табличная часть
		
		XDTO_ИмяТЧ = "TableGoods";
		XDTO_ТипТЧ	= ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ);
		XDTO_ТЧ		= ФабрикаXDTO.Создать(XDTO_ТипТЧ);
		
		XDTO_ТипСтрокаТЧ = ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ + "String");
		
		ВыборкаТЧ.Сбросить();
		Пока ВыборкаТЧ.НайтиСледующий(Новый Структура("Ссылка", Выборка.Ссылка)) Цикл
			
			XDTO_СтрокаТЧ	= ФабрикаXDTO.Создать(XDTO_ТипСтрокаТЧ);
			ЗаполнитьЗначенияСвойств(XDTO_СтрокаТЧ, ВыборкаТЧ);
			
			XDTO_СтрокаТЧ.NomenclatureGuid	= ВернутьСтрокуУИД(ВыборкаТЧ.Номенклатура);
			XDTO_СтрокаТЧ.VAT_rate 			= ИмяЗначенияПеречисленияПоСсылке(ВыборкаТЧ.СтавкаНДС);
			XDTO_СтрокаТЧ.measureGuid		= ВернутьСтрокуУИД(Неопределено);
			XDTO_СтрокаТЧ.price				= Окр(ВыборкаТЧ.price, 2, РежимОкругления.Окр15как20);	
			XDTO_СтрокаТЧ.storeGuid			= ВернутьСтрокуУИД(Неопределено);
			
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
			
		КонецЦикла; //по ТЧ
		
		ЭлементКонтейнераXDTO[XDTO_ИмяТЧ] = XDTO_ТЧ;
		
		//Добавляем объект в КонтейнерXDTO
		Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);
		
		Параметры.МасОтправленныхОбъектов.Добавить(Выборка.Ссылка);
		
	КонецЦикла; //по Объекту
		
	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);

КонецПроцедуры

// Османов Нагим 18.07.2022 Выполнение задачи №000041745
Процедура ВыгрузитьRMQ_Каркас_Документ_ПриобретениеУслугПрочихАктивов(Параметры)
	
	ИмяТипаЭлементаXDTO	 = "documentReceiptServices";

	Параметры.Вставить("ИмяОбъектаМетаданных", "Документ.ПриобретениеУслугПрочихАктивов");
	
	Запрос = НачальныеДействия_ЗапросПоИзмененнымОбъектам(Параметры);
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СуммыДокументовВВалютахУчетаСрезПоследних.Регистратор КАК Регистратор,
	|	СуммыДокументовВВалютахУчетаСрезПоследних.ИдентификаторСтроки КАК ИдентификаторСтроки,
	//НАЧАЛО Сафиуллина З.Р. 17.04.2024 Выполнение задач №000049267
	//|	СуммыДокументовВВалютахУчетаСрезПоследних.БазаНДСРегл КАК БазаНДСРегл,
	|	СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДСРегл КАК СуммаБезНДСРегл,
	//КОНЕЦ Сафиуллина З.Р. 17.04.2024 Выполнение задач №000049267
	|	СуммыДокументовВВалютахУчетаСрезПоследних.СуммаНДСРегл КАК СуммаНДСРегл
	|ПОМЕСТИТЬ ВТ_РублевыеСуммы
	|ИЗ
	|	РегистрСведений.СуммыДокументовВВалютахУчета.СрезПоследних(
	|			,
	|			Регистратор В
	|				(ВЫБРАТЬ
	|					Т.Ссылка
	|				ИЗ
	|					Измененные КАК Т)) КАК СуммыДокументовВВалютахУчетаСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объекты.Ссылка КАК Ссылка,
	|	Объекты.ПометкаУдаления КАК deletionMark,
	|	Объекты.Проведен КАК Posted,
	|	Объекты.Номер КАК Number,
	|	Объекты.Дата КАК Date,
	|	Объекты.Организация КАК Организация,
	|	Объекты.Подразделение КАК Подразделение,
	|	Объекты.Контрагент КАК Контрагент,
	|	Объекты.Договор КАК Договор,
	|	Объекты.Валюта КАК Валюта,
	|	1 КАК course,
	|	1 КАК frequencyRate,
	|	Объекты.ЦенаВключаетНДС КАК VAT_InSum,
	|	ВЫБОР
	|		КОГДА Объекты.НалогообложениеНДС = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК takeVAT,
	|	Объекты.НомерВходящегоДокумента КАК incomNumber,
	|	Объекты.ДатаВходящегоДокумента КАК incomDate,
	|	ЛОЖЬ КАК reflectInAccounting,
	|	ИСТИНА КАК reflectInManagement,
	|	""ПриобретениеУслугПрочихАктивов"" КАК operationType,
	|	Объекты.Комментарий КАК comment,
	|	"""" КАК description
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеУслугПрочихАктивов КАК Объекты
	|		ПО Измененные.Ссылка = Объекты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧПоступление.Ссылка КАК Ссылка,
	|	ТЧПоступление.Содержание КАК Содержание,
	|	ТЧПоступление.Количество КАК Quantity,
	|	1 КАК coefficient,
	//НАЧАЛО Сафиуллина З.Р. 17.04.2024 Выполнение задач №000049267
	//|	ВТ_РублевыеСуммы.БазаНДСРегл / ВЫБОР
	|	ВТ_РублевыеСуммы.СуммаБезНДСРегл / ВЫБОР
	//КОНЕЦ Сафиуллина З.Р. 17.04.2024 Выполнение задач №000049267
	|		КОГДА ЕСТЬNULL(ТЧПоступление.Количество, 0) = 0
	|			ТОГДА 1
	|		ИНАЧЕ ТЧПоступление.Количество
	|	КОНЕЦ КАК Price,
	//НАЧАЛО Сафиуллина З.Р. 17.04.2024 Выполнение задач №000049267
	//|	ВТ_РублевыеСуммы.БазаНДСРегл КАК sum,  
	|	ВТ_РублевыеСуммы.СуммаБезНДСРегл КАК sum,
	//КОНЕЦ Сафиуллина З.Р. 17.04.2024 Выполнение задач №000049267
	|	ЕСТЬNULL(ТЧПоступление.СтавкаНДС.ПеречислениеСтавкаНДС.Ссылка, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)) КАК СтавкаНДС,
	|	ВТ_РублевыеСуммы.СуммаНДСРегл КАК SumVAT,
	|	ТЧПоступление.АналитикаРасходов КАК ДокументПриобретения
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеУслугПрочихАктивов.Расходы КАК ТЧПоступление
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РублевыеСуммы КАК ВТ_РублевыеСуммы
	|			ПО ТЧПоступление.Ссылка = ВТ_РублевыеСуммы.Регистратор
	|				И ТЧПоступление.ИдентификаторСтроки = ВТ_РублевыеСуммы.ИдентификаторСтроки
	|		ПО Измененные.Ссылка = ТЧПоступление.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Измененные";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	МаксимальныйИндекс = МассивРезультатов.ВГраница();
	
	Выборка = МассивРезультатов[МаксимальныйИндекс - 2].Выбрать();
	ВыборкаТЧ = МассивРезультатов[МаксимальныйИндекс - 1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
				
		//Табличная часть
		
		XDTO_ИмяТЧ = "TableGoods";
		XDTO_ТипТЧ	= ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ);
		XDTO_ТЧ		= ФабрикаXDTO.Создать(XDTO_ТипТЧ);
		
		XDTO_ТипСтрокаТЧ = ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ + "String");

		СуммаДокумента = 0;
		СуммаНДС = 0;
		ЕстьДанныеТабличнойЧасти = Ложь;
		VAT_rate = Неопределено;	
		// НАЧАЛО Османов Нагим 09.11.2022 Выполнение задач №000043298
		ДатаОснования = Дата(1, 1, 1);
		// КОНЕЦ Османов Нагим 09.11.2022 Выполнение задач №000043298
		
		ВыборкаТЧ.Сбросить();
		Пока ВыборкаТЧ.НайтиСледующий(Новый Структура("Ссылка", Выборка.Ссылка)) Цикл
			
			Если Не ЗначениеЗаполнено(ВыборкаТЧ.ДокументПриобретения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ВыборкаТЧ.ДокументПриобретения) <> Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
				Продолжить;
			КонецЕсли;
			
			// НАЧАЛО Османов Нагим 09.11.2022 Выполнение задач №000043298
			//ПодразделениеПриобретения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаТЧ.ДокументПриобретения, "Подразделение");
			СтруктураДанныхПриобретения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаТЧ.ДокументПриобретения, "Дата, Подразделение, ХозяйственнаяОперация");
			ДатаОснования = СтруктураДанныхПриобретения.Дата;
			ПодразделениеПриобретения = СтруктураДанныхПриобретения.Подразделение;
			// КОНЕЦ Османов Нагим 09.11.2022 Выполнение задач №000043298
			Если ВыгружатьВБазуЗавода(Выборка.Ссылка, Параметры.КлючМаршрутизации, ПодразделениеПриобретения) Тогда
				ЕстьДанныеТабличнойЧасти = Истина;
			Иначе
				Продолжить;
			КонецЕсли;
			
			ГУИДОснования = ВернутьСтрокуУИД(ВыборкаТЧ.ДокументПриобретения);
			
			// НАЧАЛО Османов Нагим 09.11.2022 Выполнение задач №000043298
			//ХозяйственнаяОперацияПриобретения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаТЧ.ДокументПриобретения, "ХозяйственнаяОперация");
			ХозяйственнаяОперацияПриобретения = СтруктураДанныхПриобретения.ХозяйственнаяОперация;
			// КОНЕЦ Османов Нагим 09.11.2022 Выполнение задач №000043298
			//НАЧАЛО Лаганина Н.В. 13.10.2023 Выполнение задач №000047159
			//Если НЕ ХозяйственнаяОперацияПриобретения = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика Тогда
			СписокРазрешенныхХозОпераций = Перечисления.ХозяйственныеОперации.ПолучитьВидыОперацийРазрешенныеКВыгрузке(ВыборкаТЧ.ДокументПриобретения);
			Если СписокРазрешенныхХозОпераций.НайтиПоЗначению(ХозяйственнаяОперацияПриобретения) = Неопределено Тогда
			//КОНЕЦ Лаганина Н.В. 13.10.2023 Выполнение задач №000047159		
				ПоступлениеТоваров = Документы.ПоступлениеТоваровНаСклад.НайтиПоРеквизиту("Распоряжение", ВыборкаТЧ.ДокументПриобретения);
				
				Если Не ЗначениеЗаполнено(ПоступлениеТоваров) Тогда
					// НАЧАЛО Борисенко Игорь 08.11.2023 Выполнение задач №000047399
					//Продолжить;
					
					Если ЗначениеЗаполнено(ВыборкаТЧ.ДокументПриобретения) И ТипЗнч(ВыборкаТЧ.ДокументПриобретения) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
						// НАЧАЛО Борисенко Игорь 18.01.2024 Выполнение задач №000048171
						//ГУИДОснования = ВернутьСтрокуУИД(ВыборкаТЧ.ДокументПриобретения);

						ПоступлениеТоваров = ВернутьДокументПоступленияТоваровНаСкладПоПТиУ(ВыборкаТЧ.ДокументПриобретения);
						ГУИДОснования = ВернутьСтрокуУИД(ПоступлениеТоваров);
						// КОНЕЦ Борисенко Игорь 18.01.2024 Выполнение задач №000048171
					Иначе
						ГУИДОснования = ВернутьСтрокуУИД(Неопределено);
					КонецЕсли;
					// КОНЕЦ Борисенко Игорь 08.11.2023 Выполнение задач №000047399
				Иначе
					ГУИДОснования = ВернутьСтрокуУИД(ПоступлениеТоваров);
				КонецЕсли;
				
			КонецЕсли;
			
			XDTO_СтрокаТЧ	= ФабрикаXDTO.Создать(XDTO_ТипСтрокаТЧ);
			ЗаполнитьЗначенияСвойств(XDTO_СтрокаТЧ, ВыборкаТЧ);
			
			XDTO_СтрокаТЧ.nomenclatureName			= ВыборкаТЧ.Содержание;
			XDTO_СтрокаТЧ.VAT_rate 					= ИмяЗначенияПеречисленияПоСсылке(ВыборкаТЧ.СтавкаНДС);
			XDTO_СтрокаТЧ.measureGuid				= ВернутьСтрокуУИД(Неопределено);
			XDTO_СтрокаТЧ.documentConsignmentGuid 	= ГУИДОснования;
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
			
			СуммаДокумента = СуммаДокумента + ВыборкаТЧ.sum;
			СуммаНДС = СуммаНДС + ВыборкаТЧ.sumVAT;
			
			VAT_rate = XDTO_СтрокаТЧ.VAT_rate;
			
		КонецЦикла; //по ТЧ
		
		Если Не ЕстьДанныеТабличнойЧасти Тогда
			Продолжить;
		КонецЕсли;
		
		// Шапка
		
		ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO);
		ЗаполнитьЗначенияСвойств(ЭлементКонтейнераXDTO, Выборка);
		
		ЭлементКонтейнераXDTO.guid	 					= ВернутьСтрокуУИД(Выборка.Ссылка);
		ЭлементКонтейнераXDTO.organizationGuid			= ВернутьСтрокуУИД(Выборка.Организация);
		НаименованиеПодразделения						= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Подразделение, "Наименование");
		Если ЗначениеЗаполнено(НаименованиеПодразделения) Тогда
			ЭлементКонтейнераXDTO.departmentGuid 		= НаименованиеПодразделения;
		Иначе
			ЭлементКонтейнераXDTO.departmentGuid 		= ВернутьСтрокуУИД(Выборка.Подразделение);;
		КонецЕсли;
		ЭлементКонтейнераXDTO.counterpartyGuid			= ВернутьСтрокуУИД(Выборка.Контрагент);
		ЭлементКонтейнераXDTO.contractGuid				= ВернутьСтрокуУИД(Выборка.Договор);
		ЭлементКонтейнераXDTO.currencyGuid				= ВернутьСтрокуУИД(Выборка.Валюта);
		ЭлементКонтейнераXDTO.currencySettlementGuid	= ВернутьСтрокуУИД(Выборка.Валюта);
		ЭлементКонтейнераXDTO.agentGuid					= ВернутьСтрокуУИД(Неопределено);
		ЭлементКонтейнераXDTO.comment					= СтрШаблон("Загружен из ERP - документ Приобретение услуг и прочих активов №%1 от %2", Выборка.Number, Формат(Выборка.Date, "ДФ=dd.MM.yyyy"));
		ЭлементКонтейнераXDTO.sum 						= СуммаДокумента;
		ЭлементКонтейнераXDTO.sumVAT 					= СуммаНДС;
		// НАЧАЛО Борисенко Игорь 10.05.2023 Выполнение задач №000045430
		//ЭлементКонтейнераXDTO.VAT_rate 					= XDTO_СтрокаТЧ.VAT_rate;
		ЭлементКонтейнераXDTO.VAT_rate 					= VAT_rate;
		// КОНЕЦ Борисенко Игорь 10.05.2023 Выполнение задач №000045430
		
		// НАЧАЛО Османов Нагим 09.11.2022 Выполнение задач №000043298
		Если НачалоДня(ДатаОснования) > НачалоДня(Выборка.Date) Тогда
			ЭлементКонтейнераXDTO.Date = ДатаОснования;
		КонецЕсли;
		// КОНЕЦ Османов Нагим 09.11.2022 Выполнение задач №000043298
		
		ЭлементКонтейнераXDTO[XDTO_ИмяТЧ] 				= XDTO_ТЧ;
		
		//Добавляем объект в КонтейнерXDTO
		Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);
		
		Параметры.МасОтправленныхОбъектов.Добавить(Выборка.Ссылка);
		
	КонецЦикла; //по Объекту
		
	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);

КонецПроцедуры

// Борисенко Игорь 18.01.2024 Выполнение задач №000048171
Функция ВернутьДокументПоступленияТоваровНаСкладПоПТиУ(ПТиУ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПТиУ", ПТиУ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриобретениеТоваровУслуг.ЗаказПоставщику КАК ЗаказПоставщику,
	|	НРЕГ(ПриобретениеТоваровУслуг.НомерВходящегоДокумента) КАК НомерВходящегоДокумента
	|ПОМЕСТИТЬ втПТиУ
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|ГДЕ
	|	ПриобретениеТоваровУслуг.Ссылка = &ПТиУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровНаСклад.Ссылка КАК Ссылка,
	|	НРЕГ(ВЫРАЗИТЬ(ПоступлениеТоваровНаСклад.Комментарий КАК СТРОКА(50))) КАК Комментарий,
	|	втПТиУ.НомерВходящегоДокумента КАК НомерВходящегоДокумента
	|ПОМЕСТИТЬ втПоступленияНаСклад
	|ИЗ
	|	Документ.ПоступлениеТоваровНаСклад КАК ПоступлениеТоваровНаСклад
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПТиУ КАК втПТиУ
	|		ПО ПоступлениеТоваровНаСклад.Распоряжение = втПТиУ.ЗаказПоставщику
	|			И (НЕ ПоступлениеТоваровНаСклад.ПометкаУдаления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПоступленияНаСклад.Ссылка КАК Ссылка,
	|	втПоступленияНаСклад.Комментарий КАК Комментарий
	|ИЗ
	|	втПоступленияНаСклад КАК втПоступленияНаСклад
	|ГДЕ
	|	СТРНАЙТИ(втПоступленияНаСклад.Комментарий, втПоступленияНаСклад.НомерВходящегоДокумента) > 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Османов Нагим 19.07.2022 Выполнение задачи №000041745
Процедура ВыгрузитьRMQ_Каркас_Документ_ТаможеннаяДекларацияИмпорт(Параметры)
	
	ИмяТипаЭлементаXDTO	 = "documentReceiptServices";

	Параметры.Вставить("ИмяОбъектаМетаданных", "Документ.ТаможеннаяДекларацияИмпорт");
	
	Запрос = НачальныеДействия_ЗапросПоИзмененнымОбъектам(Параметры);
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объекты.Ссылка КАК Ссылка,
	|	Объекты.ПометкаУдаления КАК deletionMark,
	|	Объекты.Проведен КАК Posted,
	|	Объекты.Номер КАК Number,
	|	Объекты.Дата КАК Date,
	|	Объекты.Организация КАК Организация,
	|	Объекты.Подразделение КАК Подразделение,
	|	Объекты.Контрагент КАК Контрагент,
	|	Объекты.Договор КАК Договор,
	|	Объекты.Валюта КАК Валюта,
	|	1 КАК course,
	|	1 КАК frequencyRate,
	|	ЛОЖЬ КАК VAT_InSum,
	|	ЛОЖЬ КАК takeVAT,
	|	"""" КАК incomNumber,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК incomDate,
	|	Объекты.ТаможенныйСбор КАК sum,
	|	ЛОЖЬ КАК reflectInAccounting,
	|	ИСТИНА КАК reflectInManagement,
	|	""ТаможеннаяДекларацияИмпорт"" КАК operationType,
	|	Объекты.Комментарий КАК comment,
	|	"""" КАК description
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТаможеннаяДекларацияИмпорт КАК Объекты
	|		ПО Измененные.Ссылка = Объекты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧТовары.Ссылка КАК Ссылка,
	|	1 КАК coefficient,
	|	СУММА(ТЧТовары.СуммаПошлины) КАК Sum,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) КАК СтавкаНДС,
	|	0 КАК SumVAT,
	|	1 КАК Quantity,
	|	1 КАК Price,
	|	ТЧТовары.ДокументПоступления КАК ДокументПриобретения
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТаможеннаяДекларацияИмпорт.Товары КАК ТЧТовары
	|		ПО Измененные.Ссылка = ТЧТовары.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧТовары.Ссылка,
	|	ТЧТовары.ДокументПоступления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Измененные";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	МаксимальныйИндекс = МассивРезультатов.ВГраница();
	
	Выборка = МассивРезультатов[МаксимальныйИндекс - 2].Выбрать();
	ВыборкаТЧ = МассивРезультатов[МаксимальныйИндекс - 1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
				
		//Табличная часть
		
		XDTO_ИмяТЧ = "TableGoods";
		XDTO_ТипТЧ	= ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ);
		XDTO_ТЧ		= ФабрикаXDTO.Создать(XDTO_ТипТЧ);
		
		XDTO_ТипСтрокаТЧ = ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ + "String");

		ЕстьДанныеТабличнойЧасти = Ложь;
		VAT_rate = Неопределено;
		// НАЧАЛО Османов Нагим 09.11.2022 Выполнение задач №000043298
		ДатаОснования = Дата(1, 1, 1);
		// КОНЕЦ Османов Нагим 09.11.2022 Выполнение задач №000043298
		
		ВыборкаТЧ.Сбросить();
		Пока ВыборкаТЧ.НайтиСледующий(Новый Структура("Ссылка", Выборка.Ссылка)) Цикл
			
			Если Не ЗначениеЗаполнено(ВыборкаТЧ.ДокументПриобретения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВыгружатьВБазуЗавода(ВыборкаТЧ.ДокументПриобретения, Параметры.КлючМаршрутизации, Выборка.Подразделение) Тогда
				ЕстьДанныеТабличнойЧасти = Истина;
			Иначе
				Продолжить;
			КонецЕсли;
			
			ГУИДОснования = ВернутьСтрокуУИД(ВыборкаТЧ.ДокументПриобретения);

			// НАЧАЛО Османов Нагим 09.11.2022 Выполнение задач №000043298
			//ХозяйственнаяОперацияПриобретения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаТЧ.ДокументПриобретения, "ХозяйственнаяОперация");
			СтруктураДанныхПриобретения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаТЧ.ДокументПриобретения, "Дата, ХозяйственнаяОперация");
			ДатаОснования = СтруктураДанныхПриобретения.Дата;
			ХозяйственнаяОперацияПриобретения = СтруктураДанныхПриобретения.ХозяйственнаяОперация;
			// КОНЕЦ Османов Нагим 09.11.2022 Выполнение задач №000043298
			
			//НАЧАЛО Лаганина Н.В. 13.10.2023 Выполнение задач №000047159
			//Если НЕ ХозяйственнаяОперацияПриобретения = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика Тогда
			СписокРазрешенныхХозОпераций = Перечисления.ХозяйственныеОперации.ПолучитьВидыОперацийРазрешенныеКВыгрузке(ВыборкаТЧ.ДокументПриобретения);
			Если СписокРазрешенныхХозОпераций.НайтиПоЗначению(ХозяйственнаяОперацияПриобретения) = Неопределено Тогда
			//КОНЕЦ Лаганина Н.В. 13.10.2023 Выполнение задач №000047159		
				
				ПоступлениеТоваров = Документы.ПоступлениеТоваровНаСклад.НайтиПоРеквизиту("Распоряжение", ВыборкаТЧ.ДокументПриобретения);
				
				Если Не ЗначениеЗаполнено(ПоступлениеТоваров) Тогда
					Продолжить;
				Иначе
					ГУИДОснования = ВернутьСтрокуУИД(ПоступлениеТоваров);
				КонецЕсли;
				
			КонецЕсли;
			
			XDTO_СтрокаТЧ	= ФабрикаXDTO.Создать(XDTO_ТипСтрокаТЧ);
			ЗаполнитьЗначенияСвойств(XDTO_СтрокаТЧ, ВыборкаТЧ);
			
			XDTO_СтрокаТЧ.VAT_rate 					= ИмяЗначенияПеречисленияПоСсылке(ВыборкаТЧ.СтавкаНДС);
			XDTO_СтрокаТЧ.documentConsignmentGuid 	= ГУИДОснования;
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
			
			VAT_rate = XDTO_СтрокаТЧ.VAT_rate;
			
		КонецЦикла; //по ТЧ
		
		Если Не ЕстьДанныеТабличнойЧасти Тогда
			Продолжить;
		КонецЕсли;
		
		// Шапка
		
		ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO);
		ЗаполнитьЗначенияСвойств(ЭлементКонтейнераXDTO, Выборка);
		
		ЭлементКонтейнераXDTO.guid	 					= ВернутьСтрокуУИД(Выборка.Ссылка);
		ЭлементКонтейнераXDTO.organizationGuid			= ВернутьСтрокуУИД(Выборка.Организация);
		НаименованиеПодразделения						= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Подразделение, "Наименование");
		Если ЗначениеЗаполнено(НаименованиеПодразделения) Тогда
			ЭлементКонтейнераXDTO.departmentGuid 		= НаименованиеПодразделения;
		Иначе
			ЭлементКонтейнераXDTO.departmentGuid 		= ВернутьСтрокуУИД(Выборка.Подразделение);;
		КонецЕсли;
		ЭлементКонтейнераXDTO.counterpartyGuid			= ВернутьСтрокуУИД(Выборка.Контрагент);
		ЭлементКонтейнераXDTO.contractGuid				= ВернутьСтрокуУИД(Выборка.Договор);
		ЭлементКонтейнераXDTO.currencyGuid				= ВернутьСтрокуУИД(Выборка.Валюта);
		ЭлементКонтейнераXDTO.currencySettlementGuid	= ВернутьСтрокуУИД(Выборка.Валюта);
		ЭлементКонтейнераXDTO.agentGuid					= ВернутьСтрокуУИД(Неопределено);
		ЭлементКонтейнераXDTO.comment					= СтрШаблон("Загружен из ERP - документ Таможенная декларация на импорт №%1 от %2", Выборка.Number, Формат(Выборка.Date, "ДФ=dd.MM.yyyy"));
		ЭлементКонтейнераXDTO.VAT_rate 					= VAT_rate;
		ЭлементКонтейнераXDTO.sumVAT 					= 1;
		
		// НАЧАЛО Османов Нагим 09.11.2022 Выполнение задач №000043298
		Если НачалоДня(ДатаОснования) > НачалоДня(Выборка.Date) Тогда
			ЭлементКонтейнераXDTO.Date = ДатаОснования;
		КонецЕсли;
		// КОНЕЦ Османов Нагим 09.11.2022 Выполнение задач №000043298
		
		ЭлементКонтейнераXDTO[XDTO_ИмяТЧ] 				= XDTO_ТЧ;
		
		//Добавляем объект в КонтейнерXDTO
		Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);
		
		Параметры.МасОтправленныхОбъектов.Добавить(Выборка.Ссылка);
		
	КонецЦикла; //по Объекту
		
	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);

КонецПроцедуры

