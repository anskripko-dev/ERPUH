	Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO] = ЭлементКонтейнераXDTO;
	// КОНЕЦ Борисенко И.Н. 18.10.2021 Выполнение задач №000039277
	// - массив отправленных объектов
	Параметры.Вставить("МасОтправленныхОбъектов", Новый Массив);
	
	//Начать транзакцию
	Если Параметры.ИспользоватьБлокировкиТранзакции Тогда
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Узел", Параметры.УзелПланаОбмена);
