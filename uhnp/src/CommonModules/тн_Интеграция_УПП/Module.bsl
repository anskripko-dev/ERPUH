	|		КОГДА Объекты.Корректировочный
	|			ТОГДА ""Корректировочный""
	|		ИНАЧЕ ""НаПоступление""
	|	КОНЕЦ КАК kindFacture,
	|	Объекты.Исправление КАК isCorrection,
	|	ВЫБОР
	|		КОГДА Объекты.НомерИсправления = """"
	|			ТОГДА 0
	|		ИНАЧЕ Объекты.НомерИсправления
	|	КОНЕЦ КАК НомерИсправления,
	|	ВЫБОР
	|		КОГДА Объекты.Исправление
	|			ТОГДА Объекты.Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК correctionDate,
	|	Объекты.СчетФактураОснование КАК СчетФактураОснование,
	|	ЕСТЬNULL(Объекты.СчетФактураОснование.Номер, """") КАК incElNamber,
	|	ЕСТЬNULL(Объекты.СчетФактураОснование.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК incElDate,
	|	Объекты.КодВидаОперации КАК kindOperationCode,
	|	"""" КАК kindOperationDecCode
	|ИЗ
	|	Измененные КАК Измененные
