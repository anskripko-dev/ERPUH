			XDTO_СтрокаНабораЗаписей.recordType               = ВернутьВидДвиженияСтрокой(Выборка.ВидДвижения);
			//КОНЕЦ Блинова М.А. 25.12.2025 Выполнение задач №000056248
			XDTO_НаборЗаписей[ИмяТипаСтрокиНабораЗаписи].Добавить(XDTO_СтрокаНабораЗаписей);				
			
		КонецЦикла;
		
		Если XDTO_НаборЗаписей[ИмяТипаСтрокиНабораЗаписи].Количество() > 0 Тогда
			ЭлементКонтейнераXDTO[ИмяТипаНабораЗаписи] = XDTO_НаборЗаписей;		
			Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);
		КонецЕсли;
		
		//Помещаем в МасОтправленныхОбъектов для снятия с регистрации		
		НаборЗаписей = РегистрыНакопления.тн_ОстаткиПоНЗСиОС.СоздатьНаборЗаписей(); 
		
		Выборка.Сбросить();
		Пока Выборка.Следующий() Цикл 
			
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			
		КонецЦикла;                     
		
		Параметры.МасОтправленныхОбъектов.Добавить(НаборЗаписей);
		
	КонецЕсли;

	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);
	
КонецПроцедуры

