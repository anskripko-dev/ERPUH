	        ЕстьОграничения = ПроверкаВозможностиВыгрузкиНабораРегистратораРегистраНЗС(Ссылка);
			Если ЕстьОграничения Тогда
				МожноВыгружать = Ложь;
			Иначе
				МожноВыгружать = Истина;
			КонецЕсли;				
			// КОНЕЦ Белоконенко Денис 19.09.2024 Выполнение задач №000050614
		// КОНЕЦ  Гутарова Екатерина 10.10.2023 Выполнение задач №000047113			
		
		//НАЧАЛО Сафиуллина З.Р. 11.02.2026 Выполнение задач №000056699
		ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
			
			Если ЗначениеЗаполнено(Ссылка.Родитель) Тогда
				РодительЯвляетсяОбъектомЦБ = Ссылка.Родитель.тн_ЯвляетсяОбъектомЦБ
			Иначе
				РодительЯвляетсяОбъектомЦБ = Истина;
			КонецЕсли;
			Если  РодительЯвляетсяОбъектомЦБ И Ссылка.тн_СделатьФедеральным И Не Ссылка.тн_ЯвляетсяОбъектомЦБ Тогда
				МожноВыгружать = Истина;
			КонецЕсли;
		//КОНЕЦ Сафиуллина З.Р. 11.02.2026 Выполнение задач №000056699
		
		КонецЕсли;  
		
		#КонецОбласти
		// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
		
	КонецЕсли;
	
	Возврат Не МожноВыгружать;
	
КонецФункции
