// Османов Нагим 13.07.2022 Выполнение задачи №000042060
Функция ВыгружатьВБазуЗавода(СсылкаНаОбъект, КодБазыЗавода, Подразделение = Неопределено)
	
	РезультатФункции = Ложь;
	
	// проверка по признаку "Выгружать в базу завода"  в договоре, указанному в объекте
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Договор) Тогда
		// НАЧАЛО Егоров Петр 07.07.2023 Выполнение задач №000046133
		Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов")  и 
			ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(СсылкаНаОбъект, "тн_ЗарегистрироватьВОбмен") Тогда 
			ВыгружатьВБазуЗавода = Истина;
		Иначе
			// КОНЕЦ  Егоров Петр 07.07.2023 Выполнение задач №000046133		
			ВыгружатьВБазуЗавода = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект.Договор, "тн_ВыгружатьВБазуЗавода");
			// НАЧАЛО Егоров Петр 07.07.2023 Выполнение задач №000046133 
		КонецЕсли;
		// КОНЕЦ  Егоров Петр 07.07.2023 Выполнение задач №000046133		
		Если ВыгружатьВБазуЗавода = Истина Тогда				
			РезультатФункции = Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Если Не РезультатФункции Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	// проверка в РС "Соответствие контрагентов и баз заводов"
	
	ПодразделениеВДокументе = ?(Подразделение = Неопределено, СсылкаНаОбъект.Подразделение, Подразделение);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тн_СоответствиеКонтрагентовИБазЗаводов.Контрагент КАК Подразделение
	|ПОМЕСТИТЬ ВТ_СписокПодразделений
	|ИЗ
	|	РегистрСведений.тн_СоответствиеКонтрагентовИБазЗаводов КАК тн_СоответствиеКонтрагентовИБазЗаводов
	|ГДЕ
	|	тн_СоответствиеКонтрагентовИБазЗаводов.Контрагент ССЫЛКА Справочник.СтруктураПредприятия
	|	И (тн_СоответствиеКонтрагентовИБазЗаводов.БазаЗаводаИД.Код = &КодБазыЗавода
	|			ИЛИ &КодБазыЗавода = НЕОПРЕДЕЛЕНО)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Подразделение В ИЕРАРХИИ
	|		(ВЫБРАТЬ
	|			Т.Подразделение
	|		ИЗ
	|			ВТ_СписокПодразделений КАК Т) КАК ЕстьВхождениеПодразделения";
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеВДокументе);
	Запрос.УстановитьПараметр("КодБазыЗавода", КодБазыЗавода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	РезультатФункции = Выборка.ЕстьВхождениеПодразделения;
	
	Возврат РезультатФункции;
	
КонецФункции

// Борисенко Игорь 03.12.2020 Выполнение задач №000036599
Функция СформироватьТаблицуОбъектов(НаправлениеВыгрузки = "Каркас") Экспорт
	
	Если НаправлениеВыгрузки = "Каркас" Тогда
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_Каркас();
	ИначеЕсли НаправлениеВыгрузки = "ОКС" Тогда
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ОКС();
	// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	ИначеЕсли НаправлениеВыгрузки = "ЦБ" Тогда
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ЦБ();
	// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	Иначе
		Параметры = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьПараметрыОбмена_ЗУП();
	КонецЕсли;
	
	ДеревоОписаний = Параметры.ДеревоОписаний;

	ТаблицаОбъектов = Новый ТаблицаЗначений;
	ТаблицаОбъектов.Колонки.Добавить("ФормироватьJSON");
	ТаблицаОбъектов.Колонки.Добавить("ИмяОбъектаМетаданных");
	ТаблицаОбъектов.Колонки.Добавить("СсылкаДляПримера");
	
	ТочкаОбменаRabbitMQ = Справочники.ТочкиОбменаRMQ.ТекущаяБаза;

	Для каждого СтрокаДерева Из ДеревоОписаний.Строки Цикл

		Если Не ЗначениеЗаполнено(ТочкаОбменаRabbitMQ) Или Не тн_Интеграция_УПП.НужноВыгружать(ТочкаОбменаRabbitMQ.Наименование, СтрокаДерева.ИмяОбъектаМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОбъектов = ТаблицаОбъектов.Добавить();
		СтрокаОбъектов.ИмяОбъектаМетаданных = СтрокаДерева.ИмяОбъектаМетаданных;
	КонецЦикла;
	
	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ТаблицаОбъектов);
	Возврат АдресВременногоХранилища;
	
КонецФункции

// Борисенко Игорь 06.03.2023 Выполнение задач №000044668
Процедура УбратьДублиСтрокОписанияПоИменамОбъектовМетаданных(СтрокиДереваОписаний)
	
	МассивОбъектовМетаданных = Новый Массив;
	инд = 0;
	Пока инд < СтрокиДереваОписаний.Количество() Цикл
		СтрокаДерева = СтрокиДереваОписаний[инд];
		Если МассивОбъектовМетаданных.Найти(СтрокаДерева.ИмяОбъектаМетаданных) = Неопределено Тогда
			МассивОбъектовМетаданных.Добавить(СтрокаДерева.ИмяОбъектаМетаданных);
			инд = инд + 1;
		Иначе
			СтрокиДереваОписаний.Удалить(СтрокаДерева);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

