	|		КОНЕЦ КАК organizationKPP,
	// КОНЕЦ Борисенко Игорь 22.09.2022 Выполнение задач №000042707	
	|	ЕСТЬNULL(Объекты.Договор.Номер, """") КАК contractNumber,
	|	ЕСТЬNULL(Объекты.Договор.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК contractDate,
	//НАЧАЛО Качикина 17.07.2024 Выполнение задач №000049962
	|	Объекты.тн_ПриходныйОрдер_ГУИД КАК тн_ПриходныйОрдер_ГУИД,
	//КОНЕЦ Качикина 17.07.2024 Выполнение задач №000049962
	|	Объекты.Комментарий КАК comment
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Объекты
	|		ПО Измененные.Ссылка = Объекты.Ссылка
    // НАЧАЛО Борисенко Игорь 22.09.2022 Выполнение задач №000042707
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РНО
	|		ПО Объекты.Организация.КодНалоговогоОрганаПолучателя = РНО.Код
	|			И Объекты.Организация = РНО.Владелец
    // КОНЕЦ Борисенко Игорь 22.09.2022 Выполнение задач №000042707 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК Ссылка,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ТЧ.Упаковка.Ссылка ЕСТЬ NULL
	|			ТОГДА ТЧ.Количество
	|		ИНАЧЕ ТЧ.КоличествоУпаковок
	|	КОНЕЦ КАК Quantity,
	|	1 КАК coefficient,
	|	ТЧ.Упаковка КАК Упаковка,
	|	ЕСТЬNULL(ТЧ.Упаковка.Код, ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """")) КАК codeMeasure,
	|	ТЧ.Цена КАК Price,
	|	ТЧ.Сумма КАК Sum,
	|	ЕСТЬNULL(ТЧ.СтавкаНДС.ПеречислениеСтавкаНДС.Ссылка, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)) КАК СтавкаНДС,
	|	ТЧ.СуммаНДС КАК SumVAT,
	|	ТЧ.Склад КАК Склад
	|ИЗ
