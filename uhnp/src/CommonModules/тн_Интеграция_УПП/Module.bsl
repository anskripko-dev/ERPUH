#Область РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания

// Борисенко Игорь 15.11.2023 Выполнение задач №000047492
Процедура УстановитьМаячокОНачалеВыполненияТекущегоРегламентногоЗадания(Параметры)
		
	РеглЗаданиеИД = Строка(Новый УникальныйИдентификатор());
	РеглЗаданиеВремя = ТекущаяДатаСеанса();
	
	Параметры.Вставить("РеглЗаданиеИД"		, РеглЗаданиеИД);
	Параметры.Вставить("РеглЗаданиеВремя"	, РеглЗаданиеВремя);
	
	//Ставим "маячок" (без заполнения ВыгружаемыйОбъектСсылка) о начале работы задания на выгрузку	
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запись = РегистрыСведений.тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.СоздатьМенеджерЗаписи();
	Запись.Узел = Параметры.УзелПланаОбмена;
	Запись.РеглЗаданиеИД = РеглЗаданиеИД;
	Запись.ВремяНачалаРаботы = РеглЗаданиеВремя;
	Запись.Записать(Истина);
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Борисенко Игорь 15.11.2023 Выполнение задач №000047492
Процедура РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания(Узел, МассивРегистрируемыхОбъектов)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;
	Если МассивРегистрируемыхОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас() Тогда
		ПланОбменаИмя = "тн_Интеграция_УПП";
	ИначеЕсли Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ОКС() Тогда
		ПланОбменаИмя = "тн_Интеграция_УПП_ОКС";
	ИначеЕсли Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЦБ() Тогда
		ПланОбменаИмя = "тн_Интеграция_УПП_ЦБ";
	ИначеЕсли Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЗУП() Тогда
		ПланОбменаИмя = "тн_Интеграция_ЗУП";
	Иначе
		Возврат; //не предусмотренный случай
	КонецЕсли;
	
	//Предварительно регистрируем в регистре
	Выборка = ПараметрыВыполняемогоРегламентногоЗадания(Узел);
	Если Выборка <> Неопределено Тогда
		Выборка.Следующий();
		
		УстановитьПривилегированныйРежим(Истина);
		
		Для каждого ОбъектДляРегистрации Из МассивРегистрируемыхОбъектов Цикл
			Если Не ЗначениеЗаполнено(ОбъектДляРегистрации) Тогда
				Продолжить;
			КонецЕсли;
			
			
			ЕстьВПланеОбмена = Метаданные.ПланыОбмена[ПланОбменаИмя].Состав.Найти(ОбъектДляРегистрации.Метаданные()) <> Неопределено;
			Если ЕстьВПланеОбмена Тогда

				Запись = РегистрыСведений.тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Запись.ВыгружаемыйОбъектСсылка = ОбъектДляРегистрации;
				Запись.Записать(Истина);
				
			КонецЕсли;
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 15.11.2023 Выполнение задач №000047492
Функция ПараметрыВыполняемогоРегламентногоЗадания(Узел)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.Узел КАК Узел,
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.РеглЗаданиеИД КАК РеглЗаданиеИД,
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.ВремяНачалаРаботы КАК ВремяНачалаРаботы
	|ИЗ
	|	РегистрСведений.тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания КАК тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания
	|ГДЕ
	|	тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.Узел = &Узел";
		
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат.Выбрать();
	КонецЕсли;
		
КонецФункции

// Борисенко Игорь 15.11.2023 Выполнение задач №000047492
Процедура ВосстановитьРегистрацииЗависшихРеглЗаданий()
	
	Выборка = ПолучитьРегистрацииЗависшихРеглЗаданий();
	Если Выборка <> Неопределено Тогда
		Пока Выборка.Следующий() Цикл
			ВосстановитьРегистрацииЗаВремяВыполненияТекущегоРегламентногоЗадания(Выборка.Узел, Выборка.РеглЗаданиеИД);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 15.11.2023 Выполнение задач №000047492
Процедура ВосстановитьРегистрацииЗаВремяВыполненияТекущегоРегламентногоЗадания(Узел, РеглЗаданиеИД)
	
	Если ЗначениеЗаполнено(Узел) Тогда
		
		Если Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас() Тогда
			ПланОбменаИмя = "тн_Интеграция_УПП";
		ИначеЕсли Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ОКС() Тогда
			ПланОбменаИмя = "тн_Интеграция_УПП_ОКС";
		ИначеЕсли Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЦБ() Тогда
			ПланОбменаИмя = "тн_Интеграция_УПП_ЦБ";
		ИначеЕсли Узел = тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ЗУП() Тогда
			ПланОбменаИмя = "тн_Интеграция_ЗУП";
		Иначе
			Возврат; //не предусмотренный случай
		КонецЕсли;
		
		Выборка = ПолучитьРегистрацииЗаВремяВыполненияТекущегоРегламентногоЗадания(Узел, РеглЗаданиеИД);
		Если Выборка <> Неопределено Тогда

			УстановитьПривилегированныйРежим(Истина);
			
			//Переносим предварительные регистрации из Регистра в ПланОбмена
			Пока Выборка.Следующий() Цикл
				
				ОбъектДляРегистрации = Выборка.ВыгружаемыйОбъектСсылка;
				Если Не ЗначениеЗаполнено(ОбъектДляРегистрации) Тогда
					Продолжить;
				КонецЕсли;
				
				ЕстьВПланеОбмена = Метаданные.ПланыОбмена[ПланОбменаИмя].Состав.Найти(ОбъектДляРегистрации.Метаданные()) <> Неопределено;
				Если ЕстьВПланеОбмена Тогда
					ПланыОбмена.ЗарегистрироватьИзменения(Узел,ОбъектДляРегистрации);
				КонецЕсли;
				
			КонецЦикла;
			
			//Очищаем регистр
			Набор = РегистрыСведений.тн_РегистрацияНаВыгрузкуВоВремяВыполненияРеглЗадания.СоздатьНаборЗаписей();
			Набор.Отбор.Узел.Установить(Узел);
			Набор.Отбор.РеглЗаданиеИД.Установить(РеглЗаданиеИД);
			Набор.Записать(Истина);

			УстановитьПривилегированныйРежим(Ложь);
		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

