	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Аналитики.АналитикаДоходовРасходов КАК Партнер,
	|	МАКСИМУМ(Контрагенты.тн_Принадлежность) КАК тн_Принадлежность
	|ПОМЕСТИТЬ Партнеры
	|ИЗ Аналитики КАК Аналитики
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Контрагенты.Партнер = Аналитики.АналитикаДоходовРасходов
	|СГРУППИРОВАТЬ ПО
	|	Аналитики.АналитикаДоходовРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	// КОНЕЦ Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	|	Объекты.Ссылка КАК Ссылка,
	|	Объекты.ПометкаУдаления КАК deletionMark,
	|	Объекты.Проведен КАК Posted,
	|	Объекты.Дата КАК Date,
	|	Объекты.Представление КАК comment,
	|	Объекты.тн_КонтрагентПеревыставления КАК тн_КонтрагентПеревыставления,
	|	Объекты.тн_ДоговорПеревыставления КАК тн_ДоговорПеревыставления,
	|	Объекты.ХозяйственнаяОперация КАК ХозяйственнаяОперация
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрочиеДоходыРасходы КАК Объекты
	|		ПО Измененные.Ссылка = Объекты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК Ссылка,
	|	ТЧ.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(ТЧ.Подразделение.Наименование, """") КАК departmentName,
	|	ЕСТЬNULL(ТЧ.Подразделение.тн_КодПодразделенияВКомпании, """") КАК departmentCode,
	|	ТЧ.СуммаБезНДС КАК sum,
	// НАЧАЛО Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	|	ВЫБОР 
	|		КОГДА ТИПЗНАЧЕНИЯ(ТЧ.АналитикаРасходов) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ЕстьNULL(ВЫРАЗИТЬ(ТЧ.АналитикаРасходов КАК Справочник.Контрагенты).тн_Принадлежность, НЕОПРЕДЕЛЕНО)
	|		КОГДА ТИПЗНАЧЕНИЯ(ТЧ.АналитикаРасходов) = ТИП(Справочник.Партнеры)
	|			ТОГДА ЕстьNULL(Партнеры.тн_Принадлежность, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Принадлежность,
	// КОНЕЦ Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	// НАЧАЛО Егоров Петр 20.09.2023 Выполнение задач №000046923
	//|	ЕСТЬNULL(ТЧ.СтатьяРасходов.тн_КодКонсолидации, """") КАК costItemCode,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТЧ.тн_ВыгружатьПоКодамКонсолидации, Ложь)
	|			ТОГДА ЕСТЬNULL(ТЧ.СтатьяРасходов.тн_КодКонсолидации, """")
	|		ИНАЧЕ ЕСТЬNULL(ТЧ.СтатьяРасходов.Код, """")
	|	КОНЕЦ КАК costItemCode,

	// КОНЕЦ  Егоров Петр 20.09.2023 Выполнение задач №000046923
	|	ТЧ.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрочиеДоходыРасходы.ПрочиеРасходы КАК ТЧ
	|		ПО Измененные.Ссылка = ТЧ.Ссылка
	// НАЧАЛО Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	|	ЛЕВОЕ СОЕДИНЕНИЕ Партнеры КАК Партнеры
	|		ПО Партнеры.Партнер = ТЧ.АналитикаРасходов
	// КОНЕЦ Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Ссылка,
	|	ТЧ.Подразделение,
	|	ЕСТЬNULL(ТЧ.Подразделение.Наименование, """"),
	|	ЕСТЬNULL(ТЧ.Подразделение.тн_КодПодразделенияВКомпании, """"),
	|	- ТЧ.Сумма,
	// НАЧАЛО Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	|	ВЫБОР 
	|		КОГДА ТИПЗНАЧЕНИЯ(ТЧ.АналитикаДоходов) = ТИП(Справочник.Партнеры)
	|			ТОГДА ЕстьNULL(Партнеры.тн_Принадлежность, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Принадлежность,
	// КОНЕЦ Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	// НАЧАЛО Егоров Петр 20.09.2023 Выполнение задач №000046923
	//|	ЕСТЬNULL(ТЧ.СтатьяДоходов.тн_КодКонсолидации, """"),
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТЧ.тн_ВыгружатьПоКодамКонсолидации, Ложь)
	|			ТОГДА ЕСТЬNULL(ТЧ.СтатьяДоходов.тн_КодКонсолидации, """")
	|		ИНАЧЕ ЕСТЬNULL(ТЧ.СтатьяДоходов.Код, """")
	|	КОНЕЦ,
	// КОНЕЦ  Егоров Петр 20.09.2023 Выполнение задач №000046923
	|	ТЧ.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	Измененные КАК Измененные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрочиеДоходыРасходы.ПрочиеДоходы КАК ТЧ
	|		ПО Измененные.Ссылка = ТЧ.Ссылка
	// НАЧАЛО Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	|	ЛЕВОЕ СОЕДИНЕНИЕ Партнеры КАК Партнеры
	|		ПО Партнеры.Партнер = ТЧ.АналитикаДоходов
	// КОНЕЦ Борисенко Игорь 27.12.2022 Выполнение задач №000043807
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Измененные";
	
	МасРезультатов = Запрос.ВыполнитьПакет();
	МаксИнд = МасРезультатов.ВГраница();
	
	Выборка = МасРезультатов[МаксИнд - 2].Выбрать();
	ВыборкаТЧ = МасРезультатов[МаксИнд - 1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO);
		
		ЗаполнитьЗначенияСвойств(ЭлементКонтейнераXDTO, Выборка);
		
		ЭлементКонтейнераXDTO.guid	 		= ВернутьСтрокуУИД(Выборка.Ссылка);
		ЭлементКонтейнераXDTO.operationType	= ИмяЗначенияПеречисленияПоСсылке(Выборка.ХозяйственнаяОперация);
		ЭлементКонтейнераXDTO.counterpartyGuid 	= ВернутьСтрокуУИД(Выборка.тн_КонтрагентПеревыставления);
		//НАЧАЛО Блинова М.А. 23.03.2026 Выполнение задач №000056991 
		Если ИмяЗначенияПеречисленияПоСсылке(Выборка.ХозяйственнаяОперация) = "тн_ПеревыставлениеЗатрат" Тогда 
			ОтборДляКурсаВалют =  Новый Структура;
			ОтборДляКурсаВалют.Вставить("Валюта", Справочники.Валюты.НайтиПоНаименованию("BYN"));
			ТЗКурсВалют = РегистрыСведений.КурсыВалют.СрезПоследних(Выборка.Date, ОтборДляКурсаВалют);
			Для Каждого СтрокаКурсВалют Из ТЗКурсВалют Цикл  
				 ЭлементКонтейнераXDTO.exchangeRate = СтрокаКурсВалют.Курс/СтрокаКурсВалют.Кратность;
			КонецЦикла;
        КонецЕсли;
		//КОНЕЦ Блинова М.А. 23.03.2026 Выполнение задач №000056991

		//ТЧ
		XDTO_ИмяТЧ = "TableServices";
		XDTO_ТипТЧ	= ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ);
		XDTO_ТЧ		= ФабрикаXDTO.Создать(XDTO_ТипТЧ);
		
		XDTO_ТипСтрокаТЧ = ФабрикаXDTO.Тип(Параметры.ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ +"String");
		ВыборкаТЧ.Сбросить();
		Пока ВыборкаТЧ.НайтиСледующий(Новый Структура("Ссылка", Выборка.Ссылка)) Цикл
			
			XDTO_СтрокаТЧ	= ФабрикаXDTO.Создать(XDTO_ТипСтрокаТЧ);
			
			ЗаполнитьЗначенияСвойств(XDTO_СтрокаТЧ, ВыборкаТЧ);
			
			XDTO_СтрокаТЧ.departmentGuid = ВернутьСтрокуУИД(ВыборкаТЧ.Подразделение);
			XDTO_СтрокаТЧ.directionOfActivityGuid = ВернутьСтрокуУИД(ВыборкаТЧ.НаправлениеДеятельности);
			XDTO_СтрокаТЧ.departmentName = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаТЧ.Подразделение, "Наименование");

			// НАЧАЛО Борисенко Игорь 27.12.2022 Выполнение задач №000043807
			XDTO_СтрокаТЧ.companyStructureGuid = ВернутьСтрокуУИД(ВыборкаТЧ.Принадлежность);
			// КОНЕЦ Борисенко Игорь 27.12.2022 Выполнение задач №000043807
			
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
			
		КонецЦикла; //по ТЧ
		
		ЭлементКонтейнераXDTO[XDTO_ИмяТЧ] = XDTO_ТЧ;
		
		//Добавляем объект в КонтейнерXDTO
		Параметры.КонтейнерXDTO[ИмяТипаЭлементаXDTO].Добавить(ЭлементКонтейнераXDTO);
		
		Параметры.МасОтправленныхОбъектов.Добавить(Выборка.Ссылка);
		
	КонецЦикла; //по Объекту
		
	ЗавершающиеДействия_ОтправитьСообщениеRMQ(Параметры);

КонецПроцедуры

