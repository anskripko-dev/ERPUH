Функция НачальныеДействия_ЗапросПоИзмененнымОбъектам(Параметры)
	
	Если Параметры.Свойство("АдресВременногоХранилища") Тогда
		//это формирование json-описания; запрос формируем по ссылки "для примера"
		Возврат Параметры.Запрос;
	КонецЕсли;
	
	//Инициализировать:
	// - логирование
	// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	ДанныеДляЛогирования = ПолучитьДанныеДляЛогирования(Параметры.Лог_ВидСообщения, , , Параметры.Профиль.ВестиЛоги, Параметры.Лог_ВидИнтеграции);
	ДанныеДляЛогирования.БазаРеспондентИД = Параметры.КлючМаршрутизации;
	Параметры.Вставить("ДанныеДляЛогирования", ДанныеДляЛогирования);
	// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
    // - xdto-контейнер
	Параметры.Вставить("КонтейнерXDTO", тн_Интеграция.СоздатьКонтейнерXDTO(Параметры.ИмяПакетаXDTO, Параметры.ИмяТипаXDTO)); //tn_integrationERP - listObject
