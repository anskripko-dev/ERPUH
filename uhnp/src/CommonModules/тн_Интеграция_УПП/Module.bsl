			XDTO_СтрокаТЧ.productionUnitsGuid = ВернутьСтрокуУИД(ВыборкаТЧ.ПроизводственноеПодразделение);
			
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
			
