Функция НужноВыгружать(Имя_ТочкаОбменаRabbitMQ, Ссылка_Имя, НаправлениеВыгрузки = "Каркас") Экспорт
// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257

	Если ТипЗнч(Ссылка_Имя) = Тип("Строка") Тогда
		ИмяОбъектаМетаданных = Ссылка_Имя;
	Иначе
		ИмяОбъектаМетаданных = ПолучитьИмяОбъектаМетаданных(Ссылка_Имя);
		Если ИмяОбъектаМетаданных = "" Тогда
			Возврат Ложь; //выгрузка таких объектов не предусмотрена
		КонецЕсли;
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	Если НаправлениеВыгрузки = "Каркас" Тогда
	// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
		
		// НАЧАЛО Борисенко И.Н. 03.12.2021 Выполнение задач №000039277
		Если НеИмеетСамостоятельнойВыборки(ИмяОбъектаМетаданных) Тогда
			Возврат Ложь; //Объекты добавлены в Параметры.ДеревоОписаний для работы генератора json-схем, но в плане обмена не регистрируются
		КонецЕсли;
		// КОНЕЦ Борисенко И.Н. 03.12.2021 Выполнение задач №000039277
	
		Если ЕстьОграничение_ПоВидуОбъекта_И_ДругимРеквизитам(Ссылка_Имя, НаправлениеВыгрузки) Тогда
			Возврат Ложь;
			
		КонецЕсли;
	// НАЧАЛО Белоконенко Денис 18.02.2022 Выполнение задач №000040436	
	ИначеЕсли НаправлениеВыгрузки = "ОКС" Тогда
	
		Если ЕстьОграничение_ПоВидуОбъекта_И_ДругимРеквизитам(Ссылка_Имя, НаправлениеВыгрузки) Тогда
			Возврат Ложь;
			
		КонецЕсли;
	// КОНЕЦ Белоконенко Денис 18.02.2022 Выполнение задач №000040436		
	// НАЧАЛО Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	ИначеЕсли НаправлениеВыгрузки = "ЗУП" Тогда
		Возврат Истина;
		
	// НАЧАЛО Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	ИначеЕсли НаправлениеВыгрузки = "ЦБ" Тогда

		Если ЕстьОграничение_ПоВидуОбъекта_И_ДругимРеквизитам(Ссылка_Имя, НаправлениеВыгрузки) Тогда
			Возврат Ложь;
			
		КонецЕсли;
		
	// КОНЕЦ Борисенко Игорь 19.12.2022 Выполнение задач №000043725
	КонецЕсли;
	// КОНЕЦ Борисенко Игорь 22.06.2021 Выполнение задач №000038257
	
	Возврат Истина; //ограничений на выгрузку нет
	
