//Процедура ОбработкаДополнительныхНастроекСхемы_ПослеЗаписиДокумента(Основание, СхемаФормированияДокументов, ОписаниеРеквизита, СообщенияОбОшибках)  
Процедура ОбработкаДополнительныхНастроекСхемы_ПослеЗаписиДокумента(Основание, СхемаФормированияДокументов, ОписаниеРеквизита, СообщенияОбОшибках, ДокументИнициатор)
//КОНЕЦ Блинова М.А. 09.09.2025 Выполнение задач №000054680
	
	ТипДокументаОснования = ТипЗнч(Основание);                                              
	
	//НАЧАЛО Качикина 30.09.2024 Выполнение задач №000050874
	//Если СхемаФормированияДокументов.РегистрацияСчетаФактуры Тогда  
	ВидДокументаОснования = СхемаФормированияДокументов.ВидДокумента;
	Если СхемаФормированияДокументов.РегистрацияСчетаФактуры
		И Основание.Проведен Тогда
	//КОНЕЦ Качикина 30.09.2024 Выполнение задач №000050874
			
		ОписаниеРеквизита	= "/необходимо регистрировать счет-фактуру/";	
				
		Если ТипДокументаОснования = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями") Тогда
			
			//ищем существующую СФ выданную 
			ПараметрыРегистрации = Документы.ПередачаТоваровМеждуОрганизациями.ПараметрыРегистрацииСчетовФактурВыданных(Основание);
			СчетаФактурыВыданныеНаОсновании = УчетНДСУП.СчетаФактурыВыданныеНаОсновании(ПараметрыРегистрации);
			Если СчетаФактурыВыданныеНаОсновании.СчетаФактуры.Количество()>0 Тогда
				ДокументСчетФактура = СчетаФактурыВыданныеНаОсновании.СчетаФактуры[0].ПолучитьОбъект();	 
			Иначе
				ДокументСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();	
			КонецЕсли;
			
			ДокументСчетФактура.Контрагент = ?(Основание.РасчетыЧерезОтдельногоКонтрагента,
			Основание.Контрагент,
			Основание.ОрганизацияПолучатель); 
			
			СтрокаОснований = ДокументСчетФактура.ДокументыОснования.Добавить();
			СтрокаОснований.ДокументОснование 	= Основание;
			
			ДокументСчетФактура.ДокументОснование 	= Основание;
			ДокументСчетФактура.КодВидаОперации = Документы.СчетФактураВыданный.КодВидаОперации(ДокументСчетФактура.ДокументыОснования, ДокументСчетФактура.Покупатели, 
													ДокументСчетФактура.Дата, Основание);
			ДокументСчетФактура.Дата 				= ТекущаяДатаСеанса();
			ДокументСчетФактура.ДатаВыставления 	= ТекущаяДатаСеанса();
			ДокументСчетФактура.ЗаполнитьПараметрыСчетаФактурыПоОснованию(Основание);
			
			
			ДокументСчетФактура.Записать(РежимЗаписиДокумента.Проведение);
			
		//НАЧАЛО Качикина 30.09.2024 Выполнение задач №000050874
		ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
			//регистрируем СчетФактуруВЫДАННУЮ
			//если СчФ уже есть, то при перезаписи документа-основания она была актуализирована
			//здесь обрабатываем только первичное создание
			ПараметрыРегистрации = Документы[ВидДокументаОснования].ПараметрыРегистрацииСчетовФактурВыданных(Основание);
			СчетаФактурыВыданныеНаОсновании = УчетНДСУП.СчетаФактурыВыданныеНаОсновании(ПараметрыРегистрации);
			Если НЕ СчетаФактурыВыданныеНаОсновании.СчетаФактуры.Количество()>0 Тогда 
				ДокументСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
				СтрокаОснований = ДокументСчетФактура.ДокументыОснования.Добавить();
				СтрокаОснований.ДокументОснование 	= Основание;			
				ДокументСчетФактура.ДокументОснование 	= Основание;
				ДокументСчетФактура.КодВидаОперации = Документы.СчетФактураВыданный.КодВидаОперации(ДокументСчетФактура.ДокументыОснования, ДокументСчетФактура.Покупатели, 
				ДокументСчетФактура.Дата, Основание);
				ДокументСчетФактура.Дата 				= ТекущаяДатаСеанса();
				ДокументСчетФактура.ДатаВыставления 	= ТекущаяДатаСеанса();
				ДокументСчетФактура.ЗаполнитьПараметрыСчетаФактурыПоОснованию(Основание); 
				//НАЧАЛО Качикина 02.04.2025 Выполнение задач №000053260  
				//Покупатели не заполняются в ЗаполнитьПараметрыСчетаФактурыПоОснованию(), но если РеализацияЧерезКомиссионера, то они должны быть заполнены!
				Если ДокументСчетФактура.РеализацияЧерезКомиссионера
					И ДокументСчетФактура.ДокументыОснования.Количество() > 0 Тогда	
					Клиенты = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ДокументСчетФактура.ДокументыОснования.Выгрузить(,"ДокументОснование").ВыгрузитьКолонку("ДокументОснование"), "КлиентКонтрагент");
					ДокументСчетФактура.Покупатели.Загрузить(Документы.СчетФактураВыданный.ПолучитьПокупателей(Клиенты, ДокументСчетФактура.Дата, Истина));	
					ДокументСчетФактура.КодВидаОперации = Документы.СчетФактураВыданный.КодВидаОперации(ДокументСчетФактура.ДокументыОснования, ДокументСчетФактура.Покупатели, ДокументСчетФактура.Дата);
					//НАЧАЛО Блинова М.А. 09.09.2025 Выполнение задач №000054680  
					//нам нужно заполнить счф номер счф, выданной первичному клиенту
					 Запрос = Новый Запрос;
					 Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
					                |	тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор КАК ИзначальнаяРТиУ,
					                |	тн_РезультатыАвтоматическогоФормированияДокументов.СформированныйДокумент КАК СформированныйДокумент,
					                |	тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор.Партнер КАК ДокументИнициаторПартнер
					                |ПОМЕСТИТЬ ВТ_ИзначальнаяРеализация
					                |ИЗ
					                |	РегистрСведений.тн_РезультатыАвтоматическогоФормированияДокументов КАК тн_РезультатыАвтоматическогоФормированияДокументов
					                |ГДЕ
					                |	тн_РезультатыАвтоматическогоФормированияДокументов.СформированныйДокумент В(&ДокументыОснования)
					                |;
					                |
					                |////////////////////////////////////////////////////////////////////////////////
					                |ВЫБРАТЬ
					                |	СчетФактураВыданный.ПредставлениеНомера КАК ПредставлениеНомера,
					                |	ВТ_ИзначальнаяРеализация.ИзначальнаяРТиУ КАК ИзначальнаяРТиУ,
					                |	ВТ_ИзначальнаяРеализация.ДокументИнициаторПартнер КАК ДокументИнициаторПартнер
					                |ИЗ
					                |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
					                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ИзначальнаяРеализация КАК ВТ_ИзначальнаяРеализация
					                |		ПО СчетФактураВыданный.ДокументОснование = ВТ_ИзначальнаяРеализация.ИзначальнаяРТиУ";
					 Запрос.УстановитьПараметр("ДокументыОснования", ДокументИнициатор);
					 
					 Выборка = Запрос.Выполнить().Выбрать();
					 Пока Выборка.Следующий() Цикл 
						  СтруктураОтбора = Новый Структура;
						  СтруктураОтбора.Вставить("ДокументОснование", Основание); 
						  МассивОтобранныхСтрок = ДокументСчетФактура.Покупатели.НайтиСтроки(СтруктураОтбора);
						  Для Каждого СтрокаПокупателей Из МассивОтобранныхСтрок Цикл
							 СтрокаПокупателей.НомерСчетаФактуры = Выборка.ПредставлениеНомера;
						 КонецЦикла;   
					КонецЦикла;	 
					//КОНЕЦ Блинова М.А. 09.09.2025 Выполнение задач №000054680
				КонецЕсли;
   				//КОНЕЦ Качикина 02.04.2025 Выполнение задач №000053260
				ДокументСчетФактура.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
				
		ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			//регистрируем СчетФактуруПОЛУЧЕННУЮ
			//если СчФ уже есть, то при перезаписи документа-основания она была актуализирована
			//здесь обрабатываем только первичное создание
			ПараметрыРегистрации = Документы[ВидДокументаОснования].ПараметрыРегистрацииСчетовФактурПолученных(Основание);
			СчетаФактурыПолученныеНаОсновании = УчетНДСУП.СчетаФактурыПолученныеНаОсновании(ПараметрыРегистрации);
			Если НЕ СчетаФактурыПолученныеНаОсновании.СчетаФактуры.Количество()>0 Тогда	
				ДокументСчетФактура = Документы.СчетФактураПолученный.СоздатьДокумент();						
				СтрокаОснований = ДокументСчетФактура.ДокументыОснования.Добавить();
				СтрокаОснований.ДокументОснование 	= Основание;	
				ДокументСчетФактура.Дата 				= ТекущаяДатаСеанса();
				ДокументСчетФактура.ДатаСоставления 	= ТекущаяДатаСеанса();
				ДокументСчетФактура.ЗаполнитьПараметрыСчетаФактурыПоОснованию();	
				ДокументСчетФактура.Записать(РежимЗаписиДокумента.Проведение);		
			КонецЕсли;
		//КОНЕЦ Качикина 30.09.2024 Выполнение задач №000050874
		Иначе
			
			//отказ регистрировать не будем, но сообщение в ЖР занесем
			СообщенияОбОшибках = СообщенияОбОшибках + Символы.ПС + "Не предусмотрен автоматический ввод счета-фактуры для документа типа " + Строка(ТипДокументаОснования);
			
		КонецЕсли;
		
	КонецЕсли;
	//НАЧАЛО Блинова М.А. 03.09.2025 Выполнение задач №000054684   
	ОперацияОснования = Основание.ХозяйственнаяОперация;
	Если СхемаФормированияДокументов.РегистрацияПриходногоОрдера  И ВидДокументаОснования = "ПриобретениеТоваровУслуг"
		//НАЧАЛО Блинова М.А. 18.05.2026 Выполнение задач №000057688
		//И   ОперацияОснования = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию И Основание.Проведен Тогда 
		И   ОперацияОснования = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию И (Основание.Проведен ИЛИ Основание.ПометкаУдаления) Тогда 
		//КОНЕЦ Блинова М.А. 18.05.2026 Выполнение задач №000057688
		//надо поискать уже имеющееся
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПриходныйОрдерНаТовары.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриходныйОрдерНаТовары КАК ПриходныйОрдерНаТовары
		|ГДЕ
		|	ПриходныйОрдерНаТовары.Распоряжение = &Распоряжение";
		Запрос.УстановитьПараметр("Распоряжение", Основание);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда 
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл 
				ДокументПриходныйОрдер = Выборка.Ссылка.ПолучитьОбъект();
				//НАЧАЛО Блинова М.А. 18.05.2026 Выполнение задач №000057688
				Если Основание.ПометкаУдаления Тогда
					ДокументПриходныйОрдер.УстановитьПометкуУдаления(Основание.ПометкаУдаления);
					Возврат;
				КонецЕсли;
				//КОНЕЦ Блинова М.А. 18.05.2026 Выполнение задач №000057688
				ДокументПриходныйОрдер.Товары.Очистить(); 
			КонецЦикла;
		Иначе 
			//НАЧАЛО Блинова М.А. 18.05.2026 Выполнение задач №000057688
			Если НЕ Основание.ПометкаУдаления Тогда
			//КОНЕЦ Блинова М.А. 18.05.2026 Выполнение задач №000057688
			ДокументПриходныйОрдер = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();	
			//НАЧАЛО Блинова М.А. 18.05.2026 Выполнение задач №000057688
			Иначе
			    Возврат;
			КонецЕсли;
			//КОНЕЦ Блинова М.А. 18.05.2026 Выполнение задач №000057688
		КонецЕсли;
		
		Для Каждого СтрокаТовары Из Основание.Товары Цикл
			НоваяСтрокаТоваров = ДокументПриходныйОрдер.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, СтрокаТовары);				
		КонецЦикла;
		//НАЧАЛО Блинова М.А. 18.05.2026 Выполнение задач №000057688
		//это для случая, если пометку сняли и основание проведено
		ДокументПриходныйОрдер.ПометкаУдаления = Основание.ПометкаУдаления; 
		//КОНЕЦ Блинова М.А. 18.05.2026 Выполнение задач №000057688
		ДокументПриходныйОрдер.Распоряжение = Основание;
		ДокументПриходныйОрдер.СкладскаяОперация     = Перечисления.СкладскиеОперации.ПриемкаОтПоставщика;
		ДокументПриходныйОрдер.Склад 				 = Основание.Склад;   
		ДокументПриходныйОрдер.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию;
		ДокументПриходныйОрдер.Дата 				 = НачалоДня(Основание.Дата);
		ДокументПриходныйОрдер.Отправитель       	 = Основание.Контрагент.Партнер;
		ДокументПриходныйОрдер.Ответственный         = Основание.Автор;	
		ДокументПриходныйОрдер.Комментарий       	 = Основание.Комментарий;
		ДокументПриходныйОрдер.Статус    = Перечисления.СтатусыПриходныхОрдеров.Принят;
		Попытка
			ДокументПриходныйОрдер.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.НеОперативный);
		Исключение
			ДокументПриходныйОрдер.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;;
	КонецЕсли;	
	//КОНЕЦ Блинова М.А. 03.09.2025 Выполнение задач №000054684
КонецПроцедуры 

#КонецОбласти