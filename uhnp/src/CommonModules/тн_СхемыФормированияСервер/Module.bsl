#Область РеглЗаданиеСозданиеДокументовПоСхемам 

//Качикина 28.06.2024 Выполнение задач №000049962 
Процедура СозданиеДокументовПоСхемамФормированияДокументов() Экспорт
	
	ИмяСобытияЖР= "Создание документов по схемам формирования документов";
	НачалоФормированияДокументов = ТекущаяДатаСеанса();
	КоличествоОбработанныхДокументов = 0;   
	
	//1. Получаем список документов для обработки (по РС тн_СписокДокументовДляОбработкиПоСФД)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	тн_СписокДокументовДляОбработкиПоСхемам.ДокументИнициатор КАК ДокументИнициатор,
				   //НАЧАЛО Блинова М.А. 16.09.2025 Выполнение задач №000054680
				   |    ВЫБОР
				   |     КОГДА тн_СписокДокументовДляОбработкиПоСхемам.СхемаФормированияДокументов.ПроверкаСозданияСчетФактурыОснования
				   |      И НЕ СчетФактураВыданный.Ссылка ЕСТЬ NULL
				   |         ТОГДА ИСТИНА
				   |     КОГДА НЕ тн_СписокДокументовДляОбработкиПоСхемам.СхемаФормированияДокументов.ПроверкаСозданияСчетФактурыОснования
				   |         ТОГДА ИСТИНА
				   |     ИНАЧЕ ЛОЖЬ				   
				   |	КОНЕЦ КАК МожноОбрабатывать,  
				   //КОНЕЦ Блинова М.А. 16.09.2025 Выполнение задач №000054680
				   |	тн_СписокДокументовДляОбработкиПоСхемам.СхемаФормированияДокументов КАК СхемаФормированияДокументов 
	               |ПОМЕСТИТЬ втДокументыДляОбработки
	               |ИЗ
	               |	РегистрСведений.тн_СписокДокументовДляОбработкиПоСхемам КАК тн_СписокДокументовДляОбработкиПоСхемам  
				   //НАЧАЛО Блинова М.А. 16.09.2025 Выполнение задач №000054680
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
                   |		ПО (тн_СписокДокументовДляОбработкиПоСхемам.ДокументИнициатор = СчетФактураВыданный.ДокументОснование)
                   //КОНЕЦ Блинова М.А. 16.09.2025 Выполнение задач №000054680
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	втДокументыДляОбработки.ДокументИнициатор КАК ДокументИнициатор,
				   |	втДокументыДляОбработки.СхемаФормированияДокументов КАК СхемаФормированияДокументов,
				   //НАЧАЛО Качикина 04.10.2024 Выполнение задач №000050874
				   |	ЕСТЬNULL(тн_РезультатыАвтоматическогоФормированияДокументов.СхемаФормированияДокументов, Неопределено) КАК ИсходнаяСФД,
				   //КОНЕЦ Качикина 04.10.2024 Выполнение задач №000050874
				   |	ЕСТЬNULL(тн_РезультатыАвтоматическогоФормированияДокументов.СформированныйДокумент, Неопределено) КАК СформированныйДокумент
	               |ИЗ
	               |	втДокументыДляОбработки КАК втДокументыДляОбработки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_РезультатыАвтоматическогоФормированияДокументов КАК тн_РезультатыАвтоматическогоФормированияДокументов
				   //НАЧАЛО Блинова М.А. 16.09.2025 Выполнение задач №000054680
	               //|		ПО втДокументыДляОбработки.ДокументИнициатор = тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор";
				   |		ПО втДокументыДляОбработки.ДокументИнициатор = тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор
				   |ГДЕ
                   |	втДокументыДляОбработки.МожноОбрабатывать ";  
				   //КОНЕЦ Блинова М.А. 16.09.2025 Выполнение задач №000054680
	ВыборкаДокументовДляОбработки = Запрос.Выполнить().Выбрать();  
	
	//запись лога
	КоличествоДокументовКОбработке = ВыборкаДокументовДляОбработки.Количество();  
	стрОписание = "Начало создания документов по Схемам формирования документов. Количество документов для обработки: "+Строка(КоличествоДокументовКОбработке); 
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , ,стрОписание);
	
	Пока ВыборкаДокументовДляОбработки.Следующий() Цикл 
		
		//НАЧАЛО Качикина 04.10.2024 Выполнение задач №000050874
		//при изменении СФД помечаем созданный ранее документ на удаление
		ТекущаяСФД = ВыборкаДокументовДляОбработки.СхемаФормированияДокументов;
		СформированныйДокумент = ВыборкаДокументовДляОбработки.СформированныйДокумент; 
		
		Если ЗначениеЗаполнено(ТекущаяСФД)
			И НЕ ТекущаяСФД = ВыборкаДокументовДляОбработки.ИсходнаяСФД
			И ЗначениеЗаполнено(СформированныйДокумент) Тогда
			
			Если НЕ СформированныйДокумент.ПометкаУдаления Тогда 
				Попытка
					СформированныйДокументОбъект = СформированныйДокумент.ПолучитьОбъект(); 
					СформированныйДокументОбъект.УстановитьПометкуУдаления(Истина); 
				Исключение 
					стрОписание = "Не удалось пометить на удаление документ "+ Строка(СформированныйДокумент)
								+" (документ инициатор "+Строка(ВыборкаДокументовДляОбработки.ДокументИнициатор)
								+", схема формирования документов "+Строка(ВыборкаДокументовДляОбработки.ИсходнаяСФД)+")";
					ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , , стрОписание);
				КонецПопытки;
			КонецЕсли;
			
			СформированныйДокумент =  Неопределено; //т.е. будем создавать новый
			
		КонецЕсли;
		//КОНЕЦ Качикина 04.10.2024 Выполнение задач №000050874
		
		//СтруктураРезультат- Отказ,ДокументСсылка,СообщенияОбОшибках
		//1. Формируем документ
		СтруктураРезультат = СформироватьДокументПоСхеме(ВыборкаДокументовДляОбработки.ДокументИнициатор,
		                        //НАЧАЛО Качикина 04.10.2024 Выполнение задач №000050874
								//ВыборкаДокументовДляОбработки.СформированныйДокумент,
								//ВыборкаДокументовДляОбработки.СхемаФормированияДокументов);
								СформированныйДокумент,ТекущаяСФД);
								//КОНЕЦ Качикина 04.10.2024 Выполнение задач №000050874
								
		//2. Если обработали по схеме успешно, то удаляем запись из РС тн_СписокДокументовДляОбработкиПоСФД
		Если НЕ СтруктураРезультат.Отказ Тогда
			КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов+1;
			РегистрыСведений.тн_СписокДокументовДляОбработкиПоСхемам.ЗаписатьДокументВСписокДокументовДляОбработкиПоСхемам(ВыборкаДокументовДляОбработки.ДокументИнициатор,Новый Структура(),Истина);
			Если ЗначениеЗаполнено(СтруктураРезультат.СообщенияОбОшибках) Тогда 
				//заносим запись в ЖР, если, например, документ-основание создан, но некорректные доп. настройки
				стрОписание = "По документу "+ Строка(ВыборкаДокументовДляОбработки.ДокументИнициатор)+" зарегистрированы следующие ошибки:"+СтруктураРезультат.СообщенияОбОшибках;
				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Предупреждение, , , стрОписание);	
			КонецЕсли;
		Иначе
			стрОписание = "Не удалось обработать документ "+ Строка(ВыборкаДокументовДляОбработки.ДокументИнициатор)+":"+СтруктураРезультат.СообщенияОбОшибках;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , , стрОписание);	
		КонецЕсли;

	КонецЦикла;
	
	// запись лога	
	ВремяВыполнения = ТекущаяДатаСеанса() - НачалоФормированияДокументов;
	стрОписание = "Окончание создания документов по Схемам формирования документов. Время выполнения "+Строка(ВремяВыполнения)+" сек. 
					|Успешно обработано "+Строка(КоличествоОбработанныхДокументов)+" из "+Строка(КоличествоДокументовКОбработке)+" документов.";	
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , , стрОписание);

КонецПроцедуры

//Качикина 28.06.2024 Выполнение задач №000049962 
//ДокументИнициатор - ссылка на документ 
//СхемаФормированияДокументов - ссылка на справочник тн_СхемыФормированияДокументов  
Функция СформироватьДокументПоСхеме(ДокументИнициатор, СсылкаНаФормируемыйДокумент, СхемаФормированияДокументов)

	СтруктураРезультат	 = Новый Структура("Отказ,ДокументСсылка,СообщенияОбОшибках",Ложь,Неопределено,"");
	ПометкаУдаления		 = ДокументИнициатор.ПометкаУдаления;
	НеобходимПересчетСуммДокумента = Ложь;
	
	Если НЕ ЗначениеЗаполнено(СхемаФормированияДокументов.ВидДокумента) Тогда
		
		СтруктураРезультат.Отказ			= Истина;	
		СтруктураРезультат.ДокументСсылка	= Неопределено;
		СтруктураРезультат.СообщенияОбОшибках= СтруктураРезультат.СообщенияОбОшибках + Символы.ПС+ 
						"Не указан вид документа! Проверьте корректность заполнения схемы формирования документов """+СхемаФормированияДокументов.Наименование+"""";
		
		Возврат СтруктураРезультат;  
		
	КонецЕсли;

	//1. Проверяем, есть ли уже ранее созданные документы: если есть-меняем существующие, нет - создаем новый (по РС тн_РезультатыАвтоматическогоФормированияДокументов)
	Если ЗначениеЗаполнено(СсылкаНаФормируемыйДокумент) Тогда 
		МетаданныеДокумента = СсылкаНаФормируемыйДокумент.Метаданные();
		ФормируемыйДокумент = СсылкаНаФормируемыйДокумент.ПолучитьОбъект();   
		//очистим все реквизиты документа:
		Если НЕ ПометкаУдаления Тогда
			Для Каждого РеквизитДокумента Из МетаданныеДокумента.Реквизиты Цикл
				ФормируемыйДокумент[РеквизитДокумента.Имя]	= Неопределено;
			КонецЦикла;	
			Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
				ФормируемыйДокумент[ТабличнаяЧасть.Имя].Очистить();
			КонецЦикла; 
		КонецЕсли;
	Иначе
		ФормируемыйДокумент = Документы[СхемаФормированияДокументов.ВидДокумента].СоздатьДокумент();	
	КонецЕсли;
	
	//2. Заполняем документ по схеме  
	Попытка  
				
		//Перезаполнять по схеме будем только для непомеченных на удаление
		Если НЕ ПометкаУдаления Тогда 
			
			//1)сначала по реквизитам которые следует взять из документа-инициатора:
			Для Каждого СтрокаТЧ Из СхемаФормированияДокументов.ПереченьРеквизитовКопирование Цикл
				
				//тут будем обрабатывать только реквизиты шапки документа: 
				
				// Бывают случаи, когда ТЧ Источника заполнена, а ТЧ приемника нет. 
				//(т.е. заполняем реквизиты шапки документа приемника из ТЧ источника)
				ПолучатьРеквизитИзТЧИсточника = Ложь;	
				Если ЗначениеЗаполнено(СтрокаТЧ.ИмяТабличнойЧастиИсточник) И НЕ ЗначениеЗаполнено(СтрокаТЧ.ИмяТабличнойЧастиПриемник) тогда
					ПолучатьРеквизитИзТЧИсточника = Истина;	
				КонецЕсли;
				// Если заполнено две ТЧ, тогда ничего не делаем. Это уже будет обработка табличных частей.
				Если ЗначениеЗаполнено(СтрокаТЧ.ИмяТабличнойЧастиИсточник) И ЗначениеЗаполнено(СтрокаТЧ.ИмяТабличнойЧастиПриемник) Тогда
					Продолжить
				КонецЕсли;
				
				РеквизитИсточник	= СокрЛП(СтрокаТЧ.ИмяРеквизитаИсточник);	
				РеквизитПриемник	= СокрЛП(СтрокаТЧ.ИмяРеквизитаПриемник);	
				
				ОписаниеРеквизита	= "/копирование/ " + РеквизитИсточник + " -> " + РеквизитПриемник;
				
				Если НЕ ЗначениеЗаполнено(РеквизитПриемник) тогда
					//будем пробовать писать в реквизит с тем же именем что и в документе источнике:
					РеквизитПриемник	= РеквизитИсточник;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(РеквизитПриемник) тогда
					Продолжить;
				КонецЕсли;
				
				ПолучитьРеквизитИзПредопределенногоЗначения = ЗначениеЗаполнено(СтрокаТЧ.ПредопределенноеЗначение);
				ПредопределенноеЗначение = ?(ПолучитьРеквизитИзПредопределенногоЗначения, СтрокаТЧ.ПредопределенноеЗначение, Неопределено);
				
				Если НЕ ПолучатьРеквизитИзТЧИсточника Тогда 
					Если ПолучитьРеквизитИзПредопределенногоЗначения Тогда
						ФормируемыйДокумент[РеквизитПриемник] = ПредопределенноеЗначение; 
					Иначе
						ФормируемыйДокумент[РеквизитПриемник] = ДокументИнициатор[РеквизитИсточник];
					КонецЕсли;
				Иначе
					Если ДокументИнициатор[СтрокаТЧ.ИмяТабличнойЧастиИсточник].Количество()>0 Тогда 				
						// Получим значение реквизита для приемника из первой строки ТЧ документа источника. 
						СтрокаТЧ = ДокументИнициатор[СтрокаТЧ.ИмяТабличнойЧастиИсточник][0]; 
						ФормируемыйДокумент[РеквизитПриемник]=СтрокаТЧ[РеквизитИсточник];
					КонецЕсли;	
				КонецЕсли;
				
			КонецЦикла;
			
			//Дата Документа
			Если Не ЗначениеЗаполнено(ФормируемыйДокумент.Дата) Тогда 
				//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
				//ФормируемыйДокумент.Дата		= тн_Интеграция_УПП.ТекущаяДатаСервера();
				ФормируемыйДокумент.Дата		= ТекущаяДатаСервера();
				//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
			КонецЕсли;
			ФормируемыйДокумент.Дата		= ФормируемыйДокумент.Дата + 1;
		
			ОписаниеРеквизита		= "";
			
			//2) Теперь будем обрабатывать табличные части:	
			//для каждой ТЧ источника ищем записи в СхемаФормированияДокументов
			//если нашли, то заходим в цикл по строкам текущей ТЧ в Источнике
			//далее проходимся по всем реквизитам и заполняем их в строке ТЧ Приемника
			
			//Цикл по всем табличным частям источника 
			МетаданныеДокумента = ДокументИнициатор.Метаданные();
			Для каждого ИмяТабличнойЧастиИсточник Из МетаданныеДокумента["ТабличныеЧасти"] Цикл
				
				ИмяТабличнойЧастиИсточникСтрокой = Строка(ИмяТабличнойЧастиИсточник);  
				
				СтруктураПоиска	= Новый Структура("ИмяТабличнойЧастиИсточник",	ИмяТабличнойЧастиИсточникСтрокой);
				НайденныеСтроки	= СхемаФормированияДокументов.ПереченьРеквизитовКопирование.НайтиСтроки(СтруктураПоиска);
				
				Если НайденныеСтроки.Количество()>0 Тогда
					
					//Цикл по всем СТРОКАМ текущей ТЧ, указанной в СФД
					Для Каждого СтрокаТЗ Из ДокументИнициатор[ИмяТабличнойЧастиИсточникСтрокой] Цикл
						
						ПервыйРаз		= Истина;
											
						//Цикл по РЕКВИЗИТАМ текущей ТЧ, указанной в СФД
						Для Каждого  СтрокаНС Из НайденныеСтроки Цикл  
							
							ИмяТабличнойЧастиПриемник	= СокрЛП(СтрокаНС.ИмяТабличнойЧастиПриемник);
							
							Если НЕ ЗначениеЗаполнено(ИмяТабличнойЧастиПриемник) Тогда
								Продолжить;
							КонецЕсли;
							
							Если ПервыйРаз Тогда
								НоваяСтрокаТабличнойЧасти	= ФормируемыйДокумент[ИмяТабличнойЧастиПриемник].Добавить();
								ПервыйРаз					= Ложь;
							КонецЕсли;	
							
							РеквизитИсточник	= СокрЛП(СтрокаНС.ИмяРеквизитаИсточник);	
							РеквизитПриемник	= СокрЛП(СтрокаНС.ИмяРеквизитаПриемник);	
							
							ОписаниеРеквизита	= "/копирование/ " + "из табл. части " + ИмяТабличнойЧастиИсточникСтрокой + " в табл. часть " + ИмяТабличнойЧастиПриемник + ": " + РеквизитИсточник + " -> " + РеквизитПриемник;
							
							Если НЕ ЗначениеЗаполнено(РеквизитПриемник) Тогда
								//будем пробовать писать в реквизит с тем же именем что и в документе источнике:
								РеквизитПриемник	= РеквизитИсточник;
							КонецЕсли;
							
							Если НЕ ЗначениеЗаполнено(РеквизитПриемник) Тогда
								Продолжить;
							КонецЕсли;
							
							ПолучитьРеквизитИзПредопределенногоЗначения = ЗначениеЗаполнено(СтрокаНС.ПредопределенноеЗначение);
							ПредопределенноеЗначение = ?(ПолучитьРеквизитИзПредопределенногоЗначения, СтрокаНС.ПредопределенноеЗначение, Неопределено);
							
							Если ЗначениеЗаполнено(СтрокаНС.ПредопределенноеЗначение) Тогда
								НоваяСтрокаТабличнойЧасти[РеквизитПриемник]	= СтрокаНС.ПредопределенноеЗначение; 	
							Иначе 
								НоваяСтрокаТабличнойЧасти[РеквизитПриемник]=СтрокаТЗ[РеквизитИсточник];
							КонецЕсли;
							
						КонецЦикла;
					КонецЦикла 
				КонецЕсли;
			КонецЦикла;	 
			
			ОписаниеРеквизита		= "";
			
			//3)теперь реквизиты которые необходимо просто подставить из схемы из ТЧ ПереченьРеквизитовПодстановка 
			Для Каждого СтрокаТЧ Из СхемаФормированияДокументов.ПереченьРеквизитовПодстановка Цикл
				
				РеквизитПриемник	= СокрЛП(СтрокаТЧ.ИмяРеквизита);			
				ОписаниеРеквизита	= "/подстановка/ " + РеквизитПриемник;	
				Если НЕ ЗначениеЗаполнено(РеквизитПриемник) Тогда
					Продолжить;
				КонецЕсли;	
				ФормируемыйДокумент[РеквизитПриемник]	= СтрокаТЧ.ЗначениеРеквизита;
				
			КонецЦикла;
			
		КонецЕсли;	 
		
		//4.1) настройки с вкладки Дополнительно (например, пересчет сумм документа в валюту)
		ОбработкаДополнительныхНастроекСхемы_ДоЗаписиДокумента(ФормируемыйДокумент, ДокументИнициатор, СхемаФормированияДокументов, ОписаниеРеквизита, СтруктураРезультат.СообщенияОбОшибках);			
		ОписаниеРеквизита		= "";
				
		//НАЧАЛО Качикина 30.09.2024 Выполнение задач №000050874
		Если ДокументИнициатор.Проведен Тогда 
			РежимЗаписиФормируемогоДокумента = РежимЗаписиДокумента.Проведение;
		ИначеЕсли ФормируемыйДокумент.Проведен И НЕ ДокументИнициатор.Проведен Тогда 
			РежимЗаписиФормируемогоДокумента = РежимЗаписиДокумента.ОтменаПроведения;
		Иначе
			РежимЗаписиФормируемогоДокумента = РежимЗаписиДокумента;
		КонецЕсли;
		//КОНЕЦ Качикина 30.09.2024 Выполнение задач №000050874
		ФормируемыйДокумент.Проведен =  ДокументИнициатор.Проведен; 
		ФормируемыйДокумент.ПометкаУдаления = ПометкаУдаления; 
		//НАЧАЛО Качикина 30.09.2024 Выполнение задач №000050874
		//Если ДокументИнициатор.Проведен Тогда 
		//	ФормируемыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		//ИначеЕсли ФормируемыйДокумент.Проведен И НЕ ДокументИнициатор.Проведен Тогда 
		//	ФормируемыйДокумент.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		//Иначе
		//	ФормируемыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		//КонецЕсли; 
		//НАЧАЛО Сафиуллина З.Р. 28.10.2024 Выполнение задач №000051302
		ТекстОшибокПроверкиЗаполнения = "";
		Если НЕ ФормируемыйДокумент.ПроверитьЗаполнение() Тогда 
			
			СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
			
			Для Каждого Сообщение Из СообщенияПользователю Цикл
				
				Если СтрНайти(Сообщение.Текст, "СтандартныеПодсистемы.ДлительныеОперации") > 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстОшибокПроверкиЗаполнения = ТекстОшибокПроверкиЗаполнения + ?(ПустаяСтрока(ТекстОшибокПроверкиЗаполнения), "", Символы.ПС) + Сообщение.Текст;
				
			КонецЦикла;
			
			ТекстОшибокПроверкиЗаполнения = "По причине: Ошибка проверки заполнения реквизитов " + Символы.ПС + ТекстОшибокПроверкиЗаполнения; 
			
		КонецЕсли;
		//КОНЕЦ Сафиуллина З.Р. 28.10.2024 Выполнение задач №000051302    
		
		// НАЧАЛО Юдина Екатерина 23.12.2025 Выполнение задач №000056227
		// Документ с пустым договором клиента не проведется, поэтому договорились его записывать
		// чтобы документ создался и его в дальнейшем могли отредактировать вручную
		Если ФормируемыйДокумент.Проведен 
			И ТипЗнч(ФормируемыйДокумент) = Тип("ДокументОбъект.РеализацияТоваровУслуг")
		    И ФормируемыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера
			И Не ЗначениеЗаполнено(ФормируемыйДокумент.КлиентДоговор) Тогда  
			 ФормируемыйДокумент.Проведен = Ложь;
			РежимЗаписиФормируемогоДокумента = РежимЗаписиДокумента.Запись;
		КонецЕсли;
		// КОНЕЦ Юдина Екатерина 23.12.2025 Выполнение задач №000056227		
		
		ФормируемыйДокумент.Записать(РежимЗаписиФормируемогоДокумента);
		//КОНЕЦ Качикина 30.09.2024 Выполнение задач №000050874
		
		//4.2) настройки с вкладки Дополнительно (например, регистрация счета-фактуры)
		//НАЧАЛО Блинова М.А. 09.09.2025 Выполнение задач №000054680
		//ОбработкаДополнительныхНастроекСхемы_ПослеЗаписиДокумента(ФормируемыйДокумент.Ссылка, СхемаФормированияДокументов, ОписаниеРеквизита, СтруктураРезультат.СообщенияОбОшибках);
		ОбработкаДополнительныхНастроекСхемы_ПослеЗаписиДокумента(ФормируемыйДокумент.Ссылка, СхемаФормированияДокументов, ОписаниеРеквизита, СтруктураРезультат.СообщенияОбОшибках, ДокументИнициатор);
		//КОНЕЦ Блинова М.А. 09.09.2025 Выполнение задач №000054680
	    ОписаниеРеквизита		= "";

	Исключение
		
		Если ОписаниеРеквизита <> "" тогда
			СтруктураРезультат.СообщенияОбОшибках	= СтруктураРезультат.СообщенияОбОшибках + Символы.ПС + "Неудачная попытка заполнить реквизиты документа по схеме ('"+ОписаниеРеквизита+"').";
		Иначе
			//НАЧАЛО Сафиуллина З.Р. 24.10.2024 Выполнение задач №000051302
			//СтруктураРезультат.СообщенияОбОшибках	= СтруктураРезультат.СообщенияОбОшибках + Символы.ПС + "Ошибка при попытке сохранить изменения в документе."+Символы.ПС+ОписаниеОшибки();
			СтруктураРезультат.СообщенияОбОшибках	= СтруктураРезультат.СообщенияОбОшибках + Символы.ПС + "Ошибка при попытке сохранить изменения в документе." 
				+ Символы.ПС + ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке()) + Символы.ПС + ТекстОшибокПроверкиЗаполнения;
			//КОНЕЦ Сафиуллина З.Р. 24.10.2024 Выполнение задач №000051302
		КонецЕсли;	   
		СтруктураРезультат.Отказ	= Истина;
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ФормируемыйДокумент.Ссылка) Тогда		
		СтруктураРезультат.ДокументСсылка	= ФормируемыйДокумент.Ссылка;	
	КонецЕсли;
	
	//3. добавляем запись о результатах в РС тн_РезультатыАвтоматическогоФормированияДокументов	
	ДанныеДляРС = Новый Структура("СформированныйДокумент,СхемаФормированияДокументов,ОбработаноУспешно,ДополнительныеСведения",
							СтруктураРезультат.ДокументСсылка,СхемаФормированияДокументов,НЕ СтруктураРезультат.Отказ,СтруктураРезультат.СообщенияОбОшибках);
	РегистрыСведений.тн_РезультатыАвтоматическогоФормированияДокументов.ЗаписатьДокументВРезультатыАвтоматическогоФормированияДокументов(ДокументИнициатор,ДанныеДляРС); 
		
	Возврат СтруктураРезультат;
                                                                                            
КонецФункции

//Качикина 28.07.2024 Выполнение задач №000049962 
//настройки с вкладки Дополнительно, действующие до записи документа
//ФормируемыйДокумент - ДокументОбъект
Процедура ОбработкаДополнительныхНастроекСхемы_ДоЗаписиДокумента(ФормируемыйДокумент, ДокументИнициатор, СхемаФормированияДокументов, ОписаниеРеквизита, СообщенияОбОшибках)
	
	ТипФормируемогоДокумента = ТипЗнч(ФормируемыйДокумент);                                              
	
	Если СхемаФормированияДокументов.ПересчетСуммДокументаВВалюту
			И ЗначениеЗаполнено(СхемаФормированияДокументов.ВалютаФормируемогоДокумента)
			И НЕ ДокументИнициатор["Валюта"] = СхемаФормированияДокументов.ВалютаФормируемогоДокумента Тогда  
			
			//НАЧАЛО Качикина 27.09.2024 Выполнение задач №000050874
			//Если ТипФормируемогоДокумента = Тип("ДокументОбъект.ПередачаТоваровМеждуОрганизациями") Тогда
			Если ТипФормируемогоДокумента = Тип("ДокументОбъект.ПередачаТоваровМеждуОрганизациями")
				Или ТипФормируемогоДокумента = Тип("ДокументОбъект.РеализацияТоваровУслуг")
				Или ТипФормируемогоДокумента = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
			//КОНЕЦ Качикина 27.09.2024 Выполнение задач №000050874
			
				ОписаниеРеквизита	= "/пересчет сумм документа в валюту/ Валюта ";
					
				БазоваяВалюта = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ФормируемыйДокумент.Организация);
				СтараяВалюта                = ДокументИнициатор["Валюта"];
				НоваяВалюта					= СхемаФормированияДокументов.ВалютаФормируемогоДокумента;
				ДатаДокумента               = ?(ЗначениеЗаполнено(ФормируемыйДокумент.Дата), ФормируемыйДокумент.Дата, ТекущаяДатаСеанса());
				СтруктураКурсовСтаройВалюты = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(СтараяВалюта, ДатаДокумента, БазоваяВалюта);
				СтруктураКурсовНовойВалюты  = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(НоваяВалюта, ДатаДокумента, БазоваяВалюта);			
				ФормируемыйДокумент.Валюта	= НоваяВалюта; 
				ФормируемыйДокумент.ВалютаВзаиморасчетов = НоваяВалюта;
				
				Ценообразование.ПересчитатьСуммыТабличнойЧастиВВалюту(ФормируемыйДокумент.Товары,
																		ФормируемыйДокумент.ЦенаВключаетНДС,
																		СтараяВалюта,
																		НоваяВалюта,
																		СтруктураКурсовСтаройВалюты,
																		СтруктураКурсовНовойВалюты);  
				//предполагаем, что Валюта=ВалютаВзаиморасчетов 
				//НАЧАЛО Качикина 27.09.2024 Выполнение задач №000050874 
				Если ТипФормируемогоДокумента = Тип("ДокументОбъект.ПередачаТоваровМеждуОрганизациями") Тогда 
				//КОНЕЦ Качикина 27.09.2024 Выполнение задач №000050874
				Для каждого СтрокаТЧ из ФормируемыйДокумент.Товары Цикл
					СтрокаТЧ.СуммаВзаиморасчетов	= СтрокаТЧ.СуммаСНДС;
					СтрокаТЧ.СуммаНДСВзаиморасчетов = СтрокаТЧ.СуммаНДС;
				КонецЦикла; 
				//НАЧАЛО Качикина 27.09.2024 Выполнение задач №000050874
				Иначе
					Для каждого СтрокаТЧ из ФормируемыйДокумент.Товары Цикл
						СтрокаТЧ.СуммаВзаиморасчетов = СтрокаТЧ.СуммаСНДС;
					КонецЦикла;
				КонецЕсли; 
				//КОНЕЦ Качикина 27.09.2024 Выполнение задач №000050874
				
			Иначе
		
				//отказ регистрировать не будем, но сообщение в ЖР занесем
				СообщенияОбОшибках = СообщенияОбОшибках + Символы.ПС + "Не предусмотрен пересчет сумм в валюту для документа типа " + Строка(ТипФормируемогоДокумента);
		
			КонецЕсли;
			
	КонецЕсли;
	
	//НАЧАЛО Блинова М.А. 13.01.2025 Выполнение задач №000052052  
	Если ТипФормируемогоДокумента = Тип("ДокументОбъект.РеализацияТоваровУслуг")
		И ФормируемыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера Тогда     
		//если схема агентская надо для реализации от продавца комитенту найти клиента
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ  
		// НАЧАЛО Юдина Екатерина 23.12.2025 Выполнение задач №000056227
		|	тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор.Партнер КАК Партнер,
		|	тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.Ссылка, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
		// КОНЕЦ Юдина Екатерина 23.12.2025 Выполнение задач №000056227
		|	тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор КАК ДокументИнициатор
		|ИЗ
		|	РегистрСведений.тн_РезультатыАвтоматическогоФормированияДокументов КАК тн_РезультатыАвтоматическогоФормированияДокументов
		// НАЧАЛО Юдина Екатерина 23.12.2025 Выполнение задач №000056227 
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО тн_РезультатыАвтоматическогоФормированияДокументов.ДокументИнициатор.Договор.Номер = ДоговорыКонтрагентов.Номер 
		|       И ДоговорыКонтрагентов.Организация = &Организация    
		|       И ДоговорыКонтрагентов.ВидДоговораУХ = &ВидДоговораУХ    
		// КОНЕЦ Юдина Екатерина 23.12.2025 Выполнение задач №000056227
		|ГДЕ
		|	тн_РезультатыАвтоматическогоФормированияДокументов.СформированныйДокумент = &СформированныйДокумент";   
			
		Запрос.УстановитьПараметр("СформированныйДокумент", ДокументИнициатор); 
		// НАЧАЛО Юдина Екатерина 23.12.2025 Выполнение задач №000056227 
		Запрос.УстановитьПараметр("Организация", ФормируемыйДокумент.Организация);
		Запрос.УстановитьПараметр("ВидДоговораУХ", Справочники.ВидыДоговоровКонтрагентовУХ.РеализацияЧерезКомиссионера);
		// КОНЕЦ Юдина Екатерина 23.12.2025 Выполнение задач №000056227   
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
		    // НАЧАЛО Юдина Екатерина 23.12.2025 Выполнение задач №000056227
			//ИзначальнаяРеализацияКлиенту = ВыборкаДетальныеЗаписи.ДокументИнициатор;
			//ФормируемыйДокумент.КлиентПартнер = ИзначальнаяРеализацияКлиенту.Партнер;
			//ФормируемыйДокумент.КлиентДоговор = ИзначальнаяРеализацияКлиенту.Договор;
			//ФормируемыйДокумент.КлиентКонтрагент = ИзначальнаяРеализацияКлиенту.Контрагент;  
			ФормируемыйДокумент.КлиентПартнер    = ВыборкаДетальныеЗаписи.Партнер;
			ФормируемыйДокумент.КлиентДоговор    = ВыборкаДетальныеЗаписи.Договор;
			ФормируемыйДокумент.КлиентКонтрагент = ВыборкаДетальныеЗаписи.Контрагент;
			// КОНЕЦ Юдина Екатерина 23.12.2025 Выполнение задач №000056227
		КонецЦикла;		
	КонецЕсли;     
	Если  ТипФормируемогоДокумента = Тип("ДокументОбъект.ПередачаТоваровХранителю")
