// Борисенко И.Н. 05.11.2020 Выполнение задачи №000035594
Функция СформироватьТаблицуОбъектов(НаправлениеВыгрузки = "Каркас") Экспорт
	
	АдресВременногоХранилища = тн_Интеграция_УПП.СформироватьТаблицуОбъектов(НаправлениеВыгрузки);
	Возврат АдресВременногоХранилища;
	
КонецФункции

// Борисенко И.Н. 03.12.2021 Выполнение задач №000039277
Функция СформироватьОписаниеJSON(ИмяОбъектаМетаданных, СтрокаУИД = "", НаправлениеВыгрузки = "") Экспорт
	
	СтруктураОписаниеJSON = тн_Интеграция_УПП.СформироватьОписаниеJSON(ИмяОбъектаМетаданных, СтрокаУИД, НаправлениеВыгрузки);
	Возврат СтруктураОписаниеJSON;
	
КонецФункции

// Борисенко Игорь 13.01.2023 Выполнение задач №000043965
Процедура тн_ПровестиСвязанныеСчФПолученныеОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ГУИД = Источник.Ссылка.УникальныйИдентификатор();
	сГУИД = Строка(ГУИД);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("тн_ГуидДокументаОснования", сГУИД);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураПолученныйДокументыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученныйДокументыОснования
	|ГДЕ
	|	СчетФактураПолученныйДокументыОснования.тн_ГуидДокументаОснования = &тн_ГуидДокументаОснования
	// НАЧАЛО Борисенко Игорь 19.06.2023 Выполнение задач №000045867
	|	И Не СчетФактураПолученныйДокументыОснования.Ссылка.ПометкаУдаления
	// КОНЕЦ Борисенко Игорь 19.06.2023 Выполнение задач №000045867
	|	И Не СчетФактураПолученныйДокументыОснования.Ссылка.Проведен"; 
	
	// НАЧАЛО Белоконенко Денис 20.04.2023 Выполнение задач №000045246 
	ЭтоЗагрузкаСЗавода = Ложь;
	Если Источник.ДополнительныеСвойства.Свойство("ЭтоЗагрузкаСЗавода") И
		Источник.ДополнительныеСвойства.ЭтоЗагрузкаСЗавода Или
		Источник.ДополнительныеСвойства.Свойство("operationType") И 
		Источник.ДополнительныеСвойства.operationType = "КаркасПродажаГП" Тогда			
		ЭтоЗагрузкаСЗавода = Истина;
	КонецЕсли;
	
	Если ЭтоЗагрузкаСЗавода Тогда // Обновляем всегда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Не СчетФактураПолученныйДокументыОснования.Ссылка.Проведен", "");
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 20.04.2023 Выполнение задач №000045246	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		обСчФ = Выборка.Ссылка.ПолучитьОбъект();
		Для каждого СтрокаОснования Из обСчФ.ДокументыОснования Цикл
			
			Если СтрокаОснования.тн_ГуидДокументаОснования = сГУИД Тогда
				
				СтрокаОснования.ДокументОснование = Источник.Ссылка;
				
			КонецЕсли;
			
		КонецЦикла; //по СтрокаОснования
		
		Попытка
			// НАЧАЛО Белоконенко Денис 19.01.2023 Выполнение задач №000044034
			// НАЧАЛО Белоконенко Денис 31.03.2023 Выполнение задач №000045021
			//Если Источник.ДополнительныеСвойства.Свойство("operationType") И
			Если Источник.ДополнительныеСвойства.Свойство("ЭтоЗагрузкаСЗавода") И
				Источник.ДополнительныеСвойства.ЭтоЗагрузкаСЗавода Или
				Источник.ДополнительныеСвойства.Свойство("operationType") И
			// КОНЕЦ Белоконенко Денис 31.03.2023 Выполнение задач №000045021 
				Источник.ДополнительныеСвойства.operationType = "КаркасПродажаГП" Тогда			
				тн_Интеграция_ERP_УХ.ЗаполнитьСФПоОснованию(обСчФ, Источник.Ссылка);
			КонецЕсли;
			// КОНЕЦ  Белоконенко Денис 19.01.2023 Выполнение задач №000044034
			
			обСчФ.ОбменДанными.Загрузка = Истина;
			обСчФ.Записать();

			обСчФ.ОбменДанными.Загрузка = Ложь;
			обСчФ.Записать(РежимЗаписиДокумента.Проведение);
		
		Исключение
			
			ТекстСообщения = СтрШаблон("Не удалось провести связанный: %1", СокрЛП(обСчФ));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			
		КонецПопытки;
		
	КонецЦикла; //по СчФ
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Борисенко Игорь 19.07.2023 Выполнение задач №000046267
Процедура тн_ПровестиСвязанныеСчФВыданныеОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	//НАЧАЛО Качикина 13.11.2025 Выполнение задач №000055808
	//при загрузке РОТ к РТУ в закрытом периоде не надо ничего перепроводить!
	Если Источник.ДополнительныеСвойства.Свойство("тн_ПринудительноеПроведениеВЗакрытомПериоде")
		И Источник.ДополнительныеСвойства.тн_ПринудительноеПроведениеВЗакрытомПериоде Тогда
		Возврат;	
	КонецЕсли;
	//КОНЕЦ Качикина 13.11.2025 Выполнение задач №000055808
	
	УстановитьПривилегированныйРежим(Истина);
	
	ГУИД = Источник.Ссылка.УникальныйИдентификатор();
	сГУИД = Строка(ГУИД);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("тн_ГуидДокументаОснования", сГУИД);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.тн_ГуидДокументаОснования = &тн_ГуидДокументаОснования
	|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления"; 
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		обСчФ = Выборка.Ссылка.ПолучитьОбъект();
		Для каждого СтрокаОснования Из обСчФ.ДокументыОснования Цикл
			
			Если СтрокаОснования.тн_ГуидДокументаОснования = сГУИД Тогда
				
				СтрокаОснования.ДокументОснование = Источник.Ссылка;
				
			КонецЕсли;
			
		КонецЦикла; //по СтрокаОснования
		
		Попытка
			
			обСчФ.ОбменДанными.Загрузка = Истина;
			обСчФ.Записать();

			обСчФ.ОбменДанными.Загрузка = Ложь;
			обСчФ.Записать(РежимЗаписиДокумента.Проведение);
		
		Исключение
			
			ТекстСообщения = СтрШаблон("Не удалось провести связанный: %1", СокрЛП(обСчФ));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			
		КонецПопытки;
		
	КонецЦикла; //по СчФ
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Борисенко Игорь 12.01.2024 Выполнение задач №000048096
Процедура тн_Номенклатура_ПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ЭтоГруппа Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запрос.УстановитьПараметр("Наименование", Источник.Наименование);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа
		|	И Номенклатура.Ссылка <> &Ссылка
		|	И Номенклатура.Наименование = &Наименование";
		
		УстановитьПривилегированныйРежим(Истина);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			//НАЧАЛО Сафиуллина З.Р. 30.10.2025 Выполнение задач №000055674
			//КраткийТекстСообщения = СтрШаблон("ДУБЛЬ группы номенклатуры: %1", Выборка.Наименование);
			//КОНЕЦ Сафиуллина З.Р. 30.10.2025 Выполнение задач №000055674
			ПолныйТекстСообщения = СтрШаблон("ДУБЛЬ группы номенклатуры. Код: %1; Наименование: %2; Родитель: %3", Выборка.Код, Выборка.Наименование, Источник.Родитель);
			
			//НАЧАЛО Сафиуллина З.Р. 30.10.2025 Выполнение задач №000055674
			//ЗаписьЖурналаРегистрации(КраткийТекстСообщения, УровеньЖурналаРегистрации.Ошибка,,, ПолныйТекстСообщения); 
			ЗаписьЖурналаРегистрации("Запись группы номенклатуры", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Номенклатура,
				Источник.Ссылка, ПолныйТекстСообщения);
	        //КОНЕЦ Сафиуллина З.Р. 30.10.2025 Выполнение задач №000055674
			
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

