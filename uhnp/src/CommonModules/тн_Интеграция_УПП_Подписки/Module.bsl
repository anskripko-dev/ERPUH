// Гутарова Екатерина 10.10.2023 Выполнение задач №000047113
//
Процедура тн_РегистрацияДляВыгрузки_ЗаписьРегистрыПриЗаписи(Источник, Отказ, НаправлениеВыгрузки) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат; //чтобы не было зацикливаний выгрузок
	КонецЕсли;
		
	ТочкаОбменаRabbitMQ = Справочники.ТочкиОбменаRMQ.ТекущаяБаза;
	Если ЗначениеЗаполнено(ТочкаОбменаRabbitMQ) Тогда
		Если Не тн_Интеграция_УПП.НужноВыгружать(ТочкаОбменаRabbitMQ.Наименование, Источник, НаправлениеВыгрузки) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	тн_Интеграция_УПП.ЗарегистрироватьСвязанныеОбъектыДляВыгрузки_ERP_УХ(Источник, НаправлениеВыгрузки);
	
КонецПроцедуры 

