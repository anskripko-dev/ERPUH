// Юдина (Гутарова) Екатерина 04.04.2024 Выполнение задач №000049104
//
Процедура тн_ПроверкаЗагрузкиЗависимыхОбъектов_ПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;   
	
	ГУИД = Строка(Источник.Ссылка.УникальныйИдентификатор());
	//НАЧАЛО Блинова М.А. 01.07.2024 Выполнение задач №000050060
	//нужно еще справочник проверить
	Если Источник.Метаданные().Имя = "ДоговорыКонтрагентов" Тогда 
		ВидДокумента = "Справочник.ДоговорыКонтрагентов"    
	// НАЧАЛО Юдина Екатерина 31.01.2025 Выполнение задач №000052460  
	ИначеЕсли Источник.Метаданные().Имя = "СпособыОтраженияРасходов" Тогда
		ВидДокумента = "Справочник.СпособыОтраженияРасходов"
	// КОНЕЦ Юдина Екатерина 31.01.2025 Выполнение задач №000052460
	Иначе
	//КОНЕЦ Блинова М.А. 01.07.2024 Выполнение задач №000050060
	ВидДокумента = "Документ." + Источник.Метаданные().Имя; 
	//НАЧАЛО Блинова М.А. 01.07.2024 Выполнение задач №000050060
	КонецЕсли;
	//КОНЕЦ Блинова М.А. 01.07.2024 Выполнение задач №000050060
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.ИДСообщения КАК ИДСообщения,
	               |	тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.ВидДокумента КАК ВидДокумента
	               |ИЗ
	               |	РегистрСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов КАК тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов
	               |ГДЕ   
				   |	тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.ГУИД = &ГУИД";	
	
	Запрос.УстановитьПараметр("ГУИД", ГУИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.СоздатьМенеджерЗаписи();
		Запись.ИДСообщения = Выборка.ИДСообщения;
		Запись.ГУИД = ГУИД;
		Запись.ВидДокумента = Выборка.ВидДокумента;
		Запись.Прочитать();
		Запись.Удалить();	
        // НАЧАЛО Юдина Екатерина 17.12.2025 Выполнение задач №000056166   
		Если ОбщегоНазначенияПовтИспУХ.ПолучитьЗначениеКонстанты("тн_ВключитьДополнительноеЛогированиеВЖурналРегистрации") Тогда
			
			ЗаписьЖурналаРегистрации("Удаление РС_ОчередьОжиданияЗагрузкиЗависимыхОбъектов по", УровеньЖурналаРегистрации.Информация, 
			    Метаданные.РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов, Источник.Ссылка, Строка(ГУИД) + " " + Строка(Источник.Ссылка) + " / " + Строка(Выборка.ИДСообщения));
			
		КонецЕсли;	
		// КОНЕЦ Юдина Екатерина 17.12.2025 Выполнение задач №000056166
		
	КонецЦикла;   
		
КонецПроцедуры 

