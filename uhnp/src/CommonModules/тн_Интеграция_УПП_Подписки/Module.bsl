// Борисенко Игорь 21.10.2022 Выполнение задач №000043052
Процедура тн_РегистрацияДляВыгрузки_ЗаписьПриЗаписи(Источник, Отказ, НаправлениеВыгрузки) Экспорт
	
	//НАЧАЛО Качикина 16.10.2024 Выполнение задач №000051011
	//Если Источник.ОбменДанными.Загрузка = Истина Тогда
	Если Источник.ОбменДанными.Загрузка = Истина
		И НЕ (Источник.ДополнительныеСвойства.Свойство("ПринудительноЗарегистрировать") И Источник.ДополнительныеСвойства.ПринудительноЗарегистрировать = Истина) Тогда
	//КОНЕЦ Качикина 16.10.2024 Выполнение задач №000051011	
		Возврат; //чтобы не было заикливаний выгрузок
	КонецЕсли; 
		
	ТочкаОбменаRabbitMQ = Справочники.ТочкиОбменаRMQ.ТекущаяБаза;
	Если ЗначениеЗаполнено(ТочкаОбменаRabbitMQ) Тогда
		Если Не тн_Интеграция_УПП.НужноВыгружать(ТочкаОбменаRabbitMQ.Наименование, Источник.Ссылка, НаправлениеВыгрузки) Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(Источник.Ссылка);
	тн_Интеграция_УПП.ЗарегистрироватьСвязанныеОбъектыДляВыгрузки_ERP_УХ(АдресВременногоХранилища, НаправлениеВыгрузки);
	//НАЧАЛО Блинова М.А. 20.02.2025 Выполнение задач №000052717 
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
		НаборЗаписейРегистра = РегистрыСведений.тн_ЗарегистрированныеДокументыКОбмену.СоздатьНаборЗаписей();
		НаборЗаписейРегистра.Отбор.ЗарегистрированныйДокумент.Установить(Источник.Ссылка);
		НаборЗаписейРегистра.Записать();
	КонецЕсли;
	//КОНЕЦ Блинова М.А. 20.02.2025 Выполнение задач №000052717 
	
КонецПроцедуры

