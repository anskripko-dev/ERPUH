#Область СлужебныеПроцедурыИФункции

// Добавляет зависимое поле на форму.
//
// Параметры:
//  Форма			- ФормаКлиентскогоПриложения - форма
//  ИмяРеквизита	- Строка - Имя переключателя использования единого реквизита.
//  ЗависимыеПоля	- Строка - Список зависимых реквизитов, указанных через запятую.
//
Процедура ДобавитьЗависимостьПолей(Форма, ИмяРеквизита, ЗависимыеПоля) Экспорт
	
	Зависимые = СтрРазделить(ЗависимыеПоля,",",Ложь);
	
	Строка = Форма.ЗависимостиПолей.Добавить();
	Строка.ИмяРеквизита = ИмяРеквизита;
	Строка.ЗависимыеПоля = Новый ФиксированныйМассив(Зависимые);
	
КонецПроцедуры

#Область КорректировкаЛимитов

// Производит первоначальное заполнение единых реквизитов и зависимых реквизитов ТЧ для документов "Корректировка планов" и "Заявка на корректировку планов".
//
// Параметры:
//  Форма	- ФормаКлиентскогоПриложения - форма
//  ИмяТЧ	- Строка - Имя табличной части документа.
//
Процедура ОпределитьЕдиныеРеквизитыФормыКорректировкиЛимитов(Форма, ИмяТЧ) Экспорт

	Объект = Форма.Объект;
	//
	Колонки = Новый Массив;
	Колонки.Добавить("НачалоПериода");
	Колонки.Добавить("ЦФО");
	Колонки.Добавить("Проект");
	Колонки.Добавить("Валюта"); 
	Колонки.Добавить("ПриходРасход");
	
	ИменаЕдиныхРеквизитов = Новый Массив;
	ИменаЕдиныхРеквизитов.Добавить("ЕдиныйПериод");
	ИменаЕдиныхРеквизитов.Добавить("ЕдиныйЦФО"); 
	ИменаЕдиныхРеквизитов.Добавить("ЕдиныйПроект");
	ИменаЕдиныхРеквизитов.Добавить("ЕдинаяВалюта"); 
	ИменаЕдиныхРеквизитов.Добавить("ЕдиныйПриходРасход");
		
	ТребуетсяТаблица = Объект[ИмяТЧ].Выгрузить(, СтрСоединить(Колонки, ","));
	
	Для Индекс = 0 По Колонки.Количество()-1 Цикл
		СоставКолонки = Колонки[Индекс];
		ЕдиныйРеквизит = ИменаЕдиныхРеквизитов[Индекс];
		ДанныеКолонки = ТребуетсяТаблица.Скопировать(, СоставКолонки);
		ДанныеКолонки.Свернуть(СоставКолонки, "");
		Форма[ЕдиныйРеквизит] = ДанныеКолонки.Количество() = 1;
		Если Форма[ЕдиныйРеквизит] Тогда
			ЗаполнитьЗначенияСвойств(Форма, ДанныеКолонки[0], СоставКолонки);  
		Иначе
			Если ЕдиныйРеквизит = "ЕдиныйПериод" Тогда 
				Форма["НачалоПериода"] = Неопределено; 
				Форма["ПредставлениеПериода"] = Неопределено;
			ИначеЕсли ЕдиныйРеквизит = "ЕдиныйЦФО" Тогда
				Форма["ЦФО"] = Неопределено;  
			ИначеЕсли ЕдиныйРеквизит = "ЕдиныйПроект" Тогда
				Форма["Проект"] = Неопределено;
			ИначеЕсли ЕдиныйРеквизит = "ЕдинаяВалюта" Тогда
				Форма["Валюта"] = Неопределено;
			ИначеЕсли ЕдиныйРеквизит = "ЕдиныйПриходРасход" Тогда
				Форма["ПриходРасход"] = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры  

// Возвращает остаток свободного документа по строке для документов "Корректировка планов" и "Заявка на корректировку планов".
//
// Параметры:
//  СтруктураПараметров	- Структура - Структура параметров
//     * НачалоПериода	- Дата.
//     * Периоличность	- ПеречислениеСсылка.Периодичность.
//     * Валюта 		- СправочникСсылка.Валюты.
//     * ВидБюджета		- ПланВидовХарактеристикСсылка.ВидыБюджетов.
//     * Периоличность	- ПеречислениеСсылка.Периодичность.
//     * Проект			- СправочникСсылка.Проекты.
//     * СтатьяБюджета	- СправочникСсылка.СтатьиДвиженияДенежныхСредств.
//     * ЦФО			- СправочникСсылка.Организации.
Функция ЗаполнитьОстаткиСвободногоЛимитаПоСтрокеКорректировкаЛимитов(СтруктураПараметров) Экспорт
	
	Свободно = 0;
	
	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеРегистра.Регистратор КАК Регистратор,
		|	ДанныеРегистра.Период КАК Период,
		|	ДанныеРегистра.ВидБюджета КАК ВидБюджета,
		|	ДанныеРегистра.ОбъектПланирования КАК ОбъектПланирования,
		|	ДанныеРегистра.АналитикаСтруктуры.ЦФО КАК ЦФО,
		|	ДанныеРегистра.АналитикаСтруктуры.Проект КАК Проект,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.ПриходРасход КАК ПриходРасход,
		|	ДанныеРегистра.Валюта КАК Валюта,
		|	ДанныеРегистра.ВалютаЛимитирования КАК ВалютаЛимитирования,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И НЕ ТИПЗНАЧЕНИЯ(ДанныеРегистра.Регистратор) В (&ТипыКорректировкиЛимитов)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Лимит,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокКОбеспечению)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КОбеспечению,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ТИПЗНАЧЕНИЯ(ДанныеРегистра.Регистратор) В (&ТипыКорректировкиЛимитов)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Корректировка,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И НЕ ДанныеРегистра.ОбъектПланирования.Объект ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Зарезервировано,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокНаОперации)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Заявлено,
		|	ДанныеРегистра.ЛимитИсполненоОборот КАК Исполнено
		|ПОМЕСТИТЬ ВТ_Операции
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			ВидБюджета = &ВидБюджета
		|				И Валюта = &Валюта
		|				И АналитикаСтруктуры.ЦФО = &ЦФО
		|				И АналитикаСтруктуры.Проект = &Проект
		|				И АналитикаСтатейБюджетов.СтатьяБюджета = &СтатьяБюджета) КАК ДанныеРегистра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОперацииБюджетов2Обороты.Период КАК Период,
		|	ОперацииБюджетов2Обороты.ВидБюджета КАК ВидБюджета
		|ПОМЕСТИТЬ ВТ_ВидыБюджетовДаты
		|ИЗ
		|	ВТ_Операции КАК ОперацииБюджетов2Обороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
		|	ПараметрыЛимитирования.Период КАК Период,
		|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
		|	ПараметрыЛимитирования.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
		|	ПараметрыЛимитирования.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
		|	ПараметрыЛимитирования.КонтрольЛимитов КАК КонтрольЛимитов,
		|	ПараметрыЛимитирования.КонтрольРезервов КАК КонтрольРезервов,
		|	ВЫБОР
		|		КОГДА ПараметрыЛимитирования.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
		|				ИЛИ ПараметрыЛимитирования.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Контролировать,
		|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
		|	КонстантаВалютаУправленческогоУчета.Значение КАК ВалютаУправленческогоУчета
		|ПОМЕСТИТЬ ВТ_ПараметрыЛимитирования
		|ИЗ
		|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования,
		|	Константа.ВалютаУправленческогоУчета КАК КонстантаВалютаУправленческогоУчета
		|ГДЕ
		|	ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВидыБюджетовДаты.Период КАК Период,
		|	ВТ_ВидыБюджетовДаты.ВидБюджета КАК ВидБюджета,
		|	МАКСИМУМ(ВТ_ПараметрыЛимитирования.Период) КАК НачалоДействияПараметровЛимитирования
		|ПОМЕСТИТЬ ВТ_НачалоДействияПараметровЛимитирования
		|ИЗ
		|	ВТ_ВидыБюджетовДаты КАК ВТ_ВидыБюджетовДаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитирования КАК ВТ_ПараметрыЛимитирования
		|		ПО ВТ_ВидыБюджетовДаты.ВидБюджета = ВТ_ПараметрыЛимитирования.ВидБюджета
		|			И ВТ_ВидыБюджетовДаты.Период >= ВТ_ПараметрыЛимитирования.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВидыБюджетовДаты.ВидБюджета,
		|	ВТ_ВидыБюджетовДаты.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_НачалоДействияПараметровЛимитирования.ВидБюджета КАК ВидБюджета,
		|	ВТ_НачалоДействияПараметровЛимитирования.НачалоДействияПараметровЛимитирования КАК Период,
		|	ВТ_ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
		|	ВТ_ПараметрыЛимитирования.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
		|	ВТ_ПараметрыЛимитирования.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
		|	ВТ_ПараметрыЛимитирования.КонтрольЛимитов КАК КонтрольЛимитов,
		|	ВТ_ПараметрыЛимитирования.КонтрольРезервов КАК КонтрольРезервов,
		|	ВТ_ПараметрыЛимитирования.Контролировать КАК Контролировать,
		|	ВТ_ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
		|	ВТ_ПараметрыЛимитирования.ВалютаУправленческогоУчета КАК ВалютаУправленческогоУчета
		|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияВДействии
		|ИЗ
		|	ВТ_ПараметрыЛимитирования КАК ВТ_ПараметрыЛимитирования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НачалоДействияПараметровЛимитирования КАК ВТ_НачалоДействияПараметровЛимитирования
		|		ПО ВТ_ПараметрыЛимитирования.ВидБюджета = ВТ_НачалоДействияПараметровЛимитирования.ВидБюджета
		|			И ВТ_ПараметрыЛимитирования.Период = ВТ_НачалоДействияПараметровЛимитирования.НачалоДействияПараметровЛимитирования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПараметрыЛимитированияВДействии.ВидБюджета КАК ВидБюджета,
		|	ВТ_ПараметрыЛимитированияВДействии.Период КАК НачалоДействия,
		|	ПараметрыСтатей.СтатьяБюджета КАК СтатьяБюджета,
		|	ВЫБОР
		|		КОГДА ПараметрыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
		|				ИЛИ ПараметрыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Контролировать,
		|	ПараметрыСтатей.КонтролироватьАналитику1 КАК КонтролироватьАналитику1,
		|	ПараметрыСтатей.КонтролироватьАналитику2 КАК КонтролироватьАналитику2,
		|	ПараметрыСтатей.КонтролироватьАналитику3 КАК КонтролироватьАналитику3,
		|	ПараметрыСтатей.КонтролироватьАналитику4 КАК КонтролироватьАналитику4,
		|	ПараметрыСтатей.КонтролироватьАналитику5 КАК КонтролироватьАналитику5,
		|	ПараметрыСтатей.КонтролироватьАналитику6 КАК КонтролироватьАналитику6,
		|	ПараметрыСтатей.КонтрольЛимитов КАК КонтрольЛимитов,
		|	ПараметрыСтатей.КонтрольРезервов КАК КонтрольРезервов
		|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияСтатейБюджетов
		|ИЗ
		|	ВТ_ПараметрыЛимитированияВДействии КАК ВТ_ПараметрыЛимитированияВДействии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК ПараметрыСтатей
		|		ПО ВТ_ПараметрыЛимитированияВДействии.ВидБюджета = ПараметрыСтатей.ВидБюджета
		|			И ВТ_ПараметрыЛимитированияВДействии.Период = ПараметрыСтатей.Период
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ПараметрыЛимитированияВДействии.ВидБюджета,
		|	ВТ_ПараметрыЛимитированияВДействии.Период,
		|	ВТ_ВсеСтатьиБюджетов.СтатьяБюджета,
		|	ВЫБОР
		|		КОГДА ВТ_ПараметрыЛимитированияВДействии.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
		|				ИЛИ ВТ_ПараметрыЛимитированияВДействии.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ВТ_ПараметрыЛимитированияВДействии.КонтрольЛимитов,
		|	ВТ_ПараметрыЛимитированияВДействии.КонтрольРезервов
		|ИЗ
