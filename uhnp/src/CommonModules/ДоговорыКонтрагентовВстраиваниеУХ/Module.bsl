Процедура ДобавитьИнформациюОбИтогахВОписаниеГрафика(ОписаниеГрафика) Экспорт

	Для Каждого ЭлементОписания Из ОписаниеГрафика Цикл
		
		ОписаниеСекции = ЭлементОписания.Значение;
		
		ОписаниеИтогов = Новый Структура; 
		
		ОписаниеИтогов.Вставить(ОписаниеСекции.КолонкаПриход,Новый Структура("КолонкаСДанными,ИмяРеквизитаИтог,Правило",
																	ОписаниеСекции.КолонкаПриход,ОписаниеСекции.КолонкаПриход + "Итог","Сумма","Приход"));
																	
		ОписаниеИтогов.Вставить(ОписаниеСекции.КолонкаРасход,Новый Структура("КолонкаСДанными,ИмяРеквизитаИтог,Правило",
																	ОписаниеСекции.КолонкаРасход,ОписаниеСекции.КолонкаРасход + "Итог","Сумма","Расход")); 																	
																	
		Для Каждого КлючИЗначение Из ОписаниеИтогов Цикл 
			
			ОписаниеСекцииИтога = КлючИЗначение.Значение;
			ИмяКолонкиФакт = КлючИЗначение.Ключ+"Факт";
			ИмяКолонкиОтклонение = КлючИЗначение.Ключ+"ПланФакт";
			
			Правило = ОписаниеСекцииИтога.Правило;
			ОписаниеИтогов.Вставить(ИмяКолонкиФакт,Новый Структура("КолонкаСДанными,ИмяРеквизитаИтог,Правило",ИмяКолонкиФакт,ИмяКолонкиФакт + "Итог",Правило));
			ОписаниеИтогов.Вставить(ИмяКолонкиОтклонение,Новый Структура("КолонкаСДанными,ИмяРеквизитаИтог,Правило",ИмяКолонкиОтклонение,ИмяКолонкиОтклонение + "Итог",Правило));
			
		КонецЦикла;
																	
		ОписаниеСекции.Вставить("ОписаниеИтогов",ОписаниеИтогов);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДокументАрендыПоДоговоруЛизинга(Объект, ДанныеЗаполнения)Экспорт
	
	Основание = Неопределено;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("Основание",Основание);	
	Иначе
		Основание = ДанныеЗаполнения;
	КонецЕсли;

	Если ТипЗнч(Основание) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание,"ВерсияСоглашения");
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПризнакБезакцептноеСписание(Знач ВерсияСоглашения, ЭлементыСтруктурыЗадолженности = Неопределено) Экспорт
	
	Если ТипЗнч(ВерсияСоглашения) = Тип("СправочникСсылка.ДоговорыКонтрагентов")
			ИЛИ ТипЗнч(ВерсияСоглашения) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
		ВерсияСоглашения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВерсияСоглашения,"ВерсияСоглашения");
	КонецЕсли;
	
	Если ОбщегоНазначенияУХ.ЕстьТабличнаяЧастьОбъекта("БезакцептноеСписаниеДенежныхСредств", ВерсияСоглашения) Тогда
		
		ВидДоговораУХ =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВерсияСоглашения,"ВидДоговораУХ");
		
		МенеджерВерсииСоглашения = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ВерсияСоглашения.Ссылка);
		
		Если ЭлементыСтруктурыЗадолженности = Неопределено Тогда
			ЭлементыСтруктурыЗадолженности = ЭлементыСтруктурыЗадолженностиПоОписаниюГрафика(МенеджерВерсииСоглашения.ОписаниеГрафика(ВидДоговораУХ)).ВыгрузитьЗначения();
		КонецЕсли; 
		
		Для Каждого ЭлементСтруктурыЗадолженности Из ЭлементыСтруктурыЗадолженности Цикл  
			
			СтрокиСписаний = ВерсияСоглашения.БезакцептноеСписаниеДенежныхСредств.НайтиСтроки(Новый Структура("ЭлементСтруктурыЗадолженности",ЭлементСтруктурыЗадолженности));
			Для Каждого СтрокаДанных Из СтрокиСписаний Цикл
				
				Если СтрокаДанных.БезакцептноеСписание Тогда
					Возврат Истина;
				КонецЕсли; 
				
			КонецЦикла;	 
			
		КонецЦикла;
		
		Возврат Ложь;
			
	КонецЕсли;  
		
	
	Возврат Ложь;

КонецФункции 

Функция ЭлементыСтруктурыЗадолженностиПоОписаниюГрафика(ОписаниеГрафика) Экспорт 
	
	ЭлементыСтруктурыЗадолженности = Новый СписокЗначений;

	Если ТипЗнч(ОписаниеГрафика) = Тип("Структура") Тогда
		
		Для Каждого ЭлементСтруктуры Из ОписаниеГрафика Цикл
			
			Если ЭлементСтруктуры.Значение.Свойство("ЭлементСтруктурыЗадолженности") Тогда   
				ЭлементыСтруктурыЗадолженности.Добавить(ЭлементСтруктуры.Значение.ЭлементСтруктурыЗадолженности);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЭлементыСтруктурыЗадолженности;

КонецФункции

// Функция возвращает сумму заключенных спецификаций по договору
//
// Параметры:
//  ДоговорСсылка	 - 	СправочникСсылка.ДоговорыКонтрагентов 
// Возвращаемое значение:
// Число  - Сумма контрактов по договору.
Функция ПолучитьСуммуКонтрактовПоДоговору(ДоговорСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ДоговорыКонтрагентов.Сумма) КАК СуммаКонтракта
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.БазовыйДоговор = &ДоговорСсылка";
	Запрос.УстановитьПараметр("ДоговорСсылка", ДоговорСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.СуммаКонтракта;
	КонецЦикла;
	
КонецФункции

Процедура ОбработкаПроверкиЗаполненияДоговорыКонтрагентовУХ(Источник, Отказ, МассивНепроверяемыхРеквизитов) Экспорт
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Источник.ТребуетсяПостановкаНаУчетВалютногоКонтроля 
		ИЛИ НЕ ИспользоватьУникальныйНомерВалютногоКонтроля(Источник) Тогда 
		МассивНепроверяемыхРеквизитов.Добавить("УникальныйНомерВалютногоКонтроля");
	КонецЕсли;
	
	Если Не Источник.ФиксированныйСчетОрганизации Тогда
		МассивНепроверяемыхРеквизитов.Добавить("БанковскийСчет");
	КонецЕсли;
	
	Если Не Источник.ФиксированныйСчетКонтрагента Тогда
		МассивНепроверяемыхРеквизитов.Добавить("БанковскийСчетКонтрагента");
	КонецЕсли;
	
	Если Источник.ВидСоглашения <> ПредопределенноеЗначение("Перечисление.ВидыСоглашений.Спецификация") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("БазовыйДоговор");
	КонецЕсли;
	
	Если Не УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорФинансовогоИнструмента(Источник.ВидДоговораУХ) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ВидФинансовогоИнструмента");
	КонецЕсли;   
	
	
КонецПроцедуры

Процедура ПередЗаписьюДоговорыКонтрагентов(Источник, Отказ) Экспорт
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;    
	
	ДополнительныеСвойства = Источник.ДополнительныеСвойства;
	
	// При изменении договора, всегда необходимо обновлять версию соглашения
  	УстановленнаяПометкаУдаления = ЗначениеЗаполнено(Источник.Ссылка) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ПометкаУдаления");
	Источник.ДополнительныеСвойства.Вставить("УстановленнаяПометкаУдаления", УстановленнаяПометкаУдаления);
	
	Если Не ДополнительныеСвойства.Свойство("ЭтоЗаписьИзВерсииСоглашения")
			И УстановленнаяПометкаУдаления = Источник.ПометкаУдаления Тогда
		
		РаботаСДоговорамиКонтрагентовУХ.СоздатьВерсиюСоглашенияПоДоговору(Источник);
		
	КонецЕсли;

 	// Обработка спецификаций договоров.
	Если (Источник.ВидСоглашения = Перечисления.ВидыСоглашений.Спецификация) Тогда
		Если Не ДополнительныеСвойства.Свойство("ПараметрыСвязанныхДоговоровДляОбновления") Тогда
			ДополнительныеСвойства.Вставить("ПараметрыСвязанныхДоговоровДляОбновления", Новый Массив);
		КонецЕсли;
		СвязьСпецификации = РаботаСДоговорамиКонтрагентовУХКлиентСервер.ОписаниеСвязанногоДоговора();
		СвязьСпецификации.ВидСвязи = Справочники.ВидыСвязейОбъектов.Спецификация;
		СвязьСпецификации.БазовыйДоговор = Источник.БазовыйДоговор;
		ДополнительныеСвойства.ПараметрыСвязанныхДоговоровДляОбновления.Добавить(СвязьСпецификации);
	Иначе
		// Не требуется установка связи спецификации договора.
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписиДоговорыКонтрагентов(Источник, Отказ) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства = Источник.ДополнительныеСвойства;
	
	// обновим записи в регистре "Связанные договоры".
	Если Источник.ДополнительныеСвойства.Свойство("ПараметрыСвязанныхДоговоровДляОбновления") Тогда
	
		Для каждого Связь Из Источник.ДополнительныеСвойства.ПараметрыСвязанныхДоговоровДляОбновления Цикл
			
			Если Не ЗначениеЗаполнено(Связь.БазовыйДоговор) Тогда
				Связь.БазовыйДоговор = Источник.Ссылка;
			КонецЕсли;  
				
			Если Не ЗначениеЗаполнено(Связь.ПодчиненныйДоговор) Тогда
				Связь.ПодчиненныйДоговор = Источник.Ссылка;
			КонецЕсли;   
			
			РеквизитыДоговора1 = СвязанныеДоговорыУХПереопределяемый.РеквизитыДляПроверки(Связь.БазовыйДоговор);
			РеквизитыДоговора2 = СвязанныеДоговорыУХПереопределяемый.РеквизитыДляПроверки(Связь.ПодчиненныйДоговор);

			Если Связь.ВидСвязи.ОдинаковаяВалюта И (РеквизитыДоговора1.Валюта <> РеквизитыДоговора2.Валюта) Тогда
				ТекстСообщения = НСтр("ru = 'Для договоров <%1> И <%2> должна быть указана одинаковая валюта(вид связи <%3>)'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Связь.БазовыйДоговор, Связь.ПодчиненныйДоговор, Связь.ВидСвязи),,,,Отказ);
				Возврат;
			КонецЕсли;

			
			РегистрыСведений.СвязанныеДоговоры.ЗаписатьСвязанныеДоговоры(Связь.БазовыйДоговор, Связь.ПодчиненныйДоговор, Связь.ВидСвязи, Отказ);			
			
		КонецЦикла;
		
	КонецЕсли;

	// Пакетно пометим на удаление все версии соглашения
	Если ДополнительныеСвойства.Свойство("УстановленнаяПометкаУдаления") И Не ДополнительныеСвойства.Свойство("ПометкаУдаленияВерсииСоглашения")  Тогда
		Если ДополнительныеСвойства.УстановленнаяПометкаУдаления И Не Источник.ПометкаУдаления Тогда
			// Сняли пометку удаления.
			ДоговорОбъект = Источник.ВерсияСоглашения.ПолучитьОбъект();
			ДоговорОбъект.УстановитьПометкуУдаления(Ложь);
		ИначеЕсли Источник.ПометкаУдаления И Не ДополнительныеСвойства.УстановленнаяПометкаУдаления Тогда
			// Установили пометку удаления.
			РаботаСДоговорамиКонтрагентовУХ.ПометитьНаУдалениеВерсииСоглашенияДоговора(Источник.Ссылка, Источник.ВидДоговораУХ);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаЗаполненияДоговорыКонтрагентовУХ(Источник, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Источник.Ответственный = Пользователи.ТекущийПользователь();
	
	Если (ТипЗнч(ДанныеЗаполнения) = Тип("Структура")) И ДанныеЗаполнения.Свойство("БазовыйДоговор") Тогда
		ЗаполнитьЗначенияСвойств(Источник, ДанныеЗаполнения.БазовыйДоговор, "Владелец,Организация,ВалютаВзаиморасчетов,ВидДоговора,ВидФинансовогоИнструмента,ВидДоговораУХ");
	КонецЕсли;
	
	Если (ТипЗнч(ДанныеЗаполнения) = Тип("Структура")) И ДанныеЗаполнения.Свойство("Основание") Тогда
		ЗаполнитьЗначенияСвойств(Источник,
								ДанныеЗаполнения.Основание,,
								"Код,Владелец,Организация,ВалютаВзаиморасчетов,ВидДоговора,ВидДоговораУХ");
	КонецЕсли;

	Если (ТипЗнч(ДанныеЗаполнения) = Тип("Структура")) И ДанныеЗаполнения.Свойство("ВстречныйДоговор") Тогда
		
		РеквизитыДоговора = Новый Структура;
		
		Если ТипЗнч(ДанныеЗаполнения.ВстречныйДоговор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			РеквизитыДоговора.Вставить("Организация", "Организация");
			РеквизитыДоговора.Вставить("Владелец", "Владелец");
		Иначе 
			РеквизитыДоговора.Вставить("Организация", "Организация");
			РеквизитыДоговора.Вставить("Владелец", "Контрагент");
		КонецЕсли;   
		
		РеквизитыВстречныйДоговор = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения.ВстречныйДоговор, Новый ФиксированнаяСтруктура(РеквизитыДоговора));
	
		Источник.Владелец 		= РаботаСКонтрагентамиУХ.КонтрагентОрганизации(РеквизитыВстречныйДоговор.Организация);
		Источник.Организация	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыВстречныйДоговор.Владелец, "ОрганизационнаяЕдиница");

	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник.ОсновнойЦФО) Тогда
		Источник.ОсновнойЦФО = ОбщегоНазначенияУХ.ПолучитьЗначениеПоУмолчанию("ОсновнойЦФО");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник.ОсновнойПроект) Тогда
		Источник.ОсновнойПроект = ОбщегоНазначенияУХ.ПолучитьЗначениеПоУмолчанию("ОсновнойПроект");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.ВидДоговора) И НЕ ЗначениеЗаполнено(Источник.ВидДоговораУХ) Тогда
		Источник.ВидДоговораУХ = УправлениеДоговорамиУХКлиентСерверПовтИсп.ВидДоговораУХ(Источник.ВидДоговора);
	ИначеЕсли ЗначениеЗаполнено(Источник.ВидДоговораУХ) И Не ЗначениеЗаполнено(Источник.ВидДоговора) Тогда
		Источник.ВидДоговора = УправлениеДоговорамиУХКлиентСерверПовтИсп.ВидДоговораБП(Источник.ВидДоговораУХ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьАналитикиГрафикаПоставок(ГрафикПоставок, Объект) Экспорт
	
	ГрафикПоставок.Колонки.Добавить("СчетОрганизации");
	ГрафикПоставок.Колонки.Добавить("СчетКонтрагента");
	
	ДанныеЗаполнения =  Новый Структура;

	Для Каждого СтрокаГрафика Из ГрафикПоставок Цикл
		ДанныеЗаполнения.Вставить("СчетОрганизации", Объект.БанковскийСчет);
		ДанныеЗаполнения.Вставить("СчетКонтрагента", Объект.БанковскийСчетКонтрагента);	
		ЗаполнитьЗначенияСвойств(СтрокаГрафика,ДанныеЗаполнения);
	КонецЦикла;   

КонецПроцедуры

Процедура ОбработатьДокументРезервированияГрафикаПоставок(ГрафикПоставок, Объект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ГрафикПоставок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	ВидБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);   
	
	ДокументыРезервирования = ГрафикПоставок.Скопировать(, "ДокументРезервирования");
	ДокументыРезервирования.Свернуть("ДокументРезервирования");
	
	Если ДокументыРезервирования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыРезервирования.ДокументРезервирования КАК ДокументРезервирования
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	&ДокументыРезервирования КАК ДокументыРезервирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документы.ДокументРезервирования КАК ДокументРезервирования
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ВТ_Документы.ДокументРезервирования = ОперацииБюджетов.ОбъектПланирования.Объект
	|ГДЕ
	|	НЕ ОперацииБюджетов.Регистратор ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ДокументыРезервирования", ДокументыРезервирования);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРезервов = РезультатЗапроса.Выгрузить();

	Для Каждого СтрокаТаблицы Из ГрафикПоставок Цикл

		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДокументРезервирования) 
			ИЛИ Не КонтрольЛимитовУХ.ЭтоЗакупочныйДокумент(СтрокаТаблицы.ДокументРезервирования) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Не ВидБюджетаЗакупок = СтрокаТаблицы.ВидБюджета 
			ИЛИ ТаблицаРезервов.Найти(СтрокаТаблицы.ДокументРезервирования) = Неопределено Тогда
			СтрокаТаблицы.ДокументРезервирования = Неопределено;	
		КонецЕсли;
		
	КонецЦикла;
	
	ИсточникЛимитовЗаполнены = ЗначениеЗаполнено(Объект.ИсточникЛимитовИсполнение) 
									Или ЗначениеЗаполнено(Объект.ИсточникЛимитовБДДС);
	
	Если ИсточникЛимитовЗаполнены Тогда
		
		ГрафикПоставок.Колонки.Добавить("ДокументРезервирования_temp");
		ГрафикПоставок.ЗагрузитьКолонку(ГрафикПоставок.ВыгрузитьКолонку("ДокументРезервирования"), "ДокументРезервирования_temp");
		ГрафикПоставок.Колонки.Удалить("ДокументРезервирования");
		ГрафикПоставок.Колонки.ДокументРезервирования_temp.Имя = "ДокументРезервирования";
		
		БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
		БюджетДвиженияДенежныхСредств = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		
		Для Каждого СтрокаТаблицы Из ГрафикПоставок Цикл   
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДокументРезервирования) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ИсточникЛимитовИсполнение) 
				И СтрокаТаблицы.ВидБюджета = БюджетДоходовИРасходов Тогда
				СтрокаТаблицы.ДокументРезервирования = Объект.ИсточникЛимитовИсполнение;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ИсточникЛимитовБДДС) 
				И СтрокаТаблицы.ВидБюджета = БюджетДвиженияДенежныхСредств Тогда  
				СтрокаТаблицы.ДокументРезервирования = Объект.ИсточникЛимитовБДДС;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьВариантКурсаДоговораУХ(ВерсияСоглашения) Экспорт
	
	КурсНаДатуПлатежа = ВерсияСоглашения.СпособОпределенияКурсаПлатежа = Перечисления.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа; 
	ЕстьДатаФиксацииКурсаПлатежа = ЗначениеЗаполнено(ВерсияСоглашения.ДатаФиксацииКурсаПлатежа);
	ЕстьСдвигДатыФиксацииКурсаПлатежа = ЗначениеЗаполнено(ВерсияСоглашения.СдвигДатыФиксацииКурсаПлатежа);
	ЕстьКоридорКурсаНеМенее = ВерсияСоглашения.КурсПлатежаНеМенее > 0 И ВерсияСоглашения.КурсПлатежаНеМенееВВалютеОплаты > 0;
	ЕстьКоридорКурсаНеБолее = ВерсияСоглашения.КурсПлатежаНеБолее  > 0 И ВерсияСоглашения.КурсПлатежаНеБолееВВалютеОплаты > 0;
	ВариантКурсаДоговораУХ = ВерсияСоглашения.ВариантКурсаДоговора;	
	Если ВерсияСоглашения.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.УстановленныйВДоговоре Тогда
		ВариантКурсаДоговораУХ = Перечисления.ВариантыКурсаДоговора.УстановленныйВДоговоре;
	ИначеЕсли ВерсияСоглашения.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.Переменный Тогда
		Если КурсНаДатуПлатежа Тогда
			Если ЕстьДатаФиксацииКурсаПлатежа 
				ИЛИ ЕстьСдвигДатыФиксацииКурсаПлатежа
				ИЛИ ЕстьКоридорКурсаНеМенее
				ИЛИ ЕстьКоридорКурсаНеБолее Тогда
				ВариантКурсаДоговораУХ = Перечисления.ВариантыКурсаДоговора.УстановленныйВДоговоре;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	Возврат ВариантКурсаДоговораУХ;
	
КонецФункции

#КонецОбласти

#Область УнификацияРешений

Функция ПодготовитьСписокРазрешенныхВалют(ВалютаРегламентированногоУчета, ВсеКромеВалютыРеглУчета) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("ВсеКромеВалютыРеглУчета", ВсеКромеВалютыРеглУчета);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Валюты.Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	(Валюты.Ссылка <> &ВалютаРегламентированногоУчета и &ВсеКромеВалютыРеглУчета)
	|	ИЛИ (Валюты.Ссылка = &ВалютаРегламентированногоУчета и НЕ &ВсеКромеВалютыРеглУчета)";
	
	ВыборкаИзЗапроса = Запрос.Выполнить().Выбрать();
	
	ВозвращаемыйМассив = Новый Массив;
	
	Пока ВыборкаИзЗапроса.Следующий() Цикл
		ВозвращаемыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", ВыборкаИзЗапроса.Ссылка));
	КонецЦикла;
	
	Если ВозвращаемыйМассив.Количество() = 0 Тогда
		ВозвращаемыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Справочники.Валюты.ПустаяСсылка()));
	КонецЕсли;
	
	Возврат ВозвращаемыйМассив;
	
КонецФункции

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Функция ТипПлатежаПоЭлементуСтруктурыЗадолженности(Объект, ЭлементСтруктурыЗадолженности)
	
	ТипПлатежа = Неопределено;

	СоответствиеТиповПлатежей = Новый Соответствие;
	
	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ОплатаАрендодателю") Тогда
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.УслугаПоАренде"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.УслугаПоАренде")); 
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.УслугаПоАрендеАванс"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.УслугаПоАрендеАванс"));
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ОбеспечительныйПлатеж"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.ОбеспечительныйПлатеж"));
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ВыкупнаяСтоимость"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.ВыкупнаяСтоимость"));
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ВыкупнаяСтоимостьАванс"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.ВыкупнаяСтоимостьАванс"));
		
		Возврат СоответствиеТиповПлатежей.Получить(ЭлементСтруктурыЗадолженности);
	КонецЕсли;
	
КонецФункции


Процедура ЗаполнитьГрафикИсполненияДоговора(ВычисляемыеРеквизиты, ВерсияСоглашения)
	
	ВычисляемыеРеквизиты.Вставить(
		"ЗаданГрафикИсполнения",
		РаботаСДоговорамиКонтрагентовЕХ.НуженГрафикИсполнения(ВерсияСоглашения));
		
    ДоговорОбъект = ВерсияСоглашения.ДополнительныеСвойства.ДоговорОбъект; 
	ТипДоговора = УправлениеДоговорамиУХВызовСервераПовтИсп.ВидДоговораБП(ВерсияСоглашения.ВидДоговораУХ);
	ЭтоСПоставщиком = ТипДоговора = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыДоговоров.СПоставщиком");


	Договор = ВерсияСоглашения.ДоговорКонтрагента;
	РеквизитыДоговора = Новый Структура;
	РеквизитыДоговора.Вставить("Сумма"); 
	РеквизитыДоговора.Вставить("ГрафикИсполненияДоговора");  
	
	ЗаполнитьЗначенияСвойств(РеквизитыДоговора, ДоговорОбъект);
	ЗаполнитьЗначенияСвойств(РеквизитыДоговора, ВерсияСоглашения);
	
	ВерсияПроведена = ВерсияСоглашения.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение
		ИЛИ (ВерсияСоглашения.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись И ВерсияСоглашения.Проведен);
	
	Если ВычисляемыеРеквизиты.ЗаданГрафикИсполнения И ВерсияПроведена Тогда
		
		Если ЗначениеЗаполнено(Договор) Тогда
			// существующий график обновить
			ГрафикСсылка = РеквизитыДоговора.ГрафикИсполненияДоговора;
		Иначе
			// новый график
			ГрафикСсылка = неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГрафикСсылка) Тогда
			ГрафикОбъект = ГрафикСсылка.ПолучитьОбъект();
		Иначе
			ГрафикОбъект = Документы.ГрафикИсполненияДоговора.СоздатьДокумент();
		КонецЕсли;
		
		ГрафикОбъект.Дата 		= ТекущаяДатаСеанса();
		ГрафикОбъект.Договор 	= Договор;
		ГрафикОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		
		ГрафикОбъект.ЭтапыГрафикаИсполненияДоговора.Очистить();
		
		СуммаДоговора = РеквизитыДоговора.Сумма;   
		
		ДобавлятьЭтапыГрафикаОплаты = Ложь;
		ДатаПоГрафику = Неопределено;
		Если ВерсияСоглашения.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов") Тогда
			ГрафикОбъект.ЭтапыГрафикаОплаты.Очистить();	 
			ДобавлятьЭтапыГрафикаОплаты = Истина;
			Для Каждого СтрокаГрафикаСоглашения Из ВерсияСоглашения.ГрафикРасчетов Цикл
				Если ДатаПоГрафику = Неопределено 
					И СтрокаГрафикаСоглашения.КолонкаСекции = ПредопределенноеЗначение("Перечисление.ВидыДвиженийПриходРасход.Приход")
					Тогда
					ДатаПоГрафику = СтрокаГрафикаСоглашения.Дата;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;			
		
		ТаблицаГрафикРасчетов = ВерсияСоглашения.ГрафикРасчетов.Выгрузить();
		ТаблицаГрафикРасчетов.Сортировать("Дата");
		
		Для Каждого СтрокаГрафикаСоглашения Из ТаблицаГрафикРасчетов Цикл
			
			Если СтрокаГрафикаСоглашения.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаГрафикаСоглашения.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов Тогда
				
				НоваяСтрока = ГрафикОбъект.ЭтапыГрафикаИсполненияДоговора.Добавить();
				НоваяСтрока.ДатаПоГрафику 	 = СтрокаГрафикаСоглашения.Дата;   
				НоваяСтрока.ДатаОтгрузки	 = СтрокаГрафикаСоглашения.Дата;
				
				НоваяСтрока.СуммаИсполнения = СтрокаГрафикаСоглашения.Сумма;
				Если СуммаДоговора <> 0 Тогда
					НоваяСтрока.ПроцентИсполнения = НоваяСтрока.СуммаИсполнения * 100 / СуммаДоговора;
				КонецЕсли;
				
				ДатаПоГрафику = СтрокаГрафикаСоглашения.Дата;
				
			КонецЕсли;  
			
			Если ДобавлятьЭтапыГрафикаОплаты = Истина И ДатаПоГрафику <> Неопределено
				И СтрокаГрафикаСоглашения.КолонкаСекции = ПредопределенноеЗначение("Перечисление.ВидыДвиженийПриходРасход.Расход") Тогда
				
				НоваяСтрокаЭтапаОплаты = ГрафикОбъект.ЭтапыГрафикаОплаты.Добавить(); 
				НоваяСтрокаЭтапаОплаты.ДатаПлатежа = СтрокаГрафикаСоглашения.Дата; 
				НоваяСтрокаЭтапаОплаты.СуммаПлатежа = СтрокаГрафикаСоглашения.Сумма;                            
				Если СуммаДоговора <> 0 Тогда
					НоваяСтрокаЭтапаОплаты.ПроцентПлатежа = СтрокаГрафикаСоглашения.Сумма * 100 / СуммаДоговора; 
				КонецЕсли;
				Сдвиг = (НачалоДня(НоваяСтрокаЭтапаОплаты.ДатаПлатежа) - НачалоДня(ДатаПоГрафику)) / (60 * 60 * 24);
				НоваяСтрокаЭтапаОплаты.Сдвиг = ?(Сдвиг > 0,Сдвиг,0);
				Если Сдвиг < 0 Тогда
					Если ЭтоСПоставщиком Тогда 
						НоваяСтрокаЭтапаОплаты.ВариантОплаты = ПредопределенноеЗначение("Перечисление.ВариантыКонтроляОплатыПоставщику.ПредоплатаДоПоступления");
					Иначе
						НоваяСтрокаЭтапаОплаты.ВариантОплаты = ПредопределенноеЗначение("Перечисление.ВариантыКонтроляОплатыКлиентом.ПредоплатаДоОтгрузки");
					КонецЕсли;	
					НоваяСтрокаЭтапаОплаты.ВариантОтсчета = ПредопределенноеЗначение("Перечисление.ВариантыОтсчетаДатыПлатежа.ДоДатыОтгрузки");	                
					
				Иначе                          
					Если ЭтоСПоставщиком Тогда 
						НоваяСтрокаЭтапаОплаты.ВариантОплаты = ПредопределенноеЗначение("Перечисление.ВариантыКонтроляОплатыПоставщику.КредитСдвиг");
					Иначе
						НоваяСтрокаЭтапаОплаты.ВариантОплаты = ПредопределенноеЗначение("Перечисление.ВариантыКонтроляОплатыКлиентом.КредитСдвиг");
					КонецЕсли;	
					НоваяСтрокаЭтапаОплаты.ВариантОтсчета = ПредопределенноеЗначение("Перечисление.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки");	 
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		Если ГрафикОбъект.ЭтоНовый() Тогда
			ВычисляемыеРеквизиты.Вставить("ГрафикИсполненияДоговора", Документы.ГрафикИсполненияДоговора.ПолучитьСсылку());
			ГрафикОбъект.УстановитьСсылкуНового(ВычисляемыеРеквизиты.ГрафикИсполненияДоговора);
		Иначе
			ВычисляемыеРеквизиты.Вставить("ГрафикИсполненияДоговора", ГрафикОбъект.Ссылка);
		КонецЕсли;
		
		ВыполнитьОбработкуДопОбъекта(ВерсияСоглашения, ГрафикОбъект, "ПровестиНеОперативно");
		
	Иначе
		ВычисляемыеРеквизиты.Вставить("ГрафикИсполненияДоговора", неопределено);
		
		Если ЗначениеЗаполнено(РеквизитыДоговора.ГрафикИсполненияДоговора) Тогда
			ГрафикОбъект = РеквизитыДоговора.ГрафикИсполненияДоговора.ПолучитьОбъект();
			ВыполнитьОбработкуДопОбъекта(ВерсияСоглашения, ГрафикОбъект, "УстановитьПометкуУдаления");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьОбработкуДопОбъекта(ВерсияСоглашенияОбъект, ДопОбъект, Действие)
	
	Данные = Новый Структура("Объект, Действие", ДопОбъект, Действие);   
	ДополнительныеСвойства = ВерсияСоглашенияОбъект.ДополнительныеСвойства;
   	Если ДополнительныеСвойства.Свойство("ДополнительныеОбъекты")  Тогда
		ВерсияСоглашенияОбъект.ДополнительныеСвойства.ДополнительныеОбъекты.Добавить(Данные);
	КонецЕсли;	
	
КонецПроцедуры

