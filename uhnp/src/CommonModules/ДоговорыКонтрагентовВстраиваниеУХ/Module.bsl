Функция ПорядокРасчетовПоДоговоруКонтрагента(ДоговорКонтрагента) Экспорт

	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПорядокРасчетов",ДоговорКонтрагента.Метаданные()) Тогда
	
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента,"ПорядокРасчетов");
		
	КонецЕсли;

КонецФункции 

Процедура ЗаполнитьСписокВыбораИспользованияГрафикаРасчетов(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	
	ЭлементИспользованиеГрафикаРасчетовБДР = Элементы.Найти("ИспользованиеГрафикаРасчетовБДР");	
	ЭлементИспользованиеГрафикаРасчетовБДДС = Элементы.Найти("ИспользованиеГрафикаРасчетовБДДС"); 
	
	Если ЭлементИспользованиеГрафикаРасчетовБДДС <> Неопределено Тогда
		
		ЭлементИспользованиеГрафикаРасчетовБДДС.РежимВыбораИзСписка = Истина;
		ЭлементИспользованиеГрафикаРасчетовБДДС.СписокВыбора.ЗагрузитьЗначения(СписокВыбораИспользованиеГрафикаРасчетов("БДДС"));
		
	КонецЕсли;
	
	Если ЭлементИспользованиеГрафикаРасчетовБДР <> Неопределено Тогда
		
		ЭлементИспользованиеГрафикаРасчетовБДР.РежимВыбораИзСписка = Истина;
		ЭлементИспользованиеГрафикаРасчетовБДР.СписокВыбора.ЗагрузитьЗначения(СписокВыбораИспользованиеГрафикаРасчетов("БДР"));
		
	КонецЕсли; 

КонецПроцедуры

Функция СписокВыбораИспользованиеГрафикаРасчетов(ИмяСписка)
	
	СписокВыбора = Новый Массив;
	
	Если ИмяСписка = "БДР" Тогда 
		СписокВыбора.Добавить(Перечисления.РежимыИспользованияГрафика.ТолькоРезервированиеБюджета);
		СписокВыбора.Добавить(Перечисления.РежимыИспользованияГрафика.РезервированиеБюджетаИКонтрольСоблюденияГрафика);
	Иначе 
		СписокВыбора.Добавить(Перечисления.РежимыИспользованияГрафика.ТолькоРезервированиеБюджета);
		СписокВыбора.Добавить(Перечисления.РежимыИспользованияГрафика.РезервированиеБюджетаИКонтрольСоблюденияГрафика);
		СписокВыбора.Добавить(Перечисления.РежимыИспользованияГрафика.АвтоматическоеСозданиеПлатежныхПозиций);
	КонецЕсли;  
	
	Возврат СписокВыбора;

КонецФункции

Функция ИспользоватьУникальныйНомерВалютногоКонтроля(Объект)
	
	КонтрагентЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ЮрФизЛицо");
	
	ТипыДоговоров = Новый Массив;
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоров.СПоставщиком);
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоров.Импорт);
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоров.ВвозИзЕАЭС);
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоров.СКомитентом);
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоров.СКомиссионером);
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоров.СПокупателем);
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоров.РеализацияЧерезКомиссионера);
	
	Возврат ТипыДоговоров.Найти(Объект.ТипДоговора) <> Неопределено
		И ДенежныеСредстваКлиентСерверЛокализация.ПрименяетсяВалютныйКонтроль(КонтрагентЮрФизЛицо);

КонецФункции

Процедура ЗаполнитьСтатьиПоПараметрамОпераций(ВычисляемыеРеквизиты, ВерсияСоглашения)
	
	Если НЕ ВерсияСоглашения.ПараметрыОпераций.Количество() Тогда
		Возврат;
	КонецЕсли;  
	
	ТипВерсииСоглашения = ТипЗнч(ВерсияСоглашения);
	Если ТипВерсииСоглашения = Тип("ДокументОбъект.ВерсияСоглашенияКредит") Тогда
		Для каждого СтрокаПараметры Из ВерсияСоглашения.ПараметрыОпераций Цикл     
			
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемВыданный_ОсновнойДолгВозврат") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСОсновногоДолга", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;                                                                                         
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемВыданный_ОсновнойДолгПолучение") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПоступленияВыдачи", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемВыданный_КомиссииУплачено") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСКомиссии", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
   			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемВыданный_ПроцентыУплачено") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПроцентов", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
        			
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.КредитПолученный_КомиссииУплачено") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСКомиссии", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСОсновногоДолга", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПоступленияВыдачи", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;	
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыУплачено") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПроцентов", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;	
			
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_КомиссииУплачено") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСКомиссии", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ОсновнойДолгВозврат") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСОсновногоДолга", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ОсновнойДолгПолучение") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПоступленияВыдачи", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;	
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПроцентыУплачено") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПроцентов", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;	
			
		КонецЦикла;
	ИначеЕсли ТипВерсииСоглашения = Тип("ДокументОбъект.ВерсияСоглашенияДепозит") Тогда	
		Для каждого СтрокаПараметры Из ВерсияСоглашения.ПараметрыОпераций Цикл
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.Депозит_ОсновнойДолгВозврат") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСОсновногоДолга", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.Депозит_ОсновнойДолгРазмещение") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПоступленияВыдачи", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;	
			Если СтрокаПараметры.ОперацияГрафика = ПредопределенноеЗначение("Справочник.ОперацииГрафиковДоговоров.Депозит_ПроцентыУплачено") Тогда
				ВычисляемыеРеквизиты.Вставить("СтатьяДДСПроцентов", СтрокаПараметры.СтатьяБюджета);	
			КонецЕсли;		
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры	

