Процедура ОбработатьОповещениеЗаписиВерсииСоглашенияДоговора(Форма, ИмяСобытия, Параметр, Источник)
	
	Объект = Форма.Объект;
	
	Если ИмяСобытия = "Запись_ДоговорыКонтрагентов" И Объект.Ссылка = Источник Тогда
		Если НЕ Форма.Модифицированность Тогда
			Форма.Прочитать();
			Если ЗначениеЗаполнено(Объект.ВерсияСоглашения) Тогда
				// нужно открыть версию вместо договора
				Форма.Закрыть();
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры	

Процедура УстановитьНадписьБезакцептноеСписание(Форма)

	Элементы = Форма.Элементы;
	
	Если Элементы.Найти("ГруппаБезакцептноеСписание") <> Неопределено Тогда
	
		Объект = Форма.Объект;
		
		ЗаголовокРезультат = "";
		
		СтрокиСписание = Объект.БезакцептноеСписаниеДенежныхСредств.НайтиСтроки(Новый Структура("БезакцептноеСписание",Истина));
		МассивСтрок = Новый Массив;
		
		Для Каждого СтрокаСписания Из СтрокиСписание Цикл 
			МассивСтрок.Добавить(СтрокаСписания.ЭлементСтруктурыЗадолженности);	
		КонецЦикла;
		
		ЗаголовокРезультат = СтрСоединить(МассивСтрок,", "); 
		
		Если Не ЗначениеЗаполнено(ЗаголовокРезультат) Тогда  
			ЗаголовокРезультат = НСтр("ru = 'Не осуществляется'")
		КонецЕсли;
		
		Форма.БезакцептноеСписаниеНадпись = ЗаголовокРезультат; 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьФлагБезакцептноеСписание(Форма)
	
	Элементы = Форма.Элементы;
    
	Если Элементы.Найти("ГруппаБезакцептноеСписание") <> Неопределено Тогда
		
		Объект = Форма.Объект;
		
		Если Объект.БезакцептноеСписаниеДенежныхСредств.Количество() = 1 Тогда	
		
			Форма.БезакцептноеСписание = Объект.БезакцептноеСписаниеДенежныхСредств[0].БезакцептноеСписание;
		
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

Процедура ПослеВыбораБезакцептныхСписаний(Форма, ВыбранноеЗначение, Параметры)Экспорт

	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
		Объект = Форма.Объект;
		
		Объект.БезакцептноеСписаниеДенежныхСредств.Очистить(); 
		
		Для Каждого СтрокаСписка Из ВыбранноеЗначение Цикл   
			
			НовСтр = Объект.БезакцептноеСписаниеДенежныхСредств.Добавить();	
			НовСтр.ЭлементСтруктурыЗадолженности = СтрокаСписка.Значение;
			НовСтр.БезакцептноеСписание = СтрокаСписка.Пометка;  
			
		КонецЦикла;
		
		УстановитьНадписьБезакцептноеСписание(Форма);    
		
		Форма.Модифицированность = Истина;
			
	КонецЕсли; 
	
КонецПроцедуры

Функция СформироватьСписокБезакцептныхСписаний(Форма)
	
	СписокЗначений = Новый СписокЗначений;
	
	Объект = Форма.Объект;
	
	Для Каждого СтрокаСписка Из Форма.ЭлементыСтруктурыЗадолженности Цикл   
		ФлагУстановлен = Ложь;
		СтрокиСписание = Объект.БезакцептноеСписаниеДенежныхСредств.НайтиСтроки(Новый Структура("ЭлементСтруктурыЗадолженности",СтрокаСписка.Значение)); 
		
		Если СтрокиСписание.Количество() Тогда 
			
			ФлагУстановлен = СтрокиСписание[0].БезакцептноеСписание;
			
		КонецЕсли;
			
		СписокЗначений.Добавить(СтрокаСписка.Значение,,ФлагУстановлен);
	КонецЦикла;

	Возврат СписокЗначений;

КонецФункции

Процедура БезакцептноеСписаниеПриИзменении(Форма)Экспорт
	
	Объект = Форма.Объект;
	
	Если Объект.БезакцептноеСписаниеДенежныхСредств.Количество() Тогда 
		
		Объект.БезакцептноеСписаниеДенежныхСредств[0].БезакцептноеСписание = Форма.БезакцептноеСписание;	
		
	Иначе                                                  
		
		НовСтр = Объект.БезакцептноеСписаниеДенежныхСредств.Добавить();
		
		ЭлементСтруктурыЗадолженности = Форма.ЭлементыСтруктурыЗадолженности[0].Значение;
		
		НовСтр.ЭлементСтруктурыЗадолженности = ЭлементСтруктурыЗадолженности;	
		НовСтр.БезакцептноеСписание = Форма.БезакцептноеСписание;	 
		
	КонецЕсли;    
	
	Форма.Модифицированность = Истина;

КонецПроцедуры

Процедура БезакцептноеСписаниеНадписьНажатие(Форма, Элемент, СтандартнаяОбработка)Экспорт

	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("СписокБезакцептныхСписаний", СформироватьСписокБезакцептныхСписаний(Форма));
	ПараметрыОткрытия.Вставить("ЗаблокироватьФорму", Форма.ТолькоПросмотр);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораБезакцептныхСписаний",Форма);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораБезакцептныхСписанийУХ",ПараметрыОткрытия,Форма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
#КонецОбласти

#Область ПараметрыОпераций
Процедура ОткрытьПараметрыОперацийГрафика(Форма, ПараметрыКоманды) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьНастройкуОпераций", Форма); 
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОперацийГрафика", ПараметрыКоманды, Форма,,,,Оповещение, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры
#КонецОбласти