Процедура тн_ПолучитьДанныеФайловЭДДляОтчетов(ТаблицаФайловЭДО,ТаблицаФайлов) Экспорт	
	Для Каждого ТекФайлЭДО Из ТаблицаФайловЭДО Цикл
		
		ДанныеФайла = "";
		ДанныеЭлектронногоДокумента = РаботаСФайлами.ДвоичныеДанныеФайла(ТекФайлЭДО.ЭлектронныйДокумент); 
 
		//Возвращает Табличный документ из двоисных данных XML
		Если ТипЗнч(ДанныеЭлектронногоДокумента) = Тип("Строка") Тогда
			ПотокИсходногоXML = Новый ФайловыйПоток(ДанныеЭлектронногоДокумента, РежимОткрытияФайла.Открыть);
		Иначе
			ПотокИсходногоXML = ДанныеЭлектронногоДокумента.ОткрытьПотокДляЧтения();                                       
		КонецЕсли;
		
		ДанныеДокументаСтруктура = КонвертацияЭДО.ПреобразоватьФорматЭД(ПотокИсходногоXML,Новый Структура("ИтоговыйФормат,ИсходныйФормат","ПараметрыЭлектронногоДокумента","ПроизвольныйXML")); 
		Если НЕ ДанныеДокументаСтруктура.Свойство("СуммаДокумента") Тогда 
			Продолжить;
		КонецЕсли;
		
		ПараметрыПолучения = ЭлектронныеДокументыЭДО.НовыеПараметрыПолученияДанныхДокумента(); 
		ПараметрыПолучения.ОсновнойФайл.ДвоичныеДанные =  ДанныеЭлектронногоДокумента;
		ПараметрыПолучения.Направление = Перечисления.НаправленияЭДО.Внутренний;
		ТЗИнформацияОТоваре = ЭлектронныеДокументыЭДО.ДанныеНоменклатурыДокумента(ПараметрыПолучения);
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
		
		ДанныеЭлектронногоДокумента.Записать(ИмяВремФайла); 
		
		НоваяСтрокаТаблицаФайлов = ТаблицаФайлов.Добавить();
		НоваяСтрокаТаблицаФайлов.ИдентификаторЭДО = ДанныеДокументаСтруктура.ИдентификаторДокумента;
		НоваяСтрокаТаблицаФайлов.СсылкаСФ = ТекФайлЭДО.СсылкаНаОбъект;
		НоваяСтрокаТаблицаФайлов.ДатаПодписанияЭДО = ДанныеДокументаСтруктура.ДатаДокумента;
		НоваяСтрокаТаблицаФайлов.СтатусЭДО = "";
		НоваяСтрокаТаблицаФайлов.ПродавецЭДО = ДанныеДокументаСтруктура.Отправитель.Наименование;
		НоваяСтрокаТаблицаФайлов.ИННОрганизацияЭДО = ДанныеДокументаСтруктура.Отправитель.ИНН;
		НоваяСтрокаТаблицаФайлов.ИННКонтрагентЭДО = ДанныеДокументаСтруктура.Получатель.ИНН;
		НоваяСтрокаТаблицаФайлов.СуммаДокументаЭДО = ДанныеДокументаСтруктура.СуммаДокумента;
		
		//Рзберем файл, получим данные по суммам 
		Путь = "";
		Пасер = Новый ЧтениеXML;
		Пасер.ОткрытьФайл(ИмяВремФайла);
		Пока Пасер.Прочитать() Цикл  
			Если ДанныеДокументаСтруктура.ТипДокумента = "КорректировочныйСчетФактура" Тогда
				Если Пасер.Имя = "СтТовБезНДС"
					И Пасер.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
					Если Пасер.ИмяАтрибута(2) = "СтоимУм" Тогда
						НоваяСтрокаТаблицаФайлов.УвеличениеЭДО = 0;
						НоваяСтрокаТаблицаФайлов.УменьшениеЭДО = Пасер.ЗначениеАтрибута(2);
					Иначе
						НоваяСтрокаТаблицаФайлов.УвеличениеЭДО = Пасер.ЗначениеАтрибута(2);
						НоваяСтрокаТаблицаФайлов.УменьшениеЭДО = 0;
					КонецЕсли;
				КонецЕсли;
				Если Пасер.Имя = "СумНалРазн"
					И Пасер.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
					Путь = "СумНалРазн";
				КонецЕсли;
				
				Если Пасер.Имя = "СумУм"
					И Путь = "СумНалРазн" Тогда
					НоваяСтрокаТаблицаФайлов.НДСУвеличениеЭДО = 0;
					НоваяСтрокаТаблицаФайлов.НДСУменьшениеЭДО = Пасер.Значение;
					Путь = "";
				ИначеЕсли Пасер.Имя = "СумУв"
					И Путь = "СумНалРазн" Тогда
					НоваяСтрокаТаблицаФайлов.НДСУвеличениеЭДО = Пасер.Значение;
					НоваяСтрокаТаблицаФайлов.НДСУменьшениеЭДО = 0;
					Путь = "";
				КонецЕсли;   
				НоваяСтрокаТаблицаФайлов.НомерКоррЭДО = ДанныеДокументаСтруктура.ДатаДокумента;
				НоваяСтрокаТаблицаФайлов.ДатаКоррЭДО = ДанныеДокументаСтруктура.НомерДокумента;
			ИначеЕсли ДанныеДокументаСтруктура.ТипДокумента = "СчетФактура" Тогда 
				Если Пасер.Имя = "СумНал"
					И Пасер.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
					Путь = "СумНал";
				КонецЕсли; 
				Если Пасер.Имя = "#text"
					И Путь = "СумНал"
					И Пасер.Значение <> "без акциза" Тогда
					НоваяСтрокаТаблицаФайлов.СуммаНДСЭДО = Число(Пасер.Значение);
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		НоваяСтрокаТаблицаФайлов.ДатаСФЭДО = ДанныеДокументаСтруктура.ДатаДокумента;
		НоваяСтрокаТаблицаФайлов.НомерСФЭДО = ДанныеДокументаСтруктура.НомерДокумента;
		
	КонецЦикла;
   
КонецПроцедуры  
