	|		ВТ_Этапы.Аналитика1 КАК Аналитика1,
	|		ВТ_Этапы.Аналитика2 КАК Аналитика2,
	|		ВТ_Этапы.Аналитика3 КАК Аналитика3,
	|		ВТ_Этапы.Аналитика4 КАК Аналитика4,
	|		ВТ_Этапы.Аналитика5 КАК Аналитика5,
	|		ВТ_Этапы.Аналитика6 КАК Аналитика6
	|	ИЗ
	|		Документ.ПланЗакупок.ПланОплаты КАК ВТ_Этапы
	|	ГДЕ
	|		ВТ_Этапы.Ссылка = &Ссылка
	|		И НЕ ВТ_Этапы.Замещен
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_Этапы.Ссылка,
	|		ВТ_Этапы.ПроцентПлатежа,
	|		ВТ_Этапы.ДатаПлатежа,
	|		ВТ_Этапы.ДатаПоступления,
	|		ВТ_Этапы.СуммаПлатежа,
	|		ВТ_Этапы.СтатьяБюджета,
	|		ВТ_Этапы.Аналитика1,
	|		ВТ_Этапы.Аналитика2,
	|		ВТ_Этапы.Аналитика3,
	|		ВТ_Этапы.Аналитика4,
	|		ВТ_Этапы.Аналитика5,
	|		ВТ_Этапы.Аналитика6
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПланЗакупокПланОплаты.Ссылка,
	|		ПланЗакупокПланОплаты.ПроцентПлатежа,
	|		ПланЗакупокПланОплаты.ДатаПлатежа,
	|		ПланЗакупокПланОплаты.ДатаПоступления,
	|		-СУММА(ПланЗакупокПланОплаты.СуммаПлатежа),
	|		ПланЗакупокПланОплаты.СтатьяБюджета,
	|		ПланЗакупокПланОплаты.Аналитика1,
	|		ПланЗакупокПланОплаты.Аналитика2,
	|		ПланЗакупокПланОплаты.Аналитика3,
	|		ПланЗакупокПланОплаты.Аналитика4,
	|		ПланЗакупокПланОплаты.Аналитика5,
	|		ПланЗакупокПланОплаты.Аналитика6
	|	ИЗ
	|		Документ.ПланЗакупок.ПланОплаты КАК ПланЗакупокПланОплаты
	|	ГДЕ
	|		НЕ ПланЗакупокПланОплаты.Замещен
	|		И ПланЗакупокПланОплаты.ДатаПоступления МЕЖДУ &ЗамещенныйНачалоПериода И &ЗамещенныйОкончаниеПериода
	|		И ПланЗакупокПланОплаты.Ссылка В
	|				(ВЫБРАТЬ
	|					ПланЗакупокЗамещенный.Ссылка
	|				ИЗ
	|					ВТ_ЗамещенныеПлпны КАК ПланЗакупокЗамещенный)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПланЗакупокПланОплаты.СтатьяБюджета,
	|		ПланЗакупокПланОплаты.Аналитика1,
	|		ПланЗакупокПланОплаты.Аналитика2,
	|		ПланЗакупокПланОплаты.Аналитика3,
	|		ПланЗакупокПланОплаты.Аналитика4,
	|		ПланЗакупокПланОплаты.Аналитика5,
	|		ПланЗакупокПланОплаты.Аналитика6,
	|		ПланЗакупокПланОплаты.ДатаПоступления,
	|		ПланЗакупокПланОплаты.ВариантОтсчета,
	|		ПланЗакупокПланОплаты.ВариантОплаты,
	|		ПланЗакупокПланОплаты.ДатаПлатежа,
	|		ПланЗакупокПланОплаты.Ссылка,
	|		ПланЗакупокПланОплаты.ПроцентПлатежа) КАК ВТ_ЭтапыВложенные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЭтапыВложенные.СтатьяБюджета,
	|	ВТ_ЭтапыВложенные.ДатаПлатежа,
	|	ВТ_ЭтапыВложенные.Аналитика5,
	|	ВТ_ЭтапыВложенные.Аналитика6,
	|	ВТ_ЭтапыВложенные.Аналитика1,
	|	ВТ_ЭтапыВложенные.Документ,
	|	ВТ_ЭтапыВложенные.ДатаПоступления,
	|	ВТ_ЭтапыВложенные.Аналитика2,
	|	ВТ_ЭтапыВложенные.Аналитика3,
	|	ВТ_ЭтапыВложенные.Аналитика4,
	|	ВТ_ЭтапыВложенные.ПроцентОплат";
	
	Если ТипОбъекта = Тип("ДанныеФормыСтруктура")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект."+Документы.ПланЗакупок.ПустаяСсылка().Метаданные().Имя) Тогда   
		ПараметрыЗапроса = Новый Структура("Дата, ВидПлана, НачалоПериода, ОкончаниеПериода, Назначение, СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, ЦФО, Проект, Организация, МестоПоставки, Менеджер, Приоритет, Партнер, Соглашение"); 
		ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	Иначе
		ПараметрыЗапроса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "Дата, ВидПлана, НачалоПериода, ОкончаниеПериода, Назначение, СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, ЦФО, Проект, Организация, МестоПоставки, Менеджер, Приоритет, Партнер, Соглашение");
	КонецЕсли;  
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр("Замещенный"+КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Если ТипОбъекта = Тип("ДанныеФормыСтруктура")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект."+Документы.ПланЗакупок.ПустаяСсылка().Метаданные().Имя) Тогда
		// Объект или Форма
		РеквизитыДокумента = Объект;       
		СвойстваЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВидПлана, "ДетализацияСтатейБюджета, ЗаполнятьСкладВТЧ");
		
		Коллекция = Объект.Товары.Выгрузить();   
		
		Сч = 0;
		Пока Сч < Коллекция.Колонки.Количество() Цикл
			Если Коллекция.Колонки[Сч].ТипЗначения = Новый ОписаниеТипов 
				ИЛИ Коллекция.Колонки[Сч].ТипЗначения = Новый ОписаниеТипов("ОписаниеТипов") Тогда
				Коллекция.Колонки.Удалить(Сч);	 
			Иначе
				Сч = Сч + 1;	
			КонецЕсли;
		КонецЦикла; 
		
		Если Не СвойстваЗаполнения.ДетализацияСтатейБюджета ИЛИ СвойстваЗаполнения.ЗаполнятьСкладВТЧ Тогда
			Для Каждого Потребность Из Коллекция Цикл          
				Если Не СвойстваЗаполнения.ДетализацияСтатейБюджета Тогда
					ЗаполнитьЗначенияСвойств(Потребность, Объект, "СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6"); 
				КонецЕсли;           
				Если НЕ СвойстваЗаполнения.ЗаполнятьСкладВТЧ Тогда
					ЗаполнитьЗначенияСвойств(Потребность, Объект, "Склад");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;     
		
		Коллекция.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ПланЗакупок"));   
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка"); 
		
		Запрос.УстановитьПараметр("Коллекция", Коллекция); 
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Товары  ИЗ &Коллекция КАК Коллекция");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ПланЗакупок.Товары КАК Коллекция", "ВТ_Товары КАК Коллекция");  
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Коллекция.Ссылка = &Ссылка", 	"Истина");
		
		Коллекция = Объект.ПланОплаты.Выгрузить(, "ПроцентПлатежа, ДатаПлатежа, ДатаПоступления, СуммаПлатежа, Замещен, СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6");
		Коллекция.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ПланЗакупок"));
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка");  
		
		//Приведём типы
		Для Каждого СтрокаКоллекции Из Коллекция Цикл    
			Для НомерАналитики = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл    
				Если Не ЗначениеЗаполнено(СтрокаКоллекции["Аналитика"+Строка(НомерАналитики)]) Тогда   
					СтрокаКоллекции["Аналитика"+Строка(НомерАналитики)] = Неопределено;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;                 
		
		Запрос.УстановитьПараметр("КоллекцияЭтапов", Коллекция); 
		
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Этапы ИЗ &КоллекцияЭтапов КАК Коллекция");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ПланЗакупок.ПланОплаты КАК ВТ_Этапы", "ВТ_Этапы КАК ВТ_Этапы");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_Этапы.Ссылка = &Ссылка", 		"Истина");  
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Назначение", 					"Коллекция.Назначение");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Склад", 							"Коллекция.Склад");   
		
		
		Запросы.Добавить(ТекстЗапроса);
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_Товары");
	ИначеЕсли ТипОбъекта = ТипЗнч(Документы.ПланЗакупок.ПустаяСсылка()) Тогда
		// Это ссылка
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, ИменаРеквизитов);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 	"&Назначение", 
													"ВЫБОР
													|		КОГДА ВидыПланов.ЗаполнятьНазначениеВТЧ
													|			ТОГДА Коллекция.Назначение
													|		ИНАЧЕ ПланЗакупок.Назначение
													|	КОНЕЦ");     
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 	"&Склад", 
													"ВЫБОР
													|		КОГДА ВидыПланов.ЗаполнятьСкладВТЧ
													|			ТОГДА Коллекция.Склад
													|		ИНАЧЕ ПланЗакупок.Склад
													|	КОНЕЦ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 	"Документ.ПланЗакупок.Товары КАК Коллекция",
													"Документ.ПланЗакупок.Товары КАК Коллекция
													|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПланЗакупок КАК ПланЗакупок
													|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыПланов КАК ВидыПланов
													|			ПО ПланЗакупок.ВидПлана = ВидыПланов.Ссылка
													|		ПО Коллекция.Ссылка = ПланЗакупок.Ссылка ");

		Запросы.Добавить(ТекстЗапроса);                                                                             
	КонецЕсли;

	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());  
	Если МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_Номенклатура") <> Неопределено Тогда 
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_Номенклатура");
	КонецЕсли;

	Запрос.Выполнить();           
	
	Возврат ПараметрыПланирования;     
	
КонецФункции


#КонецОбласти 

#КонецОбласти 

#Область ФормаСписка

Процедура ФормаСписка_ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) экспорт
	
	//
	Если ФормыУХ.ЭлементыФормыУХУжеСозданы(Форма) Тогда
		Возврат;
	КонецЕсли;
	
//	МодифицироватьЗапросСписка(Форма);
	
	Элементы = Форма.Элементы;
	
	//
	ФормыУХ.СоздатьПолеФормы(Элементы, "Организация",, "Список.Ссылка.Организация",, Элементы.Список);
	ФормыУХ.СоздатьПолеФормы(Элементы, "ЦФО",, "Список.Ссылка.ЦФО",, Элементы.Список);
	ФормыУХ.СоздатьПолеФормы(Элементы, "Проект",, "Список.Ссылка.Проект",, Элементы.Список);
	
	Элементы.ГруппаУстановитьСтатус.Видимость = Ложь;
	Элементы.ОтборСтатус.Видимость = Ложь;
	
КонецПроцедуры

Процедура МодифицироватьЗапросСписка(Форма)
	
	// Модификация запроса
	ТекстЗапроса = Форма.Список.ТекстЗапроса;
	
	//
	ТекстДляЗамены = "Планы.Статус КАК Статус,";
	ТекстЗамены = "ЕСТЬNULL(ВЫРАЗИТЬ(СостоянияОбъектов.СостояниеОбъекта КАК Перечисление.СостоянияСогласования), ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)) КАК Статус,";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстДляЗамены, ТекстЗамены);
	
	ТекстЗапроса = ТекстЗапроса + "
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних(, Объект ССЫЛКА Документ.ПланЗакупок) КАК СостоянияОбъектов
	|		ПО (СостоянияОбъектов.Объект = Планы.Ссылка)";
	
	//
	Форма.Список.ТекстЗапроса = ТекстЗапроса;
	
КонецПроцедуры

#КонецОбласти 

#КонецОбласти 

#Область СобытияМодуляОбъекта

// ОбработкаПроверкиЗаполнения
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты, Объект, МассивНепроверяемыхРеквизитов) Экспорт
	
	ЭтоНеЦПЗ = НЕ ЭтоПланированиеПотребностей(Объект.ФормированиеПотребностейПланомЗакупок);
	
	МассивНепроверяемыхРеквизитов.Добавить("СценарийБюджетирования");
	МассивНепроверяемыхРеквизитов.Добавить("СтатьяБюджетов");
	МассивНепроверяемыхРеквизитов.Добавить("СтатьяБюджетовОплат");
	МассивНепроверяемыхРеквизитов.Добавить("СтатьяБюджетовОплатКредит");
	
	Если ЭтоНеЦПЗ ИЛИ Объект.ВидБюджетаПланирования.Пустая() Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СтатьяБюджета"); 
		МассивНепроверяемыхРеквизитов.Добавить("Товары.СтатьяБюджета"); 
	Иначе
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидПлана, "ДетализацияСтатейБюджета") = Истина Тогда 
			МассивНепроверяемыхРеквизитов.Добавить("СтатьяБюджета");
		Иначе
			МассивНепроверяемыхРеквизитов.Добавить("Товары.СтатьяБюджета");	
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоНеЦПЗ ИЛИ Не Объект.ОтражаетсяВБюджетированииОплаты Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СтатьяБюджетаОплат");
	КонецЕсли;
	
	Если ЭтоНеЦПЗ ИЛИ Не Объект.ОтражаетсяВБюджетированииОплатыКредит Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СтатьяБюджетаОплатКредит");
	КонецЕсли;
	
	Если ЭтоНеЦПЗ Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Приоритет");
		МассивНепроверяемыхРеквизитов.Добавить("МестоПоставки");
		МассивНепроверяемыхРеквизитов.Добавить("Организация");
		МассивНепроверяемыхРеквизитов.Добавить("ЦФО");
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Склад");
		МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
		
		//
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Номенклатура");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область МодульМенеджера

// Процедура инициализации данных документа для УХ
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено, Запрос, ТекстыЗапроса) Экспорт
	
	//ЗаполнитьПараметрыИнициализации
	СтруктураРеквизитов = Новый Структура("Периодичность, Приоритет, Организация, МестоПоставки, Проект, Менеджер, Контрагент, ДоговорСПокупателем, ЦФО, Проект, СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, СтатьяБюджетаОплат, СтатьяБюджетаОплатКредит, ДоговорКонтрагента, ФормированиеПотребностейПланомЗакупок");
	СтруктураРеквизитов.ДоговорСПокупателем = "ДоговорКонтрагента";
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, СтруктураРеквизитов);
	Для Каждого КлючЗначение Из Реквизиты Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	//
	Запрос.УстановитьПараметр("ЭтоПланированиеПотребностей", ЭтоПланированиеПотребностей(Запрос.Параметры.ФормированиеПотребностейПланомЗакупок));
	
	Запрос.УстановитьПараметр("Статус",ДокументСсылка.Статус);
	//Ключи
	АналитикаСтруктуры = РегистрыСведений.АналитикаПланированияСтруктуры.ЗначениеКлючаАналитики(Реквизиты);
	АналитикаСтатейБюджетов = РегистрыСведений.АналитикаПланированияСтатейБюджетов.ЗначениеКлючаАналитики(Реквизиты);
	АналитикаПотребностей = РегистрыСведений.АналитикаПланированияПотребностей.ЗначениеКлючаАналитики(Реквизиты);
	
	//
	Запрос.УстановитьПараметр("АналитикаСтруктуры", 		АналитикаСтруктуры);
	Запрос.УстановитьПараметр("АналитикаСтатейБюджетов", 	АналитикаСтатейБюджетов);
	Запрос.УстановитьПараметр("АналитикаПотребностей",		АналитикаПотребностей);
	
	Запрос.УстановитьПараметр("ОтражаетсяВБюджетировании", Ложь);
	Запрос.УстановитьПараметр("ОтражаетсяВБюджетированииОплаты", Ложь);
	Запрос.УстановитьПараметр("ОтражаетсяВБюджетированииОплатыКредит", Ложь);

	// Скорректировать запрос для рн.ПланыЗакупок
	СкорректироватьЗапросРНПланыЗакупок(ТекстыЗапроса);
	
	// Планы закупок по категориям
	ТекстЗапросаТаблицаПланыЗакупокПоКатегориям(Запрос, ТекстыЗапроса, Регистры);
	
	//
	ТекстЗапросаТаблицаПотребностиВНоменклатуре(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаОперативныйПлан(Запрос, ТекстыЗапроса, Регистры);
	
КонецПроцедуры

Процедура ОтразитьДвижения(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	ОтразитьПланЗакупокПоКатегориям(ДополнительныеСвойства, Движения, Отказ);
	ОтразитьПотребностиВНоменклатуре(ДополнительныеСвойства, Движения, Отказ);
	ОтразитьПланированиеПотребностей(ДополнительныеСвойства, Движения, Отказ);
	ОтразитьОперацииБюджетов(ДополнительныеСвойства, Движения, Отказ);   
	ОтразитьАналитикиБюджетов(ДополнительныеСвойства, Движения, Отказ);   
	
КонецПроцедуры

