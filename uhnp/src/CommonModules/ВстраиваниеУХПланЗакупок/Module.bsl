Процедура ОбновитьФормированиеПотребностейПланомЗакупок() Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СценарииТоварногоПланирования.Ссылка КАК Ссылка,
		|	СценарииТоварногоПланирования.РежимФормированияПотребностейПланомЗакупок КАК РежимФормированияПотребностейПланомЗакупок,
		|	ПланЗакупок.Ссылка КАК Документ,
		|	СценарииТоварногоПланирования.ФормированиеПотребностейПланомЗакупок КАК ФормированиеПотребностейПланомЗакупок
		|ИЗ
		|	Документ.ПланЗакупок КАК ПланЗакупок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СценарииТоварногоПланирования КАК СценарииТоварногоПланирования
		|		ПО ПланЗакупок.Сценарий = СценарииТоварногоПланирования.Ссылка
		|ГДЕ
		|	СценарииТоварногоПланирования.ФормированиеПотребностейПланомЗакупок";
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
			
			ПланЗакупокОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();                         
			
			ПланЗакупокОбъект.ФормированиеПотребностейПланомЗакупок = (ВыборкаДетальныеЗаписи.ФормированиеПотребностейПланомЗакупок);     
			
			Для Каждого Потребность Из ПланЗакупокОбъект.Товары Цикл        
				ЗаполнитьЗначенияСвойств(Потребность, ПланЗакупокОбъект, "МестоПоставки, Склад, СтатьяБюджета, "+АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1"));  
			КонецЦикла;		  
			
			Склады = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПланЗакупокОбъект.Товары.ВыгрузитьКолонку("МестоПоставки"), "Склад"); 
			Для Каждого Потребность Из ПланЗакупокОбъект.Товары Цикл    
				Если Не ЗначениеЗаполнено(Потребность.Склад) Тогда
					Потребность.Склад 			= Склады.Получить(Потребность.МестоПоставки);       
				КонецЕсли;
			КонецЦикла;
			
			ПланЗакупокОбъект.ЗаполнятьПланОплат = Истина;
			Если ПланЗакупокОбъект.ФормированиеПотребностейПланомЗакупок И ПланЗакупокОбъект.ЭтапыГрафикаОплаты.Количество()=0 Тогда
				ПланЗакупокОбъект.ЭтапыГрафикаОплаты.Очистить();                
				ЭтапГрафикаОплаты = ПланЗакупокОбъект.ЭтапыГрафикаОплаты.Добавить();
				ЭтапГрафикаОплаты.ВариантОплаты = ПредопределенноеЗначение("Перечисление.ВариантыКонтроляОплатыПоставщику.ПредоплатаДоПоступления");
				ЭтапГрафикаОплаты.Сдвиг = 1;
				ЭтапГрафикаОплаты.ПроцентПлатежа = 100;
				ЭтапГрафикаОплаты.ВариантОтсчета = ПредопределенноеЗначение("Перечисление.ВариантыОтсчетаДатыПлатежа.ДоДатыОтгрузки");
			КонецЕсли;         
			ЗаполнитьПланОплат(ПланЗакупокОбъект);
			
			ПланЗакупокОбъект.ОбменДанными.Загрузка = Истина;
			ПланЗакупокОбъект.Записать(РежимЗаписиДокумента.Запись);
			
		КонецЦикла; 
		
	ЗафиксироватьТранзакцию();	
		
	Исключение       
		
		ОтменитьТранзакцию(); 
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации()+"."+"ОбновитьФормированиеПотребностейПланомЗакупок (ПланЗакупок)", 
									УровеньЖурналаРегистрации.Ошибка, 
									Метаданные.Документы.ПланЗакупок,, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;      
	
	НачатьТранзакцию();
	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПланЗакупок.Ссылка КАК Ссылка,
			|	ПланЗакупок.СтатьяБюджета КАК СтатьяБюджета,
			|	ПланЗакупок.Аналитика1 КАК Аналитика1,
			|	ПланЗакупок.Аналитика2 КАК Аналитика2,
			|	ПланЗакупок.Аналитика3 КАК Аналитика3,
			|	ПланЗакупок.Аналитика4 КАК Аналитика4,
			|	ПланЗакупок.Аналитика5 КАК Аналитика5,
			|	ПланЗакупок.Аналитика6 КАК Аналитика6,
			|	СтатьиДвиженияРесурсов.СтатьяБДР КАК СтатьяБДР
			|ИЗ
			|	Документ.ПланЗакупок КАК ПланЗакупок
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтатьиДвиженияРесурсов КАК СтатьиДвиженияРесурсов
			|		ПО ПланЗакупок.СтатьяБюджета = СтатьиДвиженияРесурсов.Ссылка
			|ГДЕ
			|	ПланЗакупок.СтатьяБюджета ССЫЛКА Справочник.СтатьиДвиженияРесурсов";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДокументОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();   
			ДокументОбъект.ВидБюджетаПланирования = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
			ДокументОбъект.СтатьяБюджета = ВыборкаДетальныеЗаписи.СтатьяБДР; 
			Если Не ЗначениеЗаполнено(ДокументОбъект.ВидБюджетаПланирования) Тогда
				ДокументОбъект.ВидБюджетаПланирования = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ДокументОбъект, ВыборкаДетальныеЗаписи, "Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6"); 
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать();
		КонецЦикла;  
		
		ЗафиксироватьТранзакцию();
		
	Исключение       
		
		ОтменитьТранзакцию(); 
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации()+"."+"ОбновитьФормированиеПотребностейПланомЗакупок (ПланЗакупок)", 
									УровеньЖурналаРегистрации.Ошибка, 
									Метаданные.Документы.ПланЗакупок,, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПереносТоварныхКатегорийВКатегорииЗакупок() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПланЗакупокТовары.ТоварнаяПозиция КАК ТоварнаяПозиция,
		|	ПланЗакупокТовары.НомерСтроки КАК НомерСтроки,
		|	ПланЗакупокТовары.Ссылка КАК Документ,
		|	КатегорииЗакупокТоварныхКатегорий.КатегорияЗакупки КАК КатегорияЗакупки
		|ИЗ
		|	Документ.ПланЗакупок.Товары КАК ПланЗакупокТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииЗакупокТоварныхКатегорий КАК КатегорииЗакупокТоварныхКатегорий
		|		ПО ПланЗакупокТовары.ТоварнаяПозиция = КатегорииЗакупокТоварныхКатегорий.ТоварнаяКатегория
		|ГДЕ
		|	ПланЗакупокТовары.ТоварнаяПозиция ССЫЛКА Справочник.ТоварныеКатегории
		|ИТОГИ ПО
		|	Документ";  
	
	Попытка 
		НачатьТранзакцию();
	
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Документ");
		
		Пока Выборка.Следующий() Цикл 
			ДокументОбъект = Выборка.Документ.ПолучитьОбъект(); 
			ДетальныеЗаписи = Выборка.Выбрать();
			Пока ДетальныеЗаписи.Следующий() Цикл  
				Строка = ДокументОбъект.Товары[ДетальныеЗаписи.НомерСтроки-1];
				Строка.ТоварнаяПозиция = ДетальныеЗаписи.КатегорияЗакупки; 
			КонецЦикла;  
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать();
		КонецЦикла;    
	
		ЗафиксироватьТранзакцию();
		
	Исключение            
		
		ОтменитьТранзакцию(); 
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации()+"."+"ПереносТоварныхКатегорийВКатегорииЗакупок (ПланЗакупок)", 
									УровеньЖурналаРегистрации.Ошибка, 
									Метаданные.Документы.ПланЗакупок,, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;	

КонецПроцедуры     

Процедура ПереносДвиженийВПланированиеПотребностей() Экспорт

	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыПланов.Утвержден);   
	Запрос.УстановитьПараметр("РежимФормированияПотребностейПланомЗакупок", Перечисления.РежимыФормированияПотребностейПланомЗакупок.РегистрируютПотребности);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПотребностиВНоменклатуре.Регистратор КАК Регистратор,
	               |	ВЫРАЗИТЬ(ПотребностиВНоменклатуре.Регистратор КАК Документ.ПланЗакупок).Статус КАК Поле1
	               |ИЗ
	               |	РегистрНакопления.ПотребностиВНоменклатуре КАК ПотребностиВНоменклатуре
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	               |		ПО ПотребностиВНоменклатуре.Регистратор = ПланированиеПотребностей.Регистратор
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(ПотребностиВНоменклатуре.Регистратор) = ТИП(Документ.ПланЗакупок)
	               //|	И ПланированиеПотребностей.Регистратор ЕСТЬ NULL
	               //|	И ВЫРАЗИТЬ(ПотребностиВНоменклатуре.Регистратор КАК Документ.ПланЗакупок).Статус = &Статус
	               |	И ВЫРАЗИТЬ(ПотребностиВНоменклатуре.Регистратор КАК Документ.ПланЗакупок).ФормированиеПотребностейПланомЗакупок
	               |	И ВЫРАЗИТЬ(ПотребностиВНоменклатуре.Регистратор КАК Документ.ПланЗакупок).Сценарий.РежимФормированияПотребностейПланомЗакупок = &РежимФормированияПотребностейПланомЗакупок
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПотребностиВНоменклатуре.Регистратор,
	               |	ВЫРАЗИТЬ(ПотребностиВНоменклатуре.Регистратор КАК Документ.ПланЗакупок).Статус"; 
				   
	Попытка 
		НачатьТранзакцию();

				  
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл    
			
			ПланЗакупокДокумент = Выборка.Регистратор.ПолучитьОбъект(); 
			ЕстьСтатьи = Ложь;
			Для Каждого Потребность Из ПланЗакупокДокумент.Товары Цикл
				Если ЗначениеЗаполнено(Потребность.СтатьяБюджета) Тогда
					ЕстьСтатьи = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьСтатьи И Не ЗначениеЗаполнено(ПланЗакупокДокумент.ВидБюджетаПланирования) Тогда
				ПланЗакупокДокумент.ВидБюджетаПланирования = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;  
				ПланЗакупокДокумент.ОбменДанными.Загрузка = Истина;
				ПланЗакупокДокумент.Записать();
			КонецЕсли; 
			Отказ = Ложь;
			ДополнительныеСвойства = Новый Структура;
			ДополнительныеСвойства.Вставить("ТаблицыДляДвижений",Новый Структура());
			
			ИнтеграцияИС.ИнициализироватьДополнительныеСвойстваДляПроведения(Выборка.Регистратор, ДополнительныеСвойства);
			ВидБюджетаЗаявки = ПланЗакупокДокумент.ВидБюджетаПланирования;
			ПараметрыОперПланирования = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджетаЗаявки); 
			ПараметрыОперПланирования.ВидБюджета = ВидБюджетаЗаявки;
			ДополнительныеСвойства.ДляПроведения.Вставить("ПараметрыОперПланирования", ПараметрыОперПланирования);
	        Документы.ПланЗакупок.ИнициализироватьДанныеДокумента(ПланЗакупокДокумент.Ссылка, ДополнительныеСвойства); 
			
			ОтразитьПланированиеПотребностей(ДополнительныеСвойства, ПланЗакупокДокумент.Движения, Отказ);

			ПланЗакупокДокумент.Движения.ПланированиеПотребностей.Записать();
			
		КонецЦикла;  
		
		ЗафиксироватьТранзакцию();
		
	Исключение            
		
		ОтменитьТранзакцию(); 
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации()+"."+"ПереносДвиженийВПланированиеПотребностей (ПланЗакупок)", 
									УровеньЖурналаРегистрации.Ошибка, 
									Метаданные.Документы.ПланЗакупок,, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;	

КонецПроцедуры

#КонецЕсли