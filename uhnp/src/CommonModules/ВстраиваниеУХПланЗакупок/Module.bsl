	ПереопределениеСобытийФормы.ПереопределитьСобытиеЭлементаФормы(Форма, Форма.Элементы.Проект,		   	"ПриИзменении", "Подключаемый_ПолеФормы_ПриИзменении");       
	
	//Склады, места поставки       
