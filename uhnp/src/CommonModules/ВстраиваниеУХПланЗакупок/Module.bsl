Процедура ОбновитьСтатьиПоВидуБюджета(Знач Форма, Знач ВидСтатьи) Экспорт
	
	Перем КлючИЗначение, ОписаниеСтатьи;   
	
	ОписаниеФормы = АналитикиСтатейБюджетовУХ.ПолучитьОписаниеФормы(Форма);
	
	Для Каждого КлючИЗначение Из ОписаниеФормы.СтатьиБюджетов Цикл  
		Если ЗначениеЗаполнено(ВидСтатьи) Тогда
			Форма.Элементы[КлючИЗначение.Ключ].ОграничениеТипа 	= ВидСтатьи.ТипЗначения; 
			Форма.Элементы[КлючИЗначение.Ключ].Видимость 		=  ВидСтатьи <> Неопределено;
			Форма.Элементы[КлючИЗначение.Ключ].КнопкаВыбора 	= Истина;   
			Форма.Элементы[КлючИЗначение.Ключ].ВыбиратьТип 		= Истина;  
		Иначе
			Форма.Элементы[КлючИЗначение.Ключ].Видимость = Ложь; 
		КонецЕсли;
	КонецЦикла;                            
	
	ПриУстановкеВидимости(Форма);

КонецПроцедуры

Процедура ЗаполнитьПланОплатНаСервере(Форма) Экспорт     
	
	Объект = Форма.Объект;
	
	Если Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;	
	ЗаполнитьПланОплат(Объект);
	
	ИмяЭлемента = "ПланОплатыСтатьяБюджета";
	ОписаниеФормы = Форма.ОписаниеФормы;
	ОписаниеСтатьи = ОписаниеФормы.СтатьиБюджетов[ИмяЭлемента];       
	
	Для Каждого ДанныеВидАналитики Из Объект.ПланОплаты Цикл         
		АналитикиСтатейБюджетовУХКлиентСервер.ЗаполнитьСведенияОВидахАналитик(ДанныеВидАналитики.СтатьяБюджета, ДанныеВидАналитики, ОписаниеСтатьи);
		АналитикиСтатейБюджетовУХКлиентСервер.НастроитьПоляВводаАналитик(Форма, ОписаниеСтатьи, ДанныеВидАналитики);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПланОплат(Знач Объект)
	
	Перем Календарь, НовСтр, ПараметрыЗаполнения, Период, ПланОплаты, ПланОплатыКопия, СуммаОплатыКраспределению, СуммаОтгрузок, СуммаПлатежей, ШаблонГрафика, ЭтапОплаты;
	
	Объект.ПланОплаты.Очистить();
	ПланОплаты = Объект.ПланОплаты.Выгрузить();
	ПланОплатыКопия = ПланОплаты.Скопировать();
	ШаблонГрафика = Объект.ЭтапыГрафикаОплаты;
	Календарь = Объект.Календарь;
	
	СуммаПлатежей = 0;
	СуммаОтгрузок = 0;
	Для каждого Период Из Объект.Товары Цикл
		
		
		ПланОплатыКопия.Очистить();
		
		СуммаОплатыКраспределению = Период.Сумма;
		
		ПараметрыЗаполнения = ЭтапыОплатыСервер.ПараметрыЗаполненияЭтаповОплаты();
		ПараметрыЗаполнения.ЭтоРасчетыСКлиентами 				= Ложь;
		ПараметрыЗаполнения.НакладнаяПоЗаказам 					= Ложь;
		ПараметрыЗаполнения.ПорядокРасчетов 					= Перечисления.ПорядокРасчетов.ПоЗаказам;
		ПараметрыЗаполнения.ЭтоЗаказ 							= Ложь;
		ПараметрыЗаполнения.ЕстьДатаПереходаПраваСобственности 	= Ложь;
		
		ПараметрыЗаполнения.Вставить("ДатаОтгрузки", 	Период.ДатаПоступления);
		ПараметрыЗаполнения.Вставить("ДатаЗаказа", 		Период.ДатаПоступления);
		ПараметрыЗаполнения.Вставить("ШаблонГрафика", 	ШаблонГрафика);
		ПараметрыЗаполнения.Вставить("Календарь", 		Календарь);
		ПараметрыЗаполнения.Вставить("СуммаОплаты", 	СуммаОплатыКраспределению);
		
		ЭтапыОплатыСервер.ЗаполнитьЭтапыОплатыДокументаПоШаблону(ПланОплатыКопия, ПараметрыЗаполнения);
		
		Для каждого ЭтапОплаты Из ПланОплатыКопия Цикл
			
			НовСтр = ПланОплаты.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,ЭтапОплаты); 
			
			НовСтр.СтатьяБюджета 	= Период.СтатьяБюджета;
			НовСтр.Аналитика1 		= Период.Аналитика1;
			НовСтр.Аналитика2 		= Период.Аналитика2;
			НовСтр.Аналитика3 		= Период.Аналитика3;
			НовСтр.Аналитика4 		= Период.Аналитика4;
			НовСтр.Аналитика5 		= Период.Аналитика5;
			НовСтр.Аналитика6 		= Период.Аналитика6;
			
			НовСтр.ДатаПоступления 	= Период.ДатаПоступления;
			
		КонецЦикла; 
		
	КонецЦикла; 

	ПланОплаты.Свернуть("ПроцентПлатежа,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6,ВариантОплаты, ДатаПлатежа, ДатаПоступления, Замещен","СуммаПлатежа, СуммаЗадолженности, СуммаОтгрузок");
	ПланОплаты.Колонки.Добавить("СуммаПлатежей");
	ПланОплаты.Сортировать("ДатаПлатежа,ДатаПоступления,СтатьяБюджета");
	
	Объект.ПланОплаты.Загрузить(ПланОплаты);

КонецПроцедуры

Функция ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц, ДляКонтроля = Ложь) Экспорт      
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ДляКонтроля = Неопределено Тогда
		ДляКонтроля = (ТипОбъекта = Тип("ДанныеФормыСтруктура"));
	КонецЕсли;
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", 				МенеджерВременныхтаблиц);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры",	Истина);
	ПараметрыПланирования.Вставить("Этап",					Перечисления.ЭтапыПланированияПотребностей.ЗаявкиСогласованные);
	ПараметрыПланирования.Вставить("ДокументПланирования",	Объект.Ссылка);
	ПараметрыПланирования.Вставить("ОбъектПланирования",	ОбъектыПланирования.ПолучитьОбъектПланирования(ПараметрыПланирования.ДокументПланирования));
	ПараметрыПланирования.Вставить("ИзменениеПоставки",		Истина);
 	ПараметрыПланирования.Вставить("ОтражатьВБюджетах", 	Истина);
	ПараметрыПланирования.Вставить("ИзменениеСтруктуры",	Истина); 
	ПараметрыПланирования.Вставить("ИзменениеПотребностей",	Истина);
	
    ПараметрыПланирования.Вставить("ВидБюджета", 			Объект.ВидБюджетаПланирования);     
	
 //	ПараметрыПланирования.Вставить("ИзменениеПотребностей", Истина);   	 
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Этап", 										 ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ОбъектПланирования", 						 ПараметрыПланирования.ОбъектПланирования);
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДвиженияДенежныхСредств", КэшируемыеПроцедурыОПК.ПустаяСтатьяДвиженияДенежныхСредств());
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДоходовИРасходов", 		 КэшируемыеПроцедурыОПК.ПустаяСтатьяДоходовИРасходов());   
	Запрос.УстановитьПараметр("ДляКонтроля", 							 	 ДляКонтроля);	  
	Запрос.УстановитьПараметр("НДС22", 										 УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22, 
																																	Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС));
	
	ТипСтатей = ПараметрыПланирования.ВидБюджета.ТипЗначения;	
	Если ТипСтатей <> Неопределено И ТипСтатей.СодержитТип(ТипЗНЧ(Справочники.СтатьиДоходовИРасходов.ПустаяСсылка())) Тогда
		СтатьяБДР = Истина;
	Иначе
		СтатьяБДР = Ложь;
	КонецЕсли;	
	Запрос.УстановитьПараметр("СтатьяБДР",СтатьяБДР);     
	
	ИменаРеквизитов = "Ссылка, Валюта, Организация, ЦФО, Проект";
	Запрос.УстановитьПараметр("ВидБюджета", ПараметрыПланирования.ВидБюджета); 
	
	Запросы = Новый Массив;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПланЗакупокЗамещенный.Ссылка КАК Ссылка,
	|	ПланЗакупокЗамещенный.ВидПлана.ЗаполнятьСкладВТЧ КАК ВидПланаЗаполнятьСкладВТЧ,
