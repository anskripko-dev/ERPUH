#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


#Область СобытияМодуляФормы

#Область ФормаДокумента

#Область СтандартныеОбработчики

// нетиповое событие документа. Вызывается перед исполнением основного кода
Процедура ПриЧтенииСозданииНаСервере(Форма) Экспорт   
	
	//
	СоздатьРеквизитыФормыДокумента(Форма);
	СоздатьЭлементыФормыДокумента(Форма);
	ПодготовитьФормуНаСервере(Форма);     
	
	ПараметрыРеквизитов = ЦентрализованныеЗакупкиФормыУХ.ПараметрыРеквизитов();   
	ПараметрыРеквизитов.ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПостоянныеКоманды", Новый ОписаниеТипов("СписокЗначений"), 
																			, НСтр("ru = 'Постоянные команды'"), Истина));
	//Аналитики
	ПараметрыРеквизитов.ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СтатьяБюджета", Метаданные.ПланыВидовХарактеристик.ВидыБюджетов.Тип, 
																			"ТоварыПоПериодам", НСтр("ru = 'Статья бюджета'"), Истина));
	Для НомерАналитики = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		ПараметрыРеквизитов.ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Аналитика"+НомерАналитики, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип, 
																				"ТоварыПоПериодам", НСтр("ru = 'Аналитика'")+НомерАналитики, Истина)); 
	КонецЦикла;
	//Унификаты
	ЦентрализованныеЗакупкиФормыУХ.ДобавитьРеквизитыЗаменыНаУнификаты(ПараметрыРеквизитов, "Объект.Товары");   
	ЦентрализованныеЗакупкиФормыУХ.ДобавитьРеквизитыЗаменыНаУнификаты(ПараметрыРеквизитов, "ТоварыПоПериодам");  
	//Добавляем реквизиты
	ЦентрализованныеЗакупкиФормыУХ.ДобавитьУдалитьРеквизитыФормы(Форма, ПараметрыРеквизитов, Истина);    
	//Унификаты
	ЦентрализованныеЗакупкиФормыУХ.УстановитьНастройкиУнификатовФормы(Форма, "Товары", "Объект.Товары", "ТоварнаяПозиция", "Характеристика", "Упаковка", "ТоварыНоменклатураПриИзменении");
	ЦентрализованныеЗакупкиФормыУХ.УстановитьНастройкиУнификатовФормы(Форма, "ТоварыПоПериодам", "ТоварыПоПериодам", "ТоварнаяПозиция", "Характеристика", "Упаковка", "ТоварыПоПериодамНоменклатураПриИзменении");
	ЦентрализованныеЗакупкиФормыУХ.ДобавитьЭлементыЗамены(Форма, Форма.Элементы.Товары, Форма.Элементы.ТоварыНоменклатураТипНоменклатуры);      
	ЦентрализованныеЗакупкиФормыУХ.ДобавитьЭлементыЗамены(Форма, Форма.Элементы.ТоварыПоПериодам, Форма.Элементы.ГруппаФиксацияСлева);
	//Аналитики	
	ПриЧтенииСозданииНаСервереСтатьяИАналитики(Форма);     
	
	// Согласование и т.д.
	//ДействияСогласованиеУХСервер.НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта(Форма);
	
	ВстраиваниеУХПланЗакупок.ОбновитьСтатьиПоВидуБюджета(Форма, Форма.Объект.ВидБюджетаПланирования);  
	
	ПриУстановкеВидимости(Форма);    
	
	ПриЧтенииСозданииДобавитьКоманды(Форма, Форма.Элементы.ТоварыПоПериодам.КоманднаяПанель, 
										Форма.Элементы.ТоварыПоПериодамПодобратьТовары, "СкопироватьПоСтроке", 
										НСтр("ru = 'Копировать по строке'"));
	
	ЦентрализованныеЗакупкиФормыУХ.УстановитьУсловноеОформлениеУнификатов(Форма, "Товары");  
	ЦентрализованныеЗакупкиФормыУХ.УстановитьУсловноеОформлениеУнификатов(Форма, "ТоварыПоПериодам");    
	
	Если Форма.Объект.Ссылка.Пустая() Тогда
		ВстраиваниеУХПланЗакупок.ИспользуемыеВидыБюджетовЗакупок(Форма);    
	КонецЕсли; 
	
	Форма.Элементы.ТоварыПоПериодамХарактеристика.УстановитьДействие("ПриИзменении", "ТоварыПоПериодамХарактеристикаПриИзменении");   
	
	Если ЭтоПланированиеПотребностей(Форма.Объект.ФормированиеПотребностейПланомЗакупок) Тогда 
		Для Каждого СтрокаТовары Из Форма.Объект.Товары Цикл  
			Если (ТипЗнч(СтрокаТовары.ТоварнаяПозиция) = Тип("СправочникСсылка.ТоварныеКатегории") ИЛИ 
				ТипЗнч(СтрокаТовары.ТоварнаяПозиция) = Тип("СправочникСсылка.КатегорииЗакупок")) Тогда
				СтрокаТовары.ТоварнаяКатегория = СтрокаТовары.ТоварнаяПозиция;
			КонецЕсли;	
		КонецЦикла; 
	КонецЕсли;     
	
КонецПроцедуры

Процедура ПриЧтенииСозданииДобавитьКоманды(Знач Форма, Знач Родитель, Знач РазместитьПеред, Знач ИмяКоманды, Знач Заголовок)
	
	Перем Кнопка, Команда;
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = Форма.Команды.Добавить(ИмяКоманды);
		Команда.Действие  = "Подключаемый_Команда";
		Команда.Заголовок = Заголовок;  
		Команда.Подсказка = НСтр("ru = 'Копировать значение по строке вправо'");   
		Команда.Картинка  = БиблиотекаКартинок.ПереместитьВправо;
	КонецЕсли;          
	
	Если Форма.Элементы.Найти(ИмяКоманды) = Неопределено Тогда
		Кнопка = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Родитель);
		Кнопка.ИмяКоманды 	= ИмяКоманды;
		Кнопка.Вид 			= ВидКнопкиФормы.ОбычнаяКнопка;
		Кнопка.Отображение 	= ОтображениеКнопки.Картинка;
		Кнопка.Заголовок 	= Заголовок; 
		Кнопка.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
		Если РазместитьПеред <> Неопределено Тогда
			Форма.Элементы.Переместить(Кнопка, Родитель, РазместитьПеред);      
		КонецЕсли;
	Иначе
		Форма.Элементы[ИмяКоманды].Заголовок = Заголовок;	
	КонецЕсли;         
	
	Если Форма.ПостоянныеКоманды.НайтиПоЗначению(ИмяКоманды) = Неопределено Тогда
		Форма.ПостоянныеКоманды.Добавить(Команда.Имя, "ВстраиваниеУХПланЗакупокКлиент.ОбработкаКоманды");
	КонецЕсли;

КонецПроцедуры

Процедура ПриЧтенииСозданииНаСервереСтатьяИАналитики(Знач Форма) Экспорт
	
	Перем МассивОписанийСтатей, ПараметрыПоляВводаШапки; 
	
	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);
	
	МассивОписанийСтатей = Новый Массив;  
	
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиОбъектаВПоляхФормы(МассивОписанийСтатей, 
								"СтатьяБюджета", "СтатьяБюджета", 
								"Аналитика%1", "Аналитика%1",
								ФормыУХ.РазместитьВГруппеСтрокой(Форма.Элементы.ГруппаОтражатьВБюджетировании));   
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиОбъектаВПоляхФормы(МассивОписанийСтатей, 
								"СтатьяБюджетаОплат", "СтатьяБюджетаОплат", 
								"АналитикаОплат%1", "АналитикаОплат%1",
								ФормыУХ.РазместитьВГруппеСтрокой(Форма.Элементы.ГруппаОтражатьВБюджетировании)); 
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиОбъектаВПоляхФормы(МассивОписанийСтатей, 
								"СтатьяБюджетаОплатКредит", "СтатьяБюджетаОплатКредит", 
								"АналитикаОплатКредит%1", "АналитикаОплатКредит%1",
								ФормыУХ.РазместитьВГруппеСтрокой(Форма.Элементы.ГруппаОтражатьВБюджетировании)); 


	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(
								МассивОписанийСтатей,
								"ТоварыПоПериодам", "ТоварыПоПериодам",
								"СтатьяБюджета", "ТоварыПоПериодамСтатьяБюджета",
								"Аналитика%1", "ТоварыПоПериодамАналитика%1",
								ФормыУХ.РазместитьВГруппеСтрокой(Форма.Элементы.ПланыДокументаГруппаСтатьяИАналитики));   
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТабличнойЧастиВТаблицеФормы(
								МассивОписанийСтатей,
								"Товары", "Товары",
								"СтатьяБюджета", "ТоварыСтатьяБюджета",
								"Аналитика%1", "ТоварыАналитика%1",
								ФормыУХ.РазместитьВГруппеСтрокой(Форма.Элементы.ТоварыДокументаГруппаСтатьяИАналитики));   
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТабличнойЧастиВТаблицеФормы(
								МассивОписанийСтатей,
								"ПланОплаты", "ПланОплаты",
								"СтатьяБюджета", "ПланОплатыСтатьяБюджета",
								"Аналитика%1", "ПланОплатыАналитика%1",
								ФормыУХ.РазместитьВГруппеСтрокой(Форма.Элементы.ПланОплатыГруппаСтатьяИАналитики));
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(Форма, МассивОписанийСтатей, ПараметрыПоляВводаШапки);

КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	ПриУстановкеВидимости(Форма);
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(Форма);
	
КонецПроцедуры

Процедура ПередЗаписьюНаСервереНачало(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи) Экспорт  
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект; 
	ОписаниеФормы = Форма.ОписаниеФормы;   
	
	Если Объект.ВидПлана.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить вид плана'"),,СтрШаблон("Объект.ВидПлана"),, Отказ);
		Возврат;
	КонецЕсли;
	
	СвойстваПлана = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВидПлана, "ЗаполнятьСклад, ЗаполнятьСкладВТЧ");  
	
	Если Не Объект.ВидБюджетаПланирования.Пустая() И Объект.ФормированиеПотребностейПланомЗакупок Тогда 
		Если Элементы.Найти("ТоварыПоПериодамСтатьяБюджета") <> Неопределено И Элементы.ТоварыПоПериодамСтатьяБюджета.Видимость Тогда
			Для Каждого СтрокаТовары Из Форма.ТоварыПоПериодам Цикл   
				Если Не ЗначениеЗаполнено(СтрокаТовары.СтатьяБюджета) Тогда  
					ТекстСообщения = НСтр("ru = 'Необходимо заполнить статью бюджета'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,СтрШаблон("ТоварыПоПериодам[%1].СтатьяБюджета", СтрокаТовары.ПолучитьИдентификатор()),, Отказ);
				КонецЕсли;
			КонецЦикла; 
		ИначеЕсли Элементы.Найти("СтатьяБюджета") <> Неопределено И Элементы.СтатьяБюджета.Видимость Тогда  
			Если Не ЗначениеЗаполнено(Объект.СтатьяБюджета) Тогда  
				ТекстСообщения = НСтр("ru = 'Необходимо заполнить статью бюджета'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,СтрШаблон("Объект.СтатьяБюджета"),, Отказ);
			КонецЕсли;
		КонецЕсли;     
		Если СвойстваПлана.ЗаполнятьСклад ИЛИ СвойстваПлана.ЗаполнятьСкладВТЧ Тогда    
			Если СвойстваПлана.ЗаполнятьСкладВТЧ Тогда 
				Для Каждого СтрокаТовары Из Форма.ТоварыПоПериодам Цикл   
					Если ТипЗнч(СтрокаТовары.Номенклатура) = Тип("СправочникСсылка.Номенклатура") И ТипНоменклатурыТовар(СтрокаТовары) И Не ЗначениеЗаполнено(СтрокаТовары.Склад) Тогда  
						ТекстСообщения = НСтр("ru = 'Необходимо заполнить склад'");
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,СтрШаблон("ТоварыПоПериодам[%1].Склад", СтрокаТовары.ПолучитьИдентификатор()),, Отказ);
					КонецЕсли;
				КонецЦикла;	
			Иначе  
				Если Не ЗначениеЗаполнено(Объект.Склад) Тогда  
					ТекстСообщения = НСтр("ru = 'Необходимо заполнить склад'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,СтрШаблон("Объект.Склад"),, Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Отказ Тогда //Не нужны лишние уведомления при копировании ТЧ
			Возврат;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ТипНоменклатурыТовар(Знач СтрокаТовары)
	
	Возврат  (СтрокаТовары.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар) ИЛИ 
	(СтрокаТовары.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.МногооборотнаяТара) ИЛИ
	(СтрокаТовары.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор);

КонецФункции

Процедура ПередЗаписьюНаСервере(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи) Экспорт 
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект; 
	ОписаниеФормы = Форма.ОписаниеФормы;     
	
	ПередЗаписьюПланаОбновитьТабличнуюЧасть(Объект, ТекущийОбъект);
	
	КонтрольВидаПланаЗакупок(Форма, Отказ);

КонецПроцедуры

Процедура ПередЗаписьюПланаОбновитьТабличнуюЧасть(Знач Объект, Знач ТекущийОбъект)
	
	Перем ВидПлана, ДетализацияСтатейБюджета, Потребность, СвойстваПлана, ЭтоПланированиеПотребностей;
	
	ВидПлана = Объект.ВидПлана;         
	Если ЗначениеЗаполнено(ВидПлана) Тогда
		СвойстваПлана = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидПлана, "ЗаполнятьСклад, ЗаполнятьСкладВТЧ");  
	Иначе
		СвойстваПлана = Новый Структура("ЗаполнятьСклад, ЗаполнятьСкладВТЧ", Ложь, Ложь);
	КонецЕсли;
	
	ЭтоПланированиеПотребностей = ЭтоПланированиеПотребностей(Объект.ФормированиеПотребностейПланомЗакупок);   
	Если ЭтоПланированиеПотребностей Тогда
		ДетализацияСтатейБюджета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидПлана, "ДетализацияСтатейБюджета");	
		Для Каждого Потребность Из ТекущийОбъект.Товары Цикл        
			Если Не ДетализацияСтатейБюджета Тогда
				ЗаполнитьЗначенияСвойств(Потребность, ТекущийОбъект, "СтатьяБюджета, "+АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1"));  
			КонецЕсли;  
			Если Не СвойстваПлана.ЗаполнятьСкладВТЧ Тогда
				Потребность.МестоПоставки 	= Объект.МестоПоставки;   
				Потребность.Склад 			= Объект.Склад;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПриУстановкеВидимости(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект; 
	ОписаниеФормы = Форма.ОписаниеФормы; 
	ВидБюджета = Объект.ВидБюджетаПланирования;  
	ВидПлана = Объект.ВидПлана;         
	Если ЗначениеЗаполнено(ВидПлана) Тогда
		СвойстваПлана = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидПлана, "ЗаполнятьСклад, ЗаполнятьСкладВТЧ");  
	Иначе
		СвойстваПлана = Новый Структура("ЗаполнятьСклад, ЗаполнятьСкладВТЧ", Ложь, Ложь);
	КонецЕсли;
	
	Если НЕ ФормыУХ.ЭлементыФормыУХУжеСозданы(Форма) Тогда
		Возврат ;
	КонецЕсли;
	
	//
	ЭтоПланированиеПотребностей = ЭтоПланированиеПотребностей(Объект.ФормированиеПотребностейПланомЗакупок);    
	ДетализацияСтатейБюджета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидПлана, "ДетализацияСтатейБюджета");
	
	// элементы шапки
	Элементы.Организация.Видимость = ЭтоПланированиеПотребностей;
	Элементы.ЦФО.Видимость = ЭтоПланированиеПотребностей;
	Элементы.Проект.Видимость = ЭтоПланированиеПотребностей;
	Элементы.МестоПоставки.Видимость = Ложь;
	Элементы.Приоритет.Видимость = Ложь;
	Элементы.Менеджер.Видимость = Ложь;
	
	//
	ЭлементыКонтроля = КонтрольУХ.ИменаРеквизитовЭлементовКонтроля();
	
	Элементы[ЭлементыКонтроля.ИмяСтраницы].Видимость = ЭтоПланированиеПотребностей;
	Элементы[ЭлементыКонтроля.ИмяКоманды].Видимость = ЭтоПланированиеПотребностей;
	
	// стандартные реквизиты Статей невидны никогда
	Элементы.СтатьяБюджетов.Видимость = Ложь;
	Элементы.СтатьяБюджетовОплатыДоОтгрузки.Видимость = Ложь;
	Элементы.СтатьяБюджетовОплатыПослеОтгрузки.Видимость = Ложь;
	
	//
	ФлагВидимости = ЭтоПланированиеПотребностей; 
	
	Если ОписаниеФормы <> Неопределено Тогда
		Для Каждого КлючИЗначение ИЗ Форма.ОписаниеФормы.СтатьиБюджетов Цикл    
			
			ОписаниеСтатьи = КлючИЗначение.Значение;	
			Элементы[КлючИЗначение.Ключ].Видимость = ЗначениеЗаполнено(ВидБюджета) И 
													ДетализацияСтатейБюджета <> Неопределено И ФлагВидимости И 
													((ДетализацияСтатейБюджета И ОписаниеСтатьи.ЭтоТаблица) ИЛИ 
													(Не ДетализацияСтатейБюджета И Не ОписаниеСтатьи.ЭтоТаблица)); 
			Элементы[КлючИЗначение.Ключ].АвтоОтметкаНезаполненного = Элементы[КлючИЗначение.Ключ].Видимость; 
			
			Для ИндексАналитики = 1 По КлючИЗначение.Значение.КолвоАналитик Цикл     
				Если ОписаниеСтатьи.ЭтоТаблица Тогда
					АналитикаИспользуется = Истина;
				Иначе
					ПолеВидаАналитики = СтрШаблон(ОписаниеСтатьи.Аналитики.ВидАналитикиИмяРеквизита, ИндексАналитики);
					ДанныеВидАналитики = АналитикиСтатейБюджетовУХКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, КлючИЗначение.Значение.Аналитики.ВидАналитикиПуть);
					АналитикаИспользуется = ЗначениеЗаполнено(ДанныеВидАналитики[ПолеВидаАналитики]);  
				КонецЕсли;
				
				Для Каждого КлючЗначение Из ОписаниеСтатьи.ЭлементыФормы Цикл
					ОписаниеЭлементаСтатья = КлючЗначение.Значение;
					ОписаниеЭлементаАналитики = ОписаниеЭлементаСтатья.ЭлементыАналитики[ИндексАналитики-1];    
					Элемент = Форма.Элементы.Найти(ОписаниеЭлементаАналитики.ИмяЭлемента);
					
					Если Элемент <> Неопределено Тогда  
						Элемент.Видимость = Элементы[КлючИЗначение.Ключ].Видимость И АналитикаИспользуется;	
					КонецЕсли;           
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
	ФлагВидимости = ЭтоПланированиеПотребностей И Объект.ОтражаетсяВБюджетированииОплаты;
	Элементы.СтатьяБюджетаОплат.Видимость = Элементы.СтатьяБюджетаОплат.Видимость И ФлагВидимости;   
	Для ИндексАналитики = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		Элементы[СтрШаблон("АналитикаОплат%1", ИндексАналитики)].Видимость = Элементы[СтрШаблон("АналитикаОплат%1", ИндексАналитики)].Видимость И ФлагВидимости;
	КонецЦикла;
	//
	ФлагВидимости = ЭтоПланированиеПотребностей И Объект.ОтражаетсяВБюджетированииОплатыКредит;
	Элементы.СтатьяБюджетаОплатКредит.Видимость = Элементы.СтатьяБюджетаОплатКредит.Видимость И ФлагВидимости;   
	Для ИндексАналитики = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		Элементы[СтрШаблон("АналитикаОплатКредит%1", ИндексАналитики)].Видимость = Элементы[СтрШаблон("АналитикаОплатКредит%1", ИндексАналитики)].Видимость И ФлагВидимости;
	КонецЦикла;   
	
	Если ЭтоПланированиеПотребностей Тогда
		Элементы.ТоварыПоПериодамМестоПоставки.Видимость 	= СвойстваПлана.ЗаполнятьСкладВТЧ; 
		Элементы.ТоварыМестоПоставки.Видимость 				= СвойстваПлана.ЗаполнятьСкладВТЧ;	
		Элементы.МестоПоставки.Видимость 					= СвойстваПлана.ЗаполнятьСклад И Не Элементы.ТоварыПоПериодамМестоПоставки.Видимость;  
		Элементы.ТоварыПоПериодамСклад.Видимость 			= СвойстваПлана.ЗаполнятьСкладВТЧ;    
		Элементы.Склад.Видимость 							= СвойстваПлана.ЗаполнятьСклад И Не Элементы.ТоварыПоПериодамСклад.Видимость; 
	Иначе
		Элементы.ТоварыПоПериодамМестоПоставки.Видимость 	= Ложь; 
		Элементы.ТоварыМестоПоставки.Видимость 				= Ложь;	
		Элементы.МестоПоставки.Видимость 					= Ложь;  
	КонецЕсли;      
	
	//
	Элементы.ПланОплатыСуммаПлатежей.Видимость 			= Не ЭтоПланированиеПотребностей;       
	Элементы.ПланОплатыСуммаОтгрузок.Видимость 			= Не ЭтоПланированиеПотребностей;
	Элементы.ПланОплатыСуммаЗадолженности.Видимость 	= Не ЭтоПланированиеПотребностей; 
	Элементы.ПланОплатыГруппаКомментарий.Видимость 		= Не ЭтоПланированиеПотребностей; 
	
	Элементы.ПланОплаты.ТолькоПросмотр 					= ЭтоПланированиеПотребностей; 
	Элементы.ПланОплаты.ИзменятьСоставСтрок				= Не ЭтоПланированиеПотребностей;
	
	//
	Элементы.СтатьяБюджетаОплат.Заголовок = 
		?(Объект.ОтражаетсяВБюджетированииОплаты И Не Объект.ОтражаетсяВБюджетированииОплатыКредит,
			НСтр("ru = 'Оплаты'"),
			НСтр("ru = 'Оплаты (до поступления)'")); 
			
	СкрытьПанельСогласования(Элементы);     
	
	УстановитьВидимостьЭлементаУнификата(Форма.Элементы.Товары, "_УнификатыГруппаНеЗаменять", 	  Элементы, ЭтоПланированиеПотребностей);
	УстановитьВидимостьЭлементаУнификата(Форма.Элементы.Товары, "_УнификатыНеЗаменятьНаУнификат", Элементы, ЭтоПланированиеПотребностей);
	УстановитьВидимостьЭлементаУнификата(Форма.Элементы.Товары, "_УнификатыНеЗамененоНаУнификат", Элементы, ЭтоПланированиеПотребностей); 
	УстановитьВидимостьЭлементаУнификата(Форма.Элементы.ТоварыПоПериодам, "_УнификатыГруппаНеЗаменять", 	Элементы, ЭтоПланированиеПотребностей);
	УстановитьВидимостьЭлементаУнификата(Форма.Элементы.ТоварыПоПериодам, "_УнификатыНеЗаменятьНаУнификат", Элементы, ЭтоПланированиеПотребностей);
	УстановитьВидимостьЭлементаУнификата(Форма.Элементы.ТоварыПоПериодам, "_УнификатыНеЗамененоНаУнификат", Элементы, ЭтоПланированиеПотребностей);
	
КонецПроцедуры

Процедура УстановитьВидимостьЭлементаУнификата(Знач Родитель, Знач Суффикс, Знач Элементы, Знач ЭтоПланированиеПотребностей)
	
	Перем Элемент;
	
	Элемент = Элементы.Найти(Родитель.Имя + Суффикс); 
	Если Элемент <> Неопределено Тогда 
		Элемент.Видимость = ЭтоПланированиеПотребностей;
	КонецЕсли;

КонецПроцедуры

Процедура СкрытьПанельСогласования(Знач Элементы) Экспорт
	
	Перем ФормаСогласованиеУХ, Элемент;     
	
	ФормаСогласованиеУХ = Элементы.Найти("ФормаСогласованиеУХ");
	Если ФормаСогласованиеУХ <> Неопределено Тогда                        
		Для Каждого Элемент Из ФормаСогласованиеУХ.ПодчиненныеЭлементы Цикл   
			Элемент.Видимость = Ложь;    
		КонецЦикла;  
		ФормаСогласованиеУХ.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьУсловноеОформление(Форма) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	ЭлементыФормы = Форма.Элементы;
	
	Если ЭтоПланированиеПотребностей(Форма.Объект.ФормированиеПотребностейПланомЗакупок) Тогда
		
		// Отметка незаполненного для единицы измерения
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыПоПериодамНоменклатураЕдиницаИзмерения");

		ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыПоПериодам.ТоварнаяКатегория");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНеЗаполненного", Ложь);
		
	КонецЕсли;
	
	// Номенклатура не видна совсем
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыПоПериодамНоменклатура");
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыНоменклатура");

	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ФормированиеПотребностейПланомЗакупок");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Товарная позиция видна, если 
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыПоПериодамТоварнаяПозиция");
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыТоварнаяПозиция");

	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ФормированиеПотребностейПланомЗакупок");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Цена и кол-во доступны, если товарная категория НЕ заполнена
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыПоПериодамКоличествоУпаковок");
	Если Форма.Объект.ПланироватьПоСумме Тогда
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыПоПериодамЦена");
	КонецЕсли;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ФормированиеПотребностейПланомЗакупок");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыПоПериодам.ТоварнаяКатегория");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",					НСтр("ru = '<Нет>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",		Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", 			ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);   
	
	//Аналитики
	Для Каждого КлючЗначение Из Форма.ОписаниеФормы.СтатьиБюджетов Цикл   
		ОписаниеЭлемента = КлючЗначение.Значение;
		Если ОписаниеЭлемента.ЭтоТаблица Тогда
			УстановитьУсловноеОформлениеДополнительныхАналитик(Форма, ОписаниеЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	// Оформление контролей
	КонтрольУХ.УстановитьУсловноеОформлениеТаблицыКонтролей(Форма);     
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеКроссТаблицы(УсловноеОформление, ПланироватьПоСумме, ИмяКолонки) Экспорт
	
	// ФормированиеПотребностейПланомЗакупок
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыПоПериодамПериодыТаблицыКоличество_"+ИмяКолонки);
	Если ПланироватьПоСумме Тогда
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТоварыПоПериодамПериодыТаблицыЦена_"+ИмяКолонки);
	КонецЕсли;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ФормированиеПотребностейПланомЗакупок");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыПоПериодам.ТоварнаяКатегория");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",					НСтр("ru = '<Нет>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",		Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", 			ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);  
	
КонецПроцедуры

Процедура КонтрольСценарияПланаЗакупок(Форма, Отказ = Ложь) Экспорт 
	
	Перем ВыборкаДетальныеЗаписи, Запрос, РезультатЗапроса;    
	
	Если ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") Тогда
		ПланОбъект = Форма.Объект;
	Иначе
		ПланОбъект = Форма;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СценарииТоварногоПланирования.ФормированиеПотребностейПланомЗакупок КАК ФормированиеПотребностейПланомЗакупок,
	|	СценарииТоварногоПланирования.Периодичность КАК Периодичность,
	|	СценарииТоварногоПланирования.ПланЗакупокПланироватьПоСумме КАК ПланЗакупокПланироватьПоСумме,
	|	ПериодичностьЦентрализованныхЗакупок.Значение КАК ПериодичностьЦЗЗначение,
	|	ПРЕДСТАВЛЕНИЕ(ПериодичностьЦентрализованныхЗакупок.Значение) КАК ЦЗЗначениеПредставление
	|ИЗ
	|	Справочник.СценарииТоварногоПланирования КАК СценарииТоварногоПланирования,
	|	Константа.ПериодичностьЦентрализованныхЗакупок КАК ПериодичностьЦентрализованныхЗакупок
	|ГДЕ
	|	СценарииТоварногоПланирования.Ссылка = &Сценарий";
	
	Запрос.УстановитьПараметр("Сценарий", ПланОбъект.Сценарий);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Если ВыборкаДетальныеЗаписи.ФормированиеПотребностейПланомЗакупок Тогда   
			
			Сообщения = Новый Массив;    
			
			Если ВыборкаДетальныеЗаписи.Периодичность <> ВыборкаДетальныеЗаписи.ПериодичностьЦЗЗначение Тогда
				Отказ = Истина;	
				Сообщения.Добавить(СтрШаблон(НСтр("ru = 'Для данного сценария ожидается периодичность сценария ""%1"". Откройте сценарий и завершите настройку.'"), ВыборкаДетальныеЗаписи.ЦЗЗначениеПредставление));  
			КонецЕсли; 
			
			Если Не ВыборкаДетальныеЗаписи.ПланЗакупокПланироватьПоСумме Тогда
				Отказ = Истина;	
				Сообщения.Добавить(СтрШаблон(НСтр("ru = 'Для данного сценария планирование по количеству и сумме обязательно. Откройте сценарий и завершите настройку.'"))); 	
			КонецЕсли; 
			
			Если Сообщения.Количество() Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрСоединить(Сообщения, Символы.ПС), ПланОбъект.Ссылка, "", "Объект.Сценарий");     
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры       

Процедура КонтрольВидаПланаЗакупок(Форма, Отказ = Ложь) Экспорт 
	
	Перем ВыборкаДетальныеЗаписи, Запрос, РезультатЗапроса;    
	
	Если ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") Тогда
		ПланОбъект = Форма.Объект;
	Иначе
		ПланОбъект = Форма;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыПланов.ЗаполнятьПланОплат КАК ЗаполнятьПланОплат,
	|	ВидыПланов.ЗаполнятьПодразделение КАК ЗаполнятьПодразделение,
	|	ВидыПланов.ЗаполнятьПартнера КАК ЗаполнятьПартнера,
	|	ВидыПланов.ЗаполнятьСоглашение КАК ЗаполнятьСоглашение
	|ИЗ
	|	Справочник.ВидыПланов КАК ВидыПланов
	|ГДЕ
	|	ВидыПланов.Ссылка = &ВидПлана
	|	И ВидыПланов.Владелец.ФормированиеПотребностейПланомЗакупок";
	
	Запрос.УстановитьПараметр("ВидПлана", ПланОбъект.ВидПлана);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		
		Сообщения = Новый Массив;         
		
		Если Не ВыборкаДетальныеЗаписи.ЗаполнятьПланОплат Тогда
			Отказ = Истина;	
			Сообщения.Добавить(СтрШаблон(НСтр("ru = 'Для вида плана регистрирующего потребности необходимо %1. Откройте вид плана и завершите настройку.'"), НСтр("ru = 'заполнять план оплат'")));  
		КонецЕсли;  
		
		Если ВыборкаДетальныеЗаписи.ЗаполнятьПодразделение Тогда
			Отказ = Истина;	
			Сообщения.Добавить(СтрШаблон(НСтр("ru = 'Для вида плана регистрирующего потребности необходимо %1. Откройте вид плана и завершите настройку.'"), НСтр("ru = 'отключить заполнение подразделения'")));  
		КонецЕсли;  
		
		Если ВыборкаДетальныеЗаписи.ЗаполнятьПартнера Тогда
			Отказ = Истина;	
			Сообщения.Добавить(СтрШаблон(НСтр("ru = 'Для вида плана регистрирующего потребности необходимо %1. Откройте вид плана и завершите настройку.'"), НСтр("ru = 'отключить заполнение поставщика'")));  
		КонецЕсли; 
		
		Если ВыборкаДетальныеЗаписи.ЗаполнятьСоглашение Тогда
			Отказ = Истина;	
			Сообщения.Добавить(СтрШаблон(НСтр("ru = 'Для вида плана регистрирующего потребности необходимо %1. Откройте вид плана и завершите настройку.'"), НСтр("ru = 'отключить заполнение соглашения'")));  
		КонецЕсли;

		Если Сообщения.Количество() Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрСоединить(Сообщения, Символы.ПС), ПланОбъект.Ссылка, "", "Объект.ВидПлана");   
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ИспользуемыеВидыБюджетовЗакупок(Форма) Экспорт

	Форма.Объект.ВидБюджетаПланирования = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Форма.Объект.Дата);
	ВстраиваниеУХПланЗакупок.ОбновитьСтатьиПоВидуБюджета(Форма, Форма.Объект.ВидБюджетаПланирования);

КонецПроцедуры

