Процедура УстановитьУсловноеОформлениеДополнительныхАналитик(Форма, ОписаниеЭлементаСтатья)
	
	//
	Если НЕ ОписаниеЭлементаСтатья.ЭтоТаблица Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементФормы Из ОписаниеЭлементаСтатья.ЭлементыФормы Цикл    
		Если ЭлементФормы.Значение.ЭтоТаблицаФормы Тогда 
			
			Для Каждого ЭлементыАналитики Из ЭлементФормы.Значение.ЭлементыАналитики Цикл
				
				ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеИспользуется(
								Форма.УсловноеОформление.Элементы, 
								ЭлементыАналитики.ИмяЭлемента, 
								ЭлементыАналитики.ПутьКДанным+ "." + ЭлементыАналитики.ИмяРеквизитаВидАналитики,
								Ложь);
				
				ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеЗаполнена(
								Форма.УсловноеОформление.Элементы, 
								ЭлементыАналитики.ИмяЭлемента, 
								ЭлементыАналитики.ПутьКДанным + "." + ЭлементыАналитики.ИмяРеквизита,
								ЭлементыАналитики.ПутьКДанным + "." + ЭлементыАналитики.ИмяРеквизитаВидАналитики
								);         
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьРеквизитыФормыДокумента(Форма)
	
	Если ФормыУХ.ЭлементыФормыУХУжеСозданы(Форма) Тогда
		Возврат;
	КонецЕсли;           
	
	ТипТоварнаяКатегория = Новый ОписаниеТипов(
										ОбщегоНазначенияКлиентСервер.МассивЗначений(Тип("СправочникСсылка.КатегорииЗакупок"), 
																					Тип("СправочникСсылка.ТоварныеКатегории")));
	
	//
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ТоварнаяПозиция",	Метаданные.ОпределяемыеТипы.ТипНоменклатураЕХ.Тип, "ТоварыПоПериодам"));
	Реквизиты.Добавить(Новый РеквизитФормы("ТоварнаяКатегория", ТипТоварнаяКатегория, "ТоварыПоПериодам"));
	Реквизиты.Добавить(Новый РеквизитФормы("ТоварнаяКатегория", ТипТоварнаяКатегория, "Объект.Товары"));      
	Реквизиты.Добавить(Новый РеквизитФормы("ЕдиницаИзмерения",	Метаданные.ОпределяемыеТипы.ТипЕдиницаИзмеренияЕХ.Тип, "ТоварыПоПериодам")); 
	Реквизиты.Добавить(Новый РеквизитФормы("ЕдиницаИзмерения",	Метаданные.ОпределяемыеТипы.ТипЕдиницаИзмеренияЕХ.Тип, "Объект.Товары"));
	
	Реквизиты.Добавить(Новый РеквизитФормы("ЕстьПредупреждения",Новый ОписаниеТипов("Булево")));
	Реквизиты.Добавить(Новый РеквизитФормы("ЕстьИнформация",	Новый ОписаниеТипов("Булево")));
	
	Реквизиты.Добавить(Новый РеквизитФормы("ТипНоменклатуры",	Новый ОписаниеТипов("неопределено")));      
	
	Реквизиты.Добавить(Новый РеквизитФормы("МестоПоставки", 	Новый ОписаниеТипов("СправочникСсылка.МестаПоставки"), "ТоварыПоПериодам", НСтр("ru = 'Место поставки'"), Истина));
	
	Форма.ИзменитьРеквизиты(Реквизиты);
	
КонецПроцедуры

Процедура СоздатьЭлементыФормыДокумента(Форма)
	
	Если ФормыУХ.ЭлементыФормыУХУжеСозданы(Форма) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	//
	ФормыУХ.ЭлементыФормыУХДобавлены(Форма);
	
	//
	ПараметрыПоляВвода = Новый Структура;
	ПараметрыПоляВвода.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Лево);
	ПараметрыПоляВвода.Вставить("АвтоМаксимальнаяШирина", Ложь);
	ПараметрыПоляВвода.Вставить("МаксимальнаяШирина", 28);
	
	// Организация
	ФормыУХ.СоздатьПолеФормы(Элементы, "Организация",			"", "Объект.Организация",		ВидПоляФормы.ПолеВвода, Элементы.ШапкаЛево,, ПараметрыПоляВвода);
	ФормыУХ.СоздатьПолеФормы(Элементы, "ЦФО",					"", "Объект.ЦФО",				ВидПоляФормы.ПолеВвода, Элементы.ШапкаЛево,, ПараметрыПоляВвода);
	ФормыУХ.СоздатьПолеФормы(Элементы, "Проект",				"", "Объект.Проект",			ВидПоляФормы.ПолеВвода, Элементы.ШапкаЛево,, ПараметрыПоляВвода);
	ФормыУХ.СоздатьПолеФормы(Элементы, "МестоПоставки",			"", "Объект.МестоПоставки", 	ВидПоляФормы.ПолеВвода, Элементы.ШапкаЛево,, ПараметрыПоляВвода);
	ФормыУХ.СоздатьПолеФормы(Элементы, "Приоритет",				"", "Объект.Приоритет",			ВидПоляФормы.ПолеВвода, Элементы.ШапкаЛево,, ПараметрыПоляВвода);
	ФормыУХ.СоздатьПолеФормы(Элементы, "Менеджер",				"", "Объект.Менеджер", 			ВидПоляФормы.ПолеВвода, Элементы.ШапкаЛево,, ПараметрыПоляВвода);
	ФормыУХ.СоздатьПолеФормы(Элементы, "ТоварыПоПериодамМестоПоставки", "", "ТоварыПоПериодам.МестоПоставки", ВидПоляФормы.ПолеВвода, Элементы.ТоварыПоПериодам, Элементы.ТоварыПоПериодамСклад);  
	ФормыУХ.СоздатьПолеФормы(Элементы, "ТоварыМестоПоставки", "", "Объект.Товары.МестоПоставки", ВидПоляФормы.ПолеВвода, Элементы.Товары, Элементы.ТоварыСклад);

	
	//
