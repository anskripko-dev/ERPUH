	Структура.Вставить("Подсистемы"               , "");	
	Структура.Вставить("Реквизиты"                , "");	
	Структура.Вставить("Формы"                    , "");	
	Структура.Вставить("Команды"                  , "");
	Структура.Вставить("СтандартныеРеквизиты"     , "");
	Структура.Вставить("ТабличныеЧасти"           , "");
	Структура.Вставить("Макеты"                   , "");
	Структура.Вставить("ЗначенияПеречисления"     , "");
	Структура.Вставить("Измерения"                , "");
	Структура.Вставить("Ресурсы"                  , "");
	Структура.Вставить("РеквизитыАдресации"       , "");
	Структура.Вставить("Графы"                    , "");
	Структура.Вставить("СтандартныеТабличныеЧасти", "");
	Структура.Вставить("ПризнакиУчета"            , "");
	Структура.Вставить("ПризнакиУчетаСубконто"    , "");
	Структура.Вставить("Перерасчеты"              , "");	
	
	Возврат Структура;
	
