// Соколов А.А. 09.06.2016 Выполнение задач 000021157
Процедура ЗаполнитьКоллекцию(Контейнер, ИмяМетаданного, КоллекцияОбъектовМетаданных = Неопределено, ТекущиеМетаданные = Неопределено) // Соколов А.А. 02.07.2021: добавлен входной параметр "ТекущиеМетаданные"
	
	ПереданаКоллекция = КоллекцияОбъектовМетаданных <> Неопределено;
	
	Если Не ПереданаКоллекция Тогда 
		Контейнер.Вставить(ИмяМетаданного, Новый Структура);	
		// НАЧАЛО Соколов А.А. 02.07.2021
		//КоллекцияОбъектовМетаданных = Метаданные[ИмяМетаданного];
		Если ТекущиеМетаданные = Неопределено Тогда 
			КоллекцияОбъектовМетаданных = Метаданные[ИмяМетаданного];
		Иначе 
			КоллекцияОбъектовМетаданных = ТекущиеМетаданные[ИмяМетаданного];
		КонецЕсли;
		// КОНЕЦ Соколов А.А. 02.07.2021				
	КонецЕсли;
	
	Для Каждого ОбъектМетаданного Из КоллекцияОбъектовМетаданных Цикл 
		
		ТекущийЭкземпляр = СоздатьЭкземпляр_ОбъектМетаданных(ОбъектМетаданного);
		
		ЗаполнитьЗначенияСвойств(ТекущийЭкземпляр, ОбъектМетаданного);
		
		// НАЧАЛО Круглов 26.10.2016
		//ТекущийЭкземпляр.Представление = ?(ЗначениеЗаполнено(ТекущийЭкземпляр.Синоним), ТекущийЭкземпляр.Синоним, ТекущийЭкземпляр.Имя);
		Попытка
			ТекущийЭкземпляр.Представление = ОбъектМетаданного.Представление();
			ТекущийЭкземпляр.ПолноеИмя     = ОбъектМетаданного.ПолноеИмя();
		Исключение;
			ТекущийЭкземпляр.Представление = ?(ЗначениеЗаполнено(ТекущийЭкземпляр.Синоним), ТекущийЭкземпляр.Синоним, ТекущийЭкземпляр.Имя);
		КонецПопытки;
		// КОНЕЦ Круглов 26.10.2016
						
		Для Каждого Свойство Из ТекущийЭкземпляр Цикл 
			
			Если ТипЗнч(Свойство.Значение) = Тип("КоллекцияОбъектовМетаданных") ИЛИ  ТипЗнч(Свойство.Значение) = Тип("ОписанияСтандартныхРеквизитов") ИЛИ ТипЗнч(Свойство.Значение) = Тип("ОписанияСтандартныхТабличныхЧастей")  Тогда 
				НовыйКонтейнер = Новый Структура;
				// НАЧАЛО Соколов А.А. 02.07.2021
				//ЗаполнитьКоллекцию(НовыйКонтейнер, Свойство.Ключ, Свойство.Значение); 
				ЗаполнитьКоллекцию(НовыйКонтейнер, Свойство.Ключ, Свойство.Значение, ТекущиеМетаданные); 
				// КОНЕЦ Соколов А.А. 02.07.2021	
				ТекущийЭкземпляр[Свойство.Ключ] = НовыйКонтейнер;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ПереданаКоллекция Тогда 
			Контейнер[ИмяМетаданного].Вставить(ОбъектМетаданного.Имя, ТекущийЭкземпляр); 
		Иначе 
			Контейнер.Вставить(ОбъектМетаданного.Имя, ТекущийЭкземпляр);
		КонецЕсли;
		
	КонецЦикла;
			
		
КонецПроцедуры

// Соколов А.А. 09.06.2016 Выполнение задач 000021157
Функция СериализоватьКонтейнер(Контейнер) Экспорт 
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ЗаписьXML.УстановитьСтроку("UTF-8");
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Контейнер);
		
	Возврат ЗаписьXML.Закрыть();		
	
КонецФункции

