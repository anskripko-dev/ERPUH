// Функция предназначена для сжатия строк (без использования временных файлов) c использованием внешней компоненты (Native API / COM) 
//
// Параметры:
//   ИсходнаяСтрока - строка - строка символов, которую необходимо сжать
//   ВнешнееСжатие  - булево - вариант используемой компоненты
//     * ЛОЖЬ   - если необходимо использовать внешнюю компоненту "TNNativeZip", выполненную по технологии Native API (рекомендуемый вариант) 
//     * ИСТИНА - если необходимо использовать внешнюю компоненту "TNZip", выполненную по технологии COM (нерекомендуемый вариант)
//   ОписаниеОшибки - строка - если результат выполнения функции НЕОПРЕДЕЛЕНО, то в ОписаниеОшибки будет указана подробная информация
//   ТипСжатия      - число  - допустимы варианты 0, 1, 2, 3 (параметр актуален только при значении параметра "ВнешнееСжатие" = ЛОЖЬ).
//     * 0 - без сжатия
//     * 1 - максимальная скорость сжатия 
//     * 2 - максимальная степень сжатия
//     * 3 - сбалансированные значения сжатия и скорости
//
// Возвращаемое значение
//   Строка       - сжатая строка, если функция отработала без ошибок
//   НЕОПРЕДЕЛЕНО - если в результате работы функции произошли ошибки
//
Функция СжатьСтроку(ИсходнаяСтрока,ВнешнееСжатие = Ложь,ОписаниеОшибки = "", ТипСжатия = 2, ВерсияВнешнейКомпоненты = 1) Экспорт // Соколов А.А. 15.08.2016 Выполнение задач 000021712: добавлен параметр "ТипСжатия" // Соколов Александр 25.10.2017 Выполнение задач №000026360: добавлен параметр "ВерсияВнешнейКомпоненты"

	// Соколов 03.11.2021: не вздумай больше так делать! Это служебные функции, в РЕЛИЗЕ и ПРОДУКТИВЕ этого кода быть не должно!
	//// Борисенко И.Н. 23.07.2021 Выполнение задач №000035594: закомментировал	
	//Возврат Неопределено;
	// Конец Соколов 03.11.2021
	
	Если ВнешнееСжатие Тогда 
		Адрес = тн_ИнтеграцияПовтИсп.ПолучитьАдресОбщегоМакета("NETLoader");		
		Если Не ПодключитьВнешнююКомпоненту(Адрес, "NET",ТипВнешнейКомпоненты.Native ) Тогда
			ЗаписьЖурналаРегистрации("NETLoader",УровеньЖурналаРегистрации.Ошибка,,"Не удалось подключить компоненту NETLoader",);
			Сообщить("Не удалось подключить компоненту NETLoader");
			Возврат Неопределено;
		КонецЕсли;
		Попытка
			Компонента = Новый("AddIn.NET.NETLoader");
			КаталогКомпонент = КаталогВременныхФайлов() + Новый УникальныйИдентификатор;
			СоздатьКаталог(КаталогКомпонент);
			// Ситалов 23.11.2021: закоментил по указанию Соколова А.
			//Test_dll = ПолучитьОбщийМакет("TNZip");
			//Test_dll.Записать(КаталогКомпонент + "\TNZip.dll");
			// Конец Ситалов 23.11.2021
			Компонента.CreateObject(КаталогКомпонент, "TNZip", "TNZip.GZip", , Истина);
			Результат = Компонента.Compression(ИсходнаяСтрока);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			Возврат Неопределено;
		КонецПопытки;
	Иначе
		
		
		// НАЧАЛО Соколов Александр 25.10.2017 Выполнение задач №000026360
		//// НАЧАЛО Соколов А.А. 15.08.2016 Выполнение задач 000021712
		////Адрес = тн_ИнтеграцияПовтИсп.ПолучитьАдресОбщегоМакета("CompressComponent64");		
		////Если Не ПодключитьВнешнююКомпоненту(Адрес, "TNNativeZip", ТипВнешнейКомпоненты.Native) Тогда
		//Если Не ПодключитьВнешнююКомпоненту("ОбщийМакет.CompressComponent", "TNNativeZip") Тогда
		//// КОНЕЦ Соколов А.А. 15.08.2016    
		
		// Николаев П. 28.10.2025 : боремся с ошибкой получения МД ERP : задействуем сжатие/разжатие компонентой RMQ ->
		
		Если ВерсияВнешнейКомпоненты = "RMQ" Тогда 
			
			Если Не ПодключитьВнешнююКомпоненту("ОбщийМакет.V8RMQClient", "V8RMQClient", ТипВнешнейКомпоненты.Native) Тогда
				ЗаписьЖурналаРегистрации("GZipCompressor",УровеньЖурналаРегистрации.Ошибка,,"Не удалось подключить компоненту GZipCompressor",);
				ОписаниеОшибки = "Не удалось подключить компоненту GZipCompressor";
				Возврат Неопределено;
			КонецЕсли;
			Попытка	
				ОбъектКомпоненты = Новый("AddIn.V8RMQClient.GZipCompressor");
				Результат = ОбъектКомпоненты.CompressString(ИсходнаяСтрока);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				Возврат Неопределено;
			КонецПопытки;  

		Иначе 
			
		// Николаев П. 28.10.2025 : боремся с ошибкой получения МД ERP : задействуем сжатие/разжатие компонентой RMQ <-
		
