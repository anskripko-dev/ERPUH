	СтруктураРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПрофильПодключения, СписокРеквизитов);
	
	СтруктураРеквизиты.Вставить("Пароль", "");
	СтруктураРеквизиты.Вставить("ApiKey", "");
	ДанныеБП = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ПрофильПодключения, "Password, ApiKey");
	Если ДанныеБП <> Неопределено Тогда
		СтруктураРеквизиты.Пароль = ДанныеБП.Password;
		СтруктураРеквизиты.ApiKey = ДанныеБП.ApiKey;
	КонецЕсли;
	
	Возврат СтруктураРеквизиты;
	
КонецФункции

// Смирнов Д.А. 03.02.2025 Выполнение задач №000052291
//				
Функция УстановитьСоединениеССервером(ПрофильПодключения, ОписаниеОшибки = "", СценарийПодключения = Неопределено) Экспорт
	
	Соединение = Неопределено;
	
	ТипЗначенияПараметра = ТипЗнч(ПрофильПодключения);
	
	Если ТипЗначенияПараметра = Тип("Структура") Тогда 
		
		// наличие обязательных "ключей" структуры не проверяется.
		Параметры = ПрофильПодключения;
		
	ИначеЕсли ТипЗначенияПараметра = Тип("СправочникСсылка.ТН_ПрофилиПодключений") Тогда 
		
		Если Не ЗначениеЗаполнено(ПрофильПодключения) Тогда 
			ОписаниеОшибки = "Не заполнен ""Профиль подключения""";
			Возврат Соединение;
		КонецЕсли;
		
		Параметры = ПолучитьПараметрыПрофиля(ПрофильПодключения, СценарийПодключения);
		
	Иначе 
		
		ОписаниеОшибки = "Неверный тип первого параметра функции установки соединения" ;
		Возврат Соединение;
		
	КонецЕсли;
				
	Если Не Параметры.Использование Тогда
		
		ОписаниеОшибки = "Использование профиля """ + Параметры.Наименование + """ отключено.";
		Возврат Соединение;		
		
	КонецЕсли;   
				
	Если Параметры.Протокол = Перечисления.ТН_ПротоколыПодключений.HTTP Тогда 
		
		Если НЕ ЗначениеЗаполнено(Параметры.Хост) Тогда 
			
			ОписаниеОшибки = "В профиле """ + Параметры.Наименование + """ не указан хост, с которым требуется установить соединение" ;
			Возврат Соединение;
			
		КонецЕсли;
		
		ЗащищенноеСоединение = Неопределено;
		Если Параметры.ИспользоватьЗащищенноеСоединение Тогда 
			
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
			
		КонецЕсли;
		
		Прокси = Неопределено;
		Если Параметры.ИспользоватьПроксиСервер Тогда 
			
			// ВНИМАНИЕ! Реализация позднее, по мере подключения новых интеграций.			
			
		КонецЕсли;
		
		Попытка
			
			Соединение = Новый HTTPСоединение(Параметры.Хост, ?(ЗначениеЗаполнено(Параметры.Порт), Параметры.Порт, Неопределено), Параметры.Пользователь, Параметры.Пароль, 
			                                  ?(Параметры.ИспользоватьПроксиСервер, Прокси, Неопределено), Параметры.Таймаут, 
											  ЗащищенноеСоединение, Параметры.ИспользоватьАутентификациюОС);			  
					
		Исключение
			
			ОписаниеОшибки = "Не удалось установить соединение по профилю подключения """ + Параметры.Наименование + """ по причине:" + ОписаниеОшибки();
			Возврат Неопределено;
			
		КонецПопытки;
		
	ИначеЕсли Параметры.Протокол = Перечисления.ТН_ПротоколыПодключений.WS Тогда
		
		Если НЕ ЗначениеЗаполнено(Параметры.Хост) Тогда
			
			ОписаниеОшибки = "В профиле """ + Параметры.Наименование + """ не указан хост, с которым требуется установить соединение" ;
			Возврат Соединение;
			
		КонецЕсли;
		
		ЗащищенноеСоединение = Неопределено;
		Если Параметры.ИспользоватьЗащищенноеСоединение Тогда 
			
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
			
		КонецЕсли;
		
		Прокси = Неопределено;
		Если Параметры.ИспользоватьПроксиСервер Тогда 
			
			// ВНИМАНИЕ! Реализация позднее, по мере подключения новых интеграций.			
			
		КонецЕсли;
		
		WSDLСтрока = "" + ?(Параметры.ИспользоватьЗащищенноеСоединение, "https", "http") + "://" + Параметры.Хост + ?(ЗначениеЗаполнено(Параметры.Порт), ":" + Формат(Параметры.Порт, "ЧГ=0"), "") + "/" + Параметры.ИмяРесурсаWSDL;
		
		Пользователь = ?(ЗначениеЗаполнено(Параметры.Пользователь), Параметры.Пользователь, Неопределено);
		Пароль       = ?(ЗначениеЗаполнено(Параметры.Пароль), Параметры.Пароль, Неопределено);
		
		Попытка
			
			WSОпределение = Новый WSОпределения(WSDLСтрока, Пользователь, Пароль, Прокси, Параметры.Таймаут, ЗащищенноеСоединение);
		Исключение
			
			ОписаниеОшибки = "Не удалось установить соединение по профилю подключения """ + Параметры.Наименование + """ по причине:" + ОписаниеОшибки();
			
			Если Параметры.Свойство("флагПоСценариюПодключения") И Параметры.флагПоСценариюПодключения = Истина Тогда
				
				//подключаемся только по сценарию подключения, с указанным логином и паролем
				СоединениеТемп = Соединение;
				Соединение = Новый Структура;
				Соединение.Вставить("флагПоСценариюПодключения", Параметры.флагПоСценариюПодключения);
				Соединение.Вставить("Соединение", СоединениеТемп);
				
			КонецЕсли;
			
			Возврат Соединение;
			
		КонецПопытки;
		
		Если WSОпределение = Неопределено Тогда
			
			ОписаниеОшибки = "Ошибка при подключении по профилю """ + Параметры.Наименование + """ по причине: " + "не удалось получить WSОпределение на основании WSDL-файла.";
			Возврат Соединение;
			
		КонецЕсли;
		
		Если WSОпределение.Сервисы.Количество() = 0 Тогда
			
			ОписаниеОшибки = "Ошибка при подключении по профилю """ + Параметры.Наименование + """ по причине: " + "нет ни одного доступного WS-сервиса.";
			Возврат Соединение;
			
		КонецЕсли;
		
		Сервис = WSОпределение.Сервисы[0];
		Если Сервис.ТочкиПодключения.Количество() > 0 Тогда
			
			ИмяТочкиПодключения = Сервис.ТочкиПодключения[0].Имя;
			
		Иначе
			
			ОписаниеОшибки = "Ошибка при подключении по профилю """ + Параметры.Наименование + """ по причине: " + "нет ни одной доступной точки подключения для " + Сервис.Имя + ".";
			Возврат Соединение;
			
		КонецЕсли;
		
		Попытка
			
			Прокси = Новый WSПрокси(WSОпределение, Сервис.URIПространстваИмен, Сервис.Имя, ИмяТочкиПодключения, Прокси, Параметры.Таймаут, ЗащищенноеСоединение);
			
		Исключение
			
			ОписаниеОшибки = "Ошибка при подключении по профилю """ + Параметры.Наименование + """ по причине: " + ОписаниеОшибки();
			Возврат Соединение;		
			
		КонецПопытки;
		
		Соединение = Прокси;
	
		Соединение.Пользователь = Пользователь;
		Соединение.Пароль 		= Пароль;
		
	Иначе 
		
		ОписаниеОшибки = "В профиле " + Параметры.Наименование + """ указан протокол " + """" + Параметры.Протокол + """ , не реализованный в функции установки соединения" ;
		Возврат Соединение;	
		
	КонецЕсли;
	    	
	Возврат Соединение;	
	
КонецФункции

// Одинец Роман 26.06.2024 Выполнение задач №000048970
Функция ПолучитьИмяМетодаБезВерсии(Знач ИмяМетода) Экспорт
	
	РазложенныйИмяМетода = СтрРазделить(ИмяМетода, "_");
	
	Если РазложенныйИмяМетода.Количество() Тогда
		
		ПоследнийЭлемент = РазложенныйИмяМетода[РазложенныйИмяМетода.ВГраница()];
		
		Если Лев(ПоследнийЭлемент, "1") = "v" Тогда
			
			СтрокаНомерВерсии = Сред(ПоследнийЭлемент, 2);
			ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
			НомерВерсии = ОписаниеТипаЧисло.ПривестиЗначение(СтрокаНомерВерсии);
			
			Если ПоследнийЭлемент = "v" + Формат(НомерВерсии, "ЧГ=") Тогда
				
				РазложенныйИмяМетода.Удалить(РазложенныйИмяМетода.ВГраница());
				ИмяМетода = СтрСоединить(РазложенныйИмяМетода, "_");
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИмяМетода;
	
КонецФункции // ПолучитьИмяМетодаБезВерсии()

// Одинец Роман 26.06.2024 Выполнение задач №000048970
Функция РазложитьВидСообщенияНаМетодИВерсию(ВидСообщения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяМетода", ВидСообщения);
	Результат.Вставить("НомерВерсии", "");
	РазобранныйВидСообщения = СтрРазделить(ВидСообщения, "_", Ложь);
	
	Если РазобранныйВидСообщения.Количество() Тогда
		
		ИндексПоследнегоЭлемента = РазобранныйВидСообщения.ВГраница();
		ПоследнийЭлемент = РазобранныйВидСообщения[ИндексПоследнегоЭлемента];
		
		Если НРег(Лев(ПоследнийЭлемент, 1)) = "v" Тогда
			
			Результат.НомерВерсии = СтрЗаменить(ПоследнийЭлемент, "v", "");		
			РазобранныйВидСообщения.Удалить(ИндексПоследнегоЭлемента);
			
		КонецЕсли;
		
		Результат.ИмяМетода = СтрСоединить(РазобранныйВидСообщения, "_");
		
	КонецЕсли;		
	
	Возврат Результат;
	
КонецФункции // РазложитьВидСообщенияНаМетодИВерсию()
