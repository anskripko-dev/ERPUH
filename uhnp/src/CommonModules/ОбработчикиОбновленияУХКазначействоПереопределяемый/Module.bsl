	ЭлементОбъект.Наименование = НСтр("ru = 'RUONIA 6M'", ОбщегоНазначения.КодОсновногоЯзыка());
	ЭлементОбъект.ТипКотировки 	= Перечисления.ТипыКотировокФинансовыхИнструментов.РыночнаяСтавкаПроцента;
	ЭлементОбъект.ИдентификаторДляЗагрузки = НСтр("ru = 'RUONIA_AVG_6M'", ОбщегоНазначения.КодОсновногоЯзыка());   
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЭлементОбъект);
	
	Если ЭлементОбъект.ПометкаУдаления Тогда
		ЭлементОбъект.УстановитьПометкуУдаления(Ложь);	
	КонецЕсли;  

	
	// RUONIA 
	Элемент = Справочники.ВидыКотировокФинансовыхИнструментов.НайтиПоРеквизиту("ИдентификаторДляЗагрузки", НСтр("ru = 'Standard_RUONIA'", ОбщегоНазначения.КодОсновногоЯзыка()));
    Если Элемент.Пустая() Тогда
    	Элемент = Справочники.ВидыКотировокФинансовыхИнструментов.НайтиПоНаименованию(НСтр("ru = 'RUONIA'", ОбщегоНазначения.КодОсновногоЯзыка()), Истина);
	КонецЕсли;

    Если Элемент.Пустая() Тогда
		ЭлементОбъект = Справочники.ВидыКотировокФинансовыхИнструментов.СоздатьЭлемент();
	Иначе	
		ЭлементОбъект = Элемент.ПолучитьОбъект();
	КонецЕсли;

	ЭлементОбъект.Наименование = НСтр("ru = 'RUONIA'", ОбщегоНазначения.КодОсновногоЯзыка());
	ЭлементОбъект.ТипКотировки 	= Перечисления.ТипыКотировокФинансовыхИнструментов.РыночнаяСтавкаПроцента;
	ЭлементОбъект.ИдентификаторДляЗагрузки = НСтр("ru = 'Standard_RUONIA'", ОбщегоНазначения.КодОсновногоЯзыка());   
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЭлементОбъект);
	
	Если ЭлементОбъект.ПометкаУдаления Тогда
		ЭлементОбъект.УстановитьПометкуУдаления(Ложь);	
	КонецЕсли;  
	
КонецПроцедуры

