Процедура АктуализироватьВидДоговораФакторинг()   Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсияСоглашенияКоммерческийДоговор.ВидДоговораУХ КАК ВидДоговораУХ,
		|	ВерсияСоглашенияКоммерческийДоговор.ТипДоговора КАК ТипДоговора,
		|	ВерсияСоглашенияКоммерческийДоговор.Ссылка КАК ВерсияСоглашения,
		|	ВерсияСоглашенияКоммерческийДоговор.ДоговорКонтрагента КАК ДоговорКонтрагента
		|ИЗ
		|	Документ.ВерсияСоглашенияКоммерческийДоговор КАК ВерсияСоглашенияКоммерческийДоговор
		|ГДЕ
		|	ВерсияСоглашенияКоммерческийДоговор.ВидДоговораУХ = &ВидДоговораУХ И ВерсияСоглашенияКоммерческийДоговор.ТипДоговора<> &ТипДоговора";
	
	Запрос.УстановитьПараметр("ВидДоговораУХ", 	Справочники.ВидыДоговоровКонтрагентовУХ.Факторинг);

	Запрос.УстановитьПараметр("ТипДоговора", 	Перечисления.ТипыДоговоров.СПокупателем);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбъектВерсияСоглашения = ВыборкаДетальныеЗаписи.ВерсияСоглашения.ПолучитьОбъект();
		ОбъектВерсияСоглашения.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектВерсияСоглашения);  
		
		ОбъектДоговор = ВыборкаДетальныеЗаписи.ДоговорКонтрагента.ПолучитьОбъект();
		ОбъектДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектДоговор);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТипСрочностиДоговорыКредитовИДепозитов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Ссылка,
		|	Договоры.СрокДней КАК СрокДней,
		|	Договоры.ВерсияСоглашения.ДатаНачалаДействия КАК ВерсияСоглашенияДатаНачалаДействия,
		|	Договоры.ВерсияСоглашения.ДатаОкончанияДействия КАК ВерсияСоглашенияДатаОкончанияДействия,
		|	РАЗНОСТЬДАТ(Договоры.ВерсияСоглашения.ДатаНачалаДействия, Договоры.ВерсияСоглашения.ДатаОкончанияДействия, ДЕНЬ) КАК СрокВерсии,
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(Договоры.ВерсияСоглашения.ДатаНачалаДействия, Договоры.ВерсияСоглашения.ДатаОкончанияДействия, ДЕНЬ) > 364
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыСрочностиКредитовИДепозитов.Долгосрочный)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыСрочностиКредитовИДепозитов.Краткосрочный)
		|	КОНЕЦ КАК ТипСрочностиВерсии,
		|	Договоры.ТипСрочности КАК ТипСрочности
		|ИЗ
		|	Справочник.ДоговорыКредитовИДепозитов КАК Договоры
		|ГДЕ
		|	(РАЗНОСТЬДАТ(Договоры.ВерсияСоглашения.ДатаНачалаДействия, Договоры.ВерсияСоглашения.ДатаОкончанияДействия, ДЕНЬ) <> Договоры.СрокДней
		|			ИЛИ ВЫБОР
		|				КОГДА РАЗНОСТЬДАТ(Договоры.ВерсияСоглашения.ДатаНачалаДействия, Договоры.ВерсияСоглашения.ДатаОкончанияДействия, ДЕНЬ) > 364
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыСрочностиКредитовИДепозитов.Долгосрочный)
		|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыСрочностиКредитовИДепозитов.Краткосрочный)
		|			КОНЕЦ <> Договоры.ТипСрочности)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ОбъектДоговор = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ОбъектДоговор.ТипСрочности 	= ВыборкаДетальныеЗаписи.ТипСрочностиВерсии;
		ОбъектДоговор.СрокДней 		= ВыборкаДетальныеЗаписи.СрокВерсии;
		
		//**** ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектДоговор);
		
	КонецЦикла;

КонецПроцедуры

