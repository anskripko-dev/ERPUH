Процедура ЗаполнитьНастройкиФинансовыхИнструментов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеРегистра.Операция КАК Операция,
	|	ДанныеРегистра.УдалитьОперация КАК УдалитьОперация,
	|	ДанныеРегистра.СтатьяБюджета КАК СтатьяБюджета
	|ИЗ
	|	РегистрСведений.УдалитьНастройкиФинансовыхИнструментов КАК ДанныеРегистра
	|
	|УПОРЯДОЧИТЬ ПО
	|	УдалитьОперация
	|ИТОГИ ПО
	|	Операция";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОперация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОперация.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаОперация.Выбрать();
	   	ВыборкаДетальныеЗаписи.Следующий(); // С приоритетом на пустую "УдалитьОперация"  
		
		НаборДанных = РегистрыСведений.НастройкиФинансовыхИнструментов.СоздатьНаборЗаписей();  	
		НаборДанных.Отбор.Операция.Установить(ВыборкаДетальныеЗаписи.Операция);
		
		ЗаполнитьЗначенияСвойств(НаборДанных.Добавить(), ВыборкаДетальныеЗаписи);
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборДанных);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'Не удалось обновить регистр сведений ""%1"" по операции ""%2"" 
			|%3'"),
			"Настройки операций финансовых инструментов", 
			ВыборкаДетальныеЗаписи.Операция, 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
							УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		КонецПопытки; 		
	   
	КонецЦикла; 
	
КонецПроцедуры  

