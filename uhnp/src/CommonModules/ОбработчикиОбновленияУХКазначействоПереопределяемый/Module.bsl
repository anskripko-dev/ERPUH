Процедура ЗаполнитьПриоритетПлатежаВПлатежнойПозиции() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию,
	|	РазмещениеЗаявок.ПриходРасход КАК ПриходРасход,
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.Приоритет КАК Приоритет
	|ИЗ
	|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|ГДЕ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
	|	И РазмещениеЗаявок.Приоритет = ЗНАЧЕНИЕ(Справочник.ПриоритетыПлатежей.ПустаяСсылка)
	|	И НЕ РазмещениеЗаявок.ЗаявкаНаОперацию.Приоритет = ЗНАЧЕНИЕ(Справочник.ПриоритетыПлатежей.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();   
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл    	
		
		МенеджерЗаписи = РегистрыСведений.РазмещениеЗаявок.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);	
		МенеджерЗаписи.Прочитать();
		
		МенеджерЗаписи.Приоритет = ВыборкаДетальныеЗаписи.Приоритет;
		 
		Попытка
			МенеджерЗаписи.Записать();   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
				"ru = 'Не удалось записать регистр сведений ""%1""
				|%2'"),
				Метаданные.РегистрыСведений.РазмещениеЗаявок.Представление(),    
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки; 

	КонецЦикла; 
	
КонецПроцедуры

