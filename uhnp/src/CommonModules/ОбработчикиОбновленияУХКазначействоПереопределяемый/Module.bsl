Процедура ЗаполнитьБезакцептноеСписаниеДенежныхСредств() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсияСоглашенияАккредитив.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(ВерсияСоглашенияАккредитивГрафикРасчетов.ЭлементСтруктурыЗадолженности, ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг)) КАК ЭлементСтруктурыЗадолженности
		|ПОМЕСТИТЬ ВТ_ВерсииСоглашения
		|ИЗ
		|	Документ.ВерсияСоглашенияАккредитив КАК ВерсияСоглашенияАккредитив
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВерсияСоглашенияАккредитив.ГрафикРасчетов КАК ВерсияСоглашенияАккредитивГрафикРасчетов
		|		ПО (ВерсияСоглашенияАккредитивГрафикРасчетов.Ссылка = ВерсияСоглашенияАккредитив.Ссылка)
		|ГДЕ
		|	ВерсияСоглашенияАккредитив.УдалитьБезакцептноеСписание
		|
		|СГРУППИРОВАТЬ ПО
		|	ВерсияСоглашенияАккредитив.Ссылка,
		|	ЕСТЬNULL(ВерсияСоглашенияАккредитивГрафикРасчетов.ЭлементСтруктурыЗадолженности, ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВерсияСоглашенияБанковскаяГарантия.Ссылка,
		|	ЕСТЬNULL(ВерсияСоглашенияБанковскаяГарантияГрафикРасчетов.ЭлементСтруктурыЗадолженности, ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Комиссии))
		|ИЗ
		|	Документ.ВерсияСоглашенияБанковскаяГарантия КАК ВерсияСоглашенияБанковскаяГарантия
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВерсияСоглашенияБанковскаяГарантия.ГрафикРасчетов КАК ВерсияСоглашенияБанковскаяГарантияГрафикРасчетов
		|		ПО (ВерсияСоглашенияБанковскаяГарантияГрафикРасчетов.Ссылка = ВерсияСоглашенияБанковскаяГарантия.Ссылка)
		|ГДЕ
		|	ВерсияСоглашенияБанковскаяГарантия.УдалитьБезакцептноеСписание
		|
		|СГРУППИРОВАТЬ ПО
		|	ВерсияСоглашенияБанковскаяГарантия.Ссылка,
		|	ЕСТЬNULL(ВерсияСоглашенияБанковскаяГарантияГрафикРасчетов.ЭлементСтруктурыЗадолженности, ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Комиссии))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВерсияСоглашенияКоммерческийДоговор.Ссылка,
		|	ЕСТЬNULL(ВерсияСоглашенияКоммерческийДоговорГрафикРасчетов.ЭлементСтруктурыЗадолженности, ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг))
		|ИЗ
		|	Документ.ВерсияСоглашенияКоммерческийДоговор КАК ВерсияСоглашенияКоммерческийДоговор
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВерсияСоглашенияКоммерческийДоговор.ГрафикРасчетов КАК ВерсияСоглашенияКоммерческийДоговорГрафикРасчетов
		|		ПО (ВерсияСоглашенияКоммерческийДоговорГрафикРасчетов.Ссылка = ВерсияСоглашенияКоммерческийДоговор.Ссылка)
		|ГДЕ
		|	ВерсияСоглашенияКоммерческийДоговор.УдалитьБезакцептноеСписание
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВерсияСоглашенияКредит.Ссылка,
		|	ЕСТЬNULL(ВерсияСоглашенияКредитГрафикРасчетов.ЭлементСтруктурыЗадолженности, ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг))
		|ИЗ
		|	Документ.ВерсияСоглашенияКредит КАК ВерсияСоглашенияКредит
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВерсияСоглашенияКредит.ГрафикРасчетов КАК ВерсияСоглашенияКредитГрафикРасчетов
		|		ПО (ВерсияСоглашенияКредитГрафикРасчетов.Ссылка = ВерсияСоглашенияКредит.Ссылка)
		|ГДЕ
		|	ВерсияСоглашенияКредит.УдалитьБезакцептноеСписание
		|
		|СГРУППИРОВАТЬ ПО
		|	ВерсияСоглашенияКредит.Ссылка,
		|	ЕСТЬNULL(ВерсияСоглашенияКредитГрафикРасчетов.ЭлементСтруктурыЗадолженности, ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ВерсииСоглашения.Ссылка КАК Ссылка,
		|	ВТ_ВерсииСоглашения.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности
		|ИЗ
		|	ВТ_ВерсииСоглашения КАК ВТ_ВерсииСоглашения
		|ИТОГИ ПО
		|	Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДокумент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокумент.Следующий() Цикл 
		
		ДокументОбъект = ВыборкаДокумент.Ссылка.ПолучитьОбъект();    
		
		Если ДокументОбъект.БезакцептноеСписаниеДенежныхСредств.Количество() Тогда
			Продолжить;
		КонецЕсли;       
		
		ВыборкаЭСЗ =  ВыборкаДокумент.Выбрать();
		
		Пока ВыборкаЭСЗ.Следующий()Цикл
			
			НовСтр = ДокументОбъект.БезакцептноеСписаниеДенежныхСредств.Добавить();
			НовСтр.ЭлементСтруктурыЗадолженности = ВыборкаЭСЗ.ЭлементСтруктурыЗадолженности;
			НовСтр.БезакцептноеСписание = Истина;          
			
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьБезакцептноеСписаниеРазмещениеЗаявок() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|		ПО ЗаявкаНаРасходованиеДенежныхСредств.Ссылка = РазмещениеЗаявок.ЗаявкаНаОперацию
	|ГДЕ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Проведен
	|	И ЗаявкаНаРасходованиеДенежныхСредств.БезакцептноеСписание
	|	И НЕ РазмещениеЗаявок.БезакцептноеСписание";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.РазмещениеЗаявок.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗаявкаНаОперацию.Установить(ВыборкаДетальныеЗаписи.ЗаявкаНаОперацию);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.БезакцептноеСписание = Истина;
		КонецЦикла;
	
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'Не удалось обновить регистр сведений ""%1"" по документу ""%2"" 
			|%3'"),
			"Платежные позиции", 
			ВыборкаДетальныеЗаписи.ЗаявкаНаОперацию, 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
							УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		КонецПопытки; 
		
	КонецЦикла;	

КонецПроцедуры

Процедура ЗаполнитьПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК ДоговорКонтрагента,
	|	ДоговорыКонтрагентов.ВерсияСоглашения.ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение КАК ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.ВерсияСоглашения ССЫЛКА Документ.ВерсияСоглашенияКоммерческийДоговор
	|	И ДоговорыКонтрагентов.ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение = ЗНАЧЕНИЕ(Перечисление.ПорядокОформленияСписанияТоваровПринятыхНаХранение.ПустаяСсылка)
	|	И НЕ ДоговорыКонтрагентов.ВерсияСоглашения.ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение = ЗНАЧЕНИЕ(Перечисление.ПорядокОформленияСписанияТоваровПринятыхНаХранение.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СправочникОбъект = ВыборкаДетальныеЗаписи.ДоговорКонтрагента.ПолучитьОбъект();
		СправочникОбъект.ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение 
			= ВыборкаДетальныеЗаписи.ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение;
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать элемент справочника ""%1"" 
				|%2'"),
				СправочникОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  	
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСпособРасчетаКоличестваДнейВВерсииСоглашенияКоммерческийДоговор() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсияСоглашенияКоммерческийДоговор.Ссылка КАК ВерсияСоглашенияСсылка,
		|	ВерсияСоглашенияКоммерческийДоговор.УдалитьКалендарь КАК УдалитьКалендарь
		|ИЗ
		|	Документ.ВерсияСоглашенияКоммерческийДоговор КАК ВерсияСоглашенияКоммерческийДоговор
		|ГДЕ
		|	ВерсияСоглашенияКоммерческийДоговор.СпособРасчетаКоличестваДней = ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаКоличестваДнейВПериоде.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл     
		
		ВерсияСоглашенияОбъект = ВыборкаДетальныеЗаписи.ВерсияСоглашенияСсылка.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УдалитьКалендарь) Тогда
			ВерсияСоглашенияОбъект.СпособРасчетаКоличестваДней = Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоРабочимДням;
		Иначе
			ВерсияСоглашенияОбъект.СпособРасчетаКоличестваДней = Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВерсияСоглашенияОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВариантКурсаДоговораПоСпособуОпределенияКурсаПлатежаИВариантКурсаДоговораУХ()Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	ДоговорыКонтрагентов.ВерсияСоглашения КАК ВерсияСоглашения
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.СпособОпределенияКурсаПлатежа = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа)
		|	И ДоговорыКонтрагентов.ВариантКурсаДоговора = ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.УстановленныйВДоговоре)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	ДоговорыКонтрагентов.ВерсияСоглашения КАК ВерсияСоглашения
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.ВариантКурсаДоговораУХ = ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыМеждуОрганизациями.Ссылка КАК Договор
		|ИЗ
		|	Справочник.ДоговорыМеждуОрганизациями КАК ДоговорыМеждуОрганизациями
		|ГДЕ
		|	ДоговорыМеждуОрганизациями.ВариантКурсаДоговораУХ = ЗНАЧЕНИЕ(Перечисление.ВариантыКурсаДоговора.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорОбъект = ВыборкаДетальныеЗаписи.Договор.ПолучитьОбъект();
		ДоговорОбъект.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.Переменный;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДоговорОбъект);
		
		// НАЧАЛО Николаев Павел 08.11.2024 Выполнение задач №000051555
		Если ОбщегоНазначения.СсылкаСуществует(ВыборкаДетальныеЗаписи.ВерсияСоглашения) Тогда
		// КОНЕЦ Николаев Павел 08.11.2024 Выполнение задач №000051555
			ВерсияСоглашенияОбъект = ВыборкаДетальныеЗаписи.ВерсияСоглашения.ПолучитьОбъект();		
			ВерсияСоглашенияОбъект.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.Переменный;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВерсияСоглашенияОбъект);
		// НАЧАЛО Николаев Павел 08.11.2024 Выполнение задач №000051555
		КонецЕсли;
		// КОНЕЦ Николаев Павел 08.11.2024 Выполнение задач №000051555
	КонецЦикла; 
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл       
		ДоговорОбъект = ВыборкаДетальныеЗаписи.Договор.ПолучитьОбъект();	
		ДоговорОбъект.ВариантКурсаДоговораУХ = ДоговорыКонтрагентовВстраиваниеУХ.ПолучитьВариантКурсаДоговораУХ(ДоговорОбъект);
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДоговорОбъект);
		
		// НАЧАЛО Николаев Павел 08.11.2024 Выполнение задач №000051555
		//Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВерсияСоглашения) И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаДетальныеЗаписи.ВерсияСоглашения, "ВариантКурсаДоговораУХ") Тогда
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВерсияСоглашения)
		   И ОбщегоНазначения.СсылкаСуществует(ВыборкаДетальныеЗаписи.ВерсияСоглашения) 
		   И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаДетальныеЗаписи.ВерсияСоглашения, "ВариантКурсаДоговораУХ") Тогда
		// КОНЕЦ Николаев Павел 08.11.2024 Выполнение задач №000051555
			ВерсияСоглашенияОбъект = ВыборкаДетальныеЗаписи.ВерсияСоглашения.ПолучитьОбъект();
			ВерсияСоглашенияОбъект.ВариантКурсаДоговораУХ = ДоговорыКонтрагентовВстраиваниеУХ.ПолучитьВариантКурсаДоговораУХ(ВерсияСоглашенияОбъект);
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВерсияСоглашенияОбъект);  
		КонецЕсли;
	КонецЦикла;  
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[2].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл       
		ДоговорОбъект = ВыборкаДетальныеЗаписи.Договор.ПолучитьОбъект();
		ДоговорОбъект.ВариантКурсаДоговораУХ = ДоговорыКонтрагентовВстраиваниеУХ.ПолучитьВариантКурсаДоговораУХ(ДоговорОбъект);
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДоговорОбъект);
	КонецЦикла;

КонецПроцедуры

