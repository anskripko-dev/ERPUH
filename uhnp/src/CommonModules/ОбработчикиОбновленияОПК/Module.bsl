КонецПроцедуры

Процедура ЗаполнитьДокументПланированияОтражениеФактическихДанныхБюджетирования()
	
	УстановитьПривилегированныйРежим(Истина);  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабличнаяЧасть.Ссылка КАК Документ,
	|	ТабличнаяЧасть.УдалитьДокументПланирования КАК УдалитьДокументПланирования,
	|	ТабличнаяЧасть.ДокументПланирования КАК ДокументПланирования,
	|	ИСТИНА КАК БДДС
	|ИЗ
	|	Документ.ОтражениеФактическихДанныхБюджетирования.БюджетДвиженияДенежныхСредств КАК ТабличнаяЧасть
	|ГДЕ
	|	ТабличнаяЧасть.УдалитьДокументПланирования <> НЕОПРЕДЕЛЕНО
	|	И ТабличнаяЧасть.ДокументПланирования = НЕОПРЕДЕЛЕНО
	|	И ТИПЗНАЧЕНИЯ(ТабличнаяЧасть.УдалитьДокументПланирования) <> ТИП(Справочник.Периоды)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТабличнаяЧасть.Ссылка,
	|	ТабличнаяЧасть.УдалитьДокументПланирования,
	|	ТабличнаяЧасть.ДокументПланирования,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ОтражениеФактическихДанныхБюджетирования.БюджетДоходовИРасходов КАК ТабличнаяЧасть
	|ГДЕ
	|	ТабличнаяЧасть.УдалитьДокументПланирования <> НЕОПРЕДЕЛЕНО
	|	И ТабличнаяЧасть.ДокументПланирования = НЕОПРЕДЕЛЕНО
	|	И ТИПЗНАЧЕНИЯ(ТабличнаяЧасть.УдалитьДокументПланирования) <> ТИП(Справочник.Периоды)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();

		ПараметрыОтбора = Новый Структура("УдалитьДокументПланирования", ВыборкаДетальныеЗаписи.УдалитьДокументПланирования);                                                                                     
		Если ВыборкаДетальныеЗаписи.БДДС Тогда
			СтрокиДанные = ДокументОбъект.БюджетДвиженияДенежныхСредств.НайтиСтроки(ПараметрыОтбора);   
		Иначе
			СтрокиДанные = ДокументОбъект.БюджетДоходовИРасходов.НайтиСтроки(ПараметрыОтбора);   
		КонецЕсли;
		
		Для каждого СтрокаДанные Из СтрокиДанные Цикл
			СтрокаДанные.ДокументПланирования = ВыборкаДетальныеЗаписи.УдалитьДокументПланирования;
		КонецЦикла;
	    	
		Если Не ДокументОбъект.Модифицированность() Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект); 
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'Не удалось записать документ ""%1"" 
			|%2'"),
			ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  		

	КонецЦикла;   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БюджетДвиженияДенежныхСредств.Ссылка КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.ОтражениеФактическихДанныхБюджетирования.БюджетДвиженияДенежныхСредств КАК БюджетДвиженияДенежныхСредств
	|ГДЕ
	|	БюджетДвиженияДенежныхСредств.ДокументПланирования ССЫЛКА Документ.УдалитьОперативныйПлан
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БюджетДоходовИРасходов.Ссылка
	|ИЗ
	|	Документ.ОтражениеФактическихДанныхБюджетирования.БюджетДоходовИРасходов КАК БюджетДоходовИРасходов
	|ГДЕ
	|	БюджетДоходовИРасходов.ДокументПланирования ССЫЛКА Документ.УдалитьОперативныйПлан
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документы.Документ КАК Документ,
	|	ВТ_Документы.Документ.Проведен КАК Проведен
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.БюджетДвиженияДенежныхСредств Цикл
			
			Если ТипЗнч(СтрокаТабличнойЧасти.ДокументПланирования) = Тип("ДокументСсылка.УдалитьОперативныйПлан") Тогда
				
				ДокументОбновления = СтрокаТабличнойЧасти.ДокументПланирования.ДокументОбновления; 
				
				Если ЗначениеЗаполнено(ДокументОбновления) Тогда
					СтрокаТабличнойЧасти.ДокументПланирования = ДокументОбновления;	
				КонецЕсли;				
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.БюджетДоходовИРасходов Цикл
			
			Если ТипЗнч(СтрокаТабличнойЧасти.ДокументПланирования) = Тип("ДокументСсылка.УдалитьОперативныйПлан") Тогда
				
				ДокументОбновления = СтрокаТабличнойЧасти.ДокументПланирования.ДокументОбновления; 
				
				Если ЗначениеЗаполнено(ДокументОбновления) Тогда
					СтрокаТабличнойЧасти.ДокументПланирования = ДокументОбновления;	
				КонецЕсли;				
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ДокументОбъект.Модифицированность() Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект); 
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'Не удалось записать документ ""%1"" 
			|%2'"),
			ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  		
		
	КонецЦикла;  

КонецПроцедуры

Процедура ОбновитьОперацииБюджетовПоФактПоБюджетам() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистраторПлановЛимитов.Ссылка КАК Регистратор,
	|	РегистраторПлановЛимитов.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.РегистраторПлановЛимитов КАК РегистраторПлановЛимитов
	|ГДЕ
	|	РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ОтражениеФактическихДанныхБюджетирования
	|	И РегистраторПлановЛимитов.Документ.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документы.Документ КАК Документ,
	|	ВТ_Документы.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УдалитьФактПоБюджетам КАК УдалитьФактПоБюджетам
	|		ПО ВТ_Документы.Регистратор = УдалитьФактПоБюджетам.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ВТ_Документы.Документ = ОперацииБюджетов.Регистратор
	|ГДЕ
	|	НЕ УдалитьФактПоБюджетам.Период ЕСТЬ NULL
	|	И ОперацииБюджетов.Период ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Документы.Документ.МоментВремени";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТаблицаОперацииБюджетов = Неопределено;
		
		ДополнительныеСвойства = Новый Структура;
		ПроведениеСерверОПК.ИнициализироватьДополнительныеСвойстваДляПроведения(ВыборкаДетальныеЗаписи.Документ, ДополнительныеСвойства);

		Документы.ОтражениеФактическихДанныхБюджетирования.ИнициализироватьДанныеДокумента(ВыборкаДетальныеЗаписи.Документ, ДополнительныеСвойства);  	
		ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаОперацииБюджетов", ТаблицаОперацииБюджетов);
		
		Если ТаблицаОперацииБюджетов = Неопределено Тогда
			Возврат;
		КонецЕсли;
	
		НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Документ);
		
		НаборЗаписей.Загрузить(ТаблицаОперацииБюджетов);
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, , , Истина);
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры   

#КонецОбласти 

#Область ПроцедурыИФункцииОперацииБюджетов

Процедура ОбновитьОперацииБюджетовЗакрытиеПлатежнойПозиции() Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистраторПлановЛимитов.Ссылка КАК Регистратор,
	|	РегистраторПлановЛимитов.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.РегистраторПлановЛимитов КАК РегистраторПлановЛимитов
	|ГДЕ
	|	РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ЗакрытиеПлатежнойПозиции
	|	И РегистраторПлановЛимитов.Документ.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документы.Документ КАК Документ,
	|	ВТ_Документы.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УдалитьЛимитыПоБюджетам КАК УдалитьЛимитыПоБюджетам
	|		ПО ВТ_Документы.Регистратор = УдалитьЛимитыПоБюджетам.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ВТ_Документы.Документ = ОперацииБюджетов.Регистратор
	|ГДЕ
	|	НЕ УдалитьЛимитыПоБюджетам.Период ЕСТЬ NULL
	|	И ОперацииБюджетов.Период ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Документы.Документ.МоментВремени";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();    
	
	Данные = Новый Структура("Алгоритм", "ЗакрытиеПлатежнойПозиции");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.Документ);
		Данные.Вставить("Регистратор", ВыборкаДетальныеЗаписи.Регистратор);  
		
		ЗаписатьПланыДокументаОперацииБюджетов(Данные);
	КонецЦикла;	

КонецПроцедуры    

