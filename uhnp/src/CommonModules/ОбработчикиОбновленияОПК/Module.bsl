Процедура ОбновитьПараметрыОперативногоПланирования()

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьПараметрыОперативногоПланирования.УдалитьВидБюджета КАК ВидБюджета,
	|	УдалитьПараметрыОперативногоПланирования.УдалитьПредназначение КАК Предназначение
	|ИЗ
	|	РегистрСведений.УдалитьПараметрыОперативногоПланирования КАК УдалитьПараметрыОперативногоПланирования
	|ГДЕ
	|	УдалитьПараметрыОперативногоПланирования.УдалитьВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)
	|	И НЕ УдалитьПараметрыОперативногоПланирования.УдалитьПредназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();   
	
	СоответствиеВидовБюджетов = Новый Соответствие;  
	СоответствиеВидовБюджетов.Вставить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств, ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	СоответствиеВидовБюджетов.Вставить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов, ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	СоответствиеВидовБюджетов.Вставить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов, ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл    	
		
		МенеджерЗаписи  = РегистрыСведений.УдалитьПараметрыОперативногоПланирования.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УдалитьВидБюджета 	 = ВыборкаДетальныеЗаписи.ВидБюджета;
		МенеджерЗаписи.УдалитьПредназначение = ВыборкаДетальныеЗаписи.Предназначение;   	
		МенеджерЗаписи.Прочитать();
		
		МенеджерЗаписи.УдалитьВидБюджета = СоответствиеВидовБюджетов.Получить(ВыборкаДетальныеЗаписи.Предназначение);
		 
		Попытка
			МенеджерЗаписи.Записать();   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1""
			|%2'"),
			Метаданные.РегистрыСведений.УдалитьПараметрыОперативногоПланирования.Представление(),    
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки; 

	КонецЦикла;  
	
КонецПроцедуры    

Процедура ОбновитьПараметрыЛимитированияИспользоватьЛимитирование()

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	РегистрСведений.УдалитьПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ИспользоватьЛимитирование = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.УдалитьПараметрыЛимитирования.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВыборкаДетальныеЗаписи.ВидБюджета);
		
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
		    Запись.ИспользоватьЛимитирование = Истина;				
		КонецЦикла;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр сведений ""%1"" по виду бюджета ""%2"" за период ""%3""
				|%4'"),
				Метаданные.РегистрыСведений.УдалитьПараметрыЛимитирования.Представление(),
				ВыборкаДетальныеЗаписи.ВидБюджета, 
				Формат(ВыборкаДетальныеЗаписи.Период, "ДФ=dd.MM.yyyy"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  

	КонецЦикла;

КонецПроцедуры 

Процедура ОбновитьПараметрыЛимитированияПериодичностьПланирования()
	
	УстановитьПривилегированныйРежим(Истина);   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьПараметрыОперативногоПланирования.УдалитьВидБюджета КАК ВидБюджета,
	|	УдалитьПараметрыОперативногоПланирования.УдалитьПериодичностьОперативногоПланирования КАК ПериодичностьОперативногоПланирования
	|ИЗ
	|	РегистрСведений.УдалитьПараметрыОперативногоПланирования КАК УдалитьПараметрыОперативногоПланирования
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьПараметрыЛимитирования КАК УдалитьПараметрыЛимитирования
	|		ПО УдалитьПараметрыОперативногоПланирования.УдалитьВидБюджета = УдалитьПараметрыЛимитирования.ВидБюджета
	|			И УдалитьПараметрыОперативногоПланирования.УдалитьПериодичностьОперативногоПланирования = УдалитьПараметрыЛимитирования.ПериодичностьПланирования
	|ГДЕ
	|	УдалитьПараметрыЛимитирования.ПериодичностьПланирования ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.УдалитьПараметрыЛимитирования.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВыборкаДетальныеЗаписи.ВидБюджета);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда   		
			Для Каждого Запись Из НаборЗаписей Цикл
				Запись.ПериодичностьПланирования = ВыборкаДетальныеЗаписи.ПериодичностьОперативногоПланирования;
			КонецЦикла;				
		Иначе	
			Запись = НаборЗаписей.Добавить();
			Запись.ВидБюджета = ВыборкаДетальныеЗаписи.ВидБюджета;
			Запись.ПериодичностьПланирования = 	ВыборкаДетальныеЗаписи.ПериодичностьОперативногоПланирования;  	
		КонецЕсли;

		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр сведений ""%1"" по виду бюджета ""%2""
				|%3'"),
				Метаданные.РегистрыСведений.УдалитьПараметрыЛимитирования.Представление(),
				ВыборкаДетальныеЗаписи.ВидБюджета,				
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  

	КонецЦикла;     
	
КонецПроцедуры 

Процедура ОбновитьПараметрыЛимитированияПланированиеЗакупок()
	
	УстановитьПривилегированныйРежим(Истина);
	
	СквозноеПланирование = Константы.СквозноеПланированиеПотребности.Получить();   
	
	Если Не СквозноеПланирование Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	РегистрСведений.УдалитьПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ПланированиеЗакупок";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  

	БюджетДвиженияДенежныхСредств = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
	
	НаборЗаписей = РегистрыСведений.УдалитьПараметрыЛимитирования.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидБюджета.Установить(БюджетДвиженияДенежныхСредств);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ПланированиеЗакупок = Истина; 
	КонецЦикла;	
	
	Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);       
	Исключение
		ТекстСообщения = СтрШаблон(НСтр(
		"ru = 'Не удалось обновить регистр сведений ""%1"" по виду бюджета ""%2""
		|%3'"),
		Метаданные.РегистрыСведений.УдалитьПараметрыЛимитирования.Представление(),
		БюджетДвиженияДенежныхСредств,				
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(
		ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
		УровеньЖурналаРегистрации.Ошибка,
		,
		, 
		ТекстСообщения);
	КонецПопытки;  
	
КонецПроцедуры 

Процедура ОбновитьРегистрПараметрыЛимитирования()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|*
	|ИЗ
	|	РегистрСведений.УдалитьПараметрыЛимитирования КАК УдалитьПараметрыЛимитирования
	|ГДЕ
	|	УдалитьПараметрыЛимитирования.ВидБюджета В (ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборДанных = РегистрыСведений.ПараметрыЛимитирования.СоздатьНаборЗаписей();
        НаборДанных.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период);
		НаборДанных.Отбор.ВидБюджета.Установить(ВыборкаДетальныеЗаписи.ВидБюджета);
       	
		ЗаполнитьЗначенияСвойств(НаборДанных.Добавить(), ВыборкаДетальныеЗаписи);
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборДанных);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр сведений ""%1"" по виду бюджета ""%2"" за период ""%3""
				|%4'"),
				Метаданные.РегистрыСведений.ПараметрыЛимитирования.Представление(), 
				ВыборкаДетальныеЗаписи.ВидБюджета, 
				Формат(ВыборкаДетальныеЗаписи.Период, "ДФ=dd.MM.yyyy"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ОбновитьПараметрыЛимитированияВалютыЦФО()

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
	|	УдалитьПараметрыЛимитированияЦФО.ЦФО КАК ЦФО,
	|	УдалитьПараметрыЛимитированияЦФО.ВалютаЛимитирования КАК ВалютаЛимитирования
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьПараметрыЛимитированияЦФО КАК УдалитьПараметрыЛимитированияЦФО
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаЛимитированияЦФО)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	ТаблицаВалют = Новый ТаблицаЗначений;  
	ТаблицаВалют.Колонки.Добавить("Период");
	ТаблицаВалют.Колонки.Добавить("ВидБюджета");
	ТаблицаВалют.Колонки.Добавить("ВалютаЛимитирования");
    ТаблицаВалют.Колонки.Добавить("Количество");

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.ПараметрыЛимитированияВалютыЦФО.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
		
		Попытка
			МенеджерЗаписи.Записать(Истина);   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1""
			|%2'"),
			Метаданные.РегистрыСведений.ПараметрыЛимитированияВалютыЦФО.Представление(),    
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;     
		
		НоваяСтрокаВалюты = ТаблицаВалют.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаВалюты, ВыборкаДетальныеЗаписи);
		НоваяСтрокаВалюты.Количество = 1;   	

	КонецЦикла; 
	
	ТаблицаВалют.Свернуть("Период, ВидБюджета, ВалютаЛимитирования", "Количество");
	ТаблицаВалют.Сортировать("Количество Убыв");  

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаЛимитированияЦФО)
	|	И ПараметрыЛимитирования.ВалютаПоУмолчанию = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)";

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
    
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		ПараметрыОтбора = Новый Структура("Период, ВидБюджета"); 
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ВыборкаДетальныеЗаписи);
		
		НайденныеСтроки = ТаблицаВалют.НайтиСтроки(ПараметрыОтбора); 
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВалютаПоУмолчанию = НайденныеСтроки[0].ВалютаЛимитирования;   	
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитирования.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период); 
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВыборкаДетальныеЗаписи.ВидБюджета);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			
			Если Не ЗначениеЗаполнено(Запись.ВалютаПоУмолчанию) Тогда
				Запись.ВалютаПоУмолчанию = ВалютаПоУмолчанию;	
			КонецЕсли;  

		КонецЦикла;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр сведений ""%1"" за период ""%2"", по виду бюджета ""%3"" 
				|%4'"),
				Метаданные.РегистрыСведений.ПараметрыЛимитирования.Представление(), 
				Формат(ВыборкаДетальныеЗаписи.Период, "ДФ=dd.MM.yyyy"), 
				ВыборкаДетальныеЗаписи.ВидБюджета, 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  	

	КонецЦикла; 
	
КонецПроцедуры    

