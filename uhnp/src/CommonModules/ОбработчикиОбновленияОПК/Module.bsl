	|	УдалитьОперативныйПлан.УдалитьБанковскийСчетКасса КАК УдалитьБанковскийСчетКасса,
	|	УдалитьОперативныйПлан.УдалитьВалютаОплаты КАК УдалитьВалютаОплаты,
	|	УдалитьОперативныйПлан.УдалитьСчетКонтрагента КАК УдалитьСчетКонтрагента,
	|	УдалитьОперативныйПлан.УдалитьЗапретПлатежаВПрочихВалютах КАК УдалитьЗапретПлатежаВПрочихВалютах,
	|	УдалитьОперативныйПлан.УдалитьПлатежВУсловныхЕдиницах КАК УдалитьПлатежВУсловныхЕдиницах,
	|	УдалитьОперативныйПлан.УдалитьФиксированныйСчетКонтрагента КАК УдалитьФиксированныйСчетКонтрагента,
	|	УдалитьОперативныйПлан.УдалитьФиксированныйСчетОрганизации КАК УдалитьФиксированныйСчетОрганизации,
	|	УдалитьОперативныйПлан.УдалитьЭтапПроекта КАК УдалитьЭтапПроекта,
	|	УдалитьОперативныйПлан.УдалитьСостояние КАК УдалитьСостояние,
	|	УдалитьОперативныйПлан.БалансКорректировок КАК БалансКорректировок,
	|	УдалитьОперативныйПлан.БалансКорректировокУпр КАК БалансКорректировокУпр,
	|	УдалитьОперативныйПлан.ЭтоКатегорияНоменклатуры КАК ЭтоКатегорияНоменклатуры,
	|	УдалитьОперативныйПлан.ХарактеристикиИспользуются КАК ХарактеристикиИспользуются,
	|	УдалитьОперативныйПлан.НазначениеРезерва_Контрагент КАК НазначениеРезерва_Контрагент,
	|	УдалитьОперативныйПлан.НазначениеРезерва_ДоговорКонтрагента КАК НазначениеРезерва_ДоговорКонтрагента,
	|	УдалитьОперативныйПлан.ДокументОбновления КАК ДокументОбновления,
	|	ВидыБюджетов.Ссылка КАК ВидБюджета,
	|	""ПланированиеИРезервирование"" КАК Алгоритм
	|ИЗ
	|	Документ.УдалитьОперативныйПлан КАК УдалитьОперативныйПлан
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|		ПО УдалитьОперативныйПлан.Предназначение = ВидыБюджетов.Предназначение
	|ГДЕ
	|	УдалитьОперативныйПлан.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.ПланированиеИРезервирование)
	|	И НЕ УдалитьОперативныйПлан.ПометкаУдаления
	|	И УдалитьОперативныйПлан.ДокументОбновления = НЕОПРЕДЕЛЕНО
	|	И УдалитьОперативныйПлан.Предназначение <> ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();  
	ВсегоПакетов = РезультатЗапроса.Количество()-1;    
	
	ТекущаяДата = ТекущаяДатаСеанса();
	Для НомерПакета = 0 По ВсегоПакетов Цикл 
	 
		ВыборкаДетальныеЗаписи = РезультатЗапроса[НомерПакета].Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Алгоритм = ВыборкаДетальныеЗаписи.Алгоритм;
			
			Если Алгоритм = "ВводЛимитов" Тогда  
				ИмяДокумента = "ОперативныйПлан";
			ИначеЕсли Алгоритм = "Резервирование" Тогда     
				ИмяДокумента = "Резервирование";
			ИначеЕсли Алгоритм = "ПланированиеИРезервирование" Тогда  
				ИмяДокумента = "Резервирование";
			КонецЕсли;
			
			ПерезаписатьСтарыйДокумент =  Ложь;
			Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДокументОбновления) Тогда
				НовыйДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
				НовыйДокументОбъект.УстановитьНовыйНомер();
				ПерезаписатьСтарыйДокумент = Истина;
			Иначе
				НовыйДокументОбъект = ВыборкаДетальныеЗаписи.ДокументОбновления.ПолучитьОбъект();
			КонецЕсли;
			
			СтарыйДокумент = ВыборкаДетальныеЗаписи.СтарыйДокумент;
			
			// Заполнение шапки документа
			ЗаполнитьЗначенияСвойств(НовыйДокументОбъект, ВыборкаДетальныеЗаписи); 
			
			// Заполнение табличных частей
			ТабличныеЧастиКПереносу = Новый Массив;  
			ТабличныеЧастиКПереносу.Добавить("ДвиженияОперации");
			ТабличныеЧастиКПереносу.Добавить("РезультатыКонтроля");
			ТабличныеЧастиКПереносу.Добавить("НастройкаАналитик");
			ТабличныеЧастиКПереносу.Добавить("Периоды");
			ТабличныеЧастиКПереносу.Добавить("ДополнительныеРеквизиты");
			
			Если ИмяДокумента = "Резервирование" Тогда
				ТабличныеЧастиКПереносу.Удалить(ТабличныеЧастиКПереносу.Найти("РезультатыКонтроля"));
			КонецЕсли;    
			
			Для Каждого ИмяТабличнойЧасти Из ТабличныеЧастиКПереносу Цикл
				ТабличнаяЧастьКПереносу = СтарыйДокумент[ИмяТабличнойЧасти].Выгрузить();
				НовыйДокументОбъект[ИмяТабличнойЧасти].Загрузить(ТабличнаяЧастьКПереносу);
			КонецЦикла;
			
			НачатьТранзакцию();
			
			Попытка                                                                
				       
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовыйДокументОбъект);
				
				Если Не ВыборкаДетальныеЗаписи.ПометкаУдаления Тогда
					ПеренестиДвиженияИзСтарогоОперационногоПлана(СтарыйДокумент, НовыйДокументОбъект.Ссылка, Алгоритм);
				КонецЕсли;
				
				Если ПерезаписатьСтарыйДокумент Тогда   
					СтарыйДокументОбъект = СтарыйДокумент.ПолучитьОбъект();
					СтарыйДокументОбъект.ДокументОбновления = НовыйДокументОбъект.Ссылка;
					ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СтарыйДокументОбъект); 
				КонецЕсли;  
				
				ЗагрузитьРезультатыКонтроляДокументов(НовыйДокументОбъект.Ссылка, СтарыйДокумент);
				
				ЗафиксироватьТранзакцию();
				
			Исключение      
				
				ОтменитьТранзакцию();	
				
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка, НовыйДокументОбъект.Метаданные(), 
				НовыйДокументОбъект.Ссылка,  
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			КонецПопытки;  
			
			Попытка
				ТекСостояние = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(СтарыйДокумент); 
				
				Если Не ТекСостояние = Неопределено Тогда  				
					УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(НовыйДокументОбъект.Ссылка, 
												ТекСостояние, ТекущаяДата, ВыборкаДетальныеЗаписи.Ответственный, , , Ложь);   
				КонецЕсли;  
			Исключение
			КонецПопытки;  
			
		КонецЦикла;  
		
	КонецЦикла;
	
КонецПроцедуры  

Процедура ОбновитьПериодичностьРезервирования()
	
	УстановитьПривилегированныйРежим(Истина);
	
    Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РезервированиеДвиженияОперации.Ссылка КАК Документ,
	|	РезервированиеДвиженияОперации.Период.Периодичность КАК ПериодПериодичность,
	|	РезервированиеДвиженияОперации.Ссылка.Периодичность КАК Периодичность
	|ИЗ
	|	Документ.Резервирование.ДвиженияОперации КАК РезервированиеДвиженияОперации
	|ГДЕ
	|	НЕ РезервированиеДвиженияОперации.Период.Периодичность = РезервированиеДвиженияОперации.Ссылка.Периодичность";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();   
		
		Периоды = ДокументОбъект.ДвиженияОперации.ВыгрузитьКолонку("Период"); 
		
		Если Периоды.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Периоды = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Периоды);
		
		ДокументОбъект.Периоды.Очистить();
		
		Для Каждого ЭлементПериод Из Периоды Цикл
			НоваяСтрока = ДокументОбъект.Периоды.Добавить();
			НоваяСтрока.Период = ЭлементПериод;
		КонецЦикла;   
		
		ДокументОбъект.ПериодОтчета = Периоды[0];
		ДокументОбъект.ПериодОтчетаОкончание = Периоды[Периоды.Количество()-1];
        ДокументОбъект.Периодичность = ДокументОбъект.ПериодОтчета.Периодичность;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'Не удалось обновить периодичность в документе ""%1""
			|%2'"),
			ВыборкаДетальныеЗаписи.Документ, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				,
				, 
				ТекстСообщения);
		КонецПопытки;  

	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьНастройкиАналитикРезервирование()

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОперативныхПланов.Ссылка КАК ВариантНастройки,
	|	ВидыОперативныхПланов.Аналитика КАК Аналитика,
	|	ВидыОперативныхПланов.Использование КАК Использование,
	|	ВидыОперативныхПланов.ЗначениеАналитики КАК ЗначениеАналитики,
	|	ВидыОперативныхПланов.ГруппаСтрок КАК ГруппаСтрок,
	|	ВидыОперативныхПланов.ОбязательноеЗаполнение КАК ОбязательноеЗаполнение,
	|	ВидыОперативныхПланов.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ВидыОперативныхПланов.ТипДанных КАК ТипДанных
	|ИЗ
	|	Справочник.ВидыОперативныхПланов.НастройкаАналитик КАК ВидыОперативныхПланов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Резервирование.Ссылка КАК Документ,
	|	Резервирование.ВариантНастройки КАК ВариантНастройки
	|ИЗ
	|	Документ.Резервирование КАК Резервирование";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();   
	
	ТаблицаВидыОперативныхПланов = РезультатыЗапроса[0].Выгрузить();	
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.ПриходРасход) Тогда
			ДокументОбъект.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;	 
		КонецЕсли;   
		
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.ДвиженияОперации Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ПриходРасход) Тогда
				СтрокаТабличнойЧасти.ПриходРасход = ДокументОбъект.ПриходРасход;	 
			КонецЕсли;   

		КонецЦикла; 	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВариантНастройки) Тогда
			
			ПараметрыОтбора = Новый Структура("ВариантНастройки", ВыборкаДетальныеЗаписи.ВариантНастройки);
			НастройкаАналитик = ТаблицаВидыОперативныхПланов.Скопировать(ПараметрыОтбора);  
			
			Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.НастройкаАналитик Цикл
				
				НайденнаяСтрока = НастройкаАналитик.Найти(СтрокаТабличнойЧасти.Аналитика, "Аналитика");  
				Если Не НайденнаяСтрока = Неопределено Тогда
					СтрокаТабличнойЧасти.Использование = НайденнаяСтрока.Использование;	
				КонецЕсли;
				
			КонецЦикла;    		
			
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.ПриходРасход) Тогда   		
			СтрокаНастройки = ДокументОбъект.НастройкаАналитик.Найти(Справочники.АналитикиОперативногоПланирования.ПриходРасход);
			Если Не СтрокаНастройки = Неопределено 
				И СтрокаНастройки.Использование = Перечисления.ИспользованиеАналитик.КлючеваяАналитика Тогда
				СтрокаНастройки.Использование = Перечисления.ИспользованиеАналитик.Колонка;	
			КонецЕсли;  		
		КонецЕсли;  		

		Если Не ДокументОбъект.Модифицированность() Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'Не удалось записать документ ""%1"" 
			|%2'"),
			ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  
		
	КонецЦикла;  
	    
КонецПроцедуры      

Процедура ЗаполнитьДокументПланированияРезервирование()

	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьОперативныйПлан.ДокументОбновления КАК Документ,
	|	УдалитьОперативныйПлан.ДокументПланирования.ДокументОбновления КАК ДокументОбновления,
	|	УдалитьОперативныйПлан.ДокументПланирования.Ссылка КАК ДокументПланирования
	|ИЗ
	|	Документ.УдалитьОперативныйПлан КАК УдалитьОперативныйПлан
	|ГДЕ
	|	УдалитьОперативныйПлан.ДокументОбновления ССЫЛКА Документ.Резервирование
	|	И НЕ УдалитьОперативныйПлан.ДокументОбновления.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРезервирование.Новый)
	|	И УдалитьОперативныйПлан.ДокументОбновления.ДокументПланирования = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();                         
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект(); 
		ДокументОбъект.ДокументПланирования = ВыборкаДетальныеЗаписи.ДокументОбновления;
		 			
		Попытка   
			ЗаполнитьАналитикаКонтроляБюджетныхЛимитовРезервов(ДокументОбъект, 
						ВыборкаДетальныеЗаписи.ДокументОбновления, ВыборкаДетальныеЗаписи.ДокументПланирования, Ложь);     
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать документ ""%1"" 
				|%2'"),
				ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;     
		
	КонецЦикла;  
	    
КонецПроцедуры

Процедура ЗаполнитьКонстантуИспользоватьРезервирование() Экспорт

	Константы.ИспользоватьРезервирование.Установить(Истина);
	
КонецПроцедуры 

#КонецОбласти 
 
#Область ПроцедурыИФункцииДокументыЗаявкаНаКорректировкуЛимитов

Процедура ОбновитьДокументыЗаявкаНаКорректировкуПланов() Экспорт
	
	СоздатьДокументыЗаявкаНаКорректировкуЛимитов();
	ОбновитьДокументыЗаявкаНаКорректировкуЛимитовДвиженияРесурсов();
	
КонецПроцедуры

Процедура СоздатьДокументыЗаявкаНаКорректировкуЛимитов()
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьЗаявкаНаКорректировкуЛимитов.Ссылка КАК СтарыйДокумент,
	|	УдалитьЗаявкаНаКорректировкуЛимитов.Дата КАК Дата,
	|	УдалитьЗаявкаНаКорректировкуЛимитов.Проведен КАК Проведен,
	|	УдалитьЗаявкаНаКорректировкуЛимитов.Ответственный КАК Ответственный,
	|	УдалитьЗаявкаНаКорректировкуЛимитов.Основание КАК ДокументОснование,
	|	УдалитьЗаявкаНаКорректировкуЛимитов.Организация КАК Организация,
	|	УдалитьЗаявкаНаКорректировкуЛимитов.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	Документ.УдалитьЗаявкаНаКорректировкуЛимитов КАК УдалитьЗаявкаНаКорректировкуЛимитов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УдалитьЗаявкаНаКорректировкуЛимитов.ДокументыОбновления КАК УдалитьЗаявкаНаКорректировкуЛимитовДокументыОбновления
	|		ПО УдалитьЗаявкаНаКорректировкуЛимитов.Ссылка = УдалитьЗаявкаНаКорректировкуЛимитовДокументыОбновления.Ссылка
	|ГДЕ
	|	УдалитьЗаявкаНаКорректировкуЛимитовДокументыОбновления.Ссылка ЕСТЬ NULL
	|	И НЕ УдалитьЗаявкаНаКорректировкуЛимитов.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл     	
		СоздатьДокументыЗаявкаНаКорректировкуПланов(ВыборкаДетальныеЗаписи); 			
	КонецЦикла;  

КонецПроцедуры   

Процедура ОбновитьДокументыЗаявкаНаКорректировкуЛимитовДвиженияРесурсов() 

	УстановитьПривилегированныйРежим(Истина); 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаКорректировкуПланов.Ссылка КАК Документ,
	|	ЗаявкаНаКорректировкуПланов.Проведен КАК Проведен,
	|	ЗаявкаНаКорректировкуПланов.МоментВремени КАК МоментВремени,
	|	ЗаявкаНаКорректировкуПланов.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	Документ.ЗаявкаНаКорректировкуПланов КАК ЗаявкаНаКорректировкуПланов
	|ГДЕ
	|	ЗаявкаНаКорректировкуПланов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ТабличныеЧасти = Новый Массив;
	ТабличныеЧасти.Добавить("Планы");   
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		СтарыйДокумент = ПолучитьСтарыйДокумент(ВыборкаДетальныеЗаписи.Документ);  
		
		Если Не ЗначениеЗаполнено(СтарыйДокумент) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		ДокументОбъект.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;  
		
		Для Каждого ИмяТабличнойЧасти Из ТабличныеЧасти Цикл
			
			Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
				
				Если ТипЗнч(СтрокаТабличнойЧасти.СтатьяБюджета) = Тип("СправочникСсылка.СтатьиДвиженияРесурсов") Тогда
					СтрокаТабличнойЧасти.СтатьяБюджета = СтрокаТабличнойЧасти.СтатьяБюджета.СтатьяБДР;	
				КонецЕсли; 		
				
			КонецЦикла;   	
			
		КонецЦикла; 
				
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);    
			
			// Запись движений
			Если ВыборкаДетальныеЗаписи.Проведен Тогда
				
				Данные = Новый Структура;      
				Данные.Вставить("Документ", СтарыйДокумент);
				Данные.Вставить("НовыйДокумент", ДокументОбъект.Ссылка);
				Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(СтарыйДокумент));
				Данные.Вставить("ДокументПланирования", ДокументОбъект.Ссылка);
				Данные.Вставить("ВидБюджета", ВыборкаДетальныеЗаписи.ВидБюджета);
				Данные.Вставить("ИзменитьВидБюджета", Истина);  
				Данные.Вставить("Алгоритм", "ЗаявкаНаКорректировкуЛимитов");   
				
				ЗаписатьПланыДокументаОперацииБюджетов(Данные);    

			КонецЕсли;

		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать документ ""%1"" 
				|%2'"),
				ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДокументыЗаявкаНаКорректировкуПланов(РеквизитыДокумента)

	ТаблицаЛимитыПоБюджетам = РеквизитыДокумента.СтарыйДокумент.ЛимитыПоБюджетам.Выгрузить();	
	
	ЭлементыВидБюджета = ТаблицаЛимитыПоБюджетам.ВыгрузитьКолонку("ВидБюджета"); 
	ВидыБюджетов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ЭлементыВидБюджета);
	
	Для Каждого ВидБюджета Из ВидыБюджетов Цикл
		
		// Шапка документа
		НовыйДокументОбъект = Документы.ЗаявкаНаКорректировкуПланов.СоздатьДокумент();
		НовыйДокументОбъект.Дата = РеквизитыДокумента.Дата; 
		НовыйДокументОбъект.ВидБюджета = ВидБюджета;  
		НовыйДокументОбъект.УстановитьНовыйНомер();   
		
		ЗаполнитьЗначенияСвойств(НовыйДокументОбъект, РеквизитыДокумента);
		
		СтрокиТаблицыЛимиты = ТаблицаЛимитыПоБюджетам.НайтиСтроки(Новый Структура("ВидБюджета", ВидБюджета));  
		
		// Табличная часть "Планы"
		Для Каждого СтрокаТаблицы Из СтрокиТаблицыЛимиты Цикл
			
			НоваяСтрокаПланы = НовыйДокументОбъект.Планы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПланы, СтрокаТаблицы); 
			НоваяСтрокаПланы.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
			НоваяСтрокаПланы.Сумма = ?(ЗначениеЗаполнено(СтрокаТаблицы.КОбеспечению), СтрокаТаблицы.КОбеспечению, СтрокаТаблицы.Сумма);
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.ПериодЛимитирования) Тогда   
				РеквизитыПериодЛимитирования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.ПериодЛимитирования, "ДатаНачала, Периодичность");
				НоваяСтрокаПланы.НачалоПериода = РеквизитыПериодЛимитирования.ДатаНачала;
				НоваяСтрокаПланы.Периодичность = РеквизитыПериодЛимитирования.Периодичность;
			КонецЕсли; 
			
			Если Не ЗначениеЗаполнено(НоваяСтрокаПланы.НачалоПериода) Тогда
				НоваяСтрокаПланы.НачалоПериода = ?(ЗначениеЗаполнено(НоваяСтрокаПланы.Период), НоваяСтрокаПланы.Период, РеквизитыДокумента.Дата);	
			КонецЕсли; 					
			
		КонецЦикла; 
		
		НовыйДокументОбъект.СуммаДокумента = НовыйДокументОбъект.Планы.Итог("Сумма") + НовыйДокументОбъект.Планы.Итог("СуммаРезерв");
		
		// Табличная часть "ДополнительныеРеквизиты"
		ТабличнаяЧастьКПереносу = РеквизитыДокумента.СтарыйДокумент.ДополнительныеРеквизиты.Выгрузить();
		НовыйДокументОбъект.ДополнительныеРеквизиты.Загрузить(ТабличнаяЧастьКПереносу);
		
		НачатьТранзакцию();
		
		Попытка 
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовыйДокументОбъект);   
			
			// Запись движений
			Если РеквизитыДокумента.Проведен Тогда
				
				Данные = Новый Структура;      
				Данные.Вставить("Документ", РеквизитыДокумента.СтарыйДокумент);
				Данные.Вставить("НовыйДокумент", НовыйДокументОбъект.Ссылка);
				Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(РеквизитыДокумента.СтарыйДокумент));
				Данные.Вставить("ДокументПланирования", НовыйДокументОбъект.Ссылка);
				Данные.Вставить("ВидБюджета", ВидБюджета);
				Данные.Вставить("ИзменитьВидБюджета", Ложь);  
				Данные.Вставить("Алгоритм", "ЗаявкаНаКорректировкуЛимитов");   
				
				ЗаписатьПланыДокументаОперацииБюджетов(Данные);    
				
			КонецЕсли;

			// Запись старого документа
			СтарыйДокументОбъект = РеквизитыДокумента.СтарыйДокумент.ПолучитьОбъект(); 
			
			Если СтарыйДокументОбъект.ДокументыОбновления.Найти(НовыйДокументОбъект.Ссылка) = Неопределено Тогда
				НоваяСтрока = СтарыйДокументОбъект.ДокументыОбновления.Добавить();
				НоваяСтрока.ДокументОбновления = НовыйДокументОбъект.Ссылка;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СтарыйДокументОбъект); 
			
			ЗафиксироватьТранзакцию();
			
		Исключение      
			
			ОтменитьТранзакцию();	
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка, 
			НовыйДокументОбъект.Метаданные(), 
			НовыйДокументОбъект.Ссылка,  
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;     	
		
	КонецЦикла; 
	
КонецПроцедуры 

Функция ПолучитьСтарыйДокумент(НовыйДокумент)
	
	УстановитьПривилегированныйРежим(Истина); 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьЗаявкаНаКорректировкуЛимитов.Ссылка КАК СтарыйДокумент
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.УдалитьЗаявкаНаКорректировкуЛимитов КАК УдалитьЗаявкаНаКорректировкуЛимитов
	|ГДЕ
	|	УдалитьЗаявкаНаКорректировкуЛимитов.УдалитьДокументОбновления = &НовыйДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УдалитьЗаявкаНаКорректировкуЛимитовДокументыОбновления.Ссылка
	|ИЗ
	|	Документ.УдалитьЗаявкаНаКорректировкуЛимитов.ДокументыОбновления КАК УдалитьЗаявкаНаКорректировкуЛимитовДокументыОбновления
	|ГДЕ
	|	УдалитьЗаявкаНаКорректировкуЛимитовДокументыОбновления.ДокументОбновления = &НовыйДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УдалитьКорректировкаЛимитов.Ссылка
	|ИЗ
	|	Документ.УдалитьКорректировкаЛимитов КАК УдалитьКорректировкаЛимитов
	|ГДЕ
	|	УдалитьКорректировкаЛимитов.ДокументОбновления = &НовыйДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УдалитьПереносЛимитов.Ссылка
	|ИЗ
	|	Документ.УдалитьПереносЛимитов КАК УдалитьПереносЛимитов
	|ГДЕ
	|	УдалитьПереносЛимитов.ДокументОбновления = &НовыйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	ВТ_Документы.СтарыйДокумент КАК СтарыйДокумент
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы";
	
	Запрос.УстановитьПараметр("НовыйДокумент", НовыйДокумент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	Возврат ВыборкаДетальныеЗаписи.СтарыйДокумент;
	
КонецФункции

#КонецОбласти  

#Область ПроцедурыИФункцииДокументыКорректировкиЛимитов

Процедура ОбновитьДокументыКорректировкаПланов() Экспорт

	СоздатьДокументыКорректировкиПланов();
	СоздатьДокументыКорректировкиПлановПереносЛимитов();
	ОбновитьДокументыКорректировкиПлановДвиженияРесурсов();
	
КонецПроцедуры

Процедура СоздатьДокументыКорректировкиПланов()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВидыОперацииПеренос = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;
	ВидыОперацииУвеличение = Перечисления.ВидыОперацийКорректировкаЛимитов.Увеличение;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьКорректировкаЛимитов.Ссылка КАК СтарыйДокумент,
	|	УдалитьКорректировкаЛимитов.ДокументОбновления КАК ДокументОбновления,
	|	УдалитьКорректировкаЛимитов.Дата КАК Дата,
	|	УдалитьКорректировкаЛимитов.Проведен КАК Проведен,
	|	УдалитьКорректировкаЛимитов.ВидБюджета КАК ВидБюджета,
	|	УдалитьКорректировкаЛимитов.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	УдалитьКорректировкаЛимитов.ГодЛимитирования КАК ГодЛимитирования,
	|	УдалитьКорректировкаЛимитов.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	УдалитьКорректировкаЛимитов.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	УдалитьКорректировкаЛимитов.ДокументДляОбеспечения КАК ДокументДляОбеспечения,
	|	УдалитьКорректировкаЛимитов.СуммаДокумента КАК СуммаДокумента,
	|	УдалитьКорректировкаЛимитов.Валюта КАК Валюта,
	|	УдалитьКорректировкаЛимитов.Обеспечено КАК Обеспечено,
	|	УдалитьКорректировкаЛимитов.Основание КАК ДокументОснование,
	|	УдалитьКорректировкаЛимитов.Комментарий КАК Комментарий,
	|	УдалитьКорректировкаЛимитов.Ответственный КАК Ответственный,
	|	УдалитьКорректировкаЛимитов.Контрагент КАК Контрагент,
	|	УдалитьКорректировкаЛимитов.Организация КАК Организация,
	|	УдалитьКорректировкаЛимитов.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	Документ.УдалитьКорректировкаЛимитов КАК УдалитьКорректировкаЛимитов
	|ГДЕ
	|	УдалитьКорректировкаЛимитов.ДокументОбновления = ЗНАЧЕНИЕ(Документ.КорректировкаПланов.ПустаяСсылка)
	|	И НЕ УдалитьКорректировкаЛимитов.ПометкаУдаления";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		// Шапка документа
		НовыйДокументОбъект = Документы.КорректировкаПланов.СоздатьДокумент();
		НовыйДокументОбъект.Дата = ВыборкаДетальныеЗаписи.Дата;
		НовыйДокументОбъект.УстановитьНовыйНомер();    
		
		ЗаполнитьЗначенияСвойств(НовыйДокументОбъект, ВыборкаДетальныеЗаписи);  
		
		Если ТипЗнч(ВыборкаДетальныеЗаписи.ДокументОснование) = Тип("ДокументСсылка.УдалитьЗаявкаНаКорректировкуЛимитов") Тогда
			
			БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
			БюджетДвиженияРесурсов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов;
			
			НайденДокументОснование = Ложь;

			ДокументыОбновления = ВыборкаДетальныеЗаписи.ДокументОснование.ДокументыОбновления; 
			
			Для Каждого СтрокаДокумента Из ДокументыОбновления Цикл
				Если СтрокаДокумента.ДокументОбновления.ВидБюджета = ВыборкаДетальныеЗаписи.ВидБюджета Тогда
					НовыйДокументОбъект.ДокументОснование = СтрокаДокумента.ДокументОбновления;	   
					НайденДокументОснование = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не НайденДокументОснование 
				И ВыборкаДетальныеЗаписи.ВидБюджета = БюджетДвиженияРесурсов Тогда
				
				Для Каждого СтрокаДокумента Из ДокументыОбновления Цикл
					Если СтрокаДокумента.ДокументОбновления.ВидБюджета = БюджетДоходовИРасходов 
						И СтрокаДокумента.ДокументОбновления.СуммаДокумента = ВыборкаДетальныеЗаписи.СуммаДокумента Тогда
						НовыйДокументОбъект.ДокументОснование = СтрокаДокумента.ДокументОбновления;	 
						Прервать;
					КонецЕсли;  				
				КонецЦикла;
				
			КонецЕсли;  		

		КонецЕсли; 	
		
		// Табличная часть "Требуется"    	
		Для Каждого СтрокаТребуется Из ВыборкаДетальныеЗаписи.СтарыйДокумент.Требуется Цикл
			
			НоваяСтрокаТребуется = НовыйДокументОбъект.Требуется.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТребуется, СтрокаТребуется);
			
			НоваяСтрокаТребуется.Сумма = СтрокаТребуется.КОбеспечению;
			НоваяСтрокаТребуется.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
			
			Если ЗначениеЗаполнено(СтрокаТребуется.ПериодЛимитирования) Тогда   
				РеквизитыПериодЛимитирования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТребуется.ПериодЛимитирования, "ДатаНачала, Периодичность");
				НоваяСтрокаТребуется.НачалоПериода = РеквизитыПериодЛимитирования.ДатаНачала;
				НоваяСтрокаТребуется.Периодичность = РеквизитыПериодЛимитирования.Периодичность;
			КонецЕсли; 
			
			Если Не ЗначениеЗаполнено(НоваяСтрокаТребуется.НачалоПериода) Тогда
				НоваяСтрокаТребуется.НачалоПериода = ?(ЗначениеЗаполнено(СтрокаТребуется.Период), СтрокаТребуется.Период, ВыборкаДетальныеЗаписи.Дата);	
			КонецЕсли; 	
			
		КонецЦикла;
		
		// Табличная часть "ОбеспечитьЗаСчет" 
		Для Каждого СтрокаОбеспечитьЗаСчет Из ВыборкаДетальныеЗаписи.СтарыйДокумент.ОбеспечитьЗаСчет Цикл  
			
			НоваяСтрокаОбеспечитьЗаСчет = НовыйДокументОбъект.ОбеспечитьЗаСчет.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОбеспечитьЗаСчет, СтрокаОбеспечитьЗаСчет);

			НоваяСтрокаОбеспечитьЗаСчет.Валюта = ВыборкаДетальныеЗаписи.Валюта; 
			НоваяСтрокаОбеспечитьЗаСчет.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;

			Если ЗначениеЗаполнено(СтрокаОбеспечитьЗаСчет.ПериодЛимитирования) Тогда   
				РеквизитыПериодЛимитирования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаОбеспечитьЗаСчет.ПериодЛимитирования, "ДатаНачала, Периодичность");
				НоваяСтрокаОбеспечитьЗаСчет.НачалоПериода = РеквизитыПериодЛимитирования.ДатаНачала;
				НоваяСтрокаОбеспечитьЗаСчет.Периодичность = РеквизитыПериодЛимитирования.Периодичность;
			КонецЕсли;   		
			
			Если Не ЗначениеЗаполнено(НоваяСтрокаОбеспечитьЗаСчет.НачалоПериода) Тогда
				НоваяСтрокаОбеспечитьЗаСчет.НачалоПериода = ?(ЗначениеЗаполнено(СтрокаОбеспечитьЗаСчет.Период), СтрокаОбеспечитьЗаСчет.Период, ВыборкаДетальныеЗаписи.Дата);	
			КонецЕсли;  
			
		КонецЦикла;  
		
		// Табличная часть "ДополнительныеРеквизиты"
		ТабличнаяЧастьКПереносу = ВыборкаДетальныеЗаписи.СтарыйДокумент.ДополнительныеРеквизиты.Выгрузить();
		НовыйДокументОбъект.ДополнительныеРеквизиты.Загрузить(ТабличнаяЧастьКПереносу);
		
		НачатьТранзакцию();
		
		Попытка 
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовыйДокументОбъект);  
			
			// Запись движений  
			Если ВыборкаДетальныеЗаписи.Проведен Тогда
				
				Данные = Новый Структура;      
				Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.СтарыйДокумент);
				Данные.Вставить("НовыйДокумент", НовыйДокументОбъект.Ссылка);
				Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(ВыборкаДетальныеЗаписи.СтарыйДокумент));
				Данные.Вставить("ДокументПланирования", НовыйДокументОбъект.ДокументОснование);
				Данные.Вставить("ВидБюджета", ВыборкаДетальныеЗаписи.ВидБюджета);
				Данные.Вставить("ИзменитьВидБюджета", Ложь);  
				Данные.Вставить("Алгоритм", "КорректировкаЛимитов");   
				
				ЗаписатьПланыДокументаОперацииБюджетов(Данные);    

			КонецЕсли;

			// Запись старого документа
			СтарыйДокументОбъект = ВыборкаДетальныеЗаписи.СтарыйДокумент.ПолучитьОбъект(); 
			СтарыйДокументОбъект.ДокументОбновления = НовыйДокументОбъект.Ссылка;

			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СтарыйДокументОбъект);  
			
			// Загрузка результатов контроля
			ЗагрузитьРезультатыКонтроляДокументов(НовыйДокументОбъект.Ссылка, ВыборкаДетальныеЗаписи.СтарыйДокумент);
			
			ЗафиксироватьТранзакцию();
			
		Исключение      
			
			ОтменитьТранзакцию();	
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, 
									НовыйДокументОбъект.Метаданные(), НовыйДокументОбъект.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры   

Процедура СоздатьДокументыКорректировкиПлановПереносЛимитов() 

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьПереносЛимитов.Ссылка КАК СтарыйДокумент,
	|	УдалитьПереносЛимитов.ДокументОбновления КАК ДокументОбновления,
	|	УдалитьПереносЛимитов.Дата КАК Дата,
	|	УдалитьПереносЛимитов.Проведен КАК Проведен,
	|	УдалитьПереносЛимитов.ВидБюджета КАК ВидБюджета,
	|	УдалитьПереносЛимитов.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	УдалитьПереносЛимитов.ГодЛимитирования КАК ГодЛимитирования,
	|	УдалитьПереносЛимитов.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	УдалитьПереносЛимитов.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	УдалитьПереносЛимитов.СуммаДокумента КАК СуммаДокумента,
	|	УдалитьПереносЛимитов.Валюта КАК Валюта,
	|	УдалитьПереносЛимитов.Комментарий КАК Комментарий,
	|	УдалитьПереносЛимитов.Ответственный КАК Ответственный,
	|	УдалитьПереносЛимитов.ПометкаУдаления КАК ПометкаУдаления,
	|	УдалитьПереносЛимитов.ВидОперации КАК ВидОперации,
	|	УдалитьПереносЛимитов.ПериодЛимитирования КАК ПериодЛимитирования,
	|	УдалитьПереносЛимитов.ЦФО КАК ЦФО,
	|	УдалитьПереносЛимитов.Проект КАК Проект,
	|	УдалитьПереносЛимитов.СтатьяБюджета КАК СтатьяБюджета,
	|	УдалитьПереносЛимитов.Аналитика1 КАК Аналитика1,
	|	УдалитьПереносЛимитов.Аналитика2 КАК Аналитика2,
	|	УдалитьПереносЛимитов.Аналитика3 КАК Аналитика3,
	|	УдалитьПереносЛимитов.Аналитика4 КАК Аналитика4,
	|	УдалитьПереносЛимитов.Аналитика5 КАК Аналитика5,
	|	УдалитьПереносЛимитов.Аналитика6 КАК Аналитика6
	|ИЗ
	|	Документ.УдалитьПереносЛимитов КАК УдалитьПереносЛимитов
	|ГДЕ
	|	УдалитьПереносЛимитов.ДокументОбновления = ЗНАЧЕНИЕ(Документ.КорректировкаПланов.ПустаяСсылка)
	|	И НЕ УдалитьПереносЛимитов.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПараметрыПереноса = ПолучитьПараметрыПереноса(ВыборкаДетальныеЗаписи.СтарыйДокумент);
		
		// Шапка документа
		НовыйДокументОбъект = Документы.КорректировкаПланов.СоздатьДокумент();
		НовыйДокументОбъект.Дата = ВыборкаДетальныеЗаписи.Дата;
		НовыйДокументОбъект.УстановитьНовыйНомер();    
		
		ЗаполнитьЗначенияСвойств(НовыйДокументОбъект, ВыборкаДетальныеЗаписи);  
		
		Если ВыборкаДетальныеЗаписи.ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПроизвольный Тогда
			// Табличная часть "Требуется"
			Для Каждого СтрокаПолучатель Из ВыборкаДетальныеЗаписи.СтарыйДокумент.Получатель Цикл
				
				НоваяСтрокаТребуется = НовыйДокументОбъект.Требуется.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТребуется, СтрокаПолучатель);
				
				НоваяСтрокаТребуется.Валюта = ВыборкаДетальныеЗаписи.Валюта;
				НоваяСтрокаТребуется.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
				
				Если ЗначениеЗаполнено(СтрокаПолучатель.ПериодЛимитирования) Тогда   
					РеквизитыПериодЛимитирования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаПолучатель.ПериодЛимитирования, "ДатаНачала, Периодичность");
					НоваяСтрокаТребуется.НачалоПериода = РеквизитыПериодЛимитирования.ДатаНачала;
					НоваяСтрокаТребуется.Периодичность = РеквизитыПериодЛимитирования.Периодичность;
				КонецЕсли; 
				
				Если Не ЗначениеЗаполнено(НоваяСтрокаТребуется.НачалоПериода) Тогда
					НоваяСтрокаТребуется.НачалоПериода = ?(ЗначениеЗаполнено(СтрокаПолучатель.Период), СтрокаПолучатель.Период, ВыборкаДетальныеЗаписи.Дата);	
				КонецЕсли; 				
				
			КонецЦикла;
			
		Иначе
			
			Для Каждого СтрокаИсточник Из ВыборкаДетальныеЗаписи.СтарыйДокумент.Источник Цикл  
				
				НоваяСтрокаТребуется = НовыйДокументОбъект.Требуется.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТребуется, СтрокаИсточник); 
				
				Если ПараметрыПереноса.ФлагПериод Тогда
					НоваяСтрокаТребуется.ПериодЛимитирования = ВыборкаДетальныеЗаписи.ПериодЛимитирования;	
				КонецЕсли;
				
				Если ПараметрыПереноса.ФлагЦФО Тогда
					НоваяСтрокаТребуется.ЦФО = ВыборкаДетальныеЗаписи.ЦФО;	
				КонецЕсли;
				
				Если ПараметрыПереноса.ФлагПроект Тогда
					НоваяСтрокаТребуется.Проект = ВыборкаДетальныеЗаписи.Проект;	
				КонецЕсли;
				
				Если ПараметрыПереноса.ФлагСтатья Тогда
					НоваяСтрокаТребуется.СтатьяБюджета = ВыборкаДетальныеЗаписи.СтатьяБюджета;	
					НоваяСтрокаТребуется.Аналитика1 = ВыборкаДетальныеЗаписи.Аналитика1; 
					НоваяСтрокаТребуется.Аналитика2 = ВыборкаДетальныеЗаписи.Аналитика2;
					НоваяСтрокаТребуется.Аналитика3 = ВыборкаДетальныеЗаписи.Аналитика3;
					НоваяСтрокаТребуется.Аналитика4 = ВыборкаДетальныеЗаписи.Аналитика4;
					НоваяСтрокаТребуется.Аналитика5 = ВыборкаДетальныеЗаписи.Аналитика5;
					НоваяСтрокаТребуется.Аналитика6 = ВыборкаДетальныеЗаписи.Аналитика6;
				КонецЕсли;
				
				НоваяСтрокаТребуется.Валюта = ВыборкаДетальныеЗаписи.Валюта; 
				НоваяСтрокаТребуется.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;            
				
				Если ЗначениеЗаполнено(СтрокаИсточник.ПериодЛимитирования) Тогда   
					РеквизитыПериодЛимитирования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаИсточник.ПериодЛимитирования, "ДатаНачала, Периодичность");
					НоваяСтрокаТребуется.НачалоПериода = РеквизитыПериодЛимитирования.ДатаНачала;
					НоваяСтрокаТребуется.Периодичность = РеквизитыПериодЛимитирования.Периодичность;
				КонецЕсли;   		
				
				Если Не ЗначениеЗаполнено(НоваяСтрокаТребуется.НачалоПериода) Тогда
					НоваяСтрокаТребуется.НачалоПериода = ?(ЗначениеЗаполнено(СтрокаИсточник.Период), СтрокаИсточник.Период, ВыборкаДетальныеЗаписи.Дата);	
				КонецЕсли;
				
			КонецЦикла; 
	
		КонецЕсли;
		
			// Табличная часть "ОбеспечитьЗаСчет"   
			Для Каждого СтрокаИсточник Из ВыборкаДетальныеЗаписи.СтарыйДокумент.Источник Цикл  
				
				НоваяСтрокаОбеспечитьЗаСчет = НовыйДокументОбъект.ОбеспечитьЗаСчет.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаОбеспечитьЗаСчет, СтрокаИсточник);
				
				НоваяСтрокаОбеспечитьЗаСчет.Валюта = ВыборкаДетальныеЗаписи.Валюта; 
				НоваяСтрокаОбеспечитьЗаСчет.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;            
				НоваяСтрокаОбеспечитьЗаСчет.ВидОперации = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;
				
				Если ЗначениеЗаполнено(СтрокаИсточник.ПериодЛимитирования) Тогда   
					РеквизитыПериодЛимитирования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаИсточник.ПериодЛимитирования, "ДатаНачала, Периодичность");
					НоваяСтрокаОбеспечитьЗаСчет.НачалоПериода = РеквизитыПериодЛимитирования.ДатаНачала;
					НоваяСтрокаОбеспечитьЗаСчет.Периодичность = РеквизитыПериодЛимитирования.Периодичность;
				КонецЕсли;   		
				
				Если Не ЗначениеЗаполнено(НоваяСтрокаОбеспечитьЗаСчет.НачалоПериода) Тогда
					НоваяСтрокаОбеспечитьЗаСчет.НачалоПериода = ?(ЗначениеЗаполнено(СтрокаИсточник.Период), СтрокаИсточник.Период, ВыборкаДетальныеЗаписи.Дата);	
				КонецЕсли;
				
			КонецЦикла; 
		
		// Табличная часть "ДополнительныеРеквизиты"  	
		ДополнительныеРеквизиты = ВыборкаДетальныеЗаписи.СтарыйДокумент.ДополнительныеРеквизиты.Выгрузить();
		НовыйДокументОбъект.ДополнительныеРеквизиты.Загрузить(ДополнительныеРеквизиты);
				
		НачатьТранзакцию();
		
		Попытка                                                                
			
			// Запись нового документа
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовыйДокументОбъект);
			
			// Запись движений
			Если ВыборкаДетальныеЗаписи.Проведен Тогда
				
				Данные = Новый Структура;      
				Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.СтарыйДокумент);
				Данные.Вставить("НовыйДокумент", НовыйДокументОбъект.Ссылка);
				Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(ВыборкаДетальныеЗаписи.СтарыйДокумент));
				Данные.Вставить("ДокументПланирования", НовыйДокументОбъект.Ссылка);
				Данные.Вставить("ВидБюджета", ВыборкаДетальныеЗаписи.ВидБюджета);
				Данные.Вставить("ИзменитьВидБюджета", Ложь);  
				Данные.Вставить("Алгоритм", "КорректировкаЛимитов");   
				
				ЗаписатьПланыДокументаОперацииБюджетов(Данные);    

			КонецЕсли;
			
			// Запись старого документа
			СтарыйДокументОбъект = ВыборкаДетальныеЗаписи.СтарыйДокумент.ПолучитьОбъект();
			СтарыйДокументОбъект.ДокументОбновления = НовыйДокументОбъект.Ссылка;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СтарыйДокументОбъект); 
			
			// Загрузка результатов контроля
			ЗагрузитьРезультатыКонтроляДокументов(НовыйДокументОбъект.Ссылка, ВыборкаДетальныеЗаписи.СтарыйДокумент);
			
			ЗафиксироватьТранзакцию();
			
		Исключение      
			
			ОтменитьТранзакцию();	
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, НовыйДокументОбъект.Метаданные(), 
									НовыйДокументОбъект.Ссылка,  ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки; 	
								
		Попытка
			ТекСостояние = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(ВыборкаДетальныеЗаписи.СтарыйДокумент); 
			
			Если Не ТекСостояние = Неопределено Тогда  				
				УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(НовыйДокументОбъект.Ссылка, 
													ТекСостояние, ТекущаяДатаСеанса(), ВыборкаДетальныеЗаписи.Ответственный, , , Ложь);   
			КонецЕсли;  
		Исключение
		КонецПопытки;  
		
	КонецЦикла; 
	
КонецПроцедуры  

Функция ПолучитьПараметрыПереноса(ДокументСсылка)
	
	Результат = Новый Структура;
	Результат.Вставить("ФлагЦФО", Ложь);
	Результат.Вставить("ФлагПроект", Ложь);
	Результат.Вставить("ФлагСтатья", Ложь);
	Результат.Вставить("ФлагПериод", Ложь);
	
	ВидОперации = ДокументСсылка.ВидОперации;
	
	// ЦФО
	Если ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатьяЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатьяЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяЦФОПроект Тогда
		Результат.ФлагЦФО = Истина;
	КонецЕсли;
	
	// Проект
	Если ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатьяПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатьяЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяЦФОПроект Тогда
		Результат.ФлагПроект = Истина;
	КонецЕсли;
	
	// СтатьяБюджета
	Если ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатья
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатьяЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатьяПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносСтатьяЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатья
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяЦФОПроект Тогда
		Результат.ФлагСтатья = Истина;
	КонецЕсли;
	
	// ПериодЛимитирования
	Если ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериод
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодЦФОПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатья
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяЦФО
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяПроект
		ИЛИ ВидОперации = Перечисления.УдалитьВидыОперацийПереносЛимитов.ПереносПериодСтатьяЦФОПроект Тогда
		Результат.ФлагПериод = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьДокументыКорректировкиПлановДвиженияРесурсов() 

	УстановитьПривилегированныйРежим(Истина); 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаПланов.Ссылка КАК Документ,
	|	КорректировкаПланов.Проведен КАК Проведен,
	|	КорректировкаПланов.МоментВремени КАК МоментВремени,
	|	КорректировкаПланов.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	Документ.КорректировкаПланов КАК КорректировкаПланов
	|ГДЕ
	|	КорректировкаПланов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ТабличныеЧасти = Новый Массив;
	ТабличныеЧасти.Добавить("Требуется");
    ТабличныеЧасти.Добавить("ОбеспечитьЗаСчет");
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		СтарыйДокумент = ПолучитьСтарыйДокумент(ВыборкаДетальныеЗаписи.Документ);  
		
		Если Не ЗначениеЗаполнено(СтарыйДокумент) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		ДокументОбъект.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;  
		
		Для Каждого ИмяТабличнойЧасти Из ТабличныеЧасти Цикл
			
			Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
				
				Если ТипЗнч(СтрокаТабличнойЧасти.СтатьяБюджета) = Тип("СправочникСсылка.СтатьиДвиженияРесурсов") Тогда
					СтрокаТабличнойЧасти.СтатьяБюджета = СтрокаТабличнойЧасти.СтатьяБюджета.СтатьяБДР;	
				КонецЕсли; 		
				
			КонецЦикла;   	
			
		КонецЦикла; 
				
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);    
			
			// Запись движений
			Если ВыборкаДетальныеЗаписи.Проведен Тогда
				
				Данные = Новый Структура;      
				Данные.Вставить("Документ", СтарыйДокумент);
				Данные.Вставить("НовыйДокумент", ДокументОбъект.Ссылка);
				Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(СтарыйДокумент));
				Данные.Вставить("ДокументПланирования", ДокументОбъект.Ссылка);
				Данные.Вставить("ВидБюджета", ВыборкаДетальныеЗаписи.ВидБюджета);
				Данные.Вставить("ИзменитьВидБюджета", Истина);  
				Данные.Вставить("Алгоритм", "КорректировкаЛимитов");   
				
				ЗаписатьПланыДокументаОперацииБюджетов(Данные);    

			КонецЕсли;

		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать документ ""%1"" 
				|%2'"),
				ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти   

#Область ПроцедурыИФункцииДокументыЗаявкаНаРасходованиеДенежныхСредств

Процедура ОбновитьДокументыЗаявкаНаРасходованиеДенежныхСредств() Экспорт

	ЗаполнитьРеквизитыПриобретениеВалютыДокументаЗаявкаНаРасходованиеДенежныхСредств();
	ОбновитьОперацииБюджетовЗаявкаНаРасходованиеДенежныхСредств();
	ЗаполнитьДокументПланированияЗаявкаНаРасходованиеДенежныхСредств();
	
КонецПроцедуры 

Процедура ЗаполнитьРеквизитыПриобретениеВалютыДокументаЗаявкаНаРасходованиеДенежныхСредств() 
	
	УстановитьПривилегированныйРежим(Истина);   

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
	|ГДЕ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Проведен
	|	И ЗаявкаНаРасходованиеДенежныхСредств.ДатаЗачисления = ДАТАВРЕМЯ(1, 1, 1)
	|	И ЗаявкаНаРасходованиеДенежныхСредств.ВидОперацииУХ = ЗНАЧЕНИЕ(Справочник.ВидыОперацийУХ.ПриобретениеВалюты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию,
	|	РазмещениеЗаявок.ДатаИсполнения КАК ДатаИсполнения
	|ИЗ
	|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|ГДЕ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию В
	|			(ВЫБРАТЬ
	|				ВТ_Документы.Документ КАК Документ
	|			ИЗ
	|				ВТ_Документы КАК ВТ_Документы)
	|	И РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|	И НЕ РазмещениеЗаявок.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1)";
	
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.ЗаявкаНаОперацию.ПолучитьОбъект();
		ДокументОбъект.ДатаЗачисления = ВыборкаДетальныеЗаписи.ДатаИсполнения;  

		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать документ ""%1"" 
				|%2'"),
				ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;  
	
КонецПроцедуры  

Процедура ОбновитьОперацииБюджетовЗаявкаНаРасходованиеДенежныхСредств()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистраторПлановЛимитов.Ссылка КАК Регистратор,
	|	РегистраторПлановЛимитов.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.РегистраторПлановЛимитов КАК РегистраторПлановЛимитов
	|ГДЕ
	|	РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
	|	И РегистраторПлановЛимитов.Документ.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документы.Документ КАК Документ,
	|	ВТ_Документы.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УдалитьЛимитыПоБюджетам КАК УдалитьЛимитыПоБюджетам
	|		ПО ВТ_Документы.Регистратор = УдалитьЛимитыПоБюджетам.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ВТ_Документы.Документ = ОперацииБюджетов.Регистратор
	|ГДЕ
	|	НЕ УдалитьЛимитыПоБюджетам.Период ЕСТЬ NULL
	|	И ОперацииБюджетов.Период ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Документы.Документ.МоментВремени";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();    

	Данные = Новый Структура("Алгоритм", "ЗаявкаНаРасходованиеДенежныхСредств");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.Документ);
		Данные.Вставить("Регистратор", ВыборкаДетальныеЗаписи.Регистратор);  
		
		ЗаписатьПланыДокументаОперацииБюджетов(Данные);
	КонецЦикла;

КонецПроцедуры  

Процедура ЗаполнитьДокументПланированияЗаявкаНаРасходованиеДенежныхСредств()

	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК Документ,
	|	ЗаявкаНаРасходованиеДенежныхСредств.УдалитьДокументПланирования КАК ДокументПланирования,
