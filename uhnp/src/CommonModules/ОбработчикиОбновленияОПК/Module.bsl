Процедура ОбновитьСтавкиНдсЗаявкаНаРасход() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗаявкаНаРасходДвиженияОперации.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявкаНаРасход.ДвиженияОперации КАК ЗаявкаНаРасходДвиженияОперации
		|ГДЕ
		|	ЗаявкаНаРасходДвиженияОперации.УдалитьСтавкаНДС <> &ПустаяСтавкаНДС
		|	И НЕ ЗаявкаНаРасходДвиженияОперации.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПустаяСтавкаНДС", Перечисления.СтавкиНДС.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокументСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		Для Каждого ТекДвиженияОперации Из ДокументОбъект.ДвиженияОперации Цикл
			Если (ЗначениеЗаполнено(ТекДвиженияОперации.УдалитьСтавкаНДС)) И (НЕ ЗначениеЗаполнено(ТекДвиженияОперации.СтавкаНДС))Тогда
				НоваяСтавка = ВстраиваниеУХВызовСервера.ПолучитьСтавкуНДС(ТекДвиженияОперации.УдалитьСтавкаНДС);
				ТекДвиженияОперации.СтавкаНДС = НоваяСтавка;
			Иначе
				// Пропускаем.
			КонецЕсли;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	КонецЦикла;
КонецПроцедуры		// ОбновитьСтавкиНдсЗаявкаНаРасход()

