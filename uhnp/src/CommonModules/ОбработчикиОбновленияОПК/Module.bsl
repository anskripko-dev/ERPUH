	|	И ПланируемыйДоход.ДокументПланирования = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|	И НЕ ПланируемыйДоход.УдалитьДокументПланирования.ДокументОбновления = НЕОПРЕДЕЛЕНО";
	
	РезультатЗапроса = Запрос.Выполнить();                         
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект(); 
		ДокументОбъект.ДокументПланирования = ВыборкаДетальныеЗаписи.ДокументОбновления;
		 			
		Попытка   
			ЗаполнитьАналитикаКонтроляБюджетныхЛимитовРезервов(ДокументОбъект, 
						ВыборкаДетальныеЗаписи.ДокументОбновления, ВыборкаДетальныеЗаписи.ДокументПланирования);     
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать документ ""%1"" 
				|%2'"),
				ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;     
		
	КонецЦикла;     
	
КонецПроцедуры

#КонецОбласти   

#Область ПроцедурыИФункцииДокументыВерсииСоглашений

Процедура ОбновитьДокументыВерсииСоглашений() Экспорт
	
	ЗаполнитьИспользованиеГрафикаРасчетовВДокументах(); 
	ЗаполнитьОсновнаяСтатьяИсполнениеВерсияСоглашенияКоммерческийДоговор();
	ЗаполнитьДокументПланированияВерсияСоглашения();  
	ОбновитьОперацииБюджетовВерсииСоглашений();
         
КонецПроцедуры 

Процедура ЗаполнитьИспользованиеГрафикаРасчетовВДокументах() 
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивИменТаблиц = Новый Массив;
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияАккредитив");
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияБанковскаяГарантия");
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияВалютноПроцентныйСвоп");
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияВалютныйСвоп");
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияВалютныйФорвард");
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияДепозит");
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияКоммерческийДоговор");
	МассивИменТаблиц.Добавить("Документ.ВерсияСоглашенияКредит");  

	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Документ,
	|	Таблица.УдалитьРежимИспользованияГрафика КАК ИспользованиеГрафикаРасчетовБДДС
	|ИЗ
	|	_ИмяТаблицы_ КАК Таблица";
	
	ТекстыЗапроса = Новый Массив;
	Для Каждого ИмяТаблицы Из МассивИменТаблиц Цикл
		ТекстЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "_ИмяТаблицы_", ИмяТаблицы);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
	КонецЦикла;
	
	Запрос = Новый Запрос;
    Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначенияОПК.ТекстОбъединитьВсеЗапроса());
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект = Выборка.Документ.ПолучитьОбъект();
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.ИспользованиеГрафикаРасчетовБДР) Тогда
			ДокументОбъект.ИспользованиеГрафикаРасчетовБДР = Перечисления.РежимыИспользованияГрафика.РезервированиеБюджетаИКонтрольСоблюденияГрафика;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.ИспользованиеГрафикаРасчетовБДДС) Тогда
			ДокументОбъект.ИспользованиеГрафикаРасчетовБДДС = Выборка.ИспользованиеГрафикаРасчетовБДДС;
		КонецЕсли;
		
		ИспользоватьГрафикРасчетов = Истина;
		ГрафикДоговора = Перечисления.ГрафикиДоговора.НеИспользовать;
		
		Если ТипЗнч(Выборка.Документ) = Тип("ДокументСсылка.ВерсияСоглашенияКоммерческийДоговор") Тогда
			
			Если ЗначениеЗаполнено(ДокументОбъект.ГрафикДоговора) Тогда
				Продолжить;
			КонецЕсли;
			
			СпособФормированияПлатежей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Документ,"УдалитьСпособФормированияПлатежей");  		
			ИспользоватьГрафикРасчетов = (СпособФормированияПлатежей = Перечисления.СпособыФормированияПлатежейПоДоговору.ПоГрафикуПлатежей);	
			
			Если ИспользоватьГрафикРасчетов Тогда
				ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикРасчетов;	
			КонецЕсли;   
			
			ДокументОбъект.ГрафикДоговора = ГрафикДоговора;
			 
		КонецЕсли;   
		
		ЕстьДоговор = Ложь;
		
		Попытка
			
			ДоговорКонтрагента = ДокументОбъект.ДоговорКонтрагента;
			
			Если ЗначениеЗаполнено(ДоговорКонтрагента) 
				И Не ТипЗнч(ДоговорКонтрагента) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
				
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорКонтрагента, "ВерсияСоглашения, ИспользоватьГрафикРасчетов, ГрафикДоговора"); 
				
				Если РеквизитыДоговора.ВерсияСоглашения = Выборка.Документ 
					И (Не РеквизитыДоговора.ИспользоватьГрафикРасчетов = ИспользоватьГрафикРасчетов
						ИЛИ Не РеквизитыДоговора.ГрафикДоговора = ГрафикДоговора) Тогда 
						
					ДоговорКонтрагентаОбъект = ДокументОбъект.ДоговорКонтрагента.ПолучитьОбъект();
			        ДоговорКонтрагентаОбъект.ИспользоватьГрафикРасчетов = ИспользоватьГрафикРасчетов;
			        ДоговорКонтрагентаОбъект.ГрафикДоговора = ГрафикДоговора;
					ЕстьДоговор = Истина;    
					
				КонецЕсли;  
				
			КонецЕсли;
			
			Если ЕстьДоговор Тогда 
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДоговорКонтрагентаОбъект);
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект); 
			
		Исключение   
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка, 
			ДокументОбъект.Метаданные(), ДокументОбъект.Ссылка,  
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;   
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОсновнаяСтатьяИсполнениеВерсияСоглашенияКоммерческийДоговор()
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВерсияСоглашения.Ссылка КАК Документ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВерсияСоглашения.УдалитьОсновнаяСтатьяИсполнение) = ТИП(Справочник.СтатьиДвиженияРесурсов)
	|			ТОГДА ВерсияСоглашения.УдалитьОсновнаяСтатьяИсполнение.СтатьяБДР
	|		ИНАЧЕ ВерсияСоглашения.УдалитьОсновнаяСтатьяИсполнение
	|	КОНЕЦ КАК ОсновнаяСтатьяИсполнение
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор КАК ВерсияСоглашения
	|ГДЕ
	|	ВерсияСоглашения.УдалитьОсновнаяСтатьяИсполнение <> НЕОПРЕДЕЛЕНО
	|	И ВерсияСоглашения.ОсновнаяСтатьяИсполнение = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|	И ВерсияСоглашения.УдалитьОсновнаяСтатьяИсполнение <> ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|	И ВерсияСоглашения.УдалитьОсновнаяСтатьяИсполнение <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияРесурсов.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		ДокументОбъект.ОсновнаяСтатьяИсполнение = ВыборкаДетальныеЗаписи.ОсновнаяСтатьяИсполнение;
		ЗаписатьОбъект(ДокументОбъект);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВерсияСоглашения.Ссылка КАК Документ,
	|	ВерсияСоглашения.СтатьяБюджета КАК СтатьяБюджетаТекущая,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВерсияСоглашения.СтатьяБюджета) = ТИП(Справочник.СтатьиДвиженияРесурсов)
	|			ТОГДА ВерсияСоглашения.СтатьяБюджета.СтатьяБДР
	|		ИНАЧЕ ВерсияСоглашения.СтатьяБюджета
	|	КОНЕЦ КАК СтатьяБюджета,
	|	ВерсияСоглашения.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор.ГрафикРасчетов КАК ВерсияСоглашения
	|ГДЕ
	|	ВерсияСоглашения.СтатьяБюджета <> НЕОПРЕДЕЛЕНО
	|	И (ТИПЗНАЧЕНИЯ(ВерсияСоглашения.СтатьяБюджета) = ТИП(Справочник.СтатьиДвиженияРесурсов)
	|			ИЛИ ВерсияСоглашения.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	БюджетДвиженияРесурсов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов;
	БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
	
		ПараметрыОтбора = Новый Структура("СтатьяБюджета", ВыборкаДетальныеЗаписи.СтатьяБюджетаТекущая);
		СтрокиГрафикРасчетов = ДокументОбъект.ГрафикРасчетов.НайтиСтроки(ПараметрыОтбора);   
		
		Для Каждого СтрокаГрафикРасчетов Из СтрокиГрафикРасчетов Цикл 
			
			СтрокаГрафикРасчетов.СтатьяБюджета = ВыборкаДетальныеЗаписи.СтатьяБюджета;
			
			Если СтрокаГрафикРасчетов.ВидБюджета = БюджетДвиженияРесурсов Тогда
				СтрокаГрафикРасчетов.ВидБюджета = БюджетДоходовИРасходов;			
			КонецЕсли;
			
		КонецЦикла;

		ЗаписатьОбъект(ДокументОбъект);   
		
	КонецЦикла;

КонецПроцедуры    

Процедура ЗаполнитьДокументПланированияВерсияСоглашения()    

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВерсияСоглашенияКоммерческийДоговор.Ссылка КАК Документ,
	|	ВерсияСоглашенияКоммерческийДоговор.УдалитьИсточникЛимитовБДДС.ДокументОбновления КАК ИсточникЛимитовБДДС,
	|	ВерсияСоглашенияКоммерческийДоговор.УдалитьИсточникЛимитовИсполнение.ДокументОбновления КАК ИсточникЛимитовБДР
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор КАК ВерсияСоглашенияКоммерческийДоговор
	|ГДЕ
	|	(НЕ ВерсияСоглашенияКоммерческийДоговор.УдалитьИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияКоммерческийДоговор.ИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|			ИЛИ НЕ ВерсияСоглашенияКоммерческийДоговор.УдалитьИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияКоммерческийДоговор.ИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВерсияСоглашенияКредит.Ссылка,
	|	ВерсияСоглашенияКредит.УдалитьИсточникЛимитовБДДС.ДокументОбновления,
	|	ВерсияСоглашенияКредит.УдалитьИсточникЛимитовИсполнение.ДокументОбновления
	|ИЗ
	|	Документ.ВерсияСоглашенияКредит КАК ВерсияСоглашенияКредит
	|ГДЕ
	|	(НЕ ВерсияСоглашенияКредит.УдалитьИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияКредит.ИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|			ИЛИ НЕ ВерсияСоглашенияКредит.УдалитьИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияКредит.ИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВерсияСоглашенияБанковскаяГарантия.Ссылка,
	|	ВерсияСоглашенияБанковскаяГарантия.УдалитьИсточникЛимитовБДДС.ДокументОбновления,
	|	ВерсияСоглашенияБанковскаяГарантия.УдалитьИсточникЛимитовИсполнение.ДокументОбновления
	|ИЗ
	|	Документ.ВерсияСоглашенияБанковскаяГарантия КАК ВерсияСоглашенияБанковскаяГарантия
	|ГДЕ
	|	(НЕ ВерсияСоглашенияБанковскаяГарантия.УдалитьИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияБанковскаяГарантия.ИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|			ИЛИ НЕ ВерсияСоглашенияБанковскаяГарантия.УдалитьИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияБанковскаяГарантия.ИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВерсияСоглашенияАккредитив.Ссылка,
	|	ВерсияСоглашенияАккредитив.УдалитьИсточникЛимитовБДДС.ДокументОбновления,
	|	ВерсияСоглашенияАккредитив.УдалитьИсточникЛимитовИсполнение.ДокументОбновления
	|ИЗ
	|	Документ.ВерсияСоглашенияАккредитив КАК ВерсияСоглашенияАккредитив
	|ГДЕ
	|	(НЕ ВерсияСоглашенияАккредитив.УдалитьИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияАккредитив.ИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|			ИЛИ НЕ ВерсияСоглашенияАккредитив.УдалитьИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|				И ВерсияСоглашенияАккредитив.ИсточникЛимитовИсполнение = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВерсияСоглашенияВалютныйСвоп.Ссылка,
	|	ВерсияСоглашенияВалютныйСвоп.УдалитьИсточникЛимитовБДДС.ДокументОбновления,
	|	ВерсияСоглашенияВалютныйСвоп.УдалитьИсточникЛимитовИсполнение.ДокументОбновления
	|ИЗ
	|	Документ.ВерсияСоглашенияВалютныйСвоп КАК ВерсияСоглашенияВалютныйСвоп
	|ГДЕ
	|	(НЕ ВерсияСоглашенияВалютныйСвоп.УдалитьИсточникЛимитовБДДС = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
