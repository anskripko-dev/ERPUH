Процедура ОбновитьДокументыПланЗакупокДвиженияРесурсов() 

	УстановитьПривилегированныйРежим(Истина); 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланЗакупок.Ссылка КАК Документ,
	|	ПланЗакупок.Проведен КАК Проведен,
	|	ПланЗакупок.МоментВремени КАК МоментВремени,
	|	ПланЗакупок.СтатьяБюджета.СтатьяБДР КАК СтатьяБДР
	|ИЗ
	|	Документ.ПланЗакупок КАК ПланЗакупок
	|ГДЕ
	|	ПланЗакупок.СтатьяБюджета ССЫЛКА Справочник.СтатьиДвиженияРесурсов
	|	И НЕ ПланЗакупок.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияРесурсов.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();   
		ДокументОбъект.СтатьяБюджета = ВыборкаДетальныеЗаписи.СтатьяБДР;
				
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);    
			
			// Запись движений
			Если ВыборкаДетальныеЗаписи.Проведен Тогда
				
				Данные = Новый Структура;      
				Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.Документ);
				Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(ВыборкаДетальныеЗаписи.Документ));
				Данные.Вставить("Алгоритм", "ПланЗакупок");   
				
				ЗаписатьПланыДокументаОперацииБюджетов(Данные);    

			КонецЕсли;

		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать документ ""%1"" 
				|%2'"),
				ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьАналитикиПланированияПриобретениеУслугПрочихАктивов() Экспорт
	
	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ
				|	ПриобретениеУслугПрочихАктивов.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.ПриобретениеУслугПрочихАктивов КАК ПриобретениеУслугПрочихАктивов";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Документ = Выборка.Ссылка.ПолучитьОбъект();
		ЦФОЗаполнение = Справочники.Организации.ПустаяСсылка();
		ПроектЗаполнение = Справочники.Проекты.ПустаяСсылка();
		СтатьяБДДСЗаполнение = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
		АналитикаБДДС1Заполнение = Неопределено;
		АналитикаБДДС2Заполнение = Неопределено;
		АналитикаБДДС3Заполнение = Неопределено;
		АналитикаБДДС4Заполнение = Неопределено;
		АналитикаБДДС5Заполнение = Неопределено;
		АналитикаБДДС6Заполнение = Неопределено;
		СтатьяБДРЗаполнение = Справочники.СтатьиДоходовИРасходов.ПустаяСсылка();
		АналитикаБДР1Заполнение = Неопределено;
		АналитикаБДР2Заполнение = Неопределено;
		АналитикаБДР3Заполнение = Неопределено;
		АналитикаБДР4Заполнение = Неопределено;
		АналитикаБДР5Заполнение = Неопределено;
		АналитикаБДР6Заполнение = Неопределено;
		
		ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Документ.Дата);
		Для каждого СтрокаАналитикиПланирования Из Документ.АналитикиПланирования Цикл
			
			Если СтрокаАналитикиПланирования.ВидБюджета = ВидыБюджетаЗакупок Тогда
				ЦФОЗаполнение = СтрокаАналитикиПланирования.ЦФО;
				ПроектЗаполнение = СтрокаАналитикиПланирования.Проект;
			КонецЕсли;
			
			Если СтрокаАналитикиПланирования.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств") Тогда
				СтатьяБДДСЗаполнение = СтрокаАналитикиПланирования.СтатьяБюджета;
				АналитикаБДДС1Заполнение = СтрокаАналитикиПланирования.Аналитика1;
				АналитикаБДДС2Заполнение = СтрокаАналитикиПланирования.Аналитика2;
				АналитикаБДДС3Заполнение = СтрокаАналитикиПланирования.Аналитика3;
				АналитикаБДДС4Заполнение = СтрокаАналитикиПланирования.Аналитика4;
				АналитикаБДДС5Заполнение = СтрокаАналитикиПланирования.Аналитика5;
				АналитикаБДДС6Заполнение = СтрокаАналитикиПланирования.Аналитика6;
			КонецЕсли;
			
			Если СтрокаАналитикиПланирования.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов") Тогда
				СтатьяБДРЗаполнение = СтрокаАналитикиПланирования.СтатьяБюджета;
				АналитикаБДР1Заполнение = СтрокаАналитикиПланирования.Аналитика1;
				АналитикаБДР2Заполнение = СтрокаАналитикиПланирования.Аналитика2;
				АналитикаБДР3Заполнение = СтрокаАналитикиПланирования.Аналитика3;
				АналитикаБДР4Заполнение = СтрокаАналитикиПланирования.Аналитика4;
				АналитикаБДР5Заполнение = СтрокаАналитикиПланирования.Аналитика5;
				АналитикаБДР6Заполнение = СтрокаАналитикиПланирования.Аналитика6;
			КонецЕсли;
		КонецЦикла;

		Для Каждого Строка ИЗ Документ.Расходы Цикл
			Строка.СтатьяБюджетаБДР = СтатьяБДРЗаполнение;
			Строка.АналитикаБДР1 = АналитикаБДР1Заполнение;
			Строка.АналитикаБДР2 = АналитикаБДР2Заполнение;
			Строка.АналитикаБДР3 = АналитикаБДР3Заполнение;
			Строка.АналитикаБДР4 = АналитикаБДР4Заполнение;
			Строка.АналитикаБДР5 = АналитикаБДР5Заполнение;
			Строка.АналитикаБДР6 = АналитикаБДР6Заполнение;
			Строка.СтатьяБюджетаБДДС = СтатьяБДДСЗаполнение;
			Строка.АналитикаБДДС1 = АналитикаБДДС1Заполнение;
			Строка.АналитикаБДДС2 = АналитикаБДДС2Заполнение;
			Строка.АналитикаБДДС3 = АналитикаБДДС3Заполнение;
			Строка.АналитикаБДДС4 = АналитикаБДДС4Заполнение;
			Строка.АналитикаБДДС5 = АналитикаБДДС5Заполнение;
			Строка.АналитикаБДДС6 = АналитикаБДДС6Заполнение;
			Строка.ЦФО = ЦФОЗаполнение;
			Строка.Проект = ПроектЗаполнение;
		КонецЦикла;
		
		Попытка
			Документ.ОбменДанными.Загрузка = Истина;
			Документ.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = ''Не удалось записать документ ""Приобретение услуг и прочих активов"", по причине:
				|%1'"),
				Выборка.ИмяРегистра, Выборка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
			
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииПрочее

Процедура ПеренестиДвиженияРегистраторПлановЛимитов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""УдалитьОперативныйПланПоБюджетам"" КАК ИмяРегистра,
	|	УдалитьОперативныйПланПоБюджетам.Регистратор КАК Документ,
	|	УдалитьОперативныйПланПоБюджетам.Регистратор.Дата КАК Дата
	|ИЗ
	|	РегистрНакопления.УдалитьОперативныйПланПоБюджетам КАК УдалитьОперативныйПланПоБюджетам
	|ГДЕ
	|	НЕ УдалитьОперативныйПланПоБюджетам.Регистратор ССЫЛКА Документ.РегистраторПлановЛимитов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""УдалитьЛимитыПоБюджетам"",
	|	УдалитьЛимитыПоБюджетам.Регистратор,
	|	УдалитьЛимитыПоБюджетам.Регистратор.Дата
	|ИЗ
	|	РегистрНакопления.УдалитьЛимитыПоБюджетам КАК УдалитьЛимитыПоБюджетам
	|ГДЕ
	|	НЕ УдалитьЛимитыПоБюджетам.Регистратор ССЫЛКА Документ.РегистраторПлановЛимитов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""УдалитьФактПоБюджетам"",
	|	УдалитьФактПоБюджетам.Регистратор,
	|	УдалитьФактПоБюджетам.Регистратор.Дата
	|ИЗ
	|	РегистрНакопления.УдалитьФактПоБюджетам КАК УдалитьФактПоБюджетам
	|ГДЕ
	|	НЕ УдалитьФактПоБюджетам.Регистратор ССЫЛКА Документ.РегистраторПлановЛимитов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""УдалитьОперацииБюджетов"",
	|	УдалитьОперацииБюджетов.Регистратор,
	|	УдалитьОперацииБюджетов.Регистратор.Дата
	|ИЗ
	|	РегистрНакопления.УдалитьОперацииБюджетов КАК УдалитьОперацииБюджетов
	|ГДЕ
	|	НЕ УдалитьОперацииБюджетов.Регистратор ССЫЛКА Документ.РегистраторПлановЛимитов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИмяРегистра";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДанныеДокумента = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВыборкаДетальныеЗаписи);
		РегистраторПлановЛимитов = ПолучитьРегистраторПлановЛимитов(ДанныеДокумента, Истина); 
		
		Если Не ЗначениеЗаполнено(РегистраторПлановЛимитов) Тогда
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию(); 
		
		Попытка	
			
			НаборЗаписейИсточник = РегистрыНакопления[ВыборкаДетальныеЗаписи.ИмяРегистра].СоздатьНаборЗаписей();
			НаборЗаписейИсточник.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Документ);  
			НаборЗаписейИсточник.Прочитать(); 
			
			НаборЗаписейПриемник = РегистрыНакопления[ВыборкаДетальныеЗаписи.ИмяРегистра].СоздатьНаборЗаписей();
			НаборЗаписейПриемник.Отбор.Регистратор.Установить(РегистраторПлановЛимитов); 
			НаборЗаписейПриемник.Загрузить(НаборЗаписейИсточник.Выгрузить()); 
			
			НаборЗаписейИсточник.Очистить();			
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейИсточник);
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейПриемник);
			
			ЗафиксироватьТранзакцию();
			
		Исключение      
			
			ОтменитьТранзакцию();	
			
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр накопления ""%1"" по документу ""%2""
				|%3'"),
				ВыборкаДетальныеЗаписи.ИмяРегистра, ВыборкаДетальныеЗаписи.Документ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;   

КонецПроцедуры  

Процедура ЗаполнитьАктуальностьУстановленныхЛимитов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НеактуальныеДанные.Период КАК Период,
	|	НеактуальныеДанные.Организация КАК Организация,
	|	НеактуальныеДанные.ВидОтчета КАК ВидОтчета,
	|	НеактуальныеДанные.Область КАК Область,
	|	НеактуальныеДанные.УОП КАК УОП,
	|	ВЫБОР
	|		КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|		ИНАЧЕ НеактуальныеДанные.Предназначение
	|	КОНЕЦ КАК Предназначение,
	|	НеактуальныеДанные.Проект КАК Проект,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НеактуальныеДанные.Актуальность) КАК Актуальность,
	|	МАКСИМУМ(НеактуальныеДанные.Документ) КАК Документ,
	|	МАКСИМУМ(НеактуальныеДанные.Пользователь) КАК Пользователь
	|ИЗ
	|	РегистрСведений.УдалитьАктуальностьУстановленныхЛимитов КАК НеактуальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АктуальностьУстановленныхЛимитов КАК АктуальностьУстановленныхЛимитов
	|		ПО НеактуальныеДанные.Период = АктуальностьУстановленныхЛимитов.Период
	|			И НеактуальныеДанные.Организация = АктуальностьУстановленныхЛимитов.Организация
	|			И НеактуальныеДанные.ВидОтчета = АктуальностьУстановленныхЛимитов.ВидОтчета
	|			И НеактуальныеДанные.Область = АктуальностьУстановленныхЛимитов.Область
	|			И НеактуальныеДанные.УОП = АктуальностьУстановленныхЛимитов.УОП
	|			И (ВЫБОР
	|				КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|				ИНАЧЕ НеактуальныеДанные.Предназначение
	|			КОНЕЦ = АктуальностьУстановленныхЛимитов.Предназначение)
	|			И НеактуальныеДанные.Проект = АктуальностьУстановленныхЛимитов.Проект
	|ГДЕ
	|	АктуальностьУстановленныхЛимитов.Период ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	НеактуальныеДанные.Период,
	|	НеактуальныеДанные.Организация,
	|	НеактуальныеДанные.ВидОтчета,
	|	НеактуальныеДанные.Область,
	|	НеактуальныеДанные.УОП,
	|	НеактуальныеДанные.Проект,
	|	ВЫБОР
	|		КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|		ИНАЧЕ НеактуальныеДанные.Предназначение
	|	КОНЕЦ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.АктуальностьУстановленныхЛимитов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
				
		Попытка
			МенеджерЗаписи.Записать(Истина);   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1""
			|%2'"),
			Метаданные.РегистрыСведений.АктуальностьУстановленныхЛимитов.Представление(),    
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки; 

	КонецЦикла;

КонецПроцедуры  

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьОбъект(Объект)
	
	Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	Исключение 
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, 
							Объект.Метаданные(), Объект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
	КонецПопытки;  	
					
КонецПроцедуры

Функция СостояниеРегистровПараметровОПК()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Запрос.КолвоПОП) КАК КоличествоЗаписейПараметровОП
	|ИЗ
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(*) КАК КолвоПОП
	|	ИЗ
	|		РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		КОЛИЧЕСТВО(*)
	|	ИЗ
	|		РегистрСведений.УдалитьПараметрыЛимитирования КАК УдалитьПараметрыЛимитирования) КАК Запрос";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции 
 
Процедура ЗагрузитьРезультатыКонтроляДокументов(НовыйДокумент, СтарыйДокумент)
	
	Если КонтрольУХ.ДокументИмеетТабЧастьРезультатыКонтроля(НовыйДокумент) Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтрольУХ.ДокументИмеетТабЧастьРезультатыКонтроля(СтарыйДокумент) Тогда
		РезультатыКонтроля = СтарыйДокумент.РезультатыКонтроля.Выгрузить();  
	Иначе
		РезультатыКонтроля = ПолучитьРезультатыКонтроляДокументов(СтарыйДокумент);
	КонецЕсли;
	
	Если РезультатыКонтроля.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Период = НовыйДокумент.Дата;
	
	ЕстьПериод = Не (РезультатыКонтроля.Колонки.Найти("Период") = Неопределено);
	Для Каждого СтрокаРезультатаКонтроля Из РезультатыКонтроля Цикл
		
		// Результаты контроля документов
		Запись = РегистрыСведений.УдалитьРезультатыКонтроляДокументов.СоздатьМенеджерЗаписи();
		Запись.Период 	= ?(ЕстьПериод, СтрокаРезультатаКонтроля.Период, Период); 
		Запись.Документ = НовыйДокумент;  
		Запись.ЕстьНарушения = СтрокаРезультатаКонтроля.КонтрольНарушен;
		
		Попытка
			Запись.Записать();   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1""
			|%2'"),
			"Результаты контроля документов",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки; 
		
		Если Не ЗначениеЗаполнено(СтрокаРезультатаКонтроля.ВидКонтроля) Тогда
			Продолжить;
		КонецЕсли;
		
		// Результаты контроля документов по видам контроля
		Запись = РегистрыСведений.РезультатыКонтроляДокументовПоВидамКонтроля.СоздатьМенеджерЗаписи();
		Запись.Период 	= ?(ЕстьПериод, СтрокаРезультатаКонтроля.Период, Период);
		Запись.Документ = НовыйДокумент;  
		ЗаполнитьЗначенияСвойств(Запись, СтрокаРезультатаКонтроля);
		
		Попытка
			Запись.Записать();   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1""
			|%2'"),
			"Результаты контроля документов по видам контроля",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры  

Функция ПолучитьРезультатыКонтроляДокументов(КонтролируемыйДокумент)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РезультатыКонтроляДокументовПоВидамКонтроля.Период КАК Период,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.ВидКонтроля КАК ВидКонтроля,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.КлючКонтроля КАК КлючКонтроля,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.Валюта КАК Валюта,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.Лимит КАК Лимит,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.Зарезервировано КАК Зарезервировано,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.Заявлено КАК Заявлено,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.Исполнено КАК Исполнено,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.ЛимитИзменение КАК ЛимитИзменение,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.ЗарезервированоИзменение КАК ЗарезервированоИзменение,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.ЗаявленоИзменение КАК ЗаявленоИзменение,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.ИсполненоИзменение КАК ИсполненоИзменение,
	|	РезультатыКонтроляДокументовПоВидамКонтроля.КонтрольНарушен КАК КонтрольНарушен
	|ИЗ
	|	РегистрСведений.РезультатыКонтроляДокументовПоВидамКонтроля КАК РезультатыКонтроляДокументовПоВидамКонтроля
	|ГДЕ
	|	РезультатыКонтроляДокументовПоВидамКонтроля.Документ = &Документ";
	
	Запрос.УстановитьПараметр("Документ", КонтролируемыйДокумент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ПолучитьРегистраторПлановЛимитов(ДанныеДокумента, СоздатьДокумент = Ложь)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Документ = ?(ТипЗнч(ДанныеДокумента) = Тип("Структура"), 
				ДанныеДокумента.Документ, ДанныеДокумента);   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегистраторПлановЛимитов.Ссылка КАК Документ
	|ИЗ
	|	Документ.РегистраторПлановЛимитов КАК РегистраторПлановЛимитов
	|ГДЕ
	|	РегистраторПлановЛимитов.Документ = &Документ
	|	И НЕ РегистраторПлановЛимитов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	РегистраторПлановЛимитов = ВыборкаДетальныеЗаписи.Документ;  
	
	Если Не СоздатьДокумент Тогда
		Возврат РегистраторПлановЛимитов;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РегистраторПлановЛимитов) Тогда
		
		ДокументОбъект = Документы.РегистраторПлановЛимитов.СоздатьДокумент();
		ДокументОбъект.Дата = ДанныеДокумента.Дата; 
		ДокументОбъект.Документ = ДанныеДокумента.Документ;   
		ДокументОбъект.УстановитьНовыйНомер();
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось записать документ ""%1"" 
				|%2'"),
				ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;
		
		РегистраторПлановЛимитов = ДокументОбъект.Ссылка;
		
	КонецЕсли;   
	
	Возврат РегистраторПлановЛимитов;    

КонецФункции    

#КонецОбласти