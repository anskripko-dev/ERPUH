Процедура ПеренестиДвиженияИзСтарогоОперационногоПлана(СтарыйДокумент, НовыйДокумент, Алгоритм)

	ДополнительныеСвойства = Новый Структура;
	ПроведениеСерверОПК.ИнициализироватьДополнительныеСвойстваДляПроведения(НовыйДокумент, ДополнительныеСвойства);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Данные = Новый Структура();
	Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(СтарыйДокумент));    
	Данные.Вставить("Документ", СтарыйДокумент);
	Данные.Вставить("Алгоритм", Алгоритм);
	
	Если Не ЗначениеЗаполнено(Данные.Регистратор) Тогда
		Возврат;
	КонецЕсли;

	ПланыДокумента(Данные, Запрос.МенеджерВременныхТаблиц);   
	ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокумента");
	
	НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(НовыйДокумент);
	НаборЗаписей.Прочитать();
	
	ТаблицаОперацииБюджетов = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОперацииБюджетов;
	
	Попытка
		Если ТипЗнч(НовыйДокумент) = Тип("ДокументСсылка.Резервирование") Тогда
			Для Каждого СтрокаТаблицыОперации Из ТаблицаОперацииБюджетов Цикл
				Если Не ЗначениеЗаполнено(СтрокаТаблицыОперации.ОбъектПланирования)	Тогда
					СтрокаТаблицыОперации.ОбъектПланирования = ОбъектыПланирования.ПолучитьОбъектПланирования(НовыйДокумент, , Истина);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;      
	Исключение
	КонецПопытки;
	
	НаборЗаписей.ДополнительныеСвойства.Вставить("ПропуститьПересчетПоказателей");
	НаборЗаписей.Загрузить(ТаблицаОперацииБюджетов);
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, , ,Истина);
	
КонецПроцедуры

Функция ПланыДокумента(Данные, МенеджерВременныхТаблиц) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если Данные.Алгоритм = "ВводЛимитов" Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ДанныеРегистра.ПериодЛимитирования.ДатаНачала КАК Период,
		|	ВидыБюджетов.Ссылка КАК ВидБюджета,
		|	ДанныеРегистра.ЦФО КАК ЦФО,
		|	ДанныеРегистра.Проект КАК Проект,
		|	ДанныеРегистра.СтатьяБюджета КАК СтатьяБюджета,
		|	ДанныеРегистра.Аналитика1 КАК Аналитика1,
		|	ДанныеРегистра.Аналитика2 КАК Аналитика2,
		|	ДанныеРегистра.Аналитика3 КАК Аналитика3,
		|	ДанныеРегистра.Аналитика4 КАК Аналитика4,
		|	ДанныеРегистра.Аналитика5 КАК Аналитика5,
		|	ДанныеРегистра.Аналитика6 КАК Аналитика6,
		|	ДанныеРегистра.Валюта КАК Валюта,
		|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
		|	НЕОПРЕДЕЛЕНО КАК ОбъектПланирования,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
		|	&ДатаРегистрации КАК ДатаРегистрации,
		|	ДанныеРегистра.Лимит + ДанныеРегистра.Корректировка КАК Лимит
		|ПОМЕСТИТЬ ВТ_ПланыДокумента
		|ИЗ
		|	РегистрНакопления.УдалитьЛимитыПоБюджетам КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
		|		ПО ДанныеРегистра.Предназначение = ВидыБюджетов.Предназначение
		|ГДЕ
		|	ДанныеРегистра.Регистратор = &Регистратор";  
		
	ИначеЕсли Данные.Алгоритм = "Резервирование" Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ДанныеРегистра.ПериодЛимитирования.ДатаНачала КАК Период,
		|	ВидыБюджетов.Ссылка КАК ВидБюджета,
		|	ДанныеРегистра.ЦФО КАК Организация,
		|	ДанныеРегистра.ЦФО КАК ЦФО,
		|	ДанныеРегистра.Проект КАК Проект,
		|	ДанныеРегистра.СтатьяБюджета КАК СтатьяБюджета,
		|	ДанныеРегистра.Аналитика1 КАК Аналитика1,
		|	ДанныеРегистра.Аналитика2 КАК Аналитика2,
		|	ДанныеРегистра.Аналитика3 КАК Аналитика3,
		|	ДанныеРегистра.Аналитика4 КАК Аналитика4,
		|	ДанныеРегистра.Аналитика5 КАК Аналитика5,
		|	ДанныеРегистра.Аналитика6 КАК Аналитика6,
		|	ДанныеРегистра.Валюта КАК Валюта,
		|	ДанныеРегистра.ДокументРезервирования.ДокументОбновления КАК ДокументПланирования,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
		|	&ДатаРегистрации КАК ДатаРегистрации,
		|	ДанныеРегистра.Зарезервировано КАК Сумма,
		|	ДанныеРегистра.Зарезервировано КАК Лимит
		|ПОМЕСТИТЬ ВТ_ПланыДокумента
		|ИЗ
		|	РегистрНакопления.УдалитьЛимитыПоБюджетам КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
		|		ПО ДанныеРегистра.Предназначение = ВидыБюджетов.Предназначение
		|ГДЕ
		|	ДанныеРегистра.Регистратор = &Регистратор"; 
		
	ИначеЕсли Данные.Алгоритм = "ПланированиеИРезервирование" Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ДанныеРегистра.ПериодОтчета.ДатаНачала КАК Период,
		|	ВидыБюджетов.Ссылка КАК ВидБюджета,
		|	ДанныеРегистра.АналитикаПартнеров.Контрагент КАК Контрагент,
		|	ДанныеРегистра.АналитикаПартнеров.Договор КАК ДоговорКонтрагента,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.АналитикаПартнеров.Договор ССЫЛКА Справочник.ДоговорыКонтрагентов
		|				И ДанныеРегистра.АналитикаПартнеров.Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|			ТОГДА ВЫРАЗИТЬ(ДанныеРегистра.АналитикаПартнеров.Договор КАК Справочник.ДоговорыКонтрагентов).Организация
		|		ИНАЧЕ ДанныеРегистра.АналитикаСтруктуры.ЦФО
		|	КОНЕЦ КАК Организация,
		|	ДанныеРегистра.АналитикаСтруктуры.ЦФО КАК ЦФО,
		|	ДанныеРегистра.АналитикаСтруктуры.Проект КАК Проект,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
		|	ДанныеРегистра.Валюта КАК Валюта,
		|	ДанныеРегистра.ДокументПланирования.ДокументОбновления КАК ДокументПланирования,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
		|	&ДатаРегистрации КАК ДатаРегистрации,
		|	ДанныеРегистра.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТ_ПланыДокумента
		|ИЗ
		|	РегистрНакопления.УдалитьОперацииБюджетов КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
		|		ПО ДанныеРегистра.Предназначение = ВидыБюджетов.Предназначение
		|ГДЕ
		|	ДанныеРегистра.Регистратор = &Регистратор";   
		
	ИначеЕсли Данные.Алгоритм = "Планирование" Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ДанныеРегистра.ПериодОтчета.ДатаНачала КАК Период,
		|	ВидыБюджетов.Ссылка КАК ВидБюджета,
		|	ДанныеРегистра.АналитикаПартнеров.Контрагент КАК Контрагент,
		|	ДанныеРегистра.АналитикаПартнеров.Договор КАК ДоговорКонтрагента,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.АналитикаПартнеров.Договор ССЫЛКА Справочник.ДоговорыКонтрагентов
