Процедура ОбновитьОперацииБюджетовЛимитИсполнено(Параметры) Экспорт
	
	ОбновитьОперацииБюджетовЛимиты(Параметры);
	
КонецПроцедуры

Процедура ОбновитьОперацииБюджетовЛимит(Параметры) Экспорт 

	ОбновитьОперацииБюджетовЛимиты(Параметры);
	
КонецПроцедуры

Процедура ОбновитьОперацииБюджетовЛимиты(Параметры) 
	
	МетаданныеРегистра = Метаданные.РегистрыНакопления.ОперацииБюджетов;
	ПолноеИмяРегистра = МетаданныеРегистра.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоДвижения = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяРегистра;
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	РазмерПорции = 100;
	
	Если ОбновляемыеДанные.Количество() > 0 Тогда
		
		Счетчик = 1;
		Пока Счетчик <= ОбновляемыеДанные.Количество() Цикл
	
			Индекс = ?(Счетчик = 1, 0, Индекс + РазмерПорции);

			МассивРегистраторов = Новый Массив;
			Для НомерДокумента = Индекс По ?(Индекс + РазмерПорции - 1 < ОбновляемыеДанные.Количество(),Индекс + РазмерПорции - 1,ОбновляемыеДанные.Количество() - 1) Цикл
				МассивРегистраторов.Добавить(ОбновляемыеДанные[НомерДокумента].Регистратор);
			КонецЦикла;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ *
				|ИЗ
				|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
				|ГДЕ
				|	ОперацииБюджетов.Регистратор В(&МассивРегистраторов)";
			
			Запрос.УстановитьПараметр("МассивРегистраторов", МассивРегистраторов);
		
			РезультатЗапроса = Запрос.Выполнить();
		
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				НоваяЗапись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
			КонецЦикла;
			
			КонтрольЛимитовУХ.ВыполнитьРасчетСуммЛимитирования(НаборЗаписей, Ложь);
			
			ТаблицаДвижений = НаборЗаписей.Выгрузить();
		
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапросаТаблицаДвиженийОперацииБюджетов(); 
			
			Запрос.УстановитьПараметр("ТаблицаДвижений", ТаблицаДвижений);
			Результат = Запрос.Выполнить();
			
			НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
			// Перебрать все документы из результата запроса
			ВыборкаДокументов = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаДокументов.Следующий() Цикл
				// Установить отбор набора записей по регистратору, к которому будут приписаны движения
				НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДокументов.Регистратор);
				
				// Перебрать данные о составе документа, необходимые для заполнения формируемых движений
				ВыборкаДетальныхЗаписей = ВыборкаДокументов.Выбрать();

				Пока ВыборкаДетальныхЗаписей.Следующий() Цикл

					НоваяЗапись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныхЗаписей); 
				КонецЦикла;
				
				// Записать сформированные для очередного документа движения
				Попытка
					ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
					НаборЗаписей.Очистить();
				Исключение
					ТекстСообщения = СтрШаблон(НСтр(
					"ru = 'Не удалось обновить регистр накопления ""%1"" по документу ""%2""
					|%3'"),
					"Операции бюджетов", ВыборкаДокументов.Регистратор,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
					ЗаписьЖурналаРегистрации(
					ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
					УровеньЖурналаРегистрации.Ошибка,
					,
					, 
					ТекстСообщения);
				КонецПопытки;  	
			КонецЦикла;
			Счетчик = Счетчик + РазмерПорции;
		КонецЦикла;
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыОперацииБюджетов(Параметры) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыНакопления.ОперацииБюджетов;
	ПолноеИмяРегистра = МетаданныеРегистра.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоДвижения = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяРегистра;
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
	БюджетДвиженияРесурсов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов;
	
	Если ОбновляемыеДанные.Количество() > 0 Тогда
		
		Для каждого ДокументОбновляемыеДанные из ОбновляемыеДанные Цикл	
			НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(ДокументОбновляемыеДанные.Регистратор); 
			НаборЗаписей.Прочитать();   
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Запись.ВидБюджета = БюджетДвиженияРесурсов Тогда
					Запись.ВидБюджета = БюджетДоходовИРасходов;	
				КонецЕсли;
			КонецЦикла;   		
			
			НаборЗаписей.ДополнительныеСвойства.Вставить("ПропуститьПересчетПоказателей");
			
			Попытка
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, , ,Истина);
			Исключение
				ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить записи по регистру ""%1"", документ ""%2"" 
				|%3'"),
				"Операции бюджетов", ДокументОбновляемыеДанные.Регистратор, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				,
				, 
				ТекстСообщения);
			КонецПопытки; 
		КонецЦикла	
		
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЛимитИсполнено_ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра	= "РегистрНакопления.ОперацииБюджетов";
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = "Документ.ОтражениеФактическихДанныхБюджетирования";
	ПараметрыВыборки.ПолныеИменаРегистров = ПолноеИмяРегистра;
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Период УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Период УБЫВ");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиРегистраторыРегистра();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОперацииБюджетов.Регистратор КАК Документ
	               |ИЗ
	               |	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	               |ГДЕ
	               |	ОперацииБюджетов.Регистратор ССЫЛКА Документ.ОтражениеФактическихДанныхБюджетирования
	               |	И НЕ ОперацииБюджетов.СуммаИсполнено = 0
	               |	И ОперацииБюджетов.ЛимитИсполнено = 0";
	
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Документ");
	ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
	
КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура Лимит_ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра	= "РегистрНакопления.ОперацииБюджетов";
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаРегистров = ПолноеИмяРегистра;
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Период УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Период УБЫВ");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиРегистраторыРегистра();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	УдалитьОперативныйПлан.ДокументОбновления КАК Документ
	               |ПОМЕСТИТЬ ВТ_ДокументыИсключения
	               |ИЗ
	               |	Документ.УдалитьОперативныйПлан КАК УдалитьОперативныйПлан
	               |ГДЕ
	               |	УдалитьОперативныйПлан.ДокументОбновления ССЫЛКА Документ.ОперативныйПлан
	               |	И УдалитьОперативныйПлан.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.Планирование)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОперацииБюджетов.Регистратор КАК Документ
	               |ИЗ
	               |	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	               |ГДЕ
	               |	НЕ ОперацииБюджетов.Сумма = 0
	               |	И ОперацииБюджетов.Лимит = 0
	               |	И НЕ ОперацииБюджетов.Регистратор В
	               |				(ВЫБРАТЬ
	               |					ВТ_ДокументыИсключения.Документ КАК Документ
	               |				ИЗ
	               |					ВТ_ДокументыИсключения КАК ВТ_ДокументыИсключения)";
	
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Документ");
	ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
	
КонецПроцедуры

