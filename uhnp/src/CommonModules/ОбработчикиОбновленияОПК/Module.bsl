Процедура ИзменитьПериодичностьПустыхГруппСтатей() 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПараметрыЛимитированияГруппыСтатей.Период КАК Период,
	|	ПараметрыЛимитированияГруппыСтатей.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияГруппыСтатей.ГруппаСтатей КАК ГруппаСтатей
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияГруппыСтатей КАК ПараметрыЛимитированияГруппыСтатей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав КАК ПараметрыЛимитированияГруппыСтатейСостав
	|		ПО ПараметрыЛимитированияГруппыСтатей.Период = ПараметрыЛимитированияГруппыСтатейСостав.Период
	|			И ПараметрыЛимитированияГруппыСтатей.ВидБюджета = ПараметрыЛимитированияГруппыСтатейСостав.ВидБюджета
	|			И ПараметрыЛимитированияГруппыСтатей.ГруппаСтатей = ПараметрыЛимитированияГруппыСтатейСостав.ГруппаСтатей
	|ГДЕ
	|	ПараметрыЛимитированияГруппыСтатейСостав.ГруппаСтатей ЕСТЬ NULL
	|	И ПараметрыЛимитированияГруппыСтатей.ИнаяПериодичность
	|	И НЕ ПараметрыЛимитированияГруппыСтатей.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборДанных = РегистрыСведений.ПараметрыЛимитированияГруппыСтатей.СоздатьНаборЗаписей();
		
		НаборДанных.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период);
		НаборДанных.Отбор.ВидБюджета.Установить(ВыборкаДетальныеЗаписи.ВидБюджета);
		НаборДанных.Отбор.ГруппаСтатей.Установить(ВыборкаДетальныеЗаписи.ГруппаСтатей);
		
		НаборДанных.Прочитать();  
		
		Для Каждого Запись Из НаборДанных Цикл
			Запись.ИнаяПериодичность = Ложь;
			Запись.Периодичность = Перечисления.Периодичность.ПустаяСсылка();
		КонецЦикла;   	
		  	
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборДанных);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр сведений ""%1"" по группе ""%2""
				|%3'"),
				"Параметры лимитирования группы статей", ВыборкаДетальныеЗаписи.ГруппаСтатей,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти  

#Область ПроцедурыИФункцииАналитикаКонтроляБюджетныхЛимитовРезервов
 
Процедура ОбновитьАналитикаКонтроляБюджетныхЛимитовРезервов() Экспорт

	РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.ЗаменитьПредназначениеИПериодЛимитирования();
	ИзменитьАналитикаКонтроляБюджетныхЛимитовРезервов();  
	
КонецПроцедуры    

Процедура ИзменитьАналитикаКонтроляБюджетныхЛимитовРезервов() 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.УдалитьАналитикаКонтроляБюджетныхЛимитовРезервов КАК ДанныеРегистра";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборДанных = РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.СоздатьНаборЗаписей();
		
		НаборДанных.Отбор.ВидБюджета.Установить(ВыборкаДетальныеЗаписи.ВидБюджета);
		НаборДанных.Отбор.АналитикаПланированияСтатейБюджетов.Установить(ВыборкаДетальныеЗаписи.АналитикаПланированияСтатейБюджетов);
		НаборДанных.Отбор.АналитикаПланированияСтруктуры.Установить(ВыборкаДетальныеЗаписи.АналитикаПланированияСтруктуры);
		НаборДанных.Отбор.ДокументРезервирования.Установить(ВыборкаДетальныеЗаписи.ДокументРезервирования);
		НаборДанных.Отбор.НачалоПериодаКонтроля.Установить(ВыборкаДетальныеЗаписи.НачалоПериодаКонтроля);
		НаборДанных.Отбор.ПериодичностьКонтроля.Установить(ВыборкаДетальныеЗаписи.ПериодичностьКонтроля);
		
		ЗаполнитьЗначенияСвойств(НаборДанных.Добавить(), ВыборкаДетальныеЗаписи);
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборДанных);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр сведений ""%1"" по виду бюджета ""%2"" за период ""%3""
				|%4'"),
				"Аналитика контроля бюджетных лимитов резервов", ВыборкаДетальныеЗаписи.ВидБюджета, Формат(ВыборкаДетальныеЗаписи.НачалоПериодаКонтроля, "ДФ=dd.MM.yyyy"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ЗаполнитьАналитикаКонтроляБюджетныхЛимитовРезервов(ДокументОбъект, НовыйДокументРезервирования, 
											СтарыйДокументРезервирования, ПроверитьНаличиеЗаписи = Истина)
	
	УстановитьПривилегированныйРежим(Истина); 
	
	НаборЗаписейСтарыйДокумент = РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.СоздатьНаборЗаписей();
	НаборЗаписейСтарыйДокумент.Отбор.ДокументРезервирования.Установить(СтарыйДокументРезервирования);
	НаборЗаписейСтарыйДокумент.Прочитать();
	
	Если НаборЗаписейСтарыйДокумент.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ПроверитьНаличиеЗаписи Тогда
		НаборЗаписейНовыйДокумент = РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.СоздатьНаборЗаписей();
		НаборЗаписейНовыйДокумент.Отбор.ДокументРезервирования.Установить(НовыйДокументРезервирования);
		НаборЗаписейНовыйДокумент.Прочитать();
		
		Если Не НаборЗаписейНовыйДокумент.Количество() = 0 Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли;

	Для Каждого Запись Из НаборЗаписейСтарыйДокумент Цикл   	
		
		НоваяЗапись = РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Запись);
		
		НоваяЗапись.ДокументРезервирования = НовыйДокументРезервирования;
		
		НовыйКлючАналитики = НайтиКлючКонтроляБюджетныхЛимитовРезервов(Запись.КлючАналитики, НовыйДокументРезервирования);
		НоваяЗапись.КлючАналитики = НовыйКлючАналитики;
		
		НоваяЗапись.Записать(); 
		ДокументИмеетТабличнуюЧасть = КонтрольУХ.ДокументИмеетТабЧастьРезультатыКонтроля(ДокументОбъект);
		
		ПараметрыОтбора = Новый Структура("КлючКонтроля", Запись.КлючАналитики);

		Если ДокументИмеетТабличнуюЧасть Тогда 
			
			НайденныеСтроки = ДокументОбъект.РезультатыКонтроля.НайтиСтроки(ПараметрыОтбора);  
			
			Для Каждого ЭлементКоллекции Из НайденныеСтроки Цикл
				ЭлементКоллекции.КлючКонтроля = НовыйКлючАналитики;	
			КонецЦикла; 
			
		Иначе
			
			РезультатыКонтроля = КонтрольУХ.ПолучитьРезультатыКонтроля(ДокументОбъект.Ссылка); 
			НайденныеСтроки = РезультатыКонтроля.НайтиСтроки(ПараметрыОтбора);    
			
			Для Каждого ЭлементКоллекции Из НайденныеСтроки Цикл   			 
				ЗаписьРезультат = РегистрыСведений.РезультатыКонтроляДокументовПоВидамКонтроля.СоздатьМенеджерЗаписи(); 			 
				
				ЗаполнитьЗначенияСвойств(ЗаписьРезультат, ЭлементКоллекции); 			
				ЗаписьРезультат.Период = ЭлементКоллекции.ВремяПроверки;
				ЗаписьРезультат.КлючКонтроля = НовыйКлючАналитики;   
				
				ЗаписьРезультат.Записать();
			КонецЦикла;	 
			
			Для Каждого ЭлементКоллекции Из НайденныеСтроки Цикл
				ЗаписьРезультат = РегистрыСведений.РезультатыКонтроляДокументовПоВидамКонтроля.СоздатьМенеджерЗаписи();	
				
				ЗаполнитьЗначенияСвойств(ЗаписьРезультат, ЭлементКоллекции);  				
				ЗаписьРезультат.Период = ЭлементКоллекции.ВремяПроверки;  
				
				ЗаписьРезультат.Удалить();
			КонецЦикла;
			 
		КонецЕсли;
		
	КонецЦикла;  
	
КонецПроцедуры

Функция НайтиКлючКонтроляБюджетныхЛимитовРезервов(КлючАналитики, ДокументРезервирования)

	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлючиКонтроляБюджетныхЛимитовРезервов.Ссылка КАК КлючАналитики
	|ИЗ
	|	Справочник.КлючиКонтроляБюджетныхЛимитовРезервов КАК КлючиКонтроляБюджетныхЛимитовРезервов
	|ГДЕ
	|	КлючиКонтроляБюджетныхЛимитовРезервов.ВидБюджета = &ВидБюджета
	|	И КлючиКонтроляБюджетныхЛимитовРезервов.АналитикаПланированияСтатейБюджетов = &АналитикаПланированияСтатейБюджетов
	|	И КлючиКонтроляБюджетныхЛимитовРезервов.АналитикаПланированияСтруктуры = &АналитикаПланированияСтруктуры
	|	И КлючиКонтроляБюджетныхЛимитовРезервов.ДокументРезервирования = &ДокументРезервирования
	|	И КлючиКонтроляБюджетныхЛимитовРезервов.НачалоПериодаКонтроля = &НачалоПериодаКонтроля
	|	И КлючиКонтроляБюджетныхЛимитовРезервов.ПериодичностьКонтроля = &ПериодичностьКонтроля";
	
	Запрос.УстановитьПараметр("ДокументРезервирования", ДокументРезервирования);
	Запрос.УстановитьПараметр("АналитикаПланированияСтатейБюджетов", КлючАналитики.АналитикаПланированияСтатейБюджетов);
	Запрос.УстановитьПараметр("АналитикаПланированияСтруктуры", КлючАналитики.АналитикаПланированияСтруктуры);
	Запрос.УстановитьПараметр("ВидБюджета", КлючАналитики.ВидБюджета);  
	Запрос.УстановитьПараметр("НачалоПериодаКонтроля", КлючАналитики.НачалоПериодаКонтроля);
	Запрос.УстановитьПараметр("ПериодичностьКонтроля", КлючАналитики.ПериодичностьКонтроля);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда  	
		СправочникОбъект = КлючАналитики.Скопировать(); 
		СправочникОбъект.ДокументРезервирования = ДокументРезервирования;      
		СправочникОбъект.Записать();  
		
		НовыйКлючАналитики = СправочникОбъект.Ссылка;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		НовыйКлючАналитики = ВыборкаДетальныеЗаписи.КлючАналитики;
	КонецЕсли;  
	
	Возврат НовыйКлючАналитики;
	
КонецФункции

#КонецОбласти  

#Область ПроцедурыИФункцииДокументыУправлениеЛимитами

Процедура ОбновитьДокументыУправлениеЛимитами() Экспорт

	ОбновитьОперацииБюджетовУправлениеЛимитами();
	ОбновитьУправлениеЛимитамиБюджетДвиженияРесурсов();
	ЗаполнитьПриходРасходУправлениеЛимитами();
	
КонецПроцедуры

Процедура ОбновитьРегистрыУстановкаЛимитовПоДаннымБюджетирования() Экспорт

	РегистрыСведений.СостояниеПериодовЛимитирования.ЗаполнитьНачалоПериодаПериодичностьПоПериодуЛимитирования();
	РегистрыСведений.УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.ЗаполнитьНачалоПериодаПериодичностьПоПериодуЛимитирования();
	РегистрыСведений.УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования.ЗаполнитьНачалоПериодаПериодичностьПоПериодуЛимитирования(); 
	РегистрыСведений.УстановкаЛимитовПоДаннымБюджетированияСостояния.ЗаполнитьНачалоПериодаПериодичностьПоПериодуЛимитирования();
	
	ОбновитьРегистрСостояниеПериодовЛимитирования();
	ОбновитьРегистрУстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования();
	ОбновитьРегистрУстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования(); 
	ОбновитьРегистрУстановкаЛимитовПоДаннымБюджетированияСостояния();
	ОбновитьРегистрУстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей();
	
КонецПроцедуры

Процедура ОбновитьОперацииБюджетовУправлениеЛимитами()

	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистраторПлановЛимитов.Ссылка КАК Регистратор,
	|	РегистраторПлановЛимитов.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.РегистраторПлановЛимитов КАК РегистраторПлановЛимитов
	|ГДЕ
	|	РегистраторПлановЛимитов.Документ ССЫЛКА Документ.УправлениеЛимитами
	|	И РегистраторПлановЛимитов.Документ.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документы.Документ КАК Документ,
	|	ВТ_Документы.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УдалитьЛимитыПоБюджетам КАК УдалитьЛимитыПоБюджетам
	|		ПО ВТ_Документы.Регистратор = УдалитьЛимитыПоБюджетам.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ВТ_Документы.Документ = ОперацииБюджетов.Регистратор
	|ГДЕ
	|	НЕ УдалитьЛимитыПоБюджетам.Период ЕСТЬ NULL
	|	И ОперацииБюджетов.Период ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Документы.Документ.МоментВремени";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Данные = Новый Структура("Алгоритм, ИзменитьВидБюджета", "УправлениеЛимитами", Ложь);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  		
		Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.Документ);
		Данные.Вставить("Регистратор", ВыборкаДетальныеЗаписи.Регистратор);

		ЗаписатьПланыДокументаОперацииБюджетов(Данные);  	
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьУправлениеЛимитамиБюджетДвиженияРесурсов()
	
	УстановитьПривилегированныйРежим(Истина); 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УправлениеЛимитамиДанные.Ссылка КАК Документ,
	|	УправлениеЛимитамиДанные.Ссылка.Проведен КАК Проведен
	|ИЗ
	|	Документ.УправлениеЛимитами.Данные КАК УправлениеЛимитамиДанные
	|ГДЕ
	|	УправлениеЛимитамиДанные.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	БюджетДвиженияРесурсов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов;   
	БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
	
	ПараметрыОтбора = Новый Структура("ВидБюджета", БюджетДвиженияРесурсов);
	
	Данные = Новый Структура("Алгоритм, ИзменитьВидБюджета", "УправлениеЛимитами", Истина);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   	     
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		
		НайденныеСтроки = ДокументОбъект.Данные.НайтиСтроки(ПараметрыОтбора);   
		Для Каждого СтрокаДанные Из НайденныеСтроки Цикл
			СтрокаДанные.ВидБюджета = БюджетДоходовИРасходов;
		КонецЦикла;
		
		НачатьТранзакцию();
		
		Попытка 
			
			Если ДокументОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);  
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.Проведен Тогда
				
				Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.Документ);
				Данные.Вставить("Регистратор", ПолучитьРегистраторПлановЛимитов(ВыборкаДетальныеЗаписи.Документ));

				ЗаписатьПланыДокументаОперацииБюджетов(Данные); 
				
				НаборЗаписей = РегистрыСведений.УстановкаЛимитовПоДаннымБюджетированияСостояния.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Документ);  
				НаборЗаписей.Прочитать();   
				
				Для Каждого Запись Из НаборЗаписей Цикл
					Если Запись.ВидБюджета = БюджетДвиженияРесурсов Тогда
						Запись.ВидБюджета = БюджетДоходовИРасходов;	
					КонецЕсли;
				КонецЦикла;  
				
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
				
			КонецЕсли;   			

			ЗафиксироватьТранзакцию();
			
		Исключение      
			
			ОтменитьТранзакцию();	
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка, 
			ВыборкаДетальныеЗаписи.Документ.Метаданные(), 
			ВыборкаДетальныеЗаписи.Документ,  
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;  	
		
	КонецЦикла;  
	
КонецПроцедуры

Процедура ЗаполнитьПриходРасходУправлениеЛимитами()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОперацииБюджетов.Регистратор КАК Документ
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|ГДЕ
	|	ОперацииБюджетов.Регистратор ССЫЛКА Документ.УправлениеЛимитами
	|	И ОперацииБюджетов.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Документ);   
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Не ЗначениеЗаполнено(Запись.ПриходРасход) Тогда
				Запись.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;	
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр накопления ""%1"" по документу ""%2""
				|%3'"),
				"Операции бюджетов", ВыборкаДетальныеЗаписи.Документ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  

	КонецЦикла; 
	
КонецПроцедуры

Процедура ОбновитьРегистрСостояниеПериодовЛимитирования()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеРегистра.Регистратор КАК Документ
	|ИЗ
	|	РегистрСведений.УдалитьСостояниеПериодовЛимитирования КАК ДанныеРегистра";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборДанныхИсточник = РегистрыСведений.УдалитьСостояниеПериодовЛимитирования.СоздатьНаборЗаписей();
		НаборДанныхИсточник.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Документ);
		НаборДанныхИсточник.Прочитать();  
		
		ТаблицаИсточник = НаборДанныхИсточник.Выгрузить();
		ТаблицаПриемник = НаборДанныхИсточник.ВыгрузитьКолонки(); 
		
		ПараметрыОтбора = Новый Структура("ВидБюджета, НачалоПериода, Периодичность, ЦФО, Проект");
		Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
			
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТаблицыИсточник);   
			
			НайденныеСтроки = ТаблицаПриемник.НайтиСтроки(ПараметрыОтбора); 
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицыИсточник);
			КонецЕсли;   	
			
		КонецЦикла;  
		
		НаборДанныхПриемник = РегистрыСведений.СостояниеПериодовЛимитирования.СоздатьНаборЗаписей();
		НаборДанныхПриемник.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Документ);
		НаборДанныхПриемник.Загрузить(ТаблицаПриемник);
		
		Попытка
