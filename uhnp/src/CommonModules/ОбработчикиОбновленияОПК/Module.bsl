Процедура ЗаполнитьДокументыАналитикиПланирования() 

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикиПланирования.Ссылка КАК Документ
	|ИЗ
	|	Документ.АктВыполненныхРабот.АналитикиПланирования КАК АналитикиПланирования
	|ГДЕ
	|	НЕ АналитикиПланирования.УдалитьДокументРезервирования = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикиПланирования.Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента.АналитикиПланирования КАК АналитикиПланирования
	|ГДЕ
	|	НЕ АналитикиПланирования.УдалитьДокументРезервирования = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикиПланирования.Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику.АналитикиПланирования КАК АналитикиПланирования
	|ГДЕ
	|	НЕ АналитикиПланирования.УдалитьДокументРезервирования = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикиПланирования.Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаВозвратТоваровОтКлиента.АналитикиПланирования КАК АналитикиПланирования
	|ГДЕ
	|	НЕ АналитикиПланирования.УдалитьДокументРезервирования = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикиПланирования.Ссылка
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.АналитикиПланирования КАК АналитикиПланирования
	|ГДЕ
	|	НЕ АналитикиПланирования.УдалитьДокументРезервирования = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикиПланирования.Ссылка
	|ИЗ
	|	Документ.ПриобретениеУслугПрочихАктивов.АналитикиПланирования КАК АналитикиПланирования
	|ГДЕ
	|	НЕ АналитикиПланирования.УдалитьДокументРезервирования = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикиПланирования.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.АналитикиПланирования КАК АналитикиПланирования
	|ГДЕ
	|	НЕ АналитикиПланирования.УдалитьДокументРезервирования = ЗНАЧЕНИЕ(Документ.УдалитьОперативныйПлан.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();   
		
