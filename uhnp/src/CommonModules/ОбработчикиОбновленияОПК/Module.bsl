	|	УдалитьОперативныйПлан.УдалитьВалютаОплаты КАК УдалитьВалютаОплаты,
	|	УдалитьОперативныйПлан.УдалитьСчетКонтрагента КАК УдалитьСчетКонтрагента,
	|	УдалитьОперативныйПлан.УдалитьЗапретПлатежаВПрочихВалютах КАК УдалитьЗапретПлатежаВПрочихВалютах,
	|	УдалитьОперативныйПлан.УдалитьПлатежВУсловныхЕдиницах КАК УдалитьПлатежВУсловныхЕдиницах,
	|	УдалитьОперативныйПлан.УдалитьФиксированныйСчетКонтрагента КАК УдалитьФиксированныйСчетКонтрагента,
	|	УдалитьОперативныйПлан.УдалитьФиксированныйСчетОрганизации КАК УдалитьФиксированныйСчетОрганизации,
	|	УдалитьОперативныйПлан.УдалитьЭтапПроекта КАК УдалитьЭтапПроекта,
	|	УдалитьОперативныйПлан.УдалитьСостояние КАК УдалитьСостояние,
	|	УдалитьОперативныйПлан.БалансКорректировок КАК БалансКорректировок,
	|	УдалитьОперативныйПлан.БалансКорректировокУпр КАК БалансКорректировокУпр,
	|	УдалитьОперативныйПлан.ЭтоКатегорияНоменклатуры КАК ЭтоКатегорияНоменклатуры,
	|	УдалитьОперативныйПлан.ХарактеристикиИспользуются КАК ХарактеристикиИспользуются,
	|	УдалитьОперативныйПлан.НазначениеРезерва_Контрагент КАК НазначениеРезерва_Контрагент,
	|	УдалитьОперативныйПлан.НазначениеРезерва_ДоговорКонтрагента КАК НазначениеРезерва_ДоговорКонтрагента,
	|	УдалитьОперативныйПлан.ДокументОбновления КАК ДокументОбновления,
	|	ВидыБюджетов.Ссылка КАК ВидБюджета,
	|	""Планирование"" КАК Алгоритм
	|ИЗ
	|	Документ.УдалитьОперативныйПлан КАК УдалитьОперативныйПлан
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|		ПО УдалитьОперативныйПлан.Предназначение = ВидыБюджетов.Предназначение
	|ГДЕ                                                                                                           
	|	УдалитьОперативныйПлан.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.Планирование)
	|	И УдалитьОперативныйПлан.ДокументОбновления = НЕОПРЕДЕЛЕНО
	|	И (УдалитьОперативныйПлан.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств)
	|		ИЛИ УдалитьОперативныйПлан.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов))
	|	И НЕ УдалитьОперативныйПлан.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();  
	ВсегоПакетов = РезультатЗапроса.Количество()-1;  
	
	ТекущаяДата = ТекущаяДатаСеанса();
	Для НомерПакета = 0 По ВсегоПакетов Цикл 
	 
		ВыборкаДетальныеЗаписи = РезультатЗапроса[НомерПакета].Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

			ПерезаписатьСтарыйДокумент =  Ложь;
			Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДокументОбновления) Тогда
				НовыйДокументОбъект = Документы.ОперативныйПлан.СоздатьДокумент();
				НовыйДокументОбъект.УстановитьНовыйНомер();
				ПерезаписатьСтарыйДокумент = Истина;
			Иначе
				НовыйДокументОбъект = ВыборкаДетальныеЗаписи.ДокументОбновления.ПолучитьОбъект();
			КонецЕсли;
			
			СтарыйДокумент = ВыборкаДетальныеЗаписи.СтарыйДокумент;
			
			// Заполнение шапки документа
			ЗаполнитьЗначенияСвойств(НовыйДокументОбъект, ВыборкаДетальныеЗаписи); 
			
			// Заполнение табличных частей
			ТабличныеЧастиКПереносу = Новый Массив;  
			ТабличныеЧастиКПереносу.Добавить("ДвиженияОперации");
			ТабличныеЧастиКПереносу.Добавить("РезультатыКонтроля");
			ТабличныеЧастиКПереносу.Добавить("НастройкаАналитик");
			ТабличныеЧастиКПереносу.Добавить("Периоды");
			ТабличныеЧастиКПереносу.Добавить("ДополнительныеРеквизиты");  
			
			Для Каждого ИмяТабличнойЧасти Из ТабличныеЧастиКПереносу Цикл
				ТабличнаяЧастьКПереносу = СтарыйДокумент[ИмяТабличнойЧасти].Выгрузить();
				НовыйДокументОбъект[ИмяТабличнойЧасти].Загрузить(ТабличнаяЧастьКПереносу);
			КонецЦикла;
			
			НачатьТранзакцию();
			
			Попытка 
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовыйДокументОбъект);       
				
				Если Не ВыборкаДетальныеЗаписи.ПометкаУдаления Тогда
					ПеренестиДвиженияИзСтарогоОперационногоПлана(СтарыйДокумент, НовыйДокументОбъект.Ссылка, ВыборкаДетальныеЗаписи.Алгоритм);
				КонецЕсли;
				
				Если ПерезаписатьСтарыйДокумент Тогда   
					СтарыйДокументОбъект = СтарыйДокумент.ПолучитьОбъект();
					СтарыйДокументОбъект.ДокументОбновления = НовыйДокументОбъект.Ссылка;
					ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СтарыйДокументОбъект); 
				КонецЕсли;  
				
				ЗафиксироватьТранзакцию();
				
			Исключение      
				
				ОтменитьТранзакцию();	
				
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка, НовыйДокументОбъект.Метаданные(), 
				НовыйДокументОбъект.Ссылка,  
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			КонецПопытки;

			Попытка
				ТекСостояние = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(СтарыйДокумент); 
				
				Если Не ТекСостояние = Неопределено Тогда  				
					УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(НовыйДокументОбъект.Ссылка, 
												ТекСостояние, ТекущаяДата, ВыборкаДетальныеЗаписи.Ответственный, , , Ложь);   
				КонецЕсли;  
			Исключение
			КонецПопытки;  
			
		КонецЦикла;  
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьДокументыОперативныйПланБюджетДвиженияРесурсов()

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдалитьОперативныйПлан.Ссылка КАК СтарыйДокумент,
	|	УдалитьОперативныйПлан.ПометкаУдаления КАК ПометкаУдаления,
	|	УдалитьОперативныйПлан.Дата КАК Дата,
	|	УдалитьОперативныйПлан.Проведен КАК Проведен,
	|	УдалитьОперативныйПлан.ВидОперации КАК ВидОперации,
	|	УдалитьОперативныйПлан.РежимВводаДокументаПланирования КАК РежимВводаДокументаПланирования,
