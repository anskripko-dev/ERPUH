Процедура ОбновитьОперацииБюджетовВерсииСоглашений() 
	
	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос;    
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистраторПлановЛимитов.Ссылка КАК Регистратор,
	|	РегистраторПлановЛимитов.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.РегистраторПлановЛимитов КАК РегистраторПлановЛимитов
	|ГДЕ
	|	(РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияКоммерческийДоговор
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияАккредитив
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияКредит
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияБанковскаяГарантия
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияВалютныйСвоп
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияВалютноПроцентныйСвоп
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияВалютныйФорвард
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ВерсияСоглашенияДепозит
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ЗаключениеДоговораАренды
	|			ИЛИ РегистраторПлановЛимитов.Документ ССЫЛКА Документ.ИзменениеУсловийДоговораАренды)
	|	И РегистраторПлановЛимитов.Документ.Проведен
	|	И РегистраторПлановЛимитов.Документ.ИспользованиеГрафикаРасчетовБДДС = ЗНАЧЕНИЕ(Перечисление.РежимыИспользованияГрафика.АвтоматическоеСозданиеПлатежныхПозиций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документы.Документ КАК Документ,
	|	ВТ_Документы.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УдалитьЛимитыПоБюджетам КАК УдалитьЛимитыПоБюджетам
	|		ПО ВТ_Документы.Регистратор = УдалитьЛимитыПоБюджетам.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ВТ_Документы.Документ = ОперацииБюджетов.Регистратор
	|ГДЕ
	|	НЕ УдалитьЛимитыПоБюджетам.Период ЕСТЬ NULL
	|	И ОперацииБюджетов.Период ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Документы.Документ.МоментВремени";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Данные = Новый Структура("Алгоритм", "ВерсияСоглашения");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		Данные.Вставить("Документ", ВыборкаДетальныеЗаписи.Документ);
		Данные.Вставить("Регистратор", ВыборкаДетальныеЗаписи.Регистратор);  
		
		ЗаписатьПланыДокументаОперацииБюджетов(Данные);
	КонецЦикла;	

КонецПроцедуры  

