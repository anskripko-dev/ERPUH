
#Область ПроцедурыИФункцииНачальноеЗаполнение

Процедура ПервоначальноеЗаполнениеПараметровОПК(Параметры = Неопределено) Экспорт
	
	Инфо = СостояниеРегистровПараметровОПК();   
	
	Если Не Инфо.КоличествоЗаписейПараметровОП = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПланыВидовХарактеристик.ВидыБюджетов.ПервоначальноеЗаполнение();
	ПланыВидовХарактеристик.ВидыКонтроляДокументов.ПервоначальноеЗаполнение();
	Справочники.АналитикиОперативногоПланирования.ПервоначальноеЗаполнение();
	РегистрыСведений.ПараметрыЛимитирования.ПервоначальноеЗаполнение();
	РегистрыСведений.СтруктураОперативногоПланирования.ПервоначальноеЗаполнение();
	Справочники.ВидыОперативныхПланов.ПервоначальноеЗаполнение(); 
		
	Константы.УдалитьБюджетДвиженияДенежныхСредствИспользуется.Установить(Истина);  
	Константы.УдалитьБюджетДоходовРасходовИспользуется.Установить(Истина);
	Константы.УдалитьБюджетЗакупокИспользуется.Установить(Истина);
	
КонецПроцедуры  

Процедура ЗаполнитьДокументыОПКПоУмолчанию() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументыБД = Новый Массив;
	ДокументыБД.Добавить("Резервирование");
	ДокументыБД.Добавить("ЗаявкаНаКорректировкуПланов");
	ДокументыБД.Добавить("КорректировкаПланов");
	
	Для Каждого ИмяДокумента Из ДокументыБД Цикл
		
		ДокументОбъект	= Справочники.ДокументыБД.НайтиПоНаименованию(ИмяДокумента, Истина, , Справочники.ТипыБазДанных.ТекущаяИБ).ПолучитьОбъект();	
		ДокументОбъект.РеквизитСостояния = "Состояние";
		ДокументОбъект.ЗначениеРеквизитаСостоянияНаУтверждении	= Перечисления.СостоянияСогласования.НаУтверждении;
		ДокументОбъект.ЗначениеРеквизитаСостоянияОтклонен		= Перечисления.СостоянияСогласования.Отклонена;
		ДокументОбъект.ЗначениеРеквизитаСостоянияУтвержден		= Перечисления.СостоянияСогласования.Утверждена;
		
		ДокументОбъект.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры 

#КонецОбласти  

#Область ПроцедурыИФункцииОтказОтБюджетаДвиженияРесурсов

Процедура ОбновитьОтказОтБюджетаДвиженияРесурсов() Экспорт
	
	СоздатьСтатьиДоходовИРасходов();   
	СоздатьВидыОперативныхПлановСтатьиДоходовИРасходов();
	
	ОбновитьВидыОтчетовПредназначение();
	ОбновитьГруппыКолонкиСтрокиПредназначение();    
	
	ЗаполнитьГруппыСтатейБюджетаРесурсовВБДР();
	ЗаполнитьСтатьюБюджетаСтрокиПоказателиОтчетов();
	ЗаполнитьСтатьяБюджетаИсточникиДанныхДляРасчетов();
	ЗаполнитьСтатьяБюджетаКлючиАналитикиПланированияСтатейБюджетов();
	ЗаполнитьКлючиКонтроляБюджетныхЛимитовРезервов();
	
	ОбновитьРегистрСтруктураОперативногоПланирования();
	ОбновитьРегистрАналитикаПланированияСтатейБюджетов();
	ОбновитьРасчетыСКонтрагентамиБюджетДвиженияРесурсов();
	
КонецПроцедуры  

Процедура СоздатьСтатьиДоходовИРасходов()
	
	УстановитьПривилегированныйРежим(Истина);
   
	ГруппаСтатьиБюджетаЗакупок = ГруппаСтатьиБюджетаЗакупок();
	
	// Создание групп 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатьиДвиженияРесурсов.Ссылка КАК Элемент,
	|	СтатьиДвиженияРесурсов.Родитель КАК Родитель,
	|	СтатьиДвиженияРесурсов.Наименование КАК Наименование
	|ИЗ
	|	Справочник.СтатьиДвиженияРесурсов КАК СтатьиДвиженияРесурсов
	|ГДЕ
	|	СтатьиДвиженияРесурсов.СтатьяБДР = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|	И СтатьиДвиженияРесурсов.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Элемент ИЕРАРХИЯ"; 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СправочникОбъект = Справочники.СтатьиДоходовИРасходов.СоздатьГруппу();
	
		ЗаполнитьЗначенияСвойств(СправочникОбъект, ВыборкаДетальныеЗаписи);
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Родитель) Тогда
			СправочникОбъект.Родитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.Родитель, "СтатьяБДР");	
		Иначе
			СправочникОбъект.Родитель = ГруппаСтатьиБюджетаЗакупок;
		КонецЕсли;   	
		ЗаписатьОбъект(СправочникОбъект);    
		
		СправочникСДРОбъект =  ВыборкаДетальныеЗаписи.Элемент.ПолучитьОбъект();
		СправочникСДРОбъект.СтатьяБДР = СправочникОбъект.Ссылка;
		ЗаписатьОбъект(СправочникСДРОбъект);  
		
	КонецЦикла;
	
	// Создание элементов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатьиДвиженияРесурсов.Ссылка КАК Элемент,
	|	СтатьиДвиженияРесурсов.Родитель.СтатьяБДР КАК Родитель,
	|	СтатьиДвиженияРесурсов.Наименование КАК Наименование,
	|	СтатьиДвиженияРесурсов.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	СтатьиДвиженияРесурсов.ПриходРасход КАК ПриходРасход,
	|	СтатьиДвиженияРесурсов.Приоритет КАК Приоритет,
	|	СтатьиДвиженияРесурсов.ФункциональноеНаправление КАК ФункциональноеНаправление,
	|	СтатьиДвиженияРесурсов.ВидАналитики1 КАК ВидАналитики1,
	|	СтатьиДвиженияРесурсов.ВидАналитики2 КАК ВидАналитики2,
	|	СтатьиДвиженияРесурсов.ВидАналитики3 КАК ВидАналитики3,
	|	СтатьиДвиженияРесурсов.ВидАналитики4 КАК ВидАналитики4,
	|	СтатьиДвиженияРесурсов.ВидАналитики5 КАК ВидАналитики5,
	|	СтатьиДвиженияРесурсов.ВидАналитики6 КАК ВидАналитики6,
	|	СтатьиДвиженияРесурсов.Наименование1 КАК Наименование1,
	|	СтатьиДвиженияРесурсов.Наименование2 КАК Наименование2
	|ИЗ
	|	Справочник.СтатьиДвиженияРесурсов КАК СтатьиДвиженияРесурсов
	|ГДЕ
	|	СтатьиДвиженияРесурсов.СтатьяБДР = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|	И НЕ СтатьиДвиженияРесурсов.ЭтоГруппа"; 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СправочникОбъект = Справочники.СтатьиДоходовИРасходов.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(СправочникОбъект, ВыборкаДетальныеЗаписи);
		
		Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Родитель) Тогда
			СправочникОбъект.Родитель = ГруппаСтатьиБюджетаЗакупок;		
		КонецЕсли; 
		
		ЗаписатьОбъект(СправочникОбъект);
		
		СправочникСДРОбъект =  ВыборкаДетальныеЗаписи.Элемент.ПолучитьОбъект();
		СправочникСДРОбъект.СтатьяБДР = СправочникОбъект.Ссылка;
		ЗаписатьОбъект(СправочникСДРОбъект);   
		
	КонецЦикла;

КонецПроцедуры 

Функция ГруппаСтатьиБюджетаЗакупок()
	
	УстановитьПривилегированныйРежим(Истина);    
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатьиДоходовИРасходов.Ссылка КАК Группа
	|ИЗ
	|	Справочник.СтатьиДоходовИРасходов КАК СтатьиДоходовИРасходов
	|ГДЕ
	|	СтатьиДоходовИРасходов.ЭтоГруппа
	|	И НЕ СтатьиДоходовИРасходов.ПометкаУдаления
	|	И СтатьиДоходовИРасходов.Наименование = ""Статьи бюджета закупок""";
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Если РезультатЗапроса.Пустой() Тогда
		
		ГруппаОбъект = Справочники.СтатьиДоходовИРасходов.СоздатьГруппу();
		ГруппаОбъект.Наименование = "Статьи бюджета закупок";    
		ЗаписатьОбъект(ГруппаОбъект);
		
		Группа = ГруппаОбъект.Ссылка; 
		
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Группа = ВыборкаДетальныеЗаписи.Группа;
	КонецЕсли;   

	Возврат Группа;

КонецФункции 

Процедура СоздатьВидыОперативныхПлановСтатьиДоходовИРасходов() 

	УстановитьПривилегированныйРежим(Истина);
	
	АналитикиИсключение = Новый Массив; 
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.Приоритет);
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.Менеджер);
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.МестоПоставки);
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.Номенклатура); 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОперативныхПланов.Ссылка КАК Элемент,
	|	ВидыОперативныхПланов.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	Справочник.ВидыОперативныхПланов КАК ВидыОперативныхПланов
	|ГДЕ
	|	ВидыОперативныхПланов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|	И ВидыОперативныхПланов.ВидОперативногоПланаБДР = ЗНАЧЕНИЕ(Справочник.ВидыОперативныхПланов.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СправочникОбъект = ВыборкаДетальныеЗаписи.Элемент.Скопировать();  
		СправочникОбъект.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов; 
		СправочникОбъект.УстановитьНовыйКод();
		СправочникОбъект.НеИспользовать = Ложь;  
				
		Сч = 0;
		Пока Сч < СправочникОбъект.НастройкаАналитик.Количество() Цикл
			
			Если Не АналитикиИсключение.Найти(СправочникОбъект.НастройкаАналитик[Сч].Аналитика) = Неопределено Тогда
				СправочникОбъект.НастройкаАналитик.Удалить(Сч);	
			Иначе
				Сч = Сч + 1;	
			КонецЕсли;  		
			
		КонецЦикла;

		ЗаписатьОбъект(СправочникОбъект);  
		
		СправочникОбъектБЗ = ВыборкаДетальныеЗаписи.Элемент.ПолучитьОбъект();  
		СправочникОбъектБЗ.ВидОперативногоПланаБДР = СправочникОбъект.Ссылка;
		СправочникОбъектБЗ.НеИспользовать = Истина;
		
		ЗаписатьОбъект(СправочникОбъектБЗ);  	
		
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьВидыОтчетовПредназначение() 

	УстановитьПривилегированныйРежим(Истина);

	БюджетДоходовИРасходов = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов;
	БюджетДвиженияРесурсов = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОтчетов.Ссылка КАК Элемент
	|ИЗ
	|	Справочник.ВидыОтчетов КАК ВидыОтчетов
	|ГДЕ
	|	ВидыОтчетов.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		СправочникОбъект = ВыборкаДетальныеЗаписи.Элемент.ПолучитьОбъект();
		СправочникОбъект.Предназначение = БюджетДоходовИРасходов;
		
		ЗаписатьОбъект(СправочникОбъект);

	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОтчетов.Ссылка КАК Элемент
	|ИЗ
	|	Справочник.ВидыОтчетов КАК ВидыОтчетов
	|ГДЕ
	|	ВидыОтчетов.ПараметрыУстановкиЛимитов.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		СправочникОбъект = ВыборкаДетальныеЗаписи.Элемент.ПолучитьОбъект();  
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Предназначение", БюджетДвиженияРесурсов);
		
		НайденныеСтроки = СправочникОбъект.ПараметрыУстановкиЛимитов.НайтиСтроки(ПараметрыОтбора);   
		Для Каждого ЭлементКоллеции Из НайденныеСтроки Цикл
			ЭлементКоллеции.Предназначение = БюджетДоходовИРасходов;
		КонецЦикла;

		ЗаписатьОбъект(СправочникОбъект);

	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьГруппыКолонкиСтрокиПредназначение() 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыАналитикСтатьи.Ссылка КАК Элемент
	|ИЗ
	|	Справочник.ГруппыАналитикСтатьи КАК ГруппыАналитикСтатьи
	|ГДЕ
	|	ГруппыАналитикСтатьи.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГруппыРаскрытия.Ссылка
	|ИЗ
	|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
	|ГДЕ
	|	ГруппыРаскрытия.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КолонкиОтчетов.Ссылка
	|ИЗ
	|	Справочник.КолонкиОтчетов КАК КолонкиОтчетов
	|ГДЕ
	|	КолонкиОтчетов.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоказателиОтчетов.Ссылка
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|ГДЕ
	|	ПоказателиОтчетов.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтрокиОтчетов.Ссылка
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|ГДЕ
	|	СтрокиОтчетов.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)";  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	БюджетДоходовИРасходов = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		СправочникОбъект = ВыборкаДетальныеЗаписи.Элемент.ПолучитьОбъект();
		СправочникОбъект.Предназначение = БюджетДоходовИРасходов;
		
		ЗаписатьОбъект(СправочникОбъект);

	КонецЦикла; 
 
