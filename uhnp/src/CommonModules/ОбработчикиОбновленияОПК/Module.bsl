	|	КУдалению.УОП КАК УОП,
	|	ВЫБОР
	|		КОГДА КУдалению.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|		ИНАЧЕ КУдалению.ВидБюджета
	|	КОНЕЦ КАК ВидБюджета,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(КУдалению.СтатьяБюджета) = ТИП(Справочник.СтатьиДвиженияРесурсов)
	|			ТОГДА КУдалению.СтатьяБюджета.СтатьяБДР
	|		ИНАЧЕ КУдалению.СтатьяБюджета
	|	КОНЕЦ КАК СтатьяБюджета
	|ИЗ
	|	РегистрСведений.УдалитьУстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей КАК КУдалению
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей КАК НовыеЗаписи
	|		ПО КУдалению.Документ = НовыеЗаписи.Документ
	|			И КУдалению.Показатель = НовыеЗаписи.Показатель
	|			И КУдалению.ПериодОтчета = НовыеЗаписи.ПериодОтчета
	|			И КУдалению.Организация = НовыеЗаписи.Организация
	|			И КУдалению.Проект = НовыеЗаписи.Проект
	|			И КУдалению.Валюта = НовыеЗаписи.Валюта
	|			И КУдалению.АналитикаВалюта = НовыеЗаписи.АналитикаВалюта
	|			И (ВЫБОР
	|				КОГДА КУдалению.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|					ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|				ИНАЧЕ КУдалению.ВидБюджета
	|			КОНЕЦ = НовыеЗаписи.ВидБюджета)
	|			И КУдалению.Аналитика1 = НовыеЗаписи.Аналитика1
	|			И КУдалению.Аналитика2 = НовыеЗаписи.Аналитика2
	|			И КУдалению.Аналитика3 = НовыеЗаписи.Аналитика3
	|			И КУдалению.Аналитика4 = НовыеЗаписи.Аналитика4
	|			И КУдалению.Аналитика5 = НовыеЗаписи.Аналитика5
	|			И КУдалению.Аналитика6 = НовыеЗаписи.Аналитика6
	|ГДЕ
	|	НовыеЗаписи.Документ ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
		
		Попытка
			МенеджерЗаписи.Записать(Истина);   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1""
			|%2'"),
			Метаданные.РегистрыСведений.УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.Представление(),    
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения); 
		КонецПопытки;

	КонецЦикла;  
	
КонецПроцедуры

#КонецОбласти  

