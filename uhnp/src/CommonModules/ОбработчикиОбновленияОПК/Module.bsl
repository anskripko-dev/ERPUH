	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НеактуальныеДанные.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НеактуальныеДанные.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)
	|					ТОГДА ВЫБОР
	|							КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств)
	|								ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|							КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|									ИЛИ НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|								ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|						КОНЕЦ
	|				ИНАЧЕ НеактуальныеДанные.ВидБюджета
	|			КОНЕЦ
	|	КОНЕЦ КАК ВидБюджета,
	|	ВЫБОР
	|		КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|		ИНАЧЕ НеактуальныеДанные.Предназначение
	|	КОНЕЦ КАК Предназначение,
	|	НеактуальныеДанные.Аналитика КАК Аналитика,
	|	МАКСИМУМ(НеактуальныеДанные.ОбязательноеЗаполнение) КАК ОбязательноеЗаполнение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НеактуальныеДанные.КонтрольЛимитов) КАК КонтрольЛимитов
	|ИЗ
	|	РегистрСведений.УдалитьСтруктураОперативногоПланирования КАК НеактуальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураОперативногоПланирования КАК СтруктураОперативногоПланирования
	|		ПО (ВЫБОР
	|				КОГДА НеактуальныеДанные.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|					ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|				ИНАЧЕ НеактуальныеДанные.ВидБюджета
	|			КОНЕЦ = СтруктураОперативногоПланирования.ВидБюджета)
	|			И (ВЫБОР
	|				КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|				ИНАЧЕ НеактуальныеДанные.Предназначение
	|			КОНЕЦ = СтруктураОперативногоПланирования.Предназначение)
	|			И НеактуальныеДанные.Аналитика = СтруктураОперативногоПланирования.Аналитика
	|ГДЕ
	|	СтруктураОперативногоПланирования.ВидБюджета ЕСТЬ NULL
	|	И НЕ НеактуальныеДанные.Аналитика В (&АналитикиИсключение)
	|
	|СГРУППИРОВАТЬ ПО
	|	НеактуальныеДанные.Аналитика,
	|	ВЫБОР
	|		КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|		ИНАЧЕ НеактуальныеДанные.Предназначение
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НеактуальныеДанные.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НеактуальныеДанные.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)
	|					ТОГДА ВЫБОР
	|							КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств)
	|								ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|							КОГДА НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов)
	|									ИЛИ НеактуальныеДанные.Предназначение = ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияРесурсов)
	|								ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|						КОНЕЦ
	|				ИНАЧЕ НеактуальныеДанные.ВидБюджета
	|			КОНЕЦ
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидБюджета,
	|	Предназначение,
	|	Аналитика";  
	
	АналитикиИсключение = Новый Массив; 
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.Приоритет);
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.Менеджер);
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.МестоПоставки);
	АналитикиИсключение.Добавить(Справочники.АналитикиОперативногоПланирования.Номенклатура);
	
	Запрос.УстановитьПараметр("АналитикиИсключение", АналитикиИсключение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.СтруктураОперативногоПланирования.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
		
		Попытка
			МенеджерЗаписи.Записать(Истина);   
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1""
			|%2'"),
			Метаданные.РегистрыСведений.СтруктураОперативногоПланирования.Представление(),    
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  
		
	КонецЦикла;

