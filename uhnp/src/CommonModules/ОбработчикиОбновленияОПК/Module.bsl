		|		ПО ДанныеРегистра.Предназначение = ВидыБюджетов.Предназначение
		|ГДЕ
		|	ДанныеРегистра.Регистратор = &Регистратор
		|	И НЕ ДанныеРегистра.Заявлено = 0";    
		
	ИначеЕсли Данные.Алгоритм = "ДокументАренды" Тогда  
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДанныеРегистра.ПериодЛимитирования.ДатаНачала КАК Период,
		|	ВидыБюджетов.Ссылка КАК ВидБюджета,
		|	ДанныеРегистра.ЦФО КАК ЦФО,
		|	ДанныеРегистра.Проект КАК Проект,
		|	ДанныеРегистра.СтатьяБюджета КАК СтатьяБюджета,
		|	ДанныеРегистра.Аналитика1 КАК Аналитика1,
		|	ДанныеРегистра.Аналитика2 КАК Аналитика2,
		|	ДанныеРегистра.Аналитика3 КАК Аналитика3,
		|	ДанныеРегистра.Аналитика4 КАК Аналитика4,
		|	ДанныеРегистра.Аналитика5 КАК Аналитика5,
		|	ДанныеРегистра.Аналитика6 КАК Аналитика6,
		|	ДанныеРегистра.Валюта КАК Валюта,
		|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
		|	ДанныеРегистра.ДокументПланирования КАК ДокументПланирования,
		|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
		|	&ДатаРегистрации КАК ДатаРегистрации,
		|	ДанныеРегистра.Заявлено КАК Сумма
		|ПОМЕСТИТЬ ВТ_ПланыДокумента
		|ИЗ
		|	РегистрНакопления.УдалитьЛимитыПоБюджетам КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
		|		ПО ДанныеРегистра.Предназначение = ВидыБюджетов.Предназначение
		|ГДЕ
		|	ДанныеРегистра.Регистратор = &Регистратор
		|	И НЕ ДанныеРегистра.Заявлено = 0"; 
		
	ИначеЕсли Данные.Алгоритм = "ПланЗакупок" Тогда  
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДанныеРегистра.ПериодЛимитирования.ДатаНачала КАК Период,
		|	ВЫБОР
		|		КОГДА ВидыБюджетов.Ссылка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов)
		|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
		|		ИНАЧЕ ВидыБюджетов.Ссылка
		|	КОНЕЦ КАК ВидБюджета,
		|	ДанныеРегистра.ЦФО КАК ЦФО,
		|	ДанныеРегистра.Проект КАК Проект,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеРегистра.СтатьяБюджета) = ТИП(Справочник.СтатьиДвиженияРесурсов)
		|			ТОГДА ДанныеРегистра.СтатьяБюджета.СтатьяБДР
		|		ИНАЧЕ ДанныеРегистра.СтатьяБюджета
		|	КОНЕЦ КАК СтатьяБюджета,
		|	ДанныеРегистра.Аналитика1 КАК Аналитика1,
		|	ДанныеРегистра.Аналитика2 КАК Аналитика2,
		|	ДанныеРегистра.Аналитика3 КАК Аналитика3,
		|	ДанныеРегистра.Аналитика4 КАК Аналитика4,
		|	ДанныеРегистра.Аналитика5 КАК Аналитика5,
		|	ДанныеРегистра.Аналитика6 КАК Аналитика6,
		|	ДанныеРегистра.Регистратор.Документ.Валюта КАК Валюта,
		|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
		|	ДанныеРегистра.ДокументПланирования КАК ДокументПланирования,
		|	ДанныеРегистра.ДокументПланирования КАК ДокументРезервирования,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
		|	&ДатаРегистрации КАК ДатаРегистрации,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.Регистратор.Документ.Валюта = ДанныеРегистра.Валюта
		|			ТОГДА ДанныеРегистра.Зарезервировано
		|		ИНАЧЕ ДанныеРегистра.Зарезервировано * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1)
		|	КОНЕЦ КАК Сумма,
		|	ДанныеРегистра.Зарезервировано КАК Лимит
		|ПОМЕСТИТЬ ВТ_ПланыДокумента
		|ИЗ
		|	РегистрНакопления.УдалитьЛимитыПоБюджетам КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
		|		ПО ДанныеРегистра.Предназначение = ВидыБюджетов.Предназначение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаРегистрации, ) КАК КурсыВалютСрезПоследних
		|		ПО ДанныеРегистра.Валюта = КурсыВалютСрезПоследних.Валюта
		|ГДЕ
		|	ДанныеРегистра.Регистратор = &Регистратор
		|	И НЕ ДанныеРегистра.Зарезервировано = 0";  
		
	КонецЕсли;            
	
	Запрос.Текст = ТекстЗапроса;  
	
	Для Каждого ЭлементКоллекции Из Данные Цикл
		Запрос.УстановитьПараметр(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);	
	КонецЦикла;
    Запрос.УстановитьПараметр("ДатаРегистрации", Данные.Документ.Дата);

	Запрос.Выполнить();
	
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ПланыДокумента");
	
	Возврат Запрос.МенеджерВременныхТаблиц;    
	
КонецФункции

Процедура ЗаписатьПланыДокументаОперацииБюджетов(Данные) 

	Перем ТаблицаОперацииБюджетов;
	
	ДополнительныеСвойства = Новый Структура;
	ПроведениеСерверОПК.ИнициализироватьДополнительныеСвойстваДляПроведения(Данные.Документ, ДополнительныеСвойства); 
	
	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПланыДокумента(Данные, Запрос.МенеджерВременныхТаблиц);
	
	ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокумента");
	ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаОперацииБюджетов", ТаблицаОперацииБюджетов);
	
	Если ТаблицаОперацииБюджетов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();        
	
	Регистратор = ?(Данные.Свойство("НовыйДокумент"), Данные.НовыйДокумент, Данные.Документ);
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	
	НаборЗаписей.Загрузить(ТаблицаОперацииБюджетов);
	
	Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, , , Истина);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти  

#Область ПроцедурыИФункцииДокументыПланирования

Процедура ЗаполнитьДокументПланирования() Экспорт
	
	ЗаполнитьДокументПланированияСписаниеСРасчетногоСчета();
	ЗаполнитьДокументПланированияРасходныйКассовыйОрдер();
	ЗаполнитьДокументыАналитикиПланирования();
	
КонецПроцедуры

Процедура ЗаполнитьДокументПланированияСписаниеСРасчетногоСчета() 

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.Ссылка КАК Документ
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК СписаниеСРасчетногоСчетаРасшифровкаПлатежа
	|ГДЕ
	|	НЕ СписаниеСРасчетногоСчетаРасшифровкаПлатежа.ДокументПланирования = НЕОПРЕДЕЛЕНО";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();   
		
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.РасшифровкаПлатежа Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДокументПланирования) Тогда
				Продолжить;
			КонецЕсли;
			
			ДокументПланирования = СтрокаТабличнойЧасти.ДокументПланирования; 
			
			Если ТипЗнч(ДокументПланирования) = Тип("ДокументСсылка.УдалитьОперативныйПлан") Тогда
				ДокументПланирования = ДокументПланирования.ДокументОбновления;	
			КонецЕсли;
			
			СтрокаТабличнойЧасти.ДокументПланирования = ДокументПланирования;
			
		КонецЦикла; 
		
		Если Не ДокументОбъект.Модифицированность() Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
			"ru = 'Не удалось записать документ ""%1"" 
			|%2'"),
			ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  
		
	КонецЦикла;

КонецПроцедуры 

