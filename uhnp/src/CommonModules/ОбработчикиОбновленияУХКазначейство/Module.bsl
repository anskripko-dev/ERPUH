Процедура ЗаполнитьОсновныеДоговорыКонтрагентовУХ() Экспорт
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	=	 
		"ВЫБРАТЬ
		|	ОсновныеДоговорыКонтрагента.Организация КАК Организация,
		|	ОсновныеДоговорыКонтрагента.Контрагент КАК Контрагент,
		|	ОсновныеДоговорыКонтрагента.Договор КАК Договор,
		|	ОсновныеДоговорыКонтрагента.Договор.ВидДоговораУХ КАК ВидДоговораУХ
		|ИЗ
		|	РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДоговорыКонтрагентовУХ КАК ОсновныеДоговорыКонтрагентовУХ
		|		ПО ОсновныеДоговорыКонтрагента.Организация = ОсновныеДоговорыКонтрагентовУХ.Организация
		|			И ОсновныеДоговорыКонтрагента.Контрагент = ОсновныеДоговорыКонтрагентовУХ.Контрагент
		|			И ОсновныеДоговорыКонтрагента.Договор.ВидДоговораУХ = ОсновныеДоговорыКонтрагентовУХ.ВидДоговораУХ
		|ГДЕ
		|	ОсновныеДоговорыКонтрагента.Договор.ВидДоговораУХ <> ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.ПустаяСсылка)
		|	И ОсновныеДоговорыКонтрагентовУХ.ДоговорКонтрагента ЕСТЬ NULL";
	
	РезультатЗапроса 		= Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи 	= РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяЗапись = РегистрыСведений.ОсновныеДоговорыКонтрагентовУХ.СоздатьМенеджерЗаписи();
		НоваяЗапись.Организация 		= ВыборкаДетальныеЗаписи.Организация;
		НоваяЗапись.Контрагент  		= ВыборкаДетальныеЗаписи.Контрагент;
		НоваяЗапись.ВидДоговораУХ 		= ВыборкаДетальныеЗаписи.ВидДоговораУХ;
		НоваяЗапись.ДоговорКонтрагента  = ВыборкаДетальныеЗаписи.Договор;
		НоваяЗапись.Записать(Истина);
	КонецЦикла;   
		
КонецПроцедуры

