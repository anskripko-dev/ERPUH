		|	ДвиженияБюджетированияПоПозициям.СтавкаНДС,
		|	ДвиженияБюджетированияПоПозициям.Партнер,
		|	ДвиженияБюджетированияПоПозициям.ТипСуммыКредитаДепозита,
		|	ДвиженияБюджетированияПоПозициям.Аналитика3,
		|	ДвиженияБюджетированияПоПозициям.СтатьяДвиженияДенежныхСредств,
		|	ДвиженияБюджетированияПоПозициям.ЦеннаяБумага,
		|	ДвиженияБюджетированияПоПозициям.Аналитика4,
		|	ДвиженияБюджетированияПоПозициям.Аналитика1,
		|	ДвиженияБюджетированияПоПозициям.Ведомость,
		|	ДвиженияБюджетированияПоПозициям.НастройкаСчетовУчета,
		|	ДвиженияБюджетированияПоПозициям.АналитикаРасходов,
		|	ДвиженияБюджетированияПоПозициям.ОбъектРасчетов,
		|	ДвиженияБюджетированияПоПозициям.ЗаявкаНаОперацию,
		|	ДвиженияБюджетированияПоПозициям.ТипПлатежаПоАренде,
		|	ДвиженияБюджетированияПоПозициям.ИдентификаторПозиции,
		|	ДвиженияБюджетированияПоПозициям.ДоговорКонтрагента,
		|	ДвиженияБюджетированияПоПозициям.ВалютаВзаиморасчетов,
		|	ДвиженияБюджетированияПоПозициям.ЭлементСтруктурыЗадолженности,
		|	ДвиженияБюджетированияПоПозициям.Аналитика5,
		|	ДвиженияБюджетированияПоПозициям.Проект,
		|	ДвиженияБюджетированияПоПозициям.ДоговорЗаймаСотруднику,
		|	ДвиженияБюджетированияПоПозициям.Заказ,
		|	ДвиженияБюджетированияПоПозициям.Аналитика6,
		|	ДвиженияБюджетированияПоПозициям.АналитикаАктивовПассивов,
		|	ДвиженияБюджетированияПоПозициям.УдалитьСтавкаНДС,
		|	ДвиженияБюджетированияПоПозициям.КурсВзаиморасчетов,
		|	ДвиженияБюджетированияПоПозициям.КратностьВзаиморасчетов";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить(); 
	
	Для Каждого ДвиженияБюджетированияПоПозициямСтрока Из  ТаблицаРезультат Цикл  
		НЗ = РегистрыСведений.ДвиженияБюджетированияПоПозициям.СоздатьНаборЗаписей();
		
		Для Каждого Колонка Из ТаблицаРезультат.Колонки Цикл
			Если Колонка.Имя = "Сумма" 
					Или Колонка.Имя = "СуммаНДС" 
					Или Колонка.Имя = "СуммаВзаиморасчетов" 
					Или Колонка.Имя = "ВалютаОплаты" 
					Или Колонка.Имя = "КурсПлатежа" 
					Или Колонка.Имя = "КратностьПлатежа" Тогда
				Продолжить;
			КонецЕсли;
			НЗ.Отбор[Колонка.Имя].Установить(ДвиженияБюджетированияПоПозициямСтрока[Колонка.Имя]);
		КонецЦикла;
		
		НЗ.Прочитать(); 
		
		ТаблицаДвижений = НЗ.Выгрузить();
		
		Для Каждого СтрокаТаблицы Из ТаблицаДвижений Цикл 
			
			СтрокаТаблицы.ВалютаОплаты = ДвиженияБюджетированияПоПозициямСтрока.ВалютаОплаты;
			СтрокаТаблицы.КурсПлатежа = ДвиженияБюджетированияПоПозициямСтрока.КурсПлатежа;
			СтрокаТаблицы.КратностьПлатежа = ДвиженияБюджетированияПоПозициямСтрока.КратностьПлатежа; 
			СтрокаТаблицы.Сумма = ДвиженияБюджетированияПоПозициямСтрока.Сумма; 
			СтрокаТаблицы.СуммаВзаиморасчетов = ДвиженияБюджетированияПоПозициямСтрока.СуммаВзаиморасчетов; 
			
		КонецЦикла;   
		
		НЗ.Загрузить(ТаблицаДвижений);  
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ);
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

