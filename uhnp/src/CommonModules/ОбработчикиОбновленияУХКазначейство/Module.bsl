		|	РазмещениеЗаявок.БанковскийСчетКасса <> НЕОПРЕДЕЛЕНО
		|	И ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(РазмещениеЗаявок.БанковскийСчетКасса) = ТИП(Справочник.Кассы)
		|				ТОГДА РазмещениеЗаявок.БанковскийСчетКасса <> ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
		|			ИНАЧЕ РазмещениеЗаявок.БанковскийСчетКасса <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
		|		КОНЕЦ
		|	И (ОжидаемоеПоступлениеДенежныхСредств.СчетКассаОрганизации = НЕОПРЕДЕЛЕНО
		|			ИЛИ ВЫБОР
		|				КОГДА ОжидаемоеПоступлениеДенежныхСредств.СчетКассаОрганизации ЕСТЬ NULL
		|					ТОГДА ИСТИНА
		|				КОГДА ТИПЗНАЧЕНИЯ(ОжидаемоеПоступлениеДенежныхСредств.СчетКассаОрганизации) = ТИП(Справочник.Кассы)
		|						И ОжидаемоеПоступлениеДенежныхСредств.СчетКассаОрганизации = ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				КОГДА ОжидаемоеПоступлениеДенежныхСредств.СчетКассаОрганизации = ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокументОбъект 						= ВыборкаДетальныеЗаписи.ЗаявкаНаОперацию.ПолучитьОбъект();
		ДокументОбъект.СчетКассаОрганизации = ВыборкаДетальныеЗаписи.БанковскийСчетКасса;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	КонецЦикла;
	
КонецПроцедуры

