Функция ВариантыКурсаДоговораПоСпособам()
	
	СоотвествиеОпределенияКурсов = Новый Соответствие;

	СоотвествиеОпределенияКурсов.Вставить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа"),
											ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВариантыКурсаДоговора.Переменный") );
											
	СоотвествиеОпределенияКурсов.Вставить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс"),
											ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВариантыКурсаДоговора.УстановленныйВДоговоре") );
											
	СоотвествиеОпределенияКурсов.Вставить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СпособыОпределенияКурсаПлатежа.КурсНаФиксированнуюДату"),
											ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВариантыКурсаДоговора.Переменный") );
    Возврат СоотвествиеОпределенияКурсов;

КонецФункции // ()

Функция СпособыОпределенияКурсаПлатежаПоВариантамКурсов()
	
	СоотвествиеОпределенияКурсов = Новый Соответствие;

	СоотвествиеОпределенияКурсов.Вставить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВариантыКурсаДоговора.Переменный"),
											ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа") );
											
	СоотвествиеОпределенияКурсов.Вставить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВариантыКурсаДоговора.УстановленныйВДоговоре"),
											ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс") );
											
    Возврат СоотвествиеОпределенияКурсов;

КонецФункции // ()

Функция ФормироватьПозицииЗаявокПоГрафику(ДокументОбъект)
	Возврат ДокументОбъект.РежимИспользованияГрафика = ПредопределенноеЗначение("Перечисление.РежимыИспользованияГрафика.АвтоматическоеСозданиеПлатежныхПозиций");

КонецФункции // ()

// Процедура - Создать позиции заявок по графику
//
// Параметры:
//  Объект				 - ДокументОбъект.ЗаказПоставщику, ДокументОбъект.ЗаказКлиента
//								- документ для которого записываются платежные позиции
//
Процедура СоздатьПозицииЗаказаПоставщикуПоГрафику(Объект) 

	ГрафикВыгрузка = Объект.ГрафикОплатыУХ;
		
	РаботаСДоговорамиКонтрагентовУХ.ОчиститьПозицииЗаявокПоГрафику(Объект.Ссылка);
	
	ОбъектРасчетов 		= Объект.ОбъектРасчетов;
    Контрагент 			= Объект.Контрагент;
	ДоговорКонтрагента 	= Объект.Договор;      
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидОперацииУХ", "ВидДоговораУХ.ВидОперацииУХСписание");
	СтруктураРеквизитов.Вставить("СпособОпределенияКурсаПлатежа");
	РеквизитыДоговорКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорКонтрагента, СтруктураРеквизитов); 
	
	ДатаНачалаДействияДоговора 	= ДоговорыКонтрагентовВстраиваниеУХ.ДатаНачалаДействияДоговора(ДоговорКонтрагента);
	СтавкаНДСПоДоговору 		= ДоговорыКонтрагентовВстраиваниеУХ.ПолучитьСтавкуНДСПоДоговору(ДоговорКонтрагента, ДатаНачалаДействияДоговора);

	НовыеИдентификаторы = Новый Массив;
    
	Для Каждого ТекКлючСозданияПозиции Из ГрафикВыгрузка Цикл
		
		НачатьТранзакцию();
		Попытка
			СуммаПозицииГрафика 		= ТекКлючСозданияПозиции.СуммаПлатежа; 
			НовыеИдентификаторы.Добавить(ТекКлючСозданияПозиции.ИдентификаторПозиции);
       				
			// Создаем запись позиции
			ПозицияОплаты = РегистрыСведений.РазмещениеЗаявок.СоздатьМенеджерЗаписи();
			ПозицияОплаты.ИдентификаторПозиции 	= ТекКлючСозданияПозиции.ИдентификаторПозиции;
			ПозицияОплаты.ЗаявкаНаОперацию 		= Объект.Ссылка;
			ПозицияОплаты.ПриходРасход 			= Перечисления.ВидыДвиженийПриходРасход.Расход;
			ПозицияОплаты.СпособОпределенияКурсаПлатежа	= РеквизитыДоговорКонтрагента.СпособОпределенияКурсаПлатежа;
			
			ПозицияОплаты.БанковскийСчетКасса 	= ТекКлючСозданияПозиции.СчетОрганизации;
			ПозицияОплаты.СчетКонтрагента 		= ТекКлючСозданияПозиции.СчетКонтрагента;
			ПозицияОплаты.ДатаИсполнения 		= ТекКлючСозданияПозиции.ДатаПлатежа;
			ПозицияОплаты.СуммаВзаиморасчетов 	= СуммаПозицииГрафика;
			ПозицияОплаты.Сумма 				= СуммаПозицииГрафика;
			ПозицияОплаты.КурсПлатежа 			= 1;
			ПозицияОплаты.КратностьПлатежа 		= 1;
			ПозицияОплаты.ФормаОплаты 			= Перечисления.ФормыОплаты.Безналичная;
			ПозицияОплаты.ВалютаВзаиморасчетов 	= Объект.Валюта;
			ПозицияОплаты.ВалютаОплаты 			= Объект.Валюта;
			ПозицияОплаты.Организация 			= Объект.Организация;
			ПозицияОплаты.Контрагент 			= Контрагент;
			ПозицияОплаты.ДоговорКонтрагента 	= ДоговорКонтрагента;
			ПозицияОплаты.Проведен 				= Истина;
			ПозицияОплаты.ВидОперацииУХ 		= РеквизитыДоговорКонтрагента.ВидОперацииУХ;
		
			ПозицияОплаты.Записать();
			
			// ДвиженияБюджетированияПоПозициям			
			РасшифровкаПлатежа = РегистрыСведений.ДвиженияБюджетированияПоПозициям.СоздатьНаборЗаписей();
			РасшифровкаПлатежа.Отбор.ИдентификаторПозиции.Установить(ТекКлючСозданияПозиции.ИдентификаторПозиции);
			
			НоваяЗапись = РасшифровкаПлатежа.Добавить();
			НоваяЗапись.ИдентификаторПозиции 	= ТекКлючСозданияПозиции.ИдентификаторПозиции;
			НоваяЗапись.ЗаявкаНаОперацию 		= Объект.Ссылка;
			НоваяЗапись.СтатьяДвиженияДенежныхСредств = ТекКлючСозданияПозиции.СтатьяБюджета;
			Для ном = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
				НоваяЗапись["Аналитика" + ном] = ТекКлючСозданияПозиции["Аналитика" + ном];
			КонецЦикла;
				
			НоваяЗапись.ЭлементСтруктурыЗадолженности = ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг");				
			
			НоваяЗапись.ОбъектРасчетов 			= ОбъектРасчетов;
			НоваяЗапись.ЦФО 					= ТекКлючСозданияПозиции.ЦФО;
			НоваяЗапись.Проект 					= ТекКлючСозданияПозиции.Проект;
			НоваяЗапись.ДоговорКонтрагента 		= ДоговорКонтрагента;
			НоваяЗапись.ВалютаВзаиморасчетов 	= Объект.Валюта;
			НоваяЗапись.Сумма 					= СуммаПозицииГрафика;
			НоваяЗапись.СуммаВзаиморасчетов		= СуммаПозицииГрафика;
			НоваяЗапись.СтавкаНДС 				= СтавкаНДСПоДоговору;   
			НоваяЗапись.КурсПлатежа 			= 1;
			НоваяЗапись.КратностьПлатежа 		= 1;
				
			ОперативноеПланированиеФормыУХКлиентСервер.ПересчитатьСуммуНДС(НоваяЗапись);
					
			РасшифровкаПлатежа.Записать();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение;
		КонецПопытки;
			
	КонецЦикла;
		
	РаботаСДоговорамиКонтрагентовУХ.ПроверитьПравилаЗапретаОперацийДоговоры(Объект.Ссылка, НовыеИдентификаторы);
		
КонецПроцедуры

Процедура СоздатьПозицииЗаказаКлиентаПоГрафику(ДокументОбъект)
	
	АналитикиПланированияБДДС = ПолучитьАналитикиПланированияБДДС(ДокументОбъект);

	Если Не ЗначениеЗаполнено(АналитикиПланированияБДДС) Тогда
		Возврат; /// Без заполненных аналитик не будет платежных позиций 	
	КонецЕсли;
	
	Если НЕ ДокументОбъект.ЭтапыГрафикаОплаты.Количество() Тогда 
		Возврат;
	КонецЕсли;
	
	ОбъектРасчетов 		= ДокументОбъект.ОбъектРасчетов;
    Контрагент 			= ДокументОбъект.Контрагент;
	ДоговорКонтрагента 	= ДокументОбъект.Договор;      
	
	ВидОперацииУХ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента, "ВидДоговораУХ.ВидОперацииУХПоступление"); 
	
	ДатаНачалаДействияДоговора 	= ДоговорыКонтрагентовВстраиваниеУХ.ДатаНачалаДействияДоговора(ДоговорКонтрагента);
	СтавкаНДСПоДоговору 		= ДоговорыКонтрагентовВстраиваниеУХ.ПолучитьСтавкуНДСПоДоговору(ДоговорКонтрагента, ДатаНачалаДействияДоговора);
	НовыеИдентификаторы 		= Новый Массив;
	
	Для Каждого ТекКлючСозданияПозиции Из ДокументОбъект.ЭтапыГрафикаОплаты Цикл
		
		НачатьТранзакцию();
		Попытка
			СуммаПозицииГрафика 		= ТекКлючСозданияПозиции.СуммаПлатежа;  
			НовыеИдентификаторы.Добавить(ТекКлючСозданияПозиции.ИдентификаторПозиции);
					
			// Создаем запись позиции
			ПозицияОплаты = РегистрыСведений.РазмещениеЗаявок.СоздатьМенеджерЗаписи();
			ПозицияОплаты.ИдентификаторПозиции 	= ТекКлючСозданияПозиции.ИдентификаторПозиции;
			ПозицияОплаты.ЗаявкаНаОперацию 		= ДокументОбъект.Ссылка;
			ПозицияОплаты.ПриходРасход 			= Перечисления.ВидыДвиженийПриходРасход.Приход;
			
			ПозицияОплаты.БанковскийСчетКасса 	= ДокументОбъект.БанковскийСчет;
			ПозицияОплаты.СчетКонтрагента 		= ДокументОбъект.БанковскийСчетКонтрагента;
			ПозицияОплаты.ДатаИсполнения 		= ТекКлючСозданияПозиции.ДатаПлатежа;
			ПозицияОплаты.СуммаВзаиморасчетов 	= СуммаПозицииГрафика;
			ПозицияОплаты.Сумма 				= СуммаПозицииГрафика;
			ПозицияОплаты.КурсПлатежа 			= 1;
			ПозицияОплаты.КратностьПлатежа 		= 1;
			ПозицияОплаты.ФормаОплаты 			= Перечисления.ФормыОплаты.Безналичная;
			ПозицияОплаты.ВалютаВзаиморасчетов 	= ДокументОбъект.Валюта;
			ПозицияОплаты.ВалютаОплаты 			= ДокументОбъект.Валюта;
			ПозицияОплаты.Организация 			= ДокументОбъект.Организация;
			ПозицияОплаты.Контрагент 			= Контрагент;
			ПозицияОплаты.ДоговорКонтрагента 	= ДоговорКонтрагента;
			ПозицияОплаты.Проведен 				= Истина;
			ПозицияОплаты.ВидОперацииУХ 		= ВидОперацииУХ;  
					
			ПозицияОплаты.Записать();
			
			// ДвиженияБюджетированияПоПозициям			
			РасшифровкаПлатежа = РегистрыСведений.ДвиженияБюджетированияПоПозициям.СоздатьНаборЗаписей();
			РасшифровкаПлатежа.Отбор.ИдентификаторПозиции.Установить(ТекКлючСозданияПозиции.ИдентификаторПозиции);
			
			НоваяЗапись = РасшифровкаПлатежа.Добавить();
			НоваяЗапись.ИдентификаторПозиции 	= ТекКлючСозданияПозиции.ИдентификаторПозиции;
			НоваяЗапись.ЗаявкаНаОперацию 		= ДокументОбъект.Ссылка;
			НоваяЗапись.СтатьяДвиженияДенежныхСредств = АналитикиПланированияБДДС.СтатьяБюджета;
			Для ном = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
				НоваяЗапись["Аналитика" + ном] = АналитикиПланированияБДДС["Аналитика" + ном];
			КонецЦикла;
				
			НоваяЗапись.ЭлементСтруктурыЗадолженности = ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг");				
			
			НоваяЗапись.ОбъектРасчетов 			= ОбъектРасчетов;
			НоваяЗапись.ЦФО 					= АналитикиПланированияБДДС.ЦФО;
			НоваяЗапись.Проект 					= АналитикиПланированияБДДС.Проект;
			НоваяЗапись.ДоговорКонтрагента 		= ДоговорКонтрагента;
			НоваяЗапись.ВалютаВзаиморасчетов 	= ДокументОбъект.Валюта;
			НоваяЗапись.Сумма 					= СуммаПозицииГрафика;
			НоваяЗапись.СуммаВзаиморасчетов		= СуммаПозицииГрафика;
			НоваяЗапись.СтавкаНДС 				= СтавкаНДСПоДоговору;   
			НоваяЗапись.КурсПлатежа 			= 1;
			НоваяЗапись.КратностьПлатежа 		= 1;
				
			ОперативноеПланированиеФормыУХКлиентСервер.ПересчитатьСуммуНДС(НоваяЗапись);
					
			РасшифровкаПлатежа.Записать();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение;
		КонецПопытки;
			
	КонецЦикла;   
	
	РаботаСДоговорамиКонтрагентовУХ.ПроверитьПравилаЗапретаОперацийДоговоры(ДокументОбъект.Ссылка, НовыеИдентификаторы);
  
КонецПроцедуры

Функция ПолучитьАналитикиПланированияБДДС(ДокументОбъект)
	
	СтруктураПоиска = Новый Структура("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	Строки = ДокументОбъект.АналитикиПланирования.НайтиСтроки(СтруктураПоиска);
	Если Строки.Количество() > 0 Тогда
		Возврат Строки[0];
	КонецЕсли;
	
	Возврат Неопределено;   
	
		
КонецФункции

#КонецОбласти
