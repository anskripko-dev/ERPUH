
#Область СлужебныйПрограммныйИнтерфейс

// Имя реквизита формы, в котором хранятся результаты интерактивного контроля
//Функция ИмяРеквизитаТаблицаКонтроляДокумента() Экспорт
Функция ИменаРеквизитовЭлементовКонтроля() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяРеквизита", "КонтрольДокумента");
	Результат.Вставить("ИмяСтраницы", "СтраницаКонтроляДокумента");
	Результат.Вставить("ЕстьНарушения", "ЕстьПревышениеЛимитов");
	Результат.Вставить("ИмяКоманды", "ВыполнитьКонтрольДокумента");
	
	Возврат Результат; 
	
КонецФункции

Функция ИмяРеквизитаФормы_ДополнительныеПараметрыКонтроля() Экспорт
	Возврат "ДополнительныеПараметрыКонтроля";
КонецФункции

Функция КартинкаСтраницыКонтроль(ЕстьПревышениеЛимитов, ЕстьПредупреждения = Ложь, ЕстьИнформация = Ложь) Экспорт
	
	Если ЕстьПревышениеЛимитов Тогда
		Возврат БиблиотекаКартинок.СообщениеОПроблемах;
	ИначеЕсли ЕстьПредупреждения Тогда
		Возврат БиблиотекаКартинок.Предупреждение;
	ИначеЕсли ЕстьИнформация Тогда
		Возврат БиблиотекаКартинок.Информация;
	Иначе
		Возврат Новый Картинка;
	КонецЕсли;
	
КонецФункции

Процедура ОтразитьРезультатыКонтроляНаФорме(Форма, РеквизитыЭлементы, ПараметрыКонтроля) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	РезультатКонтроляВОбъекте = ПараметрыКонтроля.РеквизитыКонтроляВДокументе.Найти(ТипЗнч(Объект.Ссылка)) <> неопределено;
	Если РезультатКонтроляВОбъекте Тогда
		// Обновляем реквизиты документа
		Если ПараметрыКонтроля.Свойство("РеквизитыДокумента") Тогда
			ЗаполнитьЗначенияСвойств(Объект, ПараметрыКонтроля.РеквизитыДокумента);
		КонецЕсли;
		ЕстьНарушения = Объект[РеквизитыЭлементы.ЕстьНарушения];
	Иначе
		// Обновляем реквизиты формы
		Форма.ЕстьНарушения = ПараметрыКонтроля.РеквизитыДокумента.ЕстьПревышениеЛимитов;
		ЕстьНарушения = Форма.ЕстьНарушения;
	КонецЕсли;
	
	// Оформление страницы контроля
	Элементы[РеквизитыЭлементы.ИмяСтраницы].Картинка = КартинкаСтраницыКонтроль(
		ЕстьНарушения, Форма.ЕстьПредупреждения,	Форма.ЕстьИнформация);
	
КонецПроцедуры

// Приводит режим контроля резерва в соответствие с контролем лимита бюджета
//
// Параметры:
//  КонтрольЛимита  - ПеречислениеСсылка.РежимыКонтроляДокументов - Редим контроля лимита бюджета
//  КонтрольРезерва  - ПеречислениеСсылка.РежимыКонтроляДокументов - Режим контроля резерва
//
Процедура ПриИзмененииКонтроляЛимитов(КонтрольЛимита, КонтрольРезерва) экспорт
	
	ПустойКонтроль = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка");
	НеКонтролировать = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.НеКонтролировать");
	
	Если КонтрольЛимита = НеКонтролировать Тогда
		КонтрольРезерва = НеКонтролировать;
	ИначеЕсли КонтрольЛимита = ПустойКонтроль Тогда
		КонтрольРезерва = ПустойКонтроль;
	ИначеЕсли ЗначениеЗаполнено(КонтрольЛимита) И НЕ ЗначениеЗаполнено(КонтрольРезерва) Тогда
		КонтрольРезерва = КонтрольЛимита;
	КонецЕсли;
	
КонецПроцедуры

// Приводит режим контроля лимита бюджета в соответствие с контролем резерва
//
// Параметры:
//  КонтрольЛимита  - ПеречислениеСсылка.РежимыКонтроляДокументов - Редим контроля лимита бюджета
//  КонтрольРезерва  - ПеречислениеСсылка.РежимыКонтроляДокументов - Режим контроля резерва
//
Процедура ПриИзмененииКонтроляРезервов(КонтрольЛимита, КонтрольРезерва) экспорт
	
	ПустойКонтроль = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка");
	Если КонтрольЛимита <> ПустойКонтроль И КонтрольРезерва = ПустойКонтроль Тогда
		КонтрольЛимита = ПустойКонтроль;
	КонецЕсли;
	Если КонтрольЛимита = ПустойКонтроль И КонтрольРезерва <> ПустойКонтроль Тогда
		КонтрольЛимита = КонтрольРезерва;
	КонецЕсли;  
	
КонецПроцедуры

// Процедура - Выполняет интерактивный контроль документа
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения	- Форма проверяемого документа
//
Процедура ВыполнитьИнтерактивныйКонтроль(Форма, ПланыДокумента = неопределено) Экспорт
	
	Объект = Форма.Объект;
	РеквизитыЭлементы = ИменаРеквизитовЭлементовКонтроля();
	
	ПараметрыКонтроля = ПолучитьПараметрыДляИнтерактивногоКонтроля(Форма);
	
	Если ПланыДокумента <> неопределено Тогда
		ПараметрыКонтроля.Вставить("ПланыДокумента", ПланыДокумента);
	КонецЕсли;
	
	КонтрольУХВызовСервера.ВыполнитьИнтерактивныйКонтроль(Объект, ПараметрыКонтроля);
	
	#Если Клиент Тогда  
		Если Не Форма[РеквизитыЭлементы.ИмяРеквизита] = ПараметрыКонтроля.Результат Тогда
			Таблица = Форма[РеквизитыЭлементы.ИмяРеквизита];
			Таблица.Очистить();
			Для Каждого Строка Из ПараметрыКонтроля.Результат Цикл
				ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка);
			КонецЦикла;  
		КонецЕсли;
	#КонецЕсли	
	
	#Если НЕ ВнешнееСоединение Тогда
	Если ПараметрыКонтроля.Свойство("Оповестить") Тогда
		
		Для Каждого КлючЗначение Из ПараметрыКонтроля.Оповестить Цикл
			ПараметрОповещения = Новый Структура;
			ПараметрОповещения.Вставить("Значение", КлючЗначение.Значение);
			ПараметрОповещения.Вставить("УИДФормы", ПараметрыКонтроля.УИДФормы);
			
			#Если Клиент Тогда
			Оповестить(КлючЗначение.Ключ,  ПараметрОповещения);
			#Иначе
			// Todo++
			//Форма.ОбработкаОповещенияНаСервере(КлючЗначение.Ключ,  ПараметрОповещения);
			// todo--
			#КонецЕсли	
		КонецЦикла;
	КонецЕсли;
	#КонецЕсли	
	
	ОтразитьРезультатыКонтроляНаФорме(Форма, РеквизитыЭлементы, ПараметрыКонтроля);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
Функция ПолучитьПараметрыДляИнтерактивногоКонтроля(Форма)
	
	РеквизитыЭлементы = ИменаРеквизитовЭлементовКонтроля();
	
	ПараметрыКонтроля = Новый Структура;
	ПараметрыКонтроля.Вставить("УИДФормы",	Форма.УникальныйИдентификатор);
	ПараметрыКонтроля.Вставить("Результат", Форма[РеквизитыЭлементы.ИмяРеквизита]);
	
	// Дополнительные реквизиты согласования из формы документа
	ИмяРеквизита = ИмяРеквизитаФормы_ДополнительныеПараметрыКонтроля();
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизита) Тогда
		
		СтруктураРеквизитовФормы = Форма[ИмяРеквизита];
		Если ТипЗнч(СтруктураРеквизитовФормы) = Тип("ФиксированнаяСтруктура") Тогда
			
			ДопПараметры = Новый Структура;
			
			Для Каждого КлючЗначение Из СтруктураРеквизитовФормы Цикл
				ИмяРеквизитаПараметра = КлючЗначение.Ключ;
				Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаПараметра) Тогда
					Продолжить;
				КонецЕсли;
				
				ДопПараметры.Вставить(ИмяРеквизитаПараметра, Форма[ИмяРеквизитаПараметра]);
				
			КонецЦикла;
			
			Если ДопПараметры.Количество() > 0 Тогда
				ПараметрыКонтроля.Вставить(ИмяРеквизита, ДопПараметры);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПараметрыКонтроля;
	
КонецФункции

#КонецОбласти

