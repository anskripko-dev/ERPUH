	НстрОсновнаяТаблицаПолученияДанныхЗапроса.Комментарий  		= Нстр("ru = 'Запрос получения  ключевых срезов комментариев показателей'");
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.УидГруппыОтборов  = УИДГруппы;

	НстрОсновнаяТаблицаПолученияДанныхЗапроса.ПараметрыПодзапроса  = ТекущиеПараметрыЗапроса;
	
КонецПроцедуры	

Функция ПолучитьОтборПоСпискуВерсий(ТекущиеПараметрыЗапроса,СписокВерсий)
	
	ТекстОтбораПоАналитикеВерсии = "";
		                                      
	Если Не СписокВерсий = Неопределено Тогда
		Если   ТипЗнч(СписокВерсий) = Тип("СписокЗначений") Тогда //отбор по описанию версий
			ТекстОтбораПоАналитикеВерсии = ТекстОтбораПоАналитикеВерсии+"
			|	ВерсииЗначенийПоказателей.Владелец.Ссылка В (&СписокВерсий) И ВерсииЗначенийПоказателей.Валюта = &Валюта";
		ИначеЕсли  ТипЗнч(СписокВерсий) = Тип("Массив") Тогда  // отбор по списку
			ТекстОтбораПоАналитикеВерсии = ТекстОтбораПоАналитикеВерсии+"
			|	ВерсииЗначенийПоказателей.Ссылка В (&СписокВерсий)";
		КонецЕсли;	
	КонецЕсли;	
	
	Нотбор = ТекущиеПараметрыЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "СписокВерсий";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.Равно;
	Нотбор.ЗначениеОтбора	= СписокВерсий;

	
	Возврат ТекстОтбораПоАналитикеВерсии;
	
КонецФункции

Функция ПолучитьОтборПоВидамАналитикиВерсии(глСтруктураПараметров,ТекущиеПараметрыЗапроса)
	
	ТекстОтбораПоАналитикеВерсии = "";
	
	ТекущийВидОтчета = глСтруктураПараметров.ОбъектАБ.Бланк.Владелец;
	
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ВидАналитики = ТекущийВидОтчета["ВидАналитики" + Инд];
		Если ЗначениеЗаполнено(ВидАналитики) Тогда
			
			ТекстОтбораПоАналитикеВерсии = ТекстОтбораПоАналитикеВерсии+"
			|	И %ИмяТаблицы%.Аналитика"+Инд+" В (&АналитикаВО"+Инд+")";
			
			Нотбор = ТекущиеПараметрыЗапроса.Добавить();
			Нотбор.ИмяОтбора 		= "АналитикаВО"+Инд;
			Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.АналитикаВидаОтчета;
			Нотбор.ЗначениеОтбора	= Инд;
					
		Иначе	
			Прервать;
		КонецЕсли;			
		
	КонецЦикла;	
	
	Возврат ТекстОтбораПоАналитикеВерсии;
	
КонецФункции

Функция СформироватьТекстОтбора(ПрефиксТаблицы,ПрефиксПараметраВход,ТаблицаТекущихОтборов,ТзПараметровЗапроса,ИмяПоля ="",ОператорОбъединения=" И ",ИдентификаторРодителя=0,ИндексироватьПоля=Ложь) Экспорт
	
	ТекстЗапросаПоОтборам = "";
	ИндексПараметра       = 1;
	
	
	Для Каждого СтрокаГруппыОтборов Из ТаблицаТекущихОтборов Цикл
		
		    Если ИндексироватьПоля Тогда		
				ПрефиксПараметра = ПрефиксПараметраВход+Формат(ИндексПараметра,"ЧГ=0");	
			Иначе			
				ПрефиксПараметра = ПрефиксПараметраВход;			
			КонецЕСли;
			
			ТекстЗапросаПоОтборам = ТекстЗапросаПоОтборам + ?(ТекстЗапросаПоОтборам = "","",Символы.ПС + Символы.Таб)
				+ ПолучитьТекстОтбора(ПрефиксТаблицы,ПрефиксПараметра,СтрокаГруппыОтборов,ТзПараметровЗапроса,ИмяПоля,ОператорОбъединения);					
		
		    ИндексПараметра = ИндексПараметра+1;
		
	КонецЦикла;
	
	Возврат ТекстЗапросаПоОтборам;
	
КонецФункции

Функция ПолучитьТекстОтбора(ПрефиксТаблицыВход,ПрефиксПараметра,СтрокаОтбора="ПериодОтчета",ТзПараметровЗапроса,нИмяПоля="",ОператорОбъединения) Экспорт
	
	Если СтрокаОтбора.ОсновноеПолеКод = "ПериодОтчета" Тогда 
		ТекстОтбора = "И "+ПрефиксТаблицыВход+"."+СтрокаОтбора.ОсновноеПолеКод+" В (&ПериодОтчета_"+ПрефиксПараметра+")";
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "ПериодОтчета_"+ПрефиксПараметра;
		Нотбор.ТипОтбора 		= "ПериодОтчета";
		Нотбор.ЗначениеОтбора	= "ПериодОтчета";	 
		Нотбор.УидГруппыОтбора	= СтрЗаменить(ПрефиксПараметра,"Пар_","");
		Возврат  ТекстОтбора;
	КонецЕсли;
	
	ТекстОтбора 			= "";
	ИмяПоляПуть 			= ?(ЗначениеЗаполнено(нИмяПоля),СтрЗаменить(СтрокаОтбора.ПолеКод,СтрокаОтбора.ОсновноеПолеКод,нИмяПоля),СтрокаОтбора.ПолеКод);
	ИмяПоля					= ?(ЗначениеЗаполнено(нИмяПоля),нИмяПоля,СтрЗаменить(СтрокаОтбора.ПолеКод,".","_"));
	
	Если СтрокаОтбора.ВыразитьТип  Тогда
		ТипыПоля = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьТипСортировкуАналитики(ИмяПоля,СтрокаОтбора.ТипЗначения); 	
		ПозицияПервойТочки  = СтрНайти(ИмяПоляПуть,".");
		Если ПозицияПервойТочки = 0 Тогда
			ИмяПоляПуть     =  ИмяПоляПуть;
			ПрефиксТаблицы  =  ПрефиксТаблицыВход;
		Иначе	
			ПрефиксТаблицы = "ВЫРАЗИТЬ ("+ПрефиксТаблицыВход;
			ИмяПоляДоТочки      = Лев(ИмяПоляПуть,ПозицияПервойТочки-1);
			ИмяПоляПослеТочки   = Прав(ИмяПоляПуть,СтрДлина(ИмяПоляПуть)-ПозицияПервойТочки);
			ИмяПоляПуть   = ИмяПоляДоТочки+" КАК "+СтрЗаменить(ТипыПоля.МассивТиповСтрока[0],"Ссылка","")+")."+ИмяПоляПослеТочки;
		КонецЕсли;
	Иначе	
		ПрефиксТаблицы  =  ПрефиксТаблицыВход;
		ИмяПоляПуть     =  ИмяПоляПуть;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаОтбора.ВидСравнения) = Тип("ВидСравненияКомпоновкиДанных") Тогда
		Отбор   = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьОтборПоказателяПоОтборуСКД(СтрокаОтбора.ВидСравнения);
	Иначе	
		Отбор	= СтрокаОтбора.ВидСравнения;
	КонецЕсли;
	
	ЗначениеОтбора 			= СтрокаОтбора.ЗначениеОтбора;
	
	Если Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.Равно Тогда 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" = &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеОтбора;	 
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НеРавно Тогда
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" <> &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;	 
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.СценарийОтчета 
		ИЛИ Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ОрганизацияОтчета
		ИЛИ Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПроектОтчета Тогда
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоля+" В (&"+СтрокаОтбора.ПолеКод+")";
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= СтрокаОтбора.ПолеКод;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= СтрокаОтбора.ПолеКод;	 	 	 	
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке Тогда	 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" В (&Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеОтбора;	 		
		
		Если СтрокаОтбора.ТипЗначения = Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ") И ЗначениеЗаполнено(Нотбор.ЗначениеОтбора[0].Значение) Тогда 
			тВладелец =  Нотбор.ЗначениеОтбора[0].Значение.Владелец;
			ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+".Владелец = &Пар_Владелец"+ПрефиксПараметра+"_"+ИмяПоля+"";
			Нотбор = ТзПараметровЗапроса.Добавить();
			Нотбор.ИмяОтбора 		= "Пар_Владелец"+ПрефиксПараметра+"_"+ИмяПоля;
			Нотбор.ТипОтбора 		= Отбор;
			Нотбор.ЗначениеОтбора	= тВладелец;	
		КонецЕсли;

		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НеВСписке Тогда	 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" НЕ В (&Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеОтбора;			
		
		Если СтрокаОтбора.ТипЗначения = Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ") И ЗначениеЗаполнено(Нотбор.ЗначениеОтбора[0].Значение) Тогда 
			тВладелец =  Нотбор.ЗначениеОтбора[0].Значение.Владелец;
			ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+".Владелец = &Пар_Владелец"+ПрефиксПараметра+"_"+ИмяПоля+"";
			Нотбор = ТзПараметровЗапроса.Добавить();
			Нотбор.ИмяОтбора 		= "Пар_Владелец"+ПрефиксПараметра+"_"+ИмяПоля;
			Нотбор.ТипОтбора 		= Отбор;
			Нотбор.ЗначениеОтбора	= тВладелец;	
		КонецЕсли;
				
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ВИерархии  Тогда	 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+"  В ИЕРАРХИИ(&Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		Если  ПоддерживаетИерархиюГрупп(СтрокаОтбора.ТипЗначения) Тогда
		    ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоляПуть+".ЭтоГруппа = ЛОЖЬ";
		Иначе 
			//ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+" <> &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		КонецЕсли;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеОтбора;		
		
	ИначеЕсли Отбор  = Перечисления.ВидыСравненияПоказателейОтчетов.ВСпискеПоИерархии Тогда
		
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+"  В ИЕРАРХИИ(&Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		Если  ПоддерживаетИерархиюГрупп(СтрокаОтбора.ТипЗначения) Тогда
			ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+".ЭтоГруппа = ЛОЖЬ";
		Иначе 
			//ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+" НЕ В( &Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		КонецЕсли;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеОтбора;	
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НеВИерархии  Тогда	 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+"  НЕ В ИЕРАРХИИ(&Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		Если  ПоддерживаетИерархиюГрупп(СтрокаОтбора.ТипЗначения) Тогда
		    ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+".ЭтоГруппа = ЛОЖЬ";
		Иначе 
			//ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+" <> &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		КонецЕсли;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеОтбора;		
		
	ИначеЕсли Отбор  = Перечисления.ВидыСравненияПоказателейОтчетов.НеВСпискеПоИерархии Тогда
		
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+"  НЕ В ИЕРАРХИИ(&Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		Если  ПоддерживаетИерархиюГрупп(СтрокаОтбора.ТипЗначения) Тогда
		    ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+".ЭтоГруппа = ЛОЖЬ";
		Иначе 
			//ТекстОтбора = ТекстОтбора+" И "+ПрефиксТаблицы+"."+ИмяПоля+" НЕ В( &Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		КонецЕсли;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеОтбора;		
			
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ОтборНеПроизводится Тогда
		ТекстОтбора = "";
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.Заполнено Тогда
		
		СписокПустыхЗначений = Новый СписокЗначений();
		СписокПустыхЗначений.Добавить(Неопределено);
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаОтбора, "ТипЗначения") тогда
			СписокПустыхЗначений.Добавить(СтрокаОтбора.ТипЗначения.ПривестиЗначение());
		КонецЕсли;
		
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" НЕ В (&Пар_"+ПрефиксПараметра+"_"+ИмяПоля+")";
		Нотбор = ТзПараметровЗапроса.Добавить();
