		 ИначеЕсли СтрПолеЗначение.ПоказательТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда	 
			 СтрокаПолейЗапроса 	= СтрокаПолейЗапроса +"
