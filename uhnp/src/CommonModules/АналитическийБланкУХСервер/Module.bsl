Функция ЕстьПолеСКД(Коллекция,КодПоля)
	
	Для Каждого Поле Из Коллекция Цикл	
		Если Строка(Поле.Поле) = КодПоля Тогда
			 Возврат Истина;
		КонецЕсли;			
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции	

Функция ЭтоСоставнойТип(ТзАналитик,КодАналитики)
	
	тАналиткаРасшифровка = ТзАналитик.Найти(КодАналитики,"АналитикаКод");
	
	Если СтрНайти(тАналиткаРасшифровка.АналитикаТипСтрока,"|")>0 Тогда
		 Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции	

Функция ПроверитьНаличиеПоляВыбора(ПоляВыбора,ПолеСКД)
	
	Для Каждого ПолеВыбора Из ПоляВыбора Цикл
		Если ПолеВыбора.Поле = ПолеСКД Тогда		
			Возврат Истина;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции	

Функция ВернутьИмяПоляДоТочки(ИмяПоля)
		
	ПозицияПервойТочки  = СтрНайти(ИмяПоля,".");
	Если ПозицияПервойТочки = 0 Тогда
		ИмяПоляДоТочки     =  ИмяПоля;
	Иначе	
		ИмяПоляДоТочки      = Лев(ИмяПоля,ПозицияПервойТочки-1);
	КонецЕсли;
	
	Возврат  ИмяПоляДоТочки;
	
