			 СтрокаПолейЗапросаИтог 	= СтрокаПолейЗапросаИтог +"
			 |	МАКСИМУМ("+СтрПолеКлюч+") ,";		 
		 ИначеЕсли НЕ СтрПолеЗначение.ПоказательТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
