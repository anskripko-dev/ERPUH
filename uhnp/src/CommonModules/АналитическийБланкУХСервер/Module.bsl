	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.Больше Тогда 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" > &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.БольшеИлиРавно Тогда 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" >= &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.Меньше Тогда 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" < &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.МеньшеИлиРавно Тогда 
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" <= &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.Содержит Тогда
		
		ЗначениеОтбора = СтрЗаменить(ЗначениеОтбора, """", "");
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" ПОДОБНО ""%"+ЗначениеОтбора+"%""";
		
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НеСодержит Тогда
		
		ЗначениеОтбора = СтрЗаменить(ЗначениеОтбора, """", "");
		ТекстОтбора = "И НЕ "+ПрефиксТаблицы+"."+ИмяПоляПуть+" ПОДОБНО ""%"+ЗначениеОтбора+"%""";
		
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НачинаетсяС Тогда
		
		ЗначениеОтбора = СтрЗаменить(ЗначениеОтбора, """", "");
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" ПОДОБНО """+ЗначениеОтбора+"%""";
		
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НеНачинаетсяС Тогда
		
		ЗначениеОтбора = СтрЗаменить(ЗначениеОтбора, """", "");
		ТекстОтбора = "И НЕ "+ПрефиксТаблицы+"."+ИмяПоляПуть+" ПОДОБНО """+ЗначениеОтбора+"%""";
		
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.Подобно Тогда
		
		ЗначениеОтбора = СтрЗаменить(ЗначениеОтбора, """", "");
		ТекстОтбора = "И "+ПрефиксТаблицы+"."+ИмяПоляПуть+" ПОДОБНО """+ЗначениеОтбора+"""";
		
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
		
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НеПодобно Тогда
		
		ЗначениеОтбора = СтрЗаменить(ЗначениеОтбора, """", "");
		ТекстОтбора = "И НЕ "+ПрефиксТаблицы+"."+ИмяПоляПуть+" ПОДОБНО """+ЗначениеОтбора+"""";
		
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	= ЗначениеОтбора;
			
	КонецЕсли;
	
	Если СтрокаОтбора.ВыразитьТип Тогда
		
	КонецЕсли;
	
	Возврат  ТекстОтбора;
	
КонецФункции	

Процедура ПолучитьТекстЗначенийПоказателей(ТекстШаблонаЗапроса,УИДГруппы,ИндексРегистра,ТзПараметровЗапроса,глТзАналитик,ГруппаПоказателей=Неопределено,ИндексЗапроса,ОбъектАБ,МаксИспользуемыхАналитик,ТаблицаТекущихОтборов,ВключатьЗапросДанныхИзЛога=Истина,глСтруктураПараметров)
		
	ТекстДополнительногоОтбора = "";
	Если Не ГруппаПоказателей = Неопределено Тогда
		
		АналитикаДоВалютаКод = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникВалюты.Код;
		Для Каждого РасшифровкаАналитки Из глТзАналитик Цикл
			
			ИндексАналитики = Неопределено;	
			Если НЕ ГруппаПоказателей.Владелец().Колонки.Найти("ВидАналитики_"+РасшифровкаАналитки.АналитикаКод) = Неопределено Тогда	
				ИндексАналитики = ГруппаПоказателей["ВидАналитики_"+РасшифровкаАналитки.АналитикаКод];
			КонецЕсли;
			Если РасшифровкаАналитки.АналитикаКод = АналитикаДоВалютаКод Тогда	
				Если ЗначениеЗаполнено(ГруппаПоказателей.АналитикаВалюта) Тогда
					ИндексАналитики = "Валюта";
				Иначе
					ИндексАналитики = 0;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ИндексАналитики = 0 Тогда
				
				ПрефиксПараметра = УИДГруппы+"_ИндексЗапроса_"+Формат(ИндексЗапроса,"ЧГ=0");
				
				ОтборыТекущейАналитикиПоМакету	 = ОбъектАБ.РасшифровкаГруппОтборов.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод",УИДГруппы,РасшифровкаАналитки.АналитикаКод));
				ОтборыТекущейАналитикиПоОтборам  = ТаблицаТекущихОтборов.НайтиСтроки(Новый Структура("ОсновноеПолеКод,Использовать",РасшифровкаАналитки.АналитикаКод,Истина));

				ФинальныеОтборыТекущейАналитики = ТаблицаТекущихОтборов.СкопироватьКолонки();
				
				Если ОтборыТекущейАналитикиПоМакету.Количество() > 0 
					И ОтборыТекущейАналитикиПоОтборам.Количество() = 0 Тогда    // Отбор только по макету - добавляем его в финальный отбор
					
					НстрОтбора  						= ФинальныеОтборыТекущейАналитики.Добавить();
					НстрОтбора.ПолеКод 					= ОтборыТекущейАналитикиПоМакету[0].ПолеКод;
					НстрОтбора.ОсновноеПолеКод 			= ОтборыТекущейАналитикиПоМакету[0].ПолеКод;
					НстрОтбора.ПолеПредставление 		= ОтборыТекущейАналитикиПоМакету[0].Поле;
                    НстрОтбора.ВидСравнения		 		= ОтборыТекущейАналитикиПоМакету[0].Отбор;
					Если ЗначениеЗАполнено(ОтборыТекущейАналитикиПоМакету[0].ЗначениеОтбораСтрока) Тогда 
					НстрОтбора.ЗначениеОтбора 			= ЗначениеИзСтрокиВнутр(ОтборыТекущейАналитикиПоМакету[0].ЗначениеОтбораСтрока);
					КонецЕсли;
					МассивТиповСтрока 					=   СтрРазделить(ОтборыТекущейАналитикиПоМакету[0].ТипЗначенияСтрока,"|");
					МассивТипов   						=   Новый Массив;
					Для Каждого СтрТип Из МассивТиповСтрока Цикл
						МассивТипов.Добавить(Тип(СтрТип));
					КонецЦикла;		
					НстрОтбора.ТипЗначения 				= Новый ОписаниеТипов(МассивТипов);
					
				ИначеЕсли ОтборыТекущейАналитикиПоМакету.Количество()= 0 
					И ОтборыТекущейАналитикиПоОтборам.Количество()>0  Тогда    //Отбор только по текущим значениям - добавляем его в финальный отбор
					
					Для Каждого СтрОтбор Из ОтборыТекущейАналитикиПоОтборам Цикл
						НстрОтбора  						= ФинальныеОтборыТекущейАналитики.Добавить();
						ЗаполнитьЗначенияСвойств(НстрОтбора,СтрОтбор);
					КонецЦикла;	
					
				ИначеЕсли ОтборыТекущейАналитикиПоМакету.Количество()> 0 
					И ОтборыТекущейАналитикиПоОтборам.Количество()>0  Тогда    //Отбор макета пересекается с отбором по текущим значениям...
					
					Для Каждого СтрОтбор Из ОтборыТекущейАналитикиПоОтборам Цикл
						Если  СтрОтбор.РежимОтбора = Перечисления.РежимыОтборовАналитическихТаблиц.Макет Тогда
							НстрОтбора  						= ФинальныеОтборыТекущейАналитики.Добавить();
							ЗаполнитьЗначенияСвойств(НстрОтбора,СтрОтбор);
						Иначе	
							тОтборАналитикиПоМакету = ОтборыТекущейАналитикиПоМакету[0];
							Если ОтборыТекущейАналитикиПоМакету[0].Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ОтборНеПроизводится Тогда
								НстрОтбора  						= ФинальныеОтборыТекущейАналитики.Добавить();
								ЗаполнитьЗначенияСвойств(НстрОтбора,СтрОтбор);	
							Иначе	
								НстрОтбора  						= ФинальныеОтборыТекущейАналитики.Добавить();
								НстрОтбора.ПолеКод 					= ОтборыТекущейАналитикиПоМакету[0].ПолеКод;
								НстрОтбора.ОсновноеПолеКод 			= ОтборыТекущейАналитикиПоМакету[0].ПолеКод;
								НстрОтбора.ПолеПредставление 		= ОтборыТекущейАналитикиПоМакету[0].Поле;
								НстрОтбора.ВидСравнения		 		= ОтборыТекущейАналитикиПоМакету[0].Отбор;
								НстрОтбора.ЗначениеОтбора 			= ЗначениеИзСтрокиВнутр(ОтборыТекущейАналитикиПоМакету[0].ЗначениеОтбораСтрока);
								
								МассивТиповСтрока 					=   СтрРазделить(ОтборыТекущейАналитикиПоМакету[0].ТипЗначенияСтрока,"|");
								МассивТипов   						=   Новый Массив;
								Для Каждого СтрТип Из МассивТиповСтрока Цикл
									МассивТипов.Добавить(Тип(СтрТип));
								КонецЦикла;		
								НстрОтбора.ТипЗначения 				= Новый ОписаниеТипов(МассивТипов);
								
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
						
				КонецЕсли;
				
				Если ФинальныеОтборыТекущейАналитики.Количество()> 0 Тогда
					
					СтрокаУсловий = СформироватьТекстОтбора("ЗначенияПоказателей",ПрефиксПараметра,ФинальныеОтборыТекущейАналитики,ТзПараметровЗапроса,"Аналитика"+ИндексАналитики);
					// Если отбор установлен на реквизит аналитики, выразим тип аналитики
					Для Каждого СтрПолеОтбор Из ФинальныеОтборыТекущейАналитики Цикл
						Если СтрНайти(СтрПолеОтбор.ПолеКод,".")>0 Тогда							
							РеквизитПоля  = СтрЗаменить(СтрПолеОтбор.ПолеКод,СтрПолеОтбор.ОсновноеПолеКод,"");
							ТекСубконто   = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(СтрПолеОтбор.ОсновноеПолеКод); 
							Если Не ТекСубконто = Неопределено Тогда
								ТипАналитики  = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьТипСортировкуАналитики(СтрПолеОтбор.ОсновноеПолеКод,ТекСубконто.ТипЗначения);
								ТипАналитикиВЗапоросе = СтрЗаменить(ТипАналитики.ТипСтрока,"Ссылка","");
								Если СтрНайти(ТипАналитикиВЗапоросе,"|")=0 Тогда	
									// Составной тип не выражаем			
									СтрокаУсловий = СтрЗаменить(СтрокаУсловий,"ЗначенияПоказателей.Аналитика"+ИндексАналитики+РеквизитПоля,
									"ВЫРАЗИТЬ("+"ЗначенияПоказателей.Аналитика"+ИндексАналитики+" КАК "+ТипАналитикиВЗапоросе+")"+РеквизитПоля);
								КонецЕсли
							КонецЕсли;	
						КонецЕсли;	
					КонецЦикла;	
					
					ТекстДополнительногоОтбора = ТекстДополнительногоОтбора+" "+СтрокаУсловий;
					
				КонецЕсли;
				
			Иначе
				
				// Аналитики такой нет, а отбор есть. - данные не должны попасть в итог.
				ОтборыТекущейАналитикиПоОтборам  = ТаблицаТекущихОтборов.НайтиСтроки(Новый Структура("ОсновноеПолеКод,Использовать",РасшифровкаАналитки.АналитикаКод,Истина));
				Если ОтборыТекущейАналитикиПоОтборам.Количество()>0 Тогда
					ТекстДополнительногоОтбора = ТекстДополнительногоОтбора+" И ЛОЖЬ ";	
				КонецЕсли;	
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстШаблонаЗапроса) Тогда
		ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|";
		ТекстПоместить = "";
	Иначе
		ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
			|
			|// ПОЛУЧАЕМ ДАННЫЕ ВО ВРЕМЕННУЮ ТАБЛИЦУ";
		ТекстПоместить = "ПОМЕСТИТЬ мПоказателиРаскрытияВрем";
	КонецЕсли;	
	
	Если ИндексРегистра = -1 Или ИндексРегистра = -11 Тогда	

		ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
			|ВЫБРАТЬ
			|	""УИДГруппыШаблон"" КАК УидГруппыОтборов,
			|	Показатели.ИмяОбластиДляВывода+""УИДГруппыШаблон"" КАК ИмяОбластиДляВывода,
			|	Показатели.ПоказательКод КАК ПоказательКод,
			|	ЗначенияПоказателей.Сценарий,
			|	ЗначенияПоказателей.Организация,
			|	ЗначенияПоказателей.ПериодОтчета,
			|	ЗначенияПоказателей.Валюта,
			|	ЗначенияПоказателей.Проект,
			|	ЗначенияПоказателей.Показатель,	
			|	ЗначенияПоказателей.Аналитика1,
			|	ЗначенияПоказателей.Аналитика2,
			|	ЗначенияПоказателей.Аналитика3,
			|	ЗначенияПоказателей.Аналитика4,
			|	ЗначенияПоказателей.Аналитика5,
			|	ЗначенияПоказателей.Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта,
			|	0 КАК ЗначениеВалюта,
			|	-1 КАК Значение,
			|	ЗначенияПоказателей.ЗначениеНечисловое КАК ЗначениеНеЧисло
			|"+ТекстПоместить+"
			|ИЗ
			|	втЗначенияНечисловых_"+УИДГруппы+" КАК ЗначенияПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныйНомерТранзакцииНечисловых_"+УИДГруппы+" КАК МаксимальныйНомерТранзакции
			|			ПО ЗначенияПоказателей.НомерТранзакции 	= МаксимальныйНомерТранзакции.НомерТранзакции
			|			И ЗначенияПоказателей.Сценарий 			= МаксимальныйНомерТранзакции.Сценарий
			|			И ЗначенияПоказателей.Организация 		= МаксимальныйНомерТранзакции.Организация
			|			И ЗначенияПоказателей.ПериодОтчета 		= МаксимальныйНомерТранзакции.ПериодОтчета
			|			И ЗначенияПоказателей.Валюта	 		= МаксимальныйНомерТранзакции.Валюта
			|			И ЗначенияПоказателей.Проект 			= МаксимальныйНомерТранзакции.Проект
			|			И ЗначенияПоказателей.Показатель 		= МаксимальныйНомерТранзакции.Показатель
			|			И ЗначенияПоказателей.Аналитика1 		= МаксимальныйНомерТранзакции.Аналитика1
			|			И ЗначенияПоказателей.Аналитика2 		= МаксимальныйНомерТранзакции.Аналитика2
			|			И ЗначенияПоказателей.Аналитика3 		= МаксимальныйНомерТранзакции.Аналитика3
			|			И ЗначенияПоказателей.Аналитика4 		= МаксимальныйНомерТранзакции.Аналитика4
			|			И ЗначенияПоказателей.Аналитика5 		= МаксимальныйНомерТранзакции.Аналитика5
			|			И ЗначенияПоказателей.Аналитика6 		= МаксимальныйНомерТранзакции.Аналитика6
			|			И ЗначенияПоказателей.АналитикаВалюта = МаксимальныйНомерТранзакции.АналитикаВалюта
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ тзПоказатели КАК Показатели
			|			ПО Показатели.Показатель = ЗначенияПоказателей.Показатель
			|
			|ГДЕ
			|	ЗначенияПоказателей.ЗначениеНечисловое <> НЕОПРЕДЕЛЕНО
			|	И ЗначенияПоказателей.Показатель В (&ОтборПоказателей_"+УИДГруппы+"_ИндексЗапроса_"+Формат(ИндексЗапроса,"ЧГ=0")+")
			|	"+ТекстДополнительногоОтбора;
			
	Иначе
		
		ТекстДополнительныхПолей = "";
		Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл	
			Если ИндексРегистра >= Инд Тогда
				ТекстДополнительныхПолей = ТекстДополнительныхПолей + "ЗначенияПоказателей.Аналитика"+Инд+" КАК Аналитика"+Инд+",
				|	";
			Иначе	
				ТекстДополнительныхПолей = ТекстДополнительныхПолей + "NULL КАК Аналитика"+Инд+",
				|	";
			КонецЕсли;
		КонецЦикла;
		ТекстДополнительныхПолей = СокрЛП(ТекстДополнительныхПолей);
		
		ТекстАналитикаЗначениеВалюта = "ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
			|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта,";
		Если ИндексРегистра = 0 ИЛИ ИндексРегистра = NULL Тогда
			ИмяРегистра = "Синтетика";
			ТекстАналитикаЗначениеВалюта = "ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта,
			|	0 КАК ЗначениеВалюта,";
		ИначеЕсли ИндексРегистра = -2 Тогда
			ИмяРегистра = "Валютные";
		Иначе
			ИмяРегистра = ИндексРегистра;	
		КонецЕсли;
		
		ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
			|ВЫБРАТЬ
			|	ВерсииБаза.УидГруппыОтборов КАК УидГруппыОтборов,
			|	Показатели.ИмяОбластиДляВывода + ВерсииБаза.УидГруппыОтборов КАК ИмяОбластиДляВывода,
			|	Показатели.ПоказательКод КАК ПоказательКод,
			|	ВерсииБаза.Сценарий,
			|	ВерсииБаза.Организация,
			|	ВерсииБаза.ПериодОтчета,
			|	ВерсииБаза.Валюта,
			|	ВерсииБаза.Проект,
			|	ЗначенияПоказателей.Показатель,
			|	"+ТекстДополнительныхПолей+"
			|	"+ТекстАналитикаЗначениеВалюта+"
			|	ЗначенияПоказателей.Значение КАК Значение,
			|	ЛОЖЬ КАК ЗначениеНеЧисло
			|"+ТекстПоместить+"
			|ИЗ
			|	РегистрСведений.ЗначенияПоказателейОтчетов"+ИмяРегистра+" КАК ЗначенияПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВерсииБаза_"+УИДГруппы+" КАК ВерсииБаза
			|			ПО ВерсииБаза.Версия = ЗначенияПоказателей.Версия
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ тзПоказатели КАК Показатели
			|			ПО Показатели.Показатель = ЗначенияПоказателей.Показатель
			|
			|ГДЕ
			|	ЗначенияПоказателей.Показатель В (&ОтборПоказателей_"+УИДГруппы+"_ИндексЗапроса_"+Формат(ИндексЗапроса,"ЧГ=0")+")
			|	И ЗначенияПоказателей.Значение <> 0
			|	"+ТекстДополнительногоОтбора;
		
		Если ВключатьЗапросДанныхИзЛога Тогда
			ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	""УИДГруппыШаблон"" КАК УидГруппыОтборов,
				|	Показатели.ИмяОбластиДляВывода+""УИДГруппыШаблон"" КАК ИмяОбластиДляВывода,
				|	Показатели.ПоказательКод КАК ПоказательКод,
				|	ЗначенияПоказателей.Сценарий КАК Сценарий,
				|	ЗначенияПоказателей.Организация КАК Организация,
				|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
				|	ЗначенияПоказателей.Валюта КАК Валюта,
				|	ЗначенияПоказателей.Проект КАК Проект,
				|	ЗначенияПоказателей.Показатель КАК Показатель,
				|	"+ТекстДополнительныхПолей+"
				|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
				|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта,
				|	ЗначенияПоказателей.Значение КАК Значение,
				|	ЛОЖЬ КАК ЗначениеНеЧисло
				|ИЗ
				|	втЗначенияПоказателей_"+УИДГруппы+" КАК ЗначенияПоказателей
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ тзПоказатели КАК Показатели
				|			ПО Показатели.Показатель = ЗначенияПоказателей.Показатель
				|
				|ГДЕ
				|	ЗначенияПоказателей.Показатель В (&ОтборПоказателей_"+УИДГруппы+"_ИндексЗапроса_"+Формат(ИндексЗапроса,"ЧГ=0")+")
				|	"+ТекстДополнительногоОтбора;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстШаблонаЗапроса  = СтрЗаменить(ТекстШаблонаЗапроса,"УИДГруппыШаблон",УИДГруппы);
	
КонецПроцедуры	

Процедура СоздатьТаблицуЛогаКомментариев(ТекстЗапроса)
	
	// Нечисловые выделим в отдельную таблицу, чтобы получить срез значений по последним транзакциям	
	ТекстЗапроса = "
	|ВЫБРАТЬ 
	|	мДанныеЛога.НомерТранзакции,
	|	мДанныеЛога.Показатель,
	|	мДанныеЛога.Сценарий,
	|	мДанныеЛога.Организация,
	|	мДанныеЛога.Проект,
	|	мДанныеЛога.ПериодОтчета,
	|	мДанныеЛога.Валюта, 
	|	мДанныеЛога.Аналитика1,
	|	мДанныеЛога.Аналитика2,
	|	мДанныеЛога.Аналитика3,
	|	мДанныеЛога.Аналитика4,
	|	мДанныеЛога.Аналитика5,
	|	мДанныеЛога.Аналитика6,
	|	мДанныеЛога.АналитикаВалюта,	
	|	мДанныеЛога.Значение КАК Значение 
	|ПОМЕСТИТЬ втДанныеЛогаКомментарии
	|ИЗ
	|	РегистрСведений.ЛогИзмененныхКомментариевПоказателейОтчетов КАК мДанныеЛога
	|ГДЕ 
	|	мДанныеЛога.УникальныйИдентификаторСеанса = &УникальныйИдентификаторСеанса
	|;
	|/////////////////
	|" + ТекстЗапроса + "	
	|;
	|
	|///////////////// 
	|ВЫБРАТЬ 
	|	МАКСИМУМ(КомментарииВсе.Код) КАК НомерТранзакции,
	|	КомментарииВсе.Показатель,
	|	КомментарииВсе.Сценарий,
	|	КомментарииВсе.Организация,
	|	КомментарииВсе.Проект, 
	|	КомментарииВсе.ПериодОтчета,
	|	КомментарииВсе.Аналитика1,
	|	КомментарииВсе.Аналитика2,
	|	КомментарииВсе.Аналитика3,
	|	КомментарииВсе.Аналитика4,
	|	КомментарииВсе.Аналитика5,
	|	КомментарииВсе.Аналитика6,
	|	КомментарииВсе.АналитикаВалюта	
	|ПОМЕСТИТЬ втДанныеКомментариевПоследние
	|ИЗ
	|	втКомментарииВсе КАК КомментарииВсе
	|
	|СГРУППИРОВАТЬ ПО 
	|	КомментарииВсе.Показатель,
	|	КомментарииВсе.Сценарий,
	|	КомментарииВсе.Организация,
	|	КомментарииВсе.Проект,
	|	КомментарииВсе.ПериодОтчета,
	|	КомментарииВсе.Аналитика1,
	|	КомментарииВсе.Аналитика2,
	|	КомментарииВсе.Аналитика3,
	|	КомментарииВсе.Аналитика4,
	|	КомментарииВсе.Аналитика5,
	|	КомментарииВсе.Аналитика6,
	|	КомментарииВсе.АналитикаВалюта	
	|;
	|
	|/////////////////
	|ВЫБРАТЬ
	|	КомментарииВсе.УидГРуппыОтборов,
	|	КомментарииВсе.Показатель,
	|	КомментарииВсе.Сценарий,
	|	КомментарииВсе.Организация,
	|	КомментарииВсе.Проект, 
	|	КомментарииВсе.ПериодОтчета,
	|	КомментарииВсе.Аналитика1,
	|	КомментарииВсе.Аналитика2,
	|	КомментарииВсе.Аналитика3,
	|	КомментарииВсе.Аналитика4,
	|	КомментарииВсе.Аналитика5,
	|	КомментарииВсе.Аналитика6,
	|	КомментарииВсе.АналитикаВалюта,	
	|	КомментарииВсе.Комментарий
	|ИЗ
	|	втКомментарииВсе КАК КомментарииВсе
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеКомментариевПоследние КАК ДанныеКомментариевПоследние 
	|		ПО КомментарииВсе.Код			 	   = ДанныеКомментариевПоследние.НомерТранзакции
	|			И КомментарииВсе.Показатель        = ДанныеКомментариевПоследние.Показатель
	|			И КомментарииВсе.Сценарий          = ДанныеКомментариевПоследние.Сценарий
	|			И КомментарииВсе.Организация       = ДанныеКомментариевПоследние.Организация
	|			И КомментарииВсе.Проект            = ДанныеКомментариевПоследние.Проект
	|			И КомментарииВсе.ПериодОтчета      = ДанныеКомментариевПоследние.ПериодОтчета
	|			И ISNULL(КомментарииВсе.Аналитика1, НЕОПРЕДЕЛЕНО) = ISNULL(ДанныеКомментариевПоследние.Аналитика1, НЕОПРЕДЕЛЕНО)
	|			И ISNULL(КомментарииВсе.Аналитика2, НЕОПРЕДЕЛЕНО) = ISNULL(ДанныеКомментариевПоследние.Аналитика2, НЕОПРЕДЕЛЕНО)
	|			И ISNULL(КомментарииВсе.Аналитика3, НЕОПРЕДЕЛЕНО) = ISNULL(ДанныеКомментариевПоследние.Аналитика3, НЕОПРЕДЕЛЕНО)
	|			И ISNULL(КомментарииВсе.Аналитика4, НЕОПРЕДЕЛЕНО) = ISNULL(ДанныеКомментариевПоследние.Аналитика4, НЕОПРЕДЕЛЕНО)
	|			И ISNULL(КомментарииВсе.Аналитика5, НЕОПРЕДЕЛЕНО) = ISNULL(ДанныеКомментариевПоследние.Аналитика5, НЕОПРЕДЕЛЕНО)
	|			И ISNULL(КомментарииВсе.Аналитика6, НЕОПРЕДЕЛЕНО) = ISNULL(ДанныеКомментариевПоследние.Аналитика6, НЕОПРЕДЕЛЕНО)
	|			И КомментарииВсе.АналитикаВалюта   = ДанныеКомментариевПоследние.АналитикаВалюта
	|";
	
КонецПроцедуры

Процедура ПолучитьТекстКомментариевЗначенийПоказателей(ТекстШаблонаЗапроса, УИДГруппы, ИндексЗапроса,глСтруктураПараметров)

	Если ЗначениеЗаполнено(ТекстШаблонаЗапроса) Тогда
		
		ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
	    
	КонецЕсли;
	
	ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
		|ВЫБРАТЬ
		|	""УИДГруппыШаблон"" КАК УидГРуппыОтборов,	
		|	ЗначенияПоказателей.Сценарий КАК Сценарий,
		|	ЗначенияПоказателей.Организация КАК Организация,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
		|	ЗначенияПоказателей.Валюта КАК Валюта,
		|	ЗначенияПоказателей.Проект КАК Проект,
		|	ЗначенияПоказателей.Показатель КАК Показатель,	
		|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
		|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
		|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
		|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
		|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
		|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
		|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
		|	ЗначенияПоказателей.Комментарий КАК Комментарий 
		|ИЗ
		|	втЗначенияКомментариев_"+УИДГруппы+" КАК ЗначенияПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныйНомерТранзакцииКомментариев_"+УИДГруппы+" КАК МаксимальныйНомерТранзакции
		|			ПО ЗначенияПоказателей.НомерТранзакции 	= МаксимальныйНомерТранзакции.НомерТранзакции
		|			И ЗначенияПоказателей.Сценарий 			= МаксимальныйНомерТранзакции.Сценарий
		|			И ЗначенияПоказателей.Организация 		= МаксимальныйНомерТранзакции.Организация
		|			И ЗначенияПоказателей.ПериодОтчета 		= МаксимальныйНомерТранзакции.ПериодОтчета
		|			И ЗначенияПоказателей.Валюта	 		= МаксимальныйНомерТранзакции.Валюта
		|			И ЗначенияПоказателей.Проект 			= МаксимальныйНомерТранзакции.Проект
		|			И ЗначенияПоказателей.Показатель 		= МаксимальныйНомерТранзакции.Показатель
		|			И ЗначенияПоказателей.Аналитика1 		= МаксимальныйНомерТранзакции.Аналитика1
		|			И ЗначенияПоказателей.Аналитика2 		= МаксимальныйНомерТранзакции.Аналитика2
		|			И ЗначенияПоказателей.Аналитика3 		= МаксимальныйНомерТранзакции.Аналитика3
		|			И ЗначенияПоказателей.Аналитика4 		= МаксимальныйНомерТранзакции.Аналитика4
		|			И ЗначенияПоказателей.Аналитика5 		= МаксимальныйНомерТранзакции.Аналитика5
		|			И ЗначенияПоказателей.Аналитика6 		= МаксимальныйНомерТранзакции.Аналитика6
		|			И ЗначенияПоказателей.АналитикаВалюта = МаксимальныйНомерТранзакции.АналитикаВалюта
		|
		|ГДЕ
		|	ЗначенияПоказателей.Показатель В (&ОтборПоказателей_"+УИДГруппы+"_ИндексЗапроса_"+Формат(ИндексЗапроса,"ЧГ=0")+")
		|";
	
	    ТекстШаблонаЗапроса = СтрЗаменить(ТекстШаблонаЗапроса,"УИДГруппыШаблон",УИДГруппы);

КонецПроцедуры

Процедура ПодготовитьТекстФинальногоЗапросаДанные(ТекстИтоговогоЗапроса,глСтруктураПараметров)
	
	ТекстАналитики = "";
	Для ИндАналитики = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл	
		ТекстАналитики = ТекстАналитики + "
		|	ПоказателиРаскрытия.Аналитика"+ИндАналитики+",";
	КонецЦикла;
			
	ТекстПодзапроса = "
	|// Подзапрос для получения сгруппированного среза по данным с помещением в ВТ
	|ВЫБРАТЬ
	|	ПоказателиРаскрытия.Показатель КАК Показатель,
	|	ПоказателиРаскрытия.ИмяОбластиДляВывода КАК ИмяОбластиДляВывода,
	|	ПоказателиРаскрытия.УидГруппыОтборов КАК УидГруппыОтборов,
	|	ПоказателиРаскрытия.ПериодОтчета КАК ПериодОтчета,
	|	ПоказателиРаскрытия.Сценарий КАК Сценарий,
	|	ПоказателиРаскрытия.Организация КАК Организация,
	|	ПоказателиРаскрытия.Проект КАК Проект,"+ТекстАналитики+"	
	|	ПоказателиРаскрытия.АналитикаВалюта КАК АналитикаВалюта,
	|	СУММА(ПоказателиРаскрытия.Значение) КАК Значение,
	|	СУММА(ПоказателиРаскрытия.ЗначениеВалюта) КАК ЗначениеВалюта,
	|	МАКСИМУМ(ПоказателиРаскрытия.ЗначениеНеЧисло) КАК ЗначениеНеЧисло,
	|	МАКСИМУМ(ПоказателиРаскрытия.ПоказательКод) КАК ПоказательКод
	|ПОМЕСТИТЬ тмПоказателиРаскрытия
	|ИЗ
	|	мПоказателиРаскрытияВрем КАК ПоказателиРаскрытия
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоказателиРаскрытия.Показатель,
	|	ПоказателиРаскрытия.УидГруппыОтборов,
	|	ПоказателиРаскрытия.ИмяОбластиДляВывода,
	|	ПоказателиРаскрытия.ПериодОтчета,
	|	ПоказателиРаскрытия.Сценарий,
	|	ПоказателиРаскрытия.Организация,
	|	ПоказателиРаскрытия.Проект,"+ТекстАналитики+"
	|	ПоказателиРаскрытия.АналитикаВалюта
	|
	|ИМЕЮЩИЕ
	|	СУММА(ПоказателиРаскрытия.Значение) <> 0 
	|;
	|
	|// Подзапрос для получения сгруппированного среза по данным без помещения в ВТ
	|ВЫБРАТЬ
	|	ПоказателиРаскрытия.Показатель КАК Показатель,
	|	ПоказателиРаскрытия.ИмяОбластиДляВывода КАК ИмяОбластиДляВывода,
	|	ПоказателиРаскрытия.УидГруппыОтборов КАК УидГруппыОтборов,
	|	ПоказателиРаскрытия.ПериодОтчета КАК ПериодОтчета,
	|	ПоказателиРаскрытия.Сценарий КАК Сценарий,
	|	ПоказателиРаскрытия.Организация КАК Организация,
	|	ПоказателиРаскрытия.Проект КАК Проект,"+ТекстАналитики+"
	|	ПоказателиРаскрытия.АналитикаВалюта КАК АналитикаВалюта,
	|	ПоказателиРаскрытия.Значение КАК Значение,
	|	ПоказателиРаскрытия.ЗначениеВалюта КАК ЗначениеВалюта,
	|	ПоказателиРаскрытия.ЗначениеНеЧисло КАК ЗначениеНеЧисло,
	|	ПоказателиРаскрытия.ПоказательКод КАК ПоказательКод
	|ИЗ
	|	тмПоказателиРаскрытия КАК ПоказателиРаскрытия";	
	
	
	ТекстИтоговогоЗапроса = ТекстИтоговогоЗапроса+ ТекстПодзапроса;

	НстрОсновнаяТаблицаПолученияДанныхЗапроса 					= глСтруктураПараметров.ОсновнаяТаблицаПолученияДанныхЗапроса.Добавить();
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.ТекстПодзапроса  	= ТекстПодзапроса;
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.ТипПодзапроса    	= Перечисления.ТипыЗапросовПолученияДанныхБланков.ИтоговаяТаблицаДанных;
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.ПараметрыПодзапроса  = Неопределено;
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.Комментарий  		= Нстр("ru = 'Запрос получения итоговой таблицы данных'");
	
	
	
КонецПроцедуры	

Функция ПодготовитьТекстФинальногоЗапросаСинтетика(ТзПараметровЗапроса,ПоказателиСинтетика)
	
	Если ПоказателиСинтетика.Количество() = 0 Тогда
		 Возврат "";
	КонецЕсли;	
	
	ПоказателиСумма 					= Новый Массив;
	ПоказателиМаксимум 					= Новый Массив;
	ПоказателиМинимум 					= Новый Массив;
	ПоказателиБезИтога 					= Новый Массив;
	ПоказателиСреднее                   = Новый Массив;
	ПоказателиМаксимумНечисловые 		= Новый Массив;
	ПоказателиМинимумНечисловые 		= Новый Массив;
	ПоказателиБезИтогаНечисловые		= Новый Массив;
	
	ТзСвойстваПоказателей  =  ПолучитьСвойстваПоказателей(ПоказателиСинтетика);
	
	Для Каждого Пок Из ТзСвойстваПоказателей Цикл
		
		//числовые показатели
		Если Пок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			Если Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается  Тогда
				ПоказателиБезИтога.Добавить(Пок.Ссылка);
			ИначеЕсли Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Максимум Тогда
				ПоказателиМаксимум.Добавить(Пок.Ссылка);
			ИначеЕсли Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Минимум Тогда
				ПоказателиМинимум.Добавить(Пок.Ссылка);
			ИначеЕсли Не ЗначениеЗаполнено(Пок.ВидИтога) ИЛИ Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Сумма Тогда 	
				ПоказателиСумма.Добавить(Пок.Ссылка);
			ИначеЕсли Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Среднее Тогда	
				ПоказателиСреднее.Добавить(Пок.Ссылка);
			КонецЕсли;				
		Иначе	
			Если Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается Тогда
				ПоказателиБезИтогаНечисловые.Добавить(Пок.Ссылка);
			ИначеЕсли Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Максимум Тогда
				ПоказателиМаксимумНечисловые.Добавить(Пок.Ссылка);
			ИначеЕсли Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Минимум Тогда
				ПоказателиМинимумНечисловые.Добавить(Пок.Ссылка);
			ИначеЕсли (Не ЗначениеЗаполнено(Пок.ВидИтога) И Пок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка) Тогда 	
				ПоказателиБезИтогаНечисловые.Добавить(Пок.Ссылка);
			ИначеЕсли (Не ЗначениеЗаполнено(Пок.ВидИтога) И (Пок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево ИЛИ Пок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата)) Тогда 	
				ПоказателиМаксимумНечисловые.Добавить(Пок.Ссылка);
			КонецЕсли;		
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстВыбираемыхПолей = "";
	КоличествоВыбираемыхПолей = 0;
	Если ПоказателиСумма.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиСуммаСинтетика) 		ТОГДА СУММА(тмПоказателиРаскрытия.Значение)";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;	
	Если ПоказателиМаксимум.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиМаксимумСинтетика) 	ТОГДА  МАКСИМУМ(тмПоказателиРаскрытия.Значение)";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;	
	Если ПоказателиМинимум.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиМинимумСинтетика) 	ТОГДА  МИНИМУМ(тмПоказателиРаскрытия.Значение)";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;	
    Если ПоказателиБезИтога.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиБезИтога) 			ТОГДА  НЕОПРЕДЕЛЕНО";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;	
	Если ПоказателиСреднее.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиСреднееСинтетика) 	ТОГДА  СРЕДНЕЕ(тмПоказателиРаскрытия.Значение)";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;		
	Если ПоказателиБезИтогаНечисловые.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиБезИтогаНечисловые) 	ТОГДА  """"";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;
	Если ПоказателиМаксимумНечисловые.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиМаксимумНечисловые) 	ТОГДА   МАКСИМУМ(тмПоказателиРаскрытия.ЗначениеНеЧисло)";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;
    Если ПоказателиМинимумНечисловые.Количество()>0 Тогда	
		ТекстВыбираемыхПолей = ТекстВыбираемыхПолей+"
		|ИНАЧЕ ВЫБОР КОГДА  тмПоказателиРаскрытия.Показатель В (&ПоказателиМинимумНечисловые) 	ТОГДА   МИНИМУМ(тмПоказателиРаскрытия.ЗначениеНеЧисло)";	
		КоличествоВыбираемыхПолей = КоличествоВыбираемыхПолей+1;
	КонецЕсли;
	
	ТекстОкончанияВыборов = "";
	Для Инд = 1 По КоличествоВыбираемыхПолей Цикл
		ТекстОкончанияВыборов = ТекстОкончанияВыборов+"
		|КОНЕЦ";
	КонецЦикла;	
		
	Если КоличествоВыбираемыхПолей = 1 Тогда
		ТекстТогда = СтрНайти(ТекстВыбираемыхПолей,"ТОГДА");
		ТекстВыбираемыхПолей = Прав(ТекстВыбираемыхПолей,СтрДлина(ТекстВыбираемыхПолей)-(ТекстТогда+4))+"
		| КАК Значение";
	ИначеЕсли КоличествоВыбираемыхПолей = 0 Тогда	
		ТекстВыбираемыхПолей = "
		|NULL КАК Значение";
	Иначе
		ТекстВыбираемыхПолей = Прав(ТекстВыбираемыхПолей,СтрДлина(ТекстВыбираемыхПолей)-6)+" 
		|"+ТекстОкончанияВыборов+"
		| КАК Значение";
	КонецЕсли;
	
	ТекстШаблонаЗапроса="
	|//-- ПОЛУЧЕНИЕ ЗАПРОСА ДЛЯ ВЫВОДА ОБЛАСТЕЙ БЕЗ РАСКРЫТИЙ    
	|";	
	ТекстШаблонаЗапроса		=	ТекстШаблонаЗапроса +"
	|ВЫБРАТЬ
	| тмПоказателиРаскрытия.Показатель,
	| тмПоказателиРаскрытия.ИмяОбластиДляВывода КАК ИмяОбластиДляВывода,		
	| СУММА(тмПоказателиРаскрытия.Значение)
	|ИЗ
	| 	тмПоказателиРаскрытия КАК тмПоказателиРаскрытия
	| 	ГДЕ тмПоказателиРаскрытия.Показатель В (&ПоказателиСинтетика) 
	| 	И тмПоказателиРаскрытия.УидГруппыОтборов В (&ГруппыОтборовСинтетика)
	|СГРУППИРОВАТЬ ПО 
	|	тмПоказателиРаскрытия.Показатель,
	|	тмПоказателиРаскрытия.ИмяОбластиДляВывода
	|";
		
	ТекстШаблонаЗапроса = СтрЗаменить(ТекстШаблонаЗапроса,"СУММА(тмПоказателиРаскрытия.Значение)",ТекстВыбираемыхПолей);
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиСуммаСинтетика";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	= ПоказателиСумма;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиМаксимумСинтетика";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиМаксимум;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиМинимумСинтетика";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиМинимум;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиБезИтогаСинтетика";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиБезИтога;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиСреднееСинтетика";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиСреднее;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиБезИтогаНечисловые";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиБезИтогаНечисловые;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиБезИтога";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиБезИтога;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиМинимумНечисловые";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиМинимумНечисловые;
	
	Нотбор = ТзПараметровЗапроса.Добавить();
	Нотбор.ИмяОтбора 		= "ПоказателиМаксимумНечисловые";
	Нотбор.ТипОтбора 		= Перечисления.ВидыСравненияПоказателейОтчетов.ВСписке;
	Нотбор.ЗначениеОтбора	=  ПоказателиМаксимумНечисловые;
	
	
	Возврат ТекстШаблонаЗапроса;
	
КонецФункции	

Функция СформироватьТекстОтбораПоМакету(ПрефиксТаблицы,ПрефиксПараметра,СтрокаОтбора="ПериодОтчета",ТзПараметровЗапроса,нИмяПоля="") Экспорт
	
	Если СтрокаОтбора = "ПериодОтчета" Тогда 
		ТекстОтбора = ВРег("И ")+ПрефиксТаблицы+"."+нИмяПоля+" В (&ПериодОтчета_"+ПрефиксПараметра+")";
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "ПериодОтчета_"+ПрефиксПараметра;
		Нотбор.ТипОтбора 		= "ПериодОтчета";
		Нотбор.ЗначениеОтбора	= "ПериодОтчета";	 
		Нотбор.УидГруппыОтбора	= СтрЗаменить(ПрефиксПараметра,"Пар_","");
		Возврат  ТекстОтбора;
	КонецЕсли;
	
	ТекстОтбора 	= "";
	ИмяПоля 		= ?(ЗначениеЗаполнено(нИмяПоля),нИмяПоля,СтрокаОтбора.Поле);
	Отбор   		= СтрокаОтбора.Отбор;
	ЗначениеОтбора = СтрокаОтбора.ЗначениеОтбораСтрока;
	
	Если Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.Равно Тогда 
		ТекстОтбора = ВРег("И ")+ПрефиксТаблицы+"."+ИмяПоля+" = &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
		Нотбор.ЗначениеОтбора	=  ЗначениеИзСтрокиВнутр(ЗначениеОтбора);	 
	ИначеЕсли Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.НеРавно Тогда
		ТекстОтбора = ВРег("И ")+ПрефиксТаблицы+"."+ИмяПоля+" <> &Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор = ТзПараметровЗапроса.Добавить();
		Нотбор.ИмяОтбора 		= "Пар_"+ПрефиксПараметра+"_"+ИмяПоля;
		Нотбор.ТипОтбора 		= Отбор;
