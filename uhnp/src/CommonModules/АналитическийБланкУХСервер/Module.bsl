		|	ЗначенияПоказателей.УникальныйИдентификаторСеанса = &УникальныйИдентификаторСеанса";	
	
	
	ФинальныйЗапрос.Текст = ФинальныйЗапрос.Текст+ТекстПодзапроса;
	
		
	НстрОсновнаяТаблицаПолученияДанныхЗапроса 					= глСтруктураПараметров.ОсновнаяТаблицаПолученияДанныхЗапроса.Добавить();
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.ТекстПодзапроса  	= ТекстПодзапроса;
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.ТипПодзапроса    	= Перечисления.ТипыЗапросовПолученияДанныхБланков.ЗаписиЛогаТекущегоСеанса;
	НстрОсновнаяТаблицаПолученияДанныхЗапроса.Комментарий  		= Нстр("ru = 'Запрос получения показателей и комментариев из лога'");

	
	ТекущиеПараметрыЗапроса = глСтруктураПараметров.ТзПараметровЗапроса.СкопироватьКолонки();
	
