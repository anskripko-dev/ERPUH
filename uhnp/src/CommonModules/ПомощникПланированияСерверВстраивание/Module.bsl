КонецПроцедуры

#КонецОбласти   

#Область ДляВызоваИзСвязанныхОбъектов 

Функция СформироватьСПЗНаОснованииПроекта(Знач СтруктураПроектаСПЗ) Экспорт
	
	Перем ДатаМаксимум, ДатаМинимум, ДатыПоставки, ДлительностиПодготовки, ДлительностиПроцедуры, ДлительностьПодготовки, ДлительностьПроцедуры, Док, НачалоЗакупок;
	
	Док = Документы.СтрокаПланаЗакупок.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Док.ЦенаВключаетНДС = Истина;   
	
	ТаблицаВалюты = СтруктураПроектаСПЗ.Позиции.Скопировать(, "Валюта");
	ТаблицаВалюты.Свернуть("Валюта");    
	Если ТаблицаВалюты.Количество()=1 Тогда 
		Док.ВалютаДокумента = ТаблицаВалюты[0].Валюта;
	Иначе
		ВызватьИсключение Нстр("ru = 'Неоднозначное определение валюты документа. Черновик содержит потребности с разной валютой'");	
	КонецЕсли;
	
	Док.Номенклатура.Загрузить(СтруктураПроектаСПЗ.Позиции);    
	Док.Заполнить(СтруктураПроектаСПЗ.ДанныеЗаполнения);
	Если Константы.РазделятьНоменклатуруПоКатегорийнымМенеджерам.Получить() Тогда
		УстановитьТоварнуюКатегорию(Док);
	Иначе
		// Не требуется принудительная установка товарной категории.
	КонецЕсли;
	//Док.ЕдиноеМестоПоставки = СтруктураПроектаСПЗ.ДанныеЗаполнения.ЕдиноеМестоПоставки;
	Док.ПорядокФормированияЦеныДоговора = ".";
	Док.УсловиеОплаты = СтруктураПроектаСПЗ.ДанныеЗаполнения.УсловияОплаты;	  
	
	//Параметры оплаты
	УстановитьПараметрыОплатыДокументаПоПроекту(Док, СтруктураПроектаСПЗ);
	
	Док.Раздел = Перечисления.ЭтапыПланированияПотребностей.ЗакупочныеПроцедуры;     
	
	ДлительностиПодготовки = СтруктураПроектаСПЗ.Параметры.НайтиСтроки(Новый Структура("Свойство", ПланыВидовХарактеристик.ПараметрыЗакупки.ДлительностьПодготовки)); 
	Если ДлительностиПодготовки.Количество() Тогда
		ДлительностьПодготовки =  ДлительностиПодготовки[0].Значение;
	Иначе
		ВызватьИсключение Нстр("ru = 'Необходимо указать способ закупки'");
	КонецЕсли;  
	ДлительностиПроцедуры = СтруктураПроектаСПЗ.Параметры.НайтиСтроки(Новый Структура("Свойство", ПланыВидовХарактеристик.ПараметрыЗакупки.ДлительностьПроцедуры)); 
	Если ДлительностиПроцедуры.Количество() Тогда
		ДлительностьПроцедуры =  ДлительностиПроцедуры[0].Значение;
	Иначе
		ВызватьИсключение Нстр("ru = 'Необходимо указать способ закупки'");
	КонецЕсли;    
	
	ДатыПоставки = СтруктураПроектаСПЗ.Позиции.Скопировать(, "ДатаПоставки");       
	ДатыПоставки.Сортировать("ДатаПоставки Возр"); 
	ДатаМинимум = ДатыПоставки[0].ДатаПоставки;
	ДатаМаксимум = ДатыПоставки[ДатыПоставки.Количество()-1].ДатаПоставки;  
	НачалоЗакупок = Макс(ТекущаяДата(), НачалоГода(ДатаМинимум));  
	
	Док.ДатаНачалаПодготовкиЗакупки 		= Макс(ДатаМинимум-ДлительностьПодготовки*24*60*60, НачалоЗакупок);
	Док.ДатаИсполненияДоговора 				= КонецГода(ДатаМаксимум);
	Док.ДатаОфициальногоОбъявленияЗакупки 	= Макс(ДатаМинимум-ДлительностьПроцедуры*24*60*60, НачалоЗакупок);  
	
	РассчитатьСуммыНДССтрок(Док);
	
	Сумма = Док.Номенклатура.Итог("Сумма");    
	Если Сумма <> 0 Тогда
		ИтогСуммаНДС = Док.Номенклатура.Итог("СуммаНДС");
		КоэффициентНДС = ИтогСуммаНДС / Сумма;
		Док.СуммаНДС = КоэффициентНДС * Док.СуммаДокумента;
	Иначе
		СуммаНДС = 0;
	КонецЕсли;
	
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док;

КонецФункции

Процедура РассчитатьСуммыНДССтрок(Знач Док)
	
	Перем СоответствиеСтавок, СтавкиНДСТаблица, СтрокаНоменклатура, ТекСтавкаНдсЧисло;
	
	СтавкиНДСТаблица = Док.Номенклатура.Выгрузить(, "СтавкаНДС"); 
	СтавкиНДСТаблица.Свернуть("СтавкаНДС"); 
	СоответствиеСтавок = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СтавкиНДСТаблица.ВыгрузитьКолонку("СтавкаНДС"), "Ставка"); 
	Для Каждого СтрокаНоменклатура Из Док.Номенклатура Цикл      
		ТекСтавкаНдсЧисло = СоответствиеСтавок.Получить(СтрокаНоменклатура.СтавкаНДС);
		СтрокаНоменклатура.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(СтрокаНоменклатура.Сумма, Док.ЦенаВключаетНДС, ТекСтавкаНдсЧисло);
	КонецЦикла;

КонецПроцедуры        

Функция НаОснованииПроектаСПЗС_СформироватьЛот(СтруктураПроектаСПЗ) Экспорт
	
	///////	                 
		СпособыЗакупки = СтруктураПроектаСПЗ.Параметры.НайтиСтроки(Новый Структура("Свойство", ПланыВидовХарактеристик.ПараметрыЗакупки.СпособЗакупки)); 
		Если СпособыЗакупки.Количество() Тогда
			СпособЗакупки =  СпособыЗакупки[0].Значение;
		Иначе
			ВызватьИсключение Нстр("ru = 'Необходимо указать способ закупки'");
		КонецЕсли;       
		ДлительностиПодготовки = СтруктураПроектаСПЗ.Параметры.НайтиСтроки(Новый Структура("Свойство", ПланыВидовХарактеристик.ПараметрыЗакупки.ДлительностьПодготовки)); 
		Если ДлительностиПодготовки.Количество() Тогда
			ДлительностьПодготовки =  ДлительностиПодготовки[0].Значение;
		Иначе
			ВызватьИсключение Нстр("ru = 'Необходимо указать способ закупки'");
		КонецЕсли;  
		ДлительностиПроцедуры = СтруктураПроектаСПЗ.Параметры.НайтиСтроки(Новый Структура("Свойство", ПланыВидовХарактеристик.ПараметрыЗакупки.ДлительностьПроцедуры)); 
		Если ДлительностиПроцедуры.Количество() Тогда
			ДлительностьПроцедуры =  ДлительностиПроцедуры[0].Значение;
		Иначе
			ВызватьИсключение Нстр("ru = 'Необходимо указать способ закупки'");
		КонецЕсли;    
		
		ДатыПоставки = СтруктураПроектаСПЗ.Позиции.Скопировать(, "ДатаПоставки");       
		ДатыПоставки.Сортировать("ДатаПоставки Возр"); 
		ДатаМинимум = ДатыПоставки[0].ДатаПоставки;
		ДатаМаксимум = ДатыПоставки[ДатыПоставки.Количество()-1].ДатаПоставки;  
		НачалоЗакупок = Макс(ТекущаяДата(), НачалоГода(ДатаМинимум));
		
		ПараметрыВыбораПоставщика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СпособЗакупки, "СпособыВыбораПоставщика, ЗакрытыйСпособ, ЭлектроннаяФорма");  
		
		Валюты = СтруктураПроектаСПЗ.Позиции.Скопировать(, "Валюта");
		Валюты.Свернуть("Валюта");
		Если Валюты.Количество()=1 Тогда
			ОтборВалюта = Валюты[0].Валюта;
		Иначе
			ВызватьИсключение Нстр("ru = 'Неоднозначное определение валюты потребностей. В документе должна быть только одна валюта'"); 
		КонецЕсли;
	
		ЗакупочнаяПроцедура = Справочники.ЗакупочныеПроцедуры.СоздатьЭлемент();
		ЗакупочнаяПроцедура.УстановитьНовыйКод(); 
		
		ЗакупочнаяПроцедура.ВалютаДокумента 			= ОтборВалюта;
		ЗакупочнаяПроцедура.ПриобретениеФинансовыхУслуг = Ложь;
		ЗакупочнаяПроцедура.ПериодЗакупок				= СтруктураПроектаСПЗ.ПериодЗакупки;
		ЗакупочнаяПроцедура.ОрганизаторЗакупки			= СтруктураПроектаСПЗ.ОрганизацияЗаказчик;
		ЗакупочнаяПроцедура.ОрганизацияДляЗаключенияДоговора	= СтруктураПроектаСПЗ.ОрганизацияЗаказчик;
		ЗакупочнаяПроцедура.СпособВыбораПоставщика		= СпособЗакупки;
		ЗакупочнаяПроцедура.ЗакрытаяЗакупка 			= ПараметрыВыбораПоставщика.ЗакрытыйСпособ;
		ЗакупочнаяПроцедура.ВЭлектроннойФорме 			= ПараметрыВыбораПоставщика.ЭлектроннаяФорма;
		ЗакупочнаяПроцедура.КоличествоМестСОбязанностьюЗаключитьДоговор = 2;
		
		ЗакупочнаяПроцедура.Наименование				= Нстр("ru = 'Закупочные процедуры '")+ ЗакупочнаяПроцедура.Код;
		ЗакупочнаяПроцедура.ПредметДоговора				= "< Уточните предмет договора >"; 
		ЗакупочнаяПроцедура.ОбщиеТребования				= СтруктураПроектаСПЗ.ОбщиеТребования;
		ЗакупочнаяПроцедура.МинимальноеКоличествоЗаявок = 2;    
		
		ЗакупочнаяПроцедура.ДатаНачалаПериодаПоставки 		= ДатаМинимум;
		ЗакупочнаяПроцедура.ДатаОкончанияПериодаПоставки 	= ДатаМаксимум; 
		ЗакупочнаяПроцедура.ДатаОфициальногоОбъявленияЗакупки = Макс(ДатаМинимум-ДлительностьПроцедуры*24*60*60, НачалоЗакупок); 		
		ЗакупочнаяПроцедура.ДатаНачалаПодготовкиЗакупки		= Макс(ДатаМинимум-ДлительностьПодготовки*24*60*60, НачалоЗакупок);      
		
		УстановитьПараметрыОплатыДокументаПоПроекту(ЗакупочнаяПроцедура, СтруктураПроектаСПЗ);    
		
		МестаПоставкиТаблица = СтруктураПроектаСПЗ.Позиции.Скопировать(, "МестоПоставки"); 
		МестаПоставкиТаблица.Свернуть("МестоПоставки"); 
		
		ЗакупочнаяПроцедура.Записать();    
		
		ДокументЛот 		= Документы.Лот.СоздатьДокумент(); 
		ДокументЛот.Дата 	= ТекущаяДатаСеанса();                    
		ДокументЛот.ЦенаВключаетНДС 			= Истина;
        ДокументЛот.ЗакупочнаяПроцедура 		= ЗакупочнаяПроцедура.Ссылка; 
		ДокументЛот.ПриобретениеФинансовыхУслуг	= ЗакупочнаяПроцедура.ПриобретениеФинансовыхУслуг; 
		ДокументЛот.ВидЗакупки					= Перечисления.ВидЛотовойЗакупки.ЛотоваяЗакупка;
		ДокументЛот.ВалютаДокумента						= ОтборВалюта;  
		ДокументЛот.ПериодЗакупок						= СтруктураПроектаСПЗ.ПериодЗакупки; 
		ДокументЛот.ОрганизацияДляЗаключенияДоговора	= СтруктураПроектаСПЗ.ОрганизацияЗаказчик;
   		ДокументЛот.МетодОценкиПредложенийПоставщиков 	= МетодОценкиПоСпособуЗакупки(СпособЗакупки);
		ДокументЛот.ЗапретПревышенияНМЦ					= Истина;      
		ДокументЛот.ПредметДоговора				= "< Уточните предмет договора >"; 
		ДокументЛот.ОбщиеТребования				= СтруктураПроектаСПЗ.ОбщиеТребования; 
		ДокументЛот.ЕдиноеМестоПоставки 		= МестаПоставкиТаблица.Количество() = 1;
		
		Для Каждого ПозицияПотребностей Из СтруктураПроектаСПЗ.Позиции Цикл 
			ПараметрыНоменклатуры = ДокументЛот.Номенклатура.Добавить();
			ЗаполнитьЗначенияСвойств(ПараметрыНоменклатуры, ПозицияПотребностей);
		КонецЦикла;  
		
		УстановитьПараметрыОплатыДокументаПоПроекту(ДокументЛот, СтруктураПроектаСПЗ);
		
		ОбщаяСумма = 0;
		ОбщаяСуммаПроцентов = 0; 
		
		ДатаПривлечения 	= Неопределено;
		ДатаВозврата		= Неопределено; 
		ПроцентнаяСтавка	= Неопределено;
		ДокументЛот.ДатаПривлечения    	= ДатаПривлечения;
		ДокументЛот.ДатаВозврата	    = ДатаВозврата;
		ДокументЛот.СуммаПривлечения 	= ОбщаяСумма; 
		СуммаПроцентов					= ОбщаяСуммаПроцентов;
		ДокументЛот.ПроцентнаяСтавка	= ПроцентнаяСтавка;  
		
		РассчитатьСуммыНДССтрок(ДокументЛот);   
		
		Сумма = ДокументЛот.Номенклатура.Итог("Сумма");    
		Если Сумма <> 0 Тогда
			ИтогСуммаНДС = ДокументЛот.Номенклатура.Итог("СуммаНДС");
			ДокументЛот.СуммаНДС = ИтогСуммаНДС;
		Иначе
			СуммаНДС = 0;
		КонецЕсли;

			
		Документы.Лот.РассчитатьСуммуПроцентов(ДокументЛот);
		ДокументЛот.Записать(РежимЗаписиДокумента.Проведение);  
		
		РегистрыСведений.ПроектыСПЗ.СохранитьПроектВИстории(СтруктураПроектаСПЗ, ДокументЛот.Ссылка);
		РегистрыСведений.ПроектыСПЗ.УдалитьПроектСПЗ(СтруктураПроектаСПЗ.Автор, СтруктураПроектаСПЗ.ПериодЗакупки, СтруктураПроектаСПЗ.ИД);
		
	/////  
	
	Возврат ДокументЛот;
	
КонецФункции

Функция МетодОценкиПоСпособуЗакупки(СпособЗакупки)
	
	Перем ВыборкаДетальныеЗаписи, Запрос, МетодОценкиПредложенийПоставщиков, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиПланированияЗакупочныхПроцедур.МетодОценки КАК МетодОценки,
	|	НастройкиПланированияЗакупочныхПроцедур.СрокПодготовки КАК СрокПодготовки,
	|	НастройкиПланированияЗакупочныхПроцедур.ДлительностьПроцедуры КАК ДлительностьПроцедуры
	|ИЗ
	|	РегистрСведений.НастройкиПланированияЗакупочныхПроцедур КАК НастройкиПланированияЗакупочныхПроцедур
	|ГДЕ
	|	НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки В
	|			(ВЫБРАТЬ
	|				СпособыВыбораПоставщикаСправочник.СпособыВыбораПоставщика КАК СпособыВыбораПоставщика
	|			ИЗ
	|				Справочник.СпособыВыбораПоставщика КАК СпособыВыбораПоставщикаСправочник
	|			ГДЕ
	|				СпособыВыбораПоставщикаСправочник.Ссылка = &СпособВыбораПоставщика
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				&СпособВыбораПоставщика)";
	
	Запрос.УстановитьПараметр("СпособВыбораПоставщика", СпособЗакупки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		МетодОценкиПредложенийПоставщиков 	= ВыборкаДетальныеЗаписи.МетодОценки; 
	Иначе
		МетодОценкиПредложенийПоставщиков 	= Перечисления.МетодыОценкиПредложенийПоставщиков.ПоКритериям;	
	КонецЕсли;         
	
	Возврат МетодОценкиПредложенийПоставщиков;

КонецФункции


Процедура УстановитьПараметрыОплатыДокументаПоПроекту(Знач Док, Знач СтруктураПроектаСПЗ) Экспорт
	
	Перем НоваяСтрока, ТекСтрока, ЭтапыОплаты;   
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Календарь", Док.Метаданные()) Тогда

		Док.Календарь	= СтруктураПроектаСПЗ.ПараметрыОплаты.КалендарьГрафика; 
		
	КонецЕсли;
	
	Если Док.Метаданные().ТабличныеЧасти.Найти("ЭтапыГрафикаОплаты") <> Неопределено Тогда     
		
		ЭтапыОплаты 	= СтруктураПроектаСПЗ.ПараметрыОплаты.ЭтапыГрафикаОплаты;
		Док.ЭтапыГрафикаОплаты.Очистить();  
		Если ЭтапыОплаты <> Неопределено Тогда
			Для Каждого ТекСтрока Из ЭтапыОплаты Цикл
				НоваяСтрока = Док.ЭтапыГрафикаОплаты.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;     
		КонецЕсли;    
		
	КонецЕсли;   
	
	Если Док.Метаданные().ТабличныеЧасти.Найти("ПланОплаты") <> Неопределено Тогда
		ЗаполнитьПланОплатСПЗНаСервере(Док);  
	КонецЕсли;

КонецПроцедуры   

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
// Устанавливает в шапку документа ДокИзм товарную категорию, исходя из табличной 
// части номенклатуры.
Процедура УстановитьТоварнуюКатегорию(ДокИзм)
	Если ТипЗнч(ДокИзм) = Тип("ДокументОбъект.СтрокаПланаЗакупок") Тогда
		// Получим заполненную таблицу номенклатуры.
		ПустаяКатегория = Справочники.ТоварныеКатегории.ПустаяСсылка();
		Выгрузка = ДокИзм.Номенклатура.Выгрузить();
		// Добавим колонку Товарная категрия.
		Выгрузка.Колонки.Добавить("ТоварнаяКатегория");
		Для Каждого ТекВыгрузка Из Выгрузка Цикл
			ТекНоменклатура = ТекВыгрузка.Номенклатура;
			Если ЗначениеЗаполнено(ТекНоменклатура) и типзнч(ТекНоменклатура)=тип("СправочникСсылка.ТоварныеКатегории")  Тогда
				ТекВыгрузка.ТоварнаяКатегория = ТекНоменклатура;
			Иначе
				ТекВыгрузка.ТоварнаяКатегория = ПустаяКатегория;
			КонецЕсли;
		КонецЦикла;	
		// Если категория уникальна - запишем её в шапку.
		МассивКатегорий = Выгрузка.ВыгрузитьКолонку("ТоварнаяКатегория");
		МассивКатегорий = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКатегорий);
		Если МассивКатегорий.Количество() = 1 Тогда
			ДокИзм.ТоварнаяКатегория = МассивКатегорий[0];
		Иначе
			// Не удалось однозначно определить товарную категорию.  не записываем в шапку.
		КонецЕсли;
	Иначе
		// Неизвестный вариант. Пропускаем.
	КонецЕсли;
КонецПроцедуры		// УстановитьТоварнуюКатегорию()

Процедура МодифицироватьСписокПотребностей(Знач Форма)   
	
	Форма.СписокПотребности.ТекстЗапроса = МодифицироватьЗапросПоКатегорийнымМенеджерам(Форма.СписокПотребности.ТекстЗапроса); 
	
	Форма.СписокПотребности.Параметры.УстановитьЗначениеПараметра("Автор", ПараметрыСеанса.ТекущийПользователь);

КонецПроцедуры

Функция МодифицироватьЗапросПоКатегорийнымМенеджерам(ТекстЗапроса) Экспорт
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,																				
								"ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Справочник.Номенклатура).ТоварнаяКатегория, ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка))",																				
								"ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Справочник.Номенклатура).КатегорияЗакупок, ЗНАЧЕНИЕ(Справочник.КатегорииЗакупок.ПустаяСсылка))");																				
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,																				
								"ИНАЧЕ ВЫРАЗИТЬ(ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Справочник.ТоварныеКатегории)",																				
								"ИНАЧЕ ВЫРАЗИТЬ(ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Справочник.КатегорииЗакупок)");																				
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&УсловиеМенеджерАвтор",
								"ПолномочияКатегорийныхМенеджеров.Менеджер = &Автор");   
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&ПараметрАвтор",
								"&Автор");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&УсловиеПараметрыЗакупкиАвтор",
								"ПараметрыЗакупкиПотребностей1.Автор = &Автор"); 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"И ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория ССЫЛКА Справочник.ТоварныеКатегории",
								"И ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория ССЫЛКА Справочник.КатегорииЗакупок");
	Возврат ТекстЗапроса;

КонецФункции

Процедура ЗаполнитьПланОплатСПЗНаСервере(Док)  
	
	Если Док.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;	
	Док.ПланОплаты.Очистить();
	ПланОплаты = Док.ПланОплаты.Выгрузить();
	ПланОплатыКопия = ПланОплаты.Скопировать();
	ШаблонГрафика = Док.ЭтапыГрафикаОплаты;
	Календарь = Док.Календарь;
	
	СуммаПлатежей = 0;
	СуммаОтгрузок = 0;
	Для каждого Период Из Док.Номенклатура Цикл
		
		
		ПланОплатыКопия.Очистить();
		
		СуммаОплатыКраспределению = Период.Сумма;
		
		ПараметрыЗаполнения = ЭтапыОплатыСервер.ПараметрыЗаполненияЭтаповОплаты();
		ПараметрыЗаполнения.ЭтоРасчетыСКлиентами = Ложь;
		ПараметрыЗаполнения.НакладнаяПоЗаказам = Ложь;
		ПараметрыЗаполнения.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		ПараметрыЗаполнения.ЭтоЗаказ = Ложь;
		ПараметрыЗаполнения.ЕстьДатаПереходаПраваСобственности = Ложь;
		
		ПараметрыЗаполнения.Вставить("ДатаОтгрузки", Период.ДатаПоставки);
		ПараметрыЗаполнения.Вставить("ДатаЗаказа", Период.ДатаПоставки);
		ПараметрыЗаполнения.Вставить("ШаблонГрафика", ШаблонГрафика);
		ПараметрыЗаполнения.Вставить("Календарь", Календарь.ПроизводственныйКалендарь);
		ПараметрыЗаполнения.Вставить("СуммаОплаты", СуммаОплатыКраспределению);
		
		ЭтапыОплатыСервер.ЗаполнитьЭтапыОплатыДокументаПоШаблону(ПланОплатыКопия, ПараметрыЗаполнения);
		
		Для каждого ЭтапОплаты Из ПланОплатыКопия Цикл
			
			НовСтр = ПланОплаты.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,ЭтапОплаты);
			НовСтр.СтатьяБюджета = Период.СтатьяБюджета;
			НовСтр.Аналитика1 = Период.Аналитика1;
			НовСтр.Аналитика2 = Период.Аналитика2;
			НовСтр.Аналитика3 = Период.Аналитика3;
			НовСтр.Аналитика4 = Период.Аналитика4;
			НовСтр.Аналитика5 = Период.Аналитика5;
			НовСтр.Аналитика6 = Период.Аналитика6;
			
			НовСтр.ДатаПоступления = Период.ДатаПоставки;
			
		КонецЦикла; 
		
	КонецЦикла; 

	ПланОплаты.Свернуть("ПроцентПлатежа,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6,ВариантОплаты, ДатаПлатежа, ДатаПоступления, Замещен","СуммаПлатежа, СуммаЗадолженности, СуммаОтгрузок");
	ПланОплаты.Колонки.Добавить("СуммаПлатежей");
	ПланОплаты.Сортировать("ДатаПлатежа,ДатаПоступления,СтатьяБюджета");
	
	Док.ПланОплаты.Загрузить(ПланОплаты);
	
КонецПроцедуры
#КонецОбласти

#КонецЕсли
