
////////////////////////////////////////////////////////////////////////////////
// Модуль содержит процедуры и функции работы с периодами, 
// результат которых используется повторно.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Процедура проверяет интервал периодов в справочнике "Периоды" и создает недостающие элементы
//
Процедура ПроверитьИнтервалПериодовВФоне(НачалоПериода, КонецПериода, Периодичность = Неопределено, ИдентификаторФормы = неопределено) Экспорт
	
	Если ИдентификаторФормы = неопределено тогда
		ИдентификаторФормы = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
	ПараметрыВыполнения.Вставить("ЗапуститьВФоне", Истина);
	ПараметрыВыполнения.Вставить("ОжидатьЗавершение", 0);
	ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "ПериодыУХПовтИсп.ПроверитьИнтервалПериодов",
		НачалоПериода, КонецПериода, Периодичность);
	
КонецПроцедуры

// Процедура проверяет интервал периодов в справочнике "Периоды" и создает недостающие элементы
// Рекомендуется пользоваться процедурой "ПериодыУХПовтИсп.ПроверитьИнтервалПериодовВФоне"
//
Процедура ПроверитьИнтервалПериодов(НачалоПериода, КонецПериода, Периодичность = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Периодичность) Тогда
		Периодичность = Перечисления.Периодичность.День;
	КонецЕсли;
	
	ЗаполняемыеПериодичности = ЗаполняемыеПериодичности(Периодичность);
	
	ЗапросПоПериодам = Новый Запрос(ТекстЗапросаПроверкиПериодов(ЗаполняемыеПериодичности));
	ЗапросПоПериодам.УстановитьПараметр("ДатаНачала", Мин(НачалоПериода, КонецПериода));
	ЗапросПоПериодам.УстановитьПараметр("ДатаЗавершения", Макс(НачалоПериода, КонецПериода));
	
	ВыборкаНезаполненныхПериодов = ЗапросПоПериодам.Выполнить().Выбрать();
	
	Пока ВыборкаНезаполненныхПериодов.Следующий() Цикл
		
		Справочники.Периоды.СоздатьПериоды(
			КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(
				КэшируемыеПроцедурыУХ.ДатаНачалаПериода(
					ВыборкаНезаполненныхПериодов.Год, 
					Перечисления.Периодичность.Год), 
				Перечисления.Периодичность.Год, 
				0, 
				Истина, 
				Ложь), 
			ЗаполняемыеПериодичности);
		
	КонецЦикла;
		
КонецПроцедуры

// Возвращает структуру, содержащую значения реквизитов периода
//
// Параметры:
//  Период - <СправочникСсылка.Периоды> - Период, параметры которого необходимо получить
//
// Возвращаемое значение:
//   <Структура> - Параметры периода
//			ДатаНачала		- Дата								- Дата начала периода
//			ДатаОкончания	- Дата								- Дата окончания периода
//			Периодичность	- ПеречислениеСсылка.Периодичность	- Периодичность
//			Произвольный	- Булево							- признак произвольности периода
//
Функция ПараметрыПериода(Период) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Период)
		ИЛИ ТипЗнч(Период) <> Тип("СправочникСсылка.Периоды") Тогда
		Возврат неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Реквизиты = "ДатаНачала, ДатаОкончания, Периодичность, Произвольный";
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Период, Реквизиты);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполняемыеПериодичности(ГраницаПериодичности)
	
	ДоступныеПериодичности = ДоступныеПериодичности();
	
	ЗаполняемыеПериодичности = Новый Массив;
	Для Каждого Периодичность Из ДоступныеПериодичности Цикл
		
		ЗаполняемыеПериодичности.Добавить(Периодичность);
		
		Если Периодичность = ГраницаПериодичности Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЗаполняемыеПериодичности;
	
КонецФункции

Функция ДоступныеПериодичности()
	
	ДоступныеПериодичности = Новый Массив;
	
	// Добавляются в порядке возрастания детализации
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.Год);
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.ДевятьМесяцев);
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.Полугодие);
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.Квартал);
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.Месяц);
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.Декада);
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.Неделя);
	ДоступныеПериодичности.Добавить(Перечисления.Периодичность.День);
	
	Возврат ДоступныеПериодичности;
	
КонецФункции

Функция ТекстЗапросаПроверкиПериодов(ЗаполняемыеПериодичности)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	0 КАК Цифра
	|ПОМЕСТИТЬ ВТЦифры
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	3
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	4
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	5
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	6
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	7
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	8
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	9
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД), ГОД, Цифры10.Цифра * 10 + Цифры.Цифра) КАК Год
	|ПОМЕСТИТЬ ВТГоды
	|ИЗ
	|	ВТЦифры КАК Цифры10,
	|	ВТЦифры КАК Цифры
	|ГДЕ
	|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД), ГОД, Цифры10.Цифра * 10 + Цифры.Цифра) МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД) И &ДатаЗавершения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТЦифры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Годы.Год КАК Год,
	|	ПеречислениеПериодичность.Ссылка КАК Периодичность,
	|	ВЫБОР
	|		КОГДА ГОД(Годы.Год) / 4 - (ВЫРАЗИТЬ(ГОД(Годы.Год) / 4 КАК ЧИСЛО(3, 0))) = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ВисокосныйГод,
	|	Периоды.Ссылка КАК Период
	|ПОМЕСТИТЬ ВТПериоды
	|ИЗ
	|	ВТГоды КАК Годы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Периоды КАК Периоды
	|		ПО Годы.Год = Периоды.ДатаНачала
	|			И (Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)),
	|	Перечисление.Периодичность КАК ПеречислениеПериодичность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТГоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(СправочникПериоды.ДатаНачала, ГОД) КАК Год,
	|	СправочникПериоды.Периодичность КАК Периодичность,
	|	КОЛИЧЕСТВО(СправочникПериоды.Ссылка) КАК КоличествоПериодов
	|ПОМЕСТИТЬ ВТПодчиненныеПериоды
	|ИЗ
	|	Справочник.Периоды КАК СправочникПериоды
	|ГДЕ
	|	СправочникПериоды.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Периоды.Период
	|			ИЗ
	|				ВТПериоды КАК Периоды)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(СправочникПериоды.ДатаНачала, ГОД),
	|	СправочникПериоды.Периодичность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Периоды.Год КАК Год,
	|	Периоды.Период КАК Период
	|ИЗ
	|	ВТПериоды КАК Периоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПодчиненныеПериоды КАК ПодчиненныеПериоды
	|		ПО Периоды.Год = ПодчиненныеПериоды.Год
	|			И Периоды.Периодичность = ПодчиненныеПериоды.Периодичность
	|ГДЕ
	|	&ОтборПоКоличествуПериодов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Год
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТПериоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТПодчиненныеПериоды";
	
	ТекстОтборПоКоличествуПериодов = ТекстОтборПоКоличествуПериодов(ЗаполняемыеПериодичности);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоКоличествуПериодов", ТекстОтборПоКоличествуПериодов);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстОтборПоКоличествуПериодов(ЗаполняемыеПериодичности)
	
	ТекстыОтборов = Новый Массив;
	
	Для Каждого Периодичность Из ЗаполняемыеПериодичности Цикл
		
		Если Периодичность = Перечисления.Периодичность.Год Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 1
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)");
		ИначеЕсли Периодичность = Перечисления.Периодичность.ДевятьМесяцев Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 1
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.ДевятьМесяцев)");
		ИначеЕсли Периодичность = Перечисления.Периодичность.Полугодие Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 2
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)");
		ИначеЕсли Периодичность = Перечисления.Периодичность.Квартал Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 4
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)");
		ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 12
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)");
		ИначеЕсли Периодичность = Перечисления.Периодичность.Декада Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 36
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)");
		ИначеЕсли Периодичность = Перечисления.Периодичность.Неделя Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 61
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)");
		ИначеЕсли Периодичность = Перечисления.Периодичность.День Тогда
			ТекстыОтборов.Добавить("ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 365
				|		И НЕ Периоды.ВисокосныйГод
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.День)
				|	ИЛИ ЕСТЬNULL(ПодчиненныеПериоды.КоличествоПериодов, 0) < 366
				|		И Периоды.ВисокосныйГод
				|		И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.День)");
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстыОтборов = СтрСоединить(ТекстыОтборов, Символы.ПС + Символы.Таб + "ИЛИ ");
	
	Возврат ТекстыОтборов;
	
КонецФункции

#КонецОбласти
