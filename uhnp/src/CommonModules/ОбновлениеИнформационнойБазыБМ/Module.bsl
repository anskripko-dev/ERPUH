			ЗначенияНастроек.Вставить("ПериодичностьСвертывания", Выборка.ПериодичностьСвертывания);
		КонецЕсли;
		
		УправлениеОтчетамиУХ.УстановитьНастройкиОбработкиШаблонов(ПараметрыНастроек, ЗначенияНастроек);
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.СпособФормированияОтчета = Неопределено;
		ДокументОбъект.ПравилоОбработки = Неопределено;
		ДокументОбъект.БланкИмпорта = Неопределено;
