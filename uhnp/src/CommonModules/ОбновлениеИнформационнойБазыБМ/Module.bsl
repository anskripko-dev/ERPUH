Процедура ОбновитьПредопределенные_3_2_7(Параметры = Неопределено) Экспорт
	
	Справочники.ВариантыМногоэтапнойЗакупки.ОбновитьПредопределенные();
	
	Возврат;
	
	ПараметрыОбновления = Параметры;
	Если ПараметрыОбновления = Неопределено Тогда
		ПараметрыОбновления = Новый Структура;
	КонецЕсли;
	
	Если Не ПараметрыОбновления.Свойство("Очередь") Тогда
		ПараметрыОбновления.Вставить("Очередь", 1);
	КонецЕсли;
	
	Если Не ПараметрыОбновления.Свойство("ОбработкаЗавершена") Тогда
		ПараметрыОбновления.Вставить("ОбработкаЗавершена", Ложь);
	КонецЕсли;
	
	НастройкиЗаполнения = ОбновлениеИнформационнойБазы.НастройкиЗаполнения();
	
	ОбновлениеИнформационнойБазы.ЗаполнитьЭлементыНачальнымиДанными(ПараметрыОбновления, 
		Метаданные.Справочники.ВариантыМногоэтапнойЗакупки, НастройкиЗаполнения);
		
	ОбновлениеИнформационнойБазы.ЗаполнитьЭлементыНачальнымиДанными(ПараметрыОбновления, 
		Метаданные.Справочники.ЗависимостиСчетов, НастройкиЗаполнения);

    ОбновлениеИнформационнойБазы.ЗаполнитьЭлементыНачальнымиДанными(ПараметрыОбновления, 
		Метаданные.Справочники.ЭтапыРаздельнойЗакупки, НастройкиЗаполнения);
	
КонецПроцедуры

Процедура ПеренестиНастройкиОбработкиШаблоновДокументов(Параметры=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ЭлементНастройкиОтчета = ЗНАЧЕНИЕ(Перечисление.ЭлементыНастройкиОтчета.УдалитьБланкДляОтображенияМногопериодный)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПорядокБланка,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ЭлементНастройкиОтчета = ЗНАЧЕНИЕ(Перечисление.ЭлементыНастройкиОтчета.УдалитьБланкДляОтображенияМногопериодный)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ЭлементыНастройкиОтчета.БланкДляОтображения)
		|		ИНАЧЕ ДанныеРегистра.ЭлементНастройкиОтчета
		|	КОНЕЦ КАК ЭлементНастройки,
		|	ДанныеРегистра.ШаблонДокументаБД КАК ШаблонДокумента,
		|	ДанныеРегистра.ВерсияОрганизационнойСтруктуры КАК ВерсияРегламента,
		|	ДанныеРегистра.Организация КАК Организация,
		|	ЕСТЬNULL(УправлениеПериодомСценария.Ссылка, ЗНАЧЕНИЕ(Документ.УправлениеПериодомСценария.ПустаяСсылка)) КАК УправлениеПериодом,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДанныеРегистра.ЗначениеЭлементаНастройкиОтчета = НЕОПРЕДЕЛЕНО
		|				ТОГДА ДанныеРегистра.УдалитьЗначениеЭлементаНастройкиОтчета
		|			ИНАЧЕ ДанныеРегистра.ЗначениеЭлементаНастройкиОтчета
		|		КОНЕЦ) КАК ЗначениеНастройки
		|ПОМЕСТИТЬ втДанныеРегистра
		|ИЗ
		|	РегистрСведений.УдалитьНастройкаОбработкиОтчетов КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УправлениеПериодомСценария КАК УправлениеПериодомСценария
		|		ПО ДанныеРегистра.Сценарий = УправлениеПериодомСценария.Сценарий
		|			И ДанныеРегистра.ПериодОтчета = УправлениеПериодомСценария.ПериодСценария
		|ГДЕ
		|	ДанныеРегистра.ЭлементНастройкиОтчета В(&ЭлементыНастройкиОтчета)
		|	И ДанныеРегистра.ШаблонДокументаБД <> НЕОПРЕДЕЛЕНО
		|	И ДанныеРегистра.ШаблонДокументаБД <> ЗНАЧЕНИЕ(Справочник.ШаблоныТрансформационныхКорректировок.ПустаяССылка)
		|	И ДанныеРегистра.ШаблонДокументаБД <> ЗНАЧЕНИЕ(Справочник.ШаблоныКорректировокЗначенийПоказателей.ПустаяССылка)
		|	И ДанныеРегистра.ШаблонДокументаБД <> ЗНАЧЕНИЕ(Справочник.ШаблоныТрансляций.ПустаяССылка)
		|	И ДанныеРегистра.ШаблонДокументаБД <> ЗНАЧЕНИЕ(Справочник.ВидыОтчетов.ПустаяССылка)
		|	И (ДанныеРегистра.ШаблонДокументаБД ССЫЛКА Справочник.ШаблоныТрансформационныхКорректировок
		|			ИЛИ ДанныеРегистра.ШаблонДокументаБД ССЫЛКА Справочник.ШаблоныКорректировокЗначенийПоказателей
		|			ИЛИ ДанныеРегистра.ШаблонДокументаБД ССЫЛКА Справочник.ШаблоныТрансляций
		|			ИЛИ ДанныеРегистра.ШаблонДокументаБД ССЫЛКА Справочник.ВидыОтчетов)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеРегистра.ЭлементНастройкиОтчета,
		|	ДанныеРегистра.ШаблонДокументаБД,
		|	ДанныеРегистра.Организация,
		|	ДанныеРегистра.ВерсияОрганизационнойСтруктуры,
		|	УправлениеПериодомСценария.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ДанныеРегистра.ПорядокБланка) КАК ПорядокБланка,
		|	ДанныеРегистра.ЭлементНастройки КАК ЭлементНастройки,
		|	ДанныеРегистра.ШаблонДокумента КАК ШаблонДокумента,
		|	ДанныеРегистра.ВерсияРегламента КАК ВерсияРегламента,
		|	ДанныеРегистра.Организация КАК Организация,
		|	ДанныеРегистра.УправлениеПериодом КАК УправлениеПериодом
		|ПОМЕСТИТЬ втМаксимальныйПорядокБланка
		|ИЗ
		|	втДанныеРегистра КАК ДанныеРегистра
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеРегистра.ЭлементНастройки,
		|	ДанныеРегистра.ШаблонДокумента,
		|	ДанныеРегистра.ВерсияРегламента,
		|	ДанныеРегистра.Организация,
		|	ДанныеРегистра.УправлениеПериодом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеРегистра.ШаблонДокумента КАК ШаблонДокумента,
		|	ДанныеРегистра.ЭлементНастройки КАК ЭлементНастройки,
		|	ДанныеРегистра.ВерсияРегламента КАК ВерсияРегламента,
		|	ДанныеРегистра.Организация КАК Организация,
		|	ДанныеРегистра.УправлениеПериодом КАК УправлениеПериодом,
		|	ДанныеРегистра.ЗначениеНастройки КАК ЗначениеНастройки
		|ИЗ
		|	втДанныеРегистра КАК ДанныеРегистра
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныйПорядокБланка КАК МаксимальныйПорядокБланка
		|		ПО ДанныеРегистра.ПорядокБланка = МаксимальныйПорядокБланка.ПорядокБланка
		|			И ДанныеРегистра.ЭлементНастройки = МаксимальныйПорядокБланка.ЭлементНастройки
		|			И ДанныеРегистра.ШаблонДокумента = МаксимальныйПорядокБланка.ШаблонДокумента
		|			И ДанныеРегистра.ВерсияРегламента = МаксимальныйПорядокБланка.ВерсияРегламента
		|			И ДанныеРегистра.Организация = МаксимальныйПорядокБланка.Организация
		|			И ДанныеРегистра.УправлениеПериодом = МаксимальныйПорядокБланка.УправлениеПериодом";
	
	Если НЕ ОбщегоНазначенияПовтИспУХ.ИспользуетсяМногопериоднаяОтчетность() Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ДанныеРегистра.ШаблонДокументаБД <> ЗНАЧЕНИЕ(Справочник.ШаблоныКорректировокЗначенийПоказателей.ПустаяССылка)", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ ДанныеРегистра.ШаблонДокументаБД ССЫЛКА Справочник.ШаблоныКорректировокЗначенийПоказателей", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УдалитьБланкДляОтображенияМногопериодный", "БланкДляОтображения");
		
	КонецЕсли;
	
	ЭлементыНастройкиОтчета = Новый Массив;
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.БланкДляОтображения);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.БланкДляИмпорта);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.БланкСводнойТаблицы);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.СпособФормированияОтчета);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.ПравилоОбработки);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.ПравилоПроверки);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.ВнешняяИнформационнаяБаза);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.ПериодичностьСвертывания);
	ЭлементыНастройкиОтчета.Добавить(Перечисления.ЭлементыНастройкиОтчета.УдалитьБланкДляОтображенияМногопериодный);

	Запрос.УстановитьПараметр("ЭлементыНастройкиОтчета", ЭлементыНастройкиОтчета);
	
	тДанныеРегистра = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = РегистрыСведений.НастройкиОбработкиШаблоновДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(тДанныеРегистра);
	НаборЗаписей.Записать();
	
	// Очистим данные старого регистра
	НаборЗаписей = РегистрыСведений.УдалитьНастройкаОбработкиОтчетов.СоздатьНаборЗаписей();
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Процедура ПеренестиНастройкиОбработкиЭкземпляровОтчетов(Параметры=Неопределено) Экспорт
	
