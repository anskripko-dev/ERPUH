Процедура ПерейтиНаНаправлениеДеятельностиМСФО(Параметры = Неопределено) Экспорт

	Если ОбщегоНазначения.ПодсистемаСуществует("ПереопределяемыеОбъектыУП") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьМД = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать;
	
	РеквизитНД = Метаданные.ОбщиеРеквизиты.Найти("НаправлениеДеятельностиМСФО");
	Если РеквизитНД = Неопределено Тогда
		Возврат;//в ЕРПУХ нет НДМСФО в справочниках
	КонецЕсли;
	
	МетаданныеНД = Новый Массив;
	Для каждого й Из РеквизитНД.Состав Цикл
		Если (й.Использование = ИспользоватьМД) 
			И (й.Метаданные.Реквизиты.Найти("Удалить_НаправлениеДеятельности") <> Неопределено) Тогда
			МетаданныеНД.Добавить(й.Метаданные.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	
	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НематериальныеАктивы КАК т
	|ГДЕ
	|	т.Удалить_НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|	И т.НаправлениеДеятельностиМСФО = ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)";
	
	Для каждого й Из МетаданныеНД Цикл
		
		ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "Справочник.НематериальныеАктивы", й);
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
	
		Пока Выборка.Следующий() Цикл
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.НаправлениеДеятельностиМСФО = Объект.Удалить_НаправлениеДеятельности;
			ЗаписатьОбъект(Объект);
			
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры 

