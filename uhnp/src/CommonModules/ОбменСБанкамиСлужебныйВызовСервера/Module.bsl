Функция СообщенияОбменаПоСтатусам(МассивДокументов, МассивСтатусов)
	
	ВозвращаемыйМассивДокументов = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СообщениеОбменСБанками.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СообщениеОбменСБанками КАК СообщениеОбменСБанками
	|ГДЕ
	|	СообщениеОбменСБанками.Статус В(&МассивСтатусов)
	|	И СообщениеОбменСБанками.Ссылка В(&МассивДокументов)";
