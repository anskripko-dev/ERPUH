#Область СохраняемыеНастройкиПользователяДиректБанк

// Сохраняет настройку пользователя в ХранилищеОбщихНастроек для настроек по 1С:ДиректБанк
//
// Параметры:
//  ИдентификаторКлиента  - УникальныйИдентификатор - Идентификатор полученный из функции СистемнаяИнформация.ИдентификаторКлиента
//  КлючНастроек  - Строка - раздел настроек (блок информации), информацию по которому необходимо сохранить в настройках
//  ИмяПараметра - Строка - имя параметра, информацию по которому необходимо сохранить в настройках в разделе КлючНастроек
//  ЗначениеПараметра  - Любое значение - значение параметра, информацию по которому необходимо сохранить в настройках в разделе КлючНастроек
//
Процедура СохранитьНастройкуПользователяДиректБанк(ИдентификаторКлиента, КлючНастроек, ИмяПараметра, ЗначениеПараметра) Экспорт
	
	КлючОбъекта = "НастройкиДиректБанка";
	Если КлючНастроек = "VPNKeyTLS" Тогда
		
		НастройкиДиректБанкаVPNKeyTLSСохраненные = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, КлючНастроек);
		НастройкиДиректБанкаVPNKeyTLSТекущие = НовыеНастройкиДиректБанкаVPNKeyTLS();
		Если ТипЗнч(НастройкиДиректБанкаVPNKeyTLSСохраненные) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(НастройкиДиректБанкаVPNKeyTLSТекущие, НастройкиДиректБанкаVPNKeyTLSСохраненные);
		КонецЕсли;
		
		Если ИмяПараметра = "ИспользоватьАвтоматическоеОпределениеWindows7" Тогда
			НастройкиДиректБанкаVPNKeyTLSТекущие.ИспользоватьАвтоматическоеОпределениеWindows7 = ЗначениеПараметра;
		ИначеЕсли ИмяПараметра = "ВерсииWindowsКлиентскихПриложений" Тогда
			НастройкиДиректБанкаVPNKeyTLSТекущие.ВерсииWindowsКлиентскихПриложений.Вставить(ИдентификаторКлиента, ЗначениеПараметра);
		ИначеЕсли ИмяПараметра = "ОчиститьВерсииWindowsКлиентскихПриложений" Тогда
			НастройкиДиректБанкаVPNKeyTLSТекущие.ВерсииWindowsКлиентскихПриложений.Очистить();
		КонецЕсли;
		
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючОбъекта, КлючНастроек, НастройкиДиректБанкаVPNKeyTLSТекущие);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает настройку пользователя из ХранилищеОбщихНастроек для настроек по 1С:ДиректБанк
//
// Параметры:
//  ИдентификаторКлиента  - УникальныйИдентификатор - Идентификатор полученный из функции СистемнаяИнформация.ИдентификаторКлиента
//  КлючНастроек  - Строка - раздел настроек (блок информации), информация по которому содержится в настройках
//  ИмяПараметра - Строка - имя параметра, информация по которому содержится в настройках в разделе КлючНастроек
//
// Возвращаемое значение:
//  ЗначениеПараметра  - Любое значение - значение параметра, информация по которому содержится в настройках в разделе КлючНастроек,
//   если такие КлючНастроек или ИмяПараметра не найдены, то возвращается Неопределено
//
Функция ПолучитьНастройкуПользователяДиректБанк(ИдентификаторКлиента, КлючНастроек, ИмяПараметра) Экспорт
	
	ЗначениеПараметра = Неопределено;
	КлючОбъекта = "НастройкиДиректБанка";
	Если КлючНастроек = "VPNKeyTLS" Тогда
		
		НастройкиДиректБанкаVPNKeyTLSСохраненные = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, КлючНастроек);
		НастройкиДиректБанкаVPNKeyTLSТекущие = НовыеНастройкиДиректБанкаVPNKeyTLS();
		Если ТипЗнч(НастройкиДиректБанкаVPNKeyTLSСохраненные) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(НастройкиДиректБанкаVPNKeyTLSТекущие, НастройкиДиректБанкаVPNKeyTLSСохраненные);
		КонецЕсли;
		
		Если ИмяПараметра = "ИспользоватьАвтоматическоеОпределениеWindows7" Тогда
			ЗначениеПараметра = НастройкиДиректБанкаVPNKeyTLSТекущие.ИспользоватьАвтоматическоеОпределениеWindows7;
		ИначеЕсли ИмяПараметра = "ВерсииWindowsКлиентскихПриложений" Тогда
			ЗначениеПараметра = НастройкиДиректБанкаVPNKeyTLSТекущие.ВерсииWindowsКлиентскихПриложений.Получить(ИдентификаторКлиента);
		КонецЕсли;
		
	КонецЕсли;
	Возврат ЗначениеПараметра;
	
КонецФункции

Функция НовыеНастройкиДиректБанкаVPNKeyTLS()
	
	СтруктураНастройкиДиректБанкаVPNKeyTLS = Новый Структура;
