Функция ПодготовитьПараметрыКПодписаниюПоSMS(МассивСсылокНаОбъект, НастройкаОбмена = Неопределено) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	СообщенияОбменаКПодписаниюКодомИзSMS = СообщенияОбменаИзДокументовКПодписаниюКодомИзSMS(МассивСсылокНаОбъект);
	Если СообщенияОбменаКПодписаниюКодомИзSMS.Количество() <> 0 Тогда
			
		ДополнительныеПараметры.Вставить("СообщенияОбменаКПодписаниюКодомИзSMS", СообщенияОбменаКПодписаниюКодомИзSMS);
		Если НастройкаОбмена = Неопределено Тогда
			
			СсылкаНаДокумент = СообщенияОбменаКПодписаниюКодомИзSMS[0];
			НастройкаОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаДокумент, "НастройкаОбмена");
			ДополнительныеПараметры.Вставить("НастройкаОбмена", НастройкаОбмена);
			
		КонецЕсли;
		РаспределитьДокументыПоСтатусам(ДополнительныеПараметры);
			
	КонецЕсли;
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

// Формирует массив сообщений которые необходимо будет подписать по SMS из полученного массива сообщений.
//
// Параметры:
//   МассивСообщенийОбмена - Массив из ДокументСсылка.СообщениеОбменСБанками - массив сообщений
//    из которого нужно выбрать только те, которые нужно будет подписать по SMS;  
//
// Возвращаемое значение:
//   Массив из ДокументСсылка.СообщениеОбменСБанками - массив сообщений, формируемый процедурой
//
Функция СообщенияОбменаКПодписаниюКодомИзSMS(МассивСообщенийОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СообщениеОбменСБанками.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СообщениеОбменСБанками КАК СообщениеОбменСБанками
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиОбменСБанками.ИсходящиеДокументы КАК НастройкиОбменСБанкамиИсходящиеДокументы
	|		ПО СообщениеОбменСБанками.ВидЭД = НастройкиОбменСБанкамиИсходящиеДокументы.ИсходящийДокумент
	|			И СообщениеОбменСБанками.НастройкаОбмена = НастройкиОбменСБанкамиИсходящиеДокументы.Ссылка
	|ГДЕ
	|	СообщениеОбменСБанками.Ссылка В(&МассивСообщенийОбмена)
	|	И НастройкиОбменСБанкамиИсходящиеДокументы.СпособПодтвержденияДокумента = ЗНАЧЕНИЕ(Перечисление.СпособыПодтвержденияДокументовОбменСБанками.SMS)";
	Запрос.УстановитьПараметр("МассивСообщенийОбмена", МассивСообщенийОбмена);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Формирует массив сообщений которые необходимо будет подписать по SMS из полученного массива документов.
//
// Параметры:
//   МассивДокументов - Массив из ДокументСсылка.СообщениеОбменСБанками - массив платежных документов
//    из которого нужно выбрать связанные сообщения обмена и только те, которые нужно будет подписать по SMS;
//
// Возвращаемое значение:
//   Массив из ДокументСсылка.СообщениеОбменСБанками - массив сообщений, формируемый процедурой
//
Функция СообщенияОбменаИзДокументовКПодписаниюКодомИзSMS(МассивДокументов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СостоянияОбменСБанками.СообщениеОбмена КАК Ссылка
	|ИЗ
	|	РегистрСведений.СостоянияОбменСБанками КАК СостоянияОбменСБанками
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиОбменСБанками.ИсходящиеДокументы КАК
	|			НастройкиОбменСБанкамиИсходящиеДокументы
	|		ПО СостоянияОбменСБанками.СообщениеОбмена.ВидЭД = НастройкиОбменСБанкамиИсходящиеДокументы.ИсходящийДокумент
	|		И СостоянияОбменСБанками.СообщениеОбмена.НастройкаОбмена = НастройкиОбменСБанкамиИсходящиеДокументы.Ссылка
	|ГДЕ
	|	НастройкиОбменСБанкамиИсходящиеДокументы.СпособПодтвержденияДокумента = ЗНАЧЕНИЕ(Перечисление.СпособыПодтвержденияДокументовОбменСБанками.SMS)
	|	И СостоянияОбменСБанками.СсылкаНаОбъект В (&МассивДокументов)
	|	И СостоянияОбменСБанками.СообщениеОбмена.ПрограммаБанка = ЗНАЧЕНИЕ(Перечисление.ПрограммыБанка.АсинхронныйОбмен)";
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Возвращает доступность подписания указанного вида электронного документа для указанной настройки обмена
//
// Параметры:
//  ВидЭД - ПеречислениеСсылка.ВидыЭДОбменСБанками - вид документа, для которого определяется доступность подписания.
//  НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками - настройка обмена с банком.
//
// Возвращаемое значение:
//  Булево - доступность подписания по SMS.
//
Функция ДоступноПодписаниеПоSMS(ВидЭД, НастройкаОбмена) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиОбменСБанкамиИсходящиеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НастройкиОбменСБанками.ИсходящиеДокументы КАК НастройкиОбменСБанкамиИсходящиеДокументы
	|ГДЕ
	|	НастройкиОбменСБанкамиИсходящиеДокументы.ИсходящийДокумент = &ИсходящийДокумент
	|	И НастройкиОбменСБанкамиИсходящиеДокументы.СпособПодтвержденияДокумента = ЗНАЧЕНИЕ(Перечисление.СпособыПодтвержденияДокументовОбменСБанками.SMS)
	|	И НастройкиОбменСБанкамиИсходящиеДокументы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("ИсходящийДокумент", ВидЭД);
	Запрос.УстановитьПараметр("Ссылка", НастройкаОбмена);
	Возврат ?(Запрос.Выполнить().Пустой(), Ложь, Истина);
	
КонецФункции

// Распределяет только что отправленные документы по массивам для дальнейшей обработки, при подписании по SMS
//
Процедура РаспределитьДокументыПоСтатусам(ДополнительныеПараметры)
	
	// Разделим документы, которые уже могут быть подписаны, или уже в статусе ТребуетсяПодтверждение
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыОбменСБанками.Отправлен"));
	МассивСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыОбменСБанками.Доставлен"));
	СообщенияОбменаДоСтатусаНеПодтвержден = СообщенияОбменаПоСтатусам(
		ДополнительныеПараметры.СообщенияОбменаКПодписаниюКодомИзSMS, МассивСтатусов);
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыОбменСБанками.НеПодтвержден"));
	СообщенияОбменаВСтатусеНеПодтвержден = СообщенияОбменаПоСтатусам(
		ДополнительныеПараметры.СообщенияОбменаКПодписаниюКодомИзSMS, МассивСтатусов);
		
	ДополнительныеПараметры.Вставить("СообщенияОбменаДоСтатусаНеПодтвержден", СообщенияОбменаДоСтатусаНеПодтвержден);
	ДополнительныеПараметры.Вставить("СообщенияОбменаВСтатусеНеПодтвержден", СообщенияОбменаВСтатусеНеПодтвержден);
	ДополнительныеПараметры.Вставить("СообщенияОбменаВСтатусеПодтвержден", Новый Массив);
	ДополнительныеПараметры.Вставить("ДокументыОтклоненныеБанком", Новый Массив);
	ДополнительныеПараметры.Вставить("КоличествоСекунд", 1);
	
КонецПроцедуры

// Определяет возможность подписания по SMS документов находящихся в ДополнительныеПараметры и подготавливает
//  необходимые параметры 
//
// Параметры:
//  РезультатОперации -Структура - результат выполнения фонового задания ОбменСБанкамиСлужебный.СформироватьИОтправитьПакетыВБанк
//  МассивСсылокНаОбъект - Массив Из ДокументСсылка - объект информационной базы
//  ИмяПроцедурыПослеПодтвержденияКодомИзSMS - Строка - 
//   ОбменСБанкамиСлужебныйКлиент.ПослеОтправкиПлатежныхДокументовВБанк
//  СообщениеОбмена - ДокументСсылка.СообщениеОбменСБанками.
//
// Возвращаемое значение:
//  Структура - параметры необходимые для подписания по SMS
//
Функция ВозможноПодписаниеПоSMS(РезультатОперации, МассивСсылокНаОбъект, ИмяПроцедурыПослеПодтвержденияКодомИзSMS, СообщениеОбмена) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВозможноПодписаниеПоSMS", Ложь);
	
	Если ЗначениеЗаполнено(СообщениеОбмена) И ЭтоЗапросНаОтзывЭД(СообщениеОбмена) Тогда
		
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(СообщениеОбмена);
		СообщенияОбменаКПодписаниюКодомИзSMS = СообщенияОбменаКПодписаниюКодомИзSMS(МассивДокументов);
		Если СообщенияОбменаКПодписаниюКодомИзSMS.Количество() > 0 Тогда
			ДополнительныеПараметры.Вставить("ЗапросНаОтзывЭД", СообщениеОбмена);
		КонецЕсли;
		
	Иначе
		
		СообщенияОбменаКПодписаниюКодомИзSMS = СообщенияОбменаКПодписаниюКодомИзSMS(
			РезультатОперации.ОтправленныеСообщенияОбмена);
		
		СообщенияОбменаИзДокументовКПодписаниюКодомИзSMS =
			СообщенияОбменаИзДокументовКПодписаниюКодомИзSMS(
				МассивСсылокНаОбъект);
				
		МассивСтатусов = Новый Массив;
		МассивСтатусов.Добавить(Перечисления.СтатусыОбменСБанками.НеПодтвержден);
		СообщенияОбменаВСтатусеНеПодтвержден = СообщенияОбменаПоСтатусам(
			СообщенияОбменаИзДокументовКПодписаниюКодомИзSMS,
			МассивСтатусов);
			
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СообщенияОбменаКПодписаниюКодомИзSMS,
			СообщенияОбменаВСтатусеНеПодтвержден);
		
	КонецЕсли;
	
	Если СообщенияОбменаКПодписаниюКодомИзSMS.Количество() > 0 Тогда
		
		ДополнительныеПараметры.Вставить("СообщенияОбменаКПодписаниюКодомИзSMS",
			СообщенияОбменаКПодписаниюКодомИзSMS);
		ДополнительныеПараметры.Вставить("ИмяПроцедурыПослеПодтвержденияКодомИзSMS",
			ИмяПроцедурыПослеПодтвержденияКодомИзSMS);
		ДополнительныеПараметры.Вставить("РезультатОперацииПослеПодтвержденияКодомИзSMS", РезультатОперации);
		РаспределитьДокументыПоСтатусам(ДополнительныеПараметры);
		
		ДополнительныеПараметры.Вставить("ВозможноПодписаниеПоSMS", Истина);
		
	КонецЕсли;
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

// Определяет, что ВидЭД у СообщениеОбмена равен ЗапросНаОтзывЭД
//
// Параметры:
//  СообщениеОбмена -ДокументСсылка.СообщениеОбменСБанками - ссылка на сообщение обмена
//
// Возвращаемое значение:
//  Булево - признак, что ВидЭД у СообщениеОбмена равен ЗапросНаОтзывЭД
//
Функция ЭтоЗапросНаОтзывЭД(СообщениеОбмена) Экспорт
	
	ЭтоЗапросНаОтзывЭД = Ложь;
	ВидЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СообщениеОбмена, "ВидЭД");
	Если ВидЭД = Перечисления.ВидыЭДОбменСБанками.ЗапросНаОтзывЭД Тогда
		ЭтоЗапросНаОтзывЭД = Истина;
	КонецЕсли;
	
	Возврат ЭтоЗапросНаОтзывЭД;
	
КонецФункции

