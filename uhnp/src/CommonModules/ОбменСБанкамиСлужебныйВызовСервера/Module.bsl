КонецФункции

// Получает реквизиты банковского счета организации.
//
// Параметры:
//  Ссылка - ОпределяемыйТип.СчетОрганизацииОбменСБанками - ссылка на банковскийСчетОрганизации
// 
// Возвращаемое значение:
//  Структура - реквизиты счета. Содержит поля:
//   * Организация - ОпределяемыйТип.Организация - ссылка на организацию.
//   * Банк - ОпределяемыйТип.БанкОбменСБанками - ссылка на банк.
//   * НомерСчета - Строка - номер счета.
//
Функция РеквизитыБанковскогоСчетаОрганизации(Знач Ссылка)
	
	ВозвращаемоеЗначение = Новый Структура("Организация, Банк, НомерСчета");
	
	НазваниеРеквизитаОрганизация = ОбменСБанкамиСлужебный.ИмяПрикладногоРеквизита(
		"БанковскийСчетОрганизации.Организация");
	НазваниеРеквизитаБанк = ОбменСБанкамиСлужебный.ИмяПрикладногоРеквизита("БанковскийСчетОрганизации.Банк");
	НазваниеРеквизитаНомерСчета = ОбменСБанкамиСлужебный.ИмяПрикладногоРеквизита("БанковскийСчетОрганизации.НомерСчета");
	
	ЗначенияРеквизитовОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Ссылка, НазваниеРеквизитаОрганизация + "," + НазваниеРеквизитаБанк + "," + НазваниеРеквизитаНомерСчета);
	
	ЗначенияРеквизитовОснование.Свойство(НазваниеРеквизитаОрганизация, ВозвращаемоеЗначение.Организация);
	ЗначенияРеквизитовОснование.Свойство(НазваниеРеквизитаБанк, ВозвращаемоеЗначение.Банк);
	ЗначенияРеквизитовОснование.Свойство(НазваниеРеквизитаНомерСчета, ВозвращаемоеЗначение.НомерСчета);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Получает реквизиты банковского счета организации.
//
// Параметры:
//  Ссылка - СправочникСсылка.НастройкиОбменСБанками - ссылка на настройку обмена организации с банком
// 
// Возвращаемое значение:
//  Структура - реквизиты счета. Содержит поля:
//   * Организация - ОпределяемыйТип.Организация - ссылка на организацию.
//   * Банк - ОпределяемыйТип.БанкОбменСБанками - ссылка на банк.
//   * НомерСчета - Неопределено.
//   * НастройкаОбмена - СправочникСсылка.НастройкиОбменСБанками - ссылка на переданную в параметрах настройку обмена.
//
Функция РеквизитыНастройкиОбмена(Знач Ссылка)
	
	// Номер счета не заполняется - если там будет Неопределено, то запрос выписки будет выполнен по всем счетам банка.
	
	ВозвращаемоеЗначение = Новый Структура("Организация, Банк, НомерСчета, НастройкаОбмена");
	
	ВозвращаемоеЗначение.НастройкаОбмена = Ссылка;
	
	ЗначенияРеквизитовОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Организация, Банк");
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, ЗначенияРеквизитовОснование);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает название банка из документа ПисьмоОбменСБанками.
//
// Параметры:
//  БанкСсылка - ОпределяемыйТип.БанкОбменСБанками
// 
// Возвращаемое значение:
//  Строка
//
Функция РеквизитНаименованиеБанка(БанкСсылка)
	
	НазваниеРеквизитаБанк = ОбменСБанкамиСлужебный.ИмяПрикладногоРеквизита("Банк.Наименование"); 
	ЗначениеРеквизитаОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БанкСсылка, НазваниеРеквизитаБанк);
	
	Если ЗначениеРеквизитаОбъекта = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат ЗначениеРеквизитаОбъекта;
	КонецЕсли;
	
КонецФункции

