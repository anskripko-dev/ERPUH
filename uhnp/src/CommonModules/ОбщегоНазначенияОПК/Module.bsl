
#Область ПрограммныйИнтерфейс

// Функция возвращает Функциональные направления, статьи которых доступны для данного ЦФО.
//
// Параметры:
//  ЦФО	 - 	СправочникСсылка.Организации - ЦФО, для которого определяются функциональные направления.
// 
// Возвращаемое значение:
//  Массив - массив элементов
//
Функция ФункциональныеНаправленияЦФО(Знач ЦФО) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЦФО) Тогда
		Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.ФункциональныеНаправления.ПустаяСсылка());
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЦФО);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФункциональныеНаправления.Ссылка
	|ИЗ
	|	Справочник.ФункциональныеНаправления КАК ФункциональныеНаправления
	|ГДЕ
	|	ФункциональныеНаправления.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				Организации.ФункциональноеНаправление
	|			ИЗ
	|				Справочник.Организации КАК Организации
	|			ГДЕ
	|				Организации.Ссылка = &Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ФункциональныеНаправления.ПустаяСсылка)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ПредставлениеПериодовСКД

Функция ПредставлениеПолугодия(Дата) Экспорт
	Возврат Формат(Дата, СтрШаблон("ДФ='''%1 полугодие'' yyyy ''г.'''", Полугодие(Дата)));
КонецФункции

Функция ПредставлениеНеделяГода(Дата) Экспорт
	ПредставлениеНедели = Формат(Дата, СтрШаблон("ДФ='''%1 нелеля'' yyyy ''г.'''", НеделяГода(Дата)));
	НачалоНедели = Формат(НачалоНедели(Дата), "ДФ=dd.MM");
	ОкончаниеНедели = Формат(КонецНедели(Дата), "ДФ=dd.MM");
	Возврат СтрШаблон(НСтр("ru = '%1 (%2-%3)'"), ПредставлениеНедели, НачалоНедели, ОкончаниеНедели);
КонецФункции

Функция ПредставлениеДекадаГода(Дата) Экспорт
	Возврат Формат(Дата, СтрШаблон("ДФ='''%1 декада'' yyyy ''г.'''", ДекадаГода(Дата)));
КонецФункции

Функция ПредставлениеПериодаПоПериодичности(Дата, Периодичность) Экспорт
	
	Если Периодичность = Перечисления.Периодичность.Год Тогда
		Возврат Формат(Дата, "ДФ='yyyy ''г.'''");
	ИначеЕсли Периодичность = Перечисления.Периодичность.Полугодие Тогда
		Возврат ПредставлениеПолугодия(Дата);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Квартал Тогда
		Возврат Формат(Дата, "ДФ='q ''квартал ''yyyy ''г.'''");
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда
		Возврат Формат(Дата, "ДФ='MMMM yyyy ''г.'");
	ИначеЕсли Периодичность = Перечисления.Периодичность.Декада Тогда
		Возврат ПредставлениеДекадаГода(Дата);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Неделя Тогда
		Возврат ПредставлениеНеделяГода(Дата);
	Иначе // День
		Возврат Формат(Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
КонецФункции

// Устарела. Следует использовать ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаЛимитирования 
Функция ПредставлениеПериодаЛимитирования(Дата, Периодичность) Экспорт
	Возврат ПредставлениеПериодаПоПериодичности(Дата, Периодичность);
КонецФункции

#КонецОбласти

