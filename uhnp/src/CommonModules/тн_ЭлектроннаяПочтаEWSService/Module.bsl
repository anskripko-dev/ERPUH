// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ОтправитьСообщениеЧерезEWSService(Знач УчетнаяЗапись, Знач ПараметрыПисьма, Знач ТекущийПользователь, Знач Соединение = Неопределено) Экспорт
	
	// Переменные содержат значения переданных в функцию параметров.
	Перем Кому, Тема, Тело, Вложения, АдресОтвета, ТипТекста, Копии, СлепыеКопии, Пароль;
	
	
	Если Соединение = Неопределено Тогда		
		Соединение = ПолучитьСоединениеEWSService(УчетнаяЗапись);		
	КонецЕсли; 
	
	ФабрикаEWSService = Соединение.ФабрикаXDTO;
	apiKey = УчетнаяЗапись.тн_apiKeyEWSService;
	
	Письмо = ПолучитьПисьмоEWSService(ФабрикаEWSService);
	Письмо.Subject = ПараметрыПисьма.Тема;
	
	// формируем адрес получателя	
	Для Каждого ПочтовыйАдресПолучателя Из ПараметрыПисьма.Получатели Цикл
		Получатель = Письмо.Recipients.string.Добавить(ПочтовыйАдресПолучателя.Адрес);
	КонецЦикла;
	
	// формируем адрес получателя поля Копии
	Для Каждого ПочтовыйАдресПолучателяКопии Из ПараметрыПисьма.Копии Цикл
		Получатель = Письмо.CopyTo.string.Добавить(ПочтовыйАдресПолучателяКопии.Адрес);
	КонецЦикла;
	
	// формируем адрес получателя поля Копии
	Для Каждого ПочтовыйАдресПолучателяСлепыеКопии Из ПараметрыПисьма.СлепыеКопии Цикл
		Получатель = Письмо.BlindCopyTo.string.Добавить(ПочтовыйАдресПолучателяСлепыеКопии.Адрес);
	КонецЦикла;
	
	// формируем адрес ответа, если необходимо
	Для Каждого ПочтовыйАдресОтвета Из ПараметрыПисьма.ОбратныйАдрес Цикл
		Письмо.From = ПочтовыйАдресОтвета.Адрес;
		Прервать;
	КонецЦикла;
	
	// получение реквизитов отправителя
	РеквизитыОтправителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись, "Наименование,АдресЭлектроннойПочты");
	
	// добавляем к письму имя отправителя
	Если ТипЗнч(ПараметрыПисьма.Отправитель) = Тип("ИнтернетПочтовыйАдрес") И ЗначениеЗаполнено(ПараметрыПисьма.Отправитель.Адрес) Тогда
		Письмо.Sender = ПараметрыПисьма.Отправитель.Адрес;
	ИначеЕсли ТипЗнч(ПараметрыПисьма.Отправитель) = Тип("Строка") И Не ПустаяСтрока(ПараметрыПисьма.Отправитель) Тогда
		Письмо.Sender = ПараметрыПисьма.Отправитель;
	Иначе 
		Письмо.Sender = РеквизитыОтправителя.АдресЭлектроннойПочты;
	КонецЕсли;
	
	// добавляем вложения к письму
	Для Каждого ЭлементВложение Из ПараметрыПисьма.Вложения Цикл
		НовоеВложение = ПолучитьВложениеEWSService(ФабрикаEWSService);
		НовоеВложение.Content = ЭлементВложение.Данные;
		НовоеВложение.Name = ЭлементВложение.ИмяФайла;
		НовоеВложение.ContentId = ЭлементВложение.Идентификатор;				
		
		Письмо.Attachments.Attachment.Добавить(НовоеВложение);
	КонецЦикла;
	
	// НАЧАЛО Ситалов Дмитрий 28.03.2023 Выполнение задач №000044972
	IsHTML = Ложь;
	// КОНЕЦ  Ситалов Дмитрий 28.03.2023 Выполнение задач №000044972
	
	Тело = "";
	Для Каждого ТекстПочтовогоСообщения Из ПараметрыПисьма.Тексты Цикл 
		
		Тело = Тело + ТекстПочтовогоСообщения.Текст;
		
		// НАЧАЛО Ситалов Дмитрий 28.03.2023 Выполнение задач №000044972
		Если ТекстПочтовогоСообщения.ТипТекста = ТипТекстаПочтовогоСообщения.HTML Тогда
			IsHTML = Истина;
		КонецЕсли;
		// КОНЕЦ  Ситалов Дмитрий 28.03.2023 Выполнение задач №000044972
		
	КонецЦикла;
	
	// НАЧАЛО Ситалов Дмитрий 28.03.2023 Выполнение задач №000044972
	Письмо.IsHTML = IsHTML;
	// КОНЕЦ  Ситалов Дмитрий 28.03.2023 Выполнение задач №000044972
	
	Письмо.Body = Тело;
	
	// Зададим важность
	Важность = ПараметрыПисьма.Важность;
	Если Важность = ВажностьИнтернетПочтовогоСообщения.Высокая
		Или Важность = ВажностьИнтернетПочтовогоСообщения.Наивысшая Тогда
		Письмо.Importance = 2;
	ИначеЕсли Важность = ВажностьИнтернетПочтовогоСообщения.Низкая
		Или Важность = ВажностьИнтернетПочтовогоСообщения.Наименьшая Тогда
		Письмо.Importance = 0;
	Иначе
		Письмо.Importance = 1;
	КонецЕсли;
	
	Если ПараметрыПисьма.УведомитьОДоставке Тогда
		Письмо.IsDeliveryReceiptRequested = ПараметрыПисьма.УведомитьОДоставке;
	КонецЕсли;
	
	Если ПараметрыПисьма.УведомитьОПрочтении Тогда
		Письмо.IsReadReceiptRequested = ПараметрыПисьма.УведомитьОПрочтении;
	КонецЕсли;
	
	МожноОтправлять = ПроверитьПравильностьЗаполнения(Письмо);
	Если МожноОтправлять Тогда
		Рез = SendMessage(Соединение, Письмо, apikey, УчетнаяЗапись);
	Иначе	
		Рез = неопределено;
	КонецЕсли;
	
	Соединение = Неопределено;
	
	Если МожноОтправлять И Рез.IsError Тогда
		Возврат Рез.ErrorMessage;
	ИначеЕсли Не МожноОтправлять Тогда 
		Возврат "Неправильно заполнено письмо";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ПолучитьИдентификаторИнформационнойБазы()
	
	СтрокаПольз = ИмяПользователя();
	СтрокаСлужебнаяИнформация = СтрокаСоединенияИнформационнойБазы() + " " + ?(СтрокаПольз = Неопределено, "Пользователь неопределен", СтрокаПольз) + ", "+ ИмяКомпьютера();
	Возврат СтрокаСлужебнаяИнформация;
	
КонецФункции

// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ПроверитьПравильностьЗаполнения(Письмо)
	
	Если ПустаяСтрока(Письмо.Subject) Тогда  // тема
		Возврат Ложь;
	ИначеЕсли (ПустаяСтрока(Письмо.Sender) И Не ПустаяСтрока(Письмо.From)) Или (ПустаяСтрока(Письмо.Sender) И ПустаяСтрока(Письмо.From)) Тогда // отправитель
		Возврат Ложь;
	ИначеЕсли Письмо.Recipients.string.Количество() = 0 Тогда // получатель 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

