// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ПолучитьПрофильEWSService(ФабрикаXDTO, УчетнаяЗапись) Экспорт
	
	URI = "http://schemas.datacontract.org/2004/07/EWSService";
	CredentialsТип = ФабрикаXDTO.Тип(URI, "Credentials");
	
	Credential = ФабрикаXDTO.Создать(CredentialsТип);
	Credential.UserName = УчетнаяЗапись.тн_ЛогинEWSService;
	Credential.Password = УчетнаяЗапись.тн_ПарольEWSService;
	
	Возврат Credential;
	
КонецФункции

// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ПолучитьСтандартнуюПапкуEWSService(ФабрикаXDTO, Знач ИмяПапки = "Входящие") Экспорт
	
	Если ИмяПапки = "Входящие" Тогда
		ИмяПапки = "Inbox";
	ИначеЕсли ИмяПапки = "Исходящие" Тогда
		ИмяПапки = "Outbox";
	ИначеЕсли ИмяПапки = "Отправленные" Тогда
		ИмяПапки = "SentItems";
	ИначеЕсли ИмяПапки = "Черновики" Тогда
		ИмяПапки = "Junk";
	КонецЕсли; 
	
	URI = "http://schemas.datacontract.org/2004/07/EWSService";
	KnownFolderТип = ФабрикаXDTO.Тип(URI, "KnownFolder");
	Папка = ФабрикаXDTO.Создать(KnownFolderТип, ИмяПапки);
	
	Возврат Папка;
	
КонецФункции

// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ПолучитьПисьмоEWSService(ФабрикаXDTO) Экспорт
	
	URI = "http://schemas.datacontract.org/2004/07/EWSService";
	EmailMessageТип = ФабрикаXDTO.Тип(URI, "EmailMessage");
	EmailMessage = ФабрикаXDTO.Создать(EmailMessageТип);
	ArrayOfAttachmentТип = ФабрикаXDTO.Тип(URI, "ArrayOfAttachment");
	
	URI = "http://schemas.microsoft.com/2003/10/Serialization/Arrays";
	ArrayOfstringТип = ФабрикаXDTO.Тип(URI, "ArrayOfstring");
	
	МассивПолучатели = ФабрикаXDTO.Создать(ArrayOfstringТип);
	EmailMessage.Recipients = МассивПолучатели;
	МассивКопии = ФабрикаXDTO.Создать(ArrayOfstringТип);
	EmailMessage.CopyTo = МассивКопии;
	МассивСлепыеКопии = ФабрикаXDTO.Создать(ArrayOfstringТип);
	EmailMessage.BlindCopyTo = МассивСлепыеКопии;
	
	МассивВложения = ФабрикаXDTO.Создать(ArrayOfAttachmentТип);
	EmailMessage.Attachments = МассивВложения;
	
	Возврат EmailMessage;
	
КонецФункции

