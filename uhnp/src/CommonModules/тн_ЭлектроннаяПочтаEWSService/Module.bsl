				ТекстОшибок = ТекстОшибок + Символы.ПС + (Строка(УчетнаяЗапись) + ". Попытка " + Строка(Сч) + " " + Рез.ErrorMessage); 
				// НАЧАЛО Белышев Игорь 23.12.2022 Выполнение задач №000043776
				ЗаписатьВЖурналРегистрации(Письмо,ТекстОшибок,Рез); 
				// КОНЕЦ Белышев Игорь 23.12.2022 Выполнение задач №000043776
			Иначе
