	Возврат Новый Структура("IsError, ErrorMessage", Истина, ТекстОшибок);
	
КонецФункции 

// НАЧАЛО Белышев Игорь 23.12.2022 Выполнение задач №000043776
Процедура ЗаписатьВЖурналРегистрации(Письмо,ТекстОшибок,Рез = Неопределено); 
	СтруктураДанных = Новый Структура("Письмо,Результат",Письмо,Рез); 
	
	МассивПолучателей = Новый Массив;
	Для Каждого ТекСтрока ИЗ Письмо.Recipients.string Цикл
		МассивПолучателей.Добавить(ТекСтрока);
	КонецЦикла;
	ТекстПолучатели = СтрСоединить(МассивПолучателей,";");
	Комментарий = ТекстОшибок + "Получаетели: " + ТекстПолучатели; 
	
	ЗаписьЖурналаРегистрации("ОтправкаПочты",?(ТекстОшибок = "",УровеньЖурналаРегистрации.Информация,УровеньЖурналаРегистрации.Ошибка),
	Метаданные.документы.ЭлектронноеПисьмоИсходящее,СтруктураДанных,Комментарий);

КонецПроцедуры

