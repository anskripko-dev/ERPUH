Функция BindKnownFolder(Прокси, ПапкаВходящие, apiKey, УчетнаяЗапись, ТекстОшибок = "")
	
	Сч = 0; ЕстьОшибка = Ложь;
	ПереподключатьсяВСлучаеОшибки = УчетнаяЗапись.тн_ПереподключатьсяВСлучаеОшибки;
	Пока Сч <= ПереподключатьсяВСлучаеОшибки Цикл
		Попытка
			Рез = Прокси.BindKnownFolder(ПапкаВходящие, apiKey);
			Если Рез.IsError Тогда				
				ТекстОшибок = ТекстОшибок + Символы.ПС + (Строка(УчетнаяЗапись) + ". Попытка " + Строка(Сч) + " " + Рез.ErrorMessage);
			Иначе
				Возврат Рез;
			КонецЕсли;
		Исключение
			ТекстОшибок = ТекстОшибок + Символы.ПС + (Строка(УчетнаяЗапись) + ". Попытка " + Строка(Сч) + " " + ОписаниеОшибки());
		КонецПопытки;
		Сч = Сч + 1;
	КонецЦикла; 
	
	Возврат Новый Структура("IsError, ErrorMessage", Истина, ТекстОшибок);
	
