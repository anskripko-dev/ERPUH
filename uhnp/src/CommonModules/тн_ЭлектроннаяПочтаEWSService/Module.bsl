// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Процедура ПолучениеПисемЧерезEWSService(УчетнаяЗапись, ТекущийПользователь, ТекстОшибок = Неопределено) Экспорт
	
	мРазделительАдресов = ",";
	
	// Пробуем подключиться
	Попытка
		Прокси = ПолучитьСоединениеEWSService(УчетнаяЗапись);
	Исключение
		ТекстОшибок = Символы.ПС + ТекстОшибок + (Строка(УчетнаяЗапись) + ". " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ФабрикаEWSService = Прокси.ФабрикаXDTO;
	apiKey = УчетнаяЗапись.тн_apiKeyEWSService;
	
	КоличествоНовыхПисем = 0;
	
	// Теперь проверим получение
	МассивПисемДляУдаления = Новый Массив;
	
	ОшибкаИсключенияТранзакции = "";
	
	ПапкаВходящие = ПолучитьСтандартнуюПапкуEWSService(ФабрикаEWSService);
	
	Рез = BindKnownFolder(Прокси, ПапкаВходящие, apiKey, УчетнаяЗапись, ТекстОшибок);
	Если Рез.IsError Тогда
		Возврат;
	КонецЕсли; 
	
	ПапкаВходящиеEWSService = Рез.Result;
	
	Рез = ListEmails(Прокси, ПапкаВходящиеEWSService.FolderId, apiKey, УчетнаяЗапись, ТекстОшибок);
	Если Рез.IsError Тогда
		Возврат;
	КонецЕсли; 
	
	МассивЗаголовковПисем = Рез.Result.Items.EmailMessage;
	
	КолвоЭлементовВМассиве = МассивЗаголовковПисем.Количество();
	
	Для ОбратныйИндекс = 1 По КолвоЭлементовВМассиве Цикл
		
		ЭлементМассива = МассивЗаголовковПисем[КолвоЭлементовВМассиве - ОбратныйИндекс];
		ИнтернетПисьмо = Новый Структура("ИдентификаторСообщения, ДатаОтправления", ПолучитьИдентификаторПисьма(ЭлементМассива.IMAPId), ЭлементМассива.Date);
	КонецЦикла;
	
	Если МассивЗаголовковПисем.Количество() > 0 Тогда
		
		МассивПисем = МассивЗаголовковПисем;
		
		ЭлементМассива = 0;
		
		Для Каждого ЭлементМассива Из МассивПисем Цикл
			
			ИнтернетПисьмо = Новый Структура("ИдентификаторСообщения", ПолучитьИдентификаторПисьма(ЭлементМассива.IMAPId));
			Если Не НадоПриниматьПисьмо(УчетнаяЗапись, ИнтернетПисьмо, МассивПисемДляУдаления) Тогда
				Продолжить;
			КонецЕсли; 
			
			КоличествоНовыхПисем = КоличествоНовыхПисем + 1;
			
			Рез = BindMessage(Прокси, ЭлементМассива.ItemId, apiKey, УчетнаяЗапись, ТекстОшибок);				
			Если Рез.IsError Тогда
				Продолжить;
			КонецЕсли;
			
			ИнтернетПисьмоEWSService = Рез.Result;
			
			ИсключениеТранзакции = Ложь;
			НачатьТранзакцию();
			
			ИнтернетПисьмо = ПолучитьСтруктуруПисьмаИзОбъектаEWSService(ИнтернетПисьмоEWSService, УчетнаяЗапись);
			
			Письмо = ПолучитьДокументОбъектИзИнтернетПочтовогоСообщения(ИнтернетПисьмо, УчетнаяЗапись, мРазделительАдресов, ИсключениеТранзакции);
			Если ТипЗнч(Письмо) <> Тип("ДокументОбъект.ЭлектронноеПисьмоВходящее") Тогда
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			Попытка
				Если НадоПриниматьПисьмо(УчетнаяЗапись, ИнтернетПисьмо, МассивПисемДляУдаления) Тогда
					Письмо.Записать(РежимЗаписиДокумента.Запись);
				Иначе
					ВызватьИсключение "	Письмо с ID " + ИнтернетПисьмо.ИдентификаторСообщения + " уже существует.";
				КонецЕсли;
			Исключение
				ИсключениеТранзакции = Истина;
				ОшибкаИсключенияТранзакции = ОписаниеОшибки();
				ОтменитьТранзакцию();
				Продолжить;
			КонецПопытки;
			
			// Вложения
			Если ИнтернетПисьмо.Вложения.Количество() > 0 И Не ИсключениеТранзакции Тогда
				Для Каждого Вложение Из ИнтернетПисьмо.Вложения Цикл
					Если Вложение.Данные = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НовоеВложение = Справочники.ЭлектронноеПисьмоВходящееПрисоединенныеФайлы.СоздатьЭлемент();
					Если Не ПустаяСтрока(Вложение.Идентификатор) Тогда
						Письмо.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTMLСКартинками;
					КонецЕсли; 
					
					НовоеВложение.ИДФайлаЭлектронногоПисьма = Вложение.Идентификатор;
					Если ТипЗнч(Вложение.Данные) = Тип("ИнтернетПочтовоеСообщение") Тогда
						НовоеВложение.Наименование = ?(ПустаяСтрока(Вложение.Имя), (ИнтернетПисьмо.ИдентификаторСообщения), Вложение.Имя) + ".msg";
					Иначе
						НовоеВложение.Наименование = Вложение.Имя;
					КонецЕсли; 
					
					БольшинствоГрафическихФорматов = ".bmp, .dib, .rle, .emf, .eps, .fpx, .gif, .ico, .cur, .ani, .jpg, .jpeg, .jpe, .jif, .jfif, .ag, .pcd, .pcx, .dcx, .pic, .png, .ppm, .psd, .ras, .tif, .tiff, .xif, .wmf, .pdf";
					РасширениеВложения = НРег(Прав(СокрЛП(НовоеВложение.Наименование),3));
					Если Найти(БольшинствоГрафическихФорматов, РасширениеВложения) > 0 Тогда
						НовоеВложение.Расширение = РасширениеВложения;
					КонецЕсли;
					
					НовоеВложение.ВладелецФайла	= Письмо.Ссылка;
					НовоеВложение.ФайлХранилище	= Новый ХранилищеЗначения(Вложение.Данные, Новый СжатиеДанных());

					Попытка
						НовоеВложение.Записать();
					Исключение
						ИсключениеТранзакции = Истина;
						ОшибкаИсключенияТранзакции = ОписаниеОшибки();
						Прервать;
					КонецПопытки;
				КонецЦикла;
				
				Если Не ИсключениеТранзакции Тогда
					
					ОчиститьПисьмо(ИнтернетПисьмо);
					
					Письмо.ПочтовоеСообщение = Новый ХранилищеЗначения(ИнтернетПисьмо, Новый СжатиеДанных());
					
					Попытка
						Письмо.Записать();
					Исключение
						ИсключениеТранзакции = Истина;
						ОшибкаИсключенияТранзакции = ОписаниеОшибки();
						ОтменитьТранзакцию();
						Прервать;
					КонецПопытки;
				Иначе
					ОтменитьТранзакцию();
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
			Если ИсключениеТранзакции Тогда
				ТекстОшибок = Символы.ПС + ТекстОшибок + (Строка(УчетнаяЗапись) + ". " + ОшибкаИсключенияТранзакции);
				ОтменитьТранзакцию();
				Продолжить;
			Иначе
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры

// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ЗагрузитьСообщенияЧерезEWSService(Знач УчетнаяЗапись, Знач ПараметрыЗагрузки = Неопределено) Экспорт
	
	// Используется для проверки возможности входа на почтовый ящик
	Перем РежимТестирования;
	
	// Получать только заголовки писем
	Перем ПолучениеЗаголовков;
	
	// Приводить почтовые сообщения к простому типу;
	Перем ПриводитьСообщенияКТипу;
	
	// Заголовки или идентификаторы писем, полные сообщения по которым требуется получить
	Перем ЗаголовкиИдентификаторы;
	
	Если ПараметрыЗагрузки.Свойство("РежимТестирования") Тогда
		РежимТестирования = ПараметрыЗагрузки.РежимТестирования;
	Иначе
		РежимТестирования = Ложь;
	КонецЕсли;
	
	Если ПараметрыЗагрузки.Свойство("ПолучениеЗаголовков") Тогда
		ПолучениеЗаголовков = ПараметрыЗагрузки.ПолучениеЗаголовков;
	Иначе
		ПолучениеЗаголовков = Ложь;
	КонецЕсли;
	
	Если ПараметрыЗагрузки.Свойство("apiKey") Тогда
		apiKey = ПараметрыЗагрузки.apiKey;
	Иначе
		apiKey = УчетнаяЗапись.тн_apiKeyEWSService;
	КонецЕсли;
	
	Если ПараметрыЗагрузки.Свойство("ЗаголовкиИдентификаторы") Тогда
		ЗаголовкиИдентификаторы = ПараметрыЗагрузки.ЗаголовкиИдентификаторы;
	Иначе
		ЗаголовкиИдентификаторы = Новый Массив;
	КонецЕсли;
	
	НаборСообщенийДляУдаления = Новый Массив;
	
	Прокси = ПолучитьСоединениеEWSService(УчетнаяЗапись);
	
	ФабрикаEWSService = Прокси.ФабрикаXDTO;
	
	ПапкаВходящие = ПолучитьСтандартнуюПапкуEWSService(ФабрикаEWSService);
	
	Рез = BindKnownFolder(Прокси, ПапкаВходящие, apiKey, УчетнаяЗапись);
	
	ПапкаВходящиеEWSService = Рез.Result;
	
	Если РежимТестирования Или ПолучениеЗаголовков Тогда
		
		Рез = ListEmails(Прокси, ПапкаВходящиеEWSService.FolderId, apiKey, УчетнаяЗапись);
		
		НаборПисем = Рез.Result.Items.EmailMessage;	
	Иначе
		Если ЗаголовкиИдентификаторы.Количество() = 0 Тогда
			Рез = ListEmails(Прокси, ПапкаВходящиеEWSService.FolderId, apiKey, УчетнаяЗапись);
			ЗаголовкиИдентификаторы = Рез.Result.Items.EmailMessage;	
		КонецЕсли; 
		
		НаборПисем = Новый Массив;
		Для Каждого Эл Из ЗаголовкиИдентификаторы Цикл
			Рез = BindMessage(Прокси, Эл.ItemId, apiKey, УчетнаяЗапись);
			Если Рез.IsError Тогда
				НаборПисем.Добавить(Эл);
			Иначе	
				НаборПисем.Добавить(Рез.Result);
			КонецЕсли;				
		КонецЦикла; 
	КонецЕсли;
	
	Прокси = Неопределено;
	
	Если РежимТестирования Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ПараметрыЗагрузки.Свойство("ПриводитьСообщенияКТипу") Тогда
		ПриводитьСообщенияКТипу = ПараметрыЗагрузки.ПриводитьСообщенияКТипу;
	Иначе
		ПриводитьСообщенияКТипу = Истина;
	КонецЕсли;
	
	Если ПриводитьСообщенияКТипу Тогда		
		НаборПисемДляАдаптации = Новый Массив;
		Для Каждого ПочтовоеСообщениеEWSService Из НаборПисем Цикл
			НаборПисемДляАдаптации.Добавить(ПолучитьСтруктуруПисьмаИзОбъектаEWSService(ПочтовоеСообщениеEWSService, УчетнаяЗапись));	
		КонецЦикла;
		Если ПараметрыЗагрузки.Свойство("Колонки") Тогда
			НаборСообщений = ПолучитьАдаптированныйНаборПисем(НаборПисемДляАдаптации, ПараметрыЗагрузки.Колонки);
		Иначе
			НаборСообщений = ПолучитьАдаптированныйНаборПисем(НаборПисемДляАдаптации);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НаборСообщений;
	
КонецФункции

