// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ПолучитьСтруктуруПисьмаИзОбъектаEWSService(ИнтернетПисьмоEWSService, УчетнаяЗапись)
	
	ИнтернетПисьмо = Новый Структура("ИдентификаторСообщения, ДатаОтправления", ПолучитьИдентификаторПисьма(ИнтернетПисьмоEWSService.IMAPId), ИнтернетПисьмоEWSService.Date);
	ИнтернетПисьмо.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	ИнтернетПисьмо.Вставить("Кодировка", "");
	ИнтернетПисьмо.Вставить("Заголовок", "");
	ИнтернетПисьмо.Вставить("Идентификатор", Новый Массив);
	ИнтернетПисьмо.Вставить("ОбратныйАдрес", "");
	ИнтернетПисьмо.Вставить("Частичное", Ложь);
	ИнтернетПисьмо.Вставить("СпособКодированияНеASCIIСимволов", "");
	ИнтернетПисьмо.Вставить("Размер", 0);
	ИнтернетПисьмо.Вставить("Получатели", Новый Массив);
	
	// формируем адрес получателя	
	Для Каждого ПочтовыйАдресПолучателя Из ИнтернетПисьмоEWSService.Recipients.string Цикл
		Получатель = Новый Структура("Адрес, ОтображаемоеИмя");
		Получатель.Адрес = УчетнаяЗапись.АдресЭлектроннойПочты;
		Получатель.ОтображаемоеИмя = ПочтовыйАдресПолучателя;
		ИнтернетПисьмо.Получатели.Добавить(Получатель);
	КонецЦикла;
	
	ИнтернетПисьмо.Вставить("Копии", Новый Массив);
	Для Каждого ПочтовыйАдресПолучателя Из ИнтернетПисьмоEWSService.CopyTo.string Цикл
		Получатель = Новый Структура("Адрес, ОтображаемоеИмя");
		Получатель.Адрес = ПочтовыйАдресПолучателя;
		Получатель.ОтображаемоеИмя = ПочтовыйАдресПолучателя;
		ИнтернетПисьмо.Копии.Добавить(Получатель);
	КонецЦикла;
	
	ИнтернетПисьмо.Вставить("СлепыеКопии", Новый Массив);
	Для Каждого ПочтовыйАдресПолучателя Из ИнтернетПисьмоEWSService.BlindCopyTo.string Цикл
		Получатель = Новый Структура("Адрес, ОтображаемоеИмя");
		Получатель.Адрес = ПочтовыйАдресПолучателя;
		Получатель.ОтображаемоеИмя = ПочтовыйАдресПолучателя;
		ИнтернетПисьмо.СлепыеКопии.Добавить(Получатель);
	КонецЦикла;
	
	Адрес = Прав(ИнтернетПисьмоEWSService.From, СтрДлина(ИнтернетПисьмоEWSService.From) - Найти(ИнтернетПисьмоEWSService.From, "<") - 5);
	Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	ИмяОтправителя = Лев(ИнтернетПисьмоEWSService.From, Найти(ИнтернетПисьмоEWSService.From, "<") - 2);
	
	ИнтернетПисьмо.Вставить("Отправитель", Адрес);
	ИнтернетПисьмо.Вставить("ИмяОтправителя", ИмяОтправителя);
	ИнтернетПисьмо.Вставить("Тема", ИнтернетПисьмоEWSService.Subject);
	ИнтернетПисьмо.Вставить("Вложения", Новый Массив);
	Если ИнтернетПисьмоEWSService.Attachments <> Неопределено Тогда
		Для Каждого ВложениеEWSService Из ИнтернетПисьмоEWSService.Attachments.Attachment Цикл
			Если ВложениеEWSService.IsFile Тогда
				Вложение = Новый Структура("Данные, Имя, ИмяФайла, Идентификатор");		
				Вложение.Данные = ВложениеEWSService.Content;
				
				Если Не ВложениеEWSService.IsInline Тогда
					Вложение.Идентификатор = 0;
				Иначе
					Вложение.Идентификатор = ВложениеEWSService.ContentID;
				КонецЕсли;
				Вложение.ИмяФайла = ВложениеEWSService.Name;
				Вложение.Имя = ВложениеEWSService.Name;
				ИнтернетПисьмо.Вложения.Добавить(Вложение);
			Иначе
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ИнтернетПисьмо.Вставить("Тексты", Новый Массив);
	Текст = Новый Структура("Текст, ТипТекста");
	Текст.Текст = ИнтернетПисьмоEWSService.Body;
	Если ИнтернетПисьмоEWSService.IsHTML Тогда
		Текст.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	Иначе
		Текст.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
	КонецЕсли; 
	ИнтернетПисьмо.Тексты.Добавить(Текст);
	
	Значение = ИнтернетПисьмоEWSService.Importance;
	Если Значение = 0 Тогда
		Значение = ВажностьИнтернетПочтовогоСообщения.Низкая;
	ИначеЕсли Значение = 2 Тогда
		Значение = ВажностьИнтернетПочтовогоСообщения.Высокая;
	Иначе
		Значение = ВажностьИнтернетПочтовогоСообщения.Обычная;
	КонецЕсли;
	ИнтернетПисьмо.Вставить("Важность", Значение);
	
	Возврат ИнтернетПисьмо;
	
КонецФункции

// Губернаторова Дарья 06.12.2021 Выполнение задач №000039616
Функция ПолучитьИдентификаторПисьма(Знач Идентификатор)
	
	Если Лев(Идентификатор, 1) = "<" Тогда
		Идентификатор = Прав(Идентификатор, СтрДлина(Идентификатор) - 1);
	КонецЕсли; 
	
	Если Прав(Идентификатор, 1) = ">" Тогда
		Идентификатор = Лев(Идентификатор, СтрДлина(Идентификатор) - 1);
	КонецЕсли; 
	
	Возврат Идентификатор;
	
КонецФункции

