Функция ПолучитьВложениеEWSService(ФабрикаXDTO)
	
	URI = "http://schemas.datacontract.org/2004/07/EWSService";
	AttachmentТип = ФабрикаXDTO.Тип(URI, "Attachment");
	Вложения = ФабрикаXDTO.Создать(AttachmentТип);
	
	Возврат Вложения;
	
КонецФункции

