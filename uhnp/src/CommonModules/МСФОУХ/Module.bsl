Процедура ЗаполнитьТаблицыНаСервере(ФормаДокумента) Экспорт 
	
КонецПроцедуры

Процедура ЗаполнитьПоКолонкамНСБУСервер(ФормаДокумента, ИмяТаблицы = "ВНА", ТолькоНезаполненные = Истина) Экспорт

	Объект = ФормаДокумента.Объект;
	
	ТипСчетаБД = Тип("СправочникСсылка.СчетаБД");
	ТипСпособы = Тип("СправочникСсылка.СпособыОтраженияРасходовПоАмортизацииМСФО");
	ЭтоКонтекстФормы = (ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура"));
	
	СоответствиеКолонок = ПолучитьСоответствиеКолонок(ФормаДокумента, ИмяТаблицы);
	
	КэшЗначенийМСФО = Новый Соответствие;
	
	Организация = Объект.Организация;
	ПланСчетовНСБУ = ФормаДокумента.КэшируемыеЗначения.ПланСчетовНСБУ;
	ШаблонТрансляции = ФормаДокумента.КэшируемыеЗначения.ШаблонТрансляции;
	
	Для Каждого СтрокаВНА Из Объект[ИмяТаблицы] Цикл
		
		Для каждого КолонкаВНА Из СоответствиеКолонок Цикл
			
			Если Не (КолонкаВНА.Значение.Свойство("НСБУ") И КолонкаВНА.Значение.Свойство("МСФО")) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеМСФО = СтрокаВНА[КолонкаВНА.Ключ + "МСФО"];
			Если ТолькоНезаполненные И (ЗначениеМСФО <> Ложь) И ЗначениеЗаполнено(ЗначениеМСФО) Тогда
				Продолжить; //Уже заполнено
			КонецЕсли;
			
			ЗначениеМСФО = СтрокаВНА[КолонкаВНА.Ключ + "НСБУ"];
			Если ТипЗнч(ЗначениеМСФО) = ТипСчетаБД Тогда
				
				ЗначениеКэша = КэшЗначенийМСФО.Получить(ЗначениеМСФО);
				Если ЗначениеКэша = Неопределено Тогда
					ЗначениеКэша = МСФОВНАВызовСервераУХ.ПолучитьСчетПриемникТрансляции(
						ЗначениеМСФО, ШаблонТрансляции);

					КэшЗначенийМСФО.Вставить(ЗначениеМСФО, ЗначениеКэша);
				КонецЕсли;
				ЗначениеМСФО = ЗначениеКэша;
				
			ИначеЕсли ТипЗнч(СтрокаВНА[КолонкаВНА.Ключ + "МСФО"]) = ТипСпособы Тогда 
				
				ЗначениеКэша = КэшЗначенийМСФО.Получить(ЗначениеМСФО);
				Если ЗначениеКэша = Неопределено Тогда
					ЗначениеКэша = Справочники.СпособыОтраженияРасходовПоАмортизацииМСФО
						.ПолучитьСоздатьПрофильПоНСБУ(ЗначениеМСФО, ШаблонТрансляции, Ложь);
					КэшЗначенийМСФО.Вставить(ЗначениеМСФО, ЗначениеКэша);
				КонецЕсли;
				ЗначениеМСФО = ЗначениеКэша;
				
			КонецЕсли;
			
			СтрокаВНА[КолонкаВНА.Ключ + "МСФО"] = ЗначениеМСФО;
			
		КонецЦикла;
		
		Если ЭтоКонтекстФормы Тогда
			СтрокаВНА.ЕстьИзменение = Истина;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОснованияСервер(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сценарий",		Объект.Сценарий);
	Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", 	НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("КонецПериода", 	КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ВидУчета",		Перечисления.РежимЗаполненияВидовУчета.НСБУ);	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПереоценкаВНАМСФО.Ссылка КАК ДокументОснование
	|ИЗ
	|	Документ.ПереоценкаВНАМСФО КАК ПереоценкаВНАМСФО
	|ГДЕ
	|	ПереоценкаВНАМСФО.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПереоценкаВНАМСФО.Проведен
	|	И ПереоценкаВНАМСФО.Организация = &Организация
	|	И ПереоценкаВНАМСФО.Сценарий = &Сценарий
	|	И ПереоценкаВНАМСФО.ВидУчета = &ВидУчета";
	
	Объект.ДокументыОснования.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЗаполнитьТаблицыНаСервере(ФормаДокумента);	
	
КонецПроцедуры

#КонецОбласти

#Область СоответствиеКолонок

Функция ПолучитьСоответствиеКолонок(ФормаДокумента, ИмяТаблицы = "ВНА") Экспорт

	Перем СоответствиеКолонок;
	
	Если ФормаДокумента.КэшируемыеЗначения.Свойство("СоответствиеКолонок", СоответствиеКолонок) Тогда
		Возврат СоответствиеКолонок; // заполнено ранее
	КонецЕсли;
		
	ТаблицаСоответствий = Новый Соответствие;

	Постфиксы = Новый Структура("МСФО,НСБУ,Расхождение", СтрДлина("МСФО"), СтрДлина("НСБУ"), СтрДлина("Расхождение"));
	
	ТипПолеФормы = ?(ТипЗнч(ФормаДокумента) = Тип("Структура"),Тип("Структура"),Тип("ПолеФормы"));//для контекстаФормы - используем структуру
	ПрефиксПоиска = "Объект." + ИмяТаблицы + ".";
	ПрефиксПоискаЭлементы = "Элементы." + ИмяТаблицы + ".ТекущиеДанные.";
	ДлинаПрефиксаПоиска = СтрДлина(ПрефиксПоиска);
	ДлинаПрефиксаПоискаЭлементы = СтрДлина(ПрефиксПоискаЭлементы);
	ДлинаДоступность = СтрДлина("Доступность");
	
	Для каждого ЭлементФормы Из ФормаДокумента.Элементы Цикл
		
		Если ТипЗнч(ЭлементФормы) <> ТипПолеФормы Тогда
			Продолжить;
		КонецЕсли;
			
		Если Лев(ЭлементФормы.ПутьКДанным, ДлинаПрефиксаПоиска) = ПрефиксПоиска Тогда
			ИмяРеквизита = СтрЗаменить(ЭлементФормы.ПутьКДанным, ПрефиксПоиска, "");
		ИначеЕсли Лев(ЭлементФормы.ПутьКДанным, ДлинаПрефиксаПоискаЭлементы) = ПрефиксПоискаЭлементы Тогда
			ИмяРеквизита = СтрЗаменить(ЭлементФормы.ПутьКДанным, ПрефиксПоискаЭлементы, "");
		Иначе
			Продолжить;
		КонецЕсли;
		
		ПолеРеквизита = СтрНайти(ИмяРеквизита, ".")>0;
		
		Для каждого Постфикс Из Постфиксы Цикл
			
			Если СтрНайти(ИмяРеквизита, Постфикс.Ключ + ?(ПолеРеквизита, ".", "")) > 0 
				И (Прав(ИмяРеквизита, ДлинаДоступность) <> "Доступность") Тогда
				
				ИмяСоотв = СтрЗаменить(ИмяРеквизита, Постфикс.Ключ, "");
				
				Соотв = ТаблицаСоответствий.Получить(ИмяСоотв);
				Если Соотв = Неопределено Тогда
					Соотв = Новый Структура;
				КонецЕсли;
				
				Соотв.Вставить(Постфикс.Ключ, Истина);
				Соотв.Вставить("ПолеРеквизита", ПолеРеквизита);
				ТаблицаСоответствий.Вставить(ИмяСоотв, Соотв);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаСоответствий;
	
КонецФункции

#КонецОбласти

#Область ДокументыСобытия

Функция ДобавитьУсловноеОформлениеТолькоПросмотр(ЭтаФорма, МассивИменОформляемыхПолей, 
			ЛевоеЗначение = Неопределено, ПравоеЗначение = Неопределено, ВидСравнения = Неопределено) Экспорт

	ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Если ТипЗнч(ЛевоеЗначение) = Тип("Строка") Тогда
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение);
	Иначе
		ЭлементОтбора.ЛевоеЗначение = ЛевоеЗначение;
	КонецЕсли;
	
	ЭлементОтбора.ПравоеЗначение = ПравоеЗначение;
	Если ВидСравнения <> Неопределено Тогда
		ЭлементОтбора.ВидСравнения = ВидСравнения;
	КонецЕсли;
	
	Для каждого ПолеОформления Из МассивИменОформляемыхПолей Цикл
		ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных(ПолеОформления);
	КонецЦикла;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаТолькоПросмотр);
	
	Возврат ЭлементУО;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокументов

Процедура ПровестиДокумент(ОбъектДокумент, ПроверятьЗаполнение = Истина, Отказ = Ложь, ОписаниеОшибки = Неопределено) Экспорт 
	
	МетаданныеДокумента = ОбъектДокумент.Метаданные();
	ЕстьПроведение = (МетаданныеДокумента.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить);
	
	Если ПроверятьЗаполнение И Не ОбъектДокумент.ПроверитьЗаполнение() Тогда
		
		Отказ = Истина;
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Документ <%1> не заполнен'"), ОбъектДокумент);
	
		Если ЗначениеЗаполнено(ОбъектДокумент.Ссылка) И ЕстьПроведение Тогда
			ОбъектДокумент.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Режим = ?(ЕстьПроведение, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	
	Попытка
		ОбъектДокумент.Записать(Режим);
	Исключение
		Отказ = Истина;
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(Объект, ДанныеЗаполнения = Неопределено, РежимЗаполнения = Неопределено) Экспорт
	
	ИменаПолей = "Сценарий, Организация, ПериодОтчета, ПериодСценария, РежимЗаполнения";
	Источник = МСФОКлиентСерверУХ.ПоляОбъекта(ДанныеЗаполнения, ИменаПолей);
	
	Если НЕ ЗначениеЗаполнено(Источник.Сценарий) Тогда
		Источник.Сценарий = Константы.СценарийМСФО.Получить();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.РежимЗаполнения) Тогда
		Если РежимЗаполнения = Неопределено Тогда
			Источник.РежимЗаполнения = ПредопределенноеЗначение("Перечисление.РежимЗаполненияВидовУчета.НСБУИМСФО");
		Иначе
			Источник.РежимЗаполнения = РежимЗаполнения;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.ПериодОтчета) Тогда
		Источник.ПериодОтчета = МСФОВНАВызовСервераУХ.ПолучитьПериодПоДатеПараллельногоУчета(Объект.Дата, Неопределено);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.ПериодСценария) Тогда
		Источник.ПериодСценария = Источник.ПериодОтчета;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Источник.Организация) Тогда
		Источник.Организация = ОбщегоНазначенияУХ.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	КонецЕсли;
	
 	ДоступныеРеквизиты = Объект.Метаданные().Реквизиты;
	ИмяПериодОтчета = ИмяПериодОтчета(ДоступныеРеквизиты);
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		
		Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
			И ЗначениеЗаполнено(ИмяПериодОтчета) 
			И Источник.Свойство(ИмяПериодОтчета)
			И ЗначениеЗаполнено(Источник[ИмяПериодОтчета])
			Тогда
			
			Объект.Дата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Источник[ИмяПериодОтчета], "ДатаОкончания");
		
		ИначеЕсли ЗначениеЗаполнено(ИмяПериодОтчета) Тогда //регламентированные документы для прошедшего месяца
			Объект.Дата = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1)));
		Иначе 
			Объект.Дата = НачалоДня(ТекущаяДатаСеанса());
		КонецЕсли;
		
	КонецЕсли;

	Объект.Ответственный = Пользователи.ТекущийПользователь();

	ЗаполнитьПериодПриКопировании(Объект, Источник, ДоступныеРеквизиты, ИмяПериодОтчета);
	
	Для каждого ИсточникЗначение Из Источник Цикл
	
		Если ДоступныеРеквизиты.Найти(ИсточникЗначение.Ключ) <> Неопределено Тогда
			УстановитьНезаполненноеЗначение(
				Объект[ИсточникЗначение.Ключ], ИсточникЗначение.Значение);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяПериодОтчета(ДоступныеРеквизиты)

	ИмяПериод = Неопределено;
	Если ДоступныеРеквизиты.Найти("ПериодОтчета") <> Неопределено Тогда
		ИмяПериод = "ПериодОтчета";
	ИначеЕсли ДоступныеРеквизиты.Найти("ПериодСценария") <> Неопределено Тогда
		ИмяПериод = "ПериодСценария";
	КонецЕсли;
	
	Возврат ИмяПериод;
	
КонецФункции

Процедура ЗаполнитьПериодПриКопировании(Объект, Источник, ДоступныеРеквизиты, ИмяПериодОтчета)
	
	Если Не ЗначениеЗаполнено(ИмяПериодОтчета) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Источник[ИмяПериодОтчета]) Тогда //ПериодОтчета по дате
		
		Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
		ПериодОтчета = МСФОВНАВызовСервераУХ.ПолучитьПериодПоДатеПараллельногоУчета(
			Объект.Дата, Периодичность);
		Источник[ИмяПериодОтчета] = ПериодОтчета;
		
		Возврат;
		
	КонецЕсли;

	Границы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Источник[ИмяПериодОтчета], "ДатаНачала, ДатаОкончания");
	
	Если Границы.ДатаОкончания < Объект.Дата Или Границы.ДатаНачала > Объект.Дата Тогда
		
		//после копирования перезаполним ПериодОтчета предыдущим месяцем
		Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");

		Объект.Дата = ДобавитьМесяц(Объект.Дата,-1);
		ПериодОтчета = МСФОВНАВызовСервераУХ.ПолучитьПериодПоДатеПараллельногоУчета(
			Объект.Дата, Периодичность);
			
		Если ЗначениеЗаполнено(ПериодОтчета) Тогда
			
			Объект.Дата = КонецДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПериодОтчета, "ДатаОкончания"));
			Источник[ИмяПериодОтчета] = ПериодОтчета;
			
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура УстановитьНезаполненноеЗначение(Параметр, Значение)

	Если (Параметр <> Значение) И ЗначениеЗаполнено(Значение) Тогда
		Параметр = Значение;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРучныеКорректировкиПередЗаписью(Источник, Отказ, РежимЗаписи) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ПропуститьПроверкуРучныхКорректировок") Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьРучныеКорректировкиДокумента(Источник.Отбор.Регистратор.Значение, Отказ);
	
КонецПроцедуры

Процедура ПроверитьРучныеКорректировкиДокумента(ДокументСсылка, Отказ) Экспорт

	Если Не РегистрыСведений.РучныеКорректировкиДвижений.ЕстьРК(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;	
	
	ТекстСообщения = НСтр("ru = 'Движения документа %1 отредактированы вручную и не могут быть автоматически актуализированы'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, ДокументСсылка), ДокументСсылка, , , Отказ);

КонецПроцедуры

