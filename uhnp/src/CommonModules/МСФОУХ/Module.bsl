Функция ПараметрыУдаления() Экспорт

	Возврат Новый Структура("ПропуститьПроверкуЗапретаИзменения", Истина);

КонецФункции

Процедура УдалитьДвиженияДокумента(Ссылка, Отказ = Ложь, ПараметрыУдаления = Неопределено) Экспорт

	МД = Ссылка.Метаданные();
	
	Если ПараметрыУдаления = Неопределено Тогда
		ПараметрыУдаления = ПараметрыУдаления();
	КонецЕсли;
	
	Для Каждого Регистр Из МД.Движения Цикл
		
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Регистр.ПолноеИмя());
		
		Набор = Менеджер.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ссылка, Истина);
		
		Если ПараметрыУдаления.ПропуститьПроверкуЗапретаИзменения Тогда
			Набор.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		КонецЕсли;
		
		Попытка
			Набор.Записать();
		Исключение
			
			СобытиеОбработкаДвижений = НСТр("ru = 'Обработка движений'", ОбщегоНазначения.КодОсновногоЯзыка());
			
			ЗаписьЖурналаРегистрации(
				СобытиеОбработкаДвижений,
				УровеньЖурналаРегистрации.Ошибка,
				,
				Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение;
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

