#Область СозданиеТчПроводки

Процедура СоздатьЭлементыТчПроводки(Элементы, ИмяТЧ, ПараметрыЭлементовТчПроводки = Неопределено) Экспорт
	
	ПараметрыТЧ = ПараметрыЭлементовТчПроводки(ПараметрыЭлементовТчПроводки);
	Корень = Элементы[ИмяТЧ];
	
	Родитель = СоздатьГруппуКолонок("ГруппаРегистратор", Корень, Истина, ПараметрыТЧ.ЗаголовокИзм);
	СоздатьКолонкуФормы(Элементы, ИмяТЧ, "НомерСтроки", Родитель, 3);
	СоздатьКолонкуФормы(Элементы, ИмяТЧ, "ВидОперации", Родитель, 9);
	
	Для каждого ДтКт Из ПараметрыТЧ.СтороныДтКт Цикл
		СоздатьЭлементыДтКт(Элементы, ИмяТЧ, ДтКт.Ключ, ДтКт.Значение, ПараметрыТЧ);
	КонецЦикла;
	
	Родитель = СоздатьГруппуКолонок(Элементы, ИмяТЧ, "ГруппаСуммаСодержание", Корень, Истина, ПараметрыТЧ.ЗаголовокРес);
	СоздатьКолонкуФормы(Элементы, ИмяТЧ, "СуммаВВалютеУчета", Родитель);
	СоздатьКолонкуФормы(Элементы, ИмяТЧ, "СуммаВВалютеОтчетности", Родитель);
	СоздатьКолонкуФормы(Элементы, ИмяТЧ, "Содержание", Родитель);

КонецПроцедуры

Функция ПараметрыЭлементовТчПроводки(ПараметрыЭлементовТчПроводки = Неопределено)
	
	БалИзм 		= СтрРазделить("НомерСтроки,ВидОперации", ",");// Колонка 1
	НебалИзм 	= СтрРазделить("Подразделение,НаправлениеДеятельности", ",");// Колонки 2,3(Дебет, Кредит)
	БалРес 		= СтрРазделить("СуммаВВалютеУчета,СуммаВВалютеОтчетности,Содержание", ",");//Колонка 4
	
	СтороныДтКт 	= Новый Структура("Дт, Кт", );
	ЧислоСубконто 	= УчетМСФОПовтИспУХ.ПолучитьМаксКоличествоСубконто();
	
	ПараметрыТЧ = Новый Структура("ИмяСуммаВал, ИмяКоличество, ЧислоСубконто,
							|СоздатьСчет, БалИзм, НебалИзм, БалРес,
							|ЗаголовокИзм, ЗаголовокДт, ЗаголовокКт, ЗаголовокРес", 
						"СуммаВВалюте", "Количество", ЧислоСубконто,
						Истина, БалИзм, НебалИзм, БалРес,
						"№", НСтр("ru = 'Дебет'"), НСтр("ru = 'Кредит'"), НСтр("ru = 'Сумма и содержание'"));
	
	Если ПараметрыЭлементовТчПроводки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыТЧ, ПараметрыЭлементовТчПроводки);
	КонецЕсли;
	
	Возврат ПараметрыТЧ;
	
КонецФункции

Процедура СоздатьЭлементыДтКт(Элементы, ИмяТЧ, ДтКт = "Дт", ПредставлениеДтКт = "Дебет", ПараметрыТЧ = Неопределено)
	
	Если ПараметрыТЧ = Неопределено Тогда
		ПараметрыТЧ = ПараметрыЭлементовТчПроводки(ПараметрыТЧ);
	КонецЕсли;
		
	ГруппаДт = СоздатьГруппуКолонок(Элементы, ИмяТЧ, "Группа" + ДтКт, Элементы[ИмяТЧ], Истина, ПредставлениеДтКт);

	ГруппаСчетДт = СоздатьГруппуКолонок(Элементы, ИмяТЧ, "ГруппаСчет" + ДтКт, ГруппаДт, Ложь);
	Если ПараметрыТЧ.СоздатьСчет Тогда
		СоздатьКолонкуФормы(Элементы, ИмяТЧ, "Счет" + ДтКт, ГруппаСчетДт, 9);
	КонецЕсли;

	ГруппаКолВал = СоздатьГруппуКолонок(Элементы, ИмяТЧ, "ГруппаКолВал" + ДтКт, ГруппаСчетДт, Истина);
	Если ЗначениеЗаполнено(ПараметрыТЧ.ИмяКоличество) Тогда
		ГруппаКол = СоздатьГруппуКолонок(Элементы, ИмяТЧ, "ГруппаКол" + ДтКт, ГруппаСчетДт, Ложь);
		СоздатьКолонкуФормы(Элементы, ИмяТЧ, "НадписьКоличество" + ДтКт, ГруппаКол, 6);
		СоздатьКолонкуФормы(Элементы, ИмяТЧ, "Количество" + ДтКт, ГруппаКол, 6);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыТЧ.ИмяСуммаВал) Тогда
		ГруппаВал = СоздатьГруппуКолонок(Элементы, ИмяТЧ, "ГруппаВал" + ДтКт, ГруппаСчетДт, Ложь);
		СоздатьКолонкуФормы(Элементы, ИмяТЧ, "Валюта" + ДтКт, ГруппаВал, 6);
		СоздатьКолонкуФормы(Элементы, ИмяТЧ, ПараметрыТЧ.ИмяСуммаВал + ДтКт, ГруппаВал, 9);
	КонецЕсли;
	
	Для каждого ИмяИзм Из ПараметрыТЧ.НебалИзм Цикл
		СоздатьКолонкуФормы(Элементы, ИмяТЧ, ИмяИзм + ДтКт, ГруппаДт, 15);
	КонецЦикла;

	Для й = 1 По ПараметрыТЧ.ЧислоСубконто Цикл
		СоздатьКолонкуФормы(Элементы, ИмяТЧ, "Субконто" + ДтКт + й, ГруппаДт, 15);
	КонецЦикла;

КонецПроцедуры

Функция СоздатьКолонкуФормы(Элементы, ИмяТЧ, ИмяКолонки, Родитель, Ширина = Неопределено, ПараметрыЭлемента = Неопределено) Экспорт 

	Если ПараметрыЭлемента = Неопределено Тогда
		ПараметрыЭлемента = Новый Структура;
	КонецЕсли;
	
	Если Не ПараметрыЭлемента.Свойство("ОтображатьВШапке") Тогда
		ПараметрыЭлемента.Вставить("ОтображатьВШапке", Ложь);
	КонецЕсли;
	
	Если Ширина <> Неопределено Тогда
		ПараметрыЭлемента.Вставить("Ширина", Ширина);
	КонецЕсли;
	
	Возврат ФормыУХ.СоздатьПолеФормы(Элементы, ИмяТЧ + ИмяКолонки, , ИмяТЧ + "." + ИмяКолонки, ,Родитель,, ПараметрыЭлемента);

КонецФункции

Функция СоздатьГруппуКолонок(Элементы, ИмяТЧ, ИмяКолонки, Родитель, 
		Вертикально = Неопределено, Заголовок = Неопределено, Ширина = Неопределено, ПараметрыЭлемента = Неопределено) Экспорт

	Если ПараметрыЭлемента = Неопределено Тогда
	    ПараметрыЭлемента = Новый Структура;
	КонецЕсли;
	
	Если Заголовок = Неопределено Тогда
		ПараметрыЭлемента.Вставить("ОтображатьВШапке", Ложь);
	Иначе//Если Заголовок <> Неопределено Тогда
		ПараметрыЭлемента.Вставить("ОтображатьЗаголовок", Истина);
		ПараметрыЭлемента.Вставить("ОтображатьВШапке", Истина);
	КонецЕсли;
	
	Если Вертикально = Истина Тогда
		ПараметрыЭлемента.Вставить("Группировка", ГруппировкаКолонок.Вертикальная);	
	ИначеЕсли Вертикально = Ложь Тогда
		ПараметрыЭлемента.Вставить("Группировка", ГруппировкаКолонок.Горизонтальная);	
	КонецЕсли;
	
	Если Ширина <> Неопределено Тогда
		ПараметрыЭлемента.Вставить("Ширина", Ширина);
	КонецЕсли;
	
	ВидГруппы = ВидГруппыФормы.ГруппаКолонок;
	
	Возврат ФормыУХ.СоздатьГруппуФормы(Элементы, ИмяТЧ + ИмяКолонки, Заголовок, ВидГруппы, Родитель, , ПараметрыЭлемента);

КонецФункции

