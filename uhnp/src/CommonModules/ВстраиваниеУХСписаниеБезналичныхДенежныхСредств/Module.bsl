		Новый Структура("ПриИзменении", "Подключаемый_РасшифровкаПлатежаЭлементСтруктурыЗадолженностиПриИзменении"));
		
	УстановитьПараметрыЭлементовСтруктурыЗадолженности(Форма); 		
			
	#КонецОбласти 	

	#Область КнопкиЗаполнения
	
