	|ГДЕ
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявлениеОВвозеТоваровТовары.НомерСтроки КАК НомерСтрокиДокумента,
	|	ЗаявлениеОВвозеТоваровТовары.ВесНеттоКг КАК ВесНеттоКг,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаПринятияНаУчет КАК ДатаПринятияНаУчет,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаСчетаФактуры КАК ДатаСчетаФактуры,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаТСД КАК ДатаТСД,
	|	ЗаявлениеОВвозеТоваровТовары.Договор КАК Договор,
	|	ЗаявлениеОВвозеТоваровТовары.ДокументПоступления КАК ДокументПоступленияТоваров,
	|	ЗаявлениеОВвозеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаявлениеОВвозеТоваровТовары.КодВидаТранспорта КАК КодВидаТранспорта,
	|	ЗаявлениеОВвозеТоваровТовары.КодТНВЭД КАК КодТНВЭД,
	|	ЗаявлениеОВвозеТоваровТовары.Количество КАК Количество,
	|	ЗаявлениеОВвозеТоваровТовары.КоличествоПоТНВЭД КАК КоличествоПоТНВЭД,
	|	ЗаявлениеОВвозеТоваровТовары.НалоговаяБазаАкцизы КАК НалоговаяБазаАкцизы,
	|	ЗаявлениеОВвозеТоваровТовары.НалоговаяБазаНДС КАК НалоговаяБазаНДС,
	|	ЗаявлениеОВвозеТоваровТовары.Номенклатура КАК Номенклатура,
	|	ЗаявлениеОВвозеТоваровТовары.НомерТД КАК НомерГТД,
	|	ЗаявлениеОВвозеТоваровТовары.НомерСчетаФактуры КАК НомерСчетаФактуры,
	|	ЗаявлениеОВвозеТоваровТовары.Серия КАК Серия,
	|	ЗаявлениеОВвозеТоваровТовары.СерияНомерТСД КАК СерияНомерТСД,
	|	ЗаявлениеОВвозеТоваровТовары.СтавкаНДС КАК СтавкаНДС,
	|	ЗаявлениеОВвозеТоваровТовары.ТвердаяСтавкаАкциза КАК ТвердаяСтавкаАкциза,
	|	ЗаявлениеОВвозеТоваровТовары.ФактурнаяСтоимость КАК ФактурнаяСтоимость,
	|	ЗаявлениеОВвозеТоваровТовары.Характеристика КАК Характеристика,
	|	ЗаявлениеОВвозеТоваровТовары.СуммаАкциза КАК СуммаАкциза
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.Товары КАК ЗаявлениеОВвозеТоваровТовары
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	УчастникиСделки = ПакетРезультатов[0].Выгрузить();
	Спецификации = ПакетРезультатов[1].Выгрузить(); 
	СведенияОДокументах = ПакетРезультатов[2].Выгрузить();
	ТоварыИсходные = ПакетРезультатов[3].Выгрузить(); 
	
	Товары = ТоварыИсходные.СкопироватьКолонки();
	
	Товары.Колонки.Добавить("ДокументПоступления");
	
	Для Каждого Строка Из ТоварыИсходные Цикл
	    
	    НоваяСтрока = Товары.Добавить();
	    
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "ДокументПоступленияТоваров");
		
		Если ЗначениеЗаполнено(Строка.ДокументПоступленияТоваров) Тогда
		
			ИмяПКО = ИмяПКОДляОбъектаДанных(КомпонентыОбмена, Строка.ДокументПоступленияТоваров, ДанныеИБ.Организация);
		    
		    НоваяСтрока.ДокументПоступления = Новый Структура("Значение, ИмяПКО", 
		    	Строка.ДокументПоступленияТоваров, ИмяПКО);
		    
		КонецЕсли;
	
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Товары", Товары); 
	ДанныеXDTO.Вставить("СведенияОДокументах", СведенияОДокументах); 
	ДанныеXDTO.Вставить("Спецификации", Спецификации); 
	ДанныеXDTO.Вставить("УчастникиСделки", УчастникиСделки);
	 
	#КонецОбласти
КонецПроцедуры

