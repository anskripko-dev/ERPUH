				ПараметрыПослеЗагрузкиДанных.ПроверятьНаИспользованиеДоговоров = Ложь;
			КонецЕсли;
	
			ОбменДаннымиУТ.ПослеЗагрузкиДанных(ПараметрыПослеЗагрузкиДанных);
		
			// Установка признака применения льготных ставок НДС у контрагентов.
			ОбработатьПоставщиковСЛьготнойСтавкойНДС(КомпонентыОбмена.ПараметрыКонвертации.ПоставщикиЛьготнаяСтавкаНДС);
			
			ОбработатьЗагруженныеДопРеквизитыИСведения(КомпонентыОбмена);
			ОбработатьЗагруженныеСтатьиДДСИХозОперации(КомпонентыОбмена);
			ОбработатьСФПолученныеПоЗагруженнымАО(КомпонентыОбмена);
			ОтложеннаяОбработка_ЗаполнитьНоменклатуру(КомпонентыОбмена);
			//++ НЕ УТ
			
			//++ Локализация
			ОтложеннаяОбработка_ДанныеДляПодбораСотрудников(КомпонентыОбмена);
			//-- Локализация
			
			//-- НЕ УТ
			ОтложеннаяОбработка_ЗаполнениеКассовыхСмен(КомпонентыОбмена);
			ОтложеннаяОбработка_ЗакрытиеКассовыхСмен(КомпонентыОбмена);
			ОтложеннаяОбработка_ЗаполнитьКлассификаторТНВЭД(КомпонентыОбмена);
			ОтложеннаяОбработка_ЗаполнитьВозвратыПС(КомпонентыОбмена); 
			//++ Локализация
			ОтложеннаяОбработка_ДокументыРасчетовССамозанятыми(КомпонентыОбмена);
	 		ОтложеннаяОбработка_ПодобратьПартииТМЦВЭксп(КомпонентыОбмена);
	 		//-- Локализация
	 		ОтложеннаяОбработка_ЗаполнитьТипыПервичныхДок(КомпонентыОбмена);
	 		ОтложеннаяОбработка_СоздатьОбновитьОбъектыРасчетов(КомпонентыОбмена);
	 		ОтложеннаяОбработка_ЗаполнитьОбъектыРасчетов(КомпонентыОбмена);
	 		ОтложеннаяОбработка_СортДокОтложенногоПров(КомпонентыОбмена);
	 		ОтложеннаяОбработка_ОтразитьДокументыВРеестре(КомпонентыОбмена);
		    //++ НЕ УТ
		    
		    //++ Локализация
		    ОтложеннаяОбработка_ЗаполнитьПорядокОтражения(КомпонентыОбмена);
	 		//-- Локализация
	 		
	 		//-- НЕ УТ
	 		
		КонецЕсли;
		
		Если КомпонентыОбмена.ПараметрыКонвертации.ПриСинхронизацииЗарегистрированоПредупреждение
			И (КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено
			ИЛИ КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Неопределено) Тогда
			КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями;
			КомпонентыОбмена.ПараметрыКонвертации.ПриСинхронизацииЗарегистрированоПредупреждение = Ложь;
		КонецЕсли;
	
	ИначеЕсли КомпонентыОбмена.НаправлениеОбмена = "Отправка" Тогда
		
		Если КомпонентыОбмена.ЭтоОбменЧерезПланОбмена Тогда
			
			СозданныеПриВыгрузкеОбъекты = КомпонентыОбмена.ПараметрыКонвертации.СозданныеПриВыгрузкеОбъекты;
			Если СозданныеПриВыгрузкеОбъекты.Количество() > 0 Тогда
				
				УзелКорреспондента = КомпонентыОбмена.УзелКорреспондента;
				НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелКорреспондента, "НомерОтправленного") + 1;
				
				ВыборкаИзменений = ОбменДаннымиСервер.ВыбратьИзменения(
					УзелКорреспондента,
					НомерОтправленного,
					КомпонентыОбмена.ПараметрыКонвертации.СозданныеПриВыгрузкеОбъекты);
				
				Пока ВыборкаИзменений.Следующий() Цикл
					
					Данные = ВыборкаИзменений.Получить();
					ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, Данные);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если КомпонентыОбмена.ПараметрыКонвертации.ПриСинхронизацииЗарегистрированоПредупреждение
			И (КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено
			ИЛИ КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Неопределено) Тогда
			КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями;
			КомпонентыОбмена.ПараметрыКонвертации.ПриСинхронизацииЗарегистрированоПредупреждение = Ложь;		
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
Процедура ПослеМержевания_ПБДС(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	// Тип платежного документа.
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ТипПлатежногоДокумента) Тогда
		ДанныеДляЗаписиВИБ.ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
	КонецЕсли;
	
	// Пересчет суммы конвертации.
	Если ДанныеДляЗаписиВИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.КонвертацияВалюты Тогда
		
		Если ДанныеДляЗаписиВИБ.КурсКонвертации <> 0 И ДанныеДляЗаписиВИБ.СуммаДокумента <> 0 Тогда
			Если ДанныеДляЗаписиВИБ.ВалютаКонвертации = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ДанныеДляЗаписиВИБ.Организация) Тогда
				ДанныеДляЗаписиВИБ.СуммаКонвертации = ДанныеДляЗаписиВИБ.СуммаДокумента * ДанныеДляЗаписиВИБ.КурсКонвертации;
			Иначе
				ДанныеДляЗаписиВИБ.СуммаКонвертации = ДанныеДляЗаписиВИБ.СуммаДокумента / ДанныеДляЗаписиВИБ.КурсКонвертации;
			КонецЕсли;
		Иначе
			ДанныеДляЗаписиВИБ.СуммаКонвертации = 0;
		КонецЕсли;
	
	КонецЕсли;
		
	// Расшифровка платежа. Статья доходов и подразделение.
	Если ДанныеДляЗаписиВИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочееПоступлениеДенежныхСредств Тогда
		
		ЗаполнитьПодразделениеВРасшифровкеПлатежа(ДанныеДляЗаписиВИБ, КомпонентыОбмена);
		
		Для Каждого СтрокаРП Из ДанныеДляЗаписиВИБ.РасшифровкаПлатежа Цикл
			Если Не ЗначениеЗаполнено(СтрокаРП.СтатьяДоходов) Тогда
				СтрокаРП.СтатьяДоходов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.УпрБалансПрочиеАктивы;
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Контрагент) Тогда
	    ЗаполнитьКонтрагентаНашеПредприятие(ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации);
	КонецЕсли;
	ЗаполнитьОснованиеПлатежаИзДопСвойств(ДанныеДляЗаписиВИБ, ПолученныеДанные.ДополнительныеСвойства);
КонецПроцедуры
Процедура ПослеМержевания_ПКО(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	// Расшифровка платежа. Статья доходов и подразделение.
	Если ДанныеДляЗаписиВИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочееПоступлениеДенежныхСредств Тогда
		
		ЗаполнитьПодразделениеВРасшифровкеПлатежа(ДанныеДляЗаписиВИБ, КомпонентыОбмена);
		
		Для Каждого СтрокаРП Из ДанныеДляЗаписиВИБ.РасшифровкаПлатежа Цикл
			Если Не ЗначениеЗаполнено(СтрокаРП.СтатьяДоходов) Тогда
				СтрокаРП.СтатьяДоходов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.УпрБалансПрочиеАктивы;
			КонецЕсли;
		КонецЦикла;
	//++ Локализация
	
	//++ НЕ УТ
		
	ИначеЕсли ДанныеДляЗаписиВИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПогашениеЗаймаСотрудником Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорЗаймаСотруднику.Ссылка КАК ДоговорЗайма,
		|	ДоговорЗаймаСотруднику.Организация КАК Организация,
		|	ДоговорЗаймаСотруднику.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	Документ.ДоговорЗаймаСотруднику КАК ДоговорЗаймаСотруднику
		|ГДЕ
		|	ДоговорЗаймаСотруднику.Организация = &Организация
		|	И ДоговорЗаймаСотруднику.ФизическоеЛицо = &ФизическоеЛицо
		|	И ДоговорЗаймаСотруднику.Проведен
		|	И ДоговорЗаймаСотруднику.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДоговорЗаймаСотруднику.Дата УБЫВ";
		
		Запрос.УстановитьПараметр("Организация", ДанныеДляЗаписиВИБ.Организация);
		Запрос.УстановитьПараметр("ФизическоеЛицо", ДанныеДляЗаписиВИБ.ПодотчетноеЛицо);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			ВыборкаДетальныеЗаписи.Следующий(); 
			ДоговорЗайма = ВыборкаДетальныеЗаписи.ДоговорЗайма;
			Для Каждого СтрокаРП Из ДанныеДляЗаписиВИБ.РасшифровкаПлатежа Цикл 
				Если Не ЗначениеЗаполнено(СтрокаРП.ДоговорЗаймаСотруднику) Тогда
					СтрокаРП.ДоговорЗаймаСотруднику = ДоговорЗайма; 
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	//-- НЕ УТ
	
	//-- Локализация
		
	КонецЕсли;
	
	ЗаполнитьОснованиеПлатежаИзДопСвойств(ДанныеДляЗаписиВИБ, ПолученныеДанные.ДополнительныеСвойства);
КонецПроцедуры
Процедура ПослеМержевания_РКО(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	// Расшифровка платежа. Статья расходов и подразделение.
	Если ДанныеДляЗаписиВИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств Тогда
		
		ЗаполнитьПодразделениеВРасшифровкеПлатежа(ДанныеДляЗаписиВИБ, КомпонентыОбмена);
		
		Для Каждого СтрокаРП Из ДанныеДляЗаписиВИБ.РасшифровкаПлатежа Цикл
			Если Не ЗначениеЗаполнено(СтрокаРП.СтатьяРасходов) Тогда
				СтрокаРП.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.УпрБалансПрочиеПассивы;
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
КонецПроцедуры
Процедура ПослеМержевания_СБДС(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	// Тип платежного документа.
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ТипПлатежногоДокумента) Тогда
		ДанныеДляЗаписиВИБ.ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
	КонецЕсли;
	
	// Очередность платежа.
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ОчередностьПлатежа) Тогда
		ДанныеДляЗаписиВИБ.ОчередностьПлатежа = 5;
	КонецЕсли;
	
	// Банковский счет контрагента. 
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.БанковскийСчетКонтрагента) И ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.Контрагент)
		И ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.Валюта) Тогда
		ДанныеДляЗаписиВИБ.БанковскийСчетКонтрагента = БанковскийСчетКонтрагентаПоУмолчанию(ДанныеДляЗаписиВИБ.Контрагент, ДанныеДляЗаписиВИБ.Валюта);
	КонецЕсли;
	
	// Расшифровка платежа. Статья расходов и подразделение.
	Если ДанныеДляЗаписиВИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств
		ИЛИ ДанныеДляЗаписиВИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет Тогда
		
		ЗаполнитьПодразделениеВРасшифровкеПлатежа(ДанныеДляЗаписиВИБ, КомпонентыОбмена);
		
		Для Каждого СтрокаРП Из ДанныеДляЗаписиВИБ.РасшифровкаПлатежа Цикл
			Если Не ЗначениеЗаполнено(СтрокаРП.СтатьяРасходов) Тогда
				СтрокаРП.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.УпрБалансПрочиеПассивы;
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	// Банковские счета списка контрагентов
	Если ДанныеДляЗаписиВИБ.ОперацияССамозанятым И Не ДанныеДляЗаписиВИБ.СписокКонтрагентов 
		И ДанныеДляЗаписиВИБ.БанковскиеСчетаСпискаКонтрагентов.Количество() > 0 Тогда
		
		ДанныеДляЗаписиВИБ.БанковскиеСчетаСпискаКонтрагентов.Очистить();
		
	КонецЕсли;
КонецПроцедуры
Функция ПравилаЗаполненияОстатковРасчетов(ЗаполнятьДоговор)
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Сумма",                "Сумма");
	ПравилаЗаполнения.Вставить("СуммаРегл",            "СуммаРегл");
	ПравилаЗаполнения.Вставить("Контрагент",           "Контрагент");
	ПравилаЗаполнения.Вставить("ВалютаВзаиморасчетов", "ВалютаВзаиморасчетов");
	ПравилаЗаполнения.Вставить("ДокументРасчетов",     "ДокументРасчетов");
	
	Если ЗаполнятьДоговор Тогда
		ПравилаЗаполнения.Вставить("Договор", "ОбъектРасчетов");
	КонецЕсли;
	
	Возврат ПравилаЗаполнения;
КонецФункции
Процедура ПредупреждениеПриСинхронизации(КомпонентыОбмена, ОбрабатываемыйОбъект, ТекстПредупреждения)
	КомпонентыОбмена.ПараметрыКонвертации.ПриСинхронизацииЗарегистрированоПредупреждение = Истина;
	
	УзелКорреспондента = Неопределено;
	ОбъектМетаданных   = Неопределено;
	
	Если КомпонентыОбмена.ЭтоОбменЧерезПланОбмена Тогда
		УзелКорреспондента = КомпонентыОбмена.УзелКорреспондента;
	КонецЕсли;
	
	Если УзелКорреспондента <> Неопределено
		И Не УзелКорреспондента.Пустая() Тогда
		ОбъектМетаданных = УзелКорреспондента.Метаданные();
	КонецЕсли;
		
	КлючСообщенияЖурналаРегистрации = КомпонентыОбмена.КлючСообщенияЖурналаРегистрации;
	
	ЗаписьЖурналаРегистрации(КлючСообщенияЖурналаРегистрации,
		УровеньЖурналаРегистрации.Предупреждение,
		ОбъектМетаданных,
		ОбрабатываемыйОбъект,
		ТекстПредупреждения);
КонецПроцедуры
// Параметры:
//  КомпонентыОбмена - см. ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена
//  ДанныеИБ - ЛюбаяСсылка - Объект информационной базы.
//  ДанныеXDTO - Структура - Структура, в которой передаются свойства полученного объекта конвертации.
//
Функция ПривестиНомерКФормату11(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO)
	ТолькоКлючевыеСвойства = Неопределено;
	Если Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") = ТипЗнч(ДанныеИБ) Тогда
		
		ТолькоКлючевыеСвойства = Ложь;
		
	ИначеЕсли Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") = ТипЗнч(ДанныеИБ) Тогда
		
		ТолькоКлючевыеСвойства = Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если СтрДлина(СокрЛП(ДанныеИБ.Номер)) < 12
		ИЛИ НЕ ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.15") Тогда
		
		ДанныеXDTO.КлючевыеСвойства.Вставить("НомерРасширенный", ДанныеИБ.Номер);
		
	КонецЕсли;
	
	Если ТолькоКлючевыеСвойства Тогда
		
		ПодстрокиНомера = СтрРазделить(ДанныеXDTO.Номер, "-");
		
	Иначе
		
		ПодстрокиНомера = СтрРазделить(ДанныеXDTO.КлючевыеСвойства.Номер, "-");
		
	КонецЕсли;
	
	Если ПодстрокиНомера.Количество() = 2
		И СтрДлина(ПодстрокиНомера[1]) = 7 Тогда
		
		НомерОбработанный = "";
		Если Лев(ПодстрокиНомера[1], 1) = "П" Тогда
			
			ПодстрокиНомера[1] = "П" + Прав(ПодстрокиНомера[1],5);
			НомерОбработанный = СтрСоединить(ПодстрокиНомера, "-");
			
		Иначе
			
			Если ДанныеXDTO.КлючевыеСвойства.Свойство("Номер") Тогда
				НомерОбработанный = Лев(ДанныеXDTO.КлючевыеСвойства.Номер, 5) + Прав(ДанныеXDTO.КлючевыеСвойства.Номер, 6);
			Иначе 	
				НомерОбработанный = "000000";
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТолькоКлючевыеСвойства Тогда
			
			ДанныеXDTO.Номер = НомерОбработанный;
			
		Иначе
			Если ДанныеXDTO.КлючевыеСвойства.Свойство("Номер") Тогда
				ДанныеXDTO.КлючевыеСвойства.Номер = НомерОбработанный;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		НомерТекущий = "";
		Если ТолькоКлючевыеСвойства Тогда
			
			НомерТекущий = ДанныеXDTO.Номер;
			
		Иначе
			Если ДанныеXDTO.КлючевыеСвойства.Свойство("Номер") Тогда
				НомерТекущий = ДанныеXDTO.КлючевыеСвойства.Номер;  
			Иначе
				НомерТекущий = "";
			КонецЕсли;                                           
	
		КонецЕсли;
		
		// Алгоритм выгрузки произвольного номера из 12 символов: 
		// - ищем первую цифру, если эта цифра 0, то отрезаем ее и оставшиеся 11 символов отправляем. 
		//   Если первая найденная цифра была не 0 или вообще не было цифр,
		//   то берем справа 11 символов (жертвуем потенциальным символом префикса)
		НомерПриобразован = Ложь;
		Для СчСимволов = 0 по 11 Цикл
			
			СимволНомера = Сред(НомерТекущий, СчСимволов, 1);
			Если СтрНайти("0123456789", СимволНомера) > 0 Тогда
				
				Если СимволНомера = "0" Тогда
					
					ЧастьНомера1 = Лев(НомерТекущий, СчСимволов - 1); 
					ЧастьНомера2 = Сред(НомерТекущий, СчСимволов + 1);
					НомерТекущий = ЧастьНомера1 + ЧастьНомера2;
					НомерПриобразован = Истина;
					
				КонецЕсли;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТолькоКлючевыеСвойства Тогда
			
			ДанныеXDTO.Номер = ?(НомерПриобразован, НомерТекущий, Прав(СокрЛП(ДанныеXDTO.Номер), 11));
			
		Иначе
			Если ДанныеXDTO.КлючевыеСвойства.Свойство("Номер") Тогда
				ДанныеXDTO.КлючевыеСвойства.Номер = ?(НомерПриобразован, НомерТекущий, Прав(СокрЛП(ДанныеXDTO.КлючевыеСвойства.Номер), 11));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТолькоКлючевыеСвойства
		И СтрДлина(ДанныеXDTO.Номер) > 11 Тогда
		
		ДанныеXDTO.Номер = Прав(ДанныеXDTO.Номер, 11);
		
	ИначеЕсли НЕ ТолькоКлючевыеСвойства
		И СтрДлина(ДанныеXDTO.КлючевыеСвойства.Номер) > 11 И ДанныеXDTO.КлючевыеСвойства.Свойство("Номер") Тогда
		ДанныеXDTO.КлючевыеСвойства.Номер = Прав(ДанныеXDTO.КлючевыеСвойства.Номер, 11);
		
	КонецЕсли;
	
	Возврат Истина;
КонецФункции
Функция ПривестиНомерКФормату12(ПолученныеДанные, ДанныеИБ)
	Если ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
		
		Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
			
			// в существующих документах номера не меняем
			ПолученныеДанные.Номер = ДанныеИБ.Номер;
			Возврат Истина;
			
		ИначеЕсли СтрДлина(ДанныеИБ.Номер) < 12
			ИЛИ СокрЛП(ПолученныеДанные.Номер) = СокрЛП(ДанныеИБ.Номер) Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПодстрокиНомера = СтрРазделить(ПолученныеДанные.Номер, "-");
	Если ПодстрокиНомера.Количество() = 2
		И СтрДлина(ПодстрокиНомера[1]) > 0 Тогда
		
		Если Лев(ПодстрокиНомера[1], 1) = "П" Тогда
			
			ПодстрокиНомера[1] = СтрЗаменить(ПодстрокиНомера[1], "П", "П0");
			
		Иначе
			
			ПодстрокиНомера[1] = "0" + ПодстрокиНомера[1];
			
		КонецЕсли;
		
		ПолученныеДанные.Номер = СтрСоединить(ПодстрокиНомера, "-");
		
	КонецЕсли;
	
	Возврат Истина;
КонецФункции
Функция ПризнакПредметаРасчетаПоддерживаетсяВОбмене(ПризнакПредметаРасчета)
	ПризнакПредметаРасчетаПоддерживается = НЕ (ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ);
	 	 Возврат ПризнакПредметаРасчетаПоддерживается
КонецФункции
Процедура ПрисвоитьНаименованиеБанковскогоСчета(ПолученныеДанные, ДанныеИБ)
	Если ДанныеИБ = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДанныеИБ.Наименование) Тогда
		НомерСчета = Прав(СокрЛП(ПолученныеДанные.НомерСчета), 4);
		Если  ЗначениеЗаполнено(ПолученныеДанные.Банк) Тогда
			СтрокаНаименования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%1 в %2 (%3).';
							|en = '%1 in %2 (%3).'"), НомерСчета, ПолученныеДанные.Банк,
						Строка(ПолученныеДанные.ВалютаДенежныхСредств)); 
		Иначе
			СтрокаНаименования = НомерСчета + "(" + Строка(ПолученныеДанные.ВалютаДенежныхСредств) + ")"; 
		КонецЕсли;
		СтрокаНаименования = Лев(СтрокаНаименования, 150);
	
		ПолученныеДанные.Наименование = СтрокаНаименования;
	Иначе
		ПолученныеДанные.Наименование = ДанныеИБ.Наименование;
	КонецЕсли;
КонецПроцедуры
Функция ПроверитьВТаблицахЗадолженностиСуммыРег(Документ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВзаимозачетЗадолженностиДебиторскаяЗадолженность.СуммаРегл КАК СуммаРегл
		|ИЗ
		|	Документ.ВзаимозачетЗадолженности.ДебиторскаяЗадолженность КАК ВзаимозачетЗадолженностиДебиторскаяЗадолженность
		|ГДЕ
		|	ВзаимозачетЗадолженностиДебиторскаяЗадолженность.СуммаРегл = 0
		|	И ВзаимозачетЗадолженностиДебиторскаяЗадолженность.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВзаимозачетЗадолженностиКредиторскаяЗадолженность.СуммаРегл
		|ИЗ
		|	Документ.ВзаимозачетЗадолженности.КредиторскаяЗадолженность КАК ВзаимозачетЗадолженностиКредиторскаяЗадолженность
		|ГДЕ
		|	ВзаимозачетЗадолженностиКредиторскаяЗадолженность.СуммаРегл = 0
		|	И ВзаимозачетЗадолженностиКредиторскаяЗадолженность.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
	    Возврат Истина;
	КонецЕсли; 
	Возврат Ложь;
КонецФункции
Функция ПроверитьДокументОснование(ДанныеИБ, ДокументОснование, ИспользованиеПКО, КомпонентыОбмена)
	// Не поддерживается выгрузка некоторых типов документов, а на версиях формата ED до 1.7 нет возможности
	// корректно выгрузить "ПервичныйДокумент".
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом")
		//++ Локализация
		Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаписьКнигиПродаж")
			Или (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОперацияПоЯндексКассе") 
		И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.10"))
		//-- Локализация
	
		//++ НЕ УТ
		Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВыкупТоваровХранителем")
		//-- НЕ УТ
		Или (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПервичныйДокумент")
			И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.7")) 
		Или ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.СчетФактураВыданный") И ДанныеИБ.РеализацияЧерезКомиссионера 
			И ((ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВозвратТоваровОтКлиента") 
				И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.20"))
				Или ((ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") 
					И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")))) Тогда
					
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
		
		ШаблонПредупреждения = НСтр("ru = 'Документ %1 не может быть выгружен,
			|т.к. формат обмена не поддерживает выгрузку документа,
			|для которых в качестве документа-основания указан %2.';
			|en = 'The %1 document cannot be exported
			|because the exchange format does not support the export of documents
			|for which %2 is specified as the base document.'");
			
		ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ДанныеИБ.Ссылка, Строка(ТипЗнч(ДокументОснование)));
		ПредупреждениеПриСинхронизации(КомпонентыОбмена, ДанныеИБ.Ссылка, ТекстПредупреждения);
		
		Возврат Ложь;
	
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции
//++ Локализация

//++ НЕ УТ
Процедура ПроверитьНаличиеДатПлатежаВРасшифровкеПлатежа(ДанныеXDTO, ПолученныеДанные)
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда  
		Если ДанныеXDTO.AdditionalInfo.Свойство("ТаблицаДатПогашения") Тогда
			ТаблицаДатПогашения = ДанныеXDTO.AdditionalInfo.ТаблицаДатПогашения;   
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ТаблицаДатПогашения", ТаблицаДатПогашения);
			ТаблицаДатПогашения = ПолученныеДанные.ДополнительныеСвойства.ТаблицаДатПогашения;  
			РасшифровкаПлатежа = ПолученныеДанные.ДополнительныеСвойства.РасшифровкаПлатежа;			
			Для каждого Стр Из ТаблицаДатПогашения Цикл  
				Если ТипЗнч(ПолученныеДанные.Ссылка) = ТИП("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
					Для каждого Строка Из РасшифровкаПлатежа Цикл
						Если Строка.Сумма = Стр.Сумма Тогда
							Строка.Вставить("ДатаПогашения", Стр.ДатаПогашения);
							Строка.Вставить("Сумма", Стр.Сумма);
							Продолжить
						КонецЕсли; 
					КонецЦикла;
				Иначе
					Для каждого Строка Из РасшифровкаПлатежа Цикл
						Если Строка.ИдентификаторСтроки = Стр.ИдентификаторСтроки Тогда
							Строка.Вставить("ДатаПогашения", Стр.ДатаПогашения);
							Продолжить
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
