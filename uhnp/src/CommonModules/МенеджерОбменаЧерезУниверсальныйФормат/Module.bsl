Процедура ПКО_Документ_ПКОРозничнаяВыручка_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствИзКассыККМ;
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO); 
	Если ДанныеXDTO.Свойство("Склад") Тогда 
		ДанныеСклада = ДанныеXDTO.Склад; 
		УникальныйИдентификатор = Новый УникальныйИдентификатор(ДанныеСклада.Ссылка.Значение);
		Склад = Справочники.Склады.ПолучитьСсылку(УникальныйИдентификатор);
		Если НЕ ОбщегоНазначения.СсылкаСуществует(Склад) ИЛИ Не ЗначениеЗаполнено(Склад) Тогда
			ТипСклада = строка(ДанныеСклада.ТипСклада.Значение);
			НаименованиеСклада = ДанныеСклада.Наименование;
			Если НЕ Метаданные.Перечисления.ТипыСкладов.ЗначенияПеречисления.Найти(ТипСклада) = Неопределено Тогда
				Попытка
					ЗначениеТипаСклада = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВидыСкладов." + ЗначениеТипаСклада); 
				Исключение
					
				КонецПопытки;   
			ИначеЕсли Найти(Нрег(ДанныеСклада.ТипСклада.Значение), "розничный") > 0 Тогда  
				ЗначениеТипаСклада = ПредопределенноеЗначение("Перечисление.ТипыСкладов.РозничныйМагазин"); 	
			КонецЕсли;
			Если ЗначениеЗаполнено(ЗначениеТипаСклада) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Склады.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Склады КАК Склады
				|ГДЕ
				|	НЕ Склады.ПометкаУдаления
				|	И Склады.ТипСклада = &ТипСклада
				|	И Склады.Наименование = &Наименование";
				
				Запрос.УстановитьПараметр("Наименование", НаименованиеСклада);
				Запрос.УстановитьПараметр("ТипСклада", ЗначениеТипаСклада);
				
				РезультатЗапроса = Запрос.Выполнить();  
				Если РезультатЗапроса.Пустой() Тогда
					Склад = Справочники.Склады.ПустаяСсылка();
				Иначе	
					ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
					
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						Склад =  ВыборкаДетальныеЗаписи.Склад;
					КонецЦикла;
					
				КонецЕсли;
								
			КонецЕсли;
			
		КонецЕсли;
		Если ЗначениеЗаполнено(Склад) Тогда
		   ПолученныеДанные.ДополнительныеСвойства.Вставить("Склад", Склад);
		КонецЕсли;
		
	КонецЕсли;
	ДобавитьПодразделениеВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Документ_ПКОРозничнаяВыручка_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Склад")    
		И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.Склад)Тогда 
		Склад = ПолученныеДанные.ДополнительныеСвойства.Склад;
	Иначе
		Склад = СкладДляЗагрузки(Неопределено, КомпонентыОбмена.ПараметрыКонвертации);
	КонецЕсли;
	Если ЗначениеЗаполнено(Склад) Тогда
	     Если ЗначениеЗаполнено(Склад.РозничныйВидЦены) Тогда
		      ВидЦены = Склад.РозничныйВидЦены; 
			  Если ВидЦены.ИспользоватьПриРозничнойПродаже = Ложь Тогда
			      ОбъектВидЦены = ВидЦены.ПолучитьОбъект();
			  	  ОбъектВидЦены.ИспользоватьПриРозничнойПродаже = Истина;
			      ОбъектВидЦены.Записать();
			  КонецЕсли;
		 КонецЕсли;
	КонецЕсли;
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);	
	СтруктураПоискаКассыККМ = Новый Структура("Организация, Валюта, КассаККМ");
	СтруктураПоискаКассыККМ.Вставить("Склад", Склад);
	ЗаполнитьЗначенияСвойств(СтруктураПоискаКассыККМ, ДанныеДляЗаписиВИБ, "Организация, Валюта, КассаККМ");
	
	ЗаполнитьКассуККМПоВалютеСкладуИОрганизации(СтруктураПоискаКассыККМ, КомпонентыОбмена);
	
	ДанныеДляЗаписиВИБ.КассаККМ = СтруктураПоискаКассыККМ.КассаККМ;
	
	Если ПолученныеДанные.РасшифровкаПлатежа.Количество() = 0 Тогда
		СтрокаРасшифровка = ПолученныеДанные.РасшифровкаПлатежа.Добавить();
	Иначе
		СтрокаРасшифровка = ПолученныеДанные.РасшифровкаПлатежа[0];
	КонецЕсли;
	СтрокаРасшифровка.Сумма = ПолученныеДанные.СуммаДокумента;
	СтрокаРасшифровка.СуммаВзаиморасчетов = ПолученныеДанные.СуммаДокумента;
	СтруктураКурсаВалюты = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ПолученныеДанные.Валюта, ПолученныеДанные.Дата);
	СтрокаРасшифровка.КурсЧислительВзаиморасчетов = СтруктураКурсаВалюты.КурсЧислитель;
	СтрокаРасшифровка.КурсЗнаменательВзаиморасчетов  = СтруктураКурсаВалюты.КурсЗнаменатель;
	СтрокаРасшифровка.СтавкаНДС	= Перечисления.СтавкиНДС.БезНДС;
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
	ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	ДанныеДляЗаписиВИБ.ВТомЧислеНДС = ДенежныеСредстваСервер.ТекстСуммаНДСПлатежа(ДанныеДляЗаписиВИБ.Организация, ДанныеДляЗаписиВИБ.Валюта, ДанныеДляЗаписиВИБ.РасшифровкаПлатежа, Ложь);						
	Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
		
	РеквизитыКассы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДляЗаписиВИБ.Касса, "ВалютаДенежныхСредств, Владелец, Подразделение");
	
	Если РеквизитыКассы.ВалютаДенежныхСредств <> ДанныеДляЗаписиВИБ.Валюта 
		Или РеквизитыКассы.Владелец <> ДанныеДляЗаписиВИБ.Организация Тогда
		
		ПараметрыОтбора = Новый Структура(
			"Валюта,Организация,Подразделение",
			ДанныеДляЗаписиВИБ.Валюта,
			ДанныеДляЗаписиВИБ.Организация,
			Подразделение);
		
		ДанныеДляЗаписиВИБ.Касса = КассаПоУмолчанию(ПараметрыОтбора, КомпонентыОбмена);
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	// Восстанавливаем "затертые" данные
	//РасшифровкаПлатежа
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Сумма");
	МассивКлючевыхПолей.Добавить("СуммаВзаиморасчетов");
	МассивКлючевыхПолей.Добавить("КурсЧислительВзаиморасчетов");
	
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
	ПолученныеДанные.РасшифровкаПлатежа,
	ДанныеИБ.РасшифровкаПлатежа,
	МассивКлючевыхПолей,,
	"СтатьяДвиженияДенежныхСредств, СтавкаНДС");
	ДанныеИБ.РасшифровкаПлатежа.Загрузить(ПолученныеДанные.РасшифровкаПлатежа.Выгрузить());
	ДанныеИБ.ВТомЧислеНДС = ДенежныеСредстваСервер.ТекстСуммаНДСПлатежа(ДанныеИБ.Организация, ДанныеИБ.Валюта, ДанныеИБ.РасшифровкаПлатежа, Ложь);
	ПолученныеДанные = Неопределено;
КонецПроцедуры

Процедура ДобавитьПКО_Документ_ПодключениеКегаКОборудованию_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_ПодключениеКегаКОборудованию_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ПодключениеКегаКОборудованиюРозливаИСМП;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ПодключениеКегаКОборудованиюРозлива"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_ПодключениеКегаКОборудованию_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_ПодключениеКегаКОборудованию_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ПКО_Документ_ПодключениеКегаКОборудованию_Получение_ПослеЗагрузкиВсехДанных";
	ПравилоКонвертации.ВариантИдентификации         = "ПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Дата",            "Дата");
	ДобавитьПКС(СвойстваШапки, "ДатаПодключения", "ДатаПодключения");
	ДобавитьПКС(СвойстваШапки, "КодМаркировки",   "МаркировкаУпаковки", , "Справочник_ШтрихкодыУпаковокТоваров_Получение");
	ДобавитьПКС(СвойстваШапки, "Номер",           "");
	ДобавитьПКС(СвойстваШапки, "Организация",     "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "Подразделение",   "Подразделение", , "Справочник_Подразделения_Получение");
	ДобавитьПКС(СвойстваШапки, "Склад",           "Склад", , "Справочник_Склады_Получение");
	ДобавитьПКС(СвойстваШапки, "СрокРеализации",  "СрокРеализации");
	ПравилоКонвертации.ПоляПоиска.Добавить("КодМаркировки");
КонецПроцедуры
Процедура ПКО_Документ_ПодключениеКегаКОборудованию_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	// адрес не приходит обменом, получим его из склада
	Если НЕ ЗначениеЗаполнено( ПолученныеДанные.Склад)
		И ТипЗнч(КомпонентыОбмена.УзелКорреспондентаОбъект) = Тип("ПланОбменаОбъект.СинхронизацияДанныхЧерезУниверсальныйФормат") Тогда
		ТабКассыККМ = КомпонентыОбмена.УзелКорреспондентаОбъект.КассыККМ;
		Если ТабКассыККМ.Количество() > 0 Тогда
			ПолученныеДанные.Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТабКассыККМ[0].КассаККМ, "Склад");
		КонецЕсли;
	КонецЕсли;
	Адреса = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			ПолученныеДанные.Склад, 
			Перечисления.ТипыКонтактнойИнформации.Адрес, 
			ПолученныеДанные.ДатаПодключения, 
			Ложь);
	Адрес = ?(Адреса.Количество() = 0, Неопределено, Адреса[0]);
	Если Адрес <> Неопределено Тогда
		ПолученныеДанные.АдресПодключения = Адрес.Значение;
		ПолученныеДанные.АдресПодключенияСтрокой = Адрес.Представление;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ПодключениеКегаКОборудованию_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	АдресИБ = Неопределено;
	Если ДанныеИБ <> Неопределено Тогда
		АдресИБ = ДанныеИБ.АдресПодключения;
		Если ПустаяСтрока(АдресИБ) ИЛИ ДанныеИБ.Склад <> ПолученныеДанные.Склад Тогда
			Если ДанныеИБ.АдресПодключения <> ПолученныеДанные.АдресПодключения Тогда
				ДанныеИБ.АдресПодключения = ПолученныеДанные.АдресПодключения;
				ДанныеИБ.АдресПодключенияСтрокой = ПолученныеДанные.АдресПодключенияСтрокой;
			КонецЕсли;
		КонецЕсли;
		ПолученныеДанные.Номер = ДанныеИБ.Номер;
	КонецЕсли;
КонецПроцедуры


