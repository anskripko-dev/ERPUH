//++ НЕ УТ
Процедура ВыгрузитьДатыПогашенияВРасшифровкуПлатежа(ДанныеИБ, ДанныеXDTO, РасшифровкаПлатежа)
	ТаблицаДатПогашения = Новый ТаблицаЗначений;  
	ТаблицаДатПогашения.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36))); 
	ТаблицаДатПогашения.Колонки.Добавить("ДатаПогашения", 		Новый ОписаниеТипов("Дата"));
	Если ТипЗнч(ДанныеИБ) = ТИП("ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		ТаблицаДатПогашения.Колонки.Добавить("Сумма"); 
	КонецЕсли;
	Для каждого СтрокаТЧ Из РасшифровкаПлатежа Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.ДатаПогашения) Тогда 
			НоваяСтрока = ТаблицаДатПогашения.Добавить(); 
			Если ТипЗнч(ДанныеИБ) = ТИП("ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
				НоваяСтрока.Сумма = СтрокаТЧ.Сумма;
			Иначе	
				НоваяСтрока.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
			КонецЕсли; 
			НоваяСтрока.ДатаПогашения = СтрокаТЧ.ДатаПогашения;
		КонецЕсли;
	КонецЦикла;    
	
	Если ТаблицаДатПогашения.Количество() > 0 Тогда
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
			ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
		Иначе
			ДополнительныеДанные = Новый Структура;
		КонецЕсли;
		ДополнительныеДанные.Вставить("ТаблицаДатПогашения", ТаблицаДатПогашения); 
		ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные); 
	КонецЕсли;
КонецПроцедуры
