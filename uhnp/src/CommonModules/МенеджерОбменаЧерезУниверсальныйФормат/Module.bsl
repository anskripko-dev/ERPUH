Процедура ПОД_Документ_ПередачаМатериаловВПроизводство_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ОчиститьИспользованиеПКО(ИспользованиеПКО);
	ИспользованиеПКО.Вставить("Документ_ДвижениеПродИМат_ВПроизводств_Получение", Истина);
	
	//++ Локализация
	ИспользованиеПКО.Вставить("Документ_ПередачаМатериаловВПроизводство_Получение", Истина);
	
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
	
	// В первую очередь анализируем наличие ссылок на существующие объекты.
	Если НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ДвижениеПродукцииИМатериалов") = Неопределено Тогда
		ИспользованиеПКО.Документ_ДвижениеПродИМат_ВПроизводств_Получение = Истина;
	ИначеЕсли НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПередачаМатериаловВПроизводство") = Неопределено Тогда
		ИспользованиеПКО.Документ_ПередачаМатериаловВПроизводство_Получение = Истина;
	ИначеЕсли НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПеремещениеТоваров") = Неопределено Тогда
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
	ИначеЕсли НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПроизводствоБезЗаказа") = Неопределено Тогда
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
	Иначе
		ИспользоватьУправлениеПроизводством2_2 = ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2");
		
		ИспользованиеПКО.Документ_ДвижениеПродИМат_ВПроизводств_Получение   = ИспользоватьУправлениеПроизводством2_2;
		ИспользованиеПКО.Документ_ПередачаМатериаловВПроизводство_Получение = НЕ ИспользоватьУправлениеПроизводством2_2;
			
	КонецЕсли;
	//-- Локализация
КонецПроцедуры

