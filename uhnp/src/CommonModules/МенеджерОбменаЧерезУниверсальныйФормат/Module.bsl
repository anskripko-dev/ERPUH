Функция ПатентДляВыгрузки(Организация, Подразделение)
	Патент = Справочники.Патенты.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Патенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Патенты.ПрименениеПатента КАК ПатентыПрименениеПатента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Патенты КАК Патенты
	|		ПО ПатентыПрименениеПатента.Ссылка = Патенты.Ссылка
	|ГДЕ
	|	НЕ Патенты.ПометкаУдаления
	|	И Патенты.Владелец = &Организация
	|	И ПатентыПрименениеПатента.Подразделение = &Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Патенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Патенты.ПрименениеПатента КАК ПатентыПрименениеПатента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Патенты КАК Патенты
	|		ПО ПатентыПрименениеПатента.Ссылка = Патенты.Ссылка
	|ГДЕ
	|	НЕ Патенты.ПометкаУдаления
	|	И Патенты.Владелец = &Организация
	|	И ПатентыПрименениеПатента.Подразделение В ИЕРАРХИИ(&Подразделение)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет(); 
	Если РезультатЗапроса[0].Пустой() 
		И РезультатЗапроса[1].Пустой() Тогда
		Возврат Патент
	КонецЕсли; 
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() = 1 Тогда
		Выборка = ВыборкаДетальныеЗаписи;		
	Иначе 
		ВыборкаДетальныеЗаписиИерархия = РезультатЗапроса[1].Выбрать();
		Если ВыборкаДетальныеЗаписиИерархия.Количество() = 1 Тогда	
			Выборка = ВыборкаДетальныеЗаписиИерархия;
		КонецЕсли;
	КонецЕсли;
	
	Если Выборка = Неопределено Тогда
	    Возврат Патент
	КонецЕсли;
		
	Выборка.Следующий();
	Если Выборка.Количество() > 0 Тогда
		Патент = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Патент
КонецФункции

// Параметры:
//	УзелОбменаРМК - ПланОбменаСсылка.СинхронизацияДанныхЧерезУниверсальныйФормат
//	КонтрольныйПатент - СправочникСсылка.Патенты
// Возвращаемое значение:
//	Массив из СправочникСсылка.Патенты
Функция ПатентыДляВыгрузкиВРМК(Знач УзелОбменаРМК, Знач КонтрольныйПатент = Неопределено)
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("УзелОбменаРМК", УзелОбменаРМК);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ.КассаККМ.Владелец Как Организация,
	|	СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ.КассаККМ.Подразделение КАК Подразделение
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.КассыККМ КАК
	|		СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ
	|ГДЕ
	|	СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ.Ссылка = &УзелОбменаРМК";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Патенты = Справочники.Патенты.ПолучитьПатентыПоОрганизации(Выборка.Организация, Выборка.Подразделение, ТекущаяДатаСеанса());		
		Для Каждого ЭлемПатент Из Патенты Цикл
			Если Результат.Найти(ЭлемПатент) = Неопределено Тогда
				Результат.Добавить(ЭлемПатент);
			КонецЕсли; 
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
