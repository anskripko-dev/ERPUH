Процедура ДобавитьПКО_Документ_ВыдачаДДПодотчет_Отправка(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Документ_ВыдачаДДПодотчет_Отправка";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.Документы.ВыбытиеДенежныхДокументов;
	ПравилоКонвертации.ОбъектФормата     = "Документ.ВыдачаДенежныхДокументовПодотчетнику"; //@NON-NLS-1
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_ВыдачаДДПодотчет_Отправка_ПриОтправкеДанных";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "",                "Валюта", 1, "Справочник_Валюты");
	ДобавитьПКС(СвойстваШапки, "Дата",            "Дата");
	ДобавитьПКС(СвойстваШапки, "Комментарий",     "Комментарий");
	ДобавитьПКС(СвойстваШапки, "Номер",           "Номер");
	ДобавитьПКС(СвойстваШапки, "Организация",     "Организация", , "Справочник_Организации_Отправка");
	ДобавитьПКС(СвойстваШапки, "Ответственный",   "Ответственный", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "ПодотчетноеЛицо", "ПодотчетноеЛицо", , "Справочник_ФизическиеЛица_Отправка");
	ДобавитьПКС(СвойстваШапки, "Подразделение",   "Подразделение", , "Справочник_Подразделения_Отправка");
	ДобавитьПКС(СвойстваШапки, "СтатьяДоходов",   "СтатьяДоходов", , "Справочник_СтатьиДоходов");
	ДобавитьПКС(СвойстваШапки, "СтатьяРасходов",  "СтатьяРасходов", 1);
	ДобавитьПКС(СвойстваШапки, "СуммаДокумента",  "Сумма");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "ДенежныеДокументы");
	ДобавитьПКС(СвойстваТЧ, "", "ДенежныйДокумент", 1, "Справочник_ДенежныеДокументы_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Стоимость", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "ДополнительныеРеквизиты");
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеСвойства", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Свойство", 1, "Справочник_ДополнительныеРеквизиты");

КонецПроцедуры
Процедура ПКО_Документ_ВыдачаДДПодотчет_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	СтатьяРасходовИнструкция = Новый Структура("Значение, ИмяПКО", ДанныеИБ.СтатьяРасходов, "Справочник_СтатьиРасходов");
	ДанныеXDTO.Вставить("СтатьяРасходов", СтатьяРасходовИнструкция);
	
	ДанныеXDTO.Вставить("Валюта", ДанныеИБ.ДополнительныеСвойства.Валюта);
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	ТЧДенежныеДокументы = ДанныеИБ.ДополнительныеСвойства.ТЧДенежныеДокументы;
	ДанныеXDTO.Вставить("ДенежныеДокументы", ТЧДенежныеДокументы);
КонецПроцедуры

