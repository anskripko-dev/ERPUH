		ТаблицаУслугЗаполнитьПринципала(КомпонентыОбмена, ТабУслуги);
		
		Товары = РезультатыЗапроса[1].Выгрузить();
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары);
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда   
			ПереопределитьСтавкуНДСДляСтарыхФорматов(ТабУслуги, Ложь);
		КонецЕсли;
		ДанныеXDTO.Вставить("Услуги", ТабУслуги);
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.Цена КАК Цена,
		|	ВЫБОР
		|		КОГДА Товары.ТипНалогообложения = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС)
		|			ТОГДА Товары.ТоварыСтавкаНДС
		|		ИНАЧЕ Товары.СтавкаНДС
		|	КОНЕЦ КАК СтавкаНДС,
		|	Товары.ТипЗапасов КАК ТипЗапасов,
		|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
		|	Товары.Количество КАК Количество,
		|	Товары.Сумма КАК Сумма,
		|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	Товары.СуммаНДС КАК СуммаНДС,
		|	&ТекстЗапросаХарактеристика,
		|	&ТекстЗапросаСерия,
		|	&ТекстЗапросаУпаковка,
		|	&ТекстЗапросаРНПТ,
		|	&ТекстЗапросаГТД
		|ИЗ
		|	ТаблицаТовары КАК Товары
		|ГДЕ
		|	Товары.НоменклатураТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
		|			И Товары.НоменклатураТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки";
		
		ЗаполнитьСобственныеТоварыВТексте(Запрос.Текст);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "Товары"));
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаУпаковка",
		ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "Товары"));
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаСерия",
		ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "Товары"));
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаРНПТ",
		ПолучитьТекстЗапросаРНПТ(КомпонентыОбмена, "Товары"));
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаГТД",
		ПолучитьТекстЗапросаГТД(КомпонентыОбмена, "Товары"));
		
		Товары = Запрос.Выполнить().Выгрузить();
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары);
		
		
	КонецЕсли; 
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда   
		 ПереопределитьСтавкуНДСДляСтарыхФорматов(Товары, Ложь);
	КонецЕсли;
	ДанныеXDTO.Вставить("Товары", Товары);
	
	//++ Локализация
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		Если ДанныеИБ.УказыватьНомераГТД Тогда
			ИмяТаблицы = "Документ.ПередачаТоваровМеждуОрганизациями.Товары";
			ИдентификаторыИзВидовЗапасов = Ложь;
		Иначе
			ИмяТаблицы = "Документ.ПередачаТоваровМеждуОрганизациями.ВидыЗапасов";	
			ИдентификаторыИзВидовЗапасов = Истина;
		КонецЕсли; 
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов);  
	КонецЕсли;  
	//-- Локализация
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
КонецПроцедуры

