		|	ВТ_Итоговая.СтранаПроисхождения,
		|	ВТ_Итоговая.ЯвляетсяРНПТ,
		|	ВТ_Итоговая.НомерГТД,
		|	ВТ_Итоговая.Ссылка,
		|	ВТ_ИдентификаторыСтрок.ИдентификаторСтроки,
		|	ВТ_Итоговая.ИдентификаторСтроки";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТабличнаяЧастьТовары", СтрЗаменить(ИмяТаблицы, ИмяТаблицыСтрокой, "Товары")); 
		Если МетаданныеТабличныхЧастей.Товары.Реквизиты.Найти("Серия") = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТовары.Серия", "Значение(Справочник.СерииНоменклатуры.ПустаяСсылка)");
		КонецЕсли;
	КонецЕсли; 
	Попытка
		СведенияПрослеживаемости = Запрос.Выполнить().Выгрузить();
	Исключение
		СведенияПрослеживаемости = Неопределено;
	КонецПопытки;
	Если НЕ СведенияПрослеживаемости = Неопределено И НЕ СведенияПрослеживаемости.Количество() = 0 Тогда
		ДанныеXDTO.Вставить("СведенияРНПТ", СведенияПрослеживаемости);
	КонецЕсли;
КонецПроцедуры
//-- Локализация
Процедура ПолучитьСведенияРНПТКорректировкиПриобретения(ДанныеИБ, ДанныеXDTO)
	Если НЕ ЗначениеЗаполнено(ДанныеИБ.ДокументОснование) Тогда
		Возврат;
	КонецЕсли; 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КорректировкаПриобретенияРасхождения.НомерГТД КАК НомерГТД,
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры.Серия КАК Серия,
		|	СУММА(КорректировкаПриобретенияРасхождения.КоличествоПоРНПТ) КАК КоличествоПоРНПТ,
		|	СУММА(КорректировкаПриобретенияРасхождения.Количество) КАК Количество,
		|	""Оприходование"" КАК Операция,
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	КорректировкаПриобретенияРасхождения.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ ВТ_КорректировкаПриобретения
		|ИЗ
		|	Документ.КорректировкаПриобретения.Расхождения КАК КорректировкаПриобретенияРасхождения
		|ГДЕ
		|	КорректировкаПриобретенияРасхождения.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры,
		|	КорректировкаПриобретенияРасхождения.НомерГТД,
		|	КорректировкаПриобретенияРасхождения.Упаковка,
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры.Номенклатура,
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры.Характеристика,
		|	КорректировкаПриобретенияРасхождения.АналитикаУчетаНоменклатуры.Серия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриобретениеТоваровУслугТовары.Количество КАК Количество,
		|	ПриобретениеТоваровУслугТовары.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	ПриобретениеТоваровУслугТовары.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|	ПриобретениеТоваровУслугТовары.АналитикаУчетаНоменклатуры.Серия КАК Серия,
		|	ПриобретениеТоваровУслугТовары.НомерГТД КАК НомерГТД,
		|	ПриобретениеТоваровУслугТовары.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
		|	ПриобретениеТоваровУслугТовары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	ПриобретениеТоваровУслугТовары.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ ВТ_Приобретение
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		|ГДЕ
		|	ПриобретениеТоваровУслугТовары.Ссылка = &Приобретение
		|	И ПриобретениеТоваровУслугТовары.АналитикаУчетаНоменклатуры.Номенклатура В
		|			(ВЫБРАТЬ
		|				ВТ_КорректировкаПриобретения.Номенклатура
		|			ИЗ
		|				ВТ_КорректировкаПриобретения)
		|	И ПриобретениеТоваровУслугТовары.АналитикаУчетаНоменклатуры.Характеристика В
		|			(ВЫБРАТЬ
		|				ВТ_КорректировкаПриобретения.Характеристика
		|			ИЗ
		|				ВТ_КорректировкаПриобретения)
		|	И ПриобретениеТоваровУслугТовары.АналитикаУчетаНоменклатуры.Серия В
		|			(ВЫБРАТЬ
		|				ВТ_КорректировкаПриобретения.Серия
		|			ИЗ
		|			ВТ_КорректировкаПриобретения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Приобретение.Номенклатура КАК Номенклатура,
		|	ВТ_Приобретение.Характеристика КАК Характеристика,
		|	ВТ_Приобретение.Серия КАК Серия,
		|	ВТ_Приобретение.НомерГТД КАК НомерГТДРеализация,
		|	ЕСТЬNULL(ВТ_КорректировкаПриобретения.НомерГТД, """") КАК НомерГТДКорректировка,
		|	ЕСТЬNULL(ВТ_Приобретение.КоличествоПоРНПТ, 0) + ЕСТЬNULL(ВТ_КорректировкаПриобретения.КоличествоПоРНПТ, 0) КАК КоличествоПоРНПТИтог,
		|	ЕСТЬNULL(ВТ_Приобретение.Количество, 0) + ЕСТЬNULL(ВТ_КорректировкаПриобретения.Количество, 0) КАК КоличествоИтог,
		|	ВТ_Приобретение.Количество КАК КоличествоИсходное,
		|	ВТ_Приобретение.КоличествоПоРНПТ КАК КоличествоПоРНПТИсходное,
		|	ЕСТЬNULL(ВТ_КорректировкаПриобретения.Количество, 0) КАК КоличествоВКоректировке,
		|	ЕСТЬNULL(ВТ_КорректировкаПриобретения.КоличествоПоРНПТ, 0) КАК КоличествоПоРНПТКорректировка,
		|	ЕСТЬNULL(ВТ_КорректировкаПриобретения.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК УпаковкаКорректировка,
		|	ВТ_Приобретение.Упаковка КАК УпаковкаРеализация,
		|	ВТ_КорректировкаПриобретения.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
		|	ВТ_Приобретение.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар КАК РеализацияПрослеживаемыйТовар
		|ПОМЕСТИТЬ ВТ_Общая
		|ИЗ
		|	ВТ_Приобретение КАК ВТ_Приобретение
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КорректировкаПриобретения КАК ВТ_КорректировкаПриобретения
		|		ПО (ВТ_КорректировкаПриобретения.АналитикаУчетаНоменклатуры = ВТ_Приобретение.АналитикаУчетаНоменклатуры)
		|			И (ВТ_КорректировкаПриобретения.НомерГТД = ВТ_Приобретение.НомерГТД)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""ИсходныеСведения"" КАК ТипКорректировочнойСтроки,
		|	ВТ_Общая.Номенклатура КАК Номенклатура,
