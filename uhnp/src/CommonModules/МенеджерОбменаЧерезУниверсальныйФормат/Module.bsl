Процедура ПКО_Документ_ВнутреннееПотребление_ВЭксплуатацию_Отпра_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	СкладДляВыгрузки = СкладДляВыгрузки(ДанныеИБ.Склад, КомпонентыОбмена.ПараметрыКонвертации);
	ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
	
	ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, "Склад");
	
	ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Ложь, Ложь);
	
	ТекстЗапроса =
		"ВЫБРАТЬ
			|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
			|	Товары.Номенклатура КАК Номенклатура,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаУпаковка,
			|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Товары.Количество КАК Количество,
			|	&ТипЗапасов КАК ТипЗапасов,
			|	Товары.ФизическоеЛицо КАК ФизическоеЛицо,
			|	Товары.Ссылка.Подразделение КАК Подразделение,
			|	Товары.СтатьяРасходов.КорреспондирующийСчет КАК СтатьяРасходовКорСчет,
			|	Товары.СтатьяРасходов.Наименование КАК СтатьяРасходовНаименование,
			//++ Локализация
			|	Товары.КатегорияЭксплуатации.СрокЭксплуатации КАК СрокЭксплуатации,
			|	Товары.КатегорияЭксплуатации.Наименование КАК КатегорияЭксплуатацииНаименование,
			//++ НЕ УТ
			|	ЕСТЬNULL(НастройкиПоОрганизацииТМЦВЭксплуатации.СчетУчета.Код, ЕСТЬNULL(НастройкиПоАналитикеТМЦВЭксплуатации.СчетУчета.Код, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка))) КАК СчетПередачи,
			|	ЕСТЬNULL(НастройкиПоМестуУчетаРасходы.СчетУчета.Код, ЕСТЬNULL(НастройкиПоОрганизацииРасходы.СчетУчета.Код, ЕСТЬNULL(НастройкиПоАналитикеРасходы.СчетУчета.Код, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)))) КАК СчетЗатрат,
			|	КатегорииЭксплуатации.СпособПогашенияСтоимостиБУ КАК СпособПогашенияСтоимостиТМЦ,
			//-- НЕ УТ
			
			//-- Локализация
			|	Товары.СтатьяРасходов КАК СтатьяЗатрат,
			|	Товары.ИнвентарныйНомер КАК ИнвентарныйНомер
			|ИЗ
			|	Документ.ВнутреннееПотребление.Товары КАК Товары
			//++ Локализация
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииЭксплуатации КАК КатегорииЭксплуатации
			|		ПО Товары.КатегорияЭксплуатации = КатегорииЭксплуатации.Ссылка
			//++ НЕ УТ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК НастройкиПоОрганизацииТМЦВЭксплуатации
			|		ПО (НастройкиПоОрганизацииТМЦВЭксплуатации.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ТМЦВЭксплуатации))
			|			И (НастройкиПоОрганизацииТМЦВЭксплуатации.Организация = Товары.Ссылка.Организация)
			|			И (НастройкиПоОрганизацииТМЦВЭксплуатации.АналитикаУчета = Товары.КатегорияЭксплуатации)
			|			И (НастройкиПоОрганизацииТМЦВЭксплуатации.МестоУчета = НЕОПРЕДЕЛЕНО)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК НастройкиПоАналитикеТМЦВЭксплуатации
			|		ПО (НастройкиПоАналитикеТМЦВЭксплуатации.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ТМЦВЭксплуатации))
			|			И (НастройкиПоАналитикеТМЦВЭксплуатации.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
			|			И (НастройкиПоАналитикеТМЦВЭксплуатации.АналитикаУчета = Товары.КатегорияЭксплуатации)
			|			И (НастройкиПоАналитикеТМЦВЭксплуатации.МестоУчета = НЕОПРЕДЕЛЕНО)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК НастройкиПоМестуУчетаРасходы
			|		ПО (НастройкиПоМестуУчетаРасходы.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.Расходы))
			|			И (НастройкиПоМестуУчетаРасходы.Организация = Товары.Ссылка.Организация)
			|			И (НастройкиПоМестуУчетаРасходы.АналитикаУчета = Товары.СтатьяРасходов.ГруппаФинансовогоУчетаРегл)
			|			И (НастройкиПоМестуУчетаРасходы.МестоУчета = Товары.Ссылка.Подразделение)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК НастройкиПоОрганизацииРасходы
			|		ПО (НастройкиПоОрганизацииРасходы.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.Расходы))
			|			И (НастройкиПоОрганизацииРасходы.Организация = Товары.Ссылка.Организация)
			|			И (НастройкиПоОрганизацииРасходы.АналитикаУчета = Товары.СтатьяРасходов.ГруппаФинансовогоУчетаРегл)
			|			И (НастройкиПоОрганизацииРасходы.МестоУчета = НЕОПРЕДЕЛЕНО)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК НастройкиПоАналитикеРасходы
			|		ПО (НастройкиПоАналитикеРасходы.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.Расходы))
			|			И (НастройкиПоАналитикеРасходы.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
			|			И (НастройкиПоАналитикеРасходы.АналитикаУчета = Товары.СтатьяРасходов.ГруппаФинансовогоУчетаРегл)
			|			И (НастройкиПоАналитикеРасходы.МестоУчета = НЕОПРЕДЕЛЕНО)
			//-- НЕ УТ
			
			//-- Локализация
			|ГДЕ
			|	Товары.Ссылка = &Ссылка";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "Товары"));
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаУпаковка",
		ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "Товары"));
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
		ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "Товары"));
	
	ТипЗапасовВЗапросе = "&СобственныеТовары";
	//++ НЕ УТ
	
	//++ Локализация
	ТипЗапасовВЗапросе ="ВЫБОР 
						 |		КОГДА ЕСТЬNULL(НастройкиПоОрганизацииТМЦВЭксплуатации.СчетУчета, 
						 |				НастройкиПоАналитикеТМЦВЭксплуатации.СчетУчета) = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИнвентарьВЭксплуатации)
						 |			ТОГДА ""ИнвентарьИХозяйственныеПринадлежности""
						 |		ИНАЧЕ &СобственныеТовары
						 |	КОНЕЦ";
	//-- Локализация
	
	//-- НЕ УТ
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипЗапасов", ТипЗапасовВЗапросе);
	
	ЗаполнитьСобственныеТоварыВТексте(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	ТаблицаТовары = Запрос.Выполнить().Выгрузить();
	ТаблицаТовары.Колонки.Добавить("НаименованиеНазначенияИспользования");
	ТаблицаТовары.Колонки.Добавить("НаименованиеСпособаОтраженияРасходов");
	ТаблицаТовары.Колонки.Добавить("ПодразделениеЗатрат");
	
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, ТаблицаТовары);
	
	Для Каждого Строка Из ТаблицаТовары Цикл
		
		//++ Локализация
		Строка.НаименованиеНазначенияИспользования  = Строка.КатегорияЭксплуатацииНаименование;
		//-- Локализация
		Строка.НаименованиеСпособаОтраженияРасходов = Строка.СтатьяРасходовНаименование;
	
		Если ЗначениеЗаполнено(Строка.СтатьяРасходовКорСчет) Тогда
			НаименованиеСпособаОтраженияРасходов = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	    		НСтр("ru = '%1 счет( %2)';
					|en = '%1 account( %2)'"),
	    		СокрЛП(Строка.НаименованиеСпособаОтраженияРасходов),
	    		Строка.СтатьяРасходовКорСчет);
			Строка.НаименованиеСпособаОтраженияРасходов = НаименованиеСпособаОтраженияРасходов;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Подразделение) Тогда
			СтруктураПодразделение = Новый Структура;
			ВыгрузитьПодразделение(ДанныеИБ, СтруктураПодразделение, Строка.Подразделение);
			Строка.ПодразделениеЗатрат = СтруктураПодразделение.Подразделение;
		КонецЕсли;
	
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Товары", ТаблицаТовары);
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
		ЗаполнитьСерииПоДокументу(ДанныеИБ.Ссылка, "Документ.ВнутреннееПотребление.Серии", ДанныеXDTO);
	КонецЕсли;
КонецПроцедуры

