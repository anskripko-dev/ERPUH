Функция НастройкаСчетовУчетаПрочихОпераций(ПараметрыНастройки, ВладелецНастройки)
	НастройкаСчетовУчетаПрочихОпераций = Справочники.НастройкиСчетовУчетаПрочихОпераций.ПустаяСсылка();
	
	Запрос = Новый Запрос("
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	НастройкиСчетовУчетаПрочихОпераций.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.НастройкиСчетовУчетаПрочихОпераций КАК НастройкиСчетовУчетаПрочихОпераций
			|ГДЕ
			|	НастройкиСчетовУчетаПрочихОпераций.ВладелецНастройки = &ВладелецНастройки
			|");
	
	ЕстьЗаполненныйПараметр = Ложь;
	ДобавочноеУсловие = "";
				
	Для Каждого ПараметрНастройки Из ПараметрыНастройки Цикл
		
		Если ЗначениеЗаполнено(ПараметрНастройки.Значение) Тогда
			ЕстьЗаполненныйПараметр = Истина;
			
			ДобавочноеУсловие = ДобавочноеУсловие + Символы.ПС + Символы.Таб +
				"И НастройкиСчетовУчетаПрочихОпераций." + ПараметрНастройки.Ключ + " = &" + ПараметрНастройки.Ключ;
				
			Запрос.УстановитьПараметр(ПараметрНастройки.Ключ, ПараметрНастройки.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьЗаполненныйПараметр Тогда
		
		Запрос.УстановитьПараметр("ВладелецНастройки", ВладелецНастройки);
		Запрос.Текст = Запрос.Текст + ДобавочноеУсловие;
		
		Выборка = Запрос.Выполнить().Выбрать();
	
		Если Выборка.Следующий() Тогда
			// Настройка счетов учета прочих операций найдена в базе
			НастройкаСчетовУчетаПрочихОпераций = Выборка.Ссылка;
		Иначе
			// Создаем новую настройку счетов учета
			НастройкаСчетовУчетаПрочихОперацийОбъект = Справочники.НастройкиСчетовУчетаПрочихОпераций.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НастройкаСчетовУчетаПрочихОперацийОбъект, ПараметрыНастройки);
	        НастройкаСчетовУчетаПрочихОперацийОбъект.ВладелецНастройки = ВладелецНастройки;
			НастройкаСчетовУчетаПрочихОперацийОбъект.Записать();
			НастройкаСчетовУчетаПрочихОпераций = НастройкаСчетовУчетаПрочихОперацийОбъект.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НастройкаСчетовУчетаПрочихОпераций;
КонецФункции
//-- НЕ УТ

