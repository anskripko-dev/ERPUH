Процедура ПКО_Документ_ВыкупТоваров_Возврат_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Префикс = "R";
	//++ Локализация
	Префикс = "В";
	//-- Локализация
	
	НомерДок = Лев(ДанныеИБ.Номер, 5) + Префикс + Сред(ДанныеИБ.Номер, 7);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", НомерДок);
	
	Товары = ДанныеИБ.ДополнительныеСвойства.Товары.Скопировать();
	Склад = ДанныеИБ.ДополнительныеСвойства.Склад;
	
	//++ Локализация
	ВерсияФормата17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыкупПринятыхНаХранениеТоваровТовары.НомерСтроки КАК НомерСтроки,
		|	ВыкупПринятыхНаХранениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	ВыкупПринятыхНаХранениеТоваровТовары.СтавкаНДС.ПеречислениеСтавкаНДС КАК СтавкаНДС,
		|	ВыкупПринятыхНаХранениеТоваровТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ВыкупПринятыхНаХранениеТоваровТовары.Ссылка.ЦенаВключаетНДС КАК ЦенаВключаетНДС
		|ИЗ
		|	Документ.ВыкупПринятыхНаХранениеТоваров.Товары КАК ВыкупПринятыхНаХранениеТоваровТовары
		|ГДЕ
		|	ВыкупПринятыхНаХранениеТоваровТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ВерсияФормата17ИВыше", ВерсияФормата17ИВыше);	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеОСтавкахНДС = РезультатЗапроса.Выгрузить(); 
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)= Тип("Структура") Тогда
		ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
	Иначе
		ДополнительныеДанные = Новый Структура;
	КонецЕсли;    
	  	ДополнительныеДанные.Вставить("ДанныеОСтавкахНДС", ДанныеОСтавкахНДС); 
	ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		ИмяТаблицы = "Документ.ВыкупПринятыхНаХранениеТоваров.ВидыЗапасов"; 
		ИдентификаторыИзВидовЗапасов = Истина;
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов);
	КонецЕсли;
	//-- Локализация
	
	Если ЗначениеЗаполнено(Склад) Тогда
		
		СкладДляВыгрузки = СкладДляВыгрузки(Склад, КомпонентыОбмена.ПараметрыКонвертации);
		ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
		СтруктураДаныеИБ = Новый Структура;
		СтруктураДаныеИБ.Вставить("Склад", СкладДляВыгрузки);
		СтруктураДаныеИБ.Вставить("Подразделение", ДанныеИБ.Подразделение);
		ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, СтруктураДаныеИБ, ДанныеXDTO, "Склад");
		
	КонецЕсли;
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	ДанныеXDTO.Вставить("Сумма",ДанныеИБ.СуммаДокумента);
	ДанныеXDTO.Вставить("Товары", Товары);
КонецПроцедуры

