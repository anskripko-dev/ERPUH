Функция БухгалтерскийСчетПоКоду(КодСчета, СчетПоУмолчанию = Неопределено)
	Если Не ЗначениеЗаполнено(СчетПоУмолчанию) Тогда
		СчетПоУмолчанию = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КодСчета) Тогда
		Возврат СчетПоУмолчанию;
	КонецЕсли;
	
	РезультатПоиска = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчета);
	Если ЗначениеЗаполнено(РезультатПоиска) Тогда
		Возврат РезультатПоиска;
	ИначеЕсли СтрНайти(КодСчета, ".") = 0 Тогда
		Возврат СчетПоУмолчанию;
	КонецЕсли;
	
	// Поиск по непосредственному родителю счета
	СчетВВидеМассива = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КодСчета, ".");
	
	КодРодителя = "";
	Для Сч = 0 По СчетВВидеМассива.Количество() - 2 Цикл
		КодРодителя = КодРодителя + СчетВВидеМассива[Сч] + ".";
	КонецЦикла;
	КодРодителя = Лев(КодРодителя, СтрДлина(КодРодителя) - 1);
	
	РезультатПоиска = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодРодителя);
	Если ЗначениеЗаполнено(РезультатПоиска) Тогда
		Возврат РезультатПоиска;
	КонецЕсли;
	
	Возврат СчетПоУмолчанию;
КонецФункции
