Процедура ПКО_Документ_ОтчетПереработчика25_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_ОтчетПереработчика25_Отправка", 
										"Услуги", 
										"СтавкаНДС",
										Истина,
										"СправочникСсылка_СтавкиНДС_Отправка");
	КонецЕсли;
	ВыгрузитьПодразделение(ДанныеИБ, ДанныеXDTO);
	ДанныеXDTO.Вставить("ПодразделениеЗатрат", ДанныеXDTO.Подразделение); 
	
	ЗапросАналитикаУчетаНоменклатуры = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОтчетПереработчикаПродукция.Номенклатура.ГруппаАналитическогоУчета КАК НоменклатураГруппаАналитическогоУчета
		|ИЗ
		|	Документ.ОтчетПереработчика2_5.ВыходныеИзделия КАК ОтчетПереработчикаПродукция
		|ГДЕ
		|	ОтчетПереработчикаПродукция.Ссылка = &Ссылка");
	ЗапросАналитикаУчетаНоменклатуры.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	ВыборкаАналитикаУчетаНоменклатуры = ЗапросАналитикаУчетаНоменклатуры.Выполнить().Выбрать();
	Если ВыборкаАналитикаУчетаНоменклатуры.Количество() = 1 Тогда
		ВыборкаАналитикаУчетаНоменклатуры.Следующий();
		ДанныеXDTO.Вставить(
			"ГруппаАналитическогоУчетаНоменклатуры", 
			ВыборкаАналитикаУчетаНоменклатуры.НоменклатураГруппаАналитическогоУчета);
	КонецЕсли;
	
	//++ Локализация
	НастройкаСчетовУчетаПроизводстваПоГруппамПродукции = ПолучитьФункциональнуюОпцию("НастройкаСчетовУчетаПроизводстваПоГруппамПродукции");
	
	// Если счета учета производства хранятся в разрезе групп аналитического учета, то выгрузить его мы можем тогда, когда группа заполнена.
	ВыгружатьСчет = Не НастройкаСчетовУчетаПроизводстваПоГруппамПродукции Или ДанныеXDTO.Свойство("ГруппаАналитическогоУчетаНоменклатуры");
	
	Если ВыгружатьСчет Тогда 
		
		СтруктураИзмерений = НастройкаСчетовУчетаКлиентСервер.ИнициализироватьСтруктуруИзмеренийРегистра();
		СтруктураИзмерений.Организация    = ДанныеИБ.Организация;
		СтруктураИзмерений.МестоУчета     = ДанныеИБ.Подразделение;
		СтруктураИзмерений.АналитикаУчета = ?(НастройкаСчетовУчетаПроизводстваПоГруппамПродукции,
											ДанныеXDTO.ГруппаАналитическогоУчетаНоменклатуры,
											Справочники.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка());		
	
		ИменаНастроекСчетовУчета = Новый Массив;
		ИменаНастроекСчетовУчета.Добавить("Производство");
	
		СчетУчета = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.НастройкаОтраженияРаздела("", СтруктураИзмерений, ИменаНастроекСчетовУчета);
		Если ЗначениеЗаполнено(СчетУчета) И СчетУчета.Свойство("Производство") Тогда
			ДанныеXDTO.Вставить("СчетЗатрат", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета.Производство, "Код"));
		КонецЕсли;
	
	КонецЕсли;
	//-- Локализация
	
	ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина, Ложь);
	
	// Дополнительные свойства для договора
	Если ЗначениеЗаполнено(ДанныеИБ.Договор) Тогда
		ДанныеXDTO.Вставить("Договор", ДанныеИБ.Договор);
	Иначе
		ПараметрыПоУмолчанию = Новый Структура(ДоговорФиксированнаяСтруктураКлючей());
		ЗаполнитьЗначенияСвойств(ПараметрыПоУмолчанию, ДанныеИБ, "Контрагент, Организация");
		ПараметрыПоУмолчанию.РасчетыВУсловныхЕдиницах = Ложь;
		ПараметрыПоУмолчанию.ВалютаВзаиморасчетов = ДанныеИБ.Валюта;
		ПараметрыПоУмолчанию.ВидДоговора = "СПоставщиком";
		ДанныеXDTO.Вставить("Договор", ДоговорИнструкцияКонвертацииПоДаннымВзаиморасчетов(ПараметрыПоУмолчанию, КомпонентыОбмена));
	КонецЕсли;
	
	ДанныеДокумента =
		"ВЫБРАТЬ
		|	Услуги.Номенклатура КАК Номенклатура,
		|	Услуги.Номенклатура.Наименование КАК Содержание,
		|	Услуги.СтавкаНДС КАК СтавкаНДС,
		|	Услуги.Количество КАК Количество,
		|	Услуги.Сумма КАК Сумма,
		|	Услуги.Цена КАК Цена,
		|	Услуги.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	Документ.ОтчетПереработчика2_5.Услуги КАК Услуги
		|ГДЕ
		|	Услуги.Ссылка = &Ссылка
		|	И Услуги.Ссылка.УслугиПоПереработке = ЗНАЧЕНИЕ(Перечисление.ВариантыОформленияУслугДокументовПереработки.УказываютсяВЗаказеОтчете)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|	&ТекстЗапросаХарактеристика,
		|	&ТекстЗапросаСерия,
		|	ВложенныйЗапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВложенныйЗапрос.Количество КАК Количество,
		|	ВложенныйЗапрос.ТипЗапасов КАК ТипЗапасов
		|ИЗ
		|	(ВЫБРАТЬ
		|		Материалы.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|		Материалы.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|		Материалы.АналитикаУчетаНоменклатуры.Серия КАК Серия,
		|		Материалы.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|		СУММА(Материалы.Количество) КАК Количество,
		|		ВЫБОР
		|			КОГДА Материалы.АналитикаУчетаНоменклатуры.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
		|				ТОГДА ВЫРАЗИТЬ(""ВозвратнаяТара"" КАК СТРОКА(20))
		|			КОГДА Материалы.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
		|				ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
		|			ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
		|		КОНЕЦ КАК ТипЗапасов
		|	ИЗ
		|		Документ.ОтчетПереработчика2_5.ВидыЗапасовМатериалы КАК Материалы
		|	ГДЕ
		|		Материалы.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Материалы.АналитикаУчетаНоменклатуры,
		|		Материалы.ВидЗапасов,
		|		Материалы.АналитикаУчетаНоменклатуры.Номенклатура,
		|		Материалы.АналитикаУчетаНоменклатуры.Характеристика,
		|		Материалы.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения,
		|		ВЫБОР
		|			КОГДА Материалы.АналитикаУчетаНоменклатуры.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
		|				ТОГДА ВЫРАЗИТЬ(""ВозвратнаяТара"" КАК СТРОКА(20))
		|			КОГДА Материалы.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
		|				ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
		|			ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
		|		КОНЕЦ,
		|		Материалы.АналитикаУчетаНоменклатуры.Серия) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|	&ТекстЗапросаХарактеристика,
		|	&ТекстЗапросаСерия,
		|	&ТекстЗапросаУпаковка,
		|	ВложенныйЗапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВложенныйЗапрос.Количество КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Серия КАК Серия,
		|		ОтчетПереработчикаПродукция.Упаковка КАК Упаковка,
		|		ОтчетПереработчикаПродукция.КоличествоУпаковок КАК КоличествоУпаковок,
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|		СУММА(ОтчетПереработчикаПродукция.Количество) КАК Количество
		|	ИЗ
		|		Документ.ОтчетПереработчика2_5.ВыходныеИзделия КАК ОтчетПереработчикаПродукция
		|	ГДЕ
		|		ОтчетПереработчикаПродукция.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры,
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Номенклатура,
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Характеристика,
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения,
		|		ОтчетПереработчикаПродукция.Упаковка,
		|		ОтчетПереработчикаПродукция.КоличествоУпаковок,
		|		ОтчетПереработчикаПродукция.АналитикаУчетаНоменклатуры.Серия) КАК ВложенныйЗапрос";
	
	ЗаполнитьСобственныеТоварыВТексте(ДанныеДокумента);
	
	ДанныеДокумента = СтрЗаменить(ДанныеДокумента, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "ВложенныйЗапрос"));
		
	ДанныеДокумента = СтрЗаменить(ДанныеДокумента, "&ТекстЗапросаУпаковка",
		ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "ВложенныйЗапрос"));
		
	ДанныеДокумента = СтрЗаменить(ДанныеДокумента, "&ТекстЗапросаСерия",
		ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "ВложенныйЗапрос"));
	
	Запрос = Новый Запрос(ДанныеДокумента);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТабУслуги = РезультатЗапроса[0].Выгрузить();
	Для Каждого СтрУслуга Из ТабУслуги Цикл
		Если СтрУслуга.Сумма = 0 Тогда
			СтрУслуга.Сумма = 0.01;
		КонецЕсли;
		Если СтрУслуга.Цена = 0 Тогда
			СтрУслуга.Цена = 0.01;
		КонецЕсли;
	КонецЦикла;   
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда   
		 ПереопределитьСтавкуНДСДляСтарыхФорматов(ТабУслуги, Ложь);
	КонецЕсли;
	ДанныеXDTO.Вставить("Услуги",    ТабУслуги);
	
	Материалы = РезультатЗапроса[1].Выгрузить();
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Материалы, Истина, Ложь);
	
	ДанныеXDTO.Вставить("Материалы", Материалы);
	
	Продукция = РезультатЗапроса[2].Выгрузить();
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Продукция);
	ЗаполнитьВидДеятельностиНДСВТЧ(КомпонентыОбмена, ДанныеИБ, Продукция, "ПоступлениеПодДеятельность", "ЗакупкаПодДеятельность");
	ДанныеXDTO.Вставить("Продукция", Продукция);
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	Если ДанныеИБ.УслугиПоПереработке = Перечисления.ВариантыОформленияУслугДокументовПереработки.ОформляютсяОтдельно
		И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.4") Тогда
		
		//В версиях формата ниже 1.4 поле "Сумма" является обязательным,
		//при этом, если услуги указываются отдельно, сумма будет равна 0
		//и обмен завершится с ошибкой           
		ДанныеXDTO.Вставить("Сумма",    -0.01);	
	КонецЕсли;
КонецПроцедуры

