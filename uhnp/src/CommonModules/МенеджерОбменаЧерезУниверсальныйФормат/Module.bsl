Процедура ПКО_Справочник_КатегорииЭксплуатации_ИзСтруктуры_Получ_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СпособПогашенияСтоимостиНУ)
		И ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СпособПогашенияСтоимостиБУ) Тогда
		ДанныеДляЗаписиВИБ.СпособПогашенияСтоимостиНУ = ДанныеДляЗаписиВИБ.СпособПогашенияСтоимостиБУ;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("СчетУчета") Тогда
		
		ПорядокОтраженияНаСчетахУчета = КомпонентыОбмена.ПараметрыКонвертации.ПорядокОтраженияНаСчетахУчета; // ТаблицаЗначений
			
		НоваяСтрока = ПорядокОтраженияНаСчетахУчета.Добавить();
		НоваяСтрока.ВидСчета = Перечисления.ВидыСчетовРеглУчета.ТМЦВЭксплуатации;
		НоваяСтрока.Организация = Справочники.Организации.ПустаяСсылка();
		НоваяСтрока.АналитикаУчета = ?(ДанныеИБ = Неопределено, 
														ПолученныеДанные.ПолучитьСсылкуНового(), 
														ДанныеИБ.Ссылка);
		НоваяСтрока.СчетУчета = БухгалтерскийСчетПоКоду(ПолученныеДанные.ДополнительныеСвойства.СчетУчета);
		
	КонецЕсли;
КонецПроцедуры

