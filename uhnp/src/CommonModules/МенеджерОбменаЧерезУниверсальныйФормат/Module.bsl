Процедура ДобавитьПКО_Документ_ВедомостьВЗаявку_Выплата_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_ВедомостьВЗаявку_Выплата_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ЗаявкаНаРасходованиеДенежныхСредств;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ВедомостьНаВыплатуЗарплаты"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_ВедомостьВЗаявку_Выплата_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ВариантИдентификации         = "ПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Дата",                            "ДатаВедомости");
	ДобавитьПКС(СвойстваШапки, "ДатаВедомостиНаВыплатуЗарплаты",  "ДатаВедомости");
	ДобавитьПКС(СвойстваШапки, "ДатаПлатежа",                     "ДатаВедомости");
	ДобавитьПКС(СвойстваШапки, "ЖелательнаяДатаПлатежа",          "ДатаВедомости");
	ДобавитьПКС(СвойстваШапки, "НомерВедомостиНаВыплатуЗарплаты", "НомерВедомости");
	ДобавитьПКС(СвойстваШапки, "Организация",                     "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "Подразделение",                   "Подразделение", , "Справочник_Подразделения_Получение");
	ДобавитьПКС(СвойстваШапки, "СтатьяДвиженияДенежныхСредств",   "", 1);
	ДобавитьПКС(СвойстваШапки, "СуммаДокумента",                  "СуммаДокумента");
	ДобавитьПКС(СвойстваШапки, "ФормаОплатыБезналичная",          "", 1);
	ДобавитьПКС(СвойстваШапки, "ФормаОплатыЗаявки",               "", 1);
	ДобавитьПКС(СвойстваШапки, "ФормаОплатыНаличная",             "", 1);
	ДобавитьПКС(СвойстваШапки, "ХозяйственнаяОперацияПоЗарплате", "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ЛицевыеСчетаСотрудников", "");
	ДобавитьПКС(СвойстваТЧ, "ЛицевойСчет",    "", 1, "Справочник_БанковскиеСчетаКонтрагентов_Получение");
	ДобавитьПКС(СвойстваТЧ, "Сумма",          "", 1);
	ДобавитьПКС(СвойстваТЧ, "ФизическоеЛицо", "", 1, "Справочник_ФизическиеЛица_Получение");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "РасшифровкаПлатежа",      "");
	ДобавитьПКС(СвойстваТЧ, "Сумма", "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("ДатаВедомостиНаВыплатуЗарплаты,НомерВедомостиНаВыплатуЗарплаты,Организация,ХозяйственнаяОперация,ХозяйственнаяОперацияПоЗарплате");
КонецПроцедуры
Процедура ПКО_Документ_ВедомостьВЗаявку_Выплата_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты;
	ПолученныеДанные.Валюта                = ВалютаРегламентированногоУчета(ПолученныеДанные.Организация);
	ПолученныеДанные.ПриоритетОплаты       = Справочники.ПриоритетыОплаты.ПолучитьПриоритетПоУмолчанию(Неопределено);
	ПолученныеДанные.Статус                = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
	
	Если ДанныеXDTO.Свойство("СпособВыплаты") Тогда
		Если ДанныеXDTO.СпособВыплаты.Значение = "ЧерезКассу" Или ДанныеXDTO.СпособВыплаты.Значение = "ЧерезРаздатчика" Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплатыНаличная",  	       Истина);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплатыБезналичная",	       Ложь);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплатыЗаявки",              Перечисления.ФормыОплаты.Наличная);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ХозяйственнаяОперацияПоЗарплате", Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыЧерезКассу);	
		Иначе
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплатыНаличная",  	Ложь);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплатыБезналичная",	Истина);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплатыЗаявки",       Перечисления.ФормыОплаты.Безналичная);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ХозяйственнаяОперацияПоЗарплате", 
				?(ДанныеXDTO.СпособВыплаты.Значение = "ЧерезБанк",
					Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту,
					Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета));	
		КонецЕсли;
	КонецЕсли;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("СтатьяДвиженияДенежныхСредств",
		Справочники.СтатьиДвиженияДенежныхСредств.СтатьяДвиженияДенежныхСредствПоХозяйственнойОперации(ПолученныеДанные.ХозяйственнаяОперацияПоЗарплате));
	
	РасшифровкаПлатежа = Новый Массив;
	РасшифровкаПлатежа.Добавить(Новый Структура("Сумма", ПолученныеДанные.СуммаДокумента));
	ПолученныеДанные.ДополнительныеСвойства.Вставить("РасшифровкаПлатежа", РасшифровкаПлатежа);
	
	Если ПолученныеДанные.ДополнительныеСвойства.ХозяйственнаяОперацияПоЗарплате = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета Тогда
		
		МассивЛицевыеСчетаСотрудников = Новый Массив;
		
		ПравилаЗаполнения = Новый Структура;
		ПравилаЗаполнения.Вставить("ФизическоеЛицо", "ФизическоеЛицо");
		ПравилаЗаполнения.Вставить("БанковскийСчет", "ЛицевойСчет");
		ПравилаЗаполнения.Вставить("Сумма",          "Сумма");
		
		Для Каждого СтрокаЗарплата Из ДанныеXDTO.Зарплата Цикл
			МассивЛицевыеСчетаСотрудников.Добавить(
				ДанныеКоллекцииВВидеСтруктуры(СтрокаЗарплата, ПравилаЗаполнения));
		КонецЦикла;
		
