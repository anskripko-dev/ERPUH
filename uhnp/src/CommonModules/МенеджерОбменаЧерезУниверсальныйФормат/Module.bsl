			СтавкаНДС = ТабРасшифровкаСуммы[0].СтавкаНДС;
		КонецЕсли;
		ДанныеXDTO.Вставить("СтавкаНДС", СтавкаНДС);
	КонецЕсли;
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
КонецПроцедуры

