Процедура ПКО_Справочник_БанковскиеСчетаОрганизаций_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Наименование) Тогда
		ПрисвоитьНаименованиеБанковскогоСчета(ПолученныеДанные, ДанныеИБ);
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		ПолученныеДанные.ИспользоватьОбменСБанком = Истина;
		ПолученныеДанные.ОбменСБанкомВключен = Истина;
		ПолученныеДанные.Кодировка = "Windows";
		ПолученныеДанные.ФорматОбмена = "1CClientBankExchange";
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ТипСчета) Тогда
		ДанныеДляЗаписиВИБ.ТипСчета = Перечисления.ТипыБанковскихСчетов.Расчетный;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ИдентификаторСчетаЦифровогоРубля) Тогда
		ДанныеДляЗаписиВИБ.СчетЦифровогоРубля = Истина;
	КонецЕсли;	
	//++ НЕ УТ
	
	//++ Локализация
	Если ДанныеИБ = Неопределено Тогда
	
		ПорядокОтраженияНаСчетахУчета = КомпонентыОбмена.ПараметрыКонвертации.ПорядокОтраженияНаСчетахУчета; // ТаблицаЗначений
		НоваяСтрока = ПорядокОтраженияНаСчетахУчета.Добавить();
		НоваяСтрока.ВидСчета       = Перечисления.ВидыСчетовРеглУчета.ДенежныеСредства;
		НоваяСтрока.Организация    = Справочники.Организации.ПустаяСсылка();
		НоваяСтрока.АналитикаУчета = ?(ДанныеИБ = Неопределено, 
														ПолученныеДанные.ПолучитьСсылкуНового(), 
														ДанныеИБ.Ссылка);	
		Если ДанныеДляЗаписиВИБ.ВалютаДенежныхСредств = ВалютаРегламентированногоУчета(КомпонентыОбмена) Тогда
			НоваяСтрока.СчетУчета = ПланыСчетов.Хозрасчетный.РасчетныеСчета;
		Иначе
			НоваяСтрока.СчетУчета = ПланыСчетов.Хозрасчетный.ВалютныеСчета;
		КонецЕсли;
		
	КонецЕсли;	
	//-- Локализация
	
	//-- НЕ УТ
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
	                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
КонецПроцедуры

