	КонецЕсли;
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ВалютаКонвертацииБонусов",
		Новый Структура("Значение, ИмяПКО", ДанныеXDTO.КлючевыеСвойства.ВалютаКонвертацииБонусов, ИмяПКО));
		
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
КонецПроцедуры
