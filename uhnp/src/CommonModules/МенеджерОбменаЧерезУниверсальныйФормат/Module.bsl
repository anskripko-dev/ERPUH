Процедура ПКО_Документ_СБДСРасчетыССамозанятыми_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.ПроведеноБанком = ЗначениеЗаполнено(ПолученныеДанные.ДатаПроведенияБанком);
	ПолученныеДанные.ОперацияССамозанятым = Истина;
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	   
	#Область РасшифровкаПлатежа
	
	ЗаполнятьДоговор = КомпонентыОбмена.ПараметрыКонвертации.ИспользуютсяДоговорыСПоставщиками;
		 
	МассивСтрокРасшифровкаПлатежа = Новый Массив;
	МассивСтрокБанковскиеСчетаКонтрагентов = Новый Массив;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Сумма", "Сумма");
	ПравилаЗаполнения.Вставить("СуммаВзаиморасчетов", "СуммаВзаиморасчетов");
	ПравилаЗаполнения.Вставить("СтатьяДвиженияДенежныхСредств", "СтатьяДДС");
	ПравилаЗаполнения.Вставить("Самозанятый", "Контрагент");
	ПравилаЗаполнения.Вставить("ВалютаВзаиморасчетов", "ВалютаВзаиморасчетов");
	ПравилаЗаполнения.Вставить("БанковскийСчет", "БанковскийСчетКонтрагента");
	              
	ЕстьКолонкаИдентификаторСтроки = ДанныеXDTO.РасшифровкаПлатежа.Колонки.Найти("ИдентификаторСтроки") <> Неопределено; 
	
	ДоступныеКолонкиПоВзаиморасчетам = ДоступныеКолонкиДляЗаполненияДанныхВзаиморасчетов(ДанныеXDTO.РасшифровкаПлатежа, ЗаполнятьДоговор);
	
	Для Каждого СтрокаXDTO Из ДанныеXDTO.РасшифровкаПлатежа Цикл
		
		СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаXDTO, ПравилаЗаполнения);	
		
		ДобавитьВалютуВРасшифровкуПлатежа(СтруктураДанныхСтроки, СтрокаXDTO);
		
		ДобавитьДанныеВзаиморасчетовВРасшифровкуПлатежа(КомпонентыОбмена, СтрокаXDTO, СтруктураДанныхСтроки, ДоступныеКолонкиПоВзаиморасчетам);
		
		Если СтруктураДанныхСтроки.Свойство("БанковскийСчетКонтрагента") И ЗначениеЗаполнено(СтруктураДанныхСтроки.БанковскийСчетКонтрагента) Тогда
			СтруктураСтрокиБанковскиеСчета = Новый Структура("Контрагент, БанковскийСчетКонтрагента, Сумма");
			ЗаполнитьЗначенияСвойств(СтруктураСтрокиБанковскиеСчета, СтруктураДанныхСтроки);
			
			МассивСтрокБанковскиеСчетаКонтрагентов.Добавить(СтруктураСтрокиБанковскиеСчета);
		КонецЕсли;
		
		Если ЕстьКолонкаИдентификаторСтроки И ЗначениеЗаполнено(СтрокаXDTO.ИдентификаторСтроки) Тогда
			СтруктураДанныхСтроки.Вставить("ИдентификаторСтроки", СтрокаXDTO.ИдентификаторСтроки);
		КонецЕсли;
		
		МассивСтрокРасшифровкаПлатежа.Добавить(СтруктураДанныхСтроки);
		
	КонецЦикла;
	 
	ПолученныеДанные.ДополнительныеСвойства.Вставить("РасшифровкаПлатежа", МассивСтрокРасшифровкаПлатежа); 
	
	Если МассивСтрокБанковскиеСчетаКонтрагентов.Количество() > 0 Тогда
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("БанковскиеСчетаСпискаКонтрагентов", МассивСтрокБанковскиеСчетаКонтрагентов); 
		
	КонецЕсли;
	
	//++ НЕ УТ
		
	ПроверитьНаличиеДатПлатежаВРасшифровкеПлатежа(ДанныеXDTO, ПолученныеДанные); 
	
	//-- НЕ УТ
	 
	#КонецОбласти
КонецПроцедуры
Процедура ПКО_Документ_СБДСРасчетыССамозанятыми_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПолученныеДанные.РасшифровкаПлатежа.Количество() = 1
		И ПолученныеДанные.РасшифровкаПлатежа[0].Контрагент = ПолученныеДанные.Контрагент Тогда
		ПолученныеДанные.СписокКонтрагентов = Ложь; 
	Иначе
		ПолученныеДанные.СписокКонтрагентов = Истина;				
	КонецЕсли;
	
	ПередМержеванием_СБДС(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	Мержевание_СБДС(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена);
	ПослеМержевания_СБДС(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	
	ЗаполнитьДопСвойстваДанныхИБИзПолученныхДанных(ДанныеИБ, ПолученныеДанные);
	
	ПолученныеДанные = ?(ДанныеИБ = Неопределено, ПолученныеДанные, Неопределено);
КонецПроцедуры

