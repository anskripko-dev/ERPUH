	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "ЭтапыОплаты");
	ДобавитьПКС(СвойстваТЧ, "", "ВариантОплаты", 1, "Перечисление_ВариантыОплатыКлиентом");
	ДобавитьПКС(СвойстваТЧ, "", "ДатаПлатежа", 1);
	ДобавитьПКС(СвойстваТЧ, "", "НомерСтрокиДокумента", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ПроцентПлатежа", 1);
	ДобавитьПКС(СвойстваТЧ, "", "СуммаПлатежа", 1);
