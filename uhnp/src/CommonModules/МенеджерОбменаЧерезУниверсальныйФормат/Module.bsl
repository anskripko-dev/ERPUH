		Если СчетУчета.Свойство("РасчетыСДебиторамиПроценты") Тогда
			ДанныеXDTO.Вставить(
				"СчетУчетаРасчетовСДебиторамиПроценты", 
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета.РасчетыСДебиторамиПроценты, "Код"));
		КонецЕсли;
	
		Если СчетУчета.Свойство("РасчетыСДебиторамиКомиссия") Тогда
			ДанныеXDTO.Вставить(
