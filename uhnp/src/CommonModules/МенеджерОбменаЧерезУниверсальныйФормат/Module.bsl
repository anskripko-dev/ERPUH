Процедура ПКО_Справочник_ГрФинансовогоУчетаРасчетов_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	//++ НЕ УТ
	
	//++ Локализация
	СчетаДляЗаполнения = Новый Структура;
	СчетаДляЗаполнения.Вставить("СчетУчетаАвансовВыданных",                              Перечисления.ВидыСчетовРеглУчета.АвансыВыданные);
	СчетаДляЗаполнения.Вставить("СчетУчетаАвансовПолученных",                            Перечисления.ВидыСчетовРеглУчета.АвансыПолученные);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовПоПретензиям",                         Перечисления.ВидыСчетовРеглУчета.УдалитьРасчетыПоПретензиям);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСКлиентами",                           Перечисления.ВидыСчетовРеглУчета.РасчетыСКлиентами);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСКлиентамиТара",                       Перечисления.ВидыСчетовРеглУчета.РасчетыСКлиентамиТара);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСПоставщиками",                        Перечисления.ВидыСчетовРеглУчета.РасчетыСПоставщиками);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСПоставщикамиТара",                    Перечисления.ВидыСчетовРеглУчета.РасчетыСПоставщикамиТара);
	СчетаДляЗаполнения.Вставить("СчетУчетаНеотфактурованныеПоставки",                    Перечисления.ВидыСчетовРеглУчета.НеотфактурованныеПоставки);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСКредиторамиОсновнойДолг",             Перечисления.ВидыСчетовРеглУчета.РасчетыСКредиторамиОсновнойДолг);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСКредиторамиПроценты",                 Перечисления.ВидыСчетовРеглУчета.РасчетыСКредиторамиПроценты);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСКредиторамиКомиссия",                 Перечисления.ВидыСчетовРеглУчета.РасчетыСКредиторамиКомиссия);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСДебиторамиОсновнойДолг",              Перечисления.ВидыСчетовРеглУчета.РасчетыСДебиторамиОсновнойДолг);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСДебиторамиПроценты",                  Перечисления.ВидыСчетовРеглУчета.РасчетыСДебиторамиПроценты);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСДебиторамиКомиссия",                  Перечисления.ВидыСчетовРеглУчета.РасчетыСДебиторамиКомиссия);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСЛизингодателемАрендныеОбязательства", Перечисления.ВидыСчетовРеглУчета.АрендныеОбязательства);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСЛизингодателемВыкупПредметаЛизинга",  Перечисления.ВидыСчетовРеглУчета.ВыкупнаяСтоимость);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСЛизингодателемЛизинговыеУслуги",      Перечисления.ВидыСчетовРеглУчета.УслугаПоАренде);
	СчетаДляЗаполнения.Вставить("СчетУчетаРасчетовСЛизингодателемОбеспечительныйПлатеж", Перечисления.ВидыСчетовРеглУчета.ОбеспечительныйПлатеж);
	
	СчетаУчета = Новый Соответствие;
	
	Для Каждого СчетДляЗаполнения Из СчетаДляЗаполнения Цикл
		Если ДанныеXDTO.Свойство(СчетДляЗаполнения.Ключ) И ЗначениеЗаполнено(ДанныеXDTO[СчетДляЗаполнения.Ключ]) Тогда
			СчетаУчета.Вставить(СчетДляЗаполнения.Значение, ДанныеXDTO[СчетДляЗаполнения.Ключ]);		
		КонецЕсли;
	КонецЦикла;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("СчетаУчета", СчетаУчета);
	
	Если ДанныеXDTO.Свойство("РасчетыВВалюте") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыВВалюте", ДанныеXDTO.РасчетыВВалюте);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСДебиторами") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСДебиторами", ДанныеXDTO.РасчетыСДебиторами);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСКлиентами") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСКлиентами", ДанныеXDTO.РасчетыСКлиентами);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСКомиссионерами") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСКомиссионерами", ДанныеXDTO.РасчетыСКомиссионерами);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСКомитентами") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСКомитентами", ДанныеXDTO.РасчетыСКомитентами);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСКредиторами") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСКредиторами", ДанныеXDTO.РасчетыСКредиторами);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСЛизингодателями") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСАрендодателями", ДанныеXDTO.РасчетыСЛизингодателями);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСПоставщиками") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСПоставщиками", ДанныеXDTO.РасчетыСПоставщиками);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("РасчетыСКомитентамиПоЗакупке") Тогда
	    ПолученныеДанные.ДополнительныеСвойства.Вставить("РасчетыСКомитентамиПоЗакупке", ДанныеXDTO.РасчетыСКомитентамиПоЗакупке);
	КонецЕсли;
	//-- Локализация
	
	//-- НЕ УТ
КонецПроцедуры
Процедура ПКО_Справочник_ГрФинансовогоУчетаРасчетов_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	//++ НЕ УТ
	
	//++ Локализация
	СчетаУчета = ПолученныеДанные.ДополнительныеСвойства.СчетаУчета;
	
	Для Каждого СчетУчета Из СчетаУчета Цикл
	
		ПорядокОтраженияНаСчетахУчета = КомпонентыОбмена.ПараметрыКонвертации.ПорядокОтраженияНаСчетахУчета; // ТаблицаЗначений
		
		НоваяСтрока = ПорядокОтраженияНаСчетахУчета.Добавить();
		НоваяСтрока.ВидСчета       = СчетУчета.Ключ;
		НоваяСтрока.Организация    = Справочники.Организации.ПустаяСсылка();
		НоваяСтрока.АналитикаУчета = ?(ДанныеИБ = Неопределено, 
														ПолученныеДанные.ПолучитьСсылкуНового(), 
														ДанныеИБ.Ссылка);
		НоваяСтрока.СчетУчета      = БухгалтерскийСчетПоКоду(СчетУчета.Значение);
		
	КонецЦикла;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыВВалюте") Тогда
	    ПолученныеДанные.РасчетыВВалюте = ПолученныеДанные.ДополнительныеСвойства.РасчетыВВалюте;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСДебиторами") Тогда
	    ПолученныеДанные.РасчетыСДебиторами = ПолученныеДанные.ДополнительныеСвойства.РасчетыСДебиторами;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСКлиентами") Тогда
	    ПолученныеДанные.РасчетыСКлиентами = ПолученныеДанные.ДополнительныеСвойства.РасчетыСКлиентами;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСКомиссионерами") Тогда
	    ПолученныеДанные.РасчетыСКомиссионерами = ПолученныеДанные.ДополнительныеСвойства.РасчетыСКомиссионерами;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСКомитентами") Тогда
	    ПолученныеДанные.РасчетыСКомитентами = ПолученныеДанные.ДополнительныеСвойства.РасчетыСКомитентами;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСКредиторами") Тогда
	    ПолученныеДанные.РасчетыСКредиторами = ПолученныеДанные.ДополнительныеСвойства.РасчетыСКредиторами;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСЛизингодателями") Тогда
	    ПолученныеДанные.РасчетыСАрендодателями = ПолученныеДанные.ДополнительныеСвойства.РасчетыСЛизингодателями;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСПоставщиками") Тогда
	    ПолученныеДанные.РасчетыСПоставщиками = ПолученныеДанные.ДополнительныеСвойства.РасчетыСПоставщиками;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасчетыСКомитентамиПоЗакупке") Тогда
	    ПолученныеДанные.РасчетыСКомитентамиПоЗакупке = ПолученныеДанные.ДополнительныеСвойства.РасчетыСКомитентамиПоЗакупке;
	КонецЕсли;
	//-- Локализация
	
	//-- НЕ УТ
КонецПроцедуры

