Процедура ПКО_Документ_ВозвратДДПоставщику_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	СтатьяРасходовИнструкция = Новый Структура("Значение, ИмяПКО", ДанныеИБ.СтатьяРасходов, "Справочник_СтатьиРасходов");
	ДанныеXDTO.Вставить("СтатьяРасходов", СтатьяРасходовИнструкция);
	
	Если ЗначениеЗаполнено(ДанныеИБ.Договор) Тогда
		СвойстваДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				ДанныеИБ.Договор, "ОплатаВВалюте, ВалютаВзаиморасчетов, Организация");
	
		ДанныеXDTO.Вставить("Договор", ДанныеИБ.Договор);
		ВалютаВзаиморасчетов     = СвойстваДоговора.ВалютаВзаиморасчетов;
		РасчетыВУсловныхЕдиницах = ВедетсяРасчетВУЕ(СвойстваДоговора.ВалютаВзаиморасчетов, СвойстваДоговора.ОплатаВВалюте, СвойстваДоговора.Организация, КомпонентыОбмена);
	Иначе
		ПараметрыПоУмолчанию = Новый Структура(ДоговорФиксированнаяСтруктураКлючей());
		ЗаполнитьЗначенияСвойств(ПараметрыПоУмолчанию, ДанныеИБ);
		ПараметрыПоУмолчанию.ВидДоговора = "СПоставщиком";
		Если ЗначениеЗаполнено(ДанныеИБ.Соглашение) Тогда
		    ДанныеРасчетаУЕ          = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИБ.Соглашение, "ВалютаВзаиморасчетов, ОплатаВВалюте, Организация");
			РасчетыВУсловныхЕдиницах = ВедетсяРасчетВУЕ(ДанныеРасчетаУЕ.ВалютаВзаиморасчетов, ДанныеРасчетаУЕ.ОплатаВВалюте, ДанныеРасчетаУЕ.Организация, КомпонентыОбмена);
			ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.Соглашение, "ВалютаВзаиморасчетов");
		Иначе
			РасчетыВУсловныхЕдиницах = Ложь;
			ВалютаВзаиморасчетов     = ВалютаРегламентированногоУчета(ДанныеИБ.Организация);
		КонецЕсли;
		ПараметрыПоУмолчанию.ВалютаВзаиморасчетов     = ВалютаВзаиморасчетов;
		ПараметрыПоУмолчанию.РасчетыВУсловныхЕдиницах = РасчетыВУсловныхЕдиницах;
		
		Договор = ДоговорИнструкцияКонвертацииПоДаннымВзаиморасчетов(ПараметрыПоУмолчанию, КомпонентыОбмена);
		ДанныеXDTO.Вставить("Договор", Договор);
	КонецЕсли;
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов",     ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", РасчетыВУсловныхЕдиницах);
	
	ВыгрузитьКурсИКратностьВзаиморасчетов(ДанныеXDTO, ВалютаВзаиморасчетов, ДанныеИБ.Дата, ДанныеИБ.Организация);
	
	ТЧДенежныеДокументы = ДанныеИБ.ДополнительныеСвойства.ТЧДенежныеДокументы;
	ДанныеXDTO.Вставить("ДенежныеДокументы", ТЧДенежныеДокументы);
КонецПроцедуры

