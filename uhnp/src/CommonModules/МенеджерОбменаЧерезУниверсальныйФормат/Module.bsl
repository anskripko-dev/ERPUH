Процедура ПОД_Документ_ОтчетКомиссионера_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ОчиститьИспользованиеПКО(ИспользованиеПКО);
	
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("ВидОперацииОтчетаКоммисионера") Тогда
		
		Если (ДанныеXDTO.КлючевыеСвойства.ВидОперацииОтчетаКоммисионера.Значение = "РеализацияЧерезКомиссионера"
			Или ДанныеXDTO.КлючевыеСвойства.ВидОперацииОтчетаКоммисионера.Значение = "РеализацияЧерезКомиссионераБезПереходаПраваСобственности") Тогда
			
			ИспользованиеПКО.Вставить("Документ_РеализацияТоваровУслугКомиссия_Получение", Истина);
		
		ИначеЕсли ДанныеXDTO.КлючевыеСвойства.ВидОперацииОтчетаКоммисионера.Значение = "ВозвратТоваровОтКомиссионера" Тогда
			
			ИспользованиеПКО.Вставить("Документ_ВозвратТоваровОтКлиентаКомиссия_Получение", Истина);
			
		Иначе
			
			ИспользованиеПКО.Вставить("Документ_ОтчетКомиссионера_Получение", Истина);
			
		КонецЕсли;
		
	Иначе
		
		ИспользованиеПКО.Вставить("Документ_ОтчетКомиссионера_Получение", Истина);
		
	КонецЕсли;
КонецПроцедуры

