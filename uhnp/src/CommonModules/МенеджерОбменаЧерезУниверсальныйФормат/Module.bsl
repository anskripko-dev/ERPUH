Процедура ОтложеннаяОбработка_СписаниеЗадолженности(Объект, КомпонентыОбмена)
	ДоходыРасходыАктивыПассивы = Объект.ДоходыРасходыАктивыПассивы[0];
	
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности
		И НЕ ЗначениеЗаполнено(ДоходыРасходыАктивыПассивы.Статья) Тогда
		ДоходыРасходыАктивыПассивы.Статья = ЭлементПоУмолчанию(КомпонентыОбмена, "СтатьяРасходовСписаниеЗадолженности");
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности
		И НЕ ЗначениеЗаполнено(ДоходыРасходыАктивыПассивы.Статья) Тогда
		ДоходыРасходыАктивыПассивы.Статья = ЭлементПоУмолчанию(КомпонентыОбмена, "СтатьяДоходовСписаниеЗадолженности");
	КонецЕсли;
	
	Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.Контрагент);	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Партнер = Справочники.Партнеры.НеизвестныйПартнер;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ из Объект.Задолженность Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Партнер)
			ИЛИ НЕ СтрокаТЧ.Партнер = Партнер Тогда
			СтрокаТЧ.Партнер = Партнер;
		КонецЕсли;
	КонецЦикла;
	
	ПервичныеДокументы = КомпонентыОбмена.ПараметрыКонвертации.ПервичныеДокументы; // ТаблицаЗначений
	
	Для Каждого Расшифровка из Объект.ДополнительныеСвойства.Задолженность Цикл
		ДокументРасчетов   = Расшифровка.ДокументРасчетов;
		Если ЗначениеЗаполнено(ДокументРасчетов) И ТипЗнч(ДокументРасчетов) = Тип("ДокументСсылка.ПервичныйДокумент") Тогда
			СтрокаПервичныеДокументы = ПервичныеДокументы.Добавить();
			СтрокаПервичныеДокументы.ПервичныйДокумент = ДокументРасчетов;
			Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности Тогда
			    СтрокаПервичныеДокументы.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.РеализацияКлиенту;
			Иначе
				СтрокаПервичныеДокументы.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ПриобретениеУПоставщика;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Объект.КорреспонденцияСДоходами = Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности;
	
	ЗаполнитьОбъектРасчетов = КомпонентыОбмена.ПараметрыКонвертации.ЗаполнитьОбъектРасчетов; // Массив
	ЗаполнитьОбъектРасчетов.Добавить(Объект);
КонецПроцедуры
//++ Локализация

