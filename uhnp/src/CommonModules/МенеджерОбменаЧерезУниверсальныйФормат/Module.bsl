Процедура ПКО_Документ_УведОбОстаткахПрослежТова_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлючиАналитикиУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	КлючиАналитикиУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	КлючиАналитикиУчетаНоменклатуры.Серия КАК Серия,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровВидыЗапасов.Количество КАК Количество,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровВидыЗапасов.КоличествоПоРНПТ КАК КоличествоРНПТ,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровВидыЗапасов.РНПТ КАК РНПТ,
	|	КлючиАналитикиУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СтраныМира.Ссылка ЕСТЬ NULL
	|			ТОГДА КлючиАналитикиУчетаНоменклатуры.Номенклатура.СтранаПроисхождения
	|		ИНАЧЕ СтраныМира.Ссылка
	|	КОНЕЦ КАК СтранаПроисхождения
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров.ВидыЗапасов КАК УведомлениеОбОстаткахПрослеживаемыхТоваровВидыЗапасов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
	|		ПО (УведомлениеОбОстаткахПрослеживаемыхТоваровВидыЗапасов.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|			ПО (НомераГТД.СтранаПроисхождения = СтраныМира.Ссылка)
	|		ПО (УведомлениеОбОстаткахПрослеживаемыхТоваровВидыЗапасов.НомерГТД = НомераГТД.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.Номенклатура,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.Характеристика,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.Серия,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.Количество,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.КоличествоПоРНПТ,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.РНПТ КАК РНПТ,
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.Номенклатура.ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СтраныМира.Ссылка ЕСТЬ NULL
	|			ТОГДА УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.Номенклатура.СтранаПроисхождения
	|		ИНАЧЕ СтраныМира.Ссылка
	|	КОНЕЦ
	|ИЗ
	|	Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров.ТМЦВЭксплуатации КАК УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|			ПО НомераГТД.СтранаПроисхождения = СтраныМира.Ссылка
	|		ПО УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.НомерГТД = НомераГТД.Ссылка
	|ГДЕ
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровТМЦВЭксплуатации.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоРНПТ КАК КоличествоРНПТ,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Товары.РНПТ КАК РНПТ
	|ИЗ
	|	Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровПродавцы.Продавец КАК Продавец
	|ИЗ
	|	Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров.Продавцы КАК УведомлениеОбОстаткахПрослеживаемыхТоваровПродавцы
	|ГДЕ
	|	УведомлениеОбОстаткахПрослеживаемыхТоваровПродавцы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Товары = РезультатЗапроса[1].Выгрузить(); 
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		
		ДанныеXDTO.Вставить("РНПТ", Товары[0].РНПТ);
		
	КонецЕсли;
	
	ЕдиницаПрослеживаемости = ДанныеИБ.ЕдиницаПрослеживаемости;
	
	Товары.Колонки.Добавить("Сумма"); 
	Товары.Колонки.Добавить("ЕдиницаПрослеживаемости");
	Для каждого Стр Из Товары Цикл 
		Стр.Сумма = 0.01;
		Стр.ЕдиницаПрослеживаемости = ЕдиницаПрослеживаемости;
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Товары",Товары);
	
	Продавцы = РезультатЗапроса[2].Выгрузить();
	
	Если Продавцы.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Продавцы", Продавцы);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда 
		ИдентификаторыИзВидовЗапасов = Истина;
		ИмяТаблицы = "Документ.УведомлениеОПеремещенииПрослеживаемыхТоваров.ТМЦВЭксплуатации"; 
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов);
		Если ДанныеXDTO.Свойство("СведенияРНПТ") Тогда
			СведенияРНПТТМЦВЭксплуатации = ДанныеXDTO.СведенияРНПТ;
		КонецЕсли;
		ИмяТаблицы = "Документ.УведомлениеОПеремещенииПрослеживаемыхТоваров.ВидыЗапасов"; 
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов); 
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПКО_Документ_УведОВвозеПрослежТов_Отправка(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Документ_УведОВвозеПрослежТов_Отправка";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.Документы.УведомлениеОВвозеПрослеживаемыхТоваров;
	ПравилоКонвертации.ОбъектФормата     = "Документ.УведомлениеОВвозеПрослеживаемыхТоваров"; //@NON-NLS-1
