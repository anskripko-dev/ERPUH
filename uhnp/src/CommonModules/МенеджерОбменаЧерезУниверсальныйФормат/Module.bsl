	ПравилаЗаполнения.Вставить("НазваниеДокументаПринятияКУчету", "НазваниеДокументаПринятияКУчету");
	ПравилаЗаполнения.Вставить("СобытиеПринятияКУчету",           "СобытиеПринятияКУчету");
