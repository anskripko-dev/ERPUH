	ПравилоКонвертации.ИмяПКО                       = "Документ_ПеремещениеДД_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ВыбытиеДенежныхДокументов;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ПеремещениеДенежныхДокументов"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_ПеремещениеДД_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_ПеремещениеДД_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_ВыбытиеДенежныхДокументов";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
