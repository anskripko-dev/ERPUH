	ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияПР",      "НакопленнаяАмортизацияПР");
	// Модернизация.
	ПравилаЗаполнения.Вставить("ДатаПоследнейМодернизации",     "ДатаМодернизации");
	ПравилаЗаполнения.Вставить("НазваниеДокументаМодернизации", "НазваниеДокументаМодернизации");
	ПравилаЗаполнения.Вставить("НомерДокументаМодернизации",    "НомерДокументаМодернизации");
	ПравилаЗаполнения.Вставить("СобытиеМодернизации",           "СобытиеМодернизации");
	// Использование до 2009г.
	ПравилаЗаполнения.Вставить("АмортизацияДо2009",         "НакопленнаяАмортизацияНУДо2009");
	ПравилаЗаполнения.Вставить("СрокИспользованияНУДо2009", "СрокИспользованияНУДо2009");
	
	МассивСтрокТЧ          = Новый Массив;
	МассивСтрокНаработкиОС = Новый Массив;
	
	Для Каждого Строка Из ДанныеXDTO.ОсновныеСредства Цикл
	
		СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
		
		// Заполнение данных ОС.
		ИнструкцияОС = Новый Структура;
		Если СтруктураДанныхСтроки.Свойство("ОсновноеСредствоСсылка") Тогда
			ИнструкцияОС.Вставить("ИмяПКО",   "Справочник_ОсновныеСредства");
			ИнструкцияОС.Вставить("Значение", СтруктураДанныхСтроки.ОсновноеСредствоСсылка);
		Иначе
			ИнструкцияОС.Вставить("ИмяПКО", "Справочник_ОсновныеСредства_Получение");
			
			ДанныеОС = Новый Структура();
