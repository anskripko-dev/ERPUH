Процедура ПКО_Документ_ЗаявкаНаРасходДСРасчетыССотр_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику Тогда
		ВидРасчетов = "Подотчет";
	Иначе
		ВидРасчетов = "Займы";
	КонецЕсли;
	ДанныеXDTO.Вставить("ВидРасчетов", ВидРасчетов);
	ЭтоWE = НЕ ПолучитьФункциональнуюОпцию("ЛокализацияРФ");
	Запрос = Новый Запрос;
	ТекстЗапроса =  ?(НЕ ЭтоУТ() И Не ЭтоWE,
			"ВЫБРАТЬ
			|	СУММА(РасшифровкаПлатежа.Сумма) КАК Сумма,
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
			|	ВЫБОР
			|		КОГДА РасшифровкаПлатежа.ДоговорЗаймаСотруднику.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|				ИЛИ РасшифровкаПлатежа.ДоговорЗаймаСотруднику.ФизическоеЛицо ЕСТЬ NULL
			|			ТОГДА РасшифровкаПлатежа.Ссылка.ПодотчетноеЛицо
			|		ИНАЧЕ РасшифровкаПлатежа.ДоговорЗаймаСотруднику.ФизическоеЛицо
			|	КОНЕЦ КАК Сотрудник
			|ИЗ
			|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|	РасшифровкаПлатежа.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств,
			|	ВЫБОР
			|		КОГДА РасшифровкаПлатежа.ДоговорЗаймаСотруднику.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|				ИЛИ РасшифровкаПлатежа.ДоговорЗаймаСотруднику.ФизическоеЛицо ЕСТЬ NULL
			|			ТОГДА РасшифровкаПлатежа.Ссылка.ПодотчетноеЛицо
			|		ИНАЧЕ РасшифровкаПлатежа.ДоговорЗаймаСотруднику.ФизическоеЛицо
			|	КОНЕЦ"
			,
			"ВЫБРАТЬ
			|	СУММА(РасшифровкаПлатежа.Сумма) КАК Сумма,
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
			|	РасшифровкаПлатежа.Ссылка.ПодотчетноеЛицо КАК Сотрудник
			|ИЗ
			|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|	РасшифровкаПлатежа.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств,
			|	РасшифровкаПлатежа.Ссылка.ПодотчетноеЛицо"
			);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	ТабРП = Запрос.Выполнить().Выгрузить();
	ДанныеXDTO.Вставить("РасшифровкаПлатежа", ТабРП);
КонецПроцедуры

