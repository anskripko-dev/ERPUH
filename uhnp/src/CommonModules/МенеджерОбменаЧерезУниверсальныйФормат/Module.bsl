	ДанныеXDTO.КлючевыеСвойства.Вставить("Дата", ДанныеИБ.Отбор.Период.Значение);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Склад", ДанныеИБ.Отбор.Склад.Значение);
	
	НаборЗаписей = РегистрыСведений.ДоступностьТоваровДляВнешнихПользователей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ДанныеИБ.Отбор.Период.Значение);
	НаборЗаписей.Отбор.Склад.Установить(ДанныеИБ.Отбор.Склад.Значение);
	НаборЗаписей.Прочитать();
	Товары = НаборЗаписей.Выгрузить();
	
	Товары.Колонки.Доступно.Имя = "КоличествоНаСкладе";
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары, Истина, Ложь);
	ДанныеXDTO.Вставить("Товары", Товары);
