	ПравилоКонвертации.ОбъектФормата                = "Справочник.НоменклатураСегмента"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_РегистрСведений_НоменклатураСегмента_Получение_ПриКонвертацииДанныхXDTO";
