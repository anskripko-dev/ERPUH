		|		КОГДА НЕ СведенияПослеКорректировки.УпаковкаКорректировка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|			ТОГДА СведенияПослеКорректировки.УпаковкаКорректировка
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|	КОНЕЦ,
		|	СведенияПослеКорректировки.ЕдиницаИзмеренияПрослеживаемости,
		|	СведенияПослеКорректировки.Номенклатура.Наименование
		|ИЗ
		|	СведенияПослеКорректировки КАК СведенияПослеКорректировки";
	
	Запрос.УстановитьПараметр("Приобретение", ДанныеИБ.ДокументОснование);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		СведенияРНПТ = РезультатЗапроса.Выгрузить(); 
		СведенияРНПТ.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		Если ДанныеXDTO.Свойство("Товары")  Тогда
			Товары = ДанныеXDTO.Товары;  
			Если Товары.Колонки.Найти("ИдентификаторСтроки") = Неопределено Тогда
				Товары.Колонки.Добавить("ИдентификаторСтроки");
			КонецЕсли;
			Для каждого Строка Из Товары Цикл 
				Если Не ЗначениеЗаполнено(Строка.НомерГТД) Тогда
					Продолжить
				КонецЕсли;
				Отбор = Новый Структура;
				Отбор.Вставить("РНПТ",Строка.НомерГТД);
				НайденныеСтроки  = СведенияРНПТ.НайтиСтроки(Отбор);
				Если НЕ НайденныеСтроки = Неопределено И НайденныеСтроки.Количество()> 0 Тогда
					Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						НайденнаяСтрока.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			ДанныеXDTO.Вставить("Товары", Товары);
		КонецЕсли;
	
		ДанныеXDTO.Вставить("СведенияРНПТ", СведенияРНПТ);
		
	КонецЕсли;
КонецПроцедуры
//++ Локализация
Процедура ПолучитьСведенияРНПТКорректировкиРеализации(ДанныеИБ, ДанныеXDTO, ТаблицаТоваров)
	// Необходимо заполнить идентификаторы строк в таблице товаров для соответствия 
	//	со сведениями о прослеживаемости
	ЕстьКолонкаИдентификаторСтроки = ТаблицаТоваров.Колонки.Найти("ИдентификаторСтроки") <> Неопределено;
	
	Если Не ЕстьКолонкаИдентификаторСтроки Тогда
		ТаблицаТоваров.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаТоваров Цикл
		Строка.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	КонецЦикла;
	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КорректировкаРеализацииВидыЗапасовОприходование.НомерГТД КАК НомерГТД,
		|	КорректировкаРеализацииВидыЗапасовОприходование.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	КорректировкаРеализацииВидыЗапасовОприходование.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|	КорректировкаРеализацииВидыЗапасовОприходование.АналитикаУчетаНоменклатуры.Серия КАК Серия,
		|	КорректировкаРеализацииВидыЗапасовОприходование.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
		|	КорректировкаРеализацииВидыЗапасовОприходование.Количество КАК Количество,
		|	""Оприходование"" КАК Операция,
		|	КорректировкаРеализацииВидыЗапасовОприходование.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	КорректировкаРеализацииВидыЗапасовОприходование.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ ВТ_КорректировкаРеализации
		|ИЗ
		|	Документ.КорректировкаРеализации.ВидыЗапасовОприходование КАК КорректировкаРеализацииВидыЗапасовОприходование
		|ГДЕ
		|	КорректировкаРеализацииВидыЗапасовОприходование.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КорректировкаРеализацииВидыЗапасовСписание.НомерГТД,
		|	КорректировкаРеализацииВидыЗапасовСписание.АналитикаУчетаНоменклатуры.Номенклатура,
		|	КорректировкаРеализацииВидыЗапасовСписание.АналитикаУчетаНоменклатуры.Характеристика,
		|	КорректировкаРеализацииВидыЗапасовСписание.АналитикаУчетаНоменклатуры.Серия,
		|	КорректировкаРеализацииВидыЗапасовСписание.КоличествоПоРНПТ,
		|	КорректировкаРеализацииВидыЗапасовСписание.Количество,
		|	""Списание"",
		|	КорректировкаРеализацииВидыЗапасовСписание.АналитикаУчетаНоменклатуры,
		|	КорректировкаРеализацииВидыЗапасовСписание.Упаковка
		|ИЗ
		|	Документ.КорректировкаРеализации.ВидыЗапасовСписание КАК КорректировкаРеализацииВидыЗапасовСписание
		|ГДЕ
		|	КорректировкаРеализацииВидыЗапасовСписание.Ссылка = &Ссылка
		|	И ЕСТЬNULL(КорректировкаРеализацииВидыЗапасовСписание.КодТНВЭД.ПрослеживаемыйТовар, ЛОЖЬ) = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РеализацияТоваровУслугВидыЗапасов.Количество КАК Количество,
		|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Серия КАК Серия,
		|	РеализацияТоваровУслугВидыЗапасов.НомерГТД КАК НомерГТД,
		|	РеализацияТоваровУслугВидыЗапасов.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
		|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	РеализацияТоваровУслугВидыЗапасов.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ ВТ_Реализация
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.ВидыЗапасов КАК РеализацияТоваровУслугВидыЗапасов
		|ГДЕ
		|	РеализацияТоваровУслугВидыЗапасов.Ссылка = &Реализация
		|	И РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура В
		|			(ВЫБРАТЬ
		|				ВТ_КорректировкаРеализации.Номенклатура
		|			ИЗ
		|				ВТ_КорректировкаРеализации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Реализация.Номенклатура КАК Номенклатура,
		|	ВТ_Реализация.Характеристика КАК Характеристика,
		|	ВТ_Реализация.Серия КАК Серия,
		|	ВТ_Реализация.НомерГТД КАК НомерГТДРеализация,
		|	ЕСТЬNULL(ВТ_КорректировкаРеализации.НомерГТД, """") КАК НомерГТДКорректировка,
		|	ЕСТЬNULL(ВТ_Реализация.КоличествоПоРНПТ, 0) - ЕСТЬNULL(ВТ_КорректировкаРеализации.КоличествоПоРНПТ, 0) КАК КоличествоПоРНПТИтог,
		|	ЕСТЬNULL(ВТ_Реализация.Количество, 0) - ЕСТЬNULL(ВТ_КорректировкаРеализации.Количество, 0) КАК КоличествоИтог,
		|	ВТ_Реализация.Количество КАК КоличествоИсходное,
		|	ВТ_Реализация.КоличествоПоРНПТ КАК КоличествоПоРНПТИсходное,
		|	ЕСТЬNULL(ВТ_КорректировкаРеализации.Количество, 0) КАК КоличествоВКоректировке,
		|	ЕСТЬNULL(ВТ_КорректировкаРеализации.КоличествоПоРНПТ, 0) КАК КоличествоПоРНПТКорректировка,
		|	ВТ_КорректировкаРеализации.Упаковка КАК УпаковкаКорректировка,
		|	ВТ_Реализация.Упаковка КАК УпаковкаРеализация,
		|	ВТ_КорректировкаРеализации.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
		|	ВТ_Реализация.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар КАК РеализацияПрослеживаемыйТовар
		|ПОМЕСТИТЬ ВТ_Общая
		|ИЗ
		|	ВТ_Реализация КАК ВТ_Реализация
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КорректировкаРеализации КАК ВТ_КорректировкаРеализации
		|		ПО (ВТ_КорректировкаРеализации.АналитикаУчетаНоменклатуры = ВТ_Реализация.АналитикаУчетаНоменклатуры)
		|			И (ВТ_КорректировкаРеализации.НомерГТД = ВТ_Реализация.НомерГТД)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""ИсходныеСведения"" КАК ТипКорректировочнойСтроки,
		|	ВТ_Общая.Номенклатура КАК Номенклатура,
		|	ВТ_Общая.Характеристика КАК Характеристика,
		|	ВТ_Общая.Серия КАК Серия,
		|	ВТ_Общая.НомерГТДРеализация КАК НомерГТДРеализация,
		|	ВТ_Общая.КоличествоИсходное КАК КоличествоИсходное,
		|	ВТ_Общая.КоличествоПоРНПТИсходное КАК КоличествоПоРНПТИсходное,
		|	ВТ_Общая.КоличествоИтог КАК КоличествоИтог,
		|	ВТ_Общая.КоличествоПоРНПТИтог КАК КоличествоПоРНПТИтог,
		|	ВТ_Общая.УпаковкаРеализация КАК УпаковкаРеализация,
		|	ВТ_Общая.Номенклатура.КодТНВЭД.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПрослеживаемости
		|ПОМЕСТИТЬ ИсходныеСведения
		|ИЗ
		|	ВТ_Общая КАК ВТ_Общая
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
		|		ПО ВТ_Общая.НомерГТДРеализация = НомераГТД.Ссылка
		|ГДЕ
		|	НЕ НомераГТД.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта)
		|	И ВТ_Общая.КоличествоИсходное > 0
		|	И ЕСТЬNULL(ВТ_Общая.РеализацияПрослеживаемыйТовар, ЛОЖЬ) = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ИсходныеСведения"",
		|	ВТ_Общая.Номенклатура,
		|	ВТ_Общая.Характеристика,
		|	ВТ_Общая.Серия,
		|	ВТ_Общая.НомерГТДРеализация,
		|	ВТ_Общая.КоличествоИсходное,
		|	ВТ_Общая.КоличествоПоРНПТИсходное,
		|	ВТ_Общая.КоличествоИтог,
		|	ВТ_Общая.КоличествоПоРНПТИтог,
		|	ВТ_Общая.УпаковкаРеализация,
		|	ВТ_Общая.Номенклатура.КодТНВЭД.ЕдиницаИзмерения
		|ИЗ
		|	ВТ_Общая КАК ВТ_Общая
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НомераГТД.ПрослеживаемыеКомплектующие КАК НомераГТДПрослеживаемыеКомплектующие
		|		ПО ВТ_Общая.НомерГТДРеализация = НомераГТДПрослеживаемыеКомплектующие.Ссылка
		|ГДЕ
		|	НомераГТДПрослеживаемыеКомплектующие.Ссылка.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта)
		|	И ВТ_Общая.КоличествоИсходное > 0
		|	И ЕСТЬNULL(ВТ_Общая.РеализацияПрослеживаемыйТовар, ЛОЖЬ) = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""СведенияПослеКорректировки"" КАК ТипКорректировочнойСтроки,
		|	ВТ_Общая.Номенклатура КАК Номенклатура,
		|	ВТ_Общая.Характеристика КАК Характеристика,
		|	ВТ_Общая.Серия КАК Серия,
		|	ВТ_Общая.НомерГТДРеализация КАК НомерГТДРеализация,
		|	ВТ_Общая.НомерГТДКорректировка КАК НомерГТДКорректировка,
		|	ВТ_Общая.КоличествоПоРНПТИтог КАК КоличествоПоРНПТИтог,
		|	ВТ_Общая.КоличествоИтог КАК КоличествоИтог,
		|	ВТ_Общая.КоличествоИсходное КАК КоличествоИсходное,
		|	ВТ_Общая.КоличествоПоРНПТИсходное КАК КоличествоПоРНПТИсходное,
		|	ВТ_Общая.КоличествоВКоректировке КАК КоличествоВКоректировке,
		|	ВТ_Общая.КоличествоПоРНПТКорректировка КАК КоличествоПоРНПТКорректировка,
		|	ВТ_Общая.УпаковкаКорректировка КАК УпаковкаКорректировка,
		|	ВТ_Общая.УпаковкаРеализация КАК УпаковкаРеализация,
		|	ВТ_Общая.Номенклатура.КодТНВЭД.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПрослеживаемости
		|ПОМЕСТИТЬ СведенияПослеКорректировки
		|ИЗ
		|	ВТ_Общая КАК ВТ_Общая
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
		|		ПО (ВТ_Общая.НомерГТДКорректировка = НомераГТД.Ссылка
		|				ИЛИ ВТ_Общая.НомерГТДРеализация = НомераГТД.Ссылка)
		|ГДЕ
		|	НЕ НомераГТД.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта)
		|	И ВТ_Общая.КоличествоИтог > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""СведенияПослеКорректировки"",
		|	ВТ_Общая.Номенклатура,
		|	ВТ_Общая.Характеристика,
		|	ВТ_Общая.Серия,
		|	ВТ_Общая.НомерГТДРеализация,
		|	ВТ_Общая.НомерГТДКорректировка,
		|	ВТ_Общая.КоличествоПоРНПТИтог,
		|	ВТ_Общая.КоличествоИтог,
		|	ВТ_Общая.КоличествоИсходное,
		|	ВТ_Общая.КоличествоПоРНПТИсходное,
		|	ВТ_Общая.КоличествоВКоректировке,
		|	ВТ_Общая.КоличествоПоРНПТКорректировка,
		|	ВТ_Общая.УпаковкаКорректировка,
		|	ВТ_Общая.УпаковкаРеализация,
		|	ВТ_Общая.Номенклатура.КодТНВЭД.ЕдиницаИзмерения
		|ИЗ
		|	ВТ_Общая КАК ВТ_Общая
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НомераГТД.ПрослеживаемыеКомплектующие КАК НомераГТДПрослеживаемыеКомплектующие
		|		ПО ВТ_Общая.НомерГТДКорректировка = НомераГТДПрослеживаемыеКомплектующие.Ссылка
		|ГДЕ
		|	НомераГТДПрослеживаемыеКомплектующие.Ссылка.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта)
		|	И ВТ_Общая.КоличествоИтог > 0
		|	И ЕСТЬNULL(ВТ_Общая.ПрослеживаемыйТовар, ЛОЖЬ) = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсходныеСведения.ТипКорректировочнойСтроки КАК ТипКорректировочнойСтроки,
		|	ИсходныеСведения.Номенклатура КАК Номенклатура,
		|	ИсходныеСведения.Характеристика КАК Характеристика,
		|	ИсходныеСведения.Серия КАК Серия,
		|	ИсходныеСведения.НомерГТДРеализация КАК РНПТ,
		|	ИсходныеСведения.КоличествоИсходное КАК Количество,
		|	ИсходныеСведения.КоличествоПоРНПТИсходное КАК КоличествоПоРНПТИсходное,
		|	ИсходныеСведения.УпаковкаРеализация КАК УпаковкаОтбор,
		|	ИсходныеСведения.ЕдиницаИзмеренияПрослеживаемости КАК ЕдиницаИзмеренияРНПТ
		|ИЗ
		|	ИсходныеСведения КАК ИсходныеСведения
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СведенияПослеКорректировки.ТипКорректировочнойСтроки,
		|	СведенияПослеКорректировки.Номенклатура,
		|	СведенияПослеКорректировки.Характеристика,
		|	СведенияПослеКорректировки.Серия,
		|	ВЫБОР
		|		КОГДА СведенияПослеКорректировки.НомерГТДКорректировка = """"
		|			ТОГДА СведенияПослеКорректировки.НомерГТДРеализация
		|		ИНАЧЕ СведенияПослеКорректировки.НомерГТДКорректировка
		|	КОНЕЦ,
		|	СведенияПослеКорректировки.КоличествоИтог,
		|	СведенияПослеКорректировки.КоличествоПоРНПТИтог,
		|	ВЫБОР
		|		КОГДА НЕ СведенияПослеКорректировки.УпаковкаРеализация = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|			ТОГДА СведенияПослеКорректировки.УпаковкаРеализация
		|		КОГДА НЕ СведенияПослеКорректировки.УпаковкаКорректировка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|			ТОГДА СведенияПослеКорректировки.УпаковкаКорректировка
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|	КОНЕЦ,
		|	СведенияПослеКорректировки.ЕдиницаИзмеренияПрослеживаемости
		|ИЗ
		|	СведенияПослеКорректировки КАК СведенияПослеКорректировки";
	
	Запрос.УстановитьПараметр("Реализация", ДанныеИБ.ДокументОснование);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Результат = Запрос.Выполнить();
	СведенияРНПТ = Результат.Выгрузить();
	СведенияРНПТ.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
	Для каждого Стр Из СведенияРНПТ Цикл
	    Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", Стр.Номенклатура);
		Отбор.Вставить("ХарактеристикаСсылка", Стр.Характеристика);
		Отбор.Вставить("УпаковкаСсылка", Стр.УпаковкаОтбор);
		Отбор.Вставить("Серия", Стр.Серия);
		НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(Отбор); 
		Если НайденныеСтроки.Количество() = 0 Тогда
		    Продолжить
		КонецЕсли;   
		Стр.ИдентификаторСтроки = НайденныеСтроки[0].ИдентификаторСтроки;		
	КонецЦикла; 
	
	Если Не Результат.Пустой() Тогда
		
		ДанныеXDTO.Вставить("СведенияРНПТ", СведенияРНПТ);
		
	КонецЕсли;
КонецПроцедуры
Функция ПолучитьСистемуНалогообложения(Знач Организация, Знач Дата, Знач ТолькоОсновноеСНО, Знач Склад = Неопределено, Знач Подразделение = Неопределено)
	СистемаНалогообложения = Неопределено;
	
	ПараметрыПолитики = НастройкиНалоговУчетныхПолитик.ДействующиеПараметрыНалоговУчетныхПолитикНаДату(
		"НастройкиСистемыНалогообложения", Организация);
	
	Если Не ПараметрыПолитики = Неопределено Тогда
		
		Если ПараметрыПолитики.ПрименяетсяУСН Тогда
			ПараметрыПолитикиУСН = НастройкиНалоговУчетныхПолитик.ДействующиеПараметрыНалоговУчетныхПолитикНаДату(
			"НастройкиУчетаУСН", Организация);
		КонецЕсли;
		
		ПараметрыУчетаПоОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(Организация, Дата, Склад, Подразделение);
		
		Если НЕ ТолькоОсновноеСНО И ПараметрыПолитики.ПрименяетсяПСН 
			И ПараметрыУчетаПоОрганизации.НалогообложениеНДСРозничнойПродажи = Перечисления.ТипыНалогообложенияНДС.ПродажаПоПатенту Тогда
			СистемаНалогообложения = "ПатентнаяСистема";
		ИначеЕсли НЕ ТолькоОсновноеСНО И ПараметрыПолитики.ПрименяетсяЕНВД И ПараметрыУчетаПоОрганизации.ПрименяетсяЕНВД Тогда
			СистемаНалогообложения = "ЕНВД";
		ИначеЕсли ПараметрыПолитики.ПрименяетсяУСН Тогда 
			Если Не ПараметрыПолитикиУСН = Неопределено И ПараметрыПолитикиУСН.ПрименяетсяУСНДоходыМинусРасходы Тогда
				СистемаНалогообложения = "УпрощеннаяДоходМинусРасход";
			Иначе
				СистемаНалогообложения = "УпрощеннаяДоход";
			КонецЕсли;
		Иначе
	
			Если Не ПараметрыПолитикиУСН = Неопределено И ПараметрыПолитикиУСН.ПрименяетсяУСНДоходыМинусРасходы Тогда
				СистемаНалогообложения = "УпрощеннаяДоходМинусРасход";
			Иначе
				СистемаНалогообложения = "Общая";
			КонецЕсли;
	
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат СистемаНалогообложения;
КонецФункции
//-- Локализация
Функция ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, ПолноеИмяМенеджераОбъекта)
	// Функция возвращает ссылку на объект, найденную по идентификатору и имени объекта метаданных,
	// в противном случае возвращается Неопределено.
	//
	// ПолноеИмяМенеджераОбъекта - Строка
	
	Если ДанныеXDTO.Свойство("Ссылка") И ЗначениеЗаполнено(ДанныеXDTO.Ссылка) Тогда
	
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяМенеджераОбъекта);
		
		СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеXDTO.Ссылка.Значение));
		Если ЗначениеЗаполнено(СсылкаНаОбъект) И ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
			Возврат СсылкаНаОбъект;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции
Функция ПолучитьТекстЗапросаSKU(КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.10") Тогда
		ТекстЗапроса = "ЛОЖЬ";
	Иначе	
		ТекстЗапроса = "ИСТИНА";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
КонецФункции
Функция ПолучитьТекстЗапросаГТД(КомпонентыОбмена, НаименованиеИсточника)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
			ТекстЗапроса = "&НаименованиеИсточника.НомерГТД КАК НомерГТД,
			        |	&НаименованиеИсточника.НомерГТД.СуммаПоРНПТ КАК СуммаРНПТ,
					|	&НаименованиеИсточника.НомерГТД.ТипНомераГТД = Значение(Перечисление.ТипыНомеровГТД.НомерРНПТ) Как ЯвляетсяРНПТ,
					|	Выбор Когда ТИПЗНАЧЕНИЯ(&НаименованиеИсточника.НомерГТД) = ТИП(Справочник.НомераГТД) ТОГДА
					|		&НаименованиеИсточника.НомерГТД.СтранаПроисхождения 
					|	Иначе """" Конец КАК СтранаПроисхождения";
	
	ИначеЕсли ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
			ТекстЗапроса = "&НаименованиеИсточника.НомерГТД КАК НомерГТД,
					|	&НаименованиеИсточника.НомерГТД.ТипНомераГТД = Значение(Перечисление.ТипыНомеровГТД.НомерРНПТ) Как ЯвляетсяРНПТ,
					|	Выбор Когда ТИПЗНАЧЕНИЯ(&НаименованиеИсточника.НомерГТД) = ТИП(Справочник.НомераГТД) ТОГДА
					|		&НаименованиеИсточника.НомерГТД.СтранаПроисхождения 
					|	Иначе """" Конец КАК СтранаПроисхождения";
	Иначе
		ТекстЗапроса = "&НаименованиеИсточника.НомерГТД.Код КАК НомерГТД,
					|	&НаименованиеИсточника.НомерГТД.СтранаПроисхождения КАК СтранаПроисхождения";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеИсточника", НаименованиеИсточника);
	
	Возврат ТекстЗапроса;
КонецФункции
Функция ПолучитьТекстЗапросаРНПТ(КомпонентыОбмена, НаименованиеИсточника, НаименованиеИсточникаНоменклатуры = "")
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		ТекстЗапроса = "&НаименованиеИсточникаНоменклатуры.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
						|	&НаименованиеИсточника.КоличествоПоРНПТ КАК КоличествоРНПТ,
						|	&НаименованиеИсточникаНоменклатуры.Номенклатура.КодТНВЭД.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПрослеживаемости";
	Иначе
		ТекстЗапроса = "НЕОПРЕДЕЛЕНО КАК ПрослеживаемыйТовар,
						|	НЕОПРЕДЕЛЕНО КАК КоличествоРНПТ,
						|	НЕОПРЕДЕЛЕНО КАК ЕдиницаИзмеренияПрослеживаемости";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаименованиеИсточникаНоменклатуры) Тогда
		НаименованиеИсточникаНоменклатуры = НаименованиеИсточника;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеИсточникаНоменклатуры", НаименованиеИсточникаНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеИсточника", НаименованиеИсточника);
	
	Возврат ТекстЗапроса;
КонецФункции
Функция ПолучитьТекстЗапросаРНПТ_ПеремещениеТоваров(КомпонентыОбмена, НаименованиеИсточника, НаименованиеИсточникаНоменклатуры = "")
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.11") Тогда
		ТекстЗапроса = "&НаименованиеИсточникаНоменклатуры.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
						|	&НаименованиеИсточника.КоличествоПоРНПТ КАК КоличествоРНПТ,
						|	&НаименованиеИсточникаНоменклатуры.Номенклатура.КодТНВЭД.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПрослеживаемости";
	ИначеЕсли ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) = ВерсияФорматаЧислом("1.10") Тогда
		ТекстЗапроса = "&НаименованиеИсточникаНоменклатуры.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
						|	ВЫРАЗИТЬ(&НаименованиеИсточника.КоличествоПоРНПТ КАК Число(15,3)) КАК КоличествоРНПТ,
						|	&НаименованиеИсточникаНоменклатуры.Номенклатура.КодТНВЭД.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПрослеживаемости";
	Иначе
		ТекстЗапроса = "НЕОПРЕДЕЛЕНО КАК ПрослеживаемыйТовар,
						|	НЕОПРЕДЕЛЕНО КАК КоличествоРНПТ,
						|	НЕОПРЕДЕЛЕНО КАК ЕдиницаИзмеренияПрослеживаемости";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаименованиеИсточникаНоменклатуры) Тогда
		НаименованиеИсточникаНоменклатуры = НаименованиеИсточника;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеИсточникаНоменклатуры", НаименованиеИсточникаНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеИсточника", НаименованиеИсточника);
	
	Возврат ТекстЗапроса;
КонецФункции
Функция ПолучитьТекстЗапросаСерии(КомпонентыОбмена, НаименованиеИсточника)
