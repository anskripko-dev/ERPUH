Процедура ПроверитьОбновитьРеквизитыОбъекта(СсылкаНаОбъект, ЗначенияРеквизитов, КомпонентыОбмена)
	// "ЗначенияРеквизитов" - Структура, где Ключ - имя реквизита, Значение - значение реквизита.
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) И ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
		
		РеквизитыПроверки = "";
		Для Каждого ЭлементСтруктуры из ЗначенияРеквизитов Цикл
			РеквизитыПроверки = РеквизитыПроверки + ?(РеквизитыПроверки="", "",", ") + ЭлементСтруктуры.Ключ;	
		КонецЦикла;
		
		РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, РеквизитыПроверки);
		
		Если НЕ ОбщегоНазначения.КоллекцииИдентичны(ЗначенияРеквизитов, РеквизитыОбъекта) Тогда
			Объект = СсылкаНаОбъект.ПолучитьОбъект();
			
			Для Каждого ЭлементСтруктуры из ЗначенияРеквизитов Цикл
				Объект[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;	
			КонецЦикла;
			
			Объект.ОбменДанными.Загрузка = Истина;
	
			Попытка
				Объект.Записать();
			Исключение
				ЗаписатьОшибкуВЖурналРегистрации(СсылкаНаОбъект,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), КомпонентыОбмена);
			КонецПопытки;
		КонецЕсли;
			
	КонецЕсли;
КонецПроцедуры
