	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Владелец",       "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "ДатаВыдачи",     "ДатаВыдачи");
	ДобавитьПКС(СвойстваШапки, "ДатаНачала",     "ДатаНачала");
	ДобавитьПКС(СвойстваШапки, "ДатаОкончания",  "ДатаОкончания");
	ДобавитьПКС(СвойстваШапки, "Наименование",   "Наименование", 1);
	ДобавитьПКС(СвойстваШапки, "НалоговыйОрган", "", 1);
	ДобавитьПКС(СвойстваШапки, "НомерПатента",   "НомерПатента");
	ПравилоКонвертации.ПоляПоиска.Добавить("Владелец,НомерПатента,ДатаВыдачи");
	ПравилоКонвертации.ПоляПоиска.Добавить("Владелец,НомерПатента");
КонецПроцедуры
Процедура ПКО_СправочникСсылка_Патенты_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.НалоговыйОрган) Тогда
	
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	РегистрацииВНалоговомОргане.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
			|ГДЕ
			|	РегистрацииВНалоговомОргане.Владелец = &Организация
			|	И РегистрацииВНалоговомОргане.Код = &Код");
		Запрос.УстановитьПараметр("Код", ДанныеXDTO.КлючевыеСвойства.КодНалоговогоОргана);
		Запрос.УстановитьПараметр("Организация", ПолученныеДанные.Владелец);
	
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			НалоговыйОрган = Выборка.Ссылка;
			Если ЗначениеЗаполнено(НалоговыйОрган) Тогда
				ПолученныеДанные.НалоговыйОрган = НалоговыйОрган;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Наименование) Тогда
		ПолученныеДанные.Наименование = ДанныеXDTO.КлючевыеСвойства.НомерПатента
	КонецЕсли;
КонецПроцедуры

