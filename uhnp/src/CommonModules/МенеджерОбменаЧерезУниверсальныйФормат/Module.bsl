Процедура ДобавитьПОД_Документ_ДвижениеПродукцииИМатериалов_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_ДвижениеПродукцииИМатериалов_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.ДвижениеПродукцииИМатериалов;
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_ДвижениеПродукцииИМатериалов_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Истина;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ДвижениеПродукцииИМатериалов_ВозвратИзПр");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ДвижениеПродукцииИМатериалов_ВПроизводств");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ДвижениеПродукцииИМатериалов_ВПрСписЗапас");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ДвижениеПродукцииИМатериалов_ВыпускПрод");
КонецПроцедуры
Процедура ПОД_Документ_ДвижениеПродукцииИМатериалов_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
		
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеПолуфабрикатов Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	СсылкаСклад         = Неопределено;
	СсылкаПодразделение = Неопределено;
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаМатериаловВПроизводство
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую Тогда
		#Область ПередачаВПроизводство
		
		СсылкаСклад         = ДанныеИБ.Отправитель;
		СсылкаПодразделение = ДанныеИБ.Получатель;
		
		Если ЗначениеЗаполнено(СсылкаСклад) И ОбщегоНазначения.СсылкаСуществует(СсылкаСклад)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаСклад, "ЦеховаяКладовая") Тогда
			Возврат;
		КонецЕсли;
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	Аналитика.Номенклатура КАК Номенклатура,
			|	Аналитика.Характеристика КАК Характеристика,
			|	Аналитика.Серия КАК Серия,
			|	Аналитика.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ВидыЗапасов.НомерГТД КАК НомерГТД,
			|	СУММА(ВидыЗапасов.КоличествоПоРНПТ) КАК КоличествоПоРНПТ,
			|	ВидыЗапасов.ГруппаПродукции КАК ГруппаАналитическогоУчетаНоменклатуры,
			|	ВЫБОР
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
			|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
			|			ТОГДА ""ДавальческиеСырьеИМатериалы""
			|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
			|	КОНЕЦ КАК ТипЗапасов,
			|	ВЫБОР 
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
			|			И ТИПЗНАЧЕНИЯ(ВидыЗапасов.ВидЗапасов.Контрагент) = ТИП(Справочник.Контрагенты)
			|			ТОГДА ВидыЗапасов.ВидЗапасов.Контрагент
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяССылка)
			|	КОНЕЦ КАК Заказчик,
			|	СУММА(ВидыЗапасов.Количество) КАК Количество
			|ПОМЕСТИТЬ ТоварыВсе
			|ИЗ
			|	Документ.ДвижениеПродукцииИМатериалов.ВидыЗапасов КАК ВидыЗапасов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
			|		ПО ВидыЗапасов.АналитикаУчетаНоменклатуры = Аналитика.КлючАналитики
			|ГДЕ
			|	ВидыЗапасов.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	Аналитика.Номенклатура,
			|	Аналитика.Номенклатура.ЕдиницаИзмерения,
			|	ВидыЗапасов.НомерГТД,
			|	ВидыЗапасов.ГруппаПродукции,
			|	ВЫБОР
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
			|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
			|			ТОГДА ""ДавальческиеСырьеИМатериалы""
			|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
			|	КОНЕЦ,
			|	ВЫБОР 
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
			|			И ТИПЗНАЧЕНИЯ(ВидыЗапасов.ВидЗапасов.Контрагент) = ТИП(Справочник.Контрагенты)
			|			ТОГДА ВидыЗапасов.ВидЗапасов.Контрагент
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяССылка)
			|	КОНЕЦ,
			|	Аналитика.Характеристика,
			|	Аналитика.Серия
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ТипЗапасов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаРНПТ,
			|	&ТекстЗапросаГТД,
			|	Товары.Количество КАК Количество,
			|	Товары.Заказчик КАК Заказчик,
			|	Товары.ГруппаАналитическогоУчетаНоменклатуры КАК ГруппаАналитическогоУчетаНоменклатуры,
			|	Товары.ТипЗапасов КАК ТипЗапасов
			|ИЗ
			|	ТоварыВсе КАК Товары
			|ГДЕ
			|	НЕ Товары.ТипЗапасов = ""КомиссионныеТовары""
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаРНПТ,
			|	&ТекстЗапросаГТД,
			|	Товары.Количество КАК Количество,
			|	Товары.ТипЗапасов КАК ТипЗапасов
			|ИЗ
			|	ТоварыВсе КАК Товары
			|ГДЕ
			|	Товары.ТипЗапасов = ""КомиссионныеТовары""";
		
		ЗаполнитьСобственныеТоварыВТексте(ТекстЗапроса);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
			ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "Товары"));
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
			ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "Товары"));
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаРНПТ",
			ПолучитьТекстЗапросаРНПТ(КомпонентыОбмена, "Товары"));
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаГТД",
			ПолучитьТекстЗапросаГТД(КомпонентыОбмена, "Товары"));
			
		Запрос.Текст = ТекстЗапроса;
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		СобственныеТовары  = РезультатЗапроса[1].Выгрузить();
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, СобственныеТовары, Истина, Ложь);
		КомиссионныеТовары = РезультатЗапроса[2].Выгрузить();
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, КомиссионныеТовары, Истина, Ложь);
		
		Если СобственныеТовары.Количество() > 0 Тогда
			ДанныеИБ.ДополнительныеСвойства.Вставить("СобственныеТовары", СобственныеТовары);
			ИспользованиеПКО.Документ_ДвижениеПродукцииИМатериалов_ВПроизводств = Истина;
		КонецЕсли;
		
		Если КомиссионныеТовары.Количество() > 0 Тогда    
			ДанныеИБ.ДополнительныеСвойства.Вставить("КомиссионныеТовары", КомиссионныеТовары);
			ИспользованиеПКО.Документ_ДвижениеПродукцииИМатериалов_ВПрСписЗапас = Истина;
		КонецЕсли;
		
		#КонецОбласти
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства
			Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзКладовой Тогда
		#Область ВыпускПродукции
		
		СсылкаСклад         = ДанныеИБ.Получатель;
		СсылкаПодразделение = ДанныеИБ.Отправитель;
		
		Если ЗначениеЗаполнено(СсылкаСклад) И ОбщегоНазначения.СсылкаСуществует(СсылкаСклад)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаСклад, "ЦеховаяКладовая") Тогда
			Возврат;
		КонецЕсли;
		
		ВидПлановыхЦен = ИспользуемыйВидПлановыхЦен(КомпонентыОбмена);
		
		Если Не ЗначениеЗаполнено(ВидПлановыхЦен) Тогда
			// Цены должны быть указаны в документе.
			ТекстЗапроса =
				"ВЫБРАТЬ
				|	Товары.Номенклатура КАК Номенклатура,
				|	СУММА(Товары.Количество) КАК Количество,
				|	СУММА(Товары.Сумма) КАК Сумма,
				|	Товары.Характеристика КАК Характеристика,
				|	Товары.Серия КАК Серия
				|ПОМЕСТИТЬ втТовары
				|ИЗ
				|	Документ.ДвижениеПродукцииИМатериалов.Товары КАК Товары
				|ГДЕ
				|	Товары.Ссылка = &Ссылка
				|
				|СГРУППИРОВАТЬ ПО
				|	Товары.Номенклатура,
				|	Товары.Характеристика,
				|	Товары.Серия
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Серия КАК Серия,
				|	ВЫБОР
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
				|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
				|			ТОГДА ""ДавальческиеСырьеИМатериалы""
				|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
				|	КОНЕЦ КАК ТипЗапасов,
				|	ВидыЗапасов.НомерГТД КАК НомерГТД,
				|	СУММА(ВидыЗапасов.КоличествоПоРНПТ) КАК КоличествоПоРНПТ,
				|	СУММА(ВидыЗапасов.Количество) КАК Количество
				|ПОМЕСТИТЬ втВидыЗапасов
				|ИЗ
				|	Документ.ДвижениеПродукцииИМатериалов.ВидыЗапасов КАК ВидыЗапасов
				|ГДЕ
				|	ВидыЗапасов.Ссылка = &Ссылка
				|
				|СГРУППИРОВАТЬ ПО
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Характеристика,
				|	ВидыЗапасов.НомерГТД,
				|	ВЫБОР
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
				|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
				|			ТОГДА ""ДавальческиеСырьеИМатериалы""
				|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
				|	КОНЕЦ,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Серия,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Номенклатура,
				|	Характеристика,
				|	Серия
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	втВидыЗапасов.Номенклатура КАК Номенклатура,
				|	втВидыЗапасов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				|	&ТекстЗапросаХарактеристика,
				|	&ТекстЗапросаСерия,
				|	&ТекстЗапросаРНПТ,
				|	&ТекстЗапросаГТД,
				|	втВидыЗапасов.ТипЗапасов КАК ТипЗапасов,
				|	втВидыЗапасов.Количество КАК Количество,
				|	ВЫРАЗИТЬ(втТовары.Сумма / втТовары.Количество * втВидыЗапасов.Количество КАК ЧИСЛО(31, 2)) КАК Сумма,
				|	ВЫРАЗИТЬ(втТовары.Сумма / втТовары.Количество КАК ЧИСЛО(31, 2)) КАК Цена
				|ИЗ
				|	втВидыЗапасов КАК втВидыЗапасов
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТовары КАК втТовары
				|		ПО втВидыЗапасов.Номенклатура = втТовары.Номенклатура
				|			И втВидыЗапасов.Характеристика = втТовары.Характеристика
				|			И втВидыЗапасов.Серия = втТовары.Серия";
		Иначе
			// Используется плановый вид цен, указанный в константе ВидЦеныПлановойСтоимостиМатериаловРабот.
			ТекстЗапроса =
				"ВЫБРАТЬ
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Серия КАК Серия,
				|	ВЫБОР
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
				|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
				|			ТОГДА ""ДавальческиеСырьеИМатериалы""
				|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
				|	КОНЕЦ КАК ТипЗапасов,
				|	ВидыЗапасов.НомерГТД КАК НомерГТД,
				|	СУММА(ВидыЗапасов.КоличествоПоРНПТ) КАК КоличествоПоРНПТ,
				|	СУММА(ВидыЗапасов.Количество) КАК Количество
				|ПОМЕСТИТЬ втВидыЗапасов
				|ИЗ
				|	Документ.ДвижениеПродукцииИМатериалов.ВидыЗапасов КАК ВидыЗапасов
				|ГДЕ
				|	ВидыЗапасов.Ссылка = &Ссылка
				|
				|СГРУППИРОВАТЬ ПО
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Характеристика,
				|	ВидыЗапасов.НомерГТД,
				|	ВЫБОР
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
				|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
				|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
				|			ТОГДА ""ДавальческиеСырьеИМатериалы""
				|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
				|	КОНЕЦ,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Серия,
				|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Номенклатура,
				|	Характеристика
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	втВидыЗапасов.Номенклатура КАК Номенклатура,
				|	втВидыЗапасов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				|	втВидыЗапасов.ТипЗапасов КАК ТипЗапасов,
				|	втВидыЗапасов.Количество КАК Количество,
				|	ВЫРАЗИТЬ(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) * ЕСТЬNULL(КурсыВалютСрезПоследних.КурсЧислитель, 1) / ЕСТЬNULL(КурсыВалютСрезПоследних.КурсЗнаменатель, 1) КАК ЧИСЛО(31, 2)) КАК Цена,
				|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) * ЕСТЬNULL(КурсыВалютСрезПоследних.КурсЧислитель, 1) / ЕСТЬNULL(КурсыВалютСрезПоследних.КурсЗнаменатель, 1) КАК ЧИСЛО(31, 2))) * втВидыЗапасов.Количество КАК ЧИСЛО(31, 2)) КАК Сумма,
				|	&ТекстЗапросаХарактеристика,
				|	&ТекстЗапросаСерия,
				|	&ТекстЗапросаРНПТ,
				|	&ТекстЗапросаГТД
				|ИЗ
				|	втВидыЗапасов КАК втВидыЗапасов
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаДокумента, ВидЦены = &ВидПлановыхЦен) КАК ЦеныНоменклатурыСрезПоследних
				|		ПО втВидыЗапасов.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
				|			И втВидыЗапасов.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтносительныеКурсыВалют.СрезПоследних(&ДатаДокумента, БазоваяВалюта = &БазоваяВалюта) КАК КурсыВалютСрезПоследних
				|		ПО (ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта)";
			
			Запрос.УстановитьПараметр("ВидПлановыхЦен", ВидПлановыхЦен);
			Запрос.УстановитьПараметр("ДатаДокумента",  ДанныеИБ.Дата);
			Запрос.УстановитьПараметр("БазоваяВалюта", ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ДанныеИБ.Организация));
			
		КонецЕсли;
		
		ЗаполнитьСобственныеТоварыВТексте(ТекстЗапроса);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
			ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "втВидыЗапасов"));
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
			ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "втВидыЗапасов"));
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаРНПТ",
			ПолучитьТекстЗапросаРНПТ(КомпонентыОбмена, "втВидыЗапасов"));
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаГТД",
			ПолучитьТекстЗапросаГТД(КомпонентыОбмена, "втВидыЗапасов"));
			
		Запрос.Текст = ТекстЗапроса;
		
		Товары = Запрос.Выполнить().Выгрузить();
		
		Если Товары.Количество() > 0 Тогда
			ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары, Истина, Ложь);
	
			ДанныеИБ.ДополнительныеСвойства.Вставить("Товары", Товары);
			ИспользованиеПКО.Документ_ДвижениеПродукцииИМатериалов_ВыпускПрод = Истина;
		КонецЕсли;
		
		#КонецОбласти
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратМатериаловИзПроизводства
			ИЛИ ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратМатериаловИзКладовой Тогда
		#Область ВозвратИзПроизводства
		
		СсылкаСклад         = ДанныеИБ.Получатель;
		СсылкаПодразделение = ДанныеИБ.Отправитель;
		
		Если ЗначениеЗаполнено(СсылкаСклад) И ОбщегоНазначения.СсылкаСуществует(СсылкаСклад)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаСклад, "ЦеховаяКладовая") Тогда
			Возврат;
		КонецЕсли;
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ВидыЗапасов.Количество КАК Количество,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаРНПТ,
			|	&ТекстЗапросаГТД,
			|	ВЫБОР
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
			|			ТОГДА ""КомиссионныеТовары""
			|		КОГДА ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.МатериалДавальца)
			|			ТОГДА ""ДавальческиеСырьеИМатериалы""
			|		ИНАЧЕ &СобственныеТовары
			|	КОНЕЦ КАК ТипЗапасов
			|ИЗ
			|	Документ.ДвижениеПродукцииИМатериалов.ВидыЗапасов КАК ВидыЗапасов
			|ГДЕ
			|	ВидыЗапасов.Ссылка = &Ссылка";
		
		ЗаполнитьСобственныеТоварыВТексте(ТекстЗапроса);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
			ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "ВидыЗапасов.АналитикаУчетаНоменклатуры"));
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
			ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "ВидыЗапасов.АналитикаУчетаНоменклатуры"));
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаРНПТ",
			ПолучитьТекстЗапросаРНПТ(КомпонентыОбмена, "ВидыЗапасов", "ВидыЗапасов.АналитикаУчетаНоменклатуры"));
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаГТД",
			ПолучитьТекстЗапросаГТД(КомпонентыОбмена, "ВидыЗапасов"));
	
		Запрос.Текст = ТекстЗапроса;
		
		Товары = Запрос.Выполнить().Выгрузить();
		
		Если Товары.Количество() > 0 Тогда
			ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары, Истина, Ложь);
			ДанныеИБ.ДополнительныеСвойства.Вставить("Товары", Товары);
			ИспользованиеПКО.Документ_ДвижениеПродукцииИМатериалов_ВозвратИзПр = Истина;
		КонецЕсли;
		
		#КонецОбласти
	Иначе
		Возврат;
	КонецЕсли;
	
	ДанныеИБ.ДополнительныеСвойства.Вставить("Склад", СкладДляВыгрузки(СсылкаСклад, КомпонентыОбмена.ПараметрыКонвертации));
		
	Если ТипЗнч(СсылкаПодразделение) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
		ДанныеИБ.ДополнительныеСвойства.Вставить("Подразделение", СсылкаПодразделение);
	ИначеЕсли ТипЗнч(СсылкаПодразделение) = Тип("СправочникСсылка.Склады") Тогда
		ДанныеИБ.ДополнительныеСвойства.Вставить("Подразделение", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаПодразделение, "Подразделение"));
	Иначе
		ДанныеИБ.ДополнительныеСвойства.Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

