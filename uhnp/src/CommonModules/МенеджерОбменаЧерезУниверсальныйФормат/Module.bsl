Процедура ПКО_Документ_АвансовыйОтчетИзСтруктуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_АвансовыйОтчетИзСтруктуры_Отправка", 
										"Товары", 
										"НомерГТД",
										Истина,
										"Справочник_НомераГТД_Отправка");
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_АвансовыйОтчетИзСтруктуры_Отправка", 
										"Товары", 
										"СтавкаНДС",
										Истина,
										"СправочникСсылка_СтавкиНДС_Отправка"); 
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_АвансовыйОтчетИзСтруктуры_Отправка", 
										"ПрочиеРасходы", 
										"СтавкаНДС",
										Истина,
										"СправочникСсылка_СтавкиНДС_Отправка");								
	КонецЕсли;
	ВыгрузитьПодразделение(ДанныеИБ, ДанныеXDTO);
	ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина, Ложь, "НалогообложениеНДСПродавца");
	
	Запрос = Новый Запрос;
	
	// Данные шапки документа необходимы для вычисления курса и кратности.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.КурсЧислитель, 1) КАК КурсВзаиморасчетов,
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.КурсЗнаменатель, 1) КАК КратностьВзаиморасчетов
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Валюта КАК Валюта) КАК ВалютаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтносительныеКурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта И БазоваяВалюта = &БазоваяВалюта) КАК КурсыВалютСрезПоследних
	|		ПО (КурсыВалютСрезПоследних.Валюта = ВалютаДокумента.Валюта)";
	
	Запрос.УстановитьПараметр("Дата", ДанныеИБ.Дата);
	Запрос.УстановитьПараметр("Валюта", ДанныеИБ.Валюта);
	Запрос.УстановитьПараметр("БазоваяВалюта", ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ДанныеИБ.Организация));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеXDTO.Вставить("КурсДокумента", Выборка.КурсВзаиморасчетов);
		ДанныеXDTO.Вставить("КратностьДокумента", Выборка.КратностьВзаиморасчетов);
	КонецЕсли;
	
	Если ДанныеИБ.Свойство("Склад") Тогда
		СкладДляВыгрузки = СкладДляВыгрузки(ДанныеИБ.Склад, КомпонентыОбмена.ПараметрыКонвертации);
		ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
	КонецЕсли;
	
	Для каждого СтрокаПрочее Из ДанныеИБ.ПрочиеРасходы Цикл
	
		//++ НЕ УТ	
		СчетЗатрат = СчетУчетаПоСтатье(СтрокаПрочее.СтатьяРасходов, ДанныеИБ.Организация, СтрокаПрочее.Подразделение);
		//-- НЕ УТ
		
		Если ТипЗнч(СтрокаПрочее.СтатьяРасходов) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
			СтрокаПрочее.СтатьяЗатрат = СтрокаПрочее.СтатьяРасходов;
			Если ЭтоУТ() 
				И ЗначениеЗаполнено(СтрокаПрочее.СтатьяДвиженияДенежныхСредств) Тогда
				СчетЗатратДДС = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПрочее.СтатьяДвиженияДенежныхСредств, 
				"КорреспондирующийСчет"));
				Если ЗначениеЗаполнено(СчетЗатратДДС) Тогда
					СчетЗатрат = СчетЗатратДДС;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		СтрокаПрочее.СчетЗатрат = СчетЗатрат; 
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвансовыйОтчетПрочиеРасходы.ЭлектронныйБилет КАК ДанныеНоменклатуры,
		|	АвансовыйОтчетПрочиеРасходы.СуммаИтог КАК СуммаИтог,
		|	АвансовыйОтчетПрочиеРасходы.Сумма КАК Сумма,
		|	АвансовыйОтчетПрочиеРасходы.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	АвансовыйОтчетПрочиеРасходы.СуммаНДС КАК СуммаНДС,
		|	Бронирование.ДатаОтправления КАК ДатаНачалаКомандировки,
		|	Бронирование.ДатаПрибытия КАК ДатаОкончанияКомандировки
		|ИЗ
		|	Документ.АвансовыйОтчет.ПрочиеРасходы КАК АвансовыйОтчетПрочиеРасходы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Бронирование КАК Бронирование
		|		ПО АвансовыйОтчетПрочиеРасходы.ЭлектронныйБилет = Бронирование.Ссылка
		|ГДЕ
		|	АвансовыйОтчетПрочиеРасходы.Ссылка = &Ссылка
		|	И НЕ АвансовыйОтчетПрочиеРасходы.ЭлектронныйБилет = ЗНАЧЕНИЕ(Документ.Бронирование.ПустаяСсылка)";
	
	Если ДанныеИБ.Свойство("Ссылка") Тогда
	     Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	     ЭлектронныеБилеты = Запрос.Выполнить().Выгрузить();
	   	КонецЕсли;
	
	Товары             = ДанныеИБ.Товары;
	ПрочиеРасходы      = ДанныеИБ.ПрочиеРасходы;
	ОплатаКонтрагентам = ДанныеИБ.ОплатаКонтрагентам;
	ВыданныеАвансы     = ДанныеИБ.ВыданныеАвансы;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда   
		ПереопределитьСтавкуНДСДляСтарыхФорматов(Товары, Ложь);
		ПереопределитьСтавкуНДСДляСтарыхФорматов(ПрочиеРасходы, Ложь);
	КонецЕсли;
	ДанныеXDTO.Вставить("Товары",				Товары);
	ДанныеXDTO.Вставить("ПрочиеРасходы",		ПрочиеРасходы);
	ДанныеXDTO.Вставить("ОплатаКонтрагентам",	ОплатаКонтрагентам);
	ДанныеXDTO.Вставить("ВыданныеАвансы",		ВыданныеАвансы);
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17")
		И ЭлектронныеБилеты <> Неопределено И ЭлектронныеБилеты.Количество() > 0 Тогда 
		//ДанныеXDTO.Вставить("ПроездныеДокументы",	ЭлектронныеБилеты);
		ДанныеXDTO.Вставить("ДатаНачалаКомандировки", ЭлектронныеБилеты[0].ДатаНачалаКомандировки);
		ДанныеXDTO.Вставить("ДатаОкончанияКомандировки", ЭлектронныеБилеты[0].ДатаОкончанияКомандировки);
	КонецЕсли;
	//++ Локализация
	#Область АкцизныеМарки
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7")
		И ДанныеИБ.Свойство("АкцизныеМарки") Тогда
		ДанныеXDTO.Вставить("АкцизныеМарки", ДанныеИБ.АкцизныеМарки);
	КонецЕсли;
	
	#КонецОбласти
	
	#Область МаркировкиУпаковок
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7")
		И ДанныеИБ.Свойство("МаркировкиУпаковок") Тогда	
		ДанныеXDTO.Вставить("МаркировкиУпаковок", ДанныеИБ.МаркировкиУпаковок);
	КонецЕсли;
	
	#КонецОбласти
	//-- Локализация
	
	ДанныеXDTO.Вставить("СуммаВключаетНДС", Истина);
	ДанныеXDTO.Вставить("Сумма", Товары.Итог("Сумма") + ПрочиеРасходы.Итог("Сумма") + ОплатаКонтрагентам.Итог("Сумма"));
	
	Если ДанныеИБ.Свойство("Ссылка")
		И Не ДанныеИБ.Свойство("ВыгружатьУдалениеПоСсылке") Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("Ссылка", ДанныеИБ.Ссылка);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПКО_Документ_АктВыполненныхРаботРТУ_Отправка(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
