Процедура ПКО_СправочникСсылка_СтавкиНДС_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	НеОблагается = Ложь;
	//++ Локализация
	Если ДанныеИБ.ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
	    НеОблагается = Истина;
	КонецЕсли;
	//-- Локализация
	ДанныеXDTO.КлючевыеСвойства.Вставить("НеОблагается", НеОблагается);  
	ДанныеXDTO.Вставить("Страна", ?(ЗначениеЗаполнено(ДанныеИБ.Страна), ДанныеИБ.Страна, ЗначениеНастроекКлиентСерверПовтИсп.ОсновнаяСтрана()));
	ВидСтавки = "Общая";
	//++ Локализация
	Если ДанныеИБ.ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		ВидСтавки = "БезНДС"; 
		//++ НЕ УТ
	    ВидСтавки =  Перечисления.ВидыСтавокНДС.БезНДС; 
		//-- НЕ УТ 
	ИначеЕсли ДанныеИБ.ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда 
		ВидСтавки = "Нулевая";
		//++ НЕ УТ
		ВидСтавки = Перечисления.ВидыСтавокНДС.Нулевая;
		ДанныеXDTO.КлючевыеСвойства.Вставить("Ставка", "0"); 
		//-- НЕ УТ
	Иначе 
		ВидСтавки = "Общая";
		//++ НЕ УТ    
		ВидСтавки = Перечисления.ВидыСтавокНДС.Общая; 
		//-- НЕ УТ 
	КонецЕсли;
	//-- Локализация
	
	//++ Локализация
		
	//++ НЕ УТ 
	ИструкцияВидСтавки = Новый Структура;
	ИструкцияВидСтавки.Вставить("ИмяПКО",   "Перечисление_ВидыСтавокНДС");
	ИструкцияВидСтавки.Вставить("Значение", ВидСтавки);
	ВидСтавки = ИструкцияВидСтавки;
	//-- НЕ УТ
	
	//-- Локализация
	ДанныеXDTO.КлючевыеСвойства.Вставить("ВидСтавки", ВидСтавки);
	ДанныеXDTO.КлючевыеСвойства.Вставить("РасчетнаяСтавка", ДанныеИБ.РасчетнаяСтавка);
КонецПроцедуры


