	Если НЕ ТипЗнч(ДанныеИБ) = Тип("Структура") И (ДанныеИБ.ТипДоговора = ПредопределенноеЗначение("Перечисление.ТипыДоговоров.ПередачаВАренду") 
		ИЛИ  ДанныеИБ.ТипДоговора = ПредопределенноеЗначение("Перечисление.ТипыДоговоров.Субаренда")) Тогда 
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
