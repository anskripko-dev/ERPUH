Процедура ДобавитьПОД_Справочник_КадроваяИсторияСотрудников_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_КадроваяИсторияСотрудников_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.КадроваяИсторияСотрудников"; //@NON-NLS-1
	ПравилоОбработки.ПриОбработке            = "ПОД_Справочник_КадроваяИсторияСотрудников_Получение_ПриОбработке";
КонецПроцедуры
Процедура ПОД_Справочник_КадроваяИсторияСотрудников_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	Период = ДанныеXDTO.КлючевыеСвойства.Дата;
	МассивСтрок = Новый Массив; 
	
	Если ДанныеXDTO.Свойство("Записи")
		И ЗначениеЗаполнено(ДанныеXDTO.Записи) Тогда
		ПКООрганизация    = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Организации_Получение");
		ПКОСотрудник     = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Сотрудники_Получение");
		ПКОФизическоеЛицо = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ФизическиеЛица_Получение"); 
		ПКОДолжность = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Должности_Получение"); 
		ПКОШтатноеРасписание = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,"Справочник_ШтатноеРасписание_Получение");
		ПКОПодразделениеОрганизации = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ПодразделенияОрганизаций_Получение");
		Для каждого Строка Из ДанныеXDTO.Записи Цикл 
			СтруктураДанныхСтроки = Новый Структура;
			ВидыСобытий = Метаданные.Перечисления.ВидыКадровыхСобытий.ЗначенияПеречисления; 
			ВидСобытия = ВидыСобытий.Найти(Строка.ВидСобытия);   
			Если Не ВидСобытия = Неопределено Тогда
			    ВидСобытияПеречисление = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВидыКадровыхСобытий." + Строка.ВидСобытия); 
			Иначе ВидСобытияПеречисление = Неопределено;
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("ВидСобытия", ВидСобытияПеречисление); 
			ВидыДоговоров =  Метаданные.Перечисления.ВидыДоговоровССотрудниками.ЗначенияПеречисления; 
			ВидДоговора = ВидыДоговоров.Найти(Строка.ВидДоговора);
			Если Не ВидДоговора = Неопределено Тогда
			    ВидДоговораПеречисление = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВидыДоговоровССотрудниками." + Строка.ВидДоговора); 
			Иначе ВидДоговораПеречисление = Неопределено;
			КонецЕсли;
	    	СтруктураДанныхСтроки.Вставить("ВидДоговора", ВидДоговораПеречисление); 
			СтруктураДанныхСтроки.Вставить("Период", Строка.ДатаСобытия);
			СтруктураДанныхСтроки.Вставить("ДатаСобытия", Строка.ДатаСобытия);
			СтруктураДанныхСтроки.Вставить("КоличествоСтавок", Строка.КоличествоСтавок);
			
			ГоловнаяОрганизация = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.ГоловнаяОрганизация, 
			ПКООрганизация, 
			"ПолучитьСсылку"); 
			СтруктураДанныхСтроки.Вставить("ГоловнаяОрганизация", ГоловнаяОрганизация.Ссылка);
			
			Организация = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.Организация, 
			ПКООрганизация, 
			"ПолучитьСсылку"); 
	      	СтруктураДанныхСтроки.Вставить("Организация", Организация.Ссылка);
			
			ФизическоеЛицо = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.ФизическоеЛицо, 
			ПКОФизическоеЛицо, 
			"ПолучитьСсылку");
			СтруктураДанныхСтроки.Вставить("ФизическоеЛицо", ФизическоеЛицо.Ссылка);	
			
			Сотрудник = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.Сотрудник, 
			ПКОСотрудник, 
			"ПолучитьСсылку");
			СтруктураДанныхСтроки.Вставить("Сотрудник", Сотрудник.Ссылка); 
			
			ГоловнойСотрудник = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.ГоловнойСотрудник, 
			ПКОСотрудник, 
			"ПолучитьСсылку");
			СтруктураДанныхСтроки.Вставить("ГоловнойСотрудник", ГоловнойСотрудник.Ссылка); 
			
			ЭтоГоловнойСотрудник = Сотрудник.Ссылка = ГоловнойСотрудник.Ссылка;
			СтруктураДанныхСтроки.Вставить("ЭтоГоловнойСотрудник", ЭтоГоловнойСотрудник);
			
			Должность = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.Должность, 
			ПКОДолжность, 
			"ПолучитьСсылку");
			СтруктураДанныхСтроки.Вставить("Должность", Должность.Ссылка); 
	
			ДолжностьПоШтатномуРасписанию = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.ДолжностьПоШтатномуРасписанию, 
			ПКОШтатноеРасписание, 
			"ПолучитьСсылку");
			СтруктураДанныхСтроки.Вставить("ДолжностьПоШтатномуРасписанию", ДолжностьПоШтатномуРасписанию.Ссылка); 
			
			Подразделение = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена, 
			Строка.ПодразделениеОрганизации, 
			ПКОПодразделениеОрганизации, 
			"ПолучитьСсылку");
			СтруктураДанныхСтроки.Вставить("Подразделение", Подразделение.Ссылка);
			//КадроваяИсторияСотрудниковИнтервальный
			СтруктураДанныхСтроки.Вставить("ДатаНачала", Строка.ДатаСобытия);  
			СтруктураДанныхСтроки.Вставить("ДействуетДо", Строка.ДействуетДо);
			СтруктураДанныхСтроки.Вставить("ПериодЗаписи", Строка.ДатаСобытия);
			СтруктураДанныхСтроки.Вставить("Год", Строка.ДатаСобытия);
			МассивСтрок.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
			
	КонецЕсли;   
	СсылкаНаДокумент = ДанныеXDTO.КлючевыеСвойства.Ссылка; 
	СтрукутраРеквизитов = Новый Структура;
	СтрукутраРеквизитов.Вставить("Период", Период);
	СтрукутраРеквизитов.Вставить("ГоловнаяОрганизация", ГоловнаяОрганизация);
	СтрукутраРеквизитов.Вставить("СсылкаНаДокумент", СсылкаНаДокумент); 
	СтрукутраРеквизитов.Вставить("УзелКорреспондента", КомпонентыОбмена.УзелКорреспондента);
	ИмяРегистраКадровыхДанных = "КадроваяИсторияСотрудников";
	ЗаписатьДвиженияКадровогоУчета(МассивСтрок, СтрукутраРеквизитов, ИмяРегистраКадровыхДанных);
КонецПроцедуры

