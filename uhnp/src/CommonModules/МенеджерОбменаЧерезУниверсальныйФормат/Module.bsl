Процедура ДобавитьПОД_Документ_ЗаявкаНаПереводДСВБюджет_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_ЗаявкаНаПереводДСВБюджет_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Документ.ЗаявкаНаПереводДСВБюджет"; //@NON-NLS-1
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_ЗаявкаНаПереводДСВБюджет_Получение_ПриОбработке";
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ЗаявкаНаПереводДСВБюджет_Получение");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ЗаявкаНаПереводДСВБюджетВСБДС_Получение");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ЗаявкаНаПереводДСВБюджетСПревыш_Получение");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ЗаявкаНаПереводДСВБюджСБДСПревы_Получение");
КонецПроцедуры
Процедура ПОД_Документ_ЗаявкаНаПереводДСВБюджет_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ИспользоватьЗаявкиНаРасходованиеДС = ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаРасходованиеДенежныхСредств");
		
	Если ДанныеXDTO.Свойство("УтвержденнаяДатаПлатежа") Тогда
		УтвержденнаяДатаПлатежа = ДанныеXDTO.УтвержденнаяДатаПлатежа;
	Иначе	
		УтвержденнаяДатаПлатежа = Дата(1,1,1) ;
	КонецЕсли;
	
	Если ИспользоватьЗаявкиНаРасходованиеДС И УтвержденнаяДатаПлатежа < Дата(2023,2,1) Тогда 
		ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджет_Получение = Истина;
	Иначе	
		ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджет_Получение = Ложь; 
	КонецЕсли;
	
	Если НЕ ИспользоватьЗаявкиНаРасходованиеДС И УтвержденнаяДатаПлатежа < Дата(2023,2,1) Тогда
		ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджетВСБДС_Получение = Истина;
	Иначе	
		ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджетВСБДС_Получение = Ложь; 
	КонецЕсли;	
	
	ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджетСПревыш_Получение = Ложь;
	ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджСБДСПревы_Получение = Ложь;
		 
	Если ИспользоватьЗаявкиНаРасходованиеДС Тогда 
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда  
			Если ДанныеXDTO.AdditionalInfo.Свойство("РасшифровкаНДФЛ") Тогда
				РасшифровкаНДФЛ = ДанныеXDTO.AdditionalInfo.РасшифровкаНДФЛ;
				ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджет_Получение  = РасшифровкаНДФЛ.Свойство("НДФЛ")  
				И РасшифровкаНДФЛ.НДФЛ > 0 И УтвержденнаяДатаПлатежа < Дата(2023,2,1);
				ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджетСПревыш_Получение = РасшифровкаНДФЛ.Свойство("НДФЛСПревышения") 
				И РасшифровкаНДФЛ.НДФЛСПревышения > 0 И УтвержденнаяДатаПлатежа < Дата(2023,2,1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не ИспользоватьЗаявкиНаРасходованиеДС Тогда   
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда 
			Если ДанныеXDTO.AdditionalInfo.Свойство("РасшифровкаНДФЛ") Тогда  
				РасшифровкаНДФЛ = ДанныеXDTO.AdditionalInfo.РасшифровкаНДФЛ;
				ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджетВСБДС_Получение  = РасшифровкаНДФЛ.Свойство("НДФЛ")
				И РасшифровкаНДФЛ.НДФЛ > 0 И УтвержденнаяДатаПлатежа < Дата(2023,2,1);
				ИспользованиеПКО.Документ_ЗаявкаНаПереводДСВБюджСБДСПревы_Получение = РасшифровкаНДФЛ.Свойство("НДФЛСПревышения")
				И РасшифровкаНДФЛ.НДФЛСПревышения > 0 И УтвержденнаяДатаПлатежа < Дата(2023,2,1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПОД_Документ_ЗаявкаНаРасходДСВыплатаЗарплаты_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_ЗаявкаНаРасходДСВыплатаЗарплаты_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Документ.ЗаявкаНаРасходДСВыплатаЗарплаты"; //@NON-NLS-1
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_ЗаявкаНаРасходДСВыплатаЗарплаты_Получение_ПриОбработке";
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ЗаявкаВыплатаЗарплатыВРКО_Получение");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ЗаявкаНаРасходДСВыплатаЗарплаты_Получение");
КонецПроцедуры
Процедура ПОД_Документ_ЗаявкаНаРасходДСВыплатаЗарплаты_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ИспользоватьЗаявкиНаРасходованиеДС = ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаРасходованиеДенежныхСредств");
	
	ОчиститьИспользованиеПКО(ИспользованиеПКО);
	ИспользованиеПКО.Вставить("Документ_ЗаявкаНаРасходДСВыплатаЗарплаты_Получение", Ложь);
	
	Если ИспользоватьЗаявкиНаРасходованиеДС Тогда
		ИспользованиеПКО.Вставить("Документ_ЗаявкаНаРасходДСВыплатаЗарплаты_Получение", Истина);
	
	ИначеЕсли ДанныеXDTO.Свойство("УтвержденнаяФормаОплаты") И ЗначениеЗаполнено(ДанныеXDTO.УтвержденнаяФормаОплаты) Тогда	
		
		Если ДанныеXDTO.УтвержденнаяФормаОплаты.Значение = "Наличная" Тогда
			
			ИспользованиеПКО.Вставить("Документ_ЗаявкаВыплатаЗарплатыВРКО_Получение", Истина);
		
		ИначеЕсли ДанныеXDTO.УтвержденнаяФормаОплаты.Значение = "Безналичная" Тогда
			
			ДанныеДокумента = Новый Структура;
			ДанныеДокумента.Вставить("Подразделение");
			ДанныеДокумента.Вставить("Организация");
			ДанныеДокумента.Вставить("Валюта");
			ДанныеДокумента.Вставить("Контрагент");
			ДанныеДокумента.Вставить("Дата");
			
			ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДанныеXDTO); 
			Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
				ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДанныеXDTO.КлючевыеСвойства);
			КонецЕсли;
			
			ДанныеДокумента.Вставить("Проведен",               Ложь);
			ДанныеДокумента.Вставить("ТипПлатежногоДокумента", Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение);
												
			Если ДанныеXDTO.Свойство("Контрагент") И ЗначениеЗаполнено(ДанныеXDTO.Контрагент)
				И ДанныеXDTO.Свойство("БанковскийСчет") И ЗначениеЗаполнено(ДанныеXDTO.БанковскийСчет) Тогда
		     
				ДанныеДокумента.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту);
				ДанныеДокумента.Вставить("СтатьяДвиженияДенежныхСредств", 
							Справочники.СтатьиДвиженияДенежныхСредств.СтатьяДвиженияДенежныхСредствПоХозяйственнойОперации(ДанныеДокумента.ХозяйственнаяОперация));
				ДанныеДокумента.Вставить("СуммаДокумента", ДанныеXDTO.Сумма);
				Если ДанныеXDTO.Свойство("БанковскийСчет") Тогда
					ДанныеДокумента.Вставить("БанковскийСчетКонтрагента", ДанныеXDTO.БанковскийСчет);
				КонецЕсли;
				
				Если ДанныеXDTO.РасшифровкаПлатежа.Количество() > 0 Тогда
					ДанныеДокумента.Вставить("ДатаВедомостиНаВыплатуЗарплаты");
					ДанныеДокумента.Вставить("НомерВедомостиНаВыплатуЗарплаты");
					ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДанныеXDTO.РасшифровкаПлатежа[0],
						"ДатаВедомостиНаВыплатуЗарплаты, НомерВедомостиНаВыплатуЗарплаты");
					ДанныеДокумента.ДатаВедомостиНаВыплатуЗарплаты = НачалоДня(ДанныеДокумента.ДатаВедомостиНаВыплатуЗарплаты);
				КонецЕсли;
						
				ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
					КомпонентыОбмена,
					ДанныеДокумента,
					ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Документ_СБДСИзСтруктуры_Получение"), 
					"КонвертироватьИЗаписать");
			Иначе
			
				КоличествоДокументов = ДанныеXDTO.РасшифровкаПлатежа.Количество();
				Если КоличествоДокументов > 0 Тогда
					
					Для Счетчик = 0 По КоличествоДокументов - 1 Цикл
						
						СтрокаРасшифровки = ДанныеXDTO.РасшифровкаПлатежа[Счетчик];
						
						ДанныеДокумента.Вставить("ХозяйственнаяОперация",  Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета);
						ДанныеДокумента.Вставить("СтатьяДвиженияДенежныхСредств", 
							Справочники.СтатьиДвиженияДенежныхСредств.СтатьяДвиженияДенежныхСредствПоХозяйственнойОперации(ДанныеДокумента.ХозяйственнаяОперация));
			
						ДанныеДокумента.Вставить("ПодотчетноеЛицо",                 СтрокаРасшифровки.Сотрудник);
						ДанныеДокумента.Вставить("НомерВедомостиНаВыплатуЗарплаты", СтрокаРасшифровки.НомерВедомостиНаВыплатуЗарплаты);
						ДанныеДокумента.Вставить("ДатаВходящегоДокумента",          НачалоДня(СтрокаРасшифровки.ДатаВедомостиНаВыплатуЗарплаты));
						ДанныеДокумента.Вставить("ДатаВедомостиНаВыплатуЗарплаты",  НачалоДня(СтрокаРасшифровки.ДатаВедомостиНаВыплатуЗарплаты));
						ДанныеДокумента.Вставить("БанковскийСчетКонтрагента",       СтрокаРасшифровки.БанковскийСчет);
						ДанныеДокумента.Вставить("СуммаДокумента",                 	СтрокаРасшифровки.Сумма);
						
					 	ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
							КомпонентыОбмена,
							ДанныеДокумента,
							ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Документ_СБДСИзСтруктуры_Получение"), 
							"КонвертироватьИЗаписать");
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

