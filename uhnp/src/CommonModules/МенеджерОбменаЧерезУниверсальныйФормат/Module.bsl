	ПравилоОбработки.Имя                     = "Документ_ПоступлениеДенежныхДокументов_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.ПоступлениеДенежныхДокументов;
