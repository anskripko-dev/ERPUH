Процедура ПроверитьНеобходимостьВыгрузкиПатента(ДанныеXDTO, Организация, Подразделение, НалогообложениеНДС, КомпонентыОбмена, Документ)
	ФорматПоддерживаетВыгрузкуПатентов = (СравнитьВерсии(КомпонентыОбмена.ВерсияФорматаОбмена, "1.11") >= 0); 
	Если Не ФорматПоддерживаетВыгрузкуПатентов Тогда
	     Возврат
	КонецЕсли;
	Если НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаПоПатенту") Тогда
		Патент = ПатентДляВыгрузки(Организация, Подразделение);
		Если Не ЗначениеЗаполнено(Патент) Тогда
		     Возврат
		КонецЕсли;
		Результат = Ложь;
		ПроверкаЗаполненияОбязательныхРеквититовПатентов(Патент.Ссылка, Результат, КомпонентыОбмена, Документ, Организация, Подразделение);
		Если Результат И ОбщегоНазначения.СсылкаСуществует(Патент) Тогда
			ИнструкцияПатент = Новый Структура();
			ИнструкцияПатент.Вставить("ИмяПКО", "СправочникСсылка_Патенты_Отправка");
			ИнструкцияПатент.Вставить("Значение", Патент);
			ДанныеXDTO.Вставить("Патент", ИнструкцияПатент);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
