Процедура ПОД_Документ_ЧекККМ_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		
		СуммаОплатыНаличными = 0;
		Если ДанныеXDTO.Свойство("ОплатыККМ") Тогда
			Для каждого Строка Из ДанныеXDTO.ОплатыККМ Цикл
				Если Строка.ТипОплаты <> Неопределено И Строка.ТипОплаты.Значение = "Наличные" Тогда
					СуммаОплатыНаличными = СуммаОплатыНаличными + Строка.Сумма;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ДокументПоЗаказуКлиента 		= ДанныеXDTO.Свойство("ЗаказКлиента") И ЗначениеЗаполнено(ДанныеXDTO.ЗаказКлиента);
		ДокументВозврата				= ДанныеXDTO.Свойство("ТоварыВозвратПродажи") И ЗначениеЗаполнено(ДанныеXDTO.ТоварыВозвратПродажи);
		ДокументПродажи					= ДанныеXDTO.Свойство("ТоварыПродажа") И ЗначениеЗаполнено(ДанныеXDTO.ТоварыПродажа)
											Или ДанныеXDTO.Свойство("Услуги") И ЗначениеЗаполнено(ДанныеXDTO.Услуги);
		ДокументКорректировки 			= ДанныеXDTO.Свойство("Корректировочный") И ДанныеXDTO.Корректировочный;
		ДокументОплатыПлатежнымиКартами = ДанныеXDTO.Свойство("ОплатаПлатежнымиКартами") И ЗначениеЗаполнено(ДанныеXDTO.ОплатаПлатежнымиКартами);
		ДокументОплатыНаличными 		= (СуммаОплатыНаличными > 0);
		
		ИспользованиеПКО.Документ_ЧекККМ_Получение = 								НЕ ДокументПоЗаказуКлиента
																					И ДокументПродажи
																					И НЕ ДокументКорректировки;
													 
		ИспользованиеПКО.Документ_ЧекККМВозврат_Получение = 						НЕ ДокументПоЗаказуКлиента
																					И ДокументВозврата
																					И НЕ ДокументКорректировки;
													
		ИспользованиеПКО.Документ_ЧекККМКоррекции_Получение = 						НЕ ДокументПоЗаказуКлиента
																					И НЕ ДокументВозврата
																					И ДокументКорректировки;
													
		ИспользованиеПКО.Документ_РеализацияТоваровУслуг_ЧекККМ_Получение =			ДокументПоЗаказуКлиента
																					И ДокументПродажи
																					И НЕ ДокументКорректировки;
													
		ИспользованиеПКО.Документ_ВозвратТоваровОтКлиента_ЧекККМ_Получение = 		ДокументПоЗаказуКлиента
																					И ДокументВозврата;
													
		ИспользованиеПКО.Документ_КорректировкаРеализации_ЧекККМ_Получение =		ДокументПоЗаказуКлиента
																					И ДокументКорректировки;
													
		ИспользованиеПКО.Документ_ПриходныйКассовыйОрдер_ЧекККМ_Получение = 		ДокументПоЗаказуКлиента
																					И ДокументОплатыНаличными
																					И ДокументПродажи
																					И НЕ ДокументКорректировки;
		
		ИспользованиеПКО.Документ_ОперацияПоПлатежнойКарте_ЧекККМ_Получение = 		ДокументПоЗаказуКлиента
																					И ДокументОплатыПлатежнымиКартами
																					И НЕ ДокументКорректировки;
		
		ИспользованиеПКО.Документ_РасходныйКассовыйОрдер_ЧекККМ_Получение =			ДокументПоЗаказуКлиента
																					И ДокументОплатыНаличными
																					И ДокументВозврата
																					И НЕ ДокументКорректировки;
																					
	Иначе
	
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
		
	КонецЕсли;
КонецПроцедуры

