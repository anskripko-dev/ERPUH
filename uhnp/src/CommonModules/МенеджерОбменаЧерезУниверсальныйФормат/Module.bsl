Процедура ДобавитьПОД_Документ_ВыпускПродукции_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_ВыпускПродукции_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Документ.ВыпускПродукции"; //@NON-NLS-1
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_ВыпускПродукции_Получение_ПриОбработке";
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВыпускПродукции_ПередачаМатВПр_Получение");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВыпускПродукции_Получение");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ДвижениеПродИМат_ВыпускПрод_Получение");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ПроизводствоБезЗаказа_Получение");
КонецПроцедуры
Процедура ПОД_Документ_ВыпускПродукции_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ОчиститьИспользованиеПКО(ИспользованиеПКО);
	ИспользованиеПКО.Вставить("Документ_ПроизводствоБезЗаказа_Получение", Истина);
	ИспользованиеПКО.Вставить("Документ_ДвижениеПродИМат_ВыпускПрод_Получение", Истина);
	//++ Локализация
	ИспользованиеПКО.Вставить("Документ_ВыпускПродукции_Получение", Истина);
	ИспользованиеПКО.Вставить("Документ_ВыпускПродукции_ПередачаМатВПр_Получение", Истина);
	//-- Локализация
	
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
	
	//++ Локализация
	
	// В первую очередь анализируем наличие ссылок на существующие объекты.
	Если НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ВыпускПродукции") = Неопределено Тогда
		ИспользованиеПКО.Документ_ВыпускПродукции_Получение = Истина;
		Если НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПередачаМатериаловВПроизводство") = Неопределено
			ИЛИ ДанныеXDTO.Свойство("Материалы") И ЗначениеЗаполнено(ДанныеXDTO.Материалы) Тогда
			ИспользованиеПКО.Документ_ВыпускПродукции_ПередачаМатВПр_Получение = Истина;
		КонецЕсли;
	КонецЕсли;
	//-- Локализация
	Если НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПроизводствоБезЗаказа") = Неопределено Тогда
		ИспользованиеПКО.Документ_ПроизводствоБезЗаказа_Получение = Истина;
	ИначеЕсли НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ДвижениеПродукцииИМатериалов") = Неопределено Тогда
		ИспользованиеПКО.Документ_ДвижениеПродИМат_ВыпускПрод_Получение = Истина;
	Иначе
		ИспользоватьУправлениеПроизводством2_2 = ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2");
		
		Если ИспользоватьУправлениеПроизводством2_2 Тогда
			// Определим используемое ПКО в зависимотси от состава файла обмена
			// и реквизитов подразделения.
			Если НЕ ДанныеXDTO.Свойство("Материалы")
				И НЕ ДанныеXDTO.Свойство("ВозвратныеОтходы")
				И ДанныеXDTO.Свойство("Подразделение") И ЗначениеЗаполнено(ДанныеXDTO.Подразделение) Тогда
	 
				Подразделение = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
					КомпонентыОбмена,
					ДанныеXDTO.Подразделение,
					ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Подразделения_Получение"), 
					"ПолучитьСсылку");
				
				Если ТипЗнч(Подразделение) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
					// Подразделение существовало на момент загрузки, проверим его реквизиты.
					РеквизитыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подразделение, "ПроизводствоПоЗаказам, ПроизводствоБезЗаказов");
					Если РеквизитыПодразделения.ПроизводствоПоЗаказам И НЕ РеквизитыПодразделения.ПроизводствоБезЗаказов Тогда
						ИспользованиеПКО.Документ_ДвижениеПродИМат_ВыпускПрод_Получение = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			// Во всех остальных случаях загружаем в "ПроизводствоБезЗаказа".
			Если НЕ ИспользованиеПКО.Документ_ДвижениеПродИМат_ВыпускПрод_Получение Тогда
				ИспользованиеПКО.Документ_ПроизводствоБезЗаказа_Получение = Истина;
			КонецЕсли;
	//++ Локализация		 
		Иначе
			ИспользованиеПКО.Документ_ВыпускПродукции_Получение = Истина;
			Если ДанныеXDTO.Свойство("Материалы") И ЗначениеЗаполнено(ДанныеXDTO.Материалы) Тогда
				ИспользованиеПКО.Документ_ВыпускПродукции_ПередачаМатВПр_Получение = Истина;
			КонецЕсли;
	//-- Локализация
		КонецЕсли;
			
	КонецЕсли;
КонецПроцедуры

