Функция ВедомостьНаВыплатуЗаработнойПлаты(КомпонентыОбмена, ВидВедомости, ПараметрыВедомости, ВыплатаЗаработнойПлаты = Неопределено)
	ВедомостьСсылка = Неопределено;
		
	Источник = "Документ." + ВидВедомости;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ведомость.Ссылка КАК Ссылка
	|ИЗ
	|	&Источник КАК Ведомость
	|ГДЕ
	|	Ведомость.Номер = &Номер
	|	И Ведомость.Дата = &Дата
	|	И Ведомость.Организация = &Организация");
	Запрос.УстановитьПараметр("Номер",       ПараметрыВедомости.Номер); 
	Запрос.УстановитьПараметр("Дата",        ПараметрыВедомости.Дата);
	Запрос.УстановитьПараметр("Организация", ПараметрыВедомости.Организация);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Источник", Источник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВедомостьСсылка = Выборка.Ссылка;
	Иначе
		Ведомость = Документы[ВидВедомости].СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(Ведомость, ПараметрыВедомости);
		
		Ведомость.ПроцентВыплаты    = 100;
		Ведомость.Округление        = Справочники.СпособыОкругленияПриРасчетеЗарплаты.ПоУмолчанию();
		Ведомость.СпособВыплаты     = Справочники.СпособыВыплатыЗарплаты.Зарплата;
		Ведомость.ПериодРегистрации = НачалоМесяца(Ведомость.Дата);
		
		Если Не ВыплатаЗаработнойПлаты = Неопределено Тогда
			Запрос = Новый Запрос( 
			"ВЫБРАТЬ
			|	Сотрудники.Ссылка КАК Сотрудник,
			|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
			|ИЗ
			|	Справочник.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.ГоловнаяОрганизация = &Организация
			|	И НЕ Сотрудники.ВАрхиве");
			Запрос.УстановитьПараметр("Организация", ПараметрыВедомости.Организация);
			
			СотрудникиОрганизаций = Запрос.Выполнить().Выгрузить();
			СотрудникиОрганизаций.Индексы.Добавить("ФизическоеЛицо");
			
			Для Каждого Строка Из ВыплатаЗаработнойПлаты Цикл
				
				ТЧФизическиеЛица = Ведомость.ФизическиеЛица; // ТабличнаяЧасть
				СтрокаФизическиеЛица = ТЧФизическиеЛица.Добавить();
				СтрокаФизическиеЛица.ФизическоеЛицо = Строка.ФизическоеЛицо;
				
				ТЧЗарплата = Ведомость.Зарплата; // ТабличнаяЧасть
				СтрокаЗарплата = ТЧЗарплата.Добавить();
				СтрокаЗарплата.ФизическоеЛицо = Строка.ФизическоеЛицо;
				СтрокаЗарплата.КВыплате = Строка.Сумма;
				
				Сотрудник = СотрудникиОрганизаций.Найти(Строка.ФизическоеЛицо, "ФизическоеЛицо");
				Если Не Сотрудник = Неопределено Тогда
					СтрокаЗарплата.Сотрудник = Сотрудник.Сотрудник;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		Ведомость.ОбменДанными.Загрузка = Истина;
		Ведомость.Записать();
		
		СтрокаТаблицы = КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Добавить();
		СтрокаТаблицы.ДокументСсылка = Ведомость.Ссылка;
		СтрокаТаблицы.ДатаДокумента  = Ведомость.Дата;
		
		ВедомостьСсылка = Ведомость.Ссылка;
		
	КонецЕсли;
	
	Возврат ВедомостьСсылка;
КонецФункции
Процедура ВедомостьНаВыплатуЗарплаты_ВыгрузитьТЧ(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена)
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	СУММА(Зарплата.КВыплате) КАК Сумма,
		|	Зарплата.ФизическоеЛицо КАК ФизическоеЛицо,
		|	&НомерЛицевогоСчета КАК НомерЛицевогоСчета,
		|	Зарплата.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
		|	Зарплата.СтатьяФинансирования.Наименование КАК НаименованиеСтатьиФинансирования,
		|	Зарплата.КомпенсацияЗаЗадержкуЗарплаты КАК КомпенсацияЗаЗадержкуЗарплаты,
		|	&БанковскийСчет КАК СчетОрганизации
		|ИЗ
		|	&ИсточникЗарплата КАК Зарплата
		|ГДЕ
		|	Зарплата.Ссылка = &Ссылка
		|	И НЕ Зарплата.КВыплате = 0
		|
		|СГРУППИРОВАТЬ ПО
		|	Зарплата.ФизическоеЛицо,
		|	Зарплата.ПериодВзаиморасчетов,
		|	Зарплата.СтатьяФинансирования.Наименование,
		|	&НомерЛицевогоСчета,
		|	Зарплата.КомпенсацияЗаЗадержкуЗарплаты, 
		|	&БанковскийСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(НДФЛ.Сумма) КАК Сумма,
		|	НДФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	НДФЛ.КодДохода.Код КАК КодДохода,
		|	НДФЛ.МесяцНалоговогоПериода КАК МесяцНалоговогоПериода,
		|	СУММА(&СуммаСПревышения) КАК СуммаСПревышения
		|ИЗ
		|	&ИсточникНДФЛ КАК НДФЛ
		|ГДЕ
		|	НДФЛ.Ссылка = &Ссылка
		|	И &УсловиеНаСумму
		|СГРУППИРОВАТЬ ПО
		|	НДФЛ.ФизическоеЛицо,
		|	НДФЛ.КодДохода.Код,
		|	НДФЛ.МесяцНалоговогоПериода";
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8")
		И ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыПеречислением") Тогда
		ТекстБанковскийСчет = "Зарплата.БанковскийСчет";
	Иначе
		ТекстБанковскийСчет = "Неопределено";
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&БанковскийСчет", ТекстБанковскийСчет);
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаСПревышения", "НДФЛ.СуммаСПревышения");
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.11") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаСумму", " НЕ(НДФЛ.Сумма+НДФЛ.СуммаСПревышения = 0)");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаСумму", " НЕ(НДФЛ.Сумма = 0)");
		КонецЕсли;
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаСПревышения", "Неопределено");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаСумму", " НЕ(НДФЛ.Сумма = 0)");
	КонецЕсли;
		
	ПолноеИмяОбъекта  = ДанныеИБ.Метаданные().ПолноеИмя();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсточникЗарплата", ПолноеИмяОбъекта + ".Зарплата");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсточникНДФЛ", ПолноеИмяОбъекта + ".НДФЛ");
	ТекстНомерЛицевогоСчета = "Неопределено";
	Если ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыПеречислением") Тогда
		ТекстНомерЛицевогоСчета = "Зарплата.БанковскийСчет.НомерСчета";
	ИначеЕсли ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
		ТекстНомерЛицевогоСчета = "Зарплата.НомерЛицевогоСчета";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерЛицевогоСчета", ТекстНомерЛицевогоСчета);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.Текст = ТекстЗапроса;
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	ДанныеXDTO.Вставить("Зарплата", РезультатПакета[0].Выгрузить());
	ДанныеXDTO.Вставить("НДФЛ", РезультатПакета[1].Выгрузить());
КонецПроцедуры
Процедура ВедомостьПрочихДоходов_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ПоляГруппировки = "ФизическоеЛицо";
	Если ТипЗнч(ДанныеИБ.Ссылка) = Тип("ДокументСсылка.ВедомостьПрочихДоходовПеречислением") Тогда
		ПоляГруппировки = ПоляГруппировки + ",БанковскийСчет";
		ДанныеXDTO.Вставить("СпособВыплаты", "ПеречислениемНаСчета");
	ИначеЕсли ТипЗнч(ДанныеИБ.Ссылка) = Тип("ДокументСсылка.ВедомостьПрочихДоходовВБанк") Тогда
		ПоляГруппировки = ПоляГруппировки + ",НомерЛицевогоСчета";
		ДанныеXDTO.Вставить("СпособВыплаты", "ЧерезБанк");
	Иначе
		ДанныеXDTO.Вставить("СпособВыплаты", "ЧерезКассу");
	КонецЕсли;
	
	Зарплата = ДанныеИБ.Выплаты.Выгрузить();
	Зарплата.Свернуть(ПоляГруппировки,"КВыплате");
	Зарплата.Колонки.КВыплате.Имя = "Сумма";
	ДанныеXDTO.Вставить("Зарплата", Зарплата);
	
	НДФЛ = ДанныеИБ.НДФЛ.Выгрузить();
	ОтборПустых = Новый Структура("Сумма",0);
	КолонкиСуммирования = "Сумма";
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.11") Тогда
		ОтборПустых.Вставить("СуммаСПревышения", 0);
		КолонкиСуммирования = КолонкиСуммирования + ", СуммаСПревышения";
	ИначеЕсли ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.10") Тогда
		НДФЛ.Колонки.Удалить("СуммаСПревышения");
	КонецЕсли;
	НДФЛ.Свернуть("ФизическоеЛицо", КолонкиСуммирования);
	НулевыеСтроки = НДФЛ.НайтиСтроки(ОтборПустых);
	Для каждого СтрокаТаблицы Из НулевыеСтроки Цикл
		НДФЛ.Удалить(СтрокаТаблицы)
	КонецЦикла;
	
	ДанныеXDTO.Вставить("НДФЛ", НДФЛ);
	
	СпособРасчетов = "";
	Если ДанныеИБ.СпособВыплаты = Перечисления.СпособыВыплатыПрочихДоходов.ВыплатаПрочихДоходов
		Или ДанныеИБ.СпособВыплаты = Перечисления.СпособыВыплатыПрочихДоходов.ВыплатыБывшимСотрудникам Тогда
		СпособРасчетов = ОбщегоНазначения.ИмяЗначенияПеречисления(Перечисления.СпособыРасчетовСФизическимиЛицами.РасчетыСКонтрагентами);
	ИначеЕсли ДанныеИБ.СпособВыплаты = Перечисления.СпособыВыплатыПрочихДоходов.ДивидендыСотрудникам Тогда
		СпособРасчетов = ОбщегоНазначения.ИмяЗначенияПеречисления(Перечисления.СпособыРасчетовСФизическимиЛицами.ОплатаТруда);
	ИначеЕсли ДанныеИБ.СпособВыплаты = Перечисления.СпособыВыплатыПрочихДоходов.Дивиденды Тогда
		СпособРасчетов = ОбщегоНазначения.ИмяЗначенияПеречисления(Перечисления.СпособыРасчетовСФизическимиЛицами.Дивиденды);
	КонецЕсли;
	
	ДанныеXDTO.Вставить("СпособРасчетов", СпособРасчетов);
КонецПроцедуры
