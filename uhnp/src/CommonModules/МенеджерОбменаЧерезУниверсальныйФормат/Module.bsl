	ПравилоКонвертации.ОбъектФормата     = "Документ.СчетФактураПолученный"; //@NON-NLS-1
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_СчетФактураПолученныйНалоговыйАгент_Отп_ПриОтправкеДанных";
