Процедура ПКО_СправочникСсылка_Патенты_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ЗаполнитьЗначенияСвойств(ДанныеXDTO.КлючевыеСвойства, ДанныеИБ);
	
	ДанныеXDTO.Вставить("ДатаНачала", ДанныеИБ.ДатаНачала);
	ДанныеXDTO.Вставить("ДатаОкончания", ДанныеИБ.ДатаОкончания);
	ДанныеXDTO.Вставить("НомерПатента", ДанныеИБ.НомерПатента);
	ДанныеXDTO.Вставить("КодПоОКТМО", ДанныеИБ.НалоговыйОрган.КодПоОКТМО);
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) <= ВерсияФорматаЧислом("1.10") Тогда
	     ДанныеXDTO.Вставить("КБК", "0");
		 ДанныеXDTO.Вставить("ПотенциальноВозможныйГодовойДоход", "0");
	КонецЕсли;
	ДанныеXDTO.КлючевыеСвойства.Вставить("КодНалоговогоОргана", ДанныеИБ.НалоговыйОрган.Код);  
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
	
		Если ЗначениеЗаполнено(ДанныеИБ.КодПоКВПД) Тогда
			ДанныеXDTO.Вставить("КодПоКВПД", ДанныеИБ.КодПоКВПД);
		КонецЕсли;
		ДанныеXDTO.Вставить("ПродаватьНоменклатуруПустымКодомПоКВПД", ДанныеИБ.ПродаватьНоменклатуруПустымКодомПоКВПД);
		
		// тч.ТорговыеТочки
		Если ТипЗнч(КомпонентыОбмена.УзелКорреспондентаОбъект) = Тип("ПланОбменаОбъект.СинхронизацияДанныхЧерезУниверсальныйФормат")
			И КомпонентыОбмена.УзелКорреспондентаОбъект.ВариантНастройки = "ОбменУПРМК"
			И ПатентыДляВыгрузкиВРМК(КомпонентыОбмена.УзелКорреспондента).Количество() = 0 Тогда
			
			ЗапросСтроки = Новый Запрос;
			ЗапросСтроки.Параметры.Вставить("УзелОбменаРМК", КомпонентыОбмена.УзелКорреспондента);
			ЗапросСтроки.Текст = 
			"ВЫБРАТЬ
			|	СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ.КассаККМ.Склад КАК ТорговаяТочка
			|ИЗ
			|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.КассыККМ КАК СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ
			|ГДЕ
			|	СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ.Ссылка = &УзелОбменаРМК
			|
			|СГРУППИРОВАТЬ ПО
			|	СинхронизацияДанныхЧерезУниверсальныйФорматКассыККМ.КассаККМ.Склад
			|
			|УПОРЯДОЧИТЬ ПО
			|	ТорговаяТочка";
			РезультатЗапроса = ЗапросСтроки.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
				ДанныеXDTO.Вставить("ТорговыеТочки", РезультатЗапроса.Выгрузить());
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры

