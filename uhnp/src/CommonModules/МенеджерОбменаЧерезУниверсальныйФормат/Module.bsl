КонецПроцедуры
Процедура ПКО_Документ_ОтчетПереработчика_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоУПереработчика;
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO, "ВалютаВзаиморасчетов", "ВалютаВзаиморасчетов");
	ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	#Область Товары
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Материалы") И ЗначениеЗаполнено(ДанныеXDTO.Материалы) Тогда
		МассивСтрокМатериалы = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.Материалы Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			Если НЕ СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
				СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли;	
			
			МассивСтрокМатериалы.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
	
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Материалы", МассивСтрокМатериалы);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Продукция") И ЗначениеЗаполнено(ДанныеXDTO.Продукция) Тогда
		МассивСтрокПродукция = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.Продукция Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			Если НЕ СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
				СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли;	
			
			МассивСтрокПродукция.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
	
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Продукция", МассивСтрокПродукция);
	КонецЕсли;
	
	#КонецОбласти
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("СтавкаНДС",    "СтавкаНДС");
	ПравилаЗаполнения.Вставить("Сумма",        "Сумма");
	ПравилаЗаполнения.Вставить("СуммаНДС",     "СуммаНДС");
	
	МассивСтрокУслуги = Новый Массив;
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда
		
		ИтогоСумма = 0;
		ИтогоСуммаНДС = 0;
		ИтогоСуммаСНДС = 0;
		
		Для Каждого Строка Из ДанныеXDTO.Услуги Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
	
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
			    СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
			
			Если Строка.СуммаНДС = Неопределено Тогда
				Строка.СуммаНДС = 0;
			КонецЕсли;
			
			СуммаСНДС = Строка.Сумма + Строка.СуммаНДС;
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС); 
			
			МассивСтрокУслуги.Добавить(СтруктураДанныхСтроки);
			
			ИтогоСумма     = ИтогоСумма + Строка.Сумма;
			ИтогоСуммаНДС  = ИтогоСуммаНДС + Строка.СуммаНДС;
			ИтогоСуммаСНДС = ИтогоСуммаСНДС + СуммаСНДС;
		
		КонецЦикла;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Услуги", МассивСтрокУслуги);
		
		Если МассивСтрокУслуги.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, МассивСтрокУслуги[0]);
			ПолученныеДанные.Сумма     = ИтогоСумма;
			ПолученныеДанные.СуммаНДС  = ИтогоСуммаНДС;
			ПолученныеДанные.СуммаСНДС = ИтогоСуммаСНДС;
		КонецЕсли;
		
	КонецЕсли;
	#Область ВозвратныеОтходы
	
	Если ДанныеXDTO.Свойство("ОтходыПроизводства") И ЗначениеЗаполнено(ДанныеXDTO.ОтходыПроизводства) Тогда
		
		МассивСтрокВозвратныеОтходы = Новый Массив;
		
		ПравилаЗаполнения = Новый Соответствие;
		
		ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
		ПравилаЗаполнения.Вставить("Количество",   "Количество");
		ПравилаЗаполнения.Вставить("Цена",   "Цена");
		ПравилаЗаполнения.Вставить("Сумма",   "Сумма");
		Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
			ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
		КонецЕсли;
		Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
			ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
			ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
		КонецЕсли;
		
		Для Каждого Строка Из ДанныеXDTO.ОтходыПроизводства Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения); 
			
			МассивСтрокВозвратныеОтходы.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
		
		Если МассивСтрокВозвратныеОтходы.Количество() > 0 Тогда
			
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВозвратныеОтходы", МассивСтрокВозвратныеОтходы);
			
		КонецЕсли;
		
	КонецЕсли;  
	
	#КонецОбласти	
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Документ_ОтчетПереработчика_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
		                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
	ЗаполнитьПодразделениеПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
		                            
	Если НЕ ДанныеИБ = Неопределено Тогда
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Материалы,
			ДанныеИБ.Материалы,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, Упаковка, КоличествоУпаковок");  
		ДанныеИБ.Материалы.Загрузить(ПолученныеДанные.Материалы.Выгрузить());
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Продукция,
			ДанныеИБ.Продукция,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, Упаковка, КоличествоУпаковок");  
		ДанныеИБ.Продукция.Загрузить(ПолученныеДанные.Продукция.Выгрузить());
			
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.ВозвратныеОтходы,
			ДанныеИБ.ВозвратныеОтходы,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, Цена, Сумма, Упаковка, КоличествоУпаковок");  
		ДанныеИБ.ВозвратныеОтходы.Загрузить(ПолученныеДанные.ВозвратныеОтходы.Выгрузить());
		
		МассивКлючевыхПолей.Добавить("СтавкаНДС");
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Услуги,
			ДанныеИБ.Услуги,
			МассивКлючевыхПолей,
			Неопределено,
			"Сумма, СуммаНДС, СуммаСНДС");  
		ДанныеИБ.Услуги.Загрузить(ПолученныеДанные.Услуги.Выгрузить());
		
		ПолученныеДанные = Неопределено;
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ДатаПлатежа) Тогда
		ДанныеДляЗаписиВИБ.ДатаПлатежа = ДанныеДляЗаписиВИБ.Дата;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.УслугиПоПереработке) Тогда
		ДанныеДляЗаписиВИБ.УслугиПоПереработке = Перечисления.ВариантыОформленияУслугДокументовПереработки.УказываютсяВЗаказеОтчете;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ГруппировкаЗатрат) Тогда
		ДанныеДляЗаписиВИБ.ГруппировкаЗатрат = Перечисления.ГруппировкиЗатратВЗаказеПереработчику.БезГруппировки;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СпособРаспределенияЗатратНаВыходныеИзделия) Тогда
		ДанныеДляЗаписиВИБ.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоПлановойСтоимости;
	КонецЕсли;
	Если ДанныеДляЗаписиВИБ.Валюта = ДанныеДляЗаписиВИБ.ВалютаВзаиморасчетов Тогда
		ДанныеДляЗаписиВИБ.КурсЧислитель = 1;
		ДанныеДляЗаписиВИБ.КурсЗнаменатель = 1;
	КонецЕсли;
	УстановитьОтменуМеханическойЧисткиДвижений(ДанныеИБ);
КонецПроцедуры

