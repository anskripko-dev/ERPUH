Процедура ПКО_Документ_СтатистикаПерсонала_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("СреднесписочнаяЧисленностьВнешнихСовместителей", "СреднесписочнаяЧисленностьВнешнихСовместителей");
	ПравилаЗаполнения.Вставить("СреднесписочнаяЧисленностьСотрудников",          "СреднесписочнаяЧисленностьСотрудников");
	ПравилаЗаполнения.Вставить("СредняяЧисленностьДоговорников",                 "СредняяЧисленностьДоговорников");
	
	Показатели = Новый Массив;
	
	Если ДанныеXDTO.Свойство("Показатели") И ЗначениеЗаполнено(ДанныеXDTO.Показатели) Тогда
		Для Каждого Строка Из ДанныеXDTO.Показатели Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			Если ЗначениеЗаполнено(Строка.Подразделение) Тогда
				
				Подразделение = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
					КомпонентыОбмена,
					Строка.Подразделение,
					ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Подразделения_Получение"), 
					"ПолучитьСсылку").Ссылка;
				
				Запрос = Новый Запрос("
					|ВЫБРАТЬ
					|	РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
					|ИЗ
					|	РегистрСведений.РегистрацииВНалоговомОргане.СрезПоследних(
					|		, Организация = &Организация И Подразделение = &Подразделение) КАК РегистрацииВНалоговомОргане");
				Запрос.УстановитьПараметр("Организация", ПолученныеДанные.Организация);
				Запрос.УстановитьПараметр("Подразделение", Подразделение);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					СтруктураДанныхСтроки.Вставить("РегистрацияВНалоговомОргане", Выборка.РегистрацияВНалоговомОргане);
				КонецЕсли;
			КонецЕсли;
			
			Показатели.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Показатели", Показатели);
КонецПроцедуры

