Процедура ПКО_Документ_УведОВвозеПрослежТов_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеXDTO.Сумма) Тогда
		ДанныеXDTO.Сумма = ДанныеИБ.Товары.Итог("Сумма");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеXDTO.Склад) И ДанныеИБ.Товары.Количество() > 0 Тогда
		ДанныеXDTO.Склад = ДанныеИБ.Товары[0].Склад;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.Ссылка КАК Ссылка,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.НомерСтроки КАК НомерСтроки,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.Номенклатура КАК Номенклатура,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.Количество КАК Количество,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.Сумма КАК Сумма,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.НомерГТД КАК НомерГТД,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.Упаковка КАК Упаковка,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.СтранаПроисхождения КАК СтранаПроисхождения,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.АналитикаУчетаНоменклатуры.Серия КАК Серия
		|ИЗ
		|	Документ.УведомлениеОВвозеПрослеживаемыхТоваров.Товары КАК УведомлениеОВвозеПрослеживаемыхТоваровТовары
		|ГДЕ
		|	УведомлениеОВвозеПрослеживаемыхТоваровТовары.Ссылка = &Ссылка";	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Товары = РезультатЗапроса.Выгрузить();
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		ИмяТаблицы = "Документ.УведомлениеОВвозеПрослеживаемыхТоваров.Товары"; 
		ИдентификаторыИзВидовЗапасов = Ложь;
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов);
		// Так как в табличной части документа автоматически не заполняются идентификаторы строк, 
		//  необходимо заполнить вручную, для связи табличных частей "Товары" и "СведенияРНПТ" при загрузке.
		Если ДанныеXDTO.Свойство("СведенияРНПТ")
			И ЗначениеЗаполнено(ДанныеXDTO.СведенияРНПТ) Тогда
			
			ДанныеXDTO.СведенияРНПТ.Индексы.Добавить("Номенклатура, НомерГТД");
			
			СтруктураОтбора = Новый Структура("Номенклатура, НомерГТД");
			
			Для Каждого СтрокаТоваров Из Товары Цикл
				
				ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаТоваров);
				
				НайденныеСтроки = ДанныеXDTO.СведенияРНПТ.НайтиСтроки(СтруктураОтбора);
				
				СтрокаТоваров.ИдентификаторСтроки = Новый УникальныйИдентификатор();
				
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					НайденнаяСтрока.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
					
				КонецЦикла;
				
			КонецЦикла;
	
		КонецЕсли;
	ИначеЕсли ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		Если ДанныеИБ.Товары.Количество() > 0 Тогда
			НомерГТД = ДанныеИБ.Товары[0].НомерГТД;
			РНПТ = Новый Структура; 
			РНПТ.Вставить("Ссылка", НомерГТД.Ссылка);
			РНПТ.Вставить("НомерГТД", НомерГТД.Код);
			
			СтранаПроисхождения = Новый Структура;
			СтранаПроисхождения.Вставить("Ссылка", НомерГТД.СтранаПроисхождения.Ссылка);
			ДанныеКлассификатора = Новый Структура("Код,Наименование",НомерГТД.СтранаПроисхождения.Код,НомерГТД.СтранаПроисхождения.Наименование);
			СтранаПроисхождения.Вставить("ДанныеКлассификатора", ДанныеКлассификатора);
			
			РНПТ.Вставить("СтранаПроисхождения", СтранаПроисхождения);
			Если ЗначениеЗаполнено(НомерГТД) И ЗначениеЗаполнено(НомерГТД.СтранаПроисхождения) Тогда
				ДанныеXDTO.Вставить("РНПТ", РНПТ); 
			Иначе 
				Если НЕ ЗначениеЗаполнено(НомерГТД) Тогда
					Свойство = "Номер ГТД";
				Иначе	
					Свойство = "Страна происхождения";
				КонецЕсли;
				ТекстОшибки = НСтр("ru = 'У документа ""%1"" не заполнен реквизит ""%2"".
				|Документ ""%1"" не выгружен.';
				|en = 'The ""%2"" attribute is not filled in the ""%1"" document.
				|The ""%1"" document is not exported.'", ОбщегоНазначения.КодОсновногоЯзыка());
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Строка(ДанныеИБ.Ссылка), Свойство);
				ЗаписатьОшибкуВЖурналРегистрации(ДанныеИБ.Ссылка, ТекстОшибки, КомпонентыОбмена, УровеньЖурналаРегистрации.Предупреждение);		
				РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(
				ДанныеИБ.Ссылка,
				КомпонентыОбмена.УзелКорреспондента,
				ТекстОшибки,
				Перечисления.ТипыПроблемОбменаДанными.НезаполненныеРеквизиты);
				ДанныеXDTO = Неопределено;
				Возврат;
			КонецЕсли; 
		КонецЕсли;
	Иначе
		ДанныеXDTO.Вставить("РНПТ", ДанныеИБ.РНПТ);
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Товары",Товары);
КонецПроцедуры

