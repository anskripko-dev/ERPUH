Процедура ПОД_Документ_ПоступлениеТоваровУслуг_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	//++ Локализация
	
	Если ДанныеИБ.ОперацияССамозанятым 
		И Не ПоддерживаетсяВыгрузкаДокументаССамозанятым(КомпонентыОбмена) Тогда
		
		УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
		
		Возврат;
		
	КонецЕсли;
	
	//-- Локализация
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаЧерезПодотчетноеЛицо Тогда
		ИспользованиеПКО.Документ_ПоступлениеТоваровУслуг_Отправка = Ложь;
		
		// При изменении поступления дополнительно будут отработаны ПРО для связанного авансового отчета.
		ИспользованиеПКО.Документ_ПТУЧерезПодотчетноеЛицо_Отправка = НЕ (ЗначениеЗаполнено(ДанныеИБ.АвансовыйОтчет)
			И ОбщегоНазначения.СсылкаСуществует(ДанныеИБ.АвансовыйОтчет));
	Иначе
		ИспользованиеПКО.Документ_ПоступлениеТоваровУслуг_Отправка = Истина;
		ИспользованиеПКО.Документ_ПТУЧерезПодотчетноеЛицо_Отправка = Ложь;
	КонецЕсли;
	Если ИспользованиеПКО.Количество() > 0
		И НЕ ТипНалогообложенияВалиден(ДанныеИБ.ЗакупкаПодДеятельность, ДанныеИБ.НалогообложениеНДС, КомпонентыОбмена.ВерсияФорматаОбмена) Тогда
		
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
			 
		ШаблонПредупреждения = НСтр("ru = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
									|en = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format'");
		ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ДанныеИБ.Ссылка, "«" + Строка(ДанныеИБ.НалогообложениеНДС) + "»", Строка(КомпонентыОбмена.ВерсияФорматаОбмена));
		ПредупреждениеПриСинхронизации(КомпонентыОбмена, ДанныеИБ.Ссылка, ТекстПредупреждения);
		
	КонецЕсли;
КонецПроцедуры

