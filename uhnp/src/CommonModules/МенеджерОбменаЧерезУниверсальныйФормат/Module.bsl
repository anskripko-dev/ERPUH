	ПравилоКонвертации.ОбъектФормата     = "Документ.РезервыПоОплатеТруда"; //@NON-NLS-1
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_РезервыПоОплатеТруда_Отправка_ПриОтправкеДанных";
	СвойстваШапки = ПравилоКонвертации.Свойства;
