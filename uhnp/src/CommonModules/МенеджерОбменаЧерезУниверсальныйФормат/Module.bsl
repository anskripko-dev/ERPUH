Процедура ПОД_Документ_ПоступлениеОтПереработчика_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
	
	// Может одновременно использоваться производство на стороне версии 2.4 и версии 2.5.
	// В этом случае ищем ссылку среди документов 2.4. Если не нашли, то используем правило для версии 2.5.
	Если ЗначениеФО("ИспользоватьПроизводствоНаСтороне2_5", КомпонентыОбмена) Тогда
		
		Если ЗначениеФО("ИспользоватьПроизводствоНаСтороне", КомпонентыОбмена)
			И ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПоступлениеОтПереработчика") <> Неопределено Тогда
			
			ИспользованиеПКО.Документ_ПоступлениеОтПереработчика_Получение = Истина;
		Иначе
			ИспользованиеПКО.Документ_ПоступлениеОтПереработчика25_Получение = Истина;
		КонецЕсли;
			
	Иначе
		ИспользованиеПКО.Документ_ПоступлениеОтПереработчика_Получение = Истина;
	КонецЕсли;
КонецПроцедуры

