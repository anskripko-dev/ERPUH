Процедура ОтложеннаяОбработка_РеализацияТоваровУслуг(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	Для Каждого Строка Из Объект.Товары Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Строка.Номенклатура = ЭлементПоУмолчанию(КомпонентыОбмена, "НоменклатураУслуга");
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.Партнер) Тогда
		Объект.Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.Контрагент);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Партнер)
		И Не ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровКакКонтрагентов") Тогда
		
		КонтрагентЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ЮридическоеФизическоеЛицо");
		
		Партнер = Справочники.Партнеры.НеизвестныйПартнер;
		
		Если КонтрагентЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			Партнер = Справочники.Партнеры.РозничныйПокупатель;
		КонецЕсли;
		
		Объект.Партнер = Партнер;
		
	КонецЕсли;
	
	РеализацияЧерезКомиссионера = РеализацияЧерезКомиссионера(Объект.ХозяйственнаяОперация);
	
	Если РеализацияЧерезКомиссионера Тогда
		
		Если Не ЗначениеЗаполнено(Объект.КлиентПартнер) Тогда
			Объект.КлиентПартнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.КлиентКонтрагент);
		КонецЕсли;
		
		Если Не (ЗначениеЗаполнено(Объект.КлиентДоговор) И ОбщегоНазначения.СсылкаСуществует(Объект.КлиентДоговор)) Тогда
			Объект.КлиентДоговор = Неопределено;  
		КонецЕсли; 
		
	КонецЕсли; 
	
	ЗаполнениеСоглашенияСКлиентомВШапкеДокумента(Объект);
	СоглашениеЗаполнено = (ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами") И ЗначениеЗаполнено(Объект.Соглашение));
	Если СоглашениеЗаполнено Тогда
	    УсловияПродаж = ПродажиСервер.ПолучитьУсловияПродаж(Объект.Соглашение, Истина, Истина);
	    Если УсловияПродаж.СтатусСоглашения <> Перечисления.СтатусыСоглашенийСКлиентами.Закрыто Тогда
	        Объект.ДатаВозвратаМногооборотнойТары = МногооборотнаяТараСервер.РассчитатьДатуВозвратаМногооборотнойТары(
	            Объект,
	            УсловияПродаж.СрокВозвратаМногооборотнойТары,
	            УсловияПродаж.РассчитыватьДатуВозвратаТарыПоКалендарю,
	            УсловияПродаж.КалендарьВозвратаТары); 
	    КонецЕсли;
	Иначе
	    Объект.ДатаВозвратаМногооборотнойТары = Дата(1,1,1);
	КонецЕсли;
	
	ЗаполнитьПараметрыДоставки(Объект);
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьКодТНВЭД", Объект.НалогообложениеНДС);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.Товары, СтруктураДействий, Неопределено);
	
	ЗаполнитьПорядокРасчетов(Объект, Объект.Договор, Объект.Соглашение);
	ВзаиморасчетыСервер.ПроверитьЗаполнитьЭтапыГрафикаОплаты(Объект);
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
	
	Если Объект.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию
		И Не РеализацияЧерезКомиссионера
		И ПолучитьФункциональнуюОпцию("ИспользоватьАвтоматическиеСкидкиВПродажах")
		И Не Объект.СкидкиРассчитаны Тогда
		
		Объект.СкидкиРассчитаны = Истина;
	КонецЕсли;
КонецПроцедуры
//++ Локализация
Процедура ОтложеннаяОбработка_РеализацияТоваровУслуг_ЧекККМ(Объект, КомпонентыОбмена)
	// Реквизиты шапки, которые будут заполнены из сообщения обмена
	ОбъектШапкаЧек = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "Дата, Склад, Контрагент, Партнер, СуммаДокумента");
	Для Каждого Элемент Из ОбъектШапкаЧек Цикл
		// пустые значения из сообщения обмена не будем переносить
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			ОбъектШапкаЧек.Удалить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
		Возврат;
	КонецЕсли;
	ЗаказОбъект = Объект.ЗаказКлиента.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из ЗаказОбъект.Товары Цикл
		Строка.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		Строка.ДатаОтгрузки = Объект.Дата;
	КонецЦикла;
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ИспользоватьРасширенныеВозможностиЗаказаКлиента Тогда
		ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	Иначе
		ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован;
	КонецЕсли;
	
	ЗаказОбъект.Записать();
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", Объект.ЗаказКлиента);
	
	ПараметрыОформления = Новый Структура;
	ПараметрыОформления.Вставить("ВводитьНаОснованииНепроведенного", Не Объект.ЗаказКлиента.Проведен);
	ПараметрыОформления.Вставить("ПоЗаказам", Истина);
	ПараметрыОформления.Вставить("ПоОрдерам", Ложь);
	
	ДанныеЗаполнения.Вставить("ПараметрыОформления", ПараметрыОформления);
	ДанныеЗаполнения.Вставить("ДокументОснование", Объект.ЗаказКлиента);
	
	Если Объект.ЗаказКлиента.Статус = Перечисления.СтатусыЗаказовКлиентов.КОтгрузке Тогда
		Объект.Заполнить(ДанныеЗаполнения);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОбъектШапкаЧек);
	
	ОбъектТоварыОснование = Объект.Товары.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Упаковка КАК Упаковка,
	|	Таблица.Цена КАК Цена,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	Таблица.КодСтроки КАК КодСтроки,
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.Количество КАК Количество,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	Таблица.СуммаРучнойСкидки КАК СуммаРучнойСкидки
	|ПОМЕСТИТЬ ТоварыОснование
	|ИЗ
	|	&ТоварыОснование КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиента.Номенклатура КАК Номенклатура,
	|	ЗаказКлиента.Характеристика КАК Характеристика,
	|	ЗаказКлиента.Упаковка КАК Упаковка,
	|	ЗаказКлиента.Цена КАК Цена,
	|	ЗаказКлиента.СтавкаНДС КАК СтавкаНДС,
	|	ЗаказКлиента.КодСтроки КАК КодСтроки,
	|	ЗаказКлиента.НомерСтроки КАК НомерСтроки,
	|	ЗаказКлиента.Количество КАК Количество,
	|	ЗаказКлиента.Сумма КАК Сумма,
	|	ЗаказКлиента.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	ЗаказКлиента.СуммаРучнойСкидки КАК СуммаРучнойСкидки
	|ПОМЕСТИТЬ ТоварыЗаказ
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОснование.Номенклатура КАК Номенклатура,
	|	ТоварыОснование.Характеристика КАК Характеристика,
	|	ТоварыОснование.Упаковка КАК Упаковка,
	|	ТоварыОснование.Цена КАК Цена,
	|	ТоварыОснование.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(ТоварыЗаказ.КодСтроки, 0) КАК КодСтроки,
	|	ТоварыОснование.НомерСтроки КАК НомерСтроки,
	|	ТоварыОснование.Количество КАК Количество,
	|	ТоварыОснование.Сумма КАК Сумма,
	|	ТоварыОснование.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	ТоварыОснование.СуммаРучнойСкидки КАК СуммаРучнойСкидки
	|ИЗ
	|	ТоварыОснование КАК ТоварыОснование
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыЗаказ КАК ТоварыЗаказ
	|		ПО ТоварыОснование.Номенклатура = ТоварыЗаказ.Номенклатура
	|			И ТоварыОснование.Характеристика = ТоварыЗаказ.Характеристика
	|			И ТоварыОснование.Упаковка = ТоварыЗаказ.Упаковка
	|			И ТоварыОснование.Цена = ТоварыЗаказ.Цена
	|";
	
	Запрос.УстановитьПараметр("ТоварыОснование", ОбъектТоварыОснование);
	Запрос.УстановитьПараметр("ЗаказКлиента", Объект.ЗаказКлиента);
	
	ТоварыВыгрузка = Запрос.Выполнить().Выгрузить();
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Упаковка, Цена");
	Товары = Объект.Товары; // ТабличнаяЧасть
	Для каждого Строка Из Товары Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка);
		НайденнаяСтрока = ТоварыВыгрузка.НайтиСтроки(СтруктураПоиска);
		Если НайденнаяСтрока.Количество() > 0 Тогда
			Строка.КодСтроки = НайденнаяСтрока[0].КодСтроки;
		КонецЕсли; 
		Строка.ЗаказКлиента = Объект.ЗаказКлиента;
		Строка.Склад = Объект.Склад;
	КонецЦикла; 
	
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
	СтруктураДействий.Вставить("ЗаполнитьКодТНВЭД", Объект.НалогообложениеНДС);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.Товары, СтруктураДействий);
		
	Объект.СкидкиРассчитаны = Истина;
	
	ДокументыПоЧекамККМ = КомпонентыОбмена.ПараметрыКонвертации.ДокументыПоЧекамККМ; // ТаблицаЗначений
	НоваяСтрока = ДокументыПоЧекамККМ.Добавить();
	НоваяСтрока.ЗаказКлиента = Объект.ЗаказКлиента;
	НоваяСтрока.РеализацияТоваровУслуг = Объект.Ссылка;
КонецПроцедуры
//-- Локализация
Процедура ОтложеннаяОбработка_СБДСИзСтруктуры(Объект, КомпонентыОбмена)
	ЗаполнитьТаблицыОтложенногоПроведения(Объект, КомпонентыОбмена);
КонецПроцедуры

Процедура ОтложеннаяОбработка_СборкаТоваров(Объект, КомпонентыОбмена)
	ЗаполнитьВидДеятельностиПоУмолчанию(Объект, "СборкаПодДеятельность");
	
	Если НЕ ЗначениеЗаполнено(Объект.ВариантПриемкиТоваров) Тогда
		Объект.ВариантПриемкиТоваров = ЗакупкиСервер.ПолучитьВариантПриемкиТоваров();
	КонецЕсли;
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
КонецПроцедуры
Процедура ОтложеннаяОбработка_Склады(Объект)
	Если Объект.ЭтоГруппа Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ВыборГруппы) Тогда
			Объект.ВыборГруппы = Перечисления.ВыборГруппыСкладов.Запретить;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.РозничныйВидЦены) Тогда
		НаименованиеТипаЦен = НСтр("ru = 'Розничная цена';
									|en = 'Retail price'");
	
		ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию(НаименованиеТипаЦен, Истина);
	
		Если Не ЗначениеЗаполнено(ВидЦены)
			И Объект.ТипСклада = Перечисления.ТипыСкладов.РозничныйМагазин Тогда
			
			ВидОбъект = Справочники.ВидыЦен.СоздатьЭлемент();
			ВидОбъект.Наименование          = НаименованиеТипаЦен;
			ВидОбъект.ВалютаЦены            = Константы.ВалютаУправленческогоУчета.Получить();
			ВидОбъект.СпособЗаданияЦены     = Перечисления.СпособыЗаданияЦен.Вручную;
			ВидОбъект.СхемаКомпоновкиДанных = "ЦеныПоступленияПредопределенный";
			ВидОбъект.ИспользоватьПриПродаже = Истина;
			ВидОбъект.Записать();
			ВидЦены = ВидОбъект.Ссылка;
			
		КонецЕсли;
	
		Объект.РозничныйВидЦены = ВидЦены;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ИсточникИнформацииОЦенахДляПечати) Тогда
		Объект.ИсточникИнформацииОЦенахДляПечати = Перечисления.ИсточникиИнформацииОЦенахДляПечати.ПоВидуЦен;
	КонецЕсли;
КонецПроцедуры
Процедура ОтложеннаяОбработка_СоглашенияСКлиентами(Объект)
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	
	Если Не ЗначениеЗаполнено(Объект.Статус) Тогда
		Объект.Статус                           = Перечисления.СтатусыСоглашенийСКлиентами.Действует;
		Объект.Согласован                       = Истина;
		Объект.ИспользуютсяДоговорыКонтрагентов = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВалютаВзаиморасчетов) Тогда
		Объект.ВалютаВзаиморасчетов = Объект.Валюта;
	КонецЕсли;
КонецПроцедуры
Процедура ОтложеннаяОбработка_СоглашенияСПоставщиками(Объект)
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	
	Если Не ЗначениеЗаполнено(Объект.Статус) Тогда
		Объект.Статус                           = Перечисления.СтатусыСоглашенийСПоставщиками.Действует;
		Объект.ДоступноДляПродажиКлиентам       = Ложь;
		Объект.ИспользуютсяДоговорыКонтрагентов = Истина;
		Объект.Согласован                       = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВариантПриемкиТоваров) Тогда
		Объект.ВариантПриемкиТоваров = Константы.ВариантПриемкиТоваров.Получить();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВалютаВзаиморасчетов) Тогда
		Объект.ВалютаВзаиморасчетов = Объект.Валюта;
	КонецЕсли;
КонецПроцедуры
Процедура ОтложеннаяОбработка_СоздатьОбновитьОбъектыРасчетов(КомпонентыОбмена)
	Для Каждого ЗагруженныйОбъект Из КомпонентыОбмена.ЗагруженныеОбъекты Цикл
		
		// Для договоров кредитов и подарочных сертификатов создавать объект расчетов не нужно
		Если ТипЗнч(ЗагруженныйОбъект.СсылкаНаОбъект) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") 
			Или ТипЗнч(ЗагруженныйОбъект.СсылкаНаОбъект) = Тип("СправочникСсылка.ПодарочныеСертификаты") Тогда 
			
			Продолжить;
		КонецЕсли;
		
		Если Метаданные.ОпределяемыеТипы.ОбъектРасчетов.Тип.СодержитТип(ТипЗнч(ЗагруженныйОбъект.СсылкаНаОбъект)) Тогда
					 			
			Объект = ЗагруженныйОбъект.СсылкаНаОбъект.ПолучитьОбъект();
			Объект.ОбменДанными.Загрузка = Истина;
			
			МетаданныеОбъекта = ЗагруженныйОбъект.СсылкаНаОбъект.Метаданные();
			СоздаватьОбъектРасчетов = Ложь;
			
			Если МетаданныеОбъекта = Метаданные.Документы.ПервичныйДокумент Тогда
				// Пропускаем первичные документы с незаполненным типом
				СоздаватьОбъектРасчетов = ЗначениеЗаполнено(Объект.ТипПервичногоДокумента);
			Иначе
				МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
				ПараметрыМеханизма = МенеджерОбъекта.ПараметрыВзаиморасчеты(Объект);
				
				ДополненныеПараметрыМеханизма = ВзаиморасчетыСервер.ДополненныеПараметрыМеханизма(Объект, ПараметрыМеханизма);
				
				Для Каждого СтруктураПараметров Из ДополненныеПараметрыМеханизма.МассивПараметров Цикл
					
					Если Не СоздаватьОбъектРасчетов Тогда
						
						Если ОбъектыРасчетовСервер.СсылкаЯвляетсяОбъектомРасчетов(Объект, СтруктураПараметров) Тогда
							СоздаватьОбъектРасчетов = Истина;
						ИначеЕсли ЗначениеЗаполнено(СтруктураПараметров.ПутьКДаннымТЧРасшифровкаПлатежа) Тогда
							РасшифровкаПлатежа = ОбщегоНазначенияУТКлиентСервер.ДанныеПоПути(Объект, СтруктураПараметров.ПутьКДаннымТЧРасшифровкаПлатежа);
							Запрос = Новый Запрос;
							Запрос.Текст = "
							|ВЫБРАТЬ
							|	Расшифровка.ОбъектРасчетов
							|ПОМЕСТИТЬ Расшифровка
							|ИЗ &Расшифровка КАК Расшифровка
							|;
							|ВЫБРАТЬ ПЕРВЫЕ 1
							|	ИСТИНА
							|ИЗ
							|	Расшифровка
							|ГДЕ
							|	Расшифровка.ОбъектРасчетов.Объект = &Ссылка";
							Запрос.УстановитьПараметр("Расшифровка", РасшифровкаПлатежа);
							Запрос.УстановитьПараметр("Ссылка", ЗагруженныйОбъект.СсылкаНаОбъект);
							Выборка = Запрос.Выполнить().Выбрать();
							СоздаватьОбъектРасчетов = Выборка.Следующий();
							
							Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
								Если Не ЗначениеЗаполнено(СтрокаРасшифровки.ОбъектРасчетов) Тогда
									СоздаватьОбъектРасчетов = Истина;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если Не СоздаватьОбъектРасчетов Тогда 
				Продолжить;
			КонецЕсли;
			
			// В процедуре ОбъектыРасчетовСервер.ПроверитьОбъектыРасчетовПередЗаписью() возможна блокировка, выполняем в транзакции
			НачатьТранзакцию();
			Попытка
			
				Если ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта) И
					МетаданныеОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда 
					
					// Создаем объект расчетов для договора при необходимости
					Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Договор", МетаданныеОбъекта) И ЗначениеЗаполнено(Объект.Договор)
						И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПорядокРасчетов") =  Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов Тогда
						
						Договор = Объект.Договор.ПолучитьОбъект();
						Если Не ЗначениеЗаполнено(Договор.Партнер) Тогда
							ЗаполнениеПартнераВШапкеДокумента(Договор);
							Договор.ОбменДанными.Загрузка = Истина;
							Договор.Записать();
						КонецЕсли;
						ВзаиморасчетыСервер.ПередЗаписью(Договор, Ложь);
						
					КонецЕсли;
									
					Если МетаданныеОбъекта = Метаданные.Документы.ПервичныйДокумент Тогда					
						Документы.ПервичныйДокумент.АктуализироватьОбъектРасчетов(Объект, Ложь);
					ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) 
						И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Договор")
						И Не ОбщегоНазначения.СсылкаСуществует(Объект.Договор)  Тогда
						Продолжить
					ИначеЕсли (ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ХозяйственнаяОперация") 
						И Не Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств)
						ИЛИ НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ХозяйственнаяОперация") Тогда
						Если ОбщегоНазначения.СсылкаСуществует(ЗагруженныйОбъект.СсылкаНаОбъект) 
							И ТипЗнч(ЗагруженныйОбъект.СсылкаНаОбъект) = Тип("ДокументСсылка.ОтчетКомитенту")
							И Найти(Строка(ЗагруженныйОбъект.СсылкаНаОбъект.Договор), НСтр("ru = '<Объект не найден>';
																							|en = '<Object is not found>'")) <> 0 Тогда 
							ЗагруженныйОбъект.СсылкаНаОбъект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
							Продолжить;
						КонецЕсли;
						ВзаиморасчетыСервер.ПередЗаписью(Объект, Ложь, РежимЗаписиДокумента.Проведение);
					КонецЕсли;
					
				Иначе
					ВзаиморасчетыСервер.ПередЗаписью(Объект, Ложь);
				КонецЕсли;
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для объекта %1 не удалось создать объект расчета';
																							|en = 'Cannot create AR/AP object for the %1 object'"), ЗагруженныйОбъект.СсылкаНаОбъект);
				ОбменДаннымиXDTOСервер.ЗаписьЖурналаРегистрацииОбменДанными(ТекстОшибки, КомпонентыОбмена, , ЗагруженныйОбъект.СсылкаНаОбъект);
				КомпонентыОбмена.ФлагОшибки = Истина;
				КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Ошибка;
				
				ВызватьИсключение;
				
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ОтложеннаяОбработка_СортДокОтложенногоПров(КомпонентыОбмена)
	// В ряде случаев документы с одной датой должны проводиться в определенном порядке.
		
	// Добавим в таблицу "ДокументыДляОтложенногоПроведения" колонку "ОчередьПроведения".
	// Чем меньше значение очереди, тем раньше будет проведен документ в рамках документов одной даты.
	// По умолчанию очередь имеет нулевое (0) значение.
	ДокументыДляОтложенногоПроведения = КомпонентыОбмена.ДокументыДляОтложенногоПроведения; // ТаблицаЗначений
	ДокументыДляОтложенногоПроведения.Колонки.Добавить("ОчередьПроведения", Новый ОписаниеТипов("Число"));
	
	ТипыСчетФактуры = Новый Массив;
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураВыданныйАванс"));
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураПолученныйАванс"));
	//++ Локализация
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураВыданный"));
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураКомиссионеру"));
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураКомитента"));
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураНалоговыйАгент"));
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураНаНеподтвержденнуюРеализацию0"));
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураПолученный"));
	ТипыСчетФактуры.Добавить(Тип("ДокументСсылка.СчетФактураПолученныйНалоговыйАгент"));
	//-- Локализация
	
	Для Каждого СтрокаТаблицы Из ДокументыДляОтложенногоПроведения Цикл
		
		Если СтрокаТаблицы.ДокументСсылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;	
	
		Если НЕ ТипыСчетФактуры.Найти(ТипЗнч(СтрокаТаблицы.ДокументСсылка)) = Неопределено Тогда
			СтрокаТаблицы.ОчередьПроведения = 2;
		КонецЕсли;
			
	КонецЦикла;
	
	ДокументыДляОтложенногоПроведения.Сортировать("ДатаДокумента, ОчередьПроведения");
КонецПроцедуры
