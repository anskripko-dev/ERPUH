//-- Локализация
Процедура ОтложеннаяОбработка_ОтразитьДокументыВРеестре(КомпонентыОбмена)
	// Необходимо отразить в РеестреДокументов непроведенные документы.
	
	// Сформируем ключи реестра документов, только если загружались объекты с соответствующими типами.
	ОбъектыМетаданныхДляКлючейРеестра = Новый Соответствие;
		
	ТипыКлючей = Метаданные.НайтиПоПолномуИмени("Справочник.КлючиРеестраДокументов").Реквизиты.Ключ.Тип.Типы();
	
	Для Каждого ЗагруженныйОбъект Из КомпонентыОбмена.ЗагруженныеОбъекты Цикл
		МетаданныеОбъекта = ЗагруженныйОбъект.СсылкаНаОбъект.Метаданные();
		
		Если Не ОбщегоНазначения.ЭтоСправочник(МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипСсылки =  ТипЗнч(ЗагруженныйОбъект.СсылкаНаОбъект);
		
		Если ТипыКлючей.Найти(ТипСсылки) <> Неопределено Тогда
			
			Если ОбъектыМетаданныхДляКлючейРеестра[МетаданныеОбъекта] = Неопределено Тогда
				ОбъектыМетаданныхДляКлючейРеестра[МетаданныеОбъекта] = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ОбъектыМетаданныхДляКлючейРеестра.Количество() > 0 Тогда
		Справочники.КлючиРеестраДокументов.СоздатьОбновитьКлючиРеестра(ОбъектыМетаданныхДляКлючейРеестра);
	КонецЕсли;
	
	ДокументыДляОтложенногоПроведения = КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Скопировать();
	ДокументыДляОтложенногоПроведения.Свернуть("ДокументСсылка");
	
	Если ДокументыДляОтложенногоПроведения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Получим типы документов для отложенного проведения, содержащихся в РеестреДокументов.
	ДокументыДляОтраженияВРеестре = Новый Массив;
	Для Каждого СтрокаТаблицы Из ДокументыДляОтложенногоПроведения Цикл
	
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДокументСсылка)
			И ОбщегоНазначения.СсылкаСуществует(СтрокаТаблицы.ДокументСсылка) 
			И РегистрыСведений.РеестрДокументов.ОбъектВключенВСоставДанныхРеестра(СтрокаТаблицы.ДокументСсылка) Тогда
		
			ДокументыДляОтраженияВРеестре.Добавить(СтрокаТаблицы.ДокументСсылка);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументыДляОтраженияВРеестре = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДокументыДляОтраженияВРеестре);
	
	Для Каждого СсылкаНаДокумент Из ДокументыДляОтраженияВРеестре Цикл
	
		ТаблицыДанных = ПроведениеДокументов.ДанныеДокументаДляПроведения(СсылкаНаДокумент, "РеестрДокументов");
		РегистрыСведений.РеестрДокументов.ЗаписатьДанные(ТаблицыДанных, СсылкаНаДокумент, Неопределено, Ложь);
	
	КонецЦикла;
КонецПроцедуры
Процедура ОтложеннаяОбработка_ОтчетКомитентуИКомиссионера(Объект, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(Объект.Услуга) Тогда
		Объект.Услуга = ЭлементПоУмолчанию(КомпонентыОбмена, "НоменклатураУслуга");
	КонецЕсли;
	
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	ЭтоЗакупки = Истина;
	Если ТипЗнч(Объект.Соглашение) = Тип("СправочникСсылка.СоглашенияСКлиентами") Тогда
		ЭтоЗакупки = Ложь;
	КонецЕсли;
	Если ЭтоЗакупки Тогда
		ЗаполнениеСоглашенияСПоставщикомВШапкеДокумента(Объект, КомпонентыОбмена.ПараметрыКонвертации, Перечисления.ХозяйственныеОперации.ПриемНаКомиссию);
	Иначе
		ЗаполнениеСоглашенияСКлиентомВШапкеДокумента(Объект, Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию);
	КонецЕсли;
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	Если НЕ ЗначениеЗаполнено(Объект.СуммаНДСВознаграждения) Тогда
		ПроцентНДС = УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(Объект.СтавкаНДСВознаграждения);
		КомиссионнаяТорговляСервер.РассчитатьСуммуНДСВознаграждения(Объект, ПроцентНДС);
	КонецЕсли;
	
	Если Объект.ЭтапыГрафикаОплаты.Количество() > 0 И Объект.Товары.Итог("СуммаПродажи") <> Объект.ЭтапыГрафикаОплаты.Итог("СуммаПлатежа") Тогда
		Объект.ЭтапыГрафикаОплаты.Очистить();
	КонецЕсли;
	Если Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
		
		СтрокаОплаты = Объект.ЭтапыГрафикаОплаты.Добавить();
		СтрокаОплаты.ДатаПлатежа    = ?(ЗначениеЗаполнено(Объект.ДатаПлатежа), Объект.ДатаПлатежа, Объект.Дата);
		СтрокаОплаты.ПроцентПлатежа = 100;
		СтрокаОплаты.СуммаПлатежа   = Объект.Товары.Итог("СуммаПродажи");
		
		Если ТипЗнч(Объект) = Тип("ДокументОбъект.ОтчетКомиссионера") Тогда
			СтрокаОплаты.ВариантОплаты = Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки;
		ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ОтчетКомитенту") Тогда
			СтрокаОплаты.ВариантОплаты = Перечисления.ВариантыКонтроляОплатыПоставщику.КредитПослеПоступления;
		КонецЕсли;
	
		Сдвиг = (СтрокаОплаты.ДатаПлатежа - НачалоДня(Объект.Дата)) / 86400;
		СтрокаОплаты.Сдвиг = ?(Сдвиг < 0,0,Сдвиг);
	
		СтрокаОплаты.ВариантОтсчета = Перечисления.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки;
			
	КонецЕсли;
	
	ЗаполнитьПорядокРасчетов(Объект, Объект.Договор, Объект.Соглашение); 
	 
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВТЧ(Объект);
	
	СтруктураДействий = Новый Структура; 
	
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.Товары, СтруктураДействий);
КонецПроцедуры
Процедура ОтложеннаяОбработка_ОтчетОРозничныхПродажах(Объект, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(Объект.ВидЦены) И ЗначениеЗаполнено(Объект.Склад) Тогда
		РозничныйВидЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "РозничныйВидЦены");
		Если ЗначениеЗаполнено(РозничныйВидЦены) Тогда 
			Объект.ВидЦены = РозничныйВидЦены;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	
	Если Объект.ДополнительныеСвойства.Свойство("ТаблЧасти") Тогда
		Для каждого ТЧ Из Объект.ДополнительныеСвойства.ТаблЧасти Цикл
			Если ЗначениеЗаполнено(Объект.ДополнительныеСвойства.ТаблЧасти[ТЧ.Ключ]) Тогда
				Объект[ТЧ.Ключ].Загрузить(Объект.ДополнительныеСвойства.ТаблЧасти[ТЧ.Ключ]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ЗаполнитьКассуККМПоВалютеСкладуИОрганизации(Объект, КомпонентыОбмена);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
		ДокументыСПодарочнымиСертификатами = КомпонентыОбмена.ПараметрыКонвертации.ДокументыСПодарочнымиСертификатами; // ТаблицаЗначений
			
		НоваяСтрока = ДокументыСПодарочнымиСертификатами.Добавить();
		НоваяСтрока.ДокументСсылка   = Объект.Ссылка;
		НоваяСтрока.ДатаДокумента    = Объект.Дата;
		НоваяСтрока.ОчередьДокумента = 1;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект, "КассаККМ, Организация, Валюта");
	КонецЕсли;
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
	
	// Эквайринговый терминал в ТЧ ОплатаПлатежнымиКартами
	ЭквайринговыйТерминал = ЭлементПоУмолчанию(КомпонентыОбмена, "ЭквайринговыйТерминал");
	
	Для Каждого Строка Из Объект.ОплатаПлатежнымиКартами Цикл
		Если Не ЗначениеЗаполнено(Строка.ЭквайринговыйТерминал) Тогда
			Строка.ЭквайринговыйТерминал = ЭквайринговыйТерминал; 
		КонецЕсли;
	КонецЦикла;
	
	//++ Локализация
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "АкцизныеМарки") Тогда
		Для каждого Строка Из Объект.АкцизныеМарки Цикл
	    	Если Не ЗначениеЗаполнено(Строка.АкцизнаяМарка) И НЕ ПустаяСтрока(Строка.КодАкцизнойМарки) Тогда
		     	Строка.АкцизнаяМарка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", Строка.КодАкцизнойМарки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//-- Локализация
КонецПроцедуры
