Процедура ПКО_Документ_ПБДСВозвратНалога_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	#Область Шапка
	ПолученныеДанные.Проведен = Истина;
	
	ПолученныеДанные.ПроведеноБанком = ЗначениеЗаполнено(ПолученныеДанные.ДатаПроведенияБанком);
	
	ПолученныеДанные.ПеречислениеВБюджет = ?(ЗначениеЗаполнено(ПолученныеДанные.КодБК), Истина, Ложь);
	
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратНалогов;
	
	ПолученныеДанные.КодОКАТО = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(
		ПолученныеДанные.КодОКАТО, 11, " ", "Справа");
		
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO); 
	
	ТипНалога = Справочники.ВидыНалоговВзносов.ПолучитьСсылкуПредопределенногоЭлемента("ПрочиеНалогиИСборы");
	
	//++ Локализация 
	Если ДанныеXDTO.Свойство("ВидНалога")
		И ДанныеXDTO.ВидНалога.Значение = "ЕдиныйНалоговыйПлатеж" Тогда
		
		ТипНалога = Справочники.ВидыНалоговВзносов.ПолучитьСсылкуПредопределенногоЭлемента("ЕдиныйНалоговыйПлатеж");
		
	КонецЕсли;
	//-- Локализация
	
	ПолученныеДанные.ТипНалога = ТипНалога; 
	 
	#КонецОбласти
	
	#Область РасшифровкаПлатежа
	Если ДанныеXDTO.Свойство("РасшифровкаПлатежа")
		И ДанныеXDTO.РасшифровкаПлатежа.Количество() > 0 Тогда
	    
		//++ НЕ УТ
		
		//++ Локализация
		КодСчетаУчета = ДанныеXDTO.РасшифровкаПлатежа[0].СчетУчетаРасчетов;
		
		Если ЗначениеЗаполнено(КодСчетаУчета) Тогда
				
			СчетУчетаПоКоду = БухгалтерскийСчетПоКоду(КодСчетаУчета);
			
			Если ЗначениеЗаполнено(СчетУчетаПоКоду) Тогда
			    		    
				ПолученныеДанные.ДополнительныеСвойства.Вставить("СчетУчетаПоКоду", СчетУчетаПоКоду);
				
			КонецЕсли;
			
		КонецЕсли;
		//-- Локализация
		
		//-- НЕ УТ 
	    
		ПравилаЗаполнения = Новый Соответствие;
		
		ПравилаЗаполнения.Вставить("Сумма", "Сумма");
		ПравилаЗаполнения.Вставить("СтатьяДДС", "СтатьяДвиженияДенежныхСредств");
		
		МассивСтрокРасшифровкаПлатежа = Новый Массив;
		
		Для Каждого Строка Из ДанныеXDTO.РасшифровкаПлатежа Цикл   
		
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			МассивСтрокРасшифровкаПлатежа.Добавить(СтруктураДанныхСтроки);  
			
		КонецЦикла;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("РасшифровкаПлатежа", МассивСтрокРасшифровкаПлатежа);
			
	КонецЕсли;
	#КонецОбласти
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Документ_ПБДСВозвратНалога_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	//++ НЕ УТ
	
	//++ Локализация
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("СчетУчетаПоКоду") И 
		ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.СчетУчетаПоКоду) Тогда
	
		Если ДанныеИБ = Неопределено Тогда  
		
			ДанныеДляЗаписиВИБ = ПолученныеДанные; 
			
			ПараметрыНастройки = Новый Структура(); 
			
			ПараметрыНастройки.Вставить("СчетУчета", ПолученныеДанные.ДополнительныеСвойства.СчетУчетаПоКоду);
			
			ДанныеДляЗаписиВИБ.НастройкаСчетовУчета = НастройкаСчетовУчетаПрочихОпераций(ПараметрыНастройки, ПолученныеДанные.ПолучитьСсылкуНового());
			
		КонецЕсли;
		
	КонецЕсли;
	//-- Локализация
	
	//-- НЕ УТ
	  
	ПередМержеванием_ПБДС(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена); 
	 
	Если ДанныеИБ <> Неопределено Тогда
		
		// Заменяем свойства, которые получили из XDTO
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
			
	КонецЕсли; 
	  
	Мержевание_ПБДС(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена);
	ПослеМержевания_ПБДС(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	
	ПолученныеДанные = ?(ДанныеИБ = Неопределено, ПолученныеДанные, Неопределено);
КонецПроцедуры

