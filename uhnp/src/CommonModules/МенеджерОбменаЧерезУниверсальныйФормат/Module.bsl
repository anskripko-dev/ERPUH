Процедура ПКО_Документ_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	
	ЗаполнитьРеквизитыЧекаККМ(ПолученныеДанные);
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Склад) Тогда  
		Если НЕ КомпонентыОбмена.ПараметрыКонвертации.ВидыЦенНоменклатуры = Неопределено 
			 И КомпонентыОбмена.ПараметрыКонвертации.ВидыЦенНоменклатуры.Количество() > 0 Тогда
		     ПолученныеДанные.ВидЦены = КомпонентыОбмена.ПараметрыКонвертации.ВидыЦенНоменклатуры[0].Значение; 
		КонецЕсли;
		Если ЗначениеЗаполнено(КомпонентыОбмена.ПараметрыКонвертации.СкладПоУмолчанию)
			И КомпонентыОбмена.ПараметрыКонвертации.СкладПоУмолчанию.ТипСклада = ПредопределенноеЗначение("Перечисление.ТипыСкладов.РозничныйМагазин") Тогда
		     ПолученныеДанные.Склад = КомпонентыОбмена.ПараметрыКонвертации.СкладПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьНалогообложениеНДСПоПолученнымДанным(КомпонентыОбмена, ПолученныеДанные, ДанныеXDTO, Ложь);
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	ЗаполнитьКассовуюСменуПоНомеруИКассеККМ(ПолученныеДанные, ПолученныеДанные.КассаККМ, ДанныеXDTO.КлючевыеСвойства.НомерКассовойСмены);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("НомерКассовойСмены", ДанныеXDTO.КлючевыеСвойства.НомерКассовойСмены);
	
	ПолученныеДанные.Статус = Перечисления.СтатусыЧековККМ.Пробит;
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Партнер) Тогда
		Если ЗначениеЗаполнено(ПолученныеДанные.КартаЛояльности) Тогда
			ПолученныеДанные.Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПолученныеДанные.КартаЛояльности, "Партнер");
		Иначе
			ПолученныеДанные.Партнер = Справочники.Партнеры.НеизвестныйПартнер;
		КонецЕсли;
	КонецЕсли;
	
	// Оплаты ККМ
	Если ДанныеXDTO.Свойство("ОплатыККМ")
		И ЗначениеЗаполнено(ДанныеXDTO.ОплатыККМ) Тогда
		
		Для каждого Строка Из ДанныеXDTO.ОплатыККМ Цикл
			Если  Строка.ТипОплаты <> Неопределено Тогда
				Если Строка.ТипОплаты.Значение = "Наличные" Тогда
					ПолученныеДанные.ПолученоНаличными = Строка.Сумма;
				ИначеЕсли Строка.ТипОплаты.Значение = "Электронно" Тогда
					НоваяСтрока = ПолученныеДанные.ОплатаПлатежнымиКартами.Добавить();
					НоваяСтрока.ВидОплаты = Перечисления.ТипыПлатежнойСистемыККТ.ПлатежнаяКарта;
					НоваяСтрока.ЭквайринговыйТерминал = ЭлементПоУмолчанию(КомпонентыОбмена, "ЭквайринговыйТерминал");
					НоваяСтрока.Сумма = Строка.Сумма;
				ИначеЕсли Строка.ТипОплаты.Значение = "Предоплата" Тогда  
					НоваяСтрока = ПолученныеДанные.ОплатаПлатежнымиКартами.Добавить();
					НоваяСтрока.Сумма = Строка.Сумма; 
				КонецЕсли; 
			Иначе
				НоваяСтрока = ПолученныеДанные.ОплатаПлатежнымиКартами.Добавить();
				НоваяСтрока.Сумма = Строка.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		Если ДанныеXDTO.ОплатыККМ.Количество() = 1 
			И ДанныеXDTO.ОплатыККМ[0].ТипОплаты <> Неопределено Тогда
			ТипыОплатыККТ = ПКПДПоИмени(КомпонентыОбмена, "Перечисление_ТипыОплатыККТ").КонвертацииЗначенийПриПолучении.Получить(ДанныеXDTO.ОплатыККМ[0].ТипОплаты.Значение);
			Если ТипыОплатыККТ = Перечисления.ТипыОплатыККТ.Наличные Тогда
				ПолученныеДанные.ФормаОплаты = Перечисления.ФормыОплаты.Наличная;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Скидки = Новый Соответствие;
	НачисленныеБонусы = Новый Соответствие;
	
	МассивСтрокНачисленныеБонусы = Новый Массив;
	МассивСтрокТовары = Новый Массив;
	МассивСтрокСкидки = Новый Массив;
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") 
		И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
			И ДанныеXDTO.AdditionalInfo.Свойство("ПримененныеСкидки") Тогда
			Скидки = ДанныеXDTO.AdditionalInfo.ПримененныеСкидки;
		КонецЕсли;
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
			И ДанныеXDTO.AdditionalInfo.Свойство("НачисленныеБонусы") Тогда 
			НачисленныеБонусы = ДанныеXDTO.AdditionalInfo["НачисленныеБонусы"]; 
		КонецЕсли;
	КонецЕсли;
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура",  "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",    "Количество");
	ПравилаЗаполнения.Вставить("Сумма",         "Сумма");
	ПравилаЗаполнения.Вставить("Цена",          "Цена");
	ПравилаЗаполнения.Вставить("СтавкаНДС",     "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС",      "СуммаНДС");
	ПравилаЗаполнения.Вставить("ПроцентРучнойСкидки", "ПроцентРучнойСкидки");
	ПравилаЗаполнения.Вставить("СуммаРучнойСкидки", "СуммаРучнойСкидки");
	ПравилаЗаполнения.Вставить("ПроцентАвтоматическойСкидки", "ПроцентАвтоматическойСкидки");
	ПравилаЗаполнения.Вставить("СуммаАвтоматическойСкидки", "СуммаАвтоматическойСкидки");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	
	Если ЗначениеФО("ИспользоватьБонусныеПрограммыЛояльности", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("СуммаБонусныхБалловКСписаниюВВалюте", "СуммаБонусныхБалловКСписаниюВВалюте");
		ПравилаЗаполнения.Вставить("СуммаНачисленныхБонусныхБалловВВалюте", "СуммаНачисленныхБонусныхБалловВВалюте");
	КонецЕсли;
	
	КлючСвязи = 0;
	Если ДанныеXDTO.Свойство("ТоварыПродажа")
		И ЗначениеЗаполнено(ДанныеXDTO.ТоварыПродажа) Тогда
		
		Для Каждого Строка Из ДанныеXDTO.ТоварыПродажа Цикл
			КлючСвязи = КлючСвязи + 1;
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			СтруктураДанныхСтроки.Вставить("КлючСвязи", КлючСвязи);
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
			Если НЕ СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
				СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("Сумма") Тогда
				СтруктураДанныхСтроки.Вставить("Цена", СтруктураДанныхСтроки.Сумма / СтруктураДанныхСтроки.КоличествоУпаковок);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("Продавец", ПолученныеДанные.Кассир);
			Если ДанныеXDTO.Свойство("СкидкиНаценки")
				И ЗначениеЗаполнено(ДанныеXDTO.СкидкиНаценки) Тогда
				НайденныеСкидки = ДанныеXDTO.СкидкиНаценки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки));
				Для каждого СтрокаСкидкаНаценка Из НайденныеСкидки Цикл
					Если СтрокаСкидкаНаценка.ВидСкидки.Значение = "Бонус" Тогда
						СтруктураДанныхСтроки.Вставить("СуммаБонусныхБалловКСписаниюВВалюте", СтрокаСкидкаНаценка.СуммаСкидки);
					ИначеЕсли СтрокаСкидкаНаценка.ВидСкидки.Значение = "Дисконтная" Тогда
						СтруктураДанныхСтроки.Вставить("ПроцентАвтоматическойСкидки", СтрокаСкидкаНаценка.ПроцентСкидки);
						СтруктураДанныхСтроки.Вставить("СуммаАвтоматическойСкидки", СтрокаСкидкаНаценка.СуммаСкидки);
					ИначеЕсли СтрокаСкидкаНаценка.ВидСкидки.Значение = "НаТовар" Тогда
						СтруктураДанныхСтроки.Вставить("ПроцентРучнойСкидки", СтрокаСкидкаНаценка.ПроцентСкидки);
						СтруктураДанныхСтроки.Вставить("СуммаРучнойСкидки", СтрокаСкидкаНаценка.СуммаСкидки);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ДанныеНачисленныхБонусов = НачисленныеБонусы.Получить(Строка.ИдентификаторСтроки);
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
				И ДанныеНачисленныхБонусов <> Неопределено Тогда
				
				СуммаДанныхСтроки = 0;
				СтруктураДанныхСтроки.Свойство("СуммаНачисленныхБонусныхБалловВВалюте", СуммаДанныхСтроки);
				СтруктураДанныхСтроки.Вставить("СуммаНачисленныхБонусныхБалловВВалюте", 
					?(СуммаДанныхСтроки = Неопределено, 0, СуммаДанныхСтроки) + ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);// @Non-NLS-1
				
				НачисленныеБонусыСтруктура = Новый Структура;
				БонуснаяПрограмма = Справочники.БонусныеПрограммыЛояльности.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеНачисленныхБонусов.БонуснаяПрограмма));// @Non-NLS-1
				Если ОбщегоНазначения.СсылкаСуществует(БонуснаяПрограмма) Тогда
					НачисленныеБонусыСтруктура.Вставить("БонуснаяПрограммаЛояльности", БонуснаяПрограмма);
					НачисленныеБонусыСтруктура.Вставить("ДатаНачисления", ДанныеНачисленныхБонусов.ДатаНачисления);// @Non-NLS-1
					НачисленныеБонусыСтруктура.Вставить("СуммаБонусныхБаллов", ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);// @Non-NLS-1
					МассивСтрокНачисленныеБонусы.Добавить(НачисленныеБонусыСтруктура);
				КонецЕсли;
			КонецЕсли;
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
				КоллекцияНачисленныеБонусыИмя = "НачисленныеБонусы";
				Если ДанныеXDTO.Свойство(КоллекцияНачисленныеБонусыИмя) 
					И ЗначениеЗаполнено(ДанныеXDTO[КоллекцияНачисленныеБонусыИмя]) Тогда
					ДанныеНачисленныхБонусов =  ДанныеXDTO[КоллекцияНачисленныеБонусыИмя].Найти(Строка.ИдентификаторСтроки, "ИдентификаторСтроки");
					Если ДанныеНачисленныхБонусов <> Неопределено Тогда
						СуммаДанныхСтроки = 0;
						СтруктураДанныхСтроки.Свойство("СуммаНачисленныхБонусныхБалловВВалюте", СуммаДанныхСтроки);
						СтруктураДанныхСтроки.Вставить("СуммаНачисленныхБонусныхБалловВВалюте", 
							?(СуммаДанныхСтроки = Неопределено, 0, СуммаДанныхСтроки) + ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);
					КонецЕсли; 
				КонецЕсли;
			КонецЕсли;
			ДанныеСкидки = Скидки.Получить(Строка.ИдентификаторСтроки);
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
				И ДанныеСкидки <> Неопределено Тогда
				СкидкаСтруктура = Новый Структура;
				
				ИдентификаторСкидки = Новый УникальныйИдентификатор(ДанныеСкидки.СкидкаНаценка);
				СкидкаСсылка = Справочники.СкидкиНаценки.ПолучитьСсылку(ИдентификаторСкидки);
				
				Если ОбщегоНазначения.СсылкаСуществует(СкидкаСсылка) Тогда
					СкидкаСтруктура.Вставить("КлючСвязи", КлючСвязи);
					СкидкаСтруктура.Вставить("СкидкаНаценка", СкидкаСсылка);
					СкидкаСтруктура.Вставить("Сумма", ДанныеСкидки.Сумма);
					
					МассивСтрокСкидки.Добавить(СкидкаСтруктура);
				КонецЕсли;
			КонецЕсли;
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.19") Тогда
				Комитент = Неопределено;
				Если ЗначениеЗаполнено(Строка.Поставщик)
					И ЗначениеЗаполнено(Строка.Поставщик.Ссылка)
					И ЗначениеЗаполнено(Строка.Поставщик.Ссылка.Значение)
					И СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Строка.Поставщик.Ссылка.Значение) Тогда
					СсылкаИД = Новый УникальныйИдентификатор(Строка.Поставщик.Ссылка.Значение);
					Если ОбщегоНазначения.СсылкаСуществует(Справочники.Контрагенты.ПолучитьСсылку(СсылкаИД)) Тогда
						Комитент = Справочники.Контрагенты.ПолучитьСсылку(СсылкаИД);
					ИначеЕсли ОбщегоНазначения.СсылкаСуществует(Справочники.Организации.ПолучитьСсылку(СсылкаИД)) Тогда
						Комитент = Справочники.Организации.ПолучитьСсылку(СсылкаИД);
					КонецЕсли;
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("Комитент", Комитент);
			КонецЕсли;
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	// Услуги загружаются в ТЧ Товары
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда
		
		Для Каждого Строка Из ДанныеXDTO.Услуги Цикл
			КлючСвязи = КлючСвязи + 1;
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			СтруктураДанныхСтроки.Вставить("КлючСвязи", КлючСвязи);
			СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			СтруктураДанныхСтроки.Вставить("Продавец", ПолученныеДанные.Кассир);
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
			Если ДанныеXDTO.Свойство("СкидкиНаценки")
				И ЗначениеЗаполнено(ДанныеXDTO.СкидкиНаценки) Тогда
				НайденныеСкидки = ДанныеXDTO.СкидкиНаценки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки));
				Для каждого СтрокаСкидкаНаценка Из НайденныеСкидки Цикл
					Если СтрокаСкидкаНаценка.ВидСкидки.Значение = "Бонус" Тогда
						СтруктураДанныхСтроки.Вставить("СуммаБонусныхБалловКСписаниюВВалюте", СтрокаСкидкаНаценка.СуммаСкидки);
					ИначеЕсли СтрокаСкидкаНаценка.ВидСкидки.Значение = "Дисконтная" Тогда
						СтруктураДанныхСтроки.Вставить("ПроцентАвтоматическойСкидки", СтрокаСкидкаНаценка.ПроцентСкидки);
						СтруктураДанныхСтроки.Вставить("СуммаАвтоматическойСкидки", СтрокаСкидкаНаценка.СуммаСкидки);
					ИначеЕсли СтрокаСкидкаНаценка.ВидСкидки.Значение = "НаТовар" Тогда
						СтруктураДанныхСтроки.Вставить("ПроцентРучнойСкидки", СтрокаСкидкаНаценка.ПроцентСкидки);
						СтруктураДанныхСтроки.Вставить("СуммаРучнойСкидки", СтрокаСкидкаНаценка.СуммаСкидки);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ДанныеНачисленныхБонусов = НачисленныеБонусы.Получить(Строка.ИдентификаторСтроки);
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
				И ДанныеНачисленныхБонусов <> Неопределено Тогда
				
				СуммаДанныхСтроки = 0;
				СтруктураДанныхСтроки.Свойство("СуммаНачисленныхБонусныхБалловВВалюте", СуммаДанныхСтроки);
				СтруктураДанныхСтроки.Вставить("СуммаНачисленныхБонусныхБалловВВалюте", 
					?(СуммаДанныхСтроки = Неопределено, 0, СуммаДанныхСтроки) + ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);
				
				НачисленныеБонусыСтруктура = Новый Структура;
				БонуснаяПрограмма = Справочники.БонусныеПрограммыЛояльности.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеНачисленныхБонусов.БонуснаяПрограмма));
				Если ОбщегоНазначения.СсылкаСуществует(БонуснаяПрограмма) Тогда
					НачисленныеБонусыСтруктура.Вставить("БонуснаяПрограммаЛояльности", БонуснаяПрограмма);
					НачисленныеБонусыСтруктура.Вставить("ДатаНачисления", ДанныеНачисленныхБонусов.ДатаНачисления);
					НачисленныеБонусыСтруктура.Вставить("СуммаБонусныхБаллов", ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);
					МассивСтрокНачисленныеБонусы.Добавить(НачисленныеБонусыСтруктура);
				КонецЕсли;
			КонецЕсли;
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
				КоллекцияНачисленныеБонусыИмя = "НачисленныеБонусы";
				Если ДанныеXDTO.Свойство(КоллекцияНачисленныеБонусыИмя) 
					И ЗначениеЗаполнено(ДанныеXDTO[КоллекцияНачисленныеБонусыИмя]) Тогда
					ДанныеНачисленныхБонусов =  ДанныеXDTO[КоллекцияНачисленныеБонусыИмя].Найти(Строка.ИдентификаторСтроки, "ИдентификаторСтроки");
					Если ДанныеНачисленныхБонусов <> Неопределено Тогда
						СуммаДанныхСтроки = 0;
						СтруктураДанныхСтроки.Свойство("СуммаНачисленныхБонусныхБалловВВалюте", СуммаДанныхСтроки);
						СтруктураДанныхСтроки.Вставить("СуммаНачисленныхБонусныхБалловВВалюте", 
							?(СуммаДанныхСтроки = Неопределено, 0, СуммаДанныхСтроки) + ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);
					КонецЕсли; 
				КонецЕсли;
			КонецЕсли;
			ДанныеСкидки = Скидки.Получить(Строка.ИдентификаторСтроки);
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
				И ДанныеСкидки <> Неопределено Тогда
				СкидкаСтруктура = Новый Структура;
				
				ИдентификаторСкидки = Новый УникальныйИдентификатор(ДанныеСкидки.СкидкаНаценка);
				СкидкаСсылка = Справочники.СкидкиНаценки.ПолучитьСсылку(ИдентификаторСкидки);
				
				Если ОбщегоНазначения.СсылкаСуществует(СкидкаСсылка) Тогда
					СкидкаСтруктура.Вставить("КлючСвязи", КлючСвязи);
					СкидкаСтруктура.Вставить("СкидкаНаценка", СкидкаСсылка);
					СкидкаСтруктура.Вставить("Сумма", ДанныеСкидки.Сумма);
					
					МассивСтрокСкидки.Добавить(СкидкаСтруктура);
				КонецЕсли;
			КонецЕсли;
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокТовары.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17")
		И ДанныеXDTO.Свойство("НачисленныеБонусы") И ЗначениеЗаполнено(ДанныеXDTO.НачисленныеБонусы) Тогда
		ПоляКоллекции = Новый Структура;	// ключ - поле тч; значение - поле коллекции XDTO
		ПоляКоллекции.Вставить("БонуснаяПрограммаЛояльности",	"БонуснаяПрограмма");
		ПоляКоллекции.Вставить("ДатаНачисления", 				"ДатаНачалаДействия");
		ПоляКоллекции.Вставить("ДатаСписания", 					"ДатаОкончанияДействия");
		ПоляКоллекции.Вставить("СуммаБонусныхБаллов", 			"КоличествоБонусныхБаллов");
		Для каждого ЭлемБонус Из ДанныеXDTO.НачисленныеБонусы Цикл
			Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭлемБонус, "БонуснаяПрограмма")
				ИЛИ НЕ ЗначениеЗаполнено(ЭлемБонус.БонуснаяПрограмма) 
				ИЛИ  ЭлемБонус.БонуснаяПрограмма.ТипЗначения <> "ПрограммыЛояльности" Тогда	//@NON-NLS-2
				Продолжить;
			КонецЕсли;
			БонусыСтруктура = Новый Структура;
			Для каждого ЭлемПоле Из ПоляКоллекции Цикл
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭлемБонус, ЭлемПоле.Значение) Тогда
					БонусыСтруктура.Вставить(ЭлемПоле.Ключ, ЭлемБонус[ЭлемПоле.Значение]);
				КонецЕсли;
			КонецЦикла;
			МассивСтрокНачисленныеБонусы.Добавить(БонусыСтруктура);
		КонецЦикла;
	КонецЕсли;
	Если МассивСтрокНачисленныеБонусы.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("БонусныеБаллы", МассивСтрокНачисленныеБонусы);
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17")
		И ДанныеXDTO.Свойство("СкидкиНаценки") И ЗначениеЗаполнено(ДанныеXDTO.СкидкиНаценки) Тогда
		Для каждого ЭлемСкидкаНаценка Из ДанныеXDTO.СкидкиНаценки Цикл
			Если ЭлемСкидкаНаценка.ВидСкидки.Значение = "НаТовар"
				ИЛИ ЭлемСкидкаНаценка.ВидСкидки.Значение = "Бонус" Тогда
				// ручная скидка и оплата бонусом фиксируюся только в тч.Товары
				Продолжить;
			КонецЕсли;
			СкидкаСтруктура = Новый Структура;
			СкидкаСтруктура.Вставить("КлючСвязи", ЭлемСкидкаНаценка.ИдентификаторСтроки);
			СкидкаСтруктура.Вставить("СкидкаНаценка", ЭлемСкидкаНаценка.СкидкаНадбавка);
			СкидкаСтруктура.Вставить("Сумма", ЭлемСкидкаНаценка.СуммаСкидки);
			МассивСтрокСкидки.Добавить(СкидкаСтруктура);
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокСкидки.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("СкидкиНаценки", МассивСтрокСкидки);
	КонецЕсли;
	//Оплата платежными картами
	МассивСтрокОплатаПК = Новый Массив;
	
	Если ДанныеXDTO.Свойство("ОплатаПлатежнымиКартами")
		И ЗначениеЗаполнено(ДанныеXDTO.ОплатаПлатежнымиКартами) Тогда
		
		Для Каждого Строка Из ДанныеXDTO.ОплатаПлатежнымиКартами Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("Сумма", Строка.СуммаОплаты);
			СтруктураДанныхСтроки.Вставить("НомерПлатежнойКарты", Строка.НомерКарты);
		    Если ЗначениеЗаполнено(Строка.ЭквайринговыйТерминал) Тогда
				спрЭквайринговыйТерминал = Строка.ЭквайринговыйТерминал;
				Если спрЭквайринговыйТерминал.Свойство("Номер") И Не Пустаястрока(спрЭквайринговыйТерминал.Номер) Тогда	
					Инструкция = Новый Структура;
					Инструкция.Вставить("Значение", Строка.ЭквайринговыйТерминал);
					Инструкция.Вставить("ИмяПКО", "Справочник_ЭквайринговыеТерминалы_Получение");
			
					СтруктураДанныхСтроки.Вставить("ЭквайринговыйТерминал", Инструкция);
				КонецЕсли; 
			КонецЕсли;	
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.11") Тогда  
				СтруктураДанныхСтроки.Вставить("ВидОплаты", Строка.ТипыПлатежнойСистемыККТ);
			КонецЕсли;
			
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.18") Тогда  
				СтруктураДанныхСтроки.Вставить("СсылочныйНомер", Строка.ИдентификаторОплатыПлатежныхСистем);
				ТекДоговор = Строка.ДоговорЭквайрера;	// Структура
				Если ЗначениеЗаполнено(ТекДоговор)
					И ЗначениеЗаполнено(ТекДоговор.Ссылка) Тогда
					ДоговорИД = ТекДоговор.Ссылка.Значение;
					СсылкаДоговора = Справочники.ДоговорыЭквайринга.ПолучитьСсылку(Новый УникальныйИдентификатор(ДоговорИД));
					СтруктураДанныхСтроки.Вставить("ДоговорПодключения", СсылкаДоговора);
				КонецЕсли;
			КонецЕсли;
			
			МассивСтрокОплатаПК.Добавить(СтруктураДанныхСтроки);
		
		КонецЦикла;
		
		Если ДанныеXDTO.ОплатаПлатежнымиКартами.Итог("СуммаОплаты") = ДанныеXDTO.ОплатыККМ.Итог("Сумма") Тогда
			ПолученныеДанные.ФормаОплаты = Перечисления.ФормыОплаты.ПлатежнаяКарта;
		КонецЕсли;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ОплатаПлатежнымиКартами", МассивСтрокОплатаПК);
	КонецЕсли;
	
	//Подарочные сертификаты
	МассивСтрокПС = Новый Массив; 
	
	Если ДанныеXDTO.Свойство("ОплатаСертификатами")
		И ЗначениеЗаполнено(ДанныеXDTO.ОплатаСертификатами) Тогда
		
		Для каждого Строка Из ДанныеXDTO.ОплатаСертификатами Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("Сумма", Строка.Сумма);
			
			Если ЗначениеЗаполнено(Строка.Штрихкод) Тогда
				// Готовим инструкцию для конвертации подарочного сертификата.
				Инструкция = Новый Структура;
				СтруктураПодарочногоСертификата = Новый Структура;
				СтруктураПодарочногоСертификата.Вставить("Штрихкод", Строка.Штрихкод);
				СтруктураПодарочногоСертификата.Вставить("МагнитныйКод", Строка.МагнитныйКод);
				СтруктураПодарочногоСертификата.Вставить("СерийныйНомер", Строка.СерийныйНомер);
			
				Инструкция.Вставить("ИмяПКО", "Справочник_ПодарочныеСертификаты");
				СтруктураПодарочногоСертификата.Вставить("ВидПодарочногоСертификата", Строка.ВидПодарочногоСертификата);
					
				Инструкция.Вставить("Значение", СтруктураПодарочногоСертификата);
				СтруктураДанныхСтроки.Вставить("ПодарочныйСертификат", Инструкция);
			Конецесли;
			МассивСтрокПС.Добавить(СтруктураДанныхСтроки);
		
		КонецЦикла;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ПодарочныеСертификаты", МассивСтрокПС);	
	КонецЕсли;
	//++ Локализация
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
		И ДанныеXDTO.Свойство("АкцизныеМарки")
		И ЗначениеЗаполнено(ДанныеXDTO.АкцизныеМарки) Тогда
		МассивСтрокАМ = Новый Массив;
		Для каждого Строка Из ДанныеXDTO.АкцизныеМарки Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("НомерСтрокиДокумента", Строка.НомерСтрокиДокумента); 
			СтруктураДанныхСтроки.Вставить("НомерАкцизнойМарки", Строка.НомерАкцизнойМарки);
			СтруктураДанныхСтроки.Вставить("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
			МассивСтрокАМ.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		ПолученныеДанные.ДополнительныеСвойства.Вставить("тчАкцизныеМарки", МассивСтрокАМ); 
	КонецЕсли;	
	//-- Локализация
	
	// Штрихкоды упаковок.
	ЗагрузитьШтрихкодыУпаковок(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена, "АкцизныеМарки", "АкцизнаяМарка");
	ДополнитьЧекДополнительнойИнформацией(ДанныеXDTO, ПолученныеДанные);
КонецПроцедуры
Процедура ПКО_Документ_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗаполнитьСкладПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
								ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
								
	НомерКассовойСмены = ПолученныеДанные.ДополнительныеСвойства.НомерКассовойСмены;
	Если ЗначениеЗаполнено(ПолученныеДанные.КартаЛояльности) Тогда
		ВыборкаБонуснаяПрограммаЛояльности = БонусныеБаллыСервер.БонуснаяПрограммаКартыЛояльности(ПолученныеДанные.КартаЛояльности);
		БонуснаяПрограммаЛояльности = ВыборкаБонуснаяПрограммаЛояльности.БонуснаяПрограммаЛояльности;
		ВалютаДокумента = ПолученныеДанные.Валюта;
		ВалютаБонуснойПрограммы = ВыборкаБонуснаяПрограммаЛояльности.Валюта;
		СтруктураКурсовВалютыДокумента = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ВалютаДокумента, ПолученныеДанные.Дата);
		СтруктураКурсовВалютыБонуснойПрограммы = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ВалютаБонуснойПрограммы, ПолученныеДанные.Дата);
		КурсКонвертацииБонусовВВалюту = ВыборкаБонуснаяПрограммаЛояльности.КурсКонвертацииБонусовВВалюту;
		Для каждого Строка Из ПолученныеДанные.Товары Цикл
			Если Строка.СуммаБонусныхБалловКСписаниюВВалюте <> 0 И КурсКонвертацииБонусовВВалюту <> 0 Тогда
				Строка.СуммаБонусныхБалловКСписанию = РаботаСКурсамиВалютУТ.ПересчитатьПоКурсу(
					Строка.СуммаБонусныхБалловКСписаниюВВалюте / КурсКонвертацииБонусовВВалюту,
					СтруктураКурсовВалютыДокумента,
					СтруктураКурсовВалютыБонуснойПрограммы);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// В случае наличия объекта в базе он и будет записан (а не ПолученныеДанные).
	// Шапка и табличная часть предварительно переносятся из ПолученныеДанные в ДанныеИБ:
	// шапка - в составе свойств из ПКС, табличная часть - полностью берется из полученных данных.
	Если ДанныеИБ <> Неопределено Тогда
		ДанныеИБСклад = ДанныеИБ.Склад;
	
		// Переносим те свойства, которые указаны в ПКС.
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		Если НЕ КомпонентыОбмена.ПараметрыКонвертации.ВыгружатьАналитикуПоСкладам Тогда
			// Восстанавливаем склад из первоначального документа.
			ДанныеИБ.Склад = ДанныеИБСклад;
		КонецЕсли;
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
		ДанныеИБ.ОплатаПлатежнымиКартами.Загрузить(ПолученныеДанные.ОплатаПлатежнымиКартами.Выгрузить());
		ДанныеИБ.ПодарочныеСертификаты.Загрузить(ПолученныеДанные.ПодарочныеСертификаты.Выгрузить());
		ДанныеИБ.БонусныеБаллы.Загрузить(ПолученныеДанные.БонусныеБаллы.Выгрузить());
		ДанныеИБ.СкидкиНаценки.Загрузить(ПолученныеДанные.СкидкиНаценки.Выгрузить());
	    //++ Локализация
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
			ДанныеИБ.АкцизныеМарки.Загрузить(ПолученныеДанные.АкцизныеМарки.Выгрузить());
		КонецЕсли;
	    Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
			И ПолученныеДанные.ДополнительныеСвойства.Свойство("АкцизныеМарки") И ДанныеИБ.АкцизныеМарки.Количество() = 0 Тогда
		     тчАкцизныеМарки = ПолученныеДанные.ДополнительныеСвойства.тчАкцизныеМарки;
			 Для каждого Строка Из тчАкцизныеМарки Цикл
			     НовСтрока = ДанныеИБ.АкцизныеМарки.Добавить();
			 	 НовСтрока.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
			     НовСтрока.КодАкцизнойМарки = Строка.НомерАкцизнойМарки;
				 НовСтрока.АкцизнаяМарка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", Строка.НомерАкцизнойМарки);
			 КонецЦикла;
		 КонецЕсли; 
	    //-- Локализация
		ПолученныеДанные   = Неопределено;
		ДанныеДляЗаписиВИБ = ДанныеИБ;
	Иначе
		ДанныеДляЗаписиВИБ = ПолученныеДанные;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.КассоваяСмена) Тогда
		
		ДокументыСПодарочнымиСертификатами = КомпонентыОбмена.ПараметрыКонвертации.ДокументыСПодарочнымиСертификатами; // ТаблицаЗначений
			
		НоваяСтрока = ДокументыСПодарочнымиСертификатами.Добавить();
		НоваяСтрока.ДокументСсылка      = ?(ДанныеИБ = Неопределено, ДанныеДляЗаписиВИБ.ПолучитьСсылкуНового(), ДанныеДляЗаписиВИБ.Ссылка);
		НоваяСтрока.ДатаДокумента       = ДанныеДляЗаписиВИБ.Дата;
		НоваяСтрока.ОчередьДокумента    = 0;
		НоваяСтрока.КассаККМ            = ДанныеДляЗаписиВИБ.КассаККМ;
		НоваяСтрока.НомерКассовойСмены  = НомерКассовойСмены;
		
	КонецЕсли;
	
	Если ДанныеДляЗаписиВИБ.Товары.Количество() > 0 Тогда
		Для Каждого СтрокаТовары Из ДанныеДляЗаписиВИБ.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТовары.Серия) Тогда
				СтрокаСерия = ДанныеДляЗаписиВИБ.Серии.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСерия, СтрокаТовары);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрокаОплаты Из ДанныеДляЗаписиВИБ.ОплатаПлатежнымиКартами Цикл
		Если Не ЗначениеЗаполнено(СтрокаОплаты.ЭквайринговыйТерминал) Тогда
			СтрокаОплаты.ЭквайринговыйТерминал = Справочники.ЭквайринговыеТерминалы.ЭквайринговыйТерминалПоУмолчанию(ДанныеДляЗаписиВИБ.Организация);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьПКО_Документ_ЧекККМВозврат_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_ЧекККМВозврат_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ЧекККМВозврат;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ЧекККМ"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_ЧекККМВозврат_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_ЧекККМВозврат_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_ОтчетОРозничныхПродажах";
	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Валюта",                       "", 1);
	ДобавитьПКС(СвойстваШапки, "Дата",                         "Дата");
	ДобавитьПКС(СвойстваШапки, "КартаЛояльности",              "КартаЛояльности", , "Справочник_ДисконтныеКарты_Получение");
	ДобавитьПКС(СвойстваШапки, "КассаККМ",                     "КассаККМ", , "Справочник_КассыККМ_Получение");
	ДобавитьПКС(СвойстваШапки, "Кассир",                       "Кассир", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "НалогообложениеНДС",           "Налогообложение", , "НалогообложениеНДС");
	ДобавитьПКС(СвойстваШапки, "Номер",                        "НомерВПрограмме");
	ДобавитьПКС(СвойстваШапки, "",                             "НомерКассовойСмены", 1);
	ДобавитьПКС(СвойстваШапки, "НомерЧекаККМ",                 "НомерЧекаККМ");
	ДобавитьПКС(СвойстваШапки, "Организация",                  "", 1);
	ДобавитьПКС(СвойстваШапки, "Партнер",                      "Контрагент", , "Справочник_ПартнерИзКонтрагента_Получение");
	ДобавитьПКС(СвойстваШапки, "Склад",                        "", 1, "Справочник_Склады_Получение");
	ДобавитьПКС(СвойстваШапки, "СуммаБонусныхБалловКВозврату", "", 1);
	ДобавитьПКС(СвойстваШапки, "СуммаДокумента",               "Сумма");
	ДобавитьПКС(СвойстваШапки, "ЧекККМ",                       "Основание", , "Документ_ЧекККМ_Получение");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "АкцизныеМарки",           "");
	ДобавитьПКС(СвойстваТЧ, "АкцизнаяМарка", "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "БонусныеБаллы",           "");
	ДобавитьПКС(СвойстваТЧ, "БонуснаяПрограммаЛояльности", "", 1, "Справочник_ПрограммыЛояльности");
	ДобавитьПКС(СвойстваТЧ, "ДатаНачисления",              "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаБонусныхБаллов",         "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ОплатаПлатежнымиКартами", "");
	ДобавитьПКС(СвойстваТЧ, "ВидОплаты",             "", 1, "ТипыПлатежнойСистемыККТ");
	ДобавитьПКС(СвойстваТЧ, "ДоговорПодключения",    "ДоговорЭквайрера", 1);
	ДобавитьПКС(СвойстваТЧ, "НомерПлатежнойКарты",   "", 1);
	ДобавитьПКС(СвойстваТЧ, "Сумма",                 "", 1);
	ДобавитьПКС(СвойстваТЧ, "ЭквайринговыйТерминал", "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "Товары",                  "");
	ДобавитьПКС(СвойстваТЧ, "Количество",         "", 1);
	ДобавитьПКС(СвойстваТЧ, "КоличествоУпаковок", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Номенклатура",       "", 1, "Справочник_Номенклатура_Получение");
	ДобавитьПКС(СвойстваТЧ, "Продавец",           "", 1);
	ДобавитьПКС(СвойстваТЧ, "Серия",              "", 1, "Справочник_СерииНоменклатуры");
	ДобавитьПКС(СвойстваТЧ, "СтавкаНДС",          "", 1);
	ДобавитьПКС(СвойстваТЧ, "Сумма",              "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаНДС",           "", 1);
	ДобавитьПКС(СвойстваТЧ, "Упаковка",           "", 1, "Справочник_Упаковки");
	ДобавитьПКС(СвойстваТЧ, "Характеристика",     "", 1, "Справочник_ХарактеристикиНоменклатуры");
	ДобавитьПКС(СвойстваТЧ, "Цена",               "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("Дата,КассаККМ,Номер,Организация");
КонецПроцедуры
Процедура ПКО_Документ_ЧекККМВозврат_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	
	ЗаполнитьРеквизитыЧекаККМ(ПолученныеДанные);
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Склад) Тогда  
		Если НЕ КомпонентыОбмена.ПараметрыКонвертации.ВидыЦенНоменклатуры = Неопределено 
			 И КомпонентыОбмена.ПараметрыКонвертации.ВидыЦенНоменклатуры.Количество() > 0 Тогда
		     ПолученныеДанные.ВидЦены = КомпонентыОбмена.ПараметрыКонвертации.ВидыЦенНоменклатуры[0].Значение; 
		КонецЕсли;
		Если ЗначениеЗаполнено(КомпонентыОбмена.ПараметрыКонвертации.СкладПоУмолчанию)
			И КомпонентыОбмена.ПараметрыКонвертации.СкладПоУмолчанию.ТипСклада = ПредопределенноеЗначение("Перечисление.ТипыСкладов.РозничныйМагазин") Тогда
		     ПолученныеДанные.Склад = КомпонентыОбмена.ПараметрыКонвертации.СкладПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьНалогообложениеНДСПоПолученнымДанным(КомпонентыОбмена, ПолученныеДанные, ДанныеXDTO, Ложь);
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	ЗаполнитьКассовуюСменуПоНомеруИКассеККМ(ПолученныеДанные, ПолученныеДанные.КассаККМ, ДанныеXDTO.КлючевыеСвойства.НомерКассовойСмены);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("НомерКассовойСмены", ДанныеXDTO.КлючевыеСвойства.НомерКассовойСмены);
	
	ПолученныеДанные.Статус = Перечисления.СтатусыЧековККМ.Пробит;
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Партнер) Тогда
		ПолученныеДанные.Партнер = Справочники.Партнеры.НеизвестныйПартнер;
	КонецЕсли;
	
	// Оплаты ККМ
	Если ДанныеXDTO.Свойство("ОплатыККМ")
		И ЗначениеЗаполнено(ДанныеXDTO.ОплатыККМ) Тогда
		
		Для каждого Строка Из ДанныеXDTO.ОплатыККМ Цикл
			Если  Строка.ТипОплаты <> Неопределено Тогда
				Если Строка.ТипОплаты.Значение = "Наличные" Тогда
					ПолученныеДанные.ВыданоНаличными = Строка.Сумма;
				ИначеЕсли Строка.ТипОплаты.Значение = "Электронно" Тогда
					НоваяСтрока = ПолученныеДанные.ОплатаПлатежнымиКартами.Добавить();
					НоваяСтрока.ВидОплаты = Перечисления.ТипыПлатежнойСистемыККТ.ПлатежнаяКарта;
					НоваяСтрока.ЭквайринговыйТерминал = ЭлементПоУмолчанию(КомпонентыОбмена, "ЭквайринговыйТерминал");
					НоваяСтрока.Сумма = Строка.Сумма; 
					НоваяСтрока.ОплатаОтменена = Истина;
				КонецЕсли; 
			Иначе
				НоваяСтрока = ПолученныеДанные.ОплатаПлатежнымиКартами.Добавить();
				НоваяСтрока.Сумма = Строка.Сумма;
				НоваяСтрока.ОплатаОтменена = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	НачисленныеБонусы = Новый Соответствие;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
		И ДанныеXDTO.Свойство("AdditionalInfo")  
		И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда
		Если ДанныеXDTO.AdditionalInfo.Свойство("НачисленныеБонусы") Тогда //@NON-NLS-1
			НачисленныеБонусы = ДанныеXDTO.AdditionalInfo["НачисленныеБонусы"]; //@NON-NLS-1
		КонецЕсли;
	КонецЕсли;
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура",  "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",    "Количество");
	ПравилаЗаполнения.Вставить("Сумма",         "Сумма");
	ПравилаЗаполнения.Вставить("Цена",          "Цена");
	ПравилаЗаполнения.Вставить("СтавкаНДС",     "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС",      "СуммаНДС");
	ПравилаЗаполнения.Вставить("ПроцентСкидки", "ПроцентРучнойСкидки");
	ПравилаЗаполнения.Вставить("СуммаСкидки",   "СуммаРучнойСкидки");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	
	МассивСтрокТовары = Новый Массив;
	МассивСтрокНачисленныеБонусы = Новый Массив;
	Если ДанныеXDTO.Свойство("ТоварыВозвратПродажи")
		И ЗначениеЗаполнено(ДанныеXDTO.ТоварыВозвратПродажи) Тогда
		
		ТоварыВозвратПродажи = ДанныеXDTO.ТоварыВозвратПродажи.СкопироватьКолонки();
		
		Для Каждого Строка Из ДанныеXDTO.ТоварыВозвратПродажи Цикл
				
			Если ЗначениеЗаполнено(Строка.СтавкаНДС) Тогда
				Строка.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, Строка.СтавкаНДС);
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.КоличествоУпаковок) И ЗначениеЗаполнено(Строка.Упаковка) Тогда
				Строка.Цена = Строка.Сумма / Строка.КоличествоУпаковок;
			Иначе
				Строка.КоличествоУпаковок = Строка.Количество;
			КонецЕсли;
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если НЕ СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
				СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("Продавец", ПолученныеДанные.Кассир);
			ДанныеНачисленныхБонусов = НачисленныеБонусы.Получить(Строка.ИдентификаторСтроки);
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17")
				И ДанныеНачисленныхБонусов <> Неопределено Тогда
				
				СуммаДанныхСтроки = 0;
				СтруктураДанныхСтроки.Свойство("СуммаНачисленныхБонусныхБалловВВалюте", СуммаДанныхСтроки);
				СтруктураДанныхСтроки.Вставить("СуммаНачисленныхБонусныхБалловВВалюте", 
					?(СуммаДанныхСтроки = Неопределено, 0, СуммаДанныхСтроки) + ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);
				
				НачисленныеБонусыСтруктура = Новый Структура;
				БонуснаяПрограмма = Справочники.БонусныеПрограммыЛояльности.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеНачисленныхБонусов.БонуснаяПрограмма));
				Если ОбщегоНазначения.СсылкаСуществует(БонуснаяПрограмма) Тогда
					НачисленныеБонусыСтруктура.Вставить("БонуснаяПрограммаЛояльности", БонуснаяПрограмма);
					НачисленныеБонусыСтруктура.Вставить("ДатаНачисления", ДанныеНачисленныхБонусов.ДатаНачисления);
					НачисленныеБонусыСтруктура.Вставить("СуммаБонусныхБаллов", ДанныеНачисленныхБонусов.КоличествоБонусныхБаллов);
					МассивСтрокНачисленныеБонусы.Добавить(НачисленныеБонусыСтруктура);
				КонецЕсли;
			КонецЕсли;
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокТовары.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17")
		И ДанныеXDTO.Свойство("НачисленныеБонусы") И ЗначениеЗаполнено(ДанныеXDTO.НачисленныеБонусы) Тогда
		ПоляКоллекции = Новый Структура;	// ключ - поле тч; значение - поле коллекции XDTO
		ПоляКоллекции.Вставить("БонуснаяПрограммаЛояльности",	"БонуснаяПрограмма");
		ПоляКоллекции.Вставить("ДатаНачисления", 				"ДатаНачалаДействия");
		ПоляКоллекции.Вставить("ДатаСписания", 					"ДатаОкончанияДействия");
		ПоляКоллекции.Вставить("СуммаБонусныхБаллов", 			"КоличествоБонусныхБаллов");
		Для каждого ЭлемБонус Из ДанныеXDTO.НачисленныеБонусы Цикл
			Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭлемБонус, "БонуснаяПрограмма")
				ИЛИ НЕ ЗначениеЗаполнено(ЭлемБонус.БонуснаяПрограмма) 
				ИЛИ  ЭлемБонус.БонуснаяПрограмма.ТипЗначения <> "ПрограммыЛояльности" Тогда	//@NON-NLS-2
				Продолжить;
			КонецЕсли;
			БонусыСтруктура = Новый Структура;
			Для каждого ЭлемПоле Из ПоляКоллекции Цикл
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭлемБонус, ЭлемПоле.Значение) Тогда
					БонусыСтруктура.Вставить(ЭлемПоле.Ключ, ЭлемБонус[ЭлемПоле.Значение]);
				КонецЕсли;
			КонецЦикла;
			МассивСтрокНачисленныеБонусы.Добавить(БонусыСтруктура);
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокНачисленныеБонусы.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("БонусныеБаллы", МассивСтрокНачисленныеБонусы);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("СкидкиНаценки")
		И ЗначениеЗаполнено(ДанныеXDTO.СкидкиНаценки) Тогда
		Для каждого СтрокаСкидкаНаценка Из ДанныеXDTO.СкидкиНаценки Цикл
			Если СтрокаСкидкаНаценка.ВидСкидки.Значение = "Бонус" Тогда
				ПолученныеДанные.СуммаБонусныхБалловКВозврату = ПолученныеДанные.СуммаБонусныхБалловКВозврату + СтрокаСкидкаНаценка.СуммаСкидки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Оплата платежными картами
	МассивСтрокОплатаПК = Новый Массив;
	
	Если ДанныеXDTO.Свойство("ОплатаПлатежнымиКартами")
		И ЗначениеЗаполнено(ДанныеXDTO.ОплатаПлатежнымиКартами) Тогда
		
		Для Каждого Строка Из ДанныеXDTO.ОплатаПлатежнымиКартами Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("Сумма", Строка.СуммаОплаты);
			СтруктураДанныхСтроки.Вставить("НомерПлатежнойКарты", Строка.НомерКарты);
		    Если ЗначениеЗаполнено(Строка.ЭквайринговыйТерминал)  Тогда
				спрЭквайринговыйТерминал = Строка.ЭквайринговыйТерминал;
				Если спрЭквайринговыйТерминал.Свойство("Номер") И Не Пустаястрока(спрЭквайринговыйТерминал.Номер) Тогда
					Инструкция = Новый Структура;
					Инструкция.Вставить("Значение", Строка.ЭквайринговыйТерминал);
					Инструкция.Вставить("ИмяПКО", "Справочник_ЭквайринговыеТерминалы_Получение");
			
					СтруктураДанныхСтроки.Вставить("ЭквайринговыйТерминал", Инструкция);
				КонецЕсли;
			КонецЕсли;		
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.11") Тогда  
				СтруктураДанныхСтроки.Вставить("ВидОплаты", Строка.ТипыПлатежнойСистемыККТ);
			КонецЕсли;
			
			Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.18") Тогда  
				ТекДоговор = Строка.ДоговорЭквайрера;	// Структура
				Если ЗначениеЗаполнено(ТекДоговор)
					И ЗначениеЗаполнено(ТекДоговор.Ссылка) Тогда
					ДоговорИД = ТекДоговор.Ссылка.Значение;
					СсылкаДоговора = Справочники.ДоговорыЭквайринга.ПолучитьСсылку(Новый УникальныйИдентификатор(ДоговорИД));
					СтруктураДанныхСтроки.Вставить("ДоговорПодключения", СсылкаДоговора);
				КонецЕсли;
			КонецЕсли;
			
			МассивСтрокОплатаПК.Добавить(СтруктураДанныхСтроки);
		
		КонецЦикла;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ОплатаПлатежнымиКартами", МассивСтрокОплатаПК);
	КонецЕсли;
	
	// Штрихкоды упаковок.
	ЗагрузитьШтрихкодыУпаковок(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена, "АкцизныеМарки", "АкцизнаяМарка");
	ДополнитьЧекДополнительнойИнформацией(ДанныеXDTO, ПолученныеДанные);
КонецПроцедуры
Процедура ПКО_Документ_ЧекККМВозврат_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗаполнитьСкладПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
								ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
	НомерКассовойСмены = ПолученныеДанные.ДополнительныеСвойства.НомерКассовойСмены;
	Если ЗначениеЗаполнено(ПолученныеДанные.КартаЛояльности) Тогда
		ВыборкаБонуснаяПрограммаЛояльности = БонусныеБаллыСервер.БонуснаяПрограммаКартыЛояльности(ПолученныеДанные.КартаЛояльности);
		БонуснаяПрограммаЛояльности = ВыборкаБонуснаяПрограммаЛояльности.БонуснаяПрограммаЛояльности;
		ВалютаДокумента = ПолученныеДанные.Валюта;
		ВалютаБонуснойПрограммы = ВыборкаБонуснаяПрограммаЛояльности.Валюта;
		СтруктураКурсовВалютыДокумента = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ВалютаДокумента, ПолученныеДанные.Дата);
		СтруктураКурсовВалютыБонуснойПрограммы = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ВалютаБонуснойПрограммы, ПолученныеДанные.Дата);
		КурсКонвертацииБонусовВВалюту = ВыборкаБонуснаяПрограммаЛояльности.КурсКонвертацииБонусовВВалюту;
		Если ПолученныеДанные.СуммаБонусныхБалловКВозврату <> 0 И КурсКонвертацииБонусовВВалюту <> 0 Тогда
			ПолученныеДанные.СуммаБонусныхБалловКВозврату = РаботаСКурсамиВалютУТ.ПересчитатьПоКурсу(
				ПолученныеДанные.СуммаБонусныхБалловКВозврату / КурсКонвертацииБонусовВВалюту,
				СтруктураКурсовВалютыДокумента,
				СтруктураКурсовВалютыБонуснойПрограммы);
		КонецЕсли;
	КонецЕсли;
	// В случае наличия объекта в базе он и будет записан (а не ПолученныеДанные).
	// Шапка и табличная часть предварительно переносятся из ПолученныеДанные в ДанныеИБ:
	// шапка - в составе свойств из ПКС, табличная часть - полностью берется из полученных данных.
	Если ДанныеИБ <> Неопределено Тогда
		ДанныеИБСклад = ДанныеИБ.Склад;
	
		// Переносим те свойства, которые указаны в ПКС.
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		Если НЕ КомпонентыОбмена.ПараметрыКонвертации.ВыгружатьАналитикуПоСкладам Тогда
			// Восстанавливаем склад из первоначального документа.
			ДанныеИБ.Склад = ДанныеИБСклад;
		КонецЕсли;
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
		ДанныеИБ.ОплатаПлатежнымиКартами.Загрузить(ПолученныеДанные.ОплатаПлатежнымиКартами.Выгрузить());
	    ДанныеИБ.БонусныеБаллы.Загрузить(ПолученныеДанные.БонусныеБаллы.Выгрузить());
	    
		ПолученныеДанные = Неопределено;
		ДанныеДляЗаписиВИБ = ДанныеИБ;
	Иначе
		ДанныеДляЗаписиВИБ = ПолученныеДанные;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.КассоваяСмена) Тогда
		
		ДокументыСПодарочнымиСертификатами = КомпонентыОбмена.ПараметрыКонвертации.ДокументыСПодарочнымиСертификатами; // ТаблицаЗначений
			
		НоваяСтрока = ДокументыСПодарочнымиСертификатами.Добавить();
		НоваяСтрока.ДокументСсылка      = ?(ДанныеИБ = Неопределено, ДанныеДляЗаписиВИБ.ПолучитьСсылкуНового(), ДанныеДляЗаписиВИБ.Ссылка);
		НоваяСтрока.ДатаДокумента       = ДанныеДляЗаписиВИБ.Дата;
		НоваяСтрока.ОчередьДокумента    = 0;
		НоваяСтрока.КассаККМ            = ДанныеДляЗаписиВИБ.КассаККМ;
		НоваяСтрока.НомерКассовойСмены  = НомерКассовойСмены;
		
	КонецЕсли;
	
	Если ДанныеДляЗаписиВИБ.Товары.Количество() > 0 Тогда
		Для Каждого СтрокаТовары Из ДанныеДляЗаписиВИБ.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТовары.Серия) Тогда
				СтрокаСерия = ДанныеДляЗаписиВИБ.Серии.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСерия, СтрокаТовары);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
			
	Для Каждого СтрокаОплаты Из ДанныеДляЗаписиВИБ.ОплатаПлатежнымиКартами Цикл
		Если Не ЗначениеЗаполнено(СтрокаОплаты.ЭквайринговыйТерминал) Тогда
			СтрокаОплаты.ЭквайринговыйТерминал = Справочники.ЭквайринговыеТерминалы.ЭквайринговыйТерминалПоУмолчанию(ДанныеДляЗаписиВИБ.Организация);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

