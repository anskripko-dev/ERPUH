КонецПроцедуры
Процедура ПОД_Документ_ПоступлениеДенежныхДокументов_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	ИспользованиеПКО.Очистить();
	
	Если Не ЗначениеЗаполнено(ДанныеИБ.СуммаДокумента) или Не ЗначениеЗаполнено(ДанныеИБ.Валюта) Тогда
		//Формата обмена 1.5 не поддерживает выгрузку мультивалютных поступлений денежных документов
		//В случае использования нескольких валют "СуммаДокумента" и "Валюта" не заполняются
		ШаблонПредупреждения = НСтр("ru = 'Документ %1 не может быть выгружен,
		|т.к. формат обмена не поддерживает выгрузку мультивалютных поступлений денежных документов.';
		|en = 'Document %1 cannot be exported
		|as the exchange format does not support the export of multicurrency receipt of financial documents.'");
		
		ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ДанныеИБ.Ссылка);
		ПредупреждениеПриСинхронизации(КомпонентыОбмена, ДанныеИБ.Ссылка, ТекстПредупреждения);
		
		Возврат;
		
	КонецЕсли;
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхДокументовОтПодотчетника Тогда 
		ИспользованиеПКО.Вставить("Документ_ПоступлениеДДПодотчет_Отправка", Истина);
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхДокументовОтПоставщика Тогда
		ИспользованиеПКО.Вставить("Документ_ПоступлениеДДПоставщик_Отправка", Истина);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
		|	ПоступлениеДенежныхДокументовДенежныеДокументы.ДенежныйДокумент КАК ДенежныйДокумент,
		|	ПоступлениеДенежныхДокументовДенежныеДокументы.Количество КАК Количество,
		|	ПоступлениеДенежныхДокументовДенежныеДокументы.Сумма КАК Сумма
		|ИЗ
		|	Документ.ПоступлениеДенежныхДокументов.ДенежныеДокументы КАК ПоступлениеДенежныхДокументовДенежныеДокументы
		|ГДЕ
		|	ПоступлениеДенежныхДокументовДенежныеДокументы.Ссылка = &Ссылка";
	
	ТЧДенежныеДокументы = Запрос.Выполнить().Выгрузить();
	ДанныеИБ.ДополнительныеСвойства.Вставить("ТЧДенежныеДокументы", ТЧДенежныеДокументы);
КонецПроцедуры

