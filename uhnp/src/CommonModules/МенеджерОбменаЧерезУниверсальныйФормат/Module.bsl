	Для Каждого СтрокаДанные Из НачисленнаяЗарплатаИВзносы Цикл
		СтрокаДанные.ВидОперации = XMLСтрока(СтрокаДанные.ВидОперацииСсылка);
		СтрокаДанные.ВидНачисленияОплатыТрудаДляНУ = XMLСтрока(СтрокаДанные.ВидНачисленияОплатыТрудаДляНУСсылка);
	КонецЦикла;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		
		УдержаннаяЗарплата.Колонки.Добавить("СпособРасчетов", Новый ОписаниеТипов("Строка"));
		Для Каждого СтрокаДанные Из УдержаннаяЗарплата Цикл
			СтрокаДанные.СпособРасчетов = XMLСтрока(СтрокаДанные.СпособРасчетовСсылка);
		КонецЦикла;
		
		НачисленныйНДФЛ.Колонки.Добавить("СпособРасчетов", Новый ОписаниеТипов("Строка"));
		Для Каждого СтрокаДанные Из НачисленныйНДФЛ Цикл
			СтрокаДанные.СпособРасчетов = XMLСтрока(СтрокаДанные.СпособРасчетовСсылка);
		КонецЦикла;
		
		НачисленнаяЗарплатаИВзносы.Колонки.Добавить("СпособРасчетов", Новый ОписаниеТипов("Строка"));
		Для Каждого СтрокаДанные Из НачисленнаяЗарплатаИВзносы Цикл
			СтрокаДанные.СпособРасчетов = XMLСтрока(СтрокаДанные.СпособРасчетовСсылка);
		КонецЦикла;
	
	КонецЕсли;
	
	ИспользоватьФормат1_15 = (СравнитьВерсии(КомпонентыОбмена.ВерсияФорматаОбмена, "1.15") >= 0);
	ПередаватьВзносыПоЕдиномуТарифу = (Не ИспользоватьФормат1_15 И ДанныеИБ.ПериодРегистрации >= '20230101');
	
	Если ПередаватьВзносыПоЕдиномуТарифу Тогда
		ВзносыПоЕдиномуТарифу = Новый ТаблицаЗначений;
		ВзносыПоЕдиномуТарифу.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		ВзносыПоЕдиномуТарифу.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		
		Для каждого СтрокаТЧ Из НачисленнаяЗарплатаИВзносы Цикл
			НоваяСтрокаВзносов = ВзносыПоЕдиномуТарифу.Добавить();
			НоваяСтрокаВзносов.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
			НоваяСтрокаВзносов.Сумма = СтрокаТЧ.ВзносыПоЕдиномуТарифу;
		КонецЦикла;
		
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
			ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
		Иначе
			ДополнительныеДанные = Новый Структура;
		КонецЕсли;
		ДополнительныеДанные.Вставить("ВзносыПоЕдиномуТарифу", ВзносыПоЕдиномуТарифу); 
		ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);
		
	КонецЕсли;
	
	ДанныеXDTO.Вставить("УдержаннаяЗарплата",         УдержаннаяЗарплата);
	ДанныеXDTO.Вставить("НачисленныйНДФЛ",            НачисленныйНДФЛ);
	ДанныеXDTO.Вставить("НачисленнаяЗарплатаИВзносы", НачисленнаяЗарплатаИВзносы);
КонецПроцедуры

