	|	ВременнаяТаблицаТоварыИтог.Сумма КАК Сумма,
	|	ВременнаяТаблицаТоварыИтог.СтавкаНДС КАК СтавкаНДС,
	|	ВременнаяТаблицаТоварыИтог.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	ВременнаяТаблицаТоварыИтог КАК ВременнаяТаблицаТоварыИтог
	|ГДЕ
	|	(ВременнаяТаблицаТоварыИтог.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|			ИЛИ ВременнаяТаблицаТоварыИтог.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВложенныйЗапрос.Цена КАК Цена,
	|	ВложенныйЗапрос.СтавкаНДС КАК СтавкаНДС,
	|	ВложенныйЗапрос.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|	ВложенныйЗапрос.Количество КАК Количество,
	|	ВложенныйЗапрос.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВложенныйЗапрос.Сумма КАК Сумма,
	|	ВложенныйЗапрос.СуммаНДС КАК СуммаНДС,
	|	&ТекстЗапросаХарактеристика,
	|	&ТекстЗапросаСерия,
	|	&ТекстЗапросаУпаковка,
	|	&ТекстЗапросаРНПТ,
	|	ВложенныйЗапрос.НомерГТД КАК НомерГТД
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВременнаяТаблицаТовары.Номенклатура КАК Номенклатура,
	|		ВременнаяТаблицаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		ВременнаяТаблицаТовары.Цена КАК Цена,
	|		ВременнаяТаблицаТовары.СтавкаНДС КАК СтавкаНДС,
	|		ВременнаяТаблицаТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|		ВременнаяТаблицаТовары.НомерГТД КАК НомерГТД,
	|		ВременнаяТаблицаТовары.НомерСтроки КАК НомерСтрокиДокумента,
	|		СУММА(ВременнаяТаблицаТовары.Количество) КАК Количество,
	|		СУММА(ВременнаяТаблицаТовары.КоличествоПоРНПТ) КАК КоличествоПоРНПТ,
	|		СУММА(ВременнаяТаблицаТовары.Сумма) КАК Сумма,
	|		СУММА(ВременнаяТаблицаТовары.СуммаНДС) КАК СуммаНДС,
	|		ВременнаяТаблицаТовары.Характеристика КАК Характеристика,
	|		ВременнаяТаблицаТовары.Серия КАК Серия,
	|		ВременнаяТаблицаТовары.Упаковка КАК Упаковка,
	|		СУММА(ВременнаяТаблицаТовары.КоличествоУпаковок) КАК КоличествоУпаковок
	|	ИЗ
	|		ВременнаяТаблицаТовары КАК ВременнаяТаблицаТовары
	|ГДЕ
	|	ВременнаяТаблицаТовары.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|			И ВременнаяТаблицаТовары.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВременнаяТаблицаТовары.Номенклатура,
	|		ВременнаяТаблицаТовары.ЕдиницаИзмерения,
	|		ВременнаяТаблицаТовары.Цена,
	|		ВременнаяТаблицаТовары.СтавкаНДС,
	|		ВременнаяТаблицаТовары.НомерГТД,
	|		ВременнаяТаблицаТовары.НомерСтроки,
	|		ВременнаяТаблицаТовары.ИдентификаторСтроки,
	|		ВременнаяТаблицаТовары.Характеристика,
	|		ВременнаяТаблицаТовары.Серия,
	|		ВременнаяТаблицаТовары.Упаковка) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиДокумента";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "ВложенныйЗапрос"));
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаУпаковка",
		ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "ВложенныйЗапрос"));
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
		ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "ВложенныйЗапрос"));
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаРНПТ",
		ПолучитьТекстЗапросаРНПТ(КомпонентыОбмена, "ВложенныйЗапрос"));
		
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаГТД","ВложенныйЗапрос.НомерГТД"); 
	ИначеЕсли ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) <= ВерсияФорматаЧислом("1.8") Тогда
	    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВложенныйЗапрос.НомерГТД", "ЕстьNull(ВложенныйЗапрос.НомерГТД.Код, """")");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаГТД", "ВложенныйЗапрос.НомерГТД.Код");
	КонецЕсли;
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("УказыватьНомераГТД", ДанныеИБ.УказыватьНомераГТД);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаТовары     = РезультатыЗапроса[РезультатыЗапроса.Количество()-1].Выгрузить();
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, ТаблицаТовары);
	ТаблицаТовары.Колонки.Добавить("ТипЗапасов");
	
	Если ДанныеXDTO.ВидОперации = "ПриемНаКомиссию" Тогда
		ТаблицаТовары.ЗаполнитьЗначения("КомиссионныеТовары", "ТипЗапасов");
	Иначе
		ТаблицаТовары.ЗаполнитьЗначения("СобственныеТовары", "ТипЗапасов"); //@NON-NLS-1
		Услуги = РезультатыЗапроса[РезультатыЗапроса.Количество()-2].Выгрузить();
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда   
			ПереопределитьСтавкуНДСДляСтарыхФорматов(Услуги, Ложь);
		КонецЕсли;  
		
		// Услуги выгружаются только для операции реализации в другую организацию.
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
	
	ЗаполнитьВидДеятельностиНДСВТЧ(КомпонентыОбмена, ДанныеИБ, ТаблицаТовары, "ЗакупкаПодДеятельность", "ПередачаПодДеятельность");
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда   
		 ПереопределитьСтавкуНДСДляСтарыхФорматов(ТаблицаТовары, Ложь);
	КонецЕсли;
	ДанныеXDTO.Вставить("Товары", ТаблицаТовары);
	//++ Локализация
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		Если ДанныеИБ.УказыватьНомераГТД Тогда
			ИмяТаблицы = "Документ.ПередачаТоваровМеждуОрганизациями.Товары"; 
			ИдентификаторыИзВидовЗапасов = Ложь;
		Иначе
			ИмяТаблицы = "Документ.ПередачаТоваровМеждуОрганизациями.ВидыЗапасов";
			ИдентификаторыИзВидовЗапасов = Истина;
		КонецЕсли;
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов); 
	КонецЕсли;     
	//-- Локализация
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
КонецПроцедуры

