Функция ПериодыОтчетностиПоДатеУдержания(ДатаУдержания, ДатаДокумента, ОтчетныйПериод)
	НачалоПериода = НачалоМесяца(ОтчетныйПериод);
	КонецПериода  = КонецМесяца(ОтчетныйПериод);
	
	Если ДатаДокумента >= ЕдиныйНалоговыйСчет.ДатаВступленияВСилу539ФЗ() Тогда
		
		ГраницаПериодов = ОтчетныйПериод + 22 * 86400; // 23-е число текущего месяца
		
		Если ДатаУдержания < ГраницаПериодов Тогда
			НачалоПериода = НачалоМесяца(ОтчетныйПериод);
			КонецПериода = ГраницаПериодов - 1;
		Иначе
			НачалоПериода = ГраницаПериодов;
			КонецПериода = КонецМесяца(ОтчетныйПериод);
		КонецЕсли;
			
	КонецЕсли;
	
	ПериодыОтчетности = Новый Структура;
	
	ПериодыОтчетности.Вставить("НачалоПериода", НачалоПериода);
	ПериодыОтчетности.Вставить("КонецПериода", КонецПериода);
	
	Возврат ПериодыОтчетности;
КонецФункции
