	ДобавитьПКС(СвойстваШапки, "Дата",           "Дата");
	ДобавитьПКС(СвойстваШапки, "Комментарий",    "Комментарий");
	ДобавитьПКС(СвойстваШапки, "Номер",          "Номер", 1);
	ДобавитьПКС(СвойстваШапки, "Организация",    "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "Ответственный",  "Ответственный", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "",               "ОтчетныйПериод");
	ДобавитьПКС(СвойстваШапки, "Проведен",       "", 1);
	ДобавитьПКС(СвойстваШапки, "СуммаДокумента", "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "РасшифровкаНалогов", "");
	ДобавитьПКС(СвойстваТЧ, "КодБК",         "КБК", 1);
	ДобавитьПКС(СвойстваТЧ, "КонецПериода",  "Дата", 1);
	ДобавитьПКС(СвойстваТЧ, "НачалоПериода", "Дата", 1);
	ДобавитьПКС(СвойстваТЧ, "СрокУплаты",    "СрокУплатыДата", 1);
	ДобавитьПКС(СвойстваТЧ, "Субконто1",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "Субконто2",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "Субконто3",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "Сумма",         "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "СчетУчета",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "ТипНалога",     "", 1);

КонецПроцедуры
Процедура ПКО_Документ_НачислениеЕНП_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	НачалоПериода = Дата(1,1,1);   
	КонецПериода = Дата(1,1,1);
	РасшифровкаНалоговXDTO = Неопределено;
	
	Если ДанныеXDTO.Свойство("НДФЛ", РасшифровкаНалоговXDTO)
		И ЗначениеЗаполнено(РасшифровкаНалоговXDTO) Тогда
		
		МассивРасшифровкаНалогов = Новый Массив;
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("КБК", "КодБК");
		ПравилаЗаполнения.Вставить("СрокУплатыДата", "СрокУплаты");
		ПравилаЗаполнения.Вставить("Сумма", "Сумма");
		ДатыУдержанияМассив = Новый Массив;
		
		ЕстьДатыУдержанияНалога = Ложь;
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
			ЕстьДатыУдержанияНалога = ДанныеXDTO.AdditionalInfo.Свойство("ДатыУдержанияНалога");
		КонецЕсли;
		
		Если  ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
			НачалоПериода  = НачалоМесяца(ДанныеXDTO.КлючевыеСвойства.ОтчетныйПериод);
			КонецПериода = КонецМесяца(ДанныеXDTO.КлючевыеСвойства.ОтчетныйПериод);
		КонецЕсли;  
		КБКпоНДФЛ = УчетНДФЛ.КБКпоНДФЛ(ПолученныеДанные.Дата); 
		ВидыНалоговПоКБК = Документы.НачислениеЕНП.ВидыНалоговПоКБК(ПолученныеДанные.Дата);
		Для Каждого СтрокаРасшифровкаНалоговXDTO Из РасшифровкаНалоговXDTO Цикл   
			СтрокаРасшифровкаНалогов = ДанныеКоллекцииВВидеСтруктуры(СтрокаРасшифровкаНалоговXDTO, ПравилаЗаполнения);
			Если СтрокаРасшифровкаНалогов.Свойство("КодБК") Тогда
				
				Если ЗначениеЗаполнено(СтрокаРасшифровкаНалогов.КодБК) Тогда
					КодБК = СтрокаРасшифровкаНалогов.КодБК;
				Иначе
					КодБК = КБКпоНДФЛ.Основной;
				КонецЕсли;  
				ТипНалога = ВидыНалоговПоКБК.Получить(КодБК);
				Если Не ЗначениеЗаполнено(ТипНалога) Тогда
					ТипНалога = Справочники.ВидыНалоговВзносов.НДФЛ;
				КонецЕсли;
				СчетУчета = РеглУчетСервер.СчетУчетаПоТипуНалога(ТипНалога);
				
				СтрокаРасшифровкаНалогов.Вставить("СчетУчета", СчетУчета);
				СтрокаРасшифровкаНалогов.Вставить("ТипНалога", ТипНалога);
												
			КонецЕсли; 
			Если ТипНалога = Неопределено Тогда 
				СтрокаРасшифровкаНалогов.Вставить("ТипНалога", Справочники.ВидыНалоговВзносов.НДФЛ);
			КонецЕсли;
			Если ЗначениеЗаполнено(ПолученныеДанные.Организация) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	РегистрацииВНалоговомОргане.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
				|ГДЕ
				|	НЕ РегистрацииВНалоговомОргане.ПометкаУдаления
				|	И РегистрацииВНалоговомОргане.КПП = &КПП
				|	И РегистрацииВНалоговомОргане.Код = &Код
				|	И РегистрацииВНалоговомОргане.Владелец = &Организация";
	
				Запрос.УстановитьПараметр("Код", СтрокаРасшифровкаНалоговXDTO.КодНалоговогоОргана);
				Запрос.УстановитьПараметр("КПП", СтрокаРасшифровкаНалоговXDTO.КПП);
				Запрос.УстановитьПараметр("Организация", ПолученныеДанные.Организация);
	
				РезультатЗапроса = Запрос.Выполнить();
				Если РезультатЗапроса.Пустой() Тогда
					РегистрацияВНалоговомОргане = Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка();
				Иначе
					ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						РегистрацияВНалоговомОргане = ВыборкаДетальныеЗаписи.Ссылка;
					КонецЦикла;
				КонецЕсли;
			Иначе
				РегистрацияВНалоговомОргане = Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка();
			КонецЕсли;
			
			Если ЕстьДатыУдержанияНалога Тогда
				СтрокиНДФЛ = ДанныеXDTO.AdditionalInfo.ДатыУдержанияНалога.НайтиСтроки(Новый Структура("ИдентификаторСтроки",
					СтрокаРасшифровкаНалоговXDTO.ИдентификаторСтроки));
				Если СтрокиНДФЛ.Количество() <> 0 Тогда
					ПериодыОтчетности = ПериодыОтчетностиПоДатеУдержания(СтрокиНДФЛ[0].ДатаУдержания, 
						ПолученныеДанные.Дата, НачалоМесяца(НачалоПериода));
						
					НачалоПериода = ПериодыОтчетности.НачалоПериода;
					КонецПериода = ПериодыОтчетности.КонецПериода;
						
				КонецЕсли;
			КонецЕсли;
			
			СтрокаРасшифровкаНалогов.Вставить("Субконто1", Перечисления.ВидыПлатежейВГосБюджет.Налог);
			СтрокаРасшифровкаНалогов.Вставить("Субконто2", РегистрацияВНалоговомОргане);
			СтрокаРасшифровкаНалогов.Вставить("Субконто3", Неопределено);
			СтрокаРасшифровкаНалогов.Вставить("НачалоПериода", НачалоПериода); 
			СтрокаРасшифровкаНалогов.Вставить("КонецПериода", КонецПериода);
			Если ЗначениеЗаполнено(СтрокаРасшифровкаНалогов.ТипНалога) Тогда
			    СтрокаРасшифровкаНалогов.Вставить("ФормироватьУведомление", Истина);
			КонецЕсли;
			МассивРасшифровкаНалогов.Добавить(СтрокаРасшифровкаНалогов);
		КонецЦикла;
		
		Если МассивРасшифровкаНалогов.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("РасшифровкаНалогов", МассивРасшифровкаНалогов);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_НачислениеЕНП_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗаполнитьДопСвойстваДанныхИБИзПолученныхДанных(ДанныеИБ, ПолученныеДанные);
		
	Если Не ДанныеИБ = Неопределено Тогда 
		ЗаполнитьСвойстваТабличнойЧастиОбъекта(
		ПолученныеДанные.РасшифровкаНалогов,
		ДанныеИБ.РасшифровкаНалогов,
		"КодБК,ТипНалога,СрокУплаты,Сумма,СчетУчета,Субконто1,Субконто2,Субконто3",
		"Сумма");
	КонецЕсли; 
	ИзменяемыеДанные = ?(Не ДанныеИБ = Неопределено, ДанныеИБ, ПолученныеДанные);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ИзменяемыеДанные, "ПредварительноеУведомлениеПоНДФЛ") Тогда
		ИзменяемыеДанные.ПредварительноеУведомлениеПоНДФЛ = День(ИзменяемыеДанные.Дата) <= 12; 
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПКО_Документ_НачислениеОценОбязатПоОтпускам_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_НачислениеОценОбязатПоОтпускам_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.НачислениеОценочныхОбязательствПоОтпускам;
	ПравилоКонвертации.ОбъектФормата                = "Документ.НачислениеОценочныхОбязательствПоОтпускам"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_НачислениеОценОбязатПоОтпускам_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_НачислениеОценОбязатПоОтпускам_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_НачислениеОценОбязатПоОтпускам";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Бухгалтер",                      "Бухгалтер", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "Дата",                           "Дата");
	ДобавитьПКС(СвойстваШапки, "ДоляРасходов",                   "ДоляРасходов");
	ДобавитьПКС(СвойстваШапки, "Комментарий",                    "Комментарий");
	ДобавитьПКС(СвойстваШапки, "КорректировкаОбязательств",      "КорректировкаОбязательств");
	ДобавитьПКС(СвойстваШапки, "Номер",                          "Номер");
	ДобавитьПКС(СвойстваШапки, "ОбязательстваОтраженыВБухучете", "ОбязательстваОтраженыВБухучете");
	ДобавитьПКС(СвойстваШапки, "Организация",                    "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "Ответственный",                  "Ответственный", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "ПериодРегистрации",              "ПериодРегистрации");
	ДобавитьПКС(СвойстваШапки, "Проведен",                       "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ДополнительныеРеквизиты", "");
	ДобавитьПКС(СвойстваТЧ, "Значение", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Свойство", "", 1, "Справочник_ДополнительныеРеквизиты");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ОценочныеОбязательства",  "");
	ДобавитьПКС(СвойстваТЧ, "МестоВСтруктуреПредприятия",        "", 1);
	ДобавитьПКС(СвойстваТЧ, "ОблагаетсяЕНВД",                    "", 1);
	ДобавитьПКС(СвойстваТЧ, "СпособОтраженияЗарплатыВБухучете",  "", 1, "Справочник_СпособыОтраженияЗарплатыВБухУчете");
	ДобавитьПКС(СвойстваТЧ, "СуммаРезерва",                      "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаРезерваНУ",                    "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаРезерваСтраховыхВзносов",      "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаРезерваСтраховыхВзносовНУ",    "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаРезерваФССНесчастныеСлучаи",   "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаРезерваФССНесчастныеСлучаиНУ", "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("Дата,Номер");
КонецПроцедуры
Процедура ПКО_Документ_НачислениеОценОбязатПоОтпускам_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	ОценочныеОбязательстваXDTO = Неопределено;
	Если ДанныеXDTO.Свойство("ОценочныеОбязательства", ОценочныеОбязательстваXDTO)
		И ЗначениеЗаполнено(ОценочныеОбязательстваXDTO) Тогда
		
		МассивОценочныеОбязательства = Новый Массив;
		
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ОблагаетсяЕНВД", "ОблагаетсяЕНВД");
		ПравилаЗаполнения.Вставить("Подразделение", "МестоВСтруктуреПредприятия");
		ПравилаЗаполнения.Вставить("СпособОтраженияЗарплатыВФинансовомУчете", "СпособОтраженияЗарплатыВБухучете");
		ПравилаЗаполнения.Вставить("СуммаРезерва", "СуммаРезерва");
		ПравилаЗаполнения.Вставить("СуммаРезерваНУ", "СуммаРезерваНУ");
		ПравилаЗаполнения.Вставить("СуммаРезерваСтраховыхВзносов", "СуммаРезерваСтраховыхВзносов");
		ПравилаЗаполнения.Вставить("СуммаРезерваСтраховыхВзносовНУ", "СуммаРезерваСтраховыхВзносовНУ");
		ПравилаЗаполнения.Вставить("СуммаРезерваФССНесчастныеСлучаи", "СуммаРезерваФССНесчастныеСлучаи");
		ПравилаЗаполнения.Вставить("СуммаРезерваФССНесчастныеСлучаиНУ", "СуммаРезерваФССНесчастныеСлучаиНУ");
		
		Для Каждого СтрокаОценочныеОбязательстваXDTO Из ОценочныеОбязательстваXDTO Цикл
			СтрокаОценочныеОбязательства = ДанныеКоллекцииВВидеСтруктуры(СтрокаОценочныеОбязательстваXDTO, ПравилаЗаполнения);
			
			СтрокаПодразделениеXDTO = Новый Структура("Подразделение");
			ЗаполнитьЗначенияСвойств(СтрокаПодразделениеXDTO, СтрокаОценочныеОбязательстваXDTO);
			Если ЗначениеЗаполнено(СтрокаПодразделениеXDTO.Подразделение)
				И ТипЗнч(СтрокаПодразделениеXDTO.Подразделение) = Тип("Структура") Тогда
				Если СтрокаПодразделениеXDTO.Подразделение.Свойство("Ссылка") Тогда
					СтрокаОценочныеОбязательства.МестоВСтруктуреПредприятия = Новый Структура("Значение, ИмяПКО",
						СтрокаПодразделениеXDTO.Подразделение, "Справочник_Подразделения_Получение");
				КонецЕсли;
			КонецЕсли;
			
			МассивОценочныеОбязательства.Добавить(СтрокаОценочныеОбязательства);
		КонецЦикла;
		
		Если МассивОценочныеОбязательства.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ОценочныеОбязательства", МассивОценочныеОбязательства);
		КонецЕсли;
	КонецЕсли;
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Документ_НачислениеОценОбязатПоОтпускам_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если Не ДанныеИБ = Неопределено Тогда
		// Способ отражения ЗП в БУ
		ЗаполнитьСвойстваТабличнойЧастиОбъекта(
			ПолученныеДанные.ОценочныеОбязательства,
			ДанныеИБ.ОценочныеОбязательства,
			"ОблагаетсяЕНВД, МестоВСтруктуреПредприятия, СуммаРезерва, СуммаРезерваСтраховыхВзносов, СуммаРезерваФССНесчастныеСлучаи",
			"СпособОтраженияЗарплатыВБухучете");	
	КонецЕсли;
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
								ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
КонецПроцедуры

