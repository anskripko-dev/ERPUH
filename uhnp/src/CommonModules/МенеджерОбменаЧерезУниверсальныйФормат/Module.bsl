Процедура ПКО_Документ_ПоступлениеДДПоставщик_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.ХозяйственнаяОперация  = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхДокументовОтПоставщика;
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO, "ВалютаВзаиморасчетов", "ВалютаВзаиморасчетов");
	ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("ДенежныйДокумент", "ДенежныйДокумент");
	ПравилаЗаполнения.Вставить("Количество",       "Количество");
	ПравилаЗаполнения.Вставить("Сумма",            "Сумма");
	
	//Денежные документы 
	МассивСтрокДД = Новый Массив;
	Если ДанныеXDTO.Свойство("ДенежныеДокументы")
		И ЗначениеЗаполнено(ДанныеXDTO.ДенежныеДокументы) Тогда
		Для Каждого Строка Из ДанныеXDTO.ДенежныеДокументы Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
		
			ДенежныйДокумент = Строка.ДенежныйДокумент; // СправочникСсылка.ДенежныеДокументы
			
			СтруктураДанныхСтроки.Вставить("НаименованиеДенежногоДокумента", ДенежныйДокумент.Наименование);
			СтруктураДанныхСтроки.Вставить("Цена", Строка.Сумма / Строка.Количество);
			
			МассивСтрокДД.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;	
	КонецЕсли;
	
	Если МассивСтрокДД.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДенежныеДокументы", МассивСтрокДД);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ПоступлениеДДПоставщик_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
		                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
	Если ДанныеИБ <> Неопределено Тогда
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
		
		ДанныеИБ.ДенежныеДокументы.Загрузить(ПолученныеДанные.ДенежныеДокументы.Выгрузить());
		
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СтатьяДвиженияДенежныхСредств) Тогда
		СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.СтатьяДвиженияДенежныхСредствПоХозяйственнойОперации(
			ДанныеДляЗаписиВИБ.ХозяйственнаяОперация);	
		ДанныеДляЗаписиВИБ.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ДатаПлатежа) Тогда
		ДанныеДляЗаписиВИБ.ДатаПлатежа = ДанныеДляЗаписиВИБ.Дата;
	КонецЕсли;
	
	ПолученныеДД = КомпонентыОбмена.ПараметрыКонвертации.ПолученныеДенежныеДокументы; // ТаблицаЗначений
	Для Каждого Стр Из ДанныеДляЗаписиВИБ.ДенежныеДокументы Цикл
		СтрДД = ПолученныеДД.Добавить();
		СтрДД.ДенежныйДокумент = Стр.ДенежныйДокумент;
		СтрДД.Валюта = ДанныеДляЗаписиВИБ.Валюта;
	КонецЦикла;
КонецПроцедуры

