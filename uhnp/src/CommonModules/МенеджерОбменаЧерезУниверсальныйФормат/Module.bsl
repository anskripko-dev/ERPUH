	ПравилоКонвертации.ОбъектФормата                = "Документ.ЧекККМ"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_РасходныйКассовыйОрдер_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_РасходныйКассовыйОрдер_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_РасходныйКассовыйОрдер_ЧекККМ";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
