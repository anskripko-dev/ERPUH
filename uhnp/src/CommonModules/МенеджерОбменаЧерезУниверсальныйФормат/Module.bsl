Процедура ПКО_Документ_СЗ_КорректировкаДолга_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Префикс = "R";
	//++ Локализация
	Префикс = "С";
	//-- Локализация
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", Лев(ДанныеИБ.Номер, 5) + Префикс + Сред(ДанныеИБ.Номер, 7));
	
	ДанныеXDTO.Вставить("ВидОперации",        "СписаниеЗадолженности");
	ДанныеXDTO.Вставить("Валюта",             ВалютаРегламентированногоУчета(ДанныеИБ.Организация));
	ДанныеXDTO.Вставить("КурсДокумента",      1);
	ДанныеXDTO.Вставить("КратностьДокумента", 1);
	
	ДоходыРасходыАктивыПассивы = Неопределено;
	
	Если ДанныеИБ.ДоходыРасходыАктивыПассивы.Количество() > 0 Тогда
		ДоходыРасходыАктивыПассивы = ДанныеИБ.ДоходыРасходыАктивыПассивы[0];
		ВыгрузитьПодразделение(ДоходыРасходыАктивыПассивы, ДанныеXDTO);
	КонецЕсли;	
		
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	Если ДанныеИБ.РасчетыМеждуОрганизациями И ЗначениеЗаполнено(ДанныеИБ.Контрагент) Тогда
		ОрганизацияКонтрагента = ДанныеИБ.Контрагент;
		ВыгружаемыйКонтрагент = КонтрагентИзОрганизации(ОрганизацияКонтрагента, КомпонентыОбмена);
	Иначе
		ВыгружаемыйКонтрагент = ДанныеИБ.Контрагент;
	КонецЕсли;
	
	ДанныеЗадолженность = ВыгрузитьТаблицуЗадолженности("Задолженность",
		ДанныеИБ.Ссылка, ВыгружаемыйКонтрагент, ДанныеИБ.Организация, , КомпонентыОбмена);
	
	Если ДанныеЗадолженность.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Валюта",             ДанныеЗадолженность[0].ВалютаВзаиморасчетов);
		ДанныеXDTO.Вставить("КурсДокумента",      ДанныеЗадолженность[0].КурсВзаиморасчетов);
		ДанныеXDTO.Вставить("КратностьДокумента", ДанныеЗадолженность[0].КратностьВзаиморасчетов);
	КонецЕсли;
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности Тогда
		ДанныеXDTO.Вставить("КонтрагентКредитор",             ВыгружаемыйКонтрагент);
		ДанныеXDTO.Вставить("КонтрагентДебитор",              Справочники.Контрагенты.ПустаяСсылка());
		ДанныеXDTO.Вставить("СуммаДебиторскойЗадолженности",  0);
		ДанныеXDTO.Вставить("СуммаКредиторскойЗадолженности", ДанныеИБ.Задолженность.Итог("Сумма"));
		ДанныеXDTO.Вставить("КредиторскаяЗадолженность",      ДанныеЗадолженность);
		
		Если ЗначениеЗаполнено(ДоходыРасходыАктивыПассивы) Тогда
			//++ НЕ УТ
			СчетУчетаДанныеИБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
									ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета, 
									"СчетУчета");
			СчетУчета = СчетУчетаПоСтатье(
							ДоходыРасходыАктивыПассивы.Статья,
							ДанныеИБ.Организация,
							ДоходыРасходыАктивыПассивы.Подразделение,
							СчетУчетаДанныеИБ);
			ДанныеXDTO.Вставить("СчетДт", Неопределено);
			ДанныеXDTO.Вставить("СчетКт", СчетУчета);
			//-- НЕ УТ
			СтатьяДоходов = Неопределено;
			Если ТипЗнч(ДоходыРасходыАктивыПассивы.Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") Тогда
				СтатьяДоходов = ДоходыРасходыАктивыПассивы.Статья;
			//++ НЕ УТ
			
			//++ Локализация
			ИначеЕсли ТипЗнч(ДоходыРасходыАктивыПассивы.Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиАктивовПассивов") Тогда		
				Если ТипЗнч(ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто1) = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") Тогда
					СтатьяДоходов = ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто1;
				ИначеЕсли ТипЗнч(ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто2) = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") Тогда
					СтатьяДоходов = ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто2;
				ИначеЕсли ТипЗнч(ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто3) = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") Тогда
					СтатьяДоходов = ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто3;
				КонецЕсли;
			//-- Локализация
			
			//-- НЕ УТ
			КонецЕсли;
			
			ДанныеXDTO.Вставить("СтатьяДоходов", СтатьяДоходов);
			ДанныеXDTO.Вставить("СтатьяРасходов", Неопределено);
		КонецЕсли;
	Иначе
		ДанныеXDTO.Вставить("КонтрагентДебитор",  ВыгружаемыйКонтрагент);
		ДанныеXDTO.Вставить("КонтрагентКредитор", Справочники.Контрагенты.ПустаяСсылка());
		ДанныеXDTO.Вставить("СуммаДебиторскойЗадолженности", ДанныеИБ.Задолженность.Итог("Сумма"));
		ДанныеXDTO.Вставить("СуммаКредиторскойЗадолженности", 0);
		ДанныеXDTO.Вставить("ДебиторскаяЗадолженность",  ДанныеЗадолженность);
		
		Если ЗначениеЗаполнено(ДоходыРасходыАктивыПассивы) Тогда
			//++ НЕ УТ
			СчетУчетаДанныеИБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
									ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета,
									"СчетУчета");
			СчетУчета = СчетУчетаПоСтатье(
							ДоходыРасходыАктивыПассивы.Статья,
					 		ДанныеИБ.Организация,
					 		ДоходыРасходыАктивыПассивы.Подразделение,
					 		СчетУчетаДанныеИБ);
			ДанныеXDTO.Вставить("СчетДт", СчетУчета);
			ДанныеXDTO.Вставить("СчетКт", Неопределено);
		    //-- НЕ УТ
		    
			СтатьяРасходов = Неопределено;
			Если ТипЗнч(ДоходыРасходыАктивыПассивы.Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
				СтатьяРасходов = ДоходыРасходыАктивыПассивы.Статья;
			//++ НЕ УТ
			
			//++ Локализация
			ИначеЕсли ТипЗнч(ДоходыРасходыАктивыПассивы.Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиАктивовПассивов") Тогда
				Если ТипЗнч(ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто1) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
					СтатьяРасходов = ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто1;
				ИначеЕсли ТипЗнч(ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто2) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
					СтатьяРасходов = ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто2;
				ИначеЕсли ТипЗнч(ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто3) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
					СтатьяРасходов = ДоходыРасходыАктивыПассивы.НастройкаСчетовУчета.Субконто3;
				КонецЕсли;
			//-- Локализация
			
			//-- НЕ УТ
			КонецЕсли;
		
			ДанныеXDTO.Вставить("СтатьяДоходов", Неопределено);
			ДанныеXDTO.Вставить("СтатьяРасходов", СтатьяРасходов);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

