Процедура ПОД_Документ_ПередачаПереработчику_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
	
	// Может одновременно использоваться производство на стороне версии 2.4 и версии 2.5.
	// В этом случае ищем ссылку среди документов 2.4. Если не нашли, то используем правило для версии 2.5.
	Если ЗначениеФО("ИспользоватьПроизводствоНаСтороне2_5", КомпонентыОбмена) Тогда
		
		Если ЗначениеФО("ИспользоватьПроизводствоНаСтороне", КомпонентыОбмена)
			И ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПередачаСырьяПереработчику") <> Неопределено Тогда
			
			ИспользованиеПКО.Документ_ПередачаПереработчику_Получение = Истина;
		Иначе
			ИспользованиеПКО.Документ_ПередачаПереработчику25_Получение = Истина;
		КонецЕсли;
			
	Иначе
		ИспользованиеПКО.Документ_ПередачаПереработчику_Получение = Истина;
	КонецЕсли;
КонецПроцедуры

