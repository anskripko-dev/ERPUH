КонецПроцедуры
Процедура ПОД_Справочник_ОсновныеСредства_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Запрос = Новый Запрос;
	ОсновныеСредства = Новый Массив;
	ОсновныеСредства.Добавить(ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ОсновныеСредства", ОсновныеСредства);
	
	ДопСведения = Новый Структура("ВЭксплуатации, ДатаПринятияКУчету, НомерДокументаПринятияКУчету, НазваниеДокументаПринятияКУчету,
		|СобытиеПринятияКУчету, СпособПоступления, ПорядокПогашенияСтоимостиБУ, ПорядокПогашенияСтоимостиНУ, СчетУчетаБУ,
		|ПервоначальнаяСтоимостьБУ, ПервоначальнаяСтоимостьНУ, ТекущаяСтоимостьБУ, ТекущаяСтоимостьНУ, ТекущаяСтоимостьПР,
		|НачислятьАмортизациюБУ, СпособНачисленияАмортизацииБУ, СрокПолезногоИспользованияБУ, ГрафикАмортизацииБУ,
		|КоэффициентАмортизацииБУ, КоэффициентУскоренияБУ, ОбъемНаработкиБУ, ПоказательНаработки, НачислятьАмортизациюНУ,
		|СпециальныйКоэффициентНУ, СрокПолезногоИспользованияНУ, НакопленнаяАмортизацияБУ, НакопленнаяАмортизацияНУ,
		|НакопленнаяАмортизацияПР, НакопленнаяВыработка, СчетАмортизацииБУ, ДатаПоследнейМодернизации,
		|НазваниеДокументаМодернизации, НомерДокументаМодернизации, СобытиеМодернизации");
								
	Запрос.Текст = "ВЫБРАТЬ
		|	ПорядокУчетаОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ПорядокУчетаОС.ПоказательНаработки КАК ПоказательНаработки,
		|	ПорядокУчетаОС.ОбъемНаработки КАК ОбъемНаработки,
		|	ЕСТЬNULL(ПорядокОтраженияСтоимости.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)) КАК СчетУчета,
		|	ЕСТЬNULL(ПорядокОтраженияАмортизации.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)) КАК СчетУчетаАмортизации
		|ПОМЕСТИТЬ втПорядокУчетаОС
		|ИЗ
		|	РегистрСведений.ПорядокУчетаОС.СрезПоследних(, ОсновноеСредство В (&ОсновныеСредства)) КАК ПорядокУчетаОС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокОтраженияСтоимости
		|		ПО (ПорядокОтраженияСтоимости.АналитикаУчета = ПорядокУчетаОС.ГруппаФинансовогоУчета)
		|			И (ПорядокОтраженияСтоимости.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|			И (ПорядокОтраженияСтоимости.МестоУчета = НЕОПРЕДЕЛЕНО)
		|			И (ПорядокОтраженияСтоимости.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.СтоимостьВНА))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокОтраженияАмортизации
		|		ПО (ПорядокОтраженияАмортизации.АналитикаУчета = ПорядокУчетаОС.ГруппаФинансовогоУчета)
		|			И (ПорядокОтраженияАмортизации.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|			И (ПорядокОтраженияАмортизации.МестоУчета = НЕОПРЕДЕЛЕНО)
		|			И (ПорядокОтраженияАмортизации.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АмортизацияВНА))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Организация КАК Организация,
		|	ХозрасчетныйОстатки.Субконто1 КАК ОсновноеСредство,
		|	ХозрасчетныйОстатки.СуммаОстаток КАК ТекущаяСтоимостьБУ,
		|	ХозрасчетныйОстатки.СуммаНУОстаток КАК ТекущаяСтоимостьНУ,
		|	ХозрасчетныйОстатки.СуммаПРОстаток КАК ТекущаяСтоимостьПР,
		|	0 КАК НакопленнаяАмортизацияБУ,
		|	0 КАК НакопленнаяАмортизацияНУ,
		|	0 КАК НакопленнаяАмортизацияПР
		|ПОМЕСТИТЬ втХозрасчетныйОстатки
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			,
		|			Счет В
		|				(ВЫБРАТЬ
		|					втПорядокУчетаОС.СчетУчета
		|				ИЗ
		|					втПорядокУчетаОС),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ОсновныеСредства),
		|			) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Субконто1 В(&ОсновныеСредства)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Организация,
		|	ХозрасчетныйОстатки.Субконто1,
		|	0,
		|	0,
		|	0,
		|	-ХозрасчетныйОстатки.СуммаОстаток,
		|	-ХозрасчетныйОстатки.СуммаНУОстаток,
		|	-ХозрасчетныйОстатки.СуммаПРОстаток
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			,
		|			Счет В
		|				(ВЫБРАТЬ
		|					втПорядокУчетаОС.СчетУчетаАмортизации
		|				ИЗ
		|					втПорядокУчетаОС),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ОсновныеСредства),
		|			) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Субконто1 В(&ОсновныеСредства)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втХозрасчетныйОстатки.Организация КАК Организация,
		|	втХозрасчетныйОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СУММА(втХозрасчетныйОстатки.ТекущаяСтоимостьБУ) КАК ТекущаяСтоимостьБУ,
		|	СУММА(втХозрасчетныйОстатки.ТекущаяСтоимостьНУ) КАК ТекущаяСтоимостьНУ,
		|	СУММА(втХозрасчетныйОстатки.ТекущаяСтоимостьПР) КАК ТекущаяСтоимостьПР,
		|	СУММА(втХозрасчетныйОстатки.НакопленнаяАмортизацияБУ) КАК НакопленнаяАмортизацияБУ,
		|	СУММА(втХозрасчетныйОстатки.НакопленнаяАмортизацияНУ) КАК НакопленнаяАмортизацияНУ,
		|	СУММА(втХозрасчетныйОстатки.НакопленнаяАмортизацияПР) КАК НакопленнаяАмортизацияПР
		|ПОМЕСТИТЬ втХозрасчетныйОстаткиСгруппированные
		|ИЗ
		|	втХозрасчетныйОстатки КАК втХозрасчетныйОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	втХозрасчетныйОстатки.Организация,
		|	втХозрасчетныйОстатки.ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПервоначальныеСведенияОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ПервоначальныеСведенияОС.Организация КАК Организация,
		|	ЕСТЬNULL(ПорядокУчетаОСБУ.СостояниеБУ, ЗНАЧЕНИЕ(Перечисление.СостоянияОС.НеПринятоКУчету)) В (ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету), ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКЗабалансовомуУчету)) КАК ВЭксплуатации,
		|	ЕСТЬNULL(ПорядокУчетаОСБУ.АмортизационнаяГруппа, """") КАК АмортизационнаяГруппа,
		|	ПервоначальныеСведенияОС.ДатаВводаВЭксплуатациюБУ КАК ДатаПринятияКУчету,
		|	СобытияОСОрганизацийПринятиеКУчету.НомерДокумента КАК НомерДокументаПринятияКУчету,
		|	СобытияОСОрганизацийПринятиеКУчету.НазваниеДокумента КАК НазваниеДокументаПринятияКУчету,
		|	СобытияОСОрганизацийПринятиеКУчету.Событие КАК СобытиеПринятияКУчету,
		|	ПервоначальныеСведенияОС.СпособПоступления КАК СпособПоступления,
		|	ПервоначальныеСведенияОС.ПорядокУчетаБУ КАК ПорядокПогашенияСтоимостиБУ,
		|	ПервоначальныеСведенияОС.ПорядокУчетаНУ КАК ПорядокПогашенияСтоимостиНУ,
		|	втПорядокУчетаОС.СчетУчета.Код КАК СчетУчетаБУ,
		|	ПервоначальныеСведенияОС.ПервоначальнаяСтоимостьБУ КАК ПервоначальнаяСтоимостьБУ,
		|	ПервоначальныеСведенияОС.ПервоначальнаяСтоимостьНУ КАК ПервоначальнаяСтоимостьНУ,
		|	втХозрасчетныйОстатки.ТекущаяСтоимостьБУ КАК ТекущаяСтоимостьБУ,
		|	втХозрасчетныйОстатки.ТекущаяСтоимостьНУ КАК ТекущаяСтоимостьНУ,
		|	втХозрасчетныйОстатки.ТекущаяСтоимостьПР КАК ТекущаяСтоимостьПР,
		|	ЕСТЬNULL(ПорядокУчетаОСБУ.НачислятьАмортизациюБУ, ЛОЖЬ) КАК НачислятьАмортизациюБУ,
		|	ПервоначальныеСведенияОС.МетодНачисленияАмортизацииБУ КАК СпособНачисленияАмортизацииБУ,
		|	ПараметрыАмортизацииОСБУ.СрокПолезногоИспользованияБУ КАК СрокПолезногоИспользованияБУ,
		|	ПараметрыАмортизацииОСБУ.ГрафикАмортизации КАК ГрафикАмортизацииБУ,
		|	ПараметрыАмортизацииОСБУ.КоэффициентАмортизацииБУ КАК КоэффициентАмортизацииБУ,
		|	ПараметрыАмортизацииОСБУ.КоэффициентУскорения КАК КоэффициентУскоренияБУ,
		|	втПорядокУчетаОС.ОбъемНаработки КАК ОбъемНаработкиБУ,
		|	втПорядокУчетаОС.ПоказательНаработки КАК ПоказательНаработки,
		|	ЕСТЬNULL(ПорядокУчетаОСБУ.НачислятьАмортизациюНУ, ЛОЖЬ) КАК НачислятьАмортизациюНУ,
		|	ПараметрыАмортизацииОСБУ.СпециальныйКоэффициент КАК СпециальныйКоэффициентНУ,
		|	ПараметрыАмортизацииОСБУ.СрокПолезногоИспользованияНУ КАК СрокПолезногоИспользованияНУ,
		|	втХозрасчетныйОстатки.НакопленнаяАмортизацияБУ КАК НакопленнаяАмортизацияБУ,
		|	втХозрасчетныйОстатки.НакопленнаяАмортизацияНУ КАК НакопленнаяАмортизацияНУ,
		|	втХозрасчетныйОстатки.НакопленнаяАмортизацияПР КАК НакопленнаяАмортизацияПР,
		|	НаработкиОбъектовЭксплуатации.Значение КАК НакопленнаяВыработка,
		|	втПорядокУчетаОС.СчетУчетаАмортизации.Код КАК СчетАмортизацииБУ,
		|	СобытияОСОрганизацийМодернизация.Период КАК ДатаПоследнейМодернизации,
		|	СобытияОСОрганизацийМодернизация.НазваниеДокумента КАК НазваниеДокументаМодернизации,
		|	СобытияОСОрганизацийМодернизация.НомерДокумента КАК НомерДокументаМодернизации,
		|	СобытияОСОрганизацийМодернизация.Событие КАК СобытиеМодернизации
		|ИЗ
		|	РегистрСведений.ПервоначальныеСведенияОС.СрезПоследних(, ОсновноеСредство В (&ОсновныеСредства)) КАК ПервоначальныеСведенияОС
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПорядокУчетаОС КАК втПорядокУчетаОС
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаработкиОбъектовЭксплуатации.СрезПоследних(, ОбъектЭксплуатации В (&ОсновныеСредства)) КАК НаработкиОбъектовЭксплуатации
		|			ПО втПорядокУчетаОС.ОсновноеСредство = НаработкиОбъектовЭксплуатации.ОбъектЭксплуатации
		|				И втПорядокУчетаОС.ПоказательНаработки = НаработкиОбъектовЭксплуатации.ПоказательНаработки
		|		ПО ПервоначальныеСведенияОС.ОсновноеСредство = втПорядокУчетаОС.ОсновноеСредство
		|		ЛЕВОЕ СОЕДИНЕНИЕ втХозрасчетныйОстаткиСгруппированные КАК втХозрасчетныйОстатки
		|		ПО ПервоначальныеСведенияОС.ОсновноеСредство = втХозрасчетныйОстатки.ОсновноеСредство
		|			И ПервоначальныеСведенияОС.Организация = втХозрасчетныйОстатки.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОСОрганизаций.СрезПоследних(
		|				,
		|				ОсновноеСредство В (&ОсновныеСредства)
		|					И Событие.ВидСобытияОС В (ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету), ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчетуСВводомВЭксплуатацию))) КАК СобытияОСОрганизацийПринятиеКУчету
		|		ПО ПервоначальныеСведенияОС.ОсновноеСредство = СобытияОСОрганизацийПринятиеКУчету.ОсновноеСредство
		|			И ПервоначальныеСведенияОС.Организация = СобытияОСОрганизацийПринятиеКУчету.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОСОрганизаций.СрезПоследних(
		|				,
		|				ОсновноеСредство В (&ОсновныеСредства)
		|					И Событие.ВидСобытияОС = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Модернизация)) КАК СобытияОСОрганизацийМодернизация
		|		ПО ПервоначальныеСведенияОС.ОсновноеСредство = СобытияОСОрганизацийМодернизация.ОсновноеСредство
		|			И ПервоначальныеСведенияОС.Организация = СобытияОСОрганизацийМодернизация.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБУ.СрезПоследних(, ОсновноеСредство В (&ОсновныеСредства)) КАК ПараметрыАмортизацииОСБУ
		|		ПО ПервоначальныеСведенияОС.ОсновноеСредство = ПараметрыАмортизацииОСБУ.ОсновноеСредство
		|			И ПервоначальныеСведенияОС.Организация = ПараметрыАмортизацииОСБУ.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокУчетаОСБУ.СрезПоследних(, ОсновноеСредство В (&ОсновныеСредства)) КАК ПорядокУчетаОСБУ
		|		ПО ПервоначальныеСведенияОС.ОсновноеСредство = ПорядокУчетаОСБУ.ОсновноеСредство
		|			И ПервоначальныеСведенияОС.Организация = ПорядокУчетаОСБУ.Организация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
	
		ЗаполнитьЗначенияСвойств(ДопСведения, Выборка);
		Для Каждого ЭлементСтруктуры Из ДопСведения Цикл
			Если ЗначениеЗаполнено(ЭлементСтруктуры.Значение) Тогда
				ДанныеИБ.ДополнительныеСвойства.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		    КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
КонецПроцедуры

