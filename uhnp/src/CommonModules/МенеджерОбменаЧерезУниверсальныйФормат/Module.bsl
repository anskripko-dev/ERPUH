Процедура ПКО_Документ_СписаниеИзЭксплуатации_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьПодразделение(ДанныеИБ, ДанныеXDTO);
	
	ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Ложь, Ложь);
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	СписаниеИзЭксплуатацииТовары.НомерСтроки КАК НомерСтрокиДокумента,
		|	СписаниеИзЭксплуатацииТовары.Номенклатура КАК Номенклатура,
		|	&ТекстЗапросаХарактеристика,
		|	СписаниеИзЭксплуатацииТовары.Количество КАК Количество,
		|	СписаниеИзЭксплуатацииТовары.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СписаниеИзЭксплуатацииТовары.Партия КАК ПартияТМЦВЭксплуатации,
		|	ВЫБОР
		|		КОГДА СписаниеИзЭксплуатацииТовары.Партия.Документ ССЫЛКА Документ.ВнутреннееПотребление
		|			ТОГДА СписаниеИзЭксплуатацииТовары.Партия.Документ
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК ДокументПередачи,
		|	СписаниеИзЭксплуатацииТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЕСТЬNULL(ВнутреннееПотреблениеВидыЗапасов.ВидЗапасов, ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.Товар)) КАК ТипЗапасов
		|ИЗ
		|	Документ.СписаниеИзЭксплуатации.Товары КАК СписаниеИзЭксплуатацииТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотребление.ВидыЗапасов КАК ВнутреннееПотреблениеВидыЗапасов
		|		ПО СписаниеИзЭксплуатацииТовары.Партия.Документ = ВнутреннееПотреблениеВидыЗапасов.Ссылка
		|			И СписаниеИзЭксплуатацииТовары.Номенклатура = ВнутреннееПотреблениеВидыЗапасов.АналитикаУчетаНоменклатуры
		|ГДЕ
		|	СписаниеИзЭксплуатацииТовары.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтрокиДокумента";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "СписаниеИзЭксплуатацииТовары"));
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Товары = Запрос.Выполнить().Выгрузить();
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары, Истина, Ложь);
	ДанныеXDTO.Вставить("Товары", Товары);
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		ИмяТаблицы = "Документ.СписаниеИзЭксплуатации.Товары"; 
		ИдентификаторыИзВидовЗапасов = Истина;
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов); 
	КонецЕсли;
КонецПроцедуры

