	ДобавитьПКС(СвойстваТЧ, "СерияНомерТСД",       "", 1);
	ДобавитьПКС(СвойстваТЧ, "СтавкаНДС",           "", 1, "СправочникСсылка_СтавкиНДС_Получение");
	ДобавитьПКС(СвойстваТЧ, "СуммаАкциза",         "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаНДС",            "", 1);
	ДобавитьПКС(СвойстваТЧ, "ТвердаяСтавкаАкциза", "", 1);
	ДобавитьПКС(СвойстваТЧ, "ФактурнаяСтоимость",  "", 1);
	ДобавитьПКС(СвойстваТЧ, "Характеристика",      "", 1, "Справочник_ХарактеристикиНоменклатуры");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "УчастникиСделки",     "");
	ДобавитьПКС(СвойстваТЧ, "ДатаДоговора",      "", 1);
	ДобавитьПКС(СвойстваТЧ, "ДатаСпецификации",  "", 1);
	ДобавитьПКС(СвойстваТЧ, "НомерДоговора",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "НомерСпецификации", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Покупатель",        "", 1, "Справочник_Контрагенты_Получение");
	ДобавитьПКС(СвойстваТЧ, "Продавец",          "", 1, "Справочник_Контрагенты_Получение");
	ДобавитьПКС(СвойстваТЧ, "РольПокупателя",    "", 1);
	ДобавитьПКС(СвойстваТЧ, "РольПродавца",      "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("Дата,Номер,Организация");
КонецПроцедуры
Процедура ПКО_Документ_ЗаявлениеОВвозеТоваров_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	Если ДанныеXDTO.Свойство("ИсправляемыйДокумент") И ЗначениеЗаполнено(ДанныеXDTO.ИсправляемыйДокумент) Тогда
		
		Инструкция = Новый Структура("ИмяПКО", "Документ_ЗаявлениеОВвозеТоваров_Получение");
		
		Инструкция.Вставить("Значение", ДанныеXDTO.ИсправляемыйДокумент);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ИсправляемыйДокумент", Инструкция);
		
	КонецЕсли; 
	
	Если ДанныеXDTO.Свойство("СторнируемыйДокумент") И ЗначениеЗаполнено(ДанныеXDTO.СторнируемыйДокумент) Тогда
		
		Инструкция = Новый Структура("ИмяПКО", "Документ_ЗаявлениеОВвозеТоваров_Получение");
		
		Инструкция.Вставить("Значение", ДанныеXDTO.СторнируемыйДокумент);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ИсправляемыйДокумент", Инструкция);
		
	КонецЕсли;
	
	ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	#Область Товары
	
	Если ДанныеXDTO.Свойство("Товары")
		И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда
		
		МассивСтрокТовары = Новый Массив;
		
		ПравилаЗаполнения = Новый Соответствие;
		
		ПравилаЗаполнения.Вставить("ВесНеттоКг",         "ВесНеттоКг");
		ПравилаЗаполнения.Вставить("ДатаПринятияНаУчет", "ДатаПринятияНаУчет");
		ПравилаЗаполнения.Вставить("ДатаСчетаФактуры",   "ДатаСчетаФактуры");
		ПравилаЗаполнения.Вставить("ДатаТСД",            "ДатаТСД");
		ПравилаЗаполнения.Вставить("ЕдиницаИзмерения",   "ЕдиницаИзмерения");
		ПравилаЗаполнения.Вставить("КодВидаТранспорта",  "КодВидаТранспорта");
		ПравилаЗаполнения.Вставить("КодТНВЭД",           "КодТНВЭД");
		ПравилаЗаполнения.Вставить("Количество",         "Количество");
		ПравилаЗаполнения.Вставить("КоличествоПоТНВЭД",  "КоличествоПоТНВЭД");
		ПравилаЗаполнения.Вставить("НалоговаяБазаАкцизы","НалоговаяБазаАкцизы");
		ПравилаЗаполнения.Вставить("НалоговаяБазаНДС",   "НалоговаяБазаНДС");
		ПравилаЗаполнения.Вставить("Номенклатура",       "Номенклатура");
		ПравилаЗаполнения.Вставить("НомерСчетаФактуры",  "НомерСчетаФактуры");
		ПравилаЗаполнения.Вставить("НомерГТД",           "НомерТД");
		ПравилаЗаполнения.Вставить("СерияНомерТСД",      "СерияНомерТСД");
		ПравилаЗаполнения.Вставить("СтавкаНДС",          "СтавкаНДС");
		ПравилаЗаполнения.Вставить("ТвердаяСтавкаАкциза","ТвердаяСтавкаАкциза"); 
		ПравилаЗаполнения.Вставить("СуммаАкциза",        "СуммаАкциза");
		ПравилаЗаполнения.Вставить("ФактурнаяСтоимость", "ФактурнаяСтоимость");
		
		Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
			ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
		КонецЕсли;
		Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
			ПравилаЗаполнения.Вставить("Серия",              "Серия");
		КонецЕсли;
		
		Для Каждого Строка Из ДанныеXDTO.Товары Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			Если ЗначениеЗаполнено(Строка.Договор) Тогда
				
				ИмяПКО = "Справочник_ДоговорыКонтрагентов_Получение";
				
				Если ТипЗнч(Строка.Договор) = Тип("Структура")
					И Не Строка.Договор.Свойство("Ссылка") Тогда
					ИмяПКО = "Справочник_ДоговорыКонтрагентов_ИзСтруктуры_Получ";
				КонецЕсли;
				
				СтруктураДанныхСтроки.Вставить("Договор", Новый Структура("Значение, ИмяПКО", Строка.Договор, ИмяПКО));
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Строка.ДокументПоступления) Тогда
				
				ИмяПКО = "Документ_ПоступлениеТоваровУслуг_Получение";
				
				СтруктураДанныхСтроки.Вставить("ДокументПоступления", Новый Структура("Значение, ИмяПКО", 
				Строка.ДокументПоступления, ИмяПКО));
			КонецЕсли;
			
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
			
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
		
		Если МассивСтрокТовары.Количество() > 0 Тогда
			
			ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
			
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти 
	
	#Область СведенияОДокументах
	
	Если ДанныеXDTO.Свойство("СведенияОДокументах")
		И ЗначениеЗаполнено(ДанныеXDTO.СведенияОДокументах) Тогда
		
		МассивСтрокСведенияОДокументах = Новый Массив;
		
		ПравилаЗаполнения = Новый Соответствие;  
		
		ПравилаЗаполнения.Вставить("Дата",       "Дата");
		ПравилаЗаполнения.Вставить("Наименование",         "Наименование");
		ПравилаЗаполнения.Вставить("Номер",              "Номер");
		
		Для Каждого Строка Из ДанныеXDTO.СведенияОДокументах Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			МассивСтрокСведенияОДокументах.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
		
		Если МассивСтрокСведенияОДокументах.Количество() > 0 Тогда
			
			ПолученныеДанные.ДополнительныеСвойства.Вставить("СведенияОДокументах", МассивСтрокСведенияОДокументах);
			
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область Спецификации
	
	Если ДанныеXDTO.Свойство("Спецификации")
		И ЗначениеЗаполнено(ДанныеXDTO.Спецификации) Тогда
		
		МассивСтрокСпецификации = Новый Массив;
		
		ПравилаЗаполнения = Новый Соответствие; 
		
		ПравилаЗаполнения.Вставить("ДатаСпецификации",       "ДатаСпецификации");
		ПравилаЗаполнения.Вставить("НомерСпецификации",         "НомерСпецификации");
		
		Для каждого Строка Из ДанныеXDTO.Спецификации Цикл
		
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			МассивСтрокСпецификации.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
		
		Если МассивСтрокСпецификации.Количество() > 0 Тогда
			
			ПолученныеДанные.ДополнительныеСвойства.Вставить("Спецификации", МассивСтрокСпецификации);
			
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область УчастникиСделки
	
	Если ДанныеXDTO.Свойство("УчастникиСделки")
		И ЗначениеЗаполнено(ДанныеXDTO.УчастникиСделки) Тогда
		
		МассивСтрокУчастникиСделки = Новый Массив;
		
		ПравилаЗаполнения = Новый Соответствие;
		
		ПравилаЗаполнения.Вставить("ДатаДоговора",       "ДатаДоговора");
		ПравилаЗаполнения.Вставить("ДатаСпецификации",         "ДатаСпецификации");
		ПравилаЗаполнения.Вставить("НомерДоговора",              "НомерДоговора");
		ПравилаЗаполнения.Вставить("НомерСпецификации",               "НомерСпецификации");
		ПравилаЗаполнения.Вставить("Покупатель",           "Покупатель");
		ПравилаЗаполнения.Вставить("Продавец",          "Продавец");
		ПравилаЗаполнения.Вставить("РольПокупателя", "РольПокупателяСтрокой");
		ПравилаЗаполнения.Вставить("РольПродавца",       "РольПродавцаСтрокой");
		
		Для каждого Строка Из ДанныеXDTO.УчастникиСделки Цикл
		
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			Если СтруктураДанныхСтроки.Свойство("РольПокупателяСтрокой") 
				И ЗначениеЗаполнено(СтруктураДанныхСтроки.РольПокупателяСтрокой) Тогда
				
				РольПокупателя = ЗначениеПеречисленияПоИмени("СубъектыГражданскоПравовыхОтношений", 
					СтруктураДанныхСтроки.РольПокупателяСтрокой);
					
				Если РольПокупателя <> Неопределено Тогда
						
					СтруктураДанныхСтроки.Вставить("РольПокупателя", РольПокупателя);
					
				КонецЕсли;
				
			КонецЕсли; 
			
			Если СтруктураДанныхСтроки.Свойство("РольПродавцаСтрокой") 
				И ЗначениеЗаполнено(СтруктураДанныхСтроки.РольПродавцаСтрокой) Тогда
				
				РольПродавца = ЗначениеПеречисленияПоИмени("СубъектыГражданскоПравовыхОтношений", 
					СтруктураДанныхСтроки.РольПродавцаСтрокой);
				
				Если РольПродавца <> Неопределено Тогда
					
					СтруктураДанныхСтроки.Вставить("РольПродавца", РольПродавца);
					
				КонецЕсли;
				
			КонецЕсли;
			
			МассивСтрокУчастникиСделки.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
		
		Если МассивСтрокУчастникиСделки.Количество() > 0 Тогда
			
			ПолученныеДанные.ДополнительныеСвойства.Вставить("УчастникиСделки", МассивСтрокУчастникиСделки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
КонецПроцедуры
Процедура ПКО_Документ_ЗаявлениеОВвозеТоваров_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
						ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
	Для Каждого СтрокаТовары Из ПолученныеДанные.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовары.НалоговаяБазаНДС)
			И ЗначениеЗаполнено(СтрокаТовары.СтавкаНДС)
			И Не ЗначениеЗаполнено(СтрокаТовары.СуммаНДС) Тогда
			СтрокаТовары.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
			СтрокаТовары.НалоговаяБазаНДС,
			УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(СтрокаТовары.СтавкаНДС),
			Ложь);
		КонецЕсли;  
		Если ЗначениеЗаполнено(СтрокаТовары.СуммаАкциза) Тогда 
			ИспользоватьАкцизы  = Истина;
		КонецЕсли;
	КонецЦикла;
	ПолученныеДанные.ИспользоватьАкцизы = ИспользоватьАкцизы;
		
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	МассивКлючевыхПолей = Новый Массив;
	
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("КодТНВЭД");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("ЕдиницаИзмерения");
	МассивКлючевыхПолей.Добавить("КоличествоПоТНВЭД");
	МассивКлючевыхПолей.Добавить("ФактурнаяСтоимость");
	МассивКлючевыхПолей.Добавить("СерияНомерТСД");
	МассивКлючевыхПолей.Добавить("ДатаТСД");
	МассивКлючевыхПолей.Добавить("НомерСчетаФактуры");
	МассивКлючевыхПолей.Добавить("ДатаСчетаФактуры");
	МассивКлючевыхПолей.Добавить("ДатаПринятияНаУчет");
	МассивКлючевыхПолей.Добавить("НалоговаяБазаНДС");
	МассивКлючевыхПолей.Добавить("СтавкаНДС");
	МассивКлючевыхПолей.Добавить("ДокументПоступления");
	МассивКлючевыхПолей.Добавить("НомерТД");
	
	КолонкиДляИсключения = "АдвалорнаяСтавкаАкциза, АналитикаУчетаНоменклатуры, Валюта, ВидТранспорта, ЗакупкаПодДеятельность, НоменклатураПартнера, Подразделение,
		|СтатСтоимостьДолларыСША, Склад, СуммаНДС, Содержание, Договор";
	
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(ПолученныеДанные.Товары, ДанныеИБ.Товары,
		МассивКлючевыхПолей,, КолонкиДляИсключения);
	
	ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
	Если ЗначениеЗаполнено(ПолученныеДанные.УчастникиСделки) Тогда
		ДанныеИБ.УчастникиСделки.Загрузить(ПолученныеДанные.УчастникиСделки.Выгрузить());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.Спецификации) Тогда
		ДанныеИБ.Спецификации.Загрузить(ПолученныеДанные.Спецификации.Выгрузить());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.СведенияОДокументах) Тогда
		ДанныеИБ.СведенияОДокументах.Загрузить(ПолученныеДанные.СведенияОДокументах.Выгрузить());
	КонецЕсли;
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры

Процедура ДобавитьПКО_Документ_ИнвентаризационнаяОпись_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_ИнвентаризационнаяОпись_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ИнвентаризационнаяОпись;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ИнвентаризацияТоваров"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_ИнвентаризационнаяОпись_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_ИнвентаризационнаяОпись_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Дата",          "Дата");
	ДобавитьПКС(СвойстваШапки, "ДатаНачала",    "ДатаНачалаИнвентаризации");
	ДобавитьПКС(СвойстваШапки, "ДатаОкончания", "ДатаОкончанияИнвентаризации");
	ДобавитьПКС(СвойстваШапки, "Комментарий",   "Комментарий");
	ДобавитьПКС(СвойстваШапки, "Номер",         "Номер");
