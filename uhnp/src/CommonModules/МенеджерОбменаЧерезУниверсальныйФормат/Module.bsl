				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета.РасчетыСДебиторамиКомиссия, "Код"));
		КонецЕсли;
	
		Если СчетУчета.Свойство("АрендныеОбязательства") Тогда
			ДанныеXDTO.Вставить(
				"СчетУчетаРасчетовСЛизингодателемАрендныеОбязательства", 
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета.АрендныеОбязательства, "Код"));
		КонецЕсли;
	
		Если СчетУчета.Свойство("ВыкупнаяСтоимость") Тогда
			ДанныеXDTO.Вставить(
				"СчетУчетаРасчетовСЛизингодателемВыкупПредметаЛизинга", 
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета.ВыкупнаяСтоимость, "Код"));
		КонецЕсли;
	
		Если СчетУчета.Свойство("УслугаПоАренде") Тогда
			ДанныеXDTO.Вставить(
				"СчетУчетаРасчетовСЛизингодателемЛизинговыеУслуги", 
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета.УслугаПоАренде, "Код"));
		КонецЕсли;
	
		Если СчетУчета.Свойство("ОбеспечительныйПлатеж") Тогда
			ДанныеXDTO.Вставить(
				"СчетУчетаРасчетовСЛизингодателемОбеспечительныйПлатеж", 
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета.ОбеспечительныйПлатеж, "Код"));
		КонецЕсли;
		
	КонецЕсли;
