Процедура ПКО_Документ_КорректировкаПриобретения_Задолженность_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Префикс = "KP";
	//++ Локализация
	Префикс = "КП";
	//-- Локализация
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", Лев(ДанныеИБ.Номер, 5) + Префикс + Сред(ДанныеИБ.Номер, 8));
	ДанныеXDTO.Вставить("Валюта",             ВалютаРегламентированногоУчета(ДанныеИБ.Организация));
	ДанныеXDTO.Вставить("КурсДокумента",      1);
	ДанныеXDTO.Вставить("КратностьДокумента", 1);
	ДанныеXDTO.Вставить("ВидОперации",        "СписаниеЗадолженности");
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	ДанныеЗадолженность = ВыгрузитьТаблицуЗадолженности("КорректировкаЗадолженности",
		ДанныеИБ.Ссылка, ДанныеИБ.Контрагент, ДанныеИБ.Организация, , КомпонентыОбмена);
	
	Если ДанныеЗадолженность.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Валюта",             ДанныеЗадолженность[0].ВалютаВзаиморасчетов);
		ДанныеXDTO.Вставить("КурсДокумента",      ДанныеЗадолженность[0].КурсВзаиморасчетов);
		ДанныеXDTO.Вставить("КратностьДокумента", ДанныеЗадолженность[0].КратностьВзаиморасчетов);
	КонецЕсли;
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.КорректировкаПриобретенияУвеличениеЗадолженностиСводно Тогда
		ДанныеXDTO.Вставить("ДебиторскаяЗадолженность",  ДанныеЗадолженность);
		ДанныеXDTO.Вставить("КонтрагентКредитор", Справочники.Контрагенты.ПустаяСсылка());
	    ДанныеXDTO.Вставить("СуммаКредиторскойЗадолженности", 0); 
	    ДанныеXDTO.Вставить("СуммаДебиторскойЗадолженности", ДанныеИБ.КорректировкаЗадолженности.Итог("СуммаКорректировки"));
	    //++ НЕ УТ
	
		СчетУчета = СчетУчетаПоСтатье(
							ДанныеИБ.СтатьяРасходов,
							ДанныеИБ.Организация,
							ДанныеИБ.Подразделение);
		ДанныеXDTO.Вставить("СчетКт", Неопределено);
		ДанныеXDTO.Вставить("СчетДт", СчетУчета); 
		//-- НЕ УТ
	
	Иначе 
		ДанныеXDTO.Вставить("КредиторскаяЗадолженность",  ДанныеЗадолженность);
		ДанныеXDTO.Вставить("КонтрагентДебитор", Справочники.Контрагенты.ПустаяСсылка());
		ДанныеXDTO.Вставить("СуммаДебиторскойЗадолженности", 0); 
		ДанныеXDTO.Вставить("СуммаКредиторскойЗадолженности", ДанныеИБ.КорректировкаЗадолженности.Итог("СуммаКорректировки")); 
		//++ НЕ УТ
		СчетУчета = СчетУчетаПоСтатье(
							ДанныеИБ.СтатьяДоходов,
							ДанныеИБ.Организация,
							ДанныеИБ.Подразделение);
	
		ДанныеXDTO.Вставить("СчетДт", Неопределено);
		ДанныеXDTO.Вставить("СчетКт", СчетУчета);
	    //-- НЕ УТ
	КонецЕсли;
	//++ Локализация
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		ИмяТаблицы = "Документ.КорректировкаПриобретения.Расхождения"; 
		ИдентификаторыИзВидовЗапасов = Истина;
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов);
	КонецЕсли;
	//-- Локализация
КонецПроцедуры

