//-- Устарело_Переработка24

//++ Локализация
Процедура ОтложеннаяОбработка_ВозвратТоваровОтКлиента_ЧекККМ(Объект, КомпонентыОбмена)
	Если Не ЗначениеЗаполнено(Объект.ДокументРеализации) Тогда
		Возврат;
	КонецЕсли;
	
	// Реквизиты, которые будут заполнены из сообщения обмена
	ОбъектТоварыЧек = Объект.Товары.Выгрузить();
	Объект.Товары.Очистить();
	ОбъектШапкаЧек = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "Дата, Склад, Контрагент, Партнер, СуммаДокумента");
	Для Каждого Элемент Из ОбъектШапкаЧек Цикл
		// пустые значения из сообщения обмена не будем переносить
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			ОбъектШапкаЧек.Удалить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", Объект.ДокументРеализации);
	ДанныеЗаполнения.Вставить("ЗаполнитьПоРеализацииТоваров", Истина);
	
	ПараметрыОформления = Новый Структура;
	ПараметрыОформления.Вставить("ВводитьНаОснованииНепроведенного", Не Объект.ДокументРеализации.Проведен);
	
	ДанныеЗаполнения.Вставить("ПараметрыОформления", ПараметрыОформления);
	ДанныеЗаполнения.Вставить("ДокументОснование", Объект.ДокументРеализации);
	
	Объект.Заполнить(ДанныеЗаполнения);
	Объект.Товары.Очистить();
	Объект.Товары.Загрузить(ОбъектТоварыЧек);
	
	ЗаполнитьЗначенияСвойств(Объект, ОбъектШапкаЧек);
	
	Для каждого Строка Из Объект.Товары Цикл
		Строка.ДокументРеализации = Объект.ДокументРеализации;
		Строка.СпособОпределенияСебестоимости = Перечисления.СпособыОпределенияСебестоимостиВозврата.ИзДокументаПродажи;
	КонецЦикла; 
	
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.Товары, СтруктураДействий);
	
	Если Объект.РасшифровкаПлатежа.Количество() = 1 Тогда
		Объект.РасшифровкаПлатежа[0].Сумма = Объект.СуммаДокумента;
		Объект.РасшифровкаПлатежа[0].СуммаВзаиморасчетов = Объект.СуммаДокумента;
	КонецЕсли;
	
	ДокументыПоЧекамККМ = КомпонентыОбмена.ПараметрыКонвертации.ДокументыПоЧекамККМ; // ТаблицаЗначений
	НоваяСтрока = ДокументыПоЧекамККМ.Добавить();
	НоваяСтрока.ЗаказКлиента = Объект.ДокументРеализации.ЗаказКлиента;
	НоваяСтрока.ВозвратТоваровОтКлиента = Объект.Ссылка;
КонецПроцедуры
//-- Локализация
Процедура ОтложеннаяОбработка_ВозвратТоваровОтПокупателя(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	ВозвратЧерезКомиссионера = ВозвратТоваровЧерезКомиссионера(Объект.ХозяйственнаяОперация);
	
	Если ВозвратЧерезКомиссионера Тогда
		
		Если Не ЗначениеЗаполнено(Объект.КлиентПартнер) Тогда
			Объект.КлиентПартнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.КлиентКонтрагент);
		КонецЕсли;
		
		Если Не (ЗначениеЗаполнено(Объект.КлиентДоговор) И ОбщегоНазначения.СсылкаСуществует(Объект.КлиентДоговор)) Тогда
			Объект.КлиентДоговор = Неопределено;  
		КонецЕсли; 
		
	КонецЕсли;
	
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	ЗаполнениеСоглашенияСКлиентомВШапкеДокумента(Объект);
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	
	Если Не ЗначениеЗаполнено(Объект.ЗаявкаНаВозвратТоваровОтКлиента) И НЕ ЗначениеЗаполнено(Объект.ВариантПриемкиТоваров) Тогда
		Объект.ВариантПриемкиТоваров = Константы.ВариантПриемкиТоваров.Получить();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СпособКомпенсации) Тогда
		Объект.СпособКомпенсации = Перечисления.СпособыКомпенсацииВозвратовТоваров.ВернутьДенежныеСредства;
	КонецЕсли;
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
	
	ЗаполнитьПорядокРасчетов(Объект, Объект.Договор, Объект.Соглашение);
КонецПроцедуры
Процедура ОтложеннаяОбработка_ВозвратТоваровПоставщику(Объект, ОбъектМодифицирован, КомпонентыОбмена)
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	ЗаполнениеСоглашенияСПоставщикомВШапкеДокумента(Объект, КомпонентыОбмена.ПараметрыКонвертации);
	ЗаполнитьПараметрыДоставки(Объект);
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
КонецПроцедуры
