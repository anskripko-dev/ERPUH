Процедура ПКО_Документ_ПБДСВозвратНалога_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;    
	
	#Область Шапка
	
	Если СокрЛП(ДанныеИБ.НомерВходящегоДокумента) = "-" Тогда
		// Символ "-" проставляем искусственно, если из БП загружен документ с пустым номером.
		ДанныеXDTO.НомерВходящегоДокумента = "";
	КонецЕсли; 
	
	ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, "БанковскийСчет");
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина);
	
	ПоказательДаты = ДанныеИБ.ПоказательДаты;
	
	Если ЗначениеЗаполнено(ПоказательДаты) И ПоказательДаты <> "0" Тогда
		
		ПоказательДаты = Формат(СтроковыеФункцииКлиентСервер.СтрокаВДату(ПоказательДаты), "ДЛФ=D");
		
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ПоказательДаты", ПоказательДаты);
	
	ВидНалога = "ПрочиеНалогиСборы";
	
	//++ Локализация
	
	Если ДанныеИБ.ТипНалога = Справочники.ВидыНалоговВзносов.ЕдиныйНалоговыйПлатеж Тогда
		
		ВидНалога = "ЕдиныйНалоговыйПлатеж";	
		
	КонецЕсли;
	
	//-- Локализация
	
	ДанныеXDTO.Вставить("ВидНалога", ВидНалога);
	
	#КонецОбласти
	
	#Область РасшифровкаПлатежа
	
	ТаблицаРасшифровкаПлатежа = Новый ТаблицаЗначений;
	
	ТаблицаРасшифровкаПлатежа.Колонки.Добавить("СтатьяДДС");
	ТаблицаРасшифровкаПлатежа.Колонки.Добавить("Сумма");
	ТаблицаРасшифровкаПлатежа.Колонки.Добавить("СчетУчетаРасчетов");
	 
	КодСчетаУчета = ""; 
	 
	//++ Локализация
	
	//++ НЕ УТ
	СчетУчетаРасчетов = РеглУчетСервер.СчетУчетаПоТипуНалога(ДанныеИБ.ТипНалога);
	
	Если ЗначениеЗаполнено(СчетУчетаРасчетов) Тогда
		
		КодСчетаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчетаРасчетов, "Код");
		
	КонецЕсли;
	//-- НЕ УТ
	
	//-- Локализация
	
	Если ДанныеИБ.РасшифровкаПлатежа.Количество() > 0 Тогда
		
		Для Каждого Строка Из ДанныеИБ.РасшифровкаПлатежа Цикл
			
			НоваяСтрока = ТаблицаРасшифровкаПлатежа.Добавить(); 
			
			НоваяСтрока.СтатьяДДС = Строка.СтатьяДвиженияДенежныхСредств;
			НоваяСтрока.Сумма = Строка.Сумма;
			
			//++ Локализация
			
			//++ НЕ УТ
			НоваяСтрока.СчетУчетаРасчетов = КодСчетаУчета;  
			//-- НЕ УТ 
			
			//-- Локализация
				
			Если Не ЗначениеЗаполнено(НоваяСтрока.СчетУчетаРасчетов)
				И КомпонентыОбмена.ПараметрыКонвертации.ИспользуютсяКорСчетаИзСтатей Тогда
				НоваяСтрока.СчетУчетаРасчетов = СчетУчетаРасчетовПрочихОперацийДДС(Новый Структура("СтатьяДДС", НоваяСтрока.СтатьяДДС));
			КонецЕсли;
	
		КонецЦикла;
			
	КонецЕсли;
	
	ДанныеXDTO.Вставить("РасшифровкаПлатежа", ТаблицаРасшифровкаПлатежа); 
	
	#КонецОбласти
КонецПроцедуры

