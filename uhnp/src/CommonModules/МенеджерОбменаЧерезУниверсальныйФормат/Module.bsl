Процедура ПКО_Документ_КорректировкаРеализацииТоваров_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен    = Истина;
	ПолученныеДанные.Согласован  = Истина;
	ПолученныеДанные.ДатаПлатежа = ПолученныеДанные.Дата;
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	Если ДанныеXDTO.Свойство("ДоговорПокупателяКомиссионногоТовара") Тогда
	
		ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, 
		"ДоговорПокупателяКомиссионногоТовара", "КлиентДоговор");
	
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ПокупательКомиссионногоТовара") Тогда
	
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КлиентКонтрагент", ДанныеXDTO.ПокупательКомиссионногоТовара);	
	
	КонецЕсли; 
	ВерсияФормата17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");
	ДокументРеализацииДанные = Неопределено;
	ИмяПКО = "";
	ДанныеXDTO.Свойство("ИсправляемыйДокументРеализации", ДокументРеализацииДанные);
	Если ДокументРеализацииДанные <> Неопределено И ТипЗнч(ДокументРеализацииДанные) = Тип("Структура") Тогда
		ТипЗначенияДокумент = ДокументРеализацииДанные.ТипЗначения;
		Если Найти(ТипЗначенияДокумент, "РеализацияТоваровУслуг") Тогда // @Non-NLS-1
			ИмяПКО = "Документ_РеализацияТоваровУслуг_Получение";
		КонецЕсли; 
	КонецЕсли;
	// Если в свойстве ИсправляемыйДокументРеализации указан тип Корректировка реализации, надо проверить что в ДокументРеализации.
	Если ДокументРеализацииДанные = Неопределено Или ИмяПКО = "" Тогда
		ДанныеXDTO.Свойство("ДокументРеализации", ДокументРеализацииДанные);
	КонецЕсли;
	Если ДокументРеализацииДанные <> Неопределено И ТипЗнч(ДокументРеализацииДанные) = Тип("Структура") Тогда
		ТипЗначенияДокумент = ДокументРеализацииДанные.ТипЗначения;
		Если Найти(ТипЗначенияДокумент, "РеализацияТоваровУслуг") Тогда // @Non-NLS-1
			ИмяПКО = "Документ_РеализацияТоваровУслуг_Получение";
		ИначеЕсли Найти(ТипЗначенияДокумент, "КорректировкаРеализацииТоваров") Тогда // @Non-NLS-1
			КорректировкаУИД = ДокументРеализацииДанные.Ссылка.Значение;
			ТипЗначенияОбъектаИБ = Тип("ДокументСсылка.КорректировкаРеализации");
			КорректировкаСсылка = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(КорректировкаУИД,ТипЗначенияОбъектаИБ,КомпонентыОбмена);
	
			Если ТипЗнч(КорректировкаСсылка.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				ПолученныеДанные.ДокументОснование = КорректировкаСсылка.ДокументОснование;
			КонецЕсли; 
		ИначеЕсли Найти(ТипЗначенияДокумент, "ОтчетКомиссионера") Тогда // @Non-NLS-1
			ИмяПКО = "Документ_РеализацияТоваровУслугКомиссия_Получение";
		КонецЕсли; 
	КонецЕсли;
	Если ИмяПКО <> "" Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДокументОснование", Новый Структура("Значение, ИмяПКО",ДокументРеализацииДанные,ИмяПКО));
	КонецЕсли;
	Если ДанныеXDTO.ВидОперации.Значение = "ИсправлениеОшибки" Тогда
		ПолученныеДанные.ВидКорректировки = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок;
	Иначе
		ПолученныеДанные.ВидКорректировки = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон;
	КонецЕсли;
	ПолученныеДанные.ТипКорректировки = Перечисления.ТипыКорректировки.ОбычнаяКорректировка;
	#Область Товары
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");
	ПравилаЗаполнения.Вставить("Сумма",        "Сумма");
	ПравилаЗаполнения.Вставить("Цена",         "Цена");
	ПравилаЗаполнения.Вставить("СтавкаНДС",    "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС",     "СуммаНДС");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	ВерсияФормата17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");
	МассивСтрокТовары = Новый Массив;
	Если ДанныеXDTO.Свойство("Товары")
		И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда
	
		Для Каждого Строка Из ДанныеXDTO.Товары Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("Количество") Тогда
				Если СтруктураДанныхСтроки.Количество <= 0 Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				// Количество не задано.
				Продолжить;
			КонецЕсли;
			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС;
			КонецЕсли;
	
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
	
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
			СтруктураДанныхСтроки.Вставить("КоличествоУпаковок",Строка.Количество);
			ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
			СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
				СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
	
			СтруктураДанныхСтроки.СтавкаНДС = Строка.СтавкаНДС;
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
	
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	// Услуги добавляем в товары.
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда
	
		Для Каждого Строка Из ДанныеXDTO.Услуги Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("Количество") Тогда
				Если СтруктураДанныхСтроки.Количество <= 0 Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				// Количество не задано.
				Продолжить;
			КонецЕсли;
			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
			КонецЕсли;
	
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
			ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
			Если ЗначениеЗаполнено(Строка.Содержание) Тогда
				СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
				СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
			КонецЕсли;
	
			СтруктураДанныхСтроки.СтавкаНДС = Строка.СтавкаНДС;
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
	
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокТовары.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	
	#КонецОбласти 
	#Область Расхождения
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");  
	ПравилаЗаполнения.Вставить("Сумма",        "Сумма");  
	
	ПравилаЗаполнения.Вставить("СтавкаНДС",    "СтавкаНДС");
	
	ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС"); 
	
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	
	МассивСтрокРасхождение = Новый Массив;
	Если ДанныеXDTO.Свойство("Товары")
		И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда 
		Для Каждого Строка Из ДанныеXDTO.Товары Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения); 
			Если НЕ Строка.СтавкаНДС.Свойство("Ставка") Тогда
				Строка.СтавкаНДС.Вставить("Ставка", "0");
			КонецЕсли;
			Если НЕ Строка.СтавкаНДСДоИзменения.Свойство("Ставка") Тогда
				Строка.СтавкаНДСДоИзменения.Вставить("Ставка", "0");
			КонецЕсли;
	
			Если СтруктураДанныхСтроки.Свойство("Количество") Тогда
				Если СтруктураДанныхСтроки.Количество <= 0 Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				// Количество не задано.
				Продолжить;
			КонецЕсли;
			Если НЕ Строка.ЕстьВДокументеПоступленияРеализации = Истина 
				ИЛИ (Не ВерсияФормата17ИВыше И (ЗначениеЗаполнено(Строка.СтавкаНДС) И ЗначениеЗаполнено(Строка.СтавкаНДСДоИзменения))  
				И Строка.СтавкаНДС.Значение <> Строка.СтавкаНДСДоИзменения.Значение)
				ИЛИ (ВерсияФормата17ИВыше И Строка.СтавкаНДС.Ставка <> Строка.СтавкаНДСДоИзменения.Ставка)
				Тогда
				// Две строки старая минусом новая плюсом.
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
					СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
				КонецЕсли;
				СуммаСНДС = Строка.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС;
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
	
				СтруктураДанныхСтроки.СтавкаНДС = Строка.СтавкаНДС;
				Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
					СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
				КонецЕсли;
	
				Если НЕ Строка.ЕстьВДокументеПоступленияРеализации = Истина Тогда
					Продолжить;
				КонецЕсли;
				// Данные до изменения отразить минусом.
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Количество =  (-1) * ?(Строка.КоличествоДоИзменения = Неопределено, 0,Строка.КоличествоДоИзменения);
				Сумма = (-1) * ?(Строка.СуммаДоИзменения = Неопределено, 0,Строка.СуммаДоИзменения);
	
				СтруктураДанныхСтроки.Вставить("Количество", Количество);
				СтруктураДанныхСтроки.Вставить("Сумма", Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И ЗначениеЗаполнено(Строка.СуммаНДСДоИзменения) Тогда
					СтруктураДанныхСтроки.СуммаНДС = (-1) * Строка.СуммаНДСДоИзменения;
				КонецЕсли;
				СтруктураДанныхСтроки.СтавкаНДС = Строка.СтавкаНДСДоИзменения;
				Если СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
					СтруктураДанныхСтроки.КоличествоУпаковок = (-1) * Строка.КоличествоУпаковокДоИзменения;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
					СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
				КонецЕсли;
				СуммаСНДС = Строка.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС - СтруктураДанныхСтроки.СуммаНДС;
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
	
			ИначеЕсли Строка.Количество <> ?(НЕ Строка.КоличествоДоИзменения = Неопределено, Строка.КоличествоДоИзменения, 0) Или Строка.СуммаНДС <> Строка.СуммаНДСДоИзменения Тогда
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				СтруктураДанныхСтроки.Количество = Строка.Количество - ?(НЕ Строка.КоличествоДоИзменения = Неопределено,Строка.КоличествоДоИзменения, 0);
				Если СтруктураДанныхСтроки.Свойство("Сумма") И ЗначениеЗаполнено(Строка.СуммаДоИзменения) Тогда
					СтруктураДанныхСтроки.Сумма = Строка.Сумма - Строка.СуммаДоИзменения;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И ЗначениеЗаполнено(Строка.СуммаНДСДоИзменения) Тогда 
					СтруктураДанныхСтроки.СуммаНДС = Строка.СуммаНДС - Строка.СуммаНДСДоИзменения;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
					СтруктураДанныхСтроки.КоличествоУпаковок = СтруктураДанныхСтроки.КоличествоУпаковок - ?(Строка.КоличествоУпаковокДоИзменения = Неопределено, 0, Строка.КоличествоУпаковокДоИзменения);
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
					СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
				КонецЕсли;
				СуммаСНДС = Строка.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС;
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
	
			Иначе
				// Нет изменений - пропускаем.
				Продолжить;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда
		Для Каждого СтрокаУслуга Из ДанныеXDTO.Услуги Цикл 
			Если СтрокаУслуга.СтавкаНДС = Неопределено ИЛИ СтрокаУслуга.СтавкаНДСДоИзменения = Неопределено Тогда
				Продолжить
			КонецЕсли;
			Если НЕ СтрокаУслуга.СтавкаНДС.Свойство("Ставка") Тогда
				СтрокаУслуга.СтавкаНДС.Вставить("Ставка", "0");
			КонецЕсли;
			Если ТипЗнч(СтрокаУслуга.СтавкаНДСДоИзменения) = ТИП("Структура") И НЕ СтрокаУслуга.СтавкаНДСДоИзменения.Свойство("Ставка") Тогда
				СтрокаУслуга.СтавкаНДСДоИзменения.Вставить("Ставка", "0");
			КонецЕсли;
			Если ((НЕ ВерсияФормата17ИВыше И НЕ СтрокаУслуга.СтавкаНДС.Значение <> СтрокаУслуга.СтавкаНДСДоИзменения.Значение) 
				ИЛИ (ВерсияФормата17ИВыше И СтрокаУслуга.СтавкаНДС.Ставка <> СтрокаУслуга.СтавкаНДСДоИзменения.Ставка)) 
				Или (Не СтрокаУслуга.ЕстьВДокументеПоступленияРеализации = Неопределено 
				И НЕ СтрокаУслуга.ЕстьВДокументеПоступленияРеализации = Истина)
				Или (ЗначениеЗаполнено(СтрокаУслуга.Содержание) И ЗначениеЗаполнено(СтрокаУслуга.СодержаниеДоИзменения) 
				И СтрокаУслуга.Содержание <> СтрокаУслуга.СодержаниеДоИзменения) Тогда
				// Две строки старая минусом новая плюсом.
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаУслуга, ПравилаЗаполнения);
				Если ЗначениеЗаполнено(СтрокаУслуга.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", СтрокаУслуга.Содержание);
				КонецЕсли;
				СуммаСНДС = СтрокаУслуга.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, СтрокаУслуга, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				Если ЗначениеЗаполнено(СтрокаУслуга.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", СтрокаУслуга.Содержание);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", СтрокаУслуга.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки); 
	
				СтруктураДанныхСтроки.СтавкаНДС = СтрокаУслуга.СтавкаНДС;
				Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
					СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
				КонецЕсли;
	
				Если НЕ Строка.ЕстьВДокументеПоступленияРеализации = Истина Тогда
					Продолжить;
				КонецЕсли;
	
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаУслуга, ПравилаЗаполнения);
	
				Количество =  (-1) * ?(СтрокаУслуга.КоличествоДоИзменения = Неопределено, 0,СтрокаУслуга.КоличествоДоИзменения);
				Сумма = (-1) * ?(СтрокаУслуга.СуммаДоИзменения = Неопределено, 0,СтрокаУслуга.СуммаДоИзменения);
	
				СтруктураДанныхСтроки.Вставить("Количество", Количество);
				СтруктураДанныхСтроки.Вставить("Сумма", Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И ЗначениеЗаполнено(СтрокаУслуга.СуммаНДСДоИзменения) Тогда
					СтруктураДанныхСтроки.СуммаНДС = (-1) * СтрокаУслуга.СуммаНДСДоИзменения;
				КонецЕсли;
				СтруктураДанныхСтроки.СтавкаНДС = СтрокаУслуга.СтавкаНДСДоИзменения;
				Если ЗначениеЗаполнено(СтрокаУслуга.СодержаниеДоИзменения) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", СтрокаУслуга.СодержаниеДоИзменения);
				КонецЕсли;
				СуммаСНДС = СтрокаУслуга.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, СтрокаУслуга, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				Если ЗначениеЗаполнено(СтрокаУслуга.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", СтрокаУслуга.Содержание);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", СтрокаУслуга.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
	
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
				
			ИначеЕсли СтрокаУслуга.Количество <> СтрокаУслуга.КоличествоДоИзменения Или ?(СтрокаУслуга.Сумма = Неопределено, 0, СтрокаУслуга.Сумма) <> СтрокаУслуга.СуммаДоИзменения Или СтрокаУслуга.СуммаНДС <> СтрокаУслуга.СуммаНДСДоИзменения Тогда
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаУслуга, ПравилаЗаполнения); 
				Сумма = ?(СтрокаУслуга.Сумма = Неопределено, 0, СтрокаУслуга.Сумма); 
				Если СтруктураДанныхСтроки.Свойство("Сумма") = Ложь Тогда
				    СтруктураДанныхСтроки.Вставить("Сумма");
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаУслуга.Количество) И ЗначениеЗаполнено(СтрокаУслуга.КоличествоДоИзменения) Тогда
					СтруктураДанныхСтроки.Количество = СтрокаУслуга.Количество - СтрокаУслуга.КоличествоДоИзменения;
				КонецЕсли;
				СтруктураДанныхСтроки.Сумма = Сумма - ?(СтрокаУслуга.СуммаДоИзменения = Неопределено, 0, СтрокаУслуга.СуммаДоИзменения);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И ЗначениеЗаполнено(СтрокаУслуга.СуммаНДСДоИзменения) Тогда
					СтруктураДанныхСтроки.СуммаНДС = СтрокаУслуга.СуммаНДС - СтрокаУслуга.СуммаНДСДоИзменения;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаУслуга.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", СтрокаУслуга.Содержание);
				КонецЕсли;
				СуммаСНДС = Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, СтрокаУслуга, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				Если ЗначениеЗаполнено(СтрокаУслуга.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", СтрокаУслуга.Содержание);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);	
			Иначе
				// Нет изменений - пропускаем.
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	Если МассивСтрокРасхождение.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Расхождения", МассивСтрокРасхождение);
	КонецЕсли;
	
	#КонецОбласти
КонецПроцедуры
Процедура ПКО_Документ_КорректировкаРеализацииТоваров_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСкладПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	Если НЕ ДанныеИБ = Неопределено Тогда
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Товары
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("СтавкаНДС");
	
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Товары,
			ДанныеИБ.Товары,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, КоличествоУпаковок, Упаковка, Содержание, Сумма, СуммаНДС, СуммаСНДС, Цена, Склад");
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
		// Расхождения
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("СтавкаНДС");
	
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Расхождения,
			ДанныеИБ.Расхождения,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, КоличествоУпаковок, Упаковка, Содержание, Сумма, СуммаНДС, СуммаСНДС, Склад");
		ДанныеИБ.Расхождения.Загрузить(ПолученныеДанные.Расхождения.Выгрузить());
	
		ПолученныеДанные = Неопределено;
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	ТипДокумента = "ДокументОбъект.КорректировкаРеализации";
	ПроверитьРезультатОбменаДаннымиПоДокументу(ДанныеДляЗаписиВИБ, КомпонентыОбмена.УзелКорреспондента, ТипДокумента);
КонецПроцедуры

