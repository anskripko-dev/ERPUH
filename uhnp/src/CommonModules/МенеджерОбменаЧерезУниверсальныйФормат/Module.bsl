Процедура ПКО_Документ_ОперацияПоЯндексКассе_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(ПолученныеДанные.Контрагент, ПолученныеДанные.ХозяйственнаяОперация);
	
	// Автоматическое заполнение настройки с яндекс кассой и полей из этой настройки
	ПолученныеДанные.НастройкаЯндексКассы = Справочники.НастройкиОнлайнОплат.НайтиНастройку(
	Новый Структура("Организация", ПолученныеДанные.Организация));
	
	Если ЗначениеЗаполнено(ПолученныеДанные.НастройкаЯндексКассы) Тогда
		
		ПоляДляЗаполненияИзНастроек = "СтатьяРасходов, АналитикаРасходов";
		ЗначенияРеквизитов          = ЗначенияРеквизитовНастройки(ПолученныеДанные.НастройкаЯндексКассы);
		
		ЗаполнитьЗначенияСвойств(ПолученныеДанные, ЗначенияРеквизитов, ПоляДляЗаполненияИзНастроек);
		
		Если ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента Тогда 
			ПолученныеДанные.СтатьяДвиженияДенежныхСредств = ЗначенияРеквизитов.СтатьяДвиженияДенежныхСредствОплаты;
		Иначе
			ПолученныеДанные.СтатьяДвиженияДенежныхСредств = ЗначенияРеквизитов.СтатьяДвиженияДенежныхСредствВозвраты;
		КонецЕсли;
	КонецЕсли;
	МассивСтрокРасшифровкаПлатежа = Новый Массив;
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("СтавкаНДС", "СтавкаНДС");
	ПравилаЗаполнения.Вставить("Сумма", "Сумма");  
	ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС");
	ВерсияФормата17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");
	Для Каждого Строка Из ДанныеXDTO.РасшифровкаПлатежа Цикл 
		Если ДанныеXDTO.Свойство("РасшифровкаПлатежа")
			И ДанныеXDTO.РасшифровкаПлатежа.Количество() > 0 Тогда  
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") Тогда 
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
			КонецЕсли;  
			МассивСтрокРасшифровкаПлатежа.Добавить(СтруктураДанныхСтроки);
		КонецЕсли;
	КонецЦикла; 
	ПолученныеДанные.ДополнительныеСвойства.Вставить("МассивСтрокРасшифровкаПлатежа", МассивСтрокРасшифровкаПлатежа);
	ПолученныеДанные.СуммаДокументаСНДСОбщаяСтавка = ПолученныеДанные.СуммаДокумента + ПолученныеДанные.СуммаНДСОбщаяСтавка;
	ПолученныеДанные.СуммаДокументаСНДС10 = ПолученныеДанные.СуммаДокумента + ПолученныеДанные.СуммаНДС10;
КонецПроцедуры
Процедура ПКО_Документ_ОперацияПоЯндексКассе_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	ДополнительныеСвойства = ПолученныеДанные.ДополнительныеСвойства; 
	Если ДополнительныеСвойства.Свойство("МассивСтрокРасшифровкаПлатежа") Тогда
	    Для каждого Стр Из ДополнительныеСвойства.МассивСтрокРасшифровкаПлатежа Цикл
		    Если Стр.СтавкаНДС.ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
			     ПолученныеДанные.СуммаНДС5 = Стр.СуммаНДС;  
				 ПолученныеДанные.СуммаДокументаСНДС5 = ПолученныеДанные.СуммаДокумента + Стр.СуммаНДС; 
			КонецЕсли;
			Если Стр.СтавкаНДС.ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
			     ПолученныеДанные.СуммаНДС7 = Стр.СуммаНДС; 
				 ПолученныеДанные.СуммаДокументаСНДС7 = ПолученныеДанные.СуммаДокумента + Стр.СуммаНДС;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
	Если ДанныеИБ <> Неопределено Тогда  
		 ДанныеИБ.СуммаНДС5 = ПолученныеДанные.СуммаНДС5;
		 ДанныеИБ.СуммаДокументаСНДС5 = ПолученныеДанные.СуммаДокументаСНДС5;
		 ДанныеИБ.СуммаНДС7 = ПолученныеДанные.СуммаНДС7;
		 ДанныеИБ.СуммаДокументаСНДС7 = ПолученныеДанные.СуммаДокументаСНДС7;
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ВалютаКомиссии) Тогда
		ДанныеДляЗаписиВИБ.ВалютаКомиссии = ДанныеДляЗаписиВИБ.Валюта;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СпособОплаты) Тогда
		ДанныеДляЗаписиВИБ.СпособОплаты = Перечисления.СпособыОплатыЧерезЯндексКассу.AC;
	КонецЕсли;
	УстановитьОтменуМеханическойЧисткиДвижений(ДанныеИБ);
КонецПроцедуры

