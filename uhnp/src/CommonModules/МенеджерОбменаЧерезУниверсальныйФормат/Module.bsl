		ДанныеXDTO.Вставить("КодВидаДохода", ДанныеИБ.КодВидаДохода);
	КонецЕсли;
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
КонецПроцедуры

