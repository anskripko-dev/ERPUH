КонецПроцедуры
Процедура ПОД_Документ_ВозвратТоваровОтКлиента_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
	
	ВозвратЧерезКомиссионера = ВозвратТоваровЧерезКомиссионера(ДанныеИБ.ХозяйственнаяОперация);
	
	Если ВозвратТоваровЧерезКомиссионера(ДанныеИБ.ХозяйственнаяОперация) Тогда
		
		ИспользованиеПКО.Документ_ВозвратТоваровОтКлиентаКомиссия_Отправка = Истина;
		
		Если Не ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.20") Тогда
			
			ОчиститьИспользованиеПКО(ИспользованиеПКО);
			
			ШаблонПредупреждения = НСтр("ru = 'Документ %1 не выгружен, так как хозяйственная операция %2 не поддерживается в формате %3';
										|en = 'The %1 document is not exported as the %2 business transaction is not supported in the %3 format'");
			ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ДанныеИБ.Ссылка, "«" + Строка(ДанныеИБ.ХозяйственнаяОперация) + "»", Строка(КомпонентыОбмена.ВерсияФорматаОбмена));
			ПредупреждениеПриСинхронизации(КомпонентыОбмена, ДанныеИБ.Ссылка, ТекстПредупреждения);
			
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		ИспользованиеПКО.Документ_ВозвратТоваровОтКлиента_Отправка = Истина;
		
	КонецЕсли;
	
	Если Не ТипНалогообложенияВалиден(Неопределено, ДанныеИБ.НалогообложениеНДС, КомпонентыОбмена.ВерсияФорматаОбмена) Тогда
		
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
		
		ШаблонПредупреждения = НСтр("ru = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
									|en = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format'");
		ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ДанныеИБ.Ссылка, "«" + Строка(ДанныеИБ.НалогообложениеНДС) + "»", Строка(КомпонентыОбмена.ВерсияФорматаОбмена));
		ПредупреждениеПриСинхронизации(КомпонентыОбмена, ДанныеИБ.Ссылка, ТекстПредупреждения);
		
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПОД_Документ_ВозвратТоваровПоставщику(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_ВозвратТоваровПоставщику";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.ВозвратТоваровПоставщику;
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_ВозвратТоваровПоставщику_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВозвратТоваровПоставщику_Отправка");
КонецПроцедуры
Процедура ПОД_Документ_ВозвратТоваровПоставщику_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	// Проверка на наличие записей в табличной части Товары.
	// Если табличная часть пустая, то документ не выгружается, иначе он не пройдет проверку по схеме.
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьЗаписи
		|ИЗ
		|	Документ.ВозвратТоваровПоставщику.ВидыЗапасов КАК ВидыЗапасов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
		|		ПО ВидыЗапасов.АналитикаУчетаНоменклатуры = Аналитика.КлючАналитики
		|ГДЕ
		|	ВидыЗапасов.Ссылка = &Ссылка
		|	И (Аналитика.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
		|		ИЛИ Аналитика.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))");
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Выборка = Запрос.Выполнить();
	Если Выборка.Пустой()
		ИЛИ (ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.18") 
		И ДанныеИБ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ЛьготноеНалогообложениеНДСНаУСН) Тогда
		ИспользованиеПКО.Документ_ВозвратТоваровПоставщику_Отправка = Ложь;
	КонецЕсли;
КонецПроцедуры

