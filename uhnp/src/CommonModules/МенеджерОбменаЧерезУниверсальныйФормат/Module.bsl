	ДобавитьПКС(СвойстваШапки, "ГруппаПозицийПодразделения", "ЭтоГруппаПозицийПодразделения", 1);
	ДобавитьПКС(СвойстваШапки, "ДатаЗакрытия",               "ДатаЗакрытия", 1);
	ДобавитьПКС(СвойстваШапки, "ДатаУтверждения",            "ДатаУтверждения", 1);
	ДобавитьПКС(СвойстваШапки, "Должность",                  "Должность", 1, "Справочник_Должности_Получение");
	ДобавитьПКС(СвойстваШапки, "Закрыта",                    "Закрыта", 1);
	ДобавитьПКС(СвойстваШапки, "Наименование",               "Наименование", 1);
	ДобавитьПКС(СвойстваШапки, "",                           "Подразделение", 1, "Справочник_Подразделения_Получение");
	ДобавитьПКС(СвойстваШапки, "Подразделение",              "ПодразделениеОрганизации", 1, "Справочник_ПодразделенияОрганизаций_Получение");
	ДобавитьПКС(СвойстваШапки, "Родитель",                   "Родитель", 1, "Справочник_ШтатноеРасписание_Получение");
	ДобавитьПКС(СвойстваШапки, "Утверждена",                 "Утверждена", 1);
	ПравилоКонвертации.ПоляПоиска.Добавить("Владелец, Подразделение, ДатаУтверждения, ДатаЗакрытия, Утверждена, Должность");
КонецПроцедуры
Процедура ПКО_Справочник_ШтатноеРасписание_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
	Если ДанныеXDTO.Свойство("Подразделение") Тогда
		ПКОПодразделение    = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Подразделения_Получение");
		СтруктураПредприятия = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
									КомпонентыОбмена, 
									ДанныеXDTO.Подразделение, 
									ПКОПодразделение, 
									"ПолучитьСсылку"); 
		Если НЕ СтруктураПредприятия = Неопределено И ТипЗнч(СтруктураПредприятия) = ТИП("СправочникСсылка.СтруктураПредприятия") Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("СтруктураПредприятия", СтруктураПредприятия.Ссылка);
		КонецЕсли;
	КонецЕсли; 
	Если ДанныеXDTO.Свойство("ЭтоГруппаПозицийПодразделения") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ЭтоГруппаПозицийПодразделения", ДанныеXDTO.ЭтоГруппаПозицийПодразделения);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ШтатноеРасписание_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
		ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);  
		
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ЭтоГруппаПозицийПодразделения") Тогда
		ПолученныеДанные.ГруппаПозицийПодразделения = ПолученныеДанные.ДополнительныеСвойства.ЭтоГруппаПозицийПодразделения;
	КонецЕсли; 
	Если ДанныеИБ = Неопределено Тогда
	     ПолученныеДанные.КоличествоСтавок = 1;
	КонецЕсли;
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("СтруктураПредприятия") Тогда  
		ДанныеДляЗагрузки = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);	
		Если НЕ ДанныеИБ = Неопределено Тогда 
			ОбъектНайден = Истина;
		Иначе	
			ОбъектНайден = Ложь;
		КонецЕсли;  
		СтруктураПредприятия = ПолученныеДанные.ДополнительныеСвойства.СтруктураПредприятия;
		ПараметрыОбъекта = Новый Соответствие;     
		ПараметрыОбъекта.Вставить("МестоВСтруктуреПредприятия", СтруктураПредприятия.Ссылка); 
		ПереносДанныхЗарплатаКадры.ШтатноеРасписаниеМестоВСтруктуреПредприятияПослеЗагрузки(ДанныеДляЗагрузки, ОбъектНайден, ПараметрыОбъекта);	
	КонецЕсли;
КонецПроцедуры

