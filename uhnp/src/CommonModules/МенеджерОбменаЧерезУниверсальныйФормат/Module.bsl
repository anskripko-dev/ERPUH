Процедура ПередМержеванием_СБДС(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
		ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
КонецПроцедуры
Процедура ПередОтложеннымЗаполнениемУТКАУП(КомпонентыОбмена)
	//В конфигурации УТ, данные обработчик может быть пустой.
	
	//++ НЕ УТ
	
	//++ Локализация
	
	//Заполним валюту в денежных документах
	ПолученныеДД = КомпонентыОбмена.ПараметрыКонвертации.ПолученныеДенежныеДокументы;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПолученныеДД", ПолученныеДД);
	Запрос.Текст = "ВЫБРАТЬ
		|	ПолученныеДД.ДенежныйДокумент КАК ДенежныйДокумент,
		|	ПолученныеДД.Валюта КАК Валюта
		|ПОМЕСТИТЬ втПолученныеДД
		|ИЗ
		|	&ПолученныеДД КАК ПолученныеДД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втПолученныеДД.ДенежныйДокумент КАК ДенежныйДокумент,
		|	втПолученныеДД.Валюта КАК Валюта
		|ИЗ
		|	втПолученныеДД КАК втПолученныеДД
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДенежныеДокументы КАК ДенежныеДокументы
		|		ПО втПолученныеДД.ДенежныйДокумент = ДенежныеДокументы.Ссылка
		|ГДЕ
		|	НЕ втПолученныеДД.Валюта = ДенежныеДокументы.Валюта";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОбъектДД = Выборка.ДенежныйДокумент.ПолучитьОбъект(); // СправочникОбъект.ДенежныеДокументы
		ОбъектДД.Валюта = Выборка.Валюта;
		
		Попытка
			ОбъектДД.Записать();
		Исключение
			ЗаписатьОшибкуВЖурналРегистрации(ОбъектДД,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), КомпонентыОбмена);
		КонецПопытки	
		
	КонецЦикла;
	//-- Локализация
	
	//-- НЕ УТ
КонецПроцедуры
Процедура ПеренестиСерииВТЧСерии(Объект, ПараметрыУказанияСерий, КомпонентыОбмена)
	Если ПараметрыУказанияСерий.ИмяТЧСерии = ПараметрыУказанияСерий.ИмяТЧТовары Тогда
		Возврат;	
	КонецЕсли;
	
	Объект[ПараметрыУказанияСерий.ИмяТЧСерии].Очистить();
	
	Если ПараметрыУказанияСерий.ТоварВШапке Тогда
		Если ЗначениеЗаполнено(Объект.Серия)
			И НоменклатураКлиентСервер.ВЭтомСтатусеСерииУказываютсяВТЧСерии(Объект.СтатусУказанияСерий, ПараметрыУказанияСерий) Тогда
			
			СтрокаСерии = Объект[ПараметрыУказанияСерий.ИмяТЧСерии].Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСерии, Объект);
		КонецЕсли;
	Иначе
		Для Каждого СтрокаТЧ Из Объект[ПараметрыУказанияСерий.ИмяТЧТовары] Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.Серия)
				И НоменклатураКлиентСервер.ВЭтомСтатусеСерииУказываютсяВТЧСерии(СтрокаТЧ.СтатусУказанияСерий, ПараметрыУказанияСерий) Тогда
				
				СтрокаСерии = Объект[ПараметрыУказанияСерий.ИмяТЧСерии].Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСерии, СтрокаТЧ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
Процедура ПереопределитьПоляПоискаКонтрагентов(КомпонентыОбмена, ДанныеXDTO)
	//  Если контрагент является индивидуальным предпринимателем или физ. лицом, то необходимо переопределить поля поиска,
	//	так как в приложении могут быть записаны два контрагента с одинаковыми ключевыми полями: ИНН + Наименование, но с разным видом ЮрФизЛицо
	
	ПравилаКонвертацииКонтрагентов = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти("Справочник_Контрагенты_Получение", "ИмяПКО");
	Если ПравилаКонвертацииКонтрагентов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючевыеСвойства = Неопределено;
	Если Не ДанныеXDTO.Свойство("КлючевыеСвойства", КлючевыеСвойства) Тогда
		КлючевыеСвойства = ДанныеXDTO;
	КонецЕсли;
	
	Если Не (КлючевыеСвойства.Свойство("ЮридическоеФизическоеЛицо") И 
		КлючевыеСвойства.ЮридическоеФизическоеЛицо.Значение = "ФизическоеЛицо") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПоляПоиска = ПравилаКонвертацииКонтрагентов.ПоляПоиска;
	ПоляПоиска.Очистить();
	
	ИННЗаполнен = КлючевыеСвойства.Свойство("ИНН") И ЗначениеЗаполнено(КлючевыеСвойства.ИНН);
	
	Если ИННЗаполнен Тогда
		ПоляПоиска.Добавить("ИНН, ЮрФизЛицо");
	Иначе
		ПоляПоиска.Добавить("НаименованиеПолное,ЮрФизЛицо");
		ПоляПоиска.Добавить("Наименование,ЮрФизЛицо");
	КонецЕсли;
КонецПроцедуры
Процедура ПереопределитьСтавкуНДСДляСтарыхФорматов(ТаблицаДанных, НДСПоСтавкам2и4)
	Если ТаблицаДанных = Неопределено ИЛИ ТаблицаДанных.Количество() = 0 
		ИЛИ ТаблицаДанных.Колонки.Найти("СтавкаНДС") = Неопределено 
		И ТаблицаДанных.Колонки.Найти("СтавкаНДСВРознице") = Неопределено Тогда
		Возврат
	КонецЕсли; 
	
	ОписаниеТипаКолонкиНДС = Новый ОписаниеТипов("Строка");
	
	ТаблицаДанных.Колонки.Добавить("СтавкаНДССтрокой", ОписаниеТипаКолонкиНДС); 
	
	Если ТаблицаДанных.Колонки.Найти("СтавкаНДСДоИзменения") <> Неопределено Тогда   
		ТаблицаДанных.Колонки.Добавить("СтавкаНДСДоИзмененияСтрокой", ОписаниеТипаКолонкиНДС); 
	КонецЕсли;
	Если ТаблицаДанных.Колонки.Найти("СтавкаНДСВРознице") <> Неопределено Тогда    
		ТаблицаДанных.Колонки.Добавить("СтавкаНДСВРозницеСтрокой", ОписаниеТипаКолонкиНДС); 
	КонецЕсли;
	Для Каждого Стр Из ТаблицаДанных Цикл 
		Если ЗначениеЗаполнено(Стр.СтавкаНДС) И ТипЗнч(Стр.СтавкаНДС) = Тип("СправочникСсылка.СтавкиНДС") Тогда  
			Стр.СтавкаНДССтрокой = СтавкаНДСВСтрокуXDTO(Стр.СтавкаНДС, НДСПоСтавкам2и4);
		КонецЕсли;  
		Если ТаблицаДанных.Колонки.Найти("СтавкаНДСДоИзменения") <> Неопределено И ЗначениеЗаполнено(Стр.СтавкаНДСДоИзменения) 
			И ТипЗнч(Стр.СтавкаНДСДоИзменения) = Тип("СправочникСсылка.СтавкиНДС") Тогда
			Стр.СтавкаНДСДоИзмененияСтрокой = СтавкаНДСВСтрокуXDTO(Стр.СтавкаНДСДоИзменения, НДСПоСтавкам2и4);
		КонецЕсли;
		Если ТаблицаДанных.Колонки.Найти("СтавкаНДСВРознице") <> Неопределено И ЗначениеЗаполнено(Стр.СтавкаНДСВРознице)
			И ТипЗнч(Стр.СтавкаНДСВРознице) = Тип("СправочникСсылка.СтавкиНДС")Тогда
			Стр.СтавкаНДСВРозницеСтрокой = СтавкаНДСВСтрокуXDTO(Стр.СтавкаНДСВРознице, НДСПоСтавкам2и4);
		КонецЕсли;
	КонецЦикла; 
	ТаблицаДанных.Колонки.Удалить("СтавкаНДС");
	ТаблицаДанных.Колонки.СтавкаНДССтрокой.Имя = "СтавкаНДС";
	Если ТаблицаДанных.Колонки.Найти("СтавкаНДСДоИзменения") <> Неопределено Тогда
		ТаблицаДанных.Колонки.Удалить("СтавкаНДСДоИзменения");
		ТаблицаДанных.Колонки.СтавкаНДСДоИзмененияСтрокой.Имя = "СтавкаНДСДоИзменения";
	КонецЕсли;
	Если ТаблицаДанных.Колонки.Найти("СтавкаНДСВРознице") <> Неопределено Тогда
		ТаблицаДанных.Колонки.Удалить("СтавкаНДСВРознице");
		ТаблицаДанных.Колонки.СтавкаНДСВРозницеСтрокой.Имя = "СтавкаНДСВРознице";
	КонецЕсли;
КонецПроцедуры
Функция ПересчетСуммыВРеглИУпр(КомпонентыОбмена, Организация, Валюта, ДатаПересчета, Сумма)
	ВалютаРеглУчета = ВалютаРегламентированногоУчета(Организация);
	ВалютаУпрУчета  = ВалютаУправленческогоУчета(КомпонентыОбмена);
	
	СуммыВВалютахРеглИУпр = Новый Структура("СуммаУпр, СуммаРегл");
	
	Если Валюта = ВалютаРеглУчета Тогда
		СуммыВВалютахРеглИУпр.СуммаРегл = Сумма;
	Иначе
		КоэффициентПересчета = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(Валюта, ВалютаРеглУчета, ДатаПересчета);
		СуммыВВалютахРеглИУпр.СуммаРегл = Окр(Сумма * КоэффициентПересчета, 2, 1);
	КонецЕсли;
	
	Если Валюта = ВалютаУпрУчета Тогда
		СуммыВВалютахРеглИУпр.СуммаУпр = Сумма;
	Иначе
		КоэффициентПересчета = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(Валюта, ВалютаУпрУчета, ДатаПересчета);
		СуммыВВалютахРеглИУпр.СуммаУпр = Окр(Сумма * КоэффициентПересчета, 2, 1);
	КонецЕсли;
	
	Возврат СуммыВВалютахРеглИУпр;
КонецФункции
