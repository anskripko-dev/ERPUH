	ДобавитьПКС(СвойстваШапки, "",           "ЗаказКлиента", , "Документ_ЗаказКлиента_Получение");
	ДобавитьПКС(СвойстваШапки, "Контрагент", "Контрагент", , "Справочник_Контрагенты_Получение");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "ОплатыККМ");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ТипОплаты", 1, "Перечисление_ТипыОплатыККТ");

КонецПроцедуры
Процедура ПКО_Документ_РасходныйКассовыйОрдер_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	// Заполнение данных шапки
	ПолученныеДанные.Проведен = Истина;
	
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
	
	ЗаказКлиента = СсылкаНаДокументРасчетовИзДанныхXDTO(КомпонентыОбмена, ДанныеXDTO.ЗаказКлиента);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВозвратТоваровОтКлиента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВозвратТоваровОтКлиента КАК ВозвратТоваровОтКлиента
	|ГДЕ
	|	ВозвратТоваровОтКлиента.ДокументРеализации.ЗаказКлиента = &ЗаказКлиента
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВозвратТоваровОтКлиента.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ПолученныеДанные.ДокументОснование = Выборка.Ссылка;
	КонецЕсли; 
	
	ПолученныеДанные.СуммаДокумента = 0;
	Если ДанныеXDTO.Свойство("ОплатыККМ")
		И ЗначениеЗаполнено(ДанныеXDTO.ОплатыККМ) Тогда
		
		Для каждого Строка Из ДанныеXDTO.ОплатыККМ Цикл
			Если Строка.ТипОплаты.Значение = "Наличные" Тогда
				ПолученныеДанные.СуммаДокумента = ПолученныеДанные.СуммаДокумента + Строка.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_РасходныйКассовыйОрдер_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ПередМержеванием_ПКО(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	Мержевание_ПКО(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена);
	ПослеМержевания_ПКО(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	
	ЗаполнитьДопСвойстваДанныхИБИзПолученныхДанных(ДанныеИБ, ПолученныеДанные);
	
	ПолученныеДанные = ?(ДанныеИБ = Неопределено, ПолученныеДанные, Неопределено);
	УстановитьОтменуМеханическойЧисткиДвижений(ДанныеИБ);
КонецПроцедуры

