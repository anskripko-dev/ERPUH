Процедура АдаптацияПКПД(КомпонентыОбмена)
	СтрокаПКПД = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("ВидыПродукцииИС", "ИмяПКПД");
	
	ТекущаяВерсияФормата = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена);
	
	Если СтрокаПКПД <>  Неопределено Тогда
		
		СоответствиеПКПДОтправка = СтрокаПКПД.КонвертацииЗначенийПриОтправке;
		СоответствиеПКПДПолучение = СтрокаПКПД.КонвертацииЗначенийПриПолучении;
		
		// В версии формата 1.15 удалено значение "МолочнаяПродукция" поэтому значения нет в ПКПД.
		// Заменяем значения для версий формата ниже 1.15. 
		Если ТекущаяВерсияФормата < ВерсияФорматаЧислом("1.15") Тогда
			
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.МолочнаяПродукцияПодконтрольнаяВЕТИС, "МолочнаяПродукция");
			СоответствиеПКПДПолучение.Вставить("МолочнаяПродукция", Перечисления.ОсобенностиУчетаНоменклатуры.МолочнаяПродукцияПодконтрольнаяВЕТИС);
			
		КонецЕсли;
		
		Если ТекущаяВерсияФормата >= ВерсияФорматаЧислом("1.17") Тогда
			
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво, "БезалкогольноеПиво");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.Зерно, "Зерно");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.ЗерноВЕТИС, "ЗерноВЕТИС");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.МорепродуктыПодконтрольныеВЕТИС, "МорепродуктыПодконтрольныеВЕТИС");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.ПродуктыПереработкиЗерна, "ПродуктыПереработкиЗерна");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.ПродуктыПереработкиЗернаВЕТИС, "ПродуктыПереработкиЗернаВЕТИС");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.ПодконтрольнаяПродукцияВЕТИС, "ПодконтрольнаяПродукцияВЕТИС");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.ПодконтрольнаяПродукцияСАТУРН, "ПодконтрольнаяПродукцияСАТУРН");
			СоответствиеПКПДОтправка.Вставить(Перечисления.ОсобенностиУчетаНоменклатуры.СоковаяПродукция, "СоковаяПродукция");
			
			СоответствиеПКПДПолучение.Вставить("БезалкогольноеПиво", Перечисления.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво);
			СоответствиеПКПДПолучение.Вставить("Зерно", Перечисления.ОсобенностиУчетаНоменклатуры.Зерно);
			СоответствиеПКПДПолучение.Вставить("ЗерноВЕТИС", Перечисления.ОсобенностиУчетаНоменклатуры.ЗерноВЕТИС);
			СоответствиеПКПДПолучение.Вставить("МорепродуктыПодконтрольныеВЕТИС", Перечисления.ОсобенностиУчетаНоменклатуры.МорепродуктыПодконтрольныеВЕТИС);
			СоответствиеПКПДПолучение.Вставить("ПродуктыПереработкиЗерна", Перечисления.ОсобенностиУчетаНоменклатуры.ПродуктыПереработкиЗерна);
