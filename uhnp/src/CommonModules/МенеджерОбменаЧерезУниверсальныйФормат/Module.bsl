	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_ПоступлениеТоваровОтХранителя_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВозвратОтКомиссионера_Отправка");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВозвратСырьяОтПереработчика25_Отправка");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ПоступлениеОтПереработчика25_Отправка");
КонецПроцедуры
