	ДобавитьПКС(СвойстваШапки, "Организация",    "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "Проведен",       "", 1);
	ДобавитьПКС(СвойстваШапки, "Статус",         "", 1);
