Процедура ПКО_Документ_ПроизводствоБезЗаказа_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Префикс = "WO";
	//++ Локализация
	Префикс = "БЗ";
	//-- Локализация
	НомерДок = Лев(ДанныеИБ.Номер, 5) + Префикс + Сред(ДанныеИБ.Номер, 8);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", НомерДок);
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_ПроизводствоБезЗаказа_Отправка", 
										"Материалы", 
										"НомерГТД",
										Истина,
										"Справочник_НомераГТД_Отправка");
	КонецЕсли;
	
	ВыгрузитьПодразделение(ДанныеИБ, ДанныеXDTO);
	ДанныеXDTO.Вставить("СчетЗатрат", КомпонентыОбмена.ПараметрыКонвертации.СчетЗатратВыпускПродукции);
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	ТаблицаПродукция          = ДанныеИБ.ДополнительныеСвойства.ТаблицаПродукция;
	ТаблицаВозвратныеОтходы   = ДанныеИБ.ДополнительныеСвойства.ТаблицаВозвратныеОтходы;
	ТаблицаМатериалы          = ДанныеИБ.ДополнительныеСвойства.ТаблицаМатериалы;
	ТаблицаРаботы             = ДанныеИБ.ДополнительныеСвойства.ТаблицаРаботы;
	
	Если ТаблицаПродукция.Количество() > 0 Тогда	
		ДанныеXDTO.Вставить("Продукция", ТаблицаПродукция);
	КонецЕсли;
	
	Если ТаблицаВозвратныеОтходы.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ВозвратныеОтходы", ТаблицаВозвратныеОтходы);
	КонецЕсли;
	
	Если ТаблицаМатериалы.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Материалы", ТаблицаМатериалы);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7")
		И ТаблицаРаботы.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Работы", ТаблицаРаботы);
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Склад", ДанныеИБ.ДополнительныеСвойства.СкладДляВыгрузки);
	ДанныеXDTO.Вставить("ВидОперации", ДанныеИБ.ДополнительныеСвойства.НаправлениеВыпуска);
	//++ Локализация
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		ИмяТаблицы = "Документ.ПроизводствоБезЗаказа.ВидыЗапасовМатериалыИРаботы"; 
		ИдентификаторыИзВидовЗапасов = Истина;
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов);
	КонецЕсли;
	//-- Локализация
КонецПроцедуры

