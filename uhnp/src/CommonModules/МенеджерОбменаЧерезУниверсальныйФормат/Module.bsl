//++ НЕ УТКА
Процедура ДобавитьПОД_Документ_ВозвратСырьяДавальцу_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_ВозвратСырьяДавальцу_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.ВозвратСырьяДавальцу;
	ПравилоОбработки.ОчисткаДанных           = Ложь;
