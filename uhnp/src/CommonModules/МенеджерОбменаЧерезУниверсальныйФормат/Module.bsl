Процедура ПКО_Справочник_КонтактныеЛицаПартнеров_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПартнерВладелец = Справочники.Партнеры.НеизвестныйПартнер;
	КлючевыеСвойства = ДанныеXDTO.КлючевыеСвойства;
	
	Если КлючевыеСвойства.Свойство("Субъект") И ЗначениеЗаполнено(КлючевыеСвойства.Субъект) 
		И КлючевыеСвойства.Субъект.ТипЗначения = "Контрагент" Тогда
	
		КонтрагентВладелец = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
			КомпонентыОбмена,
			КлючевыеСвойства.Субъект,
			ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Контрагенты_Получение"), 
			"ПолучитьСсылку");
	 	
		Если ТипЗнч(КонтрагентВладелец) = Тип("СправочникОбъект.Контрагенты") Тогда
		
			КонтрагентВладелец = КонтрагентВладелец.Ссылка;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КонтрагентВладелец) И ОбщегоНазначения.СсылкаСуществует(КонтрагентВладелец) Тогда
		
			ПартнерВладелец = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(КонтрагентВладелец);
			
		КонецЕсли;
		
	КонецЕсли;	 
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Владелец", ПартнерВладелец); 
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Контрагент", КонтрагентВладелец); 
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
	
	ЗагрузитьКонтактнуюИнформацию(ДанныеXDTO, ПолученныеДанные, Справочники.ВидыКонтактнойИнформации.СправочникКонтактныеЛицаПартнеров);
КонецПроцедуры
Процедура ПКО_Справочник_КонтактныеЛицаПартнеров_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Автор) Тогда
		
		ПолученныеДанные.Автор = Пользователи.ТекущийПользователь();	
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.ДатаРегистрацииСвязи) Тогда
		
		ПолученныеДанные.ДатаРегистрацииСвязи = ТекущаяДатаСеанса();	
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	Если ПолученныеДанные.КонтактнаяИнформация.Количество() > 0 Тогда
		ДанныеИБ.КонтактнаяИнформация.Загрузить(ПолученныеДанные.КонтактнаяИнформация.Выгрузить());	
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеРеквизиты.Количество() > 0 Тогда
		ДанныеИБ.ДополнительныеРеквизиты.Загрузить(ПолученныеДанные.ДополнительныеРеквизиты.Выгрузить());
	КонецЕсли; 
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры

