Процедура ПКО_Документ_СчетФактураКомиссионеру_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОтчетКомиссионера;
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.КодВидаОперации) Тогда
		ПолученныеДанные.КодВидаОперации = "01";
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("СпособВыставления") И ЗначениеЗаполнено(ДанныеXDTO.СпособВыставления) Тогда
		ПолученныеДанные.ВыставленВЭлектронномВиде = (ДанныеXDTO.СпособВыставления.Значение = "ВЭлектронномВиде");
	КонецЕсли;
	
	// В Счет-фактуре комиссионеру может быть указан только один документ - основание.
	// В противном случае загружается счет-фактура выданный.
	Если ДанныеXDTO.Свойство("ДокументыОснования") И ЗначениеЗаполнено(ДанныеXDTO.ДокументыОснования) Тогда
		СтрокаТаблицы = ДанныеXDTO.ДокументыОснования[0];
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДокументОснование", СтрокаТаблицы.ДокументОснование);
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.СчетФактураОснование) И ЗначениеЗаполнено(СтрокаТаблицы.ИсходныйДокумент) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("СчетФактураОснование", СтрокаТаблицы.ИсходныйДокумент);
		КонецЕсли;
	КонецЕсли;
	
	Покупатели = Новый Массив;
	СтруктураДанныхСтроки = Новый Структура("НомерСчетаФактуры, Покупатель");
	Если ДанныеXDTO.Свойство("НомерСчетаФактурыКомиссионера") Тогда
		СтруктураДанныхСтроки.НомерСчетаФактуры = ДанныеXDTO.НомерСчетаФактурыКомиссионера;
	КонецЕсли;
	Если ДанныеXDTO.Свойство("КонечныйПокупатель")
		И ЗначениеЗаполнено(ДанныеXDTO.КонечныйПокупатель) Тогда
		СтруктураДанныхСтроки.Покупатель = ДанныеXDTO.КонечныйПокупатель;
	Иначе
		СтруктураДанныхСтроки.Покупатель = ДанныеXDTO.Контрагент;
	КонецЕсли;
	Покупатели.Добавить(СтруктураДанныхСтроки);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Покупатели", Покупатели);		
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры

Процедура ДобавитьПКО_Документ_СчетФактураКомитента_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_СчетФактураКомитента_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.СчетФактураКомитента;
	ПравилоКонвертации.ОбъектФормата                = "Документ.СчетФактураПолученный"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_СчетФактураКомитента_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_СчетФактураКомитента_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_СФКомитента";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Валюта",                  "", 1);
	ДобавитьПКС(СвойстваШапки, "Дата",                    "ДатаПолучения");
	ДобавитьПКС(СвойстваШапки, "ДатаИсправления",         "ДатаИсправления");
	ДобавитьПКС(СвойстваШапки, "ДатаСоставления",         "ДатаВходящегоДокумента");
	ДобавитьПКС(СвойстваШапки, "ИННКомитента",            "ИННКонтрагента");
	ДобавитьПКС(СвойстваШапки, "Исправление",             "Исправление");
	ДобавитьПКС(СвойстваШапки, "КодВидаОперации",         "КодВидаОперации");
	ДобавитьПКС(СвойстваШапки, "Комитент",                "Контрагент", , "Справочник_Контрагенты_Получение");
	ДобавитьПКС(СвойстваШапки, "Комментарий",             "Комментарий");
	ДобавитьПКС(СвойстваШапки, "КППКомитента",            "КППКонтрагента");
	ДобавитьПКС(СвойстваШапки, "Номер",                   "НомерВходящегоДокумента");
	ДобавитьПКС(СвойстваШапки, "НомерИсправления",        "НомерИсправления");
	ДобавитьПКС(СвойстваШапки, "Организация",             "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "ПолученВЭлектронномВиде", "", 1);
	ДобавитьПКС(СвойстваШапки, "Проведен",                "", 1);
	ДобавитьПКС(СвойстваШапки, "СуммаНДС",                "СуммаНДС");
	ДобавитьПКС(СвойстваШапки, "СуммаСНДС",               "Сумма");
	ДобавитьПКС(СвойстваШапки, "ХозяйственнаяОперация",   "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "Покупатели", "СчетаФактурыВыданныеПокупателям");
	ДобавитьПКС(СвойстваТЧ, "Покупатель",          "Покупатель", , "Справочник_Контрагенты_Получение");
	ДобавитьПКС(СвойстваТЧ, "Субкомиссионер",      "Субкомиссионер", , "Справочник_Контрагенты_Получение");
	ДобавитьПКС(СвойстваТЧ, "СуммаНДС",            "СуммаНДС");
	ДобавитьПКС(СвойстваТЧ, "СуммаСНДС",           "Сумма");
	ДобавитьПКС(СвойстваТЧ, "СчетФактураВыданный", "СчетФактураВыданный", , "Документ_СчетФактураВыданный_Получение");

КонецПроцедуры
Процедура ПКО_Документ_СчетФактураКомитента_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОтчетКомитенту;
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.КодВидаОперации) Тогда
		ПолученныеДанные.КодВидаОперации = "01";
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("СпособВыставления") И ЗначениеЗаполнено(ДанныеXDTO.СпособВыставления) Тогда
		ПолученныеДанные.ПолученВЭлектронномВиде = (ДанныеXDTO.СпособВыставления.Значение = "ВЭлектронномВиде");
	КонецЕсли;
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Документ_СчетФактураКомитента_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
	                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
КонецПроцедуры

Процедура ДобавитьПКО_Документ_СчетФактураНалоговыйАгент_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_СчетФактураНалоговыйАгент_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.СчетФактураНалоговыйАгент;
	ПравилоКонвертации.ОбъектФормата                = "Документ.СчетФактураВыданный"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_СчетФактураНалоговыйАгент_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_СчетФактураНалоговыйАгент_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_СФНалоговыйАгент";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Валюта",                "Валюта", , "Справочник_Валюты");
	ДобавитьПКС(СвойстваШапки, "ГлавныйБухгалтер",      "", 1, "Справочник_ОтветственныеЛица_ИзСтруктуры_Получение");
	ДобавитьПКС(СвойстваШапки, "Дата",                  "ДатаВыставления");
	ДобавитьПКС(СвойстваШапки, "Дата",                  "Дата");
	ДобавитьПКС(СвойстваШапки, "ДокументОснование",     "", 1);
	ДобавитьПКС(СвойстваШапки, "КодВидаОперации",       "КодВидаОперации");
	ДобавитьПКС(СвойстваШапки, "Номер",                 "Номер");
	ДобавитьПКС(СвойстваШапки, "Организация",           "Организация", , "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваШапки, "Поставщик",             "Контрагент", , "Справочник_Контрагенты_Получение");
	ДобавитьПКС(СвойстваШапки, "Проведен",              "", 1);
	ДобавитьПКС(СвойстваШапки, "Руководитель",          "", 1, "Справочник_ОтветственныеЛица_ИзСтруктуры_Получение");
	ДобавитьПКС(СвойстваШапки, "Сумма",                 "Сумма");
	ДобавитьПКС(СвойстваШапки, "СуммаНДС",              "СуммаНДС");
	ДобавитьПКС(СвойстваШапки, "ХозяйственнаяОперация", "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "РасшифровкаСуммы", "");
	ДобавитьПКС(СвойстваТЧ, "СтавкаНДС", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Сумма",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаНДС",  "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаСНДС", "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("Дата,Номер,Организация");
КонецПроцедуры
Процедура ПКО_Документ_СчетФактураНалоговыйАгент_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.НачислениеНДСНалоговымАгентом;
	
	ЗагрузитьОтветственноеЛицо(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, "ГлавныйБухгалтер");
	ЗагрузитьОтветственноеЛицо(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, "Руководитель");
	
	ДокОснование = ЗначениеВИнструкциюПКО(КомпонентыОбмена, ДанныеXDTO.ДокументыОснования[0].ДокументОснование);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ДокументОснование", ДокОснование);
	
	#Область РасшифровкаСуммы
	
	СтруктураДанныхСтроки = Новый Структура;
	Если ДанныеXDTO.Свойство("СтавкаНДС") И ЗначениеЗаполнено(ДанныеXDTO.СтавкаНДС) Тогда
		СтруктураДанныхСтроки.Вставить("СтавкаНДС", СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, ДанныеXDTO.СтавкаНДС));
	КонецЕсли;
	СуммаСНДС = 0;
	Если ДанныеXDTO.Свойство("Сумма") Тогда
		СтруктураДанныхСтроки.Вставить("Сумма", ДанныеXDTO.Сумма);
		СуммаСНДС = СуммаСНДС + ДанныеXDTO.Сумма; 
	КонецЕсли;
	Если ДанныеXDTO.Свойство("СуммаНДС") Тогда
		СтруктураДанныхСтроки.Вставить("СуммаНДС", ДанныеXDTO.СуммаНДС);
		СуммаСНДС = СуммаСНДС + ДанныеXDTO.СуммаНДС;
	КонецЕсли;
	Если НЕ СуммаСНДС = 0 Тогда
		СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанныхСтроки) Тогда
		МассивРасшифровкаСуммы = Новый Массив;
		МассивРасшифровкаСуммы.Добавить(СтруктураДанныхСтроки);
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("РасшифровкаСуммы", МассивРасшифровкаСуммы);
	КонецЕсли;
	
	#КонецОбласти
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Документ_СчетФактураНалоговыйАгент_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
