Процедура ПКО_Справочник_НомераГТД_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ТипНомераГТД) Тогда
		Если ДанныеИБ.ТипНомераГТД = Перечисления.ТипыНомеровГТД.НомерГТД Тогда
			ДанныеXDTO.Вставить("ЯвляетсяРНПТ", Ложь);
		Иначе
			ДанныеXDTO.Вставить("ЯвляетсяРНПТ", Истина);
		КонецЕсли;
	Иначе
		ДанныеXDTO.Вставить("ЯвляетсяРНПТ", Ложь);
	КонецЕсли;
КонецПроцедуры

