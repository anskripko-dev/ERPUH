Процедура ПКО_Документ_ОстаткиБезналичныхДС_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	ВводОстатковБанковскиеСчета.БанковскийСчет КАК БанковскийСчет,
		|	ВводОстатковБанковскиеСчета.БанковскийСчет.ВалютаДенежныхСредств КАК Валюта,
		|	ВводОстатковБанковскиеСчета.Сумма КАК Сумма,
		|	ВводОстатковБанковскиеСчета.СуммаРегл КАК СуммаРегл
		|ПОМЕСТИТЬ ВТДанные
		|ИЗ
		|	Документ.ВводОстатков.БанковскиеСчета КАК ВводОстатковБанковскиеСчета
		|ГДЕ
		|	ВводОстатковБанковскиеСчета.Ссылка = &Ссылка
		|;
		|
		//++ НЕ УТ
		
		//++ Локализация
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(НастройкиПоАналитике.СчетУчета) КАК СчетУчета,
		|	НастройкиПоАналитике.АналитикаУчета КАК АналитикаУчета
		|ПОМЕСТИТЬ ВТСчетаУчета
		|ИЗ
		|	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК НастройкиПоАналитике
		|ГДЕ
		|	НастройкиПоАналитике.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ДенежныеСредства)
		|	И НастройкиПоАналитике.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	И НастройкиПоАналитике.АналитикаУчета В
		|			(ВЫБРАТЬ
		|				ВТДанные.БанковскийСчет
		|			ИЗ
		|				ВТДанные КАК ВТДанные)
		|	И НастройкиПоАналитике.МестоУчета = НЕОПРЕДЕЛЕНО
		|
		|СГРУППИРОВАТЬ ПО
		|	НастройкиПоАналитике.АналитикаУчета
		|;
		|
		//-- Локализация
		
		//-- НЕ УТ
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		//++ НЕ УТ
		
		//++ Локализация
		|	ВЫБОР
		|		КОГДА ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета))
		|				ИЛИ ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВалютныеСчета))
		|			ТОГДА ""Расчетный""
		|		КОГДА ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Аккредитивы))
		|				ИЛИ ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.АккредитивыВал))
		|			ТОГДА ""Аккредитивы""
		|		КОГДА ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ЧековыеКнижки))
		|			ТОГДА ""ЧековыеКнижки""
		|		КОГДА ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ДепозитныеСчета))
		|				ИЛИ ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ДепозитныеСчетаВал))
		|			ТОГДА ""Депозитный""
		|		КОГДА ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеСпециальныеСчета))
		|				ИЛИ ВТСчетаУчета.СчетУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеСпециальныеСчетаВал))
		|			ТОГДА ""Иной""
		|	КОНЕЦ КАК ВидБанковскогоСчета,
		//-- Локализация
		
		//-- НЕ УТ
		|	ВТДанные.БанковскийСчет КАК БанковскийСчет,
		|	ВТДанные.Валюта КАК Валюта,
		|	ВТДанные.Сумма КАК Сумма,
		|	ВТДанные.СуммаРегл КАК СуммаРегл
		|ИЗ
		|	ВТДанные КАК ВТДанные
		//++ НЕ УТ
		
		//++ Локализация
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСчетаУчета КАК ВТСчетаУчета
		|		ПО ВТДанные.БанковскийСчет = ВТСчетаУчета.АналитикаУчета
		//-- Локализация
		
		//-- НЕ УТ
		|");
		
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	ТаблицаДенежныеСредства = Запрос.Выполнить().Выгрузить();
	ДанныеXDTO.Вставить("ДенежныеСредства", ТаблицаДенежныеСредства);
КонецПроцедуры

