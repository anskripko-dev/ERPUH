Процедура ПКО_Документ_СтатистикаПерсонала_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	СтатистикаПерсоналаПоказатели.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	СтатистикаПерсоналаПоказатели.СреднесписочнаяЧисленностьСотрудников КАК СреднесписочнаяЧисленностьСотрудников,
		|	СтатистикаПерсоналаПоказатели.СреднесписочнаяЧисленностьВнешнихСовместителей КАК СреднесписочнаяЧисленностьВнешнихСовместителей,
		|	СтатистикаПерсоналаПоказатели.СредняяЧисленностьДоговорников КАК СредняяЧисленностьДоговорников,
		|	&Организация КАК Организация
		|ПОМЕСТИТЬ вт_ДанныеДокумента
		|ИЗ
		|	Документ.СтатистикаПерсонала.Показатели КАК СтатистикаПерсоналаПоказатели
		|ГДЕ
		|	СтатистикаПерсоналаПоказатели.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РегистрацииВНалоговомОргане.Организация КАК Организация,
		|	МАКСИМУМ(РегистрацииВНалоговомОргане.Подразделение) КАК Подразделение,
		|	РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
		|ПОМЕСТИТЬ вт_РегистрацииВНалоговомОргане
		|ИЗ
		|	РегистрСведений.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
		|
		|СГРУППИРОВАТЬ ПО
		|	РегистрацииВНалоговомОргане.Организация,
		|	РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(вт_РегистрацииВНалоговомОргане.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
		|	вт_ДанныеДокумента.СреднесписочнаяЧисленностьСотрудников КАК СреднесписочнаяЧисленностьСотрудников,
		|	вт_ДанныеДокумента.СреднесписочнаяЧисленностьВнешнихСовместителей КАК СреднесписочнаяЧисленностьВнешнихСовместителей,
		|	вт_ДанныеДокумента.СредняяЧисленностьДоговорников КАК СредняяЧисленностьДоговорников
		|ИЗ
		|	вт_ДанныеДокумента КАК вт_ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_РегистрацииВНалоговомОргане КАК вт_РегистрацииВНалоговомОргане
		|		ПО вт_ДанныеДокумента.Организация = вт_РегистрацииВНалоговомОргане.Организация
		|			И вт_ДанныеДокумента.РегистрацияВНалоговомОргане = вт_РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане
		|");
	
	Запрос.УстановитьПараметр("Ссылка",      ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДанныеИБ.Организация);
	
	ДанныеXDTO.Вставить("Показатели", Запрос.Выполнить().Выгрузить());
КонецПроцедуры

