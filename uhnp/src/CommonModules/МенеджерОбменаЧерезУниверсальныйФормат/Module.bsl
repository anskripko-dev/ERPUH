	ДобавитьПКС(СвойстваШапки, "ДатаВыставления",           "ДатаВыставления");
	ДобавитьПКС(СвойстваШапки, "Договор",                   "", 1);
	ДобавитьПКС(СвойстваШапки, "ДокументОснование",         "", 1);
	ДобавитьПКС(СвойстваШапки, "ИдентификаторГосКонтракта", "", 1);
