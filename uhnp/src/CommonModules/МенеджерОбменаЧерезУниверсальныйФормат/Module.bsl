Процедура ПКО_Документ_КорректировкаРеализации_Реализация_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Префикс = "SA";
	//++ Локализация
	Префикс = "КР";
	//-- Локализация
	Номер = Лев(ДанныеИБ.Номер, 5) + Префикс + Сред(ДанныеИБ.Номер, 8);
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		ДанныеXDTO.Вставить("Номер", Номер);
		Возврат;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_КорректировкаРеализации_Реализация", 
										"Товары", 
										"НомерГТД",
										Истина,
										"Справочник_НомераГТД_Отправка");
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_КорректировкаРеализации_Реализация", 
										"Товары", 
										"СтавкаНДС",
										Истина,
										"СправочникСсылка_СтавкиНДС_Отправка");
	КонецЕсли;	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", Номер);
	
	ДанныеXDTO.Вставить("ВидОперации", "РеализацияКлиенту");
	
	СкладДляВыгрузки = СкладДляВыгрузки(ДанныеИБ.Склад, КомпонентыОбмена.ПараметрыКонвертации, Истина);
	ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
	
	ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, "Склад");
	ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Ложь);
	
	ДанныеXDTO.Вставить("КурсВзаиморасчетов",      ДанныеИБ.ДополнительныеСвойства.КурсВзаиморасчетов);
	ДанныеXDTO.Вставить("КратностьВзаиморасчетов", ДанныеИБ.ДополнительныеСвойства.КратностьВзаиморасчетов);
	ДанныеXDTO.Вставить("Руководитель",            ДанныеИБ.ДополнительныеСвойства.Руководитель);
	ДанныеXDTO.Вставить("ГлавныйБухгалтер",        ДанныеИБ.ДополнительныеСвойства.ГлавныйБухгалтер);
	
	ДанныеXDTO.Вставить("Товары", ДанныеИБ.ДополнительныеСвойства.Товары);
КонецПроцедуры

