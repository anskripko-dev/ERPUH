Процедура ПОД_Документ_ВедомостьНаВыплатуЗарплаты_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ИспользоватьЗаявкиНаРасходованиеДС = КомпонентыОбмена.ПараметрыКонвертации.ИспользоватьЗаявкиНаРасходованиеДенежныхСредств;
	
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") И ДанныеXDTO.КлючевыеСвойства.Свойство("ПериодВыплаты") Тогда
		УтвержденнаяДатаПлатежа = ДанныеXDTO.КлючевыеСвойства.ПериодВыплаты;
	Иначе	
		УтвержденнаяДатаПлатежа = Дата(1,1,1);
	КонецЕсли;
	
	ИспользованиеПКО["Документ_ВедомостьВЗаявку_Выплата_Получение"] = ИспользоватьЗаявкиНаРасходованиеДС;
	ИспользованиеПКО["Документ_ВедомостьВЗаявку_НДФЛ_Получение"] = ИспользоватьЗаявкиНаРасходованиеДС И (УтвержденнаяДатаПлатежа < Дата(2023,2,1));
	ИспользованиеПКО["Документ_ВедомостьВЗаявку_НДФЛСПревыш_Получение"] = Ложь;
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда  
		Если ДанныеXDTO.AdditionalInfo.Свойство("РасшифровкаНДФЛ") Тогда
			РасшифровкаНДФЛ = ДанныеXDTO.AdditionalInfo.РасшифровкаНДФЛ;
			ИспользованиеПКО["Документ_ВедомостьВЗаявку_НДФЛ_Получение"] = РасшифровкаНДФЛ.Свойство("НДФЛ")  
			И РасшифровкаНДФЛ.НДФЛ > 0;
			ИспользованиеПКО["Документ_ВедомостьВЗаявку_НДФЛСПревыш_Получение"] = РасшифровкаНДФЛ.Свойство("НДФЛСПревышения") 
			И РасшифровкаНДФЛ.НДФЛСПревышения > 0 И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.11"); 
		КонецЕсли;
	ИначеЕсли УтвержденнаяДатаПлатежа >= Дата(2023,2,1) Тогда 
		ИспользованиеПКО["Документ_ВедомостьВЗаявку_НДФЛ_Получение"]  = Ложь; 
	
	КонецЕсли;
КонецПроцедуры

