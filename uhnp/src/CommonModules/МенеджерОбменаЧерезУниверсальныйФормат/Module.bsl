	ПравилоКонвертации.ВариантИдентификации         = "ПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Номенклатура",   "", 1, "Справочник_Номенклатура_Получение");
	ДобавитьПКС(СвойстваШапки, "Сегмент",        "", 1, "Справочник_СегментыНоменклатуры");
	ДобавитьПКС(СвойстваШапки, "Характеристика", "", 1, "Справочник_ХарактеристикиНоменклатуры");
	ПравилоКонвертации.ПоляПоиска.Добавить("Номенклатура,Сегмент,Характеристика");
	ПравилоКонвертации.ПоляПоиска.Добавить("Номенклатура,Сегмент");
КонецПроцедуры
Процедура ПКО_РегистрСведений_НоменклатураСегмента_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ДополнительныеСвойства.Вставить("СегментОтбор", ДанныеXDTO.Сегмент);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("НоменклатураОтбор", ДанныеXDTO.Номенклатура);
	
	Если ДанныеXDTO.Свойство("Характеристика")
		И ЗначениеЗаполнено(ДанныеXDTO.Характеристика) Тогда
	
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ХарактеристикаОтбор", ДанныеXDTO.Характеристика);
	
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_РегистрСведений_НоменклатураСегмента_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ПКО_Номенклатура_Получение = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,"Справочник_Номенклатура_Получение");
	ПКО_СегментыНоменклатуры = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,"Справочник_СегментыНоменклатуры");
	
	ДополнительныеСвойства = ПолученныеДанные.ДополнительныеСвойства;
	
	Запись = ПолученныеДанные.Добавить(); 
	
	Номенклатура = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
		ДополнительныеСвойства.НоменклатураОтбор, 
		ПКО_Номенклатура_Получение, 
		"ПолучитьСсылку").Ссылка;  
		
	СегментНоменклатуры = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
		ДополнительныеСвойства.СегментОтбор, 
		ПКО_СегментыНоменклатуры, 
		"ПолучитьСсылку").Ссылка;
	
	ПолученныеДанные.Отбор.Номенклатура.Значение = Номенклатура;
	ПолученныеДанные.Отбор.Номенклатура.Использование = Истина;
	
	Запись.Номенклатура = Номенклатура;
	
	ПолученныеДанные.Отбор.Сегмент.Значение = СегментНоменклатуры;;
	ПолученныеДанные.Отбор.Сегмент.Использование = Истина;
	
	Запись.Сегмент = СегментНоменклатуры;
	
	Если ДополнительныеСвойства.Свойство("ХарактеристикаОтбор")
		И ЗначениеЗаполнено(ДополнительныеСвойства.ХарактеристикаОтбор) Тогда
		
		ПКО_ХарактеристикиНоменклатуры = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,"Справочник_ХарактеристикиНоменклатуры");
		
		Характеристика = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
			ДополнительныеСвойства.ХарактеристикаОтбор, 
			ПКО_ХарактеристикиНоменклатуры, 
			"ПолучитьСсылку").Ссылка;
		
		ПолученныеДанные.Отбор.Характеристика.Значение = Характеристика;;
		ПолученныеДанные.Отбор.Характеристика.Использование = Истина;
		
		Запись.Характеристика = Характеристика;
		
	КонецЕсли;
КонецПроцедуры

