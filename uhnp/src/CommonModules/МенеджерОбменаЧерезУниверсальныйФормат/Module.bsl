	//Если РасшифровкаПлатежа.Количество() > 0 
	//	И ЗначениеЗаполнено(РасшифровкаПлатежа[0].ЗаявкаНаРасходованиеДенежныхСредств) Тогда
	//	ДанныеXDTO.Вставить("ЗаявкаНаРасходДенежныхСредств", РасшифровкаПлатежа[0].ЗаявкаНаРасходованиеДенежныхСредств);
	//КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ЗаявкаНаРасходованиеДенежныхСредств) Тогда
		ДанныеXDTO.Вставить("ЗаявкаНаРасходДенежныхСредств", ДанныеИБ.ЗаявкаНаРасходованиеДенежныхСредств);
	КонецЕсли;  
	
	#Область РасшифровкаПлатежа
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|	ТаблицаРасшифровкаПлатежа.Сумма КАК Сумма,
		|	ТаблицаРасшифровкаПлатежа.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
		|	ТаблицаРасшифровкаПлатежа.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
		|	ВЫБОР
		|		КОГДА ТаблицаРасшифровкаПлатежа.ОбъектРасчетов.Объект ССЫЛКА Справочник.ДоговорыКонтрагентов
		|			ТОГДА NULL
		|		ИНАЧЕ ТаблицаРасшифровкаПлатежа.ОбъектРасчетов.Объект
		|	КОНЕЦ КАК ОбъектРасчетов,
		|	ТаблицаРасшифровкаПлатежа.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ВЫБОР
		|		КОГДА ТаблицаРасшифровкаПлатежа.ОбъектРасчетов.Объект ССЫЛКА Справочник.ДоговорыКонтрагентов
		|			ТОГДА ТаблицаРасшифровкаПлатежа.ОбъектРасчетов.Объект
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|	КОНЕЦ КАК Договор,
		//++ НЕ УТ  
		|ТаблицаРасшифровкаПлатежа.ДатаПогашения КАК ДатаПогашения,
		//-- НЕ УТ
		|	ТаблицаРасшифровкаПлатежа.Контрагент КАК Самозанятый,
		|	ВЫБОР
		|		КОГДА ДокументСписания.СписокКонтрагентов
		|			ТОГДА ТаблицаБанковскиеСчетаСпискаКонтрагентов.БанковскийСчетКонтрагента
		|		ИНАЧЕ ДокументСписания.БанковскийСчетКонтрагента
		|	КОНЕЦ КАК БанковскийСчет,
		|	ВЫБОР
		|		КОГДА ТаблицаРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.КорреспондирующийСчет <> """"""""
		|				И &ЭтоУТ
		|			ТОГДА ТаблицаРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.КорреспондирующийСчет
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СчетУчетаРасчетовСКонтрагентом
		|ИЗ
		|	Документ.СписаниеБезналичныхДенежныхСредств КАК ДокументСписания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ТаблицаРасшифровкаПлатежа
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеБезналичныхДенежныхСредств.БанковскиеСчетаСпискаКонтрагентов КАК ТаблицаБанковскиеСчетаСпискаКонтрагентов
		|			ПО ТаблицаРасшифровкаПлатежа.Ссылка = ТаблицаБанковскиеСчетаСпискаКонтрагентов.Ссылка 
		|				И ТаблицаРасшифровкаПлатежа.Контрагент = ТаблицаБанковскиеСчетаСпискаКонтрагентов.Контрагент
		|		ПО ДокументСписания.Ссылка = ТаблицаРасшифровкаПлатежа.Ссылка
		|ГДЕ
		|	ДокументСписания.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ЭтоУТ", ЭтоУТ());
	
	РасшифровкаПлатежаДокумента = Запрос.Выполнить().Выгрузить();
	
	РасшифровкаПлатежа = Новый ТаблицаЗначений; 
	РасшифровкаПлатежа.Колонки.Добавить("БанковскийСчет");
	РасшифровкаПлатежа.Колонки.Добавить("ВалютаВзаиморасчетов");
	РасшифровкаПлатежа.Колонки.Добавить("Договор");
	РасшифровкаПлатежа.Колонки.Добавить("Заказ");
	РасшифровкаПлатежа.Колонки.Добавить("ДокументРасчетов");
	РасшифровкаПлатежа.Колонки.Добавить("ИдентификаторСтроки");
	РасшифровкаПлатежа.Колонки.Добавить("Самозанятый");
	РасшифровкаПлатежа.Колонки.Добавить("СтатьяДДС");
	РасшифровкаПлатежа.Колонки.Добавить("Сумма");
	РасшифровкаПлатежа.Колонки.Добавить("СуммаВзаиморасчетов");
	РасшифровкаПлатежа.Колонки.Добавить("СпособПогашенияЗадолженности");
	РасшифровкаПлатежа.Колонки.Добавить("СчетУчетаРасчетовСКонтрагентом");
	//++ НЕ УТ
	РасшифровкаПлатежа.Колонки.Добавить("ДатаПогашения"); 
	//-- НЕ УТ
	
	Для Каждого СтрокаРасшифровкиПлатежаДокумента Из РасшифровкаПлатежаДокумента Цикл
		
		СтрокаРасшифровкиПлатежа = РасшифровкаПлатежа.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасшифровкиПлатежа, СтрокаРасшифровкиПлатежаДокумента);
		
		Если ЗначениеЗаполнено(СтрокаРасшифровкиПлатежаДокумента.ОбъектРасчетов)
			И СтрокаРасшифровкиПлатежаДокумента.ОбъектРасчетов <> ДанныеИБ.Ссылка Тогда
			
			ВыгрузитьЗаказДокументРасчетовРасшифровкиПлатежа(СтрокаРасшифровкиПлатежа, 
				СтрокаРасшифровкиПлатежаДокумента.ОбъектРасчетов, ДанныеИБ, КомпонентыОбмена);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеXDTO.Вставить("РасшифровкаПлатежа", РасшифровкаПлатежа);
	
	//++ НЕ УТ
	
	ВыгрузитьДатыПогашенияВРасшифровкуПлатежа(ДанныеИБ, ДанныеXDTO, ДанныеXDTO.РасшифровкаПлатежа);   
	
	//-- НЕ УТ  
	
	#КонецОбласти
КонецПроцедуры

