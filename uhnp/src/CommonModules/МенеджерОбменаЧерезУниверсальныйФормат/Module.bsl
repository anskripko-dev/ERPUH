Процедура ОтложеннаяОбработка_ПроизводствоБезЗаказа(Объект, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(Объект.ВидЦены) Тогда
		Объект.ВидЦены = Справочники.ВидыЦен.ВидЦеныПлановойСтоимостиТМЦ(Объект.ВидЦены);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВыпускПодДеятельность) Тогда
		ПараметрыЗаполнения = Документы.ПроизводствоБезЗаказа.ПараметрыЗаполненияВидаДеятельностиНДС(Объект);
		УчетНДСУП.ЗаполнитьВидДеятельностиНДС(Объект.ВыпускПодДеятельность, ПараметрыЗаполнения);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		Объект.Валюта = ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета();
	КонецЕсли;
	
	Объект.РаспоряжениеДляТрудозатрат = Истина;
	
	Для Каждого СтрокаТаблицы из Объект.ВыходныеИзделия Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Получатель) Тогда
			СтрокаТаблицы.Получатель = СкладДляЗагрузки(СтрокаТаблицы.Получатель, КомпонентыОбмена.ПараметрыКонвертации);
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерГруппыЗатрат) Тогда
			СтрокаТаблицы.НомерГруппыЗатрат = 1;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоПлановойСтоимости Тогда
		// Пересчитаем доли по плановой стоимости.
		ПараметрыРаспределенияЗатратСтруктура = Документы.ПроизводствоБезЗаказа.ПараметрыРаспределенияЗатрат(Объект);
		ПараметрыРаспределенияЗатрат = Новый ФиксированнаяСтруктура(ПараметрыРаспределенияЗатратСтруктура);
		
		ПроизводствоСервер.РассчитатьДолюСтоимости(Объект, ПараметрыРаспределенияЗатрат);
	КонецЕсли;
	
	МассивСтрокДляПерерасчетаЦены = Новый Массив;
	Для Каждого СтрокаТаблицы из Объект.ПобочныеИзделия Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Получатель) Тогда
			СтрокаТаблицы.Получатель = СкладДляЗагрузки(СтрокаТаблицы.Получатель, КомпонентыОбмена.ПараметрыКонвертации);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Подразделение) Тогда
			Подразделение = Неопределено;
			Если ЗначениеЗаполнено(СтрокаТаблицы.Получатель)
				И ТипЗнч(СтрокаТаблицы.Получатель) = Тип("СправочникСсылка.Склады") Тогда
				Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Получатель, "Подразделение");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
				Подразделение = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Подразделение) Тогда
				СтрокаТаблицы.Подразделение = Подразделение;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяКалькуляции) Тогда
			СтрокаТаблицы.СтатьяКалькуляции = ЭлементПоУмолчанию(КомпонентыОбмена, "СтатьяКалькуляцииВозвратныеОтходы");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Цена) И ЗначениеЗаполнено(Объект.ВидЦены) Тогда
			МассивСтрокДляПерерасчетаЦены.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	// Перезаполним стоимость возвратных отходов по плановой стоимости.
	Если МассивСтрокДляПерерасчетаЦены.Количество() > 0 Тогда
		
		ПараметрыЗаполнения = ЦеныПредприятияЗаполнениеСервер.НовыйПараметрыЗаполненияЗаполнитьЦены();
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, Объект, "Дата, Валюта, ВидЦены, Организация");
		ПараметрыЗаполнения.ПоляЗаполнения = "Цена";
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму", "КоличествоУпаковок");
		
		ЦеныРассчитаны = ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(
			Объект.ПобочныеИзделия,
			МассивСтрокДляПерерасчетаЦены,
			ПараметрыЗаполнения,
			СтруктураДействий);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы из Объект.МатериалыИРаботы Цикл
	
		СтрокаТаблицы.Склад = СкладДляЗагрузки(СтрокаТаблицы.Склад, КомпонентыОбмена.ПараметрыКонвертации);	
	
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Подразделение) Тогда
			Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Склад, "Подразделение");
			Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
				Подразделение = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
			КонецЕсли;
			
			СтрокаТаблицы.Подразделение = Подразделение;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерГруппыЗатрат) Тогда
			СтрокаТаблицы.НомерГруппыЗатрат = 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяКалькуляции) Тогда
			СтрокаТаблицы.СтатьяКалькуляции = ЭлементПоУмолчанию(КомпонентыОбмена, "СтатьяКалькуляцииМатериальныеЗатраты");
		КонецЕсли;
	КонецЦикла;
	
	// Проверим реквизиты подразделения.
	ЗначенияРеквизитов = Новый Структура("ПроизводственноеПодразделение, ПроизводствоБезЗаказов", Истина, Истина);
	ПроверитьОбновитьРеквизитыОбъекта(Объект.Подразделение, ЗначенияРеквизитов, КомпонентыОбмена);
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
КонецПроцедуры
