Процедура ПОД_Документ_ЗаявлениеОВвозеТоваров_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда 
	 
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
	
		ШаблонПредупреждения = НСтр("ru = 'Документ %1 не выгружен, так как не поддерживается в формате %3';
									|en = 'The %1 document is not exported as it is not supported in the %3 format'");
		ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ДанныеИБ.Ссылка, Строка(КомпонентыОбмена.ВерсияФорматаОбмена));
		ПредупреждениеПриСинхронизации(КомпонентыОбмена, ДанныеИБ.Ссылка, ТекстПредупреждения);
	
	КонецЕсли;
КонецПроцедуры

