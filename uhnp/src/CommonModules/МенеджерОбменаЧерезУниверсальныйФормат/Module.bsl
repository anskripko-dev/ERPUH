	Если Объект.РасшифровкаПлатежа.Количество() = 1 Тогда
		Строка = Объект.РасшифровкаПлатежа[0];
		Строка.Сумма = СуммаДокумента;
		Строка.СуммаВзаиморасчетов = СуммаДокумента;
		Строка.ВалютаВзаиморасчетов = Объект.Валюта;
		Строка.Организация = Объект.Организация;
		Строка.ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Объект.ДокументОснование);
	КонецЕсли;
КонецПроцедуры
