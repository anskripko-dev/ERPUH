Процедура ПКО_Документ_ОстаткиНематериальныхАктивов_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен              = Истина;
	ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковНМАиРасходовНаНИОКР;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("НематериальныйАктив", "НематериальныйАктивСсылка");
	// Стоимость. 
	ПравилаЗаполнения.Вставить("ПервоначальнаяСтоимостьБУ", "ПервоначальнаяСтоимостьБУ");
	ПравилаЗаполнения.Вставить("ПервоначальнаяСтоимостьНУ", "ПервоначальнаяСтоимостьНУ");
	ПравилаЗаполнения.Вставить("ТекущаяСтоимостьБУ",        "ТекущаяСтоимостьБУ");
	ПравилаЗаполнения.Вставить("ТекущаяСтоимостьНУ",        "ТекущаяСтоимостьНУ");
	ПравилаЗаполнения.Вставить("ТекущаяСтоимостьПР",        "ТекущаяСтоимостьПР");
	ПравилаЗаполнения.Вставить("ТекущаяСтоимостьВР",        "ТекущаяСтоимостьВР");
	// Принятие к учету.
	ПравилаЗаполнения.Вставить("ДатаПринятияКУчету", "ДатаПринятияКУчетуРегл");
	ПравилаЗаполнения.Вставить("ДатаПриобретения",   "ДатаПриобретения");
	ПравилаЗаполнения.Вставить("СпособПоступления",  "СпособПоступления");
	ПравилаЗаполнения.Вставить("ВидОбъектаУчета",    "ВидОбъектаУчета");
	// Амортизация.
	ПравилаЗаполнения.Вставить("НачислятьАмортизациюБУ",        "НачислятьАмортизациюБУ");
	ПравилаЗаполнения.Вставить("СпособНачисленияАмортизацииБУ", "СпособНачисленияАмортизацииБУ");
	ПравилаЗаполнения.Вставить("СпособНачисленияАмортизацииНУ", "МетодНачисленияАмортизацииНУ");
	ПравилаЗаполнения.Вставить("СрокПолезногоИспользованияБУ",  "СрокПолезногоИспользованияБУ");
	ПравилаЗаполнения.Вставить("КоэффициентБУ",                 "КоэффициентБУ");
	ПравилаЗаполнения.Вставить("НачислятьАмортизациюНУ",        "НачислятьАмортизациюНУ");
	ПравилаЗаполнения.Вставить("СпециальныйКоэффициентНУ",      "СпециальныйКоэффициентНУ");
	ПравилаЗаполнения.Вставить("СрокПолезногоИспользованияНУ",  "СрокПолезногоИспользованияНУ");
	ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияБУ",      "НакопленнаяАмортизацияБУ");
	ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияНУ",      "НакопленнаяАмортизацияНУ");
	ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияПР",      "НакопленнаяАмортизацияПР");
	ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияВР",      "НакопленнаяАмортизацияВР");
	ПравилаЗаполнения.Вставить("ОбъемПродукцииРаботДляВычисленияАмортизации", "ОбъемПродукцииРаботДляВычисленияАмортизации");
	// Использование до 2009г.
	ПравилаЗаполнения.Вставить("АмортизацияДо2009",         "АмортизацияДо2009");
	ПравилаЗаполнения.Вставить("СрокИспользованияНУДо2009", "ФактическийСрокИспользованияДо2009");
	
	МассивСтрокТЧ = Новый Массив;
	
	Для Каждого Строка Из ДанныеXDTO.НематериальныеАктивы Цикл
	
		СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
		
		// Заполнение данных НМА.
		ИнструкцияНМА = Новый Структура;
		Если СтруктураДанныхСтроки.Свойство("НематериальныйАктивСсылка") Тогда
			ИнструкцияНМА.Вставить("ИмяПКО",   "Справочник_НематериальныеАктивы");
			ИнструкцияНМА.Вставить("Значение", СтруктураДанныхСтроки.НематериальныйАктивСсылка);
		Иначе
			ИнструкцияНМА.Вставить("ИмяПКО", "Справочник_НМА_Получение");
			
			ДанныеНМА = Новый Структура();
			ДанныеНМА.Вставить("Код", Строка.КодВПрограмме);
			ДанныеНМА.Вставить("Наименование");
			ДанныеНМА.Вставить("НаименованиеПолное");
			ДанныеНМА.Вставить("ПрочиеСведения");
			ДанныеНМА.Вставить("АмортизационнаяГруппа");
			ДанныеНМА.Вставить("ВидОбъектаУчета");
			ЗаполнитьЗначенияСвойств(ДанныеНМА, Строка);
			
			ИнструкцияНМА.Вставить("Значение", ДанныеНМА);
		КонецЕсли;
		СтруктураДанныхСтроки.Вставить("НематериальныйАктив", ИнструкцияНМА);
		
		// Заполнение счетов учета и амортизации.
		СчетУчета       = БухгалтерскийСчетПоКоду(Строка.СчетУчетаБУ, ПланыСчетов.Хозрасчетный.НематериальныеАктивыОрганизации);
		СчетАмортизации = БухгалтерскийСчетПоКоду(Строка.СчетАмортизацииБУ, ПланыСчетов.Хозрасчетный.АмортизацияНематериальныхАктивов);
		
		СтруктураДанныхСтроки.Вставить("СчетУчетаБУ", СчетУчета);
		СтруктураДанныхСтроки.Вставить("СчетНачисленияАмортизацииБУ", СчетАмортизации);
		СтруктураДанныхСтроки.Вставить("ПорядокСписанияНИОКРНаРасходыНУ", Перечисления.ПорядокСписанияНИОКРНУ.Равномерно);
	
		МассивСтрокТЧ.Добавить(СтруктураДанныхСтроки);
		
	КонецЦикла;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("НМА", МассивСтрокТЧ);
КонецПроцедуры

