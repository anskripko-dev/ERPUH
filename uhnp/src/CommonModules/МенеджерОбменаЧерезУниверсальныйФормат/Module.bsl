	Если ТипЗнч(ДанныеИБ.БанковскийСчетКонтрагента) = ТИП("СправочникСсылка.БанковскиеСчетаКонтрагентов") Тогда
		Расшифровка = ДанныеИБ.РасшифровкаПлатежа[0];
