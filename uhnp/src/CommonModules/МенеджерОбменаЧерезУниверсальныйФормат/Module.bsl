Процедура ПКО_ДокументСсылка_ОперацияПоЯндексКассе_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;    
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"ДокументСсылка_ОперацияПоЯндексКассе_Отправка", 
										"РасшифровкаПлатежа", 
										"СтавкаНДС",
										Истина,
										"СправочникСсылка_СтавкиНДС_Отправка");
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОперацияПоЯндексКассе.ОбъектРасчетов.Объект КАК ЗаказСсылка,
	                      |	ОперацияПоЯндексКассе.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
	                      |	ОперацияПоЯндексКассе.СуммаДокумента КАК Сумма,
	                      |	ОперацияПоЯндексКассе.СуммаНДС5 КАК СуммаНДС,
	                      |	0 КАК СуммаНДСОбщаяСтавка,
	                      |	0 КАК СуммаНДС10,
	                      |	0 КАК СуммаНДС7,
	                      |	ОперацияПоЯндексКассе.СуммаНДС5 КАК СуммаНДС5
	                      |ИЗ
	                      |	Документ.ОперацияПоЯндексКассе КАК ОперацияПоЯндексКассе
	                      |ГДЕ
	                      |	ОперацияПоЯндексКассе.Ссылка = &Ссылка
	                      |	И ОперацияПоЯндексКассе.СуммаНДС5 > 0
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ОперацияПоЯндексКассе.ОбъектРасчетов.Объект,
	                      |	ОперацияПоЯндексКассе.СтатьяДвиженияДенежныхСредств,
	                      |	ОперацияПоЯндексКассе.СуммаДокумента,
	                      |	ОперацияПоЯндексКассе.СуммаНДС7,
	                      |	0,
	                      |	0,
	                      |	ОперацияПоЯндексКассе.СуммаНДС7,
	                      |	0
	                      |ИЗ
	                      |	Документ.ОперацияПоЯндексКассе КАК ОперацияПоЯндексКассе
	                      |ГДЕ
	                      |	ОперацияПоЯндексКассе.Ссылка = &Ссылка
	                      |	И ОперацияПоЯндексКассе.СуммаНДС7 > 0
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ОперацияПоЯндексКассе.ОбъектРасчетов.Объект,
	                      |	ОперацияПоЯндексКассе.СтатьяДвиженияДенежныхСредств,
	                      |	ОперацияПоЯндексКассе.СуммаДокумента,
	                      |	ОперацияПоЯндексКассе.СуммаНДС10,
	                      |	0,
	                      |	ОперацияПоЯндексКассе.СуммаНДС10,
	                      |	0,
	                      |	0
	                      |ИЗ
	                      |	Документ.ОперацияПоЯндексКассе КАК ОперацияПоЯндексКассе
	                      |ГДЕ
	                      |	ОперацияПоЯндексКассе.Ссылка = &Ссылка
	                      |	И ОперацияПоЯндексКассе.СуммаНДС10 > 0
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ОперацияПоЯндексКассе.ОбъектРасчетов.Объект,
	                      |	ОперацияПоЯндексКассе.СтатьяДвиженияДенежныхСредств,
	                      |	ОперацияПоЯндексКассе.СуммаДокумента,
	                      |	ОперацияПоЯндексКассе.СуммаНДСОбщаяСтавка,
	                      |	ОперацияПоЯндексКассе.СуммаНДСОбщаяСтавка,
	                      |	0,
	                      |	0,
	                      |	0
	                      |ИЗ
	                      |	Документ.ОперацияПоЯндексКассе КАК ОперацияПоЯндексКассе
	                      |ГДЕ
	                      |	ОперацияПоЯндексКассе.Ссылка = &Ссылка
	                      |	И ОперацияПоЯндексКассе.СуммаНДСОбщаяСтавка > 0
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ОперацияПоЯндексКассе.ОбъектРасчетов.Объект,
	                      |	ОперацияПоЯндексКассе.СтатьяДвиженияДенежныхСредств,
	                      |	ОперацияПоЯндексКассе.СуммаДокумента,
	                      |	ОперацияПоЯндексКассе.СуммаНДСОбщаяСтавка,
	                      |	ОперацияПоЯндексКассе.СуммаНДСОбщаяСтавка,
	                      |	0,
	                      |	0,
	                      |	0
	                      |ИЗ
	                      |	Документ.ОперацияПоЯндексКассе КАК ОперацияПоЯндексКассе
	                      |ГДЕ
	                      |	ОперацияПоЯндексКассе.Ссылка = &Ссылка
	                      |	И ОперацияПоЯндексКассе.СуммаНДСОбщаяСтавка = 0
	                      |	И ОперацияПоЯндексКассе.СуммаНДС10 = 0
	                      |	И ОперацияПоЯндексКассе.СуммаНДС5 = 0
	                      |	И ОперацияПоЯндексКассе.СуммаНДС7 = 0"); 
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	ДатаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.Ссылка, "Дата");
	РасшифровкаПлатежа = Запрос.Выполнить().Выгрузить();
	РасшифровкаПлатежа.Колонки.Добавить("Договор");
	РасшифровкаПлатежа.Колонки.Добавить("Заказ"); 
	РасшифровкаПлатежа.Колонки.Добавить("СтавкаНДС"); 
	РасшифровкаПлатежа.Колонки.Добавить("ДокументРасчетов");
	РасшифровкаПлатежа.Колонки.Добавить("СпособПогашенияЗадолженности");
	Формат17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");
	Для Каждого Строка Из РасшифровкаПлатежа Цикл 
		
		Если Строка.СуммаНДСОбщаяСтавка <> 0 Тогда
			Если ДатаДокумента >= Дата(2026,1,1) Тогда
				Строка.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС",Перечисления.СтавкиНДС.НДС22);
			Иначе
				Строка.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС",Перечисления.СтавкиНДС.НДС20);
			КонецЕсли;
		ИначеЕсли Строка.СуммаНДС10 <> 0 Тогда
			Строка.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС",Перечисления.СтавкиНДС.НДС10);
		ИначеЕсли Строка.СуммаНДС7 <> 0 Тогда
			Строка.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС",Перечисления.СтавкиНДС.НДС7);
		ИначеЕсли Строка.СуммаНДС5 <> 0 Тогда
			Строка.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС",Перечисления.СтавкиНДС.НДС5);	
		Иначе
			Строка.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС",Перечисления.СтавкиНДС.БезНДС);
		КонецЕсли;
		Если НЕ Формат17ИВыше И ЭтоЛьготнаяСтавкаНДС(Строка.СтавкаНДС) Тогда
			Строка.СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка(); 
		ИначеЕсли НЕ Формат17ИВыше Тогда	
			Строка.СтавкаНДС = Строка.СтавкаНДС.ПеречислениеСтавкаНДС;
		КонецЕсли;
		ДоговорСсылка = Неопределено;
		ТипЗаказа = ТипЗнч(Строка.ЗаказСсылка);
		Если ТипЗаказа = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			ДоговорСсылка = Строка.ЗаказСсылка;
		Иначе
			Если Строка.ЗаказСсылка.Метаданные().Реквизиты.Найти("Договор") <> Неопределено Тогда
				ДоговорСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.ЗаказСсылка, "Договор");
			КонецЕсли;
			
			ВыгрузитьЗаказДокументРасчетовРасшифровкиПлатежа(Строка, Строка.ЗаказСсылка, ДанныеИБ, КомпонентыОбмена);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДоговорСсылка) Тогда
			Строка.Договор = Новый Структура("Значение, ИмяПКО", ДоговорСсылка, "Справочник_ДоговорыКонтрагентов");
			Продолжить;
		КонецЕсли;
		
		// Тип заказа может быть одним из следующих;
		//	- ДокументСсылка.ЗаказКлиента,
		//	- ДокументСсылка.РеализацияТоваровУслуг,
		//	- ДокументСсылка.АктВыполненныхРабот,
		//	- ДокументСсылка.ОтчетКомиссионера,
		//	- ДокументСсылка.ОтчетКомиссионераОСписании,
		//	- ДокументСсылка.ОтчетКомитенту,
		//	- ДокументСсылка.ОтчетПоКомиссииМеждуОрганизациями,
		//	- ДокументСсылка.ПередачаТоваровМеждуОрганизациями.
		
		Если ТипЗаказа = Тип("ДокументСсылка.ОтчетПоКомиссииМеждуОрганизациями") Тогда
			ВидДоговора = "СКомиссионером";
		ИначеЕсли ТипЗаказа = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями")
			или Строка.ЗаказСсылка.Метаданные().Реквизиты.Найти("Соглашение") = Неопределено Тогда
			ВидДоговора = "СПокупателем";
		Иначе
			
			// Соглашение может быть получено для всех вариантов операции.
			Соглашение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.ЗаказСсылка, "Соглашение");
			
			// Для продолжения анализа операции, необходимо определить вид договора.
			ВидДоговора = ВзаиморасчетыСервер.ВидДоговораКонтрагента(Строка.ЗаказСсылка, Соглашение, ДанныеИБ.ХозяйственнаяОперация);
			ВидДоговора = ?(ЗначениеЗаполнено(ВидДоговора), ВидДоговора, "СПоставщиком");
			
			Если ВидДоговора = "СКомитентом" ИЛИ ВидДоговора = "СКомиссионером" Тогда
				// Договора по комиссии выгружаются без разделения по сделкам и заказам и всегда не в у.е.
				РасчетыВУЕ = Ложь;
			Иначе
				Если ЗначениеЗаполнено(Соглашение) Тогда
					ДанныеРасчетаУЕ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Соглашение, "ВалютаВзаиморасчетов, ОплатаВВалюте, Организация");
					РасчетыВУЕ = ВедетсяРасчетВУЕ(ДанныеРасчетаУЕ.ВалютаВзаиморасчетов, ДанныеРасчетаУЕ.ОплатаВВалюте, ДанныеРасчетаУЕ.Организация, КомпонентыОбмена);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		РасчетыВУЕ = Ложь;
		
		ПараметрыПоУмолчанию = Новый Структура(ДоговорФиксированнаяСтруктураКлючей());
		ПараметрыПоУмолчанию.Организация = ДанныеИБ.Организация;
		ПараметрыПоУмолчанию.Контрагент = ДанныеИБ.Контрагент;
		ПараметрыПоУмолчанию.ВалютаВзаиморасчетов = ДанныеИБ.Валюта;
		ПараметрыПоУмолчанию.ВидДоговора = ВидДоговора;
		ПараметрыПоУмолчанию.РасчетыВУсловныхЕдиницах = РасчетыВУЕ;
		Строка.Договор = ДоговорИнструкцияКонвертацииПоДаннымВзаиморасчетов(ПараметрыПоУмолчанию, КомпонентыОбмена, Строка.ЗаказСсылка, ДанныеИБ);
		
	КонецЦикла;
	ДанныеXDTO.Вставить("РасшифровкаПлатежа", РасшифровкаПлатежа);
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
КонецПроцедуры

