Процедура ПКО_Документ_КорректировкаПоступленияТоваров_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
		"Документ_КорректировкаПоступленияТоваров_Получение", 
		"Товары", 
		"НомерГТД",
		Ложь,
		"Справочник_НомераГТД_ПолучениеЭлемента");
	КонецЕсли;
	
	ПолученныеДанные.Проведен    = Истина;
	ПолученныеДанные.Согласован  = Истина;
	ПолученныеДанные.ДатаПлатежа = ПолученныеДанные.Дата;
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	ДокументПоступленияДанные = Неопределено;
	ИмяПКО = "";
	ДанныеXDTO.Свойство("ИсправляемыйДокументПоступления", ДокументПоступленияДанные);
	Если ДокументПоступленияДанные = Неопределено Тогда
		ДанныеXDTO.Свойство("ДокументПоступления", ДокументПоступленияДанные);
	КонецЕсли;
	Если ДокументПоступленияДанные <> Неопределено И ТипЗнч(ДокументПоступленияДанные) = Тип("Структура") Тогда
		ТипЗначенияДокумент = ДокументПоступленияДанные.ТипЗначения;
		Если Найти(ТипЗначенияДокумент, "ПоступлениеТоваровУслуг") Тогда // @Non-NLS-1
			ИмяПКО = "Документ_ПоступлениеТоваровУслуг_Получение";
		КонецЕсли; 
	КонецЕсли;
	Если ИмяПКО <> "" Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДокументОснование", Новый Структура("Значение, ИмяПКО",ДокументПоступленияДанные,ИмяПКО));
	КонецЕсли;
	
	Если ДанныеXDTO.ВидОперации.Значение = "ИсправлениеОшибки" Тогда
		ПолученныеДанные.ВидКорректировки = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок;
	Иначе
		ПолученныеДанные.ВидКорректировки = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон;
	КонецЕсли;
	ПолученныеДанные.ТипКорректировки = Перечисления.ТипыКорректировки.ОбычнаяКорректировка;
	#Область Товары
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");
	ПравилаЗаполнения.Вставить("Сумма",        "Сумма");
	ПравилаЗаполнения.Вставить("Цена",         "Цена");
	ПравилаЗаполнения.Вставить("СтавкаНДС",    "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС",     "СуммаНДС");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		ПравилаЗаполнения.Вставить("КоличествоРНПТ", "КоличествоПоРНПТ");
	КонецЕсли;
	ВерсияФормата17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");
	МассивСтрокТовары = Новый Массив;
	Если ДанныеXDTO.Свойство("Товары")
		И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда
	
		Для Каждого Строка Из ДанныеXDTO.Товары Цикл
			Если Не ЗначениеЗаполнено(Строка.Количество) Или Строка.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
	
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("Количество") И СтруктураДанныхСтроки.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
	
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
	
			Если ЗначениеЗаполнено(Строка.НомерГТД) Тогда
				Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
					СтруктураДанныхСтроки.Вставить("НомерГТД", Строка.НомерГТД);
				Иначе
					СтруктураДанныхСтроки.Вставить("НомерГТД", Новый Структура("НомерГТД, СтранаПроисхождения", Строка.НомерГТД, Строка.СтранаПроисхождения));
				КонецЕсли;
			КонецЕсли;
	
			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС;
			КонецЕсли;
	
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
			ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации,ВерсияФормата17ИВыше);
			СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
				СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
	
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	// Услуги добавляем в товары.
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда
	
		Для Каждого Строка Из ДанныеXDTO.Услуги Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("Количество") И СтруктураДанныхСтроки.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
			КонецЕсли;
	
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
			ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
			Если ЗначениеЗаполнено(Строка.Содержание) Тогда
				СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
				СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
			КонецЕсли;
			Если НЕ СтруктураДанныхСтроки.Свойство("Количество") ИЛИ СтруктураДанныхСтроки.Количество = Неопределено Тогда
				СтруктураДанныхСтроки.Вставить("Количество", 1); 
			КонецЕсли;	 
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокТовары.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	
	#КонецОбласти
	#Область Расхождения
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");  
	ПравилаЗаполнения.Вставить("Сумма",        "Сумма");  
	ПравилаЗаполнения.Вставить("Цена",         "Цена"); 
	
	ПравилаЗаполнения.Вставить("СтавкаНДС",    "СтавкаНДС");
	
	ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС"); 
	
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		ПравилаЗаполнения.Вставить("КоличествоРНПТ", "КоличествоПоРНПТ");
	КонецЕсли;
	МассивСтрокРасхождение = Новый Массив;
	Если ДанныеXDTO.Свойство("Товары")
		И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда 
		Для Каждого Строка Из ДанныеXDTO.Товары Цикл
			Если Не ЗначениеЗаполнено(Строка.Количество) И Не ЗначениеЗаполнено(Строка.КоличествоДоИзменения) Тогда
				Продолжить;
			КонецЕсли;  	
			Если Не ЗначениеЗаполнено(Строка.Количество) Тогда
				Строка.Количество = 0;
			КонецЕсли;  
	
			Если Не ЗначениеЗаполнено(Строка.Сумма) Тогда
				Строка.Сумма = 0;
			КонецЕсли;  
	
			Если ВерсияФормата17ИВыше И НЕ Строка.СтавкаНДС.Свойство("Ставка") Тогда
				Строка.СтавкаНДС.Вставить("Ставка", "0");
			КонецЕсли; 
			Если ВерсияФормата17ИВыше 
				И ЗначениеЗаполнено(Строка.СтавкаНДСДоИзменения) И НЕ Строка.СтавкаНДСДоИзменения.Свойство("Ставка") Тогда
				Строка.СтавкаНДСДоИзменения.Вставить("Ставка", "0");
			КонецЕсли; 
	
			Если НЕ Строка.ЕстьВДокументеПоступленияРеализации 
				ИЛИ ЗначениеЗаполнено(Строка.СтавкаНДСДоИзменения) И (Не ВерсияФормата17ИВыше И Строка.СтавкаНДС.Значение <> Строка.СтавкаНДСДоИзменения.Значение
				ИЛИ ВерсияФормата17ИВыше И Строка.СтавкаНДС.Ставка <> Строка.СтавкаНДСДоИзменения.Ставка)
				Или НЕ ((Строка.НомерГТД = Неопределено И Строка.НомерГТДДоИзменения = Неопределено)
				Или (ТипЗнч(Строка.НомерГТД) = Тип("Структура") И ТипЗнч(Строка.НомерГТДДоИзменения) = Тип("Структура")
				И (Строка.НомерГТД.Свойство("Ссылка") И Строка.НомерГТД.Ссылка.Значение = Строка.НомерГТДДоИзменения.Ссылка.Значение)))
				Или НЕ ((Строка.СтранаПроисхождения = Неопределено И Строка.СтранаПроисхожденияДоИзменения = Неопределено)
				Или (ТипЗнч(Строка.СтранаПроисхождения) = Тип("Структура") И ТипЗнч(Строка.СтранаПроисхождения) = Тип("Структура")
				И (Не Строка.СтранаПроисхожденияДоИзменения = Неопределено И Строка.СтранаПроисхождения.Ссылка.Значение = Строка.СтранаПроисхожденияДоИзменения.Ссылка.Значение )))
				Тогда
				// Две строки старая минусом новая плюсом.
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Если ЗначениеЗаполнено(Строка.НомерГТД) Тогда
					Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
						СтруктураДанныхСтроки.Вставить("НомерГТД", Строка.НомерГТД);
					Иначе
						СтруктураДанныхСтроки.Вставить("НомерГТД", Новый Структура("НомерГТД, СтранаПроисхождения", Строка.НомерГТД, Строка.СтранаПроисхождения));
					КонецЕсли;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
					СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
				КонецЕсли;
				СуммаСНДС = Строка.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС;
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации,ВерсияФормата17ИВыше);
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
				Если НЕ СтруктураДанныхСтроки.Количество = 0 Тогда
					МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
				КонецЕсли;
	
				Если НЕ Строка.ЕстьВДокументеПоступленияРеализации Тогда
					Продолжить;
				КонецЕсли;
				// Данные до изменения отразить минусом.
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				СтруктураДанныхСтроки.Количество = (-1) * Строка.КоличествоДоИзменения;
				Если Не СтруктураДанныхСтроки.Свойство("Сумма") Тогда
					СтруктураДанныхСтроки.Вставить("Сумма");
				КонецЕсли;
				СтруктураДанныхСтроки.Сумма = (-1) * Строка.СуммаДоИзменения;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И ЗначениеЗаполнено(Строка.СуммаНДСДоИзменения) Тогда
					СтруктураДанныхСтроки.СуммаНДС = (-1) * Строка.СуммаНДСДоИзменения;
				КонецЕсли;
				СтруктураДанныхСтроки.СтавкаНДС = Строка.СтавкаНДСДоИзменения; 
				Если Не СтруктураДанныхСтроки.Свойство("Цена") Тогда
					СтруктураДанныхСтроки.Вставить("Цена");
				КонецЕсли;
				СтруктураДанныхСтроки.Цена = Строка.ЦенаДоИзменения; 
				Если СтруктураДанныхСтроки.Свойство("КоличествоПоРНПТ") Тогда
					СтруктураДанныхСтроки.КоличествоПоРНПТ = (-1) * Строка.КоличествоРНПТДоИзменения;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
					СтруктураДанныхСтроки.КоличествоУпаковок = (-1) * Строка.КоличествоУпаковокДоИзменения;
				КонецЕсли;
				Если ЗначениеЗаполнено(Строка.НомерГТД) Тогда
					Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
						СтруктураДанныхСтроки.Вставить("НомерГТД", Строка.НомерГТДДоИзменения);
					Иначе
						СтруктураДанныхСтроки.Вставить("НомерГТД", Новый Структура("НомерГТД, СтранаПроисхождения", Строка.НомерГТДДоИзменения, Строка.СтранаПроисхожденияДоИзменения));
					КонецЕсли;
				КонецЕсли;
				СуммаСНДС = Строка.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС - СтруктураДанныхСтроки.СуммаНДС;
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
	
			ИначеЕсли Строка.Количество <> Строка.КоличествоДоИзменения Или Строка.Сумма <> Строка.СуммаДоИзменения Или Строка.СуммаНДС <> Строка.СуммаНДСДоИзменения Тогда
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения); 
	
				СтруктураДанныхСтроки.Количество = ?(ЗначениеЗаполнено(Строка.Количество), 
				Строка.Количество - Строка.КоличествоДоИзменения, (-1) * Строка.КоличествоДоИзменения);
				СтруктураДанныхСтроки.Сумма = ?(ЗначениеЗаполнено(Строка.Сумма), 
				Строка.Сумма - Строка.СуммаДоИзменения, (-1) * Строка.СуммаДоИзменения);
	
				СуммаНДСДоИзменения = ?(ЗначениеЗаполнено(Строка.СуммаНДСДоИзменения),Строка.СуммаНДСДоИзменения, 0); 
				СуммаНДС = ?(ЗначениеЗаполнено(Строка.СуммаНДС), Строка.СуммаНДС - СуммаНДСДоИзменения, (-1) * СуммаНДСДоИзменения);
	
				СтруктураДанныхСтроки.Вставить("СуммаНДС", СуммаНДС);
	
				Если НЕ СтруктураДанныхСтроки.Свойство("Цена") Тогда
				     СтруктураДанныхСтроки.Вставить("Цена");
				КонецЕсли;
				СтруктураДанныхСтроки.Цена = ?(НЕ Строка.Цена = Неопределено, Строка.Цена, 0) - ?(НЕ Строка.ЦенаДоИзменения = Неопределено, Строка.ЦенаДоИзменения, 0); 
				Если СтруктураДанныхСтроки.Свойство("КоличествоПоРНПТ") Тогда
					СтруктураДанныхСтроки.КоличествоПоРНПТ = ?(ЗначениеЗаполнено(СтруктураДанныхСтроки.КоличествоПоРНПТ), 
					СтруктураДанныхСтроки.КоличествоПоРНПТ- Строка.КоличествоРНПТДоИзменения, (-1) * Строка.КоличествоРНПТДоИзменения);
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
					СтруктураДанныхСтроки.КоличествоУпаковок = ?(ЗначениеЗаполнено(СтруктураДанныхСтроки.КоличествоУпаковок), 
					СтруктураДанныхСтроки.КоличествоУпаковок - Строка.КоличествоУпаковокДоИзменения, (-1) * Строка.КоличествоУпаковокДоИзменения);
				КонецЕсли;
				Если ЗначениеЗаполнено(Строка.НомерГТД) Тогда
					Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
						СтруктураДанныхСтроки.Вставить("НомерГТД", Строка.НомерГТД);
					Иначе
						СтруктураДанныхСтроки.Вставить("НомерГТД", Новый Структура("НомерГТД, СтранаПроисхождения", Строка.НомерГТД, Строка.СтранаПроисхождения));
					КонецЕсли;
				КонецЕсли;
				СуммаСНДС = СтруктураДанныхСтроки.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС;
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				//СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", СтруктураДанныхСтроки.СуммаСНДС);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
	
			Иначе
				// Нет изменений - пропускаем.
				Продолжить;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда
		Для Каждого Строка Из ДанныеXDTO.Услуги Цикл
			Если ВерсияФормата17ИВыше И НЕ Строка.СтавкаНДС.Свойство("Ставка") Тогда
				Строка.СтавкаНДС.Вставить("Ставка", "0");
			КонецЕсли; 
			Если ВерсияФормата17ИВыше 
				И ЗначениеЗаполнено(Строка.СтавкаНДСДоИзменения) И НЕ Строка.СтавкаНДСДоИзменения.Свойство("Ставка") Тогда
				Строка.СтавкаНДСДоИзменения.Вставить("Ставка", "0");
			КонецЕсли; 
			Если Не ЗначениеЗаполнено(Строка.Количество) Тогда
				Строка.Количество = 1;
			КонецЕсли;
	
			Если Не ЗначениеЗаполнено(Строка.КоличествоДоИзменения) Тогда
				Строка.КоличествоДоИзменения = 0;
			КонецЕсли;
	
			Если НЕ Строка.ЕстьВДокументеПоступленияРеализации
				Или ЗначениеЗаполнено(Строка.СтавкаНДСДоИзменения) И (Не ВерсияФормата17ИВыше И Строка.СтавкаНДС.Значение <> Строка.СтавкаНДСДоИзменения.Значение
				Или ВерсияФормата17ИВыше И Строка.СтавкаНДС.Ставка <> Строка.СтавкаНДСДоИзменения.Ставка)
				Или Строка.Содержание <> Строка.СодержаниеДоИзменения Тогда
				// Две строки старая минусом новая плюсом.
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Если ЗначениеЗаполнено(Строка.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
				КонецЕсли;
				СуммаСНДС = Строка.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				Если ЗначениеЗаполнено(Строка.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки); 
	
				Если НЕ Строка.ЕстьВДокументеПоступленияРеализации Тогда
					Продолжить;
				КонецЕсли;
	
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Количество =  (-1) * ?(Строка.КоличествоДоИзменения = Неопределено, 0,Строка.КоличествоДоИзменения);
				Сумма = (-1) * ?(Строка.СуммаДоИзменения = Неопределено, 0,Строка.СуммаДоИзменения);
				Цена = ?(Строка.ЦенаДоИзменения = Неопределено, 0,Строка.ЦенаДоИзменения);
				СтруктураДанныхСтроки.Вставить("Количество", Количество);
				СтруктураДанныхСтроки.Вставить("Сумма", Сумма);
				СтруктураДанныхСтроки.Вставить("Цена", Цена);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И ЗначениеЗаполнено(Строка.СуммаНДСДоИзменения) Тогда
					СтруктураДанныхСтроки.СуммаНДС = (-1) * Строка.СуммаНДСДоИзменения;
				КонецЕсли;
				СтруктураДанныхСтроки.СтавкаНДС = Строка.СтавкаНДСДоИзменения;
				СтруктураДанныхСтроки.Цена = Строка.ЦенаДоИзменения; 
				Если ЗначениеЗаполнено(Строка.СодержаниеДоИзменения) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.СодержаниеДоИзменения);
				КонецЕсли;
				СуммаСНДС = Строка.Сумма;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				Если ЗначениеЗаполнено(Строка.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
	
			ИначеЕсли Строка.Количество <> ?(ЗначениеЗаполнено(Строка.КоличествоДоИзменения), Строка.КоличествоДоИзменения, 0) Или Строка.Сумма <> Строка.СуммаДоИзменения Или Строка.СуммаНДС <> Строка.СуммаНДСДоИзменения Тогда
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Если ЗначениеЗаполнено(Строка.Количество) И ЗначениеЗаполнено(Строка.КоличествоДоИзменения) Тогда
					СтруктураДанныхСтроки.Количество = Строка.Количество - ?(НЕ Строка.КоличествоДоИзменения = Неопределено,Строка.КоличествоДоИзменения, 0);
				КонецЕсли; 
				Если СтруктураДанныхСтроки.Свойство("Сумма") Тогда 
					СуммаДоИзменения = ?(Строка.СуммаДоИзменения = Неопределено, 0, Строка.СуммаДоИзменения);
					СтруктураДанныхСтроки.Сумма = ?(ЗначениеЗаполнено(Строка.Сумма),Строка.Сумма - СуммаДоИзменения, 0);
					СуммаСНДС = Строка.Сумма;
				Иначе
					СуммаСНДС = 0;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И Строка.СуммаНДСДоИзменения <> Неопределено Тогда
					СтруктураДанныхСтроки.СуммаНДС = Строка.СуммаНДС - ?(ЗначениеЗаполнено(Строка.СуммаНДСДоИзменения), Строка.СуммаНДСДоИзменения, 0); 
				ИначеЕсли СтруктураДанныхСтроки.Свойство("СуммаНДС") тогда
					СтруктураДанныхСтроки.СуммаНДС = 0;	
				КонецЕсли;    
				Если СтруктураДанныхСтроки.Свойство("Цена") Тогда
					СтруктураДанныхСтроки.Цена = Строка.Цена - ?(ЗначениеЗаполнено(Строка.ЦенаДоИзменения),Строка.ЦенаДоИзменения, 0); 
				КонецЕсли;	
				Если ЗначениеЗаполнено(Строка.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
				КонецЕсли;
	
				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				Если ЗначениеЗаполнено(Строка.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);
	
			Иначе
				// Нет изменений - пропускаем.
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	Если МассивСтрокРасхождение.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Расхождения", МассивСтрокРасхождение);
	КонецЕсли;
	#КонецОбласти
КонецПроцедуры
Процедура ПКО_Документ_КорректировкаПоступленияТоваров_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСкладПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	Если НЕ ДанныеИБ = Неопределено Тогда
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Товары
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("СтавкаНДС");
	
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Товары,
			ДанныеИБ.Товары,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, КоличествоУпаковок, КоличествоПоРНПТ, Упаковка, Содержание, Сумма, СуммаВзаиморасчетов, СуммаНДС, СуммаНДСВзаиморасчетов, СуммаСНДС, Цена, Склад");
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
		// Расхождения
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("СтавкаНДС");
	
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Расхождения,
			ДанныеИБ.Расхождения,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, КоличествоУпаковок, КоличествоПоРНПТ, Упаковка, Содержание, Сумма, СуммаВзаиморасчетов, СуммаНДС, СуммаНДСВзаиморасчетов, СуммаСНДС, Цена, Склад");
		ДанныеИБ.Расхождения.Загрузить(ПолученныеДанные.Расхождения.Выгрузить());
		ПодразделениеПоУмолчанию = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
		Для каждого Строка Из ДанныеИБ.Товары Цикл
			Если Не ЗначениеЗаполнено(Строка.Подразделение) Тогда
				Строка.Подразделение = ПодразделениеПоУмолчанию;
			КонецЕсли;
		КонецЦикла;
		ПолученныеДанные = Неопределено;
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	ТипДокумента = "ДокументОбъект.КорректировкаПриобретения";
	ПроверитьРезультатОбменаДаннымиПоДокументу(ДанныеДляЗаписиВИБ, КомпонентыОбмена.УзелКорреспондента, ТипДокумента);
	УстановитьОтменуМеханическойЧисткиДвижений(ДанныеИБ);
КонецПроцедуры

Процедура ДобавитьПКО_Документ_КорректировкаРеализации_ЧекККМ_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_КорректировкаРеализации_ЧекККМ_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.КорректировкаРеализации;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ЧекККМ"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_КорректировкаРеализации_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_КорректировкаРеализации_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_КорректировкаРеализации_ЧекККМ";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Валюта",             "", 1);
	ДобавитьПКС(СвойстваШапки, "Дата",               "Дата");
	ДобавитьПКС(СвойстваШапки, "",                   "ЗаказКлиента", , "Документ_ЗаказКлиента_Получение");
	ДобавитьПКС(СвойстваШапки, "Контрагент",         "Контрагент", , "Справочник_Контрагенты_Получение");
	ДобавитьПКС(СвойстваШапки, "НалогообложениеНДС", "Налогообложение", , "НалогообложениеНДС");
	ДобавитьПКС(СвойстваШапки, "Организация",        "", 1);
	ДобавитьПКС(СвойстваШапки, "Склад",              "", 1);
	ДобавитьПКС(СвойстваШапки, "СуммаДокумента",     "Сумма", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "Товары", "");
	ДобавитьПКС(СвойстваТЧ, "Количество",         "", 1);
	ДобавитьПКС(СвойстваТЧ, "КоличествоУпаковок", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Номенклатура",       "", 1, "Справочник_Номенклатура_Получение");
	ДобавитьПКС(СвойстваТЧ, "Серия",              "", 1, "Справочник_СерииНоменклатуры");
	ДобавитьПКС(СвойстваТЧ, "СтавкаНДС",          "", 1);
	ДобавитьПКС(СвойстваТЧ, "Сумма",              "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаНДС",           "", 1);
	ДобавитьПКС(СвойстваТЧ, "Упаковка",           "", 1, "Справочник_Упаковки");
	ДобавитьПКС(СвойстваТЧ, "Характеристика",     "", 1, "Справочник_ХарактеристикиНоменклатуры");
	ДобавитьПКС(СвойстваТЧ, "Цена",               "", 1);

КонецПроцедуры
Процедура ПКО_Документ_КорректировкаРеализации_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ЗаполнитьНалогообложениеНДСПоПолученнымДанным(КомпонентыОбмена, ПолученныеДанные, ДанныеXDTO, Ложь);
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура",  "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",    "Количество");
	ПравилаЗаполнения.Вставить("Сумма",         "Сумма");
	ПравилаЗаполнения.Вставить("Цена",          "Цена");
	ПравилаЗаполнения.Вставить("СтавкаНДС",     "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС",      "СуммаНДС");
	ПравилаЗаполнения.Вставить("ПроцентСкидки", "ПроцентРучнойСкидки");
	ПравилаЗаполнения.Вставить("СуммаСкидки",   "СуммаРучнойСкидки");
	ПравилаЗаполнения.Вставить("ИдентификаторСтроки",   "ИдентификаторСтроки");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	
	// Товары 
	МассивСтрокТовары = Новый Массив;
	
	Если ДанныеXDTO.Свойство("ТоварыПродажа")
		И ЗначениеЗаполнено(ДанныеXDTO.ТоварыПродажа) Тогда
		
		Для Каждого Строка Из ДанныеXDTO.ТоварыПродажа Цикл
		
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
			Если СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
			    Если СтруктураДанныхСтроки.Свойство("Упаковка") И СтруктураДанныхСтроки.Свойство("Сумма") Тогда
					СтруктураДанныхСтроки.Вставить("Цена", СтруктураДанныхСтроки.Сумма / СтруктураДанныхСтроки.КоличествоУпаковок);
				КонецЕсли;
			Иначе
				СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли;
			Если ДанныеXDTO.Свойство("Склад") Тогда
				СтруктураДанныхСтроки.Вставить("Склад", ДанныеXDTO.Склад);
			КонецЕсли;
			
			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
			
			// СкидкиНаценки загружаются в ТЧ Товары 
			Если ДанныеXDTO.Свойство("СкидкиНаценки")
				И ЗначениеЗаполнено(ДанныеXDTO.СкидкиНаценки) Тогда
				НайденныеСкидки = ДанныеXDTO.СкидкиНаценки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки));
				Если НайденныеСкидки.Количество() > 0 Тогда
					СтрокаСкидкаНаценка = НайденныеСкидки[0];
					СтруктураДанныхСтроки.Вставить("СуммаРучнойСкидки", СтрокаСкидкаНаценка.СуммаСкидки);
					СтруктураДанныхСтроки.Вставить("ПроцентРучнойСкидки", СтрокаСкидкаНаценка.ПроцентСкидки);
				КонецЕсли;
			КонецЕсли;
		
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Услуги загружаются в ТЧ Товары 
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда
	
		Для Каждого Строка Из ДанныеXDTO.Услуги Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			
			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
			КонецЕсли;		
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
	
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
	КонецЕсли;
	
	Если МассивСтрокТовары.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	
	ЗаказКлиента = СсылкаНаДокументРасчетовИзДанныхXDTO(КомпонентыОбмена, ДанныеXDTO.ЗаказКлиента);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента
	|	";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ПолученныеДанные.ДокументОснование = Выборка.Ссылка;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_КорректировкаРеализации_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСкладПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	Если НЕ ДанныеИБ = Неопределено Тогда
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Товары
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("СтавкаНДС");
	
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Товары,
			ДанныеИБ.Товары,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, КоличествоУпаковок, Упаковка, Содержание, Сумма, СуммаНДС, СуммаСНДС, Цена, Склад");
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
		ПолученныеДанные = Неопределено;
	КонецЕсли;
КонецПроцедуры

