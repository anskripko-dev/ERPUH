	ПравилоКонвертации.ОбъектФормата     = "Документ.ВозвратМатериаловИзПроизводства"; //@NON-NLS-1
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_ПеремещениеТоваров_ВозврИзПроизв_Отправка_ПриОтправкеДанных";
	СвойстваШапки = ПравилоКонвертации.Свойства;
