	ДобавитьПКС(СвойстваТЧ, "Договор",    "", 1, "Справочник_ДоговорыКредитов_ИзСтруктуры");
	ДобавитьПКС(СвойстваТЧ, "Контрагент", "", 1, "Справочник_Контрагенты_Получение");
