	МассивТиповОтменаПроведения.Добавить(ТИП("ДокументОбъект.ОтчетКомиссионера"));
	МассивТиповОтменаПроведения.Добавить(ТИП("ДокументОбъект.ОтчетКомитенту"));
	МассивТиповОтменаПроведения.Добавить(ТИП("ДокументОбъект.ОтчетОРозничныхПродажах"));
