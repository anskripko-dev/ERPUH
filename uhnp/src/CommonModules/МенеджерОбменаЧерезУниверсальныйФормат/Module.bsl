Процедура ПКО_Справочник_ФизическиеЛица_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
	
	ЗагрузитьКонтактнуюИнформацию(ДанныеXDTO, ПолученныеДанные, Справочники.ВидыКонтактнойИнформации.СправочникФизическиеЛица);
	
	Если СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.ФизическиеЛица.ДанныеФИО") Тогда //@NON-NLS-1
		Если ДанныеXDTO.Свойство("ДанныеФИО") И ДанныеXDTO.ДанныеФИО.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПодробныеДанныеФИО", ДанныеXDTO.ДанныеФИО);
		КонецЕсли;
	КонецЕсли;
	//++ НЕ УТ
	Если СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.ФизическиеЛица.КлючевыеСвойства.Имя")
		И СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.ФизическиеЛица.КлючевыеСвойства.Фамилия")
		И СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.ФизическиеЛица.КлючевыеСвойства.Отчество") Тогда //@NON-NLS-1 @NON-NLS-2 @NON-NLS-3
		КлючевыеСвойства = ДанныеXDTO;
		Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
			КлючевыеСвойства = ДанныеXDTO.КлючевыеСвойства;
		КонецЕсли;
		
		Если КлючевыеСвойства.Свойство("Имя") Тогда
			ПолученныеДанные.Имя = КлючевыеСвойства.Имя;
		КонецЕсли;
		Если КлючевыеСвойства.Свойство("Фамилия") Тогда
			ПолученныеДанные.Фамилия = КлючевыеСвойства.Фамилия;
		КонецЕсли;
		Если КлючевыеСвойства.Свойство("Отчество") Тогда
			ПолученныеДанные.Отчество = КлючевыеСвойства.Отчество;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("МестоРождения") Тогда
		ПолученныеДанные.МестоРождения = ДанныеXDTO.МестоРождения;
	КонецЕсли;
	//++ Локализация
	Если ДанныеXDTO.Свойство("СтраховойНомерПФР") Тогда
		ПолученныеДанные.СтраховойНомерПФР = ДанныеXDTO.СтраховойНомерПФР;
	КонецЕсли;
	//-- Локализация
	Если ДанныеXDTO.Свойство("УточнениеНаименования") Тогда
		ПолученныеДанные.УточнениеНаименования = ДанныеXDTO.УточнениеНаименования;
	КонецЕсли;
	Если ДанныеXDTO.Свойство("ДатаРегистрации") Тогда
		ПолученныеДанные.ДатаРегистрации = ДанныеXDTO.ДатаРегистрации;
	КонецЕсли;
	//-- НЕ УТ
КонецПроцедуры
Процедура ПКО_Справочник_ФизическиеЛица_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	//++ НЕ УТ
	ПолученныеДанные.ФИО = ПолученныеДанные.Наименование;
	Если ДанныеИБ <> Неопределено Тогда
		// Явно перезаполняются свойства, которых нет в ПКС (т.к. эти свойства отсутствуют в УТ).
		СтрокаРеквизиты = "МестоРождения, УточнениеНаименования, ФИО, ДатаРегистрации";
		//++ Локализация
		СтрокаРеквизиты = СтрокаРеквизиты + ", СтраховойНомерПФР";
		//-- Локализация
		ЗаполнитьРеквизиты(ДанныеИБ, ПолученныеДанные, СтрокаРеквизиты, Истина);
	КонецЕсли;
	//-- НЕ УТ
	ФизЛицоСсылка = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	ЗагрузитьДополнительныеСведения(ФизЛицоСсылка, ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	Если ЗначениеЗаполнено(ФизЛицоСсылка) И НЕ ФизЛицоСсылка.ЭтоГруппа Тогда
	     ЗагрузитьПодробныеДанныеФИО(КомпонентыОбмена, ПолученныеДанные, ФизЛицоСсылка);
	ИначеЕсли ЗначениеЗаполнено(ФизЛицоСсылка) И ФизЛицоСсылка.ЭтоГруппа Тогда
		 ПолученныеДанные = Неопределено;
	КонецЕсли;
КонецПроцедуры

