	МассивТиповОтменаПроведения.Добавить(ТИП("ДокументОбъект.ЗаказПоставщику"));
	МассивТиповОтменаПроведения.Добавить(ТИП("ДокументОбъект.КорректировкаЗадолженности"));
	МассивТиповОтменаПроведения.Добавить(ТИП("ДокументОбъект.КорректировкаРеализации"));
