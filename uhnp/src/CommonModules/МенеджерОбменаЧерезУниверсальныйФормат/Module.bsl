Процедура ОтложеннаяОбработка_ОстаткиТоваровПереданНаКомис(Объект, ОбъектМодифицирован)
	Документ_ОстаткиТМЦ_ОтложеннаяОбработкаПартнеров(Объект, ОбъектМодифицирован);
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	ЗаполнитьВидДеятельностиПоУмолчанию(Объект, "ВидДеятельностиНДС");
	
	Если ЗначениеЗаполнено(Объект.Партнер)
		И ЗначениеЗаполнено(Объект.СоглашениеСКомиссионером)
		И НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СоглашениеСКомиссионером, "Партнер")) Тогда
		
		СоглашениеОбъект = Объект.СоглашениеСКомиссионером.ПолучитьОбъект(); // СправочникОбъект.СоглашенияСКлиентами
		СоглашениеОбъект.Партнер = Объект.Партнер;
		ОбменДаннымиСервер.УстановитьОбменДаннымиЗагрузка(СоглашениеОбъект, Истина);
		
		СоглашениеОбъект.Записать();
	КонецЕсли;
КонецПроцедуры
