Процедура ДобавитьПОД_Справочник_НоменклатураПоставщиков_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_НоменклатураПоставщиков_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Справочники.НоменклатураКонтрагентов;
	ПравилоОбработки.ПриОбработке            = "ПОД_Справочник_НоменклатураПоставщиков_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
