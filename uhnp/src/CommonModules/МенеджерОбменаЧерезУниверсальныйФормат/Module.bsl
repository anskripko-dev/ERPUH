	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.СчетФактураКомитента;
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_СчетФактураКомитента_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_СчетФактураКомитента_Отправка");
КонецПроцедуры
Процедура ПОД_Документ_СчетФактураКомитента_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	// Сведения о счетах фактурах выставленных
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СчетФактураКомитентаПокупатели.Субкомиссионер КАК СубкомиссионерСсылка,
	|	СчетФактураКомитентаПокупатели.Покупатель КАК Покупатель,
	|	СчетФактураКомитентаПокупатели.СчетФактураВыданный КАК СчетФактураВыданный,
	|	СчетФактураКомитентаПокупатели.СуммаСНДС КАК Сумма,
	|	СчетФактураКомитентаПокупатели.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.СчетФактураКомитента.Покупатели КАК СчетФактураКомитентаПокупатели
	|ГДЕ
	|	СчетФактураКомитентаПокупатели.Ссылка = &Ссылка
	|	И НЕ СчетФактураКомитентаПокупатели.СчетФактураВыданный В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Документ.СчетФактураВыданныйАванс.ПустаяСсылка), ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка), ЗНАЧЕНИЕ(Документ.СчетФактураКомиссионеру.ПустаяСсылка))
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	СчетаФактурыВыданные = Запрос.Выполнить().Выгрузить();
	Если СчетаФактурыВыданные.Количество() = 0 тогда
	     ОчиститьИспользованиеПКО(ИспользованиеПКО);
	Иначе
		СчетаФактурыВыданные.Колонки.Добавить("Субкомиссионер");
		Для Каждого СтрокаСФ Из СчетаФактурыВыданные Цикл
			Если ЗначениеЗаполнено(СтрокаСФ.СубкомиссионерСсылка) Тогда
				Если ТипЗнч(СтрокаСФ.СубкомиссионерСсылка) = Тип("СправочникСсылка.Контрагенты") Тогда
					СтрокаСФ.Субкомиссионер = СтрокаСФ.СубкомиссионерСсылка;
				ИначеЕсли ТипЗнч(СтрокаСФ.СубкомиссионерСсылка) = Тип("СправочникСсылка.Организации") Тогда
					СтрокаСФ.Субкомиссионер = КонтрагентИзОрганизации(СтрокаСФ.СубкомиссионерСсылка, КомпонентыОбмена);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; 
		ДанныеИБ.ДополнительныеСвойства.Вставить("СчетаФактурыВыданные", СчетаФактурыВыданные);
	КонецЕсли;
КонецПроцедуры

