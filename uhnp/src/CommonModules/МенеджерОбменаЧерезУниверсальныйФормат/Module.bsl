Процедура ПКО_Справочник_ОсновныеСредства_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Если НЕ ЗначениеЗаполнено(ДанныеИБ.ИнвентарныйНомер) Тогда
			ДанныеXDTO.Вставить("ИнвентарныйНомер", ДанныеИБ.Код);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеИБ.ИнвентарныйНомер) Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("ИнвентарныйНомер", ДанныеИБ.Код);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.КодПоОКОФ)
		И ОбщегоНазначения.СсылкаСуществует(ДанныеИБ.КодПоОКОФ) Тогда
		ДанныеXDTO.Вставить("КодПоОКОФ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.КодПоОКОФ, "Код"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ШифрПоЕНАОФ)
		И ОбщегоНазначения.СсылкаСуществует(ДанныеИБ.ШифрПоЕНАОФ) Тогда
		ДанныеXDTO.Вставить("ШифрПоЕНАОФ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ШифрПоЕНАОФ, "Код"));
	КонецЕсли;	
	
	Для Каждого ЭлементСтруктуры Из ДанныеИБ.ДополнительныеСвойства Цикл
		Если ЭлементСтруктуры.Ключ = "СобытиеПринятияКУчету" ИЛИ ЭлементСтруктуры.Ключ = "СобытиеМодернизации" Тогда
			ДанныеСобытия = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементСтруктуры.Значение, "Наименование, ВидСобытияОС");
			ДанныеXDTO.Вставить(ЭлементСтруктуры.Ключ, ДанныеСобытия);
		ИначеЕсли ЭлементСтруктуры.Ключ = "ГрафикАмортизацииБУ" Тогда
			ДанныеГрафик = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементСтруктуры.Значение,
				"Наименование, Коэффициент1, Коэффициент2, Коэффициент3, Коэффициент4, Коэффициент5, Коэффициент6,
				|Коэффициент7, Коэффициент8, Коэффициент9, Коэффициент10, Коэффициент11, Коэффициент12");
			ДанныеXDTO.Вставить(ЭлементСтруктуры.Ключ, ДанныеГрафик);
		ИначеЕсли ЭлементСтруктуры.Ключ = "ВЭксплуатации"
			И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.7") Тогда
			ДанныеXDTO.Вставить("ВЭксплутации", ЭлементСтруктуры.Значение);	
		Иначе
			ДанныеXDTO.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина);
КонецПроцедуры
Процедура ПКО_Справочник_ОсновныеСредства_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Код = ДанныеXDTO.КлючевыеСвойства.ИнвентарныйНомер;
	
	Если ДанныеXDTO.Свойство("КодПоОКОФ") Тогда
		СтруктураКодПоОКОФ = Новый Структура;
		СтруктураКодПоОКОФ.Вставить("Код", ДанныеXDTO.КодПоОКОФ);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КодПоОКОФ", СтруктураКодПоОКОФ);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ШифрПоЕНАОФ") Тогда
		СтруктураШифрПоЕНАОФ = Новый Структура;
		СтруктураШифрПоЕНАОФ.Вставить("Код", ДанныеXDTO.ШифрПоЕНАОФ);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ШифрПоЕНАОФ", СтруктураШифрПоЕНАОФ);
	КонецЕсли;
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Справочник_ОсновныеСредства_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КодПоОКОФ") Тогда	
		КодПоОКОФ = ПолученныеДанные.ДополнительныеСвойства.КодПоОКОФ;
		ПолученныеДанные.КодПоОКОФ = Справочники.ОбщероссийскийКлассификаторОсновныхФондов.НайтиПоКоду(КодПоОКОФ.Код);
	КонецЕсли;
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
								ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
КонецПроцедуры

