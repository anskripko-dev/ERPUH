Процедура ПОД_Справочник_ДоговорыМеждуОрганизациями_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	ПравилоДоговорыИзСтруктуры = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Справочник_ДоговорыМеждуОрганизациями", "Имя");
	
	Если ПравилоДоговорыИзСтруктуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если КомпонентыОбмена.ЭтоОбменЧерезПланОбмена Тогда
		УзелСписокОрганизаций = КомпонентыОбмена.ПараметрыКонвертации.Организации;
	Иначе
		УзелСписокОрганизаций = Новый СписокЗначений();
	КонецЕсли;
		
	Если ТипЗнч(ДанныеИБ) <> Тип("Структура") Тогда
		
		Если УзелСписокОрганизаций.НайтиПоЗначению(ДанныеИБ.Организация) = Неопределено Тогда
			ОчиститьИспользованиеПКО(ИспользованиеПКО);
		КонецЕсли;
		
		Если УзелСписокОрганизаций.НайтиПоЗначению(ДанныеИБ.ОрганизацияПолучатель) <> Неопределено Тогда
			ДанныеДоговора = ДанныеДоговораМеждуОрганизациями(КомпонентыОбмена, ДанныеИБ);
			ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ДанныеДоговора, ПравилоДоговорыИзСтруктуры);
		КонецЕсли;
		
	Иначе
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
		ИспользованиеПКО.Вставить("Справочник_ДоговорыКонтрагентов_ИзСтруктуры", Истина);
	КонецЕсли;
КонецПроцедуры

