Процедура ПодобратьДоговорЗаймаСотруднику(Объект, КомпонентыОбмена)
	// Заполним "ДоговорЗаймаСотруднику" при необходимости.
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ДоговорЗаймаСотруднику", Документы.ДоговорЗаймаСотруднику.ПустаяСсылка());
	СтрокиСНезаполненнымДоговором = Объект.РасшифровкаПлатежа.НайтиСтроки(СтруктураОтбора);
	Если СтрокиСНезаполненнымДоговором.Количество() > 0 Тогда
		ТекстЗапроса = 
				"ВЫБРАТЬ ПЕРВЫЕ 2
				|	ВзаиморасчетыПоЗаймамСотрудникамОстатки.ДоговорЗайма КАК ДоговорЗайма
				|ИЗ
				|	РегистрНакопления.ВзаиморасчетыПоЗаймамСотрудникам.Остатки(
				|			&Период,
				|			ФизическоеЛицо = &ФизическоеЛицо
				|				И Организация = &Организация) КАК ВзаиморасчетыПоЗаймамСотрудникамОстатки
				|ГДЕ
				|	ВзаиморасчетыПоЗаймамСотрудникамОстатки.СуммаЗаймаОстаток > 0
				|
				|СГРУППИРОВАТЬ ПО
				|	ВзаиморасчетыПоЗаймамСотрудникамОстатки.ДоговорЗайма
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ ПЕРВЫЕ 2
				|	ДоговорЗаймаСотруднику.Ссылка КАК ДоговорЗайма
				|ИЗ
				|	Документ.ДоговорЗаймаСотруднику КАК ДоговорЗаймаСотруднику
				|ГДЕ
				|	ДоговорЗаймаСотруднику.Проведен
				|	И ДоговорЗаймаСотруднику.Дата <= &Период
				|	И ДоговорЗаймаСотруднику.Организация = &Организация
				|	И ДоговорЗаймаСотруднику.ФизическоеЛицо = &ФизическоеЛицо";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Период", Объект.Дата);
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("ФизическоеЛицо", Объект.ПодотчетноеЛицо);
		
		РезультатПакета = Запрос.ВыполнитьПакет();
		
		Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПогашениеЗаймаСотрудником Тогда
			Если РезультатПакета[0].Пустой() Тогда
				Выборка = РезультатПакета[1].Выбрать();
			Иначе
				Выборка = РезультатПакета[0].Выбрать();
			КонецЕсли;
		ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаЗаймаСотруднику Тогда
			Выборка = РезультатПакета[1].Выбрать();
		КонецЕсли;
		
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			Для Каждого СтрокаРасшифровки Из СтрокиСНезаполненнымДоговором Цикл
				СтрокаРасшифровки.ДоговорЗаймаСотруднику = Выборка.ДоговорЗайма;
			КонецЦикла
		КонецЕсли;
	КонецЕсли;
	
	// Заполним "ТипСуммыКредитаДепозита" при необходимости.
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПогашениеЗаймаСотрудником Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ТипСуммыКредитаДепозита", Перечисления.ТипыСуммГрафикаКредитовИДепозитов.ПустаяСсылка());
		СтрокиСНезаполненнымТипомСуммы = Объект.РасшифровкаПлатежа.НайтиСтроки(СтруктураОтбора);
		Если СтрокиСНезаполненнымТипомСуммы.Количество() > 0 Тогда
			Для Каждого СтрокаРасшифровки Из СтрокиСНезаполненнымДоговором Цикл
				СтрокаРасшифровки.ТипСуммыКредитаДепозита = Перечисления.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
