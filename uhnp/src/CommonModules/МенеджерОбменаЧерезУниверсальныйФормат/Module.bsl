Процедура ПКО_Документ_РезервыПоОплатеТруда_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	Если ДанныеXDTO.Свойство("ВидОперации") И Не ПустаяСтрока(ДанныеXDTO.ВидОперации) Тогда
		ПолученныеДанные.ВидОперации =  Перечисления.ВидыОперацийРезервовПоОплатеТруда[ДанныеXDTO.ВидОперации];
	КонецЕсли;
	ОбязательстваОтраженыВБухучете = Ложь;
	
	Если ДанныеXDTO.Свойство("ОбязательстваОтраженыВРеглхучете") Тогда
	
		ОбязательстваОтраженыВБухучете = ДанныеXDTO.ОбязательстваОтраженыВРеглхучете;
	
	ИначеЕсли ДанныеXDTO.Свойство("ОбязательстваОтраженыВРеглхучете") Тогда
	
		ОбязательстваОтраженыВБухучете = ДанныеXDTO.ОбязательстваОтраженыВРеглУчете;
	
	КонецЕсли;
	
	ПолученныеДанные.ОбязательстваОтраженыВБухучете = ОбязательстваОтраженыВБухучете; 
	
	Если ДанныеXDTO.Свойство("ОценочныеОбязательства") Тогда
	
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ПодразделениеРеглУчета", "Подразделение");
		ПравилаЗаполнения.Вставить("Подразделение", "МестоВСтруктуреПредприятия");
		ПравилаЗаполнения.Вставить("СпособОтраженияЗарплатыВФинансовомУчете", "СпособОтраженияЗарплатыВБухучете");
		ПравилаЗаполнения.Вставить("СуммаРезерва", "СуммаРезерва");
		ПравилаЗаполнения.Вставить("СуммаРезерваНУ", "СуммаРезерваНУ");
		ПравилаЗаполнения.Вставить("СуммаРезерваСтраховыхВзносов", "СуммаРезерваСтраховыхВзносов");
		ПравилаЗаполнения.Вставить("СуммаРезерваСтраховыхВзносовНУ", "СуммаРезерваСтраховыхВзносовНУ");
		ПравилаЗаполнения.Вставить("СуммаРезерваФССНесчастныеСлучаи", "СуммаРезерваФССНесчастныеСлучаи");
		ПравилаЗаполнения.Вставить("СуммаРезерваФССНесчастныеСлучаиНУ", "СуммаРезерваФССНесчастныеСлучаиНУ");
		
		ОценочныеОбязательства = Новый Массив;
		
		Для Каждого Строка Из ДанныеXDTO.ОценочныеОбязательства Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
	        ОценочныеОбязательства.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ОценочныеОбязательства", ОценочныеОбязательства);
	
	КонецЕсли;
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
КонецПроцедуры
Процедура ПКО_Документ_РезервыПоОплатеТруда_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
	                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если Не ДанныеДляЗаписиВИБ = Неопределено И ОбщегоНазначения.СсылкаСуществует(ДанныеДляЗаписиВИБ.Резерв) Тогда
		СтруктураАналитики = РезервыПоОплатеТрудаУП.СтатьиДоходовИРасходовПоУмолчанию(ДанныеДляЗаписиВИБ.Организация, ДанныеДляЗаписиВИБ.ВидОперации, ДанныеДляЗаписиВИБ.Резерв);
		ЗаполнитьЗначенияСвойств(ДанныеДляЗаписиВИБ, СтруктураАналитики);
	КонецЕсли;
	
	ТипДокумента = "ДокументОбъект.РезервыПоОплатеТруда";
