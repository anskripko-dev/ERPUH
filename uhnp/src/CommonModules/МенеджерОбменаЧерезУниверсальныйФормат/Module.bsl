Процедура ПроверитьРезультатОбменаДаннымиПоДокументу(ДанныеДляЗаписиВИБ, УзелКорреспондента, ТипДокумента)
	Если НЕ ДанныеДляЗаписиВИБ = Неопределено И (ОбщегоНазначения.СсылкаСуществует(ДанныеДляЗаписиВИБ.Ссылка) ИЛИ 
			ТИПЗнч(ДанныеДляЗаписиВИБ) = ТИП(ТипДокумента))Тогда 
		ОбъектДоступенПоФО = ОбщегоНазначения.ОбъектМетаданныхДоступенПоФункциональнымОпциям(ДанныеДляЗаписиВИБ.Метаданные());
		Если Не ОбъектДоступенПоФО Тогда
			ТекстСообщения = "";
			ПроверитьСостояниеФункциональныхОпцийПоДокументам(ДанныеДляЗаписиВИБ.Метаданные().Синоним, ТекстСообщения);
			Если Не ПустаяСтрока(ТекстСообщения) Тогда
			    Если ТипЗнч(ДанныеДляЗаписиВИБ) = Тип("Структура") Тогда
					Возврат;
				КонецЕсли;
				ТипПроблемы = Перечисления.ТипыПроблемОбменаДанными.ОшибкаВыполненияКодаОбработчиковПриПолученииДанных;
							
				Если ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(ДанныеДляЗаписиВИБ.Метаданные()) Тогда
					РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(
						ДанныеДляЗаписиВИБ.Ссылка,
						УзелКорреспондента,
						ТекстСообщения,
						ТипПроблемы);
				Иначе
					РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(
						ДанныеДляЗаписиВИБ,
						УзелКорреспондента,
						ТекстСообщения,
						ТипПроблемы);
				КонецЕсли;
			КонецЕсли;  
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПроверитьСостояниеФункциональныхОпцийПоДокументам(МетаданныеИмя, ТекстСообщения)
	ФункциональныеОпции = Метаданные.ФункциональныеОпции;  
	Параметры = Новый Структура(СтандартныеПодсистемыПовтИсп.ОпцииИнтерфейса());
	Для каждого ФО Из ФункциональныеОпции Цикл
		Для каждого ЗначениеЭлемента Из ФО.Состав Цикл
			Если Тип(ФО.Хранение.Тип) = Тип("Булево") И Строка(ЗначениеЭлемента.Объект) = МетаданныеИмя Тогда
				ФОВключена = ПолучитьФункциональнуюОпцию(ФО.Имя, Параметры);
				Если Не ФОВключена Тогда
					ТекстОшибки = НСтр("ru = ' В настройках учета отключена функциональная опция  ""%1"", документы ""%2"" будут загружены,
					| но недоступны для просмотра.';
					|en = ' In the accounting settings, the %1 functional option is disabled. The %2 documents will be imported
					| but unavailable to view.'", ОбщегоНазначения.КодОсновногоЯзыка());
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ФО.Синоним, МетаданныеИмя);
				КонецЕсли;
				ТекстСообщения = ТекстСообщения + ТекстОшибки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
Процедура ПроверитьСостояниеФункциональныхОпцийПоИмени(ИменаФО, ТекстОшибок)
	МассивОшибок = Новый Массив;
	
	Для Каждого ИмяФО Из ИменаФО Цикл
		МетаданныеФО = Метаданные.ФункциональныеОпции.Найти(ИмяФО);
	
		Если МетаданныеФО = Неопределено Тогда
			Продолжить;
		КонецЕсли;
	
		Если Тип(МетаданныеФО.Хранение.Тип) = Тип("Булево") Тогда
	
			Если Не ПолучитьФункциональнуюОпцию(МетаданныеФО.Имя) Тогда
				ТекстОшибки = НСтр("ru = 'В настройках учета отключена функциональная опция  ""%1""';
									|en = 'In the accounting settings, the ""%1"" functional option is disabled'",
					ОбщегоНазначения.КодОсновногоЯзыка());
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, МетаданныеФО.Синоним);
				
				МассивОшибок.Добавить(ТекстОшибки);
			КонецЕсли;
	
		КонецЕсли;
	
	КонецЦикла;
	ТекстОшибок = СтрСоединить(МассивОшибок, Символы.ПС);
КонецПроцедуры
Процедура ПроверкаЗаполненияОбязательныхРеквизитовОбъектаИБ(ОбъектДанных, КомпонентыОбмена, ИспользованиеПКО, СинонимыРеквизитов = Неопределено, ДополнительноПроверяемыеРеквизиты = Неопределено)
	Если ТипЗнч(ОбъектДанных) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если СинонимыРеквизитов = Неопределено Тогда
		СинонимыРеквизитов = Новый Соответствие;
	КонецЕсли;
	
	Если ДополнительноПроверяемыеРеквизиты = Неопределено Тогда
		ДополнительноПроверяемыеРеквизиты = Новый Структура;
	КонецЕсли;
	
	ПроверяемыеСтандартныеРеквизиты = Новый Структура;
	
	ПроверяемыеСтандартныеРеквизиты.Вставить("Справочники", Новый Массив);
	ПроверяемыеСтандартныеРеквизиты["Справочники"].Добавить("Код");
	ПроверяемыеСтандартныеРеквизиты["Справочники"].Добавить("Наименование");
	ПроверяемыеСтандартныеРеквизиты["Справочники"].Добавить("Владелец");
	
	ПроверяемыеСтандартныеРеквизиты.Вставить("Документы", Новый Массив);
	ПроверяемыеСтандартныеРеквизиты["Документы"].Добавить("Номер");
	ПроверяемыеСтандартныеРеквизиты["Документы"].Добавить("Дата");
	
	ПроверяемыеСтандартныеРеквизиты.Вставить("ПланыВидовХарактеристик", Новый Массив);
	ПроверяемыеСтандартныеРеквизиты["ПланыВидовХарактеристик"].Добавить("Код");
	ПроверяемыеСтандартныеРеквизиты["ПланыВидовХарактеристик"].Добавить("Наименование");
	
	ПроверяемыеСтандартныеРеквизиты.Вставить("РегистрыСведений", Новый Массив);
	ПроверяемыеСтандартныеРеквизиты["РегистрыСведений"].Добавить("Период");
	ПроверяемыеСтандартныеРеквизиты["РегистрыСведений"].Добавить("Регистратор");
	
	МД = ОбъектДанных.Метаданные();
	ВидОбъекта = ОбщегоНазначения.ИмяБазовогоТипаПоОбъектуМетаданных(МД);
	
	РеквизитыОбъекта            = МД.Реквизиты;
	СтандартныеРеквизитыОбъекта = МД.СтандартныеРеквизиты;
	
	ПроверяемыеСтандартныеРеквизитыОбъекта = Неопределено;
	Если Не ПроверяемыеСтандартныеРеквизиты.Свойство(ВидОбъекта, ПроверяемыеСтандартныеРеквизитыОбъекта) Тогда
		ПроверяемыеСтандартныеРеквизитыОбъекта = Новый Массив;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ИспользованиеПКО Цикл
		
		Если Не КлючЗначение.Значение Тогда
			Продолжить;
		КонецЕсли;
			
		ТекстОшибки    = "";
		ТекПКО         = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, КлючЗначение.Ключ);
		ТипОбъектаXDTO = ФабрикаXDTO.Тип(КомпонентыОбмена.XMLСхема, ТекПКО.ОбъектФормата);
		
		ОбязательныеСвойстваФормата = Новый Массив;
		
		Для Каждого ТекСвойство Из ТипОбъектаXDTO.Свойства Цикл
			
			Если ТекСвойство.Имя = "КлючевыеСвойства" Или ТекСвойство.Имя = "ОбщиеДанные" Тогда
				
				Для Каждого КлючСвойство Из ТекСвойство.Тип.Свойства Цикл
					Если КлючСвойство.НижняяГраница > 0 Тогда
						ОбязательныеСвойстваФормата.Добавить(КлючСвойство.Имя);
					КонецЕсли
				КонецЦикла;
				
			ИначеЕсли ТекСвойство.НижняяГраница > 0 Тогда
				ОбязательныеСвойстваФормата.Добавить(ТекСвойство.Имя);
			КонецЕсли
			
		КонецЦикла;
		
		// Выполняем проверку свойств формата обязательных к заполнению,
		// заполняемые не с помощью алгоритма конвертации,
		// и имеющие прямое сопоставление реквизита конфигурации и свойства формата.
		// Дополнительно вызывается проверка реквизитов, которые переданы отдельно
		// в структуре ДополнительноПроверяемыеРеквизиты.
		Для Каждого ТекПКС Из ТекПКО.Свойства Цикл
			
			Если (Не ТекПКС.ИспользуетсяАлгоритмКонвертации
				И ЗначениеЗаполнено(ТекПКС.СвойствоКонфигурации)
				И СтрНайти(ТекПКС.СвойствоКонфигурации, ".") = 0
				И ОбязательныеСвойстваФормата.Найти(ТекПКС.СвойствоФормата) <> Неопределено)
				Или (ЗначениеЗаполнено(ДополнительноПроверяемыеРеквизиты) И ДополнительноПроверяемыеРеквизиты.Свойство(ТекПКС.СвойствоКонфигурации)) Тогда
				
				Если (ПроверяемыеСтандартныеРеквизитыОбъекта.Найти(ТекПКС.СвойствоКонфигурации) <> Неопределено
						Или ОбщегоНазначения.ЭтоСтандартныйРеквизит(СтандартныеРеквизитыОбъекта, ТекПКС.СвойствоКонфигурации))
					И Не ЗначениеЗаполнено(ОбъектДанных[ТекПКС.СвойствоКонфигурации]) Тогда
					
					МДРеквизиты = СтандартныеРеквизитыОбъекта;
							
				ИначеЕсли РеквизитыОбъекта.Найти(ТекПКС.СвойствоКонфигурации) <> Неопределено
					И (РеквизитыОбъекта[ТекПКС.СвойствоКонфигурации].ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку
						Или ДополнительноПроверяемыеРеквизиты.Свойство(ТекПКС.СвойствоКонфигурации))
					И Не ЗначениеЗаполнено(ОбъектДанных[ТекПКС.СвойствоКонфигурации]) Тогда
					
					МДРеквизиты = РеквизитыОбъекта;
					
				Иначе
					Продолжить;
				КонецЕсли;
				
				ПредставлениеРеквизита = МДРеквизиты[ТекПКС.СвойствоКонфигурации].Синоним;
				
				Если Не ЗначениеЗаполнено(ПредставлениеРеквизита) Тогда 
					ПредставлениеРеквизита = МДРеквизиты[ТекПКС.СвойствоКонфигурации].Имя;
				КонецЕсли;
				
				ТекстОшибки = ТекстОшибки + Символы.ПС + "- "
					+ ?(СинонимыРеквизитов[ТекПКС.СвойствоКонфигурации] <> Неопределено,
						СинонимыРеквизитов[ТекПКС.СвойствоКонфигурации], ПредставлениеРеквизита) + ",";
				
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			
			ТекстОшибки = Сред(ТекстОшибки, 1, СтрДлина(ТекстОшибки)-1) + ".";
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В объекте %1 ""%2"" не заполнены реквизиты:';
																						|en = 'Attributes are not filled in the %1 ""%2"" object:'"), ТипЗнч(ОбъектДанных.Ссылка),ОбъектДанных) + ТекстОшибки;
			ОбменДаннымиXDTOСервер.ЗаписьЖурналаРегистрацииОбменДанными(ТекстОшибки, КомпонентыОбмена, , ОбъектДанных.Ссылка);
			
			ИспользованиеПКО[КлючЗначение.Ключ] = Ложь;
					
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
//++ Локализация
Процедура ПроверкаЗаполненияОбязательныхРеквититовПатентов(Патент, Результат, КомпонентыОбмена, Документ, Организация, Подразделение)
	Результат = Истина;
	
	МассивНезаполненныхРеквизитов = Новый Массив;
	
	СтруктураОбязательныхРеквизитовНО = Новый Структура;
	
	СтруктураОбязательныхРеквизитовНО.Вставить("Код", "Код налогового органа");
	
	СтруктураОбязательныхРеквизитовПатента = Новый Структура("ДатаНачала, ДатаОкончания, НомерПатента", 
		"Дата начала", "Дата окончания", "Номер патента");
	
	Для Каждого ОбязательныйРеквизит Из СтруктураОбязательныхРеквизитовПатента Цикл
		
		ИмяРеквизита = ОбязательныйРеквизит.Ключ;
		ПредставлениеРеквизита = ОбязательныйРеквизит.Значение;
		
		Если Не ЗначениеЗаполнено(Патент[ИмяРеквизита]) Тогда
			
			МассивНезаполненныхРеквизитов.Добавить(ПредставлениеРеквизита); 
			
		КонецЕсли;
		
	КонецЦикла; 
	
	НалоговыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Патент, "НалоговыйОрган");
	
	Для Каждого ОбязательныйРеквизит Из СтруктураОбязательныхРеквизитовНО Цикл
		
		ИмяРеквизита = ОбязательныйРеквизит.Ключ;
		ПредставлениеРеквизита = ОбязательныйРеквизит.Значение;
		
		Если Не ЗначениеЗаполнено(НалоговыйОрган[ИмяРеквизита]) Тогда
			
			МассивНезаполненныхРеквизитов.Добавить(ПредставлениеРеквизита); 
			
		КонецЕсли;
		
	КонецЦикла;
	
	НезаполненныеРеквизиты = СтрСоединить(МассивНезаполненныхРеквизитов, ", ");
	
	Если ПустаяСтрока(Патент.Ссылка) Тогда
		ТекстОшибки = НСтр("ru = 'В документе ""%1"" используется патентная система налогообложения,
		|но ни одного патента, соответствующего организации ""%2"" и подразделению ""%3"", не найдено!';
		|en = 'In the %1 document, the patent taxation system is used,
		|but no patent that matches the %2 company and the %3 business unit is found.'", ОбщегоНазначения.КодОсновногоЯзыка());
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
		Документ, Организация, Подразделение); 
		ОписаниеОшибки = ТекстОшибки;
	ИначеЕсли Не ПустаяСтрока(НезаполненныеРеквизиты) Тогда	
		ТекстОшибки = НСтр("ru = 'У элемента справочника ""%1"" не заполнены реквизиты: ""%2"".
		|Элемент справочника ""%3"" не выгружен.';
		|en = 'The ""%2"" attributes are not filled in the ""%1"" catalog item.
		|The ""%3"" catalog item is not exported.'", ОбщегоНазначения.КодОсновногоЯзыка());
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
		Патент.Наименование, НезаполненныеРеквизиты, Патент.Метаданные().Синоним);
		ОписаниеОшибки = ТекстОшибки;
	КонецЕсли; 
	
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
	
		ЗаписатьОшибкуВЖурналРегистрации(Патент, ОписаниеОшибки, КомпонентыОбмена, ,УровеньЖурналаРегистрации.Предупреждение);		
		
		РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(
		Патент.Ссылка,
		КомпонентыОбмена.УзелКорреспондента,
		ТекстОшибки,
		Перечисления.ТипыПроблемОбменаДанными.ОшибкаПроверкиСконвертированногоОбъекта);
		
		Результат = Ложь;
		
	КонецЕсли;
КонецПроцедуры
//-- Локализация
Процедура ПТиУ_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗаполнитьСкладПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	Если ЗначениеЗаполнено(ПолученныеДанные.Контрагент) И НЕ ЗначениеЗаполнено(ПолученныеДанные.Партнер) Тогда
		ПолученныеДанные.Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПолученныеДанные.Контрагент, "Партнер");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Партнер)
			И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровИКонтрагентов") Тогда
		ПолученныеДанные.Партнер = Справочники.Партнеры.НеизвестныйПартнер;
	КонецЕсли;
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
								ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	СерииПриПолучении = 0;
	Если ДанныеИБ <> Неопределено Тогда
		ТоварыСерии = ДанныеИБ.Товары.Выгрузить();
		ДанныеИБСклад = ДанныеИБ.Склад;
	
		// Переносим те свойства, которые указаны в ПКС
		ИсключаемыеПоляШапкиОбъекта = Новый Массив;
		Если ЗначениеЗаполнено(ДанныеИБ.ЗаказПоставщику) Тогда
			ИсключаемыеПоляШапкиОбъекта.Добавить("ЗаказПоставщику");
			ИсключаемыеПоляШапкиОбъекта.Добавить("ПоступлениеПоЗаказам");
		КонецЕсли;
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, ИсключаемыеПоляШапкиОбъекта);
		
		Если НЕ КомпонентыОбмена.ПараметрыКонвертации.ВыгружатьАналитикуПоСкладам Тогда
			// Восстанавливаем склад из первоначального документа
			ДанныеИБ.Склад = ДанныеИБСклад;
		КонецЕсли;
		
		// Товары
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("Склад");
		МассивКлючевыхПолей.Добавить("СтавкаНДС");
		МассивКлючевыхПолей.Добавить("НомерГТД");
		МассивКлючевыхПолей.Добавить("Подразделение");
		МассивКлючевыхПолей.Добавить("СтатьяРасходов");
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
				ПолученныеДанные.Товары,
				ДанныеИБ.Товары,
				МассивКлючевыхПолей,
				"АналитикаРасходов, ЗаказПоставщику, Сертификат, НомерПаспорта, СписатьНаРасходы, СтатусУказанияСерий",
				Неопределено);
	
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
		СерииПриПолучении = ПолученныеДанные.Серии.Количество(); 
		СерииПолучателя = СерииПриПолучении = 0 И ДанныеИБ.Серии.Количество() > 0;
		Для Каждого Строка Из ДанныеИБ.Товары Цикл
			Строка.Склад = ДанныеИБ.Склад;
			Если СерииПолучателя Тогда
				НайденнаяСтрока = ТоварыСерии.Найти(Строка.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если НЕ НайденнаяСтрока = Неопределено Тогда
					Строка.СтатусУказанияСерий = НайденнаяСтрока.СтатусУказанияСерий;
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;	
		ПолученныеДанные = Неопределено;
	Иначе
		Если ТипЗнч(ПолученныеДанные) = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") 
			И ОбщегоНазначения.ЕстьРеквизитОбъекта("НоваяМеханикаСозданияЗаявленийОВвозе",ПолученныеДанные.Метаданные()) Тогда
			ПолученныеДанные.НоваяМеханикаСозданияЗаявленийОВвозе = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Для Каждого Строка Из ДанныеДляЗаписиВИБ.Товары Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Строка.Номенклатура = ЭлементПоУмолчанию(КомпонентыОбмена, "НоменклатураУслуга");
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеДляЗаписиВИБ.Валюта = ДанныеДляЗаписиВИБ.ВалютаВзаиморасчетов Тогда
		ДанныеДляЗаписиВИБ.КурсЧислитель = 1;
		ДанныеДляЗаписиВИБ.КурсЗнаменатель = 1;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ВалютаВзаиморасчетов) Тогда
		КлючиУсловийЗакупок			= "УчитыватьГруппыСкладов, ИсключитьГруппыСкладовДоступныеВЗаказах, ВыбранноеСоглашение";
		ОтборУсловийЗакупок			= Новый Структура(КлючиУсловийЗакупок, Истина, Истина, ДанныеДляЗаписиВИБ.Соглашение);
		УсловияЗакупокПоУмолчанию	= ЗакупкиСервер.ПолучитьУсловияЗакупокПоУмолчанию(ДанныеДляЗаписиВИБ.Партнер, ОтборУсловийЗакупок);
		Если УсловияЗакупокПоУмолчанию <> Неопределено И УсловияЗакупокПоУмолчанию.Свойство("ВалютаВзаиморасчетов") Тогда
			ДанныеДляЗаписиВИБ.ВалютаВзаиморасчетов = УсловияЗакупокПоУмолчанию.ВалютаВзаиморасчетов;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ВариантПриемкиТоваров) Тогда
		ДанныеДляЗаписиВИБ.ВариантПриемкиТоваров = ЗакупкиСервер.ПолучитьВариантПриемкиТоваров(Неопределено, ДанныеДляЗаписиВИБ.Договор);
	КонецЕсли;
КонецПроцедуры
Функция ПТиУ_РасширенныеДанныеИБ(КомпонентыОбмена, ДанныеИБ)
	Результат = Новый Структура;
		
		ВалютаРеглУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ДанныеИБ.Организация);
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("Ссылка",                     ДанныеИБ.Ссылка);
		Запрос.УстановитьПараметр("Дата",                       ДанныеИБ.Дата);
		Запрос.УстановитьПараметр("ДатаКурса", ?(ЗначениеЗаполнено(ДанныеИБ.ДатаКурсаВалютыДокумента), 
			ДанныеИБ.ДатаКурсаВалютыДокумента,  ДанныеИБ.Дата));
		Запрос.УстановитьПараметр("ВалютаДок",                  ДанныеИБ.Валюта);
		Запрос.УстановитьПараметр("ВалютаРег",                  ВалютаРеглУчета);
		Запрос.УстановитьПараметр("ВыгружатьШтрихкодыУпаковок", ВыгружатьШтрихкодыУпаковок(КомпонентыОбмена));
		
		ТекстыЗапросов = Новый Массив;
		
		#Область ФрагментЗапросаШапкаДокумента
		// Данные шапки документа необходимы для вычисления курса и кратности
		// взаиморасчетов и для вычисления розничных цен товаров.
		ШапкаДокумента = "ВЫБРАТЬ
			|	ДанныеШапкиДокумента.Склад.РозничныйВидЦены КАК РозничныйВидЦены,
			|	ДанныеШапкиДокумента.Валюта,
			|	ДанныеШапкиДокумента.ВалютаВзаиморасчетов,
			|	ДанныеШапкиДокумента.КурсЧислитель КАК КурсВзаиморасчетов,
			|	ДанныеШапкиДокумента.КурсЗнаменатель КАК КратностьВзаиморасчетов,
			|	ВЫБОР
			|		КОГДА ДанныеШапкиДокумента.ХозяйственнаяОперация = Значение(Перечисление.ХозяйственныеОперации.ПриемНаКомиссию)
			|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК Строка(20))
			|		ИНАЧЕ
			|			ВЫРАЗИТЬ(&СобственныеТовары КАК Строка(20))
			|	КОНЕЦ КАК ТипЗапасовПоВидуОперации,
			|	ДанныеШапкиДокумента.НалогообложениеНДС КАК НалогообложениеНДС,
			|	ДанныеШапкиДокумента.ЗакупкаПодДеятельность КАК ЗакупкаПодДеятельность
			|ПОМЕСТИТЬ ДанныеШапкиДокумента
			|ИЗ
			|	Документ.ПриобретениеТоваровУслуг КАК ДанныеШапкиДокумента
			|ГДЕ
			|	ДанныеШапкиДокумента.Ссылка = &Ссылка";
		
		ЗаполнитьСобственныеТоварыВТексте(ШапкаДокумента);
		
		ТекстыЗапросов.Добавить(ШапкаДокумента);
		#КонецОбласти
		
		#Область ФрагментЗапросаДанныеОперации
		Если ДанныеИБ.Валюта = ВалютаРеглУчета
			Или ДанныеИБ.ВалютаВзаиморасчетов = ВалютаРеглУчета Тогда
			ДанныеОперации =
			"ВЫБРАТЬ
			|	ДанныеШапкиДокумента.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
			|	ДанныеШапкиДокумента.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов
			|ИЗ
			|	ДанныеШапкиДокумента КАК ДанныеШапкиДокумента";
		Иначе
			ДанныеОперации =
			"ВЫБРАТЬ
			|	ЕСТЬNULL(КурсВалютыДокумента.КурсЧислитель, 1) КАК КурсВзаиморасчетов,
			|	ЕСТЬNULL(КурсВалютыДокумента.КурсЗнаменатель, 1) КАК КратностьВзаиморасчетов
			|ИЗ
			|	ДанныеШапкиДокумента КАК ДанныеШапкиДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтносительныеКурсыВалют.СрезПоследних(
			|				&ДатаКурса,
			|				Валюта В
			|					(ВЫБРАТЬ
			|						Док.Валюта
			|					ИЗ
			|						ДанныеШапкиДокумента КАК Док)
			|				И БазоваяВалюта = &ВалютаРег) КАК КурсВалютыДокумента
			|		ПО ДанныеШапкиДокумента.Валюта = КурсВалютыДокумента.Валюта";
		КонецЕсли;
		
		ТекстыЗапросов.Добавить(ДанныеОперации);
		#КонецОбласти
		
		#Область ФрагментЗапросаТоварыДокумента
		Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту
			ИЛИ ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпортуТоварыВПути Тогда
			// При поступлении по импорту номера ГТД присваиваются позже документом "Таможенная декларация".
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Серии.Ссылка КАК Ссылка,
			|	Серии.НомерСтроки КАК НомерСтроки,
			|	Серии.Серия КАК Серия,
			|	Серии.Количество КАК Количество,
			|	Серии.Номенклатура КАК Номенклатура,
			|	Серии.Характеристика КАК Характеристика,
			|	Серии.Назначение КАК Назначение,
			|	Серии.Склад КАК Склад
			|ПОМЕСТИТЬ ВТСерии_ПолнаяВыборка
			|ИЗ
			|	Документ.ПриобретениеТоваровУслуг.Серии КАК Серии
			|ГДЕ
			|	Серии.Ссылка = &Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Серии.Ссылка КАК Ссылка,
			|	Серии.Номенклатура КАК Номенклатура,
			|	Серии.Характеристика КАК Характеристика,
			|	Серии.Назначение КАК Назначение,
			|	Серии.Склад КАК Склад,
			|	МИНИМУМ(Серии.НомерСтроки) КАК НомерСтроки
			|ПОМЕСТИТЬ ВТСерии_ПервыеСтроки
			|ИЗ
			|	ВТСерии_ПолнаяВыборка КАК Серии
			|
			|СГРУППИРОВАТЬ ПО
			|	Серии.Ссылка,
			|	Серии.Номенклатура,
			|	Серии.Характеристика,
			|	Серии.Назначение,
			|	Серии.Склад
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТСерииПС.Ссылка КАК Ссылка,
			|	Серии.Серия КАК Серия,
			|	ВТСерииПС.Номенклатура КАК Номенклатура,
			|	ВТСерииПС.Характеристика КАК Характеристика,
			|	ВТСерииПС.Назначение КАК Назначение,
			|	ВТСерииПС.Склад КАК Склад
			|ПОМЕСТИТЬ ВТСерии
			|ИЗ
			|	ВТСерии_ПервыеСтроки КАК ВТСерииПС
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСерии_ПолнаяВыборка КАК Серии
			|		ПО ВТСерииПС.Номенклатура = Серии.Номенклатура
			|			И ВТСерииПС.Характеристика = Серии.Характеристика
			|			И ВТСерииПС.Назначение = Серии.Назначение
			|			И ВТСерииПС.Склад = Серии.Склад
			|			И ВТСерииПС.НомерСтроки = Серии.НомерСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.Характеристика КАК Характеристика,
			|	ЕСТЬNULL(ВЫБОР
			|		КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
			|			ТОГДА Серии.Серия
			|		ИНАЧЕ Товары.Серия
			|	КОНЕЦ, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Серия,
			|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Товары.Количество КАК Количество,
			|	Товары.Сумма КАК Сумма,
			|	ВЫБОР
			|		КОГДА Товары.Цена > 0
			|				И Товары.Цена / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки1, 1) < 0.01
			|			ТОГДА 0.01
			|		ИНАЧЕ Товары.Цена / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки1, 1)
			|	КОНЕЦ КАК ЦенаЗаЕдиницу,
			|	Товары.Цена КАК ЦенаЗаУпаковку,
			|	Товары.Упаковка КАК Упаковка,
			|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
			|	Товары.СтавкаНДС КАК СтавкаНДС,
			|	Товары.СуммаНДС КАК СуммаНДС,
			|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	Товары.СтатьяРасходов КАК СтатьяРасходов,
			|	Товары.СтатьяРасходов.КорреспондирующийСчет КАК КорреспондирующийСчет,
			|	Товары.НомерГТД КАК НомерГТД,
			|	Товары.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
			|	Товары.Ссылка.ВернутьМногооборотнуюТару КАК ВернутьМногооборотнуюТару,
			|	Товары.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры
			|ИЗ
			|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСерии КАК Серии
			|		ПО Товары.Номенклатура = Серии.Номенклатура
