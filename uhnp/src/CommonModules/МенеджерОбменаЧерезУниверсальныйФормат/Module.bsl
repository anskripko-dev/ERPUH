Процедура ПКО_Документ_СписаниеЗадолженности_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("СуммаВзаиморасчетов", "Сумма");
	
	Если ДанныеXDTO.Свойство("ДебиторскаяЗадолженность")
		И ЗначениеЗаполнено(ДанныеXDTO.ДебиторскаяЗадолженность) Тогда
		ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности;
		ЗагрузитьТЧКорректировкаДолга(КомпонентыОбмена, ДанныеXDTO, ПолученныеДанные, "ДебиторскаяЗадолженность", "Задолженность", ПравилаЗаполнения);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Контрагент", ДанныеXDTO.КонтрагентДебитор);
		//++ НЕ УТ
		
		//++ Локализация
		Если ДанныеXDTO.Свойство("СчетДт") И ЗначениеЗаполнено(ДанныеXDTO.СчетДт) Тогда
			СчетУчетаПоКоду = ПланыСчетов.Хозрасчетный.НайтиПоКоду(ДанныеXDTO.СчетДт);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("СчетУчетаПоКоду", СчетУчетаПоКоду); 
		КонецЕсли;
		//-- Локализация
		
		//-- НЕ УТ
	ИначеЕсли ДанныеXDTO.Свойство("КредиторскаяЗадолженность")
		И ЗначениеЗаполнено(ДанныеXDTO.КредиторскаяЗадолженность) Тогда
		ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности;
		ЗагрузитьТЧКорректировкаДолга(КомпонентыОбмена, ДанныеXDTO, ПолученныеДанные, "КредиторскаяЗадолженность", "Задолженность", ПравилаЗаполнения);
		Если ДанныеXDTO.Свойство("КонтрагентКредитор") Тогда
		    ПолученныеДанные.ДополнительныеСвойства.Вставить("Контрагент", ДанныеXDTO.КонтрагентКредитор);
		КонецЕсли; 
		//++ НЕ УТ
		
		//++ Локализация
		Если ДанныеXDTO.Свойство("СчетКт") И ЗначениеЗаполнено(ДанныеXDTO.СчетКт) Тогда
			СчетУчетаПоКоду = ПланыСчетов.Хозрасчетный.НайтиПоКоду(ДанныеXDTO.СчетКт);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("СчетУчетаПоКоду", СчетУчетаПоКоду);
		КонецЕсли; 
		//-- Локализация
		
		//-- НЕ УТ
	КонецЕсли;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Валюта",         "Валюта");
	ПравилаЗаполнения.Вставить("Подразделение",  "Подразделение");
	ПравилаЗаполнения.Вставить("СтатьяДоходов",  "СтатьяДоходов");
	ПравилаЗаполнения.Вставить("СтатьяРасходов", "СтатьяРасходов");
	
	Если ДанныеXDTO.Свойство("СуммаДебиторскойЗадолженности") Тогда
		ПравилаЗаполнения.Вставить("СуммаДебиторскойЗадолженности", "Сумма");
	ИначеЕсли ДанныеXDTO.Свойство("СуммаКредиторскойЗадолженности") Тогда
		ПравилаЗаполнения.Вставить("СуммаКредиторскойЗадолженности", "Сумма");
	КонецЕсли;
	
	СтруктураДанных = ДанныеКоллекцииВВидеСтруктуры(ДанныеXDTO, ПравилаЗаполнения);
	
	Если СтруктураДанных.Свойство("СтатьяДоходов") Тогда
		СтруктураДанных.Вставить("Статья",Новый Структура("Значение, ИмяПКО",
			СтруктураДанных.СтатьяДоходов, "Справочник_СтатьиДоходов"));
	ИначеЕсли СтруктураДанных.Свойство("СтатьяРасходов") Тогда
		СтруктураДанных.Вставить("Статья", Новый Структура("Значение, ИмяПКО",
			СтруктураДанных.СтатьяРасходов, "Справочник_СтатьиРасходов"));
	КонецЕсли;
	
	ДоходыРасходыАктивыПассивы = Новый Массив;
	ДоходыРасходыАктивыПассивы.Добавить(СтруктураДанных);
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ДоходыРасходыАктивыПассивы", ДоходыРасходыАктивыПассивы);
КонецПроцедуры
Процедура ПКО_Документ_СписаниеЗадолженности_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	//++ НЕ УТ
	
	//++ Локализация
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("СчетУчетаПоКоду") И 
		ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.СчетУчетаПоКоду) Тогда
		
		Если ДанныеИБ = Неопределено Тогда
			ВладелецНастройки = ПолученныеДанные.ПолучитьСсылкуНового();
		Иначе
			ВладелецНастройки = ДанныеИБ.Ссылка;
		КонецЕсли;
		
		ПараметрыНастройки = Новый Структура();
		ПараметрыНастройки.Вставить("СчетУчета", ПолученныеДанные.ДополнительныеСвойства.СчетУчетаПоКоду);
		
		ПолученныеДанные.ДоходыРасходыАктивыПассивы[0].НастройкаСчетовУчета = НастройкаСчетовУчетаПрочихОпераций(ПараметрыНастройки, ВладелецНастройки);
		
	КонецЕсли;
	//-- Локализация
	
	//-- НЕ УТ
	ЗаполнитьДопСвойстваДанныхИБИзПолученныхДанных(ДанныеИБ, ПолученныеДанные);
	УстановитьОтменуМеханическойЧисткиДвижений(ДанныеИБ);
КонецПроцедуры

