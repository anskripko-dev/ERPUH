Процедура ПОД_Справочник_ДоговорыЭквайринга_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.11") Тогда
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
	КонецЕсли;
	Если ИспользованиеПКО.Количество() > 0 Тогда
	   Если Не ЗначениеЗаполнено(ДанныеИБ.Организация) ИЛИ НЕ ЗначениеЗаполнено(ДанныеИБ.Контрагент) Тогда
			ОчиститьИспользованиеПКО(ИспользованиеПКО);
	   КонецЕсли;		
	КонецЕсли;
	Если ИспользованиеПКО.Количество() > 0 Тогда
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.18")
			И КомпонентыОбмена.УзелКорреспондентаОбъект.ВариантНастройки = "ОбменУПРМК"
			И ДанныеИБ.СпособПроведенияПлатежа <> Перечисления.СпособыПроведенияПлатежей.СистемаБыстрыхПлатежей Тогда
			ОчиститьИспользованиеПКО(ИспользованиеПКО);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

