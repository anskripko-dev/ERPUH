Процедура ПКО_Справочник_ОписаниеМаркированнойПродукции_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номенклатура", ДанныеИБ.Отбор.Номенклатура.Значение);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Ссылка", ДанныеИБ.Отбор.Номенклатура.Значение);
	
	Если ДанныеИБ.Выгрузить().Количество() > 0 Тогда
	
		ТекЗапись = ДанныеИБ.Выгрузить()[0];
		ДанныеXDTO.Вставить("ЕмкостьПотребительскойУпаковки", ТекЗапись.ЕмкостьПотребительскойУпаковки);
		ДанныеXDTO.Вставить("КоличествоВПотребительскойУпаковке", ТекЗапись.КоличествоВПотребительскойУпаковке);
		ДанныеXDTO.Вставить("ВариантЧастичногоВыбытия", ТекЗапись.ВариантЧастичногоВыбытия);
		ДанныеXDTO.Вставить("ВариантИспользованияЕдиницыХранения", Перечисления.ВариантыИспользованияЕдиницыХраненияИС.ЧастьПотребительскойУпаковки);
		
		ТекПотребительскаяУпаковка = ТекЗапись.ПотребительскаяУпаковка;
		Если ЗначениеЗаполнено(ТекПотребительскаяУпаковка)
			И ТипЗнч(ТекПотребительскаяУпаковка) = Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения")
			И ТипЗнч(ТекПотребительскаяУпаковка.Владелец)= Тип("СправочникСсылка.Номенклатура") Тогда
			ДанныеXDTO.Вставить("ПотребительскаяУпаковка", ТекЗапись.ПотребительскаяУпаковка);
		Иначе
			ДанныеXDTO.Вставить("ПотребительскаяУпаковка", Неопределено);
		КонецЕсли;
		
		ТекУпаковкаЧастичногоВыбытия = ТекЗапись.УпаковкаЧастичногоВыбытия;
		Если ЗначениеЗаполнено(ТекУпаковкаЧастичногоВыбытия)
			И ТипЗнч(ТекУпаковкаЧастичногоВыбытия) = Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения")
			И ТипЗнч(ТекУпаковкаЧастичногоВыбытия.Владелец)= Тип("СправочникСсылка.Номенклатура") Тогда
			ДанныеXDTO.Вставить("УпаковкаЧастичногоВыбытия", ТекЗапись.УпаковкаЧастичногоВыбытия);
		Иначе
			ДанныеXDTO.Вставить("УпаковкаЧастичногоВыбытия", Неопределено);
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры

