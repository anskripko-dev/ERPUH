//-- Локализация
Функция РеквизитыКлиентаКонтрагентаОбъекта(Объект)
	СтруктураРеквизитов = Новый Структура("ИмяРеквизитаКлиент, ИмяРеквизитаКлиентПартнер");
	
	Если ТипЗнч(Объект) = Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда
		
		СтруктураРеквизитов.ИмяРеквизитаКлиент = "КомиссионерКонтрагент";
		СтруктураРеквизитов.ИмяРеквизитаКлиентПартнер = "КомиссионерПартнер";
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ВозвратТоваровОтКлиента")
		Или ТипЗнч(Объект) = Тип("ДокументОбъект.КорректировкаРеализации")
		Или ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		СтруктураРеквизитов.ИмяРеквизитаКлиент = "КлиентКонтрагент";
		СтруктураРеквизитов.ИмяРеквизитаКлиентПартнер = "КлиентПартнер";	
		
	Иначе
	
		Возврат Неопределено;
		
	КонецЕсли;      
	
	Возврат СтруктураРеквизитов;
КонецФункции
Функция СвойствоФорматаОбмена(КомпонентыОбмена, ИмяСвойства)
	Результат = Ложь;
	
	ПространствоИмен = КомпонентыОбмена.XMLСхема;
	
	Если ФабрикаXDTO.Тип(Новый ТипДанныхXML(ИмяСвойства, ПространствоИмен)) <> Неопределено Тогда
		Результат = Истина;
	Иначе
		МассивСтрок = ОбщегоНазначенияКлиентСервер.РазложитьСтрокуПоТочкамИСлэшам(ИмяСвойства);
		
		Если МассивСтрок.Количество() > 1 Тогда
			ИмяОбъекта = МассивСтрок[0] + "." + МассивСтрок[1];
			ТипФабрики = ФабрикаXDTO.Тип(Новый ТипДанныхXML(ИмяОбъекта, ПространствоИмен));
			Если ТипФабрики <> Неопределено Тогда
				Для Сч = 2 По МассивСтрок.Количество() - 1 Цикл
					ИмяТекОбъекта = МассивСтрок[Сч];
					Если ТипЗнч(ТипФабрики) = Тип("СвойствоXDTO") Тогда
						ТипФабрики = ТипФабрики.Тип.Свойства.Получить(ИмяТекОбъекта);
					Иначе
						ТипФабрики = ТипФабрики.Свойства.Получить(ИмяТекОбъекта);
					КонецЕсли;
					Если ТипФабрики = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли
				КонецЦикла;
				Результат = ТипФабрики <> Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
// Параметры:
//  ПартнерОбъект - СправочникОбъект.Партнеры - объект информационной базы.
//  Контрагент - СправочникОбъект.Контрагенты - объект информационной базы.
//  КомпонентыОбмена - см. ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена
//
Процедура СинхронизироватьДанныеПартнераСДаннымиКонтрагента(ПартнерОбъект, Контрагент, КомпонентыОбмена)
	Если ПартнерОбъект.ЭтоНовый() Тогда
		ПартнерОбъект.ДатаРегистрации = Дата('19800101');
		ПартнерОбъект.Клиент          = Истина;
		ПартнерОбъект.Поставщик       = Истина;
		ПартнерОбъект.ПрочиеОтношения = Истина;
		ПартнерОбъект.ГруппаДоступа   = ЭлементПоУмолчанию(КомпонентыОбмена, "ГруппаДоступаПартнера");
		
		ПартнерОбъект.УстановитьНовыйКод();
	КонецЕсли;
	
	// Синхронизация свойств контрагента и партнера.
	Если ПартнерОбъект.Ссылка <> Справочники.Партнеры.НеизвестныйПартнер Тогда
		
		ПартнерОбъект.Наименование        = Контрагент.Наименование;
		ПартнерОбъект.НаименованиеПолное  = Контрагент.НаименованиеПолное;
		Если Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
		Иначе
			ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
		КонецЕсли;
		
		ПартнерОбъект.КонтактнаяИнформация.Очистить();
		Для Каждого СтрокаКИКонтрагента Из Контрагент.КонтактнаяИнформация Цикл
			
			Если СтрокаКИКонтрагента.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента Тогда
				ВидКиПартнера = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
			ИначеЕсли СтрокаКИКонтрагента.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента Тогда
				ВидКиПартнера = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			ИначеЕсли СтрокаКИКонтрагента.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента Тогда
				ВидКиПартнера = Справочники.ВидыКонтактнойИнформации.АдресПартнера;
			Иначе
				Продолжить;
			КонецЕсли;
			
			СтрокаКиПартнера = ПартнерОбъект.КонтактнаяИнформация.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКИПартнера, СтрокаКиКонтрагента);
			СтрокаКИПартнера.Вид = ВидКиПартнера;
			
		КонецЦикла;
		
		ПартнерОбъект.ПометкаУдаления = Ложь;
		
		ПартнерОбъект.ОбменДанными.Загрузка = Истина;
		ПартнерОбъект.Записать();
		
		ПартнерыИКонтрагенты.ЗаписатьИерархиюПартнера(ПартнерОбъект.Ссылка);
		
	КонецЕсли;
КонецПроцедуры
Функция СкладДляВыгрузки(СкладИсходный, ПараметрыКонвертации, ПроверятьНаГруппу = Ложь)
	Если ПараметрыКонвертации.ВыгружатьАналитикуПоСкладам = ЛОЖЬ Тогда
		// отправляем пустой склад
		Возврат Справочники.Склады.ПустаяСсылка();
	Иначе
		Если ПроверятьНаГруппу И СкладИсходный.ЭтоГруппа Тогда
			Возврат Справочники.Склады.ПустаяСсылка();
		КонецЕсли;
		Возврат СкладИсходный;
	КонецЕсли;
КонецФункции
Функция СкладДляЗагрузки(СкладИсходный, ПараметрыКонвертации)
	Если ЗначениеЗаполнено(ПараметрыКонвертации.СкладПоУмолчанию) И НЕ ЗначениеЗаполнено(СкладИсходный) Тогда
		// Относим хозоперацию на склад по умолчанию
		Возврат ПараметрыКонвертации.СкладПоУмолчанию;
	Иначе
		Возврат СкладИсходный;
	КонецЕсли;
КонецФункции
// Параметры:
//  СтавкаНДС - Структура
//  КомпонентыОбмена - см. ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена
//
Функция СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтавкаНДС)
	ПеречислениеСтавкаНДС = Неопределено;
	СправочникСтавкаНДС   = Неопределено;
	
	Если ТипЗнч(СтавкаНДС) = Тип("Структура") Тогда  
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
			
			//++ Локализация
			СправочникСтавкаНДС = СтавкаНДСПоВидуСтавки(СтавкаНДС);
	
			Если ЗначениеЗаполнено(СправочникСтавкаНДС) Тогда
				Возврат СправочникСтавкаНДС;
			КонецЕсли;
			//-- Локализация
			
			Если Не СтавкаНДС.Свойство("Ставка") Тогда
				Возврат Справочники.СтавкиНДС.БезНДС;
			КонецЕсли;
			НаименованиеСтраны = ""; 
			Если НЕ СтавкаНДС.Свойство("Страна") Тогда
				Страна = ЗначениеНастроекКлиентСерверПовтИсп.ОсновнаяСтрана();
				НаименованиеСтраны = Страна.Наименование;
			Иначе	 
				Страна = СтавкаНДС.Страна; // Структура 
				НаименованиеСтраны = Страна.Наименование;
			КонецЕсли;
	
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	СтавкиНДС.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СтавкиНДС КАК СтавкиНДС
			|ГДЕ
			|	СтавкиНДС.РасчетнаяСтавка = &РасчетнаяСтавка
			|	И СтавкиНДС.Страна.Наименование = &Страна
			|	И СтавкиНДС.Ставка = &Ставка");
	
			Запрос.УстановитьПараметр("Ставка", ?(СтавкаНДС.Свойство("Ставка"),СтавкаНДС.Ставка, 0));
			Запрос.УстановитьПараметр("РасчетнаяСтавка", СтавкаНДС.РасчетнаяСтавка);
			Запрос.УстановитьПараметр("Страна", НаименованиеСтраны);
			Выборка = Запрос.Выполнить().Выбрать();
	
			Если Выборка.Следующий() Тогда
				СправочникСтавкаНДС = Выборка.Ссылка;
			КонецЕсли;
	
			Возврат ?(ЗначениеЗаполнено(СправочникСтавкаНДС), СправочникСтавкаНДС,Справочники.СтавкиНДС.ПустаяСсылка());
		КонецЕсли;
	//++ Локализация
		ПКПД_Перечисление_СтавкиНДС = ПКПДПоИмени(КомпонентыОбмена, "Перечисление_СтавкиНДС");
		ПеречислениеСтавкаНДС 		= ПКПД_Перечисление_СтавкиНДС.КонвертацииЗначенийПриПолучении.Получить(СтавкаНДС.Значение);
	ИначеЕсли ТипЗнч(СтавкаНДС) = Тип("ПеречислениеСсылка.СтавкиНДС") Тогда
		ПеречислениеСтавкаНДС = СтавкаНДС;
	//-- Локализация
	КонецЕсли;
	
	//++ Локализация
	СправочникСтавкаНДС = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(ПеречислениеСтавкаНДС);
	Если НЕ СправочникСтавкаНДС = Неопределено 
		И НЕ СправочникСтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка() Тогда
		Возврат СправочникСтавкаНДС;
	КонецЕсли;
	//-- Локализация
	
	Если ТипЗнч(СтавкаНДС) = Тип("Структура") Тогда
	
		СтавкаНДССтрокой = СтавкаНДС.Значение;
		Если СтавкаНДССтрокой = "БезНДС" Тогда 
			Возврат Справочники.СтавкиНДС.БезНДС;
		КонецЕсли;
	
		СтавкаНДССтрокой = СтрЗаменить(СтавкаНДССтрокой, "НДС", "");
		РасчетнаяСтавка = СтрНайти(СтавкаНДССтрокой, "_") > 0;
	
		Если РасчетнаяСтавка Тогда
			СтавкаНДССтрокой = СтрЗаменить(СтавкаНДССтрокой, "_", "/");
		Иначе
			СтавкаНДССтрокой = СтавкаНДССтрокой + "%";
		КонецЕсли;
	
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	СтавкиНДС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	СтавкиНДС.Наименование = &Наименование
		|	И СтавкиНДС.РасчетнаяСтавка = &РасчетнаяСтавка");
	
		Запрос.УстановитьПараметр("Наименование", СтавкаНДССтрокой);
		Запрос.УстановитьПараметр("РасчетнаяСтавка", РасчетнаяСтавка);
	
		Выборка = Запрос.Выполнить().Выбрать();
	
		Если Выборка.Следующий() Тогда
			СправочникСтавкаНДС = Выборка.Ссылка;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат СправочникСтавкаНДС;
КонецФункции
//++ Локализация
Функция СравнитьВерсии(СтрокаВерсии1,СтрокаВерсии2)
	// Сравнить две строки версий.
	//
	// Параметры:
	//  СтрокаВерсии1  - Строка - номер версии в формате РР.{П|ПП}.
	//  СтрокаВерсии2  - Строка - второй сравниваемый номер версии.
	//
	// Возвращаемое значение:
	//   Число   - больше 0, если СтрокаВерсии1 > СтрокаВерсии2; 0, если версии равны.
	//
	
	Строка1 = ?(ПустаяСтрока(СтрокаВерсии1), "0.0", СтрокаВерсии1);
	Строка2 = ?(ПустаяСтрока(СтрокаВерсии2), "0.0", СтрокаВерсии2);
	Версия1 = СтрРазделить(Строка1, ".");
	Если Версия1.Количество() <> 2 Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неправильный формат параметра СтрокаВерсии1: %1';
				|en = 'Invalid format of СтрокаВерсии1 parameter: %1.'"), СтрокаВерсии1);
	КонецЕсли;
	Версия2 = СтрРазделить(Строка2, ".");
	Если Версия2.Количество() <> 2 Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неправильный формат параметра СтрокаВерсии2: %1';
				|en = 'Invalid format of СтрокаВерсии2 parameter: %1.'"), СтрокаВерсии2);
	КонецЕсли;
	
	Результат = 0;
	Для Разряд = 0 По 1 Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
//-- Локализация
Функция СсылкаДляПолученияОбъектаРасчетов(СтруктураДанныхСтроки)
	СсылкаНаОбъект = Неопределено;
	
	ЗаполненДоговор = СтруктураДанныхСтроки.Свойство("Договор") 
		И СсылкаЗаполненаИСуществует(СтруктураДанныхСтроки.Договор);
	ЗаполненДокументРасчетов = СтруктураДанныхСтроки.Свойство("ДокументРасчетов") 
		И СсылкаЗаполненаИСуществует(СтруктураДанныхСтроки.ДокументРасчетов);
		
	Если ЗаполненДокументРасчетов Тогда
		
		ДокументРасчетов = СтруктураДанныхСтроки.ДокументРасчетов.ПолучитьОбъект();
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументРасчетов.Ссылка);
		ПараметрыМеханизма = МенеджерОбъекта.ПараметрыВзаиморасчеты(ДокументРасчетов);
		
		ДополненныеПараметрыМеханизма = ВзаиморасчетыСервер.ДополненныеПараметрыМеханизма(ДокументРасчетов, ПараметрыМеханизма);
		
		Для Каждого СтруктураПараметров Из ДополненныеПараметрыМеханизма.МассивПараметров Цикл
			
			ПорядокРасчетов = ОбщегоНазначенияУТКлиентСервер.ДанныеПоПути(ДокументРасчетов, СтруктураПараметров.ПорядокРасчетов, , Перечисления.ПорядокРасчетов.ПоНакладным);
			Договор = ОбщегоНазначенияУТКлиентСервер.ДанныеПоПути(ДокументРасчетов, СтруктураПараметров.Договор);
			
			Если ОбъектыРасчетовСервер.СсылкаЯвляетсяОбъектомРасчетов(ДокументРасчетов, СтруктураПараметров) Тогда
				СсылкаНаОбъект = ДокументРасчетов.Ссылка; 
			ИначеЕсли ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов
				И СсылкаЗаполненаИСуществует(Договор) Тогда
				СсылкаНаОбъект = Договор; 
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ЗаполненДоговор Тогда
		
		ПорядокРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураДанныхСтроки.Договор, "ПорядокРасчетов");
		
		Если (ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов
			Или ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамНакладным) Тогда
			
			СсылкаНаОбъект = СтруктураДанныхСтроки.Договор; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СсылкаНаОбъект;
КонецФункции
Функция СсылкаЗаполненаИСуществует(Ссылка)
	Возврат ЗначениеЗаполнено(Ссылка)
		И ОбщегоНазначения.СсылкаСуществует(Ссылка);
КонецФункции
Функция СсылкаНаДокументРасчетовИзДанныхXDTO(КомпонентыОбмена, ДанныеXDTO)
	ТипДокументаРасчетов = ДанныеXDTO.ТипЗначения;
	ДокументРасчетов     = Неопределено;
	ИмяПКО               = "";
	
	Если ТипДокументаРасчетов = "АвансовыйОтчет" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_АвансовыйОтчет_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "ВозвратТоваровОтПокупателя" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ВозвратТоваровОтПокупателя_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "ВозвратТоваровПоставщику" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ВозвратТоваровПоставщику_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "ЗаказКлиента" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ЗаказКлиента_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "ЗаказПоставщику" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ЗаказПоставщику_Получение";	
		
	ИначеЕсли ТипДокументаРасчетов = "КорректировкаДолга" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_СписаниеЗадолженности_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "КорректировкаПоступленияТоваров" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_КорректировкаПоступленияТоваров_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "КорректировкаРеализацииТоваров" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_КорректировкаРеализацииТоваров_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "ОперацияПоПлатежнойКарте" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ОперацияПоПлатежнойКарте_Получение";
	
	//++ Устарело_Переработка24	
	ИначеЕсли ТипДокументаРасчетов = "ОтчетДавальцу" Тогда // @Non-NLS-1
		// Не получаем
		
	//-- Устарело_Переработка24	
	ИначеЕсли ТипДокументаРасчетов = "ОтчетКомиссионера" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ОтчетКомиссионера_Получение";
	
	ИначеЕсли ТипДокументаРасчетов = "ОтчетКомитенту" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ОтчетКомитенту_Получение";
	
	//++ Устарело_Переработка24	
	ИначеЕсли ТипДокументаРасчетов = "ОтчетПереработчика" И НЕ ЭтоУТ() Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ОтчетПереработчика_Получение";
	//-- Устарело_Переработка24
	ИначеЕсли ТипДокументаРасчетов = "ПБДСРасчетыСКонтрагентами" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ПБДСРасчетыСКонтрагентами_Получение";
	
	ИначеЕсли ТипДокументаРасчетов = "ПКОРасчетыСКонтрагентами" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ПКОРасчетыСКонтрагентами_Получение";
	
	ИначеЕсли ТипДокументаРасчетов = "ПоступлениеТоваровУслуг" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ПоступлениеТоваровУслуг_Получение";
	
	ИначеЕсли ТипДокументаРасчетов = "РеализацияТоваровУслуг" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_РеализацияТоваровУслуг_Получение";
	
	ИначеЕсли ТипДокументаРасчетов = "РКОРасчетыСКонтрагентами" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_РКОРасчетыСКонтрагентами_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "СБДСРасчетыСКонтрагентами" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_СБДСРасчетыСКонтрагентами_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "ТаможеннаяДекларация" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ТаможеннаяДекларация_Получение";
	
	ИначеЕсли ТипДокументаРасчетов = "ИсходныйДокумент" Тогда // @Non-NLS-1
		ИмяПКО = "Документ_ПервичныйДокумент_Получение";
		
	ИначеЕсли ТипДокументаРасчетов = "Договор" Тогда // @Non-NLS-1
		Если Не ДанныеXDTO.Свойство("Ссылка") Тогда
			ИмяПКО = "Справочник_ДоговорыКонтрагентов_ИзСтруктуры_Получ";
		Иначе
			ИмяПКО = "Справочник_ДоговорыКонтрагентов_Получение";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяПКО) Тогда
		СтрокаПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, ИмяПКО);
		
		// Обход ошибки до версии ED 1.6
		// тип ссылки "КлючевыеСвойстваОтчетКомитенту" - ОтчетКомиссионера.
		Если Не (ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6")
		И (ТипДокументаРасчетов = "ОтчетКомитенту" ИЛИ ТипДокументаРасчетов = "ОтчетКомиссионера")
		И СтрНайти(СтрокаПКО.ОбъектФормата, ТипДокументаРасчетов) = 0) Тогда // @Non-NLS-2 @Non-NLS-3
		
			ДокументРасчетов = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена,
				ДанныеXDTO,
				СтрокаПКО,
				"ПолучитьСсылку");
			Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ДокументРасчетов)) Тогда
				ДокументРасчетов = ДокументРасчетов.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДокументРасчетов;
КонецФункции
Функция СтавкаНДСВСтрокуXDTO(СтавкаНДС, НДСПоСтавкам2и4)
	Если СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
		
		Возврат "БезНДС"; 
		
	КонецЕсли;  
	
	РеквизитыСтавкиНДС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтавкаНДС,  "Ставка, РасчетнаяСтавка");
	
	Если РеквизитыСтавкиНДС.Ставка = 0 Тогда
		
		Возврат "НДС0";
		
	КонецЕсли;
	
	//++ Локализация
	Если НДСПоСтавкам2и4 = Истина Тогда  
		
		ПеречислениеСтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтавкаНДС, "ПеречислениеСтавкаНДС");
		
		Если ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС18
			ИЛИ ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
			СтавкаНДС2и4Строкой = "НДС4";
		ИначеЕсли ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС18_118
			ИЛИ ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
			СтавкаНДС2и4Строкой = "НДС4_104";
		ИначеЕсли ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
			СтавкаНДС2и4Строкой = "НДС2";
		ИначеЕсли ПеречислениеСтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
			СтавкаНДС2и4Строкой = "НДС2_102";
		КонецЕсли;
		
		Возврат СтавкаНДС2и4Строкой;
		
	КонецЕсли;   
	//-- Локализация
	
	СоответствиеСтавок = Новый Соответствие;
	
	Если РеквизитыСтавкиНДС.РасчетнаяСтавка Тогда
		
		СоответствиеСтавок.Вставить(10, "НДС10_110");
		СоответствиеСтавок.Вставить(18, "НДС18_118");
		СоответствиеСтавок.Вставить(20, "НДС20_120");
		
	Иначе
		
		СоответствиеСтавок.Вставить(10, "НДС10");
		СоответствиеСтавок.Вставить(18, "НДС18");
		СоответствиеСтавок.Вставить(20, "НДС20");
		
	КонецЕсли;
	
	СтавкаНДССтрокой = СоответствиеСтавок.Получить(РеквизитыСтавкиНДС.Ставка);
	СтавкаНДССтрокой = ?(СтавкаНДССтрокой = Неопределено, "", СтавкаНДССтрокой);
	
	Возврат СтавкаНДССтрокой;
КонецФункции
//++ Локализация
Функция СтавкаНДСПоВидуСтавки(СтавкаНДСXDTO)
	// В объекте Справочник.СтавкиНДС свойство "Ставка" является необязательным
	// по этой причине сначала пытаемся определить ставку по свойству "ВидСтавки"
	
	СтавкаНДС = Неопределено;
	
	Если СтавкаНДСXDTO.Свойство("ВидСтавки") И ЗначениеЗаполнено(СтавкаНДСXDTO.ВидСтавки) Тогда
		
		СоответствиеВидовСтавокНДС = Новый Соответствие;
		
		СоответствиеВидовСтавокНДС.Вставить("Нулевая", Перечисления.СтавкиНДС.НДС0);
		СоответствиеВидовСтавокНДС.Вставить("БезНДС", Перечисления.СтавкиНДС.БезНДС);
		
		ПеречислениеПоСоответствию = СоответствиеВидовСтавокНДС[СтавкаНДСXDTO.ВидСтавки.Значение];
		
		Если ПеречислениеПоСоответствию <> Неопределено Тогда
			СтавкаНДС =  ?(ПеречислениеПоСоответствию = Перечисления.СтавкиНДС.БезНДС, Справочники.СтавкиНДС.БезНДС,
				УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(ПеречислениеПоСоответствию));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтавкаНДС;
КонецФункции
//-- Локализация
Функция СтавкаНДСПоСправочнику(СсылкаСтавкаНДС)
	Если Не ЗначениеЗаполнено(СсылкаСтавкаНДС) Тогда
		Возврат "БезНДС";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СтавкиНДС.Ссылка = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС)
		|			ТОГДА ""БезНДС""
		|		КОГДА СтавкиНДС.РасчетнаяСтавка
		|			ТОГДА ВЫБОР
		|					КОГДА СтавкиНДС.Ставка = 10
		|						ТОГДА ""НДС10_110""
		|					КОГДА СтавкиНДС.Ставка = 18
		|						ТОГДА ""НДС18_118""
		|					КОГДА СтавкиНДС.Ставка = 20
		|						ТОГДА ""НДС20_120""
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА СтавкиНДС.Ставка = 0
		|					ТОГДА ""НДС0""
		|				КОГДА СтавкиНДС.Ставка = 10
		|					ТОГДА ""НДС10""
		|				КОГДА СтавкиНДС.Ставка = 18
		|					ТОГДА ""НДС18""
		|				КОГДА СтавкиНДС.Ставка = 20
		|					ТОГДА ""НДС20""
		|			КОНЕЦ
		|	КОНЕЦ КАК Ставка
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	СтавкиНДС.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаСтавкаНДС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ставка;
	Иначе
		Возврат "БезНДС";
	КонецЕсли;
КонецФункции
//++ Локализация
Процедура СФВыданный_ВыгрузитьДокументыОснования(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетФактура", ДанныеИБ.Ссылка);
	
	Если НЕ ДанныеИБ.Корректировочный Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДокументОснование,
			|	Неопределено КАК ИсходныйДокумент
			|ИЗ 
			|	Документ.СчетФактураВыданный.ДокументыОснования
			|ГДЕ 
			|	Ссылка = &СчетФактура";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование,
			|	ЕСТЬNULL(СчетФактураВыданныйТовары.ПредыдущийСчетФактура, НЕОПРЕДЕЛЕНО) КАК ИсходныйДокумент
			|ИЗ
			|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.Товары КАК СчетФактураВыданныйТовары
			|		ПО СчетФактураВыданныйДокументыОснования.Ссылка = СчетФактураВыданныйТовары.Ссылка
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.Ссылка = &СчетФактура";
	КонецЕсли;
	
	ВыборкаТЧ = Запрос.Выполнить().Выбрать();
	
	ДокументыОснования = Новый ТаблицаЗначений();
	ДокументыОснования.Колонки.Добавить("ДокументОснование");
	ДокументыОснования.Колонки.Добавить("ИсходныйДокумент");
	
	Пока ВыборкаТЧ.Следующий() Цикл
		
		ДокументОснование = ВыборкаТЧ.ДокументОснование;
	
		ИмяПКО = ИмяПКОДляОбъектаДанных(КомпонентыОбмена, ДокументОснование, ДанныеИБ.Организация);
		
		Если НЕ (ЗначениеЗаполнено(ДокументОснование) И ЗначениеЗаполнено(ИмяПКО)) Тогда
			Продолжить;
		КонецЕсли;
			
		СтрокаОснование = ДокументыОснования.Добавить();
		СтрокаОснование.ДокументОснование = Новый Структура("Значение, ИмяПКО", ДокументОснование, ИмяПКО);
		Если ЗначениеЗаполнено(ВыборкаТЧ.ИсходныйДокумент) Тогда
			СтрокаОснование.ИсходныйДокумент = ВыборкаТЧ.ИсходныйДокумент;
		КонецЕсли;
	
	КонецЦикла;
	
	Если НЕ ДокументыОснования.Количество() = 0 Тогда
	     ДанныеXDTO.Вставить("ДокументыОснования", ДокументыОснования); 
	КонецЕсли;
КонецПроцедуры
//-- Локализация
Функция СчетУчетаПоСтатье(Статья, Организация = Неопределено, Подразделение = Неопределено, СчетУчета = Неопределено)
	Если Не ЗначениеЗаполнено(Статья) Тогда
		Возврат "";
	КонецЕсли;
	ИспользуютсяКорСчетаИзСтатей = ПолучитьФункциональнуюОпцию("УправлениеТорговлей")
		Или НЕ ПолучитьФункциональнуюОпцию("ИспользоватьРеглУчет") Или НЕ ПолучитьФункциональнуюОпцию("ЛокализацияРФ");
	
	//++ Локализация
	
	//++ НЕ УТ
	Если ТипЗнч(Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиАктивовПассивов") Тогда
		// Счет может указываться непосредственно в документе.
	    Если ЗначениеЗаполнено(СчетУчета)
			И ТипЗнч(СчетУчета) = Тип("ПланСчетовСсылка.Хозрасчетный") Тогда
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета, "Код");
		КонецЕсли;
	КонецЕсли;
	//-- НЕ УТ
	
	//-- Локализация
	Если ТипЗнч(Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов")
		Или ТипЗнч(Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
		
		Если ИспользуютсяКорСчетаИзСтатей Тогда
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Статья, "КорреспондирующийСчет");
		//++ Локализация
		
		//++ НЕ УТ
		Иначе
			СтруктураИзмерений = НастройкаСчетовУчетаКлиентСервер.ИнициализироватьСтруктуруИзмеренийРегистра();
			СтруктураИзмерений.Организация    = Организация;
			СтруктураИзмерений.МестоУчета     = Подразделение;
			Если ТипЗнч(Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") Тогда
				СтруктураИзмерений.АналитикаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Статья, "ГруппаФинансовогоУчета");
			Иначе
				СтруктураИзмерений.АналитикаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Статья, "ГруппаФинансовогоУчетаРегл");
			КонецЕсли;
			
			Если ТипЗнч(Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
				СчетУчетаПоРазделу = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.НастройкаОтраженияРаздела("Расходы", СтруктураИзмерений, "Расходы");
				Если ЗначениеЗаполнено(СчетУчетаПоРазделу) И СчетУчетаПоРазделу.Свойство("Расходы") Тогда 
					Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчетаПоРазделу.Расходы, "Код");
				КонецЕсли;
			Иначе
				СчетУчетаПоРазделу = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.НастройкаОтраженияРаздела("Доходы", СтруктураИзмерений, "Доходы");
				Если ЗначениеЗаполнено(СчетУчетаПоРазделу) И СчетУчетаПоРазделу.Свойство("Доходы") Тогда 
					Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчетаПоРазделу.Доходы, "Код");
				КонецЕсли;
			КонецЕсли;
		//-- НЕ УТ
		
		//-- Локализация
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";
КонецФункции
Функция СчетУчетаРасчетовПрочихОперацийДДС(СтруктураПараметров)
	СтатьяДоходовРасходов = Неопределено;
	СтруктураПараметров.Свойство("СтатьяДоходовРасходов", СтатьяДоходовРасходов);
	
	Организация = Неопределено;
	СтруктураПараметров.Свойство("Организация", Организация);
	
	Подразделение = Неопределено;
	СтруктураПараметров.Свойство("Подразделение", Подразделение);
	
	Если ЗначениеЗаполнено(СтатьяДоходовРасходов) Тогда
		СчетУчета = СчетУчетаПоСтатье(СтатьяДоходовРасходов, Организация, Подразделение, "");
		Если ЗначениеЗаполнено(СчетУчета) Тогда
			Возврат СчетУчета; 
		КонецЕсли;
	КонецЕсли;
	
	СтатьяДДС = Неопределено;
	СтруктураПараметров.Свойство("СтатьяДДС", СтатьяДДС);
	
	Если ЗначениеЗаполнено(СтатьяДДС) Тогда
		ИспользуютсяКорСчетаИзСтатей = ПолучитьФункциональнуюОпцию("УправлениеТорговлей")
			Или НЕ ПолучитьФункциональнуюОпцию("ИспользоватьРеглУчет") Или НЕ ПолучитьФункциональнуюОпцию("ЛокализацияРФ");
		Если ИспользуютсяКорСчетаИзСтатей Тогда
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтатьяДДС, "КорреспондирующийСчет"); 
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
КонецФункции
Процедура ТаблицаОстатковПоРасчетамСКонтрагентами(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, ВидДоговораПоУмолчанию)
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВводОстатковРасчетыСПартнерами.Контрагент КАК Контрагент,
		|	ВводОстатковРасчетыСПартнерами.Сумма КАК Сумма,
		|	ВводОстатковРасчетыСПартнерами.СуммаРегл КАК СуммаРегл,
		|	ВЫБОР
		|		КОГДА ВводОстатковРасчетыСПартнерами.ОбъектРасчетов ССЫЛКА Справочник.ДоговорыКонтрагентов
		|			И ВводОстатковРасчетыСПартнерами.ОбъектРасчетов.ТипДоговора = &ТипДоговора
		|			ТОГДА ВводОстатковРасчетыСПартнерами.ОбъектРасчетов
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ОбъектКакДоговор,
		|	ВЫБОР
		|		КОГДА ВводОстатковРасчетыСПартнерами.ОбъектРасчетов ССЫЛКА Справочник.ДоговорыКонтрагентов
		|			ТОГДА ВводОстатковРасчетыСПартнерами.ОбъектРасчетов.Валюта <> ВводОстатковРасчетыСПартнерами.Ссылка.Организация.ВалютаРегламентированногоУчета И НЕ ВводОстатковРасчетыСПартнерами.ОбъектРасчетов.ОплатаВВалюте
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РасчетыВУсловныхЕдиницах,
		|	ВводОстатковРасчетыСПартнерами.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
		|	КурсыВалютСрезПоследних.КурсЧислитель КАК КурсВзаиморасчетов,
		|	КурсыВалютСрезПоследних.КурсЗнаменатель КАК КратностьВзаиморасчетов,
		|	&ТекстЗапросаДокументРасчетов КАК ДокументРасчетов
		|ИЗ
		|	Документ.ВводОстатковВзаиморасчетов.РасчетыСПартнерами КАК ВводОстатковРасчетыСПартнерами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтносительныеКурсыВалют.СрезПоследних(&ДатаСреза, БазоваяВалюта = &БазоваяВалюта) КАК КурсыВалютСрезПоследних
		|		ПО ВводОстатковРасчетыСПартнерами.ВалютаВзаиморасчетов = КурсыВалютСрезПоследних.Валюта
		|ГДЕ
		|	ВводОстатковРасчетыСПартнерами.Ссылка = &Ссылка";
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7") Тогда
		ТекстЗапросаДокументРасчетов = "ВводОстатковРасчетыСПартнерами.ДокументРасчетов";
	Иначе
		ТекстЗапросаДокументРасчетов = "Неопределено";
	КонецЕсли;
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаДокументРасчетов",
		ТекстЗапросаДокументРасчетов);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",    ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ДатаСреза", ДанныеИБ.Дата);
	Запрос.УстановитьПараметр("БазоваяВалюта", ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ДанныеИБ.Организация));
	Если ВидДоговораПоУмолчанию = "СПокупателем" Тогда
		ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
	Иначе
		ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипДоговора", ТипДоговора);
	ТаблицаРасчеты = Запрос.Выполнить().Выгрузить();
	ТаблицаРасчеты.Колонки.Добавить("Договор");
	
	Для Каждого СтрокаРасчеты Из ТаблицаРасчеты Цикл
	
		Если ЗначениеЗаполнено(СтрокаРасчеты.ОбъектКакДоговор) Тогда
			СтрокаРасчеты.Договор = СтрокаРасчеты.ОбъектКакДоговор;
		Иначе
	
			Если ТипЗнч(СтрокаРасчеты.Контрагент) = Тип("СправочникСсылка.Организации") Тогда	
				СтрокаРасчеты.Контрагент = КонтрагентИзОрганизации(СтрокаРасчеты.Контрагент, КомпонентыОбмена);
			КонецЕсли;
		
			ПараметрыПоУмолчанию = Новый Структура(ДоговорФиксированнаяСтруктураКлючей());
			ПараметрыПоУмолчанию.Организация              = ДанныеИБ.Организация;
			ПараметрыПоУмолчанию.Контрагент               = СтрокаРасчеты.Контрагент;
			ПараметрыПоУмолчанию.РасчетыВУсловныхЕдиницах = Ложь;
			ПараметрыПоУмолчанию.ВалютаВзаиморасчетов     = СтрокаРасчеты.ВалютаВзаиморасчетов;
			ПараметрыПоУмолчанию.ВидДоговора              = ВидДоговораПоУмолчанию;
			
			СтрокаРасчеты.Договор = ДоговорИнструкцияКонвертацииПоДаннымВзаиморасчетов(ПараметрыПоУмолчанию, КомпонентыОбмена);
			
		КонецЕсли;
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Расчеты", ТаблицаРасчеты);
КонецПроцедуры
Процедура ТаблицаОстатковПоРасчетамСПодотчетниками(ДанныеИБ, ДанныеXDTO)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВводОстатковРасчетыСПодотчетниками.ПодотчетноеЛицо КАК ФизическоеЛицо,
	|	ВводОстатковРасчетыСПодотчетниками.Валюта КАК ВалютаВзаиморасчетов,
	|	ВводОстатковРасчетыСПодотчетниками.Сумма КАК Сумма,
	|	ВводОстатковРасчетыСПодотчетниками.СуммаРегл КАК СуммаРегл
	|ИЗ
	|	Документ.ВводОстатковСПодотчетниками.РасчетыСПодотчетниками КАК ВводОстатковРасчетыСПодотчетниками
	|ГДЕ
	|	ВводОстатковРасчетыСПодотчетниками.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	ТаблицаРасчеты = Запрос.Выполнить().Выгрузить();
	
	ДанныеXDTO.Вставить("Расчеты", ТаблицаРасчеты);
КонецПроцедуры
Функция ТаблицаСБДСПолучитьИзПараметров(КомпонентыОбмена)
	ТаблицаСБДС = КомпонентыОбмена.ПараметрыКонвертации.ТаблицаСБДСДляСозданияКонтрагентов;
	Если ТаблицаСБДС = Неопределено Тогда
		ТаблицаСБДС = Новый ТаблицаЗначений;
		ТаблицаСБДС.Колонки.Добавить("ДокументСсылка");
		ТаблицаСБДС.Колонки.Добавить("ФизическоеЛицо");
		ТаблицаСБДС.Колонки.Добавить("БанковскийСчет");
		КомпонентыОбмена.ПараметрыКонвертации.ТаблицаСБДСДляСозданияКонтрагентов = ТаблицаСБДС;
	КонецЕсли;
	
	Возврат ТаблицаСБДС;
КонецФункции
Процедура ТаблицаУслугЗаполнитьПринципала(КомпонентыОбмена, ТабУслуги)
	ТабУслуги.Колонки.Добавить("Принципал");
	Для Каждого СтрокаУслуги Из ТабУслуги Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаУслуги.ПринципалСсылка) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(СтрокаУслуги.ПринципалСсылка) = Тип("СправочникСсылка.Организации") Тогда
			СтрокаУслуги.Принципал = КонтрагентИзОрганизации(СтрокаУслуги.ПринципалСсылка, КомпонентыОбмена);
		ИначеЕсли ТипЗнч(СтрокаУслуги.ПринципалСсылка) = Тип("СправочникСсылка.Партнеры") Тогда
			СтрокаУслуги.Принципал = ПартнерыИКонтрагенты.ПолучитьКонтрагентаПартнераПоУмолчанию(СтрокаУслуги.ПринципалСсылка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Функция ТекстЗапросаSKUКонтрагента(КомпонентыОбмена, ИмяТаблицы, ВыгружатьSKUКонтрагента = Истина)
	Если Не ВыгружатьSKUКонтрагента Тогда
		Возврат "Неопределено КАК SKUКонтрагентаСсылка";
	КонецЕсли;
	
	ТекстЗапроса = 
	"	&ИмяТаблицы.SKUКонтрагента КАК SKUКонтрагентаСсылка,
	|	&ИмяТаблицы.SKUКонтрагента.Владелец КАК SKUКонтрагентаВладелец,		
	|	&ИмяТаблицы.SKUКонтрагента.Наименование КАК SKUКонтрагентаНаименование,	
	|	&ИмяТаблицы.SKUКонтрагента.Артикул КАК SKUКонтрагентаАртикул,
	|	&ИмяТаблицы.SKUКонтрагента.Штрихкод КАК SKUКонтрагентаШтрихкод,	
	|	&ИмяТаблицы.SKUКонтрагента.Идентификатор КАК SKUКонтрагентаИдентификатор,	
	|	&ИмяТаблицы.SKUКонтрагента.ИдентификаторНоменклатурыСервиса КАК SKUКонтрагентаИдентификаторНоменклатурыСервиса,	
	|	&ИмяТаблицы.SKUКонтрагента.ИдентификаторХарактеристикиСервиса КАК SKUКонтрагентаИдентификаторХарактеристикиСервиса,
	|	&ИмяТаблицы.SKUКонтрагента.НаименованиеБазовойЕдиницыИзмерения КАК SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения,
	|	&ИмяТаблицы.SKUКонтрагента.КодОКЕИБазовойЕдиницыИзмерения КАК SKUКонтрагентаКодОКЕИБазовойЕдиницыИзмерения,
	|	&ИмяТаблицы.SKUКонтрагента.КоличествоБазовойЕдиницыИзмерения КАК SKUКонтрагентаКоличествоБазовойЕдиницыИзмерения,
	|	&ИмяТаблицы.SKUКонтрагента.НаименованиеУпаковки КАК SKUКонтрагентаНаименованиеУпаковки,
	|	&ИмяТаблицы.SKUКонтрагента.КоличествоУпаковок КАК SKUКонтрагентаКоличествоУпаковок";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", ИмяТаблицы);
	
	Возврат ТекстЗапроса;
КонецФункции
Функция ТекстЗапросаПризнаватьРасходамиПриУСН(КомпонентыОбмена, ИмяТаблицы, ПрименяетсяУСНДоходыМинусРасходы)
	ТекстЗапроса = "НЕОПРЕДЕЛЕНО КАК ВключатьРасходыВУСН";
	
	Если ПрименяетсяУСНДоходыМинусРасходы
		И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.19") Тогда
		
		ТекстЗапроса = "ВЫРАЗИТЬ(&Источник.СтатьяРасходов КАК ПланВидовХарактеристик.СтатьиРасходов).ПризнаватьРасходамиПриУСН КАК ВключатьРасходыВУСН";   
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Источник", ИмяТаблицы);
	
	Возврат ТекстЗапроса;
КонецФункции
Функция ТипНалогообложенияВалиден(ЗакупкаПодДеятельность = Неопределено,НалогообложениеНДС, ВерсияФорматаОбмена)
	НалогообложениеМассив = Новый Массив;
	НалогообложениеМассив.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.Космос"));
	НалогообложениеМассив.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДССМежценовойРазницы"));
	ТипНалогообложенияВалиден = (НалогообложениеМассив.Найти(НалогообложениеНДС) = Неопределено); 
	
	Если НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаПоПатенту Тогда
	    ТипНалогообложенияВалиден =  ВерсияФорматаЧислом(ВерсияФорматаОбмена) > ВерсияФорматаЧислом("1.11");
	КонецЕсли;
	Если Не ЗакупкаПодДеятельность = Неопределено Тогда
	     ТипНалогообложенияВалиден = ЗакупкаПодДеятельность <> ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.Космос");
	КонецЕсли;
	Возврат ТипНалогообложенияВалиден;
КонецФункции
Функция УправленческаяОрганизация()
	Возврат ПредопределенноеЗначение("Справочник.Организации.УправленческаяОрганизация");
КонецФункции
Процедура УстановитьИспользованиеПКО(ИспользованиеПКО, Режим)
	Для Каждого Правило Из ИспользованиеПКО Цикл
		ИспользованиеПКО[Правило.Ключ] = Режим;
	КонецЦикла;
КонецПроцедуры
//++ Локализация
Процедура УстановитьОрганизациюВВышестоящееПодразделениеXDTO(ДанныеXDTO, ОрганизацияXDTO)
	ПодразделениеXDTO = Неопределено;
	ДанныеXDTO.Свойство("ВышестоящееПодразделение", ПодразделениеXDTO);
	Если ЗначениеЗаполнено(ПодразделениеXDTO)
		И ЗначениеЗаполнено(ОрганизацияXDTO) Тогда
	
		ПодразделениеXDTO.Вставить("Организация", ОрганизацияXDTO);
		
		УстановитьОрганизациюВВышестоящееПодразделениеXDTO(ПодразделениеXDTO, ОрганизацияXDTO);	
		
	КонецЕсли;
КонецПроцедуры
//-- Локализация
Процедура УстановитьОтменуМеханическойЧисткиДвижений(ДокументОбъект)
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	Если МетаданныеДокумента.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("ИспользоватьОтменуПроведенияДляОчисткиДвижений", Истина);
	КонецЕсли
КонецПроцедуры
Процедура УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена, ИмяПКО, ИмяТЧ, ИмяСвойства, ИскатьВИменахФормата, ИмяНовогоПКС)
	СтрокаПравилКонвертации = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти(ИмяПКО, "ИмяПКО");
	
	Если ИскатьВИменахФормата Тогда
		СвойствоТЧ = СтрокаПравилКонвертации.СвойстваТабличныхЧастей.Найти(ИмяТЧ, "ТЧФормата");
		СтрокаСвойствТЧ = СвойствоТЧ.Свойства.Найти(ИмяСвойства, "СвойствоФормата");
	Иначе
		СвойствоТЧ = СтрокаПравилКонвертации.СвойстваТабличныхЧастей.Найти(ИмяТЧ, "ТЧКонфигурации");
		СтрокаСвойствТЧ = СвойствоТЧ.Свойства.Найти(ИмяСвойства, "СвойствоКонфигурации");
	КонецЕсли;
	
	СтрокаСвойствТЧ.ПравилоКонвертацииСвойства = ИмяНовогоПКС;
КонецПроцедуры
Процедура УстановитьРежимПроведенияДокументовУТКАУП(УдаляемыйОбъект)
	МассивТиповОтменаПроведения = Новый Массив; 
