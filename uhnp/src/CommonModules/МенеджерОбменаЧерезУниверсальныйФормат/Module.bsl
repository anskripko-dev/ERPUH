Процедура ОтложеннаяОбработка_ОтражениеЗарплатывФинУчете(Объект, КомпонентыОбмена)
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПроверкуФинансовыхДокументов") Тогда
	
		Запись = РегистрыСведений.СтатусыПроверкиДокументов.СоздатьМенеджерЗаписи();
	
		Запись.Период = Объект.Дата;
		Запись.Документ = Объект.Ссылка;
		Запись.Организация = Объект.Организация;
		Запись.Прочитать();
	
		Если Запись.Выбран() Тогда
			Запись.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиФинансовыхДокументов.КПовторнойПроверке");
	    	Попытка
	    		Запись.Записать();
	    	Исключение
	    	КонецПопытки;
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры
