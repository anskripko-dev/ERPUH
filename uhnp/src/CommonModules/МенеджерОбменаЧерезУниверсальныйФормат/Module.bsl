	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_Организации_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.Организации"; //@NON-NLS-1
	ПравилоОбработки.ПриОбработке            = "ПОД_Справочник_Организации_Получение_ПриОбработке";
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_Организации_Получение");
КонецПроцедуры
Процедура ПОД_Справочник_Организации_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	Если СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации() Тогда
		ЭтоОрганизацияПоУмолчанию = Ложь;    
		ИНН =  ДанныеXDTO.КлючевыеСвойства.ИНН;
		КПП =  ДанныеXDTO.КлючевыеСвойства.КПП; 
		Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
			КлючевыеСвойства = ДанныеXDTO.КлючевыеСвойства; // Структура 
		Иначе КлючевыеСвойства = Неопределено
		КонецЕсли;
		Если КлючевыеСвойства <> Неопределено И КлючевыеСвойства.Свойство("НаименованиеСокращенное") Тогда
			НаименованиеСокращенное = КлючевыеСвойства.НаименованиеСокращенное; // Строка
		Иначе
			НаименованиеСокращенное = КлючевыеСвойства.Наименование; // Строка
		КонецЕсли;
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.КПП = &КПП
		|	И Организации.ИНН = &ИНН
		|	И Организации.НаименованиеСокращенное = &НаименованиеСокращенное";
		
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Запрос.УстановитьПараметр("НаименованиеСокращенное", НаименованиеСокращенное);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ЭтоОрганизацияПоУмолчанию = Истина;
		КонецЕсли;
		
		Если Не ЭтоОрганизацияПоУмолчанию Тогда
			ОчиститьИспользованиеПКО(ИспользованиеПКО); 
			Если КлючевыеСвойства <> Неопределено Тогда  
	
				Наименование = КлючевыеСвойства.Наименование;
			Иначе
				Наименование = "";
			КонецЕсли;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Объект: %1 не записан. В базовой версии учет ведется только по одной организации.';
																						|en = 'The %1 object is not saved. In the base version, accounting is kept for one company only.'"), Наименование);
			ОбменДаннымиXDTOСервер.ЗаписьЖурналаРегистрацииОбменДанными(ТекстОшибки, КомпонентыОбмена, , Наименование);
			КомпонентыОбмена.ФлагОшибки = Истина;
			КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Ошибка;
			ВызватьИсключение(ТекстОшибки);
			
		КонецЕсли;  
	КонецЕсли;
КонецПроцедуры

