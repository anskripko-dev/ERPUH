Процедура ПКО_Справочник_ГруппыФинУчетаНоменклатуры_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	//++ НЕ УТ
	
	//++ Локализация
	СчетаДляЗаполнения = Новый Структура;
	СчетаДляЗаполнения.Вставить("СчетУчетаВПути",               Перечисления.ВидыСчетовРеглУчета.РеализацияБезПереходаПраваСобственности);
	СчетаДляЗаполнения.Вставить("СчетУчетаВыручкиОтПродаж",     Перечисления.ВидыСчетовРеглУчета.ВыручкаОтПродаж);
	СчетаДляЗаполнения.Вставить("СчетУчетаНаСкладе",            Перечисления.ВидыСчетовРеглУчета.НаСкладе);
	СчетаДляЗаполнения.Вставить("СчетУчетаНДСВПути",            Перечисления.ВидыСчетовРеглУчета.НДСПриОтгрузкеБезПереходаПраваСобственности);
	СчетаДляЗаполнения.Вставить("СчетУчетаНДСПриЗакупке",       Перечисления.ВидыСчетовРеглУчета.НДСПриЗакупке);
	СчетаДляЗаполнения.Вставить("СчетУчетаНДСПриПродаже",       Перечисления.ВидыСчетовРеглУчета.НДСПриПродаже);
	СчетаДляЗаполнения.Вставить("СчетУчетаПередачиНаКомиссию",  Перечисления.ВидыСчетовРеглУчета.НоменклатураПереданная);
	СчетаДляЗаполнения.Вставить("СчетУчетаСебестоимостиПродаж", Перечисления.ВидыСчетовРеглУчета.СебестоимостьПродаж);
	
	СчетаУчета = Новый Соответствие;
	Для Каждого СчетДляЗаполнения Из СчетаДляЗаполнения Цикл
		Если ДанныеXDTO.Свойство(СчетДляЗаполнения.Ключ) И ЗначениеЗаполнено(ДанныеXDTO[СчетДляЗаполнения.Ключ]) Тогда
			СчетаУчета.Вставить(СчетДляЗаполнения.Значение, ДанныеXDTO[СчетДляЗаполнения.Ключ]);		
		КонецЕсли;
	КонецЦикла;
	ПолученныеДанные.ДополнительныеСвойства.Вставить("СчетаУчета", СчетаУчета);
	//-- Локализация
	
	//-- НЕ УТ
КонецПроцедуры
Процедура ПКО_Справочник_ГруппыФинУчетаНоменклатуры_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	//++ НЕ УТ
	
	//++ Локализация
	СчетаУчета = ПолученныеДанные.ДополнительныеСвойства.СчетаУчета;
	
	Для Каждого СчетУчета Из СчетаУчета Цикл
	
		ПорядокОтраженияНаСчетахУчета = КомпонентыОбмена.ПараметрыКонвертации.ПорядокОтраженияНаСчетахУчета; // ТаблицаЗначений
		НоваяСтрока = ПорядокОтраженияНаСчетахУчета.Добавить();
		НоваяСтрока.ВидСчета       = СчетУчета.Ключ;
		НоваяСтрока.Организация    = Справочники.Организации.ПустаяСсылка();
		НоваяСтрока.АналитикаУчета = ?(ДанныеИБ = Неопределено, 
														ПолученныеДанные.ПолучитьСсылкуНового(), 
														ДанныеИБ.Ссылка);
		НоваяСтрока.СчетУчета      = БухгалтерскийСчетПоКоду(СчетУчета.Значение);
		
	КонецЦикла;
	//-- Локализация
	
	//-- НЕ УТ
КонецПроцедуры

