Процедура ПОД_Документ_РеализацияТоваровУслуг_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ОчиститьИспользованиеПКО(ИспользованиеПКО);
	
	// Реализация товаров могла быть выгружена из корректировки реализации,
	// проверим существование ссылки.
	Если НЕ ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.КорректировкаРеализации") = Неопределено Тогда
		Возврат;
	ИначеЕсли ДанныеXDTO.Свойство("ВидОперации") И ДанныеXDTO.ВидОперации.Значение = "ПередачаНаКомиссию" 	
		И (КомпонентыОбмена.ПараметрыКонвертации.ТолькоКомиссионныеПродажи25 
			Или ПолучитьСсылкуПоИдентификатору(ДанныеXDTO, "Документ.ПередачаТоваровХранителю") <> Неопределено) Тогда
		ИспользованиеПКО.Вставить("Документ_ПередачаТоваров_Реализация_Получение", Истина);
	Иначе
		ИспользованиеПКО.Вставить("Документ_РеализацияТоваровУслуг_Получение", Истина);
	КонецЕсли;
КонецПроцедуры

