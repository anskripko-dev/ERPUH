Процедура ДобавитьПОД_Документ_НачислениеЕНП_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_НачислениеЕНП_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.НачислениеЕНП;
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_НачислениеЕНП_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_НачислениеЕНП_Отправка");
КонецПроцедуры
Процедура ПОД_Документ_НачислениеЕНП_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.РегистрацияВНалоговомОргане.КодПоОКТМО КАК КодПоОКТМО,
		|	Организации.КодНалоговогоОргана
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл 
		Если ПустаяСтрока(Выборка.КодПоОКТМО) ИЛИ ПустаяСтрока(Выборка.КодНалоговогоОргана) Тогда
			УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
			ТекстОшибки = НСтр("ru = 'У документа ""%1"" не заполнен реквизит ""%2"".
					|Документ ""%1"" не выгружен.';
					|en = 'The ""%2"" attribute is not filled in the ""%1"" document.
					|The ""%1"" document is not exported.'", ОбщегоНазначения.КодОсновногоЯзыка());
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					Строка(ДанныеИБ.Ссылка), "Код по ОКТМО или код налогового органа");
			ЗаписатьОшибкуВЖурналРегистрации(ДанныеИБ.Ссылка, ТекстОшибки, КомпонентыОбмена,, УровеньЖурналаРегистрации.Предупреждение);
			РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(
					ДанныеИБ.Ссылка,
					КомпонентыОбмена.УзелКорреспондента,
					ТекстОшибки,
					Перечисления.ТипыПроблемОбменаДанными.НезаполненныеРеквизиты); 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

