Процедура ПКО_Документ_СБДСПрочееСписание_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ПривестиНомерКФормату11(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ПодразделениеИБ = ДанныеИБ["Подразделение"];
	Если ЗначениеЗаполнено(ПодразделениеИБ) Тогда
		ВыгрузитьПодразделение(ДанныеИБ, ДанныеXDTO, ПодразделениеИБ, "Подразделение");
	Иначе
		ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, "БанковскийСчет");
	КонецЕсли;
	
	ЗаполнитьДанныеВходящегоДокументаСБДС(ДанныеИБ, ДанныеXDTO);
	ДанныеШапки = ДанныеИБ.ДополнительныеСвойства.ДанныеШапки;
	ДанныеXDTO.Вставить("ВидОперации", ДанныеШапки.ВидОперацииПрочее);
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7")
		И ЗначениеЗаполнено(ДанныеИБ.ЗаявкаНаРасходованиеДенежныхСредств) Тогда
		ДанныеXDTO.Вставить("ЗаявкаНаРасходДенежныхСредств", ДанныеИБ.ЗаявкаНаРасходованиеДенежныхСредств);
	КонецЕсли;
	
	ТабРасшифровка = Новый ТаблицаЗначений;
	ТабРасшифровка.Колонки.Добавить("СтатьяДДС");
	ТабРасшифровка.Колонки.Добавить("Сумма");
	ТабРасшифровка.Колонки.Добавить("СчетУчетаРасчетов");
	
	СчетРасчетов = "";
	//++ Локализация
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СнятиеНаличныхДенежныхСредств Тогда
		СчетРасчетов = "57.01";
	//++ НЕ УТ
	ИначеЕсли НЕ ЭтоУТ() И ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств Тогда
	
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	НастройкиПоАналитике.СчетУчета.Код КАК СчетУчетаРасчетов
			|ИЗ
			|	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК НастройкиПоАналитике
			|ГДЕ
			|	НастройкиПоАналитике.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ДенежныеСредства)
			|	И НастройкиПоАналитике.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|	И НастройкиПоАналитике.АналитикаУчета = &Ссылка
			|	И НастройкиПоАналитике.МестоУчета = НЕОПРЕДЕЛЕНО");
		
		Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.БанковскийСчетПолучатель);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СчетРасчетов = Выборка.СчетУчетаРасчетов;
		КонецЕсли;
	//-- НЕ УТ
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеНаДепозиты Тогда
		Если ДанныеИБ.Валюта = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ДанныеИБ.Организация) Тогда
			СчетРасчетов = "55.03";
		Иначе
			СчетРасчетов = "55.23";
		КонецЕсли; 	
	
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаЗаймаСотруднику Тогда
		СчетРасчетов = "73.01";
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику Тогда
		СчетРасчетов = "71.01";
	КонецЕсли;
	//-- Локализация	
	
	Инструкция = Неопределено;
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств Тогда
		Инструкция = Новый Структура("Значение, ИмяПКО", ДанныеИБ.БанковскийСчетПолучатель, "Справочник_БанковскиеСчетаОрганизаций_Отправка");
	Иначе
		Инструкция = Новый Структура("Значение, ИмяПКО", ДанныеИБ.БанковскийСчетКонтрагента, "Справочник_БанковскиеСчетаКонтрагентов_Отправка");
	КонецЕсли;
	
	ДанныеXDTO.Вставить("БанковскийСчет", Инструкция);
	
	Если ДанныеИБ.РасшифровкаПлатежа.Количество() > 0 Тогда
		Для Каждого Строка Из ДанныеИБ.РасшифровкаПлатежа Цикл
			
			НоваяСтрока = ТабРасшифровка.Добавить();
			Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств Тогда
				НоваяСтрока.СтатьяДДС = ДанныеИБ.СтатьяДвиженияДенежныхСредств;
			Иначе
				НоваяСтрока.СтатьяДДС = Строка.СтатьяДвиженияДенежныхСредств;
			КонецЕсли;
			НоваяСтрока.Сумма = Строка.Сумма;
			// Выгружается документ с операцией "ПрочаяВыдачаДенежныхСредств",
			// в котором указаны только статьи активов/пассивов.
			Если КомпонентыОбмена.ПараметрыКонвертации.ИспользуютсяКорСчетаИзСтатей Тогда
				НоваяСтрока.СчетУчетаРасчетов = СчетУчетаРасчетовПрочихОперацийДДС(Новый Структура("СтатьяДДС", Строка.СтатьяДвиженияДенежныхСредств));
			КонецЕсли;
			Если ЗначениеЗаполнено(СчетРасчетов) И НЕ ЗначениеЗаполнено(НоваяСтрока.СчетУчетаРасчетов) Тогда
				НоваяСтрока.СчетУчетаРасчетов = СчетРасчетов;
			КонецЕсли;
		//++ НЕ УТ
	
		//++ Локализация
			Если Не ЗначениеЗаполнено(НоваяСтрока.СчетУчетаРасчетов) Тогда
				НоваяСтрока.СчетУчетаРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.НастройкаСчетовУчета, "СчетУчета.Код"); 
			КонецЕсли;
		//-- Локализация
	
		//-- НЕ УТ
	
		КонецЦикла;
	Иначе
	
		НоваяСтрока = ТабРасшифровка.Добавить();
		НоваяСтрока.СтатьяДДС         = ДанныеИБ.СтатьяДвиженияДенежныхСредств;
		НоваяСтрока.Сумма             = ДанныеИБ.СуммаДокумента;
		Если КомпонентыОбмена.ПараметрыКонвертации.ИспользуютсяКорСчетаИзСтатей Тогда
			НоваяСтрока.СчетУчетаРасчетов = СчетУчетаРасчетовПрочихОперацийДДС(Новый Структура("СтатьяДДС", ДанныеИБ.СтатьяДвиженияДенежныхСредств));
		ИначеЕсли ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетУчетаРасчетов = СчетРасчетов;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("РасшифровкаПлатежа", ТабРасшифровка);
	
	Если ЗначениеЗаполнено(ДанныеИБ.КодВидаДохода) Тогда
		ДанныеXDTO.Вставить("КодВидаДохода", ДанныеИБ.КодВидаДохода);
	КонецЕсли;
КонецПроцедуры

