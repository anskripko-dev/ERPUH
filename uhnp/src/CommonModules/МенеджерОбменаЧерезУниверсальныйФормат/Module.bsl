	ВалютаРеглУчета = ВалютаРегламентированногоУчета(ДанныеИБ.Организация);
	ДанныеXDTO.Вставить("Валюта", ВалютаРеглУчета);
	
	#Область ВедомостьНаВыплату
	
	ИмяПКО = "";
	
	Если ТипЗнч(ДанныеИБ.Ведомость) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыРаздатчиком") Тогда
		ИмяПКО = "Документ_ВедомостьНаВыплатуЗарплатыРаздат_Отправка";
		
	ИначеЕсли ТипЗнч(ДанныеИБ.Ведомость) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыВКассу") Тогда
		ИмяПКО = "Документ_ВедомостьНаВыплатуЗарплатыВКассу_Отправка";	
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяПКО) Тогда
		
		ИнструкцияВедомостьНаВыплату = Новый Структура;
		ИнструкцияВедомостьНаВыплату.Вставить("ИмяПКО", ИмяПКО);
		ИнструкцияВедомостьНаВыплату.Вставить("Значение", ДанныеИБ.Ведомость);
		ДанныеXDTO.Вставить("ВедомостьНаВыплату", ИнструкцияВедомостьНаВыплату);
		
	КонецЕсли;
	
	#КонецОбласти
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина);
КонецПроцедуры

