Процедура ПКО_РегистрСведений_НастройкиУчетаНДСПриУСН_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Организация = ДанныеИБ.Отбор.Организация.Значение;
	Период = ДанныеИБ.Отбор.Период.Значение; 
	
	ДанныеXDTO.Вставить("ПериодОтбор", Период);
	ДанныеXDTO.Вставить("ОрганизацияОтбор", Организация);
	
	СистемаНалогообложения = ПолучитьСистемуНалогообложения(Организация, Период, Ложь); 
	
	ЗаписиНабора = ДанныеИБ.Выгрузить();
	
	Записи = Новый ТаблицаЗначений;
	
	Записи.Колонки.Добавить("СистемаНалогообложения");
	Записи.Колонки.Добавить("СтавкаНДС");
	
	Для Каждого СтрокаНабора Из ЗаписиНабора Цикл
	
		СтрокаЗаписи = Записи.Добавить();
		
		СтрокаЗаписи.СистемаНалогообложения = СистемаНалогообложения;	
		СтрокаЗаписи.СтавкаНДС = СтрокаНабора.СтавкаНДС;
		
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Записи", Записи);
КонецПроцедуры

