	ДобавитьПКС(СвойстваШапки, "Проведен",                            "", 1);
	ДобавитьПКС(СвойстваШапки, "Руководитель",                        "", 1, "Справочник_ОтветственныеЛица_ИзСтруктуры_Получение");
