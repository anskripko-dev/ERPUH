	ОчиститьИспользованиеПКО(ИспользованиеПКО);
	ИспользованиеПКО.Вставить("Документ_ОперацияПоПлатежнойКарте_Получение", Истина);
	
	//++ Локализация
	ОчиститьИспользованиеПКО(ИспользованиеПКО);
	
	Свойства = ДанныеXDTO;
	
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
		Свойства = ДанныеXDTO.КлючевыеСвойства;
	КонецЕсли;
	
	Если Свойства.ВидОперации.Значение = "ОплатаОтКлиентаЧерезПлатежнуюСистему" Или
		Свойства.ВидОперации.Значение = "ВозвратОтКлиентаЧерезПлатежнуюСистему" Тогда
		
		ИспользованиеПКО.Вставить("Документ_ОперацияПоЯндексКассе_Получение", Истина);
	Иначе
		ИспользованиеПКО.Вставить("Документ_ОперацияПоПлатежнойКарте_Получение", Истина);
	КонецЕсли;
	//-- Локализация
