Процедура ПКО_Справочник_Организации_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("ОКАТО") И ЗначениеЗаполнено(ДанныеXDTO.ОКАТО) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ОКАТО", ДанныеXDTO.ОКАТО);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Префикс") И ЗначениеЗаполнено(ДанныеXDTO.Префикс) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Префикс", ДанныеXDTO.Префикс);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ОГРН") И ЗначениеЗаполнено(ДанныеXDTO.ОГРН) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ОГРН", ДанныеXDTO.ОГРН);
	КонецЕсли;
	
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("КПП") И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.КПП) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КПП", ДанныеXDTO.КлючевыеСвойства.КПП);
	КонецЕсли;
	
	// ЮрФизЛицо
	Если ДанныеXDTO.КлючевыеСвойства.ЮридическоеФизическоеЛицо.Значение = "ЮридическоеЛицо" Тогда
		ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	Иначе
		ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
	КонецЕсли;
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("НаименованиеПолное")Тогда 
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НаименованиеПолное", ДанныеXDTO.КлючевыеСвойства.НаименованиеПолное);
	КонецЕсли;  
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("НаименованиеСокращенное")Тогда 
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НаименованиеСокращенное", ДанныеXDTO.КлючевыеСвойства.НаименованиеСокращенное);
	КонецЕсли;
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
	
	ПравилаЗаполнения = Новый Соответствие;
	
	ПравилаЗаполнения.Вставить("ДатаНачала", "Период");
	ПравилаЗаполнения.Вставить("НаименованиеПолное", "НаименованиеПолное");
	ПравилаЗаполнения.Вставить("НаименованиеСокращенное", "НаименованиеСокращенное");
	ПравилаЗаполнения.Вставить("НаименованиеМеждународное", "НаименованиеМеждународное");
	
	ЗагрузитьИсториюРеквизитовВПолученныеДанные(ДанныеXDTO, ПолученныеДанные, ПравилаЗаполнения);
	
	ЗагрузитьКонтактнуюИнформацию(ДанныеXDTO, ПолученныеДанные, Справочники.ВидыКонтактнойИнформации.СправочникОрганизации);
КонецПроцедуры
Процедура ПКО_Справочник_Организации_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено Тогда
	
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ОКАТО") Тогда
			ДанныеИБ.ДополнительныеСвойства.Вставить("ОКАТО", ПолученныеДанные.ДополнительныеСвойства.ОКАТО);
		КонецЕсли;
		ПолученныеДанные.ОбособленноеПодразделение =  ДанныеИБ.ОбособленноеПодразделение;
		ПолученныеДанные.ГоловнаяОрганизация =  ДанныеИБ.ГоловнаяОрганизация;
		Если Не ЗначениеЗаполнено(ПолученныеДанные.НаименованиеСокращенное) Тогда
			ПолученныеДанные.НаименованиеСокращенное = ДанныеИБ.НаименованиеСокращенное;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПолученныеДанные.КодОКВЭД) Тогда
			ПолученныеДанные.КодОКВЭД = ДанныеИБ.КодОКВЭД;
		КонецЕсли;  
		Если Не ЗначениеЗаполнено(ПолученныеДанные.КодОКВЭД2) Тогда
			ПолученныеДанные.КодОКВЭД2 = ДанныеИБ.КодОКВЭД2;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(ПолученныеДанные.КодОКОПФ) Тогда
			ПолученныеДанные.КодОКОПФ = ДанныеИБ.КодОКОПФ;
		КонецЕсли;   
		Если Не ЗначениеЗаполнено(ПолученныеДанные.КодОКФС) Тогда
			ПолученныеДанные.КодОКФС = ДанныеИБ.КодОКФС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПолученныеДанные.ИсторияНаименований) Тогда
			
			Если ДанныеИБ.ИсторияНаименований.Количество() > 0 Тогда
				
				МассивКлючевыхПолей = Новый Массив;
				
				МассивКлючевыхПолей.Добавить("Период");
				МассивКлючевыхПолей.Добавить("НаименованиеПолное"); 
				
				ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
					ПолученныеДанные.ИсторияНаименований,
					ДанныеИБ.ИсторияНаименований,
					МассивКлючевыхПолей, 
					"НаименованиеМеждународное"); 
					
			КонецЕсли;
			
			ДанныеИБ.ИсторияНаименований.Загрузить(ПолученныеДанные.ИсторияНаименований.Выгрузить());
		Иначе
			ПолученныеДанные.ИсторияНаименований.Загрузить(ДанныеИБ.ИсторияНаименований.Выгрузить());
		КонецЕсли;
	
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Префикс") И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.Префикс) Тогда
		ДанныеДляЗаписиВИБ.Префикс = ПолученныеДанные.ДополнительныеСвойства.Префикс;
	КонецЕсли;
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ОГРН") И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ОГРН) Тогда
		ДанныеДляЗаписиВИБ.ОГРН = ПолученныеДанные.ДополнительныеСвойства.ОГРН;
	КонецЕсли;
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КПП") И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.КПП) Тогда
		ДанныеДляЗаписиВИБ.КПП = ПолученныеДанные.ДополнительныеСвойства.КПП;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ВалютаРегламентированногоУчета) Тогда
		ДанныеДляЗаписиВИБ.ВалютаРегламентированногоУчета = ЗначениеНастроекПовтИсп.БазоваяВалютаПоУмолчанию();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СтранаРегистрации) Тогда
	     ДанныеДляЗаписиВИБ.СтранаРегистрации = Константы.ОсновнаяСтрана.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.Статус) Тогда
		ДанныеДляЗаписиВИБ.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОрганизацийПодразделений.Действует");
	КонецЕсли;
	
	ЗаполнитьИсториюНаименованийОрганизации(ДанныеДляЗаписиВИБ, ПолученныеДанные);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
	                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
КонецПроцедуры

