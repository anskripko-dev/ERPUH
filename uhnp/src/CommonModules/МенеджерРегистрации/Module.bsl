	Выгрузка         = ПараметрыОбработкиПРОПослеОбработки.Выгрузка;
	
	//++ НЕ УТ
	ДокументыПоступления = Объект.Товары.Выгрузить();
	ДокументыПоступления.Свернуть("ДокументПоступления");
	Для каждого Стр Из ДокументыПоступления Цикл
		Если Стр.ДокументПоступления.ЗакупкаПодДеятельность = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.Космос") Тогда
