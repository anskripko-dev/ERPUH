Процедура ПРО_Документ_КорректировкаРеализации_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Если ЗначениеЗаполнено(Объект.ДокументОснование) И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Если НЕ Объект.ДокументОснование.Проведен Тогда 
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	//++ НЕ УТКА
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ОтчетДавальцу2_5") Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ОтчетПереработчика2_5") Тогда
		Отказ = Истина;
	КонецЕсли;
	
	//++ Локализация
	Если Объект.ТипКорректировки = Перечисления.ТипыКорректировки.КорректировкаДоВводаОстатковТоваровИУслуг Тогда
		Отказ = Истина;
	КонецЕсли;
	//-- Локализация
	
	//-- НЕ УТКА
КонецПроцедуры

