	Если ЗначениеЗаполнено(Объект.Упаковка)
		И ОбщегоНазначения.СсылкаСуществует(Объект.Упаковка) Тогда
		
		Владелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Упаковка, "Владелец");
	
		Если НЕ Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения
			И НЕ (ЗначениеЗаполнено(Владелец) И ТипЗнч(Владелец) = Тип("СправочникСсылка.Номенклатура")) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
