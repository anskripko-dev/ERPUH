Процедура ПРО_Справочник_Контрагенты_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если Получатели.Количество() > 0 Тогда
			// Для ОбменКасса удалим регистрацияю НЕ Поставщиков
			ЭтоПоставщик = Неопределено;
			МаксИндекс = Получатели.ВГраница();
			Для Индекс = 0 По МаксИндекс Цикл
				ИндексТек = МаксИндекс - Индекс;
				ТекПолучатель = Получатели[ИндексТек];
				Если ТекПолучатель.ВариантНастройки = "ОбменКасса" Тогда
					Если ЭтоПоставщик = Неопределено Тогда
						ЭтоПоставщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Партнер, "Поставщик");
					КонецЕсли;
					Если Не ЭтоПоставщик = Неопределено И Не ЭтоПоставщик Тогда
						Получатели.Удалить(ИндексТек);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
КонецПроцедуры
