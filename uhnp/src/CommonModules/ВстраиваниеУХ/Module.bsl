#Область Справочник_БанковскиеСчета

Процедура ПриЗаписиЭлементаСправочникаБанковскиеСчета(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;   
	
	// проверяем возможность создание и обновления элементов справочника "Контрагенты"
	ИмяОпции = "СоздаватьОбновлятьКонтрагентовИБанковскиеСчетаВГО";
	Если НЕ ПолучитьФункциональнуюОпцию(ИмяОпции) Тогда 
		Возврат;	
	КонецЕсли;	
	ОрганизацияВладелец = Источник.Владелец;
	Если НЕ ЗначениеЗаполнено(ОрганизацияВладелец) Тогда
		Возврат;	
	КонецЕсли;
	
	Если НЕ ТипЗнч(ОрганизацияВладелец)= Тип("СправочникСсылка.Организации") Тогда
		Возврат;	
	КонецЕсли;  
	
	СтрукутраРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОрганизацияВладелец,
							"ЭлиминирующаяОрганизация, ИспользоватьВРегламентированномУчете, ИностранныйНалоговыйРезидент", Истина);
	Если СтрукутраРеквизитов.ЭлиминирующаяОрганизация 
		 ИЛИ НЕ (СтрукутраРеквизитов.ИспользоватьВРегламентированномУчете
		 			ИЛИ СтрукутраРеквизитов.ИностранныйНалоговыйРезидент) Тогда
		Возврат;
	КонецЕсли;
	
	МасКонтрагенты = ОрганизацииВызовСервераУХ.ПолучитьКонтрагентовПоОрганизации(ОрганизацияВладелец);
	Если МасКонтрагенты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
			
	Для каждого ТекущийКонтрагент Из МасКонтрагенты Цикл
		БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(Источник.НомерСчета, ТекущийКонтрагент, Источник.Ссылка);
		Если БанковскийСчетКонтрагента = Неопределено Тогда 
			БанковскийСчетОбъект = Справочники.БанковскиеСчетаКонтрагентов.СоздатьЭлемент();
			БанковскийСчетОбъект.УстановитьНовыйКод();
		Иначе			
			БанковскийСчетОбъект = БанковскийСчетКонтрагента.ПолучитьОбъект();		
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(БанковскийСчетОбъект, Источник, ,"Владелец, Код, Родитель");
		
		БанковскийСчетОбъект.ПометкаУдаления 	= Источник.ПометкаУдаления;
		БанковскийСчетОбъект.Наименование 		= Источник.Наименование; 
		БанковскийСчетОбъект.Владелец			= ТекущийКонтрагент;  
		БанковскийСчетОбъект.СчетОрганизации	= Источник.Ссылка;
		
		Попытка
			БанковскийСчетОбъект.Записать();	
		Исключение
			
			ТекущийКонтрагентНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийКонтрагент, "Наименование"); 
			Если БанковскийСчетКонтрагента = Неопределено Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось сформировать банковский счет, принадлежащего контрагенту ""%1"".'"), 		ТекущийКонтрагентНаименование);
			Иначе 
				ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось обновить реквизиты банковского счета, принадлежащего контрагенту ""%1"".'"), ТекущийКонтрагентНаименование);
			КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ТекущийКонтрагент, , , Отказ);
			Возврат;
		КонецПопытки;
	КонецЦикла;
	
	Если МасКонтрагенты.Количество() > 1 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Для организации ""%1"" больше одного связанного контрагента.'"), Источник.Наименование), Источник, , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

