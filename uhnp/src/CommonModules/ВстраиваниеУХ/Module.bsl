	|	ИЛИ ЕСТЬNULL(ДолгосрочнаяЗадолженностьКт.ВариантПереноса, ""Основной"") = ""Разделение""";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПсевдонимПоиска, НовыйБлокЗапроса)
				
