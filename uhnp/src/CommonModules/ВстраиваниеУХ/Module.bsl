Процедура ПередЗаписьюСправочникаОрганизацииУХПередЗаписью(Источник, Отказ) Экспорт
	
	Источник.ДополнительныеСвойства.Вставить("ЭтоНовыйУХ", Источник.ЭтоНовый());
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьРСБУ = УчетМСФОПовтИспУХ.ЕстьРСБУ();
	
	ЗаголовокОшибки = СтрШаблон(НСтр("ru = 'Организационная единица: ""%1"" не может быть записана:'"), Источник.Наименование);
	
	Если Не ЗначениеЗаполнено(Источник.ЮридическоеФизическоеЛицо) Тогда		
		Источник.ЮридическоеФизическоеЛицо=Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	КонецЕсли;
	
	Если ЕстьРСБУ Тогда
		Источник.ИННКПП = Источник.ИНН + "/" + Источник.КПП;
	КонецЕсли;
		
	МодульОрганизацииКлиентСерверУХ = ВстраиваниеУХ.ОбщийМодуль("ОрганизацииКлиентСерверУХ"); 
	Если МодульОрганизацииКлиентСерверУХ <> Неопределено Тогда
		МодульОрганизацииКлиентСерверУХ.УправлениеФормой_ТипОрганизации(Источник); 
	КонецЕсли;
	
	Если ЕстьРСБУ И Не Источник.ИностраннаяСтруктураБезОбразованияЮрЛица Тогда
		ПустаяСсылка = ПредопределенноеЗначение("Перечисление.ВидыИностранныхСтруктурБезОбразованияЮЛ.ПустаяСсылка");
		ОбщегоНазначенияКлиентСерверУХ.УстановитьНовоеЗначение(Источник.ВидИностраннойСтруктуры, ПустаяСсылка);
	КонецЕсли;
		
КонецПроцедуры

