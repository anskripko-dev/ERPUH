Функция ФормированиеПотребностей(СценарииТоварногоПланирования) Экспорт

	Если Не ЗначениеЗаполнено(СценарииТоварногоПланирования) Тогда
		Возврат Ложь;
	Иначе
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СценарииТоварногоПланирования, "ФормированиеПотребностейПланомЗакупок");
	КонецЕсли;

КонецФункции // ФормированиеПотребностей()

Процедура ОбновитьФормированиеПотребностейПланомЗакупок() Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Запрос = Новый Запрос;  
		Запрос.УстановитьПараметр("РежимФормированияПотребностейПланомЗакупок", ОбщегоНазначенияКлиентСервер.МассивЗначений(
																					Перечисления.РежимыФормированияПотребностейПланомЗакупок.РегистрируютПотребности,
																					Перечисления.РежимыФормированияПотребностейПланомЗакупок.ФормируютПотребности));
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СценарииТоварногоПланирования.Ссылка КАК Ссылка,
		|	СценарииТоварногоПланирования.РежимФормированияПотребностейПланомЗакупок КАК РежимФормированияПотребностейПланомЗакупок
		|ПОМЕСТИТЬ Сценарии
		|ИЗ
		|	Справочник.СценарииТоварногоПланирования КАК СценарииТоварногоПланирования
		|ГДЕ
		|	СценарииТоварногоПланирования.РежимФормированияПотребностейПланомЗакупок В(&РежимФормированияПотребностейПланомЗакупок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сценарии.Ссылка КАК Ссылка,
		|	Сценарии.РежимФормированияПотребностейПланомЗакупок КАК РежимФормированияПотребностейПланомЗакупок
		|ИЗ
		|	Сценарии КАК Сценарии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыПланов.Ссылка КАК Ссылка,
		|	Сценарии.Ссылка КАК Сценарий,
		|	Сценарии.РежимФормированияПотребностейПланомЗакупок КАК РежимФормированияПотребностейПланомЗакупок
		|ИЗ
		|	Справочник.ВидыПланов КАК ВидыПланов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сценарии КАК Сценарии
		|		ПО ВидыПланов.Владелец = Сценарии.Ссылка
		|ГДЕ
		|	НЕ ВидыПланов.ЭтоГруппа";
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СценарииТоварногоПланированияОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			СценарииТоварногоПланированияОбъект.ФормированиеПотребностейПланомЗакупок = Истина; 
			СценарииТоварногоПланированияОбъект.ПланЗакупокПланироватьПоСумме = Истина;
			СценарииТоварногоПланированияОбъект.Записать();	
		КонецЦикла; 
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса[2].Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ВидТоварногоПланированияОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ВидТоварногоПланированияОбъект.ЗаполнятьПланОплат = Истина;
			ВидТоварногоПланированияОбъект.ЗаполнятьПодразделение = Ложь;
			ВидТоварногоПланированияОбъект.ЗаполнятьПартнера = Ложь;
			ВидТоварногоПланированияОбъект.ЗаполнятьСоглашение = Ложь;
            ВидТоварногоПланированияОбъект.Записать();
		КонецЦикла; 
		
	ЗафиксироватьТранзакцию();	
		
	Исключение       
		
		ОтменитьТранзакцию(); 
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации()+"."+"ОбновитьФормированиеПотребностейПланомЗакупок (СценарииТоварногоПланирования)", 
									УровеньЖурналаРегистрации.Ошибка, 
									Метаданные.Справочники.СценарииТоварногоПланирования,, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

