	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика1,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика2,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика3,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика4,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика5,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика6
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|ГДЕ
	|	ОперацииБюджетов.Регистратор <> &Ссылка
	|	И ОперацииБюджетов.ОбъектПланирования.Объект = &Договор
	|	И ОперацииБюджетов.Сумма > 0";
	
	ИмяДокумента = Источник.Ссылка.Метаданные().Имя;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗаключениеДоговораАренды", ИмяДокумента);
		
	ИменаРеквизитов = "Дата, ДатаВыкупа, СуммаВыкупаПредметовАренды, Организация, Контрагент, Договор, Ссылка";
	Если Не ИмяДокумента = "ВводОстатковВзаиморасчетовПоАренде" Тогда
		ИменаРеквизитов = ИменаРеквизитов + ", ВалютаВзаиморасчетов";	
	КонецЕсли;
	
	Если ТипЗнч(Источник) = ТипЗнч(Документы[ИмяДокумента].ПустаяСсылка()) Тогда
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, ИменаРеквизитов);
	Иначе                                        
		РеквизитыДокумента = Источник;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;

	// Реквизиты договора
	РеквизитыДоговора = Новый Структура(); 
	РеквизитыДоговора.Вставить("ЦФО", 		"ОсновнойЦФО");
	РеквизитыДоговора.Вставить("Проект", 	"ОсновнойПроект");  
	РеквизитыДоговора.Вставить("БанковскийСчет");
	РеквизитыДоговора.Вставить("БанковскийСчетКонтрагента");

	Если ИмяДокумента = "ВводОстатковВзаиморасчетовПоАренде" Тогда
		РеквизитыДоговора.Вставить("ВалютаВзаиморасчетов");	
	КонецЕсли;  
	
	Если РеквизитыДокумента.Договор <> Неопределено Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Договор, РеквизитыДоговора);
	КонецЕсли;
	
	Для Каждого КлючЗначение Из РеквизитыДоговора Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Возврат Запрос.МенеджерВременныхТаблиц;

КонецФункции

#КонецОбласти
 
#Область ФормаДокумента_ВводОстатковВзаиморасчетовПоАренде

Процедура ВводОстатковВзаиморасчетовПоАренде_ФормаДокумента_ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт 
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	СоздатьДекорациюЭтоРезультатОбновления(Форма, Элементы.Страницы);
	СоздатьЭлементыИспользованиеГрафика(Форма, Элементы.Страницы);
	
	Элементы.НадписьДокументЗаблокирован.Видимость = Объект.ТолькоГрафикиРасчетовУХ;    
	
КонецПроцедуры  

