Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка) Экспорт
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Реквизиты.Ссылка КАК Ссылка,
		|	Реквизиты.Дата КАК Дата,
		|	Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Реквизиты.Организация КАК Организация,
		|	Реквизиты.Контрагент КАК Контрагент,
		|	6 КАК ЗаполненностьДоговораЗаявки,
		|	Неопределено КАК ДокументПланирования,
		|	Реквизиты.ИспользованиеГрафикаРасчетовБДР КАК ИспользованиеГрафикаРасчетовБДР,
		|	Реквизиты.ИспользованиеГрафикаРасчетовБДДС КАК ИспользованиеГрафикаРасчетовБДДС
		|ИЗ
		|	_ИмяТаблицыДокумента_ КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ИмяТаблицыДокумента 	= ДокументСсылка.Метаданные().ПолноеИмя();
	Запрос.Текст 			= СтрЗаменить(Запрос.Текст, "_ИмяТаблицыДокумента_", ИмяТаблицыДокумента);
	
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
		
	Для Каждого ТекРеквизит Из Реквизиты Цикл
		Запрос.УстановитьПараметр(ТекРеквизит.Ключ, ТекРеквизит.Значение);
	КонецЦикла;

	МенеджерДоговора = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяТаблицыДокумента);

	Запрос.МенеджерВременныхТаблиц = МенеджерДоговора.ПланыДокумента(ДокументСсылка); 
 
КонецПроцедуры

#КонецОбласти

Процедура ДополнитьПереченьОперацийГрафикаИзВерсииСоглашения(ОперацииГрафика, ПараметрыОперацийВерсии)
	
	Если НЕ ЗначениеЗаполнено(ПараметрыОперацийВерсии) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекКлючЗначение Из ОперацииГрафика Цикл
		
		Операция = ТекКлючЗначение.Ключ;
		СвойстваОперации = ТекКлючЗначение.Значение;
		
		СтрокиОперацииВерсии = ПараметрыОперацийВерсии.НайтиСтроки(Новый Структура("ОперацияГрафика", Операция));
		Если ЗначениеЗаполнено(СтрокиОперацииВерсии) Тогда
			ЗаполнитьЗначенияСвойств(СвойстваОперации, СтрокиОперацииВерсии[0]); // СтатьяБюджета, Аналитика1..6
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти

#Область АктуализацияГрафиковРасчетов  

Процедура ДобавитьОбъектыРасчетовКАктуализацииГрафиков(НаборЗаписей) Экспорт
	
	РезультатЗапроса = ПолучитьОбъектыРасчетов(НаборЗаписей);  
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	
	ТипыГрафиковАктуализации = Метаданные.ОпределяемыеТипы.ОбъектРасчетовАктуализацииГрафиков.Тип.Типы();
	
	ВидыДоговоров = Новый Массив;  	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДоговоров, РаботаСДоговорамиКонтрагентовУХКлиентСервер.ВидыДоговоровСПоставщиком());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДоговоров, РаботаСДоговорамиКонтрагентовУХКлиентСервер.ВидыДоговоровСПокупателем());
    ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДоговоров, РаботаСДоговорамиКонтрагентовУХКлиентСервер.ВидыДоговоровДепозит());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДоговоров, РаботаСДоговорамиКонтрагентовУХКлиентСервер.ВидыДоговоровКредит());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДоговоров, РаботаСДоговорамиКонтрагентовУХКлиентСервер.ВидыДоговоровЗаем());   
	
	ВыборкаОбъектРасчетов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаОбъектРасчетов.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(ВыборкаОбъектРасчетов.ОбъектРасчетов) Тогда
			Продолжить;
		КонецЕсли;      
		
		Если ТипыГрафиковАктуализации.Найти(ТипЗнч(ВыборкаОбъектРасчетов.ОбъектРасчетов)) = Неопределено Тогда
			Продолжить;	
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(ВыборкаОбъектРасчетов.ВидДоговораУХ) 
			И ВидыДоговоров.Найти(ВыборкаОбъектРасчетов.ВидДоговораУХ) = Неопределено Тогда
			Продолжить;	
		КонецЕсли;  		
		
		ТекущийДокументГрафика = РаботаСДоговорамиКонтрагентовУХ.ДокументГрафикаНакладной(ВыборкаОбъектРасчетов.ОбъектРасчетов);   
		
		Если Не ЗначениеЗаполнено(ТекущийДокументГрафика) Тогда
			Продолжить;	
		КонецЕсли;
		
		ТребуетсяАктуализация = РаботаСДоговорамиКонтрагентовУХВстраивание.ТребуетсяАктуализацияГрафикаРасчетов(ТекущийДокументГрафика);
		
		Если ТребуетсяАктуализация Тогда
			РегистрыСведений.ОбъектыРасчетовКАктуализацииГрафиков.ЗарегистрироватьГрафикРасчетов(ВыборкаОбъектРасчетов.ОбъектРасчетов); 
		КонецЕсли;     
		
	КонецЦикла; 	
		
КонецПроцедуры 

Функция ПолучитьОбъектыРасчетов(НаборЗаписей)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыСКонтрагентамиФакт.ОбъектРасчетов КАК ОбъектРасчетов
	|ПОМЕСТИТЬ ВТ_РасчетыСКонтрагентамиФакт
	|ИЗ
	|	&РасчетыСКонтрагентамиФакт КАК РасчетыСКонтрагентамиФакт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыСКонтрагентамиФакт.ОбъектРасчетов КАК ОбъектРасчетов,
	|	ВЫРАЗИТЬ(РасчетыСКонтрагентамиФакт.ОбъектРасчетов КАК Справочник.ДоговорыКонтрагентов).ВидДоговораУХ КАК ВидДоговораУХ
	|ИЗ
	|	РегистрНакопления.РасчетыСКонтрагентамиФакт КАК РасчетыСКонтрагентамиФакт
	|ГДЕ
	|	РасчетыСКонтрагентамиФакт.Регистратор = &Регистратор
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_РасчетыСКонтрагентамиФакт.ОбъектРасчетов,
	|	ВЫРАЗИТЬ(ВТ_РасчетыСКонтрагентамиФакт.ОбъектРасчетов КАК Справочник.ДоговорыКонтрагентов).ВидДоговораУХ
	|ИЗ
	|	ВТ_РасчетыСКонтрагентамиФакт КАК ВТ_РасчетыСКонтрагентамиФакт";
	
	Запрос.УстановитьПараметр("Регистратор", НаборЗаписей.Отбор.Регистратор.Значение);
	Запрос.УстановитьПараметр("РасчетыСКонтрагентамиФакт", НаборЗаписей.Выгрузить(, "ОбъектРасчетов"));

	РезультатЗапроса = Запрос.Выполнить();  
	
	Возврат РезультатЗапроса;
	
КонецФункции  

Процедура АктуализироватьГрафикиРасчетов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов КАК ОбъектРасчетов,
	|	ТИПЗНАЧЕНИЯ(ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов) = ТИП(Справочник.ДоговорыКредитовИДепозитов) КАК ЭтоДоговорКредитовИДепозитов,
	|	ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов.ВидДоговораУХ КАК ВидДоговора,
	|	ВЫБОР
	|		КОГДА ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов ССЫЛКА Справочник.ДоговорыКонтрагентов
	|			ТОГДА ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов.Менеджер
	|		КОГДА ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов ССЫЛКА Справочник.ДоговорыКредитовИДепозитов
	|			ТОГДА ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов.Ответственный
	|		ИНАЧЕ ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов.Автор
	|	КОНЕЦ КАК Ответственный
	|ИЗ
	|	РегистрСведений.ОбъектыРасчетовКАктуализацииГрафиков КАК ОбъектыРасчетовКАктуализацииГрафиков";
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОповещения = НастройкиОповещенияАктуализацияГрафиковРасчетов();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		
		ОбъектРасчетов = ВыборкаДетальныеЗаписи.ОбъектРасчетов;
		
		РезультатАктуализации = Новый Структура("Состояние, ОписаниеОшибки");
		
		ЭтоКредитЗаймДепозит = Ложь;    	
		ВыполненаАктуализацияГрафика = Ложь; 
		
		ОписаниеОшибки = "";
		
		Если ВыборкаДетальныеЗаписи.ЭтоДоговорКредитовИДепозитов Тогда  
			
			ЭтоКредитЗаймДепозит = УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорДепозит(ВыборкаДетальныеЗаписи.ВидДоговора)
				Или УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорКредит(ВыборкаДетальныеЗаписи.ВидДоговора) 
				Или УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорЗаем(ВыборкаДетальныеЗаписи.ВидДоговора);
		             		
		КонецЕсли; 
			
		НачатьТранзакцию();	  		

		Попытка  
			
			Если ЭтоКредитЗаймДепозит Тогда
				АктуализироватьГрафикРасчетовКредитЗаймДепозит(ОбъектРасчетов, ВыполненаАктуализацияГрафика, ОписаниеОшибки);	
			Иначе
				АктуализироватьГрафикРасчетов(ОбъектРасчетов, ВыполненаАктуализацияГрафика);	
			КонецЕсли;
			
			РегистрыСведений.ОбъектыРасчетовКАктуализацииГрафиков.УдалитьГрафикРасчетов(ОбъектРасчетов);
			
			Если ПустаяСтрока(ОписаниеОшибки) Тогда 				
				Если ВыполненаАктуализацияГрафика Тогда  
					РезультатАктуализации.Состояние = Истина;
				КонецЕсли;     
			Иначе
				РезультатАктуализации.Состояние = Ложь;
			КонецЕсли;            
			
			ЗафиксироватьТранзакцию();
			
		Исключение      
			
			ОтменитьТранзакцию();	
			
			ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрацииАктуализацияГрафика(), 
							УровеньЖурналаРегистрации.Ошибка, ОбъектРасчетов.Метаданные(), 
							ОбъектРасчетов, ОписаниеОшибки);
							
			РезультатАктуализации.Состояние = Ложь;
	        
		КонецПопытки;  			
		
		РезультатАктуализации.ОписаниеОшибки = ОписаниеОшибки;	
		СоздатьОповещениеАктуализацияГрафикаРасчета(ВыборкаДетальныеЗаписи, РезультатАктуализации, НастройкиОповещения);	
		
	КонецЦикла;    

КонецПроцедуры  

Функция НастройкиОповещенияАктуализацияГрафиковРасчетов()
	
	ВидСобытияОповещения = Справочники.ВидыСобытийОповещений.АктуализацияГрафиковРасчетов;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиОповещений.ОповещениеВключено КАК ОповещениеВключено
	|ИЗ
	|	РегистрСведений.НастройкиОповещений КАК НастройкиОповещений
	|ГДЕ
	|	НастройкиОповещений.ВидСобытияОповещения = &ВидСобытияОповещения";
	
	Запрос.УстановитьПараметр("ВидСобытияОповещения", ВидСобытияОповещения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОповещениеВключено = Ложь;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОповещениеВключено = ВыборкаДетальныеЗаписи.ОповещениеВключено;
	КонецЕсли;
	
	НастройкиОповещения = Новый Структура("ВидСобытияОповещения, ОповещениеВключено", ВидСобытияОповещения, ОповещениеВключено);
	
	Возврат НастройкиОповещения;
	
КонецФункции

Процедура АктуализироватьГрафикРасчетов(ОбъектРасчетов, ВыполненаАктуализацияГрафика)  
	
	Перем РеквизитыДокументаГрафика;            
	
	ТекущийДокументГрафика = ДокументГрафикаНакладной(ОбъектРасчетов);
	
	Если Не ЗначениеЗаполнено(ТекущийДокументГрафика) Тогда
		Возврат;
	КонецЕсли; 
	
	ТребуетсяАктуализация = РаботаСДоговорамиКонтрагентовУХВстраивание.ТребуетсяАктуализацияГрафикаРасчетов(
													ТекущийДокументГрафика, РеквизитыДокументаГрафика);
	
	Если Не ТребуетсяАктуализация Тогда  		
		Возврат;
	КонецЕсли; 	
	
	РеквизитыГрафика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийДокументГрафика, "ДатаПервойОперации, ДатаНачалаДействия"); 
	ДатаРасчетов = ?(ЗначениеЗаполнено(РеквизитыГрафика.ДатаПервойОперации), 
							РеквизитыГрафика.ДатаПервойОперации, РеквизитыГрафика.ДатаНачалаДействия);    
	
	ДатаАктуализации = ТекущаяДатаСеанса();
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ТекущийДокументГрафика);
	
	Если РеквизитыДокументаГрафика.РежимАктуализацииГрафика 
			= Перечисления.РежимыАктуализацииГрафикаПриИзмененииПервичныхДокументов.СоздаватьНовыеВерсии Тогда	
		
		ДокументГрафикаОбъект = МенеджерДокумента.СоздатьДокумент();					
		ДокументГрафикаОбъект.Заполнить(ОбъектРасчетов);
		ДокументГрафикаОбъект.Дата = ДатаАктуализации;
	Иначе				
		ДокументГрафикаОбъект = ТекущийДокументГрафика.ПолучитьОбъект();
		ДокументГрафикаОбъект.Заблокировать();
	КонецЕсли;
	
	ДатаАванса = РасчетГрафиковОперацийУХВстраивание.ДатаАвансаПоНакладной(ТекущийДокументГрафика, ДатаРасчетов); 	
	ДатаОтсчета = ?(ЗначениеЗаполнено(ДатаАванса), ДатаАванса, ДатаРасчетов);    
	
	НовыйГрафикРасчетов = ПолучитьНовыйГрафикРасчетов(ДатаОтсчета, ОбъектРасчетов, ДокументГрафикаОбъект); 
	
	ГрафикиВерсийСовпадают = РасчетГрафиковОперацийУХ.ГрафикиРасчетаСовпадают(
									НовыйГрафикРасчетов, ТекущийДокументГрафика.ГрафикРасчетов); 
	
	Если ГрафикиВерсийСовпадают Тогда
		Возврат;
	КонецЕсли;
	
	ДокументГрафикаОбъект.ГрафикРасчетов.Загрузить(НовыйГрафикРасчетов);	
	ДокументГрафикаОбъект.Записать(РежимЗаписиДокумента.Проведение);   
	
	ВыполненаАктуализацияГрафика = Истина;
	
КонецПроцедуры    

Функция АктуализироватьГрафикРасчетовНаФорме(ОбъектРасчетов, ДатаПереноса) Экспорт  

	ТекущийДокументГрафика = ДокументГрафикаНакладной(ОбъектРасчетов);
	
	Если Не ЗначениеЗаполнено(ТекущийДокументГрафика) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ДокументГрафикаОбъект = ТекущийДокументГрафика.ПолучитьОбъект();  
	
	НовыйГрафикРасчетов = ПолучитьНовыйГрафикРасчетов(ДатаПереноса, ОбъектРасчетов, ДокументГрафикаОбъект);  
	
	Возврат НовыйГрафикРасчетов;   

КонецФункции  

Функция ПолучитьНовыйГрафикРасчетов(ДатаОтсчета, ОбъектРасчетов, ДокументГрафикаОбъект)
	
	ДатаАктуализации = ТекущаяДатаСеанса();
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументГрафикаОбъект.Ссылка);  

	ВидДоговораУХ = ВидДоговораУХОбъекта(ДокументГрафикаОбъект);
	ОписаниеГрафика = МенеджерДокумента.ОписаниеГрафика(ВидДоговораУХ);
	ОперацииГрафика = ОперацииГрафика(ОписаниеГрафика, ДокументГрафикаОбъект, ВидДоговораУХ);
	
	// План графика	    
	ПараметрыРасчета = МенеджерДокумента.НовыйПараметрыРасчетаГрафика();
	ПараметрыРасчета.РежимРасчета = "ВесьГрафикОтДатыПервойОперации";
	ПараметрыРасчета.ДатаОтсчета = ДатаОтсчета;     	
	
	ДокументГрафикаОбъект.ГрафикРасчетов.Очистить();
	МенеджерДокумента.ВыполнитьРасчетГрафика(ДокументГрафикаОбъект,
					"ОсновнойДолг", ОписаниеГрафика, ОперацииГрафика, ПараметрыРасчета);
	
	ПланГрафика = ДокументГрафикаОбъект.ГрафикРасчетов.Выгрузить();
	
	// Факт графика
	ДокументГрафикаОбъект.ГрафикРасчетов.Очистить();
	ПустойГрафикРасчетов = ДокументГрафикаОбъект.ГрафикРасчетов.Выгрузить();
	ФактГрафика = РаботаСДоговорамиКонтрагентовУХ.ПеренестиФактВГрафик(ПустойГрафикРасчетов, ДатаАктуализации, 
						ДокументГрафикаОбъект.ДоговорКонтрагента, ОбъектРасчетов, ОписаниеГрафика, ОперацииГрафика);	
	
	// Начисление   
	ПараметрыОтбора = Новый Структура; 
	ПараметрыОтбора.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг);
	ПараметрыОтбора.Вставить("КолонкаСекции", Перечисления.ВидыДвиженийПриходРасход.Приход); 
	
	НовыйГрафикРасчетов = РаспределитьПланНаФактГрафика(ПланГрафика, ФактГрафика, ПараметрыОтбора);   
	ДокументГрафикаОбъект.ГрафикРасчетов.Загрузить(НовыйГрафикРасчетов);  
	ДокументГрафикаОбъект.ГрафикРасчетов.Сортировать("Дата");    
	
	// Оплата 
	Если Не ДокументГрафикаОбъект.ГрафикРасчетов.Количество() = 0 Тогда
		ПараметрыРасчета.ДатаОтсчета = НовыйГрафикРасчетов[0].Дата;	
	КонецЕсли;

	ПроизводственныеКалендари = РаботаСДоговорамиКонтрагентовУХ.ПроизводственныеКалендариВерсииСоглашения(ДокументГрафикаОбъект);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументГрафикаОбъект, "СпособРасчетаКоличестваДней") Тогда
		СпособРасчетаКоличестваДней = ДокументГрафикаОбъект.СпособРасчетаКоличестваДней; 
	Иначе     
		СпособРасчетаКоличестваДней = Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням; 
	КонецЕсли;
	
    ВариантыОплатыАванса = РасчетГрафиковОперацийЕХ.ВариантыОплатыАванса();
	
	СекцияГрафика = ОписаниеГрафика.ОсновнойДолг;
	
   	ПараметрыПозиций = Новый Структура;  
	ПараметрыПозиций.Вставить("СекцияГрафика", СекцияГрафика);
	ПараметрыПозиций.Вставить("ОписаниеГрафика", ОписаниеГрафика);
	ПараметрыПозиций.Вставить("ОперацииГрафика", ОперацииГрафика);
	ПараметрыПозиций.Вставить("ПроизводственныйКалендарь", ПроизводственныеКалендари);
	ПараметрыПозиций.Вставить("ЭтапыГрафикаОплаты", ДокументГрафикаОбъект.ЭтапыГрафикаОплаты);      
	ПараметрыПозиций.Вставить("СпособРасчетаКоличестваДней", СпособРасчетаКоличестваДней); 
	ПараметрыПозиций.Вставить("ВариантыОплатыАванса", ВариантыОплатыАванса);    	
	
	БазоваяДата = РасчетГрафиковОперацийУХ.ПолучитьДатуНачисленияПоДатеПервойОперации(ПараметрыРасчета.ДатаОтсчета, ПараметрыПозиций);  
							
	СуммаНачислений = НовыйГрафикРасчетов.Итог("Сумма");
	МенеджерДокумента.ДобавитьПозициюВГрафик(ДокументГрафикаОбъект.ГрафикРасчетов, БазоваяДата, 
						СуммаНачислений, Ложь, ПараметрыПозиций);
	
	ПараметрыОтбора = Новый Структура; 
	ПараметрыОтбора.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг);
    ПараметрыОтбора.Вставить("КолонкаСекции", Перечисления.ВидыДвиженийПриходРасход.Расход);
	
	ГрафикРасчетов = ДокументГрафикаОбъект.ГрафикРасчетов.Выгрузить(ПараметрыОтбора);
	ГрафикРасчетовОплата = РаспределитьПланНаФактГрафика(ГрафикРасчетов, ФактГрафика, ПараметрыОтбора);   
	
	// Объединяем начисление и оплату
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ГрафикРасчетовОплата, НовыйГрафикРасчетов);
	НовыйГрафикРасчетов.Сортировать("Дата");  
	
	Возврат НовыйГрафикРасчетов;

КонецФункции

Процедура АктуализироватьГрафикРасчетовКредитЗаймДепозит(ОбъектРасчетов, ВыполненаАктуализацияГрафика, ТекстОшибки)  
	
	Перем РеквизитыДокументаГрафика;                          
	
	ТекущийДокументГрафика = ДокументГрафикаНакладной(ОбъектРасчетов);
	
	Если Не ЗначениеЗаполнено(ТекущийДокументГрафика) Тогда
		Возврат;
	КонецЕсли; 
	
	ТребуетсяАктуализация = РаботаСДоговорамиКонтрагентовУХВстраивание.ТребуетсяАктуализацияГрафикаРасчетов(
																	ТекущийДокументГрафика, РеквизитыДокументаГрафика);
	
	Если Не ТребуетсяАктуализация Тогда  		
		Возврат;
	КонецЕсли; 	
	
	ДатаОтсчета = ТекущийДокументГрафика.ДатаНачалаДействия;
	
	ДатаАктуализации = ТекущаяДатаСеанса();
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ТекущийДокументГрафика);
	
	Если РеквизитыДокументаГрафика.РежимАктуализацииГрафика 
			= Перечисления.РежимыАктуализацииГрафикаПриИзмененииПервичныхДокументов.СоздаватьНовыеВерсии Тогда	
		
		ДокументГрафикаОбъект = МенеджерДокумента.СоздатьДокумент();					
		ДокументГрафикаОбъект.Заполнить(ОбъектРасчетов);
		ДокументГрафикаОбъект.Дата = ДатаАктуализации;
	Иначе				
		ДокументГрафикаОбъект = ТекущийДокументГрафика.ПолучитьОбъект();
		ДокументГрафикаОбъект.Заблокировать();
	КонецЕсли; 
	
	ВидДоговораУХ = ВидДоговораУХОбъекта(ДокументГрафикаОбъект);
	ОписаниеГрафика = МенеджерДокумента.ОписаниеГрафика(ВидДоговораУХ);
	ОперацииГрафика = ОперацииГрафика(ОписаниеГрафика, ДокументГрафикаОбъект, ВидДоговораУХ);     
	
	НовыйГрафикРасчетов = ПолучитьНовыйГрафикРасчетовКредитЗаймДепозит(ДатаОтсчета, ОбъектРасчетов, ДокументГрафикаОбъект, ТекстОшибки); 
	
	Если НовыйГрафикРасчетов = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ГрафикиВерсийСовпадают = РасчетГрафиковОперацийУХ.ГрафикиРасчетаСовпадают(НовыйГрафикРасчетов, ТекущийДокументГрафика.ГрафикРасчетов);
	
	Если ГрафикиВерсийСовпадают Тогда 
		Возврат;
	КонецЕсли;     
	
	ДокументГрафикаОбъект.ГрафикРасчетов.Загрузить(НовыйГрафикРасчетов); 

	 //Проверка несовпадения сумм. Критичная.   
	ОписаниеГрафика.Удалить("ТекстОшибки");

	ШаблонСообщенияОбОшибке = НСтр("ru = 'Не совпадают итоговые суммы колонок графика ""%1"" и ""%2"".'");
	Для Каждого СекцияГрафика Из ОписаниеГрафика Цикл
		
		ОписаниеСекции = СекцияГрафика.Значение;
		Если Не ФинансовыеИнструментыУХ.СекцияГрафикаЗамкнута(ДокументГрафикаОбъект.ГрафикРасчетов, ОписаниеСекции) Тогда    
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщенияОбОшибке, 
							ОписаниеСекции.КолонкаПриходПредставление, ОписаниеСекции.КолонкаРасходПредставление);  
		КонецЕсли;
		
	КонецЦикла;   
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;  
	
	ДокументГрафикаОбъект.Записать(РежимЗаписиДокумента.Проведение); 
	
	ВыполненаАктуализацияГрафика = Истина;
				
КонецПроцедуры  

Функция АктуализироватьГрафикРасчетовКредитЗаймДепозитНаФорме(ОбъектРасчетов, ДатаПереноса, СтруктураДействий) Экспорт  

	ТекущийДокументГрафика = ДокументГрафикаНакладной(ОбъектРасчетов);
	
	Если Не ЗначениеЗаполнено(ТекущийДокументГрафика) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ДокументГрафикаОбъект = ТекущийДокументГрафика.ПолучитьОбъект(); 
	
	НовыйГрафикРасчетов = ПолучитьНовыйГрафикРасчетовКредитЗаймДепозит(ДатаПереноса, ОбъектРасчетов, ДокументГрафикаОбъект);
	
	Возврат НовыйГрафикРасчетов;        
	
КонецФункции   

Функция ПолучитьНовыйГрафикРасчетовКредитЗаймДепозит(ДатаОтсчета, ОбъектРасчетов, ДокументГрафикаОбъект, ТекстОшибки = Неопределено)

	ДатаАктуализации = ТекущаяДатаСеанса();
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументГрафикаОбъект.Ссылка);  	
		
	ДокументГрафикаОбъект.ДополнительныеСвойства.Вставить("НеВызыватьИсключениеПриЗаписи");
	
	ВидДоговораУХ = ВидДоговораУХОбъекта(ДокументГрафикаОбъект);
	ОписаниеГрафика = МенеджерДокумента.ОписаниеГрафика(ВидДоговораУХ);
	ОперацииГрафика = ОперацииГрафика(ОписаниеГрафика, ДокументГрафикаОбъект, ВидДоговораУХ); 
	
	// План график
	ДокументГрафикаОбъект.ГрафикРасчетов.Очистить();
	
	Секции = Новый Массив;
	Секции.Добавить("ОсновнойДолг");
	Секции.Добавить("Проценты");
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика, ДопПараметры", Секции));
	
	ОписаниеГрафика.Вставить("ТекстОшибки", ТекстОшибки);
	
	ФинансовыеИнструментыУХ.ПересчетГрафика(ДокументГрафикаОбъект, 0, ОписаниеГрафика, ОперацииГрафика, СтруктураДействий);
	
	Если Не ПустаяСтрока(ОписаниеГрафика.ТекстОшибки) Тогда
		ТекстОшибки = ОписаниеГрафика.ТекстОшибки;
		Возврат Неопределено;
	КонецЕсли;   
	
	ПланГрафика = ДокументГрафикаОбъект.ГрафикРасчетов.Выгрузить();
	
	// Факт графика
	ДокументГрафикаОбъект.ГрафикРасчетов.Очистить();
	ПустойГрафикРасчетов = ДокументГрафикаОбъект.ГрафикРасчетов.Выгрузить();
	ФактГрафика = РаботаСДоговорамиКонтрагентовУХ.ПеренестиФактВГрафик(ПустойГрафикРасчетов, ДатаАктуализации, 
						ДокументГрафикаОбъект.ДоговорКонтрагента, ОбъектРасчетов, ОписаниеГрафика, ОперацииГрафика);	
	
	// Новый график с учетом плана и факта  
	ПараметрыОтбора = Новый Структура; 
	ПараметрыОтбора.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг); 
	
	ДатаОкончанияДействия =  ?(ДокументГрафикаОбъект.ВозобновляемыйЛимит, Неопределено, ДокументГрафикаОбъект.ДатаОкончанияДействия);
	
	НовыйГрафикРасчетов = РаспределитьПланНаФактГрафика(ПланГрафика, ФактГрафика, ПараметрыОтбора, ДатаОкончанияДействия);	
	ДокументГрафикаОбъект.ГрафикРасчетов.Загрузить(НовыйГрафикРасчетов);
	
	Секции = Новый Массив;
	Секции.Добавить("Проценты");
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика", Секции));  	
	СтруктураДействий.Вставить("Замкнуть", Новый Структура("СекцииГрафика", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ОсновнойДолг")));
	
	ФинансовыеИнструментыУХ.ПересчетГрафика(ДокументГрафикаОбъект, 0, ОписаниеГрафика, ОперацииГрафика,	СтруктураДействий);    
	
	Если Не ПустаяСтрока(ОписаниеГрафика.ТекстОшибки) Тогда
		ТекстОшибки = ОписаниеГрафика.ТекстОшибки;
		Возврат Неопределено;
	КонецЕсли;   
		
	ПланГрафика = ДокументГрафикаОбъект.ГрафикРасчетов.Выгрузить();   
	
	ПараметрыОтбора = Новый Структура; 
	ПараметрыОтбора.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.Проценты);
	
	ГрафикРасчетовПроценты = РаспределитьПланНаФактГрафика(ПланГрафика, ФактГрафика, ПараметрыОтбора);	 
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ГрафикРасчетовПроценты, НовыйГрафикРасчетов);
	НовыйГрафикРасчетов.Сортировать("Дата");   
	
	Возврат НовыйГрафикРасчетов;

КонецФункции   

Функция СобытиеЖурналаРегистрацииАктуализацияГрафика()
	
	Возврат НСтр("ru = 'Актуализация графика расчетов'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции   

Функция РаспределитьПланНаФактГрафика(ИсхПланГрафика, ИсхФактГрафика, ПараметрыОтбора, ДатаОкончанияДействия = Неопределено) 
	
	ИсхПланГрафика.Колонки.Удалить("НомерСтроки");
	ИсхПланГрафика.ЗаполнитьЗначения(Неопределено, "ИдентификаторПозицииГрафика");  
	ОбщегоНазначенияУХ.СвернутьПоИзмерениям(ИсхПланГрафика, , "Сумма, СуммаРасчет, СуммаКорректировка");   
	
	ПланГрафика = ИсхПланГрафика.Скопировать(ПараметрыОтбора);
	ПланГрафика.Колонки.Добавить("Распределено", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ПланГрафика.Сортировать("Дата");   	
	
	НовыйГрафик = ИсхФактГрафика.Скопировать(ПараметрыОтбора);
	НовыйГрафик.Колонки.Добавить("Распределено", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	НовыйГрафик.Сортировать("Дата");  
		
	// Распределение плановых оплат на факт
	Для Каждого СтрокаПлан Из ПланГрафика Цикл
			
		Если СтрокаПлан.Сумма <= 0 Тогда
			Продолжить; // Некорректные данные
		КонецЕсли;   		
		
		Для Каждого СтрокаФакт Из НовыйГрафик Цикл
			
			Если СтрокаФакт.ЭлементСтруктурыЗадолженности = СтрокаПлан.ЭлементСтруктурыЗадолженности
				И СтрокаФакт.КолонкаСекции = СтрокаПлан.КолонкаСекции Тогда   
					
				Остаток = (СтрокаФакт.Сумма - СтрокаФакт.Распределено);
				Если Остаток > 0 Тогда
					Распределено = Мин(Остаток, СтрокаПлан.Сумма - СтрокаПлан.Распределено);
					СтрокаФакт.Распределено = СтрокаФакт.Распределено + Распределено;
					СтрокаПлан.Распределено = СтрокаПлан.Распределено + Распределено;
				КонецЕсли;
				
				Если СтрокаПлан.Распределено = СтрокаПлан.Сумма Тогда
					Прервать;
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		Если СтрокаПлан.Распределено < СтрокаПлан.Сумма Тогда   				
		
			// Получим  сумму распределения для возобновляемых линий   
			Если СтрокаПлан.ЭлементСтруктурыЗадолженности = Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг Тогда 
				СуммаРаспределено = 0;
				Для каждого СтрокаВстречный Из НовыйГрафик Цикл
					Если СтрокаВстречный.НаправлениеДвижения  = СтрокаПлан.НаправлениеДвижения Тогда
						Продолжить;	
					КонецЕсли;
					СуммаРаспределено = СуммаРаспределено + СтрокаВстречный.Сумма;
				КонецЦикла;
				Распределено = (Макс(СтрокаПлан.Сумма, СуммаРаспределено) - СтрокаПлан.Распределено);
       		Иначе	
				Распределено = (СтрокаПлан.Сумма - СтрокаПлан.Распределено);
			КонецЕсли;
			НоваяСтрока = НовыйГрафик.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлан);
			НоваяСтрока.Сумма = Распределено;
			НоваяСтрока.СуммаРасчет = Распределено;
			НоваяСтрока.Распределено = Распределено;
			Если СтрокаПлан.ЭлементСтруктурыЗадолженности = Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг 
					И ЗначениеЗаполнено(ДатаОкончанияДействия) Тогда 
            	НоваяСтрока.Дата = ДатаОкончанияДействия;
			КонецЕсли;	
			
		КонецЕсли;		
		
	КонецЦикла;
	
	НовыйГрафик.Колонки.Удалить("НомерСтроки");
	НовыйГрафик.Колонки.Удалить("Распределено");
	НовыйГрафик.ЗаполнитьЗначения(Неопределено, "ИдентификаторПозицииГрафика");
	
	ОбщегоНазначенияУХ.СвернутьПоИзмерениям(НовыйГрафик, , "Сумма, СуммаРасчет, СуммаКорректировка");
	
	Для Каждого СтрокаГрафика Из НовыйГрафик Цикл
		СтрокаГрафика.ИдентификаторПозицииГрафика = Новый УникальныйИдентификатор;
	КонецЦикла;
	
	НовыйГрафик.Сортировать("Дата");
	
	Возврат НовыйГрафик;
		
КонецФункции

Процедура СоздатьОповещениеАктуализацияГрафикаРасчета(ПараметрыОбъектРасчетов, РезультатАктуализации, НастройкиОповещения)  

	Если Не НастройкиОповещения.ОповещениеВключено Тогда
		Возврат;	
	КонецЕсли;
	
	Если РезультатАктуализации.Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	Если Не ЗначениеЗаполнено(ПараметрыОбъектРасчетов.Ответственный) Тогда
		Возврат;
	КонецЕсли; 	

	ВидСобытия = Справочники.ВидыСобытийОповещений.АктуализацияГрафиковРасчетов;
	
	Задача = СоздатьЗадачу(ПараметрыОбъектРасчетов, РезультатАктуализации);
	
	СтруктураСобытия = Новый Структура;
	СтруктураСобытия.Вставить("СпособОповещения", Перечисления.СпособыОповещения.ВСистеме);
	СтруктураСобытия.Вставить("Получатель",	ПараметрыОбъектРасчетов.Ответственный);
	СтруктураСобытия.Вставить("ВидСобытия",	ВидСобытия);
	СтруктураСобытия.Вставить("Источник", ПараметрыОбъектРасчетов.ОбъектРасчетов);
	СтруктураСобытия.Вставить("Задача",	Задача);       
	
	НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ПараметрыОбъектРасчетов.ОбъектРасчетов);
	НавигационнаяСсылкаПредставление = "<a href='" + НавигационнаяСсылка 
								+ "'>" + ПараметрыОбъектРасчетов.ОбъектРасчетов + "</a>";
	
	Если РезультатАктуализации.Состояние Тогда  
		             
		ШаблонСообщения = НСтр("ru = 'Успешная актуализация графика расчетов по объекту %1'");  	
		Тема = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ПараметрыОбъектРасчетов.ОбъектРасчетов); 
		
		ШаблонСообщения = НСтр("ru = 'Актуализация графика расчетов по объекту %1 выполнена успешно'"); 	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НавигационнаяСсылкаПредставление); 
	
	Иначе
		
		ШаблонСообщения = НСтр("ru = 'Ошибка при актуализация графика расчетов по объекту %1'");  	
		Тема = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ПараметрыОбъектРасчетов.ОбъектРасчетов);
		
		ШаблонСообщения = НСтр("ru = 'При актуализации графика расчета по объекту %1 возникла ошибка:'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НавигационнаяСсылкаПредставление) 
							+ Символы.ПС + РезультатАктуализации.ОписаниеОшибки;
		
	КонецЕсли;
	
	СтруктураСобытия.Вставить("Тема", Тема);
	СтруктураСобытия.Вставить("ТекстСообщения", ТекстСообщения); 
	
	СобытияОповещенийСерверУХ.СоздатьЗаписьСобытияПоСтруктуре(СтруктураСобытия);  

КонецПроцедуры  

Функция СоздатьЗадачу(ПараметрыОбъектРасчетов, РезультатАктуализации)  
	
	Задача = Справочники.Задачи.ПустаяСсылка();
	
	Если Не РезультатАктуализации.Состояние = Ложь Тогда // Создание задачи при ошибке актуализации
		Возврат Задача;	
	КонецЕсли;

	ПустойПроцесс = Документы.ЭкземплярПроцесса.ПустаяСсылка();
	ПустойЭтап = Справочники.ЭтапыУниверсальныхПроцессов.ПустаяСсылка();
	ПустойВидДействия = Перечисления.СобытияОтложеннойОбработкиПроцессов.ПустаяСсылка();

	Попытка
		ЭлементЗадачи = Справочники.Задачи.СоздатьЭлемент(); 
		ЭлементЗадачи.Наименование = ПараметрыОбъектРасчетов.ОбъектРасчетов;
		ЭлементЗадачи.СвязанныйОбъект = ПараметрыОбъектРасчетов.ОбъектРасчетов;
		ЭлементЗадачи.Записать();
		
		Задача = ЭлементЗадачи.Ссылка;
		МодульРегламентныхЗаданийУХ.СоздатьЗадачу(Задача, ПараметрыОбъектРасчетов.Ответственный, 
												ПустойПроцесс, ПустойЭтап, ПустойВидДействия);
	Исключение    	
	КонецПопытки;   
	
	Возврат Задача;
	
КонецФункции

#КонецОбласти

