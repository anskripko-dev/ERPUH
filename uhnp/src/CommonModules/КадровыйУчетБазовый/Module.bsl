	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДоговорыГПХ.ДоговорГПХ КАК ДоговорГПХ,
		|	ДоговорыГПХ.ДоговорГПХ.ОблагаетсяФСС_НС КАК ОблагаетсяНСПЗ
