Процедура РассчитатьСуммыВВалютеЛимитированияДляКонтроля(Запрос, ИмяВременнойТаблицыДанныхПланирования)
	
	УстановитьПривилегированныйРежим(Истина);   
	
	ВременнаяТаблицаЗапроса = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицыДанныхПланирования);  
	
	Если Не ВременнаяТаблицаЗапроса = Неопределено Тогда
		Таблица = ВременнаяТаблицаЗапроса.ПолучитьДанные().Выгрузить();   
		
		Если Таблица.Количество() = 0 Тогда
			ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ДвиженияЛимитыПоБюджетам", Таблица);
			Возврат;
		КонецЕсли;  
	КонецЕсли;
	
	ДобавитьКолонкиПланирования(Запрос, ИмяВременнойТаблицыДанныхПланирования);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВТ_Данные.ПриходРасход КАК ПриходРасход,
	|	ВТ_Данные.ВидБюджета КАК ВидБюджета,
	|	ВТ_Данные.ДокументРезервирования КАК ДокументРезервирования,
	|	ВТ_Данные.ДокументПланирования КАК ДокументПланирования,
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	ВТ_Данные.ЦФО КАК ЦФО,
	|	ВТ_Данные.Проект КАК Проект,
	|	ВТ_Данные.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_Данные.Аналитика1 КАК Аналитика1,
	|	ВТ_Данные.Аналитика2 КАК Аналитика2,
	|	ВТ_Данные.Аналитика3 КАК Аналитика3,
	|	ВТ_Данные.Аналитика4 КАК Аналитика4,
	|	ВТ_Данные.Аналитика5 КАК Аналитика5,
	|	ВТ_Данные.Аналитика6 КАК Аналитика6,
	|	ВЫБОР
	|		КОГДА ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА ВТ_Данные.Валюта
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.Валюта = ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования
	|			ТОГДА ВТ_Данные.Лимит
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НЕ ВТ_Данные.КурсЗаданВОперации ИЛИ ВТ_Данные.КурсПланирования = 0
	|						ИЛИ ВТ_Данные.КратностьПланирования = 0
	|					ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Лимит * ВТ_ПараметрыЛимитированияКурсы.КроссКурс КАК ЧИСЛО(18, 2))
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_Данные.Лимит * (ВТ_Данные.КурсПланирования / ВТ_Данные.КратностьПланирования) КАК ЧИСЛО(18, 2))
	|			КОНЕЦ
	|	КОНЕЦ КАК Лимит,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.Валюта = ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования
	|			ТОГДА ВТ_Данные.Зарезервировано
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НЕ ВТ_Данные.КурсЗаданВОперации ИЛИ ВТ_Данные.КурсПланирования = 0
	|						ИЛИ ВТ_Данные.КратностьПланирования = 0
	|					ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Зарезервировано * ВТ_ПараметрыЛимитированияКурсы.КроссКурс КАК ЧИСЛО(18, 2))
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_Данные.Зарезервировано * (ВТ_Данные.КурсПланирования / ВТ_Данные.КратностьПланирования) КАК ЧИСЛО(18, 2))
	|			КОНЕЦ
	|	КОНЕЦ КАК Зарезервировано,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.Валюта = ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования
	|			ТОГДА ВТ_Данные.Заявлено
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НЕ ВТ_Данные.КурсЗаданВОперации ИЛИ ВТ_Данные.КурсПланирования = 0
	|						ИЛИ ВТ_Данные.КратностьПланирования = 0
	|					ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Заявлено * ВТ_ПараметрыЛимитированияКурсы.КроссКурс КАК ЧИСЛО(18, 2))
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_Данные.Заявлено * (ВТ_Данные.КурсПланирования / ВТ_Данные.КратностьПланирования) КАК ЧИСЛО(18, 2))
	|			КОНЕЦ
	|	КОНЕЦ КАК Заявлено,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.Валюта = ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования
	|			ТОГДА ВТ_Данные.Исполнено
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НЕ ВТ_Данные.КурсЗаданВОперации ИЛИ ВТ_Данные.КурсПланирования = 0
	|						ИЛИ ВТ_Данные.КратностьПланирования = 0
	|					ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Исполнено * ВТ_ПараметрыЛимитированияКурсы.КроссКурс КАК ЧИСЛО(18, 2))
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_Данные.Исполнено * (ВТ_Данные.КурсПланирования / ВТ_Данные.КратностьПланирования) КАК ЧИСЛО(18, 2))
	|			КОНЕЦ
	|	КОНЕЦ КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ДвиженияЛимитыПоБюджетам
	|ИЗ
	|	ВТ_ТаблицаПлановССуммамиЛимитирования КАК ВТ_Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВалютыЛимитированияПоДатамЦФО КАК ВТ_ВалютыЛимитированияПоДатамЦФО
	|		ПО ВТ_Данные.ВидБюджета = ВТ_ВалютыЛимитированияПоДатамЦФО.ВидБюджета
	|			И ВТ_Данные.ЦФО = ВТ_ВалютыЛимитированияПоДатамЦФО.ЦФО
	|			И ВТ_Данные.ДатаОперации = ВТ_ВалютыЛимитированияПоДатамЦФО.ДатаОперации
	|			И ВТ_Данные.Валюта = ВТ_ВалютыЛимитированияПоДатамЦФО.Валюта
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитированияКурсы КАК ВТ_ПараметрыЛимитированияКурсы
	|		ПО ВТ_Данные.Валюта = ВТ_ПараметрыЛимитированияКурсы.ВалютаОперации
	|			И ВТ_Данные.ДатаОперации = ВТ_ПараметрыЛимитированияКурсы.ДатаОперации
	|			И (ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования = ВТ_ПараметрыЛимитированияКурсы.ВалютаЛимитирования)
	|ГДЕ
	|	ВТ_Данные.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицыДанныхПланирования);    
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();   
	
КонецПроцедуры

Процедура ДобавитьКолонкиПланирования(Запрос, ИмяВременнойТаблицыДанныхПланирования)
	
	ВременнаяТаблицаЗапроса = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицыДанныхПланирования); 
	
	Если Не ВременнаяТаблицаЗапроса = Неопределено Тогда  	                      
		
		ЕстьКолонкиПланирования = Не (ВременнаяТаблицаЗапроса.Колонки.Найти("КурсПланирования") = Неопределено 
							 И ВременнаяТаблицаЗапроса.Колонки.Найти("КратностьПланирования") = Неопределено
							 И ВременнаяТаблицаЗапроса.Колонки.Найти("КурсЗаданВОперации") = Неопределено);
		
		Если Не ЕстьКолонкиПланирования Тогда
			
			Таблица = ВременнаяТаблицаЗапроса.ПолучитьДанные().Выгрузить();    
			
			Если Таблица.Колонки.Найти("КурсЗаданВОперации") = Неопределено Тогда
				Таблица.Колонки.Добавить("КурсЗаданВОперации", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());	
			КонецЕсли;  

			Если Таблица.Колонки.Найти("КурсПланирования") = Неопределено Тогда
				Таблица.Колонки.Добавить("КурсПланирования", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1));	
			КонецЕсли;  
			
			Если Таблица.Колонки.Найти("КратностьПланирования") = Неопределено Тогда
				Таблица.Колонки.Добавить("КратностьПланирования", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1));	
			КонецЕсли;
			            		
			Запрос.Текст = "УНИЧТОЖИТЬ " + ИмяВременнойТаблицыДанныхПланирования;
			Запрос.Выполнить();
			
