Процедура КонтрольПараметрыЛимитированияКурсыВалют(ВалютыЛимитирования, Регистратор, Отказ)

	РезультатЗапроса = ПараметрыЛимитированияКонтрольВалют(ВалютыЛимитирования);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;	
	КонецЕсли;  
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	ПредставлениеРегистра = Метаданные.РегистрыСведений.ПараметрыЛимитированияКурсыВалют.Представление();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ШаблонСообщения = НСтр("ru = '%1: в регистре ""%2"" на дату ""%3"" отсутствуют сведения о валюте: ""%4""'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Регистратор, ПредставлениеРегистра, 
						Формат(ВыборкаДетальныеЗаписи.Период, НСтр("ru='ДФ=''dd.MM.yyyy'''")), 
						ВыборкаДетальныеЗаписи.ВалютаЛимитирования);    
						
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		
	КонецЦикла;

КонецПроцедуры  

Функция ПараметрыЛимитированияКонтрольВалют(ВалютыЛимитирования) Экспорт
	
	ВалютыЛимитирования.Свернуть("Период, ВалютаЛимитирования");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВалютыЛимитирования.Период КАК Период,
	|	ВалютыЛимитирования.ВалютаЛимитирования КАК ВалютаЛимитирования
	|ПОМЕСТИТЬ ВТ_ВалютыЛимитирования
	|ИЗ
	|	&ВалютыЛимитирования КАК ВалютыЛимитирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ВалютыЛимитирования.Период КАК Период,
	|	ВТ_ВалютыЛимитирования.ВалютаЛимитирования КАК ВалютаЛимитирования
	|ИЗ
	|	ВТ_ВалютыЛимитирования КАК ВТ_ВалютыЛимитирования
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияКурсыВалют КАК ПараметрыЛимитированияКурсыВалют
	|		ПО ВТ_ВалютыЛимитирования.ВалютаЛимитирования = ПараметрыЛимитированияКурсыВалют.Валюта
	|			И ВТ_ВалютыЛимитирования.Период > ПараметрыЛимитированияКурсыВалют.Период
	|ГДЕ
	|	ПараметрыЛимитированияКурсыВалют.Валюта ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ВалютыЛимитирования", ВалютыЛимитирования);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Возврат РезультатЗапроса;
	
КонецФункции  

Функция ОпределитьВалютуЛимитированияПоДокументу(Запрос) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос.Текст = 
