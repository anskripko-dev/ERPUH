	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Данные.ВидБюджета КАК ВидБюджета,
	|	ВТ_Данные.ЦФО КАК ЦФО,
	|	ВТ_Данные.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.СпособОпределенияВалютыЛимитирования = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаУпрУчета)
	|			ТОГДА &ВалютаУпрУчета
	|		КОГДА ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.СпособОпределенияВалютыЛимитирования = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаЛимитированияЦФО)
	|			ТОГДА ЕСТЬNULL(ПараметрыЛимитированияВалютыЦФО.ВалютаЛимитирования, ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ВалютаПоУмолчанию)
	|		ИНАЧЕ ВТ_Данные.Валюта
	|	КОНЕЦ КАК ВалютаЛимитирования
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации КАК ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации
	|		ПО ВТ_Данные.ВидБюджета = ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ВидБюджета
	|			И ВТ_Данные.ДатаОперации = ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ДатаОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияВалютыЦФО КАК ПараметрыЛимитированияВалютыЦФО
	|		ПО (ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ВидБюджета = ПараметрыЛимитированияВалютыЦФО.ВидБюджета)
	|			И ВТ_Данные.ЦФО = ПараметрыЛимитированияВалютыЦФО.ЦФО
	|			И (ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.НачалоДействия = ПараметрыЛимитированияВалютыЦФО.Период)
	|			И (ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ДатаОперации = ВТ_Данные.ДатаОперации)";
	
	Запрос.УстановитьПараметр("ВалютаУпрУчета", ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуУправленческогоУчета());  
	
	Возврат Запрос.Выполнить();   
	
КонецФункции

 #КонецОбласти

#Область КонтрольЛимитов32

Процедура ПолучитьПараметрыКонтроля_СтатьиБюджета(Запрос, ИмяВременнойТаблицыДанныхПланирования) Экспорт
	
	ПараметрыЛимитированияЗапросом(Запрос, ИмяВременнойТаблицыДанныхПланирования);
	
КонецПроцедуры

Процедура ПараметрыЛимитированияЗапросом(Запрос, ИмяВременнойТаблицыДанныхПланирования)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос.Текст = ПараметрыЛимитированияТекстомЗапроса(ИмяВременнойТаблицыДанныхПланирования);
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПараметрыЛимитированияТекстомЗапроса(ИмяВременнойТаблицыДанныхПланирования)
	
	ТекстЗапроса = ТекстЗапроса_ПараметрыКонтроляСводно();

	//
	ТекстОтбора = СтрШаблон(
		"ПараметрыЛимитирования.ВидБюджета В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				Данные.ВидБюджета
		|			ИЗ
		|				%1 КАК Данные)", ИмяВременнойТаблицыДанныхПланирования);
	
	Возврат СтрЗаменить(ТекстЗапроса, "&ОтборыПараметровЛимитирования", ТекстОтбора);
	
КонецФункции

Функция ТекстЗапроса_ПараметрыКонтроляСводно()
	
	ШаблонЗапросаСтатей = 
	"ВЫБРАТЬ
	|	%1 КАК ВидБюджета,
	|	СправочникСтатей.Ссылка КАК СтатьяБюджета
	|ПОМЕСТИТЬ ВТ_ВсеСтатьиБюджетов
	|ИЗ
	|	Справочник.%2 КАК СправочникСтатей
	|ГДЕ
	|	СправочникСтатей.ЭтоГруппа = ЛОЖЬ";
	
	Запросы = Новый Массив;
	
	//
	ВидыБюджетов = Новый Массив;
	ВидыБюджетов.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	ВидыБюджетов.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	Для Каждого ВидБюджета Из ВидыБюджетов Цикл
		ЗначениеВидБюджета = СтрШаблон("ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.%1)", 
								ВидБюджета.ИмяПредопределенныхДанных);
		
		Для Каждого ТипСтатьи Из ВидБюджета.ТипЗначения.Типы() Цикл
			ПустоеЗначение = Новый (ТипСтатьи);
			ИмяСправочникаСтатей = ПустоеЗначение.Метаданные().Имя;
			
			ТекстЗапросаСтатей = Стршаблон(ШаблонЗапросаСтатей, ЗначениеВидБюджета, ИмяСправочникаСтатей);
			Запросы.Добавить(ТекстЗапросаСтатей);
		КонецЦикла;
		
		ШаблонЗапросаСтатей = СтрЗаменить(ШаблонЗапросаСтатей, "ПОМЕСТИТЬ ВТ_ВсеСтатьиБюджетов", "");
		
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(Запросы, "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|");
	
	Запросы.Очистить();
	Запросы.Добавить(ТекстЗапроса);
	Запросы.Добавить(
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.Период КАК НачалоДействия,
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ВЫБОР
	|		КОГДА ПараметрыЛимитирования.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
	|				ИЛИ ПараметрыЛимитирования.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Контролировать,
	|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитирования.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитирования.КонтрольРезервов КАК КонтрольРезервов,
	|	ПараметрыЛимитирования.РезервированиеВПериодичностиПланирования КАК РезервированиеВПериодичностиПланирования,
	|	ПараметрыЛимитирования.ПериодичностьПланирования КАК ПериодичностьПланирования
	|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияБюджетов
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	&ОтборыПараметровЛимитирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПараметрыЛимитированияБюджетов.НачалоДействия КАК НачалоДействия,
	|	ПараметрыСтатей.СтатьяБюджета КАК СтатьяБюджета,
	|	ВЫБОР
	|		КОГДА ПараметрыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
	|				ИЛИ ПараметрыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Контролировать,
	|	ПараметрыСтатей.КонтролироватьАналитику1 КАК КонтролироватьАналитику1,
	|	ПараметрыСтатей.КонтролироватьАналитику2 КАК КонтролироватьАналитику2,
	|	ПараметрыСтатей.КонтролироватьАналитику3 КАК КонтролироватьАналитику3,
	|	ПараметрыСтатей.КонтролироватьАналитику4 КАК КонтролироватьАналитику4,
	|	ПараметрыСтатей.КонтролироватьАналитику5 КАК КонтролироватьАналитику5,
	|	ПараметрыСтатей.КонтролироватьАналитику6 КАК КонтролироватьАналитику6,
	|	ПараметрыСтатей.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыСтатей.КонтрольРезервов КАК КонтрольРезервов
	|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияСтатейБюджетов
	|ИЗ
	|	ВТ_ПараметрыЛимитированияБюджетов КАК ВТ_ПараметрыЛимитированияБюджетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК ПараметрыСтатей
	|		ПО ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета = ПараметрыСтатей.ВидБюджета
	|			И ВТ_ПараметрыЛимитированияБюджетов.НачалоДействия = ПараметрыСтатей.Период
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета,
	|	ВТ_ПараметрыЛимитированияБюджетов.НачалоДействия,
	|	ВТ_ВсеСтатьиБюджетов.СтатьяБюджета,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияБюджетов.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
	|				ИЛИ ВТ_ПараметрыЛимитированияБюджетов.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ВТ_ПараметрыЛимитированияБюджетов.КонтрольЛимитов,
	|	ВТ_ПараметрыЛимитированияБюджетов.КонтрольРезервов
	|ИЗ
	|	ВТ_ПараметрыЛимитированияБюджетов КАК ВТ_ПараметрыЛимитированияБюджетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВсеСтатьиБюджетов КАК ВТ_ВсеСтатьиБюджетов
	|		ПО ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета = ВТ_ВсеСтатьиБюджетов.ВидБюджета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК ПараметрыСтатей
	|		ПО ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета = ПараметрыСтатей.ВидБюджета
	|			И ВТ_ПараметрыЛимитированияБюджетов.НачалоДействия = ПараметрыСтатей.Период
	|			И (ВТ_ВсеСтатьиБюджетов.СтатьяБюджета = ПараметрыСтатей.СтатьяБюджета)
	|ГДЕ
	|	ПараметрыСтатей.СтатьяБюджета ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПараметрыЛимитированияБюджетов.НачалоДействия КАК НачалоДействия,
	|	ПараметрыЛимитированияГруппыСтатейСостав.ГруппаСтатей КАК ГруппаСтатей,
	|	ПараметрыЛимитированияГруппыСтатейСостав.СтатьяБюджета КАК СтатьяБюджета,
	|	ПараметрыЛимитированияГруппыСтатей.ИнаяПериодичность КАК ИнаяПериодичность,
	|	ПараметрыЛимитированияГруппыСтатей.Периодичность КАК Периодичность,
	|	ПараметрыЛимитированияГруппыСтатей.КонтрольПоГруппе КАК КонтрольПоГруппе,
	|	ПараметрыЛимитированияГруппыСтатей.ИноеДействие КАК ИноеДействие,
	|	ПараметрыЛимитированияГруппыСтатей.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитированияГруппыСтатей.КонтрольРезервов КАК КонтрольРезервов,
	|	ВЫБОР
	|		КОГДА ПараметрыЛимитированияГруппыСтатей.ИноеДействие
	|				И (ПараметрыЛимитированияГруппыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
	|					ИЛИ ПараметрыЛимитированияГруппыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Контролировать
	|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияГруппСтатей
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияГруппыСтатей КАК ПараметрыЛимитированияГруппыСтатей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав КАК ПараметрыЛимитированияГруппыСтатейСостав
	|		ПО ПараметрыЛимитированияГруппыСтатей.ВидБюджета = ПараметрыЛимитированияГруппыСтатейСостав.ВидБюджета
	|			И ПараметрыЛимитированияГруппыСтатей.Период = ПараметрыЛимитированияГруппыСтатейСостав.Период
	|			И ПараметрыЛимитированияГруппыСтатей.ГруппаСтатей = ПараметрыЛимитированияГруппыСтатейСостав.ГруппаСтатей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитированияБюджетов КАК ВТ_ПараметрыЛимитированияБюджетов
	|		ПО ПараметрыЛимитированияГруппыСтатей.ВидБюджета = ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета
	|			И ПараметрыЛимитированияГруппыСтатей.Период = ВТ_ПараметрыЛимитированияБюджетов.НачалоДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПараметрыЛимитированияГруппСтатей.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПараметрыЛимитированияГруппСтатей.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПараметрыЛимитированияГруппСтатей.НачалоДействия КАК НачалоДействия,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияГруппСтатей.КонтрольПоГруппе
	|			ТОГДА ВТ_ПараметрыЛимитированияГруппСтатей.ГруппаСтатей
	|		ИНАЧЕ ВТ_ПараметрыЛимитированияГруппСтатей.СтатьяБюджета
	|	КОНЕЦ КАК ОбъектКонтроля,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияГруппСтатей.ИнаяПериодичность
	|			ТОГДА ВТ_ПараметрыЛимитированияГруппСтатей.Периодичность
	|		ИНАЧЕ ВТ_ПараметрыЛимитированияБюджетов.ПериодичностьЛимитирования
	|	КОНЕЦ КАК ПериодичностьКонтроля,
	|	ВТ_ПараметрыЛимитированияБюджетов.ПериодичностьПланирования,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияГруппСтатей.ИноеДействие
	|			ТОГДА ВТ_ПараметрыЛимитированияГруппСтатей.КонтрольЛимитов
	|		ИНАЧЕ ВТ_ПараметрыЛимитированияБюджетов.КонтрольЛимитов
	|	КОНЕЦ КАК КонтрольЛимитов,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияГруппСтатей.ИноеДействие
	|			ТОГДА ВТ_ПараметрыЛимитированияГруппСтатей.КонтрольРезервов
	|		ИНАЧЕ ВТ_ПараметрыЛимитированияБюджетов.КонтрольРезервов
	|	КОНЕЦ КАК КонтрольРезервов,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияГруппСтатей.ИноеДействие
	|			ТОГДА ВТ_ПараметрыЛимитированияГруппСтатей.Контролировать
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ПараметрыЛимитированияСтатейБюджетов.Контролировать, ВТ_ПараметрыЛимитированияБюджетов.Контролировать)
	|	КОНЕЦ КАК Контролировать,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияГруппСтатей.КонтрольПоГруппе
	|				ИЛИ ВТ_ПараметрыЛимитированияГруппСтатей.СтатьяБюджета.ВидАналитики1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
