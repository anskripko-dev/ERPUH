// Процедура возвращает пустую таблицу планов документа
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция Новый_ТаблицаПланыДокумента() Экспорт
	
	ТаблицаПланов = Новый ТаблицаЗначений;	
	Для ном = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ТаблицаПланов.Колонки.Добавить("Аналитика" + Формат(ном, "ЧГ="), Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип));
	КонецЦикла;
	
	ТаблицаПланов.Колонки.Добавить("Валюта", 		Новый ОписаниеТипов("СправочникСсылка.Валюты"));
    ТаблицаПланов.Колонки.Добавить("ВидБюджета", 	Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыБюджетов"));
	ТаблицаПланов.Колонки.Добавить("ДатаОперации", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаПланов.Колонки.Добавить("ДатаРегистрации", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаПланов.Колонки.Добавить("ДоговорКонтрагента", 		Метаданные.ОпределяемыеТипы.Договор.Тип);
	ТаблицаПланов.Колонки.Добавить("ДокументРезервирования", 	Метаданные.ОпределяемыеТипы.ДокументыРезервирования.Тип); 
	ТаблицаПланов.Колонки.Добавить("ДокументПланирования", 	Метаданные.ОпределяемыеТипы.ДокументыПланирования.Тип);

    МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Контрагенты"));
	МассивТипов.Добавить(Тип("СправочникСсылка.ФизическиеЛица"));
	ОписаниеТиповКонтрагент = Новый ОписаниеТипов(МассивТипов);                                             
	
	ТаблицаПланов.Колонки.Добавить("Контрагент", 		ОписаниеТиповКонтрагент);                         
	ТаблицаПланов.Колонки.Добавить("Организация", 		Новый ОписаниеТипов("СправочникСсылка.Организации"));
    ТаблицаПланов.Колонки.Добавить("Период", 			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
    ТаблицаПланов.Колонки.Добавить("ПериодОтчета", 		Новый ОписаниеТипов("СправочникСсылка.Периоды"));
    ТаблицаПланов.Колонки.Добавить("Предназначение", 	Новый ОписаниеТипов("ПеречислениеСсылка.ПредназначенияЭлементовСтруктурыОтчета"));
    ТаблицаПланов.Колонки.Добавить("ПриходРасход", 		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход"));
    ТаблицаПланов.Колонки.Добавить("Проект", 			Новый ОписаниеТипов("СправочникСсылка.Проекты"));
    ТаблицаПланов.Колонки.Добавить("СтатьяБюджета", 	Метаданные.ПланыВидовХарактеристик.ВидыБюджетов.Тип);
	ТаблицаПланов.Колонки.Добавить("Сумма", 			ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ТаблицаПланов.Колонки.Добавить("ЦФО", 				Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Возврат ТаблицаПланов;
	
КонецФункции

// Процедура помещает в Параметры.Отбор.Ссылка лимитируемые в указанном периоде статьи вида бюджетов.
Процедура ОбработкаПолученияКонтролируемыхСтатейБюджетов(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	Если Параметры.Отбор.Свойство("ПараметрыЛимитирования_ВидБюджета") 
		И Параметры.Отбор.Свойство("ПараметрыЛимитирования_Период") Тогда
		
		Запрос = Новый Запрос;
		Если ТипЗнч(Параметры.Отбор.ПараметрыЛимитирования_Период) = Тип("СправочникСсылка.Периоды") Тогда
			Запрос.УстановитьПараметр("Период", Параметры.Отбор.ПараметрыЛимитирования_Период.ДатаНачала);
		Иначе
			Запрос.УстановитьПараметр("Период", Параметры.Отбор.ПараметрыЛимитирования_Период);
		КонецЕсли;
		
		Если Параметры.Отбор.ПараметрыЛимитирования_ВидБюджета 
				= Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств Тогда
			Запрос.УстановитьПараметр("ВидБюджета", 
				ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
		ИначеЕсли Параметры.Отбор.ПараметрыЛимитирования_ВидБюджета 
				= Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов Тогда
			Запрос.УстановитьПараметр("ВидБюджета", 
				ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
		Иначе
			Запрос.УстановитьПараметр("ВидБюджета", Параметры.Отбор.ПараметрыЛимитирования_ВидБюджета);
		КонецЕсли;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыКонтроляЛимитаСтатейБюджетовСрезПоследних.СтатьяБюджета КАК СтатьяБюджета
		|ИЗ
		|	РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.СрезПоследних(&Период, ВидБюджета = &ВидБюджета) КАК ПараметрыКонтроляЛимитаСтатейБюджетовСрезПоследних
		|ГДЕ
		|	ПараметрыКонтроляЛимитаСтатейБюджетовСрезПоследних.КонтролироватьСтатью = ИСТИНА";
		
		Параметры.Отбор.Вставить("Ссылка", Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СтатьяБюджета"));
		
	КонецЕсли;
	
КонецПроцедуры

#Область ПроцедурыПересчетаСуммЛимитовПриИзмененииНастроек

// Процедура - Выполняет расчет значений лимитов для набора записей рн.ОперацииБюджетов
//
// Параметры:
//  НаборЗаписей - НаборЗаписей.ОперацииБюджетов	- Набор записей регистра накопления ОперацииБюджетов
//
Процедура ВыполнитьРасчетСуммЛимитирования(НаборЗаписей, Отказ) Экспорт
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей.ДополнительныеСвойства.Свойство("ПересчетПриИзмененииПараметровЛимитирования") Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей.ДополнительныеСвойства.Свойство("ЭтоРучнаяКорректировка")
		И НаборЗаписей.ДополнительныеСвойства.ЭтоРучнаяКорректировка Тогда
		Возврат;
	КонецЕсли;
	
	Данные = НаборЗаписей.Выгрузить();
	Номер = 0;
	Для Каждого Строка Из Данные Цикл
		Номер = Номер + 1;
		Строка.НомерСтроки = Номер;
	КонецЦикла;
	
	// не помещается во временную таблицу запроса
	Данные.Колонки.Удалить("МоментВремени");
	
	//
	ИмяВременнойТаблицыПланирования = "ВТ_Данные";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// 2. Получить данные для расчета
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "Коллекция", Данные);
	
	Запрос.УстановитьПараметр("Коллекция", Данные);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Коллекция.Регистратор КАК Регистратор,
	|	Коллекция.НомерСтроки КАК НомерСтроки,
	|	Коллекция.ВидБюджета КАК ВидБюджета,
	|	Коллекция.Период КАК ДатаОперации,
	|	Коллекция.АналитикаСтруктуры.Организация КАК Организация,
	|	Коллекция.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	Коллекция.АналитикаСтруктуры.Проект КАК Проект,
	|	Коллекция.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	Коллекция.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|	Коллекция.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|	Коллекция.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|	Коллекция.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|	Коллекция.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|	Коллекция.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|	Коллекция.АналитикаСтатейБюджетов.ПриходРасход КАК ПриходРасход,
	|	Коллекция.Валюта КАК Валюта,
	|	Коллекция.ВалютаЛимитирования КАК ВалютаЛимитирования,
	|	Коллекция.Сумма КАК Сумма,
	|	Коллекция.Лимит КАК Лимит,
	|	Коллекция.СуммаИсполнено КАК СуммаИсполнено,
	|	Коллекция.ЛимитИсполнено КАК ЛимитИсполнено,
	|	Коллекция.КурсЗаданВОперации КАК КурсЗаданВОперации,
	|	Коллекция.КурсПланирования КАК КурсПланирования,
	|	Коллекция.КратностьПланирования КАК КратностьПланирования,
	|	Коллекция.КурсЛимитирования КАК КурсЛимитирования,
	|	Коллекция.КратностьЛимитирования КАК КратностьЛимитирования
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	Коллекция КАК Коллекция";
	Запрос.Выполнить();
	
	// 3. Действующие настройки лимитирования
	ДействующиеНастройкиЛимитирования(Запрос, ИмяВременнойТаблицыПланирования);
	
	// 4. Параметры лимитирования валют и курсы
	ПараметрыЛимитирования_Валюты(Запрос, ИмяВременнойТаблицыПланирования);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КурсыВалют.Валюта КАК Валюта,
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	МАКСИМУМ(КурсыВалют.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ДатыКурсовВалют
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ВТ_Данные.ДатаОперации >= КурсыВалют.Период
	|ГДЕ
	|	ВТ_Данные.СуммаИсполнено <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.ДатаОперации,
	|	КурсыВалют.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта,
	|	ДатаОперации";
	
	Запрос.Выполнить();
	
	// 5. Получить данные для корректировки наборов записей
	Корректировки = ДанныеДляКорректировкиНаборовЗаписей(Запрос);
	
	//Запрос.МенеджерВременныхТаблиц.Закрыть();
	
	// 6. Корректировка набора записей
	ВыборкаДокумент = Корректировки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокумент.Следующий() Цикл
		СкорректироватьНаборЗаписей(НаборЗаписей, ВыборкаДокумент.Выбрать(), Отказ);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Выполняет пересчет лимитов при изменении параметров лимитирования бюджета
//
// Параметры:
//  НаборЗаписей - РегистрСведенийНаборЗаписей.ПараметрыЛимитирования	 - изменный набор записей, по данным которого производится пересчет лимитов
//
Процедура ВыполнитьПересчетЛимитов(НаборЗаписей) Экспорт
	
	Если НаборЗаписей.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей.Отбор.ВидБюджета.ВидСравнения <> ВидСравнения.Равно 
		ИЛИ НаборЗаписей.Отбор.Период.ВидСравнения <> ВидСравнения.Равно Тогда
		Возврат;
	КонецЕсли;
	
	ВидБюджета = НаборЗаписей.Отбор.ВидБюджета.Значение;
	Период = НаборЗаписей.Отбор.Период.Значение;
	
	ВыполнитьПересчетЛимитовПоБюджетуПериоду(ВидБюджета, Период);
	
КонецПроцедуры

// Процедура - Выполняет пересчет лимитов при изменении валюты лимитировнаия ЦФО
//
// Параметры:
//  НаборЗаписей - РегистрСведенийНаборЗаписей.ПараметрыЛимитированияЦФО2 - 
//   изменный набор записей, по данным которого производится пересчет лимитов
//
Процедура ВыполнитьПересчетЛимитовПриИзмененииВалютыЦФО(НаборЗаписей) Экспорт
	
	Если НаборЗаписей.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей.Отбор.ВидБюджета.ВидСравнения <> ВидСравнения.Равно 
		ИЛИ НаборЗаписей.Отбор.ЦФО.ВидСравнения <> ВидСравнения.Равно
		ИЛИ НаборЗаписей.Отбор.Период.ВидСравнения <> ВидСравнения.Равно Тогда
		Возврат;
	КонецЕсли;
	
	ВидБюджета = НаборЗаписей.Отбор.ВидБюджета.Значение;
	ЦФО = НаборЗаписей.Отбор.ЦФО.Значение;
	Период = НаборЗаписей.Отбор.Период.Значение;
	
	ВыполнитьПересчетЛимитовПоБюджетуЦФОПериоду(ВидБюджета, Период, ЦФО);
	
КонецПроцедуры

// Процедура - Выполняет пересчет лимитов при изменении планового курса валюты 
//
// Параметры:
//  НаборЗаписей - РегистрСведенийНаборЗаписей.ПараметрыЛимитированияКурсыВалют - 
//   изменный набор записей, по данным которого производится пересчет лимитов
//
Процедура ВыполнитьПересчетЛимитовПриИзмененииКурсаВалюты(НаборЗаписей) Экспорт
	
	Если НаборЗаписей.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей.Отбор.Валюта.ВидСравнения <> ВидСравнения.Равно 
		ИЛИ НаборЗаписей.Отбор.Период.ВидСравнения <> ВидСравнения.Равно Тогда
		Возврат;
	КонецЕсли;
	
	Валюта = НаборЗаписей.Отбор.Валюта.Значение;
	Период = НаборЗаписей.Отбор.Период.Значение;
	
	ВыполнитьПересчетЛимитовПоВалютеПериоду(Валюта, Период);
	
КонецПроцедуры

#КонецОбласти

#Область КонтрольЛимитов32

// Процедура - Выполнить расчет сумм лимитирования для контроля
//
// Параметры:
//  МенеджерВременныхТаблиц					 - 	 - 
//  ИмяВременнойТаблицыДанныхПланирования	 - 	 - 
//
Процедура ВыполнитьРасчетСуммЛимитированияДляКонтроля(МенеджерВременныхТаблиц, ИмяВременнойТаблицыПланирования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ДействующиеНастройкиЛимитирования(Запрос, ИмяВременнойТаблицыПланирования);
	ПараметрыЛимитирования_Валюты(Запрос, ИмяВременнойТаблицыПланирования);
	РассчитатьСуммыВВалютеЛимитированияДляКонтроля(Запрос, ИмяВременнойТаблицыПланирования);
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ДвиженияЛимитыПоБюджетам");
	
КонецПроцедуры

// Процедура - формирует данные контроля лимитов бюджетов/резервов
//
// Параметры:
//  МенеджерВременныхТаблиц					 - 	 - 
//  ИмяВременнойТаблицыДанныхПланирования	 - 	 - 
//
Функция СформироватьДанныеКонтроля(МенеджерВременныхТаблиц, ИмяВременнойТаблицыДанныхПланирования, 
				ИмяВременнойТаблицыПолучатель = Неопределено, ПараметрыИсточника = Неопределено) Экспорт

	ПоСтатьямБюджета = Ложь;
	
	Если ТипЗнч(ПараметрыИсточника) = Тип("Структура") Тогда
		ПараметрыИсточника.Свойство("ПоСтатьямБюджета", ПоСтатьямБюджета);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ДействующиеНастройкиЛимитирования(Запрос, ИмяВременнойТаблицыДанныхПланирования);
	ПолучитьПараметрыКонтроля_СтатьиБюджета(Запрос, ИмяВременнойТаблицыДанныхПланирования);
	Результат = РассчитатьРезультатКонтроля(Запрос, ИмяВременнойТаблицыДанныхПланирования, 
										ИмяВременнойТаблицыПолучатель, ПоСтатьямБюджета);
	
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, ИмяВременнойТаблицыПолучатель);
	
	Возврат Результат;  
	
КонецФункции

