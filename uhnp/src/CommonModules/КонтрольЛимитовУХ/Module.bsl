	|	ПараметрыЛимитированияСводно.ПериодичностьПланирования
	|
	|ИМЕЮЩИЕ
	|	(ВТ_Данные.ВидКонтроля = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыКонтроляДокументов.КонтрольБюджетныхРезервов)
	|		ИЛИ СУММА(ВТ_Данные.ЛимитИзменение) <> 0
	|		ИЛИ СУММА(ВТ_Данные.ЗарезервированоИзменение) <> 0
	|		ИЛИ СУММА(ВТ_Данные.ЗаявленоИзменение) <> 0
	|		ИЛИ СУММА(ВТ_Данные.ИсполненоИзменение) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Предварительная.ДатаОперации КАК ДатаОперации,
	|	ВТ_Предварительная.ВидКонтроля КАК ВидКонтроля,
	|	ВТ_Предварительная.ВидБюджета КАК ВидБюджета,
	|	ВТ_Предварительная.ДокументРезервирования КАК ДокументРезервирования,
	|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
	|	ВТ_Предварительная.НачалоПериодаКонтроля КАК НачалоПериодаКонтроля,
	|	ВТ_Предварительная.ПериодичностьКонтроля КАК ПериодичностьКонтроля,
	|	ВТ_Предварительная.ЦФО КАК ЦФО,
	|	ВТ_Предварительная.Проект КАК Проект,
	|	ВТ_Предварительная.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_Предварительная.Аналитика1 КАК Аналитика1,
	|	ВТ_Предварительная.Аналитика2 КАК Аналитика2,
	|	ВТ_Предварительная.Аналитика3 КАК Аналитика3,
	|	ВТ_Предварительная.Аналитика4 КАК Аналитика4,
	|	ВТ_Предварительная.Аналитика5 КАК Аналитика5,
	|	ВТ_Предварительная.Аналитика6 КАК Аналитика6,
	|	ВТ_Предварительная.Валюта КАК Валюта,
	|	ВТ_Предварительная.Лимит КАК Лимит,
	|	ВЫБОР
	|		КОГДА ВТ_Предварительная.РезервированиеВПериодичностиПланирования
	|				И ВТ_Предварительная.ПериодичностьПланирования <> ВТ_Предварительная.ПериодичностьКонтроля
	|				И ВТ_Предварительная.ЗарезервированоИзменение = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_Предварительная.Зарезервировано
	|	КОНЕЦ КАК Зарезервировано,
	|	ВТ_Предварительная.Заявлено КАК Заявлено,
	|	ВТ_Предварительная.Исполнено КАК Исполнено,
	|	ВТ_Предварительная.ЛимитИзменение КАК ЛимитИзменение,
	|	ВТ_Предварительная.ЗарезервированоИзменение КАК ЗарезервированоИзменение,
	|	ВТ_Предварительная.ЗаявленоИзменение КАК ЗаявленоИзменение,
	|	ВТ_Предварительная.ИсполненоИзменение КАК ИсполненоИзменение,
	|	ВТ_Предварительная.ЛимитСтало КАК ЛимитСтало,
	|	ВЫБОР
	|		КОГДА ВТ_Предварительная.РезервированиеВПериодичностиПланирования
	|				И ВТ_Предварительная.ЗарезервированоИзменение = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_Предварительная.ЗарезервированоСтало
	|	КОНЕЦ КАК ЗарезервированоСтало,
	|	ВТ_Предварительная.ЗаявленоСтало КАК ЗаявленоСтало,
	|	ВТ_Предварительная.ИсполненоСтало КАК ИсполненоСтало,
	|	0 КАК ЗарезервированоИзменениеПревышениеТекущегоРезерва,
	|	ВТ_Предварительная.КонтрольРезервов КАК КонтрольРезервов,
	|	ВТ_Предварительная.КонтрольЛимитов КАК КонтрольЛимитов
	|ПОМЕСТИТЬ ИмяВременнойТаблицыПолучатель
	|ИЗ
	|	ВТ_Предварительная КАК ВТ_Предварительная";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицыИсточник", ИмяВременнойТаблицыДанныхПланирования);

	Если ПоместитьВоВременнуюТаблицу = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ИмяВременнойТаблицыПолучатель", "");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
			"ПОМЕСТИТЬ ИмяВременнойТаблицыПолучатель", "ПОМЕСТИТЬ " + ПоместитьВоВременнуюТаблицу);
	КонецЕсли;
	
	Если ПоСтатьямБюджета = Истина Тогда
		КЗамене = "ПараметрыЛимитированияСводно.ОбъектКонтроля КАК СтатьяБюджета,";
		Замена = "ПараметрыЛимитированияСводно.ОбъектКонтроля КАК ОбъектКонтроля,
			|	ПараметрыЛимитированияСводно.СтатьяБюджета КАК СтатьяБюджета,";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, КЗамене, Замена);
		
		КЗамене = "ПараметрыЛимитированияСводно.ОбъектКонтроля,";
		Замена = КЗамене + "
			|	ПараметрыЛимитированияСводно.СтатьяБюджета,";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, КЗамене, Замена);
		
		КЗамене = "ВТ_Предварительная.СтатьяБюджета КАК СтатьяБюджета,";
		Замена = "ВТ_Предварительная.ОбъектКонтроля КАК ОбъектКонтроля,
			|	ВТ_Предварительная.СтатьяБюджета КАК СтатьяБюджета,";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, КЗамене, Замена);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ПроверитьИзменениеУчетнойПолитикиПланированиеЗакупок(
				ДокументКорректирующий, ДокументКорректируемый, Отказ) Экспорт

	Если Не ЗначениеЗаполнено(ДокументКорректируемый) Тогда
		Возврат;
	КонецЕсли;  

	ВидБюджетаКорректирующий = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(ДокументКорректирующий.Дата); 
	ВидБюджетаКорректируемый = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(ДокументКорректируемый.Дата);   
	
	Если Не ВидБюджетаКорректирующий = ВидБюджетаКорректируемый Тогда
		 ТекстСообщения = НСтр("ru = 'Даты корректирующего и корректируемого документов должны быть в одной учетной политике лимитирования (Использовать для планирования закупок)'");
		 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументКорректирующий, , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьАктуальныеРегистраторы(Запрос)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеРегистра.Регистратор КАК Регистратор,
	|	ДанныеРегистра.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ДанныеРегистра.АналитикаСтруктуры КАК АналитикаСтруктуры
	|ПОМЕСТИТЬ ВТ_АктуальныеРегистраторы
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			(ВидБюджета, ОбъектПланирования.Объект, АналитикаСтатейБюджетов.СтатьяБюджета) В
	|				(ВЫБРАТЬ
	|					ВТ_ДвиженияЛимитыПоБюджетам.ВидБюджета КАК ВидБюджета,
	|					ВТ_ДвиженияЛимитыПоБюджетам.ДокументРезервирования КАК ДокументРезервирования,
	|					ВТ_ДвиженияЛимитыПоБюджетам.СтатьяБюджета КАК СтатьяБюджета
	|				ИЗ
	|					ВТ_ДвиженияЛимитыПоБюджетам КАК ВТ_ДвиженияЛимитыПоБюджетам
	|				ГДЕ
	|					ВТ_ДвиженияЛимитыПоБюджетам.ДокументРезервирования <> НЕОПРЕДЕЛЕНО)) КАК ДанныеРегистра
	|ГДЕ
	|	НЕ ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокКОбеспечению)";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();

КонецПроцедуры

Процедура ВысвободитьСвободныеРезервы() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ 
		|	ОперацииБюджетовОбороты.ОбъектПланирования КАК ОбъектПланирования,
		|	ОперацииБюджетовОбороты.СуммаОборот КАК СуммаОборот,
		|	ОперацииБюджетовОбороты.ЛимитОборот КАК ЛимитОборот
		|ПОМЕСТИТЬ ВТ_ОперацииБюджетов
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов.Обороты(, , Авто, ОбъектПланирования.Объект ССЫЛКА Документ.Резервирование) КАК ОперацииБюджетовОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОперацииБюджетов.ОбъектПланирования КАК ОбъектПланирования,
		|	ВТ_ОперацииБюджетов.СуммаОборот КАК СуммаОборот,
		|	ВТ_ОперацииБюджетов.ЛимитОборот КАК ЛимитОборот,
		|	ОбъектыПланирования.Объект КАК ДокументРезервирования
		|ИЗ
		|	ВТ_ОперацииБюджетов КАК ВТ_ОперацииБюджетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыПланирования КАК ОбъектыПланирования
		|		ПО ВТ_ОперацииБюджетов.ОбъектПланирования = ОбъектыПланирования.Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		КорректировкаПланов = Документы.КорректировкаПланов.СоздатьДокумент();
		КорректировкаПланов.ДокументОснование = ВыборкаДетальныеЗаписи.ДокументРезервирования; 
		КорректировкаПланов.ВысвобождатьРезервы = Истина;
		КорректировкаПланов.Дата = ВыборкаДетальныеЗаписи.ДокументРезервирования.Дата;
		КорректировкаПланов.ВидБюджета = ВыборкаДетальныеЗаписи.ДокументРезервирования.ВидБюджета;
		КорректировкаПланов.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		
		СхемаКомпоновкиДанных = Документы.КорректировкаПланов.ПолучитьМакет("Резервы");
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
		ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор));
		КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроек); 

		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		
		БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВидБюджета", 		ВыборкаДетальныеЗаписи.ДокументРезервирования.ВидБюджета);
		БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДокументРезерва", 	ВыборкаДетальныеЗаписи.ДокументРезервирования);
		БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТипыЗаявокКОбеспечению", 	КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению());
		БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТипыЗаявокНаОперации", 	КонтрольЛимитовУХ.ТипыЗаявокНаОперации());
		БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТипыКорректировкиЛимитов", КонтрольЛимитовУХ.ТипыКорректировкиЛимитов()); 
		 
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных; 
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, 
						КомпоновщикНастроек.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		                                                                        
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;   	
		ТаблицаЗначений = Новый ТаблицаЗначений;
		
		ПроцессорВывода.УстановитьОбъект(ТаблицаЗначений);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
		ВидОперацииПеренос = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;

		Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
			
			ИдентификаторСтроки = Новый УникальныйИдентификатор;	
			
			НоваяСтрока = КорректировкаПланов.Требуется.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, , "ДокументРезерва");   
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.Требуется = СтрокаТаблицы.Свободно;
			НоваяСтрока.Сумма = СтрокаТаблицы.Свободно;
			НоваяСтрока.Периодичность = ПолучитьПериодичностьПланирования(КорректировкаПланов.ВидБюджета, НоваяСтрока.НачалоПериода); 

			НоваяСтрока = КорректировкаПланов.ОбеспечитьЗаСчет.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.ВидОперации = ВидОперацииПеренос;
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.Сумма = СтрокаТаблицы.Свободно;
			НоваяСтрока.Периодичность = ПолучитьПериодичностьПланирования(КорректировкаПланов.ВидБюджета, НоваяСтрока.НачалоПериода); 

		КонецЦикла; 
		
		КорректировкаПланов.Записать(РежимЗаписиДокумента.Проведение);
			
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПериодичностьПланирования(ВидБюджета, НачалоПериода)
	
	ПараметрыПланирования = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджета, НачалоПериода);
	
	Возврат ПараметрыПланирования.ПериодичностьЛимитирования;   
	
КонецФункции

#КонецОбласти

#КонецОбласти
