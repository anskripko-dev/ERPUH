Процедура СкорректироватьНаборЗаписей(НаборЗаписей, Выборка, Отказ)
	
	Перем БлокироватьЗапись, РезультатКонтроля;
	
	ВалютыЛимитирования = Новый ТаблицаЗначений; 
	ВалютыЛимитирования.Колонки.Добавить("Период", 
								ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата)); 
	ВалютыЛимитирования.Колонки.Добавить("ВалютаЛимитирования", 
								ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Валюты"));
	
	ПропуститьПересчетПоказателей = НаборЗаписей.ДополнительныеСвойства.Свойство("ПропуститьПересчетПоказателей");
	ФиксироватьЛимиты = НаборЗаписей.ДополнительныеСвойства.Свойство("ФиксироватьЛимиты");
	
	БюджетДвиженияДенежныхСредств = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
	РежимКонтроляНеКонтролировать = Перечисления.РежимыКонтроляДокументов.НеКонтролировать;  
	РежимКонтроляБлокировать = Перечисления.РежимыКонтроляДокументов.Блокировать; 

	Пока Выборка.Следующий() Цикл
		
		Запись = НаборЗаписей[Выборка.НомерСтроки - 1];
		
		Если Запись.НомерСтроки <> 0 И Запись.НомерСтроки <> Выборка.НомерСтроки Тогда
			ВызватьИсключение НСтр("ru = 'Ошибка при выборе строки набора записей'");
		КонецЕсли;
		
		Если Выборка.Изменение_ВалютаЛимитирования Тогда
			Запись.ВалютаЛимитирования = Выборка.ВалютаЛимитирования_Новый;
		КонецЕсли;
		
		Если Выборка.Изменение_КурсЛимитирования ИЛИ Выборка.Изменение_ВалютаЛимитирования Тогда
			Запись.КурсЛимитирования = Выборка.КурсЛимитирования_Новый;
			Запись.КратностьЛимитирования = Выборка.КратностьЛимитирования_Новый;
		КонецЕсли;
		
		Если Выборка.Изменение_КурсПланирования Тогда
			Запись.КурсПланирования = Выборка.КурсПланирования_Новый;
			Запись.КратностьПланирования = Выборка.КратностьПланирования_Новый;
		КонецЕсли; 
		
		Если ПропуститьПересчетПоказателей Тогда
			Продолжить;
		КонецЕсли;  	
		
		Если Не ЗначениеЗаполнено(Запись.ВалютаЛимитирования) Тогда
			Запись.Лимит = 0;
			Запись.ЛимитИсполнено = 0;
			Продолжить;
		КонецЕсли;
		
		КурсыНеЗаполнены = Запись.КурсПланирования = 0 ИЛИ Запись.КратностьПланирования = 0
							ИЛИ Запись.КурсЛимитирования = 0 ИЛИ Запись.КратностьЛимитирования = 0;
							
		Если КурсыНеЗаполнены Тогда 
			
			Если Не Выборка.КонтрольЛимитов = РежимКонтроляНеКонтролировать Тогда
				
				Если ЗначениеЗаполнено(Запись.Валюта) Тогда 
					НоваяЗапись = ВалютыЛимитирования.Добавить(); 
					НоваяЗапись.Период = Запись.Период;
					НоваяЗапись.ВалютаЛимитирования = Запись.Валюта;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Запись.ВалютаЛимитирования) Тогда 
					НоваяЗапись = ВалютыЛимитирования.Добавить();   
					НоваяЗапись.Период = Запись.Период;
					НоваяЗапись.ВалютаЛимитирования = Запись.ВалютаЛимитирования;
				КонецЕсли;   
				
			КонецЕсли;
			
			Если Выборка.КонтрольЛимитов = РежимКонтроляБлокировать Тогда
				БлокироватьЗапись = Истина;	
			КонецЕсли;
			
			Продолжить;  
			
		КонецЕсли;
	
		Если Запись.Лимит = 0  Тогда  
			Если Запись.Валюта = Запись.ВалютаЛимитирования Тогда
				Запись.Лимит = Запись.Сумма;		
			Иначе
				Если Запись.КурсЗаданВОперации Тогда  
					Запись.Лимит = Окр(Запись.Сумма * (Запись.КурсПланирования / Запись.КратностьПланирования), 
									2, РежимОкругления.Окр15как20);    
				Иначе
					Запись.Лимит = Окр(Запись.Сумма * (Запись.КурсПланирования / Запись.КратностьПланирования)  
									/ (Запись.КурсЛимитирования / Запись.КратностьЛимитирования), 2, РежимОкругления.Окр15как20);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		КурсПланирования = Запись.КурсПланирования;
		КратностьПланирования = Запись.КратностьПланирования;
		
		КурсЛимитирования= Запись.КурсЛимитирования;
		КратностьЛимитирования = Запись.КратностьЛимитирования;
		
		Если Не Запись.КурсЗаданВОперации Тогда
			
			Если ЗначениеЗаполнено(Выборка.КурсПланирования_НовыйФакт) 
				И ЗначениеЗаполнено(Выборка.КратностьПланирования_НовыйФакт) Тогда
				КурсПланирования = Выборка.КурсПланирования_НовыйФакт;
				КратностьПланирования = Выборка.КратностьПланирования_НовыйФакт;
				
				Запись.КурсПланирования = КурсПланирования;
				Запись.КратностьПланирования = КратностьПланирования;
				
			КонецЕсли;  
			
			Если ЗначениеЗаполнено(Выборка.КурсЛимитирования_НовыйФакт) 
				И ЗначениеЗаполнено(Выборка.КратностьЛимитирования_НовыйФакт) Тогда
				КурсЛимитирования = Выборка.КурсЛимитирования_НовыйФакт;
				КратностьЛимитирования = Выборка.КратностьЛимитирования_НовыйФакт;
				
				Запись.КурсЛимитирования = КурсЛимитирования;
				Запись.КратностьЛимитирования = КратностьЛимитирования;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Запись.Валюта <> Запись.ВалютаЛимитирования Тогда
			Если ЗначениеЗаполнено(Выборка.КурсЛимитирования_НовыйФакт) 
				И ЗначениеЗаполнено(Выборка.КратностьЛимитирования_НовыйФакт) Тогда
				КурсЛимитирования = Выборка.КурсЛимитирования_НовыйФакт;
				КратностьЛимитирования = Выборка.КратностьЛимитирования_НовыйФакт;
				
				Запись.КурсЛимитирования = КурсЛимитирования;
				Запись.КратностьЛимитирования = КратностьЛимитирования;
			КонецЕсли;
		КонецЕсли;
		
		Если Запись.КурсЗаданВОперации И Запись.Валюта = Запись.ВалютаЛимитирования Тогда
			Запись.ЛимитИсполнено = Окр(Запись.СуммаИсполнено * (КурсПланирования / КратностьПланирования), 
									2, РежимОкругления.Окр15как20);		
		Иначе
			Запись.ЛимитИсполнено = Окр(Запись.СуммаИсполнено * (КурсПланирования / КратностьПланирования)  
									/ (КурсЛимитирования / КратностьЛимитирования), 2, РежимОкругления.Окр15как20);
		КонецЕсли;
	КонецЦикла;  
	
	Если ПропуститьПересчетПоказателей Тогда
		Возврат;
	КонецЕсли;
	
	Регистратор = НаборЗаписей.Отбор.Регистратор.Значение;
	КонтрольПараметрыЛимитированияКурсыВалют(ВалютыЛимитирования, Регистратор, РезультатКонтроля);	
	
	Если БлокироватьЗапись = Истина 
		И РезультатКонтроля = Истина Тогда
		Отказ = Истина;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДействующиеНастройкиЛимитирования(Запрос, ИмяВременнойТаблицыДанныхПланирования)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	ВТ_Данные.ВидБюджета КАК ВидБюджета,
	|	МАКСИМУМ(ПараметрыЛимитирования.Период) КАК НачалоДействия
	|ПОМЕСТИТЬ ВТ_ДатыНастроекЛимитирования
	|ИЗ
	|	ИмяВременнойТаблицы КАК ВТ_Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|		ПО ВТ_Данные.ВидБюджета = ПараметрыЛимитирования.ВидБюджета
	|ГДЕ
	|	ВТ_Данные.ДатаОперации >= ПараметрыЛимитирования.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.ДатаОперации,
	|	ВТ_Данные.ВидБюджета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидБюджета,
	|	НачалоДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДатыНастроекЛимитирования.ДатаОперации КАК ДатаОперации,
	|	ВТ_ДатыНастроекЛимитирования.ВидБюджета КАК ВидБюджета,
	|	ВТ_ДатыНастроекЛимитирования.НачалоДействия КАК НачалоДействия,
	|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитирования.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитирования.КонтрольРезервов КАК КонтрольРезервов,
	|	ПараметрыЛимитирования.ВалютаПоУмолчанию КАК ВалютаПоУмолчанию
	|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации
	|ИЗ
	|	ВТ_ДатыНастроекЛимитирования КАК ВТ_ДатыНастроекЛимитирования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|		ПО ВТ_ДатыНастроекЛимитирования.ВидБюджета = ПараметрыЛимитирования.ВидБюджета
	|			И ВТ_ДатыНастроекЛимитирования.НачалоДействия = ПараметрыЛимитирования.Период
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидБюджета,
	|	ДатаОперации";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицыДанныхПланирования);
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
КонецПроцедуры   

Процедура ПараметрыЛимитирования_Валюты(Запрос, ИмяВременнойТаблицыДанныхПланирования)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Данные.ВидБюджета КАК ВидБюджета,
	|	ВТ_Данные.ЦФО КАК ЦФО,
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	ВТ_Данные.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.СпособОпределенияВалютыЛимитирования = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаУпрУчета)
	|			ТОГДА &ВалютаУпрУчета
	|		КОГДА ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.СпособОпределенияВалютыЛимитирования = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаЛимитированияЦФО)
	|			ТОГДА ЕСТЬNULL(ПараметрыЛимитированияВалютыЦФО.ВалютаЛимитирования, ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ВалютаПоУмолчанию)
	|		ИНАЧЕ ВТ_Данные.Валюта
	|	КОНЕЦ КАК ВалютаЛимитирования,
	|	ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования
	|ПОМЕСТИТЬ ВТ_ВалютыЛимитированияПоДатамЦФО
	|ИЗ
	|	ИмяВременнойТаблицы КАК ВТ_Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации КАК ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации
	|		ПО ВТ_Данные.ВидБюджета = ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ВидБюджета
	|			И ВТ_Данные.ДатаОперации = ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ДатаОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияВалютыЦФО КАК ПараметрыЛимитированияВалютыЦФО
	|		ПО (ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ВидБюджета = ПараметрыЛимитированияВалютыЦФО.ВидБюджета)
	|			И ВТ_Данные.ЦФО = ПараметрыЛимитированияВалютыЦФО.ЦФО
	|			И (ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.НачалоДействия = ПараметрыЛимитированияВалютыЦФО.Период)
	|			И (ВТ_ПараметрыЛимитированияБюджетаПоДатеОперации.ДатаОперации = ВТ_Данные.ДатаОперации)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидБюджета,
	|	ЦФО,
	|	ДатаОперации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыЛимитированияКурсыВалют.Период КАК НачалоДействия,
	|	ПараметрыЛимитированияКурсыВалют.Валюта КАК Валюта,
	|	ПараметрыЛимитированияКурсыВалют.Курс КАК Курс,
	|	ПараметрыЛимитированияКурсыВалют.Кратность КАК Кратность
	|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияКурсыВалютаРегистр
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияКурсыВалют КАК ПараметрыЛимитированияКурсыВалют
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	ВТ_Данные.Валюта КАК ВалютаОперации,
	|	МАКСИМУМ(ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.НачалоДействия) КАК НачалоДействия
	|ПОМЕСТИТЬ ВТ_ДанныеДатаКурсаВалютыПланирования
	|ИЗ
	|	ИмяВременнойТаблицы КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитированияКурсыВалютаРегистр КАК ВТ_ПараметрыЛимитированияКурсыВалютаРегистр
	|		ПО ВТ_Данные.Валюта = ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.Валюта
	|			И ВТ_Данные.ДатаОперации >= ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.НачалоДействия
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.ДатаОперации,
	|	ВТ_Данные.Валюта,
	|	ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеДатаКурсаВалютыПланирования.ДатаОперации КАК ДатаОперации,
	|	ВТ_ДанныеДатаКурсаВалютыПланирования.ВалютаОперации КАК ВалютаОперации,
	|	ВТ_ДанныеДатаКурсаВалютыПланирования.НачалоДействия КАК НачалоДействия,
	|	ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.Валюта КАК ВалютаЛимитирования,
	|	МАКСИМУМ(ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.НачалоДействия) КАК НачалоДействияКурсаВалютыЛимитирования
	|ПОМЕСТИТЬ ВТ_ДанныеСДатамиКурсаВалют
	|ИЗ
	|	ВТ_ДанныеДатаКурсаВалютыПланирования КАК ВТ_ДанныеДатаКурсаВалютыПланирования,
	|	ВТ_ПараметрыЛимитированияКурсыВалютаРегистр КАК ВТ_ПараметрыЛимитированияКурсыВалютаРегистр
	|ГДЕ
	|	ВТ_ДанныеДатаКурсаВалютыПланирования.ДатаОперации >= ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.НачалоДействия
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеДатаКурсаВалютыПланирования.ДатаОперации,
	|	ВТ_ДанныеДатаКурсаВалютыПланирования.ВалютаОперации,
	|	ВТ_ДанныеДатаКурсаВалютыПланирования.НачалоДействия,
	|	ВТ_ПараметрыЛимитированияКурсыВалютаРегистр.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСДатамиКурсаВалют.ДатаОперации КАК ДатаОперации,
	|	ВТ_ДанныеСДатамиКурсаВалют.ВалютаОперации КАК ВалютаОперации,
	|	ВТ_ДанныеСДатамиКурсаВалют.ВалютаЛимитирования КАК ВалютаЛимитирования,
	|	ВТ_КурсыВалютПланирования.Курс КАК КурсПланирования,
	|	ВТ_КурсыВалютПланирования.Кратность КАК КратностьПланирования,
	|	ВТ_КурсыВалютКонтроля.Курс КАК КурсЛимитирования,
	|	ВТ_КурсыВалютКонтроля.Кратность КАК КратностьЛимитирования,
	|	ВЫРАЗИТЬ(ВТ_КурсыВалютПланирования.Курс / ВТ_КурсыВалютПланирования.Кратность / (ВТ_КурсыВалютКонтроля.Курс / ВТ_КурсыВалютКонтроля.Кратность) КАК ЧИСЛО(24, 18)) КАК КроссКурс
	|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияКурсы
	|ИЗ
	|	ВТ_ДанныеСДатамиКурсаВалют КАК ВТ_ДанныеСДатамиКурсаВалют
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитированияКурсыВалютаРегистр КАК ВТ_КурсыВалютПланирования
	|		ПО ВТ_ДанныеСДатамиКурсаВалют.ВалютаОперации = ВТ_КурсыВалютПланирования.Валюта
	|			И ВТ_ДанныеСДатамиКурсаВалют.НачалоДействия = ВТ_КурсыВалютПланирования.НачалоДействия
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитированияКурсыВалютаРегистр КАК ВТ_КурсыВалютКонтроля
	|		ПО ВТ_ДанныеСДатамиКурсаВалют.ВалютаЛимитирования = ВТ_КурсыВалютКонтроля.Валюта
	|			И ВТ_ДанныеСДатамиКурсаВалют.НачалоДействияКурсаВалютыЛимитирования = ВТ_КурсыВалютКонтроля.НачалоДействия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаОперации,
	|	ВалютаОперации,
	|	ВалютаЛимитирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДанныеДатаКурсаВалютыПланирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДанныеСДатамиКурсаВалют
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПараметрыЛимитированияКурсыВалютаРегистр";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицыДанныхПланирования);     
	Запрос.Текст = ТекстЗапроса;     
		
	Запрос.УстановитьПараметр("ВалютаУпрУчета", ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуУправленческогоУчета());   
	Запрос.Выполнить();

КонецПроцедуры

Функция ДанныеДляКорректировкиНаборовЗаписей(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);  
	
	ТекстЗапроса =     
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Данные.Регистратор КАК Регистратор,
	|	ВТ_Данные.НомерСтроки КАК НомерСтроки,
	|	ВТ_Данные.Сумма КАК Сумма,
	|	ВТ_Данные.СуммаИсполнено КАК СуммаИсполнено,
	|	ВТ_Данные.ВидБюджета КАК ВидБюджета,
	|	ВТ_Данные.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_Данные.ЦФО КАК ЦФО,
	|	ВТ_Данные.Валюта КАК Валюта,
	|	ВТ_Данные.ВалютаЛимитирования КАК ВалютаЛимитирования,
	|	ВЫБОР
	|		КОГДА ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА ВТ_Данные.Валюта
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ВалютыЛимитированияПоДатамЦФО.ВалютаЛимитирования, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|	КОНЕЦ КАК ВалютаЛимитирования_Новый,
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	ВТ_Данные.КурсЗаданВОперации КАК КурсЗаданВОперации,
	|	ВТ_Данные.КурсПланирования КАК КурсПланирования,
	|	ВТ_Данные.КратностьПланирования КАК КратностьПланирования,
	|	ВТ_Данные.КурсПланирования КАК КурсЛимитирования,
	|	ВТ_Данные.КратностьПланирования КАК КратностьЛимитирования,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.СуммаИсполнено <> 0
	|			ТОГДА ЕСТЬNULL(КурсыВалютПланирования.Курс, 0)
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ПараметрыЛимитированияКурсы.КурсПланирования, 0)
	|	КОНЕЦ КАК КурсПланирования_НовыйФакт,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.СуммаИсполнено <> 0
	|			ТОГДА ЕСТЬNULL(КурсыВалютПланирования.Кратность, 0)
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ПараметрыЛимитированияКурсы.КратностьПланирования, 0)
