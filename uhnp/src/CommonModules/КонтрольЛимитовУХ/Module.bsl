Функция ДоступныеПериодичностиЛимитирования(ВидБюджета,  
					ДатаПараметровЛимитирования = Неопределено, 
					ПериодичностьОперативногоПланирования = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПериодичностьОперативногоПланирования = Неопределено Тогда
		ПараметрыОП = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(
													ВидБюджета, ДатаПараметровЛимитирования); 	
		ПериодичностьОП = ПараметрыОП.ПериодичностьОперативногоПланирования;       
	Иначе
		ПериодичностьОП = ПериодичностьОперативногоПланирования;
	КонецЕсли;
	
	ПериодичностьИсключения = Новый Массив;
	ПериодичностьИсключения.Добавить(Перечисления.Периодичность.ДевятьМесяцев);
	
	ПериодичностиПереопределения = Новый Соответствие;
	ПериодичностиПереопределения.Вставить(Перечисления.Периодичность.День,   Перечисления.Периодичность.Декада);	
    ПериодичностиПереопределения.Вставить(Перечисления.Периодичность.Неделя, Перечисления.Периодичность.Декада);   
	
	ПериодичностьПереопределения = ПериодичностиПереопределения.Получить(ПериодичностьОП);   
	
	Если Не ПериодичностьПереопределения = Неопределено Тогда
		ПериодичностьОП = ПериодичностьПереопределения;	
	КонецЕсли;    
	
	ПериодичностьНайдена = Ложь;
	
	ДоступныеПериодичности = Новый Массив;	
	Для Каждого ТекущаяПериодичность Из Перечисления.Периодичность Цикл 
		
		Если Не ПериодичностьИсключения.Найти(ТекущаяПериодичность) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
				
		Если ПериодичностьОП = ТекущаяПериодичность Тогда
			ПериодичностьНайдена = Истина;	
		КонецЕсли;
		
		Если Не ПериодичностьНайдена Тогда
			Продолжить;
		КонецЕсли;
		
		ДоступныеПериодичности.Добавить(ТекущаяПериодичность);
		
	КонецЦикла;
	
	Возврат ДоступныеПериодичности;
	
КонецФункции 

Процедура СравнитьПериодичностьПланированияЛимитирования(ПериодичностьОП, 
							ПериодичностьЛимитирования, Отказ = Ложь) Экспорт 
	
	Если Не ЗначениеЗаполнено(ПериодичностьОП) 
		Или Не ЗначениеЗаполнено(ПериодичностьЛимитирования) Тогда
		Возврат;
	КонецЕсли;

	ИндексПериодичностьОП = Перечисления.Периодичность.Индекс(ПериодичностьОП);   
	ИндексПериодичностьЛимитирования = Перечисления.Периодичность.Индекс(ПериодичностьЛимитирования);
	
	Если ИндексПериодичностьОП > ИндексПериодичностьЛимитирования Тогда   				
		
		ШаблонСообщения = НСтр("ru = 'Найдено нарушение: периодичность планирования ""%1"" больше периодичности лимитирования ""%2""'"); 
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПериодичностьОП, ПериодичностьЛимитирования); 
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПериодичностьЛимитирования(ВидБюджета, ДатаПараметровЛимитирования = Неопределено, Направление = 0) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если ДатаПараметровЛимитирования = Неопределено Тогда
		ДатаПараметровЛимитирования = '00010101';
	КонецЕсли;
	
	ПараметрыОП = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджета, ДатаПараметровЛимитирования);
	
	Запрос = Новый Запрос;   
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПараметрыЛимитированияГруппыСтатей.Периодичность КАК Периодичность
	|ПОМЕСТИТЬ ВТ_ПериодичностиЛимитирования
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияГруппыСтатей КАК ПараметрыЛимитированияГруппыСтатей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав КАК ПараметрыЛимитированияГруппыСтатейСостав
	|		ПО ПараметрыЛимитированияГруппыСтатей.Период = ПараметрыЛимитированияГруппыСтатейСостав.Период
	|			И ПараметрыЛимитированияГруппыСтатей.ВидБюджета = ПараметрыЛимитированияГруппыСтатейСостав.ВидБюджета
	|ГДЕ
	|	НЕ ПараметрыЛимитированияГруппыСтатей.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
	|	И ПараметрыЛимитированияГруппыСтатей.Период = &ДатаПараметровЛимитирования
	|	И ПараметрыЛимитированияГруппыСтатей.ВидБюджета = &ВидБюджета
	|	И &ДатаПараметровЗаполнена
	|	И НЕ ПараметрыЛимитированияГруппыСтатейСостав.ВидБюджета ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПараметрыЛимитированияГруппыСтатей.Периодичность
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияГруппыСтатей.СрезПоследних(
	|			,
	|			ВидБюджета = &ВидБюджета
	|				И НЕ &ДатаПараметровЗаполнена) КАК ПараметрыЛимитированияГруппыСтатей
	|ГДЕ
	|	НЕ ПараметрыЛимитированияГруппыСтатей.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ПериодичностьЛимитирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ПериодичностиЛимитирования.Периодичность КАК Периодичность,
	|	ВЫБОР
	|		КОГДА ВТ_ПериодичностиЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.День)
	|			ТОГДА 1
	|		КОГДА ВТ_ПериодичностиЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
	|			ТОГДА 2
	|		КОГДА ВТ_ПериодичностиЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
	|			ТОГДА 3
	|		КОГДА ВТ_ПериодичностиЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
	|			ТОГДА 4
	|		КОГДА ВТ_ПериодичностиЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
	|			ТОГДА 5
	|		КОГДА ВТ_ПериодичностиЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
	|			ТОГДА 6
	|		КОГДА ВТ_ПериодичностиЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
	|			ТОГДА 7
	|	КОНЕЦ КАК Длительность
	|ИЗ
	|	ВТ_ПериодичностиЛимитирования КАК ВТ_ПериодичностиЛимитирования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Длительность УБЫВ"; 
	
	Если Направление = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Длительность УБЫВ", "Длительность");	
	КонецЕсли;

	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("ПериодичностьЛимитирования",  ПараметрыОП.ПериодичностьЛимитирования);   	     
    Запрос.УстановитьПараметр("ДатаПараметровЛимитирования", ДатаПараметровЛимитирования);   
	Запрос.УстановитьПараметр("ДатаПараметровЗаполнена", 	 ЗначениеЗаполнено(ДатаПараметровЛимитирования)); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий(); 
	
	Возврат ВыборкаДетальныеЗаписи.Периодичность;
	
КонецФункции  

Функция ПолучитьМассивСторноДокумента(МенеджерВременныхТаблиц)
	
	МассивСторно = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Д.ДокументРезервирования КАК ДокументРезервирования
		|ИЗ
		|	ВТ_ДвиженияЛимитыПоБюджетам КАК Д";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивСторно.Добавить(ВыборкаДетальныеЗаписи.ДокументРезервирования);
	КонецЦикла;
	
	Возврат МассивСторно;
	
КонецФункции

#КонецОбласти

// Процедура по ВТ_ПланыДокумента формирует ВТ_ТаблицаПлановССуммамиЛимитирования
Процедура СформироватьПланыССуммамиЛимитирования(МенеджерВременныхТаблиц) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запросы = Новый Массив;
	Запросы.Добавить(ТекстЗапроса_ОпределениеСуммЛимитирования(Запрос));
	Запросы.Добавить("УНИЧТОЖИТЬ ВТ_ПланыДокумента");
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	Запрос.Выполнить();
	
КонецПроцедуры

// Используется при контроле документов, учатстников процееса планирования потребностей и в заявке на закупку
Функция ТекстЗапроса_ОпределениеСуммЛимитирования(Запрос) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ДатаОперации КАК Период,
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ДатаОперации КАК ДатаОперации,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументРезервирования КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументПланирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА ВТ_ПланыДокумента.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Лимит,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументПланирования <> НЕОПРЕДЕЛЕНО
	|				И НЕ ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) В (&ТипыЗаявокНаОперации)
	|				И НЕ ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) В (&ТипыЗаявокКОбеспечению)
	|			ТОГДА ВЫБОР
	|					КОГДА ВТ_ПланыДокумента.ДокументРезервирования <> НЕОПРЕДЕЛЕНО
	|						ТОГДА -ВТ_ПланыДокумента.Сумма
	|					ИНАЧЕ ВТ_ПланыДокумента.Сумма
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Зарезервировано,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументПланирования <> НЕОПРЕДЕЛЕНО
	|				И ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) В (&ТипыЗаявокНаОперации)
	|			ТОГДА ВТ_ПланыДокумента.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|ГДЕ
	|	ВТ_ПланыДокумента.ДокументПланирования = &КонтролируемыйДокумент";

	УстановитьТипыДокументовДляЗапроса(Запрос);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура УстановитьТипыДокументовДляЗапроса(Запрос) Экспорт
	Запрос.УстановитьПараметр("ТипыЗаявокНаОперации", ТипыЗаявокНаОперации());
	Запрос.УстановитьПараметр("ТипыЗаявокКОбеспечению", ТипыЗаявокКОбеспечению());
	Запрос.УстановитьПараметр("ТипыКорректировкиЛимитов", ТипыКорректировкиЛимитов());
КонецПроцедуры

// Функция - Возвращает результат контроля бюджетных лимитов документа Основание.
//           Используется при заполнении документов ЗаявкаНаКорректировкуЛимитов и КорректировкаЛимитов
//
// Параметры:
//  Основание	 - 	ДокументСсылка - контролируемый документ
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Результат контроля  
Функция ПолучитьПревышениеЛимитов(Основание) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РазмещениеИсточников = КонтрольУХПовтИсп.РазмещениеИсточниковКонтроля();
	
	ОснованиеМетаданные = Основание.Метаданные();
	Если РазмещениеИсточников[ОснованиеМетаданные] <> Неопределено Тогда
		Менеджер = РазмещениеИсточников[ОснованиеМетаданные];
	Иначе
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Основание);
	КонецЕсли;
	
	Попытка
		ИсточникиДокументаИсходный = Менеджер.ИсточникиДокумента(Основание);
	Исключение
	    Возврат Новый ТаблицаЗначений;
	КонецПопытки;
	
	ИмяИсточника = "ИзменениеБюджетныхЛимитовРезервов";
	ИсточникЛимитыРезервы = ИсточникиДокументаИсходный.Получить(ИмяИсточника);
	Если ИсточникЛимитыРезервы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// В результате должен как ОбъектКонтроля, так и Статья Контроля
	ИсточникЛимитыРезервы.Параметры.Вставить("ПоСтатьямБюджета", Истина); 
	
	ИсточникиДокумента = Новый Соответствие;
	ИсточникиДокумента.Вставить(ИмяИсточника, ИсточникЛимитыРезервы);
	
	ПараметрыКонтроля = Новый Структура;
	ПараметрыКонтроля.Вставить("Документ",	Основание);
	ПараметрыКонтроля.Вставить("ИмяДокумента", Основание.Метаданные().Имя);
	ПараметрыКонтроля.Вставить("Источники", ИсточникиДокумента);
	
	РезультатКонтроля = КонтрольУХ.ВыполнитьКонтрольИВернутьРезультат(ПараметрыКонтроля);
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидКонтроля", ПланыВидовХарактеристик.ВидыКонтроляДокументов.КонтрольБюджетныхЛимитов);
	
	Строки = РезультатКонтроля.НайтиСтроки(СтруктураПоиска);
	Если Строки.Количество() > 0 Тогда
		Возврат Строки[0].ДанныеКонтроля;
	КонецЕсли;
	
	Возврат Новый ТаблицаЗначений;
	
КонецФункции     

Функция ПолучитьПревышениеЛимитовРезервов(Основание) Экспорт 
	
	Перем ТаблицаПланыДокумента;
	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РазмещениеИсточников = КонтрольУХПовтИсп.РазмещениеИсточниковКонтроля();
	
	ОснованиеМетаданные = Основание.Метаданные();
	Если РазмещениеИсточников[ОснованиеМетаданные] <> Неопределено Тогда
		Менеджер = РазмещениеИсточников[ОснованиеМетаданные];
	Иначе
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Основание);
	КонецЕсли;
	
	Попытка
		ИсточникиДокументаИсходный = Менеджер.ИсточникиДокумента(Основание);
	Исключение
	    Возврат Неопределено;
	КонецПопытки;
	
	ИмяИсточника = "ИзменениеБюджетныхЛимитовРезервов";
	ИсточникЛимитыРезервы = ИсточникиДокументаИсходный.Получить(ИмяИсточника);
	Если ИсточникЛимитыРезервы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;  
	
	ВременнаяТаблицаЗапроса = ИсточникЛимитыРезервы.ПланыДокумента.Таблицы.Найти("ВТ_ТаблицаПлановССуммамиЛимитирования");
	
	Если Не ВременнаяТаблицаЗапроса = Неопределено Тогда
		ТаблицаПланыДокумента = ВременнаяТаблицаЗапроса.ПолучитьДанные().Выгрузить();	
	КонецЕсли; 
	
	// В результате должен как ОбъектКонтроля, так и Статья Контроля
	ИсточникЛимитыРезервы.Параметры.Вставить("ПоСтатьямБюджета", Истина); 
	
	ИсточникиДокумента = Новый Соответствие;
	ИсточникиДокумента.Вставить(ИмяИсточника, ИсточникЛимитыРезервы);
	
	ПараметрыКонтроля = Новый Структура;
	ПараметрыКонтроля.Вставить("Документ",	Основание);
	ПараметрыКонтроля.Вставить("ИмяДокумента", Основание.Метаданные().Имя);
	ПараметрыКонтроля.Вставить("Источники", ИсточникиДокумента);
	
	РезультатКонтроля = КонтрольУХ.ВыполнитьКонтрольИВернутьРезультат(ПараметрыКонтроля);
	
	ПараметрыРезультата = Новый Структура;  
	ПараметрыРезультата.Вставить("ТаблицаПланыДокумента", ТаблицаПланыДокумента);  
	ПараметрыРезультата.Вставить("РезультатыКонтроля", РезультатКонтроля);
	                            
	Возврат ПараметрыРезультата;
	
КонецФункции    

// Функция - формирует из данных контроля данные заполнения документов ЗаявкаНаКорректировкуЛимитов и КорректировкаЛимитов
//
// Параметры:
//  ДанныеКонтроля	 - ТаблицаЗначений	 - Результат функции ПолучитьПревышениеЛимитов(...)
//  ВидБюджета		 - ПланВидовХарактеристикСсылка.ВидыБюджетов - Вид бюджета
// 
// Возвращаемое значение:
//  Таблица значений - Данные для заполнения документов ЗаявкаНаКорректировкуЛимитов и КорректировкаЛимитов
//
Функция ОбработатьДанныеКонтроля(ДанныеКонтроля, ВидБюджета, ОчищатьРезервирование) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеКонтроля) Тогда
		Возврат ДанныеКонтроля;
	КонецЕсли;

	ИспользоватьРезервированиеФО = КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования();
	
	СтруктураПоиска = Новый Структура;      
	СтруктураПоиска.Вставить("ВидБюджета", ВидБюджета);
	
	ИменаКолонок = "ВидБюджета, Валюта, НачалоПериодаКонтроля, ПериодичностьКонтроля, ЦФО, Проект, ОбъектКонтроля, СтатьяБюджета, "
				+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1") + ","
				+ "Лимит, Зарезервировано, Заявлено, Исполнено, ЛимитИзменение, ЗарезервированоИзменение, ЗаявленоИзменение, ИсполненоИзменение, "
				+ "ЛимитСтало, ЗарезервированоСтало, ЗаявленоСтало, ИсполненоСтало, ЗарезервированоИзменениеПревышениеТекущегоРезерва, КонтрольРезервов";

	Результат = ДанныеКонтроля.Скопировать(СтруктураПоиска, ИменаКолонок);
	
	Результат.Колонки.Добавить("ДокументРезерва", 	Метаданные.ОпределяемыеТипы.ОбъектыПланирования.Тип);
	Результат.Колонки.Добавить("ПриходРасход", 		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход"));
	Результат.Колонки.Добавить("Свободно", 			Метаданные.ОпределяемыеТипы.ДенежнаяСуммаНеотрицательная.Тип);
	Результат.Колонки.Добавить("Требуется", 		Метаданные.ОпределяемыеТипы.ДенежнаяСуммаНеотрицательная.Тип);
	Результат.Колонки.Добавить("Сумма", 			Метаданные.ОпределяемыеТипы.ДенежнаяСуммаНеотрицательная.Тип);
    Результат.Колонки.Добавить("ТребуетсяРезерв", 	Метаданные.ОпределяемыеТипы.ДенежнаяСуммаНеотрицательная.Тип);  
	Результат.Колонки.Добавить("СуммаРезерв", 		Метаданные.ОпределяемыеТипы.ДенежнаяСуммаНеотрицательная.Тип);  
   	Результат.Колонки.ПериодичностьКонтроля.Имя = "Периодичность";
	Результат.Колонки.НачалоПериодаКонтроля.Имя = "НачалоПериода";
    	
	Для Каждого Данные Из Результат Цикл
		
		Если Данные.ЗаявленоИзменение > 0 И Данные.ЗарезервированоИзменение < 0 Тогда
			Данные.Требуется = Данные.ЗаявленоИзменение;
		Иначе
			Данные.Требуется = Данные.ЗарезервированоИзменение + Данные.ЗаявленоИзменение + Данные.ИсполненоИзменение;
		КонецЕсли;
		
		УказанДокументИсточникЛимита = Ложь;
		ЗарезервированоИзменениеПревышениеТекущегоРезерва = 0;
		Если Данные.Зарезервировано = Данные.ЗарезервированоСтало Тогда // Документ Источник лимита не указан
			Данные.СуммаРезерв = Данные.Требуется;	
		ИначеЕсли ЗначениеЗаполнено(Данные.ЗарезервированоИзменениеПревышениеТекущегоРезерва) Тогда // Документ Источник лимита указан
			ПревышениеТекущегоРезерва = Данные.ЗарезервированоИзменениеПревышениеТекущегоРезерва;  
			Если ПревышениеТекущегоРезерва < 0 Тогда
				Данные.СуммаРезерв = - Данные.ЗарезервированоИзменениеПревышениеТекущегоРезерва; 
				ЗарезервированоИзменениеПревышениеТекущегоРезерва = - Данные.ЗарезервированоИзменениеПревышениеТекущегоРезерва;
				УказанДокументИсточникЛимита = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Данные.ТребуетсяРезерв = Данные.СуммаРезерв; 
			
		Если УказанДокументИсточникЛимита Тогда   
			Данные.Свободно  = Данные.Лимит - Данные.Зарезервировано - Данные.Заявлено - Данные.Исполнено; 
			Данные.Сумма 	 = 0;
			Данные.Требуется = 0;
		Иначе  
			
			Если ОчищатьРезервирование Тогда
				Если ЗначениеЗаполнено(Данные.Зарезервировано) 
					И Не Данные.Зарезервировано = Данные.ЗарезервированоСтало Тогда  		
					Данные.Зарезервировано = 0;	// Документ Источник лимита указан
					ЗарезервированоИзменениеПревышениеТекущегоРезерва = 0;
				КонецЕсли;  
			КонецЕсли;
			
			Данные.Свободно  = Данные.Лимит - Данные.Зарезервировано - Данные.Заявлено - Данные.Исполнено;
			Данные.Сумма 	 = ?(Данные.Требуется > Данные.Свободно, Данные.Требуется - Данные.Свободно, 0);  		
			Данные.Требуется = Данные.Сумма;   
		КонецЕсли;
		
		Если Данные.ТребуетсяРезерв > 0 И Данные.Требуется = 0 
			И (НЕ ИспользоватьРезервированиеФО ИЛИ Данные.КонтрольРезервов = Перечисления.РежимыКонтроляДокументов.НеКонтролировать) Тогда
			Данные.Сумма = Данные.ТребуетсяРезерв - Данные.Свободно; 
			Данные.Требуется = Данные.Сумма;
		КонецЕсли;
		
	КонецЦикла;

	Результат.ЗаполнитьЗначения(Перечисления.ВидыДвиженийПриходРасход.Расход, "ПриходРасход"); 
	
	ОчиститьСтрокиСПустымиСуммами(Результат);
	
	Возврат Результат;  
	
КонецФункции  

Процедура ОчиститьСтрокиСПустымиСуммами(Таблица) Экспорт 

	Если Не ЗначениеЗаполнено(Таблица) Тогда
		Возврат;	
	КонецЕсли;
	
	Сч = 0;
	Пока Сч < Таблица.Количество() Цикл
		ТекущаяСтрока = Таблица[Сч];
		
		Если ТекущаяСтрока.Сумма = 0 
			И ТекущаяСтрока.СуммаРезерв = 0 Тогда
			Таблица.Удалить(Сч);	
		Иначе
			Сч = Сч + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ПолучитьКурсВалютыЛимитирования(Валюта, ДатаКурса) Экспорт

	Результат = РегистрыСведений.ПараметрыЛимитированияКурсыВалют.ПолучитьПоследнее(ДатаКурса, Новый Структура("Валюта", Валюта));
	
	Результат.Вставить("Валюта", Валюта);
	Результат.Вставить("ДатаКурса", ДатаКурса);
	
	Возврат Результат;
	
КонецФункции      

// Функция - формирует из данных контроля, с учетом резервов, 
// данные заполнения документов ЗаявкаНаКорректировкуЛимитов и КорректировкаЛимитов  
Процедура ДанныеСУчетомБюджетныхРезервов(Данные, РезультатыКонтроля) Экспорт      
	
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидКонтроля", ПланыВидовХарактеристик.ВидыКонтроляДокументов.КонтрольБюджетныхРезервов);
	
	Строки = РезультатыКонтроля.НайтиСтроки(СтруктураПоиска);  
	Если Строки.Количество() = 0 Тогда  
		Возврат;	
	КонецЕсли;
	
	КонтрольБюджетныхРезервов = Строки[0].ДанныеКонтроля; 

	Если Не ЗначениеЗаполнено(КонтрольБюджетныхРезервов) Тогда    
		
		Для Каждого СтрокаДанные Из Данные Цикл
			СтрокаДанные.СуммаРезерв 		= 0;     
			СтрокаДанные.ТребуетсяРезерв 	= 0;   
		КонецЦикла;  
		
	Иначе
		
		КонтрольБюджетныхРезервов.Колонки.НачалоПериодаКонтроля.Имя = "НачалоПериода";  
		КонтрольБюджетныхРезервов.Колонки.ПериодичностьКонтроля.Имя = "Периодичность";    					
		
		ДанныеЛимитыРезервы = Данные.СкопироватьКолонки();      
		Реквизиты = "ВидБюджета, Валюта, НачалоПериода, Периодичность, ЦФО, Проект, ОбъектКонтроля, СтатьяБюджета, "
					+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
		СтруктураПоиска = Новый Структура(Реквизиты); 
		Для Каждого СтрокаДанные Из Данные Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДанные);
			
			СтрокиРезерва = КонтрольБюджетныхРезервов.НайтиСтроки(СтруктураПоиска);         					
			
			Для Каждого ЭлементКоллекции Из СтрокиРезерва Цикл  
				
				Если СтрокаДанные.Требуется = 0 И СтрокаДанные.ТребуетсяРезерв = 0 Тогда
					Прервать;
				КонецЕсли;
				
				НоваяСтрокаЛимитыРезервы = ДанныеЛимитыРезервы.Добавить();   
				ЗаполнитьЗначенияСвойств(НоваяСтрокаЛимитыРезервы, СтрокаДанные);  
				
				Если ЗначениеЗаполнено(ЭлементКоллекции.ДатаОперации) Тогда
					НоваяСтрокаЛимитыРезервы.НачалоПериода = ЭлементКоллекции.ДатаОперации;
				КонецЕсли;
					
				// Лимиты  
				ТекущееСписание = Макс(ЭлементКоллекции.ЗаявленоИзменение - ЭлементКоллекции.Зарезервировано, 0);
				ТребуетсяСписать = Мин(СтрокаДанные.Требуется, ТекущееСписание); 
				Коэффициент = ?(СтрокаДанные.Требуется = 0, 1, ТребуетсяСписать / СтрокаДанные.Требуется);
				
				НоваяСтрокаЛимитыРезервы.ДокументРезерва = ЭлементКоллекции.ДокументРезервирования;
				
				НоваяСтрокаЛимитыРезервы.Требуется 	= ТребуетсяСписать; 							
				НоваяСтрокаЛимитыРезервы.Сумма 		= СтрокаДанные.Сумма * Коэффициент;
				НоваяСтрокаЛимитыРезервы.Свободно 	= СтрокаДанные.Свободно * Коэффициент;
				
				СтрокаДанные.Требуется = СтрокаДанные.Требуется - ТребуетсяСписать;   
				
				СтрокаДанные.Сумма = СтрокаДанные.Сумма - НоваяСтрокаЛимитыРезервы.Сумма;
				СтрокаДанные.Свободно = СтрокаДанные.Свободно - НоваяСтрокаЛимитыРезервы.Свободно;      
				
				// Резервы	
				ТекущееСписаниеРезерв = Макс(ЭлементКоллекции.ЗаявленоИзменение - ЭлементКоллекции.Зарезервировано, 0);
				ТребуетсяСписатьРезерв = Макс(СтрокаДанные.ТребуетсяРезерв, ТекущееСписаниеРезерв);     
				КоэффициентРезерв = ?(СтрокаДанные.ТребуетсяРезерв = 0, 1, ТребуетсяСписатьРезерв / СтрокаДанные.ТребуетсяРезерв);
				
				НоваяСтрокаЛимитыРезервы.ТребуетсяРезерв = ТребуетсяСписатьРезерв;
				НоваяСтрокаЛимитыРезервы.СуммаРезерв = СтрокаДанные.СуммаРезерв * КоэффициентРезерв;
				
				СтрокаДанные.СуммаРезерв = СтрокаДанные.СуммаРезерв - НоваяСтрокаЛимитыРезервы.СуммаРезерв;     
				СтрокаДанные.ТребуетсяРезерв = СтрокаДанные.ТребуетсяРезерв - ТребуетсяСписатьРезерв;
				
			КонецЦикла;  
			
			Если СтрокаДанные.Требуется > 0 ИЛИ СтрокаДанные.ТребуетсяРезерв > 0 Тогда        						
				НоваяСтрокаЛимитыРезервы = ДанныеЛимитыРезервы.Добавить();   
				ЗаполнитьЗначенияСвойств(НоваяСтрокаЛимитыРезервы, СтрокаДанные);   
			КонецЕсли;
			
		КонецЦикла;   
		
		Если ЗначениеЗаполнено(ДанныеЛимитыРезервы) Тогда
			Данные = ДанныеЛимитыРезервы;	
		КонецЕсли;					
		
	КонецЕсли;  
		
КонецПроцедуры   

Функция ЭтоЗакупочныйДокумент(Документ) Экспорт  
	
	КоллекцияДокументов = Новый Массив;
	КоллекцияДокументов.Добавить(Тип("ДокументСсылка.СтрокаПланаЗакупок"));	
	КоллекцияДокументов.Добавить(Тип("ДокументСсылка.Лот"));
	КоллекцияДокументов.Добавить(Тип("ДокументСсылка.ПротоколВыбораПобедителей"));
	
	ТипДокумента = ?(ОбщегоНазначения.ПодсистемаСуществует("ПереопределяемыеОбъектыУП"), 
					"ДокументСсылка.ПланЗакупок", "ДокументСсылка.ЗаявкаНаОбеспечение");
    КоллекцияДокументов.Добавить(Тип(ТипДокумента));

	Возврат Не КоллекцияДокументов.Найти(ТипЗнч(Документ)) = Неопределено;    
	
КонецФункции

Функция ТипыДокументаОснованияКорректировкиЛимитов() Экспорт  
	
	ТипыОбъектыПланирования = Метаданные.ОпределяемыеТипы.ОбъектыПланирования.Тип.Типы();
	
	МассивТиповКУдалению = Новый Массив();
	
	МассивТиповКУдалению.Добавить(Тип("ДокументСсылка.ОперативныйПлан")); 
	МассивТиповКУдалению.Добавить(Тип("ДокументСсылка.ОжидаемоеПоступлениеДенежныхСредств"));
	МассивТиповКУдалению.Добавить(Тип("ДокументСсылка.ПланируемыйДоход")); 
	МассивТиповКУдалению.Добавить(ВстраиваниеУХ.ТипДокументСсылкаПоступлениеТоваровУслуг());
	МассивТиповКУдалению.Добавить(Тип("ДокументСсылка.ЗаказКлиента")); 
	МассивТиповКУдалению.Добавить(Тип("ДокументСсылка.УдалитьОперативныйПлан")); 
	
	Для каждого Элемент Из МассивТиповКУдалению Цикл
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ТипыОбъектыПланирования, Элемент);
	КонецЦикла; 
		
	Возврат Новый ОписаниеТипов(ТипыОбъектыПланирования);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроцедурыПересчетаСуммЛимитовПриИзмененииНастроек

Процедура ВыполнитьПересчетЛимитовПоБюджетуПериоду(ВидБюджета, НачалоДействия)
	
	ИмяВременнойТаблицыПланирования = "ВТ_Данные";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("НачалоДействия", НачалоДействия);
	
	// 1. Получить 
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета,
	|	МИНИМУМ(ПараметрыЛимитированияСрезПоследних.Период) КАК НачалоСледующегоПериода
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитированияСрезПоследних
	|ГДЕ
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета = &ВидБюджета
	|	И ПараметрыЛимитированияСрезПоследних.Период > &НачалоДействия
	|
	|СГРУППИРОВАТЬ ПО
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета";
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Получить параметры лимитирования: способы определения валюты лимитирования, курсы валют и т.д.
	Если Выборка.Следующий() Тогда
		Запрос.УстановитьПараметр("ОкончаниеДействия", КонецДня(НачалоДня(Выборка.НачалоСледующегоПериода) - 1));
	Иначе
		Запрос.УстановитьПараметр("ОкончаниеДействия", Неопределено);
	КонецЕсли;
	
	// 2. Получить данные для расчета
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииБюджетовОбороты.Регистратор КАК Регистратор,
	|	ОперацииБюджетовОбороты.НомерСтроки КАК НомерСтроки,
	|	ОперацииБюджетовОбороты.ВидБюджета КАК ВидБюджета,
	|	ОперацииБюджетовОбороты.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ОперацииБюджетовОбороты.Валюта КАК Валюта,
	|	ОперацииБюджетовОбороты.ВалютаЛимитирования КАК ВалютаЛимитирования,
	|	НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ДЕНЬ) КАК ДатаОперации,
	|	ОперацииБюджетов.КурсЗаданВОперации КАК КурсЗаданВОперации,
	|	ОперацииБюджетов.КурсПланирования КАК КурсПланирования,
	|	ОперацииБюджетов.КратностьПланирования КАК КратностьПланирования,
	|	ОперацииБюджетов.КурсЛимитирования КАК КурсЛимитирования,
	|	ОперацииБюджетов.КратностьЛимитирования КАК КратностьЛимитирования,
	|	ОперацииБюджетов.Сумма КАК Сумма,
	|	ОперацииБюджетов.СуммаИсполнено КАК СуммаИсполнено
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов.Обороты(&НачалоДействия, &ОкончаниеДействия, Запись, ВидБюджета = &ВидБюджета) КАК ОперацииБюджетовОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ОперацииБюджетовОбороты.Регистратор = ОперацииБюджетов.Регистратор
	|			И ОперацииБюджетовОбороты.НомерСтроки = ОперацииБюджетов.НомерСтроки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	ДатаОперации"; 
	
	Запрос.Выполнить();
	
	// 3. Действующие настройки лимитирования
	ДействующиеНастройкиЛимитирования(Запрос, ИмяВременнойТаблицыПланирования);
	
	// 4. Параметры лимитирования валют и курсы
	ПараметрыЛимитирования_Валюты(Запрос, ИмяВременнойТаблицыПланирования);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КурсыВалют.Валюта КАК Валюта,
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	МАКСИМУМ(КурсыВалют.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ДатыКурсовВалют
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ВТ_Данные.ДатаОперации >= КурсыВалют.Период
	|ГДЕ
	|	ВТ_Данные.СуммаИсполнено <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.ДатаОперации,
	|	КурсыВалют.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта,
	|	ДатаОперации";
	Запрос.Выполнить();
	
	// 5. Наборы записей для корректировки
	Корректировки = ДанныеДляКорректировкиНаборовЗаписей(Запрос);

	Запрос.МенеджерВременныхТаблиц.Закрыть();
	
	// 6. Корректировка набора записей
	ВыборкаДокумент = Корректировки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокумент.Следующий() Цикл
		
		НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДокумент.Регистратор);
		НаборЗаписей.Прочитать();

		СкорректироватьНаборЗаписей(НаборЗаписей, ВыборкаДокумент.Выбрать(), Ложь);
		
		НаборЗаписей.ДополнительныеСвойства.Вставить("ПересчетПриИзмененииПараметровЛимитирования", Истина);
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьПересчетЛимитовПоБюджетуЦФОПериоду(ВидБюджета, НачалоДействия, ЦФО)
	
	ИмяВременнойТаблицыПланирования = "ВТ_Данные";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("ЦФО", ЦФО);
	Запрос.УстановитьПараметр("НачалоДействия", НачалоДействия);
	
	// 1. Получить 
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета,
	|	МИНИМУМ(ПараметрыЛимитированияСрезПоследних.Период) КАК НачалоСледующегоПериода
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитированияСрезПоследних
	|ГДЕ
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета = &ВидБюджета
	|	И ПараметрыЛимитированияСрезПоследних.Период > &НачалоДействия
	|
	|СГРУППИРОВАТЬ ПО
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета";
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Получить параметры лимитирования: способы определения валюты лимитирования, курсы валют и т.д.
	Если Выборка.Следующий() Тогда
		Запрос.УстановитьПараметр("ОкончаниеДействия", КонецДня(НачалоДня(Выборка.НачалоСледующегоПериода) - 1));
	Иначе
		Запрос.УстановитьПараметр("ОкончаниеДействия", Неопределено);
	КонецЕсли;
	
	// 2. Получить данные для расчета
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииБюджетовОбороты.Регистратор КАК Регистратор,
	|	ОперацииБюджетовОбороты.НомерСтроки КАК НомерСтроки,
	|	ОперацииБюджетовОбороты.ВидБюджета КАК ВидБюджета,
	|	ОперацииБюджетовОбороты.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ОперацииБюджетовОбороты.Валюта КАК Валюта,
	|	ОперацииБюджетовОбороты.ВалютаЛимитирования КАК ВалютаЛимитирования,
	|	НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ДЕНЬ) КАК ДатаОперации,
	|	ОперацииБюджетов.КурсЗаданВОперации КАК КурсЗаданВОперации,
	|	ОперацииБюджетов.КурсПланирования КАК КурсПланирования,
	|	ОперацииБюджетов.КратностьПланирования КАК КратностьПланирования,
	|	ОперацииБюджетов.КурсЛимитирования КАК КурсЛимитирования,
	|	ОперацииБюджетов.КратностьЛимитирования КАК КратностьЛимитирования,
	|	ОперацииБюджетов.Сумма КАК Сумма,
	|	ОперацииБюджетов.СуммаИсполнено КАК СуммаИсполнено
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов.Обороты(
	|			&НачалоДействия,
	|			&ОкончаниеДействия,
	|			Запись,
	|			ВидБюджета = &ВидБюджета
	|				И АналитикаСтруктуры.ЦФО = &ЦФО) КАК ОперацииБюджетовОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|		ПО ОперацииБюджетовОбороты.Регистратор = ОперацииБюджетов.Регистратор
	|			И ОперацииБюджетовОбороты.НомерСтроки = ОперацииБюджетов.НомерСтроки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	ДатаОперации";  
	
	Запрос.Выполнить();
	
	// 3. Действующие настройки лимитирования
	ДействующиеНастройкиЛимитирования(Запрос, ИмяВременнойТаблицыПланирования);
	
	// 4. Параметры лимитирования валют и курсы
	ПараметрыЛимитирования_Валюты(Запрос, ИмяВременнойТаблицыПланирования);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КурсыВалют.Валюта КАК Валюта,
	|	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	|	МАКСИМУМ(КурсыВалют.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ДатыКурсовВалют
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ВТ_Данные.ДатаОперации >= КурсыВалют.Период
	|ГДЕ
	|	ВТ_Данные.СуммаИсполнено <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.ДатаОперации,
	|	КурсыВалют.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта,
	|	ДатаОперации";
	Запрос.Выполнить();
	
	// 5. Наборы записей для корректировки
	Корректировки = ДанныеДляКорректировкиНаборовЗаписей(Запрос);

	Запрос.МенеджерВременныхТаблиц.Закрыть();
	
	// 6. Корректировка набора записей
	ВыборкаДокумент = Корректировки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокумент.Следующий() Цикл
		
		НаборЗаписей = РегистрыНакопления.ОперацииБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДокумент.Регистратор);
		НаборЗаписей.Прочитать();

		СкорректироватьНаборЗаписей(НаборЗаписей, ВыборкаДокумент.Выбрать(), Ложь);
		
		НаборЗаписей.ДополнительныеСвойства.Вставить("ПересчетПриИзмененииПараметровЛимитирования", Истина);
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

