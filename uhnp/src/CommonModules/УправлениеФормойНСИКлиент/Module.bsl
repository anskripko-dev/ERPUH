Процедура ПоказатьРеквизитыЦНСИ(Форма) Экспорт
	
	Пар = Новый Структура("Ссылка, ИмяФормы", Форма.Объект.Ссылка, Форма.ИмяФормы); 
	ИмяФормыИзменения="ОбщаяФорма.ФормаИзмененияРеквизитовНСИ";
	ОткрытьФорму(ИмяФормыИзменения,Пар,Форма);
		
КонецПроцедуры // ПоказатьРеквизитыЦНСИ()

Процедура ПоказатьАктивнуюЗаявку(Ссылка,НеАктивный) Экспорт
	
	ТекЗаявка = УправлениеФормойНСИВызовСервера.СуществуетРабочаяЗаявка(Ссылка);
	
	Если ТекЗаявка<>Неопределено Тогда 
		ПоказатьЗначение(, ТекЗаявка);
	КонецЕсли;
		
КонецПроцедуры


Процедура ОткрытьСписокЗаявокНаИзменениеНСИ(Форма) Экспорт
	
	ПараметрыФормы = Новый Структура("ИзменяемыйОбъект",Форма.Объект.Ссылка);
	
	ИмяФормыСписка="Документ.ЗаявкаНаИзменениеНСИ.ФормаСписка";
	ОткрытьФорму(ИмяФормыСписка, ПараметрыФормы,Форма,Новый УникальныйИдентификатор);
		
КонецПроцедуры // ПоказатьРеквизитыЦНСИ() 

Процедура ПроверитьВозможностьСоздания(Форма,Отказ) Экспорт 
		
	//Если Не ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
	//	
	//	Возврат;
	//	
	//КонецЕсли; 
	
	ОбъектСсылка=Форма.Объект.Ссылка;
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		
		Возврат;
		
	Конецесли;
	
	СтруктураКонтроля=УправлениеФормойНСИВызовСервера.ДанныеКонтроляНСИ(ОбъектСсылка);
	
	Если НЕ СтруктураКонтроля.КонтролироватьНСИ Тогда
		
		Возврат;
		
	КонецЕсли;	
		
	Если СтруктураКонтроля.ИзмененияЗапрещены Тогда
		
		Если ЗначениеЗаполнено(СтруктураКонтроля.ЦентрализованнаяБазаНСИ) Тогда
			
			ТекстПредупреждения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Элементы справочника %1 загружаются из централизованной базы %2. Интерактивное создание элементов запрещено.'"),СтруктураКонтроля.Наименование,СтруктураКонтроля.ЦентрализованнаяБазаНСИ);
			
		Иначе
			
			ТекстПредупреждения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для справочника %1 установлен признак ""Потребитель НСИ"". Элементы загружаются из внешних баз, интерактивное создание элементов запрещено.'"),СтруктураКонтроля.Наименование);
			
		КонецЕсли;
		
		ПоказатьПредупреждение(,ТекстПредупреждения,60);
		Отказ=Истина;

		Возврат;
		
	КонецЕсли;
	
	Если НЕ ТипЗнч(Форма.ВладелецФормы)=Тип("ПолеФормы") Тогда 
		
		Возврат;
		
	КонецЕсли;
								
	ТекстПредупреждения=СтрШаблон(Нстр("ru = 'Справочник %1 является контролируемым. Создание возможно только из формы списка.'"),СтруктураКонтроля.Наименование);
	
	ПоказатьПредупреждение(,ТекстПредупреждения,60);
	Отказ=Истина;
				
КонецПроцедуры // ПроверитьВозможностьЗаписи()

Процедура ПринятьКСогласованию(Форма, Ссылка,СогласованиеВнешняяИБ) Экспорт
	
	Если СогласованиеВнешняяИБ Тогда
		
		Если Форма.Модифицированность Тогда		
			Форма.Записать();			
		КонецЕсли;
		
		УправлениеФормойНСИВызовСервера.ПринятьКСогласованиюВнешний(Форма.Объект.Ссылка);
		
	Иначе
		
		МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");
		МодульСогласования.ПринятьКСогласованию(Форма, Ссылка);
				
	КонецЕсли;
		
КонецПроцедуры // ПринятьКСогласованию()

Процедура ИсторияСогласования(Форма,Ссылка,СогласованиеВнешняяИБ) Экспорт

	Если СогласованиеВнешняяИБ Тогда
		
		ИмяФормы="ОбщаяФорма.ИсторияСогласованияЦентрализованнаяБаза";
		
		ОткрытьФорму(ИмяФормы,Новый Структура("ЗаявкаДочерняяБаза,ТипОтчета",Ссылка,"ИсторияСогласования"),Форма);
		
	Иначе
		
		ИмяФормы="Отчет.ИсторияСогласования.Форма.ФормаОтчета";
		ОткрытьФорму(ИмяФормы, Новый Структура("КлючевойОбъектПроцесса", Ссылка), Форма);
		
	КонецЕсли;
		
КонецПроцедуры // ИсторияСогласования() 

Процедура МаршрутСогласования(Форма, Ссылка,СогласованиеВнешняяИБ) Экспорт
	
	Если СогласованиеВнешняяИБ Тогда  
		
		ИмяФормы="ОбщаяФорма.ИсторияСогласованияЦентрализованнаяБаза";
		
		ОткрытьФорму(ИмяФормы,Новый Структура("ЗаявкаДочерняяБаза,ТипОтчета",Ссылка,"ХодСогласования"),Форма);
		
	Иначе
		
		МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");
		МодульСогласования.МаршрутСогласования(Форма, Ссылка);
				
	КонецЕсли;
			
КонецПроцедуры // МаршрутСогласования() 

Процедура ПроверитьВозможностьВыбораНеактивных(ФормаВыбора,ИмяСписка) Экспорт
	
	Если НЕ ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПодсистемыУХ.ИнтеграцияВИБ") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ФормаВызова=ФормаВыбора.ВладелецФормы;
	
	Если ФормаВызова=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	НеобходимОтбор=Истина;
	
	Попытка
		
		Пока ТипЗнч(ФормаВызова) <> Тип("ФормаКлиентскогоПриложения") Цикл
			ФормаВызова = ФормаВызова.Родитель;
		КонецЦикла;
		
		Если СтрНайти(ФормаВызова.ИмяФормы,"ФормаЭлементаРеквизитыКонтрагента")>0 Тогда
			
			СтруктураКонтроляПартнер=УправлениеФормойНСИВызовСервера.ДанныеКонтроляНСИ(ФормаВызова.Объект.Ссылка);
			СтруктураКонтроляКонтрагент=УправлениеФормойНСИВызовСервера.ДанныеКонтроляНСИ(ФормаВызова.КонтрагентПартнера);
			
			НеобходимОтбор=НЕ (СтруктураКонтроляПартнер.ВыборНеАктивных И СтруктураКонтроляКонтрагент.ВыборНеАктивных);
					
		ИначеЕсли СтрНайти(ФормаВызова.ИмяФормы,"ФормаЭлемента")>0
			И ФормаВызова.Объект.Свойство("Ссылка") Тогда
			
			СтруктураКонтроля=УправлениеФормойНСИВызовСервера.ДанныеКонтроляНСИ(ФормаВызова.Объект.Ссылка);
			НеобходимОтбор=НЕ СтруктураКонтроля.ВыборНеАктивных;
			
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;
			
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФормаВыбора[ИмяСписка], "НСИ_НеАктивный", Ложь, ВидСравненияКомпоновкиДанных.Равно,,НеобходимОтбор); 
				
КонецПроцедуры // РазрешитьИспользованиеНеактивных() 

