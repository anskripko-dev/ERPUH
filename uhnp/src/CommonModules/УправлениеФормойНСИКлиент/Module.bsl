Процедура ВвестиЗаявкуНаСогласованиеИзменений(Форма,АдресДанныхОбъекта) Экспорт
		
	Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
				
		Возврат;
		
	КонецЕсли;
	
	ТекЗаявка=УправлениеФормойНСИВызовСервера.ПолучитьЗаявкуНСИИзменение(АдресДанныхОбъекта); 
	
	Если ТекЗаявка<>Неопределено Тогда 
		ПоказатьЗначение(, ТекЗаявка);
		Форма.Модифицированность=Ложь;
		Форма.Закрыть();
	КонецЕсли; 
			
КонецПроцедуры // ВвестиЗаявкуНаРегистрацию()

Процедура ВвестиЗаявкуНаУдаление(Форма) Экспорт
	
	ТекЗаявка=УправлениеФормойНСИВызовСервера.ПолучитьЗаявкуНСИУдаление(Форма.Объект.Ссылка);
	
	Если ТекЗаявка<>Неопределено Тогда 
		ПоказатьЗначение(, ТекЗаявка);
	КонецЕсли;
	
	Форма.Модифицированность=Ложь;
	Форма.Закрыть();
		
КонецПроцедуры // ВвестиЗаявкуНаРегистрацию()

