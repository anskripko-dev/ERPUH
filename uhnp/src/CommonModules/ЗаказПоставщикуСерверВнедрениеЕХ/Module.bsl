							СтрокаТабличнойЧасти.ДатаОтгрузки, РеквизитыДокумента.Дата));
			
			НоваяСтрока = ТаблицаПлановБДР.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыДокумента);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
			
			НоваяСтрока.ВидБюджета = БюджетДоходовИРасходов;
			НоваяСтрока.ДоговорКонтрагента = РеквизитыДокумента.Договор;
			НоваяСтрока.ПриходРасход = Расход; 
			НоваяСтрока.Период = ДатаОтгрузки;
			НоваяСтрока.ДатаОперации = ДатаОтгрузки;
			НоваяСтрока.ДатаОтгрузки = ДатаОтгрузки;
			НоваяСтрока.ДокументПланирования = РеквизитыДокумента.Ссылка;
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.АналитикаПланирования.ОбъектПланирования) Тогда
				НоваяСтрока.ДокументРезервирования = СтрокаТабличнойЧасти.АналитикаПланирования.ОбъектПланирования.Объект;
			Иначе
				НоваяСтрока.ДокументРезервирования = ?(НеИспользоватьГрафикДоговора, Неопределено, РеквизитыДокумента.Договор);
			КонецЕсли;
			НоваяСтрока.Ссылка = РеквизитыДокумента.Ссылка;
			
		КонецЦикла;
		
		ТаблицаПлановБДДС = КонтрольЛимитовУХ.Новый_ТаблицаПланыДокумента();
		
		ТаблицаПлановБДДС.Колонки.Добавить("СтатьяБюджетаБДДС", Метаданные.ПланыВидовХарактеристик.ВидыБюджетов.Тип);
		ТаблицаПлановБДДС.Колонки.Добавить("ДатаПлатежа", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
		ТаблицаПлановБДДС.Колонки.Добавить("СуммаПлатежа", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
		
		Для Ном = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			ТаблицаПлановБДДС.Колонки.Добавить("АналитикаБДДС" + Формат(Ном, "ЧГ="), 
					Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип));
		КонецЦикла;

		БюджетДвиженияДенежныхСредств = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		
		Для Каждого СтрокаТабличнойЧасти Из Источник.ГрафикОплатыУХ Цикл
			
			ДатаПлатежа = НачалоДня(?(ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДатаПлатежа), 
							СтрокаТабличнойЧасти.ДатаПлатежа, РеквизитыДокумента.Дата));
	
			НоваяСтрока = ТаблицаПлановБДДС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыДокумента);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
			
			НоваяСтрока.ВидБюджета = БюджетДвиженияДенежныхСредств;
			НоваяСтрока.ДоговорКонтрагента = РеквизитыДокумента.Договор;
			НоваяСтрока.ПриходРасход = Расход; 
			НоваяСтрока.Сумма = СтрокаТабличнойЧасти.СуммаПлатежа;
			НоваяСтрока.Период = ДатаПлатежа; 
			НоваяСтрока.ДатаОперации = ДатаПлатежа;
			НоваяСтрока.ДатаПлатежа = ДатаПлатежа;
			НоваяСтрока.ДокументПланирования = РеквизитыДокумента.Ссылка;
			НоваяСтрока.ДокументРезервирования = ?(НеИспользоватьГрафикДоговора, Неопределено, РеквизитыДокумента.Договор);
			
		КонецЦикла;
		
		Запрос.УстановитьПараметр("ТаблицаПлановБДР", ТаблицаПлановБДР);
		Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Товары ИЗ &ТаблицаПлановБДР КАК Коллекция ";
		Запрос.Выполнить();
		
		Запрос.УстановитьПараметр("ТаблицаПлановБДДС", ТаблицаПлановБДДС);
		Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ГрафикОплатыУХ ИЗ &ТаблицаПлановБДДС КАК Коллекция ";
		Запрос.Выполнить();
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ЗаказПоставщику.", "ВТ_");   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "График.Ссылка = &Ссылка", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументРезервированияБДР", "График.ДокументРезервирования");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументРезервированияБДДС", "График.ДокументРезервирования");
		
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Если ИмяВременнойТаблицы <> "" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ПланыДокумента", ИмяВременнойТаблицы);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ПланыДокумента");

	Возврат Запрос.МенеджерВременныхТаблиц; 
	
КонецФункции

Функция ДанныеОбъектаПоСсылке(Источник)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Источник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Дата КАК Дата,
	|	Документ.Организация КАК Организация,
	|	Документ.Контрагент КАК Контрагент,
	|	Документ.Договор КАК Договор,
	|	Документ.ПоступлениеОднойДатой КАК ПоступлениеОднойДатой,
	|	Документ.ДатаПоступления КАК ДатаПоступления,
	|	Документ.ПорядокРасчетов КАК ПорядокРасчетов,
	|	Документ.РежимИспользованияГрафика КАК РежимИспользованияГрафика,
	|	Документ.ЭтапыГрафикаОплаты.(
	|		ДатаПлатежа КАК ДатаПлатежа,
	|		ВариантОплаты КАК ВариантОплаты,
	|		СуммаПлатежа КАК СуммаПлатежа,
	|		СуммаЗалогаЗаТару КАК СуммаЗалогаЗаТару,
	|		ИдентификаторПозиции КАК ИдентификаторПозиции
	|	) КАК ГрафикРасчетов,
	|	Документ.Товары.(
	|		ДатаПоступления КАК ДатаПоступления,
	|		СуммаСНДС КАК СуммаСНДС
	|	) КАК Товары,
	|	Документ.АналитикиПланирования.(
	|		ВидБюджета КАК ВидБюджета,
	|		ДокументРезервирования КАК ДокументРезервирования,
	|		ЦФО КАК ЦФО,
	|		Проект КАК Проект,
	|		СтатьяБюджета КАК СтатьяБюджета,
	|		Аналитика1 КАК Аналитика1,
	|		Аналитика2 КАК Аналитика2,
	|		Аналитика3 КАК Аналитика3,
	|		Аналитика4 КАК Аналитика4,
	|		Аналитика5 КАК Аналитика5,
	|		Аналитика6 КАК Аналитика6
	|	) КАК АналитикиПланирования
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &Ссылка";
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка,, "ГрафикРасчетов");
		Результат.ГрафикРасчетов = Выборка.ГрафикРасчетов.Выгрузить();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьАналитикиПланированияБДДС(ДанныеОбъекта)
	
	СтруктураПоиска = Новый Структура("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	Строки = ДанныеОбъекта.АналитикиПланирования.НайтиСтроки(СтруктураПоиска);
	Если Строки.Количество() > 0 Тогда
		Возврат Строки[0];
	КонецЕсли;
	
	Возврат неопределено;
	
КонецФункции

Функция ПолучитьАналитикиПланированияПоставки(ДанныеОбъекта)
	
	Для Каждого Строка Из ДанныеОбъекта.АналитикиПланирования Цикл
		
		Если Строка.ВидБюджета <> ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда
			Возврат Строка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат неопределено;
	
КонецФункции

#КонецОбласти 

#Область КомандыСозданияНаОсновании
	
// Определяет список команд создания на основании документа ЗаказПоставщику.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОснованииЗаказПоставщику(КомандыСозданияНаОсновании, Параметры) Экспорт

	// Претензия
	Данные = Метаданные.Справочники.ПретензииУХ;
	НоваяКоманда = ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, Данные);
	Если НоваяКоманда <> Неопределено Тогда
		НоваяКоманда.Обработчик = "УправлениеЗакупкамиВстраиваниеПереопределяемыйКлиентУХ.СоздатьСправочникПретензииНаОснованииЗаказаПоставщику";
		НоваяКоманда.ВидимостьВФормах = "ФормаДокумента, ФормаСпискаДокументов";
		НоваяКоманда.МножественныйВыбор = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Определяет список команд создания на основании документа Возврат товаров поставщику.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОснованииВозвратаТоваровПоставщику(КомандыСозданияНаОсновании, Параметры) Экспорт

	// Претензия
	Данные = Метаданные.Справочники.ПретензииУХ;
	НоваяКоманда = ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, Данные);
	Если НоваяКоманда <> Неопределено Тогда
		НоваяКоманда.Обработчик = "УправлениеЗакупкамиВстраиваниеПереопределяемыйКлиентУХ.СоздатьСправочникПретензииНаОснованииВозвратаТоваровПоставщику";
		НоваяКоманда.ВидимостьВФормах = "ФормаДокумента, ФормаСписка";
		НоваяКоманда.МножественныйВыбор = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Добавляет команду создания документа по его метаданным.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//	 МетаданныеДокумента - 
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, МетаданныеДокумента) Экспорт
	
	Если ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = МетаданныеДокумента.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = ОбщегоНазначенияУТ.ПредставлениеОбъекта(МетаданныеДокумента);
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти 

Процедура ДобавитьТекстыЗапросов(Запрос, ТекстыЗапроса, Регистры) Экспорт
	ДобавитьТекстЗапросаРасчетыСКонтрагентамиГрафики(ТекстыЗапроса);   
	ДобавитьТекстЗапросаВерсииРасчетов(ТекстыЗапроса);
КонецПроцедуры	

Процедура ДобавитьТекстЗапросаРасчетыСКонтрагентамиГрафики(ТекстыЗапроса)
	
	ИмяРегистра = "РасчетыСКонтрагентамиГрафики";
	
	//Если Не ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
	//	Возврат "";
	//КонецЕсли; 
				 
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА График.ДатаОтгрузки = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА НАЧАЛОПЕРИОДА(График.Ссылка.Дата, ДЕНЬ)
	|		ИНАЧЕ График.ДатаОтгрузки
	|	КОНЕЦ КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&Ссылка КАК ВерсияГрафика,
	|	График.Ссылка.ОбъектРасчетов.Объект КАК ПредметГрафика,
	|	График.СтатьяБюджетаБДР КАК СтатьяБюджета,
	|	График.АналитикаБДР1 КАК Аналитика1,
	|	График.АналитикаБДР2 КАК Аналитика2,
	|	График.АналитикаБДР3 КАК Аналитика3,
	|	График.АналитикаБДР4 КАК Аналитика4,
	|	График.АналитикаБДР5 КАК Аналитика5,
	|	График.АналитикаБДР6 КАК Аналитика6,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов) КАК ВидБюджета,
	|	График.Ссылка.Договор.ВидДоговораУХ КАК ВидДоговораУХ,
	|	График.ЦФО КАК ЦФО,
	|	График.Проект КАК Проект,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
	|	График.Сумма КАК Сумма,
	|	&Валюта КАК Валюта,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг) КАК ЭлементСтруктурыЗадолженности,
	|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.РасходныйКоммерческийДоговор_Начисление) КАК Операция,
	|	График.Ссылка.БанковскийСчет КАК СчетОрганизации,
	|	График.Ссылка.БанковскийСчетКонтрагента КАК СчетКонтрагента
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК График
	|ГДЕ
	|	График.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	График.ДатаПлатежа,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	&Ссылка,
	|	График.Ссылка.ОбъектРасчетов.Объект,
	|	График.СтатьяБюджета,
	|	График.Аналитика1,
	|	График.Аналитика2,
	|	График.Аналитика3,
	|	График.Аналитика4,
	|	График.Аналитика5,
	|	График.Аналитика6,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
	|	График.Ссылка.Договор.ВидДоговораУХ,
	|	График.ЦФО,
	|	График.Проект,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход),
	|	График.СуммаПлатежа,
	|	&Валюта,
	|	&Организация,
	|	&Контрагент,
	|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг),
	|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.РасходныйКоммерческийДоговор_Оплата),
	|	График.СчетОрганизации,
	|	График.СчетКонтрагента
	|ИЗ
	|	Документ.ЗаказПоставщику.ГрафикОплатыУХ КАК График
	|ГДЕ
	|	График.Ссылка = &Ссылка";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

КонецПроцедуры

Процедура ДобавитьТекстЗапросаВерсииРасчетов(ТекстыЗапроса) 
	
	ИмяРегистра = "ВерсииГрафиковРасчетов";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВерсияФИ.Дата КАК Период,
	|	ВерсияФИ.Ссылка КАК ВерсияГрафика,
	|	ВерсияФИ.Ссылка КАК ПредметГрафика,
	|	ВерсияФИ.Организация КАК Организация,
	|	ЛОЖЬ КАК ОпорныйГрафик
	|ИЗ
	|	Документ.ЗаказПоставщику.ГрафикОплатыУХ КАК ЗаказПоставщикуГрафикОплатыУХ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ВерсияФИ
	|		ПО ЗаказПоставщикуГрафикОплатыУХ.Ссылка = ВерсияФИ.Ссылка
	|ГДЕ
	|	ВерсияФИ.Ссылка = &Ссылка";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

КонецПроцедуры

