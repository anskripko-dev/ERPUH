Процедура СоздатьЭлементыАналитикиСтатейБюджетов(Форма) 
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ПараметрыЭлементов = ПолучитьПараметрыЭлементовПоУмолчанию();
	
	ПараметрыПоляВвода = Новый Структура;
	
	ПараметрыПоляФлажка = Новый Структура;
	ПараметрыПоляФлажка.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Право);
	
	ФормыУХ.СоздатьПолеФормы(Элементы, "ЦФО", "", "Объект.Товары.ЦФО", ВидПоляФормы.ПолеВвода, Элементы.Товары, Элементы.ТоварыГруппаПолучатель); 
	ФормыУХ.СоздатьПолеФормы(Элементы, "Проект", "", "Объект.Товары.Проект", ВидПоляФормы.ПолеВвода, Элементы.Товары, Элементы.ТоварыГруппаПолучатель);
	
	// Статьи бюджетов
	МассивОписанийСтатей = Новый Массив;
	
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
						"Объект.Товары", "Товары",
						"СтатьяБюджетаБДР", "ТоварыСтатьяБюджета",
						"АналитикаБДР%1", "ТоварыАналитика%1",
						ФормыУХ.РазместитьПередЭлементомСтрокой(Элементы.ТоварыГруппаПолучатель));
	
	// Создать элементы формы для статей бюджетов и их аналитик
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(Форма, МассивОписанийСтатей, ПараметрыЭлементов.ПолеВвода);
	
	СоздатьЭлементыВидыБюджетов(Форма);
	Элементы.ТоварыСтатьяБюджета.СвязьПоТипу = Новый СвязьПоТипу("ВидБюджетаБДР");
	
КонецПроцедуры   

Процедура СоздатьЭлементыВидыБюджетов(Форма)   

	Элементы = Форма.Элементы;

	ДобавляемыеРеквизиты = Новый Массив;  
	
	Реквизит = Новый РеквизитФормы("ВидБюджетаБДДС", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыБюджетов"));
	ДобавляемыеРеквизиты.Добавить(Реквизит);
	
	Реквизит = Новый РеквизитФормы("ВидБюджетаБДР", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыБюджетов"));
	ДобавляемыеРеквизиты.Добавить(Реквизит);    
	
    Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);      
	Форма.ВидБюджетаБДДС = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
