#Область ПроцедурыИФункцииЭтапыГрафикаОплаты

Функция ПолучитьЭтапыГрафикаОплаты(ПараметрыЭтапы)
	
	Перем ЭтапыГрафикаОплаты;
		
	ДобавитьКолонкиВТаблицуЭтапыГрафикаОплаты(ПараметрыЭтапы.ТаблицаЭтапыГрафикаОплаты);
	
	Если ПараметрыЭтапы.РеквизитыВерсииСоглашения.ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикПоставок
		Или ПараметрыЭтапы.РеквизитыВерсииСоглашения.ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикРасчетов Тогда
		
		ЭтапыГрафикаОплаты = ЗаполнитьЭтапыГрафикаОплатыПоставокРасчетов(ПараметрыЭтапы);
		
    ИначеЕсли ПараметрыЭтапы.РеквизитыВерсииСоглашения.ГрафикДоговора = Перечисления.ГрафикиДоговора.Резервирование Тогда   
		
		ЭтапыГрафикаОплаты = ЗаполнитьЭтапыГрафикаОплатыРезервирование(ПараметрыЭтапы);  
		
    ИначеЕсли ПараметрыЭтапы.РеквизитыВерсииСоглашения.ГрафикДоговора = Перечисления.ГрафикиДоговора.НеИспользовать Тогда   
		
		ЭтапыГрафикаОплаты = ЗаполнитьЭтапыГрафикаОплатыНеИспользовать(ПараметрыЭтапы); 
		
	КонецЕсли;    
	
	Возврат ЭтапыГрафикаОплаты;     
	
КонецФункции

Функция ЗаполнитьЭтапыГрафикаОплатыПоставокРасчетов(ПараметрыЭтапы)
	
	Если ПараметрыЭтапы.ВидБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда
		ЭтапыГрафикаОплаты = ЗаполнитьЭтапыГрафикаОплатыПоставокРасчетовБДДС(ПараметрыЭтапы); // БДДС
	Иначе
		ЭтапыГрафикаОплаты = ЗаполнитьЭтапыГрафикаОплатыПоставокРасчетовБДР(ПараметрыЭтапы); // БДР, Контроль выключен
	КонецЕсли;
		
	Возврат ЭтапыГрафикаОплаты;
 
КонецФункции

Функция ЗаполнитьЭтапыГрафикаОплатыПоставокРасчетовБДДС(ПараметрыЭтапы)

	Если ПараметрыЭтапы.Свойство("ЭтоРасчетыСКлиентами") Тогда
		ТаблицаОплат = ЗаполнитьЭтапыБДДСКлиентом(ПараметрыЭтапы);	
	Иначе
		ТаблицаОплат = ЗаполнитьЭтапыБДДСПоставщику(ПараметрыЭтапы);	
	КонецЕсли;
	
	Возврат ТаблицаОплат;
		
КонецФункции  

Функция ЗаполнитьЭтапыБДДСПоставщику(ПараметрыЭтапы)

	ТаблицаТовары = ПараметрыЭтапы.Товары;
	
	Если ЭтоАдресВременногоХранилища(ПараметрыЭтапы.Товары) Тогда
		ТаблицаТовары = ПолучитьИзВременногоХранилища(ПараметрыЭтапы.Товары);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ТаблицаТовары) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	РеквизитыВерсииСоглашения = ПараметрыЭтапы.РеквизитыВерсииСоглашения;
	
	КолонкиГруппировок = "ДатаОтгрузки,ДатаПоступления,ЦФО,Проект,СтатьяБюджетаБДДС, 
				|АналитикаБДДС1,АналитикаБДДС2,АналитикаБДДС3,АналитикаБДДС4,АналитикаБДДС5,АналитикаБДДС6";
	КолонкиСуммирования = "Сумма, СуммаСНДС";
	
	ТаблицаТовары.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	ТаблицаЭтапыГрафикаОплаты = ПараметрыЭтапы.ТаблицаЭтапыГрафикаОплаты;
	
	ТаблицаОплат = ТаблицаЭтапыГрафикаОплаты();
	ТаблицаОплатБуфер = ТаблицаОплат.Скопировать();  
	
	Для Каждого СтрокаНачисления Из ТаблицаТовары Цикл
		
		ТаблицаОплатБуфер.Очистить();
		
		ПараметрыЗаполнения = ЭтапыОплатыСервер.ПараметрыЗаполненияЭтаповОплаты();
		ПараметрыЗаполнения.ЭтоРасчетыСКлиентами = Ложь;
		ПараметрыЗаполнения.НакладнаяПоЗаказам = Ложь;
		ПараметрыЗаполнения.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		ПараметрыЗаполнения.ЭтоЗаказ = Истина;
		ПараметрыЗаполнения.ЕстьДатаПереходаПраваСобственности = Ложь;

		ПараметрыЗаполнения.Вставить("ДатаОтгрузки", СтрокаНачисления.ДатаОтгрузки);
		ПараметрыЗаполнения.Вставить("ДатаЗаказа", ПараметрыЭтапы.Дата);
		ПараметрыЗаполнения.Вставить("ШаблонГрафика", ТаблицаЭтапыГрафикаОплаты);
		ПараметрыЗаполнения.Вставить("Календарь", РеквизитыВерсииСоглашения.Календарь);
		ПараметрыЗаполнения.Вставить("СуммаОплаты", СтрокаНачисления.СуммаСНДС);
		
		ЭтапыОплатыСервер.ЗаполнитьЭтапыОплатыДокументаПоШаблону(ТаблицаОплатБуфер, ПараметрыЗаполнения);   				
		
		Для Каждого ЭтапОплаты Из ТаблицаОплатБуфер Цикл
			
			НоваяСтрока = ТаблицаОплат.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтапОплаты);  						
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНачисления, "ЦФО, Проект"); 
			
			НоваяСтрока.ДатаПоступления = СтрокаНачисления.ДатаПоступления; 
			НоваяСтрока.СтатьяБюджета = СтрокаНачисления.СтатьяБюджетаБДДС;
			НоваяСтрока.Аналитика1 = СтрокаНачисления.АналитикаБДДС1;
			НоваяСтрока.Аналитика2 = СтрокаНачисления.АналитикаБДДС2;
			НоваяСтрока.Аналитика3 = СтрокаНачисления.АналитикаБДДС3;
			НоваяСтрока.Аналитика4 = СтрокаНачисления.АналитикаБДДС4;
			НоваяСтрока.Аналитика5 = СтрокаНачисления.АналитикаБДДС5;
			НоваяСтрока.Аналитика6 = СтрокаНачисления.АналитикаБДДС6;					
			НоваяСтрока.СчетОрганизации = РеквизитыВерсииСоглашения.БанковскийСчет;
			НоваяСтрока.СчетКонтрагента = РеквизитыВерсииСоглашения.БанковскийСчетКонтрагента;
			НоваяСтрока.ДатаОтгрузки = СтрокаНачисления.ДатаОтгрузки;
			
		КонецЦикла;  
		
	КонецЦикла;  
	
	КолонкиГруппировок = "ПроцентПлатежа,СтатьяБюджета,ВариантОплаты, ВариантОтсчета, ДатаПлатежа, ДатаПоступления, ДатаОтгрузки, 
						 |Замещен, Сдвиг,ЦФО, Проект, СчетОрганизации, СчетКонтрагента,  
						 |Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6";
	КолонкиСуммирования = "СуммаПлатежа, СуммаЗадолженности, СуммаОтгрузок";
	
	ТаблицаОплат.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	ТаблицаОплат.Колонки.Добавить("СуммаПлатежей");
	ТаблицаОплат.Сортировать("ДатаПлатежа, ДатаПоступления, СтатьяБюджета");
	
	ЭтапыОплатыСервер.ЗаполнитьПроцентыПоСуммам(ТаблицаОплат);

	Возврат ТаблицаОплат;
	
КонецФункции

Функция ЗаполнитьЭтапыБДДСКлиентом(ПараметрыЭтапы)

	ТаблицаТовары = ПараметрыЭтапы.Товары.Выгрузить();

	Если Не ЗначениеЗаполнено(ТаблицаТовары) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	РеквизитыВерсииСоглашения = ПараметрыЭтапы.РеквизитыВерсииСоглашения;

	ТаблицаОплат = ТаблицаЭтапыГрафикаОплаты();
	ТаблицаОплатБуфер = ТаблицаОплат.Скопировать();  
	
	ТаблицаНачисления = Новый ТаблицаЗначений;      
	ТаблицаНачисления.Колонки.Добавить("Дата");  
	ТаблицаНачисления.Колонки.Добавить("ЦФО");
	ТаблицаНачисления.Колонки.Добавить("Проект");
	ТаблицаНачисления.Колонки.Добавить("СчетОрганизации");
	ТаблицаНачисления.Колонки.Добавить("СчетКонтрагента");
	ТаблицаНачисления.Колонки.Добавить("Сумма");  			
	
	ГрафикРасчетов = РеквизитыВерсииСоглашения.ГрафикРасчетов.Выгрузить();
	
	ПараметрыОтбора = Новый Структура("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	СтрокиНачисления = ГрафикРасчетов.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаНачисления Из СтрокиНачисления Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаНачисления.Добавить(), СтрокаНачисления);	
	КонецЦикла;
	
	ТаблицаНачисления.Свернуть("Дата, ЦФО, Проект, СчетОрганизации, СчетКонтрагента", "Сумма"); 	
	
	Для Каждого СтрокаНачисления Из ТаблицаНачисления Цикл
		
		ТаблицаОплатБуфер.Очистить();
		
		ПараметрыЗаполнения = ЭтапыОплатыСервер.ПараметрыЗаполненияЭтаповОплаты();
		ПараметрыЗаполнения.ЭтоРасчетыСКлиентами = Истина;
		ПараметрыЗаполнения.НакладнаяПоЗаказам = Ложь;
		ПараметрыЗаполнения.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		ПараметрыЗаполнения.ЭтоЗаказ = Истина;
		ПараметрыЗаполнения.ЕстьДатаПереходаПраваСобственности = Ложь;
		
		ПараметрыЗаполнения.Вставить("ДатаОтгрузки", СтрокаНачисления.Дата);
		ПараметрыЗаполнения.Вставить("ДатаЗаказа", СтрокаНачисления.Дата);
		ПараметрыЗаполнения.Вставить("ШаблонГрафика", ПараметрыЭтапы.ТаблицаЭтапыГрафикаОплаты);
		ПараметрыЗаполнения.Вставить("Календарь", ПараметрыЭтапы.РеквизитыВерсииСоглашения.Календарь);
		ПараметрыЗаполнения.Вставить("СуммаОплаты", СтрокаНачисления.Сумма);
		
		ЭтапыОплатыСервер.ЗаполнитьЭтапыОплатыДокументаПоШаблону(ТаблицаОплатБуфер, ПараметрыЗаполнения);   				
		
		Для Каждого ЭтапОплаты Из ТаблицаОплатБуфер Цикл
			
			НоваяСтрока = ТаблицаОплат.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтапОплаты);  						
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНачисления, "ЦФО, Проект, СчетОрганизации, СчетКонтрагента"); 
			
			НоваяСтрока.ДатаПоступления = СтрокаНачисления.Дата; 
			НоваяСтрока.СтатьяБюджета = РеквизитыВерсииСоглашения.СтатьяДвиженияДенежныхСредств;
			НоваяСтрока.Аналитика1 = РеквизитыВерсииСоглашения.АналитикаБДДС1;
			НоваяСтрока.Аналитика2 = РеквизитыВерсииСоглашения.АналитикаБДДС2;
			НоваяСтрока.Аналитика3 = РеквизитыВерсииСоглашения.АналитикаБДДС3;
			НоваяСтрока.Аналитика4 = РеквизитыВерсииСоглашения.АналитикаБДДС4;
			НоваяСтрока.Аналитика5 = РеквизитыВерсииСоглашения.АналитикаБДДС5;
			НоваяСтрока.Аналитика6 = РеквизитыВерсииСоглашения.АналитикаБДДС6;		
			
		КонецЦикла;  
		
	КонецЦикла;  
	
	КолонкиГруппировок = "ПроцентПлатежа,СтатьяБюджета,ВариантОплаты,ВариантОтсчета,ДатаПлатежа,ДатаПоступления, 
						|Замещен,Сдвиг,ЦФО,Проект,СчетОрганизации,СчетКонтрагента, 
						|Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6";
	КолонкиСуммирования = "СуммаПлатежа,СуммаЗадолженности,СуммаОтгрузок";
	
	ТаблицаОплат.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	ТаблицаОплат.Колонки.Добавить("СуммаПлатежей");
	ТаблицаОплат.Сортировать("ДатаПлатежа, ДатаПоступления, СтатьяБюджета"); 	
	
	ЭтапыОплатыСервер.ЗаполнитьПроцентыПоСуммам(ТаблицаОплат);	

	Возврат ТаблицаОплат;
	
КонецФункции
 
Функция ЗаполнитьЭтапыГрафикаОплатыПоставокРасчетовБДР(ПараметрыЭтапы)
	
	Если ПараметрыЭтапы.Свойство("ЭтоРасчетыСКлиентами") Тогда
		ТаблицаОплат = ЗаполнитьЭтапыБДРКлиентом(ПараметрыЭтапы);	
	Иначе
		ТаблицаОплат = ЗаполнитьЭтапыБДРПоставщику(ПараметрыЭтапы);	
	КонецЕсли;
	
	Возврат ТаблицаОплат;	
	
КонецФункции  

