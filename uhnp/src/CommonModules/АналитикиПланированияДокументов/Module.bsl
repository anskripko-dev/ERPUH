	ТаблицаОплат.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	ТаблицаОплат.Колонки.Добавить("СуммаПлатежей");
	ТаблицаОплат.Сортировать("ДатаПлатежа, ДатаПоступления, СтатьяБюджета"); 	
	
	ЭтапыОплатыСервер.ЗаполнитьПроцентыПоСуммам(ТаблицаОплат);
	
	Возврат ТаблицаОплат;   
	
КонецФункции 

Функция ЗаполнитьЭтапыБДРПоставщику(ПараметрыЭтапы)

	ТаблицаТовары = ПараметрыЭтапы.Товары;
	
	Если ЭтоАдресВременногоХранилища(ПараметрыЭтапы.Товары) Тогда
		ТаблицаТовары = ПолучитьИзВременногоХранилища(ПараметрыЭтапы.Товары);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ТаблицаТовары) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаТовары) = Тип("ДанныеФормыКоллекция") Тогда
		ТаблицаТовары = ТаблицаТовары.Выгрузить();	
	КонецЕсли;
	
	КолонкиГруппировок = "ДатаОтгрузки,ДатаПоступления,ЦФО,Проект";
	КолонкиСуммирования = "Сумма,СуммаСНДС";
	
	ТаблицаТовары.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	РеквизитыВерсииСоглашения = ПараметрыЭтапы.РеквизитыВерсииСоглашения;
	
	ТаблицаОплат = ТаблицаЭтапыГрафикаОплаты();
	ТаблицаОплатБуфер = ТаблицаОплат.Скопировать();  			
	
	Для Каждого СтрокаНачисления Из ТаблицаТовары Цикл
		
		ТаблицаОплатБуфер.Очистить();
		
		ПараметрыЗаполнения = ЭтапыОплатыСервер.ПараметрыЗаполненияЭтаповОплаты();
		ПараметрыЗаполнения.ЭтоРасчетыСКлиентами = Ложь;
		ПараметрыЗаполнения.НакладнаяПоЗаказам = Ложь;
		ПараметрыЗаполнения.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		ПараметрыЗаполнения.ЭтоЗаказ = Истина;
		ПараметрыЗаполнения.ЕстьДатаПереходаПраваСобственности = Ложь;
		
		ПараметрыЗаполнения.Вставить("ДатаОтгрузки", СтрокаНачисления.ДатаОтгрузки);
		ПараметрыЗаполнения.Вставить("ДатаЗаказа", ПараметрыЭтапы.Дата);
		ПараметрыЗаполнения.Вставить("ШаблонГрафика", ПараметрыЭтапы.ТаблицаЭтапыГрафикаОплаты);
		ПараметрыЗаполнения.Вставить("Календарь", ПараметрыЭтапы.РеквизитыВерсииСоглашения.Календарь);
		ПараметрыЗаполнения.Вставить("СуммаОплаты", СтрокаНачисления.Сумма);
		
		ЭтапыОплатыСервер.ЗаполнитьЭтапыОплатыДокументаПоШаблону(ТаблицаОплатБуфер, ПараметрыЗаполнения);   				
		
		Для Каждого ЭтапОплаты Из ТаблицаОплатБуфер Цикл
			
			НоваяСтрока = ТаблицаОплат.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтапОплаты);  						
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНачисления, "ЦФО, Проект"); 
			
			НоваяСтрока.ДатаПоступления = СтрокаНачисления.ДатаПоступления; 
			НоваяСтрока.СтатьяБюджета = РеквизитыВерсииСоглашения.СтатьяДвиженияДенежныхСредств;
			НоваяСтрока.Аналитика1 = РеквизитыВерсииСоглашения.АналитикаБДДС1;
			НоваяСтрока.Аналитика2 = РеквизитыВерсииСоглашения.АналитикаБДДС2;
			НоваяСтрока.Аналитика3 = РеквизитыВерсииСоглашения.АналитикаБДДС3;
			НоваяСтрока.Аналитика4 = РеквизитыВерсииСоглашения.АналитикаБДДС4;
			НоваяСтрока.Аналитика5 = РеквизитыВерсииСоглашения.АналитикаБДДС5;
			НоваяСтрока.Аналитика6 = РеквизитыВерсииСоглашения.АналитикаБДДС6;		
			НоваяСтрока.СчетОрганизации = РеквизитыВерсииСоглашения.БанковскийСчет;
			НоваяСтрока.СчетКонтрагента = РеквизитыВерсииСоглашения.БанковскийСчетКонтрагента;
			НоваяСтрока.ДатаОтгрузки = СтрокаНачисления.ДатаОтгрузки;
			
		КонецЦикла;  
		
	КонецЦикла;  
	
	КолонкиГруппировок = "ПроцентПлатежа,СтатьяБюджета,ВариантОплаты,ВариантОтсчета,ДатаПлатежа,ДатаПоступления,ДатаОтгрузки, 
						|Замещен,Сдвиг,ЦФО,Проект,СчетОрганизации,СчетКонтрагента, 
						|Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6";
	КолонкиСуммирования = "СуммаПлатежа,СуммаЗадолженности,СуммаОтгрузок";
	
	ТаблицаОплат.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	ТаблицаОплат.Колонки.Добавить("СуммаПлатежей");
	ТаблицаОплат.Сортировать("ДатаПлатежа, ДатаПоступления, СтатьяБюджета"); 	
	
	ЭтапыОплатыСервер.ЗаполнитьПроцентыПоСуммам(ТаблицаОплат);
	
	Возврат ТаблицаОплат;   	
	
КонецФункции 

Функция ЗаполнитьЭтапыГрафикаОплатыРезервирование(ПараметрыЭтапы)
	
	РеквизитыВерсииСоглашения = ПараметрыЭтапы.РеквизитыВерсииСоглашения;
	
