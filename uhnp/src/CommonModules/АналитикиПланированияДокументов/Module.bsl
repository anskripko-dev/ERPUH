КонецФункции  

Функция ЗаполнитьЭтапыГрафикаОплатыНеИспользовать(ПараметрыЭтапы)
	
	ЭтапыГрафикаОплаты = ПараметрыЭтапы.ТаблицаЭтапыГрафикаОплаты;
	ЗаполнитьДатуСуммуПлатежа(ЭтапыГрафикаОплаты, ПараметрыЭтапы);	
	
	Возврат ЭтапыГрафикаОплаты;   
	
КонецФункции 

Процедура ЗаполнитьДатуСуммуПлатежа(ЭтапыГрафикаОплаты, ПараметрыЭтапы)
	
	РеквизитыВерсииСоглашения = ПараметрыЭтапы.РеквизитыВерсииСоглашения;
	
	ТаблицаДатыОтгрузок = Новый ТаблицаЗначений;	
	ТаблицаДатыОтгрузок.Колонки.Добавить("ДатаОтгрузки");
	ТаблицаДатыОтгрузок.Колонки.Добавить("Сумма");
	
	СуммаРаспределения = ?(ЗначениеЗаполнено(ПараметрыЭтапы.СуммаДокумента), 
			ПараметрыЭтапы.СуммаДокумента, ПараметрыЭтапы.РеквизитыВерсииСоглашения.Сумма);	

	Если ЗначениеЗаполнено(ПараметрыЭтапы.ДатаОтгрузки) Тогда
		
		НоваяСтрока = ТаблицаДатыОтгрузок.Добавить();
		НоваяСтрока.ДатаОтгрузки = ПараметрыЭтапы.ДатаОтгрузки;
		НоваяСтрока.Сумма = СуммаРаспределения;		
		
	Иначе
		
		ТаблицаТовары = ПараметрыЭтапы.Товары;
		
		Если ЭтоАдресВременногоХранилища(ПараметрыЭтапы.Товары) Тогда
			ТаблицаТовары = ПолучитьИзВременногоХранилища(ПараметрыЭтапы.Товары);	
		КонецЕсли; 
		
		Если Не ТаблицаТовары = Неопределено Тогда
			
			Если ТипЗнч(ТаблицаТовары) = Тип("ДанныеФормыКоллекция") Тогда
				ТаблицаТовары = ТаблицаТовары.Выгрузить();
				
				Если ТаблицаТовары.Колонки.Найти("Сумма") = Неопределено Тогда
					ТаблицаТовары.Колонки.СуммаПлатежа.Имя = "Сумма";	
				КонецЕсли;				
			КонецЕсли;
			
			Для Каждого СтрокаТаблицы Из ТаблицаТовары Цикл
				Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаОтгрузки) Тогда
					НоваяСтрока = ТаблицаДатыОтгрузок.Добавить();
					НоваяСтрока.ДатаОтгрузки = СтрокаТаблицы.ДатаОтгрузки;
					НоваяСтрока.Сумма = СтрокаТаблицы.Сумма;		
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;			
		
	КонецЕсли;
	
	Если ТаблицаДатыОтгрузок.Количество() = 0 Тогда		
		НоваяСтрока = ТаблицаДатыОтгрузок.Добавить();
		НоваяСтрока.ДатаОтгрузки = Дата(1, 1, 1);
		НоваяСтрока.Сумма = СуммаРаспределения;			
	КонецЕсли;
	
	ТаблицаДатыОтгрузок.Свернуть("ДатаОтгрузки", "Сумма");

	ИтоговыеЭтапыГрафикаОплаты = ЭтапыГрафикаОплаты.СкопироватьКолонки();
	
	Для Каждого СтрокаДатыОтгрузки Из ТаблицаДатыОтгрузок Цикл
		
		НовыеЭтапыГрафикаОплаты = ЭтапыГрафикаОплаты.СкопироватьКолонки();
		
		Для Каждого СтрокаТаблицы Из ЭтапыГрафикаОплаты Цикл
			
			СтруктураПараметров = ЭтапыОплатыКлиентСервер.ПараметрыРасчетаДатыПлатежа();
			СтруктураПараметров.ВариантОтсчета  = СтрокаТаблицы.ВариантОтсчета;
			СтруктураПараметров.Сдвиг    		= СтрокаТаблицы.Сдвиг;
			СтруктураПараметров.ДатаЗаказа 		= ПараметрыЭтапы.Дата;
			СтруктураПараметров.ДатаОтгрузки	= СтрокаДатыОтгрузки.ДатаОтгрузки;
			СтруктураПараметров.Календарь		= ПараметрыЭтапы.РеквизитыВерсииСоглашения.Календарь;
			
			Если ЗначениеЗаполнено(ПараметрыЭтапы.РеквизитыВерсииСоглашения.Календарь) Тогда
				СтрокаТаблицы.ДатаПлатежа = ЭтапыОплатыВызовСервера.ДатаПлатежаПоКалендарю(СтруктураПараметров);
			Иначе
				СтрокаТаблицы.ДатаПлатежа = ЭтапыОплатыКлиентСервер.ДатаПлатежаБезКалендаря(СтруктураПараметров);
			КонецЕсли;
			
			СтрокаТаблицы.ЦФО = РеквизитыВерсииСоглашения.ОсновнойЦФО;
			СтрокаТаблицы.Проект = РеквизитыВерсииСоглашения.ОсновнойПроект;   
			СтрокаТаблицы.СтатьяБюджета = РеквизитыВерсииСоглашения.СтатьяДвиженияДенежныхСредств;   
			СтрокаТаблицы.Аналитика1 = РеквизитыВерсииСоглашения.АналитикаБДДС1;
			СтрокаТаблицы.Аналитика2 = РеквизитыВерсииСоглашения.АналитикаБДДС2;
			СтрокаТаблицы.Аналитика3 = РеквизитыВерсииСоглашения.АналитикаБДДС3;
			СтрокаТаблицы.Аналитика4 = РеквизитыВерсииСоглашения.АналитикаБДДС4;
			СтрокаТаблицы.Аналитика5 = РеквизитыВерсииСоглашения.АналитикаБДДС5;
			СтрокаТаблицы.Аналитика6 = РеквизитыВерсииСоглашения.АналитикаБДДС6; 
			СтрокаТаблицы.СчетОрганизации = РеквизитыВерсииСоглашения.БанковскийСчет; 
			СтрокаТаблицы.СчетКонтрагента = РеквизитыВерсииСоглашения.БанковскийСчетКонтрагента; 
			СтрокаТаблицы.ДатаОтгрузки = СтрокаДатыОтгрузки.ДатаОтгрузки;
			
			НоваяСтрока = НовыеЭтапыГрафикаОплаты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла;  
		
		ЭтапыОплатыКлиентСервер.РаспределитьСуммуПоЭтапамГрафикаОплаты(НовыеЭтапыГрафикаОплаты, СтрокаДатыОтгрузки.Сумма, 0);		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(НовыеЭтапыГрафикаОплаты, ИтоговыеЭтапыГрафикаОплаты);
		
	КонецЦикла;
	
	ЭтапыОплатыСервер.ЗаполнитьПроцентыПоСуммам(ИтоговыеЭтапыГрафикаОплаты);	
	ЭтапыГрафикаОплаты = ИтоговыеЭтапыГрафикаОплаты;
	
КонецПроцедуры

Процедура ДобавитьКолонкиВТаблицуЭтапыГрафикаОплаты(ТаблицаЭтапыГрафикаОплаты)
	
	ИменаКолонок = "ЦФО,Проект,СтатьяБюджета,СчетОрганизации,СчетКонтрагента,ДатаОтгрузки, 
					|Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6"; 
	Колонки = СтрРазделить(ИменаКолонок, ",");
	
	Для Каждого ИмяКолонки Из Колонки Цикл		
		Если ТаблицаЭтапыГрафикаОплаты.Колонки.Найти(СокрЛП(ИмяКолонки)) = Неопределено Тогда
			ТаблицаЭтапыГрафикаОплаты.Колонки.Добавить(СокрЛП(ИмяКолонки));	
		КонецЕсли;		
	КонецЦикла;
	
	РеквизитыТабличнойЧасти = Метаданные.Документы.ЗаказПоставщику.ТабличныеЧасти.ЭтапыГрафикаОплаты.Реквизиты; 
	
	Для Каждого Реквизит Из РеквизитыТабличнойЧасти Цикл
		Если ТаблицаЭтапыГрафикаОплаты.Колонки.Найти(Реквизит.Имя) = Неопределено Тогда
			ТаблицаЭтапыГрафикаОплаты.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);	
		КонецЕсли;
	КонецЦикла;   

КонецПроцедуры

Функция ТаблицаЭтапыГрафикаОплаты()
	
	ИменаКолонок = "ВариантОплаты,ДатаПлатежа,ПроцентПлатежа,СуммаПлатежа,СуммаЗадолженности,СуммаОтгрузок,СуммаПлатежей,Комментарий,
					|ДатаПоступления,Замещен,Сдвиг,ВариантОтсчета,СтатьяБюджета,ЦФО,Проект,СчетОрганизации,СчетКонтрагента,ДатаОтгрузки,
					|Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6"; 
	Колонки = СтрРазделить(ИменаКолонок, ",");
	
	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из Колонки Цикл  	
		Таблица.Колонки.Добавить(СокрЛП(ИмяКолонки));	 	
	КонецЦикла;                
	
	Возврат Таблица;  
	
КонецФункции

