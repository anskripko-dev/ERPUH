
#Область ПрограммныйИнтерфейс 

Процедура ОткрытьДвиженияДокумента(ДокументСсылка, ВладелецФормы) Экспорт
	
	ПараметрыФормы = Новый Структура("ПараметрКоманды,СформироватьПриОткрытии", ДокументСсылка, Истина);
	ОткрытьФорму("Отчет.ДвиженияДокумента.Форма", ПараметрыФормы, ВладелецФормы, Истина);
	
КонецПроцедуры

//// Процедура заглушка для ЕРПУХ
Процедура НачалоВыбора_Организации(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтаФорма) Экспорт
	ОрганизацииКлиентЛокализация.НачалоВыбора_Организации(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтаФорма);
КонецПроцедуры

#Область СтандартныеПодсистемы

Процедура Подключаемый_ОткрытьФорму(СсылкаНаОбъект, ПараметрыВыполнения) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;		
	КонецЕсли;
	
	ЕстьФИ = ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом();
	
	Если ПараметрыВыполнения.ОписаниеКоманды.Идентификатор = "КарточкаФинансовогоИнструмента" Тогда	
		
		ПараметрыФормы = ВстраиваниеУХКлиентСервер.ПолучитьПараметрыКарточкаСубконто(СсылкаНаОбъект);
		ИмяФормыРСБУ = "Отчет.КарточкаСубконто.Форма";
		ОткрытьФорму(ИмяФормыРСБУ, 
						ПараметрыФормы, 
						ПараметрыВыполнения.Форма, 
						Истина						
					);
					
	ИначеЕсли ПараметрыВыполнения.ОписаниеКоманды.Идентификатор = "ВзаиморасчетыПоДоговору" Тогда 
		
		ИмяДоговор = "ДоговорКонтрагента";
		ИмяТипа = "ДокументСсылка.АкцептПротестПереводногоВекселя";//вынесено для проверки БМ, НМ 
		Если ТипЗнч(СсылкаНаОбъект) = Тип(ИмяТипа) Тогда
			ИмяДоговор = "ДоговорАкцепта";
		КонецЕсли;
		
		ПараметрыФормы = ВстраиваниеУХКлиентСервер.ПолучитьПараметрыКарточкаСубконто(СсылкаНаОбъект, ИмяДоговор);
		ИмяФормыРСБУ = "Отчет.КарточкаСубконто.Форма";
		ОткрытьФорму(ИмяФормыРСБУ, 
						ПараметрыФормы, 
						ПараметрыВыполнения.Форма,
						Истина
					);
		
	ИначеЕсли ЕстьФИ И ПараметрыВыполнения.ОписаниеКоманды.Идентификатор = "ДокументыПоЦеннойБумаге" Тогда 
					
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ФинансовыйИнструмент", СсылкаНаОбъект));
		ИмяФормы = "ЖурналДокументов.ОперацииСЦеннымиБумагами.ФормаСписка";//вынесено для БМ, НМ
		ОткрытьФорму(ИмяФормы, ПараметрыФормы, ПараметрыВыполнения.Форма, Истина);

	ИначеЕсли СтрНачинаетсяС(ПараметрыВыполнения.ОписаниеКоманды.Идентификатор, "ОСВМСФО.ПоСчету") Тогда 
			
		ПараметрыКоманды = СтрЗаменить(ПараметрыВыполнения.ОписаниеКоманды.Идентификатор, "ОСВМСФО.ПоСчету", "");
		ПараметрыФормы = ПараметрыФормыОСВМСФОПоСчету(СсылкаНаОбъект, ПараметрыКоманды);
		
		ОткрытьФорму("Отчет.ОСВМСФО.Форма", 
				ПараметрыФормы, 
				ПараметрыВыполнения.Форма, 
				Истина
			);	
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыФормыОСВМСФОПоСчету(Контекст, ПараметрыКомандыСтрокой = "Ссылка")

	ПараметрыКоманды = СтрРазделить(ПараметрыКомандыСтрокой, "/", Ложь);
	
	ТекущаяДатаГода = ТекущаяДата();
	ДатаНачала = НачалоГода(ТекущаяДатаГода);
	ДатаОкончания = КонецГода(ТекущаяДатаГода);
	
	ПериодОтчета = Новый СтандартныйПериод(ДатаНачала, ДатаОкончания);
	
	Результат = Новый Структура;	
	
	Результат.Вставить("Период", 		ПериодОтчета);
	Результат.Вставить("Счет", 			Контекст[ПараметрыКоманды[0]]);
	
	Возврат Новый Структура("Отбор,СформироватьПриОткрытии,КлючВарианта", 
								Результат, 
								Истина,
								"ОСВпоСчету"
							);

КонецФункции

#КонецОбласти