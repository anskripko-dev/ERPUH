
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДополнительныеСвойства, "ПроверитьБалансОперации", Ложь) Тогда
	
		Регистратор = ЭтотОбъект.Отбор.Регистратор.Значение;
		УПМСФО = МСФОВызовСервераУХ.ЗначениеУП("Ссылка",
			ЭтотОбъект[0].Организация, ЭтотОбъект[0].Период, ЭтотОбъект[0].Сценарий);
			
		ПоляИтога = "СуммаВВалютеУчета, СуммаВВалютеОтчетности";
		
		РегистрыБухгалтерии.МСФО.ПроверитьБалансОперации(
			ЭтотОбъект, Регистратор, УПМСФО, ПоляИтога, Отказ);
	
	КонецЕсли;
	
КонецПроцедуры

