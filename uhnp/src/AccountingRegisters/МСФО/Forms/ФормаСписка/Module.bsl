
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("НадписьКоличество", НСтр("ru='Кол:'"));
	
	ОтборыСчет = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Список.КомпоновщикНастроек.Настройки.Отбор, "Счет");
	Если ОтборыСчет.Количество() Тогда
		ОтборыСчет[0].ПредставлениеПользовательскойНастройки = НСтр("ru = 'Счет'");
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	БезКорр.Параметры.УстановитьЗначениеПараметра("Счета00", Счета00());
	
	БезКорреспонденции = МСФОВызовСервераУХ.ЗначениеУП("БезКорреспонденции");
	Если БезКорреспонденции = Истина Тогда
		Элементы.ФормаПереключитьВидПроводок.Пометка = Не Элементы.ФормаПереключитьВидПроводок.Пометка;
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьАктивностьПроводок(Команда)
	
	ТекДокумент = ПолучитьДокумент();
	
	Если ТекДокумент <> Неопределено Тогда
		
		ПереключитьАктивностьПроводокСервер(ТекДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьВидПроводок(Команда)
	
	Элементы.ФормаПереключитьВидПроводок.Пометка = Не Элементы.ФормаПереключитьВидПроводок.Пометка;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьДокумент()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Не выбран документ'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ТекДокумент = ТекДанные.Регистратор;
	Если НЕ ЗначениеЗаполнено(ТекДокумент) Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Не выбран документ'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТекДокумент;
	
КонецФункции

&НаСервере
Процедура ПереключитьАктивностьПроводокСервер(Документ)
	
	МСФОУХ.ПереключитьАктивностьПроводокМСФО(Документ);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	МСФОУХ.УсловноеОформление_Проводки(ЭтаФорма, "Список", "Список");
	МСФОУХ.УсловноеОформление_Проводки(ЭтаФорма, "БезКорр", "БезКорр", , "");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы	= Форма.Элементы;
	
	ВидПроводок = Элементы.ФормаПереключитьВидПроводок.Пометка;
	
	Элементы.БезКорр.Видимость = ВидПроводок;
	Элементы.Список.Видимость = Не ВидПроводок;
	
	Элементы.СписокКомпоновщикНастроекПользовательскиеНастройки.Видимость = Не ВидПроводок;
	Элементы.БезКоррКомпоновщикНастроекПользовательскиеНастройки.Видимость = ВидПроводок;

КонецПроцедуры

&НаСервере
Функция Счета00()
	
	//Получим все счета для разных планов счетов и пустой счет(для забаланса)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК ФиксСчет,
	|	т.Счет.СчетСсылка КАК СчетМСФО
	|ПОМЕСТИТЬ втФиксированныеСчета
	|ИЗ
	|	Справочник.ФиксированныеСчетаУчетаБД КАК т
	|ГДЕ
	|	т.Ссылка В (ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ВспомогательныйБалансовый), ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ВспомогательныйЗабалансовый), ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ВспомогательныйНачальныеОстаткиВНА))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.СчетМСФО КАК Счет
	|ИЗ
	|	втФиксированныеСчета КАК т
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	т.Счет.СчетСсылка
	|ИЗ
	|	РегистрСведений.ФиксированныеСчетаБД КАК т
	|ГДЕ
	|	т.ВидСчета В
	|			(ВЫБРАТЬ
	|				с.ФиксСчет
	|			ИЗ
	|				втФиксированныеСчета КАК с)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланСчетов.МСФО.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланСчетов.МСФО.ВспомогательныйЗабалансовый)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланСчетов.МСФО.Вспомогательный)");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Счет");

КонецФункции

#КонецОбласти
