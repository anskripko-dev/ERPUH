// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

Процедура ПроверитьБалансОперации(ПроводкиОперации, КлючДанных, УПМСФО, 
		ПоляИтога = "СуммаВВалютеУчета, СуммаВВалютеОтчетности", Отказ = Ложь) Экспорт
	
	Если ПроводкиОперации.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоТЗ = ТипЗнч(ПроводкиОперации) = Тип("ТаблицаЗначений");
	
	ФиксСчет = ПредопределенноеЗначение(
		"Справочник.ФиксированныеСчетаУчетаБД.ВспомогательныйБалансовый");
	
	АналитикаСчета = Справочники.ФиксированныеСчетаУчетаБД
		.АналитикаФиксированногоСчета(ФиксСчет, УПМСФО);
		
	Счет00 = АналитикаСчета.СчетСсылка;
	Если ТипЗнч(ПроводкиОперации[0].СчетДт) = Тип("СправочникСсылка.СчетаБД") Тогда
		Счет00 = АналитикаСчета.СчетИБ;
	КонецЕсли;
	
	ОтборДт = Новый Структура("СчетДт", Счет00);
	ОтборКт = Новый Структура("СчетКт", Счет00);
	
	Таб = ПроводкиОперации;
	Если Не ЭтоТЗ Тогда
		Таб = ПроводкиОперации.Выгрузить(, ПоляИтога + ", СчетДт, СчетКт");
	КонецЕсли;
	
	ТабДт = Таб.Скопировать(ОтборДт, ПоляИтога);
	ТабКт = Таб.Скопировать(ОтборКт, ПоляИтога);
	
	Если ТабДт.Количество() = 0 И ТабКт.Количество() = 0 Тогда
		Возврат
	КонецЕсли;
	
	ИменаПолей = Новый Структура(ПоляИтога);
	Для каждого ИмяПоля Из ИменаПолей Цикл
		
		ИтогПоля = ТабДт.Итог(ИмяПоля.Ключ) - ТабКт.Итог(ИмяПоля.Ключ);
		Если ЗначениеЗаполнено(ИтогПоля) Тогда
			
			ЗаголовокПоля = Метаданные.РегистрыБухгалтерии.МСФО.Ресурсы.Найти(ИмяПоля.Ключ);
			ЗаголовокПоля = ?(ЗаголовокПоля = Неопределено, ИмяПоля.Ключ, ЗаголовокПоля);
			
			Сообщение = НСтр("ru = 'Не соблюдается баланс вспомогательного счета <%1> (%2): Дебет(%3) = Кредит(%4)'");
			Сообщение = СтрШаблон(Сообщение, Счет00, ЗаголовокПоля, 
				Формат(ТабДт.Итог(ИмяПоля.Ключ), "ЧН="), 
				Формат(ТабКт.Итог(ИмяПоля.Ключ), "ЧН="));
				
			ОбщегоНазначения.СообщитьПользователю(Сообщение, КлючДанных, , , Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
