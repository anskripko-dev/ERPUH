
#Область ОписаниеПеременных

&НаКлиенте
Перем ВыборВидаБюджета Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВидБюджета = "БДДС";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СоздатьДокументНаОсновании();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВыборВидаБюджета = Истина;
	Закрыть(); 
	
КонецПроцедуры   

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СоздатьДокументНаОсновании()
	
	Если Не ВыборВидаБюджета = Истина Тогда
		Возврат;
	КонецЕсли;

	СоответствиеВидыБюджетов = Новый Соответствие;
	СоответствиеВидыБюджетов.Вставить("БДДС", ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств"));	
	СоответствиеВидыБюджетов.Вставить("БДР", ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов"));
	
	СоответствиеВидыДокументов = Новый Соответствие;
	СоответствиеВидыДокументов.Вставить("Заявка на корректировку планов и лимитов", "ЗаявкаНаКорректировкуПланов");	
	СоответствиеВидыДокументов.Вставить("Корректировка планов и лимитов", "КорректировкаПланов");

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Основание", Параметры.Основание);
    ДанныеЗаполнения.Вставить("ВидБюджета", СоответствиеВидыБюджетов.Получить(ВидБюджета));
                                                  
	ПараметрыФормы = Новый Структура();  
	ПараметрыФормы.Вставить("Основание", Параметры.Основание);
	ПараметрыФормы.Вставить("ДанныеЗаполнения", ДанныеЗаполнения);

	ИсточникФормы = СтрШаблон("Документ.%1.ФормаОбъекта", 
				СоответствиеВидыДокументов.Получить(Параметры.ПредставлениеДокумента));
	ОткрытьФорму(ИсточникФормы, ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти