
&НаКлиенте
Процедура ИмпортироватьДанные(Команда)
	
	ТекущаяСсылка = Элементы.Список.ТекущаяСтрока;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияФормы = Новый Структура("ТипОбъектаКонсолидации, ИмяОбъектаМетаданных, ИмпортДанных",
		"ВидСубконто", ТекущаяСсылка, Истина);
	
	Имя = "Обработка.ОбменНСИ.Форма.Форма";
	ОткрытьФорму(Имя, ПараметрыОткрытияФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура НедостающиеТипыТрансляции(Команда)
	НедостающиеТипыТрансляцииНаСервере();
КонецПроцедуры

&НаСервере
Процедура НедостающиеТипыТрансляцииНаСервере()
	
	Если Метаданные.ПланыВидовХарактеристик.Найти("ВидыСубконтоХозрасчетные") = Неопределено Тогда
		Возврат;	
	КонецЕсли; 
	
	ТипыРСБУ = Метаданные.ПланыВидовХарактеристик["ВидыСубконтоХозрасчетные"].Тип.Типы();
	ТипыМСФО = Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип.Типы();
	
	Недостающие = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ТипыРСБУ, ТипыМСФО);
	ТекстШаблона = НСтр("ru = 'Не найден тип <%1> в видах субконто МСФО для трансляции из РСБУ'");
		
	Для каждого Эл Из Недостающие Цикл
		Сообщить(СтрШаблон(ТекстШаблона, эл));	
	КонецЦикла;
	
КонецПроцедуры
