&НаСервере
Процедура ЗаполнитьПоДокументуПланированияНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Модифицированность = Истина;

	Документы.КорректировкаПланов.ЗаполнитьПоДокументуПланирования(Объект, Объект.ДокументОснование, Объект);
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Объект.ВысвобождатьРезервы = Ложь;	
	КонецЕсли;
	
	ОбновитьПредставлениеПериодов();   
	УправлениеФормой(); 
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборПлановПоИдентификаторуСтроки(ИдентификаторСтроки, ТаблицаПланов)
	
	ИменаРеквизитов = "ОбъектКонтроля, СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, 
					  |ПриходРасход, Организация, ЦФО, Проект, НачалоПериода, Периодичность, Валюта, Сумма, ДокументРезерва";    
	
	ОбеспечитьЗаСчетУдалитьСтрокиПоИдентификаторуСтроки(ИдентификаторСтроки);
	
	ВидОперацииПеренос = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;
	Для Каждого СтрокаПлана Из ТаблицаПланов Цикл 
		ТекущаяСтрока = Объект.ОбеспечитьЗаСчет.Добавить();
		ТекущаяСтрока.ВидОперации = ВидОперацииПеренос;
		
		ТекущаяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаПлана, ИменаРеквизитов);  
		ОбновитьПредставлениеПериодаСтроки(ТекущаяСтрока, Объект.ВидБюджета);
	КонецЦикла;
	
	ВыполнитьРасчетСуммОбеспеченияСтрокиТребуется(ИдентификаторСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ОбеспечитьЗаСчетУдалитьСтрокиПоИдентификаторуСтроки(ИдентификаторСтроки)
	
	СтруктураПоиска = Новый Структура("ИдентификаторСтроки, ВидОперации", 
									  ИдентификаторСтроки, Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос);

	СтрокиСИдентификатором = Объект.ОбеспечитьЗаСчет.НайтиСтроки(СтруктураПоиска);
	                    
	Для Каждого Строка Из СтрокиСИдентификатором Цикл
		Объект.ОбеспечитьЗаСчет.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРасчетСуммОбеспеченияСтрокиТребуется(ИдентификаторСтроки)
	
	Если Не Объект.ОбеспечиватьПострочно Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
	
	Обеспечено = Объект.ОбеспечитьЗаСчет.Выгрузить(СтруктураПоиска, "ИдентификаторСтроки, ВидОперации, Сумма");
	Обеспечено.Свернуть("ИдентификаторСтроки, ВидОперации", "Сумма");

	Для Каждого Строка Из Объект.Требуется.НайтиСтроки(СтруктураПоиска) Цикл
		
		СтруктураПоиска.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
	
		СтрокиОбеспечено = Обеспечено.НайтиСтроки(СтруктураПоиска);
		
		Строка.Перенесено = 0;
		Строка.Увеличить  = 0;      
		
		Для Каждого СтрокаОбеспечено Из СтрокиОбеспечено Цикл
			
			Если ВидыОперацииОбеспечить.НайтиПоЗначению(СтрокаОбеспечено.ВидОперации) = Неопределено Тогда
				Строка.Перенесено = СтрокаОбеспечено.Сумма;	
			Иначе
				Строка.Увеличить = СтрокаОбеспечено.Сумма;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры      

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеПериодаСтроки(Строка, ВидБюджета)
	
	Строка.Периодичность = ПолучитьПериодичностьПланирования(ВидБюджета, Строка.НачалоПериода);  
	
	Строка.ПредставлениеПериода = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
		Строка.НачалоПериода, Строка.Периодичность);    
		
КонецПроцедуры
	
&НаСервереБезКонтекста
Функция ПолучитьПериодичностьПланирования(ВидБюджета, НачалоПериода)
	
	ПараметрыПланирования = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджета, НачалоПериода);
	
	Возврат ПараметрыПланирования.ПериодичностьЛимитирования;   
	
КонецФункции

&НаСервере
Процедура ОбновитьПредставлениеПериодов()
	
	ОбновитьПредставлениеПериодаСтроки(ЭтотОбъект, Объект.ВидБюджета);   
	
	Для Каждого Строка Из Объект.Требуется Цикл
		ОбновитьПредставлениеПериодаСтроки(Строка, Объект.ВидБюджета);
	КонецЦикла;

	Для Каждого Строка Из Объект.ОбеспечитьЗаСчет Цикл
		ОбновитьПредставлениеПериодаСтроки(Строка, Объект.ВидБюджета);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьВидКорректировки()
	
	Если Объект.ОбеспечиватьПострочно Тогда
		ПреобразоватьКОбеспечиватьПострочно();
	Иначе
		ПреобразоватьКОбеспечиватьВместе();
	КонецЕсли;
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура ПреобразоватьКОбеспечиватьПострочно()
	                      
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	СтрокиОбеспечить = Объект.ОбеспечитьЗаСчет.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаОбеспечения Из СтрокиОбеспечить Цикл
		Объект.ОбеспечитьЗаСчет.Удалить(СтрокаОбеспечения);
	КонецЦикла;    
	
	ВидОперацииУвеличение = Перечисления.ВидыОперацийКорректировкаЛимитов.Увеличение;
	// Добавить строки Добавить
	Для Каждого СтрокаТребуется Из Объект.Требуется Цикл
		
		Если СтрокаТребуется.Увеличить = 0  Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОбеспечить = Объект.ОбеспечитьЗаСчет.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОбеспечить, СтрокаТребуется);
		
		СтрокаОбеспечить.ВидОперации = ВидОперацииУвеличение;
		СтрокаОбеспечить.Сумма = СтрокаТребуется.Увеличить; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПреобразоватьКОбеспечиватьВместе()
	
	Сч = 0;
	Пока Сч < Объект.ОбеспечитьЗаСчет.Количество() Цикл
		
		ТекущаяСтрока = Объект.ОбеспечитьЗаСчет[Сч];
		
		Если ВидыОперацииОбеспечить.НайтиПоЗначению(ТекущаяСтрока.ВидОперации) = Неопределено Тогда
			Сч = Сч + 1;	
		Иначе
			Объект.ОбеспечитьЗаСчет.Удалить(Сч);	
		КонецЕсли; 
		
	КонецЦикла;  
	
	Для Каждого СтрокаТабличнойЧасти Из Объект.Требуется Цикл
		СтрокаТабличнойЧасти.Перенесено = 0;
		СтрокаТабличнойЧасти.Увеличить = 0;
	КонецЦикла;     
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	#Область ПериодыПланирования
		
    // Требуется 
	ЭлементУО = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ТребуетсяНачалоПериода.Имя);

	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Требуется.НачалоПериода");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", 
		Новый ПолеКомпоновкиДанных("Объект.Требуется.ПредставлениеПериода"));

    // ОбеспечитьЗаСчет
	ЭлементУО = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОбеспечитьЗаСчетПострочноНачалоПериода.Имя);
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОбеспечитьЗаСчетНачалоПериода.Имя);
	
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбеспечитьЗаСчет.НачалоПериода");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", 
		Новый ПолеКомпоновкиДанных("Объект.ОбеспечитьЗаСчет.ПредставлениеПериода"));
	
	#КонецОбласти
	
	#Область ПодменаДляОперацииУвеличение

	ИмяТаблицыФормы = "ОбеспечитьЗаСчетПострочно";

	// Аналитики статей бюджета
	ПоляУвеличения = Новый Структура(АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1"));
	Для НомерАналитики = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		
		ИмяЭлемента = СтрШаблон("Аналитика%1", НомерАналитики);
		ИмяРеквизита = СтрШаблон("Аналитика%1", НомерАналитики);
		ИмяРеквизитаВидАналитики = СтрШаблон("ВидАналитики%1", НомерАналитики);
		
		// Аналитика заполнена
		ЭлементУО = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();
		ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТаблицыФормы + ИмяЭлемента);
		УстановитьОтборИОформлениеДляПолейУвеличения(ЭлементУО);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", 
						Новый ПолеКомпоновкиДанных("Объект.Требуется." + ИмяРеквизита));
		
		// Аналитика не используется
		ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеИспользуется(
			ЭтотОбъект.УсловноеОформление.Элементы,
			ИмяТаблицыФормы + ИмяЭлемента,
			"Объект.Требуется." + ИмяРеквизитаВидАналитики
		);
		УстановитьОтборИОформлениеДляПолейУвеличения(ЭлементУО);
		
		// Аналитика не заполнена
		ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеЗаполнена(
			ЭтотОбъект.УсловноеОформление.Элементы,
			ИмяТаблицыФормы + ИмяЭлемента,
			"Объект.Требуется." + ИмяРеквизита,
			"Объект.Требуется." + ИмяРеквизитаВидАналитики
		);
		УстановитьОтборИОформлениеДляПолейУвеличения(ЭлементУО);
		
	КонецЦикла;  
	#КонецОбласти
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборИОформлениеДляПолейУвеличения(ЭлементУО)
	
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбеспечитьЗаСчет.ВидОперации");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.ПравоеЗначение = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",			Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",				ЦветаСтиля.ГиперссылкаЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);     

КонецПроцедуры

&НаКлиенте
Функция ОбеспечитьЗаСчет_ЗапрещеноОкончаниеРедактирования(ТекущиеДанные, НоваяСтрока, ОтменаРедактирования)
	
	Результат = Ложь;
	
	Если ОтменаРедактирования Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не Объект.ОбеспечиватьПострочно Тогда
		Возврат Результат;
	КонецЕсли;
	
	Перенос = ПредопределенноеЗначение("Перечисление.ВидыОперацийКорректировкаЛимитов.Перенос");
	Если ТекущиеДанные.ВидОперации = Перенос Тогда
		Возврат Результат;
	КонецЕсли;

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	СтрокиОбеспечитьЗаСчет = Объект.ОбеспечитьЗаСчет.НайтиСтроки(СтруктураПоиска);
	
	КоличествоСтрок = 0;
	Для Каждого СтрокаОбеспечитьЗаСчет Из СтрокиОбеспечитьЗаСчет Цикл		         
		Если Не ВидыОперацииОбеспечить.НайтиПоЗначению(СтрокаОбеспечитьЗаСчет.ВидОперации) = Неопределено Тогда
			КоличествоСтрок = КоличествоСтрок + 1;	
		КонецЕсли;
	КонецЦикла; 
	
	Если КоличествоСтрок > 1 Тогда
		ТекстСообщения = НСтр("ru = 'Несколько строк увеличения/уменьшения недопустимо'");   
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);   
		Результат = Истина;
	КонецЕсли;   
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьСтатьиБюджетовИАналитики()
	
	// Данные для создания полей Аналитика* для элементов Статьи бюджетов
	АСБ = АналитикиСтатейБюджетовУХ;
	
	МассивОписанийСтатей = Новый Массив;
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТабличнойЧастиВТаблицеФормы(МассивОписанийСтатей, 
		"Требуется",  "Требуется",
		"СтатьяБюджета", "ТребуетсяСтатьяБюджета",
		"Аналитика%1", "ТребуетсяАналитика%1",
		ФормыУХ.РазместитьВГруппе("ТребуетсяГруппаАналитикаСтатьяБюджета"));
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТабличнойЧастиВТаблицеФормы(МассивОписанийСтатей, 
		"ОбеспечитьЗаСчет",  "ОбеспечитьЗаСчет",
		"СтатьяБюджета", "ОбеспечитьЗаСчетСтатьяБюджета",
		"Аналитика%1", "ОбеспечитьЗаСчетАналитика%1",
		ФормыУХ.РазместитьВГруппе("ОбеспечитьЗаСчетГруппаСтатьяБюджета"));

	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТабличнойЧастиВТаблицеФормы(МассивОписанийСтатей, 
		"ОбеспечитьЗаСчет",  "ОбеспечитьЗаСчетПострочно",
		"СтатьяБюджета", "ОбеспечитьЗаСчетПострочноСтатьяБюджета",
		"Аналитика%1", "ОбеспечитьЗаСчетПострочноАналитика%1",
		ФормыУХ.РазместитьВГруппе("ОбеспечитьЗаСчетПострочноГруппаСтатьяИАналитики"));
	
	// Создать элементы формы для статей бюджетов и их аналитик
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтотОбъект, МассивОписанийСтатей);    

КонецПроцедуры

&НаКлиенте
Процедура ПереносСвободныхЛимитовЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Если Не ЭтоАдресВременногоХранилища(Результат.АдресВХранилище) Тогда
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьСвободныеЛимиты(Результат, ДопПараметры);
	ПриОжиданииВыполнитьКонтрольДокумента();
	
КонецПроцедуры   

&НаСервере   
Процедура ЗаполнитьСвободныеЛимиты(Результат, ДопПараметры)

	ТаблицаСвободныеЛимиты = ПолучитьИзВременногоХранилища(Результат.АдресВХранилище); 
	
	ВидОперацииПеренос = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;

	Для Каждого СтрокаТаблицы Из ТаблицаСвободныеЛимиты Цикл
		
		ИдентификаторСтроки = Новый УникальныйИдентификатор;	
		
		НоваяСтрока = Объект.Требуется.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);   
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		НоваяСтрока.Требуется = СтрокаТаблицы.Свободно;
		НоваяСтрока.Сумма = СтрокаТаблицы.Свободно;
		
		Если ДопПараметры.Свойство("РежимЗаполнения") И ДопПараметры.РежимЗаполнения = 1 Тогда
			НоваяСтрока.НачалоПериода = Результат.ДатаПереноса;
		КонецЕсли;

		ОбновитьПредставлениеПериодаСтроки(НоваяСтрока, Объект.ВидБюджета);

		Если ДопПараметры.Свойство("РежимЗаполнения") И ДопПараметры.РежимЗаполнения = 1 Тогда 
			НоваяСтрока = Объект.ОбеспечитьЗаСчет.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.ВидОперации = ВидОперацииПеренос;
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.Сумма = СтрокаТаблицы.Свободно;
			
			ОбновитьПредставлениеПериодаСтроки(НоваяСтрока, Объект.ВидБюджета);  
		КонецЕсли;	

	КонецЦикла; 
	
	Модифицированность = Истина;   
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеТипаДокументаОснования()	 	
	
	Элементы.ДокументОснование.ОграничениеТипа	= КонтрольЛимитовУХ.ТипыДокументаОснованияКорректировкиЛимитов();  
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСвободныйОстаток(СтрокаТабличнойЧасти)   
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НачалоПериода", СтрокаТабличнойЧасти.НачалоПериода);
	СтруктураПараметров.Вставить("Периодичность", СтрокаТабличнойЧасти.Периодичность);
	СтруктураПараметров.Вставить("ЦФО", СтрокаТабличнойЧасти.ЦФО);
	СтруктураПараметров.Вставить("Проект", СтрокаТабличнойЧасти.Проект);
	СтруктураПараметров.Вставить("СтатьяБюджета", СтрокаТабличнойЧасти.СтатьяБюджета);
	СтруктураПараметров.Вставить("Аналитика1", СтрокаТабличнойЧасти.Аналитика1);  
	СтруктураПараметров.Вставить("Аналитика2", СтрокаТабличнойЧасти.Аналитика2);
	СтруктураПараметров.Вставить("Аналитика3", СтрокаТабличнойЧасти.Аналитика3);
	СтруктураПараметров.Вставить("Аналитика4", СтрокаТабличнойЧасти.Аналитика4);
	СтруктураПараметров.Вставить("Аналитика5", СтрокаТабличнойЧасти.Аналитика5);
	СтруктураПараметров.Вставить("Аналитика6", СтрокаТабличнойЧасти.Аналитика6);
	СтруктураПараметров.Вставить("Валюта", СтрокаТабличнойЧасти.Валюта);
	СтруктураПараметров.Вставить("ВидБюджета", ВидБюджета);
	
	СтрокаТабличнойЧасти.Свободно = КонтрольЛимитовФормыВызовСервера.ЗаполнитьОстаткиСвободногоЛимитаПоСтрокеКорректировкаЛимитов(СтруктураПараметров);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОчиститьТабличныеЧастиПродолжение(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда  	
		Объект.Требуется.Очистить();  
		Объект.ОбеспечитьЗаСчет.Очистить();  
		
		ОткрытьФормуВысвобождениеРезервов();
	КонецЕсли;        
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВысвобождениеРезервов() 
	
	Модифицированность = Истина;
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ВысвободитьРезервыЗавершение", ЭтаФорма);
	
	ПараметрыФормы = Новый Структура;   		
	ПараметрыФормы.Вставить("ВидБюджета", Объект.ВидБюджета);
	ПараметрыФормы.Вставить("Документ", Объект.Ссылка); 
	ПараметрыФормы.Вставить("ДатаДокумента",Объект.Дата);  
	ПараметрыФормы.Вставить("ДокументРезерва", Объект.ДокументОснование);
		
	ОткрытьФорму("Документ.КорректировкаПланов.Форма.ВысвобождениеРезервов", 
				 ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор, , ,
				 ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  

КонецПроцедуры  

&НаКлиенте
Процедура ВысвободитьРезервыЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Если Не ЭтоАдресВременногоХранилища(Результат.АдресВХранилище) Тогда
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьВысвобождениеРезервов(Результат);
	
	ПриОжиданииВыполнитьКонтрольДокумента();
	
КонецПроцедуры 

&НаСервере   
Процедура ЗаполнитьВысвобождениеРезервов(Результат)
	
	ТаблицаРезервы = ПолучитьИзВременногоХранилища(Результат.АдресВХранилище); 
	
	ВидОперацииПеренос = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;

	Для Каждого СтрокаТаблицы Из ТаблицаРезервы Цикл
		
		ИдентификаторСтроки = Новый УникальныйИдентификатор;	
		
		НоваяСтрока = Объект.Требуется.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, , "ДокументРезерва");   
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		НоваяСтрока.Требуется = СтрокаТаблицы.Свободно;
		НоваяСтрока.Сумма = СтрокаТаблицы.Свободно;

		ОбновитьПредставлениеПериодаСтроки(НоваяСтрока, Объект.ВидБюджета);

		НоваяСтрока = Объект.ОбеспечитьЗаСчет.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ВидОперации = ВидОперацииПеренос;
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		НоваяСтрока.Сумма = СтрокаТаблицы.Свободно;
		
		ОбновитьПредставлениеПериодаСтроки(НоваяСтрока, Объект.ВидБюджета);  

	КонецЦикла; 
	
	Модифицированность = Истина;   
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);
	
КонецПроцедуры   

#Область ЕдиныеРеквизиты 

&НаКлиенте
Процедура ПриИзмененииЕдиногоРеквизита(ИмяЕдиногоРеквизита)
		
	КонтрольЛимитовФормыКлиент.ПриИзмененииЕдиногоРеквизита(ЭтаФорма, ИмяЕдиногоРеквизита, "Требуется");
	
	Для Каждого Строка Из Объект.Требуется Цикл
		ОбновитьСвободныйОстаток(Строка);
	КонецЦикла;
	
КонецПроцедуры

