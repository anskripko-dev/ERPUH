// Выполняет обработчик ПриИзменении, сопоставленный по умолчанию для элемента Элемент
&НаКлиенте
Процедура ВыполнитьПредыдущийОбработчикПриИзмененииОрганизации(Элемент)

	#Если НЕ ВебКлиент Тогда
		ИмяЭлемента = Элемент.Имя;
		Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
			Для Каждого ТекОбработчикиИзмененияОрганизации Из ЭтаФорма["ОбработчикиИзмененияОрганизации"] Цикл
				Если СокрЛП(ТекОбработчикиИзмененияОрганизации.ИмяРеквизита) = СокрЛП(ИмяЭлемента) Тогда
					СтрокаВыполнения = ТекОбработчикиИзмененияОрганизации.ИмяОбработчика + "(Элемент);";
					Выполнить СтрокаВыполнения;
				КонецЕсли; 
			КонецЦикла;	
		КонецЕсли;
	#КонецЕсли  

КонецПроцедуры // ВыполнитьПредыдущийОбработчикПриИзмененииОрганизации()	

&НаКлиенте
Процедура ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли; 
	
	Модифицированность = Истина;
	
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение); 
	ПриОжиданииВыполнитьКонтрольДокумента(); 
	
	ТекущиеДанные = Элементы.Требуется.ТекущиеДанные; 
	ИдентификаторСтроки = Неопределено;
	Если Не ТекущиеДанные = Неопределено Тогда
		ИдентификаторСтроки = Элементы.Требуется.ТекущиеДанные.ПолучитьИдентификатор();  
	КонецЕсли;
	
	СоздатьСтатьиБюджетовИАналитики();  
	
	Если Не ИдентификаторСтроки = Неопределено Тогда
		Элементы.Требуется.ТекущаяСтрока = ИдентификаторСтроки;  	
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(Результат)
	
	ИспользуетсяИдентификаторСтроки = Результат.ИспользуетсяИдентификаторСтроки;
	ИдентификаторСтроки = Результат.ИдентификаторСтроки;
	
	ТаблицаПланов = ПолучитьИзВременногоХранилища(Результат.АдресВХранилище);
	
	Если ИспользуетсяИдентификаторСтроки Тогда
		ОбработкаВыбораПодборПлановПоИдентификаторуСтроки(ИдентификаторСтроки, ТаблицаПланов);
	Иначе
		ИменаРеквизитов = "СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, 
						  |ПриходРасход, Организация, ЦФО, Проект, НачалоПериода, Валюта, ДокументРезерва";
		
		Объект.ОбеспечитьЗаСчет.Очистить();    
		
		Требуется = Объект.Требуется.Итог("Сумма") + Объект.Требуется.Итог("СуммаРезерв");
		
		КолонкиИсточника = Объект.ОбеспечитьЗаСчет.Выгрузить().Колонки;
		Для Каждого СтрокаПлана Из ТаблицаПланов Цикл 
			
			Отбор =  Новый Структура;
			
			Для Каждого Колонки  Из КолонкиИсточника Цикл
				Если Колонки.Имя <> "НомерСтроки" И Колонки.Имя <> "Сумма" И Колонки.Имя <> "ИсходныйНомерСтроки" 
					 И ТаблицаПланов.Колонки.Найти(Колонки.Имя) <> Неопределено Тогда 
					Отбор.Вставить(Колонки.Имя, СтрокаПлана[Колонки.Имя]);
				КонецЕсли;
			КонецЦикла;
			
			Строка = Объект.ОбеспечитьЗаСчет.НайтиСтроки(Отбор);
			Если Строка = Неопределено ИЛИ Строка.Количество() = 0 Тогда
				ТекущаяСтрока = Объект.ОбеспечитьЗаСчет.Добавить();
			Иначе 
				ТекущаяСтрока = Объект.ОбеспечитьЗаСчет.Получить(Строка[0].НомерСтроки - 1);
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаПлана, ИменаРеквизитов);  
			
			Если Требуется = 0 Тогда
				ТекущаяСтрока.Сумма = 0;
			ИначеЕсли СтрокаПлана.Сумма > Требуется Тогда
				ТекущаяСтрока.Сумма = Требуется;
				Требуется = 0;
			Иначе
				ТекущаяСтрока.Сумма = СтрокаПлана.Сумма;
				ТребуетсяЛимит = Требуется - ТекущаяСтрока.Сумма;
			КонецЕсли;
			
			ОбновитьПредставлениеПериодаСтроки(ТекущаяСтрока, Объект.ВидБюджета);

		КонецЦикла;
	КонецЕсли;   
	
КонецПроцедуры

