
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "СтраницаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	Если Параметры.Ключ.Пустая() Тогда  	
		Если Параметры.Свойство("ДанныеЗаполнения") 
			И Параметры.ДанныеЗаполнения.Свойство("ВидБюджета") Тогда
			
			Объект.ВидБюджета = Параметры.ДанныеЗаполнения.ВидБюджета;
			
			ЗаполнитьПоДокументуПланированияНаСервере(); 
			
			Если Объект.Требуется.Количество() = 0 Тогда
				ВызватьИсключение НСтр("ru = 'Данные для корректировки планов и лимитов отсутствуют '");	
			КонецЕсли;  

		КонецЕсли;  

		ПриЧтенииСозданииНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
	
	СоздатьСтатьиБюджетовИАналитики();	

	#Область УХ_Согласование
	ДействияСогласованиеУХСервер.НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта(ЭтаФорма, Элементы.ГруппаДатаНомер);
	#КонецОбласти
	
	УправлениеФормой();
	
	КонтрольУХ.ПодготовитьФормуНаСервере(ЭтотОбъект, Элементы.ГруппаСтраницы);
	МодульСогласованияДокументовУХ.ПриСозданииНаСервереОбъект(ЭтаФорма);
	
	УстановитьУсловноеОформление();
	
	ВидыОперацииОбеспечить.Добавить(Перечисления.ВидыОперацийКорректировкаЛимитов.Увеличение);
	ВидыОперацииОбеспечить.Добавить(Перечисления.ВидыОперацийКорректировкаЛимитов.Уменьшение);

	УстановитьОграничениеТипаДокументаОснования();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства	
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства	
	
	Если Параметры.Ключ.Пустая() Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	Если Не Объект.Проведен Тогда
		ПриОжиданииВыполнитьКонтрольДокумента();   
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		УправлениеФормой();  
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	Если Объект.ОбеспечиватьПострочно Тогда   
		
		ПустойУникальныйИдентификатор = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
		Сч = 0;
		Пока Сч < ТекущийОбъект.ОбеспечитьЗаСчет.Количество() Цикл
			
			Если ТекущийОбъект.ОбеспечитьЗаСчет[Сч].ИдентификаторСтроки = ПустойУникальныйИдентификатор Тогда
				 ТекущийОбъект.ОбеспечитьЗаСчет.Удалить(Сч);	
			Иначе
				Сч = Сч + 1;	
			КонецЕсли;
			
		КонецЦикла;
		
		// Заполнить аналитики строк аналитиками строк требуется
		Для Каждого СтрокаОбеспечитьЗаСчет Из ТекущийОбъект.ОбеспечитьЗаСчет Цикл
			
			Если ВидыОперацииОбеспечить.НайтиПоЗначению(СтрокаОбеспечитьЗаСчет.ВидОперации) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураПоиска = Новый Структура("ИдентификаторСтроки", СтрокаОбеспечитьЗаСчет.ИдентификаторСтроки);
			
			СтрокиТребуется = ТекущийОбъект.Требуется.НайтиСтроки(СтруктураПоиска);
			Если СтрокиТребуется.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаОбеспечитьЗаСчет, СтрокиТребуется[0], , "Сумма, ИдентификаторСтроки");
			КонецЕсли;
	
		КонецЦикла;
	Иначе
		
		ВидОперацииПеренос = Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос;
		Для Каждого СтрокаОбеспечитьЗаСчет Из ТекущийОбъект.ОбеспечитьЗаСчет Цикл
			СтрокаОбеспечитьЗаСчет.ВидОперации = ВидОперацииПеренос;	
		КонецЦикла;

	КонецЕсли;  
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);
	УстановитьСостояниеДокумента();
	УправлениеФормой(); 
	КонтрольУХ.ИнициализироватьРезультатыКонтроля(ЭтотОбъект);
	ОбновитьПредставлениеПериодов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
    	ОбновитьЭлементыДополнительныхРеквизитов();
	    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства	
	
	#Область УХ_Согласование
	Если ИмяСобытия = "ОбъектСогласован" Тогда
		ОпределитьСостояниеОбъекта();
	ИначеЕсли ИмяСобытия = "ОбъектОтклонен" Тогда
		ОпределитьСостояниеОбъекта();
	ИначеЕсли ИмяСобытия = "МаршрутИнициализирован" Тогда
		ОпределитьСостояниеОбъекта();
	ИначеЕсли ИмяСобытия = "СостояниеЗаявкиПриИзменении" Тогда
		ОпределитьСостояниеОбъекта();
	КонецЕсли;
	#КонецОбласти   
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ДопПараметры = Новый Структура;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ДопПараметры.Вставить("КорректируемыйДокумент", Объект.ДокументОснование);
	КонецЕсли;
	Оповестить("ЗаписанаКорректировкаПланов", ДопПараметры);   
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборПлановЛимитов.Форма.Форма" Тогда
		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	ЗаполнитьПоДокументуПланированияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВысвобождатьРезервПриИзменении(Элемент)
	
	Элементы.ТребуетсяВысвободитьРезервы.Доступность = Не ТолькоПросмотр И Объект.ВысвобождатьРезервы;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидБюджетаПриИзменении(Элемент)
	
	Если Объект.Требуется.Количество() > 0 
		Или Объект.ОбеспечитьЗаСчет.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ВидБюджетаПриИзмененииЗавершение", ЭтотОбъект);   
		
		ТекстВопроса = НСтр("ru = 'При изменении вида бюджета будут очищены таблицы документа. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВидБюджетаПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидБюджетаПриИзмененииЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВидБюджета = Объект.ВидБюджета;
		Возврат;
	КонецЕсли;
	
	ВидБюджетаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(
		Элемент.ТекстРедактирования, 
		ЭтотОбъект, 
		"Объект.Комментарий");
КонецПроцедуры
	
&НаКлиенте
Процедура Подключаемый_СтатьяБюджета_ПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АналитикаСтатьиБюджета_ПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииАналитикиСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	// СтандартныеПодсистемы.Свойства
	Если ЭтотОбъект.ПараметрыСвойств.Свойство(ТекущаяСтраница.Имя)
		И Не ЭтотОбъект.ПараметрыСвойств.ВыполненаОтложеннаяИнициализация Тогда
		СвойстваВыполнитьОтложеннуюИнициализацию();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства	
КонецПроцедуры

#Область ОбработчикиСобытийЕдиныеПараметры

&НаКлиенте
Процедура ЕдиныйПериодПриИзменении(Элемент)
	
	Модифицированность = Истина;
	КонтрольЛимитовФормыКлиент.СохранитьВосстановитьЕдиноеЗначение(ЭтаФорма, ЕдиныйПериод, "НачалоПериода");
	КонтрольЛимитовФормыКлиент.СохранитьВосстановитьЕдиноеЗначение(ЭтаФорма, ЕдиныйПериод, "Периодичность");
	КонтрольЛимитовФормыКлиент.СохранитьВосстановитьЕдиноеЗначение(ЭтаФорма, ЕдиныйПериод, "ПредставлениеПериода");
	
	ПриИзмененииЕдиногоРеквизита("ЕдиныйПериод");
	ОбновитьПредставлениеПериодов(); 
	КонтрольЛимитовФормыКлиентСервер.НастроитьЗависимыеЭлементыФормы(ЭтаФорма, Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДополнительныеПараметры = Новый Структура("НачалоПериода", НачалоПериода);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВвестиДатуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВводДаты(ОписаниеОповещения, НачалоПериода, "Введите дату");
	
КонецПроцедуры  

&НаКлиенте
Процедура ВвестиДатуЗавершение(Дата, ДополнительныеПараметры) Экспорт
	
	НачалоПериода = ?(Дата = Неопределено, ДополнительныеПараметры.НачалоПериода, Дата);
	
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериодаПриИзменении();
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура НачалоПериодаПриИзменении()
	
	Модифицированность = Истина;
		
	Периодичность = ПолучитьПериодичностьПланирования(ВидБюджета, НачалоПериода);
	
	ПредставлениеПериода = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
		НачалоПериода, Периодичность);
		
	НачалоПериода = КэшируемыеПроцедурыУХ.ДатаНачалаПериода(НачалоПериода, Периодичность);
	
	КонтрольЛимитовФормыКлиент.ПроверкаОчисткиЕдиногоРеквизита(ЭтаФорма, "ЕдиныйПериод", "НачалоПериода");
	ПриИзмененииЕдиногоРеквизита("ЕдиныйПериод");

КонецПроцедуры

