Процедура УменьшитьПланПоВыбраннойСтроке(Команда)

	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийКорректировкаЛимитов.Уменьшение");
	ИзменитьЛимитПоТекущейСтрокеПотребностей(ВидОперации);   
	
	ПриОжиданииВыполнитьКонтрольДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшитьПланПоВсемСтрокам(Команда)
	
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийКорректировкаЛимитов.Уменьшение");
	Для Каждого ТекущаяСтрока Из Объект.Требуется Цикл
		ИзменитьЛимитПоТекущейСтрокеПотребностей(ВидОперации, ТекущаяСтрока);	
	КонецЦикла;  
	
	ПриОжиданииВыполнитьКонтрольДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОснованию(Команда)  
	
	Если Объект.Проведен Тогда      	
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоОснованиюЗавершение", ЭтотОбъект);
		
		ТекстВопроса = НСтр("ru = 'Операция в проведенном документе запрещена. Отменить проведение?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);  		
	Иначе     	
		ЗаполнитьПоДокументуПланированияНаСервере();		
	КонецЕсли;	
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗаполнитьПоОснованиюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьПоДокументуПланированияНаСервере();

КонецПроцедуры   

&НаКлиенте
Процедура ПодборОбеспеченияПоСтроке(Команда)

	Оповещение = Новый ОписаниеОповещения("ПодборОбеспеченияПоСтрокеЗавершение", ЭтотОбъект);
	
	Если Объект.Проведен Тогда 
		ТекстВопроса = НСтр("ru = 'Операция в проведенном документе запрещена. Отменить проведение?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);  
	ИначеЕсли Объект.Ссылка.Пустая() ИЛИ Модифицированность = Истина Тогда
		ТекстВопроса = НСтр("ru = 'Для подбора обеспечения по строке документ должен быть записан. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
	Иначе     	
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);  	
	КонецЕсли;

КонецПроцедуры  
	
&НаКлиенте
Процедура ПодборОбеспеченияПоСтрокеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;  
	
	СтрокаТребуется = Элементы.Требуется.ТекущиеДанные;
	Если СтрокаТребуется = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РежимЗаписи = ?(Объект.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись);
	Записать(Новый Структура("РежимЗаписи", РежимЗаписи));
	
	Модифицированность = Истина;  
	
	Элементы.Требуется.ТекущаяСтрока = СтрокаТребуется.ПолучитьИдентификатор();  	
	СуммаТребуется = ?(ЗначениеЗаполнено(СтрокаТребуется.Сумма), СтрокаТребуется.Сумма, СтрокаТребуется.СуммаРезерв); 
		      
	ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", СтрокаТребуется.ИдентификаторСтроки);
	НайденныСтроки = Объект.ОбеспечитьЗаСчет.НайтиСтроки(ПараметрыОтбора);
	
	ВидОперацииПеренос = ПредопределенноеЗначение("Перечисление.ВидыОперацийКорректировкаЛимитов.Перенос");
	
	Сумма = 0;
	Для Каждого ЭлементКоллекции Из НайденныСтроки Цикл
		Если Не ЭлементКоллекции.ВидОперации = ВидОперацииПеренос Тогда
			Сумма = Сумма + ЭлементКоллекции.Сумма;
		КонецЕсли;  		
	КонецЦикла;
	
	СуммаТребуется = Макс(СуммаТребуется - Сумма, 0);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИспользуетсяИдентификаторСтроки",			Истина);
	ПараметрыФормы.Вставить("ИдентификаторСтроки",						СтрокаТребуется.ИдентификаторСтроки); 
	ПараметрыФормы.Вставить("ВидБюджета",								Объект.ВидБюджета);
	ПараметрыФормы.Вставить("ПриходРасход",								СтрокаТребуется.ПриходРасход);
	ПараметрыФормы.Вставить("ВидИсточника",								?(ЗначениеЗаполнено(СтрокаТребуется.ДокументРезерва), "Резервы", "Лимиты"));
	ПараметрыФормы.Вставить("Валюта",									СтрокаТребуется.Валюта); 
	ПараметрыФормы.Вставить("СуммаТребуется",							СуммаТребуется); 
	ПараметрыФормы.Вставить("Заголовок",								НСтр("ru = 'Подбор планов для переноса'"));
	ПараметрыФормы.Вставить("Дата",										Объект.Дата);	
	ПараметрыФормы.Вставить("Документ",									Объект.Ссылка); 
	ПараметрыФормы.Вставить("РежимПодбораБезСуммовыхПараметров",		Истина);
	ПараметрыФормы.Вставить("Корзина", 									Объект.ОбеспечитьЗаСчет);
	
	ОткрытьФорму("Обработка.ПодборПлановЛимитов.Форма", ПараметрыФормы, ЭтотОбъект, 
				УникальныйИдентификатор, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры   

&НаКлиенте
Процедура ПодборОбеспечения(Команда)

	Оповещение = Новый ОписаниеОповещения("ПодборОбеспеченияЗавершение", ЭтотОбъект);
	
	Если Объект.Проведен Тогда 
		ТекстВопроса = НСтр("ru = 'Операция в проведенном документе запрещена. Отменить проведение?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);  		
	Иначе     	
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);  	
	КонецЕсли;	
	
КонецПроцедуры    

&НаКлиенте
Процедура ПодборОбеспеченияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;  
	
	Если Объект.Проведен Тогда 
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения)); 
		Модифицированность = Истина;
	КонецЕсли;
	
	Требуется = Объект.Требуется.Итог("Сумма") + Объект.Требуется.Итог("СуммаРезерв");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИспользуетсяИдентификаторСтроки",			Ложь);   
	ПараметрыФормы.Вставить("ВидБюджета",								Объект.ВидБюджета);
	ПараметрыФормы.Вставить("СуммаТребуется",							Требуется);  
	ПараметрыФормы.Вставить("Заголовок",								НСтр("ru = 'Подбор планов для переноса'"));
	ПараметрыФормы.Вставить("Дата",										Объект.Дата);	
	ПараметрыФормы.Вставить("Документ",									Объект.Ссылка); 
	ПараметрыФормы.Вставить("РежимПодбораБезСуммовыхПараметров",		Истина);
	ПараметрыФормы.Вставить("Корзина", 									Объект.ОбеспечитьЗаСчет);
	
	ОткрытьФорму("Обработка.ПодборПлановЛимитов.Форма", ПараметрыФормы, ЭтотОбъект, 
				УникальныйИдентификатор , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры  

&НаКлиенте
Процедура ПереносСвободныхЛимитов(Команда) 
	
	РежимЗаписи = ?(Объект.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись); 
	Записать(Новый Структура("РежимЗаписи", РежимЗаписи));   
	
	Модифицированность = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимЗаполнения", 1);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПереносСвободныхЛимитовЗавершение", ЭтаФорма, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;   		
	ПараметрыФормы.Вставить("ВидБюджета", 	 	Объект.ВидБюджета);
    ПараметрыФормы.Вставить("Документ",	  	 	Объект.Ссылка); 
	ПараметрыФормы.Вставить("ДатаДокумента", 	Объект.Дата);   
	                                              
	ОткрытьФорму("Документ.КорректировкаПланов.Форма.ПереносСвободныхЛимитов", 
				 ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор , , ,
				 ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры  

&НаКлиенте
Процедура ПодборПотребностей(Команда)
			
	РежимЗаписи = ?(Объект.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись); 
	Записать(Новый Структура("РежимЗаписи", РежимЗаписи));   
	
	Модифицированность = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимЗаполнения", 2);
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПереносСвободныхЛимитовЗавершение", ЭтаФорма, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;   		
	ПараметрыФормы.Вставить("ВидБюджета", 	 	Объект.ВидБюджета);
    ПараметрыФормы.Вставить("Документ",	  	 	Объект.Ссылка); 
	ПараметрыФормы.Вставить("ДатаДокумента", 	Объект.Дата);
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		ПараметрыФормы.Вставить("НачалоПериода", 	НачалоПериода);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЦФО) Тогда
		ПараметрыФормы.Вставить("ЦФО", 	ЦФО);
	КонецЕсли;
	Если ЗначениеЗаполнено(Проект) Тогда
		ПараметрыФормы.Вставить("Проект", 	Проект);
	КонецЕсли;
	Если ЗначениеЗаполнено(Валюта) Тогда
		ПараметрыФормы.Вставить("Валюта", 	Валюта); 
	КонецЕсли;   
		
	ОткрытьФорму("Документ.КорректировкаПланов.Форма.ПодборПотребностей", 
				 ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор,,,ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				 
КонецПроцедуры  
			 
&НаКлиенте
Процедура ВысвободитьРезервы(Команда) 
	
	Если Объект.Требуется.Количество() > 0 Тогда		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОчиститьТабличныеЧастиПродолжение", ЭтотОбъект);
	
		ТекстВопроса = НСтр("ru = 'Табличные части будут очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);  
	Иначе
		ОткрытьФормуВысвобождениеРезервов();	
	КонецЕсли;  	
	
КонецПроцедуры  

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()

	ВидБюджета = Объект.ВидБюджета;
	
	УстановитьСостояниеДокумента(); 
	
	// Управление элементами формы 
	УправлениеЭлементамиФормы.ПриЧтенииСозданииНаСервере(ЭтотОбъект);
	
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйПериод", "НачалоПериода, ТребуетсяНачалоПериода");
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйЦФО", "ЦФО, ТребуетсяЦФО");  
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйПроект", "Проект, ТребуетсяПроект");
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдинаяВалюта", "Валюта, ТребуетсяВалюта"); 
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйПриходРасход", "ПриходРасход, ТребуетсяПриходРасход");
		
	КонтрольЛимитовФормы.ОпределитьЕдиныеРеквизитыФормыКорректировкиЛимитов(ЭтаФорма, "Требуется"); 
	
	КонтрольЛимитовФормыКлиентСервер.НастроитьЗависимыеЭлементыФормы(ЭтаФорма);
	
	ОбновитьПредставлениеПериодов();
	
	СоздатьСтатьиБюджетовИАналитики();

КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()  
	
	ВидимостьЗапретРедактирования = Ложь;
	Если Объект.Проведен Тогда
		Если ЗначениеЗаполнено(Объект.ДокументОснование) 
			И Объект.ДокументОснование.Проведен 
			И Не Объект.ВысвобождатьРезервы Тогда
			ТолькоПросмотр = Истина;	 
			ВидимостьЗапретРедактирования = Истина;
		КонецЕсли;
	КонецЕсли; 
	Элементы.ДекорацияЗапретРедактирования.Видимость = ВидимостьЗапретРедактирования;
	
	УказаноОснование = ЗначениеЗаполнено(Объект.ДокументОснование);  
	Элементы.Требуется.КоманднаяПанель.ПодчиненныеЭлементы.ТребуетсяДобавить.Видимость  	= Не УказаноОснование;   
	Элементы.Требуется.КоманднаяПанель.ПодчиненныеЭлементы.ТребуетсяСкопировать.Видимость  	= Не УказаноОснование;   
	Элементы.Требуется.КоманднаяПанель.ПодчиненныеЭлементы.ТребуетсяУдалить.Видимость  		= Не УказаноОснование;   
	
	ТребуетсяКонтекстноеМеню = Элементы.Требуется.КонтекстноеМеню.ПодчиненныеЭлементы;
	ТребуетсяКонтекстноеМеню.ТребуетсяКонтекстноеМенюДобавить.Видимость    = Не УказаноОснование;   
	ТребуетсяКонтекстноеМеню.ТребуетсяКонтекстноеМенюСкопировать.Видимость = Не УказаноОснование;   
	ТребуетсяКонтекстноеМеню.ТребуетсяКонтекстноеМенюУдалить.Видимость     = Не УказаноОснование;   
	
	Элементы.ТребуетсяСумма.ТолькоПросмотр = УказаноОснование;
	Элементы.ТребуетсяРезерв.ТолькоПросмотр = УказаноОснование;
    Элементы.ТребуетсяДокументРезерва.ТолькоПросмотр = УказаноОснование; 
	Элементы.ТребуетсяСтатьяБюджета.ТолькоПросмотр = УказаноОснование;
	
	Элементы.ВидБюджета.Доступность = Не ТолькоПросмотр;
	Элементы.ОбеспечитьЗаСчетПодборОбеспечения.Доступность = Не ТолькоПросмотр;
	Элементы.ТребуетсяУвеличитьПланПоВсемСтрокам.Доступность = Не ТолькоПросмотр; 
	Элементы.ТребуетсяУвеличитьПланПоВыбраннойСтроке.Доступность = Не ТолькоПросмотр; 
	Элементы.ТребуетсяПодборОбеспеченияПоСтроке.Доступность = Не ТолькоПросмотр;
	Элементы.ОбеспечитьЗаСчетПодборОбеспечения.Доступность = Не ТолькоПросмотр;
	Элементы.ТребуетсяПодборПотребностей.Доступность = Не ТолькоПросмотр;
	
	Элементы.ВысвобождатьРезервы.Доступность = УказаноОснование;
	Элементы.ТребуетсяВысвободитьРезервы.Видимость = КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования();
	Элементы.ТребуетсяВысвободитьРезервы.Доступность = Не ТолькоПросмотр И Объект.ВысвобождатьРезервы;

	ЭтоОперацияОбеспечиватьПострочно = Объект.ОбеспечиватьПострочно;	  
	
	Элементы.ТребуетсяПодборОбеспеченияПоСтроке.Видимость = ЭтоОперацияОбеспечиватьПострочно;   
	Элементы.ТребуетсяУвеличитьПланПоВыбраннойСтроке.Видимость = ЭтоОперацияОбеспечиватьПострочно;     
	Элементы.ТребуетсяУвеличитьПланПоВсемСтрокам.Видимость = ЭтоОперацияОбеспечиватьПострочно; 
	Элементы.СтраницаИсточник.Видимость = Не ЭтоОперацияОбеспечиватьПострочно;  
	Элементы.ГруппаОбеспечениеПоИдентификаторамСтрок.Видимость = ЭтоОперацияОбеспечиватьПострочно;
   	Элементы.ТребуетсяУвеличить.ТолькоПросмотр = ЭтоОперацияОбеспечиватьПострочно;
	Элементы.ТребуетсяПеренесено.Видимость = ЭтоОперацияОбеспечиватьПострочно; 
	
	Элементы.ТребуетсяГруппаУменьшить.Видимость = ЭтоОперацияОбеспечиватьПострочно;  
	
	Элементы.ГруппаЗаполнениеТаблицы.ТолькоПросмотр = УказаноОснование; 

КонецПроцедуры             

&НаКлиенте
Процедура ИзменитьЛимитПоТекущейСтрокеПотребностей(ВидОперации, ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.Требуется.ТекущиеДанные;
	КонецЕсли;  
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоРезерв = (ЗначениеЗаполнено(ТекущаяСтрока.СуммаРезерв) И ЗначениеЗаполнено(ТекущаяСтрока.ДокументРезерва)); 
		
	СуммаУвеличить = ?(ЗначениеЗаполнено(ТекущаяСтрока.Сумма), ТекущаяСтрока.Сумма, ТекущаяСтрока.СуммаРезерв);
	СуммаУвеличить = СуммаУвеличить - Мин(ТекущаяСтрока.Перенесено, СуммаУвеличить);
	
	Если СуммаУвеличить > 0 Тогда
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтроки, ВидОперации", 
						ТекущаяСтрока.ИдентификаторСтроки, ВидОперации);
		Строки = Объект.ОбеспечитьЗаСчет.НайтиСтроки(СтруктураПоиска);
		
		Если Строки.Количество() = 0 Тогда
			
			Строка = Объект.ОбеспечитьЗаСчет.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, ТекущаяСтрока, , "ДокументРезерва");
			Строка.ИдентификаторСтроки = СтруктураПоиска.ИдентификаторСтроки;
			Строка.ВидОперации = ВидОперации;       

		Иначе
			Строка = Строки[0];
		КонецЕсли;
		
		Строка.Сумма = СуммаУвеличить;
		ТекущаяСтрока.Увеличить = СуммаУвеличить;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
