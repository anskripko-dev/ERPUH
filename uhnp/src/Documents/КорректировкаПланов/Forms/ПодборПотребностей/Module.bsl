
#Область ОписаниеПеременных

&НаКлиенте
Перем ВыполняетсяЗакрытие Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;  
	
	ВидБюджета = Параметры.ВидБюджета;

	ОбновитьЭлементыФормыНастройкиПериода();
	ЗаголовокГода = Формат(Период.ДатаНачала, "ДЛФ=Д");
    Элементы.ОтчетнаяДатаКоманда.Заголовок = ЗаголовокГода;   
	
	ПараметрыОП = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджета, Период.ДатаНачала);         
	Периодичность = ПараметрыОП.ПериодичностьЛимитирования;     
	
	СписокПериодичностиЛимитирования = КонтрольЛимитовУХ.ДоступныеПериодичностиЛимитирования(ВидБюджета, Период.ДатаНачала);
	Элементы.Периодичность.СписокВыбора.ЗагрузитьЗначения(СписокПериодичностиЛимитирования); 
	
	ИнициализироватьКомпоновщикНастроек();  

	ВывестиРезультатКомпоновкиДанныхВКоллекциюЗначений(); 
	
КонецПроцедуры 

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроек()

	СхемаКомпоновкиДанных = Документы.КорректировкаПланов.ПолучитьМакет("СвободныеЛимиты");
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор));
	КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроек); 

	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВидБюджета", 		ВидБюджета);
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачала", 		Период.ДатаНачала);
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаОкончания", 	Период.ДатаОкончания);
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Документ", 		Параметры.Документ);
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Периодичность", 	Периодичность);   

	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТипыЗаявокКОбеспечению", 	КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению());
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТипыЗаявокНаОперации", 	КонтрольЛимитовУХ.ТипыЗаявокНаОперации());
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТипыКорректировкиЛимитов", КонтрольЛимитовУХ.ТипыКорректировкиЛимитов()); 
		
	ВывестиБыстрыеПользовательскихНастройки(); 
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Для каждого ЭлементОтбора из Настройки.Отбор.Элементы Цикл 
		Если Параметры.Свойство(Строка(ЭлементОтбора.ЛевоеЗначение)) Тогда
			ЭлементОтбора.ПравоеЗначение = Параметры[Строка(ЭлементОтбора.ЛевоеЗначение)];
			ЭлементОтбора.Использование = Истина;
		КонецЕсли;	
	КонецЦикла;
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОтчетнаяДатаКомандаЗавершение" И Источник = ЭтаФорма Тогда
		
		Период.ДатаНачала = Параметр.Период;
		ИзменитьПериод(0);	  
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы
		И Корзина.Количество() > 0 Тогда
		
		Отказ = Истина;
		ТекстПредупреждения = НСтр("ru = 'Данные были изменены. Все изменения будут потеряны.'"); 
		
		Возврат;
		
	КонецЕсли;
	
	ПередЗакрытиемФормыПодбора(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент Тогда
		АдресВХранилище = АдресВХранилище(ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
	Иначе
		АдресВХранилище = Неопределено;
	КонецЕсли;
	
	Если АдресВХранилище <> Неопределено Тогда
		Результат = Новый Структура;
		Результат.Вставить("АдресВХранилище", АдресВХранилище);
		ОповеститьОВыборе(Результат);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
		
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Периодичность", Периодичность);
	
	ВывестиРезультатКомпоновкиДанныхВКоллекциюЗначений();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущийПериод(Команда)

	ИзменитьПериод(-1);       

КонецПроцедуры

&НаКлиенте
Процедура СледующийПериод(Команда)
	
	ИзменитьПериод(1);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетнаяДатаКоманда(Команда)
	
	ОткрытьПараметрыКонтроляПериода(); 

КонецПроцедуры    

&НаКлиенте
Процедура УстановитьФлажки(Команда)

	Для Каждого СтрокаТаблицы Из Корзина Цикл
		СтрокаТаблицы.Пометка = Истина;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из Корзина Цикл
		СтрокаТаблицы.Пометка = Ложь;	
	КонецЦикла;      
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_БыстрыеОтборыПриИзменении(Элемент)
	
	ВывестиРезультатКомпоновкиДанныхВКоллекциюЗначений();
	
КонецПроцедуры  

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере  
Процедура ВывестиРезультатКомпоновкиДанныхВКоллекциюЗначений()

	СхемаКомпоновкиДанных = Документы.КорректировкаПланов.ПолучитьМакет("СвободныеЛимиты");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;   

	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, 
					КомпоновщикНастроек.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	                                                                        
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;   	
	ТаблицаЗначений =  Новый ТаблицаЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТаблицаЗначений);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Корзина.Загрузить(ТаблицаЗначений);
	
	Для Каждого СтрокаТаблицы Из Корзина Цикл      
		СтрокаТаблицы.Пометка = Истина;
		СтрокаТаблицы.НачалоПериодаСтрока = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(СтрокаТаблицы.НачалоПериода, Периодичность);	
	КонецЦикла;  
	
	ОбновитьПодвал();
	
КонецПроцедуры   

Процедура ОбновитьПодвал()

	ТаблицаВалюты = Корзина.Выгрузить();   
	ТаблицаВалюты.Свернуть("Валюта", "Свободно");

	СоставПредставления = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаВалюты Цикл 
		СоставПредставления.Добавить(Формат(СтрокаТаблицы.Свободно, "ЧДЦ=0; ЧРГ=") + " " + Строка(СтрокаТаблицы.Валюта));
	КонецЦикла;
	СвободноПодвал = СтрСоединить(СоставПредставления, ", ");

КонецПроцедуры

&НаСервере
Процедура ВывестиБыстрыеПользовательскихНастройки()
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	КоличествоОтборов = Настройки.Отбор.Элементы.Количество();

	ПолеОтборы   = ЭтаФорма.Элементы.Добавить("ПолеОтборы", Тип("ГруппаФормы"), Элементы.СписокКомпоновщикНастроекПользовательскиеНастройки);
	ПолеОтборы.Вид  = ВидГруппыФормы.ОбычнаяГруппа;
	ПолеОтборы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ПолеОтборы.ОтображатьЗаголовок = Ложь;
	
	ОтборыКолонкаВлево   = ЭтаФорма.Элементы.Добавить("ОтборыКолонка1", Тип("ГруппаФормы"), ПолеОтборы);
	ОтборыКолонкаВлево.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ОтборыКолонкаВлево.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ОтборыКолонкаВлево.ОтображатьЗаголовок  = Ложь;
	ОтборыКолонкаВлево.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	ОтборыКолонкаВправо  = ЭтаФорма.Элементы.Добавить("ОтборыКолонка2", Тип("ГруппаФормы"), ПолеОтборы);
	ОтборыКолонкаВправо.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ОтборыКолонкаВправо.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ОтборыКолонкаВправо.ОтображатьЗаголовок = Ложь;
	ОтборыКолонкаВправо.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	НастроекНаКолонку = Окр(КоличествоОтборов/2, 0, РежимОкругления.Окр15как20);
	Колонка = ОтборыКолонкаВлево;
	
	НомерЭлемента = 0;
	Для каждого ЭлОтбора из Настройки.Отбор.Элементы Цикл
		
		Если НомерЭлемента = НастроекНаКолонку Тогда
			Колонка = ОтборыКолонкаВправо;
		КонецЕсли;

		ПолеГруппыОтбора = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+НомерЭлемента, Тип("ГруппаФормы"), Колонка);
		ПолеГруппыОтбора.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ПолеГруппыОтбора.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ПолеГруппыОтбора.ОтображатьЗаголовок = Ложь;
		ПолеГруппыОтбора.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;

		ПолеИспользование = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+НомерЭлемента+"Использование", Тип("ПолеФормы"), ПолеГруппыОтбора);
		ПолеИспользование.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеИспользование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		ПолеИспользование.Заголовок = ЭлОтбора.ЛевоеЗначение;
		ПолеИспользование.ПутьКДанным = "КомпоновщикНастроек.ПользовательскиеНастройки[" + НомерЭлемента + "].Использование";    
		ПолеИспользование.УстановитьДействие("ПриИзменении", "Подключаемый_БыстрыеОтборыПриИзменении");
		
		ПолеВидСравнения = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+НомерЭлемента+"ВидСравненияЭлементаОтбора", Тип("ПолеФормы"), ПолеГруппыОтбора);
		ПолеВидСравнения.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВидСравнения.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ПолеВидСравнения.РастягиватьПоГоризонтали = Ложь;
		ПолеВидСравнения.ПутьКДанным = "КомпоновщикНастроек.ПользовательскиеНастройки[" + НомерЭлемента + "].ВидСравнения"; 
		ПолеВидСравнения.УстановитьДействие("ПриИзменении", "Подключаемый_БыстрыеОтборыПриИзменении");

		ПолеЗначение = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+НомерЭлемента+"Значение", Тип("ПолеФормы"), ПолеГруппыОтбора);
		ПолеЗначение.Вид = ВидПоляФормы.ПолеВвода;
		ПолеЗначение.ВыбиратьТип = Ложь;
		ПолеЗначение.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ПолеЗначение.ПутьКДанным = "КомпоновщикНастроек.ПользовательскиеНастройки[" + НомерЭлемента + "].Значение";
		ПолеЗначение.УстановитьДействие("ПриИзменении", "Подключаемый_БыстрыеОтборыПриИзменении");
		
		НомерЭлемента = НомерЭлемента + 1;  
		
	КонецЦикла;    

КонецПроцедуры

&НаСервере
Функция АдресВХранилище(УникальныйИдентификаторВладельца)
	
	АдресВХранилище = Неопределено;
	
	Если ПеренестиВДокумент Тогда
		
		ПараметрыОтбора = Новый Структура("Пометка", Истина);
		ВыбранныеЭлементы = Корзина.НайтиСтроки(ПараметрыОтбора);

		АдресВХранилище = ПоместитьВоВременноеХранилище(ВыбранныеЭлементы, УникальныйИдентификаторВладельца);
		
	КонецЕсли;
	
	Возврат АдресВХранилище;
	
КонецФункции

&НаКлиенте
Процедура ПередЗакрытиемФормыПодбора(Форма, Отказ)
	
	Если Форма.ПеренестиВДокумент ИЛИ Форма.ВыполняетсяЗакрытие Тогда
		Возврат;
	КонецЕсли;
	
	Если Корзина.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина; 
	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемФормыПодбораЛимитовЗавершение", ЭтотОбъект, 
							Новый Структура("Форма", Форма));
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Подобранные лимиты не перенесены в документ. Перенести?'"), 
					РежимДиалогаВопрос.ДаНетОтмена);
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемФормыПодбораЛимитовЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Форма.ПеренестиВДокумент = Истина;
		Форма.ВыполняетсяЗакрытие = Истина;
		Форма.Закрыть(КодВозвратаДиалога.OK);
		Форма.ВыполняетсяЗакрытие = Ложь;
		Возврат;
	КонецЕсли;
	
	Форма.ВыполняетсяЗакрытие = Истина;
	Форма.Закрыть();
	Форма.ВыполняетсяЗакрытие = Ложь;

КонецПроцедуры

&НаСервере    
Процедура ОбновитьЭлементыФормыНастройкиПериода()
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		
		Запрос = Новый Запрос;  
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПараметрыЛимитирования.Период КАК Период
		|ИЗ
		|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
		|ГДЕ
		|	ПараметрыЛимитирования.Период <= &Период
		|	И ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";  
		Запрос.УстановитьПараметр("Период", 	Параметры.ДатаДокумента); 
		Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
        	
		РезультатЗапроса = Запрос.Выполнить();
		ПериодыЛимитирования = РезультатЗапроса.Выбрать();   
		
		Если ПериодыЛимитирования.Следующий() Тогда  
			
			Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
			Период.ДатаНачала = ПериодыЛимитирования.Период;		
			
			ПараметрыЛимитирования = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(ВидБюджета, Период.ДатаНачала, 1);   
			Если ПараметрыЛимитирования = Неопределено Тогда
				Период.ДатаОкончания = Дата('3999.12.31 23:59:59');
			Иначе
				Период.ДатаОкончания = ПараметрыЛимитирования.Период - 1;	
			КонецЕсли;
			
		КонецЕсли;    
		
	КонецЕсли;  

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериод(Направление)
	
	ПараметрыЛимитирования = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(ВидБюджета, Период.ДатаНачала, Направление);
	Если ПараметрыЛимитирования = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Период.ДатаНачала = ПараметрыЛимитирования.Период;
	
	ПараметрыЛимитирования = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(ВидБюджета, Период.ДатаНачала, 1);   
	Если ПараметрыЛимитирования = Неопределено Тогда
		Период.ДатаОкончания = Дата('3999.12.31 23:59:59');
	Иначе
		Период.ДатаОкончания = ПараметрыЛимитирования.Период - 1;	
	КонецЕсли;
	
	ЗаголовокГода = Формат(Период.ДатаНачала, "ДЛФ=Д");
	Элементы.ОтчетнаяДатаКоманда.Заголовок = ЗаголовокГода; 
	
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачала", 	  Период.ДатаНачала);
	БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаОкончания", Период.ДатаОкончания);

КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьПараметрыКонтроляПериода()
	
	ДопПараметры = ПолучитьПараметрыФормыЗаписиПараметровЛимитирования(Период.ДатаНачала, ВидБюджета);
	Если ДопПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимВыбора", 			Истина);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", 	Истина);
	ПараметрыОткрытия.Вставить("Отбор", 				Новый Структура("ВидБюджета", ВидБюджета));   
	
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитирования.Форма.ФормаВыбораПериода", ПараметрыОткрытия, 
																					ЭтаФорма,,,,,
																					РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры  
																				
&НаСервереБезКонтекста
Функция ПолучитьПараметрыФормыЗаписиПараметровЛимитирования(Период, ВидБюджета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.Период = &Период
	|	И ПараметрыЛимитирования.ВидБюджета = &ВидБюджета";
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Возврат Новый Структура("Ключ", ПолучитьКлючЗаписиПараметровЛимитирования(Период, ВидБюджета));
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ИСТИНА КАК Использовать,
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияСрезПоследних.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КоличествоПериодовЛимитирования КАК КоличествоПериодовЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
	|	ПараметрыЛимитированияСрезПоследних.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольРезервов КАК КонтрольРезервов
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования.СрезПоследних(&Период, ВидБюджета = &ВидБюджета) КАК ПараметрыЛимитированияСрезПоследних";	
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	Для Каждого Колонка Из Результат.Колонки Цикл
		ЗначенияЗаполнения.Вставить(Колонка.Имя);
	КонецЦикла;
	ЗначенияЗаполнения.Период = Период;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
	
	Возврат Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
КонецФункции   

&НаСервереБезКонтекста
Функция ПолучитьКлючЗаписиПараметровЛимитирования(Период, ВидБюджета)
	
	ДанныеКлюча = Новый Структура("Период, ВидБюджета", Период, ВидБюджета);
	КлючЗаписи = РегистрыСведений.ПараметрыЛимитирования.СоздатьКлючЗаписи(ДанныеКлюча);

	Возврат КлючЗаписи;
	
КонецФункции
    
&НаКлиенте
Процедура КорзинаПриИзменении(Элемент)
	
	ОбновитьПодвал();
	
КонецПроцедуры

