#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	
	ПроведениеСерверУХ.ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	Если Не ДополнительныеСвойства.Свойство("ОтключитьКонтрольУХ") Тогда  
		
		ЭтоЗаявкаНаКорректировкуПланов = (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов"));
		ЭтоЗапись = (РежимЗаписи = РежимЗаписиДокумента.Запись);   
		
		ЗапретитьИзменение = Не ЭтоЗаявкаНаКорректировкуПланов И Не ЭтоЗапись
							И ЗначениеЗаполнено(ДокументОснование) 
							И ДокументОснование.Проведен И Не ВысвобождатьРезервы;
			
		Если ЗапретитьИзменение Тогда     
			ТекстСообщения = НСтр("ru = 'Документ основание проведен, изменение текущего документа запрещено'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , , Отказ);   
		КонецЕсли;   
		
	КонецЕсли;
	
	СуммаДокумента = Требуется.Итог("Сумма") + Требуется.Итог("СуммаРезерв");
	                       
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ДокументОснование = ДанныеЗаполнения;
	ТипИсточника = ТипЗнч(ДанныеЗаполнения); 

	// Документы исключения, заполняются при создании на сервере
	ДокументыИсключения = Новый Массив;
    ДокументыИсключения.Добавить(Тип("ДокументСсылка.ВерсияСоглашенияКоммерческийДоговор"));
	ДокументыИсключения.Добавить(Тип("ДокументСсылка.ВерсияСоглашенияКредит"));
	ДокументыИсключения.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	
	Если Не ДокументыИсключения.Найти(ТипИсточника) = Неопределено Тогда
		
		Если ДокументОснование.Проведен Тогда  	
			ШаблонСообщения = НСтр("ru = 'Для ввода документа ""%1"" следует отменить проведение документа: %2'"); 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
							Метаданные.Документы.КорректировкаПланов, ДокументОснование); 
	
			ВызватьИсключение ТекстСообщения;	
		КонецЕсли;

		Возврат;
	КонецЕсли;    
	
	Если ТипИсточника <> Тип("Структура") Тогда
		Источник = ДанныеЗаполнения;
		ДанныеЗаполнения = Новый Структура;
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("Ответственный", Пользователи.ТекущийПользователь());

	Если НЕ ДанныеЗаполнения.Свойство("ВидБюджета") Тогда
		Если ЗначениеЗаполнено(ВидБюджета) Тогда
			ДанныеЗаполнения.Вставить("ВидБюджета", ВидБюджета);
		ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов") Тогда
			ДанныеЗаполнения.Вставить("ВидБюджета", Общегоназначения.ЗначениеРеквизитаОбъекта(Источник, "ВидБюджета"));
		Иначе
			Если ТипИсточника = Тип("ДокументСсылка.ЗаявкаНаРасход") Тогда
				ДанныеЗаполнения.Вставить("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов); 
			ИначеЕсли ТипИсточника = Тип("ДокументСсылка.Резервирование") Тогда
				ДанныеЗаполнения.Вставить("ВидБюджета", Источник.ВидБюджета);
			Иначе
				ДанныеЗаполнения.Вставить("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
			КонецЕсли;   
		КонецЕсли;
	КонецЕсли; 
	
	Если КонтрольЛимитовУХ.ЭтоЗакупочныйДокумент(Источник) Тогда
		ВидБюджета = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Источник.Дата);      
		ДанныеЗаполнения.Вставить("ВидБюджета", ВидБюджета);   
	КонецЕсли;

	ТипыВерсииСоглашений = Метаданные.ОпределяемыеТипы.ВерсияСоглашения.Тип;
	ТипыОбъектовПланирования = Метаданные.Документы.КорректировкаПланов.Реквизиты.ДокументОснование.Тип;
	ТипыДоговоров = Метаданные.ОпределяемыеТипы.Договор.Тип;
	
	Если ТипыДоговоров.СодержитТип(ТипИсточника) 
		И Не ТипИсточника = ТипЗнч(Неопределено) Тогда
		ВерсияСоглашения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ВерсияСоглашения");
		ДанныеЗаполнения.Вставить("ДокументОснование", ВерсияСоглашения);
		Документы.КорректировкаПланов.ЗаполнитьПоДокументуПланирования(ЭтотОбъект, ВерсияСоглашения, ДанныеЗаполнения);
	ИначеЕсли ТипыОбъектовПланирования.СодержитТип(ТипИсточника) Тогда  
		
		Если ЗначениеЗаполнено(Источник) И Источник.Проведен 
			И Не ТипЗнч(Источник) = Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов") Тогда  	
			ШаблонСообщения = НСтр("ru = 'Для ввода документа ""%1"" следует отменить проведение документа: %2'"); 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
							Метаданные.Документы.КорректировкаПланов, Источник); 
	
			ВызватьИсключение ТекстСообщения;	
		КонецЕсли;
		
		ДанныеЗаполнения.Вставить("ДокументОснование", Источник);
		Документы.КорректировкаПланов.ЗаполнитьПоДокументуПланирования(ЭтотОбъект, Источник, ДанныеЗаполнения);
	ИначеЕсли ТипИсточника = Тип("Структура") И ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
		Документы.КорректировкаПланов.ЗаполнитьПоДокументуПланирования(ЭтотОбъект, ДанныеЗаполнения.ДокументОснование, ДанныеЗаполнения);
	ИначеЕсли ДанныеЗаполнения.Свойство("Требуется") Тогда
		Для Каждого Строка Из ДанныеЗаполнения.Требуется Цикл
			ТребуетсяНоваяСтрока = Требуется.Добавить();
			ТребуетсяНоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор();
			ТребуетсяНоваяСтрока.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
			ЗаполнитьЗначенияСвойств(ТребуетсяНоваяСтрока, Строка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)   
	
	// Соответствие сумм требуется и обеспечить        
	Колонки = "Валюта, ПриходРасход, Сумма, Увеличить, СуммаРезерв"; 
	Если ОбеспечиватьПострочно Тогда
		Колонки = Колонки + ", ИдентификаторСтроки";	
	КонецЕсли;
	
	Таблица = Требуется.Выгрузить(, Колонки);
	Таблица.Колонки.Добавить("ЗаСчет", ОбщегоНазначения.ОписаниеТипаЧисло(18, 2));  
	
	Если Не ОбеспечиватьПострочно Тогда
		Для Каждого Строка Из Таблица Цикл
			Строка.Сумма = Строка.Сумма - Строка.Увеличить;  
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрокаОбеспечить Из ОбеспечитьЗаСчет Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаОбеспечить, , "Сумма");
		Строка.ЗаСчет = СтрокаОбеспечить.Сумма;   
	КонецЦикла;
	
	КолонкиГруппировок = "Валюта, ПриходРасход"; 
	Если ОбеспечиватьПострочно Тогда
		КолонкиГруппировок = КолонкиГруппировок + ", ИдентификаторСтроки";	
	КонецЕсли;
	КолонкиСуммирования = "Сумма, СуммаРезерв, ЗаСчет";
	
	Таблица.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	Для Каждого Строка Из Таблица Цикл 
		
		Строка.Сумма = Строка.Сумма + Строка.СуммаРезерв;
		
		Если Не Строка.Сумма = Строка.ЗаСчет Тогда
			Шаблон = НСтр("ru = 'Лимиты: итого Требуется (%1) для валюты (%2) и направлению (%3) не равно итого по строкам обеспечения (%4). Проведение невозможно.'");
			ОбщегоНазначения.СообщитьПользователю(
							 СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							 Шаблон, Строка.Сумма, Строка.Валюта, Строка.ПриходРасход, Строка.ЗаСчет), , , , Отказ);     
		КонецЕсли;  
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	МСФОУХ.ПроверитьРучныеКорректировкиДокумента(Ссылка, Отказ);
	
	Если НЕ ЭтотОбъект.ВысвобождатьРезервы Тогда
		КонтрольЛимитовУХ.ПроверитьИзменениеУчетнойПолитикиПланированиеЗакупок(ЭтотОбъект, ДокументОснование, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Инициализация дополнительных свойств для проведения документа   
	ПроведениеСерверУХ.ИнициализироватьДополнительныеСвойстваДляПроведения(
							Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа	
	Документы.КорректировкаПланов.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСерверУХ.ПодготовитьНаборыЗаписейКПроведению(ЭтотОбъект);	
	
	// Движения по регистра  
	ПланированиеПотребностей.ОтразитьОперацииБюджетов(ДополнительныеСвойства, Движения, Отказ);
	
	ОтправитьНаСогласованиеПриПроведенииДокумента(Отказ);

КонецПроцедуры   

Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеСерверУХ.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);	

	МодульУправленияПроцессамиУХ.ОтменитьСогласованиеПриОтменеПроведения(Ссылка);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Ответственный = Пользователи.ТекущийПользователь();  
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьНаСогласованиеПриПроведенииДокумента(Отказ)
	
	Если Отказ Тогда    
		Возврат;
	КонецЕсли;
	
	ТекСостояние = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(Ссылка);
	СостоянияПроведения = Новый Массив;
	СостоянияПроведения.Добавить(Перечисления.СостоянияСогласования.Утверждена);
	СостоянияПроведения.Добавить(Перечисления.СостоянияСогласования.НаУтверждении);
	СостоянияПроведения.Добавить(Перечисления.СостоянияСогласования.Отклонена);
	
	Если СостоянияПроведения.Найти(ТекСостояние) = Неопределено Тогда
		ТекСостояние = Перечисления.СостоянияСогласования.Утверждена;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ТекущееСостояниеСогласования", ТекСостояние);
	
	МодульУправленияПроцессамиУХ.ОтправитьНаСогласованиеПриПроведенииДокумента(ЭтотОбъект, Отказ);
	
КонецПроцедуры  

#КонецОбласти  

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли