Процедура ЗаполнитьПоДокументуПланирования(Объект, Источник, ДанныеЗаполнения) Экспорт
	
	Перем Данные, ТаблицаПланыДокумента;
	
	Объект.Требуется.Очистить();
	Объект.ОбеспечитьЗаСчет.Очистить();  
	
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;     
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов") Тогда
		
		Данные = ЗаполнитьПоЗаявкеНаКорректировку(Источник, ДанныеЗаполнения.ВидБюджета);	
		
		ТаблицаЛимитов = КонтрольЛимитовУХ.ПолучитьПревышениеЛимитов(Источник);    
		
		Если Не ТаблицаЛимитов = Неопределено Тогда
			
			ТаблицаЛимитов.Колонки.ПериодичностьКонтроля.Имя = "Периодичность";
			ТаблицаЛимитов.Колонки.НачалоПериодаКонтроля.Имя = "НачалоПериода";
			
			ИменаКолонок = "ВидБюджета, Валюта, НачалоПериода, Периодичность, ЦФО, Проект, ОбъектКонтроля, СтатьяБюджета, "
						 + АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
						 
			СтруктураПоиска = Новый Структура(ИменаКолонок);
			
			Для Каждого СтрокаТаблицыДанные Из Данные Цикл
				
				ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицыДанные);  
				
				МассивСтрок = ТаблицаЛимитов.НайтиСтроки(СтруктураПоиска);  
				
				Если МассивСтрок.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаТаблицыЛимиты = МассивСтрок[0];
				
				Если Не СтрокаТаблицыЛимиты.ЗарезервированоИзменениеПревышениеТекущегоРезерва < 0 Тогда
					Если ЗначениеЗаполнено(СтрокаТаблицыЛимиты.Зарезервировано) 
						И Не СтрокаТаблицыЛимиты.Зарезервировано = СтрокаТаблицыЛимиты.ЗарезервированоСтало Тогда  		
						СтрокаТаблицыЛимиты.Зарезервировано = 0;	// Документ Источник лимита указан		
					КонецЕсли;  						
				КонецЕсли;  
				
				СтрокаТаблицыДанные.Свободно = СтрокаТаблицыЛимиты.Лимит - СтрокаТаблицыЛимиты.Зарезервировано 
												- СтрокаТаблицыЛимиты.Заявлено - СтрокаТаблицыЛимиты.Исполнено;
                			
			КонецЦикла;
						 
		КонецЕсли;  
		
	Иначе

		ПараметрыРезультата = КонтрольЛимитовУХ.ПолучитьПревышениеЛимитовРезервов(Источник); 
		
		Если ПараметрыРезультата = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Данные для корректировки планов и лимитов отсутствуют'");	
		КонецЕсли;
	
		ТаблицаПланыДокумента = ПараметрыРезультата.ТаблицаПланыДокумента;
		
		Если Не ПараметрыРезультата.РезультатыКонтроля = Неопределено Тогда  		 
			
			// КонтрольБюджетныхЛимитов			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ВидКонтроля", ПланыВидовХарактеристик.ВидыКонтроляДокументов.КонтрольБюджетныхЛимитов);
			
			Строки = ПараметрыРезультата.РезультатыКонтроля.НайтиСтроки(СтруктураПоиска);  
			ДанныеКонтрольБюджетныхЛимитов = Неопределено;
			Если Строки.Количество() > 0 Тогда
				ДанныеКонтрольБюджетныхЛимитов = Строки[0].ДанныеКонтроля;
			КонецЕсли; 
						
			ОчищатьРезервирование = ПолучитьПризнакОчисткиРезервов(ДанныеЗаполнения);
			Данные = КонтрольЛимитовУХ.ОбработатьДанныеКонтроля(ДанныеКонтрольБюджетныхЛимитов, ДанныеЗаполнения.ВидБюджета, ОчищатьРезервирование);
			
			// КонтрольБюджетныхРезервов
			КонтрольЛимитовУХ.ДанныеСУчетомБюджетныхРезервов(Данные, ПараметрыРезультата.РезультатыКонтроля);
			
		КонецЕсли; 
		
	КонецЕсли; 

	КонтрольЛимитовУХ.ОчиститьСтрокиСПустымиСуммами(Данные);
	
	Если Не ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") 
		И Не ЗначениеЗаполнено(Данные) Тогда
		ВызватьИсключение НСтр("ru = 'Данные для корректировки планов и лимитов отсутствуют'");	
	КонецЕсли;
	
	Если Данные = Неопределено Тогда
		Возврат;                                                 
	КонецЕсли;   
	
	Для Каждого СтрокаТаблицы Из Данные Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДокументРезерва) Тогда
			СтрокаТаблицы.Сумма 	= 0;
			СтрокаТаблицы.Требуется = 0;  
		Иначе
			СтрокаТаблицы.СуммаРезерв	  = 0;
			СтрокаТаблицы.ТребуетсяРезерв = 0;  
		КонецЕсли;
	
	КонецЦикла;    
	
	Объект.Требуется.Загрузить(Данные);
	Для Каждого Строка Из Объект.Требуется Цикл
		Если Не ЗначениеЗаполнено(Строка.ИдентификаторСтроки) Тогда
			Строка.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;  
	
	Попытка
		СкорректироватьДанныеСУчетомВалютыЛимитирования(Объект, ТаблицаПланыДокумента);   
	Исключение
	КонецПопытки;
	
КонецПроцедуры  

Функция ПолучитьПризнакОчисткиРезервов(ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.Резервирование") Тогда 
		Возврат Ложь;
	ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("ДокументПланирования", ДанныеЗаполнения.ДокументОснование.Метаданные()) 
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование.ДокументПланирования) Тогда
		Возврат Истина;
	ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("ИсточникЛимитовБДДС", ДокументОснование.Метаданные())
		И ЗначениеЗаполнено(ДокументОснование.ИсточникЛимитовБДДС) 
		И ДанныеЗаполнения.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда
		Возврат Истина;
	ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("ИсточникЛимитовБДР", ДокументОснование.Метаданные())
		И ЗначениеЗаполнено(ДокументОснование.ИсточникЛимитовБДР) 
		И ДанныеЗаполнения.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов Тогда
		Возврат Истина;	
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

Процедура СкорректироватьДанныеСУчетомВалютыЛимитирования(Объект, ТаблицаПланыДокумента) 
	
	Если Не ЗначениеЗаполнено(ТаблицаПланыДокумента) Тогда
		Возврат;
	КонецЕсли;  
	
	Если Объект.Требуется.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	ВалютаДокумента = Объект.Требуется[0].Валюта;  
	ВалютаДокументаПланирования = ТаблицаПланыДокумента[0].Валюта;     
	
	Если ВалютаДокумента = ВалютаДокументаПланирования Тогда
		Возврат;
	КонецЕсли;    
	
	Для Каждого СтрокаТабличнойЧасти Из Объект.Требуется Цикл
		
		ПараметрыТекущегоКурса = КонтрольЛимитовУХ.ПолучитьКурсВалютыЛимитирования(СтрокаТабличнойЧасти.Валюта, СтрокаТабличнойЧасти.НачалоПериода);
		ПараметрыНовогоКурса = КонтрольЛимитовУХ.ПолучитьКурсВалютыЛимитирования(ВалютаДокументаПланирования, СтрокаТабличнойЧасти.НачалоПериода);
		КроссКурс = РаботаСКурсамиВалютУХ.ПолучитьКроссКурсВалют(ПараметрыТекущегоКурса, ПараметрыНовогоКурса); 
		
		СтрокаТабличнойЧасти.Валюта = ВалютаДокументаПланирования;
		СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Сумма * КроссКурс.Курс; 
		СтрокаТабличнойЧасти.СуммаРезерв = СтрокаТабличнойЧасти.СуммаРезерв * КроссКурс.Курс;
		СтрокаТабличнойЧасти.Требуется = СтрокаТабличнойЧасти.Требуется * КроссКурс.Курс;
		СтрокаТабличнойЧасти.ТребуетсяРезерв = СтрокаТабличнойЧасти.ТребуетсяРезерв * КроссКурс.Курс;
	
	КонецЦикла;  
	
КонецПроцедуры  
                                     
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	ПланыДокумента(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
	ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, 
						ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокумента");
	
КонецПроцедуры

// Определяет свойства полей формы в зависимости от данных
//
// Параметры:
//	Настройки - ТаблицаЗначений - таблица с колонками:
//		* Поля - Массив - поля, для которых определяются настройки отображения
//		* Условие - ОтборКомпоновкиДанных - условия применения настройки
//		* Свойства - Структура - имена и значения свойств
//
Процедура ЗаполнитьНастройкиПолейФормы(Настройки) Экспорт

	#Область Шапка
		
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("ПредставлениеПериода");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйПериод", Ложь);
	Элемент.Свойства.Вставить("ТолькоПросмотр", Истина);
	Элемент.Свойства.Вставить("АвтоОтметкаНезаполненного", Ложь);
			
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("ЦФО");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйЦФО", Ложь);
	Элемент.Свойства.Вставить("ТолькоПросмотр", Истина);
	Элемент.Свойства.Вставить("АвтоОтметкаНезаполненного", Ложь); 
	
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("Проект");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйПроект", Ложь);
	Элемент.Свойства.Вставить("ТолькоПросмотр", Истина);
	
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("Валюта");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдинаяВалюта", Ложь);
	Элемент.Свойства.Вставить("ТолькоПросмотр", Истина);
	Элемент.Свойства.Вставить("АвтоОтметкаНезаполненного", Ложь);  
	
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("ПриходРасход");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйПриходРасход", Ложь);
	Элемент.Свойства.Вставить("ТолькоПросмотр", Истина);
	Элемент.Свойства.Вставить("АвтоОтметкаНезаполненного", Ложь);
		
	#КонецОбласти
	
	#Область ТабличнаяЧасть
				
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("Требуется.НачалоПериода");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйПериод", Истина);
	Элемент.Свойства.Вставить("Видимость", Ложь);
		
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("Требуется.ЦФО");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйЦФО", Истина);
	Элемент.Свойства.Вставить("Видимость", Ложь);   
	
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("Требуется.Проект");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйПроект", Истина);
	Элемент.Свойства.Вставить("Видимость", Ложь);

	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("Требуется.Валюта");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдинаяВалюта", Истина);
	Элемент.Свойства.Вставить("Видимость", Ложь);
	
	//
	Элемент = Настройки.Добавить();
	Элемент.Поля.Добавить("Требуется.ПриходРасход");
	УправлениеЭлементамиФормы.НовыйОтбор(Элемент.Условие, "ДополнительныеРеквизиты.ЕдиныйПриходРасход", Истина);
	Элемент.Свойства.Вставить("Видимость", Ложь);
		
	#КонецОбласти 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИсточникиДляКонтроляДокумента

Функция ИсточникиДокумента(Объект, ДопПараметры = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект));
	
	Возврат Источники;
	
КонецФункции

Функция Источник_БюджетныеЛимитыРезервы(Объект)
	
	// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			Не ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект);
	Запрос.УстановитьПараметр("ТипЗаявкиНаОбеспечение", Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов")); 
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_ПланыДокумента.ДокументРезервирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА ВТ_ПланыДокумента.ДокументРезервирования
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) = &ТипЗаявкиНаОбеспечение
	|			ТОГДА ВТ_ПланыДокумента.ДокументПланирования
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументПланирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА СУММА(ВТ_ПланыДокумента.Сумма)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Лимит,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_ПланыДокумента.ДокументРезервирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА СУММА(ВТ_ПланыДокумента.Сумма)
	|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) = &ТипЗаявкиНаОбеспечение
	|			ТОГДА СУММА(ВТ_ПланыДокумента.Сумма)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Зарезервировано,
	|	0 КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПланыДокумента.Аналитика6,
	|	ВТ_ПланыДокумента.ДокументПланирования,
	|	ВТ_ПланыДокумента.ДокументРезервирования,
	|	ВТ_ПланыДокумента.Организация,
	|	ВТ_ПланыДокумента.Аналитика1,
	|	ВТ_ПланыДокумента.ВидБюджета,
	|	ВТ_ПланыДокумента.ЦФО,
	|	ВТ_ПланыДокумента.СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика3,
	|	ВТ_ПланыДокумента.Проект,
	|	ВТ_ПланыДокумента.Аналитика5,
	|	ВТ_ПланыДокумента.Период,
	|	ВТ_ПланыДокумента.Валюта,
	|	ВТ_ПланыДокумента.ПриходРасход,
	|	ВТ_ПланыДокумента.Аналитика2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.Выполнить();
	
	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;
	
КонецФункции      

#КонецОбласти 

#Область ПланыДокумента
	
// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;

	// 1. Увеличение лимита, при увеличении резерва
	// 2. Уменьшение лимита, при уменьшении резерва
	// 3. Увеличение резерва (требуется)
	// 4. Уменьшение резерва (за счет)
	// 5. Увеличение лимита
    // 6. Уменьшение лимита 
	// 7. Уменьшение лимита по заявке на корректировку   
	// 8. Уменьшение резерва по заявке на корректировку
    // 9 Уменьшение лимита

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Дата КАК ДатаРегистрации,
	|	&ВидБюджета КАК ВидБюджета,
	|	КорректировкаПлановТребуется.Валюта КАК Валюта,
	|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
	|	КорректировкаПлановТребуется.НачалоПериода КАК Период,
	|	КорректировкаПлановТребуется.ЦФО КАК ЦФО,
	|	КорректировкаПлановТребуется.Проект КАК Проект,
	|	КорректировкаПлановТребуется.ПриходРасход КАК ПриходРасход,
	|	КорректировкаПлановТребуется.СтатьяБюджета КАК СтатьяБюджета,
	|	КорректировкаПлановТребуется.Аналитика1 КАК Аналитика1,
	|	КорректировкаПлановТребуется.Аналитика2 КАК Аналитика2,
	|	КорректировкаПлановТребуется.Аналитика3 КАК Аналитика3,
	|	КорректировкаПлановТребуется.Аналитика4 КАК Аналитика4,
	|	КорректировкаПлановТребуется.Аналитика5 КАК Аналитика5,
	|	КорректировкаПлановТребуется.Аналитика6 КАК Аналитика6,
	|	КорректировкаПлановТребуется.Сумма КАК Сумма,
	|	КорректировкаПлановТребуется.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования
	|ПОМЕСТИТЬ ВТ_Уменьшение
	|ИЗ
	|	Документ.КорректировкаПланов.ОбеспечитьЗаСчет КАК КорректировкаПлановТребуется
	|ГДЕ
	|	КорректировкаПлановТребуется.Ссылка = &Ссылка
	|	И КорректировкаПлановТребуется.Сумма > 0
	|	И КорректировкаПлановТребуется.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийКорректировкаЛимитов.Уменьшение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерЗапроса,
	|	&Дата КАК ДатаРегистрации,
	|	&ВидБюджета КАК ВидБюджета,
	|	КорректировкаПлановТребуется.Валюта КАК Валюта,
	|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
	|	КорректировкаПлановТребуется.НачалоПериода КАК Период,
	|	КорректировкаПлановТребуется.ЦФО КАК ЦФО,
	|	КорректировкаПлановТребуется.Проект КАК Проект,
	|	КорректировкаПлановТребуется.ПриходРасход КАК ПриходРасход,
	|	КорректировкаПлановТребуется.СтатьяБюджета КАК СтатьяБюджета,
	|	КорректировкаПлановТребуется.Аналитика1 КАК Аналитика1,
	|	КорректировкаПлановТребуется.Аналитика2 КАК Аналитика2,
	|	КорректировкаПлановТребуется.Аналитика3 КАК Аналитика3,
	|	КорректировкаПлановТребуется.Аналитика4 КАК Аналитика4,
	|	КорректировкаПлановТребуется.Аналитика5 КАК Аналитика5,
	|	КорректировкаПлановТребуется.Аналитика6 КАК Аналитика6,
	|	КорректировкаПлановТребуется.СуммаРезерв КАК Сумма,
	|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	Документ.КорректировкаПланов.Требуется КАК КорректировкаПлановТребуется
	|ГДЕ
	|	КорректировкаПлановТребуется.Ссылка = &Ссылка
	|	И НЕ КорректировкаПлановТребуется.СуммаРезерв = 0
	|	И НЕ КорректировкаПлановТребуется.ДокументРезерва = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2,
	|	&Дата,
	|	&ВидБюджета,
	|	ОбеспечитьЗаСчет.Валюта,
	|	НЕОПРЕДЕЛЕНО,
	|	ОбеспечитьЗаСчет.НачалоПериода,
	|	ОбеспечитьЗаСчет.ЦФО,
	|	ОбеспечитьЗаСчет.Проект,
	|	ОбеспечитьЗаСчет.ПриходРасход,
	|	ОбеспечитьЗаСчет.СтатьяБюджета,
	|	ОбеспечитьЗаСчет.Аналитика1,
	|	ОбеспечитьЗаСчет.Аналитика2,
	|	ОбеспечитьЗаСчет.Аналитика3,
	|	ОбеспечитьЗаСчет.Аналитика4,
	|	ОбеспечитьЗаСчет.Аналитика5,
	|	ОбеспечитьЗаСчет.Аналитика6,
	|	-ОбеспечитьЗаСчет.Сумма,
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|ИЗ
	|	Документ.КорректировкаПланов.ОбеспечитьЗаСчет КАК ОбеспечитьЗаСчет
	|ГДЕ
	|	ОбеспечитьЗаСчет.Ссылка = &Ссылка
	|	И ОбеспечитьЗаСчет.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийКорректировкаЛимитов.Перенос)
	|	И ОбеспечитьЗаСчет.Сумма <> 0
	|	И НЕ ОбеспечитьЗаСчет.ДокументРезерва = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	3,
	|	&Дата,
	|	&ВидБюджета,
	|	КорректировкаПлановТребуется.Валюта,
	|	КорректировкаПлановТребуется.ДокументРезерва,
	|	КорректировкаПлановТребуется.НачалоПериода,
	|	КорректировкаПлановТребуется.ЦФО,
	|	КорректировкаПлановТребуется.Проект,
	|	КорректировкаПлановТребуется.ПриходРасход,
	|	КорректировкаПлановТребуется.СтатьяБюджета,
	|	КорректировкаПлановТребуется.Аналитика1,
	|	КорректировкаПлановТребуется.Аналитика2,
	|	КорректировкаПлановТребуется.Аналитика3,
	|	КорректировкаПлановТребуется.Аналитика4,
	|	КорректировкаПлановТребуется.Аналитика5,
	|	КорректировкаПлановТребуется.Аналитика6,
	|	КорректировкаПлановТребуется.СуммаРезерв,
	|	КорректировкаПлановТребуется.ДокументРезерва,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|ИЗ
	|	Документ.КорректировкаПланов.Требуется КАК КорректировкаПлановТребуется
	|ГДЕ
	|	КорректировкаПлановТребуется.Ссылка = &Ссылка
	|	И КорректировкаПлановТребуется.СуммаРезерв <> 0
	|	И НЕ КорректировкаПлановТребуется.ДокументРезерва = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	4,
	|	&Дата,
	|	&ВидБюджета,
	|	ОбеспечитьЗаСчет.Валюта,
	|	ОбеспечитьЗаСчет.ДокументРезерва,
	|	ОбеспечитьЗаСчет.НачалоПериода,
	|	ОбеспечитьЗаСчет.ЦФО,
	|	ОбеспечитьЗаСчет.Проект,
	|	ОбеспечитьЗаСчет.ПриходРасход,
	|	ОбеспечитьЗаСчет.СтатьяБюджета,
	|	ОбеспечитьЗаСчет.Аналитика1,
	|	ОбеспечитьЗаСчет.Аналитика2,
	|	ОбеспечитьЗаСчет.Аналитика3,
	|	ОбеспечитьЗаСчет.Аналитика4,
	|	ОбеспечитьЗаСчет.Аналитика5,
	|	ОбеспечитьЗаСчет.Аналитика6,
	|	-ОбеспечитьЗаСчет.Сумма,
	|	ОбеспечитьЗаСчет.ДокументРезерва,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|ИЗ
	|	Документ.КорректировкаПланов.ОбеспечитьЗаСчет КАК ОбеспечитьЗаСчет
	|ГДЕ
	|	ОбеспечитьЗаСчет.Ссылка = &Ссылка
	|	И ОбеспечитьЗаСчет.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийКорректировкаЛимитов.Перенос)
	|	И ОбеспечитьЗаСчет.Сумма <> 0
	|	И НЕ ОбеспечитьЗаСчет.ДокументРезерва = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	5,
	|	&Дата,
	|	&ВидБюджета,
	|	КорректировкаПлановТребуется.Валюта,
	|	НЕОПРЕДЕЛЕНО,
	|	КорректировкаПлановТребуется.НачалоПериода,
	|	КорректировкаПлановТребуется.ЦФО,
	|	КорректировкаПлановТребуется.Проект,
	|	КорректировкаПлановТребуется.ПриходРасход,
	|	КорректировкаПлановТребуется.СтатьяБюджета,
	|	КорректировкаПлановТребуется.Аналитика1,
	|	КорректировкаПлановТребуется.Аналитика2,
	|	КорректировкаПлановТребуется.Аналитика3,
	|	КорректировкаПлановТребуется.Аналитика4,
	|	КорректировкаПлановТребуется.Аналитика5,
	|	КорректировкаПлановТребуется.Аналитика6,
	|	КорректировкаПлановТребуется.Сумма - ЕСТЬNULL(ВТ_Уменьшение.Сумма, 0),
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|ИЗ
	|	Документ.КорректировкаПланов.Требуется КАК КорректировкаПлановТребуется
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Уменьшение КАК ВТ_Уменьшение
	|		ПО КорректировкаПлановТребуется.ИдентификаторСтроки = ВТ_Уменьшение.ИдентификаторСтроки
	|ГДЕ
	|	КорректировкаПлановТребуется.Ссылка = &Ссылка
	|	И КорректировкаПлановТребуется.Сумма - ЕСТЬNULL(ВТ_Уменьшение.Сумма, 0) > 0
	|	И КорректировкаПлановТребуется.ДокументРезерва = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	6,
	|	&Дата,
	|	&ВидБюджета,
	|	ОбеспечитьЗаСчет.Валюта,
	|	НЕОПРЕДЕЛЕНО,
	|	ОбеспечитьЗаСчет.НачалоПериода,
	|	ОбеспечитьЗаСчет.ЦФО,
	|	ОбеспечитьЗаСчет.Проект,
	|	ОбеспечитьЗаСчет.ПриходРасход,
	|	ОбеспечитьЗаСчет.СтатьяБюджета,
	|	ОбеспечитьЗаСчет.Аналитика1,
	|	ОбеспечитьЗаСчет.Аналитика2,
	|	ОбеспечитьЗаСчет.Аналитика3,
	|	ОбеспечитьЗаСчет.Аналитика4,
	|	ОбеспечитьЗаСчет.Аналитика5,
	|	ОбеспечитьЗаСчет.Аналитика6,
	|	-ОбеспечитьЗаСчет.Сумма,
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|ИЗ
