	ИменаРеквизитов = "Дата, ВидБюджета, ДокументОснование";

	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, ИменаРеквизитов);
	Иначе
		Реквизиты = Источник;  
		
		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		РеквизитыТабличнойЧасти = "Сумма, ПриходРасход, Валюта, НачалоПериода, Периодичность, ЦФО, Проект, Организация, 
								|ОбъектКонтроля, СтатьяБюджета, ИдентификаторСтроки,ДокументРезерва,"
								+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
		ОбеспечитьЗаСчет = Источник.ОбеспечитьЗаСчет.Выгрузить(, РеквизитыТабличнойЧасти + ",ВидОперации");
		ОбеспечитьЗаСчет.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		ОбеспечитьЗаСчет.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Требуется = Источник.Требуется.Выгрузить(, РеквизитыТабличнойЧасти + ",Свободно,СуммаРезерв,ДокументРезерва");
		Требуется.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		Требуется.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("ОбеспечитьЗаСчет", ОбеспечитьЗаСчет);
		Запрос.УстановитьПараметр("Требуется", Требуется);
		Запрос.Текст =
		"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Требуется ИЗ &Требуется КАК Коллекция
		|;
		|ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ОбеспечитьЗаСчет ИЗ &ОбеспечитьЗаСчет КАК Коллекция";
		Запрос.Выполнить();
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.КорректировкаПланов.", "ВТ_");
		
	КонецЕсли;

	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, Реквизиты[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.УстановитьПараметр("ТипЗаявкиНаОбеспечение", Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов")); 
	Запрос.УстановитьПараметр("ДокументОснованиеЗаполнен", ЗначениеЗаполнено(Запрос.Параметры.ДокументОснование));    	
	
	Запрос.Текст = ТекстЗапроса;   
	
	Запрос.Выполнить();	
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ПланыДокумента");
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
