
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия="ЗаписанОбъектТрансляция" Тогда
		
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ИсходныйДокумент.Видимость=Константы.ПодокументнаяТрансляция.Получить();
	Элементы.НаправлениеТрансляции.Видимость=ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом();
	Элементы.ТребуетсяПерезаполнение.Видимость=Константы.КонтролироватьСостояниеДокументаТрансляции.Получить();
	
	//ПодокументнаяТрансляция=Параметры.ПодокументнаяТрансляция;
	
	ПодокументнаяТрансляция=1;
	Элементы.Сценарий.Видимость=Константы.УчетПоСценариям.Получить();
	
	ОбновитьЗапросДинамическогоСписка();
		
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗапросДинамическогоСписка()  
	
	Если Метаданные.Обработки.Найти("УстановкаСоответствияРегистров")=Неопределено Тогда
		
		Если ПодокументнаяТрансляция=1 Тогда
			
			ЭтаФорма.Список.ТекстЗапроса=ТекстЗапросаПодокументнаяУХ();
			
		Иначе
			
			ЭтаФорма.Список.ТекстЗапроса=ТекстЗапросаСводнаяУХ();
			
		КонецЕсли; 
		
	Иначе
		
		Если ПодокументнаяТрансляция=1 Тогда
			
			ЭтаФорма.Список.ТекстЗапроса=ТекстЗапросаПодокументнаяЕХ();
			
		Иначе
			
			ЭтаФорма.Список.ТекстЗапроса=ТекстЗапросаСводнаяЕХ();
			
		КонецЕсли;
			
	КонецЕсли;
	
	Элементы.ИсходныйДокумент.Видимость		= (ПодокументнаяТрансляция=1);
	Элементы.ДатаОтраженияВУчете.Видимость	= Элементы.ИсходныйДокумент.Видимость;
	Элементы.НаправлениеТрансляции.Видимость= НЕ Элементы.ИсходныйДокумент.Видимость;
	Элементы.ПериодОтчета.Видимость			= НЕ Элементы.ИсходныйДокумент.Видимость;
	Элементы.ОсновнаяВалюта.Видимость		= НЕ Элементы.ИсходныйДокумент.Видимость;
	Элементы.НаправлениеТрансляции.Видимость= НЕ Элементы.ИсходныйДокумент.Видимость;
	Элементы.ОтборТипыДокументов.Видимость  = Элементы.ИсходныйДокумент.Видимость;
	
	УстановитьОтборПоТипамДокументов();
			
КонецПроцедуры // ОбновитьЗапросДинамическогоСписка() 



&НаСервере
Функция ТекстЗапросаСводнаяЕХ()
	
	Возврат "ВЫБРАТЬ
	        |	ДокументТрансляция.Ссылка КАК Ссылка,
	        |	ДокументТрансляция.Номер КАК Номер,
	        |	ДокументТрансляция.Дата КАК Дата,
	        |	ДокументТрансляция.ПериодОтчета КАК ПериодОтчета,
	        |	ДокументТрансляция.Сценарий КАК Сценарий,
	        |	ДокументТрансляция.ОсновнаяВалюта КАК ОсновнаяВалюта,
	        |	ДокументТрансляция.Организация КАК Организация,
	        |	ДокументТрансляция.ШаблонКорректировки КАК ШаблонКорректировки,
	        |	ДокументТрансляция.ПланСчетов КАК ПланСчетов,
	        |	ДокументТрансляция.ПланСчетовИсточник КАК ПланСчетовИсточник,
	        |	ДокументТрансляция.ИспользуемаяИБ КАК ИспользуемаяИБ,
	        |	ДокументТрансляция.ДатаОтраженияВУчете КАК ДатаОтраженияВУчете,
	        |	ДокументТрансляция.НаправлениеТрансляции КАК НаправлениеТрансляции,
	        |	ДокументТрансляция.ИсходныйДокумент КАК ИсходныйДокумент,
	        |	ДокументТрансляция.Сторнирование КАК Сторнирование,
	        |	ЕСТЬNULL(СведенияОбИзмененииДокументов.ДатаИзменения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаИзменения,
	        |	ЕСТЬNULL(СведенияОбИзмененииДокументов.ПоследнийРедактировавший, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК ПоследнийРедактировавший,
	        |	ВЫБОР
	        |		КОГДА ДокументТрансляция.Проведен
	        |			ТОГДА 0
	        |		КОГДА ДокументТрансляция.ПометкаУдаления
	        |			ТОГДА 1
	        |		ИНАЧЕ 2
	        |	КОНЕЦ КАК ФлагОбработки,
	        |	ЕСТЬNULL(ДокументыСводнойТрансляции.ЕстьРасхождения, ЛОЖЬ) КАК ЕстьРасхождения,
	        |	ЕСТЬNULL(ДокументыСводнойТрансляции.ИзмененыИсходныеДанные, ЛОЖЬ)
	        |		ИЛИ ЕСТЬNULL(ДокументыСводнойТрансляции.ИзмененШаблонКорректировки, ЛОЖЬ) КАК ТребуетсяПерезаполнение
	        |ИЗ
	        |	Документ.Трансляция КАК ДокументТрансляция
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыСводнойТрансляции КАК ДокументыСводнойТрансляции
	        |		ПО ДокументТрансляция.Ссылка = ДокументыСводнойТрансляции.ДокументТрансляции
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОбИзмененииДокументов КАК СведенияОбИзмененииДокументов
	        |		ПО (СведенияОбИзмененииДокументов.Объект = ДокументТрансляция.Ссылка)
	        |ГДЕ
	        |	ДокументТрансляция.ИсходныйДокумент = НЕОПРЕДЕЛЕНО";	
	
КонецФункции // ТекстЗапросаСводнаяЕХ() 

