&НаКлиенте
Процедура ОповеститьПоставщикаОРешении(Команда)
	Если Модифицированность Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Необходимо записать документ перед отправкой оповещения.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АнкетаПоставщика) 
		И ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(Объект.АнкетаПоставщика,"АдресЭП") = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Необходимо заполнить адрес в анкете поставщика.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.АнкетаПоставщика)  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Необходимо заполнить анкету поставщика.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.РешениеПоДокументу)  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Необходимо принять решение по аккредитации.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Документ",Объект.Ссылка); 
	ПараметрыФормы.Вставить("АдресЭП",ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(Объект.АнкетаПоставщика,"АдресЭП"));
	ПараметрыФормы.Вставить("Пользователь",ОбщегоНазначенияУХ.ТекущийПользователь());
	ОткрытьФорму("РегистрСведений.ИсторияОповещенияВнешнегоПользователя.Форма.ФормаОтправки",ПараметрыФормы);
КонецПроцедуры

