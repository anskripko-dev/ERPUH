Функция Старый_ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц) Экспорт
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", МенеджерВременныхтаблиц);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры", Ложь);
	ПараметрыПланирования.Вставить("Этап", Перечисления.ЭтапыПланированияПотребностей.ВыбранПоставщик);
	ПараметрыПланирования.Вставить("ДокументПланирования", Объект.Ссылка);
	ПараметрыПланирования.Вставить("ОбъектПланирования", ОбъектыПланирования.ПолучитьОбъектПланирования(ПараметрыПланирования.ДокументПланирования));
	ПараметрыПланирования.Вставить("ИзменениеПоставки", Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Этап", ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	Запрос.УстановитьПараметр("СтатьяБюджета", Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику);
	
	ТипОбъекта = ТипЗнч(Объект);

	Запросы = Новый Массив;     
	ВнеПлановойПотребности = Ложь;
	Запрос.УстановитьПараметр("ВнеПлановойПотребности", ВнеПлановойПотребности);
	Запрос.УстановитьПараметр("ВидБюджета",ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	Если ТИПЗНЧ(Объект) = Тип("ДанныеФормыСтруктура") 
		Тогда 
		Запрос.УстановитьПараметр("ссылка",Объект.Ссылка); 
		Запрос.УстановитьПараметр("Дата",Объект.Дата-1);
		
	Иначе
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка); 
		Запрос.УстановитьПараметр("Дата",Объект.Дата);

	КонецЕсли;       

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Победитель", Истина);
   	НайденныеСтроки = Объект.ПредложенияПобедителей.НайтиСтроки(СтруктураПоиска);
	МассивПобедителей = Новый Массив;
	Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
		МассивПобедителей.Добавить(ТекНайденныеСтроки.ПредложениеПоставщика);
	КонецЦикла;
	Запрос.УстановитьПараметр("ПредложенияПобедителей", МассивПобедителей);		
	Запросы.Добавить(
	"ВЫБРАТЬ
	|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот КАК Лот,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ КоличествоПобедителейПоЛотам
	|ИЗ
	|	Документ.ПротоколВыбораПобедителей.ПредложенияПобедителей КАК ПротоколВыбораПобедителейПредложенияПобедителей
	|ГДЕ
	|	ПротоколВыбораПобедителейПредложенияПобедителей.Ссылка = &Ссылка
	|	И ПротоколВыбораПобедителейПредложенияПобедителей.Победитель = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	&Этап КАК Этап,
	|	&ОбъектПланирования КАК ОбъектПланирования,
	|	ПотребностиВНоменклатуре.Лот.ВалютаДокумента КАК Валюта,
	|	&ВидБюджета КАК ВидБюджета,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПотребностиВНоменклатуре.Номенклатура) <> ТИП(Справочник.ТоварныеКатегории)
	|			ТОГДА ПотребностиВНоменклатуре.Цена * ПланированиеПотребностейОстатки.КоличествоОстаток
	|		ИНАЧЕ ПотребностиВНоменклатуре.Сумма
	|	КОНЕЦ КАК Сумма,
	|	ПотребностиВНоменклатуре.Цена КАК Цена,
	|	ПотребностиВНоменклатуре.Лот КАК Лот,
	|	ПотребностиВНоменклатуре.Приоритет КАК Приоритет,
	|	ПотребностиВНоменклатуре.Номенклатура КАК Номенклатура,
	|	ПотребностиВНоменклатуре.Характеристика КАК Характеристика,
	|	ПотребностиВНоменклатуре.ПериодПотребности КАК ПериодПотребности,
	|	ПотребностиВНоменклатуре.Организация КАК Организация,
	|	ПотребностиВНоменклатуре.МестоПоставки КАК МестоПоставки,
	|	ПотребностиВНоменклатуре.Проект КАК Проект,
	|	ПотребностиВНоменклатуре.Менеджер КАК Менеджер,
	|	ПотребностиВНоменклатуре.ДоговорСПокупателем КАК ДоговорСПокупателем,
	|	ПотребностиВНоменклатуре.ПредложениеПоставщика КАК ПредложениеПоставщика,
	|	ПотребностиВНоменклатуре.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПотребностиВНоменклатуре.Коэффициент КАК Коэффициент,
	|	ПланированиеПотребностейОстатки.КоличествоОстаток КАК Количество,
	|	ПотребностиВНоменклатуре.СтавкаНДС КАК СтавкаНДС,
	|	ПотребностиВНоменклатуре.СуммаНДС КАК СуммаНДС,
	|	ПотребностиВНоменклатуре.СуммаСНДС КАК СуммаСНДС,
	|	ПотребностиВНоменклатуре.СтраныПроисхождения КАК СтраныПроисхождения,
	|	ПотребностиВНоменклатуре.СтранаПроизводителя КАК СтранаПроизводителя,
	|	ПотребностиВНоменклатуре.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	ПланированиеПотребностейОстатки.АналитикаИсточника КАК АналитикаИсточника,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования КАК АналитикаПланирования,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.ДатаОперации КАК ДатаОперации,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.УсловиеОплаты КАК УсловиеОплаты,
	|	ПотребностиВНоменклатуре.ПредложениеПоставщика.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ВТ_ПотребностиВНоменклатуре
	|ИЗ
	|	Документ.ПротоколВыбораПобедителей.РаспределениеПоПотребностям КАК ПотребностиВНоменклатуре
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей.Остатки(&Дата, ) КАК ПланированиеПотребностейОстатки
	|		ПО ПотребностиВНоменклатуре.Лот = ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект
	|			И ПотребностиВНоменклатуре.Номенклатура = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура
	|			И ПотребностиВНоменклатуре.Характеристика = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Характеристика
	|			И ПотребностиВНоменклатуре.ЕдиницаИзмерения = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения
	|			И ПотребностиВНоменклатуре.Коэффициент = ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент
	|			И (ПотребностиВНоменклатуре.ПериодПотребности.ДатаНачала = НАЧАЛОПЕРИОДА(ПланированиеПотребностейОстатки.АналитикаПланирования.ДатаОперации, МЕСЯЦ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоПобедителейПоЛотам КАК КоличествоПобедителейПоЛотам
	|		ПО ПотребностиВНоменклатуре.Лот = КоличествоПобедителейПоЛотам.Лот
	|ГДЕ
	|	ПотребностиВНоменклатуре.Ссылка = &Ссылка
	|	И НЕ &ВнеПлановойПотребности
	|	И (ПотребностиВНоменклатуре.Лот.ВидЗакупки <> ЗНАЧЕНИЕ(Перечисление.ВидЛотовойЗакупки.ЛотоваяЗакупка)
	|				И ПотребностиВНоменклатуре.ПобедительПоПозиционномуРаспределению = ИСТИНА
	|			ИЛИ КоличествоПобедителейПоЛотам.Количество = 1)
	|	И ПотребностиВНоменклатуре.ПредложениеПоставщика В(&ПредложенияПобедителей)");
	

	Запросы.Добавить(
	"ВЫБРАТЬ
	|	ПотребностиВНоменклатуре.НомерСтроки КАК НомерСтроки,
	|	&Этап КАК Этап,
	|	&ОбъектПланирования КАК ОбъектПланирования,
	|	&ВидБюджета КАК ВидБюджета,
	|	ПотребностиВНоменклатуре.ДатаОперации КАК ДатаОперации,
	|	ПотребностиВНоменклатуре.Номенклатура КАК Номенклатура,
	|	ПотребностиВНоменклатуре.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	ПотребностиВНоменклатуре.Характеристика КАК Характеристика,
	|	ПотребностиВНоменклатуре.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПотребностиВНоменклатуре.Коэффициент КАК Коэффициент,
	|	ПотребностиВНоменклатуре.Валюта КАК Валюта,
	|	ПотребностиВНоменклатуре.УсловиеОплаты КАК УсловиеОплаты,
	|	ПотребностиВНоменклатуре.Количество КАК Количество,
	|	ПотребностиВНоменклатуре.Сумма КАК Сумма,
	|	ПотребностиВНоменклатуре.Цена КАК Цена,
	|	ПотребностиВНоменклатуре.СтавкаНДС КАК СтавкаНДС,
	|	ПотребностиВНоменклатуре.СтраныПроисхождения КАК СтранаПроисхождения,
	|	ПотребностиВНоменклатуре.СтранаПроизводителя КАК СтранаПроизводителя,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|	ПотребностиВНоменклатуре.Контрагент КАК Поставщик,
	|	ПотребностиВНоменклатуре.АналитикаПланирования КАК АналитикаПредыдущегоЭтапа,
	|	ПотребностиВНоменклатуре.АналитикаИсточника КАК АналитикаИсточника
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДляОбработки
	|ИЗ
	|	ВТ_ПотребностиВНоменклатуре КАК ПотребностиВНоменклатуре
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПотребностиВНоменклатуре");
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());    
	Запрос.УстановитьПараметр("ВидБюджета",ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	
	Запрос.Выполнить();
	 //УНИЧТОЖИТЬ ВТ_ПотребностиДобавленныеВручную
	Возврат ПараметрыПланирования;
	
