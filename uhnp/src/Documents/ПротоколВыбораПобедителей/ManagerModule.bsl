	ПечатнаяФорма.ОтображатьЗаголовки = Ложь;
	ПечатнаяФорма.ОтображатьСетку = Ложь;
	ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ПечатнаяФорма.АвтоМасштаб = Истина;
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапрос(Запрос, ДокументСсылка);  
	
		
	ПараметрыПланирования = ПодготовитьПараметрыПланированияПотребностей(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
	ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений;        
	//КонтролироватьЗакупкиПоЛимитам = Константы.КонтролироватьЗакупкиПоЛимитам.Получить();
	//Если ПараметрыПланирования.Свойство("ОтражатьВБюджетах") Тогда
	//	ПараметрыПланирования.ОтражатьВБюджетах = КонтролироватьЗакупкиПоЛимитам;
	//КонецЕсли;	
	
	ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры,,ПараметрыПланирования);//КонтролироватьЗакупкиПоЛимитам,ПараметрыПланирования);
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
