&НаСервере
Процедура ПерезаполнитьПоЛотуНаСервере(Лот);
 
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоЛоту(Лот, Истина);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	//ЦентрализованныеЗакупкиУХ.ОбновитьКроссТаблицуПотребностей(ЭтаФорма, ЭтаФорма.ПараметрыКроссТаблицыПотребностей);
	ВыборОбъектовВызовСервераУХ.РестартПроцессаВыбора(Лот);
	флОбновлятьТаблицуПредложений = Истина;
	Документы.ПротоколВыбораПобедителей.ОбновитьПредложенияПобедителейПоЛоту(
		Объект.ЗакупочнаяПроцедура, Лот, Объект.ПредложенияПобедителей, Объект.Ссылка);
    ЗагрузитьТаблицуПредложений();
	ЗаполнитьТаблицуПредложенийПобедителейПоЛоту(Лот);
	Модифицированность = Истина;
	ОбновитьТаблицуПредложенийПобедителей();
	//ЗаполнитьНастройкуЗонтичнойЗакупки();
	ЗаполнитьСуммыПоЛоту(); 
	ЗаполнитьСтатусыПоЛоту();
	ЗаполнитьПредложенияФинансовыхУслуг();
	
КонецПроцедуры		

&НаСервере
Процедура ЗаполнитьСуммыПоЛоту()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛотыЗакупки",ЛотыЗакупки.Выгрузить());
	Запрос.УстановитьПараметр("ПотребностиПоПоставщикам",Объект.РаспределениеПоПотребностям.Выгрузить());
	Запрос.УстановитьПараметр("ПредложенияПобедителей",Объект.ПредложенияПобедителей.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛотыЗакупки.Лот КАК Лоты
	               |ПОМЕСТИТЬ ЛотыЗакупки
	               |ИЗ
	               |	&ЛотыЗакупки КАК ЛотыЗакупки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПотребностиПоПоставщикам.Сумма КАК Сумма,
	               |	ПотребностиПоПоставщикам.ПредложениеПоставщика КАК ПредложениеПоставщика,
	               |	ПотребностиПоПоставщикам.Лот КАК Лот
	               |ПОМЕСТИТЬ ПотребностиПоПоставщикам
	               |ИЗ
	               |	&ПотребностиПоПоставщикам КАК ПотребностиПоПоставщикам
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПредложенияПобедителей.ПредложениеПоставщика КАК ПредложениеПоставщика
	               |ПОМЕСТИТЬ ПредложенияПобедителей
	               |ИЗ
	               |	&ПредложенияПобедителей КАК ПредложенияПобедителей
	               |ГДЕ
	               |	ПредложенияПобедителей.Победитель = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ПотребностиПоПоставщикам.Сумма) КАК Сумма,
	               |	ПотребностиПоПоставщикам.Лот КАК Лот
	               |ПОМЕСТИТЬ ПотребностиПоПоставщикамСуммы
	               |ИЗ
	               |	ПотребностиПоПоставщикам КАК ПотребностиПоПоставщикам
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПредложенияПобедителей КАК ПредложенияПобедителей
	               |		ПО (ПредложенияПобедителей.ПредложениеПоставщика = ПотребностиПоПоставщикам.ПредложениеПоставщика)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПотребностиПоПоставщикам.Лот
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛотыЗакупки.Лоты КАК Лот,
	               |	ПотребностиПоПоставщикамСуммы.Сумма КАК СуммаЗакупки
	               |ИЗ
	               |	ЛотыЗакупки КАК ЛотыЗакупки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПотребностиПоПоставщикамСуммы КАК ПотребностиПоПоставщикамСуммы
	               |		ПО ЛотыЗакупки.Лоты = ПотребностиПоПоставщикамСуммы.Лот";
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Для Каждого СтрокаЛота ИЗ ЛотыЗакупки Цикл
			Если СтрокаЛота.Лот = Результат.Лот Тогда
				СтрокаЛота.СуммаЗакупки = Результат.СуммаЗакупки;
				СтрокаЛота.Экономия = СтрокаЛота.СуммаЛота - Результат.СуммаЗакупки;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;	
	Элементы.ЛотыЗакупкиСуммаЛота.ТекстПодвала = ЛотыЗакупки.Итог("СуммаЛота");
	Элементы.ЛотыЗакупкиСуммаЗакупки.ТекстПодвала = ЛотыЗакупки.Итог("СуммаЗакупки");
	Элементы.ЛотыЗакупкиЭкономия.ТекстПодвала = ЛотыЗакупки.Итог("Экономия");
	Элементы.ЛотыЗакупкиСуммаЛота.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
	Элементы.ЛотыЗакупкиСуммаЗакупки.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
	Элементы.ЛотыЗакупкиЭкономия.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСтатусыПоЛоту()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛотыЗакупки",ЛотыЗакупки.Выгрузить());
	Запрос.УстановитьПараметр("ПредложенияПобедителей",Объект.ПредложенияПобедителей.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПредложенияПобедителей.Лот КАК Лот,
	               |	ПредложенияПобедителей.Победитель КАК Победитель
	               |ПОМЕСТИТЬ Предложения
	               |ИЗ
	               |	&ПредложенияПобедителей КАК ПредложенияПобедителей
	               |ГДЕ
	               |	ПредложенияПобедителей.Победитель = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Предложения.Лот КАК Лот
	               |ПОМЕСТИТЬ ПредложенияПобедителей
	               |ИЗ
	               |	Предложения КАК Предложения
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Предложения.Лот
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛотыЗакупки.Лот КАК Лоты
	               |ПОМЕСТИТЬ ЛотыЗакупки
	               |ИЗ
	               |	&ЛотыЗакупки КАК ЛотыЗакупки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОбъектыВыбора.Владелец КАК Лот
	               |ПОМЕСТИТЬ ОбъектВыбора
	               |ИЗ
	               |	РегистрСведений.СостояниеОценкиОбъектов КАК ОбъектыВыбора
	               |ГДЕ
	               |	ОбъектыВыбора.Завершен = Истина
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОбъектыВыбора.Владелец
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛотыЗакупки.Лоты КАК Лот,
	               |	ВЫБОР
	               |		КОГДА ПредложенияПобедителей.Лот ЕСТЬ NULL
	               |			ТОГДА ""Ожидает оценки""
	               |		ИНАЧЕ ""Оценка завершена""
	               |	КОНЕЦ КАК Статус,
	               |	ВЫБОР
	               |		КОГДА ПредложенияПобедителей.Лот ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ПобедителиОпределены,
	               |	ВЫБОР
	               |		КОГДА ОбъектВыбора.Лот ЕСТЬ NULL
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ОжидаетОценки
	               |ИЗ
	               |	ЛотыЗакупки КАК ЛотыЗакупки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПредложенияПобедителей КАК ПредложенияПобедителей
	               |		ПО ЛотыЗакупки.Лоты = ПредложенияПобедителей.Лот
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОбъектВыбора КАК ОбъектВыбора
	               |		ПО ЛотыЗакупки.Лоты = ОбъектВыбора.Лот";
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Для Каждого СтрокаЛота ИЗ ЛотыЗакупки Цикл
			Если СтрокаЛота.Лот = Результат.Лот 
				И СтрокаЛота.Лот.МетодОценкиПредложенийПоставщиков <> ПредопределенноеЗначение("Перечисление.МетодыОценкиПредложенийПоставщиков.ПоКритериям") Тогда
				СтрокаЛота.Статус = Результат.Статус;
				СтрокаЛота.ПобедителиОпределены = Результат.ПобедителиОпределены;
			ИначеЕсли СтрокаЛота.Лот = Результат.Лот Тогда
				ОписаниеСостояния = ВыборОбъектовУХ.ПолучитьСостояниеПроцессаСУчетомПереторжки(СтрокаЛота.Лот);
				Если НЕ ОписаниеСостояния.ПроцессВыбораЗавершен  И Результат.ОжидаетОценки Тогда
					СтрокаЛота.Статус = "Ожидает оценки";
				ИначеЕсли НЕ ОписаниеСостояния.ПроцессВыбораЗавершен И
					ЗначениеЗаполнено(ОписаниеСостояния.ТекущийЭтапВыбора) И НЕ Результат.ОжидаетОценки Тогда
					СтрокаЛота.Статус = "Идет оценка";
				ИначеЕсли ОписаниеСостояния.ПроцессВыбораЗавершен И
					ЗначениеЗаполнено(ОписаниеСостояния.ТекущийЭтапВыбора) Тогда
					СтрокаЛота.Статус = "Оценка завершена"; 
					СтрокаЛота.ПобедителиОпределены = Истина;
				КонецЕсли;					 
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьПредложениямиПоЛотам(Команда)
	ТекДанные = Элементы.ЛотыЗакупки.ТекущиеДанные; 
	ПерезаполнитьПоЛоту = Ложь;
	Если ТекДанные <> Неопределено Тогда
		СтруктураПараметров = Новый Структура("ВыбранноеЗначение", ПерезаполнитьПоЛоту);
		СтруктураПараметров.Вставить("Лот",ТекДанные.Лот);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьПоЛотуПредложения", ЭтотОбъект, СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'По лоту перезаполнится табилца предложений и спецификация по ним. Оценку выбора победителей необходимо повторить. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьИнформацииПоЛоту(Команда)

	Печатнаяформа= ПечатьЛот();
	Печатнаяформа.Показать("Результат работы закупочной комиссии",ПечатнаяФорма);

КонецПроцедуры

&НаСервере
Функция ПечатьЛот()

	ПараметрыЛота = Новый Структура;
	ПараметрыЛота.Вставить("Лот", ТекущийЛот);
	ПечатнаяФорма = Документы.ПротоколВыбораПобедителей.ПечатьИнформациюПоЛоту(ПараметрыЛота,Объект);
	Возврат ПечатнаяФорма;
КонецФункции 	

&НаКлиенте
Процедура ПоказыватьПредложенияПоставщиковНажатие(Элемент)
	Элементы.ПредложенияПоставщиков.Видимость = НЕ Элементы.ПредложенияПоставщиков.Видимость;
КонецПроцедуры

&НаСервере
Функция ПричинаПризнанияЗакупкиНесостоявшейсяНачалоВыбораНаСервере()   
		СписокЗначений = Новый СписокЗначений();
		СписокЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ПричиныПризнанияЗакупкиНесостоявшейся.НеПоданоЗаявок"));
		СписокЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ПричиныПризнанияЗакупкиНесостоявшейся.ОтказаноВДопуске"));
		СписокЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ПричиныПризнанияЗакупкиНесостоявшейся.НеПоданоЦеновогоПредложения"));
		СписокЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ПричиныПризнанияЗакупкиНесостоявшейся.Иная")); 
		Возврат СписокЗначений;
КонецФункции

&НаКлиенте
Процедура ПричинаПризнанияЗакупкиНесостоявшейсяНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	Если ЛотыЗакупки.Количество() > 1 ИЛИ Объект.ПредложенияПобедителей.Количество() > 1  Тогда   
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПричинаПризнанияЗакупкиНесостоявшейсяНачалоВыбораНаСервере();
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентЕдинственныйПоставщикПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(КонтрагентЕдинственныйПоставщик) Тогда
		Объект.ЗаключатьДоговорСПоставщиком = Ложь;     
	Иначе
		УстановитьПобедителяПоИнойЗакупке();
	КонецЕсли;	   
		
КонецПроцедуры

&НаСервере
Процедура УстановитьПобедителяПоИнойЗакупке()
	
	Для Каждого Строка Из Объект.ПредложенияПобедителей Цикл
		Строка.Победитель = Ложь; 
		Если Строка.Поставщик = КонтрагентЕдинственныйПоставщик Тогда
			Строка.Победитель = Истина;
		КонецЕсли;	
	КонецЦикла;
	Для Каждого Строка Из Объект.РаспределениеПоПотребностям Цикл
		Строка.ПобедительПоПозиционномуРаспределению = Ложь;   
		Если Строка.ПредложениеПоставщика.Контрагент = КонтрагентЕдинственныйПоставщик Тогда
			Строка.Победитель = Истина;
		КонецЕсли;	
	КонецЦикла;  

КонецПроцедуры	  

&НаСервере
Процедура ЗаключатьДоговорСПоставщикомПриИзмененииНаСервере()
	
	Для Каждого Строка Из Объект.ПредложенияПобедителей Цикл
		Строка.Победитель = Ложь;
	КонецЦикла;
	Для Каждого Строка Из Объект.РаспределениеПоПотребностям Цикл
		Строка.ПобедительПоПозиционномуРаспределению = Ложь;
	КонецЦикла;  	
	Если Объект.ЗаключатьДоговорСПоставщиком = Истина 
		И НЕ Объект.ПричинаПризнанияЗакупкиНесостоявшейся = ПредопределенноеЗначение("Перечисление.ПричиныПризнанияЗакупкиНесостоявшейся.Иная") Тогда  
		Элементы.КонтрагентЕдинственныйПоставщик.Видимость = Истина;
		Для Каждого Строка Из Объект.ПредложенияПобедителей Цикл
			Строка.Победитель = Истина;
		КонецЦикла;
		Для Каждого Строка Из Объект.РаспределениеПоПотребностям Цикл
			Строка.ПобедительПоПозиционномуРаспределению = Истина;
		КонецЦикла;  
	ИначеЕсли Объект.ЗаключатьДоговорСПоставщиком = Истина 
		И Объект.ПричинаПризнанияЗакупкиНесостоявшейся = ПредопределенноеЗначение("Перечисление.ПричиныПризнанияЗакупкиНесостоявшейся.Иная") Тогда  
        КонтрагентЕдинственныйПоставщик = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		Элементы.КонтрагентЕдинственныйПоставщик.Видимость = Истина;

	Иначе
		Элементы.КонтрагентЕдинственныйПоставщик.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаключатьДоговорСПоставщикомПриИзменении(Элемент)
	ЗаключатьДоговорСПоставщикомПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти
