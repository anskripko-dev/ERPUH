

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//ОПК
	Если Параметры.Ключ.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	//Конец ОПК
	
	СтараяЗакупочнаяПроцедура = Объект.ЗакупочнаяПроцедура;
	УстановитьРеквизитыФормыПоЗакупке();
	ЗакупочнаяПроцедураПриИзмененииНаСервере();
	НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта();
	Элементы.НазначитьПоставщиковНоменклатуреЛота.Доступность = Истина;
	ЗаполнитьПредложенияФинансовыхУслуг();
	
	МодульСогласованияДокументовУХ.ПриСозданииНаСервереОбъект(ЭтаФорма);

	Данные = ПланированиеПотребностей.ПолучитьПланыПоЗаявкеНаЗакупку(Объект.Ссылка);
	//ПланыДокументаБДДС.Загрузить(Данные.БюджетДвиженияДенежныхСредств);
	МодульСогласованияДокументовУХ.ПриСозданииНаСервереОбъект(ЭтаФорма);
	//ОПК
	ЗаполнитьСуммыПоЛоту(); 
	ЗаполнитьСтатусыПоЛоту();
	
	// Разместить элементы
	Размещение = Новый Структура;
	Размещение.Вставить("Страницы", Элементы.Страницы);
	ПланированиеПотребностейФормы.ДобавитьЭлементыФормы(ЭтотОбъект, Размещение);  	
	
	// Контроль документа	
	КонтрольУХ.ПодготовитьФормуНаСервере(ЭтотОбъект, Элементы.Страницы);

	//Конец ОПК 
	Если Элементы.Найти("ПотребностиПоГодамГруппаРеквизитов") <> Неопределено Тогда
		Элементы.ПотребностиПоГодамГруппаРеквизитов.Видимость = Ложь;  
	КонецЕсли;
	Элементы.СтраницаОплаты.Видимость = Ложь; 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	// Создать необходимые реквизиты
	РеквизитыФормы = ФормыУХ.НачатьИзменениеРеквизитовФормы(ЭтотОбъект);
	ПланированиеПотребностейФормы.ДобавитьРеквизитыФормы(ЭтотОбъект, РеквизитыФормы);
	ФормыУХ.ЗавершитьИзменениеРеквизитовФормы(ЭтотОбъект, РеквизитыФормы);
	
КонецПроцедуры   

&НаКлиенте
Процедура ПриОжиданииВыполнитьКонтрольДокумента()
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьКонтрольДокумента", 0.5, Истина);
КонецПроцедуры

//ОПК Конец


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьНазначенияПоставщиковПоСтроке(); 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды        
	
	ОтобразитьВыбранноеПредложениеПоставщика();
	ОтобразитьСостояниеТоргов();
	УстановитьОформлениеФормы();
	//ЗаполнитьНастройкуЗонтичнойЗакупки();
	
	Если Не Объект.Проведен Тогда
		ПриОжиданииВыполнитьКонтрольДокумента();   
	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
