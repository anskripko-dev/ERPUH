#Область ОбработчикиСобытий
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("НаименованиеОтчета");
	Поля.Добавить("ПредставлениеПериода");
	Поля.Добавить("ПредставлениеВида");
	Поля.Добавить("Организация");
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
		
	НаименованиеОтчета = Данные.НаименованиеОтчета + " за " + Данные.ПредставлениеПериода
		+ " (Вид: " + ?(ЗначениеЗаполнено(Данные.ПредставлениеВида), Данные.ПредставлениеВида, "П")
		+ ". Организация: " + Данные.Организация + ")";
	
	Представление = СтрШаблон(НСтр("ru = '%1';
									|en = '%1'"), НаименованиеОтчета);
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры
#КонецОбласти
