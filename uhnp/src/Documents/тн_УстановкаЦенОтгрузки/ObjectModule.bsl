#Область ОбработчикиСобытий
	
// Борисенко Игорь 11.09.2024 Выполнение задач №000050775
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Проверить_ДатаНачалаРасчетаНаценкиЗавода_в_ЕРП(Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 11.09.2024 Выполнение задач №000050775
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения_тн_НаценкаНоменклатурыЗаводаПроизводителя(Отказ);
	
КонецПроцедуры

// Борисенко Игорь 11.09.2024 Выполнение задач №000050775
#КонецОбласти 

