// Борисенко Игорь 11.09.2024 Выполнение задач №000050775
Процедура Проверить_ДатаНачалаРасчетаНаценкиЗавода_в_ЕРП(Отказ)
	
	Если ТипДокумента <> Перечисления.тн_ТипДокументаУстановкаЦенНаценки.РасчетНаценкиЕРП Тогда
		Возврат; //не проверяем
	КонецЕсли;
	
	Организация = РегистрыСведений.тн_СоответствиеОрганизацииЗаводаИПроизводственногоПодразделения.ВернутьОрганизацию(Подразделение);
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = СтрШаблон("Не сопоставлена Организация для Производственного подразделения: %1", Подразделение);
		// НАЧАЛО Борисенко Игорь 15.05.2025 Выполнение задач №000053686
		//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		//Возврат;
		ИмяСобытия = "Закрытие месяца: расчет себестоимости: Формирование Установок цен отгрузки";
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, Метаданные(),,ТекстСообщения + Символы.ПС + ТекстСообщения);

		ВызватьИсключение ТекстСообщения;
		// КОНЕЦ Борисенко Игорь 15.05.2025 Выполнение задач №000053686
	КонецЕсли;
	
	ДатаНачалаРасчетаНаценкиЗавода_в_ЕРП = тн_Интеграция_ERP_УХ_ПовтИсп.ЗначениеДополнительнойНастройкиПоОрганизации(Дата, Организация, "ДатаНачалаРасчетаНаценкиЗавода_в_ЕРП");
	Если Не ЗначениеЗаполнено(ДатаНачалаРасчетаНаценкиЗавода_в_ЕРП) Тогда
		
		ТекстСообщения = СтрШаблон("Не заполнена 'Дата начала расчета наценки завода в ЕРП' для организации: %1", Организация);
		// НАЧАЛО Борисенко Игорь 15.05.2025 Выполнение задач №000053686
		//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		//Возврат;
		ИмяСобытия = "Закрытие месяца: расчет себестоимости: Формирование Установок цен отгрузки";
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, Метаданные(),,ТекстСообщения + Символы.ПС + ТекстСообщения);

		ВызватьИсключение ТекстСообщения;
		// КОНЕЦ Борисенко Игорь 15.05.2025 Выполнение задач №000053686
		
	ИначеЕсли Дата < ДатаНачалаРасчетаНаценкиЗавода_в_ЕРП Тогда
		
		ТекстСообщения = СтрШаблон("Для %1 - Дата  меньше даты начала расчета наценки завода в ЕРП", Ссылка);
		// НАЧАЛО Борисенко Игорь 15.05.2025 Выполнение задач №000053686
		//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		//Возврат;
		ИмяСобытия = "Закрытие месяца: расчет себестоимости: Формирование Установок цен отгрузки";
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, Метаданные(),,ТекстСообщения + Символы.ПС + ТекстСообщения);

		ВызватьИсключение ТекстСообщения;
		// КОНЕЦ Борисенко Игорь 15.05.2025 Выполнение задач №000053686
		
	КонецЕсли;

	Контрагент = тн_Интеграция_ERP_УХ_ПовтИсп.ПолучитьЗначениеКонстанты("КонтрагентОтбораВыручкиСебестоимостиДляСбораНаценкиЗаводов");
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ТекстСообщения = "Не заполнена 'Контрагент отбора выручки себестоимости для сбора наценки заводов'";
		// НАЧАЛО Борисенко Игорь 15.05.2025 Выполнение задач №000053686
		//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		//Возврат;
		ИмяСобытия = "Закрытие месяца: расчет себестоимости: Формирование Установок цен отгрузки";
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, Метаданные(),,ТекстСообщения + Символы.ПС + ТекстСообщения);

		ВызватьИсключение ТекстСообщения;
		// КОНЕЦ Борисенко Игорь 15.05.2025 Выполнение задач №000053686
	КонецЕсли;
	
КонецПроцедуры

// Борисенко Игорь 11.09.2024 Выполнение задач №000050775
Процедура Движения_тн_НаценкаНоменклатурыЗаводаПроизводителя(Отказ)
	
	Движения.тн_НаценкаНоменклатурыЗаводаПроизводителя.Записывать = Истина;
	Движения.тн_НаценкаНоменклатурыЗаводаПроизводителя.Очистить();   
	
	Если ТипДокумента = Перечисления.тн_ТипДокументаУстановкаЦенНаценки.РасчетНаценкиЕРП Тогда

		Организация = РегистрыСведений.тн_СоответствиеОрганизацииЗаводаИПроизводственногоПодразделения.ВернутьОрганизацию(Подразделение);
		Контрагент = тн_Интеграция_ERP_УХ_ПовтИсп.ПолучитьЗначениеКонстанты("КонтрагентОтбораВыручкиСебестоимостиДляСбораНаценкиЗаводов");
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("ПроизводственноеПодразделение", Подразделение);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	&Ссылка КАК Регистратор,
		|	&Дата КАК Период,
		|	Обороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	&ПроизводственноеПодразделение КАК ПроизводственноеПодразделение,
		|	Обороты.СуммаВыручкиБезНДСОборот - Обороты.СтоимостьРеглОборот - Обороты.ДопРасходыРеглОборот - Обороты.ПостатейныеПостоянныеРеглОборот - Обороты.ТрудозатратыРеглОборот - Обороты.ПостатейныеПеременныеРеглОборот КАК ПлановаяВаловаяПрибыль,
		|	Обороты.СуммаВыручкиБезНДСОборот КАК ПлановаяВыручка,
		|	Обороты.КоличествоОборот КАК Количество
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
		|			НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ),
		|			КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ),
		|			,
		|			АналитикаУчетаПоПартнерам.Организация = &Организация
		|				И АналитикаУчетаПоПартнерам.Контрагент = &Контрагент) КАК Обороты";
		
		Движения.тн_НаценкаНоменклатурыЗаводаПроизводителя.Загрузить(Запрос.Выполнить().Выгрузить());
	
	КонецЕсли;
	
КонецПроцедуры

