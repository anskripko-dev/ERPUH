#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий     

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ПроцентОжидаемогоВозвратаДолга = 100;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ПретензииУХ") Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ХодПретензионноИсковойРаботыСрезПоследних.СледующийЭтапПретензии КАК ЭтапПретензии,
			|	ХодПретензионноИсковойРаботыСрезПоследних.СледующийЭтапПретензии.ВероятностьПогашенияПоУмолчанию КАК ПроцентОжидаемогоВозвратаДолга,
			|	ХодПретензионноИсковойРаботыСрезПоследних.ПозицияОрганизации КАК ПозицияОрганизации,
			|	ХодПретензионноИсковойРаботыСрезПоследних.ПозицияКонтрагента КАК ПозицияКонтрагента,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Суд КАК Суд,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Судья КАК Судья,
			|	ХодПретензионноИсковойРаботыСрезПоследних.НомерДела КАК НомерДела,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Ответственный КАК Ответственный,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Претензия КАК Претензия,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Регистратор КАК Регистратор,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Регистратор.Организация КАК Организация,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Регистратор.Контрагент КАК Контрагент,
			|	ХодПретензионноИсковойРаботыСрезПоследних.Регистратор.НеОтражаетсяВ_БДДС КАК НеОтражаетсяВ_БДДС
			|ПОМЕСТИТЬ Исходные
			|ИЗ
			|	РегистрСведений.ХодПретензионноИсковойРаботы.СрезПоследних(&Период, Претензия = &Претензия) КАК ХодПретензионноИсковойРаботыСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Исходные.ЭтапПретензии КАК ЭтапПретензии,
			|	Исходные.ПроцентОжидаемогоВозвратаДолга КАК ПроцентОжидаемогоВозвратаДолга,
			|	Исходные.ПозицияОрганизации КАК ПозицияОрганизации,
			|	Исходные.ПозицияКонтрагента КАК ПозицияКонтрагента,
			|	Исходные.Суд КАК Суд,
			|	Исходные.Судья КАК Судья,
			|	Исходные.НомерДела КАК НомерДела,
			|	Исходные.Ответственный КАК Ответственный,
			|	Исходные.Претензия КАК Претензия,
			|	Исходные.Организация КАК Организация,
			|	Исходные.Контрагент КАК Контрагент,
			|	Исходные.НеОтражаетсяВ_БДДС КАК НеОтражаетсяВ_БДДС
			|ИЗ
			|	Исходные КАК Исходные
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ИзменениеПретензииРасшифровка.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|	ИзменениеПретензииРасшифровка.ДокументОснование КАК ДокументОснование,
			|	ИзменениеПретензииРасшифровка.ОбъектРасчетов КАК ОбъектРасчетов,
			|	ИзменениеПретензииРасшифровка.Сумма КАК Сумма,
			|	ИзменениеПретензииРасшифровка.Валюта КАК Валюта,
			|	ИзменениеПретензииРасшифровка.Пени КАК Пени,
			|	ИзменениеПретензииРасшифровка.Штраф КАК Штраф,
			|	ИзменениеПретензииРасшифровка.Всего КАК Всего,
			|	ИзменениеПретензииРасшифровка.ДнейПросрочки КАК ДнейПросрочки,
			|	ИзменениеПретензииРасшифровка.Итого КАК Итого
			|ИЗ
			|	Документ.ИзменениеПретензии.РасшифровкаПредметаСпора КАК ИзменениеПретензииРасшифровка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Исходные КАК Исходные
			|		ПО ИзменениеПретензииРасшифровка.Ссылка = Исходные.Регистратор";
		
		Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("Претензия", ДанныеЗаполнения);
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаДетальныеЗаписи);
			РасшифровкаПредметаСпора.Загрузить(РезультатыЗапроса[2].Выгрузить());
		Иначе
			Претензия = ДанныеЗаполнения;
			Организация = ДанныеЗаполнения.Организация;
			Контрагент = ДанныеЗаполнения.Контрагент;			
		КонецЕсли;
	
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Лоты") Тогда
		
		НеОтражаетсяВ_БДДС = Истина;
		ЭтапПретензии = Справочники.ЭтапыПретензионноИсковойРаботы.Начальная;
		Организация = ДанныеЗаполнения.Владелец.ОрганизаторЗакупки;
		
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОтражениеФактическихДанныхБюджетирования")  Тогда
		Контрагент = ДанныеЗаполнения.Контрагент;
		Организация = ДанныеЗаполнения.Организация;
		 
		Если ДанныеЗаполнения.НаправлениеВзаиморасчетов = Перечисления.НаправлениеДвиженияВзаиморасчетов.УвеличениеЗадолженности Тогда
			ДополнительныеСвойства.Вставить("ТипПретензии", Перечисления.ТипыПретензий.Исходящая);
		Иначе
			ДополнительныеСвойства.Вставить("ТипПретензии", Перечисления.ТипыПретензий.Входящая);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РасчетыСКонтрагентамиПоДокументамОстатки.ДокументРасчетов КАК ДокументОснование,
			|	РасчетыСКонтрагентамиПоДокументамОстатки.СуммаОстаток КАК Сумма,
			|	РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|	РасчетыСКонтрагентамиПоДокументамОстатки.СуммаОстаток * РАЗНОСТЬДАТ(ЕСТЬNULL(СрокиЗакрытияЗадолженностиПоДокументам.Дата, ДАТАВРЕМЯ(1, 1, 1)), &ТекущаяДата, ДЕНЬ) * ВЫБОР
			|		КОГДА РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.ПериодРасчетаПени = ЗНАЧЕНИЕ(Перечисление.Периодичность.День)
			|			ТОГДА РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.СтавкаПени / 100
			|		КОГДА РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.ПериодРасчетаПени = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.СтавкаПени / 100 / 30
			|		КОГДА РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.ПериодРасчетаПени = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.СтавкаПени / 100 / 360
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Пени,
			|	РасчетыСКонтрагентамиПоДокументамОстатки.ОбъектРасчетов,
			|	РАЗНОСТЬДАТ(ЕСТЬNULL(СрокиЗакрытияЗадолженностиПоДокументам.Дата, ДАТАВРЕМЯ(1, 1, 1)), &ТекущаяДата, ДЕНЬ) КАК ДнейПросрочки,
			|	РасчетыСКонтрагентамиПоДокументамОстатки.ДокументРасчетов.ВалютаДокумента КАК Валюта
			|ПОМЕСТИТЬ Расчет
			|ИЗ
			|	РегистрНакопления.РасчетыСКонтрагентамиПоДокументам.Остатки(&ТекущаяДата, ДокументРасчетов = &ДокументРасчетов) КАК РасчетыСКонтрагентамиПоДокументамОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиЗакрытияЗадолженностиПоДокументам КАК СрокиЗакрытияЗадолженностиПоДокументам
			|		ПО РасчетыСКонтрагентамиПоДокументамОстатки.ДокументРасчетов = СрокиЗакрытияЗадолженностиПоДокументам.Документ
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИзменениеПретензии.РасшифровкаПредметаСпора КАК ИзменениеПретензииРасшифровкаПредметаСпора
			|		ПО РасчетыСКонтрагентамиПоДокументамОстатки.ДокументРасчетов = ИзменениеПретензииРасшифровкаПредметаСпора.ДокументОснование
			|			И РасчетыСКонтрагентамиПоДокументамОстатки.ДоговорКонтрагента.СтатьяДвиженияДенежныхСредств = ИзменениеПретензииРасшифровкаПредметаСпора.СтатьяДвиженияДенежныхСредств
			|			И (ИзменениеПретензииРасшифровкаПредметаСпора.Ссылка.Проведен)
			|			И РасчетыСКонтрагентамиПоДокументамОстатки.ОбъектРасчетов = ИзменениеПретензииРасшифровкаПредметаСпора.ОбъектРасчетов,
			|	Константа.КоличествоДнейПросрочкиПоПлатежамДляФормированияПретензий КАК КоличествоДнейПросрочкиПоПлатежамДляФормированияПретензий
			|ГДЕ
			|	ИзменениеПретензииРасшифровкаПредметаСпора.Ссылка ЕСТЬ NULL 
			|	И ЕСТЬNULL(СрокиЗакрытияЗадолженностиПоДокументам.Дата, ДАТАВРЕМЯ(1, 1, 1)) < ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, КоличествоДнейПросрочкиПоПлатежамДляФормированияПретензий.Значение)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Расчет.СтатьяДвиженияДенежныхСредств,
			|	Расчет.ДокументОснование,
			|	Расчет.ОбъектРасчетов,
			|	СУММА(Расчет.Сумма) КАК Сумма,
			|	Расчет.Валюта,
			|	Расчет.ДнейПросрочки,
			|	СУММА(Расчет.Пени) КАК Пени,
			|	СУММА(Расчет.Сумма + Расчет.Пени) КАК Всего,
			|	СУММА(Расчет.Сумма + Расчет.Пени) КАК Итого
			|ИЗ
			|	Расчет КАК Расчет
			|
			|СГРУППИРОВАТЬ ПО
			|	Расчет.ДокументОснование,
			|	Расчет.СтатьяДвиженияДенежныхСредств,
			|	Расчет.ОбъектРасчетов,
			|	Расчет.Валюта,
			|	Расчет.ДнейПросрочки";
		
		Запрос.УстановитьПараметр("ТекущаяДата", ?(ЗначениеЗаполнено(Дата), КонецДня(Дата), КонецДня(ТекущаяДатаСеанса())));
		Запрос.УстановитьПараметр("ДокументРасчетов", ДанныеЗаполнения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		РасшифровкаПредметаСпора.Очистить();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НоваяСтрока = РасшифровкаПредметаСпора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		КонецЦикла;
		Сумма = РасшифровкаПредметаСпора.Итог("Итого");
	ИначеЕсли Не ДанныеЗаполнения = Неопределено 
		И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда
		
		НеОтражаетсяВ_БДДС = Истина;
		МетаданныеДокумента = ДанныеЗаполнения.Метаданные();
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеДокумента) Тогда
			Контрагент = ДанныеЗаполнения.Контрагент;
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", МетаданныеДокумента) Тогда
			Организация = ДанныеЗаполнения.Организация;
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВалютаДокумента", МетаданныеДокумента) Тогда
			Валюта = ДанныеЗаполнения.ВалютаДокумента;
		ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("Валюта", МетаданныеДокумента) Тогда
			Валюта = ДанныеЗаполнения.Валюта;
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаДокумента", МетаданныеДокумента) Тогда
			Сумма = ДанныеЗаполнения.СуммаДокумента;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда   
		  
		Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Организация") = Неопределено Тогда
			Организация = ДанныеЗаполнения.Организация;
		КонецЕсли;

		Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Контрагент") = Неопределено Тогда
			Контрагент = ДанныеЗаполнения.Контрагент;
		КонецЕсли;
		
		Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Договор") = Неопределено Тогда
			Договор = ДанныеЗаполнения.Договор;
		КонецЕсли;   		
		
		Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "РасшифровкаПредметаСпора") = Неопределено Тогда
			
			НоваяСтрока = РасшифровкаПредметаСпора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения.РасшифровкаПредметаСпора); 
			
			ОбъектРасчетов = ДанныеЗаполнения.РасшифровкаПредметаСпора.ОбъектРасчетов;
			Если ТипЗнч(ОбъектРасчетов) = Тип("СправочникСсылка.ОбъектыРасчетов") Тогда
				НоваяСтрока.ОбъектРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектРасчетов, "Объект");  			
			КонецЕсли;
			
			НоваяСтрока.Всего = НоваяСтрока.Сумма + НоваяСтрока.Пени + НоваяСтрока.Штраф;
            НоваяСтрока.Итого = НоваяСтрока.Всего;
			
		КонецЕсли;  
		
		Ответственный = Пользователи.ТекущийПользователь();
		
	КонецЕсли;  

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НеОтражаетсяВ_БДДС Тогда
		Если ПроверяемыеРеквизиты.Найти("ОжидаемаяДата") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ОжидаемаяДата"));
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ДополнительныеСвойства.Вставить("ЭтоНовый", 	ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", 	РежимЗаписи);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСерверУХ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.ИзменениеПретензии.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);

	ПроведениеСерверУХ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	ПроведениеСерверУХ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПретензионноИсковаяРабота.ОтразитьВерсииГрафиковРасчетов(ДополнительныеСвойства, Движения, Отказ);	
	ПретензионноИсковаяРабота.ОтразитьХодПретензионноИсковойРаботы(ДополнительныеСвойства, Движения, Отказ);
	ПретензионноИсковаяРабота.ОтразитьРасчетыСКонтрагентамиГрафики(ДополнительныеСвойства, Движения, Отказ);
	
	ПроведениеСерверУХ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	ПроведениеСерверУХ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

