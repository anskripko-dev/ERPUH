#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	// реквизиты документа.
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);

	ТекстыЗапроса = Новый СписокЗначений;
	ДобавитьТекстЗапросаХодПретензионноИсковойРаботы(ТекстыЗапроса); 
	ДобавитьТекстЗапросаВерсииГрафиковРасчетов(ТекстыЗапроса);
	ДобавитьТекстЗапросаРасчетыСКонтрагентамиГрафики(ТекстыЗапроса);
		
	ПроведениеСерверУХ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры
#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзменениеПретензии.Ссылка КАК Ссылка,
		|	ИзменениеПретензии.Дата КАК Дата,
		|	ИзменениеПретензии.Претензия КАК Претензия,
		|	ИзменениеПретензии.Организация КАК Организация,
		|	ИзменениеПретензии.Контрагент КАК Контрагент,
		|	ИзменениеПретензии.ЭтапПретензии КАК ЭтапПретензии,
		|	ИзменениеПретензии.ПозицияОрганизации КАК ПозицияОрганизации,
		|	ИзменениеПретензии.ПозицияКонтрагента КАК ПозицияКонтрагента,
		|	ИзменениеПретензии.Суд КАК Суд,
		|	ИзменениеПретензии.Судья КАК Судья,
		|	ИзменениеПретензии.НомерДела КАК НомерДела,
		|	ИзменениеПретензии.Сумма КАК Сумма,
		|	ИзменениеПретензии.ПроцентОжидаемогоВозвратаДолга КАК ПроцентОжидаемогоВозвратаДолга,
		|	ИзменениеПретензии.Комментарий КАК Комментарий,
		|	ИзменениеПретензии.Ответственный КАК Ответственный,
		|	ИзменениеПретензии.Валюта КАК Валюта,
		|	ИзменениеПретензии.СуммаШтрафа КАК СуммаШтрафа,
		|	ИзменениеПретензии.ОжидаемаяДатаИзмененияЭтапа КАК ОжидаемаяДатаИзмененияЭтапа,
		|	ИзменениеПретензии.ПричинаЗакрытия КАК ПричинаЗакрытия,
		|	ИзменениеПретензии.СледующийЭтапПретензии КАК СледующийЭтапПретензии,
		|	ИзменениеПретензии.НеОтражаетсяВ_БДДС КАК НеОтражаетсяВ_БДДС,
		|	ИзменениеПретензии.МоментВремени КАК МоментВремени
		|ИЗ
		|	Документ.ИзменениеПретензии КАК ИзменениеПретензии
		|ГДЕ
		|	ИзменениеПретензии.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
		
	Для Каждого ТекРеквизит Из Реквизиты Цикл
		Запрос.УстановитьПараметр(ТекРеквизит.Ключ, ТекРеквизит.Значение);
	КонецЦикла;     
	
	Запрос.УстановитьПараметр("ПериодГраница", 		Новый Граница(Реквизиты.МоментВремени, ВидГраницы.Исключая));
	
КонецПроцедуры

Процедура ДобавитьТекстЗапросаХодПретензионноИсковойРаботы(ТекстыЗапроса)
	
	ИмяРегистра = "ХодПретензионноИсковойРаботы";
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	&Ссылка КАК Ссылка,
		|	&Дата КАК Период,
		|	&Претензия КАК Претензия,
		|	&Организация КАК Организация,
		|	&Контрагент КАК Контрагент,
		|	&ЭтапПретензии КАК ЭтапРаботы,
		|	&ПозицияОрганизации КАК ПозицияОрганизации,
		|	&ПозицияКонтрагента КАК ПозицияКонтрагента,
		|	&Суд КАК Суд,
		|	&Судья КАК Судья,
		|	&НомерДела КАК НомерДела,
		|	&Сумма КАК Сумма,
		|	&ПроцентОжидаемогоВозвратаДолга КАК Вероятность,
		|	&Комментарий КАК Комментарий,
		|	&Валюта КАК Валюта,
		|	&СледующийЭтапПретензии КАК СледующийЭтапПретензии,
		|	&ОжидаемаяДатаИзмененияЭтапа КАК ОжидаемаяДатаИзмененияЭтапа
		|";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

КонецПроцедуры

Процедура ДобавитьТекстЗапросаВерсииГрафиковРасчетов(ТекстыЗапроса)
	
	ИмяРегистра = "ВерсииГрафиковРасчетов";
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Ссылка КАК Ссылка,
	|	&Дата КАК Период,
	|	&Организация КАК Организация,
	|	ИСТИНА КАК ОпорныйГрафик,
	|	ИзменениеПретензииРасшифровкаПредметаСпора.ОбъектРасчетов КАК ПредметГрафика
	|ИЗ
	|	Документ.ИзменениеПретензии.РасшифровкаПредметаСпора КАК ИзменениеПретензииРасшифровкаПредметаСпора
	|ГДЕ
	|	ИзменениеПретензииРасшифровкаПредметаСпора.Ссылка = &Ссылка
	|	И НЕ &НеОтражаетсяВ_БДДС";
 		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

КонецПроцедуры

Процедура ДобавитьТекстЗапросаРасчетыСКонтрагентамиГрафики(ТекстыЗапроса) Экспорт
	

	
	ИмяВременнойТаблицы = "ВТ_Расшифровка";

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Расшифровка.ОбъектРасчетов КАК ПредметГрафика
	               |ПОМЕСТИТЬ ВТ_Расшифровка
	               |ИЗ
	               |	Документ.ИзменениеПретензии.РасшифровкаПредметаСпора КАК Расшифровка
	               |ГДЕ
	               |	Расшифровка.Ссылка = &Ссылка
	               |	И НЕ &НеОтражаетсяВ_БДДС";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяВременнойТаблицы);
	
	ИмяВременнойТаблицы = "ВТ_ТаблицаГрафика";
    ТекстЗапроса = "ВЫБРАТЬ
                   |	ВерсииГрафиковРасчетовСрезПоследних.Регистратор КАК ВерсияГрафика
                   |ПОМЕСТИТЬ ВТ_ТаблицаГрафика
                   |ИЗ
                   |	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(
                   |			&ПериодГраница,
                   |			Организация = &Организация
                   |				И ПредметГрафика В
                   |					(ВЫБРАТЬ
                   |						ВТ_Расшифровка.ПредметГрафика
                   |					ИЗ
                   |						ВТ_Расшифровка)) КАК ВерсииГрафиковРасчетовСрезПоследних";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяВременнойТаблицы);
	
	ИмяРегистра = "РасчетыСКонтрагентамиГрафики";
	ТекстЗапроса ="ВЫБРАТЬ
	              |	&Дата КАК Период,
	              |	ИСТИНА КАК Активность,
	              |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	              |	&Ссылка КАК ВерсияГрафика,
	              |	&Организация КАК Организация,
	              |	&Контрагент КАК Контрагент,
	              |	РасчетыСКонтрагентамиГрафикиЗакрытие.ПредметГрафика КАК ПредметГрафика,
	              |	РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности,
	              |	РасчетыСКонтрагентамиГрафикиЗакрытие.Валюта КАК Валюта,
	              |	РасчетыСКонтрагентамиГрафикиЗакрытие.СуммаОстаток КАК Сумма,
	              |	НЕОПРЕДЕЛЕНО КАК СтатьяБюджета,
	              |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ПриходРасход,
	              |	ВЫБОР
	              |		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг)
	              |			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваОсновнойДолг)
	              |		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Комиссии)
	              |			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваКомиссии)
	              |		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Проценты)
	              |			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваПроценты)
	              |		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Штрафы)
	              |			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваШтрафы)
	              |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	              |	КОНЕЦ КАК Операция
	              |ИЗ
	              |	РегистрНакопления.РасчетыСКонтрагентамиГрафики.Остатки(
	              |			&ПериодГраница,
	              |			ВерсияГрафика В
	              |				(ВЫБРАТЬ
	              |					ВТ_ТаблицаГрафика.ВерсияГрафика
	              |				ИЗ
	              |					ВТ_ТаблицаГрафика)) КАК РасчетыСКонтрагентамиГрафикиЗакрытие";

 		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

КонецПроцедуры


#КонецОбласти

#КонецЕсли
