			  
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
			  
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ОбработкаПолученияПредставленияВерсияСоглашения(Данные, Представление);
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставленияВерсияСоглашения(Данные, Представление) Экспорт
	
	Если Данные.Ссылка.Проведен Тогда
		ШаблонПредставления = НСтр("ru = 'Документация по [ЗакупочнаяПроцедура] (вер. [НомерВерсииДокументации] от [Дата])'");
	Иначе
		ШаблонПредставления = НСтр("ru = 'Документация по [ЗакупочнаяПроцедура] (сохраненный черновик от [Дата])'");
	КонецЕсли;
	Параметры = Новый Структура;
	Параметры.Вставить("ЗакупочнаяПроцедура", Данные.Ссылка.ЗакупочнаяПроцедура);
	Параметры.Вставить("НомерВерсииДокументации", Данные.Ссылка.НомерВерсииДокументации);
	Параметры.Вставить("Дата", Формат(Данные.Дата, "ДЛФ=DT"));
	Представление = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонПредставления, Параметры);
	
КонецПроцедуры

Функция УстановитьНомерДокументации(ЗакупочнаяПроцедура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ВерсияДокументацииЗакупочныхПроцедур.НомерВерсииДокументации) КАК НомерВерсииДокументации,
	               |	ВерсияДокументацииЗакупочныхПроцедур.ЗакупочнаяПроцедура КАК ЗакупочнаяПроцедура
	               |ИЗ
	               |	Документ.ВерсияДокументацииЗакупочныхПроцедур КАК ВерсияДокументацииЗакупочныхПроцедур
	               |ГДЕ
	               |	ВерсияДокументацииЗакупочныхПроцедур.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВерсияДокументацииЗакупочныхПроцедур.ЗакупочнаяПроцедура";
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура",ЗакупочнаяПроцедура);
	Выборка = Запрос.Выполнить();
	Если Выборка.Пустой() Тогда
		Возврат 1;
	Иначе
		Результат = Выборка.Выбрать();
		Пока Результат.Следующий() Цикл
			Возврат Результат.НомерВерсииДокументации + 1;
		КонецЦикла;	
	КонецЕсли;	
	
КонецФункции	

#КонецЕсли
