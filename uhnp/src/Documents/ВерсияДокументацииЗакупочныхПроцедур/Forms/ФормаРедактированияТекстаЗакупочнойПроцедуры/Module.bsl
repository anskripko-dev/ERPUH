		//	ТабличныйДокументПриложенияКДоговору = ПечатьПриложенияКДоговору(ТаблицаСведенийСчетНаОплату, Новый СписокЗначений, Новый Структура);
		//	
		//	// Указываем имя файла вложения.
		//	ИмяДоговораДляПриложения = СокрЛП(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Договору № %1 от %2'"), НомерДоговора, Формат(ДатаДоговора, "ДЛФ=DD")));
		//	ИмяДоговораДляПриложения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяДоговораДляПриложения);

		//	ИмяФайла = НСтр("ru = 'Приложение к '") + ИмяДоговораДляПриложения;

		//	Если ФорматСохранения = "RTF" Тогда
		//		ИмяФайла = ИмяФайла + ".htm"; // Табличный документ в rtf не сохраняется, оставляем в виде HTML.
		//		ТипФайла = ТипФайлаТабличногоДокумента.HTML;
		//	ИначеЕсли ФорматСохранения = "PDF" Тогда
		//		ИмяФайла = ИмяФайла + ".pdf";
		//		ТипФайла = ТипФайлаТабличногоДокумента.PDF;
