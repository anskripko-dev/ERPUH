		//		ИмяФайла = ИмяФайла + ".htm";
		//		ТипФайла = ТипФайлаТабличногоДокумента.HTML;
		//	КонецЕсли;
		//	
		//	ПолноеИмяФайла = УникальноеИмяФайла(ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременнойПапки) + ИмяФайла);
		//	ТабличныйДокументПриложенияКДоговору.Записать(ПолноеИмяФайла, ТипФайла);
