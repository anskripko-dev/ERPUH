#Область ОписаниеПеременных

// Хранит Истина, если запись ссылки на файл договора произведено 
// в основной форме элемента справочника, открытом в другом окне.
&НаКлиенте
Перем СозданиеФайлаОбработаноОсновнойФормойДоговора;

// Хранит выбранные форматы сохранения файла договора
&НаКлиенте
Перем ФорматыСохранения;

&НаКлиенте
Перем ПараметрыОтправкиПисьма;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ЦветФонаЗаменяемогоПараметра = ПечатьДоговоров.ЦветФонаЗаменяемогоПараметра();

	// Если задан файл договора, открываем именно его, 
	// иначе получаем договор из объекта для печати.
	Если ЗначениеЗаполнено(Параметры.ФайлДоговора) Тогда
		ФайлДоговора = Параметры.ФайлДоговора;
		
		ДоговорКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФайлДоговора, "ВладелецФайла");
		Если ЗначениеЗаполнено(Параметры.ОбъектПечати) Тогда
			ОбъектПечати = Параметры.ОбъектПечати;
		Иначе
			ОбъектПечати = ДоговорКонтрагента;
		КонецЕсли;
	Иначе
		
		ОбъектПечати = Параметры.ОбъектПечати;
		
	КонецЕсли;
	ВерсияДокументацииЗакупочныхПроцедур = Параметры.ВерсияДокументации;

	//ЗагрузитьСведенияОДоговореКонтрагента(Параметры);
	
	Если ЗначениеЗаполнено(ФайлДоговора) Тогда
		
		ПроверитьФайлАктуаленИУстановитьТолькоПросмотр(Отказ);
		Если ТекущийФайлАктуален Тогда

			ЗагрузитьФайлДоговора();
			
		КонецЕсли;
		
	Иначе
		
			ТекстПросьбы = Символы.ПС + Символы.Таб + НСтр("ru = 'Пожалуйста, подождите...'");
			ШрифтПросьбы = Новый Шрифт( , 18, Истина);
			ПросьбаПодождать = Новый ФорматированнаяСтрока(ТекстПросьбы, ШрифтПросьбы);
			ФорматированныйДокумент.УстановитьФорматированнуюСтроку(ПросьбаПодождать);
		
	КонецЕсли;
	МакетЗакупок = ПолучитьМакетЗакупочнойПроцедуры(Параметры.ОбъектПечати);
	Если МакетЗакупок = Неопределено Тогда
		МакетЗакупок = Справочники.ШаблоныМакетаЗакупочныхПроцедур.ПолучитьМакет("ШаблонЗакупочнойПроцедуры").ПолучитьТекст();
	    Макет = Справочники.ШаблоныМакетаЗакупочныхПроцедур.УстановитьПараметры(ОбъектПечати,МакетЗакупок.ТекстHTML);
		МакетФорматированногоДокумента = Макет;
	Иначе
		Макет = Справочники.ШаблоныМакетаЗакупочныхПроцедур.УстановитьПараметры(ОбъектПечати,МакетЗакупок.ТекстHTML);
		МакетФорматированногоДокумента = Макет;
	КонецЕсли;
	
	ФорматированныйДокумент.УстановитьHTML(Макет,Новый Структура());	
	
	ФорматHTML = Макет;//ТекстHTML;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	HTML = Новый Структура();
	ТекстHTML = "";
	ФорматированныйДокумент.ПолучитьHTML(ТекстHTML, html);
	Макет = УстановитьПараметры(ТекстHTML,ОбъектПечати);
	ФорматHTML = Макет;
КонецПроцедуры

&НаСервере
Функция УстановитьПараметрыФорматированногоДокумента(Макет,ОбъектПечати)
	ТекстМакета = Макет;
	НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедура");
	Пока НомерСтрокиНачало > 0 Цикл
		Окончание = СтрНайти(ТекстМакета,"]");
		СтрокаПоиска = Сред(ТекстМакета,НомерСтрокиНачало,Окончание-НомерСтрокиНачало);
		ИмяРеквизита = СтрЗаменить(СтрокаПоиска,"[ЗакупочнаяПроцедура.","");
		Попытка
			ЗначениеРеквизита = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ОбъектПечати,ИмяРеквизита);
		Исключение
			ЗначениеРеквизита = "";
		КонецПопытки;
		Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
			ЗначениеРеквизита = Формат(ЗначениеРеквизита,"ДЛФ=ДД");
		КонецЕсли;	
		ТекстМакета = Сред(ТекстМакета,0,НомерСтрокиНачало-1) + (ЗначениеРеквизита) + Сред(ТекстМакета,Окончание+1);
		НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедура");
	КонецЦикла;
	ТекстМакета = СтрЗаменить(ТекстМакета,"</body>","");
	ТекстМакета = СтрЗаменить(ТекстМакета,"</html>","");
	ТекстМакета = ТекстМакета + " </body>";
	ТекстМакета = ТекстМакета + " </html>";
	
	Возврат ТекстМакета;
КонецФункции

