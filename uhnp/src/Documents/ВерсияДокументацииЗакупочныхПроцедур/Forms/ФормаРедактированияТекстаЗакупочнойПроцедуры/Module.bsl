&НаСервере
Функция ПолучитьМакетЗакупочнойПроцедуры(ЗакупочнаяПроцедура)
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныМакетаЗакупочныхПроцедур.Ссылка КАК Шаблон
	               |ИЗ
	               |	Справочник.ШаблоныМакетаЗакупочныхПроцедур КАК ШаблоныМакетаЗакупочныхПроцедур
	               |ГДЕ
	               |	ШаблоныМакетаЗакупочныхПроцедур.ПометкаУдаления = ЛОЖЬ
	               |	И ШаблоныМакетаЗакупочныхПроцедур.СпособыВыбораПоставщика = &СпособыВыбораПоставщика
	               |	И ШаблоныМакетаЗакупочныхПроцедур.ЭТП = &ЭТП
	               |	И ШаблоныМакетаЗакупочныхПроцедур.ЗакрытаяЗакупка = &ЗакрытаяЗакупка
	               |	И ШаблоныМакетаЗакупочныхПроцедур.МетодыОценкиПредложенийПоставщиков = &МетодыОценкиПредложенийПоставщиков
	               |	И ШаблоныМакетаЗакупочныхПроцедур.ВидДокументаЗакупочнойПроцедуры = &ВидДокументаЗакупочнойПроцедуры
	               |	И ШаблоныМакетаЗакупочныхПроцедур.СовместнаяЗакупка = &СовместнаяЗакупка
	               |	И ШаблоныМакетаЗакупочныхПроцедур.ВЭлектроннойФорме = &ВЭлектроннойФорме";
	Запрос.УстановитьПараметр("ТребуетсяКвалификационныйОтбор",ВерсияДокументацииЗакупочныхПроцедур.ТребуетсяКвалификационныйОтбор);
	Запрос.УстановитьПараметр("СпособыВыбораПоставщика",ВерсияДокументацииЗакупочныхПроцедур.СпособыВыбораПоставщика);
	Запрос.УстановитьПараметр("ЭТП",ВерсияДокументацииЗакупочныхПроцедур.ЭТП);
	Запрос.УстановитьПараметр("ЗакрытаяЗакупка",ВерсияДокументацииЗакупочныхПроцедур.ЗакрытаяЗакупка);
	Запрос.УстановитьПараметр("МетодыОценкиПредложенийПоставщиков",ВерсияДокументацииЗакупочныхПроцедур.МетодыОценкиПредложенийПоставщиков);
	Запрос.УстановитьПараметр("ВидДокументаЗакупочнойПроцедуры",ВерсияДокументацииЗакупочныхПроцедур.ВидДокументаЗакупочнойПроцедуры);
	Запрос.УстановитьПараметр("СовместнаяЗакупка",ВерсияДокументацииЗакупочныхПроцедур.СовместнаяЗакупка);
	Запрос.УстановитьПараметр("ВЭлектроннойФорме",ВерсияДокументацииЗакупочныхПроцедур.ВЭлектроннойФорме);
	Запрос.УстановитьПараметр("Переторжка",ВерсияДокументацииЗакупочныхПроцедур.Переторжка);
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Шаблон;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ФайлДоговора) Тогда
		Если Не ТекущийФайлАктуален Тогда
			ПодключитьОбработчикОжидания("Подключаемый_ОбработчикОжиданияПолучитьИЗагрузитьФайлИзХранилища", 0.1, Истина);
		КонецЕсли;
	Иначе
		Если ДлительнаяОперация <> Неопределено Тогда
			ПодключитьОбработчикОжидания("Подключаемый_ОжидатьЗагрузкиШаблона", 0.1, Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	//Если НЕ Модифицированность Тогда
	//	Отказ = Ложь;
	//	Возврат;
	//КонецЕсли;
	
	Если Модифицированность Тогда
	
		Если Элементы.ФорматированныйДокумент.ТолькоПросмотр Тогда
		
			СтандартнаяОбработка = Ложь;
		
		Иначе
		
			// На форме нет основного реквизита, поэтому спрашивает о необходимости 
			// сохранения изменений самостоятельно.
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения, 
				НСтр("ru = 'Данные были изменены. Сохранить изменения?'"),
				РежимДиалогаВопрос.ДаНетОтмена,
				,
				КодВозвратаДиалога.Да);
			
			Отказ = Истина;
		
		КонецЕсли;
	
	КонецЕсли;
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ПрисоединенныйФайл",ПрисоединенныйФайл);
	Оповестить("УстановитьФайлЗакупочнойПроцедуры", ПараметрыОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ДоговорыКонтрагентов_СозданиеФайлаОбработаноОсновнойФормойДоговора"
		И Параметр = ДоговорКонтрагента Тогда
		// Запомним, что ссылка на файл записана в основной форме элемента справочника,
		// и дополнительно ее записывать не требуется.
		СозданиеФайлаОбработаноОсновнойФормойДоговора = Истина;
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Документ.ВерсияДокументацииЗакупочныхПроцедур.Форма.СохранениеПечатнойФормы") Тогда
		
		Если ВыбранноеЗначение <> Неопределено И ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
			
			ФорматыСохранения = ВыбранноеЗначение.ФорматыСохранения;
			Если ВыбранноеЗначение.ВариантСохранения = "СохранитьВПапку" Тогда
				СохранитьДоговорВПапку(ВыбранноеЗначение.ПапкаДляСохранения);
			Иначе
				ЗаписатьФайлДоговораНаКлиенте();
				Состояние(НСтр("ru = 'Сохранение успешно завершено.'"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

