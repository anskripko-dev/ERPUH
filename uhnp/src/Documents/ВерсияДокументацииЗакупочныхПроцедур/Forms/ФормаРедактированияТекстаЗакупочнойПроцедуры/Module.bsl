&НаКлиенте
Процедура Сохранить(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОбъектПечати", ОбъектПечати);
	ПараметрыФормы.Вставить("МакетЗакупок", МакетЗакупок);
	
	ОткрытьФорму("Документ.ВерсияДокументацииЗакупочныхПроцедур.Форма.СохранениеПечатнойФормы", ПараметрыФормы, ЭтотОбъект);
	Модифицированность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)

	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ОбъектОтправки", ОбъектПечати);

	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправитьЗавершение", ЭтотОбъект);
    ОтправкаДокументовПоЭлектроннойПочте = "Справочник.ДоговорыКонтрагентов.Форма.ОтправкаДокументовПоЭлектроннойПочте";
	ОткрытьФорму(ОтправкаДокументовПоЭлектроннойПочте,
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФайлПослеУстановкиРасширенияРаботыСФайлами", ЭтотОбъект);

	ТекстСообщения = НСтр("ru = 'Для открытия текст договора из внешнего файла рекомендуется установить расширение для веб-клиента 1С:Предприятие.'");

	ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения, ТекстСообщения, Ложь);

КонецПроцедуры

