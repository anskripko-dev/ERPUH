#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Ответственный = Пользователи.ТекущийПользователь(); 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Отказ = ПроверитьНаСуществующийВидДокументации(Ссылка,ВидДокументаЗакупочнойПроцедуры);
	Если Отказ Тогда
		ТекстСообщения = НСтр("ru = 'Для вида документа ""%ВидДокументаЗакупочнойПроцедуры%"" уже есть закупочная документация. Запись отменена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ВидДокументаЗакупочнойПроцедуры%", Строка(ВидДокументаЗакупочнойПроцедуры));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;	
	
КонецПроцедуры

Функция ПроверитьНаСуществующийВидДокументации(Ссылка,ВидДокументаЗакупочнойПроцедуры)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВерсияДокументацииЗакупочныхПроцедур.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ВерсияДокументацииЗакупочныхПроцедур КАК ВерсияДокументацииЗакупочныхПроцедур
	               |ГДЕ
	               |	ВерсияДокументацииЗакупочныхПроцедур.ВидДокументаЗакупочнойПроцедуры = &ВидДокументаЗакупочнойПроцедуры
	               |	И ВерсияДокументацииЗакупочныхПроцедур.Ссылка <> &Ссылка
	               |	И НЕ ВерсияДокументацииЗакупочныхПроцедур.ПометкаУдаления     
				   |	И ВерсияДокументацииЗакупочныхПроцедур.АрхивныйДокумент = Ложь
	               |	И ВерсияДокументацииЗакупочныхПроцедур.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура"; 
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("ВидДокументаЗакупочнойПроцедуры",ВидДокументаЗакупочнойПроцедуры);       
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура",ЗакупочнаяПроцедура);
	Выборка = Запрос.Выполнить();
	Возврат НЕ Выборка.Пустой();
	
КонецФункции	

#КонецЕсли
