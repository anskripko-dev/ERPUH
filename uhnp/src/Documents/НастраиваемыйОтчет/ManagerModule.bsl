	Запрос.Текст=Запрос.Текст+"
	|	ИсходнаяТаблицаРегистра.АналитикаВалюта КАК АналитикаВалюта,
	|	ИсходнаяТаблицаРегистра.ПериодОтчета КАК ПериодОтчета
	|ПОМЕСТИТЬ МаксимальныеВерсии
	|ИЗ
	|	ИсходнаяТаблицаРегистра КАК ИсходнаяТаблицаРегистра
	|
	|СГРУППИРОВАТЬ ПО
	|	ИсходнаяТаблицаРегистра.ВерсияВалюта,
	|	ИсходнаяТаблицаРегистра.Показатель,";
	
	Для Индекс=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		
		Запрос.Текст=Запрос.Текст+"
		|	ИсходнаяТаблицаРегистра.Аналитика"+Индекс+",";
		
	КонецЦикла;	
		
	Запрос.Текст=Запрос.Текст+"
	|	ИсходнаяТаблицаРегистра.АналитикаВалюта,
	|	ИсходнаяТаблицаРегистра.ПериодОтчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МаксимальныеВерсии.ВерсияВалюта КАК Валюта,
	|	МаксимальныеВерсии.Показатель КАК Показатель,";
	
	Для Индекс=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		
		Запрос.Текст=Запрос.Текст+"
		|	МаксимальныеВерсии.Аналитика"+Индекс+" КАК Аналитика"+Индекс+",";
		
	КонецЦикла;	
	
	Запрос.Текст=Запрос.Текст+"
	|	МаксимальныеВерсии.АналитикаВалюта КАК АналитикаВалюта,
	|	ИсходнаяТаблицаРегистра.Значение КАК Значение,
	|	ИсходнаяТаблицаРегистра.ИтоговоеЗначение КАК ИтоговоеЗначение,
	|	МаксимальныеВерсии.ПериодОтчета КАК ПериодОтчета
	|ИЗ
	|	МаксимальныеВерсии КАК МаксимальныеВерсии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсходнаяТаблицаРегистра КАК ИсходнаяТаблицаРегистра
	|		ПО МаксимальныеВерсии.ВерсияКод = ИсходнаяТаблицаРегистра.ВерсияКод
	|			И МаксимальныеВерсии.Показатель = ИсходнаяТаблицаРегистра.Показатель
	|			И МаксимальныеВерсии.ВерсияВалюта = ИсходнаяТаблицаРегистра.ВерсияВалюта";
	
	Для Индекс=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		
		Запрос.Текст=Запрос.Текст+"
		|	И МаксимальныеВерсии.Аналитика"+Индекс+" = ИсходнаяТаблицаРегистра.Аналитика"+Индекс;
		
	КонецЦикла;	
	
	Запрос.Текст=Запрос.Текст+"
	|			И МаксимальныеВерсии.АналитикаВалюта = ИсходнаяТаблицаРегистра.АналитикаВалюта
	|			И МаксимальныеВерсии.ПериодОтчета = ИсходнаяТаблицаРегистра.ПериодОтчета";
	
	Запрос.УстановитьПараметр("СписокВерсий",СписокВерсий);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьТаблицуНечисловых()

Процедура ЗаписатьТаблицуКомментариев(Версия,ТаблицаКомментариев)
	
	Если ТаблицаКомментариев.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НаборЗаписей=РегистрыСведений.КомментарииЗначенийПоказателей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Версия.Установить(Версия);
	
	Для Каждого Строка ИЗ ТаблицаКомментариев Цикл
		
		НоваяСтрока=НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		НоваяСтрока.Версия=Версия;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();	
	
КонецПроцедуры // ЗаписатьТаблицуКомментариев)()

#КонецОбласти


#Область Элиминация

Функция ВыполнитьПростуюЭлиминацию(ОбъектРасчета,ДляРасшифровки=Ложь, ОтборПоАналитикам = Неопределено) Экспорт
	
	Если НЕ ОбъектРасчета.Организация.ЭлиминирующаяОрганизация Тогда
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Организация %1 не является элиминирующей. Заполнение способом ""Элиминация"" невозможно.'"), 
			ОбъектРасчета.Организация),,,СтатусСообщения.Важное);
			
			Возврат Ложь;
			
	КонецЕсли;
			
	ДанныеПериода=Документы.НастраиваемыйОтчет.ПолучитьДанныеПериода(ОбъектРасчета.Сценарий,ОбъектРасчета.ПериодОтчета,ОбъектРасчета.Организация);
	
	ДокументУправленияПериодомСценария = ДанныеПериода.УправлениеПериодом;
	
	Если ДокументУправленияПериодомСценария = Неопределено Тогда
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Невозможно определить документ управления периодом сценария для сценария %1 и периода %2'"), 
			ОбъектРасчета.Сценарий, ОбъектРасчета.ПериодОтчета),,,СтатусСообщения.Важное);
			
		Возврат Ложь;	
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = УправлениеРабочимиПроцессамиУХ.ТекстЗапроса_ОрганизацииПериметраСКоэффициентамиЭлиминации();
	Запрос.УстановитьПараметр("Организация", ОбъектРасчета.Организация);
	Запрос.УстановитьПараметр("ВерсияРегламента", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДокументУправленияПериодомСценария, "ВерсияОрганизационнойСтруктуры"));
	
	ТаблицаПериметр = УправлениеРабочимиПроцессамиУХ.НоваяТаблицаПериметр();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаПериметр.Добавить(), Выборка);
	КонецЦикла;
	
	Если ТаблицаПериметр.Количество() = 0 Тогда
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(
		СтрШаблон(Нстр("ru = 'В документе ""%1"", к области действия которого относится текущий отчет,
		|не определен состав периметра для организационной единицы ""%2""!'"), 
		ДокументУправленияПериодомСценария, ОбъектРасчета.Организация),,,СтатусСообщения.Важное);
		мТабРасшифровкиПоказателей=Новый ТаблицаЗначений;
		
		Возврат Ложь;
				
	КонецЕсли;
	
	МассивОрганизацийПериметра = ТаблицаПериметр.ВыгрузитьКолонку("Организация");
	МассивОрганизацийПериметра = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивОрганизацийПериметра);
	
	ТекСписокВерсий = Новый СписокЗначений;
	ТекСписокВерсий.ЗагрузитьЗначения(ПолучитьВерсииКонсолидируемыхОтчетов(ОбъектРасчета,МассивОрганизацийПериметра));
	
	Если НЕ ДляРасшифровки Тогда
		
		ОбъектРасчета.мПоказателиРаскрытия.Очистить();
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоказателиОтчетов.ГруппаРаскрытия.АналитикаВГО КАК ГруппаРаскрытияАналитикаВГО,
	|	ПоказателиОтчетов.ГруппаРаскрытия.ЧислоАналитик КАК ГруппаРаскрытияЧислоАналитик,
	|	ПоказателиОтчетов.Ссылка КАК Показатель
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|ГДЕ
	|	ПоказателиОтчетов.ВнутриГрупповой
	|	И ПоказателиОтчетов.Владелец = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета",ОбъектРасчета.ВидОтчета);
	
	Результат=Запрос.Выполнить().Выбрать();
		
	Пока Результат.Следующий() Цикл
		
		ИмяРегистра="ЗначенияПоказателейОтчетов"+(ОбъектРасчета.МаксАналитикОтчета+Результат.ГруппаРаскрытияЧислоАналитик);
		
		ТекстЗапроса="
		|ВЫБРАТЬ
		|	ОрганизацииПериметра.Организация КАК Организация,
		|	ОрганизацииПериметра.ОрганизацияКонтрагента КАК ОрганизацияКонтрагента,
		|	ОрганизацииПериметра.Коэффициент КАК Коэффициент
		|ПОМЕСТИТЬ втОрганизацииПериметра
		|ИЗ
		|	&ТаблицаПериметр КАК ОрганизацииПериметра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ "+ИмяРегистра+".Показатель,
		|АналитикаВалюта";
				
		Для Индекс=ОбъектРасчета.МаксАналитикОтчета+1 ПО (ОбъектРасчета.МаксАналитикОтчета+Результат.ГруппаРаскрытияЧислоАналитик) Цикл
			
			ТекстЗапроса=ТекстЗапроса+",
			|"+ИмяРегистра+".Аналитика"+Индекс;
			
		КонецЦикла;
		
		Если ДляРасшифровки Тогда
			
			ТекстЗапроса=ТекстЗапроса+",
			|"+ИмяРегистра+".Версия.Организация КАК Организация,
			|"+ИмяРегистра+".Версия.ЭкземплярОтчета КАК Регистратор";
			
		КонецЕсли;

		ТекстЗапроса=ТекстЗапроса+",
		|	ВЫРАЗИТЬ(СУММА("+ИмяРегистра+".Значение * ОрганизацииПериметра.Коэффициент) КАК ЧИСЛО (18,5)) КАК Значение,
		|	ВЫРАЗИТЬ(СУММА("+ИмяРегистра+".ЗначениеВалюта * ОрганизацииПериметра.Коэффициент) КАК ЧИСЛО (18,5)) КАК ЗначениеВалюта
		|ИЗ	РегистрСведений."+ИмяРегистра+" КАК "+ИмяРегистра+"
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОрганизацииПериметра КАК ОрганизацииПериметра
		|	ПО " + ИмяРегистра + ".Версия.Организация = ОрганизацииПериметра.Организация"
			+ УправлениеРабочимиПроцессамиУХ.ТекстСвязи_АналитикаВГО(
				ИмяРегистра, "ОрганизацииПериметра", Результат.ГруппаРаскрытияАналитикаВГО) + "
		|ГДЕ "+ИмяРегистра+".Показатель=&Показатель
		|И "+ИмяРегистра+".Версия В(&СписокВерсий) И &Отбор
		|Сгруппировать ПО
		|"+ИмяРегистра+".Показатель,АналитикаВалюта";
		
		Для Индекс=ОбъектРасчета.МаксАналитикОтчета+1 ПО (ОбъектРасчета.МаксАналитикОтчета+Результат.ГруппаРаскрытияЧислоАналитик) Цикл
			
			ТекстЗапроса=ТекстЗапроса+",
			|"+ИмяРегистра+".Аналитика"+Индекс;
			
		КонецЦикла;
		
		Если ДляРасшифровки Тогда
			
			ТекстЗапроса=ТекстЗапроса+",
			|"+ИмяРегистра+".Версия.Организация,
			|"+ИмяРегистра+".Версия.ЭкземплярОтчета";
			
		КонецЕсли;
		
		ЗапросРаскрытие=Новый Запрос;
		ЗапросРаскрытие.Текст=ТекстЗапроса;
		ЗапросРаскрытие.УстановитьПараметр("Показатель",Результат.Показатель);
		ЗапросРаскрытие.УстановитьПараметр("СписокВерсий",ТекСписокВерсий);
		ЗапросРаскрытие.УстановитьПараметр("ТаблицаПериметр", ТаблицаПериметр);
		
		Если ОтборПоАналитикам = Неопределено Тогда
			ЗапросРаскрытие.Текст = СтрЗаменить(ЗапросРаскрытие.Текст, "И &Отбор", "");
		Иначе
			
			ТекстОтбор = "";
			Для Каждого КлючИЗначение ИЗ ОтборПоАналитикам Цикл
				
				Если КлючИЗначение.Значение = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				МаксНомерАналитики = ОбъектРасчета.МаксАналитикОтчета + Результат.ГруппаРаскрытияЧислоАналитик;
				ТекущийНомерАналитики = Число(СтрЗаменить(КлючИЗначение.Ключ, "Аналитика", ""));
				Если ТекущийНомерАналитики > МаксНомерАналитики Тогда
					Прервать;
				КонецЕсли;
				
				ТекстОтбор = ТекстОтбор + " И " + КлючИЗначение.Ключ + " = &" + КлючИЗначение.Ключ;
				ЗапросРаскрытие.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				
			КонецЦикла;
			
			ЗапросРаскрытие.Текст = СтрЗаменить(ЗапросРаскрытие.Текст, "И &Отбор", ТекстОтбор);
			
		КонецЕсли;
		
		Если ДляРасшифровки Тогда
			
			ДобавитьЗначенияВТаблицуРасшифровки(ОбъектРасчета,ЗапросРаскрытие);
			
		Иначе
			
			ЗаписатьПоказателиОтчетовВОбъект(ОбъектРасчета,ЗапросРаскрытие,Результат.Показатель);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Истина;
	
КонецФункции // ВыполнитьПростуюЭлиминацию()

Процедура ДобавитьЗначенияВТаблицуРасшифровки(ОбъектРасчета,ЗапросРаскрытие)
	
	Результат=ЗапросРаскрытие.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока = ОбъектРасчета.мТабРасшифровкиЭлиминация.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат);
		
	КонецЦикла;	
	
КонецПроцедуры // ДобавитьЗначенияВТаблицуРасшифровки() 

Процедура ЗаписатьПоказателиОтчетовВОбъект(ОбъектРасчета,Запрос,Показатель)
	
	СинтетическоеЗначение=0;
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока = ОбъектРасчета.мПоказателиРаскрытия.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат,,"Значение,ЗначениеВалюта");
				
		СинтетическоеЗначение=СинтетическоеЗначение + Результат.Значение;
		
		ДанныеДляЗаписи=Новый Структура;
		ДанныеДляЗаписи.Вставить("Значение", Результат.Значение);
		ДанныеДляЗаписи.Вставить("ЗначениеВалюта",Результат.ЗначениеВалюта);
				
		УправлениеОтчетамиУХ.ЗаписатьЗначениеВмПоказателиРаскрытия(ОбъектРасчета,ДанныеДляЗаписи,НоваяСтрока);
					
	КонецЦикла;	
		
	УправлениеОтчетамиУХ.ЗаписатьЗначениеВмПоказатели(ОбъектРасчета,Показатель,СинтетическоеЗначение);
				
КонецПроцедуры // ЗаписатьПоказателиОтчетовВОбъект()

Процедура ДополнитьВнутригрупповымиКонтрагентами(МассивОрганизацийПериметра)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ОрганизационнаяЕдиница В(&МассивПериметра)";
	
	Запрос.УстановитьПараметр("МассивПериметра",МассивОрганизацийПериметра);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		МассивОрганизацийПериметра.Добавить(Результат.Ссылка);
		
	КонецЦикла;
				
КонецПроцедуры // ДополнитьВнутригрупповымиКонтрагентами() 

// Функция - Получить версии консолидируюмых отчетов
//
// Параметры:
//  СписокПериметра	 - массив организаций для отбора версий
// Возвращаемое значение:
//   - массив версий значений показателей
Функция ПолучитьВерсииКонсолидируемыхОтчетов(ОбъектРасчета,СписокПериметра) Экспорт

	ЗапросВерсии = Новый Запрос;
	ЗапросВерсии.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВерсииЗначенийПоказателей.Ссылка,
	|	ВерсииЗначенийПоказателей.Регистратор
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
	|ГДЕ
	|	ВерсииЗначенийПоказателей.Организация В(&СписокПериметра)
	|	И (НЕ ВерсииЗначенийПоказателей.ЧерноваяВерсия)	
	|	И ВерсииЗначенийПоказателей.ПериодОтчета = &ПериодОтчета
	|	И ВерсииЗначенийПоказателей.Проект = &Проект
	|	И ВерсииЗначенийПоказателей.Сценарий = &Сценарий
	|	И ВерсииЗначенийПоказателей.Валюта = &Валюта
	|	И ВерсииЗначенийПоказателей.ВидОтчета = &ВидОтчета";
	
	Если НЕ УправлениеОтчетамиУХ.ИспользоватьНеактуальныеЗаписи(ОбъектРасчета) Тогда
		ЗапросВерсии.Текст = ЗапросВерсии.Текст + "
		|	И ВерсииЗначенийПоказателей.Активность = ИСТИНА";
	КонецЕсли;
	
	Для Инд = 1 По ОбъектРасчета.МаксАналитикОтчета Цикл
		
		ЗапросВерсии.Текст=ЗапросВерсии.Текст+"
		|И ВерсииЗначенийПоказателей.Аналитика"+Инд+"=&Аналитика"+Инд;
		
		ЗапросВерсии.УстановитьПараметр("Аналитика" + Инд, 
								?(ЗначениеЗаполнено(ОбъектРасчета["Аналитика"+Инд]), ОбъектРасчета["Аналитика"+Инд], 
									Неопределено));;
		
	КонецЦикла;
	
	ЗапросВерсии.УстановитьПараметр("ВидОтчета", 		ОбъектРасчета.ВидОтчета);
	ЗапросВерсии.УстановитьПараметр("Сценарий", 		ОбъектРасчета.Сценарий);
	ЗапросВерсии.УстановитьПараметр("Проект", 			ОбъектРасчета.Проект);
	ЗапросВерсии.УстановитьПараметр("ПериодОтчета", 	ОбъектРасчета.ПериодОтчета);
	ЗапросВерсии.УстановитьПараметр("Валюта", 			ОбъектРасчета.ОсновнаяВалюта);
	ЗапросВерсии.УстановитьПараметр("СписокПериметра", 	СписокПериметра);
	ЗапросВерсии.УстановитьПараметр("Ссылка", 			ОбъектРасчета.Ссылка);

	МассивВерсийКонсолидации=Новый Массив;
	
	Результат=ЗапросВерсии.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Результат.Регистратор) Тогда
			
			УправлениеОтчетамиУХ.ЗаполнитьРегистраторВерсии(Результат.Ссылка);
			
		КонецЕсли;
		
		МассивВерсийКонсолидации.Добавить(Результат.Ссылка);
		
	КонецЦикла;
	
	Возврат МассивВерсийКонсолидации;

КонецФункции

#КонецОбласти


#Область ЗапросыИсточниковДанных

Функция ПолучитьТаблицуРесурсов(ТаблицаОперандов) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТаблицаОперандов[0].Ресурс) Тогда
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ТаблицаОперандов.Ресурс КАК Ресурс,
	|ТаблицаОперандов.ТипЗначения КАК ТипЗначения
	|Поместить ТаблицаРесурсов
	|ИЗ &ТаблицаОперандов КАК ТаблицаОперандов
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|ТаблицаРесурсов.Ресурс,
	|ТаблицаРесурсов.ТипЗначения
	|ИЗ ТаблицаРесурсов КАК ТаблицаРесурсов";
	
	Запрос.УстановитьПараметр("ТаблицаОперандов",ТаблицаОперандов);
		
	Возврат Запрос.Выполнить().Выгрузить();
	
	
КонецФункции // ПолучитьТаблицуРесурсов()

Процедура ДобавитьНастройкиСоответствия(СтрЗапрос)
		
	Если ТипЗнч(СтрЗапрос.ТабПравилаИспользованияПолей)=Тип("ТаблицаЗначений") Тогда
		
		ПравилаИспользованияПолей=СтрЗапрос.ТабПравилаИспользованияПолей[0].ПравилаИспользованияПолей;
		
	Иначе
		
		ПравилаИспользованияПолей=СтрЗапрос.ТаблицаОперандов[0].ПравилаИспользованияПолейЗапроса;
		
	КонецЕсли;
	
	Если ПравилаИспользованияПолей.Колонки.Найти("НастройкаСоответствия")=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТаблицаНастроекСоответствия=Новый ТаблицаЗначений;
	ТаблицаНастроекСоответствия.Колонки.Добавить("ИмяКолонки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255));
	ТаблицаНастроекСоответствия.Колонки.Добавить("ИмяНастройки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(150));
	
	Для Каждого Строка ИЗ ПравилаИспользованияПолей Цикл
		
		Если ЗначениеЗаполнено(Строка.НастройкаСоответствия) Тогда
			
			ИмяНастройки=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.НастройкаСоответствия,"Наименование");
			
			НоваяСтрока=ТаблицаНастроекСоответствия.Добавить();
			НоваяСтрока.ИмяКолонки=Строка.Поле+"_НастройкаСоответствия";
			НоваяСтрока.ИмяНастройки=ИмяНастройки;
						
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ТаблицаНастроекСоответствия.Количество()>0 Тогда
		
		СтрЗапрос.СтруктураЗапроса.Вставить("ТаблицаНастроекСоответствия",ТаблицаНастроекСоответствия);
		
	КонецЕсли;
		
КонецПроцедуры // ДобавитьПоляНастройкиСоответствия() 

Процедура СформироватьРабочийТекстЗапроса(ОбъектРасчета,СтрЗапрос) Экспорт
	
	Перем СписокСчетов;
	Перем СписокКоррСчетов;
	Перем ТолькоПроверка;
	Перем ТекстСоединения;
	
	ТолькоПроверка=Ложь;
	
	Если СтрНайти(СтрЗапрос.ТекстЗапроса,"&ТекстПоля")=0 Тогда
		
		Если ТипЗнч(ОбъектРасчета)=Тип("Структура")
			И ОбъектРасчета.Свойство("ВидОтчета")
			И СтрЗапрос.ТаблицаОперандов[0].Ссылка.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос Тогда
				
			ДобавитьНастройкиСоответствия(СтрЗапрос);
			
		КонецЕсли;
				
		Возврат;
		
	КонецЕсли;
	
	ВнешниеДанные=ВнешниеДанные(СтрЗапрос.СпособПолучения); 
		
	Если ТипЗнч(ОбъектРасчета)=Тип("Структура")
		И Не ОбъектРасчета.Свойство("ТолькоПроверка",ТолькоПроверка) Тогда
		
		ОбъектРасчета.Вставить("ТолькоПроверка",ТолькоПроверка=Истина);
	
	КонецЕсли;
	
	Если СтрЗапрос.ТаблицаОперандов.Количество()=1 Тогда
		
		ТрансляцияКредит=СтрЗапрос.ТаблицаОперандов[0].ТрансляцияКредит;
		
	Иначе
		
		ТрансляцияКредит=Ложь;
		
	КонецЕсли;
			
	Если СтрЗапрос.ТаблицаОперандов[0].Ссылка.СпособИспользования=Перечисления.СпособыИспользованияОперандов.ДляЗаполненияОбъектовБД Тогда		
						
		Если ГруппироватьДанные(СтрЗапрос.СпособПолучения) Тогда
			
			СформироватьТекстЗапросаДляОбъектаБД_Группировка(ОбъектРасчета, СтрЗапрос);
			
		Иначе
			
			СформироватьТекстЗапросаДляОбъектаБД(ОбъектРасчета, СтрЗапрос);
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ СтрЗапрос.СтруктураЗапроса=Неопределено Тогда
		
		СтрЗапрос.СтруктураЗапроса.Свойство("СписокСчетов",СписокСчетов);
		СтрЗапрос.СтруктураЗапроса.Свойство("СписокКоррСчетов",СписокКоррСчетов);
		
	КонецЕсли;
	
	Если ТипЗнч(СтрЗапрос.ТабПравилаИспользованияПолей)=Тип("ТаблицаЗначений") Тогда
		
		ПравилаИспользованияПолей=СтрЗапрос.ТабПравилаИспользованияПолей[0].ПравилаИспользованияПолей;
		
	Иначе
		
		ПравилаИспользованияПолей=СтрЗапрос.ТаблицаОперандов[0].ПравилаИспользованияПолейЗапроса;
		
	КонецЕсли; 
		
	СтруктураЗапроса=СтрЗапрос.СтруктураЗапроса;
	
	ТекстПоля="";
	ТекстГруппировки="";
	МассивПсевдонимов=Новый Массив; 
	ТаблицаРесурсов=ПолучитьТаблицуРесурсов(СтрЗапрос.ТаблицаОперандов); 
	ДополнениеКода=".Код";
	
	Для Каждого Строка ИЗ ТаблицаРесурсов Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.Ресурс) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИмяПоля=Строка.Ресурс;
		Ресурс=Строка.Ресурс;
		
		Если СтрНайти(СтрЗапрос.ТекстЗапроса,".ОборотыДтКт")>0 И (Не СтрНайти(Ресурс,"Оборот")>0) Тогда
			
			Если Прав(Ресурс,2)="Дт" ИЛИ Прав(Ресурс,2)="Кт" Тогда
				
				ДтКт=Прав(Ресурс,2);		
				Ресурс=Лев(Ресурс,СтрДлина(Ресурс)-2)+"Оборот"+ДтКт;
				
			Иначе
				
				Ресурс=Ресурс+"Оборот";
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Строка.ТипЗначения=Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда 
			
			ТекстПоля=ТекстПоля+",
			|СУММА("+Ресурс+") КАК "+ИмяПоля;
			
		Иначе
			
			ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,Ресурс,Ресурс,МассивПсевдонимов);
			
		КонецЕсли;
			
	КонецЦикла;
		
	Для Каждого Строка ИЗ ПравилаИспользованияПолей Цикл
		
		Если ВРЕГ(Строка.КодАналитики)="ЗНАЧЕНИЕ"
			ИЛИ ОбщегоНазначенияУХ.ПринудительноеЗаполнениеПоля(Строка) Тогда
			
			Продолжить;
						
		ИначеЕсли ЗначениеЗаполнено(Строка.Поле) Тогда
			
			Если СтрНайти(СтрЗапрос.ТекстЗапроса,"ОсновнаяТаблицаРегистра") Тогда
				
				МассивПутей=СтрРазделить(Строка.Поле,".");
				МассивПутей[0]=Строка.КодАналитики;
				РабочееПоле=СтрСоединить(МассивПутей,".");
				
				Если ТолькоПроверка=Истина Тогда
					
					ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,"ПРЕДСТАВЛЕНИЕ("+РабочееПоле+")",Строка.КодАналитики,МассивПсевдонимов);
					
				Иначе
					
					ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,РабочееПоле,Строка.КодАналитики,МассивПсевдонимов);
					ДобавитьИмяНастройки(Строка,ТекстПоля);
					
				КонецЕсли;
				
			Иначе 
				
				Если Строка.Поле="КоррСчетОборот" Тогда
					
					Строка.Поле=?(СтрНайти(СтрЗапрос.ТекстЗапроса,"&СчетДтОборот")>0,"СчетКт.Код","СчетДт.Код");
					ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,Строка.Поле,Строка.КодАналитики,МассивПсевдонимов);
	
				ИначеЕсли ТолькоПроверка=Истина Тогда
					
					ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,"ПРЕДСТАВЛЕНИЕ("+Строка.Поле+")",Строка.КодАналитики,МассивПсевдонимов);
					
				Иначе
						
					ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,Строка.Поле,Строка.КодАналитики,МассивПсевдонимов);
					ДобавитьИмяНастройки(Строка,ТекстПоля); 
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ТипЗнч(ОбъектРасчета.ПериодОтчета)=Тип("Массив") Тогда
		
		ДобавитьПолеПериод(ОбъектРасчета,СтрЗапрос,ТекстПоля,ТекстГруппировки,МассивПсевдонимов);
		
	Иначе
		
		СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"#Периодичность#","");
		СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"#Период#","ИСТИНА");
		
	КонецЕсли; 
	
	Если СтрНайти(СтрЗапрос.ТекстЗапроса,"&ПараметрДтСчет")>0 Тогда
		
		ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,"СчетДт.Код","Счет",МассивПсевдонимов);
		ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,"СчетКт.Код","КоррСчет",МассивПсевдонимов);
		
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрДтСчет",?(ТрансляцияКредит,"СчетКт","СчетДт")+ДополнениеКода+"=&СчетДт");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрДтСчет",?(ТрансляцияКредит,"СчетКт","СчетДт")+ДополнениеКода+" В(&СчетДт)");
			
		КонецЕсли;
		
		Если СписокКоррСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрКтСчет",?(ТрансляцияКредит,"СчетДт","СчетКт")+ДополнениеКода+"=&СчетКт");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокКоррСчетов",СписокКоррСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрКтСчет",?(ТрансляцияКредит,"СчетДт","СчетКт")+ДополнениеКода+" В(&СчетКт)");
			
		КонецЕсли; 
				
	ИначеЕсли СтрНайти(СтрЗапрос.ТекстЗапроса,"&ПараметрСчет")>0 Тогда
		
		ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,"Счет.Код","Счет",МассивПсевдонимов);
		
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрСчет","Счет"+ДополнениеКода+"=&Счет");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрСчет","Счет"+ДополнениеКода+" В(&Счет)");
			
		КонецЕсли;
		
	ИначеЕсли СтрНайти(СтрЗапрос.ТекстЗапроса,"&СчетДтОборот")>0 Тогда
		
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетДтОборот","СчетДт"+ДополнениеКода+"=&Счет");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетДтОборот","СчетДт"+ДополнениеКода+" В(&Счет)");
			
		КонецЕсли;
		
	ИначеЕсли СтрНайти(СтрЗапрос.ТекстЗапроса,"&СчетКтОборот")>0 Тогда
		
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетКтОборот","СчетКт"+ДополнениеКода+"=&Счет");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетКтОборот","СчетКт"+ДополнениеКода+" В(&Счет)");
			
		КонецЕсли;
			
	КонецЕсли;
	
	СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ТекстПоля",Сред(ТекстПоля,2));
		
	Если Не ПустаяСтрока(СтрЗапрос.ТекстВременныеТаблицы) Тогда
		
		ТекстСоединения=Обработки.КорректировкиЗначенийПоказателей.ПолучитьТекстСоединения(ПравилаИспользованияПолей);
		СтрЗапрос.ТекстЗапроса=СтрЗапрос.ТекстВременныеТаблицы+СтрЗапрос.ТекстЗапроса+ТекстСоединения;
		
	КонецЕсли;	
	
	Если Не ПустаяСтрока(ТекстГруппировки) Тогда
		
		СтрЗапрос.ТекстЗапроса=СтрЗапрос.ТекстЗапроса+"
		|СГРУППИРОВАТЬ ПО "+Сред(ТекстГруппировки,2);
		
	КонецЕсли;
				
КонецПроцедуры // СформироватьРабочийТекстЗапроса()

Функция ГруппироватьДанные(СпособПолучения) 
	
	Возврат СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрБухгалтерии
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрНакопления
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрСведений
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрНакопления
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрСведений;
	
	
КонецФункции // НеобходимаГруппировка()
	
Процедура СформироватьТекстЗапросаДляОбъектаБД(ОбъектРасчета, СтрЗапрос)
	
	Если ТипЗнч(СтрЗапрос.ТабПравилаИспользованияПолей)=Тип("ТаблицаЗначений") Тогда
		
		ПравилаИспользованияПолей=СтрЗапрос.ТабПравилаИспользованияПолей[0].ПравилаИспользованияПолей;
		
	Иначе
		
		ПравилаИспользованияПолей=СтрЗапрос.ТаблицаОперандов[0].ПравилаИспользованияПолейЗапроса;
		
	КонецЕсли;
	
	СтруктураЗапроса=СтрЗапрос.СтруктураЗапроса;
		
	ТекстПоля="";
	МассивПсевдонимов=Новый Массив; 	
	
	Для Каждого Строка ИЗ ПравилаИспользованияПолей Цикл 
		
		Если ОбщегоНазначенияУХ.ПринудительноеЗаполнениеПоля(Строка) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Поле) Тогда
			
			Если ОбъектРасчета.ТолькоПроверка Тогда
				
				ДобавитьПолеЗапроса(ТекстПоля,"ПРЕДСТАВЛЕНИЕ("+Строка.Поле+")",Строка.КодАналитики,МассивПсевдонимов);
				
			Иначе
				
				ДобавитьПолеЗапроса(ТекстПоля,Строка.Поле,Строка.КодАналитики,МассивПсевдонимов);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ТекстПоля",Сред(ТекстПоля,2));
		
КонецПроцедуры // СформироватьТекстЗапросаДляОбъектаБД()

Функция ПолучитьМассивЧисловыхПолей(ПотребительРасчета)
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	             |	РеквизитыОбъектаБД.Имя КАК Имя
	             |ИЗ
	             |	Справочник.ДокументыБД.Реквизиты КАК РеквизитыОбъектаБД
	             |ГДЕ
	             |	РеквизитыОбъектаБД.Ссылка = &Ссылка
	             |	И (ВЫРАЗИТЬ(РеквизитыОбъектаБД.ТипДанных КАК СТРОКА(20))) = &ТипЧисло";
	
	Если ТипЗнч(ПотребительРасчета)=Тип("СправочникСсылка.ТабличныеЧастиБД") Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"ДокументыБД","ТабличныеЧастиБД");
		
	КонецЕсли;
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка",ПотребительРасчета);
	Запрос.УстановитьПараметр("ТипЧисло","Число");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Имя");
	
КонецФункции // ПолучитьМассивЧисловыхПолей()

Процедура СформироватьТекстЗапросаДляОбъектаБД_Группировка(ОбъектРасчета, СтрЗапрос)
	
	Перем СписокСчетов;
	Перем СписокКоррСчетов;
	
	Если ТипЗнч(СтрЗапрос.ТабПравилаИспользованияПолей)=Тип("ТаблицаЗначений") Тогда
		
		ПравилаИспользованияПолей=СтрЗапрос.ТабПравилаИспользованияПолей[0].ПравилаИспользованияПолей;
		
	Иначе
		
		ПравилаИспользованияПолей=СтрЗапрос.ТаблицаОперандов[0].ПравилаИспользованияПолейЗапроса;
		
	КонецЕсли;
	
	СтруктураЗапроса=СтрЗапрос.СтруктураЗапроса;
	
	Если НЕ СтрЗапрос.СтруктураЗапроса=Неопределено Тогда
		
		СтрЗапрос.СтруктураЗапроса.Свойство("СписокСчетов",СписокСчетов);
		СтрЗапрос.СтруктураЗапроса.Свойство("СписокКоррСчетов",СписокКоррСчетов);
		
	КонецЕсли;
	
	ПотребительРасчета=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрЗапрос.ТаблицаОперандов[0].Ссылка,"ПотребительРасчета");
	ЧисловыеПоля=ПолучитьМассивЧисловыхПолей(ПотребительРасчета);
		
	ТекстПоля=""; 
	ТекстГруппировки="";
	ДополнениеКода=".Код";

	
	МассивПсевдонимов=Новый Массив; 	
	
	Для Каждого Строка ИЗ ПравилаИспользованияПолей Цикл 
		
		Если ОбщегоНазначенияУХ.ПринудительноеЗаполнениеПоля(Строка) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Поле) Тогда
			
			Если ОбъектРасчета.ТолькоПроверка Тогда
				
				ДобавитьПолеЗапроса(ТекстПоля,"ПРЕДСТАВЛЕНИЕ("+Строка.Поле+")",Строка.КодАналитики,МассивПсевдонимов);
				
			Иначе
				
				Если ЧисловыеПоля.Количество()=0 Тогда
					
					ДобавитьПолеЗапроса(ТекстПоля,Строка.Поле,Строка.КодАналитики,МассивПсевдонимов);
					
				ИначеЕсли ЧисловыеПоля.Найти(Строка.КодАналитики)=Неопределено Тогда
					
					ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,Строка.Поле,Строка.КодАналитики,МассивПсевдонимов);
					
				Иначе
					
					ТекстПоля=ТекстПоля+",
					|СУММА("+Строка.Поле+") КАК "+Строка.КодАналитики;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрНайти(СтрЗапрос.ТекстЗапроса,"&ПараметрДтСчет")>0 Тогда
				
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрДтСчет","СчетДт"+ДополнениеКода+"=&СчетДт");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрДтСчет","СчетДт"+ДополнениеКода+" В(&СчетДт)");
			
		КонецЕсли;
		
		Если СписокКоррСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрКтСчет","СчетКт"+ДополнениеКода+"=&СчетКт");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокКоррСчетов",СписокКоррСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрКтСчет","СчетКт"+ДополнениеКода+" В(&СчетКт)");
			
		КонецЕсли; 
				
	ИначеЕсли СтрНайти(СтрЗапрос.ТекстЗапроса,"&ПараметрСчет")>0 Тогда
				
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрСчет","Счет"+ДополнениеКода+"=&Счет");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ПараметрСчет","Счет"+ДополнениеКода+" В(&Счет)");
			
		КонецЕсли;
		
	ИначеЕсли СтрНайти(СтрЗапрос.ТекстЗапроса,"&СчетДтОборот")>0 Тогда
		
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетДтОборот","СчетДт"+ДополнениеКода+"=&Счет");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетДтОборот","СчетДт"+ДополнениеКода+" В(&Счет)");
			
		КонецЕсли;
		
	ИначеЕсли СтрНайти(СтрЗапрос.ТекстЗапроса,"&СчетКтОборот")>0 Тогда
		
		Если СписокСчетов.Количество()=1 Тогда
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетКтОборот","СчетКт"+ДополнениеКода+"=&Счет");
			СтрЗапрос.СтруктураЗапроса.Вставить("СписокСчетов",СписокСчетов[0].Значение);
			
		Иначе
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&СчетКтОборот","СчетКт"+ДополнениеКода+" В(&Счет)");
			
		КонецЕсли;
			
	КонецЕсли;
	
	СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"&ТекстПоля",Сред(ТекстПоля,2));
	СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"#Периодичность#","");
	
	Если Не ПустаяСтрока(ТекстГруппировки) Тогда
		
		СтрЗапрос.ТекстЗапроса=СтрЗапрос.ТекстЗапроса+"
		|СГРУППИРОВАТЬ ПО "+Сред(ТекстГруппировки,2);
		
	КонецЕсли;
	
КонецПроцедуры // СформироватьТекстЗапросаДляОбъектаБД()

Процедура ДобавитьИмяНастройки(Строка,ТекстПоля) 
	
	Если Строка.Владелец().Колонки.Найти("НастройкаСоответствия") = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Строка.НастройкаСоответствия) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ИмяНастройки=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.НастройкаСоответствия,"Наименование");
	
	ТекстПоля=ТекстПоля+",
	|"""+ИмяНастройки+""" КАК "+Строка.КодАналитики+"_НастройкаСоответствия";
			
КонецПроцедуры // ДобавитьИмяНастройки()

Функция ВнешниеДанные(СпособПолучения)
	
	Возврат (СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеДокументы
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрБухгалтерии
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрНакопления
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрСведений
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеСправочники);

	
КонецФункции

Процедура ДобавитьПолеПериод(ОбъектРасчета,СтрЗапрос,ТекстПоля,ТекстГруппировки,МассивПсевдонимов)

	ТекущаяПериодичность=ОбъектРасчета.ПериодОтчета[0].Периодичность;
	
	Если ТекущаяПериодичность=Перечисления.Периодичность.ДевятьМесяцев Тогда 
		
		СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"#Периодичность#","");	
		Возврат;
		
	КонецЕсли; 
	
	ТекстПериод=XMLСтрока(ТекущаяПериодичность);
	
	Если СтрНайти(СтрЗапрос.ТекстЗапроса,".ДвиженияССубконто")
		ИЛИ СтрЗапрос.ОсновнаяТаблицаРегистра Тогда
		
		СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"#Период#","Период");
		ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,"НАЧАЛОПЕРИОДА (Период,"+ТекстПериод+")","Период",МассивПсевдонимов);
		
	ИначеЕсли СтрНайти(СтрЗапрос.ТекстЗапроса,"#Периодичность#")>0 Тогда
		
		СтрЗапрос.ТекстЗапроса=СтрЗаменить(СтрЗапрос.ТекстЗапроса,"#Периодичность#",ТекстПериод);
		ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,"Период","Период",МассивПсевдонимов);
				
	КонецЕсли;		
		
КонецПроцедуры // ДобавитьПолеПериод() 

Функция ПолучитьТекстыПолейИГруппировок(ПравилаИспользованияПолей)
	
	ТекстПоля="";
	ТекстГруппировки="";
	МассивПсевдонимов=Новый Массив;
	
	Для Каждого Строка ИЗ ПравилаИспользованияПолей Цикл
		
		Если ВРЕГ(Строка.КодАналитики="ЗНАЧЕНИЕ") Тогда
			
			ТекстПоля=ТекстПоля+",
			|СУММА("+Строка.Поле+") КАК "+Строка.Синоним;
			
		Иначе
			
			ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,Строка.Поле,Строка.Синоним,МассивПсевдонимов);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("ТекстПоля,ТекстГруппировки",Сред(ТекстПоля,2),Сред(ТекстГруппировки,2));
		
КонецФункции // ПолучитьТекстыПолейИГруппировок() 

Процедура ДобавитьПолеГруппировки(ТекстПоля,ТекстГруппировки,Поле,Синоним,МассивПсевдонимов)
	
	Если НЕ МассивПсевдонимов.Найти(Синоним)=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
		
	МассивПсевдонимов.Добавить(Синоним);
	
	Если СтрНайти(Синоним,"vzvЭлементСсылка")>0 Тогда
		
		МассивПутей=СтрРазделить(Поле,".");
		
		Если МассивПутей[МассивПутей.Количество()-1]="Ссылка" Тогда
			
			МассивПутей.Удалить(МассивПутей.Количество()-1);
			
		КонецЕсли;
		
		ПолеЗапроса=СтрСоединить(МассивПутей,".");
		
		ТекстПоля=ТекстПоля+",
		|"+ПолеЗапроса+" КАК "+Синоним;
		
		ТекстГруппировки=ТекстГруппировки+",
		|"+ПолеЗапроса; 
		
		ТекстПоля=ТекстПоля+",
		|ПРЕДСТАВЛЕНИЕ("+ПолеЗапроса+") КАК "+Синоним+"Представление";
		
		МассивПсевдонимов.Добавить(Синоним+"Представление");
		
		ТекстГруппировки=ТекстГруппировки+",
		|ПРЕДСТАВЛЕНИЕ("+ПолеЗапроса+")";
		
	Иначе
		
		ТекстПоля=ТекстПоля+",
		|"+Поле+" КАК "+Синоним;
		
		ТекстГруппировки=ТекстГруппировки+",
		|"+Поле; 
		
	КонецЕсли;

КонецПроцедуры // ДобавитьПолеГруппировки()  

Процедура ДобавитьПолеЗапроса(ТекстПоля,Поле,Синоним,МассивПсевдонимов)
	
	Если НЕ МассивПсевдонимов.Найти(Синоним)=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
		
	МассивПсевдонимов.Добавить(Синоним);
	
	Если СтрНайти(Синоним,"vzvЭлементСсылка")>0 Тогда
		
		МассивПутей=СтрРазделить(Поле,".");
		
		Если МассивПутей[МассивПутей.Количество()-1]="Ссылка" Тогда
			
			МассивПутей.Удалить(МассивПутей.Количество()-1);
			
		КонецЕсли;
		
		ПолеЗапроса=СтрСоединить(МассивПутей,".");
		
		ТекстПоля=ТекстПоля+",
		|"+ПолеЗапроса+" КАК "+Синоним;
	
		ТекстПоля=ТекстПоля+",
		|ПРЕДСТАВЛЕНИЕ("+ПолеЗапроса+") КАК "+Синоним+"Представление";
		
		МассивПсевдонимов.Добавить(Синоним+"Представление");
				
	Иначе
		
		ТекстПоля=ТекстПоля+",
		|"+Поле+" КАК "+Синоним;
				
	КонецЕсли;

КонецПроцедуры // ДобавитьПолеЗапроса()


