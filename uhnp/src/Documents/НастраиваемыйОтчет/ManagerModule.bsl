Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если НЕ ВидФормы = "ФормаОбъекта" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ОбщегоНазначенияПовтИспУХ.ИспользуетсяМногопериоднаяОтчетность() Тогда
		
		Если (Параметры.Свойство("Ключ") И ЗначениеЗаполнено(Параметры.Ключ))
			ИЛИ Параметры.Свойство("Объект") Тогда
			
			ВыбраннаяФорма = "ФормаДокумента";
			
		Иначе
			
			ВыбраннаяФорма = "ФормаНастроекДокумента";
			
		КонецЕсли;
		
	Иначе
		
		// НМ и БМ
	
		Если (Параметры.Свойство("Ключ") И ЗначениеЗаполнено(Параметры.Ключ))
			ИЛИ (Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования))
			ИЛИ Параметры.Свойство("АдресПараметровИнициализации") Тогда
			
			ВыбраннаяФорма = "ФормаДокументаНО";
			
		Иначе
			
			ВыбраннаяФорма = "ВыборКлючевыхРеквизитовНО";
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


