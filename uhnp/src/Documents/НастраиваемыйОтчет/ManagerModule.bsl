	Контекст.Вставить("ШаблонКорректировки");
	Контекст.Вставить("ИспользуемаяИБ");
	Контекст.Вставить("ВерсияХранимогоФайла");
	Контекст.Вставить("Ссылка");
	Контекст.Вставить("ПоказательОтчета");
	Контекст.Вставить("КонтекстСобытия");
	Контекст.Вставить("СеансОбменаДанными");
	
	ЗаполнитьЗначенияСвойств(Контекст, ОбъектРасчета);
	Контекст.ВерсияХранимогоФайла = ОбъектРасчета.ФайлИмпорта;
	
	Возврат Контекст;
	
КонецФункции

Функция ЗначениеНастройкиОбработкиДокумента(ДокументОбъект, ИмяНастройки) Экспорт
	
