
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТабличныйДокумент.Вывести(Параметры.ДокументДляВывода);
	ДокументСсылка   = Параметры.ДокументСсылка;
	
КонецПроцедуры


&НаКлиенте
Процедура СохранитьВБазу(Команда)
	
	Если ДокументСсылка.Пустая() Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Необходимо записать текущий экземпляр отчета перед помещением файла в базу.'"));
		Возврат;
	КонецЕсли;	
	
	Оповещение = Новый ОписаниеОповещения("СохранениеФайлаВБазуЗавершение", ЭтаФорма);	
	ОткрытьФорму("Документ.НастраиваемыйОтчет.Форма.ФормаСохраненияДокументаВБазу",,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	 	
КонецПроцедуры

&НаКлиенте
Процедура СохранениеФайлаВБазуЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
				
	СохранитьВБазуНаСервере(Результат);

	
КонецПроцедуры

&НаСервере
Процедура СохранитьВБазуНаСервере(Результат)
	
	ИмяВременногоФайла =  ПолучитьИмяВременногоФайла();  
	ТабличныйДокумент.Записать(ИмяВременногоФайла,Результат.ТипФайла);
	
	ИмяФайлаНаДиске = ИмяВременногоФайла;	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаНаДиске);
	ВременноеХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = ДокументСсылка;
	ПараметрыФайла.ИмяБезРасширения = Результат.ИмяФайла;
	
	
	Если Результат.ТипФайла = ТипФайлаТабличногоДокумента.PDF 
		ИЛИ Результат.ТипФайла = ТипФайлаТабличногоДокумента.PDF_A_1
		ИЛИ Результат.ТипФайла = ТипФайлаТабличногоДокумента.PDF_A_2
		ИЛИ Результат.ТипФайла = ТипФайлаТабличногоДокумента.PDF_A_3 Тогда
		
		ПараметрыФайла.РасширениеБезТочки = "pdf";

		
	ИначеЕсли Результат.ТипФайла = ТипФайлаТабличногоДокумента.XLS Тогда
		
		ПараметрыФайла.РасширениеБезТочки = "xls";
		
	ИначеЕсли Результат.ТипФайла = ТипФайлаТабличногоДокумента.XLSX Тогда
		
		ПараметрыФайла.РасширениеБезТочки = "xlsx";
		
	ИначеЕсли Результат.ТипФайла = ТипФайлаТабличногоДокумента.HTML
		ИЛИ Результат.ТипФайла = ТипФайлаТабличногоДокумента.HTML3
		ИЛИ Результат.ТипФайла = ТипФайлаТабличногоДокумента.HTML4
		ИЛИ Результат.ТипФайла = ТипФайлаТабличногоДокумента.HTML5 Тогда
 	
		ПараметрыФайла.РасширениеБезТочки = "html";
		
	ИначеЕсли Результат.ТипФайла = ТипФайлаТабличногоДокумента.DOCX  Тогда
		
		ПараметрыФайла.РасширениеБезТочки = "docx";
		
	ИначеЕсли Результат.ТипФайла = ТипФайлаТабличногоДокумента.ODS  Тогда
		
		ПараметрыФайла.РасширениеБезТочки = "ods";
		
	КонецЕсли;
 
		
	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, ВременноеХранилище);
	
КонецПроцедуры
