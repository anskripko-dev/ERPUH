
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Обработка расчета показателей
	РасчетИЗаписьПоказателей.УникальныйИдентификаторСеанса = УникальныйИдентификатор;
		
	Если Объект.Ссылка.Пустая() Тогда
		
		// Заполним по параметрам инициализации
		Если Параметры.Свойство("Объект") Тогда
			КопироватьДанныеФормы(Параметры.Объект, Объект);
		КонецЕсли;
		
		// Скопируем значения показателей
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			
			ОбработкаОбъект = РеквизитФормыВЗначение("РасчетИЗаписьПоказателей");
			Если НЕ ОбработкаОбъект.ОбработатьИзменениеКлючевогоСрезаЗначенийПоказателейОтчетов(Объект, Параметры.ЗначениеКопирования) Тогда
				ОбработкаОбъект.СообщитьОСобытиях();
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			ЗначениеВРеквизитФормы(ОбработкаОбъект, "РасчетИЗаписьПоказателей");
			
			// Запись в журнал действий
			Обработки.АналитическийБланк.ДобавитьЗаписьВЖурналДействий(ЭтаФорма,
				Перечисления.ТранзакцииИзмененияПоказателей.КопированиеЗначенийПоказателей, Строка(Параметры.ЗначениеКопирования));
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьСписокВыбораВалютСервер();
	
	ОбновитьПометкуКомандЗависимогоОбновленияЯчеек();
	
	#Область УниверсальныеПроцессыСогласование
	
	УправлениеПроцессамиСогласованияУХ.ОпределитьИспользованиеМаршрутаСогласования(Согласующий, ИспользуетсяМаршрутСогласования);
	
	СтруктураСостояний = Новый Структура;
	УправлениеПроцессамиСогласованияУХ.ЗаполнитьСтруктуруСостояний(СтруктураСостояний);
	НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта();
	
	ДанныеСостояний = Новый Структура;
	УправлениеПроцессамиСогласованияУХ.ВернутьДанныеСостоянийЭкземпляраОтчета(Объект.Ссылка, ДанныеСостояний);
	СостояниеЗаявки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСостояний, "СостояниеЗаявки");
	НовоеСостояниеДоИзменения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСостояний, "СостояниеЗаявки");
	
	Если ЗначениеЗаполнено(НовоеСостояниеДоИзменения) Тогда
		СостояниеСогласованияДоИзменения = НовоеСостояниеДоИзменения;
	КонецЕсли;
	
	ОпределитьСостояниеОбъекта();
		
	Если ИспользуетсяМаршрутСогласования Тогда
		ДействияСогласованиеУХСервер.ОпределитьСостояниеЗаявки(ЭтаФорма);
	КонецЕсли;
	
	РасширениеПроцессыИСогласованиеУХ.ПриСозданииНаСервереОбъект(ЭтаФорма);
	
	#КонецОбласти
	
	СогласованиеЧерезРакурс = Ложь;
	УправлениеПроцессамиСогласованияУХ.СогласованиеЧерезРакурс(Объект.ВидОтчета, СогласованиеЧерезРакурс);
	Если СогласованиеЧерезРакурс Тогда
		Элементы.ГруппаСтатусыСогласования.Видимость=Ложь;
		Элементы.ДекорацияРакурсы.Видимость=Истина;
		Элементы.НеВноситьИзменения.Видимость = Ложь;
	Иначе
		Элементы.НеВноситьИзменения.Пометка = Объект.НеВноситьИзменения;
	КонецЕсли;
	
	// Данные вида отчета
	ДанныеВидаОтчета = БюджетированиеИОтчетностьПовтИсп.ДанныеВидаОтчета(Объект.ВидОтчета);
	МаксАналитикОтчета = ДанныеВидаОтчета.МаксКлючевыхАналитик;
	РазделениеПоПроектам = ДанныеВидаОтчета.РазделениеПоПроектам;
	
	Элементы.ФормаРаботаСВерсиями.Доступность = ДанныеВидаОтчета.СохранятьИсториюИзменений;
	
	НомерОсновногоЯзыка = ПараметрыСеанса.ЯзыкОтчетности;
	ЧислоДопАналитик = ПараметрыСеанса.ЧислоДопАналитик;
	
	ТекущееПравилоОбработки = Документы.НастраиваемыйОтчет.ЗначениеНастройкиОбработкиДокумента(Объект, "ПравилоОбработки");
	
	АдресЛогаИзмененныхПоказателейREDO = ПоместитьВоВременноеХранилище(УправлениеРасчетомПоказателей.ОписаниеЛогаИзмененныхПоказателей(), УникальныйИдентификатор);
	
	Элементы.ГруппаТрассировкаРасчета.Видимость = Константы.ИспользоватьРежимТрассировкиПересчетаПоказателей.Получить();
	Элементы.ФормаОтобразитьПротокол.Видимость = ЕстьПротоколируемыеОшибки();
	
	Если ЗначениеЗаполнено(Объект.УправлениеПериодом) Тогда
		ПериодЗакрыт = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.УправлениеПериодом, "ПериодЗакрыт");
	Иначе
		ПериодЗакрыт = Ложь;
	КонецЕсли;
	Элементы.ДекорацияПериодЗакрыт.Видимость = ПериодЗакрыт;
	
	ТолькоПросмотр = ТолькоПросмотр ИЛИ ПериодЗакрыт;
	
	ШаблонОтчетаПриИзменении();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.Ссылка.Пустая() Тогда
		ПеревестиВРежимРедактирования();
		Модифицированность = Истина;
	КонецЕсли;
	
	Если (ТипЗнч(Параметры.МассивПоказателей) = Тип("ФиксированныйМассив")) И (ПолеТабличногоДокументаМакет.ВысотаТаблицы > 0) Тогда
		ВыделитьОбластиПоказателей(Параметры, Параметры.ПериодРасшифровки, Параметры.СтруктураОтбора);
	КонецЕсли;
	
	Если ИспользуетсяМаршрутСогласования Тогда
		ОпределитьДоступностьКнопок();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если НЕ ЗавершениеРаботы Тогда
		ПриЗакрытииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗакрытииНаСервере()
	
	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Добавим параметры записи
	ТекущийОбъект.ИдентификаторСеанса = УникальныйИдентификатор;
	ТекущийОбъект.АдресКэшаДанных = РасчетИЗаписьПоказателей.АдресКэшаДанных;
	
	Если ИзмененКлючевойРеквизит Тогда
		ТекущийОбъект.ИзмененКлючевойРеквизит = Истина;
		ТекущийОбъект.АдресИсходныхНастроек = АдресИсходныхНастроек;
	КонецЕсли;
	
	// Примечания
	ЗаполнитьПримечания(ТекущийОбъект);
	
	Если НуженПересчет Тогда
		
		Результат = Обработки.АналитическийБланк.ВыполнитьОтложенныйРасчетЗависимых(
			ЭтотОбъект, ТекущийОбъект.ВалютаОтображения);
		
		Если Результат Тогда
			Элементы.НадписьОбновитеТаблицу.Видимость = Ложь;
		Иначе
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Оповещение форм
	Оповестить("ИзмененОбъектОтчетности_НастраиваемыйОтчет", Объект.Ссылка);
	
	// Покажем протокол, если необходимо
	ОтобразитьПротокол();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Поменяем статус Документа
	ТекущийСтатус = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(ТекущийОбъект.Ссылка);
	ЕстьОписаниеВерсии = ЗначениеЗаполнено(МодульУправленияПроцессамиУХ
		.ВернутьТекущееОписаниеВерсииДляЭкземпляраОтчета(ТекущийОбъект.Ссылка));
	
	Если ТекущийСтатус = Перечисления.СостоянияОтчетов.Запланирован И ЕстьОписаниеВерсии Тогда
		НовоеСостояние = Перечисления.СостоянияОтчетов.Выполняется;
		УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(ТекущийОбъект.Ссылка, НовоеСостояние);
	КонецЕсли;
		
	// Транзакции
	Транзакции.Очистить();
	ТранзакцииПовторить.Очистить();
	Обработки.АналитическийБланк.УстановитьВидимостьДоступностьЭлементовЖурналаДействий(ЭтаФорма);
	
	РасчетИЗаписьПоказателей.АдресКэшаДанных = ТекущийОбъект.АдресКэшаДанных;
	РасчетИЗаписьПоказателей.АдресТаблицыСобытий = ТекущийОбъект.АдресТаблицыСобытий;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СвернутьВерсии"
		И ТипЗнч(Параметр) = Тип("Структура")
		И Параметр.ЭкземплярОтчета = Объект.Ссылка Тогда
		
		СвернутьДоВерсии(Параметр.ВерсияДляСвертки);
		
	ИначеЕсли ИмяСобытия = "ПеревестиВРежимРедактирования" Тогда
		
		ДействияФормыРедактирование(Неопределено);
		
	ИначеЕсли ИмяСобытия = "ИзменилисьПоказатели" Тогда
		
		РедактированиеРаскрытияЗавершение(Параметр,Параметр);
		
	ИначеЕсли ИмяСобытия = "ЗаписанДокументКорректировки" И Параметр = ЭтаФорма Тогда
		
		ВывестиДанныеЭкземпляра();
		
	ИначеЕсли ИмяСобытия = "ОбновитьДанныеПослеАктуализации" Тогда
		
		ВывестиДанныеЭкземпляра();
		
	КонецЕсли;
	
	#Область УниверсальныеПроцессыСогласование
	
	Если ИмяСобытия = "ОбъектСогласован" Тогда
		ОпределитьСостояниеОбъекта();
	ИначеЕсли ИмяСобытия = "ОбъектОтклонен" Тогда
		ОпределитьСостояниеОбъекта();
	ИначеЕсли ИмяСобытия = "МаршрутИнициализирован" Тогда
		ОпределитьСостояниеОбъекта();
	ИначеЕсли ИмяСобытия = "СостояниеЗаявкиПриИзменении" Тогда
		ОпределитьСостояниеОбъекта();
		Элементы.ФормаОтобразитьПротокол.Видимость = ЕстьПротоколируемыеОшибки();
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиОповещений

&НаСервере
Процедура СвернутьДоВерсии(ВерсияДляСвертки)
	
	РабочийОбъект = РеквизитФормыВЗначение("Объект");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОписаниеВерсий.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОписаниеВерсий КАК ОписаниеВерсий
	|ГДЕ
	|	ОписаниеВерсий.ЭкземплярОтчета = &ЭкземплярОтчета
	|	И НЕ ОписаниеВерсий.ЧерноваяВерсия
	|	И НЕ(ОписаниеВерсий.Регистратор = НЕОПРЕДЕЛЕНО
	|				ИЛИ ТИПЗНАЧЕНИЯ(ОписаниеВерсий.Регистратор) = ТИП(Документ.НастраиваемыйОтчет))
	|	И ОписаниеВерсий.Код <= &КодОписанияВерсии
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОписаниеВерсий.Код";
	
	Запрос.УстановитьПараметр("ЭкземплярОтчета", РабочийОбъект.Ссылка);
	Запрос.УстановитьПараметр("КодОписанияВерсии", ВерсияДляСвертки.Код);
	ТаблицаОписанийВерсийРучныхОпераций = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаОписанийВерсийРучныхОпераций.Количество() = 0 Тогда
		РабочийОбъект.СвернутьВерсии(Неопределено, ВерсияДляСвертки);
	Иначе
		РабочийОбъект.СвернутьВерсии(Неопределено, ТаблицаОписанийВерсийРучныхОпераций[0].Ссылка);
		Для Инд = 0 По ТаблицаОписанийВерсийРучныхОпераций.Количество() - 2 Цикл
			РабочийОбъект.СвернутьВерсии(ТаблицаОписанийВерсийРучныхОпераций[Инд].Ссылка, ТаблицаОписанийВерсийРучныхОпераций[Инд + 1].Ссылка);
		КонецЦикла;
		РабочийОбъект.СвернутьВерсии(ТаблицаОписанийВерсийРучныхОпераций[ТаблицаОписанийВерсийРучныхОпераций.Количество() - 1].Ссылка, ВерсияДляСвертки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеРаскрытияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("УИДФормыВладельца") И Результат.УИДФормыВладельца<>УникальныйИдентификатор Тогда
		Возврат;
	КонецЕсли;
	
	тОбластьИмя = ЭтаФорма[ТекущийМакет].ТекущаяОбласть.Имя;
	РедактированиеРаскрытиеЗавершениеСервер(Результат,тОбластьИмя);
	ВывестиДанныеЭкземпляра();
	УстановитьРежимРедактированияДанных(Ложь);
	Модифицированность = Истина;
	
	ОтобразитьПротокол();
	
КонецПроцедуры

&НаСервере
Процедура РедактированиеРаскрытиеЗавершениеСервер(Результат,тОбластьИмя)
	
	Если Не ЗначениеЗаполнено(Результат.АдресТаблицыИзмененныхПоказателей) Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ВычислятьАвтоматически.Пометка Тогда
		
		// Выполним расчет зависимых показателей
		ОбработкаОбъект = РеквизитФормыВЗначение("РасчетИЗаписьПоказателей");
		ПараметрыРасчета = ОбработкаОбъект.ПараметрыРасчета();
		ПараметрыРасчета.АдресТаблицыИзмененныхПоказателей = Результат.АдресТаблицыИзмененныхПоказателей;
		ПараметрыРасчета.НомерТранзакции = НомерТранзакции;
		Результат = ОбработкаОбъект.РассчитатьПоЗначениямИзмененныхПоказателей(ПараметрыРасчета);
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "РасчетИЗаписьПоказателей");
		
	Иначе
		
		// Поместим в лог для отложенного расчета зависимых
		Результат = Обработки.АналитическийБланк.ДобавитьЗначенияПоказателейВЛог(
			ЭтаФорма, Результат.АдресТаблицыИзмененныхПоказателей);
		
	КонецЕсли;
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	Обработки.АналитическийБланк.ДобавитьЗаписьВЖурналДействий(ЭтаФорма,
	Перечисления.ТранзакцииИзмененияПоказателей.ИзменениеПоказателя,
	ЭтаФорма[ТекущийМакет].Область(тОбластьИмя));
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#Область НастройкиДокумента

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Объект", Объект);
	СтруктураПараметров.Вставить("Ключ", Объект.Ссылка);
	СтруктураПараметров.Вставить("СтатусОбъекта", СтатусОбъекта);
	СтруктураПараметров.Вставить("МаксАналитикОтчета", МаксАналитикОтчета);
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("ОткрытьНастройкиОтчетаЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Документ.НастраиваемыйОтчет.Форма.ФормаНастроекДокумента", 
		СтруктураПараметров, ЭтаФорма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьНастройкиОтчетаЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		Если ВыбранноеЗначение.ИзмененКлючевойРеквизит Тогда
			ОповещениеЗакрытьФорму = Новый ОписаниеОповещения("ВопросНоваяФормаЗавершение", ЭтаФорма, ВыбранноеЗначение.Объект);
			ПоказатьВопрос(ОповещениеЗакрытьФорму, НСтр("ru = 'Для продолжения работы с выбранными настройками необходимо заново открыть форму, продолжить?'"), РежимДиалогаВопрос.ДаНет);	
			Возврат;
		КонецЕсли;
		
		РасчетИЗаписьПоказателей.АдресКэшаДанных = Неопределено;
		ВыставитьВыбранныеНастройкиИОбновитьФорму(ВыбранноеЗначение.Объект);
		
		Модифицированность = Истина;
		ВосстановитьСверткуСтрокКолонокДляТекущейСтраницы();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросНоваяФормаЗавершение(Результат, ИзмененныйОбъект) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененКлючевойРеквизит = Истина;
	
	// Исходные настройки отчета
	СтруктураИсходныхНастроек = Новый Структура;
	СтруктураИсходныхНастроек.Вставить("Ссылка", Объект.Ссылка);
	СтруктураИсходныхНастроек.Вставить("ПериодОтчета", Объект.ПериодОтчета);
	СтруктураИсходныхНастроек.Вставить("ПериодОкончания", Объект.ПериодОкончания);
	СтруктураИсходныхНастроек.Вставить("ВидОтчета", Объект.ВидОтчета);
	СтруктураИсходныхНастроек.Вставить("Сценарий", Объект.Сценарий);
	СтруктураИсходныхНастроек.Вставить("Организация", Объект.Организация);
	СтруктураИсходныхНастроек.Вставить("Проект", Объект.Проект);
	СтруктураИсходныхНастроек.Вставить("Валюта", Объект.ОсновнаяВалюта);
	СтруктураИсходныхНастроек.Вставить("МаксАналитикОтчета", МаксАналитикОтчета);
	Для Сч = 1 По МаксАналитикОтчета Цикл
		СтруктураИсходныхНастроек.Вставить("Аналитика" + Сч, Объект["Аналитика" + Сч]);
	КонецЦикла;
	АдресИсходныхНастроек = ПоместитьВоВременноеХранилище(СтруктураИсходныхНастроек, УникальныйИдентификатор);
	
	КопироватьДанныеФормы(ИзмененныйОбъект, Объект);
	Записать();
	ОтобразитьПротокол();
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеОтчета

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	
	ЗаполнитьЗавершение(Новый Структура("СпособФормированияОтчета", Неопределено));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПрочимСпособом(Команда)
	
	Если КэшПараметрыОткрытия = Неопределено Тогда
		
		КэшПараметрыОткрытия = Новый Структура;
		КэшПараметрыОткрытия.Вставить("ВидОтчета", Объект.ВидОтчета);
		КэшПараметрыОткрытия.Вставить("Организация", Объект.Организация);
		КэшПараметрыОткрытия.Вставить("УправлениеПериодом", Объект.УправлениеПериодом);
		Если РазделениеПоПроектам Тогда
			КэшПараметрыОткрытия.Вставить("Проект", Объект.Проект);
		КонецЕсли;
		Для Сч = 1 По МаксАналитикОтчета Цикл
			КэшПараметрыОткрытия.Вставить("Аналитика" + Сч, Объект["Аналитика" + Сч]);
		КонецЦикла;
		
		КэшПараметрыОткрытия.Вставить("ПравилоПроверки", Неопределено);
		КэшПараметрыОткрытия.Вставить("ПравилоОбработки", Неопределено);
		КэшПараметрыОткрытия.Вставить("СпособФормированияОтчета", Неопределено);
		КэшПараметрыОткрытия.Вставить("БланкДляИмпорта", Неопределено);
		КэшПараметрыОткрытия.Вставить("ВнешняяИнформационнаяБаза", Неопределено);
		КэшПараметрыОткрытия.Вставить("ПериодичностьСвертывания", Неопределено);
		
		КэшПараметрыОткрытия.Вставить("ФайлИмпорта", Объект.ФайлИмпорта);
		КэшПараметрыОткрытия.Вставить("СпособИмпортирования", 0);
		КэшПараметрыОткрытия.Вставить("ПутьКФайлу", "");
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПослеВыбораСпособаРасчетаПоказателей", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ВыборСпособаРасчетаПоказателей",
		КэшПараметрыОткрытия, , , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПослеВыбораСпособаРасчетаПоказателей(ПараметрыРасчета, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если ПараметрыРасчета = Неопределено ИЛИ ПараметрыРасчета = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	// Закэшируем выбранные значения
	Если КэшПараметрыОткрытия <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(КэшПараметрыОткрытия, ПараметрыРасчета);
	КонецЕсли;
	
	Если ПараметрыРасчета.НужнаОбработкаФайла Тогда
		
		// Использование внешнего файла
		ПараметрыРасчета.Вставить("Форма", ЭтаФорма);
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Организация", Объект.Организация);
		СтруктураОтбора.Вставить("Сценарий", Объект.Сценарий);
		СтруктураОтбора.Вставить("ПериодСценария", Объект.ПериодОтчета);
		ПараметрыРасчета.Вставить("СтруктураОтбора", СтруктураОтбора);
		
		БюджетированиеИОтчетностьКлиент.ОбработатьИмпортФайла(ПараметрыРасчета);
		
	Иначе
		// Расчет значений показателей
		ЗаполнитьЗавершение(ПараметрыРасчета);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ЗаполнитьЗавершение(ПараметрыРасчета) Экспорт
	
	РассчитатьЗначенияПоказателей(ПараметрыРасчета);
	
	ОтобразитьПротокол();
	
	ВосстановитьСверткуСтрокКолонокДляТекущейСтраницы();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьЗначенияПоказателей(ПараметрыРасчета)
	
	// Проверка на включение режима редактирования перед заполнением
	Если Не Заблокирован Тогда
		Заблокирован = ПодготовитьОтчетДляРедактирования();
		Если Заблокирован Тогда
			Элементы.Редактирование.Пометка = Истина;
			Элементы.ГруппаРазрешитьРедактирование.Видимость = Не Заблокирован;
			Элементы.ГруппаКнопокРедактированияТаблицы.Видимость = Заблокирован;
			Элементы.Очистить.Доступность = Заблокирован;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Поместим данные файлы во временное хранилище, если необходимо
	Если ПараметрыРасчета.Свойство("УточнениеСпособаФормированияОтчета")
		И ЗначениеЗаполнено(ПараметрыРасчета.УточнениеСпособаФормированияОтчета) Тогда
		ПараметрыРасчета.УточнениеСпособаФормированияОтчета = ПоместитьВоВременноеХранилище(ПараметрыРасчета.УточнениеСпособаФормированияОтчета);
	КонецЕсли;
	
	// Непосредственное заполнение отчета
	ОбработкаРасчета = РеквизитФормыВЗначение("РасчетИЗаписьПоказателей");
	Результат = ОбработкаРасчета.ЗаполнитьДанныеПоПериодам(Объект, ПараметрыРасчета, НомерТранзакции);
	ЗначениеВРеквизитФормы(ОбработкаРасчета, "РасчетИЗаписьПоказателей");
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	// Запись в журнал действий
	Обработки.АналитическийБланк.ДобавитьЗаписьВЖурналДействийПослеРасчета(ЭтаФорма, ПараметрыРасчета);
	
	// Обновление формы
	НуженПересчет = Ложь;
	ВывестиДанныеЭкземпляра();
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеЯчеек

&НаКлиенте
Процедура ОбновлятьЯчейкиАвтоматически(Команда)
	
	Объект.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек = ПредопределенноеЗначение("Перечисление.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек.АвтоматическиВсе");
	ОбновитьПометкуКомандЗависимогоОбновленияЯчеек();
	ВывестиДанныеЭкземпляра();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлятьЯчейкиВручную(Команда)
	
	Объект.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек = ПредопределенноеЗначение("Перечисление.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек.Вручную");
	ОбновитьПометкуКомандЗависимогоОбновленияЯчеек();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПометкуКомандЗависимогоОбновленияЯчеек()
	
	Если Объект.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек = Перечисления.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек.АвтоматическиВсе Тогда
		Элементы.ВычислятьАвтоматически.Пометка = Истина;
		Элементы.РучнойПересчет.Пометка = Ложь;
	ИначеЕсли Объект.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек = Перечисления.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек.Вручную Тогда
		Элементы.ВычислятьАвтоматически.Пометка = Ложь;
		Элементы.РучнойПересчет.Пометка = Истина;
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область Редактирование

&НаКлиенте
Процедура ДействияФормыРедактирование(Команда)
	
	Если НЕ Элементы.Редактирование.Пометка Тогда
		ПеревестиВРежимРедактирования();
	Иначе
		ОбщегоНазначенияКлиентУХ.ПроверитьМодифицированность(ЭтаФорма, "ДействияФормыВыйтиИзРежимаРедактирования");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияФормыВыйтиИзРежимаРедактирования() Экспорт
	
	Заблокирован = Ложь;
	
	ТекПометка = Не Элементы.Редактирование.Пометка;
	Элементы.Редактирование.Пометка = ТекПометка;
	Элементы.ГруппаРазрешитьРедактирование.Видимость = Не ТекПометка;
	Элементы.ГруппаКнопокРедактированияТаблицы.Видимость = ТекПометка;
	Элементы.Очистить.Доступность = ТекПометка;
	
	ЗавершитьРедактированиеНаСервере();
	ВосстановитьСверткуСтрокКолонокДляТекущейСтраницы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиВРежимРедактирования()
	
	Заблокирован = ПодготовитьОтчетДляРедактирования();
	
	Элементы.Редактирование.Пометка = Заблокирован;
	Элементы.ГруппаРазрешитьРедактирование.Видимость = Не Заблокирован;
	Элементы.ГруппаКнопокРедактированияТаблицы.Видимость = Заблокирован;
	Элементы.Очистить.Доступность = Заблокирован;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеЯчеек

&НаКлиенте
Процедура ОбновитьСУчетомВерсий(Команда)
	
	ОбновитьСУчетомВерсийНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСУчетомВерсийНаКлиенте()
	
	ОбновитьСУчетомВерсийНаСервере();
	АналитическийБланкУХКлиент.ВосстановитьСверткуСтрокКолонок(ЭтотОбъект);
	
	ОтобразитьПротокол();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСУчетомВерсийНаСервере()
	
	Результат = Истина;
	Если НуженПересчет Тогда
		Результат = Обработки.АналитическийБланк.ВыполнитьОтложенныйРасчетЗависимых(
			ЭтотОбъект, Объект.ВалютаОтображения);
	КонецЕсли;
	
	Если Результат Тогда
		ВывестиДанныеЭкземпляра();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиБланки(МассивСтраниц,ДанныеДиаграмм = Ложь)
	
	Если РежимБланка = 1 Тогда
			
		ВывестиМакетАналитическийБланкСводнаяТаблица();
		
	ИначеЕсли РежимБланка = 2 Тогда
	
		КлючевыеПараметры = Новый Структура;
		КлючевыеПараметры.Вставить("Сценарий",Объект.Сценарий);
		КлючевыеПараметры.Вставить("ПериодОтчета",Объект.ПериодОтчета);
		КлючевыеПараметры.Вставить("ПериодОкончания",Объект.ПериодОкончания);
		КлючевыеПараметры.Вставить("Валюта",Объект.ВалютаОтображения);
		КлючевыеПараметры.Вставить("ИспользоватьБыстрыйОтборПоОрганизации",Истина);
		КлючевыеПараметры.Вставить("Организация",Объект.Организация);
		КлючевыеПараметры.Вставить("Проект",Объект.Проект);
		
		КлючевыеПараметры.Вставить("ИспользоватьБыстрыйОтборПоАналитикамВерсии",Истина);
		Для Инд = 1 По ЧислоДопАналитик Цикл
			КлючевыеПараметры.Вставить("Аналитика"+Инд, Объект["Аналитика"+Инд]);
		КонецЦикла;
		
		КлючевыеПараметры.Вставить("УровеньТочности", Объект.УровеньТочности);
		КлючевыеПараметры.Вставить("ТекущийДелитель", ТекущийДелитель);
		КлючевыеПараметры.Вставить("НомерОсновногоЯзыка",НомерОсновногоЯзыка);
		КлючевыеПараметры.Вставить("ТекущееПравило", ТекущееПравилоОбработки);
		
		КлючевыеПараметры.Вставить("логИзмененныхДанныхАдрес",логИзмененныхДанныхАдрес);
		КлючевыеПараметры.Вставить("логИзмененныхКомментариевАдрес",логИзмененныхКомментариевАдрес);
		КлючевыеПараметры.Вставить("УникальныйИдентификатор",УникальныйИдентификатор);
		КлючевыеПараметры.Вставить("ДополнительныеПараметрыАдрес","");
		КлючевыеПараметры.Вставить("ИдентификаторСеанса",УникальныйИдентификатор);
		
		Обработки.АналитическийБланк.ВывестиБланки(КлючевыеПараметры,ЭтаФорма,МассивСтраниц,ДанныеДиаграмм);
		
	КонецЕсли;
	
	Если Элементы.НадписьОбновитеТаблицу.Видимость И НЕ НуженПересчет Тогда
		Элементы.НадписьОбновитеТаблицу.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОчисткаЯчеек

&НаКлиенте
Процедура ДействияФормыОчистить(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДействияФормыОчиститьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'После выполнения операции будут очищены все показатели отчета. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияФормыОчиститьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОчиститьДокумент();
		ВывестиДанныеЭкземпляра();
		Модифицированность = Истина;
	КонецЕсли;
	
	ВосстановитьСверткуСтрокКолонокДляТекущейСтраницы();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДокумент()
	
	Если Не Заблокирован Тогда
		Заблокирован = ПодготовитьОтчетДляРедактирования();
		Если Заблокирован Тогда
			Элементы.Редактирование.Пометка = Истина;
			Элементы.ГруппаРазрешитьРедактирование.Видимость = Не Заблокирован;
			Элементы.ГруппаКнопокРедактированияТаблицы.Видимость = Заблокирован;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураДопОтборов = Новый Структура;
	Для Инд =1 По ЧислоДопАналитик Цикл
		Если Объект["Аналитика"+Инд] <> Неопределено Тогда
			СтруктураДопОтборов.Вставить(Объект.ВидОтчета["ВидАналитики"+Инд].Код,Объект["Аналитика"+Инд]);
		КонецЕсли;
	КонецЦикла;
	
	Периоды = ПериодыУХ.ПолучитьПодчиненныеПериоды(Объект.ПериодОтчета,Объект.ПериодОкончания,Объект.ПериодОтчета.Периодичность);
	
	Обработки.АналитическийБланк.ОчиститьПоказателиТекущегоЭкземпляраОтчета(ЭтаФорма, Объект.ВалютаОтображения, Периоды, СтруктураДопОтборов);
	
КонецПроцедуры
	
#КонецОбласти

#Область РаботаСВерсиями

&НаКлиенте
Процедура РаботаСВерсиями(Команда)
	
	ОбщегоНазначенияКлиентУХ.ПроверитьМодифицированность(ЭтаФорма, "РаботаСВерсиямиВызов");
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаСВерсиямиВызов() Экспорт
	
	Если НЕ ПолныеПраваУХ.ПроверитьВозможностьЗаписиПоБланкуОтчета(Объект.ШаблонОтчета, Объект.Организация) Тогда
		Возврат;
	КонецЕсли;
		
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЭкземплярОтчета", Объект.Ссылка);
	СтруктураПараметров.Вставить("МногопериодныйРежим", Истина);
	СтруктураПараметров.Вставить("ТекущийБланк", ЭтаФорма[ТекущийОбъектАБ].Бланк);	
	СтруктураПараметров.Вставить("ВидОтчета",Объект.ВидОтчета);
	СтруктураПараметров.Вставить("Сценарий",Объект.Сценарий);
	СтруктураПараметров.Вставить("Организация",Объект.Организация);
	СтруктураПараметров.Вставить("Проект",Объект.Проект);
	СтруктураПараметров.Вставить("ПериодОтчета",Объект.ПериодОтчета);
	СтруктураПараметров.Вставить("ПериодОкончания",Объект.ПериодОкончания);
	Для Инд =1 По ЧислоДопАналитик Цикл
		СтруктураПараметров.Вставить("Аналитика"+Инд,Объект["Аналитика"+Инд]);
	КонецЦикла;
	СтруктураПараметров.Вставить("РежимФормы", 2);
	
	Оповещение = Новый ОписаниеОповещения("ИзменениеВерсийЗавершение", ЭтаФорма);
	ОткрытьФорму("Справочник.ОписаниеВерсий.Форма.ФормаСписка", 
		СтруктураПараметров, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ИзменениеВерсийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Модифицированность Тогда
		ВывестиДанныеЭкземпляра();
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

