#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала = ДатаНачала;
	Диалог.Период.ДатаОкончания = ДатаОкончания;

	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
		
	Если ТипЗнч(РезультатВыбора) <> Тип("СтандартныйПериод") Тогда
		// Период не выбран
		Возврат;
	КонецЕсли;
		
	Если ДатаНачала = РезультатВыбора.ДатаНачала
		И ДатаОкончания = РезультатВыбора.ДатаОкончания Тогда
		// Выбран тот же период
		Возврат;
	КонецЕсли;
	
	ДатаНачала = РезультатВыбора.ДатаНачала;
	ДатаОкончания = РезультатВыбора.ДатаОкончания;
	
	ИзменитьПериодНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПериодНаСервере()
	
	ИзмененКлючевойРеквизит = Истина;

	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) Тогда
		
		ПериодыУХПовтИсп.ПроверитьИнтервалПериодов(ДатаНачала, ДатаОкончания, ПериодичностьОтчета);
		
		Объект.ПериодОтчета = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ДатаНачала, ПериодичностьОтчета);
		Объект.ПериодОкончания = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ДатаОкончания, ПериодичностьОтчета);

	КонецЕсли;
	
	УстановитьПараметрыПоКлючевымРеквизитам();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИЗакрыть(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПроверкаПравБланк = ПроверитьВозможностьОтображенияПоБланкуОтчета(Объект.ШаблонОтчета, Объект.Организация);
	Если НЕ ПустаяСтрока(ТекстПроверкаПравБланк) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстПроверкаПравБланк);
		Возврат;
	КонецЕсли;
	
	Если ПроверитьНаличиеДокументовСРеквизитамиТекущего() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИзмененыНастройкиОбработкиДокумента Тогда
		Если НЕ СохранитьНастройкиОбработкиДокумента() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Модифицированность = Ложь;
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("Объект", Объект);
	
	Если ВводНовогоДокумента Тогда
		ПараметрыЗакрытия.Вставить("ЗначениеКопирования", ЗначениеКопирования);
		ОткрытьФорму("Документ.НастраиваемыйОтчет.ФормаОбъекта", ПараметрыЗакрытия);
		Закрыть();
	Иначе
		ПараметрыЗакрытия.Вставить("ИзмененКлючевойРеквизит", ИзмененКлючевойРеквизит);
		Закрыть(ПараметрыЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СохранитьНастройкиОбработкиДокумента()
	
	Отказ = Ложь;
	
	ПараметрыНастроек = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов(Объект);
	ПараметрыНастроек.ШаблонДокумента = Объект.ВидОтчета;
	ПараметрыНастроек.ВерсияРегламента = ВерсияРегламента;
	УправлениеОтчетамиУХ.УстановитьНастройкиОбработкиШаблонов(ПараметрыНастроек, ЭтаФорма, Отказ);
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Процедура Отмена(Команда)

	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеВидимостьюДанныхВидаОтчета()
	
	ДанныеВидаОтчета = БюджетированиеИОтчетностьПовтИсп.ДанныеВидаОтчета(Объект.ВидОтчета);
	
	Если ДанныеВидаОтчета.РазделениеПоПроектам Тогда
		Элементы.Проект.Видимость = Истина;
	Иначе
		Объект.Проект = Неопределено;
		Элементы.Проект.Видимость = Ложь;
	КонецЕсли;

	Для Сч = 1 По ДанныеВидаОтчета.МаксКлючевыхАналитик Цикл
		ТекущийЭлемент = Элементы["Аналитика"+Сч];
		ТекущийЭлемент.Видимость = Истина;
		ТипЗначенияАналитики = ДанныеВидаОтчета["ТипЗначенияАналитики"+Сч];
		Если ТипЗначенияАналитики.Типы().Количество() = 1 Тогда
			ТекущийЭлемент.ВыбиратьТип = Ложь;
			Если НЕ ЗначениеЗаполнено(Объект["Аналитика"+Сч]) Тогда
				Объект["Аналитика"+Сч] = ТипЗначенияАналитики.ПривестиЗначение();
			КонецЕсли;
		Иначе
			ТекущийЭлемент.АвтоОтметкаНезаполненного = Истина;
		КонецЕсли;
		ТекущийЭлемент.ОграничениеТипа = ТипЗначенияАналитики;
		Если ТипЗначенияАналитики.СодержитТип(Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ")) Тогда
			БюджетированиеИОтчетность.УстановитьПараметрыВыбора(ТекущийЭлемент, "Отбор.Владелец", ДанныеВидаОтчета["ВидАналитики"+Сч]);
		КонецЕсли;
	КонецЦикла;
	
	Для Сч = ДанныеВидаОтчета.МаксКлючевыхАналитик+1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Объект["Аналитика"+Сч] = Неопределено;
		Элементы["Аналитика"+Сч].Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОграничитьРедактированиеКлючевыхРеквизитов(Форма, МаксАналитикОтчета)
	
	Элементы = Форма.Элементы;
	
	Элементы.ГруппаТолькоПросмотр.Видимость = Истина;
	Элементы.НадписьТолькоПросмотр.Заголовок = НСтр("ru = 'Экземпляр отчета утвержден. Ключевые реквизиты недоступны для редактирования.'");
	Элементы.ИзменитьПериод.Доступность = Ложь;
	
	Элементы.ВидОтчета.ТолькоПросмотр = Истина;
	Элементы.Сценарий.ТолькоПросмотр = Истина;
	Элементы.УправлениеПериодом.ТолькоПросмотр = Истина;
	Элементы.ПериодичностьОтчета.ТолькоПросмотр = Истина;
	Элементы.Организация.ТолькоПросмотр = Истина;
	Элементы.Проект.ТолькоПросмотр = Истина;
	Для Номер = 1 По МаксАналитикОтчета Цикл
		Элементы["Аналитика" + Номер].ТолькоПросмотр = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыПоКлючевымРеквизитам()
	
	///////////////////////////////////////////////
	// Обновим данные управления периодом сценария
	ДанныеУПС = БюджетированиеИОтчетностьПовтИсп.НайтиУправлениеПериодомСценария(Объект.Сценарий, Объект.ПериодОтчета);
	Если НЕ ЗначениеЗаполнено(ДанныеУПС.УправлениеПериодом)
		И ЗначениеЗаполнено(Объект.Сценарий) И ЗначениеЗаполнено(Объект.ПериодОтчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить документ управления отчетным периодом по параметрам:
			|	Сценарий: ""%1"",
			|	Период: ""%2""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Объект.Сценарий, Объект.ПериодОтчета);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	///////////////////////////////////////////////
	// Обновим связанные реквизиты, если необходимо
	Если Объект.УправлениеПериодом <> ДанныеУПС.УправлениеПериодом Тогда
		Объект.УправлениеПериодом = ДанныеУПС.УправлениеПериодом;
		ИзмененКлючевойРеквизит = Истина;
	КонецЕсли;
	Если Объект.ПериодОтчета <> ДанныеУПС.ПериодСценария Тогда
		Объект.ПериодОтчета = ДанныеУПС.ПериодСценария;
		ИзмененКлючевойРеквизит = Истина;
	КонецЕсли;
	Если Объект.ПериодОкончания <> ДанныеУПС.ПериодСценарияОкончание Тогда
		Объект.ПериодОкончания = ДанныеУПС.ПериодСценарияОкончание;
		ИзмененКлючевойРеквизит = Истина;
	КонецЕсли;
	
	Если ВерсияРегламента <> ДанныеУПС.ВерсияРегламента Тогда
		ВерсияРегламента = ДанныеУПС.ВерсияРегламента;
		Если ИзмененКлючевойРеквизит Тогда
			// Изменены ключевые реквизиты и поменялся регламент
			Объект.ОсновнаяВалюта = Неопределено;
			Объект.ВалютаОтображения = Неопределено;
		КонецЕсли;
		БюджетированиеИОтчетность.ОграничитьОрганизацииПоРегламенту(ВерсияРегламента, Объект.Организация, Элементы.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеУПС.Периодичность) Тогда
		ПериодичностьОтчета = ДанныеУПС.Периодичность;
	КонецЕсли;
	ДатаНачала = ДанныеУПС.ДатаНачала;
	ДатаОкончания = ДанныеУПС.ДатаОкончания;
	
	///////////////////////////////////////////////
	// Рассчитаем настройки обработки показателей
	УстановитьНастройкиОбработкиДокумента();
	
	///////////////////////////////////////////////
	// Заполним валюты отчетности
	Элементы.ВалютаОтображения.СписокВыбора.Очистить();
	ДополнительныеВалюты = "";
	
	тВалюты = БюджетированиеИОтчетностьПовтИсп.ВалютыОтчетности(Объект.УправлениеПериодом, Объект.Организация, Объект.ВидОтчета);
	Для Каждого СтрокаВалюты Из тВалюты Цикл
		Элементы.ВалютаОтображения.СписокВыбора.Добавить(СтрокаВалюты.Валюта, СтрокаВалюты.ВалютаПредставление);
		Если СтрокаВалюты.ОсновнаяВалюта Тогда
			Если Объект.ОсновнаяВалюта <> СтрокаВалюты.Валюта Тогда
				Объект.ОсновнаяВалюта = СтрокаВалюты.Валюта;
				ИзмененКлючевойРеквизит = Истина;
			КонецЕсли;
		Иначе
			ДополнительныеВалюты = ДополнительныеВалюты
				+ ?(ДополнительныеВалюты = "", "", "; ")
				+ СтрокаВалюты.ВалютаПредставление;
		КонецЕсли;
	КонецЦикла;
	
	Если ИзмененКлючевойРеквизит Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	Элементы.ДополнительныеВалюты.Видимость = НЕ ПустаяСтрока(ДополнительныеВалюты);
	
	Если НЕ ЗначениеЗаполнено(Объект.ВалютаОтображения) Тогда
		Объект.ВалютаОтображения = Объект.ОсновнаяВалюта;
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() И НЕ ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
		УправлениеОтчетамиУХ.ЗаполнитьПараметрыОтображения(
			Объект.ЕдиницаИзмерения, Объект.УровеньТочности, Объект.ШаблонОтчета);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиОбработкиДокумента()
	
	ПараметрыНастроек = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов(Объект);
	ПараметрыНастроек.ШаблонДокумента = Объект.ВидОтчета;
	ПараметрыНастроек.ВерсияРегламента = ВерсияРегламента;
	
	НастройкиОбработкиДокумента = УправлениеОтчетамиУХ.НастройкиОбработкиШаблонов(ПараметрыНастроек);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкиОбработкиДокумента);
	Объект.ШаблонОтчета = НастройкиОбработкиДокумента.БланкДляОтображения;
	ИзмененыНастройкиОбработкиДокумента = Ложь;
	
	БюджетированиеИОтчетность.ЗаполнитьЭлементыОбработкиПоказателейОтчетов(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеДокументовСРеквизитамиТекущего()
	
	Если ПолныеПраваУХ.ПроверитьНаличиеДокументовСРеквизитамиТекущего(Объект) Тогда
		ТекстСообщения = НСтр("ru = 'Уже существует экземпляр отчета с указанными ключевыми реквизитами.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьВозможностьОтображенияПоБланкуОтчета(ШаблонОтчета, Организация)
	
	Возврат ПолныеПраваУХ.ПроверитьВозможностьОтображенияПоБланкуОтчета(ШаблонОтчета, Организация);
	
КонецФункции

#КонецОбласти
