КонецПроцедуры

&НаСервере
Процедура ШаблонОтчетаПриИзмененииНаСервере()
	
	РежимБланка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ШаблонОтчета, "РежимБланка");
	Если РежимБланка = 1 Тогда
		Объект.СпособВывода = "СводнаяТаблица";
	ИначеЕсли РежимБланка = 2 Тогда
		Объект.СпособВывода = "Бланк";
	Иначе
		Объект.СпособВывода = "";
	КонецЕсли;
	
	БланкДляОтображения = Объект.ШаблонОтчета;
	
	УправлениеОтчетамиУХ.ЗаполнитьПараметрыОтображения(
		Объект.ЕдиницаИзмерения, Объект.УровеньТочности, Объект.ШаблонОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	КлючевойРеквизитПриИзменении();
	СценарийПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СценарийПриИзмененииНаСервере()
	
	ПодобратьПериодПоСценарию();
	
	УстановитьПараметрыПоКлючевымРеквизитам();
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьПериодПоСценарию()

	// Заполним период, если для данного сценария он один
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УправлениеПериодомСценария.ПериодСценария КАК ПериодСценария
		|ИЗ
		|	Документ.УправлениеПериодомСценария КАК УправлениеПериодомСценария
		|ГДЕ
		|	УправлениеПериодомСценария.Сценарий = &Сценарий
		|	И НЕ УправлениеПериодомСценария.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Сценарий", Объект.Сценарий);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Количество() = 1 Тогда
		ВыборкаДетальныеЗаписи.Следующий();
		Объект.ПериодОтчета = ВыборкаДетальныеЗаписи.ПериодСценария;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
