
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВводНовогоДокумента = Истина;
	Если Параметры.Свойство("Объект") Тогда
		
		// Существующий документ
		КопироватьДанныеФормы(Параметры.Объект, Объект);
		ВводНовогоДокумента = Ложь;
		
	ИначеЕсли ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		
		// Документ создается копированием
		ЗначениеКопирования = Параметры.ЗначениеКопирования;
		Элементы.ЗначениеКопирования.Видимость = Истина;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НастраиваемыйОтчет.ВидОтчета КАК ВидОтчета,
			|	НастраиваемыйОтчет.ШаблонОтчета КАК ШаблонОтчета,
			|	НастраиваемыйОтчет.Проект КАК Проект,
			|	НастраиваемыйОтчет.Аналитика1 КАК Аналитика1,
			|	НастраиваемыйОтчет.Аналитика2 КАК Аналитика2,
			|	НастраиваемыйОтчет.Аналитика3 КАК Аналитика3,
			|	НастраиваемыйОтчет.Аналитика4 КАК Аналитика4,
			|	НастраиваемыйОтчет.Аналитика5 КАК Аналитика5,
			|	НастраиваемыйОтчет.Аналитика6 КАК Аналитика6,
			|	НастраиваемыйОтчет.Сценарий КАК Сценарий,
			|	НастраиваемыйОтчет.УправлениеПериодом КАК УправлениеПериодом,
			|	НастраиваемыйОтчет.Организация КАК Организация,
			|	НастраиваемыйОтчет.ПериодОтчета КАК ПериодОтчета,
			|	НастраиваемыйОтчет.ПериодОкончания КАК ПериодОкончания,
			|	НастраиваемыйОтчет.ВалютаОтображения КАК ВалютаОтображения,
			|	НастраиваемыйОтчет.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	НастраиваемыйОтчет.УровеньТочности КАК УровеньТочности
			|ИЗ
			|	Документ.НастраиваемыйОтчет КАК НастраиваемыйОтчет
			|ГДЕ
			|	НастраиваемыйОтчет.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ЗначениеКопирования);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Объект, Выборка);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВводНовогоДокумента Тогда
		
		Заголовок = НСтр("ru = 'Укажите ключевые реквизиты документа'");
		
		// Создание нового документа
		Элементы.ГруппаПоследнееИзменение.Видимость = Ложь;
		
		Если ЗначениеЗаполнено(Объект.Сценарий) Тогда
			ПодобратьПериодПоСценарию();
		КонецЕсли;
		
	Иначе
		
		Заголовок = НСтр("ru = 'Настройки документа'");
		Элементы.ВидОтчета.ТолькоПросмотр = Истина;
		
		// Сведения о редактировавшем
		СведенияОбИзмененииДокументов = РегистрыСведений.СведенияОбИзмененииДокументов.ПолучитьСведения(Объект.Ссылка);
		ДатаИзменения = СведенияОбИзмененииДокументов.ДатаИзменения;
		ПоследнийРедактировавший = СведенияОбИзмененииДокументов.ПоследнийРедактировавший;
		
	КонецЕсли;
	
	Элементы.ПериодичностьОтчета.ТолькоПросмотр = ТолькоПросмотр;
	Элементы.ИзменитьПериод.Доступность = НЕ ТолькоПросмотр;
	Элементы.ФормаПрименитьИЗакрыть.Доступность = НЕ ТолькоПросмотр;
	Элементы.НастройкиОбработкиДанных.ТолькоПросмотр = ТолькоПросмотр
		ИЛИ НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НастройкиОбработкиШаблоновДокументов);
	
	// Данные вида отчета
	УправлениеВидимостьюДанныхВидаОтчета();
	
	Если Параметры.Свойство("МаксАналитикОтчета") Тогда
		МаксАналитикОтчета = Параметры.МаксАналитикОтчета;
	КонецЕсли;
	Если Параметры.Свойство("СтатусОбъекта") И Параметры.СтатусОбъекта = Перечисления.СостоянияОтчетов.Утвержден Тогда
		ОграничитьРедактированиеКлючевыхРеквизитов(ЭтотОбъект, МаксАналитикОтчета);
	КонецЕсли;
	
	// Ключевые реквизиты
	УстановитьПараметрыПоКлючевымРеквизитам();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ВводНовогоДокумента Тогда
		Модифицированность = Ложь;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Отказ = Истина;
		СтруктураПараметров = Новый Структура;
		ТекстВопроса = НСтр("ru = 'Применить произведенные изменения?'");
		Режим = РежимДиалогаВопрос.ДаНетОтмена;
		Оповещение = Новый ОписаниеОповещения("ПодтверждениеПрименениеЗавершение", ЭтаФорма, СтруктураПараметров);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПрименениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		
		Модифицированность = Ложь;
		Закрыть(Неопределено);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		
		ПрименитьИЗакрыть(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


