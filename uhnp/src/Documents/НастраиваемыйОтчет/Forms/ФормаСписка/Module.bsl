&НаКлиенте
Процедура ГрупповоеИзменениеСостояния(Команда)
	
	Отказ = Ложь;
	ПроверитьСуперпользователяДанных(Элементы.Список.ВыделенныеСтроки, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("МассивОтчетов", Элементы.Список.ВыделенныеСтроки);
	ПараметрыФормы.Вставить("ИдентификаторФормыВладельца", ЭтотОбъект.УникальныйИдентификатор);
	ОткрытьФорму("Обработка.ГрупповоеИзменениеРеквизитовОтчетов.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСуперпользователяДанных(Знач МассивДанных, Отказ)

	Если ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.ПроцессыИСогласование") Тогда
		
		МассивОшибок = Новый Массив;
		МодульМодульСогласованияДокументовУХ = ОбщегоНазначения.ОбщийМодуль("МодульСогласованияДокументовУХ");
		
		Для Каждого ЭлементДанных Из МассивДанных Цикл
			Если НЕ МодульМодульСогласованияДокументовУХ.ЕстьСуперПользователь(ЭлементДанных.Организация) И МассивОшибок.Найти(ЭлементДанных.Организация) = Неопределено Тогда
				МассивОшибок.Добавить(ЭлементДанных.Организация);
			КонецЕсли;
		КонецЦикла;
		
		ТекстОрганизаций = "";
		Для Каждого ОрганизацияБезПраваДоступа Из МассивОшибок Цикл
			ТекстОрганизаций = ТекстОрганизаций + ", """ + Строка(ОрганизацияБезПраваДоступа) + """";
		КонецЦикла;
		
		Если МассивОшибок.Количество() = 1 Тогда
			Отказ = Истина;
			ТекстОрганизаций = Сред(ТекстОрганизаций, 3);
			ТекстОшибки = СтрШаблон(Нстр("ru = 'Для организации %1 текущий пользователь не обладает ролью ""Суперпользователь""'"), ТекстОрганизаций);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,,, СтатусСообщения.Важное);
		ИначеЕсли МассивОшибок.Количество() > 1 Тогда
			Отказ = Истина;
			ТекстОрганизаций = Сред(ТекстОрганизаций, 3);
			ТекстОшибки = СтрШаблон(Нстр("ru = 'Для организаций: %1 текущий пользователь не обладает ролью ""Суперпользователь""'"), ТекстОрганизаций);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,,, СтатусСообщения.Важное);
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

