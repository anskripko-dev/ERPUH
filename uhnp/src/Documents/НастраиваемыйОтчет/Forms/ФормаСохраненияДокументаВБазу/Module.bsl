
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.HTML,НСтр("ru = 'Документ HTML (*.html) ' "));
	
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.PDF,Нстр("ru = 'Документ PDF (*.pdf) ' "));
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.PDF_A_1,Нстр("ru = 'Документ PDF/A1 (*.pdf) ' "));
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.PDF_A_2,Нстр("ru = 'Документ PDF/A2 (*.pdf) ' "));
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.PDF_A_3,Нстр("ru = 'Документ PDF/A3 (*.pdf) ' "));
	
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.XLS,Нстр("ru = 'Лист Excel  (*.xls) ' "));
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.XLSX,Нстр("ru = 'Лист Excel 2007-...  (*.xlsx) ' "));
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.ODS,Нстр("ru = 'Электронная таблица ODS  (*.ods) ' "));
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.DOCX,Нстр("ru = 'Документ Word2007-...   (*.docx) ' "));
	
	
КонецПроцедуры


&НаКлиенте
Процедура Сохранить(Команда)
	
	Если СокрЛП(ИмяФайла) = "" Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Укажите имя сохраняемого файла'"));
		Возврат;
	КонецЕсли;	
	
	Если СокрЛП(ИмяФайла) = "" Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Укажите тип сохраняемого файла'"));
		Возврат;
	КонецЕсли;	
	
	Закрыть(Новый Структура("ИмяФайла,ТипФайла",ИмяФайла,ТипФайла));

КонецПроцедуры

