	|	&Д_Подразделение КАК ПодразделениеКт,
	|	&Д_НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	&Д_Количество КАК КоличествоКт,
	|	&Д_Валюта КАК ВалютаКт,
	|	&Д_СуммаВВалюте КАК СуммаВВалютеКт,
	|	&Организация КАК Организация,
	|	&Сценарий КАК Сценарий,
	|	втПозиции.СуммаСНДС * втРасчеты.КурсВД * втРасчеты.КратностьФВ / (втРасчеты.КурсФВ * втРасчеты.КратностьВД) КАК СуммаВВалютеУчета,
	|	втПозиции.СуммаСНДС * втРасчеты.КурсВД * втРасчеты.КратностьВО / (втРасчеты.КурсВО * втРасчеты.КратностьВД) КАК СуммаВВалютеОтчетности,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВыручкаОтПродажи) КАК ВидОперации
	|ИЗ
	|	втПозиции КАК втПозиции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРасчеты КАК втРасчеты
	|		ПО (ИСТИНА)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаДт
	|		ПО втРасчеты.АналитикаДКЗ = втСчетаУчетаДт.АналитикаУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаКт
	|		ПО (втПозиции.АналитикаДохода = втСчетаУчетаКт.АналитикаУчета)";
	
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Содержание = НСтр("ru = 'Выручка от продажи'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Содержание", СтрШаблон(" ""%1"" ", Содержание));
	
	ФункцииЗамены = Новый Структура("Подразделение, НаправлениеДеятельности, Валюта, СуммаВВалюте, Количество", 
		"втРасчеты.Подразделение", "втРасчеты.НаправлениеДеятельности", "втРасчеты.ВалютаДокумента",
		"втПозиции.СуммаСНДС", "втПозиции.Количество");
	
	МСФОУХ.ЗаменыСубконто(ФункцииЗамены, "втСчетаУчетаДт", ПутиСубконто);	
	ЗаменыЗапроса = МСФОУХ.ЗаменыЗапросаПоПрефиксу("&ДКЗ_");
	МСФОУХ.ЗаменитьАналитикуУчета(ТекстЗапроса, "втСчетаУчетаДт", ФункцииЗамены, ЗаменыЗапроса);
	
	МСФОУХ.ЗаменыСубконто(ФункцииЗамены, "втСчетаУчетаКт", ПутиСубконто);
	ЗаменыЗапроса = МСФОУХ.ЗаменыЗапросаПоПрефиксу("&Д_");
	МСФОУХ.ЗаменитьАналитикуУчета(ТекстЗапроса, "втСчетаУчетаКт", ФункцииЗамены, ЗаменыЗапроса);
	
	Возврат ТекстЗапроса;

КонецФункции

