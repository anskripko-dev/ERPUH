#Область Проведение

Функция ПодготовитьПараметрыПроведения(ДополнительныеСвойства, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	Реквизиты = МСФОУХ.РеквизитыДокумента(Запрос, "ВидОперации", , Отказ);
	ДополнительныеСвойства.ДляПроведения.Вставить("Реквизиты", Реквизиты);
	
	Если Отказ Тогда
		Возврат ДополнительныеСвойства;
	КонецЕсли;
	
	РегистрыСведений.ЗначенияКотировокФИ.ЗаполнитьКроссКурсВО(Запрос, Реквизиты);
	
	Запрос.УстановитьПараметр("ГраницаДоДокумента",		МСФОВызовСервераУХ.ПолучитьГраницуДоДокумента(Реквизиты.Период, Реквизиты.Ссылка));
	Запрос.УстановитьПараметр("Организация",			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Сценарий",				Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("ПланСчетовМСФО", 		Реквизиты.ПланСчетовМСФО);
	Запрос.УстановитьПараметр("ФункциональнаяВалюта", 	Реквизиты.ФункциональнаяВалюта);
	Запрос.УстановитьПараметр("УчетнаяПолитика", 		Реквизиты.УчетнаяПолитика);
	
	ПутиСубконто = МСФОУХ.ПутиСубконто();
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = Новый Массив;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втРасчеты(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПозиции(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втИтогПозиций(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втОстаткиАвансов(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПогашенияАвансов(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втОстаткиПозиций(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСписанияСебестоимости(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПутиСубконто));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_ДвижениеИнвестиций(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_МСФО(НомераТаблиц, ПутиСубконто));
	
	Запрос.Текст = СтрСоединить(ТекстЗапроса, ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета());

	Результат = ПроведениеСерверУХ.ДополнитьТаблицамиИзПакетаЗапросов(ДополнительныеСвойства.ТаблицыДляДвижений, Запрос, НомераТаблиц);
	
	Инвестиции = ДополнительныеСвойства.ТаблицыДляДвижений.ДвижениеИнвестиций;
	ОбъектИнвестирования = ?(Инвестиции.Количество(), Инвестиции.ВыгрузитьКолонку("ОбъектИнвестирования"), Неопределено); 
	ДополнительныеСвойства.ДляПроведения.Реквизиты.Вставить("ОбъектИнвестирования", ОбъектИнвестирования);
	
	Возврат Результат;

КонецФункции

Функция ТекстЗапроса_втРасчеты(НомераТаблиц)
	
	НомераТаблиц.Вставить("втРасчеты", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	ИСТИНА В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			Документ.СчетФактураМСФО.ДокументыОснования КАК СФ
	|		ГДЕ
	|			СФ.ДокументОснование = т.Ссылка) КАК ЕстьСФ,
	|	т.ВидОперации КАК ВидОперации,
	|	т.Контрагент КАК Контрагент,
	|	т.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	т.ВалютаДокумента КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА т.КурсВзаиморасчетов = 0
	|			ТОГДА 1
	|		ИНАЧЕ т.КурсВзаиморасчетов
	|	КОНЕЦ КАК КурсВД,
	|	ВЫБОР
	|		КОГДА т.КратностьВзаиморасчетов = 0
	|			ТОГДА 1
	|		ИНАЧЕ т.КратностьВзаиморасчетов
	|	КОНЕЦ КАК КратностьВД,
	|	1 КАК КурсФВ,
	|	1 КАК КратностьФВ,
	|	&КурсВО КАК КурсВО,
	|	&КратностьВО КАК КратностьВО,
	|	т.ПараметрыУчетаВзаиморасчетов КАК ПараметрыУчетаДКЗ,
	|	т.ПараметрыУчетаВзаиморасчетов.ПараметрыАванса.СчетУчета КАК АналитикаАванс,
	|	т.ПараметрыУчетаВзаиморасчетов.СчетУчета КАК АналитикаДКЗ,
	|	т.ПараметрыУчетаВзаиморасчетов.ПараметрыАванса.СчетУчета.Счет.СчетСсылка КАК СчетАванса,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втРасчеты
	|ИЗ
	|	Документ.РеализацияМСФО КАК т
	|ГДЕ
	|	т.Ссылка = &Ссылка";

КонецФункции

Функция ТекстЗапроса_втПозиции(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПозиции", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	т.НомерСтроки КАК НомерСтроки,
	|	т.Актив КАК Актив,
	|	т.Количество КАК Количество,
	|	т.Цена КАК Цена,
	|	т.Сумма КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА т.Ссылка.НДСВключенВСтоимость
	|			ТОГДА т.Сумма
	|		ИНАЧЕ т.Сумма + т.СуммаНДС
	|	КОНЕЦ КАК СуммаСНДС,
	|	т.Сумма КАК Сумма,
	|	т.СтавкаНДС КАК СтавкаНДС,
	|	т.СуммаНДС КАК СуммаНДС,
	|	т.ПараметрыУчета.СчетУчета.Счет.СчетСсылка КАК СчетАктив,
	|	т.ПараметрыУчета.СчетУчета КАК АналитикаАктив,
	|	т.ПараметрыУчета.СчетДоходов КАК АналитикаДохода,
	|	т.ПараметрыУчета.СчетРасходов КАК АналитикаРасхода,
	|	т.ПараметрыУчета.ПараметрыНДС.СчетУчета КАК АналитикаНДС,
	|	т.ПараметрыУчета.ПараметрыНДС.СчетРасходов КАК АналитикаРНДС,
	|	т.ПараметрыУчета.ПараметрыНДС.СчетДоходов КАК АналитикаДНДС,
	|	т.ПараметрыУчета КАК ПараметрыУчетаАктива,
	|	т.ОтношениеКГруппе КАК ОтношениеКГруппе,
	|	т.КоличествоДоп КАК КоличествоДоп,
	|	ВЫБОР
	|		КОГДА НЕ т.Ссылка.ВидОперации.ЕстьДоли
	|				ИЛИ т.ПараметрыУчета.ВидОбъектаУчета.РазделПланаСчетов <> ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ПрочиеАктивыОбязательства)
	|			ТОГДА NULL
	|		КОГДА т.Актив ССЫЛКА Справочник.Контрагенты
	|				И ВЫРАЗИТЬ(т.Актив КАК Справочник.Контрагенты).ОрганизационнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА т.Актив.ОрганизационнаяЕдиница
	|		КОГДА т.Актив ССЫЛКА Справочник.Организации
	|			ТОГДА т.Актив
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ОбъектИнвестирования,
	|	т.Содержание КАК Содержание
	|ПОМЕСТИТЬ втПозиции
	|ИЗ
	|	Документ.РеализацияМСФО.Позиции КАК т
	|ГДЕ
	|	т.Ссылка = &Ссылка";

КонецФункции

Функция ТекстЗапроса_втИтогПозиций(НомераТаблиц)

	НомераТаблиц.Вставить("втИтогПозиций", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	СУММА(т.СуммаСНДС) КАК СуммаСНДС
	|ПОМЕСТИТЬ втИтогПозиций
	|ИЗ
	|	втПозиции КАК т";

КонецФункции

Функция ТекстЗапроса_втОстаткиАвансов(НомераТаблиц)
	
	НомераТаблиц.Вставить("втОстаткиАвансов", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Субконто2.Дата КАК ДатаАванса,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Валюта КАК Валюта,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА т.Счет.Валютный
	|			ТОГДА т.СуммаВВалютеОстаток
	|		ИНАЧЕ т.СуммаВВалютеУчетаОстаток
	|	КОНЕЦ КАК СуммаВВалюте,
	|	т.СуммаВВалютеУчетаОстаток КАК СуммаВВалютеУчета,
	|	т.СуммаВВалютеОтчетностиОстаток КАК СуммаВВалютеОтчетности
	|ПОМЕСТИТЬ втОстаткиАвансов
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(
	|			&Дата,
	|			Счет В
	|				(ВЫБРАТЬ
	|					с.СчетАванса
	|				ИЗ
	|					втРасчеты КАК с),
	|			,
	|			Организация = &Организация
	|				И Сценарий = &Сценарий
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						д.ДоговорКонтрагента
	|					ИЗ
	|						втРасчеты КАК д)) КАК т
	|ГДЕ
	|	т.СуммаВВалютеУчетаОстаток < 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаАванса";

КонецФункции

Функция ТекстЗапроса_втПогашенияАвансов(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПогашенияАвансов", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.НомерЗаписи КАК НомерЗаписи,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.СуммаВВалюте) + ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0) > МАКСИМУМ(втИтогПозиций.СуммаСНДС)
	|			ТОГДА МАКСИМУМ(втИтогПозиций.СуммаСНДС) - ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалюте)
	|	КОНЕЦ КАК СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.СуммаВВалюте) + ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0) > МАКСИМУМ(втИтогПозиций.СуммаСНДС)
	|			ТОГДА ВЫРАЗИТЬ((МАКСИМУМ(втИтогПозиций.СуммаСНДС) - ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)) * СУММА(т.СуммаВВалютеУчета) / МАКСИМУМ(т.СуммаВВалюте) КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалютеУчета)
	|	КОНЕЦ КАК СуммаВВалютеУчета,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.СуммаВВалюте) + ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0) > МАКСИМУМ(втИтогПозиций.СуммаСНДС)
	|			ТОГДА ВЫРАЗИТЬ((МАКСИМУМ(втИтогПозиций.СуммаСНДС) - ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)) * СУММА(т.СуммаВВалютеОтчетности) / МАКСИМУМ(т.СуммаВВалюте) КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалютеОтчетности)
	|	КОНЕЦ КАК СуммаВВалютеОтчетности
	|ПОМЕСТИТЬ втПогашенияАвансов
	|ИЗ
	|	втОстаткиАвансов КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИтогПозиций КАК втИтогПозиций
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстаткиАвансов КАК ПрошлыеАвансы
	|		ПО (ВЫБОР
	|				КОГДА т.ДатаАванса > ПрошлыеАвансы.ДатаАванса
	|					ТОГДА ИСТИНА
	|				КОГДА т.ДатаАванса = ПрошлыеАвансы.ДатаАванса
	|					ТОГДА т.НомерЗаписи >= ПрошлыеАвансы.НомерЗаписи
	|			КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	т.НомерЗаписи
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(втИтогПозиций.СуммаСНДС) >= ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерЗаписи";

КонецФункции

Функция ТекстЗапроса_втОстаткиПозиций(НомераТаблиц)

	НомераТаблиц.Вставить("втОстаткиПозиций", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Субконто2.Дата КАК ДатаДокумента,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Актив,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Валюта КАК Валюта,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА т.Счет.Валютный
	|			ТОГДА т.СуммаВВалютеОстаток
	|		ИНАЧЕ т.СуммаВВалютеУчетаОстаток
	|	КОНЕЦ КАК СуммаВВалюте,
	|	т.КоличествоОстаток КАК Количество,
	|	т.СуммаВВалютеУчетаОстаток КАК СуммаВВалютеУчета,
	|	т.СуммаВВалютеОтчетностиОстаток КАК СуммаВВалютеОтчетности
	|ПОМЕСТИТЬ втОстаткиПозиций
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(
	|			&Дата,
	|			Счет В
	|				(ВЫБРАТЬ
	|					с.СчетАктив
	|				ИЗ
	|					втПозиции КАК с),
	|			,
	|			Организация = &Организация
	|				И Сценарий = &Сценарий
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						д.Актив
	|					ИЗ
	|						втПозиции КАК д)) КАК т
	|ГДЕ
	|	т.КоличествоОстаток > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Актив,
	|	ДатаДокумента";

КонецФункции

Функция ТекстЗапроса_втСписанияСебестоимости(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСписанияСебестоимости", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.НомерЗаписи КАК НомерЗаписи,
	|	МАКСИМУМ(втПозиции.АналитикаАктив) КАК АналитикаАктив,
	|	МАКСИМУМ(втПозиции.АналитикаРасхода) КАК АналитикаРасхода,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.Количество) + ЕСТЬNULL(СУММА(Прошлые.Количество), 0) > МАКСИМУМ(втПозиции.Количество)
	|			ТОГДА МАКСИМУМ(втПозиции.Количество) - ЕСТЬNULL(СУММА(Прошлые.Количество), 0)
	|		ИНАЧЕ МАКСИМУМ(т.Количество)
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.Количество) + ЕСТЬNULL(СУММА(Прошлые.Количество), 0) > МАКСИМУМ(втПозиции.Количество)
	|			ТОГДА ВЫРАЗИТЬ(СУММА(т.СуммаВВалюте) * (МАКСИМУМ(втПозиции.Количество) - ЕСТЬNULL(СУММА(Прошлые.Количество), 0)) / МАКСИМУМ(т.Количество) КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалюте)
	|	КОНЕЦ КАК СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.Количество) + ЕСТЬNULL(СУММА(Прошлые.Количество),0) > МАКСИМУМ(втПозиции.Количество)
	|			ТОГДА ВЫРАЗИТЬ(СУММА(т.СуммаВВалютеУчета) * (МАКСИМУМ(втПозиции.Количество) - ЕСТЬNULL(СУММА(Прошлые.Количество), 0)) / МАКСИМУМ(т.Количество) КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалютеУчета)
	|	КОНЕЦ КАК СуммаВВалютеУчета,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.Количество) + ЕСТЬNULL(СУММА(Прошлые.Количество),0) > МАКСИМУМ(втПозиции.Количество)
	|			ТОГДА ВЫРАЗИТЬ(СУММА(т.СуммаВВалютеОтчетности) * (МАКСИМУМ(втПозиции.Количество) - ЕСТЬNULL(СУММА(Прошлые.Количество), 0)) / МАКСИМУМ(т.Количество) КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалютеОтчетности)
	|	КОНЕЦ КАК СуммаВВалютеОтчетности
	|ПОМЕСТИТЬ втСписанияСебестоимости
	|ИЗ
	|	втОстаткиПозиций КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПозиции КАК втПозиции
	|		ПО т.Актив = втПозиции.Актив
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстаткиПозиций КАК Прошлые
	|		ПО т.Актив = Прошлые.Актив
	|			И (ВЫБОР
	|				КОГДА т.ДатаДокумента > Прошлые.ДатаДокумента
	|					ТОГДА ИСТИНА
	|				КОГДА т.ДатаДокумента = Прошлые.ДатаДокумента
	|					ТОГДА т.НомерЗаписи >= Прошлые.НомерЗаписи
	|			КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Актив,
	|	т.НомерЗаписи
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(втПозиции.Количество) <= ЕСТЬNULL(СУММА(Прошлые.Количество), 0) + МАКСИМУМ(т.Количество)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерЗаписи";

КонецФункции

Функция ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПутиСубконто)
	
	ПоляАналитик = 
	"втРасчеты.АналитикаДКЗ
	|втРасчеты.АналитикаАванс
	|втПозиции.АналитикаАктив
	|втПозиции.АналитикаДНДС
	|втПозиции.АналитикаРНДС
	|втПозиции.АналитикаДохода
	|втПозиции.АналитикаРасхода";
	
	Возврат Справочники.ПараметрыОбъектовУчетаМСФО.ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПоляАналитик, ПутиСубконто);
	
КонецФункции

Функция ТекстЗапроса_ДвижениеИнвестиций(НомераТаблиц)

	НомераТаблиц.Вставить("ДвижениеИнвестиций", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Организация КАК Инвестор,
	|	&Сценарий КАК Сценарий,
	|	т.ОбъектИнвестирования КАК ОбъектИнвестирования,
	|	-т.Сумма КАК Инвестиции,
	|	0 КАК БалансоваяСтоимость,
	|	-т.КоличествоДоп КАК ПрямаяДоляВладения,
	|	т.Содержание КАК ОбоснованиеКонтроля,
	|	-т.Количество КАК КоличествоВДоверительномУправлении,
	|	-т.Количество КАК КоличествоГолосующих,
	|	-т.Количество КАК КоличествоПривилегированных,
	|	-т.Количество КАК Количество,
	|	т.ОтношениеКГруппе КАК ОтношениеКГруппе,
	|	т.ОтношениеКГруппе.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.Дочернее) КАК ПризнаниеКонтроля
	|ИЗ
	|	втПозиции КАК т
	|ГДЕ
	|	НЕ т.ОбъектИнвестирования ЕСТЬ NULL";

КонецФункции

Функция ТекстЗапроса_МСФО(НомераТаблиц, ПутиСубконто)
	
	НомераТаблиц.Вставить("МСФО", НомераТаблиц.Количество());
	
	ТекстЗапроса = Новый Массив;
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаПогашенияАвансов(ПутиСубконто));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаВыручка(ПутиСубконто));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаСписаниеСтоимости(ПутиСубконто));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаНачислениеНДС(ПутиСубконто));
	
	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ");
	
КонецФункции

#Область Проводки

Функция ТекстЗапроса_ПроводкаПогашенияАвансов(ПутиСубконто)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Содержание КАК Содержание,
	|	втСчетаУчетаДт.Счет КАК СчетДт,
	|	втСчетаУчетаДт.ВидСубконто1 КАК ВидСубконтоДт1,
	|	втСчетаУчетаДт.ВидСубконто2 КАК ВидСубконтоДт2,
	|	втСчетаУчетаДт.ВидСубконто3 КАК ВидСубконтоДт3,
	|	втОстаткиАвансов.Субконто1 КАК СубконтоДт1,
	|	втОстаткиАвансов.Субконто2 КАК СубконтоДт2,
	|	втОстаткиАвансов.Субконто3 КАК СубконтоДт3,
	|	втОстаткиАвансов.Подразделение КАК ПодразделениеДт,
	|	втОстаткиАвансов.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	NULL КАК КоличествоДт,
	|	ВЫБОР
	|		КОГДА втСчетаУчетаДт.Валютный
	|			ТОГДА втОстаткиАвансов.Валюта
	|	КОНЕЦ КАК ВалютаДт,
	|	ВЫБОР
	|		КОГДА втСчетаУчетаКт.Валютный
	|			ТОГДА втОстаткиАвансов.СуммаВВалюте
	|	КОНЕЦ КАК СуммаВВалютеДт,
	|	втСчетаУчетаКт.Счет КАК СчетКт,
	|	втСчетаУчетаКт.ВидСубконто1 КАК ВидСубконтоКт1,
	|	втСчетаУчетаКт.ВидСубконто2 КАК ВидСубконтоКт2,
	|	втСчетаУчетаКт.ВидСубконто3 КАК ВидСубконтоКт3,
	|	&ДКЗ_Субконто1 КАК СубконтоКт1,
	|	&ДКЗ_Субконто2 КАК СубконтоКт2,
	|	&ДКЗ_Субконто3 КАК СубконтоКт3,
	|	втОстаткиАвансов.Подразделение КАК ПодразделениеКт,
	|	втОстаткиАвансов.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	NULL КАК КоличествоКт,
	|	&ДКЗ_Валюта КАК ВалютаКт,
	|	&ДКЗ_СуммаВВалюте КАК СуммаВВалютеКт,
	|	&Организация КАК Организация,
	|	&Сценарий КАК Сценарий,
	|	втОстаткиАвансов.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	втОстаткиАвансов.СуммаВВалютеОтчетности КАК СуммаВВалютеОтчетности,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ЗачетПервоначальногоАвансаСуммаБезНДС) КАК ВидОперации
	|ИЗ
	|	втРасчеты КАК втРасчеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОстаткиАвансов КАК втОстаткиАвансов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПогашенияАвансов КАК втПогашенияАвансов
	|			ПО втОстаткиАвансов.НомерЗаписи = втПогашенияАвансов.НомерЗаписи
	|		ПО (ИСТИНА)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаДт
	|		ПО втРасчеты.АналитикаАванс = втСчетаУчетаДт.АналитикаУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаКт
	|		ПО втРасчеты.АналитикаДКЗ = втСчетаУчетаКт.АналитикаУчета";
	
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Содержание = НСтр("ru = 'Зачет аванса'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Содержание", СтрШаблон(" ""%1"" ", Содержание));
	
	ФункцииЗамены = Новый Структура("Подразделение, НаправлениеДеятельности, Валюта, СуммаВВалюте, Количество",
		"втРасчеты.Подразделение", "втРасчеты.НаправлениеДеятельности", "втРасчеты.ВалютаДокумента",
		"втОстаткиАвансов.СуммаВВалюте", "втПозиции.Количество");	
	МСФОУХ.ЗаменыСубконто(ФункцииЗамены, "втСчетаУчетаКт", ПутиСубконто, Истина);
	
	ЗаменыЗапроса = МСФОУХ.ЗаменыЗапросаПоПрефиксу("&ДКЗ_");
	МСФОУХ.ЗаменитьАналитикуУчета(ТекстЗапроса, "втСчетаУчетаКт", ФункцииЗамены, ЗаменыЗапроса);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ПроводкаСписаниеСтоимости(ПутиСубконто)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Содержание КАК Содержание,
	|	втСчетаУчетаДт.Счет КАК СчетДт,
	|	втСчетаУчетаДт.ВидСубконто1 КАК ВидСубконтоДт1,
	|	втСчетаУчетаДт.ВидСубконто2 КАК ВидСубконтоДт2,
	|	втСчетаУчетаДт.ВидСубконто3 КАК ВидСубконтоДт3,
	|	&Расход_Субконто1 КАК СубконтоДт1,
	|	&Расход_Субконто2 КАК СубконтоДт2,
	|	&Расход_Субконто3 КАК СубконтоДт3,
	|	&Расход_Подразделение КАК ПодразделениеДт,
	|	&Расход_НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	&Расход_Количество КАК КоличествоДт,
	|	&Расход_Валюта КАК ВалютаДт,
	|	&Расход_СуммаВВалюте КАК СуммаВВалютеДт,
	|	втСчетаУчетаКт.Счет КАК СчетКт,
	|	втСчетаУчетаКт.ВидСубконто1 КАК ВидСубконтоКт1,
	|	втСчетаУчетаКт.ВидСубконто2 КАК ВидСубконтоКт2,
	|	втСчетаУчетаКт.ВидСубконто3 КАК ВидСубконтоКт3,
	|	втОстаткиПозиций.Субконто1 КАК СубконтоКт1,
	|	втОстаткиПозиций.Субконто2 КАК СубконтоКт2,
	|	втОстаткиПозиций.Субконто3 КАК СубконтоКт3,
	|	втОстаткиПозиций.Подразделение КАК ПодразделениеКт,
	|	втОстаткиПозиций.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	&Остаток_Количество КАК КоличествоКт,
	|	&Остаток_Валюта КАК ВалютаКт,
	|	&Остаток_СуммаВВалюте КАК СуммаВВалютеКт,
	|	&Организация КАК Организация,
	|	&Сценарий КАК Сценарий,
	|	втСписанияСебестоимости.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	втСписанияСебестоимости.СуммаВВалютеОтчетности КАК СуммаВВалютеОтчетности,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеСтоимости) КАК ВидОперации
	|ИЗ
	|	втРасчеты КАК втРасчеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОстаткиПозиций КАК втОстаткиПозиций
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСписанияСебестоимости КАК втСписанияСебестоимости
	|			ПО втОстаткиПозиций.НомерЗаписи = втСписанияСебестоимости.НомерЗаписи
	|		ПО (ИСТИНА)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаДт
	|		ПО втСписанияСебестоимости.АналитикаРасхода = втСчетаУчетаДт.АналитикаУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаКт
	|		ПО втСписанияСебестоимости.АналитикаАктив = втСчетаУчетаКт.АналитикаУчета";

	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Содержание = НСтр("ru = 'Списание стоимости'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Содержание", СтрШаблон(" ""%1"" ", Содержание));
	
	ФункцииЗамены = Новый Структура("Подразделение, НаправлениеДеятельности, Валюта, СуммаВВалюте, Количество",
		"втРасчеты.Подразделение", "втРасчеты.НаправлениеДеятельности", "втОстаткиПозиций.Валюта",
		"втСписанияСебестоимости.СуммаВВалюте", "втСписанияСебестоимости.Количество");
	
	МСФОУХ.ЗаменыСубконто(ФункцииЗамены, "втСчетаУчетаДт", ПутиСубконто, Истина);
	ЗаменыЗапроса = МСФОУХ.ЗаменыЗапросаПоПрефиксу("&Расход_");
	МСФОУХ.ЗаменитьАналитикуУчета(ТекстЗапроса, "втСчетаУчетаДт", ФункцииЗамены, ЗаменыЗапроса);
	
	ЗаменыЗапроса = МСФОУХ.ЗаменыЗапросаПоПрефиксу("&Остаток_");
	МСФОУХ.ЗаменитьАналитикуУчета(ТекстЗапроса, "втСчетаУчетаКт", ФункцииЗамены, ЗаменыЗапроса);
	
	Возврат ТекстЗапроса;
	
КонецФункции

