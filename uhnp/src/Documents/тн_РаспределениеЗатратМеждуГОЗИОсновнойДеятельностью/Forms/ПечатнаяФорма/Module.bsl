		  
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("ДокументПечати", ДокументПечати) Тогда
		Отказ = Истина;
		Возврат;	
	КонецЕсли;   
	
	Если Не Параметры.Свойство("ИмяПечатнойФормы", ИмяПечатнойФормы) Тогда
		Отказ = Истина;
		Возврат;	
	КонецЕсли;
	
	РезультатФормированияПечатнойФормы = ПолучитьПечатнуюФормуДокумента(); 
	
	Если РезультатФормированияПечатнойФормы = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;  
	
	Для Каждого ЭлементМассива Из ЭтотОбъект.ПолучитьРеквизиты() Цикл
		
		Если РезультатФормированияПечатнойФормы.Свойство(ЭлементМассива.Имя) Тогда
			ЭтотОбъект[ЭлементМассива.Имя] = РезультатФормированияПечатнойФормы[ЭлементМассива.Имя];			
		КонецЕсли;
		
	КонецЦикла;
	 	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПечатнаяФормаДокументаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	ОбработкаРасшифровки(Расшифровка, СтандартнаяОбработка);	
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКоманд

&НаКлиенте
Процедура СохранитьВExcel(Команда)
	
	ИмяПечатнойФормы = ИмяПечатнойФормы;
	
	Если ЗначениеЗаполнено(ИмяПечатнойФормы) Тогда
	
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		Диалог.Заголовок = "Выберите каталог сохранения файла";
		Если Диалог.Выбрать() Тогда
			
			Каталог = Диалог.Каталог;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Каталог) Тогда
			
			Если Прав(Каталог, 1) <> "\" Тогда
				
				Каталог = Каталог + "\";
				
			КонецЕсли;
			
			РеквизитыДокументаПечати = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(ДокументПечати, "Организация, Дата");
			
			Если ИмяПечатнойФормы = "РаспределенныеСуммыПоСтатьям" Тогда
				
				ШаблонИмяФайла = "Распределение затрат между ГОЗ и основной деятельностью по организации %1 за %2.xlsx";
				ИмяФайла = СтрШаблон(ШаблонИмяФайла, РеквизитыДокументаПечати.Организация, Формат(РеквизитыДокументаПечати.Дата, "ДФ='ММMM yyyy'")); 
				
			ИначеЕсли ИмяПечатнойФормы = "Справка" Тогда
				
				ШаблонИмяФайла = "Справка о себестоимости государственных контрактов по организации %1 за %2.xlsx";
				ИмяФайла = СтрШаблон(ШаблонИмяФайла, РеквизитыДокументаПечати.Организация, Формат(РеквизитыДокументаПечати.Дата, "ДФ='ММMM yyyy'")); 
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяФайла) Тогда
			
				ПолныйПутьКФайлу = Каталог + ИмяФайла;
				
				ПечатнаяФормаДокумента.Записать(ПолныйПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX); 	
				
				ТекстСообщения = "Результат сохранен по адресу: " + ПолныйПутьКФайлу;
				ОбщегоНазначенияКлиентСерверУХ.СообщитьПользователю(ТекстСообщения);
				
			Иначе
				
				ТекстСообщения = "Не удалось сформировать имя файла для сохранения.";
				ОбщегоНазначенияКлиентСерверУХ.СообщитьПользователю(ТекстСообщения);

			КонецЕсли;
			
		КонецЕсли;	
		
	Иначе
		
		ТекстСообщения = "Не удалось определить печатную форму.";
		ОбщегоНазначенияКлиентСерверУХ.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьПечатнуюФормуДокумента()
	
	Если ИмяПечатнойФормы = "РаспределенныеСуммыПоСтатьям" Тогда
		РезультатПечатнойФормы = Документы.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.ПолучитьПечатнуюФормуДокумента(ДокументПечати)
	ИначеЕсли ИмяПечатнойФормы = "Справка" Тогда
		РезультатПечатнойФормы = Документы.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.ПолучитьПечатнуюФормуСправкиДокумента(ДокументПечати);
	Иначе
     	РезультатПечатнойФормы = Неопределено;
	КонецЕсли;
	
	Возврат РезультатПечатнойФормы;	
	
КонецФункции   

&НаКлиенте
Процедура ОбработкаРасшифровки(Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
		
		ЗначенияПоля = ПолучитьЗначениеПолей(Расшифровка, АдресРасшифровки);
		
		Если ЗначениеЗаполнено(ЗначенияПоля) Тогда
			ПоказатьЗначение(, ЗначенияПоля);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеПолей(Расшифровка, ДанныеРасшифровки)
	
	ДанныеРасшифровкиАктуальные = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	
	КоллекцияПолей = ДанныеРасшифровкиАктуальные.Элементы[Расшифровка].ПолучитьПоля();
	
	Если КоллекцияПолей.Количество() Тогда
		
		Возврат КоллекцияПолей[0].Значение;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти
