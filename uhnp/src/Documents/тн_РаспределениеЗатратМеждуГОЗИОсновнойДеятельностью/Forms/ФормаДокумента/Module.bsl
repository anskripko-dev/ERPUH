						НоваяСтрока.ДоговорКонтрагента 			= Выборка.ДоговорКонтрагента;
						НоваяСтрока.ИдентификационныйКодЗакупки = Выборка.ИдентификационныйКодЗакупки;
						НоваяСтрока.ГосударственныйКонтракт 	= Выборка.ГосударственныйКонтракт;
						НоваяСтрока.Сумма 						= Выборка.Сумма;
											
						//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
						
						НоваяСтрока.КоэффициентРаспределения = 0;
						
