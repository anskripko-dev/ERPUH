						НоваяСтрока.Представление = Выборка.СтатьяЗатратПредставление;
												
						//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
						
						НоваяСтрока.Значение = Выборка.СтатьяЗатрат;
						НоваяСтрока.ИдентификационныйКодЗакупки = ПустойИКЗ;
							
