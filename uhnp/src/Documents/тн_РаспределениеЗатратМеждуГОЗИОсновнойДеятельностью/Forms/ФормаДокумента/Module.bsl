	               |	ГосударственныйКонтракт
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("БазаРаспределенияПоГосударственнымКонтрактам", Объект.БазаРаспределенияПоГосударственнымКонтрактам.Выгрузить());
	
	РезультатОбщийИтог = Запрос.Выполнить();
	ВыборкаОбщийИтог = РезультатОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОбщийИтог.Следующий() Цикл
		
		НоваяСтрокаОбщийИтог = ДеревоЗначенийБазаРаспределенияПоГосударственнымКонтрактам.Строки.Добавить();
		
		//НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
		
		//ЗаполнитьЗначенияСвойств(НоваяСтрокаОбщийИтог, ВыборкаОбщийИтог);		
		
		НоваяСтрокаОбщийИтог.Сумма = ВыборкаОбщийИтог.Сумма;
		
		//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
		
		НоваяСтрокаОбщийИтог.Представление = "По всем гос.контрактам";
		НоваяСтрокаОбщийИтог.Значение = НоваяСтрокаОбщийИтог.Представление;
		
		ВыборкаГосударственныйКонтракт = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаГосударственныйКонтракт.Следующий() Цикл
			
			НоваяСтрокаГосударственныйКонтракт = НоваяСтрокаОбщийИтог.Строки.Добавить();
			
			//НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
			
			//ЗаполнитьЗначенияСвойств(НоваяСтрокаГосударственныйКонтракт, ВыборкаГосударственныйКонтракт);
			
			НоваяСтрокаГосударственныйКонтракт.ГосударственныйКонтракт 	= ВыборкаГосударственныйКонтракт.ГосударственныйКонтракт;
			НоваяСтрокаГосударственныйКонтракт.Сумма 					= ВыборкаГосударственныйКонтракт.Сумма;
			
			//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
			
			НоваяСтрокаГосударственныйКонтракт.Представление = ВыборкаГосударственныйКонтракт.НаименованиеГосударственногоКонтракта;
			НоваяСтрокаГосударственныйКонтракт.Значение = ВыборкаГосударственныйКонтракт.ГосударственныйКонтракт;
			
			Выборка = ВыборкаГосударственныйКонтракт.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				НоваяСтрока = НоваяСтрокаГосударственныйКонтракт.Строки.Добавить();
				
				//НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				
				//ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка); 
				//
				//НоваяСтрока.Представление = Выборка.ДоговорКонтрагента;
				
				НоваяСтрока.ДоговорКонтрагента 				= Выборка.ДоговорКонтрагента;
				НоваяСтрока.ИдентификационныйКодЗакупки 	= Выборка.ИдентификационныйКодЗакупки;
				НоваяСтрока.ГосударственныйКонтракт 		= Выборка.ГосударственныйКонтракт;
				НоваяСтрока.Сумма 							= Выборка.Сумма;
				НоваяСтрока.Представление 					= Выборка.ДоговорКонтрагентаПредставление;
								
				//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				
				НоваяСтрока.Значение = Выборка.ДоговорКонтрагента;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначенийБазаРаспределенияПоГосударственнымКонтрактам, "БазаРаспределенияПоГосударственнымКонтрактам");
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьСтрокиДеревьев()
	
	РазвернутьСтрокиДерева(БазаРаспределенияПоГосударственнымКонтрактам, "БазаРаспределенияПоГосударственнымКонтрактам", Истина);
	РазвернутьСтрокиДерева(РасходыОсновнойДеятельности, "РасходыОсновнойДеятельности");
	РазвернутьСтрокиДерева(РаспределенныеСуммыПоГосударственнымКонтрактам, "РаспределенныеСуммыПоГосударственнымКонтрактам");

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьСтрокиДерева(ДеревоЗначений, ИмяДереваНаФорме, РазвернутьСПодчиненными = Ложь)
	
	Для Каждого СтрокаДерева ИЗ ДеревоЗначений.ПолучитьЭлементы() Цикл   	
        Элементы[ИмяДереваНаФорме].Развернуть(СтрокаДерева.ПолучитьИдентификатор(), РазвернутьСПодчиненными);		
    КонецЦикла;	
	
КонецПроцедуры 

&НаКлиенте
Процедура УдалитьДанныеВДеревьях()
	
	СписокОчищаемыхДеревьев = Новый Массив;
	СписокОчищаемыхДеревьев.Добавить("БазаРаспределенияПоГосударственнымКонтрактам");
	СписокОчищаемыхДеревьев.Добавить("РасходыОсновнойДеятельности");
	СписокОчищаемыхДеревьев.Добавить("РаспределенныеСуммыПоГосударственнымКонтрактам");
	
	УдалитьДанныеВДереве(СписокОчищаемыхДеревьев);	
	
КонецПроцедуры

&НаСервере
Процедура УдалитьДанныеВДереве(СписокОчищаемыхДеревьев)
	
	Для Каждого ИмяДерева Из СписокОчищаемыхДеревьев Цикл
		
		ОчищаемоеДерево = РеквизитФормыВЗначение(ИмяДерева, Тип("ДеревоЗначений")); 	
		ОчищаемоеДерево.Строки.Очистить(); 	
		ЗначениеВРеквизитФормы(ОчищаемоеДерево, ИмяДерева);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПредставлениеГосКонтракта(НаименованиеГосКонтракт, НомерГосКонтракта, ДатаГосКонтракта)
	
	ПредставлениеГосКонтракта = НаименованиеГосКонтракт;
	
	Если ЗначениеЗаполнено(НомерГосКонтракта) 
		И ЗначениеЗаполнено(ДатаГосКонтракта) Тогда
		
		ПредставлениеГосКонтракта = ПредставлениеГосКонтракта + ", №" + НомерГосКонтракта + " от " + Формат(ДатаГосКонтракта, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
	Возврат ПредставлениеГосКонтракта;
	
КонецФункции

#КонецОбласти    

#Область ПечатныеФормы

&НаКлиенте
Процедура ВывестиНаПечать(ИмяПечатнойФормы)
	
	Если Объект.Ссылка.Пустая() Тогда   	
		ОбщегоНазначенияКлиентСерверУХ.СообщитьПользователю("Документ можно распечатать только после его записи");
		Возврат;		
	КонецЕсли;
		
	Если Модифицированность Тогда
		
		ПараметрыВопроса = Новый Структура;
		ПараметрыВопроса.Вставить("ИмяПечатнойФормы", ИмяПечатнойФормы);
		
		ТекстВопроса = "Документ изменен. Для печати справки его необходимо записать.
		|Записать документ?";
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗаписиМодифицированногоДокумента", ЭтотОбъект, ПараметрыВопроса);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
		
	Иначе
		
		ПечатьДокумента(ИмяПечатнойФормы); 			
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьДокумента(ИмяПечатнойФормы)
	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДокументПечати", Объект.Ссылка);
	ПараметрыФормы.Вставить("ИмяПечатнойФормы", ИмяПечатнойФормы);
	
	ОткрытьФорму("Документ.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Форма.ПечатнаяФорма", ПараметрыФормы, ЭтотОбъект);	
	
КонецПроцедуры

#КонецОбласти

#Область ОтборыВШапкеДокумента

&НаСервере
Процедура ЗаполнитьСписокВыбораВидСравненияПодразделение()
	
	СписокВидовСравнения = Новый Массив;
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.Равно));
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.НеРавно));
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.ВСписке));
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.НеВСписке));
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.ВИерархии));
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.НеВИерархии)); 
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.ВСпискеПоИерархии));
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.НеВСпискеПоИерархии));
	
	Элементы.ВидСравненияПодразделение.СписокВыбора.ЗагрузитьЗначения(СписокВидовСравнения);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеВСпискеОтборов(ИмяПоля, ИмяПоляВидСравнения, ИмяПоляЗначение)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяПоля", ИмяПоля);
	
	НайденныеСтроки = Объект.СписокОтборов.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() Тогда
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл			
			Объект.СписокОтборов.Удалить(НайденнаяСтрока);			
		КонецЦикла;
		
	КонецЕсли;
	
	НовыйСписокОтборов = ЭтотОбъект[ИмяПоляЗначение];
	Если Не ТипЗнч(ЭтотОбъект[ИмяПоляЗначение]) = Тип("СписокЗначений") Тогда
		
		НовыйСписокОтборов = Новый СписокЗначений;
		НовыйСписокОтборов.Добавить(ЭтотОбъект[ИмяПоляЗначение]);
		
	КонецЕсли;
	
	Для Каждого ЭлементНовогОСпискаОтборов Из НовыйСписокОтборов Цикл 
		
		Если Не ЗначениеЗаполнено(ЭлементНовогОСпискаОтборов.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.СписокОтборов.Добавить();
		НоваяСтрока.ИмяПоля = ИмяПоля;
		НоваяСтрока.ВидСравнения = ЭтотОбъект[ИмяПоляВидСравнения];
		НоваяСтрока.ЗначениеПоля = ЭлементНовогОСпискаОтборов.Значение;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоляПриОткрытииФормы(ИмяПоля, ИмяПоляВидСравнения, ИмяПоляЗначение, ОписаниеТипа)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяПоля", ИмяПоля);
	
	НайденныеСтроки = Объект.СписокОтборов.НайтиСтроки(Отбор);
	Если Не НайденныеСтроки.Количество() = 0 Тогда
		
		ЭтотОбъект[ИмяПоляВидСравнения] = НайденныеСтроки[0].ВидСравнения;
		УстановитьТипЗначенияДляПоляОтбора(ИмяПоляВидСравнения, ИмяПоляЗначение, ОписаниеТипа, НайденныеСтроки);
		
	Иначе
		
		ЭтотОбъект[ИмяПоляВидСравнения] = "Равно";
		УстановитьТипЗначенияДляПоляОтбора(ИмяПоляВидСравнения, ИмяПоляЗначение, ОписаниеТипа);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокЗначенийДляПоляОтбора(ИмяПоляЗначение, ОписаниеТипа, НовыйСписокЗначений = Неопределено)
	
	Если НовыйСписокЗначений = Неопределено Тогда		
		ЭтотОбъект[ИмяПоляЗначение] = Новый СписокЗначений; 	
	Иначе		
		ЭтотОбъект[ИмяПоляЗначение] = НовыйСписокЗначений;	
	КонецЕсли;
	
	ЭтотОбъект[ИмяПоляЗначение].ТипЗначения = ОписаниеТипа;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипЗначенияДляПоляОтбора(ИмяПоляВидСравнения, ИмяПоляЗначение, ОписаниеТипа, НайденныеСтрокиСпискаОтборов = Неопределено)
	
	СписокВидовСравленияДляСпискаЗначений = Новый Массив;
	СписокВидовСравленияДляСпискаЗначений.Добавить("В списке");
	СписокВидовСравленияДляСпискаЗначений.Добавить("Не в списке");
	СписокВидовСравленияДляСпискаЗначений.Добавить("В группе из списка");
	СписокВидовСравленияДляСпискаЗначений.Добавить("Не в группе из списка");
	
	Если ТипЗнч(ЭтотОбъект[ИмяПоляЗначение]) = Тип("Неопределено") Тогда
		
		ЭтотОбъект[ИмяПоляЗначение] = ОписаниеТипа.ПривестиЗначение(Неопределено);	
		
		Если Не НайденныеСтрокиСпискаОтборов = Неопределено Тогда

			Если Не СписокВидовСравленияДляСпискаЗначений.Найти(ЭтотОбъект[ИмяПоляВидСравнения]) = Неопределено Тогда
				
				НовыйСписокЗначений = Новый СписокЗначений;
				Для Каждого НайденнаяСтрока Из НайденныеСтрокиСпискаОтборов Цикл					
					НовыйСписокЗначений.Добавить(НайденнаяСтрока.ЗначениеПоля);					
				КонецЦикла;
				
				УстановитьСписокЗначенийДляПоляОтбора(ИмяПоляЗначение, ОписаниеТипа, НовыйСписокЗначений);
				
			Иначе
				
				ЭтотОбъект[ИмяПоляЗначение] = НайденныеСтрокиСпискаОтборов[0].ЗначениеПоля;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ЭтоСписокЗначений = ТипЗнч(ЭтотОбъект[ИмяПоляЗначение]) = Тип("СписокЗначений");
		Если Не СписокВидовСравленияДляСпискаЗначений.Найти(ЭтотОбъект[ИмяПоляВидСравнения]) = Неопределено Тогда
			
			Если Не ЭтоСписокЗначений Тогда
				
				ТекущееЗначение = СписокПодразделений;
				
				НовыйСписокЗначений = Неопределено;
				Если ЗначениеЗаполнено(ТекущееЗначение) Тогда
					
					НовыйСписокЗначений = Новый СписокЗначений;
					НовыйСписокЗначений.Добавить(ТекущееЗначение);
					
				КонецЕсли;
				
				УстановитьСписокЗначенийДляПоляОтбора(ИмяПоляЗначение, ОписаниеТипа, НовыйСписокЗначений);
				
			КонецЕсли;
			
		Иначе
			
			Если ЭтоСписокЗначений Тогда
				
				Если СписокПодразделений.Количество() Тогда
					ЭтотОбъект[ИмяПоляЗначение] = СписокПодразделений[0].Значение;	
				Иначе
					ЭтотОбъект[ИмяПоляЗначение] = ОписаниеТипа.ПривестиЗначение(Неопределено);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти    
