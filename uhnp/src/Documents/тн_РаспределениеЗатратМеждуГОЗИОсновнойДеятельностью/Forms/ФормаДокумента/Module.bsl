
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда 
		
		Объект.Ответственный = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
		Объект.ВариантРаспределенияЗатрат = ПредопределенноеЗначение("Перечисление.тн_ВариантыРаспределенияЗатратМеждуГОЗИОсновнойДеятельностью.ПоВыручке");
		
	КонецЕсли;       
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
		
	ОпределитьМесяцРаспределенияЗатрат(Параметры.Ключ.Пустая());
	ЗаполнитьСписокВыбораВидСравненияПодразделение();
	ЗаполнитьДанныеДеревьевПоТабличнымЧастямНаСервере();  
	
	УстановитьВидимостьДоступность();
	УстановитьОтборПоляПриОткрытииФормы("Подразделение", "ВидСравненияПодразделение", "СписокПодразделений", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)      
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	РазвернутьСтрокиДеревьев();  
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОпределитьМесяцРаспределенияЗатрат();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияПодразделениеПриИзменении(Элемент)
	
	УстановитьТипЗначенияДляПоляОтбора("ВидСравненияПодразделение", "СписокПодразделений", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ОбновитьДанныеВСпискеОтборов("Подразделение", "ВидСравненияПодразделение", "СписокПодразделений");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПодразделенийПриИзменении(Элемент)
	
	ОбновитьДанныеВСпискеОтборов("Подразделение", "ВидСравненияПодразделение", "СписокПодразделений");
	
КонецПроцедуры

//Морозов А.В. (Код-Эксперт) 22.01.2026 Выполнение задач №000056468
&НаКлиенте
Процедура ВариантРаспределенияЗатратПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

#КонецОбласти  

#Область ОбработчикиСобытийЭлементовТаблицыФормы

 &НаКлиенте
Процедура РасходыОсновнойДеятельностиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РасходыОсновнойДеятельностиПредставление" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекущиеДанные = Элементы.РасходыОсновнойДеятельности.ТекущиеДанные;
		ПоказатьЗначение(, ТекущиеДанные.Значение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПоГосударственнымКонтрактамВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "БазаРаспределенияПоГосударственнымКонтрактамПредставление" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекущиеДанные = Элементы.БазаРаспределенияПоГосударственнымКонтрактам.ТекущиеДанные;
		ПоказатьЗначение(, ТекущиеДанные.Значение);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РаспределенныеСуммыПоГосударственнымКонтрактамВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РаспределенныеСуммыПоГосударственнымКонтрактамПредставление" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекущиеДанные = Элементы.РаспределенныеСуммыПоГосударственнымКонтрактам.ТекущиеДанные;
		ПоказатьЗначение(, ТекущиеДанные.Значение);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ЗаполнитьРаспределениеСумм(Команда)
	
	Если Объект.РаспределенныеСуммыПоГосударственнымКонтрактам.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПерераспределенииСумм", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Суммы по государственным контрактам рапределены.
		|Текущие данные будут потеряны. 
		|Выполнить новое распределение?", Режим, 0);
		
	Иначе
	
		ЗаполнитьРаспределениеСуммНаСервере();
		ЗаполнитьДанныеДеревьевПоТабличнымЧастям(); 
		УстановитьВидимостьДоступность();
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРаспределенныеСуммы(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОчисткеРаспределенныхСумм", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Суммы по государственным контрактам рапределены.
	|Текущие данные будут потеряны. 
	|Выполнить очистку?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиНаПечатьРаспределенныеЗатраты(Команда)
	
	ВывестиНаПечать("РаспределенныеСуммыПоСтатьям");
		
КонецПроцедуры

&НаКлиенте
Процедура ВывестиНаПечатьСправку(Команда)
		
	ВывестиНаПечать("Справка");

КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьРаспределениеСуммНаСервере()
	
	Модифицированность = Истина;
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью"));	
	ДокументОбъект.ЗаполнитьСуммыРаспределенияПоГосударственномуКонтракту();	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьМесяцРаспределенияЗатрат(ПриСозданииДокумента = Ложь)
	
	ДатаРаспределенияЗатрат = ?(Не ПриСозданииДокумента, Объект.Дата, ТекущаяДатаСеанса());
	Элементы.МесяцРаспределенияЗатрат.Заголовок = Формат(ДатаРаспределенияЗатрат, "ДФ='MMММ yyyy ''г.'''");
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРаспределенныеСуммыНаСервере()
	
	Модифицированность = Истина;
	
	Объект.БазаРаспределения = 0;
	Объект.РасходыОсновнойДеятельности.Очистить();
	Объект.БазаРаспределенияПоГосударственнымКонтрактам.Очистить();
	Объект.РаспределенныеСуммыПоГосударственнымКонтрактам.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗаписиМодифицированногоДокумента(Результат, ПараметрыВопроса) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда 	
        Возврат;    	
	КонецЕсли;
	
	ИмяПечатнойФормы = "";
	ПараметрыВопроса.Свойство("ИмяПечатнойФормы", ИмяПечатнойФормы);
	
	Если Не ПустаяСтрока(ИмяПечатнойФормы) Тогда
		
		ДокументЗаписан = Записать();
		
		Если ДокументЗаписан Тогда
			
			ПечатьДокумента(ИмяПечатнойФормы);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОчисткеРаспределенныхСумм(Результат, Параметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда		
        Возврат;     	
	КонецЕсли;
	
	ОчиститьРаспределенныеСуммыНаСервере();
	УстановитьВидимостьДоступность();
	УдалитьДанныеВДеревьях();	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПерераспределенииСумм(Результат, Параметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда		
        Возврат; 	
	КонецЕсли;
	
	ЗаполнитьРаспределениеСуммНаСервере();    
	ЗаполнитьДанныеДеревьевПоТабличнымЧастям();
	УстановитьВидимостьДоступность();

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступность()

	ЕстьРаспределеннияСумм = Объект.РаспределенныеСуммыПоГосударственнымКонтрактам.Количество() > 0;
	
	Элементы.Дата.ТолькоПросмотр = ЕстьРаспределеннияСумм;
	Элементы.Организация.ТолькоПросмотр = ЕстьРаспределеннияСумм;
	Элементы.ОчиститьРаспределенныеСуммы.Доступность = ЕстьРаспределеннияСумм;
	Элементы.ГруппаОтборПодразделение.ТолькоПросмотр = ЕстьРаспределеннияСумм;    
	Элементы.Ответственный.Доступность = Не РольДоступна("ПолныеПрава");

	//НАЧАЛО Морозов А.В. (Код-Эксперт) 22.01.2026 Выполнение задач №000056468
	Элементы.ИсключатьСтоимостьУслуг.Видимость = (Объект.ВариантРаспределенияЗатрат = ПредопределенноеЗначение("Перечисление.тн_ВариантыРаспределенияЗатратМеждуГОЗИОсновнойДеятельностью.ПоВыручке"));
	//КОНЕЦ Морозов А.В. (Код-Эксперт) 22.01.2026 Выполнение задач №000056468
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСДеревомЗначений

&НаКлиенте
Процедура ЗаполнитьДанныеДеревьевПоТабличнымЧастям()
	
	ЗаполнитьДанныеДеревьевПоТабличнымЧастямНаСервере();	
	РазвернутьСтрокиДеревьев();	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеДеревьевПоТабличнымЧастямНаСервере()
	
	ЗаполнитьРасходыОсновнойДеятельности();
	ЗаполнитьБазаРаспределенияПоГосударственнымКонтрактам();
	ЗаполнитьРаспределенныеСуммыПоГосударственнымКонтрактам();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасходыОсновнойДеятельности()
	
	ДеревоЗначенийРасходыОсновнойДеятельности = РеквизитФормыВЗначение("РасходыОсновнойДеятельности", Тип("ДеревоЗначений"));
	ДеревоЗначенийРасходыОсновнойДеятельности.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаРасходыОсновнойДеятельности.Счет КАК Счет,
	               |	ТаблицаРасходыОсновнойДеятельности.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	ТаблицаРасходыОсновнойДеятельности.ДокументРасхода КАК ДокументРасхода,
	               |	ТаблицаРасходыОсновнойДеятельности.Сумма КАК Сумма
	               |ПОМЕСТИТЬ ВТ_РасходыОсновнойДеятельности
	               |ИЗ
	               |	&РасходыОсновнойДеятельности КАК ТаблицаРасходыОсновнойДеятельности
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТ_РасходыОсновнойДеятельности.Счет КАК Счет,
	               |	ВТ_РасходыОсновнойДеятельности.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	ВТ_РасходыОсновнойДеятельности.ДокументРасхода КАК ДокументРасхода,  
				   
				   //НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				   
				   |	ПРЕДСТАВЛЕНИЕ(ВТ_РасходыОсновнойДеятельности.Счет) КАК СчетПредставление,
	               |	ПРЕДСТАВЛЕНИЕ(ВТ_РасходыОсновнойДеятельности.СтатьяЗатрат) КАК СтатьяЗатратПредставление,
	               |	ПРЕДСТАВЛЕНИЕ(ВТ_РасходыОсновнойДеятельности.ДокументРасхода) КАК ДокументРасходаПредставление,	
				   
				   //КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				   
	               |	СУММА(ВТ_РасходыОсновнойДеятельности.Сумма) КАК Сумма
	               |ИЗ
	               |	ВТ_РасходыОсновнойДеятельности КАК ВТ_РасходыОсновнойДеятельности
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_РасходыОсновнойДеятельности.Счет,
	               |	ВТ_РасходыОсновнойДеятельности.СтатьяЗатрат,
	               |	ВТ_РасходыОсновнойДеятельности.ДокументРасхода
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Счет,
	               |	СтатьяЗатрат
	               |ИТОГИ
	               |	СУММА(Сумма)
	               |ПО
	               |	ОБЩИЕ,
	               |	Счет,
	               |	СтатьяЗатрат
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("РасходыОсновнойДеятельности", Объект.РасходыОсновнойДеятельности.Выгрузить());
	
	РезультатОбщийИтог = Запрос.Выполнить();
	ВыборкаОбщийИтог = РезультатОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОбщийИтог.Следующий() Цикл
		
		НоваяСтрокаОбщийИтог = ДеревоЗначенийРасходыОсновнойДеятельности.Строки.Добавить();
		
		//НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
		
		//ЗаполнитьЗначенияСвойств(НоваяСтрокаОбщийИтог, ВыборкаОбщийИтог);
		
		НоваяСтрокаОбщийИтог.Сумма = ВыборкаОбщийИтог.Сумма;
		
		//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
		
		НоваяСтрокаОбщийИтог.Представление = "По всем счетам";
		НоваяСтрокаОбщийИтог.Значение = НоваяСтрокаОбщийИтог.Представление;
		
		ВыборкаСчет = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСчет.Следующий() Цикл
			
			НоваяСтрокаСчет = НоваяСтрокаОбщийИтог.Строки.Добавить();
			
			//НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
			
			//ЗаполнитьЗначенияСвойств(НоваяСтрокаСчет, ВыборкаСчет);     
			//
			//НоваяСтрокаСчет.Представление = ВыборкаСчет.Счет;
			
			НоваяСтрокаСчет.Счет 			= ВыборкаСчет.Счет;   
			НоваяСтрокаСчет.Сумма			= ВыборкаСчет.Сумма;
			НоваяСтрокаСчет.Представление 	= ВыборкаСчет.СчетПредставление;
						
			//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
			
			НоваяСтрокаСчет.Значение = ВыборкаСчет.Счет;
			
			ВыборкаСтатьяЗатрат = ВыборкаСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаСтатьяЗатрат.Следующий() Цикл

				НоваяСтрокаСтатьяЗатрат = НоваяСтрокаСчет.Строки.Добавить();
				
				//НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				
