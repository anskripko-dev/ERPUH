#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	
	БазаРаспределения = 0;
	РасходыОсновнойДеятельности.Очистить();
	БазаРаспределенияПоГосударственнымКонтрактам.Очистить();
	РаспределенныеСуммыПоГосударственнымКонтрактам.Очистить();
	
КонецПроцедуры
	
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда		
		ПроверитьСуществованиеДокументаРаспределенияВОдномМесяце(Отказ); 	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ДвиженияДокумента(Отказ);
	
КонецПроцедуры

#КонецОбласти 

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьСуммыРаспределенияПоГосударственномуКонтракту() Экспорт
			
	ВидыСубконтоРасходы = Новый Массив;
	ВидыСубконтоРасходы.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат);	
		
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДляРаспределенияСуммПоГосударственомуКонтракту();	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецМесяца(Дата));
	Запрос.УстановитьПараметр("МассивСчетовРасходаОсновнойДеятельности", Документы.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.ПолучитьМассивСчетовРасходаОсновнойДеятельности());
	Запрос.УстановитьПараметр("СчетРаспределенияЗатратОсновнойДеятельности", Документы.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.ПолучитьСчетРаспределенияЗатратОсновнойДеятельности(ВариантРаспределенияЗатрат));
	Запрос.УстановитьПараметр("ВидыСубконтоРасходы", ВидыСубконтоРасходы);     
 	// НАЧАЛО Морозов А.В. (Код-Эксперт) 22.01.2026 Выполнение задач №000056468
	Запрос.УстановитьПараметр("НеИсключатьСтоимостьУслуг", Не ИсключатьСтоимостьУслуг);
 	// КОНЕЦ Морозов А.В. (Код-Эксперт) 22.01.2026 Выполнение задач №000056468
	
	УстановитьЗначениеОтбораИзСпискаОтборов(Запрос, "Подразделение", "Подразделение");
	
	МассивРезультатов = Запрос.ВыполнитьПакет();  
	
	ВыборкаОбщаяБазаРаспределения = МассивРезультатов[МассивРезультатов.Количество() - 4].Выбрать();  
	
	БазаРаспределения = ?(ВыборкаОбщаяБазаРаспределения.Следующий(), ВыборкаОбщаяБазаРаспределения.Сумма, 0);
	
	РасходыОсновнойДеятельности.Загрузить(МассивРезультатов[МассивРезультатов.Количество() - 3].Выгрузить());
	РаспределенныеСуммыПоГосударственнымКонтрактам.Загрузить(МассивРезультатов[МассивРезультатов.Количество() - 2].Выгрузить());
	БазаРаспределенияПоГосударственнымКонтрактам.Загрузить(МассивРезультатов[МассивРезультатов.Количество() - 1].Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДвиженияДокумента(Отказ)
	
	Движения.тн_РасходыПоГосударственнымКонтрактам.Записывать = Истина;
	Движения.тн_РасходыПоГосударственнымКонтрактам.Очистить();   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки,
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.СтатьяЗатрат КАК СтатьяЗатрат,
		|	СУММА(тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.Сумма) КАК Сумма
		|ИЗ
		|	Документ.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.РаспределенныеСуммыПоГосударственнымКонтрактам КАК тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам
		|ГДЕ
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.Ссылка = &СсылкаДокумент
		|
		|СГРУППИРОВАТЬ ПО
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.СтатьяЗатрат,
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки,
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.ДоговорКонтрагента,
		|	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.ГосударственныйКонтракт
		|
		|ИМЕЮЩИЕ   
		
		//НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
		
		//|	СУММА(тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.Сумма) > 0";
		
		|	СУММА(тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосударственнымКонтрактам.Сумма) <> 0";
		
		//КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812      
	
	Запрос.УстановитьПараметр("СсылкаДокумент", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Движение = Движения.тн_РасходыПоГосударственнымКонтрактам.Добавить();
		Движение.Период = КонецМесяца(Дата);
		Движение.ГосударственныйКонтракт = ВыборкаДетальныеЗаписи.ГосударственныйКонтракт;
		Движение.ДоговорКонтрагента = ВыборкаДетальныеЗаписи.ДоговорКонтрагента;
		Движение.ИдентификационныйКодЗакупки = ВыборкаДетальныеЗаписи.ИдентификационныйКодЗакупки;
		Движение.СтатьяРасходов = ВыборкаДетальныеЗаписи.СтатьяЗатрат;
		Движение.Сумма = ВыборкаДетальныеЗаписи.Сумма;
     	
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСуществованиеДокументаРаспределенияВОдномМесяце(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью КАК тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью
	               |ГДЕ                                                                                  
				   |	НАЧАЛОПЕРИОДА(тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Дата, МЕСЯЦ) = &ДатаФормирования
	               |	И тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Проведен                    
				   |	И тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Организация = &Организация
	               |	И НЕ тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Ссылка = &ТекущийДокумент";
	
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.УстановитьПараметр("ДатаФормирования", НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда

		ТекстОшибки = СтрШаблон("За %1 по организации ""%2"" уже существует проведенный документ: %3", Формат(Дата, "ДФ='МММM yyyy ''г.'''"), Строка(Организация), Строка(Выборка.Ссылка));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, , , Отказ);
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьТекстЗапросаДляРаспределенияСуммПоГосударственомуКонтракту()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДокументОтгрузки КАК ДокументОтгрузки,
	               |	тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки
	               |ПОМЕСТИТЬ ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам
	               |ИЗ
	               |	РегистрСведений.тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам КАК тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам
	               |ГДЕ
	               |	тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДокументОтгрузки.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВыручкаИСебестоимостьПродажОбороты.Регистратор КАК ИсправляемыйДокумент,
	               |	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента КАК ДокументОтгрузки
	               |ПОМЕСТИТЬ ВТ_ДвиженияПоИсправляемымДокументамОтгузки
	               |ИЗ
	               |	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	               |			&НачалоПериода,
	               |			&ОкончаниеПериода,
	               |			Регистратор,
	               |			ЗаказКлиента В
	               |				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДокументОтгрузки КАК ДокументОтгрузки
	               |				ИЗ
	               |					ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам КАК ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам)) КАК ВыручкаИСебестоимостьПродажОбороты
	               |ГДЕ
	               |	ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВыручкаИСебестоимостьПродажОбороты.Регистратор,
	               |	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента
	               |ИЗ
	               |	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	               |			&НачалоПериода,
	               |			&ОкончаниеПериода,
	               |			Регистратор,
	               |			ЗаказКлиента В
	               |				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДокументОтгрузки КАК ДокументОтгрузки
	               |				ИЗ
	               |					ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам КАК ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам)) КАК ВыручкаИСебестоимостьПродажОбороты
	               |ГДЕ
	               |	ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.Сторно
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДокументОтгрузки КАК ДокументОтгрузки,
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки
	               |ПОМЕСТИТЬ ВТ_ДокументыОтгрузкиПоГосударственнымКонтрактам
	               |ИЗ
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам КАК ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_ДвиженияПоИсправляемымДокументамОтгузки.ИсправляемыйДокумент,
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ГосударственныйКонтракт,
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДоговорКонтрагента,
	               |	ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки
	               |ИЗ
	               |	ВТ_ДвиженияПоИсправляемымДокументамОтгузки КАК ВТ_ДвиженияПоИсправляемымДокументамОтгузки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам КАК ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам
	               |		ПО ВТ_ДвиженияПоИсправляемымДокументамОтгузки.ДокументОтгрузки = ВТ_СовершенныеОтгрузкиПоГосударственнымКонтрактам.ДокументОтгрузки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ХозрасчетныйОбороты.Регистратор КАК ДокументРасхода,
	               |	ХозрасчетныйОбороты.Счет КАК Счет,
	               |	ХозрасчетныйОбороты.Субконто1 КАК СтатьяЗатрат,
	               |	ХозрасчетныйОбороты.СуммаОборотДт КАК Сумма
	               |ПОМЕСТИТЬ ВТ_РасходыОсновнойДеятельности
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.Обороты(
	               |			&НачалоПериода,
	               |			&ОкончаниеПериода,
	               |			Регистратор,
	               |			Счет В ИЕРАРХИИ (&МассивСчетовРасходаОсновнойДеятельности),
	               |			&ВидыСубконтоРасходы,
	               |			Организация = &Организация  
				   |				//#УсловиеПоПодразделение
	               |				И ЕСТЬNULL(НаправлениеДеятельности.ГосударственныйКонтракт, ЗНАЧЕНИЕ(Справочник.ГосударственныеКонтракты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ГосударственныеКонтракты.ПустаяСсылка)
	               |				И НЕ Субконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.тн_СебестоимостьРеализованныхПрочихДопУслугПоДоставкеГП),
	               |			,
	               |			) КАК ХозрасчетныйОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОборотыРаспределенияЗатрат.Регистратор КАК ДокументРегистратор,
	               |	ОборотыРаспределенияЗатрат.Счет КАК Счет,
	               |	ВЫБОР
	               |		КОГДА ОборотыРаспределенияЗатрат.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыручкаНеЕНВД)
	               |			ТОГДА ОборотыРаспределенияЗатрат.СуммаНУОборотКт
	               |		ИНАЧЕ ОборотыРаспределенияЗатрат.СуммаНУОборотДт 
	               |	КОНЕЦ КАК Сумма
	               |ПОМЕСТИТЬ ВТ_ОборотыРаспределенияЗатрат
