Процедура УстановитьЗначениеОтбораИзСпискаОтборов(Запрос, ИмяПоля, ИмяПоляВЗапросе)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяПоля", ИмяПоля);
	НайденныеСтроки = СписокОтборов.НайтиСтроки(Отбор);
	
	Если Не НайденныеСтроки.Количество() = 0 Тогда
		
		УсловиеПоиска = "//#УсловиеПо" + ИмяПоля;
		УсловиеЗамены = СтрШаблон("И %1 %2 %3 (&Массив%4)"
								,?(Не СтрНайти(ВРег(НайденныеСтроки[0].ВидСравнения), "НЕ") = 0, "НЕ", "")
								,ИмяПоляВЗапросе
								,?(Не СтрНайти(ВРег(НайденныеСтроки[0].ВидСравнения), "ГРУППЕ") = 0, "В ИЕРАРХИИ", "В")
								,ИмяПоля);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, УсловиеПоиска, УсловиеЗамены);
		
		МассивЗначенийОтбора = Новый Массив;
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 			
			МассивЗначенийОтбора.Добавить(НайденнаяСтрока.ЗначениеПоля);				
		КонецЦикла; 
		
		Запрос.УстановитьПараметр("Массив" + ИмяПоля, МассивЗначенийОтбора);
		
	КонецЕсли;
	
КонецПроцедуры

