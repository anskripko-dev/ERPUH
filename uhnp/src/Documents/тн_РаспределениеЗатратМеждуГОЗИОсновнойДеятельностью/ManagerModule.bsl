Функция ПолучитьМассивСчетовРасходаОсновнойДеятельности() Экспорт
		
	МассивСчетовРасходаОсновнойДеятельности = Новый Массив;
	МассивСчетовРасходаОсновнойДеятельности.Добавить(ПланыСчетов.Хозрасчетный.ОбщехозяйственныеРасходы);
	МассивСчетовРасходаОсновнойДеятельности.Добавить(ПланыСчетов.Хозрасчетный.РасходыНаПродажу);
	
	Возврат МассивСчетовРасходаОсновнойДеятельности;
	
КонецФункции

Функция ПолучитьСчетРаспределенияЗатратОсновнойДеятельности(ВариантРаспределенияЗатрат) Экспорт
		
	Возврат ?(ВариантРаспределенияЗатрат = Перечисления.тн_ВариантыРаспределенияЗатратМеждуГОЗИОсновнойДеятельностью.ПоСебестоимости
								,ПланыСчетов.Хозрасчетный.СебестоимостьПродажНеЕНВД
								,ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД); 
								
КонецФункции
	
Функция ПолучитьПечатнуюФормуДокумента(СсылкаДокумента) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, "Дата, Организация"); 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = Документы.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.ПолучитьМакет("РаспределенныеСуммыПоСтатьям");
	
	ОбластьШапка 				= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 				= Макет.ПолучитьОбласть("Строка");
	ОбластьИтогПоГосКонтракту 	= Макет.ПолучитьОбласть("ИтогПоГосударственномуКонтракту");
	ОбластьОбщийИтог 			= Макет.ПолучитьОбласть("ОбщийИтог");
	
	ОбластьШапка.Параметры.Организация = РеквизитыДокумента.Организация;
	ОбластьШапка.Параметры.МесяцФормирования = Формат(РеквизитыДокумента.Дата, "ДФ='MMММ yyyy ''г.'''");
	ТабличныйДокумент.Вывести(ОбластьШапка);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.БазаРаспределения) КАК БазаРаспределения,
	               |	ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента КАК ДоговорКонтрагента,
				   
				   //НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				   
				   |	ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента.НаправлениеДеятельности КАК НаправлениеДеятельности,
				   
				   //КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				   
				   |	СУММА(ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.Сумма) КАК Сумма,
	               |	ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки
	               |ПОМЕСТИТЬ ВТ_БазаРаспределенияПоГосударственнымКонтрактам
	               |ИЗ
	               |	Документ.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.БазаРаспределенияПоГосударственнымКонтрактам КАК ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью КАК тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью
	               |		ПО ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.Ссылка = тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Ссылка
	               |ГДЕ
	               |	тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.Ссылка = &СсылкаНаДокумент
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт,
	               |	ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента,
	               |	ТабличнаяЧастьБазаРаспределенияПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	НаправленияДеятельности.НомерКонтракта КАК НомерКонтракта,
	               |	НаправленияДеятельности.ДатаЗаключенияКонтракта КАК ДатаКонтракта
	               |ПОМЕСТИТЬ ВТ_Контракты
	               |ИЗ
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам КАК ВТ_БазаРаспределенияПоГосударственнымКонтрактам
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаправленияДеятельности КАК НаправленияДеятельности
				   
				   //НАЧАЛО Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				   
				   //|		ПО ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт = НаправленияДеятельности.ГосударственныйКонтракт
				   
				   |		ПО ВТ_БазаРаспределенияПоГосударственнымКонтрактам.НаправлениеДеятельности = НаправленияДеятельности.Ссылка
	               |			И ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт = НаправленияДеятельности.ГосударственныйКонтракт
				   
				   //КОНЕЦ  Ведутенко С.А. 07.06.2024 Выполнение задач №000049812
				   
				   |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам.КоэффициентРаспределения КАК КоэффициентРаспределения,
	               |	РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам.Сумма КАК Сумма,
	               |	РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки
	               |ПОМЕСТИТЬ ВТ_РаспределенныеСуммы
	               |ИЗ
	               |	Документ.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.РаспределенныеСуммыПоГосударственнымКонтрактам КАК РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам
	               |ГДЕ
	               |	РаспределениеЗатратМеждуГОЗИОсновнойДеятельностьюРаспределенныеСуммыПоГосКонтрактам.Ссылка = &СсылкаНаДокумент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ВТ_РаспределенныеСуммы.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	ВТ_РаспределенныеСуммы.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ВТ_РаспределенныеСуммы.КоэффициентРаспределения КАК КоэффициентРаспределения,
	               |	ВТ_РаспределенныеСуммы.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки
	               |ПОМЕСТИТЬ ВТ_КоэффициентРаспределенияПоДоговорам
	               |ИЗ
	               |	ВТ_РаспределенныеСуммы КАК ВТ_РаспределенныеСуммы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ВТ_КоэффициентРаспределенияПоДоговорам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	ВТ_КоэффициентРаспределенияПоДоговорам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	СУММА(ВТ_КоэффициентРаспределенияПоДоговорам.КоэффициентРаспределения) КАК КоэффициентРаспределения,
	               |	ВТ_КоэффициентРаспределенияПоДоговорам.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки
	               |ПОМЕСТИТЬ ВТ_КоэффициентРаспределения
	               |ИЗ
	               |	ВТ_КоэффициентРаспределенияПоДоговорам КАК ВТ_КоэффициентРаспределенияПоДоговорам
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_КоэффициентРаспределенияПоДоговорам.ГосударственныйКонтракт,
	               |	ВТ_КоэффициентРаспределенияПоДоговорам.ДоговорКонтрагента,
	               |	ВТ_КоэффициентРаспределенияПоДоговорам.ИдентификационныйКодЗакупки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.БазаРаспределения КАК БазаРаспределения,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ЕСТЬNULL(ВТ_Контракты.НомерКонтракта, """") КАК НомерГосКонтракта,
	               |	ЕСТЬNULL(ВТ_Контракты.ДатаКонтракта, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаГосКонтракта,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт.Код КАК ИГК,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.Сумма КАК СебестоимостьГосКонтракта,
	               |	ЕСТЬNULL(ВТ_КоэффициентРаспределения.КоэффициентРаспределения, 0) КАК ДоляРаспределения,
	               |	ВТ_РаспределенныеСуммы.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	СУММА(ЕСТЬNULL(ВТ_РаспределенныеСуммы.Сумма, 0)) КАК РаспределеннаяСумма,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки
	               |ИЗ
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам КАК ВТ_БазаРаспределенияПоГосударственнымКонтрактам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоэффициентРаспределения КАК ВТ_КоэффициентРаспределения
	               |		ПО ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт = ВТ_КоэффициентРаспределения.ГосударственныйКонтракт
	               |			И ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента = ВТ_КоэффициентРаспределения.ДоговорКонтрагента
	               |			И ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки = ВТ_КоэффициентРаспределения.ИдентификационныйКодЗакупки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределенныеСуммы КАК ВТ_РаспределенныеСуммы
	               |		ПО ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт = ВТ_РаспределенныеСуммы.ГосударственныйКонтракт
	               |			И ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента = ВТ_РаспределенныеСуммы.ДоговорКонтрагента
	               |			И ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки = ВТ_РаспределенныеСуммы.ИдентификационныйКодЗакупки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контракты КАК ВТ_Контракты
	               |		ПО ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт = ВТ_Контракты.ГосударственныйКонтракт
	               |			И ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента = ВТ_Контракты.ДоговорКонтрагента
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.БазаРаспределения,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента,
	               |	ЕСТЬNULL(ВТ_Контракты.НомерКонтракта, """"),
	               |	ЕСТЬNULL(ВТ_Контракты.ДатаКонтракта, ДАТАВРЕМЯ(1, 1, 1)),
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт.Код,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.Сумма,
	               |	ЕСТЬNULL(ВТ_КоэффициентРаспределения.КоэффициентРаспределения, 0),
	               |	ВТ_РаспределенныеСуммы.СтатьяЗатрат,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ИдентификационныйКодЗакупки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ГосударственныйКонтракт.Код,
	               |	ВТ_БазаРаспределенияПоГосударственнымКонтрактам.ДоговорКонтрагента.Номер,
	               |	ВТ_РаспределенныеСуммы.СтатьяЗатрат.Наименование
	               |ИТОГИ
	               |	МАКСИМУМ(НомерГосКонтракта),
	               |	МАКСИМУМ(ДатаГосКонтракта),
	               |	МАКСИМУМ(СебестоимостьГосКонтракта),
	               |	МАКСИМУМ(ДоляРаспределения),
	               |	СУММА(РаспределеннаяСумма)
	               |ПО
	               |	ОБЩИЕ,
	               |	ГосударственныйКонтракт,
	               |	ДоговорКонтрагента,
	               |	ИдентификационныйКодЗакупки";
				   
	Запрос.УстановитьПараметр("СсылкаНаДокумент", СсылкаДокумента);

	Результат = Запрос.Выполнить(); 
	
	Если Не Результат.Пустой() Тогда
		
		ИтогоСебестоимостьГосКонтракта = 0;		
		ИтогоДоляРаспределения = 0;
		
		ВыборкаОбщийИтог = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 	
		Пока ВыборкаОбщийИтог.Следующий() Цикл
		
			ВыборкаГосударственныйКонтракт = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаГосударственныйКонтракт.Следующий() Цикл
				
				ВыборкаДоговор = ВыборкаГосударственныйКонтракт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаДоговор.Следующий() Цикл
					
					ВыборкаИКЗ = ВыборкаДоговор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаИКЗ.Следующий() Цикл
						
						СтрокаНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
					
						ОбластьСтрока.Параметры.ДатаГосКонтракта = Формат(ВыборкаДоговор.ДатаГосКонтракта, "ДФ=dd.MM.yyyy");
						ОбластьСтрока.Параметры.ДоляРаспределения = ВыборкаИКЗ.ДоляРаспределения;
						
						ИсключаемыеСвойства = "ДатаГосКонтракта, ДоляРаспределения";
						
						ВыборкаСтатьиЗатрат = ВыборкаИКЗ.Выбрать();
						
						Пока ВыборкаСтатьиЗатрат.Следующий() Цикл
							
							ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаСтатьиЗатрат,, ИсключаемыеСвойства);
							ТабличныйДокумент.Вывести(ОбластьСтрока);
							
						КонецЦикла;
						
						ИтогоСебестоимостьГосКонтракта = ИтогоСебестоимостьГосКонтракта + ВыборкаИКЗ.СебестоимостьГосКонтракта;
						ИтогоДоляРаспределения = ИтогоДоляРаспределения + ВыборкаИКЗ.ДоляРаспределения;										
						
						СтрокаОкончание = ТабличныйДокумент.ВысотаТаблицы;
						
						ВыполнитьДействиеНадОбластью(ТабличныйДокумент, СтрокаНачало, 1, СтрокаОкончание, 2); // Государственный контракт
						ВыполнитьДействиеНадОбластью(ТабличныйДокумент, СтрокаНачало, 3, СтрокаОкончание, 5); // ИГК
						ВыполнитьДействиеНадОбластью(ТабличныйДокумент, СтрокаНачало, 6, СтрокаОкончание, 8); // ИКЗ
						ВыполнитьДействиеНадОбластью(ТабличныйДокумент, СтрокаНачало, 9, СтрокаОкончание, 10); // Себестоимость всей реализованной продукции
						ВыполнитьДействиеНадОбластью(ТабличныйДокумент, СтрокаНачало, 11, СтрокаОкончание, 12); // Себестоимость по каждому гос.контракту
						ВыполнитьДействиеНадОбластью(ТабличныйДокумент, СтрокаНачало, 13, СтрокаОкончание, 14); // Доля каждого гос.контракта в %					
						
						ОбластьИтогПоГосКонтракту.Параметры.РаспределеннаяСумма = ВыборкаИКЗ.РаспределеннаяСумма;
						
						ТабличныйДокумент.Вывести(ОбластьИтогПоГосКонтракту);
						
					КонецЦикла;
					
				КонецЦикла;
					
			КонецЦикла;
			
			ОбластьОбщийИтог.Параметры.ИтогоСебестоимостьГосКонтракта = ИтогоСебестоимостьГосКонтракта;
			ОбластьОбщийИтог.Параметры.ИтогоДоляРаспределения = ИтогоДоляРаспределения;
			ОбластьОбщийИтог.Параметры.ИтогоРаспределеннаяСумма = ВыборкаОбщийИтог.РаспределеннаяСумма;
			
			ТабличныйДокумент.Вывести(ОбластьОбщийИтог);   
			
		КонецЦикла;
		
	КонецЕсли;  
	
	Результат = Новый Структура;
	Результат.Вставить("ПечатнаяФормаДокумента", ТабличныйДокумент);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПечатнуюФормуСправкиДокумента(СсылкаДокумента) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, "Дата, Организация");
	
	СхемаКомпоновки = Документы.тн_РаспределениеЗатратМеждуГОЗИОсновнойДеятельностью.ПолучитьМакет("РасшифровкаСебестоимостиПоГосКонтрактам");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	
	ПараметрСсылкаНаДокумент = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("СсылкаНаДокумент"));
	ПараметрСсылкаНаДокумент.Значение = СсылкаДокумента;
	ПараметрСсылкаНаДокумент.Использование = Истина;
	
	ПараметрОрганизация = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	ПараметрОрганизация.Значение = РеквизитыДокумента.Организация;
	ПараметрОрганизация.Использование = Истина;
	
	ПараметрМесяцФормирования = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МесяцФормирования"));
	ПараметрМесяцФормирования.Значение = Формат(РеквизитыДокумента.Дата, "ДФ='MMММ yyyy ''г.'''");
	ПараметрМесяцФормирования.Использование = Истина;

	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,, ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	УникальныйИдентификаторСКД = Новый УникальныйИдентификатор;
	АдресХранилищаСКД = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификаторСКД);
	АдресРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, УникальныйИдентификаторСКД);
	
	Результат = Новый Структура;
	Результат.Вставить("ПечатнаяФормаДокумента", ТабличныйДокумент);
	Результат.Вставить("АдресХранилищаСКД", АдресХранилищаСКД);
	Результат.Вставить("АдресРасшифровки", АдресРасшифровки);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьДействиеНадОбластью(ТабличныйДокумент, СтрокаНачало, КолонкаНачало, СтрокаОкончание, КолонкаОкончание, Знач ДополнительныеПараметры = Неопределено)

	Если Не ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		
		ДополнительныеПараметры = Новый Структура;
		
	КонецЕсли;
	
	ОбластьТабДок = ТабличныйДокумент.Область(СтрокаНачало, КолонкаНачало, СтрокаОкончание, КолонкаОкончание);
	ОбластьТабДок.Объединить();
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ОбластьТабДок.Обвести(Линия, Линия, Линия, Линия);
	
КонецПроцедуры

