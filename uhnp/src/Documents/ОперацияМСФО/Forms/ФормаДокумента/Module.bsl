&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммуОперации(Форма)
	
	Объект = Форма.Объект;
	
	Объект.СуммаОперации = Объект.Движения.МСФО.Итог("СуммаВВалютеУчета");
	
	Если Форма.КэшируемыеЗначения.БезКорреспонденции Тогда
		
		Форма.ИтогДт = Форма.МСФО_.Итог("СуммаВВалютеУчетаДт");
		Форма.ИтогКт = Форма.МСФО_.Итог("СуммаВВалютеУчетаКт");

		СкорректироватьСуммыДопВалюты(Форма);

		Объект.СуммаОперации = Форма.ИтогДт - Форма.ИтогКт;
		Форма.КоличествоСтрокБезКор = Форма.МСФО_.Количество();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СкорректироватьСуммыДопВалюты(Форма)

	Объект = Форма.Объект;

	Если Объект.НезависимыеСуммы 
		Или (Форма.ИтогДт <> Форма.ИтогКт)
		Или Форма.КэшируемыеЗначения.ФункциональнаяВалюта = Форма.КэшируемыеЗначения.ВалютаПредоставленияОтчетности
		Или Форма.МСФО_.Итог("СуммаВВалютеОтчетностиДт") = Форма.МСФО_.Итог("СуммаВВалютеОтчетностиКт") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ФВ = Форма.КэшируемыеЗначения.ФункциональнаяВалюта;
	ВО = Форма.КэшируемыеЗначения.ВалютаПредоставленияОтчетности;
	
	Организация = Объект.Организация; 
	КэшКурсов = Форма.КэшируемыеЗначения.КэшКурсов;
	
	Для каждого _ Из Форма.МСФО_ Цикл
		
		Дата = _.Период;
		
		_.СуммаВВалютеОтчетностиДт = МСФОКлиентСерверУХ.ВВалюту(_.СуммаВВалютеУчетаДт, ВО, ФВ, Дата, Организация, КэшКурсов);
		_.СуммаВВалютеОтчетностиКт = МСФОКлиентСерверУХ.ВВалюту(_.СуммаВВалютеУчетаКт, ВО, ФВ, Дата, Организация, КэшКурсов);
		
	КонецЦикла;
	
	Разница = Форма.МСФО_.Итог("СуммаВВалютеОтчетностиДт") - Форма.МСФО_.Итог("СуммаВВалютеОтчетностиКт");
	Если Разница = 0 Тогда
		Возврат; 
	КонецЕсли;
	
	ИмяКолонкиДобавления = ?(Разница > 0, "СуммаВВалютеОтчетностиКт", "СуммаВВалютеОтчетностиДт");
	
	ИндексМакс = 0;
	Для каждого _ Из Форма.МСФО_ Цикл
		Если _[ИмяКолонкиДобавления] > Форма.МСФО_[ИндексМакс][ИмяКолонкиДобавления] Тогда
			ИндексМакс = Форма.МСФО_.Индекс(_);
		КонецЕсли;
	КонецЦикла;
	
	Форма.МСФО_[ИндексМакс][ИмяКолонкиДобавления] 
		= Форма.МСФО_[ИндексМакс][ИмяКолонкиДобавления]
		+  Макс(Разница, -Разница);
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетСуммы(ИсточникПересчета = "Дт")

	ПересчитатьСуммыПроводки(ЭтотОбъект, Элементы.МСФО.ТекущиеДанные, ИсточникПересчета);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчетСуммыБезКорр(Форма, ЭлементИсточник)

	ИдСтроки = Форма.Элементы.МСФО_.ТекущаяСтрока;
	Если ИдСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Форма.МСФО_.НайтиПоИдентификатору(ИдСтроки);
	
	ДтКт = ?(СтрЗаканчиваетсяНа(ЭлементИсточник.Имя, "Дт"), "Дт", "Кт");
	
	Код = "ФВ";
	Если СтрНачинаетсяС(ЭлементИсточник.Имя, "МСФО_СуммаВВалютеОтчетности") Тогда
		Код = "ВО";
	ИначеЕсли Не СтрНачинаетсяС(ЭлементИсточник.Имя, "МСФО_СуммаВВалютеУчета") Тогда 
		Код = "ВД";
	КонецЕсли;
	
	ПараметрыПересчета = МСФОКлиентСерверУХ.ПараметрыПересчета(
			"СуммаВВалютеУчета" + ДтКт, 
			"СуммаВВалютеОтчетности" + ДтКт,
			"СуммаВВалюте" + ДтКт,
			"Период",
			"Валюта",
			Неопределено);
	
	МСФОКлиентСерверУХ.ПересчитатьПроводкуПоСумме(
		Форма, ТекущаяСтрока, Код, ПараметрыПересчета);
		
	ПересчитатьСуммуОперации(Форма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПроводки(Форма, СтрокаТаб, Знач ИсточникПересчета = "Дт")
	
	ТекущаяСтрока = СтрокаТаб;
	Если Форма.Элементы.МСФО.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Форма.Элементы.МСФО.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИсточникПересчета = "Дт" Тогда
		ИсточникПересчета = "СуммаВВалютеДт";
	ИначеЕсли ИсточникПересчета = "Кт" Тогда
		ИсточникПересчета = "СуммаВВалютеКт";
	КонецЕсли;
	
	МСФОКлиентСерверУХ.ПересчитатьСуммыПроводки(Форма, ТекущаяСтрока, ИсточникПересчета); 
	ПересчитатьСуммуОперации(Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВопросПриИзменииОрганизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПриИзмененииОрганизацииНаСервере();
	Иначе
		Объект.Организация = ТекущаяОрганизация;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОрганизацииНаСервере()
	
	ЗаполнитьКэшируемыеЗначения();
	
	МСФОУХ.ДобавитьРеквизитыТаблицыПроводок(ЭтотОбъект, "Объект.Движения.МСФО", "МСФО", Истина);//реквизиты для видимости
	
	ТекущаяОрганизация = Объект.Организация;
	УстановитьПараметрыФункциональныхОпцийФормыОбъектаОперация();
	
	ПересчитатьСуммуОперации(ЭтотОбъект);
	ПроверитьВалютыОрганизации();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВалютыОрганизации()
    
	Если Объект.Организация.Пустая() Тогда
		Возврат;//не выводим сообщения если организация пустая	
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ФункциональнаяВалюта) Тогда
		ШаблонСообщения = НСтр("ru = 'У организации <%1> не указана функциональная валюта'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Объект.Организация);
		ОбщегоНазначенияКлиентСерверУХ.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "Организация", "Объект");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЭтотОбъект.ВалютаОтчетности) Тогда
		ШаблонСообщения = НСтр("ru = 'У организации <%1> не указана валюта предоставления отчетности'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Объект.Организация);
		ОбщегоНазначенияКлиентСерверУХ.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "Организация", "Объект");		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыФункциональныхОпцийФормыОбъектаОперация()
	
	ПериодФО    = Объект.Дата;
	Организация = Объект.Организация;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияБПКлиентСервер");
		Модуль.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(ЭтотОбъект, Организация, ПериодФО);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьПроводкиБезКорреспонденции()

	Документы.ОперацияМСФО.ПодготовитьПроводкиБезКорреспонденции(ЭтотОбъект);
	
	Таб = ПроводкиБезКорреспонденции.Выгрузить();
	Таб.Колонки.Удалить("КорСубконто1");
	Таб.Колонки.Удалить("КорСубконто2");
	Таб.Колонки.Удалить("КорСубконто3");
	
	Возврат ПоместитьВоВременноеХранилище(Таб, УникальныйИдентификатор);

КонецФункции
#КонецОбласти

