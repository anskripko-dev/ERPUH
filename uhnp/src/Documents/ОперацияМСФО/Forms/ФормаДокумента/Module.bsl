&НаКлиенте
Процедура Подключаемый_ЗаполнитьДокумент(РезультатВопроса = Неопределено, ДанныеЗаполнения) Экспорт
	
	Если (РезультатВопроса <> Неопределено) И (РезультатВопроса <> КодВозвратаДиалога.Да) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("КэшируемыеЗначения", КэшируемыеЗначения);// передача УП в заполнение без корреспонденции
	
	ЗаполнитьДокумент(ДанныеЗаполнения);
	
	ОбновлениеОтображения();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокумент(ДанныеЗаполнения)

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	Если КэшируемыеЗначения.БезКорреспонденции Тогда
		
		ПараметрыЗаполнения = Документы.ОперацияМСФО.ПараметрыЗаполнения();
		Документы.ОперацияМСФО.ЗаполнитьПроводкиИзРегистра(
			МСФО_, Объект.Движения.МСФО, КэшируемыеЗначения, ПараметрыЗаполнения);
			
		МСФОУХ.ДобавитьРеквизитыТаблицыПроводок(ЭтотОбъект, "МСФО_", "МСФО_", Ложь, "МСФО", "");

	КонецЕсли;
	
	Модифицированность = Истина;
	
	УдалитьИзВременногоХранилища(ДанныеЗаполнения.АдресТаблицы);
	ПроводкиБезКорреспонденции.Очистить();
	
	МСФОУХ.ДобавитьРеквизитыТаблицыПроводок(ЭтотОбъект, "Объект.Движения.МСФО", "МСФО", Истина);

КонецПроцедуры

