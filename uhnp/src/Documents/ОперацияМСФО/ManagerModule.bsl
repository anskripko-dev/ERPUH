Функция ПолучитьОперациюМСФОПоСторнируемомуДокументу(СторнируемыйДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ОперацияМСФО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперацияМСФО КАК ОперацияМСФО
	|ГДЕ
	|	ОперацияМСФО.СторнируемыйДокумент = &СторнируемыйДокумент
	|	И НЕ ОперацияМСФО.ПометкаУдаления";

	Запрос.УстановитьПараметр("СторнируемыйДокумент", СторнируемыйДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Документы.ОперацияМСФО.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

#Область ЗагрузкаТаблицей

Процедура ПодготовитьПроводкиБезКорреспонденции(Форма) Экспорт
	
	ЗагрузитьБезКорр(
	
		Форма.ПроводкиБезКорреспонденции, 
		Форма.Объект.Движения.МСФО.Выгрузить(), 
		Форма.КэшируемыеЗначения,
		"СторонаПроводки",
		Истина
	);

КонецПроцедуры

Процедура ЗаполнитьПроводкиИзРегистра(ТабПриемник, ТабИсточник, КэшируемыеЗначения, ПараметрыЗаполнения = Неопределено) Экспорт
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = ПараметрыЗаполнения();
	КонецЕсли;
	
	ТабПриемник.Очистить();
	
	КорСчет = КорСчетСложныхПроводок(КэшируемыеЗначения, ТабПриемник);
	ПоляДт = ПараметрыЗаполнения.Дт;
	ПоляКт = ПараметрыЗаполнения.Кт;
		
	Для каждого СтрокаИсточник Из ТабИсточник Цикл
		
		Если СтрокаИсточник.СчетДт <> КорСчет Тогда
			
			НоваяСтрока = ТабПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
			Для каждого ПолеДтКт Из ПоляДт Цикл
				НоваяСтрока[ПолеДтКт.Ключ] = СтрокаИсточник[ПолеДтКт.Значение];
			КонецЦикла;
			
		КонецЕсли;
		
		Если СтрокаИсточник.СчетКт <> КорСчет Тогда
			
			НоваяСтрока = ТабПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
			Для каждого ПолеДтКт Из ПоляКт Цикл
				НоваяСтрока[ПолеДтКт.Ключ] = СтрокаИсточник[ПолеДтКт.Значение];
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРегистрИзПроводок(ТабПриемник, ТабИсточник, КэшируемыеЗначения, ПараметрыЗаполнения = Неопределено) Экспорт
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = ПараметрыЗаполнения();
	КонецЕсли;
	
	ТабПриемник.Очистить();
	
	КорСчет = КорСчетСложныхПроводок(КэшируемыеЗначения, ТабИсточник);
	
	ПоляДт = ПараметрыЗаполнения.Дт;
	ПоляКт = ПараметрыЗаполнения.Кт;
	ПроверкаДт = ПараметрыЗаполнения.ПроверкаДт;
	ПроверкаКт = ПараметрыЗаполнения.ПроверкаКт;
	
	Для каждого СтрокаИсточник Из ТабИсточник Цикл
		
		Если СтрокаИсточник[ПроверкаДт.ФВ] <> 0
			Или СтрокаИсточник[ПроверкаДт.ВО] <> 0
			Или СтрокаИсточник[ПроверкаДт.ВД] <> 0
			Тогда
			
			НоваяСтрока = ТабПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
			
			НоваяСтрока.СчетКт = КорСчет;
			НоваяСтрока.КоличествоКт = 0;
			НоваяСтрока[ПоляКт.СуммаВВалютеКт] = 0;
			
			Для каждого ПолеДтКт Из ПоляДт Цикл
				НоваяСтрока[ПолеДтКт.Значение] = СтрокаИсточник[ПолеДтКт.Ключ];
			КонецЦикла;
			
		КонецЕсли;

		Если СтрокаИсточник[ПроверкаКт.ФВ] <> 0
			Или СтрокаИсточник[ПроверкаКт.ВО] <> 0
			Или СтрокаИсточник[ПроверкаКт.ВД] <> 0
			Тогда
			
			НоваяСтрока = ТабПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
			
			НоваяСтрока.СчетДт = КорСчет;
			НоваяСтрока.КоличествоДт = 0;
			НоваяСтрока[ПоляДт.СуммаВВалютеДт] = 0;
			
			Для каждого ПолеДтКт Из ПоляКт Цикл
				НоваяСтрока[ПолеДтКт.Значение] = СтрокаИсточник[ПолеДтКт.Ключ];
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ПараметрыЗаполнения(ИмяФВ = "СуммаВВалютеУчета", ИмяВО = "СуммаВВалютеОтчетности", ИмяВД = "СуммаВВалюте") Экспорт

	ПоляДт = Новый Структура(
		"Валюта, Подразделение, НаправлениеДеятельности,
		|Счет, Субконто1, Субконто2, Субконто3", 
	
		"ВалютаДт", "ПодразделениеДт", "НаправлениеДеятельностиДт",
		"СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3");
	
	ПоляДт.Вставить(ИмяФВ + "Дт", ИмяФВ);
	ПоляДт.Вставить(ИмяВО + "Дт", ИмяВО);
	ПоляДт.Вставить(ИмяВД + "Дт", ИмяВД + "Дт");
	
	ПоляКт = Новый Структура(
		"Валюта, Подразделение, НаправлениеДеятельности,
		|Счет, Субконто1, Субконто2, Субконто3", 
	
		"ВалютаКт", "ПодразделениеКт", "НаправлениеДеятельностиКт",
		"СчетКт", "СубконтоКт1", "СубконтоКт2", "СубконтоКт3");
	
	ПоляКт.Вставить(ИмяФВ + "Кт", ИмяФВ);
	ПоляКт.Вставить(ИмяВО + "Кт", ИмяВО);
	ПоляКт.Вставить(ИмяВД + "Кт", ИмяВД + "Кт");
	
	ПроверкаДт = Новый Структура("ФВ, ВО, ВД",
		ИмяФВ + "Дт", ИмяВО + "Дт", ИмяВД + "Дт");
	ПроверкаКт = Новый Структура("ФВ, ВО, ВД",
		ИмяФВ + "Кт", ИмяВО + "Кт", ИмяВД + "Кт");
	
	Возврат Новый Структура(
		"Дт, Кт, ПроверкаДт, ПроверкаКт",
		ПоляДт, ПоляКт, ПроверкаДт, ПроверкаКт);
	
КонецФункции

Процедура ЗагрузитьБезКорр(ТабПриемник, ТабИсточник, КэшируемыеЗначения,
		ИмяДтКт = "СторонаПроводки", УдалитьКорСчет = Истина) Экспорт
	
	ИменаКолонок = ОбщегоНазначения.ВыгрузитьКолонку(ТабИсточник.Колонки, "Имя");
	
	//Дт
	ИсточникДт = КолонкиПоСуффиксу(ИменаКолонок, "Дт");
	ПриемникДт = СтрРазделить(ИменаБезСуффикса(ИсточникДт, "Дт"), ",");
	
	ПереименоватьКолонки(ТабИсточник, ИсточникДт, ПриемникДт);
	
	ТабИсточник.Колонки.Добавить(ИмяДтКт, Новый ОписаниеТипов("Булево"));
	ТабИсточник.ЗаполнитьЗначения(Истина, ИмяДтКт);
	
	Если ТипЗнч(ТабПриемник) = Тип("ТаблицаЗначений") Тогда
		ТабПриемник.Очистить();
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТабИсточник, ТабПриемник);
	Иначе
		ТабПриемник.Загрузить(ТабИсточник);
	КонецЕсли;
	
	ПереименоватьКолонки(ТабИсточник, ПриемникДт, ИсточникДт);//не конфликтуем с именами Кт
	
	//Кт
	ИсточникКт = КолонкиПоСуффиксу(ИменаКолонок, "Кт");
	ПриемникКт = СтрРазделить(ИменаБезСуффикса(ИсточникКт, "Кт"), ",");
	ПереименоватьКолонки(ТабИсточник, ИсточникКт, ПриемникКт);
	
	ТабИсточник.ЗаполнитьЗначения(Ложь, ИмяДтКт);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТабИсточник, ТабПриемник);
	
	Если Не УдалитьКорСчет Тогда
		Возврат;
	КонецЕсли;
	
	КорСчет = ФиксированныйСчет(КэшируемыеЗначения);
	КэшируемыеЗначения.Вставить("КорСчет", КорСчет);
	
	Отбор = Новый Структура("Счет", КорСчет.СчетСсылка);
	СтрокиУдаления = ТабПриемник.НайтиСтроки(Отбор);
	Для каждого СтрокаУдаления Из СтрокиУдаления Цикл
		ТабПриемник.Удалить(СтрокаУдаления);
	КонецЦикла;

КонецПроцедуры

Процедура ПреобразоватьТаблицуКорреспонденций(ДанныеИсточника, ТаблицаТЧ, ИмяДтКт = "СторонаПроводки") Экспорт
	
	Таб = ДанныеИсточника.ТаблицаДанных;
	
	Если Таб.Колонки.Найти(ИмяДтКт) = Неопределено Тогда
		Возврат;//Есть Дт,Кт
	КонецЕсли;
	
	КорСчет = ФиксированныйСчет(ДанныеИсточника.КэшируемыеЗначения);
	
	Если ТипЗнч(ТаблицаТЧ) = Тип("ТаблицаЗначений") Тогда
		ТабПриемник = ТаблицаТЧ.СкопироватьКолонки();
	Иначе 
		ТабПриемник = ТаблицаТЧ.ВыгрузитьКолонки();
	КонецЕсли;
	
	ТабПриемник.Колонки.Удалить("Активность");
	ТабПриемник.Колонки.Удалить("Сценарий");
	ТабПриемник.Колонки.Удалить("Организация");
	ТабПриемник.Колонки.Удалить("Период");
	ТабПриемник.Колонки.Удалить("СчетДтИсточник");
	ТабПриемник.Колонки.Удалить("СчетКтИсточник");
	
	ИменаКолонок = ОбщегоНазначения.ВыгрузитьКолонку(ТабПриемник.Колонки, "Имя");
	ИменаКолонок = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ИменаКолонок, КолонкиПоСуффиксу(ИменаКолонок, "ВидСубконто"));
	
	Таб.Колонки.Добавить("КорСчет");
	Таб.ЗаполнитьЗначения(КорСчет.СчетСсылка, "КорСчет");
	Таб.Индексы.Добавить(ИмяДтКт);
	
	//Дт
	ПриемникДт = КолонкиПоСуффиксу(ИменаКолонок, "Дт");
	ИсточникДт = СтрРазделить(ИменаБезСуффикса(ПриемникДт, "Дт"), ",");
	
	Отбор = Новый Структура(ИмяДтКт, Истина);
	ТабИсточник = Таб.Скопировать(Отбор);
	ПереименоватьКолонки(ТабИсточник, ИсточникДт, ПриемникДт);
	ТабИсточник.Колонки.КорСчет.Имя = "СчетКт";
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТабИсточник, ТабПриемник);
	
	//Кт
	ПриемникКт = КолонкиПоСуффиксу(ИменаКолонок, "Кт");
	ИсточникКт = СтрРазделить(ИменаБезСуффикса(ПриемникКт, "Кт"), ",");
	
	Отбор = Новый Структура(ИмяДтКт, Ложь);
	ТабИсточник = Таб.Скопировать(Отбор);
	ПереименоватьКолонки(ТабИсточник, ИсточникКт, ПриемникКт);
	ТабИсточник.Колонки.КорСчет.Имя = "СчетДт";
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТабИсточник, ТабПриемник);
	
	ДанныеИсточника.Вставить("ТабБезКорр", Таб);
	ДанныеИсточника.Вставить("ТаблицаДанных", ТабПриемник);
	
КонецПроцедуры

