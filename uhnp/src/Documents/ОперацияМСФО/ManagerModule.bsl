Процедура ПереименоватьКолонки(Таб, КолонкиИсточники, КолонкиПриемники)
	
	Для й = 0 По КолонкиИсточники.ВГраница() Цикл
		Таб.Колонки[КолонкиИсточники[й]].Имя = КолонкиПриемники[й];
	КонецЦикла;
	
КонецПроцедуры

Функция КолонкиПоСуффиксу(КолонкиИсточник, Суффикс = "Дт")
	
	Результат = Новый Массив;
	Для Каждого й Из КолонкиИсточник Цикл
		Если СтрНайти(й, Суффикс) > 0 Тогда
			Результат.Добавить(й);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИменаБезСуффикса(ИменаКолонок, Суффикс = "Дт")

	Возврат СтрЗаменить(СтрСоединить(ИменаКолонок, ","), Суффикс, "");

КонецФункции

Функция КорСчетСложныхПроводок(КэшируемыеЗначения, ТабСложныеПроводки)
	
	КорСчет = ФиксированныйСчет(КэшируемыеЗначения);
	Результат = КорСчет.СчетИБ;
	
	КолонкаСчет = Неопределено;
	Если ТипЗнч(ТабСложныеПроводки) = Тип("ДанныеФормыКоллекция") Тогда
		КолонкаСчет = ТабСложныеПроводки.Выгрузить(,"Счет").Колонки.Счет;
	Иначе
		КолонкаСчет = ТабСложныеПроводки.Колонки.Счет;
	КонецЕсли;
	
	Если КолонкаСчет.ТипЗначения.СодержитТип(Тип("ПланСчетовСсылка.МСФО")) Тогда
		Результат = КорСчет.СчетСсылка;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ФиксированныйСчет(КэшируемыеЗначения) Экспорт

	ФиксСчет = ПредопределенноеЗначение(
		"Справочник.ФиксированныеСчетаУчетаБД.ВспомогательныйБалансовый");
	
	Возврат Справочники.ФиксированныеСчетаУчетаБД
		.АналитикаФиксированногоСчета(ФиксСчет, КэшируемыеЗначения.УчетнаяПолитика);

КонецФункции

#КонецОбласти

#КонецЕсли