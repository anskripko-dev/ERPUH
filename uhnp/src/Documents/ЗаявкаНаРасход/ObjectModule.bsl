		Возврат;
	КонецЕсли;
	ЗаявкиНаОперации.ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	ЗаявкиНаОперации.ПриЗаписи(ЭтотОбъект, Отказ);    
	
		
	ТаблицыДляДвижений = Документы.ЗаявкаНаРасход.ДанныеДокументаДляПроведения(Ссылка, "РеестрДокументов");
	РегистрыСведений.РеестрДокументов.ЗаписатьДанные(
			ТаблицыДляДвижений,
			Ссылка,
			Неопределено,
			Отказ);
			
КонецПроцедуры

