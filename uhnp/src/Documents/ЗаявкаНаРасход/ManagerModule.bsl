Процедура РеквизитыЗаявки(РеквизитыЗаявки) Экспорт
	
	ОМ = ЗаявкиНаОперации;
	
	РеквизитыЗаявки.ПриходРасход 										= ОМ.Новый_ЗначениеРеквизита("Перечисление.ВидыДвиженийПриходРасход.Расход");
	РеквизитыЗаявки.ПриходРасходСтатьяДвиженияДенежныхСредствЗачисление = ОМ.Новый_ЗначениеРеквизита("Перечисление.ВидыДвиженийПриходРасход.Приход");
	РеквизитыЗаявки.ПриходРасходСтатьяДвиженияДенежныхСредств 			= ОМ.Новый_ЗначениеРеквизита("Перечисление.ВидыДвиженийПриходРасход.Расход");
	РеквизитыЗаявки.ВидБюджетаПВХ 				= ОМ.Новый_ЗначениеРеквизита("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов");
	РеквизитыЗаявки.ВидБюджета 					= ОМ.Новый_ЗначениеРеквизита("Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов");
	РеквизитыЗаявки.БанковскийСчетКонтрагента 	= ОМ.Новый_Реквизит(Неопределено);
	РеквизитыЗаявки.ФормаОплаты 				= ОМ.Новый_Реквизит(Неопределено);
	РеквизитыЗаявки.ПланируемаяДатаОперации 	= ОМ.Новый_Реквизит("ЖелательнаяДатаРасхода");
	РеквизитыЗаявки.ОбъектРасчетов 				= ОМ.Новый_Реквизит("ОбъектРасчетов");
	РеквизитыЗаявки.ВалютаДокумента 			= ОМ.Новый_Реквизит("ВалютаВзаиморасчетов");
   	РеквизитыЗаявки.ЭтоОперацияПоГрафику		= ОМ.Новый_Реквизит(Неопределено);

	
	// Аналитики
	ОМ.Изменить_Реквизит(РеквизитыЗаявки.СтатьяБюджета, "СтатьяДоходовИРасходов", "ДвиженияОперации");
	Для Сч = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		ОМ.Изменить_Реквизит(РеквизитыЗаявки["Аналитика"			+Сч], "Аналитика"+Сч, "ДвиженияОперации");
	КонецЦикла;
	
	// Регистрируем параметры размещения аналитик статей бюджетов
	ЗаявкиНаОперации.РазместитьВКолонкахТаблицы(
		РеквизитыЗаявки, "ТаблицаДвижений", 
		РеквизитыЗаявки.СтатьяБюджета, "ТаблицаДвиженийСтатьяДоходовИРасходов",
		"Аналитика%1", "Аналитика%1",
		ФормыУХ.РазместитьВГруппе("ГруппаАналитика")
	);
	
КонецПроцедуры

#Область ИсточникиДляКонтроляДокумента
	
Функция ИсточникиДокумента(Объект, ПараметрыКонтроля = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект));
	
	// 2. Контроль суммы расходов по договору
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХРасходыПоДоговору,
		Источник_РасходыПоДоговору(Объект));
	
	Возврат Источники;
	
КонецФункции
	
Функция Источник_БюджетныеЛимитыРезервы(Объект)
	
	// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			Не ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект);
	КонтрольЛимитовУХ.УстановитьТипыДокументовДляЗапроса(Запрос);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА ВТ_ПланыДокумента.ДокументРезервирования = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВТ_ПланыДокумента.ДокументРезервирования
	|	КОНЕЦ КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	0 КАК Лимит,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_ПланыДокумента.ДокументРезервирования <> НЕОПРЕДЕЛЕНО
	|					И ВТ_ПланыДокумента.ДокументРезервирования <> ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|				ТОГДА -ВТ_ПланыДокумента.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Зарезервировано,
	|	СУММА(ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) В (&ТипыЗаявокНаОперации)
	|				ТОГДА ВТ_ПланыДокумента.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|ГДЕ
	|	ВТ_ПланыДокумента.Сумма > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПланыДокумента.Аналитика6,
	|	ВТ_ПланыДокумента.ДокументПланирования,
	|	ВТ_ПланыДокумента.ДокументРезервирования,
	|	ВТ_ПланыДокумента.Аналитика1,
	|	ВТ_ПланыДокумента.ВидБюджета,
	|	ВТ_ПланыДокумента.ЦФО,
	|	ВТ_ПланыДокумента.СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика3,
	|	ВТ_ПланыДокумента.Проект,
	|	ВТ_ПланыДокумента.Аналитика5,
	|	ВТ_ПланыДокумента.Организация,
	|	ВТ_ПланыДокумента.Период,
	|	ВТ_ПланыДокумента.Валюта,
	|	ВТ_ПланыДокумента.ПриходРасход,
	|	ВТ_ПланыДокумента.Аналитика2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.Выполнить();
	
	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;
	
КонецФункции

Функция Источник_РасходыПоДоговору(Объект)
	
	РеквизитыЗаявки = ЗаявкиНаОперации.РеквизитыДокументаЗаявка(ТипЗнч(Объект.Ссылка));
	
	Договор = ЗаявкиНаОперации.РеквизитЗаявки(Объект, РеквизитыЗаявки.ДоговорКонтрагента);
	Если Не ЗначениеЗаполнено(Объект.Контрагент) ИЛИ Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Неопределено; // Контроль не выполняется
	КонецЕсли;
	
	Результат 				= КонтрольУХРасходыПоДоговору.СтруктураИсточник(Объект.Ссылка, Объект.Организация, Ложь);
	Результат.Контрагент 	= Объект.Контрагент;
	Результат.Договор 		= Договор;
	Результат.Заявлено		= Объект.СуммаДокумента;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти 

#Область ПланыДокумента

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	1 КАК НомерЗапроса, // +по всем операциям
	|	&Дата КАК ДатаРегистрации,
	|	&Организация КАК Организация,
	|	ВЫБОР КОГДА &ЭтоРасчетыСКонтрагентом ТОГДА &Контрагент ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КОНЕЦ КАК Контрагент,
	|	ВЫБОР КОГДА &ЭтоРасчетыПоДоговору ТОГДА &ДоговорКонтрагента ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КОНЕЦ КАК ДоговорКонтрагента,
	|	ВЫБОР 
	|		КОГДА &ЭтоРасчетыПоДоговору = ЛОЖЬ ИЛИ &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПустаяСсылка) ТОГДА Неопределено
	|		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов) ТОГДА &ДоговорКонтрагента
	|		ИНАЧЕ ДвиженияОперации.ОбъектРасчетов
	|	КОНЕЦ КАК ОбъектРасчетов,
	|	&ВалютаВзаиморасчетов КАК Валюта,
	|	&Ссылка КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА &ИспользоватьГрафикРасчетов = ИСТИНА
	|			ТОГДА &ДоговорКонтрагента
	|		КОГДА &ДокументПланирования = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ &ДокументПланирования
	|	КОНЕЦ КАК ДокументРезервирования,
	|	&ЖелательнаяДатаРасхода КАК Период,
	|	&ЦФО КАК ЦФО,
	|	&Проект КАК Проект,
	|	ДвиженияОперации.СтатьяДоходовИРасходов КАК СтатьяБюджета,
	|	ДвиженияОперации.Аналитика1 КАК Аналитика1,
	|	ДвиженияОперации.Аналитика2 КАК Аналитика2,
	|	ДвиженияОперации.Аналитика3 КАК Аналитика3,
	|	ДвиженияОперации.Аналитика4 КАК Аналитика4,
	|	ДвиженияОперации.Аналитика5 КАК Аналитика5,
	|	ДвиженияОперации.Аналитика6 КАК Аналитика6,
	|	ДвиженияОперации.Сумма КАК Сумма,
	|	&НаправлениеДвижения КАК ПриходРасход,
	|	&ВидБюджета КАК ВидБюджета
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	Документ.ЗаявкаНаРасход.ДвиженияОперации КАК ДвиженияОперации
	|ГДЕ
	|	ДвиженияОперации.Ссылка = &Ссылка
	|	И ДвиженияОперации.Сумма > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	1.1, // -по всем операциям, с указанным документом резервирования
	|	&Дата КАК ДатаРегистрации,
	|	&Организация КАК Организация,
	|	ВЫБОР КОГДА &ЭтоРасчетыСКонтрагентом ТОГДА &Контрагент ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КОНЕЦ КАК Контрагент,
	|	ВЫБОР КОГДА &ЭтоРасчетыПоДоговору ТОГДА &ДоговорКонтрагента ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КОНЕЦ КАК ДоговорКонтрагента,
	|	НЕОПРЕДЕЛЕНО КАК ОбъектРасчетов,
	|	&ВалютаВзаиморасчетов КАК Валюта,
	|	&ДокументПланирования КАК ДокументПланирования,
	|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
	|	&ЖелательнаяДатаРасхода КАК Период,
	|	&ЦФО КАК ЦФО,
	|	&Проект КАК Проект,
	|	ДвиженияОперации.СтатьяДоходовИРасходов КАК СтатьяБюджета,
	|	ДвиженияОперации.Аналитика1 КАК Аналитика1,
	|	ДвиженияОперации.Аналитика2 КАК Аналитика2,
	|	ДвиженияОперации.Аналитика3 КАК Аналитика3,
	|	ДвиженияОперации.Аналитика4 КАК Аналитика4,
	|	ДвиженияОперации.Аналитика5 КАК Аналитика5,
	|	ДвиженияОперации.Аналитика6 КАК Аналитика6,
	|	-ДвиженияОперации.Сумма КАК Сумма,
	|	&НаправлениеДвижения КАК ПриходРасход,
	|	&ВидБюджета КАК ВидБюджета
	|ИЗ
	|	Документ.ЗаявкаНаРасход.ДвиженияОперации КАК ДвиженияОперации
	|ГДЕ
	|	ДвиженияОперации.Ссылка = &Ссылка
	|	И ДвиженияОперации.Сумма > 0
	|	И &ДокументПланирования <> ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|	И &ДокументПланирования <> НЕОПРЕДЕЛЕНО
	|	И &ИспользоватьГрафикРасчетов = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	4 КАК НомерЗапроса, //  -по графику расчетов
	|	&Дата КАК ДатаРегистрации,
	|	&Организация КАК Организация,
	|	ВЫБОР КОГДА &ЭтоРасчетыСКонтрагентом ТОГДА &Контрагент ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КОНЕЦ КАК Контрагент,
	|	ВЫБОР КОГДА &ЭтоРасчетыПоДоговору ТОГДА &ДоговорКонтрагента ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КОНЕЦ КАК ДоговорКонтрагента,
	|	ВЫБОР 
	|		КОГДА &ЭтоРасчетыПоДоговору = ЛОЖЬ ИЛИ &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПустаяСсылка) ТОГДА неопределено
	|		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов) ТОГДА &ДоговорКонтрагента
	|		ИНАЧЕ ДвиженияОперации.ОбъектРасчетов
	|	КОНЕЦ КАК ОбъектРасчетов,
	|	&ВалютаВзаиморасчетов КАК Валюта,
	|	&ДоговорКонтрагента КАК ДокументПланирования,
	|	&ДоговорКонтрагента КАК ДокументРезервирования,
	|	&ЖелательнаяДатаРасхода КАК Период,
	|	&ЦФО КАК ЦФО,
	|	&Проект КАК Проект,
	|	ДвиженияОперации.СтатьяДоходовИРасходов КАК СтатьяБюджета,
	|	ДвиженияОперации.Аналитика1 КАК Аналитика1,
	|	ДвиженияОперации.Аналитика2 КАК Аналитика2,
	|	ДвиженияОперации.Аналитика3 КАК Аналитика3,
	|	ДвиженияОперации.Аналитика4 КАК Аналитика4,
	|	ДвиженияОперации.Аналитика5 КАК Аналитика5,
	|	ДвиженияОперации.Аналитика6 КАК Аналитика6,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОперацииБюджетовОбороты.ЛимитОборот, 0) <= 0
	|			ТОГДА 0
	|		КОГДА ЕСТЬNULL(ОперацииБюджетовОбороты.ЛимитОборот, 0) < ДвиженияОперации.Сумма
	|			ТОГДА -ЕСТЬNULL(ОперацииБюджетовОбороты.ЛимитОборот, 0)
	|		ИНАЧЕ -ДвиженияОперации.Сумма
	|	КОНЕЦ,
	|	&НаправлениеДвижения КАК ПриходРасход,
	|	&ВидБюджета КАК ВидБюджета
	|ИЗ
	|	Документ.ЗаявкаНаРасход.ДвиженияОперации КАК ДвиженияОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОперацииБюджетов.Обороты(, , Авто, ) КАК ОперацииБюджетовОбороты
	|		ПО ДвиженияОперации.СтатьяДоходовИРасходов = ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.СтатьяБюджета
	|			И ДвиженияОперации.Аналитика1 = ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика1
	|			И ДвиженияОперации.Аналитика2 = ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика2
	|			И ДвиженияОперации.Аналитика3 = ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика3
	|			И ДвиженияОперации.Аналитика4 = ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика4
	|			И ДвиженияОперации.Аналитика5 = ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика5
	|			И ДвиженияОперации.Аналитика6 = ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика6
	|			И (&ДоговорКонтрагента = ОперацииБюджетовОбороты.ОбъектПланирования.Объект)
	|ГДЕ
	|	ДвиженияОперации.Ссылка = &Ссылка
	|	И ДвиженияОперации.Сумма > 0
	|	И &ЭтоРасчетыПоДоговору    
	|	И &ИспользоватьГрафикРасчетов = ИСТИНА
	|	И &ДокументПланирования = ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|	И ОперацииБюджетовОбороты.Регистратор <> &Ссылка
	|";  
		
	Запрос.УстановитьПараметр("ВидБюджета",				ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	Запрос.УстановитьПараметр("НаправлениеДвижения",	Перечисления.ВидыДвиженийПриходРасход.Расход);

	ИменаРеквизитов = "ВидОперацииУХ, ЦФО, Проект, ДокументПланирования, Дата, ЖелательнаяДатаРасхода, ВалютаВзаиморасчетов, Организация, Контрагент, ДоговорКонтрагента, Ссылка";
	
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, ИменаРеквизитов);
	Иначе                                        
		РеквизитыДокумента = Источник;

		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		Реквизиты = "Сумма, ОбъектРасчетов, СтатьяДоходовИРасходов," 
						+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
		ДвиженияОперации = Источник.ДвиженияОперации.Выгрузить(,Реквизиты);
		ДвиженияОперации.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		ДвиженияОперации.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("ДвиженияОперации", ДвиженияОперации);
		Запрос.Текст =
		"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ДвиженияОперации ИЗ &ДвиженияОперации КАК Коллекция ";
		Запрос.Выполнить();
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ЗаявкаНаРасход.", "ВТ_");
		
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;

	// параметры из ВидОперацииУХ
	ЭтоРасчетыСКонтрагентом = ВидыОперацийУХВызовСервераПовтИсп.ЭтоРасчетыСКонтрагентом(РеквизитыДокумента.ВидОперацииУХ);
	ЭтоРасчетыПоДоговору = ЭтоРасчетыСКонтрагентом И НЕ ВидыОперацийУХВызовСервераПовтИсп.ЭтоРасчетыБезДоговора(РеквизитыДокумента.ВидОперацииУХ);
	
	Запрос.УстановитьПараметр("ЭтоРасчетыСКонтрагентом",	ЭтоРасчетыСКонтрагентом);
	Запрос.УстановитьПараметр("ЭтоРасчетыПоДоговору", 		ЭтоРасчетыПоДоговору);

	// Реквизиты договора
	ИменаРеквизитовДоговора = "ИспользоватьГрафикРасчетов, ПорядокРасчетов, ГрафикДоговора";
	РеквизитыДоговора = Новый Структура(ИменаРеквизитовДоговора);
	РеквизитыДоговора.ПорядокРасчетов 	= Перечисления.ПорядокРасчетов.ПустаяСсылка();
	РеквизитыДоговора.ГрафикДоговора 	= Перечисления.ГрафикиДоговора.ПустаяСсылка(); 
	РеквизитыДоговора.ИспользоватьГрафикРасчетов = Ложь;
	
	Если ЭтоРасчетыПоДоговору И ТипЗнч(РеквизитыДокумента.ДоговорКонтрагента) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
		РеквизитыДоговора.ИспользоватьГрафикРасчетов = Истина;
	ИначеЕсли ЭтоРасчетыПоДоговору 	И РеквизитыДокумента.ДоговорКонтрагента <> Неопределено Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ДоговорКонтрагента, ИменаРеквизитовДоговора);
	КонецЕсли;
	
	Для Каждого КлючЗначение Из РеквизитыДоговора Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции

