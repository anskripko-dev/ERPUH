#Область ПодготовкаПараметровПроведенияДокумента

Функция ПодготовитьПараметрыПроведения(ДополнительныеСвойства, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	ИменаПолей = "ПериодОтчета, ДатаНачала, ДатаОкончания, ВидОтчета";
	Реквизиты = МСФОУХ.РеквизитыДокумента(Запрос, ИменаПолей, "ПериодОтчета", Отказ);
	
	Реквизиты.Вставить("ЕстьСуммаВВалютеОтчетности", 	Истина);
	Реквизиты.Вставить("ВидОперацииИзПроводок", 		Истина);
	Реквизиты.Вставить("ВидОперации", 					ПредопределенноеЗначение("Справочник.ВидыОпераций._02ПереоценкаВалютныхАктивовИОбязательств"));
	Реквизиты.Вставить("ИзменениеФВ",	Реквизиты.ФункциональнаяВалюта <> Реквизиты.ВалютаИсточник);
	Реквизиты.Вставить("ИВизВО",		Реквизиты.ВалютаПредставления = Реквизиты.ВалютаИсточник);
	
	ДополнительныеСвойства.ДляПроведения.Вставить("Реквизиты", Реквизиты);
	ОчиститьДвиженияМСФО(ДополнительныеСвойства, Отказ);//удалены движения МСФО 
	
	Если Отказ Тогда
		Возврат ДополнительныеСвойства;
	КонецЕсли;
	
	УстановитьПараметрыЗапроса(Запрос, Реквизиты);
	
	НомераТаблиц = Новый Структура;
	Запрос.Текст = Отчеты.ИзменениеВалютныхКурсовМСФО.ТекстЗапроса_Документ(Реквизиты, НомераТаблиц);
	
	ПроведениеСерверУХ.ДополнитьТаблицамиИзПакетаЗапросов(
		ДополнительныеСвойства.ТаблицыДляДвижений, Запрос, НомераТаблиц);
	
КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос, Реквизиты)
	
	Дата = КонецДня(Реквизиты.ДатаОкончания);
	ГраницаПериода = Новый Граница(Дата, ВидГраницы.Включая);
	
	Запрос.УстановитьПараметр("Ссылка", 				Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("Организация",			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Сценарий", 				Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("Период", 				Реквизиты.Дата);
	Запрос.УстановитьПараметр("ПериодОтчета",			Реквизиты.ПериодОтчета);
	
	Запрос.УстановитьПараметр("КонецПериода", 			ГраницаПериода);
	Запрос.УстановитьПараметр("НачалоПериода",			Реквизиты.ДатаНачала);
	Запрос.УстановитьПараметр("ВидОтчетаАОСВ", 			Справочники.ВидыОтчетов.ПолучитьВидОтчетаОСВ(Реквизиты.ПланСчетовМСФО));
	Запрос.УстановитьПараметр("ФункциональнаяВалюта",	Реквизиты.ФункциональнаяВалюта);
	Запрос.УстановитьПараметр("ВалютаПредставления",	Реквизиты.ВалютаПредставления);
	Запрос.УстановитьПараметр("ВалютаИсточник",			Реквизиты.ВалютаИсточник);
	Запрос.УстановитьПараметр("УчетнаяПолитика",		Реквизиты.УчетнаяПолитика);
	Запрос.УстановитьПараметр("ИзменениеФВ",			Реквизиты.ИзменениеФВ);
	Запрос.УстановитьПараметр("ВОизИВ",					Реквизиты.ИВизВО);

КонецПроцедуры

Процедура ОчиститьДвиженияМСФО(ДополнительныеСвойства, Отказ)
	
	Если Не ДополнительныеСвойства.ДляПроведения.Реквизиты.ФормироватьПроводкиМСФО Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.ЭтоНовый Тогда
		Возврат;
	КонецЕсли;
	
	нз = РегистрыБухгалтерии.МСФО.СоздатьНаборЗаписей();
	нз.Отбор.Регистратор.Установить(ДополнительныеСвойства.ДляПроведения.Ссылка);
	нз.Записать();

КонецПроцедуры

#КонецОбласти

#КонецЕсли