#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов    
	ОбщегоНазначенияУХ.УстановитьСостояниеДокумента(ЭтотОбъект);
	
	УправлениеФормой();
КонецПроцедуры  

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ДоговорыКонтрагентов"
		И ОжиданиеНовогоДоговора Тогда 
		Объект.ДоговорСЦессионарием = Источник; 
		Модифицированность			= Истина;
		ОжиданиеНовогоДоговора		= Ложь;
		УправлениеФормой();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
    Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
         МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
         МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
    КонецЕсли;
    // Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы 

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.Комментарий");
КонецПроцедуры

&НаКлиенте
Процедура ДоговорСЦедентомПриИзменении(Элемент)
	РассчитатьСуммуДокументаНаКлиенте()	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорСЦессионариемПриИзменении(Элемент)
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)

	Если НЕ Объект.ТекущаяЗадолженность.Количество() Тогда
		СтрокаТекущаяЗадолженность 			= Объект.ТекущаяЗадолженность.Добавить();
		СтрокаТекущаяЗадолженность.Сумма 	= Объект.СуммаДокумента;
		СтрокаТекущаяЗадолженность.ЭлементСтруктурыЗадолженности = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг");		
	ИначеЕсли  НЕ Элементы.ТекущаяЗадолженность.Видимость	Тогда
		Объект.ТекущаяЗадолженность[0].Сумма = Объект.СуммаДокумента;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбязательстваПриИзменении(Элемент)
	
	Объект.ДоговорСЦессионарием = Неопределено;
	Объект.ДоговорСЦедентом		= Неопределено;
	УправлениеФормой();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТекущаяЗадолженность
&НаКлиенте
Процедура ТекущаяЗадолженностьЭлементСтруктурыЗадолженностиПриИзменении(Элемент)
	СтрокаТекущаяЗадолженность = Элементы.ТекущаяЗадолженность.ТекущиеДанные;
	Если СтрокаТекущаяЗадолженность.Сумма = 0 Тогда 
		СтрокаТекущаяЗадолженность.Сумма = Объект.СуммаДокумента;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяЗадолженностьСуммаПриИзменении(Элемент)
	
	Объект.СуммаДокумента = Объект.ТекущаяЗадолженность.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьДоговор(Команда)
	
	ОжиданиеНовогоДоговора = Истина;
	
	ПараметрыОснования = Новый Структура;
	ПараметрыОснования.Вставить("Владелец",				Объект.Цессионарий);
	ПараметрыОснования.Вставить("ВалютаВзаиморасчетов", Объект.ВалютаДокумента); 
	ПараметрыОснования.Вставить("Организация",			Объект.Организация);
	
	ПараметрыФормы  	= Новый Структура("ЗначенияЗаполнения",  ПараметрыОснования); 
	
	Если Объект.ВидОбязательства = ПредопределенноеЗначение("Перечисление.ВидыОбязательств.ЗадолженностьПоДоговоруКуплиПродажи") Тогда
		ВидДоговоровКонтрагентовУХ = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Справочник.ВидыДоговоровКонтрагентовУХ.СПоставщиком"); 
	Иначе	
		ВидДоговоровКонтрагентовУХ = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Справочник.ВидыДоговоровКонтрагентовУХ.ЗаемПолученный"); 
	КонецЕсли;	
	ПараметрыФормы.Вставить("Отбор", 		Новый Структура("ВидДоговораУХ", ВидДоговоровКонтрагентовУХ)); 
	ПараметрыФормы.Вставить("Основание", 	Объект.ДоговорСЦедентом);
	
	Если Объект.ВидОбязательства = ПредопределенноеЗначение("Перечисление.ВидыОбязательств.ЗадолженностьПоДоговоруКуплиПродажи") Тогда
		ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("Справочник.ДоговорыКредитовИДепозитов.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры 
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()
	
	ЭтоДолгПоставки 				= Объект.ВидОбязательства = ПредопределенноеЗначение("Перечисление.ВидыОбязательств.ЗадолженностьПоДоговоруКуплиПродажи");
	ДоговорПоЗаказамНакладным		= Ложь;
	Если ЭтоДолгПоставки
		 И ЗначениеЗаполнено(Объект.ДоговорСЦессионарием) Тогда 
		РеквизитыДоговораДолжника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДоговорСЦессионарием, "ПорядокРасчетов, ВидДоговораУХ");
		
		ДоговорПоЗаказамНакладным 		= (РеквизитыДоговораДолжника.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоЗаказамНакладным")
		ИЛИ РеквизитыДоговораДолжника.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоНакладным") );
		
		Если РеквизитыДоговораДолжника.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоЗаказамНакладным") Тогда
			Элементы.ТекущаяЗадолженностьОбъектРасчетов.ОграничениеТипа             = Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента");  
		Иначе	
			Элементы.ТекущаяЗадолженностьОбъектРасчетов.ОграничениеТипа             = Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг");  
		КонецЕсли; 
		
	КонецЕсли; 
	Элементы.ТекущаяЗадолженностьОбъектРасчетов.Видимость = ЭтоДолгПоставки И ДоговорПоЗаказамНакладным;
	Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.Видимость 	= НЕ ЭтоДолгПоставки; 
	Элементы.ТекущаяЗадолженность.Видимость									= НЕ ЭтоДолгПоставки 
																					ИЛИ ДоговорПоЗаказамНакладным;

	ТипОграничения 		= Новый Массив; 
	МассивПараметров 	= Новый Массив(); 
	
	Если НЕ ЭтоДолгПоставки Тогда
   		НовыйПараметр 	= Новый ПараметрВыбора("Отбор.ВидДоговораУХ", Справочники.ВидыДоговоровКонтрагентовУХ.ЗаемПолученный);
		МассивПараметров.Добавить(НовыйПараметр);				
       	МассивПараметров.Добавить(НовыйПараметр);
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Статус", Перечисления.СтатусыДоговоровКонтрагентов.Действует));
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления",Ложь));
		
		ТипОграничения.Добавить(Тип("СправочникСсылка.ДоговорыКредитовИДепозитов"));
	Иначе
		НовыйПараметр 	= Новый ПараметрВыбора("Отбор.ВидДоговораУХ", Справочники.ВидыДоговоровКонтрагентовУХ.СПоставщиком);
		МассивПараметров.Добавить(НовыйПараметр);				
	    МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления",Ложь));
		
		ТипОграничения.Добавить(Тип("СправочникСсылка.ДоговорыКонтрагентов"));	
	КонецЕсли;
	
	НовыеПараметры 	= Новый ФиксированныйМассив(МассивПараметров);
	Элементы.ДоговорСЦедентом.ПараметрыВыбора 		= НовыеПараметры;      
	Элементы.ДоговорСЦессионарием.ПараметрыВыбора 	= НовыеПараметры;	
	Элементы.ДоговорСЦедентом.ОграничениеТипа 		= Новый ОписаниеТипов(ТипОграничения);	   
	Элементы.ДоговорСЦессионарием.ОграничениеТипа 	= Новый ОписаниеТипов(ТипОграничения);	   
 
КонецПроцедуры 

&НаСервереБезКонтекста
Функция СуммыОбязательств(Организация, Контрагент, ДоговорКонтрагента)
	Возврат ЦессииУХ.МассивКредиторскойЗадолженности(Организация, Контрагент, ДоговорКонтрагента);	
КонецФункции // ()

&НаКлиенте
Процедура РассчитатьСуммуДокументаНаКлиенте()
   	МассивОбязательств = СуммыОбязательств(Объект.Организация, Объект.Цедент, Объект.ДоговорСЦедентом);
	Объект.ТекущаяЗадолженность.Очистить(); 
	Для Каждого МассивЭлемент Из МассивОбязательств Цикл
	
		ЗаполнитьЗначенияСвойств(Объект.ТекущаяЗадолженность.Добавить(), МассивЭлемент);
	
	КонецЦикла;
	Объект.СуммаДокумента = Объект.ТекущаяЗадолженность.Итог("Сумма");

КонецПроцедуры

#КонецОбласти
