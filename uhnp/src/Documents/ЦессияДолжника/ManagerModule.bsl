#Область СлужебныеПроцедурыИФункции
Функция ТекстЗапросаРеквизитыДокумента(НомераТаблиц = Неопределено)

	Если НомераТаблиц <> Неопределено Тогда
		НомераТаблиц.Вставить("Реквизиты", НомераТаблиц.Количество());	
	КонецЕсли;	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Дата КАК Период,
	|	Реквизиты.МоментВремени КАК МоментВремени,
	|	Реквизиты.Организация КАК Организация,
	|	Реквизиты.Цедент КАК Цедент,
	|	Реквизиты.ДоговорСЦедентом КАК ДоговорСЦедентом,
	|	Реквизиты.Цессионарий КАК Цессионарий,
	|	Реквизиты.ДоговорСЦессионарием КАК ДоговорСЦессионарием,
	|	Реквизиты.СуммаДокумента КАК СуммаДокумента,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	Реквизиты.ДоговорСЦедентом.ВидДоговораУХ КАК ДоговорСЦедентомВидДоговораУХ,
	|	Реквизиты.ДоговорСЦессионарием.ВидДоговораУХ КАК ДоговорСЦессионариемВидДоговораУХ
	|ИЗ
	|	Документ.ЦессияДолжника КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаРасчетыСКонтрагентамиФакт(НомераТаблиц, ИмяТаблицы)
	
	НомераТаблиц.Вставить(ИмяТаблицы, НомераТаблиц.Количество());
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Организация КАК Организация,
	|	&Цессионарий КАК Контрагент,
	|	&ВалютаДокумента КАК Валюта,
	|	&ДоговорСЦессионарием КАК ОбъектРасчетов,
	|	&ДоговорСЦессионарием КАК ДоговорКонтрагента,
	|	ЦессияИсходящаяТекущаяЗадолженность.Сумма КАК Сумма,
	|	NULL КАК Операция,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ЦессияИсходящаяТекущаяЗадолженность.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности,
	|	NULL КАК СтатьяБюджета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов) КАК ВидБюджета,
	|	&ДоговорСЦессионариемВидДоговораУХ КАК ВидДоговораУХ
	|ИЗ
	|	Документ.ЦессияДолжника.ТекущаяЗадолженность КАК ЦессияИсходящаяТекущаяЗадолженность
	|ГДЕ
	|	ЦессияИсходящаяТекущаяЗадолженность.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	&Организация,
	|	&Цедент,
	|	&ВалютаДокумента,
	|	&ДоговорСЦедентом,
	|	&ДоговорСЦедентом,
	|	&СуммаДокумента,
	|	NULL,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг),
	|	NULL,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход),
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов),
	|	&ДоговорСЦедентомВидДоговораУХ";
	
	Возврат ТекстЗапроса;


КонецФункции

Функция ТекстЗапросаВерсииРасчетов(НомераТаблиц, ИмяТаблицы)

	НомераТаблиц.Вставить(ИмяТаблицы, НомераТаблиц.Количество());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&ДоговорСЦедентом КАК ПредметГрафика,
	|	&Ссылка КАК ВерсияГрафика,
	|	&Организация КАК Организация,
	|	ИСТИНА КАК ОпорныйГрафик";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаРасчетыСКонтрагентамиГрафики(НомераТаблиц, ИмяТаблицы)

	НомераТаблиц.Вставить("ТаблицаГрафика", 	НомераТаблиц.Количество());
	НомераТаблиц.Вставить(ИмяТаблицы, 			НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВерсииГрафиковРасчетовСрезПоследних.Регистратор КАК ВерсияГрафика
	|ПОМЕСТИТЬ ТаблицаГрафика
	|ИЗ
	|	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(
	|			&ПериодГраница,
	|			Организация = &Организация
	|				И ПредметГрафика = &ДоговорСЦедентом) КАК ВерсииГрафиковРасчетовСрезПоследних
	|;
	|
	|ВЫБРАТЬ
	|	&Период КАК Период,
	|	ИСТИНА КАК Активность,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	&Ссылка КАК ВерсияГрафика,
	|	&Организация КАК Организация,
	|	&Цедент КАК Контрагент, 
	|	&ДоговорСЦедентом КАК ПредметГрафика,
	|	&ДоговорСЦедентомВидДоговораУХ КАК ВидДоговораУХ,
	|	РасчетыСКонтрагентамиГрафикиОстатки.ЭлементСтруктурыЗадолженности,
	|	&ВалютаДокумента КАК Валюта,
	|	&ВалютаДокумента КАК ВалютаПлатежа,
	|	РасчетыСКонтрагентамиГрафикиОстатки.СуммаОстаток*-1 КАК Сумма,
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ПриходРасход,
	|	ВЫБОР
	|		КОГДА РасчетыСКонтрагентамиГрафикиОстатки.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваОсновнойДолг)
	|		КОГДА РасчетыСКонтрагентамиГрафикиОстатки.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Комиссии)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваКомиссии)
	|		КОГДА РасчетыСКонтрагентамиГрафикиОстатки.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Проценты)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваПроценты)
	|		КОГДА РасчетыСКонтрагентамиГрафикиОстатки.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Штрафы)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваШтрафы)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ  КАК Операция
	|ИЗ
	|	РегистрНакопления.РасчетыСКонтрагентамиГрафики.Остатки(
	|			&ПериодГраница,
	|			ВерсияГрафика В
	|				(ВЫБРАТЬ
	|					ТаблицаГрафика.ВерсияГрафика
	|				ИЗ
	|					ТаблицаГрафика)) КАК РасчетыСКонтрагентамиГрафикиОстатки";
	
		
	Возврат ТекстЗапроса;
 КонецФункции
  
#КонецОбласти   


#КонецЕсли