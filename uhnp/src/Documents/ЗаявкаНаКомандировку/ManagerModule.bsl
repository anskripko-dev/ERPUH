#Область КонтрольЛимитовПоДаннымБюджетирования

// Возвращает текст запроса для формирования временной таблицы с источниками данных правил получения фактических данных по статьям бюджетов.
// Источники данных зависят от хозяйственной операции документа.
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаИсточникиДанныхПравилПолученияФакта() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НастройкиХозяйственныхОпераций.Ссылка КАК ИсточникДанных,
	|	НастройкиХозяйственныхОпераций.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	НастройкиХозяйственныхОпераций.Приход КАК Приход,
	|	НастройкиХозяйственныхОпераций.Расход КАК Расход
	|ПОМЕСТИТЬ ИсточникиДанныхПравилПолученияФакта
	|ИЗ
	|	Справочник.НастройкиХозяйственныхОпераций КАК НастройкиХозяйственныхОпераций
	|ГДЕ
	|	НастройкиХозяйственныхОпераций.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает текст запроса в качестве источника фактических данных по документу.
// Источник фактических данных зависит от типов данных учета хозяйственной операции правила получения фактических данных по статьям бюджетов.
//
// Параметры:
//  Расход - ПеречислениеСсылка.ТипыДанныхУчета - расход по хозяйственной операции
//  Приход - ПеречислениеСсылка.ТипыДанныхУчета - приход по хозяйственной операции
//  ИмяВременнойТаблицы - Строка - имя временной таблицы (если не задано, то временная таблица не формируется)
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаИсточникФактаПоТипамДанныхУчета(Расход, Приход, ИмяВременнойТаблицы = "") Экспорт
	
	ТекстЗапроса = "";
	
	Если Расход <> Перечисления.ТипыДанныхУчета.ДенежныеСредства Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	Если Приход = Перечисления.ТипыДанныхУчета.ДенежныеСредства Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТаблицаДанных.ЖелательнаяДатаПлатежа КАК Период,
		|	ТаблицаДанных.Ссылка КАК Регистратор,
		|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику) КАК ИсточникДанных,
		|	ТаблицаДанных.Организация КАК Организация,
		|	ТаблицаДанных.Подразделение КАК Подразделение,
		|	НЕОПРЕДЕЛЕНО КАК НаправлениеДеятельности,
		|	ВЫБОР ТаблицаДанных.ФормаОплатыЗаявки
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
		|			ТОГДА ТаблицаДанных.Касса
		|		ИНАЧЕ ТаблицаДанных.БанковскийСчет
		|	КОНЕЦ КАК ДенежныеСредства,
		|	ВЫБОР ТаблицаДанных.ФормаОплатыЗаявки
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ТипДенежныхСредств,
		|	ТаблицаДанных.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		//++ Локализация
		|	НЕОПРЕДЕЛЕНО КАК СтатьяЦелевыхСредств,
		//-- Локализация
		|	ТаблицаДанных.Валюта КАК Валюта,
		|	НЕОПРЕДЕЛЕНО КАК КорНаправлениеДеятельности,
		|	ТаблицаВыдачаПодОтчет.Сотрудник КАК КорДенежныеСредства,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ДенежныеСредстваУПодотчетногоЛица) КАК КорТипДенежныхСредств,
		|	ТаблицаДанных.Валюта КАК КорВалюта,
		|	ВЫБОР
		|		КОГДА НЕ ТаблицаДанных.СверхЛимита
		|			ТОГДА ТаблицаВыдачаПодОтчет.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКВыплатеВРамкахЛимита,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.СверхЛимита
		|			ТОГДА ТаблицаВыдачаПодОтчет.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКВыплатеСверхЛимита,
		|	ТаблицаВыдачаПодОтчет.Сумма КАК СуммаКВыплате
		|ПОМЕСТИТЬ ИмяВременнойТаблицы
		|ИЗ
		|	Документ.ЗаявкаНаКомандировку КАК ТаблицаДанных
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаКомандировку.ВыдачаПодОтчет КАК ТаблицаВыдачаПодОтчет
		|		ПО ТаблицаДанных.Ссылка = ТаблицаВыдачаПодОтчет.Ссылка
		|ГДЕ
		|	НЕ ТаблицаДанных.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокСотрудников.Отклонена), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокСотрудников.Отозвана))
		|	И ТаблицаДанных.Ссылка = &Документ
		|	И ТаблицаДанных.ЖелательнаяДатаПлатежа МЕЖДУ &НачалоПериода И &КонецПериода";
	
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяВременнойТаблицы) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ИмяВременнойТаблицы", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДанных.Ссылка = &Документ", "ТаблицаДанных.Проведен");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

