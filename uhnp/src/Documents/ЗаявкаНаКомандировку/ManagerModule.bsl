Процедура РеквизитыЗаявки(РеквизитыЗаявки) Экспорт
	
	ОМ = ЗаявкиНаОперации;
	//
	РеквизитыЗаявки.Параметры.Вставить("ПланируемаяДатаОперацииВФорме", Истина);
	
	РеквизитыЗаявки.ВидБюджетаПВХ	= ОМ.Новый_ЗначениеРеквизита("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств");
	РеквизитыЗаявки.ВидБюджета 		= ОМ.Новый_ЗначениеРеквизита("Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств");
	
	РеквизитыЗаявки.БанковскийСчет 	= ОМ.Новый_Реквизит("БанковскийСчет");
	РеквизитыЗаявки.Контрагент	 	= ОМ.Новый_Реквизит("Сотрудник");

	РеквизитыЗаявки.Касса 			= ОМ.Новый_Реквизит("Касса");
	РеквизитыЗаявки.ФормаОплаты 	= ОМ.Новый_Реквизит("ФормаОплатыЗаявки");
	РеквизитыЗаявки.ВалютаДокумента = ОМ.Новый_Реквизит("Валюта");
	РеквизитыЗаявки.ВалютаКонвертации 			= ОМ.Новый_Реквизит(Неопределено); 
	РеквизитыЗаявки.КрайняяДата					= ОМ.Новый_Реквизит(Неопределено); 
	РеквизитыЗаявки.ВалютаОплаты 				= ОМ.Новый_Реквизит("Валюта");
	РеквизитыЗаявки.ДоговорКонтрагента 			= ОМ.Новый_Реквизит(Неопределено);
	РеквизитыЗаявки.БанковскийСчетКонтрагента 	= ОМ.Новый_Реквизит("ЛицевойСчет");
	РеквизитыЗаявки.ПриходРасход 				= ОМ.Новый_ЗначениеРеквизита("Перечисление.ВидыДвиженийПриходРасход.Расход");
	РеквизитыЗаявки.Ответственный 				= ОМ.Новый_Реквизит("Ответственный");
	РеквизитыЗаявки.ПланируемаяДатаОперации 	= ОМ.Новый_Реквизит("ЖелательнаяДатаПлатежа");
	//РеквизитыЗаявки.ДокументПланирования = ОМ.Новый_Реквизит("ДокументПланирования");
	
	// Аналитики
	ОМ.Изменить_Реквизит(РеквизитыЗаявки.СтатьяБюджета, "СтатьяДвиженияДенежныхСредств", "ВыдачаПодОтчет");
	ОМ.Изменить_Реквизит(РеквизитыЗаявки.СтатьяБюджетаСписания, "СтатьяДвиженияДенежныхСредств");
	
	
	Для Сч = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		ОМ.Изменить_Реквизит(РеквизитыЗаявки["Аналитика"			+Сч], "Аналитика"+Сч, "ВыдачаПодОтчет");
	КонецЦикла;
	
	// Регистрируем параметры размещения аналитик статей бюджетов
	ЗаявкиНаОперации.РазместитьВКолонкахТаблицы(РеквизитыЗаявки, "Сотрудники", 
		РеквизитыЗаявки.СтатьяБюджета, "СотрудникиСтатьяДвиженияДенежныхСредств",
		"Аналитика%1", "СотрудникиАналитика%1",
		ФормыУХ.РазместитьПередЭлементом("СотрудникиСумма", "Сотрудники"));
	
	//
	ЗаявкиНаОперации.РазместитьВПоляхФормы(РеквизитыЗаявки,,
		РеквизитыЗаявки.СтатьяБюджетаСписания, "СтатьяДвиженияДенежныхСредств",
		"Аналитика%1", "АналитикаШапка%1",
		ФормыУХ.РазместитьВГруппе("ГруппаАналитикиБюджетаЛевая"));
	
КонецПроцедуры

#Область ИсточникиДляКонтроляДокумента_УХ
	
Функция ИсточникиДокумента(Объект, ДополнительныеПараметры = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект));
	
	// 2. Планы по взаиморасчетам с контрагентом
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХВзаиморасчетыПоКонтрагенту, 
		Источник_ВзаиморасчетыПоКонтрагенту(Объект));
	
	Возврат Источники;
	
КонецФункции
	
Функция Источник_БюджетныеЛимитыРезервы(Объект)
	
		// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			НЕ ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);
	

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	0 КАК Лимит,
	|	0 КАК Зарезервировано,
	|	СУММА(ВТ_ПланыДокумента.Сумма) КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПланыДокумента.Аналитика6,
	|	ВТ_ПланыДокумента.ДокументПланирования,
	|	ВТ_ПланыДокумента.Аналитика1,
	|	ВТ_ПланыДокумента.ВидБюджета,
	|	ВТ_ПланыДокумента.ЦФО,
	|	ВТ_ПланыДокумента.СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика3,
	|	ВТ_ПланыДокумента.Проект,
	|	ВТ_ПланыДокумента.Аналитика5,
	|	ВТ_ПланыДокумента.Организация,
	|	ВТ_ПланыДокумента.Период,
	|	ВТ_ПланыДокумента.Валюта,
	|	ВТ_ПланыДокумента.ПриходРасход,
	|	ВТ_ПланыДокумента.Аналитика2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.Выполнить();
	
	//
	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;
	
КонецФункции

Функция Источник_ВзаиморасчетыПоКонтрагенту(Объект)
	
	ОМ = ЗаявкиНаОперации;
	РеквизитыЗаявки = ОМ.РеквизитыДокументаЗаявка(ТипЗнч(Объект.Ссылка));
	
	// Если незаполнен контрагент, то контроль не выполняется
	Контрагент = ОМ.РеквизитЗаявки(Объект, РеквизитыЗаявки.Контрагент);
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат неопределено;
	КонецЕсли;
	
	// Если роль определить не удалось, то контроль не выполняется
	РольКонтрагента = ВидыОперацийУХКлиентСерверПовтИсп.РольКонтрагента(Объект.ВидОперацииУХ);
	Если РольКонтрагента = Неопределено Тогда
		Возврат неопределено;
	КонецЕсли;
	
	//
	Результат = Новый Структура;
	Результат.Вставить("Заявка", 			Объект.Ссылка);
	Результат.Вставить("Контрагент", 		Контрагент);
	Результат.Вставить("СуммаПлатежа", 		Объект.СуммаДокумента);
	Результат.Вставить("Валюта", 			ОМ.РеквизитЗаявки(Объект, РеквизитыЗаявки.ВалютаДокумента));
	Результат.Вставить("РольКонтрагента", 	РольКонтрагента);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти 

#Область ПланыДокумента_УХ

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Дата КАК ДатаРегистрации,
	|	&Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК ДоговорКонтрагента,
	|	&Валюта КАК Валюта,
	|	&Ссылка КАК ДокументПланирования,
	|	&ЖелательнаяДатаПлатежа КАК Период,
	|	&ЦФО КАК ЦФО,
	|	&Проект КАК Проект,
	|	ДвиженияОперации.СтатьяДвиженияДенежныхСредств КАК СтатьяБюджета,
	|	ДвиженияОперации.Аналитика1 КАК Аналитика1,
	|	ДвиженияОперации.Аналитика2 КАК Аналитика2,
	|	ДвиженияОперации.Аналитика3 КАК Аналитика3,
	|	ДвиженияОперации.Аналитика4 КАК Аналитика4,
	|	ДвиженияОперации.Аналитика5 КАК Аналитика5,
	|	ДвиженияОперации.Аналитика6 КАК Аналитика6,
	|	ДвиженияОперации.Сумма КАК Сумма,
	|	&НаправлениеДвижения КАК ПриходРасход,
	|	&ВидБюджета КАК ВидБюджета
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	Документ.ЗаявкаНаКомандировку.ВыдачаПодОтчет КАК ДвиженияОперации
	|ГДЕ
	|	ДвиженияОперации.Ссылка = &Ссылка";  
		
	Запрос.УстановитьПараметр("ВидБюджета",				ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	Запрос.УстановитьПараметр("НаправлениеДвижения",	Перечисления.ВидыДвиженийПриходРасход.Расход);

	ИменаРеквизитов = "ВидОперацииУХ, ЦФО, Проект, Дата, ЖелательнаяДатаПлатежа, Валюта, Организация, Ссылка";
	
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, ИменаРеквизитов);
	Иначе                                        
		РеквизитыДокумента = Источник;

		//
		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		Реквизиты = "Сумма, Сотрудник, СтатьяДвиженияДенежныхСредств," 
						+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
		ДвиженияОперации = Источник.ВыдачаПодОтчет.Выгрузить(,Реквизиты);
		ДвиженияОперации.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		ДвиженияОперации.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("ДвиженияОперации", ДвиженияОперации);
		Запрос.Текст =
		"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ВыдачаПодОтчет ИЗ &ДвиженияОперации КАК Коллекция ";
		Запрос.Выполнить();
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ЗаявкаНаКомандировку.", "ВТ_");
		
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;

	// параметры из ВидОперацииУХ
	ЭтоРасчетыСКонтрагентом = ВидыОперацийУХВызовСервераПовтИсп.ЭтоРасчетыСКонтрагентом(РеквизитыДокумента.ВидОперацииУХ);
	ЭтоРасчетыПоДоговору = ЭтоРасчетыСКонтрагентом И НЕ ВидыОперацийУХВызовСервераПовтИсп.ЭтоРасчетыБезДоговора(РеквизитыДокумента.ВидОперацииУХ);
	
	Запрос.УстановитьПараметр("ЭтоРасчетыСКонтрагентом",	ЭтоРасчетыСКонтрагентом);
	Запрос.УстановитьПараметр("ЭтоРасчетыПоДоговору", 		ЭтоРасчетыПоДоговору);

	// Реквизиты договора
	ИменаРеквизитовДоговора = "ПорядокРасчетов, ГрафикДоговора";
	РеквизитыДоговора = Новый Структура(ИменаРеквизитовДоговора);
	РеквизитыДоговора.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПустаяСсылка();
	РеквизитыДоговора.ГрафикДоговора = Перечисления.ГрафикиДоговора.ПустаяСсылка();
	
	//Если ЭтоРасчетыПоДоговору И РеквизитыДокумента.ДоговорКонтрагента <> неопределено Тогда
	//	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ДоговорКонтрагента, ИменаРеквизитовДоговора);
	//КонецЕсли;
	
	Для Каждого КлючЗначение Из РеквизитыДоговора Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
  	Возврат Запрос.МенеджерВременныхТаблиц;
	
	
КонецФункции

Функция ДанныеОбъектаПоСсылке(Источник)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Источник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявкаНаОплату.Ссылка КАК Ссылка,
	|	ЗаявкаНаОплату.Дата КАК Дата,
	|	ЗаявкаНаОплату.ВидОперацииУХ КАК ВидОперацииУХ,
	|	ЗаявкаНаОплату.Валюта КАК Валюта,
	|	ЗаявкаНаОплату.СуммаДокумента КАК СуммаДокумента,
	|	ЗаявкаНаОплату.ЖелательнаяДатаПлатежа КАК ЖелательнаяДатаПлатежа,
	|	ЗаявкаНаОплату.Организация КАК Организация,
	|	ЗаявкаНаОплату.Сотрудник КАК Контрагент,
	|	ЗаявкаНаОплату.СписокФизЛиц КАК СписокФизЛиц,
	|	ЗаявкаНаОплату.ЦФО КАК ЦФО,
	|	ЗаявкаНаОплату.Проект КАК Проект,
	|	ЗаявкаНаОплату.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	ЗаявкаНаОплату.Аналитика1 КАК Аналитика1,
	|	ЗаявкаНаОплату.Аналитика2 КАК Аналитика2,
	|	ЗаявкаНаОплату.Аналитика3 КАК Аналитика3,
	|	ЗаявкаНаОплату.Аналитика4 КАК Аналитика4,
	|	ЗаявкаНаОплату.Аналитика5 КАК Аналитика5,
	|	ЗаявкаНаОплату.Аналитика6 КАК Аналитика6,
	|	ЗаявкаНаОплату.ВыдачаПодОтчет.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Сотрудник КАК Сотрудник,
	|		СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|		Аналитика1 КАК Аналитика1,
	|		Аналитика2 КАК Аналитика2,
	|		Аналитика3 КАК Аналитика3,
	|		Аналитика4 КАК Аналитика4,
	|		Аналитика5 КАК Аналитика5,
	|		Аналитика6 КАК Аналитика6,
	|		Сумма КАК Сумма
	|	) КАК ВыдачаПодОтчет
	|ИЗ
	|	Документ.ЗаявкаНаКомандировку КАК ЗаявкаНаОплату
	|ГДЕ
	|	ЗаявкаНаОплату.Ссылка = &Ссылка";
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка,,"ВыдачаПодОтчет");
		Результат.ВыдачаПодОтчет = Выборка.ВыдачаПодОтчет.Выгрузить();
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти 

#Область УХСогласование

Функция ПроверитьВозможностьУстановкиСостояния(ОбъектСсылка, СостояниеОбъекта, ПротоколОшибок = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектСсылка) <> Тип("ДокументСсылка.ЗаявкаНаКомандировку") Тогда
		ТекстОшибки = СтрШаблон( 
			НСтр("ru = 'Объект %1 не является заявкой на командировку.'"),
			ОбъектСсылка);
		УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
			ПротоколОшибок, ОбъектСсылка, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ПроверкаПройдена = Истина;
	
	Если СостояниеОбъекта = Перечисления.СостоянияСогласования.Утверждена Тогда
		
		// Организация, контрагент, договор, счет контрагента, статьи ДДС, ЦФО, Период контроля
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаОперацию.Ссылка КАК Ссылка,
		|	ЗаявкаНаОперацию.Организация КАК Организация,
		|	ЗаявкаНаОперацию.Сотрудник КАК Контрагент,
		|	ЗаявкаНаОперацию.ЦФО КАК ЦФО,
		|	ЗаявкаНаОперацию.ЛицевойСчет КАК СчетКонтрагента,
		|	ЗаявкаНаОперацию.ФормаОплатыЗаявки КАК ФормаОплаты,
		|	ЗаявкаНаОперацию.СуммаДокумента КАК СуммаДокумента,
		|	ЗаявкаНаОперацию.Валюта КАК ВалютаДокумента,
		|	ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
		|	ЗаявкаНаОперацию.ВидОперацииУХ КАК ВидОперацииУХ,
		|	ЗаявкаНаОперацию.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|	ЗаявкаНаОперацию.СуммаДокумента КАК СуммаДокумента1,
		|	ЗаявкаНаОперацию.ВыдачаПодОтчет.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Сотрудник КАК Сотрудник,
		|		ЛицевойСчет КАК ЛицевойСчет,
		|		СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|		Сумма КАК Сумма,
		|		Комментарий КАК Комментарий,
		|		Аналитика1 КАК Аналитика1,
		|		Аналитика2 КАК Аналитика2,
		|		Аналитика3 КАК Аналитика3,
		|		Аналитика4 КАК Аналитика4,
		|		Аналитика5 КАК Аналитика5,
		|		Аналитика6 КАК Аналитика6
		|	) КАК ДвижениеОперации
		|ИЗ
		|	Документ.ЗаявкаНаКомандировку КАК ЗаявкаНаОперацию
		|ГДЕ
		|	ЗаявкаНаОперацию.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
		ДанныеДокумента = Запрос.Выполнить().Выгрузить()[0];
		
		// Определение местонахождения статьи движения денежных средств
		МассивВсехРеквизитов = Новый Массив; МассивРеквизитовОперации = Новый Массив;
		Документы.ЗаявкаНаРасходованиеДенежныхСредств.ЗаполнитьИменаРеквизитовПоХозяйственнойОперацииУХ(
			ДанныеДокумента, МассивВсехРеквизитов, МассивРеквизитовОперации);
		
		//
		РеквизитыПроверяемыеНаЗаполнение = Новый СписокЗначений;
		РеквизитыПроверяемыеНаЗаполнение.Добавить("СуммаДокумента", 	НСтр("ru = 'Сумма документа'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("Валюта",			 	НСтр("ru = 'Валюта документа'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("ЦФО", 				НСтр("ru = 'ЦФО'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("Организация", 		НСтр("ru = 'Организация'"));
		
	
		
		// БанковскийСчетКонтрагента
		Если ДанныеДокумента.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная Тогда
			РеквизитыПроверяемыеНаЗаполнение.Добавить("ЛицевойСчет", НСтр("ru = 'Банковский счет контрагента'"));
		КонецЕсли;
		
		Для Каждого ПроверяемыйРеквизит из РеквизитыПроверяемыеНаЗаполнение Цикл
			Если Не ЗначениеЗаполнено(ДанныеДокумента[ПроверяемыйРеквизит.Значение]) Тогда
				
				ПроверкаПройдена = Ложь;
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле","Заполнение",ПроверяемыйРеквизит.Представление);
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект." + ПроверяемыйРеквизит.Значение);
				
			КонецЕсли;
		КонецЦикла;
			
		// Проверяем заполненность статьи движения денежных средств
		Если МассивРеквизитовОперации.Найти("ВыдачаПодОтчет.СтатьяДвиженияДенежныхСредств") <> Неопределено Тогда
			
			// Проверяеме заполненность ТЧ
			Если Не ДанныеДокумента.ДвиженияОперации.Количество() Тогда
				
				ПроверкаПройдена = Ложь;
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список","Заполнение", ,,НСтр("ru = 'Аналитики учета и планирования'"));
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект.ДвиженияОперации");
				
			КонецЕсли;
			
			// Проверяем заполненность статьи
			ПараметрыБюджета = ДвиженияБюджетированиеКлиентСерверУХ.ПараметрыБюджета(ДанныеДокумента.ВидБюджета);
			Для Каждого ТекСтрокаРасшифровки Из ДанныеДокумента.ДвиженияОперации Цикл
				// Проверка статьи бюджета.
				Если Не ЗначениеЗаполнено(ТекСтрокаРасшифровки[ПараметрыБюджета.КолонкаСтатья]) Тогда
					
					ПроверкаПройдена = Ложь;
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
						"Колонка",
						"Заполнение", 
						ПараметрыБюджета.ЗаголовокКолонкиСтатья, 
						ТекСтрокаРасшифровки.НомерСтроки,
						НСтр("ru = 'Аналитики учета и планирования'"));
					ИмяПоля = СтрШаблон("Объект.ДвиженияОперации[%1].%2", ТекСтрокаРасшифровки.НомерСтроки - 1, ПараметрыБюджета.КолонкаСтатья);
					
					УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, ИмяПоля);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			// Статья в шапке
			Если НЕ ЗначениеЗаполнено(ДанныеДокумента.СтатьяДвиженияДенежныхСредств) Тогда
				// Проверяем заполненность статьи
				ПроверкаПройдена = Ложь;
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Поле",	"Заполнение", НСтр("ru = 'Статья движения денежных средств'"),,,);
				
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
					ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект.СтатьяДвиженияДенежныхСредств");
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПроверкаПройдена;
	
КонецФункции
	
#КонецОбласти

#Область ПлатежныеПозиции_УХ

// Функция возвращает таблицу операций заявки для формирования платежной позиции
Функция ПолучитьДвиженияОперацииДокументаДляПлатежнойПозиции(ЗаявкаСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
	|	ВыдачаПодОтчет.Ссылка.ЦФО КАК ЦФО,
	|	ВыдачаПодОтчет.Ссылка.Проект КАК Проект,
	|	ВыдачаПодОтчет.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	ВыдачаПодОтчет.Аналитика1 КАК Аналитика1,
	|	ВыдачаПодОтчет.Аналитика2 КАК Аналитика2,
	|	ВыдачаПодОтчет.Аналитика3 КАК Аналитика3,
	|	ВыдачаПодОтчет.Аналитика4 КАК Аналитика4,
	|	ВыдачаПодОтчет.Аналитика5 КАК Аналитика5,
	|	ВыдачаПодОтчет.Аналитика6 КАК Аналитика6,
	|	ВыдачаПодОтчет.Ссылка.Валюта КАК ВалютаВзаиморасчетов,
	|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг) КАК ЭлементСтруктурыЗадолженности,
	|	ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС) КАК СтавкаНДС,
	|	0 КАК СуммаНДС,
	|	ВыдачаПодОтчет.Ссылка КАК ЗаявкаНаОперацию,
	|	ВыдачаПодОтчет.ЛицевойСчет КАК СчетКонтрагента,
	|	ВыдачаПодОтчет.Сотрудник КАК Контрагент,
	|	ВыдачаПодОтчет.ИдентификаторПозиции КАК ИдентификаторПозицииСтрока,
	|	СУММА(ВыдачаПодОтчет.Сумма) КАК Сумма,
	|	СУММА(ВыдачаПодОтчет.Сумма) КАК СуммаВзаиморасчетов
	|ИЗ
	|	Документ.ЗаявкаНаКомандировку.ВыдачаПодОтчет КАК ВыдачаПодОтчет
	|ГДЕ
	|	ВыдачаПодОтчет.Ссылка = &ДокументСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыдачаПодОтчет.Ссылка.ЦФО,
	|	ВыдачаПодОтчет.Ссылка.Проект,
	|	ВыдачаПодОтчет.СтатьяДвиженияДенежныхСредств,
	|	ВыдачаПодОтчет.Аналитика1,
	|	ВыдачаПодОтчет.Аналитика2,
	|	ВыдачаПодОтчет.Аналитика3,
	|	ВыдачаПодОтчет.Аналитика4,
	|	ВыдачаПодОтчет.Аналитика5,
	|	ВыдачаПодОтчет.Аналитика6,
	|	ВыдачаПодОтчет.Ссылка.Валюта,
	|	ВыдачаПодОтчет.Ссылка,
	|	ВыдачаПодОтчет.ЛицевойСчет,
	|	ВыдачаПодОтчет.Сотрудник,
	|	ВыдачаПодОтчет.ИдентификаторПозиции,
	|	ВыдачаПодОтчет.Сумма";
	
	Запрос.УстановитьПараметр("ДокументСсылка", ЗаявкаСсылка);
		
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаДанных.Колонки.Добавить("ИдентификаторПозиции", Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	Для Каждого СтрокаРезультат Из ТаблицаДанных Цикл
		Если Не ПустаяСтрока(СтрокаРезультат.ИдентификаторПозицииСтрока) Тогда
			СтрокаРезультат.ИдентификаторПозиции = Новый УникальныйИдентификатор(СтрокаРезультат.ИдентификаторПозицииСтрока);
		КонецЕсли;
	КонецЦикла;	

	Возврат ТаблицаДанных;
	
КонецФункции
	
#КонецОбласти

#КонецОбласти
#КонецЕсли