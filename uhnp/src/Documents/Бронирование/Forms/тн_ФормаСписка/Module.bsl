
&НаКлиенте
Процедура ВвестиВозврат(Команда)
	
	СсылкаНаОбъектВозврата = Элементы.Список.ТекущаяСтрока;  
	
	ДанныеТекущегоБронирования = ПолучитьДанныеПоТекущемуБронированию(СсылкаНаОбъектВозврата, РеквизитыКорректировок);
		
	ДопПараметры = ДанныеТекущегоБронирования.ДопПараметры;
	ДопПараметры.Вставить("СсылкаНаОбъектВозврата", СсылкаНаОбъектВозврата); 
	//НАЧАЛО Качикина 16.12.2024 Выполнение задач №000052060
	//ОткрытьФорму("Документ.Бронирование.Форма.ВводКорректировки",
	ОткрытьФорму("Документ.Бронирование.Форма.тн_ВводКорректировки",
	//КОНЕЦ Качикина 16.12.2024 Выполнение задач №000052060
		Новый Структура("ЗначенияРеквизитов, РеквизитыКорректировок", ДанныеТекущегоБронирования.ЗначенияРеквизитов, РеквизитыКорректировок),
		,,,,
		Новый ОписаниеОповещения("ПослеВводаКорректировки", ЭтотОбъект, ДанныеТекущегоБронирования.ДопПараметры),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры       

 &НаСервере 
Функция ПолучитьДанныеПоТекущемуБронированию(СсылкаНаОбъектВозврата, РеквизитыКорректировок);	
	
	СуммаВозврата = 0; 

	ОбъектВозврата = СсылкаНаОбъектВозврата.ПолучитьОбъект();
	Для каждого СтрокаТЧ Из ОбъектВозврата.Операции Цикл
		Если СтрокаТЧ.ТипОперации = ПредопределенноеЗначение("Перечисление.ТипыОперацийСБилетами.Покупка")
			Или СтрокаТЧ.ТипОперации = ПредопределенноеЗначение("Перечисление.ТипыОперацийСБилетами.Доплата") Тогда
			СуммаВозврата = СуммаВозврата + СтрокаТЧ.Сумма;
		ИначеЕсли СтрокаТЧ.ТипОперации = ПредопределенноеЗначение("Перечисление.ТипыОперацийСБилетами.Возврат") Тогда
			СуммаВозврата = СуммаВозврата - СтрокаТЧ.Сумма;
		КонецЕсли;
	КонецЦикла; 
	
	ЗначенияРеквизитов = Новый Структура;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ЗначенияРеквизитов.Вставить("Дата",ТекущаяДата());
	ЗначенияРеквизитов.Вставить("Дата",ТекущаяДатаСервера()); 
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	ЗначенияРеквизитов.Вставить("ТипОперации", ПредопределенноеЗначение("Перечисление.ТипыОперацийСБилетами.Возврат"));
	ЗначенияРеквизитов.Вставить("СтавкаНДС", ОбъектВозврата.СтавкаНДС);
	ЗначенияРеквизитов.Вставить("СуммаНДС",ОбъектВозврата.СуммаНДС);
	ЗначенияРеквизитов.Вставить("Сумма",СуммаВозврата); 
	//НАЧАЛО Блинова М.А. 14.11.2024 Выполнение задач №000051555
	//ЗначенияРеквизитов.Вставить("СуммаНеОблагаемаяНДС",ОбъектВозврата.СуммаНеОблагаемаяНДС);  
	ЗначенияРеквизитов.Вставить("СуммаДокумента",ОбъектВозврата.СуммаДокумента);
    //КОНЕЦ Блинова М.А. 14.11.2024 Выполнение задач №000051555
	ЗначенияРеквизитов.Вставить("Организация", СсылкаНаОбъектВозврата.Организация);	
	
	ДопПараметры = Новый Структура("НоваяСтрока, СсылкаНаОбъектВозврата", Ложь, СсылкаНаОбъектВозврата);

	ДанныеПоТекущемуБронированию = Новый Структура();
	ДанныеПоТекущемуБронированию.Вставить("ДопПараметры", ДопПараметры);
	ДанныеПоТекущемуБронированию.Вставить("ЗначенияРеквизитов", ЗначенияРеквизитов);

    Возврат ДанныеПоТекущемуБронированию;

КонецФункции

&НаКлиенте
Процедура ПослеВводаКорректировки(Результат, ДополнительныеПараметры) Экспорт
		   
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СсылкаНаОбъектВозврата = ДополнительныеПараметры.СсылкаНаОбъектВозврата;
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда  
		Возврат;
		//ЗаписатьДанныеПослеВводаКорректировки(ДополнительныеПараметры, , Истина);
	Иначе
		РезультатЗаписиКорректировки = ЗаписатьДанныеПослеВводаКорректировки(ДополнительныеПараметры,  Результат, Ложь);
	КонецЕсли;
	
	Если НЕ РезультатЗаписиКорректировки.КорректировкаЗаписана Тогда
		
		Если ЗначениеЗаполнено(РезультатЗаписиКорректировки.КраткоеПредставлениеОшибки) Тогда
			
			ТекстСообщения = РезультатЗаписиКорректировки.КраткоеПредставлениеОшибки;			
		Иначе
			
			ТекстСообщения = НСтр("При записи корректировки произошла ошибка.
							|Подробности см. в Журнале регистрации.");
		КонецЕсли;
		
		ВызватьИсключение ТекстСообщения 
	КонецЕсли;

	ИнформацияОКорректировках = ВывестиКорректировкиНаСервере(ДополнительныеПараметры.СсылкаНаОбъектВозврата); 
	ПодключитьОбработчикОжидания("ВывестиКорректировкиНаКлиенте", 0.1, Истина);
	Элементы.Список.Обновить();
КонецПроцедуры

&НаСервере
Функция ЗаписатьДанныеПослеВводаКорректировки(ДополнительныеПараметры, Результат = Ложь, Отмена = Ложь);
	
	СсылкаНаОбъектВозврата = ДополнительныеПараметры.СсылкаНаОбъектВозврата; 	
	РезультатЗаписиКорректировки = Новый Структура();
	ОбъектВозврата = СсылкаНаОбъектВозврата.ПолучитьОбъект();
	
	// НАЧАЛО Гутарова Екатерина 25.12.2023 Выполнение задач №000047924	  
	Если ДополнительныеПараметры.НоваяСтрока Тогда
		
		СтрокаКорректировки = ОбъектВозврата.Операции.Найти(ДополнительныеПараметры.ИдСтроки, "ИдентификаторСтроки");
		Если Не СтрокаКорректировки.ТипОперации = Перечисления.ТипыОперацийСБилетами.Возврат Тогда
				ЗаполнитьЗначенияСвойств(СтрокаКорректировки, Результат, РеквизитыКорректировок);
			Попытка
				ОбъектВозврата.Записать(РежимЗаписиДокумента.Проведение);   
				РезультатЗаписиКорректировки.Вставить("КорректировкаЗаписана", Истина);
			Исключение
				РезультатЗаписиКорректировки.Вставить("КорректировкаЗаписана", Ложь); 
				РезультатЗаписиКорректировки.Вставить("КраткоеПредставлениеОшибки", "Дата находится в закрытом периоде!");
			КонецПопытки;
			Возврат РезультатЗаписиКорректировки;
		КонецЕсли;
	КонецЕсли;
	// КОНЕЦ Гутарова Екатерина 25.12.2023 Выполнение задач №000047924
	
	Если Отмена Тогда
		
		Если ДополнительныеПараметры.НоваяСтрока Тогда
			СтрокаКорректировки = ОбъектВозврата.Операции.Найти(ДополнительныеПараметры.ИдСтроки, "ИдентификаторСтроки");
			Если СтрокаКорректировки <> Неопределено Тогда
				//НАЧАЛО Блинова М.А. 12.03.2025 Выполнение задач №000052998
				//ЗапретНайден = ПроверитьДатуЗапретаДляВводаВозврата(СтрокаКорректировки.Дата);
				ЗапретНайден = ПроверитьДатуЗапретаДляВводаВозврата(СтрокаКорректировки.Дата, ОбъектВозврата.Организация);
				//КОНЕЦ Блинова М.А. 12.03.2025 Выполнение задач №000052998
				Если ЗапретНайден Тогда 
					РезультатЗаписиКорректировки.Вставить("КорректировкаЗаписана", Ложь); 
					РезультатЗаписиКорректировки.Вставить("КраткоеПредставлениеОшибки", "Дата возврата находится в закрытом периоде! Удалить возврат нельзя.");
					Возврат  РезультатЗаписиКорректировки;
				Иначе	
					ОбъектВозврата.Операции.Удалить(СтрокаКорректировки);    
					// НАЧАЛО Юдина Екатерина 25.10.2024 Выполнение задач №000051313
					//// НАЧАЛО Гутарова Екатерина 25.09.2023 Выполнение задач №000046977
					//ОбъектВозврата.тн_ВозвратЗакрытогоПериода = Ложь;
					//// КОНЕЦ Гутарова Екатерина 25.09.2023 Выполнение задач №000046977 
					// КОНЕЦ Юдина Екатерина 25.10.2024 Выполнение задач №000051313
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе  
		Если   ДополнительныеПараметры.НоваяСтрока Тогда
			СтрокаКорректировки = ОбъектВозврата.Операции.Найти(ДополнительныеПараметры.ИдСтроки, "ИдентификаторСтроки");
		Иначе
			СтрокаКорректировки = ОбъектВозврата.Операции.Добавить();
		КонецЕсли;
		Если СтрокаКорректировки <> Неопределено Тогда
			//НАЧАЛО Блинова М.А. 12.03.2025 Выполнение задач №000052998
			//ЗапретНайден = ПроверитьДатуЗапретаДляВводаВозврата(Результат.Дата);
			ЗапретНайден = ПроверитьДатуЗапретаДляВводаВозврата(Результат.Дата, ОбъектВозврата.Организация);
			//КОНЕЦ Блинова М.А. 12.03.2025 Выполнение задач №000052998
				 Если НЕ ЗапретНайден Тогда
					ЗаполнитьЗначенияСвойств(СтрокаКорректировки, Результат, РеквизитыКорректировок);
					// НАЧАЛО Гутарова Екатерина 25.09.2023 Выполнение задач №000046977
					//НАЧАЛО Блинова М.А. 12.03.2025 Выполнение задач №000052998
					//Если  ПроверитьДатуЗапретаДляВводаВозврата(ОбъектВозврата.Дата) Тогда  
					Если  ПроверитьДатуЗапретаДляВводаВозврата(ОбъектВозврата.Дата, ОбъектВозврата.Организация) Тогда
					//КОНЕЦ Блинова М.А. 12.03.2025 Выполнение задач №000052998
						ОбъектВозврата.тн_ВозвратЗакрытогоПериода = Истина; 
						//НАЧАЛО Качикина 18.12.2024 Выполнение задач №000052059
						СтрокаКорректировки.тн_ВозвратЗакрытогоПериода = Истина;
						//КОНЕЦ Качикина 18.12.2024 Выполнение задач №000052059
					КонецЕсли;
					// КОНЕЦ Гутарова Екатерина 25.09.2023 Выполнение задач №000046977
				Иначе
					РезультатЗаписиКорректировки.Вставить("КорректировкаЗаписана", Ложь); 
					РезультатЗаписиКорректировки.Вставить("КраткоеПредставлениеОшибки", "Дата возврата находится в закрытом периоде! Поменяйте дату возврата.");
					Возврат  РезультатЗаписиКорректировки; 
			КонецЕсли;
		КонецЕсли;
		 			
	КонецЕсли;  
	     
	ПроверкаДатЗапретаОтключена = ДатыЗапретаИзменения.ПроверкаДатЗапретаОтключена();
     ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(Истина);
	Попытка
	 ОбъектВозврата.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(ПроверкаДатЗапретаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(ПроверкаДатЗапретаОтключена);
    РезультатЗаписиКорректировки.Вставить("КорректировкаЗаписана", Истина);
    Возврат  РезультатЗаписиКорректировки;
	
КонецФункции

&НаКлиенте
Процедура ВывестиКорректировкиНаКлиенте()
	
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
		СсылкаНаОбъектВозврата = Элементы.Список.ТекущаяСтрока;
		ИнформацияОКорректировках = ВывестиКорректировкиНаСервере(СсылкаНаОбъектВозврата);		 
	КонецЕсли;
	
КонецПроцедуры

 &НаСервере
Функция ВывестиКорректировкиНаСервере(СсылкаНаОбъектВозврата)

		ОбъектВозврата = СсылкаНаОбъектВозврата.ПолучитьОбъект();

		ШаблонДоплата = НСтр("ru = '%1 от %2 на сумму %3 %4';
							|en = '%1 dated %2 in the amount of %3 %4'");
		ШаблонВозврат = НСтр("ru = '%1 от %2 на сумму %3 %4 Штраф %5 %6';
							|en = '%1 dated %2 in the amount of %3 %4 Penalty %5 %6'");
		
		СтрокаКорректировок = "";
		
		Для каждого СтрокаТЧ Из ОбъектВозврата.Операции Цикл
			
			Если СтрокаТЧ.ТипОперации = Перечисления.ТипыОперацийСБилетами.Покупка Тогда
				Продолжить;
			ИначеЕсли СтрокаТЧ.ТипОперации = Перечисления.ТипыОперацийСБилетами.Доплата Тогда
				СтрокаСсылка = СтрШаблон(ШаблонДоплата,
					СтрокаТЧ.ТипОперации, Формат(СтрокаТЧ.Дата, "ДЛФ=Д"), СтрокаТЧ.Сумма, ОбъектВозврата.Валюта);
			ИначеЕсли СтрокаТЧ.ТипОперации = Перечисления.ТипыОперацийСБилетами.Возврат Тогда
				СтрокаСсылка = СтрШаблон(ШаблонВозврат,
					СтрокаТЧ.ТипОперации, Формат(СтрокаТЧ.Дата, "ДЛФ=Д"), СтрокаТЧ.Сумма, ОбъектВозврата.Валюта, СтрокаТЧ.СуммаШтрафа, ОбъектВозврата.Валюта);
			КонецЕсли;
			
			СтрокаКорректировок = СтрокаКорректировок
				+ "<a href = ""Изменить=" + Строка(СтрокаТЧ.ИдентификаторСтроки) + ">" + СтрокаСсылка + "</a>"
				+ "<a href = ""Удалить=" + Строка(СтрокаТЧ.ИдентификаторСтроки) + "><img src=""Очистить""></a>" + Символы.ПС;
		КонецЦикла;
		
		Возврат СтроковыеФункции.ФорматированнаяСтрока(СтрокаКорректировок);
		
КонецФункции
	
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)   
	
	 ПодключитьОбработчикОжидания("ВывестиКорректировкиНаКлиенте", 0.1, Истина); 
	 
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	СписокРеквизитов = Новый Массив;
	Для каждого МетаданныеРеквизита Из Метаданные.Документы.Бронирование.ТабличныеЧасти.Операции.Реквизиты Цикл
		СписокРеквизитов.Добавить(МетаданныеРеквизита.Имя);
	КонецЦикла;
	РеквизитыКорректировок = СтрСоединить(СписокРеквизитов, ",");  
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформацияОКорректировкахОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИдСтроки = Сред(НавигационнаяСсылкаФорматированнойСтроки, СтрНайти(НавигационнаяСсылкаФорматированнойСтроки, "=")+1);
	СсылкаНаОбъектВозврата = Элементы.Список.ТекущаяСтрока;  
	
	Если СтрНайти(НавигационнаяСсылкаФорматированнойСтроки, "Удалить") Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СсылкаНаОбъектВозврата", СсылкаНаОбъектВозврата);
		ДополнительныеПараметры.Вставить("НоваяСтрока", Истина);
		ДополнительныеПараметры.Вставить("ИдСтроки", ИдСтроки); 
		РезультатЗаписиКорректировки = ЗаписатьДанныеПослеВводаКорректировки(ДополнительныеПараметры, , Истина);
		Если НЕ РезультатЗаписиКорректировки.КорректировкаЗаписана Тогда
		
		Если ЗначениеЗаполнено(РезультатЗаписиКорректировки.КраткоеПредставлениеОшибки) Тогда
			
			ТекстСообщения = РезультатЗаписиКорректировки.КраткоеПредставлениеОшибки;			
		Иначе
			
			ТекстСообщения = НСтр("При записи корректировки произошла ошибка.
							|Подробности см. в Журнале регистрации.");
		КонецЕсли;
		
		ВызватьИсключение ТекстСообщения 
		КонецЕсли;
		ВывестиКорректировкиНаКлиенте();
	
	ИначеЕсли СтрНайти(НавигационнаяСсылкаФорматированнойСтроки, "Изменить") Тогда
		ДанныеПоИзменяемойКорректировке = ЗаполнитьДополнительныеПараметры(РеквизитыКорректировок, СсылкаНаОбъектВозврата, ИДСтроки); 
		//НАЧАЛО Блинова М.А. 13.03.2025 Выполнение задач №000053016
		//ОткрытьФорму("Документ.Бронирование.Форма.ВводКорректировки",  
		ОткрытьФорму("Документ.Бронирование.Форма.тн_ВводКорректировки",
		//КОНЕЦ Блинова М.А. 13.03.2025 Выполнение задач №000053016
		Новый Структура("ЗначенияРеквизитов, РеквизитыКорректировок", ДанныеПоИзменяемойКорректировке.ЗначенияРеквизитов, РеквизитыКорректировок),
		,,,,
		Новый ОписаниеОповещения("ПослеВводаКорректировки", ЭтотОбъект, ДанныеПоИзменяемойКорректировке.ДопПараметры),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция  ЗаполнитьДополнительныеПараметры(РеквизитыКорректировок, СсылкаНаОбъектВозврата, ИДСтроки)  
	
	ЗначенияРеквизитов = Новый Структура(РеквизитыКорректировок);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, СсылкаНаОбъектВозврата.Операции.Найти(ИдСтроки, "ИдентификаторСтроки"));
	ЗначенияРеквизитов.Вставить("Организация", СсылкаНаОбъектВозврата.Организация);	
	
	ДопПараметры = Новый Структура("ИдСтроки, НоваяСтрока, СсылкаНаОбъектВозврата", ИДСтроки, Истина, СсылкаНаОбъектВозврата);

	ДанныеПоТекущемуБронированию = Новый Структура();
	ДанныеПоТекущемуБронированию.Вставить("ДопПараметры", ДопПараметры);
	ДанныеПоТекущемуБронированию.Вставить("ЗначенияРеквизитов", ЗначенияРеквизитов);

    Возврат ДанныеПоТекущемуБронированию;
	
КонецФункции

&НаСервере
//Блинова М.А. 12.03.2025 Выполнение задач №000052998
//Функция ПроверитьДатуЗапретаДляВводаВозврата(ДатаВозврата)
Функция ПроверитьДатуЗапретаДляВводаВозврата(ДатаВозврата, ОрганизацияВозврата)

	ДанныеДляПроверки = ДатыЗапретаИзменения.ШаблонДанныхДляПроверки();
	СтрокаДляПроверки = ДанныеДляПроверки.Добавить();
	СтрокаДляПроверки.Дата = ДатаВозврата;
	//НАЧАЛО Блинова М.А. 12.03.2025 Выполнение задач №000052998
	СтрокаДляПроверки.Объект = ОрганизацияВозврата;
	СтрокаДляПроверки.Раздел = "ФинансовыйКонтур";  
	//КОНЕЦ Блинова М.А. 12.03.2025 Выполнение задач №000052998
	Возврат ДатыЗапретаИзмененияСлужебный.НайденЗапретИзмененияДанных(ДанныеДляПроверки, "", "", Неопределено);
	
КонецФункции

