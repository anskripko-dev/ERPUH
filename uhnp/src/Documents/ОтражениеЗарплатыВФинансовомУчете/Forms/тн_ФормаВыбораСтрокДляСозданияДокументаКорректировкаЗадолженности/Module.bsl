
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АдресДанныхТабличнойЧасти") 
		И НЕ ПустаяСтрока(Параметры.АдресДанныхТабличнойЧасти) Тогда
		
		ТаблицаДанных = ПолучитьИзВременногоХранилища(Параметры.АдресДанныхТабличнойЧасти); 
		УдалитьИзВременногоХранилища(Параметры.АдресДанныхТабличнойЧасти);
		
		СписокКорректировок = Неопределено;
		Если Параметры.Свойство("СписокСуществующихКорректировок") 
			И Параметры.СписокСуществующихКорректировок.Количество() > 0 Тогда
			СписокКорректировок = Параметры.СписокСуществующихКорректировок;
		КонецЕсли;
			
		Если НЕ ТаблицаДанных = Неопределено Тогда
			Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
				НоваяСтрока = СтрокиДляВыбора.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
				НоваяСтрока.НомерСтроки = СтрокиДляВыбора.Индекс(НоваяСтрока) + 1;
				Если НЕ СписокКорректировок = Неопределено Тогда
					МассивКорректировокПоКонтрагенту = СписокКорректировок.Получить(СтрокаДанных.тн_Контрагент);
					Если НЕ МассивКорректировокПоКонтрагенту = Неопределено Тогда
						НоваяСтрока.СвязанныеДокументы.ЗагрузитьЗначения(МассивКорректировокПоКонтрагенту);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Ошибка получения данных!");
		КонецЕсли;
		
	Иначе  
		
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Не переданы данные для обработки!");

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ПередатьВыбранныеСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтроки(Команда)

	ВыбратьВсеНаСервере(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИсключитьСтроки(Команда)

	ВыбратьВсеНаСервере(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередатьВыбранныеСтроки()
	
	ЕстьСтрокиССозданнымиКорректировками = Ложь;
	МассивВыбранныхСтрок = Новый Массив;
	Для Каждого СтрокаВыбора Из СтрокиДляВыбора Цикл
		Если СтрокаВыбора.СтрокаВыбрана Тогда
			Если СтрокаВыбора.СвязанныеДокументы.Количество() > 0 Тогда
				ЕстьСтрокиССозданнымиКорректировками = Истина;
			КонецЕсли;
			МассивВыбранныхСтрок.Добавить(СтрокаВыбора.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивВыбранныхСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите хотя бы одну строку для создания документа!");
		Возврат;
	КонецЕсли;
	
	Если ЕстьСтрокиССозданнымиКорректировками Тогда
		ТекстВопроса = "По выбранным строкам уже есть документы.
			|Создать еще?";
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("МассивВыбранныхСтрок", МассивВыбранныхСтрок); 
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОтветаНаВопросОСозданииКорректировок", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	Закрыть(МассивВыбранныхСтрок);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОСозданииКорректировок(Результат, ДополнительныеПараметры)  Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли; 
	
	Закрыть(ДополнительныеПараметры.МассивВыбранныхСтрок);
КонецПроцедуры  

&НаСервере
Процедура ВыбратьВсеНаСервере(ЗначениеВыбора = Истина)
	
	Для Каждого СтрокаТаблицы Из СтрокиДляВыбора Цикл
		СтрокаТаблицы.СтрокаВыбрана = ЗначениеВыбора;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти