#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ПрограммныйИнтерфейс
// Подготовить параметры проведения
//
// Параметры:
//  ДокументСсылка	 - ДокументСсылкаЦессияВходящая	 - документ Цессия входящая
//  Отказ			 - Булево	 - отказ 
// 
// Возвращаемое значение:
//  Структура - параметры для проведения документа
//
Функция ПодготовитьПараметрыПроведения(ДокументСсылка,ДополнительныеСвойства, Отказ) Экспорт
	
		// реквизиты документа.
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	ТекстыЗапроса 	= Новый СписокЗначений;
	ДобавитьТекстЗапросаПодтвержденныеОбъемыЗакупок(ТекстыЗапроса);

	ПроведениеСерверУХ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецФункции  

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка) Экспорт
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Реквизиты.Ссылка КАК Ссылка,
		|	Реквизиты.Дата КАК Дата,
		|	Реквизиты.ЦФО КАК ЦФО,
		|	Реквизиты.Ответственный КАК Ответственный
		|ИЗ
		|	Документ.ПодтверждениеЗакупки КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
		
	Для Каждого ТекРеквизит Из Реквизиты Цикл
		Запрос.УстановитьПараметр(ТекРеквизит.Ключ, ТекРеквизит.Значение);
	КонецЦикла;
	
	
КонецПроцедуры

#КонецОбласти   

#Область СлужебныеПроцедурыИФункции
Функция ДобавитьТекстЗапросаПодтвержденныеОбъемыЗакупок(ТекстыЗапроса)
	
	ИмяРегистра = "ПодтвержденныеОбъемыЗакупок";
	ТекстЗапроса = ТекстЗапросаПодтвержденныеОбъемыЗакупок();
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции    

Функция ТекстЗапросаПодтвержденныеОбъемыЗакупок()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Ссылка КАК Ссылка,
	|	ПодтверждениеЗакупкиДвиженияОперации.Период КАК Период,
	|	&ЦФО КАК ЦФО,
	|	ПодтверждениеЗакупкиДвиженияОперации.Номенклатура КАК Номенклатура,
	|	ПодтверждениеЗакупкиДвиженияОперации.КоличествоИзменение - ПодтверждениеЗакупкиДвиженияОперации.КоличествоИсходное КАК Подтверждено,
	|	ПодтверждениеЗакупкиДвиженияОперации.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПодтверждениеЗакупкиДвиженияОперации.Коэффициент КАК Коэффициент,
	|	ПодтверждениеЗакупкиДвиженияОперации.Законтрактовано КАК ЗаконтрактованоИсх
	|ИЗ
	|	Документ.ПодтверждениеЗакупки.ДвиженияОперации КАК ПодтверждениеЗакупкиДвиженияОперации
	|ГДЕ
	|	ПодтверждениеЗакупкиДвиженияОперации.Ссылка = &Ссылка
	|	И ПодтверждениеЗакупкиДвиженияОперации.КоличествоИзменение <> 0
	|	И ПодтверждениеЗакупкиДвиженияОперации.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Ссылка,
	|	ПодтверждениеЗакупкиНоменклатураКатегорий.Период,
	|	&ЦФО,
	|	ПодтверждениеЗакупкиНоменклатураКатегорий.Номенклатура,
	|	ПодтверждениеЗакупкиНоменклатураКатегорий.КоличествоИзменение,
	|	ПодтверждениеЗакупкиНоменклатураКатегорий.ЕдиницаИзмерения,
	|	ПодтверждениеЗакупкиНоменклатураКатегорий.Коэффициент,
	|	0
	|ИЗ
	|	Документ.ПодтверждениеЗакупки.НоменклатураКатегорий КАК ПодтверждениеЗакупкиНоменклатураКатегорий
	|ГДЕ
	|	ПодтверждениеЗакупкиНоменклатураКатегорий.Ссылка = &Ссылка
	|	И ПодтверждениеЗакупкиНоменклатураКатегорий.КоличествоИзменение <> 0";
			
	Возврат ТекстЗапроса;
	
КонецФункции
#КонецОбласти


#КонецЕсли
