#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)    
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Период = Год(ТекущаяДатаСеанса());
	КонецЕсли;
	ОбновитьТаблицуПериодовНаСервере(); 
	ЗаполнитьЗаголовки();
	УстановитьСтраницуГруппаТаблицПериодичности();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	СохранитьДанныеТаблицыПериодовВОбъект(ТекущийОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмениласьТаблицаНоменклатуры" Тогда
		ИзменилосьРаспределениеПоНоменклатуре(Параметр.АдресРезультата, Параметр.ТоварнаяКатегория);
		ОбновитьТаблицуПериодовНаСервере(); 
		ЗаполнитьЗаголовки();
		Модифицированность = Истина;
	КонецЕсли;
		
КонецПроцедуры
#КонецОбласти
	 
#Область ОбработчикиСобытийЭлементовШапкиФормы 

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.Комментарий");
КонецПроцедуры

&НаКлиенте
Процедура ПериодНачалоПриИзменении(Элемент)
	ОбновитьТаблицуПериодовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПериодОкончаниеПриИзменении(Элемент)
	ОбновитьТаблицуПериодовНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыПериодов
  
&НаКлиенте
Процедура ТаблицаПериодовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПериодовКварталПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	Возврат;
КонецПроцедуры  

&НаКлиенте
Процедура ТаблицаПериодовГодПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПериодовПослеУдаления(Элемент)
	ЗаполнитьЗаголовки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПериодовКварталПослеУдаления(Элемент)
	ЗаполнитьЗаголовки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПериодовГодПослеУдаления(Элемент)
	ЗаполнитьЗаголовки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПериодовКварталПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаПериодовКвартал.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено  Тогда
	    Возврат;		
	КонецЕсли; 
	Элементы.ТаблицаПериодовКварталРаспределитьПериодКвартал.Доступность = 
				НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура); 

	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Элемент.ТолькоПросмотр = Истина;
	Иначе
		Элемент.ТолькоПросмотр = Ложь;		
	КонецЕсли;			

КонецПроцедуры  

&НаКлиенте
Процедура ТаблицаПериодовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаПериодов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено  Тогда
	    Возврат;		
	КонецЕсли; 
	Элементы.ТаблицаПериодовРаспределитьПериод.Доступность = 
				НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура);
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаПериодовГодПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаПериодовГод.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено  Тогда
	    Возврат;		
	КонецЕсли; 
	Элементы.ТаблицаПериодовГодРаспределитьПериодГод.Доступность = 
				НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура);
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоТекущимОбъемам(Команда)
	ЗаполнитьПоТекущимОбъемамСервер();
	ОбновитьТаблицуПериодовНаСервере(); 
	ЗаполнитьЗаголовки();
	Модифицированность = Истина; 
	УстановитьСтраницуГруппаТаблицПериодичности()
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоТекущимОбъемамСервер()
	
	Если Объект.Проведен Тогда
		ТекстСообщения  = НСтр("ru = 'Заполнение возможно только в непроведенном документе'");
        ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,);
		Возврат;
	КонецЕсли;

	Объект.ДвиженияОперации.Очистить(); 
	Объект.НоменклатураКатегорий.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкаПодтвержденияЗакупки.Номенклатура КАК ТоварнаяКатегория,
		|	НастройкаПодтвержденияЗакупки.Периодичность КАК Периодичность,
		|	НастройкаПодтвержденияЗакупки.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|ГДЕ
		|	НастройкаПодтвержденияЗакупки.ЦФО = &ЦФО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодтвержденныеОбъемыЗакупокОбороты.Номенклатура КАК Номенклатура,
		|	0 КАК Законтрактовано,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПодтвержденоОборот КАК КоличествоИсходное,
		|	ПодтвержденныеОбъемыЗакупокОбороты.Коэффициент КАК Коэффициент,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодМесяц КАК ПериодМесяц,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодКвартал КАК ПериодКвартал,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодГод КАК ПериодГод,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодПолугодие КАК ПериодПолугодие,
		|	ПодтвержденныеОбъемыЗакупокОбороты.Номенклатура.КатегорияЗакупок КАК ТоварнаяКатегория
		|ИЗ
		|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПодтвержденныеОбъемыЗакупок.Обороты(&НачалоПериода, &КонецПериода, Авто, ) КАК ПодтвержденныеОбъемыЗакупокОбороты
		|		ПО НастройкаПодтвержденияЗакупки.ЦФО = ПодтвержденныеОбъемыЗакупокОбороты.ЦФО
		|			И НастройкаПодтвержденияЗакупки.Номенклатура = ПодтвержденныеОбъемыЗакупокОбороты.Номенклатура.КатегорияЗакупок 
		|ГДЕ
		|	НастройкаПодтвержденияЗакупки.ЦФО = &ЦФО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
		|	0,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПодтвержденоОборот,
		|	ПодтвержденныеОбъемыЗакупокОбороты.Коэффициент,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ЕдиницаИзмерения,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодМесяц,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодКвартал,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодГод,
		|	ПодтвержденныеОбъемыЗакупокОбороты.ПериодПолугодие,
		|	ПодтвержденныеОбъемыЗакупокОбороты.Номенклатура
		|ИЗ
		|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПодтвержденныеОбъемыЗакупок.Обороты(&НачалоПериода, &КонецПериода, Авто, ) КАК ПодтвержденныеОбъемыЗакупокОбороты
		|		ПО НастройкаПодтвержденияЗакупки.ЦФО = ПодтвержденныеОбъемыЗакупокОбороты.ЦФО
		|			И НастройкаПодтвержденияЗакупки.Номенклатура = ПодтвержденныеОбъемыЗакупокОбороты.Номенклатура
		|ГДЕ
		|	НастройкаПодтвержденияЗакупки.ЦФО = &ЦФО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
		|	Планированиепотребностей.КоличествоПриход,
		|	0,
		|	Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент,
		|	Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения,
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, МЕСЯЦ),
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, КВАРТАЛ),
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, ГОД),
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, ПОЛУГОДИЕ),
		|	Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура
		|ИЗ
		|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей.Обороты(&НачалоПериода, &КонецПериода, Авто, ) КАК Планированиепотребностей
		|		ПО НастройкаПодтвержденияЗакупки.ЦФО = Планированиепотребностей.АналитикаПланирования.АналитикаСтруктуры.ЦФО
		|			И НастройкаПодтвержденияЗакупки.Номенклатура = Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура
		|			И Планированиепотребностей.АналитикаПланирования.Этап = Значение(Перечисление.ЭтапыПланированияПотребностей.Законтрактовано)
		|ГДЕ
		|	НастройкаПодтвержденияЗакупки.ЦФО = &ЦФО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура,
		|	Планированиепотребностей.КоличествоПриход,
		|	0,
		|	Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент,
		|	Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения,
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, МЕСЯЦ),
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, КВАРТАЛ),
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, ГОД),
		|	НАЧАЛОПЕРИОДА(Планированиепотребностей.АналитикаПланирования.ДатаОперации, ПОЛУГОДИЕ),
		|	Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура.КатегорияЗакупок
		|ИЗ
		|	РегистрСведений.НастройкаПодтвержденияЗакупки КАК НастройкаПодтвержденияЗакупки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПланированиеПотребностей.Обороты(&НачалоПериода, &КонецПериода, Авто, ) КАК Планированиепотребностей
		|		ПО НастройкаПодтвержденияЗакупки.ЦФО = Планированиепотребностей.АналитикаПланирования.АналитикаСтруктуры.ЦФО
		|			И НастройкаПодтвержденияЗакупки.Номенклатура = Планированиепотребностей.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура.КатегорияЗакупок
		|			И Планированиепотребностей.АналитикаПланирования.Этап = Значение(Перечисление.ЭтапыПланированияПотребностей.Законтрактовано)
		|ГДЕ
		|	НастройкаПодтвержденияЗакупки.ЦФО = &ЦФО";

	
	Запрос.УстановитьПараметр("ЦФО", 			Объект.ЦФО); 
	Запрос.УстановитьПараметр("НачалоПериода", 	НачалоГода(Дата(Объект.Период, 1, 1)) );
	Запрос.УстановитьПараметр("КонецПериода", 	КонецГода(Дата(Объект.Период, 1, 1)));
	
	РезультатЗапроса 	= Запрос.ВыполнитьПакет(); 
	ВыборкаНоменклатура = РезультатЗапроса[0].Выбрать();
	ВыгрузкаПериоды 	= РезультатЗапроса[1].Выгрузить();
	
	ВыгрузкаПериоды.Индексы.Добавить("Номенклатура");
	
	Пока ВыборкаНоменклатура.Следующий() Цикл 
		СтруктураОтбора  = Новый Структура;
		СтруктураОтбора.Вставить("ТоварнаяКатегория", ВыборкаНоменклатура.ТоварнаяКатегория);
		ТаблицаПериодаНоменклатура = ВыгрузкаПериоды.Скопировать(СтруктураОтбора); 
		
		ИмяКолонкиСвертки = ИмяКолонкиСортировки(ВыборкаНоменклатура.Периодичность);
		ТаблицаПериодаНоменклатура.Свернуть(ИмяКолонкиСвертки + ",Номенклатура,ЕдиницаИзмерения, Коэффициент",
							"Законтрактовано, КоличествоИсходное");
		
		Для каждого СтрокаТаблицы Из ТаблицаПериодаНоменклатура Цикл
			СтрокаДвижения = Объект.ДвиженияОперации.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвижения, СтрокаТаблицы);
			СтрокаДвижения.Период 				= СтрокаТаблицы[ИмяКолонкиСвертки]; 
			СтрокаДвижения.Периодичность 		= ВыборкаНоменклатура.Периодичность; 
			СтрокаДвижения.ТоварнаяКатегория	= ВыборкаНоменклатура.ТоварнаяКатегория;
			СтрокаДвижения.Номенклатура			= СтрокаТаблицы.Номенклатура;
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры
			
&НаКлиенте
Процедура ПодтвердитьВсеКвартал(Команда)
	
	ВыделенныеСтроки = Элементы.ТаблицаПериодовКвартал.ВыделенныеСтроки;
	
	Если НЕ ВыделенныеСтроки.Количество() Тогда
		Возврат;	
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	Для каждого СтрокаСписка Из ВыделенныеСтроки Цикл
			ТекущиеДанные = Элементы.ТаблицаПериодовКвартал.ДанныеСтроки(СтрокаСписка);
			МассивНоменклатуры.Добавить(ТекущиеДанные.Номенклатура);
	КонецЦикла; 
	
	ТекущаяПериодичность = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.Периодичность.Квартал");
	
	ПодтвердитьВсеНаСервере(МассивНоменклатуры, ТекущаяПериодичность); 
	
КонецПроцедуры   

&НаКлиенте
Процедура ПодтвердитьВсеГод(Команда)

	ВыделенныеСтроки = Элементы.ТаблицаПериодовГод.ВыделенныеСтроки;
	
	Если НЕ ВыделенныеСтроки.Количество() Тогда
		Возврат;	
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	Для каждого СтрокаСписка Из ВыделенныеСтроки Цикл
			ТекущиеДанные = Элементы.ТаблицаПериодовГод.ДанныеСтроки(СтрокаСписка);
