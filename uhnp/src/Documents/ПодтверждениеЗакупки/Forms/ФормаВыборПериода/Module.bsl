#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("Периодичность")
		ИЛИ НЕ Параметры.Свойство("НачалоПериода") 
		ИЛИ НЕ Параметры.Свойство("КонецПериода") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
    
	ЗаполнитьПериоды(Параметры.НачалоПериода, Параметры.КонецПериода, Параметры.Периодичность, Параметры.МассивДат);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для каждого СтрокаПериод Из ПериодыПотребности Цикл
		
		СтрокаПериод.Отметка = Истина;		
	
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	Для каждого СтрокаПериод Из ПериодыПотребности Цикл
		
		СтрокаПериод.Отметка = Ложь;		
	
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗакрыть(Команда)
	
	МассивДат = Новый Массив;
	Для каждого СтрокаПериод Из ПериодыПотребности Цикл
		
		Если СтрокаПериод.Отметка Тогда 
			МассивДат.Добавить(СтрокаПериод.ПериодНачала);
		КонецЕсли;
		
	КонецЦикла;
	
	Закрыть(МассивДат);
	
КонецПроцедуры
#КонецОбласти


#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура ЗаполнитьПериоды(НачалоПериода,КонецПериода, Периодичность, МассивДат)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Периоды.Ссылка КАК Период,
		|	Периоды.ДатаНачала КАК ПериодНачала,
		|	ИСТИНА КАК Отметка
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.Периодичность = &Периодичность
		|	И Периоды.ДатаНачала >= &ДатаНачала
		|	И Периоды.ДатаОкончания <= &ДатаОкончания
		|	И Периоды.ДатаНачала В(&МассивДат)";
	
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецПериода);
	Запрос.УстановитьПараметр("Периодичность", 	Периодичность);
	Запрос.УстановитьПараметр("МассивДат", 		МассивДат);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаПериода = ПериодыПотребности.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПериода, ВыборкаДетальныеЗаписи);
	КонецЦикла;

КонецПроцедуры
#КонецОбласти
