#Область ИсточникиДляКонтроляДокумента

Функция ИсточникиДокумента(Объект, ДопПараметры = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект));
		
	Возврат Источники;
	
КонецФункции

Функция Источник_БюджетныеЛимитыРезервы(Объект)
	
	// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			Не ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	ВТ_ПланыДокумента.ДокументРезервирования КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_ПланыДокумента.ДокументПланирования = НЕОПРЕДЕЛЕНО
	|				ТОГДА ВТ_ПланыДокумента.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Лимит,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_ПланыДокумента.ДокументРезервирования <> НЕОПРЕДЕЛЕНО
	|				ТОГДА -ВТ_ПланыДокумента.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Зарезервировано,
	|	СУММА(ВТ_ПланыДокумента.Сумма) КАК Заявлено,
	|	СУММА(0) КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|ГДЕ
	|	ВТ_ПланыДокумента.ДокументПланирования = &КонтролируемыйДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПланыДокумента.Аналитика6,
	|	ВТ_ПланыДокумента.ДокументПланирования,
	|	ВТ_ПланыДокумента.ДокументРезервирования,
	|	ВТ_ПланыДокумента.Аналитика1,
	|	ВТ_ПланыДокумента.ВидБюджета,
	|	ВТ_ПланыДокумента.ЦФО,
	|	ВТ_ПланыДокумента.СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика3,
	|	ВТ_ПланыДокумента.Проект,
	|	ВТ_ПланыДокумента.Аналитика5,
	|	ВТ_ПланыДокумента.Организация,
	|	ВТ_ПланыДокумента.Период,
	|	ВТ_ПланыДокумента.Валюта,
	|	ВТ_ПланыДокумента.ПриходРасход,
	|	ВТ_ПланыДокумента.Аналитика2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.УстановитьПараметр("КонтролируемыйДокумент", Объект.ДоговорКонтрагента); 
	Запрос.Выполнить();

	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;
	
КонецФункции

#КонецОбласти 

#Область ПланыДокумента

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	1 КАК ТипЗапроса,
	|	&ДатаДокумента КАК ДатаРегистрации,
	|	ГрафикРасчетов.ВидБюджета КАК ВидБюджета,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК ДоговорКонтрагента,
	|	ВЫБОР
	|		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	|			ТОГДА &Договор
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОбъектРасчетов,
	|	&Валюта КАК Валюта,
	|	&Договор КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА ГрафикРасчетов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|			ТОГДА &ИсточникЛимитовБДДС
	|		КОГДА ГрафикРасчетов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|			ТОГДА &ИсточникЛимитовИсполнение
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДокументРезервирования,
	|	ГрафикРасчетов.Дата КАК Период,
	|	ГрафикРасчетов.ЦФО КАК ЦФО,
	|	ГрафикРасчетов.Проект КАК Проект,
	|	ГрафикРасчетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ГрафикРасчетов.Аналитика1 КАК Аналитика1,
	|	ГрафикРасчетов.Аналитика2 КАК Аналитика2,
	|	ГрафикРасчетов.Аналитика3 КАК Аналитика3,
	|	ГрафикРасчетов.Аналитика4 КАК Аналитика4,
	|	ГрафикРасчетов.Аналитика5 КАК Аналитика5,
	|	ГрафикРасчетов.Аналитика6 КАК Аналитика6,
	|	ГрафикРасчетов.Сумма КАК Сумма,
	|	ГрафикРасчетов.НаправлениеДвижения КАК ПриходРасход
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	Документ.ВерсияСоглашенияДепозит.ГрафикРасчетов КАК ГрафикРасчетов
	|ГДЕ
	|	ГрафикРасчетов.Ссылка = &Ссылка
	|	И ГрафикРасчетов.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2,
	|	&ДатаДокумента,
	|	ОперацииБюджетов.ВидБюджета,
	|	&Организация,
	|	&Контрагент,
	|	&Договор,
	|	ВЫБОР
	|		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	|			ТОГДА &Договор
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	&Валюта,
	|	&Договор,
	|	НЕОПРЕДЕЛЕНО,
	|	ОперацииБюджетов.Период,
	|	ОперацииБюджетов.АналитикаСтруктуры.ЦФО,
	|	ОперацииБюджетов.АналитикаСтруктуры.Проект,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.СтатьяБюджета,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика1,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика2,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика3,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика4,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика5,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика6,
	|	ОперацииБюджетов.Сумма * -1,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов.ПриходРасход
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|ГДЕ
	|	ОперацииБюджетов.Регистратор В(&ВерсииСоглашений)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	3,
	|	&ДатаДокумента,
	|	ГрафикРасчетов.ВидБюджета,
	|	&Организация,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	&Валюта,
	|	&ИсточникЛимитовБДДС,
	|	НЕОПРЕДЕЛЕНО,
	|	ГрафикРасчетов.Дата,
	|	ГрафикРасчетов.ЦФО,
	|	ГрафикРасчетов.Проект,
	|	ГрафикРасчетов.СтатьяБюджета,
	|	ГрафикРасчетов.Аналитика1,
	|	ГрафикРасчетов.Аналитика2,
	|	ГрафикРасчетов.Аналитика3,
	|	ГрафикРасчетов.Аналитика4,
	|	ГрафикРасчетов.Аналитика5,
	|	ГрафикРасчетов.Аналитика6,
	|	-ГрафикРасчетов.Сумма,
	|	ГрафикРасчетов.НаправлениеДвижения
	|ИЗ
	|	Документ.ВерсияСоглашенияДепозит.ГрафикРасчетов КАК ГрафикРасчетов
	|ГДЕ
	|	ГрафикРасчетов.Ссылка = &Ссылка
	|	И ГрафикРасчетов.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|	И НЕ &ИсточникЛимитовБДДС = НЕОПРЕДЕЛЕНО
	|	И ГрафикРасчетов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	4,
	|	&ДатаДокумента,
	|	ГрафикРасчетов.ВидБюджета,
	|	&Организация,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	&Валюта,
	|	&ИсточникЛимитовИсполнение,
	|	НЕОПРЕДЕЛЕНО,
	|	ГрафикРасчетов.Дата,
	|	ГрафикРасчетов.ЦФО,
	|	ГрафикРасчетов.Проект,
	|	ГрафикРасчетов.СтатьяБюджета,
	|	ГрафикРасчетов.Аналитика1,
	|	ГрафикРасчетов.Аналитика2,
	|	ГрафикРасчетов.Аналитика3,
	|	ГрафикРасчетов.Аналитика4,
	|	ГрафикРасчетов.Аналитика5,
	|	ГрафикРасчетов.Аналитика6,
	|	-ГрафикРасчетов.Сумма,
	|	ГрафикРасчетов.НаправлениеДвижения
	|ИЗ
	|	Документ.ВерсияСоглашенияДепозит.ГрафикРасчетов КАК ГрафикРасчетов
	|ГДЕ
	|	ГрафикРасчетов.Ссылка = &Ссылка
	|	И ГрафикРасчетов.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|	И НЕ &ИсточникЛимитовИсполнение = НЕОПРЕДЕЛЕНО
	|	И ГрафикРасчетов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = НЕОПРЕДЕЛЕНО";

	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, 
					"Дата, ВалютаВзаиморасчетов, Организация, ДоговорКонтрагента, ДокументОснование,
					|ИсточникЛимитовБДДС, ИсточникЛимитовИсполнение, Контрагент, ПорядокРасчетов");
		
		Запрос.УстановитьПараметр("ДатаДокумента", 		Реквизиты.Дата);
		Запрос.УстановитьПараметр("Валюта", 			Реквизиты.ВалютаВзаиморасчетов);
		Запрос.УстановитьПараметр("Организация", 		Реквизиты.Организация);
		Запрос.УстановитьПараметр("Контрагент", 		Реквизиты.Контрагент);
		Запрос.УстановитьПараметр("Договор",			Реквизиты.ДоговорКонтрагента); 
		Запрос.УстановитьПараметр("ПорядокРасчетов",	Реквизиты.ПорядокРасчетов);
		Запрос.УстановитьПараметр("ДокументОснование",	Реквизиты.ДокументОснование);
		Запрос.УстановитьПараметр("ВерсииСоглашений", 	КонтрольУХ.ВерсииСоглашений(Реквизиты.ДокументОснование));
				
		ИсточникЛимитовБДДС = ?(ЗначениеЗаполнено(Реквизиты.ИсточникЛимитовБДДС), 
											Реквизиты.ИсточникЛимитовБДДС, Неопределено);
		ИсточникЛимитовИсполнение = ?(ЗначениеЗаполнено(Реквизиты.ИсточникЛимитовИсполнение), 
											Реквизиты.ИсточникЛимитовИсполнение, Неопределено);    
		
		Запрос.УстановитьПараметр("ИсточникЛимитовБДДС", ИсточникЛимитовБДДС); 
		Запрос.УстановитьПараметр("ИсточникЛимитовИсполнение", ИсточникЛимитовИсполнение);

	Иначе
		Запрос.УстановитьПараметр("ДатаДокумента",		Источник.Дата);
		Запрос.УстановитьПараметр("Валюта", 			Источник.ВалютаВзаиморасчетов);
		Запрос.УстановитьПараметр("Организация", 		Источник.Организация);
		Запрос.УстановитьПараметр("Контрагент", 		Источник.Контрагент);
		Запрос.УстановитьПараметр("Договор", 			Источник.ДоговорКонтрагента);
		Запрос.УстановитьПараметр("ПорядокРасчетов",	Источник.ПорядокРасчетов);  
		Запрос.УстановитьПараметр("ДокументОснование",	Источник.ДокументОснование);
		Запрос.УстановитьПараметр("ВерсииСоглашений", 	КонтрольУХ.ВерсииСоглашений(Источник.ДокументОснование));
		
		ИсточникЛимитовБДДС = ?(ЗначениеЗаполнено(Источник.ИсточникЛимитовБДДС), 
											Источник.ИсточникЛимитовБДДС, Неопределено);
		ИсточникЛимитовИсполнение = ?(ЗначениеЗаполнено(Источник.ИсточникЛимитовИсполнение), 
											Источник.ИсточникЛимитовИсполнение, Неопределено);

		Запрос.УстановитьПараметр("ИсточникЛимитовБДДС",	   ИсточникЛимитовБДДС);
		Запрос.УстановитьПараметр("ИсточникЛимитовИсполнение", ИсточникЛимитовИсполнение);

		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		Реквизиты = "Сумма, Дата, ЦФО, Проект, СтатьяБюджета, НаправлениеДвижения, ВидБюджета," 
						+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
		ГрафикРасчетов = Источник.ГрафикРасчетов.Выгрузить(, Реквизиты);
		ГрафикРасчетов.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		ГрафикРасчетов.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("ГрафикРасчетов", ГрафикРасчетов);
		Запрос.Текст =
			"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ГрафикРасчетов ИЗ &ГрафикРасчетов КАК Коллекция ";
		Запрос.Выполнить();
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ВерсияСоглашенияДепозит.", "ВТ_");
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции

Функция ДанныеОбъектаПоСсылке(Источник)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Источник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВерсияСоглашенияКоммерческийДоговор.Ссылка КАК Ссылка,
	|	ВерсияСоглашенияКоммерческийДоговор.Дата КАК Дата,
	|	ВерсияСоглашенияКоммерческийДоговор.Организация КАК Организация,
	|	ВерсияСоглашенияКоммерческийДоговор.Контрагент КАК Контрагент,
	|	ВерсияСоглашенияКоммерческийДоговор.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВерсияСоглашенияКоммерческийДоговор.ОсновнойЦФО КАК ОсновнойЦФО,
	|	ВерсияСоглашенияКоммерческийДоговор.ОсновнойПроект КАК ОсновнойПроект,
	|	ВерсияСоглашенияКоммерческийДоговор.ИсточникЛимитовБДДС КАК ИсточникЛимитовБДДС,
