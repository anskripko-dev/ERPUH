&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекстОграничений(ТекстОграничений, Объект, КэшируемыеЗначения)
	
	Ограничения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КэшируемыеЗначения, "Ограничения");
	Если НЕ ЗначениеЗаполнено(Ограничения) Тогда
		ТекстОграничений = "";
		Возврат;
	КонецЕсли;
	
	СтрокиОграничения = Новый Массив;
	СтрокиОграничения.Добавить("Размещение средств возможно:");
	
	// Сумма сделки.
	СтрокаСуммаСделки = "";	
	Если ЗначениеЗаполнено(Ограничения.МинимальнаяСуммаСделки) 
			И ЗначениеЗаполнено(Ограничения.МаксимальнаяСуммаСделки) Тогда
		СтрокаСуммаСделки = СтрШаблон(Нстр("ru = 'в размере не менее %1 %3 и не более %2 %3'"), 
			Ограничения.МинимальнаяСуммаСделки, Ограничения.МаксимальнаяСуммаСделки, Объект.ВалютаВзаиморасчетов);
		
	ИначеЕсли ЗначениеЗаполнено(Ограничения.МинимальнаяСуммаСделки) Тогда
		СтрокаСуммаСделки = СтрШаблон(Нстр("ru = 'в размере не менее %1 %2'"), 
			Ограничения.МинимальнаяСуммаСделки, Объект.ВалютаВзаиморасчетов);
		
	ИначеЕсли ЗначениеЗаполнено(Ограничения.МаксимальнаяСуммаСделки) Тогда
		СтрокаСуммаСделки = СтрШаблон(Нстр("ru = 'в размере не более %1 %2'"), 
			Ограничения.МаксимальнаяСуммаСделки, Объект.ВалютаВзаиморасчетов);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаСуммаСделки) Тогда	
		СтрокиОграничения.Добавить(" - " + СтрокаСуммаСделки);
	КонецЕсли;	

	// Длительность размещения.
	СтрокаСрокСделки = "";
	Если ЗначениеЗаполнено(Ограничения.МинимальныйСрок) И ЗначениеЗаполнено(Ограничения.МаксимальныйСрок) Тогда
		СтрокаСрокСделки = СтрШаблон(Нстр("ru = 'на срок не менее %1 дней и не более %2 дней'"), 
			Ограничения.МинимальныйСрок, Ограничения.МаксимальныйСрок);
		
	ИначеЕсли ЗначениеЗаполнено(Ограничения.МинимальныйСрок) Тогда
		СтрокаСрокСделки = СтрШаблон(Нстр("ru = 'на срок не менее %1 дней'"), Ограничения.МинимальныйСрок);
		
	ИначеЕсли ЗначениеЗаполнено(Ограничения.МаксимальныйСрок) Тогда
		СтрокаСрокСделки = СтрШаблон(Нстр("ru = 'на срок не более %1 дней'"), Ограничения.МаксимальныйСрок);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(СтрокаСрокСделки) Тогда	
		СтрокиОграничения.Добавить(" - " + СтрокаСрокСделки);
	КонецЕсли;
	
	Если СтрокиОграничения.Количество() > 1 Тогда
		ТекстОграничений = Новый ФорматированнаяСтрока(СтрСоединить(СтрокиОграничения, Символы.ПС));
	Иначе
		ТекстОграничений = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеСекцииНаСервере(ИндексСтроки, ИмяСекции)
	
	СтруктураДействий = Новый Структура;
	
	Если Объект.АвтоматическиеВычисления Тогда
		СтруктураДействий.Вставить("Замкнуть", 
			Новый Структура("СекцииГрафика", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИмяСекции)));
		Если ИмяСекции = "ОсновнойДолг" Тогда
			СтруктураДействий.Вставить("Пересчитать", 
				Новый Структура("СекцииГрафика", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Проценты")));
		КонецЕсли;
	КонецЕсли;	
	ФинансовыеИнструментыУХ.ПересчетГрафика(Объект, ИндексСтроки, ОписаниеГрафика, СтруктураДействий);
	
