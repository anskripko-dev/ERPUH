&НаСервере
Процедура ПеренестиФактНаСервере(ДатаПереноса)
	
	// Пересчет основного долга и процентов
	СтруктураДействий = Новый Структура;
	СекцииОсновнойДолг = Новый Массив;
	СекцииОсновнойДолг.Добавить("ОсновнойДолг");
	СтруктураДействий.Вставить("Замкнуть", Новый Структура("СекцииГрафика", СекцииОсновнойДолг));
	
	СекцииПроценты = Новый Массив;
	СекцииПроценты.Добавить("Проценты");
	ДопПараметры = Новый Структура("ДатаНачалаПересчета", ДатаПереноса + 1);
	СтруктураДействий.Вставить("Пересчитать", 
			Новый Структура("СекцииГрафика, ДопПараметры", СекцииПроценты, ДопПараметры));
	
	ДоговорыКонтрагентовФормыУХ.АктуализироватьГрафикРасчетовНаФорме(ЭтотОбъект, ДатаПереноса, СтруктураДействий);   
	
