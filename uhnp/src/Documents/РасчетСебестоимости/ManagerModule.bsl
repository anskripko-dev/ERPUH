Функция ТекстЗапроса_ОстаткиНаНачалоТК(НомераТаблиц)
	
	НомераТаблиц.Вставить("ОстаткиНаНачалоБезСтруктуры", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерОстаткаДляРаспределения,
	|	т.Организация КАК Организация,
	|	т.Значение КАК Сумма,
	|	т.Значение КАК СуммаВО,
	|	0 КАК Количество,
	|	т.Счет КАК Счет,
	|	СчетаЗакрытия.СчетИБ КАК СчетИБ,
	|	ВЫБОР
	|		КОГДА &КорректировкиАмортизации
	|			ТОГДА т.РазделМСФО
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК РазделМСФО,
	|	ВЫБОР СчетаЗакрытия.НомерСубконтоАВНА
	|		КОГДА 1
	|			ТОГДА т.Субконто1
	|		КОГДА 2
	|			ТОГДА т.Субконто2
	|		КОГДА 3
	|			ТОГДА т.Субконто3
	|	КОНЕЦ КАК АВНА,
	|	т.ТипСчетаЗакрытия КАК ТипСчетаЗакрытия,
	|	СчетаЗакрытия.СчетСтруктурыОстатков КАК СчетСтруктурыОстатков,
	|	ВЫБОР
	|		КОГДА т.Субконто1 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(т.Субконто1, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА т.Субконто2 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(т.Субконто2, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА т.Субконто3 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(т.Субконто3, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК Субконто3,
	|	ВЫБОР
	|		КОГДА т.Субконто1 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА НЕ СчетаЗакрытия.Оборотное1
	|			ТОГДА ЕСТЬNULL(т.Субконто1, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СубконтоОстаток1,
	|	ВЫБОР
	|		КОГДА т.Субконто2 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА НЕ СчетаЗакрытия.Оборотное2
	|			ТОГДА ЕСТЬNULL(т.Субконто2, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СубконтоОстаток2,
	|	ВЫБОР
	|		КОГДА т.Субконто3 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА НЕ СчетаЗакрытия.Оборотное3
	|			ТОГДА ЕСТЬNULL(т.Субконто3, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СубконтоОстаток3,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ ОстаткиНаНачалоБезСтруктуры
	|ИЗ
	|	ЗначенияПоказателей КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаЗакрытия КАК СчетаЗакрытия
	|		ПО т.Счет = СчетаЗакрытия.Счет
	|ГДЕ
	|	НЕ т.ЭтоОборот
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	СубконтоОстаток1,
	|	СубконтоОстаток2,
	|	СубконтоОстаток3,
	|	Подразделение,
	|	НаправлениеДеятельности";

КонецФункции

Функция ТекстЗапроса_ОборотыТК(НомераТаблиц)
	
	НомераТаблиц.Вставить("КредитВидовДвижений",			НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДебетВидовДвижений", 			НомераТаблиц.Количество());
	НомераТаблиц.Вставить("БазыВидовДвижений",				НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОборотыДоОстатков",				НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОстаткиДляРаспределения",		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОборотыСчетов", 					НомераТаблиц.Количество());
	
	НомераТаблиц.Вставить("УНИЧТОЖИТЬ_КредитВидовДвижений",		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("УНИЧТОЖИТЬ_ДебетВидовДвижений",		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("УНИЧТОЖИТЬ_БазыВидовДвижений",		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("УНИЧТОЖИТЬ_ОборотыДоОстатков",		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("УНИЧТОЖИТЬ_ОстаткиДляРаспределения",	НомераТаблиц.Количество());
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.Значение КАК Значение,
	|	т.Организация КАК Организация,
	|	т.РазделМСФО КАК РазделМСФО,
	|	т.Счет КАК Счет,
	|	т.ТипСчетаЗакрытия КАК ТипСчетаЗакрытия,
	|	т.ВидДвижения КАК ВидДвижения,
	|	т.Регистратор КАК Регистратор,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	АВТОНОМЕРЗАПИСИ() КАК Номер
	|ПОМЕСТИТЬ КредитВидовДвижений
	|ИЗ
	|	ЗначенияПоказателей КАК т
	|ГДЕ
	|	НЕ т.ТипСчетаЗакрытия ЕСТЬ NULL
	|	И т.ЭтоОборот
	|	И НЕ т.ВидДвижения <> ЗНАЧЕНИЕ(Справочник.ВидыДвиженийМСФО.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Значение КАК Значение,
	|	т.Счет КАК Счет,
	|	т.ТипСчетаЗакрытия КАК ТипСчетаЗакрытия,
	|	т.ВидДвижения КАК ВидДвижения,
	|	т.Регистратор КАК Регистратор,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	АВТОНОМЕРЗАПИСИ() КАК Номер
	|ПОМЕСТИТЬ ДебетВидовДвижений
	|ИЗ
	|	ЗначенияПоказателей КАК т
	|ГДЕ
	|	т.ЭтоОборот
	|	И т.ВидДвижения В
	|			(ВЫБРАТЬ
	|				т.ВидДвижения
	|			ИЗ
	|				КредитВидовДвижений КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(т.Значение) КАК База,
	|	т.ВидДвижения КАК ВидДвижения,
	|	т.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ БазыВидовДвижений
	|ИЗ
	|	ДебетВидовДвижений КАК т
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ВидДвижения,
	|	т.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Кт.Регистратор КАК Регистратор,
	|	Кт.ВидДвижения КАК ВидДвижения,
	|	Кт.Организация КАК Организация,
	|	Кт.РазделМСФО КАК РазделМСФО,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(БазыДт.База, 0) <> 0
	|			ТОГДА ВЫРАЗИТЬ(Кт.Значение * Дт.Значение / БазыДт.База КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма,
	|	БазыДт.База КАК База,
	|	Дт.Счет КАК СчетДт,
	|	Дт.ТипСчетаЗакрытия КАК ТипСчетаЗакрытияДт,
	|	ВЫБОР
	|		КОГДА Дт.Субконто1 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(Дт.Субконто1, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК СубконтоДт1,
	|	ВЫБОР
	|		КОГДА Дт.Субконто2 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(Дт.Субконто2, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК СубконтоДт2,
	|	ВЫБОР
	|		КОГДА Дт.Субконто3 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(Дт.Субконто3, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК СубконтоДт3,
	|	Кт.Счет КАК СчетКт,
	|	Кт.ТипСчетаЗакрытия КАК ТипСчетаЗакрытияКт,
	|	ВЫБОР
	|		КОГДА Кт.Субконто1 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(Кт.Субконто1, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК СубконтоКт1,
	|	ВЫБОР
	|		КОГДА Кт.Субконто2 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(Кт.Субконто2, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК СубконтоКт2,
	|	ВЫБОР
	|		КОГДА Кт.Субконто3 В (&ПустыеТипы)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕСТЬNULL(Кт.Субконто3, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК СубконтоКт3,
	|	Кт.Номер КАК НомерКт,
	|	Кт.Номер КАК НомерДт
	|ПОМЕСТИТЬ ОборотыДоОстатков
	|ИЗ
	|	КредитВидовДвижений КАК Кт
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДебетВидовДвижений КАК Дт
	|		ПО (Дт.ВидДвижения = Кт.ВидДвижения)
	|			И (Дт.Регистратор = Кт.Регистратор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ БазыВидовДвижений КАК БазыДт
	|		ПО Кт.ВидДвижения = БазыДт.ВидДвижения
	|			И Кт.Регистратор = БазыДт.Регистратор
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерКт,
	|	НомерДт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотыДоОстатков.НомерКт КАК НомерКт,
	|	МАКСИМУМ(ОборотыДоОстатков.База) - СУММА(ОборотыДоОстатков.Сумма) КАК ОстатокДляРаспределения,
	|	МАКСИМУМ(ОборотыДоОстатков.НомерДт) КАК НомерДт
	|ПОМЕСТИТЬ ОстаткиДляРаспределения
	|ИЗ
	|	ОборотыДоОстатков КАК ОборотыДоОстатков
	|
	|СГРУППИРОВАТЬ ПО
	|	ОборотыДоОстатков.НомерКт
	|
	|ИМЕЮЩИЕ
	|	СУММА(ОборотыДоОстатков.Сумма) <> МАКСИМУМ(ОборотыДоОстатков.База)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерКт,
	|	НомерДт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотыДоОстатков.Организация КАК Организация,
	|	ОборотыДоОстатков.РазделМСФО КАК РазделМСФО,
	|	ОборотыДоОстатков.Сумма + ЕСТЬNULL(ОстаткиДляРаспределения.ОстатокДляРаспределения, 0) КАК Сумма,
	|	ОборотыДоОстатков.Сумма + ЕСТЬNULL(ОстаткиДляРаспределения.ОстатокДляРаспределения, 0) КАК СуммаВО,
	|	0 КАК КоличествоДт,
	|	0 КАК КоличествоКт,
	|	ОборотыДоОстатков.СчетДт КАК СчетДт,
	|	ОборотыДоОстатков.ТипСчетаЗакрытияДт КАК ТипСчетаЗакрытияДт,
	|	ОборотыДоОстатков.СубконтоДт1 КАК СубконтоДт1,
	|	ОборотыДоОстатков.СубконтоДт2 КАК СубконтоДт2,
	|	ОборотыДоОстатков.СубконтоДт3 КАК СубконтоДт3,
	|	ОборотыДоОстатков.СчетКт КАК СчетКт,
	|	ОборотыДоОстатков.ТипСчетаЗакрытияКт КАК ТипСчетаЗакрытияКт,
	|	ОборотыДоОстатков.СубконтоКт1 КАК СубконтоКт1,
	|	ОборотыДоОстатков.СубконтоКт2 КАК СубконтоКт2,
	|	ОборотыДоОстатков.СубконтоКт3 КАК СубконтоКт3,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ПодразделениеКт
	|ПОМЕСТИТЬ ОборотыСчетов
	|ИЗ
	|	ОборотыДоОстатков КАК ОборотыДоОстатков
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДляРаспределения КАК ОстаткиДляРаспределения
	|		ПО ОборотыДоОстатков.НомерКт = ОстаткиДляРаспределения.НомерКт
	|			И ОборотыДоОстатков.НомерДт = ОстаткиДляРаспределения.НомерДт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Организация,
	|	т.РазделМСФО,
	|	т.Значение,
	|	т.Значение,
	|	0,
	|	0,
	|	СчетСписания.Счет,
	|	NULL,
	|	СчетСписания.Субконто1,
	|	СчетСписания.Субконто2,
	|	СчетСписания.Субконто3,
	|	т.Счет,
	|	т.ТипСчетаЗакрытия,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|ИЗ
	|	ЗначенияПоказателей КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФиксированныеСчетаУчетаБД КАК СчетСписания
	|		ПО (СчетСписания.Ссылка = ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ТекущийФинансовыйРезультат))
	|ГДЕ
	|	НЕ т.ТипСчетаЗакрытия ЕСТЬ NULL
	|	И т.ЭтоОборот
	|	И т.ВидДвижения = ЗНАЧЕНИЕ(Справочник.ВидыДвиженийМСФО.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КредитВидовДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДебетВидовДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ БазыВидовДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОборотыДоОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОстаткиДляРаспределения";
	
	Возврат Документы.УчетнаяПолитикаМСФО.ЗаменитьФиксированныеСчетаУчетаБД(ТекстЗапроса);
	
КонецФункции

#КонецОбласти

#Область ОстаткиНаНачалоМСФО

Функция ТекстЗапроса_ОстаткиНаНачалоСтруктураСтоимости(НомераТаблиц)

	НомераТаблиц.Вставить("СтруктураСтоимости", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Организация КАК Организация,
	|	т.Счет КАК СчетИБ,
	|	т.Счет.СчетСсылка КАК СчетСсылка,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	ВЫБОР СчетаЗакрытия.НомерСубконтоАВНА
	|		КОГДА 1
	|			ТОГДА т.Субконто1
	|		КОГДА 2
	|			ТОГДА т.Субконто2
	|		КОГДА 3
	|			ТОГДА т.Субконто3
	|	КОНЕЦ КАК АВНА,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное1
	|			ТОГДА т.Субконто1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СубконтоОстаток1,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное2
	|			ТОГДА т.Субконто2
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СубконтоОстаток2,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное3
	|			ТОГДА т.Субконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СубконтоОстаток3,
	|	СчетаЗакрытия.ТипЗакрытия КАК ТипСчетаЗакрытия,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	т.СтатьяЗатрат КАК СтатьяЗатрат,
	|	т.ЭлементЗатрат КАК ЭлементЗатрат,
	|	т.Сумма КАК Сумма,
	|	т.СуммаВО КАК СуммаВО
	|ПОМЕСТИТЬ СтруктураСтоимости
	|ИЗ
	|	РегистрНакопления.СтруктураОстатковАктивовМСФО КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаЗакрытия КАК СчетаЗакрытия
	|		ПО т.Счет = СчетаЗакрытия.СчетИБ
	|			И (СчетаЗакрытия.СчетСтруктурыОстатков)
	|ГДЕ
	|	т.Регистратор В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				т.Ссылка
	|			ИЗ
	|				Документ.РасчетСебестоимости КАК т
	|			ГДЕ
	|				т.Проведен
	|				И т.Дата МЕЖДУ ВЫРАЗИТЬ(&ПредПериод КАК Справочник.Периоды).ДатаНачала И &НачалоПериода
	|				И т.Организация В (&ОрганизацииМПЗ)
	|				И т.Сценарий = &Сценарий
	|			УПОРЯДОЧИТЬ ПО
	|				т.Дата УБЫВ)
	|	И &ИспользоватьСтруктуруСтоимости
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетИБ,
	|	СубконтоОстаток1,
	|	СубконтоОстаток2,
	|	СубконтоОстаток3,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	Организация";

КонецФункции

Функция ТекстЗапроса_втБазаОстатков(НомераТаблиц)

	НомераТаблиц.Вставить("втБазаОстатков", НомераТаблиц.Количество());
	
	//1.Если (Структура < БезСтруктуры) И (БезСтруктуры <> 0)
	//(ожидаемый случай)-Структуру используем всю, БезСтруктуры используется часть исключая сумму структуры
	//2.Если (Структура > БезСтруктуры) И (БезСтруктуры <> 0) 
	//(остатки структуры частично списаны в МСФО) - Структуру используем всю, БезСтруктуры используется часть исключая сумму структуры
	//3.Если (Структура <> 0) И (БезСтруктуры = 0) 
	//(остатки структуры все списаны в МСФО)- Структуру не используем
	
	Возврат
	"ВЫБРАТЬ
	|	МАКСИМУМ(База.НомерОстаткаДляРаспределения) КАК НомерОстаткаДляНеточности,
	|	База.Организация КАК Организация,
	|	База.СчетСсылка КАК СчетСсылка,
	|	База.СубконтоОстаток1 КАК СубконтоОстаток1,
	|	База.СубконтоОстаток2 КАК СубконтоОстаток2,
	|	База.СубконтоОстаток3 КАК СубконтоОстаток3,
	|	База.Подразделение КАК Подразделение,
	|	База.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	СУММА(База.БезСтруктурыФВ) КАК БезСтруктурыФВ,
	|	СУММА(База.БезСтруктурыВО) КАК БезСтруктурыВО,
	|	СУММА(База.СтруктураФВ) КАК СтруктураФВ,
	|	СУММА(База.СтруктураВО) КАК СтруктураВО,
	|	ВЫБОР
	|		КОГДА СУММА(База.СтруктураФВ) <> 0
	|				И СУММА(База.БезСтруктурыФВ) <> 0
	|			ТОГДА СУММА(База.БезСтруктурыФВ) - СУММА(База.СтруктураФВ)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОстаетсяБезСтруктурыФВ,
	|	ВЫБОР
	|		КОГДА СУММА(База.СтруктураВО) <> 0
	|				И СУММА(База.БезСтруктурыВО) <> 0
	|			ТОГДА СУММА(База.БезСтруктурыВО) - СУММА(База.СтруктураВО)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОстаетсяБезСтруктурыВО,
	|	СУММА(База.СтруктураФВ) <> 0
	|		И СУММА(База.БезСтруктурыФВ) = 0 КАК СтруктураВсяСписанаФВ,
	|	СУММА(База.СтруктураВО) <> 0
	|		И СУММА(База.БезСтруктурыВО) = 0 КАК СтруктураВсяСписанаВО
	|ПОМЕСТИТЬ втБазаОстатков
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.НомерОстаткаДляРаспределения КАК НомерОстаткаДляРаспределения,
	|		т.Организация КАК Организация,
	|		т.Счет КАК СчетСсылка,
	|		т.СубконтоОстаток1 КАК СубконтоОстаток1,
	|		т.СубконтоОстаток2 КАК СубконтоОстаток2,
	|		т.СубконтоОстаток3 КАК СубконтоОстаток3,
	|		т.Подразделение КАК Подразделение,
	|		т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|		т.Сумма КАК БезСтруктурыФВ,
	|		т.СуммаВО КАК БезСтруктурыВО,
	|		0 КАК СтруктураФВ,
	|		0 КАК СтруктураВО
	|	ИЗ
	|		ОстаткиНаНачалоБезСтруктуры КАК т
	|	ГДЕ
	|		т.СчетСтруктурыОстатков
	|		И т.РазделМСФО
	|		И &ИспользоватьСтруктуруСтоимости
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		NULL,
	|		т.Организация,
	|		т.СчетСсылка,
	|		т.СубконтоОстаток1,
	|		т.СубконтоОстаток2,
	|		т.СубконтоОстаток3,
	|		т.Подразделение,
	|		т.НаправлениеДеятельности,
	|		0,
	|		0,
	|		т.Сумма,
	|		т.СуммаВО
	|	ИЗ
	|		СтруктураСтоимости КАК т) КАК База
	|
	|СГРУППИРОВАТЬ ПО
	|	База.СчетСсылка,
	|	База.СубконтоОстаток1,
	|	База.СубконтоОстаток2,
	|	База.СубконтоОстаток3,
	|	База.Подразделение,
	|	База.НаправлениеДеятельности,
	|	База.Организация
	|
	|ИМЕЮЩИЕ
	|	(СУММА(База.СтруктураФВ) <> 0
	|		ИЛИ СУММА(База.СтруктураВО) <> 0)";

КонецФункции

Функция ТекстЗапроса_втРаспределениеОстатковБезСтруктуры()
	
	Возврат
	"ВЫБРАТЬ
	|	т.НомерОстаткаДляРаспределения КАК НомерОстаткаДляРаспределения,
	|	База.НомерОстаткаДляНеточности КАК НомерОстаткаДляНеточности,
	|	т.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(База.БезСтруктурыФВ, 0) = 0
	|			ТОГДА т.Сумма
	|		ИНАЧЕ ВЫРАЗИТЬ(т.Сумма * База.ОстаетсяБезСтруктурыФВ / База.БезСтруктурыФВ КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК НовыйОстатокБезСтруктурыФВ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(База.БезСтруктурыВО, 0) = 0
	|			ТОГДА т.СуммаВО
	|		ИНАЧЕ ВЫРАЗИТЬ(т.СуммаВО * База.ОстаетсяБезСтруктурыВО / База.БезСтруктурыВО КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК НовыйОстатокБезСтруктурыВО,
	|	База.ОстаетсяБезСтруктурыФВ КАК ОстаетсяБезСтруктурыФВ,
	|	База.ОстаетсяБезСтруктурыВО КАК ОстаетсяБезСтруктурыВО
	|ПОМЕСТИТЬ втРаспределениеОстатковБезСтруктуры
	|ИЗ
	|	ОстаткиНаНачалоБезСтруктуры КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втБазаОстатков КАК База
	|		ПО т.Организация = База.Организация
	|			И т.Счет = База.СчетСсылка
	|			И т.СубконтоОстаток1 = База.СубконтоОстаток1
	|			И т.СубконтоОстаток2 = База.СубконтоОстаток2
	|			И т.СубконтоОстаток3 = База.СубконтоОстаток3
	|			И т.Подразделение = База.Подразделение
	|			И т.НаправлениеДеятельности = База.НаправлениеДеятельности";

КонецФункции

Процедура ДобавитьТекстыЗапросовОстаткиБезСтруктуры(ТекстЗапроса, НомераТаблиц, УничтожатьТаблицы = Истина)
	
	ПутиСумм = "НовыйОстатокБезСтруктурыФВ:ОстаетсяБезСтруктурыФВ;НовыйОстатокБезСтруктурыВО:ОстаетсяБезСтруктурыВО";
	
	НастройкиРаспределения = МСФОЗапросыУХ.НастройкиРаспределения(
			ТекстЗапроса_втРаспределениеОстатковБезСтруктуры(),
			"втРаспределениеОстатковБезСтруктуры",
			"НомерОстаткаДляРаспределения",
			ПутиСумм,
			"НомерОстаткаДляНеточности",
			УничтожатьТаблицы
		);
	
	МСФОЗапросыУХ.ДобавитьТекстыЗапросовРаспределений(
		ТекстЗапроса, НомераТаблиц, НастройкиРаспределения);

КонецПроцедуры

Функция ТекстЗапроса_ОстаткиНаНачало(НомераТаблиц)

	НомераТаблиц.Вставить("ОстаткиНаНачало", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	ОстаткиНаНачало.Организация КАК Организация,
	|	ОстаткиНаНачало.Сумма КАК Сумма,
	|	ОстаткиНаНачало.СуммаВО КАК СуммаВО,
	|	ОстаткиНаНачало.Количество КАК Количество,
	|	ОстаткиНаНачало.Счет КАК Счет,
	|	ОстаткиНаНачало.СчетИБ КАК СчетИБ,
	|	ОстаткиНаНачало.ТипСчетаЗакрытия КАК ТипСчетаЗакрытия,
	|	ОстаткиНаНачало.РазделМСФО КАК РазделМСФО,
	|	ОстаткиНаНачало.АВНА КАК АВНА,
	|	ОстаткиНаНачало.Субконто1 КАК Субконто1,
	|	ОстаткиНаНачало.Субконто2 КАК Субконто2,
	|	ОстаткиНаНачало.Субконто3 КАК Субконто3,
	|	ОстаткиНаНачало.Подразделение КАК Подразделение,
	|	ОстаткиНаНачало.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ОстаткиНаНачало.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ОстаткиНаНачало.ЭлементЗатрат КАК ЭлементЗатрат,
	|	ОстаткиНаНачало.ЭтоАналитикаОстатка КАК ЭтоАналитикаОстатка,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерОстатка
	|ПОМЕСТИТЬ ОстаткиНаНачало
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.Организация КАК Организация,
	|		ЕСТЬNULL(втРаспределениеОстатковБезСтруктуры.НовыйОстатокБезСтруктурыФВ, т.Сумма) КАК Сумма,
	|		ЕСТЬNULL(втРаспределениеОстатковБезСтруктуры.НовыйОстатокБезСтруктурыВО, т.СуммаВО) КАК СуммаВО,
	|		т.Количество КАК Количество,
	|		т.Счет КАК Счет,
	|		т.СчетИБ КАК СчетИБ,
	|		т.ТипСчетаЗакрытия КАК ТипСчетаЗакрытия,
	|		т.РазделМСФО КАК РазделМСФО,
	|		т.АВНА КАК АВНА,
	|		т.Субконто1 КАК Субконто1,
	|		т.Субконто2 КАК Субконто2,
	|		т.Субконто3 КАК Субконто3,
	|		т.Подразделение КАК Подразделение,
	|		т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|		ЛОЖЬ КАК ЭтоАналитикаОстатка,
	|		NULL КАК СтатьяЗатрат,
	|		NULL КАК ЭлементЗатрат
	|	ИЗ
	|		ОстаткиНаНачалоБезСтруктуры КАК т
	|			ЛЕВОЕ СОЕДИНЕНИЕ втРаспределениеОстатковБезСтруктуры КАК втРаспределениеОстатковБезСтруктуры
	|			ПО т.НомерОстаткаДляРаспределения = втРаспределениеОстатковБезСтруктуры.НомерОстаткаДляРаспределения
	|				И (т.РазделМСФО)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.Организация,
	|		т.Сумма,
	|		т.СуммаВО,
	|		0,
	|		т.СчетСсылка,
	|		т.СчетИБ,
	|		т.ТипСчетаЗакрытия,
	|		ИСТИНА,
	|		т.АВНА,
	|		т.Субконто1,
	|		т.Субконто2,
	|		т.Субконто3,
	|		т.Подразделение,
	|		т.НаправлениеДеятельности,
	|		ИСТИНА,
	|		т.СтатьяЗатрат,
	|		т.ЭлементЗатрат
	|	ИЗ
	|		СтруктураСтоимости КАК т) КАК ОстаткиНаНачало
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОстаткиНаНачало.АВНА,
	|	ОстаткиНаНачало.ТипСчетаЗакрытия";

КонецФункции

#КонецОбласти

