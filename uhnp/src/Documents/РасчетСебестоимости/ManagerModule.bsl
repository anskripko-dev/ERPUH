Функция ТекстЗапроса_СтруктураОстатковДоЗакрытия_Детали(НомераТаблиц)

	НомераТаблиц.Вставить("втСтруктураОстатковДоЗакрытия_Детали", НомераТаблиц.Количество());
	
	//СНД.сз1 = 100
	//СНД.сз2 = 200
	//ДО.сз3 = 300
	//ДО.сз1 = 400
	//КО.сз0 = 600
	
	//ДоляСписания = 0.6 = 600/(100+200+300+400)
	//СНД.сз1 = 60
	//СНД.сз2 = 120
	//ДО.сз3 = 180
	//ДО.сз1 = 240
	
	//
	
	Возврат
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ т.СтатьяЗатрат ЕСТЬ NULL
	|			ТОГДА т.СуммаСНД
	|		ИНАЧЕ 0
	|	КОНЕЦ + т.СуммаДО_МСФО - т.СуммаКО_МСФО КАК СуммаСКД,
	|	ВЫБОР
	|		КОГДА НЕ т.СтатьяЗатрат ЕСТЬ NULL
	|			ТОГДА т.СуммаСНДВО
	|		ИНАЧЕ 0
	|	КОНЕЦ + т.СуммаДОВО_МСФО - т.СуммаКОВО_МСФО КАК СуммаСКДВО,
	|	ВЫБОР
	|		КОГДА НЕ т.СтатьяЗатрат ЕСТЬ NULL
	|			ТОГДА т.СуммаСНД + т.СуммаДО_МСФО
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаПриход,
	|	ВЫБОР
	|		КОГДА НЕ т.СтатьяЗатрат ЕСТЬ NULL
	|			ТОГДА т.СуммаСНДВО + т.СуммаДОВО_МСФО
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаПриходВО,
	|	т.Узел КАК Узел,
	|	СчетаЗакрытия.СчетИБ КАК СчетИБ,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное1
	|			ТОГДА т.Субконто1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОстатокСубконто1,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное2
	|			ТОГДА т.Субконто2
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОстатокСубконто2,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное3
	|			ТОГДА т.Субконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОстатокСубконто3,
	|	т.СтатьяЗатрат КАК СтатьяЗатрат,
	|	т.ЭлементЗатрат КАК ЭлементЗатрат,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втСтруктураОстатковДоЗакрытия_Детали
	|ИЗ
	|	Узлы КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаЗакрытия КАК СчетаЗакрытия
	|		ПО т.Счет = СчетаЗакрытия.Счет
	|			И (СчетаЗакрытия.ТипЗакрытия В (""МПЗ"", ""НЗП""))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Сумма,
	|	т.СуммаВО,
	|	т.Сумма,
	|	т.СуммаВО,
	|	т.УзелСтруктурыОстатка,
	|	т.СчетИБ,
	|	т.Счет,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	т.ОстатокСубконто1,
	|	т.ОстатокСубконто2,
	|	т.ОстатокСубконто3,
	|	т.СтатьяЗатрат,
	|	т.ЭлементЗатрат,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности
	|ИЗ
	|	втУзлыМпзПоСтруктуреОстатков КАК т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РаспределенияПоступленийДоЗакрытия.Сумма,
	|	РаспределенияПоступленийДоЗакрытия.СуммаВО,
	|	РаспределенияПоступленийДоЗакрытия.Сумма,
	|	РаспределенияПоступленийДоЗакрытия.СуммаВО,
	|	т.Узел,
	|	СчетаЗакрытия.СчетИБ,
	|	т.Счет,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное1
	|			ТОГДА т.Субконто1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное2
	|			ТОГДА т.Субконто2
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное3
	|			ТОГДА т.Субконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(УзлыНачальные.СтатьяЗатрат = &СтатьяЗатратПоУмолчанию, ИСТИНА)
	|			ТОГДА т.СтатьяЗатрат
	|		ИНАЧЕ УзлыНачальные.СтатьяЗатрат
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(УзлыНачальные.ЭлементЗатрат = &ЭлементЗатратПоУмолчанию, ИСТИНА)
	|			ТОГДА т.ЭлементЗатрат
	|		ИНАЧЕ УзлыНачальные.ЭлементЗатрат
	|	КОНЕЦ,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности
	|ИЗ
	|	Узлы КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаЗакрытия КАК СчетаЗакрытия
	|		ПО т.Счет = СчетаЗакрытия.Счет
	|			И (СчетаЗакрытия.ТипЗакрытия В (""МПЗ"", ""НЗП""))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Распределения КАК РаспределенияПоступленийДоЗакрытия
	|			ЛЕВОЕ СОЕДИНЕНИЕ Узлы КАК УзлыНачальные
	|			ПО РаспределенияПоступленийДоЗакрытия.УзелНачальный = УзлыНачальные.Узел
	|		ПО т.Узел = РаспределенияПоступленийДоЗакрытия.УзелПриемник
	|ГДЕ
	|	(РаспределенияПоступленийДоЗакрытия.Сумма <> 0
	|			ИЛИ РаспределенияПоступленийДоЗакрытия.СуммаВО <> 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	-РаспределенияСписанийДоЗакрытия.Сумма,
	|	-РаспределенияСписанийДоЗакрытия.СуммаВО,
	|	0,
	|	0,
	|	т.Узел,
	|	СчетаЗакрытия.СчетИБ,
	|	т.Счет,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное1
	|			ТОГДА т.Субконто1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное2
	|			ТОГДА т.Субконто2
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ СчетаЗакрытия.Оборотное3
	|			ТОГДА т.Субконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности
	|ИЗ
	|	Узлы КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаЗакрытия КАК СчетаЗакрытия
	|		ПО т.Счет = СчетаЗакрытия.Счет
	|			И (СчетаЗакрытия.ТипЗакрытия В (""МПЗ"", ""НЗП""))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Распределения КАК РаспределенияСписанийДоЗакрытия
	|		ПО т.Узел = РаспределенияСписанийДоЗакрытия.УзелИсточник
	|ГДЕ
	|	(РаспределенияСписанийДоЗакрытия.Сумма <> 0
	|			ИЛИ РаспределенияСписанийДоЗакрытия.СуммаВО <> 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	ОстатокСубконто1,
	|	ОстатокСубконто2,
	|	ОстатокСубконто3";
	
КонецФункции

Функция ТекстЗапроса_СтруктураОстатковДоЗакрытия_БазаОстатков(НомераТаблиц)

	НомераТаблиц.Вставить("втСтруктураОстатковДоЗакрытия_БазаОстатков", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерОстаткаДоЗакрытияСальдо,
	|	СУММА(т.СуммаСКД) КАК СуммаСКД,
	|	СУММА(т.СуммаСКДВО) КАК СуммаСКДВО,
	|	СУММА(т.СуммаПриход) КАК СуммаПриход,
	|	СУММА(т.СуммаПриходВО) КАК СуммаПриходВО,
	|	МАКСИМУМ(т.СчетИБ) КАК СчетИБ,
	|	т.Счет КАК Счет,
	|	т.ОстатокСубконто1 КАК ОстатокСубконто1,
	|	т.ОстатокСубконто2 КАК ОстатокСубконто2,
	|	т.ОстатокСубконто3 КАК ОстатокСубконто3,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втСтруктураОстатковДоЗакрытия_БазаОстатков
	|ИЗ
	|	втСтруктураОстатковДоЗакрытия_Детали КАК т
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Счет,
	|	т.НаправлениеДеятельности,
	|	т.Подразделение,
	|	т.ОстатокСубконто1,
	|	т.ОстатокСубконто2,
	|	т.ОстатокСубконто3
	|
	|ИМЕЮЩИЕ
	|	(СУММА(т.СуммаСКД) <> 0
	|		ИЛИ СУММА(т.СуммаСКДВО) <> 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	ОстатокСубконто1,
	|	ОстатокСубконто2,
	|	ОстатокСубконто3";

КонецФункции

Функция ТекстЗапроса_СтруктураОстатковДоЗакрытия_Распределение(НомераТаблиц)

	НомераТаблиц.Вставить("втСтруктураОстатковДоЗакрытия_Распределение", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерРаспределенияОстатка,
	|	БазаОстатков.НомерОстаткаДоЗакрытияСальдо КАК НомерОстаткаДоЗакрытияСальдо,
	|	БазаОстатков.СуммаСКД КАК СуммаСКД,
	|	БазаОстатков.СуммаСКДВО КАК СуммаСКДВО,
	|	БазаОстатков.СуммаПриход КАК СуммаПриход,
	|	БазаОстатков.СуммаПриходВО КАК СуммаПриходВО,
	|	ВЫБОР
	|		КОГДА БазаОстатков.СуммаПриход <> 0
	|			ТОГДА (втУзлы.СуммаПриход) * БазаОстатков.СуммаСКД / БазаОстатков.СуммаПриход
	|		ИНАЧЕ втУзлы.СуммаПриход
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА БазаОстатков.СуммаПриходВО <> 0
	|			ТОГДА (втУзлы.СуммаПриходВО) * БазаОстатков.СуммаСКДВО / БазаОстатков.СуммаПриходВО
	|		ИНАЧЕ втУзлы.СуммаПриходВО
	|	КОНЕЦ КАК СуммаВО,
	|	БазаОстатков.СчетИБ КАК СчетИБ,
	|	втУзлы.Субконто1 КАК Субконто1,
	|	втУзлы.Субконто2 КАК Субконто2,
	|	втУзлы.Субконто3 КАК Субконто3,
	|	втУзлы.ЭлементЗатрат КАК ЭлементЗатрат,
	|	втУзлы.СтатьяЗатрат КАК СтатьяЗатрат,
	|	втУзлы.Подразделение КАК Подразделение,
	|	втУзлы.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втСтруктураОстатковДоЗакрытия_Распределение
	|ИЗ
	|	втСтруктураОстатковДоЗакрытия_Детали КАК втУзлы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСтруктураОстатковДоЗакрытия_БазаОстатков КАК БазаОстатков
	|		ПО втУзлы.Счет = БазаОстатков.Счет
	|			И втУзлы.Подразделение = БазаОстатков.Подразделение
	|			И втУзлы.НаправлениеДеятельности = БазаОстатков.НаправлениеДеятельности
	|			И втУзлы.ОстатокСубконто1 = БазаОстатков.ОстатокСубконто1
	|			И втУзлы.ОстатокСубконто2 = БазаОстатков.ОстатокСубконто2
	|			И втУзлы.ОстатокСубконто3 = БазаОстатков.ОстатокСубконто3
	|ГДЕ
	|	(БазаОстатков.СуммаСКД <> 0
	|			ИЛИ БазаОстатков.СуммаСКДВО <> 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерРаспределенияОстатка,
	|	НомерОстаткаДоЗакрытияСальдо";

КонецФункции

Функция ТекстЗапроса_СтруктураСтоимостиЗапасов(НомераТаблиц)
	
	НомераТаблиц.Вставить("ТаблицаСтруктураСтоимости", НомераТаблиц.Количество());
	
	//СНД по структуре ГП: стрСНД.сз1=35, стрСНД.сз2=15
	//по РБ: СНД = 90, ДО.сз3=8, ДО.сз4=2, КО=20
	//
	//тогда (списываем пропорционально):
	//БазаПоступлений = СНД+ДО.сз3+ДО.сз4 = 90+8+2=100
	//стрСНД.сз0(пустая статья затрат) = 90-35-15=40
	//КО.сз0 = стрСНД.сз0 * КО / БазаПоступлений = 40 * 20 / 100 = 8
	//КО.сз1 = стрСНД.сз1 * КО / БазаПоступлений = 35 * 20 / 100 = 7
	//КО.сз2 = стрСНД.сз2 * КО / БазаПоступлений = 15 * 20 / 100 = 3
	//КО.сз3 = ДО.сз3     * КО / БазаПоступлений =  8 * 20 / 100 = 1.6
	//КО.сз4 = ДО.сз4     * КО / БазаПоступлений =  2 * 20 / 100 = 0.4
	
	Возврат
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Организация КАК Организация,
	|	&Сценарий КАК Сценарий,
	|	СУММА(Распределение.Сумма) КАК Сумма,
	|	СУММА(Распределение.СуммаВО) КАК СуммаВО,
	|	УзлыПриемники.СчетИБ КАК Счет,
	|	УзлыПриемники.Субконто1 КАК Субконто1,
	|	УзлыПриемники.Субконто2 КАК Субконто2,
	|	УзлыПриемники.Субконто3 КАК Субконто3,
	|	УзлыПриемники.Подразделение КАК Подразделение,
	|	УзлыПриемники.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	УзлыНачальные.СтатьяЗатрат КАК СтатьяЗатрат,
	|	УзлыНачальные.ЭлементЗатрат КАК ЭлементЗатрат
	|ИЗ
	|	Распределения КАК Распределение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втУзлыИндексПоУзел КАК УзлыПриемники
	|		ПО Распределение.УзелПриемник = УзлыПриемники.Узел
	|			И (НЕ УзлыПриемники.ТипСчетаЗакрытия ЕСТЬ NULL)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втУзлыИндексПоУзел КАК УзлыНачальные
	|		ПО Распределение.УзелНачальный = УзлыНачальные.Узел
	|			И (НЕ УзлыНачальные.СтатьяЗатрат ЕСТЬ NULL)
	|ГДЕ
	|	&ИспользоватьСтруктуруСтоимости
	|	И ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	УзлыНачальные.ЭлементЗатрат,
	|	УзлыНачальные.СтатьяЗатрат,
	|	УзлыПриемники.НаправлениеДеятельности,
	|	УзлыПриемники.Подразделение,
	|	УзлыПриемники.Субконто3,
	|	УзлыПриемники.Субконто2,
	|	УзлыПриемники.Субконто1,
	|	УзлыПриемники.СчетИБ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	&Организация,
	|	&Сценарий,
	|	т.Сумма,
	|	т.СуммаВО,
	|	т.СчетИБ,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности,
	|	т.СтатьяЗатрат,
	|	т.ЭлементЗатрат
	|ИЗ
	|	втСтруктураОстатковДоЗакрытия_Распределение КАК т
	|ГДЕ
	|	(т.Сумма <> 0
	|			ИЛИ т.СуммаВО <> 0)";

