#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Проведение

//Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896 новые механизмы проведения документов
// Описывает учетные механизмы используемые в документе для регистрации в механизме проведения.
//
// Параметры:
//  МеханизмыДокумента - Массив - список имен учетных механизмов, для которых будет выполнена
//              регистрация в механизме проведения.
//
Процедура ЗарегистрироватьУчетныеМеханизмы(МеханизмыДокумента) Экспорт
	
	МеханизмыДокумента.Добавить("УчетДоходовРасходов");    
	МеханизмыДокумента.Добавить("УчетПрочихАктивовПассивов"); 
	
КонецПроцедуры

//Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896 новые механизмы проведения документов
// Возвращает таблицы для движений, необходимые для проведения документа по регистрам учетных механизмов.
//
// Параметры:
//  Документ - ДокументСсылка - ссылка на документ, по которому необходимо получить данные
//  Регистры - Структура - список имен регистров, для которых необходимо получить таблицы
//  ДопПараметры - Структура - дополнительные параметры для получения данных, определяющие контекст проведения.
//
// Возвращаемое значение:
//  Структура - коллекция элементов:
//     * Таблица<ИмяРегистра> - ТаблицаЗначений - таблица данных для отражения в регистр.
//
Функция ДанныеДокументаДляПроведения(Документ, Регистры, ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = ПроведениеДокументов.ДопПараметрыИнициализироватьДанныеДокументаДляПроведения();
	КонецЕсли;
	
	// НАЧАЛО Николаев Павел 29.03.2024 Выполнение задач №000049053
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.тн_СписаниеСтоимостиТоваровНаЗатраты") Тогда
		ДокументСсылка = Документ.Ссылка;
	Иначе
		ДокументСсылка = Документ;
	КонецЕсли;
	// КОНЕЦ Николаев Павел 29.03.2024 Выполнение задач №000049053

	Запрос			= Новый Запрос;
	ТекстыЗапроса	= Новый СписокЗначений;
	
	Если Не ДопПараметры.ПолучитьТекстыЗапроса Тогда
		////////////////////////////////////////////////////////////////////////////
		// Создадим запрос инициализации движений
		
		// НАЧАЛО Николаев Павел 29.03.2024 Выполнение задач №000049053
		//ЗаполнитьПараметрыИнициализации(Запрос, Документ);
		ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
		// КОНЕЦ Николаев Павел 29.03.2024 Выполнение задач №000049053	
		
		////////////////////////////////////////////////////////////////////////////
		// Сформируем текст запроса
		
		  ТекстЗапросаВтСебестоимость(Запрос, ТекстыЗапроса);
		  ТекстЗапросаТаблицаПрочиеРасходы(Запрос, ТекстыЗапроса, Регистры);
	      ТекстЗапросаТаблицаПрочиеАктивыПассивы(Запрос, ТекстыЗапроса, Регистры);

	
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////
	// Получим таблицы для движений
	
	Возврат ПроведениеДокументов.ИнициализироватьДанныеДокументаДляПроведения(Запрос, ТекстыЗапроса, ДопПараметры);
	
КонецФункции

// Хоменко Вадим 14.07.2021 Выполнение задач №000038464
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт

	// Создание запроса инициализации движений и заполенение его параметров.
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);

	// Формирование текста запроса.
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицаПрочиеРасходы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаПрочиеАктивыПассивы(Запрос, ТекстыЗапроса, Регистры);
	
	// НАЧАЛО Николаев Павел 08.11.2024 Выполнение задач №000051555
	//ИнтеграцияЕГАИС.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
    ИнтеграцияИС.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
    // КОНЕЦ Николаев Павел 08.11.2024 Выполнение задач №000051555
КонецПроцедуры

// Хоменко Вадим 14.07.2021 Выполнение задач №000038464
Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)

	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	Запрос.Текст = "
	|ВЫБРАТЬ
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Дата КАК Период,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Номер КАК Номер,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Организация КАК Организация,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Склад КАК Склад,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Ссылка КАК Ссылка,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(тн_СписаниеСтоимостиТоваровНаЗатраты.Подразделение.ВариантОбособленногоУчетаТоваров, ЗНАЧЕНИЕ(Перечисление.ВариантыОбособленногоУчетаТоваров.ПустаяСсылка)) КАК ВариантОбособленногоУчетаТоваров,
	|	ВЫБОР
	|		КОГДА тн_СписаниеСтоимостиТоваровНаЗатраты.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке
	|				И тн_СписаниеСтоимостиТоваровНаЗатраты.Дата >= тн_СписаниеСтоимостиТоваровНаЗатраты.Склад.ДатаНачалаОрдернойСхемыПриОтгрузке
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОрдернаяСхемаПриОтгрузке,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Комментарий КАК Комментарий,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.ПометкаУдаления КАК ПометкаУдаления,
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Проведен КАК Проведен
	|ИЗ
	|	Документ.тн_СписаниеСтоимостиТоваровНаЗатраты КАК тн_СписаниеСтоимостиТоваровНаЗатраты
	|ГДЕ
	|	тн_СписаниеСтоимостиТоваровНаЗатраты.Ссылка = &Ссылка";

	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();

	// НАЧАЛО Белоконенко Денис 16.03.2023 Выполнение задач №000044793
	Запрос.УстановитьПараметр("ДатаНачало",                       НачалоМесяца(Реквизиты.Период));
	Запрос.УстановитьПараметр("ДатаКонец",                        Новый Граница(КонецМесяца(Реквизиты.Период), ВидГраницы.Включая));
	// КОНЕЦ  Белоконенко Денис 16.03.2023 Выполнение задач №000044793
	Запрос.УстановитьПараметр("Склад",                            Реквизиты.Склад);
	Запрос.УстановитьПараметр("Период",                           Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",                      Реквизиты.Организация);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",            Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию);
	Запрос.УстановитьПараметр("ОрдернаяСхемаПриОтгрузке",         Реквизиты.ОрдернаяСхемаПриОтгрузке);
	Запрос.УстановитьПараметр("ТипЗаписи",                           Перечисления.ТипыЗаписейПартий.Потребление);
	Запрос.УстановитьПараметр("ВариантОбособленногоУчетаТоваров", Реквизиты.ВариантОбособленногоУчетаТоваров);
	Запрос.УстановитьПараметр("Подразделение",                    Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("Валюта",                           Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("ФормироватьВидыЗапасовПоГруппамФинансовогоУчета", ПолучитьФункциональнуюОпцию("ФормироватьВидыЗапасовПоГруппамФинансовогоУчета"));
	Запрос.УстановитьПараметр("ПустойКлючСвязи",                  Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.УстановитьПараметр("ПустаяСерия",                      Справочники.СерииНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустоеНазначение",                 Справочники.Назначения.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("СкладскаяОперация", Перечисления.СкладскиеОперации.ОтгрузкаНаВнутренниеНужды);
	
	Запрос.УстановитьПараметр("Номер",                            Реквизиты.Номер);
	Запрос.УстановитьПараметр("Комментарий",                      Реквизиты.Комментарий);
	Запрос.УстановитьПараметр("ПометкаУдаления",                  Реквизиты.ПометкаУдаления);
	Запрос.УстановитьПараметр("Проведен",                         Реквизиты.Проведен);
	
	Запрос.УстановитьПараметр("ПодразделениеДляОтгрузкиРекламы",  Константы.тн_ПодразделениеДляОтгрузкиРекламы.Получить());
	Запрос.УстановитьПараметр("СтатьяРасходовДляОтгрузкиРекламы", Константы.тн_СтатьяРасходовДляОтгрузкиРекламы.Получить());
	
	Запрос.УстановитьПараметр("УправленческаяОрганизация",	 	  Справочники.Организации.УправленческаяОрганизация);
			
КонецПроцедуры

// Хоменко Вадим 14.07.2021 Выполнение задач №000038464
Функция ТекстЗапросаВтСебестоимость(Запрос, ТекстыЗапроса)
	
	ИмяРегистра = "ВтСебестоимость";
	
	ТекстЗапроса = "
	// НАЧАЛО Белоконенко Денис 16.03.2023 Выполнение задач №000044793
	// Изменяем запрос по оборотам
	|ВЫБРАТЬ
	|	СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	СебестоимостьТоваровОстатки.Организация КАК Организация,
	|	СебестоимостьТоваровОстатки.РазделУчета КАК РазделУчета,
	|	СебестоимостьТоваровОстатки.ВидЗапасов КАК ВидЗапасов,
	|	СебестоимостьТоваровОстатки.ВидЗапасов КАК КорВидЗапасов,
	|	СебестоимостьТоваровОстатки.Организация КАК КорОрганизация,
	|	СебестоимостьТоваровОстатки.Партия КАК Партия,
	|	СебестоимостьТоваровОстатки.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	СебестоимостьТоваровОстатки.АналитикаФинансовогоУчета КАК АналитикаФинансовогоУчета,
	|	СебестоимостьТоваровОстатки.ВидДеятельностиНДС КАК ВидДеятельностиНДС,
	|	СебестоимостьТоваровОстатки.СтоимостьОстаток КАК Стоимость,
	|	СебестоимостьТоваровОстатки.СтоимостьБезНДСОстаток КАК СтоимостьБезНДС,
	|	СебестоимостьТоваровОстатки.ВидДеятельностиНДС КАК КорВидДеятельностиНДС,
	|	СебестоимостьТоваровОстатки.СтоимостьУпрОстаток КАК СтоимостьУпр,
	|	СебестоимостьТоваровОстатки.СтоимостьРеглОстаток КАК СтоимостьРегл
	|ПОМЕСТИТЬ ВтСебестоимость
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И АналитикаУчетаНоменклатуры.МестоХранения = &Склад) КАК СебестоимостьТоваровОстатки
	|ГДЕ
	|	СебестоимостьТоваровОстатки.СтоимостьОстаток > 0
	|	И СебестоимостьТоваровОстатки.СтоимостьБезНДСОстаток > 0";  
	// КОНЕЦ Белоконенко Денис 16.03.2023 Выполнение задач №000044793
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Хоменко Вадим 14.07.2021 Выполнение задач №000038464
Функция ТекстЗапросаТаблицаПрочиеРасходы(Запрос, ТекстыЗапроса, Регистры) Экспорт
	
