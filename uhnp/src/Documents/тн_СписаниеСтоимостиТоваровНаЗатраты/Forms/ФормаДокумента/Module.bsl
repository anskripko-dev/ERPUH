//Сафиуллина З.Р. 06.02.2026 Выполнение задач №000056369
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНеобходимоПерезаполнитьТовары(Форма, ВидимостьЭлементов) 
	
	Форма.Элементы.ГруппаНеобходимоПерезаполнитьТовары.Видимость = ВидимостьЭлементов;
	
КонецПроцедуры 

//Сафиуллина З.Р. 06.02.2026 Выполнение задач №000056369
//
&НаКлиенте
Процедура ПроверитьНеобходимостьПерезаполненияТоваров(Отказ, ПараметрыЗаписи)
	
	Если НеобходимоПерезаполнитьТовары Тогда
		Отказ = Истина;
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
		ДополнительныеПараметры.Вставить("ЭтотОбъект", ЭтотОбъект);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПерезаполнитьТоварыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, "Необходимо перезаполнить табличную часть ""Товары"" в соответствии со складами-исключениями. Перезаполнить?",
			РежимДиалогаВопрос.ДаНет);
	КонецЕсли; 
	
КонецПроцедуры	

//Сафиуллина З.Р. 06.02.2026 Выполнение задач №000056369
//
&НаКлиенте
Процедура ПослеЗакрытияВопросаПерезаполнитьТоварыЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Отказ = Ложь;
	Если Результат = КодВозвратаДиалога.Да Тогда   
       ЗаполнитьНаСервере();
	КонецЕсли; 
	
	ДополнительныеПараметры.Вставить("Отказ", Отказ);
	ОбщегоНазначенияУТКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ДополнительныеПараметры.ПараметрыЗаписи,, Истина);
	
КонецПроцедуры  

