#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеСерверУХ.ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	ИспользоватьРезервирование = КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования();
	
	СуммаДокумента = Планы.Итог("Сумма") + ?(ИспользоватьРезервирование, Планы.Итог("СуммаРезерв"), 0);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	ДокументОснование = ДанныеЗаполнения;
	ТипИсточника = ТипЗнч(ДанныеЗаполнения); 

	// Документы исключения, заполняются при создании на сервере
	ДокументыИсключения = Новый Массив;
    ДокументыИсключения.Добавить(Тип("ДокументСсылка.ВерсияСоглашенияКоммерческийДоговор"));
	ДокументыИсключения.Добавить(Тип("ДокументСсылка.ВерсияСоглашенияКредит"));
	ДокументыИсключения.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	
	Если Не ДокументыИсключения.Найти(ТипИсточника) = Неопределено Тогда
		
		Если ДокументОснование.Проведен Тогда  	
			ШаблонСообщения = НСтр("ru = 'Для ввода документа ""%1"" следует отменить проведение документа: %2'"); 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
							Метаданные.Документы.ЗаявкаНаКорректировкуПланов, ДокументОснование); 
	
			ВызватьИсключение ТекстСообщения;	
		КонецЕсли;

		Возврат;
	КонецЕсли;    
	
	Если ТипИсточника <> Тип("Структура") Тогда
		Источник = ДанныеЗаполнения;
		ДанныеЗаполнения = Новый Структура;
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("Ответственный", Пользователи.ТекущийПользователь());
                                   
	Если Не ДанныеЗаполнения.Свойство("ВидБюджета") Тогда
		Если ЗначениеЗаполнено(ВидБюджета) Тогда
			ДанныеЗаполнения.Вставить("ВидБюджета", ВидБюджета);
		Иначе 
			Если ТипИсточника = Тип("ДокументСсылка.ЗаявкаНаРасход") Тогда
				ДанныеЗаполнения.Вставить("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
			ИначеЕсли ТипИсточника = Тип("ДокументСсылка.Резервирование") Тогда
				ДанныеЗаполнения.Вставить("ВидБюджета", Источник.ВидБюджета);
			Иначе
				ДанныеЗаполнения.Вставить("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
	
	Если КонтрольЛимитовУХ.ЭтоЗакупочныйДокумент(Источник) Тогда
		ВидБюджета = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Источник.Дата);      
		ДанныеЗаполнения.Вставить("ВидБюджета", ВидБюджета);   
	КонецЕсли;

	ТипыВерсииСоглашений = Метаданные.ОпределяемыеТипы.ВерсияСоглашения.Тип;
	ТипыОбъектовПланирования = Метаданные.Документы.КорректировкаПланов.Реквизиты.ДокументОснование.Тип;
	ТипыДоговоров = Метаданные.ОпределяемыеТипы.Договор.Тип;
	
	Если ТипыДоговоров.СодержитТип(ТипИсточника) 
		И Не ТипИсточника = ТипЗнч(Неопределено) Тогда
		ВерсияСоглашения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ВерсияСоглашения");
		ДанныеЗаполнения.Вставить("ДокументОснование", ВерсияСоглашения);
		Документы.ЗаявкаНаКорректировкуПланов.ЗаполнитьПоДокументуПланирования(ЭтотОбъект, 
														ВерсияСоглашения, ДанныеЗаполнения);
	ИначеЕсли ТипыОбъектовПланирования.СодержитТип(ТипИсточника) Тогда   
		
		Если ЗначениеЗаполнено(Источник) И Источник.Проведен Тогда  	
			ШаблонСообщения = НСтр("ru = 'Для ввода документа ""%1"" следует отменить проведение документа: %2'"); 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
							Метаданные.Документы.ЗаявкаНаКорректировкуПланов, Источник); 
	
			ВызватьИсключение ТекстСообщения;	
		КонецЕсли;

		ДанныеЗаполнения.Вставить("ДокументОснование", Источник);
		Документы.ЗаявкаНаКорректировкуПланов.ЗаполнитьПоДокументуПланирования(ЭтотОбъект, Источник, ДанныеЗаполнения);
	ИначеЕсли ТипыВерсииСоглашений.СодержитТип(ТипИсточника) Тогда
		ДанныеЗаполнения.Вставить("ДокументОснование", Источник.ДоговорКонтрагента);
		Документы.ЗаявкаНаКорректировкуПланов.ЗаполнитьПоДокументуПланирования(ЭтотОбъект, Источник, ДанныеЗаполнения);
	ИначеЕсли ТипИсточника = Тип("Структура") И ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
		Документы.ЗаявкаНаКорректировкуПланов.ЗаполнитьПоДокументуПланирования(ЭтотОбъект, 
												ДанныеЗаполнения.ДокументОснование, ДанныеЗаполнения);
	ИначеЕсли ДанныеЗаполнения.Свойство("ПланыПоБюджетам") Тогда
		Для Каждого Строка Из ДанныеЗаполнения.ПланыПоБюджетам Цикл
			ПланыНоваяСтрока = Планы.Добавить();
			ПланыНоваяСтрока.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
			ЗаполнитьЗначенияСвойств(ПланыНоваяСтрока, Строка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	МассивНепроверяемыхРеквизитов.Добавить("Планы.Сумма");
	МассивНепроверяемыхРеквизитов.Добавить("Планы.СуммаРезерв");  
	
	Для Каждого СтрокаТаблицы Из Планы Цикл   	
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Сумма) 
			И Не ЗначениеЗаполнено(СтрокаТаблицы.СуммаРезерв) Тогда
			
			ШаблонСообщения = Нстр("ru='Не заполнена одна из колонок ""%1""/""%2"" в строке %3 списка ""%4""'"); 
			ТекстСообщения = СтрШаблон(ШаблонСообщения, "Лимит", "Резерв", СтрокаТаблицы.НомерСтроки, "Планы");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);   
			
		КонецЕсли;      	
		
	КонецЦикла; 
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
			
КонецПроцедуры 

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	МСФОУХ.ПроверитьРучныеКорректировкиДокумента(Ссылка, Отказ);
	
	КонтрольЛимитовУХ.ПроверитьИзменениеУчетнойПолитикиПланированиеЗакупок(ЭтотОбъект, ДокументОснование, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Инициализация дополнительных свойств для проведения документа	
	ПроведениеСерверУХ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, 
											ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ЗаявкаНаКорректировкуПланов.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСерверУХ.ПодготовитьНаборыЗаписейКПроведению(ЭтотОбъект);	
	
	// Движения по регистра	
	ПланированиеПотребностей.ОтразитьОперацииБюджетов(ДополнительныеСвойства, Движения, Отказ);
	
	ОтправитьНаСогласованиеПриПроведенииДокумента(Отказ);
	
КонецПроцедуры  

Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеСерверУХ.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);	
	
	МодульУправленияПроцессамиУХ.ОтменитьСогласованиеПриОтменеПроведения(Ссылка); 
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Ответственный = Пользователи.ТекущийПользователь(); 
	
КонецПроцедуры

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьНаСогласованиеПриПроведенииДокумента(Отказ)
	
	Если Отказ Тогда    
		Возврат;
	КонецЕсли;
	
	ТекСостояние = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(Ссылка);
	СостоянияПроведения = Новый Массив;
	СостоянияПроведения.Добавить(Перечисления.СостоянияСогласования.Утверждена);
	СостоянияПроведения.Добавить(Перечисления.СостоянияСогласования.НаУтверждении);
	СостоянияПроведения.Добавить(Перечисления.СостоянияСогласования.Отклонена);
	
	Если СостоянияПроведения.Найти(ТекСостояние) = Неопределено Тогда
		ТекСостояние = Перечисления.СостоянияСогласования.Утверждена;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ТекущееСостояниеСогласования", ТекСостояние);
	
	МодульУправленияПроцессамиУХ.ОтправитьНаСогласованиеПриПроведенииДокумента(ЭтотОбъект, Отказ);
	
КонецПроцедуры  

#КонецОбласти  
                   
#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли