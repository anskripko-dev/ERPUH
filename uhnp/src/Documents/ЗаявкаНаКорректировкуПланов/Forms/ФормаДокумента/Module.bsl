&НаСервере
Процедура УстановитьУсловноеОформление()
	
	#Область ПериодыПланирования
	
    // Планы 
	ЭлементУО = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ПланыНачалоПериода.Имя);
	
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Планы.НачалоПериода");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", 
		Новый ПолеКомпоновкиДанных("Объект.Планы.ПредставлениеПериода"));
	
	#КонецОбласти  
	
	// Лимит, Резерв
	ЭлементУО = УсловноеОформление.Элементы.Добавить();	    
	
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПланыСумма");
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПланыСуммаРезерв");
	
	ГруппаОтбора = ФормыУХ.НоваяГруппаИ(ЭлементУО.Отбор);
	
	ФормыУХ.НовыйОтбор(ГруппаОтбора, "Объект.Планы.Сумма", , , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ФормыУХ.НовыйОтбор(ГруппаОтбора, "Объект.Планы.СуммаРезерв", , , ВидСравненияКомпоновкиДанных.НеЗаполнено);    
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);    
	
КонецПроцедуры

