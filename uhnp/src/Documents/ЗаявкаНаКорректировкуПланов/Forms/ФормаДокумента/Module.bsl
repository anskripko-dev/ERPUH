&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	//
	УстановитьСостояниеДокумента();

	// Данные для создания полей Аналитика* для элементов Статьи бюджетов
	АСБ = АналитикиСтатейБюджетовУХ;
	
	МассивОписанийСтатей = Новый Массив;
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТабличнойЧастиВТаблицеФормы(МассивОписанийСтатей, 
		"Планы",  "Планы",
		"СтатьяБюджета", "ПланыСтатьяБюджета",
		"Аналитика%1", "ПланыАналитика%1",
		ФормыУХ.РазместитьВГруппе("ПланыГруппаАналитикаСтатейБюджета"));
	
	// Создать элементы формы для статей бюджетов и их аналитик
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтотОбъект, МассивОписанийСтатей);

	// Управление элементами формы 
	УправлениеЭлементамиФормы.ПриЧтенииСозданииНаСервере(ЭтотОбъект);
	
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйПериод", "НачалоПериода, ПланыНачалоПериода");
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйЦФО", "ЦФО, ПланыЦФО");  
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйПроект", "Проект, ПланыПроект");
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдинаяВалюта", "Валюта, ПланыВалюта"); 
	КонтрольЛимитовФормы.ДобавитьЗависимостьПолей(ЭтаФорма, "ЕдиныйПриходРасход", "ПриходРасход, ПланыПриходРасход");
		
	КонтрольЛимитовФормы.ОпределитьЕдиныеРеквизитыФормыКорректировкиЛимитов(ЭтаФорма, "Планы");
	
	КонтрольЛимитовФормыКлиентСервер.НастроитьЗависимыеЭлементыФормы(ЭтаФорма); 
	
	ОбновитьПредставлениеПериодовПланирования();  
	
	// Контроль документа	
	КонтрольУХ.ПодготовитьФормунаСервере(ЭтотОбъект, Элементы.Страницы);
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	УказаноОснование = ЗначениеЗаполнено(Объект.ДокументОснование);

	Элементы.ЗаполнитьПоОснованию.Видимость = УказаноОснование;  
	
	Элементы.Планы.КоманднаяПанель.ПодчиненныеЭлементы.ПланыДобавить.Видимость     = Не УказаноОснование;   
	Элементы.Планы.КоманднаяПанель.ПодчиненныеЭлементы.ПланыСкопировать.Видимость  = Не УказаноОснование;   
	
	Элементы.Планы.КонтекстноеМеню.ПодчиненныеЭлементы.ПланыКонтекстноеМенюДобавить.Видимость 	 = Не УказаноОснование;   
	Элементы.Планы.КонтекстноеМеню.ПодчиненныеЭлементы.ПланыКонтекстноеМенюСкопировать.Видимость = Не УказаноОснование;   
	
	Элементы.ПланыСумма.ТолькоПросмотр = УказаноОснование;
	Элементы.ПланыСуммаРезерв.ТолькоПросмотр = УказаноОснование; 
	Элементы.ПланыСтатьяБюджета.ТолькоПросмотр = УказаноОснование; 
	
	Элементы.ГруппаЗаполнениеТаблицы.ТолькоПросмотр = УказаноОснование;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСпособаОпределенияВалютыЛимитирования()
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуПланированияНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли; 
	
	Модифицированность = Истина;
	
	Документы.ЗаявкаНаКорректировкуПланов.ЗаполнитьПоДокументуПланирования(Объект, Объект.ДокументОснование, Объект);
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект); 
	ОбновитьПредставлениеПериодовПланирования();    
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ПланыАналитикаПриИзменении(Элемент)
	
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииАналитикиСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
	СтрокаТабличнойЧасти = Элементы.Планы.ТекущиеДанные;
	ОбновитьСвободныйОстаток(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеПериодовПланирования()

	Периодичность = ПолучитьПериодичностьПланирования(Объект.ВидБюджета, НачалоПериода);   
	
	ПредставлениеПериода = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
		НачалоПериода, Периодичность);  
		
	Для Каждого Строка Из Объект.Планы Цикл  
		Строка.Периодичность = ПолучитьПериодичностьПланирования(Объект.ВидБюджета, Строка.НачалоПериода);
		Строка.ПредставлениеПериода = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
			Строка.НачалоПериода, Строка.Периодичность);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеПериодаСтроки(Строка, ВидБюджета)
	
	Строка.Периодичность = ПолучитьПериодичностьПланирования(ВидБюджета, Строка.НачалоПериода);

	Строка.ПредставлениеПериода = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
		Строка.НачалоПериода, Строка.Периодичность);    
	
КонецПроцедуры  
	
&НаСервереБезКонтекста
Функция ПолучитьПериодичностьПланирования(ВидБюджета, НачалоПериода)
	
	ПараметрыПланирования = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ВидБюджета, НачалоПериода);
	
	Возврат ПараметрыПланирования.ПериодичностьЛимитирования;   
	
КонецФункции

#Область ПереопределяемыеСобытияЭлементовДляКонтроляДокумента

&НаКлиенте
Процедура ПриОжиданииВыполнитьКонтрольДокумента()
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьКонтрольДокумента", 0.5, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКонтрольДокумента()
	КонтрольУХКлиентСервер.ВыполнитьИнтерактивныйКонтроль(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаКонтроляДокументаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТД =  Элемент.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	КонтрольУХКлиент.ПоказатьРасшифровкуКонтроля(Объект, ТД);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаКонтроляДокументаПриАктивизацииЯчейки(Элемент)
	Элемент.ТекущаяСтрока = Неопределено;
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьСвободныйОстаток(СтрокаТабличнойЧасти)   
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НачалоПериода", СтрокаТабличнойЧасти.НачалоПериода);
	СтруктураПараметров.Вставить("Периодичность", СтрокаТабличнойЧасти.Периодичность);
	СтруктураПараметров.Вставить("ЦФО", СтрокаТабличнойЧасти.ЦФО);
	СтруктураПараметров.Вставить("Проект", СтрокаТабличнойЧасти.Проект);
	СтруктураПараметров.Вставить("СтатьяБюджета", СтрокаТабличнойЧасти.СтатьяБюджета);
	СтруктураПараметров.Вставить("Аналитика1", СтрокаТабличнойЧасти.Аналитика1);  
	СтруктураПараметров.Вставить("Аналитика2", СтрокаТабличнойЧасти.Аналитика2);
	СтруктураПараметров.Вставить("Аналитика3", СтрокаТабличнойЧасти.Аналитика3);
	СтруктураПараметров.Вставить("Аналитика4", СтрокаТабличнойЧасти.Аналитика4);
	СтруктураПараметров.Вставить("Аналитика5", СтрокаТабличнойЧасти.Аналитика5);
	СтруктураПараметров.Вставить("Аналитика6", СтрокаТабличнойЧасти.Аналитика6);    
	СтруктураПараметров.Вставить("Валюта", СтрокаТабличнойЧасти.Валюта);
	СтруктураПараметров.Вставить("ВидБюджета", Объект.ВидБюджета);
	
	СтрокаТабличнойЧасти.Свободно = КонтрольЛимитовФормыВызовСервера.ЗаполнитьОстаткиСвободногоЛимитаПоСтрокеКорректировкаЛимитов(СтруктураПараметров);
	
КонецПроцедуры	

#Область ЕдиныеРеквизиты 

&НаКлиенте
Процедура ПриИзмененииЕдиногоРеквизита(ИмяЕдиногоРеквизита)
	
	КонтрольЛимитовФормыКлиент.ПриИзмененииЕдиногоРеквизита(ЭтаФорма, ИмяЕдиногоРеквизита, "Планы"); 
	
	Для Каждого Строка Из Объект.Планы Цикл
		ОбновитьСвободныйОстаток(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеТипаДокументаОснования()
	
	Элементы.ДокументОснование.ОграничениеТипа	= КонтрольЛимитовУХ.ТипыДокументаОснованияКорректировкиЛимитов();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
