	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА Резервирование.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА Резервирование.Контрагент = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Резервирование.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ПризнакиКлючевыхАналитикДокумента.КлючДоговорКонтрагента
	|			ТОГДА Резервирование.ДоговорКонтрагента
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДоговорКонтрагента,
	|	ВЫБОР
	|		КОГДА ПризнакиКлючевыхАналитикДокумента.КлючДокументПланирования = ЛОЖЬ
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА Резервирование.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.Резервирование)
	|			ТОГДА Резервирование.Ссылка
	|		ИНАЧЕ Резервирование.ДокументПланирования
	|	КОНЕЦ КАК ДокументПланирования,
	|	ОперативныйПланПериоды.Период КАК Период
	|ПОМЕСТИТЬ ВТ_КлючевыеРеквизитыДокументов
	|ИЗ
	|	ВТ_ПризнакиКлючевыхАналитикДокумента КАК ПризнакиКлючевыхАналитикДокумента,
	|	Документ.Резервирование КАК Резервирование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Резервирование.Периоды КАК ОперативныйПланПериоды
	|		ПО Резервирование.Ссылка = ОперативныйПланПериоды.Ссылка
	|ГДЕ
	|	Резервирование.Проведен = ИСТИНА
	|		И Резервирование.ВидБюджета = &ВидБюджета
	|		И Резервирование.ВидОперации В (&ТребуемыеОперацииДокумента)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти 

#КонецОбласти 

#КонецОбласти

#Область ИсточникиДляКонтроляДокумента

Функция ИсточникиДокумента(Объект, ПараметрыКонтроля = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект, ПараметрыКонтроля));
	
	Возврат Источники;
	
КонецФункции 

Функция Источник_БюджетныеЛимитыРезервы(Объект, ДопПараметры)
	
	// Параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 						Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 					Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 					Не ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект,, ДопПараметры);
	Запрос.УстановитьПараметр("ТипЗаявкиНаОбеспечение", КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению()[0]);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.Период КАК Период,
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	0 КАК Лимит,
	|	ВТ_ПланыДокумента.Сумма КАК Зарезервировано,
	|	0 КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.Выполнить();
	
	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;

КонецФункции

#КонецОбласти 

#Область ПланыДокумента

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц =  Неопределено, ПараметрыКонтроля = Неопределено) Экспорт

	ИменаРеквизитов = "Ссылка, Дата, ВидБюджета, ВидОперации, ДокументПланирования";
	
	Запрос = Новый Запрос;
	Если ПараметрыКонтроля <> Неопределено И ТипЗнч(ПараметрыКонтроля) = Тип("Структура")
		И ПараметрыКонтроля.Свойство("ПланыДокумента") И ТипЗнч(ПараметрыКонтроля.ПланыДокумента) = Тип("Структура")
		И ПараметрыКонтроля.ПланыДокумента.Свойство("ПланыДокумента") И ТипЗнч(ПараметрыКонтроля.ПланыДокумента.ПланыДокумента) = Тип("МенеджерВременныхТаблиц") Тогда
		Запрос.МенеджерВременныхТаблиц = ПараметрыКонтроля.ПланыДокумента.ПланыДокумента;
	ИначеЕсли ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Запросы 	= Новый Массив;
	ПодЗапросы 	= Новый Массив;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ВидБюджета КАК ВидБюджета,
	|	ВложенныйЗапрос.ДокументПланирования КАК ДокументПланирования,
	|	РезервированиеДвиженияОперации.Период.ДатаНачала КАК Период,
	|	РезервированиеДвиженияОперации.ПриходРасход КАК ПриходРасход,
	|	РезервированиеДвиженияОперации.СтатьяБюджета КАК СтатьяБюджета,
	|	РезервированиеДвиженияОперации.Аналитика1 КАК Аналитика1,
	|	РезервированиеДвиженияОперации.Аналитика2 КАК Аналитика2,
	|	РезервированиеДвиженияОперации.Аналитика3 КАК Аналитика3,
	|	РезервированиеДвиженияОперации.Аналитика4 КАК Аналитика4,
	|	РезервированиеДвиженияОперации.Аналитика5 КАК Аналитика5,
	|	РезервированиеДвиженияОперации.Аналитика6 КАК Аналитика6,
	|	РезервированиеДвиженияОперации.ЦФО КАК ЦФО,
	|	РезервированиеДвиженияОперации.Проект КАК Проект,
	|	РезервированиеДвиженияОперации.Организация КАК Организация,
	|	РезервированиеДвиженияОперации.Контрагент КАК Контрагент,
	|	РезервированиеДвиженияОперации.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	РезервированиеДвиженияОперации.Валюта КАК Валюта,
	|	ВложенныйЗапрос.Коэффициент * ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРезервирование.Перенос)
	|			ТОГДА -РезервированиеДвиженияОперации.СуммаИзменение
	|		ИНАЧЕ РезервированиеДвиженияОперации.Сумма
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	Документ.Резервирование.ДвиженияОперации КАК РезервированиеДвиженияОперации,
	|	(ВЫБРАТЬ
	|		&Ссылка КАК ДокументПланирования,
	|		1 КАК Коэффициент
	|	ГДЕ
	|		&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРезервирование.Новый)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&ДокументПланирования,
	|		1
	|	ГДЕ
	|		&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРезервирование.Корректировка)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&ДокументПланирования,
	|		-1
	|	ГДЕ
	|		&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРезервирование.Перенос)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&Ссылка,
	|		1
	|	ГДЕ
	|		&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРезервирование.Перенос)) КАК ВложенныйЗапрос
	|ГДЕ
	|	РезервированиеДвиженияОперации.Ссылка = &Ссылка
	|	И РезервированиеДвиженияОперации.Сумма <> 0";
	
	//
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		// Это ссылка
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, ИменаРеквизитов);
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.Резервирование") Тогда
		// Объект
		РеквизитыДокумента = Источник;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Резервирование.", "ВТ_");
		
		Коллекция = Источник.ДвиженияОперации.Выгрузить();
		Коллекция.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.Резервирование"));
		Коллекция.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ДвиженияОперации ИЗ &Коллекция КАК Коллекция");
	Иначе
		// Форма
		РеквизитыДокумента = Источник;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Резервирование.", "ВТ_");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервированиеДвиженияОперации.Ссылка = &Ссылка", "ИСТИНА");
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ДвиженияОперации").Колонки.Найти("Организация") = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервированиеДвиженияОперации.Организация КАК Организация", "Неопределено КАК Организация");
		КонецЕсли;
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ДвиженияОперации").Колонки.Найти("Контрагент") = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервированиеДвиженияОперации.Контрагент КАК Контрагент", "Неопределено КАК Контрагент");
		КонецЕсли; 
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ДвиженияОперации").Колонки.Найти("ДоговорКонтрагента") = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервированиеДвиженияОперации.ДоговорКонтрагента КАК ДоговорКонтрагента", "Неопределено КАК ДоговорКонтрагента");
		КонецЕсли;

	КонецЕсли;
	Подзапросы.Добавить(ТекстЗапроса);  
	
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Если Запрос.Параметры.ВидОперации = Перечисления.ВидыОперацийРезервирование.Корректировка Тогда
		Подзапросы.Добавить(
		"ВЫБРАТЬ
		|	ОперацииБюджетовОбороты.ВидБюджета КАК ВидБюджета,
		|	ОперацииБюджетовОбороты.ОбъектПланирования.Объект КАК ОбъектПланированияОбъект,
		|	НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ДЕНЬ) КАК Период,
		|	ОперацииБюджетовОбороты.ПриходРасход КАК ПриходРасход,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
		|	ОперацииБюджетовОбороты.АналитикаСтруктуры.ЦФО КАК ЦФО,
		|	ОперацииБюджетовОбороты.АналитикаСтруктуры.Проект КАК Проект,
		|	ОперацииБюджетовОбороты.АналитикаСтруктуры.Организация КАК Организация,
		|	ОперацииБюджетовОбороты.АналитикаПартнеров.Контрагент КАК Контрагент,
		|	ОперацииБюджетовОбороты.АналитикаПартнеров.Договор КАК Договор,
		|	ОперацииБюджетовОбороты.Валюта КАК Валюта,
		|	-ОперацииБюджетовОбороты.СуммаОборот КАК Сумма
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ОбъектПланирования.Объект ССЫЛКА Документ.Резервирование
		|				И ОбъектПланирования.Объект = &ДокументПланирования) КАК ОперацииБюджетовОбороты
		|ГДЕ
		|	ОперацииБюджетовОбороты.Регистратор <> &Ссылка
		|	И ОперацииБюджетовОбороты.Регистратор ССЫЛКА Документ.Резервирование");
	КонецЕсли;

	ШаблонЗапроса = 
	"ВЫБРАТЬ
	|	&Дата КАК ДатаРегистрации,
	|	Запрос.ВидБюджета КАК ВидБюджета,
	|	Запрос.ДокументПланирования КАК ДокументПланирования,
	|	Запрос.Период КАК Период,
	|	Запрос.ЦФО КАК ЦФО,
	|	Запрос.Проект КАК Проект,
	|	Запрос.Организация КАК Организация,
	|	Запрос.ПриходРасход КАК ПриходРасход,
	|	Запрос.СтатьяБюджета КАК СтатьяБюджета,
	|	Запрос.Аналитика1 КАК Аналитика1,
	|	Запрос.Аналитика2 КАК Аналитика2,
	|	Запрос.Аналитика3 КАК Аналитика3,
	|	Запрос.Аналитика4 КАК Аналитика4,
	|	Запрос.Аналитика5 КАК Аналитика5,
	|	Запрос.Аналитика6 КАК Аналитика6,
	|	Запрос.Контрагент КАК Контрагент,
	|	Запрос.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Запрос.Валюта КАК Валюта,
	|	СУММА(Запрос.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	(%1) КАК Запрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.ВидБюджета,
	|	Запрос.СтатьяБюджета,
	|	Запрос.ПриходРасход,
	|	Запрос.Аналитика6,
	|	Запрос.Валюта,
	|	Запрос.Организация,
	|	Запрос.Период,
	|	Запрос.ЦФО,
	|	Запрос.Аналитика1,
	|	Запрос.ДокументПланирования,
	|	Запрос.Контрагент,
	|	Запрос.Аналитика4,
	|	Запрос.Аналитика2,
	|	Запрос.ДоговорКонтрагента,
	|	Запрос.Проект,
	|	Запрос.Аналитика5,
	|	Запрос.Аналитика3
	|
	|ИМЕЮЩИЕ
	|	СУММА(Запрос.Сумма) <> 0";

	ТекстПодЗапросов = СтрСоединить(ПодЗапросы, 
		"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|");
	
	ТекстЗапроса = СтрШаблон(ШаблонЗапроса, ТекстПодЗапросов);
	Запросы.Добавить(ТекстЗапроса);
	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	
	Запрос.Выполнить();
	
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ПланыДокумента");
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции

#КонецОбласти 

#Область ТекстыЗапросов

#Область ИнициализацияЗапроса

// Процедура инициализирует запрос данными таблиц, переданных в параметрах
Процедура ИнициализироватьЗапрос(Запрос, Объект, ДополнительныеСвойства = Неопределено)
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИначеЕсли Запрос.МенеджерВременныхТаблиц.Таблицы.Количество() > 0 Тогда
		Запрос.МенеджерВременныхТаблиц.Закрыть();
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	ПараметрыЦЗ = ВстраиваниеОПК.ПараметрыЦентрализованныхЗакупок();
	
	ТаблицаПериодов = Неопределено;
	ТаблицаНастройкаАналитик = Неопределено;
	
	ТипОбъекта = ТипЗнч(Объект);
	
	СтруктураРеквизитов = ПолучитьОписаниеРеквизитовДокумента();
	
	Если ТипОбъекта = Тип("Структура") Тогда
		
		Если НЕ Объект.Свойство("НастройкаАналитик") Тогда
			ВызватьИсключение НСтр("ru = 'В объекте отсутствует таблица настроек аналитик.'");
		ИначеЕсли НЕ Объект.Свойство("Периоды") Тогда
			ВызватьИсключение НСтр("ru = 'В объекте отсутствует таблица периодов.'");
		КонецЕсли;
		
		ТаблицаНастройкаАналитик = Объект.НастройкаАналитик;
		ТаблицаПериодов = Объект.Периоды; 
		СтруктураРеквизитов.Вставить("ПериодичностьЛимитирования");
		
		РеквизитыДокумента = ЗначенияСвойствОбъекта(Объект, СтруктураРеквизитов);

	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.Резервирование") Тогда
		
		СтруктураРеквизитов.Вставить("Периоды");
		СтруктураРеквизитов.Вставить("НастройкаАналитик");
		СтруктураРеквизитов.Вставить("НазначениеРезерва_Контрагент");
		СтруктураРеквизитов.Вставить("НазначениеРезерва_ДоговорКонтрагента"); 
		СтруктураРеквизитов.Вставить("ПериодичностьЛимитирования","Периодичность"); 
     	
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, СтруктураРеквизитов);
		
		//
		ТаблицаНастройкаАналитик = РеквизитыДокумента.НастройкаАналитик.Выгрузить();
		ТаблицаПериодов = РеквизитыДокумента.Периоды.Выгрузить();
		
	ИначеЕсли ТипОбъекта = Тип("ДокументОбъект.Резервирование")
		 ИЛИ (ТипОбъекта = Тип("ДанныеФормыСтруктура") И Объект.Свойство("Ссылка") 
			И ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.Резервирование")) Тогда
	
		ТаблицаНастройкаАналитик = Объект.НастройкаАналитик.Выгрузить(, "Аналитика, Использование");
		ТаблицаПериодов = Объект.Периоды.Выгрузить(, "Период");
		
		РеквизитыДокумента = ЗначенияСвойствОбъекта(Объект, СтруктураРеквизитов);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	//
	Для Каждого КлючЗначение Из РеквизитыДокумента Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("АналитикаОрганизацияПустая", НЕ ЗначениеЗаполнено(Запрос.Параметры.Организация));
	Запрос.УстановитьПараметр("АналитикаКонтрагентПустая", НЕ ЗначениеЗаполнено(Запрос.Параметры.Контрагент));
	Запрос.УстановитьПараметр("АналитикаДоговорПустая", НЕ ЗначениеЗаполнено(Запрос.Параметры.ДоговорКонтрагента));
	
	Запрос.УстановитьПараметр("АналитикаОрганизацияИспользуется", 
		ТаблицаНастройкаАналитик.Найти(Справочники.АналитикиОперативногоПланирования.Организация, "Аналитика") <> Неопределено);
	Запрос.УстановитьПараметр("АналитикаКонтрагентИспользуется",
		ТаблицаНастройкаАналитик.Найти(Справочники.АналитикиОперативногоПланирования.Контрагент, "Аналитика") <> Неопределено);
	Запрос.УстановитьПараметр("АналитикаДоговорИспользуется", 
		ТаблицаНастройкаАналитик.Найти(Справочники.АналитикиОперативногоПланирования.ДоговорКонтрагента, "Аналитика") <> Неопределено);
	
	// Если при отладчике установить значение Истина, то виртуальные таблицы уничтожаться не будут
	Запрос.УстановитьПараметр("НеУничтожатьВТ", Ложь);
	Запрос.УстановитьПараметр("ЭтоНовый", НЕ ЗначениеЗаполнено(Запрос.Параметры.Ссылка)); 
	Запрос.УстановитьПараметр("ПериодичностьПланирования", Запрос.Параметры.ВариантНастройки.Периодичность);  
	Запрос.УстановитьПараметр("АналитикаШапки", Объект.АналитикаШапки);    
	Запрос.УстановитьПараметр("ВидЗаполнения", Объект.ВидЗаполнения); 
	
	ДокументПроведен = Ложь;
	Если ДополнительныеСвойства <> Неопределено И ДополнительныеСвойства.Свойство("ДляПроведения") И ДополнительныеСвойства.ДляПроведения.Свойство("Проведен") Тогда
		ДокументПроведен = ДополнительныеСвойства.ДляПроведения.Проведен;
	КонецЕсли;

	Если НЕ Запрос.Параметры.ЭтоНовый И ДокументПроведен Тогда
		// Момент времени долгая операция. Если уже есть в ДопСвойствах, то использовать из них. 
		Если ДополнительныеСвойства <> Неопределено И ДополнительныеСвойства.Свойство("ДляПроведения") И ДополнительныеСвойства.ДляПроведения.Свойство("МоментВремени") Тогда
			Запрос.УстановитьПараметр("МоментВремени",    ДополнительныеСвойства.ДляПроведения.МоментВремени);
			Запрос.УстановитьПараметр("ГраницаДокумента", Новый Граница(ДополнительныеСвойства.ДляПроведения.МоментВремени, ВидГраницы.Исключая));
		Иначе
			Запрос.УстановитьПараметр("МоментВремени",    Запрос.Параметры.Ссылка.МоментВремени());
			Запрос.УстановитьПараметр("ГраницаДокумента", Новый Граница(Запрос.Параметры.Ссылка.МоментВремени(), ВидГраницы.Исключая));
		КонецЕсли;
		
	Иначе
		Запрос.УстановитьПараметр("ГраницаДокумента", '00010101000000');
	КонецЕсли;
	
	//
	ТребуетсяРегистрацияПотребностей = ПараметрыЦЗ.Использовать
		И Запрос.Параметры.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;
	Запрос.УстановитьПараметр("ТребуетсяРегистрацияПотребностей", ТребуетсяРегистрацияПотребностей);	
	Если ТребуетсяРегистрацияПотребностей Тогда
		Запрос.УстановитьПараметр("ВалютаУчетаЦентрализованныхЗакупок", 
			ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуУправленческогоУчета());
	КонецЕсли;
	
	// 
	Если Не ЗначениеЗаполнено(Запрос.Параметры.Контрагент) Тогда
		Запрос.Параметры.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	// ВТ_ПериодыДокумента
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(
		Запрос,
		"ВТ_ПериодыДокумента", 
		ТаблицаПериодов);
	
	// ВТ_НастройкаАналитикДокумента
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(
		Запрос,
		"ВТ_НастройкаАналитикДокумента",
		ТаблицаНастройкаАналитик);
	
	//
	УстановитьПараметрыВидаОпераций(Запрос);
	Если Запрос.Параметры.ЭтоЛимиты Тогда
		ОчиститьАналитикиПланирования(Запрос);	// Убрать лишние аналитики документа, не нужные для лимитирования
	КонецЕсли;
	
	//
	Запрос.Текст = "";
	
	ДобавитьОписанияКлючевыхАналитик(Запрос);
	
	// 
	Запрос.Текст = Запрос.Текст + ТекстЗапроса_ВТ_СписокКлючевыхРеквизитовДокумента();
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета();
	Запрос.Текст = Запрос.Текст + ТекстЗапроса_ВТ_ПризнакиКлючевыхАналитикДокумента();
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета();
	Запрос.Текст = Запрос.Текст + ТекстЗапроса_ВТ_КлючевыеРеквизитыДокумента();
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета();
	Запрос.Текст = Запрос.Текст + ТекстЗапроса_ВТ_КлючиОперПлана();
	Запрос.Выполнить();
	
	// Дополнить параметры запроса признаками ключевых аналитик
	КлючевыеРеквизиты = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_КлючевыеРеквизитыДокумента").ПолучитьДанные().Выгрузить();
	Если КлючевыеРеквизиты.Количество() = 1 Тогда
		Данные = КлючевыеРеквизиты[0];
		Для каждого Колонка Из КлючевыеРеквизиты.Колонки Цикл
			Если СтрНачинаетсяС(Колонка.Имя, "Ключ") Тогда
				Запрос.УстановитьПараметр(Колонка.Имя, Данные[Колонка.Имя]);
			ИначеЕсли СтрНачинаетсяС(Колонка.Имя, "ТребуетсяОтборПоКлючам") Тогда
				Запрос.УстановитьПараметр(Колонка.Имя, Данные[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;

	Если Запрос.Параметры.ВидОперации = Перечисления.ВидыОперацийРезервирование.Корректировка
		ИЛИ Запрос.Параметры.ВидОперации = Перечисления.ВидыОперацийРезервирование.Перенос Тогда
		Запрос.УстановитьПараметр("ОбъектПланирования", 
			ОбъектыПланирования.ПолучитьОбъектПланирования(Запрос.Параметры.ДокументПланирования));
	Иначе
		Запрос.УстановитьПараметр("ОбъектПланирования", 
			Справочники.ОбъектыПланирования.ПустаяСсылка());
	КонецЕсли; 
	
КонецПроцедуры

// Процедура инициализирует запрос для поиска предыдущих/последующих документов
Процедура ЗаполнитьПараметрыИнициализацииДляПоискаПоследующих(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Ссылка КАК Регистратор,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.ВидБюджета КАК ВидБюджета,
	|	ДанныеДокумента.ВидОперации КАК ВидОперации,
	|	ДанныеДокумента.ВариантНастройки КАК ВариантНастройки,
	|	ДанныеДокумента.ЦФО КАК ЦФО,
	|	ДанныеДокумента.Проект КАК Проект,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента,
	|	ДанныеДокумента.ПриходРасход КАК ПриходРасход,
	|	ДанныеДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ДанныеДокумента.Аналитика1 КАК Аналитика1,
	|	ДанныеДокумента.Аналитика2 КАК Аналитика2,
	|	ДанныеДокумента.Аналитика3 КАК Аналитика3,
	|	ДанныеДокумента.Аналитика4 КАК Аналитика4,
	|	ДанныеДокумента.Аналитика5 КАК Аналитика5,
	|	ДанныеДокумента.Аналитика6 КАК Аналитика6,
	|	ДанныеДокумента.ДокументПланирования КАК ДокументПланирования,
	|	ДанныеДокумента.ВалютаДокумента КАК ВалютаДокумента,
	|	ДанныеДокумента.Комментарий КАК Комментарий,
	|	ДанныеДокумента.ПометкаУдаления КАК ПометкаУдаления,
	|	ДанныеДокумента.Проведен КАК Проведен,
	|	ДанныеДокумента.МестоПоставки КАК МестоПоставки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.Менеджер КАК Менеджер,
	|	ДанныеДокумента.Приоритет КАК Приоритет
	|ИЗ
	|	Документ.Резервирование КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка";
	
	ТаблицаРеквизитов = Запрос.Выполнить().Выгрузить();
	Реквизиты = ТаблицаРеквизитов[0];
	
	Для Каждого Колонка Из ТаблицаРеквизитов.Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, Реквизиты[Колонка.Имя]);
	КонецЦикла;
	
	// 
	Если НЕ ЗначениеЗаполнено(Запрос.Параметры.Контрагент) Тогда
		Запрос.Параметры.Контрагент = Неопределено;
	КонецЕсли;
	
	//
	УстановитьПараметрыВидаОпераций(Запрос);
	
	// Убрать лишние аналитики документа, не нужные для лимитирования
	ОчиститьАналитикиПланирования(Запрос);
	
	// Добавляем временные таблицы с описанием аналитик оперативного планирования
	ДобавитьОписанияКлючевыхАналитик(Запрос);
	
	// Для проверки последовательности необходимо заменить документ планирования
	// Необходимо проверять цепочку по документу планирования
	Если Запрос.Параметры.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРезервирование.Новый") Тогда
		Запрос.Параметры.ДокументПланирования = Запрос.Параметры.Ссылка;
	ИначеЕсли Запрос.Параметры.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРезервирование.Корректировка") Тогда
		// менять документ планирования не надо.
	ИначеЕсли Запрос.Параметры.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРезервирование.Перенос") Тогда
		Запрос.Параметры.ДокументПланирования = Запрос.Параметры.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПараметрыВидаОпераций(Запрос)
	
	ТребуемыеОперации = Новый Массив;
	Если Запрос.Параметры.ВидОперации = Перечисления.ВидыОперацийОперативныйПлан.Резервирование Тогда
		//
		ТребуемыеОперации.Добавить(Перечисления.ВидыОперацийОперативныйПлан.Резервирование);
		Запрос.УстановитьПараметр("ЭтоЛимиты", Истина); //  Необходим для зачистки ключевых аналитик документа
	Иначе
		ТребуемыеОперации.Добавить(Перечисления.ВидыОперацийОперативныйПлан.ПланированиеИРезервирование);
		Запрос.УстановитьПараметр("ЭтоЛимиты", Ложь); //  Необходим для зачистки ключевых аналитик документа
	КонецЕсли;
	Запрос.УстановитьПараметр("ТребуемыеОперацииДокумента", ТребуемыеОперации);
	
КонецПроцедуры
 
Функция ТекстЗапроса_ВТ_СписокКлючевыхРеквизитовДокумента()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НастройкаАналитик.Реквизит КАК Реквизит
	|ПОМЕСТИТЬ ВТ_СписокКлючевыхРеквизитовДокумента
	|ИЗ
	|	ВТ_НастройкаАналитикДокумента КАК ОперативныйПланНастройкаАналитик
