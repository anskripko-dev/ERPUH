#Область Ключи
// Функция возвращает текст запроса для отбора требуемых для опер.плана ключей учета потребностей
Функция ТекстЗапроса_ВТ_КлючиОперПлана()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АналитикаПланированияПотребностей.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТ_КлючиПотребностей
	|ИЗ
	|	ВТ_КлючевыеРеквизитыДокумента КАК ВТ_КлючевыеРеквизитыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияПотребностей КАК АналитикаПланированияПотребностей
	|		ПО (ВТ_КлючевыеРеквизитыДокумента.ТребуетсяОтборПоКлючамПотребностей = ИСТИНА)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючПриоритет = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.Приоритет = АналитикаПланированияПотребностей.Приоритет)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючМенеджер = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.Менеджер = АналитикаПланированияПотребностей.Менеджер)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючМестоПоставки = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.МестоПоставки = АналитикаПланированияПотребностей.МестоПоставки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АналитикаПланированияНоменклатуры.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТ_КлючиНоменклатуры
	|ИЗ
	|	ВТ_КлючевыеРеквизитыДокумента КАК ВТ_КлючевыеРеквизитыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияНоменклатуры КАК АналитикаПланированияНоменклатуры
	|		ПО (ВТ_КлючевыеРеквизитыДокумента.ТребуетсяОтборПоКлючамНоменклатуры = ИСТИНА)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючНоменклатура = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.Номенклатура = АналитикаПланированияНоменклатуры.Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АналитикаПланированияСтруктуры.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТ_КлючиСтруктуры
	|ИЗ
	|	ВТ_КлючевыеРеквизитыДокумента КАК ВТ_КлючевыеРеквизитыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры
	|		ПО (ВТ_КлючевыеРеквизитыДокумента.ТребуетсяОтборПоКлючамСтруктуры = ИСТИНА)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючЦФО = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.ЦФО = АналитикаПланированияСтруктуры.ЦФО)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючПроект = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.Проект = АналитикаПланированияСтруктуры.Проект)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючОрганизация = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.Организация = АналитикаПланированияСтруктуры.Организация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АналитикаПланированияСтатейБюджетов.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТ_КлючиСтатейБюджета
	|ИЗ
	|	ВТ_КлючевыеРеквизитыДокумента КАК ВТ_КлючевыеРеквизитыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов
	|		ПО (ВТ_КлючевыеРеквизитыДокумента.ТребуетсяОтборПоКлючамСтатейБюджета = ИСТИНА)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючСтатьяБюджета = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.СтатьяБюджета = АналитикаПланированияСтатейБюджетов.СтатьяБюджета)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючПриходРасход = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.ПриходРасход = АналитикаПланированияСтатейБюджетов.ПриходРасход)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АналитикаПланированияРасчетовСКонтрагентами.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТ_КлючиПартнеров
	|ИЗ
	|	ВТ_КлючевыеРеквизитыДокумента КАК ВТ_КлючевыеРеквизитыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияРасчетовСКонтрагентами КАК АналитикаПланированияРасчетовСКонтрагентами
	|		ПО (ВТ_КлючевыеРеквизитыДокумента.ТребуетсяОтборПоКлючамПартнеров = ИСТИНА)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючКонтрагент = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.Контрагент = АналитикаПланированияРасчетовСКонтрагентами.Контрагент)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючДоговорКонтрагента = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.ДоговорКонтрагента = АналитикаПланированияРасчетовСКонтрагентами.Договор)
	|			И (ВТ_КлючевыеРеквизитыДокумента.КлючОрганизация = ЛОЖЬ
	|				ИЛИ ВТ_КлючевыеРеквизитыДокумента.Организация = АналитикаПланированияРасчетовСКонтрагентами.Организация)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияРасчетовСКонтрагентами.ПустаяСсылка)
	|ИЗ
	|	ВТ_КлючевыеРеквизитыДокумента КАК ВТ_КлючевыеРеквизитыДокумента
	|ГДЕ
	|	ВТ_КлючевыеРеквизитыДокумента.ТребуетсяОтборПоКлючамПартнеров = ИСТИНА
	|		И &АналитикаКонтрагентИспользуется = ЛОЖЬ
	|			ИЛИ (ВТ_КлючевыеРеквизитыДокумента.КлючКонтрагент = ИСТИНА
	|				И &АналитикаКонтрагентПустая = ИСТИНА)
	|		И &АналитикаДоговорИспользуется = ЛОЖЬ
	|			ИЛИ (ВТ_КлючевыеРеквизитыДокумента.КлючДоговорКонтрагента = ИСТИНА
	|				И &АналитикаДоговорПустая = ИСТИНА)
	|		И &АналитикаОрганизацияИспользуется = ЛОЖЬ
	|			ИЛИ (ВТ_КлючевыеРеквизитыДокумента.КлючОрганизация = ИСТИНА
	|				И &АналитикаОрганизацияПустая = ИСТИНА)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти 

#Область ОперативноеПланированиеИКонтроль
                                      
Процедура ДобавитьОписанияКлючевыхАналитик(Запрос)
	
	ТекстЗапросаПередВыполнением = Запрос.Текст;
	
	ТаблицаКлючейАналитик = ПолучитьТаблицуКлючейАналитик();
	ТаблицаАналитикИРеквизитов = ПолучитьТаблицуСоответствияАналитикРеквизитам();
	
	Запрос.УстановитьПараметр("ТаблицаКлючейАналитик", 		ТаблицаКлючейАналитик);
	Запрос.УстановитьПараметр("ТаблицаАналитикИРеквизитов", ТаблицаАналитикИРеквизитов);
	
	Запрос.Текст = "";
	Если Запрос.МенеджерВременныхТаблиц <> Неопределено Тогда
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_Ключи") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + 
			"УНИЧТОЖИТЬ ВТ_Ключи
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|";
		КонецЕсли;
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_НастройкаАналитик") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + 
			"УНИЧТОЖИТЬ ВТ_НастройкаАналитик
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|";
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ТКА.Реквизит КАК Реквизит,
	|	ТКА.КлючВидБюджета КАК КлючВидБюджета,
	|	ТКА.КлючРаздел КАК КлючРаздел,
	|	ТКА.КлючЦФО КАК КлючЦФО,
	|	ТКА.КлючПроект КАК КлючПроект,
	|	ТКА.КлючВалюта КАК КлючВалюта,
	|	ТКА.КлючПриходРасход КАК КлючПриходРасход,
	|	ТКА.КлючСтатьяБюджета КАК КлючСтатьяБюджета,
	|	ТКА.КлючАналитика1 КАК КлючАналитика1,
	|	ТКА.КлючАналитика2 КАК КлючАналитика2,
	|	ТКА.КлючАналитика3 КАК КлючАналитика3,
	|	ТКА.КлючАналитика4 КАК КлючАналитика4,
	|	ТКА.КлючАналитика5 КАК КлючАналитика5,
	|	ТКА.КлючАналитика6 КАК КлючАналитика6,
	|	ТКА.КлючНоменклатура КАК КлючНоменклатура,
	|	ТКА.КлючМестоПоставки КАК КлючМестоПоставки,
	|	ТКА.КлючДокументПланирования КАК КлючДокументПланирования,
	|	ТКА.КлючКонтрагент КАК КлючКонтрагент,
	|	ТКА.КлючДоговорКонтрагента КАК КлючДоговорКонтрагента,
	|	ТКА.КлючОрганизация КАК КлючОрганизация,
	|	ТКА.КлючВариантНастройки КАК КлючВариантНастройки,
	|	ТКА.КлючМенеджер КАК КлючМенеджер,
	|	ТКА.КлючПриоритет КАК КлючПриоритет
	|ПОМЕСТИТЬ ВТ_Ключи
	|ИЗ
	|	&ТаблицаКлючейАналитик КАК ТКА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТАР.Аналитика КАК Аналитика,
	|	ТАР.Реквизит КАК Реквизит
	|ПОМЕСТИТЬ ВТ_НастройкаАналитик
	|ИЗ
	|	&ТаблицаАналитикИРеквизитов КАК ТАР";
	
	Запрос.Выполнить();
	
	Запрос.Текст = ТекстЗапросаПередВыполнением;
	
КонецПроцедуры

#КонецОбласти 

// Процедура заполняет табличную часть документа из регистра
// Параметры:
//  Параметры  - Структура - Настройки для заполнения
//  АдресХранилища - Строка - Адрес временного хранилища, в которое будет помещен результат работы задания.
//
Функция ПолучитьТаблицуОперацийБюджетов(Знач Параметры)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИнициализироватьЗапрос(Запрос, Параметры);
	
	Запрос.Текст = 
		ТекстЗапроса_ВТ_ОперацииБюджетов(Запрос)
		+ ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета()
		+ ТекстЗапроса_ВТ_ОперацииБюджетовПоКлючевымАналитикам(Ложь, Истина);
		
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции

// Функция - возвращает текст отбора для виртуальной таблицы Обороты РН.ОперацииБюджетов
//
// Параметры:
//  Запрос	 - 	Запрос - Запрос, с заполненными параметрами
// 
// Возвращаемое значение:
//  Текст - Текст отбора для использования в виртуальной таблице Обороты РН.ОперацииБюджетов
//
Функция ТекстЗапроса_ВТ_ОперацииБюджетов(Запрос)
	     
	Если Запрос.Параметры.Свойство("ВидЗаполнения") 
		И Запрос.Параметры.ВидЗаполнения = "ЗаполнитьОстаткамиСвободногоЛимита" Тогда   

		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ДанныеРегистра.ВидБюджета КАК ВидБюджета,
		|	ВЫБОР &ПериодичностьПланирования
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ГОД)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ПОЛУГОДИЕ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, КВАРТАЛ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, МЕСЯЦ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ДЕКАДА)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, НЕДЕЛЯ)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ДЕНЬ)
		|	КОНЕЦ КАК Период,
		|	ДанныеРегистра.Валюта КАК Валюта,
		|	ДанныеРегистра.АналитикаСтруктуры КАК АналитикаСтруктуры,
		|	ДанныеРегистра.АналитикаПартнеров КАК АналитикаПартнеров,
		|	ДанныеРегистра.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
		|	ДанныеРегистра.АналитикаПотребностей КАК АналитикаПотребностей,
		|	ДанныеРегистра.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		|	СУММА(ДанныеРегистра.КоличествоОборот) КАК Количество,
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеРегистра.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				ТОГДА ДанныеРегистра.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Сумма,
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				ТОГДА ДанныеРегистра.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Зарезервировано,
		|	СУММА(ДанныеРегистра.СуммаИсполненоОборот) КАК Исполнено
		|ПОМЕСТИТЬ ВТ_ДанныеРегистра
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов.Обороты(, , Регистратор, &ДопПараметрыОтбора) КАК ДанныеРегистра
		|ГДЕ
		|	НЕ ДанныеРегистра.Регистратор = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеРегистра.ВидБюджета,
		|	ДанныеРегистра.АналитикаПартнеров,
		|	ДанныеРегистра.Валюта,
		|	ДанныеРегистра.АналитикаСтруктуры,
		|	ДанныеРегистра.АналитикаПотребностей,
		|	ДанныеРегистра.АналитикаНоменклатуры,
		|	ДанныеРегистра.АналитикаСтатейБюджетов,
		|	ВЫБОР &ПериодичностьПланирования
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ГОД)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ПОЛУГОДИЕ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, КВАРТАЛ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, МЕСЯЦ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ДЕКАДА)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
		|			ТОГДА НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, НЕДЕЛЯ)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(ДанныеРегистра.Период, ДЕНЬ)
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеРегистра.ВидБюджета КАК ВидБюджета,
		|	ВТ_ДанныеРегистра.Период КАК Период,
		|	ВТ_ДанныеРегистра.Валюта КАК Валюта,
		|	ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка) КАК ОбъектПланирования,
		|	ВТ_ДанныеРегистра.АналитикаСтруктуры КАК АналитикаСтруктуры,
		|	ВТ_ДанныеРегистра.АналитикаПартнеров КАК АналитикаПартнеров,
		|	ВТ_ДанныеРегистра.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
		|	ВТ_ДанныеРегистра.АналитикаПотребностей КАК АналитикаПотребностей,
		|	ВТ_ДанныеРегистра.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		|	СУММА(ВТ_ДанныеРегистра.Сумма - ВТ_ДанныеРегистра.Зарезервировано - ВТ_ДанныеРегистра.Исполнено) КАК Сумма,
		|	СУММА(ВТ_ДанныеРегистра.Количество) КАК Количество,
		|	0 КАК СуммаОборот,
		|	0 КАК КоличествоОборот
		|ПОМЕСТИТЬ ВТ_ОперацииБюджетов
		|ИЗ
		|	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ДанныеРегистра.АналитикаПартнеров,
		|	ВТ_ДанныеРегистра.АналитикаСтатейБюджетов,
		|	ВТ_ДанныеРегистра.АналитикаНоменклатуры,
		|	ВТ_ДанныеРегистра.АналитикаСтруктуры,
		|	ВТ_ДанныеРегистра.ВидБюджета,
		|	ВТ_ДанныеРегистра.АналитикаПотребностей,
		|	ВТ_ДанныеРегистра.Период,
		|	ВТ_ДанныеРегистра.Валюта
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВТ_ДанныеРегистра.Сумма - ВТ_ДанныеРегистра.Зарезервировано - ВТ_ДанныеРегистра.Исполнено) > 0";   

		ПутиКДаннымПланирования = КроссТаблицыУХ.ПутиКДаннымПланирования();
		
		АналитикаИсключение = Новый Массив;    
		АналитикаИсключение.Добавить("Организация");  
		АналитикаИсключение.Добавить("Контрагент");
		АналитикаИсключение.Добавить("ДоговорКонтрагента");  
		
		ДопПараметрыОтбора = Новый Массив; 
		Для Каждого КлючЗначение Из Запрос.Параметры.АналитикаШапки Цикл
			
			Если Не ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
				Продолжить;	
			КонецЕсли; 
			
			Если Не АналитикаИсключение.Найти(КлючЗначение.Ключ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьКДанным = ПутиКДаннымПланирования[КлючЗначение.Ключ];  
			
			Если ЗначениеЗаполнено(ПутьКДанным) Тогда
				ДопПараметрыОтбора.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 = &%2", ПутьКДанным, КлючЗначение.Ключ));	
			Иначе
				ДопПараметрыОтбора.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 = &%1", КлючЗначение.Ключ));
			КонецЕсли;
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
			
		КонецЦикла;     
		
		Если ДопПараметрыОтбора.Количество() = 0 Тогда             
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопПараметрыОтбора", "Истина"); 
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопПараметрыОтбора", СтрСоединить(ДопПараметрыОтбора, " И "));  
		КонецЕсли;
		
	ИначеЕсли Запрос.Параметры.Свойство("ВидЗаполнения") 
		И Запрос.Параметры.ВидЗаполнения = "ВысвободитьСвободныйРезерв" Тогда   	
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ОперацииБюджетовОбороты.ВидБюджета КАК ВидБюджета,
		|	ВЫБОР &ПериодичностьЛимитирования
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ГОД)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ПОЛУГОДИЕ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, КВАРТАЛ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, МЕСЯЦ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ДЕКАДА)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, НЕДЕЛЯ)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ДЕНЬ)
		|	КОНЕЦ КАК Период,
		|	ОперацииБюджетовОбороты.Валюта КАК Валюта,
		|	ОперацииБюджетовОбороты.ОбъектПланирования КАК ОбъектПланирования,
		|	ОперацииБюджетовОбороты.АналитикаСтруктуры КАК АналитикаСтруктуры,
		|	ОперацииБюджетовОбороты.АналитикаПартнеров КАК АналитикаПартнеров,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
		|	ОперацииБюджетовОбороты.АналитикаПотребностей КАК АналитикаПотребностей,
		|	ОперацииБюджетовОбороты.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		|	СУММА(ОперацииБюджетовОбороты.СуммаОборот * -1) КАК Сумма,
		|	СУММА(ОперацииБюджетовОбороты.КоличествоОборот * -1) КАК Количество,
		|	СУММА(ОперацииБюджетовОбороты.СуммаОборот) КАК СуммаОборот,
		|	СУММА(ОперацииБюджетовОбороты.КоличествоОборот) КАК КоличествоОборот
		|ПОМЕСТИТЬ ВТ_ОперацииБюджетов
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов.Обороты(, , РЕГИСТРАТОР, ОбъектПланирования.Объект = &ДокументПланирования) КАК ОперацииБюджетовОбороты
		|ГДЕ
		|	ОперацииБюджетовОбороты.Регистратор <> &Ссылка
		|	И ОперацииБюджетовОбороты.СуммаОборот < 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ОперацииБюджетовОбороты.ВидБюджета,
		|	ОперацииБюджетовОбороты.Валюта,
		|	ОперацииБюджетовОбороты.ОбъектПланирования,
		|	ОперацииБюджетовОбороты.АналитикаСтруктуры,
		|	ОперацииБюджетовОбороты.АналитикаПартнеров,
		|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов,
		|	ОперацииБюджетовОбороты.АналитикаПотребностей,
		|	ОперацииБюджетовОбороты.АналитикаНоменклатуры,
		|	ВЫБОР &ПериодичностьЛимитирования
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ГОД)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ПОЛУГОДИЕ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, КВАРТАЛ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, МЕСЯЦ)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ДЕКАДА)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
		|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, НЕДЕЛЯ)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(ОперацииБюджетовОбороты.Период, ДЕНЬ)
		|	КОНЕЦ";  	 
	ИначеЕсли Запрос.Параметры.Свойство("ВидЗаполнения") 
		И Запрос.Параметры.ВидЗаполнения = "ОбновитьИсходныеПланы" Тогда 			
			
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	РезервированиеДвиженияОперации.Период.ДатаНачала КАК Период,
		|	РезервированиеДвиженияОперации.ЦФО КАК ЦФО,
		|	РезервированиеДвиженияОперации.Проект КАК Проект,
		|	РезервированиеДвиженияОперации.Валюта КАК Валюта,
		|	РезервированиеДвиженияОперации.ПриходРасход КАК ПриходРасход,
		|	РезервированиеДвиженияОперации.СтатьяБюджета КАК СтатьяБюджета,
		|	РезервированиеДвиженияОперации.Аналитика1 КАК Аналитика1,
		|	РезервированиеДвиженияОперации.Аналитика2 КАК Аналитика2,
		|	РезервированиеДвиженияОперации.Аналитика3 КАК Аналитика3,
		|	РезервированиеДвиженияОперации.Аналитика4 КАК Аналитика4,
		|	РезервированиеДвиженияОперации.Аналитика5 КАК Аналитика5,
		|	РезервированиеДвиженияОперации.Аналитика6 КАК Аналитика6,
		|	РезервированиеДвиженияОперации.СуммаИсходное КАК СуммаОборот
		|ПОМЕСТИТЬ ВТ_ДвиженияОперации
		|ИЗ
		|	Документ.Резервирование.ДвиженияОперации КАК РезервированиеДвиженияОперации
