#Область СлужебныеПроцедурыИФункции_Общие

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Объект = Форма.Объект;
	
	МСФОКлиентСерверУХ.УправлениеФормой_ВидОперации(Форма);
	МСФОКлиентСерверУХ.УправлениеФормой_ЦеныИВалюта(Форма);
	МСФОКлиентСерверУХ.УправлениеФормой_ПараметрыУчета(Форма);
	МСФОКлиентСерверУХ.УправлениеФормой_СФ(Форма);
	МСФОКлиентСерверУХ.УправлениеФормой_Итоги(Форма, "Сумма", "Позиции");
			
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере(ТекущийОбъект = Неопределено)
	
	КэшируемыеЗначения = Новый Структура;

	Действия = "ЗаполнитьУП, ЗаполнитьСтрану, ЗаполнитьПОУ, ОбновитьКэшОперации";
	МСФОКлиентСерверУХ.ПриИзмененииРеквизита(ЭтотОбъект, Действия, Ложь);
	
	Действия = Новый Структура("ЗаполнитьСуммаСНДС");
	Если КэшируемыеЗначения.КэшОперации.ЕстьДоли Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Действия,
			ОбработкаТабличныхЧастейКлиентСерверУХ.ПолучитьДействияИнвестиций(Истина, Ложь));	
	КонецЕсли;
	
	Для каждого СтрокаТЧ Из Объект.Позиции Цикл
		ОбработатьСтрокуТЧ(ЭтотОбъект, СтрокаТЧ, Действия, Ложь);
	КонецЦикла;
	
	Если ПравоДоступа("Чтение", Метаданные.Документы.СчетФактураМСФО) Тогда
		МСФОКлиентСерверУХ.ЗаполнитьПоСчетФактуре(ЭтотОбъект);
	КонецЕсли;
	
	СчетФактура = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КэшируемыеЗначения, "СчетФактура");
	МСФОУХ.ПрименитьПраваДоступаСчетаФактуры(
		СчетФактура,
		Элементы.СчетФактураПросмотр,
		Элементы.СчетФактураРедактирование);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОбработатьСтрокуТЧ(Форма, СтрокаТЧ, Действия, УправлениеФормой = Истина)
	
	ОбработкаТабличныхЧастейКлиентСерверУХ.ОбработатьСтрокуТЧА(СтрокаТЧ, Действия, Форма);
	
	Если УправлениеФормой Тогда
		УправлениеФормой(Форма);//пересчитать итог документа	
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПриИзмененииРеквизита(Элемент)
	
	Действия = Неопределено;
	ДействияТЧ = Неопределено;
	
	Если Элемент.Имя = "Организация" Тогда		
		Действия = "ЗаполнитьУП, ЗаполнитьСтрану, ЗаполнитьДоговор";
		ДействияТЧ = ОбработкаТабличныхЧастейКлиентСерверУХ.ПолучитьДействияИнвестиций();
	ИначеЕсли Элемент.Имя = "ВидОперации" Тогда
		Действия = "ОбновитьКэшОперации";
		ДействияТЧ = ОбработкаТабличныхЧастейКлиентСерверУХ.ПолучитьДействияИнвестиций();
	ИначеЕсли Элемент.Имя = "Сценарий" Тогда
		Действия = "ЗаполнитьУП";
		ДействияТЧ = ОбработкаТабличныхЧастейКлиентСерверУХ.ПолучитьДействияИнвестиций();
	ИначеЕсли Элемент.Имя = "Дата" Тогда
		Действия = "ЗаполнитьУП";
		ДействияТЧ = ОбработкаТабличныхЧастейКлиентСерверУХ.ПолучитьДействияИнвестиций();
	ИначеЕсли Элемент.Имя = "Контрагент" Тогда
		Действия = "ЗаполнитьДоговор";
	ИначеЕсли Элемент.Имя = "ДоговорКонтрагента" Тогда
		Действия = "ЗаполнитьВалюту, ЗаполнитьТипЦен";
		ДействияТЧ = "ЗаполнитьЦены";
	ИначеЕсли Элемент.Имя = "ТипЦен" Тогда
		ДействияТЧ = "ЗаполнитьЦены";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Действия) Тогда
	    МСФОКлиентСерверУХ.ПриИзмененииРеквизита(ЭтотОбъект, Действия, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДействияТЧ) Тогда
		Для каждого СтрокаТЧ Из Объект.Позиции Цикл
			ОбработатьСтрокуТЧ(ЭтотОбъект, СтрокаТЧ, ДействияТЧ, Ложь);
		КонецЦикла;
	КонецЕсли;

	УправлениеФормой(ЭтотОбъект);

КонецФункции

#КонецОбласти

