&НаКлиенте
Процедура ПозицииАктивПриИзменении(Элемент)

	Действия = ОбработкаТабличныхЧастейКлиентСерверУХ.ПолучитьДействияПозиций(Истина, Истина, Истина, Истина);
	Действия.Вставить("ПолучитьПараметрыУчета", Истина);
	
	Если КэшируемыеЗначения.КэшОперации.ЕстьДоли Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Действия,
			ОбработкаТабличныхЧастейКлиентСерверУХ.ПолучитьДействияИнвестиций(Истина, Ложь));	
	КонецЕсли;
		
	ОбработатьСтрокуТЧ(ЭтотОбъект, Элементы.Позиции.ТекущиеДанные, Действия);

КонецПроцедуры

