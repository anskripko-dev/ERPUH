#Область Проведение

Функция ПодготовитьПараметрыПроведения(ДополнительныеСвойства, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДополнительныеСвойства.ДляПроведения.Ссылка);

	ДопРеквизиты = Новый Структура("ЕстьДоли, ВидОперации", "ВидОперации.ЕстьДоли");
	Реквизиты = МСФОУХ.РеквизитыДокумента(Запрос, ДопРеквизиты, , Отказ);
	ДополнительныеСвойства.ДляПроведения.Вставить("Реквизиты", Реквизиты);
	
	Если Отказ Тогда
		Возврат ДополнительныеСвойства;
	КонецЕсли;
	
	РегистрыСведений.ЗначенияКотировокФИ.ЗаполнитьКроссКурсВО(Запрос, Реквизиты);
	
	Запрос.УстановитьПараметр("ГраницаДоДокумента",		МСФОВызовСервераУХ.ПолучитьГраницуДоДокумента(Реквизиты.Период, Реквизиты.Ссылка));
	Запрос.УстановитьПараметр("Организация",			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Сценарий",				Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("ПланСчетовМСФО", 		Реквизиты.ПланСчетовМСФО);
	Запрос.УстановитьПараметр("ФункциональнаяВалюта", 	Реквизиты.ФункциональнаяВалюта);
	Запрос.УстановитьПараметр("УчетнаяПолитика", 		Реквизиты.УчетнаяПолитика);

	ПутиСубконто = МСФОУХ.ПутиСубконто();
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = Новый Массив;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втРасчеты(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПозиции(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втИтогПозиций(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втОстаткиАвансов(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПогашенияАвансов(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПутиСубконто));
	ТекстЗапроса.Добавить(ТекстЗапроса_МСФО(НомераТаблиц, ПутиСубконто));
	
	Если Реквизиты.ЕстьДоли И ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_ДвижениеИнвестиций(НомераТаблиц));
		ТекстЗапроса.Добавить(ТекстЗапроса_ИсточникРасчетаЭффективныхДолей(НомераТаблиц));
	КонецЕсли;

	Запрос.Текст = СтрСоединить(ТекстЗапроса, ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета());
	Результат = ПроведениеСерверУХ.ДополнитьТаблицамиИзПакетаЗапросов(
			ДополнительныеСвойства.ТаблицыДляДвижений, Запрос, НомераТаблиц);

	Если Метаданные.РегистрыСведений.Найти("СтатусыОбъектовИнвестирования") <> Неопределено Тогда
		РегистрыСведений["СтатусыОбъектовИнвестирования"].ДобавитьТаблицуДляДвижений(
			ДополнительныеСвойства, Отказ);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_втРасчеты(НомераТаблиц)
	
	НомераТаблиц.Вставить("втРасчеты", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	т.ВидОперации КАК ВидОперации,
	|	т.Контрагент КАК Контрагент,
	|	т.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	т.ВалютаДокумента КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА т.КурсВзаиморасчетов = 0
	|			ТОГДА 1
	|		ИНАЧЕ т.КурсВзаиморасчетов
	|	КОНЕЦ КАК КурсВД,
	|	ВЫБОР
	|		КОГДА т.КратностьВзаиморасчетов = 0
	|			ТОГДА 1
	|		ИНАЧЕ т.КратностьВзаиморасчетов
	|	КОНЕЦ КАК КратностьВД,
	|	1 КАК КурсФВ,
	|	1 КАК КратностьФВ,
	|	&КурсВО КАК КурсВО,
	|	&КратностьВО КАК КратностьВО,
	|	т.ПараметрыУчетаВзаиморасчетов КАК ПараметрыУчетаДКЗ,
	|	т.ПараметрыУчетаВзаиморасчетов.ПараметрыАванса.СчетУчета КАК АналитикаАванс,
	|	т.ПараметрыУчетаВзаиморасчетов.СчетУчета КАК АналитикаДКЗ,
	|	т.ПараметрыУчетаВзаиморасчетов.ПараметрыАванса.СчетУчета.Счет.СчетСсылка КАК СчетАванса,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втРасчеты
	|ИЗ
	|	Документ.ПоступлениеМСФО КАК т
	|ГДЕ
	|	т.Ссылка = &Ссылка";

КонецФункции

Функция ТекстЗапроса_втПозиции(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПозиции", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	т.НомерСтроки КАК НомерСтроки,
	|	т.Актив КАК Актив,
	|	т.Количество КАК Количество,
	|	т.Цена КАК Цена,
	|	ВЫБОР
	|		КОГДА т.Ссылка.НДСВключенВСтоимость
	|			ТОГДА т.Сумма - т.СуммаНДС
	|		ИНАЧЕ т.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА т.Ссылка.НДСВключенВСтоимость
	|			ТОГДА т.Сумма
	|		ИНАЧЕ т.Сумма - т.СуммаНДС
	|	КОНЕЦ КАК СуммаСНДС,
	|	т.Сумма КАК Сумма,
	|	т.СтавкаНДС КАК СтавкаНДС,
	|	т.СуммаНДС КАК СуммаНДС,
	|	т.ПараметрыУчета.СчетУчета КАК АналитикаАктив,
	|	т.ПараметрыУчета.ПараметрыНДС.СчетУчета КАК АналитикаНДС,
	|	т.ПараметрыУчета.ПараметрыНДС.СчетДоходов КАК АналитикаДНДС,
	|	т.ПараметрыУчета КАК ПараметрыУчетаАктива,
	|	т.КоличествоДоп КАК КоличествоДоп,
	|	т.ОтношениеКГруппе КАК ОтношениеКГруппе,
	|	ВЫБОР
	|		КОГДА НЕ т.Ссылка.ВидОперации.ЕстьДоли
	|				ИЛИ т.ПараметрыУчета.ВидОбъектаУчета.РазделПланаСчетов <> ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ПрочиеАктивыОбязательства)
	|			ТОГДА NULL
	|		КОГДА т.Актив ССЫЛКА Справочник.Контрагенты
	|				И ВЫРАЗИТЬ(т.Актив КАК Справочник.Контрагенты).ОрганизационнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА т.Актив.ОрганизационнаяЕдиница
	|		КОГДА т.Актив ССЫЛКА Справочник.Организации
	|			ТОГДА т.Актив
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ОбъектИнвестирования,
	|	т.Содержание КАК Содержание
	|ПОМЕСТИТЬ втПозиции
	|ИЗ
	|	Документ.ПоступлениеМСФО.Позиции КАК т
	|ГДЕ
	|	т.Ссылка = &Ссылка";

КонецФункции

Функция ТекстЗапроса_втИтогПозиций(НомераТаблиц)

	НомераТаблиц.Вставить("втИтогПозиций", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	ЕстьNULL(СУММА(т.СуммаСНДС), 0) КАК СуммаСНДС
	|ПОМЕСТИТЬ втИтогПозиций
	|ИЗ
	|	втПозиции КАК т";

КонецФункции

Функция ТекстЗапроса_втОстаткиАвансов(НомераТаблиц)
	
	НомераТаблиц.Вставить("втОстаткиАвансов", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Субконто2.Дата КАК ДатаАванса,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Валюта КАК Валюта,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА т.Счет.Валютный
	|			ТОГДА т.СуммаВВалютеОстаток
	|		ИНАЧЕ т.СуммаВВалютеУчетаОстаток
	|	КОНЕЦ КАК СуммаВВалюте,
	|	т.СуммаВВалютеУчетаОстаток КАК СуммаВВалютеУчета,
	|	т.СуммаВВалютеОтчетностиОстаток КАК СуммаВВалютеОтчетности
	|ПОМЕСТИТЬ втОстаткиАвансов
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(
	|			&Дата,
	|			Счет В
	|				(ВЫБРАТЬ
	|					с.СчетАванса
	|				ИЗ
	|					втРасчеты КАК с),
	|			,
	|			Организация = &Организация
	|				И Сценарий = &Сценарий
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						д.ДоговорКонтрагента
	|					ИЗ
	|						втРасчеты КАК д)) КАК т
	|ГДЕ
	|	т.СуммаВВалютеУчетаОстаток > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаАванса";

КонецФункции

Функция ТекстЗапроса_втПогашенияАвансов(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПогашенияАвансов", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.НомерЗаписи КАК НомерЗаписи,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.СуммаВВалюте) + ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0) > МАКСИМУМ(втИтогПозиций.СуммаСНДС)
	|			ТОГДА МАКСИМУМ(втИтогПозиций.СуммаСНДС) - ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалюте)
	|	КОНЕЦ КАК СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.СуммаВВалюте) + ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0) > МАКСИМУМ(втИтогПозиций.СуммаСНДС)
	|			ТОГДА ВЫРАЗИТЬ((МАКСИМУМ(втИтогПозиций.СуммаСНДС) - ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)) * СУММА(т.СуммаВВалютеУчета) / МАКСИМУМ(т.СуммаВВалюте) КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалютеУчета)
	|	КОНЕЦ КАК СуммаВВалютеУчета,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(т.СуммаВВалюте) + ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0) > МАКСИМУМ(втИтогПозиций.СуммаСНДС)
	|			ТОГДА ВЫРАЗИТЬ((МАКСИМУМ(втИтогПозиций.СуммаСНДС) - ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)) * СУММА(т.СуммаВВалютеОтчетности) / МАКСИМУМ(т.СуммаВВалюте) КАК ЧИСЛО(18, 2))
	|		ИНАЧЕ МАКСИМУМ(т.СуммаВВалютеОтчетности)
	|	КОНЕЦ КАК СуммаВВалютеОтчетности
	|ПОМЕСТИТЬ втПогашенияАвансов
	|ИЗ
	|	втОстаткиАвансов КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИтогПозиций КАК втИтогПозиций
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстаткиАвансов КАК ПрошлыеАвансы
	|		ПО (ВЫБОР
	|				КОГДА т.ДатаАванса > ПрошлыеАвансы.ДатаАванса
	|					ТОГДА ИСТИНА
	|				КОГДА т.ДатаАванса = ПрошлыеАвансы.ДатаАванса
	|					ТОГДА т.НомерЗаписи >= ПрошлыеАвансы.НомерЗаписи
	|			КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	т.НомерЗаписи
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(втИтогПозиций.СуммаСНДС) >= ЕСТЬNULL(СУММА(ПрошлыеАвансы.СуммаВВалюте), 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерЗаписи";

КонецФункции

Функция ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПутиСубконто)
	
	ПоляАналитик = 
	"втРасчеты.АналитикаДКЗ
	|втРасчеты.АналитикаАванс
	|втПозиции.АналитикаАктив 
	|втПозиции.АналитикаНДС 
	|втПозиции.АналитикаДНДС";
	
	Возврат Справочники.ПараметрыОбъектовУчетаМСФО.ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПоляАналитик, ПутиСубконто);
	
КонецФункции

Функция ТекстЗапроса_МСФО(НомераТаблиц, ПутиСубконто)
	
	НомераТаблиц.Вставить("МСФО", НомераТаблиц.Количество());
	
	ТекстЗапроса = Новый Массив;
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаПогашенияАвансов(ПутиСубконто));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаПоступление(ПутиСубконто));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаПолученныйНДС(ПутиСубконто));
	
	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ");
	
КонецФункции

Функция ТекстЗапроса_ДвижениеИнвестиций(НомераТаблиц)

	НомераТаблиц.Вставить("ДвижениеИнвестиций", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Организация КАК Инвестор,
	|	&Сценарий КАК Сценарий,
	|	т.ОбъектИнвестирования КАК ОбъектИнвестирования,
	|	т.Сумма КАК Инвестиции,
	|	0 КАК БалансоваяСтоимость,
	|	т.КоличествоДоп КАК ПрямаяДоляВладения,
	|	т.Содержание КАК ОбоснованиеКонтроля,
	|	т.Количество КАК КоличествоВДоверительномУправлении,
	|	т.Количество КАК КоличествоГолосующих,
	|	т.Количество КАК КоличествоПривилегированных,
	|	т.Количество КАК Количество,
	|	т.ОтношениеКГруппе КАК ОтношениеКГруппе,
	|	т.ОтношениеКГруппе.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.Дочернее) КАК ПризнаниеКонтроля
	|ИЗ
	|	втПозиции КАК т
	|ГДЕ
	|	НЕ т.ОбъектИнвестирования ЕСТЬ NULL";

КонецФункции

Функция ТекстЗапроса_ИсточникРасчетаЭффективныхДолей(НомераТаблиц)
	
	НомераТаблиц.Вставить("ИсточникРасчетаЭффективныхДолей", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	&Сценарий КАК Сценарий,
	|	ПрямыеДоли.Инвестор КАК Инвестор,
	|	ПрямыеДоли.ОбъектИнвестирования КАК ОбъектИнвестирования,
	|	СУММА(ПрямыеДоли.ПрямаяДоля) КАК ПрямаяДоля,
	|	МАКСИМУМ(ПрямыеДоли.СтрокаИзменение) КАК СтрокаИзменение,
	|	ПРЕДСТАВЛЕНИЕ(ПрямыеДоли.Инвестор) КАК ИнвесторПредставление,
	|	ПРЕДСТАВЛЕНИЕ(ПрямыеДоли.ОбъектИнвестирования) КАК ОбъектИнвестированияПредставление
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.Инвестор КАК Инвестор,
	|		Остатки.ОбъектИнвестирования КАК ОбъектИнвестирования,
	|		Остатки.ПрямаяДоляВладенияОборот КАК ПрямаяДоля,
	|		ЛОЖЬ КАК СтрокаИзменение
	|	ИЗ
	|		РегистрНакопления.ДвижениеИнвестиций.Обороты(
	|				,
	|				&ГраницаДоДокумента,
	|				,
	|				Сценарий = &Сценарий
	|					И ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							втПозиции КАК т
	|						ГДЕ
	|							НЕ т.ОбъектИнвестирования ЕСТЬ NULL)) КАК Остатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&Организация,
	|		т.ОбъектИнвестирования,
	|		т.КоличествоДоп,
	|		ИСТИНА
	|	ИЗ
	|		втПозиции КАК т
	|	ГДЕ
	|		НЕ т.ОбъектИнвестирования ЕСТЬ NULL) КАК ПрямыеДоли
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрямыеДоли.Инвестор,
	|	ПрямыеДоли.ОбъектИнвестирования";

