	|	втСчетаУчетаКт.ВидСубконто3 КАК ВидСубконтоКт3,
	|	втОстаткиАвансов.Субконто1 КАК СубконтоКт1,
	|	втОстаткиАвансов.Субконто2 КАК СубконтоКт2,
	|	втОстаткиАвансов.Субконто3 КАК СубконтоКт3,
	|	втОстаткиАвансов.Подразделение КАК ПодразделениеКт,
	|	втОстаткиАвансов.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	NULL КАК КоличествоКт,
	|	ВЫБОР
	|		КОГДА втСчетаУчетаКт.Валютный
	|			ТОГДА втОстаткиАвансов.Валюта
	|	КОНЕЦ КАК ВалютаКт,
	|	ВЫБОР
	|		КОГДА втСчетаУчетаКт.Валютный
	|			ТОГДА втОстаткиАвансов.СуммаВВалюте
	|	КОНЕЦ КАК СуммаВВалютеКт,
	|	&Организация КАК Организация,
	|	&Сценарий КАК Сценарий,
	|	втОстаткиАвансов.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	втОстаткиАвансов.СуммаВВалютеОтчетности КАК СуммаВВалютеОтчетности,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ЗачетПервоначальногоАвансаСуммаБезНДС) КАК ВидОперации
	|ИЗ
	|	втРасчеты КАК втРасчеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОстаткиАвансов КАК втОстаткиАвансов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПогашенияАвансов КАК втПогашенияАвансов
	|			ПО втОстаткиАвансов.НомерЗаписи = втПогашенияАвансов.НомерЗаписи
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаДт
	|		ПО втРасчеты.АналитикаДКЗ = втСчетаУчетаДт.АналитикаУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаУчета КАК втСчетаУчетаКт
	|		ПО втРасчеты.АналитикаАванс = втСчетаУчетаКт.АналитикаУчета";
	
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Содержание = НСтр("ru = 'Зачет аванса'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Содержание", СтрШаблон(" ""%1"" ", Содержание));
	
	ФункцииЗамены = Новый Структура("Подразделение, НаправлениеДеятельности, Валюта, СуммаВВалюте, Количество",
		"втРасчеты.Подразделение", "втРасчеты.НаправлениеДеятельности", "втРасчеты.ВалютаДокумента",
		"втОстаткиАвансов.СуммаВВалюте", "втПозиции.Количество");
	МСФОУХ.ЗаменыСубконто(ФункцииЗамены, "втСчетаУчетаДт", ПутиСубконто, Истина);
	
	ЗаменыЗапроса = МСФОУХ.ЗаменыЗапросаПоПрефиксу("&ДКЗ_");
	МСФОУХ.ЗаменитьАналитикуУчета(ТекстЗапроса, "втСчетаУчетаДт", ФункцииЗамены, ЗаменыЗапроса);
	
