	|ИЗ
	|	Документ.ПредложениеПоставщика КАК ДокументПредложениеПоставщика,
	|	ГраницыПериодаДоговора КАК ГраницыПериодаДоговора
	|ГДЕ
	|	ДокументПредложениеПоставщика.Ссылка = &ПредложениеПоставщика";           
	
	Запрос.УстановитьПараметр("ПредложениеПоставщика", ПредложениеПобедителя);    
	Запрос.УстановитьПараметр("Поставщик", ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПредложениеПобедителя,"Контрагент")); 
	Запрос.УстановитьПараметр("Кратность", ОписаниеКоэффициента.Кратность);

	мРезультатыЗапросов = Запрос.ВыполнитьПакет();
	Результат = Новый Структура;
	Результат.Вставить("ДанныеРегистра", 	мРезультатыЗапросов[3]);
	Результат.Вставить("УсловияПоставки", 	мРезультатыЗапросов[4]);
	
	Возврат Результат;  
	
КонецФункции

Процедура ЗаполнитьПоПредложениюПоставщика(ПредложениеПобедителя)
	ЦентрализованныеЗакупкиУХ.ПроверитьВозможностьВводаДоговораНаОснованииПредложения(
		ПредложениеПобедителя);
	РезультатыЗапроса = 
		ПолучитьРезультатЗапросаДляЗаполненияДоговораПоПредложениюПобедителя(
			ПредложениеПобедителя);
	РезультатЗапроса = РезультатыЗапроса.ДанныеРегистра;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
	ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикПоставок;  
	ДобавитьПроизводственныйКалендарь(ПредложениеПобедителя.Календарь);
	ЭтапыГрафикаОплаты.Загрузить(ПредложениеПобедителя.ЭтапыГрафикаОплаты.Выгрузить());     
	ЦенаВключаетНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредложениеПобедителя,"ЦенаВключаетНДС");
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовСтр = Номенклатура.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ВыборкаДетальныеЗаписи);
		НовСтр.ДатаПоставки = ВыборкаДетальныеЗаписи.ДатаОперации;
		Сумма = Сумма + ВыборкаДетальныеЗаписи.Сумма;
		НовСтр.ПериодПотребности = СформироватьПериодПоГодуИМесяцу(Месяц(НовСтр.ДатаПоставки), Год(НовСтр.ДатаПоставки));	
		ЗначениеСтавки = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(НовСтр.СтавкаНДС, "Ставка");
		НовСтр.СуммаНДС =  УчетНДСКлиентСервер.РассчитатьСуммуНДС(НовСтр.Сумма, Истина,ЗначениеСтавки);  		
		СуммаДляРасчетаЦены = НовСтр.Сумма
			- ?(ЦенаВключаетНДС, 0, НовСтр.СуммаНДС);
		НовСтр.Цена = СуммаДляРасчетаЦены 
			/ ?(НовСтр.Количество = 0, 1, НовСтр.Количество);
		
	КонецЦикла;	
	РезультатЗапроса = РезультатыЗапроса.УсловияПоставки;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаДетальныеЗаписи);
	КонецЕсли;		
	ВидДоговораУХ = Справочники.ВидыДоговоровКонтрагентовУХ.СПоставщиком;
	ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	
	Если ЭтапыГрафикаОплаты.Количество() > 0 Тогда  	 
		ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикРасчетов");	
	Иначе
		ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.НеИспользовать"); 
	КонецЕсли;   
	
	Если ПустаяСтрока(НаименованиеВерсии) Тогда
		НаименованиеВерсии = СоздатьНаименованиеДоговораСПоставщиком(
			ПредложениеПобедителя);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ПредложениеПобедителя,"Партнер")) Тогда
		Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредложениеПобедителя,"Партнер");	
	Иначе	
		Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
	КонецЕсли; 
	ОсновнойЦФО = ПредложениеПобедителя.Лот.ЦФОИсполнитель;	
	Если ЗначениеЗаполнено(ПредложениеПобедителя.Лот.СтрокаПланаЗакупок) Тогда
		ФункциональноеНаправление = ПредложениеПобедителя.Лот.СтрокаПланаЗакупок.ФункциональноеНаправление;
	КонецЕсли;	
	Соглашение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредложениеПобедителя, "Соглашение");
	ЦентрализованныеЗакупкиУХ.ЗаполнитьРеквизитыСМСПИзОбъекта(
		ЭтотОбъект,
		?(ЗначениеЗаполнено(ПредложениеПобедителя),
			ПредложениеПобедителя.Лот.ЗакупочнаяПроцедура,
			Неопределено));  
			
	ЗаполненыРеквизитыУчетаСМСП = Истина;	
КонецПроцедуры

Процедура ПроверитьСообщитьПериодыЗакупок(Отказ)
	ТекстОшибки = ЦентрализованныеЗакупкиВызовСервераУХ.ПроверитьПериодЗакупок(
		ПериодЗакупокНачало, 
		ПериодЗакупокОкончание);
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Невозможно изменить период закупок: %1'"), ТекстОшибки), 
			ЭтотОбъект, 
			"ПериодЗакупокНачало", 
			"Объект", 
			Отказ);
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьЗаполнениеХарактеристикОтменить(Отказ) Экспорт
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(
		ЭтотОбъект,
		Новый Массив,
		Отказ,
		УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ПараметрыПроверкиЗаполненияХарактеристик());
	Возврат Отказ;
КонецФункции

Функция СоздатьНаименованиеДоговораСПоставщиком(ПредложениеПобедителя)
	Результат = НСтр("ru='Договор поставки'");
	Если ЗначениеЗаполнено(ПредложениеПобедителя) Тогда
		Лот = ПредложениеПобедителя.Лот;
		Если ЗначениеЗаполнено(Лот) Тогда
			Результат = Результат + СтрШаблон(НСтр("ru=' по лоту %1'"), Лот);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура СформироватьСписокРегистровДляКонтроля()
	
	ВыполнятьБюджетирование = ВыполнятьБюджетирование();
	
	Массив = Новый Массив;
	ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);

КонецПроцедуры

Функция ВыполнятьБюджетирование()
	
	Возврат Документы.ВерсияСоглашенияКоммерческийДоговор.ВыполнятьБюджетирование(ЭтотОбъект);
	
КонецФункции

#Область УХ_Закупки

// Устанавливает флаг Завершена для всех закупок по данному договору.
Процедура УстановитьЗавершениеЗакупочнойПроцедуры(ОтменаПроведения = Неопределено)
	МассивЛотов = Номенклатура.ВыгрузитьКолонку("Лот");
	МассивЛотов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЛотов);
	МассивЛотов = ОбщегоНазначенияКлиентСерверУХ.УдалитьПустыеЭлементыМассива(МассивЛотов);

	Для Каждого ТекМассивЛотов Из МассивЛотов Цикл 
		Если НЕ  ТИПЗНЧ(ТекМассивЛотов) = ТИП("ДокументСсылка.Лот")  Тогда
			Продолжить;
		КонецЕсли;	
		ТекЗакупка = ТекМассивЛотов.ЗакупочнаяПроцедура;
		Если ЗначениеЗаполнено(ТекЗакупка) Тогда
			Если НЕ ТекЗакупка.Завершена Тогда
				Справочники.ЗакупочныеПроцедуры.УстановитьФлагЗавершена(ТекЗакупка, Истина, Ссылка);
			ИначеЕсли ТекЗакупка.Завершена И ОтменаПроведения <> Неопределено И ТекЗакупка.ОснованиеЗавершения = Ссылка Тогда
				Справочники.ЗакупочныеПроцедуры.УстановитьФлагЗавершена(ТекЗакупка, Ложь, Неопределено);
				// Флаг Завершена уже установлен.
			КонецЕсли;
		Иначе
			// В лоте не указана закупочная процедура. Пропускаем.
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры		// УстановитьЗавершениеЗакупочнойПроцедуры()

#КонецОбласти

Функция ПроверкаРазностиСтатейБюджета() 
	
	ТипСтатьи = Неопределено;
	Для Каждого Строка ИЗ Номенклатура Цикл
		Если ТипСтатьи = Неопределено Тогда		
		    ТипСтатьи = ТИПЗНЧ(Строка.СтатьяБюджета);
		ИначеЕсли ЗначениеЗаполнено(Строка.СтатьяБюджета) Тогда      
			СовпадениеТипов = ТИПЗНЧ(Строка.СтатьяБюджета) = ТипСтатьи;
			Если НЕ СовпадениеТипов Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	  
	Возврат Истина;
	
КонецФункции

Функция ЭтоПрочийДоговор()

	ЭтоДоговорКомиссии     = (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомиссионером"))
		ИЛИ (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомитентом"))
		ИЛИ (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомиссионеромНаЗакупку"))
		ИЛИ (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомитентомНаЗакупку"));
		
	ЭтоДоговорСКомиссионером = ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомиссионером");
		
	ЭтоДоговорПриобретения = УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорСПоставщиком(ВидДоговораУХ)
		ИЛИ (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомитентом"))
		ИЛИ (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомиссионеромНаЗакупку"));
		
	ЭтоДоговорРеализации   = УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорСПокупателем(ВидДоговораУХ)
		ИЛИ (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомиссионером"))
		ИЛИ (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомитентомНаЗакупку"));
	
	ЭтоДоговорСПоставщиком            = (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СПоставщиком"));
	ЭтоДоговорСКомиссионеромНаЗакупку = (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомиссионеромНаЗакупку"));
		
	ЭтоДоговорФакторинга = (ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.Факторинг"));
	
	ЭтоПрочийДоговор = НЕ (ЭтоДоговорКомиссии ИЛИ ЭтоДоговорПриобретения ИЛИ ЭтоДоговорРеализации ИЛИ ЭтоДоговорФакторинга);
	
	Возврат ЭтоПрочийДоговор; 
	
КонецФункции

Функция СформироватьПериодПоГодуИМесяцу(МесяцВход, ГодВход)
	РезультатФункции = Справочники.Периоды.ПустаяСсылка();
	Если (ЗначениеЗаполнено(МесяцВход)) И (ЗначениеЗаполнено(ГодВход)) Тогда
		НоваяДата = Дата(ГодВход, МесяцВход, 1);
		Периодичность = ЦентрализованныеЗакупкиУХ.ПолучитьПериодичностьЗакупок();
		РезультатФункции = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(НоваяДата, Периодичность);
	Иначе
		РезультатФункции = Справочники.Периоды.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

Процедура ПроверитьГрафикРасчетовПоГрафикуПоставок(Отказ, РежимЗаписи)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	
	//
	Если ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикПоставок Тогда
		
		ОписаниеГрафика = Документы.ВерсияСоглашенияКоммерческийДоговор.ОписаниеГрафика(ВидДоговораУХ);
		
		СекцияОсновнойДолг = Неопределено;
		ОписаниеГрафика.Свойство("ОсновнойДолг", СекцияОсновнойДолг); 
		
		Если СекцияОсновнойДолг <> Неопределено Тогда
			
			ГрафикРасчетовОплата = ГрафикРасчетов.Выгрузить(Новый Структура("ЭлементСтруктурыЗадолженности,ОперацияГрафика",Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг, СекцияОсновнойДолг.КолонкаРасходОперация));
			ГрафикРасчетовОплата.Свернуть(,"Сумма");
			
			ГрафикРасчетовНачисление = ГрафикРасчетов.Выгрузить(Новый Структура("ЭлементСтруктурыЗадолженности,ОперацияГрафика",Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг, СекцияОсновнойДолг.КолонкаПриходОперация));
			ГрафикРасчетовНачисление.Свернуть(,"Сумма");
			
			ГрафикПоставок = Номенклатура.Выгрузить();
			ГрафикПоставок.Свернуть(,"Сумма"); 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ГрафикРасчетовНачисление.Сумма КАК Сумма
				|ПОМЕСТИТЬ ВТ_ГрафикРасчетовНачисление
				|ИЗ
				|	&ГрафикРасчетовНачисление КАК ГрафикРасчетовНачисление
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ГрафикРасчетовНачисление.Сумма КАК Сумма
				|ПОМЕСТИТЬ ВТ_ГрафикРасчетовОплата
				|ИЗ
				|	&ГрафикРасчетовОплата КАК ГрафикРасчетовНачисление
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ГрафикПоставок.Сумма КАК Сумма
				|ПОМЕСТИТЬ ВТ_ГрафикПоставок
				|ИЗ
				|	&ГрафикПоставок КАК ГрафикПоставок
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТ_ГрафикРасчетовНачисление.Сумма КАК СуммаНачисление,
				|	0 КАК СуммаПоГрафику,
				|	0 КАК СуммаОплата
				|ПОМЕСТИТЬ ВТ_Объединение
				|ИЗ
				|	ВТ_ГрафикРасчетовНачисление КАК ВТ_ГрафикРасчетовНачисление
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	0,
				|	ВТ_ГрафикПоставок.Сумма,
				|	0
				|ИЗ
				|	ВТ_ГрафикПоставок КАК ВТ_ГрафикПоставок
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	0,
				|	0,
				|	ВТ_ГрафикРасчетовОплата.Сумма
				|ИЗ
				|	ВТ_ГрафикРасчетовОплата КАК ВТ_ГрафикРасчетовОплата
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	СУММА(ВТ_Объединение.СуммаНачисление) КАК СуммаНачисление,
				|	СУММА(ВТ_Объединение.СуммаПоГрафику) КАК СуммаПоГрафику,
				|	СУММА(ВТ_Объединение.СуммаОплата) КАК СуммаОплата
				|ИЗ
				|	ВТ_Объединение КАК ВТ_Объединение";  
			
			Запрос.УстановитьПараметр("ГрафикРасчетовОплата",ГрафикРасчетовОплата);
			Запрос.УстановитьПараметр("ГрафикРасчетовНачисление",ГрафикРасчетовНачисление);
			Запрос.УстановитьПараметр("ГрафикПоставок",ГрафикПоставок);
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
															
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
					
					Если ВыборкаДетальныеЗаписи.СуммаПоГрафику <> ВыборкаДетальныеЗаписи.СуммаНачисление
						ИЛИ ВыборкаДетальныеЗаписи.СуммаПоГрафику <> ВыборкаДетальныеЗаписи.СуммаОплата Тогда
					
						ТекстСообщения = НСтр("ru = 'Не совпадает сумма начисления (%1) и сумма оплаты (%2) графика расчетов с суммой графика поставок (%3)'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ВыборкаДетальныеЗаписи.СуммаНачисление,
																								ВыборкаДетальныеЗаписи.СуммаОплата,
																								ВыборкаДетальныеЗаписи.СуммаПоГрафику);
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

