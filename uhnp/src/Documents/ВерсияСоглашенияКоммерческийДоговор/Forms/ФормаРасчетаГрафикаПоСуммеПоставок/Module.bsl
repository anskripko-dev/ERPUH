#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ПараметрыРасчетаПоСуммеПоставок") И Параметры.ПараметрыРасчетаПоСуммеПоставок <> Неопределено Тогда
		ПараметрыРасчетаПоСуммеПоставок = Параметры.ПараметрыРасчетаПоСуммеПоставок;
		РежимРезервированияБюджета = ПараметрыРасчетаПоСуммеПоставок.РежимРезервированияБюджета;
		ТекущийРежим = ТекущийРежимРезервированияСтрокой(РежимРезервированияБюджета); 
		
		Для Каждого ЭлементСтруктуры Из ПараметрыРасчетаПоСуммеПоставок  Цикл  
			Если ЭлементСтруктуры.Ключ = "РежимРезервированияБюджета" Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтотОбъект[ТекущийРежим + ЭлементСтруктуры.Ключ] = ПараметрыРасчетаПоСуммеПоставок[ЭлементСтруктуры.Ключ];
			
		КонецЦикла;
		
	Иначе
		РежимРезервированияБюджета = Перечисления.РежимыРезервированияБюджета.Разово;
	КонецЕсли;
	
	ПараметрыБюджета = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств);
	
	Если Не ЗначениеЗаполнено(РаспределениеСуммыНаГодПериодичность) Тогда
		РаспределениеСуммыНаГодПериодичность = ПараметрыБюджета.ПериодичностьОперативногоПланирования;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПериодическиДатаПервойПоставки) Тогда
		ПериодическиДатаПервойПоставки = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПериодическиПериодичность) Тогда
		ПериодическиПериодичность = ПараметрыБюджета.ПериодичностьОперативногоПланирования;	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(РаспределениеСуммыНаГодГод) Тогда
		РаспределениеСуммыНаГодГод = Год(ТекущаяДатаСеанса());	
	КонецЕсли;	
	
	ЗаполнитьСписокГодов();
	
	УправлениеФормой(ЭтотОбъект); 
	
	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	ПараметрыРасчетаГрафика = ПараметрыРасчетаГрафика(ЭтотОбъект);   
	
	ТекущийРежим = ТекущийРежимРезервированияСтрокой(РежимРезервированияБюджета); 

	
	Для Каждого ПараметрРасчетаГрафика Из ПараметрыРасчетаГрафика Цикл 
		ПроверяемыеРеквизиты.Добавить(ТекущийРежим+ПараметрРасчетаГрафика.Ключ);
	КонецЦикла;
	
	Если ПроверяемыеРеквизиты.Найти(ТекущийРежим+"ДатаПервойПоставки") <> Неопределено И ПроверяемыеРеквизиты.Найти(ТекущийРежим+"ДатаОкончанияПоставок") <> Неопределено Тогда
		
		Если ЭтотОбъект[ТекущийРежим+"ДатаПервойПоставки"] > ЭтотОбъект[ТекущийРежим+"ДатаОкончанияПоставок"] Тогда
			ТекстСообщения = НСтр("ru = 'Дата первой поставки не может быть больше даты окончания поставок'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
		
	КонецЕсли;  
	
	Если ПроверяемыеРеквизиты.Найти(ТекущийРежим+"Год") <> Неопределено Тогда 
		
		Если  ЭтотОбъект[ТекущийРежим+"Год"] < Год(ТекущаяДатаСеанса()) Тогда
			ТекстСообщения = НСтр("ru = 'Год не может быть меньше текущего года'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура РежимРезервированияБюджетаПриИзменении(Элемент)

	УправлениеФормой(ЭтотОбъект)

КонецПроцедуры

#КонецОбласти   

 #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		ПараметрыРасчетаГрафика = ПараметрыРасчетаГрафика(ЭтотОбъект);
		Закрыть(ПараметрыРасчетаГрафика); 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокГодов()
	
	КоличествоГодов = 10;
	
	ТекущийГод = Год(ТекущаяДатаСеанса());
	
	МассивГодов = Новый Массив;
	
	Для Сч = 0 По КоличествоГодов Цикл    
		НовыйГод = Год(ТекущаяДатаСеанса())+Сч; 
		МассивГодов.Добавить(НовыйГод);
	КонецЦикла;
	
	Элементы.РаспределениеСуммыНаГодГод.СписокВыбора.ЗагрузитьЗначения(МассивГодов);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыРасчетаГрафика(Форма)
	
	ПараметрыРасчетаГрафика = Новый Структура;
	
	Если Форма.РежимРезервированияБюджета = ПредопределенноеЗначение("Перечисление.РежимыРезервированияБюджета.Разово") Тогда
		ПараметрыРасчетаГрафика.Вставить("ДатаПоставки", Форма.РазовоДатаПоставки);	
		ПараметрыРасчетаГрафика.Вставить("Сумма", Форма.РазовоСумма);	
	ИначеЕсли Форма.РежимРезервированияБюджета = ПредопределенноеЗначение("Перечисление.РежимыРезервированияБюджета.Периодически") Тогда
		ПараметрыРасчетаГрафика.Вставить("ДатаПервойПоставки", Форма.ПериодическиДатаПервойПоставки);	
		ПараметрыРасчетаГрафика.Вставить("ДатаОкончанияПоставок", Форма.ПериодическиДатаОкончанияПоставок);	
		ПараметрыРасчетаГрафика.Вставить("Периодичность", Форма.ПериодическиПериодичность);	
		ПараметрыРасчетаГрафика.Вставить("Сумма", Форма.ПериодическиСумма);	
	Иначе   
		ПараметрыРасчетаГрафика.Вставить("Год", Форма.РаспределениеСуммыНаГодГод);	
		ПараметрыРасчетаГрафика.Вставить("Периодичность", Форма.РаспределениеСуммыНаГодПериодичность);	
		ПараметрыРасчетаГрафика.Вставить("Сумма", Форма.РаспределениеСуммыНаГодСумма);	
	КонецЕсли;   
	
	ПараметрыРасчетаГрафика.Вставить("РежимРезервированияБюджета", Форма.РежимРезервированияБюджета);
	
    Возврат ПараметрыРасчетаГрафика;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма);
	
	ВсеРежимы = Новый Массив;
	ВсеРежимы.Добавить("Разово");
	ВсеРежимы.Добавить("Периодически");
	ВсеРежимы.Добавить("РаспределениеСуммыНаГод");
	
	Элементы = Форма.Элементы;
	
	ТекущийРежим = ТекущийРежимРезервированияСтрокой(Форма.РежимРезервированияБюджета); 
	
	Для Каждого РежимРезервирования Из ВсеРежимы Цикл 
		Элементы["Режим"+РежимРезервирования].Видимость = Ложь;
	КонецЦикла;
	
	Элементы["Режим"+ТекущийРежим].Видимость = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийРежимРезервированияСтрокой(ЗначениеПеречисления)
	
	ИмяПеречисления = ЗначениеПеречисления.Метаданные().Имя;
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);
	ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
	
	Возврат ИмяЗначенияПеречисления;
	
КонецФункции

#КонецОбласти
	 
