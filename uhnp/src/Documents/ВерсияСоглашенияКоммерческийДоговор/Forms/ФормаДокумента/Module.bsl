												|en = 'Files'") + " (" + Формат(КоличествоПрисоединенныхФайлов, "ЧГ=") + ")";
	Иначе
		Элементы.СтраницаФайлы.Заголовок = НСтр("ru = 'Файлы';
												|en = 'Files'");
	КонецЕсли; 
	
