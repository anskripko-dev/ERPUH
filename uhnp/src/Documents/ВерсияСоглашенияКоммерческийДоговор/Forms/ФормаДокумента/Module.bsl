Процедура ЧислительКурсаВалютыДоговораПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЧислительКурсаВалютыПлатежаДоговораПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗнаменательКурсаВалютыДоговораПриИзменении(Элемент)
	
	Элементы.ГруппаРедактированиеКратностиКурса.Видимость = Ложь;
	Элементы.НадписьЗнаменательКурсаВалютыДоговора.Видимость = Истина;
	Модифицированность = Истина;
	УправлениеЭлементамиВариантКурсаДоговора();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗнаменательКурсаВалютыПлатежаДоговораПриИзменении(Элемент)
	
	Элементы.ГруппаРедактированиеКратностиКурсаВалютыПлатежа.Видимость = Ложь;
	Элементы.НадписьЗнаменательКурсаВалютыПлатежаДоговора.Видимость = Истина;
	Модифицированность = Истина;
	УправлениеЭлементамиВариантКурсаДоговора();
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьЗнаменательКурсаВалютыДоговораОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Элементы.ГруппаРедактированиеКратностиКурса.Видимость = Истина;
	Элементы.НадписьЗнаменательКурсаВалютыДоговора.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьЗнаменательКурсаВалютыПлатежаДоговораОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Элементы.ГруппаРедактированиеКратностиКурсаВалютыПлатежа.Видимость = Истина;
	Элементы.НадписьЗнаменательКурсаВалютыПлатежаДоговора.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикДоговораПриИзменении(Элемент)
	
	Если Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок")
		И (ПланПоставокПоПериодам.Количество() > 0 ИЛИ Объект.Номенклатура.Количество() > 0) Тогда
		ТекстВопроса = НСтр("ru = 'График поставок будет очищен. Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ГрафикДоговораПриИзмененииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе  
		ПриИзмененииГрафикДоговора();
	КонецЕсли;

КонецПроцедуры   

&НаКлиенте
Процедура ГрафикДоговораПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.Номенклатура.Очистить();
		ПланПоставокПоПериодам.Очистить(); 
		ПриИзмененииГрафикДоговора();
	Иначе
		Объект.ГрафикДоговора = ГрафикДоговораДоИзменения;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УчетАгентскогоНДСПриИзменении(Элемент)
	Если Объект.УчетАгентскогоНДС Тогда
		Если Объект.ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СКомитентом")
			ИЛИ ЭтоДоговорИностранца Тогда
			Объект.ВидАгентскогоДоговора = ПредопределенноеЗначение("Перечисление.ВидыАгентскихДоговоров.Нерезидент");
		Иначе
			Объект.ВидАгентскогоДоговора = ?(
			ИсполняютсяОбязанностиНалоговогоАгентаПоНДС,
			ПредопределенноеЗначение("Перечисление.ВидыАгентскихДоговоров.Аренда"),
			ПредопределенноеЗначение("Перечисление.ВидыАгентскихДоговоров.РеализацияИмущества"));
		КонецЕсли;
	Иначе
		Объект.ВидАгентскогоДоговора = Неопределено;
	КонецЕсли;
	СпособЗаполненияСтавкиНДСПоУмолчанию();
	
	ДоговорыКонтрагентовФормыУХКлиентСервер.УправлениеФормойВерсияСоглашения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоДействияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Объект.НомерДополнительногоСоглашения = 1 
		И ЗначениеЗаполнено(ВыбранноеЗначение) И ВыбранноеЗначение < Объект.Дата 
		И ПоказатьЦУЗ(Объект.ВидДоговораУХ, Объект.ВидСоглашения, ИспользуетсяУправлениеЗакупками) 
		Тогда
		СтруктураПараметров = Новый Структура();      
		СтруктураПараметров.Вставить("СтараяДата",Объект.ДатаНачалаДействия);
		СтруктураПараметров.Вставить("НоваяДата",ВыбранноеЗначение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьНачалоДействия", ЭтотОбъект,СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'Будет изменена дата версии соглашения. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьНачалоДействия(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда 
    	Объект.ДатаНачалаДействия = Параметры.СтараяДата;
	Иначе  
		Объект.ДатаНачалаДействия = Параметры.НоваяДата;  
		Объект.Дата = Параметры.НоваяДата;  
		ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры) 
	
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Параметры.НоваяДата);    
	Если Параметры.НоваяДата > Параметры.СтараяДата Тогда
	    ТаблицаСМэппингом = ПланированиеПотребностей.ЗаменаСтатейИАналитикПоНастройкамЛимитов(Параметры.НоваяДата,Объект.Номенклатура.Выгрузить());
		Объект.Номенклатура.Очистить();
		Объект.Номенклатура.Загрузить(ТаблицаСМэппингом);
	Иначе
		Для Каждого Строка Из Объект.Номенклатура Цикл
			Строка.СтатьяБюджета = Неопределено;
			Строка.Аналитика1 = Неопределено;
			Строка.Аналитика2 = Неопределено;
			Строка.Аналитика3 = Неопределено;
			Строка.Аналитика4 = Неопределено;
			Строка.Аналитика5 = Неопределено;
			Строка.Аналитика6 = Неопределено;
		КонецЦикла;	
	КонецЕсли;	
	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата) <> Неопределено Тогда
		Если ВидСтатьи <> Неопределено И Элементы.Найти("ПланПоставокПоПериодамСтатьяБюджета") <> Неопределено Тогда
			Элементы.ПланПоставокПоПериодамСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;
			Элементы.ПланыДокументаНоменклатураСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;   
		Иначе 
			Если Элементы.Найти("ПланПоставокПоПериодамСтатьяБюджета") <> Неопределено Тогда
				Элементы.ПланПоставокПоПериодамСтатьяБюджета.Видимость  = Ложь;
				Элементы.ПланыДокументаНоменклатураСтатьяБюджета.Видимость = Ложь;   
			Иначе   
				УстановитьОформлениеСтатейИАналитикПланаПоставокПоДоговорам();  
				УстановитьОформлениеСтатейИАналитикНоменклатуры();    
			КонецЕсли;	
		КонецЕсли;   
	КонецЕсли;	
	Элементы.Переместить(Элементы.ПланыДокументаГруппаСтатьяИАналитики,Элементы.ПланПоставокПоПериодам);
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаВерсииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.НомерДополнительногоСоглашения = 1 
		И ЗначениеЗаполнено(Объект.ДатаНачалаДействия) И Объект.ДатаНачалаДействия < ВыбранноеЗначение 
		И ПоказатьЦУЗ(Объект.ВидДоговораУХ, Объект.ВидСоглашения, ИспользуетсяУправлениеЗакупками) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Дата версии соглашения не может быть больше начала действия'");
		Сообщение.Поле = "Объект.Дата";
		Объект.Дата = Объект.ДатаНачалаДействия;  
		СтандартнаяОбработка = Ложь;
		Сообщение.Сообщить();
	ИначеЕсли ПоказатьЦУЗ(Объект.ВидДоговораУХ, Объект.ВидСоглашения, ИспользуетсяУправлениеЗакупками) И ВидСтатьиБюджетирования(ВыбранноеЗначение) <> УХ_ВидСтатьи Тогда    
		СтруктураПараметров = Новый Структура();      
		СтруктураПараметров.Вставить("СтараяДата",Объект.Дата);
		СтруктураПараметров.Вставить("НоваяДата",ВыбранноеЗначение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьСтатьиПоМэппингу", ЭтотОбъект,СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'По настройкам планирования закупок дата документа попадает в период с другими настройками планирования. Данные по статье будут изменены или очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);        
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ДатаВерсииОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если Текст = "  .  .       :  :  " Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.НомерДополнительногоСоглашения = 1 
		И ЗначениеЗаполнено(Объект.ДатаНачалаДействия) И Объект.ДатаНачалаДействия < Дата(Текст) 
		И ПоказатьЦУЗ(Объект.ВидДоговораУХ, Объект.ВидСоглашения, ИспользуетсяУправлениеЗакупками) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Дата версии соглашения не может быть больше начала действия'");
		Сообщение.Поле = "Объект.Дата";
		Объект.Дата = Объект.ДатаНачалаДействия;  
		СтандартнаяОбработка = Ложь;
		Сообщение.Сообщить();
	ИначеЕсли ПоказатьЦУЗ(Объект.ВидДоговораУХ, Объект.ВидСоглашения, ИспользуетсяУправлениеЗакупками) И ВидСтатьиБюджетирования(Дата(Текст)) <> УХ_ВидСтатьи Тогда    
		СтруктураПараметров = Новый Структура();      
		СтруктураПараметров.Вставить("СтараяДата",Объект.Дата);
		СтруктураПараметров.Вставить("НоваяДата",Дата(Текст));
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьСтатьиПоМэппингу", ЭтотОбъект,СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'По настройкам планирования закупок дата документа попадает в период с другими настройками планирования. Данные по статье будут изменены или очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе 	
		Объект.Дата = Дата(Текст);
	КонецЕсли;	 
	
КонецПроцедуры

&НаСервере
Функция ВидСтатьиБюджетирования(Дата)
	Возврат ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Дата);	
КонецФункции 

&НаКлиенте
Процедура ПерезаполнитьСтатьиПоМэппингу(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
    	Объект.Дата = Параметры.СтараяДата;
	Иначе            
		Объект.Дата = Параметры.НоваяДата;
		ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры);
		ДатаВерсииПриИзмененииНаСервере();
		ДоговорыКонтрагентовФормыУХКлиентСервер.УправлениеФормойВерсияСоглашения(ЭтотОбъект);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_БезакцептноеСписаниеНадписьНажатие(Элемент, СтандартнаяОбработка)
	
	ДоговорыКонтрагентовФормыУХКлиент.БезакцептноеСписаниеНадписьНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);

