	СтруктураПоискаНоменклатуры.Вставить("Приоритет");
	СтруктураПоискаНоменклатуры.Вставить("ДоговорСПокупателем");
	СтруктураПоискаНоменклатуры.Вставить("Менеджер");  
	СтруктураПоискаНоменклатуры.Вставить("Назначение");	
	СтруктураПоискаНоменклатуры.Вставить("СтатьяБюджета");
	СтруктураПоискаНоменклатуры.Вставить("Аналитика1");
	СтруктураПоискаНоменклатуры.Вставить("Аналитика2");
	СтруктураПоискаНоменклатуры.Вставить("Аналитика3");
	СтруктураПоискаНоменклатуры.Вставить("Аналитика4");
	СтруктураПоискаНоменклатуры.Вставить("Аналитика5");
	СтруктураПоискаНоменклатуры.Вставить("Аналитика6");
	СтруктураПоискаНоменклатуры.Вставить("Характеристика");
	СтруктураПоискаНоменклатуры.Вставить("Организация");
	СтруктураПоискаНоменклатуры.Вставить("МестоПоставки");
	СтруктураПоискаНоменклатуры.Вставить("СтраныПроисхождения");
	СтруктураПоискаНоменклатуры.Вставить("СтранаПроизводителя");
	СтруктураПоискаНоменклатуры.Вставить("НоменклатураПоставщика");
	СтруктураПоискаНоменклатуры.Вставить("ЕдиницаИзмерения");
	СтруктураПоискаНоменклатуры.Вставить("Коэффициент");
	СтруктураПоискаНоменклатуры.Вставить("Проект");
	СтруктураПоискаНоменклатуры.Вставить("Цена");
	СтруктураПоискаНоменклатуры.Вставить("СтавкаНДС");
	Для Каждого Строка Из ПланПоставокПоПериодам Цикл
		Строка.ИдентификаторСтроки = Новый УникальныйИдентификатор;		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаНоменклатуры,Строка);   
		Номенклатура = Объект.Номенклатура.НайтиСтроки(СтруктураПоискаНоменклатуры);
		Для Каждого СтрокаНом Из Номенклатура Цикл  
			СтрокаНом.ИдентификаторСтроки = Строка.ИдентификаторСтроки;	
		КонецЦикла;	
	КонецЦикла;	

КонецПроцедуры

