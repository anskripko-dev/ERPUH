#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьТекстПодсказкиПорядокЗачетаДокументов()
	ТекстПодсказки = "";
	Если Объект.ПорядокЗачетаОплатНакладных = ПредопределенноеЗначение("Перечисление.ПорядкиЗачетаОплатНакладных.ПоДатеВидуДокумента") Тогда
		ТекстПодсказки = НСтр("ru = 'По дате и виду документа – постоплаты будут сначала распределяться на накладные с минимальной датой проведения документа, накладные будут зачитывать авансы с минимальной датой документа.
		|Документы в пределах дня будут зачитываться по виду: сначала переносы авансов и задолженности, накладные,
		|возвраты товаров и корректировки накладных, оплаты, возвраты ДС и пр.';
		|en = 'By document date and type: postpayments are first allocated to invoices with the earliest document posting date. Invoices offset prepayments with the earliest document date.
		|Documents within one day are offset by type: first, prepayment and debt offsets, invoices,
		|returns of goods and invoice adjustments, payments, refunds, and so on.'");
	ИначеЕсли Объект.ПорядокЗачетаОплатНакладных = ПредопределенноеЗначение("Перечисление.ПорядкиЗачетаОплатНакладных.ПоДатеВремениДокумента") Тогда
		ТекстПодсказки = НСтр("ru = 'По дате и времени документа – постоплаты будут сначала распределяться на накладные с минимальной датой проведения документа, накладные будут зачитывать авансы с минимальной датой документа.
		|Документы в пределах дня будут зачитываться по времени проведения, типу и номеру.';
		|en = 'By document date and time: postpayments are first allocated to invoices with the earliest document posting date. Invoices offset prepayments with the earliest document date.
		|Documents within one day are offset by posting time, type, and number.'");
	ИначеЕсли Объект.ПорядокЗачетаОплатНакладных = ПредопределенноеЗначение("Перечисление.ПорядкиЗачетаОплатНакладных.ПоДатеПлановогоПогашения") Тогда
		ТекстПодсказки = НСтр("ru = 'По плановой дате погашения – постоплаты будут сначала распределяться на накладные с минимальной датой платежа, накладные будут зачитывать авансы с минимальной датой погашения.
		|Документы в пределах дня будут зачитываться по типу и номеру.';
		|en = 'By planned repayment date: postpayments are first allocated to invoices with the earliest payment date. Invoices offset prepayments with the earliest repayment date.
		|Documents within one day are offset by type and number.'");
	Иначе
		ТекстПодсказки = Константы.ПорядокЗачетаОплатНакладных.Получить();
	КонецЕсли;
	Элементы.ПорядокЗачетаОплатНакладных.Подсказка = ТекстПодсказки;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗапретПлатежаВПрочихВалютах()
	
	ЕстьКоридорКурсаНеМенее = Объект.КурсПлатежаНеМенее > 0 И Объект.КурсПлатежаНеМенееВВалютеОплаты > 0;
	ЕстьКоридорКурсаНеБолее = Объект.КурсПлатежаНеБолее  > 0 И Объект.КурсПлатежаНеБолееВВалютеОплаты > 0;
	
	Если ЕстьКоридорКурсаНеМенее ИЛИ ЕстьКоридорКурсаНеБолее Тогда     
		Объект.ЗапретПлатежаВПрочихВалютах = Истина;
	КонецЕсли;
	
	ДоговорыКонтрагентовФормыУХКлиентСервер.УправлениеФормойВерсияСоглашения(ЭтотОбъект);  

КонецПроцедуры 

&НаСервере
Процедура ОчиститьКоридорКурсовВалют()
	Если Объект.ВалютаВзаиморасчетов = Объект.ОсновнаяВалютаПлатежей
		ИЛИ Объект.СпособОпределенияКурсаПлатежа <> Перечисления.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа Тогда 
		Объект.КурсПлатежаНеМенее = 0;
		Объект.КурсПлатежаНеМенееВВалютеОплаты = 0;
		Объект.КурсПлатежаНеБолее = 0;
		Объект.КурсПлатежаНеБолееВВалютеОплаты = 0; 
		ДоговорыКонтрагентовФормыУХКлиентСервер.ПересчитатьИтоговыеКурсыВалютногоКоридора(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ОчиститьСдвигДатыФиксацииКурсаПлатежа()
	Если Объект.СпособОпределенияКурсаПлатежа <> Перечисления.СпособыОпределенияКурсаПлатежа.КурсНаДатуПлатежа Тогда 
		Объект.СдвигДатыФиксацииКурсаПлатежа = 0;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОчиститьДатуФиксацииКурсаПлатежа()
	Если Объект.СпособОпределенияКурсаПлатежа <> Перечисления.СпособыОпределенияКурсаПлатежа.КурсНаФиксированнуюДату Тогда 
		Объект.ДатаФиксацииКурсаПлатежа = Дата("00010101");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОчиститьЗависимыеЗначения()

	ОчиститьКоридорКурсовВалют();
	ОчиститьСдвигДатыФиксацииКурсаПлатежа();   
	ОчиститьДатуФиксацииКурсаПлатежа();   

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействияПослеУстановкиИнтервала(Результат, ДополнительныеПараметры) Экспорт

	ПриИзмененииПериодаДействия("ДатаНачалаДействия");
	ПриИзмененииПериодаДействия("ДатаОкончанияДействия"); 

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСпособаОпределенияКурсаПлатежаНаСервере()
	ПроверитьКурсВалютыДоговора();
	ЗаполнитьЗначенияКурсаВалютыДоговора();
	УправлениеЭлементамиВариантКурсаДоговора();
	ОчиститьЗависимыеЗначения();
КонецПроцедуры

&НаСервере 
Процедура УстановитьОформлениеСтатейИАналитикПланаПоставокПоДоговорам()
	
	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);

	МассивОписанийСтатей = Новый Массив;   
	
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
	"ПланПоставокПоПериодам", "ПланПоставокПоПериодам",
	"СтатьяБюджета", "ПланПоставокПоПериодамСтатьяБюджета",
	"Аналитика%1", "ПланПоставокПоПериодамАналитика%1",
	ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ПланыДокументаГруппаСтатьяИАналитики)); 
	ДобавляемыеРеквизиты = Новый Массив;
	АналитикиСтатейБюджетовУХ.ДобавитьРеквизитОписанияФормы(ДобавляемыеРеквизиты);

	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		Если ТипЗнч(ОписаниеСтатьи.Параметры) = Тип("Структура")
			И ОписаниеСтатьи.Параметры.Свойство("СоздаватьРеквизитыВидАналитики")
			И ОписаниеСтатьи.Параметры.СоздаватьРеквизитыВидАналитики = Ложь Тогда
			Продолжить; // Не создаем реквизиты ВидАналитики%1*
		КонецЕсли;
		
		// Добавляем реквизиты формы ВидАналитики%1*
		Для Поз = 1 По ОписаниеСтатьи.КолвоАналитик Цикл
			ИмяРеквизита = СтрШаблон(ОписаниеСтатьи.Аналитики.ВидАналитикиИмяРеквизита, Поз);
			Если НЕ РеквизитУжеДобавлен(ДобавляемыеРеквизиты, ИмяРеквизита, ОписаниеСтатьи.Аналитики.ВидАналитикиПуть) Тогда
				АналитикиСтатейБюджетовУХ.ДобавитьРеквизитыВидаАналитики(ДобавляемыеРеквизиты, ИмяРеквизита, "ПланПоставокПоПериодам");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;         
	ДобавляемыеРеквизиты.Удалить(0);         
	Попытка
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	Исключение
	КонецПопытки;
    СобытияПоляВвода = Неопределено;
	
	ОписаниеФормы = АналитикиСтатейБюджетовУХ.ПолучитьОписаниеФормы(ЭтаФорма);
	Если ОписаниеФормы = Неопределено Тогда
		// Добавляем описания статей бюджетов в реквизит формы
		ОписаниеФормы = Новый Структура;
		ОписаниеФормы.Вставить("СтатьиБюджетов", Новый Соответствие);
		ОписаниеФормы.Вставить("Реквизиты", Новый Соответствие);
		ОписаниеФормы.Вставить("ТаблицыФормы", Новый Соответствие);
		ОписаниеФормы.Вставить("АналитикиСтатейБюджетов", Новый Соответствие);
	Иначе
		ОписаниеФормы = Новый Структура(ОписаниеФормы);
	КонецЕсли;
	
	//
	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		ИмяРеквизита = ОписаниеСтатьи.ИмяРеквизита;
		Если НЕ ПустаяСтрока(ОписаниеСтатьи.ПутьКДанным) Тогда
			ИмяРеквизита = ОписаниеСтатьи.ПутьКДанным + "."+ИмяРеквизита;
		КонецЕсли;
		
		ОписаниеФормы.Реквизиты.Вставить(ИмяРеквизита, ОписаниеСтатьи);
		
		Для Каждого КлючЗначения Из ОписаниеСтатьи.ЭлементыФормы Цикл
			
			ОписаниеЭлемента = КлючЗначения.Значение;
			
			ОписаниеФормы.СтатьиБюджетов.Вставить(КлючЗначения.Ключ, ОписаниеСтатьи);
			
			Для НомерАналитики = 1 По ОписаниеЭлемента.ЭлементыАналитики.Количество() Цикл
				ЭлементАналитики = ОписаниеЭлемента.ЭлементыАналитики[НомерАналитики-1];
				ОписаниеАналитики = Новый Структура("СтатьяБюджета, НомерАналитики", КлючЗначения.Ключ, НомерАналитики);
				ОписаниеФормы.АналитикиСтатейБюджетов.Вставить(ЭлементАналитики.ИмяЭлемента, ОписаниеАналитики);
			КонецЦикла;
			
			// ТаблицыФормы
			Если ОписаниеЭлемента.ЭтоТаблицаФормы И ЗначениеЗаполнено(ОписаниеЭлемента.ИмяТаблицыФормы) Тогда
				
				Данные = ОписаниеФормы.ТаблицыФормы[ОписаниеЭлемента.ИмяТаблицыФормы];
				Если Данные = Неопределено Тогда
					ОписаниеФормы.ТаблицыФормы.Вставить(ОписаниеЭлемента.ИмяТаблицыФормы, Новый Массив);
				КонецЕсли;
				ОписаниеФормы.ТаблицыФормы[ОписаниеЭлемента.ИмяТаблицыФормы].Добавить(ОписаниеСтатьи);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ЭтаФорма.ОписаниеФормы = Новый ФиксированнаяСтруктура(ОписаниеФормы);
	
	#Область ДобавлениеЭлементовФормы
	
	//
	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		Для каждого КлючЗначение Из ОписаниеСтатьи.ЭлементыФормы Цикл
			
			ОписаниеЭлемента = КлючЗначение.Значение;
		
			//
			Родитель = Элементы.Найти(ОписаниеЭлемента.ИмяРодителя);
			ВставитьПеред = Элементы.Найти(ОписаниеЭлемента.ИмяВставитьПеред);
			
			//
			ПутьКДанным = ОписаниеСтатьи.ИмяРеквизита;
			Если ОписаниеЭлемента.ПутьКДанным <> "" Тогда
				ПутьКДанным = ОписаниеЭлемента.ПутьКДанным + "." + ПутьКДанным;
			КонецЕсли;
			ПутьКДанным = "ПланПоставокПоПериодам.СтатьяБюджета";
			// Добавить статью бюджетов
			ЭлементСтатья = ДобавитьЭлементСтатьяБюджета(
				ЭтаФорма, 
				ОписаниеЭлемента.ИмяЭлемента, ПутьКДанным,
				Родитель, 
				ВставитьПеред,
				ПараметрыПоляВводаШапки);
				
			ПриИзменении = ЭлементСтатья.ПолучитьДействие("ПриИзменении");
			Если ПустаяСтрока(ПриИзменении) Тогда
				ПереопределениеСобытийФормы.ПереопределитьСобытиеЭлементаФормы(ЭтаФорма, ЭлементСтатья, "ПриИзменении", "Подключаемый_НоменклатураСтатьяБюджета_ПриИзменении");
			КонецЕсли;      
			ПараметрыГруппы = Новый Структура();
			ПараметрыГруппы.Вставить("Группировка",ГруппировкаКолонок.Горизонтальная);
			ЭлементГруппы = ФормыУХ.СоздатьГруппуФормы(ЭтаФорма.Элементы,"ПланПоставокПоПериодамГруппаСтатей",,
			ВидГруппыФормы.ГруппаКолонок,Элементы.ПланыДокументаГруппаСтатьяИАналитики,,ПараметрыГруппы);
			
			// Добавить аналитики
			Для каждого ОписаниеЭлементаАналитика Из ОписаниеЭлемента.ЭлементыАналитики Цикл
			
				ПутьКДанным = ОписаниеЭлементаАналитика.ИмяРеквизита;
				Если ОписаниеЭлементаАналитика.ПутьКДанным <> "" Тогда
					ПутьКДанным = ОписаниеЭлементаАналитика.ПутьКДанным + "." + ПутьКДанным;
				КонецЕсли;
				
				//
				Родитель = Элементы.Найти(ОписаниеЭлементаАналитика.ИмяРодителя);
				ВставитьПеред = Элементы.Найти(ОписаниеЭлементаАналитика.ИмяВставитьПеред);

				Элемент = ФормыУХ.СоздатьПолеФормы(
					ЭтаФорма.Элементы, 
					ОписаниеЭлементаАналитика.ИмяЭлемента,
					ОписаниеЭлементаАналитика.ИмяРеквизита,
					ПутьКДанным, 
					ВидПоляФормы.ПолеВвода, 
					ЭлементГруппы, ВставитьПеред, 
					ПараметрыПоляВводаШапки, СобытияПоляВвода);
				//
				ПутьКДанным = ОписаниеЭлементаАналитика.ИмяРеквизитаВидАналитики;
				Если ОписаниеЭлементаАналитика.ПутьКВидамАналитик <> "" Тогда
					ПутьКДанным = ОписаниеЭлементаАналитика.ПутьКВидамАналитик + "." + ПутьКДанным;
				КонецЕсли;
				
				Элемент.СвязьПоТипу = Новый СвязьПоТипу(ПутьКДанным, 0);
				
			КонецЦикла;
			// Добавить условное оформление
			Если ОписаниеЭлемента.ЭтоТаблицаФормы Тогда
				УстановитьУсловноеОформлениеДополнительныхАналитик(ЭтаФорма, ОписаниеЭлемента);
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	#КонецОбласти 
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);	
	
	ФормыУХ.ОформитьЭлементыТаблицыФормы(Элементы.ПланыДокументаГруппаСтатьяИАналитики);
	
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);
	Элементы.ПланПоставокПоПериодамСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;   
	Для Каждого Элемент Из Элементы.ПланыДокументаГруппаСтатьяИАналитики.Подчиненныеэлементы Цикл
		Если Элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
		Элемент.ЦветФона = Новый Цвет();               
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры  

&НаСервере 
Процедура УстановитьОформлениеСтатейИАналитикНоменклатуры()
	
	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);

	МассивОписанийСтатей = Новый Массив;   
	
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
		"Объект.Номенклатура", "Номенклатура",
		"СтатьяБюджета", "ПланыДокументаНоменклатураСтатьяБюджета",
		"Аналитика%1", "ПланыДокументаАналитика%1",
		ФормыУХ.РазместитьВГруппеСтрокой(Элементы.НоменклатураСтатьяБюджета)); 
	ДобавляемыеРеквизиты = Новый Массив;
	АналитикиСтатейБюджетовУХ.ДобавитьРеквизитОписанияФормы(ДобавляемыеРеквизиты);

	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		Если ТипЗнч(ОписаниеСтатьи.Параметры) = Тип("Структура")
			И ОписаниеСтатьи.Параметры.Свойство("СоздаватьРеквизитыВидАналитики")
			И ОписаниеСтатьи.Параметры.СоздаватьРеквизитыВидАналитики = Ложь Тогда
			Продолжить; // Не создаем реквизиты ВидАналитики%1*
		КонецЕсли;
		
		// Добавляем реквизиты формы ВидАналитики%1*
		Для Поз = 1 По ОписаниеСтатьи.КолвоАналитик Цикл
			ИмяРеквизита = СтрШаблон(ОписаниеСтатьи.Аналитики.ВидАналитикиИмяРеквизита, Поз);
			Если НЕ РеквизитУжеДобавлен(ДобавляемыеРеквизиты, ИмяРеквизита, ОписаниеСтатьи.Аналитики.ВидАналитикиПуть) Тогда
				АналитикиСтатейБюджетовУХ.ДобавитьРеквизитыВидаАналитики(ДобавляемыеРеквизиты, ИмяРеквизита, "Объект.Номенклатура");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;         
	ДобавляемыеРеквизиты.Удалить(0);         
	Попытка
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	Исключение
	КонецПопытки;
	
    СобытияПоляВвода = Неопределено;
	
	ОписаниеФормы = АналитикиСтатейБюджетовУХ.ПолучитьОписаниеФормы(ЭтаФорма);
	Если ОписаниеФормы = Неопределено Тогда
		// Добавляем описания статей бюджетов в реквизит формы
		ОписаниеФормы = Новый Структура;
		ОписаниеФормы.Вставить("СтатьиБюджетов", Новый Соответствие);
		ОписаниеФормы.Вставить("Реквизиты", Новый Соответствие);
		ОписаниеФормы.Вставить("ТаблицыФормы", Новый Соответствие);
		ОписаниеФормы.Вставить("АналитикиСтатейБюджетов", Новый Соответствие);
	Иначе
		ОписаниеФормы = Новый Структура(ОписаниеФормы);
	КонецЕсли;
	
	//
	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		ИмяРеквизита = ОписаниеСтатьи.ИмяРеквизита;
		Если НЕ ПустаяСтрока(ОписаниеСтатьи.ПутьКДанным) Тогда
			ИмяРеквизита = ОписаниеСтатьи.ПутьКДанным + "."+ИмяРеквизита;
		КонецЕсли;
		
		ОписаниеФормы.Реквизиты.Вставить(ИмяРеквизита, ОписаниеСтатьи);
		
		Для Каждого КлючЗначения Из ОписаниеСтатьи.ЭлементыФормы Цикл
			
			ОписаниеЭлемента = КлючЗначения.Значение;
			
			ОписаниеФормы.СтатьиБюджетов.Вставить(КлючЗначения.Ключ, ОписаниеСтатьи);
			
			Для НомерАналитики = 1 По ОписаниеЭлемента.ЭлементыАналитики.Количество() Цикл
				ЭлементАналитики = ОписаниеЭлемента.ЭлементыАналитики[НомерАналитики-1];
				ОписаниеАналитики = Новый Структура("СтатьяБюджета, НомерАналитики", КлючЗначения.Ключ, НомерАналитики);
				ОписаниеФормы.АналитикиСтатейБюджетов.Вставить(ЭлементАналитики.ИмяЭлемента, ОписаниеАналитики);
			КонецЦикла;
			
			// ТаблицыФормы
			Если ОписаниеЭлемента.ЭтоТаблицаФормы И ЗначениеЗаполнено(ОписаниеЭлемента.ИмяТаблицыФормы) Тогда
				
				Данные = ОписаниеФормы.ТаблицыФормы[ОписаниеЭлемента.ИмяТаблицыФормы];
				Если Данные = Неопределено Тогда
					ОписаниеФормы.ТаблицыФормы.Вставить(ОписаниеЭлемента.ИмяТаблицыФормы, Новый Массив);
				КонецЕсли;
				ОписаниеФормы.ТаблицыФормы[ОписаниеЭлемента.ИмяТаблицыФормы].Добавить(ОписаниеСтатьи);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ЭтаФорма.ОписаниеФормы = Новый ФиксированнаяСтруктура(ОписаниеФормы); 
	
	#Область ДобавлениеЭлементовФормы
	
	//
	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		Для каждого КлючЗначение Из ОписаниеСтатьи.ЭлементыФормы Цикл
			
			ОписаниеЭлемента = КлючЗначение.Значение;
		
			//
			Родитель = Элементы.Найти(ОписаниеЭлемента.ИмяРодителя);
			ВставитьПеред = Элементы.Найти(ОписаниеЭлемента.ИмяВставитьПеред);
			
			//
			ПутьКДанным = ОписаниеСтатьи.ИмяРеквизита;
			Если ОписаниеЭлемента.ПутьКДанным <> "" Тогда
				ПутьКДанным = ОписаниеЭлемента.ПутьКДанным + "." + ПутьКДанным;
			КонецЕсли;
			ПутьКДанным = "Объект.Номенклатура.СтатьяБюджета";
			// Добавить статью бюджетов
			ЭлементСтатья = ДобавитьЭлементСтатьяБюджета(
				ЭтаФорма, 
				ОписаниеЭлемента.ИмяЭлемента, ПутьКДанным,
				Родитель, 
				ВставитьПеред,
				ПараметрыПоляВводаШапки);
				
			ПриИзменении = ЭлементСтатья.ПолучитьДействие("ПриИзменении");
			Если ПустаяСтрока(ПриИзменении) Тогда
				ПереопределениеСобытийФормы.ПереопределитьСобытиеЭлементаФормы(ЭтаФорма, ЭлементСтатья, "ПриИзменении", "Подключаемый_НоменклатураСтатьяБюджета_ПриИзменении");
			КонецЕсли;
			
			// Добавить аналитики
			Для каждого ОписаниеЭлементаАналитика Из ОписаниеЭлемента.ЭлементыАналитики Цикл
			
				//
				ПутьКДанным = ОписаниеЭлементаАналитика.ИмяРеквизита;
				Если ОписаниеЭлементаАналитика.ПутьКДанным <> "" Тогда
					ПутьКДанным = ОписаниеЭлементаАналитика.ПутьКДанным + "." + ПутьКДанным;
				КонецЕсли;
				
				//
				Родитель = Элементы.Найти(ОписаниеЭлементаАналитика.ИмяРодителя);
				ВставитьПеред = Элементы.Найти(ОписаниеЭлементаАналитика.ИмяВставитьПеред);
				
				Элемент = ФормыУХ.СоздатьПолеФормы(
					ЭтаФорма.Элементы, 
					ОписаниеЭлементаАналитика.ИмяЭлемента,
					ОписаниеЭлементаАналитика.ИмяРеквизита,
					ПутьКДанным, 
					ВидПоляФормы.ПолеВвода, 
					Родитель, ВставитьПеред, 
					ПараметрыПоляВводаШапки, СобытияПоляВвода);
				
				//
				ПутьКДанным = ОписаниеЭлементаАналитика.ИмяРеквизитаВидАналитики;
				Если ОписаниеЭлементаАналитика.ПутьКВидамАналитик <> "" Тогда
					ПутьКДанным = ОписаниеЭлементаАналитика.ПутьКВидамАналитик + "." + ПутьКДанным;
				КонецЕсли;
				
				Элемент.СвязьПоТипу = Новый СвязьПоТипу(ПутьКДанным, 0);
				
				// Установка при изменении
				
			КонецЦикла;
			
			// Добавить условное оформление
			Если ОписаниеЭлемента.ЭтоТаблицаФормы Тогда
				УстановитьУсловноеОформлениеДополнительныхАналитик(ЭтаФорма, ОписаниеЭлемента);
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	#КонецОбласти 
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);	
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);
	Элементы.ПланыДокументаНоменклатураСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;
	Элементы.Переместить(Элементы.ПланыДокументаГруппаСтатьяИАналитики, Элементы.ПланПоставокПоПериодам);
	
КонецПроцедуры  

&НаСервере
Функция РеквизитУжеДобавлен(ДобавляемыеРеквизиты, ИмяРеквизита, Путь)
	
	Для Каждого Реквизит Из ДобавляемыеРеквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита И Реквизит.Путь = Путь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_НоменклатураСтатьяБюджета_ПриИзменении(Элемент)
	
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеДополнительныхАналитик(Форма, ОписаниеЭлементаСтатья)
	
	//
	Если НЕ ОписаниеЭлементаСтатья.ЭтоТаблицаФормы Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОписаниеАналитики Из ОписаниеЭлементаСтатья.ЭлементыАналитики Цикл
		
		ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеИспользуется(
			Форма.УсловноеОформление.Элементы, ОписаниеАналитики.ИмяЭлемента, 
			ОписаниеАналитики.ПутьКДанным + "." + ОписаниеАналитики.ИмяРеквизитаВидАналитики,
			ОписаниеЭлементаСтатья.СкрыватьНезаданныеАналитикиСтатьиБюджета);
			
		ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеЗаполнена(
			Форма.УсловноеОформление.Элементы, ОписаниеАналитики.ИмяЭлемента, 
			ОписаниеАналитики.ПутьКДанным + "." + ОписаниеАналитики.ИмяРеквизита,
			ОписаниеАналитики.ПутьКДанным + "." + ОписаниеАналитики.ИмяРеквизитаВидАналитики );
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьЭлементСтатьяБюджета(Форма, КолонкаСтатья, ПутьКДанным, Родитель, ВставитьПеред, ПараметрыЭлемента = Неопределено, СобытияЭлемента = Неопределено)
	
	ЭлементыФормы = Форма.Элементы;
	
	Элемент = ЭлементыФормы.Найти(КолонкаСтатья);
	Если Элемент = Неопределено Тогда
		Элемент = ФормыУХ.СоздатьПолеФормы(
			ЭлементыФормы, 
			КолонкаСтатья, "", ПутьКДанным, ВидПоляФормы.ПолеВвода, 
			Родитель, ВставитьПеред, 
			ПараметрыЭлемента, СобытияЭлемента);
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

&НаСервере
Процедура ОбновитьФактическиеДанныеНаСервере()
	
	СтруктураДействий = Новый Структура("ЗагружатьФакт");
	ОбновитьГрафикНаСервере(СтруктураДействий);
	ФинансовыеИнструментыФормыКлиентСервер.УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция ВестиУчетПоСтранамКорпоративныеЗакупки()
	Возврат ПолучитьФункциональнуюОпцию("ВестиУчетПоСтранамКорпоративныеЗакупки") ИЛИ Объект.Организация.ЗакупкаПоФЗ223;	
КонецФункции	

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ДоговорыКонтрагентовФормыУХ.ДобавитьЭлементыУсловногоОформленияГрафикРасчетов(ЭтотОбъект);
	Элементы.ПланПоставокПоПериодамСтраныПроисхождения.Видимость = ВестиУчетПоСтранамКорпоративныеЗакупки();	
	Элементы.ПланПоставокПоПериодамСтранаПроизводителя.Видимость = ВестиУчетПоСтранамКорпоративныеЗакупки();
	Элементы.ПланПоставокПоПериодамНоменклатураПоставщика.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьНоменклатуруПоставщика");
	Элементы.ДлительностьДоставки.Видимость = Объект.ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СПоставщиком");
	Элементы.ФормаАнализГрафикаРасчетов.Видимость = Объект.ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СПоставщиком");	
	Элемент = УсловноеОформление.Элементы.Добавить();
		ДобавитьПолеУО(
			Элемент, 
			"ПланПоставокПоПериодамКоличество");
		ДобавитьПолеУО(
			Элемент, 
			"ПланПоставокПоПериодамЦена");
		ДобавитьОтборЭлементаУО(
			Элемент,
			"ПланПоставокПоПериодам.ЭтоКатегорияНоменклатуры",
			Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент = УсловноеОформление.Элементы.Добавить();
		ДобавитьПолеУО(
			Элемент, 
			"ПланПоставокПоПериодам");
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Истина);      
	Элементы.ГруппаНоменклатураВертикально.ТолькоПросмотр = СквозноеПланированиеПотребности;
	Элементы.ГруппаАтрибутыПотребности.ТолькоПросмотр = СквозноеПланированиеПотребности;
	Элементы.ГруппаИтогиКоличество.ТолькоПросмотр = СквозноеПланированиеПотребности;	
 	Элементы.СтраницаПланЗакупок.Видимость = Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок"); 
	Для Каждого Строка Из Объект.Номенклатура Цикл    
		Строка.ХарактеристикиИспользуются = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ХарактеристикиИспользуются(Строка.Номенклатура);;
	КонецЦикла;		
КонецПроцедуры

&НаСервере
Функция ДобавитьОтборЭлементаУО(ЭлементУО, 
								ЛевоеЗначение, 
								ПравоеЗначение, 
								Сравнение = Неопределено) Экспорт
	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(
			Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение);
	Если Сравнение = Неопределено Тогда
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Иначе
		ОтборЭлемента.ВидСравнения = Сравнение;
	КонецЕсли;
	ОтборЭлемента.ПравоеЗначение = ПравоеЗначение;
	Возврат ОтборЭлемента;
КонецФункции

&НаСервере
Процедура ДобавитьПолеУО(ЭлементУО, ИмяПоля)

	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(
		ЭлементУО.Поля, ИмяПоля);
		
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеПодразделение()
	
	Элемент = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Подразделение.Имя);
	
	ГруппаОтбораИли = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбораИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	//++ Устарело_Переработка24
	ОтборЭлемента = ГруппаОтбораИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипДоговора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ТипыДоговоров.СДавальцем;
	//-- Устарело_Переработка24
	
	ОтборЭлемента = ГруппаОтбораИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипДоговора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ТипыДоговоров.СДавальцем2_5;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Подразделение");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	Элемент = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Подразделение.Имя);
	
	ГруппаОтбораИли = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбораИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	ГруппаОтбораИ = ГруппаОтбораИли.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбораИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	//++ Устарело_Переработка24
	ОтборЭлемента = ГруппаОтбораИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипДоговора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ТипыДоговоров.СДавальцем;
	//-- Устарело_Переработка24
	
	ОтборЭлемента = ГруппаОтбораИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипДоговора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ТипыДоговоров.СДавальцем2_5;
	
	ОтборЭлемента = ГруппаОтбораИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Подразделение");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);

КонецПроцедуры

