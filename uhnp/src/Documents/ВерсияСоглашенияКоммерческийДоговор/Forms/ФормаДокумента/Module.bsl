&НаСервере
Функция ДозаполнитьТаблицуПотребностейИзРезультатаЗапроса(РезультатЗапроса)
	ЦентрализованныеЗакупкиУХ.ДозаполнитьТаблицуПотребностейИзРезультатаЗапроса(
		ПланПоставокПоПериодам, 
		РезультатЗапроса,
		ЦентрализованныеЗакупкиКлиентСерверУХ.ИменаКлючевыхПолейВерсииСоглашенияКоммерческийДоговор());
	ЦентрализованныеЗакупкиКлиентСерверУХ.ПересчитатьИтоговыеПоказателиКроссТаблицы(
	    ПланПоставокПоПериодам,
		ЭтаФорма.ПериодыЗакупок,
		Объект.ЦенаВключаетНДС);
		
	ОбновитьСуммуДоговораИзГрафиков(ЭтаФорма);
	Возврат Истина;
КонецФункции

// Выставляет в сумму договору итоги по графикам расчетов и графикам поставок.
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСуммуДоговораИзГрафиков(Форма)  
	
	НуженГрафик = Форма.ОперацииГрафика <> Неопределено;
	Объект = Форма.Объект;
	Если Не НуженГрафик Тогда
		Возврат;
	КонецЕсли;
	ИтогПоставок = Форма.ПланПоставокПоПериодам.Итог("Сумма");
	ИтогРасчетов = Форма.ГрафикРасчетов.Итог("СуммаОплата");
	Если Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок") 
			ИЛИ Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикРасчетов") Тогда
		ИтогРасчетов = Форма.ГрафикРасчетов.Итог("СуммаОплата");
	Иначе
		ИтогРасчетов = 0;
	КонецЕсли;
	СуммаПоГрафикам = Макс(ИтогПоставок, ИтогРасчетов);
	Если НЕ (Форма.ФиксированнаяСуммаДоговора И Объект.Сумма > СуммаПоГрафикам) Тогда
		Объект.Сумма = СуммаПоГрафикам;
	Иначе
		// Сумма договора фиксирована и больше суммы по графикам. Не изменяем её.
	КонецЕсли;
	
КонецПроцедуры// ОбновитьСуммуДоговораИзГрафиков()

&НаСервере
Процедура ОбновитьКроссТаблицуПотребностейНаСервере()
	ЦентрализованныеЗакупкиУХ.ОбновитьКроссТаблицуПотребностей(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);     
	Если Элементы.Найти("ПланыДокументаГруппаСтатьяИАналитики") <> Неопределено Тогда    
		АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);	
		Элементы.Переместить(Элементы.ПланыДокументаГруппаСтатьяИАналитики,Элементы.ПланПоставокПоПериодам);
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОбновитьСуммуДокументаИзКроссТаблицы(Форма)
	Форма.Объект.Сумма = Форма.ПланПоставокПоПериодам.Итог("Сумма");
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПроверитьОбновитьСуммуДокументаИзКроссТаблицы()
	
	Если Не ФиксированнаяСуммаДоговора Тогда
		ОбновитьСуммуДоговораИзГрафиков(ЭтаФорма);
		ДоговорыКонтрагентовФормыУХКлиент.ПриИзмененииСуммыДоговора(ЭтотОбъект, Неопределено);
		ПриОжиданииВыполнитьКонтрольДокумента();
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПланПоставокПоПериодамНоменклатураПриИзменении(Элемент)
	ЦентрализованныеЗакупкиКлиентУХ.ТиповойОбработчикНоменклатураПриИзменении(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);
	ЦентрализованныеЗакупкиКлиентУХ.ТиповойОбработчикСтавкаНДСПриИзменении(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);
	ПроверитьОбновитьСуммуДокументаИзКроссТаблицы();   
	УстановитьВыборЦФОФН();
	УстановитьЕдинственноеЦФОФН(); 
	УстановитьДоступнуюСтатьюТаблицыПланаПоставок();
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, "ПланПоставокПоПериодамСтатьяБюджета");
	ТекДанные = Элементы.ПланПоставокПоПериодам.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ИзменитьДанныеТабличнойЧастиНоменклатуры(ТекДанные.ИдентификаторСтроки); 
		ТекДанные.РучноеИзменение = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПланПоставокПоПериодамХарактеристикаПриИзменении(Элемент) 
	ТекДанные = Элементы.ПланПоставокПоПериодам.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекДанные.РучноеИзменение = Истина;
	КонецЕсли;	
	
	ЦентрализованныеЗакупкиКлиентУХ.ТиповойОбработчикХарактеристикаПриИзменении(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);
КонецПроцедуры

&НаКлиенте
Процедура ПланПоставокПоПериодамЕдиницаИзмеренияПриИзменении(Элемент)
	ЦентрализованныеЗакупкиКлиентУХ.ТиповойОбработчикЕдиницаИзмеренияПриИзменении(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);
	ПроверитьОбновитьСуммуДокументаИзКроссТаблицы();
КонецПроцедуры

&НаКлиенте
Процедура ПланПоставокПоПериодамЦенаПриИзменении(Элемент)
	ТекДанные = Элементы.ПланПоставокПоПериодам.ТекущиеДанные;
	Если ТипЗнч(ТекДанные.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		Если Объект.ЦенаВключаетНДС Тогда
			СуммаБазовая = ТекДанные.Количество * ТекДанные.Цена;
		Иначе                                   
			СтавкаНДС = УчетНДСУПВызовСервера.ЗначениеСтавкиНДС(ТекДанные.СтавкаНДС);
			СуммаБазовая = ТекДанные.Количество * ТекДанные.Цена*(СтавкаНДС+100)/100;
		КонецЕсли;	
		ТекДанные.Сумма = СуммаБазовая;
		СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
			ТекДанные.Сумма, 
			Объект.ЦенаВключаетНДС,	
			УчетНДСУПВызовСервера.ЗначениеСтавкиНДС(
				ТекДанные.СтавкаНДС)); 
		ТекДанные.СуммаНДС = СуммаНДС; 
	ИначеЕсли ТипЗнч(ТекДанные.Номенклатура) = Тип("СправочникСсылка.ТоварныеКатегории")
		ИЛИ ТипЗнч(ТекДанные.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда
		СуммаБазовая = ТекДанные.Цена;
		ТекДанные.Сумма = СуммаБазовая;
		СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
			ТекДанные.Сумма, 
			Объект.ЦенаВключаетНДС,	
			УчетНДСУПВызовСервера.ЗначениеСтавкиНДС(
				ТекДанные.СтавкаНДС)); 
		ТекДанные.СуммаНДС = СуммаНДС; 
		
	КонецЕсли;	
	ЦентрализованныеЗакупкиКлиентУХ.ТиповойОбработчикСтавкаНДСПриИзменении(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланПоставокПоПериодамСтавкаНДСПриИзменении(Элемент)
	ЦентрализованныеЗакупкиКлиентУХ.ТиповойОбработчикСтавкаНДСПриИзменении(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);
	ПроверитьОбновитьСуммуДокументаИзКроссТаблицы();       
	Элементы.ПланПоставокПоПериодамСумма.ТекстПодвала = ПланПоставокПоПериодам.Итог("Сумма");
	Элементы.ПланПоставокПоПериодамСуммаНДС.ТекстПодвала = ПланПоставокПоПериодам.Итог("СуммаНДС");
	
