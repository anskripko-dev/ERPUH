&НаСервере
Функция РезультатПроверкиСуммРасчетов()
	
	Если ФиксированнаяСуммаДоговора Тогда
		
		Если Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок") 
				ИЛИ Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикРасчетов") Тогда
			ИтогРасчетов = ГрафикРасчетов.Итог("СуммаОплата");                                               
		ИначеЕсли Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.Резервирование") Тогда
			ТаблицаДвиженияОперации = Объект.ДвиженияОперации.Выгрузить();
			ТаблицаДвиженияОперации.Свернуть("ВидБюджета","Сумма");
			ИтогРасчетов = 0;
			Для каждого СтрокаТаблица Из ТаблицаДвиженияОперации Цикл
				ИтогРасчетов = Макс(ИтогРасчетов, СтрокаТаблица.Сумма);			
			КонецЦикла;
		Иначе
			ИтогРасчетов = 0;
		КонецЕсли;  
		
		Если ИтогРасчетов = 0 Тогда 
			Возврат Истина;
		ИначеЕсли ИтогРасчетов > Объект.Сумма Тогда   
			Возврат Ложь;			
		Иначе
			Возврат Истина;
		КонецЕсли;	

	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

