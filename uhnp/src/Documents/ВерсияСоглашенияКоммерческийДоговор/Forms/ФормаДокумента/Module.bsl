&НаСервере
Процедура ЗагрузитьИзмененияНоменклатуры()

	Номенклатура = Объект.Номенклатура.Выгрузить();
	ЦентрализованныеЗакупкиКлиентСерверУХ.ПодготовитьЗаполнитьТаблицуИзКроссТаблицы(
	ПланПоставокПоПериодам.Выгрузить(Новый Структура("РучноеИзменение",Истина)),
	Объект.Номенклатура,
	ЭтаФорма.ПериодыЗакупок,
	Объект.ЦенаВключаетНДС);
	Для Каждого Строка Из Номенклатура Цикл
		Доб = Объект.Номенклатура.Добавить();
		ЗаполнитьЗначенияСвойств(Доб,Строка);
	КонецЦикла;	
	Для Каждого Строка Из ПланПоставокПоПериодам Цикл
		Строка.РучноеИзменение = Ложь;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура РежимКроссТаблицы(Команда)
	
	ЗаполнитьСуммыТаблицыПоНДС();
	ИнициализироватьЦентрализованныеЗакупки();
	Элементы.ПланПоставокПоПериодам.Видимость = Истина;
	Элементы.Номенклатура.Видимость = Ложь; 
	УстановитьОформлениеИдентификаторовПланаИНоменклатуры();
	
КонецПроцедуры

