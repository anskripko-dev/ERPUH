Процедура ДвиженияОперацииСтатьяБюджетаПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииАналитикиСтатьиБюджета(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииАналитикиСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияОперацииПриИзменении(Элемент)
	ПриОжиданииВыполнитьКонтрольДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияОперацииВидБюджетаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДвиженияОперации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДанныеСтрокиДвиженийОперацииПоУмолчанию(ТекущиеДанные, ТекущиеДанные.ВидБюджета); 
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПолучитьНоменклатуру()
 
	 Потребности = Объект.Номенклатура.Выгрузить();  
	 КолВоСтрок = Потребности.Количество() - 1;
	 Пока КолВоСтрок >= 0 Цикл	 
		Если НЕ ЗначениеЗаполнено(Потребности[КолВоСтрок].АналитикаИсточника) Тогда
			Потребности.Удалить(КолВоСтрок);
		Иначе
			Потребности[КолВоСтрок].Цена = Потребности[КолВоСтрок].АналитикаИсточника.Цена;	 
       	КонецЕсли; 
		КолВоСтрок = КолВоСтрок - 1;
	 КонецЦикла;	 
	 АдресВременногоХранилища = ПоместитьВоВременноеХранилище(
		Потребности, 
		Новый УникальныйИдентификатор());
    Возврат АдресВременногоХранилища;
	
КонецФункции

&НаКлиенте
Процедура ПланПоставокПоПериодамПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если СквозноеПланированиеПотребности Тогда
		ТекстСообщения = НСтр("ru = 'Корректировка данных табличной части (Добавление,удаление) доступно через ""Подбор из потребностей""'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Отказ = Истина;   
	КонецЕсли;
КонецПроцедуры

#Область ОбработчикиСобытийЭлементовТаблицыФормыПланОплаты

&НаКлиенте
Процедура КомандаПереходаКОплатеНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ЭтоДоговорСПоставщиком 			= РаботаСДоговорамиКонтрагентовУХКлиентСервер.ЭтоДоговорСПоставщиком(Объект.ВидДоговораУХ);
	ЭтоДоговорСПокупателем 			= РаботаСДоговорамиКонтрагентовУХКлиентСервер.ЭтоДоговорСПокупателем(Объект.ВидДоговораУХ);
	ЭтоДоговорСКомиссионером 		= РаботаСДоговорамиКонтрагентовУХКлиентСервер.ЭтоДоговорСКомиссионером(Объект.ВидДоговораУХ);
	ЭтоРеализацияЧерезКомиссонера	= (Объект.ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.Страхование"));
	ЭтоСтрахование		 			= (Объект.ВидДоговораУХ = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.РеализацияЧерезКомиссионера"));
	
	Если Не ЭтоДоговорСПоставщиком И Не ЭтоДоговорСПокупателем И Не ЭтоДоговорСКомиссионером И НЕ ЭтоСтрахование И НЕ ЭтоРеализацияЧерезКомиссонера Тогда
		Возврат;
	КонецЕсли;
		
	Попытка
		ЗаблокироватьДанныеФормыДляРедактирования();
	Исключение
		ПоказатьПредупреждение(Неопределено, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ПорядокРасчетов",           Объект.ПорядокРасчетов);
	ПараметрыФормы.Вставить("Календарь", Неопределено);
	ПараметрыФормы.Вставить("ЭтоВерсияСоглашения");
	ПараметрыФормы.Вставить("ХозяйственнаяОперация",     Объект.ХозяйственнаяОперация);
	ПараметрыФормы.Вставить("УникальныйИдентификатор",   УникальныйИдентификатор);
	ПараметрыФормы.Вставить("АдресВоВременномХранилище", ПоместитьЭтапыГрафикаОплатыВоВременноеХранилищеНаСервере());
	ПараметрыФормы.Вставить("ТолькоПросмотр",            ТолькоПросмотр);
	ПараметрыФормы.Вставить("СпособРасчетаКоличестваДней ", Объект.СпособРасчетаКоличестваДней);
	
	ПараметрыОплаты = Неопределено;
	
	ИмяФормыСоглашения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Справочник.%1.Форма.ФормаОплаты", 
							?(ЭтоДоговорСПоставщиком, "СоглашенияСПоставщиками", "СоглашенияСКлиентами"));

	ФормаОплаты = ПолучитьФорму(ИмяФормыСоглашения, ПараметрыФормы, ЭтаФорма);

	ВариантОтсчета = ФормаОплаты.Элементы.ЭтапыГрафикаОплатыВариантОтсчета.СписокВыбора;
	ПараметрыФормы.Вставить("ВариантОтсчета", ВариантОтсчета.ВыгрузитьЗначения());	
	
	ВариантОплаты = ?(ЭтоДоговорСПоставщиком, 
					Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыКонтроляОплатыПоставщику"), 
					Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыКонтроляОплатыКлиентом"));
	ПараметрыФормы.Вставить("ВариантОплаты", ВариантОплаты);
	
	ПараметрыФормы.Вставить("АдресВоВременномХранилище", ПоместитьЭтапыГрафикаОплатыВоВременноеХранилищеНаСервере());
	
	Оповещение = Новый ОписаниеОповещения("НадписьОплатаНажатиеЗавершение", ЭтотОбъект);
	ОткрытьФорму("Обработка.КорпоративныеЗакупкиФормы.Форма.ФормаОплаты", 
		ПараметрыФормы, ЭтаФорма, ,	, ,	Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
		
КонецПроцедуры 
			
&НаКлиенте
Процедура НадписьОплатаНажатиеЗавершение(ПараметрыОплаты, ДополнительныеПараметры) Экспорт

	Если ПараметрыОплаты = Неопределено Тогда
		Возврат;	
	КонецЕсли;	
	
	Модифицированность = Истина;
	
	Объект.ЭтапыГрафикаОплаты.Очистить();
	
	Объект.СпособРасчетаКоличестваДней = ПараметрыОплаты.СпособРасчетаКоличестваДней;
	
	Если ЗначениеЗаполнено(ПараметрыОплаты.АдресВоВременномХранилище) Тогда
		ЗаполнитьЭтапыОплатыИзВременногоХранилищаСервер(ПараметрыОплаты.АдресВоВременномХранилище);
	КонецЕсли;
	
	НадписьОплата = НадписьОплата(Объект.СпособРасчетаКоличестваДней, Объект.ЭтапыГрафикаОплаты.Количество());
	
	СоглашениеПриИзмененииНаСервере();
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтаФорма, "ПараметрыКроссТаблицыПотребностей") = Истина Тогда
		
		Для Каждого Строка Из ПланПоставокПоПериодам Цикл
			ЦентрализованныеЗакупкиКлиентСерверУХ.ОбработатьИзменениеЦеныКроссТаблицы(
			Объект.ЦенаВключаетНДС,
			ЭтаФорма.ПериодыЗакупок,
			Строка);
		КонецЦикла;
		
		ПроверитьОбновитьСуммуДокументаИзКроссТаблицы(); 
		
	КонецЕсли;   
	
КонецПроцедуры   

&НаСервере
Функция ПоместитьЭтапыГрафикаОплатыВоВременноеХранилищеНаСервере()
	
	Возврат ПоместитьВоВременноеХранилище(Объект.ЭтапыГрафикаОплаты.Выгрузить());
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НадписьОплата(СпособРасчетаКоличестваДней, КоличествоЭтаповОплаты)
	
	НадписьОплата = НСтр("ru = 'Этапов оплаты: %КоличествоЭтаповОплаты%, %СпособРасчетаКоличестваДней%';
						|en = 'Payment steps: %КоличествоЭтаповОплаты%, %СпособРасчетаКоличестваДней%'");
	
	Если СпособРасчетаКоличестваДней = ПредопределенноеЗначение("Перечисление.СпособыРасчетаКоличестваДнейВПериоде.ПоРабочимДням") Тогда
		СпособРасчетаКоличестваДнейТекст = НСтр("ru = 'по рабочим дням';
												|en = 'on workdays'")   
	Иначе     
		СпособРасчетаКоличестваДнейТекст = НСтр("ru = 'по календарным дням';
												|en = 'by calendar days'") 
	КонецЕсли;
	
	НадписьОплата = СтрЗаменить(НадписьОплата, "%СпособРасчетаКоличестваДней%", СпособРасчетаКоличестваДнейТекст);

	НадписьОплата = СтрЗаменить(НадписьОплата, "%КоличествоЭтаповОплаты%", КоличествоЭтаповОплаты);
	
	Возврат НадписьОплата;

КонецФункции

&НаСервере
Процедура ЗаполнитьЭтапыОплатыИзВременногоХранилищаСервер(АдресВоВременномХранилище)
	
	ЭтапыОплаты = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	Объект.ЭтапыГрафикаОплаты.Загрузить(ЭтапыОплаты);
	
КонецПроцедуры  

#КонецОбласти

&НаСервереБезКонтекста
Функция ПроверитьФлагиПартнераКлиентПоставщик(Партнер, ХозяйственнаяОперация, ЭтоНовый)
	
	ТекстСообщения = "";
	Отказ          = Ложь;
	
	Если ЗначениеЗаполнено(Партнер) Тогда
		ОперацииЗакупки						  = ЗакупкиСервер.ХозяйственныеОперацииПоОсновной(Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика);
		ОперацииИмпорта						  = ЗакупкиСервер.ХозяйственныеОперацииПоОсновной(Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту);
		ОперацииВСтранахЕАЭС 				  = ЗакупкиСервер.ХозяйственныеОперацииПоОсновной(Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС);
		ОперацииПроизводстваУПереработчика2_5 = ЗакупкиСервер.ХозяйственныеОперацииПоОсновной(Перечисления.ХозяйственныеОперации.ПроизводствоУПереработчика2_5);
		
		ФлагиПартнера = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Партнер, "Клиент, Поставщик");
		
		Если ФлагиПартнера.Клиент <> Истина И ФлагиПартнера.Поставщик <> Истина Тогда
			Отказ = Истина;
			
			Если ЭтоНовый Тогда
				ТекстСообщения = НСтр("ru = 'Создание договора возможно для партнеров с признаками ""Клиент/Поставщик""';
										|en = 'Contract may be created for partners with the ""Customer/Provider"" flags'");
			Иначе
				ТекстСообщения = НСтр("ru = 'Для выбранного партнера должен быть установлен признак ""Клиент/Поставщик""';
										|en = 'The selected partner must have the Customer/Vendor checkbox selected'");
			КонецЕсли;
			
		ИначеЕсли ФлагиПартнера.Клиент <> Истина 
					И (ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту
					
						//++ НЕ УТКА
						//++ Устарело_Переработка24
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья
						//-- Устарело_Переработка24
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья2_5
						//-- НЕ УТКА
						
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаХранениеСПравомПродажи
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоставкаПодПринципала
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера) Тогда
			Отказ = Истина;
			
			Если ЭтоНовый Тогда
				ТекстСообщения = НСтр("ru = 'Создание договора с клиентом возможно для партнеров с признаком ""Клиент""';
										|en = 'You can create a customer contract with partners that have the ""Customer"" type'");
			Иначе
				ТекстСообщения = НСтр("ru = 'Для выбранного партнера должен быть установлен признак ""Клиент""';
										|en = 'The selected partner must have the Customer checkbox selected'");
			КонецЕсли;
			
		ИначеЕсли ФлагиПартнера.Поставщик <> Истина
					И (ОперацииЗакупки.Найти(ХозяйственнаяОперация) <> Неопределено
						Или ОперацииИмпорта.Найти(ХозяйственнаяОперация) <> Неопределено
						Или ОперацииВСтранахЕАЭС.Найти(ХозяйственнаяОперация) <> Неопределено
						
						//++ НЕ УТ
						//++ Устарело_Переработка24
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоУПереработчика
						//-- Устарело_Переработка24
						Или ОперацииПроизводстваУПереработчика2_5.Найти(ХозяйственнаяОперация) <> Неопределено
						//-- НЕ УТ

						//++ НЕ УТКА
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья2_5
						//-- НЕ УТКА
						
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию
						Или ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаХранениеСПравомПродажи) Тогда
			Отказ = Истина;
			
			Если ЭтоНовый Тогда
				ТекстСообщения = НСтр("ru = 'Создание договора с поставщиком возможно для партнеров с признаком ""Поставщик""';
										|en = 'You can create a contract with vendor only with partners that have the ""Vendor"" type'");
			Иначе
				ТекстСообщения = НСтр("ru = 'Для выбранного партнера должен быть установлен признак ""Поставщик""';
										|en = 'The selected partner must have the Vendor checkbox selected'");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат Не Отказ;

КонецФункции

&НаСервере
Функция ДоступностьФиксированногоКурсаНаДатуОтгрузки()
	
	РасчетыКомиссия25 = (Объект.КомиссионныеПродажи25 И Не Объект.ВестиРасчетыЧерезКонечныхПокупателей
		Или Объект.ТипДоговора = Перечисления.ТипыДоговоров.РеализацияЧерезКомиссионера);
	
	Возврат Не (Объект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов
			Или Объект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам И Не РасчетыКомиссия25);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПорядокОформленияСписанияТоваровПринятыхНаХранение()

	ТипДоговора = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(Объект.ВидДоговораУХ, "ВидДоговора"); 
	
	Если ТипДоговора <> Перечисления.ТипыДоговоров.СПоклажедателем
		И ТипДоговора <> Перечисления.ТипыДоговоров.СДавальцем2_5 Тогда
		
		Объект.ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение = Перечисления.ПорядокОформленияСписанияТоваровПринятыхНаХранение.ПустаяСсылка();
		Объект.ПорядокОформленияСписанияВПроизводствоТоваровПринятыхНаХранение = Перечисления.ПорядокОформленияСписанияТоваровПринятыхНаХранение.ПустаяСсылка();
		
	Иначе
		Объект.ПорядокОформленияСписанияНедостачТоваровПринятыхНаХранение = Перечисления.ПорядокОформленияСписанияТоваровПринятыхНаХранение.ОформлятьСписание;
		Объект.ПорядокОформленияСписанияВПроизводствоТоваровПринятыхНаХранение = Перечисления.ПорядокОформленияСписанияТоваровПринятыхНаХранение.ОформлятьВыкуп;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеКомандамиСпискаФайлов()

	МетаданныеСправочникаСФайлами =	Метаданные.Справочники.ДоговорыКонтрагентовПрисоединенныеФайлы;
	
	Если Не ПравоДоступа("Редактирование", МетаданныеСправочникаСФайлами) Или ТолькоПросмотр Тогда
		
		ИменаКоманд = ИменаКомандИзмененияОбъектов();
		Для каждого ИмяЭлементаФормы Из ИменаЭлементовКнопокФормы Цикл
			
			ЭлементФормы = Элементы.Найти(ИмяЭлементаФормы);
			Если ИменаКоманд[ЭлементФормы.ИмяКоманды] <> Неопределено Тогда
				ЭлементФормы.Видимость = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		Элементы.ДобавитьФайлПоШаблонуДоговора.Видимость = Ложь;
		Элементы.СписокКонтекстноеМенюДобавитьФайлПоШаблонуДоговора.Видимость = Ложь; 
		
		#Область УХ_Встраивание
	Иначе
		ИменаКоманд = ИменаКомандИзмененияОбъектов();		
		Для каждого ИмяЭлементаФормы Из ИменаЭлементовКнопокФормы Цикл
			
			ЭлементФормы = Элементы.Найти(ИмяЭлементаФормы);
			Если ИменаКоманд[ЭлементФормы.ИмяКоманды] <> Неопределено Тогда
				ЭлементФормы.Видимость = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Элементы.ГруппаДобавитьФайлПоШаблонуДоговора.Видимость = Истина;      
		Элементы.СписокКонтекстноеМенюГруппаДобавитьФайлПоШаблонуДоговора.Видимость = Истина; 
		#КонецОбласти
		
	КонецЕсли;

КонецПроцедуры

 
#КонецОбласти
