Процедура ЦенаВключаетНДСПриИзменении(Элемент)
	
	СоглашениеПриИзмененииНаСервере();

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтаФорма, "ПараметрыКроссТаблицыПотребностей") = Истина  Тогда
		//Для Каждого Строка Из ПланПоставокПоПериодам Цикл
		//	ЦентрализованныеЗакупкиКлиентСерверУХ.ОбработатьИзменениеЦеныКроссТаблицы(
		//	Объект.ЦенаВключаетНДС,
		//	ЭтаФорма.ПериодыЗакупок,
		//	Строка);
		//КонецЦикла;   
		УХ_ОбработатьИзменениеФлагаЦенаВключаетНДСНаСервере();		
		ПроверитьОбновитьСуммуДокументаИзКроссТаблицы();
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура УХ_ОбработатьИзменениеФлагаЦенаВключаетНДСНаСервере()
	Если Элементы.ПланПоставокПоПериодам.Видимость Тогда
	ЦентрализованныеЗакупкиУХ.ТиповойОбработчикПриИзмененииЦенаВключаетНДС(
		ЭтаФорма,
		ЭтаФорма.ПараметрыКроссТаблицыПотребностей);    
	КонецЕсли;	
	Для Каждого СтрокаТаблицы ИЗ Объект.Номенклатура Цикл   
		СтрокаТаблицы.СуммаНДС =
			УчетНДСКлиентСервер.РассчитатьСуммуНДС(
			СтрокаТаблицы.Сумма, 
			Истина,	
			ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(СтрокаТаблицы.СтавкаНДС, "Ставка"));
		
		СуммаДляРасчетаЦены = СтрокаТаблицы.Сумма
			- ?(Объект.ЦенаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
		СтрокаТаблицы.Цена = СуммаДляРасчетаЦены 
			/ ?(СтрокаТаблицы.Количество = 0, 1, СтрокаТаблицы.Количество);
	КонецЦикла;	
		
КонецПроцедуры

