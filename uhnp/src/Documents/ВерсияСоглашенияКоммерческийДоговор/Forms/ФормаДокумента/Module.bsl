Процедура РассчитатьПоСуммеПоставокЗавершение(Результат, Параметры)Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда  
		
		ПараметрыРасчетаПоСуммеПоставок = Результат; 
		РассчитатьПоСуммеПоставокНаСервере();
		
	КонецЕсли;

