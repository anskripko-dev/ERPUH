
#Область ПеременныеФормы
&НаКлиенте
Перем ИсходнаяДатаСтроки;
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Параметры.Свойство("ПроверкаПриСозданииДоговора", ПроверкаПриСозданииДоговора);
	
	ВзаиморасчетыСервер.ФормаПриСозданииНаСервере(ЭтотОбъект);

	ОписаниеГрафика = Документы.ВерсияСоглашенияКоммерческийДоговор.ОписаниеГрафика(Объект.ВидДоговораУХ);
	
	ДоговорыКонтрагентовФормыУХ.ПриСозданииНаСервереВерсииСоглашения(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	ДоговорыКонтрагентовВстраиваниеУХ.ПриСозданииНаСервереВерсияСоглашенияКоммерческийДоговор(
		ЭтотОбъект, Отказ, СтандартнаяОбработка);

	ОповеститьОСозданииОбъектаРасчетов = Параметры.ОповеститьОСозданииОбъектаРасчетов;
	
	Если ЗначениеЗаполнено(Объект.Претензия) Тогда
		Элементы.ГрафикРасчетов.ТолькоПросмотр = Истина;
		Элементы.ГрафикРасчетовЛинейный.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ДоговорыКонтрагентовФормыУХ.ИнициализироватьПереченьОперацийГрафика(ЭтотОбъект);

	УстановитьФункциональныеОпцииФормы();	

	УстановитьУсловноеОформление();

	РежимРедактирования = НЕ Объект.Проведен;

	Если Объект.ДоговорКонтрагента <> Неопределено Тогда
		АктуальнаяВерсия = РегистрыСведений.ВерсииГрафиковРасчетов.ПолучитьАктуальнуюВерсиюФинансовогоИнструмента(Объект.ДоговорКонтрагента);
	КонецЕсли;
	
	ГрафикДоговораДоИзменения = Объект.ГрафикДоговора;
	
	#Область УХ_ЦентрализованныеЗакупки 
	Если Параметры.Свойство("ЗначенияЗаполнения") И Параметры.ЗначенияЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(Параметры.ЗначенияЗаполнения.ДокументОснование) = ТИП("ДокументСсылка.ПредложениеПоставщика") Тогда
		Объект.ЦенаВключаетНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ЗначенияЗаполнения.ДокументОснование,"ЦенаВключаетНДС");
	КонецЕсли;
	Массив = Новый Массив(); 
	Массив.Добавить(Тип("СправочникСсылка.КатегорииЗакупок"));   
	Массив.Добавить(Тип("СправочникСсылка.Номенклатура")); 	  
	ОписаниеВыбора = Новый ОписаниеТипов(Массив);  
	Элементы.НоменклатураНоменклатура.ОграничениеТипа = ОписаниеВыбора; 
	Элементы.ПланПоставокПоПериодамНоменклатура.ОграничениеТипа = ОписаниеВыбора; 
	Если Параметры.Свойство("ЗначенияЗаполнения") И  Параметры.Свойство("АдресНоменклатуры") Тогда
		Объект.Номенклатура.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресНоменклатуры));
	КонецЕсли;    
	ПриЗаполненииПотребностей();  
	Если Параметры.Свойство("ЗначенияЗаполнения") И  Параметры.ЗначенияЗаполнения.Свойство("Лот") Тогда
		Для Каждого Строка Из Объект.Номенклатура Цикл
			Строка.Лот = Параметры.ЗначенияЗаполнения.Лот;	
			Строка.ПериодПотребности = СформироватьПериодПоГодуИМесяцу(Месяц(Строка.ДатаПоставки), Год(Строка.ДатаПоставки));
		КонецЦикла;                          
		Объект.Организация  =  ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Параметры.ЗначенияЗаполнения.Лот, "ОрганизацияДляЗаключенияДоговора");
		Объект.ЭтапыГрафикаОплаты.Загрузить(Параметры.ЗначенияЗаполнения.Лот.ЭтапыГрафикаОплаты.Выгрузить());
		ОрганизацияПриИзмененииНаСервере();
	КонецЕсли;
	ИнициализироватьЦентрализованныеЗакупки();
	Если ИспользуетсяУправлениеЗакупками Тогда
		ОбновитьРеквизитыФормыЗакупокПоОрганизации();
		УстановитьПредложениеПоставщикаПобедителяПоЛоту();
	КонецЕсли;  
	Элементы.ПланПоставокПоПериодамСумма.ТекстПодвала = ПланПоставокПоПериодам.Итог("Сумма");
	Элементы.ПланПоставокПоПериодамСуммаНДС.ТекстПодвала = ПланПоставокПоПериодам.Итог("СуммаНДС");
	УстановитьРазмерКонтрагентаДляЕИСУХНаСервере();
	ПериодичностьЗакупок = ЦентрализованныеЗакупкиУХ.ПолучитьПериодичностьЗакупок();
	ЦентрализованныеЗакупкиУправлениеФормой();
	Если Не Элементы.Найти("ПланПоставокПоПериодамГруппаРеквизитов") = Неопределено Тогда
		Элементы.ПланПоставокПоПериодамГруппаРеквизитов.ТолькоПросмотр = СквозноеПланированиеПотребности;
	КонецЕсли;
	УстановитьВыборЦФОФН();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		УстановитьЕдинственноеЦФОФН();
	КонецЕсли;
	УХ_ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);    
	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата) <> Неопределено Тогда
		УстановитьОформлениеСтатейИАналитикПланаПоставокПоДоговорам();  
		УстановитьОформлениеСтатейИАналитикНоменклатуры();
	КонецЕсли;
	Элементы.ПланПоставокПоПериодам.КонтекстноеМеню.ПодчиненныеЭлементы.ПланПоставокПоПериодамКонтекстноеМенюДобавить.Доступность = НЕ СквозноеПланированиеПотребности;	
	Элементы.ПланПоставокПоПериодам.КоманднаяПанель.ПодчиненныеЭлементы.ПланПоставокПоПериодамДобавить.Доступность = НЕ СквозноеПланированиеПотребности;
	Элементы.Номенклатура.КонтекстноеМеню.ПодчиненныеЭлементы.НоменклатураКонтекстноеМенюДобавить.Доступность = НЕ СквозноеПланированиеПотребности;
	Элементы.Номенклатура.КоманднаяПанель.ПодчиненныеЭлементы.НоменклатураДобавить.Доступность = НЕ СквозноеПланированиеПотребности;
	Элементы.Номенклатура.Видимость = Ложь;   
	УстановитьОформлениеИдентификаторовПланаИНоменклатуры();  
	
	УсловноеОформлениеФормы = ЭтаФорма.УсловноеОформление;
	
	ЭлементУсловногоОформления = УсловноеОформлениеФормы.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураХарактеристика.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Номенклатура.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	НадписьОплата = НадписьОплата(Объект.СпособРасчетаКоличестваДней, Объект.ЭтапыГрафикаОплаты.Количество());
	Если ЗначениеЗаполнено(Объект.БазовыйДоговор) Тогда
		БазовыйДоговорСГрафикомПоставок = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ЭтоДоговорСПланомПоставок(Объект.БазовыйДоговор);
	ИначеЕсли ЗначениеЗаполнено(Объект.ДоговорКонтрагента) И ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		БазовыйДоговорСГрафикомПоставок = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ЭтоДоговорСПланомПоставок(Объект.ДоговорКонтрагента);
	КонецЕсли;	
	#КонецОбласти   
	
	Если Параметры.Свойство("ЗначенияЗаполнения") И  Параметры.ЗначенияЗаполнения.Свойство("Дата") Тогда
		ДоговорОбъект.Дата 	= Параметры.ЗначенияЗаполнения.Дата;
	КонецЕсли;   
	Если Параметры.Свойство("ЗначенияЗаполнения") И  Параметры.ЗначенияЗаполнения.Свойство("Номер") Тогда
		ДоговорОбъект.Номер = Параметры.ЗначенияЗаполнения.Номер;
	КонецЕсли;

	СтараяОрганизация = Объект.Организация;

	Если Параметры.Ключ.Пустая() Тогда

		Если Не ПроверитьФлагиПартнераКлиентПоставщик(Объект.Партнер, Объект.ХозяйственнаяОперация, Истина) Тогда
			Отказ = Истина;
		КонецЕсли;
		
		ПриЧтенииСозданииНаСервере();
        УстановитьЗначенияРеквизитовДисконтирования();    
		
		Если Объект.ВидДоговораУХ = Справочники.ВидыДоговоровКонтрагентовУХ.СКомиссионером
			И ТолькоКомиссионныеПродажи25 Тогда
			Объект.КомиссионныеПродажи25 = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.КомиссионерПартнер) Тогда
			КомиссионерПартнерПриИзмененииНаСервере(); 
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Объект.ДоговорСКомиссионером) Тогда
			ДоговорСКомиссионеромПриИзмененииНаСервере();
		КонецЕсли;	
		ДатаВерсииПриИзмененииНаСервере();
		ЗаполнитьПорядокОформленияСписанияТоваровПринятыхНаХранение();
	Иначе
		// Не новый объект.
	КонецЕсли;  

	ДоговорыКонтрагентовФормыУХКлиентСервер.УправлениеФормойВерсияСоглашения(ЭтотОбъект);  
	
	УстановитьКнопкуВыбораРуководителяКонтрагента();
	
	УстановитьАвтоматическоеСозданиеПлатежныхПозиций();

	ВалютаРегламентированногоУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Объект.Организация);
	
	УправлениеЭлементамиДисконтирования();

	УправлениеЭлементамиВариантКурсаДоговора();
	
	УстановитьТекстПодсказкиПорядокЗачетаДокументов();
	
	ДоговорыКонтрагентовФормыУХКлиентСервер.УправлениеФормойВерсияСоглашения(ЭтотОбъект);
	
	ДоставкаТоваров.ЗаполнитьРеквизитыДоставки(Элементы, "СпособДоставки", Объект);

	ИнициализироватьВариантПлатежаГОЗКонтрактСЗаказчиком();  
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПриСозданииНаСервере = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаСправочника();
	ПараметрыПриСозданииНаСервере.Форма                  = ЭтотОбъект;
	ПараметрыПриСозданииНаСервере.СправочникСсылка       = Объект.ДоговорКонтрагента;
	ПараметрыПриСозданииНаСервере.МестоРазмещенияКоманд  = Элементы.КомандыЭДО;
	ПараметрыПриСозданииНаСервере.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриСозданииНаСервере.ГруппаСостояниеЭДО     = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаСправочника(ПараметрыПриСозданииНаСервере);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами		
	
	// СтандартныеПодсистемы.РаботаСФайлами
	НастроитьРаботуСписокФайлов();
    // Конец СтандартныеПодсистемы.РаботаСФайлами
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДоговорыКонтрагентовФормыУХ.ПриЧтенииНаСервереВерсииСоглашения(ЭтотОбъект, ТекущийОбъект);

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаСправочника();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.СправочникСсылка = Объект.ДоговорКонтрагента;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаСправочника(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами	
	ПрочитатьСвязанныеСОбъектомДанные(ТекущийОбъект);
	ПриЧтенииСозданииНаСервере();
	ВзаиморасчетыСервер.ФормаПриЧтенииНаСервере(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПриОткрытии = ОбменСКонтрагентамиКлиент.ПараметрыПриОткрытии();
	ПараметрыПриОткрытии.Форма = ЭтотОбъект;
	ПараметрыПриОткрытии.ЕстьОбработчикОбновитьКомандыЭДО = Истина;
	
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ПараметрыПриОткрытии);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ДоговорыКонтрагентовФормыУХКлиент.ПриОткрытииВерсииСоглашения(ЭтотОбъект, Отказ);
	
	#Область УХ_Договоры
	ДоговорыКонтрагентовФормыУХКлиентСервер.ПересчитатьИтоговыеКурсыВалютногоКоридора(ЭтотОбъект);
	#КонецОбласти	
	
	// СтандартныеПодсистемы.РаботаСФайлами
	Если ЕстьПравоДобавленияФайла Тогда
		ДоступнаКомандаСканировать = РаботаСФайламиСлужебныйКлиент.ДоступноСканирование();
		Элементы.ДобавитьФайлСоСканера.Видимость = ДоступнаКомандаСканировать;
		Элементы.СписокКонтекстноеМенюДобавитьФайлСоСканера.Видимость = ДоступнаКомандаСканировать;
	КонецЕсли;
	#Если Не МобильныйКлиент Тогда
	ДобавитьПолеПредпросмотраДокументаPDF();
	#КонецЕсли

	УстановитьДоступностьФайловыхКоманд();
	// Конец СтандартныеПодсистемы.РаботаСФайлами	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Подсистема "Свойства"
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_ГосКонтракты" И Объект.Ссылка = Параметр Тогда 	
		Объект.ГосударственныйКонтракт = Источник;
		ПриИзмененииГосударственногоКонтрактаНаСервере();	
	ИначеЕсли ИмяСобытия = "ОбъектСогласован" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти	
	ИначеЕсли ИмяСобытия = "ОбъектОтклонен" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти
	ИначеЕсли ИмяСобытия = "МаршрутИнициализирован" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти		
	ИначеЕсли ИмяСобытия = "СостояниеЗаявкиПриИзменении" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти	
	// ОПК
	ИначеЕсли ИмяСобытия = "ЗаписанаКорректировкаПланов" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("КорректируемыйДокумент") И Параметр.КорректируемыйДокумент = Объект.Ссылка Тогда
			ПриОжиданииВыполнитьКонтрольДокумента();
		КонецЕсли;
	// ОПК Конец   
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыОповещенияЭДО                        = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаСправочника();
	ПараметрыОповещенияЭДО.Форма                  = ЭтотОбъект;
	ПараметрыОповещенияЭДО.СправочникСсылка       = Объект.ДоговорКонтрагента;
	ПараметрыОповещенияЭДО.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыОповещенияЭДО.ГруппаСостояниеЭДО     = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаСправочника(ИмяСобытия, Параметр, Источник,
		ПараметрыОповещенияЭДО);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами	
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиОбработкаОповещения(ИмяСобытия, Параметр, Источник);
	// Конец СтандартныеПодсистемы.РаботаСФайлами	
	
	ДоговорыКонтрагентовФормыУХКлиент.ОбработкаОповещенияВерсииСоглашения(ЭтаФорма, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	ДоговорыКонтрагентовФормыУХКлиент.ОбработкаЗаписиНовогоВерсияСоглашения(ЭтаФорма, НовыйОбъект, Источник, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив();
	ДоговорыКонтрагентовФормыУХ.ОбработкаПроверкиЗаполненияНаСервереВерсияСоглашения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	
	Если ФиксированнаяСуммаДоговора И Объект.Сумма = 0 Тогда
		
		ТекстОшибки = НСтр("ru='Не заполнена сумма договора.'");

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстОшибки,
			Объект.Ссылка,
			"Объект.Сумма",,
			Отказ);
	КонецЕсли;
	
	//++ НЕ УТ
	Если Объект.ПлатежиПо275ФЗ Тогда
		Если Объект.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком
			И ВариантПлатежаГОЗ = 1 И Не ЗначениеЗаполнено(КонтрактСЗаказчиком) Тогда
			
			Текст = НСтр("ru = 'Поле ""Договор с заказчиком"" не заполнено.'");
			ОбщегоНазначения.СообщитьПользователю(
				Текст,,
				"КонтрактСЗаказчиком",,
				Отказ);
		КонецЕсли;
	КонецЕсли;
	//-- НЕ УТ

	Если ПрименитьСтавкуДисконтированияПоРассрочке Тогда
		
		Если Объект.СтавкаДисконтирования = 0 Тогда
			
			ТекстОшибки = НСтр("ru = 'Не заполнена ставка дисконтирования.';
								|en = 'The discounting rate is not filled in.'");
			ОбщегоНазначения.СообщитьПользователю(
				ТекстОшибки,
				Объект.Ссылка,
				"Объект.СтавкаДисконтирования",,
				Отказ);
			
		КонецЕсли;
		
	КонецЕсли;	

	Если Объект.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.УстановленныйВДоговоре
		И ЧислительКурсаВалютыДоговора = 0 Тогда
		
		ТекстОшибки = НСтр("ru = 'Не заполнен курс валюты договора.';
							|en = 'The contract exchange rate is required.'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстОшибки,
			Объект.Ссылка,
			"ЧислительКурсаВалютыДоговора",,
			Отказ);
		
	КонецЕсли;   
	
	#Область УХ_Встраивание
	Если Объект.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.УстановленныйВДоговоре
		И Объект.СпособОпределенияКурсаПлатежа = Перечисления.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс И Элементы.ГруппаКурсВалютыПлатежаУказанныйВДоговоре.Видимость
		И ЧислительКурсаВалютыПлатежаДоговора = 0 Тогда
		
		ТекстОшибки = НСтр("ru = 'Не заполнен курс валюты оплаты договора.'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстОшибки,
			Объект.Ссылка,
			"ЧислительКурсаВалютыПлатежаДоговора",,
			Отказ);
		
	КонецЕсли;  
	#КонецОбласти
	
	Если Объект.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.УстановленныйВДоговоре
		И ЗнаменательКурсаВалютыДоговора = 0 Тогда
		
		ТекстОшибки = НСтр("ru = 'Не заполнена кратность курса валюты договора.';
							|en = 'The multiplying factor of the contract exchange rate is required.'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстОшибки,
			Объект.Ссылка,
			"ЗнаменательКурсаВалютыДоговора",,
			Отказ);
		
	КонецЕсли;
	
	#Область УХ_Встраивание
	Если Объект.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.УстановленныйВДоговоре  
		И Объект.СпособОпределенияКурсаПлатежа = Перечисления.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс И Элементы.ГруппаКурсВалютыПлатежаУказанныйВДоговоре.Видимость
		И ЗнаменательКурсаВалютыПлатежаДоговора = 0 Тогда
		
		ТекстОшибки = НСтр("ru = 'Не заполнена кратность курса валюты оплаты договора.'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстОшибки,
			Объект.Ссылка,
			"ЗнаменательКурсаВалютыПлатежаДоговора",,
			Отказ);
		
	КонецЕсли;
	#КонецОбласти
		
	ИспользоватьОформлениеЗакупок = ИспользоватьОформлениеЗакупок();
	
	ВариантПриемкиОбязателенДляЗаполнения = (ИспользоватьОрдернуюСхемуПриПоступлении
												Или ИспользоватьТоварыВПутиОтПоставщиков
												Или ИспользоватьНеотфактурованныеПоставки)
												И ИспользоватьОформлениеЗакупок;
	
	Если Не ВариантПриемкиОбязателенДляЗаполнения Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("ОформлениеОрдера");
		МассивНепроверяемыхРеквизитов.Добавить("ПриемкаТоваров");
		
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	ДоговорыКонтрагентовФормыУХ.ОбработкаПроверкиЗаполненияНаСервереВерсияСоглашения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)  
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДоговорыКонтрагентовФормыУХКлиент.ПередЗаписьюВерсииСоглашения(ЭтотОбъект, Отказ, ПараметрыЗаписи);

	#Область УХ_ЦентрализованныеЗакупки
	Если ИспользуетсяУправлениеЗакупками 
			И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОшибкиПользователю = ПроверкаЗаполненияТаблицыПотребностейНаКлиенте();
		Если ОшибкиПользователю <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(
				ОшибкиПользователю,
				Отказ);
		КонецЕсли;
	КонецЕсли;
	#КонецОбласти
	
	Если Не Отказ
		И Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок")
		И Объект.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов")
		И Объект.ГрафикРасчетов.Количество() = 0 Тогда

		РассчитатьГрафикРасчетовПоГрафикуПоставок();
		
	КонецЕсли; 
	
	Если ПараметрыЗаписи.Свойство("ПропуститьПроверку") 
		И ПараметрыЗаписи.ПропуститьПроверку Тогда
		Возврат;
	КонецЕсли;

	Если НЕ РезультатПроверкиСуммРасчетов() Тогда
		
		Отказ = Истина;
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
		
		ОбработчикОповещения = Новый ОписаниеОповещения("ПроверкаСуммРасчетовЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
		
		ТекстВопроса = НСтр("ru = 'Суммы договора и графика расчетов не совпадают. Обновить сумму договора и записать?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.ОК,  НСтр("ru = 'Обновить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена'"));
		
		ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, Кнопки);
			
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	#Область УХ_ЦентрализованныеЗакупки
	Отказ = ПроверитьСтранаПроисхождения();
	Если ИспользуетсяУправлениеЗакупками Тогда
		Если ЦентрализованныеЗакупкиКлиентСерверУХ.ЭтоДопустимыйВидДоговораУХ(
			Объект.ВидДоговораУХ) Тогда   
			ЗаполнитьСуммыТаблицыПоНДС();			
						
			Для Каждого СтрокаПланаПоставки Из ТекущийОбъект.Номенклатура Цикл    
				Если НЕ ЗНачениеЗаполнено(СтрокаПланаПоставки.ДатаПоставки) Тогда
					СтрокаПланаПоставки.ДатаПоставки = ПланированиеПотребностейКлиентСервер.РассчитатьДатуОперации(СтрокаПланаПоставки.ПериодПотребности.ДатаНачала, ПериодичностьЗакупок);
				КонецЕсли;
			КонецЦикла;	
	
		КонецЕсли;
	КонецЕсли;
	#КонецОбласти

	ДоговорыКонтрагентовФормыУХ.ПередЗаписьюНаСервереВерсияСоглашения(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	ВзаиморасчетыСервер.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);	
	// Запись реквизитов 275ФЗ 
	Если ТекущийОбъект.ПлатежиПо275ФЗ Тогда
		Если ВариантПлатежаГОЗ = 1 Тогда
			ТекущийОбъект.ДоговорыСЗаказчиками.Очистить();
			НоваяСтрока = ТекущийОбъект.ДоговорыСЗаказчиками.Добавить();
			НоваяСтрока.ДоговорСЗаказчиком = КонтрактСЗаказчиком;
		КонецЕсли;
	КонецЕсли;  
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ЗаписатьЗначенияКурсаВалютыДоговора(ТекущийОбъект.ДоговорКонтрагента);   
	#Область УХ_Встраивание
	ЗаписатьЗначенияКурсаВалютыОплатыПоДоговорам(ТекущийОбъект.ДоговорКонтрагента);
	#КонецОбласти          
	
	ДоговорыКонтрагентовФормыУХ.ПриЗаписиНаСервереВерсияСоглашения(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	ЗаписатьСвязанныеСОбъектомДанные(ТекущийОбъект);	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	#Область УХ_ЦентрализованныеЗакупки
	ЗаполнитьСуммыТаблицыПоНДС();	  
	#КонецОбласти
	ДоговорыКонтрагентовФормыУХ.ПослеЗаписиНаСервереВерсияСоглашения(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		РежимРедактирования = Ложь;
	КонецЕсли;
	УстановитьКоличествоФилиалов(Элементы.ДекорацияФилиалы, Объект.Филиалы.Количество());

	ПрочитатьСвязанныеСОбъектомДанные(ТекущийОбъект);	
		
	ДоговорыКонтрагентовФормыУХКлиентСервер.УправлениеФормойВерсияСоглашения(ЭтотОбъект);   

	ОбновитьЗаголовокФормы();

	#Область УХ_ЦентрализованныеЗакупки
		УстановитьРазмерКонтрагентаДляЕИСУХНаСервере(); 
		УстановитьОформлениеИдентификаторовПланаИНоменклатуры();
	#КонецОбласти
	
	ЗаписатьТаблицуЗалогов();


	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере_ФормаСправочника();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.СправочникСсылка = Объект.ДоговорКонтрагента;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере_ФормаСправочника(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	//
	УправлениеКомандамиСпискаФайлов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ДоговорыКонтрагентовФормыУХКлиент.ПослеЗаписиВерсииСоглашения(ЭтотОбъект, ПараметрыЗаписи);
	ДоговорыКонтрагентовФормыУХКлиентСервер.УправлениеФормойВерсияСоглашения(ЭтотОбъект);

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаСправочника(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Результат = ДоговорыКонтрагентовФормыУХКлиент.ОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, ИсточникВыбора);
	Если Результат.Свойство("ОбновитьГрафикРасчетов") Тогда
		
		ОбновитьГрафикНаСервере();
		ПриОжиданииВыполнитьКонтрольДокумента(); 
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если Не ЗавершениеРаботы И ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		Если ПроверкаПриСозданииДоговора Тогда
			ДополнительныеПараметры = ОписаниеОповещенияОЗакрытии.ДополнительныеПараметры;
			ДополнительныеПараметры.Вставить("Договор", Объект.ДоговорКонтрагента)
		КонецЕсли;
		Если ОповеститьОСозданииОбъектаРасчетов Тогда
			ВзаиморасчетыКлиент.ФормаПриЗакрытии(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;КонецПроцедуры

#КонецОбласти 

#Область ОбработчикРаботыСТабличнойЧастиНоменклатуры

&НаКлиенте
Процедура ПланПоставокПоПериодамПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.Организация = Объект.Организация;
	КонецЕсли;
	Если НоваяСтрока И НЕ Копирование Тогда
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	Если Копирование Тогда
		Элемент.ТекущиеДанные.Лот = Неопределено;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПланПоставокПоПериодамПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	// Вставить содержимое обработчика.       
	Если НЕ ОтменаРедактирования Тогда
		ТекДанные = Элементы.ПланПоставокПоПериодам.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			ИзменитьДанныеТабличнойЧастиНоменклатуры(ТекДанные.ИдентификаторСтроки); 
			ТекДанные.РучноеИзменение = Истина;
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры   

&НаСервере
Процедура ИзменитьДанныеТабличнойЧастиНоменклатуры(ИдентификаторСтроки)
	
	Номенклатура = Объект.Номенклатура.Выгрузить();        
	НоменклатураДоИзменений = Номенклатура.Скопировать();
	ЦентрализованныеЗакупкиКлиентСерверУХ.ПодготовитьЗаполнитьТаблицуИзКроссТаблицы(
	ПланПоставокПоПериодам.Выгрузить(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки)),
	Номенклатура,
	ЭтаФорма.ПериодыЗакупок,
	Объект.ЦенаВключаетНДС);	
	КолСтрок = Объект.Номенклатура.Количество()-1;
	Пока КолСтрок >= 0 Цикл
		Если Объект.Номенклатура[КолСтрок].ИдентификаторСтроки =  ИдентификаторСтроки Тогда
			Объект.Номенклатура.Удалить(КолСтрок);
		КонецЕсли; 
		КолСтрок = КолСтрок - 1;
	КонецЦикла;
	ЕстьСумма = Ложь;
	Для Каждого Строка Из Номенклатура Цикл
		
		Если Строка.Сумма > 0 ИЛИ Строка.Количество > 0 Тогда    
			ЕстьСумма= Истина;
			Если ТИПЗНЧ(Строка.Номенклатура) = Тип("СправочникСсылка.ТоварныеКатегории")
				ИЛИ ТИПЗНЧ(Строка.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда        
				МассивНоменклатур = НоменклатураДоИзменений.НайтиСтроки(Новый Структура("ИдентификаторСтроки,ПериодПотребности",ИдентификаторСтроки,Строка.ПериодПотребности));	
				Если МассивНоменклатур.Количество() = 0 Тогда 
					Доб = Объект.Номенклатура.Добавить();
					ЗаполнитьЗначенияСвойств(Доб,Строка);
					Доб.ДатаПоставки = ПланированиеПотребностейКлиентСервер.РассчитатьДатуОперации(Строка.ПериодПотребности.ДатаНачала);       
				Иначе
					КолМассив = МассивНоменклатур.Количество();
					Для Каждого СтрокаМассива Из МассивНоменклатур Цикл
						Если КолМассив = 1 Тогда
							Доб = Объект.Номенклатура.Добавить();
							ЗаполнитьЗначенияСвойств(Доб,Строка);   
							Доб.ДатаПоставки = СтрокаМассива.ДатаПоставки; 
							Доб.АналитикаПланирования = СтрокаМассива.АналитикаПланирования; 
							Доб.АналитикаИсточника = СтрокаМассива.АналитикаИсточника; 
						Иначе
							КолМассив = КолМассив - 1; 
							Доб = Объект.Номенклатура.Добавить();
							ЗаполнитьЗначенияСвойств(Доб,Строка);
							Доб.ДатаПоставки = СтрокаМассива.ДатаПоставки; 
							Доб.АналитикаПланирования = СтрокаМассива.АналитикаПланирования; 
							Доб.АналитикаИсточника = СтрокаМассива.АналитикаИсточника; 
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;			
			Иначе
				МассивНоменклатур = НоменклатураДоИзменений.НайтиСтроки(Новый Структура("ИдентификаторСтроки,ПериодПотребности",ИдентификаторСтроки,Строка.ПериодПотребности));	
				Если МассивНоменклатур.Количество() = 0 Тогда 
					Доб = Объект.Номенклатура.Добавить();
					ЗаполнитьЗначенияСвойств(Доб,Строка);
					Доб.ДатаПоставки = ПланированиеПотребностейКлиентСервер.РассчитатьДатуОперации(Строка.ПериодПотребности.ДатаНачала);       
				Иначе
					КолОстаток = Строка.Количество; 
					
					КолМассив = МассивНоменклатур.Количество();
					Для Каждого СтрокаМассива Из МассивНоменклатур Цикл
						Если КолМассив = 1 Тогда
							Доб = Объект.Номенклатура.Добавить();
							ЗаполнитьЗначенияСвойств(Доб,Строка); 
							Доб.Количество = КолОстаток; 
							Если Объект.ЦенаВключаетНДС Тогда
								Доб.Сумма = Доб.Количество * Доб.Цена;
							Иначе                                   
								СтавкаНДС = УчетНДСУПВызовСервера.ЗначениеСтавкиНДС(Доб.СтавкаНДС);
								Доб.Сумма = Доб.Количество * Доб.Цена*(СтавкаНДС+100)/100;
							КонецЕсли;
							Доб.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(Доб.Сумма,Истина,
							УчетНДСУПВызовСервера.ЗначениеСтавкиНДС(Доб.СтавкаНДС)); 
							Доб.ДатаПоставки = СтрокаМассива.ДатаПоставки;    
							Доб.АналитикаПланирования = СтрокаМассива.АналитикаПланирования; 
							Доб.АналитикаИсточника = СтрокаМассива.АналитикаИсточника; 
						Иначе
							КолМассив = КолМассив - 1; 
							Доб = Объект.Номенклатура.Добавить();
							ЗаполнитьЗначенияСвойств(Доб,Строка);
							Доб.Количество = ?(СтрокаМассива.Количество < КолОстаток,СтрокаМассива.Количество,КолОстаток);
							КолОстаток = КолОстаток - Доб.Количество;
							Если Объект.ЦенаВключаетНДС Тогда
								Доб.Сумма = Доб.Количество * Доб.Цена;
							Иначе                                   
								СтавкаНДС = УчетНДСУПВызовСервера.ЗначениеСтавкиНДС(Доб.СтавкаНДС);
								Доб.Сумма = Доб.Количество * Доб.Цена*(СтавкаНДС+100)/100;
							КонецЕсли;
							Доб.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(Доб.Сумма,Истина,
							УчетНДСУПВызовСервера.ЗначениеСтавкиНДС(Доб.СтавкаНДС)); 
							Доб.ДатаПоставки = СтрокаМассива.ДатаПоставки;      
							Доб.АналитикаПланирования = СтрокаМассива.АналитикаПланирования; 
							Доб.АналитикаИсточника = СтрокаМассива.АналитикаИсточника; 
						КонецЕсли;	
						Если КолОстаток = 0 Тогда Прервать; КонецЕсли;
					КонецЦикла;	
				КонецЕсли;			
			КонецЕсли;			
		КонецЕсли;			
			
	КонецЦикла;    
	Если ЕстьСумма = Ложь И Строка <> Неопределено Тогда    
		Если ТИПЗНЧ(Строка.Номенклатура) = Тип("СправочникСсылка.ТоварныеКатегории") 
			ИЛИ ТИПЗНЧ(Строка.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда
			Доб = Объект.Номенклатура.Добавить();
			ЗаполнитьЗначенияСвойств(Доб,Строка);
			Доб.ДатаПоставки = ПланированиеПотребностейКлиентСервер.РассчитатьДатуОперации(Строка.ПериодПотребности.ДатаНачала);       
		Иначе
			МассивНоменклатур = НоменклатураДоИзменений.НайтиСтроки(Новый Структура("ИдентификаторСтроки,ПериодПотребности",ИдентификаторСтроки,Строка.ПериодПотребности));	
			Если МассивНоменклатур.Количество() = 0 И Строка.Номенклатура <> Неопределено Тогда 
				Доб = Объект.Номенклатура.Добавить();
				ЗаполнитьЗначенияСвойств(Доб,Строка);                                                                             
				Доб.ДатаПоставки = ПланированиеПотребностейКлиентСервер.РассчитатьДатуОперации(Строка.ПериодПотребности.ДатаНачала);       
			Иначе
				КолОстаток = Строка.Количество; 
				КолМассив = МассивНоменклатур.Количество();
				Для Каждого СтрокаМассива Из МассивНоменклатур Цикл
					Если КолМассив = 1 Тогда
						Доб = Объект.Номенклатура.Добавить();
						ЗаполнитьЗначенияСвойств(Доб,Строка); 
						Доб.ДатаПоставки = СтрокаМассива.ДатаПоставки;   
					Иначе
						КолМассив = КолМассив - 1; 
						Доб = Объект.Номенклатура.Добавить();
						ЗаполнитьЗначенияСвойств(Доб,Строка);
						Доб.ДатаПоставки = СтрокаМассива.ДатаПоставки;   
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;			
		КонецЕсли;	
	КонецЕсли;
		
КонецПроцедуры	

