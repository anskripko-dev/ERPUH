КонецПроцедуры  

&НаКлиенте
Процедура ПриИзмененииПериодаДействия(ИзменяемыйПериод)
	
	Если ИзменяемыйПериод = "ДатаНачалаДействия" Тогда    
		
		УстановитьРазмерКонтрагентаДляЕИСУХ();
		// Установим период закупок по умолчанию.  И (НЕ ЗначениеЗаполнено(Объект.ПериодЗакупокНачало)) 
		Если (ЗначениеЗаполнено(Объект.ДатаНачалаДействия)) Тогда
			Если ПоказатьЦУЗ(Объект.ВидДоговораУХ, Объект.ВидСоглашения, ИспользуетсяУправлениеЗакупками) Тогда
				Объект.ПериодЗакупокНачало = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(Объект.ДатаНачалаДействия, ПериодичностьЗакупок);
				ПроверитьГраницуПериодаЗакупок("ПериодЗакупокНачало", "СтарыйПериодЗакупокНачало");
			Иначе
				// Период не будет выведен. Не изменяем.
			КонецЕсли;
		Иначе
			// Не изменяем период.
		КонецЕсли;
		
	ИначеЕсли ИзменяемыйПериод = "ДатаОкончанияДействия" Тогда  
		
		// Установим период закупок по умолчанию.
		Если (ЗначениеЗаполнено(Объект.ДатаОкончанияДействия))  Тогда
			Если ПоказатьЦУЗ(Объект.ВидДоговораУХ, Объект.ВидСоглашения, ИспользуетсяУправлениеЗакупками) Тогда
				Объект.ПериодЗакупокОкончание = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(Объект.ДатаОкончанияДействия, ПериодичностьЗакупок);
				ПроверитьГраницуПериодаЗакупок("ПериодЗакупокОкончание", "СтарыйПериодЗакупокОкончание");
			Иначе
				// Период не будет выведен. Не изменяем.
			КонецЕсли;
		Иначе
			// Не изменяем период.
		КонецЕсли;           
		
		ДатаОкончанияДействияПриИзмененииСервер();  
		
	КонецЕсли;

КонецПроцедуры

