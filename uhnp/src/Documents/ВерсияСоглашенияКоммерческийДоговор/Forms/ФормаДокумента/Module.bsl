&НаСервере
Процедура РассчитатьПоСуммеПоставокНаСервере()

	ПараметрыРасчета = Документы.ВерсияСоглашенияКоммерческийДоговор.НовыйПараметрыРасчетаГрафика();
	ПараметрыРасчета.РежимРасчета = "ВесьГрафикПоСуммеПоставок";
	ПараметрыРасчета.ДополнительныеПараметры = ПараметрыРасчетаПоСуммеПоставок;
	
	Документы.ВерсияСоглашенияКоммерческийДоговор.ВыполнитьРасчетГрафика(Объект,
																		"ОсновнойДолг",
																		ОписаниеГрафика,
																		ОперацииГрафика,
																		ПараметрыРасчета);
																		
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);

	ОбновитьГрафикНаСервере();

КонецПроцедуры

&НаСервере
Функция ПоместитьПараметрыОтчетаВоВременноеХранилище()
	
	Адрес = Новый УникальныйИдентификатор;
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("АдресГрафикаРасчетов",  ПоместитьВоВременноеХранилище(Объект.ГрафикРасчетов.Выгрузить(),Адрес));
	ПараметрыОтчета.Вставить("СсылкаНаОбъект", Объект.Ссылка);
	ПараметрыОтчета.Вставить("ВидДоговораУХ", Объект.ВидДоговораУХ);

	Возврат Новый Структура("ПараметрыОтчета, СформироватьПриОткрытии", ПоместитьВоВременноеХранилище(ПараметрыОтчета, Адрес),Истина);

КонецФункции 

&НаСервере
Процедура ВидДоговораУХПриИзмененииНаСервере()
	
	ЭтотОбъект.ОсновноеОбязательство = ДоговорыКонтрагентовФормыУХ.ОсновноеОбязательствоПоДоговору(Объект.ДоговорКонтрагента, Объект.ВидДоговораУХ);
	
	#Область ЦентрализованныеЗакупкиУХ
	ОбновитьЦУЗПоВидуДоговораУХ();
	#КонецОбласти
	РаботаСДоговорамиКонтрагентовУХ.УстановитьЛимитЗадолженностиПоДоговору(Объект);  
	
	ПерезаполнитьГрафикРасчетов();
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьГрафикРасчетов()
	
	ЭтотОбъект.ОписаниеГрафика = Неопределено;
	ЭтотОбъект.ОперацииГрафика = Неопределено;
	
	ВедетсяГрафикРасчетов = РаботаСДоговорамиКонтрагентовУХПовтИсп.ВедетсяГрафикРасчетов(Объект.ВидДоговораУХ);
	
	Если ВедетсяГрафикРасчетов Тогда
		
		ОписаниеГрафика = Документы.ВерсияСоглашенияКоммерческийДоговор.ОписаниеГрафика(Объект.ВидДоговораУХ);
		ДоговорыКонтрагентовФормыУХ.ИнициализироватьПереченьОперацийГрафика(ЭтотОбъект);
		ДоговорыКонтрагентовФормыУХ.СоздатьТаблицыГрафикаНаФорме(ЭтотОбъект);
		
		Если Элементы.ГрафикДоговора.СписокВыбора.НайтиПоЗначению(Объект.ГрафикДоговора) = Неопределено Тогда
			Объект.ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикРасчетов;	
		КонецЕсли;
		
		Если Не Объект.ГрафикДоговора = Перечисления.ГрафикиДоговора.ГрафикРасчетов Тогда
			Возврат;	
		КонецЕсли;			
		
		Если ГрафикРасчетов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ДатаРасчетов = ?(ЗначениеЗаполнено(Объект.ДатаПервойОперации), 
							Объект.ДатаПервойОперации, Объект.ДатаНачалаДействия);
		
		Если Не ЗначениеЗаполнено(ДатаРасчетов) Тогда
			Возврат;
		КонецЕсли;
		
		РассчитатьОтУказаннойДатыНаСервере(ДатаРасчетов, Ложь);	
	Иначе		
		Объект.ГрафикДоговора = Перечисления.ГрафикиДоговора.НеИспользовать;
		Объект.ГрафикРасчетов.Очистить();
		ГрафикРасчетов.Очистить();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДатуДоговораСПокупателемПоУмолчанию()
	
	Если Не ЗначениеЗаполнено(ДоговорОбъект.Дата) И Параметры.Ключ.Пустая() Тогда
		ДоговорОбъект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;

КонецПроцедуры

