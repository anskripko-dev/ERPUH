		Поле.Имя = "ПланПоставокПоПериодамНоменклатура" Тогда
		ЦентрализованныеЗакупкиКлиентУХ.ОткрытьФормуНоменклатурыСтрокиКроссТаблицы(
			ПланПоставокПоПериодам,
			ВыбраннаяСтрока,
			ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполненияТаблицыПотребностейНаКлиенте()
	ОшибкиПользователю = Неопределено;
	ЦентрализованныеЗакупкиКлиентСерверУХ.ХарактеристикиЗаполненыКорректно(
	ЭтаФорма[ЭтаФорма.ПараметрыКроссТаблицыПотребностей.ПараметрыВывода.ИмяРеквизитаКроссТаблицы],
	ЭтаФорма.ПараметрыКроссТаблицыПотребностей.ПараметрыВывода.ЭлементФормыКроссТаблицы,
	"Характеристика",
	"ХарактеристикиИспользуются",
	ОшибкиПользователю);
	СтруктураИменПолей = Новый Структура;
	СтруктураИменПолей.Вставить("Номенклатура", 	НСтр("ru = 'Номенклатура'"));
	СтруктураИменПолей.Вставить("Организация", 		НСтр("ru = 'Организация'"));
	ЦентрализованныеЗакупкиКлиентСерверУХ.ПроверитьЗаполнениеПолейКроссТаблицы(
	ЭтаФорма[ЭтаФорма.ПараметрыКроссТаблицыПотребностей.ПараметрыВывода.ИмяРеквизитаКроссТаблицы],
	ЭтаФорма.ПараметрыКроссТаблицыПотребностей.ПараметрыВывода.ЭлементФормыКроссТаблицы,
	СтруктураИменПолей,
	ОшибкиПользователю);    
	Если Элементы.ПланПоставокПоПериодам.Видимость Тогда
		Для Каждого СтрокаТаблицы Из ПланПоставокПоПериодам Цикл    
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда   
				Продолжить;
			КонецЕсли;	
			ВидНоменклатуры = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(СтрокаТаблицы.Номенклатура,"ВидНоменклатуры"); 
			ЭтоУслуга = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ВидНоменклатуры,"ТипНоменклатуры") = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.МестоПоставки) 
				И НЕ ЭтоУслуга Тогда
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
				ОшибкиПользователю,
				"ПланПоставокПоПериодам" + "[%1]." + "МестоПоставки",
				СтрШаблон(НСтр("ru='Не заполнено поле %1 в строке %2'"),
				НСтр("ru = 'Место поставки'"),
				СтрокаТаблицы.НомерСтроки),
				Неопределено,
				СтрокаТаблицы.НомерСтроки-1);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого СтрокаТаблицы Из Объект.Номенклатура Цикл    
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда   
				Продолжить;
			КонецЕсли;	
			ВидНоменклатуры = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(СтрокаТаблицы.Номенклатура,"ВидНоменклатуры"); 
			ЭтоУслуга = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ВидНоменклатуры,"ТипНоменклатуры") = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.МестоПоставки) 
				И НЕ ЭтоУслуга Тогда
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
				ОшибкиПользователю,
				"Номенклатура" + "[%1]." + "МестоПоставки",
				СтрШаблон(НСтр("ru='Не заполнено поле %1 в строке %2'"),
				НСтр("ru = 'Место поставки'"),
				СтрокаТаблицы.НомерСтроки),
				Неопределено,
				СтрокаТаблицы.НомерСтроки-1);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ОшибкиПользователю;
КонецФункции

&НаКлиенте
Процедура ПланПоставокПоПериодамОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработкаВыбораПотребностей(ВыбранноеЗначение, Элемент);
	УстановитьВыборЦФОФН();
	УстановитьЕдинственноеЦФОФН();	
КонецПроцедуры

&НаСервере
Процедура ОбработкаИзмененияПотребностей(ТаблицаИзменения) Экспорт
	ТЗ = ПолучитьИзВременногоХранилища(ТаблицаИзменения);	
	Для Каждого Строка Из ТЗ Цикл
		Для Каждого Ном Из Объект.Номенклатура Цикл
			Если Ном.Номенклатура = Строка.Номенклатура И Ном.ДатаПоставки = Строка.ДатаПоставки Тогда
				Ном.Количество = Строка.Количество;
				Ном.Сумма = Строка.Сумма;
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПланПоставокПоПериодамПередУдалением(Элемент, Отказ)

	ТекДанные = Элементы.ПланПоставокПоПериодам.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекИдентификаторСтроки = ТекДанные.ИдентификаторСтроки;
		СтруктураПоиска = Новый Структура(); 
		СтруктураПоиска.Вставить("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки); 
		УдалитьЗаписьНоменклатуры(СтруктураПоиска);
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЗаписьНоменклатуры(СтруктураПоиска)
	
	КолСтрок = Объект.Номенклатура.Количество()-1;    
	Пока КолСтрок >= 0 Цикл
		Строка = Объект.Номенклатура[КолСтрок];
		СтруктураНоменклатуры = Новый Структура(); 
		СтруктураНоменклатуры.Вставить("ИдентификаторСтроки", Строка.ИдентификаторСтроки); 
 
		Если ОбщегоНазначенияУХ.СравнитьСтруктурыЗначений(СтруктураПоиска, СтруктураНоменклатуры) Тогда
			Объект.Номенклатура.Удалить(КолСтрок);
		КонецЕсли;	 
		
		КолСтрок = КолСтрок - 1;	
	КонецЦикла;   
	
КонецПроцедуры

#КонецОбласти

