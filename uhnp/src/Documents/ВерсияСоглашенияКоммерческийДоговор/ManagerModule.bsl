	              |	ПотребностиВНоменклатуре.Аналитика4Поставка КАК Аналитика4Поставка,
	              |	ПотребностиВНоменклатуре.Аналитика5Поставка КАК Аналитика5Поставка,
	              |	ПотребностиВНоменклатуре.Аналитика6Поставка КАК Аналитика6Поставка,
	              |	ПотребностиВНоменклатуре.Назначение КАК Назначение,
	              |	ПотребностиВНоменклатуре.Приоритет КАК Приоритет,
	              |	ПотребностиВНоменклатуре.Менеджер КАК Менеджер
	              |ПОМЕСТИТЬ ВТ_ПланыДокументаДляОбработки
	              |ИЗ
	              |	ВТ_НоменклатураДокумента КАК ПотребностиВНоменклатуре
	              |ГДЕ
	              |	ПотребностиВНоменклатуре.АналитикаИсточника <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)
	              |	И ПотребностиВНоменклатуре.Сумма > 0
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	              |	&Этап КАК Этап,
	              |	&ОбъектПланирования КАК ОбъектПланирования,
	              |	&ВалютаВзаиморасчетов КАК Валюта,
	              |	ВЫБОР
	              |		КОГДА ПотребностиДобавленныеВручную.ДатаПоставки = ДАТАВРЕМЯ(1, 1, 1)
	              |			ТОГДА ПотребностиДобавленныеВручную.ПериодПотребности.ДатаНачала
	              |		ИНАЧЕ ПотребностиДобавленныеВручную.ДатаПоставки
	              |	КОНЕЦ КАК ДатаОперации,
	              |	&Организация КАК Организация,
	              |	&Контрагент КАК Контрагент,
	              |	&ДоговорКонтрагента КАК ДоговорКонтрагента,
	              |	ВЫБОР
	              |		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	              |			ТОГДА &ДоговорКонтрагента
	              |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	              |	КОНЕЦ КАК ОбъектРасчетов,
	              |	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ОрганизацияПредыдущегоЭтапа,
	              |	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК КонтрагентПредыдущегоЭтапа,
	              |	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК ДоговорКонтрагентаПредыдущегоЭтапа,
	              |	НЕОПРЕДЕЛЕНО КАК ОбъектРасчетовПредыдущегоЭтапа,
	              |	ПотребностиДобавленныеВручную.Организация КАК ЦФО,
	              |	ПотребностиДобавленныеВручную.Проект КАК Проект,
	              |	&ВидБюджета КАК ВидБюджета,
	              |	&ВидБюджета КАК ВидБюджетаПоставка,
	              |	ПотребностиДобавленныеВручную.СтатьяБюджета КАК СтатьяБюджета,
	              |	ПотребностиДобавленныеВручную.АналитикаПланирования КАК АналитикаПредыдущегоЭтапа,
	              |	ПотребностиДобавленныеВручную.Аналитика1 КАК Аналитика1,
	              |	ПотребностиДобавленныеВручную.Аналитика2 КАК Аналитика2,
	              |	ПотребностиДобавленныеВручную.Аналитика3 КАК Аналитика3,
	              |	ПотребностиДобавленныеВручную.Аналитика4 КАК Аналитика4,
	              |	ПотребностиДобавленныеВручную.Аналитика5 КАК Аналитика5,
	              |	ПотребностиДобавленныеВручную.Аналитика6 КАК Аналитика6,
	              |	ПотребностиДобавленныеВручную.Ссылка.ОсновнаяСтатьяИсполнение КАК СтатьяБюджетаПоставка,
	              |	ПотребностиДобавленныеВручную.Ссылка.АналитикаИсполнение1 КАК Аналитика1Поставка,
	              |	ПотребностиДобавленныеВручную.Ссылка.АналитикаИсполнение2 КАК Аналитика2Поставка,
	              |	ПотребностиДобавленныеВручную.Ссылка.АналитикаИсполнение3 КАК Аналитика3Поставка,
	              |	ПотребностиДобавленныеВручную.Ссылка.АналитикаИсполнение4 КАК Аналитика4Поставка,
	              |	ПотребностиДобавленныеВручную.Ссылка.АналитикаИсполнение5 КАК Аналитика5Поставка,
	              |	ПотребностиДобавленныеВручную.Ссылка.АналитикаИсполнение6 КАК Аналитика6Поставка,
	              |	ПотребностиДобавленныеВручную.Номенклатура КАК Номенклатура,
	              |	ПотребностиДобавленныеВручную.Характеристика КАК Характеристика,
	              |	ПотребностиДобавленныеВручную.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	              |	ПотребностиДобавленныеВручную.Коэффициент КАК Коэффициент,
	              |	ВЫБОР
	              |		КОГДА  ТИПЗНАЧЕНИЯ(ПотребностиДобавленныеВручную.Номенклатура) = ТИП(Справочник.Номенклатура)  И ПотребностиДобавленныеВручную.Количество>0
	              |			ТОГДА Выразить((ПотребностиДобавленныеВручную.Сумма/ПотребностиДобавленныеВручную.Количество)-0.005 КАК Число(15,2))
	              |		ИНАЧЕ 0
	              |	КОНЕЦ КАК Цена,	     
				  |	ПотребностиДобавленныеВручную.Количество КАК Количество,
	              |	ВЫБОР
	              |		КОГДА &СтатьяБДР
	              |			ТОГДА ПотребностиДобавленныеВручную.Сумма - ПотребностиДобавленныеВручную.СуммаНДС
	              |		ИНАЧЕ ПотребностиДобавленныеВручную.Сумма
	              |	КОНЕЦ КАК Сумма,
	              |	ПотребностиДобавленныеВручную.Сумма КАК СуммаПоПотребности,
	              |	ПотребностиДобавленныеВручную.МестоПоставки КАК МестоПоставки,
	              |	ПотребностиДобавленныеВручную.СтавкаНДС КАК СтавкаНДС,
	              |	ПотребностиДобавленныеВручную.НоменклатураПоставщика КАК НоменклатураПоставщика,
	              |	ПотребностиДобавленныеВручную.СтраныПроисхождения КАК СтранаПроисхождения,
	              |	ПотребностиДобавленныеВручную.СтранаПроизводителя КАК СтранаПроизводителя,
	              |	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	              |	ПотребностиДобавленныеВручную.Назначение КАК Назначение,
	              |	&Контрагент КАК Поставщик
	              |ПОМЕСТИТЬ ВТ_ПланыДокументаДобавленныеВручную
	              |ИЗ
	              |	Документ.ВерсияСоглашенияКоммерческийДоговор.Номенклатура КАК ПотребностиДобавленныеВручную
	              |ГДЕ
	              |	ПотребностиДобавленныеВручную.Ссылка = &Ссылка
	              |	И ПотребностиДобавленныеВручную.АналитикаИсточника = ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)
	              |	И ПотребностиДобавленныеВручную.Сумма > 0";
	
	Если ТипОбъекта = ТипЗнч(ПустаяСсылка()) Тогда
		// Это ссылка
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, ИменаРеквизитов);
		Запросы.Добавить(ТекстЗапроса);
	Иначе
		// Объект или Форма
		РеквизитыДокумента = Объект;
		
		РеквизитыТабличнойЧасти = 
					"АналитикаИсточника,Менеджер,АналитикаПланирования,ДатаПоставки,ЕдиницаИзмерения,Назначение,
					|Количество,Коэффициент,Лот,МестоПоставки,Номенклатура,НоменклатураПоставщика,
					|ПериодПотребности,Проект,СтавкаНДС,СтранаПроизводителя,СтраныПроисхождения,СуммаНДС,Организация,
					|Сумма,Характеристика,Цена,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6";
		Коллекция = Объект.Номенклатура.Выгрузить(, РеквизитыТабличнойЧасти);
		Коллекция.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ВерсияСоглашенияКоммерческийДоговор"));
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка");
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Номенклатура ИЗ &Коллекция КАК Коллекция");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ВерсияСоглашенияКоммерческийДоговор.", "ВТ_");
		Запросы.Добавить(ТекстЗапроса);
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_Номенклатура");
	КонецЕсли;
    Запрос.УстановитьПараметр("ПланОплаты",ПланОплаты);
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	
	Запрос.Выполнить();
	
	Возврат ПараметрыПланирования;
	
КонецФункции

Процедура ПодготовитьПланыПоГрафикуРасчетов(Источник, МенеджерВременныхТаблиц)  Экспорт  
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	// Сформировать временную таблицу ВТ_ПланыДокумента по данным графика расчетов
	Запросы = Новый Массив;
	
	ТекстЗапроса =
	"ВЫБРАТЬ // +по графику поставок и графику расчетов
	|	1 КАК НомерЗапроса,
	|	&Дата КАК ДатаРегистрации,
	|	ГрафикРасчетов.ВидБюджета КАК ВидБюджета,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВЫБОР
	|		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	|			ТОГДА &ДоговорКонтрагента
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОбъектРасчетов,
	|	&ВалютаВзаиморасчетов КАК Валюта,
	|	&ДоговорКонтрагента КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА НЕ ГрафикРасчетов.ДокументРезервирования = НЕОПРЕДЕЛЕНО
	|			ТОГДА ГрафикРасчетов.ДокументРезервирования
	|		КОГДА ГрафикРасчетов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|			ТОГДА &ИсточникЛимитовБДДС
	|		КОГДА ГрафикРасчетов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|			ТОГДА &ИсточникЛимитовИсполнение
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДокументРезервирования,
	|	ГрафикРасчетов.Дата КАК Период,
	|	ГрафикРасчетов.Дата КАК ДатаОперации,
	|	ГрафикРасчетов.ЦФО КАК ЦФО,
	|	ГрафикРасчетов.Проект КАК Проект,
	|	ГрафикРасчетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ГрафикРасчетов.Аналитика1 КАК Аналитика1,
	|	ГрафикРасчетов.Аналитика2 КАК Аналитика2,
	|	ГрафикРасчетов.Аналитика3 КАК Аналитика3,
	|	ГрафикРасчетов.Аналитика4 КАК Аналитика4,
	|	ГрафикРасчетов.Аналитика5 КАК Аналитика5,
	|	ГрафикРасчетов.Аналитика6 КАК Аналитика6,
	|	ВЫБОР КОГДА ГрафикРасчетов.ВидБюджета = Значение(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов) ТОГДА
	|		ГрафикРасчетов.Сумма - (ГрафикРасчетов.Сумма * &СтавкаНДС / (100+&СтавкаНДС))
	|	ИНАЧЕ
	|       ГрафикРасчетов.Сумма
	|	КОНЕЦ КАК СУММА,
	|	ГрафикРасчетов.НаправлениеДвижения КАК ПриходРасход
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор.ГрафикРасчетов КАК ГрафикРасчетов
	|ГДЕ
	|	ГрафикРасчетов.Ссылка = &Ссылка
	|	И &ГрафикДоговора В (ЗНАЧЕНИЕ(Перечисление.ГрафикиДоговора.ГрафикПоставок), ЗНАЧЕНИЕ(Перечисление.ГрафикиДоговора.ГрафикРасчетов))
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = НЕОПРЕДЕЛЕНО
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|	И НЕ ГрафикРасчетов.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ // -по поставкам при сквозном планировании
	|	2,
	|	&Дата,
	|	ГрафикРасчетов.ВидБюджета,
	|	&Организация,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	&ВалютаВзаиморасчетов,
	|	ГрафикРасчетов.ДокументРезервирования,
	|	НЕОПРЕДЕЛЕНО,
	|	ГрафикРасчетов.Дата,
	|	ГрафикРасчетов.Дата,
	|	ГрафикРасчетов.ЦФО,
	|	ГрафикРасчетов.Проект,
	|	ГрафикРасчетов.СтатьяБюджета,
	|	ГрафикРасчетов.Аналитика1,
	|	ГрафикРасчетов.Аналитика2,
	|	ГрафикРасчетов.Аналитика3,
	|	ГрафикРасчетов.Аналитика4,
	|	ГрафикРасчетов.Аналитика5,
	|	ГрафикРасчетов.Аналитика6,
	|	ВЫБОР КОГДА
	|		ГрафикРасчетов.ВидБюджета = Значение(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов) ТОГДА
	|			-(ГрафикРасчетов.Сумма - (ГрафикРасчетов.Сумма * &СтавкаНДС / (100+&СтавкаНДС)))
	|	ИНАЧЕ
	|       -ГрафикРасчетов.Сумма
	|	КОНЕЦ,
	|	ГрафикРасчетов.НаправлениеДвижения
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор.ГрафикРасчетов КАК ГрафикРасчетов
	|ГДЕ
	|	ГрафикРасчетов.Ссылка = &Ссылка
	|	И ГрафикРасчетов.ДокументРезервирования <> НЕОПРЕДЕЛЕНО
	|	И &ГрафикДоговора = ЗНАЧЕНИЕ(Перечисление.ГрафикиДоговора.ГрафикПоставок)
	|	И &СквозноеПланированиеПотребностей = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ // -при заполненном источнике БДДС
	|	3,
	|	&Дата,
	|	ГрафикРасчетов.ВидБюджета,
	|	&Организация,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	&ВалютаВзаиморасчетов,
	|	&ИсточникЛимитовБДДС,
	|	НЕОПРЕДЕЛЕНО,
	|	ГрафикРасчетов.Дата,
	|	ГрафикРасчетов.Дата,
	|	ГрафикРасчетов.ЦФО,
	|	ГрафикРасчетов.Проект,
	|	ГрафикРасчетов.СтатьяБюджета,
	|	ГрафикРасчетов.Аналитика1,
	|	ГрафикРасчетов.Аналитика2,
	|	ГрафикРасчетов.Аналитика3,
	|	ГрафикРасчетов.Аналитика4,
	|	ГрафикРасчетов.Аналитика5,
	|	ГрафикРасчетов.Аналитика6,
	|	ВЫБОР
	|		КОГДА ГрафикРасчетов.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)
	|			ТОГДА -(ГрафикРасчетов.Сумма - ГрафикРасчетов.Сумма * &СтавкаНДС / (100 + &СтавкаНДС))
	|		ИНАЧЕ -ГрафикРасчетов.Сумма
	|	КОНЕЦ,
	|	ГрафикРасчетов.НаправлениеДвижения
	|ИЗ
