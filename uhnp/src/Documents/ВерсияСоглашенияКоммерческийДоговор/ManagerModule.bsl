Процедура ДобавитьПланыПоГрафикуРасчетов(ДокументСсылка, Запрос, ДополнительныеСвойства)
	Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектыПланирования.ПолучитьОбъектПланирования(Запрос.Параметры.ДоговорКонтрагента));
	ПодготовитьПланыПоГрафикуРасчетов(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
	ДобавитьПредыдущиеПланыГрафикРасчетов(Запрос);
	ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокументаДляДвижений");
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка) Экспорт
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Реквизиты.Ссылка КАК Ссылка,
		|	Реквизиты.Дата КАК Дата,
		|	Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Реквизиты.Организация КАК Организация,
		|	Реквизиты.Контрагент КАК Контрагент,
		|	Реквизиты.СтатьяДвиженияДенежныхСредств КАК СтатьяОплаты,
		|	Реквизиты.ОсновнаяСтатьяИсполнение КАК СтатьяНачисления,
		|	Реквизиты.ВалютаВзаиморасчетов КАК Валюта,   
		|	Реквизиты.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
		|	ВЫБОР
		|		КОГДА Реквизиты.ВидДоговораУХ В (&ВидыДоговоровСПоставщиком)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
		|	КОНЕЦ КАК ПриходРасход,
		|	6 КАК ЗаполненностьДоговораЗаявки,
		|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
		|	Реквизиты.ИспользованиеГрафикаРасчетовБДР КАК ИспользованиеГрафикаРасчетовБДР,
		|	Реквизиты.ИспользованиеГрафикаРасчетовБДДС КАК ИспользованиеГрафикаРасчетовБДДС,  
		|	Реквизиты.Проведен КАК Проведен,
		|	Реквизиты.ПорядокРасчетов КАК ПорядокРасчетов,     
		|	Реквизиты.ГрафикДоговора КАК ГрафикДоговора
		|ИЗ
		|	Документ.ВерсияСоглашенияКоммерческийДоговор КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидыДоговоровСПоставщиком", РаботаСДоговорамиКонтрагентовУХКлиентСервер.ВидыДоговоровСПоставщиком());
	
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
		
	Для Каждого ТекРеквизит Из Реквизиты Цикл
		Запрос.УстановитьПараметр(ТекРеквизит.Ключ, ТекРеквизит.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВыборкуДляЗаписиДвиженийПланПоставокПоДоговорам(ДокументСсылка)
	ОписаниеКоэффициента = 
		ЦентрализованныеЗакупкиУХ.ПолучитьКоэффициентПересчетаВалют(
		    ДокументСсылка.ВалютаВзаиморасчетов,
			Константы.ВалютаУчетаЦентрализованныхЗакупок.Получить(), 
			ДокументСсылка.Дата);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	&Дата КАК Период,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Количество * ВерсияСоглашенияКоммерческийДоговорНоменклатура.Коэффициент КАК Количество,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Коэффициент КАК Коэффициент,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Менеджер КАК Менеджер,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.МестоПоставки КАК МестоПоставки,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Номенклатура КАК Номенклатура,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Характеристика КАК Характеристика,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Организация КАК Организация,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.ПериодПотребности КАК ПериодПотребности,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Приоритет КАК Приоритет,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Проект КАК Проект,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.ДоговорСПокупателем КАК ДоговорСПокупателем,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.СтавкаНДС КАК СтавкаНДС,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Сумма * &КоэффициентПересчетаВалюты / &Кратность КАК Сумма,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Цена * &КоэффициентПересчетаВалюты / &Кратность КАК Цена,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Лот КАК Лот,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка.ДоговорКонтрагента КАК Договор,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.СтраныПроисхождения КАК СтраныПроисхождения,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.СтранаПроизводителя КАК СтранаПроизводителя,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.НоменклатураПоставщика КАК НоменклатураПоставщика,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.АналитикаИсточника КАК АналитикаИсточника,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.ДатаПоставки КАК ДатаПоставки,
		|	ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка.ВалютаВзаиморасчетов КАК Валюта		
		|ИЗ
		|	Документ.ВерсияСоглашенияКоммерческийДоговор.Номенклатура КАК ВерсияСоглашенияКоммерческийДоговорНоменклатура
		|ГДЕ
		|	(ВерсияСоглашенияКоммерческийДоговорНоменклатура.Количество <> 0
		|			ИЛИ ВерсияСоглашенияКоммерческийДоговорНоменклатура.Сумма <> 0)
		|	И ВерсияСоглашенияКоммерческийДоговорНоменклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",	ДокументСсылка.Ссылка);
	Запрос.УстановитьПараметр("Дата", ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВалюты",
		ОписаниеКоэффициента.Коэффициент);
	Запрос.УстановитьПараметр("Кратность", ОписаниеКоэффициента.Кратность);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выбрать();
КонецФункции

Функция ПолучитьВыборкуДвиженийПланПоставокПоДоговорамДляСторнирования(ДокументОбъект)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Дата КАК Период,
		|	ПланПоставокПоДоговорамОбороты.Договор КАК Договор,
		|	ПланПоставокПоДоговорамОбороты.Приоритет КАК Приоритет,
		|	ПланПоставокПоДоговорамОбороты.Номенклатура КАК Номенклатура,
		|	ПланПоставокПоДоговорамОбороты.Характеристика КАК Характеристика,
		|	ПланПоставокПоДоговорамОбороты.ПериодПотребности КАК ПериодПотребности,
		|	ПланПоставокПоДоговорамОбороты.Организация КАК Организация,
		|	ПланПоставокПоДоговорамОбороты.МестоПоставки КАК МестоПоставки,
		|	ПланПоставокПоДоговорамОбороты.Проект КАК Проект,
		|	ПланПоставокПоДоговорамОбороты.Менеджер КАК Менеджер,
		|	ПланПоставокПоДоговорамОбороты.ДоговорСПокупателем КАК ДоговорСПокупателем,
		|	ПланПоставокПоДоговорамОбороты.Лот КАК Лот,
		|	ПланПоставокПоДоговорамОбороты.СтавкаНДС КАК СтавкаНДС,
		|	СУММА(ПланПоставокПоДоговорамОбороты.КоличествоОборот) КАК Количество,
		|	СУММА(ПланПоставокПоДоговорамОбороты.СуммаОборот) КАК Сумма,
		|	СУММА(1) КАК Коэффициент,
		|	ЕСТЬNULL(ПланПоставокПоДоговорамОбороты.Номенклатура.ЕдиницаИзмерения, &ПустаяЕдиницаИзмерения) КАК ЕдиницаИзмерения,
		|	СУММА(ПланПоставокПоДоговорамОбороты.СуммаОборот) / ВЫБОР
		|		КОГДА СУММА(ПланПоставокПоДоговорамОбороты.КоличествоОборот) = 0
		|			ТОГДА 1
		|		ИНАЧЕ СУММА(ПланПоставокПоДоговорамОбороты.КоличествоОборот)
		|	КОНЕЦ КАК Цена,
		|	ПланПоставокПоДоговорамОбороты.Валюта КАК Валюта
		|ИЗ
		|	РегистрНакопления.ПланПоставокПоДоговорам.Обороты(, &Момент, Запись, Договор = &Договор) КАК ПланПоставокПоДоговорамОбороты
		|ГДЕ
		|	ПланПоставокПоДоговорамОбороты.Регистратор = &Основание
		|	И (ПланПоставокПоДоговорамОбороты.СуммаОборот > 0
		|			ИЛИ ПланПоставокПоДоговорамОбороты.КоличествоОборот > 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПланПоставокПоДоговорамОбороты.ПериодПотребности,
		|	ПланПоставокПоДоговорамОбороты.Номенклатура,
		|	ПланПоставокПоДоговорамОбороты.СтавкаНДС,
		|	ПланПоставокПоДоговорамОбороты.МестоПоставки,
		|	ПланПоставокПоДоговорамОбороты.Лот,
		|	ПланПоставокПоДоговорамОбороты.ДоговорСПокупателем,
		|	ПланПоставокПоДоговорамОбороты.Договор,
		|	ПланПоставокПоДоговорамОбороты.Менеджер,
		|	ПланПоставокПоДоговорамОбороты.Проект,
		|	ПланПоставокПоДоговорамОбороты.МестоПоставки,
		|	ПланПоставокПоДоговорамОбороты.ПериодПотребности,
		|	ПланПоставокПоДоговорамОбороты.Организация,
		|	ПланПоставокПоДоговорамОбороты.Характеристика,
		|	ПланПоставокПоДоговорамОбороты.Номенклатура,
		|	ПланПоставокПоДоговорамОбороты.Приоритет,
		|	ПланПоставокПоДоговорамОбороты.Договор,
		|	ЕСТЬNULL(ПланПоставокПоДоговорамОбороты.Номенклатура.ЕдиницаИзмерения, &ПустаяЕдиницаИзмерения),
		|	ПланПоставокПоДоговорамОбороты.Валюта,
		|	ПланПоставокПоДоговорамОбороты.Проект,
		|	ПланПоставокПоДоговорамОбороты.ДоговорСПокупателем,
		|	ЕСТЬNULL(ПланПоставокПоДоговорамОбороты.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)),
		|	ПланПоставокПоДоговорамОбороты.Характеристика";

	Запрос.УстановитьПараметр("Договор", ДокументОбъект.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Момент", Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Основание", ДокументОбъект.ДокументОснование);
	Запрос.УстановитьПараметр("Момент", Новый Граница(
		ДокументОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("ПустаяЕдиницаИзмерения",
		УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ПолучитьПустуюЕдиницуИзмерения());
	Запрос.УстановитьПараметр("Основание", ДокументОбъект.ДокументОснование);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выбрать();
КонецФункции

Процедура ДобавитьНачисление(График, Дата, Сумма, ПараметрыПозиций, Аналитики = Неопределено)
	
	ОписаниеОперации = РаботаСДоговорамиКонтрагентовУХ.ОписаниеОперации(ПараметрыПозиций.СекцияГрафика.КолонкаПриходОперация, ПараметрыПозиций.ОперацииГрафика);
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(График, Сумма, Дата, , ОписаниеОперации, Аналитики);
	
КонецПроцедуры

Процедура ДобавитьОплату(График, Дата, Сумма, ПараметрыПозиций, Аналитики = Неопределено)
	
	ОписаниеОперации = РаботаСДоговорамиКонтрагентовУХ.ОписаниеОперации(ПараметрыПозиций.СекцияГрафика.КолонкаРасходОперация, ПараметрыПозиций.ОперацииГрафика);
	ЭтапыОплаты = РасчетГрафиковОперацийУХ.ПолучитьГрафикЭтаповОплаты(Сумма, Дата, ПараметрыПозиций);
	
	Для Каждого ТекЭтапОплаты из ЭтапыОплаты Цикл  	
		РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(График, ТекЭтапОплаты.Сумма, ТекЭтапОплаты.Дата, , ОписаниеОперации, Аналитики);   	
	КонецЦикла;
	
КонецПроцедуры   

Функция ИмяТаблицыДокумента()
	Возврат "Документ.ВерсияСоглашенияКоммерческийДоговор";
КонецФункции

Процедура УстановитьСтавкуНДСВПараметрахЗапроса(Запрос, Источник)
	
	СтавкаНДС = Источник.СтавкаНДС;
	
	ЗначениеСтавкиНДС = УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(СтавкаНДС);
	Запрос.УстановитьПараметр("СтавкаНДС", ЗначениеСтавкиНДС);		
		
КонецПроцедуры


Функция ПолучитьРегистраторыДоговора(ДоговорКонтрагента)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВерсияСоглашенияКоммерческийДоговор.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор КАК ВерсияСоглашенияКоммерческийДоговор
	|ГДЕ
	|	ВерсияСоглашенияКоммерческийДоговор.ДоговорКонтрагента = &ДоговорКонтрагента";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ГрафикПоставок(Объект)
	
	Если Не Объект.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	//	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБюджета", 			ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата)); 
	Запрос.УстановитьПараметр("ВидБюджетаБДР", 			ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов); 	  
	Запрос.УстановитьПараметр("ВидБюджетаБДДС", 		ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств); 
	Запрос.УстановитьПараметр("СтатьяБюджетаПоставка", 	Объект.ОсновнаяСтатьяИсполнение);   
	Запрос.УстановитьПараметр("СтатьяБюджета", 			Объект.СтатьяДвиженияДенежныхСредств); 
    Запрос.УстановитьПараметр("Аналитика1Поставка", Объект.АналитикаИсполнение1);
	Запрос.УстановитьПараметр("Аналитика2Поставка", Объект.АналитикаИсполнение2);
	Запрос.УстановитьПараметр("Аналитика3Поставка", Объект.АналитикаИсполнение3);
	Запрос.УстановитьПараметр("Аналитика4Поставка", Объект.АналитикаИсполнение4);
	Запрос.УстановитьПараметр("Аналитика5Поставка", Объект.АналитикаИсполнение5);
	Запрос.УстановитьПараметр("Аналитика6Поставка", Объект.АналитикаИсполнение6); 
	Запрос.УстановитьПараметр("Аналитика1", 		Объект.АналитикаБДДС1);
	Запрос.УстановитьПараметр("Аналитика2", 		Объект.АналитикаБДДС2);
	Запрос.УстановитьПараметр("Аналитика3", 		Объект.АналитикаБДДС3);
	Запрос.УстановитьПараметр("Аналитика4", 		Объект.АналитикаБДДС4);
	Запрос.УстановитьПараметр("Аналитика5", 		Объект.АналитикаБДДС5);
	Запрос.УстановитьПараметр("Аналитика6", 		Объект.АналитикаБДДС6);
	РеквизитыТабличнойЧасти = 
					"ДатаПоставки,ПериодПотребности,Проект,Организация,Лот,
					|Сумма,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6";
	Коллекция = Объект.Номенклатура.Выгрузить(, РеквизитыТабличнойЧасти);
	Запрос.УстановитьПараметр("Коллекция", Коллекция);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГрафикПоставок.ДатаПоставки КАК ДатаПоставки,
		|	ГрафикПоставок.ПериодПотребности КАК ПериодПотребности,
		|	ГрафикПоставок.Организация КАК ЦФО,
		|	ГрафикПоставок.Лот КАК ДокументРезервирования,
		|	ГрафикПоставок.Проект КАК Проект,
		|	ГрафикПоставок.СтатьяБюджета КАК СтатьяБюджета,
		|	ГрафикПоставок.Аналитика1 КАК Аналитика1,
		|	ГрафикПоставок.Аналитика2 КАК Аналитика2,
		|	ГрафикПоставок.Аналитика3 КАК Аналитика3,
		|	ГрафикПоставок.Аналитика4 КАК Аналитика4,
		|	ГрафикПоставок.Аналитика5 КАК Аналитика5,
		|	ГрафикПоставок.Аналитика6 КАК Аналитика6,
		|	ГрафикПоставок.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	&Коллекция КАК ГрафикПоставок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИСТИНА КАК Начисление, 
		|	&ВидБюджетаБДР КАК ВидБюджета,
		|	ВЫБОР
		|		КОГДА ГрафикПоставок.ДатаПоставки = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ГрафикПоставок.ПериодПотребности.ДатаНачала
		|		ИНАЧЕ ГрафикПоставок.ДатаПоставки
		|	КОНЕЦ КАК ДатаОперации,
		|	ГрафикПоставок.ЦФО КАК ЦФО,
		|	ГрафикПоставок.Проект КАК Проект,
		|	ГрафикПоставок.ДокументРезервирования КАК ДокументРезервирования,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДР
		|			ТОГДА ГрафикПоставок.СтатьяБюджета
		|		ИНАЧЕ &СтатьяБюджетаПоставка
		|	КОНЕЦ КАК СтатьяБюджета,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДР
		|			ТОГДА ГрафикПоставок.Аналитика1
		|		ИНАЧЕ &Аналитика1Поставка
		|	КОНЕЦ КАК Аналитика1,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДР
		|			ТОГДА ГрафикПоставок.Аналитика2
		|		ИНАЧЕ &Аналитика2Поставка
		|	КОНЕЦ КАК Аналитика2,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДР
		|			ТОГДА ГрафикПоставок.Аналитика3
		|		ИНАЧЕ &Аналитика3Поставка
		|	КОНЕЦ КАК Аналитика3,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДР
		|			ТОГДА ГрафикПоставок.Аналитика4
		|		ИНАЧЕ &Аналитика4Поставка
		|	КОНЕЦ КАК Аналитика4,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДР
		|			ТОГДА ГрафикПоставок.Аналитика5
		|		ИНАЧЕ &Аналитика5Поставка
		|	КОНЕЦ КАК Аналитика5,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДР
		|			ТОГДА ГрафикПоставок.Аналитика6
		|		ИНАЧЕ &Аналитика6Поставка
		|	КОНЕЦ КАК Аналитика6,
		|	ГрафикПоставок.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТ_ГрафикРасчетов
		|ИЗ
		|	ВТ_Номенклатура КАК ГрафикПоставок
		|ГДЕ
		|	ГрафикПоставок.Сумма > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ, 
		|	&ВидБюджетаБДДС,
		|	ВЫБОР
		|		КОГДА ГрафикПоставок.ДатаПоставки = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ГрафикПоставок.ПериодПотребности.ДатаНачала
		|		ИНАЧЕ ГрафикПоставок.ДатаПоставки
		|	КОНЕЦ КАК ДатаОперации,
		|	ГрафикПоставок.ЦФО,
		|	ГрафикПоставок.Проект,
		|	ГрафикПоставок.ДокументРезервирования,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДДС
		|			ТОГДА ГрафикПоставок.СтатьяБюджета
		|		ИНАЧЕ &СтатьяБюджета
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДДС
		|			ТОГДА ГрафикПоставок.Аналитика1
		|		ИНАЧЕ &Аналитика1
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДДС
		|			ТОГДА ГрафикПоставок.Аналитика2
		|		ИНАЧЕ &Аналитика2
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДДС
		|			ТОГДА ГрафикПоставок.Аналитика3
		|		ИНАЧЕ &Аналитика3
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДДС
		|			ТОГДА ГрафикПоставок.Аналитика4
		|		ИНАЧЕ &Аналитика4
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДДС
		|			ТОГДА ГрафикПоставок.Аналитика5
		|		ИНАЧЕ &Аналитика5
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ВидБюджета = &ВидБюджетаБДДС
		|			ТОГДА ГрафикПоставок.Аналитика6
		|		ИНАЧЕ &Аналитика6
		|	КОНЕЦ,
		|	ГрафикПоставок.Сумма
		|ИЗ
		|	ВТ_Номенклатура КАК ГрафикПоставок
		|ГДЕ
		|	ГрафикПоставок.Сумма > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ГрафикРасчетов.Начисление КАК Начисление, 
		|	ВТ_ГрафикРасчетов.ВидБюджета КАК ВидБюджета,
		|	ВТ_ГрафикРасчетов.ДатаОперации КАК ДатаОперации,
		|	ВТ_ГрафикРасчетов.ЦФО КАК ЦФО,
		|	ВТ_ГрафикРасчетов.Проект КАК Проект,
		|	ВТ_ГрафикРасчетов.ДокументРезервирования КАК ДокументРезервирования,
		|	ВТ_ГрафикРасчетов.СтатьяБюджета КАК СтатьяБюджета,
		|	ВТ_ГрафикРасчетов.Аналитика1 КАК Аналитика1,
		|	ВТ_ГрафикРасчетов.Аналитика2 КАК Аналитика2,
		|	ВТ_ГрафикРасчетов.Аналитика3 КАК Аналитика3,
		|	ВТ_ГрафикРасчетов.Аналитика4 КАК Аналитика4,
		|	ВТ_ГрафикРасчетов.Аналитика5 КАК Аналитика5,
		|	ВТ_ГрафикРасчетов.Аналитика6 КАК Аналитика6,
		|	СУММА(ВТ_ГрафикРасчетов.Сумма) КАК Сумма
		|ИЗ
		|	ВТ_ГрафикРасчетов КАК ВТ_ГрафикРасчетов
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ГрафикРасчетов.Аналитика5,
		|	ВТ_ГрафикРасчетов.Аналитика6,
		|	ВТ_ГрафикРасчетов.Аналитика3,
		|	ВТ_ГрафикРасчетов.Аналитика2,
		|	ВТ_ГрафикРасчетов.Аналитика4,
		|	ВТ_ГрафикРасчетов.ДатаОперации,
		|	ВТ_ГрафикРасчетов.ДокументРезервирования,
		|	ВТ_ГрафикРасчетов.Проект,
		|	ВТ_ГрафикРасчетов.ЦФО,
		|	ВТ_ГрафикРасчетов.Начисление,
		|	ВТ_ГрафикРасчетов.ВидБюджета,
		|	ВТ_ГрафикРасчетов.Аналитика1,
		|	ВТ_ГрафикРасчетов.СтатьяБюджета";

	
	ГрафикПоставок = Запрос.Выполнить().Выгрузить();
	
	ДоговорыКонтрагентовВстраиваниеУХ.ЗаполнитьАналитикиГрафикаПоставок(ГрафикПоставок, Объект);
	ДоговорыКонтрагентовВстраиваниеУХ.ОбработатьДокументРезервированияГрафикаПоставок(ГрафикПоставок, Объект);
	
	Возврат ГрафикПоставок;
	
КонецФункции   

Функция АналитикиДоговора(Объект, Исполнение = Ложь)
	
	Аналитики = Новый Структура;  
	
	Если Исполнение Тогда
		Аналитики.Вставить("СтатьяБюджета", Объект.ОсновнаяСтатьяИсполнение);
		ИмяРеквизита = "АналитикаИсполнение";
	Иначе  
		Аналитики.Вставить("СтатьяБюджета", Объект.СтатьяДвиженияДенежныхСредств);
		ИмяРеквизита = "АналитикаБДДС";
	КонецЕсли;   
	
	Для Сч = 1 По 6 Цикл   
		
		Аналитики.Вставить(ИмяРеквизита+Сч, Объект[ИмяРеквизита+Сч]);	
		
	КонецЦикла;
	
	Возврат Аналитики;

КонецФункции

Функция АналитикиДоговораПоГрафикуПоставок(ДанныеСтроки)
	
	Аналитики = Новый Структура("ВидБюджета,СтатьяБюджета,ДатаПоставки,Аналитика1,Аналитика2,Аналитика3,
								|Аналитика4,Аналитика5,Аналитика6,ЦФО,Проект,СчетОрганизации,СчетКонтрагента,ДокументРезервирования");  
	
	ЗаполнитьЗначенияСвойств(Аналитики, ДанныеСтроки);                 
	
	Возврат Аналитики;
	
КонецФункции

Процедура РассчитатьГрафикПоСуммеПоставок(Объект,
										Знач НачалоПериода,
										КонецПериода,
										Периодичность,
										ПараметрыПозиций,
										Знач Сумма,
										РаспределениеСуммыНаГод = Ложь)

	ТаблицаПериодов = Новый ТаблицаЗначений;
	ТаблицаПериодов.Колонки.Добавить("Дата");
	
	НовСтр = ТаблицаПериодов.Добавить();
	НовСтр.Дата = НачалоПериода; 

	Коэффициенты = Новый Массив; 
	Если РаспределениеСуммыНаГод Тогда
		Коэффициенты.Добавить(1);
	КонецЕсли;

	
	Пока Истина Цикл
		
		НоваяДата = ОбщегоНазначенияУХ.ДобавитьИнтервал(НачалоПериода, Периодичность, 1);
		
		Если НоваяДата > КонецПериода Тогда
			Прервать;
		КонецЕсли; 
		
		НовСтр = ТаблицаПериодов.Добавить();
		НовСтр.Дата = НоваяДата;     
		
		НачалоПериода = НоваяДата; 

		Если РаспределениеСуммыНаГод Тогда
			Коэффициенты.Добавить(1);
		КонецЕсли;

		
	КонецЦикла;  
	
	Если РаспределениеСуммыНаГод Тогда
		РезультатРаспределенияСуммаНаГод = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(Сумма, Коэффициенты); 
	Иначе
		РезультатРаспределенияСуммаНаГод = Неопределено;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаПериодов Цикл  
		
		Если РезультатРаспределенияСуммаНаГод <> Неопределено Тогда   
			
			Сумма =  РезультатРаспределенияСуммаНаГод.Получить(ТаблицаПериодов.Индекс(СтрокаТаблицы));
			
		КонецЕсли;
		
		ДобавитьПозициюВГрафик(Объект.ГрафикРасчетов,
					СтрокаТаблицы.Дата,
	        		Сумма, 
					Истина,
					ПараметрыПозиций,
					АналитикиДоговора(Объект, Истина)); //Начисление

		ДобавитьПозициюВГрафик(Объект.ГрафикРасчетов,
					СтрокаТаблицы.Дата,
            		Сумма, 
					Ложь,
					ПараметрыПозиций,
					АналитикиДоговора(Объект)); //Оплата
					
	КонецЦикла;	 
	
КонецПроцедуры

Функция НачалоГодаПоГоду(Год)
	
	Дата = ДатаПоГоду(Год);
	
	Возврат НачалоГода(Дата);

КонецФункции

Функция КонецГодаПоГоду(Год)

	Дата = ДатаПоГоду(Год);

	Возврат КонецГода(Дата);  
	
КонецФункции  

Функция ДатаПоГоду(Год)
	
	ГодСтрокой = СтрЗаменить(Год,Символы.НПП,"");
	
	Возврат Дата(ГодСтрокой+"0101");
	
КонецФункции

Процедура ДобавитьПозициюВГрафик(График,
								Дата,
								Сумма,
								Начисление,
                                ПараметрыПозиций, 
								Аналитики = Неопределено) Экспорт
	
	Если Начисление Тогда //Начисление
		
		ДобавитьНачисление(График,
					Дата,
					Сумма,
					ПараметрыПозиций,
					Аналитики);  
					
	Иначе                 //Оплата
		
		Если ЗначениеЗаполнено(ПараметрыПозиций.ЭтапыГрафикаОплаты) Тогда
			ДобавитьОплату(График,
							Дата,
							Сумма,
							ПараметрыПозиций,
							Аналитики); 
		Иначе
			ОписаниеОперации = РаботаСДоговорамиКонтрагентовУХ.ОписаниеОперации(ПараметрыПозиций.СекцияГрафика.КолонкаРасходОперация, ПараметрыПозиций.ОперацииГрафика);
			РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(График, Сумма, Дата, , ОписаниеОперации, Аналитики);
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

