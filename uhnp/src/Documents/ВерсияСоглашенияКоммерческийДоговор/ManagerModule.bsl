	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК ДоговорКонтрагента,
	|	неопределено КАК ОбъектРасчетов,
	|	&ВалютаВзаиморасчетов КАК Валюта,
	|	&ИсточникЛимитовБДДС КАК ДокументПланирования,
	|	неопределено КАК ДокументРезервирования,
	|	ДанныеДокумента.Период.ДатаНачала КАК Период,
	|	ДанныеДокумента.Период.ДатаНачала КАК ДатаОперации,
	|	ДанныеДокумента.ЦФО КАК ЦФО,
	|	ДанныеДокумента.Проект КАК Проект,
	|	ДанныеДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ДанныеДокумента.Аналитика1 КАК Аналитика1,
	|	ДанныеДокумента.Аналитика2 КАК Аналитика2,
	|	ДанныеДокумента.Аналитика3 КАК Аналитика3,
	|	ДанныеДокумента.Аналитика4 КАК Аналитика4,
	|	ДанныеДокумента.Аналитика5 КАК Аналитика5,
	|	ДанныеДокумента.Аналитика6 КАК Аналитика6,
	|	-ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.ПриходРасход КАК ПриходРасход
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор.ДвиженияОперации КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка
	|	И ДанныеДокумента.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|	И &ИсточникЛимитовБДДС <> ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|	И &ИсточникЛимитовБДДС <> неопределено
	|	И &ГрафикДоговора = ЗНАЧЕНИЕ(Перечисление.ГрафикиДоговора.Резервирование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Дата КАК ДатаРегистрации,
	|	ДанныеДокумента.ВидБюджета КАК ВидБюджета,
	|	&Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК ДоговорКонтрагента,
	|	неопределено КАК ОбъектРасчетов,
	|	&ВалютаВзаиморасчетов КАК Валюта,
	|	&ИсточникЛимитовИсполнение КАК ДокументПланирования,
	|	неопределено КАК ДокументРезервирования,
	|	ДанныеДокумента.Период.ДатаНачала КАК Период,
	|	ДанныеДокумента.Период.ДатаНачала КАК ДатаОперации,
	|	ДанныеДокумента.ЦФО КАК ЦФО,
	|	ДанныеДокумента.Проект КАК Проект,
	|	ДанныеДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ДанныеДокумента.Аналитика1 КАК Аналитика1,
	|	ДанныеДокумента.Аналитика2 КАК Аналитика2,
	|	ДанныеДокумента.Аналитика3 КАК Аналитика3,
	|	ДанныеДокумента.Аналитика4 КАК Аналитика4,
	|	ДанныеДокумента.Аналитика5 КАК Аналитика5,
	|	ДанныеДокумента.Аналитика6 КАК Аналитика6,
	|	-ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.ПриходРасход КАК ПриходРасход
	|ИЗ
	|	Документ.ВерсияСоглашенияКоммерческийДоговор.ДвиженияОперации КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка
	|	И ДанныеДокумента.ВидБюджета <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|	И &ИсточникЛимитовИсполнение <> ЗНАЧЕНИЕ(Документ.Резервирование.ПустаяСсылка)
	|	И &ИсточникЛимитовИсполнение <> неопределено
	|	И &ГрафикДоговора = ЗНАЧЕНИЕ(Перечисление.ГрафикиДоговора.Резервирование)";
	
	ИменаРеквизитов = "ГрафикДоговора, Дата, ВалютаВзаиморасчетов, Организация, Контрагент, ДоговорКонтрагента, ПорядокРасчетов, "
		+ "ДокументОснование, ИсточникЛимитовБДДС, ИсточникЛимитовИсполнение, Ссылка";
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, ИменаРеквизитов);
		Запросы.Добавить(ТекстЗапроса);
	Иначе
		РеквизитыДокумента = Источник;

		//
		Коллекция = Источник.ДвиженияОперации.Выгрузить(, 
			"Сумма, Период, ЦФО, Проект, ВидБюджета, СтатьяБюджета, ПриходРасход,"
			+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1"));
		
		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		Коллекция.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		Коллекция.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ДвиженияОперации ИЗ &Коллекция КАК Коллекция");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ВерсияСоглашенияКоммерческийДоговор.", "ВТ_");
		Запросы.Добавить(ТекстЗапроса);
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_ДвиженияОперации");
		
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Запрос.Параметры.ИсточникЛимитовБДДС) Тогда
		Запрос.УстановитьПараметр("ИсточникЛимитовБДДС", неопределено);
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Запрос.Параметры.ИсточникЛимитовИсполнение) Тогда
		Запрос.УстановитьПараметр("ИсточникЛимитовИсполнение", неопределено);
	КонецЕсли;
	
	УстановитьСтавкуНДСВПараметрахЗапроса(Запрос, Источник);

	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ДобавитьПредыдущиеПланыГрафикРасчетов(Запрос) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос.Текст = 
