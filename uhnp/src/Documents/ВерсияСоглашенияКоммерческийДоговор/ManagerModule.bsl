	|	Запрос.ЦФО,
	|	Запрос.Организация,
	|	Запрос.Аналитика2,
	|	Запрос.Аналитика4,
	|	Запрос.Аналитика5,
	|	Запрос.Аналитика1,
	|	Запрос.ПриходРасход,
	|	Запрос.ДоговорКонтрагента,
	|	Запрос.ДатаОперации,
	|	Запрос.ДокументПланирования,
	|	Запрос.СтатьяБюджета,
	|	Запрос.ОбъектРасчетов
	|
	|ИМЕЮЩИЕ
	|	СУММА(Запрос.Сумма) <> 0";
	
	Запрос.Выполнить();
	
