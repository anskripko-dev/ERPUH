Функция СформироватьИсточникБюджетныеЛимитыРезервыПоПланамДокумента(Объект, ПараметрыКонтроля, ДопПараметрыИсточника, МенеджерВременныхТаблиц)
	
	Если МенеджерВременныхТаблиц = неопределено 
		ИЛИ МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ПланыДокумента") = неопределено Тогда
		Возврат неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДопПараметрыИсточника.Ссылка.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("КонтролируемыйДокумент", ДопПараметрыИсточника.КонтролируемыйДокумент);
	
	Запросы = Новый Массив;
	Запросы.Добавить(КонтрольЛимитовУХ.ТекстЗапроса_ОпределениеСуммЛимитирования(Запрос));
	Запросы.Добавить("УНИЧТОЖИТЬ ВТ_ПланыДокумента");
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		ПараметрыКонтроля.Вставить("Оповестить", Новый Структура);
		ПараметрыКонтроля.Оповестить.Вставить("ЗагрузитьПланыДДСДокумента", ПоместитьВоВременноеХранилище(РезультатПакет[0].Выгрузить()));
	КонецЕсли;
	
	//
	Источник = Новый Структура;
	Источник.Вставить("Параметры",		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", МенеджерВременныхТаблиц);
	Возврат Источник;
	
КонецФункции

// Функция - План потребностей 
//
// Параметры:
//  Объект					 - ДокументСсылка, ДокументОбъект, ДанныеФормыСтруктура	 - 
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц - 
// 
// Возвращаемое значение:
//   Структура - Структура с изменениями документа и менеджером временных таблиц 
//
Функция ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц = Неопределено, ОтражатьВБюджетах = Истина) Экспорт
	
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		ПараметрыПланирования.Вставить("Менеджер", Новый МенеджерВременныхТаблиц);
	Иначе
		ПараметрыПланирования.Вставить("Менеджер", МенеджерВременныхТаблиц);
	КонецЕсли;
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры", Ложь);
	ПараметрыПланирования.Вставить("Этап", Перечисления.ЭтапыПланированияПотребностей.Законтрактовано);
	ПараметрыПланирования.Вставить("ДокументПланирования", Объект.ДоговорКонтрагента);
	ПараметрыПланирования.Вставить("ОбъектПланирования", 
		ОбъектыПланирования.ПолучитьОбъектПланирования(ПараметрыПланирования.ДокументПланирования));
	ПараметрыПланирования.Вставить("ИзменениеПоставки", Истина);
	ПараметрыПланирования.Вставить("ИзменениеПартнера", Истина);
    ПараметрыПланирования.Вставить("ВидБюджета", ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата));
	ПараметрыПланирования.Вставить("ИзменениеСтруктуры",	Истина);
 	ПараметрыПланирования.Вставить("ОтражатьВБюджетах", 	ОтражатьВБюджетах);    
	ПараметрыПланирования.Вставить("ИзменениеПотребностей",Истина);
	ПроизводственныеКалендари = РаботаСДоговорамиКонтрагентовУХ.ПроизводственныеКалендариВерсииСоглашения(Объект);
	ПараметрыПланирования.Вставить("ПроизводственныеКалендари", ПроизводственныеКалендари);     
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыПланирования.Менеджер;
	Запрос.УстановитьПараметр("Этап", ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	Запрос.УстановитьПараметр("ВалютаДокумента", Объект.ВалютаВзаиморасчетов);
	Запрос.УстановитьПараметр("ЦФО", Объект.ОсновнойЦФО);
