	// Сформировать временную таблицу ВТ_ПланыДокумента по данным резервирования
	Запросы = Новый Массив;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Дата КАК ДатаРегистрации,
	|	ДанныеДокумента.ВидБюджета КАК ВидБюджета,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВЫБОР 
	|		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов) ТОГДА &ДоговорКонтрагента
	|		ИНАЧЕ неопределено
	|	КОНЕЦ КАК ОбъектРасчетов,
	|	&ВалютаВзаиморасчетов КАК Валюта,
	|	&ДоговорКонтрагента КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|			ТОГДА &ИсточникЛимитовБДДС
	|		ИНАЧЕ &ИсточникЛимитовИсполнение
	|	КОНЕЦ КАК ДокументРезервирования,
	|	ДанныеДокумента.Период.ДатаНачала КАК Период,
	|	ДанныеДокумента.Период.ДатаНачала КАК ДатаОперации,
	|	ДанныеДокумента.ЦФО КАК ЦФО,
	|	ДанныеДокумента.Проект КАК Проект,
	|	ДанныеДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ДанныеДокумента.Аналитика1 КАК Аналитика1,
	|	ДанныеДокумента.Аналитика2 КАК Аналитика2,
	|	ДанныеДокумента.Аналитика3 КАК Аналитика3,
	|	ДанныеДокумента.Аналитика4 КАК Аналитика4,
