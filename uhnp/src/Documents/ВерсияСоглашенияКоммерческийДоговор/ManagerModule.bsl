Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений; 
	
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьТекстЗапросаВерсииРасчетов(ТекстыЗапроса, ИмяТаблицыДокумента());
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьТекстЗапросаРасчетыСКонтрагентамиГрафики(ТекстыЗапроса, ИмяТаблицыДокумента());    
	
	//
	//СквозноеПланирование = ПолучитьФункциональнуюОпцию("РегистрироватьПотребностиЗаявкамиНаЗакупку");
	СквозноеПланирование = ПланированиеПотребностей.СквозноеПланированиеПотребностей();
	ГрафикПоставок = Запрос.Параметры.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок");
	ГрафикРасчетов = Запрос.Параметры.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикРасчетов")
						ИЛИ Запрос.Параметры.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок");  
	ГрафикНеИспользуется = (Запрос.Параметры.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.НеИспользовать"));	
	РасчетыПоДоговору = Запрос.Параметры.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	ГрафикДоговора = Запрос.Параметры.ГрафикДоговора;
	ВидКонтроляБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Запрос.Параметры.Дата);
	ВключенКонтрольБюджетаЗакупок =  ВидКонтроляБюджетаЗакупок = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов")
									ИЛИ ВидКонтроляБюджетаЗакупок = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств");

	ЕстьГрафикРасчетов = ДокументСсылка.ГрафикРасчетов.Количество();
	
	Если ГрафикДоговора = Перечисления.ГрафикиДоговора.Резервирование Тогда
		Запрос.УстановитьПараметр("ОбъектПланирования", ОбъектыПланирования.ПолучитьОбъектПланирования(Запрос.Параметры.ДоговорКонтрагента));
		ПодготовитьПланыПоДвижениямОперации(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
		ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокумента");
	ИначеЕсли ГрафикПоставок Тогда
		
			ФормироватьПланыПоГрафикуРасчетов = СквозноеПланирование И НЕ РасчетыПоДоговору;
		
			// Движения по графикам поставкам
			ПараметрыПланирования = ПодготовитьПараметрыПланированияПотребностей(ДокументСсылка, Запрос.МенеджерВременныхТаблиц, ВключенКонтрольБюджетаЗакупок);
			Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
			ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
			ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры, ФормироватьПланыПоГрафикуРасчетов, ПараметрыПланирования);
			
			Сч = 0;
			Пока Сч < ТекстыЗапроса.Количество() Цикл
				Если ТекстыЗапроса[Сч].Представление = "ТаблицаОперацииБюджетов" Тогда   
					ТекстыЗапроса[Сч].Представление = "ТаблицаОперацииБюджетовПоДаннымПланирования";
				Иначе
					Сч = Сч + 1;	
				КонецЕсли;
			КонецЦикла;
			
			ПодготовитьПланыПоГрафикуРасчетов(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
			ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокумента");
		
	ИначеЕсли ГрафикРасчетов Тогда
		ДобавитьПланыПоГрафикуРасчетов(ДокументСсылка, Запрос, ДополнительныеСвойства);   
	ИначеЕсли ГрафикНеИспользуется Тогда
		ДобавитьПредыдущиеПланыГрафикНеИспользуется(Запрос);
		ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокументаДляДвижений");  
	КонецЕсли;
	
	ПроведениеСерверУХ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);    
	
	Если ВидКонтроляБюджетаЗакупок = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов")
	И ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаОперацииБюджетовПоДаннымПланирования") И ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаОперацииБюджетов") Тогда
		
		СтруктураПоиска = Новый Структура("ВидБюджета", ВидКонтроляБюджетаЗакупок); 
		
		НайденныеСтрокиОперацииБюджетов = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОперацииБюджетов.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтрокиОперацииБюджетов Цикл
			ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОперацииБюджетов.Удалить(НайденнаяСтрока);
		КонецЦикла;
		
		НайденныеСтрокиОперацииБюджетовПоДаннымПланирования = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОперацииБюджетовПоДаннымПланирования.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтрокиОперацииБюджетовПоДаннымПланирования Цикл
			НоваяСтрокаОперацииБюджетов = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОперацииБюджетов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОперацииБюджетов, НайденнаяСтрока);
		КонецЦикла;
	
		ДополнительныеСвойства.ТаблицыДляДвижений.Удалить("ТаблицаОперацииБюджетовПоДаннымПланирования");
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеГрафика(ВидДоговораУХ = Неопределено) Экспорт

	НуженГрафик = РаботаСДоговорамиКонтрагентовУХПовтИсп.ВедетсяГрафикРасчетов(ВидДоговораУХ);
	
	Если Не НуженГрафик Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	СекцияТело                               = ФинансовыеИнструментыФормыКлиентСервер.ОписаниеСекцииГрафика();
	СекцияТело.Имя                           = "ОсновнойДолг";
	СекцияТело.КолонкаПриход                 = "СуммаНачисление";
	СекцияТело.КолонкаРасход                 = "СуммаОплата";
	СекцияТело.КолонкаРасходДДС              = Истина;	
	СекцияТело.КолонкаОстаток                = "СуммаЗадолженность";
	СекцияТело.Представление 				 = Нстр("ru = 'Основной долг'");
	СекцияТело.КолонкаПриходПредставление    = НСтр("ru = 'Начисление'");
	СекцияТело.КолонкаРасходПредставление    = НСтр("ru = 'Оплата'");
	СекцияТело.КолонкаОстатокПредставление 	 = НСтр("ru = 'Остаток'");

	СекцияТело.ЭлементСтруктурыЗадолженности = Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
	
	ЭтоДоходныйДоговор = УправлениеДоговорамиУХВызовСервераПовтИсп.ЭтоДоходныйДоговор(ВидДоговораУХ);
	
	Если ЭтоДоходныйДоговор Тогда
		
		СекцияТело.КолонкаПриходОперация = Справочники.ОперацииГрафиковДоговоров.ДоходныйКоммерческийДоговор_Начисление;	
		СекцияТело.КолонкаРасходОперация = Справочники.ОперацииГрафиковДоговоров.ДоходныйКоммерческийДоговор_Оплата;
		
	Иначе
		
		СекцияТело.КолонкаПриходОперация = Справочники.ОперацииГрафиковДоговоров.РасходныйКоммерческийДоговор_Начисление;
		СекцияТело.КолонкаРасходОперация = Справочники.ОперацииГрафиковДоговоров.РасходныйКоммерческийДоговор_Оплата;
		
	КонецЕсли;
	
	Результат.Вставить(СекцияТело.Имя, СекцияТело);
	
	ДоговорыКонтрагентовВстраиваниеУХ.ДобавитьИнформациюОбИтогахВОписаниеГрафика(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ВычисляемыеРеквизитыДоговора(ВерсияСоглашения) Экспорт
	
	Результат = Новый Структура;
	
	РаботаСДоговорамиКонтрагентовУХ.ЗаполнитьВычисляемыеРеквизитыДоговора(Результат, ВерсияСоглашения);
	
	Если ВерсияСоглашения.ВыданноеОбеспечение ИЛИ ВерсияСоглашения.ПолученноеОбеспечение Тогда
		Обеспеченность = Перечисления.ОбеспеченностьДоговоров.Обеспечен;
	Иначе
		Обеспеченность = Перечисления.ОбеспеченностьДоговоров.НеОбеспечен;
	КонецЕсли;
	
	Результат.Вставить("Обеспеченность", Обеспеченность);
	
	МассивФилиалы = ВерсияСоглашения.Филиалы.Выгрузить().ВыгрузитьКолонку("Организация");
	
	Результат.Вставить("Филиалы", 			МассивФилиалы);   
	
	ИспользоватьГрафикРасчетов = ВерсияСоглашения.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикРасчетов")
									ИЛИ ВерсияСоглашения.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок"); 
	Результат.Вставить("ИспользоватьГрафикРасчетов", ИспользоватьГрафикРасчетов); 
	
	ИспользоватьГрафикПоставок = ВерсияСоглашения.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок");
	Результат.Вставить("ИспользоватьГрафикПоставок", ИспользоватьГрафикПоставок);
	Результат.Вставить("ГрафикДоговора", ВерсияСоглашения.ГрафикДоговора);
	Результат.Вставить("СуммаВключаетНДС", ВерсияСоглашения.ЦенаВключаетНДС);

	ДоговорыКонтрагентовВстраиваниеУХ.ЗаполнитьВычисляемыеРеквизитыДоговора(Результат, ВерсияСоглашения);
	
	Если Не ЗначениеЗаполнено(ВерсияСоглашения.ВариантКурсаДоговора) Тогда
		Результат.Вставить("ВариантКурсаДоговора", 	РаботаСДоговорамиКонтрагентовЕХ.ПолучитьВариантКурсаДоговора(ВерсияСоглашения.СпособОпределенияКурсаПлатежа));	
	КонецЕсли; 
	Результат.Вставить("Менеджер", 			ВерсияСоглашения.Ответственный);
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив лотов регистрируемых ТЧ Номенклатура документа
// ВерсияСоглашенияКоммерческийДоговор.
//
Функция ПолучитьЛотыВерсии(ТЧНоменклатура) Экспорт
	ТЗ = ТЧНоменклатура.Выгрузить(,"Лот,АналитикаПланирования");
	ТЗ.Свернуть("Лот,АналитикаПланирования");
	мЛоты = Новый Массив;
	Для Каждого Строка Из ТЗ Цикл
		Если ЗначениеЗаполнено(Строка.Лот) Тогда   
			Если ТИПЗНЧ(Строка.Лот)  = ТИП("ДокументСсылка.Лот") И мЛоты.Найти(Строка.Лот) = Неопределено  Тогда       
				мЛоты.Добавить(Строка.Лот);                      
			ИначеЕсли ТИПЗНЧ(Строка.Лот)  = ТИП("ДокументСсылка.ПротоколВыбораПобедителей") Тогда
				Лот = Документы.ВерсияСоглашенияКоммерческийДоговор.ПолучитьЛотПоПротоколу(Строка.Лот,Строка.АналитикаПланирования);
				Если Лот <> Неопределено И мЛоты.Найти(Лот) = Неопределено Тогда
					мЛоты.Добавить(Лот);	
				КонецЕсли; 
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;    
	
	Возврат мЛоты;
КонецФункции

//Возврат Лота по протоколу
Функция ПолучитьЛотПоПротоколу(Протокол,АналитикаПланирования) Экспорт

	Запрос = Новый Запрос;    
	Запрос.УстановитьПараметр("Регистратор", Протокол);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланированиеПотребностей.АналитикаПланирования.ОбъектПланирования.Объект КАК Объект
	               |ИЗ
	               |	РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	               |ГДЕ
	               |	ПланированиеПотребностей.Регистратор = &Регистратор
	               |	И ПланированиеПотребностей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПланированиеПотребностей.АналитикаПланирования.ОбъектПланирования.Объект";   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Объект;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Проверяет, что в договоре установлен план поставок.
//
Функция ЕстьПланПоставокНоменклатуры(ВерсияСоглашения) Экспорт
	ТипВерсииСоглашения = ТипЗнч(ВерсияСоглашения);
	Если ЗначениеЗаполнено(ВерсияСоглашения)
		И (ТипВерсииСоглашения = 
				Тип("ДокументСсылка.ВерсияСоглашенияКоммерческийДоговор")
			ИЛИ ТипВерсииСоглашения = 
				Тип("ДокументОбъект.ВерсияСоглашенияКоммерческийДоговор"))
		Тогда
		Возврат ВерсияСоглашения.Номенклатура.Количество() > 0;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ОписаниеТабличныхЧастейДокумента() Экспорт
	
	ОписаниеТабличныхЧастей = РаботаСДоговорамиКонтрагентовУХ.НовыйОписаниеТабличныхЧастейДокумента();
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьОписаниеТабличнойЧасти(ОписаниеТабличныхЧастей, "Риски", Ложь);
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьОписаниеТабличнойЧасти(ОписаниеТабличныхЧастей, "ГрафикРасчетов", Ложь);
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьОписаниеТабличнойЧасти(ОписаниеТабличныхЧастей, "Номенклатура", Ложь);
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьОписаниеТабличнойЧасти(ОписаниеТабличныхЧастей, "ПроизводственныеКалендари", Истина);
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьОписаниеТабличнойЧасти(ОписаниеТабличныхЧастей, "РезультатыКонтроля", Ложь);
	
	Возврат ОписаниеТабличныхЧастей;	
КонецФункции

Функция ПолучитьФактическиеДанные(Договор, ОписаниеГрафика, ОперацииГрафика) Экспорт
	Возврат РаботаСДоговорамиКонтрагентовУХ.ФактическиеДанныеПоСекциямГрафика(Договор, ОписаниеГрафика, ОперацииГрафика);	
КонецФункции

Функция ИменаКлючевыхРеквизитов() Экспорт
	
	Результат = РаботаСДоговорамиКонтрагентовУХКлиентСервер.НовыйИменаКлючевыхРеквизитов();
	Результат.ДатаНачалаДействия = "ДатаНачалаДействия";
	Результат.ДатаОкончанияДействия = "ДатаОкончанияДействия";
	Результат.Сумма = "Сумма";
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоДоговорЦУЗ(ДокументОбъект) Экспорт
    Возврат (ДокументОбъект.ВидСоглашения <> Перечисления.ВидыСоглашений.РамочныйДоговор)
		И ЦентрализованныеЗакупкиКлиентСерверУХ.ЭтоДопустимыйВидДоговораУХ(
													ДокументОбъект.ВидДоговораУХ);
КонецФункции

Процедура ЗаполнитьДвиженияПланПоставокПоДоговорам(ДокументОбъект,
										ПланПоставокПоДоговорамНаборЗаписей) Экспорт
	ПланПоставокПоДоговорамНаборЗаписей.Записывать = Истина;
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
		РегистрыНакопления.ПланПоставокПоДоговорам.СторнироватьПланПоставокПоДокументу(
			ПланПоставокПоДоговорамНаборЗаписей,
			ПолучитьВыборкуДвиженийПланПоставокПоДоговорамДляСторнирования(
				ДокументОбъект));
	КонецЕсли;
			
	Если Документы.ВерсияСоглашенияКоммерческийДоговор.ЭтоДоговорЦУЗ(ДокументОбъект) Тогда
		РегистрыНакопления.ПланПоставокПоДоговорам.ДобавитьВПланПоставок(
			ПланПоставокПоДоговорамНаборЗаписей,
			ПолучитьВыборкуДляЗаписиДвиженийПланПоставокПоДоговорам(
				ДокументОбъект));
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьПереченьОперацийГрафиков(ОперацииГрафика, ОписаниеГрафика, ДокументОбъект) Экспорт
	
	// Закэшируем значения типов аналитик статьи.
	ВидыАналитикСтатьиДДС = АналитикиСтатейБюджетовУХВызовСервера.ВидыАналитикСтатей(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОбъект.СтатьяДвиженияДенежныхСредств));
	ВидыАналитикИсполнение = АналитикиСтатейБюджетовУХВызовСервера.ВидыАналитикСтатей(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОбъект.ОсновнаяСтатьяИсполнение),
		?(ДокументОбъект.ОсновнаяСтатьяИсполнение = Неопределено, ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов, Неопределено));
	
	Для Каждого ТекКлючЗначение Из ОперацииГрафика Цикл
		
		ТекОперация = ТекКлючЗначение.Значение;
		
		ТекОперация.ЦФО = ДокументОбъект.ОсновнойЦФО;
		ТекОперация.Проект = ДокументОбъект.ОсновнойПроект;
		ТекОперация.Валюта = ДокументОбъект.ВалютаВзаиморасчетов;
		ТекОперация.СчетОрганизации = ДокументОбъект.БанковскийСчет;
		ТекОперация.СчетКонтрагента = ДокументОбъект.БанковскийСчетКонтрагента;
		
		Если ТекОперация.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда
			
			ТекОперация.СтатьяБюджета = ДокументОбъект.СтатьяДвиженияДенежныхСредств;
			
			Для Сч = 1 по АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
				ТекОперация["Аналитика" + Сч] = ДокументОбъект["АналитикаБДДС" + Сч];
			КонецЦикла;
			
			Если ВидыАналитикСтатьиДДС.Количество() Тогда
				ЗаполнитьЗначенияСвойств(ТекОперация, ВидыАналитикСтатьиДДС[0]);
			КонецЕсли;
			
		Иначе
			
			ТекОперация.СтатьяБюджета = ДокументОбъект.ОсновнаяСтатьяИсполнение;
			
			Для Сч = 1 по АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
				ТекОперация["Аналитика" + Сч] = ДокументОбъект["АналитикаИсполнение" + Сч];
			КонецЦикла;
			
			Если ВидыАналитикИсполнение.Количество() Тогда
				ЗаполнитьЗначенияСвойств(ТекОперация, ВидыАналитикИсполнение[0]);
			КонецЕсли;
			// По умолчанию установлен вид бюджета БДР. Но может быть выбрана статья бюджета закупок.
			// В этом случае сбросим бюджет.
			Если ТипЗнч(ДокументОбъект.ОсновнаяСтатьяИсполнение) = Тип("СправочникСсылка.СтатьиДвиженияРесурсов") Тогда
				ТекОперация.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияРесурсов;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НовыйПараметрыРасчетаГрафика() Экспорт
	
	ПараметрыРасчета = Новый Структура;
	
	ПараметрыРасчета.Вставить("РежимРасчета", "ВесьГрафикОтДатыПервойОперации"); // "ВесьГрафикОтДатыПервойОперации", "ВесьГрафикОтДатыНачисления", "ТолькоПостоплата"
	ПараметрыРасчета.Вставить("ДатаОтсчета");
	ПараметрыРасчета.Вставить("ДополнительныеПараметры");
	
	Возврат ПараметрыРасчета;
	
КонецФункции

Процедура ВыполнитьРасчетГрафика(Объект, СекцияГрафика, ОписаниеГрафика, ОперацииГрафика, ПараметрыРасчета) Экспорт
	
	Если Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтапыГрафикаОплаты = Объект.ЭтапыГрафикаОплаты.Выгрузить();
	
	// Уточнение. Коммерческий договор имеет единственную секцию. 
	// Параметр СекцияГрафика нужен для унификации с прочими видами договоров.
	СекцияГрафика = ОписаниеГрафика.ОсновнойДолг;
	
	ПроизводственныеКалендари = РаботаСДоговорамиКонтрагентовУХ.ПроизводственныеКалендариВерсииСоглашения(Объект);
	
    ВариантыОплатыАванса = РасчетГрафиковОперацийЕХ.ВариантыОплатыАванса();

   	ПараметрыПозиций = Новый Структура;  
	ПараметрыПозиций.Вставить("СекцияГрафика", СекцияГрафика);
	ПараметрыПозиций.Вставить("ОписаниеГрафика", ОписаниеГрафика);
	ПараметрыПозиций.Вставить("ОперацииГрафика", ОперацииГрафика);
	ПараметрыПозиций.Вставить("ПроизводственныйКалендарь", ПроизводственныеКалендари);
	ПараметрыПозиций.Вставить("ЭтапыГрафикаОплаты", ЭтапыГрафикаОплаты);      
	ПараметрыПозиций.Вставить("СпособРасчетаКоличестваДней", Объект.СпособРасчетаКоличестваДней); 
	ПараметрыПозиций.Вставить("ВариантыОплатыАванса", ВариантыОплатыАванса);

	// нужно: Дата отсчета, производственный календарь
	Если Не ПараметрыРасчета.Свойство("РежимРасчета") Или ПараметрыРасчета.РежимРасчета = "ВесьГрафикОтДатыПервойОперации" Тогда
		
		// Определить дату начисления. Рассчитать все этапы оплаты. Добавить операцию начисления.
		Объект.ГрафикРасчетов.Очистить();
		
		БазоваяДата = РасчетГрафиковОперацийУХ.ПолучитьДатуНачисленияПоДатеПервойОперации(ПараметрыРасчета.ДатаОтсчета, ПараметрыПозиций);    
												
		ДобавитьПозициюВГрафик(Объект.ГрафикРасчетов, БазоваяДата, Объект.Сумма, Истина, ПараметрыПозиций);	//Начисление
		ДобавитьПозициюВГрафик(Объект.ГрафикРасчетов, БазоваяДата, Объект.Сумма, Ложь, ПараметрыПозиций); //Оплата	
		
	ИначеЕсли ПараметрыРасчета.РежимРасчета = "ВесьГрафикОтДатыНачисления" Тогда
		
	ИначеЕсли ПараметрыРасчета.РежимРасчета = "ТолькоПостоплата" Тогда
		
	ИначеЕсли ПараметрыРасчета.РежимРасчета = "ВесьГрафикПоГрафикуПоставок" Тогда
		
		Объект.ГрафикРасчетов.Очистить();

		ГрафикПоставок = ГрафикПоставок(Объект);     
											
		Если ГрафикПоставок <> Неопределено Тогда
		
			Для Каждого СтрокаГрафика Из ГрафикПоставок Цикл  
				
				ДобавитьПозициюВГрафик(Объект.ГрафикРасчетов,
										СтрокаГрафика.ДатаОперации,
					            		СтрокаГрафика.Сумма, 
										СтрокаГрафика.Начисление,
										ПараметрыПозиций,
										АналитикиДоговораПоГрафикуПоставок(СтрокаГрафика));  
			    
			КонецЦикла;    
			
		КонецЕсли;	
		
	ИначеЕсли ПараметрыРасчета.РежимРасчета = "ВесьГрафикОтДатыНачисления" Тогда

	ИначеЕсли ПараметрыРасчета.РежимРасчета = "ТолькоПостоплата" Тогда
                  
	ИначеЕсли ПараметрыРасчета.РежимРасчета = "ВесьГрафикПоСуммеПоставок" Тогда
		ПараметрыРасчетаПоСуммеПоставок = Неопределено;	
		ПараметрыРасчета.Свойство("ДополнительныеПараметры", ПараметрыРасчетаПоСуммеПоставок);  
			
		Если ПараметрыРасчетаПоСуммеПоставок <> Неопределено Тогда
			Объект.ГрафикРасчетов.Очистить();
			
			Если ПараметрыРасчетаПоСуммеПоставок.РежимРезервированияБюджета = Перечисления.РежимыРезервированияБюджета.Разово Тогда   
				
				ДобавитьПозициюВГрафик(Объект.ГрафикРасчетов,
									ПараметрыРасчетаПоСуммеПоставок.ДатаПоставки,
				            		ПараметрыРасчетаПоСуммеПоставок.Сумма, 
									Истина,
									ПараметрыПозиций,
									АналитикиДоговора(Объект, Истина)); //Начисление
								
				ДобавитьПозициюВГрафик(Объект.ГрафикРасчетов,
										ПараметрыРасчетаПоСуммеПоставок.ДатаПоставки,
					            		ПараметрыРасчетаПоСуммеПоставок.Сумма, 
										Ложь,
										ПараметрыПозиций,
										АналитикиДоговора(Объект)); //Оплата  
										
			ИначеЕсли ПараметрыРасчетаПоСуммеПоставок.РежимРезервированияБюджета = Перечисления.РежимыРезервированияБюджета.Периодически Тогда
				
				ДатаПервойПоставки = ПараметрыРасчетаПоСуммеПоставок.ДатаПервойПоставки;
				ДатаОкончанияПоставок = ПараметрыРасчетаПоСуммеПоставок.ДатаОкончанияПоставок;
				Периодичность = ПараметрыРасчетаПоСуммеПоставок.Периодичность;
				Сумма = ПараметрыРасчетаПоСуммеПоставок.Сумма;   
				
				РассчитатьГрафикПоСуммеПоставок(Объект,
												ДатаПервойПоставки,
												ДатаОкончанияПоставок,
												Периодичность,
												ПараметрыПозиций,
												Сумма);
				
				
			ИначеЕсли ПараметрыРасчетаПоСуммеПоставок.РежимРезервированияБюджета = Перечисления.РежимыРезервированияБюджета.РаспределениеСуммыНаГод Тогда  
				
				Год = ПараметрыРасчетаПоСуммеПоставок.Год;
				НачалоГода = НачалоГодаПоГоду(Год);
				КонецГода = КонецГодаПоГоду(Год);
				Периодичность = ПараметрыРасчетаПоСуммеПоставок.Периодичность;
				Сумма = ПараметрыРасчетаПоСуммеПоставок.Сумма;   
				
				РассчитатьГрафикПоСуммеПоставок(Объект,
												НачалоГода,
												КонецГода,
												Периодичность,
												ПараметрыПозиций,
												Сумма,
												Истина);
				
			КонецЕсли;
			
		КонецЕсли;

	Иначе
		
		ВызватьИсключение НСтр("ru = 'Некорректный режим расчета'");
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставленияКолонокГрафика() Экспорт
	
	ПредставленияКолонок = Новый Структура;
	
	ПредставленияКолонок.Вставить("Дата",					НСтр("ru = 'Дата'"));
	ПредставленияКолонок.Вставить("СуммаНачисление",		НСтр("ru = 'Начисление долга'"));
	ПредставленияКолонок.Вставить("СуммаОплата",			НСтр("ru = 'Оплата долга'"));
		
	Возврат ПредставленияКолонок;
	
КонецФункции

