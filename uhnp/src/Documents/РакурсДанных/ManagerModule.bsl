#Область СлужебныеПроцедурыИФункции

Функция НовыеПараметрыНастроек(РакурсДанных)
	
	ПараметрыНастроек = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов(РакурсДанных);
	
	ПараметрыНастроек.УправлениеПериодом = УправлениеРабочимиПроцессамиУХ.ПолучитьДокументУправленияПериодомСценария(
		ПараметрыНастроек.Сценарий, ПараметрыНастроек.ПериодОтчета);
	
	ПараметрыНастроек.ВерсияРегламента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ПараметрыНастроек.УправлениеПериодом, "ВерсияОрганизационнойСтруктуры");
	
	ПараметрыНастроек.ШаблонДокумента = РакурсДанных.Область.Владелец;
	
	Возврат ПараметрыНастроек;
	
КонецФункции


#КонецОбласти

#КонецЕсли
