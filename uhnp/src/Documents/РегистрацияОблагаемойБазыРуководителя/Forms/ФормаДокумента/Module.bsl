&НаСервере
Процедура ПриПолученииДанныхНаСервере(ТекущийОбъект)
	
	УстановитьФункциональныеОпцииФормы();
	
	ОтсутствуетТрудовойДоговорРуководителя = Объект.ОтсутствуетТрудовойДоговорРуководителя;
	
	ЗарплатаКадрыКлиентСервер.ЗаполнитьМесяцПоДате(ЭтаФорма, "Объект.ПериодРегистрации", "ПериодРегистрацииСтрокой");
	
	ЗаполнитьПредставлениеМесяцаПолученияДоходаВСтрокахТаблиц();
	
	ОписаниеКлючевыхРеквизитов = КлючевыеРеквизитыЗаполненияФормыОписаниеКлючевыхРеквизитов();
	
	ЗарплатаКадрыКлиентСервер.КлючевыеРеквизитыЗаполненияФормыУстановитьОтображениеПредупреждения(ЭтаФорма, , ОписаниеКлючевыхРеквизитов,);
	
	ЗарплатаКадры.КлючевыеРеквизитыЗаполненияФормыЗаполнитьПредупреждения(ЭтаФорма, ОписаниеКлючевыхРеквизитов);
	
	УстановитьОграничениеДнейПолномочий();
	ОбновитьКоличествоДней(ЭтотОбъект);
	
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()

	ПараметрыФО = Новый Структура;
	ПараметрыФО.Вставить("Организация", Объект.Организация);
	Если ЗначениеЗаполнено(Объект.ПериодРегистрации) Тогда
		ПараметрыФО.Вставить("Период", Объект.ПериодРегистрации);
	Иначе
		ПараметрыФО.Вставить("Период", ТекущаяДатаСеанса());
	КонецЕсли;
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФО);

КонецПроцедуры

&НаСервере
Процедура СотрудникПриИзмененииНаСервере()
	
	Объект.ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Сотрудник,"ФизическоеЛицо");
	ЗаполнитьДанные();
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура ФизическоеЛицоПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		Если Объект.ФизическоеЛицо <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Сотрудник,"ФизическоеЛицо") Тогда
			Объект.Сотрудник = Неопределено;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьДанные();
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанные()
	
	Если ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		Объект.ДнейОсуществленияПолномочий = КадровыйУчет.КалендарныеДниНаДолжностиЕдиноличногоРуководителя(Объект.Сотрудник,Объект.ПериодРегистрации);
		ОбновитьКоличествоДней(ЭтотОбъект);
	КонецЕсли;
	РассчитатьОблагаемуюБазу();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьОблагаемуюБазу()
	
	Если Объект.ДнейОсуществленияПолномочий > 0 Тогда
		Объект.СуммаОблагаемойБазы = УчетСтраховыхВзносов.ДополнительнаяОблагаемаяБазаРуководителя(Объект.Организация, Объект.ФизическоеЛицо,
						Объект.Сотрудник, Объект.ПериодРегистрации, Объект.ДнейОсуществленияПолномочий, Объект.Ссылка);
	Иначе
		Объект.СуммаОблагаемойБазы = 0;
	КонецЕсли;
	Объект.Взносы.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ПериодРегистрацииПриИзмененииНаСервере()
	
	УстановитьОграничениеДнейПолномочий();
	ЗаполнитьДанные();
	УстановитьФункциональныеОпцииФормы();
	УстановитьВидимостьКолонокТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	ЗаполнитьДанные();
	УправлениеФормой();
	УстановитьФункциональныеОпцииФормы();
КонецПроцедуры

&НаСервере
Функция СоответствиеДанныхОбъектаДанныхФормы()
	СоответствиеДанных = ЗарплатаКадрыОтображениеОшибок.ОписаниеПодчиненностиДанныхФормы();
	
	ЗарплатаКадрыОтображениеОшибок.ДобавитьОписаниеСвязиРеквизитов(СоответствиеДанных, "ПериодРегистрации", "ПериодРегистрацииСтрокой");
	
	Возврат СоответствиеДанных;
КонецФункции

// Функция возвращает описание таблиц формы подключенных к механизму ключевых реквизитов формы.
&НаСервере
Функция КлючевыеРеквизитыЗаполненияФормыТаблицыОчищаемыеПриИзменении() Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить("Объект.Взносы");
	Возврат Массив;
	
КонецФункции

// Функция возвращает массив реквизитов формы подключенных к механизму ключевых реквизитов формы.
&НаСервере
Функция КлючевыеРеквизитыЗаполненияФормыОписаниеКлючевыхРеквизитов() Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить(Новый Структура("ЭлементФормы, Представление", "Организация", НСтр("ru = 'организации';
																						|en = 'организации'")));	
	Возврат Массив
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииСоставаОчищаемойТаблицы(Форма)
	ЗарплатаКадрыКлиентСервер.КлючевыеРеквизитыЗаполненияФормыУстановитьОтображениеПредупреждения(Форма);	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКолонокТаблиц()
	УчетСтраховыхВзносов.УстановитьВидимостьКолонокТаблицыСтраховыхВзносов(ЭтотОбъект, Объект.ПериодРегистрации, "Взносы");
КонецПроцедуры

&НаСервере
Процедура ОтсутствуетТрудовойДоговорРуководителяПриИзмененииНаСервере()
	ОбновитьВидимостьЭлементовФормы();
	ОчиститьРеквизитыФормы();
	УправлениеФормой();
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьЭлементовФормы()
	
	ОтсутствуетТрудовойДоговор = Объект.ОтсутствуетТрудовойДоговорРуководителя;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"Сотрудник",
		"Видимость",
		НЕ ОтсутствуетТрудовойДоговор);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ФизическоеЛицо",
		"Видимость",
		ОтсутствуетТрудовойДоговор);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыФормы()

	Объект.ФизическоеЛицо = Неопределено;
	Объект.Сотрудник = Неопределено;
	Объект.СуммаОблагаемойБазы = 0;
	Объект.ДнейОсуществленияПолномочий = 0;
	Объект.Взносы.Очистить();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеМесяцаПолученияДоходаВСтрокахТаблиц()
	ЗарплатаКадрыКлиентСервер.ЗаполнитьМесяцПоДатеВТабличнойЧасти(Объект.Взносы, "ДатаПолученияДохода", "МесяцРасчетногоПериодаСтрокой");
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	ЗаданиеВыполненоВДлительнойОперации = Ложь;
	
	Попытка
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
				ПоместитьДанныеДляЗаполненияВДанныеФормы();
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
				ЗаданиеВыполненоВДлительнойОперации = Истина;
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания(
					"Подключаемый_ПроверитьВыполнениеЗадания",
					ПараметрыОбработчикаОжидания.ТекущийИнтервал,
					Истина);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
				
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаСервере
Функция РезультатЗаполненияВДлительнойОперации()
	
	СтруктураПараметров = Документы.РегистрацияОблагаемойБазыРуководителя.ПараметрыДляПолученияДанныхЗаполнения();
	СтруктураПараметров.Ссылка = Объект.Ссылка;
	СтруктураПараметров.Организация = Объект.Организация;
	СтруктураПараметров.ПериодРегистрации = Объект.ПериодРегистрации;
	СтруктураПараметров.РасчетныйПериод = Год(Объект.ПериодРегистрации);
	СтруктураПараметров.ФизическоеЛицо = Объект.ФизическоеЛицо;
	СтруктураПараметров.Сотрудник = Объект.Сотрудник;
	СтруктураПараметров.ДнейОсуществленияПолномочий = Объект.ДнейОсуществленияПолномочий;
	СтруктураПараметров.СуммаОблагаемойБазы = Объект.СуммаОблагаемойБазы;
	
	НаименованиеЗадания = НСтр("ru = 'Заполнение страховых взносов в документе ""Регистрация облагаемой базы руководителя""';
								|en = 'Заполнение страховых взносов в документе ""Регистрация облагаемой базы руководителя""'");
	
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор,
		"Документы.РегистрацияОблагаемойБазыРуководителя.ПодготовитьДанныеДляЗаполнения",
		СтруктураПараметров,
		НаименованиеЗадания);
	
	АдресХранилища = Результат.АдресХранилища;
	
	Если Результат.ЗаданиеВыполнено Тогда
		ПоместитьДанныеДляЗаполненияВДанныеФормы();
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПоместитьДанныеДляЗаполненияВДанныеФормы()
	Документы.РегистрацияОблагаемойБазыРуководителя.ДанныеДляЗаполненияИзВременногоХранилищаВДанныеДокумента(Объект, АдресХранилища);
	ЗаполнитьПредставлениеМесяцаПолученияДоходаВСтрокахТаблиц();
	ПриИзмененииСоставаОчищаемойТаблицы(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКоличествоДней(Форма)
	
	КоличествоДнейОсуществленияПолномочий = Форма.Объект.ДнейОсуществленияПолномочий;
	Форма.НадписьДней = СтрокаСЧислом("; день; ; дня; дней; дня",
							КоличествоДнейОсуществленияПолномочий,
							ВидЧисловогоЗначения.Количественное,
							"L=ru_RU");
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.ОбновитьКоличествоДнейОсуществленияПолномочий.Доступность =
		ЗначениеЗаполнено(Объект.Сотрудник) Или ЗначениеЗаполнено(Объект.ФизическоеЛицо);
	
	Элементы.ОбновитьСуммуОблагаемойБазы.Доступность =
		ЗначениеЗаполнено(Объект.Сотрудник) Или ЗначениеЗаполнено(Объект.ФизическоеЛицо);
	
КонецПроцедуры

