	#Если ВебКлиент Тогда
	ОпределитьСостояниеОбъекта(Истина);	
	#КонецЕсли	

	//
	ЭтотОбъект.ЕстьСуперПользователь = МодульСогласованияДокументовУХ.ЕстьСуперПользователь(Объект.ЦФО);
