// Процедура заполняет табличную часть документа из регистра
// Параметры:
//  Параметры  - Структура - Настройки для заполнения
Функция ПолучитьТаблицуОперацийБюджетов(Знач Параметры)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИнициализироватьЗапрос(Запрос, Параметры);
	
	//
	Запрос.Текст = 
		ТекстЗапроса_ВТ_ОперацииБюджетов(Запрос)
		+ ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета()
		+ ТекстЗапроса_ВТ_ОперацииБюджетовПоКлючевымАналитикам(Ложь, Истина);
			
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции

// Функция - возвращает текст отбора для виртуальной таблицы Обороты РН.ОперацииБюджетов
//
// Параметры:
//  Запрос	 - 	Запрос - Запрос, с заполненными параметрами
// 
// Возвращаемое значение:
//  Текст - Текст отбора для использования в виртуальной таблице Обороты РН.ОперацииБюджетов
//
Функция ТекстЗапроса_ВТ_ОперацииБюджетов(Запрос)

	ТекстОтбора = ТекстЗапроса_ОтборПоАналитикамДляВиртуальнойТаблицыОбороты(Запрос);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОперацииБюджетов.ВидБюджета КАК ВидБюджета,
	|	ОперацииБюджетов.Период КАК Период,
	|	ОперацииБюджетов.Валюта КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка) КАК ОбъектПланирования,
	|	ОперацииБюджетов.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ОперацииБюджетов.АналитикаПартнеров КАК АналитикаПартнеров,
	|	ОперацииБюджетов.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ОперацииБюджетов.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ОперацииБюджетов.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ОперацииБюджетов.КоличествоОборот КАК Количество,
	|	ОперацииБюджетов.СуммаОборот КАК Сумма
	|ПОМЕСТИТЬ ВТ_ОперацииБюджетов
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов.Обороты(
	|			,
	|			&ГраницаДокумента,
	|			ДЕНЬ,
	|			ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
	|				И &ОтборПоКлючевымАналитикам) КАК ОперацииБюджетов";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоКлючевымАналитикам", ТекстОтбора);
	
	Возврат ТекстЗапроса;

КонецФункции

//
Функция ТекстЗапроса_ВТ_ОперацииБюджетовПоКлючевымАналитикам(ФормироватьВременнуюТаблицу = Истина, РазворачиватьКлючи = Ложь)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_ОперацииБюджетов.ВидБюджета КАК ВидБюджета,
	|	ВТ_ОперацииБюджетов.Период КАК Период,
	|	ВТ_ОперацииБюджетов.ОбъектПланирования.Объект КАК ДокументПланирования,
	|	ВТ_ОперацииБюджетов.Валюта КАК Валюта,
	|	ВТ_ОперацииБюджетов.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ВТ_ОперацииБюджетов.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ВТ_ОперацииБюджетов.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ВТ_ОперацииБюджетов.АналитикаПартнеров КАК АналитикаПартнеров,
	|	&КлючиРазвернуты КАК КлючиРазвернуты,
	|	ВТ_ОперацииБюджетов.Количество КАК Количество,
	|	ВТ_ОперацииБюджетов.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ОперацииБюджетовПоКлючевымАналитикам
	|ИЗ 
	|	ВТ_ОперацииБюджетов КАК ВТ_ОперацииБюджетов";
	
	Если НЕ ФормироватьВременнуюТаблицу Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ_ОперацииБюджетовПоКлючевымАналитикам", "");
	КонецЕсли; 
	
	Если РазворачиватьКлючи Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючиРазвернуты", "ИСТИНА");
		
		ТекстДляЗамены = "КАК КлючиРазвернуты,";
		ТекстЗамены = ТекстДляЗамены + "
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтруктуры.ЦФО, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК ЦФО,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтруктуры.Проект, ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)) КАК Проект,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтруктуры.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаПартнеров.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаПартнеров.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК ДоговорКонтрагента,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.СтатьяБюджета, НЕОПРЕДЕЛЕНО) КАК СтатьяБюджета,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика1, НЕОПРЕДЕЛЕНО) КАК Аналитика1,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика2, НЕОПРЕДЕЛЕНО) КАК Аналитика2,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика3, НЕОПРЕДЕЛЕНО) КАК Аналитика3,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика4, НЕОПРЕДЕЛЕНО) КАК Аналитика4,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика5, НЕОПРЕДЕЛЕНО) КАК Аналитика5,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика6, НЕОПРЕДЕЛЕНО) КАК Аналитика6,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов.ПриходРасход, ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.ПустаяСсылка)) КАК ПриходРасход,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаПотребностей.МестоПоставки, ЗНАЧЕНИЕ(Справочник.МестаПоставки.ПустаяСсылка)) КАК МестоПоставки,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаПотребностей.Приоритет, ЗНАЧЕНИЕ(Справочник.ПриоритетыПотребностей.ПустаяСсылка)) КАК Приоритет,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаПотребностей.Менеджер, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК Менеджер,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаНоменклатуры.Номенклатура, неопределено) КАК Номенклатура,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаНоменклатуры.Характеристика, неопределено) КАК Характеристика,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаНоменклатуры.ЕдиницаИзмерения, неопределено) КАК ЕдиницаИзмерения,
			|	ЕСТЬNULL(ВТ_ОперацииБюджетов.АналитикаНоменклатуры.Коэффициент,1) КАК Коэффициент,";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстДляЗамены, ТекстЗамены);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючиРазвернуты", "ЛОЖЬ");
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьОписаниеРеквизитовДокумента()
	
	ИменаРеквизитов = 
		"Ссылка,Регистратор,Дата,Период,ВидБюджета,ВариантНастройки,
		|ЦФО,Проект,Организация,Контрагент,ДоговорКонтрагента,ПриходРасход,
		|СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6,
		|ВалютаДокумента,МестоПоставки,Номенклатура,Менеджер,Приоритет";
	
	СтруктураРеквизитов = Новый Структура(ИменаРеквизитов);
	
	СтруктураРеквизитов.Регистратор = "Ссылка";
	СтруктураРеквизитов.Период = "Дата";
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

#КонецОбласти 

// Функция возвращает структуру 
Функция ЗначенияСвойствОбъекта(Объект, СтруктураРеквизитов = Неопределено)

	Результат = Новый Структура;
	Для Каждого Поле Из СтруктураРеквизитов Цикл
		
		ПутьКДанным = Поле.Значение;
		Если НЕ ЗначениеЗаполнено(ПутьКДанным) Тогда
			ПутьКДанным = Поле.Ключ;
		КонецЕсли;
		
		Результат.Вставить(Поле.Ключ, Объект[ПутьКДанным]);
	КонецЦикла; 

	Возврат Результат;
	
КонецФункции

Функция СоответствиеВидаАналитикиРеквизитуФормы(ВидБюджета = Неопределено)
	
	Результат = Новый Соответствие;
	
	//
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикиОперативногоПланирования.Ссылка КАК ВидАналитики,
	|	АналитикиОперативногоПланирования.Предопределенный КАК Предопределенный,
	|	ВЫБОР
	|		КОГДА АналитикиОперативногоПланирования.Ссылка = ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.ВидБюджета)
	|			ТОГДА ""ВидБюджета""
	|		КОГДА АналитикиОперативногоПланирования.Предопределенный
	|			ТОГДА АналитикиОперативногоПланирования.ИмяПредопределенныхДанных
	|		ИНАЧЕ АналитикиОперативногоПланирования.Наименование
	|	КОНЕЦ КАК Имя,
	|	ВЫБОР
	|		КОГДА АналитикиОперативногоПланирования.Предопределенный
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ АналитикиОперативногоПланирования.ТипДанных
	|	КОНЕЦ КАК ТипДанных
	|ИЗ
	|	Справочник.АналитикиОперативногоПланирования КАК АналитикиОперативногоПланирования
	|ГДЕ
	|	АналитикиОперативногоПланирования.ПометкаУдаления = ЛОЖЬ";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТипДанных = ОперативноеПланированиеПовтИспУХ.ПолучитьТипАналитикиОперПланирования(Выборка.ВидАналитики, ВидБюджета);
		Если ТипДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеАналитики = Новый_ОписаниеАналитики(Выборка.Имя, ТипДанных);
		Результат.Вставить(Выборка.ВидАналитики, ОписаниеАналитики);
			
	КонецЦикла;
	
	Если Результат[Справочники.АналитикиОперативногоПланирования.Валюта] <> Неопределено Тогда
		Результат[Справочники.АналитикиОперативногоПланирования.Валюта].ИмяРеквизитаШапки = "ВалютаДокумента";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОписаниеАналитики(Имя, Тип, ИмяРеквизитаШапки = неопределено)
	
	Если ИмяРеквизитаШапки = Неопределено Тогда
		ИмяРеквизитаШапки = Имя;
	КонецЕсли;
	
	Возврат Новый Структура("Имя, Тип, ИмяРеквизитаШапки", Имя, Тип, ИмяРеквизитаШапки);
	
КонецФункции

Функция ПолучитьФорматЧисла(Разрядность, ПослеЗапятой)
	
	//
	Если Разрядность = "Единицы" Тогда
		ЧС = Неопределено;
	ИначеЕсли Разрядность = "Тысячи" Тогда
		ЧС = 3;
	ИначеЕсли Разрядность = "Миллионы" Тогда
		ЧС = 6;
	ИначеЕсли Разрядность = "Миллиарды" Тогда
		ЧС = 9;
	Иначе
		Возврат "";
	КонецЕсли;
	
	//
	ЧДЦ = ПослеЗапятой;
	
	Результат = "ЧДЦ=" + Формат(ЧДЦ,"ЧДЦ=0; ЧГ=0");
	Если ЧС <> Неопределено Тогда
		Результат = Результат + "; ЧС=" + Формат(ЧС, "ЧДЦ=0; ЧГ=0");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеРазрядности(Разрядность)
	
	//
	Если Разрядность = "Единицы" Тогда
		Возврат "";
	ИначеЕсли Разрядность = "Тысячи" Тогда
		Возврат НСтр("ru='тыс.'");
	ИначеЕсли Разрядность = "Миллионы" Тогда
		Возврат НСтр("ru='млн.'");
	ИначеЕсли Разрядность = "Миллиарды" Тогда
		Возврат НСтр("ru='млрд.'");
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

#Область ИсточникиДляКонтроляДокумента

Функция ИсточникиДокумента(Объект, ПараметрыКонтроля) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект, ПараметрыКонтроля));
	
	Возврат Источники;
	
КонецФункции

Функция Источник_БюджетныеЛимитыРезервы(Объект, ДопПараметры)
	
	// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			Не ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект,, ДопПараметры);
	Запрос.УстановитьПараметр("ТипЗаявкиНаОбеспечение", КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению()[0]);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	неопределено КАК ДокументПланирования,
	|	ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) = &ТипЗаявкиНаОбеспечение ТОГДА ВТ_ПланыДокумента.ДокументПланирования ИНАЧЕ неопределено КОНЕЦ КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	ВЫБОР КОГДА ВТ_ПланыДокумента.ДокументПланирования = неопределено ТОГДА СУММА(ВТ_ПланыДокумента.Сумма) ИНАЧЕ 0 КОНЕЦ КАК Лимит,
	|	ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПланыДокумента.ДокументПланирования) = &ТипЗаявкиНаОбеспечение ТОГДА СУММА(ВТ_ПланыДокумента.Сумма) ИНАЧЕ 0 КОНЕЦ КАК Зарезервировано,
	|	0 КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПланыДокумента.Аналитика6,
	|	ВТ_ПланыДокумента.ДокументПланирования,
	|	ВТ_ПланыДокумента.Аналитика1,
	|	ВТ_ПланыДокумента.ВидБюджета,
	|	ВТ_ПланыДокумента.ЦФО,
	|	ВТ_ПланыДокумента.СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика3,
	|	ВТ_ПланыДокумента.Проект,
	|	ВТ_ПланыДокумента.Аналитика5,
	|	ВТ_ПланыДокумента.Организация,
	|	ВТ_ПланыДокумента.Период,
	|	ВТ_ПланыДокумента.Валюта,
	|	ВТ_ПланыДокумента.ПриходРасход,
	|	ВТ_ПланыДокумента.Аналитика2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.Выполнить();

	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;
	
КонецФункции      

#КонецОбласти  

#Область ПланыДокумента

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено, ПараметрыКонтроля = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.УстановитьПараметр("ТипЗаявкиНаОбеспечение", Тип("ДокументСсылка.ЗаявкаНаКорректировкуПланов"));
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ДатаДокумента КАК ДатаРегистрации,
	|	&ВидБюджета КАК ВидБюджета,
	|	Коллекция.Валюта КАК Валюта,
	|	ВЫРАЗИТЬ(Коллекция.Период КАК Справочник.Периоды).ДатаНачала КАК ДатаНачала,
	|	Коллекция.Организация КАК Организация,
	|	Коллекция.ЦФО КАК ЦФО,
	|	Коллекция.Проект КАК Проект,
	|	Коллекция.ПриходРасход КАК ПриходРасход,
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджета,
	|	Коллекция.Аналитика1 КАК Аналитика1,
	|	Коллекция.Аналитика2 КАК Аналитика2,
	|	Коллекция.Аналитика3 КАК Аналитика3,
	|	Коллекция.Аналитика4 КАК Аналитика4,
	|	Коллекция.Аналитика5 КАК Аналитика5,
	|	Коллекция.Аналитика6 КАК Аналитика6,
	|	Коллекция.Контрагент КАК Контрагент,
	|	Коллекция.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Коллекция.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_Коллекция
	|ИЗ
	|	Документ.ОперативныйПлан.ДвиженияОперации КАК Коллекция
	|ГДЕ
	|	Коллекция.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ДатаДокумента КАК ДатаРегистрации,
	|	ДанныеРегистра.ВидБюджета КАК ВидБюджета,
	|	ДанныеРегистра.Валюта КАК Валюта,
	|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
	|	ДанныеРегистра.Период КАК Период,
	|	ДанныеРегистра.АналитикаСтруктуры.Организация КАК Организация,
	|	ДанныеРегистра.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	ДанныеРегистра.АналитикаСтруктуры.Проект КАК Проект,
	|	ДанныеРегистра.ПриходРасход КАК ПриходРасход,
	|	ДанныеРегистра.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|	ДанныеРегистра.АналитикаПартнеров.Контрагент КАК Контрагент,
	|	ДанныеРегистра.АналитикаПартнеров.Договор КАК ДоговорКонтрагента,
	|	-ДанныеРегистра.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов КАК ДанныеРегистра
	|ГДЕ
	|	(ДанныеРегистра.Период, ДанныеРегистра.АналитикаСтатейБюджетов.СтатьяБюджета, ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1, ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2, ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3, ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4, ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5, ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6) В
	|			(ВЫБРАТЬ
	|				ВТ_Коллекция.ДатаНачала КАК ДатаНачала,
	|				ВТ_Коллекция.СтатьяБюджета КАК СтатьяБюджета,
	|				ВТ_Коллекция.Аналитика1 КАК Аналитика1,
	|				ВТ_Коллекция.Аналитика2 КАК Аналитика2,
	|				ВТ_Коллекция.Аналитика3 КАК Аналитика3,
	|				ВТ_Коллекция.Аналитика4 КАК Аналитика4,
	|				ВТ_Коллекция.Аналитика5 КАК Аналитика5,
	|				ВТ_Коллекция.Аналитика6 КАК Аналитика6
	|			ИЗ
	|				ВТ_Коллекция КАК ВТ_Коллекция)
	|	И ДанныеРегистра.ДатаРегистрации <= &ДатаДокумента
	|	И НЕ ДанныеРегистра.Регистратор = &Ссылка
	|	И &УсловиеОтбора
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДатаДокумента,
	|	&ВидБюджета,
	|	Коллекция.Валюта,
	|	НЕОПРЕДЕЛЕНО,
	|	Коллекция.ДатаНачала,
	|	Коллекция.Организация,
	|	Коллекция.ЦФО,
	|	Коллекция.Проект,
	|	Коллекция.ПриходРасход,
	|	Коллекция.СтатьяБюджета,
	|	Коллекция.Аналитика1,
	|	Коллекция.Аналитика2,
	|	Коллекция.Аналитика3,
	|	Коллекция.Аналитика4,
	|	Коллекция.Аналитика5,
	|	Коллекция.Аналитика6,
	|	Коллекция.Контрагент,
	|	Коллекция.ДоговорКонтрагента,
	|	Коллекция.Сумма
	|ИЗ
	|	ВТ_Коллекция КАК Коллекция";
	
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда

		ОписаниеКТ = СформироватьОписаниеКТПоОбъекту(Источник);
		
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Дата, ВидБюджета");
		Запрос.УстановитьПараметр("ДатаДокумента", 	Реквизиты.Дата);
		Запрос.УстановитьПараметр("ВидБюджета", 	Реквизиты.ВидБюджета);
	ИначеЕсли ТипЗнч(ПараметрыКонтроля) = Тип("Структура") И ПараметрыКонтроля.Свойство("ПланыДокумента") Тогда

		ОписаниеКТ = ПараметрыКонтроля.ПланыДокумента.ОписаниеКТ;
		
		Запрос.УстановитьПараметр("ДатаДокумента", Источник.Дата);
		Запрос.УстановитьПараметр("ВидБюджета", Источник.ВидБюджета);
		ВТ_ДвиженияОперации = ПараметрыКонтроля.ПланыДокумента.ПланыДокумента.Скопировать();
		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		ВТ_ДвиженияОперации.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		ВТ_ДвиженияОперации.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("ВТ_ДвиженияОперации", ВТ_ДвиженияОперации);
		Запрос.Текст =
		"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ДвиженияОперации ИЗ &ВТ_ДвиженияОперации КАК Коллекция";
		Запрос.Выполнить();
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ОперативныйПлан.", "ВТ_");
		
	Иначе
		
		ОписаниеКТ = СформироватьОписаниеКТПоОбъекту(Источник);
		
		Запрос.УстановитьПараметр("ДатаДокумента", Источник.Дата);
		Запрос.УстановитьПараметр("ВидБюджета", Источник.ВидБюджета);
		
		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		Реквизиты = "Контрагент, ДоговорКонтрагента, Сумма, ПриходРасход, Валюта, Период, Организация, ЦФО, Проект, СтатьяБюджета," 
					+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
		ВТ_ДвиженияОперации = Источник.ДвиженияОперации.Выгрузить(,Реквизиты + ",Сумма");
		ВТ_ДвиженияОперации.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		ВТ_ДвиженияОперации.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("ВТ_ДвиженияОперации", ВТ_ДвиженияОперации);
		Запрос.Текст =
		"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ДвиженияОперации ИЗ &ВТ_ДвиженияОперации КАК Коллекция";
		Запрос.Выполнить();
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ОперативныйПлан.", "ВТ_");
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбора", ЗаполнитьУсловияОтбораПоОписаниюКТДляПланирования(Запрос, ОписаниеКТ, Источник));
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ПланыДокумента");
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции

#КонецОбласти 

Функция ТекстЗапроса_ОтборПоАналитикамДляВиртуальнойТаблицыОбороты(Запрос)
	
	// Шаблоны
	ШаблонПоля = "%2 КАК %1";
	
	// Формирование динамического запроса
	ИзмеренияДляОтбора = Новый Массив;
	Поля = Новый Массив;
	Таблицы = Новый Массив;
	
	// Из таблицы ВТ_КлючиДокумента
	Если Запрос.Параметры.КлючВидБюджета Тогда
		ИзмеренияДляОтбора.Добавить("ВидБюджета");
		Поля.Добавить(СтрШаблон(ШаблонПоля, "ВидБюджета", "ВТ_КлючиДокумента.ВидБюджета"));
		ДобавитьТаблицуВТ_КлючиДокумента = Истина;
	КонецЕсли;
	Если Запрос.Параметры.КлючВалюта Тогда
		ИзмеренияДляОтбора.Добавить("Валюта");
		Поля.Добавить(СтрШаблон(ШаблонПоля, "Валюта", "ВТ_КлючиДокумента.Валюта"));
		ДобавитьТаблицуВТ_КлючиДокумента = Истина;
	КонецЕсли;
	Если ДобавитьТаблицуВТ_КлючиДокумента = Истина Тогда
		Таблицы.Добавить(СтрШаблон(ШаблонПоля, "ВТ_КлючиДокумента", "ВТ_КлючевыеРеквизитыДокумента"));
	КонецЕсли;
	
	// Из таблицы ВТ_КлючиСтруктуры
	Если Запрос.Параметры.ТребуетсяОтборПоКлючамСтруктуры Тогда
		ИзмеренияДляОтбора.Добавить("АналитикаСтруктуры");
		Поля.Добавить(СтрШаблон(ШаблонПоля, "АналитикаСтруктуры", "ВТ_КлючиСтруктуры.КлючАналитики"));
		Таблицы.Добавить(СтрШаблон(ШаблонПоля, "ВТ_КлючиСтруктуры", "ВТ_КлючиСтруктуры"));
	КонецЕсли;
	
	// Из таблицы ВТ_КлючиСтатейБюджета
	Если Запрос.Параметры.ТребуетсяОтборПоКлючамСтатейБюджета Тогда
		ИзмеренияДляОтбора.Добавить("АналитикаСтатейБюджетов");
		Поля.Добавить(СтрШаблон(ШаблонПоля, "АналитикаСтатейБюджетов", "ВТ_КлючиСтатейБюджета.КлючАналитики"));
		Таблицы.Добавить(СтрШаблон(ШаблонПоля, "ВТ_КлючиСтатейБюджета", "ВТ_КлючиСтатейБюджета"));
	КонецЕсли;
	
	// Из таблицы ВТ_КлючиПартнеров
	Если Запрос.Параметры.ТребуетсяОтборПоКлючамПартнеров Тогда
		ИзмеренияДляОтбора.Добавить("АналитикаПартнеров");
		Поля.Добавить(СтрШаблон(ШаблонПоля, "АналитикаПартнеров", "ВТ_КлючиПартнеров.КлючАналитики"));
		Таблицы.Добавить(СтрШаблон(ШаблонПоля, "ВТ_КлючиПартнеров", "ВТ_КлючиПартнеров"));
	КонецЕсли;  
	
	//
	ШаблонОтбора = "(%1) В (%2)";
	ШаблонТекстЗапросаСДаннымиОтбора = 
	"ВЫБРАТЬ
	|	%1
	|ИЗ
	|	%2";
	
	ТекстЗапросаСДаннымиОтбора = СтрШаблон(ШаблонТекстЗапросаСДаннымиОтбора,
		СтрСоединить(Поля, ",
							|	"),
		СтрСоединить(Таблицы, ",
							|	"));

	ТекстПолейОтбора = СтрСоединить(ИзмеренияДляОтбора, ", ");
	Возврат СтрШаблон(ШаблонОтбора, ТекстПолейОтбора, ТекстЗапросаСДаннымиОтбора);
	
КонецФункции

Функция ЗаполнитьУсловияОтбораПоОписаниюКТДляПланирования(Запрос, ОписаниеКТ, Объект)
	
	УсловияОтбора = Новый Массив;
	УсловияОтбора.Добавить("ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)");

	Для Каждого Аналитика Из ОписаниеКТ.Схема.Аналитики.мШапка Цикл
		
		Если Аналитика = "ВидБюджета" Тогда
			Запрос.УстановитьПараметр("ВидБюджета", Объект.ВидБюджета);
			УсловияОтбора.Добавить("ВидБюджета = &ВидБюджета");
		ИначеЕсли Аналитика = "Валюта" Тогда
			Запрос.УстановитьПараметр("Валюта", Объект.ВалютаДокумента);
			УсловияОтбора.Добавить("Валюта = &Валюта");
		ИначеЕсли Аналитика = "ЦФО" Тогда
			Запрос.УстановитьПараметр("ЦФО", Объект.ЦФО);
			УсловияОтбора.Добавить("АналитикаСтруктуры.ЦФО = &ЦФО");
		ИначеЕсли Аналитика = "Проект" Тогда
			Запрос.УстановитьПараметр("Проект", Объект.Проект);
			УсловияОтбора.Добавить("АналитикаСтруктуры.Проект = &Проект");
		ИначеЕсли Аналитика = "СтатьяБюджета" Тогда
			Запрос.УстановитьПараметр("СтатьяБюджета", Объект.СтатьяБюджета);
			Запрос.УстановитьПараметр("Аналитика1", Объект.Аналитика1);
			Запрос.УстановитьПараметр("Аналитика2", Объект.Аналитика2);
			Запрос.УстановитьПараметр("Аналитика3", Объект.Аналитика3);
			Запрос.УстановитьПараметр("Аналитика4", Объект.Аналитика4);
			Запрос.УстановитьПараметр("Аналитика5", Объект.Аналитика5);
			Запрос.УстановитьПараметр("Аналитика6", Объект.Аналитика6);
			УсловияОтбора.Добавить("АналитикаСтатейБюджетов.СтатьяБюджета= &СтатьяБюджета");
			УсловияОтбора.Добавить("АналитикаСтатейБюджетов.Аналитика1 = &Аналитика1");
			УсловияОтбора.Добавить("АналитикаСтатейБюджетов.Аналитика2 = &Аналитика2");
			УсловияОтбора.Добавить("АналитикаСтатейБюджетов.Аналитика3 = &Аналитика3");
			УсловияОтбора.Добавить("АналитикаСтатейБюджетов.Аналитика4 = &Аналитика4");
			УсловияОтбора.Добавить("АналитикаСтатейБюджетов.Аналитика5 = &Аналитика5");
			УсловияОтбора.Добавить("АналитикаСтатейБюджетов.Аналитика6 = &Аналитика6");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(УсловияОтбора, " И ");
	
КонецФункции

Функция СформироватьОписаниеКТПоОбъекту(ДокументОбъект)
	
	СхемаКТ = Новый Структура("Аналитики", Новый Структура);
	
	СхемаКТ.Вставить("РеквизитПоАналитике",	СоответствиеВидаАналитикиРеквизитуФормы(ДокументОбъект.ВидБюджета));
	СхемаКТ.Аналитики.Вставить("мШапка", Новый Массив);
	
	СтруктураПоиска = Новый Структура("Использование", Перечисления.ИспользованиеАналитик.КлючеваяАналитика);
	Строки = ДокументОбъект.НастройкаАналитик.НайтиСтроки(СтруктураПоиска);
	Для Каждого Строка Из Строки Цикл
		
		//
		ОписаниеРеквизита = СхемаКТ.РеквизитПоАналитике[Строка.Аналитика];
		Если ОписаниеРеквизита = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//
		СхемаКТ.Аналитики.мШапка.Добавить(ОписаниеРеквизита.Имя);
		
	КонецЦикла;
	
	ОписаниеКТ = Новый Структура("Схема", СхемаКТ);
	Возврат ОписаниеКТ;
	
КонецФункции

#КонецОбласти

#КонецЕсли
