#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Белоконенко Денис 07.02.2024 Выполнение задач №000048056
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ОписаниеОшибки", "");
	
	ДополнительныеРеквизиты = ХранилищеДополнительныхРеквизитов.Получить();    
	
	// НАЧАЛО Юдина Екатерина 17.10.2025 Выполнение задач №000055536
	Если ДополнительныеРеквизиты = Неопределено Тогда      
		ТекстОшибки = "Некорректные данные. Документ необходимо передать по обмену.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , , Отказ);
		Возврат;
	КонецЕсли;	
	// КОНЕЦ Юдина Екатерина 17.10.2025 Выполнение задач №000055536
	
	Если ДополнительныеРеквизиты.Свойство("ПропуститьПроверкуЗапретаИзменения") Тогда
		ДополнительныеРеквизиты.Удалить("ПропуститьПроверкуЗапретаИзменения");
	КонецЕсли;
	
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка);	
	
	// НАЧАЛО Белоконенко Денис 20.09.2024 Выполнение задач №000050886 
	ЭтотОбъект.Номер = тн_Интеграция_ERP_УХ.НомерДокумента11Символов(ЭтотОбъект.Номер + "П", 11);
	// КОНЕЦ Белоконенко Денис 20.09.2024 Выполнение задач №000050886
	
	Если ВидОперации = Перечисления.тн_ВидыОперацийЕдиныйПолучениеУслугПоПереработке.ПолучениеУслугПоПереработке Тогда
		// 1. ПоступлениеОтПереработчика
		Если ЗначениеЗаполнено(СтруктураДокументы.ПоступлениеОтПереработчика.Документ) Тогда
			ПоступлениеОтПереработчикаОб = СтруктураДокументы.ПоступлениеОтПереработчика.Документ.ПолучитьОбъект();
		Иначе
			ПоступлениеОтПереработчикаОб = Документы.ПоступлениеОтПереработчика.СоздатьДокумент();
		КонецЕсли;
	
		// Шапка      	
		ЗаполнитьЗначенияСвойств(ПоступлениеОтПереработчикаОб, ЭтотОбъект);
		Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл
			ПоступлениеОтПереработчикаОб.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
		КонецЦикла;
		ПоступлениеОтПереработчикаОб.тн_ЕдиныйПолучениеУслугПоПереработке = Ссылка;
	
		// ТЧ Товары
		ПоступлениеОтПереработчикаОб.Товары.Очистить();
		Для Каждого Стр Из ЭтотОбъект.Материалы Цикл
			НоваяСтрока = ПоступлениеОтПереработчикаОб.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЦикла;
	
		Документы.ПоступлениеОтПереработчика.ДозаполнитьОбъект(ПоступлениеОтПереработчикаОб, Отказ, Результат);
	
		ПоступлениеОтПереработчикаОб.Записать(РежимЗаписиДокумента.Проведение);
		
		// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
		// НАЧАЛО Егоров Петр 10.06.2025 Выполнение задач №000054028
		//РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ПоступлениеОтПереработчикаОб.Ссылка);
		РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ПоступлениеОтПереработчикаОб.Ссылка,ПоступлениеОтПереработчикаОб.Организация,ПоступлениеОтПереработчикаОб.Дата);
		// КОНЕЦ Егоров Петр 10.06.2025 Выполнение задач №000054028
		// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699  
	
		// 2. ОтчетПереработчика
		Если ЗначениеЗаполнено(СтруктураДокументы.ОтчетПереработчика.Документ) Тогда
			ОтчетПереработчикаОб = СтруктураДокументы.ОтчетПереработчика.Документ.ПолучитьОбъект();
		Иначе
			ОтчетПереработчикаОб = Документы.ОтчетПереработчика.СоздатьДокумент();
		КонецЕсли;
		
		// Шапка      	
		ЗаполнитьЗначенияСвойств(ОтчетПереработчикаОб, ЭтотОбъект);
		Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл 
			ОтчетПереработчикаОб.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
		КонецЦикла; 
		
		ОтчетПереработчикаОб.тн_ЕдиныйПолучениеУслугПоПереработке = Ссылка;
		
		// ТЧ Материалы
		ОтчетПереработчикаОб.Материалы.Очистить();
		Для Каждого Стр Из ЭтотОбъект.Материалы Цикл
			НоваяСтрока = ОтчетПереработчикаОб.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЦикла;
		
		Документы.ОтчетПереработчика.ДозаполнитьОбъект(ОтчетПереработчикаОб, Отказ, Результат);
		
		// НАЧАЛО Белоконенко Денис 10.06.2024 Выполнение задач №000049841
		ОтчетПереработчикаОб.СуммаСНДС 	= ЭтотОбъект.СуммаДокумента; 
		ОтчетПереработчикаОб.Сумма 		= ЭтотОбъект.Сумма;
		// КОНЕЦ Белоконенко Денис 10.06.2024 Выполнение задач №000049841		
		
		ОтчетПереработчикаОб.Записать(РежимЗаписиДокумента.Проведение);
	
		// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
		// НАЧАЛО Егоров Петр 10.06.2025 Выполнение задач №000054028
		//РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ОтчетПереработчикаОб.Ссылка);
		РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(Ссылка,Ссылка.Организация,Ссылка.Дата);
		// КОНЕЦ Егоров Петр 10.06.2025 Выполнение задач №000054028
		// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699 

	ИначеЕсли ВидОперации = Перечисления.тн_ВидыОперацийЕдиныйПолучениеУслугПоПереработке.ПолучениеУслугПоПереработкеБПр Тогда
		// 1. ПриобретениеУслугПрочихАктивов
		Если ЭтотОбъект.Услуги.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(СтруктураДокументы.ПриобретениеУслугПрочихАктивов.Документ) Тогда
				ПриобретениеУслугПрочихАктивовОб = СтруктураДокументы.ПриобретениеУслугПрочихАктивов.Документ.ПолучитьОбъект();
			Иначе
				ПриобретениеУслугПрочихАктивовОб = Документы.ПриобретениеУслугПрочихАктивов.СоздатьДокумент();
			КонецЕсли;
		
			// Шапка      	
			ЗаполнитьЗначенияСвойств(ПриобретениеУслугПрочихАктивовОб, ЭтотОбъект);
			Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл
				ПриобретениеУслугПрочихАктивовОб.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
			КонецЦикла;
			ПриобретениеУслугПрочихАктивовОб.тн_ЕдиныйПолучениеУслугПоПереработке = Ссылка;
			// НАЧАЛО Белоконенко Денис 20.09.2024 Выполнение задач №000050886
			ПриобретениеУслугПрочихАктивовОб.ДополнительныеСвойства.Вставить("distributionMethod", Неопределено);
			// КОНЕЦ Белоконенко Денис 20.09.2024 Выполнение задач №000050886
		
			// ТЧ Расходы
			ПриобретениеУслугПрочихАктивовОб.Расходы.Очистить();
			Для Каждого Стр Из ЭтотОбъект.Услуги Цикл
				НоваяСтрока = ПриобретениеУслугПрочихАктивовОб.Расходы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЦикла;
		
			Документы.ПриобретениеУслугПрочихАктивов.ДозаполнитьОбъект(ПриобретениеУслугПрочихАктивовОб, Отказ, Результат);
			
			ПриобретениеУслугПрочихАктивовОб.Записать(РежимЗаписиДокумента.Проведение); 
			
			// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
			// НАЧАЛО Егоров Петр 10.06.2025 Выполнение задач №000054028
			//РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ПриобретениеУслугПрочихАктивовОб.Ссылка);
			РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(Ссылка,Ссылка.Организация,Ссылка.Дата);
			// КОНЕЦ Егоров Петр 10.06.2025 Выполнение задач №000054028
			// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
			
		КонецЕсли;
	 	
		// 2. ВнутреннееПотребление
		Если ЗначениеЗаполнено(СтруктураДокументы.ВнутреннееПотребление.Документ) Тогда
			ВнутреннееПотреблениеОб = СтруктураДокументы.ВнутреннееПотребление.Документ.ПолучитьОбъект();
		Иначе
			ВнутреннееПотреблениеОб = Документы.ВнутреннееПотребление.СоздатьДокумент();
		КонецЕсли;
		
		// Шапка      	
		ЗаполнитьЗначенияСвойств(ВнутреннееПотреблениеОб, ЭтотОбъект);
		Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл 
			ВнутреннееПотреблениеОб.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
		КонецЦикла; 
		ВнутреннееПотреблениеОб.ДополнительныеСвойства.Вставить("isAdvertising", Ложь);
		// НАЧАЛО Белоконенко Денис 20.09.2024 Выполнение задач №000050886
		ВнутреннееПотреблениеОб.ДополнительныеСвойства.Вставить("useOrganizationalUnit", Неопределено);
		// КОНЕЦ Белоконенко Денис 20.09.2024 Выполнение задач №000050886		
			
		ВнутреннееПотреблениеОб.тн_ЕдиныйПолучениеУслугПоПереработке = Ссылка;
			
		// ТЧ Товары
		ВнутреннееПотреблениеОб.Товары.Очистить();
		Для Каждого Стр Из ЭтотОбъект.Материалы Цикл
			НоваяСтрока = ВнутреннееПотреблениеОб.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЦикла;
		
		Документы.ВнутреннееПотребление.ДозаполнитьОбъект(ВнутреннееПотреблениеОб, Отказ, Результат);
		
		Если Не ЗначениеЗаполнено(ВнутреннееПотреблениеОб.ПотреблениеДляДеятельности) Тогда
			ВнутреннееПотреблениеОб.ПотреблениеДляДеятельности = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		КонецЕсли;
			
		ВнутреннееПотреблениеОб.Записать(РежимЗаписиДокумента.Проведение);
			
		// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
		РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ВнутреннееПотреблениеОб.Ссылка);
		// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699  
		
		// 3. ВозвратСырьяОтПереработчика
		Если ЗначениеЗаполнено(СтруктураДокументы.ВозвратСырьяОтПереработчика.Документ) Тогда
			ВозвратСырьяОтПереработчикаОб = СтруктураДокументы.ВозвратСырьяОтПереработчика.Документ.ПолучитьОбъект();
		Иначе
			ВозвратСырьяОтПереработчикаОб = Документы.ВозвратСырьяОтПереработчика.СоздатьДокумент();
		КонецЕсли;
		
		// Шапка      	
		ЗаполнитьЗначенияСвойств(ВозвратСырьяОтПереработчикаОб, ЭтотОбъект);
		Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл 
			ВозвратСырьяОтПереработчикаОб.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
		КонецЦикла; 
		
		ВозвратСырьяОтПереработчикаОб.тн_ЕдиныйПолучениеУслугПоПереработке = Ссылка; 
		ВозвратСырьяОтПереработчикаОб.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОтПереработчика;
		ВозвратСырьяОтПереработчикаОб.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
		
		// ТЧ Товары
		ВозвратСырьяОтПереработчикаОб.Товары.Очистить();
		Для Каждого Стр Из ЭтотОбъект.Материалы Цикл
			НоваяСтрока = ВозвратСырьяОтПереработчикаОб.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЦикла;
		
		ВозвратСырьяОтПереработчикаОб.Записать(РежимЗаписиДокумента.Проведение);
	
		// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
		РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ВозвратСырьяОтПереработчикаОб.Ссылка);
		// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
	
	КонецЕсли;
КонецПроцедуры

// Белоконенко Денис 07.02.2024 Выполнение задач №000048056
Процедура ОбработкаУдаленияПроведения(Отказ)
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка); 
	
	Для Каждого Документ Из СтруктураДокументы Цикл
		ДокументСтруктура = Документ.Значение;
		
		Если ЗначениеЗаполнено(ДокументСтруктура.Документ) И ДокументСтруктура.Проведен Тогда
			ДокОб = ДокументСтруктура.Документ.ПолучитьОбъект();
			ДокОб.Записать(РежимЗаписиДокумента.ОтменаПроведения);		
		КонецЕсли;			
	КонецЦикла;
			
КонецПроцедуры

// Белоконенко Денис 07.02.2024 Выполнение задач №000048056
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка);
	
	ТекВидОперации = ЭтотОбъект.ВидОперации;
	
	Если ЭтотОбъект.ПометкаУдаления Тогда
		// Установка пометки удаления
		
		Для Каждого Документ Из СтруктураДокументы Цикл
			ДокументСтруктура = Документ.Значение;
			
			Если ЗначениеЗаполнено(ДокументСтруктура.Документ) И Не ДокументСтруктура.ПометкаУдаления Тогда
				ДокОб = ДокументСтруктура.Документ.ПолучитьОбъект();
				ДокОб.УстановитьПометкуУдаления(Истина);		
			КонецЕсли;			
		КонецЦикла;	
		
	Иначе 
		// Снятие пометки удаления
		ДокументыПроводки = Новый Массив;
		Если ТекВидОперации = Перечисления.тн_ВидыОперацийЕдиныйПолучениеУслугПоПереработке.ПолучениеУслугПоПереработке Тогда
			ДокументыПроводки.Добавить("ПоступлениеОтПереработчика");
			ДокументыПроводки.Добавить("ОтчетПереработчика");		
		ИначеЕсли ТекВидОперации = Перечисления.тн_ВидыОперацийЕдиныйПолучениеУслугПоПереработке.ПолучениеУслугПоПереработкеБПр Тогда
			ДокументыПроводки.Добавить("ВозвратСырьяОтПереработчика");
			ДокументыПроводки.Добавить("ВнутреннееПотребление");
			ДокументыПроводки.Добавить("ПриобретениеУслугПрочихАктивов");
		КонецЕсли;
		
		Для Каждого Документ Из СтруктураДокументы Цикл				
			
			ДокументСтруктура = Документ.Значение;
			ДокументПроводки = Ложь;
			
			Если ДокументыПроводки.Найти(Документ.Ключ) <> Неопределено Тогда
				ДокументПроводки = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументСтруктура.Документ) Тогда 
				Если ДокументПроводки И ДокументСтруктура.ПометкаУдаления Тогда
					ДокОб = ДокументСтруктура.Документ.ПолучитьОбъект();
					ДокОб.УстановитьПометкуУдаления(Ложь);
				ИначеЕсли Не ДокументПроводки И Не ДокументСтруктура.ПометкаУдаления Тогда
					ДокОб = ДокументСтруктура.Документ.ПолучитьОбъект();
					ДокОб.УстановитьПометкуУдаления(Истина);						
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;							
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Белоконенко Денис 07.02.2024 Выполнение задач №000048056
Функция НайтиСвязанныеДокументы(ЕдиныйПолучениеУслугПоПереработке)
	
	СтруктураДокументы = Новый Структура;
	СтруктураДокументы.Вставить("ВозвратСырьяОтПереработчика", 		Новый Структура("Документ, ПометкаУдаления, Проведен", Документы.ВозвратСырьяОтПереработчика.ПустаяСсылка(), Ложь, Ложь));
	СтруктураДокументы.Вставить("ПоступлениеОтПереработчика", 		Новый Структура("Документ, ПометкаУдаления, Проведен", Документы.ПоступлениеОтПереработчика.ПустаяСсылка(), Ложь, Ложь));
	СтруктураДокументы.Вставить("ОтчетПереработчика", 				Новый Структура("Документ, ПометкаУдаления, Проведен", Документы.ОтчетПереработчика.ПустаяСсылка(), Ложь, Ложь));
	СтруктураДокументы.Вставить("ВнутреннееПотребление", 			Новый Структура("Документ, ПометкаУдаления, Проведен", Документы.ВнутреннееПотребление.ПустаяСсылка(), Ложь, Ложь));
	СтруктураДокументы.Вставить("ПриобретениеУслугПрочихАктивов", 	Новый Структура("Документ, ПометкаУдаления, Проведен", Документы.ПриобретениеУслугПрочихАктивов.ПустаяСсылка(), Ложь, Ложь));	
	
	Запрос 			= Новый Запрос;
	ТекстыЗапросов 	= Новый Массив;
	
	Для Каждого ДокументСтруктура Из СтруктураДокументы Цикл
				
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИмяДокумента.Ссылка КАК Ссылка,
			|	""ИмяДокумента"" КАК ДокументТаблица,
			|	ИмяДокумента.ПометкаУдаления КАК ПометкаУдаления,
			|	ИмяДокумента.Проведен КАК Проведен
			|ИЗ
			|	Документ.ИмяДокумента КАК ИмяДокумента
			|ГДЕ
			|	ИмяДокумента.тн_ЕдиныйПолучениеУслугПоПереработке = &ЕдиныйПолучениеУслугПоПереработке";
		
		Если ТекстыЗапросов.Количество() > 0 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ"); 
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяДокумента", ДокументСтруктура.Ключ);
		
		ТекстыЗапросов.Добавить(ТекстЗапроса);		
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
		
	Запрос.УстановитьПараметр("ЕдиныйПолучениеУслугПоПереработке", ЕдиныйПолучениеУслугПоПереработке);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДокументов = РезультатЗапроса.Выбрать();
			
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДокументов.Ссылка) Тогда
			СтруктураДокументы[ВыборкаДокументов.ДокументТаблица].Документ 			= ВыборкаДокументов.Ссылка;
			СтруктураДокументы[ВыборкаДокументов.ДокументТаблица].ПометкаУдаления 	= ВыборкаДокументов.ПометкаУдаления;
			СтруктураДокументы[ВыборкаДокументов.ДокументТаблица].Проведен 			= ВыборкаДокументов.Проведен;
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат СтруктураДокументы;
КонецФункции

#КонецЕсли