	ПерсонифицированныйУчет.СоздатьПоМассивуСсылокВТИсторияРегистрацийВОрганеПФРСрезПоследних(Запрос.МенеджерВременныхТаблиц, МассивСсылок, "ПачкаДокументовСЗВ_К");
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СведенияОбОрганизациях.РегистрационныйНомерПФР КАК РегистрационныйНомерПФР,
	|	СведенияОбОрганизациях.КодПоОКПО КАК КодПоОКПО,
	|	СведенияОбОрганизациях.ИНН КАК ИНН,
	|	СведенияОбОрганизациях.КПП КАК КПП,
	|	СведенияОбОрганизациях.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	СведенияОбОрганизациях.НаименованиеСокращенное КАК НаименованиеСокращенное,
	|	ДанныеОПачке.НомерПачки КАК НомерПачки,
	|	ДанныеОПачке.ДокументовВПачке КАК ДокументовВПачке,
	|	ЕСТЬNULL(ФИОРуководителейПоследние.РасшифровкаПодписи, """") КАК Руководитель,
	|	ДанныеОПачке.Должность КАК Должность,
	|	ДанныеОПачке.Дата КАК Дата,
	|	ДанныеОПачке.Ссылка КАК Документ
	|ИЗ
	|	ВТДанныеДокументов КАК ДанныеОПачке
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСведенияОбОрганизациях КАК СведенияОбОрганизациях
	|		ПО ДанныеОПачке.Организация = СведенияОбОрганизациях.ОрганизацияДокумента
	|			И ДанныеОПачке.ОкончаниеОтчетногоПериода = СведенияОбОрганизациях.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТФИООтветственныхЛиц КАК ФИОРуководителейПоследние
	|		ПО ДанныеОПачке.Ссылка = ФИОРуководителейПоследние.Ссылка
	|			И ДанныеОПачке.Руководитель = ФИОРуководителейПоследние.ФизическоеЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеОПачке.Ссылка";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Для обеспечения формирования выходного файла

// Формирует файл, который можно будет записать на дискетку
//
// Параметры: 
//  ВыборкаПоШапкеДокумента
//  ВыборкаПоЗаписямСтажа
//
// Возвращаемое значение:
//  Строка - содержимое файла
//
Функция СформироватьВыходнойФайл(ВыборкаПоШапкеДокумента, ВыборкаПоЗаписямСтажа)
	
	ВыборкаПоШапкеДокумента.Следующий();
	
	Если ВыборкаПоШапкеДокумента.Дата >= ПерсонифицированныйУчет.ДатаПостановленияАДВ2025() Тогда
		Возврат СформироватьВыходнойФайл2025(ВыборкаПоШапкеДокумента, ВыборкаПоЗаписямСтажа);
	КонецЕсли;
	
	// Загружаем формат файла сведений
	ДеревоФорматаXML = ПолучитьОбщийМакет("ФорматПФР70XML");
	ТекстФорматаXML = ДеревоФорматаXML.ПолучитьТекст();
	
	ДеревоФормата = ЗарплатаКадры.ЗагрузитьXMLВДокументDOM(ТекстФорматаXML);
	
	НомерДокументаВПачке = 1;
	// Создаем начальное дерево
	ДеревоВыгрузки = ЗарплатаКадры.СоздатьДеревоXML();
	
	УзелПФР = ПерсонифицированныйУчет.УзелФайлаПФР(ДеревоВыгрузки);
	
	ПерсонифицированныйУчет.ЗаполнитьИмяИЗаголовокФайла(УзелПФР, ДеревоФормата, ВыборкаПоШапкеДокумента.ИмяФайлаДляПФР);
	
	КоличествоДокументов = ВыборкаПоШапкеДокумента.КоличествоДокументов;
	
	// Добавляем реквизит ПачкаВходящихДокументов
	УзелПачкаВходящихДокументов = ПерсонифицированныйУчет.ЗаполнитьНаборЗаписейВходящаяОпись(УзелПФР, ДеревоФормата, "КОНВЕРТАЦИЯ", ВыборкаПоШапкеДокумента, КоличествоДокументов, НомерДокументаВПачке);
	
	ФорматИССЗВК = ЗарплатаКадры.ЗагрузитьФорматНабораЗаписей(ДеревоФормата, "КОНВЕРТАЦИЯ");
	
	ФорматИССЗВК.СтажДоРегистрации.Значение.Удалить("ПериодДеятельности");
	
	ФорматПериодДеятельности = ЗарплатаКадры.ЗагрузитьФорматНабораЗаписей(ДеревоФормата, "ПериодДеятельности");
	ФорматПериодРаботыСЗВК = ЗарплатаКадры.ЗагрузитьФорматНабораЗаписей(ДеревоФормата, "ПериодРаботыСЗВК");
	ФорматОсобенностиУчетаСЗВК = ЗарплатаКадры.ЗагрузитьФорматНабораЗаписей(ДеревоФормата, "ОсобенностиУчетаСЗВК");
	
	Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерСтрокиСотрудник") Цикл
		
		НомерДокументаВПачке = НомерДокументаВПачке + 1;
		
		НаборЗаписейСЗВК = ОбщегоНазначения.СкопироватьРекурсивно(ФорматИССЗВК);
		УзелКонвертация = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелПачкаВходящихДокументов, "КОНВЕРТАЦИЯ", "");
		
		НаборЗаписейСЗВК.НомерВПачке.Значение = НомерДокументаВПачке;
		НаборЗаписейСЗВК.ВидФормы.Значение = "СЗВ-К";
		Если ВыборкаПоШапкеДокумента.ТипСведений = "ИСХД" Тогда
			НаборЗаписейСЗВК.ТипСведений.Значение = "ИСХОДНАЯ";
		ИначеЕсли ВыборкаПоШапкеДокумента.ТипСведений = "ОТМН" Тогда
			НаборЗаписейСЗВК.ТипСведений.Значение = "ОТМЕНЯЮЩАЯ";
		Иначе
			НаборЗаписейСЗВК.ТипСведений.Значение = "КОРРЕКТИРУЮЩАЯ";
		КонецЕсли;
		НаборЗаписейСЗВК.СтраховойНомер.Значение = ВыборкаПоЗаписямСтажа.СтраховойНомерПФР;
		
		Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияНа_31_12_2001Код) Тогда
			НаборЗаписейСЗВК.ТерриториальныеУсловияНа31_12_2001.Значение.ОснованиеТУ = СокрЛП(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияНа_31_12_2001Код);
			НаборЗаписейСЗВК.ТерриториальныеУсловияНа31_12_2001.Значение.Коэффициент = ВыборкаПоЗаписямСтажа.РайонныйКоэффициентНа_31_12_2001;
		Иначе
			НаборЗаписейСЗВК.Удалить("ТерриториальныеУсловияНа31_12_2001");
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияВКрыму Тогда
			НаборЗаписейСЗВК.ФактПроживанияКрым.Значение = "1";
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияДНРЛНРЗОХО Тогда
			НаборЗаписейСЗВК.ФактПроживанияДНРЛНРЗОХО.Значение = "1";
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияДНРЛНР Тогда
			НаборЗаписейСЗВК.ФактПроживанияДНРЛНР.Значение = "1";
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияЗОХО Тогда
			НаборЗаписейСЗВК.ФактПроживанияЗОХО.Значение = "1";
		КонецЕсли;
		
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейСЗВК.ФактПроживанияКрым, "Значение");
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейСЗВК.ФактПроживанияДНРЛНРЗОХО, "Значение");
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейСЗВК.ФактПроживанияДНРЛНР, "Значение");
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейСЗВК.ФактПроживанияЗОХО, "Значение");
		
		НаборЗаписейСЗВК.ДатаЗаполнения.Значение = ВыборкаПоШапкеДокумента.Дата;
		
		НаборЗаписейФИО = НаборЗаписейСЗВК.ФИО.Значение;
		НаборЗаписейФИО.Фамилия = ВРег(ВыборкаПоЗаписямСтажа.Фамилия);
		ПерсонифицированныйУчет.ЗаменитьБуквуЁ(НаборЗаписейФИО.Фамилия, "Фамилия");
		НаборЗаписейФИО.Имя = ВРег(ВыборкаПоЗаписямСтажа.Имя);
		ПерсонифицированныйУчет.ЗаменитьБуквуЁ(НаборЗаписейФИО.Имя, "Имя");
		НаборЗаписейФИО.Отчество = ВРег(ВыборкаПоЗаписямСтажа.Отчество);
		ПерсонифицированныйУчет.ЗаменитьБуквуЁ(НаборЗаписейФИО.Отчество, "Отчество");
		
		ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейСЗВК.ФИО, "Фамилия");
		ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейСЗВК.ФИО, "Имя");
		ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейСЗВК.ФИО, "Отчество");
		
		НаборЗаписейСЗВК.ДатаРождения.Значение = ВыборкаПоЗаписямСтажа.ДатаРождения;
		
		// Организация, представившая СЗВ-К
		НаборЗаписейСЗВК.Удалить("ОрганизацияПредставившаяСЗВ_К");
		НаборЗаписейСЗВК.Удалить("ВсеОсобыеЗаслуги");
		НаборЗаписейСЗВК.Удалить("ФИООценщика");
		НаборЗаписейСЗВК.Удалить("ТабельныйНомерОценщика");
		ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелКонвертация, НаборЗаписейСЗВК);
		
		НаборСтажДоРегистрации = УзелКонвертация.Строки.Найти("СтажДоРегистрации");
		КоличествоПериодовДеятельности = 0;
		Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерПериодаТрудовойДеятельности") Цикл
			
			УзелПериодыДеятельности = ЗарплатаКадры.ДобавитьУзелВДеревоXML(НаборСтажДоРегистрации, "ПериодДеятельности", "");
			
			НаборЗаписейПериодДеятельности = ОбщегоНазначения.СкопироватьРекурсивно(ФорматПериодДеятельности);
			НаборЗаписейПериодДеятельности.Удалить("ЗаработокЗаПериод");
			НаборЗаписейПериодДеятельности.ВсеПериодыРаботы.Значение.Удалить("ПериодРаботы");
			НаборЗаписейПериодДеятельности.ВидДеятельности.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ВидДеятельностиКод);
			НаборЗаписейПериодДеятельности.НаименованиеОрганизации.Значение = ВРег(ВыборкаПоЗаписямСтажа.ОрганизацияНаименование);
			
			ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелПериодыДеятельности, НаборЗаписейПериодДеятельности);
			
			НаборЗаписейВсеПериодыРаботы = УзелПериодыДеятельности.Строки[2].Строки;
			КоличествоПериодовРаботы = 0;
			
			Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерОсновнойЗаписи") Цикл
				
				УзелПериодРаботы = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелПериодыДеятельности.Строки[2], "ПериодРаботы", "");
				
				НаборЗаписейПериодРаботыСЗВК = ОбщегоНазначения.СкопироватьРекурсивно(ФорматПериодРаботыСЗВК);
				
				НаборЗаписейПериодРаботыСЗВК.ДополнительныеСтроки.Значение.Удалить("ОсобенностиУчета");
				
				ОсновнаяСтрокаСЗВК = НаборЗаписейПериодРаботыСЗВК.ОсновнаяСтрока.Значение;
				ОсновнаяСтрокаСЗВК.НомерСтроки.Значение = ВыборкаПоЗаписямСтажа.НомерОсновнойЗаписи;
				ОсновнаяСтрокаСЗВК.ДатаНачалаПериода.Значение = ВыборкаПоЗаписямСтажа.ДатаНачалаПериода;
				ОсновнаяСтрокаСЗВК.ДатаКонцаПериода.Значение = ВыборкаПоЗаписямСтажа.ДатаОкончанияПериода;
				
				ОсобенностиУчетаСЗВК = ОсновнаяСтрокаСЗВК.ОсобенностиУчета.Значение;
				Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияКод) Тогда
					ОсобенностиУчетаСЗВК.ТерриториальныеУсловия.Значение.ОснованиеТУ = СокрЛП(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияКод);
					ОсобенностиУчетаСЗВК.ТерриториальныеУсловия.Значение.Коэффициент = ВыборкаПоЗаписямСтажа.РайонныйКоэффициент;
				Иначе
					ОсобенностиУчетаСЗВК.Удалить("ТерриториальныеУсловия");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОсобыеУсловияТрудаКод) Тогда
					ОсобенностиУчетаСЗВК.ОсобыеУсловияТруда.Значение.ОснованиеОУТ = СокрЛП(ВыборкаПоЗаписямСтажа.ОсобыеУсловияТрудаКод);
					ОсобенностиУчетаСЗВК.ОсобыеУсловияТруда.Значение.ПозицияСписка = СокрЛП(ВРег(ВыборкаПоЗаписямСтажа.КодПозицииСпискаКод));
				Иначе
					ОсобенностиУчетаСЗВК.Удалить("ОсобыеУсловияТруда");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОснованиеИсчисляемогоСтажаКод) Тогда
					ИсчисляемыйСтажСЗВК = ОсобенностиУчетаСЗВК.ИсчисляемыйСтаж.Значение;
					ИсчисляемыйСтажСЗВК.ОснованиеИС.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ОснованиеИсчисляемогоСтажаКод);
					
					ИсчисляемыйСтажВыработкаКалендарнаяСЗВК = ИсчисляемыйСтажСЗВК.ВыработкаКалендарная.Значение;
					ИсчисляемыйСтажВыработкаКалендарнаяСЗВК.ВсеГоды = ВыборкаПоЗаписямСтажа.НулевойПараметрИсчисляемогоСтажа;
					ИсчисляемыйСтажВыработкаКалендарнаяСЗВК.ВсеМесяцы = ВыборкаПоЗаписямСтажа.ПервыйПараметрИсчисляемогоСтажа;
					ИсчисляемыйСтажВыработкаКалендарнаяСЗВК.ВсеДни = ВыборкаПоЗаписямСтажа.ВторойПараметрИсчисляемогоСтажа;
				Иначе
					ОсобенностиУчетаСЗВК.Удалить("ИсчисляемыйСтаж");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТретийПараметрИсчисляемогоСтажа) Тогда
					ОсобенностиУчетаСЗВК.ДекретДети.Значение = ВыборкаПоЗаписямСтажа.ТретийПараметрИсчисляемогоСтажа;
				Иначе
					ОсобенностиУчетаСЗВК.Удалить("ДекретДети");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОснованиеВыслугиЛетКод) Тогда
					ВыслугаЛетСЗВК = ОсобенностиУчетаСЗВК.ВыслугаЛет.Значение;
					ВыслугаЛетСЗВК.ОснованиеВЛ.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ОснованиеВыслугиЛетКод);
					ВыслугаЛетСЗВК.ВыработкаВЧасах.Значение.Часы = ВыборкаПоЗаписямСтажа.ПервыйПараметрВыслугиЛет;
					ВыслугаЛетСЗВК.ВыработкаВЧасах.Значение.Минуты = ВыборкаПоЗаписямСтажа.ВторойПараметрВыслугиЛет;
					ВыслугаЛетСЗВК.ДоляСтавки.Значение = ВыборкаПоЗаписямСтажа.ТретийПараметрВыслугиЛет;
				Иначе
					ОсобенностиУчетаСЗВК.Удалить("ВыслугаЛет");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.Должность) Тогда
					ОсобенностиУчетаСЗВК.ПрофессияДолжность.Значение = ВРег(ВыборкаПоЗаписямСтажа.Должность);
				Иначе
					ОсобенностиУчетаСЗВК.Удалить("ПрофессияДолжность");
				КонецЕсли;
				
				ВыводитьОсобенностиУчета = ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияКод)
					Или ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОсобыеУсловияТрудаКод)
					Или ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОснованиеИсчисляемогоСтажаКод)
				    Или ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТретийПараметрИсчисляемогоСтажа)
					Или ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОснованиеВыслугиЛетКод)
					Или ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.Должность);
					
				ОсновнаяСтрокаСЗВК.ОсобенностиУчета.НеВыводитьВФайл = Не ВыводитьОсобенностиУчета;
				
				ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелПериодРаботы, НаборЗаписейПериодРаботыСЗВК);
				
				КоличествоДополнительныхСтрок = 0;
				Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерДополнительнойЗаписи") Цикл
					
					// В дополнительной записи с номером 0 находится информация об основной записи
					Если ВыборкаПоЗаписямСтажа.НомерДополнительнойЗаписи <> 0 Тогда
						
						КоличествоДополнительныхСтрок = КоличествоДополнительныхСтрок + 1;
						
						УзелОсобенностиУчета = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелПериодРаботы.Строки[1], "ОсобенностиУчета", "");
						
						НаборЗаписейОсобенностиУчетаСЗВК = ОбщегоНазначения.СкопироватьРекурсивно(ФорматОсобенностиУчетаСЗВК);
						НаборЗаписейОсобенностиУчетаСЗВК.ТерриториальныеУсловия.Значение.ОснованиеТУ = СокрЛП(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияКод);
						НаборЗаписейОсобенностиУчетаСЗВК.ТерриториальныеУсловия.Значение.Коэффициент = ВыборкаПоЗаписямСтажа.РайонныйКоэффициент;
						
						НаборЗаписейОсобенностиУчетаСЗВК.ОсобыеУсловияТруда.Значение.ОснованиеОУТ = СокрЛП(ВыборкаПоЗаписямСтажа.ОсобыеУсловияТрудаКод);
						НаборЗаписейОсобенностиУчетаСЗВК.ОсобыеУсловияТруда.Значение.ПозицияСписка = СокрЛП(ВРег(ВыборкаПоЗаписямСтажа.КодПозицииСпискаКод));
						
						ОсобенностиУчетаИсчисляемыйСтажСЗВК = НаборЗаписейОсобенностиУчетаСЗВК.ИсчисляемыйСтаж.Значение;
						ОсобенностиУчетаИсчисляемыйСтажСЗВК.ОснованиеИС.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ОснованиеИсчисляемогоСтажаКод);
						
						ИсчисляемыйСтажВыработкаКалендарнаяСЗВК = ОсобенностиУчетаИсчисляемыйСтажСЗВК.ВыработкаКалендарная.Значение;
						ИсчисляемыйСтажВыработкаКалендарнаяСЗВК.ВсеГоды = ВыборкаПоЗаписямСтажа.НулевойПараметрИсчисляемогоСтажа;
						ИсчисляемыйСтажВыработкаКалендарнаяСЗВК.ВсеМесяцы = ВыборкаПоЗаписямСтажа.ПервыйПараметрИсчисляемогоСтажа;
						ИсчисляемыйСтажВыработкаКалендарнаяСЗВК.ВсеДни = ВыборкаПоЗаписямСтажа.ВторойПараметрИсчисляемогоСтажа;
						
						НаборЗаписейОсобенностиУчетаСЗВК.ДекретДети.Значение = ВРег(ВыборкаПоЗаписямСтажа.ТретийПараметрИсчисляемогоСтажа);
						
						ВыслугаЛетСЗВК = НаборЗаписейОсобенностиУчетаСЗВК.ВыслугаЛет.Значение;
						ВыслугаЛетСЗВК.ОснованиеВЛ.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ОснованиеВыслугиЛетКод);
						ВыслугаЛетСЗВК.ВыработкаВЧасах.Значение.Часы = ВыборкаПоЗаписямСтажа.ПервыйПараметрВыслугиЛет;
						ВыслугаЛетСЗВК.ВыработкаВЧасах.Значение.Минуты = ВыборкаПоЗаписямСтажа.ВторойПараметрВыслугиЛет;
						ВыслугаЛетСЗВК.ДоляСтавки.Значение = ВыборкаПоЗаписямСтажа.ТретийПараметрВыслугиЛет;
						
						НаборЗаписейОсобенностиУчетаСЗВК.ПрофессияДолжность.Значение = ВРег(ВыборкаПоЗаписямСтажа.Должность);
						
						ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелОсобенностиУчета, НаборЗаписейОсобенностиУчетаСЗВК);
					КонецЕсли;
				
				КонецЦикла;
				УзелДополнительныеСтроки = УзелПериодРаботы.Строки.Найти("ДополнительныеСтроки");
				Если УзелДополнительныеСтроки.Имя = "ДополнительныеСтроки" Тогда
					Если КоличествоДополнительныхСтрок = 0 Тогда
						УзелПериодРаботы.Строки.Удалить(УзелДополнительныеСтроки);
					Иначе
						УзелКоличество = УзелДополнительныеСтроки.Строки.Найти("Количество");
						Если УзелКоличество.Имя = "Количество" Тогда
							УзелКоличество.Значение = Формат(КоличествоДополнительныхСтрок, "ЧН=0; ЧГ=0");
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
				КоличествоПериодовРаботы = КоличествоПериодовРаботы + 1
			КонецЦикла;
			
			НаборЗаписейВсеПериодыРаботы[1].Значение = Формат(КоличествоПериодовРаботы, "ЧН=0; ЧГ=0");
			
			КоличествоПериодовДеятельности = КоличествоПериодовДеятельности + 1;			
		КонецЦикла;
		НаборСтажДоРегистрации.Строки[1].Значение = Формат(КоличествоПериодовДеятельности, "ЧН=0; ЧГ=0");
		
	КонецЦикла;
	
	// Преобразуем дерево в строковое описание XML
	ТекстФайла = ПерсонифицированныйУчет.ПолучитьТекстФайлаИзДереваЗначений(ДеревоВыгрузки);
	Возврат СтрЗаменить(ТекстФайла, "ТерриториальныеУсловияНа31_12_2001", "ТерриториальныеУсловияНа31.12.2001");
	
КонецФункции

Функция СформироватьВыходнойФайл2025(ВыборкаПоШапкеДокумента, ВыборкаПоЗаписямСтажа)
	
	// Загружаем формат файла сведений
	ДеревоФорматаXML = ПолучитьОбщийМакет("ФорматСЗВК_2025XML");
	ТекстФорматаXML = ДеревоФорматаXML.ПолучитьТекст();
	
	ДеревоФормата = ЗарплатаКадры.ЗагрузитьXMLВДокументDOM(ТекстФорматаXML);
	
	ФорматСЗВ_К = ЗарплатаКадры.ЗагрузитьФорматНабораЗаписей(ДеревоФормата, "СЗВ_К");
	
	ФорматЗЛ = ОбщегоНазначения.СкопироватьРекурсивно(ФорматСЗВ_К.ЗЛ.Значение);
	ФорматСЗВ_К.Удалить("ЗЛ");
	
	НаборЗаписейДатаСоставления = Новый Структура("ДатаСоставления", ОбщегоНазначения.СкопироватьРекурсивно(ФорматСЗВ_К.ДатаСоставления));
	ФорматСЗВ_К.Удалить("ДатаСоставления");
	
	НаборЗаписейРуководитель = Новый Структура("Руководитель", ОбщегоНазначения.СкопироватьРекурсивно(ФорматСЗВ_К.Руководитель));
	ФорматСЗВ_К.Удалить("Руководитель");
	
	ФорматПериодДеятельности = ОбщегоНазначения.СкопироватьРекурсивно(ФорматЗЛ.ПериодДеятельности.Значение);
	ФорматЗЛ.Удалить("ПериодДеятельности");
	
	ФорматПериодыРаботы = ОбщегоНазначения.СкопироватьРекурсивно(ФорматПериодДеятельности.ПериодыРаботы.Значение);
	ФорматПериодДеятельности.Удалить("ПериодыРаботы");
	
	ВыборкаПоШапкеДокумента.Следующий();
	
	// Создаем начальное дерево
	ДеревоВыгрузки = ЗарплатаКадры.СоздатьДеревоXML();
	
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("xmlns", "http://пф.рф/СЗВ-К/2026-01-01");
	Атрибуты.Вставить("xmlns:АФ8", "http://пф.рф/АФ/2025-01-01");
	Атрибуты.Вставить("xmlns:УТ8", "http://пф.рф/УТ/2025-01-01");
	Атрибуты.Вставить("xmlns:СЗВК9", "http://пф.рф/ВС/СЗВК/типы/2026-01-01");
	Атрибуты.Вставить("xmlns:ВС9", "http://пф.рф/ВС/типы/2026-01-01");
	
	УзелСФР = ЗарплатаКадры.ДобавитьУзелВДеревоXML(ДеревоВыгрузки, "ЭДСФР", "", Атрибуты);
	
	Если ВыборкаПоШапкеДокумента.ТипСведений = "ИСХД" Тогда
		ФорматСЗВ_К.ТипСведений.Значение = "ИСХОДНАЯ";
	ИначеЕсли ВыборкаПоШапкеДокумента.ТипСведений = "ОТМН" Тогда
		ФорматСЗВ_К.ТипСведений.Значение = "ОТМЕНЯЮЩАЯ";
	Иначе
		ФорматСЗВ_К.ТипСведений.Значение = "КОРРЕКТИРУЮЩАЯ";
	КонецЕсли;
	
	НаборЗаписейСтрахователь = ФорматСЗВ_К.Страхователь.Значение;
	НаименованиеОрганизации = СокрЛП(ВРег(ВыборкаПоШапкеДокумента.НаименованиеСокращенное));
	ПерсонифицированныйУчет.УдалитьПробелыРядомСДефисом(НаименованиеОрганизации);
	НаборЗаписейСтрахователь.УТ8__Наименование = НаименованиеОрганизации;
	НаборЗаписейСтрахователь.УТ8__РегНомер = ВыборкаПоШапкеДокумента.РегистрационныйНомерПФР;
	Если ЗарплатаКадры.ИспользованиеРегистрационногоНомераСФР(ВыборкаПоШапкеДокумента.Дата, ВыборкаПоШапкеДокумента.Организация) 
		И ЗначениеЗаполнено(ВыборкаПоШапкеДокумента.РегистрационныйНомерСФР) Тогда
		НаборЗаписейСтрахователь.УТ8__РегНомер = ВыборкаПоШапкеДокумента.РегистрационныйНомерСФР;
	КонецЕсли;
	НаборЗаписейСтрахователь.УТ8__ИНН = ВыборкаПоШапкеДокумента.ИНН;
	Если ЗначениеЗаполнено(ВыборкаПоШапкеДокумента.КПП) Тогда
		НаборЗаписейСтрахователь.УТ8__КПП = ВыборкаПоШапкеДокумента.КПП;
	Иначе
		НаборЗаписейСтрахователь.Удалить("УТ8__КПП");
		СтрокаПоляКПП = ФорматСЗВ_К.Страхователь.Поля.Найти("УТ8__КПП", "ИмяПоля");
		Если СтрокаПоляКПП <> Неопределено Тогда
			ФорматСЗВ_К.Страхователь.Поля.Удалить(СтрокаПоляКПП);
		КонецЕсли;		
	КонецЕсли;
	
	УзелСЗВК = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелСФР, "СЗВ-К", "");
	ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелСЗВК, ФорматСЗВ_К);
	
	НаборЗаписейЗЛ = ОбщегоНазначения.СкопироватьРекурсивно(ФорматЗЛ); 
	
	Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерСтрокиСотрудник") Цикл
		
		// Данные по физлицу
		НаборЗаписейЗЛ.УТ8__СНИЛС.Значение = ВыборкаПоЗаписямСтажа.СтраховойНомерПФР;
		НаборЗаписейЗЛ.УТ8__ДатаРождения.Значение = Формат(ВыборкаПоЗаписямСтажа.ДатаРождения, "ДФ=yyyy-MM-dd");
		
		НаборЗаписейФИО = НаборЗаписейЗЛ.УТ8__ФИО.Значение;
		НаборЗаписейФИО.УТ8__Фамилия = СокрЛП(ВыборкаПоЗаписямСтажа.Фамилия);
		НаборЗаписейФИО.УТ8__Имя = СокрЛП(ВыборкаПоЗаписямСтажа.Имя);
		НаборЗаписейФИО.УТ8__Отчество = СокрЛП(ВыборкаПоЗаписямСтажа.Отчество);
		
		Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияНа_31_12_2001Код) Тогда
			НаборЗаписейЗЛ.ТерриториальныеУсловияНа31_12_2001.Значение.СЗВК9__Основание = СокрЛП(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияНа_31_12_2001Код);
			НаборЗаписейЗЛ.ТерриториальныеУсловияНа31_12_2001.Значение.СЗВК9__Коэффициент = ВыборкаПоЗаписямСтажа.РайонныйКоэффициентНа_31_12_2001;
		Иначе
			НаборЗаписейЗЛ.Удалить("ТерриториальныеУсловияНа31_12_2001");
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияВКрыму Тогда
			НаборЗаписейЗЛ.ФактПроживанияКрым.Значение = "1";
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияДНРЛНРЗОХО Тогда
			НаборЗаписейЗЛ.ФактПроживанияДНРЛНРЗОХО.Значение = "1";
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияДНРЛНР Тогда
			НаборЗаписейЗЛ.ФактПроживанияДНРЛНР.Значение = "1";
		КонецЕсли;
		
		Если ВыборкаПоЗаписямСтажа.ФактПроживанияЗОХО Тогда
			НаборЗаписейЗЛ.ФактПроживанияЗОХО.Значение = "1";
		КонецЕсли;
		
		ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейЗЛ.УТ8__ФИО, "УТ8__Фамилия");
		ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейЗЛ.УТ8__ФИО, "УТ8__Имя");
		ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейЗЛ.УТ8__ФИО, "УТ8__Отчество");
		
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейЗЛ.ФактПроживанияКрым, "Значение");
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейЗЛ.ФактПроживанияДНРЛНРЗОХО, "Значение");
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейЗЛ.ФактПроживанияДНРЛНР, "Значение");
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейЗЛ.ФактПроживанияЗОХО, "Значение");
		
		УзелСотрудника = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелСЗВК, "ЗЛ", "");
		ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелСотрудника, НаборЗаписейЗЛ);
		
		Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерПериодаТрудовойДеятельности") Цикл
			
			УзелПериодыДеятельности = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелСотрудника, "ПериодДеятельности", "");
			
			НаборЗаписейПериодДеятельности = ОбщегоНазначения.СкопироватьРекурсивно(ФорматПериодДеятельности);
			НаборЗаписейПериодДеятельности.ВидДеятельности.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ВидДеятельностиКод);
			НаборЗаписейПериодДеятельности.Организация.Значение = ВыборкаПоЗаписямСтажа.ОрганизацияНаименование;
			
			ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелПериодыДеятельности, НаборЗаписейПериодДеятельности);
			
			Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерОсновнойЗаписи") Цикл
				
				НаборЗаписейПериодыРаботы = ОбщегоНазначения.СкопироватьРекурсивно(ФорматПериодыРаботы);
				НаборЗаписейПериодыРаботы.ЛьготныйСтаж.НеВыводитьВФайл = Истина;
				
				НаборЗаписейПериодыРаботы.Период.Значение.УТ8__С = Формат(ВыборкаПоЗаписямСтажа.ДатаНачалаПериода, "ДФ=yyyy-MM-dd");
				НаборЗаписейПериодыРаботы.Период.Значение.УТ8__По = Формат(ВыборкаПоЗаписямСтажа.ДатаОкончанияПериода, "ДФ=yyyy-MM-dd");
				
				УзелПериодыРаботы = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелПериодыДеятельности, "ПериодыРаботы", "");
				ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелПериодыРаботы, НаборЗаписейПериодыРаботы);
				
				ФорматЛьготныйСтаж = ОбщегоНазначения.СкопироватьРекурсивно(НаборЗаписейПериодыРаботы.ЛьготныйСтаж.Значение);
				ВывестиЛьготныйСтажСЗВК2025(ВыборкаПоЗаписямСтажа, УзелПериодыРаботы, ФорматЛьготныйСтаж);
				
				Пока ВыборкаПоЗаписямСтажа.СледующийПоЗначениюПоля("НомерДополнительнойЗаписи") Цикл
					// В дополнительной записи с номером 0 находится информация об основной записи
					Если ВыборкаПоЗаписямСтажа.НомерДополнительнойЗаписи = 0 Тогда
						Продолжить;
					КонецЕсли;
					ФорматЛьготныйСтаж = ОбщегоНазначения.СкопироватьРекурсивно(НаборЗаписейПериодыРаботы.ЛьготныйСтаж.Значение);
					ВывестиЛьготныйСтажСЗВК2025(ВыборкаПоЗаписямСтажа, УзелПериодыРаботы, ФорматЛьготныйСтаж);
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	НаборЗаписейДатаСоставления.ДатаСоставления.Значение = Формат(ВыборкаПоШапкеДокумента.Дата, "ДФ=yyyy-MM-dd");
	ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелСЗВК, НаборЗаписейДатаСоставления);
	
	НаборЗаписейРуководитель.Руководитель.Значение.УТ8__Должность.Значение = СокрЛП(ВыборкаПоШапкеДокумента.ДолжностьРуководителя);
	НаборЗаписейФИО = НаборЗаписейРуководитель.Руководитель.Значение.УТ8__ФИО.Значение;
	НаборЗаписейФИО.УТ8__Фамилия = СокрЛП(ВыборкаПоШапкеДокумента.ФамилияРуководителя);
	НаборЗаписейФИО.УТ8__Имя = СокрЛП(ВыборкаПоШапкеДокумента.ИмяРуководителя);
	НаборЗаписейФИО.УТ8__Отчество = СокрЛП(ВыборкаПоШапкеДокумента.ОтчествоРуководителя);
	ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейРуководитель.Руководитель.Значение.УТ8__ФИО, "УТ2__Фамилия");
	ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейРуководитель.Руководитель.Значение.УТ8__ФИО, "УТ2__Имя");
	ПерсонифицированныйУчет.УстановитьВыводВФайлСвойстваЗначенияЭлемента(НаборЗаписейРуководитель.Руководитель.Значение.УТ8__ФИО, "УТ2__Отчество");
	ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелСЗВК, НаборЗаписейРуководитель);
	
	// Служебная информация о файле
	НаборЗаписейСлужебнаяИнформация = ЗарплатаКадры.ЗагрузитьФорматНабораЗаписей(ДеревоФормата, "СлужебнаяИнформация");
	Если ЗначениеЗаполнено(ВыборкаПоШапкеДокумента.ИмяФайлаДляПФР) Тогда
		ЧастиИмениФайла = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(ВыборкаПоШапкеДокумента.ИмяФайлаДляПФР),"_");
		НаборЗаписейСлужебнаяИнформация.АФ8__GUID.Значение = ЧастиИмениФайла[ЧастиИмениФайла.ВГраница()];
	КонецЕсли;
	НаборЗаписейСлужебнаяИнформация.АФ8__ДатаВремя.Значение = ПерсонифицированныйУчет.ПредставлениеДатыВФорматеdateTimeСЧасовымПоясом(ВыборкаПоШапкеДокумента.Дата);
	НаборЗаписейСлужебнаяИнформация.АФ8__ПрограммаПодготовки.Значение = ВРег(РегламентированнаяОтчетность.НазваниеИВерсияПрограммы());
	ЗарплатаКадры.ДобавитьИнформациюВДерево(ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелСФР, "СлужебнаяИнформация",""), НаборЗаписейСлужебнаяИнформация);
	
	// Преобразуем дерево в строковое описание XML
	ПотокВыгрузкиXML = ЗарплатаКадры.СоздатьПотокXML(, "UTF-8");
	ЗарплатаКадры.ЗаписатьУзелДереваXMLВXML(ДеревоВыгрузки, ПотокВыгрузкиXML, "xsi", "http://www.w3.org/2001/XMLSchema", Ложь);
	ТекстФайла = ЗарплатаКадры.ЗаписатьПотокXML(ПотокВыгрузкиXML);
	
	ТекстФайла = СтрЗаменить(ТекстФайла, "__", ":");
	Возврат СтрЗаменить(ТекстФайла, "ТерриториальныеУсловияНа31_12_2001", "ТерриториальныеУсловияНа31.12.2001");
	
КонецФункции

Процедура ВывестиЛьготныйСтажСЗВК2025(ВыборкаПоЗаписямСтажа, УзелПериодыРаботы, ФорматЛьготныйСтаж)
	
	ВыводитьЛьготныйСтаж = Ложь;
	
	НаборЗаписейЛьготныйСтаж = ФорматЛьготныйСтаж;
	
	Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияКод) Тогда
		НаборЗаписейЛьготныйСтаж.СЗВК9__ТУ.Значение.СЗВК9__Основание = СокрЛП(ВыборкаПоЗаписямСтажа.ТерриториальныеУсловияКод);
		НаборЗаписейЛьготныйСтаж.СЗВК9__ТУ.Значение.СЗВК9__Коэффициент = ВыборкаПоЗаписямСтажа.РайонныйКоэффициент;
		ВыводитьЛьготныйСтаж = Истина;
	Иначе
		НаборЗаписейЛьготныйСтаж.СЗВК9__ТУ.НеВыводитьВФайл = Истина;	
	КонецЕсли;
				
	Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОсобыеУсловияТрудаКод) Тогда
		НаборЗаписейЛьготныйСтаж.СЗВК9__ОУТ.Значение.СЗВК9__Код = СокрЛП(ВыборкаПоЗаписямСтажа.ОсобыеУсловияТрудаКод);
		НаборЗаписейЛьготныйСтаж.СЗВК9__ОУТ.Значение.СЗВК9__ПозицияСписка = СокрЛП(ВыборкаПоЗаписямСтажа.КодПозицииСпискаКод);
		ВыводитьЛьготныйСтаж = Истина;
	Иначе
		НаборЗаписейЛьготныйСтаж.СЗВК9__ОУТ.НеВыводитьВФайл = Истина;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ТретийПараметрИсчисляемогоСтажа) Тогда
		НаборЗаписейЛьготныйСтаж.СЗВК9__ДопСведенияИС.Значение = ВыборкаПоЗаписямСтажа.ТретийПараметрИсчисляемогоСтажа;
		ВыводитьЛьготныйСтаж = Истина;
	Иначе
		НаборЗаписейЛьготныйСтаж.СЗВК9__ДопСведенияИС.НеВыводитьВФайл = Истина;	
	КонецЕсли;
				
	Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОснованиеИсчисляемогоСтажаКод) Тогда
		НаборЗаписейИсчисляемыйСтаж = НаборЗаписейЛьготныйСтаж.СЗВК9__ИС.Значение;
		НаборЗаписейИсчисляемыйСтаж.СЗВК9__Основание.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ОснованиеИсчисляемогоСтажаКод);
		Если ВыборкаПоЗаписямСтажа.ОснованиеИсчисляемогоСтажа = Справочники.ОснованияИсчисляемогоСтраховогоСтажа.ВОДОЛАЗ Тогда
			НаборЗаписейИсчисляемыйСтаж.СЗВК9__ВыработкаКалендарная.НеВыводитьВФайл = Истина;
			НаборЗаписейВыработкаВЧасах = НаборЗаписейИсчисляемыйСтаж.СЗВК9__ВыработкаВчасах.Значение;
			НаборЗаписейВыработкаВЧасах.ВС9__Часы = ВыборкаПоЗаписямСтажа.ПервыйПараметрИсчисляемогоСтажа;
			НаборЗаписейВыработкаВЧасах.ВС9__Минуты = ВыборкаПоЗаписямСтажа.ВторойПараметрИсчисляемогоСтажа;
		ИначеЕсли ВыборкаПоЗаписямСтажа.НулевойПараметрИсчисляемогоСтажа > 0
			Или ВыборкаПоЗаписямСтажа.ПервыйПараметрИсчисляемогоСтажа > 0 
			Или ВыборкаПоЗаписямСтажа.ВторойПараметрИсчисляемогоСтажа > 0 Тогда
			НаборЗаписейИсчисляемыйСтаж.СЗВК9__ВыработкаВчасах.НеВыводитьВФайл = Истина;
			НаборЗаписейВыработкаКалендарная = НаборЗаписейИсчисляемыйСтаж.СЗВК9__ВыработкаКалендарная.Значение;
			НаборЗаписейВыработкаКалендарная.ВС9__ВсеГоды = ВыборкаПоЗаписямСтажа.НулевойПараметрИсчисляемогоСтажа;
			НаборЗаписейВыработкаКалендарная.ВС9__ВсеМесяцы = ВыборкаПоЗаписямСтажа.ПервыйПараметрИсчисляемогоСтажа;
			НаборЗаписейВыработкаКалендарная.ВС9__ВсеДни = ВыборкаПоЗаписямСтажа.ВторойПараметрИсчисляемогоСтажа;
		Иначе
			НаборЗаписейИсчисляемыйСтаж.СЗВК9__ВыработкаВчасах.НеВыводитьВФайл = Истина;
			НаборЗаписейИсчисляемыйСтаж.СЗВК9__ВыработкаКалендарная.НеВыводитьВФайл = Истина;
		КонецЕсли;
		ВыводитьЛьготныйСтаж = Истина;
	Иначе
		НаборЗаписейЛьготныйСтаж.СЗВК9__ИС.НеВыводитьВФайл = Истина;	
	КонецЕсли;
				
	Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.ОснованиеВыслугиЛетКод) Тогда
		НаборЗаписейВыслугаЛет = НаборЗаписейЛьготныйСтаж.СЗВК9__ВЛ.Значение;
		НаборЗаписейВыслугаЛет.СЗВК9__Основание.Значение = СокрЛП(ВыборкаПоЗаписямСтажа.ОснованиеВыслугиЛетКод);
		НаборЗаписейВыслугаЛет.СЗВК9__ДоляСтавки.Значение = ВыборкаПоЗаписямСтажа.ТретийПараметрВыслугиЛет;
		Если ВыборкаПоЗаписямСтажа.ОснованиеВыслугиЛет = Справочники.ОснованияДосрочногоНазначенияПенсии.Ст27_15 Тогда
			НаборЗаписейВыслугаЛет.СЗВК9__ВыработкаВчасах.НеВыводитьВФайл = Истина;
			НаборЗаписейВыработкаКалендарная = НаборЗаписейВыслугаЛет.СЗВК9__ВыработкаКалендарная.Значение;
			НаборЗаписейВыработкаКалендарная.ВС9__ВсеМесяцы = ВыборкаПоЗаписямСтажа.ПервыйПараметрВыслугиЛет;
			НаборЗаписейВыработкаКалендарная.ВС9__ВсеДни = ВыборкаПоЗаписямСтажа.ВторойПараметрВыслугиЛет;
		ИначеЕсли ВыборкаПоЗаписямСтажа.ПервыйПараметрВыслугиЛет > 0
			Или ВыборкаПоЗаписямСтажа.ВторойПараметрВыслугиЛет > 0 Тогда 
			НаборЗаписейВыслугаЛет.СЗВК9__ВыработкаКалендарная.НеВыводитьВФайл = Истина;
			НаборЗаписейВыработкаВЧасах = НаборЗаписейВыслугаЛет.СЗВК9__ВыработкаВчасах.Значение;
			НаборЗаписейВыработкаВЧасах.ВС9__Часы = ВыборкаПоЗаписямСтажа.ПервыйПараметрВыслугиЛет;
			НаборЗаписейВыработкаВЧасах.ВС9__Минуты = ВыборкаПоЗаписямСтажа.ВторойПараметрВыслугиЛет;
		Иначе
			НаборЗаписейВыслугаЛет.СЗВК9__ВыработкаВчасах.НеВыводитьВФайл = Истина;
			НаборЗаписейВыслугаЛет.СЗВК9__ВыработкаКалендарная.НеВыводитьВФайл = Истина;
		КонецЕсли;
		ПерсонифицированныйУчет.УстановитьВыводВФайл(НаборЗаписейВыслугаЛет.СЗВК9__КодИсчисления, "Значение");
		ВыводитьЛьготныйСтаж = Истина;
	Иначе
		НаборЗаписейЛьготныйСтаж.СЗВК9__ВЛ.НеВыводитьВФайл = Истина;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаПоЗаписямСтажа.Должность) Тогда
		НаборЗаписейЛьготныйСтаж.СЗВК9__ПрофессияДолжность.Значение = ВРег(СокрЛП(ВыборкаПоЗаписямСтажа.Должность));
		ВыводитьЛьготныйСтаж = Истина;
	Иначе
		НаборЗаписейЛьготныйСтаж.СЗВК9__ПрофессияДолжность.НеВыводитьВФайл = Истина;	
	КонецЕсли;
				
	Если ВыводитьЛьготныйСтаж Тогда
		УзелЛьготныйСтаж = ЗарплатаКадры.ДобавитьУзелВДеревоXML(УзелПериодыРаботы, "ЛьготныйСтаж","");
		ЗарплатаКадры.ДобавитьИнформациюВДерево(УзелЛьготныйСтаж, НаборЗаписейЛьготныйСтаж);
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьЗапросПоШапкеДокумента(Ссылка)
	
	Запрос = Новый Запрос;
	// Установим параметры запроса.
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	// Впишем в запрос дополнительные таблицы.
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
