		Возврат;
	КонецЕсли;

	Форма.Объект.СуммаДокумента =
		Форма.УсловияПоНоменклатуреПоПериодам.Итог("Сумма");
	Форма.Объект.СуммаНДС =
		Форма.УсловияПоНоменклатуреПоПериодам.Итог("СуммаНДС");
КонецПроцедуры

