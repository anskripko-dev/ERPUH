Функция ПроверитьСообщитьНеЗаполненыУчастникиЗакрытойЗакупки()
	Если НЕ ВстраиваниеУХ.ПолучитьЗначениеФункциональнойОпции("НеТребоватьРегистрацииУчастниковДляОткрытыхСпособовЗакупок") 
			И ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Лот.ЗакупочнаяПроцедура,"ЗакрытаяЗакупка") = Истина
			И ЗначениеЗаполнено(Контрагент)
			И ЗначениеЗаполнено(Лот)
			И ЗначениеЗаполнено(Лот.ЗакупочнаяПроцедура)
			И Лот.ЗакупочнаяПроцедура.ТребуетсяКвалификационныйОтбор
			И НЕ ЗакрытыеЗакупкиУХ.ЭтоКонтрагентУчастникЗакупки(Лот.ЗакупочнаяПроцедура, Контрагент) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Контрагент не входит в список участников закрытой закупки'");
		Сообщение.Поле = "Контрагент";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПроверитьСообщитьЕстьПоставляемыеТовары()
	Если УсловияПоНоменклатуре.Количество() > 0
		И УсловияПоНоменклатуре.Найтистроки(Новый Структура("ТоварНеПоставляется",Ложь)).Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не обнаружено поставляемой номенклатуры'");
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	Отказ = Ложь;
	Запрос = Новый Запрос;
	ТЧПотребностей = ПолучитьРезультатЗапросаКПотребностямВЛоте();
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("УсловияПоНоменклатуре",УсловияПоНоменклатуре.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПоНоменклатуре.Номенклатура КАК Номенклатура,
	               |	УсловияПоНоменклатуре.Характеристика КАК Характеристика,
	               |	УсловияПоНоменклатуре.МестоПоставки КАК МестоПоставки,
	               |	УсловияПоНоменклатуре.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	УсловияПоНоменклатуре.Количество КАК Количество,
	               |	УсловияПоНоменклатуре.Коэффициент КАК Коэффициент,
	               |	УсловияПоНоменклатуре.СтавкаНДС КАК СтавкаНДС,
	               |	УсловияПоНоменклатуре.ТоварНеПоставляется КАК ТоварНеПоставляется,
	               |	УсловияПоНоменклатуре.Сумма КАК Сумма
	               |ПОМЕСТИТЬ ТЧПотребностей
	               |ИЗ
	               |	&УсловияПоНоменклатуре КАК УсловияПоНоменклатуре
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧПотребностей.Номенклатура КАК Номенклатура,
	               |	ТЧПотребностей.Характеристика КАК Характеристика,
	               |	ТЧПотребностей.МестоПоставки КАК МестоПоставки,
	               |	ТЧПотребностей.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ТЧПотребностей.Коэффициент КАК Коэффициент,
	               |	ТЧПотребностей.СтавкаНДС КАК СтавкаНДС,
	               |	ТЧПотребностей.ТоварНеПоставляется КАК ТоварНеПоставляется,
	               |	СУММА(ТЧПотребностей.Сумма) КАК Сумма
	               |ИЗ
	               |	ТЧПотребностей КАК ТЧПотребностей
	               |ГДЕ
	               |	ТЧПотребностей.ТоварНеПоставляется = ЛОЖЬ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТЧПотребностей.Номенклатура,
	               |	ТЧПотребностей.ТоварНеПоставляется,
	               |	ТЧПотребностей.МестоПоставки,
	               |	ТЧПотребностей.Коэффициент,
	               |	ТЧПотребностей.Характеристика,
	               |	ТЧПотребностей.СтавкаНДС,
	               |	ТЧПотребностей.ЕдиницаИзмерения
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ТЧПотребностей.Сумма) = 0";
	Выборка = Запрос.Выполнить();
	Если Выборка.Пустой() Тогда
		Возврат НЕ Отказ;
	Иначе 
		ВыборкаРезультатаЗапроса = Выборка.Выбрать();
		Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
			ТекстСообщения = НСтр("ru='Номенклатура %Номенклатура% не может быть с пустой суммой'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения,"%Номенклатура%",ВыборкаРезультатаЗапроса.Номенклатура);
			КлючДанных = ОбщегоНазначенияУХ.КлючДанныхДляСообщенияПользователю(Ссылка);
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			КлючДанных,
			,
			,
			Отказ);
		КонецЦикла;
		Возврат НЕ Отказ;
	КонецЕсли;	
	
	Возврат Истина;
КонецФункции

Процедура СоздатьНоменклатуруПоставщиков()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УсловияПоНоменклатуре",УсловияПоНоменклатуре.Выгрузить(,"Номенклатура"));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПоНоменклатуре.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ТЧНоменклатура
	               |ИЗ
	               |	&УсловияПоНоменклатуре КАК УсловияПоНоменклатуре
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧНоменклатура.Номенклатура КАК Номенклатура,
	               |	НоменклатураПоставщиков.Ссылка КАК НоменклатураПоставщика
				   |ИЗ
	               |	ТЧНоменклатура КАК ТЧНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
	               |		ПО ТЧНоменклатура.Номенклатура = НоменклатураПоставщиков.Номенклатура
	               |			И (НоменклатураПоставщиков.Владелец = &Контрагент)
	               |			И (НоменклатураПоставщиков.ПометкаУдаления = ЛОЖЬ)
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(ТЧНоменклатура.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НоменклатураПоставщиков.Ссылка,
	               |	ТЧНоменклатура.Номенклатура";
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы ИЗ УсловияПоНоменклатуре Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("Номенклатура",СтрокаТаблицы.Номенклатура);
		
		Строка = Выборка.НайтиСтроки(Отбор);
		Если Строка[0].НоменклатураПоставщика = NULL И Строка.количество() = 1 Тогда
			НоваяСтрока = Выборка.Добавить();
			НоваяСтрока.Номенклатура = СтрокаТаблицы.Номенклатура;
			НоваяСтрока.НоменклатураПоставщика = СоздатьНоменклатуруПоставщика(СтрокаТаблицы.Номенклатура,Контрагент);
		КонецЕсли;	
		
	КонецЦикла;
		                            
	Выборка.Сортировать("НоменклатураПоставщика Убыв");
	Для Каждого СтрокаТаблицы ИЗ УсловияПоНоменклатуре Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НоменклатураПоставщика) Тогда
			Отбор = Новый Структура();
			Отбор.Вставить("Номенклатура",СтрокаТаблицы.Номенклатура);
			Строка = Выборка.НайтиСтроки(Отбор);
			СтрокаТаблицы.НоменклатураПоставщика = Строка[0].НоменклатураПоставщика;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

Функция СоздатьНоменклатуруПоставщика(Номенклатура,Контрагент)
	НоменклатураПоставщика = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
	НоменклатураПоставщика.Наименование = Номенклатура;
	НоменклатураПоставщика.Номенклатура = Номенклатура;
	НоменклатураПоставщика.Владелец = Контрагент;
	НоменклатураПоставщика.Записать();
	Возврат НоменклатураПоставщика.Ссылка;
КонецФункции	

Процедура ЗаполнитьДвиженияЭтаповОплат()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланЗакупокПланОплаты.ПроцентПлатежа КАК ПроцентПлатежа,
	               |	ПланЗакупокПланОплаты.ДатаПлатежа КАК ДатаПлатежа,
	               |	ПланЗакупокПланОплаты.ДатаПоступления КАК ДатаПоступления
	               |ИЗ
	               |	Документ.ПредложениеПоставщика.ПланОплаты КАК ПланЗакупокПланОплаты
	               |ГДЕ
	               |	ПланЗакупокПланОплаты.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПланЗакупокПланОплаты.ПроцентПлатежа,
	               |	ПланЗакупокПланОплаты.ДатаПлатежа,
	               |	ПланЗакупокПланОплаты.ДатаПоступления";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Движения.ЭтапыОплат.Записывать = Истина;        
	Пока Выборка.Следующий() Цикл
		НоваяЗапись = Движения.ЭтапыОплат.Добавить();
		НоваяЗапись.Регистратор = Ссылка; 
		НоваяЗапись.Документ = Ссылка;
		
		//НоваяЗапись.Период = Ссылка.Дата;
		НоваяЗапись.ДатаПоступления = Выборка.ДатаПоступления;
		НоваяЗапись.ДатаПлатежа = Выборка.ДатаПлатежа;
		НоваяЗапись.ПроцентОплат = Выборка.ПроцентПлатежа;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


#КонецЕсли

