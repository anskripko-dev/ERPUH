// Рекурсивно находит актуальные версии строки плана закупок СтрокаПланаВход и помещает
// результат в МассивРезультатИзм. Параметр ГлубинаРекурсииВход защищает от бесконечной
// рекурсии.
Процедура ПолучитьАктуальнуюСтрокуРекурсивно(СтрокаПланаВход, МассивРезультатИзм, ГлубинаРекурсииВход = 0)
	Если ГлубинаРекурсииВход > 9999 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтрокаПланаЗакупок.ДокументОснование КАК ДокументОснование,
		|	СтрокаПланаЗакупок.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СтрокаПланаЗакупок КАК СтрокаПланаЗакупок
		|ГДЕ
		|	НЕ СтрокаПланаЗакупок.ПометкаУдаления
		|	И СтрокаПланаЗакупок.ДокументОснование = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтрокаПланаЗакупок.Дата УБЫВ";
	Запрос.УстановитьПараметр("Ссылка", СтрокаПланаВход);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Документ-потомок не найден. Текущая версия является актуальной.
		МассивРезультатИзм.Добавить(СтрокаПланаВход);
	Иначе	
		// Найден потомок. Вызовем поиск относительно него.
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДокументПотомок = ВыборкаДетальныеЗаписи.Ссылка;
			Если ЗначениеЗаполнено(ДокументПотомок) Тогда
				Если ДокументПотомок <> СтрокаПланаВход Тогда
					ПолучитьАктуальнуюСтрокуРекурсивно(ДокументПотомок, МассивРезультатИзм, ГлубинаРекурсииВход + 1); 
				Иначе
					МассивРезультатИзм.Добавить(ДокументПотомок);
				КонецЕсли;
			Иначе
				МассивРезультатИзм.Добавить(СтрокаПланаВход);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры		 // ПолучитьАктуальнуюСтрокуРекурсивно()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
// Процедура инициализирует запрос данными таблиц, переданных в параметрах
Процедура ИнициализироватьЗапрос(Запрос, Объект)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, "Ссылка, Дата, Проведен, ВалютаДокумента");
	Для Каждого КлючЗначение Из РеквизитыДокумента Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// Функция - План потребностей 
//
// Параметры:
//  Объект					 - ДокументСсылка, ДокументОбъект, ДанныеФормыСтруктура	 - 
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц - 
// 
// Возвращаемое значение:
//   Структура - Структура с изменениями документа и менеджером временных таблиц 
//
Функция ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц) Экспорт
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", 				МенеджерВременныхтаблиц);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры",	Ложь);
	ПараметрыПланирования.Вставить("Этап",					Перечисления.ЭтапыПланированияПотребностей.БюджетЗакупокОрганизации);
	ПараметрыПланирования.Вставить("ДокументПланирования",	Объект.Ссылка);
	ПараметрыПланирования.Вставить("ОбъектПланирования",	ОбъектыПланирования.ПолучитьОбъектПланирования(ПараметрыПланирования.ДокументПланирования));
	ПараметрыПланирования.Вставить("ИзменениеПоставки",		Истина);
 	ПараметрыПланирования.Вставить("ОтражатьВБюджетах", 	Истина);
	ПараметрыПланирования.Вставить("ИзменениеСтруктуры",	Истина);
    ПараметрыПланирования.Вставить("ВидБюджета", ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата));
	
 	ПараметрыПланирования.Вставить("ИзменениеПотребностей", Истина);   	 
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Этап", ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДвиженияДенежныхСредств", 	КэшируемыеПроцедурыОПК.ПустаяСтатьяДвиженияДенежныхСредств());
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДоходовИРасходов", 			КэшируемыеПроцедурыОПК.ПустаяСтатьяДоходовИРасходов());
	
	ТипСтатей = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);	
	Если ТипСтатей <> Неопределено И ТипСтатей.ТипЗначения.СодержитТип(ТипЗНЧ(Справочники.СтатьиДоходовИРасходов.ПустаяСсылка())) Тогда
		СтатьяБДР = Истина;
	Иначе
		СтатьяБДР = Ложь;
	КонецЕсли;	
	Запрос.УстановитьПараметр("СтатьяБДР",СтатьяБДР);     
	
	ИменаРеквизитов = "Ссылка, ВалютаДокумента, ОрганизацияДляЗаключенияДоговора, УсловиеОплаты";
	Запрос.УстановитьПараметр("ВидБюджета", ПараметрыПланирования.ВидБюджета);
	
	Запросы = Новый Массив;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	&Этап КАК Этап,
	|	&ОбъектПланирования КАК ОбъектПланирования,
	|	&ВалютаДокумента КАК Валюта,
	|	&УсловиеОплаты КАК УсловиеОплаты,  
	|	&ВидБюджета КАК ВидБюджета,
	|	&ВидБюджета КАК ВидБюджетаПоставка,	
	|	Коллекция.ДатаПоставки КАК ДатаОперации,
	|	Коллекция.АналитикаПланирования КАК АналитикаПредыдущегоЭтапа,
	|	Коллекция.АналитикаИсточника КАК АналитикаИсточника,
	|	Коллекция.Количество КАК Количество,
	|	Коллекция.ПериодПотребности КАК ПериодПотребности,
	|	ВЫБОР
	|		КОГДА &СтатьяБДР
	|			ТОГДА Коллекция.Сумма - Коллекция.СуммаНДС
	|		ИНАЧЕ Коллекция.Сумма
	|	КОНЕЦ КАК Сумма,
	|	Коллекция.Сумма КАК СуммаПоПотребности,
	|	Коллекция.Цена КАК Цена,              
	|	Значение(Справочник.ФизическиеЛица.ПустаяСсылка) Как Менеджер,
	|	Коллекция.Приоритет КАК Приоритет,
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджета, 
	|	Коллекция.Проект КАК Проект,    
	|	Коллекция.МестоПоставки КАК МестоПоставки,	
	|	Коллекция.Назначение КАК Назначение,
	|	Коллекция.Аналитика1 КАК Аналитика1,
	|	Коллекция.Аналитика2 КАК Аналитика2,
	|	Коллекция.Аналитика3 КАК Аналитика3,
	|	Коллекция.Аналитика4 КАК Аналитика4,
	|	Коллекция.Аналитика5 КАК Аналитика5,
	|	Коллекция.Аналитика6 КАК Аналитика6,  
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджетаПоставка,
	|	Коллекция.Аналитика1 КАК Аналитика1Поставка,
	|	Коллекция.Аналитика2 КАК Аналитика2Поставка,
	|	Коллекция.Аналитика3 КАК Аналитика3Поставка,
	|	Коллекция.Аналитика4 КАК Аналитика4Поставка,
	|	Коллекция.Аналитика5 КАК Аналитика5Поставка,
	|	Коллекция.Аналитика6 КАК Аналитика6Поставка,  
	|	Коллекция.СтавкаНДС КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.НоменклатураПоставщиков.ПустаяСсылка) КАК НоменклатураПоставщика,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Поставщик,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроисхождения,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроизводителя
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДляОбработки
	|ИЗ
	|	Документ.СтрокаПланаЗакупок.Номенклатура КАК Коллекция
	|ГДЕ
	|	Коллекция.Ссылка = &Ссылка
	|	И Коллекция.АналитикаИсточника <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	&Этап КАК Этап,
	|	&ОбъектПланирования КАК ОбъектПланирования,
	|	&ВалютаДокумента КАК Валюта,
	|	&УсловиеОплаты КАК УсловиеОплаты,
	|	&ОрганизацияДляЗаключенияДоговора КАК Организация,
	|	Коллекция.ЦФО КАК ЦФО,
	|	Коллекция.ПериодПотребности КАК ПериодПотребности,
	|	Коллекция.Проект КАК Проект, 
	|	Коллекция.Приоритет КАК Приоритет,   
	|	Значение(Справочник.ФизическиеЛица.ПустаяСсылка) Как Менеджер,
	|	&ВидБюджета КАК ВидБюджета,
	|	&ВидБюджета КАК ВидБюджетаПоставка,
	|	Коллекция.Назначение КАК Назначение,	
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджета,
	|	Коллекция.Аналитика1 КАК Аналитика1,
	|	Коллекция.Аналитика2 КАК Аналитика2,
	|	Коллекция.Аналитика3 КАК Аналитика3,
	|	Коллекция.Аналитика4 КАК Аналитика4,
	|	Коллекция.Аналитика5 КАК Аналитика5,
	|	Коллекция.Аналитика6 КАК Аналитика6,
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджетаПоставка,
	|	Коллекция.Аналитика1 КАК Аналитика1Поставка,
	|	Коллекция.Аналитика2 КАК Аналитика2Поставка,
	|	Коллекция.Аналитика3 КАК Аналитика3Поставка,
	|	Коллекция.Аналитика4 КАК Аналитика4Поставка,
	|	Коллекция.Аналитика5 КАК Аналитика5Поставка,
	|	Коллекция.Аналитика6 КАК Аналитика6Поставка, 
	|	ВЫБОР
	|		КОГДА Коллекция.ДатаПоставки = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Коллекция.ПериодПотребности.ДатаНачала
	|		ИНАЧЕ Коллекция.ДатаПоставки
	|	КОНЕЦ КАК ДатаОперации,
	|	Коллекция.Номенклатура КАК Номенклатура,
	|	Коллекция.Характеристика КАК Характеристика,
	|	Коллекция.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Коллекция.Коэффициент КАК Коэффициент,
	|	Коллекция.Количество КАК Количество,
	|	Коллекция.Цена КАК Цена,
	|	ВЫБОР
	|		КОГДА &СтатьяБДР
	|			ТОГДА Коллекция.Сумма - Коллекция.СуммаНДС
	|		ИНАЧЕ Коллекция.Сумма
	|	КОНЕЦ КАК Сумма,
	|	Коллекция.Сумма КАК СуммаПоПотребности,
	|	Коллекция.МестоПоставки КАК МестоПоставки,
	|	Коллекция.СтавкаНДС КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.НоменклатураПоставщиков.ПустаяСсылка) КАК НоменклатураПоставщика,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Поставщик,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроисхождения,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроизводителя
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДобавленныеВручную
	|ИЗ
	|	Документ.СтрокаПланаЗакупок.Номенклатура КАК Коллекция
	|ГДЕ
	|	Коллекция.Ссылка = &Ссылка
	|	И Коллекция.АналитикаИсточника = ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка);
	|ВЫБРАТЬ       
	|	ВТ_Этапы.Ссылка КАК Документ,	
	|	ВТ_Этапы.ПроцентПлатежа КАК ПроцентОплат,
	|	ВТ_Этапы.ДатаПлатежа КАК ДатаПлатежа,
	|	ВТ_Этапы.ДатаПоступления КАК ДатаПоступления  
	|	Поместить ВТ_ПланыОплат
	|ИЗ
	|	Документ.СтрокаПланаЗакупок.ПланОплаты КАК ВТ_Этапы
	|ГДЕ
	|	ВТ_Этапы.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО     
	|	ВТ_Этапы.Ссылка  ,		
	|	ВТ_Этапы.ПроцентПлатежа,
	|	ВТ_Этапы.ДатаПлатежа,
	|	ВТ_Этапы.ДатаПоступления";
	
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("ДанныеФормыСтруктура")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект."+ПустаяСсылка().Метаданные().Имя) Тогда
		// Объект или Форма
		РеквизитыДокумента = Объект;
		
		РеквизитыТабличнойЧасти = "ДатаПоставки,Приоритет, Назначение,МестоПоставки, Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, Количество, Цена, Сумма,СуммаНДС, Проект,"
			+ "АналитикаПланирования, АналитикаИсточника,ПериодПотребности,Организация,ЦФО,СтавкаНДС,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6";
		Коллекция = Объект.Номенклатура.Выгрузить(, РеквизитыТабличнойЧасти);
		Коллекция.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.СтрокаПланаЗакупок"));   
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка"); 
		
		Запрос.УстановитьПараметр("Коллекция", Коллекция); 
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Номенклатура ИЗ &Коллекция КАК Коллекция");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.СтрокаПланаЗакупок.Номенклатура", "ВТ_Номенклатура");

		Коллекция = Объект.ПланОплаты.Выгрузить();
		Коллекция.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.СтрокаПланаЗакупок"));
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка");
		Запрос.УстановитьПараметр("КоллекцияЭтапов", Коллекция); 
		
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Этапы ИЗ &КоллекцияЭтапов КАК Коллекция");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.СтрокаПланаЗакупок.ПланОплаты", "ВТ_Этапы");  
		
		Запросы.Добавить(ТекстЗапроса);
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_Номенклатура");
	ИначеЕсли ТипОбъекта = ТипЗнч(ПустаяСсылка()) Тогда
		// Это ссылка
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, ИменаРеквизитов);
		Запросы.Добавить(ТекстЗапроса);
	КонецЕсли;

	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());  
	Если МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_Номенклатура") <> Неопределено Тогда 
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_Номенклатура");
	КонецЕсли;

	Запрос.Выполнить();
	
	Возврат ПараметрыПланирования;
	
КонецФункции

Процедура ЗаменаТККатегориейЗакупок() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	              |	СтрокаПланаЗакупокНоменклатура.Ссылка КАК Ссылка
	              |ИЗ
	              |	Документ.СтрокаПланаЗакупок.Номенклатура КАК СтрокаПланаЗакупокНоменклатура
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииЗакупокТоварныхКатегорий КАК КатегорииЗакупокТоварныхКатегорий
	              |		ПО СтрокаПланаЗакупокНоменклатура.Ссылка.ТоварнаяКатегория = КатегорииЗакупокТоварныхКатегорий.КатегорияЗакупки
	              |			ИЛИ СтрокаПланаЗакупокНоменклатура.Номенклатура = КатегорииЗакупокТоварныхКатегорий.КатегорияЗакупки
	              |ГДЕ
	              |	(ТИПЗНАЧЕНИЯ(СтрокаПланаЗакупокНоменклатура.Номенклатура) = ТИП(справочник.ТоварныеКатегории)
	              |			ИЛИ ТИПЗНАЧЕНИЯ(СтрокаПланаЗакупокНоменклатура.Ссылка.ТоварнаяКатегория) = ТИП(справочник.ТоварныеКатегории))"; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаПлана = Выборка.Ссылка.ПолучитьОбъект();
		Если ТипЗНЧ(СтрокаПлана.ТоварнаяКатегория) = Тип("СправочникСсылка.ТоварныеКатегории") И
			ЗначениеЗаполнено(СтрокаПлана.ТоварнаяКатегория) Тогда
			к=1;
			//РегистрыСведений.КатегорииЗакупокТоварныхКатегорий.ПолучитьПоследнее((	
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры	
#КонецЕсли
