&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммаКонтрактаРегл(Объект)
	ВалютаОбъекта = Объект.ВалютаДокумента;
	ДатаКурсаОбъекта = Объект.ДатаКурса;
	КурсИСумма = ЦентрализованныеЗакупкиВызовСервераУХ.ПересчитатьСуммуВВалютуРеглУчетаНаДату(
		ВалютаОбъекта, ДатаКурсаОбъекта, Объект.СуммаКонтракта);
	Объект.СуммаКонтрактаВВалютеРегламентированногоУчета = КурсИСумма.СуммаВРублях;
КонецПроцедуры		// РассчитатьСуммаКонтрактаРегл()

&НаСервере
Функция ПолучитьНоменклатуру()   
	                              
	 Потребности = Объект.Номенклатура.Выгрузить();  
	 КолВоСтрок = Потребности.Количество() - 1;
	 Пока КолВоСтрок >= 0 Цикл	 
		Если НЕ ЗначениеЗаполнено(Потребности[КолВоСтрок].АналитикаИсточника) Тогда
			Потребности.Удалить(КолВоСтрок);
		Иначе
			Потребности[КолВоСтрок].Цена = Потребности[КолВоСтрок].АналитикаИсточника.Цена;	 
       	КонецЕсли; 
		КолВоСтрок = КолВоСтрок - 1;
	 КонецЦикла;	 
	 АдресВременногоХранилища = ПоместитьВоВременноеХранилище(
		Потребности, 
		Новый УникальныйИдентификатор());
    Возврат АдресВременногоХранилища;
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуПодбораПотребностейПоПериодам()
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Инновационный",						Объект.ЗакупкаИнновационнойВысокотехнологичнойПродукцииИЛекарственныхСредств);
	ПараметрыФормы.Вставить("ПериодНачала",							ВыборПериодаЗакупки.ПериодНачала);
	Если ЗначениеЗаполнено(Объект.ДатаИсполненияДоговора) Тогда
		ПериодОкончания =  ПолучитьПериодПоДатеОкончания(НачалоДня(КонецМесяца(Объект.ДатаИсполненияДоговора)),ПериодичностьЦентрализованныхЗакупок);
		Если ПериодОкончания = Неопределено Тогда                
			ПериодОкончания = ВыборПериодаЗакупки.ПериодОкончания;
		КонецЕсли;
	Иначе
		ПериодОкончания = ВыборПериодаЗакупки.ПериодОкончания;
	КонецЕсли;  
	ПараметрыФормы.Вставить("ПериодОкончания",						ПериодОкончания);
	ПараметрыФормы.Вставить("ОрганизацияДляЗаключенияДоговора",		Объект.ОрганизацияДляЗаключенияДоговора);
	ПараметрыФормы.Вставить("ФункциональноеНаправление",			Объект.ФункциональноеНаправление);
	ПараметрыФормы.Вставить("МестоПоставки",						Объект.МестоПоставки);  
	ПараметрыФормы.Вставить("ФиксироватьМестоПоставки",				Объект.ЕдиноеМестоПоставки);
	ПараметрыФормы.Вставить("ДатаСреза",							Объект.ДатаИсполненияДоговора);
	ПараметрыФормы.Вставить("Валюта",								Объект.ВалютаДокумента); 
	//ПараметрыФормы.Вставить("ДокументПланирование", Объект.Ссылка);   

	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ПараметрыФормы.Вставить("ДокументПланирования", Объект.ДокументОснование);  
		ПараметрыФормы.Вставить("ДокументИЭтап",Истина);
		ЭтапПланирования = Новый СписокЗначений();
		ЭтапПланирования.Добавить(ОбщегоНазначенияУХ.ПолучитьЗначениеПеречисленияПоИмени("ЭтапыПланированияПотребностей","ЗаявкиСогласованные"));
		ЭтапПланирования.Добавить(ОбщегоНазначенияУХ.ПолучитьЗначениеПеречисленияПоИмени("ЭтапыПланированияПотребностей","БюджетЗакупокОрганизации"));
		ПараметрыФормы.Вставить("ЭтапПланирования",ЭтапПланирования);
	Иначе
		ПараметрыФормы.Вставить("ЭтапПланирования",ОбщегоНазначенияУХ.ПолучитьЗначениеПеречисленияПоИмени("ЭтапыПланированияПотребностей","ЗаявкиСогласованные"));	
		ПараметрыФормы.Вставить("ТипДокументаОтбора", "ПланЗакупок");   
	КонецЕсли;
	
	Если флРазделятьНоменклатуруПоКатегорийнымМенеджерам Тогда
		ПараметрыФормы.Вставить("ТоварнаяКатегория",				Объект.ТоварнаяКатегория);
	Иначе
		// Не используем товарные категории.
	КонецЕсли;
	ТаблицаНоменклатура = ПолучитьНоменклатуру();
	ПараметрыФормы.Вставить("ТекущаяНоменклатура",	ТаблицаНоменклатура);
	ПараметрыФормы.Вставить("НастройкаЭлементов", Новый Структура);
	ПараметрыФормы.НастройкаЭлементов.Вставить("ОтборОрганизации", Новый Структура("ТолькоПросмотр", Ложь));
	СтрокаФормы = "Обработка.ПодборПотребностейИзПлана.Форма";    
	Если Элементы.Группа3.Видимость Тогда 
		ОткрытьФорму(СтрокаФормы, ПараметрыФормы, Элементы.ПотребностиПоГодам, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	Иначе
		ОткрытьФорму(СтрокаФормы, ПараметрыФормы, Элементы.Номенклатура, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПериодПоДатеОкончания(Дата,Периодичность)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОкончания",Дата);
	Запрос.УстановитьПараметр("Периодичность",Периодичность);
	Запрос.Текст="ВЫБРАТЬ
	             |	Периоды.Ссылка КАК Период
	             |ИЗ
	             |	Справочник.Периоды КАК Периоды
	             |ГДЕ
	             |	Периоды.ДатаОкончания = &ДатаОкончания
	             |	И Периоды.Периодичность = &Периодичность
	             |	И Периоды.ПометкаУдаления = ЛОЖЬ";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Период;
	КонецЦикла;	
КонецФункции

&НаКлиенте
Процедура ВнеПлановойПотребностиПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.Номенклатура.Очистить();
		ПотребностиПоГодам.Очистить();  
		РасшифровкаПотребностей.Очистить();
	Иначе
		Объект.ВнеПлановойПотребности = Истина;
	КонецЕсли;
	УстановитьТолькоПросмотрТаблицыПотребностей(ЭтаФорма);
	УстановитьОформлениеДляВнеПлановойПотребности(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьУсловияОплатыПоУсловиюОплаты()
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПодтверждениеЗаполненияУсловий(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСуммуДокументаИзКроссТаблицы();
