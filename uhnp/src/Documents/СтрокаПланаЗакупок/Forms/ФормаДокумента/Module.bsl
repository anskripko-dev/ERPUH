&НаСервере
Процедура ОбновлениеНоменклатурыИЗКроссТаблицы(ДатаНачала,ДатаОкончания,ИдентификаторСтроки,Количество,Сумма)
	
	ТекДанные = ПотребностиПоГодам.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
	СтрокаНайдена = Ложь;
	Если ТекДанные.Количество() > 0 Тогда
		ТекДанные = ТекДанные[0];
		СтрокаНайдена = Истина;
	КонецЕсли;	 
	Если СтрокаНайдена И НЕ ТекДанные.РучноеДобавление Тогда
		КолСтрок = Объект.Номенклатура.Количество() - 1;
		Пока КолСтрок >= 0 Цикл
			Если Объект.Номенклатура[КолСтрок].ИдентификаторСтроки = ТекДанные.ИдентификаторСтроки И
				Объект.Номенклатура[КолСтрок].ДатаПоставки >= ДатаНачала И 
				Объект.Номенклатура[КолСтрок].ДатаПоставки <= ДатаОкончания Тогда
				Объект.Номенклатура.Удалить(КолСтрок);
			КонецЕсли;	
			КолСтрок = КолСтрок - 1;	
		КонецЦикла;	  
		Доб = Объект.Номенклатура.Добавить();
		ЗаполнитьЗначенияСвойств(Доб,ТекДанные);
		Доб.ЭтоТоварнаяКатегория = ТекДанные.ЭтоКатегорияНоменклатуры;
		Доб.ДатаПоставки = ДатаНачала; 
		Доб.Количество = Количество; 
		СтруктураДополнительныхПараметров = СформироватьДополнительныеДанныеПоНоменклатуре();
		ДанныеНоменклатуры = ПолучитьДанныеПоНоменклатуре(Доб.Номенклатура, СтруктураДополнительныхПараметров);  
		ПустаяСтавкаНДС = ПредопределенноеЗначение("Справочник.СтавкиНДС.ПустаяСсылка");
		Доб.СтавкаНДС = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "СтавкаНДС", ПустаяСтавкаНДС);
		Доб.Сумма = Сумма;
		Если Объект.ЦенаВключаетНДС Тогда
			Доб.СуммаБезНДС = 100 * Доб.Сумма / (100 + ВстраиваниеУХВызовСервера.ПолучитьСтавкуНДС(Доб.СтавкаНДС).Ставка);
		Иначе
			Доб.СуммаБезНДС = Доб.Сумма;
		КонецЕсли;
		ТекСтавкаНдсЧисло 	= ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Доб.СтавкаНДС,"Ставка"); 
		ТекСтавкаНдсЧисло = ?(ТекСтавкаНдсЧисло = Неопределено,0,ТекСтавкаНдсЧисло);
		
		Доб.СуммаНДС 		= УчетНДСКлиентСервер.РассчитатьСуммуНДС(Доб.Сумма, Объект.ЦенаВключаетНДС, ТекСтавкаНдсЧисло);
		
	КонецЕсли;	
	
КонецПроцедуры

