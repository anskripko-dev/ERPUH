&НаКлиенте
Процедура УстановкаНМЦ(Команда)
	
	ТекДанные = Элементы.ПотребностиПоГодам.ТекущиеДанные;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура",ТекДанные.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика",ТекДанные.Характеристика);
	ПараметрыФормы.Вставить("ЕдиницаИзмерения",ТекДанные.ЕдиницаИзмерения);
	ПараметрыФормы.Вставить("МестоПоставки",ТекДанные.МестоПоставки);
	ПараметрыФормы.Вставить("Коэффициент",ТекДанные.Коэффициент);
	ПараметрыФормы.Вставить("Цена",ТекДанные.Цена);
	СтрокаФормы = "Документ.СтрокаПланаЗакупок.Форма.ФормаУстановкиНМЦ";
	ОткрытьФорму(СтрокаФормы, ПараметрыФормы, Элементы.ПотребностиПоГодам, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
