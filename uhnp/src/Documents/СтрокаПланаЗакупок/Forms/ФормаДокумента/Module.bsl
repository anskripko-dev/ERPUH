&НаКлиенте
Процедура ПотребностиПоГодамНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение = ТИП("СправочникСсылка.КатегорииЗакупок")  И ЗначениеЗаполнено(Объект.ТоварнаяКатегория) Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.ПотребностиПоГодам.ТекущиеДанные.Номенклатура = Объект.ТоварнаяКатегория; 
		ПотребностиПоГодамНоменклатураПриИзменении(Элемент);      
	ИначеЕсли ВыбранноеЗначение = ТИП("СправочникСсылка.КатегорииЗакупок")  И НЕ ЗначениеЗаполнено(Объект.ТоварнаяКатегория) Тогда	
		СтандартнаяОбработка = Ложь;
		Оповещение = Новый ОписаниеОповещения("ОписаниеВыбораНоменклатуры", ЭтотОбъект);    
		Форма = ОткрытьФорму("Справочник.КатегорииЗакупок.ФормаВыбора",, ЭтаФорма,,,,Оповещение);	
	ИначеЕсли ВыбранноеЗначение = ТИП("СправочникСсылка.Номенклатура")  Тогда
		СтандартнаяОбработка = Ложь;
		Оповещение = Новый ОписаниеОповещения("ОписаниеВыбораНоменклатуры", ЭтотОбъект);    
		Если ЗначениеЗаполнено(Объект.ТоварнаяКатегория) Тогда
			СписокНоменклатуры = СписокНоменклатурыПоТоварнойКатегории(Объект.ТоварнаяКатегория);
			ОтборФормы = Новый Структура();      
			ОтборФормы.Вставить("СписокНоменклатуры",СписокНоменклатуры);  
			Форма = ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",ОтборФормы, ЭтаФорма,,,,Оповещение);	
		Иначе	
			Форма = ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",, ЭтаФорма,,,,Оповещение);	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокНоменклатурыПоТоварнойКатегории(ТоварнаяКатегория)

	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ Разрешенные
	                |	Номенклатура.Ссылка КАК Ссылка
	                |ИЗ
	                |	Справочник.Номенклатура КАК Номенклатура
	                |ГДЕ
	                |	Номенклатура.ТоварнаяКатегория = &ТоварнаяКатегория";     
	Запрос.УстановитьПараметр("ТоварнаяКатегория",ТоварнаяКатегория);
	Выборка = Запрос.Выполнить().Выбрать();
	СписокНоменклатуры = Новый СписокЗначений();
	Пока Выборка.Следующий() Цикл
         СписокНоменклатуры.Добавить(Выборка.Ссылка);
	КонецЦикла;	 
	Возврат СписокНоменклатуры; 
	
КонецФункции

