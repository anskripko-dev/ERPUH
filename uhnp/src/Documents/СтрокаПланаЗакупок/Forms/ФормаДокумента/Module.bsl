
&НаКлиенте
Процедура НоменклатураДатаПоставкиПриИзменении(Элемент)
	ТекДанные = Элементы.Номенклатура.ТекущиеДанные; 
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	ВыбранноеЗначение = ТекДанные.ДатаПоставки;
	Если ВыбранноеЗначение < Объект.ДатаНачалаПодготовкиЗакупки Или
		ВыбранноеЗначение > Объект.ДатаИсполненияДоговора Тогда
		ТекДанные.ДатаПоставки = Дата("00010101");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Необходимо указывать дату поставки в рамках периода поставки'");		
		Сообщение.Сообщить();   
		Возврат;
	КонецЕсли;	
		
	Если ТипЗНЧ(ТекДанные.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда  
		Если  ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") 
			И ВыбранноеЗначение <> НачалоКвартала(ВыбранноеЗначение) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало квартала'");
			Сообщение.Сообщить();
	        ТекДанные.ДатаПоставки = НачалоКвартала(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") 
			И ВыбранноеЗначение <> НачалоМесяца(ВыбранноеЗначение) Тогда
            Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало месяца'");
			Сообщение.Сообщить();
	        ТекДанные.ДатаПоставки = НачалоМесяца(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Год") 
			И ВыбранноеЗначение <> НачалоГода(ВыбранноеЗначение) Тогда
            Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало года'");
			Сообщение.Сообщить();
	        ТекДанные.ДатаПоставки = НачалоГода(ВыбранноеЗначение);
         КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураДатаПоставкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	// Вставить содержимое обработчика.     
	ТекДанные = Элементы.Номенклатура.ТекущиеДанные; 
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранноеЗначение < Объект.ДатаНачалаПодготовкиЗакупки Или
		ВыбранноеЗначение > Объект.ДатаИсполненияДоговора Тогда
		ВыбранноеЗначение = ТекДанные.ДатаПоставки;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Необходимо указывать дату поставки в рамках периода поставки'");		
		Сообщение.Сообщить();   
		Возврат;
	КонецЕсли;	
		
	Если ТипЗНЧ(Элементы.Номенклатура.ТекущиеДанные.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда  
		Если  ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") 
			И ВыбранноеЗначение <> НачалоКвартала(ВыбранноеЗначение) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало квартала'");
			Сообщение.Сообщить();
	        ВыбранноеЗначение = НачалоКвартала(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") 
			И ВыбранноеЗначение <> НачалоМесяца(ВыбранноеЗначение) Тогда
            Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало месяца'");
			Сообщение.Сообщить();
	        ВыбранноеЗначение = НачалоМесяца(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Год") 
			И ВыбранноеЗначение <> НачалоГода(ВыбранноеЗначение) Тогда
            Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало года'");
			Сообщение.Сообщить();
	        ВыбранноеЗначение = НачалоГода(ВыбранноеЗначение);
         КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

#Область ОбработкаОсновныхСобытийФормы


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  

	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//ОПК
	Если Параметры.Ключ.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	//Конец ОПК
	Если Параметры.Свойство("ЗакупочнаяПроцедура") И ЗначениеЗаполнено(Параметры.ЗакупочнаяПроцедура) Тогда
		ЗаполнитьПоЗакупочнойПроцедуре(Параметры.ЗакупочнаяПроцедура);
	КонецЕсли;	
	ФормыУХ.ОформитьЭлементыТаблицыФормы(Элементы.ПотребностиПоГодам);
	
	РеквизитыШаблонаЛота = Справочники.Лоты.ПолучитьРеквизитыШаблонаЛотаВСтруктуре();
	ФлагЗакупкаОтменена = Объект.ЗакупкаОтменена;
	СтруктураОформления = Новый Структура("ЦветФона", WebЦвета.АкварельноСиний);
	ЦентрализованныеЗакупкиВызовСервераУХ.ВыделитьЭлементыФормы(ЭтаФорма, РеквизитыШаблонаЛота, СтруктураОформления);
	ПериодичностьЦентрализованныхЗакупок = ЦентрализованныеЗакупкиУХ.ПолучитьПериодичностьЗакупок();
	Если Параметры.Свойство("СтрокаПереходящегоПериода") И ЗначениеЗаполнено(Параметры.СтрокаПереходящегоПериода) Тогда
		ЗаполнитьЗначенияСвойств(Объект,Параметры.СтрокаПереходящегоПериода,,"Номенклатура,ПереченьПоставщиковПредоставившихЦеновыеПредложения,СпособыОбоснованияНМЦ,Финансирование,Номер");
		ЗаполнитьДаннымиСтрокиПереходящегоПериода(Параметры.СтрокаПереходящегоПериода);		
	КонецЕсли;	  
	Если НЕ ЗначениеЗаполнено(Объект.СпособВыбораПоставщика) Тогда
		Объект.СпособВыбораПоставщика = ПредопределенноеЗначение("Справочник.СпособыВыбораПоставщика.ПустаяСсылка");
	КонецЕсли;	
	#Область УниверсальныеПроцессыСогласование
	ДействияСогласованиеУХСервер.НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта(ЭтаФорма);
	#КонецОбласти
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	ОбновитьОбработкуВыборПериодаЗакупки();
	ИменаКлючевыхПолей = ЦентрализованныеЗакупкиКлиентСерверУХ.ИменаКлючевыхПолейКроссТаблицыПотребностей(); 
	ТиповойКонтекстКроссТаблицы = ЦентрализованныеЗакупкиУХ.ПолучитьТиповойКонтекстКроссТаблицыПотребностей(
		"ПериодыЗакупок", "ПотребностиПоГодам", "ПотребностиПоГодам", ИменаКлючевыхПолей);     
	ЦентрализованныеЗакупкиУХ.ИнициализироватьКроссТаблицуПотребностей(
		ЭтаФорма, "ПараметрыКроссТаблицыПотребностей", ТиповойКонтекстКроссТаблицы);   
	
	ЗапомнитьСостояниеТолькоПросмотрТаблицыПотребностей(ЭтаФорма);
	ОбновитьАктуальнуюВерсиюСтрокиПлана();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Объект.ВнеПлановойПотребности = НЕ ПолучитьФункциональнуюОпцию("СквозноеПланированиеПотребности");
	КонецЕсли;	 
	СквозноеПланированиеПотребности = ПолучитьФункциональнуюОпцию("СквозноеПланированиеПотребности");  
	Элементы.ПотребностиПоГодам.КонтекстноеМеню.ПодчиненныеЭлементы.ПотребностиПоГодамКонтекстноеМенюДобавить.Доступность = НЕ СквозноеПланированиеПотребности;	
	Элементы.ПотребностиПоГодам.КоманднаяПанель.ПодчиненныеЭлементы.ПотребностиПоГодамДобавить.Доступность = НЕ СквозноеПланированиеПотребности;
	Элементы.Номенклатура.КонтекстноеМеню.ПодчиненныеЭлементы.НоменклатураКонтекстноеМенюДобавить.Доступность = НЕ СквозноеПланированиеПотребности;
	Элементы.Номенклатура.КоманднаяПанель.ПодчиненныеЭлементы.НоменклатураДобавить.Доступность = НЕ СквозноеПланированиеПотребности;
	НадписьОплата = НадписьОплата(Объект.Календарь, Объект.ЭтапыГрафикаОплаты.Количество());	
	МассивГоды = СоздатьМассивЛетМеждуДатами( Объект.ДатаОфициальногоОбъявленияЗакупки, Объект.ДатаИсполненияДоговора, Объект.ПериодЗакупок);
	РазместитьКолонкиПотребностиПоГодам(МассивГоды);
	ЗаполнитьДерево();  
	//Данные = ПланированиеПотребностей.ПолучитьПланыПоЗаявкеНаЗакупку(Объект.Ссылка);
	
	УстановитьТолькоПросмотрТаблицыПотребностей(ЭтаФорма);
	УстановитьСостояниеДокумента();
	УстановитьОформлениеФормы();   
	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата) <> Неопределено Тогда
		УстановитьОформлениеСтатейИАналитик();       
	Иначе 
		Элементы.ПланОплатыГруппаСтатья.Видимость = Ложь;
	КонецЕсли;
	УстановитьОписаниеДокументаОбоснованиеТребований();
	УстановитьОформлениеДолгосрочныхДоговоров(ЭтаФорма);
	ВыставитьСуммуМалыхЗакупок();
	УстановитьУсловноеОформлениеКоличестваПоГодам();       
	Элементы.Номенклатура.Видимость = Ложь;
	МодульСогласованияДокументовУХ.ПриСозданииНаСервереОбъект(ЭтаФорма);
	//ОПК
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);    
	
	// Разместить элементы
	Размещение = Новый Структура;
	Размещение.Вставить("Страницы", Элементы.Страницы);
	ПланированиеПотребностейФормы.ДобавитьЭлементыФормы(ЭтотОбъект, Размещение);
	
	// Контроль документа	
	КонтрольУХ.ПодготовитьФормуНаСервере(ЭтотОбъект, Элементы.Страницы);
	
	//Конец ОПК 
	Если Элементы.Найти("ПотребностиПоГодамГруппаРеквизитов") <> Неопределено Тогда
		Элементы.ПотребностиПоГодамГруппаРеквизитов.Видимость = Ложь;  
	КонецЕсли;
	ОбновитьСуммуДокументаИзКроссТаблицы(); 
	ПересчетОтносительногоОтклоненияЦен(, ЭтаФорма);	
	Элементы.СтраницаОплаты.Видимость = Ложь;  
	Элементы.Номенклатура.Видимость = Ложь;   
//	Элементы.ПланПоставокПоПериодамРежимВводаДанныхПоСтрокеКопия.Видимость = Ложь;
	ФинансированиеЗаСчетБюджетаОбновить();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
КонецПроцедуры

#Область ПодключаемыеУХ

&НаКлиенте
Процедура Подключаемый_ТаблицаКонтроляДокументаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТД =  Элемент.ТекущиеДанные;
	Если ТД = неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	КонтрольУХКлиент.ПоказатьРасшифровкуКонтроля(Объект, ТД);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаКонтроляДокументаПриАктивизацииЯчейки(Элемент)
	Элемент.ТекущаяСтрока = неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ПриОжиданииВыполнитьКонтрольДокумента()
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьКонтрольДокумента", 0.5, Истина);
КонецПроцедуры

