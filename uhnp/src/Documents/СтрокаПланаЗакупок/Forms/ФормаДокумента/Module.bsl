КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры) 
	
	
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Параметры.НоваяДата);    
	Если Параметры.НоваяДата > Параметры.СтараяДата Тогда
	    ТаблицаСМэппингом = ПланированиеПотребностей.ЗаменаСтатейИАналитикПоНастройкамЛимитов(Параметры.НоваяДата,Объект.Номенклатура.Выгрузить());
		Объект.Номенклатура.Очистить();
		Объект.Номенклатура.Загрузить(ТаблицаСМэппингом);      
	//Объект.Номенклатура.Выгрузить()
	Иначе
		Для Каждого Строка ИЗ Объект.Номенклатура Цикл
			Строка.СтатьяБюджета = Неопределено;
			Строка.Аналитика1 = Неопределено;
			Строка.Аналитика2 = Неопределено;
			Строка.Аналитика3 = Неопределено;
			Строка.Аналитика4 = Неопределено;
			Строка.Аналитика5 = Неопределено;
			Строка.Аналитика6 = Неопределено;
		КонецЦикла;	
	КонецЕсли;	  
	ЗаполнитьДерево();	
	Если ВидСтатьи <> Неопределено И Элементы.Найти("ПланыДокументаСтатьяБюджета") <> Неопределено Тогда
		Элементы.ПланыДокументаСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;
		Элементы.ПланыДокументаНоменклатураСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;   
	Иначе 
		Если Элементы.Найти("ПланыДокументаСтатьяБюджета") <> Неопределено Тогда
			Элементы.ПланыДокументаГруппаСтатьяИАналитики.Видимость  = Ложь;
			Элементы.НоменклатураСтатьяБюджета.Видимость = Ложь;   
			Элементы.ПланОплатыГруппаСтатья.Видимость = Ложь;  
		Иначе
			Если ВидСтатьи <> Неопределено Тогда
				УстановитьОформлениеСтатейИАналитик();  
				Элементы.ПланыДокументаГруппаСтатьяИАналитики.Видимость  = Истина;
				Элементы.НоменклатураСтатьяБюджета.Видимость = Истина;  
				Элементы.ПланОплатыГруппаСтатья.Видимость = Истина;  
				
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли; 
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Номенклатура.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ЦентрализованныеЗакупкиКлиентСерверУХ.РассчитатьНДССтроки(Объект.ЦенаВключаетНДС, ТекДанные);
		Если Объект.ЦенаВключаетНДС Тогда   
            ТекСтавкаНдсЧисло 	= ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ТекДанные.СтавкаНДС,"Ставка"); 
			ТекСтавкаНдсЧисло = ?(ТекСтавкаНдсЧисло = Неопределено,0,ТекСтавкаНдсЧисло);
			ТекДанные.СуммаБезНДС = 100 * ТекДанные.Сумма / (100 + ТекСтавкаНдсЧисло);
		Иначе
			ТекДанные.СуммаБезНДС = ТекДанные.Сумма;
		КонецЕсли;

	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	СуммаБезНДСТекстПодвала();

КонецПроцедуры

