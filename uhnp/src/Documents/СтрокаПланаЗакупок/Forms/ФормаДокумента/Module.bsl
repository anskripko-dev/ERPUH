	Элементы.СуммаВВалютеРегламентированногоУчета.АвтоОтметкаНезаполненного = флВалютный;
	Элементы.КурсВалюты.АвтоОтметкаНезаполненного = флВалютный;
	Элементы.ДатаКурса.АвтоОтметкаНезаполненного = флВалютный;
