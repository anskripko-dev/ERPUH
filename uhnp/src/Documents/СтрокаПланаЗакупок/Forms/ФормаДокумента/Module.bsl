&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РассчитатьИтогиПотребностиПоСтрокам();
	ПриИзмененииФинансирования();
	УстановитьПолеЭтоКатегорияНоменклатуры();
	ЗаблокироватьКоличествоДляТоварныхКатегорий();
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды        
	
	Если ПотребностиПоПериодуДерево1.Количество() > 0 Тогда
		Элементы.ПотребностиПоПериодуДерево1.ТекущаяСтрока  =  ПотребностиПоПериодуДерево1[0].ПолучитьИдентификатор()	
    КонецЕсли;
	УстановитьОформлениеПодвала();

	Если Не Объект.Проведен Тогда
		ПриОжиданииВыполнитьКонтрольДокумента();   
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НадписьОплата(Календарь, КоличествоЭтаповОплаты)
	
	НадписьОплата = НСтр("ru = 'Этапов оплаты: %КоличествоЭтаповОплаты%, %Календарь%';
						|en = 'Payment steps: %КоличествоЭтаповОплаты%, %Календарь%'");
	НадписьОплата = СтрЗаменить(НадписьОплата, "%Календарь%", ?(ЗначениеЗаполнено(Календарь), НСтр("ru = 'по рабочим дням';
																									|en = 'on workdays'"),НСтр("ru = 'по календарным дням';
																																|en = 'by calendar days'")));
	НадписьОплата = СтрЗаменить(НадписьОплата, "%КоличествоЭтаповОплаты%", КоличествоЭтаповОплаты);
	
	Возврат НадписьОплата;
	
КонецФункции

