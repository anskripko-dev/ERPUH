&НаКлиенте
Процедура ПриИзмененииСтатьиАналитикиВСтроке(СтрокаВход)
	
	СтруктураПоиска = ПолчитьСтруктуруПоискаПоТЧНоменклатура();
	ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаВход);
	Для Каждого Строка ИЗ Объект.Номенклатура Цикл
		СтруктураНоменклатуры = ПолчитьСтруктуруПоискаПоТЧНоменклатура(); 
		ЗаполнитьЗначенияСвойств(СтруктураНоменклатуры,Строка);
		Если ОбщегоНазначенияУХ.СравнитьСтруктурыЗначений(СтруктураПоиска,СтруктураНоменклатуры) Тогда
        	Строка.СтатьяБюджета = СтрокаВход.СтатьяБюджета;
        	Строка.Аналитика1 = СтрокаВход.Аналитика1;
        	Строка.Аналитика2 = СтрокаВход.Аналитика2;
        	Строка.Аналитика3 = СтрокаВход.Аналитика3;
        	Строка.Аналитика4 = СтрокаВход.Аналитика4;
        	Строка.Аналитика5 = СтрокаВход.Аналитика5;
        	Строка.Аналитика6 = СтрокаВход.Аналитика6;
		КонецЕсли;	
	КонецЦикла;
	
 КонецПроцедуры	
 
 &НаСервере
Функция ПолчитьСтруктуруПоискаПоТЧНоменклатура()
	Отбор = Новый Структура();
	Отбор.Вставить("Номенклатура");
	Отбор.Вставить("Характеристика");
	Отбор.Вставить("ЕдиницаИзмерения");
	Отбор.Вставить("МестоПоставки");
	Отбор.Вставить("Организация"); 	
	Отбор.Вставить("Цена"); 	
	Возврат Отбор;
КонецФункции
 
