&НаСервере
Процедура ПотребностиПоПериодуДерево1ПриИзмененииНаСервере()
	// Вставить содержимое обработчика. 
	ДатаОбъявления = Объект.ДатаОфициальногоОбъявленияЗакупки;
	ДатаИсполнения = Объект.ДатаИсполненияДоговора;
	МассивГоды = СоздатьМассивЛетМеждуДатами(ДатаОбъявления, ДатаИсполнения, Объект.ПериодЗакупок);
	
	Для Каждого Строка ИЗ ПотребностиПоГодам Цикл 
		Строка.Количество = 0;
		Строка.Сумма = 0;
		Для Каждого Годы ИЗ МассивГоды Цикл
			ГодСтрока = Формат(Годы, "ЧГ=0"); 
			Строка["Год"+ГодСтрока+"Количество"] = 0;
			Строка["Год"+ГодСтрока+"Сумма"] = 0;
			
			Структура = Новый  Структура();
			Структура.Вставить("Год",Годы);
			Структура.Вставить("ИдентификаторСтроки",Строка.ИдентификаторСтроки);
			НайденныеСтроки = ПотребностиПоПериодуДерево1.НайтиСтроки(Структура);
			Для Каждого СтрокиРасшифровки ИЗ НайденныеСтроки Цикл
				Строка["Год"+ГодСтрока+"Сумма"] = СтрокиРасшифровки.Сумма + Строка["Год"+ГодСтрока+"Сумма"]; 
				Строка["Год"+ГодСтрока+"Количество"] = СтрокиРасшифровки.Сумма + Строка["Год"+ГодСтрока+"Количество"]; 					
			КонецЦикла;	 
			Строка.Количество = Строка["Год"+ГодСтрока+"Количество"] + Строка.Количество;
			Строка.Сумма = Строка["Год"+ГодСтрока+"Сумма"] + Строка.Сумма;
	
		КонецЦикла;
	КонецЦикла;
	ОбновитьСуммуДокументаИзКроссТаблицы();
 	//Данные = ПланированиеПотребностей.ПолучитьПланыПоЗаявкеНаЗакупку(Объект.Ссылка);
	//ПланыДокументаБДДС.Загрузить(Данные.БюджетДвиженияДенежныхСредств);

КонецПроцедуры

