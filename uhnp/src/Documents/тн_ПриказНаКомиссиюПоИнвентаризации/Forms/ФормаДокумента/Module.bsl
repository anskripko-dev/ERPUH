// Губернаторова Дарья 15.11.2021 Выполнение задач №000038912
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	// НАЧАЛО Белоконенко Денис 28.01.2026 Выполнение задач №000056425
	//Если Форма.Объект.ВидКомиссии = ПредопределенноеЗначение("Перечисление.тн_ВидКомиссии.КомиссияПоЭкспертизеКачестваПродукции") Тогда
	Если Форма.Объект.ВидКомиссии = ПредопределенноеЗначение("Справочник.тн_ВидыКомиссии.КомиссияПоЭкспертизеКачестваПродукции") Тогда
	// КОНЕЦ Белоконенко Денис 28.01.2026 Выполнение задач №000056425	
		Форма.Элементы.Эксперт.Видимость = Истина;
	Иначе
		Форма.Элементы.Эксперт.Видимость = Ложь;
	КонецЕсли;	
	
КонецПроцедуры	

