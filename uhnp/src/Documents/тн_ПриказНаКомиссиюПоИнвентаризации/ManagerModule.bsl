КонецПроцедуры

// Губернаторова Дарья 06.09.2021 Выполнение задач №000038912
Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)

	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", 					ДокументСсылка);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Дата КАК Период,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Номер КАК Номер,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Организация КАК Организация,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Эксперт КАК Эксперт,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Ссылка КАК Ссылка,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.ВидКомиссии КАК ВидКомиссии,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Комментарий КАК Комментарий,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.ПометкаУдаления КАК ПометкаУдаления,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Проведен КАК Проведен
	|ИЗ
	|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации КАК тн_ПриказНаКомиссиюПоИнвентаризации
	|ГДЕ
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Ссылка = &Ссылка";

	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",						Реквизиты.Период);
	Запрос.УстановитьПараметр("Номер",						Реквизиты.Номер);
	Запрос.УстановитьПараметр("Организация",				Реквизиты.Организация);
	Запрос.УстановитьПараметр("Эксперт",					Реквизиты.Эксперт);
	Запрос.УстановитьПараметр("ПодразделениеОрганизации",	Реквизиты.ПодразделениеОрганизации);
	Запрос.УстановитьПараметр("ВидКомиссии",				Реквизиты.ВидКомиссии);
	Запрос.УстановитьПараметр("Комментарий",				Реквизиты.Комментарий);
	Запрос.УстановитьПараметр("ПометкаУдаления",			Реквизиты.ПометкаУдаления);
	Запрос.УстановитьПараметр("Проведен",					Реквизиты.Проведен);
			
КонецПроцедуры

// Губернаторова Дарья 06.09.2021 Выполнение задач №000038912
Функция ТекстЗапросаТаблицаКомиссии(Запрос, ТекстыЗапроса, Регистры) Экспорт
	
	ИмяРегистра = "тн_Комиссии";
	//НАЧАЛО Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
	//Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
	//КОНЕЦ Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896	
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Ссылка.ВидКомиссии КАК ВидКомиссии,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.ФИО КАК ФИО,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Ссылка.Организация КАК Организация,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Должность КАК Должность,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Ссылка.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Ссылка.Эксперт КАК Эксперт,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.СтепеньЧленства КАК СтепеньЧленства
	|ИЗ
	|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации.ЧленыКомиссии КАК тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии
	|ГДЕ
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Ссылка = &Ссылка";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции 

