	ПроведениеСерверОПК.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	//КОНЕЦ Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
