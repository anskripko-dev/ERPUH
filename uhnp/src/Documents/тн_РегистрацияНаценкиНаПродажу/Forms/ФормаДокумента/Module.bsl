// Федоров Максим 25.03.2022 Выполнение задач №000040782
&НаКлиенте
Процедура Заполнить(Команда)
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("НачалоПериода", НачалоМесяца(Объект.Дата));
	ПараметрыФормы.Вставить("КонецПериода", КонецМесяца(Объект.Дата));
	
	ОткрытьФорму("Документ.тн_РегистрацияНаценкиНаПродажу.Форма.ФормаЗаполненияТабличнойЧастиНаценка",ПараметрыФормы,Элементы.Наценка,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

