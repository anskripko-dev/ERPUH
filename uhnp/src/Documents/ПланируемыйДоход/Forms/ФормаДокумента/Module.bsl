&НаКлиенте
Процедура ВыполнитьКомандуУХ(Команда)
	
	Если Команда.Имя = "ВыполнитьКонтрольДокумента" Тогда
		ВыполнитьКонтрольДокументаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазбитьСтроку(Команда)
	
	ЗаявкиНаОперацииКлиент.РазбитьСтроку(Объект.ДвиженияОперации, Элементы.ТаблицаДвижений);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЗадолженности(Команда)
	
	ПараметрыПодбора = ПараметрыПодбораОбъектов();
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодобратьОбъектыЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ПодборОбъектовРасчетов.Форма.Форма",
		ПараметрыПодбора, ЭтаФорма,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОформлениеКнопкиОК()
	
	Если ЗаявкиНаОперацииКлиентСервер.РеквизитСостояниеЗаявки(ЭтотОбъект) = Перечисления.СостоянияСогласования.Черновик
		И ЗначениеЗаполнено(ЗаявкиНаОперацииКлиентСервер.РеквизитСогласующий(ЭтотОбъект)) Тогда 
		Элементы.КнопкаОК.Заголовок = НСтр("ru = 'На согласование'");
		Элементы.КнопкаОК.Картинка = БиблиотекаКартинок.Утвердить;
	Иначе
		Элементы.КнопкаОК.Заголовок = НСтр("ru = 'Провести и закрыть'");
		Элементы.КнопкаОК.Картинка = Новый Картинка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКонтрольДокументаНаСервере(ОбновитьСохраненныеЛимиты = Истина)
	КонтрольУХКлиентСервер.ВыполнитьИнтерактивныйКонтроль(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОрганизацииНаСервере()
	
	// ОПК
	ЗаявкиНаОперации.ПриИзмененииОрганизации(ЭтотОбъект);
	// Конец ОПК
	
	// ограничения видов операций 
	ЗаявкиНаОперацииКлиентСервер.УстановитьОграничениеВидыОпераций(ЭтотОбъект);
	// 	
	Если ЗаявкиНаОперации.ПроверитьВидОперацииОрганизации(ЭтотОбъект) Тогда
	    ПриИзмененииВидаОперацииНаСервере();
	Иначе
		Объект.ДоговорКонтрагента = РаботаСДоговорамиКонтрагентовУХ.ОсновнойДоговорКонтрагентаПоВидуДоговоруУХ(Объект.Контрагент, Объект.Организация, Объект.ВидОперацииУХ);	
		ПриИзмененииДоговораНаСервере();
	КонецЕсли; 
	УправлениеФормой();
	
КонецПроцедуры

// Процедура выполняет необходимые действия при изменении договора взаиморасчетов
// с контрагентом.
&НаСервере
Процедура ПриИзмененииДоговораНаСервере()
	
	// ОПК
	ЗаявкиНаОперации.ПриИзмененииДоговора(ЭтотОбъект);
	// Конец ОПК
	
	УправлениеФормой();
	
	ВыполнитьКонтрольДокументаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКонтрагентаНаСервере()
	
	Объект.ДоговорКонтрагента = РаботаСДоговорамиКонтрагентовУХ.ОсновнойДоговорКонтрагентаПоВидуДоговоруУХ(Объект.Контрагент, Объект.Организация, Объект.ВидОперацииУХ);	
	ПриИзмененииДоговораНаСервере();
	
	УправлениеФормой();
	
КонецПроцедуры 

&НаСервере
Процедура ОбработатьИзменениеЦФО()
	
	// ОПК
	ЗаявкиНаОперации.ПриИзмененииЦФО(ЭтотОбъект);
	// Конец ОПК
	
	УправлениеФормой();
	ВыполнитьКонтрольДокументаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВалюты()
	
	// ОПК
	ЗаявкиНаОперации.ПриИзмененииВалюты(ЭтотОбъект);
	// Конец ОПК
	
	ВыполнитьКонтрольДокументаНаСервере();
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	#Область УправлениеФлагами
	
	ПеремещениеВнутриОрганизации	= ВидыОперацийУХКлиентСерверПовтИсп.ЭтоПеремещениеВнутриОрганизации(Объект.ВидОперацииУХ);
	
	ЕстьРасчетыСКонтрагентами	= ВидыОперацийУХКлиентСерверПовтИсп.ЭтоРасчетыСКонтрагентом(Объект.ВидОперацииУХ);
	РасчетыБезДоговора			= ВидыОперацийУХКлиентСерверПовтИсп.ЭтоРасчетыБезДоговора(Объект.ВидОперацииУХ);
	РасчетыПоНалогамИСборам		= ВидыОперацийУХКлиентСерверПовтИсп.ЭтоРасчетыПоНалогамИСборам(Объект.ВидОперацииУХ);
	ЕстьРасчетыПоЦеннымБумагам	= ВидыОперацийУХКлиентСерверПовтИсп.ЭтоРасчетыПоЦеннымБумагам(Объект.ВидОперацииУХ);
	ЕстьРасчетыСФизическимЛицом	= ВидыОперацийУХКлиентСерверПовтИсп.ЭтоРасчетыСФизическимЛицом(Объект.ВидОперацииУХ);
	ЭтоПрочиеДоходы = (Объект.ВидОперацииУХ = Справочники.ВидыОперацийУХ.ПрочиеДоходы);

	#КонецОбласти
	
	#Область УправлениеУправляющимиРеквизитами
	Если НЕ ЕстьСуперПользователь Тогда

		Если ЗаявкиНаОперацииКлиентСервер.РеквизитСостояниеЗаявки(ЭтотОбъект) = Перечисления.СостоянияСогласования.Утверждена Тогда
			
			ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ОснованиеОбязательства.Видимость	= ЕстьРасчетыСКонтрагентами И НЕ РасчетыБезДоговора;
	Если Элементы.ОснованиеОбязательства.Видимость Тогда
		Элементы.ОснованиеОбязательства.ОграничениеТипа = ВзаиморасчетыВстраиваниеУХ.ОписаниеТиповОснованиеОбязательстваЗаявок(Объект.Ссылка);
	КонецЕсли;
	
	Элементы.ВнеМаршрута.Доступность = ЕстьСуперПользователь;
		
	#КонецОбласти
	
	#Область УправлениеБлокомСтороныОперации

	Элементы.ГруппаСтороныОперацииВертикальная.ОтображатьЗаголовок	= ЕстьРасчетыСКонтрагентами;
	Элементы.Контрагент.Видимость						= ЕстьРасчетыСКонтрагентами ИЛИ ЕстьРасчетыСФизическимЛицом ИЛИ ЭтоПрочиеДоходы;
	Элементы.ЦеннаяБумага.Видимость						= ЕстьРасчетыПоЦеннымБумагам;
	Элементы.ДоговорКонтрагента.Видимость				= ЕстьРасчетыСКонтрагентами И НЕ РасчетыБезДоговора;
	Элементы.ДоговорКонтрагента.ТолькоПросмотр			= Не ЗначениеЗаполнено(Объект.Организация) ИЛИ НЕ ЗначениеЗаполнено(Объект.Контрагент);
	Элементы.Сделка.Видимость							= ЕстьРасчетыСКонтрагентами И НЕ РасчетыБезДоговора И ВестиРасчетыПоЗаказам;
	
	#КонецОбласти
		
	#Область УправлениеБлокомСумаОперации
	
	Элементы.ВалютаВзаиморасчетов.ТолькоПросмотр = ЗначениеЗаполнено(Объект.ДоговорКонтрагента);
	
	#КонецОбласти          	
	
	#Область УправлениеБлокомТаблицаДвижений
	
	Если ЗначениеЗаполнено(Объект.ВалютаВзаиморасчетов) Тогда
		Элементы.ТаблицаДвиженийСумма.Заголовок = СтрШаблон(НСтр("ru = 'Сумма (%1)'"), Объект.ВалютаВзаиморасчетов);
	Иначе
		Элементы.ТаблицаДвиженийСумма.Заголовок = НСтр("ru = 'Сумма'");
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ИсточникЛимитов   
	ГрафикДоговораИспользуется = ЗначениеЗаполнено(Объект.ДоговорКонтрагента) 
							И (Не Объект.ДоговорКонтрагента.ГрафикДоговора = Перечисления.ГрафикиДоговора.НеИспользовать);
							
	Элементы.ДокументПланирования.ТолькоПросмотр = ГрафикДоговораИспользуется;  
	
	Если Модифицированность 
		И ЗначениеЗаполнено(Объект.ДокументПланирования) 
		И ГрафикДоговораИспользуется Тогда   
		Объект.ДокументПланирования = Неопределено;
	КонецЕсли;

	ЗависимыеЭлементы = Новый Массив;	
    ЗависимыеЭлементы.Добавить("Организация");
    ЗависимыеЭлементы.Добавить("Контрагент");
	ЗависимыеЭлементы.Добавить("ДоговорКонтрагента");  
	
	РеквизитыРезервирования 
			= ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(Объект.ДокументПланирования, "Организация, Контрагент, ДоговорКонтрагента");

	Для Каждого ИмяЭлемента Из ЗависимыеЭлементы Цикл
		Элементы[ИмяЭлемента].ТолькоПросмотр = ЗначениеЗаполнено(Объект.ДокументПланирования) 
			И ЗначениеЗаполнено(Объект[ИмяЭлемента]) И ЗначениеЗаполнено(РеквизитыРезервирования[ИмяЭлемента]); 	
	КонецЦикла;    
	#КонецОбласти    

КонецПроцедуры // УстановитьВидимость()

