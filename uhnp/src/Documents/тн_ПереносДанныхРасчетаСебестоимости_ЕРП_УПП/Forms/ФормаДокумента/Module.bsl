Функция ИсключаемыеПравилаПреобразованияВидовДвижения()
	Исключения = Новый ТаблицаЗначений();
	Исключения.Колонки.Добавить("ХозяйственнаяОперация",Новый ОписаниеТипов("ПеречислениеСсылка.ХозяйственныеОперации"));
	Исключения.Колонки.Добавить("ВидДвижения", Новый ОписаниеТипов("ВидДвиженияНакопления"));
	Исключения.Колонки.Добавить("ВидДвиженияРеспондента", Новый ОписаниеТипов("ВидДвиженияНакопления"));
	Исключения.Колонки.Добавить("РасчетыВозврат", Новый ОписаниеТипов(Новый КвалификаторыСтроки(7)));
	
	Нов = Исключения.Добавить();
	Нов.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПереносАванса;
	Нов.ВидДвижения = ВидДвиженияНакопления.Расход;
	Нов.ВидДвиженияРеспондента = ВидДвиженияНакопления.Приход;
	Нов.РасчетыВозврат = "Расчеты";
	
	Нов = Исключения.Добавить();
	Нов.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиентуРеглУчет;
	Нов.ВидДвижения = ВидДвиженияНакопления.Расход;
	Нов.ВидДвиженияРеспондента = ВидДвиженияНакопления.Приход;
	Нов.РасчетыВозврат = "Расчеты";
	
	Нов = Исключения.Добавить();
	Нов.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
	Нов.ВидДвижения = ВидДвиженияНакопления.Приход;
	Нов.ВидДвиженияРеспондента = ВидДвиженияНакопления.Расход;
	Нов.РасчетыВозврат = "Возврат";
	
	Нов = Исключения.Добавить();	
	Нов.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиентуНаПлатежнуюКарту;
	Нов.ВидДвижения = ВидДвиженияНакопления.Приход;
	Нов.ВидДвиженияРеспондента = ВидДвиженияНакопления.Расход;
	Нов.РасчетыВозврат = "Возврат";
	
	Возврат Исключения;
КонецФункции

&НаСервере
Процедура ЗаполнитьУИД()
	
	Для каждого тч Из Объект.Ссылка.Метаданные().ТабличныеЧасти Цикл
		Для каждого СтрокаТЧ Из Объект[тч.Имя] Цикл
			
			//Подразделение_УИД
			ЗаполнитьУИД_ПоСтроке(СтрокаТЧ, "Подразделение");

			//Продукция_УИД
			ЗаполнитьУИД_ПоСтроке(СтрокаТЧ, "Продукция");

			//Номенклатура_УИД
			ЗаполнитьУИД_ПоСтроке(СтрокаТЧ, "Номенклатура");

			//Склад_УИД
			ЗаполнитьУИД_ПоСтроке(СтрокаТЧ, "Склад");
			
			//Контрагент_УИД
			ЗаполнитьУИД_ПоСтроке(СтрокаТЧ, "Контрагент");
			
			//Договор_УИД
			ЗаполнитьУИД_ПоСтроке(СтрокаТЧ, "Договор");
						
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУИД_ПоСтроке(СтрокаТЧ, ИмяРеквизитаСсылки)
	
	ИмяРеквизитаУИД = СтрШаблон("%1_УИД", ИмяРеквизитаСсылки);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, ИмяРеквизитаСсылки) Тогда
		Если ОбщегоНазначения.СсылкаСуществует(СтрокаТЧ[ИмяРеквизитаСсылки])
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, ИмяРеквизитаУИД) Тогда
			СтрокаТЧ[ИмяРеквизитаУИД] = тн_Интеграция_УПП.ВернутьСтрокуУИД(СтрокаТЧ[ИмяРеквизитаСсылки]);
		Иначе
			СтрокаТЧ[ИмяРеквизитаУИД] = тн_Интеграция_УПП.ВернутьСтрокуУИД(Неопределено);
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти
