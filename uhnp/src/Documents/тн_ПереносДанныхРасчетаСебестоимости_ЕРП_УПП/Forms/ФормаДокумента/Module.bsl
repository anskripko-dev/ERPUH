	резЗатраты 							= масРезультатов[4];
	резЗатратыНаВыпускПродукции 		= масРезультатов[5];
	резПрочиеДоходыРасходы 				= масРезультатов[6];
	резПродажиСебестоимость 			= масРезультатов[7];
	резПартииТоваровНаСкладах 			= масРезультатов[8];
	резВыпускПродукции 					= масРезультатов[9];
