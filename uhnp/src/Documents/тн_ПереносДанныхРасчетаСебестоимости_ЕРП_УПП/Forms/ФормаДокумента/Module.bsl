
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Асинх Процедура ЗаполнитьТаблицы(Команда)
	
	Если ТаблицыЗаполнены() Тогда
		Обещание = ВопросАсинх("Существующи данные будут перезаполнены. Продолжить?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		Результат = Ждать Обещание;
		
		Если Результат = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьТаблицыСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицы(Команда)
	ОчиститьТаблицыСервер();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ТаблицыЗаполнены()
	
	ЕстьДанные = Объект.Затраты.Количество() > 0
	Или Объект.ЗатратыНаВыпускПродукции.Количество() > 0
	Или Объект.ПрочиеДоходыРасходы.Количество() > 0
	Или Объект.ПродажиСебестоимость.Количество() > 0
	Или Объект.ПартииТоваровНаСкладах.Количество() > 0
	Или Объект.ВыпускПродукции.Количество() > 0
	Или Объект.ВыпускПродукцииБухгалтерскийУчет.Количество() > 0
	Или Объект.Продажи.Количество() > 0;
	
	Возврат ЕстьДанные;
	
КонецФункции

&НаСервере
Процедура ОчиститьТаблицыСервер()
	
	Объект.Затраты.Очистить();
	Объект.ЗатратыНаВыпускПродукции.Очистить();
	Объект.ПрочиеДоходыРасходы.Очистить();
	Объект.ПродажиСебестоимость.Очистить();
	Объект.ПартииТоваровНаСкладах.Очистить();
	Объект.ВыпускПродукции.Очистить();
	Объект.ВыпускПродукцииБухгалтерскийУчет.Очистить();
	Объект.Продажи.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыСервер()
	
	ОчиститьТаблицыСервер();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.ДатаОкончания));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Регистр.Период КАК Период,
	|	Регистр.Подразделение КАК Подразделение,
	|	Регистр.СтатьяРасходов КАК СтатьяРасходов,
	|	Регистр.СтатьяРасходов.Код КАК СтатьяРасходовКод,
	|	СУММА(Регистр.СуммаУпр) КАК СуммаУпр
	|ПОМЕСТИТЬ втПрочиеРасходы
	|ИЗ
	|	РегистрНакопления.ПрочиеРасходы КАК Регистр
	|ГДЕ
	|	Регистр.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Регистр.Организация = &Организация
	|	И ЕСТЬNULL(Регистр.СтатьяРасходов.ВариантРаспределенияРасходовУпр, НЕОПРЕДЕЛЕНО) В (ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаНаправленияДеятельности), ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаПроизводственныеЗатраты))
	|
	|СГРУППИРОВАТЬ ПО
	|	Регистр.Период,
	|	Регистр.Подразделение,
	|	Регистр.СтатьяРасходов,
	|	Регистр.СтатьяРасходов.Код
	|
	|ИМЕЮЩИЕ
	|	СУММА(Регистр.СуммаУпр) <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Регистр.Период КАК Период,
	|	Регистр.Подразделение КАК Подразделение,
	|	Регистр.СтатьяДоходов КАК СтатьяДоходов,
	|	Регистр.СтатьяДоходов.Код КАК СтатьяДоходовКод,
	|	СУММА(Регистр.СуммаРегл) КАК СуммаРегл
	|ПОМЕСТИТЬ втПрочиеДоходы
	|ИЗ
	|	РегистрНакопления.ПрочиеДоходы КАК Регистр
	|ГДЕ
	|	Регистр.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Регистр.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	Регистр.Период,
	|	Регистр.Подразделение,
	|	Регистр.СтатьяДоходов,
	|	Регистр.СтатьяДоходов.Код
	|
	|ИМЕЮЩИЕ
	|	СУММА(Регистр.СуммаРегл) <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Регистр.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА 1
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК Знак,
	|	Регистр.РазделУчета КАК РазделУчета,
	|	Регистр.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Регистр.Период КАК Период,
	|	Регистр.Подразделение КАК Подразделение,
	|	Регистр.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	Регистр.АналитикаУчетаНоменклатуры.МестоХранения КАК МестоХранения,
	|	Регистр.Количество КАК Количество,
	|	Регистр.СтоимостьУпр + Регистр.ДопРасходыУпр + Регистр.ТрудозатратыУпр + Регистр.ПостатейныеПостоянныеУпр + Регистр.ПостатейныеПеременныеУпр КАК Стоимость,
	|	Регистр.СтоимостьРегл + Регистр.ДопРасходыРегл + Регистр.ТрудозатратыРегл + Регистр.ПостатейныеПостоянныеРегл + Регистр.ПостатейныеПеременныеРегл КАК СтоимостьРегл
	|ПОМЕСТИТЬ втСебестоимостьТоваров
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК Регистр
	|ГДЕ
	|	Регистр.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Регистр.Организация = &Организация
	|	И Регистр.РазделУчета В (ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты), ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Регистр.Период КАК Период,
	|	Регистр.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	Регистр.АналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
	|	Регистр.АналитикаУчетаПоПартнерам.Договор КАК Договор,
	|	Регистр.Подразделение КАК Подразделение,
	|	Регистр.Количество КАК Количество,
	|	Регистр.СуммаВыручкиРегл КАК СуммаВыручкиРегл,
	|	Регистр.СуммаВыручкиСНДСРегл КАК СуммаВыручкиСНДСРегл,
	|	Регистр.СуммаВыручкиСНДСРегл - Регистр.СуммаВыручкиРегл КАК СуммаНДС
	|ПОМЕСТИТЬ втВыручкаИСебестоимостьПродаж
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Регистр
	|ГДЕ
	|	Регистр.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Регистр.АналитикаУчетаПоПартнерам.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""тчЗатраты"" КАК тч,
	|	втПрочиеРасходы.Период КАК Период,
	|	втПрочиеРасходы.Подразделение КАК Подразделение,
	|	втПрочиеРасходы.СтатьяРасходов КАК СтатьяРасходов,
	|	втПрочиеРасходы.СтатьяРасходовКод КАК СтатьяРасходов_КодЕРП,
	|	втПрочиеРасходы.СуммаУпр КАК Сумма
	|ИЗ
	|	втПрочиеРасходы КАК втПрочиеРасходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ЗатратыНаВыпускПродукции"" КАК тч,
	|	втСебестоимостьТоваров.Период КАК Период,
	|	втСебестоимостьТоваров.Подразделение КАК Подразделение,
	|	втСебестоимостьТоваров.Номенклатура КАК Продукция,
	|	СУММА(втСебестоимостьТоваров.Количество) КАК Количество,
	|	СУММА(втСебестоимостьТоваров.Стоимость) КАК Сумма
	|ИЗ
	|	втСебестоимостьТоваров КАК втСебестоимостьТоваров
	|ГДЕ
	|	втСебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты)
	|	И втСебестоимостьТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукции)
	|
	|СГРУППИРОВАТЬ ПО
	|	втСебестоимостьТоваров.Период,
	|	втСебестоимостьТоваров.Подразделение,
	|	втСебестоимостьТоваров.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	(СУММА(втСебестоимостьТоваров.Количество) <> 0
	|		ИЛИ СУММА(втСебестоимостьТоваров.Стоимость) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ПрочиеДоходыРасходы"" КАК тч,
	|	втПрочиеРасходы.Период КАК Период,
	|	втПрочиеРасходы.Подразделение КАК Подразделение,
	|	втПрочиеРасходы.СтатьяРасходов КАК СтатьяДоходовРасходов,
	|	"""" КАК СтатьяДоходов_КодЕРП,
	|	втПрочиеРасходы.СтатьяРасходовКод КАК СтатьяРасходов_КодЕРП,
	|	втПрочиеРасходы.СуммаУпр КАК Сумма
	|ИЗ
	|	втПрочиеРасходы КАК втПрочиеРасходы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ПрочиеДоходыРасходы"",
	|	втПрочиеДоходы.Период,
	|	втПрочиеДоходы.Подразделение,
	|	втПрочиеДоходы.СтатьяДоходов,
	|	втПрочиеДоходы.СтатьяДоходовКод,
	|	"""",
	|	-втПрочиеДоходы.СуммаРегл
	|ИЗ
	|	втПрочиеДоходы КАК втПрочиеДоходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ПродажиСебестоимость"" КАК тч,
	|	втСебестоимостьТоваров.Период КАК Период,
	|	втСебестоимостьТоваров.Подразделение КАК Подразделение,
	|	втСебестоимостьТоваров.Номенклатура КАК Номенклатура,
	|	СУММА(втСебестоимостьТоваров.Количество) КАК Количество,
	|	СУММА(втСебестоимостьТоваров.Стоимость) КАК Стоимость
	|ИЗ
	|	втСебестоимостьТоваров КАК втСебестоимостьТоваров
	|ГДЕ
	|	втСебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	|	И втСебестоимостьТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту)
	|
	|СГРУППИРОВАТЬ ПО
	|	втСебестоимостьТоваров.Период,
	|	втСебестоимостьТоваров.Подразделение,
	|	втСебестоимостьТоваров.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	(СУММА(втСебестоимостьТоваров.Количество) <> 0
	|		ИЛИ СУММА(втСебестоимостьТоваров.Стоимость) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ПартииТоваровНаСкладах"" КАК тч,
	|	втСебестоимостьТоваров.Период КАК Период,
	|	втСебестоимостьТоваров.Номенклатура КАК Номенклатура,
	|	втСебестоимостьТоваров.МестоХранения КАК Склад,
	|	СУММА(втСебестоимостьТоваров.Количество * втСебестоимостьТоваров.Знак) КАК Количество,
	|	СУММА(втСебестоимостьТоваров.Стоимость * втСебестоимостьТоваров.Знак) КАК Стоимость
	|ИЗ
	|	втСебестоимостьТоваров КАК втСебестоимостьТоваров
	|ГДЕ
	|	втСебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	|
	|СГРУППИРОВАТЬ ПО
	|	втСебестоимостьТоваров.Период,
	|	втСебестоимостьТоваров.Номенклатура,
	|	втСебестоимостьТоваров.МестоХранения
	|
	|ИМЕЮЩИЕ
	|	(СУММА(втСебестоимостьТоваров.Количество) <> 0
	|		ИЛИ СУММА(втСебестоимостьТоваров.Стоимость) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ВыпускПродукции"" КАК тч,
	|	втСебестоимостьТоваров.Период КАК Период,
	|	втСебестоимостьТоваров.МестоХранения КАК Подразделение,
	|	втСебестоимостьТоваров.Номенклатура КАК Продукция,
	|	СУММА(втСебестоимостьТоваров.Количество) КАК Количество,
	|	СУММА(втСебестоимостьТоваров.Стоимость) КАК Стоимость
	|ИЗ
	|	втСебестоимостьТоваров КАК втСебестоимостьТоваров
	|ГДЕ
	|	втСебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты)
	|	И втСебестоимостьТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукции)
	|
	|СГРУППИРОВАТЬ ПО
	|	втСебестоимостьТоваров.Период,
	|	втСебестоимостьТоваров.МестоХранения,
	|	втСебестоимостьТоваров.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	(СУММА(втСебестоимостьТоваров.Количество) <> 0
	|		ИЛИ СУММА(втСебестоимостьТоваров.Стоимость) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ВыпускПродукцииБухгалтерскийУчет"" КАК тч,
	|	втСебестоимостьТоваров.Период КАК Период,
	|	втСебестоимостьТоваров.МестоХранения КАК Подразделение,
	|	втСебестоимостьТоваров.Номенклатура КАК Продукция,
	|	СУММА(втСебестоимостьТоваров.Количество) КАК Количество,
	|	СУММА(втСебестоимостьТоваров.СтоимостьРегл) КАК Стоимость
	|ИЗ
	|	втСебестоимостьТоваров КАК втСебестоимостьТоваров
	|ГДЕ
	|	втСебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты)
	|	И втСебестоимостьТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукции)
	|
	|СГРУППИРОВАТЬ ПО
	|	втСебестоимостьТоваров.Период,
	|	втСебестоимостьТоваров.МестоХранения,
	|	втСебестоимостьТоваров.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	(СУММА(втСебестоимостьТоваров.Количество) <> 0
	|		ИЛИ СУММА(втСебестоимостьТоваров.Стоимость) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""Продажи"" КАК тч,
	|	втВыручкаИСебестоимостьПродаж.Период КАК Период,
	|	втВыручкаИСебестоимостьПродаж.Подразделение КАК Подразделение,
	|	втВыручкаИСебестоимостьПродаж.Номенклатура КАК Номенклатура,
	|	втВыручкаИСебестоимостьПродаж.Контрагент КАК Контрагент,
	|	втВыручкаИСебестоимостьПродаж.Договор КАК Договор,
	|	СУММА(втВыручкаИСебестоимостьПродаж.Количество) КАК Количество,
	|	СУММА(втВыручкаИСебестоимостьПродаж.СуммаВыручкиРегл) КАК Стоимость,
	|	СУММА(втВыручкаИСебестоимостьПродаж.СуммаВыручкиСНДСРегл) КАК СтоимостьБезСкидок,
	|	СУММА(втВыручкаИСебестоимостьПродаж.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	втВыручкаИСебестоимостьПродаж КАК втВыручкаИСебестоимостьПродаж
	|
	|СГРУППИРОВАТЬ ПО
	|	втВыручкаИСебестоимостьПродаж.Период,
	|	втВыручкаИСебестоимостьПродаж.Подразделение,
