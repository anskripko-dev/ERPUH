Функция ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПутиСубконто)
	
	//1.ВычетНДС по РТУ 		- Дт 68.02 Кт 19.03 	- Дт А.ПУ.НДС.Д(А) Кт А.ПУ.НДС.У(А+ДКЗ)
	//1.АвансПолученный по ПнРС - Дт 76.АВ Кт 68.02 	- Дт ДДС.ПУ.У(ДКЗ) Кт ДДС.ПУ.Д(ДКЗ)
	//1.АвансВыданный по СсРС 	- Дт 68.02 Кт 76.ВА		- Дт ДДС.ПУ.Д(ДКЗ) Кт ДДС.ПУ.У(ДКЗ)
	
	ПоляАналитик = 
	"втПозиции.АналитикаДНДС
