&НаКлиенте
Процедура ЗаписатьДокументПереоценитьПозиции(РежимЗаписи, Закрыть = Ложь)

	АктуальностьКурса();
	
	ПараметрыОтбора = Новый Структура("АктуальностьНарушена", Истина);
	НайденныеСтроки = Объект.ЗаявкиНаОплату.НайтиСтроки(ПараметрыОтбора);
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписи);
	
	Если НайденныеСтроки.Количество() = 0 Тогда	
		
		Записать(ПараметрыЗаписи);
		
		Если Закрыть Тогда
			Закрыть();	
		КонецЕсли;
		
	Иначе
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
		ДополнительныеПараметры.Вставить("Закрыть", Закрыть);
		
		ПараметрыПереоценки = ПараметрыПереоценки(Истина);
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПереоценитьПозицииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму("Документ.РеестрПлатежей.Форма.ФормаПереоценкиПозиций",
			ПараметрыПереоценки, ЭтаФорма, , , , 
			ОповещениеОЗакрытии, 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

