#КонецОбласти

#Область ЗаполнениеИзНСБУ

Функция ТекстЗапроса_ОстаткиСчетовВНА(НомераТаблиц)
	
	НомераТаблиц.Вставить("втОстаткиСчетовВНА", НомераТаблиц.Количество());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	втСчетаВНА.СчетИБ КАК СчетИБ,
	|	втСчетаВНА.РольСчета КАК РольСчета,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК ВНА,
	|	т.Субконто2 КАК Субконто2,
	|	т.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	т.СуммаОстаток КАК СуммаОстаток,
	|	т.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ втОстаткиСчетовВНА
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.Счет
	|				ИЗ
	|					втСчетаВНА КАК т
	|				ГДЕ
	|					НЕ т.ТипВНА ЕСТЬ NULL),
	|			,
	|			Организация = &Организация
	|				И &УсловиеВНА) КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаВНА КАК втСчетаВНА
	|		ПО т.Счет = втСчетаВНА.Счет
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА";
	
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		ЧтоЗаменить = "ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЧтоЗаменить, "т.НаправлениеДеятельности");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВНА", "Субконто1 В (ВЫБРАТЬ т.ВНА ИЗ втВНА КАК т)");
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапроса_ОстаткиВНА(НомераТаблиц)
	
	НомераТаблиц.Вставить("втОстаткиВНА", НомераТаблиц.Количество());
	
	Возврат 	
	"ВЫБРАТЬ
	|	т.ВНА КАК ВНА,
	|	МАКСИМУМ(т.Подразделение) КАК Подразделение,
	|	МАКСИМУМ(т.НаправлениеДеятельности) КАК НаправлениеДеятельности,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА т.РольСчета В (""ВНА"", ""НЗС"", ""ВВНА"")
	|				ТОГДА т.Счет
	|		КОНЕЦ) КАК СчетУчетаНСБУ,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА т.РольСчета В (""НАВНА"", ""НА"")
	|				ТОГДА т.Счет
	|		КОНЕЦ) КАК СчетАмортизацииНСБУ,
	|	СУММА(ВЫБОР
	|			КОГДА т.РольСчета В (""ВНА"", ""НЗС"", ""ВВНА"")
	|				ТОГДА т.СуммаОстаток
	|		КОНЕЦ) КАК ПервоначальнаяСтоимостьНСБУ,
	|	СУММА(ВЫБОР
	|			КОГДА т.РольСчета В (""НАВНА"", ""НА"")
	|				ТОГДА -т.СуммаОстаток
	|		КОНЕЦ) КАК НакопленнаяАмортизацияНСБУ,
	|	СУММА(ВЫБОР
	|			КОГДА т.РольСчета = ""ОВНА""
	|				ТОГДА -т.СуммаОстаток
	|		КОНЕЦ) КАК ОбесценениеНСБУ,
	|	СУММА(ВЫБОР
	|			КОГДА т.РольСчета = ""ПВНА""
	|				ТОГДА -т.СуммаОстаток
	|		КОНЕЦ) КАК ПереоценкаНСБУ,
	|	СУММА(ВЫБОР
	|			КОГДА т.РольСчета В (""ПС"", ""НЗС"", ""ВВНА"")
	|				ТОГДА т.КоличествоОстаток
	|		КОНЕЦ) КАК КоличествоНСБУ
	|ПОМЕСТИТЬ втОстаткиВНА
	|ИЗ
	|	втОстаткиСчетовВНА КАК т
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ВНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА";

КонецФункции

Функция ТекстЗапроса_ТрансляцияСчетовПросто(НомераТаблиц)

	Возврат
	"ВЫБРАТЬ
	|	т.СчетИсточник.СчетСсылка КАК СчетСсылкаНСБУ,
	|	МАКСИМУМ(т.СчетИсточник) КАК СчетНСБУ,
	|	ЕСТЬNULL(МАКСИМУМ(т.СчетПриемник), ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)) КАК СчетМСФО
	|ПОМЕСТИТЬ втТрансляция
	|ИЗ
	|	Справочник.СоответствияСчетовДляТрансляции КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаВНА КАК втСчетаВНА
	|		ПО т.СчетИсточник = втСчетаВНА.СчетИБ
	|			И (т.Владелец = &ШаблонТрансляции)
	|			И (НЕ т.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	т.СчетИсточник.СчетСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетНСБУ";

КонецФункции

