	|	втПараметрыВНА.ПараметрВыработкиНСБУ КАК ПараметрВыработкиНСБУ,
	|	втПараметрыВНА.ПредполагаемыйОбъемПродукцииНСБУ КАК ПредполагаемыйОбъемПродукцииНСБУ,
	|	втПараметрыВНА.ДатаПринятияКУчетуНСБУ КАК ДатаПринятияКУчетуНСБУ,
	|	втПараметрыВНА.ПрофильНСБУ КАК СпособОтраженияРасходовПоАмортизацииНСБУ,
	|	втВНА.ПараметрыУчетаВНА КАК ПараметрыУчетаВНА,
	|	СчетУчетаМСФО.СчетМСФО КАК СчетУчетаМСФО,
	|	СчетАмортизацииМСФО.СчетМСФО КАК СчетАмортизацииМСФО,
	|	втОстаткиВНА.ПервоначальнаяСтоимостьНСБУ КАК ПервоначальнаяСтоимостьМСФО,
	|	втОстаткиВНА.НакопленнаяАмортизацияНСБУ КАК НакопленнаяАмортизацияМСФО,
	|	втОстаткиВНА.ОбесценениеНСБУ КАК ОбесценениеМСФО,
	|	втОстаткиВНА.ПереоценкаНСБУ КАК ПереоценкаМСФО,
	|	втОстаткиВНА.КоличествоНСБУ КАК КоличествоМСФО,
	|	втПараметрыВНА.ЛиквидационнаяСтоимостьНСБУ КАК ЛиквидационнаяСтоимостьМСФО,
	|	втПараметрыВНА.СрокПолезногоИспользованияНСБУ КАК СрокПолезногоИспользованияМСФО,
	|	втПараметрыВНА.СпособНачисленияАмортизацииНСБУ КАК СпособНачисленияАмортизацииМСФО,
	|	втПараметрыВНА.КоэффициентУскоренияНСБУ КАК КоэффициентУскоренияМСФО,
	|	втПараметрыВНА.ПараметрВыработкиНСБУ КАК ПараметрВыработкиМСФО,
	|	втПараметрыВНА.ПредполагаемыйОбъемПродукцииНСБУ КАК ПредполагаемыйОбъемПродукцииМСФО,
	|	втПараметрыВНА.ДатаПринятияКУчетуНСБУ КАК ДатаПринятияКУчетуМСФО,
	|	втПрофилиМСФО.ПрофильМСФО КАК СпособОтраженияРасходовПоАмортизацииМСФО
	|ИЗ
	|	втОстаткиВНА КАК втОстаткиВНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПараметрыВНА КАК втПараметрыВНА
	|			ЛЕВОЕ СОЕДИНЕНИЕ втПрофилиМСФО КАК втПрофилиМСФО
	|			ПО &СоединениеПрофильМСФО
	|		ПО втОстаткиВНА.ВНА = втПараметрыВНА.ВНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВНА КАК втВНА
	|		ПО втОстаткиВНА.ВНА = втВНА.ВНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТрансляция КАК СчетУчетаМСФО
	|		ПО втОстаткиВНА.СчетУчетаНСБУ = СчетУчетаМСФО.СчетСсылкаНСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТрансляция КАК СчетАмортизацииМСФО
	|		ПО втОстаткиВНА.СчетАмортизацииНСБУ = СчетАмортизацииМСФО.СчетСсылкаНСБУ";
	
	СоединениеПрофильМСФО = "втПараметрыВНА.ПрофильНСБУ = втПрофилиМСФО.ПрофильНСБУ";//УХ, БМ, ВЕ
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		
		СоединениеПрофильМСФО = 
		"втПараметрыВНА.СтатьяРасходов = втПрофилиМСФО.СтатьяРасходов
		|И втПараметрыВНА.АналитикаРасходов = втПрофилиМСФО.АналитикаРасходов
		|И втПараметрыВНА.Местонахождение = втПрофилиМСФО.Подразделение
		|И втПараметрыВНА.НаправлениеДеятельности = втПрофилиМСФО.НаправлениеДеятельности";
	
	КонецЕсли;
	
	ТекстЗапроса =  СтрЗаменить(ТекстЗапроса, "&СоединениеПрофильМСФО", СоединениеПрофильМСФО);
	
	Возврат ТекстЗапроса;
	
