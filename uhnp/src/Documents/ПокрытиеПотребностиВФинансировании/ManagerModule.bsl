Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт
КонецПроцедуры
// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

Функция ПроверитьВозможностьУстановкиСостояния(ОбъектСсылка, СостояниеОбъекта, ПротоколОшибок = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектСсылка) <> Тип("ДокументСсылка.ПокрытиеПотребностиВФинансировании") Тогда
		ТекстОшибки = СтрШаблон( 
			НСтр("ru = 'Объект %1 не является покрытием потребностей в финансирования'"),
			ОбъектСсылка);
		УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
			ПротоколОшибок, ОбъектСсылка, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ПроверкаПройдена = Истина;
	
	Если СостояниеОбъекта = Перечисления.СостоянияСогласования.Утверждена Тогда
		
		// Основной вариант финансирования
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаОперацию.Ссылка КАК Ссылка,
		|	ЗаявкаНаОперацию.Организация КАК Организация,
		|	ЗаявкаНаОперацию.ЦФО КАК ЦФО,
		|	ЗаявкаНаОперацию.СуммаДокумента КАК СуммаДокумента,
		|	ЗаявкаНаОперацию.ВалютаДокумента КАК ВалютаДокумента,
		|	ЗаявкаНаОперацию.ОсновнойВариантФинансирования КАК ОсновнойВариантФинансирования
		|ИЗ
		|	Документ.ПокрытиеПотребностиВФинансировании КАК ЗаявкаНаОперацию
		|ГДЕ
		|	ЗаявкаНаОперацию.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
		
		ДанныеДокумента = Запрос.Выполнить().Выгрузить()[0];
		
		РеквизитыПроверяемыеНаЗаполнение = Новый СписокЗначений;
		РеквизитыПроверяемыеНаЗаполнение.Добавить("ОсновнойВариантФинансирования", НСтр("ru = 'Основной вариант финансирования'"));
		Для каждого ПроверяемыйРеквизит Из РеквизитыПроверяемыеНаЗаполнение Цикл
			Если Не ЗначениеЗаполнено(ДанныеДокумента[ПроверяемыйРеквизит.Значение]) Тогда
				
				ПроверкаПройдена = Ложь;
				
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле","Заполнение",ПроверяемыйРеквизит.Представление);
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект." + ПроверяемыйРеквизит.Значение);
				
			КонецЕсли;
		КонецЦикла;         
			
		ПараметрыБюджета = ДвиженияБюджетированиеКлиентСерверУХ.ПараметрыБюджета(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств);
					
	КонецЕсли;
	
	Если ОбъектСсылка.ПометкаУдаления И (СостояниеОбъекта = Перечисления.СостоянияСогласования.Утверждена 
			ИЛИ СостояниеОбъекта = Перечисления.СостоянияСогласования.Отклонена 
			ИЛИ СостояниеОбъекта = Перечисления.СостоянияСогласования.НаУтверждении) Тогда
		
		ТекстОшибки = НСтр("ru = 'Установлена пометка удаления'");
		УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
			ПротоколОшибок, ОбъектСсылка, ТекстОшибки);
		ПроверкаПройдена = Ложь;   
		
	КонецЕсли;
	
	Возврат ПроверкаПройдена;
	
КонецФункции

Процедура ВыполнитьКонтроль(ДокументОбъект, Отказ) Экспорт
	
	ЭтоТранш = ДокументОбъект.ВидФинансирования  = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.ТраншВнутригрупповогоЗайма")
			   Или ДокументОбъект.ВидФинансирования = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.ТраншКредитнойЛинии");
	// 1. Контроль выбранного варианта по остатку лимита  (только транши) 
	Если ЭтоТранш Тогда
		ПроверитьОстатокКредитногоЛимита(ДокументОбъект, Отказ);	
	Иначе
	// 2. Контроль выбранного варианта по остатку рамочного соглашения	
		ПроверитьРамочныйДоговор(ДокументОбъект, Отказ);	
	КонецЕсли;
			
КонецПроцедуры
#КонецОбласти	 

#Область СлужебныеПроцедурыИФункции
Функция ДобавитьТекстЗапросаРасчетыСКонтрагентамиГрафики(ТекстыЗапроса)
	
	ИмяРегистра = "РасчетыСКонтрагентамиГрафики";
	ТекстЗапроса = ТекстЗапросаРасчетыСКонтрагентамиГрафики();
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции  

Функция ДобавитьТекстЗапросаЛимитыРамочныхДоговоровКредитовЗаймов(ТекстыЗапроса)
	
	ИмяРегистра = "ЛимитыРамочныхДоговоровКредитовЗаймов";
	ТекстЗапроса = ТекстЗапросаЛимитыРамочныхДоговоровКредитовЗаймов();
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаЛимитыРамочныхДоговоровКредитовЗаймов()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Заявка.Организация КАК Организация,
	|	Заявка.ОсновнойВариантФинансирования.Контрагент КАК Контрагент,
	|	Заявка.ВалютаДокумента КАК Валюта,
	|	Заявка.Ссылка КАК Ссылка,
	|	Заявка.Ссылка КАК Транш,
	|	&Дата КАК Период,
	|	Заявка.ОсновнойВариантФинансирования.ВидФинансирования КАК ОсновнойВариантФинансированияВидФинансирования,
	|	Заявка.ОсновнойВариантФинансирования.Договор КАК РамочныйДоговор,
	|	0 КАК СуммаЛимита,
	|	Заявка.СуммаДокумента КАК ИсполнениеГрафик
	|ИЗ
	|	Документ.ПокрытиеПотребностиВФинансировании КАК Заявка
	|ГДЕ
	|	(Заявка.ОсновнойВариантФинансирования.ВидФинансирования = ЗНАЧЕНИЕ(Перечисление.ВидыФинансирования.ТраншВнутригрупповогоЗайма)
	|			ИЛИ Заявка.ОсновнойВариантФинансирования.ВидФинансирования = ЗНАЧЕНИЕ(Перечисление.ВидыФинансирования.ТраншКредитнойЛинии))
	|	И Заявка.Ссылка = &Ссылка";
			
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаРасчетыСКонтрагентамиГрафики()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА График.ОперацияГрафика.НаправлениеВзаиморасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	&Ссылка КАК ВерсияГрафика,
	|	&Ссылка КАК ПредметГрафика,
	|	График.Дата КАК Период,
	|	График.СтатьяБюджета КАК СтатьяБюджета,
	|	График.Аналитика1 КАК Аналитика1,
	|	График.Аналитика2 КАК Аналитика2,
	|	График.Аналитика3 КАК Аналитика3,
	|	График.Аналитика4 КАК Аналитика4,
	|	График.Аналитика5 КАК Аналитика5,
	|	График.Аналитика6 КАК Аналитика6,
	|	График.ВидБюджета КАК ВидБюджета,
	|	&ЦФО КАК ЦФО,
	|	&Проект КАК Проект,
	|	График.НаправлениеДвижения КАК ПриходРасход,
	|	График.Сумма КАК Сумма,
	|	График.Валюта КАК Валюта,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	График.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности,
	|	График.ОперацияГрафика КАК Операция,
	|	График.СчетОрганизации КАК СчетОрганизации,
	|	График.СчетКонтрагента КАК СчетКонтрагента
	|ИЗ
	|	Справочник.ВариантыФинансирования.ГрафикРасчетов КАК График
	|ГДЕ
	|	График.Ссылка = &ВариантФинансирования";
			
	Возврат ТекстЗапроса;
	
КонецФункции	

Процедура ПроверитьОстатокКредитногоЛимита(ДокументОбъект, Отказ)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКонтрагентов.Ссылка КАК ПредметГрафика,
		|	ДоговорыКонтрагентов.Контрагент КАК Контрагент,
		|	ДоговорыКонтрагентов.ВидФинансовогоИнструмента КАК ВидФинансовогоИнструмента,
		|	ДоговорыКонтрагентов.Организация КАК Организация,
		|	ДоговорыКонтрагентов.СуммаТраншей КАК СуммаДоговора,
		|	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК ВалютаФинансовогоИнструмента
		|ПОМЕСТИТЬ втДоговоры
		|ИЗ
		|	Справочник.ДоговорыКредитовИДепозитов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.Контрагент = &Контрагент
		|	И ДоговорыКонтрагентов.ДатаПервогоТранша <= &ДатаНачалаСрокаПривлечения
		|	И ДоговорыКонтрагентов.ДатаПоследнегоПлатежа >= &ДатаОкончанияСрокаПривлечения
		|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
		|	И ДоговорыКонтрагентов.ВидСоглашения <> ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.Спецификация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КредитныеЛимитыСрезПоследних.Контрагент КАК Контрагент,
		|	КредитныеЛимитыСрезПоследних.Лимит КАК КредитныйЛимит,
		|	КредитныйЛимитВидыФинансовыхИнструментов.ВидФинансовогоИнструмента КАК ВидФинансовогоИнструмента,
		|	КредитныйЛимитОрганизации.Организация КАК Организация,
		|	КредитныеЛимитыСрезПоследних.Регистратор.ВалютаДокумента КАК ВалютаЛимита,
		|	КредитныеЛимитыСрезПоследних.Регистратор.СуммаЛимита КАК СуммаЛимита
		|ПОМЕСТИТЬ втЛимиты
		|ИЗ
		|	РегистрСведений.КредитныеЛимиты.СрезПоследних(&Период, ) КАК КредитныеЛимитыСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КредитныйЛимит.ВидыФинансовыхИнструментов КАК КредитныйЛимитВидыФинансовыхИнструментов
		|		ПО КредитныеЛимитыСрезПоследних.Регистратор = КредитныйЛимитВидыФинансовыхИнструментов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КредитныйЛимит.Организации КАК КредитныйЛимитОрганизации
		|		ПО КредитныеЛимитыСрезПоследних.Регистратор = КредитныйЛимитОрганизации.Ссылка
		|ГДЕ
		|	КредитныеЛимитыСрезПоследних.Использовать
		|	И КредитныеЛимитыСрезПоследних.Контрагент = &Контрагент
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	т.Валюта КАК Валюта,
		|	т.Курс КАК Курс,
		|	т.Кратность КАК Кратность
		|ПОМЕСТИТЬ втКурсы
		|ИЗ
		|	РегистрСведений.КурсыВалют.СрезПоследних(
		|			,
		|			Валюта В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					втЛимиты.ВалютаЛимита
		|				ИЗ
		|					втЛимиты КАК втЛимиты)) КАК т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	втЛимиты.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(втЛимиты.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
		|	втЛимиты.ВалютаЛимита КАК ВалютаЛимита,
		|	втЛимиты.КредитныйЛимит КАК КредитныйЛимит,
		|	втЛимиты.ВидФинансовогоИнструмента КАК ВидФинансовогоИнструмента,
		|	втЛимиты.СуммаЛимита КАК СуммаЛимита,
		|	ВЫБОР
		|		КОГДА втЛимиты.ВалютаЛимита = втДоговоры.ВалютаФинансовогоИнструмента
		|			ТОГДА втДоговоры.СуммаДоговора
		|		КОГДА ЕСТЬNULL(втКурсыОД.Кратность, 0) = 0
		|				ИЛИ ЕСТЬNULL(втКурсыЛимита.Курс, 0) = 0
		|			ТОГДА втДоговоры.СуммаДоговора
		|		ИНАЧЕ втДоговоры.СуммаДоговора * втКурсыОД.Курс * втКурсыЛимита.Кратность / втКурсыОД.Кратность / втКурсыЛимита.Курс
		|	КОНЕЦ КАК СуммаДоговораВВалютеЛимита,
		|	втДоговоры.СуммаДоговора КАК СуммаДоговора,
		|	втДоговоры.ПредметГрафика КАК ПредметГрафика,
		|	втДоговоры.ВалютаФинансовогоИнструмента КАК ВалютаФинансовогоИнструмента,
		|	ВЫБОР
		|		КОГДА втЛимиты.ВалютаЛимита = втДоговоры.ВалютаФинансовогоИнструмента
		|			ТОГДА втЛимиты.СуммаЛимита - ЕСТЬNULL(втДоговоры.СуммаДоговора, 0)
		|		КОГДА ЕСТЬNULL(втКурсыОД.Кратность, 0) = 0
		|				ИЛИ ЕСТЬNULL(втКурсыЛимита.Курс, 0) = 0
		|			ТОГДА втЛимиты.СуммаЛимита - ЕСТЬNULL(втДоговоры.СуммаДоговора, 0)
		|		ИНАЧЕ втЛимиты.СуммаЛимита - ЕСТЬNULL(втДоговоры.СуммаДоговора, 0) * втКурсыОД.Курс * втКурсыЛимита.Кратность / втКурсыОД.Кратность / втКурсыЛимита.Курс
		|	КОНЕЦ КАК СуммаОстатка
		|ИЗ
		|	втЛимиты КАК втЛимиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДоговоры КАК втДоговоры
		|		ПО втЛимиты.Контрагент = втДоговоры.Контрагент
		|			И втЛимиты.ВидФинансовогоИнструмента = втДоговоры.ВидФинансовогоИнструмента
		|			И (ВЫБОР
		|				КОГДА втЛимиты.Организация ЕСТЬ NULL
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ втЛимиты.Организация = втДоговоры.Организация
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК втКурсыЛимита
		|		ПО (втЛимиты.ВалютаЛимита <> втДоговоры.ВалютаФинансовогоИнструмента)
		|			И втЛимиты.ВалютаЛимита = втКурсыЛимита.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК втКурсыОД
		|		ПО (втЛимиты.ВалютаЛимита <> втДоговоры.ВалютаФинансовогоИнструмента)
		|			И (втДоговоры.ВалютаФинансовогоИнструмента = втКурсыОД.Валюта)";
	
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", 			ДокументОбъект.ВалютаДокумента);
	Запрос.УстановитьПараметр("ДатаНачалаСрокаПривлечения", 	ДокументОбъект.ДатаНачалаДействия);
	Запрос.УстановитьПараметр("ДатаОкончанияСрокаПривлечения", 	ДокументОбъект.ДатаОкончанияДействия);
	Запрос.УстановитьПараметр("Контрагент", 					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.ОсновнойВариантФинансирования, "Контрагент"));
	Запрос.УстановитьПараметр("Период", 						ДокументОбъект.Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;	                              
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СуммаОстатка = 0 ;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СуммаОстатка = ВыборкаДетальныеЗаписи.СуммаОстатка;	
	КонецЦикла;
	
	Если СуммаОстатка = 0 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Недостаточно остатка по кредитному лимиту'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьРамочныйДоговор(ДокументОбъект, Отказ)
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ОсновнойВариантФинансирования) Тогда
		Возврат;	                                                                   
	КонецЕсли;  
	ДоговорОтбора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.ОсновнойВариантФинансирования, "Договор");
	Если НЕ ЗначениеЗаполнено(ДоговорОтбора) Тогда
		Возврат;	
	КонецЕсли;
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика КАК Договор,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаНачалаДоступности, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачалаДоступности,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаОкончанияДоступности, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияДоступности,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаНачалаДействия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачалаДействия,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаОкончанияДействия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияДействия,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.Сумма, 0) КАК ОбщийЛимит,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ВозобновляемыйЛимит, ЛОЖЬ) КАК ВозобновляемыйЛимит
		|ПОМЕСТИТЬ ВТПараметры
		|ИЗ
		|	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(&ДатаОтбора, Организация = &Организация) КАК ВерсииГрафиковРасчетовСрезПоследних
		|ГДЕ
		|	ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика = &Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика.БазовыйДоговор КАК БазовыйДоговор,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА РасчетыПоФинансовымИнструментамГрафикиОстаткиИОбороты.СуммаКонечныйОстаток < 0
		|					ТОГДА -РасчетыПоФинансовымИнструментамГрафикиОстаткиИОбороты.СуммаКонечныйОстаток
		|				ИНАЧЕ РасчетыПоФинансовымИнструментамГрафикиОстаткиИОбороты.СуммаКонечныйОстаток
		|			КОНЕЦ), 0) КАК ИтогоЗадолженность,
		|	ЕСТЬNULL(СУММА(РасчетыПоФинансовымИнструментамГрафикиОстаткиИОбороты.СуммаРасход), 0) КАК ИтогоРасход
		|ПОМЕСТИТЬ ВТИсполнение
		|ИЗ
		|	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И ПредметГрафика.БазовыйДоговор = &Договор) КАК ВерсииГрафиковРасчетовСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКонтрагентамиГрафики.ОстаткиИОбороты(, &ДатаОтбора, , , ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг)) КАК РасчетыПоФинансовымИнструментамГрафикиОстаткиИОбороты
		|		ПО ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика = РасчетыПоФинансовымИнструментамГрафикиОстаткиИОбороты.ПредметГрафика
		|			И ВерсииГрафиковРасчетовСрезПоследних.Регистратор = РасчетыПоФинансовымИнструментамГрафикиОстаткиИОбороты.ВерсияГрафика
		|
		|СГРУППИРОВАТЬ ПО
		|	ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика.БазовыйДоговор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Организация КАК Организация,
		|	ВТПараметры.Договор КАК Договор,
		|	ВТПараметры.ДатаНачалаДоступности КАК ДатаНачалаДоступности,
		|	ВТПараметры.ДатаОкончанияДоступности КАК ДатаОкончанияДоступности,
		|	ВТПараметры.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ВТПараметры.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	ВТПараметры.ОбщийЛимит КАК ОбщийЛимит,
		|	ВТПараметры.ВозобновляемыйЛимит КАК ВозобновляемыйЛимит,
		|	ЕСТЬNULL(ВТИсполнение.ИтогоРасход, 0) КАК ИтогоРасход,
		|	ВЫБОР
		|		КОГДА ВТПараметры.ВозобновляемыйЛимит
		|			ТОГДА ВТПараметры.ОбщийЛимит - ЕСТЬNULL(ВТИсполнение.ИтогоЗадолженность, 0)
		|		ИНАЧЕ ВТПараметры.ОбщийЛимит - ЕСТЬNULL(ВТИсполнение.ИтогоРасход, 0)
		|	КОНЕЦ КАК ОстатокЛимита,
		|	ВТПараметры.Договор.Владелец КАК Контрагент
		|ИЗ
		|	ВТПараметры КАК ВТПараметры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИсполнение КАК ВТИсполнение
		|		ПО ВТПараметры.Договор = ВТИсполнение.БазовыйДоговор
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ВТПараметры.ВозобновляемыйЛимит
		|				ТОГДА ВТПараметры.ОбщийЛимит - ЕСТЬNULL(ВТИсполнение.ИтогоЗадолженность, 0)
		|			ИНАЧЕ ВТПараметры.ОбщийЛимит - ЕСТЬNULL(ВТИсполнение.ИтогоРасход, 0)
		|		КОНЕЦ >= &СуммаДокумента
		|	И ВТПараметры.ДатаНачалаДействия <= &ДатаНачалаДействия
		|	И ВТПараметры.ДатаОкончанияДействия >= &ДатаОкончанияДействия";
	
	Запрос.УстановитьПараметр("ДатаОтбора", 			ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", 			ДокументОбъект.Организация);   
	Запрос.УстановитьПараметр("ДатаНачалаДействия", 	ДокументОбъект.ДатаНачалаДействия); 
	Запрос.УстановитьПараметр("ДатаОкончанияДействия", 	ДокументОбъект.ДатаОкончанияДействия); 
	Запрос.УстановитьПараметр("СуммаДокумента", 		ДокументОбъект.СуммаДокумента);
	Запрос.УстановитьПараметр("Договор",				ДоговорОтбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Недостаточно остатка по договору'"));
	    Отказ = Истина;
	КонецЕсли;	

КонецПроцедуры

#Область ИсточникиДляКонтроляДокумента
	
Функция ИсточникиДокумента(Объект, ДопПараметры = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект));
	
	// 2. Контроль суммы расходов по договору
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХРасходыПоДоговору,
		Источник_РасходыПоДоговору(Объект));
	
	Возврат Источники;
	
КонецФункции
	
Функция Источник_БюджетныеЛимитыРезервы(Объект)

	// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 					Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 				Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 				Не ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", 	Объект.Дата);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	0 КАК Лимит,
	|	СУММА(ВТ_ПланыДокумента.Сумма) КАК Зарезервировано,
	|	0 КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПланыДокумента.Аналитика6,
	|	ВТ_ПланыДокумента.ДокументПланирования,
	|	ВТ_ПланыДокумента.Аналитика1,
	|	ВТ_ПланыДокумента.ВидБюджета,
	|	ВТ_ПланыДокумента.ЦФО,
	|	ВТ_ПланыДокумента.СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика3,
	|	ВТ_ПланыДокумента.Проект,
	|	ВТ_ПланыДокумента.Аналитика5,
	|	ВТ_ПланыДокумента.Организация,
	|	ВТ_ПланыДокумента.Период,
	|	ВТ_ПланыДокумента.Валюта,
	|	ВТ_ПланыДокумента.ПриходРасход,
	|	ВТ_ПланыДокумента.Аналитика2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.Выполнить();
	
	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;
	
КонецФункции

