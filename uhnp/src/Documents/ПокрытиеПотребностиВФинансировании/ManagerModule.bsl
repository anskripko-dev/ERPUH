#Область ПрограммныйИнтерфейс

#Область СтандартныеПодсистемыКоманды

// Добавляет команду создания объекта на основании.
// 
// Параметры:
// 	КомандыСозданияНаОсновании - ТаблицаЗначений - перечень команд
// Возвращаемое значение:
// 	Неопределено, СтрокаТаблицыЗначений - Добавленная Команда.
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	
	МетаданныеДокумента = ПустаяСсылка().Метаданные();
	
	Если ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
		
		КомандаСоздатьНаОсновании						= КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер				= МетаданныеДокумента.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление			= ОбщегоНазначения.ПредставлениеОбъекта(МетаданныеДокумента);
		КомандаСоздатьНаОсновании.РежимЗаписи			= "Записывать";
		
		Возврат КомандаСоздатьНаОсновании;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Заполняет список команд создания на основании.
// 
// Параметры:
// 	КомандыСозданияНаОсновании - ТаблицаЗначений - перечень команд
// 	Параметры - Структура - параметры
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.ЗаявкаНаКорректировкуПланов.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании); 
    Документы.КорректировкаПланов.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании); 
	Документы.ВерсияСоглашенияКредит.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
КонецПроцедуры

#КонецОбласти

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_КонкурентныйЛист") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_КонкурентныйЛист",
		НСтр("ru = 'Конкурентный лист'"), 
		ПечатьКонкурентныйЛист(МассивОбъектов, ОбъектыПечати),,
		"Документ.ПокрытиеПотребностиВФинансировании.ПФ_MXL_КонкурентныйЛист");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт 

	// Справка о подтверждающих документах
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати 	= "Документ.ПокрытиеПотребностиВФинансировании";
	КомандаПечати.Идентификатор 	= "ПФ_MXL_КонкурентныйЛист";
	КомандаПечати.Представление 	= НСтр("ru = 'Конкурентный лист'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 

КонецПроцедуры

Функция ПечатьКонкурентныйЛист(МассивОбъектов, ОбъектыПечати) 
    // Создаем табличный документ и устанавливаем имя параметров печати.
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_КонкурентныйЛист"; 
	Макет 	= Документы.ПокрытиеПотребностиВФинансировании.ПолучитьМакет("ПФ_MXL_КонкурентныйЛист");
	ОбластьШапка					= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицаВариантов			= Макет.ПолучитьОбласть("ТаблицаВариантов|ШапкаВариантов");
	ПараметрыТаблицаВариантов		= Макет.ПолучитьОбласть("ТаблицаВариантов|ПараметрыВариантов");
	ОбластьПодвал					= Макет.ПолучитьОбласть("Подвал");

	Запрос  		= Новый Запрос;
	Запрос.Текст 	= "ВЫБРАТЬ
	             	  |	Заявка.Ссылка КАК Ссылка,
	             	  |	Заявка.ОсновнойВариантФинансирования КАК ОсновнойВариантФинансирования,
	             	  |	Заявка.Организация КАК Организация,
	             	  |	Заявка.Номер КАК Номер,
	             	  |	Заявка.ДатаНачалаДействия КАК ДатаНачалаДействия,
	             	  |	Заявка.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	             	  |	Заявка.ВалютаДокумента КАК Валюта,
	             	  |	Заявка.Дата КАК Дата,
	             	  |	Заявка.СуммаДокумента КАК СуммаДокумента
	             	  |ИЗ
	             	  |	Документ.ПокрытиеПотребностиВФинансировании КАК Заявка
	             	  |ГДЕ
	             	  |	Заявка.Ссылка В(&МассивОбъектов)
	             	  |;
	             	  |
	             	  |////////////////////////////////////////////////////////////////////////////////
	             	  |ВЫБРАТЬ
	             	  |	ВариантыФинансирования.ВидФинансирования КАК ВидФинансирования,
	             	  |	ВариантыФинансирования.ВалютаДокумента КАК ВалютаДокумента,
	             	  |	ВариантыФинансирования.ДатаНачалаДействия КАК ДатаНачалаДействия,
	             	  |	ВариантыФинансирования.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	             	  |	ВариантыФинансирования.Контрагент КАК Контрагент,
	             	  |	ВариантыФинансирования.ОбщаяСумма КАК ОбщаяСумма,
	             	  |	ВариантыФинансирования.ТипПроцентнойСтавки КАК ТипПроцентнойСтавки,
	             	  |	ВариантыФинансирования.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
	             	  |	ПРЕДСТАВЛЕНИЕ(ВариантыФинансирования.ИндикативнаяСтавка) КАК ИндикативнаяСтавкаПредставление,
	             	  |	ВариантыФинансирования.ИндикативнаяСтавка КАК ИндикативнаяСтавка,
	             	  |	ВариантыФинансирования.Ссылка КАК Ссылка,
	             	  |	ВариантыФинансирования.Ковенанты КАК Ковенанты
	             	  |ИЗ
	             	  |	Справочник.ВариантыФинансирования КАК ВариантыФинансирования
	             	  |ГДЕ
	             	  |	ВариантыФинансирования.ПокрытиеПотребностиВФинансировании В(&МассивОбъектов)
	             	  |	И НЕ ВариантыФинансирования.ПометкаУдаления";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка 	=  РезультатЗапроса[0].Выбрать();
	ВыборкаВарианты =  РезультатЗапроса[1].Выбрать();
	
	ВыборкаШапка.Следующий();
	ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
	ОсновнойВариант 	= ВыборкаШапка.ОсновнойВариантФинансирования;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ТабличныйДокумент.Вывести(ШапкаТаблицаВариантов);
	Пока ВыборкаВарианты.Следующий() Цикл
		
		ПараметрыТаблицаВариантов.Параметры.Заполнить(ВыборкаВарианты); 
		Если ЗначениеЗаполнено(ВыборкаВарианты.ИндикативнаяСтавка)
				И	ВыборкаВарианты.ТипПроцентнойСтавки <> Перечисления.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная Тогда
			ПроцентнаяСтавкаСтрока = СтрШаблон(НСтр("ru='%1 + %2 %3'"), 
										ВыборкаВарианты.ИндикативнаяСтавкаПредставление,
										ВыборкаВарианты.ПроцентнаяСтавка, 
										"%");
			ПараметрыТаблицаВариантов.Параметры.ПроцентнаяСтавка = ПроцентнаяСтавкаСтрока;
		Иначе
			ПараметрыТаблицаВариантов.Параметры.ПроцентнаяСтавка = Строка(ВыборкаВарианты.ПроцентнаяСтавка) + " %";			
		КонецЕсли; 
		Если ВыборкаВарианты.Ссылка = ОсновнойВариант Тогда
			
			ПараметрыТаблицаВариантов.Параметры.Приоритет  = БиблиотекаКартинок.Пометка;
		Иначе
			
			ПараметрыТаблицаВариантов.Параметры.Приоритет  = Новый Картинка();			
		
		КонецЕсли;

		ТабличныйДокумент.Присоединить(ПараметрыТаблицаВариантов);	
	
	КонецЦикла;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
КонецФункции

