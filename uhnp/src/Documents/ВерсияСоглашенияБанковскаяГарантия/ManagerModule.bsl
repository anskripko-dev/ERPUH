		ИсточникЛимитовБДДС = ?(ЗначениеЗаполнено(Источник.ИсточникЛимитовБДДС), Источник.ИсточникЛимитовБДДС, Неопределено);
		ИсточникЛимитовИсполнение = ?(ЗначениеЗаполнено(Источник.ИсточникЛимитовИсполнение), Источник.ИсточникЛимитовИсполнение, Неопределено);

		Запрос.УстановитьПараметр("ИсточникЛимитовБДДС",	   ИсточникЛимитовБДДС);
		Запрос.УстановитьПараметр("ИсточникЛимитовИсполнение", ИсточникЛимитовИсполнение);

