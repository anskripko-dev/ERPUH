	УстановитьПривилегированныйРежим(Истина);
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыборкаШапка = ПакетЗапросов[0].Выбрать();
	ВыборкаШапка.Следующий();
	
	ОбщегоНазначенияУТ.ПроверитьВозможностьВводаНаОсновании(
		ВыборкаШапка.Ссылка,
		ВыборкаШапка.СтатусДокумента,
		ВыборкаШапка.ЕстьОшибкиПроведен,
		ВыборкаШапка.ЕстьОшибкиСтатус);
	
	ДокументПередачи = СтруктураЗаполнения.ОснованиеАкта;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	
	ТаблицаТоваров = ПакетЗапросов[5].Выгрузить();
	
	Для Каждого ТекСтрока Из ТаблицаТоваров Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
	КонецЦикла;
	
	Серии.Загрузить(ПакетЗапросов[6].Выгрузить());
	
КонецПроцедуры

//++ НЕ УТКА

#Область ЗаполнениеПоОтгрузкеТоваровСХранения

Процедура ЗаполнитьПоОтгрузкеТоваровСХранения(СтруктураЗаполнения)
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураЗаполнения, "ХозяйственнаяОперация, ПоЗаказу");
	
	Если РеквизитыОснования.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаДавальцу2_5 Тогда
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОтПереработчика2_5;
	Иначе
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОтПереработчика2_5;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание",             СтруктураЗаполнения);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", ХозяйственнаяОперация);
	
	Если РеквизитыОснования.ПоЗаказу
		И ПолучитьФункциональнуюОпцию("ИспользоватьЗаказыПереработчикам2_5") Тогда
		ПоРаспоряжениям  = Истина;
		Запрос.Текст = ТекстЗапросаЗаполнитьНаОснованииПередачиДавальцуПоЗаказам();
	Иначе
		Запрос.Текст = ТекстЗапросаЗаполнитьНаОснованииПередачиДавальцуБезЗаказа();
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	РеквизитыШапки = Результат[Результат.ВГраница() - 2].Выбрать();
	ТаблицаТовары  = Результат[Результат.ВГраница() - 1].Выгрузить();
	ТаблицаЗаказы  = Результат[Результат.ВГраница()].Выгрузить();
	
	Если РеквизитыШапки.Следующий() Тогда
		
		ОшибкиЗаполнения = Новый Массив;
		ШаблонОшибки = НСтр("ru = 'Ввод на основании передачи давальцу невозможен. В заказах переработчику указаны разные ""%1"".';
							|en = 'Cannot generate documents based on transfers to provider. Different %1 are specified in subcontracting purchase orders.'");
		
		Если РеквизитыШапки.ОшибкаНаправлениеДеятельности Тогда
			ОшибкиЗаполнения.Добавить(НСтр("ru = 'Направления деятельности';
											|en = 'Line of business'"));
		КонецЕсли;
		
		Если РеквизитыШапки.ОшибкаСклад Тогда
			ОшибкиЗаполнения.Добавить(НСтр("ru = 'Склады';
											|en = 'Warehouses'"));
		КонецЕсли;
		
		Если РеквизитыШапки.ОшибкаПодразделение Тогда
			ОшибкиЗаполнения.Добавить(НСтр("ru = 'Подразделения';
											|en = 'Business units'"));
		КонецЕсли;
		
		Если РеквизитыШапки.ОшибкаВалюта Тогда
			ОшибкиЗаполнения.Добавить(НСтр("ru = 'Валюты';
											|en = 'Currencies'"));
		КонецЕсли;
		
		Если РеквизитыШапки.ОшибкаЦенаВключаетНДС Тогда
			ОшибкиЗаполнения.Добавить(НСтр("ru = 'Включения НДС в цену';
											|en = 'VAT is included in the price'"));
		КонецЕсли;
		
		Если РеквизитыШапки.ОшибкаСделка Тогда
			ОшибкиЗаполнения.Добавить(НСтр("ru = 'Сделки';
											|en = 'Sales opportunities'"));
		КонецЕсли;
		
		Если Не ОшибкиЗаполнения.Количество() = 0 Тогда
			ТекстОшибки = СтрШаблон(ШаблонОшибки, СтрСоединить(ОшибкиЗаполнения, ", "));
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыШапки);
		
	КонецЕсли;
	
	Если ПоРаспоряжениям Тогда
		
		СкладыЗаказов = ТаблицаЗаказы.ВыгрузитьКолонку("Склад");
		СкладыЗаказов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СкладыЗаказов);
		
		Если СкладыЗаказов.Количество() > 1 Тогда
			ВызватьИсключение НСтр("ru = 'В заказах переработчикам указано несколько складов, ввод на основании передачи давальцу невозможен. Необходимо оформить поступление по каждому складу отдельно.';
									|en = 'Subcontracting purchase orders contain several warehouses. Cannot generate documents based on transfers to provider. Register the receipt for each warehouse separately.'");
		КонецЕсли;
		
		ЗаполнитьЗаказПереработчикуВТоварахДавальца(ТаблицаТовары, ТаблицаЗаказы);
		
		ЗаказыПереработчику = ТаблицаЗаказы.ВыгрузитьКолонку("ЗаказПереработчику");
		ЗаказыПереработчику = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ЗаказыПереработчику);
		
		Если ЗаказыПереработчику.Количество() = 1 Тогда
			ТаблицаТовары.ЗаполнитьЗначения(ЗаказыПереработчику[0], "Распоряжение");
		КонецЕсли;
		
	КонецЕсли;
	
	Товары.Загрузить(ТаблицаТовары);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок", ПакетнаяОбработкаТабличнойЧастиКлиентСервер.СтруктураПересчетаКоличестваУпаковок());
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Товары, СтруктураДействий, КэшированныеЗначения);
	
	ЗаказыСервер.ЗаполнитьЗаказВШапкеПоЗаказамВТабличнойЧасти(Распоряжение, Товары, "Распоряжение");
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.ПоступлениеТоваровОтХранителя));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ЭтотОбъект, ПараметрыУказанияСерий);
	
КонецПроцедуры

Функция ТекстЗапросаЗаполнитьНаОснованииПередачиДавальцуПоЗаказам()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыДавальца.Ссылка КАК ЗаказДавальца
	|ПОМЕСТИТЬ ЗаказыДавальца
	|ИЗ
	|	Документ.ОтгрузкаТоваровСХранения.Товары КАК ТаблицаТоваров
	|	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца2_5 КАК ЗаказыДавальцаОтгрузки
	|	ПО ЗаказыДавальцаОтгрузки.Ссылка = ТаблицаТоваров.ЗаказКлиента
	|	И НЕ ЗаказыДавальцаОтгрузки.Основание = ЗНАЧЕНИЕ(Документ.ЗаказПереработчику2_5.ПустаяСсылка)
	|	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца2_5 КАК ЗаказыДавальца
	|	ПО ЗаказыДавальца.Основание = ЗаказыДавальцаОтгрузки.Основание
	|	
	|ГДЕ
	|	ТаблицаТоваров.Ссылка = &Основание
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыДавальца.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЗаказДавальца
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеЗаказа.Основание                      КАК ЗаказПереработчику,
	|	ЗаказыПереработчику.Дата                    КАК Дата,
	|	ЗаказыПереработчику.Организация             КАК Организация,
	|	ЗаказыПереработчику.Контрагент              КАК Контрагент,
	|	ЗаказыПереработчику.Партнер                 КАК Партнер,
	|	ЗаказыПереработчику.Договор                 КАК Договор,
	|	ЗаказыПереработчику.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА ЗаказыПереработчику.СкладПродукции.ЭтоГруппа
	|			И ЗаказыПереработчику.СкладПродукции.ВыборГруппы =
	|				ЗНАЧЕНИЕ(Перечисление.ВыборГруппыСкладов.РазрешитьВЗаказах)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|		ИНАЧЕ ЗаказыПереработчику.СкладПродукции
	|	КОНЕЦ                                       КАК Склад,
	|	ЗаказыПереработчику.Подразделение           КАК Подразделение,
	|	ЗаказыПереработчику.Валюта                  КАК Валюта,
	|	ЗаказыПереработчику.ЦенаВключаетНДС         КАК ЦенаВключаетНДС,
	|	ЗаказыПереработчику.Сделка                  КАК Сделка
	|ПОМЕСТИТЬ ЗаказыПереработчику
	|ИЗ
	|	Документ.ЗаказДавальца2_5 КАК ДанныеЗаказа
	|	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПереработчику2_5 КАК ЗаказыПереработчику
	|	ПО ЗаказыПереработчику.Ссылка = ДанныеЗаказа.Основание
	|
	|ГДЕ
	|	ДанныеЗаказа.Ссылка В
	|		(ВЫБРАТЬ
	|			ЗаказыДавальца.ЗаказДавальца КАК ЗаказДавальца
	|		ИЗ
	|			ЗаказыДавальца КАК ЗаказыДавальца)
	|	И ЗаказыПереработчику.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеЗаказа.Основание,
	|	ЗаказыПереработчику.Дата,
	|	ЗаказыПереработчику.Организация,
	|	ЗаказыПереработчику.Контрагент,
	|	ЗаказыПереработчику.Партнер,
	|	ЗаказыПереработчику.Договор,
	|	ЗаказыПереработчику.НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА ЗаказыПереработчику.СкладПродукции.ЭтоГруппа
	|			И ЗаказыПереработчику.СкладПродукции.ВыборГруппы =
	|				ЗНАЧЕНИЕ(Перечисление.ВыборГруппыСкладов.РазрешитьВЗаказах)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|		ИНАЧЕ ЗаказыПереработчику.СкладПродукции
	|	КОНЕЦ,
	|	ЗаказыПереработчику.Подразделение,
	|	ЗаказыПереработчику.Валюта,
	|	ЗаказыПереработчику.ЦенаВключаетНДС,
	|	ЗаказыПереработчику.Сделка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЗаказПереработчику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ЗаказыПереработчику.Организация) КАК Организация,
	|	МИНИМУМ(ЗаказыПереработчику.Контрагент)  КАК Контрагент,
	|	МИНИМУМ(ЗаказыПереработчику.Партнер)     КАК Партнер,
	|	МИНИМУМ(ЗаказыПереработчику.Договор)     КАК Договор,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.НаправлениеДеятельности) = 1
	|			ТОГДА МИНИМУМ(ЗаказыПереработчику.НаправлениеДеятельности)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|	КОНЕЦ                                    КАК НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Склад) = 1
	|			ТОГДА МИНИМУМ(ЗаказыПереработчику.Склад)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|	КОНЕЦ                                    КАК Склад,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Подразделение) = 1
	|			ТОГДА МИНИМУМ(ЗаказыПереработчику.Подразделение)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|	КОНЕЦ                                    КАК Подразделение,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Валюта) = 1
	|			ТОГДА МИНИМУМ(ЗаказыПереработчику.Валюта)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|	КОНЕЦ                                    КАК Валюта,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.ЦенаВключаетНДС) = 1
	|			ТОГДА МИНИМУМ(ЗаказыПереработчику.ЦенаВключаетНДС)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ                                    КАК ЦенаВключаетНДС,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Сделка) = 1
	|			ТОГДА МИНИМУМ(ЗаказыПереработчику.Сделка)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СделкиСКлиентами.ПустаяСсылка)
	|	КОНЕЦ                                    КАК Сделка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.НаправлениеДеятельности) > 1 КАК ОшибкаНаправлениеДеятельности,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Склад) > 1                   КАК ОшибкаСклад,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Подразделение) > 1           КАК ОшибкаПодразделение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Валюта) > 1                  КАК ОшибкаВалюта,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.ЦенаВключаетНДС) > 1         КАК ОшибкаЦенаВключаетНДС,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказыПереработчику.Сделка) > 1                  КАК ОшибкаСделка,
	|	&Основание                               КАК ДокументОснование
