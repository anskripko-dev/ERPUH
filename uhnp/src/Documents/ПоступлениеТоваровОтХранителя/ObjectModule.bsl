	// Заполнение по акту при наличии исправления основания акта.
	Если СтруктураЗаполнения.Свойство("ИсправлениеОснования") И ЗначениеЗаполнено(СтруктураЗаполнения.ИсправлениеОснования) Тогда
		Запрос.УстановитьПараметр("ДокументОснованиеИсправлениеОснования", СтруктураЗаполнения.ИсправлениеОснования);
	Иначе
		Запрос.УстановитьПараметр("ДокументОснованиеИсправлениеОснования", СтруктураЗаполнения.ОснованиеАкта);
