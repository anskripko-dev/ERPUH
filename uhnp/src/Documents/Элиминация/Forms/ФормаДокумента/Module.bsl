
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.ПериодОтчета.Пустая() Тогда
		
		ПериодичностьПериода = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
		Объект.ПериодОтчета = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(Объект.Дата, ПериодичностьПериода);
	
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбновитьОтображениеДанных();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ПодготовитьФормуНаСервере();
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПоказатьПротокол(Команда)
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОткрытьФорму("Обработка.ОтображениеПротоколируемыхСобытий.Форма.Форма",
			Новый Структура(
				"МассивПротоколируемыхОбъектов",
			ПолучитьМассивПротоколируемыхОбъектов()));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПроводки(Команда)
	ВремяНачала = ТекущаяДата();
	Если НЕ ЗначениеЗаполнено(Объект.ПериодОтчета) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Не заполнено поле ""Период отчета""!'");
		Сообщение.Поле = "ПериодОтчета";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Сценарий) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Не заполнено поле ""Сценарий""!'");
		Сообщение.Поле = "Сценарий";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Документ должен быть записан!'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	МассивОбъектов = ЗаполнитьРегистрПроводокДляЭлиминации(Объект.Ссылка, флОтладка);
	
	ВремяКонца = ТекущаяДата();
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(НСтр("ru = 'Время заполнения проводок %1 сек.'"), ВремяКонца - ВремяНачала);
	
	ЭтаФорма.Элементы.ПроводкиДляЭлиминации.Обновить();
	
	Если ЗначениеЗаполнено(МассивОбъектов) Тогда
		ОткрытьФорму("Обработка.ОтображениеПротоколируемыхСобытий.Форма.Форма", Новый Структура("МассивПротоколируемыхОбъектов",МассивОбъектов));
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьРегистрПроводокДляЭлиминации(Ссылка, флОтладка)
	Возврат Документы.Элиминация.ЗаполнитьРегистрПроводокДляЭлиминации(Ссылка, флОтладка)
КонецФункции

&НаКлиенте
Процедура КомандаОтладка(Команда)
	флОтладка = Не флОтладка;
	Элементы.ФормаКомандаОтладка.Пометка = флОтладка;
КонецПроцедуры

&НаКлиенте
Процедура УправлениеПериодом(Команда)
	
	Если ЗначениеЗаполнено(КэшируемыеЗначения.УОП) Тогда
		ПоказатьЗначение(, КэшируемыеЗначения.УОП);
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ЗаполнитьКэшируемыеЗначения(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПериодОтчетаПриИзменении(Элемент)
	Объект.Дата = ОбщегоНазначенияУХ.ПолучитьКонецПериодаОтчета(Объект.ПериодОтчета);
	ЗаполнитьКэшируемыеЗначения(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	ЗаполнитьКэшируемыеЗначения(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)                                            
	ПериодичностьПериода = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
	Объект.ПериодОтчета = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(Объект.Дата, ПериодичностьПериода);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьМассивПротоколируемыхОбъектов()
	
	МассивОбъекта = Новый Массив();
	МассивОбъекта.Добавить(Объект.Ссылка);
	Возврат ПротоколируемыеСобытияУХ.ПолучитьМассивПротоколируемыхОбъектов(МассивОбъекта);
	
КонецФункции // ПолучитьМассивПротоколируемыхОбъектов() 

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	КэшируемыеЗначения = Форма.КэшируемыеЗначения;
	
	ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(
		Форма.ПроводкиДляЭлиминации, 
		"ДокументЭлиминации", 
		Объект.Ссылка, 
		Истина);
		
	Элементы.ФормаПоказатьПротокол.Видимость = ЗначениеЗаполнено(Объект.Ссылка);

	ЕстьШаблон = ЗначениеЗаполнено(КэшируемыеЗначения.ШаблонСверки);	
	
	Элементы.ПроводкиДляЭлиминации.Видимость = ЕстьШаблон;
	Элементы.ДекорацияНельзяРедактироватьДанныеДляЭлиминации.Видимость = Не ЕстьШаблон;
	Элементы.ФормаЗаполнитьПроводки.Доступность = ЕстьШаблон;
	
	Если Не ЕстьШаблон Тогда
		Возврат;	
	КонецЕсли;
	
	ЕстьТУ = КэшируемыеЗначения.СпособыЭлиминации.Проводки;
	ЕстьТК = КэшируемыеЗначения.СпособыЭлиминации.Показатели;
	
	Элементы.ПроводкиДляЭлиминацииГруппаСчетаДтКт.Видимость 	= ЕстьТУ;
	Элементы.ПроводкиДляЭлиминацииГруппаСчетаКт.Видимость 		= ЕстьТУ;
	Элементы.ПроводкиДляЭлиминацииГруппаСубконтоДт.Видимость 	= ЕстьТУ;
	Элементы.ПроводкиДляЭлиминацииГруппаСубконтоКт.Видимость 	= ЕстьТУ;
	
	Элементы.ПроводкиДляЭлиминацииПоказательОтчета.Видимость 	= ЕстьТК;
	Элементы.ПроводкиДляЭлиминацииГруппаАналитика123.Видимость 	= ЕстьТК;
	Элементы.ПроводкиДляЭлиминацииГруппаАналитика45.Видимость 	= ЕстьТК;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	КэшируемыеЗначения = Новый Структура;	
	ЗаполнитьКэшируемыеЗначения(ЭтотОбъект);
			
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКэшируемыеЗначения(Форма)
	
	Объект = Форма.Объект;
	
	ЗаполнитьКэшируемыеЗначенияНаСервере(Форма.КэшируемыеЗначения, 
		Объект.Сценарий, Объект.ПериодОтчета, Объект.Организация);
	
	Форма.КонсолидирующаяОрганизация = Форма.КэшируемыеЗначения.Консолидирующая;
	
	УправлениеФормой(Форма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьКэшируемыеЗначенияНаСервере(КэшируемыеЗначения, Сценарий, ПериодОтчета, Организация)

	Если ЗначениеЗаполнено(Сценарий) И ЗначениеЗаполнено(ПериодОтчета) Тогда
		УОП = УправлениеРабочимиПроцессамиУХ
			.ПолучитьДокументУправленияПериодомСценария(Сценарий, ПериодОтчета);
	Иначе
		УОП = Документы.УправлениеПериодомСценария.ПустаяСсылка();
	КонецЕсли;
	
	ШаблонСверки = СверкаВГОУХ
		.ПолучитьШаблонСверкиПоСценариюПериоду(Сценарий, ПериодОтчета);
		
	СпособыЭлиминации = Справочники.ШаблоныСверкиВГО
		.ПроверитьСпособЭлиминацииПроводокПоказателей(ШаблонСверки);
	
	Консолидирующая = УправлениеРабочимиПроцессамиУХ
		.ПолучитьКонсолидирующуюОрганизацию(Организация, Сценарий, ПериодОтчета);
	
	КэшируемыеЗначения.Вставить("УОП", 					УОП);
	КэшируемыеЗначения.Вставить("ШаблонСверки", 		ШаблонСверки);
	КэшируемыеЗначения.Вставить("СпособыЭлиминации", 	СпособыЭлиминации);
	КэшируемыеЗначения.Вставить("Консолидирующая", 		Консолидирующая);
	
КонецПроцедуры

#КонецОбласти