	|			ТОГДА 4
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики5
	|			ТОГДА 5
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики6
	|			ТОГДА 6
	|	КОНЕЦ КАК Субконто3,
	|	т.Показатель КАК Показатель,
	|	т.СчетБД КАК СчетИсточник
	|ПОМЕСТИТЬ втСчетаПоказателей
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		п.Показатель КАК Показатель,
	|		ВЫРАЗИТЬ(п.Показатель.ГруппаРаскрытия КАК Справочник.ГруппыРаскрытия) КАК ГруппаРаскрытия,
	|		п.СчетБД КАК СчетБД
	|	ИЗ
	|		втЗначенияПоказателей КАК п) КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс1
	|		ПО т.СчетБД = вс1.Ссылка
	|			И (вс1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс2
	|		ПО т.СчетБД = вс2.Ссылка
	|			И (вс2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс3
	|		ПО т.СчетБД = вс3.Ссылка
	|			И (вс3.НомерСтроки = 3)";

