#Область втВидыСубконто

Функция ТекстЗапроса_втВидыСубконтоНСБУ(НомераТаблиц)
	
	НомераТаблиц.Вставить("втВидыСубконтоНСБУ", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	тчВидыСубконто.ВидСубконтоСсылка КАК Ссылка,
	|	МАКСИМУМ(ВЫРАЗИТЬ(тчВидыСубконто.ТипДанных КАК СТРОКА(150))) КАК ПредставлениеТипа
	|ПОМЕСТИТЬ втВидыСубконтоНСБУ
	|ИЗ
	|	Справочник.ПланыСчетовБД КАК ПланыСчетовБД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБД
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК тчВидыСубконто
	|			ПО СчетаБД.Ссылка = тчВидыСубконто.Ссылка
	|		ПО ПланыСчетовБД.Ссылка = СчетаБД.Владелец
	|ГДЕ
	|	НЕ ПланыСчетовБД.ОтсутствуетВКонфигурации
	|	И НЕ ПланыСчетовБД.ПланСчетовМСФО
	|
	|СГРУППИРОВАТЬ ПО
	|	тчВидыСубконто.ВидСубконтоСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПредставлениеТипа";
	
КонецФункции

Функция ТекстЗапроса_втВидыСубконто(НомераТаблиц)
	
	НомераТаблиц.Вставить("втВидыСубконто", НомераТаблиц.Количество());
	
	РолиПВХ = Новый Соответствие;
	РолиПВХ.Вставить("%Справочник.Организации%", 				"ОрганизацияКонтрагент");
	РолиПВХ.Вставить("%Справочник.Контрагенты%", 				"Контрагент");
	РолиПВХ.Вставить("%Справочник.ВидыВыручкиВГО%", 			"ВидВыручкиВГО");
	РолиПВХ.Вставить("%Справочник.НоменклатурныеГруппы%", 		"ВидВыручкиВГО");
	РолиПВХ.Вставить("%Справочник.РазделыСверкиВГО%", 			"РазделВГО");
	РолиПВХ.Вставить("%Справочник.СчетаБД%", 					"СчетБД");
	РолиПВХ.Вставить("%Справочник.ПодразделенияОрганизаций%", 	"Подразделение");
	РолиПВХ.Вставить("%Справочник.НаправленияДеятельности%", 	"НаправлениеДеятельности");
	РолиПВХ.Вставить("%Справочник.ПоказателиОтчетов%", 			"ПоказательОтчета");
	
	ШаблонРоли = Шаблон_РольСубконто();
    
	ТекстЗапроса = Новый Массив;
	Для каждого рольПВХ Из РолиПВХ Цикл
		ТекстЗапроса.Добавить(СтрШаблон(ШаблонРоли, рольПВХ.Ключ, рольПВХ.Значение));
	КонецЦикла;
	
	ТекстТаблица = "(" + СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ") + ")";
	Возврат СтрЗаменить(Шаблон_втВидыСубконто(), "ТаблицаВидыСубконто", ТекстТаблица);

КонецФункции

Функция Шаблон_РольСубконто()

	Возврат
	"ВЫБРАТЬ
	|	""%2"" КАК Роль,
	|	ВЫРАЗИТЬ(т.ПредставлениеТипа КАК СТРОКА(150)) КАК ПредставлениеТипа,
	|	т.Ссылка КАК ВидСубконто
	|ИЗ
	|	ПланВидовХарактеристик.ВидыСубконтоКорпоративные КАК т
	|ГДЕ
	|	т.ПредставлениеТипа ПОДОБНО ""%1""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""%2"",
	|	ВЫРАЗИТЬ(т.ПредставлениеТипа КАК СТРОКА(150)),
	|	т.Ссылка
	|ИЗ
	|	втВидыСубконтоНСБУ КАК т
	|ГДЕ
	|	т.ПредставлениеТипа ПОДОБНО ""%1""";

КонецФункции

Функция Шаблон_втВидыСубконто()
	
	Возврат
	"ВЫБРАТЬ
	|	МАКСИМУМ(вт.Роль) КАК Роль,
	|	МАКСИМУМ(вт.ВидСубконто.Код) КАК Приоритет,
	|	МАКСИМУМ(вт.ПредставлениеТипа) КАК ПредставлениеТипа,
	|	КОЛИЧЕСТВО(вт.ВидСубконто) КАК ДублиРолей,
	|	вт.ВидСубконто КАК ВидСубконто
	|ПОМЕСТИТЬ втВидыСубконто
	|ИЗ
	|	ТаблицаВидыСубконто КАК вт
	|
	|СГРУППИРОВАТЬ ПО
	|	вт.ВидСубконто
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидСубконто";

КонецФункции

