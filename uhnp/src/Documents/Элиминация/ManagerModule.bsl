Функция ТекстЗапроса_втПоказатели(НомераТаблиц)

	НомераТаблиц.Вставить("втПоказатели", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	т.Показатель КАК Показатель,
	|	МАКСИМУМ(т.НомерРегистра) КАК НомерРегистра,
	|	МАКСИМУМ(т.Роль1) КАК Роль1,
	|	МАКСИМУМ(т.Роль2) КАК Роль2,
	|	МАКСИМУМ(т.Роль3) КАК Роль3,
	|	МАКСИМУМ(т.Роль4) КАК Роль4,
	|	МАКСИМУМ(т.Роль5) КАК Роль5,
	|	МАКСИМУМ(т.Роль6) КАК Роль6,
	|	МАКСИМУМ(т.ПредставлениеТипа1) КАК ПредставлениеТипа1,
	|	МАКСИМУМ(т.ПредставлениеТипа2) КАК ПредставлениеТипа2,
	|	МАКСИМУМ(т.ПредставлениеТипа3) КАК ПредставлениеТипа3,
	|	МАКСИМУМ(т.ПредставлениеТипа4) КАК ПредставлениеТипа4,
	|	МАКСИМУМ(т.ПредставлениеТипа5) КАК ПредставлениеТипа5,
	|	МАКСИМУМ(т.ПредставлениеТипа6) КАК ПредставлениеТипа6,
	|	МАКСИМУМ(т.ВидАналитики1) КАК ВидАналитики1,
	|	МАКСИМУМ(т.ВидАналитики2) КАК ВидАналитики2,
	|	МАКСИМУМ(т.ВидАналитики3) КАК ВидАналитики3,
	|	МАКСИМУМ(т.ВидАналитики4) КАК ВидАналитики4,
	|	МАКСИМУМ(т.ВидАналитики5) КАК ВидАналитики5,
	|	МАКСИМУМ(т.ВидАналитики6) КАК ВидАналитики6
	|ПОМЕСТИТЬ втПоказатели
	|ИЗ
	|	втПоказателиРазделовВГО КАК т
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Показатель
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Показатель,
	|	НомерРегистра";

