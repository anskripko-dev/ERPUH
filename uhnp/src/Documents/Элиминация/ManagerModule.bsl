Процедура ДобавитьЗапросы_втОборотыТрансляции(ТекстЗапроса, НомераТаблиц, Запрос)
	
	Процессор = МСФОЗапросыУХ.НовыйПроцессорТрансляцииЗапросом(Запрос.Параметры.ШаблонТрансляции);
	
	//Процессор.ПутиИсключения.Добавить("Регистратор");
	Процессор.ИмяТаблицыИсточника = "ТаблицаИсточник";
	
	Процессор.СтороныТрансляции.Вставить("Трансляция", Истина); //Истина=Дебет
	
	Процессор.ПоляИсточники.Вставить("Регистратор", "Версия.Регистратор");
	Процессор.ПоляИсточники.Вставить("Организация", "ОрганизацияОтчета");

	ПараметрыЗамены = МСФОЗапросыУХ.ПодготовитьЗаменыПараметровТрансляции(Процессор);
	
	МСФОЗапросыУХ.ДобавитьЗапросыТрансляции(ТекстЗапроса, НомераТаблиц, ТекстЗапроса_СчетаДляТрансляции());
	Шаблон = ТекстЗапроса_втЗначенияПоказателейОттранслированные(НомераТаблиц);
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ЗаменитьПараметрыЗапроса(Шаблон, ПараметрыЗамены));

КонецПроцедуры

Функция ТекстЗапроса_втЗначенияПоказателейОттранслированные(НомераТаблиц)

	НомераТаблиц.Вставить("втЗначенияПоказателейОттранслированные", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаИсточник.Показатель КАК Показатель,
	|	&Трансляция_Подразделение КАК Подразделение,
	|	&Трансляция_НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	&Трансляция_Субконто1 КАК Субконто1,
	|	&Трансляция_Субконто2 КАК Субконто2,
	|	&Трансляция_Субконто3 КАК Субконто3,
	|	ЕСТЬNULL(втТрансляция.СчетПриемник, ТаблицаИсточник.СчетБД) КАК СчетБД,
	|	ТаблицаИсточник.СчетБД КАК СчетИсточник
	|ПОМЕСТИТЬ втЗначенияПоказателейОттранслированные
	|ИЗ
	|	втЗначенияПоказателей КАК ТаблицаИсточник
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПравилаПолей КАК втТрансляция
	|		ПО ТаблицаИсточник.СчетБД = втТрансляция.СчетИсточник
	|			И (&Трансляция_Отбор)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаИсточник.Показатель";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаИсточник.Показатель КАК Показатель", "*");
	
	Возврат ТекстЗапроса; 
	
КонецФункции

#КонецОбласти

#Область Маржа

Функция ТекстЗапроса_втСебестоимость(НомераТаблиц)
	
	//-себестоимость может быть в разрезе контрагентов или нет
	//-себестоимость может быть в разрезе видов выручки(номенклатуры, или других активов) или нет
	//-одна ФСД себестоимости может использоваться в нескольких разделах сверки
	//-по одному виду выручки может быть разные аналитики
	
	//ПокупательРасчетМаржи, ВидВыручкиРасчетМаржи = если не используется, то "NULL"
	
	НомераТаблиц.Вставить("втСебестоимостьПоРазделамВГО", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	втРазделыВГО.РазделВГО КАК РазделВГО,
	|	втЗначенияПоказателей.ОрганизацияОтчета КАК Продавец,
	|	втЗначенияПоказателей.ОрганизацияКонтрагент КАК ПокупательРасчетМаржи,
	|	втЗначенияПоказателей.ВидВыручкиВГО КАК ВидВыручкиРасчетМаржи,
	|	СУММА(втЗначенияПоказателей.Значение) КАК Себестоимость
	|ПОМЕСТИТЬ втСебестоимостьПоРазделамВГО
	|ИЗ
	|	втПоказателиРазделовВГО КАК втРазделыВГО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗначенияПоказателей КАК втЗначенияПоказателей
	|		ПО втРазделыВГО.Показатель = втЗначенияПоказателей.Показатель
	|			И (втРазделыВГО.ЭтоСебестоимостьПродавца)
	|
	|СГРУППИРОВАТЬ ПО
	|	втРазделыВГО.РазделВГО,
	|	втЗначенияПоказателей.ОрганизацияОтчета,
	|	втЗначенияПоказателей.ОрганизацияКонтрагент,
	|	втЗначенияПоказателей.ВидВыручкиВГО
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Продавец,
	|	РазделВГО,
	|	ПокупательРасчетМаржи,
	|	ВидВыручкиРасчетМаржи";

КонецФункции

//упрощенно: Маржа = (Выручка - Себестоимость) / Выручка
Функция ТекстЗапроса_втМаржа(НомераТаблиц)
	
	//Д=доходы(ФСД выручка продавца), Р=расходы(ФСД себестоимость продавца), П=показатель покупателя(ФСД закупки покупателя)
	//ФСД мб по Контрагенту(К), НоменклатурнойГруппе/ВидВыручки(НГ)
	//Аналитика	маржи:
	//а)П(НГ,К), Д(НГ,К), Р(НГ): по маржа НГ без К(Д(НГ), Р(НГ))
	//б)П(НГ,К), Д(НГ,К), Р(НГ,К): по маржа НГ+К
	//в)П(НГ,К), Д(НГ,К), Р(): по маржа общая(Д(-),Р(-))
	
	НомераТаблиц.Вставить("втМаржа", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	втРазделыВГО.РазделВГО КАК РазделВГО,
	|	ВыручкаПродавца.ОрганизацияОтчета КАК Продавец,
	|	СебестоимостьПродавца.ПокупательРасчетМаржи КАК ПокупательРасчетМаржи,
	|	СебестоимостьПродавца.ВидВыручкиРасчетМаржи КАК ВидВыручкиРасчетМаржи,
	|	ВЫБОР
	|		КОГДА СУММА(ВыручкаПродавца.Значение) <> 0
	|			ТОГДА (СУММА(ВыручкаПродавца.Значение) - МАКСИМУМ(СебестоимостьПродавца.Себестоимость)) / СУММА(ВыручкаПродавца.Значение)
	|	КОНЕЦ КАК Маржа
	|ПОМЕСТИТЬ втМаржа
	|ИЗ
	|	втЗначенияПоказателей КАК ВыручкаПродавца
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказателиРазделовВГО КАК втРазделыВГО
	|		ПО ВыручкаПродавца.Показатель = втРазделыВГО.Показатель
	|			И (втРазделыВГО.ЭтоЗапасыПокупателя)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСебестоимостьПоРазделамВГО КАК СебестоимостьПродавца
	|		ПО ВыручкаПродавца.ОрганизацияОтчета = СебестоимостьПродавца.Продавец
	|			И (втРазделыВГО.РазделВГО = СебестоимостьПродавца.РазделВГО)
	|			И (ВыручкаПродавца.ОрганизацияКонтрагент = ЕСТЬNULL(СебестоимостьПродавца.ПокупательРасчетМаржи, ВыручкаПродавца.ОрганизацияКонтрагент))
	|			И (ВыручкаПродавца.ВидВыручкиВГО = ЕСТЬNULL(СебестоимостьПродавца.ВидВыручкиРасчетМаржи, ВыручкаПродавца.ВидВыручкиВГО))
	|
	|СГРУППИРОВАТЬ ПО
	|	втРазделыВГО.РазделВГО,
	|	ВыручкаПродавца.ОрганизацияОтчета,
	|	СебестоимостьПродавца.ПокупательРасчетМаржи,
	|	СебестоимостьПродавца.ВидВыручкиРасчетМаржи
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Продавец,
	|	РазделВГО,
	|	ПокупательРасчетМаржи,
	|	ВидВыручкиРасчетМаржи";	

КонецФункции

#КонецОбласти

#Область ЗапросыДвижений

Функция ТекстЗапроса_Проводки(НомераТаблиц, ФормироватьПроводкиМСФО = Ложь)
	
	Если Ложь И ФормироватьПроводкиМСФО Тогда
		НомераТаблиц.Вставить("ТаблицаМСФО", НомераТаблиц.Количество());
	Иначе	
		НомераТаблиц.Вставить("ТаблицаПроводок", НомераТаблиц.Количество());
	КонецЕсли;
	
	Шаблон = """ + %1 + """;

	ДляКомментария = Новый Структура;
	ДляКомментария.Вставить("Показатель", 	СтрШаблон(Шаблон, "втПоказателиРазделовВГО.Показатель.Наименование"));
	ДляКомментария.Вставить("ВидОтчета", 	СтрШаблон(Шаблон, "втПоказателиРазделовВГО.Показатель.Владелец.Наименование"));
	ДляКомментария.Вставить("РазделСверки", СтрШаблон(Шаблон, "втПоказателиРазделовВГО.РазделВГО.Наименование"));
	ДляКомментария.Вставить("Организация", 	СтрШаблон(Шаблон, "т.ОрганизацияОтчета.Наименование"));
	ДляКомментария.Вставить("Контрагент", 	СтрШаблон(Шаблон, "т.ОрганизацияКонтрагент.Наименование"));
		
	ТекстЗапроса = Новый Массив;
    ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаСторноВыручкиПродавца(ДляКомментария));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаСторноЗакупкиПокупателя(ДляКомментария));
	ТекстЗапроса.Добавить(ТекстЗапроса_ПроводкаКорректировкаЗапасовПокупателя(ДляКомментария));
	
	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ");

КонецФункции

//Дт 000 Кт 90.01 = - ВыручкаПродавца
Функция ТекстЗапроса_ПроводкаСторноВыручкиПродавца(ДляКомментария)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	""&Комментарий"" КАК Событие,
	|	т.Валюта КАК ВалютаДт,
	|	т.Валюта КАК ВалютаКт,
	|	втРегламенты.Счет КАК СчетДт,
	|	т.Подразделение КАК ПодразделениеДт,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	&ТехСубконто1 КАК СубконтоДт1,
	|	&ТехСубконто2 КАК СубконтоДт2,
	|	&ТехСубконто3 КАК СубконтоДт3,
	|	т.СчетБД КАК СчетКт,
	|	т.Подразделение КАК ПодразделениеКт,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	т.Субконто1 КАК СубконтоКт1,
	|	т.Субконто2 КАК СубконтоКт2,
	|	т.Субконто3 КАК СубконтоКт3,
	|	втРегламенты.Счет КАК СчетДтИсточник,
	|	т.СчетИсточник КАК СчетКтИсточник,
	|	-т.ЗначениеВалюта КАК СуммаВВалютеДт,
	|	-т.ЗначениеВалюта КАК СуммаВВалютеКт,
	|	-т.Значение КАК СуммаВФункциональнойВалюте
	|ИЗ
	|	втЗначенияПоказателейОттранслированные КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказателиРазделовВГО КАК втПоказателиРазделовВГО
	|		ПО т.Показатель = втПоказателиРазделовВГО.Показатель
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРегламенты КАК втРегламенты
	|		ПО (ИСТИНА)
	|ГДЕ
	|	втПоказателиРазделовВГО.ЭтоПродавец 
	|	И т.ЭтоКонтрагентВГО";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТехСубконто1", Шаблон_СубконтоТехСчета(1));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТехСубконто2", Шаблон_СубконтоТехСчета(2));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТехСубконто3", Шаблон_СубконтоТехСчета(3));
	
	Комментарий = 
	НСтр("ru = 'Сторно выручки у продавца. 
	|Показатель выручки <[Показатель]> ([ВидОтчета]) из <[РазделСверки]>.
	|По <[Организация]> с <[Контрагент]>'", 
	ОбщегоНазначения.КодОсновногоЯзыка());
	
	Возврат СтрЗаменить(ТекстЗапроса, "&Комментарий", КомментарийПроводки(Комментарий, ДляКомментария));
	
КонецФункции

