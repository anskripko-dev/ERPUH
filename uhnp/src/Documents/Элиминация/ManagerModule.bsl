Функция ТекстЗапроса_Поместить(НомераТаблиц, ИмяТаблицы, ТекстЗапросаДляПомещения, ДопПоля = Неопределено)

	НомераТаблиц.Вставить(ИмяТаблицы, НомераТаблиц.Количество());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ 
	|	%1, 
	|	* 
	|ПОМЕСТИТЬ %2 
	|ИЗ 
	|	(%3) КАК %2";
	
	ДопПоля = ?(ЗначениеЗаполнено(ДопПоля), ДопПоля, "NULL");
	Возврат СтрШаблон(ТекстЗапроса, ДопПоля, ИмяТаблицы, ТекстЗапросаДляПомещения);
	
КонецФункции

