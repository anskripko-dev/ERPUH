Функция ТекстЗапроса_втРегламенты(НомераТаблиц)

	НомераТаблиц.Вставить("втРегламенты", НомераТаблиц.Количество());
	
	//**Документы.УчетнаяПолитикаМСФО.ЗаменитьФиксированныеСчетаУчетаБД(Запрос.Текст);

	Возврат 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	т.УправлениеПериодомСценария КАК УОП,
	|	т.Периоды КАК ПериодСценария,
	|	т.Сценарии КАК Сценарий,
	|	т.ВерсияРегламента КАК Регламент,
	|	т.ВерсияРегламента.ШаблонСверкиВГО КАК ШаблонСверкиВГО,
	|	т.ВерсияРегламента.ШаблонСверкиВГО.ВалютаИтогов КАК ВалютаВГО,
	|	Вид1.ВидСубконтоСсылка КАК ВидСубконто1,
	|	Вид2.ВидСубконтоСсылка КАК ВидСубконто2,
	|	Вид3.ВидСубконтоСсылка КАК ВидСубконто3,
	|	Роль1.Роль КАК Роль1,
	|	Роль2.Роль КАК Роль2,
	|	Роль3.Роль КАК Роль3,
	|	ТехСчет.ЗначениеЗаполненияСубконто1 КАК Субконто1,
	|	ТехСчет.ЗначениеЗаполненияСубконто2 КАК Субконто2,
	|	ТехСчет.ЗначениеЗаполненияСубконто3 КАК Субконто3,
	|	ТехСчет.Счет КАК Счет
	|ПОМЕСТИТЬ втРегламенты
	|ИЗ
	|	РегистрСведений.СтатусыПериодовСценариев КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныСверкиВГО.ТехническиеСчета КАК ТехСчет
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК Вид1
	|			ПО ТехСчет.Счет = Вид1.Ссылка
	|				И (Вид1.НомерСтроки = 1)
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК Вид2
	|			ПО ТехСчет.Счет = Вид2.Ссылка
	|				И (Вид2.НомерСтроки = 2)
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК Вид3
	|			ПО ТехСчет.Счет = Вид3.Ссылка
	|				И (Вид3.НомерСтроки = 3)
	|			ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Роль1
	|			ПО (Вид1.ВидСубконтоСсылка = Роль1.ВидСубконто)
	|			ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Роль2
	|			ПО (Вид2.ВидСубконтоСсылка = Роль2.ВидСубконто)
	|			ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Роль3
	|			ПО (Вид3.ВидСубконтоСсылка = Роль3.ВидСубконто)
	|		ПО т.ВерсияРегламента.ШаблонСверкиВГО = ТехСчет.Ссылка
	|			И (ТехСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыТехническихСчетовДляСверкиЭлиминации.СчетЭлиминации))
	|ГДЕ
	|	т.Периоды В ИЕРАРХИИ(&ПериодОтчета)
	|	И т.Сценарии = &Сценарий";		

КонецФункции

Функция ТекстЗапроса_втРазделыВГО(НомераТаблиц)

	НомераТаблиц.Вставить("втРазделыВГО", НомераТаблиц.Количество());	
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК РазделВГО,
	|	т.ПорогСущественности КАК ПорогСущественности,
	|	т.ВидЗначения КАК ВидКурса,
	|	т.ИсточникДанныхФСДЗакупки КАК ИдЗакупкиПокупателя,
	|	т.ИсточникДанныхФСДСебестоимостьПродаж КАК ИдСебестоимостьПродавца,
	|	т.ИсточникДанныхФСДСебестоимостьПродаж <> ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхДляРасчетов.ПустаяСсылка) КАК ЕстьЗапасы,
	|	т.ГруппаРаскрытия КАК ГруппаРаскрытия
	|ПОМЕСТИТЬ втРазделыВГО
	|ИЗ
	|	Справочник.РазделыСверкиВГО КАК т
	|ГДЕ
	|	НЕ т.ПометкаУдаления
	|	И т.Владелец В
	|			(ВЫБРАТЬ
	|				т.ШаблонСверкиВГО
	|			ИЗ
	|				втРегламенты КАК т)";
	
КонецФункции  

#КонецОбласти

#Область ПоказателиЗПО

Функция ТекстЗапроса_втИдРазделовВГО(НомераТаблиц)

	//РазделыСверкиВГО.ИсточникиДанных.ИсточникДанных
	//ИсточникДанныхФСДЗакупки
	//ИсточникДанныхФСДСебестоимостьПродаж

	НомераТаблиц.Вставить("втИдРазделовВГО", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	втРазделыВГО.РазделВГО КАК РазделВГО,
	|	т.СпособОпределенияНаправленияУчета = ЗНАЧЕНИЕ(Перечисление.СпособОпределенияНаправленияУчета.ТолькоКредит)
	|		ИЛИ НЕ ПоЗнакуОперации.Дебитор КАК ЭтоПродавец,
	|	т.СпособОпределенияНаправленияУчета = ЗНАЧЕНИЕ(Перечисление.СпособОпределенияНаправленияУчета.ТолькоДебет)
	|		ИЛИ ПоЗнакуОперации.Дебитор КАК ЭтоПокупатель,
	|	ЛОЖЬ КАК ЭтоСебестоимостьПродавца,
	|	ЛОЖЬ КАК ЭтоЗапасыПокупателя,
	|	т.ИсточникДанных.Код КАК КодИД,
	|	т.ИсточникДанных.ГруппаРаскрытияОтбор КАК ГруппаРаскрытияОтбор,
	|	т.ИсточникДанных КАК ИсточникДанных
	|ПОМЕСТИТЬ втИдРазделовВГО
	|ИЗ
	|	Справочник.РазделыСверкиВГО.ИсточникиДанных КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРазделыВГО КАК втРазделыВГО
	|		ПО т.Ссылка = втРазделыВГО.РазделВГО
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ИСТИНА КАК Дебитор
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ЛОЖЬ) КАК ПоЗнакуОперации
	|		ПО (т.СпособОпределенияНаправленияУчета = ЗНАЧЕНИЕ(Перечисление.СпособОпределенияНаправленияУчета.ПоЗнакуОперации))
	|ГДЕ
	|	ВЫБОР
	|			КОГДА втРазделыВГО.ЕстьЗапасы
	|				ТОГДА НЕ(т.СпособОпределенияНаправленияУчета = ЗНАЧЕНИЕ(Перечисление.СпособОпределенияНаправленияУчета.ТолькоДебет)
	|							ИЛИ ПоЗнакуОперации.Дебитор)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.РазделВГО,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ИСТИНА,
	|	ЛОЖЬ,
	|	т.ИдСебестоимостьПродавца.Код,
	|	т.ИдСебестоимостьПродавца.ГруппаРаскрытияОтбор КАК ГруппаРаскрытия,
	|	т.ИдСебестоимостьПродавца
	|ИЗ
	|	втРазделыВГО КАК т
	|ГДЕ
	|	т.ЕстьЗапасы
	|	И т.ИдСебестоимостьПродавца <> ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхДляРасчетов.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.РазделВГО,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ИСТИНА,
	|	т.ИдЗакупкиПокупателя.Код,
	|	т.ИдЗакупкиПокупателя.ГруппаРаскрытияОтбор КАК ГруппаРаскрытия,
	|	т.ИдЗакупкиПокупателя
	|ИЗ
	|	втРазделыВГО КАК т
	|ГДЕ
	|	т.ЕстьЗапасы
	|	И т.ИдЗакупкиПокупателя <> ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхДляРасчетов.ПустаяСсылка)";
	
КонецФункции

Функция ТекстЗапроса_втПоказателиРазделовВГО(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПоказателиРазделовВГО", НомераТаблиц.Количество());
    	
	Возврат
	"ВЫБРАТЬ
	|	втИдРазделовВГО.РазделВГО КАК РазделВГО,
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор КАК ГруппаРаскрытияОтбор,
	|	втИдРазделовВГО.ИсточникДанных КАК ИсточникДанных,
	|	втИдРазделовВГО.ЭтоПродавец КАК ЭтоПродавец,
	|	втИдРазделовВГО.ЭтоПокупатель КАК ЭтоПокупатель,
	|	втИдРазделовВГО.ЭтоСебестоимостьПродавца КАК ЭтоСебестоимостьПродавца,
	|	втИдРазделовВГО.ЭтоЗапасыПокупателя КАК ЭтоЗапасыПокупателя,
	|	ВЫБОР ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|		КОГДА втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики1
	|			ТОГДА 0
	|		КОГДА втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики2
	|			ТОГДА 1
	|		КОГДА втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики3
	|			ТОГДА 2
	|		КОГДА втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики4
	|			ТОГДА 3
	|		КОГДА втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики5
	|			ТОГДА 4
	|		КОГДА втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики6
	|			ТОГДА 5
	|		ИНАЧЕ 6
	|	КОНЕЦ КАК НомерРегистра,
	|	Вид1.Роль КАК Роль1,
	|	Вид2.Роль КАК Роль2,
	|	Вид3.Роль КАК Роль3,
	|	Вид4.Роль КАК Роль4,
	|	Вид5.Роль КАК Роль5,
	|	Вид6.Роль КАК Роль6,	
	|	Вид1.ПредставлениеТипа КАК ПредставлениеТипа1,
	|	Вид2.ПредставлениеТипа КАК ПредставлениеТипа2,
	|	Вид3.ПредставлениеТипа КАК ПредставлениеТипа3,
	|	Вид4.ПредставлениеТипа КАК ПредставлениеТипа4,
	|	Вид5.ПредставлениеТипа КАК ПредставлениеТипа5,
	|	Вид6.ПредставлениеТипа КАК ПредставлениеТипа6,
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики1 КАК ВидАналитики1,
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики2 КАК ВидАналитики2,
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики3 КАК ВидАналитики3,
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики4 КАК ВидАналитики4,
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики5 КАК ВидАналитики5,
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор.ВидАналитики6 КАК ВидАналитики6,
	|	ПоказателиОтчетов.Владелец КАК ВидОтчета,
	|	ПоказателиОтчетов.Ссылка КАК Показатель
	|ПОМЕСТИТЬ втПоказателиРазделовВГО
	|ИЗ
	|	втИдРазделовВГО КАК втИдРазделовВГО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|		ПО втИдРазделовВГО.ГруппаРаскрытияОтбор = ПоказателиОтчетов.ГруппаРаскрытия
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Вид1
	|		ПО (ПоказателиОтчетов.ГруппаРаскрытия.ВидАналитики1 = Вид1.ВидСубконто)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Вид2
	|		ПО (ПоказателиОтчетов.ГруппаРаскрытия.ВидАналитики2 = Вид2.ВидСубконто)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Вид3
	|		ПО (ПоказателиОтчетов.ГруппаРаскрытия.ВидАналитики3 = Вид3.ВидСубконто)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Вид4
	|		ПО (ПоказателиОтчетов.ГруппаРаскрытия.ВидАналитики4 = Вид4.ВидСубконто)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Вид5
	|		ПО (ПоказателиОтчетов.ГруппаРаскрытия.ВидАналитики5 = Вид5.ВидСубконто)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВидыСубконто КАК Вид6
	|		ПО (ПоказателиОтчетов.ГруппаРаскрытия.ВидАналитики6 = Вид6.ВидСубконто)
	|ГДЕ
	|	втИдРазделовВГО.ГруппаРаскрытияОтбор <> ЗНАЧЕНИЕ(Справочник.ГруппыРаскрытия.ПустаяСсылка)
	|	И ПоказателиОтчетов.Код В
	|			(ВЫБРАТЬ
	|				т.Поле КАК КодПоказателя
	|			ИЗ
	|				Справочник.ИсточникиДанныхДляРасчетов.ПравилаИспользованияПолейЗапроса КАК т
	|			ГДЕ
	|				т.Ссылка = втИдРазделовВГО.ИсточникДанных
	|				И т.АналитикаОперанда = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Показатель,
	|	ЭтоПокупатель";

