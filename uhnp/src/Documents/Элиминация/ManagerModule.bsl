Функция КомментарийПроводки(Комментарий, ДляКомментария)
	Возврат СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Комментарий, ДляКомментария);
КонецФункции

Функция Шаблон_СубконтоТехСчета(НомерСубконто = 1)
	
	//**контрагент
	Результат =
	"ВЫБОР
	|		КОГДА втРегламенты.Субконто%1 <> НЕОПРЕДЕЛЕНО
	|			ТОГДА втРегламенты.Субконто%1
	|		КОГДА втРегламенты.Роль%1 = ""ОрганизацияКонтрагент""
	|			ТОГДА т.ОрганизацияОтчета
	|		КОГДА втРегламенты.Роль%1 = ""РазделВГО""
	|			ТОГДА втПоказателиРазделовВГО.РазделВГО
	|		КОГДА втРегламенты.Роль%1 = ""ПоказательОтчета""
	|			ТОГДА т.Показатель
	|	КОНЕЦ";
	
	Возврат СтрШаблон(Результат, НомерСубконто);

КонецФункции

