//Дт 10.01 Кт 000 = - ЗакупкаПокупателя * Маржа
Функция ТекстЗапроса_ПроводкаКорректировкаЗапасовПокупателя(ДляКомментария)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	""&Комментарий"" КАК Событие,
	|	т.Валюта КАК ВалютаДт,
	|	т.Валюта КАК ВалютаКт,
	|	т.СчетБД КАК СчетДт,
	|	т.Подразделение КАК ПодразделениеДт,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	т.Аналитика1 КАК СубконтоДт1,
	|	т.Аналитика2 КАК СубконтоДт2,
	|	т.Аналитика3 КАК СубконтоДт3,
	|	втРегламенты.Счет КАК СчетКт,
	|	т.Подразделение КАК ПодразделениеКт,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	&ТехСубконто1 КАК СубконтоКт1,
	|	&ТехСубконто2 КАК СубконтоКт2,
	|	&ТехСубконто3 КАК СубконтоКт3,
	|	т.СчетИсточник КАК СчетДтИсточник,
	|	втРегламенты.Счет КАК СчетКтИсточник,
	|	-т.ЗначениеВалюта * втМаржа.Маржа КАК СуммаВВалютеДт,
	|	-т.ЗначениеВалюта * втМаржа.Маржа КАК СуммаВВалютеКт,
	|	-т.Значение * втМаржа.Маржа КАК Значение
	|ИЗ
	|	втЗначенияПоказателейОттранслированные КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказателиРазделовВГО КАК втПоказателиРазделовВГО
	|		ПО т.Показатель = втПоказателиРазделовВГО.Показатель
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРегламенты КАК втРегламенты
	|		ПО (ИСТИНА)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаржа КАК втМаржа
	|		ПО т.Показатель = втМаржа.Продавец
	|			И (т.ОрганизацияКонтрагент = ЕСТЬNULL(втМаржа.ПокупательРасчетМаржи, т.ОрганизацияКонтрагент))
	|			И (т.ВидВыручкиВГО = ЕСТЬNULL(втМаржа.ВидВыручкиРасчетМаржи, т.ВидВыручкиВГО))
	|ГДЕ
	|	втПоказателиРазделовВГО.ЭтоПокупатель
	|	И т.ЭтоКонтрагентВГО";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТехСубконто1", Шаблон_СубконтоТехСчета(1));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТехСубконто2", Шаблон_СубконтоТехСчета(2));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТехСубконто3", Шаблон_СубконтоТехСчета(3));
	
	Комментарий = 
	НСтр("ru = 'Корректировка закупки у покупателя на маржу продавца. 
	|Показатель закупки <[Показатель]> ([ВидОтчета]) из <[РазделСверки]>.
	|По <[Организация]> с <[Контрагент]>'", 
	ОбщегоНазначения.КодОсновногоЯзыка());
	
	Возврат СтрЗаменить(ТекстЗапроса, "&Комментарий", КомментарийПроводки(Комментарий, ДляКомментария));
	
