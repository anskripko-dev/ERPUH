Функция ТекстЗапроса_РегистраторыИсключения(НомераТаблиц)

	НомераТаблиц.Вставить("РегистраторыИсключения", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ РегистраторыИсключения
	|ИЗ
	|	Документ.ТрансформационнаяКорректировка КАК т
	|ГДЕ
	|	т.Сценарий = &Сценарий
	|	И т.Организация В(&Организация)
	|	И т.ПериодОтчета = &ПериодОтчета
	|	И т.ИсходныйДокумент ССЫЛКА Документ.Элиминация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка";

КонецФункции

Функция ТекстЗапроса_втВерсии(НомераТаблиц)
	
	// Элиминация ДКЗ в валюте Группы, т.к. в Группу попадает из(НЕ т.ЗаписьВДополнительнойВалюте)
	// сообщенная НРП в валюте отчета, чтобы пересчитать в валюту группы далее	 
	НомераТаблиц.Вставить("втВерсии", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	т.Ссылка КАК Версия,
	|	т.Регистратор КАК Регистратор,
	|	т.ВидОтчета КАК ВидОтчета,
	|	т.Валюта = &ФункциональнаяВалюта КАК ЭтоВО,
	|	т.ОсновнаяВерсия КАК ЭтоФВ,
	|	т.Организация КАК Организация
	|ПОМЕСТИТЬ втВерсии
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК т
	|ГДЕ
	|	т.Сценарий = &Сценарий
	|	И т.ВидОтчета В
	|			(ВЫБРАТЬ
	|				т.ВидОтчета
	|			ИЗ
	|				втПоказателиРазделовВГО КАК т)
	|	И т.Организация В(&ОрганизацииПериметра)
	|	И НЕ т.Организация.ЭлиминирующаяОрганизация
	|	И т.ПериодОтчета В (&ПериодОтчета)
	|	И НЕ т.ЧерноваяВерсия
	|	И НЕ т.Регистратор В
	|				(ВЫБРАТЬ
	|					т.Ссылка
	|				ИЗ
	|					РегистраторыИсключения КАК т)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	т.Ссылка,
	|	ЭтоФВ";	

КонецФункции

Функция ТекстЗапроса_втЗначенияПоказателейБезСубконто(НомераТаблиц)
	
	НомераТаблиц.Вставить("втЗначенияПоказателейБезСубконто", НомераТаблиц.Количество());
	
	ТекстЗапроса = Новый Массив;
	
	//ЗПО по Номерам: НомерРегистра, НомерКонтрагентИлиОрганизацияИлиНет, НомерСчет(не нужен для маржи)
	
	Шаблон = ШаблонЗапроса_ЗначенияПоказателейБезСубконто();
	Шаблон_Роль = Шаблон_Аналитика();
	Шаблон_Кор = Шаблон_АналитикаОбр();
		
	ПоляЗамены = Новый Структура(
		"ОрганизацияКонтрагент, Контрагент, ВидВыручкиВГО, Валюта, 
		|СчетБД, Подразделение, НаправлениеДеятельности,
		|КорСчетБД, КорПодразделение, КорНаправлениеДеятельности");
	ПоляКор = Новый Структура("КорСчетБД, КорПодразделение, КорНаправлениеДеятельности", Истина, Истина, Истина);
	
	Для каждого ПолеЗамены Из ПоляЗамены Цикл
		
		ЗаменяемПараметр = "&" + ПолеЗамены.Ключ;
		ТекШаблон = ?(ПоляКор.Свойство(ПолеЗамены.Ключ), Шаблон_Кор, Шаблон_Роль);
		НаРольПоШаблону = СтрШаблон(ТекШаблон, """" + ПолеЗамены.Ключ + """", "п.Роль");
		Шаблон = СтрЗаменить(Шаблон, ЗаменяемПараметр, НаРольПоШаблону);	
	
	КонецЦикла;
    
	Для НомерЗПО = 1 По 6 Цикл
		
		ШаблонЗПО = Строка(Шаблон);//копируем
		ШаблонЗПО = СтрЗаменить(ШаблонЗПО, "ЗначенияПоказателейОтчетов6", "ЗначенияПоказателейОтчетов" + НомерЗПО);
		ШаблонЗПО = СтрЗаменить(ШаблонЗПО, "&НомерРегистра", НомерЗПО);
		
		Для НомерАналитики = 1 По 6 Цикл
			Если НомерАналитики > НомерЗПО Тогда
				ШаблонЗПО = СтрЗаменить(ШаблонЗПО, "т.Аналитика" + НомерАналитики, "NULL");
			КонецЕсли;
		КонецЦикла;
		ТекстЗапроса.Добавить(ШаблонЗПО);
		
		Шаблон = СтрЗаменить(Шаблон, "ПОМЕСТИТЬ втЗначенияПоказателейБезСубконто", "");//
		
	КонецЦикла;
	
	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ") + " ИНДЕКСИРОВАТЬ ПО Показатель";

КонецФункции
 
Функция ШаблонЗапроса_ЗначенияПоказателейБезСубконто()
	
	//ОрганизацияВГО мб: задана как "Контрагент.ОрганизационнаяЕдиница", и как "Организация"
	//ЦФО мб: "Контрагент.ОрганизационнаяЕдиница", и как "Организация"
	
	Возврат
	"ВЫБРАТЬ
	|	Версии.Организация КАК ОрганизацияОтчета,
	|	ЕСТЬNULL(МАКСИМУМ(ВЫРАЗИТЬ(&Контрагент КАК Справочник.Контрагенты).ОрганизационнаяЕдиница), МАКСИМУМ(&ОрганизацияКонтрагент)) КАК ОрганизацияКонтрагент,
	|	ЕСТЬNULL(МАКСИМУМ(&Валюта), МАКСИМУМ(т.АналитикаВалюта)) КАК Валюта,
	|	МАКСИМУМ(&СчетБД) КАК СчетБД,	
	|	МАКСИМУМ(&ВидВыручкиВГО) КАК ВидВыручкиВГО,
	|	МАКСИМУМ(&Подразделение) КАК Подразделение,
	|	МАКСИМУМ(&НаправлениеДеятельности) КАК НаправлениеДеятельности,
	|	МАКСИМУМ(&КорСчетБД) КАК КорСчетБД,
	|	МАКСИМУМ(&КорПодразделение) КАК КорПодразделение,
	|	МАКСИМУМ(&КорНаправлениеДеятельности) КАК КорНаправлениеДеятельности,
	|	МАКСИМУМ(т.Версия) КАК Версия,
	|	т.Показатель КАК Показатель,
	|	т.АналитикаВалюта КАК АналитикаВалюта,
	|	т.Аналитика1 КАК Аналитика1,
	|	т.Аналитика2 КАК Аналитика2,
	|	т.Аналитика3 КАК Аналитика3,
	|	т.Аналитика4 КАК Аналитика4,
	|	т.Аналитика5 КАК Аналитика5,
	|	т.Аналитика6 КАК Аналитика6,
	|	СУММА(т.ЗначениеВалюта) КАК ЗначениеВалюта,
	|	СУММА(т.Значение) КАК Значение
	|ПОМЕСТИТЬ втЗначенияПоказателейБезСубконто
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов6 КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказатели КАК п
	|		ПО т.Показатель = п.Показатель
	|			И (п.НомерРегистра = &НомерРегистра)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВерсии КАК Версии
	|		ПО т.Версия = Версии.Версия
	|		И Версии.ЭтоВО
	|ГДЕ
	|	НЕ т.ИтоговоеЗначение
	|
	|СГРУППИРОВАТЬ ПО
	|	Версии.Организация,
	|	т.АналитикаВалюта,
	|	т.Аналитика1,
	|	т.Аналитика2,
	|	т.Аналитика3,
	|	т.Аналитика4,
	|	т.Аналитика5,
	|	т.Аналитика6,
	|	т.Показатель";

КонецФункции

