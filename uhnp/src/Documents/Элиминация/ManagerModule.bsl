Функция ПодготовитьПараметрыПроведения(ДополнительныеСвойства, Отказ, ФормироватьПроводкиМСФО = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	ЗаполнитьПараметрыЗапроса(Запрос, Отказ);
	
	Если Отказ Тогда
		Возврат ДополнительныеСвойства;
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = Новый Массив;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втВидыСубконтоНСБУ(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втВидыСубконто(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_РегистраторыИсключения(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втРегламенты(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втРазделыВГО(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втИдРазделовВГО(НомераТаблиц));
	
	#Область ПолучениеЗПО
	ТекстЗапроса.Добавить(ТекстЗапроса_втПоказателиРазделовВГО(НомераТаблиц)); 
	ТекстЗапроса.Добавить(ТекстЗапроса_втПоказатели(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втВерсии(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втЗначенияПоказателейБезСубконто(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втЗначенияПоказателей(НомераТаблиц));
	#КонецОбласти
	
	#Область Маржа
	ТекстЗапроса.Добавить(ТекстЗапроса_втСебестоимость(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втМаржа(НомераТаблиц));
	#КонецОбласти
	
	#Область Трансляция
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаПоказателей(НомераТаблиц));
	ДобавитьЗапросы_втОборотыТрансляции(ТекстЗапроса, НомераТаблиц, Запрос);
	#КонецОбласти
	
	#Область Движения
	ТекстЗапроса.Добавить(ТекстЗапроса_Проводки(НомераТаблиц, Запрос.Параметры.ФормироватьПроводкиМСФО));
	//** ошибки
	//** элимПок
	#КонецОбласти
	
	ТекстРазделителя = ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета();
	Запрос.Текст = СтрСоединить(ТекстЗапроса, ТекстРазделителя);
	Возврат ПолучитьПараметрыПроведения(ДополнительныеСвойства, Запрос, НомераТаблиц);
		
КонецФункции

Процедура ЗаполнитьПараметрыЗапроса(Запрос, Отказ)
	
	Ссылка = Запрос.Параметры.Ссылка;
	ИменаДопРеквизитов = "ПериодОтчета, ДатаНачала, ДатаОкончания, ВидОтчета";
	Реквизиты = МСФОУХ.РеквизитыДокумента(Запрос, ИменаДопРеквизитов, "ПериодОтчета", Отказ);
	
	Отбор = Новый Соответствие;
	Отбор.Вставить("Организация", 			Реквизиты.Организация);
	Отбор.Вставить("Сценарий", 				Реквизиты.Сценарий);
	Отбор.Вставить("ПериодОтчета", 			Реквизиты.ПериодОтчета);
	Отбор.Вставить("ЭффективнаяДоляРасчет", 100);//** только ВГО
	
	ПоляВыборки = Новый Структура("ЭффективнаяДоляРасчет, ВерсияРегламента");
	Периметр = УправлениеРабочимиПроцессамиУХ.ПолучитьДанныеРегламента(Отбор, ПоляВыборки);
	Если Периметр.Количество() = 0 Тогда
		Сообщение = НСтр("ru = 'Не удалось определить организации периметра для элиминации по периоду и сценарию'");
		СообщитьПользователю(Сообщение, Ссылка, Отказ);
	КонецЕсли;
	
	ТабПериметр = Неопределено;
	//Орг,ШаблонТрансляции,ФВ,УП,Курсы

	ШаблонВГО = ПредопределенноеЗначение("Справочник.ШаблоныСверкиВГО.ПустаяСсылка");
	Если Периметр.Количество() Тогда
		ШаблонВГО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Периметр[0].ВерсияРегламента, "ШаблонСверкиВГО");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",		Реквизиты.Организация);
	Запрос.УстановитьПараметр("Сценарий",			Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("ПериодОтчета",		Реквизиты.ПериодОтчета);
	
	Запрос.УстановитьПараметр("ПланСчетовМСФО",			Реквизиты.ПланСчетовМСФО);
	Запрос.УстановитьПараметр("ВидОтчета",				Реквизиты.ВидОтчета);
	Запрос.УстановитьПараметр("ФункциональнаяВалюта",	Реквизиты.ФункциональнаяВалюта);
	Запрос.УстановитьПараметр("ВалютаПредставления",	Реквизиты.ВалютаПредставления);
	Запрос.УстановитьПараметр("УчетнаяПолитика",		Реквизиты.УчетнаяПолитика); // для фикс. счетов
	
	Запрос.УстановитьПараметр("ОрганизацииПериметра",	Периметр.ВыгрузитьКолонку("ИндивидуальнаяОрганизация"));
	
	Запрос.УстановитьПараметр("РежимОтладки",			ОбщегоНазначения.РежимОтладки());
	Запрос.УстановитьПараметр("ШаблонВГО",				ШаблонВГО);
	Запрос.УстановитьПараметр("ШаблонТрансляции",		ШаблонВГО.ТрансляцияПлановСчетовНаМСФОДляЭлиминации.ВыгрузитьКолонку("ШаблонТрансляцииСчетов"));
	
	//Запрос.УстановитьПараметр("ОрганизацияКонсолидирующая",	Реквизиты.КонсолидирующаяОрганизация);
	//Запрос.УстановитьПараметр("ВалютаОтчетности",			Реквизиты.ВалютаПредставления);
	//Запрос.УстановитьПараметр("ДатаОкончанияПериода",		Реквизиты.ДатаОкончания);

КонецПроцедуры

