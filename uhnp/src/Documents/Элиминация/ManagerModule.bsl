Функция ПолучитьПараметрыПроведения(ДополнительныеСвойства, Запрос, НомераТаблиц)
	
	ДополнительныеСвойства.ДляПроведения.Вставить("Реквизиты", Запрос.Параметры);
	Если Запрос.Параметры.РежимОтладки Тогда
		ДополнительныеСвойства.ДляПроведения.Вставить(
			"МенеджерВременныхТаблиц", Запрос.МенеджерВременныхТаблиц);
	КонецЕсли;
	
	ПроведениеСерверУХ.ДополнитьТаблицамиИзПакетаЗапросов(
		ДополнительныеСвойства.ТаблицыДляДвижений, Запрос, НомераТаблиц);
	
	Возврат ДополнительныеСвойства;

КонецФункции

