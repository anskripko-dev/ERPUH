Функция ШаблонЗапроса_ЗначенияПоказателей()
	
	Возврат 
	"ВЫБРАТЬ
	|	т.ОрганизацияОтчета КАК ОрганизацияОтчета,
	|	т.ОрганизацияКонтрагент КАК ОрганизацияКонтрагент,
	|	т.ОрганизацияКонтрагент В (&ОрганизацииПериметра) КАК ЭтоКонтрагентВГО,
	|	т.ВидВыручкиВГО КАК ВидВыручкиВГО,
	|	т.Валюта КАК Валюта,
	|	т.СчетБД КАК СчетБД,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	т.КорСчетБД КАК КорСчетБД,
	|	т.КорПодразделение КАК КорПодразделение,
	|	т.КорНаправлениеДеятельности КАК КорНаправлениеДеятельности,
	|	т.Версия КАК Версия,
	|	т.Показатель КАК Показатель,
	|	т.АналитикаВалюта КАК АналитикаВалюта,
	|	т.Аналитика1 КАК Аналитика1,
	|	т.Аналитика2 КАК Аналитика2,
	|	т.Аналитика3 КАК Аналитика3,
	|	т.Аналитика4 КАК Аналитика4,
	|	т.Аналитика5 КАК Аналитика5,
	|	т.Аналитика6 КАК Аналитика6,
	|	&Субконто1 КАК Субконто1,
	|	&Субконто1 КАК Субконто2,
	|	&Субконто1 КАК Субконто3,
	|	&КорСубконто1 КАК КорСубконто1,
	|	&КорСубконто2 КАК КорСубконто2,
	|	&КорСубконто3 КАК КорСубконто3,
	|	т.ЗначениеВалюта КАК ЗначениеВалюта,
	|	т.Значение КАК Значение
	|ПОМЕСТИТЬ втЗначенияПоказателей
	|ИЗ
	|	втЗначенияПоказателейБезСубконто КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПоказатели КАК п
	|		ПО т.Показатель = п.Показатель
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК Счет1
	|		ПО т.СчетБД = Счет1.Ссылка
	|			И (Счет1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК Счет2
	|		ПО т.СчетБД = Счет2.Ссылка
	|			И (Счет2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК Счет3
	|		ПО т.СчетБД = Счет3.Ссылка
	|			И (Счет3.НомерСтроки = 3)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК КорСчет1
	|		ПО т.КорСчетБД = КорСчет1.ВидСубконтоСсылка
	|			И (КорСчет1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК КорСчет2
	|		ПО т.КорСчетБД = КорСчет2.ВидСубконтоСсылка
	|			И (КорСчет2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК КорСчет3
	|		ПО т.КорСчетБД = КорСчет3.ВидСубконтоСсылка
	|			И (КорСчет3.НомерСтроки = 3)
	|ГДЕ
	|	т.Значение <> 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Показатель";

КонецФункции

