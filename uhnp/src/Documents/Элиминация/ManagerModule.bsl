Функция ТекстЗапроса_втЗначенияПоказателей(НомераТаблиц)
	
	НомераТаблиц.Вставить("втЗначенияПоказателей", НомераТаблиц.Количество());
	
	Шаблон = Шаблон_Аналитика();
	
	ТекстЗапроса = ШаблонЗапроса_ЗначенияПоказателей();
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Субконто1",		СтрШаблон(Шаблон, "ВЫРАЗИТЬ(Счет1.ТипДанных КАК СТРОКА(150))", "п.ПредставлениеТипа"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Субконто2",		СтрШаблон(Шаблон, "ВЫРАЗИТЬ(Счет2.ТипДанных КАК СТРОКА(150))", "п.ПредставлениеТипа"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Субконто3",		СтрШаблон(Шаблон, "ВЫРАЗИТЬ(Счет3.ТипДанных КАК СТРОКА(150))", "п.ПредставлениеТипа"));
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КорСубконто1",	СтрШаблон(Шаблон, "ВЫРАЗИТЬ(КорСчет1.ТипДанных КАК СТРОКА(150))", "п.ПредставлениеТипа"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КорСубконто2",	СтрШаблон(Шаблон, "ВЫРАЗИТЬ(КорСчет2.ТипДанных КАК СТРОКА(150))", "п.ПредставлениеТипа"));
