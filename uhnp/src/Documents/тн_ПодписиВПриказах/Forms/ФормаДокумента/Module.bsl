&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	Ответственный	= Пользователи.ТекущийПользователь();
	НачалоДействия	= ТекущаяДатаСеанса();
	
	//НАЧАЛО Качикина 04.02.2026 Выполнение задач №000056363	
	МассивПодразделений = Объект.Подразделения.Выгрузить().ВыгрузитьКолонку("Подразделение");
	СписокПодразделений.ЗагрузитьЗначения(МассивПодразделений);
	//КОНЕЦ Качикина 04.02.2026 Выполнение задач №000056363  
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

