//Качикина 04.02.2026 Выполнение задач №000056363
&НаСервере
Процедура ОбновитьПодразделенияНаСервере()
	
	Объект.Подразделения.Очистить();
	Для Каждого ЭлементСписка Из СписокПодразделений Цикл
		НоваяСтрока = Объект.Подразделения.Добавить();
		НоваяСтрока.Подразделение = ЭлементСписка.Значение;	
	КонецЦикла;	
	
КонецПроцедуры

