&НаСервере
Процедура УХ_ДоговорПриИзмененииНаСервере() Экспорт
	ЗаказПоставщикуСерверВнедрениеЕХ.ФормаДокумента_ИнициализироватьФлагИспользованияЦУЗ(
		ЭтаФорма);
	ЗаказПоставщикуСерверВнедрениеЕХ.ФормаДокумента_УстановитьОформлениеЭлементовЦУЗ(
		ЭтаФорма);
		
	АналитикиПланированияДокументов.ДоговорКонтрагентаПриИзменении(ЭтотОбъект);
	Элементы.ТоварыПодборИзОстатковПланаПоставокУХ.Доступность = Объект.Договор.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.ГрафикПоставок")
	ИЛИ Объект.Договор.ГрафикДоговора = ПредопределенноеЗначение("Перечисление.ГрафикиДоговора.НеИспользовать");

	
	
	Если ЗначениеЗаполнено(Объект.Договор) И ЭтоДоговорСПланомПоставок()  Тогда
		УХ_ДоговорСГрафикомПоставок = Истина;
	Иначе 
		УХ_ДоговорСГрафикомПоставок = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Договор) И ЭтоДоговорСПланомПоставок()
		И  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор.ВерсияСоглашения, "КонтролироватьСпецификациюВЗаказах") Тогда
        ЭтотОбъект.УХ_ДоговорСКонтролемГрафикаПоставок = Истина;
	Иначе
        ЭтотОбъект.УХ_ДоговорСКонтролемГрафикаПоставок = Ложь;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере 
Процедура УХ_ИзменилосьРаспределениеПоНоменклатуре(ТекущаяСтрока,АдресРезультата);
	
	ТаблицаРаспределения = ПолучитьИзВременногоХранилища(АдресРезультата);
	Строка = Объект.Товары.Выгрузить(Новый структура("НомерСтроки",ТекущаяСтрока+1));
	СуммаСНДСТаблицыВозврата = ТаблицаРаспределения.Итог("СуммаСНДС");
	Для Каждого Строки ИЗ ТаблицаРаспределения Цикл
		
		Если Объект.Товары[ТекущаяСтрока].СуммаСНДС = СуммаСНДСТаблицыВозврата И Строки.НомерСтроки = 1 Тогда
			Доб = Объект.Товары[ТекущаяСтрока];
		Иначе
		    Доб = Объект.Товары.Добавить();
			Объект.Товары[ТекущаяСтрока].Сумма = Объект.Товары[ТекущаяСтрока].Сумма - Строки.Сумма;
			Объект.Товары[ТекущаяСтрока].СуммаНДС = Объект.Товары[ТекущаяСтрока].СуммаНДС - Строки.СуммаНДС;
			Объект.Товары[ТекущаяСтрока].СуммаСНДС = Объект.Товары[ТекущаяСтрока].СуммаСНДС - Строки.СуммаСНДС;
		КонецЕсли;	

		Для каждого Элемент из Строка Цикл
			ЗаполнитьЗначенияСвойств(Доб,Элемент);				
		КонецЦикла;	
		Доб.Номенклатура = Строки.Номенклатура;   
		Доб.КоличествоУпаковок = Строки.Количество;
		Доб.Количество = Строки.Количество;
		Доб.Цена= Строки.Цена;
		Доб.Сумма = Строки.Сумма;
		Доб.СтавкаНДС = Строки.СтавкаНДС;
		Доб.СуммаНДС = Строки.СуммаНДС;	
		Доб.СуммаСНДС = Строки.СуммаСНДС;
		Доб.Характеристика = Строки.Характеристика;
		Если ЗначениеЗаполнено(Строки.Характеристика) Тогда
			Доб.ХарактеристикиИспользуются = Истина;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура УХ_ПолеФормыПриИзмененииНаСервере(ИмяЭлемента, ОбработатьНаСервере)
