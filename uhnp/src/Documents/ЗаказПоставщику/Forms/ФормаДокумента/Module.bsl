		Элементы[ИмяЭлемента], 
		ОбработатьНаСервере);
КонецПроцедуры

&НаКлиенте
Процедура ПодборЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да И Записать() Тогда
		Подключаемый_УХ_ПодборИзПланаПоставок(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УХ_ОбработатьЗаполнениеПлановымиПотребностями()
	ТекстВопроса = "";
	ДопПараметры = Новый Структура;
	Если Объект.Ссылка.Пустая() Тогда
		ДопПараметры.Вставить("Записать", Объект.Ссылка.Пустая());
		ТекстВопроса = ТекстВопроса 
			+ НСтр("ru='Необходимо записать документ перед заполнением. '");
	КонецЕсли;
	Если Объект.Товары.Количество() <> 0 Тогда
		ТекстВопроса = ТекстВопроса 
			+ НСтр("ru='При заполнении табличная часть будет очищена. '");
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстВопроса) Тогда
		ПоказатьВопрос(
			Новый ОписаниеОповещения("УХ_ЗаполнитьПлановымиПотребностямиОтвет", ЭтотОбъект),
			ТекстВопроса + НСтр("ru='Продолжить?'"), 
			РежимДиалогаВопрос.ДаНет);
	Иначе
		УХ_ЗаполнитьПлановымиПотребностямиОтвет(КодВозвратаДиалога.Да, ДопПараметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УХ_ЗаполнитьПлановымиПотребностямиОтвет(РезультатВопроса, 
											ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗначениеЗаполнено(ДополнительныеПараметры)
				И ДополнительныеПараметры.Свойство("Записать") Тогда
			флЗаписан = Записать();
		Иначе
			флЗаписан = Истина;
		КонецЕсли;
		Если флЗаписан Тогда
			УХ_ЗаполнитьПлановымиПотребностямиНаСервере();
		КонецЕсли;
	КонецЕсли;   
КонецПроцедуры

&НаСервере
Процедура УХ_ЗаполнитьПлановымиПотребностямиНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		Объект.ЦенаВключаетНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор.ВерсияСоглашения,"ЦенаВключаетНДС");
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ЗаполнитьНоменклатуруЗаказаПоставщикуПоДоговору(ДокументОбъект);
	УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ЗаполнитьЭтапыГрафикаОплаты(ДокументОбъект, Истина);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	УХ_ЗаполнитьСлужебныеРеквизитыТоваровНаСервере();  	 
	УХ_УстановитьТекстСтатейИАналитик();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УХ_ЗаполнитьСлужебныеРеквизитыТоваровНаСервере()
	КэшированныеЗначения =
		ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	Для каждого ТекущаяСтрока Из Объект.Товары Цикл
		УХ_ЗаполнитьСлужебныеРеквизитыСтрокиТоваров(
			Объект, ТекущаяСтрока, КэшированныеЗначения);
	КонецЦикла;
		
	СтруктураХарактеристикиНоменклатуры = Новый Структура;
	СтруктураХарактеристикиНоменклатуры.Вставить(
		"ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(
		Объект.Товары, СтруктураХарактеристикиНоменклатуры);
	ЗаполнитьПризнакСписанияНаРасходыДляУслуг();
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	ПриИзмененииСкладаВТабличнойЧастиСервер();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УХ_ЗаполнитьСлужебныеРеквизитыСтрокиТоваров(Объект,
													  ТекущаяСтрока,
													  КэшированныеЗначения)
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить(
		"ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить(
		"ЗаполнитьПризнакТипНоменклатуры",
		Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить(
		"ЗаполнитьПризнакАртикул",
		Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить(
		"ЗаполнитьПризнакАналитикаРасходовОбязательна");
	СтруктураДействий.Вставить(
		"ЗаполнитьНоменклатуруПоставщикаПоНоменклатуре",
		Объект.Партнер);
	СтруктураДействий.Вставить(
		"ПроверитьСтатьюАналитикуРасходов",
	ТекущаяСтрока.Номенклатура);     
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
   	СтруктураДействий.Вставить("ЗаполнитьПризнакБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);

	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(
		ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УХ_ОбновитьСуммыДокумента(Объект)
	Объект.СуммаДокумента = Объект.Товары.Итог("СуммаСНДС");
	Объект.СуммаНДС = Объект.Товары.Итог("СуммаНДС");
КонецПроцедуры

&НаСервере
Процедура УХ_ОбработатьВыборТовараНаСервере(ВыбранноеЗначение)
	УХ_ДобавитьИзменитьСтрокуНоменклатурыНаСервере(ВыбранноеЗначение);
	УХ_ЗаполнитьСлужебныеРеквизитыТоваровНаСервере();
	УХ_ОбновитьСуммыДокумента(Объект);
	УХ_ЗаполнитьЭтапыГрафикаОплаты();
КонецПроцедуры

&НаСервере
Процедура УХ_ДобавитьИзменитьСтрокуНоменклатурыНаСервере(ЗначенияЗаполненияСтроки)
		ОтборСтрок = Новый Структура(
			"ОрганизацияПолучатель,
			|НоменклатураИсходная,
			|ХарактеристикаИсходная,
			|Проект, 
			|Лот, 
			|МестоПоставки");
		ЗаполнитьЗначенияСвойств(ОтборСтрок, ЗначенияЗаполненияСтроки);
		ОтборСтрок.Приоритет = ЗначенияЗаполненияСтроки.Приоритет;
		мНайденыСтроки = Объект.Товары.НайтиСтроки(ОтборСтрок);
		Если мНайденыСтроки.Количество() = 0 Тогда
			ОбновляемаяСтрока = Объект.Товары.Добавить();
		Иначе
			ОбновляемаяСтрока = мНайденыСтроки[0];
		КонецЕсли;
		Если НЕ ЗначенияЗаполненияСтроки.ЭтоТоварнаяКатегория Тогда
			ЗаполнитьЗначенияСвойств(ОбновляемаяСтрока, ЗначенияЗаполненияСтроки);
			ОбновляемаяСтрока.КоличествоУпаковок = ЗначенияЗаполненияСтроки.Количество;
			ОбновляемаяСтрока.Упаковка = ЗначенияЗаполненияСтроки.ЕдиницаИзмерения;
			ОбновляемаяСтрока.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
				ОбновляемаяСтрока.СуммаСНДС, 
				Истина, 
				ВстраиваниеУХВызовСервера.ПолучитьСтавкуНДС(ОбновляемаяСтрока.СтавкаНДС).Ставка);
			ОбновляемаяСтрока.Сумма = ОбновляемаяСтрока.СуммаСНДС - ОбновляемаяСтрока.СуммаНДС;
		КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УХ_ЗаполнитьДопРеквизитыЦУЗСтрокиТоварыНаСервере(ТекущаяСтрока)
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущиеДанные <> Неопределено 
			И ТипЗнч(ТекущиеДанные.НоменклатураИсходная)
							= Тип("СправочникСсылка.Номенклатура") Тогда
		ЗаказПоставщикуСерверВнедрениеЕХ.ФормаДокумента_ЗаполнитьДопРеквизитыЦУЗСтрокиТовары(
			ЭтаФорма, ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция УХ_РаспределитьТоварнуюКатегориюНаСервере(НомерСтроки)
	
	ПараметрыФормы = Новый Структура();
	Товары = Объект.Товары.Выгрузить(Новый Структура("НомерСтроки",НомерСтроки));
	Товары = ПоместитьВоВременноеХранилище(Товары, УникальныйИдентификатор);
	ПараметрыФормы.Вставить("ЦенаВключаетНДС",Объект.ЦенаВключаетНДС);
	ПараметрыФормы.Вставить("ТЧЗаказыПоставщикам",Товары);
	
	Возврат ПараметрыФормы;
КонецФункции

&НаКлиенте
Процедура УХ_РаспределитьТоварнуюКатегорию(Команда)
	Если Элементы.Товары.ТекущиеДанные <> Неопределено 
		И НЕ ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.Номенклатура)    
		И ТипЗнч(Элементы.Товары.ТекущиеДанные.НоменклатураИсходная) =  Тип("СправочникСсылка.КатегорииЗакупок")
		И ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.НоменклатураИсходная) 
		Тогда
	ПараметрыФормы = УХ_РаспределитьТоварнуюКатегориюНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки);
	ОткрытьФорму("Обработка.РаспределениеТоварнойКатегории.Форма.Форма",ПараметрыФормы , ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Распределение доступно только по категории закупки без указанной номенклатуры'"));
	КонецЕсли;
КонецПроцедуры

