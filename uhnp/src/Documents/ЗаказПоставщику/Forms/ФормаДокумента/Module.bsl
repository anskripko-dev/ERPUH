#Область УХ_ИспользуемыеИзвне
 // Выполняет обработчики в контексте формы.
//
&НаКлиенте
Процедура ВыполнитьПредыдущиеОбработчики(Элемент, ИмяОбработчика)
	ПредыдущиеОбработчики =
		ПереопределениеСобытийФормыКлиент.ПолучитьПредыдущиеОбработчики(
			ЭтаФорма, Элемент.Имя, ИмяОбработчика);
	Для каждого Событие Из ПредыдущиеОбработчики Цикл
		Если Событие.ПредыдущийУстановлен Тогда
			Выполнить(Событие.ОбработчикСобытияПредыдущий+Событие.Параметры);
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УХ_ПолеФормы_ПриИзменении(Элемент)
	ВыполнитьПредыдущиеОбработчики(Элемент, "ПриИзменении");
	ОбработатьНаСервере = 
		ЗаказПоставщикуКлиентВнедрениеЕХ.ФормаДокумента_ПолеФормыПриИзменении(
			ЭтаФорма, Элемент);
	Если ОбработатьНаСервере <> Неопределено Тогда
		УХ_ПолеФормыПриИзмененииНаСервере(Элемент.Имя, ОбработатьНаСервере);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УХ_ПодборИзПланаПоставок(Команда)
	Если Объект.Ссылка.Пустая() И Команда <> Неопределено Тогда
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ПодборЗавершение", ЭтотОбъект),
			НСтр("ru='Необходимо записать документ перед заполнением. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Инновационный", Ложь);  
   		ЭтоДоговорСПланомПоставок = ЭтоДоговорСПланомПоставок();		
		ПараметрыФормы.Вставить("ОрганизацияДляЗаключенияДоговора",
		Объект.Организация); 
		ПараметрыФормы.Вставить("Валюта",	Объект.Валюта);
		ТаблицаНоменклатура = ПолучитьНоменклатуру();
		ПараметрыФормы.Вставить("ТекущаяНоменклатура",	ТаблицаНоменклатура); 
		Периодичность = ОпределитьПериодичность(); 

		Если ЭтоДоговорСПланомПоставок Тогда                           
			ДатаНачалаДействия = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.Договор,"ДатаНачалаДействия");  
			СрокДействия = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.Договор,"ДатаОкончанияДействия");
			ПараметрыФормы.Вставить("ПериодНачала", ОбщегоНазначенияУХ.ОпределитьПериодПоДате(НачалоГода(ДатаНачалаДействия), Периодичность));
			ПараметрыФормы.Вставить("ПериодОкончания", ОбщегоНазначенияУХ.ОпределитьПериодПоДате(КонецГода(СрокДействия), Периодичность));
		Иначе
			ПараметрыФормы.Вставить("ПериодНачала", ОбщегоНазначенияУХ.ОпределитьПериодПоДате(НачалоГода(Объект.Дата), Периодичность));
			ПараметрыФормы.Вставить("ПериодОкончания", ОбщегоНазначенияУХ.ОпределитьПериодПоДате(КонецГода(Объект.Дата), Периодичность));
		КонецЕсли;
		ПараметрыФормы.Вставить("ДатаСреза",Объект.Дата);  
		ПараметрыФормы.Вставить("МестоПоставки",Объект.МестоПоставки);       
		Если ЭтоДоговорСПланомПоставок Тогда   
		ПараметрыФормы.Вставить("ЭтапПланирования", ОбщегоНазначенияУХ.ПолучитьЗначениеПеречисленияПоИмени("ЭтапыПланированияПотребностей","Законтрактовано"));	
		ПараметрыФормы.Вставить("ДокументПланирования",Объект.Договор); 
		Иначе
		ПараметрыФормы.Вставить("ЭтапПланирования",ПредопределенноеЗначение("Перечисление.ЭтапыПланированияПотребностей.ЗаявкиСогласованные"));
		КонецЕсли;
		ПараметрыФормы.Вставить("ДокументОтбора",Объект.Ссылка);
		
		ОткрытьФорму(
		"Обработка.ПодборПотребностейИзПлана.Форма",
		ПараметрыФормы, 
		Элементы.Товары,
		,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры     

&НаСервере
Функция ЭтоДоговорСПланомПоставок();
	Возврат УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ЭтоДоговорСПланомПоставок(Объект.Договор);
КонецФункции

&НаСервере
Функция ОпределитьПериодичность()
	Возврат ЦентрализованныеЗакупкиУХ.ПолучитьПериодичностьЗакупок();
КонецФункции

&НаСервере
Функция ПолучитьНоменклатуру()      
	 Потребности = Объект.Товары.Выгрузить();  
	 КолВоСтрок = Потребности.Количество() - 1;      
	 Потребности.Колонки.Добавить("ДатаПоставки");
	 Для Каждого Строка ИЗ Потребности Цикл
		 Строка.ДатаПоставки = Строка.ДатаОтгрузки;
	 КонецЦикла; 
	 Пока КолВоСтрок >= 0 Цикл	 
		Если НЕ ЗначениеЗаполнено(Потребности[КолВоСтрок].АналитикаИсточника) Тогда
			Потребности.Удалить(КолВоСтрок);
		//Иначе
		//	Потребности[КолВоСтрок].Цена = Потребности[КолВоСтрок].АналитикаИсточника.Цена;	 
       	КонецЕсли; 
		КолВоСтрок = КолВоСтрок - 1;
	 КонецЦикла;	 
	
	 АдресВременногоХранилища = ПоместитьВоВременноеХранилище(
		Потребности, 
		Новый УникальныйИдентификатор());
    Возврат АдресВременногоХранилища;
КонецФункции

