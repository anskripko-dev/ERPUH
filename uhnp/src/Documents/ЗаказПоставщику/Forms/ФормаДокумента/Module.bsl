&НаКлиенте
Процедура УХ_ПеренестиДанныеСтатей(Параметр)
	Модифицированность = Истина;
	ТекДанные = Элементы.Товары.ТекущиеДанные;	
	Если ТекДанные <> Неопределено И НЕ Параметр.АналитикаДляВсейТаблицы Тогда
		ТекДанные.СтатьяБюджетаБДДС = Параметр.СтатьяБюджетаБДДС;
		ТекДанные.АналитикаБДДС1 = Параметр.АналитикаБДДС1;
		ТекДанные.АналитикаБДДС2 = Параметр.АналитикаБДДС2;
		ТекДанные.АналитикаБДДС3 = Параметр.АналитикаБДДС3;
		ТекДанные.АналитикаБДДС4 = Параметр.АналитикаБДДС4;
		ТекДанные.АналитикаБДДС5 = Параметр.АналитикаБДДС5;
		ТекДанные.АналитикаБДДС6 = Параметр.АналитикаБДДС6;     
		
		ТекДанные.СтатьяБюджетаБДР = Параметр.СтатьяБюджетаБДР;
		ТекДанные.АналитикаБДР1 = Параметр.АналитикаБДР1;
		ТекДанные.АналитикаБДР2 = Параметр.АналитикаБДР2;
		ТекДанные.АналитикаБДР3 = Параметр.АналитикаБДР3;
		ТекДанные.АналитикаБДР4 = Параметр.АналитикаБДР4;
		ТекДанные.АналитикаБДР5 = Параметр.АналитикаБДР5;
		ТекДанные.АналитикаБДР6 = Параметр.АналитикаБДР6;  		
		
		ТекДанные.ЦФО = Параметр.ОрганизацияПолучатель;  		
		ТекДанные.ОрганизацияПолучатель = Параметр.ОрганизацияПолучатель;  		
		ТекДанные.Проект = Параметр.Проект;  		
		
		ВидыБюджетаЗакупок = УХ_ВидыБюджетаЗакупок();
		Если ВидыБюджетаЗакупок Тогда  
			
			ТекДанные.УХ_СтатьиБюджетаИАналитики = Строка(ТекДанные.СтатьяБюджетаБДР)+";" + Строка(ТекДанные.АналитикаБДР1)+";" + ";"
			+ Строка(ТекДанные.АналитикаБДР2)+";" + Строка(ТекДанные.АналитикаБДР3)+";" + Строка(ТекДанные.АналитикаБДР4)+";"
			+ Строка(ТекДанные.АналитикаБДР5)+";" + Строка(ТекДанные.АналитикаБДР6)+";" +Строка(ТекДанные.СтатьяБюджетаБДДС)+";"+ Строка(ТекДанные.АналитикаБДДС1)+";"+ Строка(ТекДанные.АналитикаБДДС2)
			+";"+ Строка(ТекДанные.АналитикаБДДС3)+";"+ Строка(ТекДанные.АналитикаБДДС4)+";"+ 
			Строка(ТекДанные.АналитикаБДДС5)+";"+ Строка(ТекДанные.АналитикаБДДС6);     
			
		Иначе
			
			ТекДанные.УХ_СтатьиБюджетаИАналитики = Строка(ТекДанные.СтатьяБюджетаБДР)+";"+ Строка(ТекДанные.АналитикаБДР1)+";"+ Строка(ТекДанные.АналитикаБДР2)
			+";"+ Строка(ТекДанные.АналитикаБДР3)+";"+ Строка(ТекДанные.АналитикаБДР4)+";"+ 
			Строка(ТекДанные.АналитикаБДР5)+";"+ Строка(ТекДанные.АналитикаБДР6); 				
			
		КонецЕсли;
	ИначеЕсли Параметр.АналитикаДляВсейТаблицы Тогда   
		Объект.АналитикиПланирования.Очистить();    
		Если ЗначениеЗаполнено(Параметр.СтатьяБюджетаБДДС) Тогда   
			Доб =  Объект.АналитикиПланирования.Добавить();
			Доб.СтатьяБюджета = Параметр.СтатьяБюджетаБДДС;
			Доб.Аналитика1 = Параметр.АналитикаБДДС1;
			Доб.Аналитика2 = Параметр.АналитикаБДДС2;
			Доб.Аналитика3 = Параметр.АналитикаБДДС3;
			Доб.Аналитика4 = Параметр.АналитикаБДДС4;
			Доб.Аналитика5 = Параметр.АналитикаБДДС5;
			Доб.Аналитика6 = Параметр.АналитикаБДДС6;   
			Доб.Проект = Параметр.Проект;			
		КонецЕсли;
		Если ЗначениеЗаполнено(Параметр.СтатьяБюджетаБДР) Тогда
			Доб =  Объект.АналитикиПланирования.Добавить();
			Доб.СтатьяБюджета = Параметр.СтатьяБюджетаБДР;
			Доб.Аналитика1 = Параметр.АналитикаБДР1;
			Доб.Аналитика2 = Параметр.АналитикаБДР2;
			Доб.Аналитика3 = Параметр.АналитикаБДР3;
			Доб.Аналитика4 = Параметр.АналитикаБДР4;
			Доб.Аналитика5 = Параметр.АналитикаБДР5;
			Доб.Аналитика6 = Параметр.АналитикаБДР6;   
			Доб.Проект = Параметр.Проект;						
		КонецЕсли;			
		Для Каждого ТекДанные ИЗ Объект.Товары Цикл
			ТекДанные.СтатьяБюджетаБДДС = Параметр.СтатьяБюджетаБДДС;
			ТекДанные.АналитикаБДДС1 = Параметр.АналитикаБДДС1;
			ТекДанные.АналитикаБДДС2 = Параметр.АналитикаБДДС2;
			ТекДанные.АналитикаБДДС3 = Параметр.АналитикаБДДС3;
			ТекДанные.АналитикаБДДС4 = Параметр.АналитикаБДДС4;
			ТекДанные.АналитикаБДДС5 = Параметр.АналитикаБДДС5;
			ТекДанные.АналитикаБДДС6 = Параметр.АналитикаБДДС6;     
			
			ТекДанные.СтатьяБюджетаБДР = Параметр.СтатьяБюджетаБДР;
			ТекДанные.АналитикаБДР1 = Параметр.АналитикаБДР1;
			ТекДанные.АналитикаБДР2 = Параметр.АналитикаБДР2;
			ТекДанные.АналитикаБДР3 = Параметр.АналитикаБДР3;
			ТекДанные.АналитикаБДР4 = Параметр.АналитикаБДР4;
			ТекДанные.АналитикаБДР5 = Параметр.АналитикаБДР5;
			ТекДанные.АналитикаБДР6 = Параметр.АналитикаБДР6;  		
			
			ТекДанные.ЦФО = Параметр.ОрганизацияПолучатель;  		
			ТекДанные.ОрганизацияПолучатель = Параметр.ОрганизацияПолучатель;  		
			ТекДанные.Проект = Параметр.Проект;  		
			
			ВидыБюджетаЗакупок = УХ_ВидыБюджетаЗакупок();
			Если ВидыБюджетаЗакупок Тогда  
				
				ТекДанные.УХ_СтатьиБюджетаИАналитики = Строка(ТекДанные.СтатьяБюджетаБДР)+";" + Строка(ТекДанные.АналитикаБДР1)+";" + ";"
				+ Строка(ТекДанные.АналитикаБДР2)+";" + Строка(ТекДанные.АналитикаБДР3)+";" + Строка(ТекДанные.АналитикаБДР4)+";"
				+ Строка(ТекДанные.АналитикаБДР5)+";" + Строка(ТекДанные.АналитикаБДР6)+";" +Строка(ТекДанные.СтатьяБюджетаБДДС)+";"+ Строка(ТекДанные.АналитикаБДДС1)+";"+ Строка(ТекДанные.АналитикаБДДС2)
				+";"+ Строка(ТекДанные.АналитикаБДДС3)+";"+ Строка(ТекДанные.АналитикаБДДС4)+";"+ 
				Строка(ТекДанные.АналитикаБДДС5)+";"+ Строка(ТекДанные.АналитикаБДДС6);     
				
			Иначе
				
				ТекДанные.УХ_СтатьиБюджетаИАналитики = Строка(ТекДанные.СтатьяБюджетаБДР)+";"+ Строка(ТекДанные.АналитикаБДР1)+";"+ Строка(ТекДанные.АналитикаБДР2)
				+";"+ Строка(ТекДанные.АналитикаБДР3)+";"+ Строка(ТекДанные.АналитикаБДР4)+";"+ 
				Строка(ТекДанные.АналитикаБДР5)+";"+ Строка(ТекДанные.АналитикаБДР6); 				
				
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура УХ_АналитикиОплатПоУмолчанию(Команда)
		СтруктураАналитик = Новый Структура;         
		СтруктураАналитик.Вставить("Дата", Объект.Дата);
		СтруктураАналитик.Вставить("ОрганизацияПолучатель",Объект.Организация);

		Для Каждого СтрокаАналитик ИЗ Объект.АналитикиПланирования Цикл     
			Если СтрокаАналитик.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств") Тогда
				//СтруктураАналитик.Вставить("ОрганизацияПолучатель", СтрокаАналитик.ОрганизацияПолучатель); 
				СтруктураАналитик.Вставить("СтатьяБюджетаБДДС", СтрокаАналитик.СтатьяБюджета);
				СтруктураАналитик.Вставить("АналитикаБДДС1", СтрокаАналитик.Аналитика1); 
				СтруктураАналитик.Вставить("АналитикаБДДС2", СтрокаАналитик.Аналитика2); 
				СтруктураАналитик.Вставить("АналитикаБДДС3", СтрокаАналитик.Аналитика3); 
				СтруктураАналитик.Вставить("АналитикаБДДС4", СтрокаАналитик.Аналитика4); 
				СтруктураАналитик.Вставить("АналитикаБДДС5", СтрокаАналитик.Аналитика5); 
				СтруктураАналитик.Вставить("АналитикаБДДС6", СтрокаАналитик.Аналитика6);
			ИначеЕсли СтрокаАналитик.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов") Тогда
				СтруктураАналитик.Вставить("СтатьяБюджетаБДР", СтрокаАналитик.СтатьяБюджета);
				СтруктураАналитик.Вставить("АналитикаБДР1", СтрокаАналитик.Аналитика1); 
				СтруктураАналитик.Вставить("АналитикаБДР2", СтрокаАналитик.Аналитика2); 
				СтруктураАналитик.Вставить("АналитикаБДР3", СтрокаАналитик.Аналитика3); 
				СтруктураАналитик.Вставить("АналитикаБДР4", СтрокаАналитик.Аналитика4); 
				СтруктураАналитик.Вставить("АналитикаБДР5", СтрокаАналитик.Аналитика5); 
				СтруктураАналитик.Вставить("АналитикаБДР6", СтрокаАналитик.Аналитика6);   
			КонецЕсли;  
			СтруктураАналитик.Вставить("Проект", 		СтрокаАналитик.Проект);    
			СтруктураАналитик.Вставить("ЦФО", 		СтрокаАналитик.ЦФО);    
		КонецЦикла;	
		Если Объект.АналитикиПланирования.Количество() = 0 Тогда
			СтруктураАналитик.Вставить("СтатьяБюджетаБДДС",);
			СтруктураАналитик.Вставить("АналитикаБДДС1", ); 
			СтруктураАналитик.Вставить("АналитикаБДДС2", ); 
			СтруктураАналитик.Вставить("АналитикаБДДС3", ); 
			СтруктураАналитик.Вставить("АналитикаБДДС4", ); 
			СтруктураАналитик.Вставить("АналитикаБДДС5", ); 
			СтруктураАналитик.Вставить("АналитикаБДДС6", );
			СтруктураАналитик.Вставить("СтатьяБюджетаБДР", );
			СтруктураАналитик.Вставить("АналитикаБДР1", ); 
			СтруктураАналитик.Вставить("АналитикаБДР2", ); 
			СтруктураАналитик.Вставить("АналитикаБДР3", ); 
			СтруктураАналитик.Вставить("АналитикаБДР4", ); 
			СтруктураАналитик.Вставить("АналитикаБДР5", ); 
			СтруктураАналитик.Вставить("АналитикаБДР6", );   
			СтруктураАналитик.Вставить("Проект", 		);    
			СтруктураАналитик.Вставить("ЦФО", );    
		КонецЕсли;	
		ОткрытьФорму("Документ.ЗаказПоставщику.Форма.УХ_ФормаСтатейИАналитикПоУмолчанию",СтруктураАналитик,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	

КонецПроцедуры

&НаСервере
Функция УХ_ВидыБюджетаЗакупок()
	ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);	  
	Возврат ВидыБюджетаЗакупок <> Неопределено И ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
КонецФункции

&НаСервере
Функция ВидСтатьиБюджетирования(Дата)
	Возврат ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Дата);	
КонецФункции 

&НаСервере
Процедура УстановитьВидимостьБюджета()
	
	ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);	
	
КонецПроцедуры

&НаКлиенте
Процедура УХ_ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВидСтатьиБюджетирования(ВыбранноеЗначение) <> ЭтаФорма.ВидСтатьи_УХ Тогда    
		СтруктураПараметров = Новый Структура();      
		СтруктураПараметров.Вставить("СтараяДата",Объект.Дата);
		СтруктураПараметров.Вставить("НоваяДата",ВыбранноеЗначение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьСтатьиПоМэппингу", ЭтотОбъект,СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'По настройкам планирования закупок дата документа попадает в период с другими настройками планирования. Данные по статье будут изменены или очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);        
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УХ_ДатаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если ВидСтатьиБюджетирования(Дата(Текст)) <> ЭтаФорма.ВидСтатьи_УХ Тогда    
		СтруктураПараметров = Новый Структура();      
		СтруктураПараметров.Вставить("СтараяДата",Объект.Дата);
		СтруктураПараметров.Вставить("НоваяДата",Дата(Текст));
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьСтатьиПоМэппингу", ЭтотОбъект,СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'По настройкам планирования закупок дата документа попадает в период с другими настройками планирования. Данные по статье будут изменены или очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе 
		Объект.Дата = Дата(Текст);
	КонецЕсли; 	

КонецПроцедуры    

&НаКлиенте
Процедура ПерезаполнитьСтатьиПоМэппингу(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда 
    	Объект.Дата = Параметры.СтараяДата;
	Иначе            
		Объект.Дата = Параметры.НоваяДата;
		ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры) 
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Параметры.НоваяДата);    
	Если Параметры.НоваяДата > Параметры.СтараяДата Тогда    
		ТаблицаТоваров = Объект.Товары.Выгрузить();     
		СписокТипов = Новый Массив;
		СписокТипов.Добавить(Тип("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
		ОписаниеТипов = Новый ОписаниеТипов(СписокТипов);    
		//СписокТипов = Новый Массив; ПланВи
		//СписокТипов.Добавить(Тип("Характеристики.ВидыСубконтоКорпоративные"));
		ТаблицаТоваров.Колонки.Добавить("СтатьяБюджета",ОписаниеТипов);
		ТаблицаТоваров.Колонки.Добавить("Аналитика1",Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
		ТаблицаТоваров.Колонки.Добавить("Аналитика2",Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
		ТаблицаТоваров.Колонки.Добавить("Аналитика3",Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
		ТаблицаТоваров.Колонки.Добавить("Аналитика4",Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
		ТаблицаТоваров.Колонки.Добавить("Аналитика5",Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
		ТаблицаТоваров.Колонки.Добавить("Аналитика6",Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
		Для Каждого Строка Из ТаблицаТоваров Цикл
			Строка.СтатьяБюджета = Строка.СтатьяБюджетаБДДС;
			Строка.Аналитика1 = Строка.АналитикаБДДС1;
			Строка.Аналитика2 = Строка.АналитикаБДДС2;
			Строка.Аналитика3 = Строка.АналитикаБДДС3;
			Строка.Аналитика4 = Строка.АналитикаБДДС4;
			Строка.Аналитика5 = Строка.АналитикаБДДС5;
			Строка.Аналитика6 = Строка.АналитикаБДДС6;
		КонецЦикла;			
	    ТаблицаСМэппингом = ПланированиеПотребностей.ЗаменаСтатейИАналитикПоНастройкамЛимитов(Параметры.НоваяДата,ТаблицаТоваров);
		Объект.Товары.Очистить();
		Объект.Товары.Загрузить(ТаблицаСМэппингом);
	Иначе
		Для Каждого Строка Из Объект.Товары Цикл
			Строка.СтатьяБюджетаБДДС = Неопределено;
			Строка.АналитикаБДДС1 = Неопределено;
			Строка.АналитикаБДДС2 = Неопределено;
			Строка.АналитикаБДДС3 = Неопределено;
			Строка.АналитикаБДДС4 = Неопределено;
			Строка.АналитикаБДДС5 = Неопределено;
			Строка.АналитикаБДДС6 = Неопределено;
		КонецЦикла;	
	КонецЕсли;	
	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата) <> Неопределено Тогда
		Если ВидСтатьи <> Неопределено  Тогда
			УХ_УстановитьТекстСтатейИАналитик();
			Элементы.ТоварыСтатьяБюджетаНадпись.Видимость  = Истина;
		Иначе                               
			Элементы.ТоварыСтатьяБюджетаНадпись.Видимость  = Ложь;
		КонецЕсли; 
	Иначе                               
		Элементы.ТоварыСтатьяБюджетаНадпись.Видимость  = Ложь;
	КонецЕсли;	      
 	УХ_ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);    
	
КонецПроцедуры

&НаСервере
Процедура  УХ_УстановитьТекстСтатейИАналитик()
	
	ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);	

	Для Каждого ТекДанные ИЗ Объект.Товары Цикл     
		Если ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда  

		ТекДанные.УХ_СтатьиБюджетаИАналитики = Строка(ТекДанные.СтатьяБюджетаБДР)+";" + Строка(ТекДанные.АналитикаБДР1)+";"
		+ Строка(ТекДанные.АналитикаБДР2)+";" + Строка(ТекДанные.АналитикаБДР3)+";" + Строка(ТекДанные.АналитикаБДР4)+";"
		+ Строка(ТекДанные.АналитикаБДР5)+";" + Строка(ТекДанные.АналитикаБДР6)+";" +Строка(ТекДанные.СтатьяБюджетаБДДС)+";"+ Строка(ТекДанные.АналитикаБДДС1)+";"+ Строка(ТекДанные.АналитикаБДДС2)
		+";"+ Строка(ТекДанные.АналитикаБДДС3)+";"+ Строка(ТекДанные.АналитикаБДДС4)+";"+Строка(ТекДанные.АналитикаБДДС5)+";"+ Строка(ТекДанные.АналитикаБДДС6);
		Иначе
		ТекДанные.УХ_СтатьиБюджетаИАналитики = Строка(ТекДанные.СтатьяБюджетаБДР)+";"+ Строка(ТекДанные.АналитикаБДР1)+";"+ Строка(ТекДанные.АналитикаБДР2)
		+";"+ Строка(ТекДанные.АналитикаБДР3)+";"+ Строка(ТекДанные.АналитикаБДР4)+";"+Строка(ТекДанные.АналитикаБДР5)+";"+ Строка(ТекДанные.АналитикаБДР6);
		КонецЕсли;	
	КонецЦикла;	
		
КонецПроцедуры

&НаКлиенте
Процедура УХ_ОткрытиеЗаменаБюджетныхАналитик()
		ТекДанные = Элементы.Товары.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		СтруктураАналитик = Новый Структура;         
		СтруктураАналитик.Вставить("Дата", Объект.Дата);	
