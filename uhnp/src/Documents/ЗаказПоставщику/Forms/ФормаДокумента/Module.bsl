КонецФункции

&НаКлиенте
Процедура СтатусОбъектаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение = РеквизитСостояниеЗаявки(ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() ИЛИ ЭтаФорма.Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("СостояниеЗаявкиОбработкаВыбораПродолжение", ЭтотОбъект, Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение));
		ТекстВопроса = НСтр("ru = 'Данные еще не записаны.
				|Изменение состояния возможно только после записи данных.
				|Данные будут записаны.'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	ИзменитьСостояниеЗаявкиКлиент(ВыбранноеЗначение);	

КонецПроцедуры

&НаКлиенте
Процедура УХ_ТоварыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда		
		РезультатОбработкиВыбора = ОбработкаВыбораПотребностейНаСервере(ВыбранноеЗначение, "ВыбранныеПотребностиВНоменклатуре");	
	КонецЕсли; 
	
	УХ_ОбновитьСуммыДокумента(Объект);
	УХ_ЗаполнитьЭтапыГрафикаОплаты();	
	
	ПриОжиданииВыполнитьКонтрольДокумента();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ОбработкаВыбораПотребностейНаСервере(АдресТаблицыПотребности, ИмяТаблицыНаФормеПобора)
	ТаблицаПотребностей = ПолучитьИзВременногоХранилища(АдресТаблицыПотребности);
	Если ТаблицаПотребностей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТаблицаПотребностей.Колонки.Добавить("СуммаНДС", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Для Каждого ТекТаблицаПотребностей Из ТаблицаПотребностей Цикл
		ЦентрализованныеЗакупкиКлиентСерверУХ.РассчитатьНДССтроки(Объект.ЦенаВключаетНДС, ТекТаблицаПотребностей);
	КонецЦикла;	
	// Перенос в таблицу значений данных с формы.
	ПланированиеПотребностей.ЗаменаСтатейИАналитикПоНастройкамЛимитов(Объект.Дата,ТаблицаПотребностей);	
	КолСтрок = Объект.Товары.Количество()-1;
	Пока КолСтрок >=0 Цикл
		Если ЗначениеЗаполнено(Объект.Товары[КолСтрок].АналитикаПланирования) Тогда
			Объект.Товары.Удалить(КолСтрок);
		КонецЕсли;	
		КолСтрок = КолСтрок - 1;
	КонецЦикла;	
	Для Каждого Строка ИЗ ТаблицаПотребностей Цикл   
		НоваяСтрока = Объект.Товары.Добавить();   
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);   
		НоваяСтрока.ТипНоменклатуры = НоваяСтрока.Номенклатура.ТипНоменклатуры;
		НоваяСтрока.ДатаОтгрузки = ?(Объект.ПоступлениеОднойДатой,Объект.ДатаОтгрузки, НоваяСтрока.АналитикаПланирования.ДатаОперации);    
		НоваяСтрока.КоличествоУпаковок = Строка.Количество;       
		
		НоваяСтрока.ДатаПоступления = Объект.ДатаОтгрузки;   
		Если НоваяСтрока.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения <> НоваяСтрока.Номенклатура.ЕдиницаИзмерения Тогда
			НоваяСтрока.Упаковка = НоваяСтрока.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения; 
		КонецЕсли;
		НоваяСтрока.НоменклатураИсходная = НоваяСтрока.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура;   
		НоваяСтрока.ХарактеристикаИсходная = НоваяСтрока.АналитикаПланирования.АналитикаНоменклатуры.Характеристика; 
		НоваяСтрока.ОрганизацияПолучатель  = НоваяСтрока.АналитикаПланирования.АналитикаСтруктуры.ЦФО;  
		НоваяСтрока.ЦФО  = НоваяСтрока.АналитикаПланирования.АналитикаСтруктуры.ЦФО;      
		НоваяСтрока.СтавкаНДС =  НоваяСтрока.АналитикаПланирования.АналитикаПоставки.СтавкаНДС;  
		НоваяСтрока.СтраныПроисхождения = НоваяСтрока.АналитикаПланирования.АналитикаПоставки.СтранаПроисхождения;
		НоваяСтрока.СтранаПроизводителя = НоваяСтрока.АналитикаПланирования.АналитикаПоставки.СтранаПроизводителя;
		НоваяСтрока.НоменклатураПартнера = НоваяСтрока.АналитикаПланирования.АналитикаПоставки.НоменклатураПоставщика;
		НоваяСтрока.Склад = ?(ЗначениеЗаполнено(Объект.Склад),Объект.Склад,Строка.АналитикаПланирования.АналитикаПоставки.Склад); 
		НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
		НоваяСтрока.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.СуммаСНДС, Истина,НоваяСтрока.СтавкаНДС.Ставка);
		НоваяСтрока.Сумма = ?(Объект.ЦенаВключаетНДС,НоваяСтрока.СуммаСНДС,НоваяСтрока.СуммаСНДС - Объект.СуммаНДС);  
        НоваяСтрока.СуммаБезВозвратнойТары = НоваяСтрока.Сумма;
		НоваяСтрока.СуммаНДСБезВозвратнойТары = НоваяСтрока.СуммаНДС;
		НоваяСтрока.Цена = НоваяСтрока.Сумма / ?(НоваяСтрока.Количество = 0, 1, НоваяСтрока.Количество); 
		НоваяСтрока.СуммаСНДСБезВозвратнойТары = НоваяСтрока.СуммаСНДС;
		НоваяСтрока.БезВозвратнойТары = Истина;
		ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);	
		Если ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда
			НоваяСтрока.СтатьяБюджетаБДДС = Строка.СтатьяБюджета;
			НоваяСтрока.АналитикаБДДС1 = Строка.Аналитика1;
			НоваяСтрока.АналитикаБДДС2 = Строка.Аналитика2;
			НоваяСтрока.АналитикаБДДС3 = Строка.Аналитика3;
			НоваяСтрока.АналитикаБДДС4 = Строка.Аналитика4;
			НоваяСтрока.АналитикаБДДС5 = Строка.Аналитика5;
			НоваяСтрока.АналитикаБДДС6 = Строка.Аналитика6; 
		ИначеЕсли ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов Тогда
			НоваяСтрока.СтатьяБюджетаБДР = Строка.СтатьяБюджета;
			НоваяСтрока.АналитикаБДР1 = Строка.Аналитика1;
			НоваяСтрока.АналитикаБДР2 = Строка.Аналитика2;
			НоваяСтрока.АналитикаБДР3 = Строка.Аналитика3;
			НоваяСтрока.АналитикаБДР4 = Строка.Аналитика4;
			НоваяСтрока.АналитикаБДР5 = Строка.Аналитика5;
			НоваяСтрока.АналитикаБДР6 = Строка.Аналитика6;	
		КонецЕсли;

		
		УпаковкаНоменклатура = Неопределено;
		ПараметрыПересчета = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.НормализоватьПараметрыПересчетаЕдиниц(НоваяСтрока, УпаковкаНоменклатура);
		Если ЗначениеЗаполнено(ПараметрыПересчета.Номенклатура) Тогда
			
			КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
			
			ДанныеУпаковки = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьКоэффициентУпаковки(ПараметрыПересчета.Упаковка, КэшированныеЗначения, ПараметрыПересчета.Номенклатура);
			Количество = НоваяСтрока.КоличествоУпаковок * ДанныеУпаковки.Коэффициент;
		    

			Если ДанныеУпаковки.НужноОкруглятьКоличество
				И ПараметрыПересчета.НужноОкруглять Тогда
				НоваяСтрока.Количество = Окр(Количество, 0 ,РежимОкругления.Окр15как20);
			Иначе
				НоваяСтрока.Количество = Количество;
			КонецЕсли;
		ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка, "КоличествоУпаковок") Тогда
			НоваяСтрока.Количество = НоваяСтрока.КоличествоУпаковок;
		КонецЕсли;
		
	КонецЦикла;	   
	УХ_УстановитьТекстСтатейИАналитик();
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	Возврат Истина;
КонецФункции	

