		СтруктураАналитик.Вставить("АналитикаБДДС1", ТекДанные.АналитикаБДДС1); 
		СтруктураАналитик.Вставить("АналитикаБДДС2", ТекДанные.АналитикаБДДС2); 
		СтруктураАналитик.Вставить("АналитикаБДДС3", ТекДанные.АналитикаБДДС3); 
		СтруктураАналитик.Вставить("АналитикаБДДС4", ТекДанные.АналитикаБДДС4); 
		СтруктураАналитик.Вставить("АналитикаБДДС5", ТекДанные.АналитикаБДДС5); 
		СтруктураАналитик.Вставить("АналитикаБДДС6", ТекДанные.АналитикаБДДС6);   
		СтруктураАналитик.Вставить("СтатьяБюджетаБДР", ТекДанные.СтатьяБюджетаБДР);
		СтруктураАналитик.Вставить("АналитикаБДР1", ТекДанные.АналитикаБДР1); 
		СтруктураАналитик.Вставить("АналитикаБДР2", ТекДанные.АналитикаБДР2); 
		СтруктураАналитик.Вставить("АналитикаБДР3", ТекДанные.АналитикаБДР3); 
		СтруктураАналитик.Вставить("АналитикаБДР4", ТекДанные.АналитикаБДР4); 
		СтруктураАналитик.Вставить("АналитикаБДР5", ТекДанные.АналитикаБДР5); 
		СтруктураАналитик.Вставить("АналитикаБДР6", ТекДанные.АналитикаБДР6);    		
		ОткрытьФорму("Документ.ЗаказПоставщику.Форма.УХ_ФормаСтатейИАналитик",СтруктураАналитик,ЭтаФорма,,,,,);
