&НаКлиенте
Процедура Эксперты1ЭкспертПриИзменении(Элемент)
	ФункциональноеНаправление = ЭкспертыЭкспертПриИзмененииНаСервере(Элементы.Эксперты.ТекущиеДанные.Эксперт);
КонецПроцедуры

&НаСервере
Процедура СоздатьНастройкуПроцессаНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НастройкаПроцессаВыбора = Документы.КритерииОценкиПоставщиков.СоздатьПроцессВыбора(Объект.Ссылка);
		Объект.НастройкаПроцессаВыбора = НастройкаПроцессаВыбора;	
	Иначе
		ТекстСообщения = НСтр("ru = 'Требуется записать документ перед созданием настройки.Операция отменена.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНастройкуПроцесса(Команда)
	
	СоздатьНастройкуПроцессаНаСервере();
	ОбновитьКритерииНастройки();
	УстановитьТекстПодвала();
	Элементы.КритерииОценки.ТолькоПросмотр = Не ЗначениеЗаполнено(Объект.НастройкаПроцессаВыбора);
	Элементы.КритерииОценкиСоздатьНастройкуПроцесса.Видимость = Не ЗначениеЗаполнено(Объект.НастройкаПроцессаВыбора);
	Если Элементы.Мероприятия.Видимость Тогда
	Элементы.Мероприятия.Обновить();
	КонецЕсли;
	Записать();
КонецПроцедуры

&НаСервере
Процедура ОбновитьКритерииНастройки()
	Если ЗначениеЗаполнено(Объект.НастройкаПроцессаВыбора) Тогда
		КритерииОценки.Загрузить(Объект.НастройкаПроцессаВыбора.КритерииОценки.Выгрузить());
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СтартоватьРазовуюОценкуНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И ЗначениеЗаполнено(Объект.НастройкаПроцессаВыбора) Тогда
		
		Спр = Справочники.ШаблоныМероприятий.СоздатьЭлемент();
		Спр.Наименование = "Оценка поставщиков по " + Объект.Ссылка;
		Стадии = Спр.Стадии.Добавить();
		Стадии.Стадия = Справочники.СтадииМероприятий.ОценкаПоставщиков;
		
		Спр.Наименование = "Оценка поставщиков по " + Объект.Ссылка;
		Спр.ВидМероприятия = Перечисления.ВидыМероприятий.ОценкаПоставщиков;
		Спр.записать();
		ШаблонМероприятия = Спр.Ссылка;
		Док = Документы.Мероприятие.СоздатьДокумент();
		//Спр.Наименование = "Оценка поставщиков по " + ДокументОценки.Ссылка;
		Док.ВидМероприятия = Перечисления.ВидыМероприятий.ОценкаПоставщиков;
		Док.Ответственный = Объект.Ответственный;
		Док.Контекст = Объект.Ссылка;
		Док.ШаблонМероприятия = Спр.Ссылка;
		Док.НаименованиеРеакции = "Задача по оценке поставщиков в рамках мероприятия "+ Док.Номер;
		Док.Дата = Объект.Дата;
		Для Каждого Участник Из Объект.Эксперты Цикл
			Участники = Док.Участники.Добавить();
			Участники.Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизическоеЛицо",Участник.Эксперт)
		КонецЦикла;
		Док.Записать();
		
		ВидСобытия = ПредопределенноеЗначение("Справочник.ВидыСобытийОповещений.ОценкаПоставщиков");
		
		СписокРассылки = Новый Массив;
		
		
		Для Каждого Участник Из Док.Участники Цикл
			СписокРассылки.Добавить(Участник.Пользователь);
		КонецЦикла;
		
		ЗадачаОбъект = Справочники.Задачи.СоздатьЭлемент();
		ЗадачаОбъект.СвязанныйОбъект = Док.Ссылка;
		ЗадачаОбъект.Записать();
		
		СтруктураДополнительныхПараметров = Новый Структура;
		РезультатФункции = МодульУправленияОповещениямиУХ.ОповеститьПользователей(ВидСобытия, Справочники.ШаблоныОповещений.ОценкаПоставщиков , Док.Ссылка, СписокРассылки, СтруктураДополнительныхПараметров, ЗадачаОбъект.Ссылка);
		
		Для Каждого Контрагенты ИЗ Объект.Поставщики Цикл
			Рег = РегистрыСведений.ОбъектыВыбора.СоздатьМенеджерЗаписи();
			Рег.Объект = Контрагенты.Контрагент;
			Рег.Владелец = Док.Ссылка;
			Рег.Записать();
		КонецЦикла;
		Рег = РегистрыСведений.НастройкиПроцессовВыбора.СоздатьМенеджерЗаписи();
		Рег.НастройкаПроцессаВыбора = Объект.НастройкаПроцессаВыбора.Ссылка;
		Рег.Владелец = Док.Ссылка;
		Рег.Записать();
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстСообщения = НСтр("ru = 'Требуется записать документ перед созданием настройки процесса выбора.Операция отменена.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	ИначеЕсли Не ЗначениеЗаполнено(Объект.НастройкаПроцессаВыбора) Тогда 
		ТекстСообщения = НСтр("ru = 'Требуется создать документ перед созданием настройки процесса выбора.Операция отменена.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		
	КонецЕсли;
		
КонецПроцедуры

