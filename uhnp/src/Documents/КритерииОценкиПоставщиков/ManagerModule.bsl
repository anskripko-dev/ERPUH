#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьТаблицуКритерийПоставщиковПоУмолчанию() Экспорт
	ТаблицаКритерий = Новый ТаблицаЗначений();
	ТаблицаКритерий.Колонки.Добавить("КритерийОценки");
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.РазмерАванса;
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.Доставка;
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.Безотказность;
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.критерийОценки = Справочники.КритерииВыбора.НаличиеПоставок;
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.УровеньЦены;
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.УровеньКачества;
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.Стабильность;
	

	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.СрокПоставки;
	
	НоваяСтрока = ТаблицаКритерий.Добавить();
	НоваяСтрока.КритерийОценки = Справочники.КритерииВыбора.Репутация;
	
	Возврат ТаблицаКритерий;
	
КонецФункции

Функция СоздатьПроцессВыбора(ДокументОценки) Экспорт 
	
	НастройкаПроцесса = Справочники.НастройкиПроцессаВыбора.СоздатьЭлемент();
	НастройкаПроцессаСсылка = Справочники.НастройкиПроцессаВыбора.ПолучитьСсылку(Новый УникальныйИдентификатор);
	НастройкаПроцесса.УстановитьСсылкуНового(НастройкаПроцессаСсылка);
	НастройкаПроцесса.ИспользоватьРасчетныеЗначенияИсточникаДанных = Истина;
	Этап = НастройкаПроцесса.ЭтапыВыбора.Добавить();
	НастройкаПроцесса.Наименование = "Процесс выбора по " + ДокументОценки.Ссылка;
	Этап.Этап = Справочники.ЭтапыОценки.ОценкаПоставщиков;
	ВесОбщий = 1;
	КритерииПоУмолчанию = Документы.КритерииОценкиПоставщиков.ПолучитьТаблицуКритерийПоставщиковПоУмолчанию();
	КоличествоКритерий = КритерииПоУмолчанию.Количество();
	Вес = ВесОбщий/КоличествоКритерий;
	КоличествоКритерийОбщее = КоличествоКритерий; 
	Для Каждого КритерииОценки Из КритерииПоУмолчанию Цикл
		
		Критерий = НастройкаПроцесса.КритерииОценки.Добавить();
		Критерий.КритерийОценки = КритерииОценки.КритерийОценки;
		Критерий.МинимальноеЗначение = Критерий.КритерийОценки.МинимальноеЗначение;
		Критерий.МаксимальноеЗначение = Критерий.КритерийОценки.МаксимальноеЗначение;		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.Стабильность Тогда
			Критерий.От0 = 0;
			Критерий.До0 = 1;
			Критерий.От1 = 1;
			Критерий.До1 = 2;
			Критерий.От2 = 2;
			Критерий.До2 = 3;
			Критерий.От3 = 3; 
			Критерий.МинимальноеЗначение = 1;
			Критерий.МаксимальноеЗначение = 3;
		КонецЕсли;	
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.УровеньЦены Тогда
			Критерий.От0 = 0;
			Критерий.До0 = 1;
			Критерий.От1 = 1;
			Критерий.До1 = 2;
			
			Критерий.От2 = 2;
			Критерий.До2 = 3;
			Критерий.От3 = 3;
			Критерий.До3 = 4;
			Критерий.От3 = 4;
			Критерий.От4 = 4;
			Критерий.До4 = 5;
			Критерий.От5 = 5;
			Критерий.МинимальноеЗначение = 1;
			Критерий.МаксимальноеЗначение = 5;
			
		КонецЕсли;	
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.Безотказность Тогда
			Критерий.От0 = 0;
			Критерий.До0 = 1;
			Критерий.От1 = 1;
			Критерий.До1 = 2;
			Критерий.От2 = 2;
			Критерий.До2 = 3;
			Критерий.От3 = 3;	
			Критерий.МинимальноеЗначение = 1;
			Критерий.МаксимальноеЗначение = 3;
			
		КонецЕсли;	
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.Доставка Тогда
			Критерий.От0 = 0;
			Критерий.До0 = 1;
			Критерий.От1 = 1;
			Критерий.До1 = 2;
			Критерий.От2  = 2;
			Критерий.МинимальноеЗначение = 1;
			Критерий.МаксимальноеЗначение = 2;
			
		КонецЕсли;	
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.Репутация Тогда
			Критерий.От0 = 0;
			Критерий.До0 = 1;
			Критерий.От1 = 1;
			Критерий.До1 = 2;
			Критерий.От2 = 2;
			Критерий.МинимальноеЗначение = 1;
			Критерий.МаксимальноеЗначение = 2;
			
		КонецЕсли;	
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.РазмерАванса Тогда
			Критерий.РассчитатьЗначение = Истина;
			Источник = Справочники.ИсточникиДанныхДляРасчетов.РасчетПоАвансамДляОценкиПоставщиков;
			Критерий.ИсточникДанных = Источник.Ссылка;
			Критерий.От1 = 0;
			Критерий.До1 = 20;
			Критерий.От2 = 20;
			Критерий.До2 = 50;	
			Критерий.От3 = 50;
			Критерий.До3 = 70;
			Критерий.От4 = 70;
			Критерий.До4 = 80;
			Критерий.От5 = 80;
			Критерий.До5 = 100; 
			Критерий.МинимальноеЗначение = 1;
			Критерий.МаксимальноеЗначение = 5;
			
		КонецЕсли;			
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.УровеньКачества Тогда
			Критерий.РассчитатьЗначение = Истина;
			Источник = Справочники.ИсточникиДанныхДляРасчетов.РасчетПоПретензиямДляОценкиПоставщиков;
			Критерий.ИсточникДанных = Источник.Ссылка;
			Критерий.От0 = 0;
			Критерий.До0 = 10;
			Критерий.От1 = 10;
			Критерий.До1 = 20;
			Критерий.От2 = 20;
			Критерий.До2 = 40;	
			Критерий.От3 = 40;
			Критерий.До3 = 60;
			Критерий.От4 = 60;
			Критерий.До4 = 80;
			Критерий.От5 = 80;
			Критерий.До5 = 100; 
			Критерий.МинимальноеЗначение = 0;
			Критерий.МаксимальноеЗначение = 5;
			
		КонецЕсли;		
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.СрокПоставки Тогда
			Критерий.РассчитатьЗначение = Истина;
			Источник =  Справочники.ИсточникиДанныхДляРасчетов.РасчетПоСрокамДляОценкиПоставщиков;
			Критерий.ИсточникДанных = Источник.Ссылка;
			Критерий.От0 = 0;
			Критерий.До0 = 10;
			Критерий.От1 = 10;
			Критерий.До1 = 20;
			Критерий.От2 = 20;
			Критерий.До2 = 40;	
			Критерий.От3 = 40;
			Критерий.До3 = 60;
			Критерий.От4 = 60;
			Критерий.До4 = 80;
			Критерий.От5 = 80;
			Критерий.До5 = 100;  
			Критерий.МинимальноеЗначение = 0;
			Критерий.МаксимальноеЗначение = 5;
			

		КонецЕсли;	
		
		Если КритерииОценки.КритерийОценки = Справочники.КритерииВыбора.НаличиеПоставок Тогда
			Критерий.РассчитатьЗначение = Истина;
			Источник =  Справочники.ИсточникиДанныхДляРасчетов.РасчетПоПоставкамДляОценкиПоставщиков;
			Критерий.ИсточникДанных = Источник.Ссылка;
			Критерий.От0 = 0;
			Критерий.До0 = 0;
			Критерий.От1 = 0;
			Критерий.До1 = 1;   
			Критерий.МинимальноеЗначение = 0;
			Критерий.МаксимальноеЗначение = 1;
			
		КонецЕсли;			
		Вес = Окр(ВесОбщий/КоличествоКритерий,5);
		Если Критерий.НомерСтроки - 1 = КоличествоКритерийОбщее Тогда
			Критерий.Вес = ВесОбщий;
		Иначе
			Если КритерииОценки.КритерийОценки.Вес > 0 Тогда
				Вес = КритерииОценки.КритерийОценки.Вес;
			КонецЕсли;	
			Критерий.Вес = Вес;
		КонецЕсли;
		Критерий.ЭтапВыбора = Справочники.ЭтапыОценки.ОценкаПоставщиков;
		ВесОбщий = ВесОбщий - Вес;
		КоличествоКритерий = КоличествоКритерий - 1;
	КонецЦикла;	
	
	Для Каждого Эксперт Из ДокументОценки.Эксперты Цикл
			
		Эксперты = НастройкаПроцесса.ОценочнаяКомиссия.Добавить();
		Эксперты.Сотрудник = Эксперт.Эксперт;
		Эксперты.ЗакрываетЭтапОценки = Эксперт.ЗакрываетЭтапОценки;
		
	КонецЦикла;	
	
	НастройкаПроцесса.Записать();
	Возврат НастройкаПроцесса.Ссылка;
КонецФункции	

#КонецЕсли	