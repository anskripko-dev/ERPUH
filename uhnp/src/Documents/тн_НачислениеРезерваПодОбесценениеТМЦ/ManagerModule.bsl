#Область ПрограммныйИнтерфейс

Функция РеквизитыДокумента(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Подразделение КАК Подразделение
	|ИЗ
	|	Документ.тн_НачислениеРезерваПодОбесценениеТМЦ КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка";
	
	СтруктураРеквизитов = Новый Структура("Дата, Организация, Подразделение", Дата(1,1,1), Неопределено, Неопределено);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);
	КонецЕсли;
	
    Возврат СтруктураРеквизитов;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область Проведение

// Описывает учетные механизмы используемые в документе для регистрации в механизме проведения.
//
// Параметры:
//  МеханизмыДокумента - Массив - список имен учетных механизмов, для которых будет выполнена
//              регистрация в механизме проведения.
//
Процедура ЗарегистрироватьУчетныеМеханизмы(МеханизмыДокумента) Экспорт
	
	МеханизмыДокумента.Добавить("тн_РезервыПодОбесценениеТМЦ");
	
КонецПроцедуры

// Возвращает таблицы для движений, необходимые для проведения документа по регистрам учетных механизмов.
//
// Параметры:
//  Документ - ДокументСсылка, ДокументОбъект - ссылка на документ или объект, по которому необходимо получить данные
//  Регистры - Структура - список имен регистров, для которых необходимо получить таблицы
//  ДопПараметры - Структура - дополнительные параметры для получения данных, определяющие контекст проведения.
//
// Возвращаемое значение:
//  Структура - коллекция элементов:
//     * Таблица - ТаблицаЗначений - таблица данных для отражения в регистр.
//
Функция ДанныеДокументаДляПроведения(Документ, Регистры, ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = ПроведениеДокументов.ДопПараметрыИнициализироватьДанныеДокументаДляПроведения();
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.тн_НачислениеРезерваПодОбесценениеТМЦ") Тогда
		ДокументСсылка = Документ.Ссылка;
	Иначе
		ДокументСсылка = Документ;
	КонецЕсли;
	
	Запрос			= Новый Запрос;
	ТекстыЗапроса	= Новый СписокЗначений;
	
	Если Не ДопПараметры.ПолучитьТекстыЗапроса Тогда
		////////////////////////////////////////////////////////////////////////////
		// Создадим запрос инициализации движений
		
		ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
		
		////////////////////////////////////////////////////////////////////////////
		// Сформируем текст запроса
		
		ТекстЗапросаТаблицатн_РезервыПодОбесценениеТМЦ(Запрос, ТекстыЗапроса, Регистры);
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////
	// Получим таблицы для движений
	
	Возврат ПроведениеДокументов.ИнициализироватьДанныеДокументаДляПроведения(Запрос, ТекстыЗапроса, ДопПараметры);
	
КонецФункции

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка) Экспорт
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Подразделение КАК Подразделение,
	|	ДанныеДокумента.СтатьяРасходовДляНачисленияРезерва КАК СтатьяРасходовДляНачисленияРезерва,
	|	ДанныеДокумента.СтатьяДоходовДляВосстановленияРезерва КАК СтатьяДоходовДляВосстановленияРезерва,
	|	ДанныеДокумента.СтатьяАктиваПассиваДляОтраженияРезерва КАК СтатьяАктиваПассиваДляОтраженияРезерва
	|ИЗ
	|	Документ.тн_НачислениеРезерваПодОбесценениеТМЦ КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Ссылка"									,ДокументСсылка);
	Запрос.УстановитьПараметр("Период"									,Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация"								,Реквизиты.Организация);
	Запрос.УстановитьПараметр("Подразделение"							,Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("СтатьяРасходовДляНачисленияРезерва"		,Реквизиты.СтатьяРасходовДляНачисленияРезерва);
	Запрос.УстановитьПараметр("СтатьяДоходовДляВосстановленияРезерва"	,Реквизиты.СтатьяДоходовДляВосстановленияРезерва);
	Запрос.УстановитьПараметр("СтатьяАктиваПассиваДляОтраженияРезерва"	,Реквизиты.СтатьяАктиваПассиваДляОтраженияРезерва);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицатн_РезервыПодОбесценениеТМЦ(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "тн_РезервыПодОбесценениеТМЦ";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	Списание.Номенклатура КАК Номенклатура,
	|	Списание.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	// НАЧАЛО Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	|	&Организация КАК Организация,
	// КОНЕЦ Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	|	&Подразделение КАК Подразделение,
	// НАЧАЛО Борисенко Игорь 28.03.2025 Выполнение задач №000053206
	|	""Списание"" КАК Операция,
	// КОНЕЦ Борисенко Игорь 28.03.2025 Выполнение задач №000053206
	|	Списание.КоличествоРанееНачисленногоРезерва КАК Количество,
	|	Списание.СуммаРанееНачисленногоРезерваРегл КАК СуммаРезерваРегл,
	|	Списание.СуммаРанееНачисленногоРезерваУпр КАК СуммаРезерваУпр
	|ИЗ
	|	Документ.тн_НачислениеРезерваПодОбесценениеТМЦ.Списание КАК Списание
	|ГДЕ
	|	Списание.Ссылка = &Ссылка
	|	И (Списание.КоличествоРанееНачисленногоРезерва <> 0
	|			ИЛИ Списание.СуммаРанееНачисленногоРезерваРегл <> 0
	|			ИЛИ Списание.СуммаРанееНачисленногоРезерваУпр <> 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	Начисление.Номенклатура,
	|	Начисление.Номенклатура.ВидНоменклатуры,
	// НАЧАЛО Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	|	&Организация,
	// КОНЕЦ Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	|	&Подразделение,
	// НАЧАЛО Борисенко Игорь 28.03.2025 Выполнение задач №000053206
	|	""Начисление"" КАК Операция,
	// КОНЕЦ Борисенко Игорь 28.03.2025 Выполнение задач №000053206
	|	Начисление.КоличествоРезерваКНачислению,
	|	Начисление.СуммаРезерваКНачислениюРегл,
	|	Начисление.СуммаРезерваКНачислениюУпр
	|ИЗ
	|	Документ.тн_НачислениеРезерваПодОбесценениеТМЦ.Начисление КАК Начисление
	|ГДЕ
	|	Начисление.Ссылка = &Ссылка
	|	И (Начисление.КоличествоРезерваКНачислению <> 0
	|			ИЛИ Начисление.СуммаРезерваКНачислениюРегл <> 0
	|			ИЛИ Начисление.СуммаРезерваКНачислениюУпр <> 0)";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

