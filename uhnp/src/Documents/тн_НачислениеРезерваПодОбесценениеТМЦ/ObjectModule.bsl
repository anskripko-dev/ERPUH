Процедура ПроверитьСогласованностьСумм(Отказ)

	МассивСообщений = Новый Массив;
	
	Если Начисление.Итог("КоличествоРезерваКНачислению") <> Расчет.Итог("КоличествоРезерваКНачислению") Тогда
		СтрокаСообщения = " - в табл. частях ""Начисление"" и ""Расчет"" нарушено равество ""Количество резерва к начислению""";
		МассивСообщений.Добавить(СтрокаСообщения);
	КонецЕсли;
	Если Начисление.Итог("СуммаРезерваКНачислениюРегл") <> Расчет.Итог("СуммаРезерваКНачислениюРегл") Тогда
		СтрокаСообщения = " - в табл. частях ""Начисление"" и ""Расчет"" нарушено равество ""Сумма резерва к начислению регл.""";
		МассивСообщений.Добавить(СтрокаСообщения);
	КонецЕсли;
	Если Начисление.Итог("СуммаРезерваКНачислениюУпр") <> Расчет.Итог("СуммаРезерваКНачислениюУпр") Тогда
		СтрокаСообщения = " - в табл. частях ""Начисление"" и ""Расчет"" нарушено равество ""Сумма резерва к начислению упр.""";
		МассивСообщений.Добавить(СтрокаСообщения);
	КонецЕсли;

	Если Списание.Итог("КоличествоРанееНачисленногоРезерва") <> Расчет.Итог("КоличествоРанееНачисленногоРезерва") Тогда
		СтрокаСообщения = " - в табл. частях ""Списание"" и ""Расчет"" нарушено равество ""Количество ранее начисленного резерва""";
		МассивСообщений.Добавить(СтрокаСообщения);
	КонецЕсли;
	Если Списание.Итог("СуммаРанееНачисленногоРезерваРегл") <> Расчет.Итог("СуммаРанееНачисленногоРезерваРегл") Тогда
		СтрокаСообщения = " - в табл. частях ""Списание"" и ""Расчет"" нарушено равество ""Сумма ранее начисленного резерва регл.""";
		МассивСообщений.Добавить(СтрокаСообщения);
	КонецЕсли;
	Если Списание.Итог("СуммаРанееНачисленногоРезерваУпр") <> Расчет.Итог("СуммаРанееНачисленногоРезерваУпр") Тогда
		СтрокаСообщения = " - в табл. частях ""Списание"" и ""Расчет"" нарушено равество ""Сумма ранее начисленного резерва упр.""";
		МассивСообщений.Добавить(СтрокаСообщения);
	КонецЕсли;
	
	Если МассивСообщений.Количество() > 0 Тогда
		
		Отказ = Истина; //не проводим
		
		ПредставлениеОбъекта = СокрЛП(ЭтотОбъект);
		ТекстСообщения = СтрШаблон("Для %1:%2%3", ПредставлениеОбъекта,	Символы.ПС, СтрСоединить(МассивСообщений, Символы.ПС));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

#Область ПрочиеДоходыРасходы

Процедура СоздатьПрочиеДоходыРасходы(Отказ, РежимЗаписи)
	
	//Находим ранее созданные документы
	
	РегистрацияРасходов = Неопределено;
	РегистрацияДоходов 	= Неопределено;
	
	Выборка = ВыборкаСвязанныхПрочиеДоходыРасходы();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоРегистрацияРаходов Тогда
			РегистрацияРасходов = Выборка.Ссылка;
		ИначеЕсли Выборка.ЭтоРегистрацияДоходов Тогда
			РегистрацияДоходов = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	//Создаем/Актуализируем ПрочиеДоходыРасходы
	
	РаспровестиНеактуальныеПрочиеДоходыРасходы(Отказ, РежимЗаписи, Выборка);
	
	Если Не Отказ И Начисление.Количество() > 0 
		И (
				Начисление.Итог("СуммаРезерваКНачислениюУпр") <> 0
			Или Начисление.Итог("СуммаРезерваКНачислениюРегл") <> 0
		)
		Тогда
		СоздатьРегистрацияРасходов(РегистрацияРасходов, Отказ);
	КонецЕсли;
	
	Если Не Отказ И Списание.Количество() > 0 
		И (
				Списание.Итог("СуммаРанееНачисленногоРезерваУпр") <> 0
			Или Списание.Итог("СуммаРанееНачисленногоРезерваРегл") <> 0
		)
		Тогда
		СоздатьРегистрацияДоходов(РегистрацияДоходов, Отказ);
	КонецЕсли;

КонецПроцедуры

Функция ВыборкаСвязанныхПрочиеДоходыРасходы()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрочиеДоходыРасходы.Ссылка КАК Ссылка,
	|	ПрочиеДоходыРасходы.Проведен КАК Проведен,
	|	ВЫБОР
	|		КОГДА ПрочиеДоходыРасходы.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочиеРасходы)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоРегистрацияРаходов,
	|	ВЫБОР
	|		КОГДА ПрочиеДоходыРасходы.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочиеДоходы)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоРегистрацияДоходов
	|ИЗ
	|	Документ.ПрочиеДоходыРасходы КАК ПрочиеДоходыРасходы
	|ГДЕ
	|	ПрочиеДоходыРасходы.тн_ДокументОснование = &ТекущийДокумент
	|	И НЕ ПрочиеДоходыРасходы.ПометкаУдаления";
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Процедура РаспровестиНеактуальныеПрочиеДоходыРасходы(Отказ, РежимЗаписи, Выборка = Неопределено)
	
	Если Выборка = Неопределено Тогда
		Выборка = ВыборкаСвязанныхПрочиеДоходыРасходы();
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		НужноРаспровести = Ложь;
		
		Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И Выборка.Проведен Тогда
			НужноРаспровести = Истина;	
			
		ИначеЕсли Выборка.ЭтоРегистрацияРаходов И Начисление.Количество() = 0 Тогда
			НужноРаспровести = Истина;
			
		ИначеЕсли Выборка.ЭтоРегистрацияДоходов И Списание.Количество() = 0 Тогда
			НужноРаспровести = Истина;
			
		КонецЕсли;
		
		Если НужноРаспровести Тогда
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			Попытка
				
				УстановитьПривилегированныйРежим(Истина);
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				
			Исключение
				
				ТекстСообщения = СтрШаблон("Для: %1 не удалось отменить проведение: %2%3%4", СокрЛП(ЭтотОбъект), СокрЛП(ДокОбъект), Символы.ПС, ОписаниеОшибки());
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьРегистрацияРасходов(РегистрацияРасходов, Отказ)
	
	Если РегистрацияРасходов = Неопределено Тогда
		ДокОбъект = Документы.ПрочиеДоходыРасходы.СоздатьДокумент();
		ДокОбъект.Дата = Дата;
		ДокОбъект.УстановитьНовыйНомер();
	Иначе
		ДокОбъект = РегистрацияРасходов.ПолучитьОбъект();
	КонецЕсли;
	
	ДокОбъект.Дата = Дата;
	ДокОбъект.тн_ДокументОснование = Ссылка;
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочиеРасходы;
	ДокОбъект.Организация = Организация;
	ДокОбъект.Ответственный = Ответственный; 
	ДокОбъект.Основание = "Резерв под обесценение ТМЦ";
	ДокОбъект.Валюта = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
	
	ПредварительноЗаписатьПрочиеДоходыРасходы(ДокОбъект, Отказ); //нужна Ссылка для формирования НастройкаСчетовУчета
	
	//тч Расходы
	ДокОбъект.ПрочиеРасходы.Очистить();
	ДокОбъект.ПрочиеДоходы.Очистить();
	
	Для каждого СтрокаОснование Из Начисление Цикл
	
		СтрокаТЧ = ДокОбъект.ПрочиеРасходы.Добавить();
		
		СтрокаТЧ.СтатьяРасходов 		= СтатьяРасходовДляНачисленияРезерва;
		СтрокаТЧ.АналитикаРасходов 		= Подразделение;
		СтрокаТЧ.СтатьяАктивовПассивов 	= СтатьяАктиваПассиваДляОтраженияРезерва;
		СтрокаТЧ.Подразделение 			= Подразделение;
		СтрокаТЧ.СуммаБезНДС 			= СтрокаОснование.СуммаРезерваКНачислениюУпр;
		СтрокаТЧ.СуммаРегл 				= СтрокаОснование.СуммаРезерваКНачислениюРегл;
		СтрокаТЧ.ВременнаяРазница 		= СтрокаОснование.СуммаРезерваКНачислениюРегл;
		// НАЧАЛО Борисенко Игорь 28.03.2025 Выполнение задач №000053206
		СтрокаТЧ.Сумма 					= СтрокаТЧ.СуммаБезНДС;
		// КОНЕЦ Борисенко Игорь 28.03.2025 Выполнение задач №000053206
		// НАЧАЛО Борисенко Игорь 25.06.2025 Выполнение задач №000054206
		СтрокаТЧ.СуммаУпр				= СтрокаОснование.СуммаРезерваКНачислениюУпр;
		// КОНЕЦ Борисенко Игорь 25.06.2025 Выполнение задач №000054206
		
		лСчетУчета = ПланыСчетов.Хозрасчетный.РезервыПодСнижениеСтоимостиМатериалов; //14.01
		СтрокаТЧ.НастройкаСчетовУчета = Справочники.НастройкиСчетовУчетаПрочихОпераций.ВернутьНастройкаСчетовУчета(ДокОбъект.Ссылка, лСчетУчета, СтрокаОснование.Номенклатура);		
		
	КонецЦикла;
	
	//Проводим
	ПровестиПрочиеДоходыРасходы(ДокОбъект, Отказ);
	
КонецПроцедуры

Процедура СоздатьРегистрацияДоходов(РегистрацияДоходов, Отказ)
	
	Если РегистрацияДоходов = Неопределено Тогда
		ДокОбъект = Документы.ПрочиеДоходыРасходы.СоздатьДокумент();
		ДокОбъект.Дата = Дата;
		ДокОбъект.УстановитьНовыйНомер();
	Иначе
		ДокОбъект = РегистрацияДоходов.ПолучитьОбъект();
	КонецЕсли;
	
	ДокОбъект.Дата = Дата;
	ДокОбъект.тн_ДокументОснование = Ссылка;
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочиеДоходы;
	ДокОбъект.Организация = Организация;
	ДокОбъект.Ответственный = Ответственный; 
	ДокОбъект.Основание = "Резерв под обесценение ТМЦ";
	ДокОбъект.Валюта = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
	
	ПредварительноЗаписатьПрочиеДоходыРасходы(ДокОбъект, Отказ); //нужна Ссылка для формирования НастройкаСчетовУчета
	
	//тч Расходы
	ДокОбъект.ПрочиеРасходы.Очистить();
	ДокОбъект.ПрочиеДоходы.Очистить();
	
	Для каждого СтрокаОснование Из Списание Цикл
	
		СтрокаТЧ = ДокОбъект.ПрочиеДоходы.Добавить();
		
		СтрокаТЧ.СтатьяДоходов 			= СтатьяДоходовДляВосстановленияРезерва;
		СтрокаТЧ.АналитикаДоходов 		= Подразделение;
		СтрокаТЧ.СтатьяАктивовПассивов 	= СтатьяАктиваПассиваДляОтраженияРезерва;
		СтрокаТЧ.Подразделение 			= Подразделение;
		СтрокаТЧ.СуммаУпр 				= СтрокаОснование.СуммаРанееНачисленногоРезерваУпр;
		СтрокаТЧ.СуммаРегл 				= СтрокаОснование.СуммаРанееНачисленногоРезерваРегл;
		СтрокаТЧ.ВременнаяРазница 		= СтрокаОснование.СуммаРанееНачисленногоРезерваРегл;
		// НАЧАЛО Борисенко Игорь 28.03.2025 Выполнение задач №000053206
		СтрокаТЧ.Сумма 					= СтрокаТЧ.СуммаУпр;
		// КОНЕЦ Борисенко Игорь 28.03.2025 Выполнение задач №000053206
		// НАЧАЛО Борисенко Игорь 25.06.2025 Выполнение задач №000054206
		СтрокаТЧ.СуммаУпр				= СтрокаОснование.СуммаРанееНачисленногоРезерваУпр;
		// КОНЕЦ Борисенко Игорь 25.06.2025 Выполнение задач №000054206
		
		лСчетУчета = ПланыСчетов.Хозрасчетный.РезервыПодСнижениеСтоимостиМатериалов; //14.01
		СтрокаТЧ.НастройкаСчетовУчета = Справочники.НастройкиСчетовУчетаПрочихОпераций.ВернутьНастройкаСчетовУчета(ДокОбъект.Ссылка, лСчетУчета, СтрокаОснование.Номенклатура);		
		
	КонецЦикла;
	
	//Проводим
	ПровестиПрочиеДоходыРасходы(ДокОбъект, Отказ);
	
КонецПроцедуры

Процедура ПредварительноЗаписатьПрочиеДоходыРасходы(ДокОбъект, Отказ)
	
	Если Не ОбщегоНазначения.СсылкаСуществует(ДокОбъект.Ссылка) Тогда
		Попытка
			
			УстановитьПривилегированныйРежим(Истина);
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			
		Исключение
			
			ТекстСообщения = СтрШаблон("Для: %1 не удалось создать: %2%3%4", СокрЛП(ЭтотОбъект), СокрЛП(ДокОбъект), Символы.ПС, ОписаниеОшибки());
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			
			Возврат;
		КонецПопытки
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПровестиПрочиеДоходыРасходы(ДокОбъект, Отказ)
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		ДокОбъект.ОбменДанными.Загрузка = Ложь;
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		
		ТекстСообщения = СтрШаблон("Для: %1 не удалось провести: %2%3%4", СокрЛП(ЭтотОбъект), СокрЛП(ДокОбъект), Символы.ПС, ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		
	КонецПопытки
	
КонецПроцедуры

