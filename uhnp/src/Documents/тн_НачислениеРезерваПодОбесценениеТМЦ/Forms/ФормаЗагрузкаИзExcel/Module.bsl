
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтотОбъект.ВидНоменклатурыОтборИспользование = Параметры.ВидНоменклатурыОтборИспользование;
	ЭтотОбъект.ВидНоменклатурыОтборВидСравнения = Параметры.ВидНоменклатурыОтборВидСравнения;
	ЭтотОбъект.ВидыНоменклатурыОтборЗначение = Параметры.ВидыНоменклатурыОтборЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьПустыеНастройки();
КонецПроцедуры

#КонецОбласти

#Область СобытияЭлементовФормы

&НаКлиенте
Процедура ДанныеФайлаНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДанныеФайла.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьПоНоменклатуре(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ПрочитатьExcel(Команда)
	ВыбратьФайлы();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВДокумент(Команда)
	
	//Отправляем ответ формы
	ПараметрыОтвета = Новый Структура("АдресВоВременномХранилище", ПоместитьДанныеФайлаВоВременноеХранилище());
	Закрыть(ПараметрыОтвета);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеФайлаВоВременноеХранилище()

	ВыгружаемаяТЗ = ДанныеФайла.Выгрузить();

	//Отфильтруем строки по ВидНоменклатуры
	Поиск = Новый Структура("ОтборПоВидНоменклатура", Ложь);
	СтрокиСЧужойВидНоменклатуры = ВыгружаемаяТЗ.НайтиСтроки(Поиск);
	Для каждого СтрокаТЗ Из СтрокиСЧужойВидНоменклатуры Цикл
		ВыгружаемаяТЗ.Удалить(СтрокаТЗ);
	КонецЦикла;

	//Отфильтруем строки с несопоставленной Номенклатурой
	Поиск = Новый Структура("Номенклатура", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	СтрокиСПустойНоменклатурой = ВыгружаемаяТЗ.НайтиСтроки(Поиск);
	Для каждого СтрокаТЗ Из СтрокиСПустойНоменклатурой Цикл
		ВыгружаемаяТЗ.Удалить(СтрокаТЗ);
	КонецЦикла;
	
	ВыгружаемаяТЗ.Свернуть("Номенклатура","КоличествоРезерваКНачислению,СуммаРезерваКНачислениюРегл,СуммаРезерваКНачислениюУпр");
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ВыгружаемаяТЗ);
	
	Возврат АдресВоВременномХранилище;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьПустыеНастройки()
	
	Если Настройка_НомерПервойСтроки = 0 Тогда
		Настройка_НомерПервойСтроки = 1 ;
	КонецЕсли;
	Если Настройка_НомерКолонки_КодНоменклатуры = 0 Тогда
		Настройка_НомерКолонки_КодНоменклатуры = 1 ;
	КонецЕсли;
	Если Настройка_НомерКолонки_КоличествоРезерваКНачислению = 0 Тогда
		Настройка_НомерКолонки_КоличествоРезерваКНачислению = 1 ;
	КонецЕсли;
	Если Настройка_НомерКолонки_СуммаРезерваКНачислениюРегл = 0 Тогда
		Настройка_НомерКолонки_СуммаРезерваКНачислениюРегл = 1 ;
	КонецЕсли;
	Если Настройка_НомерКолонки_СуммаРезерваКНачислениюУпр = 0 Тогда
		Настройка_НомерКолонки_СуммаРезерваКНачислениюУпр = 1 ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоНоменклатуре(СтрокаИД)
	
	СтрокаТЗ = ДанныеФайла.НайтиПоИдентификатору(СтрокаИД);
	
	//Заполним поля ЕдиницаИзмерения, ВидНоменклатуры
	Если ЗначениеЗаполнено(СтрокаТЗ.Номенклатура) Тогда
		
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЗ.Номенклатура, "ЕдиницаИзмерения, ВидНоменклатуры");
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, РеквизитыНоменклатуры);
		
	Иначе
		
		СтрокаТЗ.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		СтрокаТЗ.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
		
	КонецЕсли;
	
	//Установим ОтборПоВидНоменклатура
	Если ВидНоменклатурыОтборИспользование = Истина Тогда
		
		Если ВидНоменклатурыОтборВидСравнения = "ВСписке" Тогда
			СтрокаТЗ.ОтборПоВидНоменклатура = ВидыНоменклатурыОтборЗначение.НайтиПоЗначению(СтрокаТЗ.ВидНоменклатуры) <> Неопределено; //ВСписке
		Иначе //НеВСписке
			СтрокаТЗ.ОтборПоВидНоменклатура = ВидыНоменклатурыОтборЗначение.НайтиПоЗначению(СтрокаТЗ.ВидНоменклатуры) = Неопределено; //НеВСписке
		КонецЕсли;
		
	Иначе
		СтрокаТЗ.ОтборПоВидНоменклатура = Истина; //ограничений по ВидНоменклатура нет
	КонецЕсли;
	
КонецПроцедуры
	
#Область ЧтениеExcel

&НаКлиенте
Процедура ВыбратьФайлы()

	Оповещение = Новый ОписаниеОповещения("Ответ_НачатьПомещениеФайлаНаСервер", ЭтотОбъект);
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "(*.xlsx)|*.xlsx";
	НачатьПомещениеФайлаНаСервер(Оповещение,,,,ПараметрыДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура Ответ_НачатьПомещениеФайлаНаСервер(ОписаниеПомещеногоФайла, Параметры) Экспорт
	
	Если ОписаниеПомещеногоФайла = Неопределено Или ОписаниеПомещеногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	АдресВременногоХранилищаФайла = ОписаниеПомещеногоФайла.Адрес;
	Расширение = ОписаниеПомещеногоФайла.СсылкаНаФайл.Файл.Расширение;
	ПрочитатьExcelСервер(АдресВременногоХранилищаФайла, Расширение);
	
	СопоставитьНоменклатуру();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьExcelСервер(АдресВременногоХранилищаФайла, Расширение)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаФайла);
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяФайла);
	
	табДок = Новый ТабличныйДокумент;
	
	Попытка
		табДок.Прочитать(ИмяФайла);
		УдалитьФайлы(ИмяФайла);
		
	Исключение
		
		ТекстСообщения = СтрШаблон("Не удалось прочитать файл %1: %2", ИмяФайла, ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецПопытки;
	
	КоличествоСтрок = табДок.ВысотаТаблицы;
	
	Для сч = Настройка_НомерПервойСтроки По КоличествоСтрок Цикл
		//Если Сч > 20 Тогда
		//	Прервать;
		//КонецЕсли;
		Если СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  Настройка_НомерКолонки_КодНоменклатуры).ТекущаяОбласть.Текст) = "" Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаТЗ = ДанныеФайла.Добавить();
		СтрокаТЗ.КодНоменклатуры 				= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + Настройка_НомерКолонки_КодНоменклатуры).ТекущаяОбласть.Текст);
		СтрокаТЗ.КоличествоРезерваКНачислению	= _Число(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + Настройка_НомерКолонки_КоличествоРезерваКНачислению).ТекущаяОбласть.Текст);
		СтрокаТЗ.СуммаРезерваКНачислениюРегл	= _Число(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + Настройка_НомерКолонки_СуммаРезерваКНачислениюРегл).ТекущаяОбласть.Текст);
		СтрокаТЗ.СуммаРезерваКНачислениюУпр		= _Число(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + Настройка_НомерКолонки_СуммаРезерваКНачислениюУпр).ТекущаяОбласть.Текст);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция _Число(ЗначениеСтрокой)
	//  17 672,25
	Попытка
		
		Если ЗначениеСтрокой = "" Тогда
			Возврат 0;
		Иначе
			Возврат Число(СтрЗаменить(ЗначениеСтрокой,Символы.НПП,""));
		КонецЕсли;
		
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура СопоставитьНоменклатуру()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДанныеФайла", ДанныеФайла.Выгрузить());
	Запрос.УстановитьПараметр("СписокВидовНоменклатуры", ВидыНоменклатурыОтборЗначение.ВыгрузитьЗначения());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеФайла.КодНоменклатуры КАК КодНоменклатуры
	|ПОМЕСТИТЬ вт_ДанныеФайла
	|ИЗ
	|	&ДанныеФайла КАК ДанныеФайла
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеФайла.КодНоменклатуры КАК КодНоменклатуры,
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ВЫБОР
	|		КОГДА &УсловиеОтбораПоВидНоменклатуры
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОтборПоВидНоменклатура
	|ИЗ
	|	вт_ДанныеФайла КАК ДанныеФайла
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	// НАЧАЛО Борисенко Игорь 28.03.2025 Выполнение задач №000053206
	//|		ПО ДанныеФайла.КодНоменклатуры = Номенклатура.Код";
	|		ПО ДанныеФайла.КодНоменклатуры = Номенклатура.Код
	|		И Не Номенклатура.ПометкаУдаления
	|		И Не Номенклатура.ЭтоГруппа
	|";
	// КОНЕЦ Борисенко Игорь 28.03.2025 Выполнение задач №000053206

	Если ВидНоменклатурыОтборИспользование = Истина Тогда
		
		Если ВидНоменклатурыОтборВидСравнения = Строка(ВидСравнения.ВСписке) Тогда 
			УсловиеОтбораПоВидНоменклатуры = "Номенклатура.ВидНоменклатуры В (&СписокВидовНоменклатуры)";
		Иначе //НеВСписке
			УсловиеОтбораПоВидНоменклатуры = "НЕ Номенклатура.ВидНоменклатуры В (&СписокВидовНоменклатуры)";
		КонецЕсли;
		
	Иначе //отбор по ВидамНоменклатуры не используется
		УсловиеОтбораПоВидНоменклатуры = "ИСТИНА";
		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораПоВидНоменклатуры", УсловиеОтбораПоВидНоменклатуры);

	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Поиск = Новый Структура("КодНоменклатуры");
	
	Для каждого СтрокаТЗ Из ДанныеФайла Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЗ.КодНоменклатуры) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.КодНоменклатуры = СтрокаТЗ.КодНоменклатуры;
		Выборка.Сбросить();
		Если Выборка.НайтиСледующий(Поиск) Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
