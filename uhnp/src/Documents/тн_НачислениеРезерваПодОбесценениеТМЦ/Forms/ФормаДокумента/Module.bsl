&НаСервере
Процедура ПеренестиДанныеФайлаВДокумент(АдресВоВременномХранилище)
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	Если ТипЗнч(ДанныеФайла) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Расчет.Очистить();
	
	Для каждого СтрокаТЗ Из ДанныеФайла Цикл
		
		СтрокаТЧ = Объект.Расчет.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
		
	КонецЦикла;

	// НАЧАЛО Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	//ЗаполнитьСписанияВРасчете();
	//
	////тч Начисление
	//ПеренестиНачисленияИзРасчета();
	//
	////тч Списание
	//ПеренестиСписанияИзРасчета();
	// КОНЕЦ Борисенко Игорь 20.03.2025 Выполнение задач №000053111

	ЗаполнитьДопКолонкиПоНоменклатуреВТабличныхЧастях();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписанияВРасчете()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаРанееНачисленныхОстатков", НачалоМесяца(Объект.Дата) - 1);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.УстановитьПараметр("ТЧ", Объект.Расчет.Выгрузить(,"Номенклатура"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&Подразделение КАК Подразделение
	|ПОМЕСТИТЬ вт_Расчет
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_Расчет.Номенклатура КАК Номенклатура,
	|	СпрНоменклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	вт_Расчет.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ вт_Отбор
	|ИЗ
	|	вт_Расчет КАК вт_Расчет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО вт_Расчет.Номенклатура = СпрНоменклатура.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Резервы.Номенклатура КАК Номенклатура,
	|	Резервы.КоличествоОстаток КАК КоличествоРанееНачисленногоРезерва,
	|	Резервы.СуммаРезерваРеглОстаток КАК СуммаРанееНачисленногоРезерваРегл,
	|	Резервы.СуммаРезерваУпрОстаток КАК СуммаРанееНачисленногоРезерваУпр
	|ИЗ
	|	РегистрНакопления.тн_РезервыПодОбесценениеТМЦ.Остатки(
	|			&ДатаРанееНачисленныхОстатков,
	|			(Номенклатура, ВидНоменклатуры, Подразделение) В
	|				(ВЫБРАТЬ
	|					вт_Отбор.Номенклатура КАК Номенклатура,
	|					вт_Отбор.ВидНоменклатуры,
	|					вт_Отбор.Подразделение КАК ВидНоменклатуры
	|				ИЗ
	|					вт_Отбор)) КАК Резервы";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Поиск = Новый Структура("Номенклатура");
	
	Для каждого СтрокаТЧ Из Объект.Расчет Цикл
		
		Поиск.Номенклатура = СтрокаТЧ.Номенклатура;
		Выборка.Сбросить();
		// НАЧАЛО Борисенко Игорь 19.03.2025 Выполнение задач №000053091
		//Если Выборка.Следующий() Тогда
		Если Выборка.НайтиСледующий(Поиск) Тогда
		// КОНЕЦ Борисенко Игорь 19.03.2025 Выполнение задач №000053091
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

