	|			ИЛИ втРасчет.СуммаРезерваКНачислениюРегл <> 0
	|			ИЛИ втРасчет.СуммаРезерваКНачислениюУпр <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	втРасчет.Номенклатура";
	тзНачисление = Запрос.Выполнить().Выгрузить();
	
	// КОНЕЦ Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	Объект.Начисление.Загрузить(тзНачисление);
	
