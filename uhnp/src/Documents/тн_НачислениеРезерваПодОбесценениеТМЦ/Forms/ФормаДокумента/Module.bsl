&НаСервере
Процедура НастроитьФормуНаСервере()

	//ВидыНоменклатурыОтбор
	Элементы.ОтборПоВсемВидамНоменклатуры.Видимость = Не Объект.ВидНоменклатурыОтборИспользование;
	Элементы.ВидНоменклатурыОтборВидСравнения.Видимость = Объект.ВидНоменклатурыОтборИспользование;
	Элементы.ВидыНоменклатурыОтборЗначение.Видимость = Объект.ВидНоменклатурыОтборИспользование;

КонецПроцедуры

#Область ЗаполнитьДопКолонкиПоНоменклатуре

&НаСервере
Процедура ЗаполнитьДопКолонкиПоНоменклатуреВТабличныхЧастях()
	
	ЗаполнитьДопКолонкиПоНоменклатуре("Расчет");
	ЗаполнитьДопКолонкиПоНоменклатуре("Начисление");
	ЗаполнитьДопКолонкиПоНоменклатуре("Списание");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДопКолонкиПоНоменклатуре(ИмяТЧ, СтрокаИД = Неопределено)
	
	ТЧ = Объект[ИмяТЧ];
	
	Если ЗначениеЗаполнено(СтрокаИД) Тогда
		
		СтрокаТЧ = ТЧ.НайтиПоИдентификатору(СтрокаИД);
		ПереченьНоменклатуры = Новый Массив;
		ПереченьНоменклатуры.Добавить(СтрокаТЧ.Номенклатура);
		
	Иначе
		
		ПереченьНоменклатуры = ТЧ.Выгрузить(,"Номенклатура");
		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПереченьНоменклатуры", ПереченьНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Код КАК КодНоменклатуры,
	|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&ПереченьНоменклатуры)";
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
		
	Если ЗначениеЗаполнено(СтрокаИД) Тогда //для отдельной строки ТЧ
		
		ЗаполнитьДопКолонкиПоНоменклатуреДляСтрокиТЧ(СтрокаТЧ, Выборка);		
		
	Иначе //для всех строк ТЧ
		
		Для каждого СтрокаТЧ Из ТЧ Цикл
			ЗаполнитьДопКолонкиПоНоменклатуреДляСтрокиТЧ(СтрокаТЧ, Выборка);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДопКолонкиПоНоменклатуреДляСтрокиТЧ(СтрокаТЧ, Выборка)
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда

		Выборка.Сбросить();
		Выборка.НайтиСледующий(Новый Структура("Номенклатура", СтрокаТЧ.Номенклатура));
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка); //КодНоменклатуры, ВидНоменклатуры, ЕдиницаИзмерения
			
	Иначе //пустая Номенклатура
		
		СтрокаТЧ.КодНоменклатуры = "";
		СтрокаТЧ.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
		СтрокаТЧ.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти 

#Область ВидыНоменклатурыОтбор

&НаСервере
Процедура СохранитьВидыНоменклатурыОтбор()
	
	//ВидыНоменклатурыОтборЗначение
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, ВидыНоменклатурыОтборЗначение);
	Объект.ВидыНоменклатурыОтборЗначение = ЗаписьXML.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьВидыНоменклатурыОтбор()

	//ВидыНоменклатурыОтборЗначение
	Если ЗначениеЗаполнено(Объект.ВидыНоменклатурыОтборЗначение) Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Объект.ВидыНоменклатурыОтборЗначение);
		ВидыНоменклатурыОтборЗначение = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	Иначе
		ВидыНоменклатурыОтборЗначение.Очистить();
	КонецЕсли;
	
	//ВидНоменклатурыОтборВидСравнения
	СписокВидовСравнения = Новый Массив;
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.ВСписке));
	СписокВидовСравнения.Добавить(Строка(ВидСравнения.НеВСписке));
	
	Элементы.ВидНоменклатурыОтборВидСравнения.СписокВыбора.ЗагрузитьЗначения(СписокВидовСравнения);
	
	Если Не ЗначениеЗаполнено(Объект.ВидНоменклатурыОтборВидСравнения) Тогда
		Объект.ВидНоменклатурыОтборВидСравнения = Строка(ВидСравнения.ВСписке);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Заполнить

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Объект.Расчет.Очистить();
	
	//
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокВидовНоменклатуры", ВидыНоменклатурыОтборЗначение.ВыгрузитьЗначения());
	// НАЧАЛО Борисенко Игорь 29.05.2025 Выполнение задач №000053852
	//Запрос.УстановитьПараметр("ДатаДок", Объект.Дата);
	Запрос.УстановитьПараметр("ДатаДок", КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("ГраницаОстатков", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	// КОНЕЦ Борисенко Игорь 29.05.2025 Выполнение задач №000053852
	Запрос.УстановитьПараметр("ДатаРанееНачисленныхОстатков", НачалоМесяца(Объект.Дата) - 1);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры
	|ПОМЕСТИТЬ вт_ВидыНоменклатурыОтбор
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	НЕ ВидыНоменклатуры.ПометкаУдаления
	|	И &УсловиеОтбораПоВидНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыРасчета.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ПараметрыРасчета.КоличествоДней КАК КоличествоДней,
	// НАЧАЛО Борисенко Игорь 29.05.2025 Выполнение задач №000053852
	//|	ДОБАВИТЬКДАТЕ(&ДатаДок, ДЕНЬ, -1 * ПараметрыРасчета.КоличествоДней) КАК НачалоПериодаАнализаНеликвидности,
	|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаДок, ДЕНЬ, -1 * ПараметрыРасчета.КоличествоДней), ДЕНЬ) КАК НачалоПериодаАнализаНеликвидности,
	// КОНЕЦ Борисенко Игорь 29.05.2025 Выполнение задач №000053852
	|	ПараметрыРасчета.ПроцентДляРезерва КАК ПроцентДляРезерва
	|ПОМЕСТИТЬ вт_ПараметрыРасчета
	|ИЗ
	|	РегистрСведений.тн_ПараметрыРасчетаРезерваПодОбесценениеТМЦ.СрезПоследних(
	|			&ДатаДок,
	|			ВидНоменклатуры В
	|				(ВЫБРАТЬ
	|					вт_ВидыНоменклатурыОтбор.ВидНоменклатуры КАК ВидНоменклатуры
	|				ИЗ
	|					вт_ВидыНоменклатурыОтбор)) КАК ПараметрыРасчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// НАЧАЛО Борисенко Игорь 29.05.2025 Выполнение задач №000053852
	//|ВЫБРАТЬ
	//|	Себестоимость.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	//|	Себестоимость.КоличествоОстаток КАК КоличествоОстатковНаКонецПериода,
	//|	Себестоимость.СтоимостьРеглОстаток + Себестоимость.ДопРасходыРеглОстаток + Себестоимость.ТрудозатратыРеглОстаток + Себестоимость.ПостатейныеПостоянныеРеглОстаток + Себестоимость.ПостатейныеПеременныеРеглОстаток КАК СуммаОстатковНаКонецПериодаРегл,
	//|	Себестоимость.СтоимостьУпрОстаток + Себестоимость.ДопРасходыУпрОстаток + Себестоимость.ТрудозатратыУпрОстаток + Себестоимость.ПостатейныеПостоянныеУпрОстаток + Себестоимость.ПостатейныеПеременныеУпрОстаток КАК СуммаОстатковНаКонецПериодаУпр
	//|ПОМЕСТИТЬ вт_Остатки
	//|ИЗ
	//|	РегистрНакопления.СебестоимостьТоваров.Остатки(
	//|			&ДатаДок,
	//|			Организация = &Организация
	//|				И АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры В
	//|					(ВЫБРАТЬ
	//|						вт_ПараметрыРасчета.ВидНоменклатуры КАК ВидНоменклатуры
	//|					ИЗ
	//|						вт_ПараметрыРасчета)) КАК Себестоимость
	//|ГДЕ
	//|	Себестоимость.КоличествоОстаток > 0
