// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Асинх Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ПоказатьПредупреждение(,"Не заполнена Организация");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		ПоказатьПредупреждение(,"Не заполнена Подразделение");
		Возврат;
	КонецЕсли;
	
	ТаблицыЗаполнены = Объект.Расчет.Количество() > 0 Или Объект.Начисление.Количество() > 0 Или Объект.Списание.Количество() > 0;
	Если ТаблицыЗаполнены Тогда
		
		Обещание = ВопросАсинх("Существующие строки всех таблиц будут удалены. Продолжить?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		Ответ = Ждать Обещание;
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьИзExcel(Команда)
	
	ТаблицыЗаполнены = Объект.Расчет.Количество() > 0 Или Объект.Начисление.Количество() > 0 Или Объект.Списание.Количество() > 0;
	Если ТаблицыЗаполнены Тогда
		
		Обещание = ВопросАсинх("Существующие строки всех таблиц будут удалены. Продолжить?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		Ответ = Ждать Обещание;
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	//Открываем форму чтения файла Excel
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ВидНоменклатурыОтборИспользование", Объект.ВидНоменклатурыОтборИспользование);
	ПараметрыФормы.Вставить("ВидНоменклатурыОтборВидСравнения", Объект.ВидНоменклатурыОтборВидСравнения);
	ПараметрыФормы.Вставить("ВидыНоменклатурыОтборЗначение", ВидыНоменклатурыОтборЗначение);
	
	Оповещение = Новый ОписаниеОповещения("Ответ_ЗагрузитьИзExcel", ЭтотОбъект);
	ОткрытьФорму("Документ.тн_НачислениеРезерваПодОбесценениеТМЦ.Форма.ФормаЗагрузкаИзExcel", ПараметрыФормы, ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

