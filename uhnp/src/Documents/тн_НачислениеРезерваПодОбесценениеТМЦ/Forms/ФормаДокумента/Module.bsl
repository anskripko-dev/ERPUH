	|	&Подразделение КАК Подразделение,
	|	вт_ПараметрыРасчета.НачалоПериодаАнализаНеликвидности КАК НачалоПериодаАнализаНеликвидности,
	|	СУММА(вт_Свод.КоличествоОстатковНаКонецПериода) КАК КоличествоОстатковНаКонецПериода,
	|	СУММА(вт_Свод.СуммаОстатковНаКонецПериодаРегл) КАК СуммаОстатковНаКонецПериодаРегл,
	|	СУММА(вт_Свод.СуммаОстатковНаКонецПериодаУпр) КАК СуммаОстатковНаКонецПериодаУпр,
	|	МАКСИМУМ(вт_Свод.СтоимостьЗаЕдиницуРегл) КАК СтоимостьЗаЕдиницуРегл,
	|	МАКСИМУМ(вт_Свод.СтоимостьЗаЕдиницуУпр) КАК СтоимостьЗаЕдиницуУпр,
	|	СУММА(вт_Свод.КоличествоПриходЗаПериод) КАК КоличествоПриходЗаПериод,
	|	МАКСИМУМ(вт_Свод.ОборачиваемостьПоКоличеству) КАК ОборачиваемостьПоКоличеству,
	|	СУММА(вт_Свод.КоличествоРезерваКНачислению) КАК КоличествоРезерваКНачислению,
	|	СУММА(вт_Свод.СуммаРезерваКНачислениюРегл) КАК СуммаРезерваКНачислениюРегл,
	|	СУММА(вт_Свод.СуммаРезерваКНачислениюУпр) КАК СуммаРезерваКНачислениюУпр,
	// НАЧАЛО Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	//|	СУММА(вт_Свод.КоличествоРанееНачисленногоРезерва) КАК КоличествоРанееНачисленногоРезерва,
	//|	СУММА(вт_Свод.СуммаРанееНачисленногоРезерваРегл) КАК СуммаРанееНачисленногоРезерваРегл,
	//|	СУММА(вт_Свод.СуммаРанееНачисленногоРезерваУпр) КАК СуммаРанееНачисленногоРезерваУпр
	|	0 КАК КоличествоРанееНачисленногоРезерва,
	|	0 КАК СуммаРанееНачисленногоРезерваРегл,
	|	0 КАК СуммаРанееНачисленногоРезерваУпр
	// КОНЕЦ Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	|ИЗ
	|	вт_Свод КАК вт_Свод
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ПараметрыРасчета КАК вт_ПараметрыРасчета
	|		ПО вт_Свод.Номенклатура.ВидНоменклатуры = вт_ПараметрыРасчета.ВидНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_Свод.Номенклатура,
	|	вт_ПараметрыРасчета.НачалоПериодаАнализаНеликвидности";
	
	//УсловиеОтбораПоВидНоменклатуры
	Если Объект.ВидНоменклатурыОтборИспользование = Истина Тогда
		
		Если Объект.ВидНоменклатурыОтборВидСравнения = Строка(ВидСравнения.ВСписке) Тогда 
			УсловиеОтбораПоВидНоменклатуры = "ВидыНоменклатуры.Ссылка В (&СписокВидовНоменклатуры)";
		Иначе //НеВСписке
			УсловиеОтбораПоВидНоменклатуры = "НЕ ВидыНоменклатуры.Ссылка В (&СписокВидовНоменклатуры)";
		КонецЕсли;
		
	Иначе //отбор по ВидамНоменклатуры не используется
		УсловиеОтбораПоВидНоменклатуры = "ИСТИНА";
		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораПоВидНоменклатуры", УсловиеОтбораПоВидНоменклатуры);
	
	УстановитьПривилегированныйРежим(Истина);
	тзРасчет = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);

	//тч Расчет
	Объект.Расчет.Загрузить(тзРасчет); 
	
	// НАЧАЛО Борисенко Игорь 20.03.2025 Выполнение задач №000053111
	////тч Начисление
	//ПеренестиНачисленияИзРасчета();
	//
	////тч Списание
	//ПеренестиСписанияИзРасчета();
	// КОНЕЦ Борисенко Игорь 20.03.2025 Выполнение задач №000053111

	ЗаполнитьДопКолонкиПоНоменклатуреВТабличныхЧастях();
	
КонецПроцедуры

&НаКлиенте
Процедура Ответ_ЗагрузитьИзExcel(Ответ, ДопПараметры) Экспорт
	
	Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("АдресВоВременномХранилище") Тогда
		ПеренестиДанныеФайлаВДокумент(Ответ.АдресВоВременномХранилище);
	КонецЕсли;
	
