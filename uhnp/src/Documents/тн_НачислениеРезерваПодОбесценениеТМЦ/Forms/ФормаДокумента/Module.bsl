&НаСервере
Процедура ЗаполнитьРанееНачисленныеРезервыСервер()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокВидовНоменклатуры", ВидыНоменклатурыОтборЗначение.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ДатаРанееНачисленныхОстатков", НачалоМесяца(Объект.Дата) - 1);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры
	|ПОМЕСТИТЬ вт_ВидыНоменклатурыОтбор
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	НЕ ВидыНоменклатуры.ПометкаУдаления
	|	И &УсловиеОтбораПоВидНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Резервы.Номенклатура КАК Номенклатура,
	|	Резервы.КоличествоОстаток КАК КоличествоРанееНачисленногоРезерва,
	|	Резервы.СуммаРезерваРеглОстаток КАК СуммаРанееНачисленногоРезерваРегл,
	|	Резервы.СуммаРезерваУпрОстаток КАК СуммаРанееНачисленногоРезерваУпр
	|ИЗ
	|	РегистрНакопления.тн_РезервыПодОбесценениеТМЦ.Остатки(
	|			&ДатаРанееНачисленныхОстатков,
	|			Организация = &Организация
	|				И Подразделение = &Подразделение
	|				И ВидНоменклатуры В
	|					(ВЫБРАТЬ
	|						вт_ВидыНоменклатурыОтбор.ВидНоменклатуры КАК ВидНоменклатуры
	|					ИЗ
	|						вт_ВидыНоменклатурыОтбор)) КАК Резервы";
	
	//УсловиеОтбораПоВидНоменклатуры
	Если Объект.ВидНоменклатурыОтборИспользование = Истина Тогда
		
		Если Объект.ВидНоменклатурыОтборВидСравнения = Строка(ВидСравнения.ВСписке) Тогда 
			УсловиеОтбораПоВидНоменклатуры = "ВидыНоменклатуры.Ссылка В (&СписокВидовНоменклатуры)";
		Иначе //НеВСписке
			УсловиеОтбораПоВидНоменклатуры = "НЕ ВидыНоменклатуры.Ссылка В (&СписокВидовНоменклатуры)";
		КонецЕсли;
		
	Иначе //отбор по ВидамНоменклатуры не используется
		УсловиеОтбораПоВидНоменклатуры = "ИСТИНА";
		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораПоВидНоменклатуры", УсловиеОтбораПоВидНоменклатуры);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);

	//тч Расчет
	Поиск = Новый Структура("Номенклатура");
	Пока Выборка.Следующий() Цикл
		
		Поиск.Номенклатура = Выборка.Номенклатура;
		СтрокиРасчет = Объект.Расчет.НайтиСтроки(Поиск);
		Если СтрокиРасчет.Количество() = 0 Тогда
			СтрокаРасчет = Объект.Расчет.Добавить();
		Иначе
			СтрокаРасчет = СтрокиРасчет[0];
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчет, Выборка); //Номенклатура, КоличествоРанееНачисленногоРезерва, СуммаРанееНачисленногоРезерваРегл, СуммаРанееНачисленногоРезерваУпр
		
	КонецЦикла;

	ЗаполнитьДопКолонкиПоНоменклатуреВТабличныхЧастях();

КонецПроцедуры

