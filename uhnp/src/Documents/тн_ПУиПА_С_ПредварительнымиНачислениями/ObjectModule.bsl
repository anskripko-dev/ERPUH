#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ОписаниеОшибки", "");
	
	ДополнительныеРеквизиты = ХранилищеДополнительныхРеквизитов.Получить();
	Если ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура")
		И ДополнительныеРеквизиты.Свойство("ПропуститьПроверкуЗапретаИзменения") Тогда
		ДополнительныеРеквизиты.Удалить("ПропуститьПроверкуЗапретаИзменения");
	КонецЕсли;

	ОформитьСвязанныеДокументы(ДополнительныеРеквизиты, Отказ, Результат);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	//Действия со связанными документами
	Действие = "УдалитьПроведение";
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка);	
	ВыполнитьДействияНадСвязаннымиДокументами(СтруктураДокументы.ПриобретениеУслугПрочихАктивов, Действие); 
	ВыполнитьДействияНадСвязаннымиДокументами(СтруктураДокументы.ПрочиеДоходыРасходы, Действие);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		
	//Действия со связанными документами	
	Если ЭтотОбъект.ПометкаУдаления Тогда 
		Действие = "УстановитьПометкуУдаления"; 	
	Иначе
		Действие = "СнятьПометкуУдаления";
	КонецЕсли;
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка);	
	ВыполнитьДействияНадСвязаннымиДокументами(СтруктураДокументы.ПриобретениеУслугПрочихАктивов, Действие); 
	ВыполнитьДействияНадСвязаннымиДокументами(СтруктураДокументы.ПрочиеДоходыРасходы, Действие);	
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

Процедура ОформитьСвязанныеДокументы(ДополнительныеРеквизиты, Отказ, Результат)
	
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка);	
	
	ОформитьПриобретениеУслугПрочихАктивов(СтруктураДокументы.ПриобретениеУслугПрочихАктивов, ДополнительныеРеквизиты, Отказ, Результат);
	ОформитьПрочиеДоходыРасходы(СтруктураДокументы.ПрочиеДоходыРасходы, ДополнительныеРеквизиты, Отказ, Результат);
	
КонецПроцедуры

Процедура ОформитьПриобретениеУслугПрочихАктивов(СвязанныйДокумент, ДополнительныеРеквизиты, Отказ, Результат) 

	// создаем ПриобретениеУслугПрочихактивов
	Если ЗначениеЗаполнено(СвязанныйДокумент) Тогда
		ПУиПА = СвязанныйДокумент.ПолучитьОбъект();
	Иначе			
		//сначала ищем по идентификатору основания существующий, на случай если до этого выгружался не единым пакетом 
		ПУиПАСсылка = Документы.ПриобретениеУслугПрочихАктивов.ПолучитьСсылку(Ссылка.УникальныйИдентификатор());
		Если ПУиПАСсылка <> Неопределено И ОбщегоНазначения.СсылкаСуществует(ПУиПАСсылка) Тогда
			ПУиПА = ПУиПАСсылка.ПолучитьОбъект();	
		Иначе	
			ПУиПА = Документы.ПриобретениеУслугПрочихАктивов.СоздатьДокумент();
			ПУиПА.УстановитьСсылкуНового(ПУиПАСсылка);
		КонецЕсли;
	КонецЕсли;
	
	//этим свойством отключаем в ДозаполнитьОбъект() перезаполнение реквизитов уже заполненных в этом документе
	ПУиПА.ДополнительныеСвойства.Вставить("ИспользоватьЕдиныйПакетПУиПАСПредварительнымНачислением", Истина);
	Если ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура") Тогда
		Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл 
			ПУиПА.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
		КонецЦикла;
	Иначе   
		ПУиПА.ДополнительныеСвойства.Вставить("OperationType","ПокупкаКомиссияСоСторнировкойПредварительныхНачислений");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПУиПА, ЭтотОбъект);
	ПУиПА.тн_ПУиПА_С_ПредварительнымиНачислениями = Ссылка;
	ПУиПА.Автор = Ответственный;
	
	// ТЧ Расходы
	ПУиПА.Расходы.Очистить();
	Для Каждого Стр Из Расходы Цикл
		НоваяСтрока = ПУиПА.Расходы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	
	Документы.ПриобретениеУслугПрочихАктивов.ДозаполнитьОбъект(ПУиПА, Отказ, Результат);
	
	//проверим, что нет документа с таким номером
	Если ЗначениеЗаполнено(Документы.ПриобретениеУслугПрочихАктивов.НайтиПоНомеру(ПУиПА.Номер, ПУиПА.Дата)) Тогда 
    	ПУиПА.УстановитьНовыйНомер();
	КонецЕсли;
	
	ПУиПА.Записать(РежимЗаписиДокумента.Проведение);       

	РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ПУиПА.Ссылка, Организация, Дата);

КонецПроцедуры

Процедура ОформитьПрочиеДоходыРасходы(СвязанныйДокумент, ДополнительныеРеквизиты, Отказ, Результат)

	// создаем ПрочиеДоходыРасходы 
	
	OperationType = ?(ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура"), ДополнительныеРеквизиты.OperationType,"ПокупкаКомиссияСоСторнировкойПредварительныхНачислений");
	
	СоответствиеВидаОперацииПрефиксуГуида = Новый Соответствие;
	СоответствиеВидаОперацииПрефиксуГуида.Вставить("ПокупкаКомиссияСоСторнировкойПредварительныхНачислений","bbbb");
	
	Если ЗначениеЗаполнено(СвязанныйДокумент) Тогда
		ПДР = СвязанныйДокумент.ПолучитьОбъект();
	Иначе 
		//если документ был передан ранее отдельным пакетом, то ПрочиеДоходыРасходы создаются с префиксом в конце идентификатора, зависящим от вида операции
		ГУИД =Ссылка.УникальныйИдентификатор();
		Префикс = СоответствиеВидаОперацииПрефиксуГуида.Получить(OperationType);  
		Если Префикс <> Неопределено Тогда
			ГУИД =  Новый УникальныйИдентификатор(Лев(ГУИД, 32) + Префикс);	
		КонецЕсли;
		ПДРСсылка = Документы.ПрочиеДоходыРасходы.ПолучитьСсылку(ГУИД);
		Если ПДРСсылка <> Неопределено И ОбщегоНазначения.СсылкаСуществует(ПДРСсылка) Тогда
			ПДР = ПДРСсылка.ПолучитьОбъект();	
		Иначе	
			ПДР = Документы.ПрочиеДоходыРасходы.СоздатьДокумент();
			ПДР.УстановитьСсылкуНового(ПДРСсылка);
		КонецЕсли;

	КонецЕсли;	     		
	//этим свойством отключаем в ДозаполнитьОбъект() перезаполнение реквизитов уже заполненных в этом документе
	ПДР.ДополнительныеСвойства.Вставить("ИспользоватьЕдиныйПакетПУиПАСПредварительнымНачислением", Истина);
	Если ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура") Тогда
		Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл 
			ПДР.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
		КонецЦикла;
	Иначе  
		ПДР.ДополнительныеСвойства.Вставить("OperationType",OperationType);  
		ПДР.ДополнительныеСвойства.Вставить("reflectInAccounting", Истина);
		ПДР.ДополнительныеСвойства.Вставить("reflectInManagement", Истина);  
		ПДР.ДополнительныеСвойства.Вставить("ДопСвойстваТЧОбъекта_TableExpenses", Неопределено);
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ПДР, ЭтотОбъект);
	ПДР.тн_ПУиПА_С_ПредварительнымиНачислениями = Ссылка;
	
	// ТЧ ПрочиеРасходы
	ПДР.ПрочиеРасходы.Очистить();
	Для Каждого Стр Из ПрочиеРасходы Цикл
		НоваяСтрока = ПДР.ПрочиеРасходы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	
	Документы.ПрочиеДоходыРасходы.ДозаполнитьОбъект(ПДР, Отказ, Результат);
	
	//проверим, что нет документа с таким номером
	Если ЗначениеЗаполнено(Документы.ПрочиеДоходыРасходы.НайтиПоНомеру(ПДР.Номер, ПДР.Дата)) Тогда 
    	ПДР.УстановитьНовыйНомер();
	КонецЕсли;

	ПДР.Записать(РежимЗаписиДокумента.Проведение);
	
	РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(ПДР.Ссылка, Организация, Дата);

КонецПроцедуры
	
//Действия:
//		УдалитьПроведение
//		УстановитьПометкуУдаления
//		СнятьПометкуУдаления
Процедура ВыполнитьДействияНадСвязаннымиДокументами(СвязанныйДокументСсылка, Действие)
	
	Если ЗначениеЗаполнено(СвязанныйДокументСсылка) Тогда
		
		ДокОбъект = СвязанныйДокументСсылка.ПолучитьОбъект(); 
		
		Если Действие ="УдалитьПроведение" И СвязанныйДокументСсылка.Проведен  Тогда
			//Распровести 
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Действие = "УстановитьПометкуУдаления" И Не СвязанныйДокументСсылка.ПометкаУдаления Тогда 
			//Пометить на удаление
			ДокОбъект.УстановитьПометкуУдаления(Истина);
		ИначеЕсли Действие = "СнятьПометкуУдаления" И СвязанныйДокументСсылка.ПометкаУдаления Тогда
			//Снять пометку
			ДокОбъект.УстановитьПометкуУдаления(Ложь); 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиСвязанныеДокументы(ДокументИсточник)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПриобретениеУслугПрочихАктивов.Ссылка КАК ПриобретениеУслугПрочихАктивов,
		|	NULL КАК ПрочиеДоходыРасходы
		|ИЗ
		|	Документ.ПриобретениеУслугПрочихАктивов КАК ПриобретениеУслугПрочихАктивов
		|ГДЕ
		|	ПриобретениеУслугПрочихАктивов.тн_ПУиПА_С_ПредварительнымиНачислениями = &ДокументИсточник
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	ПрочиеДоходыРасходы.Ссылка
		|ИЗ
		|	Документ.ПрочиеДоходыРасходы КАК ПрочиеДоходыРасходы
		|ГДЕ
		|	ПрочиеДоходыРасходы.тн_ПУиПА_С_ПредварительнымиНачислениями = &ДокументИсточник";
	
	Запрос.УстановитьПараметр("ДокументИсточник", ДокументИсточник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДокументов = РезультатЗапроса.Выбрать();
	
	СтруктураДокументы = Новый Структура;
	СтруктураДокументы.Вставить("ПриобретениеУслугПрочихАктивов", Документы.ПриобретениеУслугПрочихАктивов.ПустаяСсылка());
	СтруктураДокументы.Вставить("ПрочиеДоходыРасходы", Документы.ПрочиеДоходыРасходы.ПустаяСсылка());
		
	Пока ВыборкаДокументов.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДокументов.ПриобретениеУслугПрочихАктивов) Тогда
			СтруктураДокументы.ПриобретениеУслугПрочихАктивов = ВыборкаДокументов.ПриобретениеУслугПрочихАктивов;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДокументов.ПрочиеДоходыРасходы) Тогда
			СтруктураДокументы.ПрочиеДоходыРасходы = ВыборкаДокументов.ПрочиеДоходыРасходы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураДокументы;
	
КонецФункции

#КонецЕсли