
#Область ОбработчикиСобытийФормы

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры,,"ЗакрыватьПриВыборе,ЗакрыватьПриЗакрытииВладельца,КлючНазначенияИспользования");
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

КонецПроцедуры

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗакрытьФормуПринудительно
		И (Модифицированность И Не СохранитьПараметры)
		И НЕ ЗавершениеРаботы Тогда
		
		СписокКнопок = Новый СписокЗначений();
		СписокКнопок.Добавить("Закрыть", НСтр("ru = 'Закрыть';
												|en = 'Close'"));
		СписокКнопок.Добавить("НеЗакрывать", НСтр("ru = 'Не закрывать';
													|en = 'Keep open'"));
		
		Отказ = Истина;
		
		ДополнительныеПараметры = Новый Структура;
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ПоказатьВопросПередЗакрытиемЗавершение", ЭтотОбъект, ДополнительныеПараметры),
			НСтр("ru = 'Реквизиты печати были изменены. Закрыть без сохранения реквизитов?';
				|en = 'Attributes for printing were changed. Close without saving the attributes?'"),
			СписокКнопок);
		
	КонецЕсли;
	
КонецПроцедуры

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиенте
Процедура ПоказатьВопросПередЗакрытиемЗавершение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = "Закрыть" Тогда
		ЗакрытьФормуПринудительно = Истина;
		Закрыть(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если СохранитьПараметры И НЕ ЗавершениеРаботы Тогда
		
		СтруктураПараметров = ИзменяемыеРеквизиты(ЭтаФорма);
		ОповеститьОВыборе(СтруктураПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
   
// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиенте
Процедура ОК(Команда)
	
	Если Не ТолькоПросмотр Тогда
		СохранитьПараметры = Истина;
	КонецЕсли;
	
	Закрыть();

КонецПроцедуры

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прочее

// Губернаторова Дарья 20.11.2021 Выполнение задач №000038912
// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиентеНаСервереБезКонтекста
Функция ИзменяемыеРеквизиты(Источник)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("тн_Филиал",					Источник.Филиал);
	СтруктураПараметров.Вставить("тн_ПодразделениеОрганизации",	Источник.ПодразделениеОрганизации);
	СтруктураПараметров.Вставить("тн_РасчетныйСчет",			Источник.РасчетныйСчет);
	СтруктураПараметров.Вставить("тн_Претензия",				Источник.Претензия);
	СтруктураПараметров.Вставить("тн_ПричинаПретензии",			Источник.ПричинаПретензии);
	СтруктураПараметров.Вставить("тн_ЗаключениеКомиссии",		Источник.ЗаключениеКомиссии);
	СтруктураПараметров.Вставить("тн_НомерПретензии",			Источник.НомерПретензии);
	СтруктураПараметров.Вставить("тн_ДатаПретензии",			Источник.ДатаПретензии);
	
	Возврат СтруктураПараметров;
	
КонецФункции

#КонецОбласти

#КонецОбласти
