// функция возвращает ВерсияСоглашенияКредит 
//
// Параметры:
//  Заявка  - Документ.ПокрытиеПотребностиВФинансировании - 
//        	ссылку на заявку 
//  // Возвращаемое значение:
//      - ДокументСсылка.ВерсияСоглашенияКредит,Неопределено - ссылка на найденный документ
//
Функция ВерсияСоглашенияКредитПоЗаявке(Заявка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсияСоглашенияКредит.Ссылка КАК Ссылка,
		|	ВерсияСоглашенияКредит.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.ВерсияСоглашенияКредит КАК ВерсияСоглашенияКредит
		|ГДЕ
		|	ВерсияСоглашенияКредит.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат 	ВыборкаДетальныеЗаписи.Ссылка;
	
	КонецЕсли;

