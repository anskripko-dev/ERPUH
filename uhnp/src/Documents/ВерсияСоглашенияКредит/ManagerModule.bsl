Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка) Экспорт
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Реквизиты.Ссылка КАК Ссылка,
		|	Реквизиты.Ссылка КАК ТекущаяВерсия,
		|	Реквизиты.Дата КАК Дата,
		|	Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Реквизиты.Организация КАК Организация,
		|	Реквизиты.Контрагент КАК Контрагент,
		|	Реквизиты.ВалютаВзаиморасчетов КАК Валюта,
		|	ВЫБОР
		|		КОГДА Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.РамочныйДоговор)
		|			ТОГДА Реквизиты.ДоговорКонтрагента
		|		КОГДА Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.ДоговорСУсловием)
		|			ТОГДА Реквизиты.ДоговорКонтрагента
		|		ИНАЧЕ Реквизиты.БазовыйДоговор
		|	КОНЕЦ КАК РамочныйДоговор,
		|	6 КАК ЗаполненностьДоговораЗаявки,
		|	ВЫБОР
		|		КОГДА Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.Спецификация)
		|			ТОГДА Реквизиты.ДоговорКонтрагента
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Транш,
		|	ВЫБОР
		|		КОГДА Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.РамочныйДоговор)
		|			ТОГДА 0 
		|		КОГДА Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.ДоговорСУсловием)
		|			ТОГДА 0
		|		ИНАЧЕ Реквизиты.Сумма
		|	КОНЕЦ КАК ИсполнениеГрафик,
		|	ВЫБОР
		|		КОГДА Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.Спецификация)
		|			ТОГДА 0
		|		ИНАЧЕ Реквизиты.Сумма
		|	КОНЕЦ КАК СуммаЛимита,
		|	Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.ДоговорСУсловием) КАК ЭтоДоговорСУсловием,
		|	Реквизиты.ВидСоглашения = ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.Спецификация) КАК ЭтоСпецификация,
		|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
		|	Реквизиты.ВозобновляемыйЛимит КАК ВозобновляемыйЛимит,
		|	Реквизиты.ДатаОтсчетаПроверкиКовенантов КАК ДатаОтсчетаПроверкиКовенантов,
		|	Реквизиты.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	Реквизиты.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	Реквизиты.Ответственный КАК Ответственный,
		|	Реквизиты.ИспользованиеГрафикаРасчетовБДР КАК ИспользованиеГрафикаРасчетовБДР,
		|	Реквизиты.ИспользованиеГрафикаРасчетовБДДС КАК ИспользованиеГрафикаРасчетовБДДС,
		|	Реквизиты.ЭтоКредитнаяЛиния КАК ЭтоКредитнаяЛиния,
		|	Реквизиты.ДокументОснование КАК Основание,
		|	ВЫБОР
		|		КОГДА Реквизиты.ДатаНачалаДоступности <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА Реквизиты.ДатаНачалаДоступности
		|		ИНАЧЕ Реквизиты.Дата
		|	КОНЕЦ КАК ДатаНачалаДоступности
		|ИЗ
		|	Документ.ВерсияСоглашенияКредит КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
		
	Для Каждого ТекРеквизит Из Реквизиты Цикл
		Запрос.УстановитьПараметр(ТекРеквизит.Ключ, ТекРеквизит.Значение);
	КонецЦикла;  
	
	Запрос.МенеджерВременныхТаблиц = Документы.ВерсияСоглашенияКредит.ПланыДокумента(ДокументСсылка, Запрос.МенеджерВременныхТаблиц); 
	
КонецПроцедуры

Процедура ДобавитьТекстЗапросаНапоминанияПользователюОПроверкеКовенантов(ТекстыЗапроса) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	ВерсияСоглашенияКредитКовенанты.Ковенант КАК Ковенант,
	|	ВерсияСоглашенияКредитКовенанты.Периодичность КАК Периодичность,
	|	&ДатаОтсчетаПроверкиКовенантов КАК ДатаОтсчетаПроверкиКовенантов,
	|	&Организация,
	|	&Контрагент КАК Контрагент,
	|	&ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	&Дата КАК ДатаНачалаДействияВерсии,
	|	&Ссылка КАК Документ,
	|	&Ссылка КАК ВерсияСоглашения,
	|	&Ответственный КАК Ответственный,
	|	&ДатаНачалаДействия КАК ДатаНачалаДействияДоговора,
	|	&ДатаОкончанияДействия КАК ДатаОкончанияДействияДоговора,
	|	ЗНАЧЕНИЕ(Перечисление.СтатусыПроверкиКовенантов.НеПроверялся) КАК СтатусПроверки
	|ИЗ
	|	Документ.ВерсияСоглашенияКредит.Ковенанты КАК ВерсияСоглашенияКредитКовенанты
	|ГДЕ
	|	ВерсияСоглашенияКредитКовенанты.Ссылка = &Ссылка
	|	И ВерсияСоглашенияКредитКовенанты.Периодичность <> ЗНАЧЕНИЕ(Перечисление.ПериодичностьКовенантов.Непериодический)";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "НапоминанияКовенантов");
	
КонецПроцедуры

Процедура ДобавитьТекстЗапросаЛимитыРамочныхДоговоровКредитовЗаймов(ТекстыЗапроса)
	
	ИмяРегистра 	= "ЛимитыРамочныхДоговоровКредитовЗаймов";

	ТекстЗапроса 	= 
	"ВЫБРАТЬ
	|	&Организация КАК Организация,
	|	&ДатаНачалаДоступности КАК Период,
	|	&Контрагент КАК Контрагент,
	|	&Валюта КАК Валюта,
	|	&РамочныйДоговор КАК РамочныйДоговор,
	|	&Транш КАК Транш,
	|	&СуммаЛимита КАК СуммаЛимита,
	|	&ИсполнениеГрафик КАК ИсполнениеГрафик,
	|	&Ссылка КАК Ссылка,
	|	&ДоговорКонтрагента КАК ДоговорКонтрагента
	|ГДЕ
	|	&ЭтоКредитнаяЛиния
	|	И НЕ &ЭтоСпецификация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Организация,
	|	ГрафикРасчетов.Дата,
	|	&Контрагент,
	|	&Валюта,
	|	&РамочныйДоговор,
	|	&РамочныйДоговор,
	|	0,
	|	ВЫБОР
	|		КОГДА ГрафикРасчетов.ОперацияГрафика = ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение)
	|			ТОГДА ГрафикРасчетов.Сумма
	|		ИНАЧЕ ГрафикРасчетов.Сумма * -1
	|	КОНЕЦ,
	|	&Ссылка,
	|	&ДоговорКонтрагента
	|ИЗ
	|	Документ.ВерсияСоглашенияКредит.ГрафикРасчетов КАК ГрафикРасчетов
	|ГДЕ
	|	ГрафикРасчетов.Ссылка = &Ссылка
	|	И (ГрафикРасчетов.ОперацияГрафика = ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение)
	|			ИЛИ ГрафикРасчетов.ОперацияГрафика = ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат)
	|				И &ВозобновляемыйЛимит)
	|	И &ЭтоДоговорСУсловием
	|	И &ЭтоКредитнаяЛиния
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Организация,
	|	ГрафикРасчетов.Дата,
	|	&Контрагент,
	|	&Валюта,
	|	&РамочныйДоговор,
	|	&ДоговорКонтрагента,
