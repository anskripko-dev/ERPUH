КонецПроцедуры

Процедура ОбработкаЗаполненияПоВариантуФинансирования(ДанныеЗаполнения, Протокол)
	
	ОпорныйГрафик 						= Истина;
	НомерДополнительногоСоглашения 		= 1;     
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,  ДанныеЗаполнения);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеЗаполнения.ПроцентныеСтавки, 	ПроцентныеСтавки);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеЗаполнения.ГрафикРасчетов, 		ГрафикРасчетов);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеЗаполнения.Проценты, 			Проценты);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеЗаполнения.ПроизводственныеКалендари, ПроизводственныеКалендари);  
	ДокументОснование					= Протокол;
	
	Дата 								= ТекущаяДатаСеанса();
	ДатаНачалаДействия 					= ДанныеЗаполнения.ДатаНачалаДействия;
	ДатаОкончанияДействия 				= ДанныеЗаполнения.ДатаОкончанияДействия;
	Сумма				 				= ДанныеЗаполнения.ОбщаяСумма;
  	Организация 						= ДанныеЗаполнения.Организация;
	Ответственный 						= Пользователи.ТекущийПользователь();
	ВалютаВзаиморасчетов 				= ДанныеЗаполнения.ВалютаДокумента;
	ОсновнаяВалютаПлатежей 				= ДанныеЗаполнения.ВалютаДокумента;
	Если ЗначениеЗаполнено(Протокол) Тогда
		ЭтоКредитнаяЛиния					= Ложь;
	Иначе	
		ЭтоКредитнаяЛиния					= Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеЗаполнения.Договор) Тогда
	 	ВидСоглашения 		= ПредопределенноеЗначение("Перечисление.ВидыСоглашений.Спецификация");
	    БазовыйДоговор   	= ДанныеЗаполнения.Договор;
	КонецЕсли;

	ДоговорыКонтрагентовВстраиваниеУХ.НачальноеЗаполнениеВерсииСоглашения(ЭтотОбъект, Неопределено);
	
	РаботаСДоговорамиКонтрагентовУХ.ЗаполнитьПроизводственныеКалендариПоУмолчанию(ПроизводственныеКалендари);
	
КонецПроцедуры

Процедура КонтрольЛимитыРамочныхДоговоровКредитовЗаймов(Отказ)
  
	Если НЕ ЭтоКредитнаяЛиния Тогда
		Возврат;
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Возврат;
	КонецЕсли;

 	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лимиты.Контрагент КАК Контрагент,
		|	Лимиты.СуммаЛимитаОборот КАК СуммаЛимитаОборот,
		|	Лимиты.ИсполнениеГрафикОборот КАК ИсполнениеГрафикОборот,
		|	Лимиты.СуммаЛимитаОборот - Лимиты.ИсполнениеГрафикОборот КАК ОстатокЛимита,
		|	Лимиты.ИсполнениеФактОборот КАК ДолгКредитнаяЛиния
		|ИЗ
		|	РегистрНакопления.ЛимитыРамочныхДоговоровКредитовЗаймов.Обороты(, &Дата, , РамочныйДоговор = &РамочныйДоговор) КАК Лимиты";

	Если ВидСоглашения = Перечисления.ВидыСоглашений.Спецификация Тогда
		Запрос.УстановитьПараметр("РамочныйДоговор", БазовыйДоговор);	
		Запрос.УстановитьПараметр("Дата", Новый Граница(Новый МоментВремени(ДатаНачалаДействия, Ссылка), ВидГраницы.Исключая));
	Иначе
		Запрос.УстановитьПараметр("РамочныйДоговор", ДоговорКонтрагента);	
		Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОкончанияДействия));
	КонецЕсли;

	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		ПоследняяВерсия = РаботаСДоговорамиКонтрагентовУХ.ПоследняяВерсияДокументаСоглашения(ЭтотОбъект, Ссылка);
		
		Если ЗначениеЗаполнено(ПоследняяВерсия) Тогда
			СуммаИсключения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоследняяВерсия, "Сумма");
		Иначе
			СуммаИсключения = 0;	
		КонецЕсли;
		Если ВидСоглашения = Перечисления.ВидыСоглашений.Спецификация
			И Сумма + Выборка.ИсполнениеГрафикОборот - СуммаИсключения > Выборка.СуммаЛимитаОборот Тогда
      			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Запись невозможна. Превышена сумма лимита на %1 %2'"),
			Сумма + Выборка.ИсполнениеГрафикОборот - Выборка.СуммаЛимитаОборот - СуммаИсключения,
			ВалютаВзаиморасчетов);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ,, Отказ);
		ИначеЕсли ВидСоглашения <> Перечисления.ВидыСоглашений.Спецификация   
			И ВозобновляемыйЛимит И Сумма < Выборка.ДолгКредитнаяЛиния Тогда 
			//                                            		
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Запись невозможна. Уменьшена сумма лимита на %1 %2'"),
			Выборка.ДолгКредитнаяЛиния - Сумма,
			ВалютаВзаиморасчетов);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ,, Отказ);
		ИначеЕсли ВозобновляемыйЛимит И  ВидСоглашения = Перечисления.ВидыСоглашений.РамочныйДоговор 
					И Сумма < Выборка.ИсполнениеГрафикОборот Тогда 
                             		
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Запись невозможна. Уменьшена сумма лимита на %1 %2'"),
			Выборка.ИсполнениеГрафикОборот - Сумма,
			ВалютаВзаиморасчетов);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ,, Отказ);
	
		ИначеЕсли ВидСоглашения <> Перечисления.ВидыСоглашений.Спецификация 
				И НЕ ВозобновляемыйЛимит
				И Сумма < Выборка.СуммаЛимитаОборот Тогда 
			                                           		
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Запись невозможна. Уменьшена сумма лимита на %1 %2'"),
			Выборка.СуммаЛимитаОборот - Сумма,
			ВалютаВзаиморасчетов);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ,, Отказ);
	
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьПользователю(Знач ТекстСообщенияПользователю,
							Знач КлючДанных = Неопределено,
							Знач Поле = "",
							Знач ПутьКДанным = "",
							Отказ = Ложь)

	Если ДополнительныеСвойства.Свойство("НеВызыватьИсключениеПриЗаписи") Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияПользователю,КлючДанных,Поле,ПутьКДанным);
	Иначе
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияПользователю,КлючДанных,Поле,ПутьКДанным,Отказ);
	КонецЕсли;

КонецПроцедуры

