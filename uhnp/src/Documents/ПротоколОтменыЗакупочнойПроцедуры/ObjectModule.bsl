#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЗакупочнаяПроцедура) Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(
			Нстр("ru = 'Не указана закупочная процедура!'"), 
			Отказ,
			, 
			СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	мДокументов = ЦентрализованныеЗакупкиУХ.ПолучитьДокументыПоОтбору(
		"ПротоколВыбораПобедителей",
		Новый Структура("ЗакупочнаяПроцедура, Проведен", ЗакупочнаяПроцедура, Истина),
		Ссылка);
	Если мДокументов.Количество() > 0 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Для закупочной процедуры %1 уже введен протокол выбора победителей!'"), 
				ЗакупочнаяПроцедура),
			Отказ,
			,
			СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	мДокументов = ЦентрализованныеЗакупкиУХ.ПолучитьДокументыПоОтбору(
		"ПротоколОтменыЗакупочнойПроцедуры",
		Новый Структура("ЗакупочнаяПроцедура, Проведен", ЗакупочнаяПроцедура, Истина),
		Ссылка);
	Если мДокументов.Количество() > 0 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Для закупочной процедуры %1 уже введен протокол отмены!'"), ЗакупочнаяПроцедура),
			Отказ,
			,
			СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;    
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
		Справочники.ЗакупочныеПроцедуры.УстановитьФлагЗавершена(ЗакупочнаяПроцедура, Истина, Ссылка);   
	Иначе
		Справочники.ЗакупочныеПроцедуры.УстановитьФлагЗавершена(ЗакупочнаяПроцедура, Ложь, Ссылка);   
	КонецЕсли;
		
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ДанныеЗаполнения <> Неопределено
			И ТипДанныхЗаполнения = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
		Ошибки = Неопределено;
		флНетОшибок = 
			Документы.ПротоколОтменыЗакупочнойПроцедуры.ПроверитьВозможностьСоздатьДляЗакупки(
				ДанныеЗаполнения,
				Ошибки);
		Если флНетОшибок Тогда
			ЗакупочнаяПроцедура = ДанныеЗаполнения;
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		Иначе
			ВызватьИсключение 
				ЦентрализованныеЗакупкиКлиентСерверУХ.МассивСообщенийВСтроку(
					Ошибки,
					НСтр("ru='Невозможно создать протокол отмены закупки!'"));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)  
	Если Проведен Тогда
		Справочники.ЗакупочныеПроцедуры.УстановитьФлагЗавершена(ЗакупочнаяПроцедура, Истина, Ссылка);   
	Иначе                                                                                           
		Справочники.ЗакупочныеПроцедуры.УстановитьФлагЗавершена(ЗакупочнаяПроцедура, Ложь, Ссылка);   
	КонецЕсли;
	ЗаполнитьПланированиеПотребностейДляОтменыЗакупки()   
	
КонецПроцедуры


Процедура ЗаполнитьПланированиеПотребностейДляОтменыЗакупки()
	Если НЕ ЗначениеЗаполнено(ЗакупочнаяПроцедура)Тогда
		Возврат; 
	КонецЕсли;	
	Движения.ПланированиеПотребностей.Записывать = Истина;
	Движения.ОперацииБюджетов.Записывать = Истина;
	
	ВыборкаЗапроса = ПолучитьВыборкуДляОтменуПотребностей(ЗакупочнаяПроцедура);     
	Пока ВыборкаЗапроса.Следующий() Цикл
		Движение = Движения.ПланированиеПотребностей.Добавить(); 
		Движение.Регистратор = Ссылка;
		ЗаполнитьЗначенияСвойств(Движение, ВыборкаЗапроса);    
		Движение.Период = Дата;
	КонецЦикла;
	
	ВыборкаЗапросаОперацииБюджетов = ПолучитьВыборкуДляОтменыОперацииБюджетов(ЗакупочнаяПроцедура);     
	Пока ВыборкаЗапросаОперацииБюджетов.Следующий() Цикл
		Движение = Движения.ОперацииБюджетов.Добавить(); 
		Движение.Регистратор = Ссылка;
		Движение.ДатаРегистрации = Дата;
		ЗаполнитьЗначенияСвойств(Движение, ВыборкаЗапросаОперацииБюджетов);    
	КонецЦикла;
	
	Движения.Записать();

КонецПроцедуры    


Функция ПолучитьВыборкуДляОтменуПотребностей(ДокументОснование) 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура",ЗакупочнаяПроцедура);      
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	               |	ПланированиеПотребностейОстатки.АналитикаИсточника КАК АналитикаИсточника,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования КАК АналитикаПланирования,
	               |	СУММА(ПланированиеПотребностейОстатки.КоличествоОстаток) КАК количество,
	               |	СУММА(ПланированиеПотребностейОстатки.СуммаОстаток) КАК Сумма,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект КАК Лот
	               |ПОМЕСТИТЬ Лоты
	               |ИЗ
	               |	РегистрНакопления.ПланированиеПотребностей.Остатки(
	               |			,
	               |			АналитикаПланирования.ОбъектПланирования.Объект В
	               |				(ВЫБРАТЬ
	               |					Документ.Лот.Ссылка
	               |				ИЗ
	               |					Документ.Лот
	               |				ГДЕ
	               |					Документ.Лот.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура)) КАК ПланированиеПотребностейОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПланированиеПотребностейОстатки.АналитикаИсточника,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Лоты.ВидДвижения КАК ВидДвижения,
	               |	Лоты.АналитикаИсточника КАК АналитикаИсточника,
	               |	Лоты.АналитикаПланирования КАК АналитикаПланирования,
	               |	Лоты.количество КАК количество,
	               |	Лоты.Сумма КАК Сумма
	               |ИЗ
	               |	Лоты КАК Лоты
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	               |	ПланированиеПотребностей.АналитикаИсточника,
	               |	ПланированиеПотребностей.АналитикаПланирования,
	               |	ПланированиеПотребностей.Количество,
	               |	ПланированиеПотребностей.Сумма
	               |ИЗ
	               |	РегистрНакопления.ПланированиеПотребностей КАК ПланированиеПотребностей
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Лоты КАК Лоты
	               |		ПО ПланированиеПотребностей.Регистратор = Лоты.Лот
	               |ГДЕ
	               |	ПланированиеПотребностей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПланированиеПотребностей.АналитикаПланирования,
	               |	ПланированиеПотребностей.АналитикаИсточника,
	               |	ПланированиеПотребностей.Сумма,
	               |	ПланированиеПотребностей.Количество";

   	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выбрать();
КонецФункции

Функция ПолучитьВыборкуДляОтменыОперацииБюджетов(ДокументОснование) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лоты.Ссылка КАК Лот
		|ПОМЕСТИТЬ ВТ_Лоты
		|ИЗ
		|	Документ.Лот КАК Лоты
		|ГДЕ
		|	Лоты.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОперацииБюджетов.Период КАК Период,
		|	ОперацииБюджетов.ВидБюджета КАК ВидБюджета,
		|	ОперацииБюджетов.ОбъектПланирования КАК ОбъектПланирования,
		|	ОперацииБюджетов.Состояние КАК Состояние,
		|	ОперацииБюджетов.АналитикаСтруктуры КАК АналитикаСтруктуры,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
		|	ОперацииБюджетов.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		|	ОперацииБюджетов.АналитикаПотребностей КАК АналитикаПотребностей,
		|	ОперацииБюджетов.АналитикаПартнеров КАК АналитикаПартнеров,
		|	ОперацииБюджетов.ПриходРасход КАК ПриходРасход,
		|	ОперацииБюджетов.Валюта КАК Валюта,
		|	ОперацииБюджетов.ВалютаЛимитирования КАК ВалютаЛимитирования,
		|	ОперацииБюджетов.Сумма * -1 КАК Сумма
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Лоты КАК ВТ_Лоты
		|		ПО ОперацииБюджетов.Регистратор = ВТ_Лоты.Лот";
	
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура", ДокументОснование);

	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

#КонецЕсли


