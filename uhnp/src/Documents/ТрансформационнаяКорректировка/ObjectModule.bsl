#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем НеОбрабатыватьПроведение Экспорт;
Перем ОбновитьПометкуУдаленияСвязанныхОбъектов;

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	ОбновитьПометкуУдаленияСвязанныхОбъектов= НЕ (ЭтоНовый() 
		ИЛИ ПометкаУдаления=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка,"ПометкаУдаления"));
			
	// Заполним основную валюту
	Если НЕ ЗначениеЗаполнено(ОсновнаяВалюта) Тогда
		
		УправлениеПериодом = УправлениеРабочимиПроцессамиУХ
			.ПолучитьДокументУправленияПериодомСценария(Сценарий, ПериодОтчета);
			
		ВерсияРегламента = Неопределено;
		Если ЗначениеЗаполнено(УправлениеПериодом) Тогда
			ВерсияРегламента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				УправлениеПериодом, "ВерсияОрганизационнойСтруктуры");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВерсияРегламента) Тогда
			
			ТаблицаВалютОтчетности = РегистрыСведений.ВалютыОтчетности.ПолучитьТаблицуВалютДляВерсииОрганизационнойСтруктуры(ВерсияРегламента);
			СтрокиВалюты = ТаблицаВалютОтчетности.НайтиСтроки(Новый Структура("Организация", Организация));
			
			Если СтрокиВалюты.Количество() = 0 Тогда
				ТекстСообщения = НСтр("ru = 'Не удалось определить настройки вылют по параметрам:
					|	Версия регламента: %1,
					|	Организация: %2'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ВерсияРегламента, Организация);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
			Иначе
				ОсновнаяВалюта = СтрокиВалюты[0].ОсновнаяВалюта;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка ИЛИ НеОбрабатыватьПроведение Тогда
		Возврат;
	КонецЕсли;
	
	Обработки.КорректировкиЗначенийПоказателей.ОбработкаПроведенияОбъекта(ЭтотОбъект,РежимПроведения,Отказ);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если  КорректировкиЗначенийПоказателей Тогда
		
		УправлениеОтчетамиУХ.ОчиститьЗначенияПоказателейОтчетов(Ссылка,Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") Тогда
		ШаблонКорректировки = ДанныеЗаполнения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШаблонКорректировки) Тогда
		ДанныеШаблонаКорректировки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШаблонКорректировки, "ВидОперации, ПланСчетов, ДвиженияПоРегиструБухгалтерии");
		ВидОперации = ДанныеШаблонаКорректировки.ВидОперации;
		ПланСчетов = ДанныеШаблонаКорректировки.ПланСчетов;
		ДвиженияПоРегиструБухгалтерии = ДанныеШаблонаКорректировки.ДвиженияПоРегиструБухгалтерии;
	КонецЕсли;
		
КонецПроцедуры

Процедура ИзменитьПометкуУдаленияВерсии() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВерсииЗначенийПоказателей.Владелец КАК ОписаниеВерсии
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
	|ГДЕ
	|	ВерсииЗначенийПоказателей.Регистратор = &ТекОперация
	|	И ВерсииЗначенийПоказателей.ПометкаУдаления = &ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ТекОперация", Ссылка);
	Запрос.УстановитьПараметр("ПометкаУдаления", НЕ ПометкаУдаления);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Выборка.ОписаниеВерсии.ПолучитьОбъект().УстановитьПометкуУдаления(ПометкаУдаления);
	КонецЦикла;
		
КонецПроцедуры // ИзменитьПометкуУдаленияВерсии()

Процедура ИзменитьПометкуУдаленияПротоколируемыхСобытий()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПротоколируемыеСобытия.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПротоколируемыеСобытия КАК ПротоколируемыеСобытия
	|ГДЕ
	|	ПротоколируемыеСобытия.Объект = &Объект
	|	И ПротоколируемыеСобытия.ПометкаУдаления = &ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Запрос.УстановитьПараметр("ПометкаУдаления", НЕ ПометкаУдаления);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(ПометкаУдаления);
	КонецЦикла;
		
КонецПроцедуры // ИзменитьПометкуУдаленияПротоколируемыхСобытий() 

Процедура ПриЗаписи(Отказ)
	
	Если ОбновитьПометкуУдаленияСвязанныхОбъектов Тогда
			
		Если КорректировкиЗначенийПоказателей Тогда
			
			ИзменитьПометкуУдаленияВерсии();
			
		КонецЕсли;
		
		ИзменитьПометкуУдаленияПротоколируемыхСобытий();
		
	КонецЕсли;
	
КонецПроцедуры

НеОбрабатыватьПроведение = Ложь;

#КонецЕсли
