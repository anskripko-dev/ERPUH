#Область ОбработчикиСобытийФормы
 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов 
	
	ОбщегоНазначенияУХ.УстановитьСостояниеДокумента(ЭтотОбъект);

	УправлениеФормой(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Запись_ДоговорыКонтрагентов"
			И ОжиданиеНовогоДоговора Тогда 
		Объект.ДоговорДолжника		= Источник; 
		Модифицированность			= Истина; 
		ОжиданиеНовогоДоговора		= Ложь;
		УправлениеФормой();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
    Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
         МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
         МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
    КонецЕсли;
    // Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы 
&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	РассчитатьСуммуНДСНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СуммаОбязательстваПриИзменении(Элемент)
	РассчитатьСуммуНДСНаСервере();
	ОбновитьИтогиРаспределения();
	УправлениеФормой();	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорДолжникаПриИзменении(Элемент)
	УправлениеФормой();	
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)
    РассчитатьСуммуНДСНаСервере();
	УправлениеФормой();	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаДокументаПриИзменении(Элемент)
	УправлениеФормой();	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.Комментарий");
КонецПроцедуры

&НаКлиенте
Процедура ВидОбязательстваПриИзменении(Элемент)
	Объект.ДоговорДолжника = Неопределено;    
	УправлениеФормой();	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТекущаяЗадолженность	
&НаКлиенте
Процедура ТекущаяЗадолженностьПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РассчитатьСуммуОбязательств();
	УправлениеФормой();	
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяЗадолженностьЭлементСтруктурыЗадолженностиПриИзменении(Элемент)
	СтрокаТекущаяЗадолженность = Элементы.ТекущаяЗадолженность.ТекущиеДанные;
	Если СтрокаТекущаяЗадолженность.Сумма = 0 Тогда 
		СтрокаТекущаяЗадолженность.Сумма = Объект.СуммаОбязательства;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяЗадолженностьСуммаПриИзменении(Элемент)
	РассчитатьСуммуОбязательств();
КонецПроцедуры

#КонецОбласти	

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура СоздатьДоговор(Команда)
    ОжиданиеНовогоДоговора	= Истина;
	ПараметрыОснования 		= Новый Структура;
	ПараметрыОснования.Вставить("Владелец",				Объект.Должник);
	ПараметрыОснования.Вставить("ВалютаВзаиморасчетов", Объект.ВалютаДокумента); 
	ПараметрыОснования.Вставить("Организация",			Объект.Организация); 
	ПараметрыОснования.Вставить("СуммаТраншей",			Объект.СуммаОбязательства); 
	ПараметрыОснования.Вставить("Сумма",				Объект.СуммаОбязательства); 
		
	ПараметрыФормы  	= Новый Структура("ЗначенияЗаполнения",  ПараметрыОснования);
	Если Объект.ВидОбязательства = ПредопределенноеЗначение("Перечисление.ВидыОбязательств.ЗадолженностьПоДоговоруКуплиПродажи") Тогда
		ВидДоговоровКонтрагентовУХ = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Справочник.ВидыДоговоровКонтрагентовУХ.СПокупателем"); 
	Иначе	
		ВидДоговоровКонтрагентовУХ = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Справочник.ВидыДоговоровКонтрагентовУХ.ЗаемВыданный"); 
	КонецЕсли;	
	ПараметрыФормы.Вставить("Отбор", Новый Структура("ВидДоговораУХ", ВидДоговоровКонтрагентовУХ));
		
	Если Объект.ВидОбязательства = ПредопределенноеЗначение("Перечисление.ВидыОбязательств.ЗадолженностьПоДоговоруКуплиПродажи") Тогда
		ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("Справочник.ДоговорыКредитовИДепозитов.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()
	
	Если ЗначениеЗаполнено(Объект.ДоговорДолжника) Тогда
		
		Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.РежимВыбораИзСписка = Истина;
		СписокВыбора 	= Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.СписокВыбора;
		МассивЭлементов = ЗаявкиНаОперацииВызовСервера.ЭлементыСтруктурыЗадолженностиПоДоговору(Объект.ДоговорДолжника, Объект.Ссылка);
		СписокВыбора.ЗагрузитьЗначения(МассивЭлементов);
		Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.Видимость = (СписокВыбора.Количество() > 0);
		
	Иначе
		Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.Видимость = Ложь;
	КонецЕсли;
	
	Если Объект.СуммаДокумента > Объект.СуммаОбязательства Тогда
		ТекстРазностиСумм = СтрШаблон("Премия %1 %2", Объект.СуммаДокумента - Объект.СуммаОбязательства, Объект.ВалютаДокумента);
	ИначеЕсли Объект.СуммаДокумента < Объект.СуммаОбязательства Тогда
		ТекстРазностиСумм = СтрШаблон("Дисконт %1 %2", Объект.СуммаОбязательства - Объект.СуммаДокумента, Объект.ВалютаДокумента);
	Иначе 
		ТекстРазностиСумм = "";
	КонецЕсли;    
	
	ТипОграничения 		= Новый Массив; 
	МассивПараметров 	= Новый Массив(); 
	ЭтоДолгПоставки		= Ложь;

	Если Объект.ВидОбязательства = Перечисления.ВидыОбязательств.ЗадолженностьПоДоговоруЗайма Тогда
   		НовыйПараметр 	= Новый ПараметрВыбора("Отбор.ВидДоговораУХ", Справочники.ВидыДоговоровКонтрагентовУХ.ЗаемВыданный);
		МассивПараметров.Добавить(НовыйПараметр);
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Статус", Перечисления.СтатусыДоговоровКонтрагентов.Действует));
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления",Ложь));
		
		ТипОграничения.Добавить(Тип("СправочникСсылка.ДоговорыКредитовИДепозитов"));
    Иначе
		НовыйПараметр 	= Новый ПараметрВыбора("Отбор.ВидДоговораУХ", Справочники.ВидыДоговоровКонтрагентовУХ.СПокупателем);
		МассивПараметров.Добавить(НовыйПараметр);				
    	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления",Ложь));
		
		ТипОграничения.Добавить(Тип("СправочникСсылка.ДоговорыКонтрагентов"));
		Если ЗначениеЗаполнено(Объект.ДоговорДолжника) Тогда
			ВидДоговораУХ 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДоговорДолжника, "ВидДоговораУХ");
        	ЭтоДолгПоставки  = ВидДоговораУХ 	= ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыДоговоровКонтрагентовУХ.СПокупателем");	
		КонецЕсли;	
		
	КонецЕсли;
	
    Элементы.ТекущаяЗадолженность.Видимость = НЕ ЭтоДолгПоставки;	
	Элементы.ГруппаНДС.Видимость			= ЭтоДолгПоставки;
	
	НовыеПараметры 	= Новый ФиксированныйМассив(МассивПараметров);
	Элементы.ДоговорДолжника.ПараметрыВыбора 	= НовыеПараметры;            
	Элементы.ДоговорДолжника.ОграничениеТипа 	= Новый ОписаниеТипов(ТипОграничения);	   
		
КонецПроцедуры 

&НаСервере
Процедура РассчитатьСуммуНДСНаСервере()
	Если Объект.СуммаДокумента > Объект.СуммаОбязательства Тогда
		Объект.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
		Объект.СуммаДокумента - Объект.СуммаОбязательства, Истина,
		УчетНДСУПСлужебныйКлиентСерверПовтИсп.ЗначениеСтавкиНДС(Объект.СтавкаНДС) );
    Иначе
		Объект.СуммаНДС = 0;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура РассчитатьСуммуОбязательств()
	Объект.СуммаОбязательства = Объект.ТекущаяЗадолженность.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиРаспределения()
	
	ТаблицаРаспределение 	= Объект.ТекущаяЗадолженность;
	
	Если НЕ Элементы.ТекущаяЗадолженность.Видимость 
		И ТаблицаРаспределение.Количество() = 0 Тогда  	
		СтрокаТаблицаРаспределение = Объект.ТекущаяЗадолженность.Добавить();
		СтрокаТаблицаРаспределение.ЭлементСтруктурыЗадолженности = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг");
		СтрокаТаблицаРаспределение.Сумма = Объект.СуммаОбязательства;	
	ИначеЕсли НЕ Элементы.ТекущаяЗадолженность.Видимость 
		И ТаблицаРаспределение.Количество() =1 Тогда
		ТаблицаРаспределение[0].Сумма = Объект.СуммаОбязательства;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
