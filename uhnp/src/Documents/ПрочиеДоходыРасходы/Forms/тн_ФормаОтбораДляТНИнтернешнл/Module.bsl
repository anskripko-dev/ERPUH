
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Истина);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691

	ИнициализироватьКомпоновщикНастроек();
	
	//Восстановим сохраненные настройки
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяФормы,,,,СокрЛП(Пользователи.ТекущийПользователь()));
	Если Настройки <> Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Ложь);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691

КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)

	//Сохраняем настройки
	КомпоновщикНастроекНастройкиОтборПриИзмененииСервер();
	
КонецПроцедуры

&НаСервере
Процедура КомпоновщикНастроекНастройкиОтборПриИзмененииСервер()

	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Истина);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691

	//Сохраняем настройки
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(ИмяФормы,,КомпоновщикНастроек.ПолучитьНастройки(),,СокрЛП(Пользователи.ТекущийПользователь()));

	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Ложь);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьДокументы(Команда)
	
	ОтобратьДокументыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОтобратьДокументыНаСервере()
	
	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Истина);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691

	СхемаКомпоновки = ПолучитьИзВременногоХранилища(АдресСхемы);
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки  = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	РезультатКомпоновки = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(РезультатКомпоновки);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ТаблицаДокументов.Загрузить(РезультатКомпоновки);

	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Ложь);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроек()
	
	СхемаКомпоновки = Документы.ПрочиеДоходыРасходы.ПолучитьМакет("тн_МакетОтбораДляТНИнтернешнл");
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсе(Команда)
	
	УстановитьФлажки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановитьФлажки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Флаг)
	
	Для Каждого СтрокаТЗ Из ТаблицаДокументов Цикл
		СтрокаТЗ.Выгружать = Флаг;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Вывести(Команда)
	
	МассивОтмеченныхДокументов = ТаблицаДокументов.НайтиСтроки(Новый Структура("Выгружать", Истина));
	Если МассивОтмеченныхДокументов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "На выгрузку не помечен ни один из документов");
		Возврат;
	КонецЕсли;
	
	ТабДок = СформироватьВыходнуюФорму();
	Если Не ТабДок = Неопределено Тогда
		ТабДок.Показать("Выгрузка для ТН-Интернешнл");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьВыходнуюФорму()
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = Документы.ПрочиеДоходыРасходы.ПолучитьМакет("тн_ВыгрузкаДляТНИнтернешнл");
	Область = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(Область);
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ", ТаблицаДокументов.Выгрузить(ТаблицаДокументов.НайтиСтроки(Новый Структура("Выгружать", Истина)),"Ссылка"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЗ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Доходы.Ссылка КАК Ссылка,
	|	Доходы.Ссылка.Представление КАК Документ,
	|	Доходы.Ссылка.Дата КАК Дата,
	|	Доходы.Ссылка.Номер КАК Номер,
	|	ЕСТЬNULL(Контрагенты.Представление, """") КАК Контрагент,
	|	ЕСТЬNULL(Контрагенты.ИНН, """") КАК КонтрагентИНН,
	|	ЕСТЬNULL(Контрагенты.КПП, """") КАК КонтрагентКПП,
	|	ЕСТЬNULL(Контрагенты.Ссылка, НЕОПРЕДЕЛЕНО) КАК КонтрагентСсылка,
	|	ЕСТЬNULL(Доходы.Подразделение.Наименование, """") КАК НаименованиеПодразделения,
	|	ЕСТЬNULL(Доходы.СтатьяДоходов.Наименование, """") КАК Статья,
	|	ЕСТЬNULL(Доходы.СтатьяДоходов.тн_КодКонсолидации, """") КАК КодДляКонсолидации,
	|	ЕСТЬNULL(Контрагенты.тн_Принадлежность, НЕОПРЕДЕЛЕНО) В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.тн_СтруктураКомпании.ТехноНиколь)) КАК КонтрагентВнутренний,
	|	""ПрочиеДоходы"" КАК Регистр,
	|	Доходы.Ссылка.Валюта.Наименование КАК Валюта,
	|	Доходы.Ссылка.Валюта.Код КАК КодВалюты,
	// НАЧАЛО Борисенко Игорь 10.08.2023 Выполнение задач №000046506
	//// НАЧАЛО Борисенко Игорь 17.05.2023 Выполнение задач №000045486
	////|	Доходы.Сумма КАК Сумма
	//// НАЧАЛО Борисенко Игорь 30.05.2023 Выполнение задач №000045644
	////|	Доходы.СуммаУпр КАК Сумма
	//|	- Доходы.СуммаУпр КАК Сумма
	//// КОНЕЦ Борисенко Игорь 30.05.2023 Выполнение задач №000045644
	//// КОНЕЦ Борисенко Игорь 17.05.2023 Выполнение задач №000045486
	
	|	ВЫБОР
	|		КОГДА Доходы.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СторнированиеПрочихДоходов)
	|			ТОГДА - Доходы.СуммаУпр
	|			ИНАЧЕ Доходы.СуммаУпр
	|		КОНЕЦ КАК Сумма
	// КОНЕЦ Борисенко Игорь 10.08.2023 Выполнение задач №000046506
	|ИЗ
	|	Документ.ПрочиеДоходыРасходы.ПрочиеДоходы КАК Доходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиСчетовУчетаПрочихОпераций КАК НастройкиСчетовУчета
	|		ПО Доходы.НастройкаСчетовУчета = НастройкиСчетовУчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (ВЫБОР
	|				КОГДА Доходы.Ссылка.тн_КонтрагентПеревыставления = Контрагенты.Ссылка
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ НастройкиСчетовУчета.Субконто1 = Контрагенты.Ссылка
	|			КОНЕЦ)
	|ГДЕ
	|	Доходы.Ссылка В
	|			(ВЫБРАТЬ
	|				ТЗ.Ссылка КАК Ссылка
	|			ИЗ
	|				ТЗ КАК ТЗ)
	|	И Доходы.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расходы.Ссылка,
	|	Расходы.Ссылка.Представление,
	|	Расходы.Ссылка.Дата,
	|	Расходы.Ссылка.Номер,
	|	ЕСТЬNULL(Контрагенты.Представление, """"),
	|	ЕСТЬNULL(Контрагенты.ИНН, """"),
	|	ЕСТЬNULL(Контрагенты.КПП, """"),
	|	ЕСТЬNULL(Контрагенты.Ссылка, НЕОПРЕДЕЛЕНО),
	|	ЕСТЬNULL(Расходы.Подразделение.Наименование, """"),
	|	ЕСТЬNULL(Расходы.СтатьяРасходов.Наименование, """"),
	|	ЕСТЬNULL(Расходы.СтатьяРасходов.тн_КодКонсолидации, """"),
	|	ЕСТЬNULL(Контрагенты.тн_Принадлежность, НЕОПРЕДЕЛЕНО) В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.тн_СтруктураКомпании.ТехноНиколь)),
	|	""ПрочиеРасходы"",
	|	Расходы.Ссылка.Валюта.Наименование,
	|	Расходы.Ссылка.Валюта.Код,
	// НАЧАЛО Борисенко Игорь 10.08.2023 Выполнение задач №000046506
	//// НАЧАЛО Борисенко Игорь 17.05.2023 Выполнение задач №000045486
	////|	Расходы.Сумма
	//// НАЧАЛО Борисенко Игорь 30.05.2023 Выполнение задач №000045644
	////|	Расходы.СуммаБезНДС
	//|	- Расходы.СуммаБезНДС
	//// КОНЕЦ Борисенко Игорь 30.05.2023 Выполнение задач №000045644
	//// КОНЕЦ Борисенко Игорь 17.05.2023 Выполнение задач №000045486
	
	|	ВЫБОР
	|		КОГДА Расходы.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СторнированиеПрочихДоходов)
	|			ТОГДА - Расходы.СуммаБезНДС
	|			ИНАЧЕ Расходы.СуммаБезНДС
	|		КОНЕЦ
	// КОНЕЦ Борисенко Игорь 10.08.2023 Выполнение задач №000046506
	|ИЗ
	|	Документ.ПрочиеДоходыРасходы.ПрочиеРасходы КАК Расходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиСчетовУчетаПрочихОпераций КАК НастройкиСчетовУчета
	|		ПО Расходы.НастройкаСчетовУчета = НастройкиСчетовУчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (ВЫБОР
	|				КОГДА Расходы.Ссылка.тн_КонтрагентПеревыставления = Контрагенты.Ссылка
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ НастройкиСчетовУчета.Субконто1 = Контрагенты.Ссылка
	|			КОНЕЦ)
	|ГДЕ
	|	Расходы.Ссылка В
	|			(ВЫБРАТЬ
	|				ТЗ.Ссылка КАК Ссылка
	|			ИЗ
	|				ТЗ КАК ТЗ)
	|	И Расходы.Ссылка.Проведен";
	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Истина);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	Выборка = Запрос.Выполнить().Выбрать();
	// НАЧАЛО Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	УстановитьПривилегированныйРежим(Ложь);
	// КОНЕЦ Борисенко Игорь 07.03.2023 Выполнение задач №000044691
	
	Область = Макет.ПолучитьОбласть("Строка");
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Область.Параметры, Выборка);
		Область.Параметры.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
		ТабДок.Вывести(Область);
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции
