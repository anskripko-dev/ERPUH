#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(ОрганизацияДляЗаключенияДоговора)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено, ПриобретениеФинансовыхУслуг = Ложь) Экспорт
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапрос(Запрос, ДокументСсылка);  
	
	ПараметрыПланирования = ПодготовитьПараметрыПланированияПотребностей(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
	//ПланированиеПотребностей.ПодготовитьДанныеПланированияДокументаЗамены(ПараметрыПланирования);
	ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования); 
	Запрос.УстановитьПараметр("ФормироватьОперацииБюджетовПоПредыдущемуЭтапу", Истина);
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений; 
	ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры); 
	УстановитьТекстЗапросаТаблицаПланированиеПотребностей(ТекстыЗапроса);
	
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры

Процедура УстановитьТекстЗапросаТаблицаПланированиеПотребностей(Знач ТекстыЗапроса)
	
	Удалить = Новый Массив;
	Для Каждого ТекстЗапроса Из ТекстыЗапроса Цикл    
		Если ВРег(ТекстЗапроса.Представление) = ВРег("ТаблицаПланированиеПотребностей") Тогда
			ТекстЗапроса.Значение = 
			"ВЫБРАТЬ
			|	Запрос.ВидДвижения КАК ВидДвижения,
			|	&Дата КАК Период,
			|	Запрос.АналитикаИсточника КАК АналитикаИсточника,
			|	Запрос.АналитикаПланирования КАК АналитикаПланирования,
			|	СУММА(Запрос.Сумма) КАК Сумма,
			|	СУММА(Запрос.Количество) КАК Количество
			|ИЗ
			|	(ВЫБРАТЬ
			|		Перенесено.ВидДвижения КАК ВидДвижения,
			|		Перенесено.АналитикаИсточника КАК АналитикаИсточника,
			|		Перенесено.АналитикаПланирования КАК АналитикаПланирования,
			|		ЕСТЬNULL(ВТ_ПланыДокументаДляОбработки.КоличествоИсточник, Перенесено.Количество) КАК Количество,
			|		ЕСТЬNULL(ВТ_ПланыДокументаДляОбработки.СуммаИсточник, Перенесено.СуммаПоПотребности) КАК Сумма
			|	ИЗ
			|		ВТ_ПланированиеПотребностей_Перенос КАК Перенесено
			|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПланыДокументаДляОбработки КАК ВТ_ПланыДокументаДляОбработки
			|			ПО Перенесено.АналитикаИсточника = ВТ_ПланыДокументаДляОбработки.АналитикаИсточника
			|				И Перенесено.АналитикаПланирования = ВТ_ПланыДокументаДляОбработки.АналитикаПланирования) КАК Запрос
			|
			|СГРУППИРОВАТЬ ПО
			|	Запрос.ВидДвижения,
			|	Запрос.АналитикаИсточника,
			|	Запрос.АналитикаПланирования";   
		КонецЕсли; 
		Если ВРег(ТекстЗапроса.Представление) = ВРег("ТаблицаОперацииБюджетов") Тогда     
			Удалить.Добавить(ТекстЗапроса);
		КонецЕсли;
	КонецЦикла;        
	Для Каждого Элемент Из Удалить Цикл
		ТекстыЗапроса.Удалить(Элемент);
	КонецЦикла;

КонецПроцедуры       

// Функция - План потребностей 
//
// Параметры:
//  Объект					 - ДокументСсылка, ДокументОбъект, ДанныеФормыСтруктура	 - 
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц - 
// 
// Возвращаемое значение:
//   Структура - Структура с изменениями документа и менеджером временных таблиц 
//
Функция ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц) Экспорт
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", 				МенеджерВременныхтаблиц);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры", Истина);
	ПараметрыПланирования.Вставить("Этап", 					Перечисления.ЭтапыПланированияПотребностей.ЗакупочныеПроцедуры);
	ПараметрыПланирования.Вставить("ДокументПланирования", 	Объект.Ссылка);
	ПараметрыПланирования.Вставить("ОбъектПланирования", 	ОбъектыПланирования.ПолучитьОбъектПланирования(ПараметрыПланирования.ДокументПланирования.ДокументЗамены));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Этап", 				ПараметрыПланирования.Этап);
	//Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	Запрос.УстановитьПараметр("СтатьяБюджета", 		Справочники.СтатьиДоходовИРасходов.ПустаяСсылка());
	Запрос.УстановитьПараметр("Аналитика1",  		ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка());
	Запрос.УстановитьПараметр("Аналитика2",  		ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка());
	Запрос.УстановитьПараметр("Аналитика3",  		ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка());
	Запрос.УстановитьПараметр("Аналитика4",  		ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка());
	Запрос.УстановитьПараметр("Аналитика5",  		ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка());
	Запрос.УстановитьПараметр("Аналитика6",  		ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка());
	Запрос.УстановитьПараметр("ЦФОПустаяСсылка",  	Справочники.Организации.ПустаяСсылка());
	
	ТипОбъекта = ТипЗнч(Объект);

	Запросы = Новый Массив;     
	ВнеПлановойПотребности = Истина;
	
	Запрос.УстановитьПараметр("ВнеПлановойПотребности", ВнеПлановойПотребности);
	Запрос.УстановитьПараметр("ВидБюджета",				ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);   
	Запрос.УстановитьПараметр("Ссылка",					Объект.Ссылка);	

	Запросы.Добавить(
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.Характеристика КАК Характеристика,
	|	ВложенныйЗапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВложенныйЗапрос.Количество КАК Количество,
	|	ВложенныйЗапрос.Цена КАК Цена,
	|	ВложенныйЗапрос.Сумма КАК Сумма,
	|	ВложенныйЗапрос.Сумма КАК СуммаПоПотребности,
	|	ВложенныйЗапрос.Этап КАК Этап,
	|	ВложенныйЗапрос.Валюта КАК Валюта,
	|	ВложенныйЗапрос.ДатаОперации КАК ДатаОперации,
	|	ВложенныйЗапрос.МестоПоставки КАК МестоПоставки,
	|	ВложенныйЗапрос.Организация КАК Организация,
	|	ВложенныйЗапрос.ЦФО КАК ЦФО,
	|	ВложенныйЗапрос.Проект КАК Проект,
	|	ВложенныйЗапрос.Коэффициент КАК Коэффициент,
	|	ВложенныйЗапрос.УсловиеОплаты КАК УсловиеОплаты,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	ВложенныйЗапрос.АналитикаИсточника КАК АналитикаИсточника,
	|	ВложенныйЗапрос.АналитикаПланирования КАК АналитикаПредыдущегоЭтапа,
	|	ВложенныйЗапрос.АналитикаИсточникаОбъектПланирования КАК ОбъектПланирования,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетов.ПриходРасход КАК ПриходРасход,
	|	ВложенныйЗапрос.КоличествоИсточник КАК КоличествоИсточник,
	|	ВложенныйЗапрос.СуммаИсточник КАК СуммаИсточник,
	|	ВложенныйЗапрос.АналитикаПланирования КАК АналитикаПланирования,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетовПоставки.СтатьяБюджета КАК СтатьяБюджетаПоставка,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетовПоставки.Аналитика1 КАК Аналитика1Поставка,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетовПоставки.Аналитика2 КАК Аналитика2Поставка,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетовПоставки.Аналитика3 КАК Аналитика3Поставка,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетовПоставки.Аналитика4 КАК Аналитика4Поставка,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетовПоставки.Аналитика5 КАК Аналитика5Поставка,
	|	ВложенныйЗапрос.АналитикаПланированияАналитикаСтатейБюджетовПоставки.Аналитика6 КАК Аналитика6Поставка
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДляОбработки
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.НоменклатураАналог КАК Номенклатура,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.ХарактеристикаАналог КАК Характеристика,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.ЕдиницаИзмеренияАналог КАК ЕдиницаИзмерения,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.ЦенаАналог КАК Цена,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.Этап КАК Этап,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.Валюта КАК Валюта,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.ДатаОперации КАК ДатаОперации,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.АналитикаПотребностей.МестоПоставки КАК МестоПоставки,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.АналитикаСтруктуры.Организация КАК Организация,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.АналитикаСтруктуры.Проект КАК Проект,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент КАК Коэффициент,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.УсловиеОплаты КАК УсловиеОплаты,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаИсточника КАК АналитикаИсточника,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования КАК АналитикаПланирования,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.КоличествоАналог КАК Количество,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.СуммаАналог КАК Сумма,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.Количество КАК КоличествоИсточник,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.Сумма КАК СуммаИсточник,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаИсточника.ОбъектПланирования КАК АналитикаИсточникаОбъектПланирования,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.АналитикаСтатейБюджетов КАК АналитикаПланированияАналитикаСтатейБюджетов,
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.АналитикаПланирования.АналитикаСтатейБюджетовПоставки КАК АналитикаПланированияАналитикаСтатейБюджетовПоставки
	|	ИЗ
	|		Документ.ЗаменаНоменклатуры.НоменклатураДляЗамены КАК ЗаменаНоменклатурыНоменклатураДляЗамены
	|	ГДЕ
	|		ЗаменаНоменклатурыНоменклатураДляЗамены.Ссылка = &Ссылка) КАК ВложенныйЗапрос");
	
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());    
	
	Запрос.Выполнить();     
	
	ВТ_ПланыОплат = Новый ТаблицаЗначений;
	ВТ_ПланыОплат.Колонки.Добавить("Документ"); 
	ВТ_ПланыОплат.Колонки.Добавить("ДатаПлатежа"); 
	ВТ_ПланыОплат.Колонки.Добавить("ДатаПоступления");
	ВТ_ПланыОплат.Колонки.Добавить("ПроцентОплат");
	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ПланыОплат", ВТ_ПланыОплат);
	
	Возврат ПараметрыПланирования;
	
КонецФункции


// Процедура инициализирует запрос данными таблиц, переданных в параметрах
Процедура ИнициализироватьЗапрос(Запрос, Объект)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, "Ссылка, Дата, Проведен");
	Для Каждого КлючЗначение Из РеквизитыДокумента Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла; 
	
    // Планы документа
	ПланыДокумента = ПланыДокумента(Объект, Запрос.МенеджерВременныхТаблиц); 
	
	Если ТипЗнч(ПланыДокумента) <> Тип("МенеджерВременныхТаблиц") Тогда
		ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(
			Запрос, "ВТ_ТаблицаОперацииБюджетов", ПланыДокумента);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти    

#Область СлужебныеПроцедурыИФункции

#Область ПланыДокумента

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = неопределено) Экспорт
	
	//    
	ТаблицаПланов = КонтрольЛимитовУХ.Новый_ТаблицаПланыДокумента();
	
	ТаблицаПланов.Колонки.Добавить("УсловиеОплаты", Новый ОписаниеТипов("СправочникСсылка.УсловияОплаты"));	
 	ТаблицаПланов.Колонки.Добавить("МестоПоставки", Новый ОписаниеТипов("СправочникСсылка.МестаПоставки")); 
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник,"ЗакупочнаяПроцедура")
			И НЕ Источник.ЗакупочнаяПроцедура.ПриобретениеФинансовыхУслуг Тогда
		// Это не фин.услуги, а закупки
		Возврат ПланированиеПотребностей.ПланыДокумента(Источник, МенеджерВременныхТаблиц);
	КонецЕсли;
	
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		ДанныеОбъекта = ДанныеОбъектаПоСсылке(Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаменаНоменклатуры") Тогда
		ДанныеОбъекта = Источник;
	ИначеЕсли ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура")Тогда
		ДанныеОбъекта = Источник;
	Иначе
		Возврат ТаблицаПланов;
	КонецЕсли;  
	
	Возврат ТаблицаПланов;
	
	
	ПредопределенныеДанные = Новый Структура;
	ПредопределенныеДанные.Вставить("Валюта", 					Источник.ВалютаДокумента);  
	ПредопределенныеДанные.Вставить("ПриходРасход", 			Перечисления.ВидыДвиженийПриходРасход.Приход);  
	ПредопределенныеДанные.Вставить("Дата", 					Источник.Дата);
	ПредопределенныеДанные.Вставить("ДокументРезервирования", 	Источник.Ссылка);
	ПредопределенныеДанные.Вставить("ДокументПланирования", 	Неопределено);
	ПредопределенныеДанные.Вставить("ВидБюджета", 				ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	ПредопределенныеДанные.Вставить("Предназначение",			ПланыВидовХарактеристик.ВидыБюджетов.Предназначение(ПредопределенныеДанные.ВидБюджета));   
	ПредопределенныеДанные.Вставить("ДатаОперации", 			Источник.Дата);
  	
	ПараметрыОП = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ПредопределенныеДанные.Предназначение, Источник.Дата);
		
	// уплата процентов 
	Для каждого ДанныеОбъектаСтрока Из ДанныеОбъекта.ЗаявкиНаПривлечениеФинансирования Цикл
		
		ГрафикУплатыПроцентовСтроки = ДанныеОбъекта.ГрафикУплатыПроцентов.НайтиСтроки(Новый Структура("Заявка", ДанныеОбъектаСтрока.Заявка));
		
		Для каждого СтрокаГрафика Из ГрафикУплатыПроцентовСтроки Цикл
			
			СтрокаПлана 	= ТаблицаПланов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПлана, ПредопределенныеДанные);
			ЗаполнитьЗначенияСвойств(СтрокаПлана, ДанныеОбъектаСтрока);  
			СтрокаПлана.СтатьяБюджета 	= ДанныеОбъектаСтрока.СтатьяДвиженияДенежныхСредствПроценты;
			СтрокаПлана.Аналитика1 		= ДанныеОбъектаСтрока.АналитикаПроценты1;
			СтрокаПлана.Аналитика2 		= ДанныеОбъектаСтрока.АналитикаПроценты2;
			СтрокаПлана.Аналитика3 		= ДанныеОбъектаСтрока.АналитикаПроценты3;
			СтрокаПлана.Аналитика4 		= ДанныеОбъектаСтрока.АналитикаПроценты4;
			СтрокаПлана.Аналитика5 		= ДанныеОбъектаСтрока.АналитикаПроценты5;
			СтрокаПлана.Аналитика6 		= ДанныеОбъектаСтрока.АналитикаПроценты6;
			
			СтрокаПлана.Сумма 	= СтрокаГрафика.Сумма;
			СтрокаПлана.Период  = СтрокаГрафика.Дата;
			
			СтрокаПлана.ПериодОтчета    =
			КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(СтрокаПлана.Период, ПараметрыОП.ПериодичностьОперативногоПланирования,0); 
			
		КонецЦикла; 
		
	КонецЦикла;   
	
	// Возврат Основной долг
	Для каждого ДанныеОбъектаСтрока Из ДанныеОбъекта.ЗаявкиНаПривлечениеФинансирования Цикл
		
		СтрокаПлана 	= ТаблицаПланов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПлана, ПредопределенныеДанные);
		ЗаполнитьЗначенияСвойств(СтрокаПлана, ДанныеОбъектаСтрока);  
		
		СтрокаПлана.СтатьяБюджета 	= ДанныеОбъектаСтрока.СтатьяДвиженияДенежныхСредствОсновнойДолг;
		СтрокаПлана.Аналитика1 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг1;
		СтрокаПлана.Аналитика2 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг2;
		СтрокаПлана.Аналитика3 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг3;
		СтрокаПлана.Аналитика4 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг4;
		СтрокаПлана.Аналитика5 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг5;
		СтрокаПлана.Аналитика6 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг6;
		СтрокаПлана.Сумма 			= ДанныеОбъектаСтрока.Сумма;
		СтрокаПлана.Период  		= ДанныеОбъектаСтрока.ДатаВозврата;
		
		СтрокаПлана.ПериодОтчета    =
			КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(СтрокаПлана.Период, ПараметрыОП.ПериодичностьОперативногоПланирования,0); 
			
	КонецЦикла;

	
	Возврат ТаблицаПланов;                    
		
КонецФункции  

Функция ДанныеОбъектаПоСсылке(Ссылка)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход) КАК ПриходРасход,
	|	ЗаменаНоменклатуры.Ссылка КАК Ссылка,
	|	ЗаменаНоменклатуры.ВерсияДанных КАК ВерсияДанных,
	|	ЗаменаНоменклатуры.ПометкаУдаления КАК ПометкаУдаления,
	|	ЗаменаНоменклатуры.Номер КАК Номер,
	|	ЗаменаНоменклатуры.Дата КАК Дата,
	|	ЗаменаНоменклатуры.Проведен КАК Проведен,
	|	ЗаменаНоменклатуры.НоменклатураДляЗамены.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Номенклатура КАК Номенклатура,
	|		Характеристика КАК Характеристика,
	|		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		Цена КАК Цена,
	|		Количество КАК Количество,
	|		Сумма КАК Сумма,
	|		Коэффициент КАК Коэффициент,
	|		НоменклатураАналог КАК НоменклатураАналог,
	|		ХарактеристикаАналог КАК ХарактеристикаАналог,
	|		ЕдиницаИзмеренияАналог КАК ЕдиницаИзмеренияАналог,
	|		ЦенаАналог КАК ЦенаАналог,
	|		КоличествоАналог КАК КоличествоАналог,
	|		СуммаАналог КАК СуммаАналог,
	|		АналитикаПланирования КАК АналитикаПланирования
	|	) КАК НоменклатураДляЗамены
	|ИЗ
	|	Документ.ЗаменаНоменклатуры КАК ЗаменаНоменклатуры
	|ГДЕ
	|	ЗаменаНоменклатуры.Ссылка = &Ссылка";     
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить();
	
	Возврат Результат[0];
КонецФункции

#КонецОбласти 


#КонецОбласти


#КонецЕсли