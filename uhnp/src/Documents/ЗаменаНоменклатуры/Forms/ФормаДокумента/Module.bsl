&НаСервере
Процедура ПриЧтенииСозданииНаСервере()  
	
	Для Каждого Замена Из Объект.НоменклатураДляЗамены Цикл
		Замена.ЭтоНоменклатура = ТипЗнч(Замена.Номенклатура) = Тип("СправочникСсылка.Номенклатура");	
		Замена.ЭтоНоменклатураАналог = ТипЗнч(Замена.НоменклатураАналог) = Тип("СправочникСсылка.Номенклатура");
	КонецЦикла;
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура НоменклатураДляЗаменыНоменклатураПриИзмененииНаСервере()       
	
	ИдентификаторСтроки = Элементы.НоменклатураДляЗамены.ТекущаяСтрока;
	ТекущаяСтрока = Объект.НоменклатураДляЗамены.НайтиПоИдентификатору(ИдентификаторСтроки);    
		
	ПланированиеПотребностейФормы.ОбработатьИзменениеНоменклатурыЗаявкиНаЗакупку(ЭтотОбъект, ТекущаяСтрока, Истина); 
	
	Если ТекущаяСтрока.ЭтоНоменклатура Тогда    
		ТекущаяСтрока["Сумма"] = 0; 
	Иначе
		ТекущаяСтрока["Количество"] = 0;  
	КонецЕсли;      
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	//УсловноеОформление.Элементы.Очистить();
	ПланированиеПотребностейФормы.УстановитьУсловноеОформлениеПлановДокумента(ЭтотОбъект, "НоменклатураДляЗамены", "Объект.НоменклатураДляЗамены"); 
	
	ЭлементУО = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СогласованиеПотребностей.РезультатСогласования");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Перечисления.РезультатыСогласования.ПустаяСсылка(); 
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СогласованиеПотребностейРезультатСогласования");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",	Нстр("ru = 'В обработке'"));   
	
КонецПроцедуры

&НаКлиенте
Процедура ПомощникПланирования(Команда)               
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("АдресХранилища", Новый УникальныйИдентификатор);
	ПараметрыОткрытия.Вставить("ИсточникЗамены", Объект.Ссылка);
	ОткрытьФорму("Обработка.ПомощникПланирования.Форма", ПараметрыОткрытия, ЭтаФорма, Истина, ,, Новый ОписаниеОповещения("ПомощникПланированияЗавершение", ЭтотОбъект),  РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПомощникПланированияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОписаниеДокумента = Результат.Описание; 
	ЗагрузитьДанныеПомощника(Результат);

КонецПроцедуры  

&НаСервере
Процедура ЗагрузитьДанныеПомощника(АдресТаблицы) 
	
	ТаблицаЗамен = ПолучитьИзВременногоХранилища(АдресТаблицы);	
	Объект.НоменклатураДляЗамены.Очистить();
	
	Для Каждого Строка Из ТаблицаЗамен Цикл    
		
		СтрокаЗамены = Объект.НоменклатураДляЗамены.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗамены, Строка);  
		
		СтрокаЗамены.ЕдиницаИзмеренияАналог = Строка.АналогЕдиницаИзмерения;
		СтрокаЗамены.НоменклатураАналог 	= Строка.АналогНоменклатура; 
		СтрокаЗамены.ХарактеристикаАналог 	= Строка.АналогХарактеристика;  
		СтрокаЗамены.Количество 			= Строка.КоличествоПотребность;
		СтрокаЗамены.КоличествоАналог 		= Строка.АналогКоличество; 
		СтрокаЗамены.ЦенаАналог 			= Строка.Цена;
		СтрокаЗамены.Цена 					= Строка.ЦенаИсходная;    
		СтрокаЗамены.СуммаАналог 			= Строка.АналогСумма;
		СтрокаЗамены.Сумма 					= Строка.СуммаПотребность;   
		
		СтрокаЗамены.ЭтоНоменклатура 		= ТипЗнч(СтрокаЗамены.Номенклатура) = Тип("СправочникСсылка.Номенклатура");	
		СтрокаЗамены.ЭтоНоменклатураАналог 	= ТипЗнч(СтрокаЗамены.НоменклатураАналог) = Тип("СправочникСсылка.Номенклатура");
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Для Каждого Замена Из Объект.НоменклатураДляЗамены Цикл
		Замена.ЭтоНоменклатура = ТипЗнч(Замена.Номенклатура) = Тип("СправочникСсылка.Номенклатура");	
		Замена.ЭтоНоменклатураАналог = ТипЗнч(Замена.НоменклатураАналог) = Тип("СправочникСсылка.Номенклатура");
	КонецЦикла;
КонецПроцедуры


