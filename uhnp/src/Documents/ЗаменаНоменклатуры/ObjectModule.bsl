Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)       
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда  
		
		УстановитьНовыйНомер();
		Дата = ТекущаяДата();
		
		ДанныеЗаполнения.Свойство("Субъекты223ФЗ", 	ЭтотОбъект.Субъекты223ФЗ);
		ДанныеЗаполнения.Свойство("ПериодЗакупки", 	ЭтотОбъект.ПериодЗакупки);
		
		Если ДанныеЗаполнения.Свойство("ДокументЗамены") Тогда
			
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения.ДокументЗамены, "Объект, Объект.Организация, Объект.ЦФО, Объект.Проект");
			ЭтотОбъект.ДокументЗамены 	= ЗначенияРеквизитов.Объект;
			ЭтотОбъект.Организация 		= ЗначенияРеквизитов.ОбъектОрганизация;
			ЭтотОбъект.ЦФО 				= ЗначенияРеквизитов.ОбъектЦФО;
			ЭтотОбъект.Проект 			= ЗначенияРеквизитов.ОбъектПроект;
			
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("НоменклатураДляЗамены") Тогда
			ЭтотОбъект.НоменклатураДляЗамены.Загрузить(ДанныеЗаполнения.НоменклатураДляЗамены);	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	ДополнительныеСвойства.Вставить("ИзмениласьПометкаУдаления", ПометкаУдаления <> Общегоназначения.ЗначениеРеквизитаОбъекта(Ссылка, "ПометкаУдаления"));
	ПланированиеПотребностей.ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи);

КонецПроцедуры

