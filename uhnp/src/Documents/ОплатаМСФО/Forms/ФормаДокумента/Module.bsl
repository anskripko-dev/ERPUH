	ОбработатьСтрокуТЧ(ЭтотОбъект, Элементы.РасшифровкаПлатежа.ТекущиеДанные, Действия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции_Общие

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Объект = Форма.Объект;
	
	УправлениеФормой_ВидОперации(Форма);
	МСФОКлиентСерверУХ.УправлениеФормой_ЦеныИВалюта(Форма);
	МСФОКлиентСерверУХ.УправлениеФормой_ПараметрыУчета(Форма, "ПараметрыУчетаДС");
	МСФОКлиентСерверУХ.УправлениеФормой_Итоги(Форма, "СуммаПлатежа", "РасшифровкаПлатежа");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой_ВидОперации(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	СтарыйВидОперации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.КэшируемыеЗначения, "ВидОперации");
	Если СтарыйВидОперации = Объект.ВидОперации Тогда
		Возврат;
	КонецЕсли;
	
	ВидОперации = ПараметрыВидаОплаты(Объект.ВидОперации);
	Элементы.СчетКонтрагента.Видимость 				= ВидОперации.ЭтоСписание;
	Элементы.РасшифровкаПлатежаСтавкаНДС.Видимость 	= ВидОперации.ЕстьКосвенныеНалоги;
	Элементы.РасшифровкаПлатежаСуммаНДС.Видимость 	= ВидОперации.ЕстьКосвенныеНалоги;
	
	Элементы.РасшифровкаПлатежаПараметрыУчетаВзаиморасчетов.Видимость	= ВидОперации.ВидимостьПараметровУчета;
	Элементы.ПараметрыУчетаДС.Видимость 								= ВидОперации.ВидимостьПараметровУчета;
	
	Элементы.Контрагент.ОграничениеТипа = ВидОперации.КонтрагентТип;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере(ТекущийОбъект = Неопределено)
	
	ЭтаФорма.КэшируемыеЗначения = Новый Структура;

	Действия = "ЗаполнитьУП, ЗаполнитьСтрану, ЗаполнитьПОУ";
	МСФОКлиентСерверУХ.ПриИзмененииРеквизита(ЭтотОбъект, Действия, Ложь);
	
	КэшируемыеЗначения.Вставить("ИменаСубконто", Документы.ОплатаМСФО.ПолучитьИменаСубконто());
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	МСФОУХ.ДобавитьОформлениеДоступностиСубконто(
		ЭтотОбъект, 
		КэшируемыеЗначения.ИменаСубконто.РасшифровкаПлатежа, 
		"РасшифровкаПлатежа", 
		Истина);

КонецПроцедуры

&НаКлиенте
Функция ПриИзмененииРеквизита(Элемент)
	
    Действия = Неопределено;
	ДействияТЧ = Неопределено;
	
	Если Элемент.Имя = "Организация" Тогда		
		Действия = "ЗаполнитьУП, ЗаполнитьСтрану, ЗаполнитьБанковскийСчет,
					|ЗаполнитьВалюту, ЗаполнитьКурс";
	ИначеЕсли Элемент.Имя = "Сценарий" Тогда
		Действия = "ЗаполнитьУП, ЗаполнитьСтрану, ЗаполнитьБанковскийСчет,
					|ЗаполнитьВалюту, ЗаполнитьКурс";
	ИначеЕсли Элемент.Имя = "Дата" Тогда
		Действия = "ЗаполнитьУП, ЗаполнитьСтрану, ЗаполнитьБанковскийСчет,
					|ЗаполнитьВалюту, ЗаполнитьКурс";
		
	ИначеЕсли Элемент.Имя = "ВидОперации" Тогда
		Действия = "ЗаполнитьПараметрыУчетаДС";
	ИначеЕсли Элемент.Имя = "СчетОрганизации" Тогда
		Действия = "ЗаполнитьВалюту, ЗаполнитьКурс, ЗаполнитьПараметрыУчетаДС";
	ИначеЕсли Элемент.Имя = "Контрагент" Тогда
		Действия = "ЗаполнитьОтборСубконто, ЗаполнитьБСчетКонтрагента";
	ИначеЕсли Элемент.Имя = "СуммаДокумента" Тогда
		//ДействияТЧ = "ЗаполнитьНДС";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Действия) Тогда
	    МСФОКлиентСерверУХ.ПриИзмененииРеквизита(ЭтотОбъект, Действия, Истина);
	КонецЕсли;
	
	Если Объект.РасшифровкаПлатежа.Количество() Тогда
		
		Остаток = (Объект.СуммаДокумента - Объект.РасшифровкаПлатежа.Итог("СуммаПлатежа"));
		
		СтрокаТЧ = Объект.РасшифровкаПлатежа[Объект.РасшифровкаПлатежа.Количество()-1];
		СтрокаТЧ.СуммаПлатежа = СтрокаТЧ.СуммаПлатежа + Остаток;
		
		ДействияТЧ = "ЗаполнитьНДС";
		
	Иначе
		
		СтрокаТЧ = Объект.РасшифровкаПлатежа.Добавить();
		СтрокаТЧ.СтатьяДвиженияДенежныхСредств = Неопределено;//**
		СтрокаТЧ.СуммаПлатежа = Объект.СуммаДокумента;
		
		ДействияТЧ = "ПолучитьПараметрыУчета, ЗаполнитьСубконтоПлатежа, 
						|ПолучитьСтавкуНДС, ЗаполнитьНДС";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДействияТЧ) Тогда
		Для каждого СтрокаТЧ Из Объект.РасшифровкаПлатежа Цикл
			ОбработатьСтрокуТЧ(ЭтотОбъект, СтрокаТЧ, ДействияТЧ, Ложь);
		КонецЦикла;		
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);

КонецФункции

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	ПоляОбъекта = Новый Структура(
		"Субконто1, Субконто2, Субконто3, Подразделение, НаправлениеДеятельности",
		"Субконто1", "Субконто2", "Субконто3", "Подразделение", "НаправлениеДеятельности");
	
	Для каждого СтрокаТаб Из Объект.РасшифровкаПлатежа Цикл
		
		СчетИсточник = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(
			СтрокаТаб.ПараметрыУчетаВзаиморасчетов, "СчетУчета.Счет");
			
		Если СчетИсточник = Неопределено Тогда
			СчетИсточник = Справочники.СчетаБД.ПустаяСсылка();
		КонецЕсли;	
			
		МСФОКлиентСерверУХ.УстановитьДоступностьСубконто(СчетИсточник, СтрокаТаб, ПоляОбъекта);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыВидаОплаты(ВидОплаты)
	Возврат Справочники.ВидыОплатМСФО.ПараметрыВидаОплат(ВидОплаты);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбработатьСтрокуТЧ(Форма, СтрокаТЧ, Действия, УправлениеФормой = Истина)
	
	ОбработкаТабличныхЧастейКлиентСерверУХ.ОбработатьСтрокуТЧП(СтрокаТЧ, Действия, Форма);
	
	Если УправлениеФормой Тогда
		УправлениеФормой(Форма);//пересчитать итог документа	
	КонецЕсли;
	
КонецФункции

#КонецОбласти