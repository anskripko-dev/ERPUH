#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьТабДокИсторияСогласования(ЗаявкаНаИзменениеНСИ) Экспорт
	
	Если ТипЗнч(ЗаявкаНаИзменениеНСИ)=Тип("Строка") Тогда
		
		ДокументСсылка=Документы.ЗаявкаНаИзменениеНСИ.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗаявкаНаИзменениеНСИ));
		
	Иначе
		
		ДокументСсылка=ЗаявкаНаИзменениеНСИ;
		
	КонецЕсли;
	
	ТабДок=Новый ТабличныйДокумент;
	
	ИмяОтчета="ИсторияСогласования";
	
	ОтчетПоИстории = Отчеты[ИмяОтчета].Создать();
	
	УстановитьЗначениеПараметраСКД(ОтчетПоИстории,"КлючевойОбъектПроцесса", ДокументСсылка);
    ОтчетПоИстории.СкомпоноватьРезультат(ТабДок);
		
	Возврат ТабДок; 
				
КонецФункции // ПолучитьТабДокИсторияСогласования() 

Процедура УстановитьЗначениеПараметраСКД(Отчет,ИмяПараметраВход, ЗначениеВход)
	// Найдем настройку и запомним её идентификатор.
	ЭлементыОтбора = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы;
	НайденныйИдентификатор = "----";
	Для Каждого ТекЭлементыОтбора Из ЭлементыОтбора Цикл
		Если Строка(ТекЭлементыОтбора.Параметр) = ИмяПараметраВход Тогда
			НайденныйИдентификатор = ТекЭлементыОтбора.ИдентификаторПользовательскойНастройки;
		КонецЕсли;
	КонецЦикла;
	// Изменим значение у найденной настройки.
	ЭлементыНастроек = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Для Каждого ТекЭлементыНастроек Из ЭлементыНастроек Цикл
		Если ТекЭлементыНастроек.ИдентификаторПользовательскойНастройки = НайденныйИдентификатор Тогда
			ТекЭлементыНастроек.Значение = ЗначениеВход;
			ТекЭлементыНастроек.Использование = Истина;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 

Функция ПолучитьТабДокХодСогласования(ЗаявкаНаИзменениеНСИ) Экспорт
	
	Если ТипЗнч(ЗаявкаНаИзменениеНСИ)=Тип("Строка") Тогда
		
		ДокументСсылка=Документы.ЗаявкаНаИзменениеНСИ.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗаявкаНаИзменениеНСИ));
		
	Иначе
		
		ДокументСсылка=ЗаявкаНаИзменениеНСИ;
		
	КонецЕсли;
	
	Согласующий = МодульУправленияПроцессамиУХ.ПолучитьОтветственногоЗаТипОбъекта(ДокументСсылка,,,,"Согласующий",Истина);
	
	Если НЕ Согласующий = Неопределено Тогда
		Если Не ТипЗнч(Согласующий) = Тип("СправочникСсылка.ШаблоныУниверсальныхПроцессов") Тогда	
			Согласующий = ПредопределенноеЗначение("Справочник.ШаблоныУниверсальныхПроцессов.Автоутверждение");	
		КонецЕсли;	
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СогласуемыйОбъект", ДокументСсылка);
	ПараметрыФормы.Вставить("ШаблонПроцесса", Согласующий);
	
	Объект=Обработки.КонсольУправленияПроцессом.Создать();
	Объект.ШаблонПроцесса=Согласующий;
	
	Если Объект.ШаблонПроцесса.НазначениеПроцесса = Перечисления.НазначенияУниверсальныхПроцессов.МаршрутСогласования Тогда
		
		Объект.ЭкземплярПроцесса = Неопределено;
		СогласуемыйОбъект = ДокументСсылка;
		ПроцессЗапущен = МодульУправленияПроцессамиУХ.ПроверитьПроцессИнициализирован(ДокументСсылка,Объект.ЭкземплярПроцесса,,Объект.ШаблонПроцесса);				
	
	ИначеЕсли Объект.ШаблонПроцесса = Справочники.ШаблоныУниверсальныхПроцессов.Автоутверждение Тогда
		
		Объект.ЭкземплярПроцесса = Неопределено;
		СогласуемыйОбъект = ДокументСсылка;
		ПроцессЗапущен = МодульУправленияПроцессамиУХ.ПроверитьПроцессИнициализирован(ДокументСсылка,Объект.ЭкземплярПроцесса,,Объект.ШаблонПроцесса);	
			
	КонецЕсли;
	
	Возврат Объект.СформироватьОтчет();  
				
КонецФункции // ПолучитьТабДокИсторияСогласования()

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");

КонецПроцедуры		
	
#КонецЕсли

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстШаблона=НСтр("ru = '%1 от %2'");
	Представление =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблона,Данные.Номер, Формат(Данные.Дата, "ДЛФ=D"));

		
КонецПроцедуры


