#Область УниверсальныеПроцессыСогласование

&НаСервере
Процедура ОпределитьСостояниеОбъекта(ОбновитьОтветственныхВход = Ложь)
	УправлениеФормойНСИСервер.ОпределитьСостояниеЗаявки(ЭтаФорма, ОбновитьОтветственныхВход,СогласованиеВнешняяИБ);
КонецПроцедуры	

&НаКлиенте
Процедура ПринятьКСогласованию_Подключаемый() Экспорт
	УправлениеФормойНСИКлиент.ПринятьКСогласованию(ЭтаФорма, ?(ЗначениеЗаполнено(ЗаявкаРодитель),ЗаявкаРодитель,Объект.Ссылка),СогласованиеВнешняяИБ);
КонецПроцедуры

&НаКлиенте
Процедура ИсторияСогласования_Подключаемый() Экспорт
	УправлениеФормойНСИКлиент.ИсторияСогласования(ЭтаФорма, ?(ЗначениеЗаполнено(ЗаявкаРодитель),ЗаявкаРодитель,Объект.Ссылка),СогласованиеВнешняяИБ);
КонецПроцедуры

&НаКлиенте
Процедура СогласоватьДокумент_Подключаемый() Экспорт  
	МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");
	МодульСогласования.СогласоватьДокумент(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСогласование_Подключаемый() Экспорт
	МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");
	МодульСогласования.ОтменитьСогласование(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура МаршрутСогласования_Подключаемый() Экспорт
	УправлениеФормойНСИКлиент.МаршрутСогласования(ЭтаФорма, ?(ЗначениеЗаполнено(ЗаявкаРодитель),ЗаявкаРодитель,Объект.Ссылка),СогласованиеВнешняяИБ);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииЭлементаОрганизации_Подключаемый(Элемент) Экспорт
	ОпределитьСостояниеОбъекта(Истина);		
	ВыполнитьПредыдущийОбработчикПриИзмененииОрганизации(Элемент);
КонецПроцедуры		// ПриИзмененииЭлементаОрганизации_Подключаемый()

// Возвращает значение реквизита СостояниеЗаявки на форме ФормаВход.
// Т.к. данный реквизит генерируется кодом, обращение к нему напрямую из
// кода недоступно.
&НаКлиентеНаСервереБезКонтекста
Функция РеквизитСостояниеЗаявки(ФормаВход)
	Возврат ФормаВход["СостояниеЗаявки"];
КонецФункции

// Возвращает значение реквизита СтатусОбъекта на форме ФормаВход.
// Т.к. данный реквизит генерируется кодом, обращение к нему напрямую из
// кода недоступно.
&НаКлиентеНаСервереБезКонтекста
Функция РеквизитСтатусОбъекта(ФормаВход)
	Возврат ФормаВход["СтатусОбъекта"];
КонецФункции

// Возвращает значение реквизита Согласующий на форме ФормаВход.
// Т.к. данный реквизит генерируется кодом, обращение к нему напрямую из
// кода недоступно.
&НаКлиентеНаСервереБезКонтекста
Функция РеквизитСогласующий(ФормаВход)
	Возврат ФормаВход["Согласующий"];
КонецФункции

// Выполняет обработчик ПриИзменении, сопоставленный по умолчанию для элемента Элемент
&НаКлиенте
Процедура ВыполнитьПредыдущийОбработчикПриИзмененииОрганизации(Элемент)
	#Если НЕ ВебКлиент Тогда
	ИмяЭлемента = Элемент.Имя;
	Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
		Для Каждого ТекОбработчикиИзмененияОрганизации Из ЭтаФорма["ОбработчикиИзмененияОрганизации"] Цикл
			Если СокрЛП(ТекОбработчикиИзмененияОрганизации.ИмяРеквизита) = СокрЛП(ИмяЭлемента) Тогда
				СтрокаВыполнения = ТекОбработчикиИзмененияОрганизации.ИмяОбработчика + "(Элемент);";
				Выполнить СтрокаВыполнения;
			Иначе
				// Выполняем поиск далее.
			КонецЕсли; 
		КонецЦикла;	
	Иначе
		// Передан пустой элемент.
	КонецЕсли;
	#КонецЕсли
КонецПроцедуры		// ВыполнитьПредыдущийОбработчикПриИзмененииОрганизации()

#КонецОбласти

// Формирует и изменяет заголовок формы документа.
&НаСервере
Процедура ВывестиЗаголовок()
	Заголовок = "(" + Строка(РеквизитСтатусОбъекта(ЭтаФорма)) + ")";
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДокументОбъект=РеквизитФормыВЗначение("Объект");
	
	ТекущийПользователь=Пользователи.ТекущийПользователь();
	ПроверитьВнешнееСогласование();
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		
		Если ЗначениеЗаполнено(Параметры.Основание) Тогда
			
			ТаблицаАналитики=Параметры.Основание.Метаданные().ПолноеИмя();
				
			ТипОбъектаКонсолидации="Справочник";
			ИмяОбъектаМетаданных=СтрЗаменить(ТаблицаАналитики,"Справочник.","");
				
					
			Объект.ТипОбъектаКонсолидации=ТипОбъектаКонсолидации;
			Объект.ИмяОбъектаМетаданных=ИмяОбъектаМетаданных;
			Объект.ИзменяемыйОбъект=Параметры.Основание;
			Объект.СправочникБД = Справочники.СправочникиБД.НайтиПоНаименованию(ИмяОбъектаМетаданных,,,Справочники.ТипыБазДанных.ТекущаяИБ);
			
			Если Параметры.Основание.НСИ_НеАктивный Тогда
				
				Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта;
				
			Иначе
				
				Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта;
				
			КонецЕсли;
					
		Иначе
			
			ЗаполнитьЗначенияСвойств(Объект,Параметры);
			
		КонецЕсли;
		
		Объект.Ответственный=ТекущийПользователь;
				
	КонецЕсли;
		
	Элементы.ГруппаМетаданные.ТолькоПросмотр=Истина;
 
	
	Если ЗначениеЗаполнено(Объект.ИзменяемыйОбъект) Тогда
		
		ТаблицаАналитики=Объект.ИзменяемыйОбъект.Метаданные().ПолноеИмя();
		
	КонецЕсли;
			
	#Область УниверсальныеПроцессыСогласование
		УправлениеФормойНСИСервер.НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта(ЭтаФорма,СогласованиеВнешняяИБ);
	#КонецОбласти
	
	Если РеквизитСтатусОбъекта(ЭтаФорма) = Перечисления.СостоянияСогласования.Утверждена Тогда
		
		Если НЕ ПользовательЯвляетсяОтветственным Тогда
			
			ЭтаФорма.ТолькоПросмотр=Истина;
			
		Иначе
			
			Элементы.ДанныеОбъекта.ТолькоПросмотр=Истина;
			Элементы.ВидОперации.ТолькоПросмотр=Истина;
			
		КонецЕсли;
		
	ИначеЕсли РеквизитСтатусОбъекта(ЭтаФорма) = Перечисления.СостоянияСогласования.НаУтверждении Тогда
		
		Если ПользовательЯвляетсяОтветственным Тогда
			
			Элементы.ДанныеОбъекта.ТолькоПросмотр=Истина;
			Элементы.ВидОперации.ТолькоПросмотр=Истина;

		ИначеЕсли НЕ (ТекущийПользователь=Объект.Ответственный) Тогда
			
			ЭтаФорма.ТолькоПросмотр=Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта;
	КонецЕсли;
	
	ОтобразитьДекорациюВнешняяИБ();
	
	ОбновитьДанныеСвязанныхЗаявок();
	ПроверитьВывестиОшибкиОбмена();
	
	УстановитьВидимость();
	
	ВывестиЗаголовок();
	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьВывестиОшибкиОбмена()
	
	Если Не СогласованиеВнешняяИБ Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СоответствиеЗаявокНаИзменениеНСИ.ИнформацияОбОшибке КАК ИнформацияОбОшибке
	|ИЗ
	|	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	|ГДЕ
	|	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза = &ЗаявкаДочерняяБаза
	|	И СоответствиеЗаявокНаИзменениеНСИ.ЕстьОшибкиОбмена = Истина";
	
	Запрос.УстановитьПараметр("ЗаявкаДочерняяБаза",Объект.Ссылка);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Элементы.ДекорацияОшибкаЗагрузки.Заголовок=Результат.ИнформацияОбОшибке;
	    Элементы.ДекорацияОшибкаЗагрузки.Видимость=Истина;
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьВывестиОшибкиОбмена() 	

&НаСервере
Процедура ОбновитьДанныеСвязанныхЗаявок() 
	
	ЗаполнитьДанныеСвязанныхЗаявок();
	
	ДанныеЗаявкиРодитель=УправлениеНСИ.ПолучитьРодительскуюЗаявку(Объект.Ссылка);
	
	Если (НЕ ДанныеЗаявкиРодитель=Неопределено) Тогда
			
		Если ДанныеЗаявкиРодитель.СпособСогласования=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьСинхронно Тогда
			
			ЗаявкаРодитель=ДанныеЗаявкиРодитель.ЗаявкаРодитель;
			
		КонецЕсли;
		
		Элементы.ДекорацияРодитель.Заголовок=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Согласуется в составе заявки № %1.'"),ЗаявкаРодитель);
	
	КонецЕсли; 
	
	СогласованиеСвязанныхЗаявок=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СправочникБД,"СогласованиеСвязанныхОбъектов");
		
КонецПроцедуры // ОбновитьДанныеСвязанныхЗаявок() 

&НаСервере
Процедура ЗаполнитьДанныеСвязанныхЗаявок()
	
	СвязанныеЗаявки.Очистить();
	
	ТабСвязанныхЗаявок=Объект.ЗаявкиНаИзменениеСвязанныхОбъектов.Выгрузить();
	
	Запрос=Новый Запрос;
		
	Если Метаданные.ОбщиеМодули.Найти("МодульСогласованияДокументовУХ")=Неопределено Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		             |	ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект
		             |ПОМЕСТИТЬ ТабСвязанныхЗаявок
		             |ИЗ
		             |	&ТабСвязанныхЗаявок КАК ТабСвязанныхЗаявок
		             |;
		             |
		             |////////////////////////////////////////////////////////////////////////////////
		             |ВЫБРАТЬ
		             |	ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект,
		             |	ЗаявкиНаИзменениеНСИ.ИзменяемыйОбъект КАК СвязанныйОбъект,
		             |	ЗаявкиНаИзменениеНСИ.ВидОперации КАК ВидОперации,
		             |	ВЫБОР
		             |		КОГДА СоответствиеЗаявокНаИзменениеНСИ.Состояние ЕСТЬ NULL
		             |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)
		             |		ИНАЧЕ СоответствиеЗаявокНаИзменениеНСИ.Состояние
		             |	КОНЕЦ КАК СостояниеСогласования,
		             |	ЗаявкиНаИзменениеНСИ.СправочникБД КАК СправочникБД,
		             |	ЗаявкиНаИзменениеНСИ.Номер КАК Номер
		             |ИЗ
		             |	ТабСвязанныхЗаявок КАК ТабСвязанныхЗаявок
		             |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаИзменениеНСИ КАК ЗаявкиНаИзменениеНСИ
		             |		ПО ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект = ЗаявкиНаИзменениеНСИ.Ссылка
		             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
		             |		ПО ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект = СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза
		             |
		             |УПОРЯДОЧИТЬ ПО
		             |	ЗаявкиНаИзменениеНСИ.Номер";
		
	Иначе
		
		Запрос.Текст="ВЫБРАТЬ
		             |	ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект
		             |ПОМЕСТИТЬ ТабСвязанныхЗаявок
		             |ИЗ
		             |	&ТабСвязанныхЗаявок КАК ТабСвязанныхЗаявок
		             |;
		             |
		             |////////////////////////////////////////////////////////////////////////////////
		             |ВЫБРАТЬ
		             |	ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект КАК ЗаявкаНаСвязанныйОбъект,
		             |	ЗаявкиНаИзменениеНСИ.ИзменяемыйОбъект КАК СвязанныйОбъект,
		             |	ЗаявкиНаИзменениеНСИ.ВидОперации КАК ВидОперации,
		             |	ВЫБОР
		             |		КОГДА РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта ЕСТЬ NULL
		             |			ТОГДА ВЫБОР
		             |					КОГДА СоответствиеЗаявокНаИзменениеНСИ.Состояние ЕСТЬ NULL
		             |						ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)
		             |					ИНАЧЕ СоответствиеЗаявокНаИзменениеНСИ.Состояние
		             |				КОНЕЦ
		             |		ИНАЧЕ РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта
		             |	КОНЕЦ КАК СостояниеСогласования,
		             |	ЗаявкиНаИзменениеНСИ.СправочникБД КАК СправочникБД
		             |ИЗ
		             |	ТабСвязанныхЗаявок КАК ТабСвязанныхЗаявок
		             |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаИзменениеНСИ КАК ЗаявкиНаИзменениеНСИ
		             |		ПО ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект = ЗаявкиНаИзменениеНСИ.Ссылка
		             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних(, ) КАК РегистрСостоянийОбъектовСрезПоследних
		             |		ПО ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект = РегистрСостоянийОбъектовСрезПоследних.Объект
		             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
		             |		ПО ТабСвязанныхЗаявок.ЗаявкаНаСвязанныйОбъект = СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза
		             |
		             |УПОРЯДОЧИТЬ ПО
		             |	ЗаявкиНаИзменениеНСИ.Номер";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТабСвязанныхЗаявок",ТабСвязанныхЗаявок);
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(),"СвязанныеЗаявки"); 
	
	Если СвязанныеЗаявки.Количество()>0 Тогда
		
		Элементы.ГруппаСвязанныеЗаявки.Заголовок=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Связанные заявки на изменение НСИ (%1)'"),СвязанныеЗаявки.Количество());
		
	КонецЕсли;	
		
КонецПроцедуры // ЗаполнитьДанныеСвязанныхЗаявок() 

&НаСервере
Процедура ОтобразитьДекорациюВнешняяИБ()
	
	Если СогласованиеВнешняяИБ Тогда
		
		Элементы.ДекорацияДочерняяИБ.Видимость=Истина;
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	СправочникиБД.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ
		             |ИЗ
		             |	Справочник.СправочникиБД КАК СправочникиБД
		             |ГДЕ
		             |	СправочникиБД.Ссылка = &ИзменяемыйОбъект";
		
		Запрос.УстановитьПараметр("ИзменяемыйОбъект",Объект.СправочникБД);
		
		Результат=Запрос.Выполнить().Выбрать();
		Результат.Следующий(); 
		
		Элементы.ДекорацияДочерняяИБ.Заголовок=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Согласуется в базе %1.'"),Результат.ЦентрализованнаяБазаНСИ);
	
	Иначе
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	СоответствиеЗаявокНаИзменениеНСИ.ДочерняяБаза КАК ДочерняяБаза
		|ИЗ
		|	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
		|ГДЕ
		|	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаЦентральнаяБаза = &ЗаявкаЦентральнаяБаза";
		
		Запрос.УстановитьПараметр("ЗаявкаЦентральнаяБаза",Объект.Ссылка);
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			Элементы.ДекорацияДочерняяИБ.Видимость=Истина;
			Элементы.ДекорацияДочерняяИБ.Заголовок=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Загружено из базы %1.'"),Результат.ДочерняяБаза);
			
		Иначе
			
			Элементы.ДекорацияДочерняяИБ.Видимость=Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОтобразитьДекорациюДочерняяИБ()

&НаСервере
Процедура ПроверитьВнешнееСогласование()

	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СправочникиБД.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ
	|ИЗ
	|	Справочник.СправочникиБД КАК СправочникиБД
	|ГДЕ
	|	СправочникиБД.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",Объект.СправочникБД);
	
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	СогласованиеВнешняяИБ=ЗначениеЗаполнено(Результат.ЦентрализованнаяБазаНСИ);
	
КонецПроцедуры // ПроверитьВнешнееСогласование() 

&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.ГруппаОбразцовыйОбъект.Видимость=Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта;
	КомандаПоиска=ЭтаФорма.Команды.Найти("ВыполнитьПоискДубликатов");

	Если Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта Тогда
		
		Элементы.ИзменяемыйОбъект.Заголовок=Нстр("ru = 'Новый элемент'");
		Элементы.ИсходноеЗначение.Заголовок=Нстр("ru = 'Значение реквизита'");
		Элементы.НовоеЗначение.Видимость=Ложь;
		Элементы.ВыполнитьПоискДубликатов.Видимость=Истина;
			
		КомандаПоиска.Подсказка=Нстр("ru = 'Поиск дубликатов элемента'");
		КомандаПоиска.ИзменяетСохраняемыеДанные=Ложь;
		Элементы.ГруппаДанныеЗаявок.ОтображениеСтраниц=ОтображениеСтраницФормы.ЗакладкиСверху;
		
	ИначеЕсли Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеОбъекта Тогда
		
		Элементы.ИзменяемыйОбъект.Заголовок=Нстр("ru = 'Удаляемый элемент'");
		Элементы.ИсходноеЗначение.Заголовок="Значение";
		Элементы.НовоеЗначение.Видимость=Ложь;
		Элементы.ВыполнитьПоискДубликатов.Видимость=Ложь;
		Элементы.ГруппаДанныеЗаявок.ОтображениеСтраниц=ОтображениеСтраницФормы.Нет;
		
	ИначеЕсли Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта Тогда
		
		Элементы.ИзменяемыйОбъект.Заголовок=Нстр("ru = 'Изменяемый элемент'");
		Элементы.ИсходноеЗначение.Заголовок=Нстр("ru = 'Исходное значение'");
			
		Элементы.НовоеЗначение.Видимость=Истина;
		Элементы.НовоеЗначение.Заголовок=Нстр("ru = 'Новое значение'");
		
		Элементы.ВыполнитьПоискДубликатов.Видимость=Ложь;
		
		Элементы.ГруппаДанныеЗаявок.ОтображениеСтраниц=ОтображениеСтраницФормы.ЗакладкиСверху;
		
	ИначеЕсли Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта Тогда
		
		Элементы.ИзменяемыйОбъект.Заголовок=Нстр("ru = 'Дублирующий элемент'");
		
		Элементы.ИсходноеЗначение.Заголовок=Нстр("ru = 'Дубликат'");
		
		Элементы.НовоеЗначение.Видимость=Истина;
		Элементы.НовоеЗначение.Заголовок=Нстр("ru = 'Эталон'");
		
		 МассивТипов=Новый Массив;
		 МассивТипов.Добавить(ТипЗнч(Объект.ИзменяемыйОбъект));
		 
		 Элементы.ОбразцовыйОбъект.ОграничениеТипа=Новый ОписаниеТипов(МассивТипов);
		 
		 Элементы.ВыполнитьПоискДубликатов.Видимость=Ложь;
		 
		 КомандаПоиска.Подсказка=Нстр("ru = 'Поиск эталонного элемента'");
		 КомандаПоиска.ИзменяетСохраняемыеДанные=Истина;
		 
		 Элементы.ГруппаДанныеЗаявок.ОтображениеСтраниц=ОтображениеСтраницФормы.Нет;
			
	КонецЕсли;	
		
	Если Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта
		ИЛИ Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта Тогда
		
		Элементы.ГруппаРеквизиты.Видимость=(Объект.ИзменениеРеквизитов.Количество()>0);
		Элементы.ГруппаТЧ.Видимость=(Объект.ИзменениеТЧ.Количество()>0); 
		
	Иначе
		
		Элементы.ГруппаРеквизиты.Видимость=Ложь;
		Элементы.ГруппаТЧ.Видимость=Ложь;
		
	КонецЕсли; 
	
	Элементы.ВыполнитьПоискДубликатов.Видимость=Не СогласованиеВнешняяИБ;
	
	Элементы.ВидОперации.СписокВыбора.Очистить();
	
	Если (Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта
		ИЛИ Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта)  
		И ЗначениеЗаполнено(Объект.Изменяемыйобъект) И Объект.Изменяемыйобъект.НСИ_НеАктивный Тогда
		
		Элементы.ВидОперации.ТолькоПросмотр=Ложь;	
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта);
		
	Иначе
		
		Элементы.ВидОперации.ТолькоПросмотр=Истина;
		Элементы.ВидОперации.СписокВыбора.Добавить(Объект.ВидОперации);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаРодитель) Тогда
		
		Если НЕ СогласованиеВнешняяИБ Тогда
			
			Элементы.СогласоватьДокумент.Доступность=Ложь;
			Элементы.ОтменитьСогласование.Доступность=Ложь;
			Элементы.ПринятьКСогласованию.Доступность=Ложь;

		КонецЕсли;
		
		Элементы.ФормаОтправитьИЗакрыть.Доступность=Ложь;
					
		Если СвязанныеЗаявки.Количество()=0 Тогда
			
			Элементы.ГруппаСвязанныеЗаявки.Видимость=Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ДекорацияРодитель.Видимость=ЗначениеЗаполнено(ЗаявкаРодитель);
	
	ВозможноСогласование=Истина;
	ЕстьЧерновики=Ложь;
	
	Если СогласованиеСвязанныхЗаявок=Перечисления.СпособыСогласованияСвязанныхОбъектов.СогласовыватьОтдельно Тогда
		
		ЭлементУсловногоОформления=УсловноеОформление.Элементы.Добавить();
		
		ПолеОтбора = ЭлементУсловногоОформления.Отбор.элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ПолеОтбора.ЛевоеЗначение =Новый ПолеКомпоновкиДанных("СвязанныеЗаявки.СостояниеСогласования");
		ПолеОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
		ПолеОтбора.ПравоеЗначение=Перечисления.СостоянияСогласования.Утверждена;
		
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Желтый);
		
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СвязанныеЗаявки");
		ОформляемоеПоле.Использование = Истина;
			
		Если СвязанныеЗаявки.Количество()>0 Тогда
			
			Для Каждого СтрокаЗаявка ИЗ СвязанныеЗаявки Цикл
				
				Если СтрокаЗаявка.СостояниеСогласования=Перечисления.СостоянияСогласования.Черновик Тогда
					
					ЕстьЧерновики=Истина;
					
				КонецЕсли;
				
				Если НЕ СтрокаЗаявка.СостояниеСогласования=Перечисления.СостоянияСогласования.Утверждена Тогда
					
					ВозможноСогласование=Ложь;
								
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ВозможноСогласование Тогда
				
				Если Не СогласованиеВнешняяИБ Тогда
					
					Элементы.СогласоватьДокумент.Доступность=Ложь;
					Элементы.ОтменитьСогласование.Доступность=Ложь;
					Элементы.ФормаОтправитьИЗакрыть.Доступность=Ложь;
					Элементы.ПринятьКСогласованию.Доступность=Ложь; 
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ДекорацияСвязанные.Видимость=Не ВозможноСогласование;
	Элементы.ОтправитьСвязанныеНаСогласование.Видимость=ЕстьЧерновики И (НЕ СогласованиеВнешняяИБ); 
	
КонецПроцедуры // УстановитьВидимость() 

// Выполняет процедуры на форме, связанные с изменением статуса объекта.
&НаСервере
Процедура ОпределитьСостояние()
	
	МодульСогласованияСервер=ОбщегоНазначения.ОбщийМодуль("ДействияСогласованиеУХСервер");
	МодульСогласованияСервер.ОпределитьСостояниеЗаявки(ЭтаФорма);
	ВывестиЗаголовок();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзмененийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭлементУправления=Элементы.ТаблицаИзменений.ПодчиненныеЭлементы.НовоеЗначение;
	
	СтрРеквизит=РеквизитыДляПоиска.НайтиСтроки(Новый Структура("ИмяРеквизита",Элементы.ТаблицаИзменений.ТекущиеДанные.ИмяРеквизита))[0];
	ЭлементУправления.ОграничениеТипа=СтрРеквизит.ТипЗначения;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзмененийПриИзменении(Элемент)
	
	СтрокаИзменений=Элементы.ТаблицаИзменений.ТекущиеДанные;
	
	Если НЕ СтрокаИзменений.ИсходноеЗначение=СтрокаИзменений.НовоеЗначение Тогда
		
		СтрокиОбъект=Объект.ИзменениеРеквизитов.НайтиСтроки(Новый Структура("ИмяРеквизита",СтрокаИзменений.ИмяРеквизита));
		
		Если СтрокиОбъект.Количество()=0 Тогда
			
			СтрокаДанные=Объект.ИзменениеРеквизитов.Добавить();
			
		Иначе
			
			СтрокаДанные=СтрокиОбъект[0];
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаДанные,СтрокаИзменений);
		
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры
 
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "МаршрутИнициализирован" Тогда
		
		ПриИнициализацииМаршрута()	
		
	ИначеЕсли ИмяСобытия = "ВыбранЭталонныйЭлемент" Тогда
		
		Объект.ОбразцовыйОбъект=Параметр;
		ПриИзмененииЭталонногоЭлемента();
		
	ИначеЕсли ИмяСобытия = "ОбъектСогласован" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояние();
		#КонецОбласти	
	ИначеЕсли ИмяСобытия = "ОбъектОтклонен" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояние();
		#КонецОбласти			
	ИначеЕсли ИмяСобытия = "ОбновитьМоиЗадачиИОповещения" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояние();
		#КонецОбласти			
	ИначеЕсли ИмяСобытия = "СостояниеЗаявкиПриИзменении" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояние();
		ЗаполнитьДанныеСвязанныхЗаявок();
		#КонецОбласти					
	КонецЕсли;
		
КонецПроцедуры

//ОБРАБОТЧИКИ СОГЛАСОВАНИЯ

// Определяет наличие согласующего по ссылке СсылкаВход.
&НаСервереБезКонтекста
Функция ЕстьСогласующий(СсылкаВход) 
	
	МодульУправлениеПроцессами=ОбщегоНазначения.ОбщийМодуль("МодульУправленияПроцессамиУХ");
	СогласующийРезультат = МодульУправлениеПроцессами.ПолучитьОтветственногоЗаТипОбъекта(СсылкаВход,,,,,Истина);
	РезультатФункции = ЗначениеЗаполнено(СогласующийРезультат);
	Возврат РезультатФункции;

КонецФункции

Процедура ПриИнициализацииМаршрута()
	
	МодульСогласованиеСервер=ОбщегоНазначения.ОбщийМодуль("ДействияСогласованиеУХСервер");
	МодульСогласованиеСервер.ОпределитьСостояниеЗаявки(ЭтаФорма);
    ЭтаФорма.Записать();

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИЗакрытьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Закрыть();
	Иначе
		// Пользователь отказался. Не вызываем закрытие формы.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИОтправитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");	
		МодульСогласования.ПринятьКСогласованию(ЭтаФорма, Объект.Ссылка);
	Иначе
		// Пользователь отказался. Не вызываем закрытие формы.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИЗакрыть(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда		
		Записать();			
	КонецЕсли;
	
	Если СогласованиеВнешняяИБ Тогда
		
		УправлениеФормойНСИКлиент.ПринятьКСогласованию(ЭтаФорма, Объект.Ссылка,СогласованиеВнешняяИБ);
		Закрыть();
		Возврат;
		
	КонецЕсли;
	
	СостояниеЧерновик="Перечисление.СостоянияПроцесса.Черновик";
	СостояниеОстановлен="Перечисление.СостоянияПроцесса.Остановлен";
	
	ТекСостояниеЗаявки = РеквизитСостояниеЗаявки(ЭтаФорма);
	ПроцессНеЗапущен = (Не ЗначениеЗаполнено(ТекСостояниеЗаявки)) ИЛИ (ТекСостояниеЗаявки = ПредопределенноеЗначение(СостояниеЧерновик)) ИЛИ (ТекСостояниеЗаявки = ПредопределенноеЗначение(СостояниеОстановлен));
	Если ПроцессНеЗапущен Тогда
		Если ЕстьСогласующий(Объект.Ссылка) Тогда
			МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");
			МодульСогласования.ПринятьКСогласованию(ЭтаФорма, Объект.Ссылка);
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения("ОтправитьИЗакрытьЗавершение", ЭтотОбъект);
			ТекстВопроса = НСтр("ru = 'Для данной заявки не определён согласующий. Согласование не будет запущено. Продолжить закрытие?'");
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Возврат;
		КонецЕсли;
	Иначе
		// Процесс уже запущен. Не отправляем.
	КонецЕсли;
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьФорму(Команда)
	ЭтаФорма.Записать();
	ТекСостояниеЗаявки = РеквизитСостояниеЗаявки(ЭтаФорма);
	
	СостояниеЧерновик="Перечисление.СостоянияПроцесса.Черновик";
	СостояниеОстановлен="Перечисление.СостоянияПроцесса.Остановлен";
	
	ПроцессНеЗапущен = (Не ЗначениеЗаполнено(ТекСостояниеЗаявки)) ИЛИ (ТекСостояниеЗаявки = ПредопределенноеЗначение(СостояниеЧерновик)) ИЛИ (ТекСостояниеЗаявки = ПредопределенноеЗначение(СостояниеОстановлен));
	Если ПроцессНеЗапущен Тогда
		Если ЕстьСогласующий(Объект.Ссылка) Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьИОтправитьЗавершение", ЭтотОбъект);
			ТекстВопроса = НСтр("ru = 'Отправить заявку на согласование?'");
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			// Нет согласующего. Не отправляем на согласование.
		КонецЕсли;
	Иначе
		// Процесс уже запущен. Не отправляем.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.Комментарий");
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИзмененияНаФорме(Команда)
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("Ключ",Объект.ИзменяемыйОбъект);
	СтруктураПараметров.Вставить("ЗаявкаНаИзменениеНСИ",Объект.Ссылка);
	
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта")
		ИЛИ Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта")
		Тогда
		
		СтруктураПараметров.Вставить("АдресХранилищаИзменений",ПолучитьДанныеИзменения());
		
	КонецЕсли;
	
	ОткрытьФорму(ТаблицаАналитики+".ФормаОбъекта",СтруктураПараметров,ЭтаФорма,Новый УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьДанныеТЧИзменений()

	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаявкаНаИзменениеНСИИзменениеТЧ.ТабличнаяЧасть КАК ТабличнаяЧасть,
	|	ЗаявкаНаИзменениеНСИИзменениеТЧ.НовоеЗначение КАК НовоеЗначение
	|ИЗ
	|	Документ.ЗаявкаНаИзменениеНСИ.ИзменениеТЧ КАК ЗаявкаНаИзменениеНСИИзменениеТЧ
	|ГДЕ
	|	ЗаявкаНаИзменениеНСИИзменениеТЧ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если НЕ Результат.Следующий() Тогда
		
		Возврат;
		
	Иначе
		
		ЗначениеТЧ=Результат.НовоеЗначение.Получить();
		
		Если ЗначениеТЧ=Неопределено Тогда
			
			ОбразцовыйОбъектПриИзмененииНаСервере();
			
		КонецЕсли;
		
	КонецЕсли;
				
КонецПроцедуры // ПроверитьОбновитьДанныеОбразцовогоОбъекта() 

&НаСервере
Функция ПолучитьДанныеИзменения()
	
	СтруктураИзменений=Новый Структура;
	
	Если Объект.ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта Тогда
		
		ПроверитьДанныеТЧИзменений();
		
	КонецЕсли;
			
	СтруктураИзменений.Вставить("ИзменениеРеквизитов",Объект.ИзменениеРеквизитов.Выгрузить());
	СтруктураИзменений.Вставить("ИзменениеТЧ",Объект.Ссылка.ИзменениеТЧ.Выгрузить());
	СтруктураИзменений.Вставить("ИмяОбъекта",Объект.ИзменяемыйОбъект.Метаданные().Имя); 
	СтруктураИзменений.Вставить("ВидОперации",Объект.ВидОперации);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураИзменений);
	
КонецФункции // ПолучитьДанныеИзменения()

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта")
		И (Не ЗначениеЗаполнено(Объект.ОбразцовыйОбъект)) Тогда
		
		ПоказатьПредупреждение(,Нстр("ru = 'Не указан эталонный элемент.'"));
		Отказ=Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииЭталонногоЭлемента()
	
	Если Объект.ОбразцовыйОбъект=Объект.ИзменяемыйОбъект Тогда
		
		ПоказатьПредупреждение(,Нстр("ru = 'Эталонный элемент совпадает с дубликатом.'"));
		Объект.ОбразцовыйОбъект=Неопределено;
		Возврат;
		
	КонецЕсли;
	
	ОбразцовыйОбъектПриИзмененииНаСервере();
	
КонецПроцедуры // ПриИзмененииЭталонногоЭлемента() 

&НаКлиенте
Процедура СвязанныеЗаявкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьФорму("Документ.ЗаявкаНаИзменениеНСИ.ФормаОбъекта",Новый Структура("Ключ",Элементы.СвязанныеЗаявки.ТекущиеДанные.ЗаявкаНаСвязанныйОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСвязаннуюЗаявку(Команда)
	
	Если Элементы.СвязанныеЗаявки.ТекущиеДанные=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаЗаявка=Объект.ЗаявкиНаИзменениеСвязанныхОбъектов.НайтиСтроки(Новый Структура("ЗаявкаНаСвязанныйОбъект",Элементы.СвязанныеЗаявки.ТекущиеДанные.ЗаявкаНаСвязанныйОбъект))[0];
	Объект.ЗаявкиНаИзменениеСвязанныхОбъектов.Удалить(Объект.ЗаявкиНаИзменениеСвязанныхОбъектов.Индекс(СтрокаЗаявка));
	СвязанныеЗаявки.Удалить(СвязанныеЗаявки.Индекс(Элементы.СвязанныеЗаявки.ТекущиеДанные));
	
	Модифицированность=Истина;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСвязаннуюЗаявку(Команда)

	ОткрытьФорму("Документ.ЗаявкаНаИзменениеНСИ.ФормаВыбора",Новый Структура("РежимВыбора",Истина),ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение)=Тип("ДокументСсылка.ЗаявкаНаИзменениеНСИ")
		И СвязанныеЗаявки.НайтиСтроки(Новый Структура("ЗаявкаНаСвязанныйОбъект",ВыбранноеЗначение)).Количество()=0 
		И (НЕ ВыбранноеЗначение=Объект.Ссылка) Тогда
		
		НоваяСтрока=Объект.ЗаявкиНаИзменениеСвязанныхОбъектов.Добавить();
		НоваяСтрока.ЗаявкаНаСвязанныйОбъект=ВыбранноеЗначение;
		ЗаполнитьДанныеСвязанныхЗаявок();
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияРодительНажатие(Элемент)
	
	ОткрытьФорму("Документ.ЗаявкаНаИзменениеНСИ.ФормаОбъекта",Новый Структура("Ключ",ЗаявкаРодитель));
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьСвязанныеНаСогласованиеНаСервере()
	
	Для Каждого СтрокаЗаявка ИЗ СвязанныеЗаявки Цикл
		
		Если СтрокаЗаявка.СостояниеСогласования=Перечисления.СостоянияСогласования.Черновик Тогда 
			
			Если СогласованиеВнешняяИБ Тогда
				
				УправлениеФормойНСИВызовСервера.ПринятьКСогласованиюВнешний(СтрокаЗаявка.СвязанныйОбъект);
				
			Иначе 
				
				Если Метаданные.ОбщиеМодули.Найти("МодульУправленияПроцессамиУХ") <> Неопределено Тогда
					
					МодульУправленияПроцессом= ОбщегоНазначения.ОбщийМодуль("МодульУправленияПроцессамиУХ"); 
					МодульУправленияПроцессом.ПринятьКОбработке(,СтрокаЗаявка.ЗаявкаНаСвязанныйОбъект);
					
					
				КонецЕсли
				
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьДанныеСвязанныхЗаявок();
	УстановитьВидимость();
				
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСвязанныеНаСогласование(Команда)
	ОтправитьСвязанныеНаСогласованиеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ОбразцовыйОбъектПриИзмененииНаСервере()
	
	Объект.ИзменениеРеквизитов.Очистить();
	Объект.ИзменениеТЧ.Очистить();
		
	Если ЗначениеЗаполнено(Объект.ОбразцовыйОбъект) Тогда
		
		СтруктураИзменений=УправлениеНСИ.ПолучитьСтруктуруСравненияОбъектов(Объект.ИзменяемыйОбъект,Объект.ОбразцовыйОбъект);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Записать();
	
	ДокументОбъект=Объект.Ссылка.ПолучитьОбъект();
		
	Если СтруктураИзменений.Свойство("ИзменениеРеквизитов") Тогда
		
		ДокументОбъект.ИзменениеРеквизитов.Загрузить(СтруктураИзменений.ИзменениеРеквизитов);
		
	КонецЕсли; 
	
	Если СтруктураИзменений.Свойство("ИзменениеТЧ") Тогда
		
		ДокументОбъект.ИзменениеТЧ.Загрузить(СтруктураИзменений.ИзменениеТЧ);
		
	КонецЕсли; 
	
	ДокументОбъект.ОбменДанными.Загрузка=Истина;
	ДокументОбъект.Записать();
	
	ЭтотОбъект.Прочитать();
	
	УстановитьВидимость();
		
КонецПроцедуры

&НаКлиенте
Процедура ОбразцовыйОбъектПриИзменении(Элемент)
		
	ПриИзмененииЭталонногоЭлемента()
		
КонецПроцедуры 

&НаКлиенте
Процедура ВыполнитьПоискДубликатов(Команда)
	
	ДанныеОбъекта=СтрРазделить(ТаблицаАналитики,".");
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ТипОбъектаКонсолидации",Объект.ТипОбъектаКонсолидации);
	СтруктураПараметров.Вставить("ИмяОбъектаМетаданных",ДанныеОбъекта[1]);
	СтруктураПараметров.Вставить("ЭлементДляПоиска",Объект.ИзменяемыйОбъект);
	СтруктураПараметров.Вставить("ВидОперации",Объект.ВидОперации); 
	
	ОткрытьФорму("Обработка.ПоискИСлияниеДублирующихсяЭлементов.Форма.ФормаПодбораДублирующихЭлементов",СтруктураПараметров);
		
КонецПроцедуры
