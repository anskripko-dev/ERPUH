
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Метаданные.ОбщиеМодули.Найти("МодульСогласованияДокументовУХ")=Неопределено Тогда
		
		ЭтаФорма.Список.ТекстЗапроса=ТекстЗапросаНеУХ();
		
	Иначе
		
		ЭтаФорма.Список.ТекстЗапроса=ТекстЗапросаУХ();
		ЕстьСогласование=Истина;
	
	КонецЕсли;
	
	Если Параметры.Свойство("ИзменяемыйОбъект") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"ИзменяемыйОбъект",Параметры.ИзменяемыйОбъект,ВидСравненияКомпоновкиДанных.Равно,,Истина);
	КонецЕсли; 
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	#Область УХ_Согласование	
	Если ЕстьСогласование Тогда
		
		МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");
		МодульСогласования.ОбработкаОповещенияФормыСписка(ИмяСобытия, Элементы.Список);
		
	КонецЕсли;	
	#КонецОбласти
КонецПроцедуры 

Функция ТекстЗапросаУХ()
	
	Возврат "ВЫБРАТЬ
	        |	ДокументЗаявкаНаИзменениеНСИ.Ссылка КАК Ссылка,
	        |	ДокументЗаявкаНаИзменениеНСИ.ПометкаУдаления КАК ПометкаУдаления,
	        |	ДокументЗаявкаНаИзменениеНСИ.Номер КАК Номер,
	        |	ДокументЗаявкаНаИзменениеНСИ.Дата КАК Дата,
	        |	ДокументЗаявкаНаИзменениеНСИ.ВидОперации КАК ВидОперации,
	        |	ДокументЗаявкаНаИзменениеНСИ.ИзменяемыйОбъект КАК ИзменяемыйОбъект,
	        |	ДокументЗаявкаНаИзменениеНСИ.Ответственный КАК Ответственный,
	        |	ДокументЗаявкаНаИзменениеНСИ.Комментарий КАК Комментарий,
	        |	ДокументЗаявкаНаИзменениеНСИ.СправочникБД КАК СправочникБД,
	        |	ВЫБОР
	        |		КОГДА РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта ЕСТЬ NULL
	        |			ТОГДА ВЫБОР
	        |					КОГДА СоответствиеЗаявокНаИзменениеНСИ.Состояние ЕСТЬ NULL
	        |						ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)
	        |					ИНАЧЕ СоответствиеЗаявокНаИзменениеНСИ.Состояние
	        |				КОНЕЦ
	        |		ИНАЧЕ РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта
	        |	КОНЕЦ КАК СостояниеОбъекта
	        |ИЗ
	        |	Документ.ЗаявкаНаИзменениеНСИ КАК ДокументЗаявкаНаИзменениеНСИ
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних(, ) КАК РегистрСостоянийОбъектовСрезПоследних
	        |		ПО ДокументЗаявкаНаИзменениеНСИ.Ссылка = РегистрСостоянийОбъектовСрезПоследних.Объект
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	        |		ПО ДокументЗаявкаНаИзменениеНСИ.Ссылка = СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза";
	
		
КонецФункции // ТекстЗапросаУХ() 

Функция ТекстЗапросаНеУХ()
	
	Возврат "ВЫБРАТЬ
	        |	ДокументЗаявкаНаИзменениеНСИ.Ссылка КАК Ссылка,
	        |	ДокументЗаявкаНаИзменениеНСИ.ПометкаУдаления КАК ПометкаУдаления,
	        |	ДокументЗаявкаНаИзменениеНСИ.Номер КАК Номер,
	        |	ДокументЗаявкаНаИзменениеНСИ.Дата КАК Дата,
	        |	ДокументЗаявкаНаИзменениеНСИ.Проведен КАК Проведен,
	        |	ДокументЗаявкаНаИзменениеНСИ.ВидОперации КАК ВидОперации,
	        |	ДокументЗаявкаНаИзменениеНСИ.ИзменяемыйОбъект КАК ИзменяемыйОбъект,
	        |	ДокументЗаявкаНаИзменениеНСИ.Ответственный КАК Ответственный,
	        |	ДокументЗаявкаНаИзменениеНСИ.Комментарий КАК Комментарий,
	        |	ДокументЗаявкаНаИзменениеНСИ.СправочникБД КАК СправочникБД,
	        |	ВЫБОР
	        |		КОГДА СоответствиеЗаявокНаИзменениеНСИ.Состояние ЕСТЬ NULL
	        |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)
	        |		ИНАЧЕ СоответствиеЗаявокНаИзменениеНСИ.Состояние
	        |	КОНЕЦ КАК СостояниеОбъекта,
	        |	СоответствиеЗаявокНаИзменениеНСИ.ЦентрализованнаяБазаНСИ КАК ВнешняяБаза
	        |ИЗ
	        |	Документ.ЗаявкаНаИзменениеНСИ КАК ДокументЗаявкаНаИзменениеНСИ
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	        |		ПО ДокументЗаявкаНаИзменениеНСИ.Ссылка = СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза";
	
		
КонецФункции // ТекстЗапросаНеУХ()
