#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ВыполнитьЗаменуДублей(ИсходныйЭлемент,ДублирующийЭлемент,Отказ)
	
	МассивДублей=Новый Массив;
	МассивДублей.Добавить(ДублирующийЭлемент);
	
	Отказ=НЕ УправлениеНСИ.ВыполнитьЗаменуЭлементов(ИсходныйЭлемент,МассивДублей);
	
КонецПроцедуры // ВыполнитьЗаменуДублей 

Процедура ВыполнитьДействияПоОбъекту(Отказ,ОтменаОперации) Экспорт
		
	Если ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеДубликатаОбъекта Тогда
		
		Если НЕ ОтменаОперации Тогда
			
			ВыполнитьЗаменуДублей(ОбразцовыйОбъект,ИзменяемыйОбъект,Отказ);
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;	
		
	СправочникОбъект=ИзменяемыйОбъект.ПолучитьОбъект();
	
	Если ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.РегистрацияНовогоОбъекта Тогда
		
		СправочникОбъект.НСИ_НеАктивный=ОтменаОперации;	
		
	ИначеЕсли ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.УдалениеОбъекта Тогда
		
		СправочникОбъект.ПометкаУдаления=Не ОтменаОперации;
		
	ИначеЕсли ВидОперации=Перечисления.ВидыОперацийИзмененияНСИ.ИзменениеРеквизитовОбъекта Тогда
				
		Для Каждого СтрИзменение Из ИзменениеРеквизитов Цикл
			
			СправочникОбъект[СтрИзменение.ИмяРеквизита]=?(ОтменаОперации,СтрИзменение.ИсходноеЗначение,СтрИзменение.НовоеЗначение);
			
		КонецЦикла; 
		
		Если НЕ ОтменаОперации Тогда
			
			Для Каждого СтрокаТЧ ИЗ ИзменениеТЧ Цикл
				
				ИмяТЧ=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.ТабличнаяЧасть,"Имя");
				СправочникОбъект[ИмяТЧ].Загрузить(СтрокаТЧ.НовоеЗначение.Получить());
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстОшибки = УправлениеНСИ.ПроверитьКонтролируемыеРеквизитыОбъекта(СправочникОбъект);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		
		СобытиеЖурналаРегистрации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			Нстр("ru = 'Запись объекта %1'"),
			ИзменяемыйОбъект);
		ШаблонСообщенияОбОшибке = Нстр("ru = 'Запись объекта %1 отменена по причине:
			|%2'");
		СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСообщенияОбОшибке,
			ИзменяемыйОбъект,
			ТекстОшибки);
			
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке ,ИзменяемыйОбъект, , ,Отказ);
			
		ЗаписьЖурналаРегистрации(
			СобытиеЖурналаРегистрации,
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СообщениеОбОшибке);
		
		Возврат;
		
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти("УправлениеНСИВнутренний") <> Неопределено Тогда
		
		ОписаниеОбъекта=УправлениеНСИ.ПолучитьДанныеОбъектаНСИ(СправочникОбъект.Метаданные().Имя);
		МодульУправлениеНСИВнутренний = ОбщегоНазначения.ОбщийМодуль("УправлениеНСИВнутренний");
		МодульУправлениеНСИВнутренний.ВыполнитьДействияПриОбработкеЗаявки(СправочникОбъект,Отказ,ОписаниеОбъекта.ЕстьРеквизитыИсторииИзменений);
		
	КонецЕсли;
	
	Попытка
		
		СправочникОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольНСИ",Истина);
		СправочникОбъект.Записать();
		
	Исключение
		
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(Нстр("ru = 'Не удалось изменить объект %1
		|:%2'"), ИзменяемыйОбъект, ОписаниеОшибки()),ИзменяемыйОбъект,,,Отказ);
				
	КонецПопытки;
				
КонецПроцедуры // ВыполнитьДействияПоОбъекту()

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидОперации) Тогда
		
		ТекстОшибки=Нстр("ru = 'Не указан вид операции.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,Отказ,,СтатусСообщения.Важное);
		
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ИзменяемыйОбъект) Тогда
		
		ТекстОшибки=Нстр("ru = 'Не указан изменяемый объект.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,Отказ,,СтатусСообщения.Важное);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли


