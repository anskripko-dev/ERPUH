// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
Функция ПроверитьВозможностьУстановкиСостояния(ОбъектСсылка, СостояниеОбъекта, ПротоколОшибок = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектСсылка) <> Тип("ДокументСсылка.ЗаявкаНаПривлечениеФинансирования") Тогда
		ТекстОшибки = СтрШаблон( 
			НСтр("ru = 'Объект %1 не является заявкой на привлечение финансирования'"),
			ОбъектСсылка);
		УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
			ПротоколОшибок, ОбъектСсылка, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ПроверкаПройдена = Истина;
	
	Если СостояниеОбъекта = Перечисления.СостоянияСогласования.Утверждена Тогда
		
		// Основной вариант финансирования
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаОперацию.Ссылка КАК Ссылка,
		|	ЗаявкаНаОперацию.Организация КАК Организация,
		|	ЗаявкаНаОперацию.ЦФО КАК ЦФО,
		|	ЗаявкаНаОперацию.СуммаЗаимствования КАК СуммаДокумента,
		|	ЗаявкаНаОперацию.ВалютаДокумента КАК ВалютаДокумента		
		|ИЗ
		|	Документ.ЗаявкаНаПривлечениеФинансирования КАК ЗаявкаНаОперацию
		|ГДЕ
		|	ЗаявкаНаОперацию.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
		
		ДанныеДокумента = Запрос.Выполнить().Выгрузить()[0];
		
		РеквизитыПроверяемыеНаЗаполнение = Новый СписокЗначений;
		РеквизитыПроверяемыеНаЗаполнение.Добавить("Организация", НСтр("ru = 'Организация'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("СуммаДокумента", НСтр("ru = 'Сумма привлечения'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("ВалютаДокумента", НСтр("ru = 'Валюта документа'"));
		Для Каждого ПроверяемыйРеквизит из РеквизитыПроверяемыеНаЗаполнение Цикл
			Если Не ЗначениеЗаполнено(ДанныеДокумента[ПроверяемыйРеквизит.Значение]) Тогда
				
				ПроверкаПройдена = Ложь;
				
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле","Заполнение",ПроверяемыйРеквизит.Представление);
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект." + ПроверяемыйРеквизит.Значение);
				
			КонецЕсли;
		КонецЦикла;
			
		ПараметрыБюджета = ДвиженияБюджетированиеКлиентСерверУХ.ПараметрыБюджета(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств);
		
				
	КонецЕсли;
	
	Если ОбъектСсылка.ПометкаУдаления И (СостояниеОбъекта = Перечисления.СостоянияСогласования.Утверждена 
		ИЛИ СостояниеОбъекта = Перечисления.СостоянияСогласования.Отклонена 
		ИЛИ СостояниеОбъекта = Перечисления.СостоянияСогласования.НаУтверждении) тогда
		
		ТекстОшибки = НСтр("ru = 'Установлена пометка удаления'");
		УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
			ПротоколОшибок, ОбъектСсылка, ТекстОшибки);
		ПроверкаПройдена = Ложь;
	КонецЕсли;
	
	Возврат ПроверкаПройдена;
	
КонецФункции

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт 

КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	// реквизиты документа.
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	ТекстыЗапроса 	= Новый СписокЗначений;
	
	ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокумента");
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка) Экспорт
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Реквизиты.Ссылка КАК Ссылка,
		|	Реквизиты.Дата КАК Дата,
		|	Реквизиты.Организация КАК Организация,
		|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
		|	Реквизиты.Ответственный КАК Ответственный,
		|	ЗНАЧЕНИЕ(Перечисление.РежимыИспользованияГрафика.РезервированиеБюджетаИКонтрольСоблюденияГрафика) КАК РежимИспользованияГрафика,
		|	Реквизиты.ЦФО КАК ЦФО,
		|	Реквизиты.Проект КАК Проект,
		|	Реквизиты.СуммаЗаимствования КАК СуммаЗаимствования,
		|	Реквизиты.ВидФинансирования КАК ВидФинансирования,
		|	Реквизиты.ДатаПривлечения КАК ДатаПривлечения,
		|	Реквизиты.ДатаВозврата КАК ДатаВозврата,
		|	Реквизиты.ВалютаДокумента КАК Валюта
		|ИЗ
		|	Документ.ЗаявкаНаПривлечениеФинансирования КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
		
	Для Каждого ТекРеквизит Из Реквизиты Цикл
		Запрос.УстановитьПараметр(ТекРеквизит.Ключ, ТекРеквизит.Значение);
	КонецЦикла;

	Запрос.МенеджерВременныхТаблиц = Документы.ЗаявкаНаПривлечениеФинансирования.ПланыДокумента(ДокументСсылка, Запрос.МенеджерВременныхТаблиц); 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИсточникиДляКонтроляДокумента
	
Функция ИсточникиДокумента(Объект, ДопПараметры = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект));

	Возврат Источники;
	
КонецФункции
	
Функция Источник_БюджетныеЛимитыРезервы(Объект)
	
	// Доп.параметры
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			НЕ ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);
	

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПланыДокумента(Объект);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Организация КАК Организация,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДокументПланирования КАК ДокументПланирования,
	|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВТ_ПланыДокумента.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.Проект КАК Проект,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.Аналитика6 КАК Аналитика6,
	|	0 КАК Лимит,
	|	СУММА(ВТ_ПланыДокумента.Сумма) КАК Зарезервировано,
	|	0 КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПланыДокумента.Аналитика6,
	|	ВТ_ПланыДокумента.ДокументПланирования,
	|	ВТ_ПланыДокумента.Аналитика1,
	|	ВТ_ПланыДокумента.ВидБюджета,
	|	ВТ_ПланыДокумента.ЦФО,
	|	ВТ_ПланыДокумента.СтатьяБюджета,
	|	ВТ_ПланыДокумента.Аналитика4,
	|	ВТ_ПланыДокумента.Аналитика3,
	|	ВТ_ПланыДокумента.Проект,
	|	ВТ_ПланыДокумента.Аналитика5,
	|	ВТ_ПланыДокумента.Организация,
	|	ВТ_ПланыДокумента.Период,
	|	ВТ_ПланыДокумента.Валюта,
	|	ВТ_ПланыДокумента.ПриходРасход,
	|	ВТ_ПланыДокумента.Аналитика2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПланыДокумента";
	
	Запрос.Выполнить();
	
	//
	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;
	
	
КонецФункции

#КонецОбласти 

#Область ПланыДокумента

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", 		Источник.Ссылка);
	Запрос.УстановитьПараметр("ЗаявкаПустая", 	Документы.ЗаявкаНаПривлечениеФинансирования.ПустаяСсылка());
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Заявка.Дата КАК ДатаРегистрации,
	|	Заявка.Организация КАК Организация,
	|	Заявка.ВалютаДокумента КАК Валюта,
	|	Заявка.Ссылка КАК ДокументПланирования,
	|	Заявка.Дата КАК Период,
	|	Заявка.ЦФО КАК ЦФО,
	|	Заявка.Проект КАК Проект,
	|	Заявка.СтатьяДвиженияДенежныхСредств КАК СтатьяБюджета,
	|	Заявка.Аналитика1 КАК Аналитика1,
	|	Заявка.Аналитика2 КАК Аналитика2,
	|	Заявка.Аналитика3 КАК Аналитика3,
	|	Заявка.Аналитика4 КАК Аналитика4,
	|	Заявка.Аналитика5 КАК Аналитика5,
	|	Заявка.Аналитика6 КАК Аналитика6,
	|	0 КАК Сумма,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	Документ.ЗаявкаНаПривлечениеФинансирования КАК Заявка
	|ГДЕ
	|	Заявка.Ссылка = &ЗаявкаПустая
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДатаДокумента,
	|	&Организация,
	|	&Валюта,
	|	&Ссылка,
	|	&ДатаПривлечения,
	|	&ЦФО,
	|	&Проект,
	|	&СтатьяДвиженияДенежныхСредствОсновнойДолг,
	|	&АналитикаОсновнойДолг1,
	|	&АналитикаОсновнойДолг2,
	|	&АналитикаОсновнойДолг3,
	|	&АналитикаОсновнойДолг4,
	|	&АналитикаОсновнойДолг5,
	|	&АналитикаОсновнойДолг6,
	|	&СуммаЗаимствования,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход),
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДатаДокумента,
	|	&Организация,
	|	&Валюта,
	|	&Ссылка,
	|	ГрафикРасчетов.Дата,
	|	&ЦФО,
	|	&Проект,
	|	&СтатьяДвиженияДенежныхСредств,
	|	&Аналитика1,
	|	&Аналитика2,
	|	&Аналитика3,
	|	&Аналитика4,
	|	&Аналитика5,
	|	&Аналитика6,
	|	ГрафикРасчетов.Сумма,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход),
