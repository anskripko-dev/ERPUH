#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗарегистрироватьСтатьиБюджетаИАналитики()
	
	АСБ = АналитикиСтатейБюджетовУХ;
	
	МассивОписанийСтатей = Новый Массив;
	МассивОписанийЭлеиментовСтатейИАналитик = Новый Массив;
	МассивОписанийЭлеиментовСтатейИАналитикТаблицыФормы = Новый Массив;
	
	АСБ.СтатьяИАналитикиОбъектаВПоляхФормы(МассивОписанийСтатей, 
											"СтатьяДвиженияДенежныхСредств", 	//ИмяРеквизитаСтатья
											"СтатьяДвиженияДенежныхСредств", 	//ИмяЭлементаСтатья
											"Аналитика%1",					//ШаблонИмениРеквизитаАналитика
											"Аналитика%1",	//ШаблонИмениЭлементаАналитика 
											ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ГруппаАналитики));	//РазмещениеНаФорме    

    АСБ.СтатьяИАналитикиОбъектаВПоляхФормы(МассивОписанийСтатей, 
											"СтатьяДвиженияДенежныхСредствОсновнойДолг", 	//ИмяРеквизитаСтатья
											"СтатьяДвиженияДенежныхСредствОсновнойДолг", 	//ИмяЭлементаСтатья
											"АналитикаОсновнойДолг%1",						//ШаблонИмениРеквизитаАналитика
											"АналитикаОсновнойДолг%1",						//ШаблонИмениЭлементаАналитика 
											ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ГруппаАналитикиОсновногоДолга));	//РазмещениеНаФорме
											
    АСБ.СтатьяИАналитикиОбъектаВПоляхФормы(МассивОписанийСтатей, 
											"ОсновнаяСтатьяИсполнение", 	//ИмяРеквизитаСтатья
											"ОсновнаяСтатьяИсполнение", 	//ИмяЭлементаСтатья
											"АналитикаИсполнение%1",						//ШаблонИмениРеквизитаАналитика
											"АналитикаИсполнение%1",						//ШаблонИмениЭлементаАналитика 
											ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ГруппаАналитикиБДР));	//РазмещениеНаФорме
											
    АСБ.СтатьяИАналитикиОбъектаВПоляхФормы(МассивОписанийСтатей, 
											"СтатьяДвиженияДенежныхСредствОсновнойДолгВозврат", 	//ИмяРеквизитаСтатья
											"СтатьяДвиженияДенежныхСредствОсновнойДолгВозврат", 	//ИмяЭлементаСтатья
											"АналитикаОсновнойДолгВозврат%1",						//ШаблонИмениРеквизитаАналитика
											"АналитикаОсновнойДолгВозврат%1",						//ШаблонИмениЭлементаАналитика 
											ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ГруппаАналитикиОсновногоДолгаВозврат));	//РазмещениеНаФорме
				
		
	// Создать элементы формы для статей бюджетов и их аналитик
	Если МассивОписанийСтатей.Количество() > 0 Тогда
		ПараметрыЭлементов = ПолучитьПараметрыЭлементов();
		АСБ.СоздатьСтатьиБюджетовИАналитики(ЭтотОбъект, МассивОписанийСтатей, ПараметрыЭлементов);
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Функция ПолучитьПараметрыЭлементов()
	
	ПараметрыЭлементов = ФормыУХ.ПолучитьПараметрыЭлементовПоУмолчанию();
	ПараметрыЭлементов.ГруппаВ.ОтображатьЗаголовок  = Ложь;
	ПараметрыЭлементов.ГруппаГ.ОтображатьЗаголовок  = Ложь;
	
	Возврат ПараметрыЭлементов;
	
КонецФункции

