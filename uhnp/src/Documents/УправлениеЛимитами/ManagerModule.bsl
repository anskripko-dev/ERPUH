	|	ВТ_Данные.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_Данные.Аналитика1 КАК Аналитика1,
	|	ВТ_Данные.Аналитика2 КАК Аналитика2,
	|	ВТ_Данные.Аналитика3 КАК Аналитика3,
	|	ВТ_Данные.Аналитика4 КАК Аналитика4,
	|	ВТ_Данные.Аналитика5 КАК Аналитика5,
	|	ВТ_Данные.Аналитика6 КАК Аналитика6,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.ЕстьЗначениеВВалютеРаскрытия
	|				И ВТ_Данные.ЗначениеВалюта <> 0
	|			ТОГДА ВТ_Данные.АналитикаВалюта
	|		ИНАЧЕ ВТ_Данные.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.ЕстьЗначениеВВалютеРаскрытия
	|				И ВТ_Данные.ЗначениеВалюта <> 0
	|			ТОГДА ВТ_Данные.ЗначениеВалюта
	|		ИНАЧЕ ВТ_Данные.Значение
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ВТ_ДляКлючевания
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|		ПО ВТ_Данные.Предназначение = ВидыБюджетов.Предназначение
	|ГДЕ
	|	ВТ_Данные.Валюта = ВТ_Данные.ОсновнаяВалюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	0 КАК НомерСтроки,
	|	ВТ_ДляКлючевания.Организация КАК Организация,
	|	ВТ_ДляКлючевания.ЦФО КАК ЦФО,
	|	ВТ_ДляКлючевания.Проект КАК Проект,
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка) КАК АналитикаСтруктуры
	|ИЗ
	|	ВТ_ДляКлючевания КАК ВТ_ДляКлючевания
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры
	|		ПО ВТ_ДляКлючевания.Организация = АналитикаПланированияСтруктуры.Организация
	|			И ВТ_ДляКлючевания.ЦФО = АналитикаПланированияСтруктуры.ЦФО
	|			И ВТ_ДляКлючевания.Проект = АналитикаПланированияСтруктуры.Проект
	|ГДЕ
	|	АналитикаПланированияСтруктуры.КлючАналитики ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	0 КАК НомерСтроки,
	|	ВТ_ДляКлючевания.ПриходРасход КАК ПриходРасход,
	|	ВТ_ДляКлючевания.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ДляКлючевания.Аналитика1 КАК Аналитика1,
	|	ВТ_ДляКлючевания.Аналитика2 КАК Аналитика2,
	|	ВТ_ДляКлючевания.Аналитика3 КАК Аналитика3,
	|	ВТ_ДляКлючевания.Аналитика4 КАК Аналитика4,
	|	ВТ_ДляКлючевания.Аналитика5 КАК Аналитика5,
	|	ВТ_ДляКлючевания.Аналитика6 КАК Аналитика6,
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтатейБюджетов.ПустаяСсылка) КАК АналитикаСтатейБюджетов
	|ИЗ
	|	ВТ_ДляКлючевания КАК ВТ_ДляКлючевания
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов
	|		ПО ВТ_ДляКлючевания.ПриходРасход = АналитикаПланированияСтатейБюджетов.ПриходРасход
	|			И ВТ_ДляКлючевания.СтатьяБюджета = АналитикаПланированияСтатейБюджетов.СтатьяБюджета
	|			И ВТ_ДляКлючевания.Аналитика1 = АналитикаПланированияСтатейБюджетов.Аналитика1
	|			И ВТ_ДляКлючевания.Аналитика2 = АналитикаПланированияСтатейБюджетов.Аналитика2
	|			И ВТ_ДляКлючевания.Аналитика3 = АналитикаПланированияСтатейБюджетов.Аналитика3
	|			И ВТ_ДляКлючевания.Аналитика4 = АналитикаПланированияСтатейБюджетов.Аналитика4
	|			И ВТ_ДляКлючевания.Аналитика5 = АналитикаПланированияСтатейБюджетов.Аналитика5
	|			И ВТ_ДляКлючевания.Аналитика6 = АналитикаПланированияСтатейБюджетов.Аналитика6
	|ГДЕ
	|	АналитикаПланированияСтатейБюджетов.КлючАналитики ЕСТЬ NULL";
	
	Результат = Запрос.ВыполнитьПакет();
	ПланированиеПотребностей.ВыполнитьКлючеваниеСтруктуры(Результат[2]);
	ПланированиеПотребностей.ВыполнитьКлючеваниеСтатейБюджетов(Результат[3]);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ_ДляКлючевания.ВидБюджета КАК ВидБюджета,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка) КАК ОбъектПланирования,
	|	ВТ_ДляКлючевания.ДатаОперации КАК Период,
	|	АналитикаПланированияСтруктуры.КлючАналитики КАК АналитикаСтруктуры,
	|	АналитикаПланированияСтатейБюджетов.КлючАналитики КАК АналитикаСтатейБюджетов,
	|	ВТ_ДляКлючевания.ПриходРасход КАК ПриходРасход,
	|	ВТ_ДляКлючевания.Валюта КАК Валюта,
	|	ВТ_ДляКлючевания.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ОперацииБюджетовКУстановке
	|ИЗ
	|	ВТ_ДляКлючевания КАК ВТ_ДляКлючевания
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры
	|		ПО ВТ_ДляКлючевания.Организация = АналитикаПланированияСтруктуры.Организация
	|			И ВТ_ДляКлючевания.ЦФО = АналитикаПланированияСтруктуры.ЦФО
	|			И ВТ_ДляКлючевания.Проект = АналитикаПланированияСтруктуры.Проект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов
	|		ПО ВТ_ДляКлючевания.ПриходРасход = АналитикаПланированияСтатейБюджетов.ПриходРасход
	|			И ВТ_ДляКлючевания.СтатьяБюджета = АналитикаПланированияСтатейБюджетов.СтатьяБюджета
	|			И ВТ_ДляКлючевания.Аналитика1 = АналитикаПланированияСтатейБюджетов.Аналитика1
	|			И ВТ_ДляКлючевания.Аналитика2 = АналитикаПланированияСтатейБюджетов.Аналитика2
	|			И ВТ_ДляКлючевания.Аналитика3 = АналитикаПланированияСтатейБюджетов.Аналитика3
	|			И ВТ_ДляКлючевания.Аналитика4 = АналитикаПланированияСтатейБюджетов.Аналитика4
	|			И ВТ_ДляКлючевания.Аналитика5 = АналитикаПланированияСтатейБюджетов.Аналитика5
	|			И ВТ_ДляКлючевания.Аналитика6 = АналитикаПланированияСтатейБюджетов.Аналитика6";
	Запрос.Выполнить();
	
	// Данные для сторнирования лимитов
	Если ТипЗнч(ДокументСсылка) = ТипЗнч(ПустаяСсылка()) Тогда 
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УправлениеЛимитамиДанные.ВидБюджета КАК ВидБюджета,
		|	УправлениеЛимитамиДанные.ЦФО КАК ЦФО,
		|	УправлениеЛимитамиДанные.Проект КАК Проект,
		|	УправлениеЛимитамиДанные.УОП КАК УОП,
		|	УправлениеЛимитамиДанные.Сценарий КАК Сценарий,
		|	УправлениеЛимитамиДанные.ПериодЛимитирования.ДатаНачала КАК ДатаНачала,
		|	УправлениеЛимитамиДанные.ПериодЛимитирования.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Документ.УправлениеЛимитами.Данные КАК УправлениеЛимитамиДанные
		|ГДЕ
		|	УправлениеЛимитамиДанные.Ссылка = &Ссылка";  
		
		ДанныеДляСторнирования = Запрос.Выполнить().Выгрузить();  
		
	Иначе
		ДанныеДляСторнирования = ДокументСсылка.Данные.Выгрузить();  
		
		ОписаниеТиповДаты = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя);
		ДанныеДляСторнирования.Колонки.Добавить("ДатаНачала", 	 ОписаниеТиповДаты);  
		ДанныеДляСторнирования.Колонки.Добавить("ДатаОкончания", ОписаниеТиповДаты); 
		                   
		Для Каждого СтрокаСторнирования Из ДанныеДляСторнирования Цикл  		
			РеквизитыПериодЛимитирования = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(
									СтрокаСторнирования.ПериодЛимитирования, "ДатаНачала, ДатаОкончания");
			
			СтрокаСторнирования.ДатаНачала = РеквизитыПериодЛимитирования.ДатаНачала;
			СтрокаСторнирования.ДатаОкончания = РеквизитыПериодЛимитирования.ДатаОкончания;
		КонецЦикла;

	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ДанныеДляСторнирования", ДанныеДляСторнирования);
	
КонецПроцедуры

Процедура ТекстЗапросаОперацииБюджетов(Запрос, ТекстыЗапроса)
	
	ИмяРегистра = "ОперацииБюджетов";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК ДатаРегистрации,
	|	&Ссылка КАК Регистратор,
	|	Запрос.ВидБюджета КАК ВидБюджета,
	|	Запрос.ОбъектПланирования КАК ОбъектПланирования,
	|	Запрос.Период КАК Период,
	|	Запрос.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	Запрос.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ВЫБОР
	|		КОГДА Запрос.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|		ИНАЧЕ Запрос.ПриходРасход
	|	КОНЕЦ КАК ПриходРасход,
	|	Запрос.Валюта КАК Валюта,
	|	СУММА(Запрос.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_ЛимитыКУстановке.ВидБюджета КАК ВидБюджета,
	|		ВТ_ЛимитыКУстановке.ОбъектПланирования КАК ОбъектПланирования,
	|		ВТ_ЛимитыКУстановке.Период КАК Период,
	|		ВТ_ЛимитыКУстановке.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|		ВТ_ЛимитыКУстановке.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|		ВТ_ЛимитыКУстановке.ПриходРасход КАК ПриходРасход,
	|		ВТ_ЛимитыКУстановке.Валюта КАК Валюта,
	|		ВТ_ЛимитыКУстановке.Сумма КАК Сумма
	|	ИЗ
	|		ВТ_ОперацииБюджетовКУстановке КАК ВТ_ЛимитыКУстановке
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_ЛимитыКСторнированию.ВидБюджета,
	|		ВТ_ЛимитыКСторнированию.ОбъектПланирования,
	|		ВТ_ЛимитыКСторнированию.Период,
	|		ВТ_ЛимитыКСторнированию.АналитикаСтруктуры,
	|		ВТ_ЛимитыКСторнированию.АналитикаСтатейБюджетов,
	|		ВТ_ЛимитыКСторнированию.ПриходРасход,
	|		ВТ_ЛимитыКСторнированию.Валюта,
	|		ВТ_ЛимитыКСторнированию.Сумма
	|	ИЗ
	|		ВТ_ОперацииБюджетовКСторнированию КАК ВТ_ЛимитыКСторнированию) КАК Запрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.ВидБюджета,
	|	Запрос.ОбъектПланирования,
	|	Запрос.Период,
	|	Запрос.АналитикаСтруктуры,
	|	Запрос.АналитикаСтатейБюджетов,
	|	Запрос.Валюта,
	|	ВЫБОР
	|		КОГДА Запрос.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|		ИНАЧЕ Запрос.ПриходРасход
	|	КОНЕЦ
	|
	|ИМЕЮЩИЕ
	|	СУММА(Запрос.Сумма) <> 0";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

Процедура ТекстЗапросаСостояния(Запрос, ТекстыЗапроса)
	
	ИмяРегистра = "УстановкаЛимитовПоДаннымБюджетированияСостояния";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Ссылка КАК Регистратор,
	|	ВТ_ПериодыЛимитирования.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПериодыЛимитирования.ЦФО КАК ЦФО,
	|	ВТ_ПериодыЛимитирования.Проект КАК Проект,
	|	ВТ_ПериодыЛимитирования.Периодичность КАК Периодичность,
	|	ВТ_ПериодыЛимитирования.НачалоПериода КАК НачалоПериода,
	|	ВТ_ПериодыЛимитирования.УОП КАК УОП,
	|	ВТ_ПериодыЛимитирования.УОП.Сценарий КАК Сценарий,
	|	&ВидОперации КАК ВидОперации,
	|	ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.ОтменаУстановкиЛимитов)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияУстановкиЛимитов.НеУстановлен)
	|		КОГДА ВТ_СостоянияСогласования.СостояниеСогласования = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Утвержден)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияУстановкиЛимитов.Установлен)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияУстановкиЛимитов.УстановленПоНеутвержденнымДанным)
	|	КОНЕЦ КАК Состояние
	|ИЗ
	|	ВТ_ПериодыЛимитирования КАК ВТ_ПериодыЛимитирования
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СостоянияСогласования КАК ВТ_СостоянияСогласования
	|		ПО ВТ_ПериодыЛимитирования.ВидБюджета = ВТ_СостоянияСогласования.ВидБюджета
	|			И ВТ_ПериодыЛимитирования.ЦФО = ВТ_СостоянияСогласования.ЦФО
	|			И ВТ_ПериодыЛимитирования.Проект = ВТ_СостоянияСогласования.Проект
	|			И ВТ_ПериодыЛимитирования.УОП = ВТ_СостоянияСогласования.УОП
	|ГДЕ
	|	ВТ_ПериодыЛимитирования.ПериодЛимитированияЗакрыт = ЛОЖЬ
	|	И (&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику)
	|	ИЛИ &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.ОтменаУстановкиЛимитов))";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

Процедура ТекстЗапросаВТ_ОперацииБюджетовКСторнированию(Запрос, ТекстыЗапроса, ДополнительныеСвойства)
	
	ШаблонЗапроса = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ВидБюджета КАК ВидБюджета,
	|	ВложенныйЗапрос.ОбъектПланирования КАК ОбъектПланирования,
	|	ВложенныйЗапрос.Период КАК Период,
	|	ВложенныйЗапрос.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ВложенныйЗапрос.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ВложенныйЗапрос.ПриходРасход КАК ПриходРасход,
	|	ВложенныйЗапрос.Валюта КАК Валюта,
	|	ВложенныйЗапрос.Сумма + ВложенныйЗапросЗаявлено.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ОперацииБюджетовКСторнированию
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеРегистра.ВидБюджета КАК ВидБюджета,
	|		ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка) КАК ОбъектПланирования,
	|		&НачалоПериода_НомерПериода КАК Период,
	|		ДанныеРегистра.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|		ДанныеРегистра.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|		ДанныеРегистра.ПриходРасход КАК ПриходРасход,
	|		ДанныеРегистра.Валюта КАК Валюта,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|		СУММА(ВЫБОР
	|				КОГДА НЕ ДанныеРегистра.Валюта = ДанныеРегистра.ВалютаЛимитирования
	|					ТОГДА -ДанныеРегистра.СуммаОборот
	|				ИНАЧЕ -ДанныеРегистра.ЛимитОборот
	|			КОНЕЦ) КАК Сумма
	|	ИЗ
	|		РегистрНакопления.ОперацииБюджетов.Обороты(
	|				&НачалоПериода_НомерПериода,
	|				&ОкончаниеПериода_НомерПериода,
	|				Регистратор,
	|				ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
	|					И ВидБюджета = &ВидБюджета_НомерПериода
	|					И АналитикаСтруктуры.ЦФО = &ЦФО_НомерПериода
	|					И АналитикаСтруктуры.Проект = &Проект_НомерПериода) КАК ДанныеРегистра
	|	ГДЕ
	|		(&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику)
	|				ИЛИ &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.ОтменаУстановкиЛимитов))
	|		И НЕ ДанныеРегистра.Регистратор = &Ссылка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ДанныеРегистра.ВидБюджета,
	|		ДанныеРегистра.АналитикаСтруктуры,
	|		ДанныеРегистра.АналитикаСтатейБюджетов,
	|		ДанныеРегистра.ПриходРасход,
	|		ДанныеРегистра.Валюта,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5,
	|		ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ДанныеРегистра.ВидБюджета КАК ВидБюджета,
	|			ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка) КАК ОбъектПланирования,
	|			&НачалоПериода_НомерПериода КАК Период,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|			ДанныеРегистра.ПриходРасход КАК ПриходРасход,
	|			ДанныеРегистра.Валюта КАК Валюта,
	|			ВЫБОР
	|				КОГДА НЕ ДанныеРегистра.Валюта = ДанныеРегистра.ВалютаЛимитирования
	|					ТОГДА СУММА(ВЫБОР
	|								КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
	|										И НЕ ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокКОбеспечению)
	|									ТОГДА ДанныеРегистра.СуммаОборот
	|								ИНАЧЕ 0
	|							КОНЕЦ) + СУММА(ДанныеРегистра.СуммаИсполненоОборот)
	|				ИНАЧЕ СУММА(ВЫБОР
	|							КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
	|									И НЕ ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокКОбеспечению)
	|								ТОГДА ДанныеРегистра.ЛимитОборот
	|							ИНАЧЕ 0
	|						КОНЕЦ) + СУММА(ДанныеРегистра.ЛимитИсполненоОборот)
	|			КОНЕЦ КАК Сумма,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6
	|		ИЗ
	|			РегистрНакопления.ОперацииБюджетов.Обороты(
	|					&НачалоПериода_НомерПериода,
	|					&ОкончаниеПериода_НомерПериода,
	|					Регистратор,
	|					ВидБюджета = &ВидБюджета_НомерПериода
	|						И АналитикаСтруктуры.ЦФО = &ЦФО_НомерПериода
	|						И АналитикаСтруктуры.Проект = &Проект_НомерПериода) КАК ДанныеРегистра
	|		ГДЕ
	|			(&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику)
	|					ИЛИ &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.ОтменаУстановкиЛимитов))
	|			И НЕ ДанныеРегистра.Регистратор = &Ссылка
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ДанныеРегистра.ВидБюджета,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.СтатьяБюджета,
	|			ДанныеРегистра.ПриходРасход,
	|			ДанныеРегистра.Валюта,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5,
	|			ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6,
	|			ДанныеРегистра.ВалютаЛимитирования) КАК ВложенныйЗапросЗаявлено
	|		ПО ВложенныйЗапрос.ВидБюджета = ВложенныйЗапросЗаявлено.ВидБюджета
	|			И ВложенныйЗапрос.АналитикаСтатейБюджетов.СтатьяБюджета = ВложенныйЗапросЗаявлено.СтатьяБюджета
	|			И ВложенныйЗапрос.АналитикаСтатейБюджетов.Аналитика1 = ВложенныйЗапросЗаявлено.Аналитика1
	|			И ВложенныйЗапрос.АналитикаСтатейБюджетов.Аналитика2 = ВложенныйЗапросЗаявлено.Аналитика2
	|			И ВложенныйЗапрос.АналитикаСтатейБюджетов.Аналитика3 = ВложенныйЗапросЗаявлено.Аналитика3
	|			И ВложенныйЗапрос.АналитикаСтатейБюджетов.Аналитика4 = ВложенныйЗапросЗаявлено.Аналитика4
	|			И ВложенныйЗапрос.АналитикаСтатейБюджетов.Аналитика5 = ВложенныйЗапросЗаявлено.Аналитика5
	|			И ВложенныйЗапрос.АналитикаСтатейБюджетов.Аналитика6 = ВложенныйЗапросЗаявлено.Аналитика6
	|ГДЕ
	|	ВложенныйЗапрос.Сумма + ВложенныйЗапросЗаявлено.Сумма < 0";
	
	Запросы = Новый Массив;
	
	Индекс = 0;
	Для Каждого ДанныеУстановки Из ДополнительныеСвойства.ДанныеДляСторнирования Цикл
		Индекс = Индекс + 1;
		НомерПериода = Формат(Индекс, "ЧГ=0");
		
		ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "_НомерПериода", НомерПериода);
		Если Индекс > 1 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ_ОперацииБюджетовКСторнированию", "");
		КонецЕсли;
		Запросы.Добавить(ТекстЗапроса);
		
		Запрос.УстановитьПараметр("НачалоПериода" + НомерПериода, НачалоДня(ДанныеУстановки.ДатаНачала));
		Запрос.УстановитьПараметр("ОкончаниеПериода" + НомерПериода, КонецДня(ДанныеУстановки.ДатаОкончания));
		Запрос.УстановитьПараметр("ВидБюджета" + НомерПериода, ДанныеУстановки.ВидБюджета);
		Запрос.УстановитьПараметр("ЦФО" + НомерПериода, ДанныеУстановки.ЦФО);
		Запрос.УстановитьПараметр("Проект" + НомерПериода, 	ДанныеУстановки.Проект);   
		Запрос.УстановитьПараметр("ТипыЗаявокКОбеспечению", КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению());   
		
	КонецЦикла;

	ТекстЗапроса = СтрСоединить(Запросы, 
	"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|");
		
	ИмяРегистра = "ВТ_ОперацииБюджетовКСторнированию";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

КонецПроцедуры 

Процедура ТекстЗапросаВТ_СостоянияПериодовЛимитирования(Запрос, ТекстыЗапроса)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования.ЦФО КАК ЦФО,
	|	МАКСИМУМ(УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования.ПериодЛимитированияЗакрыт) КАК ПериодЛимитированияЗакрыт
	|ПОМЕСТИТЬ ВТ_СостоянияПериодовЛимитирования
	|ИЗ
	|	ВТ_ПараметрыЛимитирования КАК УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования
	|ГДЕ
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования.Документ = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования.ВидБюджета,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыЛимитирования.ЦФО";
	
	ИмяРегистра = "ВТ_СостоянияПериодовЛимитирования";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры 

Процедура ТекстЗапросаВТ_ПериодыЛимитирования(Запрос, ТекстыЗапроса)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УправлениеЛимитамиДанные.ВидБюджета КАК ВидБюджета,
	|	УправлениеЛимитамиДанные.ЦФО КАК ЦФО,
	|	УправлениеЛимитамиДанные.Проект КАК Проект,
	|	УправлениеЛимитамиДанные.ПериодЛимитирования.Периодичность КАК Периодичность,
	|	УправлениеЛимитамиДанные.ПериодЛимитирования.ДатаНачала КАК НачалоПериода,
	|	УправлениеЛимитамиДанные.УОП КАК УОП,
	|	ЕСТЬNULL(ВТ_СостоянияПериодовЛимитирования.ПериодЛимитированияЗакрыт, ЛОЖЬ) КАК ПериодЛимитированияЗакрыт
	|ПОМЕСТИТЬ ВТ_ПериодыЛимитирования
	|ИЗ
	|	Документ.УправлениеЛимитами.Данные КАК УправлениеЛимитамиДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СостоянияПериодовЛимитирования КАК ВТ_СостоянияПериодовЛимитирования
	|		ПО УправлениеЛимитамиДанные.ВидБюджета = ВТ_СостоянияПериодовЛимитирования.ВидБюджета
	|			И УправлениеЛимитамиДанные.ЦФО = ВТ_СостоянияПериодовЛимитирования.ЦФО
	|ГДЕ
	|	УправлениеЛимитамиДанные.Ссылка = &Ссылка";
	
	ИмяРегистра = "ВТ_ПериодыЛимитирования";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры 

Процедура ТекстЗапросаВТ_СостоянияСогласования(Запрос, ТекстыЗапроса)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.Документ КАК Документ,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.ВидБюджета КАК ВидБюджета,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.ЦФО КАК ЦФО,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.Проект КАК Проект,
	|	МИНИМУМ(УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.СостояниеСогласования) КАК СостояниеСогласования,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.УОП КАК УОП
	|ПОМЕСТИТЬ ВТ_СостоянияСогласования
	|ИЗ
	|	ВТ_ПараметрыБюджетирования КАК УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования
	|ГДЕ
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.Документ = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.Документ,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.ВидБюджета,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.ЦФО,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.Проект,
	|	УстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.УОП";
	
	ИмяРегистра = "ВТ_СостоянияСогласования";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры 

Процедура ТекстЗапросаСостояниеПериодовЛимитирования(Запрос, ТекстыЗапроса)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	УправлениеЛимитамиДанные.ВидБюджета КАК ВидБюджета,
	|	УправлениеЛимитамиДанные.ЦФО КАК ЦФО,
	|	УправлениеЛимитамиДанные.Проект КАК Проект,
	|	УправлениеЛимитамиДанные.ПериодЛимитирования.Периодичность КАК Периодичность,
	|	УправлениеЛимитамиДанные.ПериодЛимитирования.ДатаНачала КАК НачалоПериода,
	|	ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.ЗакрытиеПериодовЛимитирования)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Закрыт
	|ИЗ
	|	Документ.УправлениеЛимитами.Данные КАК УправлениеЛимитамиДанные
	|ГДЕ
	|	УправлениеЛимитамиДанные.Ссылка = &Ссылка
	|	И (&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.ЗакрытиеПериодовЛимитирования)
	|			ИЛИ &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.ОткрытиеПериодовЛимитирования))";
	
	ИмяРегистра = "СостояниеПериодовЛимитирования";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

Процедура ТекстЗапросаАктуальность(Запрос, ТекстыЗапроса)
	
	ИмяРегистра = "АктуальностьУстановленныхЛимитов";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Период КАК Период,
	|	УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.Организация КАК Организация,
	|	УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.Проект КАК Проект,
	|	УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.ВидОтчета КАК ВидОтчета,
	|	УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.Область КАК Область,
	|	УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.УОП КАК УОП,
	|	УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.Предназначение КАК Предназначение,
	|	ИСТИНА КАК Актуальность,
	|	&Ссылка КАК Документ,
	|	&ТекущийПользователь КАК Пользователь
	|ИЗ
	|	ВТ_ЗначенияПоказателей КАК УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей
	|ГДЕ
	|	УстановкаЛимитовПоДаннымБюджетированияЗначенияПоказателей.Документ = &Ссылка
	|	И &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику)";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

Функция СкорректироватьТаблицуПоказателей(СтрокаДокумент, ТаблицаПоказателей)
	
	ШаблонАналитики = "Аналитика%1";
	ШаблонВидАналитики = "ВидАналитики%1";
	
	СтруктураПоиска = Новый Структура;
	Для НомерАналитики = 1 По ОперативноеПланированиеКонтроль.ПараметрСеанса_ЧислоДопАналитик() Цикл
		
		ИмяАналитики = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонАналитики, НомерАналитики);
		ИмяВидАналитики = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВидАналитики, НомерАналитики);
		
		Если Не ЗначениеЗаполнено(СтрокаДокумент[ИмяВидАналитики]) Тогда
			Прервать;
		КонецЕсли;
		
		Значение = СтрокаДокумент[ИмяАналитики];
		Если Значение = Неопределено Тогда
			Значение = СтрокаДокумент[ИмяВидАналитики].ТипЗначения.ПривестиЗначение();	
		КонецЕсли;
		                             
		СтруктураПоиска.Вставить(ИмяАналитики, Значение);
	КонецЦикла;
	
	Если СтруктураПоиска.Количество() = 0 Тогда
		Возврат ТаблицаПоказателей;
	КонецЕсли;
	
	Возврат ТаблицаПоказателей.Скопировать(СтруктураПоиска);
	
КонецФункции

Функция ИнициализироватьТаблицуЗначенияПоказателей() Экспорт 
	
	ТаблицаЗначенияПоказателей = Новый ТаблицаЗначений;	
	
	Для ном = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ТаблицаЗначенияПоказателей.Колонки.Добавить("Аналитика" + Формат(ном, "ЧГ="), Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип));
	КонецЦикла;
	
	ТаблицаЗначенияПоказателей.Колонки.Добавить("АналитикаВалюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("ВидБюджета", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыБюджетов"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("ВидОтчета", Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов"));  
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.УправлениеЛимитами")); 
	ТаблицаЗначенияПоказателей.Колонки.Добавить("ДокументБюджетирования", Метаданные.ОпределяемыеТипы.ДокументыБюджетирования.Тип);
	ТаблицаЗначенияПоказателей.Колонки.Добавить("ЕстьЗначениеВВалютеРаскрытия", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("ЗначениеВалюта", Новый ОписаниеТипов("Число"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Область", Новый ОписаниеТипов("СправочникСсылка.ОбластиДанныхВидовОтчетов"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Организация", Метаданные.ОпределяемыеТипы.Организация.Тип);
	ТаблицаЗначенияПоказателей.Колонки.Добавить("ПериодОтчета", Новый ОписаниеТипов("СправочникСсылка.Периоды"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Показатель", Новый ОписаниеТипов("СправочникСсылка.ПоказателиОтчетов"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("ПоказательПометкаУдаления", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Предназначение", Новый ОписаниеТипов("ПеречислениеСсылка.ПредназначенияЭлементовСтруктурыОтчета"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("Проект", 	Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("СтатьяБюджета", Метаданные.ПланыВидовХарактеристик.ВидыБюджетов.Тип);
	ТаблицаЗначенияПоказателей.Колонки.Добавить("УОП", Новый ОписаниеТипов("ДокументСсылка.УправлениеПериодомСценария"));
	ТаблицаЗначенияПоказателей.Колонки.Добавить("СтрокаОтчета", Новый ОписаниеТипов("СправочникСсылка.СтрокиОтчетов"));
	
	Возврат ТаблицаЗначенияПоказателей;
	
КонецФункции  

#Область ИсточникиДляКонтроляДокумента

Функция ИсточникиДокумента(Объект, ДопПараметры = Неопределено) Экспорт
	
	Источники = Новый Соответствие;
	
	// 1. Источник для контроля бюджетных лимитов и резервов
	КонтрольУХ.ДобавитьИсточник(
		Источники, 
		КонтрольУХБюджетныеЛимиты, 
		Источник_БюджетныеЛимитыРезервы(Объект));
	
	Возврат Источники;
	
КонецФункции

Функция Источник_БюджетныеЛимитыРезервы(Объект)
	
	ДопПараметрыИсточника = Новый Структура;
	ДопПараметрыИсточника.Вставить("Дата", 				 Объект.Дата);
	ДопПараметрыИсточника.Вставить("Ссылка", 			 Объект.Ссылка);
	ДопПараметрыИсточника.Вставить("ЭтоНовый", 			 Не ЗначениеЗаполнено(Объект.Ссылка));
	ДопПараметрыИсточника.Вставить("ДатаКонтроляЛимита", Объект.Дата);
	
	МенеджерВременныхТаблиц = ПланыДокумента(Объект);
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;          
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.ДатаОперации КАК ДатаОперации,
	|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
	|	НЕОПРЕДЕЛЕНО КАК ДокументРезервирования,
	|	ВТ_ПланыДокумента.АналитикаСтруктуры.ЦФО КАК ЦФО,
	|	ВТ_ПланыДокумента.АналитикаСтруктуры.Проект КАК Проект,
	|	ВТ_ПланыДокумента.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ПланыДокумента.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|	ВТ_ПланыДокумента.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|	ВТ_ПланыДокумента.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|	ВТ_ПланыДокумента.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|	ВТ_ПланыДокумента.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|	ВТ_ПланыДокумента.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.Лимит КАК Лимит,
	|	0 КАК Зарезервировано,
	|	0 КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ПланыДокумента КАК ВТ_ПланыДокумента";  
	
	Запрос.Выполнить();  
	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ТаблицаПлановССуммамиЛимитирования");

	Источник = Новый Структура;
	Источник.Вставить("Параметры", 		ДопПараметрыИсточника);
	Источник.Вставить("ПланыДокумента", Запрос.МенеджерВременныхТаблиц);
	
	Возврат Источник;   		
		
КонецФункции  

#КонецОбласти 

#Область ПланыДокумента
 
// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено) Экспорт

	ДополнительныеСвойства = Новый Структура;
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, Источник, ДополнительныеСвойства); 
	
	Если ДополнительныеСвойства.ДанныеДляСторнирования.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстыЗапроса = Новый СписокЗначений;
	
	ТекстЗапросаВТ_ОперацииБюджетовКСторнированию(Запрос, ТекстыЗапроса, ДополнительныеСвойства);
	ТекстЗапросаОперацииБюджетов(Запрос, ТекстыЗапроса);
	
	// Формирование текст запроса. 
	ТекстИтоговогоЗапроса = "";
	Для Каждого ТекстЗапроса Из ТекстыЗапроса Цикл
		ТекстИтоговогоЗапроса = ТекстИтоговогоЗапроса 
							+ ?(ТекстИтоговогоЗапроса <> "", Символы.ПС, "")
							+ "// " + ТекстЗапроса.Представление + Символы.ПС;
		ТекстИтоговогоЗапроса = ТекстИтоговогоЗапроса + ТекстЗапроса.Значение;
		
		ТекстИтоговогоЗапроса = ТекстИтоговогоЗапроса + ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета();		
	КонецЦикла;

	// Выполнение запроса.  
	Запрос.Текст = ТекстИтоговогоЗапроса; 
	Результат = Запрос.ВыполнитьПакет();
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;  
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_ПланыДокумента.ВидБюджета КАК ВидБюджета,
	|	ВТ_ПланыДокумента.Валюта КАК Валюта,
	|	ВТ_ПланыДокумента.Период КАК ДатаОперации,
	|	ВЫРАЗИТЬ(ВТ_ПланыДокумента.АналитикаСтруктуры КАК Справочник.КлючиАналитикиПланированияСтруктуры) КАК АналитикаСтруктуры,
	|	ВЫРАЗИТЬ(ВТ_ПланыДокумента.АналитикаСтатейБюджетов КАК Справочник.КлючиАналитикиПланированияСтатейБюджетов) КАК АналитикаСтатейБюджетов,
	|	ВТ_ПланыДокумента.ПриходРасход КАК ПриходРасход,
	|	ВТ_ПланыДокумента.Сумма КАК Лимит
	|ПОМЕСТИТЬ ВТ_ПланыДокумента
	|ИЗ
	|	&ВТ_ПланыДокумента КАК ВТ_ПланыДокумента";                 
	
	Запрос.УстановитьПараметр("ВТ_ПланыДокумента", Результат[Результат.Количество()-1]);
	Запрос.Выполнить();

	Возврат Запрос.МенеджерВременныхТаблиц;  
	
КонецФункции

#КонецОбласти 

#КонецОбласти

#КонецЕсли
