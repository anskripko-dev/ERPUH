Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка, ДополнительныеСвойства)
	 	
	Если ТипЗнч(ДокументСсылка) = ТипЗнч(ПустаяСсылка()) Тогда  
		ИменаРеквизитов = "Дата, ВидОперации";
		РеквизитыДокумента = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(ДокументСсылка, ИменаРеквизитов);
	Иначе
		РеквизитыДокумента = ДокументСсылка;  
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", РеквизитыДокумента.Дата);
    Запрос.УстановитьПараметр("ВидОперации", РеквизитыДокумента.ВидОперации);
    Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());    
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка.Ссылка);

	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ЗначенияПоказателей.Предназначение КАК Предназначение,
	|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
	|	ЗначенияПоказателей.ПериодОтчета.ДатаНачала КАК ДатаОперации,
	|	ЗначенияПоказателей.Организация КАК Организация,
	|	ЗначенияПоказателей.Проект КАК Проект, 
	|	ЗначенияПоказателей.ВидОтчета КАК ВидОтчета,
	|	ЗначенияПоказателей.Показатель.Строка.ПриходРасход КАК ПриходРасход,
	|	ЗначенияПоказателей.СтатьяБюджета КАК СтатьяБюджета,
	|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
	|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
	|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
	|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
	|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
	|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
	|	ПараметрыБюджетирования.ОсновнаяВалюта КАК ОсновнаяВалюта,
	|	ЗначенияПоказателей.Валюта КАК Валюта,
	|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
	|	ЗначенияПоказателей.Значение КАК Значение,
	|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта,
	|	ЗначенияПоказателей.ЕстьЗначениеВВалютеРаскрытия КАК ЕстьЗначениеВВалютеРаскрытия
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	ВТ_ЗначенияПоказателей КАК ЗначенияПоказателей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыБюджетирования КАК ПараметрыБюджетирования
	|		ПО ЗначенияПоказателей.Документ = ПараметрыБюджетирования.Документ
	|			И ЗначенияПоказателей.ВидБюджета = ПараметрыБюджетирования.ВидБюджета
	|			И ЗначенияПоказателей.Организация = ПараметрыБюджетирования.ЦФО
	|			И ЗначенияПоказателей.Проект = ПараметрыБюджетирования.Проект
	|			И ЗначенияПоказателей.ДокументБюджетирования = ПараметрыБюджетирования.ДокументБюджетирования
	|ГДЕ
	|	ЗначенияПоказателей.Документ = &Ссылка
	|	И &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику)
	|	И ЗначенияПоказателей.СтатьяБюджета.ЭтоГруппа = ЛОЖЬ
