Функция ТекстЗапроса_втОстаткиТК(НомераТаблиц)

	НомераТаблиц.Вставить("втОстатки", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.ПериодОтчета КАК Период,
	|	т.СчетИБ КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	СУММА(т.СуммаВВалютеУчетаОстаток) КАК СуммаВВалютеУчетаОстаток,
	|	т.Валюта КАК Валюта
	|ПОМЕСТИТЬ втОстатки
	|ИЗ
	|	ОстаткиАОСВ КАК т
	|
	|СГРУППИРОВАТЬ ПО
	|	т.НаправлениеДеятельности,
	|	т.Подразделение,
	|	т.ПериодОтчета,
	|	т.Валюта,
	|	т.СчетИБ,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3";
	
	ВыраженияРесурсов = Новый Структура("СуммаВВалютеУчета", "т.Значение");
	ПараметрыЗПС = МСФОЗапросыУХ.ПараметрыЗПС(Истина, "ОстаткиАОСВ", "Остатки", "СуммаВВалютеУчетаОстаток", ВыраженияРесурсов);
		
	Возврат МСФОЗапросыУХ.ТекстЗапроса_ДанныеАОСВ(ТекстЗапроса, ПараметрыЗПС);

