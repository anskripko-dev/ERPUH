Функция ТекстЗапроса_ПроводкиОстатки()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Период КАК Период,
	|	&Организация КАК Организация,
	|	&Сценарий КАК Сценарий,
	|	&ВидОперации КАК ВидОперации,
	|	""&Комментарий"" КАК Комментарий,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втЦены.ИндексЦены, втИндексыГраниц.НаНачало) = 0
	|			ТОГДА 0
	|		ИНАЧЕ т.СуммаВВалютеУчетаОстаток * (втИндексыГраниц.НаКонец / ЕСТЬNULL(втЦены.ИндексЦены, втИндексыГраниц.НаНачало) - 1)
	|	КОНЕЦ КАК СуммаВФункциональнойВалюте,
	|	т.Счет КАК СчетДт,
	|	т.Субконто1 КАК СубконтоДт1,
	|	т.Субконто2 КАК СубконтоДт2,
	|	т.Субконто3 КАК СубконтоДт3,
	|	т.Валюта КАК ВалютаДт,
	|	т.Подразделение КАК ПодразделениеДт,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	втСчетаОтражения.Счет КАК СчетКт,
	|	втСчетаОтражения.Субконто1 КАК СубконтоКт1,
	|	втСчетаОтражения.Субконто2 КАК СубконтоКт2,
	|	втСчетаОтражения.Субконто3 КАК СубконтоКт3,
	|	т.Валюта КАК ВалютаКт,
	|	т.Подразделение КАК ПодразделениеКт,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельностиКт
	|ИЗ
	|	втОстатки КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИндексыГраниц КАК втИндексыГраниц
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втЦеныНаДатыПоступлений КАК втЦены
	|		ПО (ЕСТЬNULL(т.Счет = втЦены.Счет, ИСТИНА))
	|			И (ЕСТЬNULL(т.Субконто1 = втЦены.Субконто1, ИСТИНА))
	|			И (ЕСТЬNULL(т.Субконто2 = втЦены.Субконто2, ИСТИНА))
	|			И (ЕСТЬNULL(т.Субконто3 = втЦены.Субконто3, ИСТИНА))
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаОтражения КАК втСчетаОтражения
	|		ПО втСчетаОтражения.ЭтоОстаток";
	
	Комментарий = НСтр("ru = 'Корректировка статей баланса на начало периода по индексу цен МСФО'", 
		ОбщегоНазначения.КодОсновногоЯзыка());
		
	Возврат СтрЗаменить(ТекстЗапроса, "&Комментарий", Комментарий);

КонецФункции

Функция ТекстЗапроса_ПроводкиОбороты()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Период КАК Период,
	|	&Организация КАК Организация,
	|	&Сценарий КАК Сценарий,
