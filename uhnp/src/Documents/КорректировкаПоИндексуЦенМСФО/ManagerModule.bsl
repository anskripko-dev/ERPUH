#Область Проведение

Функция ПодготовитьПараметрыПроведения(ДополнительныеСвойства, Отказ, ФормироватьПроводкиМСФО = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	ИменаПолей = "ИндексЦен, ДатаНачала, ДатаОкончания, ВидОтчета, ПериодОтчета";
	Реквизиты = МСФОУХ.РеквизитыДокумента(Запрос, ИменаПолей, "ПериодОтчета", Отказ);
	УстановитьПараметрыЗапроса(Запрос, Реквизиты);
	
	ДополнительныеСвойства.ДляПроведения.Вставить("Реквизиты", Реквизиты);
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = Новый Массив;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаУчета(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаОтражения(НомераТаблиц));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втИндексыГраниц(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втИндексыПериода(НомераТаблиц));
		
	ТекстЗапроса.Добавить(ТекстЗапроса_втИндексыДо(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втДатыПоступлений(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втРазличныеДатыПоступлений(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втДатыЦен(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втЦеныПоступлений(НомераТаблиц));
	
	Если Реквизиты.ФормироватьПроводкиМСФО Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_втОстаткиТУ(НомераТаблиц));
		ТекстЗапроса.Добавить(ТекстЗапроса_втОборотыТУ(НомераТаблиц));
	Иначе
		ДобавитьЗапросыТК(ТекстЗапроса, НомераТаблиц);
	КонецЕсли;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втДатыИндексовДляОборотов(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_ТаблицаПроводок(НомераТаблиц));
	
	Запрос.Текст = СтрСоединить(ТекстЗапроса, ПроведениеСерверУХ.РазделительЗапросовВПакете());
	
	Возврат ПроведениеСерверУХ.ДополнитьТаблицамиИзПакетаЗапросов(
		ДополнительныеСвойства.ТаблицыДляДвижений, Запрос, НомераТаблиц);

КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос, Реквизиты)
	
	Запрос.УстановитьПараметр("Ссылка",				Реквизиты.Ссылка);
	
	Запрос.УстановитьПараметр("Организация",		Реквизиты.Организация);
	Запрос.УстановитьПараметр("Сценарий",			Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("ПериодОтчета",		Реквизиты.ПериодОтчета);
	
	Запрос.УстановитьПараметр("Период",				Реквизиты.Период);
	Запрос.УстановитьПараметр("ДатаНачала",			НачалоДня(Реквизиты.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания",		КонецДня(Реквизиты.ДатаОкончания));
	
	Запрос.УстановитьПараметр("ВидОперации",		Справочники.ВидыОпераций.Трансляция);
	Запрос.УстановитьПараметр("ИндексЦен",			Реквизиты.ИндексЦен);
	Запрос.УстановитьПараметр("ВидОтчетаАОСВ", 		Справочники.ВидыОтчетов.ПолучитьВидОтчетаОСВ(Реквизиты.ПланСчетовМСФО));
	
	//Запрос.УстановитьПараметр("ТипыОбъектовУчета",	Метаданные.ОпределяемыеТипы.ОбъектУчетаМСФО.Тип.Типы());
	
	Реквизиты.Вставить("ВидОперации", Справочники.ВидыОпераций.Трансляция);

КонецПроцедуры

Процедура СформироватьДвижения(Движения, ДополнительныеСвойства, Отказ) Экспорт

	ЭтоТУ = ДополнительныеСвойства.ДляПроведения.Реквизиты.ФормироватьПроводкиМСФО;
	Если ЭтоТУ Тогда
		МСФОВызовСервераУХ.СформироватьДвижения(Движения, ДополнительныеСвойства, Отказ);
	Иначе
		
		МодульТК = ОбщегоНазначения.ОбщийМодуль("ТрансформационныеКорректировкиУХ");
		
		Реквизиты = ДополнительныеСвойства.ДляПроведения.Реквизиты;
		ТабОбщая = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПроводок.Скопировать();
		ТабОбщая.Колонки.СуммаВФункциональнойВалюте.Имя = "Значение";
		ТабОбщая.Индексы.Добавить("Период");
		
		ТабПериоды = ТабОбщая.Скопировать(, "Период");
		ТабПериоды.Свернуть("Период");
		
		Для каждого СтрокаПериод Из ТабПериоды Цикл
			
			ТаблицаПроводок 
				= ТабОбщая.Скопировать(Новый Структура("Период", СтрокаПериод.Период));
				
			Реквизиты.Вставить("ОтборТК", Новый Структура("ПериодОтчета", СтрокаПериод.Период));
			Реквизиты.ПериодОтчета = СтрокаПериод.Период;
			
			МодульТК.СформироватьКорректировку(
				Реквизиты, Отказ, ТаблицаПроводок);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ИндексыЦен

Функция ТекстЗапроса_втИндексыГраниц(НомераТаблиц)

	НомераТаблиц.Вставить("втИндексыГраниц", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	МИНИМУМ(тт.Период) КАК ПериодНаНачало,
	|	МАКСИМУМ(тт.Период) КАК ПериодНаКонец,
	|	СУММА(тт.НаНачало) КАК НаНачало,
	|	СУММА(тт.НаКонец) КАК НаКонец
	|ПОМЕСТИТЬ втИндексыГраниц
	|ИЗ
	|	(ВЫБРАТЬ
	|		НаНачало.Период КАК Период,
	|		НаНачало.Значение КАК НаНачало,
	|		0 КАК НаКонец
	|	ИЗ
	|		РегистрСведений.ЗначенияКотировокФИ.СрезПоследних(&ДатаНачала, ВидКотировки = &ИндексЦен) КАК НаНачало
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НаКонец.Период,
	|		0,
	|		НаКонец.Значение
	|	ИЗ
	|		РегистрСведений.ЗначенияКотировокФИ.СрезПоследних(&ДатаОкончания, ВидКотировки = &ИндексЦен) КАК НаКонец) КАК тт
	|
	|ИМЕЮЩИЕ
	|	СУММА(тт.НаНачало) > 0";

КонецФункции

Функция ТекстЗапроса_втИндексыПериода(НомераТаблиц)

	НомераТаблиц.Вставить("втИндексыПериода", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	ИзмененияПериода.Период КАК Период,
	|	ИзмененияПериода.Значение КАК Значение
	|ПОМЕСТИТЬ втИндексыПериода
	|ИЗ
	|	РегистрСведений.ЗначенияКотировокФИ КАК ИзмененияПериода
	|ГДЕ
	|	ИзмененияПериода.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ИзмененияПериода.ВидКотировки = &ИндексЦен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втИндексыГраниц.ПериодНаНачало,
	|	втИндексыГраниц.НаНачало
	|ИЗ
	|	втИндексыГраниц КАК втИндексыГраниц
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИзмененияПериода.Период";

КонецФункции

Функция ТекстЗапроса_втИндексыДо(НомераТаблиц)

	НомераТаблиц.Вставить("втИндексыДо", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	ИзмененияПериода.Период КАК Период,
	|	ИзмененияПериода.Значение КАК ИндексЦены
	|ПОМЕСТИТЬ втИндексыДо
	|ИЗ
	|	РегистрСведений.ЗначенияКотировокФИ КАК ИзмененияПериода
	|ГДЕ
	|	ИзмененияПериода.Период <= &ДатаНачала
	|	И ИзмененияПериода.ВидКотировки = &ИндексЦен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИзмененияПериода.Период";

КонецФункции

Функция ТекстЗапроса_втДатыПоступлений(НомераТаблиц)

	НомераТаблиц.Вставить("втДатыПоступлений", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК Номер,
	|	ВЫБОР
	|		КОГДА т.Счет <> ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)
	|			ТОГДА т.Счет
	|	КОНЕЦ КАК Счет,
	|	ВЫБОР
	|		КОГДА т.Субконто1 <> НЕОПРЕДЕЛЕНО
	|			ТОГДА т.Субконто1
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА т.Субконто2 <> НЕОПРЕДЕЛЕНО
	|			ТОГДА т.Субконто2
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА т.Субконто3 <> НЕОПРЕДЕЛЕНО
	|			ТОГДА т.Субконто3
	|	КОНЕЦ КАК Субконто3,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	т.ДатаПоступления КАК ДатаПоступления
	|ПОМЕСТИТЬ втДатыПоступлений
	|ИЗ
	|	РегистрСведений.ДатыДляИндексовЦенМСФО КАК т
	|ГДЕ
	|	т.ПериодОтчета = &ПериодОтчета
	|	И т.Организация = &Организация
	|	И т.Сценарий = &Сценарий
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаПоступления";

КонецФункции

Функция ТекстЗапроса_втРазличныеДатыПоступлений(НомераТаблиц)

	НомераТаблиц.Вставить("втРазличныеДатыПоступлений", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	т.ДатаПоступления КАК ДатаПоступления
	|ПОМЕСТИТЬ втРазличныеДатыПоступлений
	|ИЗ
	|	втДатыПоступлений КАК т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаПоступления";

КонецФункции

Функция ТекстЗапроса_втДатыЦен(НомераТаблиц)

	НомераТаблиц.Вставить("втДатыЦен", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	т.ДатаПоступления КАК ДатаПоступления,
	|	МАКСИМУМ(втИндексыДо.Период) КАК ДатаЦены
	|ПОМЕСТИТЬ втДатыЦен
	|ИЗ
	|	втРазличныеДатыПоступлений КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втИндексыДо КАК втИндексыДо
	|		ПО т.ДатаПоступления >= втИндексыДо.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ДатаПоступления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаПоступления,
	|	ДатаЦены";

КонецФункции

Функция ТекстЗапроса_втЦеныПоступлений(НомераТаблиц)

	НомераТаблиц.Вставить("втЦеныПоступлений", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	втИндексыДо.ИндексЦены КАК ИндексЦены,
	|	т.Номер КАК Номер,
	|	ВЫБОР
	|		КОГДА &ФормироватьПроводкиМСФО
	|			ТОГДА т.Счет.СчетСсылка
	|		ИНАЧЕ т.Счет
	|	КОНЕЦ КАК Счет,
	|	т.Счет КАК СчетИБ,
	|	т.Счет.СчетСсылка КАК СчетСсылка,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втЦеныНаДатыПоступлений
	|ИЗ
	|	втДатыПоступлений КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДатыЦен КАК втДатыЦен
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИндексыДо КАК втИндексыДо
	|			ПО втДатыЦен.ДатаЦены = втИндексыДо.Период
	|		ПО т.ДатаПоступления = втДатыЦен.ДатаПоступления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА &ФормироватьПроводкиМСФО
	|			ТОГДА т.Счет.СчетСсылка
	|		ИНАЧЕ т.Счет
	|	КОНЕЦ,
	|	Субконто1,
	|	Субконто2,
	|	Субконто3,
	|	Подразделение,
	|	НаправлениеДеятельности";

КонецФункции

#КонецОбласти

#Область Счета

Функция ТекстЗапроса_втСчетаУчета(НомераТаблиц)

	НомераТаблиц.Вставить("втСчетаУчета", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	СчетаБД.Ссылка КАК СчетИБ,
	|	СчетаБД.СчетСсылка КАК СчетМСФО,
	|	СчетаБД.Вид КАК Вид
	|ПОМЕСТИТЬ втСчетаУчета
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|ГДЕ
	|	СчетаБД.СчетСсылка.ПересчетВФВ = ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.НеМонетарный)";

КонецФункции

Функция ТекстЗапроса_втСчетаОтражения(НомераТаблиц)

	НомераТаблиц.Вставить("втСчетаОтражения", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Ссылка КАК ФиксированныйСчет,
	|	т.Ссылка = ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.НераспределеннаяПрибыльНепокрытыйУбытокПредыдущихПериодов) КАК ЭтоОстаток,
	|	т.Счет КАК СчетИБ,
	|	т.Счет.СчетСсылка КАК СчетМСФО,
	|	ВЫБОР
	|		КОГДА &ФормироватьПроводкиМСФО
	|			ТОГДА т.Счет.СчетСсылка
	|		ИНАЧЕ т.Счет
	|	КОНЕЦ КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ втСчетаОтражения
	|ИЗ
	|	Справочник.ФиксированныеСчетаУчетаБД КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс1
	|		ПО т.Счет = вс1.Ссылка
	|			И (вс1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс2
	|		ПО т.Счет = вс2.Ссылка
	|			И (вс1.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс3
	|		ПО т.Счет = вс3.Ссылка
	|			И (вс3.НомерСтроки = 3)
	|ГДЕ
	|	т.Ссылка В (ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.НераспределеннаяПрибыльНепокрытыйУбытокПредыдущихПериодов), ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ЭффектГиперинфляции))";

	Возврат Документы.УчетнаяПолитикаМСФО.ЗаменитьФиксированныеСчетаУчетаБД(ТекстЗапроса);

КонецФункции

