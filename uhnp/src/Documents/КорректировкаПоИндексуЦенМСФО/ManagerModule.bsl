Функция ТекстЗапроса_втОстаткиТУ(НомераТаблиц)

	НомераТаблиц.Вставить("втОстатки", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	&ДатаНачала КАК Период,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	т.СуммаВВалютеУчетаОстаток КАК СуммаВВалютеУчетаОстаток,
	|	т.Валюта КАК Валюта
	|ПОМЕСТИТЬ втОстатки
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(
	|			&ДатаНачала,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.СчетМСФО
	|				ИЗ
	|					втСчетаУчета КАК т),
	|			,
	|			Организация = &Организация
	|				И Сценарий = &Сценарий) КАК т";

