Процедура ДобавитьЗапросыТК(ТекстЗапроса, НомераТаблиц)
	
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ТекстЗапроса_втСПС(НомераТаблиц));
	
	#Область ОстаткиТК
	
	ИмяПериод = "ВЫБРАТЬ п.ПериодСценария ИЗ втСПС КАК п ГДЕ п.ЭтоНачало";
	ПараметрыВЗП = МСФОЗапросыУХ.ПараметрыВЗП(Истина, ИмяПериод, , , "&Ссылка");

	ВидыИтогов = "ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНД), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНК)";
	ПараметрыПС = МСФОЗапросыУХ.ПараметрыПС("ВЫБРАТЬ втСчетаУчета.СчетИБ ИЗ втСчетаУчета КАК втСчетаУчета", ВидыИтогов);
	
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ТекстЗапроса_втВЗП(НомераТаблиц, ПараметрыВЗП));
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ТекстЗапроса_втПС(НомераТаблиц, ПараметрыПС));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втОстаткиТК(НомераТаблиц));
	
	#КонецОбласти
	
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ТекстЗапроса_УничтожитьТаблицу(НомераТаблиц, "втВЗП"));
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ТекстЗапроса_УничтожитьТаблицу(НомераТаблиц, "втПоказателиОтчета"));
	
	#Область ОстаткиТК
	
	ИмяПериод = "ВЫБРАТЬ т.ПериодСценария ИЗ втСПС КАК т";
	ПараметрыВЗП = МСФОЗапросыУХ.ПараметрыВЗП(Истина, ИмяПериод, , , "&Ссылка");

	ВидыИтогов = "ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.ДО), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.КО)";
	ПараметрыПС = МСФОЗапросыУХ.ПараметрыПС("ВЫБРАТЬ втСчетаУчета.СчетИБ ИЗ втСчетаУчета КАК втСчетаУчета", ВидыИтогов);
	
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ТекстЗапроса_втВЗП(НомераТаблиц, ПараметрыВЗП, "втВЗП1"));
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ТекстЗапроса_втПС(НомераТаблиц, ПараметрыПС, "втПоказателиСчетов1"));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втОборотыТК(НомераТаблиц));
	
	#КонецОбласти
	
