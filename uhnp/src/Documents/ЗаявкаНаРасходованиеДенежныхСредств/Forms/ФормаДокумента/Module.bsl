	СтруктураПараметров.Вставить("ЮрФизЛицо",      ЮрФизЛицо);
	СтруктураПараметров.Вставить("Дата",           Объект.Дата);
	СтруктураПараметров.Вставить("ЭтоПлательщик",  Ложь);
	СтруктураПараметров.Вставить("ИНН",            ИННПолучателя);
	СтруктураПараметров.Вставить("КПП",            КПППолучателя);
	СтруктураПараметров.Вставить("Наименование",   ТекстПолучателя);
	
	ОткрытьФорму("Документ.СписаниеБезналичныхДенежныхСредств.Форма.РеквизитыПлательщика", СтруктураПараметров, ЭтотОбъект);

