&НаКлиенте
Функция УстановитьТипПлатежаПоЭлементуСтруктурыЗадолженности(ЭлементСтруктурыЗадолженности)
	
	ТипПлатежа = Неопределено;
	СоответствиеТиповПлатежей = Новый Соответствие;
	
	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ОплатаАрендодателю") Тогда
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.УслугаПоАренде"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.УслугаПоАренде")); 
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.УслугаПоАрендеАванс"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.УслугаПоАрендеАванс"));
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ОбеспечительныйПлатеж"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.ОбеспечительныйПлатеж"));
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ВыкупнаяСтоимость"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.ВыкупнаяСтоимость"));
		СоответствиеТиповПлатежей.Вставить(ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ВыкупнаяСтоимостьАванс"),
				ПредопределенноеЗначение("Перечисление.ТипыПлатежейПоАренде.ВыкупнаяСтоимостьАванс"));
		
		ТипПлатежа = СоответствиеТиповПлатежей.Получить(ЭлементСтруктурыЗадолженности);
	КонецЕсли;
	
	Для каждого СтрокаРасшифровки из Объект.РасшифровкаПлатежа цикл
		ТипПлатежа = СоответствиеТиповПлатежей.Получить(ЭлементСтруктурыЗадолженности);
		СтрокаРасшифровки.ТипПлатежаПоАренде = ТипПлатежа;	
	КонецЦикла;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДоговораСПоставками_УправлениеФормой(Форма)
	
	Объект 		= Форма.Объект;
	Элементы 	= Форма.Элементы;

	ЭтоОплатаПоПоставкам = Объект.ОплатаПоДоговоруПоставки;
	Элементы.ОплатаПоДоговоруПоставки.Видимость = ЭтоОплатаПоПоставкам;
	Элементы.Проект.ТолькоПросмотр 				= ЭтоОплатаПоПоставкам;
	Элементы.ДокументПланирования.ТолькоПросмотр 	= ЭтоОплатаПоПоставкам;
	Элементы.РасшифровкаПлатежаЦФО.Видимость 		= ЭтоОплатаПоПоставкам;
	Элементы.РасшифровкаПлатежаПроект.Видимость		= ЭтоОплатаПоПоставкам;
	
	Если ЭтоОплатаПоПоставкам Тогда
		Элементы.ЦФО.Заголовок	 		= НСтр("ru = 'ЦФО-исполнитель'");
		Элементы.Проект.Видимость 		= Ложь;
	Иначе
		Элементы.ЦФО.Заголовок 		= НСтр("ru = 'ЦФО'");
		Элементы.Проект.Видимость 	= Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДоговораСПоставками_ПриИзмененииДоговора()
	
	ЭтоОплатаПоставщику 	= Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	ДоговорЗаполнен 		= ЗначениеЗаполнено(Объект.Договор);
	Если ЭтоОплатаПоставщику И ДоговорЗаполнен Тогда 
		СтруктураРеквизитов  =  Новый Структура;
		СтруктураРеквизитов.Вставить("ОсновнойЦФО",    "ВерсияСоглашения.ОсновнойЦФО");
		СтруктураРеквизитов.Вставить("ГрафикДоговора", "ВерсияСоглашения.ГрафикДоговора");  
		СтруктураРеквизитов.Вставить("ИспользоватьГрафикПоставок", "ИспользоватьГрафикПоставок"); 
		СтруктураРеквизитов.Вставить("ИспользоватьГрафикРасчетов", "ИспользоватьГрафикРасчетов");
		РеквизитыДоговора 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, СтруктураРеквизитов);
		Объект.ОплатаПоДоговоруПоставки = РеквизитыДоговора.ИспользоватьГрафикПоставок;
		Если Объект.ОплатаПоДоговоруПоставки Тогда
			Объект.ЦФО 				= РеквизитыДоговора.ОсновнойЦФО;
			Объект.Проект 			= Справочники.Проекты.ПустаяСсылка();
			Объект.ДокументПланирования = Неопределено;
		ИначеЕсли РеквизитыДоговора.ИспользоватьГрафикРасчетов Тогда
			Объект.ДокументПланирования = Неопределено;
		КонецЕсли;
	Иначе
		Объект.ОплатаПоДоговоруПоставки = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаполнитьПоРезерву(Команда)

	ПараметрыПодбора = ПараметрыПодбораРезервов();
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодобратьРезервыЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ПодборРезервов.Форма.Форма",
		ПараметрыПодбора, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 

	КонецПроцедуры    
	
&НаСервере
Функция ПараметрыПодбораРезервов()
	
	мДоговорКонтрагента = ?(ЗначениеЗаполнено(Объект.ДоговорКонтрагента), Объект.ДоговорКонтрагента, Объект.Договор);
	ДокументПланирования = ?(ЗначениеЗаполнено(Объект.ДокументПланирования), Объект.ДокументПланирования, мДоговорКонтрагента);
	
	ПараметрыПодбора = Новый Структура("ДокументПланирования, СуммаДокумента, ДатаПланирования",
										   ДокументПланирования, Объект.СуммаДокумента, Объект.ЖелательнаяДатаПлатежа);
	АдресДвиженияОперации = ПоместитьВоВременноеХранилище(Объект.РасшифровкаПлатежа.Выгрузить(), УникальныйИдентификатор);
	ПараметрыПодбора.Вставить("АдресДвиженияОперации", АдресДвиженияОперации);
	
	Возврат ПараметрыПодбора;   
	
КонецФункции
	
&НаКлиенте
Процедура ПодобратьРезервыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьПодборРезервов(Результат.АдресОбъектовРасчетовВХранилище);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Процедура ОбработатьПодборРезервов(АдресОбъектовРасчетовВХранилище)
	
	ТаблицаОбъектов = ПолучитьИзВременногоХранилища(АдресОбъектовРасчетовВХранилище);
	ИспользоватьСуммуСтавкуНДС = ВидыОперацийУХКлиентСерверПовтИсп.ИспользоватьСуммуСтавкуНДС(Объект.ВидОперацииУХ);
	
	Для Каждого СтрокаЗаявки Из ТаблицаОбъектов Цикл        
		
		ПараметрыПоиска = Новый Структура();
		ПараметрыПоиска.Вставить("СтатьяДвиженияДенежныхСредств", СтрокаЗаявки.СтатьяБюджета);
		ПараметрыПоиска.Вставить("Аналитика1", СтрокаЗаявки.Аналитика1);
		ПараметрыПоиска.Вставить("Аналитика2", СтрокаЗаявки.Аналитика2);
		ПараметрыПоиска.Вставить("Аналитика3", СтрокаЗаявки.Аналитика3);
		ПараметрыПоиска.Вставить("Аналитика4", СтрокаЗаявки.Аналитика4);
		ПараметрыПоиска.Вставить("Аналитика5", СтрокаЗаявки.Аналитика5);
		ПараметрыПоиска.Вставить("Аналитика6", СтрокаЗаявки.Аналитика6);
						
		СтрокиПозиции = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыПоиска);
		Если СтрокиПозиции.Количество() > 0 Тогда
			СтрокаТЧ = СтрокиПозиции[0];
		Иначе
			СтрокаТЧ = Объект.РасшифровкаПлатежа.Добавить();
			СтрокаТЧ.СтатьяДвиженияДенежныхСредств = СтрокаЗаявки.СтатьяБюджета; 
			СтрокаТЧ.ЭлементСтруктурыЗадолженности = Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг; 
			СтрокаТЧ.ВалютаВзаиморасчетов = Объект.Валюта; 
			СтрокаТЧ.Сумма 		= СтрокаЗаявки.Сумма;    
			СтрокаТЧ.Партнер 	= ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.Контрагент, Объект.ХозяйственнаяОперация);
            СтрокаТЧ.Договор	= Объект.Договор;
			СтрокаТЧ.ДоговорАренды = Объект.ДоговорАренды;
			СтрокаТЧ.ДоговорКредитаДепозита = Объект.ДоговорКредитаДепозита;
			СтрокаТЧ.ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Объект.Договор);
			
			ДенежныеСредстваКлиентСервер.РассчитатьСуммуВзаиморасчетовВСтрокеРасшифровки(СтрокаТЧ, Объект.Валюта, ВалютаРеглУчета);
			ОбновитьСтавкуНДСИПересчитатьСуммуНДС(СтрокаТЧ.ПолучитьИдентификатор());    
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаЗаявки);
		ОперативноеПланированиеФормыУХКлиентСервер.ПересчитатьСуммуНДС(СтрокаТЧ);

	КонецЦикла;
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);

	ВыполнитьКонтрольДокументаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаполнитьПоГрафикуРасчетов(Команда)

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодобратьОплатыПоГрафикуРасчетовЗавершение", ЭтотОбъект);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ДоговорКонтрагента",		?(ЗначениеЗаполнено(Объект.Договор), Объект.Договор, Объект.ДоговорКонтрагента));
	ПараметрыОткрытияФормы.Вставить("ВидОперацииУХ",			Объект.ВидОперацииУХ);
	ПараметрыОткрытияФормы.Вставить("АдресВыбранныхОплат",		ПоместитьВоВременноеХранилищеВыбранныеОплаты(Объект.РасшифровкаПлатежа, УникальныйИдентификатор));
	ПараметрыОткрытияФормы.Вставить("ЗаблокироватьФорму",		ТолькоПросмотр);
	ПараметрыОткрытияФормы.Вставить("ЖелательнаяДатаПлатежа",	Объект.ЖелательнаяДатаПлатежа);
	ПараметрыОткрытияФормы.Вставить("ВидимостьОбъектРасчетов",	Элементы.РасшифровкаПлатежаОбъектРасчетов.Видимость);	
	             
	ОткрытьФорму("Документ.ЗаявкаНаРасходованиеДенежныхСредств.Форма.ФормаПодбораОплат",
					ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры 

&НаСервере
Функция ПоместитьВоВременноеХранилищеВыбранныеОплаты(Знач ТаблицаДвижений, Адрес)
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДвижений.Выгрузить(), Адрес);	

КонецФункции

&НаКлиенте
Процедура ПодобратьОплатыПоГрафикуРасчетовЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> Неопределено Тогда
		ОбработатьПодборОплатПоГрафикуРасчетов(Результат); 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборОплатПоГрафикуРасчетов(АдресПодобранныхОплат)
	
	Объект.РасшифровкаПлатежа.Очистить();
	
	ТаблицаОплат = ПолучитьИзВременногоХранилища(АдресПодобранныхОплат);
	ИспользоватьСуммуСтавкуНДС = ВидыОперацийУХКлиентСерверПовтИсп.ИспользоватьСуммуСтавкуНДС(Объект.ВидОперацииУХ);
	
	ЭтоАренда  = ЗначениеЗаполнено(Объект.ДоговорАренды); 
	Если ЭтоАренда Тогда
		ПараметрыДоговораАренды = РаботаСДоговорамиКонтрагентовЕХ.ПараметрыДоговораАренды(Объект.ДоговорАренды, ТекущаяДатаСеанса());		
	КонецЕсли;
	
	Для Каждого СтрокаОплаты Из ТаблицаОплат Цикл
		
		СтрокаТЧ = Объект.РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаОплаты);
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС) И ЭтоАренда Тогда
    		СтрокаТЧ.СтавкаНДС = ПараметрыДоговораАренды.СтавкаНДС;
			ЗаявкиНаОперацииКлиентСервер.ПересчитатьСуммуНДС(СтрокаТЧ);
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС) Тогда
			СтрокаТЧ.СтавкаНДС = ВстраиваниеУХЗаявкаНаРасходованиеДенежныхСредств.ПолучитьСтавкуНДСПоДоговору(Объект.Организация, Объект.ДоговорКонтрагента);
			ЗаявкиНаОперацииКлиентСервер.ПересчитатьСуммуНДС(СтрокаТЧ);
		КонецЕсли;
		
		СтрокаТЧ.ДоговорКредитаДепозита = Объект.ДоговорКредитаДепозита;
		СтрокаТЧ.ДоговорАренды = Объект.ДоговорАренды;

	КонецЦикла; 
	
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");

	Модифицированность = Истина;
	
	//Подключаемый_ПриИзмененииЭлементаУХ( 
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаполнитьПоЗадолженности(Команда)
	
	ПараметрыПодбора 	= ПараметрыПодбораОбъектов();
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодобратьОбъектыЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ПодборОбъектовРасчетов.Форма.Форма",
		ПараметрыПодбора, ЭтаФорма,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры  

&НаКлиенте
Функция ПараметрыПодбораОбъектов()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Организация", 			Объект.Организация);
	ПараметрыПодбора.Вставить("Контрагент", 			Объект.Контрагент);
	ПараметрыПодбора.Вставить("ДоговорКонтрагента", 	Объект.Договор);
	ПараметрыПодбора.Вставить("ВалютаДокумента",	 	Объект.Валюта);
	ПараметрыПодбора.Вставить("ЭтоДоход",	 			Ложь);
		
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаКлиенте
Процедура ПодобратьОбъектыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьПодборОбъектов(Результат.АдресОбъектовРасчетовВХранилище);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборОбъектов(АдресОбъектовРасчетовВХранилище)
	
	ТаблицаОбъектов 			= ПолучитьИзВременногоХранилища(АдресОбъектовРасчетовВХранилище);
	ИспользоватьСуммуСтавкуНДС 	= ВидыОперацийУХКлиентСерверПовтИсп.ИспользоватьСуммуСтавкуНДС(Объект.ВидОперацииУХ);
	
	Для каждого СтрокаЗаявки Из ТаблицаОбъектов Цикл
		СтрокиПозиции = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ОбъектРасчетов", СтрокаЗаявки.ОбъектРасчетов));
		Если СтрокиПозиции.Количество() > 0 Тогда
			СтрокаТЧ = СтрокиПозиции[0];
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаЗаявки);
		Иначе
			СтрокаТЧ = Объект.РасшифровкаПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаЗаявки);
			СтрокаТЧ.СтатьяДвиженияДенежныхСредств = ЗаявкиНаОперацииВызовСервера.СтатьяДДСПоЭлементуСтруктурыЗадолженности(Объект.Договор, 
			СтрокаТЧ.ЭлементСтруктурыЗадолженности, ПредопределенноеЗначение("Перечисление.ВидыДвиженийПриходРасход.Расход"));
			СтрокаТЧ.СтавкаНДС = СтавкаНДС;

		КонецЕсли; 
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаЗаявки);
		
		ПараметрыПересчетаНДС = Новый Структура("ЦенаВключаетНДС", Истина);
		СтруктураДействий = Новый Структура("ПересчитатьСуммуНДС", ПараметрыПересчетаНДС);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТЧ, СтруктураДействий, Неопределено);

	КонецЦикла;  

	ЗаявкиНаОперации.ПриИзмененииДоговора(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСписокДоговоровУХ()

	Если НЕ Объект.СписокДоговоровУХ Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.РасшифровкаПлатежа.Количество() = 1 Тогда
		ПереключательРасшифровки = 0;	
		Объект.СписокДоговоровУХ = Ложь;
	    СписокДоговоровУХ = 0;     
		УправлениеЭлементамиФормы();
	ИначеЕсли Объект.РасшифровкаПлатежа.Количество() > 1 Тогда	
		ДоговорКонтрагента = Неопределено;
		МножествоДоговоров = Ложь;
		Для каждого СтрокаРасшифровка Из Объект.РасшифровкаПлатежа Цикл
			
			Если Не ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
				ДоговорКонтрагента = СтрокаРасшифровка.ДоговорКонтрагента;
			ИначеЕсли ДоговорКонтрагента <> СтрокаРасшифровка.ДоговорКонтрагента Тогда	
			    МножествоДоговоров = Истина;
			КонецЕсли;	
		
		КонецЦикла;
		Если НЕ МножествоДоговоров Тогда
	   		Объект.СписокДоговоровУХ = Ложь;
		    СписокДоговоровУХ = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

#Область ПодтверждающиеДокументы_УХ

&НаКлиенте
Процедура Подключаемый_ПеренестиОбнаруженныеФайлы(Команда)

	ПеренестиОбнаруженныеФайлыНаСервере();  
	Модифицированность = Истина;
	ПодтверждающиеДокументыЕстьНеИспользуемыеФайлы(); 
	УправлениеФормой();

КонецПроцедуры

&НаСервере
Процедура ПеренестиОбнаруженныеФайлыНаСервере()

	ПодтверждающиеДокументыУХ.ПеренестиОбнаруженныеФайлы(Объект);
	
КонецПроцедуры   

&НаСервере
Процедура ПодтверждающиеДокументыЕстьНеИспользуемыеФайлы()
	
	 ЭтаФорма["ЕстьНеИспользуемыеФайлы"] = ПодтверждающиеДокументыУХ.ЕстьНеИспользуемыеФайлы(Объект);
	 
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбщаяКомандаПрисоединенныеФайлыУХ(Элемент)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВладелецФайла",  Объект.Ссылка);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
	
	ОткрытьФорму("Обработка.РаботаСФайлами.Форма.ПрисоединенныеФайлы",
	             ПараметрыФормы,
	             ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодтверждающиеДокументыНаСервереУХ()
	
	ПодтверждающиеДокументыУХ.ЗаполнитьВидыПодтверждающихДокументов(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НачалоВыбораФайлУХ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстВопроса = НСтр("ru = 'Данные еще не записаны.
				|Выбор файла документа возможен только после записи данных.
				|Данные будут записаны.'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьВыборПодтверждающегоДокументаПодтверждениеЗаписи",
			ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли; 
	ВыполнитьВыборПодтверждающегоДокументаПодтверждениеЗаписи(Неопределено, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыборПодтверждающегоДокументаПодтверждениеЗаписи(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		ЭтаФорма.Записать();
		Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
			Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
		КонецЕсли;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ПодтверждающиеДокументыФайлНачалоВыбораЗавершениеУХ", ЭтотОбъект);
	ПунктыМеню 			= Новый СписокЗначений;
	ПунктыМеню.Добавить("ВыборИзПрисоединенныхФайлов",
	НСтр("ru = 'Выбрать из присоединенных файлов ...';
	|en = 'Select from attached files ...'"),, БиблиотекаКартинок.ВыбратьЗначение);
	ПунктыМеню.Добавить("ДобавлениеФайлаСДиска",
	НСтр("ru = 'Добавить файл с диска ...';
	|en = 'Add file from disk ...'"),, БиблиотекаКартинок.ОткрытьФайл);
	
	ПоказатьВыборИзМеню(ОписаниеОповещения, ПунктыМеню, Элементы.ПодтверждающиеДокументыУХФайл);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждающиеДокументыФайлНачалоВыбораЗавершениеУХ(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ДополнительныеПараметрыВыбораВладельца = Новый Структура("Действие", Результат.Значение);
		ВыборВладельцаФайлаЗавершениеУХ(Новый Структура("Значение", Объект.Ссылка), ДополнительныеПараметрыВыбораВладельца);
			
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыборВладельцаФайлаЗавершениеУХ(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ВыбранныйВладелецФайлаУХ = Результат.Значение;
		
		Если ДополнительныеПараметры.Действие = "ДобавлениеФайлаСДиска" Тогда
			
			ИдентификаторФайла = Новый УникальныйИдентификатор;
			ДобавляетсяФайлПодтверждающегоДокумента = Истина;
			РаботаСФайламиКлиент.ДобавитьФайлы(ВыбранныйВладелецФайлаУХ, ИдентификаторФайла);
			
		ИначеЕсли ДополнительныеПараметры.Действие = "ВыборИзПрисоединенныхФайлов" Тогда
			
			Оповещение = Новый ОписаниеОповещения("ДобавитьИзПрисоединенныхФайловУХ", ЭтотОбъект);
			РаботаСФайламиКлиент.ОткрытьФормуВыбораФайлов(ВыбранныйВладелецФайлаУХ, Элементы.ПодтверждающиеДокументыФайл, , Оповещение);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзПрисоединенныхФайловУХ(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Если ТипЗнч(Результат) = Тип("Массив") Тогда
			Файл = Результат[0];
		Иначе
			Файл = Результат;
		КонецЕсли;
				
		Если Элементы.ПодтверждающиеДокументыУХ.ТекущиеДанные <> Неопределено Тогда
			Элементы.ПодтверждающиеДокументыУХ.ТекущиеДанные.Файл = Файл;
			ПодтверждающиеДокументыУХКлиент.ЗаполнитьОформлениеСтроки(Элементы.ПодтверждающиеДокументыУХ.ТекущиеДанные);		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура Подключаемый_ОбъектСистемыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтрокаТабличнойЧасти 	= Элементы.ПодтверждающиеДокументыУХ.ТекущиеДанные;
	ТипОграничения 			= ПодтверждающиеДокументыУХВызовСервера.ТипОграниченияДокументаБазы(СтрокаТабличнойЧасти.ВидДокумента);
	Элементы.ПодтверждающиеДокументыУХОбъектСистемы.ОграничениеТипа = Новый ОписаниеТипов(ТипОграничения);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РедактироватьУХ(Команда)
	
	ПодтверждающиеДокументыУХКлиент.РедактироватьФайл(Элементы.ПодтверждающиеДокументыУХ.ТекущиеДанные, УникальныйИдентификатор); 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПодтверждающиеДокументыПриОкончанииРедактированияУХ(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	 ПодтверждающиеДокументыУХКлиент.ЗаполнитьОформлениеСтроки(Элемент.ТекущиеДанные);
	 
	 ПодтверждающиеДокументыЕстьНеИспользуемыеФайлы(); 
	 
	 УправлениеФормой();
	 
 КонецПроцедуры  
 
