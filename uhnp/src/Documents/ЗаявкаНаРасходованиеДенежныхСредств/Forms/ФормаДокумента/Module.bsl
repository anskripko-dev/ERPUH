КонецПроцедуры

&НаСервере
Процедура ИнициализироватьДоговорКонтрагента()

	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаДенежныхСредствВДругуюОрганизацию
		Или Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствВДругуюОрганизацию Тогда
		Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
			Объект.Договор = Справочники.ДоговорыМеждуОрганизациями.ПустаяСсылка();    
		КонецЕсли;
		Элементы.Договор.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ДоговорыМеждуОрганизациями");  
	Иначе      
		Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
			Объект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		КонецЕсли;
		Элементы.Договор.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов");
	КонецЕсли;    

	Если НЕ (Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоКредитам И ЗначениеЗаполнено(Объект.ДоговорКредитаДепозита)) Тогда
		Объект.ДоговорКредитаДепозита = Справочники.ДоговорыКредитовИДепозитов.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииЭлементаУХ(Элемент)
	
	Если Элемент.Имя = "ЖелательнаяДатаПлатежа" Тогда
		Объект.ДатаАвансовогоОтчета =
		ДенежныеСредстваКлиент.ПересчитатьДатуАвансовогоОтчета(ПериодАвансовогоОтчета, Объект.ЖелательнаяДатаПлатежа);
		Объект.ДатаЗачисления = Объект.ЖелательнаяДатаПлатежа;
	КонецЕсли;
	
	ПриИзмененииЭлементаУХНаСервере(Элемент.Имя);
	
	Переконтролировать = Новый Массив;
	Переконтролировать.Добавить("ЦФОБезРазбиения");
	Переконтролировать.Добавить("ПроектБезРазбиения");
	Переконтролировать.Добавить("ЦФО");
	Переконтролировать.Добавить("Проект");
	
	Если Переконтролировать.Найти(Элемент.Имя) <> Неопределено Тогда
		// проверяем лимиты
		ВыполнитьКонтрольДокументаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Элемент = Элементы.РасшифровкаПлатежа Тогда
		Если ОтменаРедактирования Тогда
			ПриИзмененииЭлементаУХНаСервере(Элемент.Имя);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолеФормы_ПриИзменении(Элемент)
	
	ПредыдущиеОбработчики = ПереопределениеСобытийФормыКлиент.ПолучитьПредыдущиеОбработчики(
	ЭтаФорма, Элемент.Имя, "ПриИзменении");
	
	Для каждого Событие Из ПредыдущиеОбработчики Цикл
		Если Событие.ПредыдущийУстановлен Тогда
			#Если ВебКлиент Тогда
				ВызватьОбработчикДиспетчер(
				Событие.ОбработчикСобытияПредыдущий,
				Элемент);
			#Иначе
				Выполнить(Событие.ОбработчикСобытияПредыдущий + Событие.Параметры);
			#КонецЕсли
		КонецЕсли;
	КонецЦикла;
	
	Если Элемент.Имя = "Договор" Тогда
		ПриИзмененииДоговораВШапкеНаСервере();
	ИначеЕсли Элемент.Имя = "ДоговорВозврата" Тогда
		ПриИзмененииДоговораВШапкеНаСервере();
	ИначеЕсли Элемент.Имя = "ДоговорКредитаДепозита" Тогда
		ПриИзмененииДоговораКредитаДепозитаВШапкеНаСервере();
	ИначеЕсли Элемент.Имя = "ДоговорАренды" Тогда
		ПриИзмененииДоговораЛизингаВШапкеНаСервере();
	ИначеЕсли Элемент.Имя = "ДоговорЗаймаСотруднику" Тогда
		ПриИзмененииДоговораЗаймаСотрудникуВШапкеНаСервере();
	ИначеЕсли Элемент.Имя = "РасшифровкаБезРазбиенияСуммаВзаиморасчетов" Тогда
		ПересчитатьСуммуПриИзмененииСуммыВзаиморасчетовВСтроке();
		ОбновитьСуммуДокументаПоДаннымРасшифровки();
		ПриИзмененииЭлементаУХНаСервере(Элементы.СуммаДокумента.Имя);
	ИначеЕсли Элемент.Имя = "РасшифровкаПлатежаСумма" Тогда
		ПересчитатьСуммуВзаиморасчетовПриИзмененииСуммыВСтроке();
		ОбновитьСуммуДокументаПоДаннымРасшифровки();
	ИначеЕсли Элемент.Имя = "СуммаДокумента" Тогда
		ПересчитатьСуммуВзаиморасчетовПриИзмененииСуммыДокумента();
		Подключаемый_ПриИзмененииЭлементаУХ(Элемент);
	КонецЕсли;
	
	// Контроль документа
	ВыполнитьКонтрольДокументаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьОбработчикДиспетчер(ИмяОбработчика, Элемент)
	
	Если ИмяОбработчика = "Подключаемый_ХозяйственнаяОперацияПриИзмененииЛокализация" Тогда
		Подключаемый_ХозяйственнаяОперацияПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_СуммаДокументаПриИзмененииЛокализация" Тогда
		Подключаемый_СуммаДокументаПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_ВалютаПриИзмененииЛокализация" Тогда
		Подключаемый_ВалютаПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_ОрганизацияПриИзмененииЛокализация" Тогда
		Подключаемый_ОрганизацияПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_ХозяйственнаяОперацияПоЗарплатеПриИзмененииЛокализация" Тогда
		Подключаемый_ХозяйственнаяОперацияПоЗарплатеПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_БанковскийСчетПриИзмененииЛокализация" Тогда
		Подключаемый_БанковскийСчетПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_КонтрагентПриИзмененииЛокализация" Тогда
		Подключаемый_КонтрагентПриИзмененииЛокализация();
	ИначеЕсли ИмяОбработчика = "Подключаемый_ПолучательПриИзмененииЛокализация" Тогда
		Подключаемый_ПолучательПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_БанковскийСчетКонтрагентаПриИзмененииЛокализация" Тогда
		Подключаемый_БанковскийСчетКонтрагентаПриИзмененииЛокализация();
	ИначеЕсли ИмяОбработчика = "Подключаемый_ПланированиеСуммыПриИзмененииЛокализация" Тогда
		Подключаемый_ПланированиеСуммыПриИзмененииЛокализация();
	ИначеЕсли ИмяОбработчика = "Подключаемый_ОперацияССамозанятымПриИзмененииЛокализация" Тогда
		Подключаемый_ОперацияССамозанятымПриИзмененииЛокализация();
	ИначеЕсли ИмяОбработчика = "Подключаемый_ДоговорПриИзмененииЛокализация" Тогда
		Подключаемый_ДоговорПриИзмененииЛокализация();
	ИначеЕсли ИмяОбработчика = "Подключаемый_РасшифровкаБезРазбиенияОбъектРасчетовПриИзмененииЛокализация" Тогда
		Подключаемый_РасшифровкаБезРазбиенияОбъектРасчетовПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_СписокФизЛицВключеноПриИзмененииЛокализация" Тогда
		Подключаемый_СписокФизЛицВключеноПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_РасшифровкаПлатежаПриИзмененииЛокализация" Тогда
		Подключаемый_РасшифровкаПлатежаПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_РасшифровкаПлатежаКонтрагентПриИзмененииЛокализация" Тогда
		Подключаемый_РасшифровкаПлатежаКонтрагентПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_РасшифровкаПлатежаПартнерПриИзмененииЛокализация" Тогда
		Подключаемый_РасшифровкаПлатежаПартнерПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_РасшифровкаПлатежаДоговорКредитаДепозитаПриИзмененииЛокализация" Тогда
		Подключаемый_РасшифровкаПлатежаДоговорКредитаДепозитаПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_РасшифровкаБезРазбиенияДоговорКредитаДепозитаПриИзмененииЛокализация" Тогда
		Подключаемый_РасшифровкаБезРазбиенияДоговорКредитаДепозитаПриИзмененииЛокализация(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_ПриИзмененииЭлементаУХ" Тогда
		Подключаемый_ПриИзмененииЭлементаУХ(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_СтатьяБюджета_ПриИзменении" Тогда
		Подключаемый_СтатьяБюджета_ПриИзменении(Элемент);
	ИначеЕсли ИмяОбработчика = "Подключаемый_АналитикаСтатьиБюджета_ПриИзменении" Тогда
		Подключаемый_АналитикаСтатьиБюджета_ПриИзменении(Элемент);
	ИначеЕсли ИмяОбработчика = "РасшифровкаПлатежаСуммаВзаиморасчетовПриИзменении" Тогда
		РасшифровкаПлатежаСуммаВзаиморасчетовПриИзменении(Элемент);
	ИначеЕсли ИмяОбработчика = "РасшифровкаПлатежаСуммаПриИзменении" Тогда
		РасшифровкаПлатежаСуммаПриИзменении(Элемент);
	КонецЕсли;
	
КонецПроцедуры

