&НаСервере
Процедура ЗаполнитьПоРанееСовершенномуПлатежу(РезультатВыбора)
	
	Объект.ПеречислениеВБюджет = Истина;
	
	Если Не ЗначениеЗаполнено(Объект.ТипНалога) Тогда
		Объект.ТипНалога = РезультатВыбора.АналитикаАктивовПассивов;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора,,);
	
	ПараметрыПлатежа = ПлатежиВБюджет.ПараметрыПлатежаДляЗаполнения();
	ПараметрыПлатежа.Дата = Объект.Дата;
	ПараметрыПлатежа.ВидПлатежа = Объект.ВидПеречисленияВБюджет;
	ПараметрыПлатежа.ТипНалога = Объект.ТипНалога;
	ПараметрыПлатежа.КодБК = РезультатВыбора.КодБК;
	
	ЗначенияПоУмолчанию = ПлатежиВБюджет.ЗначенияРеквизитовПлатежаВБюджетПоУмолчанию(
		ПараметрыПлатежа.Дата, ПараметрыПлатежа.ВидПлатежа, ПараметрыПлатежа.КодБК, ПараметрыПлатежа.ТипНалога);
	ДанныеЗаполнения = ЗначенияПоУмолчанию.ДанныеЗаполнения;
	НеизменныеРеквизиты = ЗначенияПоУмолчанию.НеизменныеРеквизиты;
	
	Если СтрДлина(Объект.ИННПлательщика) = 5
		И НеизменныеРеквизиты.Найти("КПППлательщика") <> Неопределено Тогда
		НеизменныеРеквизиты.Удалить(НеизменныеРеквизиты.Найти("КПППлательщика"));
	КонецЕсли;
	
	Для Каждого ТекущийРеквизит Из НеизменныеРеквизиты Цикл
		Объект[ТекущийРеквизит] = ДанныеЗаполнения[ТекущийРеквизит];
	КонецЦикла;
	
	СписокСтатусов = ПлатежиВБюджетКлиентСервер.ДоступныеСтатусыПлательщикаПоВидуПлатежа(
		Объект.ВидПеречисленияВБюджет, Объект.Дата);
	
	Если ЗначениеЗаполнено(РезультатВыбора.СтатусСоставителя)
		И СписокСтатусов.НайтиПоЗначению(РезультатВыбора.СтатусСоставителя) = Неопределено Тогда
		Объект.СтатусСоставителя = ДанныеЗаполнения.СтатусСоставителя;
	КонецЕсли;
	
	Если Не Объект.РасшифровкаПлатежа.Количество() Тогда
		НоваяСтрока = Объект.РасшифровкаПлатежа.Добавить();
		ДоходыИРасходыКлиентСервер.ПриДобавленииСтрокиВТаблицу(ЭтотОбъект, НоваяСтрока, "Объект.РасшифровкаПлатежа");
	КонецЕсли;
	
	Для Каждого СтрокаПлатежа Из Объект.РасшифровкаПлатежа Цикл
		СтрокаПлатежа.СтатьяДвиженияДенежныхСредств = РезультатВыбора.СтатьяДвиженияДенежныхСредств;
	КонецЦикла;
	//++ НЕ УТ
	Если Не ОплатаНДСВБюджетПоОтдельнымОперациям Тогда
		НоваяНастройка = НастройкаСчетовУчетаКлиентСервер.СоставНастройкиСчетовУчета();
		ЗаполнитьЗначенияСвойств(НоваяНастройка, РезультатВыбора, "СчетУчета, Субконто1, Субконто2, Субконто3");
		Объект.НастройкаСчетовУчета = НастройкаСчетовУчетаСервер.НоваяНастройкаСчетовУчета(НоваяНастройка, ЭтотОбъект);
		ПараметрыНастройки = Документы.ЗаявкаНаРасходованиеДенежныхСредств.ПараметрыНастройкиСчетовУчета(
			Объект.ХозяйственнаяОперация, Объект.ТипНалога);
		НастройкаСчетовУчетаСервер.ПриИзмененииПараметровНастройки(ЭтотОбъект, ПараметрыНастройки);
	КонецЕсли;
	//-- НЕ УТ                                    
	
	// УХ_Казначейство ++
	ПлатежныеПозиции.УстановитьКонтрагента(ЭтотОбъект);
	ПлатежныеПозиции.УстановитьБанковскийСчетКонтрагента(ЭтотОбъект);
	// УХ_Казначейство --
	
	УправлениеПоказателямиПлатежаВБюджет();
	УстановитьНадписьРеквизитыПлательщика();
	НастроитьЗависимыеЭлементыФормыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьВалютныйПлатежЛокализация()
	
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.КонвертацияВалюты Тогда
		ВалютныйПлатеж = Ложь;
	Иначе
		Если ЗначениеЗаполнено(ВалютаСчетаПлательщика) Тогда
			ВалютныйПлатеж = (ВалютаСчетаПлательщика <> ВалютаРеглУчета);
		ИначеЕсли ЗначениеЗаполнено(Объект.Валюта) Тогда
			ВалютныйПлатеж = (Объект.Валюта <> ВалютаРеглУчета);
		Иначе
			ВалютныйПлатеж = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

