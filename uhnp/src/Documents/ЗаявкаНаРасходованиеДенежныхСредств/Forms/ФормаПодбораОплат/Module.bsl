
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьРеквизитыФормы(Отказ); 
	
	УправлениеФормой(ЭтотОбъект);
	
	ЗаполнитьДеревоОплат();
	                                 
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗаказОтборПриИзменении(Элемент)  
	
	ЗаполнитьДеревоОплат();	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОплат

&НаКлиенте
Процедура ДеревоОплатВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоОплат.ТекущиеДанные;
	
	Если ЭтоУровеньДанных(ТекущиеДанные) Тогда 
		ТекущиеДанные.Выбран = Не ТекущиеДанные.Выбран;	
	КонецЕсли;  
	
	ОтметитьВыбранныеСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоОплатВыбранПриИзменении(Элемент)
	
	ОтметитьВыбранныеСтроки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	ВыбратьСнятьВсе(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	ВыбратьСнятьВсе(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Закрыть(ПоместитьПодобранныеОплатыВоВременноеХранилище());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ТаблицаОплатОбъектРасчетов.Видимость = Форма.Параметры.ВидимостьОбъектРасчетов;
	Элементы.ТаблицаОплатВедомость.Видимость = Форма.ПеречислениеЗарплаты;											
	Элементы.ПеренестиВДокумент.Доступность = Не Форма.ЗаблокироватьФорму;
	Элементы.ГруппаОтборы.Видимость = Форма.ПорядокРасчетовПоЗаказам;	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормы(Отказ)

	ДоговорКонтрагента = Параметры.ДоговорКонтрагента;
	
	Если Не ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Значение реквизита ""%1"" не заполнено'"), "Договор контрагента"); 
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		Возврат;	
	КонецЕсли;
	
	АдресВыбранныхОплат = Параметры.АдресВыбранныхОплат;
	ВидОперацииУХ = Параметры.ВидОперацииУХ;
	ЖелательнаяДатаПлатежа = Параметры.ЖелательнаяДатаПлатежа;
	ЗаблокироватьФорму = Параметры.ЗаблокироватьФорму;

	Если  ТипЗнч(ДоговорКонтрагента) = Тип("СправочникСсылка.ДоговорыАренды") Тогда
		Возврат;	
	КонецЕсли;
	
	ВерсияСоглашения = РегистрыСведений.ВерсииГрафиковРасчетов.ПолучитьАктуальнуюВерсиюФинансовогоИнструмента(ДоговорКонтрагента);
	
	Если Не ЗначениеЗаполнено(ВерсияСоглашения) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не найдена актуальная версия соглашения по договору %1'"), ДоговорКонтрагента); 
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		Возврат;
	КонецЕсли;
	
	
	ПеречислениеЗарплаты = ЗаявкиНаОперацииКлиентСервер.ВозможноПеречислениеЗаплаты(ВидОперацииУХ, Ложь, Ложь);
												
	ЗаполнитьКлючевыеКолонкиДереваОплат();  	
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВерсияСоглашения, "ВидДоговораУХ,ПорядокРасчетов");
	
	ЭтоДоговорСПоставщиком = УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоговорСПоставщиком(РеквизитыДоговора.ВидДоговораУХ);
	
	ПорядокРасчетов = РеквизитыДоговора.ПорядокРасчетов;
	
	ПорядокРасчетовПоЗаказам = Ложь;
	
	Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным
			ИЛИ  ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам Тогда
		ПорядокРасчетовПоЗаказам = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСнятьВсе(ЗначениеФлага)
	
	СтрокиДерева = ДеревоОплат.ПолучитьЭлементы();
	ВыбратьСнятьВсеРекурсивно(СтрокиДерева, ЗначениеФлага);

КонецПроцедуры 

&НаКлиенте
Процедура ВыбратьСнятьВсеРекурсивно(СтрокиДерева, ЗначениеФлага)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл  		
		СтрокаДерева.Выбран = ЗначениеФлага;		
		ВыбратьСнятьВсеРекурсивно(СтрокаДерева.ПолучитьЭлементы(), ЗначениеФлага);		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыбранныеСтроки()
	
	ТекущиеДанные = Элементы.ДеревоОплат.ТекущиеДанные;
	
	Если Не ТекущиеДанные.ЭтоУровеньДанных Тогда  
		
		ПодчиненныеЭлементыДерева = ТекущиеДанные.ПолучитьЭлементы();
		Для Каждого СтрокаДерева Из ПодчиненныеЭлементыДерева Цикл 
			СтрокаДерева.Выбран = ТекущиеДанные.Выбран;
		КонецЦикла;   
		
	ИначеЕсли ПорядокРасчетовПоЗаказам Тогда  
		
		РодительСтроки = ТекущиеДанные.ПолучитьРодителя(); 
		ПодчиненныеЭлементыДерева = РодительСтроки.ПолучитьЭлементы(); 
		ЕстьВыбраннаяСтрока = Ложь;
		Для Каждого СтрокаДерева Из ПодчиненныеЭлементыДерева Цикл 
			Если СтрокаДерева.Выбран Тогда 
				ЕстьВыбраннаяСтрока = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;   
		РодительСтроки.Выбран = ЕстьВыбраннаяСтрока;  
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоОплат()
	
	Если Не ЗначениеЗаполнено(ВерсияСоглашения) И НЕ ТипЗнч(ДоговорКонтрагента) = Тип("СправочникСсылка.ДоговорыАренды")  Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеОплаты = ПолучитьИзВременногоХранилища(АдресВыбранныхОплат);

	ТекстЗапроса = ПолучитьТекстЗапросаВыбранныеОплаты();
	
	Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	Запрос.УстановитьПараметр("ЗаказПоставщику", 	ЗаказОтбор);
	Запрос.УстановитьПараметр("Период", 			ЖелательнаяДатаПлатежа);
	             
	РезультатЗапроса = Запрос.Выполнить();

	ИспользоватьСуммуСтавкуНДС = ВидыОперацийУХКлиентСерверПовтИсп.ИспользоватьСуммуСтавкуНДС(ВидОперацииУХ);
	СтавкаНДСПоДоговору = ДоговорыКонтрагентовВстраиваниеУХ.ПолучитьСтавкуНДСПоДоговору(ДоговорКонтрагента, ЖелательнаяДатаПлатежа);
	
	Дерево = РеквизитФормыВЗначение("ДеревоОплат");  
	Дерево.Строки.Очистить();
	
	Если ПорядокРасчетовПоЗаказам Тогда
		
		ВыборкаОбъектРасчетов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаОбъектРасчетов.Следующий() Цикл 
			СтрокаУровень1 = Дерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаУровень1, ВыборкаОбъектРасчетов); 
			СтрокаУровень1.Уровень = 1;
			
			ВыборкаДанные = ВыборкаОбъектРасчетов.Выбрать();
			
			Пока ВыборкаДанные.Следующий() Цикл 
				
				СтрокаУровень2 = СтрокаУровень1.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаУровень2, ВыборкаДанные); 
				СтрокаУровень2.Уровень = 2;  
				СтрокаУровень2.ЭтоУровеньДанных = Истина;
				ЗаполнитьДанныеНДСВСтроке(СтрокаУровень2, ИспользоватьСуммуСтавкуНДС, СтавкаНДСПоДоговору); 
				УстановитьПризнакВыбранВСтрокеДерева(СтрокаУровень2, ВыбранныеОплаты);
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе     
		
		ВыборкаДанные = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДанные.Следующий() Цикл 
			
			СтрокаУровень1 = Дерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаУровень1, ВыборкаДанные); 
			СтрокаУровень1.Уровень = 1; 
			СтрокаУровень1.ЭтоУровеньДанных = Истина; 
			ЗаполнитьДанныеНДСВСтроке(СтрокаУровень1, ИспользоватьСуммуСтавкуНДС, СтавкаНДСПоДоговору);
			УстановитьПризнакВыбранВСтрокеДерева(СтрокаУровень1, ВыбранныеОплаты); 
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Дерево,"ДеревоОплат");

КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапросаВыбранныеОплаты()

	Если ПорядокРасчетовПоЗаказам Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗаказПоставщику.Ссылка КАК ЗаказПоставщику
		|ПОМЕСТИТЬ ВТ_ЗаказыПоставщику
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.Проведен
		|	И ЗаказПоставщику.Договор = &ДоговорКонтрагента
		|	И &УсловиеПоЗаказу
		|;
		|
