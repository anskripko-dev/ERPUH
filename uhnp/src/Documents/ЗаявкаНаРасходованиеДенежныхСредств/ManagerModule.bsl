	|	ЗаявкаНаОплату.Аналитика1 КАК Аналитика1,
	|	ЗаявкаНаОплату.Аналитика2 КАК Аналитика2,
	|	ЗаявкаНаОплату.Аналитика3 КАК Аналитика3,
	|	ЗаявкаНаОплату.Аналитика4 КАК Аналитика4,
	|	ЗаявкаНаОплату.Аналитика5 КАК Аналитика5,
	|	ЗаявкаНаОплату.Аналитика6 КАК Аналитика6,
	|	ЗаявкаНаОплату.СтатьяДвиженияДенежныхСредствЗачисление КАК СтатьяДвиженияДенежныхСредствЗачисление,
	|	ЗаявкаНаОплату.АналитикаЗачисления1 КАК АналитикаЗачисления1,
	|	ЗаявкаНаОплату.АналитикаЗачисления2 КАК АналитикаЗачисления2,
	|	ЗаявкаНаОплату.АналитикаЗачисления3 КАК АналитикаЗачисления3,
	|	ЗаявкаНаОплату.АналитикаЗачисления4 КАК АналитикаЗачисления4,
	|	ЗаявкаНаОплату.АналитикаЗачисления5 КАК АналитикаЗачисления5,
	|	ЗаявкаНаОплату.АналитикаЗачисления6 КАК АналитикаЗачисления6,
	|	ЗаявкаНаОплату.РасшифровкаПлатежа.(
	|		СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|		Аналитика1 КАК Аналитика1,
	|		Аналитика2 КАК Аналитика2,
	|		Аналитика3 КАК Аналитика3,
	|		Аналитика4 КАК Аналитика4,
	|		Аналитика5 КАК Аналитика5,
	|		Аналитика6 КАК Аналитика6,
	|		Сумма КАК Сумма
	|	) КАК РасшифровкаПлатежа
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаОплату
	|ГДЕ
	|	ЗаявкаНаОплату.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка,, "РасшифровкаПлатежа");
		Результат.РасшифровкаПлатежа = Выборка.РасшифровкаПлатежа.Выгрузить();
	КонецЕсли;
	
	Возврат Результат;  
	
