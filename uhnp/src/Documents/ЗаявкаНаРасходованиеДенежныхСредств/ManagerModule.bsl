	КонецЕсли;
	
	// Параметры заявки
	Если ЭтоКонвертацияВалюты Тогда
		Запрос.УстановитьПараметр("Сумма",	РеквизитыДокумента.СуммаКонвертации);
		Запрос.УстановитьПараметр("ВалютаКонвертации",	РеквизитыДокумента.ВалютаКонвертации);
	Иначе
		Запрос.УстановитьПараметр("Сумма",	РеквизитыДокумента.СуммаДокумента);
		Запрос.УстановитьПараметр("ВалютаКонвертации", РеквизитыДокумента.Валюта);
	КонецЕсли;
	
	// Реквизиты договора
	ИменаРеквизитовДоговора = "ГрафикДоговора, ПорядокРасчетов";
	РеквизитыДоговора 					= Новый Структура(ИменаРеквизитовДоговора);
	РеквизитыДоговора.ПорядокРасчетов 	= Перечисления.ПорядокРасчетов.ПустаяСсылка();
	РеквизитыДоговора.ГрафикДоговора 	= Перечисления.ГрафикиДоговора.ПустаяСсылка();
	
	Если ЭтоРасчетыПоДоговору И РеквизитыДокумента.ДоговорКонтрагента <> Неопределено 
		И ТипЗнч(РеквизитыДокумента.ДоговорКонтрагента ) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ДоговорКонтрагента, ИменаРеквизитовДоговора);
	КонецЕсли;

	Если ТипЗнч(РеквизитыДокумента.ДоговорКонтрагента ) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
		РеквизитыДоговора.ПорядокРасчетов 	= Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		РеквизитыДоговора.ГрафикДоговора 	= Перечисления.ГрафикиДоговора.ГрафикРасчетов;
	КонецЕсли;
	
	Если РеквизитыДоговора.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам ИЛИ РеквизитыДоговора.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным Тогда	
		ЭтоРасчетыПоЗаказам = Истина;
	Иначе
		ЭтоРасчетыПоЗаказам = Ложь;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЭтоРасчетыПоЗаказам", ЭтоРасчетыПоЗаказам);
	
	Для Каждого КлючЗначение Из РеквизитыДоговора Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();

	ОбщегоНазначенияОПК.ОчиститьВременныеТаблицы(Запрос, "ВТ_ПланыДокумента");
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции 

Процедура ПереопределитьКурсКратностьПлатежа(ЗапросИсточник, РеквизитыДокумента) 
	
	// Обработка ситуации при которой валюты взаиморасчетов, оплаты и лимитирования отличаются
	Если Не ЗапросИсточник.Параметры.КурсЗаданВОперации Тогда
		Возврат;
	КонецЕсли;       
	
	ВалютыДокумента = Новый Массив;
	ВалютыДокумента.Добавить(РеквизитыДокумента.Валюта);
	ВалютыДокумента.Добавить(РеквизитыДокумента.ВалютаОплаты);
	
	ТаблицаВалютЛимитирования = Новый ТаблицаЗначений;
	ТаблицаВалютЛимитирования.Колонки.Добавить("ДатаОперации", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	ТаблицаВалютЛимитирования.Колонки.Добавить("ВидБюджета", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("ПланВидовХарактеристикСсылка.ВидыБюджетов"));
	ТаблицаВалютЛимитирования.Колонки.Добавить("ЦФО", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Организации"));
	ТаблицаВалютЛимитирования.Колонки.Добавить("Валюта", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Валюты"));
	
	ДатаОперации = ?(ЗначениеЗаполнено(РеквизитыДокумента.ЖелательнаяДатаПлатежа), РеквизитыДокумента.ЖелательнаяДатаПлатежа, РеквизитыДокумента.Дата);
	
	НоваяТаблица = ТаблицаВалютЛимитирования.Добавить(); 
	НоваяТаблица.ДатаОперации = ДатаОперации; 
	НоваяТаблица.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств; 
	НоваяТаблица.ЦФО = РеквизитыДокумента.ЦФО;
	НоваяТаблица.Валюта = РеквизитыДокумента.Валюта;   
	
	Запрос = Новый Запрос;    
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;  	
	
	Запрос.Текст =
	"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Данные ИЗ &ТаблицаВалютЛимитирования КАК Коллекция";
	
	Запрос.УстановитьПараметр("ТаблицаВалютЛимитирования", ТаблицаВалютЛимитирования);
	Запрос.Выполнить();
	
	РезультатЗапроса = КонтрольЛимитовУХ.ОпределитьВалютуЛимитированияПоДокументу(Запрос);	
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
	ВыборкаДетальныеЗаписи.Следующий(); 
	
	Если Не ВалютыДокумента.Найти(ВыборкаДетальныеЗаписи.ВалютаЛимитирования) = Неопределено
		И Не РеквизитыДокумента.Валюта = ВыборкаДетальныеЗаписи.ВалютаЛимитирования Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыТекущегоКурса = КонтрольЛимитовУХ.ПолучитьКурсВалютыЛимитирования(РеквизитыДокумента.Валюта, ДатаОперации);
	ПараметрыНовогоКурса = КонтрольЛимитовУХ.ПолучитьКурсВалютыЛимитирования(ВыборкаДетальныеЗаписи.ВалютаЛимитирования, ДатаОперации);
	КроссКурс = РаботаСКурсамиВалютУХ.ПолучитьКроссКурсВалют(ПараметрыТекущегоКурса, ПараметрыНовогоКурса);
	
	ЗапросИсточник.УстановитьПараметр("КурсПлатежа", КроссКурс.Курс);
    ЗапросИсточник.УстановитьПараметр("КратностьПлатежа", КроссКурс.Кратность);
	
КонецПроцедуры

