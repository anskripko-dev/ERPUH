#Область Прочее

Функция СформироватьЗапросПроверкиПриСменеСтатуса(МассивДокументов, НовыйСтатус, ДополнительныеПараметры) Экспорт
	
	ЗначениеНовогоСтатуса = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств[НовыйСтатус];
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаДокументов.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ТаблицаДокументов.Ссылка) КАК Представление,
	|	ПРЕДСТАВЛЕНИЕ(ТаблицаДокументов.Статус) КАК ПредставлениеТекущегоСтатуса,
	|	ПРЕДСТАВЛЕНИЕ(&Статус) КАК ПредставлениеНовогоСтатуса,
	|	ВЫБОР
	|		КОГДА ТаблицаДокументов.Статус = &Статус
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СтатусСовпадает,
	|	ТаблицаДокументов.Проведен КАК Проведен,
	|	ТаблицаДокументов.ПометкаУдаления КАК ПометкаУдаления,
	|	ИСТИНА КАК ЗаписьПроведением
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ТаблицаДокументов
	|ГДЕ
	|	ТаблицаДокументов.Ссылка В(&МассивДокументов)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Статус", ЗначениеНовогоСтатуса);
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	Возврат Запрос;
	
КонецФункции

Функция ПроверкаПередСменойСтатуса(ВыборкаПроверки, НовыйСтатус, ДополнительныеПараметры) Экспорт
	
	Возврат Истина; // Для документа "ЗаявкаНаРасходованиеДенежныхСредств" дополнительные проверки отсутствуют
	
КонецФункции

Функция СтатьяДвиженияДенежныхСредствДокумента(ДанныеДокумента)
	
	Если ЗначениеЗаполнено(ДанныеДокумента.СтатьяДвиженияДенежныхСредств) Тогда
		СтатьяДвиженияДенежныхСредств = ДанныеДокумента.СтатьяДвиженияДенежныхСредств;
	Иначе
		СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ПредопределеннаяСтатьяДДС(
			ДанныеДокумента.ХозяйственнаяОперация, ДанныеДокумента.Валюта);
	КонецЕсли;
	
	Возврат СтатьяДвиженияДенежныхСредств;
	
КонецФункции

// Операции взаиморасчетов.
// 
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ХозяйственныеОперации - Операции взаиморасчетов
Функция ОперацииВзаиморасчетов() Экспорт
	ОперацииВзаиморасчетов = Новый Массив;
	ОперацииВзаиморасчетов.Добавить(Перечисления.ХозяйственныеОперации.ОплатаПоставщику);
	ОперацииВзаиморасчетов.Добавить(Перечисления.ХозяйственныеОперации.ОплатаДенежныхСредствВДругуюОрганизацию);
	ОперацииВзаиморасчетов.Добавить(Перечисления.ХозяйственныеОперации.ПеречислениеТаможне);
	ОперацииВзаиморасчетов.Добавить(Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту);
	ОперацииВзаиморасчетов.Добавить(Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствВДругуюОрганизацию);
	
	Возврат ОперацииВзаиморасчетов;
КонецФункции

// Рассчитывает значение для заполнения реквизита "КонтролироватьОплатуПоОбъектамРасчетов". Значение зависит от значения 
// реквизита "ХозяйственнаяОперация" и заполнения реквизита "ОбъектРасчетов" в строках табличной части "РасшифровкаПлатежа". 
// 
// Параметры:
//  ХозяйственнаяОперация - ПеречислениеСсылка.ХозяйственныеОперации - Хозяйственная операция документа.
//  ОбъектыРасчетов - Массив из СправочникСсылка.ОбъектыРасчетов - Массив объектов расчетов из табличной части "Расшифровка платежа". 
// 
// Возвращаемое значение:
//  Булево - Значение для заполнения реквизита "КонтролироватьОплатуПоОбъектамРасчетов".
//
Функция КонтролироватьОплатуПоОбъектамРасчетов(ХозяйственнаяОперация, ОбъектыРасчетов) Экспорт

	КонтролироватьОплатуПоОбъектамРасчетов = Ложь;
	ОперацииВзаиморасчетов = ОперацииВзаиморасчетов();

	Если ОперацииВзаиморасчетов.Найти(ХозяйственнаяОперация) = Неопределено Тогда
		Возврат КонтролироватьОплатуПоОбъектамРасчетов;
	КонецЕсли;

	КонтролироватьОплатуПоОбъектамРасчетов = Истина;

	Для Каждого ОбъектРасчетов Из ОбъектыРасчетов Цикл
		Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
			КонтролироватьОплатуПоОбъектамРасчетов = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат КонтролироватьОплатуПоОбъектамРасчетов;

КонецФункции

#КонецОбласти

//++ НЕ УТ
#Область КонтрольЛимитовПоДаннымБюджетирования

// Возвращает текст запроса для формирования временной таблицы с источниками данных правил получения фактических данных по статьям бюджетов.
// Источники данных зависят от хозяйственной операции документа.
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаИсточникиДанныхПравилПолученияФакта() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НастройкиХозяйственныхОпераций.Ссылка КАК ИсточникДанных,
	|	НастройкиХозяйственныхОпераций.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	НастройкиХозяйственныхОпераций.Приход КАК Приход,
	|	НастройкиХозяйственныхОпераций.Расход КАК Расход
	|ПОМЕСТИТЬ ИсточникиДанныхПравилПолученияФакта
	|ИЗ
	|	Справочник.НастройкиХозяйственныхОпераций КАК НастройкиХозяйственныхОпераций
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка)
	|				ТОГДА НастройкиХозяйственныхОпераций.Расход = ЗНАЧЕНИЕ(Перечисление.ТипыДанныхУчета.ДенежныеСредства)
	|			ИНАЧЕ НастройкиХозяйственныхОпераций.ХозяйственнаяОперация В (ВЫБОР
	|						КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратОплатыКлиентуНаПлатежнуюКарту)
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.КомиссияПоЭквайрингу)
	|					КОНЕЦ, ВЫБОР
	|						КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаПоКредитам)
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаПроцентовПоКредитам)
	|					КОНЕЦ, ВЫБОР
	|						КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств)
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочиеРасходы)
	|					КОНЕЦ, ВЫБОР
	|						КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаАрендодателю)
	|								И &ПоТаблицеКорреспонденций
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаУслугПоАренде)
	|						ИНАЧЕ &ХозяйственнаяОперация
	|					КОНЕЦ, ВЫБОР
	|						КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаАрендодателю)
	|								И &ПоТаблицеКорреспонденций
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаОбеспечительногоПлатежа)
	|						ИНАЧЕ &ХозяйственнаяОперация
	|					КОНЕЦ, ВЫБОР
	|						КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаАрендодателю)
	|								И &ПоТаблицеКорреспонденций
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаВыкупнойСтоимостиПредметовАренды)
	|						ИНАЧЕ &ХозяйственнаяОперация
	|					КОНЕЦ, ВЫБОР
	|						КОГДА &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаАрендодателю)
	|								И &ПоТаблицеКорреспонденций
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаВыкупнойСтоимостиПредметовАрендыАванс)
	|						ИНАЧЕ &ХозяйственнаяОперация
	|					КОНЕЦ)
	|		КОНЕЦ
	|	И НастройкиХозяйственныхОпераций.ИспользоватьВБюджетировании";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает текст запроса в качестве источника фактических данных по документу.
// Источник фактических данных зависит от типов данных учета хозяйственной операции правила получения фактических данных по статьям бюджетов.
//
// Параметры:
//  Расход - ПеречислениеСсылка.ТипыДанныхУчета - расход по хозяйственной операции
//  Приход - ПеречислениеСсылка.ТипыДанныхУчета - приход по хозяйственной операции
//  ИмяВременнойТаблицы - Строка - имя временной таблицы (если не задано, то временная таблица не формируется)
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаИсточникФактаПоТипамДанныхУчета(Расход, Приход, ИмяВременнойТаблицы = "") Экспорт
	
	ТекстЗапроса = "";
	
	Если Расход <> Перечисления.ТипыДанныхУчета.ДенежныеСредства Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	Если Приход = Перечисления.ТипыДанныхУчета.ДенежныеСредства Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ДатаПлатежа <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ТаблицаДанных.ДатаПлатежа
		|		КОГДА ТаблицаДанных.ЖелательнаяДатаПлатежа <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ТаблицаДанных.ЖелательнаяДатаПлатежа
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(ТаблицаДанных.Дата, ДЕНЬ)
		|	КОНЕЦ КАК Период,
		|	ТаблицаДанных.Ссылка КАК Регистратор,
		|	ТаблицаДанных.ХозяйственнаяОперация КАК ИсточникДанных,
		|	ТаблицаДанных.Организация КАК Организация,
		|	ТаблицаДанных.Подразделение КАК Подразделение,
		|	НЕОПРЕДЕЛЕНО КАК НаправлениеДеятельности,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ФормаОплатыЗаявки = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
		|			ТОГДА ТаблицаДанных.Касса
		//++ Локализация
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперацияПоЗарплате = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыЧерезКассу)
		|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ТаблицаРасшифровкаПлатежа.Ведомость КАК Документ.ВедомостьНаВыплатуЗарплатыВКассу).Касса, ТаблицаДанных.Касса)
		//-- Локализация
		|		ИНАЧЕ ТаблицаДанных.БанковскийСчет
		|	КОНЕЦ КАК ДенежныеСредства,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ФормаОплатыЗаявки = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
		//++ Локализация
		|			ИЛИ ТаблицаДанных.ХозяйственнаяОперацияПоЗарплате = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыЧерезКассу)
		//-- Локализация
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
		|		КОГДА ТаблицаДанных.ФормаОплатыЗаявки = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)
		|		ИНАЧЕ ВЫБОР
		|			КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратОплатыНаПлатежнуюКарту)
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)
		|			ИНАЧЕ НЕОПРЕДЕЛЕНО
		|		КОНЕЦ
		|	КОНЕЦ КАК ТипДенежныхСредств,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
		|			ТОГДА ЕСТЬNULL(ТаблицаЛицевыеСчетаСотрудников.СтатьяДвиженияДенежныхСредств, ТаблицаРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств)
		|		ИНАЧЕ ТаблицаДанных.СтатьяДвиженияДенежныхСредств
		|	КОНЕЦ КАК СтатьяДвиженияДенежныхСредств,
		//++ Локализация
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
		|			ТОГДА ЕСТЬNULL(ТаблицаРасшифровкаПлатежа.СтатьяЦелевыхСредств, ТаблицаДанных.СтатьяЦелевыхСредств)
		|		ИНАЧЕ ТаблицаДанных.СтатьяЦелевыхСредств
		|	КОНЕЦ КАК СтатьяЦелевыхСредств,
		//-- Локализация
		|	ТаблицаДанных.Валюта КАК Валюта,
		|	НЕОПРЕДЕЛЕНО КАК КорНаправлениеДеятельности,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет)
		|				ИЛИ ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.КонвертацияВалюты)
		|			ТОГДА ТаблицаДанных.БанковскийСчетПолучатель
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СнятиеНаличныхДенежныхСредств)
		|			ТОГДА ТаблицаДанных.КассаПолучатель
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
		|			ТОГДА ЕСТЬNULL(ТаблицаЛицевыеСчетаСотрудников.ФизическоеЛицо, ТаблицаДанных.ПодотчетноеЛицо)
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратОплатыНаПлатежнуюКарту)
		|			ТОГДА ТаблицаДанных.ДоговорЭквайринга
		|	КОНЕЦ КАК КорДенежныеСредства,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ДенежныеСредстваУПодотчетногоЛица)
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратОплатыНаПлатежнуюКарту)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ДенежныеСредстваУЭквайера)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ДенежныеСредстваВПути)
		|	КОНЕЦ КАК КорТипДенежныхСредств,
		|	ТаблицаДанных.Валюта КАК КорВалюта,
		|	ВЫБОР
		|		КОГДА НЕ ТаблицаДанных.СверхЛимита
		|			ТОГДА ВЫБОР
		|				КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику) И ТаблицаДанных.СписокФизЛиц
		|					ТОГДА ТаблицаЛицевыеСчетаСотрудников.Сумма
		|				ИНАЧЕ ЕСТЬNULL(ТаблицаРасшифровкаПлатежа.Сумма, ТаблицаДанных.СуммаДокумента)
		|			КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКВыплатеВРамкахЛимита,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.СверхЛимита
		|			ТОГДА ВЫБОР
		|				КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику) И ТаблицаДанных.СписокФизЛиц
		|					ТОГДА ТаблицаЛицевыеСчетаСотрудников.Сумма
		|				ИНАЧЕ ЕСТЬNULL(ТаблицаРасшифровкаПлатежа.Сумма, ТаблицаДанных.СуммаДокумента)
		|			КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКВыплатеСверхЛимита,
		|	ВЫБОР
		|		КОГДА ТаблицаДанных.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику) И ТаблицаДанных.СписокФизЛиц
		|			ТОГДА ТаблицаЛицевыеСчетаСотрудников.Сумма
		|		ИНАЧЕ ЕСТЬNULL(ТаблицаРасшифровкаПлатежа.Сумма, ТаблицаДанных.СуммаДокумента)
		|	КОНЕЦ КАК СуммаКВыплате
		|ПОМЕСТИТЬ ИмяВременнойТаблицы
		|ИЗ
		|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ТаблицаДанных
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК ТаблицаРасшифровкаПлатежа
		|		ПО ТаблицаДанных.Ссылка = ТаблицаРасшифровкаПлатежа.Ссылка
		|		И (НЕ ТаблицаДанных.СписокФизЛиц)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств.ЛицевыеСчетаСотрудников КАК ТаблицаЛицевыеСчетаСотрудников
		|		ПО ТаблицаДанных.Ссылка = ТаблицаЛицевыеСчетаСотрудников.Ссылка
