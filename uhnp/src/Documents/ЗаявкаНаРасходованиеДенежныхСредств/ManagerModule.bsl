		|	И &ХозяйственнаяОперация = &ХозОперацияЗарплата      
		|	И НЕ &ИспользоватьНачислениеЗарплатыУТ  
		|	И ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа.Ссылка.ХозяйственнаяОперацияПоЗарплате = &ХозОперацияВыплатаНаЛицевыеСчета
		|";		
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает результат проверки актуальности курсов 
Функция АктуальностьКурсовНарушена(Заявка, МассивИдентификаторПозиции = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
		
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	РазмещениеЗаявок.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	РазмещениеЗаявок.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	РазмещениеЗаявок.ВалютаОплаты КАК ВалютаОплаты,
	|	РазмещениеЗаявок.КурсПлатежа КАК КурсПлатежа,
	|	РазмещениеЗаявок.КратностьПлатежа КАК КратностьПлатежа,
	|	РазмещениеЗаявок.ДатаИсполнения КАК ДатаКурса
	|ПОМЕСТИТЬ ВТ_ОперацииКПереоценке
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК РасшифровкаПлатежаЗаявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|		ПО (РазмещениеЗаявок.ЗаявкаНаОперацию = РасшифровкаПлатежаЗаявки.Ссылка)
	|ГДЕ
	|	РасшифровкаПлатежаЗаявки.Ссылка = &Заявка
	|	И РазмещениеЗаявок.ВалютаВзаиморасчетов <> РазмещениеЗаявок.ВалютаОплаты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВалютаВзаиморасчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(КурсыВалют.Период) КАК ДатаКурсаВзаиморасчеты,
	|	ВТ_ОперацииКПереоценке.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	ВТ_ОперацииКПереоценке.ВалютаОплаты КАК ВалютаОплаты,
	|	ВТ_ОперацииКПереоценке.КурсПлатежа КАК КурсПлатежа,
	|	ВТ_ОперацииКПереоценке.КратностьПлатежа КАК КратностьПлатежа,
	|	ВТ_ОперацииКПереоценке.ДатаКурса КАК ДатаКурса,
	|	ВТ_ОперацииКПереоценке.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	ВТ_ОперацииКПереоценке.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	|ПОМЕСТИТЬ ВТ_ОперацииКПереоценке1
	|ИЗ
	|	ВТ_ОперацииКПереоценке КАК ВТ_ОперацииКПереоценке
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ВТ_ОперацииКПереоценке.ВалютаВзаиморасчетов = КурсыВалют.Валюта
	|			И ВТ_ОперацииКПереоценке.ДатаКурса >= КурсыВалют.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОперацииКПереоценке.ИдентификаторПозиции,
	|	ВТ_ОперацииКПереоценке.СуммаВзаиморасчетов,
	|	ВТ_ОперацииКПереоценке.ВалютаВзаиморасчетов,
	|	ВТ_ОперацииКПереоценке.ВалютаОплаты,
	|	ВТ_ОперацииКПереоценке.КурсПлатежа,
	|	ВТ_ОперацииКПереоценке.ДатаКурса,
	|	ВТ_ОперацииКПереоценке.КратностьПлатежа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(КурсыВалют.Период) КАК ДатаКурсаОплата,
	|	ВТ_ОперацииКПереоценке.ДатаКурсаВзаиморасчеты КАК ДатаКурсаВзаиморасчеты,
	|	ВТ_ОперацииКПереоценке.ДатаКурса КАК ДатаКурса,
	|	ВТ_ОперацииКПереоценке.КурсПлатежа КАК КурсПлатежа,
	|	ВТ_ОперацииКПереоценке.КратностьПлатежа КАК КратностьПлатежа,
	|	ВТ_ОперацииКПереоценке.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	ВТ_ОперацииКПереоценке.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	ВТ_ОперацииКПереоценке.ВалютаОплаты КАК ВалютаОплаты,
	|	ВТ_ОперацииКПереоценке.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	|ПОМЕСТИТЬ ВТ_ОперацииСДатамиКурсов
	|ИЗ
	|	ВТ_ОперацииКПереоценке1 КАК ВТ_ОперацииКПереоценке
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ВТ_ОперацииКПереоценке.ВалютаОплаты = КурсыВалют.Валюта
	|			И ВТ_ОперацииКПереоценке.ДатаКурса >= КурсыВалют.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОперацииКПереоценке.ДатаКурса,
	|	ВТ_ОперацииКПереоценке.КурсПлатежа,
	|	ВТ_ОперацииКПереоценке.КратностьПлатежа,
	|	ВТ_ОперацииКПереоценке.ДатаКурсаВзаиморасчеты,
	|	ВТ_ОперацииКПереоценке.ВалютаОплаты,
	|	ВТ_ОперацииКПереоценке.ИдентификаторПозиции,
	|	ВТ_ОперацииКПереоценке.СуммаВзаиморасчетов,
	|	ВТ_ОперацииКПереоценке.ВалютаВзаиморасчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЕСТЬNULL(КурсВалютыВзаиморасчетов.Курс * КурсВалютыОплаты.Кратность, 0) / (ЕСТЬNULL(КурсВалютыВзаиморасчетов.Кратность, 1) * ЕСТЬNULL(КурсВалютыОплаты.Курс, 1)) КАК ЧИСЛО(10, 4)) КАК КурсПлатежа,
	|	1 КАК КратностьПлатежа,
	|	ВТ_ОперацииСДатамиКурсов.ДатаКурсаОплата КАК ДатаКурсаОплата,
	|	ВТ_ОперацииСДатамиКурсов.ДатаКурсаВзаиморасчеты КАК ДатаКурсаВзаиморасчеты,
	|	ВТ_ОперацииСДатамиКурсов.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	ВТ_ОперацииСДатамиКурсов.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	ВТ_ОперацииСДатамиКурсов.КурсПлатежа КАК КурсПлатежаДокумент,
	|	ВТ_ОперацииСДатамиКурсов.КратностьПлатежа КАК КратностьПлатежаДокумент,
	|	ВТ_ОперацииСДатамиКурсов.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	|ИЗ
	|	ВТ_ОперацииСДатамиКурсов КАК ВТ_ОперацииСДатамиКурсов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыВзаиморасчетов
	|		ПО ВТ_ОперацииСДатамиКурсов.ДатаКурсаВзаиморасчеты = КурсВалютыВзаиморасчетов.Период
	|			И ВТ_ОперацииСДатамиКурсов.ВалютаВзаиморасчетов = КурсВалютыВзаиморасчетов.Валюта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыОплаты
	|		ПО ВТ_ОперацииСДатамиКурсов.ДатаКурсаОплата = КурсВалютыОплаты.Период
	|			И ВТ_ОперацииСДатамиКурсов.ВалютаОплаты = КурсВалютыОплаты.Валюта
	|ГДЕ
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(КурсВалютыВзаиморасчетов.Курс * КурсВалютыОплаты.Кратность, 0) / (ЕСТЬNULL(КурсВалютыВзаиморасчетов.Кратность, 1) * ЕСТЬNULL(КурсВалютыОплаты.Курс, 1)) КАК ЧИСЛО(10, 4))) <> ВТ_ОперацииСДатамиКурсов.КурсПлатежа / ВЫБОР
	|			КОГДА ЕСТЬNULL(ВТ_ОперацииСДатамиКурсов.КратностьПлатежа, 0) = 0
	|				ТОГДА 1
	|			ИНАЧЕ ЕСТЬNULL(ВТ_ОперацииСДатамиКурсов.КратностьПлатежа, 1)
	|		КОНЕЦ";
	
	Если МассивИдентификаторПозиции <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РасшифровкаПлатежаЗаявки.Ссылка = &Заявка", "РазмещениеЗаявок.ИдентификаторПозиции В (&ИдентификаторПозиции)");
		Запрос.УстановитьПараметр("ИдентификаторПозиции", 	МассивИдентификаторПозиции);
	Иначе
		Запрос.УстановитьПараметр("Заявка", 				Заявка);
	КонецЕсли;
	Возврат  НЕ Запрос.Выполнить().Пустой();
		
КонецФункции

#Область ПланыДокумента_УХ

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	1 КАК НомерЗапроса,
	|	&Дата КАК ДатаРегистрации,
	|	&Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА &ЭтоРасчетыСКонтрагентом
	|			ТОГДА &Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА &ЭтоРасчетыПоДоговору
	|			ТОГДА &ДоговорКонтрагента
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	КОНЕЦ КАК ДоговорКонтрагента,
	|	ВЫБОР
	|		КОГДА &ЭтоРасчетыПоДоговору = ЛОЖЬ
	|				ИЛИ &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА &ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	|			ТОГДА &ДоговорКонтрагента
	|		ИНАЧЕ ДвиженияОперации.ОбъектРасчетов
	|	КОНЕЦ КАК ОбъектРасчетов,
	|	&Валюта КАК Валюта,
	|	&Ссылка КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА &ПолучитьИзДокументаОснования
	|				И &ЭтоРасчетыПоЗаказам
	|			ТОГДА &ДокументОснование
	|		КОГДА &ГрафикДоговора = ЗНАЧЕНИЕ(Перечисление.ГрафикиДоговора.Резервирование)
	|			ТОГДА &ДоговорКонтрагента
	|		КОГДА &ГрафикДоговора = ЗНАЧЕНИЕ(Перечисление.ГрафикиДоговора.ГрафикРасчетов)
