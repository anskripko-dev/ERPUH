	ПереопределитьКурсКратностьПлатежа(Запрос, РеквизитыДокумента);
	
	// Параметры из ВидОперацииУХ
	ЭтоРасчетыСКонтрагентом = ВидыОперацийУХВызовСервераПовтИсп.ЭтоРасчетыСКонтрагентом(РеквизитыДокумента.ВидОперацииУХ);
	ЭтоРасчетыПоДоговору = ЭтоРасчетыСКонтрагентом И НЕ ВидыОперацийУХВызовСервераПовтИсп.ЭтоРасчетыБезДоговора(РеквизитыДокумента.ВидОперацииУХ);
	ЗаявкаСРасшифровкойПлатежа 	= ВидыОперацийУХВызовСервераПовтИспПереопределяемый.РасшифровкаПлатежаВТабличнойЧасти(РеквизитыДокумента.ВидОперацииУХ);
	ЕстьАналитикиЗачисления = ВидыОперацийУХВызовСервераПовтИсп.ЭтоПеремещениеВнутриОрганизации(РеквизитыДокумента.ВидОперацииУХ);
	ЭтоКонвертацияВалюты = ВидыОперацийУХКлиентСерверПовтИсп.ЭтоКонвертацияВалюты(РеквизитыДокумента.ВидОперацииУХ);
	ЭтоВыплатаПоВедомостиПоЗарплатномуПроекту = РеквизитыДокумента.ХозяйственнаяОперацияПоЗарплате = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту;
	ЭтоВыплатаНаЛицевыеСчетаПоЗарплатномуПроекту = РеквизитыДокумента.ХозяйственнаяОперацияПоЗарплате = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета;
	ЭтоЗаявкаПоПТУ = ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг");
	ИсточникЛимитовОснование = ЗначениеЗаполнено(РеквизитыДокумента.ДокументОснование) 
								И (ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику") ИЛИ ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
	
	Запрос.УстановитьПараметр("ЭтоРасчетыСКонтрагентом", ЭтоРасчетыСКонтрагентом);
	Запрос.УстановитьПараметр("ЭтоРасчетыПоДоговору", ЭтоРасчетыПоДоговору);  
	Запрос.УстановитьПараметр("ЭтоКонвертацияВалюты", ЭтоКонвертацияВалюты);
	Запрос.УстановитьПараметр("ЭтоВыплатаПоВедомостиПоЗарплатномуПроекту", ЭтоВыплатаПоВедомостиПоЗарплатномуПроекту);
	Запрос.УстановитьПараметр("ЭтоВыплатаНаЛицевыеСчетаПоЗарплатномуПроекту", ЭтоВыплатаНаЛицевыеСчетаПоЗарплатномуПроекту);
	Запрос.УстановитьПараметр("ЕстьАналитикиЗачисления", ЕстьАналитикиЗачисления);  
	Запрос.УстановитьПараметр("ПолучитьИзДокументаОснования", ИсточникЛимитовОснование);
	Запрос.УстановитьПараметр("ЗаявкаСРасшифровкойПлатежа",	ЗаявкаСРасшифровкойПлатежа);

	Если ЭтоЗаявкаПоПТУ Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.ДокументОснование, "ПоступлениеПоЗаказам") Тогда
			Запрос.УстановитьПараметр("ДокументОснование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.ДокументОснование, "ЗаказПоставщику"));
		Иначе
			Запрос.УстановитьПараметр("ДокументОснование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.ДокументОснование, "Договор"));
