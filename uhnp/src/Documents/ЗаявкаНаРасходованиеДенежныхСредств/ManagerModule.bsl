		"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_РасшифровкаПлатежа ИЗ &РасшифровкаПлатежа КАК Коллекция";
		Запрос.Выполнить();

		// лицевые счета
		ИменаРеквизитовТЧЛицевыеСчета = " Сумма,  СтатьяДвиженияДенежныхСредств, " 
