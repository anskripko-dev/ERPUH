КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = ПустаяСсылка().Метаданные().ПолноеИмя();
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|//Очистка от ""Пустых"" объектов расчетов.
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеРасшифровки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК ДанныеРасшифровки
	|ГДЕ
	|	ДанныеРасшифровки.ОбъектРасчетов <> ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка)
	|	И ДанныеРасшифровки.ОбъектРасчетов.Объект = Неопределено
	|
	//++ Локализация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.УдалитьОплатаСамозанятому)
	//-- Локализация
	|
	|
	|ОБЪЕДИНИТЬ
	|
	|//Заполнение реквизита ТипНалога
	|ВЫБРАТЬ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
	|ГДЕ
	|	(ЗаявкаНаРасходованиеДенежныхСредств.УдалитьТипНалога <> ЗНАЧЕНИЕ(Перечисление.УдалитьТипыНалогов.ПустаяСсылка)
	|	И ЗаявкаНаРасходованиеДенежныхСредств.ТипНалога = ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.ПустаяСсылка))
	|	ИЛИ (ЗаявкаНаРасходованиеДенежныхСредств.АналитикаАктивовПассивов ССЫЛКА Перечисление.УдалитьТипыНалогов)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК ЗаявкаНаРасходованиеДенежныхСредств
	|ГДЕ
	|	ЗаявкаНаРасходованиеДенежныхСредств.АналитикаАктивовПассивов ССЫЛКА Перечисление.УдалитьТипыНалогов
	|
	|";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

// Обработчик обновления
// 
// Параметры:
// 	Параметры - См. ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляМногопоточнойОбработки 
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяОбъекта = ПустаяСсылка().Метаданные().ПолноеИмя();
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		
		Параметры.ОбработкаЗавершена =
			ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
		
	КонецЕсли;
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	ИсключенияПриОбновлении = Новый Массив;
	
	СписокОписаний = Новый Массив;
	СписокОписаний.Добавить(НСтр("ru = 'Не удалось обработать документы ""Заявка на расходование денежных средств"" по обработчику:';
								|en = 'Cannot process the ""Payment request"" documents by the handler:'"));
	СписокОписаний.Добавить(НСтр("ru = '- очистка заявок от ""Пустых"" объектов расчетов и перезаполнение флага ""Контролировать оплату по объектам расчетов"";';
								|en = '- Delete ""Empty"" AR/AP objects from requests and reselect the ""Control payment by AR/AP objects"" checkbox.'"));
	
	//++ Локализация
	СписокОписаний.Добавить(НСтр("ru = '- замена операции ""Оплата самозанятому"" на операцию ""Оплата поставщику"" с признаком ""Оплата самозанятому"";';
								|en = '- Replace the ""Payment to self-employed person"" transaction with the ""Payment to vendor"" transaction with the ""Payment to self-employed person"" flag.'"));
	//-- Локализация
	
	СписокОписаний.Добавить(НСтр("ru = '- заполнение реквизита ""Налог"" по данным реквизита  ""Налог (не используется)"";';
								|en = '- Fill in the ""Tax"" attribute according to the ""Tax (not used)"" attribute data.'"));
	СписокОписаний.Добавить(НСтр("ru = '- замена аналитики с типом перечисление типы налогов на справочник виды налогов и взносов';
								|en = '- Replace the dimension value ""Tax types"" enumeration type with the ""Tax and contribution kinds"" catalog.'"));

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеДляОбновления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТаблицаДокументов
		|ИЗ
		|	&ДанныеДляОбновления КАК ДанныеДляОбновления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДокументов.Ссылка КАК Ссылка,
		|	ДанныеДокумента.ВерсияДанных КАК ВерсияДанных
		|ИЗ
		|	ТаблицаДокументов КАК ТаблицаДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ДанныеДокумента
		|		ПО ТаблицаДокументов.Ссылка = ДанныеДокумента.Ссылка
		|";
	
	Запрос.УстановитьПараметр("ДанныеДляОбновления", ОбновляемыеДанные);
	
	Документ = Запрос.Выполнить().Выбрать();
	
	Пока Документ.Следующий() Цикл
		
		ПричинаИсключения = 0;
		Рекомендация = "";
		
		НачатьТранзакцию();
		
		Попытка
			
			ПричинаИсключения = 1; // Блокировка
			
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Документ.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			ДокументОбъект = ОбновлениеИнформационнойБазыУТ.ПроверитьПолучитьОбъект(
				Документ.Ссылка, Документ.ВерсияДанных, Параметры.Очередь); // ДокументОбъект
			
			ПричинаИсключения = 2; // ПлохиеДанные
			Рекомендация = НСтр("ru = 'Перепроведите документ вручную.';
								|en = 'Repost the document manually.'");
			
			ОбъектИзменен = Ложь;
			
			Если ДокументОбъект <> Неопределено Тогда

				Перечисления.УдалитьТипыНалогов.ЗаполнитьРеквизитТипНалога(ДокументОбъект, "УдалитьТипНалога", "ТипНалога");
				Перечисления.УдалитьТипыНалогов.ЗаполнитьРеквизитТипНалога(ДокументОбъект, "АналитикаАктивовПассивов");
				Перечисления.УдалитьТипыНалогов.ЗаполнитьРеквизитТипНалога(ДокументОбъект, "РасшифровкаПлатежа.АналитикаАктивовПассивов");
				
				Если ДокументОбъект.Модифицированность() Тогда
					ОбъектИзменен = Истина;
				КонецЕсли;
				
				//Очистка от "Пустых" объектов расчетов
				ОбъектыРасчетов = ДокументОбъект.РасшифровкаПлатежа.ВыгрузитьКолонку("ОбъектРасчетов");
				ОбъектыОбъектовРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ОбъектыРасчетов,"Объект");
				Для Каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл
					Если ЗначениеЗаполнено(Стр.ОбъектРасчетов) И НЕ ЗначениеЗаполнено(ОбъектыОбъектовРасчетов[Стр.ОбъектРасчетов]) Тогда
						Стр.ОбъектРасчетов = Справочники.ОбъектыРасчетов.ПустаяСсылка();
						ДокументОбъект.КонтролироватьОплатуПоОбъектамРасчетов = Ложь;
						ОбъектИзменен = Истина;
					КонецЕсли;
				КонецЦикла;
				
				//++ Локализация
				Если ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.УдалитьОплатаСамозанятому Тогда
					
					ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
					ДокументОбъект.ОперацияССамозанятым = Истина; 
					#Область УХ_Казначейство
					ДокументОбъект.ВидОперацииУХ = Справочники.ВидыОперацийУХ.ОплатаПоставщику;
					НаборЗаписей = РегистрыСведений.РазмещениеЗаявок.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.ЗаявкаНаОперацию.Установить(ДокументОбъект.Ссылка);
					НаборЗаписей.Прочитать();
					Для Каждого ТекЗапись Из НаборЗаписей Цикл
						ТекЗапись.ВидОперацииУХ = ДокументОбъект.ВидОперацииУХ;
					КонецЦикла;    
					ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
					#КонецОбласти
					ОбъектИзменен = Истина;
					
				КонецЕсли;
				//-- Локализация
					
			КонецЕсли;
			
			ПричинаИсключения = 3; // Запись
			
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Документ.Ссылка);
			КонецЕсли;
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), Документ.Ссылка);
			
			Если ПричинаИсключения = 2 Тогда
				
				ОписаниеПроблемы = ОбновлениеИнформационнойБазыУТ.ПроблемаСДанными(
					Документ.Ссылка, Рекомендация, ИнформацияОбОшибке());
				ИсключенияПриОбновлении.Добавить(ОписаниеПроблемы);
				
			ИначеЕсли ПричинаИсключения = 3 Тогда
				
				ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(
					ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
				ВызватьИсключение СтрСоединить(СписокОписаний, Символы.ПС);
				
			КонецЕсли;
			
		КонецПопытки;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена =
		ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		
		СписокОписаний.Добавить(НСтр("ru = 'Всего пропущено: %1';
									|en = 'Total skipped: %1'"));
		ТекстСообщения = СтрШаблон(СтрСоединить(СписокОписаний, Символы.ПС), ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
		
	Иначе
		
		ШаблонСообщения = НСтр("ru = 'Обработана порция заявок на расходование ДС: %1';
								|en = 'A batch of payment requests is processed: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбъектовОбработано);
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация, , ,
			ТекстСообщения);
		
	КонецЕсли;
	
	ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
	
КонецПроцедуры

//++ Локализация

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДокументыКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = ПустаяСсылка().Метаданные().ПолноеИмя();
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Дата УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Дата УБЫВ");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК Ссылка,
	|	ЗаявкаНаРасходованиеДенежныхСредств.ИННПлательщика КАК ИННПлательщика,
	|	ЗаявкаНаРасходованиеДенежныхСредств.КПППлательщика КАК КПППлательщика,
	|	ЗаявкаНаРасходованиеДенежныхСредств.ТекстПлательщика КАК ТекстПлательщика,
	|	ЗаявкаНаРасходованиеДенежныхСредств.ПеречислениеВБюджет КАК ПеречислениеВБюджет
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
	|ГДЕ
	|	ЗаявкаНаРасходованиеДенежныхСредств.ИННПлательщика = """"
	|	ИЛИ ЗаявкаНаРасходованиеДенежныхСредств.КПППлательщика = """"
	|	ИЛИ ВЫРАЗИТЬ(ЗаявкаНаРасходованиеДенежныхСредств.ТекстПлательщика КАК СТРОКА(1024)) = """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаявкаНаРасходованиеДенежныхСредств.Дата УБЫВ";
	
	ЗарегистрированныеДокументы = Запрос.Выполнить().Выгрузить();
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст = ТекстЗапросаРеквизитовПлательщикаСГруппировкойПоДокументам();
	ЗапросДанных.УстановитьПараметр("ПроверяемыеДокументы", ЗарегистрированныеДокументы);
	ВыборкаДанныхПоДокументам = ЗапросДанных.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СписокДокументов = Новый Массив;
	
	Для Каждого ТекущийДокумент Из ЗарегистрированныеДокументы Цикл
		
		НайденныеРеквизитыПлательщика = РеквизитыПлательщикаПоДокументу(
			ВыборкаДанныхПоДокументам, ТекущийДокумент.Ссылка, ТекущийДокумент.ПеречислениеВБюджет);
		
		Если ПустаяСтрока(ТекущийДокумент.ИННПлательщика)
			И Не ПустаяСтрока(НайденныеРеквизитыПлательщика.ИННПлательщика) Тогда
			СписокДокументов.Добавить(ТекущийДокумент.Ссылка);
		ИначеЕсли ПустаяСтрока(ТекущийДокумент.КПППлательщика)
			И Не ПустаяСтрока(НайденныеРеквизитыПлательщика.КПППлательщика) Тогда
			СписокДокументов.Добавить(ТекущийДокумент.Ссылка);
		ИначеЕсли ПустаяСтрока(ТекущийДокумент.ТекстПлательщика)
			И Не ПустаяСтрока(НайденныеРеквизитыПлательщика.ТекстПлательщика) Тогда
			СписокДокументов.Добавить(ТекущийДокумент.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, СписокДокументов);
	
КонецПроцедуры

// Обработчик обновления
// 
// Параметры:
// 	Параметры - См. ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляМногопоточнойОбработки 
//
Процедура ОбработатьДокументыДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяОбъекта = ПустаяСсылка().Метаданные().ПолноеИмя();
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		
		Параметры.ОбработкаЗавершена =
			ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
		
	КонецЕсли;
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	ИсключенияПриОбновлении = Новый Массив;
	
	СписокОписаний = Новый Массив;
	СписокОписаний.Добавить(НСтр("ru = 'Не удалось заполнить реквизиты документа ""Заявка на расходование денежных средств"" по обработчику';
								|en = 'Не удалось заполнить реквизиты документа ""Заявка на расходование денежных средств"" по обработчику'"));

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеДляОбновления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТаблицаДокументов
		|ИЗ
		|	&ДанныеДляОбновления КАК ДанныеДляОбновления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДокументов.Ссылка КАК Ссылка,
		|	ДанныеДокумента.ВерсияДанных КАК ВерсияДанных
		|ИЗ
		|	ТаблицаДокументов КАК ТаблицаДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ДанныеДокумента
		|		ПО ТаблицаДокументов.Ссылка = ДанныеДокумента.Ссылка
		|";
	
	Запрос.УстановитьПараметр("ДанныеДляОбновления", ОбновляемыеДанные);
	Документ = Запрос.Выполнить().Выбрать();
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст = ТекстЗапросаРеквизитовПлательщикаСГруппировкойПоДокументам();
	ЗапросДанных.УстановитьПараметр("ПроверяемыеДокументы", ОбновляемыеДанные);
	ВыборкаПоДокументам = ЗапросДанных.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Документ.Следующий() Цикл
		
		ПричинаИсключения = "";
		Рекомендация = "";
		
		НачатьТранзакцию();
		
		Попытка
			
			ПричинаИсключения = "Блокировка";
			
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Документ.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			ДокументОбъект = ОбновлениеИнформационнойБазыУТ.ПроверитьПолучитьОбъект(
				Документ.Ссылка, Документ.ВерсияДанных, Параметры.Очередь); // ДокументОбъект
			
			ПричинаИсключения = "ПлохиеДанные";
			Рекомендация = НСтр("ru = 'Перепроведите документ вручную.';
								|en = 'Перепроведите документ вручную.'");
			
			Если ДокументОбъект <> Неопределено Тогда

				РеквизитыПлательщика = РеквизитыПлательщикаПоДокументу(
					ВыборкаПоДокументам, Документ.Ссылка, ДокументОбъект.ПеречислениеВБюджет);
				
				Если ПустаяСтрока(ДокументОбъект.ИННПлательщика)
					И Не ПустаяСтрока(РеквизитыПлательщика.ИННПлательщика) Тогда
					ДокументОбъект.ИННПлательщика = РеквизитыПлательщика.ИННПлательщика;
				КонецЕсли;
					
				Если ПустаяСтрока(ДокументОбъект.КПППлательщика)
					И Не ПустаяСтрока(РеквизитыПлательщика.КПППлательщика) Тогда
					
					ДействуетПриказ58н = ПлатежиВБюджетКлиентСервер.ДействуетПриказ58н_202604(ДокументОбъект.Дата);
					
					Если ДействуетПриказ58н
						И ДокументОбъект.ТипНалога = Справочники.ВидыНалоговВзносов.ЕдиныйНалоговыйПлатеж Тогда
						РеквизитыПлательщика.КПППлательщика = "0";
					КонецЕсли;
					
					ДокументОбъект.КПППлательщика = РеквизитыПлательщика.КПППлательщика;
					
				КонецЕсли;
				
				Если ПустаяСтрока(ДокументОбъект.ТекстПлательщика)
					И Не ПустаяСтрока(РеквизитыПлательщика.ТекстПлательщика) Тогда
					ДокументОбъект.ТекстПлательщика = РеквизитыПлательщика.ТекстПлательщика;
				КонецЕсли;
				
				ПричинаИсключения = "Запись";
				
				Если ДокументОбъект.Модифицированность() Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
				Иначе
					ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Документ.Ссылка);
				КонецЕсли;
				
			КонецЕсли;
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), Документ.Ссылка);
			
			Если ПричинаИсключения = "ПлохиеДанные" Тогда
				
				ОписаниеПроблемы = ОбновлениеИнформационнойБазыУТ.ПроблемаСДанными(
					Документ.Ссылка, Рекомендация, ИнформацияОбОшибке());
				ИсключенияПриОбновлении.Добавить(ОписаниеПроблемы);
				
			ИначеЕсли ПричинаИсключения = "Запись" Тогда
				
				ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(
					ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
				ВызватьИсключение СтрСоединить(СписокОписаний, Символы.ПС);
				
			КонецЕсли;
			
		КонецПопытки;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена =
		ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		
		СписокОписаний.Добавить(НСтр("ru = 'Всего пропущено: %1';
									|en = 'Всего пропущено: %1'"));
		ТекстСообщения = СтрШаблон(СтрСоединить(СписокОписаний, Символы.ПС), ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
	
КонецПроцедуры

Функция ТекстЗапросаРеквизитовПлательщикаСГруппировкойПоДокументам()
	
	Возврат 
		"ВЫБРАТЬ
		|	ПроверяемыеДокументы.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТаблицаДокументов
		|ИЗ
		|	&ПроверяемыеДокументы КАК ПроверяемыеДокументы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДокументов.Ссылка КАК Ссылка,
		|	ДанныеДокумента.БанковскийСчет КАК БанковскийСчет,
		|	ДанныеДокумента.ПеречислениеВБюджет КАК ПеречислениеВБюджет,
		|	ДанныеДокумента.Дата КАК Дата,
		|	ДанныеДокумента.Организация КАК Организация
		|ПОМЕСТИТЬ ИсходныеДанные
		|ИЗ
		|	ТаблицаДокументов КАК ТаблицаДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ДанныеДокумента
		|		ПО ТаблицаДокументов.Ссылка = ДанныеДокумента.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсходныеДанные.Организация КАК Организация,
		|	Организации.ИНН КАК ИНН,
		|	Организации.КПП КАК КПП,
		|	Организации.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	Организации.НаименованиеСокращенное КАК НаименованиеСокращенное
		|ПОМЕСТИТЬ ТекущиеРеквизитыОрганизации
		|ИЗ
		|	ИсходныеДанные КАК ИсходныеДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ИсходныеДанные.Организация = Организации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ИсходныеДанные.ПеречислениеВБюджет
		|				И ЕСТЬNULL(БанковскиеСчетаОрганизаций.ТекстКорреспондентаБюджет, """") <> """"
		|			ТОГДА БанковскиеСчетаОрганизаций.ТекстКорреспондентаБюджет
		|		ИНАЧЕ ЕСТЬNULL(ОрганизацииИсторияНаименований.НаименованиеСокращенное, ТекущиеРеквизитыОрганизации.НаименованиеСокращенное)
		|	КОНЕЦ КАК ЗначениеРеквизита,
		|	ВЫБОР
		|		КОГДА ИсходныеДанные.ПеречислениеВБюджет
		|				И ЕСТЬNULL(БанковскиеСчетаОрганизаций.ТекстКорреспондентаБюджет, """") <> """"
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ЕСТЬNULL(ОрганизацииИсторияНаименований.Период, ДАТАВРЕМЯ(1, 1, 1))
		|	КОНЕЦ КАК НачалоДействия,
		|	ИсходныеДанные.Ссылка КАК Документ,
		|	0 КАК Признак
		|ПОМЕСТИТЬ ИсторияЗначенийРеквизитов
		|ИЗ
		|	ИсходныеДанные КАК ИсходныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.ИсторияНаименований КАК ОрганизацииИсторияНаименований
		|		ПО ИсходныеДанные.Организация = ОрганизацииИсторияНаименований.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТекущиеРеквизитыОрганизации КАК ТекущиеРеквизитыОрганизации
		|		ПО ИсходныеДанные.Организация = ТекущиеРеквизитыОрганизации.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
		|		ПО ИсходныеДанные.БанковскийСчет = БанковскиеСчетаОрганизаций.Ссылка
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ИсходныеДанные.ПеречислениеВБюджет
		|					И ЕСТЬNULL(БанковскиеСчетаОрганизаций.ТекстКорреспондентаБюджет, """") <> """"
		|				ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|			ИНАЧЕ ЕСТЬNULL(ОрганизацииИсторияНаименований.Период, ДАТАВРЕМЯ(1, 1, 1))
		|		КОНЕЦ <= ИсходныеДанные.Дата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА Организации.РегистрацияВНалоговомОргане = """"
		|			ТОГДА Организации.КПП
		|		ИНАЧЕ ЕСТЬNULL(РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане.КПП, Организации.КПП)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА Организации.РегистрацияВНалоговомОргане = """"
		|			ТОГДА ИсходныеДанные.Дата
		|		ИНАЧЕ ЕСТЬNULL(РегистрацииВНалоговомОргане.Период, ДАТАВРЕМЯ(1, 1, 1))
		|	КОНЕЦ,
		|	ИсходныеДанные.Ссылка,
		|	1
		|ИЗ
		|	ИсходныеДанные КАК ИсходныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
		|		ПО ИсходныеДанные.Организация = РегистрацииВНалоговомОргане.Организация
		|			И (РегистрацииВНалоговомОргане.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТекущиеРеквизитыОрганизации КАК Организации
		|		ПО ИсходныеДанные.Организация = Организации.Организация
		|ГДЕ
		|	ВЫБОР
		|			КОГДА Организации.РегистрацияВНалоговомОргане = """"
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЕСТЬNULL(РегистрацииВНалоговомОргане.Период, ДАТАВРЕМЯ(1, 1, 1)) <= ИсходныеДанные.Дата
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТекущиеРеквизитыОрганизации.ИНН,
		|	ИсходныеДанные.Дата,
		|	ИсходныеДанные.Ссылка,
		|	2
		|ИЗ
		|	ИсходныеДанные КАК ИсходныеДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТекущиеРеквизитыОрганизации КАК ТекущиеРеквизитыОрганизации
		|		ПО ИсходныеДанные.Организация = ТекущиеРеквизитыОрганизации.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсторияЗначенийРеквизитов.Документ КАК Документ,
		|	МАКСИМУМ(ИсторияЗначенийРеквизитов.НачалоДействия) КАК НачалоДействия,
		|	ИсторияЗначенийРеквизитов.Признак КАК Признак
		|ПОМЕСТИТЬ БлижайшиеЗаписи
		|ИЗ
		|	ИсторияЗначенийРеквизитов КАК ИсторияЗначенийРеквизитов
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсторияЗначенийРеквизитов.Документ,
		|	ИсторияЗначенийРеквизитов.Признак
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсторияЗначенийРеквизитов.Документ КАК Документ,
		|	ИсторияЗначенийРеквизитов.ЗначениеРеквизита КАК ЗначениеРеквизита,
		|	ИсторияЗначенийРеквизитов.Признак КАК Признак
		|ИЗ
		|	ИсторияЗначенийРеквизитов КАК ИсторияЗначенийРеквизитов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ БлижайшиеЗаписи КАК БлижайшиеЗаписи
		|		ПО ИсторияЗначенийРеквизитов.Документ = БлижайшиеЗаписи.Документ
		|			И ИсторияЗначенийРеквизитов.НачалоДействия = БлижайшиеЗаписи.НачалоДействия
		|			И ИсторияЗначенийРеквизитов.Признак = БлижайшиеЗаписи.Признак
		|ИТОГИ ПО
		|	Документ";
	
КонецФункции

Функция РеквизитыПлательщикаПоДокументу(ВыборкаПоДокументам, Документ, ЭтоПеречислениеВБюджет)

	Отбор = Новый Структура("Документ", Документ);
	
	РеквизитыПлательщика = Новый Структура;
	РеквизитыПлательщика.Вставить("ИННПлательщика", "");
	РеквизитыПлательщика.Вставить("КПППлательщика", "");
	РеквизитыПлательщика.Вставить("ТекстПлательщика", "");
	ВыборкаПоДокументам.Сбросить();
	
	Если ВыборкаПоДокументам.НайтиСледующий(Отбор) Тогда
		
		ДанныеПлательщика = ВыборкаПоДокументам.Выбрать();
		
		Пока ДанныеПлательщика.Следующий() Цикл
			
			Если ДанныеПлательщика.Признак = 0 Тогда
				РеквизитыПлательщика.ТекстПлательщика = ДанныеПлательщика.ЗначениеРеквизита;
			ИначеЕсли ДанныеПлательщика.Признак = 1 Тогда
				РеквизитыПлательщика.КПППлательщика = ДанныеПлательщика.ЗначениеРеквизита;
				ОбработатьРеквизитПлательщика(РеквизитыПлательщика.КПППлательщика, ЭтоПеречислениеВБюджет);
			ИначеЕсли ДанныеПлательщика.Признак = 2 Тогда
				РеквизитыПлательщика.ИННПлательщика = ДанныеПлательщика.ЗначениеРеквизита;
				ОбработатьРеквизитПлательщика(РеквизитыПлательщика.ИННПлательщика, ЭтоПеречислениеВБюджет);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РеквизитыПлательщика;

КонецФункции

// Обрабатывает реквизит плательщика, удаляя лидирующие нули и подставляя значение "0" при пустой строке.
//
// Параметры:
//   ЗначениеРеквизита - Строка - обрабатываемое значение реквизита (ИНН или КПП)
//   ЭтоПеречислениеВБюджет - Булево - признак перечисления в бюджет
//
Процедура ОбработатьРеквизитПлательщика(ЗначениеРеквизита, ЭтоПеречислениеВБюджет)
	
	Результат = СокрЛП(ЗначениеРеквизита);
	
	Если Лев(Результат, 2) = "00" Тогда
		ЗначениеРеквизита = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(Результат) Тогда
		
		Если ЭтоПеречислениеВБюджет Тогда
			ЗначениеРеквизита = "0";
		Иначе
			ЗначениеРеквизита = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

