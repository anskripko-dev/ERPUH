#КонецОбласти

#КонецОбласти

#Область УХ_Встраивание

Процедура ПоляДанныхПредставления(СтруктураПолей) Экспорт
	
	СтруктураПолей.Сумма = "СуммаДокумента";
	СтруктураПолей.Валюта = "Валюта";
	СтруктураПолей.ДатаПланируемая = "ЖелательнаяДатаПлатежа";
	СтруктураПолей.ДатаНеПозднее = "КрайняяДата";
	
КонецПроцедуры

// Функция не отрабатывает операцию ВыдачаДенежныхСредствПодотчетнику
//  Если СписокФизлиц = Истина Тогда БезРасшифровки
//  Иначе СРасшифровкой
//
Функция ХозОперацииБезРасшифровки() Экспорт
	
	ХО = Перечисления.ХозяйственныеОперации;
	
	Массив = Новый Массив;
	
	Массив.Добавить(ХО.ВнутренняяПередачаДенежныхСредств); // между филиалами
	Массив.Добавить(ХО.КонвертацияВалюты); // между филиалами  
	#Область УХ_Встраивание
	Массив.Добавить(ХО.ВыдачаДенежныхСредствПодотчетнику); // между филиалами
	#КОнецОбласти
	
	Если Не Константы.ИспользоватьНачислениеЗарплаты.Получить() Тогда
		Массив.Добавить(ХО.ВыплатаЗарплаты);
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьНачислениеЗарплатыУТ") Тогда
		Массив.Добавить(ХО.ВыдачаЗаймаСотруднику);
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции

// Хоз. операции без расшифровки, со статьями ДДС списания и зачисления.
Функция ХозОперацииСписаниеЗачисление() Экспорт
	
	ХО = Перечисления.ХозяйственныеОперации;
	
	Массив = Новый Массив;
	Массив.Добавить(ХО.ВнутренняяПередачаДенежныхСредств); // между филиалами
	
	Возврат Массив;
	
КонецФункции

// УХСогласование
Функция ПроверитьВозможностьУстановкиСостояния(ОбъектСсылка, СостояниеОбъекта, ПротоколОшибок = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектСсылка) <> Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		ТекстОшибки = СтрШаблон( 
			НСтр("ru = 'Объект %1 не является заявкой на расходование денежных средств.'"),
			ОбъектСсылка);
		УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
			ПротоколОшибок, ОбъектСсылка, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ПроверкаПройдена = Истина;
	
	Если СостояниеОбъекта = Перечисления.СостоянияСогласования.Утверждена Тогда
		
		// Организация, контрагент, договор, счет контрагента, статьи ДДС, ЦФО, Период контроля
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаОперацию.Ссылка КАК Ссылка,
		|	ЗаявкаНаОперацию.Организация КАК Организация,
		|	ЗаявкаНаОперацию.Контрагент КАК Контрагент,
		|	ЗаявкаНаОперацию.ЦФО КАК ЦФО,
		|	ЗаявкаНаОперацию.БанковскийСчетКонтрагента КАК СчетКонтрагента,
		|	ЗаявкаНаОперацию.БанковскийСчетПолучатель КАК БанковскийСчетПолучатель,
		|	ЗаявкаНаОперацию.Договор КАК ДоговорКонтрагента,
		|	ЗаявкаНаОперацию.ДоговорАренды КАК ДоговорАренды,
		|	ЗаявкаНаОперацию.ДоговорКредитаДепозита КАК ДоговорКредитаДепозита,
		|	ЗаявкаНаОперацию.ДоговорЗаймаСотруднику КАК ДоговорЗаймаСотруднику,
		|	ЗаявкаНаОперацию.ФормаОплатыЗаявки КАК ФормаОплаты,
		|	ЗаявкаНаОперацию.ПеречислениеВБюджет КАК ПеречислениеВБюджет,
		|	ЗаявкаНаОперацию.РасшифровкаПлатежа.(
		|		НомерСтроки КАК НомерСтроки,
		|		ДоговорКонтрагента КАК ДоговорКонтрагента,
		|		СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|		ОбъектРасчетов.Соглашение.ИспользуютсяДоговорыКонтрагентов КАК ИспользуютсяДоговорыКонтрагентов,
		|		Партнер КАК Партнер
		|	) КАК ДвиженияОперации,
		|	ЗаявкаНаОперацию.СуммаДокумента КАК СуммаДокумента,
		|	ЗаявкаНаОперацию.Валюта КАК ВалютаДокумента,
		|	ЗНАЧЕНИЕ(Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
		|	ЗаявкаНаОперацию.ВидОперацииУХ КАК ВидОперацииУХ,
		|	ЗаявкаНаОперацию.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	ЗаявкаНаОперацию.ХозяйственнаяОперацияПоЗарплате КАК ХозяйственнаяОперацияПоЗарплате,
		|	ЗаявкаНаОперацию.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|	ЗаявкаНаОперацию.СписокФизЛиц КАК СписокФизЛиц,
		|	ЗаявкаНаОперацию.ЛицевыеСчетаСотрудников.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		ФизическоеЛицо КАК ФизическоеЛицо,
		|		ЛицевойСчет КАК ЛицевойСчет,
		|		Сумма КАК Сумма,
		|		СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
		|	) КАК ЛицевыеСчетаСотрудников,
		|	ЗаявкаНаОперацию.ПодотчетноеЛицо КАК ПодотчетноеЛицо,
		|	ЗаявкаНаОперацию.Партнер КАК Партнер,
		|	ЗаявкаНаОперацию.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаОперацию
		|ГДЕ
		|	ЗаявкаНаОперацию.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
		ДанныеДокумента = Запрос.Выполнить().Выгрузить()[0];
		
		Если ДанныеДокумента.ДвиженияОперации.Количество() <> 0
			И ДанныеДокумента.ДвиженияОперации[0].ИспользуютсяДоговорыКонтрагентов = Ложь Тогда
		    ИспользуютсяДоговорыКонтрагентов = Ложь;
		Иначе
			ИспользуютсяДоговорыКонтрагентов = Истина;		
		КонецЕсли;
				
		// Определение местонахождения статьи движения денежных средств
		МассивВсехРеквизитов = Новый Массив; МассивРеквизитовОперации = Новый Массив;
		Документы.ЗаявкаНаРасходованиеДенежныхСредств.ЗаполнитьИменаРеквизитовПоХозяйственнойОперацииУХ(
			ДанныеДокумента, МассивВсехРеквизитов, МассивРеквизитовОперации);
		
		//
		РеквизитыПроверяемыеНаЗаполнение = Новый СписокЗначений;
		РеквизитыПроверяемыеНаЗаполнение.Добавить("СуммаДокумента", НСтр("ru = 'Сумма документа'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("ВалютаДокумента", НСтр("ru = 'Валюта документа'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("ЦФО", НСтр("ru = 'ЦФО'"));
		РеквизитыПроверяемыеНаЗаполнение.Добавить("Организация", НСтр("ru = 'Организация'")); 
		
		ПроверятьДвиженияОперацииДоговорКонтрагента = Ложь;
		
		Если НЕ (ВидыОперацийУХКлиентСерверПовтИсп.ЭтоРасчетыБезДоговора(ДанныеДокумента.ВидОперацииУХ)
			ИЛИ ДанныеДокумента.ВидОперацииУХ = Справочники.ВидыОперацийУХ.ПриобретениеВалюты
			ИЛИ ДанныеДокумента.ВидОперацииУХ = Справочники.ВидыОперацийУХ.ПродажаВалюты) Тогда
			
			Если ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоКредитам
				ИЛИ ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеНаДепозиты
				ИЛИ ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаЗаймов Тогда
				
				РеквизитыПроверяемыеНаЗаполнение.Добавить("ДоговорКредитаДепозита", НСтр("ru = 'Договор кредита/депозита'"));
				
			ИначеЕсли ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаАрендодателю Тогда
				РеквизитыПроверяемыеНаЗаполнение.Добавить("ДоговорАренды", НСтр("ru = 'Договор аренды'"));
			ИначеЕсли ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаЗаймаСотруднику Тогда
				Если  МассивРеквизитовОперации.Найти("ДоговорЗаймаСотруднику") <> неопределено Тогда
					РеквизитыПроверяемыеНаЗаполнение.Добавить("ДоговорЗаймаСотруднику", НСтр("ru = 'Договор займа сотруднику'"));
				КонецЕсли;
			ИначеЕсли ИспользуютсяДоговорыКонтрагентов Тогда
				// РеквизитыПроверяемыеНаЗаполнение.Добавить("ДвиженияОперации.ДоговорКонтрагента", НСтр("ru = 'Договор контрагента'"));
				ПроверятьДвиженияОперацииДоговорКонтрагента = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// БанковскийСчетКонтрагента
		Если ДанныеДокумента.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная Тогда
			Если ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику 
				И ДанныеДокумента.СписокФизЛиц Тогда
			ИначеЕсли ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств
					ИЛИ ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаДенежныхСредствВДругуюОрганизацию
					ИЛИ ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствВДругуюОрганизацию Тогда
				РеквизитыПроверяемыеНаЗаполнение.Добавить("БанковскийСчетПолучатель", НСтр("ru = 'Банковский счет получатель'"));
			ИначеЕсли ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты
				И ДанныеДокумента.ХозяйственнаяОперацияПоЗарплате = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета Тогда
			Иначе
				РеквизитыПроверяемыеНаЗаполнение.Добавить("СчетКонтрагента", НСтр("ru = 'Банковский счет контрагента'"));
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ПроверяемыйРеквизит из РеквизитыПроверяемыеНаЗаполнение Цикл
			Если Не ЗначениеЗаполнено(ДанныеДокумента[ПроверяемыйРеквизит.Значение]) Тогда
				
				ПроверкаПройдена = Ложь;
				
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле","Заполнение",ПроверяемыйРеквизит.Представление);
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект." + ПроверяемыйРеквизит.Значение);
				
			КонецЕсли;
		КонецЦикла;  
		
		Если ПроверятьДвиженияОперацииДоговорКонтрагента Тогда
			Для каждого СтрокаДвижения Из ДанныеДокумента.ДвиженияОперации Цикл
				Если Не ЗначениеЗаполнено(СтрокаДвижения.ДоговорКонтрагента) Тогда
					ПроверкаПройдена = Ложь;
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле","Заполнение",НСтр("ru = 'Договор контрагента'"));
					УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект.ДвиженияОперации.ДоговорКонтрагента");
				КонецЕсли;
			КонецЦикла;		
		
		КонецЕсли;
		
		// Выдача денежных средств списку подотчетников. Должен быть заполнен список ЛицевыеСчетаСотрудников
		Если ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику Тогда
			Если ДанныеДокумента.СписокФизЛиц Тогда
				Если Не ДанныеДокумента.ЛицевыеСчетаСотрудников.Количество() Тогда
					ПроверкаПройдена = Ложь;
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список","Заполнение", ,,НСтр("ru = 'Лицевые счета сотрудников'"));
					УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект.ДвиженияОперации");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Проверяем заполненность статьи движения денежных средств
		Если МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств") <> Неопределено И НЕ ДанныеДокумента.СписокФизЛиц Тогда
			
			// Проверяеме заполненность ТЧ
			Если Не ДанныеДокумента.ДвиженияОперации.Количество() Тогда
				
				ПроверкаПройдена = Ложь;
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список","Заполнение", ,,НСтр("ru = 'Аналитики учета и планирования'"));
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект.ДвиженияОперации");
				
			КонецЕсли;
			
			// Проверяем заполненность статьи
			ПараметрыБюджета = ДвиженияБюджетированиеКлиентСерверУХ.ПараметрыБюджета(ДанныеДокумента.ВидБюджета);
			Для Каждого ТекСтрокаРасшифровки Из ДанныеДокумента.ДвиженияОперации Цикл
				// Проверка статьи бюджета.
				Если Не ЗначениеЗаполнено(ТекСтрокаРасшифровки[ПараметрыБюджета.КолонкаСтатья]) Тогда
					
					ПроверкаПройдена = Ложь;
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
						"Колонка",
						"Заполнение", 
						ПараметрыБюджета.ЗаголовокКолонкиСтатья, 
						ТекСтрокаРасшифровки.НомерСтроки,
						НСтр("ru = 'Аналитики учета и планирования'"));
					ИмяПоля = СтрШаблон("Объект.ДвиженияОперации[%1].%2", ТекСтрокаРасшифровки.НомерСтроки - 1, ПараметрыБюджета.КолонкаСтатья);
					
					УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, ИмяПоля);
					
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли НЕ ДанныеДокумента.СписокФизЛиц Тогда
			// Статья в шапке
			Если НЕ ЗначениеЗаполнено(ДанныеДокумента.СтатьяДвиженияДенежныхСредств)
					И Не (ДанныеДокумента.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты
					            И Не Константы.ИспользоватьНачислениеЗарплаты.Получить() ) Тогда
				// Проверяем заполненность статьи
				ПроверкаПройдена = Ложь;   
				
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Поле",	"Заполнение", НСтр("ru = 'Статья движения денежных средств'"),,,);
				
				УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(
					ПротоколОшибок, ОбъектСсылка, ТекстОшибки, "Объект.СтатьяДвиженияДенежныхСредств");
			КонецЕсли;
			
		Иначе 
			Для Каждого ТекСтрокаРасшифровки Из ДанныеДокумента.ЛицевыеСчетаСотрудников Цикл
				// Проверка статьи бюджета.
				Если Не ЗначениеЗаполнено(ТекСтрокаРасшифровки.СтатьяДвиженияДенежныхСредств) Тогда
					
					ПроверкаПройдена = Ложь;
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
						"Колонка",
						"Заполнение", 
						НСтр("ru = 'Статья движения денежных средств'"), 
						ТекСтрокаРасшифровки.НомерСтроки,
						НСтр("ru = 'Лицевые счета сотрудников'"));
					ИмяПоля = СтрШаблон("Объект.ЛицевыеСчетаСотрудников[%1].%2", ТекСтрокаРасшифровки.НомерСтроки - 1, "СтатьяДвиженияДенежныхСредств");
					
					УправлениеПроцессамиСогласованияУХКлиентСервер.ДобавитьОшибкуУстановкиСтатусаОбъекта(ПротоколОшибок, ОбъектСсылка, ТекстОшибки, ИмяПоля);
					
				КонецЕсли;
				
			КонецЦикла;
			

		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПроверкаПройдена;
	
КонецФункции

Функция ПлатежЗапрещенДирективно(ЗаявкаСсылка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаОперациюДвиженияОперации.СтатьяДвиженияДенежныхСредств,
	|	ЗаявкаНаОперациюДвиженияОперации.Ссылка.Организация,
	|	ЗаявкаНаОперациюДвиженияОперации.Ссылка.Контрагент,
	|	ЗаявкаНаОперациюДвиженияОперации.Ссылка.Договор КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(РазмещениеЗаявок.БанковскийСчетКасса, Неопределено) КАК СчетОрганизации
	|ПОМЕСТИТЬ ВТ_ДанныеПлатежа
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК ЗаявкаНаОперациюДвиженияОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|		ПО ЗаявкаНаОперациюДвиженияОперации.Ссылка = РазмещениеЗаявок.ЗаявкаНаОперацию
	|			И РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|ГДЕ
	|	ЗаявкаНаОперациюДвиженияОперации.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА РазрешенияИЗапретыПлатежей.Запрет
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК ЕстьЗапрет,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА РазрешенияИЗапретыПлатежей.Запрет
	|					ТОГДА 0
	|				ИНАЧЕ 1
	|			КОНЕЦ), 0) КАК ЕстьРазрешение
	|ИЗ
	|	ВТ_ДанныеПлатежа КАК ВТ_ДанныеПлатежа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РазрешенияИЗапретыПлатежей КАК РазрешенияИЗапретыПлатежей
	|		ПО (ВТ_ДанныеПлатежа.СтатьяДвиженияДенежныхСредств = РазрешенияИЗапретыПлатежей.СтатьяДвиженияДенежныхСредств
	|				ИЛИ РазрешенияИЗапретыПлатежей.СтатьяДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка))
	|			И (ВТ_ДанныеПлатежа.Организация = РазрешенияИЗапретыПлатежей.Организация
	|				ИЛИ РазрешенияИЗапретыПлатежей.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|			И (ВТ_ДанныеПлатежа.Контрагент = РазрешенияИЗапретыПлатежей.Контрагент
	|				ИЛИ РазрешенияИЗапретыПлатежей.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|			И (ВТ_ДанныеПлатежа.ДоговорКонтрагента = РазрешенияИЗапретыПлатежей.ДоговорКонтрагента
	|				ИЛИ РазрешенияИЗапретыПлатежей.ДоговорКонтрагента  В (&ПустыеДоговорыКонтрагентов))
	|			И (ВТ_ДанныеПлатежа.СчетОрганизации = РазрешенияИЗапретыПлатежей.СчетОрганизации
	|				ИЛИ РазрешенияИЗапретыПлатежей.СчетОрганизации = Неопределено)";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаСсылка);
	ПустыеДоговорыКонтрагентов = Новый Массив;
	ПустыеДоговорыКонтрагентов.Добавить(Неопределено);
	ПустыеДоговорыКонтрагентов.Добавить(Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	ПустыеДоговорыКонтрагентов.Добавить(Справочники.ДоговорыКредитовИДепозитов.ПустаяСсылка());
	ПустыеДоговорыКонтрагентов.Добавить(Справочники.ДоговорыАренды.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустыеДоговорыКонтрагентов", ПустыеДоговорыКонтрагентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат (Выборка.ЕстьЗапрет > 0 И Выборка.ЕстьРазрешение = 0);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы <> "ФормаВыбора" Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("ВыбиратьПозицию") Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = Метаданные.Обработки.РаботаСЗаявкамиНаОперации.Формы.ФормаПодбораЗаявок;
	КонецЕсли;

КонецПроцедуры

//
//Процедура ПолучитьМассивыРеквизитовУХ(ХозяйственнаяОперация, ПеречислениеВБюджет, СписокФизЛиц, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт	
Процедура ЗаполнитьИменаРеквизитовПоХозяйственнойОперацииУХ(Объект, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт
	
	ЗаполнитьИменаРеквизитовПоХозяйственнойОперации(Объект, МассивВсехРеквизитов, МассивРеквизитовОперации);
	
	// Выдача денежных средств списку подотчетников. Должен быть заполнен список ЛицевыеСчетаСотрудников
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику Тогда
			
		Если Объект.СписокФизЛиц Тогда
			// Нет статьи в расшифровке платежа. Удаляем ее из расшифровки
			МассивРеквизитовОперации.Удалить(МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств"));
			МассивРеквизитовОперации.Удалить(МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.Аналитика1"));
			МассивРеквизитовОперации.Удалить(МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.Аналитика2"));
			МассивРеквизитовОперации.Удалить(МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.Аналитика3"));
			МассивРеквизитовОперации.Удалить(МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.Аналитика4"));
			МассивРеквизитовОперации.Удалить(МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.Аналитика5"));
			МассивРеквизитовОперации.Удалить(МассивРеквизитовОперации.Найти("РасшифровкаПлатежа.Аналитика6"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РеквизитыЗаявки(РеквизитыЗаявки) Экспорт
	
	ОМ = ЗаявкиНаОперации;
	
	//
	РеквизитыЗаявки.Параметры.Вставить("ПланируемаяДатаОперацииВФорме", Истина);
	
	// Элементы ДоговорКонтрагента
	ЭлементыДоговор = РеквизитыЗаявки.Параметры.Элементы["ДоговорКонтрагента"];
	Если ЭлементыДоговор <> неопределено И ТипЗнч(ЭлементыДоговор) = Тип("Массив") Тогда
		ЭлементыДоговор.Очистить();
		ЭлементыДоговор.Добавить("Договор");
	КонецЕсли;

	РеквизитыЗаявки.ВидБюджетаПВХ= ОМ.Новый_ЗначениеРеквизита("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств");
	РеквизитыЗаявки.ВидБюджета = ОМ.Новый_ЗначениеРеквизита("Перечисление.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств");
	
	РеквизитыЗаявки.БанковскийСчет = ОМ.Новый_Реквизит("БанковскийСчет");
	РеквизитыЗаявки.Касса = ОМ.Новый_Реквизит("Касса");
	РеквизитыЗаявки.ФормаОплаты = ОМ.Новый_Реквизит("ФормаОплатыЗаявки");
	РеквизитыЗаявки.ВалютаДокумента = ОМ.Новый_Реквизит("Валюта");
	РеквизитыЗаявки.ВалютаКонвертации = ОМ.Новый_Реквизит("ВалютаКонвертации");
	РеквизитыЗаявки.ВалютаОплаты = ОМ.Новый_Реквизит("ВалютаОплаты");
	РеквизитыЗаявки.ДоговорКонтрагента = ОМ.Новый_Реквизит("Договор");
	РеквизитыЗаявки.БанковскийСчетКонтрагента = ОМ.Новый_Реквизит("БанковскийСчетКонтрагента");
	РеквизитыЗаявки.ПриходРасход = ОМ.Новый_ЗначениеРеквизита("Перечисление.ВидыДвиженийПриходРасход.Расход");
	РеквизитыЗаявки.ПриходРасходСтатьяДвиженияДенежныхСредствЗачисление = ОМ.Новый_ЗначениеРеквизита("Перечисление.ВидыДвиженийПриходРасход.Приход");
	РеквизитыЗаявки.ПриходРасходСтатьяДвиженияДенежныхСредств 			= ОМ.Новый_ЗначениеРеквизита("Перечисление.ВидыДвиженийПриходРасход.Расход");
	РеквизитыЗаявки.Ответственный = ОМ.Новый_Реквизит("Автор");
	РеквизитыЗаявки.ПланируемаяДатаОперации = ОМ.Новый_Реквизит("ЖелательнаяДатаПлатежа");
	РеквизитыЗаявки.ДокументПланирования = ОМ.Новый_Реквизит("ДокументПланирования"); 
	РеквизитыЗаявки.ПодотчетноеЛицо = ОМ.Новый_Реквизит("ПодотчетноеЛицо");
	
	// ВГО
	РеквизитыЗаявки.КонтрагентОрганизации = ОМ.Новый_Реквизит("КонтрагентПлательщик");		// Контрагент, которому соответствуеторганизация
	РеквизитыЗаявки.ОрганизацияВстречная = ОМ.Новый_Реквизит("ОрганизацияПолучатель");		// Организация, соответствующая контрагенту
	РеквизитыЗаявки.БанковскийСчетОрганизацииВстречной = ОМ.Новый_Реквизит("БанковскийСчетПолучатель");	// Банковский счет, соответствующий счету контрагента
	РеквизитыЗаявки.БанковскийСчетПолучатель = ОМ.Новый_Реквизит("БанковскийСчетПолучатель"); // Банковский счет, на который произодится зачисление (купля/продажа валюты).
	РеквизитыЗаявки.КассаПолучатель = ОМ.Новый_Реквизит("КассаПолучатель");
	РеквизитыЗаявки.ДоговорВстречный = ОМ.Новый_Реквизит("ДоговорКонтрагентаПолучатель");	// Договор, соответствующий выбранному договору с контрагентом
	РеквизитыЗаявки.ЭтоВнутригрупповоеПеремещение = ОМ.Новый_Реквизит("ЭтоВнутригрупповоеПеремещение");
	РеквизитыЗаявки.КурсКонвертации = ОМ.Новый_Реквизит("КурсКонвертации");
	РеквизитыЗаявки.КратностьКонвертации = ОМ.Новый_Реквизит("КратностьКонвертации");
	
	// Аналитики
	ОМ.Изменить_Реквизит(РеквизитыЗаявки.СтатьяБюджета, "СтатьяДвиженияДенежныхСредств", "РасшифровкаПлатежа");
	ОМ.Изменить_Реквизит(РеквизитыЗаявки.СтатьяБюджетаСписания, "СтатьяДвиженияДенежныхСредств");
	ОМ.Изменить_Реквизит(РеквизитыЗаявки.СтатьяБюджетаЗачисления, "СтатьяДвиженияДенежныхСредствЗачисление"); 
	ОМ.Изменить_Реквизит(РеквизитыЗаявки.СтатьяБюджетаЛицевойСчет, "СтатьяДвиженияДенежныхСредств", "ЛицевыеСчетаСотрудников");
	
	Для Сч = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		ОМ.Изменить_Реквизит(РеквизитыЗаявки["Аналитика"			+Сч], "Аналитика"+Сч, "РасшифровкаПлатежа");
		ОМ.Изменить_Реквизит(РеквизитыЗаявки["АналитикаСписания"	+Сч], "АналитикаСписания"+Сч);
		ОМ.Изменить_Реквизит(РеквизитыЗаявки["АналитикаЗачисления"	+Сч], "АналитикаЗачисления"	+Сч);  
		ОМ.Изменить_Реквизит(РеквизитыЗаявки["Аналитика"			+Сч], "Аналитика"+Сч, "ЛицевыеСчетаСотрудников");
	КонецЦикла;
	
	// Регистрируем параметры размещения аналитик статей бюджетов
	ЗаявкиНаОперации.РазместитьВКолонкахТаблицы(
		РеквизитыЗаявки, "РасшифровкаПлатежа", 
		РеквизитыЗаявки.СтатьяБюджета, "РасшифровкаПлатежаСтатьяДвиженияДенежныхСредств",
		"Аналитика%1", "РасшифровкаПлатежаАналитика%1",
		ФормыУХ.РазместитьПередЭлементом("РасшифровкаПлатежаСумма", "РасшифровкаПлатежа")
	);
	
	ЗаявкиНаОперации.РазместитьВПоляхФормы(
		РеквизитыЗаявки, "РасшифровкаПлатежа",
		РеквизитыЗаявки.СтатьяБюджета, "РасшифровкаБезРазбиенияСтатьяДвиженияДенежныхСредств",
		"Аналитика%1", "РасшифровкаБезРазбиенияАналитика%1",
		ФормыУХ.РазместитьПередЭлементом("РасшифровкаБезРазбиенияПодразделение", "РасшифровкаБезРазбиения")
	);
	
	ЗаявкиНаОперации.РазместитьВПоляхФормы(
		РеквизитыЗаявки, ,
		РеквизитыЗаявки.СтатьяБюджетаСписания, "СтатьяДвиженияДенежныхСредств",
		"Аналитика%1", "АналитикаШапка%1",
		ФормыУХ.РазместитьВГруппеСтрокой("ГруппаАналитикиБюджетаЛевая")
	);
	
	ЗаявкиНаОперации.РазместитьВПоляхФормы(
		РеквизитыЗаявки, ,
		РеквизитыЗаявки.СтатьяБюджетаЗачисления, "СтатьяДвиженияДенежныхСредствЗачисление",
		"АналитикаЗачисления%1", "АналитикаЗачисления%1",
		ФормыУХ.РазместитьВГруппеСтрокой("ГруппаАналитикиБюджетаПравая")
	);

	ЗаявкиНаОперации.РазместитьВКолонкахТаблицы(
		РеквизитыЗаявки, "ЛицевыеСчетаСотрудников", 
		РеквизитыЗаявки.СтатьяБюджетаЛицевойСчет, "ЛицевыеСчетаСотрудниковСтатьяДвиженияДенежныхСредств",
		"Аналитика%1", "ЛицевыеСчетаСотрудниковАналитика%1",
		ФормыУХ.РазместитьПередЭлементом("ЛицевыеСчетаСотрудниковРастяжка", "ЛицевыеСчетаСотрудников")
	);  
	
КонецПроцедуры

// Функция возвращает таблицу операций заявки для формирования платежной позиции
Функция ПолучитьДвиженияОперацииДокументаДляПлатежнойПозиции(ЗаявкаСсылка) экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ЗаявкаСсылка); 
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", 				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаСсылка, "ХозяйственнаяОперация"));
    Запрос.УстановитьПараметр("ХозОперацииБезРасшифровки", 			ХозОперацииБезРасшифровки());
	Запрос.УстановитьПараметр("ХозОперацияЗарплата", 				Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты);
	Запрос.УстановитьПараметр("ХозОперацияВыплатаНаЛицевыеСчета", 	Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета);
	Запрос.УстановитьПараметр("ХозОперацияВыдачаДенежныхСредствПодотчетнику", 	Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику);
	Запрос.УстановитьПараметр("ИспользоватьНачислениеЗарплатыУТ", 	Константы.ИспользоватьНачислениеЗарплаты.Получить());
    Запрос.Текст = 
	"ВЫБРАТЬ 
	|	0 КАК НомерЗапроса,
