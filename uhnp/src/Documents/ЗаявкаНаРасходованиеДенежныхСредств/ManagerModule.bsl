	Запрос.УстановитьПараметр("НаправлениеДвиженияЗачисления", Перечисления.ВидыДвиженийПриходРасход.Приход);
	
	КурсЗаданВОперации = (Не Источник.Валюта = Источник.ВалютаОплаты);
	Запрос.УстановитьПараметр("КурсЗаданВОперации",	КурсЗаданВОперации); 	

	ИменаРеквизитов = "Дата, ВидОперацииУХ, Организация, Контрагент, ДоговорКонтрагента, ОплатаПоДоговоруПоставки, ХозяйственнаяОперацияПоЗарплате,"
			+ "ЖелательнаяДатаПлатежа, ДатаЗачисления, Валюта, ВалютаОплаты, ВалютаКонвертации, СуммаКонвертации, СуммаДокумента,"
			+ "ЦФО, Проект, ДокументПланирования, СтатьяДвиженияДенежныхСредствЗачисление,СтатьяДвиженияДенежныхСредств,КурсПлатежа, КратностьПлатежа, ДокументОснование,СписокФизЛиц,"
			+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("АналитикаЗачисления%1")+","
			+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
	
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, ИменаРеквизитов);
	Иначе
		РеквизитыДокумента = Источник;
		
		//Заполним ДоговорКонтрагента для новой заявки
		Если Источник.Ссылка.Пустая() Тогда
			ВидДоговора = ВстраиваниеУХЗаявкаНаРасходованиеДенежныхСредств.ИмяРеквизитаДоговора(Источник);
			Если ЗначениеЗаполнено(ВидДоговора) Тогда	
				РеквизитыДокумента.ДоговорКонтрагента = Источник[ВидДоговора];
			КонецЕсли;
		КонецЕсли;
		
		ИменаРеквизитовТЧ = "ОбъектРасчетов, ЦФО, Проект, Сумма,  СтатьяДвиженияДенежныхСредств," 
						+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1");
		
		РасшифровкаПлатежа = Источник.РасшифровкаПлатежа.Выгрузить(,ИменаРеквизитовТЧ);
		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ПустаяСсылка())));
		РасшифровкаПлатежа.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		РасшифровкаПлатежа.ЗаполнитьЗначения(Источник.Ссылка, "Ссылка");
		
		Запрос.УстановитьПараметр("РасшифровкаПлатежа", РасшифровкаПлатежа);
