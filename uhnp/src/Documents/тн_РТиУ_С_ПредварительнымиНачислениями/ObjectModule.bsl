#Область ОбработчикиСобытий

// Белоконенко Денис 23.10.2023 Выполнение задач №000047250
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ОписаниеОшибки", "");
	
	ДополнительныеРеквизиты = ХранилищеДополнительныхРеквизитов.Получить();
	Если ДополнительныеРеквизиты.Свойство("ПропуститьПроверкуЗапретаИзменения") Тогда
		ДополнительныеРеквизиты.Удалить("ПропуститьПроверкуЗапретаИзменения");
	КонецЕсли;
	
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка);	
	
	// 1. Реализация
	Если ЗначениеЗаполнено(СтруктураДокументы.Реализация) Тогда
		РеализацияОб = СтруктураДокументы.Реализация.ПолучитьОбъект();
	Иначе
				
		РеализацияСсылка = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Ссылка.УникальныйИдентификатор());
		
		РеализацияОб = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		РеализацияОб.УстановитьСсылкуНового(РеализацияСсылка);
	КонецЕсли;
	
	// Шапка      	
	ЗаполнитьЗначенияСвойств(РеализацияОб, ЭтотОбъект);
	Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл
		РеализацияОб.ДополнительныеСвойства.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);		
	КонецЦикла;
	РеализацияОб.тн_РТиУ_С_ПредварительнымиНачислениями = Ссылка;
	
	// ТЧ Товары
	РеализацияОб.Товары.Очистить();
	Для Каждого Стр Из ЭтотОбъект.Товары Цикл
		НоваяСтрока = РеализацияОб.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	
	Документы.РеализацияТоваровУслуг.ДозаполнитьОбъект(РеализацияОб, Отказ, Результат);
	
	РеализацияОб.Записать(РежимЗаписиДокумента.Проведение);       
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
	// НАЧАЛО Егоров Петр 10.06.2025 Выполнение задач №000054028
	//РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(РеализацияОб.Ссылка);   
	РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(Ссылка,Ссылка.Организация,Ссылка.Дата);
	// КОНЕЦ Егоров Петр 10.06.2025 Выполнение задач №000054028
	// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699 
	
	// 2. Расход
	Если ЗначениеЗаполнено(СтруктураДокументы.Расход) Тогда
		РасходОб = СтруктураДокументы.Расход.ПолучитьОбъект();
	Иначе
				
		РасходСсылка = Документы.ПрочиеДоходыРасходы.ПолучитьСсылку(Ссылка.УникальныйИдентификатор());
		
		РасходОб = Документы.ПрочиеДоходыРасходы.СоздатьДокумент();
		РасходОб.УстановитьСсылкуНового(РасходСсылка);
	КонецЕсли;
	
	// Шапка      	
	ЗаполнитьЗначенияСвойств(РасходОб, ЭтотОбъект);
	Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл 
		Если ДопРеквизит.Ключ = "OperationType" Тогда
			Продолжить;
		ИначеЕсли ДопРеквизит.Ключ = "operationTypeOtherIncome" Тогда
			Ключ = "operationType";
		ИначеЕсли ДопРеквизит.Ключ = "recipientOrganizationINNOtherIncome" Тогда
			Ключ = "recipientOrganizationINN";
		ИначеЕсли ДопРеквизит.Ключ = "recipientOrganizationKPPOtherIncome" Тогда
			Ключ = "recipientOrganizationKPP";
		Иначе
			Ключ = ДопРеквизит.Ключ;
		КонецЕсли;
		
		РасходОб.ДополнительныеСвойства.Вставить(Ключ, ДопРеквизит.Значение);		
	КонецЦикла;
	РасходОб.тн_РТиУ_С_ПредварительнымиНачислениями = Ссылка;
	
	// ТЧ ПрочиеРасходы
	РасходОб.ПрочиеРасходы.Очистить();
	Для Каждого Стр Из ЭтотОбъект.ПрочиеРасходы Цикл
		НоваяСтрока = РасходОб.ПрочиеРасходы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	
	Документы.ПрочиеДоходыРасходы.ДозаполнитьОбъект(РасходОб, Отказ, Результат);
	
	РасходОб.Записать(РежимЗаписиДокумента.Проведение);
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699
	// НАЧАЛО Егоров Петр 10.06.2025 Выполнение задач №000054028
	//РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(РасходОб.Ссылка);
	РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.ЗарегистрироватьДокументКакЗагруженный(Ссылка,Ссылка.Организация,Ссылка.Дата);
	// КОНЕЦ Егоров Петр 10.06.2025 Выполнение задач №000054028
	// КОНЕЦ Юдина (Гутарова) Екатерина 04.09.2024 Выполнение задач №000050699

КонецПроцедуры

// Белоконенко Денис 23.10.2023 Выполнение задач №000047250
Процедура ОбработкаУдаленияПроведения(Отказ)
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка); 
			
	// 1. Реализация
	Если ЗначениеЗаполнено(СтруктураДокументы.Реализация) И СтруктураДокументы.Реализация.Проведен Тогда
		РеализацияОб = СтруктураДокументы.Реализация.ПолучитьОбъект();
		РеализацияОб.Записать(РежимЗаписиДокумента.ОтменаПроведения);		
	КонецЕсли;
		 	
	// 2. Расход
	Если ЗначениеЗаполнено(СтруктураДокументы.Расход) И СтруктураДокументы.Расход.Проведен Тогда
		РасходОб = СтруктураДокументы.Расход.ПолучитьОбъект();
		РасходОб.Записать(РежимЗаписиДокумента.ОтменаПроведения);		
	КонецЕсли;
	
КонецПроцедуры

// Белоконенко Денис 23.10.2023 Выполнение задач №000047250
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураДокументы = НайтиСвязанныеДокументы(Ссылка);
	
	Если ЭтотОбъект.ПометкаУдаления Тогда
		// Установка пометки удаления	
		// 1. Реализация
		Если ЗначениеЗаполнено(СтруктураДокументы.Реализация) И Не СтруктураДокументы.Реализация.ПометкаУдаления Тогда
			РеализацияОб = СтруктураДокументы.Реализация.ПолучитьОбъект();
			РеализацияОб.УстановитьПометкуУдаления(Истина)
		КонецЕсли;
			 	
		// 2. Расход
		Если ЗначениеЗаполнено(СтруктураДокументы.Расход) И Не СтруктураДокументы.Расход.ПометкаУдаления Тогда
			РасходОб = СтруктураДокументы.Расход.ПолучитьОбъект();
			РасходОб.УстановитьПометкуУдаления(Истина);		
		КонецЕсли;
	Иначе 
		// Снятие пометки удаления
		// 1. Реализация
		Если ЗначениеЗаполнено(СтруктураДокументы.Реализация) И СтруктураДокументы.Реализация.ПометкаУдаления Тогда
			РеализацияОб = СтруктураДокументы.Реализация.ПолучитьОбъект();
			РеализацияОб.УстановитьПометкуУдаления(Ложь)
		КонецЕсли;
			 	
		// 2. Расход
		Если ЗначениеЗаполнено(СтруктураДокументы.Расход) И СтруктураДокументы.Расход.ПометкаУдаления Тогда
			РасходОб = СтруктураДокументы.Расход.ПолучитьОбъект();
			РасходОб.УстановитьПометкуУдаления(Ложь);		
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Белоконенко Денис 23.10.2023 Выполнение задач №000047250
Функция НайтиСвязанныеДокументы(РТиУ_С_ПредварительнымиНачислениями)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслуг.Ссылка КАК Реализация,
		|	NULL КАК Расход
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.тн_РТиУ_С_ПредварительнымиНачислениями = &тн_РТиУ_С_ПредварительнымиНачислениями
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	ПрочиеДоходыРасходы.Ссылка
		|ИЗ
		|	Документ.ПрочиеДоходыРасходы КАК ПрочиеДоходыРасходы
		|ГДЕ
		|	ПрочиеДоходыРасходы.тн_РТиУ_С_ПредварительнымиНачислениями = &тн_РТиУ_С_ПредварительнымиНачислениями";
	
	Запрос.УстановитьПараметр("тн_РТиУ_С_ПредварительнымиНачислениями", РТиУ_С_ПредварительнымиНачислениями);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДокументов = РезультатЗапроса.Выбрать();
	
	СтруктураДокументы = Новый Структура;
	СтруктураДокументы.Вставить("Реализация", Документы.РеализацияТоваровУслуг.ПустаяСсылка());
	СтруктураДокументы.Вставить("Расход", Документы.ПрочиеДоходыРасходы.ПустаяСсылка());
		
	Пока ВыборкаДокументов.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДокументов.Реализация) Тогда
			СтруктураДокументы.Реализация = ВыборкаДокументов.Реализация;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДокументов.Расход) Тогда
			СтруктураДокументы.Расход = ВыборкаДокументов.Расход;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураДокументы;
КонецФункции

#КонецЕсли