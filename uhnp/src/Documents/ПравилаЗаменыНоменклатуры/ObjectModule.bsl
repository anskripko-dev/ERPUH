#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПроведения(Отказ, РежимПроведения)        
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Движения") Тогда
		ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Загрузить(ЭтотОбъект.ДополнительныеСвойства.Движения);
		Для Каждого Движение Из ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок Цикл    
			Движение.Активность = Истина; 
		КонецЦикла; 
		ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Записывать = Истина;
		ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Записать(); 
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьДвиженияДокумента()
	
	Перем Запись, НастройкаЗамены, НастройкаЗаменыНоменклатурыЗакупок;
	
	НастройкаЗаменыНоменклатурыЗакупок = ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Выгрузить();   
	НастройкаЗаменыНоменклатурыЗакупок.Очистить();
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаменаНаУнификаты") Тогда   
		Для Каждого НастройкаЗамены Из ЭтотОбъект.ДополнительныеСвойства.ЗаменаНаУнификаты Цикл   
			Запись = НастройкаЗаменыНоменклатурыЗакупок.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, НастройкаЗамены);      
			Запись.Активность = Истина;     
			Запись.Период = ЭтотОбъект.Дата;
			Запись.Регистратор = ЭтотОбъект.Ссылка;
			Запись.СпособЗамены = Перечисления.СпособыЗаменыНоменклатуры.Унификат;
		КонецЦикла;
	КонецЕсли;   
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаменаНаАналоги") Тогда   
		Для Каждого НастройкаЗамены Из ЭтотОбъект.ДополнительныеСвойства.ЗаменаНаАналоги Цикл   
			Запись = НастройкаЗаменыНоменклатурыЗакупок.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, НастройкаЗамены);      
			Запись.Активность = Истина;     
			Запись.Период = ЭтотОбъект.Дата;
			Запись.Регистратор = ЭтотОбъект.Ссылка;
			Запись.СпособЗамены = Перечисления.СпособыЗаменыНоменклатуры.Аналоги;
		КонецЦикла;
	КонецЕсли;    
	ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Загрузить(НастройкаЗаменыНоменклатурыЗакупок);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ЭтотОбъект.Автор = Пользователи.АвторизованныйПользователь();   
	ЭтотОбъект.Дата = ТекущаяДата();
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	ЗаполнитьДвиженияДокумента();
	Для Каждого Движение Из ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок Цикл    
		Движение.Активность = Ложь; 
	КонецЦикла;                                  
	ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Записывать = Истина;
	ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Записать(); 
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Движения", ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Выгрузить());
КонецПроцедуры         

Процедура ОбработкаУдаленияПроведения(Отказ)
	ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Прочитать();   
	Для Каждого Движение Из ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок Цикл    
		Движение.Активность = Ложь; 
	КонецЦикла;     
	ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Записывать = Истина;
	ЭтотОбъект.Движения.НастройкаЗаменыНоменклатурыЗакупок.Записать();
КонецПроцедуры

