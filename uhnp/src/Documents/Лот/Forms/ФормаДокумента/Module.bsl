// Проверяем целостность лота с точки зрения пользовательской логики.
// Клиентский вариант.
//
// Возвращает:
//	тип устанавливается из функции
//		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю().
//	Если Неопределено - то ошибок нет.
//	Иначе занчение можно передать в функцию
//			ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю().
//
&НаКлиенте
Функция ПроверкаЗаполненияПередЗаписьюНаКлиенте()
	ОшибкиПользователю = Неопределено;             
	ЦентрализованныеЗакупкиКлиентСерверУХ.ХарактеристикиЗаполненыКорректно(
		ПотребностиПоГодам,	"Элементы.ПотребностиПоГодам", "Характеристика", "ХарактеристикиИспользуются", ОшибкиПользователю);
	
	Для Каждого ТекПотребностиПоГодам Из ПотребностиПоГодам Цикл
		ПроверитьОшибкуЗаполнения(ТекПотребностиПоГодам.Организация, "Объект.Номенклатура", 
			НСтр("ru = 'Необходимо указать организацию в таблице Потребности. Запись отменена.'"), ОшибкиПользователю);
		//ПроверитьОшибкуЗаполнения(ТекПотребностиПоГодам.Приоритет, "Объект.Номенклатура", 
		//	НСтр("ru = 'Необходимо указать приоритет в таблице Потребности. Запись отменена.'"), ОшибкиПользователю);
		ПроверитьОшибкуЗаполнения(ТекПотребностиПоГодам.Сумма, "Объект.Номенклатура", 
			НСтр("ru = 'В таблице Потребности не указана итоговая сумма. Запись отменена.'"), ОшибкиПользователю);	
	КонецЦикла;		
	Возврат ОшибкиПользователю;
КонецФункции

// Проверяет заполнение значение ЗначениеВход. В случае незаполненного записывает в
// МассивОшибокИзм текст ошибки ТекстОшибкиВход для поля ПолеВход.
&НаКлиенте
Процедура ПроверитьОшибкуЗаполнения(ЗначениеВход, ПолеВход, ТекстОшибкиВход, МассивОшибокИзм)
	Если НЕ ЗначениеЗаполнено(ЗначениеВход) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			МассивОшибокИзм, ПолеВход, ТекстОшибкиВход, Неопределено);
	Иначе
		// Проверка пройдена успешно.
	КонецЕсли;
КонецПроцедуры

// Обновляет на форме флаги закупки по организации.
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьФлагиОрганизации(Форма)
	СтруктураФлагов = ПолучитьСтруктуруФлаговОрганизации(Форма.Объект.ОрганизацияДляЗаключенияДоговора);
	Форма.флФЗ223 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураФлагов, "ФЗ223", Ложь);
КонецПроцедуры		// ОбновитьФлагиОрганизации()

&НаКлиенте
Процедура ОбработкаВыбораПотребностей(ВыборПотребности, ФормаВыбора) Экспорт
	Если ТипЗнч(ВыборПотребности) = Тип("Строка") Тогда    
		Модифицированность = Истина;
		РезультатОбработкиВыбора = ОбработкаВыбораПотребностейНаСервере(ВыборПотребности, "ВыбранныеПотребностиВНоменклатуре");
		ДатаОбъявления = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ЗакупочнаяПроцедура,"ДатаОфициальногоОбъявленияЗакупки");
		Если РезультатОбработкиВыбора Тогда
			Оповестить("ЗакрытьПодчиненнуюФорму", "ПодборПотребностейИзПлана", ЭтаФорма);
		Иначе
		КонецЕсли; 
	ИначеЕсли ТипЗнч(ВыборПотребности) = Тип("Структура") Тогда	
		ПересчетЦенНМЦ(ВыборПотребности); 
	Иначе
		ТекстСообщения = НСтр("ru = 'Неизвестный варинт таблицы расшифровки: %АдресТаблицы%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%АдресТаблицы%", Строка(ВыборПотребности));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПересчетЦенНМЦ(Структура)
	
	Отбор = Новый Структура();
	Отбор.Вставить("Номенклатура",Структура.Номенклатура);
	Отбор.Вставить("Характеристика",Структура.Характеристика);
	Отбор.Вставить("ЕдиницаИзмерения",Структура.ЕдиницаИзмерения);
	Отбор.Вставить("МестоПоставки",Структура.МестоПоставки);
	Отбор.Вставить("Коэффициент",Структура.Коэффициент);  
	СтруктураПоиска = Новый Структура();
    СтруктураПоиска.Вставить("Номенклатура"); 
    СтруктураПоиска.Вставить("Характеристика");
    СтруктураПоиска.Вставить("ЕдиницаИзмерения");
    СтруктураПоиска.Вставить("МестоПоставки");
    СтруктураПоиска.Вставить("Коэффициент");
	
	Для Каждого Строка ИЗ ПотребностиПоПериодуРасшифровка Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,Строка);
		Если ОбщегоНазначенияУХ.СравнитьСтруктурыЗначений(СтруктураПоиска,Отбор) Тогда
			Строка.Цена =  Структура.Цена;
			Строка.ЦенаПервоначальная = Структура.Цена;
			Строка.Сумма = Строка.Количество * Структура.Цена;
		КонецЕсли;	
	КонецЦикла;	
	ЗаполнитьДерево(Истина);   
	ПересчетОтносительногоОтклоненияЦен(,ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеИзменениеТоварнойКатегории_Завершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПотребностиПоГодам.Очистить();
		НоваяТоварнаяКатегория = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "ТоварнаяКатегория", ПредопределенноеЗначение("Справочник.ТоварныеКатегории.ПустаяСсылка"));
		Объект.ТоварнаяКатегория = НоваяТоварнаяКатегория;
		Модифицированность = Истина;
	Иначе
		// Пользователь отказался.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборТоварнойКатегории_Завершение(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	Если ЗначениеВыбора <> Неопределено Тогда
		Объект.ТоварнаяКатегория = ЗначениеВыбора.Значение;
		Модифицированность = Истина;
	Иначе
		// Ничего не выбрано.
	КонецЕсли;	
КонецПроцедуры		// ВыборТоварнойКатегории_Завершение()


#КонецОбласти


#Область СлужебныеПроцедурыНаСервере

&НаСервере
Процедура ЗаполнитьОбоснованиеНоменклатуры() 
	
	НоменклатураПотребностей = Объект.Номенклатура.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"); 
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НоменклатураПотребностей, ЭтотОбъект.ПотребностиПоГодам.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"), Истина); 
	СоответствиеПараметров = РегистрыСведений.ПараметрыПреференцийОКПД2.ПреференцииКодовПоНоменклатуре(Объект.Дата, НоменклатураПотребностей);
	
	Для Каждого Строка ИЗ Объект.Номенклатура Цикл
		Строка.ОбоснованиеНациональногоРежима = "";
		Отбор = Новый Структура();
		Отбор.Вставить("Номенклатура", Строка.Номенклатура);
		Обоснование = Объект.ОбоснованияИсключенияНациональногоРежима.НайтиСтроки(Отбор);
		Для Каждого Строки ИЗ Обоснование Цикл
			Если ЗначениеЗаполнено(Строки.Исключение) Тогда
				Строка.ОбоснованиеНациональногоРежима = Строки.Исключение;
			КонецЕсли;
		КонецЦикла; 
		
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда 
			ПараметрыЗакупки				= СоответствиеПараметров.Получить(Строка.Номенклатура);   
			Если ЗначениеЗаполнено(ПараметрыЗакупки) Тогда
				Строка.ОКПД2 					= ПараметрыЗакупки.КодОКПД2;   
				Строка.НациональныйРежимЗакупок = ПараметрыЗакупки.НациональныйРежимЗакупок;          
			Иначе
				Строка.НациональныйРежимЗакупок = Перечисления.НациональныйРежимЗакупок.НеИспользовать;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;  
	
	Для Каждого Строка ИЗ ЭтотОбъект.ПотребностиПоГодам Цикл
		Строка.ОбоснованиеНациональногоРежима = "";
		Отбор = Новый Структура();
		Отбор.Вставить("Номенклатура", Строка.Номенклатура);
		Обоснование = Объект.ОбоснованияИсключенияНациональногоРежима.НайтиСтроки(Отбор);
		Для Каждого Строки ИЗ Обоснование Цикл
			Если ЗначениеЗаполнено(Строки.Исключение) Тогда
				Строка.ОбоснованиеНациональногоРежима = Строки.Исключение;
			КонецЕсли;
		КонецЦикла;  
		
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда 
			ПараметрыЗакупки 				= СоответствиеПараметров.Получить(Строка.Номенклатура);  
			Если ЗначениеЗаполнено(ПараметрыЗакупки) Тогда
				Строка.ОКПД2 					= ПараметрыЗакупки.КодОКПД2;   
				Строка.НациональныйРежимЗакупок = ПараметрыЗакупки.НациональныйРежимЗакупок;
			Иначе
				Строка.НациональныйРежимЗакупок = Перечисления.НациональныйРежимЗакупок.НеИспользовать;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

// Определяет, разрешено ли на форме Форма вводить номенклатуру.
&НаКлиентеНаСервереБезКонтекста
Функция РазрешенВводНоменклатуры(Форма)
	РезультатФункции = (Форма.флЭкстреннаяЗакупка) И (НЕ Форма.флФЗ223);
	Возврат РезультатФункции;
КонецФункции		 // РазрешенВводНоменклатуры()

&НаСервере
Процедура УстановитьОформлениеФормы()       

	Массив = Новый Массив(); 
	Массив.Добавить(Тип("СправочникСсылка.КатегорииЗакупок"));   
	Массив.Добавить(Тип("СправочникСсылка.Номенклатура")); 	  
	ОписаниеВыбора = Новый ОписаниеТипов(Массив);  
	Элементы.НоменклатураНоменклатура.ОграничениеТипа = ОписаниеВыбора; 
	Элементы.ПотребностиПоГодамНоменклатура.ОграничениеТипа = ОписаниеВыбора; 
	Элементы.ТоварнаяКатегория.ОграничениеТипа = ОписаниеВыбора; 
	
	Элементы.ПотребностиПоГодам.КонтекстноеМеню.ПодчиненныеЭлементы.ПотребностиПоГодамКонтекстноеМенюДобавить.Доступность = НЕ ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);	
	Элементы.ПотребностиПоГодам.КоманднаяПанель.ПодчиненныеЭлементы.ПотребностиПоГодамДобавить.Доступность = НЕ ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);
	Элементы.Номенклатура.КонтекстноеМеню.ПодчиненныеЭлементы.НоменклатураКонтекстноеМенюДобавить.Доступность = НЕ ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);
	Элементы.Номенклатура.КоманднаяПанель.ПодчиненныеЭлементы.НоменклатураДобавить.Доступность = НЕ ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);
	Если НЕ ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок) Тогда
		Элементы.ПланПоставокПоПериодамРежимВводаДанныхПоСтроке.Видимость = Ложь;
		Элементы.ПланПоставокПоПериодамРежимВводаДанныхПоСтрокеКопия.Видимость = Ложь;
	КонецЕсли;
	ОбновитьФлагиОрганизации(ЭтаФорма);   
	
	Если Объект.ЗакупочнаяПроцедура.НациональныйРежимЗакупок Тогда
		Элементы.ПотребностиПоГодамОКПД2.Видимость = Истина;
		Элементы.НоменклатураГруппа7.Видимость = Истина;
	Иначе
		Элементы.ПотребностиПоГодамОКПД2.Видимость = Ложь;
		Элементы.НоменклатураГруппа7.Видимость = Ложь;	
	КонецЕсли;

	ЦентрализованныеЗакупкиУХ.УстановитьПараметрВыбораПериодичностьЗакупок(Элементы.ПериодЗакупок);
	УстановитьВидимостьОрганизацииДляЗаключенияДоговора();
	УстановитьВидимостьВкладкиУсловия();	
	УстановитьОформлениеЭлементовЕИС();
	УстановитьОформлениеЭлементовОбеспечения();
	ЗаполненаСПЗ = ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);
	Элементы.ФормаКомандаЗаполнитьИзСтрокиПланаЗакупок.Видимость = ЗаполненаСПЗ;  
	//Элементы.ЦФОИсполнитель.Видимость = ПолучитьФункциональнуюОпцию("СквозноеПланированиеПотребности");
	Элементы.ДекорацияНадписьФЗ223.Видимость = ЭтаФорма.флФЗ223;
	Элементы.ГруппаТоварнаяКатегория.Видимость = флРазделятьНоменклатуруПоКатегорийнымМенеджерам;
	ПравилаРаспределенияЗонтичнойЗакупкиПриИзмененииНаСервере();
	Элементы.КоличествоПобедителейЗонтичнойЗакупки.МаксимальноеЗначение = МаксимальноеЗначениеКоличестваПобедителей();
	Элементы.СтрокаПланаЗакупок.Видимость = ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);   
	УстановитьПоставкаКЗапрошеннойДате();  
	УстановитьОформлениеРасшифровкиПотребностей(ЭтаФорма);          
	Элементы.ЗакупкаИнновационнойВысокотехнологичнойПродукцииИЛекарственныхСредств.Видимость = флФЗ223; 
	Если ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок) Тогда
		Для Каждого Элемент ИЗ Элементы.ПотребностиПоГодам.ПодчиненныеЭлементы Цикл
			Элемент.ТолькоПросмотр = Истина;
		КонецЦикла;          
		Элементы.НоменклатураГруппа4.ТолькоПросмотр = Ложь; 
		Элементы.НоменклатураЦена.ТолькоПросмотр = Ложь; 
		Элементы.ПотребностиПоГодамГруппа4.ТолькоПросмотр = Ложь; 
		Элементы.ПотребностиПоГодамЦена.ТолькоПросмотр = Ложь;
		Элементы.ПланыДокументаГруппаСтатьяИАналитики.ТолькоПросмотр = Ложь;        
		Элементы.НоменклатураСтатьяБюджета.ТолькоПросмотр = Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(объект.СтрокаПланаЗакупок) 
		И ПолучитьФункциональнуюОпцию("СквозноеПланированиеПотребности") Тогда
		Элементы.ПотребностиПоГодамГруппа1.ТолькоПросмотр = Истина;
		Элементы.ПотребностиПоГодамГруппа2.ТолькоПросмотр = Истина;
		Элементы.ПотребностиПоГодамГруппа3.ТолькоПросмотр = Истина;
		Элементы.ПотребностиПоГодамСтавкаНДС.ТолькоПросмотр = Истина;
		Элементы.ПотребностиПоГодамГруппа5.ТолькоПросмотр = Истина;
		Элементы.ПотребностиПоГодамГруппа6.ТолькоПросмотр = Истина;
		Элементы.ПотребностиПоГодамГруппаКолонкиПоГодам.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	Элементы.ПодборПотребностей.Доступность = НЕ (ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ОрганизацияДляЗаключенияДоговора,"ИспользоватьПрограммуЗакупок") = Истина)
	И НЕ ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);
    Элементы.ПодборПотребностей1.Доступность = НЕ (ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ОрганизацияДляЗаключенияДоговора,"ИспользоватьПрограммуЗакупок") = Истина)
	И НЕ ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок);

	УсловноеОформлениеФормы = ЭтаФорма.УсловноеОформление;
	
	ЭлементУсловногоОформления = УсловноеОформлениеФормы.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПотребностиПоГодамХарактеристика.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПотребностиПоГодам.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУсловия                = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ПотребностиПоГодам.Уровень");
	ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = 1;
