#Область СлужебныеПроцедурыНаКлиенте

 &НаКлиенте
Процедура ОписаниеВыбораОбоснования(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат
	КонецЕсли;	
	Если ЗначениеЗаполнено(Результат.Исключение) Тогда 
		СтрокиОбоснований = Объект.ОбоснованияИсключенияНациональногоРежима.НайтиСтроки(Новый Структура("Номенклатура",Результат.Номенклатура)); 
		Если СтрокиОбоснований.Количество() = 0 Тогда
			Доб = Объект.ОбоснованияИсключенияНациональногоРежима.Добавить();
			ЗаполнитьЗначенияСвойств(Доб,Результат);
		Иначе
			СтрокиОбоснований[0].Исключение = Результат.Исключение;
			СтрокиОбоснований[0].ДополнительнаяИнформация = Результат.ДополнительнаяИнформация;
		КонецЕсли;
	Иначе
		СтрокиОбоснований = Объект.ОбоснованияИсключенияНациональногоРежима.НайтиСтроки(Новый Структура("Номенклатура",Результат.Номенклатура)); 
		Если СтрокиОбоснований.Количество() > 0 Тогда
			КолВо = Объект.ОбоснованияИсключенияНациональногоРежима.Количество()-1;
			Пока КолВо >= 0 Цикл
				Если 
					Объект.ОбоснованияИсключенияНациональногоРежима[КолВо].Номенклатура = Результат.Номенклатура Тогда
					Объект.ОбоснованияИсключенияНациональногоРежима.Удалить(КолВо);
				КонецЕсли;	
				КолВо = КолВо - 1;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	ЗаполнитьОбоснованиеНоменклатуры();	
	
КонецПроцедуры

