	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	//ЗаполнитьРасшифровки();
	ПриОжиданииВыполнитьКонтрольДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСтатьиАналитикиВСтроке(СтрокаВход)
	
	СтруктураПоиска = ПолучитьСтруктуруПоискаПоТЧНоменклатура();
	ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаВход);
	Для Каждого Строка ИЗ Объект.Номенклатура Цикл
		СтруктураНоменклатуры = ПолучитьСтруктуруПоискаПоТЧНоменклатура(); 
		ЗаполнитьЗначенияСвойств(СтруктураНоменклатуры,Строка);
		Если ОбщегоНазначенияУХ.СравнитьСтруктурыЗначений(СтруктураПоиска,СтруктураНоменклатуры) Тогда
        	Строка.СтатьяБюджета = СтрокаВход.СтатьяБюджета;
        	Строка.Аналитика1 = СтрокаВход.Аналитика1;
        	Строка.Аналитика2 = СтрокаВход.Аналитика2;
        	Строка.Аналитика3 = СтрокаВход.Аналитика3;
        	Строка.Аналитика4 = СтрокаВход.Аналитика4;
        	Строка.Аналитика5 = СтрокаВход.Аналитика5;
        	Строка.Аналитика6 = СтрокаВход.Аналитика6;
		КонецЕсли;	
	КонецЦикла;
	
 КонецПроцедуры	
 
&НаСервере
Процедура УстановитьУсловноеОформлениеДополнительныхАналитик(Форма, ОписаниеЭлементаСтатья)
	
	//
	Если НЕ ОписаниеЭлементаСтатья.ЭтоТаблицаФормы Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОписаниеАналитики Из ОписаниеЭлементаСтатья.ЭлементыАналитики Цикл
		
		ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеИспользуется(
			Форма.УсловноеОформление.Элементы, "Номенклатура"+ОписаниеАналитики.ИмяЭлемента, 
			ОписаниеАналитики.ПутьКДанным + "." + ОписаниеАналитики.ИмяРеквизитаВидАналитики,
			ОписаниеЭлементаСтатья.СкрыватьНезаданныеАналитикиСтатьиБюджета);
			
		ЭлементУО = АналитикиСтатейБюджетовУХ.ЭлементУсловногоОформления_АналитикаСтатьиНеЗаполнена(
			Форма.УсловноеОформление.Элементы, "Номенклатура"+ОписаниеАналитики.ИмяЭлемента, 
			ОписаниеАналитики.ПутьКДанным + "." + ОписаниеАналитики.ИмяРеквизита,
			ОписаниеАналитики.ПутьКДанным + "." + ОписаниеАналитики.ИмяРеквизитаВидАналитики
		);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьЭлементСтатьяБюджета(Форма, КолонкаСтатья, ПутьКДанным, Родитель, ВставитьПеред, ПараметрыЭлемента = Неопределено, СобытияЭлемента = Неопределено)
	
	ЭлементыФормы = Форма.Элементы;
	
	Элемент = ЭлементыФормы.Найти(КолонкаСтатья);
	Если Элемент = Неопределено Тогда
		Элемент = ФормыУХ.СоздатьПолеФормы(
			ЭлементыФормы, 
			КолонкаСтатья, "", ПутьКДанным, ВидПоляФормы.ПолеВвода, 
			Родитель, ВставитьПеред, 
			ПараметрыЭлемента, СобытияЭлемента);
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

&НаСервере
Функция РеквизитУжеДобавлен(ДобавляемыеРеквизиты, ИмяРеквизита, Путь)
	
	Для Каждого Реквизит Из ДобавляемыеРеквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита И Реквизит.Путь = Путь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРасшифровки(ОчищатьТаблицу = Неопределено)
	
	РазбивкаГоды.Очистить();
	Для Каждого Строка ИЗ Объект.Номенклатура Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("Год",Год(Строка.ДатаПоставки));
		Если РазбивкаГоды.НайтиСтроки(Отбор).Количество() = 0 Тогда
			Годы = РазбивкаГоды.Добавить();
			Годы.Год = Год(Строка.ДатаПоставки);
		Иначе
			Годы = РазбивкаГоды.НайтиСтроки(Отбор)[0];
		КонецЕсли;	
		Годы.Сумма = Годы.Сумма + Строка.Сумма;
		Годы.Количество = Годы.Количество+Строка.Количество;
		Годы.Номенклатура = Строка.Номенклатура;
	КонецЦикла;	               
	Если ОчищатьТаблицу = Неопределено Тогда
		ПотребностиПоПериодуРасшифровка.Очистить();
		ПотребностиПоПериодуРасшифровка.Загрузить(Объект.Номенклатура.Выгрузить()); 
	КонецЕсли;
	Для Каждого Строка ИЗ  ПотребностиПоПериодуРасшифровка Цикл 
		Строка.Год = Год(Строка.ДатаПоставки);
		Структура = Новый Структура();
		Структура.Вставить("ЕдиницаИзмерения",Строка.ЕдиницаИзмерения);
		Структура.Вставить("МестоПоставки",Строка.МестоПоставки);
		Структура.Вставить("Номенклатура",Строка.Номенклатура);
		Структура.Вставить("Характеристика",Строка.Характеристика);
		Структура.Вставить("Организация",Строка.Организация);  
		Структура.Вставить("Цена",Строка.Цена);  
		Структура.Вставить("СтатьяБюджета",Строка.СтатьяБюджета);   
		Структура.Вставить("Аналитика1",Строка.Аналитика1);   
		Структура.Вставить("Аналитика2",Строка.Аналитика2);   
		Структура.Вставить("Аналитика3",Строка.Аналитика3);   
		Структура.Вставить("Аналитика4",Строка.Аналитика4);   
		Структура.Вставить("Аналитика5",Строка.Аналитика5);   
		Структура.Вставить("Аналитика6",Строка.Аналитика6); 		
		Структура.Вставить("Назначение",Строка.Назначение);  
		
		Строка.ИдентификаторСтроки = ПотребностиПоГодам.НайтиСтроки(Структура)[0].ИдентификаторСтроки;
		Строка.Цена = ПотребностиПоГодам.НайтиСтроки(Структура)[0].Цена; 
		Если ТипЗнч(Строка.Номенклатура)= ТИП("СправочникСсылка.Номенклатура") Тогда	
			Строка.Сумма = Строка.Цена*Строка.Количество;
		Иначе
			Строка.Сумма = Строка.Сумма;
		КонецЕсли;
	КонецЦикла;    
	Попытка
	Для Каждого Строка ИЗ ПотребностиПоПериодуРасшифровка Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторСтроки",Строка.ИдентификаторСтроки);
		СтрокаПотребности = ПотребностиПоГодам.НайтиСтроки(Отбор);
		СтрокаПотребности[0]["Год"+Формат(Строка.Год,"ЧГ=0")+"Количество"] = СтрокаПотребности[0]["Год"+Формат(Строка.Год,"ЧГ=0")+"Количество"] + Строка.Количество;
		СтрокаПотребности[0]["Год"+Формат(Строка.Год,"ЧГ=0")+"Сумма"] = СтрокаПотребности[0]["Год"+Формат(Строка.Год,"ЧГ=0")+"Сумма"] + Строка.Сумма;
	КонецЦикла;	
	Исключение
	конецпопытки; 	  
	
	РасшифровкаПотребностей.Очистить();
	Для Каждого Строка ИЗ ПотребностиПоГодам Цикл
		Строка.Год = Год(Строка.ДатаПоставки);
		Структура = Новый Структура();
		Структура.Вставить("ЕдиницаИзмерения",Строка.ЕдиницаИзмерения);
		Структура.Вставить("МестоПоставки",Строка.МестоПоставки);
		Структура.Вставить("Номенклатура",Строка.Номенклатура);
		Структура.Вставить("Характеристика",Строка.Характеристика);
		Структура.Вставить("Организация",Строка.Организация);   
		Структура.Вставить("Назначение",Строка.Назначение);  
		Структура.Вставить("ЦФО",Строка.ЦФО); 
		Структура.Вставить("Цена",Строка.Цена);  
		Структура.Вставить("СтатьяБюджета",Строка.СтатьяБюджета);   
		Структура.Вставить("Аналитика1",Строка.Аналитика1);   
		Структура.Вставить("Аналитика2",Строка.Аналитика2);   
		Структура.Вставить("Аналитика3",Строка.Аналитика3);   
		Структура.Вставить("Аналитика4",Строка.Аналитика4);   
		Структура.Вставить("Аналитика5",Строка.Аналитика5);   
		Структура.Вставить("Аналитика6",Строка.Аналитика6);   
		
    	СтрокиНоменклатуры = Объект.Номенклатура.НайтиСтроки(Структура);
		Для Каждого СтрокаНоменклатуры ИЗ  СтрокиНоменклатуры Цикл
			Месяц = Месяц(СтрокаНоменклатуры.ДатаПоставки);
			Квартал = Месяц(КонецКвартала(СтрокаНоменклатуры.ДатаПоставки)) / 3;    
			Год =  Год(СтрокаНоменклатуры.ДатаПоставки);

			Расшифровка = РасшифровкаПотребностей.Добавить();
			Расшифровка.Год = Год;
			Расшифровка.ИдентификаторСтроки =  Строка.ИдентификаторСтроки;
			Если Месяц = 1 Тогда
				Расшифровка.ЯнварьСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.ЯнварьКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 2 Тогда
				Расшифровка.ФевральСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.ФевральКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 3 Тогда
				Расшифровка.МартСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.МартКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 4 Тогда
				Расшифровка.АпрельСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.АпрельКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 5 Тогда
				Расшифровка.МайСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.МайКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 6 Тогда
				Расшифровка.ИюньСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.ИюньКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 7 Тогда
				Расшифровка.ИюльСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.ИюльКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 8 Тогда
				Расшифровка.АвгустСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.АвгустКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 9 Тогда
				Расшифровка.СентябрьСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.СентябрьКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 10 Тогда
				Расшифровка.ОктябрьСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.ОктябрьКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 11 Тогда
				Расшифровка.НоябрьСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.НоябрьКоличество = СтрокаНоменклатуры.Количество;
			ИначеЕсли Месяц = 12 Тогда
				Расшифровка.ДекабрьСумма = СтрокаНоменклатуры.Сумма;
				Расшифровка.ДекабрьКоличество = СтрокаНоменклатуры.Количество;
			КонецЕсли;				
		КонецЦикла;	
	КонецЦикла;	 
	Расшифровка = РасшифровкаПотребностей.Выгрузить();
	Расшифровка.Свернуть("ИдентификаторСтроки,Год","ЯнварьСумма,ЯнварьКоличество,ФевральСумма,ФевральКоличество,
	|МартСумма,МартКоличество,АпрельСумма,АпрельКоличество,МайСумма,МайКоличество,ИюньСумма,ИюньКоличество,
	|ИюльСумма,ИюльКоличество,АвгустСумма,АвгустКоличество,СентябрьСумма,СентябрьКоличество,ОктябрьСумма,ОктябрьКоличество,
	|НоябрьСумма,НоябрьКоличество,ДекабрьСумма,ДекабрьКоличество,ПервыйКварталСумма,ПервыйКварталКоличество,
	|ВторойКварталСумма,ВторойКварталКоличество,ТретийКварталСумма,ТретийКварталКоличество,ЧетвертыйКварталСумма,
	|ЧетвертыйКварталКоличество");
	РасшифровкаПотребностей.Очистить();
	РасшифровкаПотребностей.Загрузить(Расшифровка);
	
КонецПроцедуры

&НаСервере
Процедура РазместитьКолонкиПотребностиПоГодам(МассивГодыВход = Неопределено)
	// Инициализация.                        
	Если МассивГодыВход = Неопределено Тогда 
	МассивГоды = СоздатьМассивЛетМеждуДатами( Объект.ДатаОфициальногоОбъявленияЗакупки, Объект.ДатаИсполненияДоговора, Объект.ПериодЗакупок);
    КонецЕсли;
	Число152 = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	Число153 = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3);
	ТипЭлементаПолеФормы = Тип("ПолеФормы");
	МассивДобавляемых = Новый Массив;
	СоответствиеВрем = Новый Соответствие;
	Если ТипЗнч(СоответствиеРеквизитовПериодам) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого ТекСоответствиеРеквизитовПериодам Из СоответствиеРеквизитовПериодам Цикл
			СоответствиеВрем.Вставить(ТекСоответствиеРеквизитовПериодам.Ключ, ТекСоответствиеРеквизитовПериодам.Значение);
		КонецЦикла;	
	Иначе
		// Оставляем СоответствиеВрем пустым. СоответствиеРеквизитовПериодам будет проинициализировано позже.
	КонецЕсли;
	// Добавление реквизитов.
	ВыгрузкаПотребностей = ПотребностиПоГодам.Выгрузить();
	КолонкиПотребностей = ВыгрузкаПотребностей.Колонки;
	Для Каждого ТекМассивГоды Из МассивГодыВход Цикл
		ГодСтрока = Формат(ТекМассивГоды, "ЧГ=0");
	//	// Колонка Сумма.
		НаименованиеНовогоРеквизита = "Год" + ГодСтрока + "Сумма";
		Если КолонкиПотребностей.Найти(НаименованиеНовогоРеквизита) = Неопределено Тогда
			ЗаголовокРеквизита = НСтр("ru = '%Год%, сумма'");
			ЗаголовокРеквизита = СтрЗаменить(ЗаголовокРеквизита, "%Год%", ГодСтрока);
			НовыйРеквизитФормы = Новый РеквизитФормы(НаименованиеНовогоРеквизита, Число152, "ПотребностиПоГодам", ЗаголовокРеквизита);
			МассивДобавляемых.Добавить(НовыйРеквизитФормы);
		Иначе
			// Уже есть такая колонка. Пропускаем.
		КонецЕсли;
		// Колонка Количество.
		НаименованиеНовогоРеквизита = "Год" + ГодСтрока + "Количество";
		Если КолонкиПотребностей.Найти(НаименованиеНовогоРеквизита) = Неопределено Тогда
			ЗаголовокРеквизита = НСтр("ru = '%Год%, количество'");
			ЗаголовокРеквизита = СтрЗаменить(ЗаголовокРеквизита, "%Год%", ГодСтрока);
			НовыйРеквизитФормы = Новый РеквизитФормы(НаименованиеНовогоРеквизита, Число153, "ПотребностиПоГодам", ЗаголовокРеквизита);
			МассивДобавляемых.Добавить(НовыйРеквизитФормы);
		Иначе
			// Уже есть такая колонка. Пропускаем.
		КонецЕсли;
	КонецЦикла;	
	ИзменитьРеквизиты(МассивДобавляемых);
	// Добавление элементов.
	Для Каждого ТекМассивГоды Из МассивГодыВход Цикл
		ГодСтрока = Формат(ТекМассивГоды, "ЧГ=0");
		НаименованиеНовогоРеквизита = "ПотребностиПоГодамГруппа" + ГодСтрока;
		Если Элементы.Найти(НаименованиеНовогоРеквизита) = Неопределено Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Группировка", ГруппировкаКолонок.Вертикальная);
			НовыйЭлементГруппа = ФормыУХ.СоздатьГруппуФормы(
				Элементы, НаименованиеНовогоРеквизита, ГодСтрока, ВидГруппыФормы.ГруппаКолонок, Элементы.ПотребностиПоГодамГруппаКолонкиПоГодам, , СтруктураПараметров);
		Иначе
	//		// Элемент уже создан.
		КонецЕсли;
	//	// Колонка Сумма.
		НаименованиеЭлемента = "ПотребностиПоГодам" + ГодСтрока + "Сумма";
		Если Элементы.Найти(НаименованиеЭлемента) = Неопределено Тогда
			ЗаголовокРеквизита = НСтр("ru = '%Год%, сумма'");
			ЗаголовокРеквизита = СтрЗаменить(ЗаголовокРеквизита, "%Год%", ГодСтрока);
			ПутьКДанным = "ПотребностиПоГодам.Год" + ГодСтрока + "Сумма";
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПриИзменении", "ПотребностиПоГодамСуммаПриИзменении_Подключаемый");
			ФормыУХ.СоздатьПолеФормы(
				Элементы, НаименованиеЭлемента, ЗаголовокРеквизита, ПутьКДанным, ВидПоляФормы.ПолеВвода, 
				НовыйЭлементГруппа, , , СтруктураДействий);
			СоответствиеВрем.Вставить(НаименованиеЭлемента, ТекМассивГоды); 
		Иначе
			// Элемент уже создан.
		КонецЕсли;
		
		НаименованиеЭлемента = "ПотребностиПоГодам" + ГодСтрока + "Количество";
		Если Элементы.Найти(НаименованиеЭлемента) = Неопределено Тогда
			ЗаголовокРеквизита = НСтр("ru = '%Год%, количество'");
			ЗаголовокРеквизита = СтрЗаменить(ЗаголовокРеквизита, "%Год%", ГодСтрока);
			ПутьКДанным = "ПотребностиПоГодам.Год" + ГодСтрока + "Количество";
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПриИзменении", "ПотребностиПоГодамКоличествоПриИзменении_Подключаемый");
			ФормыУХ.СоздатьПолеФормы(
				Элементы, НаименованиеЭлемента, ЗаголовокРеквизита, ПутьКДанным, ВидПоляФормы.ПолеВвода, 
				НовыйЭлементГруппа, , , СтруктураДействий);
			СоответствиеВрем.Вставить(НаименованиеЭлемента, ТекМассивГоды);
		Иначе
			// Элемент уже создан.
		КонецЕсли;
		
	КонецЦикла;	  
	СоответствиеРеквизитовПериодам = Новый ФиксированноеСоответствие(СоответствиеВрем);
КонецПроцедуры		// РазместитьКолонкиПотребностиПоГодам

&НаСервере
Функция СоздатьМассивЛетМеждуДатами(ДатаНачалаВход, ДатаОкончанияВход, ПериодВход = Неопределено)
	// Инициализация.
	РезультатФункции = Новый Массив;
	ДатаНачалаРабочая = Дата(1, 1, 1);
	ДатаОкончанияРабочая = Дата(1, 1, 1);
	Если ЗначениеЗаполнено(ДатаНачалаВход) И ЗначениеЗаполнено(ДатаОкончанияВход) Тогда
		ДатаНачалаРабочая = ДатаНачалаВход;
		ДатаОкончанияРабочая = ДатаОкончанияВход;   
		Если ЗначениеЗаполнено(ПериодВход) И ПериодВход.ДатаНачала<ДатаНачалаВход Тогда
		ДатаНачалаРабочая = ПериодВход.ДатаНачала;
		КонецЕсли;		
	ИначеЕсли ЗначениеЗаполнено(ПериодВход)	Тогда
		ДатаНачалаРабочая = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодВход, "ДатаНачала");
		ДатаОкончанияРабочая = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодВход, "ДатаОкончания");
	Иначе
		ДатаНачалаРабочая = Дата(1, 1, 1);
		ДатаОкончанияРабочая = Дата(1, 1, 1);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаНачалаРабочая) И ЗначениеЗаполнено(ДатаОкончанияРабочая) Тогда
		// Первый год.
		РезультатФункции.Добавить(Год(ДатаНачалаРабочая));
		// Последующие годы.
		НоваяДата = ДобавитьМесяц(ДатаНачалаРабочая, 12);
		Пока НачалоГода(НоваяДата) <= ДатаОкончанияРабочая Цикл
			РезультатФункции.Добавить(Год(НоваяДата));
			НоваяДата = ДобавитьМесяц(НоваяДата, 12);
		КонецЦикла;		
	Иначе
		РезультатФункции = Новый Массив;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции   

&НаСервере
Процедура ЗаполнитьДерево(ПотребностиДерево = Неопределено)

	Для Каждого Строка ИЗ Объект.Номенклатура Цикл
		Строка.ХарактеристикиИспользуются = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ХарактеристикиИспользуются(Строка.Номенклатура);
		Строка.ПоПлануПотребности = ЗначениеЗаполнено(Строка.АналитикаИсточника);	
		Строка.ЭтоТоварнаяКатегория = (ТипЗнч(Строка.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок"));
	КонецЦикла;	
	
	Если ПотребностиДерево = Неопределено Тогда	
		ТЗ = Объект.Номенклатура.Выгрузить();
	Иначе 
		ТЗ = ПотребностиПоПериодуРасшифровка.Выгрузить();	
	КонецЕсли;
	Для Каждого Строка ИЗ ТЗ Цикл
		Если Строка.ЦенаПервоначальная = 0 Тогда Строка.ЦенаПервоначальная = Строка.Цена; КонецЕсли;	
	КонецЦикла;	
	ТЗ.Свернуть("ЕдиницаИзмерения,Назначение,Коэффициент,Проект,МестоПоставки,Номенклатура,Характеристика,Цена,ЭтоТоварнаяКатегория,
	|Организация,ЦФО,СтавкаНДС,ЦенаПервоначальная,СтатьяБюджета,ПоПлануПотребности,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6","Количество,Сумма,СуммаНДС");
	ПотребностиПоГодам.Загрузить(ТЗ);
	Для Каждого СтрокаПотребностей ИЗ ПотребностиПоГодам Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПотребностей.ЦенаПервоначальная) И НЕ СтрокаПотребностей.ЭтоКатегорияНоменклатуры Тогда
			СтрокаПотребностей.ЦенаПервоначальная = СтрокаПотребностей.Цена;
		КонецЕсли;
		СтрокаПотребностей.ИдентификаторСтроки = Новый УникальныйИдентификатор();	
		СтрокаПотребностей.ХарактеристикиИспользуются = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ХарактеристикиИспользуются(СтрокаПотребностей.Номенклатура);
		Структура = Новый Структура();   
		Структура.Вставить("ЕдиницаИзмерения",СтрокаПотребностей.ЕдиницаИзмерения);
		Структура.Вставить("МестоПоставки",СтрокаПотребностей.МестоПоставки);    
		Структура.Вставить("Назначение",СтрокаПотребностей.Назначение);    
		
		Структура.Вставить("Коэффициент",СтрокаПотребностей.Коэффициент);
		Структура.Вставить("Цена",СтрокаПотребностей.Цена);
		Структура.Вставить("Номенклатура",СтрокаПотребностей.Номенклатура);
		Структура.Вставить("Характеристика",СтрокаПотребностей.Характеристика);
		Структура.Вставить("Организация",СтрокаПотребностей.Организация);  
		Структура.Вставить("ЦФО",СтрокаПотребностей.ЦФО); 
		Структура.Вставить("СтатьяБюджета",СтрокаПотребностей.СтатьяБюджета);   
		Структура.Вставить("Аналитика1",СтрокаПотребностей.Аналитика1);   
		Структура.Вставить("Аналитика2",СтрокаПотребностей.Аналитика2);   
		Структура.Вставить("Аналитика3",СтрокаПотребностей.Аналитика3);   
		Структура.Вставить("Аналитика4",СтрокаПотребностей.Аналитика4);   
		Структура.Вставить("Аналитика5",СтрокаПотребностей.Аналитика5);   
		Структура.Вставить("Аналитика6",СтрокаПотребностей.Аналитика6);		
		ОтборСтрокНоменклатуры = Объект.Номенклатура.НайтиСтроки(Структура);
		Для Каждого СтрокаНоменклатуры ИЗ ОтборСтрокНоменклатуры Цикл
			СтрокаНоменклатуры.ИдентификаторСтроки = СтрокаПотребностей.ИдентификаторСтроки;	
		КонецЦикла;	
		
	КонецЦикла;  
	ЗаполнитьРасшифровки(ПотребностиДерево);
	ОбновитьСуммуДокументаИзКроссТаблицы();	
	
КонецПроцедуры

