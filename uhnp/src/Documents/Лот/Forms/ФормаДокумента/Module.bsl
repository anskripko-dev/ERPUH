

&НаКлиенте
Процедура РасшифровкаПоСтроке(Команда)
	// Вставить содержимое обработчика.     
	ТекДанные = Элементы.ПотребностиПоГодам.ТекущиеДанные;
	СтруктураОтбора = Новый Структура;  
	
	Если (ТекДанные <> Неопределено) Тогда  
		СтруктураОтбора.Вставить("Номенклатура",ТекДанные.Номенклатура);
		СтруктураОтбора.Вставить("Характеристика",ТекДанные.Характеристика);
		СтруктураОтбора.Вставить("Организация",ТекДанные.Организация);
		СтруктураОтбора.Вставить("МестоПоставки",ТекДанные.МестоПоставки);
	Иначе
		Возврат;
	КонецЕсли;
	Элементы.Номенклатура.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);   
	Элементы.Группа1.Видимость = Ложь;
	Элементы.Номенклатура.Видимость = Истина;      
	Элементы.ПланПоставокПоПериодамРежимВводаДанныхПоСтрокеКопия.Видимость = Истина;
	
КонецПроцедуры

#Область ОбработкаОсновныхСобытийФормы


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//ОПК
	Если Параметры.Ключ.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	//Конец ОПК
	ПериодичностьЦентрализованныхЗакупок = ЦентрализованныеЗакупкиУХ.ПолучитьПериодичностьЗакупок();

	Если Объект.Скрыт Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрокаЗапретОткрытияПредопределенного();
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;   
	Если НЕ ЗначениеЗаполнено(Объект.ЗакупочнаяПроцедура) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Лот необходимо создавать из закучной процедуры";
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ЭтоВнешнийПользователь = ПользователиКлиентСервер.ЭтоСеансВнешнегоПользователя();
	Если ЭтоВнешнийПользователь Тогда		
		Сообщение = Новый СообщениеПользователю;
		ТекстСообщения = СтрокаЗапретОткрыватьВнешнемуПоставщику();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;             
	СтруктураРеквизитовШаблона = Справочники.Лоты.ПолучитьРеквизитыШаблонаЛотаВСтруктуре();
	СтруктураЦветФона = Новый Структура("ЦветФона", WebЦвета.Роса);
	ЦентрализованныеЗакупкиВызовСервераУХ.ВыделитьЭлементыФормы(
		ЭтаФорма, СтруктураРеквизитовШаблона, СтруктураЦветФона);
	#Область УниверсальныеПроцессыСогласование
	АккредитацияПоставщиковУХ.ИнициализироватьПодсистемуСогласованияПоВнешнемуПоставщику(ЭтаФорма);  
	ДействияСогласованиеУХСервер.НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта(ЭтаФорма);
	
	#КонецОбласти
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	ИменаКлючевыхПолей = ЦентрализованныеЗакупкиКлиентСерверУХ.ИменаКлючевыхПолейКроссТаблицыПотребностей();
 	УстановитьСостояниеДокумента();

	Если Объект.ВидЗакупки = Перечисления.ВидЛотовойЗакупки.Зонтичная Тогда
		НастроитьКроссТаблицуЗонтичнойЗакупки();
		УстановитьВидимостьСуммыЗонтичнойЗакупки();		
	КонецЕсли;
		
	флЭкстреннаяЗакупка = Объект.ЗакупочнаяПроцедура.ЭкстреннаяЗакупка;
	флРазделятьНоменклатуруПоКатегорийнымМенеджерам = ПолучитьФункциональнуюОпцию("РазделятьНоменклатуруПоКатегорийнымМенеджерам");
	ОчиститьСвязиНомеклатуры();
	УстановитьОформлениеФормы();    
	
	ДатаИсполненияДоговора = ?(Объект.СтрокаПланаЗакупок.ДатаИсполненияДоговора < Объект.ДатаИсполненияДоговора,Объект.ДатаИсполненияДоговора,Объект.СтрокаПланаЗакупок.ДатаИсполненияДоговора);
	МассивГоды = СоздатьМассивЛетМеждуДатами(Объект.ЗакупочнаяПроцедура.ДатаОфициальногоОбъявленияЗакупки,ДатаИсполненияДоговора, Объект.ПериодЗакупок);
	
	РазместитьКолонкиПотребностиПоГодам(МассивГоды);
	
	ЗаполнитьДерево();  
	КонтенкстКроссТаблицы = ЦентрализованныеЗакупкиУХ.ПолучитьТиповойКонтекстКроссТаблицыПотребностей(
		"ПериодыЗакупок", "ПотребностиВНоменклатуреПоПериодам",	
		"ПотребностиВНоменклатуреПоПериодам", ИменаКлючевыхПолей);
	Если ПолучитьФункциональнуюОпцию("СквозноеПланированиеПотребности") Тогда
		УстановитьВыборЦФО();    
	КонецЕсли;
	
	Данные = ПланированиеПотребностей.ПолучитьПланыПоЗаявкеНаЗакупку(Объект.Ссылка);
	////ПланыДокументаБДДС.Загрузить(Данные.БюджетДвиженияДенежныхСредств);
	МодульСогласованияДокументовУХ.ПриСозданииНаСервереОбъект(ЭтаФорма);
	//ОПК        
	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата) <> Неопределено Тогда
	УстановитьОформлениеСтатейИАналитик();      
	Иначе
	Элементы.ПланОплатыСтатьиБюджета.Видимость = Ложь;
	КонецЕсли;
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);    
	НадписьОплата = НадписьОплата(Объект.Календарь, Объект.ЭтапыГрафикаОплаты.Количество());	
			 	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// Разместить элементы
	Размещение = Новый Структура;
	Размещение.Вставить("Страницы", Элементы.Страницы);
	ПланированиеПотребностейФормы.ДобавитьЭлементыФормы(ЭтотОбъект, Размещение);
		 
	// Контроль документа	
	КонтрольУХ.ПодготовитьФормуНаСервере(ЭтотОбъект, Элементы.Страницы);

	//Конец ОПК 
	Если Элементы.Найти("ПотребностиПоГодамГруппаРеквизитов") <> Неопределено Тогда
		Элементы.ПотребностиПоГодамГруппаРеквизитов.Видимость = Ложь;  
	КонецЕсли;
	ОбновитьСуммуДокументаИзКроссТаблицы(); 
	ПересчетОтносительногоОтклоненияЦен(, ЭтаФорма);	
	Элементы.СтраницаОплаты.Видимость = Ложь;
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.УсловияОплаты = Объект.УсловиеОплаты;
	КонецЕсли;	   
	Элементы.Номенклатура.Видимость = Ложь;   
	Элементы.ПланПоставокПоПериодамРежимВводаДанныхПоСтрокеКопия.Видимость = Ложь;    
	
	ЗаполнитьОбоснованиеНоменклатуры();	
	
КонецПроцедуры

&НаСервере 
Процедура УстановитьОформлениеСтатейИАналитик()
	
	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);
	
	МассивОписанийСтатей = Новый Массив;
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
		"ПотребностиПоГодам", "ПотребностиПоГодам",
		"СтатьяБюджета", "ПланыДокументаСтатьяБюджета",
		"Аналитика%1", "ПланыДокументаАналитика%1",
		ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ПланыДокументаГруппаСтатьяИАналитики)); 
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтаФорма, МассивОписанийСтатей, ПараметрыПоляВводаШапки); //ПараметрыПоляВвода());

	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);
	
	МассивОписанийСтатей = Новый Массив;
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
		"Объект.Номенклатура", "Номенклатура",
		"СтатьяБюджета", "ПланыДокументаНоменклатураСтатьяБюджета",
		"Аналитика%1", "ПланыДокументаАналитика%1",
		ФормыУХ.РазместитьВГруппеСтрокой(Элементы.НоменклатураСтатьяБюджета)); 
	//этаформа.ОписаниеФормы = Неопределено;	
	//АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтаФорма, МассивОписанийСтатей, ПараметрыПоляВводаШапки); //ПараметрыПоляВвода());
	// 
	ДобавляемыеРеквизиты = Новый Массив;
	АналитикиСтатейБюджетовУХ.ДобавитьРеквизитОписанияФормы(ДобавляемыеРеквизиты);
	
	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		Если ТипЗнч(ОписаниеСтатьи.Параметры) = Тип("Структура")
			И ОписаниеСтатьи.Параметры.Свойство("СоздаватьРеквизитыВидАналитики")
			И ОписаниеСтатьи.Параметры.СоздаватьРеквизитыВидАналитики = Ложь Тогда
			Продолжить; // Не создаем реквизиты ВидАналитики%1*
		КонецЕсли;
		
		// Добавляем реквизиты формы ВидАналитики%1*
		Для Поз = 1 По ОписаниеСтатьи.КолвоАналитик Цикл
			ИмяРеквизита = СтрШаблон(ОписаниеСтатьи.Аналитики.ВидАналитикиИмяРеквизита, Поз);
			Если НЕ РеквизитУжеДобавлен(ДобавляемыеРеквизиты, ИмяРеквизита, ОписаниеСтатьи.Аналитики.ВидАналитикиПуть) Тогда
				АналитикиСтатейБюджетовУХ.ДобавитьРеквизитыВидаАналитики(ДобавляемыеРеквизиты, ИмяРеквизита, "Объект.Номенклатура");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла; 
	ДобавляемыеРеквизиты.Удалить(0);    
	Попытка
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);      
	Исключение
	КонецПопытки;
    СобытияПоляВвода = Неопределено;
	
	
	ОписаниеФормы = АналитикиСтатейБюджетовУХ.ПолучитьОписаниеФормы(ЭтаФорма);
	Если ОписаниеФормы = Неопределено Тогда
		// Добавляем описания статей бюджетов в реквизит формы
		ОписаниеФормы = Новый Структура;
		ОписаниеФормы.Вставить("СтатьиБюджетов", Новый Соответствие);
		ОписаниеФормы.Вставить("Реквизиты", Новый Соответствие);
		ОписаниеФормы.Вставить("ТаблицыФормы", Новый Соответствие);
		ОписаниеФормы.Вставить("АналитикиСтатейБюджетов", Новый Соответствие);
	Иначе
		ОписаниеФормы = Новый Структура(ОписаниеФормы);
	КонецЕсли;
	
	//
	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		ИмяРеквизита = ОписаниеСтатьи.ИмяРеквизита;
		Если НЕ ПустаяСтрока(ОписаниеСтатьи.ПутьКДанным) Тогда
			ИмяРеквизита = ОписаниеСтатьи.ПутьКДанным + "."+ИмяРеквизита;
		КонецЕсли;
		
		ОписаниеФормы.Реквизиты.Вставить(ИмяРеквизита, ОписаниеСтатьи);
		
		Для Каждого КлючЗначения Из ОписаниеСтатьи.ЭлементыФормы Цикл
			
			ОписаниеЭлемента = КлючЗначения.Значение;
			
			ОписаниеФормы.СтатьиБюджетов.Вставить(КлючЗначения.Ключ, ОписаниеСтатьи);
			
			Для НомерАналитики = 1 По ОписаниеЭлемента.ЭлементыАналитики.Количество() Цикл
				ЭлементАналитики = ОписаниеЭлемента.ЭлементыАналитики[НомерАналитики-1];
				ОписаниеАналитики = Новый Структура("СтатьяБюджета, НомерАналитики", КлючЗначения.Ключ, НомерАналитики);
				ОписаниеФормы.АналитикиСтатейБюджетов.Вставить(ЭлементАналитики.ИмяЭлемента, ОписаниеАналитики);
			КонецЦикла;
			
			// ТаблицыФормы
			Если ОписаниеЭлемента.ЭтоТаблицаФормы И ЗначениеЗаполнено(ОписаниеЭлемента.ИмяТаблицыФормы) Тогда
				
				Данные = ОписаниеФормы.ТаблицыФормы[ОписаниеЭлемента.ИмяТаблицыФормы];
				Если Данные = неопределено Тогда
					ОписаниеФормы.ТаблицыФормы.Вставить(ОписаниеЭлемента.ИмяТаблицыФормы, Новый Массив);
				КонецЕсли;
				ОписаниеФормы.ТаблицыФормы[ОписаниеЭлемента.ИмяТаблицыФормы].Добавить(ОписаниеСтатьи);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ЭтаФорма.ОписаниеФормы = Новый ФиксированнаяСтруктура(ОписаниеФормы);
	
 
	
	#Область ДобавлениеЭлементовФормы
	
	//
	Для Каждого ОписаниеСтатьи Из МассивОписанийСтатей Цикл
		
		Для каждого КлючЗначение Из ОписаниеСтатьи.ЭлементыФормы Цикл
			
			ОписаниеЭлемента = КлючЗначение.Значение;
		
			//
			Родитель = ЭтаФорма.Элементы.Найти(ОписаниеЭлемента.ИмяРодителя);
			ВставитьПеред = ЭтаФорма.Элементы.Найти(ОписаниеЭлемента.ИмяВставитьПеред);
			
			//
			ПутьКДанным = ОписаниеСтатьи.ИмяРеквизита;
			Если ОписаниеЭлемента.ПутьКДанным <> "" Тогда
				ПутьКДанным = ОписаниеЭлемента.ПутьКДанным + "." + ПутьКДанным;
			КонецЕсли;
			ПутьКДанным = "Объект.Номенклатура.СтатьяБюджета";
			// Добавить статью бюджетов
			ЭлементСтатья = ДобавитьЭлементСтатьяБюджета(
				ЭтаФорма, 
				ОписаниеЭлемента.ИмяЭлемента, ПутьКДанным,
				Родитель, 
				ВставитьПеред,
				ПараметрыПоляВводаШапки);
				
			ПриИзменении = ЭлементСтатья.ПолучитьДействие("ПриИзменении");
			Если ПустаяСтрока(ПриИзменении) Тогда
				ПереопределениеСобытийФормы.ПереопределитьСобытиеЭлементаФормы(ЭтаФорма, ЭлементСтатья, "ПриИзменении", "Подключаемый_НоменклатураСтатьяБюджета_ПриИзменении");
			КонецЕсли;
			
			// Добавить аналитики
			Для каждого ОписаниеЭлементаАналитика Из ОписаниеЭлемента.ЭлементыАналитики Цикл
			
				//
				ПутьКДанным = ОписаниеЭлементаАналитика.ИмяРеквизита;
				Если ОписаниеЭлементаАналитика.ПутьКДанным <> "" Тогда
					ПутьКДанным = ОписаниеЭлементаАналитика.ПутьКДанным + "." + ПутьКДанным;
				КонецЕсли;
				
				//
				Родитель = ЭтаФорма.Элементы.Найти(ОписаниеЭлементаАналитика.ИмяРодителя);
				ВставитьПеред = ЭтаФорма.Элементы.Найти(ОписаниеЭлементаАналитика.ИмяВставитьПеред);
				
				Элемент = ФормыУХ.СоздатьПолеФормы(
					ЭтаФорма.Элементы, 
					"Номенклатура"+ОписаниеЭлементаАналитика.ИмяЭлемента,
					ОписаниеЭлементаАналитика.ИмяРеквизита,
					ПутьКДанным, 
					ВидПоляФормы.ПолеВвода, 
					Родитель, ВставитьПеред, 
					ПараметрыПоляВводаШапки, СобытияПоляВвода);
				
				//
				ПутьКДанным = ОписаниеЭлементаАналитика.ИмяРеквизитаВидАналитики;
				Если ОписаниеЭлементаАналитика.ПутьКВидамАналитик <> "" Тогда
					ПутьКДанным = ОписаниеЭлементаАналитика.ПутьКВидамАналитик + "." + ПутьКДанным;
				КонецЕсли;
				
				Элемент.СвязьПоТипу = Новый СвязьПоТипу(ПутьКДанным, 0);
				
				// Установка при изменении
				
			КонецЦикла;
			
			// Добавить условное оформление
			Если ОписаниеЭлемента.ЭтоТаблицаФормы Тогда
				УстановитьУсловноеОформлениеДополнительныхАналитик(ЭтаФорма, ОписаниеЭлемента);
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	#КонецОбласти 
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);	
	
	ФормыУХ.ОформитьЭлементыТаблицыФормы(Элементы.Группа1);
	
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);  
	
	Если ВидСтатьи <> Неопределено Тогда 
	Элементы.ПланыДокументаСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения; 
	Элементы.ПланыДокументаНоменклатураСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;	
	КонецЕсли;            

	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПоискаПоТЧНоменклатура()
	Отбор = Новый Структура();
	Отбор.Вставить("Номенклатура");
	Отбор.Вставить("Характеристика");
	Отбор.Вставить("ЕдиницаИзмерения");
	Отбор.Вставить("МестоПоставки");
	Отбор.Вставить("Организация"); 	
	Отбор.Вставить("Цена"); 
	Отбор.Вставить("СтавкаНДС"); 	
	
	Возврат Отбор;
КонецФункции
 	
&НаКлиенте
Процедура Подключаемый_СтатьяБюджета_ПриИзменении(Элемент)
	
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
	ТекДанные = Элементы.ПотребностиПоГодам.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПриИзмененииСтатьиАналитикиВСтроке(ТекДанные);
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	//ЗаполнитьРасшифровки();
	ПриОжиданииВыполнитьКонтрольДокумента();

КонецПроцедуры

