&НаКлиенте
Процедура ОписаниеВыбораНоменклатуры(Элемент, ВыбранноеЗначение) Экспорт

    СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Элемент) Тогда
    	Элементы.ПотребностиПоГодам.ТекущиеДанные.Номенклатура = Элемент; 
		ПотребностиПоГодамНоменклатураПриИзменении(Элемент);
	КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПотребностиПоГодамНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение = ТИП("СправочникСсылка.КатегорииЗакупок")  И ЗначениеЗаполнено(Объект.ТоварнаяКатегория) Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.ПотребностиПоГодам.ТекущиеДанные.Номенклатура = Объект.ТоварнаяКатегория; 
		ПотребностиПоГодамНоменклатураПриИзменении(Элемент);      
	ИначеЕсли ВыбранноеЗначение = ТИП("СправочникСсылка.КатегорииЗакупок")  И НЕ ЗначениеЗаполнено(Объект.ТоварнаяКатегория) Тогда	
		СтандартнаяОбработка = Ложь;
		Оповещение = Новый ОписаниеОповещения("ОписаниеВыбораНоменклатуры", ЭтотОбъект);    
		Форма = ОткрытьФорму("Справочник.КатегорииЗакупок.ФормаВыбора",, ЭтаФорма,,,,Оповещение);	
	ИначеЕсли ВыбранноеЗначение = ТИП("СправочникСсылка.Номенклатура")  Тогда
		СтандартнаяОбработка = Ложь;
		Оповещение = Новый ОписаниеОповещения("ОписаниеВыбораНоменклатуры", ЭтотОбъект);    
		Если ЗначениеЗаполнено(Объект.ТоварнаяКатегория) Тогда
			СписокНоменклатуры = СписокНоменклатурыПоТоварнойКатегории(Объект.ТоварнаяКатегория);
			ОтборФормы = Новый Структура();      
			ОтборФормы.Вставить("СписокНоменклатуры",СписокНоменклатуры);  
			Форма = ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",ОтборФормы, ЭтаФорма,,,,Оповещение);	
		Иначе	
			Форма = ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",, ЭтаФорма,,,,Оповещение);	
		КонецЕсли;
	КонецЕсли;КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокНоменклатурыПоТоварнойКатегории(ТоварнаяКатегория)

	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ Разрешенные
	                |	Номенклатура.Ссылка КАК Ссылка
	                |ИЗ
	                |	Справочник.Номенклатура КАК Номенклатура
	                |ГДЕ
	                |	Номенклатура.ТоварнаяКатегория = &ТоварнаяКатегория";     
	Запрос.УстановитьПараметр("ТоварнаяКатегория",ТоварнаяКатегория);
	Выборка = Запрос.Выполнить().Выбрать();
	СписокНоменклатуры = Новый СписокЗначений();
	Пока Выборка.Следующий() Цикл
         СписокНоменклатуры.Добавить(Выборка.Ссылка);
	КонецЦикла;	 
	Возврат СписокНоменклатуры; 
	
КонецФункции

&НаКлиенте
Процедура РежимКроссТаблицы(Команда)
	ЗаполнитьДерево();  
	
	Элементы.Номенклатура.ОтборСтрок = Неопределено;  

	Элементы.Группа1.Видимость = Истина;
	Элементы.Номенклатура.Видимость = Ложь; 
	Элементы.ПланПоставокПоПериодамРежимВводаДанныхПоСтрокеКопия.Видимость = Ложь;
	ПересчетОтносительногоОтклоненияЦен(,ЭтаФорма);	
    ОбновитьАналитикуКроссТаблицТаблиц();
	
КонецПроцедуры


&НаСервере
Процедура ОбновитьАналитикуКроссТаблицТаблиц()
	
	МассивОписанийСтатей = Новый Массив;
	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);
	
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
	"ПотребностиПоГодам", "ПотребностиПоГодам",
	"СтатьяБюджета", "ПланыДокументаСтатьяБюджета",
	"Аналитика%1", "ПланыДокументаАналитика%1",
	ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ПланыДокументаГруппаСтатьяИАналитики)); 	  
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтаФорма, МассивОписанийСтатей, ПараметрыПоляВводаШапки); //ПараметрыПоляВвода());
	
КонецПроцедуры    

&НаКлиенте
Процедура РежимТаблицы(Команда)
	ПеренестиДанныеНоменклатуры();
	ЗаполнитьДерево();  
	ЗаполнитьСуммыТаблицыПоНДС();
	
	Элементы.Номенклатура.ОтборСтрок = Неопределено;  

	Элементы.Группа1.Видимость = Ложь;
	Элементы.Номенклатура.Видимость = Истина;      
	Элементы.ПланПоставокПоПериодамРежимВводаДанныхПоСтрокеКопия.Видимость = Истина;
	ПересчетОтносительногоОтклоненияЦен(,ЭтаФорма);	  
	ОбновитьАналитикиСтатейНоменклатуры();  
	
	ЗаполнитьОбоснованиеНоменклатуры();

КонецПроцедуры


&НаСервере
Процедура  ОбновитьАналитикиСтатейНоменклатуры()

	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);
	
	МассивОписанийСтатей = Новый Массив;
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
		"Объект.Номенклатура", "Номенклатура",
		"СтатьяБюджета", "ПланыДокументаНоменклатураСтатьяБюджета",
		"Аналитика%1", "ПланыДокументаАналитика%1",
		ФормыУХ.РазместитьВГруппеСтрокой(Элементы.НоменклатураСтатьяБюджета)); 
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);	

	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	ОбновитьСуммуДокументаИзКроссТаблицы();	
	ПриОжиданииВыполнитьКонтрольДокумента(); 
	УстановитьВыборЦФО(); 
	УстановитьЕдинственноеЦФО();
	СуммаБезНДСТекстПодвала();
    ЗаполнитьПланОплатНаСервере();  
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	// Добавление подчинённой строки.
	Если НоваяСтрока Тогда
		ТекДанные = Элементы.Номенклатура.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			Если Объект.ЕдиноеМестоПоставки И НЕ Копирование Тогда
				ТекДанные.МестоПоставки = Объект.МестоПоставки;
			КонецЕсли;	
			Если Не Копирование Тогда
				ТекДанные.Организация = Объект.ОрганизацияДляЗаключенияДоговора;
			КонецЕсли;			
		Иначе
			// Строка не выбрана. Ничего не делаем.
		КонецЕсли;
	Иначе
		// Не требуется добавление.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработкаВыбораПотребностей(ВыбранноеЗначение, Элемент);    
	ОбновитьУсловияОплатыПоУсловиюОплаты();
	ОбновитьСуммуДокументаИзКроссТаблицы();
	ПриОжиданииВыполнитьКонтрольДокумента();
	УстановитьВыборЦФО(); 
	УстановитьЕдинственноеЦФО(); 
	УстановитьОформлениеСтатейИАналитик();  
	ЗаполнитьСуммыТаблицыПоНДС();
	СуммаБезНДСТекстПодвала();      
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураНоменклатураПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Номенклатура.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		ПустаяЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка");
		ПустаяСтавкаНДС = ПредопределенноеЗначение("Справочник.СтавкиНДС.ПустаяСсылка");
		ЭтоКатегорияНоменклатуры = (ТипЗнч(СтрокаТаблицы.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок"));
		// Заполнение реквизитов строки таблицы.
		СтрокаТаблицы.ЭтоТоварнаяКатегория = ЭтоКатегорияНоменклатуры;
		СтруктураДополнительныхПараметров = СформироватьДополнительныеДанныеПоНоменклатуре();
		ДанныеНоменклатуры = ПолучитьДанныеПоНоменклатуре(СтрокаТаблицы.Номенклатура, СтруктураДополнительныхПараметров);
		Если ЭтоКатегорияНоменклатуры Тогда
			// Подменяем товарную категорию из шапки.
			// Категория. Обнулим дополнительно цены и количество.
			НовыйКоэффициент	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "Коэффициент", 1);
			НоваяЕдиница		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "ЕдиницаИзмерения", ПустаяЕдиницаИзмерения);
			НоваяСтавкаНДС		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "СтавкаНДС", ПустаяСтавкаНДС);
			СтрокаТаблицы.Коэффициент					 = НовыйКоэффициент;
			СтрокаТаблицы.ЕдиницаИзмерения				 = НоваяЕдиница;
			СтрокаТаблицы.СтавкаНДС						 = НоваяСтавкаНДС;
			СтрокаТаблицы.Цена							 = 0;
			СтрокаТаблицы.ЦенаПервоначальная			 = 0;
			СтрокаТаблицы.ОтклонениеОтносительное		 = 0;
			СтрокаТаблицы.Характеристика				 = Неопределено;
			СтрокаТаблицы.ХарактеристикиИспользуются	 = Ложь;
			ДатаОбъявления = Объект.ДатаОфициальногоОбъявленияЗакупки;
			ДатаИсполнения = Объект.ДатаИсполненияДоговора;
		Иначе
			// Номенклатура. Дополнительных действий не требуется.
			СтрокаТаблицы.Характеристика				 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "Характеристика", Неопределено);
			СтрокаТаблицы.ХарактеристикиИспользуются	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "ХарактеристикиИспользуются", Ложь);
			СтрокаТаблицы.Коэффициент					 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "Коэффициент", 1);
			СтрокаТаблицы.ЕдиницаИзмерения				 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "ЕдиницаИзмерения", ПустаяЕдиницаИзмерения);
			СтрокаТаблицы.Цена							 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "Цена", 0);
			СтрокаТаблицы.ЦенаПервоначальная			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "Цена", 0);
			СтрокаТаблицы.ОтклонениеОтносительное		 = 0;
			СтрокаТаблицы.СтавкаНДС						 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "СтавкаНДС", ПустаяСтавкаНДС);
		КонецЕсли;
		// Получим и заполним значение настройки ТребуетсяОбоснованиеНМЦ.    
		УстановитьДоступнуюСтатьюТаблицы();
		АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, "ПланыДокументаНоменклатураСтатьяБюджета");
		
	КонецЕсли;      
	СуммаБезНДСТекстПодвала();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступнуюСтатьюТаблицы()

	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата) <> Неопределено Тогда
		
		ИдентификаторСтроки = Элементы.Номенклатура.ТекущаяСтрока;
		ТекущаяСтрока = Объект.Номенклатура.НайтиПоИдентификатору(ИдентификаторСтроки); 
		ОтражениеВБюджетах = ПланированиеПотребностей.ОтражениеВБюджетахПоставок(Объект.Дата); 
		ВидБюджетаПланирования = ОтражениеВБюджетах.ВидБюджетаЗакупок;
		
		ЦентрализованныеЗакупкиВызовСервераУХ.УстановитьДоступныеСтатьиЭлементаПоПараметруПотребностей(ЭтотОбъект, "ПланыДокументаНоменклатураСтатьяБюджета", ТекущаяСтрока.Номенклатура, ТекущаяСтрока,ВидБюджетаПланирования,"СтатьяБюджета,Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураДатаПоставкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекДанные = Элементы.Номенклатура.ТекущиеДанные; 
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;     
	Если ВыбранноеЗначение < ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ПериодЗакупок,"ДатаНачала") Или
		ВыбранноеЗначение > Объект.ДатаИсполненияДоговора Тогда
		ВыбранноеЗначение = ТекДанные.ДатаПоставки;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Необходимо указывать дату поставки в рамках периода поставки'");		
		Сообщение.Сообщить();   
		Возврат;
	КонецЕсли;	
	Если ТипЗНЧ(Элементы.Номенклатура.ТекущиеДанные.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда  
		Если  ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") 
			И ВыбранноеЗначение <> НачалоКвартала(ВыбранноеЗначение) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало квартала'");
			Сообщение.Сообщить();
	        ВыбранноеЗначение = НачалоКвартала(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") 
			И ВыбранноеЗначение <> НачалоМесяца(ВыбранноеЗначение) Тогда
            Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало месяца'");
			Сообщение.Сообщить();
	        ВыбранноеЗначение = НачалоМесяца(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Год") 
			И ВыбранноеЗначение <> НачалоГода(ВыбранноеЗначение) Тогда
            Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для товарной категории необходимо указывать дату поставки на начало года'");
			Сообщение.Сообщить();
	        ВыбранноеЗначение = НачалоГода(ВыбранноеЗначение);
         КонецЕсли;
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура НоменклатураЦенаПриИзменении(Элемент)
	ТекДанные = Элементы.Номенклатура.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПриИзмененииЦеныВСтрокеНоменклатуры(ТекДанные);
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	//ЗаполнитьРасшифровки();  
	ОбновитьСуммуДокументаИзКроссТаблицы();
	ПриОжиданииВыполнитьКонтрольДокумента();
	ПересчетОтносительногоОтклоненияЦен(ТекДанные);      
	РассчитатьНМЦВВалютеРеглУчетаПоКурсуНаДатуКурсаНаСервере();	
КонецПроцедуры

 &НаКлиенте
Процедура ПриИзмененииЦеныВСтрокеНоменклатуры(СтрокаВход)
	СтрокаВход.Сумма = СтрокаВход.Количество * СтрокаВход.Цена;           
	ЦентрализованныеЗакупкиКлиентСерверУХ.РассчитатьНДССтроки(Объект.ЦенаВключаетНДС, СтрокаВход);
	Если Объект.ЦенаВключаетНДС Тогда
		СтрокаВход.СуммаБезНДС = 100 * СтрокаВход.Сумма / (100 + ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(СтрокаВход.СтавкаНДС,"Ставка"));
	Иначе
		СтрокаВход.СуммаБезНДС = СтрокаВход.Сумма;
	КонецЕсли;
	СуммаБезНДСТекстПодвала();

	ЗаполнениеПервоначальнойЦеныПриИзмененииЦены(СтрокаВход);
КонецПроцедуры		// ПриИзмененииЦеныВСтроке()

&НаКлиенте
Процедура ЗаполнениеПервоначальнойЦеныПриИзмененииЦены(СтрокаПотребности)
	СтруктураДополнительныхПараметров = СформироватьДополнительныеДанныеПоНоменклатуре();
	ДанныеНоменклатуры = ПолучитьДанныеПоНоменклатуре(СтрокаПотребности.Номенклатура, СтруктураДополнительныхПараметров);
	ЦенаИзначальная = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеНоменклатуры, "Цена", 0);
	Если СтрокаПотребности.ЦенаПервоначальная = 0 ИЛИ ЦенаИзначальная = 0 Тогда
		СтрокаПотребности.ЦенаПервоначальная = СтрокаПотребности.Цена;
	КонецЕсли;
	ПересчетОтносительногоОтклоненияЦен(СтрокаПотребности);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураКоличествоПриИзменении(Элемент)
	ТекДанные = Элементы.Номенклатура.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПриИзмененииЦеныВСтрокеНоменклатуры(ТекДанные);
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	//ЗаполнитьРасшифровки();  
	ОбновитьСуммуДокументаИзКроссТаблицы();
	ПриОжиданииВыполнитьКонтрольДокумента();
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	Если ВидСтатьиБюджетирования(ВыбранноеЗначение) <> ВидСтатьи Тогда    
		СтруктураПараметров = Новый Структура();      
		СтруктураПараметров.Вставить("СтараяДата",Объект.Дата);
		СтруктураПараметров.Вставить("НоваяДата",ВыбранноеЗначение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьСтатьиПоМэппингу", ЭтотОбъект,СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'По настройкам планирования закупок дата документа попадает в период с другими настройками планирования. Данные по статье будут изменены или очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;	

КонецПроцедуры 

&НаКлиенте
Процедура ПерезаполнитьСтатьиПоМэппингу(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда 
    	Объект.Дата = Параметры.СтараяДата;
	Иначе                                                  
    	Объект.Дата = Параметры.НоваяДата;
		ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры); 
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСтатьиПоМэппинуНаСервере(Параметры) 
	
	ВидСтатьи = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Параметры.НоваяДата);    
	Если Параметры.НоваяДата > Параметры.СтараяДата Тогда
	    ТаблицаСМэппингом = ПланированиеПотребностей.ЗаменаСтатейИАналитикПоНастройкамЛимитов(Параметры.НоваяДата,Объект.Номенклатура.Выгрузить());
		Объект.Номенклатура.Очистить();
		Объект.Номенклатура.Загрузить(ТаблицаСМэппингом);
	Иначе
		Для Каждого Строка ИЗ Объект.Номенклатура Цикл
			Строка.СтатьяБюджета = Неопределено;
			Строка.Аналитика1 = Неопределено;
			Строка.Аналитика2 = Неопределено;
			Строка.Аналитика3 = Неопределено;
			Строка.Аналитика4 = Неопределено;
			Строка.Аналитика5 = Неопределено;
			Строка.Аналитика6 = Неопределено;
		КонецЦикла;	
	КонецЕсли;	  
	ЗаполнитьДерево();	
	Если ВидСтатьи <> Неопределено И Элементы.Найти("ПланыДокументаСтатьяБюджета") <> Неопределено Тогда
		Элементы.ПланыДокументаСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;
		Элементы.ПланыДокументаНоменклатураСтатьяБюджета.ОграничениеТипа = ВидСтатьи.ТипЗначения;   
	Иначе 
		Если Элементы.Найти("ПланыДокументаСтатьяБюджета") <> Неопределено Тогда
			Элементы.ПланыДокументаГруппаСтатьяИАналитики.Видимость  = Ложь;
			Элементы.НоменклатураСтатьяБюджета.Видимость = Ложь;       
			Элементы.ПланОплатыСтатьиБюджета.Видимость = Ложь;
		Иначе 
			УстановитьОформлениеСтатейИАналитик();    
			Элементы.ПланыДокументаГруппаСтатьяИАналитики.Видимость  = Истина;
			Элементы.НоменклатураСтатьяБюджета.Видимость = Истина;         
			Элементы.ПланОплатыСтатьиБюджета.Видимость = Истина;
		КонецЕсли;	
	КонецЕсли; 
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтаФорма);
	
КонецПроцедуры

