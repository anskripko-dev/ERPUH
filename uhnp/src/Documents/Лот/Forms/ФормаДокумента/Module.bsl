		|	КОНЕЦ КАК ХарактеристикиИспользуются,
		|	ТЗ_Объединение.АналитикаПланирования КАК АналитикаПланирования,
		|	ТЗ_Объединение.АналитикаИсточника КАК АналитикаИсточника,
		|	ТЗ_Объединение.СтатьяБюджета КАК СтатьяБюджета,
		|	ТЗ_Объединение.Назначение как Назначение, 
		|	ТЗ_Объединение.Аналитика1 КАК Аналитика1,
		|	ТЗ_Объединение.Аналитика2 КАК Аналитика2,
		|	ТЗ_Объединение.Аналитика3 КАК Аналитика3,
		|	ТЗ_Объединение.Аналитика4 КАК Аналитика4,
		|	ТЗ_Объединение.Аналитика5 КАК Аналитика5,
		|	ТЗ_Объединение.Аналитика6 КАК Аналитика6
		|ИЗ
		|	ТЗ_Объединение КАК ТЗ_Объединение
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЗ_Объединение.Организация,
		|	ТЗ_Объединение.ЦФО,
		|	ТЗ_Объединение.МестоПоставки, 
		|	ТЗ_Объединение.Назначение,		
		|	ТЗ_Объединение.Проект,
		|	ТЗ_Объединение.Коэффициент,
		|	ТЗ_Объединение.ДатаПоставки,
		|	ТЗ_Объединение.Номенклатура,
		|	ТЗ_Объединение.ЕдиницаИзмерения,
		|	ТЗ_Объединение.СтавкаНДС,
		|	ТЗ_Объединение.Характеристика,
		|	ТЗ_Объединение.ПериодПотребности,
		|	ТЗ_Объединение.Цена,
		|	ВЫБОР
		|		КОГДА ТЗ_Объединение.Номенклатура ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ТЗ_Объединение.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик ЕСТЬ NULL
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ВЫБОР
		|							КОГДА ВЫРАЗИТЬ(ТЗ_Объединение.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
		|								ТОГДА ЛОЖЬ
		|							ИНАЧЕ ВЫБОР
		|									КОГДА ВЫРАЗИТЬ(ТЗ_Объединение.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ПустаяСсылка)
		|										ТОГДА ЛОЖЬ
		|									ИНАЧЕ ИСТИНА
		|								КОНЕЦ
		|						КОНЕЦ
		|				КОНЕЦ
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ТЗ_Объединение.Номенклатура ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ,
		|	ТЗ_Объединение.АналитикаИсточника,
		|	ТЗ_Объединение.АналитикаПланирования,
		|	ТЗ_Объединение.СтатьяБюджета,
		|	ТЗ_Объединение.Аналитика1,
		|	ТЗ_Объединение.Аналитика2,
		|	ТЗ_Объединение.Аналитика3,
		|	ТЗ_Объединение.Аналитика4,
		|	ТЗ_Объединение.Аналитика5,
		|	ТЗ_Объединение.Аналитика6,
		|	ТЗ_Объединение.Цена";

	Запрос.УстановитьПараметр("ДатаСреза", ДатаДокумента);
	Запрос.УстановитьПараметр("ПараметрТаблицаПотребностей", ТаблицаПотребностей);
	Запрос.УстановитьПараметр("ТЗ_ТаблицаНоменклатуры", Объект.Номенклатура.Выгрузить());
	Запрос.УстановитьПараметр("КоэффициентПересчетаВалюты", ОписаниеКоэффициента.Коэффициент);
	ЗаполнитьСуммыТаблицыПоНДС();

	Возврат Запрос.Выполнить();
КонецФункции

&НаСервере
Процедура СуммаБезНДСТекстПодвала()

	Элементы.НоменклатураСуммаБезНДС.ТекстПодвала = Объект.Номенклатура.Выгрузить(,"СуммаБезНДС").Итог("СуммаБезНДС");

Конецпроцедуры

&НаСервере
Процедура ЗаполнитьСуммыТаблицыПоНДС()
	
	Для Каждого Строка ИЗ Объект.Номенклатура Цикл
		Если Объект.ЦенаВключаетНДС Тогда
			Строка.СуммаБезНДС = 100 * Строка.Сумма / (100 + Строка.СтавкаНДС.Ставка);
		Иначе
			Строка.СуммаБезНДС = Строка.Сумма;
		КонецЕсли;
	КонецЦикла;	    
	СуммаБезНДСТекстПодвала(); 
	
КонецПроцедуры

