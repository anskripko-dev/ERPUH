&НаКлиенте
Процедура ДатаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
		// Вставить содержимое обработчика.   
	СтандартнаяОбработка = Ложь;     
	Если ВидСтатьиБюджетирования(Дата(Текст)) <> ВидСтатьи Тогда    
		СтруктураПараметров = Новый Структура();      
		СтруктураПараметров.Вставить("СтараяДата",Объект.Дата);
		СтруктураПараметров.Вставить("НоваяДата",Дата(Текст));
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьСтатьиПоМэппингу", ЭтотОбъект,СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'По настройкам планирования закупок дата документа попадает в период с другими настройками планирования. Данные по статье будут изменены или очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе 
		Объект.Дата = Дата(Текст);
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура НоменклатураДатаПоставкиПриИзменении(Элемент)
	
	ТекДанные = Элементы.Номенклатура.ТекущиеДанные; 
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	ВыбранноеЗначение = ТекДанные.ДатаПоставки;  
	ДатаОбъявления = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ПериодЗакупок,"ДатаНачала");
	ДатаИсполнения = Объект.ДатаИсполненияДоговора;
	
	Если ВыбранноеЗначение < ДатаОбъявления Или
		ВыбранноеЗначение > ДатаИсполнения Тогда
		ТекДанные.ДатаПоставки = Дата("00010101");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Необходимо указывать дату поставки в рамках периода поставки'");		
		Сообщение.Сообщить();   
		Возврат;
	КонецЕсли;	
	
	Если ТипЗНЧ(ТекДанные.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда  
		Если  ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") 
			И ВыбранноеЗначение <> НачалоКвартала(ВыбранноеЗначение) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для категории закупок необходимо указывать дату поставки на начало квартала'");
			Сообщение.Сообщить();
			ТекДанные.ДатаПоставки = НачалоКвартала(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") 
			И ВыбранноеЗначение <> НачалоМесяца(ВыбранноеЗначение) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для категории закупок необходимо указывать дату поставки на начало месяца'");
			Сообщение.Сообщить();
			ТекДанные.ДатаПоставки = НачалоМесяца(ВыбранноеЗначение);
		ИначеЕсли ПериодичностьЦентрализованныхЗакупок = ПредопределенноеЗначение("Перечисление.Периодичность.Год") 
			И ВыбранноеЗначение <> НачалоГода(ВыбранноеЗначение) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для категории закупок необходимо указывать дату поставки на начало года'");
			Сообщение.Сообщить();
			ТекДанные.ДатаПоставки = НачалоГода(ВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если ЗначениеЗаполнено(Объект.СтрокаПланаЗакупок) Тогда
		ТекстСообщения = НСтр("ru = 'Запрещено добавлять дополнительные строки для лотов, созданных по строке плана.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Отказ = Истина;
	Иначе                 
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаИсполненияДоговораОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	МаксимальнаяДата = Дата(1,1,1); 

	Если Элементы.ПотребностиПоГодам.Видимость Тогда
		ПеренестиДанныеНоменклатуры();
	КонецЕсли;	
	Для Каждого Строка ИЗ Объект.Номенклатура Цикл
		Если Строка.ДатаПоставки > МаксимальнаяДата Тогда
			МаксимальнаяДата = Строка.ДатаПоставки;
		КонецЕсли;
	КонецЦикла;
	Если Объект.ДатаИсполненияДоговора < МаксимальнаяДата Тогда
        Объект.ДатаИсполненияДоговора = МаксимальнаяДата;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Дата исполнения договора не может быть меньше максимальной даты периода поставок'");		
		Сообщение.Сообщить();   
	КонецЕсли;	
КонецПроцедуры

