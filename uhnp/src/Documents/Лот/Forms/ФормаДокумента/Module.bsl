&НаКлиенте
Процедура ПотребностиПоГодамВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ПотребностиПоГодамОбоснованиеНациональногоРежима" Тогда  
		СтандартнаяОбработка = Ложь;
		
		ТекДанные = Элементы.ПотребностиПоГодам.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Номенклатура", ТекДанные.Номенклатура);
		СтрокиОбоснований = Объект.ОбоснованияИсключенияНациональногоРежима.НайтиСтроки(ПараметрыОткрытия); 
		ПараметрыОткрытия.Вставить("Исключение",);
		ПараметрыОткрытия.Вставить("ДополнительнаяИнформация");
		Для Каждого Строка ИЗ СтрокиОбоснований Цикл
			ПараметрыОткрытия.Исключение = Строка.Исключение;
			ПараметрыОткрытия.ДополнительнаяИнформация = Строка.ДополнительнаяИнформация;
		КонецЦикла;	    
		Оповещение = Новый ОписаниеОповещения("ОписаниеВыбораОбоснования", ЭтотОбъект);    
		
		Форма = ОткрытьФорму("Документ.Лот.Форма.ИсключенияИзНациональногоРежима",ПараметрыОткрытия,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);//Оповещение	
	КонецЕсли;
КонецПроцедуры   

&НаКлиенте
Процедура НоменклатураВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "НоменклатураОбоснованиеНациональногоРежима" Тогда  
		СтандартнаяОбработка = Ложь;
		
		ТекДанные = Элементы.Номенклатура.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Номенклатура", ТекДанные.Номенклатура);
		СтрокиОбоснований = Объект.ОбоснованияИсключенияНациональногоРежима.НайтиСтроки(ПараметрыОткрытия); 
		ПараметрыОткрытия.Вставить("Исключение",);
		ПараметрыОткрытия.Вставить("ДополнительнаяИнформация");
		Для Каждого Строка ИЗ СтрокиОбоснований Цикл
			ПараметрыОткрытия.Исключение = Строка.Исключение;
			ПараметрыОткрытия.ДополнительнаяИнформация = Строка.ДополнительнаяИнформация;
		КонецЦикла;	    
		Оповещение = Новый ОписаниеОповещения("ОписаниеВыбораОбоснования", ЭтотОбъект);    
		
		Форма = ОткрытьФорму("Документ.Лот.Форма.ИсключенияИзНациональногоРежима",ПараметрыОткрытия,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);//Оповещение	
	КонецЕсли;

КонецПроцедуры

