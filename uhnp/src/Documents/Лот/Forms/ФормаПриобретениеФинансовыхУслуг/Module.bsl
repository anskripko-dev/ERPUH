#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	 // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды  
	
	Если Параметры.Ключ.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	ОпределитьСостояниеОбъекта();

	КонтрольУХ.ПодготовитьФормуНаСервере(ЭтотОбъект, Элементы.Страницы);
	
	ЗаполнитьСписокЗначенийПроцентнойСтавки();   
	СформироватьТаблицуГрафикаНаФорме();
КонецПроцедуры 

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	ПриЧтенииСозданииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	Элементы.ФормаВыборАльтернативУХ.Видимость = Ложь;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтаФорма, "СостояниеЗаявки") Тогда
		ДействияСогласованиеУХСервер.ОпределитьСостояниеЗаявки(ЭтаФорма);
		УстановитьОформлениеКнопкиОК();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти  

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СуммаПривлеченияПриИзменении(Элемент)
	ПриОжиданииВыполнитьКонтрольДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ПроцентнаяСтавкаПриИзменении(Элемент)
	 
	РассчитатьСуммуПроцентовНаСервере();
	ПриОжиданииВыполнитьКонтрольДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроцентныйПериодПриИзменении(Элемент)
	ПриОжиданииВыполнитьКонтрольДокумента(); 
	РассчитатьСуммуПроцентовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПривлеченияПриИзменении(Элемент)
	РассчитатьСуммуПроцентовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатаВозвратаПриИзменении(Элемент)
	РассчитатьСуммуПроцентовНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыЗаявки

&НаКлиенте
Процедура ЗаявкиНаПривлечениеФинансированияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкиНаПривлечениеФинансированияПослеУдаления(Элемент)
	ПересчитатьИтогиДокумента();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыГрафикРасчетов
&НаКлиенте
Процедура ГрафикРасчетовПриАктивизацииСтроки(Элемент) 
	
	ТекущиеДанные = Элементы.ГрафикРасчетов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ГрафикРасчетовСумма = 0;
		Возврат;	
	КонецЕсли;
	
	НовыйОтборСтрок = Новый ФиксированнаяСтруктура("Дата",   ТекущиеДанные.Дата);
	Элементы.ГрафикРасчетовДетализация.ОтборСтрок 	= НовыйОтборСтрок;
	ГрафикРасчетовСумма  = ТекущиеДанные.Сумма;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьЗаявку(Команда)
	
	ОбработкаОповещения = Новый ОписаниеОповещения("ДобавитьЗаявкуПродолжение", ЭтотОбъект);  
	
	ПараметрыОтбора = Новый Структура("ПериодичностьНачисленияПроцентов, ВалютаДокумента, НаличиеЛота", Объект.ПроцентныйПериод, Объект.ВалютаДокумента, Ложь);
	
	ПараметрыВыбораЗаявок = Новый Структура();
	ПараметрыВыбораЗаявок.Вставить("Отбор", ПараметрыОтбора);
	
	ОткрытьФорму("Документ.ЗаявкаНаПривлечениеФинансирования.ФормаВыбора", ПараметрыВыбораЗаявок,ЭтотОбъект,,,,ОбработкаОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры      

&НаКлиенте
Процедура ДобавитьЗаявкуПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;		 
	КонецЕсли; 
	
	Модифицированность = Истина;
	ДобавитьЗаявкуНаСервере(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьГрафик(Команда)

	Элементы.ГрафикРасчетов.Видимость 	= Истина;
	Элементы.ПоказатьГрафик.Видимость 	= Ложь;
	Элементы.СкрытьГрафик.Видимость		= Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьГрафик(Команда)
	
	Элементы.ГрафикРасчетов.Видимость 	= Ложь;
	Элементы.ПоказатьГрафик.Видимость 	= Истина;
	Элементы.СкрытьГрафик.Видимость		= Ложь;
	
КонецПроцедуры

#КонецОбласти	

#Область СлужебныеПроцедурыИФункции
// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
    ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры
&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
    ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ПриОжиданииВыполнитьКонтрольДокумента()
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьКонтрольДокумента", 0.5, Истина);
КонецПроцедуры   

&НаКлиенте
Процедура Подключаемый_ТаблицаКонтроляДокументаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТД =  Элемент.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	КонтрольУХКлиент.ПоказатьРасшифровкуКонтроля(Объект, ТД);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаКонтроляДокументаПриАктивизацииЯчейки(Элемент)
	Элемент.ТекущаяСтрока = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКонтрольДокумента()
	ВыполнитьКонтрольДокумента();		
КонецПроцедуры 

&НаСервере
Процедура ВыполнитьКонтрольДокумента()
	КонтрольУХКлиентСервер.ВыполнитьИнтерактивныйКонтроль(ЭтотОбъект);
КонецПроцедуры 

&НаКлиенте
Процедура ВыполнитьКомандуУХ(Команда)
	
	Если Команда.Имя = "ВыполнитьКонтрольДокумента" Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьКонтрольДокумента", 0.5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаявкуНаСервере(Заявка)
	
	НайтиЗаявки = Объект.ЗаявкиНаПривлечениеФинансирования.НайтиСтроки(Новый Структура("Заявка",Заявка));
	
	Если НайтиЗаявки.Количество() Тогда
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗНПФ.Ссылка КАК Заявка,
		|	ЗНПФ.СуммаЗаимствования КАК Сумма,
		|	ЗНПФ.ВалютаДокумента КАК Валюта,
		|	ЗНПФ.ДатаПривлечения КАК ДатаПривлечения,
		|	ЗНПФ.ДатаВозврата КАК ДатаВозврата,
		|	ЗНПФ.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|	ЗНПФ.ПериодичностьНачисленияПроцентов КАК ПериодичностьНачисленияПроцентов,
		|	ЗНПФ.СуммаПроцентов КАК СуммаПроцентов,
		|	ЗНПФ.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредствПроценты,
		|	ЗНПФ.СтатьяДвиженияДенежныхСредствОсновнойДолг КАК СтатьяДвиженияДенежныхСредствОсновнойДолг,
		|	ЗНПФ.Аналитика1 КАК АналитикаПроценты1,
		|	ЗНПФ.Аналитика2 КАК АналитикаПроценты2,
		|	ЗНПФ.Аналитика3 КАК АналитикаПроценты3,
		|	ЗНПФ.Аналитика4 КАК АналитикаПроценты4,
		|	ЗНПФ.Аналитика5 КАК АналитикаПроценты5,
		|	ЗНПФ.Аналитика6 КАК АналитикаПроценты6,
		|	ЗНПФ.ЦФО КАК ЦФО,
		|	ЗНПФ.Проект КАК Проект,
		|	ЗНПФ.АналитикаОсновнойДолг1 КАК АналитикаОсновнойДолг1,
		|	ЗНПФ.АналитикаОсновнойДолг2 КАК АналитикаОсновнойДолг2,
		|	ЗНПФ.АналитикаОсновнойДолг4 КАК АналитикаОсновнойДолг4,
		|	ЗНПФ.АналитикаОсновнойДолг6 КАК АналитикаОсновнойДолг6,
		|	ЗНПФ.АналитикаОсновнойДолг3 КАК АналитикаОсновнойДолг3,
		|	ЗНПФ.АналитикаОсновнойДолг5 КАК АналитикаОсновнойДолг5,
		|	ЗНПФ.Организация КАК Организация
		|ИЗ
		|	Документ.ЗаявкаНаПривлечениеФинансирования КАК ЗНПФ
		|ГДЕ
		|	ЗНПФ.Ссылка = &Заявка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаЗаявки  = Объект.ЗаявкиНаПривлечениеФинансирования.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаявки, ВыборкаДетальныеЗаписи);
	КонецЦикла; 
	
	ПересчитатьИтогиДокумента();
	Документы.Лот.РассчитатьСуммуПроцентов(Объект);
КонецПроцедуры    

&НаСервере
Процедура ПересчитатьИтогиДокумента()
	
	Объект.СуммаПривлечения 	= Объект.ЗаявкиНаПривлечениеФинансирования.Итог("Сумма");
	ПроцентнаяСтавка = Неопределено;
	
	Для каждого СтрокаЗаявка Из Объект.ЗаявкиНаПривлечениеФинансирования Цикл
		Если ПроцентнаяСтавка = Неопределено Тогда
			ПроцентнаяСтавка =  СтрокаЗаявка.ПроцентнаяСтавка;                 		
		Иначе 
			ПроцентнаяСтавка = Мин(ПроцентнаяСтавка,СтрокаЗаявка.ПроцентнаяСтавка);
		КонецЕсли;
	КонецЦикла;	
		
	Объект.ПроцентнаяСтавка		= ПроцентнаяСтавка;
	Документы.Лот.РассчитатьСуммуПроцентов(Объект);
	ЗаполнитьСписокЗначенийПроцентнойСтавки();
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСписокЗначенийПроцентнойСтавки()
	
	Элементы.ПроцентнаяСтавка.СписокВыбора.Очистить();       
	МассивПроцентныхСтавок = Новый СписокЗначений; 
	Для каждого СтрокаЗаявка Из Объект.ЗаявкиНаПривлечениеФинансирования Цикл
		МассивПроцентныхСтавок.Добавить(СтрокаЗаявка.ПроцентнаяСтавка);
	КонецЦикла;
	МассивПроцентныхСтавок.СортироватьПоЗначению();
	Элементы.ПроцентнаяСтавка.СписокВыбора.ЗагрузитьЗначения(МассивПроцентныхСтавок.ВыгрузитьЗначения());

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуПроцентовНаСервере()
	
	Документы.Лот.РассчитатьСуммуПроцентов(Объект);
	
	СформироватьТаблицуГрафикаНаФорме();
КонецПроцедуры  

&НаСервере
Процедура СформироватьТаблицуГрафикаНаФорме()
	ГрафикРасчетов.Очистить();                  
	ГрафикРасчетовДетализация.Очистить();
	
	ГрафикПериоды = Объект.ГрафикУплатыПроцентов.Выгрузить();
	ГрафикПериоды.Свернуть("Дата", "Сумма");
	
	ГрафикРасчетов.Загрузить(ГрафикПериоды);
	
	Для каждого СтрокаЗаявка Из Объект.ЗаявкиНаПривлечениеФинансирования Цикл
		
		СтрокиГрафика = Объект.ГрафикУплатыПроцентов.НайтиСтроки(Новый Структура("Заявка",СтрокаЗаявка.Заявка));
		
		Для каждого СтрокаГрафика Из СтрокиГрафика Цикл
		
			СтрокаДетализация = ГрафикРасчетовДетализация.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДетализация, СтрокаЗаявка);
			ЗаполнитьЗначенияСвойств(СтрокаДетализация, СтрокаГрафика);
				
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

#Область ВызовыОбщихПроцедурИФункцийСогласованияОбъектов

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()

	ДействияСогласованиеУХСервер.НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ОпределитьСостояниеОбъекта(ОбновитьОтветственныхВход = Ложь)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "СостояниеЗаявки") Тогда
		ДействияСогласованиеУХСервер.ОпределитьСостояниеЗаявки(ЭтотОбъект, ОбновитьОтветственныхВход);
		УстановитьОформлениеКнопкиОК();
	Иначе
		// Панель согласования еще не создана.
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеКнопкиОК()
	Если Элементы.Найти("КнопкаОК") <> Неопределено Тогда
		Если РеквизитСостояниеЗаявки(ЭтотОбъект) = Перечисления.СостоянияСогласования.Черновик И ЗначениеЗаполнено(РеквизитСогласующий(ЭтотОбъект)) Тогда 
			Элементы.КнопкаОК.Заголовок = НСтр("ru = 'На согласование'");
			Элементы.КнопкаОК.Картинка = БиблиотекаКартинок.Утвердить;
		Иначе
			Элементы.КнопкаОК.Заголовок = НСтр("ru = 'Провести и закрыть'");
			Элементы.КнопкаОК.Картинка = Новый Картинка;
		КонецЕсли;
	Иначе
		// Элемент не найден. Например, у пользователя нет прав на запись документа.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СостояниеЗаявкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение = РеквизитСостояниеЗаявки(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;

	ПроверитьСохранениеИзменитьСтатус(ВыбранноеЗначение);
	
КонецПроцедуры

// Проверяет сохранение текущего объекта и изменяет его статус
// НовоеЗначениеСтатусаВход.
&НаКлиенте
Процедура ПроверитьСохранениеИзменитьСтатус(НовоеЗначениеСтатусаВход)
	Если (Объект.Ссылка.Пустая()) ИЛИ (Модифицированность) Тогда
		СтруктураПараметров = Новый Структура("ВыбранноеЗначение", НовоеЗначениеСтатусаВход);
		ОписаниеОповещения = Новый ОписаниеОповещения("СостояниеЗаявкиОбработкаВыбораПродолжение", ЭтотОбъект, СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'Данные еще не записаны.
		|Изменение состояния возможно только после записи данных.
		|Данные будут записаны.'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	ИзменитьСостояниеЗаявкиКлиент(НовоеЗначениеСтатусаВход);	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСостояниеЗаявкиКлиент(ВыбранноеЗначение)
	ДействияСогласованиеУХКлиент.ИзменитьСостояниеЗаявкиКлиент(ВыбранноеЗначение, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СостояниеЗаявкиОбработкаВыбораПродолжение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Записать();
		ИзменитьСостояниеЗаявкиКлиент(Параметры.ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

