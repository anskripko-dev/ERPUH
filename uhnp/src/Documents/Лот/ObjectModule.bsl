Функция ВыгрузитьНоменклатуруПоСтроке(СтрокаПланаЗакупокЗаполнения) 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланированиеПотребностейОстатки.АналитикаИсточника КАК АналитикаИсточника,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования КАК АналитикаПланирования,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.ДатаОперации КАК ДатаПоставки,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект КАК ДокументПланирования,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Характеристика КАК Характеристика,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент КАК Коэффициент,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.ЦФО КАК ЦФО,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Проект КАК Проект,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.МестоПоставки КАК МестоПоставки,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Организация КАК Организация,
	               |	ПланированиеПотребностейОстатки.КоличествоОстаток КАК Количество,
	               |	ПланированиеПотребностейОстатки.СуммаОстаток КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ПланированиеПотребностейОстатки.СуммаОстаток / ПланированиеПотребностейОстатки.КоличествоОстаток
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ЦенаПервоначальная,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ПланированиеПотребностейОстатки.СуммаОстаток / ПланированиеПотребностейОстатки.КоличествоОстаток
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Цена,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.Назначение КАК Назначение,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПоставки.СтавкаНДС КАК СтавкаНДС
	               |ИЗ
	               |	РегистрНакопления.ПланированиеПотребностей.Остатки(
	               |			,
	               |			АналитикаИсточника.ОбъектПланирования.Объект = &СтрокаПланаЗакупок
	               |				ИЛИ АналитикаПланирования.ОбъектПланирования.Объект = &СтрокаПланаЗакупок) КАК ПланированиеПотребностейОстатки
	               |ГДЕ
	               |	ПланированиеПотребностейОстатки.СуммаОстаток > 0"; 
	Запрос.УстановитьПараметр("СтрокаПланаЗакупок",СтрокаПланаЗакупокЗаполнения);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Процедура ЗаполнитьИзЗакупочнойПроцедуры(ВходящаяЗакупочнаяПроцедура) Экспорт
	Если ЗначениеЗаполнено(ВходящаяЗакупочнаяПроцедура) Тогда
		// Заполнение шапки.
		Владелец			 = ВходящаяЗакупочнаяПроцедура;
		ЗакупочнаяПроцедура	 = ВходящаяЗакупочнаяПроцедура;
		ШаблонЛота			 = Документы.Лот.ПолучитьШаблонЛота(ЗакупочнаяПроцедура);
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ШаблонЛота); 
			
		// Заполение табличных частей.
		ВыгрузкаТребованияКПоставщикам = Владелец.ТребованияКПоставщикам.Выгрузить();
		ТребованияКПоставщикам.Загрузить(ВыгрузкаТребованияКПоставщикам);
		ВыгрузкаТребованияКДокументам = Владелец.ТребованияКСоставуДокументов.Выгрузить();
		ТребованияКСоставуДокументов.Загрузить(ВыгрузкаТребованияКДокументам);
		//Заполнение вида закупки
		ВидЗакупки = Перечисления.ВидЛотовойЗакупки.ЛотоваяЗакупка;  
			
		ПриобретениеФинансовыхУслуг =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВходящаяЗакупочнаяПроцедура, "ПриобретениеФинансовыхУслуг");
		
		Если ПриобретениеФинансовыхУслуг Тогда
			
			МетодОценкиПредложенийПоставщиков 	= Перечисления.МетодыОценкиПредложенийПоставщиков.ПоКритериям;
            ЗапретПревышенияНМЦ					= Истина;
			 	
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьИзСтрокиПланаЗакупок(СтрокаПланаЗакупокЗаполнения) Экспорт
	Если ЗначениеЗаполнено(СтрокаПланаЗакупокЗаполнения) Тогда
		СтрокаПланаЗакупок = СтрокаПланаЗакупокЗаполнения;
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтрокаПланаЗакупокЗаполнения,,"Номер"); 
		
		ЭтотОбъект.Проведен = Ложь;
		ЭтотОбъект.ВидЗакупки = Перечисления.ВидЛотовойЗакупки.ЛотоваяЗакупка;
		ВыгрузкаНоменклатуры = ВыгрузитьНоменклатуруПоСтроке(СтрокаПланаЗакупокЗаполнения);
		Номенклатура.Загрузить(ВыгрузкаНоменклатуры);  
		ТекущаяДатаПользователя = ОбщегоНазначения.ТекущаяДатаПользователя();
		
		Для Каждого Строка ИЗ Номенклатура Цикл
			Строка.ПериодПотребности = СформироватьПериодПоГодуИМесяцу(Месяц(Строка.ДатаПоставки), Год(Строка.ДатаПоставки)); 
			Строка.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
			Строка.Сумма, 
			ЦенаВключаетНДС,Строка.СтавкаНДС.Ставка); 
			
		КонецЦикла; 
		ПланОплаты.Загрузить(СтрокаПланаЗакупокЗаполнения.ПланОплаты.Выгрузить());
		ЭтапыГрафикаОплаты.Загрузить(СтрокаПланаЗакупокЗаполнения.ЭтапыГрафикаОплаты.Выгрузить());
		Календарь = СтрокаПланаЗакупокЗаполнения.Календарь;
		ЗаполнитьИзЗапросаНаПроведениеЗакупки(
		Документы.ОбоснованиеТребованийКЗакупочнойПроцедуре.ПолучитьПоСтрокеПланаЗакупок(
		СтрокаПланаЗакупокЗаполнения));
	КонецЕсли;
КонецПроцедуры

Функция СформироватьПериодПоГодуИМесяцу(МесяцВход, ГодВход)
	РезультатФункции = Справочники.Периоды.ПустаяСсылка();
	Если (ЗначениеЗаполнено(МесяцВход)) И (ЗначениеЗаполнено(ГодВход)) Тогда
		НоваяДата = Дата(ГодВход, МесяцВход, 1);
		Периодичность = ЦентрализованныеЗакупкиУХ.ПолучитьПериодичностьЗакупок();
		РезультатФункции = ОбщегоНазначенияУХ.ОпределитьПериодПоДате(НоваяДата, Периодичность);
	Иначе
		РезультатФункции = Справочники.Периоды.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

Функция ПроверитьЗаполнениеХарактеристикОтменить(Отказ) Экспорт
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(
		ЭтотОбъект,
		Новый Массив,
		Отказ,
		УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ПараметрыПроверкиЗаполненияХарактеристик());
	Возврат Отказ;
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка ИЛИ Скрыт Тогда
		Возврат;
	КонецЕсли;   
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);  
	
	ДополнитьПериодПотребностей();
	ПроверитьУжеВведенДругойЛот(Отказ);
	ПроверитьУстановитьОрганизациюДляЗаключенияДоговора();
	ПроверитьНенулевыеСуммы(Отказ);
	ПроверитьКоличествоСуммыПоЗонтичнымЗакупкам(Отказ);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка ИЛИ Скрыт Тогда
		Возврат;
	КонецЕсли;
	Если ПометкаУдаления Тогда
		ОчиститьДвиженияРегистраЛотыПланаЗакупок();
	Иначе
		Если ЦентрализованныеЗакупкиУХ.ОбъектУтвержден(Ссылка)
            	И ПроверитьЗаполнениеХарактеристикОтменить(Отказ) Тогда
			Возврат;
		КонецЕсли;
		ЗаписатьДвиженияРегистраЛотыПланаЗакупок();
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ТипЗаполнения = ТипЗнч(ДанныеЗаполнения);   
	Если ТипЗаполнения = Тип("Структура") И  НЕ ДанныеЗаполнения.Свойство("ЗакупочнаяПроцедура") Тогда 
		Возврат;
	КонецЕсли;	
	Если ТипЗаполнения = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
		Владелец = ДанныеЗаполнения;
	ИначеЕсли ТипЗаполнения = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения); 
		Если ДанныеЗаполнения.Свойство("СтрокаПланаЗакупок") Тогда
			СтрокаПланаЗакупок = ДанныеЗаполнения.СтрокаПланаЗакупок;
		Иначе
			// Нет данных для заполнения строки плана закупок.
		КонецЕсли;    
		Владелец = ДанныеЗаполнения.ЗакупочнаяПроцедура;
	ИначеЕсли ТипЗаполнения = Тип("ДокументСсылка.СтрокаПланаЗакупок") Тогда
		СтрокаПланаЗакупок = ДанныеЗаполнения;
	КонецЕсли;
	ЗаполнитьИзЗакупочнойПроцедуры(Владелец);
	Если Владелец = Неопределено И ЗначениеЗаполнено(ЗакупочнаяПроцедура) Тогда
		Владелец = ЗакупочнаяПроцедура; 
	КонецЕсли;	           
	Если ЗначениеЗаполнено(СтрокаПланаЗакупок) Тогда
		ЗаполнитьИзСтрокиПланаЗакупок(СтрокаПланаЗакупок);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗакупочнаяПроцедура) Тогда
		ЭтапыГрафикаОплаты.Загрузить(ЗакупочнаяПроцедура.ЭтапыГрафикаОплаты.Выгрузить());   
		Календарь = ЗакупочнаяПроцедура.Календарь;
		ДатаИсполненияДоговора = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Владелец.ПериодЗакупок,"ДатаОкончания");	
	КонецЕсли;    
	УсловияОплаты = ЗакупочнаяПроцедура.УсловияОплаты;
	Если НЕ ЗначениеЗаполнено(СтрокаПланаЗакупок) Тогда
		Если ТипЗнч(Владелец) = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
			ПериодЗакупок = Владелец.ПериодЗакупок;
		Иначе
			СтандартнаяОбработка = Ложь;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Невозможно создать лот без указания строки плана закупок, к которой он относится'");
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВалютаДокумента) Тогда
		ВалютаДокумента = Константы.ВалютаУчетаЦентрализованныхЗакупок.Получить();
	КонецЕсли;
	Если ЗначениеЗаполнено(Владелец) Тогда
		СпособВыбораПоставщика = Владелец.СпособВыбораПоставщика;
	Иначе
		СпособВыбораПоставщика = Неопределено;
	КонецЕсли;   
	ЗапретПревышенияНМЦ = Истина;

	МетодОценкиПредложенийПоставщиков = 
		Документы.Лот.ПолучитьМетодОценкиПоСпособуВыбораПоставщика(СпособВыбораПоставщика.СпособыВыбораПоставщика);
	УстановитьСуммуЛота();
	Если УсловияОплаты = "" Тогда
		УсловияОплаты = Строка(УсловиеОплаты);
	КонецЕсли;	

	#Область ШаблоныЗаполнения
	// Заполнение по шаблону.
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ШаблоныЗаполнения") Тогда
		УправлениеШаблонамиЗаполненияУХ.ЗаполнитьИзШаблона(ДанныеЗаполнения, ЭтотОбъект);
	КонецЕсли;
	#КонецОбласти
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	ПроверяемыеРеквизиты.Добавить("ДатаИсполненияДоговора");
	Если Скрыт Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	МассивНепроверяемыхРеквизитов = Новый Массив();	
	Если Документы.Лот.ЭтоФЗ223(ЭтотОбъект) Тогда
		ПроверяемыеРеквизиты.Добавить("ПорядокФормированияЦеныДоговора");
	КонецЕсли;    
	Если Документы.Лот.ЭтоФЗ223(ЭтотОбъект) И ЗначениеЗаполнено(СтрокаПланаЗакупок) И СтрокаПланаЗакупок.СуммаВВалютеРегламентированногоУчета>0  Тогда
		Отклонение = ((СуммаВВалютеРегламентированногоУчета - СтрокаПланаЗакупок.СуммаВВалютеРегламентированногоУчета)/СтрокаПланаЗакупок.СуммаВВалютеРегламентированногоУчета) * 100;	
		Отклонение = ?(Отклонение > 0, Отклонение, -Отклонение);
		Если Отклонение > 10 Тогда
			ТекстСообщения = НСтр("ru = 'Для организаций работающих по 223 ФЗ запрещено превышение суммы лота больше чем на 10% от суммы строки плана закупок.'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;	
	ПроверитьОдинаковыеРеквизитыСЛотамиЗакупки(Отказ);   
	Если НЕ ПриобретениеФинансовыхУслуг Тогда
	    МассивНепроверяемыхРеквизитов.Добавить("ДатаПривлечения");
		МассивНепроверяемыхРеквизитов.Добавить("СуммаПривлечения");
		МассивНепроверяемыхРеквизитов.Добавить("ДатаВозврата");      
		МассивНепроверяемыхРеквизитов.Добавить("ДатаПривлечения");
		МассивНепроверяемыхРеквизитов.Добавить("ПроцентныйПериод");
		МассивНепроверяемыхРеквизитов.Добавить("СуммаПроцентов");
	Иначе	
		МассивНепроверяемыхРеквизитов.Добавить("УсловиеОплаты");   	
	КонецЕсли;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	// Проверим совпадение товарной категории в шапке с категорией в табличной части.
	Если ПолучитьФункциональнуюОпцию("РазделятьНоменклатуруПоКатегорийнымМенеджерам") Тогда
		РезультатПроверки = ЦентрализованныеЗакупкиУХ.ПроверитьТоварныеКатегорииВТаблице(ТоварнаяКатегория, Номенклатура, "Номенклатура");
		Если Не РезультатПроверки Тогда
			Отказ = Истина;
		Иначе
			// Проверка пройдена успешно.  
		КонецЕсли;
	Иначе
		// Товарные категории не используются.
	КонецЕсли;
	// Проверим соответствие товарной категории лота товарной категории закупочной процедуры.
	Если ТоварнаяКатегория <> ЗакупочнаяПроцедура.ТоварнаяКатегория Тогда
		ТекстСообщения = НСтр("ru = 'Категория закупок ""%КатегорияЛота%"" лота не совпадает с категорией закупок ""%КатегорияЗакупки%"" закупочной процедуры. Запись отменена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КатегорияЛота%", Строка(ТоварнаяКатегория));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КатегорияЗакупки%", Строка(ЗакупочнаяПроцедура.ТоварнаяКатегория));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Отказ = Истина;
	Иначе
		// Проверка пройдена успешно.
	КонецЕсли;
	
	Если ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Дата) <> Неопределено Тогда
    	ПроверяемыеРеквизиты.Добавить("Номенклатура.СтатьяБюджета");
	КонецЕсли;	
	Если НЕ ПроверкаРазностиСтатейБюджета() Тогда
		Отказ = Истина;  
		ТекстСообщения = НСтр("ru = 'Не совпадают типы статей бюджета.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;	
	
КонецПроцедуры

Функция ПроверкаРазностиСтатейБюджета() 
	
	ТипСтатьи = Неопределено;
	Для Каждого Строка ИЗ Номенклатура Цикл
		Если ТипСтатьи = Неопределено Тогда		
		    ТипСтатьи = ТИПЗНЧ(Строка.СтатьяБюджета);
		Иначе
			СовпадениеТипов = ТИПЗНЧ(Строка.СтатьяБюджета) = ТипСтатьи;
			Если НЕ СовпадениеТипов Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	  
	Возврат Истина;
	
КонецФункции

