#Область ПланыДокумента

// Процедура возвращает таблицу планов документа
//
// Параметры:
//  Источник  - ДокументСсылка, ДокументОбъект, Форма.Объект - Документ планирования
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица планов документа
//
Функция ПланыДокумента(Источник, МенеджерВременныхТаблиц = неопределено) Экспорт
	
	Если МенеджерВременныхТаблиц = неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник,"ЗакупочнаяПроцедура")
			И НЕ Источник.ЗакупочнаяПроцедура.ПриобретениеФинансовыхУслуг Тогда
		// Это закупки
		Возврат ПланированиеПотребностей.ПланыДокумента(Источник, МенеджерВременныхТаблиц);
	Иначе
		// Это фин.услуги
		Возврат ПланыПоФинУслугам(Источник, МенеджерВременныхТаблиц);
	КонецЕсли;
	
КонецФункции  

Функция ПолучитьСторнирующиеЗаписи(ДокументыЗаявки)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперацииБюджетов.Период КАК Период,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход) КАК ПриходРасход,
		|	ОперацииБюджетов.Валюта КАК Валюта,
		|	ОперацииБюджетов.Лимит КАК Лимит,
		|	ОперацииБюджетов.Регистратор.Организация КАК Организация,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
		|	ОперацииБюджетов.ОбъектПланирования КАК ОбъектПланирования,
		|	ОперацииБюджетов.ОбъектПланирования.Объект КАК ДокументПланирования,
		|	ОперацииБюджетов.Сумма * -1 КАК Сумма,
		|	ОперацииБюджетов.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
		|	ОперацииБюджетов.АналитикаСтруктуры.ЦФО КАК ЦФО,
		|	ОперацииБюджетов.АналитикаСтруктуры.Проект КАК Проект		
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
		|ГДЕ
		|	ОперацииБюджетов.Регистратор В(&ДокументыЗаявки)";
	
	Запрос.УстановитьПараметр("ДокументыЗаявки", ДокументыЗаявки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить()
  
КонецФункции // ()

