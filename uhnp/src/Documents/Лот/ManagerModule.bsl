Функция ПланыПоФинУслугам(Источник, МенеджерВременныхТаблиц)
	
	// Это фин.услуги
	//    
	ТаблицаПланов = КонтрольЛимитовУХ.Новый_ТаблицаПланыДокумента();
	
	ОписаниеТипаДокументПланирования = Новый ОписаниеТипов(ТаблицаПланов.Колонки.ДокументПланирования.ТипЗначения, "ДокументСсылка.Лот");
	ТаблицаПланов.Колонки.Удалить(ТаблицаПланов.Колонки.ДокументПланирования);
	ТаблицаПланов.Колонки.Добавить("ДокументПланирования", ОписаниеТипаДокументПланирования);
	
	ТаблицаПланов.Колонки.Добавить("УсловиеОплаты", Новый ОписаниеТипов("СправочникСсылка.УсловияОплаты"));	
 	ТаблицаПланов.Колонки.Добавить("МестоПоставки", Новый ОписаниеТипов("СправочникСсылка.МестаПоставки")); 
	
	Если ТипЗнч(Источник) = ТипЗнч(ПустаяСсылка()) Тогда
		ДанныеОбъекта = ДанныеОбъектаПоСсылке(Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.Лот") Тогда
		ДанныеОбъекта = Источник;
	ИначеЕсли ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура")Тогда
		ДанныеОбъекта = Источник;
	Иначе
		ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(МенеджерВременныхТаблиц, "ВТ_ПланыДокумента", ТаблицаПланов);
		Возврат МенеджерВременныхТаблиц;
	КонецЕсли; 
	
	МассивЗаявок = Новый Массив;
	Для каждого ДанныеОбъектаСтрока Из ДанныеОбъекта.ЗаявкиНаПривлечениеФинансирования Цикл
		МассивЗаявок.Добавить(ДанныеОбъектаСтрока.Заявка);		                                                       	
	КонецЦикла;
	
	ПредопределенныеДанные = Новый Структура;
	ПредопределенныеДанные.Вставить("Валюта", 					Источник.ВалютаДокумента);  
	ПредопределенныеДанные.Вставить("ПриходРасход", 			Перечисления.ВидыДвиженийПриходРасход.Приход);  
	ПредопределенныеДанные.Вставить("Дата", 					Источник.Дата);
	ПредопределенныеДанные.Вставить("ДокументРезервирования", 	Источник.Ссылка);
	ПредопределенныеДанные.Вставить("ДокументПланирования", 	Неопределено);
	ПредопределенныеДанные.Вставить("ВидБюджета", 				ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	ПредопределенныеДанные.Вставить("Предназначение",			ПланыВидовХарактеристик.ВидыБюджетов.Предназначение(ПредопределенныеДанные.ВидБюджета));   
	ПредопределенныеДанные.Вставить("ДатаОперации", 			Источник.Дата);
  	
	ПараметрыОП = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(ПредопределенныеДанные.Предназначение);

	// Сторнируем заявки
	СторнирующиеЗаписи = ПолучитьСторнирующиеЗаписи(МассивЗаявок);
	
	Для каждого СторнирующиеЗапись Из СторнирующиеЗаписи Цикл
		
		СтрокаПлана = ТаблицаПланов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПлана, СторнирующиеЗапись);  
		ЗаполнитьЗначенияСвойств(СтрокаПлана, СторнирующиеЗапись); 
		СтрокаПлана.ДокументРезервирования = неопределено;
		СтрокаПлана.ВидБюджета = ПредопределенныеДанные.ВидБюджета;
		СтрокаПлана.ДатаОперации = ПредопределенныеДанные.ДатаОперации;
		СтрокаПлана.ПериодОтчета =
			КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(СтрокаПлана.Период, ПараметрыОП.ПериодичностьОперативногоПланирования,0);
	КонецЦикла;
	
	// получение Основной долг
	Для каждого ДанныеОбъектаСтрока Из ДанныеОбъекта.ЗаявкиНаПривлечениеФинансирования Цикл
		
		СтрокаПлана = ТаблицаПланов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПлана, ПредопределенныеДанные);
		ЗаполнитьЗначенияСвойств(СтрокаПлана, ДанныеОбъектаСтрока);  
		
		СтрокаПлана.ДокументПланирования = ДанныеОбъектаСтрока.Ссылка;
		СтрокаПлана.ДокументРезервирования = ДанныеОбъектаСтрока.Заявка;
		СтрокаПлана.СтатьяБюджета = ДанныеОбъектаСтрока.СтатьяДвиженияДенежныхСредствОсновнойДолг;
		СтрокаПлана.Аналитика1 	= ДанныеОбъектаСтрока.АналитикаОсновнойДолг1;
		СтрокаПлана.Аналитика2 	= ДанныеОбъектаСтрока.АналитикаОсновнойДолг2;
		СтрокаПлана.Аналитика3 	= ДанныеОбъектаСтрока.АналитикаОсновнойДолг3;
		СтрокаПлана.Аналитика4 	= ДанныеОбъектаСтрока.АналитикаОсновнойДолг4;
		СтрокаПлана.Аналитика5 	= ДанныеОбъектаСтрока.АналитикаОсновнойДолг5;
		СтрокаПлана.Аналитика6 	= ДанныеОбъектаСтрока.АналитикаОсновнойДолг6;
		СтрокаПлана.Сумма 		= ДанныеОбъектаСтрока.Сумма;
		СтрокаПлана.Период  	= ДанныеОбъектаСтрока.ДатаПривлечения;
		
		СтрокаПлана.ПериодОтчета    =
			КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(СтрокаПлана.Период, ПараметрыОП.ПериодичностьОперативногоПланирования,0); 
		
	КонецЦикла;
	
	// уплата процентов 
	Для каждого ДанныеОбъектаСтрока Из ДанныеОбъекта.ЗаявкиНаПривлечениеФинансирования Цикл
		
		ГрафикУплатыПроцентовСтроки = ДанныеОбъекта.ГрафикУплатыПроцентов.НайтиСтроки(Новый Структура("Заявка", ДанныеОбъектаСтрока.Заявка));
		
		Для каждого СтрокаГрафика Из ГрафикУплатыПроцентовСтроки Цикл
			
			СтрокаПлана = ТаблицаПланов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПлана, ПредопределенныеДанные);
			ЗаполнитьЗначенияСвойств(СтрокаПлана, ДанныеОбъектаСтрока);
			
			СтрокаПлана.ДокументПланирования = ДанныеОбъектаСтрока.Ссылка;
			СтрокаПлана.ДокументРезервирования = ДанныеОбъектаСтрока.Заявка;
			СтрокаПлана.СтатьяБюджета 	= ДанныеОбъектаСтрока.СтатьяДвиженияДенежныхСредствПроценты;
			СтрокаПлана.Аналитика1 		= ДанныеОбъектаСтрока.АналитикаПроценты1;
			СтрокаПлана.Аналитика2 		= ДанныеОбъектаСтрока.АналитикаПроценты2;
			СтрокаПлана.Аналитика3 		= ДанныеОбъектаСтрока.АналитикаПроценты3;
			СтрокаПлана.Аналитика4 		= ДанныеОбъектаСтрока.АналитикаПроценты4;
			СтрокаПлана.Аналитика5 		= ДанныеОбъектаСтрока.АналитикаПроценты5;
			СтрокаПлана.Аналитика6 		= ДанныеОбъектаСтрока.АналитикаПроценты6;
			
			СтрокаПлана.Сумма 	= СтрокаГрафика.Сумма;
			СтрокаПлана.Период  = СтрокаГрафика.Дата;
			
			СтрокаПлана.ПериодОтчета    =
			КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(СтрокаПлана.Период, ПараметрыОП.ПериодичностьОперативногоПланирования,0); 
			
		КонецЦикла; 
		
	КонецЦикла;   
	
	// Возврат Основной долг
	Для каждого ДанныеОбъектаСтрока Из ДанныеОбъекта.ЗаявкиНаПривлечениеФинансирования Цикл
		
		СтрокаПлана 	= ТаблицаПланов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПлана, ПредопределенныеДанные);
		ЗаполнитьЗначенияСвойств(СтрокаПлана, ДанныеОбъектаСтрока);  
		
		СтрокаПлана.ДокументПланирования = ДанныеОбъектаСтрока.Ссылка;
		СтрокаПлана.ДокументРезервирования = ДанныеОбъектаСтрока.Заявка;
		СтрокаПлана.СтатьяБюджета 	= ДанныеОбъектаСтрока.СтатьяДвиженияДенежныхСредствОсновнойДолг;
		СтрокаПлана.Аналитика1 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг1;
		СтрокаПлана.Аналитика2 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг2;
		СтрокаПлана.Аналитика3 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг3;
		СтрокаПлана.Аналитика4 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг4;
		СтрокаПлана.Аналитика5 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг5;
		СтрокаПлана.Аналитика6 		= ДанныеОбъектаСтрока.АналитикаОсновнойДолг6;
		СтрокаПлана.Сумма 			= ДанныеОбъектаСтрока.Сумма;
		СтрокаПлана.Период  		= ДанныеОбъектаСтрока.ДатаВозврата;
		
		СтрокаПлана.ПериодОтчета    =
			КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(СтрокаПлана.Период, ПараметрыОП.ПериодичностьОперативногоПланирования,0); 
		
	КонецЦикла;

	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(МенеджерВременныхТаблиц, "ВТ_ПланыДокумента", ТаблицаПланов);
	Возврат МенеджерВременныхТаблиц;
	
КонецФункции
#КонецЕсли

