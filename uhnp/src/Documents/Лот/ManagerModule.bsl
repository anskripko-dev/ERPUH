#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(ОрганизацияДляЗаключенияДоговора)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область СтандартныеПодсистемыКоманды

// Добавляет команду создания объекта на основании.
//
// Параметры:
// 	КомандыСозданияНаОсновании - ТаблицаЗначений - перечень команд
// Возвращаемое значение:
// 	Неопределено, СтрокаТаблицыЗначений - Добавленная Команда.
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	МетаданныеДокумента = ПустаяСсылка().Метаданные();
	Если ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
		КомандаСоздатьНаОсновании						= КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер				= МетаданныеДокумента.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление			= ОбщегоНазначения.ПредставлениеОбъекта(МетаданныеДокумента);
		КомандаСоздатьНаОсновании.РежимЗаписи			= "Проводить";
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Заполняет список команд создания на основании.
//
// Параметры:
// 	КомандыСозданияНаОсновании - ТаблицаЗначений - перечень команд
// 	Параметры - Структура - параметры
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.ПредложениеПоставщика.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);

	Документы.ЗаявкаНаКорректировкуПланов.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.КорректировкаПланов.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);	
		
КонецПроцедуры

#КонецОбласти

Процедура РассчитатьСуммуПроцентов(ДокументОбъект) Экспорт
	
    ДокументОбъект.ГрафикУплатыПроцентов.Очистить();

	Для каждого СтрокаЗаявка Из ДокументОбъект.ЗаявкиНаПривлечениеФинансирования Цикл
		ФинансовыеИнструментыУХ.ПересчитатьСуммуПроцентовВариантаФинансирования(ДокументОбъект, СтрокаЗаявка.Сумма, ДокументОбъект.ПроцентныйПериод, Истина, СтрокаЗаявка.Заявка);	
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено, ПриобретениеФинансовыхУслуг = Ложь) Экспорт
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапрос(Запрос, ДокументСсылка);  

	Если ПриобретениеФинансовыхУслуг Тогда
	    // Планы документа
		ПланыДокумента(ДокументСсылка, Запрос.МенеджерВременныхТаблиц); 
		ПланированиеПотребностей.ПодготовитьТаблицуДвиженийПоПланамДокумента(Запрос, ДополнительныеСвойства.ТаблицыДляДвижений, "ВТ_ПланыДокумента");
	Иначе
		
		ПараметрыПланирования = ПодготовитьПараметрыПланированияПотребностей(ДокументСсылка, Запрос.МенеджерВременныхТаблиц);
		ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
		Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
		////////////////////////////////////////////////////////////////////////////
		// Сформируем текст запроса
		ТекстыЗапроса = Новый СписокЗначений;  
		ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры,, ПараметрыПланирования);
 		ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	КонецЕсли;
	
КонецПроцедуры


// Функция - План потребностей 
//
// Параметры:
//  Объект					 - ДокументСсылка, ДокументОбъект, ДанныеФормыСтруктура	 - 
//  МенеджерВременныхТаблиц	 - МенеджерВременныхТаблиц - 
// 
// Возвращаемое значение:
//   Структура - Структура с изменениями документа и менеджером временных таблиц 
//
Функция ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц) Экспорт
	
	//  
	ПараметрыПланирования = ПланированиеПотребностей.ПараметрыПроведения();
	ПараметрыПланирования.Вставить("Менеджер", 				МенеджерВременныхтаблиц);
	ПараметрыПланирования.Вставить("ИзменениеНоменклатуры",	Ложь);
	ПараметрыПланирования.Вставить("Этап", 					Перечисления.ЭтапыПланированияПотребностей.ЗакупочныеПроцедуры);
	ПараметрыПланирования.Вставить("ДокументПланирования",	Объект.Ссылка);
	ПараметрыПланирования.Вставить("ОбъектПланирования",	ОбъектыПланирования.ПолучитьОбъектПланирования(ПараметрыПланирования.ДокументПланирования));
	//ПараметрыПланирования.Вставить("ИзменениеНоменклатуры",	Истина);
	ПараметрыПланирования.Вставить("ИзменениеПоставки",		Истина);
 	ПараметрыПланирования.Вставить("ОтражатьВБюджетах", 	Истина);
	ПараметрыПланирования.Вставить("ВидБюджета", 	ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Этап", ПараметрыПланирования.Этап);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);
	
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДвиженияДенежныхСредств", КэшируемыеПроцедурыОПК.ПустаяСтатьяДвиженияДенежныхСредств());
	Запрос.УстановитьПараметр("ПустоеЗначениеСтатьиДоходовИРасходов", КэшируемыеПроцедурыОПК.ПустаяСтатьяДоходовИРасходов());
	Запрос.УстановитьПараметр("ЗонтичнаяЗакупка", Объект.ВидЗакупки = Перечисления.ВидЛотовойЗакупки.Зонтичная);
	
	ИменаРеквизитов = "Ссылка, ВалютаДокумента, УсловиеОплаты, ОрганизацияДляЗаключенияДоговора";
	ТипСтатей = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Объект.Дата);	
	Если ТипСтатей<> Неопределено И ТипСтатей.ТипЗначения.СодержитТип(ТипЗНЧ(Справочники.СтатьиДоходовИРасходов.ПустаяСсылка())) Тогда
		СтатьяБДР = Истина;
	Иначе
		СтатьяБДР = Ложь;
	КонецЕсли;	
	Запрос.УстановитьПараметр("СтатьяБДР",СтатьяБДР);     
	Запросы = Новый Массив;
	Запрос.УстановитьПараметр("ВидБюджета", ПараметрыПланирования.ВидБюджета);
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	&Этап КАК Этап,
	|	&ОбъектПланирования КАК ОбъектПланирования,
	|	ВЫБОР
	|		КОГДА &ЗонтичнаяЗакупка
	|			ТОГДА Коллекция.ПериодПотребности.ДатаНачала
	|		ИНАЧЕ Коллекция.ДатаПоставки
	|	КОНЕЦ КАК ДатаОперации,
	|	&ВалютаДокумента КАК Валюта, 
	|	&ВидБюджета КАК ВидБюджета,
	|	&ВидБюджета КАК ВидБюджетаПоставка,		
	|	&УсловиеОплаты КАК УсловиеОплаты,
	|	Коллекция.Номенклатура КАК Номенклатура,
	|	Коллекция.Характеристика КАК Характеристика,
	|	Коллекция.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Коллекция.Коэффициент КАК Коэффициент,
	|	Коллекция.Количество КАК Количество, 
	|   Коллекция.Проект,
	|	Коллекция.Цена КАК Цена,
	|	ВЫБОР
	|		КОГДА &СтатьяБДР
	|			ТОГДА Коллекция.Сумма - Коллекция.СуммаНДС
	|		ИНАЧЕ Коллекция.Сумма
	|	КОНЕЦ КАК Сумма,
	|	Коллекция.Сумма КАК СуммаПоПотребности,
	|	Коллекция.СтавкаНДС КАК СтавкаНДС,
	|	Коллекция.АналитикаПланирования КАК АналитикаПредыдущегоЭтапа,
	|	Коллекция.АналитикаИсточника КАК АналитикаИсточника,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроисхождения,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроизводителя,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Поставщик,
	|	ЗНАЧЕНИЕ(Справочник.НоменклатураПоставщиков.ПустаяСсылка) КАК НоменклатураПоставщика, 
	|	Выбор Когда Коллекция.Ссылка.ЕдиноеМестоПоставки И Коллекция.Ссылка.МестоПоставки <> Значение(Справочник.МестаПоставки.ПустаяСсылка)
	|	Тогда Коллекция.Ссылка.МестоПоставки Иначе
	|	Коллекция.МестоПоставки Конец КАК МестоПоставки,  
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджета,
	|	Коллекция.Аналитика1 КАК Аналитика1,
	|	Коллекция.Аналитика2 КАК Аналитика2,
	|	Коллекция.Аналитика3 КАК Аналитика3,
	|	Коллекция.Аналитика4 КАК Аналитика4,
	|	Коллекция.Аналитика5 КАК Аналитика5,
	|	Коллекция.Аналитика6 КАК Аналитика6,
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджетаПоставка,
	|	Коллекция.Аналитика1 КАК Аналитика1Поставка,
	|	Коллекция.Аналитика2 КАК Аналитика2Поставка,
	|	Коллекция.Аналитика3 КАК Аналитика3Поставка,
	|	Коллекция.Аналитика4 КАК Аналитика4Поставка,
	|	Коллекция.Аналитика5 КАК Аналитика5Поставка,
	|	Коллекция.Аналитика6 КАК Аналитика6Поставка, 
	|	Коллекция.Назначение КАК Назначение	
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДляОбработки
	|ИЗ
	|	Документ.Лот.Номенклатура КАК Коллекция
	|ГДЕ
	|	Коллекция.Ссылка = &Ссылка
	|	И Коллекция.АналитикаИсточника <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	&Этап КАК Этап,
	|	&ОбъектПланирования КАК ОбъектПланирования,
	|	&ВалютаДокумента КАК Валюта,
	|	&УсловиеОплаты КАК УсловиеОплаты,   
	|	&ВидБюджета КАК ВидБюджета,
	|	&ВидБюджета КАК ВидБюджетаПоставка,		
	|	&ОрганизацияДляЗаключенияДоговора КАК Организация,
	|	Коллекция.ЦФО КАК ЦФО,
	|	Коллекция.Проект КАК Проект,
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджета,
	|	Коллекция.Аналитика1 КАК Аналитика1,
	|	Коллекция.Аналитика2 КАК Аналитика2,
	|	Коллекция.Аналитика3 КАК Аналитика3,
	|	Коллекция.Аналитика4 КАК Аналитика4,
	|	Коллекция.Аналитика5 КАК Аналитика5,
	|	Коллекция.Аналитика6 КАК Аналитика6,
	|	Коллекция.СтатьяБюджета КАК СтатьяБюджетаПоставка,
	|	Коллекция.Аналитика1 КАК Аналитика1Поставка,
	|	Коллекция.Аналитика2 КАК Аналитика2Поставка,
	|	Коллекция.Аналитика3 КАК Аналитика3Поставка,
	|	Коллекция.Аналитика4 КАК Аналитика4Поставка,
	|	Коллекция.Аналитика5 КАК Аналитика5Поставка,
	|	Коллекция.Аналитика6 КАК Аналитика6Поставка, 	
	|	Коллекция.ДатаПоставки КАК ДатаОперации,
	|	Коллекция.Номенклатура КАК Номенклатура,
	|	Коллекция.Характеристика КАК Характеристика,
	|	Коллекция.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Коллекция.Коэффициент КАК Коэффициент,
	|	Коллекция.Количество КАК Количество,
	|	Коллекция.Цена КАК Цена,
	|	Коллекция.СтавкаНДС КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА &СтатьяБДР
	|			ТОГДА Коллекция.Сумма - Коллекция.СуммаНДС
	|		ИНАЧЕ Коллекция.Сумма
	|	КОНЕЦ КАК Сумма,
	|	Коллекция.Сумма КАК СуммаПоПотребности,
	|	Выбор Когда Коллекция.Ссылка.ЕдиноеМестоПоставки И Коллекция.Ссылка.МестоПоставки <> Значение(Справочник.МестаПоставки.ПустаяСсылка)
	|	Тогда Коллекция.Ссылка.МестоПоставки Иначе
	|	Коллекция.МестоПоставки Конец КАК МестоПоставки,
	|	Коллекция.Назначение КАК Назначение,    
	|	ЗНАЧЕНИЕ(Справочник.НоменклатураПоставщиков.ПустаяСсылка) КАК НоменклатураПоставщика,	
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроисхождения,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроизводителя,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Поставщик
	|ПОМЕСТИТЬ ВТ_ПланыДокументаДобавленныеВручную
	|ИЗ
	|	Документ.Лот.Номенклатура КАК Коллекция
	|ГДЕ
	|	Коллекция.Ссылка = &Ссылка
	|	И Коллекция.АналитикаИсточника = ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка);
	|ВЫБРАТЬ       
	|	ВТ_Этапы.Ссылка КАК Документ,	
	|	ВТ_Этапы.ПроцентПлатежа КАК ПроцентОплат,
	|	ВТ_Этапы.ДатаПлатежа КАК ДатаПлатежа,
	|	ВТ_Этапы.ДатаПоступления КАК ДатаПоступления  
	|	Поместить ВТ_ПланыОплат
	|ИЗ
	|	Документ.Лот.ПланОплаты КАК ВТ_Этапы
	|ГДЕ
	|	ВТ_Этапы.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО     
	|	ВТ_Этапы.Ссылка  ,		
	|	ВТ_Этапы.ПроцентПлатежа,
	|	ВТ_Этапы.ДатаПлатежа,
	|	ВТ_Этапы.ДатаПоступления";

	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("ДанныеФормыСтруктура")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект."+ПустаяСсылка().Метаданные().Имя) Тогда
		// Объект или Форма
		РеквизитыДокумента = Объект;
		
		РеквизитыТабличнойЧасти = "Назначение,ПериодПотребности,ДатаПоставки, МестоПоставки, Организация, ЦФО, Проект, Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, Количество, Цена, Сумма, СуммаНДС, СтавкаНДС,"
			+ "АналитикаПланирования, АналитикаИсточника,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6";

		Коллекция = Объект.Номенклатура.Выгрузить(,РеквизитыТабличнойЧасти);
		ОписаниеТипаСсылки = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(Объект.Ссылка)));
		Коллекция.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);	
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка");
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Номенклатура ИЗ &Коллекция КАК Коллекция");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Лот.Номенклатура", "ВТ_Номенклатура"); 
		
		Коллекция = Объект.ПланОплаты.Выгрузить();
		Коллекция.Колонки.Добавить("Ссылка", ОписаниеТипаСсылки);
		Коллекция.ЗаполнитьЗначения(Объект.Ссылка, "Ссылка");
		Запрос.УстановитьПараметр("КоллекцияЭтапов", Коллекция); 
		
		Запросы.Добавить("ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Этапы ИЗ &КоллекцияЭтапов КАК Коллекция");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Лот.ПланОплаты", "ВТ_Этапы");  
		
		
		Запросы.Добавить(ТекстЗапроса);
		Запросы.Добавить("УНИЧТОЖИТЬ ВТ_Номенклатура");
	ИначеЕсли ТипОбъекта = ТипЗнч(ПустаяСсылка()) Тогда
		// Это ссылка
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, ИменаРеквизитов);
		Запросы.Добавить(ТекстЗапроса);
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Новый Структура(ИменаРеквизитов) Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, РеквизитыДокумента[КлючЗначение.Ключ]);
	КонецЦикла;
	Запрос.Текст = СтрСоединить(Запросы, ОбщегоНазначенияОПК.ТекстРазделителяЗапросовПакета());
	Запрос.Выполнить();
	
	Возврат ПараметрыПланирования;
	
КонецФункции

// Процедура инициализирует запрос данными таблиц, переданных в параметрах
Процедура ИнициализироватьЗапрос(Запрос, Объект)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, "Ссылка, Дата, Проведен, ВалютаДокумента");
	Для Каждого КлючЗначение Из РеквизитыДокумента Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
	
// Возвращает метод оценки для лота, согласно способу закупки СпособВыбораПоставщикаВход.	
Функция ПолучитьМетодОценкиПоСпособуВыбораПоставщика(СпособВыбораПоставщикаВход) Экспорт
	РезультатФункции = Перечисления.МетодыОценкиПредложенийПоставщиков.ПустаяСсылка();
	// Массив способов по ценам.
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	НастройкиПланированияЗакупочныхПроцедур.МетодОценки КАК МетодОценки
	                |ИЗ
	                |	РегистрСведений.НастройкиПланированияЗакупочныхПроцедур КАК НастройкиПланированияЗакупочныхПроцедур
	                |ГДЕ
	                |	НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки = &СпособВыбораПоставщикаВход"; 
	Запрос.УстановитьПараметр("СпособВыбораПоставщикаВход",СпособВыбораПоставщикаВход);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.МетодОценки;
	КонецЦикла;	
	ТекстСообщения = НСтр("ru = 'Не удалось получить метод оценки по способу выбора %СпособВыбора%. Необходимо заполнить настройки планирования закупочных процедур на панели корпоративных закупок'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СпособВыбора%", Строка(СпособВыбораПоставщикаВход));
	ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	РезультатФункции = Перечисления.МетодыОценкиПредложенийПоставщиков.ПустаяСсылка();
	Возврат РезультатФункции;
КонецФункции		// ПолучитьМетодОценкиПоСпособуВыбораПоставщика()

// Возвращает соответствие с именами реквизитов лота,
// с префиксом "Удален", которые перенесены в закупочную
// процедуру, и которые должны быть заполнены в ней.
//
