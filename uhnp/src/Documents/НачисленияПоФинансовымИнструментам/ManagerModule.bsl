	|						КОГДА ГрафикиРасчетов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|							ТОГДА -ГрафикиРасчетов.Сумма
	|						ИНАЧЕ ГрафикиРасчетов.Сумма
	|					КОНЕЦ)
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА МАКСИМУМ(втАктуальныеВерсииГрафиков.ЭтоАктив)
	|				ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентов)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентовДолгосрочный)
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА НЕ МАКСИМУМ(втАктуальныеВерсииГрафиков.ЭтоАктив)
	|				ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентов)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентовДолгосрочный)
	|		КОНЕЦ,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		""Перевод долгосрочных процентов в краткосрочные по финансовому инструменту""
	|	ИЗ
	|		РегистрНакопления.РасчетыСКонтрагентамиГрафики КАК ГрафикиРасчетов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втАктуальныеВерсииГрафиков КАК втАктуальныеВерсииГрафиков
	|			ПО ГрафикиРасчетов.Регистратор = втАктуальныеВерсииГрафиков.Регистратор
	|				И ГрафикиРасчетов.ПредметГрафика = втАктуальныеВерсииГрафиков.ПредметГрафика
	|				И (ГрафикиРасчетов.ВидБюджета В (ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов)))
