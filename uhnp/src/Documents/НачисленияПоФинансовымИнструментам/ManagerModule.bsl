Функция ТекстЗапроса_СчетаДокумента(НомераТаблиц, МассивТекстовЗапроса = Неопределено) Экспорт
	
	Если МассивТекстовЗапроса <> Неопределено Тогда
		МассивТекстовЗапроса.Добавить(ТекстЗапроса_втСчетаБезПроцентов(НомераТаблиц));	
	КонецЕсли;
	
	НомераТаблиц.Вставить("втСчетаДокумента", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	втСчетаБезПроцентов.ФинансовыйИнструмент КАК ФинансовыйИнструмент,
	|	втСчетаБезПроцентов.Ссылка КАК Ссылка,
	|	втСчетаБезПроцентов.ВидСчетаФИ КАК ВидСчетаФИ,
	|	втСчетаБезПроцентов.Счет КАК Счет,
	|	втСчетаБезПроцентов.Субконто1 КАК Субконто1,
	|	втСчетаБезПроцентов.Субконто2 КАК Субконто2,
	|	втСчетаБезПроцентов.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ втСчетаДокумента
	|ИЗ
	|	втСчетаБезПроцентов КАК втСчетаБезПроцентов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втСчетаБезПроцентов.ФинансовыйИнструмент,
	|	втСчетаБезПроцентов.Ссылка,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентов),
	|	втСчетаБезПроцентов.Счет,
	|	втСчетаБезПроцентов.Субконто1,
	|	втСчетаБезПроцентов.Субконто2,
	|	втСчетаБезПроцентов.Субконто3
	|ИЗ
	|	втСчетаБезПроцентов КАК втСчетаБезПроцентов
	|ГДЕ
	|	втСчетаБезПроцентов.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФИ)
	|	И НЕ втСчетаБезПроцентов.ФинансовыйИнструмент В
	|				(ВЫБРАТЬ
	|					т.ФинансовыйИнструмент
	|				ИЗ
	|					втСчетаБезПроцентов КАК т
	|				ГДЕ
	|					т.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентов))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втСчетаБезПроцентов.ФинансовыйИнструмент,
	|	втСчетаБезПроцентов.Ссылка,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФиДолгосрочный),
	|	втСчетаБезПроцентов.Счет,
	|	втСчетаБезПроцентов.Субконто1,
	|	втСчетаБезПроцентов.Субконто2,
	|	втСчетаБезПроцентов.Субконто3
	|ИЗ
	|	втСчетаБезПроцентов КАК втСчетаБезПроцентов
	|ГДЕ
	|	втСчетаБезПроцентов.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФИ)
	|	И НЕ втСчетаБезПроцентов.ФинансовыйИнструмент В
	|				(ВЫБРАТЬ
	|					т.ФинансовыйИнструмент
	|				ИЗ
	|					втСчетаБезПроцентов КАК т
	|				ГДЕ
	|					т.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФиДолгосрочный))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втСчетаБезПроцентов.ФинансовыйИнструмент,
	|	втСчетаБезПроцентов.Ссылка,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентовДолгосрочный),
	|	втСчетаБезПроцентов.Счет,
	|	втСчетаБезПроцентов.Субконто1,
	|	втСчетаБезПроцентов.Субконто2,
	|	втСчетаБезПроцентов.Субконто3
	|ИЗ
	|	втСчетаБезПроцентов КАК втСчетаБезПроцентов
	|ГДЕ
	|	втСчетаБезПроцентов.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентов)
	|	И НЕ втСчетаБезПроцентов.ФинансовыйИнструмент В
	|				(ВЫБРАТЬ
	|					т.ФинансовыйИнструмент
	|				ИЗ
	|					втСчетаБезПроцентов КАК т
	|				ГДЕ
	|					т.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаПроцентовДолгосрочный))";
	
