&НаКлиенте
Процедура РассчитатьСтатус(Команда)
	
	ВыделенныеСсылки = ОбщегоНазначенияУТКлиент.ПроверитьПолучитьВыделенныеВСпискеСсылки(Элементы.СписокДоверенности);
	
	Если ВыделенныеСсылки.Количество() Тогда
		ЗаголовокВопроса = НСтр("ru = 'Расчет статуса доверенностей';
								|en = 'Calculate status of authorization letters'");
		Если ВыделенныеСсылки.Количество() > 0 Тогда
			ТекстНачалоВопроса = НСтр("ru = 'У выделенных в списке доверенностей';
										|en = 'Authorization letters selected in the list'");
			ДопПараметры = Новый Структура("ВыделенныеСсылки", ВыделенныеСсылки);
		Иначе
			ТекстНачалоВопроса = НСтр("ru = 'У доверенностей за последний месяц';
										|en = 'Of authorization letters for the last month'");
			ДопПараметры = Новый Структура("ВыделенныеСсылки", Новый Массив());
		КонецЕсли;
		
		ТекстВопроса = СтрШаблон(НСтр("ru = '%1 в статусе ""Выдана"" и ""Использована частично"" будет пересчитан статус. Рассчитать?';
										|en = '%1 status will be recalculated in the Issued and Used partially status. Calculate?'"),
			ТекстНачалоВопроса);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьСтатусЗавершение", ЭтотОбъект, ДопПараметры);
		СписокКнопок = Новый СписокЗначений();
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Рассчитать';
															|en = 'Calculate'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отменить';
																|en = 'Cancel'"));
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок,, КодВозвратаДиалога.Отмена, ЗаголовокВопроса);
	КонецЕсли;
	
КонецПроцедуры

