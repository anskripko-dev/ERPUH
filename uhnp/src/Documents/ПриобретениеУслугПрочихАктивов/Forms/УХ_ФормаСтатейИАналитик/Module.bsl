
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//Вставить содержимое обработчика         
	Дата = Параметры.Дата;
	ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Дата);
	
	СтатьяБюджетаБДДС = Параметры.СтатьяБюджетаБДДС;
	АналитикаБДДС1 = Параметры.АналитикаБДДС1;
	АналитикаБДДС2 = Параметры.АналитикаБДДС2;
	АналитикаБДДС3 = Параметры.АналитикаБДДС3;
	АналитикаБДДС4 = Параметры.АналитикаБДДС4;
	АналитикаБДДС5 = Параметры.АналитикаБДДС5;
	АналитикаБДДС6 = Параметры.АналитикаБДДС6;   
	
	СтатьяБюджетаБДР = Параметры.СтатьяБюджетаБДР;
	АналитикаБДР1 = Параметры.АналитикаБДР1;
	АналитикаБДР2 = Параметры.АналитикаБДР2;
	АналитикаБДР3 = Параметры.АналитикаБДР3;
	АналитикаБДР4 = Параметры.АналитикаБДР4;
	АналитикаБДР5 = Параметры.АналитикаБДР5;
	АналитикаБДР6 = Параметры.АналитикаБДР6;  

	ЦФО = Параметры.ЦФО;
	Проект = Параметры.Проект;
	
	
	УстановитьНастройкиСтатейИАналитик();
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиСтатейИАналитик()
	
	//Элементы.ВидБюджетаДобавленная.СписокВыбора.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
    ВидБюджетаДобавленная = (ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
    ВидБюджета = (ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	
	МассивОписанийСтатей = Новый Массив;  
	// Статьи и их аналитики
	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);
	
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиРеквизитовФормыВПолях(МассивОписанийСтатей,
		"СтатьяБюджетаБДДС", "СтатьяБюджетаБДДС",
		"АналитикаБДДС%1", "АналитикаБДДС%1",
	ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ГруппаАналитика1));    
	//АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтаФорма, МассивОписанийСтатей, ПараметрыПоляВводаШапки); //ПараметрыПоляВвода());
	
	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиРеквизитовФормыВПолях(МассивОписанийСтатей,
		"СтатьяБюджетаБДР", "СтатьяБюджетаБДР",
		"АналитикаБДР%1", "АналитикаБДР%1",
	ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ГруппаАналитика2));    
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтаФорма, МассивОписанийСтатей, ПараметрыПоляВводаШапки); //ПараметрыПоляВвода());
	
	
	Элементы.СтатьяБюджетаБДДС.ОграничениеТипа = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств").ТипЗначения;
	Элементы.СтатьяБюджетаБДР.ОграничениеТипа = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов").ТипЗначения;
	ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Дата);	
	
	Элементы.Группа3.Видимость = ВидыБюджетаЗакупок <> Неопределено И ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;	
 КонецПроцедуры

&НаКлиенте
 Процедура СтатьяБюджетаПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
	НастроитьЗависимыеЭлементыФормы(Элемент.Имя);  
 КонецПроцедуры

 &НаКлиенте 
Процедура НастроитьЗависимыеЭлементыФормы(ИзмененныйРеквизит = "")
//	УправлениеЭлементамиФормыКлиентСервер.НастроитьЭлементыФормы(ЭтаФорма, ИзмененныйРеквизит, РеквизитыФормы(ЭтаФорма));
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСтатьюИАналитики(Команда)
	
	ПараметрыОповещения = Новый Структура; 
	ПараметрыОповещения.Вставить("СтатьяБюджетаБДДС", СтатьяБюджетаБДДС);
	ПараметрыОповещения.Вставить("АналитикаБДДС1", АналитикаБДДС1); 
	ПараметрыОповещения.Вставить("АналитикаБДДС2", АналитикаБДДС2); 
	ПараметрыОповещения.Вставить("АналитикаБДДС3", АналитикаБДДС3); 
	ПараметрыОповещения.Вставить("АналитикаБДДС4", АналитикаБДДС4); 
	ПараметрыОповещения.Вставить("АналитикаБДДС5", АналитикаБДДС5); 
	ПараметрыОповещения.Вставить("АналитикаБДДС6", АналитикаБДДС6);     
	ПараметрыОповещения.Вставить("СтатьяБюджетаБДР", СтатьяБюджетаБДР);
	ПараметрыОповещения.Вставить("АналитикаБДР1", АналитикаБДР1); 
	ПараметрыОповещения.Вставить("АналитикаБДР2", АналитикаБДР2); 
	ПараметрыОповещения.Вставить("АналитикаБДР3", АналитикаБДР3); 
	ПараметрыОповещения.Вставить("АналитикаБДР4", АналитикаБДР4); 
	ПараметрыОповещения.Вставить("АналитикаБДР5", АналитикаБДР5); 
	ПараметрыОповещения.Вставить("АналитикаБДР6", АналитикаБДР6); 
	ПараметрыОповещения.Вставить("ЦФО", ЦФО); 
	ПараметрыОповещения.Вставить("Проект", Проект); 
	
	Оповестить("ПеренестиДанныеСтатейПоступления", ПараметрыОповещения);
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция УХ_БюджетДвиженияДенежныхСредств()	
	
	ВидыБюджетаЗакупок = ПланированиеПотребностей.ИспользуемыеВидыБюджетовЗакупок(Дата);
	
	Возврат ВидыБюджетаЗакупок <> Неопределено И ВидыБюджетаЗакупок = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств; 

КонецФункции

&НаКлиенте
Процедура СтатьяБюджетаБДРПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
	НастроитьЗависимыеЭлементыФормы(Элемент.Имя);  
КонецПроцедуры

 