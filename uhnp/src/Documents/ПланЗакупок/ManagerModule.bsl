// Возвращает доступные типы для заполнения аналитики бюджетирования.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - Ссылка на документ.
//  ИмяТаблицы - Строка - Имя таблицы документа.
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - См. ДоступныеТипыАналитик:
//   * Ключ - Тип - Тип значения аналитики.
//   * Значение - Строка - Источник заполнения аналитики.
//
Функция ДоступныеТипыАналитикБюджетирования(ДокументСсылка, ИмяТаблицы = "") Экспорт
	
	ДоступныеТипыАналитик = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеРеквизиты.НомерСтроки,
	|	ДополнительныеРеквизиты.Значение,
	|	ТИПЗНАЧЕНИЯ(ДополнительныеРеквизиты.Значение) КАК Тип
	|ИЗ
	|	Документ.ПланЗакупок.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
	|ГДЕ
	|	ДополнительныеРеквизиты.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПланЗакупок.ВидПлана.ЗаполнятьСоглашение КАК ЗаполнятьСоглашение,
	|	ПланЗакупок.ВидПлана.ЗаполнятьСоглашениеВТЧ КАК ЗаполнятьСоглашениеВТЧ,
	|	ПланЗакупок.Соглашение,
	|	ПланЗакупок.ЗаполнятьПланОплат,
	|	ПланЗакупок.ВидПлана.ЗаполнятьПартнера КАК ЗаполнятьПартнера,
	|	ПланЗакупок.ВидПлана.ЗаполнятьПартнераВТЧ КАК ЗаполнятьПартнераВТЧ
	|ИЗ
	|	Документ.ПланЗакупок КАК ПланЗакупок
	|ГДЕ
	|	ПланЗакупок.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.ВыполнитьПакет();  
	
	ВыборкаДетальныеЗаписи = Результат[0].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Значение) Тогда
			Продолжить;
		КонецЕсли;
		ДоступныеТипыАналитик.Вставить(ВыборкаДетальныеЗаписи.Тип, "&ДополнительныйРеквизит"+Формат(ВыборкаДетальныеЗаписи.НомерСтроки, "ЧГ=0"));
	КонецЦикла;
	
	ИспользоватьПартнеровИКонтрагентов = ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровИКонтрагентов");
	
	ВыборкаПлан = Результат[1].Выбрать();
	ВыборкаПлан.Следующий();
	
	Если ИспользоватьПартнеровИКонтрагентов Тогда
		
		Если ИмяТаблицы = "Товары" И (ВыборкаПлан.ЗаполнятьСоглашение Или ВыборкаПлан.ЗаполнятьСоглашениеВТЧ) Тогда
			ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Контрагенты"), ИмяТаблицы + ".Соглашение.Контрагент");
		ИначеЕсли ВыборкаПлан.ЗаполнятьСоглашение Тогда
			ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Контрагенты"), ИмяТаблицы + ".Ссылка.Соглашение.Контрагент");
		КонецЕсли;
		
	Иначе
		
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Контрагенты"), "ВтКонтрагентыПартнеров.Контрагент");
		
	КонецЕсли;
	
	Если ИмяТаблицы = "Товары" И (ВыборкаПлан.ЗаполнятьСоглашение Или ВыборкаПлан.ЗаполнятьСоглашениеВТЧ) Тогда
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.СоглашенияСПоставщиками"), ИмяТаблицы + ".Соглашение");
	ИначеЕсли ВыборкаПлан.ЗаполнятьСоглашение Тогда
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.СоглашенияСПоставщиками"), ИмяТаблицы + ".Ссылка.Соглашение"); 
	КонецЕсли;
	
	Если ИмяТаблицы = "Товары" И (ВыборкаПлан.ЗаполнятьСоглашение Или ВыборкаПлан.ЗаполнятьСоглашениеВТЧ) Тогда
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.СтатьиДвиженияДенежныхСредств"), ИмяТаблицы + ".Соглашение.СтатьяДвиженияДенежныхСредств");
	ИначеЕсли ВыборкаПлан.ЗаполнятьСоглашение Тогда
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.СтатьиДвиженияДенежныхСредств"), ИмяТаблицы + ".Ссылка.Соглашение.СтатьяДвиженияДенежныхСредств");
	КонецЕсли;
	
	ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.СтруктураПредприятия"), ИмяТаблицы + ".Ссылка.Подразделение");
	
	Если ИмяТаблицы = "Товары" Тогда
		
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Партнеры"), "Товары.Партнер");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Организации"), "Товары.Соглашение.Организация");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Склады"), "Товары.Склад");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Номенклатура"), "Товары.Номенклатура");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.ВидыНоменклатуры"), "Товары.Номенклатура.ВидНоменклатуры");
		ДоступныеТипыАналитик.Вставить(Тип("ПеречислениеСсылка.ТипыНоменклатуры"), "Товары.Номенклатура.ТипНоменклатуры");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Марки"), "Товары.Номенклатура.Марка");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Производители"), "Товары.Номенклатура.Производитель");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.СезонныеГруппы"), "Товары.Номенклатура.СезоннаяГруппа");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.ЦеновыеГруппы"), "Товары.Номенклатура.ЦеноваяГруппа");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.ТоварныеКатегории"), "Товары.Номенклатура.ТоварнаяКатегория");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.ГруппыАналитическогоУчетаНоменклатуры"), "Товары.Номенклатура.ГруппаАналитическогоУчета");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.НаправленияДеятельности"), "Товары.Назначение.НаправлениеДеятельности");
		ДоступныеТипыАналитик.Вставить(Тип("ДокументСсылка.ЗаказКлиента"), "Товары.Назначение.Заказ");
		
	Иначе 
		
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Партнеры"), ИмяТаблицы + ".Ссылка.Партнер");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Организации"), ИмяТаблицы + ".Ссылка.Соглашение.Организация");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.Склады"), ИмяТаблицы + ".Ссылка.Склад");
		ДоступныеТипыАналитик.Вставить(Тип("СправочникСсылка.НаправленияДеятельности"), ИмяТаблицы + ".Ссылка.Назначение.НаправлениеДеятельности");
		ДоступныеТипыАналитик.Вставить(Тип("ДокументСсылка.ЗаказКлиента"), ИмяТаблицы + ".Ссылка.Назначение.Заказ");
		
	КонецЕсли;
	
	Возврат ДоступныеТипыАналитик;
	
КонецФункции

