	ДопПараметр.Вставить("ЗаголовокОперанда", 	?(СоздаватьРеквизитСОтбором, НСтр("ru = 'Факт закупок*';
																					|en = 'Actual purchases*'"), НСтр("ru = 'Факт закупок';
																												|en = 'Actual purchases'")));
	ДопПараметр.Вставить("ВходитВОперанд",		"ДополнительныеОперандыФакты");
	
	ДопПараметры.Вставить("ФактыЗакупок", ДопПараметр);
#КонецОбласти

	#Область УХ_Внедрение

#Область Законтрактовано
	// Свойства реквизита формы
	ДопПараметр = Новый Структура();
	ДопПараметр.Вставить("Имя", 				"Законтрактовано");
	ДопПараметр.Вставить("Тип", 				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	ДопПараметр.Вставить("Путь", 				ПутьКРеквизиту);
