	ДопПараметр.Вставить("ЗаголовокОперанда",	НСтр("ru = 'План закупок*';
														|en = 'Purchase plan*'"));
	ДопПараметр.Вставить("Расшифровка", 		"Документ.ПланЗакупок");
	ДопПараметр.Вставить("ВходитВОперанд",		"ДополнительныеОперандыПланыСОтбором");
	
	ДопПараметры.Вставить("ПланыЗакупокСОтбором", ДопПараметр);
#КонецОбласти
	
#Область ФактыЗакупок
	// Свойства реквизита формы
	ДопПараметр = Новый Структура();
	ДопПараметр.Вставить("Имя", 				"ФактыЗакупок");
