Процедура ПодготовитьСуммыЛимитирования(Запрос) экспорт
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_ТаблицаПланов.Период КАК Период,
	|	ВТ_ТаблицаПланов.ВидБюджета КАК ВидБюджета,
	|	ВТ_ТаблицаПланов.ПериодОтчета КАК ПериодОтчета,
	|	ВТ_ТаблицаПланов.ПриходРасход КАК ПриходРасход,
	|	ВТ_ТаблицаПланов.ЦФО КАК ЦФО,
	|	ВТ_ТаблицаПланов.Проект КАК Проект,
	|	ВТ_ТаблицаПланов.Организация КАК Организация,
	|	ВТ_ТаблицаПланов.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ТаблицаПланов.Аналитика1 КАК Аналитика1,
	|	ВТ_ТаблицаПланов.Аналитика2 КАК Аналитика2,
	|	ВТ_ТаблицаПланов.Аналитика3 КАК Аналитика3,
	|	ВТ_ТаблицаПланов.Валюта КАК Валюта,
	|	ВТ_ТаблицаПланов.Контрагент КАК Контрагент,
	|	ВТ_ТаблицаПланов.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	НЕОПРЕДЕЛЕНО КАК ДокументПланирования,
	|	ВЫБОР
	|		КОГДА ВТ_ТаблицаПланов.ДокументПланирования ССЫЛКА Документ.ОперативныйПлан
	|			ТОГДА ВЫРАЗИТЬ(ВТ_ТаблицаПланов.ДокументПланирования КАК Документ.ОперативныйПлан)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ОперативныйПлан.ПустаяСсылка)
	|	КОНЕЦ КАК ДокументРезервирования,
	|	ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.ВводЛимитов)
	|			ТОГДА ВТ_ТаблицаПланов.Исходный
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.КорректировкаЛимитов)
	|			ТОГДА ВТ_ТаблицаПланов.Исходный
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Лимит,
	|	ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.ВводЛимитов)
	|			ТОГДА 0
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.КорректировкаЛимитов)
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_ТаблицаПланов.Зарезервировано
	|	КОНЕЦ КАК Зарезервировано,
	|	0 КАК Заявлено,
	|	0 КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная
	|ИЗ
	|	ВТ_ТаблицаПланов КАК ВТ_ТаблицаПланов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Период КАК Период,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.ВидБюджета КАК ВидБюджета,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.ПериодОтчета КАК ПериодОтчета,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.ПриходРасход КАК ПриходРасход,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.ЦФО КАК ЦФО,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Проект КАК Проект,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Организация КАК Организация,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.СтатьяБюджета КАК СтатьяБюджета,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Аналитика1 КАК Аналитика1,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Аналитика2 КАК Аналитика2,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Аналитика3 КАК Аналитика3,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Валюта КАК Валюта,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Контрагент КАК Контрагент,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.ДокументПланирования КАК ДокументПланирования,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.ДокументРезервирования КАК ДокументРезервирования,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Лимит КАК Лимит,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Зарезервировано КАК Зарезервировано,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Заявлено КАК Заявлено,
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная.Исполнено КАК Исполнено
	|ПОМЕСТИТЬ ВТ_ТаблицаПлановССуммамиЛимитирования
	|ИЗ
	|	ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная КАК ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная";
	
	Если Запрос.Параметры.Свойство("НеУничтожатьВТ") = Ложь ИЛИ Запрос.Параметры.НеУничтожатьВТ = Ложь Тогда
		Запрос.Текст = Запрос.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ТаблицаПлановССуммамиЛимитированияПредварительная";
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ТекстЗапросаОперПланДляИнтерактивнойПроверкиЛимитов(Запрос, ТекстыЗапроса) экспорт
	
	ИмяРегистра = "ОперативныйПланПоБюджетам";
	ТекстЗапроса = ТекстЗапроса_ВТ_ОперПлан(Истина);
