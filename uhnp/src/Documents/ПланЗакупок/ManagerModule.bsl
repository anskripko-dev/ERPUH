Функция ТекстЗапроса_ВТ_ОперПлан(ФормироватьВременнуюТаблицу = Истина)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Период КАК Период,
	|	ВложенныйЗапрос.ВидБюджета КАК ВидБюджета,
	|	ВложенныйЗапрос.ПериодОтчета КАК ПериодОтчета,
	|	ВложенныйЗапрос.СтатьяБюджета КАК СтатьяБюджета,
	|	ВложенныйЗапрос.Аналитика1 КАК Аналитика1,
	|	ВложенныйЗапрос.Аналитика2 КАК Аналитика2,
	|	ВложенныйЗапрос.Аналитика3 КАК Аналитика3,
	|	ВложенныйЗапрос.Валюта КАК Валюта,
	|	ВложенныйЗапрос.ПриходРасход КАК ПриходРасход,
	|	ВложенныйЗапрос.Контрагент КАК Контрагент,
	|	ВложенныйЗапрос.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВложенныйЗапрос.ЦФО КАК ЦФО,
	|	ВложенныйЗапрос.Проект КАК Проект,
	|	ВложенныйЗапрос.Организация КАК Организация,
	|	ВложенныйЗапрос.ДокументПланирования КАК ДокументПланирования,
	|	СУММА(ВложенныйЗапрос.Исходный) КАК Исходный,
	|	СУММА(ВложенныйЗапрос.Зарезервировано) КАК Зарезервировано
	|ПОМЕСТИТЬ ВТ_ТаблицаПланов
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Дата КАК Период,
	|		ОперативныйПланДвиженияОперации.Ссылка.ВидБюджета КАК ВидБюджета,
	|		ОперативныйПланДвиженияОперации.Период КАК ПериодОтчета,
	|		ОперативныйПланДвиженияОперации.СтатьяБюджета КАК СтатьяБюджета,
	|		ОперативныйПланДвиженияОперации.Аналитика1 КАК Аналитика1,
	|		ОперативныйПланДвиженияОперации.Аналитика2 КАК Аналитика2,
	|		ОперативныйПланДвиженияОперации.Аналитика3 КАК Аналитика3,
	|		ОперативныйПланДвиженияОперации.Валюта КАК Валюта,
	|		ОперативныйПланДвиженияОперации.ПриходРасход КАК ПриходРасход,
	|		ОперативныйПланДвиженияОперации.Контрагент КАК Контрагент,
	|		ОперативныйПланДвиженияОперации.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|		ОперативныйПланДвиженияОперации.ЦФО КАК ЦФО,
	|		ОперативныйПланДвиженияОперации.Проект КАК Проект,
	|		ОперативныйПланДвиженияОперации.Организация КАК Организация,
	|		ВЫБОР
	|			КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.Резервирование)
	|				ТОГДА ОперативныйПланДвиженияОперации.Ссылка
	|			КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОперативныйПлан.УточнениеРезервирования)
	|				ТОГДА &ДокументПланирования
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК ДокументПланирования,
	|		ВЫБОР
	|			КОГДА &ЭтоЦелевойПлан = ЛОЖЬ
	|				ТОГДА 0
	|			ИНАЧЕ ОперативныйПланДвиженияОперации.Сумма
	|		КОНЕЦ КАК Исходный,
	|		ВЫБОР
	|			КОГДА &ЭтоЦелевойПлан = ИСТИНА
	|				ТОГДА 0
	|			ИНАЧЕ ОперативныйПланДвиженияОперации.Сумма
	|		КОНЕЦ КАК Зарезервировано
	|	ИЗ
	|		Документ.ОперативныйПлан.ДвиженияОперации КАК ОперативныйПланДвиженияОперации
	|	ГДЕ
	|		ОперативныйПланДвиженияОперации.Ссылка = &Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Аналитика1,
	|	ВложенныйЗапрос.Аналитика2,
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.ВидБюджета,
	|	ВложенныйЗапрос.ПериодОтчета,
	|	ВложенныйЗапрос.СтатьяБюджета,
	|	ВложенныйЗапрос.Валюта,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.Аналитика3,
	|	ВложенныйЗапрос.ЦФО,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.Проект,
	|	ВложенныйЗапрос.ПриходРасход,
	|	ВложенныйЗапрос.ДоговорКонтрагента,
	|	ВложенныйЗапрос.ДокументПланирования
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВложенныйЗапрос.Зарезервировано) <> 0
	|		ИЛИ СУММА(ВложенныйЗапрос.Исходный) <> 0)";
	
	Если НЕ ФормироватьВременнуюТаблицу Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ_ТаблицаПланов", "");
	КонецЕсли; 
	
	ТекстЗапроса = "ВЫБРАТЬ * ИЗ ВТ_ТаблицаПланов";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ЭтоПланированиеПотребностей(Режим)
	
	Возврат Режим = ПредопределенноеЗначение("Перечисление.РежимыФормированияПотребностейПланомЗакупок.РегистрируютПотребности")
	ИЛИ Режим = ПредопределенноеЗначение("Перечисление.РежимыФормированияПотребностейПланомЗакупок.ФормируютПотребности");
	
КонецФункции

#Область УХ_Встраивание
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицаПланыЗакупок(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаПланыОплатПоставщикам(Запрос, ТекстыЗапроса, Регистры);
	//++ НЕ УТ
	ТекстЗапросаТаблицаОборотыБюджетов(Запрос, ТекстыЗапроса, Регистры);
	//-- НЕ УТ
	
	
	ВстраиваниеУХПланЗакупок.ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры, Запрос, ТекстыЗапроса);
	
	ПроведениеСерверУХ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
	//ВстраиваниеУХПланЗакупок.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);

	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИнициализироватьЗапрос(Запрос, ДокументСсылка);        
	ПараметрыПланирования = ПодготовитьПараметрыПланированияПотребностей(ДокументСсылка, Запрос.МенеджерВременныхТаблиц, Ложь);
	ПланированиеПотребностей.ПодготовитьДанныеПланированияДокумента(ПараметрыПланирования);
	Запрос.УстановитьПараметр("ОбъектПланирования", ПараметрыПланирования.ОбъектПланирования);  
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса	
	ТекстыЗапроса = Новый СписокЗначений;
	ПланированиеПотребностей.ПодготовитьТаблицыПланирования(Запрос, ТекстыЗапроса, Регистры);
	ПроведениеСерверОПК.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);

КонецПроцедуры

Процедура ИнициализироватьЗапрос(Запрос, Объект)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, "Ссылка, Дата, Проведен, Валюта");
	Для Каждого КлючЗначение Из РеквизитыДокумента Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

Функция ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц, ДляКонтроля = Истина) Экспорт  
	
	ПараметрыПланирования = ВстраиваниеУХПланЗакупок.ПодготовитьПараметрыПланированияПотребностей(Объект, МенеджерВременныхТаблиц, ДляКонтроля);    
	
	Возврат ПараметрыПланирования;
	
