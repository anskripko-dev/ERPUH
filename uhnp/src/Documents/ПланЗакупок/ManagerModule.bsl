Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.Статус КАК Статус,
	|	ДанныеДокумента.Сценарий КАК Сценарий,
	|	ДанныеДокумента.ВидПлана КАК ВидПлана,
	|	ДанныеДокумента.Замещающий КАК Замещающий,
	|	ДанныеДокумента.Подразделение КАК Подразделение,
	|	ДанныеДокумента.Склад КАК Склад,
	|	ДанныеДокумента.Партнер КАК Партнер,
	//++ НЕ УТ
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.Сценарий.ПланЗакупокПланироватьПоСумме
	|			ТОГДА ДанныеДокумента.Валюта
	|		ИНАЧЕ ДанныеДокумента.СценарийБюджетирования.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ДанныеДокумента.СтатьяБюджетов КАК СтатьяБюджетов,
	|	ДанныеДокумента.СценарийБюджетирования КАК СценарийБюджетирования,
	|	ДанныеДокумента.ОтражаетсяВБюджетировании КАК ОтражаетсяВБюджетировании,
	|	ДанныеДокумента.СтатьяБюджетовОплат КАК СтатьяБюджетовОплат,
	|	ДанныеДокумента.ОтражаетсяВБюджетированииОплаты КАК ОтражаетсяВБюджетированииОплаты,
	|	ДанныеДокумента.СтатьяБюджетовОплатКредит КАК СтатьяБюджетовОплатКредит,
	|	ДанныеДокумента.ОтражаетсяВБюджетированииОплатыКредит КАК ОтражаетсяВБюджетированииОплатыКредит,
	//-- НЕ УТ
	|	ДанныеДокумента.НачалоПериода КАК НачалоПериода,
	|	ДанныеДокумента.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ДанныеДокумента.Назначение КАК Назначение,
	|	ДанныеДокумента.ВидПлана.ЗаполнятьНазначениеВТЧ КАК ЗаполнятьНазначениеВТЧ
	|ИЗ
	|	Документ.ПланЗакупок КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка
	//++ НЕ УТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДополнительныеРеквизиты.НомерСтроки,
	|	ДополнительныеРеквизиты.Значение
	|ИЗ
	|	Документ.ПланЗакупок.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
	|ГДЕ
	|	ДополнительныеРеквизиты.Ссылка = &Ссылка
	//-- НЕ УТ
	|";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();  
	Реквизиты = РезультатыЗапроса[0].Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("НачалоПериода",          Реквизиты.НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода",       Реквизиты.ОкончаниеПериода);
	Запрос.УстановитьПараметр("Сценарий",               Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("ВидПлана",               Реквизиты.ВидПлана);
	Запрос.УстановитьПараметр("Замещающий",             Реквизиты.Замещающий);
	Запрос.УстановитьПараметр("Статус",                 Реквизиты.Статус);
	Запрос.УстановитьПараметр("Подразделение",          Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("Партнер",                Реквизиты.Партнер);
	Запрос.УстановитьПараметр("Назначение",             Реквизиты.Назначение);
	Запрос.УстановитьПараметр("ЗаполнятьНазначениеВТЧ", Реквизиты.ЗаполнятьНазначениеВТЧ);
	
	//++ НЕ УТ
	Запрос.УстановитьПараметр("Дата",                                  Реквизиты.Дата);
	Запрос.УстановитьПараметр("Валюта",                                Реквизиты.Валюта);
	Запрос.УстановитьПараметр("СтатьяБюджетов",                        Реквизиты.СтатьяБюджетов);
	Запрос.УстановитьПараметр("СценарийБюджетирования",                Реквизиты.СценарийБюджетирования);
	Запрос.УстановитьПараметр("ОтражаетсяВБюджетировании",             Реквизиты.ОтражаетсяВБюджетировании);
	Запрос.УстановитьПараметр("СтатьяБюджетовОплат",                   Реквизиты.СтатьяБюджетовОплат);
	Запрос.УстановитьПараметр("ОтражаетсяВБюджетированииОплаты",       Реквизиты.ОтражаетсяВБюджетированииОплаты);
	Запрос.УстановитьПараметр("СтатьяБюджетовОплатКредит",             Реквизиты.СтатьяБюджетовОплатКредит);
	Запрос.УстановитьПараметр("ОтражаетсяВБюджетированииОплатыКредит", Реквизиты.ОтражаетсяВБюджетированииОплатыКредит);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета",            Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета",        ЗначениеНастроекПовтИсп.БазоваяВалютаПоУмолчанию());
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Запрос.УстановитьПараметр("ДополнительныйРеквизит"+Формат(ВыборкаДетальныеЗаписи.НомерСтроки, "ЧГ=0"), ВыборкаДетальныеЗаписи.Значение);
	КонецЦикла;
	//-- НЕ УТ
	#Область УХ_Встраивание
	//**ВстраиваниеУХПланЗакупок.ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры, Запрос, ТекстыЗапроса);
	#КонецОбласти
	
	#Область УХ_Встраивание
	//**ВстраиваниеУХПланЗакупок.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	#КонецОбласти
КонецПроцедуры

Функция ТекстЗапросаТаблицаПланыЗакупок(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ПланыЗакупок";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаТовары.Ссылка КАК ПланЗакупок,
	|	&Статус КАК Статус,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.ДатаПоступления = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА &НачалоПериода
	|		ИНАЧЕ ТаблицаТовары.ДатаПоступления
	|	КОНЕЦ КАК Период,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ВЫБОР
	|					КОГДА ТаблицаТовары.ДатаПоступления = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА &НачалоПериода
	|					ИНАЧЕ ТаблицаТовары.ДатаПоступления
	|				КОНЕЦ
	|		ИНАЧЕ ТаблицаТовары.ДатаЗаказа
	|	КОНЕЦ КАК ДатаЗаказа,
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаТовары.Назначение
	|	КОНЕЦ КАК Назначение,
	|	&Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|				ИЛИ СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаТовары.Склад
	|	КОНЕЦ КАК Склад,
	|	&Сценарий КАК Сценарий,
	|	&ВидПлана КАК ВидПлана,
	|	ТаблицаТовары.Партнер КАК Партнер,
	|	ТаблицаТовары.Соглашение КАК Соглашение,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.Замещен
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаТовары.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА &Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|			ТОГДА ТаблицаТовары.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КЗаказу,
	|	ТаблицаТовары.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.ЗаданИнтервалПотребности
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЗаданИнтервалПотребности,
	|	ТаблицаТовары.ИнтервалПотребностиОт    КАК ИнтервалПотребностиОт,
	|	ТаблицаТовары.ИнтервалПотребностиДо    КАК ИнтервалПотребностиДо
	|ИЗ
	|	Документ.ПланЗакупок.Товары КАК ТаблицаТовары
	//+УХ_Внедрение 
	//|		Левое СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура   
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура   
	//-УХ_Внедрение
	|		ПО ТаблицаТовары.Номенклатура = СпрНоменклатура.Ссылка
	
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И НЕ ТаблицаТовары.Отменено
	|	И &Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Отменен)
	|	И (НЕ ТаблицаТовары.Замещен
	|				И &Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|			ИЛИ НЕ ТаблицаТовары.ЗамещенКЗаказу
	|				И &Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден))
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаПланыОплатПоставщикам(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ПланыОплатПоставщикам";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	|	&Статус КАК Статус,
	|	ТаблицаДокумента.ДатаПлатежа КАК Период,
	|	&Сценарий КАК Сценарий,
	|	&Партнер КАК Партнер,
	|	ТаблицаДокумента.Ссылка КАК План,
	|	ТаблицаДокумента.СуммаПлатежа КАК Сумма
	|ИЗ
	|	Документ.ПланЗакупок.ПланОплаты КАК ТаблицаДокумента
	|ГДЕ
	|	ТаблицаДокумента.Ссылка = &Ссылка
	|	И НЕ ТаблицаДокумента.Замещен
	|	И &Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Отменен)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

//++ НЕ УТ

Функция ТекстЗапросаТаблицаОборотыБюджетов(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ОборотыБюджетов";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВтКонтрагентыПартнеров", ТекстыЗапроса) Тогда
		ТекстЗапросаВтКонтрагентыПартнеров(Запрос, ТекстыЗапроса);
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВтПериодыПланирования", ТекстыЗапроса) Тогда
		ТекстЗапросаВтПериодыПланирования(Запрос, ТекстыЗапроса);
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВтКурсыВалюты", ТекстыЗапроса) Тогда
		ТекстЗапросаВтКурсыВалюты(Запрос, ТекстыЗапроса);
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВтПериодыКурсовВалюты", ТекстыЗапроса) Тогда
		ТекстЗапросаВтПериодыКурсовВалюты(Запрос, ТекстыЗапроса);
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВтПрогнозныеКурсыВалюты", ТекстыЗапроса) Тогда
		ТекстЗапросаВтПрогнозныеКурсыВалюты(Запрос, ТекстыЗапроса);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Статус КАК Статус,
	|	Товары.ДатаПоступления КАК ПериодПланирования,
	|	&СценарийБюджетирования КАК Сценарий,
	|	&Валюта КАК Валюта,
	|	Товары.Соглашение.Организация КАК Организация,
	|	&Подразделение КАК Подразделение,
	|	&СтатьяБюджетов КАК СтатьяБюджетов,
	|	
	|	&АналитикаТовары1 КАК Аналитика1,
	|	&АналитикаТовары2 КАК Аналитика2,
	|	&АналитикаТовары3 КАК Аналитика3,
	|	&АналитикаТовары4 КАК Аналитика4,
	|	&АналитикаТовары5 КАК Аналитика5,
	|	&АналитикаТовары6 КАК Аналитика6,
	|	
	|	СУММА(Товары.Количество) КАК Количество,
	|	СУММА(Товары.Сумма) КАК СуммаВВалюте,
	|	СУММА(Товары.Сумма) КАК СуммаСценария,
	|	СУММА(Товары.Сумма * ВЫРАЗИТЬ(ЕСТЬNULL(КурсыВалютыДокумента.Курс, 1) КАК ЧИСЛО(15,3)) / ВЫРАЗИТЬ(ЕСТЬNULL(КурсыВалютыРегл.Курс, 1) КАК ЧИСЛО(15,3))) КАК СуммаРегл,
	|	СУММА(Товары.Сумма * ВЫРАЗИТЬ(ЕСТЬNULL(КурсыВалютыДокумента.Курс, 1) КАК ЧИСЛО(15,3)) / ВЫРАЗИТЬ(ЕСТЬNULL(КурсыВалютыУпр.Курс, 1) КАК ЧИСЛО(15,3))) КАК СуммаУпр
	|ИЗ
	|	Документ.ПланЗакупок.Товары КАК Товары
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыДокумента
	|		ПО (КурсыВалютыДокумента.Валюта = &Валюта)
	|			И Товары.ДатаПоступления = КурсыВалютыДокумента.ПериодПланирования
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыУпр
	|		ПО (КурсыВалютыУпр.Валюта = &ВалютаУправленческогоУчета)
	|			И Товары.ДатаПоступления = КурсыВалютыУпр.ПериодПланирования
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыРегл
	|		ПО (КурсыВалютыРегл.Валюта = &ВалютаРегламентированногоУчета)
	|			И Товары.ДатаПоступления = КурсыВалютыРегл.ПериодПланирования
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтКонтрагентыПартнеров КАК ВтКонтрагентыПартнеров
	|		ПО Товары.Партнер = ВтКонтрагентыПартнеров.Партнер
	|	
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И &ОтражаетсяВБюджетировании
	|	И &Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Отменен)
	|	И НЕ Товары.Отменено
	|	И НЕ Товары.Замещен
	|
	|СГРУППИРОВАТЬ ПО
	|	&АналитикаТовары1,
	|	&АналитикаТовары2,
	|	&АналитикаТовары3,
	|	&АналитикаТовары4,
	|	&АналитикаТовары5,
	|	&АналитикаТовары6,
	|	Товары.ДатаПоступления,
	|	Товары.Соглашение.Организация
	|
	|ИМЕЮЩИЕ
	|	(СУММА(Товары.Количество) <> 0 ИЛИ СУММА(Товары.Сумма) <> 0)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Статус КАК Статус,
	|	ПланОплат.ДатаПлатежа,
	|	&СценарийБюджетирования КАК Сценарий,
	|	&Валюта КАК Валюта,
	|	ПланОплат.Ссылка.Соглашение.Организация КАК Организация,
	|	&Подразделение КАК Подразделение,
	|	&СтатьяБюджетовОплат КАК СтатьяБюджетовОплат,
	|	
	|	&АналитикаПланОплат1 КАК Аналитика1,
	|	&АналитикаПланОплат2 КАК Аналитика2,
	|	&АналитикаПланОплат3 КАК Аналитика3,
	|	&АналитикаПланОплат4 КАК Аналитика4,
	|	&АналитикаПланОплат5 КАК Аналитика5,
	|	&АналитикаПланОплат6 КАК Аналитика6,
	|	
	|	СУММА(0),
	|	СУММА(ПланОплат.СуммаПлатежа),
	|	СУММА(ПланОплат.СуммаПлатежа),
	|	СУММА(ПланОплат.СуммаПлатежа * ЕСТЬNULL(КурсыВалютыДокумента.Курс, 1) / ЕСТЬNULL(КурсыВалютыРегл.Курс, 1)) КАК СуммаРегл,
	|	СУММА(ПланОплат.СуммаПлатежа * ЕСТЬNULL(КурсыВалютыДокумента.Курс, 1) / ЕСТЬNULL(КурсыВалютыУпр.Курс, 1)) КАК СуммаУпр
	|ИЗ
	|	Документ.ПланЗакупок.ПланОплаты КАК ПланОплат
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыДокумента
	|		ПО (КурсыВалютыДокумента.Валюта = &Валюта)
	|			И ПланОплат.ДатаПлатежа = КурсыВалютыДокумента.ПериодПланирования
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыУпр
	|		ПО (КурсыВалютыУпр.Валюта = &ВалютаУправленческогоУчета)
	|			И ПланОплат.ДатаПлатежа = КурсыВалютыУпр.ПериодПланирования
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыРегл
	|		ПО (КурсыВалютыРегл.Валюта = &ВалютаРегламентированногоУчета)
	|			И ПланОплат.ДатаПлатежа = КурсыВалютыРегл.ПериодПланирования
	|	
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтКонтрагентыПартнеров КАК ВтКонтрагентыПартнеров
	|		ПО ПланОплат.Ссылка.Партнер = ВтКонтрагентыПартнеров.Партнер
	|	
	|ГДЕ
	|	ПланОплат.Ссылка = &Ссылка
	|	И &ОтражаетсяВБюджетированииОплаты
	|	И &Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Отменен)
	|	И НЕ ПланОплат.Замещен
	|	И (НЕ &ОтражаетсяВБюджетированииОплатыКредит
	|		ИЛИ НЕ ПланОплат.ВариантОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыКонтроляОплатыПоставщику.КредитСдвиг)
	|				И НЕ ПланОплат.ВариантОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыКонтроляОплатыПоставщику.КредитПослеПоступления))
	|
	|СГРУППИРОВАТЬ ПО
	|	&АналитикаПланОплат1,
	|	&АналитикаПланОплат2,
	|	&АналитикаПланОплат3,
	|	&АналитикаПланОплат4,
	|	&АналитикаПланОплат5,
	|	&АналитикаПланОплат6,
	|	ПланОплат.Ссылка.Соглашение.Организация,
	|	ПланОплат.ДатаПлатежа
	|	
	|ИМЕЮЩИЕ
	|	СУММА(ПланОплат.СуммаПлатежа) <> 0 
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Статус КАК Статус,
	|	ПланОплатКредит.ДатаПлатежа,
	|	&СценарийБюджетирования КАК Сценарий,
	|	&Валюта КАК Валюта,
	|	ПланОплатКредит.Ссылка.Соглашение.Организация КАК Организация,
	|	&Подразделение КАК Подразделение,
	|	&СтатьяБюджетовОплатКредит КАК СтатьяБюджетовОплатКредит,
	|	
	|	&АналитикаПланОплатКредит1 КАК Аналитика1,
	|	&АналитикаПланОплатКредит2 КАК Аналитика2,
	|	&АналитикаПланОплатКредит3 КАК Аналитика3,
	|	&АналитикаПланОплатКредит4 КАК Аналитика4,
	|	&АналитикаПланОплатКредит5 КАК Аналитика5,
	|	&АналитикаПланОплатКредит6 КАК Аналитика6,
	|	
	|	СУММА(0),
	|	СУММА(ПланОплатКредит.СуммаПлатежа),
	|	СУММА(ПланОплатКредит.СуммаПлатежа),
	|	СУММА(ПланОплатКредит.СуммаПлатежа * ЕСТЬNULL(КурсыВалютыДокумента.Курс, 1) / ЕСТЬNULL(КурсыВалютыРегл.Курс, 1)) КАК СуммаРегл,
	|	СУММА(ПланОплатКредит.СуммаПлатежа * ЕСТЬNULL(КурсыВалютыДокумента.Курс, 1) / ЕСТЬNULL(КурсыВалютыУпр.Курс, 1)) КАК СуммаУпр
	|ИЗ
	|	Документ.ПланЗакупок.ПланОплаты КАК ПланОплатКредит
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыДокумента
	|		ПО (КурсыВалютыДокумента.Валюта = &Валюта)
	|			И ПланОплатКредит.ДатаПлатежа = КурсыВалютыДокумента.ПериодПланирования
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыУпр
	|		ПО (КурсыВалютыУпр.Валюта = &ВалютаУправленческогоУчета)
	|			И ПланОплатКредит.ДатаПлатежа = КурсыВалютыУпр.ПериодПланирования
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПрогнозныеКурсыВалюты КАК КурсыВалютыРегл
	|		ПО (КурсыВалютыРегл.Валюта = &ВалютаРегламентированногоУчета)
	|			И ПланОплатКредит.ДатаПлатежа = КурсыВалютыРегл.ПериодПланирования
	|	
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтКонтрагентыПартнеров КАК ВтКонтрагентыПартнеров
	|		ПО ПланОплатКредит.Ссылка.Партнер = ВтКонтрагентыПартнеров.Партнер
	|	
	|ГДЕ
	|	ПланОплатКредит.Ссылка = &Ссылка
	|	И &ОтражаетсяВБюджетированииОплатыКредит
	|	И &Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Отменен)
	|	И НЕ ПланОплатКредит.Замещен
	|	И (ПланОплатКредит.ВариантОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыКонтроляОплатыПоставщику.КредитСдвиг)
	|		ИЛИ ПланОплатКредит.ВариантОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыКонтроляОплатыПоставщику.КредитПослеПоступления))
	|
	|СГРУППИРОВАТЬ ПО
	|	&АналитикаПланОплатКредит1,
	|	&АналитикаПланОплатКредит2,
	|	&АналитикаПланОплатКредит3,
	|	&АналитикаПланОплатКредит4,
	|	&АналитикаПланОплатКредит5,
	|	&АналитикаПланОплатКредит6,
	|	ПланОплатКредит.Ссылка.Соглашение.Организация,
	|	ПланОплатКредит.ДатаПлатежа
	|	
	|ИМЕЮЩИЕ
	|	СУММА(ПланОплатКредит.СуммаПлатежа) <> 0";
	
	БюджетированиеСервер.УстановитьВЗапросеВыраженияЗаполненияАналитики(
		Запрос.Параметры.Ссылка,
		ТекстЗапроса,
		Запрос.Параметры.СтатьяБюджетов,
		Документы.ПланЗакупок,
		"АналитикаТовары",
		"Товары");
	
	БюджетированиеСервер.УстановитьВЗапросеВыраженияЗаполненияАналитики(
		Запрос.Параметры.Ссылка,
		ТекстЗапроса,
		Запрос.Параметры.СтатьяБюджетовОплат,
		Документы.ПланЗакупок,
		"АналитикаПланОплат",
		"ПланОплат");
	
	БюджетированиеСервер.УстановитьВЗапросеВыраженияЗаполненияАналитики(
		Запрос.Параметры.Ссылка,
		ТекстЗапроса,
		Запрос.Параметры.СтатьяБюджетовОплатКредит,
		Документы.ПланЗакупок,
		"АналитикаПланОплатКредит",
		"ПланОплатКредит");
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВтКонтрагентыПартнеров(Запрос, ТекстыЗапроса)
	
	ИмяРегистра = "ВтКонтрагентыПартнеров";
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПланЗакупокТовары.Партнер КАК Партнер,
	|	МАКСИМУМ(Контрагенты.Ссылка) КАК Контрагент
	|ПОМЕСТИТЬ ВтКонтрагентыПартнеров
	|ИЗ
	|	Документ.ПланЗакупок.Товары КАК ПланЗакупокТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ПланЗакупокТовары.Партнер = Контрагенты.Партнер
	|ГДЕ
	|	ПланЗакупокТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПланЗакупокТовары.Партнер
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партнер";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
