#Область ПрограммныйИнтерфейс
// Функция - Подготовить параметры проведения
//
// Параметры:
//  ДокументСсылка	 - ДокументСсылкаЦессияИсходящая	 - документ Цессия исходящая
//  Отказ			 - Булево	 - отказ 
// 
// Возвращаемое значение:
//  Структура - параметры для проведения документа
//
Функция ПодготовитьПараметрыПроведения(ДокументСсылка, Отказ) Экспорт
	
	ТаблицыДляДвижений 		= Новый Структура;		
	ДополнительныеСвойства 	= Новый Структура;
	НомераТаблиц 			= Новый Структура;
	
	// реквизиты документа.
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст 	= ТекстЗапросаРеквизитыДокумента();	
	Реквизиты 		= ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);

	ДополнительныеСвойства.Вставить("Реквизиты", Реквизиты);
	
	Если Отказ Тогда
		Возврат ДополнительныеСвойства;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Реквизиты Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ПериодГраница", 		Новый Граница(Реквизиты.МоментВремени, ВидГраницы.Исключая));
	
	ТекстЗапроса = Новый Массив;
	ТекстЗапроса.Добавить(ТекстЗапросаРасчетыСКонтрагентамиФакт(НомераТаблиц, 	"РасчетыСКонтрагентамиФакт"));
	ТекстЗапроса.Добавить(ТекстЗапросаВерсииРасчетов(НомераТаблиц, 				"ВерсииГрафиковРасчетов")); 
	ТекстЗапроса.Добавить(ТекстЗапросаРасчетыСКонтрагентамиГрафики(НомераТаблиц,				"РасчетыСКонтрагентамиГрафики"));
	Запрос.Текст = СтрСоединить(ТекстЗапроса, ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета());	
	
	Результат = Запрос.ВыполнитьПакет();

	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		Если СтрНачинаетсяС(НомерТаблицы.Ключ, "Таблица") Или СтрНачинаетсяС(НомерТаблицы.Ключ, "вт") Или (НомерТаблицы.Ключ = "ОшибкиПроводок") Тогда			
			Продолжить;
		КонецЕсли;
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
			
	ДополнительныеСвойства.Вставить("ТаблицыДляДвижений", ТаблицыДляДвижений);
	
	Возврат ДополнительныеСвойства;

КонецФункции

