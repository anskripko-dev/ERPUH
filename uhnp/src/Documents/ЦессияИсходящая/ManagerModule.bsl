Функция ТекстЗапросаРеквизитыДокумента(НомераТаблиц = Неопределено)

	Если НомераТаблиц <> Неопределено Тогда
		НомераТаблиц.Вставить("Реквизиты", НомераТаблиц.Количество());	
	КонецЕсли;	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Дата КАК Период,
	|	Реквизиты.МоментВремени КАК МоментВремени,
	|	Реквизиты.Организация КАК Организация,
	|	Реквизиты.Контрагент КАК Контрагент,
	|	Реквизиты.ДоговорЦессии КАК ДоговорЦессии,
	|	Реквизиты.Должник КАК Должник,
	|	Реквизиты.ДоговорДолжника КАК ДоговорДолжника,
	|	Реквизиты.СуммаОбязательства КАК СуммаОбязательства,
	|	Реквизиты.СтавкаНДС КАК СтавкаНДС,
	|	Реквизиты.СуммаНДС КАК СуммаНДС,
	|	Реквизиты.СуммаДокумента КАК СуммаДокумента,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	Реквизиты.ДоговорЦессии.ВидДоговораУХ КАК ЦессииВидДоговораУХ,
	|	Реквизиты.ДоговорДолжника.ВидДоговораУХ КАК ДолжникаВидДоговораУХ
	|ИЗ
	|	Документ.ЦессияИсходящая КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаРасчетыСКонтрагентамиФакт(НомераТаблиц, ИмяТаблицы)
	
	НомераТаблиц.Вставить(ИмяТаблицы, НомераТаблиц.Количество());
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Организация КАК Организация,
	|	&Должник КАК Контрагент,
	|	&ДоговорДолжника КАК ДоговорКонтрагента,
	|	&ВалютаДокумента КАК Валюта,
	|	ЦессияИсходящаяТекущаяЗадолженность.ОбъектРасчетов КАК ОбъектРасчетов,
	|	ЦессияИсходящаяТекущаяЗадолженность.Сумма КАК Сумма,
	|	NULL КАК Операция,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ЦессияИсходящаяТекущаяЗадолженность.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности,
	|	NULL КАК СтатьяБюджета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК ПриходРасход,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов) КАК ВидБюджета,
	|	&ДолжникаВидДоговораУХ КАК ВидДоговораУХ
	|ИЗ
	|	Документ.ЦессияИсходящая.ТекущаяЗадолженность КАК ЦессияИсходящаяТекущаяЗадолженность
	|ГДЕ
	|	ЦессияИсходящаяТекущаяЗадолженность.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	&Организация,
	|	&Контрагент,
	|	&ДоговорЦессии,
	|	&ВалютаДокумента,
	|	&ДоговорЦессии,
	|	&СуммаДокумента,
	|	NULL,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг),
	|	NULL,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход),
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов),
	|	&ЦессииВидДоговораУХ";
	
	Возврат ТекстЗапроса;


КонецФункции

Функция ТекстЗапросаВерсииРасчетов(НомераТаблиц, ИмяТаблицы)

	НомераТаблиц.Вставить(ИмяТаблицы, НомераТаблиц.Количество());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&ДоговорДолжника КАК ПредметГрафика,
	|	&Организация КАК Организация,     
	|	&Ссылка КАК ВерсияГрафика,
	|	ИСТИНА КАК ОпорныйГрафик";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаРасчетыСКонтрагентамиГрафики(НомераТаблиц, ИмяТаблицы)

	НомераТаблиц.Вставить("ТаблицаГрафика", 	НомераТаблиц.Количество());
	НомераТаблиц.Вставить(ИмяТаблицы, 			НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВерсииГрафиковРасчетовСрезПоследних.Регистратор КАК ВерсияГрафика
	|ПОМЕСТИТЬ ТаблицаГрафика
	|ИЗ
	|	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(
	|			&ПериодГраница,
	|			Организация = &Организация
	|				И ПредметГрафика = &ДоговорДолжника) КАК ВерсииГрафиковРасчетовСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыСКонтрагентамиГрафики.Период КАК Период,
	|	РасчетыСКонтрагентамиГрафики.Активность КАК Активность,
	|	РасчетыСКонтрагентамиГрафики.ВидДвижения КАК ВидДвижения,
	|	&Ссылка КАК ВерсияГрафика,
	|	РасчетыСКонтрагентамиГрафики.Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&ДоговорЦессии КАК ПредметГрафика,
	|	РасчетыСКонтрагентамиГрафики.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности,
	|	РасчетыСКонтрагентамиГрафики.Валюта КАК Валюта,
	|	РасчетыСКонтрагентамиГрафики.Сумма КАК Сумма,
	|	РасчетыСКонтрагентамиГрафики.СтатьяБюджета КАК СтатьяБюджета,
	|	РасчетыСКонтрагентамиГрафики.ПриходРасход КАК ПриходРасход,
	|	РасчетыСКонтрагентамиГрафики.Операция КАК Операция,
	|	&Должник КАК Должник
	|ИЗ
	|	РегистрНакопления.РасчетыСКонтрагентамиГрафики КАК РасчетыСКонтрагентамиГрафики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаГрафика КАК ТаблицаГрафика
	|		ПО РасчетыСКонтрагентамиГрафики.ВерсияГрафика = ТаблицаГрафика.ВерсияГрафика
	|			И (РасчетыСКонтрагентамиГрафики.Период < &Период)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	ИСТИНА,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	&Ссылка,
	|	РасчетыСКонтрагентамиГрафикиЗакрытие.Организация,
	|	&Должник,
	|	&ДоговорДолжника,
	|	РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности,
	|	РасчетыСКонтрагентамиГрафикиЗакрытие.Валюта,
	|	РасчетыСКонтрагентамиГрафикиЗакрытие.СуммаОстаток,
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ВЫБОР
	|		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваОсновнойДолг)
	|		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Комиссии)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваКомиссии)
	|		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Проценты)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваПроценты)
	|		КОГДА РасчетыСКонтрагентамиГрафикиЗакрытие.ЭлементСтруктурыЗадолженности = ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Штрафы)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.ЗаемПолученный_ПрекращениеОбязательстваШтрафы)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	&Должник
	|ИЗ
	|	РегистрНакопления.РасчетыСКонтрагентамиГрафики.Остатки(
	|			&ПериодГраница,
	|			ВерсияГрафика В
	|				(ВЫБРАТЬ
	|					ТаблицаГрафика.ВерсияГрафика
	|				ИЗ
	|					ТаблицаГрафика)) КАК РасчетыСКонтрагентамиГрафикиЗакрытие";
	
	Возврат ТекстЗапроса;
 КонецФункции

#КонецОбласти  

#КонецЕсли