#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
   
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли; 
	ОбщегоНазначенияУХ.УстановитьСостояниеДокумента(ЭтотОбъект);
	
	УправлениеФормой();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
    Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
         МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
         МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
    КонецЕсли;
    // Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ДоговорДолжникаПриИзменении(Элемент)
	РассчитатьСуммуОбязательстваНаКлиенте();
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	РассчитатьСуммуНДСНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура СуммаОбязательстваПриИзменении(Элемент)
	РассчитатьСуммуНДСНаКлиенте();  
	ОбновитьИтогиРаспределения();
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)
    РассчитатьСуммуНДСНаКлиенте();
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура ВалютаДокументаПриИзменении(Элемент)
	УправлениеФормой();	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.Комментарий");
КонецПроцедуры

&НаКлиенте
Процедура ВидОбязательстваПриИзменении(Элемент)  

	Объект.ДоговорДолжника = Неопределено;
	УправлениеФормой();		
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТекущаяЗадолженность

&НаКлиенте
Процедура ТекущаяЗадолженностьПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если Объект.СуммаОбязательства = 0  Тогда
		РассчитатьСуммуОбязательств();	          	
	КонецЕсли;
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяЗадолженностьЭлементСтруктурыЗадолженностиПриИзменении(Элемент)
	СтрокаТекущаяЗадолженность = Элементы.ТекущаяЗадолженность.ТекущиеДанные;
	Если СтрокаТекущаяЗадолженность.Сумма = 0 Тогда 
		СтрокаТекущаяЗадолженность.Сумма = Объект.СуммаОбязательства;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяЗадолженностьСуммаПриИзменении(Элемент)
	РассчитатьСуммуОбязательств();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ПодобратьПоОстаткам(Команда)
	ПараметрыПодбора 	= ПараметрыПодбораОбъектов();
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодобратьОбъектыЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ПодборОбъектовРасчетов.Форма.Форма",
		ПараметрыПодбора, ЭтаФорма,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры 

&НаКлиенте
Процедура ПодобратьОбъектыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьПодборОбъектов(Результат.АдресОбъектовРасчетовВХранилище);
		РассчитатьСуммуНДСНаКлиенте(); 
		УправлениеФормой();

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура УправлениеФормой()
	
	Если ЗначениеЗаполнено(Объект.ДоговорДолжника) Тогда
		
		Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.РежимВыбораИзСписка = Истина;
		СписокВыбора 	= Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.СписокВыбора;
		МассивЭлементов = ЗаявкиНаОперацииВызовСервера.ЭлементыСтруктурыЗадолженностиПоДоговору(Объект.ДоговорДолжника, Объект.Ссылка);
		СписокВыбора.ЗагрузитьЗначения(МассивЭлементов);
		Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.Видимость = (СписокВыбора.Количество() > 0);
		
	Иначе
		Элементы.ТекущаяЗадолженностьЭлементСтруктурыЗадолженности.Видимость = Ложь;
	КонецЕсли;   
	
	Если Объект.ВидОбязательства = Перечисления.ВидыОбязательств.ЗадолженностьПоДоговоруЗайма 
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ДоговорДолжника) Тогда
		ЭтоДолгПоставки 			= Ложь; 
		ДоговорПоЗаказамНакладным   = Ложь; 
	Иначе
		
		РеквизитыДоговораДолжника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДоговорДолжника, "ПорядокРасчетов,ВидДоговораУХ");
		ЭтоДолгПоставки 				= РеквизитыДоговораДолжника.ВидДоговораУХ 	= ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.СПокупателем");
		ДоговорПоЗаказамНакладным 		= (РеквизитыДоговораДолжника.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоЗаказамНакладным")
				ИЛИ РеквизитыДоговораДолжника.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоНакладным")
				ИЛИ РеквизитыДоговораДолжника.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоЗаказам"));
		Если РеквизитыДоговораДолжника.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоЗаказамНакладным") Тогда
			Элементы.ТекущаяЗадолженностьОбъектРасчетов.ОграничениеТипа             = Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента");  
		Иначе	
			Элементы.ТекущаяЗадолженностьОбъектРасчетов.ОграничениеТипа             = Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг");  
		КонецЕсли;

	КонецЕсли;											

	
	Если Объект.СуммаДокумента > Объект.СуммаОбязательства Тогда
		ТекстРазностиСумм = СтрШаблон("Премия %1 %2",  Объект.СуммаДокумента - Объект.СуммаОбязательства, Объект.ВалютаДокумента);
	ИначеЕсли Объект.СуммаДокумента < Объект.СуммаОбязательства Тогда
		ТекстРазностиСумм = СтрШаблон("Дисконт %1 %2", Объект.СуммаОбязательства - Объект.СуммаДокумента, Объект.ВалютаДокумента);
	Иначе
		ТекстРазностиСумм = "";
	КонецЕсли;
	
	Элементы.ТекущаяЗадолженностьПодобратьПоОстаткам.Видимость 			= ЭтоДолгПоставки;
	Элементы.ТекущаяЗадолженностьОбъектРасчетов.Видимость 				= ЭтоДолгПоставки;
	Элементы.ТекущаяЗадолженность.Видимость 							= НЕ ЭтоДолгПоставки ИЛИ (ЭтоДолгПоставки И ДоговорПоЗаказамНакладным);  
	Элементы.ГруппаНДС.Видимость										= ЭтоДолгПоставки;
	
	ТипОграничения = Новый Массив; 
	МассивПараметров 	= Новый Массив();
	Если Объект.ВидОбязательства = Перечисления.ВидыОбязательств.ЗадолженностьПоДоговоруЗайма Тогда
		НовыйПараметр 	= Новый ПараметрВыбора("Отбор.ВидДоговораУХ", Справочники.ВидыДоговоровКонтрагентовУХ.ЗаемВыданный);
		МассивПараметров.Добавить(НовыйПараметр);
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Статус", Перечисления.СтатусыДоговоровКонтрагентов.Действует));
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления",Ложь));
		
		ТипОграничения.Добавить(Тип("СправочникСсылка.ДоговорыКредитовИДепозитов"));
	Иначе
		НовыйПараметр 	= Новый ПараметрВыбора("Отбор.ВидДоговораУХ", Справочники.ВидыДоговоровКонтрагентовУХ.СПокупателем); 
		МассивПараметров.Добавить(НовыйПараметр);
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления",Ложь));
		
		ТипОграничения.Добавить(Тип("СправочникСсылка.ДоговорыКонтрагентов"));	
	КонецЕсли;

	НовыеПараметры 	= Новый ФиксированныйМассив(МассивПараметров);
	Элементы.ДоговорДолжника.ПараметрыВыбора 		= НовыеПараметры;
	Элементы.ДоговорДолжника.ОграничениеТипа 	= Новый ОписаниеТипов(ТипОграничения);	   
    Элементы.Соглашение.Видимость 		= Объект.ВидОбязательства = Перечисления.ВидыОбязательств.ЗадолженностьПоДоговоруЗайма;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуНДСНаКлиенте() 

	Если  Объект.СуммаДокумента > Объект.СуммаОбязательства Тогда
		Объект.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
			Объект.СуммаДокумента - Объект.СуммаОбязательства,
			Истина, 
		УчетНДСУПСлужебныйКлиентСерверПовтИсп.ЗначениеСтавкиНДС(Объект.СтавкаНДС) );
	Иначе
		Объект.СуммаНДС = 0;	
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура РассчитатьСуммуОбязательств()
	Объект.СуммаОбязательства = Объект.ТекущаяЗадолженность.Итог("Сумма");
КонецПроцедуры

&НаСервереБезКонтекста
Функция СуммаОбязательства(Организация, Контрагент, ДоговорКонтрагента, ВидОбязательства)
	Возврат ЦессииУХ.СуммаОбязательстваДолжника(Организация,Контрагент,ДоговорКонтрагента, ВидОбязательства);	
КонецФункции // ()

&НаКлиенте
Процедура РассчитатьСуммуОбязательстваНаКлиенте()
   	МассивОбязательств =  СуммаОбязательства(Объект.Организация, Объект.Должник, Объект.ДоговорДолжника, Объект.ВидОбязательства);
	Объект.ТекущаяЗадолженность.Очистить(); 
	Для Каждого МассивЭлемент Из МассивОбязательств Цикл
	
		ЗаполнитьЗначенияСвойств(Объект.ТекущаяЗадолженность.Добавить(), МассивЭлемент);
	
	КонецЦикла;
	Объект.СуммаОбязательства	= Объект.ТекущаяЗадолженность.Итог("Сумма");
	РассчитатьСуммуНДСНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиРаспределения()
	
	ТаблицаРаспределение 	= Объект.ТекущаяЗадолженность;
	Если НЕ Элементы.ТекущаяЗадолженность.Видимость 
		И ТаблицаРаспределение.Количество() = 0 Тогда  	
		СтрокаТаблицаРаспределение = Объект.ТекущаяЗадолженность.Добавить();
		СтрокаТаблицаРаспределение.ЭлементСтруктурыЗадолженности = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг");
		СтрокаТаблицаРаспределение.Сумма = Объект.СуммаОбязательства;	
	ИначеЕсли НЕ Элементы.ТекущаяЗадолженность.Видимость 
		И ТаблицаРаспределение.Количество() = 1 Тогда
		ТаблицаРаспределение[0].Сумма = Объект.СуммаОбязательства;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодбораОбъектов()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Организация", 			Объект.Организация);
	ПараметрыПодбора.Вставить("Контрагент", 			Объект.Должник);
	ПараметрыПодбора.Вставить("ДоговорКонтрагента", 	Объект.ДоговорДолжника);
	ПараметрыПодбора.Вставить("ВалютаДокумента",	 	Объект.ВалютаДокумента);
	ПараметрыПодбора.Вставить("ЭтоДоход",	 			Истина);
		
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Процедура ОбработатьПодборОбъектов(АдресОбъектовРасчетовВХранилище)
	
	ТаблицаОбъектов 			= ПолучитьИзВременногоХранилища(АдресОбъектовРасчетовВХранилище);
	
	Объект.ТекущаяЗадолженность.Очистить();
	
	Для каждого СтрокаЗаявки Из ТаблицаОбъектов Цикл
		СтрокиПозиции = Объект.ТекущаяЗадолженность.НайтиСтроки(Новый Структура("ОбъектРасчетов", СтрокаЗаявки.ОбъектРасчетов));
		Если СтрокиПозиции.Количество() > 0 Тогда
			СтрокаТЧ = СтрокиПозиции[0];
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаЗаявки);
		Иначе
			СтрокаТЧ = Объект.ТекущаяЗадолженность.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаЗаявки);
		
		КонецЕсли;

	КонецЦикла;

	Объект.СуммаОбязательства	= Объект.ТекущаяЗадолженность.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	УстановитьПартнера();
КонецПроцедуры

&НаСервере
Процедура УстановитьПартнера()
	Объект.Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.Контрагент);
КонецПроцедуры

&НаКлиенте
Процедура СоглашениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ПараметрыВыбораСоглашения = ПродажиКлиент.ПараметрыНачалаВыбораСоглашенияСКлиентом();
	
	ПараметрыВыбораСоглашения.Элемент                     = Элемент;
	ПараметрыВыбораСоглашения.Партнер                     = Объект.Партнер;
	ПараметрыВыбораСоглашения.Документ                    = Объект.Соглашение;
	ПараметрыВыбораСоглашения.ДатаДокумента               = Объект.Дата;
	ПараметрыВыбораСоглашения.ДанныеФормыСтруктура        = Объект;
	
	ПродажиКлиент.НачалоВыбораСоглашенияСКлиентом(ПараметрыВыбораСоглашения, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти
