
#Область ОбработчикиСобытийФормы     

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() 
		И Не Параметры.Свойство("СозданиеДокументаИзНастроекКонтроля") Тогда    
		ТекстИсключения = НСтр("ru = 'Создание документа возможно через меню ""Общие справочники и настройки"" - ""Корпоративные закупки"" - ""Планирование потребности"".'");
		ВызватьИсключение ТекстИсключения; 
	КонецЕсли;
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов   
	
	ТекущийВидБюджетаИсточник = Объект.ВидБюджетаИсточник;
	ТекущийВидБюджетаПриемник = Объект.ВидБюджетаПриемник;   
	
	ВидБюджета = Объект.ВидБюджетаИсточник; 
	
	БюджетДвиженияДенежныхСредств = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
	БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов;  
	
	КоличествоАналитикСтатьи = АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи();
	
	ЗаполнитьДеревоСтатейБюджетовИсточники();
	
	УстановитьУсловноеОформление();

КонецПроцедуры     

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_УстановкаСоответствийМеждуВидамиБюджетов");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидБюджетаПриИзменении(Элемент)
	
	Оповещение = Новый ОписаниеОповещения("ВидБюджетаПриИзмененииЗавершение", ЭтотОбъект);
	
	Если Объект.СтатьиБюджета.Количество() > 0 Тогда
		
		ТекстСообщения = НСтр("ru = 'При изменении вида бюджета таблицы документа будут очищены. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;     
	
КонецПроцедуры

&НаКлиенте
Процедура ВидБюджетаПриИзмененииЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда   		
		Объект.ВидБюджетаИсточник = ТекущийВидБюджетаПриемник;
		Объект.ВидБюджетаПриемник = ТекущийВидБюджетаИсточник;
				
		ТекущийВидБюджетаИсточник = Объект.ВидБюджетаИсточник;
		ТекущийВидБюджетаПриемник = Объект.ВидБюджетаПриемник; 
		
		ВидБюджета = Объект.ВидБюджетаИсточник;
		
		Объект.СтатьиБюджета.Очистить();   	
		ДеревоСтатейБюджетовИсточники.ПолучитьЭлементы().Очистить();
		
	Иначе     			
		ВидБюджета = Объект.ВидБюджетаИсточник;
	КонецЕсли;   
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтатьиБюджета

&НаКлиенте
Процедура СтатьиБюджетаАналитикаПриИзменении(Элемент)
	
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииАналитикиСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
	
КонецПроцедуры

#КонецОбласти  
 
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_СтатьяБюджета_ПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АналитикаСтатьиБюджета_ПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииАналитикиСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтатьиБюджета(Команда)
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ЗаполнитьСтатьиБюджетаЗавершение", ЭтотОбъект);
	
	Если Объект.СтатьиБюджета.Количество() > 0  Тогда 
		ТекстВопроса = НСтр("ru = 'Таблицы документа будут очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗавершении, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ЗаполнитьАналитикиПоУмолчанию(Команда)
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("АналитикиПоУмолчаниюЗавершение", ЭтаФорма);
	
	ОткрытьФорму("Документ.УстановкаСоответствийМеждуВидамиБюджетов.Форма.ФормаАналитики",, 
				ЭтотОбъект, УникальныйИдентификатор,,, ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 

КонецПроцедуры  

&НаКлиенте
Процедура ПоказатьНеУстановленныеСоответствия(Команда)
	
	ЭлементКоманды = Элементы.СтатьиБюджетаИсточникПоказатьНеУстановленныеСоответствия;
	ЭлементКоманды.Пометка = Не ЭлементКоманды.Пометка;
	
	НеУстановленныеСоответствия = ЭлементКоманды.Пометка;
	ЗаполнитьДеревоСтатейБюджетовИсточники(НеУстановленныеСоответствия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПомощникУстановкиСоответствий(Команда)
	
	АдресДанные = ПолучитьНесопоставленныеДанные();     
	
	Если Не ЗначениеЗаполнено(АдресДанные) Тогда     
		ТекстПредупреждения = НСтр("ru = 'Данные для установки соответствий отсутствуют'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
	Иначе  	
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("УстановкиСоответствийЗавершение", ЭтаФорма);

		ПараметрыФормы = Новый Структура; 
		ПараметрыФормы.Вставить("ВидБюджета", Объект.ВидБюджетаПриемник); 		
		ПараметрыФормы.Вставить("АдресДанные", АдресДанные);
		
		ОткрытьФорму("Документ.УстановкаСоответствийМеждуВидамиБюджетов.Форма.ФормаУстановкиСоответствий", 
					 ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор,,,ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);   
	КонецЕсли;   
		
КонецПроцедуры 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьУсловноеОформление()
	
	// ВидАналитики не заполнен
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаСтатейБюджетовЗначение");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "ТаблицаСтатейБюджетов.ВидАналитики", 
								ВидСравненияКомпоновкиДанных.НеЗаполнено,,,Истина);     
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "ТаблицаСтатейБюджетов.Имя", 
								ВидСравненияКомпоновкиДанных.НеРавно,"Статья бюджета",,Истина);   
								
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",					НСтр("ru = '<Не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",			Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",				ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	// ВидАналитики заполнен, аналитики не совпадают,  но значение аналитики не заполнено
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаСтатейБюджетовЗначение");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	"ТаблицаСтатейБюджетов.ВидАналитики", 
		ВидСравненияКомпоновкиДанных.Заполнено,,,Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	"ТаблицаСтатейБюджетов.Значение", 
		ВидСравненияКомпоновкиДанных.НеЗаполнено,,,Истина);   
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	"ТаблицаСтатейБюджетов.ВидАналитикиСовпадает", 
		ВидСравненияКомпоновкиДанных.Равно,Ложь,,Истина);

	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных("ТаблицаСтатейБюджетов.ВидАналитикиНаименование"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	// ВидАналитики заполнен, аналитики совпадают,  но значение аналитики не заполнено
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаСтатейБюджетовЗначение");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	"ТаблицаСтатейБюджетов.ВидАналитики", 
		ВидСравненияКомпоновкиДанных.Заполнено,,,Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	"ТаблицаСтатейБюджетов.Значение", 
		ВидСравненияКомпоновкиДанных.НеЗаполнено,,,Истина);   
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	"ТаблицаСтатейБюджетов.ВидАналитикиСовпадает", 
		ВидСравненияКомпоновкиДанных.Равно,Истина,,Истина);

	//ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Соответствие по виду аналитики источника>'"));   
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных("ТаблицаСтатейБюджетов.ВидАналитикиНаименованиеСоответствие")); 
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	// Группы дерева только на просмотр
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ФормыУХ.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДеревоСтатейБюджетовИсточникиСтатьяБюджета");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "ДеревоСтатейБюджетовИсточники.ЭтоГруппа", 
								ВидСравненияКомпоновкиДанных.Равно,Истина,,Истина);        
								
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
							
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтатьиБюджетаЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда 
		Возврат;
	КонецЕсли;
	
	ДатаНачала = Дата(1,1,1);                 
	ДатаОкончания = Дата(1,1,1);
	
	ЗаполнитьСтатьиБюджетаНаСервере(ДатаНачала, ДатаОкончания);
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСтатьиБюджетаНаСервере(ДатаНачала, ДатаОкончания)   
	
	Объект.СтатьиБюджета.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтатьиБюджетаАналитики.СтатьяБюджета КАК СтатьяБюджета,
	|	1 КАК СостояниеСоответствия
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОперацииБюджетовОбороты.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета
	|	ИЗ
	|		РегистрНакопления.ОперацииБюджетов.Обороты(
	|				&ДатаНачала,
	|				&ДатаОкончания,
	|				Период,
	|				ВидБюджета = &ВидБюджета
	|					И НЕ АналитикаСтатейБюджетов.СтатьяБюджета.Код ЕСТЬ NULL
	|					И ВЫБОР
	|						КОГДА &ЭтоВидБюджетаБДДС
	|							ТОГДА АналитикаСтатейБюджетов.СтатьяБюджета ССЫЛКА Справочник.СтатьиДвиженияДенежныхСредств
	|						ИНАЧЕ АналитикаСтатейБюджетов.СтатьяБюджета ССЫЛКА Справочник.СтатьиДоходовИРасходов
	|					КОНЕЦ) КАК ОперацииБюджетовОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПланированиеПотребностейОбороты.АналитикаИсточника.АналитикаСтатейБюджетов.СтатьяБюджета
	|	ИЗ
	|		РегистрНакопления.ПланированиеПотребностей.Обороты(
	|				&ДатаНачала,
	|				&ДатаОкончания,
	|				Период,
	|				НЕ АналитикаИсточника.АналитикаСтатейБюджетов.СтатьяБюджета.Код ЕСТЬ NULL
	|					И ВЫБОР
	|						КОГДА &ЭтоВидБюджетаБДДС
	|							ТОГДА АналитикаИсточника.АналитикаСтатейБюджетов.СтатьяБюджета ССЫЛКА Справочник.СтатьиДвиженияДенежныхСредств
	|						ИНАЧЕ АналитикаИсточника.АналитикаСтатейБюджетов.СтатьяБюджета ССЫЛКА Справочник.СтатьиДоходовИРасходов
	|					КОНЕЦ) КАК ПланированиеПотребностейОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПланированиеПотребностейОбороты.АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета
	|	ИЗ
	|		РегистрНакопления.ПланированиеПотребностей.Обороты(
	|				&ДатаНачала,
	|				&ДатаОкончания,
	|				Период,
	|				НЕ АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета ЕСТЬ NULL
	|					И ВЫБОР
	|						КОГДА &ЭтоВидБюджетаБДДС
	|							ТОГДА АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета ССЫЛКА Справочник.СтатьиДвиженияДенежныхСредств
	|						ИНАЧЕ АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета ССЫЛКА Справочник.СтатьиДоходовИРасходов
	|					КОНЕЦ) КАК ПланированиеПотребностейОбороты) КАК СтатьиБюджетаАналитики
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатьяБюджета
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ЭтоВидБюджетаБДДС = (Объект.ВидБюджетаИсточник = БюджетДвиженияДенежныхСредств);
	Запрос.УстановитьПараметр("ЭтоВидБюджетаБДДС", 	ЭтоВидБюджетаБДДС);   	
	Запрос.УстановитьПараметр("ВидБюджета", 		Объект.ВидБюджетаИсточник);	
	Запрос.УстановитьПараметр("ДатаНачала", 		ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 		ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоваяСтрока = Объект.СтатьиБюджета.Добавить();     
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);  
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
	КонецЦикла;  
	
	ЗаполнитьДеревоСтатейБюджетовИсточники();
		
КонецПроцедуры 

&НаКлиенте
Процедура АналитикиПоУмолчаниюЗавершение(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Модифицированность = Истина;

	Для Каждого СтрокаСтатьиБюджета Из Объект.СтатьиБюджета Цикл
		
		ВидыАналитик = АналитикиСтатейБюджетовУХКлиентСерверПовтИсп.ВидыАналитикСтатьи(СтрокаСтатьиБюджета.СтатьяБюджетаПриемник);
		
		Для НомерАналитики = 1 По КоличествоАналитикСтатьи Цикл   		                      	 
			
			Если ВидыАналитик["ВидАналитики" + НомерАналитики] = РезультатЗакрытия.ВидАналитики Тогда
				
				КолонкаАналитики = "Аналитика" + НомерАналитики + "Приемник";
				Если Не ЗначениеЗаполнено(СтрокаСтатьиБюджета[КолонкаАналитики]) Тогда
					СтрокаСтатьиБюджета[КолонкаАналитики] = РезультатЗакрытия.Аналитика;	
				КонецЕсли;  
				
			КонецЕсли;  
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	ЗаполнитьТаблицуСтатейБюджетов();
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьНесопоставленныеДанные()
	
	Перем АдресДанные;
	
	ТаблицаДанные = Объект.СтатьиБюджета.Выгрузить();
	
	ПараметрыОтбора = Новый Структура("СостояниеСоответствия", 1);
	НесопоставленныеДанные = ТаблицаДанные.НайтиСтроки(ПараметрыОтбора); 
	
	Если Не НесопоставленныеДанные.Количество() = 0 Тогда
		АдресДанные = ПоместитьВоВременноеХранилище(НесопоставленныеДанные, УникальныйИдентификатор);	
	КонецЕсли;
	
	Возврат АдресДанные;   
	
КонецФункции   		

&НаКлиенте
Процедура УстановкиСоответствийЗавершение(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ОбработкаВыбораУстановкиСоответствийНаСервере(РезультатЗакрытия);	
	
КонецПроцедуры   

&НаСервере
Процедура ОбработкаВыбораУстановкиСоответствийНаСервере(Результат)
	
	УчитыватьАналитикиСтатьиБюджета = Результат.УчитыватьАналитикиСтатьиБюджета; 
	ТаблицаСоответствий = ПолучитьИзВременногоХранилища(Результат.АдресВХранилище);   
	
	КолонкиПоиска = "СтатьяБюджета"; 
	Если УчитыватьАналитикиСтатьиБюджета Тогда
		КолонкиПоиска = КолонкиПоиска + ", Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6";	
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура(КолонкиПоиска);  
	СтруктураПараметров.Вставить("СостояниеСоответствия", 1);

	Для Каждого СтрокаТаблицы Из ТаблицаСоответствий Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, СтрокаТаблицы); 
		
		ЭлементыКоллекции = Объект.СтатьиБюджета.НайтиСтроки(СтруктураПараметров);  
		
		Для Каждого Элемент Из ЭлементыКоллекции Цикл
			
			Элемент.СтатьяБюджетаПриемник = СтрокаТаблицы.СтатьяБюджетаПриемник;
			Элемент.СостояниеСоответствия = 0;
			
		КонецЦикла;   	
		
	КонецЦикла; 
	
	ЗаполнитьДеревоСтатейБюджетовИсточники();
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуСтатейБюджетов()

	ТаблицаСтатейБюджетов.Очистить();   
	
	ТекущиеДанныеИсточник = Элементы.ДеревоСтатейБюджетовИсточники.ТекущиеДанные; 
	
	Если ТекущиеДанныеИсточник = Неопределено 
		ИЛИ ТекущиеДанныеИсточник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;  
	
	НоваяСтрока = ТаблицаСтатейБюджетов.Добавить();
	НоваяСтрока.Имя = "Статья бюджета";	
	НоваяСтрока.Значение = ТекущиеДанныеИсточник.СтатьяБюджетаПриемник;
		   
	ВидыАналитикИсточник = АналитикиСтатейБюджетовУХКлиентСерверПовтИсп.ВидыАналитикСтатьи(ТекущиеДанныеИсточник.СтатьяБюджета);
	
	КоллекцияВидАналитик = Новый Массив;
	Для НомерАналитики = 1 По КоличествоАналитикСтатьи Цикл  	
		ВидАналитик = ВидыАналитикИсточник["ВидАналитики" + НомерАналитики];	
		
		Если ЗначениеЗаполнено(ВидАналитик) Тогда
			КоллекцияВидАналитик.Добавить(ВидАналитик);	
		КонецЕсли;   	
	КонецЦикла;
	
	ВидыАналитикПриемник = АналитикиСтатейБюджетовУХКлиентСерверПовтИсп.ВидыАналитикСтатьи(ТекущиеДанныеИсточник.СтатьяБюджетаПриемник);   
		
	Для НомерАналитики = 1 По КоличествоАналитикСтатьи Цикл
		
		ВидАналитики = ВидыАналитикПриемник["ВидАналитики" + НомерАналитики]; 
		
		Если Не ЗначениеЗаполнено(ВидАналитики) Тогда
			Прервать;
		КонецЕсли;
	
		НоваяСтрока = ТаблицаСтатейБюджетов.Добавить();
		НоваяСтрока.Имя = "Аналитика" + НомерАналитики;	   
		
		НоваяСтрока.ВидАналитики = ВидАналитики;
		НоваяСтрока.ВидАналитикиНаименование 	= ВидыАналитикПриемник["ВидАналитики" + НомерАналитики + "Наименование"];
		НоваяСтрока.ВидАналитикиПараметрыВыбора = ВидыАналитикПриемник["ВидАналитики" + НомерАналитики + "ПараметрыВыбора"];
		НоваяСтрока.ВидАналитикиТипЗначения     = ВидыАналитикПриемник["ВидАналитики" + НомерАналитики + "ТипЗначения"];   
		НоваяСтрока.ВидАналитикиСовпадает 		= Не (КоллекцияВидАналитик.Найти(ВидАналитики) = Неопределено);	 
		НоваяСтрока.ВидАналитикиНаименованиеСоответствие = НоваяСтрока.ВидАналитикиНаименование + "; <Соответствие по виду аналитики источника>";
				
		Если ЗначениеЗаполнено(НоваяСтрока.ВидАналитикиТипЗначения) Тогда
			ДанныеТекущегоПоля = НоваяСтрока.ВидАналитикиТипЗначения.ПривестиЗначение(ТекущиеДанныеИсточник["Аналитика" + НомерАналитики + "Приемник"]);
		Иначе             
			ДанныеТекущегоПоля = Неопределено
		КонецЕсли;
		НоваяСтрока.Значение = ДанныеТекущегоПоля;    

	КонецЦикла;   
	
КонецПроцедуры    

&НаКлиенте
Процедура ТаблицаСтатейБюджетовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаСтатейБюджетов.ТекущиеДанные; 
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Элементы.ТаблицаСтатейБюджетовЗначение.ОграничениеТипа = Новый ОписаниеТипов;
	Если ТекущиеДанные.Имя = "Статья бюджета" Тогда     	
		Элементы.ТаблицаСтатейБюджетовЗначение.ОграничениеТипа = ПолучитьОписаниеТиповСтатейБюджетов(Объект.ВидБюджетаПриемник);  
	Иначе  		
		ЗаполнитьСвойстваЭлементаАналитика();   
	КонецЕсли;    
	
КонецПроцедуры 

&НаСервереБезКонтекста 
Функция ПолучитьОписаниеТиповСтатейБюджетов(ВидБюджетаПриемник)

	Возврат ВидБюджетаПриемник.ТипЗначения;
	
КонецФункции

&НаКлиенте
Процедура ТаблицаСтатейБюджетовПриемникЗначениеПриИзменении(Элемент)
	
	ТекущиеДанныеПриемник = Элементы.ТаблицаСтатейБюджетов.ТекущиеДанные; 
	
	Если ТекущиеДанныеПриемник = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ТекущиеДанныеИсточник = Элементы.ДеревоСтатейБюджетовИсточники.ТекущиеДанные; 
	
	Если ТекущиеДанныеПриемник.Имя = "Статья бюджета" Тогда
		
		ТекущиеДанныеИсточник.СтатьяБюджетаПриемник = ТекущиеДанныеПриемник.Значение;	   
		ТекущиеДанныеИсточник.СостояниеСоответствия = Не ЗначениеЗаполнено(ТекущиеДанныеПриемник.Значение);
		
		ВидыАналитикПриемник = АналитикиСтатейБюджетовУХКлиентСерверПовтИсп.ВидыАналитикСтатьи(ТекущиеДанныеИсточник.СтатьяБюджетаПриемник);
		
		Для НомерАналитики = 1 По КоличествоАналитикСтатьи Цикл
			
			ВидАналитики = ВидыАналитикПриемник["ВидАналитики" + НомерАналитики]; 
			
			Если Не ЗначениеЗаполнено(ВидАналитики) Тогда
				Прервать;
			КонецЕсли;
			
			ДобавитьСтроку = ТаблицаСтатейБюджетов.Количество()-1 < НомерАналитики;
			НоваяСтрока 	= ?(ДобавитьСтроку, ТаблицаСтатейБюджетов.Добавить(), ТаблицаСтатейБюджетов[НомерАналитики]);   
			НоваяСтрока.Имя = "Аналитика" + НомерАналитики;	   
			
			НоваяСтрока.ВидАналитики 				= ВидАналитики;
			НоваяСтрока.ВидАналитикиНаименование 	= ВидыАналитикПриемник["ВидАналитики" + НомерАналитики + "Наименование"];
			НоваяСтрока.ВидАналитикиПараметрыВыбора = ВидыАналитикПриемник["ВидАналитики" + НомерАналитики + "ПараметрыВыбора"];
			НоваяСтрока.ВидАналитикиТипЗначения     = ВидыАналитикПриемник["ВидАналитики" + НомерАналитики + "ТипЗначения"];
			
			// Приведение значения аналитики к типу ВидаАналитики
			Если ЗначениеЗаполнено(НоваяСтрока.ВидАналитикиТипЗначения) Тогда
				ДанныеТекущегоПоля = НоваяСтрока.ВидАналитикиТипЗначения.ПривестиЗначение(НоваяСтрока.Значение);
			Иначе             
				ДанныеТекущегоПоля = Неопределено
			КонецЕсли;
			НоваяСтрока.Значение = ДанныеТекущегоПоля;    
			
			ТекущиеДанныеИсточник["Аналитика" + НомерАналитики + "Приемник"] = НоваяСтрока.Значение;
			
		КонецЦикла;  
		
	Иначе
		
		НомерАналитики = СтрЗаменить(ТекущиеДанныеПриемник.Имя, "Аналитика", "");
		ТекущиеДанныеИсточник["Аналитика" + НомерАналитики + "Приемник"] = ТекущиеДанныеПриемник.Значение;
		
	КонецЕсли; 
	
	//
	ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ТекущиеДанныеИсточник.ИдентификаторСтроки);
	МассивСтрок = Объект.СтатьиБюджета.НайтиСтроки(ПараметрыОтбора);   
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьЗначенияСвойств(МассивСтрок[0], ТекущиеДанныеИсточник);  
	
	Если ТекущиеДанныеПриемник.Имя = "Статья бюджета" Тогда
		ЗаполнитьТаблицуСтатейБюджетов(); 
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте 
Процедура ЗаполнитьСвойстваЭлементаАналитика()  
	
	ТекущиеДанные = Элементы.ТаблицаСтатейБюджетов.ТекущиеДанные; 
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	АналитикаИспользуется = ЗначениеЗаполнено(Элементы.ТаблицаСтатейБюджетов.ТекущиеДанные.ВидАналитики);
	
	СвойстваЭлементаОбщие = Новый Структура;
	
	Если АналитикаИспользуется Тогда     
		Если ТекущиеДанные.ВидАналитикиТипЗначения.Типы().Количество() = 1 Тогда
			СвойстваЭлементаОбщие.Вставить("ВыбиратьТип", Ложь);  
		Иначе
			СвойстваЭлементаОбщие.Вставить("ВыбиратьТип", Истина);
		КонецЕсли;
		СвойстваЭлементаОбщие.Вставить("ПодсказкаВвода",ТекущиеДанные.ВидАналитикиНаименование);    
		Если ТекущиеДанные.ВидАналитикиПараметрыВыбора = Неопределено Тогда
			СвойстваЭлементаОбщие.Вставить("ПараметрыВыбора", Новый ФиксированныйМассив(Новый Массив));
		Иначе
			СвойстваЭлементаОбщие.Вставить("ПараметрыВыбора", ТекущиеДанные.ВидАналитикиПараметрыВыбора);
		КонецЕсли;
	Иначе
		СвойстваЭлементаОбщие.Вставить("ВыбиратьТип", Истина);
		СвойстваЭлементаОбщие.Вставить("ПодсказкаВвода", НСтр("ru='<Не используется>'"));
		СвойстваЭлементаОбщие.Вставить("ПараметрыВыбора", Новый ФиксированныйМассив(Новый Массив));
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Элементы.ТаблицаСтатейБюджетовЗначение, СвойстваЭлементаОбщие);

КонецПроцедуры   

&НаСервере  
Процедура ЗаполнитьДеревоСтатейБюджетовИсточники(НеУстановленныеСоответствия = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатьиБюджета.СтатьяБюджета КАК СтатьяБюджета,
	|	СтатьиБюджета.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	СтатьиБюджета.СтатьяБюджетаПриемник КАК СтатьяБюджетаПриемник,
	|	СтатьиБюджета.Аналитика1Приемник КАК Аналитика1Приемник,
	|	СтатьиБюджета.Аналитика2Приемник КАК Аналитика2Приемник,
	|	СтатьиБюджета.Аналитика3Приемник КАК Аналитика3Приемник,
	|	СтатьиБюджета.Аналитика4Приемник КАК Аналитика4Приемник,
	|	СтатьиБюджета.Аналитика5Приемник КАК Аналитика5Приемник,
	|	СтатьиБюджета.Аналитика6Приемник КАК Аналитика6Приемник,
	|	СтатьиБюджета.СостояниеСоответствия КАК СостояниеСоответствия
	|ПОМЕСТИТЬ ВТ_СтатьиБюджета
	|ИЗ
	|	&СтатьиБюджета КАК СтатьиБюджета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтатьиБюджетов.Ссылка КАК СтатьяБюджета,
	|	СтатьиБюджетов.ЭтоГруппа КАК ЭтоГруппа,
	|	СтатьиБюджетов.Код КАК Код,
	|	ВЫБОР
	|		КОГДА СтатьиБюджетов.ЭтоГруппа
	|			ТОГДА ВЫБОР
	|					КОГДА СтатьиБюджетов.ПометкаУдаления
	|						ТОГДА 1
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СтатьиБюджетов.ПометкаУдаления
	|					ТОГДА 4
	|				ИНАЧЕ 3
	|			КОНЕЦ
	|	КОНЕЦ КАК ИндексКартинки,
	|	ВТ_СтатьиБюджета.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВТ_СтатьиБюджета.СтатьяБюджетаПриемник КАК СтатьяБюджетаПриемник,
	|	ВТ_СтатьиБюджета.Аналитика1Приемник КАК Аналитика1Приемник,
	|	ВТ_СтатьиБюджета.Аналитика2Приемник КАК Аналитика2Приемник,
	|	ВТ_СтатьиБюджета.Аналитика3Приемник КАК Аналитика3Приемник,
	|	ВТ_СтатьиБюджета.Аналитика4Приемник КАК Аналитика4Приемник,
	|	ВТ_СтатьиБюджета.Аналитика5Приемник КАК Аналитика5Приемник,
	|	ВТ_СтатьиБюджета.Аналитика6Приемник КАК Аналитика6Приемник,
	|	ВТ_СтатьиБюджета.СостояниеСоответствия КАК СостояниеСоответствия
	|ИЗ
	|	Справочник.СтатьиДоходовИРасходов КАК СтатьиБюджетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СтатьиБюджета КАК ВТ_СтатьиБюджета
	|		ПО СтатьиБюджетов.Ссылка = ВТ_СтатьиБюджета.СтатьяБюджета
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатьиБюджетов.Ссылка
	|ИТОГИ ПО
	|	СтатьяБюджета ТОЛЬКО ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";    
	
	Если ВидБюджета = БюджетДвиженияДенежныхСредств Тогда     		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.СтатьиДоходовИРасходов", "Справочник.СтатьиДвиженияДенежныхСредств");  
	КонецЕсли; 
	
	СтатьиБюджета = Объект.СтатьиБюджета.Выгрузить();
	Если НеУстановленныеСоответствия Тогда
		
		Сч = 0;
		Пока Сч < СтатьиБюджета.Количество() Цикл   		
			Если СтатьиБюджета[Сч].СостояниеСоответствия = 1 Тогда
				Сч = Сч +1;
			Иначе
				СтатьиБюджета.Удалить(Сч);	
			КонецЕсли; 		
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СтатьиБюджета", СтатьиБюджета);
	
	РезультатЗапроса = Запрос.Выполнить();   	
	
	ДеревоСтатейБюджетов = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);     
	
	Для Каждого ЭлементДерева Из ДеревоСтатейБюджетов.Строки Цикл
		
		Если ЗначениеЗаполнено(ЭлементДерева.СтатьяБюджета) Тогда
			Продолжить;
		КонецЕсли;    
		
		Для Каждого ЭлементПодчиненный Из ЭлементДерева.Строки Цикл
			
			НоваяСтрока = ДеревоСтатейБюджетов.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПодчиненный);
			
		КонецЦикла;   	
		
	КонецЦикла; 
	
	Сч = 0;
	Пока Сч < ДеревоСтатейБюджетов.Строки.Количество() Цикл
		Если Не ЗначениеЗаполнено(ДеревоСтатейБюджетов.Строки[Сч].СтатьяБюджета) Тогда
			ДеревоСтатейБюджетов.Строки.Удалить(ДеревоСтатейБюджетов.Строки[Сч]);		
		Иначе
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;   

	ПараметрыОтбора = Новый Структура("ЭтоГруппа", Истина);
	ЭлементыКоллекции = ДеревоСтатейБюджетов.Строки.НайтиСтроки(ПараметрыОтбора, Истина);  
	
	Для Каждого ЭлементГруппы Из ЭлементыКоллекции Цикл
		ЭлементГруппы.СостояниеСоответствия = 3;	
	КонецЦикла;  
	
	ЗначениеВРеквизитФормы(ДеревоСтатейБюджетов, "ДеревоСтатейБюджетовИсточники");   
	
КонецПроцедуры   

&НаКлиенте
Процедура ДеревоСтатейБюджетовИсточникиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если Копирование Тогда
		Отказ = Истина;	
	КонецЕсли;   
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтроку(Команда)
	
	СтатьяБюджета = ?(ВидБюджета = БюджетДвиженияДенежныхСредств, 
			ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка"), ПредопределенноеЗначение("Справочник.СтатьиДоходовИРасходов.ПустаяСсылка"));
	
	СтрокиДереваЗначений = ДеревоСтатейБюджетовИсточники.ПолучитьЭлементы(); 
	
	ИдентификаторСтроки = Новый УникальныйИдентификатор;
	
	НоваяСтрокаДерева = СтрокиДереваЗначений.Добавить();
	НоваяСтрокаДерева.СостояниеСоответствия = 1;
	НоваяСтрокаДерева.ИндексКартинки 		= 3;  
	НоваяСтрокаДерева.СтатьяБюджета 		= СтатьяБюджета;  
	НоваяСтрокаДерева.ИдентификаторСтроки   = ИдентификаторСтроки;    
	
	НоваяСтрока = Объект.СтатьиБюджета.Добавить();
	НоваяСтрока.СтатьяБюджета 			= СтатьяБюджета;
	НоваяСтрока.ИдентификаторСтроки 	= ИдентификаторСтроки;
    НоваяСтрока.СостояниеСоответствия   = 1;      
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтатейБюджетовИсточникиПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;    
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;   
	КонецЕсли;
	
	ТекущиеДанные.Код = ПолучитьКодЭлемента(ТекущиеДанные.СтатьяБюджета);    

	ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	МассивСтрок = Объект.СтатьиБюджета.НайтиСтроки(ПараметрыОтбора);   
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 

	МассивСтрок[0].СтатьяБюджета = ТекущиеДанные.СтатьяБюджета;   
	
КонецПроцедуры   

&НаСервереБезКонтекста 
Функция ПолучитьКодЭлемента(СтатьяБюджета)

	Возврат ?(ЗначениеЗаполнено(СтатьяБюджета), СтатьяБюджета.Код, "");    
	
КонецФункции

&НаКлиенте
Процедура ДеревоСтатейБюджетовИсточникиПередУдалением(Элемент, Отказ)

	ТекущиеДанные = Элемент.ТекущиеДанные;    
	
	Если ТекущиеДанные = Неопределено 
		Или ТекущиеДанные.ЭтоГруппа Тогда 
		Отказ = Истина
	Иначе
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
		МассивСтрок = Объект.СтатьиБюджета.НайтиСтроки(ПараметрыОтбора);   
		
		Если МассивСтрок.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;  
		
		ИндексСтроки = МассивСтрок[0].ПолучитьИдентификатор();
		Объект.СтатьиБюджета.Удалить(ИндексСтроки);     	
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтатейБюджетовИсточникиПриАктивизацииСтроки(Элемент)

	ЗаполнитьТаблицуСтатейБюджетов();
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповаяУстановкаСоответствий(Команда)
	
	ВыделенныеСтроки = Элементы.ДеревоСтатейБюджетовИсточники.ВыделенныеСтроки; 
	
	КоллекцияСтатей = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		ТекущаяСтрокаДерева = ДеревоСтатейБюджетовИсточники.НайтиПоИдентификатору(ВыделеннаяСтрока);     
		
		Если ТекущаяСтрокаДерева.ЭтоГруппа Тогда
			
			ВложенныеСтатьиБюджета = ТекущаяСтрокаДерева.ПолучитьЭлементы();
			ЗаполнитьСтатьиБюджетаПоДереву(ВложенныеСтатьиБюджета, КоллекцияСтатей);
			
		Иначе
			КоллекцияСтатей.Добавить(ТекущаяСтрокаДерева.СтатьяБюджета);	 
		КонецЕсли;
		
	КонецЦикла;  

	Если КоллекцияСтатей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ГрупповаяУстановкаСоответствийЗавершение", ЭтотОбъект, КоллекцияСтатей);
	
	Тип = ?(ВидБюджета = БюджетДвиженияДенежныхСредств, 
			Тип("СправочникСсылка.СтатьиДоходовИРасходов"), Тип("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));   	
	ПоказатьВводЗначения(ОписаниеОповещенияОЗавершении, , "Выберите статью бюджета", Тип);
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьСтатьиБюджетаПоДереву(СтрокиДерева, КоллекцияСтатей)
	
	Для Каждого ТекущаяСтрокаДерева Из СтрокиДерева Цикл
		
		Если ТекущаяСтрокаДерева.ЭтоГруппа Тогда
			 ВложенныеСтатьиБюджета = ТекущаяСтрокаДерева.ПолучитьЭлементы();
			 ЗаполнитьСтатьиБюджетаПоДереву(ВложенныеСтатьиБюджета, КоллекцияСтатей)
		Иначе
			КоллекцияСтатей.Добавить(ТекущаяСтрокаДерева.СтатьяБюджета);	
		КонецЕсли;
		
	КонецЦикла;  
	
КонецПроцедуры	

&НаКлиенте
Процедура ГрупповаяУстановкаСоответствийЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтатьяБюджета Из ДопПараметры Цикл
		
		ПараметрыОтбора = Новый Структура("СтатьяБюджета", ТекущаяСтатьяБюджета);
		КоллекцияСтрок = Объект.СтатьиБюджета.НайтиСтроки(ПараметрыОтбора);   
		
		Для Каждого СтрокаТабличнойЧасти Из КоллекцияСтрок Цикл
			
			СтрокаТабличнойЧасти.СтатьяБюджетаПриемник 	= Результат;	          
			СтрокаТабличнойЧасти.СостояниеСоответствия 		= 0;
			
			Для НомерАналитики = 1 По КоличествоАналитикСтатьи Цикл  
				СтрокаТабличнойЧасти["Аналитика" + НомерАналитики + "Приемник"] = Неопределено;	
			КонецЦикла; 
			
		КонецЦикла;  	
		
	КонецЦикла;
	
	ЗаполнитьДеревоСтатейБюджетовИсточники();
	
КонецПроцедуры

#КонецОбласти