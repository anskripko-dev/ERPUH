 
#Область ОписаниеПеременных

&НаКлиенте
Перем ВыполняетсяЗакрытие Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы   

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда     	
		СтатьиБюджета.ОсновнаяТаблица = "Справочник.СтатьиДвиженияДенежныхСредств"; 	
		
		ТекстЗапроса = СтрЗаменить(СтатьиБюджета.ТекстЗапроса, "Справочник.СтатьиДоходовИРасходов", "Справочник.СтатьиДвиженияДенежныхСредств");
		СтатьиБюджета.ТекстЗапроса = ТекстЗапроса;  		
	КонецЕсли;
	
	НесопоставленныеДанные = ПолучитьИзВременногоХранилища(Параметры.АдресДанные); 
	
	Для Каждого СтрокаТаблицы Из НесопоставленныеДанные Цикл
		ЗаполнитьЗначенияСвойств(СтатьиБюджетаИсточник.Добавить(), СтрокаТаблицы);	
	КонецЦикла; 
	
	ЗаполнитьСтатьиБюджетаСопоставляемые(); 
	
	УправлениеФормой();	
	
КонецПроцедуры  

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы
		И СтатьиБюджетаСопоставленные.Количество() > 0 Тогда
		
		Отказ = Истина;
		ТекстПредупреждения = НСтр("ru = 'Данные были изменены. Все изменения будут потеряны.';
									|en = 'All changes made to the data will be lost.'");  	
		Возврат;
		
	КонецЕсли;
	
	ПередЗакрытиемФормыПодбора(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент Тогда
		АдресВХранилище = АдресВХранилище(ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
	Иначе
		АдресВХранилище = Неопределено;
	КонецЕсли;
	
	Если АдресВХранилище <> Неопределено Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("АдресВХранилище", АдресВХранилище);
		Результат.Вставить("УчитыватьАналитикиСтатьиБюджета", УчитыватьАналитикиСтатьиБюджета);
		
		ОповеститьОВыборе(Результат);    
		
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ПередЗакрытиемФормыПодбора(Форма, Отказ)
	
	Если Форма.ПеренестиВДокумент ИЛИ Форма.ВыполняетсяЗакрытие Тогда
		Возврат;
	КонецЕсли;
	
	Если СтатьиБюджетаСопоставленные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина; 
	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемФормыПодбораЗавершение", ЭтотОбъект, 
							Новый Структура("Форма", Форма));
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Подобранные соответствия не перенесены в документ. Перенести?'"), 
					РежимДиалогаВопрос.ДаНетОтмена);
		
КонецПроцедуры

&НаСервере
Функция АдресВХранилище(УникальныйИдентификаторВладельца)
	
	АдресВХранилище = Неопределено;
	
	Если ПеренестиВДокумент Тогда
		
		Данные = СтатьиБюджетаСопоставленные.Выгрузить();
		АдресВХранилище = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификаторВладельца);
		
	КонецЕсли;
	
	Возврат АдресВХранилище;
	
КонецФункции

&НаКлиенте
Процедура ПередЗакрытиемФормыПодбораЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Форма.ПеренестиВДокумент = Истина;
		Форма.ВыполняетсяЗакрытие = Истина;
		Форма.Закрыть(КодВозвратаДиалога.OK);
		Форма.ВыполняетсяЗакрытие = Ложь;
		Возврат;
	КонецЕсли;
	
	Форма.ВыполняетсяЗакрытие = Истина;
	Форма.Закрыть();
	Форма.ВыполняетсяЗакрытие = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УчитыватьАналитикиСтатьиБюджетаПриИзменении(Элемент)
	
	ЗаполнитьСтатьиБюджетаСопоставляемые();
	УправлениеФормой();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтатьиБюджета

&НаКлиенте
Процедура СтатьиБюджетаПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;

КонецПроцедуры
                                     
&НаКлиенте
Процедура СтатьиБюджетаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)          
    
	Если Не ЗначениеЗаполнено(Строка) Или ЭтоГруппа(Строка) Тогда
		Возврат;
	КонецЕсли;

	Если ПараметрыПеретаскивания.Значение.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	ЗначениеИсточник = ПараметрыПеретаскивания.Значение[0].СтатьяБюджета;    
	
	НоваяСтрока = СтатьиБюджетаСопоставленные.Добавить();  	                                                      

	НоваяСтрока.СтатьяБюджета = ЗначениеИсточник; 
    НоваяСтрока.СтатьяБюджетаПриемник = Строка; 
	                                                                                                             

	ТекущийИндексСтроки = СтатьиБюджетаСопоставляемые.Индекс(ПараметрыПеретаскивания.Значение[0]);
	СтатьиБюджетаСопоставляемые.Удалить(ТекущийИндексСтроки);             

КонецПроцедуры   

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтатьиБюджетаСопоставляемые

&НаКлиенте
Процедура СтатьиБюджетаСопоставляемыеНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)

	Если ПараметрыПеретаскивания.Значение.Количество() = 0 Тогда
		ТекущееДействие = ДопустимыеДействияПеретаскивания.НеОбрабатывать;	 
	Иначе
		ТекущееДействие = ДопустимыеДействияПеретаскивания.Копирование;	
	КонецЕсли;

	ПараметрыПеретаскивания.ДопустимыеДействия = ТекущееДействие;    
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы   

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);                                        

КонецПроцедуры                                                          

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из СтатьиБюджетаСопоставляемые Цикл
		СтрокаТаблицы.Пометка = Истина;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из СтатьиБюджетаСопоставляемые Цикл
		СтрокаТаблицы.Пометка = Ложь;	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

&НаСервере
Процедура ЗаполнитьСтатьиБюджетаСопоставляемые()

	СтатьиБюджетаСопоставляемые.Очистить();
	СтатьиБюджетаСопоставленные.Очистить();
	
	Для Каждого СтрокаТаблицы Из СтатьиБюджетаИсточник Цикл
		ЗаполнитьЗначенияСвойств(СтатьиБюджетаСопоставляемые.Добавить(), СтрокаТаблицы);	
	КонецЦикла; 
	
	Если Не УчитыватьАналитикиСтатьиБюджета Тогда   
		
		ТаблицаСтатьиБюджета = СтатьиБюджетаСопоставляемые.Выгрузить(, "СтатьяБюджета");
		ТаблицаСтатьиБюджета.Свернуть("СтатьяБюджета");
		
		СтатьиБюджетаСопоставляемые.Загрузить(ТаблицаСтатьиБюджета);
		
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()   

	КоличествоАналитикСтатьи = АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи();
	
	Для НомерАналитики = 1 По КоличествоАналитикСтатьи Цикл		
		Элементы["СтатьиБюджетаСопоставляемыеАналитика" + НомерАналитики].Видимость = УчитыватьАналитикиСтатьиБюджета;
		Элементы["СтатьиБюджетаСопоставленныеАналитика" + НомерАналитики].Видимость = УчитыватьАналитикиСтатьиБюджета;   		
	КонецЦикла;
	
КонецПроцедуры   

&НаСервереБезКонтекста 
Функция ЭтоГруппа(СтатьяБюджета)
	
	Возврат СтатьяБюджета.ЭтоГруппа;
	
КонецФункции

#КонецОбласти     

#Область Инициализация

ВыполняетсяЗакрытие = Ложь;

#КонецОбласти
