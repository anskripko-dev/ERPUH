
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидАналитикиПриИзменении(Элемент)

	ВидАналитикиПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВидАналитикиПриИзмененииНаСервере()
                                                          
	ВидАналитикиТипЗначения = ВидАналитики.ТипЗначения;
	
	Если ЗначениеЗаполнено(ВидАналитикиТипЗначения) Тогда
		ДанныеТекущегоПоля = ВидАналитикиТипЗначения.ПривестиЗначение(Аналитика);
	Иначе
		ДанныеТекущегоПоля = Неопределено
	КонецЕсли;
	Аналитика = ДанныеТекущегоПоля; 
                   
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Установить(Команда)    
	
	ТекстСообщения = "";
	Если Не ЗначениеЗаполнено(ВидАналитики) Тогда
		ТекстСообщения = "Поле ""Вид аналитики"" не заполнено";		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Аналитика) Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + "Поле ""Аналитика"" не заполнено";		
	КонецЕсли;   
	
	ТекстСообщения = СокрЛП(ТекстСообщения);  	
	
	Если Не ПустаяСтрока(ТекстСообщения) Тогда    	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);  		
	Иначе
		Результат = Новый Структура;
		Результат.Вставить("ВидАналитики", ВидАналитики); 
		Результат.Вставить("Аналитика", Аналитика);
		ОповеститьОВыборе(Результат);      
	КонецЕсли;  	

КонецПроцедуры

#КонецОбласти

