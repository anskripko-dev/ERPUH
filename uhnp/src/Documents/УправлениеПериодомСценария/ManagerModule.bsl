
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("ТекущаяПериодичность");
	Поля.Добавить("Сценарий");
	Поля.Добавить("ПериодСценария");
	Поля.Добавить("ПериодСценарияОкончание");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Данные.ПериодСценария <> Данные.ПериодСценарияОкончание Тогда
		Шаблон = НСтр("ru = '%1 - %2 (Периодичность: %3) <%4>'");
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Данные.ПериодСценария, Данные.ПериодСценарияОкончание, Данные.ТекущаяПериодичность, Данные.Сценарий);
	Иначе
		Шаблон = НСтр("ru = '%1 (Периодичность: %2) <%3>'");
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Данные.ПериодСценария, Данные.ТекущаяПериодичность, Данные.Сценарий);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СтрокаПоиска") И СтрДлина(Параметры.СтрокаПоиска) > 0 Тогда 
		
		// СтрокаПоиска="21": 	все годы(месяцы, кварталы, пг) 21
		// СтрокаПоиска="я": 	все месяцы с "я" с текущего года(потом равноуделенные), потом более детальные периоды
		// СтрокаПоиска="я 21" 	все месяцы с "я" 21 года, потом более детальные периоды
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 15
			|	т.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.УправлениеПериодомСценария КАК т
			|ГДЕ
			|	т.ПериодСценарияОкончание.Наименование ПОДОБНО ""%"" + &СтрокаПоиска + ""%""
			|
			|УПОРЯДОЧИТЬ ПО
			|	т.Сценарий.Предопределенный УБЫВ,
			|	ВЫБОР
			|		КОГДА т.ПериодСценарияОкончание.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА 1
			|		КОГДА т.ПериодСценарияОкончание.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА 2
			|		КОГДА т.ПериодСценарияОкончание.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
			|			ТОГДА 3
			|		КОГДА т.ПериодСценарияОкончание.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
			|			ТОГДА 4
			|		ИНАЧЕ 10
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА &ДатаГоризонта >= т.ПериодСценарияОкончание.ДатаОкончания
			|			ТОГДА РАЗНОСТЬДАТ(т.ПериодСценарияОкончание.ДатаОкончания, &ДатаГоризонта, МЕСЯЦ)
			|		ИНАЧЕ РАЗНОСТЬДАТ(&ДатаГоризонта, т.ПериодСценарияОкончание.ДатаОкончания, МЕСЯЦ)
			|	КОНЕЦ,
			|	т.ПометкаУдаления,
			|	т.ПериодСценарияОкончание.ДатаОкончания УБЫВ");
		
		Запрос.УстановитьПараметр("ДатаГоризонта", ТекущаяДата());
		Запрос.УстановитьПараметр("СтрокаПоиска", СтрЗаменить(Параметры.СтрокаПоиска, " ", "%"));
		
		НомерЯзыка = ДополнительныеЯзыкиПовтИспУХ.НомерЯзыкаОтчетности();
		Если НомерЯзыка > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Наименование", "Наименование" + НомерЯзыка);
		КонецЕсли;
		
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриСозданииНаСервереФормыСписка(Форма) Экспорт
	
	Если ОбщегоНазначенияПовтИспУХ.ИспользуетсяМногопериоднаяОтчетность() Тогда
		
		Форма.Список.ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ДокументУправлениеПериодомСценария.Ссылка КАК Ссылка,
			|	ДокументУправлениеПериодомСценария.ПометкаУдаления КАК ПометкаУдаления,
			|	ДокументУправлениеПериодомСценария.Сценарий КАК Сценарий,
			|	ДокументУправлениеПериодомСценария.ПериодСценария КАК ПериодСценария,
			|	ДокументУправлениеПериодомСценария.ПериодСценарияОкончание КАК ПериодСценарияОкончание,
			|	ДокументУправлениеПериодомСценария.ТекущаяПериодичность КАК Периодичность,
			|	ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры КАК ВерсияОрганизационнойСтруктуры,
			|	ВЫБОР
			|		КОГДА ДокументУправлениеПериодомСценария.ПериодЗакрыт
			|				И НЕ ДокументУправлениеПериодомСценария.ПометкаУдаления
			|			ТОГДА 0
			|		КОГДА НЕ ДокументУправлениеПериодомСценария.ПериодЗакрыт
			|				И НЕ ДокументУправлениеПериодомСценария.ПометкаУдаления
			|			ТОГДА 1
			|		КОГДА ДокументУправлениеПериодомСценария.ПериодЗакрыт
			|				И ДокументУправлениеПериодомСценария.ПометкаУдаления
			|			ТОГДА 2
			|		КОГДА НЕ ДокументУправлениеПериодомСценария.ПериодЗакрыт
			|				И ДокументУправлениеПериодомСценария.ПометкаУдаления
			|			ТОГДА 3
			|	КОНЕЦ КАК ПериодЗакрыт,
			|	ВЫБОР
			|		КОГДА НЕ ВерсииОрганизационнойСтруктуры.ИспользоватьПроцесс
			|			ТОГДА -1
			|		КОГДА СостоянияПроцессаПодготовкиОтчетности.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияПроцессаПодготовкиОтчетности.Запущен)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СостояниеПроцесса
			|ИЗ
			|	Документ.УправлениеПериодомСценария КАК ДокументУправлениеПериодомСценария
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииОрганизационнойСтруктуры
			|		ПО (ВерсииОрганизационнойСтруктуры.Ссылка = ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПроцессаПодготовкиОтчетности КАК СостоянияПроцессаПодготовкиОтчетности
			|		ПО ДокументУправлениеПериодомСценария.Ссылка = СостоянияПроцессаПодготовкиОтчетности.УправлениеПериодомСценария";
		
	Иначе
		
		Форма.Элементы.СостояниеПроцесса.Видимость = Ложь;
		Форма.Элементы.ПериодСценарияОкончание.Видимость = Ложь;
		Форма.Элементы.Периодичность.Видимость = Ложь;
		
	КонецЕсли

КонецПроцедуры

#КонецОбласти

#КонецЕсли

