Функция ТекстЗапроса_втОстаткиЗадолженности(НомераТаблиц)
	
	НомераТаблиц.Вставить("втОстаткиЗадолженности", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерОстатка,
	|	ВЫБОР
	|		КОГДА т.Счет.Валютный
	|			ТОГДА т.СуммаВВалютеОстаток
	|		ИНАЧЕ т.СуммаВВалютеУчетаОстаток
	|	КОНЕЦ КАК ОстатокЗадолженностиВВалюте,
	|	ВЫБОР втСчета.НомерСубконтоКонтрагент
	|		КОГДА 3
	|			ТОГДА т.Субконто3
	|		КОГДА 2
	|			ТОГДА т.Субконто2
	|		КОГДА 1
	|			ТОГДА т.Субконто1
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР втСчета.НомерСубконтоДоговор
	|		КОГДА 3
	|			ТОГДА т.Субконто3
	|		КОГДА 2
	|			ТОГДА т.Субконто2
	|		КОГДА 1
	|			ТОГДА т.Субконто1
	|	КОНЕЦ КАК Договор,
	|	ВЫБОР втСчета.НомерСубконтоДокументРасчетов
	|		КОГДА 3
	|			ТОГДА т.Субконто3
	|		КОГДА 2
	|			ТОГДА т.Субконто2
	|		КОГДА 1
	|			ТОГДА т.Субконто1
	|	КОНЕЦ КАК ДокументРасчетов,
	|	т.Счет КАК Счет,
	|	втСчета.СчетЗадолженностиБД КАК СчетЗадолженностиБД,
	|	ЕСТЬNULL(т.Подразделение, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Подразделение,
	|	ЕСТЬNULL(т.НаправлениеДеятельности, ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Валюта КАК Валюта,
	|	т.СуммаВВалютеУчетаОстаток КАК ОстатокЗадолженности,
	|	ВЫБОР
	|		КОГДА т.Счет.Валютный
	|			ТОГДА т.СуммаВВалютеОстаток
	|		ИНАЧЕ т.СуммаВВалютеУчетаОстаток
	|	КОНЕЦ КАК ОстатокЗадолженностиВалюте
	|ПОМЕСТИТЬ втОстаткиЗадолженности
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(
	|			&КонецПериодаГраница,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.СчетЗадолженностиСчетСсылка
	|				ИЗ
	|					втСчета КАК т),
	|			,
	|			Сценарий = &Сценарий
	|				И Организация = &Организация
	|				И ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ОперацииДляЦелейОтчетности)) КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.Счет = втСчета.СчетЗадолженностиСчетСсылка
	|ГДЕ
	|	ВЫБОР
	|			КОГДА т.Счет.Валютный
	|				ТОГДА т.СуммаВВалютеОстаток
	|			ИНАЧЕ т.СуммаВВалютеУчетаОстаток
	|		КОНЕЦ > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументРасчетов,
	|	Договор";
	
	ТекстЗамена = МСФОВстраиваниеУХВызовСервера.ТекстЗапроса_УсловиеДоговораНеПрочее("Субконто2");
	Возврат СтрЗаменить(ТекстЗапроса, "&ТекстУсловия_ДоговорНеПрочее", ТекстЗамена);
	
КонецФункции

Функция ТекстЗапроса_втОстаткиДляПартий(НомераТаблиц)
	
	НомераТаблиц.Вставить("втОстаткиДляПартий", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.НомерОстатка КАК НомерОстатка,
	|	т.Договор КАК Договор,
	|	т.Счет КАК СчетВзаиморасчетов,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	т.ОстатокЗадолженностиВалюте КАК ОстатокЗадолженностиВалюте
	|ПОМЕСТИТЬ втОстаткиДляПартий
	|ИЗ
	|	втОстаткиЗадолженности КАК т
	|ГДЕ
	|	т.ДокументРасчетов ЕСТЬ NULL
	|	И НЕ т.Договор ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Счет,
	|	Подразделение,
	|	НаправлениеДеятельности";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_втРегистраторыПоДоговору(НомераТаблиц)

	НомераТаблиц.Вставить("втРегистраторыПоДоговору", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	т.Регистратор КАК Регистратор,
	|	т.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ втДокументыПоДоговору
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Субконто КАК т
	|ГДЕ
	|	т.Значение В
	|			(ВЫБРАТЬ
	|				втОстаткиДляПартий.Договор
	|			ИЗ
	|				втОстаткиДляПартий КАК втОстаткиДляПартий
	|			ГДЕ
	|				НЕ втОстаткиДляПартий.Договор В (ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка), НЕОПРЕДЕЛЕНО))
	|	И т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Дебет)
	|	И т.Вид В
	|			(ВЫБРАТЬ
	|				втВидыСубконтоДоговоры.Ссылка
	|			ИЗ
	|				втВидыСубконтоДоговоры КАК втВидыСубконтоДоговоры)
	|	И т.Период <= &КонецПериода
	|	И т.Регистратор <> &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	НомерСтроки";

КонецФункции

Функция ТекстЗапроса_втПартииВзаиморасчетов(НомераТаблиц)

	НомераТаблиц.Вставить("втПартииВзаиморасчетов", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерПартии,
	|	СУММА(ВЫБОР
	|			КОГДА т.СчетДт.Валютный
	|				ТОГДА т.СуммаВВалютеДт
	|			ИНАЧЕ т.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаВВалюте,
	|	НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ) КАК Период,
	|	МАКСИМУМ(т.Регистратор) КАК Регистратор,
	|	ВЫБОР втСчета.НомерСубконтоДоговор
	|		КОГДА 3
	|			ТОГДА т.СубконтоДт3
	|		КОГДА 2
	|			ТОГДА т.СубконтоДт2
	|		КОГДА 1
	|			ТОГДА т.СубконтоДт1
	|	КОНЕЦ КАК Договор,
	|	т.СчетДт КАК СчетВзаиморасчетов,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА втСчета.ЧислоОстаточныхСубконто >= 1
	|				ТОГДА т.СубконтоДт1
	|		КОНЕЦ, НЕОПРЕДЕЛЕНО) КАК Субконто1,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА втСчета.ЧислоОстаточныхСубконто >= 2
	|				ТОГДА т.СубконтоДт2
	|		КОНЕЦ, НЕОПРЕДЕЛЕНО) КАК Субконто2,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА втСчета.ЧислоОстаточныхСубконто >= 3
	|				ТОГДА т.СубконтоДт3
	|		КОНЕЦ, НЕОПРЕДЕЛЕНО) КАК Субконто3,
	|	ЕСТЬNULL(т.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Подразделение,
	|	ЕСТЬNULL(т.НаправлениеДеятельностиДт, ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втПартииВзаиморасчетов
	|ИЗ
	|	РегистрБухгалтерии.МСФО.ДвиженияССубконто(
	|			,
	|			&КонецПериода,
	|			(Регистратор, НомерСтроки) В
	|					(ВЫБРАТЬ
	|						втДокументыПоДоговору.Регистратор,
	|						втДокументыПоДоговору.НомерСтроки
	|					ИЗ
	|						втДокументыПоДоговору КАК втДокументыПоДоговору)
	|				И Активность
	|				И Организация = &Организация
	|				И Сценарий = &Сценарий,
	|			,
	|			) КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.СчетДт = втСчета.СчетЗадолженностиСчетСсылка
	|			И (втСчета.НомерСубконтоДоговор > 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ),
	|	т.СчетДт,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА втСчета.ЧислоОстаточныхСубконто >= 1
	|				ТОГДА т.СубконтоДт1
	|		КОНЕЦ, НЕОПРЕДЕЛЕНО),
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА втСчета.ЧислоОстаточныхСубконто >= 2
	|				ТОГДА т.СубконтоДт2
	|		КОНЕЦ, НЕОПРЕДЕЛЕНО),
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА втСчета.ЧислоОстаточныхСубконто >= 3
	|				ТОГДА т.СубконтоДт3
	|		КОНЕЦ, НЕОПРЕДЕЛЕНО),
	|	т.ПодразделениеДт,
	|	т.НаправлениеДеятельностиДт,
	|	ВЫБОР втСчета.НомерСубконтоДоговор
	|		КОГДА 3
	|			ТОГДА т.СубконтоДт3
	|		КОГДА 2
	|			ТОГДА т.СубконтоДт2
	|		КОГДА 1
	|			ТОГДА т.СубконтоДт1
	|	КОНЕЦ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	СчетВзаиморасчетов,
	|	НаправлениеДеятельности,
	|	Подразделение,
	|	Период,
	|	Субконто1,
	|	Субконто2,
	|	Субконто3";

КонецФункции

Функция ТекстЗапроса_втОстаткиПоПартиям(НомераТаблиц)
	
	//Для втОстаткиДляПартий(Догор1=100)
	//из документов получения долга:
	//10.01=75
	//20.01=64
	//30.01=53
	//будет распределено:
	//20.01=47(=МИНИМУМ(64,100-53))
	//30.01=53
	
	НомераТаблиц.Вставить("втОстаткиПоПартиям", НомераТаблиц.Количество());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	втОстаткиДляПартий.НомерОстатка КАК НомерОстатка,
	|	втОстаткиДляПартий.Договор КАК Договор,
	|	втОстаткиДляПартий.СчетВзаиморасчетов КАК СчетВзаиморасчетов,
	|	втОстаткиДляПартий.Подразделение КАК Подразделение,
	|	втОстаткиДляПартий.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	МАКСИМУМ(втОстаткиДляПартий.ОстатокЗадолженностиВалюте) КАК ОстатокЗадолженностиВалюте,
	|	втПартииВзаиморасчетов.Период КАК ДатаДокументаРасчета,
	|	МАКСИМУМ(втПартииВзаиморасчетов.Регистратор) КАК Регистратор,
	|	ЕстьNULL(ЕстьNULL(МАКСИМУМ(ДокументТК.ИсходныйДокумент), МАКСИМУМ(ДокументТрансляция.ИсходныйДокумент)), МАКСИМУМ(втПартииВзаиморасчетов.Регистратор)) КАК ИсходныйДокументНСБУ,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(втОстаткиДляПартий.ОстатокЗадолженностиВалюте) < СУММА(втПартииВзаиморасчетовПредыдущие.СуммаВВалюте) + МАКСИМУМ(втПартииВзаиморасчетов.СуммаВВалюте)
	|			ТОГДА МАКСИМУМ(втОстаткиДляПартий.ОстатокЗадолженностиВалюте) - СУММА(втПартииВзаиморасчетовПредыдущие.СуммаВВалюте)
	|		ИНАЧЕ МАКСИМУМ(втПартииВзаиморасчетов.СуммаВВалюте)
	|	КОНЕЦ КАК СуммаВВалютеПоПартии
	|ПОМЕСТИТЬ втОстаткиПоПартиям
	|ИЗ
	|	втОстаткиДляПартий КАК втОстаткиДляПартий
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПартииВзаиморасчетов КАК втПартииВзаиморасчетов
	|			ЛЕВОЕ СОЕДИНЕНИЕ втПартииВзаиморасчетов КАК втПартииВзаиморасчетовПредыдущие
	|			ПО втПартииВзаиморасчетов.Договор = втПартииВзаиморасчетовПредыдущие.Договор
	|				И втПартииВзаиморасчетов.СчетВзаиморасчетов = втПартииВзаиморасчетовПредыдущие.СчетВзаиморасчетов
	|				И втПартииВзаиморасчетов.Подразделение = втПартииВзаиморасчетовПредыдущие.Подразделение
	|				И втПартииВзаиморасчетов.НаправлениеДеятельности = втПартииВзаиморасчетовПредыдущие.НаправлениеДеятельности
	|				И втПартииВзаиморасчетов.Период < втПартииВзаиморасчетовПредыдущие.Период
	|				И втПартииВзаиморасчетов.Субконто1 = втПартииВзаиморасчетовПредыдущие.Субконто1
	|				И втПартииВзаиморасчетов.Субконто2 = втПартииВзаиморасчетовПредыдущие.Субконто2
	|				И втПартииВзаиморасчетов.Субконто3 = втПартииВзаиморасчетовПредыдущие.Субконто3
	|		ПО втОстаткиДляПартий.Договор = втПартииВзаиморасчетов.Договор
	|			И втОстаткиДляПартий.СчетВзаиморасчетов = втПартииВзаиморасчетов.СчетВзаиморасчетов
	|			И втОстаткиДляПартий.Подразделение = втПартииВзаиморасчетов.Подразделение
	|			И втОстаткиДляПартий.НаправлениеДеятельности = втПартииВзаиморасчетов.НаправлениеДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Трансляция КАК ДокументТрансляция
	|		ПО (втПартииВзаиморасчетов.Регистратор = ДокументТрансляция.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТрансформационнаяКорректировка КАК ДокументТК
	|		ПО (втПартииВзаиморасчетов.Регистратор = ДокументТК.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	втОстаткиДляПартий.НаправлениеДеятельности,
	|	втОстаткиДляПартий.Подразделение,
	|	втОстаткиДляПартий.Договор,
	|	втОстаткиДляПартий.СчетВзаиморасчетов,
	|	втПартииВзаиморасчетов.Период,
	|	втОстаткиДляПартий.НомерОстатка
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(втОстаткиДляПартий.ОстатокЗадолженностиВалюте) > ЕСТЬNULL(СУММА(втПартииВзаиморасчетовПредыдущие.СуммаВВалюте), 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерОстатка,
	|	ИсходныйДокументНСБУ";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_втДокументыНСБУ(НомераТаблиц)

	НомераТаблиц.Вставить("втДанныеНСБУ", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.ДокументРасчетов КАК ДокументРасчетов
	|ПОМЕСТИТЬ втДокументыНСБУ
	|ИЗ
	|	втОстаткиЗадолженности КАК т
	|ГДЕ
	|	ЕСТЬNULL(т.ДокументРасчетов, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.ИсходныйДокументНСБУ
	|ИЗ
	|	втОстаткиПоПартиям КАК т
	|ГДЕ
	|	ЕСТЬNULL(т.ИсходныйДокументНСБУ, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументРасчетов";

КонецФункции

#Область ДанныеНСБУ

Процедура ДобавитьТекстыЗапроса_втДанныеНСБУ(ТекстЗапроса, НомераТаблиц)

	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		
		ТекстЗапроса.Добавить(ТекстЗапроса_втКлючиАналитикиУчетаПоПартнерамЕРП(НомераТаблиц));
		ТекстЗапроса.Добавить(ТекстЗапроса_втДанныеЕРП(НомераТаблиц));
		
	ИначеЕсли УчетМСФОПовтИспУХ.ЕстьРСБУ() Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_втДанныеБП(НомераТаблиц));
	Иначе //ПФ
		ТекстЗапроса.Добавить(ТекстЗапроса_втДанныеПФ(НомераТаблиц));
	КонецЕсли;

КонецПроцедуры

Функция ТекстЗапроса_втДанныеБП(НомераТаблиц)
	
	НомераТаблиц.Вставить("втДанныеНСБУ", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Документ КАК ДокументРасчетов,
	|	т.Дата КАК ДатаДокументаРасчета,
	|	СрокиОплатыДокументов.СрокОплаты КАК ДатаПогашенияПоДокументуНСБУ
	|ПОМЕСТИТЬ втДанныеНСБУ
	|ИЗ
	|	РегистрСведений.ДанныеПервичныхДокументов КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиОплатыДокументов КАК СрокиОплатыДокументов
	|		ПО т.Документ = СрокиОплатыДокументов.Документ
	|			И (СрокиОплатыДокументов.Организация = &Организация)
	|ГДЕ
	|	т.Организация = &Организация
	|	И т.Документ В
	|			(ВЫБРАТЬ
	|				втДокументыНСБУ.ДокументРасчетов
	|			ИЗ
	|				втДокументыНСБУ КАК втДокументыНСБУ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументРасчетов";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_втДанныеПФ(НомераТаблиц)
	
	НомераТаблиц.Вставить("втДанныеНСБУ", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.ДокументРасчетов КАК ДокументРасчетов,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаДокументаРасчета,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПогашенияПоДокументуНСБУ
	|ПОМЕСТИТЬ втДанныеНСБУ
	|ИЗ
	|	втОстаткиЗадолженности КАК т
	|ГДЕ
	|	ЛОЖЬ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументРасчетов";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_втКлючиАналитикиУчетаПоПартнерамЕРП(НомераТаблиц)
	
	НомераТаблиц.Вставить("втКлючиАналитикиУчетаПоПартнерам", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Ссылка КАК КлючАналитики,
	|	т.Контрагент КАК Контрагент,
	|	т.Договор КАК Договор
	|ПОМЕСТИТЬ втКлючиАналитикиУчетаПоПартнерам
	|ИЗ
	|	Справочник_КлючиАналитикиУчетаПоПартнерам КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОстаткиЗадолженности КАК втОстаткиЗадолженности
	|		ПО (т.Организация = &Организация)
	|			И т.Контрагент = втОстаткиЗадолженности.Контрагент
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАналитики";
	
	Возврат СтрЗаменить(ТекстЗапроса,
		"Справочник_КлючиАналитикиУчетаПоПартнерам",
		"Справочник.КлючиАналитикиУчетаПоПартнерам");
	
КонецФункции

Функция ТекстЗапроса_втДанныеЕРП(НомераТаблиц)
	
	НомераТаблиц.Вставить("втДанныеНСБУ", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.ДатаВозникновения КАК ДатаДокументаРасчета,
	|	т.ДатаПлановогоПогашения КАК ДатаПогашенияПоДокументуНСБУ,
	|	т.РасчетныйДокумент КАК ДокументРасчетов,
	|	Ключи.Договор КАК Договор,
	|	Ключи.Контрагент КАК Контрагент,
	|	т.ОбъектРасчетов КАК ОбъектРасчетов,
	|	т.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	т.ДолгОстаток КАК ДолгОстаток
	|ПОМЕСТИТЬ втДанныеНСБУ
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
	|			&КонецПериодаГраница,
	|			АналитикаУчетаПоПартнерам В
	|				(ВЫБРАТЬ
	|					Ключи.КлючАналитики
	|				ИЗ
	|					втКлючиАналитикиУчетаПоПартнерам КАК Ключи) 
	|			И НЕ ОбъектРасчетов = НЕОПРЕДЕЛЕНО
	|			И НЕ ДатаПлановогоПогашения = ДАТАВРЕМЯ(1, 1, 1)) КАК т
	|	ЛЕВОЕ СОЕДИНЕНИЕ втКлючиАналитикиУчетаПоПартнерам КАК Ключи
	|	ПО т.АналитикаУчетаПоПартнерам = Ключи.КлючАналитики
	|ГДЕ 
	|	т.ДолгРеглОстаток > 0
	|ИНДЕКСИРОВАТЬ ПО
	|	РасчетныйДокумент,
	|	Контрагент,
	|	Договор";
	
	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

Функция ТекстЗапроса_Резервы(НомераТаблиц)
	
	НомераТаблиц.Вставить("Резервы", НомераТаблиц.Количество());

	Возврат 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(втДанныеНСБУ.ДатаДокументаРасчета, ЕСТЬNULL(втОстаткиПоПартиям.ДатаДокументаРасчета, т.ДокументРасчетов.Дата)) КАК ДатаДокументаРасчета,
	|	ЕСТЬNULL(втДанныеНСБУ.ДатаПогашенияПоДокументуНСБУ, ЕСТЬNULL(втДанныеПоПартии.ДатаПогашенияПоДокументуНСБУ, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаПогашенияПоДокументуНСБУ,
	|	т.НомерОстатка КАК НомерОстатка,
	|	ЕСТЬNULL(втОстаткиПоПартиям.СуммаВВалютеПоПартии, т.ОстатокЗадолженностиВВалюте) КАК ОстатокЗадолженностиВВалютеМСФО,
	|	втОстаткиПоПартиям.ИсходныйДокументНСБУ КАК ДокументРасчета,
	|	т.СчетЗадолженностиБД КАК СчетЗадолженностиМСФО,
	|	т.Валюта КАК Валюта,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	втОстаткиЗадолженности КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеНСБУ КАК втДанныеНСБУ
	|		ПО т.ДокументРасчетов = втДанныеНСБУ.ДокументРасчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстаткиПоПартиям КАК втОстаткиПоПартиям
	|			ЛЕВОЕ СОЕДИНЕНИЕ втДанныеНСБУ КАК втДанныеПоПартии
	|			ПО втОстаткиПоПартиям.ИсходныйДокументНСБУ = втДанныеПоПартии.ДокументРасчетов
	|		ПО т.НомерОстатка = втОстаткиПоПартиям.НомерОстатка
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетЗадолженностиМСФО,
	|	Субконто1,
	|	Субконто2,
	|	Субконто3,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	ДатаДокументаРасчета";

КонецФункции

#КонецОбласти

#Область Движения

Процедура СформироватьДвижения(Движения, ДополнительныеСвойства, Отказ) Экспорт

	Реквизиты 		= ДополнительныеСвойства.ДляПроведения.Реквизиты;
	ТаблицаПроводок = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПроводок;
	
	ТаблицаПроводок.Колонки.Добавить("Организация");
	ТаблицаПроводок.Колонки.Добавить("Сценарий");
	ТаблицаПроводок.Колонки.Добавить("ПериодОтчета");
	
	КэшКурсов = Новый Соответствие;

	Для каждого Движение Из ТаблицаПроводок Цикл
		
		ЗаполнитьЗначенияСвойств(Движение, Реквизиты, "Организация,Сценарий,ПериодОтчета");
		
		Если НЕ ЗначениеЗаполнено(Движение.Валюта) Или Реквизиты.ФункциональнаяВалюта = Движение.Валюта Тогда 
			
			Движение.СуммаВФункциональнойВалюте = Движение.СуммаВВалюте;
			
		Иначе
			
			КурсОВ = РаботаСКурсамиВалютУХ.ПолучитьКурсВалюты(Движение.Валюта, Движение.Период); 
			КурсФВ = РаботаСКурсамиВалютУХ.ПолучитьКурсВалюты(Реквизиты.ФункциональнаяВалюта, Движение.Период);
			Движение.СуммаВФункциональнойВалюте = РаботаСКурсамиВалютКлиентСерверУХ.ПересчитатьИзВалютыВВалюту(
					Движение.СуммаВВалюте, 
					Движение.Валюта,
					Реквизиты.ФункциональнаяВалюта,
					КурсОВ.Курс,
					КурсФВ.Курс,
					КурсОВ.Кратность,
					КурсФВ.Кратность
				);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Если Реквизиты.ФормироватьПроводкиМСФО Тогда
		
		МСФОВызовСервераУХ.ОтразитьДвиженияПоТаблицеПроводок(Движения, ТаблицаПроводок, Реквизиты, Отказ, Ложь);
		
	Иначе
		
		МСФОВызовСервераУХ.ПроверитьЗаполненностьПроводок(ТаблицаПроводок, Реквизиты, Отказ);
		
		ТаблицаПроводок.Индексы.Добавить("СторноСледующегоПериодаТК");
		
		Отбор = Новый Структура("СторноСледующегоПериодаТК", Истина);
		МСФОВызовСервераУХ.ОтразитьДвиженияРасчетов(Движения, ТаблицаПроводок.Скопировать(Отбор));
		
		Отбор = Новый Структура("СторноСледующегоПериодаТК", Ложь);
		ТаблицаПроводок.Колонки.Событие.Имя = "Комментарий";
		ТаблицаПроводок.Колонки.СуммаВФункциональнойВалюте.Имя = "Значение";
		
		МодульТК = ОбщегоНазначения.ОбщийМодуль("ТрансформационныеКорректировкиУХ");
		МодульТК.СформироватьКорректировку(Реквизиты, Отказ, ТаблицаПроводок.Скопировать(Отбор));
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
