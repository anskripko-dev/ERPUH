Функция ТекстЗапроса_СписаниеСтоимости()

	Возврат
	"ВЫБРАТЬ
	|	втСобытия.ФинансовыйИнструмент КАК ФинансовыйИнструмент,
	|	втСобытия.Дата КАК Период,
	|	втСобытия.Количество КАК Количество,
	|	втОстатки.Валюта КАК ВалютаДт,
	|	втОстатки.Валюта КАК ВалютаКт,
	|	втОстатки.СписаниеВВалюте - втОстатки.СписаниеНКД_ВВалюте КАК ВалютнаяСуммаДт,
	|	втОстатки.СписаниеВВалюте - втОстатки.СписаниеНКД_ВВалюте КАК ВалютнаяСуммаКт,
	|	втОстатки.СписаниеБУ - втОстатки.СписаниеНКД_БУ КАК Сумма,
	|	втОстатки.СписаниеНУ - втОстатки.СписаниеНКД_НУ КАК СуммаНУДт,
	|	втОстатки.СписаниеНУ - втОстатки.СписаниеНКД_НУ КАК СуммаНУКт,
	|	втОстатки.СписаниеПР - втОстатки.СписаниеНКД_ПР КАК СуммаПРДт,
	|	втОстатки.СписаниеПР - втОстатки.СписаниеНКД_ПР КАК СуммаПРКт,
	|	втОстатки.СписаниеВР - втОстатки.СписаниеНКД_ВР КАК СуммаВРДт,
	|	втОстатки.СписаниеВР - втОстатки.СписаниеНКД_ВР КАК СуммаВРКт,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетРасходовОтВыбытия) КАК СчетДт,
	|	ВЫБОР
	|		КОГДА втСобытия.ФинансовыйИнструмент.СрокПогашения <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДОБАВИТЬКДАТЕ(&Период, ГОД, 1) <= втСобытия.ФинансовыйИнструмент.СрокПогашения
	|				И ИСТИНА В
	|					(ВЫБРАТЬ
	|						ИСТИНА
	|					ИЗ
	|						втСчетаДокумента КАК втСчетаДокумента
	|					ГДЕ
	|						втСчетаДокумента.ВидСчетаФИ = ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФиДолгосрочный))
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФиДолгосрочный)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетУчетаФИ)
	|	КОНЕЦ КАК СчетКт,
	|	""Списание с учета стоимости ценной бумаги"" КАК Комментарий
	|ПОМЕСТИТЬ втТаблицаПроводок
	|ИЗ
	|	втОстатки КАК втОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСобытия КАК втСобытия
	|		ПО втОстатки.ФинансовыйИнструмент = втСобытия.ФинансовыйИнструмент
	|			И (втОстатки.Подразделение В (втСобытия.Подразделение, НЕОПРЕДЕЛЕНО))";

КонецФункции

Функция ТекстЗапроса_ДоходОтПродажи()

	Возврат
	"ВЫБРАТЬ
	|	втСобытия.ФинансовыйИнструмент КАК ФинансовыйИнструмент,
	|	втСобытия.Дата КАК Период,
	|	втСобытия.Количество КАК Количество,
	|	втСобытия.Валюта КАК ВалютаДт,
	|	втСобытия.Валюта КАК ВалютаКт,
	|	втСобытия.Сумма КАК ВалютнаяСуммаДт,
	|	втСобытия.Сумма КАК ВалютнаяСуммаКт,
	|	ВЫРАЗИТЬ(втСобытия.Сумма * втСобытия.КроссКурсРеглИзРасчетов КАК ЧИСЛО(18, 2)) КАК Сумма,
	|	ВЫРАЗИТЬ(втСобытия.Сумма * втСобытия.КроссКурсРеглИзРасчетов КАК ЧИСЛО(18, 2)) КАК СуммаНУДт,
	|	ВЫРАЗИТЬ(втСобытия.Сумма * втСобытия.КроссКурсРеглИзРасчетов КАК ЧИСЛО(18, 2)) КАК СуммаНУКт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРДт,
	|	0 КАК СуммаВРКт,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетВзаиморасчетов) КАК СчетДт,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетДоходовОтВыбытия) КАК СчетКт,
	|	""Доход от продажи ценной бумаги"" КАК Комментарий
	|ИЗ
	|	втСобытия КАК втСобытия";

КонецФункции

Функция ТекстЗапроса_НачислениеНКД()

	Возврат
	"ВЫБРАТЬ
	|	втСобытия.ФинансовыйИнструмент КАК ФинансовыйИнструмент,
	|	втСобытия.Дата КАК Период,
	|	втСобытия.Количество КАК Количество,
	|	втСобытия.Валюта КАК ВалютаДт,
	|	втСобытия.Валюта КАК ВалютаКт,
	|	втСобытия.НКД КАК ВалютнаяСуммаДт,
	|	втСобытия.НКД КАК ВалютнаяСуммаКт,
	|	ВЫРАЗИТЬ(втСобытия.НКД * втСобытия.КроссКурсРеглИзРасчетов КАК ЧИСЛО(18, 2)) КАК Сумма,
	|	ВЫРАЗИТЬ(втСобытия.НКД * втСобытия.КроссКурсРеглИзРасчетов КАК ЧИСЛО(18, 2)) КАК СуммаНУДт,
	|	ВЫРАЗИТЬ(втСобытия.НКД * втСобытия.КроссКурсРеглИзРасчетов КАК ЧИСЛО(18, 2)) КАК СуммаНУКт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРДт,
	|	0 КАК СуммаВРКт,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетНКД) КАК СчетДт,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетНачисленияКупонов) КАК СчетКт,
	|	""Доначислен НКД за период владения облигацией"" КАК Комментарий
	|ИЗ
	|	втСобытия КАК втСобытия";

КонецФункции

Функция ТекстЗапроса_СписаниеНКДПоУчету()

	Возврат
	"ВЫБРАТЬ
	|	втОстатки.ФинансовыйИнструмент, 
	|	втОстатки.Дата КАК Период,
	|	0 КАК Количество,
	|	втОстатки.Валюта КАК ВалютаДт,
	|	втОстатки.Валюта КАК ВалютаКт,
	|	втОстатки.СписаниеНКД_ВВалюте КАК ВалютнаяСуммаДт,
	|	втОстатки.СписаниеНКД_ВВалюте КАК ВалютнаяСуммаКт,
	|	втОстатки.СписаниеНКД_БУ КАК Сумма,
	|	втОстатки.СписаниеНКД_НУ КАК СуммаНУДт,
	|	втОстатки.СписаниеНКД_НУ КАК СуммаНУКт,
	|	втОстатки.СписаниеНКД_ПР КАК СуммаПРДт,
	|	втОстатки.СписаниеНКД_ПР КАК СуммаПРКт,
	|	втОстатки.СписаниеНКД_ВР КАК СуммаВРДт,
	|	втОстатки.СписаниеНКД_ВР КАК СуммаВРКт,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетВзаиморасчетов) КАК СчетДт,
	|	ЗНАЧЕНИЕ(Справочник.ВидыСчетовФИ.СчетНКД) КАК СчетКт,
	|	""Списание НКД при выбытии ценной бумаги"" КАК Комментарий
	|ИЗ
	|	втОстатки КАК втОстатки  
	|ГДЕ
	|	втОстатки.СписаниеНКД_БУ <> 0";

КонецФункции

