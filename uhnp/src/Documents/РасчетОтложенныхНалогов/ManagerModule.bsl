											ОтборВерсий, 
											ОтборПоказателей, 
											Неопределено,
											ПоляВыборки, 
											ДополнительныеПараметры);

	ТабИсточник = Запрос.Выполнить().Выгрузить();
	
	отЧисло = Метаданные.ОпределяемыеТипы.ДенежнаяСуммаЛюбогоЗнака.Тип;
	
	ТабИсточник.Колонки.Добавить("ОстатокНСБУ", отЧисло);
