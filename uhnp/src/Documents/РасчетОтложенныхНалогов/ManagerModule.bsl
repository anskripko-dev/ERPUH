
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#КонецОбласти

#Область ПодготовкаПараметровПроведенияДокумента

Функция ПодготовитьПараметрыПроведения(ДополнительныеСвойства, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	ДопРеквизиты = "ПериодОтчета, ДатаНачала, ДатаОкончания, РегламентированнаяОрганизация, ВидОтчета";
	Реквизиты = МСФОУХ.РеквизитыДокумента(Запрос, ДопРеквизиты, "ПериодОтчета", Отказ);
	Реквизиты.Вставить("Период",					КонецДня(Реквизиты.ПериодОтчета.ДатаОкончания));
	Реквизиты.Вставить("ДатаНачалаСледующегоПериода", НачалоДня(ОбщегоНазначенияУХ.ДобавитьДень(Реквизиты.Период, 1)));

	ДополнительныеСвойства.ДляПроведения.Вставить("Реквизиты", Реквизиты);

	Если Отказ Тогда
		Возврат ДополнительныеСвойства;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОНА",	НСтр("ru = 'Отложенный налоговый актив'"));
	Запрос.УстановитьПараметр("ОНО",	НСтр("ru = 'Отложенное налоговое обязательство'"));
	Запрос.УстановитьПараметр("ПНА",	НСтр("ru = 'Постоянный налоговый актив'"));
	Запрос.УстановитьПараметр("ПНО",	НСтр("ru = 'Постоянное налоговое обязательство'"));
	
	Запрос.УстановитьПараметр("Организация",	Реквизиты.Организация);
	Запрос.УстановитьПараметр("Сценарий",		Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("ДатаНачала",		Реквизиты.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	КонецДня(Реквизиты.ДатаОкончания));
	Запрос.УстановитьПараметр("РегламентированнаяОрганизация", Реквизиты.РегламентированнаяОрганизация);
	
	НомераТаблиц = Новый Структура;
	
	ШаблонЗапроса = Новый Массив;
	ШаблонЗапроса.Добавить(ТекстЗапроса_втТаблицаРасчета(НомераТаблиц));
	ШаблонЗапроса.Добавить(ТекстЗапроса_втСчетаРазниц(НомераТаблиц));
	ШаблонЗапроса.Добавить(ТекстЗапроса_втТаблицаПроводки(НомераТаблиц));
	ШаблонЗапроса.Добавить(ТекстЗапроса_втТаблицаПроводкиСторно(НомераТаблиц));
	ШаблонЗапроса.Добавить(ТекстЗапроса_втРасчетныеДанные(НомераТаблиц));
	ШаблонЗапроса.Добавить(ТекстЗапроса_втВидыДвижений(НомераТаблиц));
	ШаблонЗапроса.Добавить(ТекстЗапроса_ТаблицаПроводок(НомераТаблиц));
	
	ТекстЗапроса = СтрСоединить(ШаблонЗапроса, ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета());
	Запрос.Текст = Документы.УчетнаяПолитикаМСФО.ЗаменитьФиксированныеСчетаУчетаБД(ТекстЗапроса);
	
	ПроведениеСерверУХ.ДополнитьТаблицамиИзПакетаЗапросов(ДополнительныеСвойства.ТаблицыДляДвижений, Запрос, НомераТаблиц);

КонецФункции

Функция ТекстЗапроса_втТаблицаРасчета(НомераТаблиц)

	НомераТаблиц.Вставить("втТаблицаРасчета", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	ТаблицаРасчет.ВидОтложенногоНалога КАК ВидОтложенногоНалога,
	|	ТаблицаРасчет.ВидОтложенногоНалога.СчетОтражения КАК СчетОтражения,
	|	ТаблицаРасчет.ВидОтложенногоНалога.ВидАктивовИОбязательств КАК ВидАктивовИОбязательств,
	|	ВЫБОР
	|		КОГДА ТаблицаРасчет.ВидОтложенногоНалога.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПустаяСсылка)
	|			ТОГДА ТаблицаРасчет.ВидОтложенногоНалога.ВидОперации
	|		КОГДА &РегламентированнаяОрганизация
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОпераций._04РасчетОтложенныхНалогов)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыОпераций.РасчетОтложенныхНалоговКонсолидация)
	|	КОНЕЦ КАК ВидОперации,
	|	ВЫБОР
	|		КОГДА вс1.ТипДанных ПОДОБНО ""%Справочник.ВидыВременныхРазниц%""
	|			ТОГДА ТаблицаРасчет.ВидОтложенногоНалога
	|		КОГДА вс1.ТипДанных ПОДОБНО ""%Перечисление.ВидыАктивовИОбязательств%""
	|			ТОГДА ТаблицаРасчет.ВидОтложенногоНалога.ВидАктивовИОбязательств
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА вс2.ТипДанных ПОДОБНО ""%Справочник.ВидыВременныхРазниц%""
	|			ТОГДА ТаблицаРасчет.ВидОтложенногоНалога
	|		КОГДА вс2.ТипДанных ПОДОБНО ""%Перечисление.ВидыАктивовИОбязательств%""
	|			ТОГДА ТаблицаРасчет.ВидОтложенногоНалога.ВидАктивовИОбязательств
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА вс3.ТипДанных ПОДОБНО ""%Справочник.ВидыВременныхРазниц%""
	|			ТОГДА ТаблицаРасчет.ВидОтложенногоНалога
	|		КОГДА вс3.ТипДанных ПОДОБНО ""%Перечисление.ВидыАктивовИОбязательств%""
	|			ТОГДА ТаблицаРасчет.ВидОтложенногоНалога.ВидАктивовИОбязательств
	|	КОНЕЦ КАК Субконто3,
	|	ТаблицаРасчет.ОстатокНСБУ КАК ОстатокНСБУ,
	|	ТаблицаРасчет.ОстатокМСФО КАК ОстатокМСФО,
	|	ТаблицаРасчет.Разница КАК Разница,
	|	ТаблицаРасчет.СуммаОНО КАК СуммаОНО,
	|	ТаблицаРасчет.СуммаОНА КАК СуммаОНА,
	|	ТаблицаРасчет.СуммаПНО КАК СуммаПНО,
	|	ТаблицаРасчет.СуммаПНА КАК СуммаПНА
	|ПОМЕСТИТЬ втТаблицаРасчета
	|ИЗ
	|	Документ.РасчетОтложенныхНалогов.РасчетОтложенныхНалогов КАК ТаблицаРасчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс1
	|		ПО ТаблицаРасчет.ВидОтложенногоНалога.СчетОтражения = вс1.Ссылка
	|			И (вс1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс2
	|		ПО ТаблицаРасчет.ВидОтложенногоНалога.СчетОтражения = вс2.Ссылка
	|			И (вс1.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс3
	|		ПО ТаблицаРасчет.ВидОтложенногоНалога.СчетОтражения = вс3.Ссылка
	|			И (вс3.НомерСтроки = 3)
	|ГДЕ
	|	ТаблицаРасчет.Ссылка = &Ссылка";

КонецФункции

Функция ТекстЗапроса_втСчетаРазниц(НомераТаблиц)

	НомераТаблиц.Вставить("втСчетаРазниц", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК ФиксированныйСчет,
	|	ВЫБОР т.Ссылка
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ОтложенноеНалоговоеОбязательство)
	|			ТОГДА &ОНО
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ОтложенныйНалоговыйАктив)
	|			ТОГДА &ОНА
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ПостоянноеНалоговоеОбязательство)
	|			ТОГДА &ПНО
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ПостоянныйНалоговыйАктив)
	|			ТОГДА &ПНА
	|	КОНЕЦ КАК ВидРазницы,
	|	Забаланс.Счет КАК КорСчет,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	ВЫБОР
	|		КОГДА вс1.ТипДанных ПОДОБНО ""%Справочник.ВидыВременныхРазниц%""
	|			ТОГДА 1
	|		КОГДА вс1.ТипДанных ПОДОБНО ""%Перечисление.ВидыАктивовИОбязательств%""
	|			ТОГДА 2
	|	КОНЕЦ КАК ТипСубконто1,
	|	ВЫБОР
	|		КОГДА вс2.ТипДанных ПОДОБНО ""%Справочник.ВидыВременныхРазниц%""
	|			ТОГДА 1
	|		КОГДА вс2.ТипДанных ПОДОБНО ""%Перечисление.ВидыАктивовИОбязательств%""
	|			ТОГДА 2
	|	КОНЕЦ КАК ТипСубконто2,
	|	ВЫБОР
	|		КОГДА вс3.ТипДанных ПОДОБНО ""%Справочник.ВидыВременныхРазниц%""
	|			ТОГДА 1
	|		КОГДА вс3.ТипДанных ПОДОБНО ""%Перечисление.ВидыАктивовИОбязательств%""
	|			ТОГДА 2
	|	КОНЕЦ КАК ТипСубконто3
	|ПОМЕСТИТЬ втСчетаРазниц
	|ИЗ
	|	Справочник.ФиксированныеСчетаУчетаБД КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс1
	|		ПО т.Счет = вс1.Ссылка
	|			И (вс1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс2
	|		ПО т.Счет = вс2.Ссылка
	|			И (вс1.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК вс3
	|		ПО т.Счет = вс3.Ссылка
	|			И (вс3.НомерСтроки = 3)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФиксированныеСчетаУчетаБД КАК Забаланс
	|		ПО (Забаланс.Ссылка = ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ВспомогательныйЗабалансовый))
	|			И (т.Счет.Забалансовый)
	|ГДЕ
	|	т.Ссылка В (ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ОтложенноеНалоговоеОбязательство), ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ОтложенныйНалоговыйАктив), ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ПостоянноеНалоговоеОбязательство), ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ПостоянныйНалоговыйАктив))";

КонецФункции

Функция ТекстЗапроса_втТаблицаПроводки(НомераТаблиц)

	НомераТаблиц.Вставить("втТаблицаПроводки", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	втТаблицаРасчета.СчетОтражения КАК СчетДт,
	|	втТаблицаРасчета.Субконто1 КАК СубконтоДт1,
	|	втТаблицаРасчета.Субконто2 КАК СубконтоДт2,
	|	втСчетаРазниц.Счет КАК СчетКт,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто1
	|	КОНЕЦ КАК СубконтоКт1,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто2
	|	КОНЕЦ КАК СубконтоКт2,
	|	втТаблицаРасчета.СуммаОНО КАК Значение,
	|	&ОНО КАК Содержание
	|ПОМЕСТИТЬ втТаблицаПроводки
	|ИЗ
	|	втТаблицаРасчета КАК втТаблицаРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаРазниц КАК втСчетаРазниц
	|		ПО (втСчетаРазниц.ВидРазницы = &ОНО)
	|ГДЕ
	|	втТаблицаРасчета.СуммаОНО <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втСчетаРазниц.Счет,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто2
	|	КОНЕЦ,
	|	втТаблицаРасчета.СчетОтражения,
	|	втТаблицаРасчета.Субконто1,
	|	втТаблицаРасчета.Субконто2,
	|	втТаблицаРасчета.СуммаОНА,
	|	&ОНА
	|ИЗ
	|	втТаблицаРасчета КАК втТаблицаРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаРазниц КАК втСчетаРазниц
	|		ПО (втСчетаРазниц.ВидРазницы = &ОНА)
	|ГДЕ
	|	втТаблицаРасчета.СуммаОНА <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕстьNULL(втСчетаРазниц.КорСчет, втТаблицаРасчета.СчетОтражения),
	|	втТаблицаРасчета.Субконто1,
	|	втТаблицаРасчета.Субконто2,
	|	втСчетаРазниц.Счет,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто2
	|	КОНЕЦ,
	|	втТаблицаРасчета.СуммаПНО,
	|	&ПНО
	|ИЗ
	|	втТаблицаРасчета КАК втТаблицаРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаРазниц КАК втСчетаРазниц
	|		ПО (втСчетаРазниц.ВидРазницы = &ПНО)
	|ГДЕ
	|	втТаблицаРасчета.СуммаПНО <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втСчетаРазниц.Счет,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто1 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 1
	|			ТОГДА втТаблицаРасчета.ВидОтложенногоНалога
	|		КОГДА втСчетаРазниц.ТипСубконто2 = 2
	|			ТОГДА втТаблицаРасчета.ВидАктивовИОбязательств
	|		ИНАЧЕ втСчетаРазниц.Субконто2
	|	КОНЕЦ,
	|	ЕстьNULL(втСчетаРазниц.КорСчет, втТаблицаРасчета.СчетОтражения),
	|	втТаблицаРасчета.Субконто1,
	|	втТаблицаРасчета.Субконто2,
	|	втТаблицаРасчета.СуммаПНА,
	|	&ПНА
	|ИЗ
	|	втТаблицаРасчета КАК втТаблицаРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаРазниц КАК втСчетаРазниц
	|		ПО (втСчетаРазниц.ВидРазницы = &ПНА)
	|ГДЕ
	|	втТаблицаРасчета.СуммаПНА <> 0";

КонецФункции

Функция ТекстЗапроса_втТаблицаПроводкиСторно(НомераТаблиц)

	НомераТаблиц.Вставить("втТаблицаПроводкиСторно", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	РасчетныеДанныеОН.СчетДт КАК СчетДт,
	|	РасчетныеДанныеОН.СубконтоДт1 КАК СубконтоДт1,
	|	РасчетныеДанныеОН.СубконтоДт2 КАК СубконтоДт2,
	|	РасчетныеДанныеОН.СубконтоДт3 КАК СубконтоДт3,
	|	РасчетныеДанныеОН.СчетКт КАК СчетКт,
	|	РасчетныеДанныеОН.СубконтоКт1 КАК СубконтоКт1,
	|	РасчетныеДанныеОН.СубконтоКт2 КАК СубконтоКт2,
	|	РасчетныеДанныеОН.СубконтоКт3 КАК СубконтоКт3,
	|	РасчетныеДанныеОН.Значение КАК Значение,
	|	РасчетныеДанныеОН.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ втТаблицаПроводкиСторно
	|ИЗ
	|	РегистрСведений.РасчетныеДанныеОН КАК РасчетныеДанныеОН
	|ГДЕ
	|	РасчетныеДанныеОН.Организация = &Организация
	|	И РасчетныеДанныеОН.Сценарий = &Сценарий
	|	И РасчетныеДанныеОН.Период МЕЖДУ &ДатаНачала И &ДатаОкончания";

