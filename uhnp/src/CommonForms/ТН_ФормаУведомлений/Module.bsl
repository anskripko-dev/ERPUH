#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("СписокУведомлений") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
	СписокУведомлений.ЗагрузитьЗначения(Параметры.СписокУведомлений);
	
	ПервоеУведомление = СписокУведомлений[0].Значение;
	СтруктураКартинокВФорматеHTML = ПервоеУведомление.КартинкиУведомления.Получить();
	
	Если СтруктураКартинокВФорматеHTML = Неопределено Тогда
		СтруктураКартинокВФорматеHTML = Новый Структура;
	КонецЕсли;
	
	ОписаниеУведомления.УстановитьHTML(ПервоеУведомление.Содержание, СтруктураКартинокВФорматеHTML); 
	
	Название = СтрШаблон("%1 от %2", ПервоеУведомление.Наименование, ПервоеУведомление.ДатаСоздания);
	
	Элементы.ДекорацияНазвание.Заголовок = Название;
	ТекущееУведомление = ПервоеУведомление; 
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры  

#КонецОбласти

#Область ОбработчикиКомандФормы    

&НаКлиенте
Процедура КомандаЗакрыть(Команда)
	
	ПрочитаныВсе = Истина;
	
	Для Каждого Элемент Из СписокУведомлений Цикл
		Если Не Элемент.Пометка Тогда 
			ПрочитаныВсе = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПрочитаныВсе Тогда 
		Закрыть();
		ПоказатьПредупреждение(, "Прочитаны не все уведомления!"); 
	Иначе
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура КомандаСледущий(Команда)
	
	ПрочитатьСледуещееУведомлениеНаСервере();
	
КонецПроцедуры   

&НаКлиенте
Процедура КомандаПрочитано(Команда)
	
	КомандаПрочитаноНаСервере(); 
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.ТН_Уведомления"));
	
	Если СписокУведомлений.Количество() > ИдентификаторУведомления + 1 Тогда
		ПрочитатьСледуещееУведомлениеНаСервере();
	Иначе     
		КомандаЗакрыть(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КомандаПрочитаноНаСервере() 
	
	//каждый может прочитать
	УстановитьПривилегированныйРежим(Истина);

	РегистрыСведений.ТН_ОчередьУведомлений.Прочитано(ТекущееУведомление, Пользователи.ТекущийПользователь()); 
	
	СписокУведомлений.Получить(ИдентификаторУведомления).Пометка = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьСледуещееУведомлениеНаСервере()
	
	ИдентификаторУведомления = ИдентификаторУведомления + 1;
	
	ТекущееУведомление = СписокУведомлений.Получить(ИдентификаторУведомления).Значение;	
	СтруктураКартинокВФорматеHTML = ТекущееУведомление.КартинкиУведомления.Получить();
	
	Если СтруктураКартинокВФорматеHTML = Неопределено Тогда
		СтруктураКартинокВФорматеHTML = Новый Структура;
	КонецЕсли;
	
	ОписаниеУведомления.УстановитьHTML(ТекущееУведомление.Содержание, СтруктураКартинокВФорматеHTML); 
	
	Название = ТекущееУведомление.Наименование;
	Элементы.ДекорацияНазвание.Заголовок = Название;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступность()
	
	Элементы.КомандаСледущий.Видимость = СписокУведомлений.Количество() > ИдентификаторУведомления + 1;
	
КонецПроцедуры 

#КонецОбласти

