
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Расшифровка", Расшифровка) Тогда
		
		Параметры.Свойство("ИспользуемаяИБ", ИспользуемаяИБ);
				
		ТекСоединениеВИБ = УправлениеСоединениямиВИБУХ.ПолучитьСоединение(ИспользуемаяИБ, 1);
		
		Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
			
			ДанныеДляОтображения=ТекСоединениеВИБ.GetObjectRepresentation(Новый ХранилищеЗначения(Расшифровка, Новый СжатиеДанных(9)),
				Новый ХранилищеЗначения(Новый Структура, Новый СжатиеДанных(9))).Получить();
			
		ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
			
			ДанныеДляОтображения=РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"GetObjectRepresentation",Расшифровка);
			
			Если ДанныеДляОтображения=Неопределено Тогда
				
				Отказ=Истина;
				
			КонецЕсли;
			
		Иначе
			
			ДанныеДляОтображения= РаботаСОбъектамиМетаданныхВнешнийУХ.GetObjectRepresentation(ТекСоединениеВИБ,Расшифровка);
						
		КонецЕсли;
		
		ПолеТабличногоДокумента.Вывести(ДанныеДляОтображения.ТаблицаДляОтображения);
		Заголовок=ДанныеДляОтображения.НаименованиеФормы+" ("+ИспользуемаяИБ+")";
	
	Иначе
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеТабличногоДокументаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("ОбщаяФорма.ОтображениеЭлементаWS_Управляемая", Новый Структура("Расшифровка, ИспользуемаяИБ", Расшифровка, ИспользуемаяИБ));
	
КонецПроцедуры
