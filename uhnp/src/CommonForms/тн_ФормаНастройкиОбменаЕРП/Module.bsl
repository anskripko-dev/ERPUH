#Область СлужебныеПроцедурыФункции

&НаСервере
Функция ПолучитьМассивКонстант();
	
	МассивКонстант = Новый Массив;
	МассивКонстант.Добавить("тн_КонтрагентТНАлабуга");
	МассивКонстант.Добавить("тн_ДатаНачалаВеденияУчета");
	МассивКонстант.Добавить("тн_ДатаНачалаВыгрузкиВЗаводы");
	МассивКонстант.Добавить("тн_СрокХраненияСообщенияRMQВОчередиДляОбработки");
	МассивКонстант.Добавить("СрокХраненияСправочникИсходящиеСообщения");
	МассивКонстант.Добавить("тн_Интеграция_КоличествоОбъектовВПотокеОбработкиСообщенийRMQ");
	МассивКонстант.Добавить("тн_Интеграция_КоличествоПопытокПовторнойОбработкиСообщенийRMQ");
	МассивКонстант.Добавить("тн_ЕдиныйСкладОбменаСЗаводами");
	МассивКонстант.Добавить("тн_ВремяПоследнейСводкиОСостоянииВходящихСообщений");
	МассивКонстант.Добавить("тн_МаксимальноеКоличествоПопытокИсправленияПроведенияЗагруженныхДокументов");
	МассивКонстант.Добавить("тн_ВидЦеныДляВыгрузкиОКС");
	МассивКонстант.Добавить("тн_ДатаНачалаВыгрузкиВалютныхКорректировокВОКС");
	// НАЧАЛО Чекордина Ирина 20.11.2025 Выполение задач №000055693
	МассивКонстант.Добавить("тн_БазоваяЗадержкаПовторнойОбработкиСообщений");
	// КОНЕЦ Чекордина Ирина 20.11.2025 Выполение задач №000055693
	
	Возврат МассивКонстант; 
	
КонецФункции

&НаСервере
Процедура ПолучитьКонстанты()
	
	МассивКонстант = ПолучитьМассивКонстант();
	
	Для Каждого Константа Из МассивКонстант Цикл
		КонстантыНабор[Константа] = Константы[Константа].Получить();	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКонстанты() 
	
	МассивКонстант = ПолучитьМассивКонстант();
	
	Для Каждого Константа Из МассивКонстант Цикл
		Константы[Константа].Установить(КонстантыНабор[Константа]);	
	КонецЦикла;
	
	ЭтотОбъект.Модифицированность = Ложь;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПодтвердитьЗакрытиеФормыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		
		ПринудительноЗакрытьФорму = Истина;
		Закрыть();
		
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		
		УстановитьКонстанты();
		Закрыть();
		
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти

