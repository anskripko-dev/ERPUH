
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаЦентральнаяБаза КАК ЗаявкаЦентральнаяБаза,
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза.СправочникБД.GUIDТекущейИБ КАК GUIDТекущейИБ
	             |ИЗ
	             |	РегистрСведений.СоответствиеЗаявокНаИзменениеНСИ КАК СоответствиеЗаявокНаИзменениеНСИ
	             |ГДЕ
	             |	СоответствиеЗаявокНаИзменениеНСИ.ЗаявкаДочерняяБаза = &ЗаявкаДочерняяБаза";
	
	Запрос.УстановитьПараметр("ЗаявкаДочерняяБаза",Параметры.ЗаявкаДочерняяБаза);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Не Результат.Следующий() Тогда
		
		Отказ=Истина;
		Возврат;
		
	КонецЕсли;
		
	ТекСоединениеВИБ = ПодключениеКВИБУХ.ПолучитьСоединение(Результат.ЦентрализованнаяБазаНСИ, 1);
	
	Если ТекСоединениеВИБ=Неопределено Тогда
		
		Отказ=Истина;
		Возврат;
		
	КонецЕсли;
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ТипОтчета",Параметры.ТипОтчета);
	СтруктураПараметров.Вставить("ЗаявкаЦентральнаяБаза",Результат.ЗаявкаЦентральнаяБаза);
	СтруктураПараметров.Вставить("GUIDТекущейИБ",Результат.GUIDТекущейИБ);
					
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
						
		ТабДок= ТекСоединениеВИБ.GetMDMApplicationHistory(Новый ХранилищеЗначения(СтруктураПараметров, Новый СжатиеДанных(9))).Получить();
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		ТабДок=РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"GetMDMApplicationHistory",СтруктураПараметров);
		
	Иначе
		
		ТабДок=РаботаСОбъектамиМетаданныхВнешнийУХ.GetMDMApplicationHistory(ТекСоединениеВИБ,СтруктураПараметров);
		
	КонецЕсли;
	
	Если Параметры.ТипОтчета="ИсторияСогласования" Тогда
		
		ТекстЗаголовка=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Централизованная база %1: история согласования %2'"),Результат.ЦентрализованнаяБазаНСИ,Параметры.ЗаявкаДочерняяБаза);
		
	Иначе
		
		ТекстЗаголовка=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Централизованная база %1: ход согласования %2'"),Результат.ЦентрализованнаяБазаНСИ,Параметры.ЗаявкаДочерняяБаза);

	КонецЕсли;
	
	Заголовок=ТекстЗаголовка;
			
	ИсторияСогласования.Вывести(ТабДок);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияСогласованияОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка=Ложь;
	
КонецПроцедуры
