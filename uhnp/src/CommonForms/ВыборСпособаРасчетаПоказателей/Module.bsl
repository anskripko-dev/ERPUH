
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("СпособФормированияОтчета", СпособФормированияОтчета);
	Параметры.Свойство("ПравилоОбработки", ПравилоОбработки);
	Параметры.Свойство("ПравилоПроверки", ПравилоПроверки);
	Параметры.Свойство("БланкДляИмпорта", БланкДляИмпорта);
	Параметры.Свойство("ВнешняяИнформационнаяБаза", ВнешняяИнформационнаяБаза);
	Параметры.Свойство("ПериодичностьСвертывания", ПериодичностьСвертывания);
	
	Параметры.Свойство("СпособИмпортирования", СпособИмпортирования);
	Параметры.Свойство("ПутьКФайлу", ПутьКФайлу);
	Параметры.Свойство("ФайлИмпорта", ФайлИмпорта);
	
	Если ЗначениеЗаполнено(ФайлИмпорта) Тогда
		// Файл уже загружен в информационную базу
		СпособИмпортирования = 1;
	КонецЕсли;
	
	// Рассчитаем настройки обработки показателей, если они не заданы вручную
	Если НЕ ЗначениеЗаполнено(СпособФормированияОтчета)
		И НЕ ЗначениеЗаполнено(ПравилоОбработки)
		И НЕ ЗначениеЗаполнено(ПравилоПроверки)
		И НЕ ЗначениеЗаполнено(БланкДляИмпорта)
		И НЕ ЗначениеЗаполнено(ВнешняяИнформационнаяБаза)
		И НЕ ЗначениеЗаполнено(ПериодичностьСвертывания)
		И ТипЗнч(Параметры.Организация) = Тип("СправочникСсылка.Организации") Тогда
		
		ПараметрыНастроек = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов(Параметры);
		ПараметрыНастроек.ШаблонДокумента = Параметры.ВидОтчета;
		НастройкиОбработкиДокумента = УправлениеОтчетамиУХ.НастройкиОбработкиШаблонов(ПараметрыНастроек);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкиОбработкиДокумента);
		
	КонецЕсли;
	
	ПроверитьВидимостьВыбораФайлаПоПравилуОбработки();
	
	БюджетированиеИОтчетность.ЗаполнитьЭлементыОбработкиПоказателейОтчетов(ЭтаФорма, Параметры);
	
	УправлениеВидимостью();
	УправлениеВидимостьюСпособаИмпортирования(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПравилоОбработкиПриИзменении(Элемент)
	
	ПравилоОбработкиПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПравилоОбработкиПриИзмененииНаСервере()
	
	БюджетированиеИОтчетность.ЗаполнитьЭлементВнешняяИнформационнаяБаза(ЭтаФорма);
	
	ПроверитьВидимостьВыбораФайлаПоПравилуОбработки();
	
	УправлениеВидимостью();

КонецПроцедуры

&НаКлиенте
Процедура СпособФормированияОтчетаПриИзменении(Элемент)
	
	УправлениеВидимостью();
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Выберите файл для импорта'");
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = 
		НСтр("ru = 'Таблица Excel'")
		+ " (*.xlsx)|*.xlsx|"
		+ НСтр("ru = 'Таблица Excel'")
		+ " (*.xlsm)|*.xlsm|";
		
	Если ЕстьВыборФайлаПоПравилуОбработки Тогда
		ДиалогВыбораФайла.Фильтр = ДиалогВыбораФайла.Фильтр
		+ НСтр("ru = 'Таблица Excel'")
		+ " (*.xls)|*.xls|"
	Иначе
		ДиалогВыбораФайла.Фильтр = ДиалогВыбораФайла.Фильтр
		+ НСтр("ru = 'Табличный документ'")
		+ " (*.mxl)|*.mxl";
	КонецЕсли;
	
	ОписаниеОткрытияФайла = Новый ОписаниеОповещения("ВыборФайлаНаДискеЗавершение", ЭтаФорма);
	
	ФайловаяСистемаКлиент.ПоказатьДиалогВыбора(ОписаниеОткрытияФайла, ДиалогВыбораФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаНаДискеЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение)
		И ВыбранноеЗначение.Количество() > 0 Тогда
		ПутьКФайлу = ВыбранноеЗначение[0];
	Иначе
		ПутьКФайлу = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СпособИмпортированияПриИзменении(Элемент)
	
	УправлениеВидимостьюСпособаИмпортирования(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)

	СтруктураЗакрытия = Новый Структура;
	СтруктураЗакрытия.Вставить("СпособФормированияОтчета", СпособФормированияОтчета);
	СтруктураЗакрытия.Вставить("ПравилоПроверки", ПравилоПроверки);
	СтруктураЗакрытия.Вставить("ПравилоОбработки", ПравилоОбработки);
	СтруктураЗакрытия.Вставить("ВнешняяИнформационнаяБаза", ВнешняяИнформационнаяБаза);
	СтруктураЗакрытия.Вставить("БланкДляИмпорта", БланкДляИмпорта);
	СтруктураЗакрытия.Вставить("ПериодичностьСвертывания", ПериодичностьСвертывания);
	СтруктураЗакрытия.Вставить("СпособИмпортирования", СпособИмпортирования);
	СтруктураЗакрытия.Вставить("ПутьКФайлу", ПутьКФайлу);
	СтруктураЗакрытия.Вставить("ФайлИмпорта", ФайлИмпорта);
	
	// Для совместимости с метаданными экземпляра отчета и движка расчета показателей
	СтруктураЗакрытия.Вставить("ИспользуемаяИБ", ВнешняяИнформационнаяБаза);
	СтруктураЗакрытия.Вставить("БланкИмпорта", БланкДляИмпорта);
	
	// Признак того, что нужно дополнительно обработать выбранный файл
	СтруктураЗакрытия.Вставить("НужнаОбработкаФайла", Ложь);
	Если СпособИмпортирования > 0 Тогда
		Если ЕстьВыборФайлаПоПравилуОбработки Тогда
			СтруктураЗакрытия.Вставить("НужнаОбработкаФайла", Истина);
		ИначеЕсли СпособФормированияОтчета = ПредопределенноеЗначение("Перечисление.СпособыФормированияОтчетов.Импорт") Тогда
			СтруктураЗакрытия.Вставить("НужнаОбработкаФайла", Истина);
		КонецЕсли;
	ИначеЕсли СпособФормированияОтчета = ПредопределенноеЗначение("Перечисление.СпособыФормированияОтчетов.Импорт") Тогда
		// Для записи в журнал действий расчета
		СтруктураЗакрытия.Вставить("УточнениеСпособаФормированияОтчета", Строка(ВнешняяИнформационнаяБаза));
	КонецЕсли;
	
	Закрыть(СтруктураЗакрытия);
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюСпособаИмпортирования(Форма)
	
	Если Форма.СпособИмпортирования = 1 Тогда
		Форма.Элементы.ПутьКФайлу.Видимость = Ложь;
		Форма.Элементы.ФайлИмпорта.Видимость = Истина;
	ИначеЕсли Форма.СпособИмпортирования = 2 Тогда
		Форма.Элементы.ПутьКФайлу.Видимость = Истина;
		Форма.Элементы.ФайлИмпорта.Видимость = Ложь;
	Иначе
		Форма.Элементы.ПутьКФайлу.Видимость = Ложь;
		Форма.Элементы.ФайлИмпорта.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостью()
	
	Элементы.ГруппаВыборФайла.Видимость = Ложь;
	Элементы.БланкДляИмпорта.Видимость = Ложь;
	Элементы.ПериодичностьСвертывания.Видимость = Ложь;
	
	Элементы.ДекорацияПояснениеПоПравилуОбработки.Видимость = Ложь;
	Элементы.ДекорацияПояснениеИмпорт.Видимость = Ложь;
	Элементы.ДекорацияПояснениеКонсолидация.Видимость = Ложь;
	Элементы.ДекорацияПояснениеКонсолидацияПропорционально.Видимость = Ложь;
	Элементы.ДекорацияПояснениеЭлиминация.Видимость = Ложь;
	Элементы.ДекорацияПояснениеСвернувПоАналитикам.Видимость = Ложь;
	Элементы.ДекорацияПояснениеСвернувПоПериоду.Видимость = Ложь;
	
	Если СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.ПоПравилуОбработки Тогда
		Элементы.ДекорацияПояснениеПоПравилуОбработки.Видимость = Истина;
		Элементы.ГруппаВыборФайла.Видимость = ЕстьВыборФайлаПоПравилуОбработки;
	ИначеЕсли СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Импорт Тогда
		Элементы.ДекорацияПояснениеИмпорт.Видимость = Истина;
		Элементы.БланкДляИмпорта.Видимость = Истина;
		Элементы.ГруппаВыборФайла.Видимость = Истина;
	ИначеЕсли СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Консолидация Тогда
		Элементы.ДекорацияПояснениеКонсолидация.Видимость = Истина;
	ИначеЕсли СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.КонсолидацияПропорционально Тогда
		Элементы.ДекорацияПояснениеКонсолидацияПропорционально.Видимость = Истина;
	ИначеЕсли СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Элиминация Тогда
		Элементы.ДекорацияПояснениеЭлиминация.Видимость = Истина;
	ИначеЕсли СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.СвернувПоАналитикам Тогда
		Элементы.ДекорацияПояснениеСвернувПоАналитикам.Видимость = Истина;
	ИначеЕсли СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.СвернувПоПериоду Тогда
		Элементы.ДекорацияПояснениеСвернувПоПериоду.Видимость = Истина;
		Элементы.ПериодичностьСвертывания.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверитьВидимостьВыбораФайлаПоПравилуОбработки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИСТИНА КАК ЕстьВыборФайлаПоПравилуОбработки
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|ГДЕ
		|	ПравилаОбработки.ТипБД.ВерсияПлатформы = ЗНАЧЕНИЕ(Перечисление.ПлатформыВнешнихИнформационныхБаз.ADO)
		|	И ПравилаОбработки.ТипБД.ВИБПоУмолчанию.ТипХранилищаДанныхADO = ЗНАЧЕНИЕ(Перечисление.ТипыХранилищДанныхADO.XLS)
		|	И ПравилаОбработки.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПравилоОбработки);
	
	ЕстьВыборФайлаПоПравилуОбработки = НЕ Запрос.Выполнить().Пустой();
	
КонецПроцедуры

#КонецОбласти


