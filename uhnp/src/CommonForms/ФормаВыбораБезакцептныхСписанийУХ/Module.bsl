#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокБезакцептныхСписаний = Параметры.СписокБезакцептныхСписаний;

	Элементы.ТаблицаЭлементыСтруктурыЗадолженности.ТолькоПросмотр = Параметры.ЗаблокироватьФорму;
	Элементы.ОК.Доступность = Не Параметры.ЗаблокироватьФорму;

	Для Каждого СтрокаСписка Из СписокБезакцептныхСписаний Цикл 
		
		НовСтр = ТаблицаЭлементыСтруктурыЗадолженности.Добавить();
		НовСтр.ЭлементСтруктурыЗадолженности = СтрокаСписка.Значение;
		НовСтр.БезакцептноеСписание = СтрокаСписка.Пометка;   
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаЭлементыСтруктурыЗадолженности

&НаКлиенте
Процедура ТаблицаЭлементыСтруктурыЗадолженностиПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЭлементыСтруктурыЗадолженностиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	Закрыть(СформироватьСписокБезакцептныхСписаний());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции   

&НаКлиенте
Функция СформироватьСписокБезакцептныхСписаний()
	
	СписокЗначений = Новый СписокЗначений;
	
	Для Каждого СтрокаТаблицы Из ТаблицаЭлементыСтруктурыЗадолженности Цикл   
			
		СписокЗначений.Добавить(СтрокаТаблицы.ЭлементСтруктурыЗадолженности,,СтрокаТаблицы.БезакцептноеСписание);

	КонецЦикла;

	Возврат СписокЗначений;

КонецФункции  

#КонецОбласти	  
	  
	  

