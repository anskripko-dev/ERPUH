&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
	ЭтоСправочник = Параметры.Свойство("ЭтоСправочник");
	// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
	
	//НАЧАЛО Качикина 13.08.2025 Выполнение задач №000054584 
	Если ЭтоСправочник Тогда
		ЭтаФорма.Заголовок = "Изменение реквизитов справочника";
		Элементы.ЗаписатьБезПерепроведения.Заголовок = "Записать";
	КонецЕсли;
	//КОНЕЦ Качикина 13.08.2025 Выполнение задач №000054584 
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
	Если Параметры.Свойство("тн_ОсновнойДокументОплаты") Тогда
	// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415	
		тн_ОсновнойДокументОплаты = Параметры.тн_ОсновнойДокументОплаты;
	// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
	КонецЕсли;
	Если Параметры.Свойство("тн_ОтветственныйСотрудник") Тогда
	// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415	
		тн_ОтветственныйСотрудник = Параметры.тн_ОтветственныйСотрудник;  
	// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
	КонецЕсли;
	Если Параметры.Свойство("тн_ОригиналПолучен") Тогда
		тн_ОригиналПолучен = Параметры.тн_ОригиналПолучен;
	КонецЕсли;  
	Если Параметры.Свойство("тн_СканПолучен") Тогда
		тн_СканПолучен = Параметры.тн_СканПолучен;
	КонецЕсли;  
	Если Параметры.Свойство("Статус") Тогда
		Статус = Параметры.Статус;
	КонецЕсли;
	// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
	// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
	Если Не ЭтоСправочник Тогда
	// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
		Контрагент = Параметры.Контрагент;  
		Организация = Параметры.Организация;  
	// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
	КонецЕсли;
	// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
	Документ = Параметры.Документ;  
	// НАЧАЛО Юдина (Гутарова) Екатерина 28.05.2024 Выполнение задач №000049669  
	Если Параметры.Свойство("Комментарий") Тогда   
		Комментарий = Параметры.Комментарий; 
	КонецЕсли;   
    Элементы.Комментарий.Видимость = Параметры.Свойство("Комментарий");
	// КОНЕЦ Юдина (Гутарова) Екатерина 28.05.2024 Выполнение задач №000049669
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
    Элементы.тн_ОригиналПолучен.Видимость = Параметры.Свойство("тн_ОригиналПолучен");
    Элементы.тн_СканПолучен.Видимость = Параметры.Свойство("тн_СканПолучен");
    Элементы.Статус.Видимость = Параметры.Свойство("Статус"); 
	
    Элементы.тн_ОтветственныйСотрудник.Видимость = Параметры.Свойство("тн_ОтветственныйСотрудник");
    Элементы.тн_ОсновнойДокументОплаты.Видимость = Параметры.Свойство("тн_ОсновнойДокументОплаты"); 
	// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
		
	//НАЧАЛО Качикина 07.10.2024 Выполнение задач №000051011
	тн_ПропуститьОбщийКод = Параметры.тн_ПропуститьОбщийКод;
	//если используем СписокРеквизитовДляЗаписи, то у элементов из этого списка Видимость по-умолчанию = Ложь 	
    Если Параметры.Свойство("СписокРеквизитовДляЗаписи") тогда
		
		СписокРеквизитовДляЗаписи = Параметры.СписокРеквизитовДляЗаписи;	
		Для Каждого ЭлементСписка Из СписокРеквизитовДляЗаписи Цикл 
			ИмяРеквизита = ЭлементСписка.Значение; 
			ЭтаФорма[ИмяРеквизита] = Документ[ИмяРеквизита];
			Элементы[ИмяРеквизита].Видимость = Истина;
		КонецЦикла;	   
		
		// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
		Если Не ЭтоСправочник Тогда
		// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
			//флаги тн_УпрУчетНДС и тн_ЗарегистрироватьВОбмен разрешено редактировать, есть дата запрета по Международному учету это позволяет 
			ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(Организация); 
			Если ЗначениеЗаполнено(ДанныеЗакрытияПериода.ДатаЗакрытияПериода)
				И Документ.Дата<=ДанныеЗакрытияПериода.ДатаЗакрытияПериода Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Установлен запрет изменения данных по международному учету!");
				Элементы.тн_ЗарегистрироватьВОбмен.Доступность = Ложь;
				Элементы.тн_УпрУчетНДС.Доступность = Ложь;
			КонецЕсли;
		// НАЧАЛО Юдина Екатерина 02.04.2025 Выполнение задач №000053277  
		КонецЕсли;
		// КОНЕЦ Юдина Екатерина 02.04.2025 Выполнение задач №000053277 
	КонецЕсли;
	//КОНЕЦ Качикина 07.10.2024 Выполнение задач №000051011
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьБезПерепроведенияНаСервере()
	
	Если ЗначениеЗаполнено(Документ) Тогда   
		
		Объект = Документ.ПолучитьОбъект();	
		
		//НАЧАЛО Качикина 07.10.2024 Выполнение задач №000051011 
		Если НЕ тн_ПропуститьОбщийКод Тогда
		//КОНЕЦ Качикина 07.10.2024 Выполнение задач №000051011

		// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
		//НАЧАЛО Качикина 31.01.2025 Выполнение задач №000052309
		//// НАЧАЛО Николаев Павел 08.11.2024 Выполнение задач №000051555
		////Если ТипЗнч(Объект) = Тип("ДокументОбъект.СверкаВзаиморасчетов") Тогда
		//Если ТипЗнч(Объект) = Тип("ДокументОбъект.СверкаВзаиморасчетов2_4") Тогда
		//// КОНЕЦ Николаев Павел 08.11.2024 Выполнение задач №000051555
		Если ТипЗнч(Объект) = Тип("ДокументОбъект.СверкаВзаиморасчетов2_4")
			Или ТипЗнч(Объект) = Тип("ДокументОбъект.СверкаВзаиморасчетов2_5_11") Тогда
		//КОНЕЦ Качикина 31.01.2025 Выполнение задач №000052309
		
			Объект.тн_СканПолучен = тн_СканПолучен; 
			Объект.тн_ОригиналПолучен = тн_ОригиналПолучен; 	
			Объект.Статус = Статус;  
			
		Иначе	
		// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
			
			Объект.тн_ОсновнойДокументОплаты = тн_ОсновнойДокументОплаты;
			
			Если ТипЗнч(Объект) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
				Объект.тн_ОтветственныйЗаПлатеж = тн_ОтветственныйСотрудник; 	
			Иначе
				Объект.тн_ОтветственныйСотрудник = тн_ОтветственныйСотрудник; 
			КонецЕсли;
			
			// НАЧАЛО Юдина (Гутарова) Екатерина 28.05.2024 Выполнение задач №000049669  
			Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") Тогда   
				Объект.Комментарий = Комментарий;     
				// НАЧАЛО Юдина (Гутарова) Екатерина 23.08.2024 Выполнение задач №000050611 
				Объект.ДополнительныеСвойства.Вставить("ОтключитьВсеПроверки", Истина);
				// КОНЕЦ Юдина (Гутарова) Екатерина 23.08.2024 Выполнение задач №000050611
			КонецЕсли;   
			// КОНЕЦ Юдина (Гутарова) Екатерина 28.05.2024 Выполнение задач №000049669
			
		// НАЧАЛО Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
		КонецЕсли;
		// КОНЕЦ Юдина (Гутарова) Екатерина 02.05.2024 Выполнение задач №000049415
		
		//НАЧАЛО Качикина 07.10.2024 Выполнение задач №000051011
		КонецЕсли;
	
		Для Каждого ЭлементСписка Из СписокРеквизитовДляЗаписи Цикл 
			ИмяРеквизита = ЭлементСписка.Значение; 
			Если ИмяРеквизита = "тн_ЗарегистрироватьВОбмен"
				И НЕ Объект[ИмяРеквизита] = ЭтаФорма[ИмяРеквизита] Тогда
				Объект.ДополнительныеСвойства.Вставить("ПринудительноЗарегистрировать", Истина);	
			КонецЕсли;
			Объект[ИмяРеквизита] = ЭтаФорма[ИмяРеквизита];	
		КонецЦикла;
		//КОНЕЦ Качикина 07.10.2024 Выполнение задач №000051011
		
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();    
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьБезПерепроведения(Команда) 
	
	ЗаписатьБезПерепроведенияНаСервере();    
    ВладелецФормы.Прочитать();	
	Закрыть();
	
КонецПроцедуры   