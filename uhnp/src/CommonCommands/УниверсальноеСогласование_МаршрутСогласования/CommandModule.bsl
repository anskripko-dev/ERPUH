
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.ЗаявкаНаИзменениеНСИ") Тогда
		
		УправлениеФормойНСИКлиент.МаршрутСогласования(ПараметрыВыполненияКоманды.Источник,ПараметрКоманды,СогласованиеВнешняяИБ(ПараметрКоманды));
		
	Иначе
		
		МодульСогласования=ОбщегоНазначенияКлиент.ОбщийМодуль("ДействияСогласованиеУХКлиент");
		МодульСогласования.МаршрутСогласования(ПараметрыВыполненияКоманды.Источник,ПараметрКоманды);
				
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере
Функция СогласованиеВнешняяИБ(Ссылка)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗаявкаНаИзменениеНСИ.СправочникБД.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ
	             |ИЗ
	             |	Документ.ЗаявкаНаИзменениеНСИ КАК ЗаявкаНаИзменениеНСИ
	             |ГДЕ
	             |	ЗаявкаНаИзменениеНСИ.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	Возврат ЗначениеЗаполнено(Результат.ЦентрализованнаяБазаНСИ);
		
КонецФункции // СогласованиеВнешняяИБ()
