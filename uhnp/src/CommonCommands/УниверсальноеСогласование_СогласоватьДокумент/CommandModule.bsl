
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрКоманды)=Тип("ДокументСсылка.ЗаявкаНаИзменениеНСИ") Тогда
		
		ДанныеСогласования=ДанныеСогласованияВнешняяИБ(ПараметрКоманды);
		
		Если ЗначениеЗаполнено(ДанныеСогласования.ЦентрализованнаяБазаНСИ) Тогда
			
			ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Изменения объектов %1 согласуются в централизованной базе НСИ %2'"),ДанныеСогласования.СправочникБД,ДанныеСогласования.ЦентрализованнаяБазаНСИ);
		    ПоказатьПредупреждение(,ТекстСообщения);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДействияСогласованиеУХКлиент.СогласоватьДокумент(ПараметрыВыполненияКоманды.Источник);
	
КонецПроцедуры 

&НаСервере
Функция ДанныеСогласованияВнешняяИБ(Ссылка)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗаявкаНаИзменениеНСИ.СправочникБД.ЦентрализованнаяБазаНСИ КАК ЦентрализованнаяБазаНСИ,
	             |	ЗаявкаНаИзменениеНСИ.СправочникБД КАК СправочникБД
	             |ИЗ
	             |	Документ.ЗаявкаНаИзменениеНСИ КАК ЗаявкаНаИзменениеНСИ
	             |ГДЕ
	             |	ЗаявкаНаИзменениеНСИ.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
		
КонецФункции // СогласованиеВнешняяИБ()
