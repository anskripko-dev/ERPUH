#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыполнитьПроверкуНаСервере();
	
	СхемаКомпоновкиДанных = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	//Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;  
	// - Если сделать так, как показано выше(рекомендуют на некоторых ресурсах), то при изменении настроек в режиме клиента
	// этих изменений Вы не увидите, потому что настройки всегда будут по умолчанию. Как правильно - вариант ниже
	Настройки = КомпоновщикНастроек.ПолучитьНастройки(); 
 
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных; 
 
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);	
	
	ВнешнийНаборДанных = Новый Структура("ТЗ", Протокол.Выгрузить()); 
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных; 
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных, ДанныеРасшифровки); 
	
	ДокументРезультат.Очистить();
	
 	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент; 
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат); 
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьПроверкуНаСервере()              
	
	ПараметрыПроверки = ПолучитьПараметрыПроверки();
	Протокол.Очистить();   
	
	ВаполнитьПроверку_ПланОбменаПолный();  
	
	ВыполнитьПроверку_ВводНаОсновании(ПараметрыПроверки.ВводНаОсновании);
	ВыполнитьПроверку_ОпределяемыеТипы(ПараметрыПроверки.ОпределяемыеТипы);
	ВыполнитьПроверку_КонтрольТипов();
	ВыполнитьПроверку_СоответствиеОпределяемыхТипов(ПараметрыПроверки.СоответствиеОпределяемыхТипов);

	ВыполнитьПроверку_КонтрольПодсистемы(ПараметрыПроверки);
	
КонецПроцедуры

Процедура ВыполнитьПроверку_ВводНаОсновании(ВводНаОсновании)
	
	Для Каждого КлючЗначение Из ВводНаОсновании Цикл
		ВводНаОсновании(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры   

Процедура ВыполнитьПроверку_ОпределяемыеТипы(ОпределяемыеТипы)

	Для Каждого КлючЗначение Из ОпределяемыеТипы Цикл
		ОпределяемыеТипы(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

Процедура ВаполнитьПроверку_ПланОбменаПолный()
	
	//        
	ПланОбмена = "Полный";   
	Проверка = "ПланыОбмена";
	Подсистемы = Новый Массив;
	//Подсистемы.Добавить("Подсистема.ПодсистемыУХ");
	Подсистемы.Добавить("Подсистема.ПодсистемыУХ.Подсистема.ПланированиеИКонтрольСлужебный");
	//Подсистемы.Добавить("Подсистема.ПланированиеИКонтрольСлужебный");  
	
	Для Каждого Подсистема Из Подсистемы Цикл
		//
		МетаПлан = Метаданные.ПланыОбмена.Найти(ПланОбмена);
		Если МетаПлан = неопределено Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'План обмена %1 не найден'"), ПланОбмена);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		МетаПодсистема = Метаданные.НайтиПоПолномуИмени(Подсистема);
		Если МетаПодсистема = неопределено Тогда
			Строка = Протокол.Добавить(); 
			Строка.Проверка = Проверка;
			Строка.Описание = СтрШаблон(НСтр("ru = 'Не найдена подсистема %1'"), Подсистема);    
			Строка.Подсистема = Подсистема; 
			Продолжить;
		КонецЕсли;
		
		// Объекты метаданных
		ТаблицаОбъектов = Новый ТаблицаЗначений;
		ТаблицаОбъектов.Колонки.Добавить("Подсистема");
		ТаблицаОбъектов.Колонки.Добавить("Расположение");
		ТаблицаОбъектов.Колонки.Добавить("ОбъектМетаданных");
		ТаблицаОбъектов.Колонки.Добавить("ТипМетаданных");
		ТаблицаОбъектов.Колонки.Добавить("Имя");
		ТаблицаОбъектов.Колонки.Добавить("ПолноеИмя");
		ТаблицаОбъектов.Колонки.Добавить("ОбновлениеПредопределенныхДанных");
		
		ЗаполнитьСписокОбъектовПодсистемы(ТаблицаОбъектов, МетаПодсистема);
		
		УникальныеОбъекты = ТаблицаОбъектов.Скопировать();
		УникальныеОбъекты.Свернуть("ТипМетаданных, Имя, ПолноеИмя, Подсистема, Расположение, ОбновлениеПредопределенныхДанных", "");
		
		СтруктураПоиска = Новый Структура("ТипМетаданных");
		Для Каждого ИмяОбъекта Из УникальныеОбъекты Цикл
			
			СтруктураПоиска.ТипМетаданных = ИмяОбъекта.ПолноеИмя;
			
			Строки = Протокол.НайтиСтроки(СтруктураПоиска);
			
			Если Строки.Количество() = 0 Тогда
				Строка = Протокол.Добавить(); 
				Строка.Проверка = Проверка;
				Строка.ТипМетаданных = СтруктураПоиска.ТипМетаданных;
			Иначе
				Строка = Строки[0];
			КонецЕсли;
			
			Строка.ТипМетаданных = ИмяОбъекта.ТипМетаданных;
			Строка.ОбъектМетаданных = ИмяОбъекта.Имя;
			Строка.Подсистема = ИмяОбъекта.Подсистема;
			Строка.ОбновлениеПредопределенныхДанных = ИмяОбъекта.ОбновлениеПредопределенныхДанных;
			
			Если Строка.Расположение <> "" Тогда
				Строка.Расположение = Строка.Расположение + Символы.ПС;
			КонецЕсли;
			Строка.Расположение = Строка.Расположение + ИмяОбъекта.Расположение;
			
		КонецЦикла;
		
		// План обмена
		МетаПлан = Метаданные.ПланыОбмена.Полный;
		Для Каждого МетаОбъект Из МетаПлан.Состав Цикл
			
			СтруктураПоиска.ТипМетаданных = МетаОбъект.Метаданные.ПолноеИмя();
			Строки = Протокол.НайтиСтроки(СтруктураПоиска);
			Если Строки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Строка = Строки[0];
			Строка.ПланОбмена = МетаПлан.Имя;
			Строка.АвтоРегистрация = МетаОбъект.АвтоРегистрация = АвторегистрацияИзменений.Разрешить;
			
		КонецЦикла;
		
		// Подписки
		ШаблонИмениПодписки = ПланОбмена + "Регистрация";
		
		// 
		СписокИсточников = Новый Соответствие;
		Для Каждого Подписка Из Метаданные.ПодпискиНаСобытия Цикл
			
			Если НЕ СтрНачинаетсяС(Подписка.Имя, ШаблонИмениПодписки)  Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ТипИсточника Из Подписка.Источник.Типы() Цикл
				МетаИсточник = Метаданные.НайтиПоТипу(ТипИсточника);
				Если МетаИсточник = неопределено Тогда
					ВызватьИсключение НСтр("ru = 'Не найден объект метаданных по типу из подписки'");
				КонецЕсли;
				
				Если СписокИсточников.Получить(МетаИсточник) = неопределено Тогда
					Подписки = Новый Массив;
					СписокИсточников.Вставить(МетаИсточник, Подписки);
				Иначе
					Подписки = СписокИсточников[МетаИсточник];
				КонецЕсли;
				
				Подписки.Добавить(Подписка.Имя);
				
			КонецЦикла;
			
		КонецЦикла;
		
		//	
		СтруктураПоиска = Новый Структура("ТипМетаданных");
		Для Каждого КлючЗначение Из СписокИсточников Цикл
			
			ОбъектМетаданных = КлючЗначение.Ключ;
			
			СтруктураПоиска.ТипМетаданных = ОбъектМетаданных.ПолноеИмя();
			
			Строки = Протокол.НайтиСтроки(СтруктураПоиска);
			
			Если Строки.Количество() = 0 Тогда
				//Строка = Объект.Протокол.Добавить();
				//Строка.ОбъектМетаданных = СтруктураПоиска.ОбъектМетаданных;
				Продолжить;
			Иначе
				Строка = Строки[0];
			КонецЕсли;
			
			Если Строка.Подписка <> "" Тогда
				Строка.Подписка = Строка.Подписка + Символы.ПС;
			КонецЕсли;
			Строка.Подписка = Строка.Подписка + СтрСоединить(КлючЗначение.Значение, Символы.ПС);
			
		КонецЦикла;
		
		
		// Проверка
		Протокол.Сортировать("ОбъектМетаданных");
		Для Каждого Строка Из Протокол Цикл
			
			Если ЗначениеЗаполнено(Строка.ПланОбмена) Тогда
				Если Строка.Авторегистрация = Истина Тогда
					Строка.ЕстьОшибка = Истина;
					Строка.Описание = НСтр("ru = '2. Нельзя использовать авторегистрацию'");
				КонецЕсли;
				
				Если Строка.ОбновлениеПредопределенныхДанных = "ОбновлятьАвтоматически" Тогда
					Строка.ЕстьОшибка = Истина;
					Строка.Описание = НСтр("ru = '4. Нельзя использовать значение ОбновлятьАвтоматически для реквизита Обновление предопределенных данных'");
				КонецЕсли;
				
				Если Строка.Подписка = "" Тогда
					Если Строка.Авторегистрация = Ложь Тогда
						Строка.ЕстьОшибка = Истина;
						Строка.Описание = НСтр("ru = '5. Объект должен быть включен в подписку регистрации изменений.'");
					КонецЕсли;
				Иначе
					
					ТребуемыеПодписки = ТребуемыеПодпискиРегистрации(Строка.ТипМетаданных);
					Если НЕ ПодпискиРегистрацииВерны(ТребуемыеПодписки, Строка.Подписка) Тогда
						Строка.ЕстьОшибка = Истина;
						Строка.Описание = НСтр("ru = '6. Объект включен не во все обязательные подписки.'");
					КонецЕсли;
					
					ВсегоПодписок = СтрЧислоСтрок(Строка.Подписка);
					Если ВсегоПодписок > ТребуемыеПодписки.Количество() Тогда
						Строка.ЕстьОшибка = Истина;
						Строка.Описание = НСтр("ru = '7. Объект включен в несколько подписок регистрации.'");
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				Строка.ЕстьОшибка = Истина;
				Если Строка.Подписка = "" Тогда
					Строка.Описание = НСтр("ru = '3. Объект должен присутствовать в плане обмена Полный'");
				Иначе
					Строка.Описание = НСтр("ru = '1. Не входит в состав плана обмена'");
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;      
		
	КонецЦикла;
	
	// Всего ошибок
	
КонецПроцедуры

Процедура ВводНаОсновании(МетаданныеДокумент, МассивОснований)
	
	ИмяКонтроля = НСтр("ru = 'ВводНаОсновании'");
	
	ЕстьОшибка = МетаданныеДокумент.ВводитсяНаОсновании.Количество() <> МассивОснований.Количество();
	Если ЕстьОшибка Тогда
		ШаблонСообщения = НСтр("ru = 'Различное кол-во оснований (эталон: %1, фактически: %2)'");
	Иначе
		ШаблонСообщения = НСтр("ru = 'Одинаковое кол-во оснований (эталон: %1, фактически: %2)'");
	КонецЕсли;
	ТекстСообщения = СтрШаблон(ШаблонСообщения, МассивОснований.Количество(), МетаданныеДокумент.ВводитсяНаОсновании.Количество());
	
	ДобавитьЗаписьВПротокол(ИмяКонтроля, МетаданныеДокумент, ЕстьОшибка, ТекстСообщения);
	
	Для Каждого ОбъектМетаданных Из МассивОснований Цикл
		
		Если НЕ МетаданныеДокумент.ВводитсяНаОсновании.Содержит(ОбъектМетаданных) Тогда
			
			ШаблонСообщения = НСтр("ru = 'Отсутствует основание Документ.%1'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбъектМетаданных.Имя);
			
			ДобавитьЗаписьВПротокол(ИмяКонтроля, МетаданныеДокумент, Истина, ТекстСообщения);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры    

Процедура ОпределяемыеТипы(МетаданныеТип, МассивОснований)
	
	ИмяКонтроля = НСтр("ru = 'ОпределяемыеТипы'");  
	
	Для Каждого ОбъектМетаданных Из МассивОснований Цикл
		
		Если НЕ МетаданныеТип.Тип.СодержитТип(ОбъектМетаданных.Значение) Тогда
			
			ШаблонСообщения = НСтр("ru = 'Отсутствует тип %1'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, Строка(ОбъектМетаданных.Ключ));
			
			ДобавитьЗаписьВПротокол(ИмяКонтроля, МетаданныеТип, Истина, ТекстСообщения);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

