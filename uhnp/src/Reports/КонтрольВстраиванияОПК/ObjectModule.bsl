Функция ВерсияПодсистемыРегистра(Знач Результат)
	
	Перем ВерсияРегистра, ВыборкаДетальныеЗаписи, Запрос, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВерсииПодсистем.Версия КАК Версия
	|ИЗ
	|	РегистрСведений.ВерсииПодсистем КАК ВерсииПодсистем
	|ГДЕ
	|	ВерсииПодсистем.ИмяПодсистемы = &ИмяПодсистемы";
	
	Запрос.УстановитьПараметр("ИмяПодсистемы", Результат.ОписаниеОПК.Имя);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВерсияРегистра = ВыборкаДетальныеЗаписи.Версия;    
	Иначе
		ВерсияРегистра = "0.0.0.0";
	КонецЕсли;
	Возврат ВерсияРегистра;

КонецФункции

Функция КоллекцияТиповВРаздел(Знач Результат, Знач Раздел, МетаданныеТипа)
	
	Перем Типы;
	
	Результат[Раздел].Вставить(МетаданныеТипа, Новый Соответствие);
	Типы = Результат[Раздел].Получить(МетаданныеТипа); 
	
	Возврат Типы;

