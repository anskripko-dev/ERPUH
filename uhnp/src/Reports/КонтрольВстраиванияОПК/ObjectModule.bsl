Процедура ДобавитьЗаписьВПротокол(ИмяКонтроля, МетаданныеОбъект, ЕстьОшибка, Описание)
	
	Строка = Протокол.Добавить();
	Строка.Проверка = ИмяКонтроля;
	Если Метаданные.Документы.Содержит(МетаданныеОбъект) Тогда
		Строка.ТипМетаданных = "Документ";
	ИначеЕсли Метаданные.Справочники.Содержит(МетаданныеОбъект) Тогда
		Строка.ТипМетаданных = "Справочник";
	ИначеЕсли Метаданные.ОпределяемыеТипы.Содержит(МетаданныеОбъект) Тогда
		Строка.ТипМетаданных = "ОпределяемыйТип";
	КонецЕсли;
	Строка.ОбъектМетаданных = МетаданныеОбъект.Имя;
	Строка.ЕстьОшибка = ЕстьОшибка;
	Строка.Описание = Описание;
	
