Процедура ЗаполнитьСписокОбъектовПодсистемы(ТаблицаОбъектов, МетаПодсистема, МетаРодительсякаяПодсистема = неопределено)
	
	Если МетаРодительсякаяПодсистема = неопределено Тогда
		РодительсякаяПодсистема = МетаПодсистема;
	Иначе
		РодительсякаяПодсистема = МетаРодительсякаяПодсистема;
	КонецЕсли;
	
	//
	Для Каждого МетаОбъект Из МетаПодсистема.Состав Цикл
		ЕстьОбновлениеПредопределенныхДанных = Ложь;
		Если Метаданные.Константы.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "Константа";
		ИначеЕсли Метаданные.Справочники.Содержит(МетаОбъект)  Тогда
			ТипМетаданных = "Справочник";
			ЕстьОбновлениеПредопределенныхДанных = Истина;
		ИначеЕсли Метаданные.Документы.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "Документ";
		ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МетаОбъект) Тогда
			ЕстьОбновлениеПредопределенныхДанных = Истина;
			ТипМетаданных = "ПланВидовХарактеристик";
		ИначеЕсли Метаданные.ПланыСчетов.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "ПланСчетов";
			ЕстьОбновлениеПредопределенныхДанных = Истина;
		ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МетаОбъект) Тогда
			ЕстьОбновлениеПредопределенныхДанных = Истина;
			ТипМетаданных = "ПланВидовРасчета";
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "РегистрСведений";
		ИначеЕсли Метаданные.РегистрыНакопления.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "РегистрНакопления";
		ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "РегистрБухгалтерии";
		ИначеЕсли Метаданные.РегистрыРасчета.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "РегистрРасчета";
		ИначеЕсли Метаданные.БизнесПроцессы.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "БизнесПроцесс";
		ИначеЕсли Метаданные.Задачи.Содержит(МетаОбъект) Тогда
			ТипМетаданных = "Задача";
		Иначе
			Продолжить;
		КонецЕсли;

		Строка = ТаблицаОбъектов.Добавить();
		Строка.ОбъектМетаданных = МетаОбъект;
		Строка.Расположение = МетаПодсистема;
		Строка.Подсистема = РодительсякаяПодсистема;
		Строка.ТипМетаданных = ТипМетаданных;
		Строка.Имя = МетаОбъект.Имя;
		
		Строка.ПолноеИмя = МетаОбъект.ПолноеИмя();
		
		Если ЕстьОбновлениеПредопределенныхДанных = Истина Тогда
			Строка.ОбновлениеПредопределенныхДанных = Строка(МетаОбъект.ОбновлениеПредопределенныхДанных);
		Иначе
			Строка.ОбновлениеПредопределенныхДанных = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Подсистема Из МетаПодсистема.Подсистемы Цикл
		ЗаполнитьСписокОбъектовПодсистемы(ТаблицаОбъектов, Подсистема, РодительсякаяПодсистема);
	КонецЦикла;
	
КонецПроцедуры    

Функция ТребуемыеПодпискиРегистрации(ТипМетаданных)
	
	ТребуемыеПодписки = Новый Массив;
	Если ТипМетаданных = "Справочник"
		ИЛИ ТипМетаданных = "ПланВидовХарактеристик"
		ИЛИ ТипМетаданных = "ПланСчетов"
		ИЛИ ТипМетаданных = "ПланВидовРасчета"
		ИЛИ ТипМетаданных = "БизнесПроцесс"
		ИЛИ ТипМетаданных = "Задача" Тогда
		ТребуемыеПодписки.Добавить("Регистрация");
		ТребуемыеПодписки.Добавить("РегистрацияУдаления");
	ИначеЕсли ТипМетаданных = "Документ" Тогда
		ТребуемыеПодписки.Добавить("РегистрацияДокумента");
		ТребуемыеПодписки.Добавить("РегистрацияУдаления");
	ИначеЕсли ТипМетаданных = "Константа" Тогда
		ТребуемыеПодписки.Добавить("РегистрацияКонстанты");
	ИначеЕсли ТипМетаданных = "РегистрРасчета" Тогда
		ТребуемыеПодписки.Добавить("РегистрацияНабораРасчета");
	ИначеЕсли ТипМетаданных = "РегистрСведений"
			ИЛИ ТипМетаданных = "РегистрНакопления"
			ИЛИ ТипМетаданных = "РегистрБухгалтерии" Тогда
		ТребуемыеПодписки.Добавить("РегистрацияНабора");
	КонецЕсли;
	
	Возврат ТребуемыеПодписки;
	
КонецФункции

Функция ПодпискиРегистрацииВерны(ТребуемыеПодписки, Подписки)
	
	//
	Результат = Истина;
	Для Каждого Подписка Из ТребуемыеПодписки Цикл
		Результат = Результат И СтрНайти(Подписки, Подписка) <> 0;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьПроверку_СоответствиеОпределяемыхТипов(ОпределяемыеТипыКПроверке)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ОТ_Ссылки");
	Результат.Колонки.Добавить("ОТ_Объекты");
	Результат.Колонки.Добавить("ИмяМетаданных", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Ссылок", ОбщегоНазначения.ОписаниеТипаЧисло(10,0));
	Результат.Колонки.Добавить("Объектов", ОбщегоНазначения.ОписаниеТипаЧисло(10,0));
	
	Для Каждого КлючЗначение Из ОпределяемыеТипыКПроверке Цикл
		
		ОТ_Ссылки = КлючЗначение.Ключ;
		ОТ_Объекты = КлючЗначение.Значение;
		
		Для Каждого ТипСсылка Из КлючЗначение.Ключ.Тип.Типы() Цикл
			ПустаяСсылка = Новый (ТипСсылка);
			Строка = Результат.Добавить();
			Строка.ОТ_Ссылки = ОТ_Ссылки;
			Строка.ОТ_Объекты = ОТ_Объекты;
			Строка.ИмяМетаданных = ПустаяСсылка.Метаданные().ПолноеИмя();
			Строка.Ссылок = 1;
		КонецЦикла;
		Для Каждого ТипСсылка Из КлючЗначение.Значение.Тип.Типы() Цикл
			ПустойОбъект = Новый (ТипСсылка);
			Строка = Результат.Добавить();
			Строка.ОТ_Ссылки = ОТ_Ссылки;
			Строка.ОТ_Объекты = ОТ_Объекты;
			Строка.ИмяМетаданных = ПустойОбъект.Метаданные().ПолноеИмя();
			Строка.Объектов = 1;
		КонецЦикла;
	КонецЦикла;
	
	Результат.Свернуть("ОТ_Ссылки, ОТ_Объекты, ИмяМетаданных", "Ссылок, Объектов");
	
	ШаблонСообщения = НСтр("ru = 'Объект должен присутствовать в ОТ.%1'");
	ШаблонСообщенияОтсутствие = НСтр("ru = 'Объект должен отсутствовать в ОТ.%1'");
	
	Проверка = "Соответствие определяемых типов (Ссылки <-> Объекты)";
	Для Каждого СтрокаРезультат Из Результат Цикл
		
		Строка = Протокол.Добавить(); 
		Строка.Проверка = Проверка;
		
		Массив = СтрРазделить(СтрокаРезультат.ИмяМетаданных, ".");
		
		Строка.ТипМетаданных = Массив[0];
		Строка.ОбъектМетаданных = Массив[1];
		Строка.ЕстьОшибка = СтрокаРезультат.Ссылок <> СтрокаРезультат.Объектов;
		
		Если СтрокаРезультат.Ссылок < СтрокаРезультат.Объектов Тогда
			// в ОТ_Ссылки
			Строка.Описание = СтрШаблон(ШаблонСообщенияОтсутствие, СтрокаРезультат.От_Ссылки.Имя);
		ИначеЕсли СтрокаРезультат.Ссылок > СтрокаРезультат.Объектов Тогда
			// в ОТ_Объекты
			Строка.Описание = СтрШаблон(ШаблонСообщения, СтрокаРезультат.ОТ_Объекты.Имя);
		Иначе
			Строка.Описание = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

