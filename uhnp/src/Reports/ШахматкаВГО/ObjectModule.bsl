
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ЕстьРасчет = ОбщегоНазначенияПовтИспУХ.РассчитыватьРасхожденияПорталаВГО();
	Если ЕстьРасчет Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	Отбор = Новый Структура("ПериодСценария,Сценарий");
	Отбор.Вставить("ПериодСценария", 	ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "ПериодСценария") );
	Отбор.Вставить("Сценарий", 			ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "Сценарий") );
	
	ЭтотОбъект.СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = СверкаВГОУХ.ТекстЗапроса_ОтчетВГО(Отбор, "ПериодСценария");
	
КонецПроцедуры

#КонецЕсли
