#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПериодОтчета = ТиповыеОтчетыУХ.ПолучитьПараметр(КомпоновщикНастроек, "ПериодОтчета").Значение;
	Если НЕ ЗначениеЗаполнено(ПериодОтчета.ДатаНачала) 
		ИЛИ НЕ ЗначениеЗаполнено(ПериодОтчета.ДатаОкончания) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнен период отчета'"));
		Возврат;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	ПоляКомиссии = Новый Массив;
	ПоляКомиссии.Добавить("НачисленноКомиссииПлан");
	ПоляКомиссии.Добавить("УплаченоКомиссииПлан");
	ПоляКомиссии.Добавить("ЗадолженностьКомиссииПлан");
	ПоляКомиссии.Добавить("НачисленноКомиссииФакт");
	ПоляКомиссии.Добавить("УплаченоКомиссииФакт");
	ПоляКомиссии.Добавить("ЗадолженностьКомиссииФакт");	
	
	ВыводитьКомиссии = ТиповыеОтчетыУХ.ПолучитьПараметр(КомпоновщикНастроек, "ВыводитьКомиссии").Значение;
	ТиповыеОтчетыУХ.УстановитьИспользованиеВыбранныхПолей(КомпоновщикНастроек, ПоляКомиссии, ВыводитьКомиссии);

	ПоляШтрафа = Новый Массив;
	ПоляШтрафа.Добавить("НачисленноШтрафыПлан");
	ПоляШтрафа.Добавить("УплаченоШтрафыПлан");
	ПоляШтрафа.Добавить("ЗадолженностьШтрафыПлан");
	ПоляШтрафа.Добавить("НачисленноШтрафыФакт");
	ПоляШтрафа.Добавить("УплаченоШтрафыФакт");
	ПоляШтрафа.Добавить("ЗадолженностьШтрафыФакт");
	
	ВыводитьШтрафы = ТиповыеОтчетыУХ.ПолучитьПараметр(КомпоновщикНастроек, "ВыводитьШтрафы").Значение;
	ТиповыеОтчетыУХ.УстановитьИспользованиеВыбранныхПолей(КомпоновщикНастроек, ПоляШтрафа, ВыводитьШтрафы);
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки(); 
	
	ТиповыеОтчетыУХ.ПолучитьКоллекциюРезультат(СхемаКомпоновкиДанных, Настройки,,ДанныеРасшифровки,,,,ДокументРезультат);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли