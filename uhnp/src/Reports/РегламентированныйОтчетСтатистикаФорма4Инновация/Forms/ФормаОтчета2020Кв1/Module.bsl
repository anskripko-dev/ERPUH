		КонецЕсли;
	КонецЕсли;
	
	Для Стр = 211 По 212 Цикл
		ИмяПоказателя = "";
		Если ЗначениеЗаполнено(ПолеТабличногоДокументаФормаОтчета.Области["П0000200" + Стр + "03"].Значение) Тогда
			ИмяПоказателя = "П0000200" + Стр + "03";
		ИначеЕсли ЗначениеЗаполнено(ПолеТабличногоДокументаФормаОтчета.Области["П0000200" + Стр + "04"].Значение) Тогда
			ИмяПоказателя = "П0000200" + Стр + "04";
