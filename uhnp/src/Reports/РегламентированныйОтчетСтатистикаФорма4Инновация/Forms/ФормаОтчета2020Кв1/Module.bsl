			ИмяПоказателя = "П0000200" + Стр + "05";
		ИначеЕсли ЗначениеЗаполнено(ПолеТабличногоДокументаФормаОтчета.Области["П0000200" + Стр + "06"].Значение) Тогда
			ИмяПоказателя = "П0000200" + Стр + "06";
