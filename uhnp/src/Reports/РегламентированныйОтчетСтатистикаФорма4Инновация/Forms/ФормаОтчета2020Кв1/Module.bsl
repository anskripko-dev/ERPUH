				СтруктураПоиска = Новый Структура("Код", Строка(ПолеТабличногоДокументаФормаОтчета.Области[ИмяПоказателя].Значение));
				МассивВыбора = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(ЭтотОбъект,
					"СправочникЗначимость").ТаблицаЗначений.НайтиСтроки(СтруктураПоиска);
				Если МассивВыбора.Количество() = 1 Тогда
					ПараметрыВыгрузки.Вставить(ИмяПоказателя, МассивВыбора[0].Ключ);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Стр = 1201 По 1211 Цикл
		ИмяПоказателя = "П000120" + Формат(Стр, "ЧГ=") + "03";
		Если ЗначениеЗаполнено(ПолеТабличногоДокументаФормаОтчета.Области[ИмяПоказателя].Значение) Тогда
