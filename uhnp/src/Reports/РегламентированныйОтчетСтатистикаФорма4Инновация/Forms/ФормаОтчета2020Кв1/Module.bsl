&НаКлиенте
Процедура ПолеТабличногоДокументаФормаОтчетаВыбор(Элемент, Область, СтандартнаяОбработка)

	// ПроцессыОбработкиДокументов
	//
	Если Элементы.ПолеТабличногоДокументаФормаОтчета.Защита Тогда
		Возврат;
	КонецЕсли;
	//
	// ПроцессыОбработкиДокументов
	
	Если Найти(Область.Имя, ":") > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	РегламентированнаяОтчетностьКлиент.ОбработкаВыбораПоляОбособленныхПодразделений(
	ЭтотОбъект, Область, СтандартнаяОбработка);
	
	Если Область.Имя = "ОргАдрес" Тогда
		РегламентированнаяОтчетностьКлиент.ОбработкаАдресаВСтатистическомОтчетеJSON(
			ЭтотОбъект, Область, СтандартнаяОбработка);
	ИначеЕсли СтрЧислоВхождений(Область.Имя, "ДобавитьСтроку") > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ДобавитьСтроку("");
	ИначеЕсли СтрЧислоВхождений(Область.Имя, "УдалитьСтроку") > 0 Тогда
		УдалитьСтроку("");
	Иначе
		
		Если Область.Защита Тогда
			Возврат;
		КонецЕсли;
		
		ИмяПарам = Область.Имя;
		
		Если ОбластьДляСправочникаДаНет(ИмяПарам) Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтотОбъект, "СправочникДаНет");
		ИначеЕсли Область.Имя = "П000010010201" Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтотОбъект, "СправочникГруппаСтранГоловнойОрганизации");
		ИначеЕсли ОбластьДляСправочникаВзаимодействие(ИмяПарам) Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтотОбъект, "СправочникВзаимодействие");
		ИначеЕсли Область.Имя = "П000010011201" Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтотОбъект, "СправочникНаиболееВажныйРынокСбыта");
		ИначеЕсли Область.Имя = "П000010011801" Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтотОбъект, "СправочникЧастотаРабот");
		ИначеЕсли СтрНайти(Область.Имя, "П0000200211") = 1 Или СтрНайти(Область.Имя, "П0000200212") = 1 Тогда
			СтандартнаяОбработка = Ложь;
			ЗначСтарое = Область.Значение;
			ИмяОбласти = Лев(Область.Имя, 11);

			Для Гр = 3 По 6 Цикл
				ПолеТабличногоДокументаФормаОтчета.Области[ИмяОбласти + Формат(Гр,"ЧЦ=2; ЧВН=")].Значение = Неопределено;
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(ЗначСтарое) Тогда
				Область.Значение = Число(Прав(Область.Имя, 1)) - 2;
			КонецЕсли;
			Модифицированность = Истина;
			Возврат;
		ИначеЕсли СтрНайти(Область.Имя, "П00004004") = 1 И Число(Сред(Область.Имя, 10, 2)) <= 19 Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтаФорма, "СправочникФакторыПрепятствующие");
		ИначеЕсли СтрНайти(Область.Имя, "П00006006") = 1 И Число(Сред(Область.Имя, 10, 2)) <= 24 Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтаФорма, "СправочникВоздействиеИнновации");
		ИначеЕсли СтрНайти(Область.Имя, "П00008008") = 1 Или СтрНайти(Область.Имя, "П00009009") = 1 Тогда
			ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтаФорма, "СправочникЗначимость");
		ИначеЕсли СтрНайти(Область.Имя, "П00012012") = 1 Тогда
			Если Число(Сред(Область.Имя, 10, 2)) <= 11 Тогда
				ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
					ЭтаФорма, "СправочникЯсностьВопросов");
			ИначеЕсли Число(Сред(Область.Имя, 10, 2)) >= 12 И Число(Сред(Область.Имя, 10, 2)) <= 22 Тогда
				ПараметрВводаПоля = РегламентированнаяОтчетностьКлиентСервер.НайтиСвойстваПоказателя(
				ЭтаФорма, "СправочникТочностьДанных");
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрВводаПоля <> Неопределено И ПараметрВводаПоля.ТаблицаЗначений <> Неопределено Тогда
			КодПоказателя = ПараметрВводаПоля.Показатель;
			ВвестиПоказатель(Элемент, Область, КодПоказателя, Ложь,
				ПараметрВводаПоля.ТекстПриВыборе, ПараметрВводаПоля.ТаблицаЗначений, СтандартнаяОбработка);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбластьДляСправочникаДаНет(ИмяПарам)
	
	Возврат ИмяПарам = "П000010010101"
		Или ИмяПарам = "П000020020103"
		Или ИмяПарам = "П000020020203"
		Или ИмяПарам = "П000020020303"
		Или ИмяПарам = "П000020020403"
		Или ИмяПарам = "П000020020503"
		Или ИмяПарам = "П000020020603"
		Или ИмяПарам = "П000020020703"
		Или ИмяПарам = "П000020020803"
		Или ИмяПарам = "П000020020903"
		Или ИмяПарам = "П000020021003"
		Или	ИмяПарам = "П000030031003"
		Или ИмяПарам = "П000030031103"
		Или ИмяПарам = "П000030031203"
		Или ИмяПарам = "П000060062501"
		Или (СтрНайти(ИмяПарам, "П00011011") = 1 И Число(Сред(ИмяПарам, 10, 2)) <= 17)
		Или (СтрНайти(ИмяПарам, "П00012012") = 1 И Число(Сред(ИмяПарам, 10, 2)) >= 23 И Число(Сред(ИмяПарам, 10, 2)) <= 31);
	
КонецФункции

&НаСервере
Функция ОбластьДляСправочникаВзаимодействие(ИмяПарам)
	
