	Если ЗначениеЗаполнено(ПолеТабличногоДокументаФормаОтчета.Области["П000010011801"].Значение) Тогда
		СтруктураПоиска = Новый Структура("Код", Строка(ПолеТабличногоДокументаФормаОтчета.Области["П000010011801"].Значение));
