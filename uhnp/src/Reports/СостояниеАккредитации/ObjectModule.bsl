#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
	
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	Если ТекущиеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(
				Новый ПараметрКомпоновкиДанных(
						"ДлительностьРассмотренияЗаявкиНаАккредитациюДни"))
		 	= Неопределено Тогда
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
		"ДлительностьРассмотренияЗаявкиНаАккредитациюДни",
		Константы.ДлительностьРассмотренияЗаявкиНаАккредитациюДни.Получить());	
	КонецЕсли;
	
КонецПроцедуры

ДлительностьРассмотренияЗаявкиНаАккредитациюДни =
	Константы.ДлительностьРассмотренияЗаявкиНаАккредитациюДни.Получить();
Для каждого ТекущийВариант Из ЭтотОбъект.СхемаКомпоновкиДанных.ВариантыНастроек Цикл
	Если ТекущийВариант.Настройки.ПараметрыДанных.Элементы.Найти(
			"ДлительностьРассмотренияЗаявкиНаАккредитациюДни") <> Неопределено Тогда
		ТекущийВариант.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
			"ДлительностьРассмотренияЗаявкиНаАккредитациюДни",
			ДлительностьРассмотренияЗаявкиНаАккредитациюДни);
	КонецЕсли;
КонецЦикла;


#КонецЕсли