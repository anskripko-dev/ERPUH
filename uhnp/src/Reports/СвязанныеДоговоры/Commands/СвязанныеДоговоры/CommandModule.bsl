
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
		
	Отбор = Новый Структура("Договор", ПараметрКоманды);
	
	ПараметрыФормы = Новый Структура("Отбор,СформироватьПриОткрытии", 
								Отбор, Истина);
	
	ОткрытьФорму("Отчет.СвязанныеДоговоры.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, 
					Истина, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиКомпоновки(Договор)
	
	Компоновщик = Отчеты.СвязанныеДоговоры.Создать().КомпоновщикНастроек;
	
	НастройкиКомпоновки = Компоновщик.ПолучитьНастройки();
	ТиповыеОтчетыУХ.ДобавитьОтбор(
						НастройкиКомпоновки.Отбор, 
						Новый ПолеКомпоновкиДанных("Договор"),
						Договор,
						ВидСравненияКомпоновкиДанных.ВИерархии,
						Истина);
						
	
	Возврат НастройкиКомпоновки;
    
КонецФункции

