
&НаКлиенте
Процедура Сформировать(Команда)
	ПолучитьСвязиПоказателей();
КонецПроцедуры

&НаСервере
Процедура ПолучитьСвязиПоказателей() Экспорт
	СтруктураДанных = Новый Структура;
	Если СпособСопоставления=1 Тогда
		
		СтруктураДанных.Вставить("ВидОтчета"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ВидОтчетаПриемникПредставление"
												   , "ВидОтчетаПриемник"
												   , Нстр("ru = 'Вид отчета'")));
												   
		СтруктураДанных.Вставить("Детализация1"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ОперандПоказателяПредставление"
												   , "ОперандПоказателя"
												   , Нстр("ru = 'Операнд'")));
												   
		СтруктураДанных.Вставить("Детализация2"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ВидОтчетаИсточникПредставление"
												   , "ВидОтчетаИсточник"
												   , Нстр("ru = 'Связанный Отчет'")));
		СтруктураДанных.Вставить("Детализация3"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ПоказательИсточникПредставление"
												   , "ПоказательИсточник"
												   , Нстр("ru = 'Показатель'")));

		СтруктураДанных.Вставить(?(СпособГруппировки=1, "Группировка1", "Группировка2")
								 , Новый Структура("Наименование, Расшифровка, Имя"
									 				   , "ПоказательПриемникПредставление"
													   , "ПоказательПриемник"
													   , Нстр("ru = 'Показатель'")));
		СтруктураДанных.Вставить(?(СпособГруппировки=1, "Группировка2", "Группировка1")
								 , Новый Структура("Наименование, Расшифровка, Имя"
									 				   , "ПравилоОбработкиПриемникПредставление"
													   , "ПравилоОбработкиПриемник"
													   , Нстр("ru = 'Правило обработки'")));
	Иначе
		
		СтруктураДанных.Вставить("ВидОтчета"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ВидОтчетаИсточникПредставление"
												   , "ВидОтчетаИсточник"
												   , Нстр("ru = 'Вид отчета'")));
												   
		СтруктураДанных.Вставить("Детализация1"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ПоказательПриемникПредставление"
												   , "ПоказательПриемник"
												   , Нстр("ru = 'Показатель'")));
		СтруктураДанных.Вставить("Детализация2"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ПравилоОбработкиПриемникПредставление"
												   , "ПравилоОбработкиПриемник"
												   , Нстр("ru = 'Правило обработки'")));
		СтруктураДанных.Вставить("Детализация3"
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ОперандПоказателяПредставление"
												   , "ОперандПоказателя"
												   , Нстр("ru = 'Операнд'")));
												   

		СтруктураДанных.Вставить(?(СпособГруппировки=1, "Группировка1", "Группировка2")
								 , Новый Структура("Наименование, Расшифровка, Имя"
									 				   , "ПоказательИсточникПредставление"
													   , "ПоказательИсточник"
													   , Нстр("ru = 'Показатель'")));
		СтруктураДанных.Вставить(?(СпособГруппировки=1, "Группировка2", "Группировка1")
								 , Новый Структура("Наименование, Расшифровка, Имя"
								 				   , "ВидОтчетаПриемникПредставление"
													   , "ВидОтчетаПриемник"
													   , Нстр("ru = 'Вид отчета'")));

	КонецЕсли;
	
	ТаблДок = ТабличноеПолеОтчетов;
	ТаблДок.Очистить();
	
	Макет   =Отчеты.ОтчетОСвязяхМеждуОтчетами.ПолучитьМакет("МакетОтчета");
	ТаблДок.Вывести(Макет.ПолучитьОбласть("Заголовок"));

	Запрос  = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РеквизитыИсточниковДанныхДляФормул.ВидОтчета КАК ВидОтчетаПриемник,
	|	РеквизитыИсточниковДанныхДляФормул.ИсточникДанных КАК ОперандПоказателя,
	|	РеквизитыИсточниковДанныхДляФормул.ПотребительРасчета КАК ПоказательПриемник,
	|	ПРЕДСТАВЛЕНИЕ(РеквизитыИсточниковДанныхДляФормул.ПотребительРасчета) КАК ПоказательПриемникПредставление,
	|	ПРЕДСТАВЛЕНИЕ(РеквизитыИсточниковДанныхДляФормул.ВидОтчета) КАК ВидОтчетаПриемникПредставление,
	|	РеквизитыИсточниковДанныхДляФормул.НазначениеРасчетов КАК ПравилоОбработкиПриемник,
	|	ПРЕДСТАВЛЕНИЕ(РеквизитыИсточниковДанныхДляФормул.НазначениеРасчетов) КАК ПравилоОбработкиПриемникПредставление,
	|	РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор КАК ВидОтчетаИсточник,
	|	ПРЕДСТАВЛЕНИЕ(РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор) КАК ВидОтчетаИсточникПредставление,
	|	РеквизитыИсточниковДанныхДляФормул.ПоказательОтбор КАК ПоказательИсточник,
	|	ПРЕДСТАВЛЕНИЕ(РеквизитыИсточниковДанныхДляФормул.ПоказательОтбор) КАК ПоказательИсточникПредставление,
	|	РеквизитыИсточниковДанныхДляФормул.ИсточникДанных.Код КАК ОперандПоказателяПредставление,
	|	ВЫБОР
	|		КОГДА РеквизитыИсточниковДанныхДляФормул.СпособИспользования = ЗНАЧЕНИЕ(Перечисление.СпособыИспользованияОперандов.ДляПримечаний)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОперандыПоказателейПриемникДляПримечаний
	|ИЗ
	|	РегистрСведений.РеквизитыИсточниковДанныхДляФормул КАК РеквизитыИсточниковДанныхДляФормул
	|ГДЕ
	|	НЕ(РеквизитыИсточниковДанныхДляФормул.НеИспользуется
	|				ИЛИ РеквизитыИсточниковДанныхДляФормул.ВидОтчета = ЗНАЧЕНИЕ(Справочник.ВидыОтчетов.ПустаяСсылка)
	|				ИЛИ РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор = ЗНАЧЕНИЕ(Справочник.ВидыОтчетов.ПустаяСсылка)
	|				ИЛИ РеквизитыИсточниковДанныхДляФормул.ИсточникДанных.ПометкаУдаления)";
	
	Если СпособСопоставления=1 Тогда
		
		Запрос.Текст=Запрос.Текст+"	
		|И РеквизитыИсточниковДанныхДляФормул.ВидОтчета В(&ВидыОтчетов)";
		
		Если НЕ ВключатьОтчетыИзОсновногоСписка Тогда
			
			Запрос.Текст=Запрос.Текст+"
			| И (Не РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор В(&ВидыОтчетов))";
			
		КонецЕсли;
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+"	
		|И	РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор В(&ВидыОтчетов)";
		
		Если НЕ ВключатьОтчетыИзОсновногоСписка Тогда
			
			Запрос.Текст=Запрос.Текст+"
			| И (Не РеквизитыИсточниковДанныхДляФормул.ВидОтчета В(&ВидыОтчетов))";
			
		КонецЕсли;
		
	КонецЕсли;
					
	Запрос.Текст = Запрос.Текст + "
	                       |УПОРЯДОЧИТЬ ПО " + СтруктураДанных.ВидОтчета.Расшифровка
	                       + ", " + СтруктураДанных.Группировка1.Расшифровка
					       + ", " + СтруктураДанных.Группировка2.Расшифровка + ", "
						   + " ОперандПоказателя";
						   
	Запрос.УстановитьПараметр("ВидыОтчетов", ОсновныеОтчеты.Выгрузить().ВыгрузитьКолонку("ВидОтчета"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	ОбластьОтчетПриемник      = Макет.ПолучитьОбласть("Отчет");
	ОбластьДетализация        = Макет.ПолучитьОбласть("Детализация");
	
	ОбластьГруппировка1       = Макет.ПолучитьОбласть("Группировка1Заголовок");
	ОбластьГруппировка2       = Макет.ПолучитьОбласть("Группировка2Заголовок");
	
	ОбластьЛегенда            = Макет.ПолучитьОбласть("Легенда");
	ОбластьЛегенда.Параметры.Детализация1 = СтруктураДанных.Детализация1.Имя;
	ОбластьЛегенда.Параметры.Детализация2 = СтруктураДанных.Детализация2.Имя;
	ОбластьЛегенда.Параметры.Детализация3 = СтруктураДанных.Детализация3.Имя;
	
	Линия 		   = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	ЦветПримечания = Новый Цвет(230, 230, 250);
	ЦветПоказателя = Новый Цвет(250, 250, 180);
	
	Пока Выборка.СледующийПоЗначениюПоля(СтруктураДанных.ВидОтчета.Расшифровка) Цикл
		
		ОбластьОтчетПриемник.Параметры.Отчет       = Выборка[СтруктураДанных.ВидОтчета.Наименование];
		ОбластьОтчетПриемник.Параметры.Расшифровка = Выборка[СтруктураДанных.ВидОтчета.Расшифровка];
		
		ТаблДок.Вывести(ОбластьОтчетПриемник);
		ТаблДок.НачатьГруппуСтрок();
		
		ТаблДок.Вывести(ОбластьЛегенда);
				
		Пока Выборка.СледующийПоЗначениюПоля(СтруктураДанных.Группировка1.Расшифровка) Цикл
			
			ОбластьГруппировка1.Параметры.ИмяГруппировки = СтруктураДанных.Группировка1.Имя;
			ОбластьГруппировка1.Параметры.Группировка = Выборка[СтруктураДанных.Группировка1.Наименование];	
			ОбластьГруппировка1.Параметры.ПараметрГруппировка1=Выборка[СтруктураДанных.Группировка1.Расшифровка];

			ТаблДок.Вывести(ОбластьГруппировка1);
			ТаблДок.НачатьГруппуСтрок();
			ТаблДокПравилоОбработки   = Новый ТабличныйДокумент;
			
			Пока Выборка.СледующийПоЗначениюПоля(СтруктураДанных.Группировка2.Расшифровка) Цикл
				
				ОбластьГруппировка2.Параметры.ИмяГруппировки = СтруктураДанных.Группировка2.Имя;
				ОбластьГруппировка2.Параметры.Группировка = Выборка[СтруктураДанных.Группировка2.Наименование];
				
				Если СпособСопоставления=1 Тогда
					
					СтруктураРасшифровки=Новый Структура;
					СтруктураРасшифровки.Вставить("ВидОтчетаПриемник",Выборка.ВидОтчетаПриемник);
					СтруктураРасшифровки.Вставить("ПравилоОбработкиПриемник",Выборка.ПравилоОбработкиПриемник);
					СтруктураРасшифровки.Вставить("ПоказательПриемник",Выборка.ПоказательПриемник);
					ОбластьГруппировка2.Параметры.ПараметрГруппировка2=СтруктураРасшифровки;
					
				Иначе
					
					ОбластьГруппировка2.Параметры.ПараметрГруппировка2=Выборка[СтруктураДанных.Группировка2.Расшифровка];
					
				КонецЕсли;	
				
				ТаблДокПравилоОБработки.Вывести(ОбластьГруппировка2);
				ТаблДокПравилоОбработки.НачатьГруппуСтрок();
				ТаблДокДетализация = Новый ТабличныйДокумент;
				
				Пока Выборка.Следующий() Цикл
					
					ОбластьДетализация.Параметры.Детализация1            = СокрЛП(Выборка[СтруктураДанных.Детализация1.Наименование]);
					ОбластьДетализация.Параметры.Детализация1Расшифровка = Выборка[СтруктураДанных.Детализация1.Расшифровка];
					
					ОбластьДетализация.Параметры.Детализация2	  		 = СокрЛП(Выборка[СтруктураДанных.Детализация2.Наименование]);
					
					Если СпособСопоставления=1 Тогда
						
						ОбластьДетализация.Параметры.Детализация2Расшифровка = Выборка[СтруктураДанных.Детализация2.Расшифровка];
						
					Иначе
						
						СтруктураРасшифровки=Новый Структура;
						СтруктураРасшифровки.Вставить("ВидОтчетаПриемник",Выборка.ВидОтчетаПриемник);
						СтруктураРасшифровки.Вставить("ПравилоОбработкиПриемник",Выборка.ПравилоОбработкиПриемник);
						СтруктураРасшифровки.Вставить("ПоказательПриемник",Выборка.ПоказательПриемник);
						ОбластьДетализация.Параметры.Детализация2Расшифровка=СтруктураРасшифровки;
						
					КонецЕсли;
		
					ОбластьДетализация.Параметры.Детализация3 		   	 = СокрЛП(Выборка[СтруктураДанных.Детализация3.Наименование]);
					ОбластьДетализация.Параметры.Детализация3Расшифровка = Выборка[СтруктураДанных.Детализация3.Расшифровка];
					
					
					ОбластьВывода = ТаблДокДетализация.Вывести(ОбластьДетализация);
					
					Если Выборка.ОперандПоказателя = NULL Тогда
						ОбластьВывода.Узор      = ТипУзораТабличногоДокумента.Узор17;
						ОбластьВывода.ЦветУзора = Новый Цвет(230, 225, 245);
					КонецЕсли;
					
				КонецЦикла;
				
				ТаблДокПравилоОбработки.Вывести(ТаблДокДетализация);
				ТаблДокПравилоОбработки.Вывести(Макет.ПолучитьОбласть("ПодвалТаблицы"));
			   	ТаблДокПравилоОбработки.ЗакончитьГруппуСтрок();
			КонецЦикла;
			
			ТаблДок.Вывести(ТаблДокПравилоОбработки);
            ТаблДок.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ТаблДок.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
	
	ТаблДок.ПоказатьУровеньГруппировокСтрок(2);
	
КонецПроцедуры


&НаКлиенте
Процедура СпособСопоставленияПриИзменении(Элемент)
	 Элементы.СпособГруппировки.СписокВыбора[1].Представление = ?(СпособСопоставления=1, Нстр("ru = 'Правилу обработки'"), Нстр("ru = 'Виду отчета'"));
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.МассивВидовОтчетов)=Тип("Массив") Тогда
		
		Для Каждого ВидОтчета ИЗ Параметры.МассивВидовОтчетов Цикл
			
			НоваяСтрока=ОсновныеОтчеты.Добавить();
			НоваяСтрока.ВидОтчета=ВидОтчета;
			
		КонецЦикла;
		
		СпособСопоставления=Параметры.СпособСопоставления;
		СпособГруппировки=Параметры.СпособГруппировки;
		
		Если Не ПустаяСтрока(Параметры.ТекстСообщения) Тогда
			
			Элементы.ДекорацияСообщение.Заголовок=Параметры.ТекстСообщения;
			Элементы.ДекорацияСообщение.Видимость=Истина;
			
		КонецЕсли;
		
		ПолучитьСвязиПоказателей();
		
	Иначе
		
		СпособГруппировки=1;
		СпособСопоставления=1;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельОтчетовПоЭтапуПроцесса(Кнопка)
	
	ЭтапПроцесса = Неопределено;
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработатьВыборЭтапаПроцесса", ЭтотОбъект);
	ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.ФормаВыбора",
					, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Заполняет таблицу отчетов по основанию заполнения ОснованиеЗаполненияВход,
// задавая пользователю вопрос о необходимости очистить таблицу, если она не пуста.
&НаКлиенте
Процедура ОчиститьЗаполнитьОтчеты(ОснованиеЗаполненияВход)
	Если ОсновныеОтчеты.Количество() <> 0 Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ОснованиеЗаполненияВход", ОснованиеЗаполненияВход);
		ТекстВопроса = НСтр("ru = 'Поле отборов не пустое. Очистить?'");
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ОчиститьЗаполнитьПодтверждение_Завершение", ЭтаФорма, СтруктураПараметров);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	Иначе
		ЗаполнитьТаблицуОтборов(ОснованиеЗаполненияВход);
	КонецЕсли;
КонецПроцедуры

