Процедура ЗаполнитьТаблицуОтборов(Параметр)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Параметр);	
	Запрос.УстановитьПараметр("ОтборОтчетов", РеквизитФормыВЗначение("ОсновныеОтчеты").ВыгрузитьКолонку("ВидОтчета"));
	
	Если ТипЗнч(Параметр) = Тип("СправочникСсылка.ЭтапыУниверсальныхПроцессов") Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента КАК Отчет
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов.ФормируемыеДокументы КАК ЭтапыПроцессовФормируемыеДокументы
		|ГДЕ
		|	ЭтапыПроцессовФормируемыеДокументы.Ссылка = &Ссылка
		|	И НЕ ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента В (&ОтборОтчетов)";
					   
		ВнестиДанныеВТабличноеПоле(Запрос.Выполнить().Выгрузить());
		
	ИначеЕсли ТипЗнч(Параметр) = Тип("СправочникСсылка.ШаблоныУниверсальныхПроцессов") Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента КАК Отчет
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов.ФормируемыеДокументы КАК ЭтапыПроцессовФормируемыеДокументы
		|ГДЕ
		|	ЭтапыПроцессовФормируемыеДокументы.Ссылка.Владелец = &Ссылка
		|	И НЕ ЭтапыПроцессовФормируемыеДокументы.ШаблонДокумента В (&ОтборОтчетов)";
					   
		ВнестиДанныеВТабличноеПоле(Запрос.Выполнить().Выгрузить());
		
	ИначеЕсли ТипЗнч(Параметр) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВидыОтчетов.Ссылка КАК Отчет
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	ВидыОтчетов.Ссылка В ИЕРАРХИИ(&Ссылка)
		|	И НЕ ВидыОтчетов.Ссылка В (&ОтборОтчетов)
		|	И ВидыОтчетов.ЭтоГруппа = ЛОЖЬ";
					   
		ВнестиДанныеВТабличноеПоле(Запрос.Выполнить().Выгрузить());

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВнестиДанныеВТабличноеПоле(ТЗОтчетов)
	
	Если ТипЗнч(ТЗОтчетов) = Тип("ТаблицаЗначений") Тогда
		// Добавим в таблицу отчеты, которых ещё там нет.
		Для Каждого Элемент Из ТЗОтчетов Цикл
			ТекЭлементОтчет = Элемент.Отчет;
			Если (ЗначениеЗаполнено(ТекЭлементОтчет)) И (ТипЗнч(ТекЭлементОтчет) = Тип("СправочникСсылка.ВидыОтчетов")) Тогда
				СтруктураПоиска = Новый Структура("ВидОтчета", ТекЭлементОтчет);
				НайденныеСтроки = ОсновныеОтчеты.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() = 0 Тогда
					ОсновныеОтчеты.Добавить().ВидОтчета = ТекЭлементОтчет;
				КонецЕсли;
			Иначе
				// Отчет не заполнен. Пропускаем.
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТабличноеПолеОтчетовОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка)=Тип("Структура") Тогда
		
		СтандартнаяОбработка=Ложь;
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("ВидОтчета",Расшифровка.ВидОтчетаПриемник);
		СтруктураПараметров.Вставить("НазначениеРасчетов",Расшифровка.ПравилоОбработкиПриемник);
		СтруктураПараметров.Вставить("ОбновлятьОбъект",Истина);
		СтруктураПараметров.Вставить("ПотребительРасчета",Расшифровка.ПоказательПриемник);
		СтруктураПараметров.Вставить("СпособИспользования",ПредопределенноеЗначение("Перечисление.СпособыИспользованияОперандов.ДляФормулРасчета"));
		
		ОткрытьФорму("ОбщаяФорма.ФормаНастройкиФормулРасчета",СтруктураПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

