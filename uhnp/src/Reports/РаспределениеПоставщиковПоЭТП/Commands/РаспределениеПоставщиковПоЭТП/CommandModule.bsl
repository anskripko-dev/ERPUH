
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Параметры = ПолучитьПараметры(ПараметрКоманды);
	
	Отбор = Новый Структура;
	Отбор.Вставить("АнкетаПоставщика", Параметры.МассивАнкет);
	
	ПараметрыФормы = Новый Структура("Отбор, СформироватьПриОткрытии", Отбор, Истина);
	
	ОткрытьФорму("Отчет.РаспределениеПоставщиковПоЭТП.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметры(Параметр)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОповещениеАккредитованныхПоставщиковОТоргахПоставщики.АнкетаПоставщика КАК АнкетаПоставщика
		|ИЗ
		|	Документ.ОповещениеАккредитованныхПоставщиковОТоргах.Поставщики КАК ОповещениеАккредитованныхПоставщиковОТоргахПоставщики
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(&Документ) = ТИП(Справочник.ЗакупочныеПроцедуры)
		|				ТОГДА ОповещениеАккредитованныхПоставщиковОТоргахПоставщики.Ссылка В
		|						(ВЫБРАТЬ
		|							ОповещениеАккредитованныхПоставщиковОТоргах.Ссылка КАК Ссылка
		|						ИЗ
		|							Документ.ОповещениеАккредитованныхПоставщиковОТоргах КАК ОповещениеАккредитованныхПоставщиковОТоргах
		|						ГДЕ
		|							ОповещениеАккредитованныхПоставщиковОТоргах.ЗакупочнаяПроцедура = &Документ)
		|			ИНАЧЕ ОповещениеАккредитованныхПоставщиковОТоргахПоставщики.Ссылка = &Документ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Документ", Параметр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//ДатаОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметр, "Дата");
	
	Возврат Новый Структура("МассивАнкет", РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("АнкетаПоставщика"));

КонецФункции
