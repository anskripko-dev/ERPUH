
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ.
//

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Перем КодПоказателя;
	
	Отчет.ОтображатьАналитику   = Ложь;
	
	Отчет.КоличествоУровней     = 0;
	Отчет.ЦветВыделеннойЛинии   = Новый Цвет(125, 0, 0);
	Отчет.ЦветОшибки            = Новый Цвет(125, 10, 10);
	Отчет.ЦветЦиклическойСсылки = Новый Цвет(250, 0, 0);

	
	Отчет.ВысотаПоказателя_Расчетная = 30;
	Отчет.ШиринаПоказателя           = 34;
	Отчет.ШиринаОтступа	 		   = 4;
	Отчет.ВысотаОтступа	           = 4;
	Отчет.ШиринаИзгиба	           = 1.2;
	Отчет.ВысотаСтрокиТекста         = Отчет.ВысотаПоказателя_Расчетная / 2;
	
	Отчет.ЦветВычисляемогоПоказателя = Новый Цвет(208, 255, 192);
	Отчет.ЦветЗаполняемогоПоказателя = Новый Цвет(255, 248, 224);
	
	Отчет.ЦветУзораВычисляемогоПоказателя = Новый Цвет(180, 255, 160);
	Отчет.ЦветУзораЗаполняемогоПоказателя = Новый Цвет(255, 240, 192);
	
	Отчет.ЦветЛинииВычисляемогоПоказателя = Новый Цвет(0, 128, 0);
	Отчет.ЦветЛинииЗаполняемогоПоказателя = Новый Цвет(128, 0, 0);

	
	Параметры.Свойство("ВидОтчета", Отчет.ВидОтчета);
	Параметры.Свойство("КодПоказателя", КодПоказателя);
	Параметры.Свойство("ПравилоОбработки", Отчет.ПравилоОбработки);

	Если ЗначениеЗаполнено(КодПоказателя) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ПоказателиОтчетов.Ссылка
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.Владелец = &Владелец
		|	И ПоказателиОтчетов.Код = &Код
		|	И (НЕ ПоказателиОтчетов.ПометкаУдаления)";
		
		Запрос.УстановитьПараметр("Владелец", Отчет.ВидОтчета);
		Запрос.УстановитьПараметр("Код"     , СокрЛП(КодПоказателя));
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			
			Отчет.Показатель=Результат.Ссылка;
			ЗаполнитьТаблицуПоказателей();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ЗаполнитьЗначенияСвойств(Отчет, ВыбранноеЗначение);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ.
//

&НаКлиенте
Процедура Сформировать(Команда)
	
	ЗаполнитьТаблицуПоказателей();
	
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	
	ОткрытьФорму("Отчет.ДеревоПоказателей.Форма.ФормаНастройки", 
					Новый Структура("КоличествоУровней, ОтображатьАналитику, ЦветЦиклическойСсылки, ЦветОшибки, ЦветВыделеннойЛинии"
													  , Отчет.КоличествоУровней
													  , Отчет.ОтображатьАналитику
													  , Отчет.ЦветЦиклическойСсылки
													  , Отчет.ЦветОшибки
													  , Отчет.ЦветВыделеннойЛинии)
					, ЭтаФорма);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Выделить(Команда)
	
	ТекОбласть = ПолеТабличногоДокументаПоказателей.ТекущаяОбласть;
	Если ТипЗнч(ТекОбласть) = Тип("РисунокТабличногоДокумента") 
	   И ТекОбласть.ТипРисунка = ТипРисункаТабличногоДокумента.Прямая Тогда
	   
		ТекЭлементы = Отчет.ТаблицаСвязей.НайтиСтроки(Новый Структура("ИмяЛинии", ТекОбласть.Имя));
		
		Если ТекЭлементы.Количество() > 0  Тогда
			
			ТекЭлемент = ТекЭлементы[0]; 
			МассивЭлементов=Отчет.ТаблицаСвязей.НайтиСтроки(Новый Структура("ИндексСвязи", ТекЭлемент.ИндексСвязи));
			
			Для Индекс=0 По МассивЭлементов.Количество()-1  Цикл
				
				Элемент=МассивЭлементов[Индекс];
				ПолеТабличногоДокументаПоказателей.Рисунки[Элемент.ИмяЛинии].ЦветЛинии = ?(ПолеТабличногоДокументаПоказателей.Рисунки[Элемент.ИмяЛинии].ЦветЛинии = Отчет.ЦветВыделеннойЛинии
																										 , Новый Цвет(ТекЭлемент.Цвет_Красный, ТекЭлемент.Цвет_Синий, ТекЭлемент.Цвет_Зеленый), Отчет.ЦветВыделеннойЛинии);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолеТабличногоДокументаМакетОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Перем ИмяФормыРасшифровки;
	
	СтандартнаяОбработка = Ложь;
	
	РасшифровкаВидомОтчета = (ТипЗнч(Расшифровка) = Тип("СправочникСсылка.ВидыОтчетов"));
	РасшифровкаПоказателемОтчета = (ТипЗнч(Расшифровка) = Тип("СправочникСсылка.ПоказателиОтчетов"));
	Если РасшифровкаВидомОтчета ИЛИ РасшифровкаПоказателемОтчета Тогда
		СтруктураОтвета = ВернутьНастройкиРасшифровки(Расшифровка, ИмяФормыРасшифровки);
		Если СтруктураОтвета <> Неопределено Тогда
			ОткрытьФорму(ИмяФормыРасшифровки, СтруктураОтвета);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАПОЛНЕНИЯ ТАБЛИЦЫ ПОКАЗАТЕЛЕЙ.

// Процедура рассчитывает уровень показателя по оси Х.
//
&НаСервере
Процедура РассчитатьУровеньX(СтрокаПоказателя, Показатели)
	
	Если Не СтрокаПоказателя.УровеньХ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаПоказателя.ПоказателиПредшественники.Колонки.Найти("СтрокаПоказателяПредшественника")=Неопределено Тогда
		
		СтрокаПоказателя.ПоказателиПредшественники.Колонки.Добавить("СтрокаПоказателяПредшественника");
		
	КонецЕсли;
	
	Если СтрокаПоказателя.ПоказателиПредшественники.Количество()>0 Тогда
		МаксУровень = 0;
		
		Для Индекс=0 По СтрокаПоказателя.ПоказателиПредшественники.Количество()-1 Цикл
			
			СтрокаПредшественника=СтрокаПоказателя.ПоказателиПредшественники[Индекс];
			
			СтрокаПредшественника.СтрокаПоказателяПредшественника = Показатели.Найти(СтрокаПредшественника.УникальныйИдентификатор, "УникальныйИдентификатор");
			РассчитатьУровеньX(СтрокаПредшественника.СтрокаПоказателяПредшественника, Показатели);
			МаксУровень = Макс(МаксУровень, ?(СтрокаПредшественника.СтрокаПоказателяПредшественника.УровеньХ=Неопределено,0,СтрокаПредшественника.СтрокаПоказателяПредшественника.УровеньХ));
			
		КонецЦикла;
		
		СтрокаПоказателя.УровеньХ = МаксУровень + 1;
		
	Иначе
		
		СтрокаПоказателя.УровеньХ = 0;
		
	КонецЕсли;
	
КонецПроцедуры

// Функция определяет допустимую позицию по оси Y.
//
&НаСервере
Функция ОпределитьНовуюПозициюВУровнеY(СтрокаПоказателя, ЗанятыеУровниПоУ, Предпочтение = Неопределено)
	
	Если Не Предпочтение = Неопределено и ПолучитьДанныеУровня(ЗанятыеУровниПоУ,Предпочтение) = Неопределено Тогда
		Результат = Предпочтение;
	Иначе
		Результат = 0;
		
		Пока Не ПолучитьДанныеУровня(ЗанятыеУровниПоУ,Результат) = Неопределено Цикл
			Результат = Результат + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	ДобавитьВТаблицуУровней(ЗанятыеУровниПоУ,Результат,Истина);
	
	Возврат Результат;
	
КонецФункции

// Функция проверяет операнд на соответствие отборов текущему срезу данных.
//
&НаСервере
Функция ПроверитьНаСоответствиеОтборов(Операнд)
	
	Если Операнд = Справочники.ИсточникиДанныхДляРасчетов.ПустаяСсылка() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Отбор_ПериодОтчета = Операнд.ТаблицаПараметровОтбораБД.Найти("Версия.ПериодОтчета", "ПолеБД");
	СрезСоответствует  = Истина;
	
	Если ЗначениеЗаполнено(Отбор_ПериодОтчета) Тогда
		СрезСоответствует = Отбор_ПериодОтчета.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Отбор_СценарийОтчета = Операнд.ТаблицаПараметровОтбораБД.Найти("Версия.Сценарий", "ПолеБД");
	
	Если ЗначениеЗаполнено(Отбор_СценарийОтчета) И СрезСоответствует Тогда
		СрезСоответствует = Отбор_СценарийОтчета.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СценарийОтчета;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СрезСоответствует;
	
КонецФункции

// Процедра заполняет таблицу дочерних показателей мПоказатели.
//
&НаСервере
Процедура ПолучитьТаблицуДочернихПоказателей(мТаблицаПоказателей, ТекстЗапроса, СтрокаРодитель, ПравилоОбработки, Знач МассивПоказателей, Знач ТекУровень)
	
	ТекМассивПоказателей = Новый Массив;
	ТекМассивПоказателей = МассивПоказателей;
	
	Если ЗначениеЗаполнено(Отчет.КоличествоУровней) И Отчет.КоличествоУровней > 0 И ТекУровень > Отчет.КоличествоУровней Тогда
		Возврат; // Достигнут максимальный уровень.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Показатель", СтрокаРодитель.Показатель);
	Запрос.УстановитьПараметр("ПравилоОбработки", ПравилоОбработки);
	ТаблицаПоказателей = Запрос.Выполнить().Выгрузить();
	
	Для Индекс=0 По ТаблицаПоказателей.Количество()-1 Цикл
		
		СтрокаТаблицы=ТаблицаПоказателей[Индекс];
		
		ДочерниеПоказатели     = мТаблицаПоказателей.НайтиСтроки(Новый Структура("Показатель, ВидОтчета, Операнд, Ошибка"
																				 , СтрокаТаблицы.Показатель
																				 , СтрокаТаблицы.ВидОтчета
																				 , СтрокаТаблицы.Операнд, Ложь));
																				 
		ПоказательДругогоСреза = НЕ ПроверитьНаСоответствиеОтборов(СтрокаТаблицы.Операнд);
		
		Если ДочерниеПоказатели.Количество() = 0 ИЛИ  ПоказательДругогоСреза Тогда
			
			НоваяСтрока 						  = мТаблицаПоказателей.Добавить();
			НоваяСтрока.Родитель 				  = СтрокаРодитель.Показатель;
			НоваяСтрока.Показатель 				  = СтрокаТаблицы.Показатель;
			
			Для Инд = 1 По Отчет.ЧислоАналитик Цикл
				НоваяСтрока["ВидАналитики" + Инд]           = Отчет.Показатель.ГруппаРаскрытия["ВидАналитики" + Инд];
			КонецЦикла;

			НоваяСтрока.Операнд                   = СтрокаТаблицы.Операнд;
			НоваяСтрока.ВидОтчета 				  = СтрокаТаблицы.ВидОтчета;
			НоваяСтрока.ПравилоОбработки          = СтрокаТаблицы.ПравилоОбработки;
			НоваяСтрока.ПоказательДругогоСреза    = ПоказательДругогоСреза;
			
			Для Инд = 1 По Отчет.ЧислоАналитик Цикл
				НоваяСтрока["ВидАналитики" + Инд] = СтрокаТаблицы["ВидАналитики" + Инд];
			КонецЦикла;
			
			НоваяСтрока.УникальныйИдентификатор   = Новый УникальныйИдентификатор;
			НоваяСтрока.ПоказателиПредшественники = Новый ТаблицаЗначений;
			НоваяСтрока.ПоказателиПредшественники.Колонки.Добавить("УникальныйИдентификатор");
			НоваяСтрока.ПоказателиПредшественники.Добавить().УникальныйИдентификатор = СтрокаРодитель.УникальныйИдентификатор;
			НоваяСтрока.Ошибка                    = Ложь;
			
			Если НЕ ПоказательДругогоСреза Тогда
				ТекМассивПоказателей.Добавить(НоваяСтрока.УникальныйИдентификатор);
				ВремМассив = Новый Массив;
				Для ИндексВ=0 По ТекМассивПоказателей.Количество()-1 Цикл 
					
					Элемент=ТекМассивПоказателей[ИндексВ];
					
					ВремМассив.Добавить(Элемент);
				КонецЦикла;
				ПолучитьТаблицуДочернихПоказателей(мТаблицаПоказателей, ТекстЗапроса, НоваяСтрока,
					Справочники.ВидыОтчетов.ЗначениеНастройкиПоУмолчанию(СтрокаТаблицы.ВидОтчета, "ПравилоОбработки"),
					ВремМассив, ТекУровень + 1);
			КонецЕсли;
			
		Иначе
			Для ИндексВ=0 По ДочерниеПоказатели.Количество()-1 Цикл
				
				ТекПоказатель=ДочерниеПоказатели[ИндексВ];
				
				Если ТипЗнч(ТекПоказатель.ПоказателиПредшественники) <> Тип("ТаблицаЗначений") Тогда
					ТекПоказатель.ПоказателиПредшественники = Новый ТаблицаЗначений;
					ТекПоказатель.ПоказателиПредшественники.Колонки.Добавить("УникальныйИдентификатор");
				КонецЕсли;
				
				Если ТекМассивПоказателей.Найти(ТекПоказатель.УникальныйИдентификатор) <> Неопределено Тогда
					Если СтрокаРодитель.УникальныйИдентификатор = ТекПоказатель.УникальныйИдентификатор Тогда
						ТекПоказатель.Ошибка = Истина;
					Иначе
						НоваяСтрока 						  = мТаблицаПоказателей.Добавить();
						НоваяСтрока.Родитель 				  = СтрокаРодитель.Показатель;
						НоваяСтрока.Показатель 				  = СтрокаТаблицы.Показатель;
						НоваяСтрока.Операнд                   = СтрокаТаблицы.Операнд;
						НоваяСтрока.ВидОтчета 				  = СтрокаТаблицы.ВидОтчета;
						НоваяСтрока.ПравилоОбработки          = СтрокаТаблицы.ПравилоОбработки;
						НоваяСтрока.ПоказательДругогоСреза    = ПоказательДругогоСреза;
						НоваяСтрока.УникальныйИдентификатор   = Новый УникальныйИдентификатор;
						НоваяСтрока.ПоказателиПредшественники = Новый ТаблицаЗначений;
						НоваяСтрока.Ошибка                    = Истина;
						НоваяСтрока.ПоказателиПредшественники.Колонки.Добавить("УникальныйИдентификатор");
						НоваяСтрока.ПоказателиПредшественники.Добавить().УникальныйИдентификатор = ТекПоказатель.УникальныйИдентификатор;
						СтрокаРодитель.ПоказателиПредшественники.Добавить().УникальныйИдентификатор = НоваяСтрока.УникальныйИдентификатор;
					КонецЕсли;
					
				Иначе
					ТекПоказатель.ПоказателиПредшественники.Добавить().УникальныйИдентификатор = СтрокаРодитель.УникальныйИдентификатор;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла
	
КонецПроцедуры

// Процедура отображает диаграмму показателей.
//
&НаСервере
Процедура ВывестиДиаграммуПоказателей(ТаблицаПоказателей, Уровни)
	
	Отчет.ВысотаПоказателя = Отчет.ВысотаПоказателя_Расчетная + ?(Отчет.ОтображатьАналитику, Отчет.ВысотаСтрокиТекста, 0);
	
	ПолеТабличногоДокументаПоказателей.Очистить();
	Макет = Отчеты.ДеревоПоказателей.ПолучитьМакет("Макет");
	ПолеТабличногоДокументаПоказателей.Вывести(Макет.ПолучитьОбласть("Заголовок"));
	
	ВысотаЗаголовка = ПолеТабличногоДокументаПоказателей.ВысотаТаблицы + Отчет.ВысотаОтступа;
	ТабличныйДокумент = ПолеТабличногоДокументаПоказателей;
	
	ИндексСвязи       = 0;
	Отчет.ТаблицаСвязей.Очистить();
	
	ВерхПоказателя = Отчет.ВысотаОтступа;
	Для Индекс=0 По Уровни.Х.Количество()-1 Цикл
		
		СтруктураХ=Уровни.Х[Индекс];
		
		Если СтруктураХ.Ключ Тогда
			ВерхПоказателя = ВерхПоказателя + Макс(СтруктураХ.Значение.ОтступХ + 1, 2) * Отчет.ВысотаОтступа + Отчет.ВысотаПоказателя;
		КонецЕсли;
		
		СтруктураХ.Значение.Вставить("ВерхПоказателя", ВерхПоказателя);
	КонецЦикла;
	
	ЛевоПоказателя = Отчет.ШиринаОтступа;
	
	Для Индекс=0 По Уровни.У.Количество()-1 Цикл
		
		СтруктураУ=Уровни.У[Индекс];
		
		Если СтруктураУ.Ключ Тогда
			ЛевоПоказателя = ЛевоПоказателя + Макс(ПолучитьДанныеУровня(Уровни.У,СтруктураУ.Ключ - 1).ОтступУ + 1, 1) * Отчет.ШиринаОтступа + Отчет.ШиринаПоказателя;
		КонецЕсли;
		
			СтруктураУ.Значение.Вставить("ЛевоПоказателя", ЛевоПоказателя);
	КонецЦикла;
	
	Для Индекс=0 По Уровни.Х.Количество()-1 Цикл
		
		СтруктураХ=Уровни.Х[Индекс];
		СтрокиУровня = ТаблицаПоказателей.НайтиСтроки(Новый Структура("УровеньХ", СтруктураХ.Ключ));
		
		Для ИндексВ=0 По СтрокиУровня.Количество()-1 Цикл
			
			СтрокаПоказателя=СтрокиУровня[ИндексВ];
			
			ЦветЛинии = ?(СтрокаПоказателя.ПоказательДругогоСреза, Отчет.ЦветЦиклическойСсылки, Новый Цвет(0, 0, 0));
			НарисоватьСвязи(ТаблицаПоказателей, ТабличныйДокумент, СтрокаПоказателя, Уровни, ЦветЛинии, ИндексСвязи);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Индекс=0 По Уровни.Х.Количество()-1 Цикл
		
		СтруктураХ=Уровни.Х[Индекс];
		
		СтрокиУровня = ТаблицаПоказателей.НайтиСтроки(Новый Структура("УровеньХ", СтруктураХ.Ключ));
		
		Для ИндексУровня=0 По СтрокиУровня.Количество()-1 Цикл
			
			СтрокаПоказателя=СтрокиУровня[ИндексУровня];
			
			НарисоватьПоказатель(ТабличныйДокумент, СтрокаПоказателя, Уровни);

		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьТаблицуУровней()
	
	ТаблицаУровней=Новый ТаблицаЗначений;
	ТаблицаУровней.Колонки.Добавить("Ключ");
	ТаблицаУровней.Колонки.Добавить("Значение");
	
	Возврат ТаблицаУровней;	
	
КонецФункции // ПодготовитьТаблицуУровней()

// Процедура рисует показатель на поле табличного документа
//
&НаСервере
Процедура НарисоватьПоказатель(ТабличныйДокумент, СтрокаПоказателя, Уровни, ЦветПоказателя = Неопределено)
	
	ЛевоПоказателя = ПолучитьДанныеУровня(Уровни.У,СтрокаПоказателя.УровеньУ).ЛевоПоказателя;
	ВерхПоказателя = ПолучитьДанныеУровня(Уровни.Х,СтрокаПоказателя.УровеньХ).ВерхПоказателя + Отчет.ВысотаЗаголовка;
	
	Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямоугольник);
	Рисунок.ЦветФона  = Новый Цвет(192, 192, 192);
	Рисунок.ЦветЛинии = Новый Цвет(192, 192, 192);
	Рисунок.Лево      = ЛевоПоказателя + 1;
	Рисунок.Верх      = ВерхПоказателя + 1;
	Рисунок.Ширина    = Отчет.ШиринаПоказателя + 1;
	Рисунок.Высота    = Отчет.ВысотаПоказателя + 1;
	Рисунок.Линия     = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Точечная, 1);

	
	Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямоугольник);
	Рисунок.Лево = ЛевоПоказателя;
	Рисунок.Верх = ВерхПоказателя;
	Рисунок.Ширина = Отчет.ШиринаПоказателя;
	Рисунок.Высота = Отчет.ВысотаПоказателя;
	Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Точечная, 1);
	
	Если СтрокаПоказателя.Ошибка Тогда
		ЦветФона  = Отчет.ЦветОшибки;
		ЦветУзора = Отчет.ЦветОшибки;
	Иначе
		ЦветФона  = Отчет.ЦветЗаполняемогоПоказателя;
		ЦветУзора = Отчет.ЦветУзораЗаполняемогоПоказателя;
	КонецЕсли;

	ЦветПоказателя = ?(СтрокаПоказателя.ПоказательДругогоСреза, Отчет.ЦветЦиклическойСсылки,
					   Отчет.ЦветЛинииЗаполняемогоПоказателя);
	
	Расшифровка = СтрокаПоказателя.ВидОтчета;				
	Текст = СтрокаПоказателя.ВидОтчета.Наименование; 
	Рисунок = РисованиеГрафиковУХ.НарисоватьТекст(ТабличныйДокумент, Текст, Расшифровка, ЛевоПоказателя, ВерхПоказателя, Отчет.ШиринаПоказателя, Отчет.ВысотаСтрокиТекста, ЦветФона, ЦветУзора, ЦветПоказателя);
	Рисунок.Шрифт = Новый Шрифт(Рисунок.Шрифт, , 8, Истина);
	Рисунок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить; 
	
	Расшифровка = СтрокаПоказателя.Показатель;			
	Текст = "" + СтрокаПоказателя.Показатель.Наименование;
	Если СтрокаПоказателя.Ошибка Тогда
		Текст = СтрШаблон(Нстр("ru = 'Обнаружен циклический вызов показателя:%1'"), Текст);
	КонецЕсли;
	
	Рисунок = РисованиеГрафиковУХ.НарисоватьТекст(ТабличныйДокумент, Текст, Расшифровка, ЛевоПоказателя, ВерхПоказателя + Отчет.ВысотаСтрокиТекста, Отчет.ШиринаПоказателя, Отчет.ВысотаСтрокиТекста, ЦветФона, ЦветУзора, ЦветПоказателя);
	Рисунок.Шрифт = Новый Шрифт(Рисунок.Шрифт, , 8, Истина);
	Рисунок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	Текст = "";
	Если Отчет.ОтображатьАналитику Тогда
		
		Для Инд =1 По Отчет.ЧислоАналитик Цикл
			Если ЗначениеЗаполнено(СтрокаПоказателя["ВидАналитики" + Инд]) Тогда
				Текст = Текст + СтрокаПоказателя["ВидАналитики" + Инд] + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		
		Если ПустаяСтрока(Текст) Тогда
			Текст = Нстр("ru = 'Нет аналитик'");
		КонецЕсли;
		Рисунок = РисованиеГрафиковУХ.НарисоватьТекст(ТабличныйДокумент, Текст, Неопределено, ЛевоПоказателя , ВерхПоказателя + Отчет.ВысотаПоказателя_Расчетная, Отчет.ШиринаПоказателя, Отчет.ВысотаСтрокиТекста, ЦветУзора, ЦветФона, ЦветПоказателя);
		Рисунок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура рисует связи показателя на поле табличного документа
//
&НаСервере
Процедура НарисоватьСвязи(ТаблицаПоказателей, ТабличныйДокумент, СтрокаПоказателя, Уровни, Цвет = Неопределено, ИндексСвязи)
	
	ЛевоПоказателя = ПолучитьДанныеУровня(Уровни.У,СтрокаПоказателя.УровеньУ).ЛевоПоказателя;
	ВерхПоказателя = ПолучитьДанныеУровня(Уровни.Х,СтрокаПоказателя.УровеньХ).ВерхПоказателя + Отчет.ВысотаЗаголовка;
	
	Если СтрокаПоказателя.ПоказателиПредшественники.Количество() <> 0
	   И НЕ СтрокаПоказателя.Ошибка Тогда
		РисованиеГрафиковУХ.НарисоватьСтрелку(ТабличныйДокумент, "", ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3, ВерхПоказателя, ,Цвет)
	КонецЕсли;
	
	Для Индекс=0 По СтрокаПоказателя.ПоказателиПредшественники.Количество()-1 Цикл 
		
		СтрокаПредшественника=СтрокаПоказателя.ПоказателиПредшественники[Индекс];	
		
		Если СтрокаПоказателя.Ошибка
		 ИЛИ СтрокаПредшественника.СтрокаПоказателяПредшественника.Ошибка Тогда
				ТипЛинии = ТипЛинииРисункаТабличногоДокумента.Пунктир;
		Иначе
				ТипЛинии = ТипЛинииРисункаТабличногоДокумента.Сплошная;
	 	КонецЕсли;
		
		ИндексСвязи = ИндексСвязи + 1;
		
		СтрокаПоказателяПредшественника = СтрокаПредшественника.СтрокаПоказателяПредшественника;
		
		ЛевоПредшественника = ПолучитьДанныеУровня(Уровни.У,СтрокаПоказателяПредшественника.УровеньУ).ЛевоПоказателя;
		ВерхПредшественника = ПолучитьДанныеУровня(Уровни.Х,СтрокаПоказателяПредшественника.УровеньХ).ВерхПоказателя;
		
		Расшифровка = Новый Структура("ВидОтчета, ПравилоОбработки, Показатель, Операнд"
									  , СтрокаПредшественника.СтрокаПоказателяПредшественника.ВидОтчета
									  , СтрокаПоказателя.ПравилоОбработки
									  , СтрокаПредшественника.СтрокаПоказателяПредшественника.Показатель
									  , СтрокаПоказателя.Операнд);
									  
		Флаг = ?(СтрокаПоказателяПредшественника.УровеньУ > СтрокаПоказателя.УровеньУ, -1, 1);
		
		ЕстьПересечения = Ложь;
		Для ИндХ = СтрокаПоказателяПредшественника.УровеньХ + 1 По СтрокаПоказателя.УровеньХ - 1 Цикл
			ПоказателиПересечения = ТаблицаПоказателей.НайтиСтроки(Новый Структура("УровеньХ, УровеньУ", ИндХ
																					, СтрокаПоказателяПредшественника.УровеньУ));
			Если ПоказателиПересечения.Количество() <> 0 Тогда
				ЕстьПересечения = Истина;
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;
		
		Если НЕ ЕстьПересечения Тогда
			ЛевоЛинии  = ЛевоПредшественника + Отчет.ШиринаПоказателя / 4;
			ВерхЛинии  = ВерхПредшественника + Отчет.ВысотаПоказателя;
			Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, 0, ВерхПоказателя - ВерхЛинии - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа - Отчет.ШиринаИзгиба, Цвет, ТипЛинии);
			ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
			
			Если СтрокаПоказателяПредшественника.УровеньУ = СтрокаПоказателя.УровеньУ Тогда
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, Отчет.ШиринаИзгиба, Отчет.ШиринаИзгиба, Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, Отчет.ШиринаПоказателя / 2 - Отчет.ШиринаИзгиба * 2, 0, Цвет, ТипЛинии);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, Отчет.ШиринаИзгиба, Отчет.ШиринаИзгиба, Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
			Иначе
		
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии , Флаг * Отчет.ШиринаИзгиба,  Отчет.ШиринаИзгиба, Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ?(Флаг = 1, ЛевоЛинии, ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3  + Отчет.ШиринаИзгиба) 
															  , ВерхПоказателя - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа
															  , (ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3 - ЛевоЛинии) * Флаг - Отчет.ШиринаИзгиба
															  , 0, Цвет, ТипЛинии);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ?(Флаг = 1, ЛевоЛинии + Отчет.ШиринаИзгиба, ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3)
															  , ВерхПоказателя - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа + Отчет.ШиринаИзгиба
															  , - Флаг * Отчет.ШиринаИзгиба
															  , - Отчет.ШиринаИзгиба, Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				
			КонецЕсли;
		
			Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка
											 , ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3
											 , ВерхПоказателя - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа + Отчет.ШиринаИзгиба
											 , 0
											 , СтрокаПредшественника.ОтступХ * Отчет.ШиринаОтступа - Отчет.ШиринаИзгиба, Цвет, ТипЛинии);
			ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
		Иначе
			
			ЛевоЛинии   = ЛевоПредшественника + Отчет.ШиринаПоказателя;
			ВерхЛинии   = ВерхПредшественника + Отчет.ВысотаПоказателя / 4 * 3;
			Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, Отчет.ВысотаОтступа * СтрокаПредшественника.ОтступУ - Отчет.ШиринаИзгиба, 0, Цвет, ТипЛинии);
			ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
			Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, Отчет.ШиринаИзгиба, Отчет.ШиринаИзгиба, Цвет);
			ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
			Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, 0, ВерхПоказателя - ВерхЛинии - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа - Отчет.ШиринаИзгиба, Цвет, ТипЛинии);
			ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
			
			Если СтрокаПоказателяПредшественника.УровеньУ = СтрокаПоказателя.УровеньУ Тогда
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3 , ВерхПоказателя - СтрокаПредшественника.ОтступХ * Отчет.ШиринаОтступа + Отчет.ШиринаИзгиба, Отчет.ШиринаИзгиба, - Отчет.ШиринаИзгиба, Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии - Отчет.ШиринаИзгиба, ВерхПоказателя - СтрокаПредшественника.ОтступХ * Отчет.ШиринаОтступа, ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3 - ЛевоЛинии + 2 * Отчет.ШиринаИзгиба, 0, Цвет, ТипЛинии);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии - Отчет.ШиринаИзгиба, ВерхПоказателя - СтрокаПредшественника.ОтступХ * Отчет.ШиринаОтступа, Отчет.ШиринаИзгиба, - Отчет.ШиринаИзгиба, Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
			Иначе
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии , Флаг * Отчет.ШиринаИзгиба,  Отчет.ШиринаИзгиба, Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ?(Флаг = 1, ЛевоЛинии, ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3  + Отчет.ШиринаИзгиба)															  
															  , ВерхПоказателя - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа
															  , (ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3 - ЛевоЛинии) * Флаг - Отчет.ШиринаИзгиба
															  , 0, Цвет, ТипЛинии);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
				Линия = РисованиеГрафиковУХ.НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ?(Флаг = 1, ЛевоЛинии + Отчет.ШиринаИзгиба, ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3)
															  , ВерхПоказателя - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа + Отчет.ШиринаИзгиба
															  , - Флаг * Отчет.ШиринаИзгиба
															  , - Отчет.ШиринаИзгиба
															  , Цвет);
				ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
			КонецЕсли;
			Линия = РисованиеГрафиковУХ.НарисоватьЛинию(ТабличныйДокумент, Расшифровка
											 , ЛевоПоказателя + Отчет.ШиринаПоказателя / 4 * 3
											 , ВерхПоказателя - СтрокаПредшественника.ОтступХ*Отчет.ШиринаОтступа + Отчет.ШиринаИзгиба
											 , 0
											 , СтрокаПредшественника.ОтступХ * Отчет.ШиринаОтступа - Отчет.ШиринаИзгиба, Цвет, ТипЛинии);
			ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет);
											 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьВТаблицуУровней(ТаблицаУровней,Ключ,Значение)
	
	НоваяСтрока=ТаблицаУровней.Добавить();
	НоваяСтрока.Ключ=Ключ;
	НоваяСтрока.Значение=Значение;
	
КонецПроцедуры // ДобавитьВТаблицуУровней() 

Функция ПолучитьДанныеУровня(ТаблицаУровней,Ключ)
	
	СтрокаУровня=ТаблицаУровней.Найти(Ключ,"Ключ");
	
	Если СтрокаУровня=Неопределено Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Возврат СтрокаУровня.Значение;
		
	КонецЕсли;
	
КонецФункции // ПолучитьСтрокуУровня()

// Процедура формирует диаграмму показателей.
//
&НаСервере
Процедура ЗаполнитьТаблицуПоказателей() Экспорт

	ЧислоАналитик = ПараметрыСеанса.ЧислоДопАналитик;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		           |	ПоказателиОтчетов.Владелец КАК ВидОтчета,
		           |	ПоказателиОтчетов.Ссылка КАК Показатель,
		           |	ОперандыПоказателей.НазначениеРасчетов КАК ПравилоОбработки,
		           |	ОперандыПоказателей.Ссылка КАК Операнд";
	Для Инд = 1 По ЧислоАналитик Цикл
		ТекстЗапроса = ТекстЗАпроса + "
		|, ПоказателиОтчетов.Ссылка.ГруппаРаскрытия.ВидАналитики" + Инд + " КАК ВидАналитики" + Инд;
	КонецЦикла;
		ТекстЗапроса = ТекстЗапроса + "
		               |ИЗ
		               |	Справочник.ИсточникиДанныхДляРасчетов КАК ОперандыПоказателей
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		               |		ПО ОперандыПоказателей.ПоказательОтбор = ПоказателиОтчетов.Ссылка
		               |ГДЕ
		               |	ОперандыПоказателей.НазначениеРасчетов = &ПравилоОбработки
					   |	И (НЕ ОперандыПоказателей.ПометкаУдаления)
		               |	И ОперандыПоказателей.ПотребительРасчета = &Показатель
		               |	И ОперандыПоказателей.НеИспользуется = ЛОЖЬ
					   |	И (НЕ ПоказателиОтчетов.ПометкаУдаления)";
	
	мТаблицаПоказателей = Новый ТаблицаЗначений;
	мТаблицаПоказателей.Колонки.Добавить("Родитель", Новый ОписаниеТипов("СправочникСсылка.ПоказателиОтчетов"));
	мТаблицаПоказателей.Колонки.Добавить("Показатель", Новый ОписаниеТипов("СправочникСсылка.ПоказателиОтчетов"));
	мТаблицаПоказателей.Колонки.Добавить("Операнд", Новый ОписаниеТипов("СправочникСсылка.ИсточникиДанныхДляРасчетов"));
	мТаблицаПоказателей.Колонки.Добавить("ВидОтчета", Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов"));
	мТаблицаПоказателей.Колонки.Добавить("ПравилоОбработки", Новый ОписаниеТипов("СправочникСсылка.ПравилаОбработки"));
	мТаблицаПоказателей.Колонки.Добавить("ПоказателиПредшественники", Новый ОписаниеТипов("ТаблицаЗначений"));
	мТаблицаПоказателей.Колонки.Добавить("УровеньХ");
	мТаблицаПоказателей.Колонки.Добавить("КоличествоПредшественников");
	мТаблицаПоказателей.Колонки.Добавить("УникальныйИдентификатор");
	мТаблицаПоказателей.Колонки.Добавить("ПоказательДругогоСреза", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	мТаблицаПоказателей.Колонки.Добавить("Ошибка", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
		
	Для Инд = 1 По ЧислоАналитик Цикл
		мТаблицаПоказателей.Колонки.Добавить("ВидАналитики" + Инд);
	КонецЦикла;
	
	НоваяСтрока = мТаблицаПоказателей.Добавить();
	НоваяСтрока.Родитель         		  = Неопределено;
	НоваяСтрока.Показатель       		  = Отчет.Показатель;
	НоваяСтрока.ВидОтчета        		  = Отчет.ВидОтчета;
	
	Для Инд = 1 По ЧислоАналитик Цикл
		НоваяСтрока["ВидАналитики" + Инд] = Отчет.Показатель.ГруппаРаскрытия["ВидАналитики" + Инд];
	КонецЦикла;

	НоваяСтрока.ПравилоОбработки 		  = Отчет.ПравилоОбработки;
	НоваяСтрока.УникальныйИдентификатор   = Новый УникальныйИдентификатор();
	НоваяСтрока.ПоказателиПредшественники = Новый ТаблицаЗначений;
	НоваяСтрока.Операнд					  = Справочники.ИсточникиДанныхДляРасчетов.ПустаяСсылка();
	НоваяСтрока.Ошибка                    = Ложь;
	НоваяСтрока.ПоказателиПредшественники.Колонки.Добавить("УникальныйИдентификатор");
	
	МассивПоказателей  = Новый Массив;
	МассивПоказателей.Добавить(НоваяСтрока.УникальныйИдентификатор);
	ПолучитьТаблицуДочернихПоказателей(мТаблицаПоказателей, ТекстЗапроса, НоваяСтрока, Отчет.ПравилоОбработки, МассивПоказателей, 1);
	
	Для Индекс=0 По мТаблицаПоказателей.Количество()-1 Цикл
		
		СтрокаПоказателя=мТаблицаПоказателей[Индекс];	
		
		РассчитатьУровеньX(СтрокаПоказателя, мТаблицаПоказателей);
		СтрокаПоказателя.КоличествоПредшественников = СтрокаПоказателя.ПоказателиПредшественники.Количество();
	КонецЦикла;
	
	мТаблицаПоказателей.Сортировать("УровеньХ, КоличествоПредшественников");
	
	СдвигУровней=мТаблицаПоказателей[0].УровеньХ;
	
	Для Индекс=0 По мТаблицаПоказателей.Количество()-1  Цикл
		
		СтрПоказатель=мТаблицаПоказателей[Индекс];	
		
		СтрПоказатель.УровеньХ=СтрПоказатель.УровеньХ-СдвигУровней;
		
	КонецЦикла;
	
	мТаблицаПоказателей.Колонки.Добавить("УровеньУ");
	
	Уровни = Новый Структура("Х, У", ПодготовитьТаблицуУровней(), ПодготовитьТаблицуУровней());
	УровеньХ = 0;
	СтрокиУровня = мТаблицаПоказателей.НайтиСтроки(Новый Структура("УровеньХ", УровеньХ));
	Пока СтрокиУровня.Количество() Цикл
		
		СтруктураХ = Новый Структура("ОтступХ, ЗанятыеУровниПоУ", 0, ПодготовитьТаблицуУровней());
		ДобавитьВТаблицуУровней(Уровни.Х,УровеньХ,СтруктураХ);
		УровеньУ = -1;
		
		Для ИндексХ=0 По СтрокиУровня.Количество()-1  Цикл
			
			СтрокаПоказателя=СтрокиУровня[ИндексХ];
			
			Если СтрокаПоказателя.ПоказателиПредшественники.Колонки.Найти("ОтступХ")=Неопределено Тогда
				
				СтрокаПоказателя.ПоказателиПредшественники.Колонки.Добавить("ОтступХ", Новый ОписаниеТипов("Число"));
				СтрокаПоказателя.ПоказателиПредшественники.Колонки.Добавить("ОтступУ", Новый ОписаниеТипов("Число"));
				
			КонецЕсли;
			
			Если СтрокаПоказателя.ПоказателиПредшественники.Количество() = 0 ИЛИ УровеньХ=0 Тогда
				УровеньУ = УровеньУ + 1;
			Иначе
				
				Если СтрокаПоказателя.ПоказателиПредшественники.Количество() = 1 Тогда
					Предпочтение =СтрокаПоказателя.ПоказателиПредшественники[0].СтрокаПоказателяПредшественника.УровеньУ;
				Иначе
					Предпочтение = Неопределено;
				КонецЕсли;
				
				УровеньУ = ОпределитьНовуюПозициюВУровнеY(СтрокаПоказателя, СтруктураХ.ЗанятыеУровниПоУ, Предпочтение);
				
				Для ИндексУ=0 По СтрокаПоказателя.ПоказателиПредшественники.Количество()-1 Цикл
					
					СтрокаПредшественника=СтрокаПоказателя.ПоказателиПредшественники[ИндексУ];
					
					СтруктураХ.ОтступХ = СтруктураХ.ОтступХ + 1;
					
					Если Не СтрокаПоказателя.УровеньХ = СтрокаПредшественника.СтрокаПоказателяПредшественника.УровеньХ + 1 Тогда 
						
						СтруктураУ=ПолучитьДанныеУровня(Уровни.У,?(СтрокаПредшественника.СтрокаПоказателяПредшественника.УровеньУ=Неопределено,0,СтрокаПредшественника.СтрокаПоказателяПредшественника.УровеньУ));
						
						СтруктураУ.ОтступУ = СтруктураУ.ОтступУ + 1;
						СтрокаПредшественника.ОтступУ = СтруктураУ.ОтступУ;
						
					КонецЕсли;
					
					СтрокаПредшественника.ОтступХ = СтруктураХ.ОтступХ;
					
				КонецЦикла;
				
			КонецЕсли;
			
			СтруктураУ = ПолучитьДанныеУровня(Уровни.У,УровеньУ);
			Если СтруктураУ = Неопределено Тогда
				СтруктураУ = Новый Структура("ОтступУ", 0);
				
				ДобавитьВТаблицуУровней(Уровни.У,УровеньУ,СтруктураУ);
				
			КонецЕсли;
			
			СтрокаПоказателя.УровеньУ = УровеньУ;
			
		КонецЦикла;
		
		УровеньХ = УровеньХ + 1;
		СтрокиУровня = мТаблицаПоказателей.НайтиСтроки(Новый Структура("УровеньХ", УровеньХ));
	КонецЦикла;
	
	ВывестиДиаграммуПоказателей(мТаблицаПоказателей, Уровни);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВТаблицуСвязей(Линия, ИндексСвязи, Цвет)
	
	НоваяСтрока = Отчет.ТаблицаСвязей.Добавить();
	НоваяСтрока.ИмяЛинии = Линия.Имя;
	НоваяСтрока.ИндексСвязи = ИндексСвязи;
	НоваяСтрока.Цвет_Красный = Цвет.Красный;
	НоваяСтрока.Цвет_Зеленый = Цвет.Зеленый;
	НоваяСтрока.Цвет_Синий   = Цвет.Синий;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВернутьНастройкиРасшифровки(Расшифровка, ИмяФормы)
	
	Если ТипЗнч(Расшифровка) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		
		ТекБланкОтчета = Справочники.ВидыОтчетов.ЗначениеНастройкиПоУмолчанию(Расшифровка, "БланкДляОтображения");
		Если ЗначениеЗаполнено(ТекБланкОтчета) Тогда
			ИмяФормы = "Справочник.БланкиОтчетов.ФормаОбъекта";
			Возврат Новый Структура("Ключ", ТекБланкОтчета);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
		
		ТекБланкОтчета = Справочники.ВидыОтчетов.ЗначениеНастройкиПоУмолчанию(Расшифровка.Владелец, "БланкДляОтображения");
		Если ЗначениеЗаполнено(ТекБланкОтчета) Тогда
			ИмяФормы = "Справочник.БланкиОтчетов.ФормаОбъекта";
			Возврат Новый Структура("Ключ, КодПоказателяОтображения", ТекБланкОтчета, Расшифровка.Код);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли Расшифровка = Справочники.ИсточникиДанныхДляРасчетов.ПустаяСсылка() Тогда
		
		Сообщить(Нстр("ru = 'Показатель является вычисляемым и не использует операнды'"));
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции





