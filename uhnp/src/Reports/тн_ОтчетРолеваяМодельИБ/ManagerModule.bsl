                                                                  
Функция ПолучитьСписокПравИРолей(СписокВыбранныхТипов = Неопределено, СписокВыбранныхОбъектовМД = Неопределено, СписокВыбранныхРолей = Неопределено, ПараметрыОбмена = Неопределено) Экспорт
	
	ТЗПравИРолейОбъектовБД = Новый ТаблицаЗначений;
	
	ТЗПравИРолейОбъектовБД.Колонки.Добавить("ТипОбъектаМетаДанных", Новый ОписаниеТипов("Строка"));
	ТЗПравИРолейОбъектовБД.Колонки.Добавить("ОбъектМетаДанных", Новый ОписаниеТипов("Строка"));
	ТЗПравИРолейОбъектовБД.Колонки.Добавить("ИмяОбъектаМетаданных", Новый ОписаниеТипов("Строка"));
	ТЗПравИРолейОбъектовБД.Колонки.Добавить("Роль", Новый ОписаниеТипов("Строка"));	
	ТЗПравИРолейОбъектовБД.Колонки.Добавить("Роль_Синоним", Новый ОписаниеТипов("Строка"));	
	ТЗПравИРолейОбъектовБД.Колонки.Добавить("Право", Новый ОписаниеТипов("Строка"));
	ТЗПравИРолейОбъектовБД.Колонки.Добавить("Использование", Новый ОписаниеТипов("Булево"));
	
	СписокВыбранныхТиповМД = СписокВыбранныхТипов;
	
	// НАЧАЛО Одинец Р.Ю. 20.07.2025 Выполнение задач №000054473
	//Если ПараметрыОбмена <> Неопределено И ПараметрыОбмена.Получить("Параметр") <> "" Тогда
	//	
	//	Параметр = ПараметрыОбмена.Получить("Параметр");
	//	
	//	МассивВыбранныхТипов = Новый Массив;
	//	МассивВыбранныхТипов.Добавить(Параметр);		
	//	
	//	СписокВыбранныхТиповМД = Новый Соответствие;
	//	СписокВыбранныхТиповМД.Вставить("ВключитьВОтбор", МассивВыбранныхТипов);

	//КонецЕсли;
	// КОНЕЦ Одинец Р.Ю. 20.07.2025 Выполнение задач №000054473
	
	СтруктураПравИОбъектов = Новый Структура;
	СтруктураПравИОбъектов = ПолучитьПраваПоОбъектамМД(СписокВыбранныхТиповМД);
    
    КоллекцияРолей = Метаданные.Роли;
	
	Если СписокВыбранныхРолей <> Неопределено Тогда
		
		МассивРолейСОтбором = Новый Массив;
		МассивРолейСИсключением = Новый Массив;
		
		Для каждого ЭлементСоответствия Из СписокВыбранныхРолей Цикл
			
			ВидОтбора = ЭлементСоответствия.Ключ;
			
			Для каждого Роль Из КоллекцияРолей Цикл		
				
		    	Если ЭлементСоответствия.Значение.Найти(Роль.Имя) <> Неопределено Тогда
					МассивРолейСОтбором.Добавить(Роль);	
				Иначе 
					МассивРолейСИсключением.Добавить(Роль);	
				КонецЕсли;			
				
			КонецЦикла;	
			
		КонецЦикла;
		
		Если ВидОтбора = "ВключитьВОтбор" Тогда
			КоллекцияРолей = МассивРолейСОтбором;
		Иначе 
			КоллекцияРолей = МассивРолейСИсключением;	
		КонецЕсли;
		
	КонецЕсли; 
	
	МассивОбъектовМД = Новый Массив;
	
	Если СписокВыбранныхОбъектовМД <> Неопределено Тогда 
		
		Для каждого ЭлементСоответствия Из СписокВыбранныхОбъектовМД Цикл
			
			ВидОтбораОбъектаМД = ЭлементСоответствия.Ключ;
			
			Для каждого Объект Из ЭлементСоответствия.Значение Цикл		
				
				МассивОбъектовМД.Добавить(Метаданные.НайтиПоПолномуИмени(Объект));				
				
			КонецЦикла;	
			
		КонецЦикла;	
	КонецЕсли; 		

	Для каждого Элемент Из СтруктураПравИОбъектов Цикл 
		
		Для каждого ОбъектМД Из Метаданные[Элемент.Ключ] Цикл
			
			Если МассивОбъектовМД.Количество() Тогда //Если введен отбор по объектам МД, права ищем только для них.
				
				ОбъектНеОтобран = ВидОтбораОбъектаМД = "ВключитьВОтбор" И МассивОбъектовМД.Найти(ОбъектМД) = Неопределено
						Или	ВидОтбораОбъектаМД = "ИсключитьИзОтбора" И МассивОбъектовМД.Найти(ОбъектМД) <> Неопределено;
				
				Если ОбъектНеОтобран Тогда 
					Продолжить;
				КонецЕсли;	
			
			КонецЕсли;
			
			Если Элемент.Ключ = "WebСервисы" Тогда //Необходимо спуститься на уровень ниже, т.к. у Web-Сервисов права доступны только для операций.
				
				Для каждого Операция Из ОбъектМД.Операции Цикл 
					УстановитьПраво(ТЗПравИРолейОбъектовБД, Элемент, Операция, КоллекцияРолей, ОбъектМД);
				КонецЦикла;
				
			Иначе	
				УстановитьПраво(ТЗПравИРолейОбъектовБД, Элемент, ОбъектМД, КоллекцияРолей);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТЗПравИРолейОбъектовБД.Свернуть("ТипОбъектаМетаДанных, ОбъектМетаДанных, ИмяОбъектаМетаданных, Роль, Роль_Синоним, Право, Использование");
		
	Возврат ТЗПравИРолейОбъектовБД;
	
КонецФункции     

Процедура УстановитьПраво(ТЗПравИРолейОбъектовБД, Элемент, ОбъектМД, КоллекцияРолей, WebСервис = Неопределено)
	
	Для каждого Право Из Элемент.Значение Цикл	
		
		Для каждого Роль Из КоллекцияРолей Цикл
			
			ЕстьПраво = ПравоДоступа(Право, ОбъектМД, Роль);	
			
			Если ЕстьПраво Тогда
				
				НоваяСтрока = ТЗПравИРолейОбъектовБД.Добавить();
				НоваяСтрока.ТипОбъектаМетаДанных      	  = Элемент.Ключ;
				НоваяСтрока.ОбъектМетаДанных 		  	  = ?(WebСервис <> Неопределено, Строка(WebСервис) + "(" + Строка(ОбъектМД) + ")" , Строка(ОбъектМД));
				НоваяСтрока.ИмяОбъектаМетаданных          = ОбъектМД.Имя;
				НоваяСтрока.Роль		  	 			  = Роль.Имя;
				НоваяСтрока.Роль_Синоним  	 			  = Роль.Синоним;				
				НоваяСтрока.Право	          			  = Право;
				НоваяСтрока.Использование 	 			  = ЕстьПраво;			
				
			КонецЕсли;	
			
		КонецЦикла;			
		
	КонецЦикла;

КонецПроцедуры

