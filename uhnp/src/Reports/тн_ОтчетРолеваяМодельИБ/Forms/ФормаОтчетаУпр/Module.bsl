
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ФормаКомпактныйРежимОтображения.Видимость = Ложь;
	
	Компоновщик = ЭтотОбъект.Отчет.КомпоновщикНастроек;
		
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	СхемаКомпоновкиДанных = ОтчетОбъект.СхемаКомпоновкиДанных; 	

	//Список доступных для выбора ролей
	ПолеРоль = СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Найти("Роль");	
	
	Если ПолеРоль <> Неопределено Тогда
		
		КоллекцияРолей = Метаданные.Роли;
		СписокРолей = Новый СписокЗначений;
		
		Для Каждого Роль Из КоллекцияРолей Цикл
			
			СписокРолей.Добавить(Роль.Имя, Роль.Представление());
			
		КонецЦикла;
		
		ПолеРоль.УстановитьДоступныеЗначения(СписокРолей);	
		
	КонецЕсли;
	
	//Список доступных для выбора Объектов метаданных
	СписокТиповОбъектовМД = СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Найти("ТипОбъектаМетаданных").ПолучитьДоступныеЗначения();
	
	ПолеОбъектМД = СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Найти("ОбъектМетаДанных");
	
	Если ПолеОбъектМД <> Неопределено Тогда
		
		СписокОбъектовМД = Новый СписокЗначений;
		
		Для каждого ТипМД Из СписокТиповОбъектовМД Цикл
		
			ИмяТипаМД = ТипМД.Значение;
			
			Для каждого ОбъектМД Из Метаданные[ИмяТипаМД] Цикл
			
				СписокОбъектовМД.Добавить(ОбъектМД.ПолноеИмя(), "" + ИмятипаМД + "." + ОбъектМД.Представление());		
			
			КонецЦикла;
		
		КонецЦикла;
		
		СписокОбъектовМД.СортироватьПоПредставлению();
		
		ПолеОбъектМД.УстановитьДоступныеЗначения(СписокОбъектовМД);
		
	КонецЕсли;
	
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор);
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных));
	Компоновщик.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);	
	
КонецПроцедуры
