Процедура ПолучитьНастройкиТрансляции(ТабДок,ДокументКорректировки,ПравилоДт,ПравилоКт) Экспорт
	
	Макет=ПолучитьМакет("ОтчетПоПроводкам");
	
	ОбластьТрансляция=Макет.ПолучитьОбласть("ОбластьНастройкиТрансляции");
	ОбластьТрансляция.Параметры.ПравилоДт				= ПравилоДт;
	ОбластьТрансляция.Параметры.ПравилоКт				= ПравилоКт;
	ОбластьТрансляция.Параметры.ДокументКорректировки	= ДокументКорректировки;
	
	СтрОписаниеПравилаДт=Обработки.КорректировкиЗначенийПоказателей.ПолучитьПодробнуюИнформацию(ПравилоДт,РегистрБД,"Дт");
	
	ОбластьТрансляция.Параметры.ОтборДт			= СтрОписаниеПравилаДт.ОтборПодробно;
	ОбластьТрансляция.Параметры.СопоставлениеДт	= СтрОписаниеПравилаДт.СоответствиеПодробно;
	ОбластьТрансляция.Параметры.СчетаИсточникДт	= СтрОписаниеПравилаДт.ТекстСчетИсточник;
	ОбластьТрансляция.Параметры.СчетаПриемникДт	= СтрОписаниеПравилаДт.ТекстСчетПриемник;
	
	СтрОписаниеПравилаКт=Обработки.КорректировкиЗначенийПоказателей.ПолучитьПодробнуюИнформацию(ПравилоКт,РегистрБД,"Кт");
	
	ОбластьТрансляция.Параметры.ОтборКт			= СтрОписаниеПравилаКт.ОтборПодробно;
	ОбластьТрансляция.Параметры.СопоставлениеКт	= СтрОписаниеПравилаКт.СоответствиеПодробно;
	ОбластьТрансляция.Параметры.СчетаИсточникКт	= СтрОписаниеПравилаКт.ТекстСчетИсточник;
	ОбластьТрансляция.Параметры.СчетаПриемникКт	= СтрОписаниеПравилаКт.ТекстСчетПриемник;
	
	ТабДок.Вывести(ОбластьТрансляция);
	
КонецПроцедуры // ПолучитьНастройкиТрансляции() 


