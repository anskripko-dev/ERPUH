Функция ИтогЕстьОборотПоСчетам() Экспорт;
	
	Возврат ВидОтчета="ОтчетПоПроводкам";
	
КонецФункции

// Функция определяет, нужен ли в имени измерения или субконто  постфиксДт/Кт
//  Параметры:
//  - ЗаписьВИБ    - Строка, Наименование измерения или реквизита регистра бухгалтерии.
//  Возвращаемое значение:
//   Модифицированное имя измерения или регистра бухгалтерии.
Функция ДобавитьКСубконтоПризнакДтКт(ЗаписьВИБ) Экспорт
	
	Если ТипЗнч(ЗаписьВИБ)=Тип("Строка") Тогда
		
		ТекПараметрВИБ=НайтиСтрокуДанныхВИБПоПолю(ЗаписьВИБ);
		
		Если ТекПараметрВИБ=Неопределено Тогда
			
			Возврат ЗаписьВИБ;
			
		КонецЕсли;

	Иначе
		
		ТекПараметрВИБ=ЗаписьВИБ;
		
	КонецЕсли;
			
	ПолеБД = ТекПараметрВИБ.ПолеБД;
		
	//	Если НЕ ВидИтога = мОборотыПоСчетам Тогда
	Если НЕ ИтогЕстьОборотПоСчетам() Тогда
		
		ПолеБД=СтрЗаменить(ПолеБД,?(ТекПараметрВИБ.Дебетовый, "Дт", "Кт"),"");
		Возврат ПолеБД;
		
	Иначе
		
		Если ТекПараметрВИБ.Измерение И НЕ ТекПараметрВИБ.Балансовый Тогда
			Возврат СтрЗаменить(ПолеБД,"Субконто", "СубконтоДт");
		Иначе
			Возврат ПолеБД;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Процедура ПодготовитьТаблицуОтбораВИБ()
	
	Если ПолеПланСчетов="ПланСчетов" Тогда
		
		НоваяСтрока=мТабПравилаВычисленияПараметров.Добавить();
		НоваяСтрока.ИмяПараметра="ПланСчетов";
		НоваяСтрока.ПолеБД="ПланСчетов";
		НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
		
		СписокОтбора=Новый СписокЗначений;
		СписокОтбора.Добавить(ПланСчетовБД.Наименование,ПланСчетовБД.Наименование,Ложь);
		НоваяСтрока.УточнениеСпособаОпределения=СписокОтбора;
		
	ИначеЕсли ПолеПланСчетов="ПланСчетовБД" Тогда
		
		НоваяСтрока=мТабПравилаВычисленияПараметров.Добавить();
		НоваяСтрока.ИмяПараметра="ПланСчетовБД";
		НоваяСтрока.ПолеБД="ПланСчетовБД";
		НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
		
		СписокОтбора=Новый СписокЗначений;
		СписокОтбора.Добавить(ПланСчетовБД.Наименование,ПланСчетовБД.Наименование,Ложь);
		НоваяСтрока.УточнениеСпособаОпределения=СписокОтбора;
		
	КонецЕсли;
	
	ПравилаВычисленияПараметровЗапроса=мТабПравилаВычисленияПараметров.Скопировать();
	ПравилаВычисленияПараметровЗапроса.Колонки.Удалить("УточнениеСпособаОпределения");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("УточнениеСпособаОпределения");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("ТипРасчета");
	
			
	Для Каждого СтрокаТаблицы Из мТабПравилаВычисленияПараметров Цикл

		Если СтрокаТаблицы.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
						
			Продолжить;
			
		КонецЕсли;
		
		Если ИтогЕстьОборотПоСчетам() Тогда
			
			Если СтрНайти(СтрокаТаблицы.ПолеБД,"Дт")=0 
				И СтрНайти(СтрокаТаблицы.ПолеБД,"Кт")=0
				И Лев(СтрокаТаблицы.ПолеБД,СтрДлина("Субконто"))="Субконто" Тогда
				
				ПолеПараметра=СтрЗаменить(СтрокаТаблицы.ПолеБД,"Субконто","СубконтоДт");
				
			Иначе
				
				ПолеПараметра=СтрокаТаблицы.ПолеБД;
				
			КонецЕсли;
			
		Иначе
			
			ПолеПараметра=СтрЗаменить(СтрокаТаблицы.ПолеБД,"Дт","");
			
		КонецЕсли;
		
		СтрокаПараметров=ПравилаВычисленияПараметровЗапроса.Найти(СтрокаТаблицы.ИмяПараметра,"ИмяПараметра");	
		ТекПараметрВИБ=НайтиСтрокуДанныхВИБПоПолю(ПолеПараметра);
						
		Если СтрокаПараметров.ПолеБД="КоррСчетОборот" Тогда
			
			СтрокаПараметров.ТипРасчета="Простой";
			СтрокаПараметров.УточнениеСпособаОпределения=Новый ХранилищеЗначения(СтрокаТаблицы.УточнениеСпособаОпределения);
			Продолжить;
			
		ИначеЕсли СтрокаПараметров=Неопределено Тогда
			
			СтрокаПараметров=ПравилаВычисленияПараметровЗапроса.Найти(ДобавитьКСубконтоПризнакДтКт(ТекПараметрВИБ),"ПолеБД");
			
			Если СтрокаПараметров=Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;			
		
		НастройкаСоответствия = СтрокаТаблицы.НастройкаСоответствия;		
		СтрокаПараметров.НастройкаСоответствия=НастройкаСоответствия;
		СтрокаПараметров.ТипРасчета="Простой";
		
		ТекЭлементВИБ   = ТекПараметрВИБ.СправочникБД;	
		
		Если ТекПараметрВИБ.ТипМетаДанных="Простой" Тогда
			
			СтрокаПараметров.УточнениеСпособаОпределения=Новый ХранилищеЗначения(СтрокаТаблицы.УточнениеСпособаОпределения);
		
		ИначеЕсли Не ПустаяСтрока(НастройкаСоответствия) Тогда // Отбор осуществляется по значению справочника Консолидации
			
			СтрокаПараметров.УточнениеСпособаОпределения=Новый ХранилищеЗначения(СтрокаТаблицы.УточнениеСпособаОпределения);
			
		Иначе // Отбор осуществляется по значению справочника внешней информационной базы.
			
			Если ТипЗнч(СтрокаТаблицы.УточнениеСпособаОпределения)=Тип("Структура") Тогда
				
				СтрокаПараметров.УточнениеСпособаОпределения = Новый ХранилищеЗначения(СтрокаТаблицы.УточнениеСпособаОпределения);
				
			Иначе
				
				Если ТипЗнч(СтрокаТаблицы.УточнениеСпособаОпределения)=Тип("СписокЗначений") Тогда
					
					СписокЗначений = СтрокаТаблицы.УточнениеСпособаОпределения;
					
				Иначе
					
					СписокЗначений=Новый СписокЗначений;
					СписокЗначений.Добавить(СтрокаТаблицы.УточнениеСпособаОпределения);
					
				КонецЕсли;
				
				Если ПустаяСтрока(ТекЭлементВИБ) Тогда
					
					Если ЗначениеЗаполнено(СтрокаТаблицы.ОбъектМетаданных) Тогда
						
						ИспользуетсяПеречисление = СтрНайти(СтрокаТаблицы.ОбъектМетаданных,"Перечисление")>0;		
						СтруктураОтбора = Новый Структура("_Справочник", СтрокаТаблицы.ОбъектМетаданных);
						
					Иначе
						
						Продолжить;
						
					КонецЕсли;
					
				Иначе				
					
					ИспользуетсяПеречисление=(ТекПараметрВИБ.ТипМетаДанных="Перечисление");
					СтруктураОтбора = Новый Структура("_Справочник", ТекПараметрВИБ.ТипМетаДанных + "." + ТекЭлементВИБ);
					
				КонецЕсли;
				
				МассивЭлементаОтбора = Новый Массив;
				СтруктураОтбора.Вставить("МассивОтбора", МассивЭлементаОтбора);
				
				Если ЗначениеЗаполнено(СписокЗначений) Тогда
					
					КоличествоЗаписей = СписокЗначений.Количество();
					
					Если КоличествоЗаписей > 0 Тогда
						Если КоличествоЗаписей = 1 Тогда
							Если ИспользуетсяПеречисление Тогда
								МассивЭлементаОтбора.Добавить(Новый Структура("Ссылка", "ЗНАЧЕНИЕ(" + СписокЗначений[0].Значение + ")"));
								//МассивЭлементаОтбора.Добавить(Новый Структура("Enums", СписокЗначений[0].Значение));
							Иначе
								Если НЕ СписокЗначений[0].Пометка Тогда
									МассивЭлементаОтбора.Добавить(Новый Структура("Наименование", СписокЗначений[0].Представление));
								Иначе
									
									ОтборТек=Новый Структура;
									ОтборТек.Вставить("Наименование",СписокЗначений[0].Представление);
									
									МассивЭлементаОтбора.Добавить(ОтборТек);
									
								КонецЕсли;
								
							КонецЕсли;
							
						Иначе
							
							Для Каждого Элемент Из СписокЗначений Цикл
								Если ИспользуетсяПеречисление Тогда
									МассивЭлементаОтбора.Добавить(Новый Структура("Ссылка", "ЗНАЧЕНИЕ(" + Элемент.Значение + ")"));
									//МассивЭлементаОтбора.Добавить(Новый Структура("Enums", Элемент.Значение));
								Иначе
									
									Если НЕ Элемент.Пометка  Тогда
										МассивЭлементаОтбора.Добавить(Новый Структура("Наименование", Элемент.Представление));
									Иначе
										
										ОтборТек=Новый Структура;
										ОтборТек.Вставить("Код",Элемент.Значение);
										ОтборТек.Вставить("Наименование",Элемент.Представление);
										
										МассивЭлементаОтбора.Добавить(ОтборТек);
										
									КонецЕсли;
								КонецЕсли;
								
							КонецЦикла;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				СтрокаПараметров.УточнениеСпособаОпределения = Новый ХранилищеЗначения(СтруктураОтбора); 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
		
	ТекПравилаВычисленияПараметров=РасширениеИнтеграцииУХ.ПолучитьРабочуюТаблицуВычисленияПараметров(ПравилаВычисленияПараметровЗапроса);
	
КонецПроцедуры // ПодготовитьТаблицуОтбораВИБ() 

Функция ПодготовитьТаблицуПараметровВИБ()
	
	ИспользуемыеПараметры = Новый ТаблицаЗначений;
	ИспользуемыеПараметры.Колонки.Добавить("ИмяПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("ЗначениеПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("КонструкцияОтбора");
	ИспользуемыеПараметры.Колонки.Добавить("ПолеБД"); 
	ИспользуемыеПараметры.Колонки.Добавить("ПредставлениеПоля");
	ИспользуемыеПараметры.Колонки.Добавить("СпособВычисленияПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("ПредставлениеПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("Вычислять",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	
	ВИБ=Новый Структура;
	ВИБ.Вставить("ВИБ",ИспользуемаяИБ);
	ВИБ.Вставить("ТипПодключения",1);
	
	Для Каждого СтрокаВычисления Из ТекПравилаВычисленияПараметров Цикл
		
		Если СтрокаВычисления.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			Продолжить;
		КонецЕсли;		
		
		СтруктураОтбора  = УправлениеОтчетамиУХ.ПолучитьЗначениеИзХранилища(СтрокаВычисления.УточнениеСпособаОпределения);
		
		Если Не ЗначениеЗаполнено(СтруктураОтбора) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока=ИспользуемыеПараметры.Добавить();
		НоваяСтрока.ИмяПараметра				= СтрЗаменить(СтрокаВычисления.ИмяПараметра,".","");
		НоваяСтрока.КонструкцияОтбора			= ПолучитьКонструкциюОтбора(СтрокаВычисления);
		НоваяСтрока.ПолеБД						= СтрокаВычисления.ПолеБД;
		НоваяСтрока.СпособВычисленияПараметра   = XMLСтрока(СтрокаВычисления.СпособВычисленияПараметра);
		
		СтрПолеБД=НайтиСтрокуДанныхВИБПоПолю(СтрокаВычисления.ПолеБД);
		НоваяСтрока.ПредставлениеПоля=?(СтрПолеБД=Неопределено,СтрокаВычисления.ПолеБД,СтрПолеБД.ПредставлениеПоля);
		
		Если ТипЗнч(СтруктураОтбора) = Тип("Структура")
			И (НЕ СтруктураОтбора.Свойство("ТипЗначения")) Тогда
			
			ДанныеСправочника = Неопределено;
			МассивОтбора = Новый Массив;
			
			Если СтруктураОтбора.Свойство("_Справочник", ДанныеСправочника) Тогда
								
				СтруктураОтбора.Свойство("МассивОтбора", МассивОтбора);
				
				НоваяСтрока.ЗначениеПараметра  = РасширениеИнтеграцииУХ.ПолучитьСтруктуруОтбора(ДанныеСправочника,МассивОтбора,ИспользуемаяИБ);
																		
			ИначеЕсли СтруктураОтбора.Свойство("_Справочники", ДанныеСправочника) Тогда
								
				СтруктураОтбора.Свойство("МассивОтбора", МассивОтбора);
				НоваяСтрока.ЗначениеПараметра  = РасширениеИнтеграцииУХ.ПолучитьСтруктуруОтбора(ДанныеСправочника.СправочникБД,МассивОтбора,ИспользуемаяИБ);
																
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока.ЗначениеПараметра   = СтруктураОтбора;	
					
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ИспользуемыеПараметры;
	
КонецФункции // ПодготовитьТаблицуПараметровВИБ()

Функция ПодготовитьТаблицуПараметровТек()
	
	ИспользуемыеПараметры = Новый ТаблицаЗначений;
	ИспользуемыеПараметры.Колонки.Добавить("ИмяПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("ЗначениеПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("КонструкцияОтбора");
	ИспользуемыеПараметры.Колонки.Добавить("ПолеБД");
	ИспользуемыеПараметры.Колонки.Добавить("ПредставлениеПоля");
	ИспользуемыеПараметры.Колонки.Добавить("СпособВычисленияПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("ПредставлениеПараметра");
	ИспользуемыеПараметры.Колонки.Добавить("Вычислять",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	
	Для Каждого Параметр ИЗ ПравилаВычисленияПараметровЗапроса Цикл
		
		Если Параметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока=ИспользуемыеПараметры.Добавить();
		НоваяСтрока.ИмяПараметра				= Параметр.ИмяПараметра;
		НоваяСтрока.КонструкцияОтбора			= ПолучитьКонструкциюОтбора(Параметр);
		
		Если Параметр.ПолеБД="ПланСчетов" Тогда
			
			ИмяСправочника="ПланыСчетовМеждународногоУчета";
			НоваяСтрока.ЗначениеПараметра			= Справочники[ИмяСправочника].НайтиПоНаименованию(Параметр.УточнениеСпособаОпределения.Наименование);
			
		Иначе
			
			НоваяСтрока.ЗначениеПараметра			= Параметр.УточнениеСпособаОпределения;
			
		КонецЕсли;
		
		НоваяСтрока.ПолеБД						= Параметр.ПолеБД;
		НоваяСтрока.СпособВычисленияПараметра   = XMLСтрока(Параметр.СпособВычисленияПараметра);
		
		СтрПолеБД=НайтиСтрокуДанныхВИБПоПолю(Параметр.ПолеБД);
		НоваяСтрока.ПредставлениеПоля=?(СтрПолеБД=Неопределено,Параметр.ПолеБД,СтрПолеБД.ПредставлениеПоля);
	
	КонецЦикла;
	
	Возврат ИспользуемыеПараметры;
	
КонецФункции // ПодготовитьТаблицуПараметровТек() 

Процедура ПолучитьСоединениеВИБ() Экспорт
	
	ТекСоединениеВИБ = РасширениеИнтеграцииУХ.ПолучитьСоединение(ИспользуемаяИБ, 1);
			
КонецПроцедуры // ПолучитьСоединениеВИБ()

Функция ПолучитьКонструкциюОтбора(СтрокаПараметр)
	
	ИмяПараметра=СтрЗаменить(СтрокаПараметр.ИмяПараметра,".","");
	СпособВычисленияПараметра=СтрокаПараметр.СпособВычисленияПараметра;
	
	Если ИтогЕстьОборотПоСчетам() Тогда
		
		Если СтрНайти(СтрокаПараметр.ПолеБД,"Дт")=0 
			И СтрНайти(СтрокаПараметр.ПолеБД,"Кт")=0
			И Лев(СтрокаПараметр.ПолеБД,СтрДлина("Субконто"))="Субконто" Тогда
			
			ПолеПараметра=СтрЗаменить(СтрокаПараметр.ПолеБД,"Субконто","СубконтоДт");
			
		Иначе
			
			ПолеПараметра=СтрокаПараметр.ПолеБД;
			
		КонецЕсли;
		
	Иначе
		
		ПолеПараметра=СтрЗаменить(СтрокаПараметр.ПолеБД,"Дт","");
		
	КонецЕсли;
	
	Если ИмяПараметра="Регистратор" Тогда
		
		Если СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение Тогда
			
			Возврат ПолеПараметра+" =&"+ИмяПараметра;
						
		ИначеЕсли СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений Тогда
			
			Возврат СтрШаблон(Нстр("ru = '%1 В(&%2)'; en = '%1 IN(&%2)';tr = '%1(&%2) de'"), ПолеПараметра, ИмяПараметра);
			
		КонецЕсли;
		
	КонецЕсли;	
	
	ДанныеПараметра=НайтиСтрокуДанныхВИБПоПолю(ПолеПараметра);
	ПолеОтбора=ОпределитьПолеОтбора(ПолеПараметра);
	
	Если ДанныеПараметра=Неопределено Тогда
		
		Возврат ""
		
	КонецЕсли;
		
	Если ДанныеПараметра.ТипМетаДанных="Простой" Тогда
		
		Если СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение Тогда
			
			Возврат ПолеОтбора+" =&"+ИмяПараметра;
			
		ИначеЕсли СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению Тогда
			
			Возврат ПолеОтбора+" <>&"+ИмяПараметра;
			
		ИначеЕсли СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений Тогда
			
			Возврат СтрШаблон(Нстр("ru = '%1 В(&%2)'; en = '%1 IN(&%2)';tr = '%1(&%2) de'"), ПолеОтбора, ИмяПараметра);
			
		ИначеЕсли СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений Тогда
			
			Возврат СтрШаблон(Нстр("ru = '(НЕ %1 В(&%2))'; en = '(NOT%1 IN(&%2))';tr = '(%1Değil (&%2)de)'"), ПолеОтбора, ИмяПараметра);
			
		КонецЕсли;
		
	Иначе
		
		Если СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение
			ИЛИ СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений Тогда
			
			Возврат СтрШаблон(Нстр("ru = '%1 В(&%2)'; en = '%1 IN(&%2)';tr = '%1(&%2) de'"), ПолеОтбора, ИмяПараметра);
			
		ИначеЕсли СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению
			ИЛИ СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений Тогда
			
			Возврат СтрШаблон(Нстр("ru = '(НЕ %1 В(&%2))'; en = '(NOT%1 IN(&%2))';tr = '(%1Değil (&%2)de)'"), ПолеОтбора, ИмяПараметра);
			
		ИначеЕсли СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.СписокПоИерархии Тогда
			
			Возврат СтрШаблон(Нстр("ru = '%1 В ИЕРАРХИИ(&%2)'; en = '%1 IN HIERARCHY(&%2)';tr = '%1(&%2) HİYERARŞİSİNDE'"), ПолеОтбора, ИмяПараметра);
			
		ИначеЕсли СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии Тогда
			
			Возврат СтрШаблон(Нстр("ru = '(НЕ %1 В ИЕРАРХИИ(&%2))'; en = '(NOT %1 IN HIERARCHY(&%2))';tr = '(%1Değil (&%2) HİYERARŞİSİNDE)'"), ПолеОтбора, ИмяПараметра);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции // ПолучитьКонструкциюОтбора()

// Функция формирует структуру дополнительных измерений для вывода ресурсов с соответствующим признаком учета
//
Функция СформироватьТаблицуДопИзмерений()
	
	ТаблицаДопИзмерений=Новый ТаблицаЗначений;
	ТаблицаДопИзмерений.Колонки.Добавить("ИмяРесурса");
	ТаблицаДопИзмерений.Колонки.Добавить("ИзмеренияРесурса",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСписокЗначений());
	
	МассивДопИзмерений=Новый Массив;
	
	МассивБалансовыеБезИзмерений	= Новый Массив;
	МассивБалансовыеСИзмерениями	= Новый Массив;
	МассивНебалансовыеБезИзмерений 	= Новый Массив;
	МассивНебалансовыеСИзмерениями 	= Новый Массив;
	
	Для Каждого СтрРесурс ИЗ МассивВыводимыхРесурсов Цикл
		
		Если (Не ПустаяСтрока(СтрРесурс.ПризнакУчета)) Тогда
			
			НоваяСтрока=ТаблицаДопИзмерений.Добавить();
			НоваяСтрока.ИмяРесурса=СтрРесурс.ИмяПоля;
			ЕстьИзмерения=Ложь;
			
			Для Каждого СтрИзмерение ИЗ РегистрБД.Измерения Цикл
				
				Если СтрНайти(СтрИзмерение.ПризнакУчета,СтрРесурс.ПризнакУчета)>0 
					И ПравилаВычисленияПараметровЗапроса.Найти(СтрИзмерение.Имя,"ИмяПараметра")=Неопределено Тогда
					
					НоваяСтрока.ИзмеренияРесурса.Добавить(СтрИзмерение.Имя);
					
					Если МассивДопИзмерений.Найти(СтрИзмерение.Имя)=Неопределено Тогда
						МассивДопИзмерений.Добавить(СтрИзмерение.Имя);
					КонецЕсли;
					
					ЕстьИзмерения=Истина;
					
				КонецЕсли;
				
			КонецЦикла;	
			
			Если ЕстьИзмерения Тогда
				
				Если СтрРесурс.Балансовый Тогда
					
					МассивБалансовыеСИзмерениями.Добавить(СтрРесурс.ИмяПоля);
					
				Иначе
					
					МассивНебалансовыеСИзмерениями.Добавить(СтрРесурс.ИмяПоля);
					
				КонецЕсли;
				
			Иначе
				
				Если СтрРесурс.Балансовый Тогда
					
					МассивБалансовыеБезИзмерений.Добавить(СтрРесурс.ИмяПоля);
					
				Иначе
					
					МассивНебалансовыеБезИзмерений.Добавить(СтрРесурс.ИмяПоля);
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если СтрРесурс.Балансовый Тогда
				
				МассивБалансовыеБезИзмерений.Добавить(СтрРесурс.ИмяПоля);
				
			Иначе
				
				МассивНебалансовыеБезИзмерений.Добавить(СтрРесурс.ИмяПоля);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивБалансовыеБезИзмерений.Количество()=0 Тогда
		
		Для Каждого СтрРесурс ИЗ МассивВыводимыхРесурсов Цикл
			
			Если ПустаяСтрока(СтрРесурс.ПризнакУчета) Тогда
				
				МассивБалансовыеБезИзмерений.Добавить(СтрРесурс.ИмяПоля);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат ТаблицаДопИзмерений;
	
КонецФункции // СформироватьСтруктуруДопИзмерений() 

Функция ТрансформироватьПравилаВывода(ПравилаВывода)
	
	ТаблицаПравила=Новый ТаблицаЗначений;
	
	Для Каждого Колонка ИЗ ПравилаВывода.Колонки Цикл
		
		Если Колонка.Имя="Счет" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТаблицаПравила.Колонки.Добавить(Колонка.Имя,Колонка.ТипЗначения);
		
	КонецЦикла;
	
	ТаблицаПравила.Колонки.Добавить("ВидыСубконто");
	
	Для Каждого Строка ИЗ ПравилаВывода Цикл
		
		НоваяСтрока=ТаблицаПравила.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
		НоваяСтрока.ВидыСубконто=Строка.Счет.ВидыСубконто.Выгрузить(,"Номер,ВидСубконто,ПризнакиУчетаСубконто,ТипДанных");
		
	КонецЦикла;
	
	Возврат ТаблицаПравила;

КонецФункции // ТрансформироватьПравилоВывода()

Функция ПолучитьДанныеРегистраБД()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	РегистрыБухгалтерииБД.Наименование КАК НаименованиеРегистра,
	             |	РегистрыБухгалтерииБД.Корреспонденция КАК Корреспонденция,
				 |	РегистрыБухгалтерииБД.Синоним КАК Синоним,
	             |	РегистрыБухгалтерииБД.Реквизиты.(
	             |		Имя КАК Имя,
	             |		Синоним КАК Синоним,
	             |		ТипДанных КАК ТипДанных
	             |	) КАК Реквизиты,
	             |	РегистрыБухгалтерииБД.ПланСчетовМетаданные КАК ПланСчетовРегистр
	             |ИЗ
	             |	Справочник.РегистрыБухгалтерииБД КАК РегистрыБухгалтерииБД
	             |ГДЕ
	             |	РегистрыБухгалтерииБД.Ссылка = &РегистрБД";
	
	Запрос.УстановитьПараметр("РегистрБД",РегистрБД);
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,".Синоним","."+ПолеСиноним);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Результат.Следующий();
	
	ДанныеРегистра=Новый Структура;
	
	ДанныеРегистра.Вставить("НаименованиеРегистра",Результат.НаименованиеРегистра);
	ДанныеРегистра.Вставить("Корреспонденция",Результат.Корреспонденция);
	ДанныеРегистра.Вставить("РеквизитыРегистра",Результат.Реквизиты.Выгрузить());
	ДанныеРегистра.Вставить("ПланСчетовРегистр",Результат.ПланСчетовРегистр);
	ДанныеРегистра.Вставить("Синоним",Результат.Синоним);
	
	Если НЕ РегистрБД.Измерения.Найти("ПланСчетов")=Неопределено Тогда
		
		ПолеПланСчетов="ПланСчетов";
		ДанныеРегистра.Вставить("ПолеПланСчетов",ПолеПланСчетов);
		
	ИначеЕсли НЕ РегистрБД.Измерения.Найти("ПланСчетовБД")=Неопределено Тогда
		
		ПолеПланСчетов="ПланСчетовБД";
		ДанныеРегистра.Вставить("ПолеПланСчетов",ПолеПланСчетов);
		
	КонецЕсли;
			
	Запрос.Текст="ВЫБРАТЬ
	|	ПланыСчетовБД.Наименование КАК ПланСчетов,
	|	ПланыСчетовБД.МаксимальноеКоличествоСубконто КАК МаксимальноеКоличествоСубконто
	|ИЗ
	|	Справочник.ПланыСчетовБД КАК ПланыСчетовБД
	|ГДЕ
	|	ПланыСчетовБД.Ссылка = &ПланСчетовБД";
	
	Запрос.УстановитьПараметр("ПланСчетовБД",ПланСчетовБД);
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();

	ДанныеРегистра.Вставить("ПланСчетов",Результат.ПланСчетов);
	ДанныеРегистра.Вставить("МаксимальноеКоличествоСубконто",Результат.МаксимальноеКоличествоСубконто);
	
	Возврат ДанныеРегистра;
		
КонецФункции // ПолучитьДанныеРегистраБД()

Функция ПолучитьДанныеСчетаБД(СчетБД)
	
	Если Не ЗначениеЗаполнено(СчетБД) Тогда
		
		Возврат Новый Структура("Код");
		
	КонецЕсли;	
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СчетаБД.Код КАК Код,
	|	СчетаБД.Наименование КАК Наименование,
	|	СчетаБД.Забалансовый КАК Забалансовый,
	|	СчетаБД.Валютный КАК Валютный,
	|	СчетаБД.ВидыСубконто.(
	|		НомерСтроки КАК НомерСтроки,
	|		Номер КАК Номер,
	|		ВидСубконто КАК ВидСубконто,
	|		ТолькоОбороты КАК ТолькоОбороты,
	|		ТолькоСальдо КАК ТолькоСальдо,
	|		ПризнакиУчетаСубконто КАК ПризнакиУчетаСубконто,
	|		ТипДанных КАК ТипДанных
	|	) КАК ВидыСубконто,
	|	СчетаБД.Вид КАК Вид
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|ГДЕ
	|	СчетаБД.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",СчетБД);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Результат.Следующий();
	
	ДанныеСчета=Новый Структура;
	ДанныеСчета.Вставить("Код",				Результат.Код);
	ДанныеСчета.Вставить("Наименование",	Результат.Наименование);
	ДанныеСчета.Вставить("Забалансовый",	Результат.Забалансовый);
	ДанныеСчета.Вставить("Валютный",		Результат.Валютный);
	
	Если Результат.Вид=Перечисления.ВидыСчетовБД.Активный Тогда
		
		ДанныеСчета.Вставить("Вид",	"Активный");
		
	ИначеЕсли Результат.Вид=Перечисления.ВидыСчетовБД.Пассивный Тогда
		
		ДанныеСчета.Вставить("Вид",	"Пассивный");
		
	Иначе
		
		ДанныеСчета.Вставить("Вид",	"АктивноПассивный");
		
	КонецЕсли;
			
	ДанныеСчета.Вставить("ВидыСубконто",	Результат.ВидыСубконто.Выгрузить());
	
	Возврат ДанныеСчета;	
	
КонецФункции // ПолучитьДанныеСчетаБД() 

Функция ПолучитьМассивВыводимыхРесурсов()
	
	МассивВыводимыхРесурсов=Новый Массив;
	
	ВыводимыеРесурсы=ТабВыводимыеРесурсы.НайтиСтроки(Новый Структура("Выводить",Истина));

	Для Каждого Строка ИЗ ВыводимыеРесурсы Цикл
		
		СтрРесурс=Новый Структура;
		
		Для Каждого Колонка ИЗ ТабВыводимыеРесурсы.Колонки Цикл
			
			СтрРесурс.Вставить(Колонка.Имя,Строка[Колонка.Имя]);
			
		КонецЦикла;
		
		МассивВыводимыхРесурсов.Добавить(СтрРесурс);
		
	КонецЦикла;
	
	Возврат МассивВыводимыхРесурсов; 
		
КонецФункции // ПолучитьМассивВыводимыхРесурсов()

Функция ПолучитьПоляДетализации()
	
	ИспользуемыеПоляДетализации=ТабПоляДетализации.Скопировать();
	ИспользуемыеПоляДетализации.Колонки.Добавить("ЕстьКод",			ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ИспользуемыеПоляДетализации.Колонки.Добавить("ЕстьНаименование",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ИспользуемыеПоляДетализации.Колонки.Добавить("ПолеЗапроса");
	
	Для Каждого СтрИзмерение ИЗ ИспользуемыеПоляДетализации Цикл
		
		Если СтрИзмерение.ПсевдонимПоля="КоррСчетОборот" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если СтрНайти(СтрИзмерение.ИмяПоля,"Субконто")>0 Тогда
			
			Если ИтогЕстьОборотПоСчетам() Тогда
				
				Если СтрНайти(СтрИзмерение.ИмяПоля,"Дт")=0
					И СтрНайти(СтрИзмерение.ИмяПоля,"Кт")=0 Тогда
					
					СтрИзмерение.ПолеЗапроса=СтрЗаменить(СтрИзмерение.ИмяПоля,"Субконто","СубконтоДт"); 
					
				Иначе
					
					СтрИзмерение.ПолеЗапроса=СтрИзмерение.ИмяПоля;
					
				КонецЕсли;
				
			Иначе
				
				СтрИзмерение.ПолеЗапроса=СтрЗаменить(СтрЗаменить(СтрИзмерение.ИмяПоля,"Дт",""),"Кт","");
				
			КонецЕсли;
			
		Иначе			
			
			СтрИзмерение.ПолеЗапроса=ДобавитьКСубконтоПризнакДтКт(СтрИзмерение.ИмяПоля);
			
		КонецЕсли;
		
		Если СтрИзмерение.ТипМетаДанных="Справочник" Тогда
			
			СтрокаПоказатель=НайтиСтрокуДанныхВИБПоПолю(СтрИзмерение.ПолеЗапроса);
			ЕстьКодНаименование=РаботаСПолямиАналитикиУХ.ОпределитьИспользованиеКодаИНаименования(СтрокаПоказатель,ТипБД);	
			
			СтрИзмерение.ЕстьКод			= ЕстьКодНаименование.ЕстьКод;
			СтрИзмерение.ЕстьНаименование	= ЕстьКодНаименование.ЕстьНаименование;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИспользуемыеПоляДетализации;
	
КонецФункции // ПолучитьПоляДетализации()

Функция ОпределитьПолеОтбора(ПолеБД)
	
	Если СтрНайти(ПолеБД,"Субконто")=0 Тогда
		
		Возврат ПолеБД;
		
	Иначе
		
		МассивПутей=СтрРазделить(ПолеБД,".");
		
		СтрПоле=мТаблицаПоказателейБД.Найти(МассивПутей[0],"ПолеБД");
		
		Если (НЕ СтрПоле=Неопределено) И СтрПоле.ТипЗначения.Количество()=1 Тогда
			
			ТипЗначения= СтрПоле.ТипЗначения[0].Значение;
			
			МассивПутей[0]="ВЫРАЗИТЬ("+МассивПутей[0]+" КАК "+ТипЗначения+")";
			
			Возврат СтрСоединить(МассивПутей,".");	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПолеБД;
	
КонецФункции // ОпределитьПолеОтбора() 

Процедура СформироватьПредставлениеПараметров(ИспользуемыеПараметры)
	
	Для Каждого СтрокаПараметр ИЗ ИспользуемыеПараметры Цикл
		
		Если СтрокаПараметр.ИмяПараметра="ПланСчетов" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СтрПравило=ТабПравилаВычисленияПараметров.Найти(СтрокаПараметр.ИмяПараметра,"ИмяПараметра");		
		СтрокаПараметр.ПредставлениеПараметра=УправлениеОтчетамиУХ.ПолучитьТекстОтбора(СтрПравило.УточнениеСпособаОпределения);	
		СтрокаПараметр.ИмяПараметра = СтрЗаменить(СтрокаПараметр.ИмяПараметра, ".", "");
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьПредставлениеПараметров() 
 
Функция СформироватьОтчет() Экспорт
		
	МассивВыводимыхРесурсов=ПолучитьМассивВыводимыхРесурсов();
		
	Если МассивВыводимыхРесурсов.Количество()=0 Тогда
		
		Возврат Новый Структура("РезультатЗаполнения,ЗаголовокОтчета",Новый ТабличныйДокумент,"");
		
	КонецЕсли;
	
	ДанныеРегистра	= ПолучитьДанныеРегистраБД();
	
	Если ВнешняяИБ=1 Тогда
		
		ПолучитьСоединениеВИБ();
		
		Если ТекСоединениеВИБ=Неопределено Тогда
			
			Возврат Новый Структура("РезультатЗаполнения",Новый ТабличныйДокумент);
			
		КонецЕсли;
		
		ПодготовитьТаблицуОтбораВИБ();
		
	Иначе
		
		ПравилаВычисленияПараметровЗапроса=мТабПравилаВычисленияПараметров.Скопировать();
		
		Для Каждого СтрокаПараметр ИЗ ПравилаВычисленияПараметровЗапроса Цикл
			
			ТекПараметрВИБ=НайтиСтрокуДанныхВИБПоПолю(СтрокаПараметр.ИмяПараметра);
			
			Если НЕ ТекПараметрВИБ=Неопределено Тогда
				
				СтрокаПараметр.ИмяПараметра = ДобавитьКСубконтоПризнакДтКт(ТекПараметрВИБ);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПолеПланСчетов="ПланСчетовБД" Тогда
			
			НоваяСтрока=ПравилаВычисленияПараметровЗапроса.Добавить();
			НоваяСтрока.ИмяПараметра="ПланСчетовБД";
			НоваяСтрока.ПолеБД="ПланСчетовБД";
			НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НоваяСтрока.УточнениеСпособаОпределения=ПланСчетовБД;
			
		ИначеЕсли ПолеПланСчетов="ПланСчетов" Тогда
			
			НоваяСтрока=ПравилаВычисленияПараметровЗапроса.Добавить();
			НоваяСтрока.ИмяПараметра="ПланСчетов";
			НоваяСтрока.ПолеБД="ПланСчетов";
			НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НоваяСтрока.УточнениеСпособаОпределения=ПланСчетовБД; 
			
		КонецЕсли;
		
		ТекСоединениеВИБ=РаботаСОбъектамиМетаданныхУХ.КонтекстМетаданных();
		
	КонецЕсли;
	
	ТаблицаДопИзмерений 	= СформироватьТаблицуДопИзмерений();
	
	////////////////////////////////////////////////////////////////////////////////////
	// Подготавливаем параметры для вызова обработки формирования отчета
	
		
	ДанныеСчета		= ПолучитьДанныеСчетаБД(Счет);
	ДанныеКоррСчета	= ПолучитьДанныеСчетаБД(КоррСчет);

	ПравилаИтоги					= ТрансформироватьПравилаВывода(ПравилаВыводаИтогов);	
	ПравилаСальдо					= ТрансформироватьПравилаВывода(ПравилаРазвернутогоСальдо);
	ИспользуемыеПараметры			= ?(ВнешняяИБ=1,ПодготовитьТаблицуПараметровВИБ(),ПодготовитьТаблицуПараметровТек());
	
	СформироватьПредставлениеПараметров(ИспользуемыеПараметры);
	
	ТекстОшибки						= "";
	
	ДанныеДляЗаголовка				= Новый Структура;
	
	Для Каждого СтрокаПараметр ИЗ мТабПравилаВычисленияПараметров Цикл
		
		ДанныеСтроки=НайтиСтрокуДанныхВИБПоПолю(СтрокаПараметр.ПолеБД);
		
		Если ДанныеСтроки=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ДанныеСтроки.Измерение Тогда
			
			Если СтрокаПараметр.ПолеБД="Регистратор" Тогда
				
				Если ТипЗнч(СтрокаПараметр.УточнениеСпособаОпределения)=Тип("СписокЗначений") Тогда 
					
					ДанныеДляЗаголовка.Вставить(СтрокаПараметр.ИмяПараметра,Строка(СтрокаПараметр.УточнениеСпособаОпределения[0].Значение));
					
				Иначе
					
					ДанныеДляЗаголовка.Вставить(СтрокаПараметр.ИмяПараметра,Строка(СтрокаПараметр.УточнениеСпособаОпределения));
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(СтрокаПараметр.УточнениеСпособаОпределения)=Тип("СписокЗначений") Тогда
				
				Если СтрокаПараметр.УточнениеСпособаОпределения.Количество()=1 Тогда
					
					ДанныеДляЗаголовка.Вставить(СтрокаПараметр.ИмяПараметра,СтрокаПараметр.УточнениеСпособаОпределения[0].Представление);
					
				КонецЕсли;
				
			Иначе					
				
				ДанныеДляЗаголовка.Вставить(СтрокаПараметр.ИмяПараметра,Строка(СтрокаПараметр.УточнениеСпособаОпределения));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВнешняяИБ=1 Тогда
		
		ДанныеДляЗаголовка.Вставить("ИспользуемаяИБ",ИспользуемаяИБ.Наименование);
		
	Иначе
		
		ДанныеДляЗаголовка.Вставить("ИспользуемаяИБ",Нстр("ru = 'Текущая информационная база'; en = 'Current database';tr = 'Mevcut infobase'"));
		
	КонецЕсли;
	
	ИспользуемыеПоляДетализации=ПолучитьПоляДетализации();	
	
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ДатаНач",ДатаНач);
	СтруктураПараметров.Вставить("ДатаКон",ДатаКон);
	СтруктураПараметров.Вставить("ПоСубсчетам",ПоСубсчетам);
	СтруктураПараметров.Вставить("РазвернутоеСальдо",РазвернутоеСальдо);
	СтруктураПараметров.Вставить("ВидОтчета",ВидОтчета);
	СтруктураПараметров.Вставить("Период",Период);
	СтруктураПараметров.Вставить("ПоСубсчетамИСубконто",ПоСубсчетамИСубконто);
	СтруктураПараметров.Вставить("ПоКорСубсчетамИСубконто",ПоКорСубсчетамИСубконто);
	СтруктураПараметров.Вставить("ПоЗабалансовымСчетам",ПоЗабалансовымСчетам);
	СтруктураПараметров.Вставить("ТабВыводимыеРесурсы",ТабВыводимыеРесурсы);
	
	СтруктураПараметров.Вставить("ТаблицаГруппировок",ТаблицаГруппировок);
	
	СтруктураПараметров.Вставить("МассивДопИзмерений",МассивДопИзмерений);
	
	СтруктураПараметров.Вставить("МассивВыводимыхРесурсов",МассивВыводимыхРесурсов);//
	
	СтруктураПараметров.Вставить("ТаблицаДопИзмерений",ТаблицаДопИзмерений);
	СтруктураПараметров.Вставить("ИспользуемыеПараметры",ИспользуемыеПараметры);
	
	СтруктураПараметров.Вставить("ИспользуемыеПоляДетализации",ИспользуемыеПоляДетализации);
	СтруктураПараметров.Вставить("ДанныеДляЗаголовка",ДанныеДляЗаголовка);
	СтруктураПараметров.Вставить("ДанныеРегистра",ДанныеРегистра);
	СтруктураПараметров.Вставить("ДанныеСчета",ДанныеСчета);
	СтруктураПараметров.Вставить("ДанныеКоррСчета",ДанныеКоррСчета);
	СтруктураПараметров.Вставить("ПравилаИтоги",ПравилаИтоги);
	СтруктураПараметров.Вставить("ПравилаСальдо",ПравилаСальдо);
	СтруктураПараметров.Вставить("МассивБалансовыеБезИзмерений",МассивБалансовыеБезИзмерений);
	СтруктураПараметров.Вставить("МассивБалансовыеСИзмерениями",МассивБалансовыеСИзмерениями);
	СтруктураПараметров.Вставить("МассивНебалансовыеБезИзмерений",МассивНебалансовыеБезИзмерений);
	СтруктураПараметров.Вставить("МассивНебалансовыеСИзмерениями",МассивНебалансовыеСИзмерениями);
	СтруктураПараметров.Вставить("ВнешняяИБ",ВнешняяИБ);
	СтруктураПараметров.Вставить("ТекстОшибки",ТекстОшибки);
	СтруктураПараметров.Вставить("ОсновнаяТаблицаРегистра",ОсновнаяТаблицаРегистра);
	СтруктураПараметров.Вставить("ВидДвижения",ВидДвижения);
	
	Если ЗначениеЗаполнено(ИсточникДанных) Тогда
		
		ДанныеИсточника=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсточникДанных,"УчитыватьКоррСчета,ДтКт");
		
		Если ДанныеИсточника.УчитыватьКоррСчета Тогда
			
			Если ДанныеИсточника.ДтКт="Дт" Тогда 
				
				СтруктураПараметров.Вставить("ТекстОтбораИсточник",СтрЗаменить(ТекстОтбораИсточник,"Субконто","СубконтоДт")); 
				
			Иначе
				
				СтруктураПараметров.Вставить("ТекстОтбораИсточник",СтрЗаменить(ТекстОтбораИсточник,"Субконто","СубконтоКт"));
				
			КонецЕсли;
			
		Иначе
			
			СтруктураПараметров.Вставить("ТекстОтбораИсточник",ТекстОтбораИсточник);
			
		КонецЕсли;
		
	Иначе
		
		СтруктураПараметров.Вставить("ТекстОтбораИсточник",ТекстОтбораИсточник);
		
	КонецЕсли;
	
	НастройкаУниверсальныхОтчетовПоРегистрамУХ.СформироватьТекстОтбораИтог(СтруктураПараметров);
		
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда
				
		Возврат ТекСоединениеВИБ.GetDataForReportRegister(Новый ХранилищеЗначения(СтруктураПараметров, Новый СжатиеДанных(9)),
				Новый ХранилищеЗначения(Новый Структура, Новый СжатиеДанных(9))).Получить();
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		РезультатЗапроса=РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"GetDataForReportRegister",СтруктураПараметров);
		
		Если РезультатЗапроса=Неопределено Тогда
			
			Возврат Новый Структура("ТаблицаДляОтображения,ТекстОшибки,ЗаголовокОтчета",Новый ТабличныйДокумент,"","");
			
		Иначе
			
			Возврат РезультатЗапроса; 
			
		КонецЕсли;
		
	Иначе
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.GetDataForReportRegister(ТекСоединениеВИБ,СтруктураПараметров);
						
	КонецЕсли;
				
КонецФункции // СформироватьОтчет() 

