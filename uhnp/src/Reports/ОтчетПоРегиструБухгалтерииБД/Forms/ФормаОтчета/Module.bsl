&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия="ВыбраноПолеСубконтоОтбора"
		ИЛИ ИмяСобытия="ВыбраноПолеСубконтоДетализации"
		ИЛИ ИмяСобытия="ВыбраноПолеСубконтоРасшифровки" Тогда
		
		РабочийОбъектАдрес=Параметр.РабочийОбъектАдрес;
		
		ОбновитьТаблицыФормыПоОбъекту();
		
		ДанныеСтроки=Параметр.ДанныеСтроки;
		
		Если ИмяСобытия="ВыбраноПолеСубконтоОтбора" Тогда
			
			НоваяСтрока=Отчет.ТабПравилаВычисленияПараметров.Добавить();
			НоваяСтрока.ПолеБД=ДанныеСтроки.ПолеБД;
			НоваяСтрока.ПредставлениеПараметра=ДанныеСтроки.НаименованиеБД;
			НоваяСтрока.СпособВычисленияПараметра=ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеИспользуется");
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ДанныеСтроки);
			
			НоваяСтрока.ПолеБД=НоваяСтрока.ПолеБД;
			
		ИначеЕсли ИмяСобытия="ВыбраноПолеСубконтоДетализации" Тогда
			
			НоваяСтрока=Отчет.ТабПоляДетализации.Добавить();
			НоваяСтрока.ИмяПоля=ДанныеСтроки.ПолеБД;
			НоваяСтрока.ПсевдонимПоля=СтрЗаменить(ДанныеСтроки.ПолеБД,".","");
			НоваяСтрока.ПредставлениеПоля=ДанныеСтроки.НаименованиеБД;
			НоваяСтрока.ТипМетаДанных=ДанныеСтроки.ТипМетаДанных;
			
		ИначеЕсли ИмяСобытия="ВыбраноПолеСубконтоРасшифровки" Тогда
			
			 ПараметрыРасшифровки=ДанныеСтроки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

