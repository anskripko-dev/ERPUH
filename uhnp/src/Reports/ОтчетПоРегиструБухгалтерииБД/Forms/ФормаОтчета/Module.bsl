&НаКлиенте
Функция ПолучитьНаименованиеСсылочногоТипа(Тип)
	
	Если СтрНайти(Тип,"Справочник")>0 Тогда
		Возврат "Справочник";
	ИначеЕсли СтрНайти(Тип,"Перечисление")>0 Тогда
		Возврат "Перечисление";
	ИначеЕсли СтрНайти(Тип,"Документ")>0 Тогда
		Возврат "Документ";
	ИначеЕсли СтрНайти(Тип,"ПланСчетов")>0 Тогда
		Возврат "ПланСчетов";
	Иначе
		Возврат "НеПоддерживается";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПримитивныйТип(Тип)
	
	Возврат (Тип = Тип("Строка") ИЛИ Тип = Тип("Дата") ИЛИ Тип = Тип("Булево") ИЛИ Тип = Тип("Число"));	
	
КонецФункции

#Область ВыборЗначенияИзмерения

&НаКлиенте
Процедура ТабОтборПоИзмерениямЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТабОтборПоИзмерениям.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеБД	= ТекущаяСтрока.ПолеБД;	
	ТекЗначениеПоля = ТекущаяСтрока.Значение;
	
	СтандартнаяОбработка = Ложь;
		
	МассивИзмерений = мТаблицаПоказателейБД.НайтиСтроки(Новый Структура("ПолеБД", ПолеБД));
    ТекПараметрВИБ = МассивИзмерений[0];
	
	/////////////////////////////////////////////////////////////////////////////////////////////
    // Определим тип для выбора в случае составного
	
	ДопПараметры = Новый Структура("ТекЗначениеПоля, ТекПараметрВИБ, ТекущаяСтрока, Элемент", 
									ТекЗначениеПоля, ТекПараметрВИБ, ТекущаяСтрока, Элемент);
	
    Если ТекПараметрВИБ.ТипЗначения.Количество()>1 Тогда
        
        // Получим список доступных типов для выбора
        
        СписокТипов = Новый СписокЗначений;
        
        Для Каждого СтрТип ИЗ ТекПараметрВИБ.ТипЗначения Цикл
            
            ТекущийТип = СтрТип.Значение;
            
            ТекТипМетаданных = ПолучитьНаименованиеСсылочногоТипа(ТекущийТип);
            
            СписокТипов.Добавить(ТекТипМетаданных, СтрЗаменить(ТекущийТип, ТекТипМетаданных + ".", ""));
            
        КонецЦикла;
        
        Если СписокТипов.Количество()>0 Тогда
			
			Оповещение = Новый ОписаниеОповещения("ОбработатьТипЗначенияВИБ", ЭтотОбъект, ДопПараметры);
			ПоказатьВыборИзСписка(Оповещение, СписокТипов, Элемент);
            Возврат;
            
        КонецЕсли;
        
    КонецЕсли;
		
	ОбработатьТипЗначенияВИБ(Неопределено, ДопПараметры, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьТипЗначенияВИБ(ВыбранныйЭлемент = Неопределено, ДополнительныеПараметры, ВыполнитьОбновлениеТипа = Истина) Экспорт
    
    ТекПараметрВИБ 	= ДополнительныеПараметры.ТекПараметрВИБ;
    
    ТекущийТип = ВыбранныйЭлемент;
	Если ВыполнитьОбновлениеТипа Тогда
		
		Если ТекущийТип <> Неопределено Тогда
			
			ТекПараметрВИБ.ТипМетаДанных=ТекущийТип.Значение;
			ТекПараметрВИБ.СправочникБД=ТекущийТип.Представление;
			
			Если НЕ ТекПараметрВИБ.ТипМетаДанных="Простой" Тогда // Убираем неоднозначность типизации
				
				ТекПараметрВИБ.ТипЗначения.Очистить();
				ТекПараметрВИБ.ТипЗначения.Добавить(ТекПараметрВИБ.ТипМетаДанных + "." + ТекПараметрВИБ.СправочникБД);
				
			КонецЕсли;
			
		Иначе
			
			ТекПараметрВИБ.ТипМетаДанных=Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
    
    Если Отчет.ВнешняяИБ = 0 Тогда
        
        ОткрытьФорму(ТекПараметрВИБ.ТипМетаДанных + "." + ТекПараметрВИБ.СправочникБД + ".ФормаВыбора",, ДополнительныеПараметры.Элемент);
        Возврат;
        
    КонецЕсли;
    
    // Поиск аналитики консолидации, соответствующей аналитике внешней ИБ. Первоначальный поиск осущетсвляется
    // по Таблице соответствия, и, если поиск не дал результатов, в справочнике Синхронизации с Внешними ИБ.
	
	ИспользоватьВнутреннююСинхронизацию = Ложь;
	
	СписокВыбораСоответствий = ПолучитьНастройкуСоответствияРеквизитов(
													Отчет.ТипБД,
													"",
													ТекПараметрВИБ.СправочникБД,
													ТекПараметрВИБ.ТипМетаДанных,
													Ложь);
													
	ЕстьНастройкиСоответствия = СписокВыбораСоответствий.Количество() > 0;
	Если ЕстьНастройкиСоответствия Тогда
		
		ДополнительныеПараметры.Вставить("СписокВыбораСоответствий", СписокВыбораСоответствий);
		
       	СписокЗначений = Новый СписокЗначений;
        СписокЗначений.Добавить("АналитикаКонсолидации",	Нстр("ru = 'Справочник текущей ИБ'; en = 'Current infobase catalog';tr = 'Mevcut infobase katalogu'"));
        СписокЗначений.Добавить("АналитикаБД",				Нстр("ru = 'Справочник внешней ИБ'; en = 'External infobase catalog';tr = 'Dış infobase katalogu'"));
        
        Оповещение = Новый ОписаниеОповещения("ОбработатьВыборИсточникаЗначения", ЭтотОбъект, ДополнительныеПараметры);
        ПоказатьВыборИзСписка(Оповещение, СписокЗначений, ДополнительныеПараметры.Элемент);
        
        Возврат;
	
	КонецЕсли;												
	
	ОбработатьВыборИсточникаЗначения(Новый Структура("Значение", "АналитикаБД"), ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборИсточникаЗначения(ИсточникВыбора = Неопределено, ДополнительныеПараметры) Экспорт
	
	Если ИсточникВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    Если ИсточникВыбора.Значение = "АналитикаКонсолидации" Тогда 
		
		СписокВыбораСоответствий = ДополнительныеПараметры.СписокВыбораСоответствий;
		
		Если СписокВыбораСоответствий.Количество() > 1 Тогда
		    
		    Оповещение = Новый ОписаниеОповещения("ОбработатьВыборНастройкиСоответствия", ЭтотОбъект, ДополнительныеПараметры);
		    СписокВыбораСоответствий.ПоказатьВыборЭлемента(Оповещение, Нстр("ru = 'Выберите настройку синхронизации'; en = 'Select a synchronization setting';tr = 'Senkronizasyon ayarı seç'"));
			
			Возврат;
		    
		КонецЕсли;
		
		ОбработатьВыборНастройкиСоответствия(СписокВыбораСоответствий[0].Значение, ДополнительныеПараметры);
        
    Иначе	
        
        ОткрытьФормуВыбораЗначенияВИБ(ДополнительныеПараметры);
        
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборНастройкиСоответствия(НастройкаСоответствия = Неопределено, ДополнительныеПараметры) Экспорт
	
	Если НастройкаСоответствия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока 	= ДополнительныеПараметры.ТекущаяСтрока;
	ТекЗначениеПоля = ДополнительныеПараметры.ТекЗначениеПоля;
	Элемент			= ДополнительныеПараметры.Элемент;
	
	ТекущаяСтрока.НастройкаСоответствия = НастройкаСоответствия;
	ДанныеСоответствия = ПолучитьДанныеДляВыбора(НастройкаСоответствия);
		
	ТекущаяСтрока.Значение = ПривестиЗначениеПоСоответствиюВИБ(ТекЗначениеПоля, ДанныеСоответствия);
	
	СсылкаНаВидСубконто = (ДанныеСоответствия.ТипОбъектаКонсолидации = "ВидСубконто");
    Если СсылкаНаВидСубконто Тогда
        
        Если ДанныеСоответствия.Тип=Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ") Тогда
            
            СтруктураПараметров = Новый Структура;
            СтруктураПараметров.Вставить("Отбор", Новый Структура("Владелец", ДанныеСоответствия.ИмяОбъектаМетаданных));
            
            Если ЗначениеЗаполнено(ТекЗначениеПоля) Тогда
                СтруктураПараметров.Вставить("НачальноеЗначениеВыбора", ТекЗначениеПоля);
            КонецЕсли;
            
            ОткрытьФорму("Справочник.ПроизвольныйКлассификаторУХ.ФормаВыбора", СтруктураПараметров, Элемент);
            
        Иначе
            
            СтруктураПараметров = Новый Структура;
            Если ЗначениеЗаполнено(ТекЗначениеПоля) Тогда
                СтруктураПараметров.Вставить("НачальноеЗначениеВыбора", ТекЗначениеПоля);
            КонецЕсли;
            
            ОткрытьФорму(ДанныеСоответствия.ТаблицаАналитики + ".ФормаВыбора", СтруктураПараметров, Элемент);
            
        КонецЕсли;	
        
    Иначе
        
        //СтандартнаяОбработка = Истина;
        ПараметрыФормы = Новый Структура("ТекущаяСтрока", ТекЗначениеПоля);
		ИмяФормыВыбора = ДанныеСоответствия.ТипОбъектаКонсолидации + "." + ДанныеСоответствия.ИмяОбъектаМетаданных + ".ФормаВыбора";
        ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, Элемент);
		
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораЗначенияВИБ(ДополнительныеПараметры)
	
	ТекПараметрВИБ 	= ДополнительныеПараметры.ТекПараметрВИБ;
	ТекущаяСтрока 	= ДополнительныеПараметры.ТекущаяСтрока;
	ТекЗначениеПоля	= ДополнительныеПараметры.ТекЗначениеПоля;
	Элемент 		= ДополнительныеПараметры.Элемент;
	
	Если НЕ (ТекПараметрВИБ.ТипМетаДанных = "Справочник" 
		ИЛИ ТекПараметрВИБ.ТипМетаДанных="Документ"
		ИЛИ ТекПараметрВИБ.ТипМетаДанных = "Перечисление") Тогда
		
		Сообщить(Нстр("ru = 'Тип метаданных не поддерживается. Возможен выбор только из справочника и перечислений.'; en = 'This metadata kind is not supported. Select from catalogs and lists only.';tr = 'Bu meta veri türü desteklenmiyor. Yalnızca kataloglardan ve listelerden seç.'"));
		Возврат;
		
	КонецЕсли;
	
	ТекущаяСтрока.НастройкаСоответствия = "";
	
	Значение = ТекЗначениеПоля;
	Массив   = Новый Массив;
	Массив.Добавить(Тип("СписокЗначений"));
	ОписаниеТипов    = Новый ОписаниеТипов(Массив);
	ТекущаяСтрока.Значение = ОписаниеТипов.ПривестиЗначение(Значение);
	
    СтруктураДанных = Новый Структура;
    СтруктураДанных.Вставить("СправочникБД",	ТекПараметрВИБ.СправочникБД);
    СтруктураДанных.Вставить("ТипМетаДанных",	ТекПараметрВИБ.ТипМетаДанных);
    СтруктураДанных.Вставить("ТипБД",			Отчет.ТипБД);
    
    Если ТипЗнч(ТекЗначениеПоля) = Тип("СписокЗначений") И ТекЗначениеПоля.Количество() > 0 Тогда
        
        СтруктураДанных.Вставить("Код",				ТекЗначениеПоля[0].Значение);
        СтруктураДанных.Вставить("Наименование", 	ТекЗначениеПоля[0].Представление);
        
    КонецЕсли;
    
    ДанныеОбъектаВИБ = Неопределено;
    
    ДопПараметры = Новый Структура("ТекущаяСтрока", ТекущаяСтрока);
    ПараметрыФормы = Новый ОписаниеОповещения("Подключаемый_ОбработатьВыборИсточникаДанных", ЭтотОбъект, ДопПараметры);
    ОткрытьФорму("Справочник.ИсточникиДанныхДляРасчетов.Форма.ФормаВыбораЗначенийВИБ",
    				СтруктураДанных, Элемент,,,, ПараметрыФормы, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьВыборИсточникаДанных(Результат, ДополнительныеПараметры) Экспорт
    
    ТекущаяСтрока = ДополнительныеПараметры.ТекущаяСтрока;
        
    ДанныеОбъектаВИБ = Результат;
    
    Если ТипЗнч(ДанныеОбъектаВИБ) = Тип("СписокЗначений") Тогда
        
        ТекущаяСтрока.Значение = ДанныеОбъектаВИБ;
        ТекущаяСтрока.Отбирать = Истина;
        
    КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПривестиЗначениеПоСоответствиюВИБ(Знач Значение, ДанныеСоответствия)

	Если ДанныеСоответствия.ТипОбъектаКонсолидации = "ВидСубконто" Тогда
		
		Возврат ДанныеСоответствия.ТипЗначения.ПривестиЗначение(Значение);
		
	Иначе
		
		ТипПриведения = Тип(ДанныеСоответствия.ТипОбъектаКонсолидации + "Ссылка." + ДанныеСоответствия.ИмяОбъектаМетаданных);
		
		МассивДоступныхТипов = Новый Массив;
		МассивДоступныхТипов.Добавить(ТипПриведения);
		ОписаниеТипов = Новый ОписаниеТипов(МассивДоступныхТипов);
		
		Возврат  ОписаниеТипов.ПривестиЗначение(Значение);
		
	КонецЕсли; 

КонецФункции

#КонецОбласти

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	ВывестиОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаПриИзменении(Элемент)
	
	УстановитьВидимость();
	
	Если Отчет.ВидОтчета="ОтчетПоПроводкам" Тогда	
		
		Отчет.ТабПравилаВычисленияПараметров.Очистить();
		ИзменитьСчет();
		ИзменитьКоррСчет();
		
	Иначе	
		
		Если ЗначениеЗаполнено(Отчет.КоррСчет) Тогда	
			Отчет.КоррСчет="";
			Отчет.ТабПравилаВычисленияПараметров.Очистить();
			ИзменитьСчет();
			ИзменитьКоррСчет();
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отчет.ВидОтчета="ОборотноСальдоваяВедомость" Тогда
		Отчет.Счет="";
		Отчет.ТабПравилаВычисленияПараметров.Очистить();
		ОбновитьТаблицуРесурсов();
	КонецЕсли;
		
	Отчет.Период="ПЕРИОД";
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыОтчетаПоПроводкам(СтруктураПараметров)
	
	Возврат Обработки.КорректировкиЗначенийПоказателей.ПолучитьПараметрыОтчетаПоПроводкам(СтруктураПараметров.Ключ,СтруктураПараметров.НомерПроводки);
			
КонецФункции // ПолучитьПараметрыОтчетаПоПроводкам()

&НаКлиенте
Процедура ТабРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
		
	Если ТипЗнч(Расшифровка)=Тип("Структура") И Расшифровка.Свойство("ДокументОперации") Тогда
		
		ДанныеОбъекта=ОткрытьДокументОперации(Расшифровка);
		
		Если ДанныеОбъекта=Неопределено Тогда // Открылась форма в толстом клиенте
			
			Возврат;
			
		ИначеЕсли ДанныеОбъекта.Свойство("ИмяОбъектаМетаданных") Тогда
			
			Если ДанныеОбъекта.ИмяОбъектаМетаданных="Документ.Трансляция" Тогда
				
				ПараметрыОтчета=ПолучитьПараметрыОтчетаПоПроводкам(ДанныеОбъекта.СтруктураПараметров);
				
				Если ПараметрыОтчета=Неопределено
					ИЛИ  ПараметрыОтчета.ТрансляцияФинансовыхРегистров Тогда
					
					ОткрытьФорму(ДанныеОбъекта.ИмяОбъектаМетаданных+".ФормаОбъекта",ДанныеОбъекта.СтруктураПараметров);
					
				Иначе
												
					ОткрытьФорму("Отчет.ОтчетПоРегиструБухгалтерииБД.ФормаОбъекта",ПараметрыОтчета,ЭтаФорма,Новый УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.Независимый);
								
				КонецЕсли;
				
			Иначе
				
				ОткрытьФорму(ДанныеОбъекта.ИмяОбъектаМетаданных+".ФормаОбъекта",ДанныеОбъекта.СтруктураПараметров);
				
			КонецЕсли;
			
		Иначе
			
			Если ТипЗнч(ДанныеОбъекта)=Тип("Структура") Тогда
				
				Имя = "ОбщаяФорма.ОтображениеЭлементаWS_Управляемая";
				ОткрытьФорму(Имя, Новый Структура("Расшифровка, ИспользуемаяИБ", ДанныеОбъекта, Отчет.ИспользуемаяИБ));
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Расшифровка)=Тип("СписокЗначений") И Расшифровка.Количество()=1 Тогда
		
		ДанныеРасшифровки=Расшифровка[0].Значение;
		СчетРасшифровки=ДанныеРасшифровки.Получить("Счет");
		
		СтруктураПараметров=Новый Структура;
		
		Если Отчет.ВидОтчета="ОборотноСальдоваяВедомость" И (Не ПустаяСтрока(СчетРасшифровки)) Тогда
			
			СписокОтчетов=Новый СписокЗначений;
			СписокОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету",СтрШаблон(Нстр("ru = 'ОСВ по счету %1'; en = 'Trial balance on account %1';tr = '%1hesap geçici mizanı'"), СчетРасшифровки));
			СписокОтчетов.Добавить("КарточкаСчета",СтрШаблон(Нстр("ru = 'Карточка счета %1'; en = 'Account card %1';tr = '%1Hesap kartı'"), СчетРасшифровки));
			СписокОтчетов.Добавить("АнализСчета",СтрШаблон(Нстр("ru = 'Анализ счета %1'; en = 'Analysis of account %1';tr = '%1Hesap analizi'"), СчетРасшифровки));
			
			ТекВидОтчета = Неопределено;
			
			ДопПараметры = Новый Структура("ДанныеРасшифровки, СтруктураПараметров, СчетРасшифровки", 
											ДанныеРасшифровки, СтруктураПараметров, СчетРасшифровки);
			Оповещение = Новый ОписаниеОповещения("Подключаемый_РасшифровкаОСВ", ЭтотОбъект, ДопПараметры);
			СписокОтчетов.ПоказатьВыборЭлемента(Оповещение, Нстр("ru = 'Выберите расшифровку'; en = 'Select drilldown';tr = 'Detaylandırmayı seç'"));
			
			Возврат;
			
		Иначе
			
			Если Не ДанныеРасшифровки.Получить("КоррСчет")=Неопределено Тогда
				СтруктураПараметров.Вставить("ВидОтчета","ОтчетПоПроводкам");
				СтруктураПараметров.Вставить("КоррСчет",ДанныеРасшифровки.Получить("КоррСчет"));
			Иначе
				СтруктураПараметров.Вставить("ВидОтчета","КарточкаСчета");
			КонецЕсли;			
			
		КонецЕсли;
		
		ОткрытьФормуОтчетаПоРБ(ДанныеРасшифровки, СтруктураПараметров, СчетРасшифровки);
		
	ИначеЕсли ТипЗнч(Расшифровка)=Тип("ДокументСсылка.Трансляция") И ЗначениеЗаполнено(НомерПроводки) Тогда
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("Ключ",Расшифровка);
		СтруктураПараметров.Вставить("НомерПроводки",НомерПроводки);
		СтруктураПараметров.Вставить("РежимРасшифровки",Истина);
		СтруктураПараметров.Вставить("ИмяОбъектаМетаданных","Трансляция");
		
		ОткрытьФорму("Обработка.КорректировкиЗначенийПоказателей.Форма",СтруктураПараметров,,Истина);
		
		
	Иначе
		
		СтандартнаяОбработка=Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РасшифровкаОСВ(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
    
    ДанныеРасшифровки 	= ДополнительныеПараметры.ДанныеРасшифровки;
    СтруктураПараметров = ДополнительныеПараметры.СтруктураПараметров;
    СчетРасшифровки 	= ДополнительныеПараметры.СчетРасшифровки;
        
    ТекВидОтчета = ВыбранныйЭлемент;
    
    Если Не ТекВидОтчета = Неопределено Тогда
        
        СтруктураПараметров.Вставить("ВидОтчета", ТекВидОтчета.Значение);
        
        Если ТекВидОтчета.Значение = "ОборотноСальдоваяВедомостьПоСчету" Тогда
            
            СтруктураПараметров.Вставить("ПолнаяДетализация", Истина);
            
        КонецЕсли;
        
    Иначе
        
        СтруктураПараметров.Вставить("ВидОтчета", "КарточкаСчета");
        
    КонецЕсли;
        
    ОткрытьФормуОтчетаПоРБ(ДанныеРасшифровки, СтруктураПараметров, СчетРасшифровки);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтчетаПоРБ(ДанныеРасшифровки, СтруктураПараметров, СчетРасшифровки)
    
    Если ПустаяСтрока(СчетРасшифровки) И (Не Отчет.ВидОтчета="ОборотноСальдоваяВедомость") Тогда
        ДанныеРасшифровки.Вставить("Счет",ПолучитьКодСчета(Отчет.Счет));
    КонецЕсли;
    
    СтруктураПараметров.Вставить("ДатаНач",					Отчет.ДатаНач);
    СтруктураПараметров.Вставить("ДатаКон",					Отчет.ДатаКон);
    СтруктураПараметров.Вставить("РегистрБД",				Отчет.РегистрБД);
    СтруктураПараметров.Вставить("ИспользуемаяИБ",			Отчет.ИспользуемаяИБ);
    СтруктураПараметров.Вставить("ФормироватьПриОткрытии",	Истина);
    СтруктураПараметров.Вставить("ПоСубсчетам",				(Отчет.ПоСубсчетам ИЛИ Отчет.ПоСубсчетамИСубконто));
    СтруктураПараметров.Вставить("ПоСубсчетамИСубконто",	Отчет.ПоСубсчетамИСубконто);
	СтруктураПараметров.Вставить("ПланСчетовБД",			Отчет.ПланСчетовБД); 
	СтруктураПараметров.Вставить("ТекстОтбораИсточник",		Отчет.ТекстОтбораИсточник);
	СтруктураПараметров.Вставить("ИсточникДанных",			Отчет.ИсточникДанных);

        
    ВыводимыеРесурсы = Отчет.ТабВыводимыеРесурсы.НайтиСтроки(Новый Структура("Выводить",Истина));
    СписокПоказателей = Новый СписокЗначений;
    
    Для Каждого СтрРесурс ИЗ ВыводимыеРесурсы Цикл        
        СписокПоказателей.Добавить(СтрРесурс.ИмяПоля,СтрРесурс.ПредставлениеПоля);        
    КонецЦикла;
    
    СтруктураПараметров.Вставить("СписокПоказателей", СписокПоказателей);
	СтруктураПараметров.Вставить("ОсновнаяТаблицаРегистра", Отчет.ОсновнаяТаблицаРегистра);
	СтруктураПараметров.Вставить("ВидДвижения", Отчет.ВидДвижения);

    
    ОтборПоИзмерениям=Новый Массив;
    
    ДанныеОтбора=ТабОтборПоИзмерениям.НайтиСтроки(Новый Структура("Отбирать",Истина));
    
    Для Каждого СтрОтбор ИЗ ДанныеОтбора Цикл
        Отбор = Новый Структура("ИмяПараметра,Значение,НастройкаСоответствия,ПолеБД,ПредставлениеПараметра",
								СтрОтбор.ИмяПараметра, СтрОтбор.Значение, СтрОтбор.НастройкаСоответствия, СтрОтбор.ПолеБД,СтрОтбор.ПредставлениеПараметра);
        ОтборПоИзмерениям.Добавить(Отбор);
        
    КонецЦикла;
    
    ОтборПоСубконто=Новый Массив;
    НеИспользуется=ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеИспользуется");
    
    Для Каждого СтрПараметр ИЗ Отчет.ТабПравилаВычисленияПараметров Цикл
        
        Если СтрПараметр.СпособВычисленияПараметра=НеИспользуется Тогда
            Продолжить;
        КонецЕсли;
        
        СтруктураОтбора = Новый Структура;
        СтруктураОтбора.Вставить("ИмяПараметра",				СтрПараметр.ИмяПараметра);
		СтруктураОтбора.Вставить("ПолеБД",						СтрПараметр.ПолеБД);
        СтруктураОтбора.Вставить("ПредставлениеПараметра",		СтрПараметр.ПредставлениеПараметра);
        СтруктураОтбора.Вставить("СпособВычисленияПараметра",	СтрПараметр.СпособВычисленияПараметра);
        СтруктураОтбора.Вставить("УточнениеСпособаОпределения",	СтрПараметр.УточнениеСпособаОпределения);
        СтруктураОтбора.Вставить("НастройкаСоответствия",		СтрПараметр.НастройкаСоответствия);
        
        ОтборПоСубконто.Добавить(СтруктураОтбора);
        
    КонецЦикла;
    
    ДополнительныеОтборы = ДанныеРасшифровки["ДополнительныеОтборы"];
    
    Если НЕ ДополнительныеОтборы = Неопределено Тогда
        
        Для Каждого ТекОтбор ИЗ ДополнительныеОтборы Цикл
            
            МассивПолей=Отчет.ТабПоляДетализации.НайтиСтроки(Новый Структура("ИмяПоля",ТекОтбор.ИмяПараметра));
            
            Если МассивПолей.Количество()>0 Тогда
                
                СтрПоля=МассивПолей[0];
                ТекОтбор.Вставить("ИмяПараметра","П_"+СтрПоля.ИмяПоля);
				ТекОтбор.Вставить("ПолеБД",СтрПоля.ИмяПоля);
                         
            КонецЕсли;
            
        КонецЦикла;
        
    КонецЕсли;
    
    МассивПроизводные=Новый Массив;
    Для Каждого Строка ИЗ мТаблицаПроизводныхБД Цикл
        
        СтруктураПроизводных=Новый Структура("ПолеБД,НаименованиеБД,ПредставлениеПоля,ТипЗначения,ТипМетаДанных,ТипДанныхПоля,ТолькоОбороты,ПризнакиУчетаСубконто,Измерение,Дебетовый,СправочникБД,Балансовый,ПризнакУчета");
        ЗаполнитьЗначенияСвойств(СтруктураПроизводных,Строка);
        
        МассивПроизводные.Добавить(СтруктураПроизводных);
        
    КонецЦикла;
    
    СтруктураПараметров.Вставить("МассивПроизводные",	МассивПроизводные);
    СтруктураПараметров.Вставить("ДанныеРасшифровки",	ДанныеРасшифровки);
