&НаСервереБезКонтекста
Функция ПолучитьСписокСпособовВычисления(ТипМетаДанных)

	СписокВыбора=Новый СписокЗначений;
	
	Если ТипМетаДанных="Простой" Тогда
		
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, Нстр("ru = 'Фиксированное значение'; en = 'Fixed value';tr = 'Sabit değer'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению, Нстр("ru = 'Не равно фиксированному значению'; en = 'Not equal to a fixed value';tr = 'Sabit bir değere eşit değil'"));																								   
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Нстр("ru = 'Список фиксированных значений'; en = 'Fixed value list';tr = 'Sabit değer listesi'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений, Нстр("ru = 'Не в списке фиксированных значений'; en = 'Not in the fixed value list';tr = 'Sabit değer listesinde değil'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется, Нстр("ru = 'Отбор не производится'; en = 'Not filtered';tr = 'Filtrelenmemiş'"));
		
	Иначе
		
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, Нстр("ru = 'Фиксированное значение'; en = 'Fixed value';tr = 'Sabit değer'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению, Нстр("ru = 'Не равно фиксированному значению'; en = 'Not equal to a fixed value';tr = 'Sabit bir değere eşit değil'"));																								   
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Нстр("ru = 'Список фиксированных значений'; en = 'Fixed value list';tr = 'Sabit değer listesi'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокПоИерархии, Нстр("ru = 'Список с учетом иерархии'; en = 'List considering hierarchy';tr = 'Hiyerarşiyi dikkate alan liste'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений, Нстр("ru = 'Не в списке фиксированных значений'; en = 'Not in the fixed value list';tr = 'Sabit değer listesinde değil'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии, Нстр("ru = 'Не в списке с учетом иерархии'; en = 'Not in the list considering hierarchy';tr = 'Hiyerarşi dikkate alınan listede yok'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется, Нстр("ru = 'Отбор не производится'; en = 'Not filtered';tr = 'Filtrelenmemiş'"));
		
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции // ПолучитьСписокСпособовВычисления() 

&НаСервереБезКонтекста
Функция ПолучитьСписокВидовСубконто(Счет)
	
	СписокСубконто=Новый СписокЗначений;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СчетаБДВидыСубконто.ВидСубконто
	|ИЗ
	|	Справочник.СчетаБД.ВидыСубконто КАК СчетаБДВидыСубконто
	|ГДЕ
	|	СчетаБДВидыСубконто.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетаБДВидыСубконто.Номер";
	
	Запрос.УстановитьПараметр("Ссылка",Счет);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		СписокСубконто.Добавить(Результат.ВидСубконто,Результат.ВидСубконто,Истина);
		
	КонецЦикла;	
	
	Возврат СписокСубконто;
	
КонецФункции // ПолучитьСписокВидовСубконто()

