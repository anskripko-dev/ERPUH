	Если СтрПоле.ТипЗначения.Количество()>0 Тогда
		
		ДанныеОбъекта=СформироватьДанныеОбъекта();
		ДанныеОбъекта.Вставить("ИмяПараметра",				СтрПоле.ПолеБД);
		ДанныеОбъекта.Вставить("ПолеБД",					СтрПоле.ПолеБД);
		ДанныеОбъекта.Вставить("ТипДанныхПоля",				СтрПоле.ТипДанныхПоля);
		ДанныеОбъекта.Вставить("ТипЗначения",				СтрПоле.ТипЗначения);
		ДанныеОбъекта.Вставить("СпособВычисленияПараметра",	Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.СпособВычисленияПараметра);
		
		ДанныеДляОграничения=ПолучитьДанныеДляОграниченияТипа(ДанныеОбъекта);
		
		Для Каждого СтрОграничение ИЗ ДанныеДляОграничения Цикл
			
			УстановитьОграничениеТипа(СтрОграничение);
			
