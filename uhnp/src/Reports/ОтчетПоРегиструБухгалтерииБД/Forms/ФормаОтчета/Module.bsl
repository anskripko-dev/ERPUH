&НаСервереБезКонтекста
Процедура ПроверитьНаличиеОписанийРегистров(ТипБД,ИмяСправочника)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОписаниеРегистров.Ссылка
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК ОписаниеРегистров
	|ГДЕ
	|	ОписаниеРегистров.Владелец = &ТипБД";
	
	Запрос.УстановитьПараметр("ТипБД",ТипБД);
	
	Результат=Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		РаботаСОбъектамиМетаданныхУХ.ЗаполнитьСписокРегистровБД(ТипБД,,Истина,Истина,Истина);
		
	КонецЕсли;
				 	
КонецПроцедуры // ПроверитьНаличиеОписанийРегистров()

&НаСервере
Процедура ИзменитьРегистрБухгалтерии(ОбновлятьПланСчетов=Истина)
	
	Отчет.Счет="";
	Отчет.КоррСчет="";
	ИзменитьСчет();
	ИзменитьКоррСчет();
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ПриИзмененииРегистраБухгалтерии(ОтчетОбъект,ОбновлятьПланСчетов);
	
	ОбработатьПолеВыбораПланаСчетов();
		
КонецПроцедуры // ИзменитьРеквизитБухгалтерии()

Процедура ОбработатьПолеВыбораПланаСчетов()
	
	Элементы.ПланСчетовБД.СписокВыбора.Очистить();
	МассивПлановСчетов=УправлениеОтчетамиУХ.ПолучитьМассивПлановСчетов(Отчет.РегистрБД);
	
	Для Каждого Элемент ИЗ МассивПлановСчетов Цикл
		
		Элементы.ПланСчетовБД.СписокВыбора.Добавить(Элемент);
		
	КонецЦикла;
	
	Элементы.ПланСчетовБД.Видимость=(Элементы.ПланСчетовБД.СписокВыбора.Количество()>1);
	
КонецПроцедуры // ОбработатьПолеВыбораПланаСчетов()

&НаСервере
Процедура ЗаполнитьПоказателиВИБ(ОтчетОбъект)
	
	ОтчетОбъект.ЗаполнитьИзмеренияРегистраБД();	 
	ОтчетОбъект.ЗаполнитьАналитикуСчетаБД();			
	ОтчетОбъект.ЗаполнитьАналитикуСчетаБД(Ложь);
			
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуИзмерений()
	
	ОтборПоИзмерениямСтар=ТабОтборПоИзмерениям.Выгрузить();
	ТабОтборПоИзмерениям.Очистить();
	
	МассивИзмерений=мТаблицаПоказателейБД.НайтиСтроки(Новый Структура("Измерение",Истина));
	
	Для Каждого СтрИзмерение ИЗ МассивИзмерений Цикл
		
		Если СтрИзмерение.ПолеБД="ПланСчетов" ИЛИ СтрИзмерение.ПолеБД="ПланСчетовБД" Тогда // Отбор по плану счетов накладывается отдельно
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ (СтрИзмерение.Балансовый 
		ИЛИ ОтборПоИзмерениямСтар.НайтиСтроки(Новый Структура("ПолеБД,Отбирать",СтрИзмерение.ПолеБД,Истина)).Количество()>0) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(СтрИзмерение.ПризнакУчета) ИЛИ СтрНайти(Отчет.Счет.ПризнакиУчета,СтрИзмерение.ПризнакУчета)>0
			ИЛИ СтрНайти(Отчет.КоррСчет.ПризнакиУчета,СтрИзмерение.ПризнакУчета)>0 Тогда
									
			НоваяСтрока=ТабОтборПоИзмерениям.Добавить();
			НоваяСтрока.ИмяПараметра			= СтрИзмерение.ПолеБД;
			НоваяСтрока.ПолеБД					= СтрИзмерение.ПолеБД;
			НоваяСтрока.ПредставлениеПараметра	= СтрИзмерение.НаименованиеБД;
			НоваяСтрока.Отбирать				= Ложь;
			НоваяСтрока.ПризнакУчета 			= СтрИзмерение.ПризнакУчета;
			НоваяСтрока.СправочникБД			= СтрИзмерение.СправочникБД;
			
			УстановленныйОтбор=ОтборПоИзмерениямСтар.Найти(СтрИзмерение.ПолеБД,"ПолеБД");
			
			Если НЕ УстановленныйОтбор=Неопределено Тогда
				
				НоваяСтрока.Отбирать=УстановленныйОтбор.Отбирать;
				НоваяСтрока.НастройкаСоответствия=УстановленныйОтбор.НастройкаСоответствия;
				НоваяСтрока.Значение=УстановленныйОтбор.Значение;
				НоваяСтрока.ИмяПараметра=УстановленныйОтбор.ИмяПараметра;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ОбновитьТаблицуИзмерений() 

&НаСервере
Процедура ПриИзмененииРегистраБухгалтерии(ОтчетОбъект,ОбновлятьПланСчетов)
		
	Если (НЕ ЗначениеЗаполнено(ОтчетОбъект.РегистрБД.ПланСчетов)) И ЗначениеЗаполнено(ОтчетОбъект.РегистрБД) Тогда
		
		РегистрОбъект=ОтчетОбъект.РегистрБД.ПолучитьОбъект();
		РегистрОбъект.ЗаполнитьРеквизитыОбъекта();
		РегистрОбъект.Записать();
		
		Если НЕ ЗначениеЗаполнено(ОтчетОбъект.РегистрБД.ПланСчетов) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбновлятьПланСчетов Тогда
		
		ОтчетОбъект.ПланСчетовБД=ОтчетОбъект.РегистрБД.ПланСчетов;
		Отчет.ПланСчетовБД=ОтчетОбъект.ПланСчетовБД;
		
	КонецЕсли;
	
	ЗаполнитьПоказателиВИБ(ОтчетОбъект);
		
	ОбновитьТаблицуРесурсов();
	ОбновитьСписокОтчетов();
	
	Отчет.Период="ПЕРИОД";
	
	ЗначениеВРеквизитФормы(ОтчетОбъект.мТаблицаПоказателейБД,"мТаблицаПоказателейБД");
	ОбновитьТаблицуИзмерений();
		
КонецПроцедуры // ПриИзмененииРегистраБухгалтерии()

&НаСервере
Процедура ОбновитьСписокОтчетов()
	
	Элементы.ВидОтчета.СписокВыбора.Очистить();
	
	Элементы.ВидОтчета.СписокВыбора.Добавить("ОборотноСальдоваяВедомость",Нстр("ru = 'Оборотно - сальдовая ведомость'; en = 'Trial balance';tr = 'Geçici mizan'"));
	Элементы.ВидОтчета.СписокВыбора.Добавить("ОборотноСальдоваяВедомостьПоСчету",Нстр("ru = 'Оборотно - сальдовая ведомость по счету'; en = 'Trial balance for account';tr = 'Hesap geçici mizanı'"));
	Элементы.ВидОтчета.СписокВыбора.Добавить("КарточкаСчета",Нстр("ru = 'Карточка счета'; en = 'Account card ';tr = 'Hesap kartı'"));
	
	Если ЗначениеЗаполнено(Отчет.РегистрБД) И Отчет.РегистрБД.Корреспонденция Тогда
		
		Элементы.ВидОтчета.СписокВыбора.Добавить("АнализСчета",		Нстр("ru = 'Анализ счета'; en = 'Account analysis ';tr = 'Hesap analizi'"));
		Элементы.ВидОтчета.СписокВыбора.Добавить("ОтчетПоПроводкам",Нстр("ru = 'Отчет по проводкам'; en = 'Entry report';tr = 'Kayıt raporu'"));
		
	КонецЕсли;
	
КонецПроцедуры // ОбновитьСписокОтчетов() 

&НаСервере
Процедура ОбновитьТаблицуРесурсов()
	
	Отчет.ТабВыводимыеРесурсы.Очистить();
	
	ПризнакиУчета=ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(Отчет.ПланСчетовБД.ПризнакиУчета);
	
	Для Каждого СтрРесурс ИЗ Отчет.РегистрБД.Ресурсы Цикл
		
		Если Отчет.ВидОтчета="ОборотноСальдоваяВедомость" Тогда
			
			НоваяСтрока=Отчет.ТабВыводимыеРесурсы.Добавить();
			НоваяСтрока.ИмяПоля=СтрРесурс.Имя;
			НоваяСтрока.ПредставлениеПоля=СтрРесурс[ПолеСиноним];
			НоваяСтрока.Выводить=(ПустаяСтрока(СтрРесурс.ПризнакУчета) И СтрРесурс.Балансовый);
			НоваяСтрока.Балансовый=СтрРесурс.Балансовый;
			НоваяСтрока.ПризнакУчета=СтрРесурс.ПризнакУчета;

		ИначеЕсли ПустаяСтрока(СтрРесурс.ПризнакУчета) ИЛИ СтрНайти(Отчет.Счет.ПризнакиУчета,СтрРесурс.ПризнакУчета)>0
			ИЛИ СтрНайти(Отчет.КоррСчет.ПризнакиУчета,СтрРесурс.ПризнакУчета)>0 Тогда
			
			НоваяСтрока=Отчет.ТабВыводимыеРесурсы.Добавить();
			НоваяСтрока.ИмяПоля=СтрРесурс.Имя;
			НоваяСтрока.ПредставлениеПоля=СтрРесурс[ПолеСиноним];
			НоваяСтрока.Выводить=(ПустаяСтрока(СтрРесурс.ПризнакУчета) И СтрРесурс.Балансовый);
			НоваяСтрока.Балансовый=СтрРесурс.Балансовый;
			НоваяСтрока.ПризнакУчета=СтрРесурс.ПризнакУчета;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОбновитьТаблицуРесурсов() 

&НаСервере
Процедура ИзменитьСчет()
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.мТаблицаПоказателейБД=РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ПриИзмененииСчета(Истина,ОтчетОбъект);
		
КонецПроцедуры // ИзменитьРеквизитБухгалтерии()

&НаСервере
Процедура ПриИзмененииСчета(Дебетовый,ОтчетОбъект)
	
	ОтчетОбъект.УдалитьАналитикуПоСчету(Дебетовый);		
	ОтчетОбъект.ЗаполнитьАналитикуСчетаБД(Дебетовый);				
	ОтчетОбъект.ЗаполнитьДеревоПоРегиструБухгалтерии();
	
	ЗначениеВРеквизитФормы(ОтчетОбъект.мТаблицаПоказателейБД,"мТаблицаПоказателейБД");
	мТаблицаПроизводныхБД.Очистить();	
	ЗначениеВРеквизитФормы(ОтчетОбъект.ТабличноеПолеИзмеренийБД,"ТабличноеПолеИзмеренийБД");
	
	Отчет.ТабПоляДетализации.Очистить();
	Отчет.ТабПравилаВычисленияПараметров.Очистить();
	
	ОбновитьТаблицыСубконто();
	ОбновитьТаблицуРесурсов();
	
	Отчет.Период="ПЕРИОД";
			
КонецПроцедуры // ПриИзмененииСчета

&НаСервере
Процедура ИзменитьКоррСчет()
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.мТаблицаПоказателейБД=РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ПриИзмененииСчета(Ложь,ОтчетОбъект);

КонецПроцедуры // ИзменитьРеквизитБухгалтерии()

&НаСервере
Процедура ОбновитьТаблицыСубконто()
	
	//////////////////////////////////////////////////////////////////////////
	// Проверим возможность отбора по измерениям.
	
	ПризнакиУчетаСчета=Отчет.Счет.ПризнакиУчета;
	
	Для Каждого СтрИзмерение ИЗ ТабОтборПоИзмерениям Цикл
		
		Если ЗначениеЗаполнено(СтрИзмерение.ПризнакУчета) И СтрНайти(ПризнакиУчетаСчета,СтрИзмерение.ПризнакУчета)=0 Тогда
			
			СтрИзмерение.Отбирать=Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ОбновитьТаблицыОтборов()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	
	ЗаполнитьЗначенияСвойств(Отчет,Параметры);
	
	Отчет.ТипБД=Параметры.РегистрБД.Владелец;
	Отчет.ИспользуемаяИБ=?(Отчет.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ,"",Параметры.ИспользуемаяИБ);
	
	ПолеСиноним=РаботаСОбъектамиМетаданныхУХ.ПолучитьПолеСиноним();
	
	Если ЗначениеЗаполнено(Параметры.ПравилоДт) Тогда
		
		ПравилоДт=Параметры.ПравилоДт;
		ПравилоКт=Параметры.ПравилоКт;
		ДокументКорректировки=Параметры.ДокументКорректировки;
		НомерПроводки=Параметры.НомерПроводки;
		
		Элементы.ОсновнаяПанель.ОтображениеСтраниц=ОтображениеСтраницФормы.Нет;
		Элементы.ОсновнаяПанель.ТекущаяСтраница=Элементы.ОсновнаяПанель.ПодчиненныеЭлементы.Отчет;
		Элементы.ФормаСформироватьОтчет.Видимость=Ложь;
		Элементы.ФормаСохранитьЗначения.Видимость=Ложь;
		Элементы.ФормаВосстановитьЗначения.Видимость=Ложь;

	КонецЕсли;
	
	Если ПустаяСтрока(Отчет.ВидОтчета) Тогда
		Отчет.ВидОтчета="ОборотноСальдоваяВедомость";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.ТипБД) Тогда
		
		Отчет.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ;
				
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.РегистрБД) Тогда
		
		Отчет.РегистрБД=Справочники.РегистрыБухгалтерииБД.НайтиПоНаименованию("МСФО",,,Отчет.ТипБД);

	КонецЕсли;	
	
	Отчет.ВнешняяИБ=?(Отчет.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ,0,1);
	Элементы.ИспользуемаяИБ.Видимость=(Отчет.ВнешняяИБ=1); 
		
	Если ЗначениеЗаполнено(Отчет.РегистрБД) Тогда
		
		ИзменитьРегистрБухгалтерии(НЕ ЗначениеЗаполнено(Отчет.ПланСчетовБД));
		
		Если ТипЗнч(Параметры.ОтборПоИзмерениям)=Тип("Массив") Тогда
			
			Для Каждого СтрОтбор ИЗ Параметры.ОтборПоИзмерениям Цикл
				
				Если НЕ СтрОтбор.Свойство("ПолеБД") Тогда // Для совместимости
					
					СтрОтбор.Вставить("ПолеБД",СтрОтбор.ИмяПараметра);
					
				КонецЕсли;
				
				МассивИзмерений=ТабОтборПоИзмерениям.НайтиСтроки(Новый Структура("ПолеБД",СтрОтбор.ПолеБД));
				
				Если МассивИзмерений.Количество()=0 Тогда
					СтрИзмерение=ТабОтборПоИзмерениям.Добавить();	
				Иначе
					СтрИзмерение=МассивИзмерений[0];
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(СтрИзмерение,СтрОтбор);
				СтрИзмерение.Отбирать=Истина;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ОбновитьСписокОтчетов();
		
	КонецЕсли;
	
	Отчет.Счет=Параметры.Счет;
	Отчет.КоррСчет=Параметры.КоррСчет;
	
	Если ТипЗнч(Параметры.ДанныеРасшифровки)=Тип("Соответствие") Тогда
		
		ДанныеРасшифровки=Параметры.ДанныеРасшифровки;
		
		КодСчета=ДанныеРасшифровки.Получить("Счет");
		
		Если НЕ КодСчета=Неопределено Тогда
			Отчет.Счет=Справочники.СчетаБД.НайтиПоКоду(КодСчета,,,Отчет.ПланСчетовБД);
		КонецЕсли;
		
		КодКоррСчета=ДанныеРасшифровки.Получить("КоррСчет");
		
		Если НЕ КодКоррСчета=Неопределено Тогда
			Отчет.КоррСчет=Справочники.СчетаБД.НайтиПоКоду(КодКоррСчета,,,Отчет.ПланСчетовБД);
		КонецЕсли;
		
		ОбновитьДанныеПоСубконто();
		ОбновитьТаблицуИзмерений();
		
		Для Каждого Строка ИЗ Параметры.МассивПроизводные Цикл
			
			НоваяСтрока=мТаблицаПроизводныхБД.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
		КонецЦикла;
		
		////////////////////////////////////////////////////////////////////////////////
		// Накладываем необходимые отборы по субконто
		
		Если ТипЗнч(Параметры.ОтборПоСубконто)=Тип("Массив") Тогда
			
			Для Каждого СтрОтбор ИЗ Параметры.ОтборПоСубконто Цикл
				
				НоваяСтрока=Отчет.ТабПравилаВычисленияПараметров.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрОтбор);
							
			КонецЦикла;
			
		КонецЕсли;
		
		ДополнительныеОтборы=ДанныеРасшифровки.Получить("ДополнительныеОтборы");
		
		Если НЕ ДополнительныеОтборы=Неопределено Тогда
			
			Для Каждого ТекОтбор ИЗ ДополнительныеОтборы Цикл
				
				Если НЕ ТекОтбор.Свойство("ПолеБД") Тогда
					
					ТекОтбор.Вставить("ПолеБД",ТекОтбор.ИмяПараметра);
					
				КонецЕсли;
				
				МассивПараметр=Отчет.ТабПравилаВычисленияПараметров.НайтиСтроки(Новый Структура("ИмяПараметра",ТекОтбор.ИмяПараметра));
				
				Если МассивПараметр.Количество()=0 Тогда
					
					СтрокаПараметр=Отчет.ТабПравилаВычисленияПараметров.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаПараметр,ТекОтбор);
					
				Иначе
					
					СтрокаПараметр=МассивПараметр[0];
					
				КонецЕсли;
				
				СтрокаПараметр.СпособВычисленияПараметра=?(ТекОтбор.Свойство("СпособВычисленияПараметра"),ТекОтбор.СпособВычисленияПараметра,Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение);
				
				Если ТипЗнч(ТекОтбор.УточнениеСпособаОпределения)=Тип("Структура") Тогда
					
					ТекУточнениеСпособаОпределения=?(ТекОтбор.УточнениеСпособаОпределения.Свойство("ДанныеДляПоиска"),ТекОтбор.УточнениеСпособаОпределения.ДанныеДляПоиска,ТекОтбор.УточнениеСпособаОпределения);
						
					СтрокаПараметр.УточнениеСпособаОпределения=ТекУточнениеСпособаОпределения;
					
					Если НЕ ТекУточнениеСпособаОпределения=Неопределено Тогда 
						
						СтрокаПараметр.ОбъектМетаданных=ТекОтбор.УточнениеСпособаОпределения.ТипОбъектаМетаданных+"."+ТекОтбор.УточнениеСпособаОпределения.ИмяОбъектаМетаданных;
						
					КонецЕсли;
					
					СтрокаПараметр.НастройкаСоответствия=Неопределено;
					
				Иначе
					
					СтрокаПараметр.УточнениеСпособаОпределения=ТекОтбор.УточнениеСпособаОпределения;
					
				КонецЕсли;
	
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ОбновитьДанныеПоСубконто();
		
		Если ТипЗнч(Параметры.МассивДетализация)=Тип("Массив") Тогда // Производится расшифровка значения отчета
			
			Для Каждого СтрДетализация ИЗ Параметры.МассивДетализация Цикл
				
				НоваяСтрока=Отчет.ТабПоляДетализации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрДетализация);
				
				Отчет.ТабПоляДетализации.Сортировать("ИмяПоля");
				
			КонецЦикла;
				
			Для Каждого СтрОтбор ИЗ Параметры.ОтборПоСубконто Цикл
				
				НоваяСтрока=Отчет.ТабПравилаВычисленияПараметров.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрОтбор);
				
			КонецЦикла;
			
			Для Каждого Строка ИЗ Параметры.МассивПроизводные Цикл
				
				НоваяСтрока=мТаблицаПроизводныхБД.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
				
			КонецЦикла;
			
			Если Отчет.ВидОтчета="КарточкаСчета" 
				ИЛИ Отчет.ВидОтчета="ОтчетПоПроводкам"
				ИЛИ Отчет.ВидОтчета="ОборотноСальдоваяВедомостьПоСчету" Тогда
				
				Если ТипЗнч(Параметры.МассивДополнительныйОтбор)=Тип("Массив") Тогда
					
					Для Каждого СтрОтбор ИЗ Параметры.МассивДополнительныйОтбор Цикл
						
						МассивПараметр=Отчет.ТабПравилаВычисленияПараметров.НайтиСтроки(Новый Структура("ИмяПараметра",СтрОтбор.ИмяПараметра));
						
						Если МассивПараметр.Количество()=0 Тогда
							
							СтрокаДопОтбор=Отчет.ТабПравилаВычисленияПараметров.Добавить();
							
						Иначе
							
							СтрокаДопОтбор=МассивПараметр[0];
							
						КонецЕсли;
						
						ЗаполнитьЗначенияСвойств(СтрокаДопОтбор,СтрОтбор);
						СтрокаДопОтбор.ПолеБД=СтрокаДопОтбор.ИмяПараметра;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.СписокПоказателей.Количество()>0 Тогда
		
		Для Каждого СтрРесурс ИЗ Отчет.ТабВыводимыеРесурсы Цикл
			
			СтрРесурс.Выводить=(НЕ Параметры.СписокПоказателей.НайтиПоЗначению(СтрРесурс.ИмяПоля)=Неопределено);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Параметры.ПолнаяДетализация Тогда
		
		Для Каждого Строка ИЗ мТаблицаПоказателейБД Цикл
			
			Если Строка.Измерение Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			НоваяСтрока=Отчет.ТабПоляДетализации.Добавить();
			НоваяСтрока.ИмяПоля=Строка.ПолеБД;
			НоваяСтрока.ПсевдонимПоля=Строка.ПолеБД;
			НоваяСтрока.ПредставлениеПоля=Строка.НаименованиеБД;
			НоваяСтрока.ТипМетаДанных=Строка.ТипМетаДанных;
			
		КонецЦикла;
		
		Отчет.ТабПоляДетализации.Сортировать("ИмяПоля Возр");
		
	КонецЕсли;		
	
	Отчет.ТабПравилаВычисленияПараметров.Сортировать("ПолеБД");
	
	ПоместитьРабочийОбъект(РеквизитФормыВЗначение("Отчет"));
	
	Если Параметры.ФормироватьПриОткрытии Тогда
		
		ВывестиОтчет();
		
	КонецЕсли;
		
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРабочийОбъект()
	
	РабочийОбъект=РеквизитФормыВЗначение("Отчет");
	РабочийОбъект.АдресХранилищаПеременныхДляРасчета=РабочийОбъектАдрес;
	РабочийОбъект.ВосстановитьПеременныеДляРасчета();
	
	Возврат РабочийОбъект;
		
КонецФункции // ПолучитьРабочийОбъект()

&НаСервере
Процедура ПоместитьРабочийОбъект(РабочийОбъект)
	
	РабочийОбъектАдрес=ПоместитьВоВременноеХранилище(РабочийОбъект.ПодготовитьСтруктуруПеременныхДляРасчета(),ЭтаФорма.УникальныйИдентификатор);
	ЗначениеВРеквизитФормы(РабочийОбъект,"Отчет");
				
КонецПроцедуры // ПолучитьРабочийОбъект()

&НаСервере
Процедура ОбновитьДанныеПоСубконто()
	
	Если ЗначениеЗаполнено(Отчет.Счет) Тогда
		ИзменитьСчет();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчет.КоррСчет) Тогда
		ИзменитьКоррСчет();
	КонецЕсли;
			
КонецПроцедуры // ОбновитьДанныеПоСубконто()

&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.ГруппаОтборДетализация.ОтображениеСтраниц=ОтображениеСтраницФормы.Нет;
	Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.Детализация.Видимость=Ложь;
	Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ДетализацияКоррСчета.Видимость=Ложь;
	Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ДетализацияСчета.Видимость=Ложь;
	Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ТабРазвернутоеСальдо.Видимость=Ложь;
	
	Если ЗначениеЗаполнено(Отчет.ИсточникДанных) 
		ИЛИ Параметры.ТолькоПросмотр Тогда		
		
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.Отбор.Видимость=Ложь;
		Элементы.ГруппаЛевая.ТолькоПросмотр=Истина;
		Элементы.РегистрБД.ТолькоПросмотр=Истина;
		Элементы.ГруппаИсточник.Видимость=ЗначениеЗаполнено(Отчет.ИсточникДанных);
		Элементы.ФормаСохранитьЗначения.Видимость=Ложь;
		Элементы.ФормаВосстановитьЗначения.Видимость=Ложь;
		Элементы.Отбирать.ТолькоПросмотр=Истина;
		
	Иначе
		
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.Отбор.Видимость=Истина;
		Элементы.ГруппаЛевая.ТолькоПросмотр=Ложь;
		Элементы.РегистрБД.ТолькоПросмотр=Ложь;
		Элементы.ГруппаИсточник.Видимость=Ложь;
		Элементы.ФормаСохранитьЗначения.Видимость=Истина;
		Элементы.ФормаВосстановитьЗначения.Видимость=Истина;
		Элементы.Отбирать.ТолькоПросмотр=Ложь;
		
	КонецЕсли;
		
	Если Отчет.ВидОтчета="ОтчетПоПроводкам" Тогда
		
		Элементы.Счет.Видимость		= Истина;
		Элементы.КоррСчет.Видимость	= Истина;
		
	ИначеЕсли Отчет.ВидОтчета="ОборотноСальдоваяВедомостьПоСчету" Тогда
		
		Элементы.ПарамерыВывода.ТекущаяСтраница=Элементы.ПарамерыВывода.ПодчиненныеЭлементы.ПараметрыОСВ;
		Элементы.ГруппаОтборДетализация.ОтображениеСтраниц=ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.Детализация.Видимость=Истина;
		
		Элементы.Счет.Видимость		= Истина;
		Элементы.КоррСчет.Видимость	= Ложь;
			
	ИначеЕсли Отчет.ВидОтчета="АнализСчета" Тогда
		
		Элементы.ПарамерыВывода.ТекущаяСтраница=Элементы.ПарамерыВывода.ПодчиненныеЭлементы.ПараметрыАнализСчета;
		Элементы.ГруппаОтборДетализация.ОтображениеСтраниц=ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ДетализацияСчета.Видимость=Истина;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ДетализацияКоррСчета.Видимость=Истина;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ДетализацияКоррСчета.Заголовок=Нстр("ru = 'Детализация корр. счетов'; en = 'Corr. accounts details';tr = 'Düzeltme hesap ayrıntıları'");
		
		Элементы.Счет.Видимость		= Истина;
		Элементы.КоррСчет.Видимость	= Ложь;
		
	ИначеЕсли Отчет.ВидОтчета="КарточкаСчета" Тогда
		
		Элементы.ПарамерыВывода.ТекущаяСтраница=Элементы.ПарамерыВывода.ПодчиненныеЭлементы.ПараметрыКарточка;
		
		Элементы.Счет.Видимость		= Истина;
		Элементы.КоррСчет.Видимость	= Ложь;
		
	ИначеЕсли Отчет.ВидОтчета="ОборотноСальдоваяВедомость" Тогда
		
		Элементы.ПарамерыВывода.ТекущаяСтраница=Элементы.ПарамерыВывода.ПодчиненныеЭлементы.ПараметрыОСВПолная;
		
		Элементы.Счет.Видимость		= Ложь;
		Элементы.КоррСчет.Видимость	= Ложь;
		
		Элементы.ГруппаОтборДетализация.ОтображениеСтраниц=ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.Отбор.Видимость=Ложь;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ТабРазвернутоеСальдо.Видимость=Истина;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ДетализацияКоррСчета.Видимость=Истина;
		Элементы.ГруппаОтборДетализация.ПодчиненныеЭлементы.ДетализацияКоррСчета.Заголовок=НСтр("ru = 'Детализация'; en = 'Details';tr = 'Detaylar'");
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьВидимость() 

&НаСервере
Процедура ОбновитьТипВИБ()
		
	Отчет.РегистрБД	= "";
	Отчет.Счет		= "";
	Отчет.КоррСчет	= "";
	
	Отчет.ТабПоляДетализации.Очистить();
	Отчет.ТабПравилаВычисленияПараметров.Очистить();
	Отчет.ПравилаРазвернутогоСальдо.Очистить();
	Отчет.ПравилаВыводаИтогов.Очистить();
		
	ИзменитьРегистрБухгалтерии();
	ИзменитьСчет();
	ИзменитьКоррСчет();
		
КонецПроцедуры // ОбновитьТипВИБ()

&НаСервереБезКонтекста
Функция ПолучитьДанныеДляВыбора(НастройкаСоответствия)
	
	СтруктураДляВыбора=Новый Структура;
	СтруктураДлявыбора.Вставить("ТипОбъектаКонсолидации",НастройкаСоответствия.ТипОбъектаКонсолидации);
	СтруктураДлявыбора.Вставить("ИмяОбъектаМетаданных",НастройкаСоответствия.ИмяОбъектаМетаданных);
	
	Если НастройкаСоответствия.ТипОбъектаКонсолидации="ВидСубконто" Тогда 
		
		СтруктураДляВыбора.Вставить("ТипЗначения",НастройкаСоответствия.ИмяОбъектаМетаданных.ТипЗначения);
		СтруктураДляВыбора.Вставить("Тип",НастройкаСоответствия.ИмяОбъектаМетаданных.ТипЗначения.Типы()[0]);
		СтруктураДляВыбора.Вставить("ТаблицаАналитики", Метаданные.НайтиПоТипу(СтруктураДляВыбора.Тип).ПолноеИмя());
		
	КонецЕсли;
	
	Возврат СтруктураДляВыбора;
	
КонецФункции // ПолучитьДанныеДляВыбора()

&НаСервереБезКонтекста
Функция ПолучитьНастройкуСоответствияРеквизитов(ТипБД,СправочникКонсолидации,СправочникБД,ТипМетаДанных,ПервыйЭлемент=Истина);
	
	ТаблицаНастроек=УправлениеОтчетамиУХ.ПолучитьНастройкуСоответствияРеквизитов(ТипБД,СправочникКонсолидации,СправочникБД,ТипМетаДанных,ПервыйЭлемент);
	
	СписокНастроек=Новый СписокЗначений;
	СписокНастроек.ТипЗначения=ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.СоответствиеВнешнимИБ");
	СписокНастроек.ЗагрузитьЗначения(ТаблицаНастроек.ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокНастроек;
	
КонецФункции // ПолучитьНастройкуСоответствияРеквизитов()

&НаСервере
Функция ОткрытьДокументОперации(Расшифровка)
	
	Если Отчет.ВнешняяИБ=0 Тогда
		
		СтруктураОбъекта=Новый Структура;
		СтруктураОбъекта.Вставить("ИмяОбъектаМетаданных",Расшифровка.ДокументОперации.Метаданные().ПолноеИмя());
		СтруктураОбъекта.Вставить("СтруктураПараметров",Новый Структура("Ключ,НомерПроводки,РежимРасшифровки",Расшифровка.ДокументОперации,Расшифровка.НомерСтроки,Истина));
		
		Возврат СтруктураОбъекта;
		
	Иначе
		
		Возврат Новый Структура("ТипЗначения, Значение", "ДокументСсылка."+Расшифровка.ВидДокумента, Расшифровка.ДокументОперации);
	
	КонецЕсли;
			
КонецФункции // ОткрытьДокументОперации()

&НаСервере
Процедура ВывестиОтчет()

	Если Отчет.ДатаНач > Отчет.ДатаКон И Отчет.ДатаКон <> '00010101000000' Тогда

		Отчет.ДатаНач=Отчет.ДатаКон;
		
	КонецЕсли;
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.мТаблицаПоказателейБД		= РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ОтчетОбъект.мТаблицаПроизводныхБД		= РеквизитФормыВЗначение("мТаблицаПроизводныхБД");
	
	ОтчетОбъект.ТабличноеПолеИзмеренийБД 	= РеквизитФормыВЗначение("ТабличноеПолеИзмеренийБД");
	
	Для Каждого СтрИзмерение ИЗ ТабОтборПоИзмерениям Цикл
		
		Если СтрИзмерение.Отбирать Тогда
			
			НоваяСтрока=ОтчетОбъект.ТабПравилаВычисленияПараметров.Добавить();
			НоваяСтрока.ИмяПараметра=СтрИзмерение.ИмяПараметра;
			НоваяСтрока.ПолеБД=СтрИзмерение.ПолеБД;
			НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НоваяСтрока.УточнениеСпособаОпределения=СтрИзмерение.Значение;
			НоваяСтрока.НастройкаСоответствия=СтрИзмерение.НастройкаСоответствия;
						
		КонецЕсли;
		
	КонецЦикла; 
	
	ОтчетОбъект.мТабПравилаВычисленияПараметров=ОтчетОбъект.ТабПравилаВычисленияПараметров.Скопировать();

	
	ТабРезультат.Очистить();
	
	ДанныеЗаполнения=ОтчетОбъект.СформироватьОтчет();
	
	ТаблицаДляОтображения=ДанныеЗаполнения.ТаблицаДляОтображения;
	
	Если ЗначениеЗаполнено(ПравилоДт) Тогда
		
		ДополнитьДаннымиТрансляции(ТаблицаДляОтображения);
		
	КонецЕсли;
	
	УправлениеОтчетамиУХ.УстановитьКолонтитулыПоУмолчанию(ТаблицаДляОтображения, ДанныеЗаполнения.ЗаголовокОтчета, Строка(Пользователи.ТекущийПользователь()));
	
	ТабРезультат.Вывести(ТаблицаДляОтображения);
	
	Элементы.ОсновнаяПанель.ТекущаяСтраница=Элементы.ОсновнаяПанель.ПодчиненныеЭлементы.Отчет;
	
	Заголовок=ДанныеЗаполнения.ЗаголовокОтчета;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.ТекстОшибки) Тогда
		
