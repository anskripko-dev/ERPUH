
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РабочийОбъектАдрес=Параметры.РабочийОбъектАдрес;
	ТекстОповещения=Параметры.ТекстОповещения;
	
	ОтчетОбъект=ПолучитьРабочийОбъект();
	
	Если ТекстОповещения="ВыбраноПолеРасшифровки" Тогда
		
		Элементы.ТабличноеПолеИзмеренийБД.ПодчиненныеЭлементы.ТабличноеПолеИзмеренийВИБНаименованиеВИБ.Заголовок=Нстр("ru = 'Выберите способ расшифровки'; en = 'Select a drilldown method';tr = 'Detaylandırma yöntemi seçin'");
		
		Для Каждого Строка ИЗ Параметры.СписокДополнительныхПолей Цикл
			
			НоваяСтрока=ТабличноеПолеИзмеренийБД.ПолучитьЭлементы().Добавить();
			НоваяСтрока.ПолеБД=Строка.Значение;
			НоваяСтрока.НаименованиеБД=Строка.Представление;
			
		КонецЦикла;
		
		Для Каждого СтрИзмерение ИЗ ОтчетОбъект.ТабличноеПолеИзмеренийБД.Строки Цикл
			
			Если Параметры.СписокПропускаемыхПолей.НайтиПоЗначению(СтрИзмерение.ПолеБД)=Неопределено Тогда
				
				НоваяСтрока=ТабличноеПолеИзмеренийБД.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрИзмерение);
				
				ДобавитьСтрокиДерева(НоваяСтрока,СтрИзмерение);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ЗначениеВРеквизитФормы(ОтчетОбъект.ТабличноеПолеИзмеренийБД,"ТабличноеПолеИзмеренийБД");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРабочийОбъект()
	
	РабочийОбъект=ОбщегоНазначенияУХ.ПолучитьРабочийОбъект(РабочийОбъектАдрес);
	
	Возврат РабочийОбъект;
		
КонецФункции // ПолучитьРабочийОбъект()

&НаСервере
Процедура ПоместитьРабочийОбъект(РабочийОбъект)
	
	РабочийОбъектАдрес=ПоместитьВоВременноеХранилище(РабочийОбъект.ПодготовитьСтруктуруПеременныхДляРасчета(),Параметры.ИдентификаторВладельца);
				
КонецПроцедуры // ПолучитьРабочийОбъект()

&НаСервере
Процедура ДобавитьСтрокиДерева(СтрокаФормы,СтрокаДерева)
	
	Для Каждого СтрИзмерение ИЗ СтрокаДерева.Строки Цикл
		
		НоваяСтрока=СтрокаФормы.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрИзмерение);
				
		ДобавитьСтрокиДерева(НоваяСтрока,СтрИзмерение);
		
	КонецЦикла;
			
КонецПроцедуры // ДобавитьПодчиненныеСтроки() 	

&НаСервере
Функция СформироватьДанныеОбъекта() 
		
	ОтчетОбъект=ПолучитьРабочийОбъект();
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("РабочийОбъектАдрес",		РабочийОбъектАдрес);
	ДанныеОбъекта.Вставить("УникальныйИдентификатор",	ЭтаФорма.УникальныйИдентификатор);
	ДанныеОбъекта.Вставить("ТипБД",						ОтчетОбъект.ТипБД);
	ДанныеОбъекта.Вставить("ТекСоединениеВИБ",			);
	ДанныеОбъекта.Вставить("Отказ",						Ложь);
	ДанныеОбъекта.Вставить("Использование77",			Ложь);
	ДанныеОбъекта.Вставить("СпособПолучения",			Перечисления.СпособыПолученияОперандов.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ВнутренниеДанные",			ОтчетОбъект.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ);
		
	Возврат ДанныеОбъекта;
	
КонецФункции // ПередРазворачиваниемСтрокиРеквизитовАналитики()

&НаКлиенте
Процедура ТабличноеПолеИзмеренийВИБПередРазворачиванием(Элемент, Строка, Отказ)
	
	СтрокаРазворота=Элемент.ДанныеСтроки(Строка);
	
	Если (НЕ (СтрокаРазворота.ТипМетаДанных="Справочник" 
		ИЛИ СтрокаРазворота.ТипМетаДанных="Документ" 
		ИЛИ СтрокаРазворота.ТипМетаДанных="ПланВидовХарактеристик" 
		ИЛИ СтрокаРазворота.ТипЗначения.Количество()>1)) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаРазворота.ПолучитьЭлементы().Количество()>0 И (НЕ ПустаяСтрока(СтрокаРазворота.ПолучитьЭлементы()[0].ПолеБД)) Тогда // Уже разворачивали эту строку
		Возврат;
	КонецЕсли;
	
	СтруктураСтрока=СформироватьСтруктуруСтрокиБД(СтрокаРазворота);
	
	ДанныеОбъекта=СформироватьДанныеОбъекта();
	
	ПередРазворачиваниемСтрокиРеквизитовАналитики(ДанныеОбъекта,СтруктураСтрока);
	
	Отказ=ДанныеОбъекта.Отказ;
	
	Если Отказ Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаРазворота.ПолучитьЭлементы().Очистить();
	РабочийОбъектАдрес=ДанныеОбъекта.РабочийОбъектАдрес;
	
	Для Каждого СтрокаКДобавлению ИЗ СтруктураСтрока.СтрокиКДобавлению Цикл
		
		НоваяСтрока=СтрокаРазворота.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаКДобавлению);
		
		Если СтрокаКДобавлению.СтрокиКДобавлению.Количество()>0 Тогда
			
			ДобавитьПодчиненныеСтроки(СтрокаКДобавлению,НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПередРазворачиваниемСтрокиРеквизитовАналитики(ДанныеОбъекта,СтруктураСтрока) 
	
	РаботаСПолямиАналитикиУХ.ПередРазворачиваниемСтрокиРеквизитовАналитики(ДанныеОбъекта,СтруктураСтрока);
		
КонецПроцедуры // ПередРазворачиваниемСтрокиРеквизитовАналитики()

&НаКлиенте
Функция СформироватьСтруктуруСтрокиБД(ДанныеСтрокиАналитики)
	
	СтрокаБД=Новый Структура;		
	СтрокаБД.Вставить("НаименованиеБД",				ДанныеСтрокиАналитики.НаименованиеБД);
	СтрокаБД.Вставить("ПредставлениеПоля",			ДанныеСтрокиАналитики.ПредставлениеПоля);
	СтрокаБД.Вставить("СправочникБД",				ДанныеСтрокиАналитики.СправочникБД);
	СтрокаБД.Вставить("ПолеБД",						ДанныеСтрокиАналитики.ПолеБД);
	СтрокаБД.Вставить("ИмяПараметра",				СтрЗаменить(ДанныеСтрокиАналитики.ПолеБД,".",""));

	СтрокаБД.Вставить("ТипЗначения",				ДанныеСтрокиАналитики.ТипЗначения);	
	СтрокаБД.Вставить("ТипДанныхПоля",				ДанныеСтрокиАналитики.ТипДанныхПоля);
	СтрокаБД.Вставить("ТипМетаДанных",				ДанныеСтрокиАналитики.ТипМетаДанных);
		
	Возврат СтрокаБД;
	
КонецФункции // СформироватьСтруктуруСтрокиВИБ()

&НаКлиенте
Процедура ДобавитьПодчиненныеСтроки(Строка,ЭлементКоллекции)
	
	Для Каждого СтрокаКДобавлению ИЗ Строка.СтрокиКДобавлению Цикл
		
		НоваяСтрока=ЭлементКоллекции.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаКДобавлению);
		
		Если СтрокаКДобавлению.СтрокиКДобавлению.Количество()>0 Тогда
			
			ДобавитьПодчиненныеСтроки(СтрокаКДобавлению,НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ДобавитьПодчиненныеСтроки 


&НаКлиенте
Процедура ТабличноеПолеИзмеренийВИБВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.ТабличноеПолеИзмеренийБД.ТекущиеДанные.ТипЗначения.Количество()>1 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВыбора=Новый Структура;
	СтруктураВыбора.Вставить("РабочийОбъектАдрес",РабочийОбъектАдрес);
	СтруктураВыбора.Вставить("ДанныеСтроки",СформироватьСтруктуруСтрокиБД(Элементы.ТабличноеПолеИзмеренийБД.ТекущиеДанные));
	СтруктураВыбора.Вставить("ИдентификаторВладельца",Параметры.ИдентификаторВладельца);
	
	Оповестить(ТекстОповещения,СтруктураВыбора);
	
	Закрыть();
	
КонецПроцедуры

