		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Объединение.СтрокаПланаЗакупок КАК СтрокаПланаЗакупок,
		|	СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.Ссылка КАК Ссылка,
		|	СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.НомерСтроки КАК НомерСтроки,
		|	СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.ЦелеваяСтатьяРасходов КАК ЦелеваяСтатьяРасходов,
		|	СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.ВидРасходов КАК ВидРасходов,
		|	СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.ОбъемФинансовогоОбеспечения КАК ОбъемФинансовогоОбеспечения,
		|	СтрокаПланаЗакупокСсылка.ФинансированиеЗаСчетБюджета КАК ФинансированиеЗаСчетБюджета,
		|	ПРЕДСТАВЛЕНИЕ(СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.ЦелеваяСтатьяРасходов) КАК ЦелеваяСтатьяРасходовПредставление,
		|	ПРЕДСТАВЛЕНИЕ(СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.ВидРасходов) КАК ВидРасходовПредставление
		|ИЗ
		|	ВТ_Объединение КАК ВТ_Объединение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаПланаЗакупок.ИсточникиФинансированияЗаСчетБюджета КАК СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета
		|		ПО ВТ_Объединение.СтрокаПланаЗакупок = СтрокаПланаЗакупокИсточникиФинансированияЗаСчетБюджета.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаПланаЗакупок КАК СтрокаПланаЗакупокСсылка
		|		ПО ВТ_Объединение.СтрокаПланаЗакупок = СтрокаПланаЗакупокСсылка.Ссылка
		|ГДЕ
		|	СтрокаПланаЗакупокСсылка.ФинансированиеЗаСчетБюджета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрограммаЗакупок.ОбъемЗакупокИнновационных КАК ОбъемЗакупокИнновационных,
		|	ПрограммаЗакупок.ОбъемЗакупокИсключаемыхМСП КАК ОбъемЗакупокИсключаемыхМСП,
		|	ПрограммаЗакупок.ГодовойОбъемЗакупокМСП КАК ГодовойОбъемЗакупокМСП,
		|	ПрограммаЗакупок.СуммаИнновационныхПрошлыйГод КАК СуммаИнновационныхПрошлыйГод,
		|	ПрограммаЗакупок.ОбъемЗакупокИнновационныхОтчетный КАК ОбъемЗакупокИнновационныхОтчетный,
		|	ПрограммаЗакупок.ОбъемЗакупокИнновационныхИсключаемых КАК ОбъемЗакупокИнновационныхИсключаемых,
		|	ПрограммаЗакупок.ОбъемЗакупокИнновационныхМСП КАК ОбъемЗакупокИнновационныхМСП,
		|	ПрограммаЗакупок.СуммаИнновационныхМСППрошлыйГод КАК СуммаИнновационныхМСППрошлыйГод
		|ИЗ
		|	Документ.ПрограммаЗакупок КАК ПрограммаЗакупок
		|ГДЕ
		|	ПрограммаЗакупок.Ссылка = &ПланЗакупки";   
	
	Если Периодичность = Перечисления.Периодичность.Месяц Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НАЧАЛОПЕРИОДА(ДокументСтрока.ДатаОфициальногоОбъявленияЗакупки, КВАРТАЛ)", "НАЧАЛОПЕРИОДА(ДокументСтрока.ДатаОфициальногоОбъявленияЗакупки, МЕСЯЦ)");
	КонецЕсли;
	
	СуммаМалыхЗакупок = РегистрыСведений.МалыеЗакупки.ПолучитьСуммуМалыхЗакупок(ОрганизацияДляЗаключенияДоговора, ДатаНачалаПериода);

	Запрос.УстановитьПараметр("СуммаМалыхЗакупок", 	СуммаМалыхЗакупок);
	Запрос.УстановитьПараметр("ПланЗакупки", 		ПланЗакупки); 
	Запрос.УстановитьПараметр("ДатаНачалаПериода", 	ДатаНачалаПериода);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатФункции = Новый Структура("Потребности, Финансирование, Объемы", 
										РезультатЗапроса[2].Выгрузить(), 
										РезультатЗапроса[3].Выгрузить(),
										РезультатЗапроса[4].Выгрузить());
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьТаблицаИсходныхДанных()	

// Возвращает представление требований для вывода в отчёт по Строке
// плана закупок СтрокаПланаЗакупокВход.
Функция ПолучитьПредставлениеТребований(СтрокаПланаЗакупокВход)
	РезультатФункции = "";
	Если ЗначениеЗаполнено(СтрокаПланаЗакупокВход) Тогда
		РезультатФункции = "";
		Если СтрокаПланаЗакупокВход.ПривлечениеМалогоИСреднегоПредпринимательстваКакПодрядчиков Тогда
			РезультатФункции = РезультатФункции + НСтр("ru = 'Привлечение к исполнению субъектов МСП.
			|'");
		Иначе
			// Не добавляем текст по МСП.
		КонецЕсли;
		Если СтрокаПланаЗакупокВход.ЗакупкаИнновационнойВысокотехнологичнойПродукцииИЛекарственныхСредств Тогда
			РезультатФункции = РезультатФункции + НСтр("ru = 'Инновационная продукция.
			|'");
		Иначе
			// Не добавляем текст по инновационной продукции.
		КонецЕсли;
		РезультатФункции = РезультатФункции + СтрокаПланаЗакупокВход.ОбщиеТребования; 
	Иначе
		РезультатФункции = "";
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 //	ПолучитьПредставлениеТребований()

// Возвращает структуру параметров отчёт по настройкам НастройкиВход.
Функция СчитатьСтруктуруПараметров(НастройкиВход)  
	
	ПустаяДата = Дата(1, 1, 1);          
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Организация", 			Справочники.Организации.ПустаяСсылка());
	РезультатФункции.Вставить("ДатаНачалаПериода", 		ПустаяДата);
	РезультатФункции.Вставить("ДатаОкончанияПериода", 	ПустаяДата);
	РезультатФункции.Вставить("Инновационный", 			Ложь);
	РезультатФункции.Вставить("ОтобразитьНевыгружаемые",Ложь); 
	РезультатФункции.Вставить("Периодичность", 			Перечисления.Периодичность.Год);  
	
	Для каждого Элемент Из НастройкиВход.ПараметрыДанных.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			Если Элемент.Использование Тогда
				ИмяПараметра = Строка(Элемент.Параметр);
				Если ИмяПараметра = "Организация" Тогда
					РезультатФункции.Вставить("Организация", Элемент.Значение);
				ИначеЕсли ИмяПараметра = "Периодичность" Тогда
					РезультатФункции.Вставить("Периодичность", Элемент.Значение);
				ИначеЕсли ИмяПараметра = "ПериодНачалаЗакупки" Тогда
					Если ЗначениеЗаполнено(Элемент.Значение) Тогда
						РезультатФункции.Вставить("ДатаНачалаПериода", НачалоДня(Элемент.Значение.ДатаНачала));
					Иначе
						РезультатФункции.Вставить("ДатаНачалаПериода", ПустаяДата);
					КонецЕсли;
				ИначеЕсли ИмяПараметра = "ПериодОкончанияЗакупки" Тогда
					Если ЗначениеЗаполнено(Элемент.Значение) Тогда
						РезультатФункции.Вставить("ДатаОкончанияПериода", КонецДня(Элемент.Значение.ДатаОкончания));
					Иначе
						РезультатФункции.Вставить("ДатаОкончанияПериода", ПустаяДата);
					КонецЕсли;
				ИначеЕсли ИмяПараметра = "ПериодЗакупки" Тогда
					Если ЗначениеЗаполнено(Элемент.Значение) Тогда   
						РезультатФункции.Вставить("ДатаНачалаПериода", НачалоДня(Элемент.Значение.ДатаНачала));
						РезультатФункции.Вставить("ДатаОкончанияПериода", КонецДня(Элемент.Значение.ДатаОкончания));
					Иначе
						РезультатФункции.Вставить("ДатаОкончанияПериода", ПустаяДата); 
						РезультатФункции.Вставить("ДатаНачалаПериода", ПустаяДата);
					КонецЕсли;
				ИначеЕсли ИмяПараметра = "ИнновационныйПлан" Тогда
					РезультатФункции.Вставить("Инновационный", Элемент.Значение);  
				ИначеЕсли ИмяПараметра = "ПланЗакупки" Тогда
					РезультатФункции.Вставить("ПланЗакупки", Элемент.Значение);
				ИначеЕсли ИмяПараметра = "ОтобразитьНевыгружаемые" Тогда
					РезультатФункции.Вставить("ОтобразитьНевыгружаемые", Элемент.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;	
КонецФункции		// СчитатьСтруктуруПараметров()

// Выводит таблицу с данными в табличный документ ДокументРезультатИзм по исходным данным
// ТаблицаИсходныеДанныеВход и параметрам СтруктураПараметровВход, используя макет отображения
// МакетВход. Когда параметр ОтбиратьМспВход - Истина, в документ попадут только строки по МСП.
Процедура ВывестиОсновнуюТаблицу(СтруктураИсходныхДанных, СтруктураПараметровВход, ПриоритетУчастияМалогоИСреднегоПредпринимательства, МакетВход, ДокументРезультатИзм, Периодичность)    
	
	ТаблицаИсходныеДанныеВход 	= СтруктураИсходныхДанных.Потребности;
	Финансирование 				= СтруктураИсходныхДанных.Финансирование;      
	
	ПустаяДата = Дата(1, 1, 1);
	Организация_				 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметровВход, "Организация", Справочники.Организации.ПустаяСсылка());
	ДатаНачалаПериода_			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметровВход, "ДатаНачалаПериода", ПустаяДата);
	ДатаОкончанияПериода_		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметровВход, "ДатаОкончанияПериода", ПустаяДата);
	Инновационный_				 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметровВход, "Инновационный", Ложь);
	ОтобразитьНевыгружаемые_	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметровВход, "ОтобразитьНевыгружаемые", Ложь);
	// Свертка по разделам.       
	Если Периодичность = Перечисления.Периодичность.Квартал Тогда     
		МассивГоды = ТаблицаИсходныеДанныеВход.ВыгрузитьКолонку("ГруппировкаПоПериодам");
		МассивГоды = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивГоды); 
		Формат = "ДФ='к ""кв."" yyyy""г.""'"; 
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда     
		МассивГоды = ТаблицаИсходныеДанныеВход.ВыгрузитьКолонку("ГруппировкаПоПериодам");
		МассивГоды = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивГоды); 
		Формат = "ДФ='MMMM yyyy""г.""'"; 
	Иначе
		МассивГоды = ТаблицаИсходныеДанныеВход.ВыгрузитьКолонку("НомерГода");
		МассивГоды = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивГоды); 
		Формат = "ЧГ=; ДФ='yyyy ""г.""'";
	КонецЕсли;
	МассивПричины = ТаблицаИсходныеДанныеВход.ВыгрузитьКолонку("ПричинаНевыгрузки");
	МассивПричины = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПричины);
	// Вывод табличной части.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Выгружаемая", НЕ ОтобразитьНевыгружаемые_);
	СтруктураПоиска.Вставить("ПриоритетУчастияМалогоИСреднегоПредпринимательства", ПриоритетУчастияМалогоИСреднегоПредпринимательства);
	
	Для Каждого ТекМассивГоды Из МассивГоды Цикл
		// Вывод периода.            
		Если Периодичность = Перечисления.Периодичность.Квартал Тогда
			СтруктураПоиска.Вставить("ГруппировкаПоПериодам", ТекМассивГоды);
		ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда
			СтруктураПоиска.Вставить("ГруппировкаПоПериодам", ТекМассивГоды);
		Иначе              
			СтруктураПоиска.Вставить("НомерГода", ТекМассивГоды);
		КонецЕсли;
		НайденныеСтрокиНомерГода = ТаблицаИсходныеДанныеВход.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтрокиНомерГода.Количество() > 0 Тогда
			ОбластьСтрокаПериод = МакетВход.ПолучитьОбласть("ОбластьСтрокаПериод");
			ТекстПериод = НСтр("ru = '%Год%'");
			ТекстПериод = СтрЗаменить(ТекстПериод, "%Год%", Формат(ТекМассивГоды, Формат));
			ОбластьСтрокаПериод.Параметры.Период = ТекстПериод;
			ДокументРезультатИзм.Вывести(ОбластьСтрокаПериод);
			Номер = 1;
				ТаблицаИсходныеДанныеВход.Сортировать("НомерВГПЗ");   
				НайденныеСтрокиПричины = ТаблицаИсходныеДанныеВход.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтрокиПричины.Количество() > 0 Тогда
					Для Каждого ТекТаблицаИсходныеДанные Из НайденныеСтрокиПричины Цикл
						// Вывод детальных записей.
						ОбластьДетальныеЗаписи = МакетВход.ПолучитьОбласть("ОбластьСтрокаДетальныеЗаписи");  
						
						ПараметрыОбласти = ОбластьДетальныеЗаписи.Параметры;
						ТекСтрокаПланаЗакупок = ТекТаблицаИсходныеДанные.СтрокаПланаЗакупок;
						ТекМестоПоставки = ТекСтрокаПланаЗакупок.МестоПоставки;
						ТекстТребования = ПолучитьПредставлениеТребований(ТекСтрокаПланаЗакупок);
						ПараметрыОбласти.СтрокаПорядковыйНомер			 = ТекСтрокаПланаЗакупок.НомерВГПЗ;
						ПараметрыОбласти.СтрокаПредметДоговора			 = ТекТаблицаИсходныеДанные.ПредметДоговора;
						ПараметрыОбласти.СтрокаМинимальныеТребования	 = ТекстТребования;
						Если ЗначениеЗаполнено(ТекТаблицаИсходныеДанные.ЕдиницаИзмерения) Тогда
							ПараметрыОбласти.СтрокаКодОКЕИ				 = ТекТаблицаИсходныеДанные.ЕдиницаИзмерения.Код;
							ПараметрыОбласти.СтрокаЕдиницаИзмерения		 = ТекТаблицаИсходныеДанные.ЕдиницаИзмерения;
						Иначе
							ПараметрыОбласти.СтрокаКодОКЕИ				 = "879";				// Условная штука.
							ПараметрыОбласти.СтрокаЕдиницаИзмерения		 = НСтр("ru = 'усл.шт.'");
						КонецЕсли;
						ПараметрыОбласти.СтрокаКоличество				 = ТекТаблицаИсходныеДанные.Количество;
						ПараметрыОбласти.СтрокаКодОКАТО					 = ТекТаблицаИсходныеДанные.МестоПоставкиКодПоОКАТО;
						ПараметрыОбласти.СтрокаРегион					 = ТекТаблицаИсходныеДанные.МестоПоставки;
						ПараметрыОбласти.СтрокаНМЦ						 = ТекСтрокаПланаЗакупок.СуммаДокумента;
						ПараметрыОбласти.СтрокаДатаРазмещения			 = Формат(ТекТаблицаИсходныеДанные.ПериодРазмещения,  "ДФ=MM.yyyy");
						ПараметрыОбласти.СтрокаСрокИсполнения			 = Формат(ТекТаблицаИсходныеДанные.ПериодИсполненияДоговора,  "ДФ=MM.yyyy");
						ПараметрыОбласти.СтрокаСпособЗакупки			 = ТекСтрокаПланаЗакупок.СпособВыбораПоставщика;
						ПараметрыОбласти.СтрокаЗакупкаВЭлектроннойФорме	 = ТекСтрокаПланаЗакупок.ВЭлектроннойФорме;
						ПараметрыОбласти.СтрокаКодОКВЭД					 = ТекТаблицаИсходныеДанные.КодОКВЭД;
						ПараметрыОбласти.СтрокКодОКПД					 = ТекТаблицаИсходныеДанные.КодОКПД2;
						
						ИсточникиФинансирования = Финансирование.НайтиСтроки(Новый Структура("СтрокаПланаЗакупок", ТекТаблицаИсходныеДанные.СтрокаПланаЗакупок)); 
						НомерСтроки = 1;            
						
						Для Каждого ИсточникФинансирования Из ИсточникиФинансирования Цикл 
							
							Если НомерСтроки = 1 Тогда  
								
								ПараметрыОбласти.ОбъемФинансирования = ИсточникФинансирования.ОбъемФинансовогоОбеспечения;
								ПараметрыОбласти.КодЦелевойСтатьи = ИсточникФинансирования.ЦелеваяСтатьяРасходовПредставление + ", " + ИсточникФинансирования.ВидРасходовПредставление; 
								
								НомерСтроки = НомерСтроки + 1;          
								
							Иначе             
								
								ОбластьДетальныеЗаписиСледующая = МакетВход.ПолучитьОбласть("ОбластьСтрокаДетальныеЗаписи");
								ОбластьДетальныеЗаписиСледующая.Параметры.ОбъемФинансирования = ИсточникФинансирования.ОбъемФинансовогоОбеспечения;	
								ОбластьДетальныеЗаписиСледующая.Параметры.КодЦелевойСтатьи = ИсточникФинансирования.ЦелеваяСтатьяРасходовПредставление + ", " + ИсточникФинансирования.ВидРасходовПредставление;   
								
								ОбластьДетальныеЗаписи.ВставитьОбласть(ОбластьДетальныеЗаписиСледующая.Область(),, ТипСмещенияТабличногоДокумента.ПоВертикали); 
								
								Для НомерКолонки = 1 По 17 Цикл             
									Если НомерКолонки = 16 Тогда
										ТекущаяОбласть = ОбластьДетальныеЗаписи.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
										ТекущаяОбласть.Текст = ОбластьДетальныеЗаписиСледующая.Параметры.ОбъемФинансирования;
									ИначеЕсли НомерКолонки = 17 Тогда       
										ТекущаяОбласть = ОбластьДетальныеЗаписи.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
										ТекущаяОбласть.Текст = ОбластьДетальныеЗаписиСледующая.Параметры.КодЦелевойСтатьи;
									Иначе
										ТекущаяОбласть = ОбластьДетальныеЗаписи.Область(1, НомерКолонки, НомерСтроки, НомерКолонки);
										ТекущаяОбласть.Объединить();  
									КонецЕсли;
								КонецЦикла; 
								
								НомерСтроки = НомерСтроки + 1;
								
							КонецЕсли;
						КонецЦикла;
						
						ДокументРезультатИзм.Вывести(ОбластьДетальныеЗаписи);  
						
					КонецЦикла;	
				Иначе
					// Нет строк по этой причине. Пропускаем вывод.
				КонецЕсли;
				СтруктураПоиска.Удалить("ПричинаНевыгрузки");
		Иначе
			// Нет строк по этому году. Пропускаем.
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры		// ВывестиОсновнуюТаблицу()

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	ПустаяДата = Дата(1, 1, 1);
	// Получение параметров.
	Настройки 					= КомпоновщикНастроек.ПолучитьНастройки();
	СтруктураПараметров 		= СчитатьСтруктуруПараметров(Настройки);
	Организация_ 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПараметров.ПланЗакупки, 	"ОрганизацияДляЗаключенияДоговора");
	ДатаНачалаПериода_ 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПараметров.ПланЗакупки, 	"ПериодЗакупок.ДатаНачала");
	ДатаОкончанияПериода_		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПараметров.ПланЗакупки, 	"ПериодЗакупок.ДатаОкончания");
	ОтобразитьНевыгружаемые_ 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, 			"ОтобразитьНевыгружаемые", Ложь); 
	
	ПараметрыУчастияМСП = Новый Структура;
	ПараметрыУчастияМСП.Вставить("ОбъемЗакупокИнновационных", 0);                   //1  +
	ПараметрыУчастияМСП.Вставить("ОбъемЗакупокИсключаемыхМСП", 0);                 	//2  +
	ПараметрыУчастияМСП.Вставить("ГодовойОбъемЗакупокМСП", 0);                  	//3  +
	ПараметрыУчастияМСП.Вставить("СуммаИнновационныхПрошлыйГод", 0); 				//4  +
	ПараметрыУчастияМСП.Вставить("ОбъемЗакупокИнновационныхОтчетный", 0);       	//5	 +
	ПараметрыУчастияМСП.Вставить("ОбъемЗакупокИнновационныхИсключаемых", 0);    	//6  +
	ПараметрыУчастияМСП.Вставить("ОбъемЗакупокИнновационныхМСП", 0);    			//7	 +
	ПараметрыУчастияМСП.Вставить("СуммаИнновационныхМСППрошлыйГод", 0);				//8  +
	// Вывод шапки.
	ДокументРезультат.Очистить();   
	СтандартнаяОбработка = Ложь;
	Макет = ПолучитьМакет("МакетФормаПлан"); 
	
	Если ЗначениеЗаполнено(Организация_) Тогда  
		
		СведенияОрганизации = УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ПолучитьСведенияОбОрганизацииДляПечатнойФормы(
									Организация_, ДатаНачалаПериода_); 
									
		ОбластьОсновныеДанные = Макет.ПолучитьОбласть("ОбластьОсновныеДанные");
		Если Год(ДатаНачалаПериода_) = Год(ДатаОкончанияПериода_) Тогда
			ОбластьОсновныеДанные.Параметры.ПредставлениеПериода = Формат(Год(ДатаНачалаПериода_), "ЧГ=0");
			ОбластьОсновныеДанные.Параметры.ЗаголовокПериода = НСтр("ru = 'год'");
		Иначе
			НовоеПредставлениеПериода = Формат(Год(ДатаНачалаПериода_), "ЧГ=0") + " - " + Формат(Год(ДатаОкончанияПериода_), "ЧГ=0");
			ОбластьОсновныеДанные.Параметры.ПредставлениеПериода = НовоеПредставлениеПериода;
			ОбластьОсновныеДанные.Параметры.ЗаголовокПериода = НСтр("ru = 'период'");
		КонецЕсли;
		ОбластьОсновныеДанные.Параметры.Наименование	 = СведенияОрганизации.НаименованиеОрганизацииДляПечатныхФорм; 
		ОбластьОсновныеДанные.Параметры.Адрес			 = СведенияОрганизации.ЮридическийАдрес;
		ОбластьОсновныеДанные.Параметры.Телефон			 = СведенияОрганизации.Телефоны;
		ОбластьОсновныеДанные.Параметры.ЭлПочта			 = СведенияОрганизации.Email;
		ОбластьОсновныеДанные.Параметры.ИНН				 = СведенияОрганизации.ИНН;
		ОбластьОсновныеДанные.Параметры.КПП				 = СведенияОрганизации.КПП;
		Если ЗначениеЗаполнено(Организация_.РегистрацияВНалоговомОргане) Тогда
			ОбластьОсновныеДанные.Параметры.ОКАТО		 = Организация_.РегистрацияВНалоговомОргане.КодПоОКАТО;
		Иначе
			ОбластьОсновныеДанные.Параметры.ОКАТО		 = "";
		КонеЦЕсли;
		ДокументРезультат.Вывести(ОбластьОсновныеДанные);         
		
		// Получение исходных данных.    
		СтруктураИсходныхДанных = ПолучитьТаблицаИсходныхДанных(СтруктураПараметров.ПланЗакупки, ДатаНачалаПериода_, Организация_, СтруктураПараметров.Периодичность);  
		
		// Общая таблица.
		ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
		ДокументРезультат.Вывести(ОбластьШапка); 
		ВывестиОсновнуюТаблицу(СтруктураИсходныхДанных, СтруктураПараметров, Ложь, Макет, ДокументРезультат, СтруктураПараметров.Периодичность); 
		
		// Заголовок МСП.
		ОбластьЗаголовокМСП = Макет.ПолучитьОбласть("ОбластьЗаголовокМСП");
		ДокументРезультат.Вывести(ОбластьЗаголовокМСП);   
		
		// Заголовок ОбластьУчастиеМСП.    
		Если СтруктураИсходныхДанных.Объемы.Количество() Тогда
			ЗаполнитьЗначенияСвойств(ПараметрыУчастияМСП, СтруктураИсходныхДанных.Объемы[0]);
		КонецЕсли;
		
		ОбластьУчастиеМСП = Макет.ПолучитьОбласть("ОбластьУчастиеМСП");
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%1", ПараметрыУчастияМСП.ОбъемЗакупокИнновационных); 
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%2", ПараметрыУчастияМСП.ОбъемЗакупокИсключаемыхМСП);
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%3", ПараметрыУчастияМСП.ГодовойОбъемЗакупокМСП);
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%4", ПараметрыУчастияМСП.СуммаИнновационныхПрошлыйГод);
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%5", ПараметрыУчастияМСП.ОбъемЗакупокИнновационныхОтчетный);
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%6", ПараметрыУчастияМСП.ОбъемЗакупокИнновационныхИсключаемых);
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%7", ПараметрыУчастияМСП.ОбъемЗакупокИнновационныхМСП);
		ОбластьУчастиеМСП.Область(2,1,2,1).Текст = СтрЗаменить(ОбластьУчастиеМСП.Область(2,1,2,1).Текст, "%8", ПараметрыУчастияМСП.СуммаИнновационныхМСППрошлыйГод);
		ДокументРезультат.Вывести(ОбластьУчастиеМСП);  
		
		// Таблица по МСП.
		ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
		ДокументРезультат.Вывести(ОбластьШапка); 
		ВывестиОсновнуюТаблицу(СтруктураИсходныхДанных, СтруктураПараметров, Истина, Макет, ДокументРезультат, СтруктураПараметров.Периодичность);  
		
		// Подвал.
		ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
		ДокументРезультат.Вывести(ОбластьПодвал);
	КонецЕсли;
КонецПроцедуры

#КонецЕсли
