		|	ДокументСтрока.НеВключенВПланЗакупкиЧасть15Ст4ФЗ223,
		|	ДокументСтрока.ОрганизаторЗакупки.ЗакупкаПоФЗ223,
		|	ДокументСтрока.ЗакрытаяЗакупка,
		|	ДокументСтрока.НомерВГПЗ,
		|	ДокументСтрока.ПриоритетУчастияМалогоИСреднегоПредпринимательства,
		|	ЕСТЬNULL(ДокументСтрока.СуммаДокумента, 0) < ЕСТЬNULL(МалыеЗакупкиСрезПоследних.Сумма, 0),
		|	СтрокаПланаЗакупокНоменклатура.МестоПоставки,
		|	СтрокаПланаЗакупокНоменклатура.МестоПоставки.КодПоОКАТО,
		|	СтрокиПланаЗакупокСрезПоследних.ИнновационныйПланЗакупок
		|;
