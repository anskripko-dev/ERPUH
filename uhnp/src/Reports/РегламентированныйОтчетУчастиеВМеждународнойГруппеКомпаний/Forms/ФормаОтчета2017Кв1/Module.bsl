#Область ВыгрузкаИПроверкаВыгрузкиЭлектронногоПредставленияИЗагрузкаОтчетаИзФайла

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтотОбъект);
	
	Отказ = Ложь;
	ОнлайнСервисыРегламентированнойОтчетностиКлиент.ПередЗагрузкойРегламентированногоОтчета(ОписаниеОповещения, ЭтотОбъект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьИзФайлаОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаОтчет() Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьИзФайлаОтчетЗавершение", ЭтотОбъект);
	
	Если Модифицированность Тогда
		СохранитьНаКлиенте(,ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаОтчетЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	РегламентированнаяОтчетностьЗагрузкаКлиент.ЗагрузитьИзФайлаОтчет(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Функция ЗагрузкаОтчетаИзФайла(ДанныеДляЗагрузки) Экспорт
	
	Если Модифицированность Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru='Отчет ""%1"" не сохранен.'"), ЭтотОбъект.Заголовок);
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗагрузкаОтчетаИзФайлаНаСервере(ДанныеДляЗагрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗагрузкаОтчетаИзФайлаНаСервере(ДанныеДляЗагрузки)
	
	СформироватьСтруктуруПоказателей();
	
	ПараметрыОтчета = СформироватьСтруктуруПараметров();
	
	ДеревоДляЗагрузки = ИзвлечьСтруктуруXML("СхемаВыгрузки501");
	
	Если НЕ РегламентированнаяОтчетностьЗагрузка.ЗагрузкаОтчетаИзФайла(
		ЭтотОбъект, ПараметрыОтчета, ДанныеДляЗагрузки, ДеревоДляЗагрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура Выгрузить(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьЗавершение", ЭтотОбъект);
	
	Отказ = Ложь;
	ОнлайнСервисыРегламентированнойОтчетностиКлиент.ПередВыгрузкойРегламентированногоОтчета(
		ОписаниеОповещения, ЭтотОбъект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчет() Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьОтчетЗавершение", ЭтотОбъект);
	
	Если Модифицированность Тогда
		СохранитьНаКлиенте(,ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчетЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ФормаВыгрузкиРеглОтчета = Неопределено;
	
	ФормаВыгрузкиРеглОтчета = ПолучитьФорму(
		"Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , ЭтаФорма);
	
	СпДокОсн = Новый СписокЗначений;
	СпДокОсн.Добавить(СтруктураРеквизитовФормы.мСохраненныйДок);
	
	ФормаВыгрузкиРеглОтчета.СформироватьИЗаписать(СпДокОсн);
	
КонецПроцедуры

&НаКлиенте
Функция УниверсальнаяВыгрузка(ТекстВыгрузки = Неопределено, ПроверятьБлокировки = Истина) Экспорт
	
	Перем ПараметрыВыгрузки;
	
	Если Модифицированность Тогда
		ТекстЗаголовка = ЗаголовокРегламентированногоОтчета(
			СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
		
		ОргСтр = " (" + СтруктураРеквизитовФормы.Организация + ")";
		Если СтрНайти(ТекстЗаголовка, ОргСтр) = 0 Тогда
			ТекстЗаголовка = ТекстЗаголовка + ОргСтр;
		КонецЕсли;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отчет """ + ТекстЗаголовка + """ не сохранен.";
		Сообщение.Сообщить();
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Открыта() Тогда
		Если СтруктураРеквизитовФормы.ЕдиницаИзмерения
			<> ПорядкиОкругленияОтчетности.ПеречислениеПорядкиОкругленияОтчетностиОкр1 Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Перед выгрузкой необходимо установить единицу измерения ""в рублях"".'");
			Сообщение.Сообщить();
			
			Возврат Ложь;
			
		КонецЕсли;
		
		Если СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения <> 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Перед выгрузкой необходимо установить точность ""0"".'");
			Сообщение.Сообщить();
			
			Возврат Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузки, ПараметрыВыгрузки) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ЗаголовокРегламентированногоОтчета(ДатаНач, ДатаКон, Периодичность = Неопределено) Экспорт
	
	СтрПериодОтчета = ПредставлениеПериода(НачалоДня(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета),
		КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета), "ФП = Истина" );
	
	Если СтрНайти(Заголовок, СтрПериодОтчета) = 0 Тогда
		Возврат Заголовок + " на " + СтрПериодОтчета;
	Иначе
		Возврат Заголовок;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузки, ПараметрыВыгрузки)
	
	СформироватьСтруктуруПоказателей();
	ПараметрыВыгрузки = СформироватьСтруктуруПараметров();
	
	ДеревоВыгрузки = ИзвлечьСтруктуруXML("СхемаВыгрузки501");
	
	Если НЕ ПроверитьВозможностьВыгрузки(ПараметрыВыгрузки, ДеревоВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаполнитьДанными(ПараметрыВыгрузки, ДеревоВыгрузки);
	
	ТекстВыгрузки = Новый Массив;
	
	ТекстВыгр = ВыгрузитьДеревоВXML(ДеревоВыгрузки, ПараметрыВыгрузки);
	ТекстВыгрузки.Добавить(ВыгрузкаОтчета(ТекстВыгр, ПараметрыВыгрузки));
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция СформироватьСтруктуруПоказателей()
	
	мДанныеОтчета = Новый Структура;
	
	СохрСтруктура = СохраненныеДанныеОтчета();
	ПоказателиОтчета = СохрСтруктура.ПоказателиОтчета;
	Для Каждого Раздел Из ПоказателиОтчета Цикл
		мДанныеОтчета.Вставить(СтрЗаменить(Раздел.Ключ, "ПолеТабличногоДокумента", ""),
			РегламентированнаяОтчетность.СвернутьДанныеТабличногоПоля(Раздел.Значение));
	КонецЦикла;
	
	Для Каждого Раздел Из мСтруктураМногоуровневыхРазделов Цикл
		мДанныеОтчета.Вставить(Раздел.Ключ);
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция СформироватьСтруктуруПараметров()
	
	Титульный = мДанныеОтчета.Титульный;
	
	ПараметрыВыгрузки = Новый Структура;
	
	ПараметрыВыгрузки.Вставить("ВерсПрог", РегламентированнаяОтчетность.НазваниеИВерсияПрограммы());
	ПараметрыВыгрузки.Вставить("КодНО",    СокрЛП(Титульный.НалоговыйОрган));
	ПараметрыВыгрузки.Вставить("НомКор",   Строка(СтруктураРеквизитовФормы.мСохраненныйДок.Вид));
	
	ПараметрыВыгрузки.Вставить("НаимМГ",    СокрЛП(Титульный.НаимМГ));
	ПараметрыВыгрузки.Вставить("НаимМГЛат", СокрЛП(Титульный.НаимМГЛат));
	
	ПараметрыВыгрузки.Вставить("НомРосМатК", СокрЛП(Титульный.НомРосМатК));
	ПараметрыВыгрузки.Вставить("НомИнМатК",  СокрЛП(Титульный.НомИнМатК));
	
	ПараметрыВыгрузки.Вставить("ДатаНач_Дата", Титульный.ДатаНач);
	ПараметрыВыгрузки.Вставить("ДатаНач",      Формат(Титульный.ДатаНач, "ДФ=""гггг-ММ-дд"""));
	
	ПараметрыВыгрузки.Вставить("ДатаОконч_Дата", СтруктураРеквизитовФормы.мСохраненныйДок.ДатаОкончания);
	ПараметрыВыгрузки.Вставить("ДатаОконч",      Формат(СтруктураРеквизитовФормы.мСохраненныйДок.ДатаОкончания, "ДФ=""гггг-ММ-дд"""));
	
	ПараметрыВыгрузки.Вставить("ФинГод", СокрЛП(Титульный.ОтчетГод));
	
	ПараметрыВыгрузки.Вставить("НаимОрг", СокрЛП(Титульный.НаимОрг));
	ПараметрыВыгрузки.Вставить("ИННОрг",  СокрЛП(СтруктураРеквизитовФормы.Организация.ИНН));
	ПараметрыВыгрузки.Вставить("КПП",     СокрЛП(Титульный.КПП));
	
	ПараметрыВыгрузки.Вставить("НаимУчМГЛат",      СокрЛП(Титульный.НаимУчМГЛат));
	ПараметрыВыгрузки.Вставить("ПрУчМГ",           СокрЛП(Титульный.ПрУчМГ));
	ПараметрыВыгрузки.Вставить("ОГРН",             СокрЛП(Титульный.ОГРН));
	ПараметрыВыгрузки.Вставить("СтатУчМГ",         СокрЛП(Титульный.СтатУчМГ));
	ПараметрыВыгрузки.Вставить("ПолнУчМГ",         СокрЛП(Титульный.ПолнУчМГ));
	ПараметрыВыгрузки.Вставить("ОсновПредстСтран", СокрЛП(Титульный.ОсновПредстСтран));
	ПараметрыВыгрузки.Вставить("ПрСтрПред",        СокрЛП(Титульный.ПрСтрПред));
	ПараметрыВыгрузки.Вставить("ФОИВ",             СокрЛП(Титульный.ФОИВ));
	ПараметрыВыгрузки.Вставить("ПрСогл",           СокрЛП(Титульный.ПрСогл));
	ПараметрыВыгрузки.Вставить("ИнфСогл",          СокрЛП(Титульный.ИнфСогл));
	
	ПараметрыВыгрузки.Вставить("ПрПодп",    СокрЛП(Титульный.ПрПодп));
	ПараметрыВыгрузки.Вставить("ДолжнПодп", СокрЛП(Титульный.ДолжнПодп));
	ПараметрыВыгрузки.Вставить("Тлф",       СокрЛП(Титульный.ТлфПодп));
	ПараметрыВыгрузки.Вставить("ЭлПочта",   СокрЛП(Титульный.ЭлПочтаПодп));
	ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(Титульный.ОргПодписант);
	ПараметрыВыгрузки.Вставить("ФамилияПодписанта",  ФИОПодписанта.Фамилия);
	ПараметрыВыгрузки.Вставить("ИмяПодписанта",      ФИОПодписанта.Имя);
	ПараметрыВыгрузки.Вставить("ОтчествоПодписанта", ФИОПодписанта.Отчество);
	ПараметрыВыгрузки.Вставить("НаимДокПред", СокрЛП(Титульный.ДокУпПред));
	
	СтруктураПараметров = Новый Структура("Организация, ДатаЗначения",
	СтруктураРеквизитовФормы.Организация, СтруктураРеквизитовФормы.мСохраненныйДок.ДатаОкончания);
	ПараметрыВыгрузки.Вставить("КодИФНСПосредника",
	РегламентированнаяОтчетность.КодНалоговогоОрганаПолучателяОтчетности(СтруктураПараметров));
	
	ПараметрыВыгрузки.Вставить("ИмяКлючевогоУзлаСодержательнойЧасти1", "Раздел1");
	ПараметрыВыгрузки.Вставить("ИмяКлючевогоУзлаСодержательнойЧасти2", "Раздел2");
	
	ПараметрыВыгрузки.Вставить("ИдФайл", ИдентификаторФайлаВыгрузки(ПараметрыВыгрузки, "ON_UVUCHMGR"));
	
	Возврат ПараметрыВыгрузки;
	
КонецФункции

&НаСервере
Функция ИзвлечьСтруктуруXML(ИмяМакета)
	
	ДеревоСтруктуры = Новый ДеревоЗначений;
	ДеревоСтруктуры.Колонки.Добавить("Код");
	ДеревоСтруктуры.Колонки.Добавить("Тип");
	ДеревоСтруктуры.Колонки.Добавить("Формат");
	ДеревоСтруктуры.Колонки.Добавить("МинРазмерность");
	ДеревоСтруктуры.Колонки.Добавить("МаксРазмерность");
	ДеревоСтруктуры.Колонки.Добавить("Обязательность");
	ДеревоСтруктуры.Колонки.Добавить("Многостраничность");
	ДеревоСтруктуры.Колонки.Добавить("Многострочность");
	ДеревоСтруктуры.Колонки.Добавить("Раздел");
	ДеревоСтруктуры.Колонки.Добавить("Ключ");
	ДеревоСтруктуры.Колонки.Добавить("Условие");
	ДеревоСтруктуры.Колонки.Добавить("ЗначениеПоУмолчанию");
	ДеревоСтруктуры.Колонки.Добавить("Значение");
	ДеревоСтруктуры.Колонки.Добавить("Представление");
	ДеревоСтруктуры.Колонки.Добавить("Показатели");
	
	Макет = ОбъектОтчета(ИмяФормы).ПолучитьМакет(ИмяМакета);
	
	ВысотаТаблицы = Макет.ВысотаТаблицы;
	
	УчтенныеГруппы = Новый Соответствие;
	
	Для Уровень = 0 По Макет.КоличествоУровнейГруппировокСтрок() - 1 Цикл
		Макет.ПоказатьУровеньГруппировокСтрок(Уровень);
		Для НомерСтроки = 2 По ВысотаТаблицы Цикл
			НомСтр = ВысотаТаблицы - НомерСтроки + 2;
			Если Макет.Область(НомСтр, 0, НомСтр, 0).Видимость И УчтенныеГруппы.Получить(НомСтр) = Неопределено Тогда
				
				РодительскийУзел = ДеревоСтруктуры;
				Если Уровень <> 0 Тогда
					Для Инд = 1 По НомСтр - 2 Цикл
						Узел = УчтенныеГруппы.Получить(НомСтр - Инд);
						Если Узел <> Неопределено Тогда
							РодительскийУзел = Узел;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				НовСтр = РодительскийУзел.Строки.Вставить(0);
				НовСтр.Код = СокрЛП(Макет.Область(НомСтр, 1, НомСтр, 1).Текст);
				НовСтр.Раздел = СокрЛП(Макет.Область(НомСтр, 2, НомСтр, 2).Текст);
				НовСтр.Ключ = СокрЛП(Макет.Область(НомСтр, 3, НомСтр, 3).Текст);
				НовСтр.Тип = СокрЛП(Макет.Область(НомСтр, 4, НомСтр, 4).Текст);
				НовСтр.Формат = СокрЛП(Макет.Область(НомСтр, 5, НомСтр, 5).Текст);
				МинРазмерность = СокрЛП(Макет.Область(НомСтр, 6, НомСтр, 6).Текст);
				НовСтр.МинРазмерность = ?(ПустаяСтрока(МинРазмерность), ?(НовСтр.Формат = "N", 99999, 0), Число(МинРазмерность));
				МаксРазмерность = СокрЛП(Макет.Область(НомСтр, 7, НомСтр, 7).Текст);
				НовСтр.МаксРазмерность = ?(ПустаяСтрока(МаксРазмерность), 99999, Число(МаксРазмерность));
				НовСтр.Обязательность = СокрЛП(Макет.Область(НомСтр, 8, НомСтр, 8).Текст);
				НовСтр.Многостраничность = НЕ ПустаяСтрока(Макет.Область(НомСтр, 9, НомСтр, 9).Текст);
				НовСтр.Многострочность = НЕ ПустаяСтрока(Макет.Область(НомСтр, 10, НомСтр, 10).Текст);
				НовСтр.Условие = СокрЛП(Макет.Область(НомСтр, 11, НомСтр, 11).Текст);
				НовСтр.ЗначениеПоУмолчанию = СокрЛП(Макет.Область(НомСтр, 12, НомСтр, 12).Текст);
				НовСтр.Представление = СокрЛП(Макет.Область(НомСтр, 13, НомСтр, 13).Текст);
				
				УчтенныеГруппы.Вставить(НомСтр, НовСтр);
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДеревоСтруктуры;
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьВыгрузки(ПараметрыВыгрузки, ДеревоВыгрузки)
	
	СтатусПроверки = Истина;
	
	ДанныеМногоуровневыхРазделов = Новый Структура;
	СохрСтруктура = СохраненныеДанныеОтчета();
	Для каждого ЭлементСтруктуры Из СохрСтруктура.ДанныеМногоуровневыхРазделов Цикл
		ДанныеМногоуровневыхРазделов.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;
	
	ДеревоРаздела1 = ДанныеМногоуровневыхРазделов.Раздел1;
	ДеревоРаздела2 = ДанныеМногоуровневыхРазделов.Раздел2;
	
	// Проверка титульного листа.
	//
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.КодНО) Тогда
		СообщитьВТС("На титульном листе не задан код налогового органа.", "Титульный", "НалоговыйОрган");
		СтатусПроверки = Ложь;
	ИначеЕсли СтрДлина(ПараметрыВыгрузки.КодНО) <> 4 Тогда
		СообщитьВТС("На титульном листе задан код налогового органа, не состоящий из 4 цифр.", "Титульный", "НалоговыйОрган");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.НаимМГ) Тогда
		СообщитьВТС("На титульном листе не задано наименование международной группы (в русской транскрипции).", "Титульный", "НаимМГ");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.НаимМГЛат) Тогда
		СообщитьВТС("На титульном листе не задано наименование международной группы (в латинской транскрипции).", "Титульный", "НаимМГЛат");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ДатаОконч_Дата) Тогда
		СообщитьВТС("На титульном листе не задана дата окончания отчетного периода.", "Титульный", "ДатаОконч");
		СтатусПроверки = Ложь;
	ИначеЕсли ЗначениеЗаполнено(ПараметрыВыгрузки.ДатаНач_Дата) Тогда
		Если ПараметрыВыгрузки.ДатаНач_Дата > ПараметрыВыгрузки.ДатаОконч_Дата Тогда
			СообщитьВТС("На титульном листе дата начала отчетного периода не может быть больше даты окончания.", "Титульный", "ДатаНач");
			СтатусПроверки = Ложь;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПараметрыВыгрузки.ФинГод)
			И (ПараметрыВыгрузки.ФинГод <> Формат(ПараметрыВыгрузки.ДатаНач_Дата, "ДФ=""гггг""")) Тогда
			СообщитьВТС("На титульном листе значение отчетного финансового года должно быть равно значению года в дате начала отчетного периода.", "Титульный", "ФинГод");
			СтатусПроверки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ИННОрг) Тогда
		СообщитьВТС("На титульном листе не задан ИНН налогоплательщика.", "Титульный", "ИНН");
		СтатусПроверки = Ложь;
	ИначеЕсли СтрДлина(ПараметрыВыгрузки.ИННОрг) <> 10 Тогда
		СообщитьВТС("На титульном листе задан ИНН налогоплательщика, не состоящий из 10 цифр.", "Титульный", "ИНН");
		СтатусПроверки = Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.КПП) Тогда
		СообщитьВТС("На титульном листе не задан КПП налогоплательщика.", "Титульный", "КПП");
		СтатусПроверки = Ложь;
	ИначеЕсли СтрДлина(ПараметрыВыгрузки.КПП) <> 9 Тогда
		СообщитьВТС("На титульном листе задан КПП налогоплательщика, не состоящий из 9 символов.", "Титульный", "КПП");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	ПрУчМГ_ВозможныеКоды = СтрРазделить("1,2,3,4", ",", Ложь);
	ПрУчМГ_КодыДляСообщения = СтрСоединить(ПрУчМГ_ВозможныеКоды, """, """);
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ПрУчМГ) Тогда
		СообщитьВТС("На титульном листе не задан код признака участника международной группы.", "Титульный", "ПрУчМГ");
		СтатусПроверки = Ложь;
	ИначеЕсли ПрУчМГ_ВозможныеКоды.Найти(ПараметрыВыгрузки.ПрУчМГ) = Неопределено Тогда
		СообщитьВТС("На титульном листе код признака участника международной группы должен принимать одно из значений: """
		+ ПрУчМГ_КодыДляСообщения + """.", "Титульный", "ПрУчМГ");
		СтатусПроверки = Ложь;
	КонецЕсли;
	Если ПараметрыВыгрузки.ПрУчМГ = "1" Тогда
		Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ОГРН) Тогда
			СообщитьВТС("На титульном листе не задан ОГРН участника международной группы, представившего уведомление.", "Титульный", "ОГРН");
			СтатусПроверки = Ложь;
		ИначеЕсли СтрДлина(ПараметрыВыгрузки.ОГРН) <> 13 Тогда
			СообщитьВТС("На титульном листе задан ОГРН участника международной группы, представившего уведомление, не состоящий из 13 цифр.", "Титульный", "ОГРН");
			СтатусПроверки = Ложь;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ПараметрыВыгрузки.ОГРН) И СтрДлина(ПараметрыВыгрузки.ОГРН) <> 13 Тогда
			СообщитьВТС("На титульном листе задан ОГРН участника международной группы, представившего уведомление, не состоящий из 13 цифр.", "Титульный", "ОГРН");
			СтатусПроверки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.НаимОрг) Тогда
		СообщитьВТС("На титульном листе не задано полное наименование организации.", "Титульный", "НаимОрг");
		СтатусПроверки = Ложь;
	ИначеЕсли ПараметрыВыгрузки.ПрУчМГ = "3" И НЕ СтрНачинаетсяС(ПараметрыВыгрузки.НаимОрг, "(П.П.)") Тогда
		СообщитьВТС("На титульном листе полное наименование организации должно начинаться с аббревиатуры ""(П.П.)"" при значении ""3"" кода признака участника международной группы.",
		"Титульный", "НаимОрг");
		СтатусПроверки = Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.НаимУчМГЛат) Тогда
		СообщитьВТС("На титульном листе не задано наименование участника международной группы, представившего уведомление.", "Титульный", "НаимУчМГЛат");
		СтатусПроверки = Ложь;
	ИначеЕсли ПараметрыВыгрузки.ПрУчМГ = "3" И НЕ СтрНачинаетсяС(ПараметрыВыгрузки.НаимУчМГЛат, "(P.E.)") Тогда
		СообщитьВТС("На титульном листе наименование участника международной группы, представившего уведомление, должно начинаться с аббревиатуры ""(P.E.)"" при значении ""3"" кода признака участника международной группы.",
		"Титульный", "НаимУчМГЛат");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	ПолнУчМГ_ВозможныеКоды = СтрРазделить("1,2,3", ",", Ложь);
	ПолнУчМГ_КодыДляСообщения = СтрСоединить(ПолнУчМГ_ВозможныеКоды, """, """);
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ПолнУчМГ) Тогда
		СообщитьВТС("На титульном листе не задан код полномочий участника в международной группе.", "Титульный", "ПолнУчМГ");
		СтатусПроверки = Ложь;
	ИначеЕсли ПолнУчМГ_ВозможныеКоды.Найти(ПараметрыВыгрузки.ПолнУчМГ) = Неопределено Тогда
		СообщитьВТС("На титульном листе код полномочий участника в международной группе должен принимать одно из значений: """
		+ ПолнУчМГ_КодыДляСообщения + """.", "Титульный", "ПолнУчМГ");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	ПрСтрПред_ВозможныеКоды = СтрРазделить("1,2,3", ",", Ложь);
	ПрСтрПред_КодыДляСообщения = СтрСоединить(ПрСтрПред_ВозможныеКоды, """, """);
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ПрСтрПред) Тогда
		СообщитьВТС("На титульном листе не задан код признака стратегического предприятия.", "Титульный", "ПрСтрПред");
		СтатусПроверки = Ложь;
	ИначеЕсли ПрСтрПред_ВозможныеКоды.Найти(ПараметрыВыгрузки.ПрСтрПред) = Неопределено Тогда
		СообщитьВТС("На титульном листе код признака стратегического предприятия должен принимать одно из значений: """
		+ ПрСтрПред_КодыДляСообщения + """.", "Титульный", "ПрСтрПред");
		СтатусПроверки = Ложь;
	КонецЕсли;
	ПрСогл_ВозможныеКоды = СтрРазделить("0,1", ",", Ложь);
	ПрСогл_КодыДляСообщения = СтрСоединить(ПрСогл_ВозможныеКоды, """, """);
	Если ПараметрыВыгрузки.ПрСтрПред = "2" ИЛИ ПараметрыВыгрузки.ПрСтрПред = "3" Тогда
		Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ФОИВ) Тогда
			СообщитьВТС("На титульном листе не задана информация о государственном органе либо государственной корпорации, предоставляющих согласие.",
			"Титульный", "ФОИВ");
			СтатусПроверки = Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ПрСогл) Тогда
			СообщитьВТС("На титульном листе не задан код признака наличия согласия.", "Титульный", "ПрСогл");
			СтатусПроверки = Ложь;
		ИначеЕсли ПрСогл_ВозможныеКоды.Найти(ПараметрыВыгрузки.ПрСогл) = Неопределено Тогда
			СообщитьВТС("На титульном листе код признака наличия согласия должен принимать одно из значений: """
			+ ПрСогл_КодыДляСообщения + """.", "Титульный", "ПрСогл");
			СтатусПроверки = Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ИнфСогл) Тогда
			СообщитьВТС("На титульном листе не задана информация о согласии.", "Титульный", "ИнфСогл");
			СтатусПроверки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ФамилияПодписанта) Тогда
		СообщитьВТС("На титульном листе не задана фамилия подписанта.", "Титульный", "ОргПодписант");
		СтатусПроверки = Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ИмяПодписанта) Тогда
		СообщитьВТС("На титульном листе не задано имя подписанта.", "Титульный", "ОргПодписант");
		СтатусПроверки = Ложь;
	КонецЕсли;
	Если ПараметрыВыгрузки.ПрПодп = "2" И НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.НаимДокПред) Тогда
		СообщитьВТС("На титульном листе не заданы наименование и реквизиты документа, подтверждающего полномочия представителя налогоплательщика.",
		"Титульный", "ДокУпПред");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	СтатУчМГ_ВозможныеКоды = СтрРазделить("1,2,3", ",", Ложь);
	СтатУчМГ_КодыДляСообщения = СтрСоединить(СтатУчМГ_ВозможныеКоды, """, """);
	Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.СтатУчМГ) Тогда
		СообщитьВТС("На титульном листе не задан код статуса участника в международной группе.", "Титульный", "СтатУчМГ");
		СтатусПроверки = Ложь;
	ИначеЕсли СтатУчМГ_ВозможныеКоды.Найти(ПараметрыВыгрузки.СтатУчМГ) = Неопределено Тогда
		СообщитьВТС("На титульном листе код статуса участника в международной группе должен принимать одно из значений: """
		+ СтатУчМГ_КодыДляСообщения + """.", "Титульный", "СтатУчМГ");
		СтатусПроверки = Ложь;
	КонецЕсли;
	Если ПараметрыВыгрузки.СтатУчМГ = "2" И НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.ОсновПредстСтран) Тогда
		СообщитьВТС("На титульном листе не задано описание оснований, подтверждающих право уполномоченного участника на представление странового отчета, при значении ""2"" кода статуса участника в международной группе.",
		"Титульный", "ОсновПредстСтран");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	// Проверка связей между разделами.
	//
	Если ЗначениеЗаполнено(ПараметрыВыгрузки.СтатУчМГ)
		И ПараметрыВыгрузки.СтатУчМГ <> "1"
		И НЕ ЗаполненРаздел(ДеревоРаздела1, "Раздел1")
		И НЕ ЗаполненРаздел(ДеревоРаздела2, "Раздел2") Тогда
		СообщитьВТС("Должен быть заполнен раздел 1 и (или) раздел 2 при заданном на титульном листе значении кода статуса участника в международной группе, отличном от ""1"".",
		"Титульный", "СтатУчМГ");
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	СведенияСтатУчМГР1_1 = Новый Массив;
	СведенияСтатУчМГР1_2 = Новый Массив;
	СведенияСтатУчМГР2_1 = Новый Массив;
	СведенияСтатУчМГР2_2 = Новый Массив;
	
	Для каждого СтраницаРаздела Из ДеревоРаздела1.Строки Цикл
		СтатУчМГ = СокрЛП(СтраницаРаздела.Данные["СтатУчМГР1"]);
		Если СтатУчМГ = "1" Тогда
			СведенияСтатУчМГР1_1.Добавить(ДеревоРаздела1.Строки.Индекс(СтраницаРаздела));
		ИначеЕсли СтатУчМГ = "2" Тогда
			СведенияСтатУчМГР1_2.Добавить(ДеревоРаздела1.Строки.Индекс(СтраницаРаздела));
