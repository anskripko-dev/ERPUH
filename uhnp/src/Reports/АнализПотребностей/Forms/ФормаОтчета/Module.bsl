#Область ОбработчикиСобытийФормы

&НаСервере
Функция РезультатОбработкаРасшифровкиНаСервере(Расшифровка,ДанныеРасшифровки)
	
	ДанныеРасшифровкиОбъект = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	Данные = ДанныеРасшифровкиОбъект.Элементы[Расшифровка].ПолучитьПоля()[0];
    СтруктураДанных = Новый Структура;
    СтруктураДанных.Вставить("Поле", Данные.Поле);
    СтруктураДанных.Вставить("Значение", Данные.Значение);
	  
	МассивДанныхЯчеек = Новый Массив;
	
	ДанныеРасшифровкиНов = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);

	ЭлементыМассива = ДанныеРасшифровкиОбъект.Элементы;    
    СтруктураДанных = Новый ТаблицаЗначений;
    СтруктураДанных.Колонки.Добавить("Иденитификатор");
    СтруктураДанных.Колонки.Добавить("Поле");
    СтруктураДанных.Колонки.Добавить("Значение"); 

	Элемент = Расшифровка; 
	МассивРодителей = ДанныеРасшифровкиОбъект.Элементы[Расшифровка].ПолучитьРодителей();
    СтруктураДанных = Неопределено; //Новый Структура;
	
	Для Каждого Массив ИЗ МассивРодителей Цикл    
		Если ТИП(ДанныеРасшифровкиОбъект.Элементы[Массив.Идентификатор]) = ТИП("ЭлементРасшифровкиКомпоновкиДанныхГруппировка") Тогда
			Возврат СтруктураДанных;
		КонецЕсли;	
		Данные = ДанныеРасшифровкиОбъект.Элементы[Массив.Идентификатор].ПолучитьПоля()[0];
		Если Данные.Поле = "Номенклатура" Тогда
		    СтруктураДанных = Новый Структура; 
			СтруктураДанных.Вставить("Номенклатура",Данные.Значение); 
			ДанныеРодителей = ДанныеРасшифровкиОбъект.Элементы[Массив.Идентификатор].ПолучитьРодителей(); 
			Для Каждого МассивРодителя ИЗ ДанныеРодителей Цикл
				Данные = ДанныеРасшифровкиОбъект.Элементы[МассивРодителя.Идентификатор].ПолучитьРодителей()[0].ПолучитьПоля()[0];  
				Если Данные.Поле = "ДокументПланирования" Тогда
					СтруктураДанных.Вставить("ДокументПланирования", Данные.Значение);
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат СтруктураДанных;
	
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеРасшифровкиПоля(ДанныеРасшифровки, ИдентификаторРасшифровки)
		
	СтруктураПолей = Новый Структура;
	
	ЭлементыРасшифровки = ДанныеРасшифровки.Элементы[ИдентификаторРасшифровки];
	Для каждого Элемент Из ЭлементыРасшифровки.ПолучитьПоля() Цикл
		СтруктураПолей.Вставить(Элемент.Поле, Элемент.Значение);
	КонецЦикла;
	
	Возврат СтруктураПолей;
	
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	СтруктураДанных = РезультатОбработкаРасшифровкиНаСервере(Расшифровка,ДанныеРасшифровки);  
	Если СтруктураДанных <> Неопределено Тогда
		ОткрытьФорму("Отчет.АнализПотребностей.Форма.ФормаРасшифровки", 
		СтруктураДанных, 
		ЭтотОбъект, 
		Истина,,, 
		, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура РезультатОбработкаДополнительнойРасшифровкиНаСервере()
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	РезультатОбработкаДополнительнойРасшифровкиНаСервере();
КонецПроцедуры

#КонецОбласти  
