	Возврат Документы.УведомлениеОСпецрежимахНалогообложения.ИдентификаторФайлаЭлектронногоПредставления(Префикс, СведенияОтправки);
КонецФункции

Процедура ПроверитьТитульная(Данные, ТаблицаОшибок)
	Титульная = Данные.ДанныеУведомления.Титульная;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(Титульная.КодНО, ТаблицаОшибок, "Титульная");
	Если Титульная.Свойство("Наименование") И Не ЗначениеЗаполнено(Титульная.Наименование) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано наименование организации", "Титульная", "Наименование"));
	ИначеЕсли Титульная.Свойство("НаимОрг") И Не ЗначениеЗаполнено(Титульная.НаимОрг) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано наименование организации", "Титульная", "НаимОрг"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.ДАТА_ПОДПИСИ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата формирования документа", "Титульная", "ДАТА_ПОДПИСИ"));
	КонецЕсли;
	
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаИННКПП(Истина, Титульная, ТаблицаОшибок);
	Если Не ЗначениеЗаполнено(Титульная.ПРИЗНАК_НП_ПОДВАЛ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак подписанта", "Титульная", "ПРИЗНАК_НП_ПОДВАЛ"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаПодписантаНалоговойОтчетности(Данные, ТаблицаОшибок, "Титульная", Истина);
	Если Не ЗначениеЗаполнено(Титульная.Долж) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана должность подписанта", "Титульная", "Долж"));
	КонецЕсли;
	
	Если Титульная.ПРИЗНАК_НП_ПОДВАЛ = "2" И Не ЗначениеЗаполнено(Титульная.НаимДок) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан документ подписанта", "Титульная", "НаимДок"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаГода(Титульная, ТаблицаОшибок, "Титульная", "ГодНМ", Истина);
КонецПроцедуры

Процедура ПроверитьЗапрМненНО_2024_1(Данные, ТаблицаОшибок)
	ЗапрМненНО = Данные.ДанныеУведомления.ЗапрМненНО;
	Если Не ЗначениеЗаполнено(ЗапрМненНО.НомЗапрос) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан номер запроса", "ЗапрМненНО", "НомЗапрос"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗапрМненНО.ПризЗапр) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак запроса", "ЗапрМненНО", "ПризЗапр"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗапрМненНО.ОКВЭД) 
		Или Не УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаОКВЭДНаКорректность(ЗапрМненНО.ОКВЭД) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан / неправильно указан код ОКВЭД", "ЗапрМненНО", "ОКВЭД"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗапрМненНО.ВидСдел) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан вид сделки", "ЗапрМненНО", "ВидСдел"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗапрМненНО.ОписВопрос) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан описание вопроса", "ЗапрМненНО", "ОписВопрос"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗапрМненНО.ПозицияОрг) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана позиция организации", "ЗапрМненНО", "ПозицияОрг"));
	КонецЕсли;
	
	ЕстьПриз123 = Ложь;
	ЕстьПриз4 = Ложь;
	Для Каждого Стр Из Данные.ДанныеДопСтрокБД.МнгСтр1 Цикл 
		Если Не ЗначениеЗаполнено(Стр.ПризВопрос) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан признак вопроса", "ЗапрМненНО", "ПризВопрос___" + (Данные.ДанныеДопСтрокБД.МнгСтр1.Индекс(Стр) + 1)));
		КонецЕсли;
		ЕстьПриз4 = ЕстьПриз4 Или Стр.ПризВопрос = "4";
		ЕстьПриз123 = ЕстьПриз123 Или Стр.ПризВопрос = "1" Или Стр.ПризВопрос = "2" Или Стр.ПризВопрос = "3";
	КонецЦикла;
	
	Если ЕстьПриз123 Тогда 
		Для Каждого Стр Из Данные.ДанныеДопСтрокБД.МнгСтр2 Цикл 
			Если Не ЗначениеЗаполнено(Стр.КодНалог) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан код налога (для кодов 1,2,3)", "ЗапрМненНО", "КодНалог___" + (Данные.ДанныеДопСтрокБД.МнгСтр2.Индекс(Стр) + 1)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЕстьПриз4 Тогда 
		Для Каждого Стр Из Данные.ДанныеДопСтрокБД.МнгСтр2 Цикл 
			Если ЗначениеЗаполнено(Стр.КодНалог) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"При признаке 4 код налога не указывается", "ЗапрМненНО", "КодНалог___" + (Данные.ДанныеДопСтрокБД.МнгСтр2.Индекс(Стр) + 1)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОписСдел_2024(Данные, ТаблицаОшибок)
	Для Каждого Элт Из Данные.ДанныеМногостраничныхРазделов.ОписСдел Цикл 
		ОписСдел = Элт.Значение;
		
		Если Не ЗначениеЗаполнено(ОписСдел.ДелЦель) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указана деловая цель", "ОписСдел", "ДелЦель", ОписСдел.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОписСдел.ОснУсл) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указаны основные условия", "ОписСдел", "ОснУсл", ОписСдел.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОписСдел.ПравОбяз) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указаны права и обязанности сторон", "ОписСдел", "ПравОбяз", ОписСдел.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОписСдел.СрокИсп) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указаны сроки", "ОписСдел", "СрокИсп", ОписСдел.УИД));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьИнфКонтр(Данные, ТаблицаОшибок)
	Для Каждого Элт Из Данные.ДанныеМногостраничныхРазделов.ИнфКонтр Цикл 
		ИнфКонтр = Элт.Значение;
		Если Не УведомлениеОСпецрежимахНалогообложенияКлиентСервер.СтраницаЗаполнена(ИнфКонтр) Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИнфКонтр.ПризнКонтр) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан признак контрагента", "ИнфКонтр", "ПризнКонтр", ИнфКонтр.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИнфКонтр.ХарВзаим) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан характер взаимоотношений", "ИнфКонтр", "ХарВзаим", ИнфКонтр.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИнфКонтр.ПризВзаим) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан признак взаимозависимости", "ИнфКонтр", "ПризВзаим", ИнфКонтр.УИД));
		КонецЕсли;
		
		Если ИнфКонтр.ПризнКонтр = "1" Тогда 
			Если Не ЗначениеЗаполнено(ИнфКонтр.РО_Контр) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указано наименование", "ИнфКонтр", "РО_Контр", ИнфКонтр.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИнфКонтр.РО_ОКВЭД) 
				Или Не УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаОКВЭДНаКорректность(ИнфКонтр.РО_ОКВЭД) = 1 Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан / неправильно указан ОКВЭД", "ИнфКонтр", "РО_ОКВЭД", ИнфКонтр.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИнфКонтр.РО_АдрМНТекст) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан адрес", "ИнфКонтр", "РО_АдрМНТекст", ИнфКонтр.УИД));
			КонецЕсли;
			
			УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаИНН(ИнфКонтр, ТаблицаОшибок, "ИнфКонтр", "РО_ИННЮЛ", Истина, Истина);
			УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКПП(ИнфКонтр, ТаблицаОшибок, "ИнфКонтр", "РО_КПП", Истина);
		ИначеЕсли ИнфКонтр.ПризнКонтр = "2" Тогда 
			Если Не ЗначениеЗаполнено(ИнфКонтр.ИО_НаимИнУчЛат) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указано наименование", "ИнфКонтр", "ИО_НаимИнУчЛат", ИнфКонтр.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИнфКонтр.ИО_РегНом) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан регистрационный номер", "ИнфКонтр", "ИО_РегНом", ИнфКонтр.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИнфКонтр.ИО_АдрРегТекстЛат) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан адрес", "ИнфКонтр", "ИО_АдрРегТекстЛат", ИнфКонтр.УИД));
			КонецЕсли;
			Если СтрДлина(ИнфКонтр.ИО_КодРег) <> 3 Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан / неправильно указан код страны регистрации", "ИнфКонтр", "ИО_КодРег", ИнфКонтр.УИД));
			КонецЕсли;
		ИначеЕсли ИнфКонтр.ПризнКонтр = "3" Тогда 
			Если Не ЗначениеЗаполнено(ИнфКонтр.ФЛ_ДатаРожд) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указана дата рождения", "ИнфКонтр", "ФЛ_ДатаРожд", ИнфКонтр.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИнфКонтр.ФЛ_Фамилия) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указана фамилия", "ИнфКонтр", "ФЛ_Фамилия", ИнфКонтр.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИнфКонтр.ФЛ_Имя) Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указано имя", "ИнфКонтр", "ФЛ_Имя", ИнфКонтр.УИД));
			КонецЕсли;
			УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаИНН(ИнфКонтр, ТаблицаОшибок, "ИнфКонтр", "ФЛ_ИННФЛ", Ложь, Ложь);
			Если ЗначениеЗаполнено(ИнфКонтр.ФЛ_КодРег)
				И СтрДлина(ИнфКонтр.ФЛ_КодРег) <> 3 Тогда 
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Неправильно указан код страны регистрации", "ИнфКонтр", "ФЛ_КодРег", ИнфКонтр.УИД));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПроверитьДокументСВыводомВТаблицу_Форма2024_1(Данные, УникальныйИдентификатор)
	ТаблицаОшибок = Новый СписокЗначений;
	УведомлениеОСпецрежимахНалогообложения.ПроверкаАктуальностиФормыПриВыгрузке(
		Данные.Объект.ИмяФормы, ТаблицаОшибок, ПолучитьТаблицуФорм());
	
	ПроверитьТитульная(Данные, ТаблицаОшибок);
	ПроверитьЗапрМненНО_2024_1(Данные, ТаблицаОшибок);
	ПроверитьОписСдел_2024(Данные, ТаблицаОшибок);
	ПроверитьИнфКонтр(Данные, ТаблицаОшибок);
	
	УведомлениеОСпецрежимахНалогообложения.ПроверкаДатВУведомлении(Данные, ТаблицаОшибок);
	УведомлениеОСпецрежимахНалогообложения.ПолнаяПроверкаЗаполненныхПоказателейНаСоотвествиеСписку("СпискиВыбора2024_1",
		"СхемаВыгрузкиФорма2024_1", Данные.Объект.ИмяОтчета, ТаблицаОшибок, Данные);
		
	Для Каждого Стр Из Данные.ПриложенныеФайлы.Строки Цикл 
		Если Стр.Строки.Количество() = 0 Тогда
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"К каждому документу необходимо приложить файлы", "ПриложенныеФайлы", ""));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ТаблицаОшибок;
КонецФункции

Функция ОсновныеСведенияЭлектронногоПредставления_Форма2024_1(Объект, УникальныйИдентификатор)
	ОсновныеСведения = Документы.УведомлениеОСпецрежимахНалогообложения.НачальнаяИнициализацияОбщихРеквизитовВыгрузки(Объект);
	ОсновныеСведения.Вставить("КолФайл", 0);
	Данные = Объект.ДанныеУведомления.Получить();
	ИдентификаторФайла = ИдентификаторФайлаЭлектронногоПредставления(ОсновныеСведения);
	ОсновныеСведения.Вставить("ИдФайл", ИдентификаторФайла);
	Для Каждого Стр1 Из Данные.ПриложенныеФайлы.Строки Цикл 
		ОсновныеСведения.КолФайл = ОсновныеСведения.КолФайл + Стр1.Строки.Количество();
	КонецЦикла;
	
	Возврат ОсновныеСведения;
КонецФункции

Функция ЭлектронноеПредставление_Форма2024_1(Объект, УникальныйИдентификатор)
	СписокФайлов = Новый СписокЗначений;
	ИменаФайлов = Новый СписокЗначений;
	
	СведенияЭлектронногоПредставления = УведомлениеОСпецрежимахНалогообложения.СведенияЭлектронногоПредставления();
	ДанныеУведомления = УведомлениеОСпецрежимахНалогообложения.ДанныеУведомленияДляВыгрузки(Объект);
	Ошибки = ПроверитьДокументСВыводомВТаблицу_Форма2024_1(ДанныеУведомления, УникальныйИдентификатор);
	УведомлениеОСпецрежимахНалогообложения.СообщитьОшибкиПриПроверкеВыгрузки(Объект, Ошибки, ДанныеУведомления);
	
	ОсновныеСведения = ОсновныеСведенияЭлектронногоПредставления_Форма2024_1(Объект, УникальныйИдентификатор);
	СтруктураВыгрузки = Документы.УведомлениеОСпецрежимахНалогообложения.ИзвлечьСтруктуруXMLУведомления(Объект.ИмяОтчета, "СхемаВыгрузкиФорма2024_1");
	ЗаполнитьДанными_Форма2024_1(Объект, ОсновныеСведения, СтруктураВыгрузки, СписокФайлов, ИменаФайлов);
	УведомлениеОСпецрежимахНалогообложения.ВыгрузитьДеревоВТаблицу(СтруктураВыгрузки, ОсновныеСведения, СведенияЭлектронногоПредставления);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		Для Инд = 0 По СписокФайлов.Количество() - 1 Цикл 
			Файл = СписокФайлов[Инд];
			ИмяФайлаПрод = ИменаФайлов[Инд];
			СтрокаСведенийЭлектронногоПредставления = СведенияЭлектронногоПредставления.Добавить();
			СтрокаСведенийЭлектронногоПредставления.ИмяФайла = ИмяФайлаПрод;
			СтрокаСведенийЭлектронногоПредставления.ДвоичныеДанныеФайла = МодульРаботаСФайлами.ДвоичныеДанныеФайла(Файл.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СведенияЭлектронногоПредставления;
КонецФункции

Процедура ЗаполнитьДанными_Форма2024_1(Объект, Параметры, ДеревоВыгрузки, СписокФайлов, ИменаФайлов)
	Документы.УведомлениеОСпецрежимахНалогообложения.ОбработатьУсловныеЭлементы(Параметры, ДеревоВыгрузки);
	Документы.УведомлениеОСпецрежимахНалогообложения.ЗаполнитьПараметрыСРазделами(Параметры, ДеревоВыгрузки);
	ДанныеУведомления = Объект.ДанныеУведомления.Получить();
	УведомлениеОСпецрежимахНалогообложения.ЗаполнитьДаннымиУзелНов(ДанныеУведомления, ДеревоВыгрузки);
	
	ДатаИмФайла = Формат(ТекущаяДатаСеанса(), "ДФ=_yyyyMMdd_");
	Узел_Документ = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(ДеревоВыгрузки, "Документ");
	Узел_ЗапрМненНО = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(Узел_Документ, "ЗапрМненНО");
	Узел_ДокСкан = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(Узел_ЗапрМненНО, "ДокСкан");
	Узел_ДокФорм = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(Узел_ЗапрМненНО, "ДокФорм");
	Для Каждого Стр0 Из ДанныеУведомления.ПриложенныеФайлы.Строки Цикл
		Если Стр0.ЭтоСкан Тогда 
			УИД1 = Строка(Новый УникальныйИдентификатор);
			НовУзел_ДокСкан = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ДокСкан);
			Документы.УведомлениеОСпецрежимахНалогообложения.УстановитьЗначениеЭлемента(НовУзел_ДокСкан, "НаимДок", Стр0.Документ);
			
			Узел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(НовУзел_ДокСкан, "ИмяФайл");
			Для Каждого Стр1 Из Стр0.Строки Цикл
				УИД2 = Строка(Новый УникальныйИдентификатор);
				НовУзел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ИмяФайл);
				ИмяФайлаПрод = "1110305_" + Параметры.ИННЮЛ + Параметры.КПП + "_"  + Параметры.КодНО 
								+ "_" + УИД1 + ДатаИмФайла + УИД2 + "." + Стр1.Расширение;
				РегламентированнаяОтчетность.ВывестиПоказательСтатистикиВXML(НовУзел_ИмяФайл, ИмяФайлаПрод);
				ИменаФайлов.Добавить(ИмяФайлаПрод);
				СписокФайлов.Добавить(Стр1.ПрисоединенныйФайл);
			КонецЦикла;
			РегламентированнаяОтчетность.УдалитьУзел(Узел_ИмяФайл);
		Иначе
			НовУзел_ДокФорм = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ДокФорм);
			Документы.УведомлениеОСпецрежимахНалогообложения.УстановитьЗначениеЭлемента(НовУзел_ДокФорм, "НаимДок", Стр0.Документ);
			Документы.УведомлениеОСпецрежимахНалогообложения.УстановитьЗначениеЭлемента(НовУзел_ДокФорм, "КНДДок", Стр0.КНД);
			
			Узел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(НовУзел_ДокФорм, "ИмяФайл");
			Для Каждого Стр1 Из Стр0.Строки Цикл
				УИД2 = Строка(Новый УникальныйИдентификатор);
				НовУзел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ИмяФайл);
				РегламентированнаяОтчетность.ВывестиПоказательСтатистикиВXML(НовУзел_ИмяФайл, Стр1.Документ);
				ИменаФайлов.Добавить(Стр1.Документ);
				СписокФайлов.Добавить(Стр1.ПрисоединенныйФайл);
			КонецЦикла;
			РегламентированнаяОтчетность.УдалитьУзел(Узел_ИмяФайл);
		КонецЕсли;
	КонецЦикла;
	РегламентированнаяОтчетность.УдалитьУзел(Узел_ДокСкан);
	РегламентированнаяОтчетность.УдалитьУзел(Узел_ДокФорм);
	
	Документы.УведомлениеОСпецрежимахНалогообложения.ОтсечьНезаполненныеНеобязательныеУзлы(ДеревоВыгрузки);
КонецПроцедуры

Функция СформироватьСписокЛистовФормаФорма2021(Объект) Экспорт
	СписокИспользуемыхМакетов = УведомлениеОСпецрежимахНалогообложения.ЗагрузитьМакетыИзАрхива(Объект, , "ТабличныеДокументы");
	Листы = Новый СписокЗначений;
	СохраненныеДанные = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеУведомления").Получить();
	
	ПечатнаяФорма = УведомлениеОСпецрежимахНалогообложения.НовыйПустойЛист();
	ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "Титульная_2021"));
	УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, СохраненныеДанные.ДанныеУведомления.Титульная);
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 1);
	
	ЗапрМненНО = УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, 
					?(Объект.ИмяФормы = "Форма2021_1", "ЗапрМненНО_2021", "ЗапрМненНО_2021_2"));
	ПечатнаяФорма.Вывести(ЗапрМненНО.ПолучитьОбласть("ОсновнаяЧасть"));
	УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, СохраненныеДанные.ДанныеУведомления.ЗапрМненНО);
	
	Для Инд = 1 По 2 Цикл 
		Если Не СохраненныеДанные.ДанныеДопСтрокБД.Свойство("МнгСтр" + Инд) Тогда 
			Продолжить;
		КонецЕсли;
		
		ПечатнаяФорма.Вывести(ЗапрМненНО.ПолучитьОбласть("Header_МнгСтр" + Инд));
		Для Каждого Стр Из СохраненныеДанные.ДанныеДопСтрокБД["МнгСтр" + Инд] Цикл 
			ТабДокСтр = ЗапрМненНО.ПолучитьОбласть("Str_МнгСтр" + Инд);
			УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(
				ТабДокСтр, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Стр));
			ПечатнаяФорма.Вывести(ТабДокСтр);
		КонецЦикла;
	КонецЦикла;
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 2);
	
	НомСтр = 2;
	Для Каждого Стр1 Из СохраненныеДанные.ДанныеМногостраничныхРазделов.ОписСдел Цикл 
		НомСтр = НомСтр + 1;
		ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "ОписСдел_2021"));
		УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, Стр1.Значение);
		УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, НомСтр);
		
		Для Каждого Стр2 Из СохраненныеДанные.ДанныеМногостраничныхРазделов.ИнфКонтр Цикл 
			Если Стр1.Значение.УИД <> Стр2.Значение.УИДРодителя Тогда 
				Продолжить;
			КонецЕсли;
			
			НомСтр = НомСтр + 1;
			ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "ИнфКонтр_2021"));
			ОписаниеТиповЧисло18_15 = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 15));
			ПечатнаяФорма.Области["ДоляПрямУч"].ТипЗначения = ОписаниеТиповЧисло18_15;
			ПечатнаяФорма.Области["ДоляКосвУч"].ТипЗначения = ОписаниеТиповЧисло18_15;
			УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, Стр2.Значение);
			УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, НомСтр);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Листы;
КонецФункции

#КонецОбласти
#КонецЕсли
