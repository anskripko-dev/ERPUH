&НаКлиенте
Процедура ДоступностьПолейФЛИОРО()
	Область = ПредставлениеУведомления.Области.Найти("ПризнКонтр");
	Если Область = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	_Модифицированность = Модифицированность;
	ЭтоРО = (Область.Значение = "1");
	ЭтоИО = (Область.Значение = "2");
	ЭтоФЛ = (Область.Значение = "3");
	
	Для Каждого Обл Из ПредставлениеУведомления.Области Цикл 
		Если СтрНачинаетсяС(Обл.Имя, "РО_") Тогда 
			Обл.Защита = Не ЭтоРО;
			Обл.ЦветФона = ?(ЭтоРО, ЭтотОбъект["ЦФЖ"], ЭтотОбъект["ЦФБ"]);
			Если Не ЭтоРО Тогда 
				Обл.Значение = Неопределено;
				УведомлениеОСпецрежимахНалогообложенияКлиент.ПриИзмененииСодержимогоОбласти(ЭтотОбъект, Обл, Истина);
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Обл.Имя, "ИО_") Тогда 
			Обл.Защита = Не ЭтоИО;
			Обл.ЦветФона = ?(ЭтоИО, ЭтотОбъект["ЦФЖ"], ЭтотОбъект["ЦФБ"]);
			Если Не ЭтоИО Тогда 
				Обл.Значение = Неопределено;
				УведомлениеОСпецрежимахНалогообложенияКлиент.ПриИзмененииСодержимогоОбласти(ЭтотОбъект, Обл, Истина);
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Обл.Имя, "ФЛ_") Тогда 
			Обл.Защита = Не ЭтоФЛ;
			Обл.ЦветФона = ?(ЭтоФЛ, ЭтотОбъект["ЦФЖ"], ЭтотОбъект["ЦФБ"]);
			Если Не ЭтоФЛ Тогда 
				Обл.Значение = Неопределено;
				УведомлениеОСпецрежимахНалогообложенияКлиент.ПриИзмененииСодержимогоОбласти(ЭтотОбъект, Обл, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Модифицированность = _Модифицированность;
КонецПроцедуры

