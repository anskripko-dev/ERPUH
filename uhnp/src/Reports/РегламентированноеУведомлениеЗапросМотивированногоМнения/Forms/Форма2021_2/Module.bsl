&НаКлиенте
Асинх Процедура ПриложенныеФайлыВыборАсинх(Элемент, ВыбраннаяСтрока, Поле)
	ТекущиеДанные = ПриложенныеФайлы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если УведомлениеОСпецрежимахНалогообложенияКлиент.УровеньГруппировкиВДереве(ТекущиеДанные) = 0 Тогда
		Если Не ТекущиеДанные.ЭтоСкан И Поле.Имя = "ПриложенныеФайлыКНД" Тогда 
			КНДДокумента = Ждать ВвестиСтрокуАсинх(ТекущиеДанные.КНД, "Введите КНД документа", 7);
			Если Не ЗначениеЗаполнено(КНДДокумента) Тогда 
				Возврат;
			ИначеЕсли СтрДлина(КНДДокумента) <> 7 Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(КНДДокумента) Тогда 
				ОбщегоНазначенияКлиент.СообщитьПользователю("Неправильно указан КНД");
				Возврат;
			КонецЕсли;
			
			ТекущиеДанные.КНД = КНДДокумента;
			Модифицированность = Истина;
		ИначеЕсли Поле.Имя = "ПриложенныеФайлыДокумент" Тогда 
			НазваниеДокумента = Ждать ВвестиСтрокуАсинх(ТекущиеДанные.Документ, "Введите наименование, реквизиты и прочие признаки документа");
			Если Не ЗначениеЗаполнено(НазваниеДокумента) Тогда 
				Возврат;
			КонецЕсли;
			ТекущиеДанные.Документ = НазваниеДокумента;
			Модифицированность = Истина;
		КонецЕсли;
	Иначе
		РаботаСФайламиКлиент.ОткрытьФайл(УведомлениеОСпецрежимахНалогообложенияВызовСервера.ДанныеФайла(ТекущиеДанные.ПрисоединенныйФайл), Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
