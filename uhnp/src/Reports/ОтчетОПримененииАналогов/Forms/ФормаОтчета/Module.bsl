
&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Перем ВыполненноеДействие;
	
	СтандартнаяОбработка=Ложь;
	
	СтрокаРасшифровки = ПолучитьДанныеРасшифровки(ДанныеРасшифровки, Расшифровка);
	Если СтрокаРасшифровки.Поля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеДействия = Новый СписокЗначений;
	
	Если СтрокаРасшифровки.Поля.Свойство("АналогНоменклатура") Тогда
		
		Если ЗначениеЗаполнено(СтрокаРасшифровки.Поля.АналогНоменклатура) Тогда
			// Аналог есть
			
		Иначе
			// Аналога нет
			
		КонецЕсли;
		
		//
		ДополнительныеДействия.Добавить("УстановитьАналог", НСтр("ru = 'Установить аналог'"));
		ДополнительныеДействия.Добавить("ОчиститьАналог", НСтр("ru = 'Сбросить аналог'"));
		
		ДоступныеДействия = Новый Массив;
		//ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
		
	Иначе
		
		//ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать);
		//ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Расшифровать);
		ДоступныеДействия = неопределено;
		
	КонецЕсли;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(
		ДанныеРасшифровки, 
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	//
	ВыполненноеДействие = неопределено;
	ПараметрыВыбранногоДействия = неопределено;
	
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	ДополнительныеПараметры = Новый Структура("Расшифровка", Расшифровка);
	ДополнительныеПараметры.Вставить("СтрокаРасшифровки",СтрокаРасшифровки);
	ОписаниеОповещения = Новый ОписаниеОповещения("РезультатОбработкаДополнительнойРасшифровкиПродолжение", ЭтаФорма, ДополнительныеПараметры);
	ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещения,Расшифровка, ДоступныеДействия,ДополнительныеДействия);
		
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровкиПродолжение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ВыполненноеДействие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		Значение = ПараметрВыполненногоДействия;
		ПараметрыФормы = Новый Структура("Ключ", Значение);
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Организации") Тогда
			ОткрытьФорму("Справочник.Организации.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.МестаПоставки") Тогда
			ОткрытьФорму("Справочник.МестаПоставки.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ОткрытьФорму("Справочник.ФизическиеЛица.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ПриоритетыПотребностей") Тогда
			ОткрытьФорму("Справочник.ПриоритетыПотребностей.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Проекты") Тогда
			ОткрытьФорму("Справочник.Проекты.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Номенклатура") Тогда
			ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьАналог(СтрокаРасшифровки)
	
	нз = РегистрыСведений.АналогиНоменклатуры.СоздатьНаборЗаписей();
	нз.Отбор.Автор.Установить(СтрокаРасшифровки.Поля.Автор);
	нз.Отбор.ПериодЗакупки.Установить(СтрокаРасшифровки.Поля.ПериодЗакупки);
	нз.Отбор.Номенклатура.Установить(СтрокаРасшифровки.Поля.Номенклатура);
	нз.Отбор.ЕдиницаИзмерения.Установить(СтрокаРасшифровки.Поля.ЕдиницаИзмерения);
	Если СтрокаРасшифровки.Поля.Свойство("Характеристика") Тогда
		нз.Отбор.Характеристика.Установить(СтрокаРасшифровки.Поля.Характеристика);
	Иначе
		нз.Отбор.Характеристика.Установить(Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	КонецЕсли;
	нз.Прочитать();
	нз.Очистить();
	нз.Записать(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьАналог(СтрокаРасшифровки)
	
	ДопПараметры = Новый Структура("СтрокаРасшифровки", СтрокаРасшифровки);
	
	Завершение = Новый ОписаниеОповещения("ВыборАналогаЗавершение", ЭтаФорма, ДопПараметры);
	
	ОткрытьФорму("РегистрСведений.НастройкаЗаменыНоменклатуры.Форма.ФормаВыбораАналога", ДопПараметры, ,,,,Завершение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборАналогаЗавершение(Результат, ДополнительныеПараметры) экспорт
	
	Если Результат =  неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьВыборАналогаНаСервере(Результат, ДополнительныеПараметры);
	
	СкомпоноватьРезультат(РежимКомпоновкиРезультата.Авто);
	
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ЗаписатьВыборАналогаНаСервере(Результат, ДопПараметры)
	
	Поля = ДопПараметры.СтрокаРасшифровки.Поля;
	
	//
	мз = РегистрыСведений.НастройкаЗаменыНоменклатуры.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(мз, Результат);
	мз.Прочитать();
	
	//
	нз = РегистрыСведений.АналогиНоменклатуры.СоздатьНаборЗаписей();
	нз.Отбор.Автор.Установить(Поля.Автор);
	нз.Отбор.ПериодЗакупки.Установить(Поля.ПериодЗакупки);
	нз.Отбор.Номенклатура.Установить(Поля.Номенклатура);
	нз.Отбор.ЕдиницаИзмерения.Установить(Поля.ЕдиницаИзмерения);
	Если Поля.Свойство("Характеристика") Тогда
		нз.Отбор.Характеристика.Установить(Поля.Характеристика);
	Иначе
		нз.Отбор.Характеристика.Установить(Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	КонецЕсли;
	нз.Прочитать();
	нз.Очистить();
	Строка = нз.Добавить();
	Строка.Автор = Поля.Автор;
	Строка.ПериодЗакупки = Поля.ПериодЗакупки;
	Строка.Номенклатура = Поля.Номенклатура;
	Если Поля.Свойство("Характеристика") Тогда
		Строка.Характеристика = Поля.Характеристика;
	Иначе
		Строка.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Строка.ЕдиницаИзмерения = Поля.ЕдиницаИзмерения;
	Строка.АналогНоменклатура = Результат.НоменклатураПриемник;
	Строка.АналогХарактеристика = Результат.ХарактеристикаПриемник;
	Строка.АналогЕдиницаИзмерения = Результат.ЕдиницаИзмеренияПриемник;
	Строка.Коэффициент = мз.Коэффициент;
	
	нз.Записать(Истина);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеРасшифровки(ДанныеРасшифровки, Расшифровка)
	
	ДанныеРасшифровкиКомпоновки = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	СтрокаДляРасшифровки = ДанныеРасшифровкиКомпоновки.Элементы[Расшифровка];
	
	Рез = Новый Структура;
	Рез.Вставить("Идентификатор", СтрокаДляРасшифровки.Идентификатор);
	Рез.Вставить("ОсновноеДействие", СтрокаДляРасшифровки.ОсновноеДействие);
	Рез.Вставить("Родители", Новый Массив);
	Рез.Вставить("Поля", Новый Структура);
	
	//
	Для Каждого Родитель Из СтрокаДляРасшифровки.ПолучитьРодителей() Цикл
		Инфо = Новый Структура("Идентификатор, ОсновноеДействие");
		ЗаполнитьЗначенияСвойств(Инфо, Родитель);
		Рез.Родители.Добавить(Инфо);
	КонецЦикла;
	
	Если Рез.Родители.Количество() > 0 Тогда
		
		СтрокаДляРасшифровки = ДанныеРасшифровкиКомпоновки.Элементы[Рез.Родители[0].Идентификатор];
		
		//
		Для Каждого Поле Из СтрокаДляРасшифровки.ПолучитьПоля() Цикл
			Рез.Поля.Вставить(Поле.Поле, Поле.Значение);
		КонецЦикла;
		
		Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
		
		Параметр = Настройки.ПараметрыДанных.Элементы.Найти("ПериодЗакупки");
		Если Параметр <> неопределено Тогда
			Рез.Поля.Вставить("ПериодЗакупки", Параметр.Значение);
		КонецЕсли;
		
		Параметр = Настройки.ПараметрыДанных.Элементы.Найти("Автор");
		Если Параметр <> неопределено Тогда
			Рез.Поля.Вставить("Автор", Параметр.Значение);
		КонецЕсли;
		
		
	Иначе
		
		//
		Для Каждого Поле Из СтрокаДляРасшифровки.ПолучитьПоля() Цикл
			Рез.Поля.Вставить(Поле.Поле, Поле.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	// Не будем обрабатывать нажатие на правую кнопку мыши.
	// Покажем стандартное контекстное меню ячейки табличного документа.
	Расшифровка = Неопределено;
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтчетОбъект = ЭтаФорма.РеквизитФормыВЗначение("Отчет");
	Если Не ЗначениеЗаполнено(ЭтаФорма.СхемаКомпоновкиДанных) Тогда
		ЭтаФорма.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(ОтчетОбъект.СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

