// Функция возвращает кол-во позиций потребностей готовые к унификации
Функция ПолучитьКолвоПозицийДляЗаменыНаАналоги(Автор, ПериодЗакупки, Отборы) экспорт
	             
	
	//Получаем схему из макета
	СхемаКомпоновкиДанных = Отчеты.ОтчетОПримененииАналогов.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	//
	ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("Основной");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();    
	
	ПеренестиПоляВыбораНаВерхнийУровень(Настройки, Настройки.Выбор.Элементы, неопределено);     
	
	Если ТипЗнч(ПериодЗакупки) = Тип("Структура") Тогда
		ПараметрыПериода = ПериодЗакупки;
	Иначе
		ПараметрыПериода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПериодЗакупки, "ДатаНачала, ДатаОкончания");     
		ПараметрыПериода.Вставить("ПериодЗакупок", ПериодЗакупки); 
	КонецЕсли;
	
	// Параметры вывода
	Параметр = Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("РасположениеИтогов"));
	Параметр.Значение = РасположениеИтоговКомпоновкиДанных.Нет;
	Параметр.Использование = Истина;
	
	// Параметры данных       
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Автор"));  
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Автор; 
		Параметр.Использование = Истина;	
	КонецЕсли; 
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ИспользуетсяЦенообразование25"));  
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Константы.ИспользуетсяЦенообразование25.Получить(); 
		Параметр.Использование = Истина;	
	КонецЕсли;     
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("БезУчетаТоварныхКатегорий")); 
	Если Параметр <> Неопределено Тогда                     
		Параметр.Значение = Не ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Константа.РазделятьНоменклатуруПоКатегорийнымМенеджерам").Получить();
		Параметр.Использование = Истина;
	КонецЕсли;

	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаНачала"));  
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ДатаНачала; 
		Параметр.Использование = Истина;	
	КонецЕсли;
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаОкончания")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ДатаОкончания;
		Параметр.Использование = Истина;
	КонецЕсли;   
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодЗакупки")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ПериодЗакупок;
		Параметр.Использование = Истина;
	КонецЕсли;   
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("СтандартныйПериод")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение.ДатаНачала 	= ПараметрыПериода.ДатаНачала;
		Параметр.Значение.ДатаОкончания = ПараметрыПериода.ДатаОкончания;
		Параметр.Значение.Вариант 		= ВариантСтандартногоПериода.ПроизвольныйПериод;
		Параметр.Использование = Истина;
	КонецЕсли;  
	
	Для Каждого КлючИЗнчение Из Отборы Цикл
		Если СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Найти(КлючИЗнчение.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолеОтбораСубъекты = Новый ПолеКомпоновкиДанных(КлючИЗнчение.Ключ);
		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение = ПолеОтбораСубъекты;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных[КлючИЗнчение.Значение.ВидСравнения];
		ЭлементОтбора.Использование = Истина;     
		Если ЗначениеЗаполнено(КлючИЗнчение.Значение.Значение) Тогда
			ЭлементОтбора.ПравоеЗначение = КлючИЗнчение.Значение.Значение;
		КонецЕсли;
	КонецЦикла;                             
		
	//Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	//Выводим результат в табличный документ
	Таблица = Новый ТаблицаЗначений;
	ПроцессорВыводаВТЗ = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаВТЗ.УстановитьОбъект(Таблица);
	
	ПроцессорВыводаВТЗ.Вывести(ПроцессорКомпоновкиДанных);   
	
	Счетчик = 0;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл 
		Если ЗначениеЗаполнено(СтрокаТаблицы.АналогНоменклатура) Тогда
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции  


Процедура ПеренестиПоляВыбораНаВерхнийУровень(Настройки, ВыборЭлементы, Родитель)
	
	//
	Для Каждого ЭлементВыбора Из ВыборЭлементы Цикл
		Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			ПеренестиПоляВыбораНаВерхнийУровень(Настройки, ЭлементВыбора.Элементы, ЭлементВыбора);
		ИначеЕсли ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных") И Родитель <> неопределено Тогда
			Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(Поле, ЭлементВыбора,,"Родитель")
		КонецЕсли;
	КонецЦикла;
	
	
	Если Родитель = неопределено Тогда
		
		Поз = 0;
		Пока Поз < ВыборЭлементы.Количество() Цикл
			ЭлементВыбора = ВыборЭлементы[Поз];
			Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда 
				
				ВыборЭлементы.Удалить(ЭлементВыбора);
				
			Иначе
				Поз = Поз + 1;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры


Процедура ЗаполнитьПриемникДанныхПараметрами(ПараметрыОтчета, ПриемникДанных) Экспорт
	
	//Получаем схему из макета
	СхемаКомпоновкиДанных = Отчеты.ОтчетОПримененииАналогов.ПолучитьМакет("ПараметрыПотребностей");
	
	//
	ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("Основной");  
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();  
	
	//Отборы
	Настройки.Отбор.Элементы.Очистить();
	УстановитьОтборСКД(Настройки, ПараметрыОтчета, СхемаКомпоновкиДанных);
	
	ПеренестиПоляВыбораНаВерхнийУровень(Настройки, Настройки.Выбор.Элементы, неопределено);   
	УстановитьОбязательныеПоляПотребностей(Настройки.Выбор);
	
	// Параметры вывода
	Параметр = Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("РасположениеИтогов"));
	Параметр.Значение = РасположениеИтоговКомпоновкиДанных.Нет;
	Параметр.Использование = Истина;
	
	// Параметры данных   
	УстановитьПараметрыСКД(Настройки, ПараметрыОтчета);
	
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);
	
	//Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	//Выводим результат в табличный документ
	ПроцессорВыводаВТЗ = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаВТЗ.УстановитьОбъект(ПриемникДанных);
	
	ПроцессорВыводаВТЗ.Вывести(ПроцессорКомпоновкиДанных); 
		
КонецПроцедуры    



#КонецОбласти      

#Область СлужебныеПроцедурыИФункции  


Процедура УстановитьОбязательныеПоляПотребностей(Выбор)
	
	Обязательные = Новый Структура();
	Обязательные.Вставить("Валюта");
	
	
	Для Каждого КлючЗначение Из Обязательные Цикл
		
		Если НЕ ПолеВыбрано(Выбор.Элементы, Врег(КлючЗначение.Ключ)) Тогда
			НовоеПоле = Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(КлючЗначение.Ключ);
			НовоеПоле.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры    


Функция ПолеВыбрано(Элементы, ИмяПоля)
	
	Результат = Ложь;
	Для Каждого Элемент Из Элементы Цикл
	
		Если ТипЗнч(Элемент) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			Результат = ПолеВыбрано(Элемент.Элементы, ИмяПоля);
		Иначе
			Результат = ИмяПоля = ВРег(Строка(Элемент.Поле));
		КонецЕсли;
	
		Если Результат Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	Возврат Результат;
	
КонецФункции


Процедура УстановитьПараметрыСКД(Знач Настройки, Знач ПараметрыОтчета)
	
	Перем Параметр, ПараметрКлючИЗначение;
	
	Для Каждого ПараметрКлючИЗначение Из ПараметрыОтчета.Параметры Цикл       
		Если ПараметрКлючИЗначение.Ключ = "СтандартныйПериод" Или ПараметрКлючИЗначение.Значение = Тип("СтандартныйПериод") Тогда
			Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ПараметрКлючИЗначение.Ключ)); 
			Если Параметр <> Неопределено Тогда
				Параметр.Значение.ДатаНачала 	= ПараметрКлючИЗначение.Значение.ДатаНачала;
				Параметр.Значение.ДатаОкончания = ПараметрКлючИЗначение.Значение.ДатаОкончания;
				Параметр.Значение.Вариант 		= ВариантСтандартногоПериода.ПроизвольныйПериод;
				Параметр.Использование = Истина;
			КонецЕсли;
		Иначе
			Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ПараметрКлючИЗначение.Ключ));  
			Если Параметр <> Неопределено Тогда
				Параметр.Значение = ПараметрКлючИЗначение.Значение; 
				Параметр.Использование = Истина;            
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры 
 

// Процедура - Установить отбор СКД
//
// Параметры:
//  Настройки				 - 	НастройкиСхемыКомпоновкиДанных
//  ПараметрыРасчета		 - 	Структура	 - см. Отчеты.КонкурентныйЛист.ПараметрыОтчета 
//  СхемаКомпоновкиДанных	 - 	СхемаКомпоновкиДанных 
//
Процедура УстановитьОтборСКД(Знач Настройки, Знач ПараметрыРасчета, Знач СхемаКомпоновкиДанных)
	
	Перем КлючИЗнчение, ПолеОтбораСубъекты, ЭлементОтбора;
	
	Для Каждого КлючИЗнчение Из ПараметрыРасчета.Отбор Цикл
		ЕстьЭлемент = Ложь;
		Для Каждого НаборДанных Из СхемаКомпоновкиДанных.НаборыДанных Цикл 
			Если НаборДанных.Поля.Найти(КлючИЗнчение.Ключ) <> Неопределено Тогда
				ЕстьЭлемент = Истина;
			КонецЕсли;   
		КонецЦикла;      
		Если ЕстьЭлемент Тогда
			Если КлючИЗнчение.Ключ = "ПериодПотребности" Тогда
				Продолжить;
			КонецЕсли;
			ПолеОтбораСубъекты = Новый ПолеКомпоновкиДанных(КлючИЗнчение.Ключ);
			ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
			ЭлементОтбора.ЛевоеЗначение = ПолеОтбораСубъекты;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных[КлючИЗнчение.Значение.ВидСравнения];
			ЭлементОтбора.Использование = Истина;     
			Если ЗначениеЗаполнено(КлючИЗнчение.Значение.Значение) Тогда
				ЭлементОтбора.ПравоеЗначение = КлючИЗнчение.Значение.Значение;
			КонецЕсли;   
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


// Функция - Параметры 
//
// Параметры:
//  ЭлементыОтбора	 - Массив, СписокЗначений, Ссылка	 - Значения для ограничения пересчета критериев выбора по предложениям 
//  ИмяРеквизита	 - Строка	 - Реквизит для отбора 
// 
// Возвращаемое значение:
// Структура  - Структура параметров для использования в Отчеты.КонкурентныйЛист.ОбновитьРасчётныеЗначения()
//
Функция ПараметрыОтчета(ЭлементыОтбора, ИмяРеквизита = "Предложение") Экспорт   
	
	ПараметрыОтчета = Новый Структура("Отбор, Параметры", Новый Структура(), Новый Структура()); 
	
	ДобавитьОтборВПараметрыОтчета(ПараметрыОтчета, ИмяРеквизита, ЭлементыОтбора);
	
	Возврат ПараметрыОтчета;

КонецФункции

Процедура ДобавитьОтборВПараметрыОтчета(Знач ПараметрыОтчета, Знач ИмяРеквизита, Знач ЭлементыОтбора) Экспорт
	
	Перем ЭлементОтбора;    
	
	Если ПараметрыОтчета.Отбор.Свойство(ИмяРеквизита) = Неопределено Тогда
		ПараметрыОтчета.Отбор.Вставить(ИмяРеквизита, Новый Структура("ВидСравнения, Значение", ВидСравнения(ЭлементыОтбора), Новый СписокЗначений)); 
	КонецЕсли;
	
	Если ТипЗнч(ЭлементыОтбора) = Тип("СписокЗначений") Тогда 
		
		КоличествоЗначений = ЭлементыОтбора.Количество();
		Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл     
			
			СтруктураОтбора = ИнициализироватьОтборПоРеквизиту(ИмяРеквизита, КоличествоЗначений, ПараметрыОтчета, ЭлементыОтбора);
			УстановитьЗначениеОтбора(СтруктураОтбора, КоличествоЗначений, ЭлементОтбора.Значение);
			
		КонецЦикла; 
		
	ИначеЕсли ТипЗнч(ЭлементыОтбора) = Тип("Массив") Тогда 
		
		КоличествоЗначений = ЭлементыОтбора.Количество();
		Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл     
			
			СтруктураОтбора = ИнициализироватьОтборПоРеквизиту(ИмяРеквизита, КоличествоЗначений, ПараметрыОтчета, ЭлементыОтбора);
			УстановитьЗначениеОтбора(СтруктураОтбора, КоличествоЗначений, ЭлементОтбора);
			
		КонецЦикла; 
		
	Иначе               
		
		КоличествоЗначений = 1;	
		СтруктураОтбора = ИнициализироватьОтборПоРеквизиту(ИмяРеквизита, КоличествоЗначений, ПараметрыОтчета, ЭлементыОтбора);       
		УстановитьЗначениеОтбора(СтруктураОтбора, КоличествоЗначений, ЭлементыОтбора);    
		
	КонецЕсли;

КонецПроцедуры

Функция ИнициализироватьОтборПоРеквизиту(ИмяРеквизита, Знач КоличествоЗначений, Знач ПараметрыОтчета, Знач ЭлементыОтбора)
	
	Перем СтруктураОтбора;
	
	Если ПараметрыОтчета.Отбор.Свойство(ИмяРеквизита) = Ложь Тогда  
		СтруктураОтбора = ИнициализироватьОтбор(ПараметрыОтчета, ИмяРеквизита, КоличествоЗначений, ЭлементыОтбора); 
	Иначе
		СтруктураОтбора = ПараметрыОтчета.Отбор[ИмяРеквизита];
	КонецЕсли;
	Возврат СтруктураОтбора;

КонецФункции

Процедура УстановитьЗначениеОтбора(Знач СтруктураОтбора, Знач КоличествоЗначений, ЗначениеОтбора)
	
	Если КоличествоЗначений = 1 Тогда
		СтруктураОтбора.Значение = ЗначениеОтбора;  
	Иначе 
		СтруктураОтбора.Значение.Добавить(ЗначениеОтбора, ,Истина); 
	КонецЕсли;

КонецПроцедуры

Функция ИнициализироватьОтбор(Знач ПараметрыОтчета, ИмяРеквизита, Знач КоличествоЗначений, Знач ЭлементыОтбора)
	
	Перем Значение, СтруктураОтбора;
	
	Значение = ЗначениеПоКоличествуЭлементов(КоличествоЗначений);  
	СтруктураОтбора = Новый Структура("ВидСравнения, Значение", ВидСравнения(ЭлементыОтбора), Значение);
	ПараметрыОтчета.Отбор.Вставить(ИмяРеквизита, СтруктураОтбора);
	Возврат СтруктураОтбора;

КонецФункции

Функция ЗначениеПоКоличествуЭлементов(Знач КоличествоЗначений)
	
	Перем Значение;
	
	Если КоличествоЗначений > 1 Тогда
		Значение = Новый СписокЗначений;
	Иначе
		Значение = Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Функция - Вид сравнения
//
// Параметры:
//  СтрокиОтбора - 	Массив, СписокЗначений, Ссылка	 - Значения для ограничения отбора СКД 
// 
// Возвращаемое значение:
//  Строка - Тип сравнения
//
Функция ВидСравнения(Знач СтрокиОтбора) Экспорт 
	
	Если ТипЗнч(СтрокиОтбора) = Тип("СписокЗначений") Или 
		ТипЗнч(СтрокиОтбора) = Тип("Массив") Тогда
		
		Если СтрокиОтбора.Количество() = 1 Тогда
			Возврат "Равно";
		Иначе
			Возврат "ВСписке";
		КонецЕсли; 

	Иначе
		
		Возврат "Равно";
		
	КонецЕсли;

КонецФункции


