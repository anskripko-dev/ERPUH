
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ТекстЗапроса_ЗаполненияИзРСБУ(НомераТаблиц = Неопределено, ШаблонТрансляции = Неопределено) Экспорт
	
	Если НомераТаблиц = Неопределено Тогда
		НомераТаблиц = новый Структура;
	КонецЕсли;
	
	ПланСчетовИсточник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ШаблонТрансляции, "ПланСчетовИсточник");
	ЭтоМСФО = (ПланСчетовИсточник = Справочники.ПланыСчетовБД.ПолучитьПланСчетовБД("МСФО"));
	
	ТекстЗапроса = Новый Массив;
	
	МСФОВНАУХ.ТекстЗапроса_ПУВНА(ТекстЗапроса, НомераТаблиц);
	МСФОВНАУХ.ТекстЗапроса_СчетаВНАНСБУ(ТекстЗапроса, НомераТаблиц, ЭтоМСФО);
	
	//ТекстЗапроса.Добавить(ТекстЗапроса_втСубконто(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втОбороты(НомераТаблиц, ЭтоМСФО));
	
	МСФОВНАУХ.ТекстЗапроса_ПараметрыВНАРСБУ(ТекстЗапроса, НомераТаблиц, ЭтоМСФО);
	МСФОВНАУХ.ТекстЗапроса_ПрофилиМСФОНСБУ(ТекстЗапроса, НомераТаблиц, ЭтоМСФО);
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаБД(НомераТаблиц));
	ДобавитьЗапросы_втОборотыТрансляции(ТекстЗапроса, НомераТаблиц, ШаблонТрансляции);
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втПринятиеИВводВПериоде(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втМодернизацииПослеВвода(НомераТаблиц));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втСуммыПереоценки(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_СобытияВНА(НомераТаблиц));
	
	ТекстЗапроса = СтрСоединить(ТекстЗапроса, ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Период", "{(&ДатаОкончания)}");//ТекстЗапроса_ПараметрыВНАРСБУ
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыФункции

Функция ТекстЗапроса_втСубконто(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСубконто", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	ХозрасчетныйСубконто.Регистратор КАК Регистратор,
	|	ХозрасчетныйСубконто.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ХозрасчетныйСубконто.Значение) > 1
	|			ТОГДА МАКСИМУМ(ВЫБОР
	|						КОГДА ХозрасчетныйСубконто.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Дебет)
	|							ТОГДА ХозрасчетныйСубконто.Значение
	|						ИНАЧЕ NULL
	|					КОНЕЦ)
	|		ИНАЧЕ МАКСИМУМ(ХозрасчетныйСубконто.Значение)
	|	КОНЕЦ КАК ОсновнойВНА
	|ПОМЕСТИТЬ втСубконто
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Субконто КАК ХозрасчетныйСубконто
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВНА КАК втВНА
	|	ПО ХозрасчетныйСубконто.Значение = втВНА.ВНА 
	|ГДЕ
	|	ХозрасчетныйСубконто.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ТИПЗНАЧЕНИЯ(ХозрасчетныйСубконто.Регистратор) В (&ТипДокумента)
	|	И ХозрасчетныйСубконто.Значение В
	|			(ВЫБРАТЬ
	|				т.ВНА
	|			ИЗ
	|				втВНА КАК т)
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйСубконто.Регистратор,
	|	ХозрасчетныйСубконто.НомерСтроки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	НомерСтроки";

КонецФункции

Функция ТекстЗапроса_втОбороты(НомераТаблиц, ЭтоМСФО)
	
	НомераТаблиц.Вставить("втОбороты", НомераТаблиц.Количество());
	
	#Область Описание
	//Определение вида операции по Счету кредита:
	//	
	//	НА ВНА:
	//		Дт ПВНА 	Кт НАВНА 	- переоценка амортизации
	//		Дт * 		Кт НАВНА 	- начисление амортизации
	//
	//	ПС ВНА:
	//		Дт АВНА 	Кт НЗС 		- Ввод / модернизация ВНА
	//		Дт ВХР 		Кт НЗС 		- передача в филиал
	//		Дт ПР 		Кт НЗС 		- выбытие
	//		Дт НЗС 		Кт НЗС 		- Перемещение / модернизация	
	//
	//		Дт АВНА 	Кт АВНА 	- перемещение АВНА / модернизация / изменение параметров
	//		Дт ВХР 		Кт АВНА 	- передача в филиал
	//		Дт ПР 		Кт АВНА 	- выбытие
	//	 	Дт НАВНА 	Кт АВНА 	- списание амортизации при выбытии
	//
	//	ОВНА:
	//		Дт НЗП 		Кт ОВНА 	- амортизация обесценения
	//		Дт ПР 		Кт ОВНА 	- убыток обесценения
	//
	//   ПВНА:
	//		Дт ПСВНА 	Кт ПВНА 	- дооценка
	//		Дт НАВНА 	Кт ПВНА 	- корректировка амортизации при уценке
	//
	//	прочие:
	//		Дт ПСВНА 	Кт ВХР 		- передача ПС
	//		Дт НАВНА 	Кт ВХР 		- передача НА
	//		Дт ПСВНА 	Кт ПД 		- дооценка уценки ПС
	//		Дт НАВНА 	Кт ПД 		- уценка дооценки НА
	//		Дт ПСВНА 	Кт Проч 	- поступление ВНА
	
	//особенности:
	//		Дт * 		Кт НА 		- АмортизацияПриПеремещении(+ аналогично начислению амортизации)
	//		Дт НА 		Кт ВВНА 	- АмортизацияПриВыбытии(- приписывается в к выбытию ВВНА)
	//		Дт ВВНА 	Кт АВНА 	- Списание ПС ВНА (-)
	//		Дт НАВНА 	Кт ВВНА 	- Списание НА ВНА (-)
	//		Дт (ПС,НА) 		Кт (ПВНА,ПД,НА) 		- РезервПереоценкиИсключение(-)	
	//		Дт - 		Кт - 		- изменение параметров может не делать движений в РСБУ(+)	
	
	#КонецОбласти
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерПроводки,
	|	Обороты.Регистратор КАК ДокументОснование,
	|	&Организация КАК Организация,
	|	втВНА.ПараметрыУчетаВНА.ТипВНА КАК ТипВНА,
	|	втСчетДт.ТипВНА КАК СчетДтТипВНА,
	|	ВЫБОР
	|		КОГДА втСчетДт.Счет ЕСТЬ NULL
	|			ТОГДА Обороты.СубконтоКт1
	|		КОГДА втСчетДт.РольСчета = ""ПДР""
	|				И втСчетКт.РольСчета <> ""ПДР""
	|			ТОГДА Обороты.СубконтоКт1
	|		ИНАЧЕ Обороты.СубконтоДт1
	|	КОНЕЦ КАК ВНА,
	|	ВЫБОР
	|		КОГДА ""ПВНА"" В (втСчетДт.РольСчета, втСчетКт.РольСчета)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПереоценкаВНА)
	|		КОГДА ""ОВНА"" В (втСчетДт.РольСчета, втСчетКт.РольСчета)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ОбесценениеВНА)
	|		КОГДА ""ВВНА"" В (втСчетДт.РольСчета, втСчетКт.РольСчета)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВыбытиеВНА)
	|		КОГДА втСчетКт.РольСчета = ""НАВНА""
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СторноАмортизацииНСБУ)
	|		КОГДА втСчетКт.РольСчета = ""НЗС""
	|			ТОГДА ВЫБОР
	|					КОГДА втСчетДт.РольСчета = ""ВНА""
	|						ТОГДА ЕСТЬNULL(втВНА.СобытиеВНА, ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВводВЭксплуатацию))
	|					КОГДА втСчетДт.РольСчета = ""НЗС""
	|						ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПринятиеКУчетуВНА)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВыбытиеВНА)
	|				КОНЕЦ
	|		КОГДА втСчетКт.РольСчета = ""ВНА""
	|			ТОГДА ВЫБОР
	|					КОГДА втСчетДт.РольСчета В (""ВНА"")
	|							И Обороты.СубконтоКт1 = Обороты.СубконтоДт1
	|						ТОГДА ЕСТЬNULL(втВНА.СобытиеВНА, ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ИзменениеПараметровАмортизации))
	|					КОГДА втСчетДт.РольСчета В (""ВНА"")
	|						ТОГДА ЕСТЬNULL(втВНА.СобытиеВНА, ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВводВЭксплуатацию))
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВыбытиеВНА)
	|				КОНЕЦ
	|		КОГДА втСчетДт.РольСчета = ""ВНА""
	|			ТОГДА ЕСТЬNULL(втВНА.СобытиеВНА, ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВводВЭксплуатацию))
	|		КОГДА втСчетДт.РольСчета = ""НЗС""
	|			ТОГДА ЕСТЬNULL(втВНА.СобытиеВНА, ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПринятиеКУчетуВНА))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыОпераций.МодернизацияВНА)
	|	КОНЕЦ КАК ВидОперации,
	|	ВЫБОР
	|		КОГДА втСчетДт.РольСчета = ""НАВНА""
	|				И втСчетКт.РольСчета В (""ВВНА"", ""ВНА"")
	|			ТОГДА ""АмортизацияПриВыбытии""
	|		КОГДА втСчетДт.РольСчета = ""ПВНА""
	|				И втСчетКт.РольСчета = ""ВНА""
	|			ТОГДА ""АмортизацияПриПереоценке""
	|		КОГДА втСчетДт.РольСчета = ""ВНА""
	|				И втСчетКт.РольСчета = ""ПВНА""
	|			ТОГДА ""АмортизацияПриПереоценке""
	|		КОГДА втСчетДт.РольСчета = ""НАВНА""
	|				И втСчетКт.РольСчета = ""НАВНА""
	|			ТОГДА ""АмортизацияПриПеремещенииКомплектации""
	|	КОНЕЦ КАК УточнениеСобытия,
	|	ЕСТЬNULL(втВНА.ЕстьВУчете, ЛОЖЬ) КАК ЕстьВУчете,
	|	втСчетДт.ТипВНА КАК ТипВНАДт,
	|	втСчетКт.ТипВНА КАК ТипВНАКт,
	|	втСчетДт.РольСчета КАК РольСчетаДт,
	|	втСчетКт.РольСчета КАК РольСчетаКт,
	|	Обороты.Период КАК ДатаСобытияНСБУ,
	|	Обороты.СуммаВВалютеУчета КАК СуммаНСБУ,
	|	Обороты.СчетДт КАК СчетДт,
	|	Обороты.СубконтоДт1 КАК СубконтоДт1,
	|	Обороты.СубконтоДт2 КАК СубконтоДт2,
	|	Обороты.СубконтоДт3 КАК СубконтоДт3,
	|	Обороты.СчетКт КАК СчетКт,
	|	Обороты.СубконтоКт1 КАК СубконтоКт1,
	|	Обороты.СубконтоКт2 КАК СубконтоКт2,
	|	Обороты.СубконтоКт3 КАК СубконтоКт3,
	|	Обороты.ВалютаДт КАК ВалютаДт,
	|	Обороты.ВалютаКт КАК ВалютаКт,
	|	Обороты.КоличествоДт КАК КоличествоДт,
	|	Обороты.КоличествоКт КАК КоличествоКт,
	|	Обороты.СуммаВВалютеДт КАК ВалютнаяСуммаДт,
	|	Обороты.СуммаВВалютеКт КАК ВалютнаяСуммаКт,
	|	Обороты.ПодразделениеДт КАК ПодразделениеДт,
	|	Обороты.ПодразделениеКт КАК ПодразделениеКт,
	|	&ПодразделениеДт КАК ЦФОДт,
	|	&ПодразделениеКт КАК ЦФОКт,
	|	&НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	&НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт
	|ПОМЕСТИТЬ втОбороты
	|ИЗ
	|	РегистрБухгалтерии.МСФО.ДвиженияССубконто(
	|			{(&ДатаНачала)},
	|			{(&ДатаОкончания)},
	|			Организация = &Организация
	|				И Активность
	|				И Сценарий = &Сценарий
	|				И Счет В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчетаВНА КАК т
	|					ГДЕ
	|						НЕ т.РольСчета = ""ПДР""),
	|			,
	|			) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаВНА КАК втСчетДт
	|		ПО Обороты.СчетДт = втСчетДт.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаВНА КАК втСчетКт
	|		ПО Обороты.СчетКт = втСчетКт.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВНА КАК втВНА
	|		ПО (ВЫБОР
	|				КОГДА НЕ втСчетДт.ТипВНА ЕСТЬ NULL
	|					ТОГДА Обороты.СубконтоДт1 = втВНА.ВНА
	|				ИНАЧЕ Обороты.СубконтоКт1 = втВНА.ВНА
	|			КОНЕЦ)
	|ГДЕ
	|	Обороты.СуммаВВалютеУчета <> 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА,
	|	ДокументОснование";
	
	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	
	Если ЭтоЕРПУХ Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодразделениеДт", 			"Обороты.ПодразделениеДт.Организация");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодразделениеКт", 			"Обороты.ПодразделениеКт.Организация");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельностиДт", 	"Обороты.НаправлениеДеятельностиДт");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельностиКт", 	"Обороты.НаправлениеДеятельностиКт");
		
	ИначеЕсли ЭтоМСФО Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодразделениеДт", 			"Обороты.ПодразделениеДт");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодразделениеКт", 			"Обороты.ПодразделениеКт");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельностиДт", 	"Обороты.НаправлениеДеятельностиДт");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельностиКт", 	"Обороты.НаправлениеДеятельностиКт");
		
	Иначе 
		ТекстНД = "ВЫРАЗИТЬ(Обороты.СубконтоДт1 КАК Справочник.ОсновныеСредства).НаправлениеДеятельностиМСФО";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодразделениеДт", 			"Обороты.ПодразделениеДт.ЦФО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодразделениеКт", 			"Обороты.ПодразделениеКт.ЦФО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельностиДт", 	ТекстНД);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаправлениеДеятельностиКт", 	СтрЗаменить(ТекстНД, "Дт", "Кт"));

	КонецЕсли;
	
	Если Не ЭтоМСФО Тогда
		ТекстЗапроса = МСФОВызовСервераУХ.ПреобразоватьВРСБУ(ТекстЗапроса, "Обороты");
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапроса_втПринятиеИВводВПериоде(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПринятиеИВводВПериоде", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	втОборотыНЗС.СчетКт КАК СчетКт,
	|	втОборотыОС.ВНА КАК ПриемникВНА,
	|	втОборотыНЗС.ВНА КАК ИсточникВНА,
	|	втОборотыОС.ДокументОснование КАК ПриемникДокументОснование,
	|	втОборотыНЗС.ДокументОснование КАК ИсточникДокументОснование,
	|	втОборотыНЗС.СубконтоКт1 КАК СубконтоКт1,
	|	втОборотыНЗС.СубконтоКт2 КАК СубконтоКт2,
	|	втОборотыНЗС.СубконтоКт3 КАК СубконтоКт3,
	|	втОборотыНЗС.ВалютаКт КАК ВалютаКт,
	|	втОборотыНЗС.КоличествоКт КАК КоличествоКт,
	|	втОборотыНЗС.ДатаСобытияНСБУ КАК ДатаСобытияНСБУ,
	|	втОборотыНЗС.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт,
	|	втОборотыНЗС.СуммаНСБУ КАК СуммаНСБУ
	|ПОМЕСТИТЬ втПринятиеИВводВПериоде
	|ИЗ
	|	втОбороты КАК втОборотыОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаВНА КАК втСчет
	|		ПО втОборотыОС.СчетКт = втСчет.Счет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОбороты КАК втОборотыНЗС
	|		ПО втОборотыОС.СчетКт = втОборотыНЗС.СчетДт
	|			И (ВЫБОР
	|				КОГДА НЕ втСчет.ТолькоОбороты1
	|					ТОГДА ЕСТЬNULL(втОборотыОС.СубконтоКт1, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(втОборотыНЗС.СубконтоДт1, НЕОПРЕДЕЛЕНО)
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА НЕ втСчет.ТолькоОбороты2
	|					ТОГДА ЕСТЬNULL(втОборотыОС.СубконтоКт2, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(втОборотыНЗС.СубконтоДт2, НЕОПРЕДЕЛЕНО)
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА НЕ втСчет.ТолькоОбороты3
	|					ТОГДА ЕСТЬNULL(втОборотыОС.СубконтоКт3, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(втОборотыНЗС.СубконтоДт3, НЕОПРЕДЕЛЕНО)
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И втОборотыОС.СуммаНСБУ = втОборотыНЗС.СуммаНСБУ
	|			И (НЕ втОборотыНЗС.ВНА ССЫЛКА Справочник.ОбъектыСтроительства)
	|			И (НЕ втОборотыНЗС.ВНА ССЫЛКА Справочник.Номенклатура)
	|			И (втОборотыОС.СчетДт В
	|				(ВЫБРАТЬ
	|					т.Счет
	|				ИЗ
	|					втСчетаВНА КАК т))
	|			И (НЕ втОборотыНЗС.СчетКт В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчетаВНА КАК т))
	|			И (ЕСТЬNULL(втОборотыОС.ПодразделениеКт = втОборотыНЗС.ПодразделениеДт, ИСТИНА))
	|			И (втОборотыОС.ВНА В
	|				(ВЫБРАТЬ
	|					втВНА.ВНА
	|				ИЗ
	|					втВНА КАК втВНА
	|				ГДЕ
	|					втВНА.ПараметрыУчетаНЗС = ЗНАЧЕНИЕ(Справочник.ГруппыВНАМСФО.ПустаяСсылка)))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетКт,
	|	ИсточникВНА,
	|	ИсточникДокументОснование";

КонецФункции

Функция ТекстЗапроса_втМодернизацииПослеВвода(НомераТаблиц)
	
	НомераТаблиц.Вставить("втМодернизацииПослеВвода", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	МИНИМУМ(т.ДатаСобытияНСБУ) КАК ДатаСобытияНСБУ,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВводВЭксплуатацию) КАК СобытиеВвод,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.МодернизацияВНА) КАК СобытиеМодернизация,
	|	т.ВНА КАК ВНА
	|ПОМЕСТИТЬ втМодернизацииПослеВвода
	|ИЗ
	|	втОбороты КАК т
	|ГДЕ
	|	т.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВводВЭксплуатацию)
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ВНА
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(т.ДатаСобытияНСБУ) > 1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА,
	|	ДатаСобытияНСБУ";

КонецФункции

Функция ТекстЗапроса_втСчетаБД(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСчетаБД", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	МАКСИМУМ(СчетаБД.Ссылка) КАК СчетБД,
	|	СчетаБД.СчетСсылка КАК СчетИсточник,
	|	ЕСТЬNULL(МАКСИМУМ(СоответствияСчетовДляТрансляции.СчетПриемник), ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)) КАК СчетБДМСФО
	|ПОМЕСТИТЬ втСчетаБД
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СоответствияСчетовДляТрансляции КАК СоответствияСчетовДляТрансляции
	|		ПО (СоответствияСчетовДляТрансляции.СчетИсточник = СчетаБД.Ссылка)
	|			И (СоответствияСчетовДляТрансляции.Владелец = &ШаблонТрансляции)
	|ГДЕ
	|	(СчетаБД.СчетСсылка В
	|				(ВЫБРАТЬ
	|					т.СчетДт
	|				ИЗ
	|					втОбороты КАК т)
	|			ИЛИ СчетаБД.СчетСсылка В
	|				(ВЫБРАТЬ
	|					т.СчетКт
	|				ИЗ
	|					втОбороты КАК т)
	|			ИЛИ СчетаБД.СчетСсылка В
	|				(ВЫБРАТЬ
	|					втПараметрыВНА.СчетАмортизацииНСБУ
	|				ИЗ
	|					втПараметрыВНА КАК втПараметрыВНА))
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетаБД.СчетСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетИсточник";

КонецФункции

Функция ТекстЗапроса_СчетаИсточникиТрансляции()

	Возврат
	"ВЫБРАТЬ
	|	т.СчетБД КАК СчетИсточник
	|ИЗ
	|	втСчетаБД КАК т";

КонецФункции

Процедура ДобавитьЗапросы_втОборотыТрансляции(ТекстЗапроса, НомераТаблиц, ШаблонТрансляции)
	
	Процессор = МСФОЗапросыУХ.НовыйПроцессорТрансляцииЗапросом(ШаблонТрансляции);
	
	Процессор.ПутиИсключения.Добавить("Регистратор");
	Процессор.ИмяТаблицыИсточника = "ТаблицаИсточник";
	
	Процессор.СтороныТрансляции.Вставить("ПоляДт", Истина); //Истина=Дебет
	Процессор.СтороныТрансляции.Вставить("ПоляКт", Ложь); //Ложь=Кредит
	
	Процессор.ПоляИсточники.Вставить("Регистратор", "ДокументОснование");

	ПараметрыЗамены = МСФОЗапросыУХ.ПодготовитьЗаменыПараметровТрансляции(Процессор);
	
	МСФОЗапросыУХ.ДобавитьЗапросыТрансляции(ТекстЗапроса, НомераТаблиц, ТекстЗапроса_СчетаИсточникиТрансляции());
	Шаблон = ТекстЗапроса_втОборотыТрансляции(НомераТаблиц);
	ТекстЗапроса.Добавить(МСФОЗапросыУХ.ЗаменитьПараметрыЗапроса(Шаблон, ПараметрыЗамены));

КонецПроцедуры

Функция ТекстЗапроса_втОборотыТрансляции(НомераТаблиц)

	НомераТаблиц.Вставить("втОборотыТрансляция", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерТрансляции,
	|	ТаблицаИсточник.НомерПроводки КАК НомерПроводки,
	|	СчетИсточникДт.СчетБД КАК СчетДтНСБУ,
	|	ТаблицаИсточник.ПодразделениеДт КАК ПодразделениеДтНСБУ,
	|	ТаблицаИсточник.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДтНСБУ,
	|	ТаблицаИсточник.СубконтоДт1 КАК СубконтоДт1НСБУ,
	|	ТаблицаИсточник.СубконтоДт2 КАК СубконтоДт2НСБУ,
	|	ТаблицаИсточник.СубконтоДт3 КАК СубконтоДт3НСБУ,
	|	СчетИсточникКт.СчетБД КАК СчетКтНСБУ,
	|	ТаблицаИсточник.ПодразделениеКт КАК ПодразделениеКтНСБУ,
	|	ТаблицаИсточник.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКтНСБУ,
	|	ТаблицаИсточник.СубконтоКт1 КАК СубконтоКт1НСБУ,
	|	ТаблицаИсточник.СубконтоКт2 КАК СубконтоКт2НСБУ,
	|	ТаблицаИсточник.СубконтоКт3 КАК СубконтоКт3НСБУ,
	|	втПоляДт.СчетПриемник КАК СчетДт,
	|	&ПоляДт_Подразделение КАК ПодразделениеДт,
	|	&ПоляДт_НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	&ПоляДт_Субконто1 КАК СубконтоДт1,
	|	&ПоляДт_Субконто2 КАК СубконтоДт2,
	|	&ПоляДт_Субконто3 КАК СубконтоДт3,
	|	втПоляКт.СчетПриемник КАК СчетКт,
	|	&ПоляКт_Подразделение КАК ПодразделениеКт,
	|	&ПоляКт_НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	&ПоляКт_Субконто1 КАК СубконтоКт1,
	|	&ПоляКт_Субконто2 КАК СубконтоКт2,
	|	&ПоляКт_Субконто3 КАК СубконтоКт3
	|ПОМЕСТИТЬ втОборотыТрансляция
	|ИЗ
	|	втОбороты КАК ТаблицаИсточник
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПравилаПолей КАК втПоляДт
	|		ПО ТаблицаИсточник.СчетДт = втПоляДт.СчетИсточникСсылка
	|			И (втПоляДт.ТрансляцияДебет)
	|			И (ВЫБОР
	|				КОГДА втПоляДт.ПрименениеПоКорреспонденции
	|					ТОГДА ТаблицаИсточник.СчетКт = втПоляДт.КоррСчетСсылка
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА НЕ втПоляДт.ЕстьОтборы
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ &ПоляДт_Отбор
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПравилаПолей КАК втПоляКт
	|		ПО ТаблицаИсточник.СчетКт = втПоляКт.СчетИсточникСсылка
	|			И (втПоляКт.ТрансляцияКредит)
	|			И (ВЫБОР
	|				КОГДА втПоляКт.ПрименениеПоКорреспонденции
	|					ТОГДА ТаблицаИсточник.СчетДт = втПоляКт.КоррСчетСсылка
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА НЕ втПоляКт.ЕстьОтборы
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ &ПоляКт_Отбор
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаБД КАК СчетИсточникДт
	|		ПО ТаблицаИсточник.СчетДт = СчетИсточникДт.СчетИсточник
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаБД КАК СчетИсточникКт
	|		ПО ТаблицаИсточник.СчетКт = СчетИсточникКт.СчетИсточник
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерПроводки";

КонецФункции

Функция ТекстЗапроса_втСуммыПереоценки(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСуммыПереоценки", НомераТаблиц.Количество());
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ") Тогда
		
		Возврат
		"ВЫБРАТЬ
		|	NULL КАК Регистратор,
		|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка) КАК ВНА,
		|	0 КАК СправедливаяСтоимость
		|ПОМЕСТИТЬ втСуммыПереоценки";		
		
	КонецЕсли;
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК Регистратор,
	|	т.ОсновноеСредство КАК ВНА,
	|	т.СтоимостьБУ КАК СправедливаяСтоимость
	|ПОМЕСТИТЬ втСуммыПереоценки
	|ИЗ
	|	Документ.ПереоценкаОС2_4.ОС КАК т
	|ГДЕ
	|	(т.Ссылка, т.ОсновноеСредство) В
	|			(ВЫБРАТЬ
	|				т.ДокументОснование,
	|				т.ВНА
	|			ИЗ
	|				втОбороты КАК т)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Ссылка,
	|	т.ОсновноеСредство,
	|	т.Стоимость
	|ИЗ
	|	Документ.ПереоценкаОС.ОС КАК т
	|ГДЕ
	|	(т.Ссылка, т.ОсновноеСредство) В
	|			(ВЫБРАТЬ
	|				т.ДокументОснование,
	|				т.ВНА
	|			ИЗ
	|				втОбороты КАК т)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Ссылка,
	|	т.НематериальныйАктив,
	|	т.СтоимостьБУ
	|ИЗ
	|	Документ.ПереоценкаНМА2_4.НМА КАК т
	|ГДЕ
	|	(т.Ссылка, т.НематериальныйАктив) В
	|			(ВЫБРАТЬ
	|				т.ДокументОснование,
	|				т.ВНА
	|			ИЗ
	|				втОбороты КАК т)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Ссылка,
	|	т.НематериальныйАктив,
	|	т.Стоимость
	|ИЗ
	|	Документ.ПереоценкаНМА КАК т
	|ГДЕ
	|	(т.Ссылка, т.НематериальныйАктив) В
	|			(ВЫБРАТЬ
	|				т.ДокументОснование,
	|				т.ВНА
	|			ИЗ
	|				втОбороты КАК т)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	ВНА
	|";

КонецФункции

Функция ТекстЗапроса_СобытияВНА(НомераТаблиц)

	НомераТаблиц.Вставить("СобытияВНА", НомераТаблиц.Количество());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	втОбороты.ВНА.КлассВНА КАК КлассВНА,
	|	втОбороты.ТипВНА КАК ТипВНА,
	|	втОбороты.ДокументОснование КАК ДокументОснование,
	|	втОбороты.ВНА КАК ВНА,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втВНА.ПараметрыУчетаВНА, ЗНАЧЕНИЕ(Справочник.ГруппыВНАМСФО.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ГруппыВНАМСФО.ПустаяСсылка)
	|			ТОГДА ""Трансляция""
	|		ИНАЧЕ ""Параллельный учет""
	|	КОНЕЦ КАК ВариантУчета,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.ДатаСобытияНСБУ, втОбороты.ДатаСобытияНСБУ) КАК ДатаСобытияНСБУ,
	|	ЕСТЬNULL(втСуммыПереоценки.СправедливаяСтоимость, втОбороты.СуммаНСБУ) КАК СуммаНСБУ,
	|	ЕСТЬNULL(втПараметрыВНА.НачислятьАмортизациюНСБУ, ЛОЖЬ) КАК НачислятьАмортизациюНСБУ,
	|	втПараметрыВНА.СрокПолезногоИспользованияНСБУ КАК СрокПолезногоИспользованияНСБУ,
	|	втПараметрыВНА.СпособНачисленияАмортизацииНСБУ КАК СпособНачисленияАмортизацииНСБУ,
	|	втПараметрыВНА.СпособНачисленияАмортизацииМСФО КАК СпособНачисленияАмортизацииМСФО,
	|	втПараметрыВНА.СтатьяРасходов КАК СтатьяРасходов,
	|	втПараметрыВНА.АналитикаРасходов КАК АналитикаРасходов,
	|	втПараметрыВНА.СпособПоступления КАК СпособПоступления,
	|	втПараметрыВНА.КоэффициентУскоренияНСБУ КАК КоэффициентУскоренияНСБУ,
	|	втПараметрыВНА.ПредполагаемыйОбъемПродукцииНСБУ КАК ПредполагаемыйОбъемПродукцииНСБУ,
	|	втПараметрыВНА.ПараметрВыработкиНСБУ КАК ПараметрВыработкиНСБУ,
	|	втПараметрыВНА.ПрофильНСБУ КАК СпособОтраженияРасходовПоАмортизацииНСБУ,
	|	втПрофили.ПрофильМСФО КАК СпособОтраженияРасходовПоАмортизацииМСФО,
	|	втОборотыТрансляция.СчетДтНСБУ КАК СчетДт,
	|	втОбороты.СубконтоДт1 КАК ОбъектВНАДт,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.СубконтоКт1, втОбороты.СубконтоКт1) КАК ОбъектВНАКт,
	|	втОбороты.КоличествоДт КАК КоличествоДт,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.КоличествоКт, втОбороты.КоличествоКт) КАК КоличествоКт,
	|	втОбороты.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.ВалютнаяСуммаКт, втОбороты.ВалютнаяСуммаКт) КАК ВалютнаяСуммаКт,
	|	втОбороты.ВалютаДт КАК ВалютаДт,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.ВалютаКт, втОбороты.ВалютаКт) КАК ВалютаКт,
	|	ЕСТЬNULL(втМодернизацииПослеВвода.СобытиеМодернизация, втОбороты.ВидОперации) КАК ВидОперации,
	|	ЕСТЬNULL(втВНА.ЕстьВУчете, ЛОЖЬ) КАК ПринятРанееКУчетуМСФО,
	|	втОборотыТрансляция.СчетДт КАК СчетДтМСФО,
	|	ЕСТЬNULL(втСчетКтПринятие.СчетБДМСФО, втОборотыТрансляция.СчетКт) КАК СчетКтМСФО,
	|	ЕСТЬNULL(втСчетУчетаНСБУ.СчетБД, втОборотыТрансляция.СчетДтНСБУ) КАК СчетУчетаВНАНСБУ,
	|	ЕСТЬNULL(втСчетУчетаНСБУ.СчетБДМСФО, втОборотыТрансляция.СчетДт) КАК СчетУчетаВНАМСФО,
	|	ЕСТЬNULL(втСчетАмортизацииНСБУ.СчетБД, ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)) КАК СчетАмортизацииНСБУ,
	|	ЕСТЬNULL(втСчетАмортизацииНСБУ.СчетБДМСФО, ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)) КАК СчетАмортизацииМСФО,
	|	-втОборотыАмортизацияПриВыбытии.СуммаНСБУ КАК АмортизацияНСБУ,
	|	ВЫБОР
	|		КОГДА втОбороты.СчетДтТипВНА = ЗНАЧЕНИЕ(Перечисление.ТипыВНА.НезавершенноеСтроительство)
	|				И втВНА.ПараметрыУчетаНЗС <> ЗНАЧЕНИЕ(Справочник.ГруппыВНАМСФО.ПустаяСсылка)
	|			ТОГДА втВНА.ПараметрыУчетаНЗС
	|		ИНАЧЕ втВНА.ПараметрыУчетаВНА
	|	КОНЕЦ КАК ПараметрыУчетаВНА,
	|	втОбороты.СубконтоДт1 КАК СубконтоДт1,
	|	втОбороты.СубконтоДт2 КАК СубконтоДт2,
	|	втОбороты.СубконтоДт3 КАК СубконтоДт3,
	|	ЕСТЬNULL(втСчетКтПринятие.СчетБД, втОборотыТрансляция.СчетКтНСБУ) КАК СчетКт,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.СубконтоКт1, втОбороты.СубконтоКт1) КАК СубконтоКт1,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.СубконтоКт2, втОбороты.СубконтоКт2) КАК СубконтоКт2,
	|	ЕСТЬNULL(втПринятиеИВводВПериоде.СубконтоКт3, втОбороты.СубконтоКт3) КАК СубконтоКт3,
	|	втПараметрыВНА.СтатьяРасходов КАК СтатьяРасходов1,
	|	втПараметрыВНА.АналитикаРасходов КАК АналитикаРасходов1,
	|	втОборотыТрансляция.ПодразделениеДт КАК ПодразделениеДт,
	|	втОборотыТрансляция.ПодразделениеКт КАК ПодразделениеКт,
	|	втОборотыТрансляция.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	втОборотыТрансляция.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт,
	|	ОбъектыАрендыПоУмолчаниюМСФО.ФИ КАК ФИ,
	|	НЕ ОбъектыАрендыПоУмолчаниюМСФО.ФИ ЕСТЬ NULL
	|		И НЕ ЕСТЬNULL(втВНА.ЕстьВУчете, ЛОЖЬ)
	|		И втОбороты.ВидОперации В (ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ВводВЭксплуатацию)) КАК ПризнаетсяКакЛизинг
	|ИЗ
	|	втОбороты КАК втОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОборотыТрансляция КАК втОборотыТрансляция
	|		ПО втОбороты.НомерПроводки = втОборотыТрансляция.НомерПроводки
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВНА КАК втВНА
	|		ПО втОбороты.ВНА = втВНА.ВНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПараметрыВНА КАК втПараметрыВНА
	|			ЛЕВОЕ СОЕДИНЕНИЕ втСчетаБД КАК втСчетУчетаНСБУ
	|			ПО втПараметрыВНА.СчетУчетаНСБУ = втСчетУчетаНСБУ.СчетИсточник
	|			ЛЕВОЕ СОЕДИНЕНИЕ втСчетаБД КАК втСчетАмортизацииНСБУ
	|			ПО втПараметрыВНА.СчетАмортизацииНСБУ = втСчетАмортизацииНСБУ.СчетИсточник
	|			ЛЕВОЕ СОЕДИНЕНИЕ втПрофилиМСФО КАК втПрофили
	|			ПО (&СоединениеПрофильМСФО)
	|		ПО втОбороты.ВНА = втПараметрыВНА.ВНА
	|			И (втОбороты.ТипВНА <> ЗНАЧЕНИЕ(Перечисление.ТипыВНА.НезавершенноеСтроительство))
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОбороты КАК втОборотыАмортизацияПриВыбытии
	|		ПО втОбороты.ВНА = втОборотыАмортизацияПриВыбытии.ВНА
	|			И втОбороты.ДокументОснование = втОборотыАмортизацияПриВыбытии.ДокументОснование
	|			И (ЕСТЬNULL(втОборотыАмортизацияПриВыбытии.УточнениеСобытия, НЕОПРЕДЕЛЕНО) = ""АмортизацияПриВыбытии"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПринятиеИВводВПериоде КАК втПринятиеИВводВПериоде
	|			ЛЕВОЕ СОЕДИНЕНИЕ втСчетаБД КАК втСчетКтПринятие
	|			ПО втПринятиеИВводВПериоде.СчетКт = втСчетКтПринятие.СчетИсточник
	|		ПО втОбороты.ВНА = втПринятиеИВводВПериоде.ПриемникВНА
	|			И втОбороты.ДокументОснование = втПринятиеИВводВПериоде.ПриемникДокументОснование
	|			И (НЕ ЕСТЬNULL(втОбороты.УточнениеСобытия, НЕОПРЕДЕЛЕНО) = ""АмортизацияПриПеремещении"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСуммыПереоценки КАК втСуммыПереоценки
	|		ПО втОбороты.ДокументОснование = втСуммыПереоценки.Регистратор
	|			И втОбороты.ВНА = втСуммыПереоценки.ВНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ втМодернизацииПослеВвода КАК втМодернизацииПослеВвода
	|		ПО втОбороты.ВНА = втМодернизацииПослеВвода.ВНА
	|			И втОбороты.ВидОперации = втМодернизацииПослеВвода.СобытиеВвод
	|			И втОбороты.ДатаСобытияНСБУ <> втМодернизацииПослеВвода.ДатаСобытияНСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОбъектыАрендыПоУмолчаниюМСФО КАК ОбъектыАрендыПоУмолчаниюМСФО
	|		ПО втОбороты.ВНА = ОбъектыАрендыПоУмолчаниюМСФО.ВНА
	|ГДЕ
	|	втОбороты.УточнениеСобытия ЕСТЬ NULL
	|	И НЕ (втОбороты.ВНА, втОбороты.ДокументОснование, втОбороты.СчетКт) В
	|				(ВЫБРАТЬ
	|					т.ИсточникВНА,
	|					т.ИсточникДокументОснование,
	|					т.СчетКт
	|				ИЗ
	|					втПринятиеИВводВПериоде КАК т)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСобытияНСБУ,
	|	ВНА,
	|	ДокументОснование,
	|	ВидОперации";
	
	СоединениеПрофильМСФО = "втПараметрыВНА.ПрофильНСБУ = втПрофили.ПрофильНСБУ";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ") Тогда
	
		СоединениеПрофильМСФО = 
		"втПараметрыВНА.СтатьяРасходов = втПрофили.СтатьяРасходов
		|И втПараметрыВНА.АналитикаРасходов = втПрофили.АналитикаРасходов
		|И втПараметрыВНА.НаправлениеДеятельности = втПрофили.НаправлениеДеятельности";
	
	КонецЕсли;
	//|И втОбороты.ПодразделениеДт = втПрофили.Подразделение
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеПрофильМСФО", СоединениеПрофильМСФО);
	
	Возврат ТекстЗапроса;	
	
КонецФункции

#КонецОбласти

#КонецЕсли
