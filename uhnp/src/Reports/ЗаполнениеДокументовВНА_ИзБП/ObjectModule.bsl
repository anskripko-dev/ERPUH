Функция ПолучитьДокументы_ВводСобытийВНАМСФО() Экспорт
	
	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	ЭтоУХ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() И Не ЭтоЕРПУХ;
	
	ДокументСобытиеВНА = Новый Массив;	
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_ПоступлениеВНАМСФО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_ВводВЭксплуатациюВНАМСФО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_ИзменениеПараметровВНАМСФО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_НачислениеАмортизацииВНАМСФО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_ВыбытиеВНАМСФО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_МодернизацияВНАМСФО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_ОбесценениеВНАМСФО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументСобытиеВНА, ПолучитьДокументы_ПереоценкаВНАМСФО());

	Возврат ДокументСобытиеВНА;
	
КонецФункции

Функция ПолучитьДокументы_ОбесценениеВНАМСФО() Экспорт
	
	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	ЭтоУХ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() И Не ЭтоЕРПУХ;
	
	ДокументСобытиеВНА = Новый Массив;
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ОбесценениеВнеоборотныхАктивов", ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ОбесценениеВНА", ЭтоЕРПУХ);
	
	Возврат ДокументСобытиеВНА;

КонецФункции

Функция ПолучитьДокументы_ПереоценкаВНАМСФО() Экспорт
	
	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	ЭтоУХ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() И Не ЭтоЕРПУХ;
	
	ДокументСобытиеВНА = Новый Массив;
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПереоценкаВНАМСФО",	Истина);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПереоценкаНМА", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПереоценкаНМА2_4",	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПереоценкаОС",		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПереоценкаОС2_4",	ЭтоЕРПУХ);
		
	Возврат ДокументСобытиеВНА;
	
КонецФункции

Функция ПолучитьТипыПоВидуДокумента(ВидДокумента) Экспорт

	Если ВидДокумента = Тип("ДокументСсылка.ВводВНАВЭксплуатациюМСФО") Тогда
	
		Возврат ПолучитьДокументы_ВводВЭксплуатациюВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.НачислениеАмортизацииВНАМСФО") Тогда
	
		Возврат ПолучитьДокументы_НачислениеАмортизацииВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ИзменениеПараметровВНАМСФО") Тогда
	
		Возврат ПолучитьДокументы_ИзменениеПараметровВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.МодернизацияВНАМСФО") Тогда
	
		Возврат ПолучитьДокументы_МодернизацияВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ВыбытиеВНАМСФО") Тогда
	
		Возврат ПолучитьДокументы_ВыбытиеВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ВводСобытийВНАМСФО") Тогда
	
		Возврат ПолучитьДокументы_ВводСобытийВНАМСФО();
		
	ИначеЕсли МСФОКлиентСерверУХ.ЭтоТипВводСведенийВнаМсфо(ВидДокумента) Тогда
	
		Возврат ПолучитьДокументы_ВводСобытийВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ПереоценкаВНАМСФО") Тогда
	
		Возврат ПолучитьДокументы_ПереоценкаВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ОбесценениеВНАМСФО") Тогда
	
		Возврат ПолучитьДокументы_ОбесценениеВНАМСФО();
		
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ВводСведенийОФинансовыхИнструментах") Тогда
	
		Возврат ПолучитьДокументы_ВводВЭксплуатациюВНАМСФО();
		
	Иначе

		Возврат Новый Массив;
	
	КонецЕсли;

КонецФункции

Функция ТипРСБУ(ИмяТипа, ЕстьРСБУ = Неопределено)
	
	Если ЕстьРСБУ = Неопределено Тогда
		ЕстьРСБУ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ();
	КонецЕсли;
	
	Если ЕстьРСБУ Тогда
		Возврат Тип(ИмяТипа);
	КонецЕсли;             
	
	Возврат Тип("ДокументСсылка.ОперацияМСФО");

КонецФункции

Функция ДобавитьТип(ТипыДляДобавления, ИмяТипа, ДобавитьТип = Ложь)
	
	Если ДобавитьТип Тогда
		ТипыДляДобавления.Добавить(Тип(ИмяТипа));		
	КонецЕсли;
	
КонецФункции

