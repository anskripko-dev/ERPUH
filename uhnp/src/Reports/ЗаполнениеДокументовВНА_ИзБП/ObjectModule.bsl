
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = МСФОВНАВстраиваниеУХ.ТекстЗапроса_ЗаполненияИзРСБУ();
	
	ЗаполнитьПараметрыПоТипуДокумента(КомпоновщикНастроек.Настройки);	
	
КонецПроцедуры

Функция ЗаполнитьПараметрыПоТипуДокумента(НастройкиСКД = Неопределено, ТолькоИмеющиеПараметрыУчетаВНА = Ложь) Экспорт 

	Если НастройкиСКД = Неопределено Тогда
		НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();	
	КонецЕсли;
	
	ТипДокумента = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТипДокумента")).Значение;
	Если Не ЗначениеЗаполнено(ТипДокумента) Тогда
		НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра("ТипДокумента", Тип("ДокументСсылка.ВводСобытийВНАМСФО"));
	КонецЕсли;
	
	УстановитьПараметр(НастройкиСКД, "Документы_ВводВЭксплуатациюВНАМСФО", 		ПолучитьДокументы_ВводВЭксплуатациюВНАМСФО());
	УстановитьПараметр(НастройкиСКД, "Документы_ИзменениеПараметровВНАМСФО", 	ПолучитьДокументы_ИзменениеПараметровВНАМСФО());
	УстановитьПараметр(НастройкиСКД, "Документы_ПоступлениеВНАМСФО", 			ПолучитьДокументы_ПоступлениеВНАМСФО());
	УстановитьПараметр(НастройкиСКД, "Документы_НачислениеАмортизацииВНАМСФО",	ПолучитьДокументы_НачислениеАмортизацииВНАМСФО());
	УстановитьПараметр(НастройкиСКД, "Документы_МодернизацияВНАМСФО", 			ПолучитьДокументы_МодернизацияВНАМСФО());
	УстановитьПараметр(НастройкиСКД, "Документы_ВыбытиеВНАМСФО", 				ПолучитьДокументы_ВыбытиеВНАМСФО());
    УстановитьПараметр(НастройкиСКД, "Документы_ОбесценениеВНАМСФО", 			ПолучитьДокументы_ОбесценениеВНАМСФО());
	УстановитьПараметр(НастройкиСКД, "Документы_ПереоценкаВНАМСФО", 			ПолучитьДокументы_ПереоценкаВНАМСФО());

	МасТипыЖурнала = Новый Массив;	
	МасТипыЖурнала.Добавить(Тип("ДокументСсылка.ВводСобытийВНАМСФО"));
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		ИмяТипа = "ДокументСсылка.ВводСведенийВНАМСФО";
		МасТипыЖурнала.Добавить(Тип(ИмяТипа));
	КонецЕсли;
	МасТипыЖурнала.Добавить(Тип("ДокументСсылка.ВосстановлениеВНАИзРасходов"));
	МасТипыЖурнала.Добавить(Тип("ДокументСсылка.НачислениеАмортизацииВНАМСФО"));
	МасТипыЖурнала.Добавить(Тип("ДокументСсылка.ПризнаниеРасходовПоАмортизацииНСБУ"));
	МасТипыЖурнала.Добавить(Тип("ДокументСсылка.ВводВНАВЭксплуатациюМСФО"));
	МасТипыЖурнала.Добавить(Тип("ДокументСсылка.ПоступлениеВНАМСФО"));
	МасТипыЖурнала.Добавить(Тип("ДокументСсылка.ВводСведенийОФинансовыхИнструментах"));
	
	УстановитьПараметр(НастройкиСКД, "ЖурналОпераций", МасТипыЖурнала.Найти(ТипДокумента) <> Неопределено);
	УстановитьПараметр(НастройкиСКД, "ПараметрыВНА", Истина);
	
	Отбор_ФИ = ТолькоИмеющиеПараметрыУчетаВНА;
	
	Если ТипДокумента = Тип("ДокументСсылка.ВводСобытийВНАМСФО") Тогда
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ВводСобытийВНАМСФО());	
	ИначеЕсли МСФОКлиентСерверУХ.ЭтоТипВводСведенийВнаМсфо(ТипДокумента) Тогда
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ВводСобытийВНАМСФО());
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПоступлениеВНАМСФО") Тогда
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ПоступлениеВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.ПринятиеКУчетуВНА);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВводВНАВЭксплуатациюМСФО") Тогда
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ВводВЭксплуатациюВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.ВводВЭксплуатацию);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИзменениеПараметровВНАМСФО") Тогда//ранее сторноРСБУ
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ИзменениеПараметровВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.ИзменениеПараметровАмортизации);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПризнаниеРасходовПоАмортизацииНСБУ") Тогда
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_НачислениеАмортизацииВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.СторноАмортизацииНСБУ);
	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.МодернизацияВНАМСФО") Тогда
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_МодернизацияВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.МодернизацияВНА);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВыбытиеВНАМСФО") Тогда
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ВыбытиеВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.ВыбытиеВНА);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОбесценениеВНАМСФО") Тогда
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ОбесценениеВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.ОбесценениеВНА);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПереоценкаВНАМСФО") Тогда
		
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ПолучитьДокументы_ПереоценкаВНАМСФО());
		ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.ПереоценкаВНА);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВводСведенийОФинансовыхИнструментах") Тогда
		
		Отбор_ФИ = Ложь;//отбор по ВНА устанавливается в документе ФИ
		
		ТипДокумента = ПолучитьДокументы_ВводВЭксплуатациюВНАМСФО();
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТипДокумента, ПолучитьДокументы_ПоступлениеВНАМСФО());
		УстановитьПараметр(НастройкиСКД, "ТипДокумента", ТипДокумента);
		
		//ДобавитьОтборПоВидуОперации(НастройкиСКД, Справочники.ВидыОпераций.ВводВЭксплуатацию);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкиСКД.Отбор, "ФИ", ВидСравненияКомпоновкиДанных.Заполнено);
		
	КонецЕсли;
	
	Если ТолькоИмеющиеПараметрыУчетаВНА Тогда		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкиСКД.Отбор, "ПараметрыУчетаВНА", ВидСравненияКомпоновкиДанных.Заполнено);
	КонецЕсли;
	
	Если Отбор_ФИ Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкиСКД.Отбор, "ФИ", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	КонецЕсли;
	
КонецФункции

Функция УстановитьПараметр(НастройкиСКД, ИмяПараметра, ЗначениеПараметра)
	НастройкиСКД.ПараметрыДанных.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
КонецФункции

Функция ДобавитьОтборПоВидуОперации(НастройкиСКД, ВидОперации)

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкиСКД.Отбор, "ВидОперации", ВидСравненияКомпоновкиДанных.Равно, ВидОперации);

КонецФункции

#Область ТипыДокументов

Функция ПолучитьДокументы_ВводВЭксплуатациюВНАМСФО() Экспорт
	
	ДокументСобытиеВНА = Новый Массив;
	
	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	ЭтоУХ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() И Не ЭтоЕРПУХ;
	
	//УХ, БМ, НМ
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПринятиеКУчетуОС",				ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПринятиеКУчетуНМА", 			ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПоступлениеТоваровУслуг", 		ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПередачаОборудованияВМонтаж", 	ЭтоУХ);
	
	//ЕРПУХ
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПринятиеКУчетуОС2_4", 			ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПринятиеКУчетуОС", 				ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПринятиеКУчетуНМА2_4", 			ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПринятиеКУчетуНМА", 			ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.РазукомплектацияОС", 			ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ОбъединениеОС", 				ЭтоЕРПУХ);	
	//03
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПоступлениеАрендованныхОС", 	ЭтоЕРПУХ);	
	//07,08,10
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПоступлениеТоваровНаСклад", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПриобретениеУслугПрочихАктивов",ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПриобретениеТоваровУслуг",		ЭтоЕРПУХ);
	
	Возврат ДокументСобытиеВНА;
	
КонецФункции

Функция ПолучитьДокументы_НачислениеАмортизацииВНАМСФО() Экспорт
		
	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	ЭтоУХ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() И Не ЭтоЕРПУХ;
	
	ДокументСобытиеВНА = Новый Массив;
	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.РегламентнаяОперация", ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ОперацияБух", ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПеремещениеОС", ЭтоУХ);
		
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.РегламентнаяОперация",	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ОперацияБух",			ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПеремещениеОС2_4", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПеремещениеОС", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.АмортизацияОС2_4", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.АмортизацияОС", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.АмортизацияНМА2_4", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.АмортизацияНМА", 		ЭтоЕРПУХ);

	Возврат ДокументСобытиеВНА;

КонецФункции

Функция ПолучитьДокументы_ИзменениеПараметровВНАМСФО() Экспорт

	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	ЭтоУХ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() И Не ЭтоЕРПУХ;
	
	ДокументСобытиеВНА = Новый Массив;
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеПараметровНачисленияАмортизацииОС", 			ЭтоУХ);	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеСпециальногоКоэффициентаОС", 					ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеСпециальногоКоэффициентаНМА", 					ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеСпособовОтраженияРасходовПоАмортизацииОС", 	ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеСпособовОтраженияРасходовПоАмортизацииНМА", 	ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеСостоянияОС", 									ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеГрафиковАмортизацииОС", 						ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПеремещениеОС", 										ЭтоУХ);

	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеПараметровОС2_4", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеПараметровОС", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеПараметровНМА2_4", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеПараметровНМА", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ИзменениеСостоянияОС", 			ЭтоЕРПУХ);

	Возврат ДокументСобытиеВНА;

КонецФункции

