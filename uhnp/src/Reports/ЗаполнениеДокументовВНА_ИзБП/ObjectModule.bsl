	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.МодернизацияОС2_4", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.МодернизацияОС", 		ЭтоЕРПУХ);
	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПоступлениеТоваровНаСклад", 		ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПриобретениеУслугПрочихАктивов",	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПриобретениеТоваровУслуг", 			ЭтоЕРПУХ);

	Возврат ДокументСобытиеВНА;
	
КонецФункции

Функция ПолучитьДокументы_ВыбытиеВНАМСФО() Экспорт
	
	ЭтоЕРПУХ = ОбщегоНазначения.ПодсистемаСуществует("ИзмененныеОбъектыЕХ");
	ЭтоУХ = ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() И Не ЭтоЕРПУХ;
	
	ДокументСобытиеВНА = Новый Массив;
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.СписаниеОС", 			ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.СписаниеНМА", 			ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПередачаОС", 			ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПередачаНМА", 			ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПодготовкаКПередачеОС", ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.АвизоОСИсходящее", 		ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ОперацияБух", 			ЭтоУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПереводОСВМалоценноеОборудование",	ЭтоУХ);
	
	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.СписаниеОС2_4", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.СписаниеОС", 		ЭтоЕРПУХ);	
	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.СписаниеНМА2_4", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.СписаниеНМА", 		ЭтоЕРПУХ);
	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПодготовкаКПередачеОС2_4", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПодготовкаКПередачеОС", 	ЭтоЕРПУХ);
	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПодготовкаКПередачеНМА2_4",	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ПодготовкаКПередачеНМА", 	ЭтоЕРПУХ);
	
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.РеализацияУслугПрочихАктивов", 	ЭтоЕРПУХ);
	ДобавитьТип(ДокументСобытиеВНА, "ДокументСсылка.ОперацияБух", 					ЭтоЕРПУХ);
	
	
	
	Возврат ДокументСобытиеВНА;

КонецФункции

