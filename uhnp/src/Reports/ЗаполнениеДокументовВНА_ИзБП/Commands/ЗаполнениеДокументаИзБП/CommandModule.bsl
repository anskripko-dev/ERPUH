
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = ПолучитьПараметрыФормы(ПараметрКоманды);
	
	ОткрытьФорму("Отчет.ЗаполнениеДокументовВНА_ИзБП.Форма", 
					ПараметрыФормы, 
					ПараметрыВыполненияКоманды.Источник, 
					ПараметрыВыполненияКоманды.Уникальность, 
					ПараметрыВыполненияКоманды.Окно, 
					ПараметрыВыполненияКоманды.НавигационнаяСсылка
				);
				
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормы(ДокументСсылка)

	Результат = Новый Структура;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Результат.Вставить("Организация",	ДокументСсылка.Организация);
	Результат.Вставить("Сценарий", 		ДокументСсылка.Сценарий);	
	Результат.Вставить("ТипДокумента",	ТипЗнч(ДокументСсылка));
	
	Если (ТипДокумента = Тип("ДокументСсылка.ВводСобытийВНАМСФО")) 
		Или (МСФОКлиентСерверУХ.ЭтоТипВводСведенийВнаМсфо(ТипДокумента)) Тогда
		
		Результат.Вставить("ДатаНачала",		ДокументСсылка.ПериодОтчета.ДатаНачала);
		Результат.Вставить("ДатаОкончания", 	КонецДня(ДокументСсылка.ПериодОтчета.ДатаОкончания));
		
	Иначе	
		
		Результат.Вставить("ДатаНачала",	НачалоДня(ДокументСсылка.Дата));
		Результат.Вставить("ДатаОкончания",	КонецДня(ДокументСсылка.Дата));
				
	КонецЕсли;
    
	ШаблонТрансляции = МСФОВызовСервераУХ.ЗначениеУП("ШаблонТрансляции", 
		Результат.Организация, Результат.ДатаОкончания, Результат.Сценарий);
	Результат.Вставить("ШаблонТрансляции", 	ШаблонТрансляции);
	
	Возврат Новый Структура("Отбор,СформироватьПриОткрытии", Результат, Истина);
	
КонецФункции