Функция ПолучитьТаблицуПримененияФорматов() Экспорт 
	Результат = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюТаблицуПримененияФорматов();
	
	Стр = Результат.Добавить();
	Стр.ИмяФормы = "Форма2024_1";
	Стр.КНД = "1125330";
	Стр.ВерсияФормата = "5.02";
	
	Возврат Результат;
КонецФункции

Функция ДанноеУведомлениеДоступноДляОрганизации() Экспорт 
	Возврат Истина;
КонецФункции

Функция ДанноеУведомлениеДоступноДляИП() Экспорт 
	Возврат Ложь;
КонецФункции

Функция ПолучитьОсновнуюФорму() Экспорт 
	Возврат "";
КонецФункции

Функция ПолучитьФормуПоУмолчанию() Экспорт 
	Возврат "";
КонецФункции

Функция ПолучитьТаблицуФорм() Экспорт 
	Результат = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюТаблицуФормУведомления();
	
	Стр = Результат.Добавить();
	Стр.ИмяФормы = "Форма2024_1";
	Стр.ОписаниеФормы = "Форма дорожной карты по письму ФНС России от 13.03.2024 № СД-4-23/2854@ в формате 5.02";
	Стр.ДатаНачала = '20240501';
	Стр.ДатаКонца = '20991231';
	
	Возврат Результат;
КонецФункции

Функция ЭлектронноеПредставление(Объект, ИмяФормы, УникальныйИдентификатор) Экспорт
	Если ИмяФормы = "Форма2024_1" Тогда
		Возврат ЭлектронноеПредставление_Форма2024_1(Объект, УникальныйИдентификатор);
	КонецЕсли;
КонецФункции

Функция СформироватьСписокЛистов(Объект) Экспорт
	Если Объект.ИмяФормы = "Форма2020_1" Тогда 
		Возврат СформироватьСписокЛистовФорма2020_1(Объект);
	ИначеЕсли Объект.ИмяФормы = "Форма2024_1" Тогда 
		Возврат СформироватьСписокЛистовФорма2024_1(Объект);
	КонецЕсли;
КонецФункции

Функция ПроверитьДокументСВыводомВТаблицу(Объект, ИмяФормы, УникальныйИдентификатор) Экспорт 
	Если ИмяФормы = "Форма2024_1" Тогда 
		Возврат ПроверитьДокументСВыводомВТаблицу_Форма2024_1(
			УведомлениеОСпецрежимахНалогообложения.ДанныеУведомленияДляВыгрузки(Объект), УникальныйИдентификатор);
	КонецЕсли;
КонецФункции

Функция ИдентификаторФайлаЭлектронногоПредставления(СведенияОтправки)
	Префикс = "ON_DKNALMON";
	Возврат Документы.УведомлениеОСпецрежимахНалогообложения.ИдентификаторФайлаЭлектронногоПредставления(Префикс, СведенияОтправки);
КонецФункции

Функция ПроверитьДокументСВыводомВТаблицу_Форма2024_1(Данные, УникальныйИдентификатор)
	ТаблицаОшибок = Новый СписокЗначений;
	УведомлениеОСпецрежимахНалогообложения.ПроверкаАктуальностиФормыПриВыгрузке(
		Данные.Объект.ИмяФормы, ТаблицаОшибок, ПолучитьТаблицуФорм());
	
	Титульная = Данные.ДанныеУведомления.Титульная;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(Титульная.КодНО, ТаблицаОшибок, "Титульная");
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(Титульная.КодНОНМ, ТаблицаОшибок, "Титульная", "КодНОНМ");
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаГода(Титульная, ТаблицаОшибок, "Титульная", "ГодНМ", Истина);
	Если Не ЗначениеЗаполнено(Титульная.НаимОрг) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано наименование организации", "Титульная", "Наименование"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.ДАТА_ПОДПИСИ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата формирования документа", "Титульная", "ДАТА_ПОДПИСИ"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаИННКПП(Истина, Титульная, ТаблицаОшибок);
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаПодписантаНалоговойОтчетности(Данные, ТаблицаОшибок, "Титульная", Истина);
	Если Не ЗначениеЗаполнено(Титульная.Долж) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана должность подписанта", "Титульная", "Долж"));
	КонецЕсли;
	Если Титульная.ПРИЗНАК_НП_ПОДВАЛ = "2" И Не ЗначениеЗаполнено(Титульная.НаимДок) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан документ подписанта", "Титульная", "НаимДок"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.ПрДирект) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак директивы", "Титульная", "ПрДирект"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.СпосИнфВз) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"способ информационного взаимодействия", "Титульная", "СпосИнфВз"));
	КонецЕсли;
	
	ЕстьОстальныеПризнаки = Ложь;
	НомерПризнака = 0;
	Для Инд = 1 По 8 Цикл 
		Если Титульная["ПрУчаст" + Инд] Тогда 
			ЕстьОстальныеПризнаки = Истина;
			НомерПризнака = Инд;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Титульная.ПрУчаст0 И ЕстьОстальныеПризнаки Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Если указан признак ""нет"" тогда остальные признаки не указываются", "Титульная", "ПрУчаст" + НомерПризнака));
	ИначеЕсли Не Титульная.ПрУчаст0 И Не ЕстьОстальныеПризнаки Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указаны признаки участия", "Титульная", "ПрУчаст0"));
	КонецЕсли;
	
	Для Каждого Стр Из Данные.ДанныеМногостраничныхРазделов.ДорожКарта Цикл
		ДорожКарта = Стр.Значение;
		
		Если Не ЗначениеЗаполнено(ДорожКарта.РазделДК) Тогда
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан раздел дорожной карты", "ДорожКарта", "РазделДК", ДорожКарта.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДорожКарта.НаимРазделДК) Тогда
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указано наименование", "ДорожКарта", "НаимРазделДК", ДорожКарта.УИД));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Данные.ДанныеМногостраничныхРазделов.ПланМер Цикл
		ПланМер = Стр.Значение;
		
		Если Не ЗначениеЗаполнено(ПланМер.ПунктДК) Тогда
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан пункт дорожной карты", "ПланМер", "ПунктДК", ПланМер.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПланМер.НаимМер) Тогда
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указано наименование", "ПланМер", "НаимМер", ПланМер.УИД));
		КонецЕсли;
		
		Инд = 0;
		Для Каждого СтрМнг Из Данные.ДанныеДопСтрокБД.МнгСтр1.НайтиСтроки(Новый Структура("УИД", ПланМер.УИД)) Цикл
			Инд = Инд + 1;
			ИндСтр = "___" + Формат(Инд, "ЧГ=");
			
			Если Не ЗначениеЗаполнено(СтрМнг.НомерМер) Тогда
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан номер мероприятия", "ПланМер", "НомерМер" + ИндСтр, ПланМер.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрМнг.ОписанМер) Тогда
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указано описание мероприятия", "ПланМер", "ОписанМер" + ИндСтр, ПланМер.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрМнг.РезултМер) Тогда
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан результат мероприятия", "ПланМер", "РезултМер" + ИндСтр, ПланМер.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрМнг.СрокИспМер) Тогда
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан срок исполнения мероприятия", "ПланМер", "СрокИспМер" + ИндСтр, ПланМер.УИД));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрМнг.ИсполнитМер) Тогда
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан исполнитель", "ПланМер", "ИсполнитМер" + ИндСтр, ПланМер.УИД));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	УведомлениеОСпецрежимахНалогообложения.ПроверкаДатВУведомлении(Данные, ТаблицаОшибок);
	УведомлениеОСпецрежимахНалогообложения.ПолнаяПроверкаЗаполненныхПоказателейНаСоотвествиеСписку(
		"СпискиВыбора2024_1", "СхемаВыгрузкиФорма2024_1", Данные.Объект.ИмяОтчета, ТаблицаОшибок, Данные);
	Возврат ТаблицаОшибок;
КонецФункции

Функция ОсновныеСведенияЭлектронногоПредставления(Объект, УникальныйИдентификатор)
	ОсновныеСведения = Документы.УведомлениеОСпецрежимахНалогообложения.НачальнаяИнициализацияОбщихРеквизитовВыгрузки(Объект);
	ИдентификаторФайла = ИдентификаторФайлаЭлектронногоПредставления(ОсновныеСведения);
	ОсновныеСведения.Вставить("ИдФайл", ИдентификаторФайла);
	Возврат ОсновныеСведения;
КонецФункции

Процедура ДополнитьПараметры_Форма2024_1(ДанныеУведомления)
	Титульная = ДанныеУведомления.ДанныеУведомления.Титульная;
	Для Инд = 0 По 8 Цикл 
		Если Титульная["ПрУчаст" + Инд] Тогда 
			НовСтр = ДанныеУведомления.ДанныеДопСтрокБД.ВиртМнгСтр.Добавить();
			НовСтр.ПрУчаст = "" + Инд;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЭлектронноеПредставление_Форма2024_1(Объект, УникальныйИдентификатор)
	СведенияЭлектронногоПредставления = УведомлениеОСпецрежимахНалогообложения.СведенияЭлектронногоПредставления();
	ДанныеУведомления = УведомлениеОСпецрежимахНалогообложения.ДанныеУведомленияДляВыгрузки(Объект);
	ДополнитьПараметры_Форма2024_1(ДанныеУведомления);
	Ошибки = ПроверитьДокументСВыводомВТаблицу_Форма2024_1(ДанныеУведомления, УникальныйИдентификатор);
	УведомлениеОСпецрежимахНалогообложения.СообщитьОшибкиПриПроверкеВыгрузки(Объект, Ошибки, ДанныеУведомления);
	
	ОсновныеСведения = ОсновныеСведенияЭлектронногоПредставления(Объект, УникальныйИдентификатор);
	СтруктураВыгрузки = Документы.УведомлениеОСпецрежимахНалогообложения.ИзвлечьСтруктуруXMLУведомления(Объект.ИмяОтчета, "СхемаВыгрузкиФорма2024_1");
	УведомлениеОСпецрежимахНалогообложения.ТиповоеЗаполнениеДанными(ДанныеУведомления, ОсновныеСведения, СтруктураВыгрузки);
	УведомлениеОСпецрежимахНалогообложения.ВыгрузитьДеревоВТаблицу(СтруктураВыгрузки, ОсновныеСведения, СведенияЭлектронногоПредставления);
	Возврат СведенияЭлектронногоПредставления;
КонецФункции

Функция СформироватьСписокЛистовФорма2020_1(Объект) Экспорт
	СписокИспользуемыхМакетов = УведомлениеОСпецрежимахНалогообложения.ЗагрузитьМакетыИзАрхива(Объект, , "ТабличныеДокументы");
	Листы = Новый СписокЗначений;
	СохраненныеДанные = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеУведомления").Получить();
	
	ПечатнаяФорма = УведомлениеОСпецрежимахНалогообложения.НовыйПустойЛист();
	ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "Титульная_2020"));
	УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, СохраненныеДанные.ДанныеУведомления.Титульная);
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 1);
	
	НомСтр = 1;
	Для Каждого Стр1 Из СохраненныеДанные.ДанныеМногостраничныхРазделов.ДорожКарта Цикл 
		НомСтр = НомСтр + 1;
		ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "ДорожКарта_2020"));
		УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, Стр1.Значение);
		
		Для Каждого Стр2 Из СохраненныеДанные.ДанныеМногостраничныхРазделов.ПланМер Цикл
			Если Стр2.Значение.УИДРодителя <> Стр1.Значение.УИД Тогда 
				Продолжить;
			КонецЕсли;
			
			ТабДок = УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(
				Объект, СписокИспользуемыхМакетов, "ПланМер_2020").ПолучитьОбласть("ОсновнаяЧасть");
			УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ТабДок, Стр2.Значение);
			ПечатнаяФорма.Вывести(ТабДок);
			ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(
				Объект, СписокИспользуемыхМакетов, "ПланМер_2020").ПолучитьОбласть("Header_МнгСтр1"));
			
			Для Каждого Стр3 Из СохраненныеДанные.ДанныеДопСтрокБД.МнгСтр1.НайтиСтроки(Новый Структура("УИД", Стр2.Значение.УИД)) Цикл 
				ТабДок = УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(
					Объект, СписокИспользуемыхМакетов, "ПланМер_2020").ПолучитьОбласть("Str_МнгСтр1");
				УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(
					ТабДок, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Стр3));
				ПечатнаяФорма.Вывести(ТабДок);
			КонецЦикла;
		КонецЦикла;
		
		УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, НомСтр);
	КонецЦикла;
	
	Возврат Листы;
КонецФункции

Функция СформироватьСписокЛистовФорма2024_1(Объект) Экспорт
	Листы = Новый СписокЗначений;
	ПечатнаяФорма = УведомлениеОСпецрежимахНалогообложения.НовыйПустойЛист();
	МакетПФ = Отчеты[Объект.ИмяОтчета].ПолучитьМакет("ПечатныйБланк_2024");
	Заголовок = МакетПФ.ПолучитьОбласть("Заголовок");
	Строка = МакетПФ.ПолучитьОбласть("Строка");
	Подвал = МакетПФ.ПолучитьОбласть("Подвал");
	
	ДанныеУведомления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеУведомления").Получить();
	Титульная = ДанныеУведомления.ДанныеУведомления.Титульная;
	ЗаполнитьЗначенияСвойств(Заголовок.Параметры, Титульная);
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.ИНН, "ИНН", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КПП, "КПП", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КодНО, "КодНО", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КодНОНМ, "КодНОНМ", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.ГодНМ, "ГодНМ", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.ВерсДК, "ВерсДК", Заголовок.Области, "-");
	
	Заголовок.Области.ПрДиректДа.Текст = ?(Титульная.ПрДирект = "1", "V", "");
	Заголовок.Области.ПрДиректНет.Текст = ?(Титульная.ПрДирект = "2", "V", "");
	Заголовок.Параметры.Наименование = Титульная.НаимОрг;
	Заголовок.Параметры.НаименованиеНО = "ИФНС " + Титульная.КодНО;
	
	ПрУчаст = "";
	Для Итер = 0 По 8 Цикл 
		Если Титульная["ПрУчаст" + Итер] Тогда 
			ПрУчаст = ПрУчаст + ?(ЗначениеЗаполнено(ПрУчаст), ",", "") + Итер;
		КонецЕсли;
	КонецЦикла;
	Заголовок.Параметры.ПрУчаст = ПрУчаст;
	Если Титульная.СпосИнфВз = "1" Тогда 
		Заголовок.Параметры.СпособВзаимодействия = "удаленный доступ в информационную систему (ИС)";
	ИначеЕсли Титульная.СпосИнфВз = "2" Тогда 
		Заголовок.Параметры.СпособВзаимодействия = "аналитическая витрина";
	ИначеЕсли Титульная.СпосИнфВз = "3" Тогда 
		Заголовок.Параметры.СпособВзаимодействия = "телекоммуникационный канал связи (ТКС)";
	КонецЕсли;
	ПечатнаяФорма.Вывести(Заголовок);
	
	Для Каждого Стр Из ДанныеУведомления.ДанныеМногостраничныхРазделов.ПланМер Цикл 
		ПланМер = Стр.Значение;
		ДанныеУведомления.ДанныеДопСтрокБД.МнгСтр1.НайтиСтроки(Новый Структура("УИД", ПланМер.УИД));
		Для Каждого СтрМнг Из ДанныеУведомления.ДанныеДопСтрокБД.МнгСтр1.НайтиСтроки(Новый Структура("УИД", ПланМер.УИД)) Цикл
			Строка.Параметры.НаимМер = ПланМер.НаимМер;
			ЗаполнитьЗначенияСвойств(Строка.Параметры, СтрМнг);
			ПечатнаяФорма.Вывести(Строка);
		КонецЦикла;
	КонецЦикла;
	
	Подвал.Параметры.Дата = Формат(Титульная.ДАТА_ПОДПИСИ, "ДЛФ=DD");
	Подвал.Параметры.Документ = Титульная.НаимДок;
	Подвал.Параметры.Должность = "" + Титульная.ФИО_РУКОВОДИТЕЛЯ_ПРЕДСТАВИТЕЛЯ + ", " + Титульная.Долж;
	ПечатнаяФорма.Вывести(Подвал);
	
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 1, Ложь);
	Возврат Листы;
КонецФункции

#КонецОбласти
#КонецЕсли
