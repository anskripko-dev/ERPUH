&НаСервереБезКонтекста
Функция ПолучитьСписокВерсийДоТекущей(Версия)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ОписаниеВерсий.Аналитика1 КАК Аналитика1,
	|	ОписаниеВерсий.Аналитика2 КАК Аналитика2,
	|	ОписаниеВерсий.Аналитика3 КАК Аналитика3,
	|	ОписаниеВерсий.Аналитика4 КАК Аналитика4,
	|	ОписаниеВерсий.Аналитика5 КАК Аналитика5,
	|	ОписаниеВерсий.Аналитика6 КАК Аналитика6,
	|	ОписаниеВерсий.ВидОтчета КАК ВидОтчета,
	|	ОписаниеВерсий.Организация КАК Организация,
	|	ОписаниеВерсий.ПериодОтчета КАК ПериодОтчета,
	|	ОписаниеВерсий.Проект КАК Проект,
	|	ОписаниеВерсий.Сценарий КАК Сценарий,
	|	ОписаниеВерсий.Код КАК Код
	|ПОМЕСТИТЬ ТабТекущаяВерсия
	|ИЗ
	|	Справочник.ОписаниеВерсий КАК ОписаниеВерсий
	|ГДЕ
	|	ОписаниеВерсий.Ссылка = &ОписаниеВерсий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОписаниеВерсий.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОписаниеВерсий КАК ОписаниеВерсий
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабТекущаяВерсия КАК ТабТекущаяВерсия
	|		ПО ОписаниеВерсий.ВидОтчета = ТабТекущаяВерсия.ВидОтчета
	|			И ОписаниеВерсий.Организация = ТабТекущаяВерсия.Организация
	|			И ОписаниеВерсий.ПериодОтчета = ТабТекущаяВерсия.ПериодОтчета
	|			И ОписаниеВерсий.Сценарий = ТабТекущаяВерсия.Сценарий
	|			И ОписаниеВерсий.Проект = ТабТекущаяВерсия.Проект
	|			И ОписаниеВерсий.Аналитика1 = ТабТекущаяВерсия.Аналитика1
	|			И ОписаниеВерсий.Аналитика2 = ТабТекущаяВерсия.Аналитика2
	|			И ОписаниеВерсий.Аналитика3 = ТабТекущаяВерсия.Аналитика3
	|			И ОписаниеВерсий.Аналитика4 = ТабТекущаяВерсия.Аналитика4
	|			И ОписаниеВерсий.Аналитика5 = ТабТекущаяВерсия.Аналитика5
	|			И ОписаниеВерсий.Аналитика6 = ТабТекущаяВерсия.Аналитика6
	|			И ОписаниеВерсий.Код <= ТабТекущаяВерсия.Код";
	
	Запрос.УстановитьПараметр("ОписаниеВерсий",Версия.Владелец);
	
	СписокВерсий=Новый СписокЗначений;
	СписокВерсий.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокВерсий;
	
	
КонецФункции // ПолучитьСписокВерсийДоТекущей() 


