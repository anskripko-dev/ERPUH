Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Перем ДокументИсточник;
	
	ПараметрыДанныхСКД = КомпоновщикНастроек.ПолучитьНастройки().ПараметрыДанных;
	
	ЗначениеГраница = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ГраницаДоДокумента"));
	Если (ЗначениеГраница <> Неопределено) И Не ЗначениеЗаполнено(ЗначениеГраница.Значение) Тогда
		
		ДатаРасчета = ПараметрыДанныхСКД.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаРасчета")).Значение;
		Если КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("ДокументИсточник", ДокументИсточник) Тогда
			ЗначениеГраница.Значение = МСФОВызовСервераУХ.ПолучитьГраницуДоДокумента(ДатаРасчета, ДокументИсточник.Ссылка);
		Иначе 
			ЗначениеГраница.Значение = ДатаРасчета;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("ДокументИсточник") Тогда // покажем реквизит реквизит ВНА
		ЗначениеПараметраСКД = ПараметрыДанныхСКД.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВНА"));
		Если (КомпоновщикНастроек <> Неопределено) Или Не ЗначениеЗаполнено(КомпоновщикНастроек.Значение) Тогда
			КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВсеВНА", Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если Не КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("ДокументИсточник") Тогда // покажем реквизит реквизит ВНА
		ЗначениеПараметраСКД = ПараметрыДанныхСКД.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВНА"));
		Если (КомпоновщикНастроек <> Неопределено) Или Не ЗначениеЗаполнено(КомпоновщикНастроек.Значение) Тогда
			КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВсеВНА", Истина);
		КонецЕсли;
	КонецЕсли;

	СхемаКомпоновкиДанных.НаборыДанных.Получить(0).Запрос = Отчеты.ПараметрыВНА.ТекстЗапроса_ПараметрыВНА(Неопределено);
	
	//ТиповыеОтчетыУХ.МакетКомпоновкиВXML(ТиповыеОтчетыУХ.ПолучитьМакетКомпоновкиДанныхКоллекции(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки()));
		
КонецПроцедуры
