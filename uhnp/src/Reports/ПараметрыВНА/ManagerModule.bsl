
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ТекстЗапроса_ПараметрыВНА(КонтекстЗапроса = Неопределено, ТаблицаДляПомещения = Неопределено, ЕстьТУВНА = Ложь) Экспорт 

	НомераТаблиц = ?(ЗначениеЗаполнено(КонтекстЗапроса), КонтекстЗапроса.НомераТаблиц, Новый Структура);
	ТекстЗапроса = ?(ЗначениеЗаполнено(КонтекстЗапроса), КонтекстЗапроса.ТекстЗапроса, Новый Массив);
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втСтоимостьВНАПУ(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втРазделыВНА(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаТрансляцииВНА(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПараметрыУчетаВНАМСФО(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСтоимостьВНАМСФО(НомераТаблиц, ЕстьТУВНА));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПараметрыАмортизацииВНАМСФО(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втВыработкаВНА(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втБазыРасчета(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_ТаблицаПараметрыВНА(НомераТаблиц, ТаблицаДляПомещения));
	
	Возврат СтрСоединить(ТекстЗапроса, ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета());

КонецФункции

Процедура ЗаполнитьПараметрыЗапроса(Запрос, ДокументДата, ДокументСсылка, АлгоритмРСБУ = Неопределено) Экспорт

	ПараметрыЗапроса = ПолучитьДатыЗапросаПараметровВНА(ДокументДата, ДокументСсылка, АлгоритмРСБУ);
	
	Для каждого ТекущийПараметр Из ПараметрыЗапроса Цикл	
		Запрос.УстановитьПараметр(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыСКД(НастройкиСКД, ДокументДата, ДокументСсылка, АлгоритмРСБУ = Неопределено) Экспорт

	ПараметрыЗапроса = ПолучитьДатыЗапросаПараметровВНА(ДокументДата, ДокументСсылка, АлгоритмРСБУ);
	
	Для каждого ТекущийПараметр Из ПараметрыЗапроса Цикл	
		НастройкиСКД.ПараметрыДанных.УстановитьЗначениеПараметра(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

#Область ТекстЗапроса

Функция ТекстЗапроса_втСтоимостьВНАПУ(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСтоимостьВНАПУ", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	втСтоимость.ВНА КАК ВНА,
	|	втСтоимость.ГруппаВНА КАК ГруппаВНА,
	|	втСтоимость.ВидУчета КАК ВидУчета,
	|	втСтоимость.СуммаВВалютеУчетаОборот КАК СуммаВВалютеУчета,
	|	втСтоимость.АмортизацияОборот КАК Амортизация,
	|	втСтоимость.ПереоценкаОборот КАК Переоценка,
	|	втСтоимость.ОбесценениеОборот КАК Обесценение,
	|	втСтоимость.ПереоценкаАмортизацииОборот КАК ПереоценкаАмортизации,
	|	втСтоимость.РезервПереоценкиОборот КАК РезервПереоценки,
	|	втСтоимость.КоличествоОборот КАК Количество
	|ПОМЕСТИТЬ втСтоимостьВНАПУ
	|ИЗ
	|	РегистрНакопления.СтоимостьВНАМСФО.Обороты(
	|			,
	|			&ГраницаДоДокумента {(&ГраницаДоДокумента)},
	|			,
	|			Сценарий = &Сценарий
	|				И ВЫБОР
	|					КОГДА &ВсеОрганизации
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Организация В (&Организация)
	|				КОНЕЦ
	|				И ВидУчета В (&ВидыУчета)
	|				И ВЫБОР
	|					КОГДА &ВсеВНА
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ВНА В (&ВНА)
	|				КОНЕЦ) КАК втСтоимость
	|ГДЕ
	|	втСтоимость.СуммаВВалютеУчетаОборот <> 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА,
	|	ГруппаВНА,
	|	ВидУчета";
	
КонецФункции

Функция ТекстЗапроса_втРазделыВНА(НомераТаблиц)
	
	НомераТаблиц.Вставить("втРазделыВНА", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК РазделПланаСчетов,
	|	ИСТИНА КАК ЭтоВНА
	|ПОМЕСТИТЬ втРазделыВНА
	|ИЗ
	|	Справочник.РазделыПланаСчетов КАК т
	|ГДЕ
	|	т.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ВнеоборотныеАктивы), ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.НезавершенноеСтроительство))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Ссылка,
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.РазделыПланаСчетов КАК т
	|ГДЕ
	|	т.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.Капитал))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РазделПланаСчетов";

КонецФункции

Функция ТекстЗапроса_втСчетаТрансляцииВНА(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСчетаТрВНА", НомераТаблиц.Количество());
	
	// ОВНА - счет обесценения ВНА, отличается от счета переоценки(ПВНА), тем что используется в настройках обесценения
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.Ссылка КАК Счет,
	|	т.СчетСсылка КАК СчетСсылка,
	|	ВЫБОР
	|		КОГДА &Тип1
	|			ТОГДА 1
	|		КОГДА &Тип2
	|			ТОГДА 2
	|		КОГДА &Тип3
	|			ТОГДА 3
	|	КОНЕЦ КАК НомерСубконтоВНА,
	|	ВЫБОР
	|		КОГДА втРазделыВНА.ЭтоВНА
	|				И т.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовБД.Пассивный)
	|			ТОГДА ""АВНА""
	|		КОГДА втРазделыВНА.ЭтоВНА
	|				И т.Вид <> ЗНАЧЕНИЕ(Перечисление.ВидыСчетовБД.Пассивный)
	|			ТОГДА ""ВНА""
	|		КОГДА т.Ссылка В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					п.СчетНакопленногоОбесценения
	|				ИЗ
	|					Справочник.ПараметрыОбесцененияВНАМСФО КАК п
	|				ГДЕ
	|					НЕ п.ПометкаУдаления)
	|			ТОГДА ""ОВНА""
	|		ИНАЧЕ ""ПВНА""
	|	КОНЕЦ КАК РольСчета
	|ПОМЕСТИТЬ втСчетаТрВНА
	|ИЗ
	|	Справочник.СчетаБД КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРазделыВНА КАК втРазделыВНА
	|		ПО т.РазделПланаСчетов = втРазделыВНА.РазделПланаСчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидСубконто1
	|		ПО т.Ссылка = ВидСубконто1.Ссылка
	|			И (ВидСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидСубконто2
	|		ПО т.Ссылка = ВидСубконто2.Ссылка
	|			И (ВидСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидСубконто3
	|		ПО т.Ссылка = ВидСубконто3.Ссылка
	|			И (ВидСубконто3.НомерСтроки = 3)
	|ГДЕ
	|	т.Владелец В
	|			(ВЫБРАТЬ
	|				пс.Ссылка
	|			ИЗ
	|				Справочник.ПланыСчетовБД КАК пс
	|			ГДЕ
	|				пс.ПланСчетовМСФО
	|				И пс.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетСсылка,
	|	НомерСубконтоВНА";
	
	ШаблонПодобно = "ВидСубконто_1.ТипДанных ПОДОБНО ""%._2%"" ";
	ШаблонСубконто = Новый Массив;
	ТипыВНА = Метаданные.ОпределяемыеТипы.ВНА.Тип.Типы();
	Для каждого ТипВНА Из ТипыВНА Цикл
		ИмяВНА = Метаданные.НайтиПоТипу(ТипВНА).Имя;
		ШаблонСубконто.Добавить(СтрЗаменить(ШаблонПодобно, "_2", ИмяВНА));
	КонецЦикла;
	Шаблон = СтрСоединить(ШаблонСубконто, " ИЛИ ");
	
	Для НомерСубконто = 1 По 3 Цикл
		Замена = СтрЗаменить(Шаблон, "_1", НомерСубконто);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Тип" + НомерСубконто, Замена);
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_втПараметрыУчетаВНАМСФО(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПараметрыУчетаВНАМСФО", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	ПараметрыУчета.ВНА КАК ВНА,
	|	ПараметрыУчета.ГруппаВНА КАК ГруппаВНА,
	|	ПараметрыУчета.ВидУчета КАК ВидУчета,
	|	ПараметрыУчета.СпособПоступления КАК СпособПоступления,
	|	ПараметрыУчета.СчетУчетаПервоначальнойСтоимости КАК СчетУчетаПервоначальнойСтоимости,
	|	ПараметрыУчета.СчетУчетаПервоначальнойСтоимостиСубконто1 КАК СчетУчетаПервоначальнойСтоимостиСубконто1,
	|	ПараметрыУчета.СчетУчетаПервоначальнойСтоимостиСубконто2 КАК СчетУчетаПервоначальнойСтоимостиСубконто2,
	|	ПараметрыУчета.СчетУчетаПервоначальнойСтоимостиСубконто3 КАК СчетУчетаПервоначальнойСтоимостиСубконто3,
	|	ПараметрыУчета.СчетНакопленнойАмортизации КАК СчетНакопленнойАмортизации,
	|	ПараметрыУчета.СчетНакопленнойАмортизацииСубконто1 КАК СчетНакопленнойАмортизацииСубконто1,
	|	ПараметрыУчета.СчетНакопленнойАмортизацииСубконто2 КАК СчетНакопленнойАмортизацииСубконто2,
	|	ПараметрыУчета.СчетНакопленнойАмортизацииСубконто3 КАК СчетНакопленнойАмортизацииСубконто3,
	|	ПараметрыУчета.Период КАК ДатаВвода,
	|	ПараметрыУчета.Регистратор КАК ДокументВвода,
	|	ПараметрыУчета.Подразделение КАК Подразделение,
	|	ПараметрыУчета.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втПараметрыУчетаВНАМСФО
	|ИЗ
	|	РегистрСведений.ПараметрыУчетаВНАМСФО.СрезПоследних(
	|			&ГраницаДоДокумента {(&ГраницаДоДокумента)},
	|			ВЫБОР
	|					КОГДА &ВсеОрганизации
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Организация В (&Организация)
	|				КОНЕЦ
	|				И Сценарий = &Сценарий
	|				И ВидУчета В (&ВидыУчета)
	|				И ВНА В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						втСтоимостьВНАПУ.ВНА
	|					ИЗ
	|						втСтоимостьВНАПУ КАК втСтоимостьВНАПУ)) КАК ПараметрыУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПараметрыУчета.ВНА,
	|	ПараметрыУчета.ВидУчета,
	|	ПараметрыУчета.ГруппаВНА";
	
КонецФункции

Функция ТекстЗапроса_втСтоимостьВНАМСФО(НомераТаблиц, ЕстьТУВНА = Ложь)
	
	НомераТаблиц.Вставить("втСтоимостьВНАМСФО", НомераТаблиц.Количество());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.ВНА КАК ВНА,
	|	т.ГруппаВНА КАК ГруппаВНА,
	|	т.ВидУчета КАК ВидУчета,
	|	т.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	т.Амортизация КАК Амортизация,
	|	т.Переоценка КАК Переоценка,
	|	т.Обесценение КАК Обесценение,
	|	т.ПереоценкаАмортизации КАК ПереоценкаАмортизации,
	|	т.РезервПереоценки КАК РезервПереоценки,
	|	т.Количество КАК Количество,
	|	п.ДокументВвода КАК ДокументВвода,
	|	п.Подразделение КАК Подразделение,
	|	п.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	п.СпособПоступления КАК СпособПоступления,
	|	п.ДатаВвода КАК ДатаВвода,
	|	п.СчетУчетаПервоначальнойСтоимости КАК СчетУчетаПервоначальнойСтоимости,
	|	п.СчетУчетаПервоначальнойСтоимостиСубконто1 КАК СчетУчетаПервоначальнойСтоимостиСубконто1,
	|	п.СчетУчетаПервоначальнойСтоимостиСубконто2 КАК СчетУчетаПервоначальнойСтоимостиСубконто2,
	|	п.СчетУчетаПервоначальнойСтоимостиСубконто3 КАК СчетУчетаПервоначальнойСтоимостиСубконто3,
	|	п.СчетНакопленнойАмортизации КАК СчетНакопленнойАмортизации,
	|	п.СчетНакопленнойАмортизацииСубконто1 КАК СчетНакопленнойАмортизацииСубконто1,
	|	п.СчетНакопленнойАмортизацииСубконто2 КАК СчетНакопленнойАмортизацииСубконто2,
	|	п.СчетНакопленнойАмортизацииСубконто3 КАК СчетНакопленнойАмортизацииСубконто3
	|ПОМЕСТИТЬ втСтоимостьВНАМСФО
	|ИЗ
	|	втСтоимостьВНАПУ КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПараметрыУчетаВНАМСФО КАК п
	|		ПО т.ВНА = п.ВНА
	|			И т.ГруппаВНА = п.ГруппаВНА
	|			И т.ВидУчета = п.ВидУчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР втСчетаТрВНА.НомерСубконтоВНА
	|		КОГДА 1
	|			ТОГДА т.Субконто1
	|		КОГДА 2
	|			ТОГДА т.Субконто2
	|		КОГДА 3
	|			ТОГДА т.Субконто3
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Справочник.ГруппыВНАМСФО.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.ВидыУчета.МСФО),
	|	СУММА(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ВНА""
	|				ТОГДА т.СуммаВВалютеУчетаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""АВНА""
	|				ТОГДА т.СуммаВВалютеУчетаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ПВНА""
	|				ТОГДА т.СуммаВВалютеУчетаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ОВНА""
	|				ТОГДА т.СуммаВВалютеУчетаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	0,
	|	0,
	|	ЕСТЬNULL(СУММА(т.КоличествоОстаток), 1),
	|	НЕОПРЕДЕЛЕНО,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(Перечисление.СпособыПоступленияОбъектовВНА.Приобретено),
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ВНА""
	|				ТОГДА втСчетаТрВНА.Счет
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ВНА""
	|				ТОГДА т.Субконто1
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ВНА""
	|				ТОГДА т.Субконто2
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ВНА""
	|				ТОГДА т.Субконто3
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""АВНА""
	|				ТОГДА втСчетаТрВНА.Счет
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""АВНА""
	|				ТОГДА т.Субконто1
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""АВНА""
	|				ТОГДА т.Субконто2
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ВНА""
	|				ТОГДА т.Субконто3
	|		КОНЕЦ)
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(
	|			&ГраницаДоДокумента {(&ГраницаДоДокумента)},
	|			Счет В
	|				(ВЫБРАТЬ
	|					втСчетаТрВНА.СчетСсылка
	|				ИЗ
	|					втСчетаТрВНА КАК втСчетаТрВНА
	|				ГДЕ
	|					втСчетаТрВНА.НомерСубконтоВНА > 0),
	|			,
	|			Сценарий = &Сценарий
	|				И &ЕстьТУВНА
	|				И ВЫБОР
	|					КОГДА &ВсеОрганизации
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Организация В (&Организация)
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ВсеВНА
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Субконто1 В (&ВНА)
	|				КОНЕЦ
	|				И НЕ Субконто1 В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							т.ВНА
	|						ИЗ
	|							втСтоимостьВНАПУ КАК т)
	|				И НЕ Субконто2 В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							т.ВНА
	|						ИЗ
	|							втСтоимостьВНАПУ КАК т)
	|				И НЕ Субконто3 В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							т.ВНА
	|						ИЗ
	|							втСтоимостьВНАПУ КАК т)) КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетаТрВНА КАК втСчетаТрВНА
	|		ПО т.Счет = втСчетаТрВНА.СчетСсылка
	|ГДЕ
	|	ВЫБОР втСчетаТрВНА.НомерСубконтоВНА
	|			КОГДА 1
	|				ТОГДА т.Субконто1
	|			КОГДА 2
	|				ТОГДА т.Субконто2
	|			КОГДА 3
	|				ТОГДА т.Субконто3
	|		КОНЕЦ <> НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР втСчетаТрВНА.НомерСубконтоВНА
	|		КОГДА 1
	|			ТОГДА т.Субконто1
	|		КОГДА 2
	|			ТОГДА т.Субконто2
	|		КОГДА 3
	|			ТОГДА т.Субконто3
	|	КОНЕЦ,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|			КОГДА втСчетаТрВНА.РольСчета = ""ВНА""
	|				ТОГДА т.СуммаВВалютеУчетаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) <> 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА,
	|	ВидУчета";
	
	Возврат СтрЗаменить(ТекстЗапроса, "&ЕстьТУВНА", ?(ЕстьТУВНА, "ИСТИНА", "ЛОЖЬ"));
	
КонецФункции

Функция ТекстЗапроса_втПараметрыАмортизацииВНАМСФО(НомераТаблиц)

	НомераТаблиц.Вставить("втПараметрыАмортизацииВНАМСФО", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	т.ВНА КАК ВНА,
	|	т.ВидУчета КАК ВидУчета,
	|	т.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ВЫБОР
	|		КОГДА НЕ т.НачислятьАмортизацию
	|			ТОГДА ЛОЖЬ
	|		КОГДА т.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияАмортизацииВНА.ПропорциональноОбъемуПродукции)
	|			ТОГДА ИСТИНА
	|		КОГДА т.СрокИспользованияДляВычисленияАмортизации > (ВЫРАЗИТЬ(т.СрокИспользованияДляВычисленияАмортизации КАК ЧИСЛО(18, 0)))
	|			ТОГДА ДОБАВИТЬКДАТЕ(т.Период, МЕСЯЦ, 1 + (ВЫРАЗИТЬ(т.СрокИспользованияДляВычисленияАмортизации КАК ЧИСЛО(18, 0)))) >= &ДатаРасчета
	|		КОГДА НЕ &АлгоритмРСБУ
	|			ТОГДА ДОБАВИТЬКДАТЕ(т.Период, МЕСЯЦ, (ВЫРАЗИТЬ(т.СрокИспользованияДляВычисленияАмортизации КАК ЧИСЛО(18, 0)))) >= &ДатаНачалаПериодаДокумента
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(т.Период, МЕСЯЦ, ВЫРАЗИТЬ(т.СрокИспользованияДляВычисленияАмортизации КАК ЧИСЛО(18, 0))) >= &ДатаРасчета
	|	КОНЕЦ КАК НачислятьАмортизацию,
	|	т.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	т.ЛиквидационнаяСтоимость КАК ЛиквидационнаяСтоимость,
	|	т.КоэффициентУскорения КАК КоэффициентУскорения,
	|	т.СпособОтраженияРасходовПоАмортизации КАК ПрофильРаспределения,
	|	т.СтоимостьДляВычисленияАмортизации КАК СтоимостьДляВычисленияАмортизации,
	|	т.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
	|	т.ОбъемПродукцииРабот КАК ОбъемПродукцииРабот,
	|	т.ПараметрыАмортизации КАК ПараметрыАмортизации,
	|	т.ПараметрВыработки КАК ПараметрВыработки,
	|	ВЫБОР
	|		КОГДА т.Регистратор ССЫЛКА Документ.ВыбытиеВНАМСФО
	|			ТОГДА т.Период
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ДатаВыбытия,
	|	т.Период КАК ДатаПоследнегоСобытия,
	|	ВЫБОР
	|		КОГДА т.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияАмортизацииВНА.ПропорциональноОбъемуПродукции)
	|			ТОГДА ЛОЖЬ
	|		КОГДА т.СрокИспользованияДляВычисленияАмортизации > (ВЫРАЗИТЬ(т.СрокИспользованияДляВычисленияАмортизации КАК ЧИСЛО(18, 0)))
	|			ТОГДА ДОБАВИТЬКДАТЕ(т.Период, МЕСЯЦ, 1 + (ВЫРАЗИТЬ(т.СрокИспользованияДляВычисленияАмортизации КАК ЧИСЛО(18, 0)))) МЕЖДУ &ДатаНачалаПериодаДокумента И КОНЕЦПЕРИОДА(&ДатаНачалаПериодаДокумента, МЕСЯЦ)
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(т.Период, МЕСЯЦ, ВЫРАЗИТЬ(т.СрокИспользованияДляВычисленияАмортизации КАК ЧИСЛО(18, 0))) МЕЖДУ &ДатаНачалаПериодаДокумента И КОНЕЦПЕРИОДА(&ДатаНачалаПериодаДокумента, МЕСЯЦ)
	|	КОНЕЦ КАК ЭтоПоследнийПериодНачисления,
	|	т.Период >= &ДатаНачалаПериодаДокумента КАК ЕстьИзмененияМесяца,
	|	ВЫБОР
	|		КОГДА т.Регистратор ССЫЛКА Документ.ВыбытиеВНАМСФО
	|			ТОГДА т.Регистратор
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ДокументВыбытия,
	|	т.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ втПараметрыАмортизацииВНАМСФО
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииВНАМСФО.СрезПоследних(
	|			&ГраницаДоДокумента {(&ГраницаДоДокумента)},
	|			ВЫБОР
	|					КОГДА &ВсеОрганизации
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Организация В (&Организация)
	|				КОНЕЦ
	|				И Сценарий = &Сценарий
	|				И ВидУчета В (&ВидыУчета)
	|				И ВНА В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						втСтоимостьВНАМСФО.ВНА
	|					ИЗ
	|						втСтоимостьВНАМСФО КАК втСтоимостьВНАМСФО)) КАК т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидУчета,
	|	ВНА,
	|	СпособНачисленияАмортизации";
	
КонецФункции

Функция ТекстЗапроса_втВыработкаВНА(НомераТаблиц)

	НомераТаблиц.Вставить("втВыработкаВНА", НомераТаблиц.Количество());

	Возврат	
	"ВЫБРАТЬ
	|	ВыработкаВНА.ВНА КАК ВНА,
	|	ВыработкаВНА.ПараметрВыработки КАК ПараметрВыработки,
	|	ВыработкаВНА.ВидУчета КАК ВидУчета,
	|	СУММА(ВыработкаВНА.КоличествоОборот) КАК Количество
	|ПОМЕСТИТЬ втВыработкаВНА
	|ИЗ
	|	РегистрНакопления.ВыработкаВНА.Обороты(
	|			НАЧАЛОПЕРИОДА(&ДатаНачалаПериодаДокумента, МЕСЯЦ) {(НАЧАЛОПЕРИОДА(&ДатаНачалаПериодаДокумента, МЕСЯЦ)) КАК ПериодВыработка},
	|			КОНЕЦПЕРИОДА(&ДатаНачалаПериодаДокумента, МЕСЯЦ){(КОНЕЦПЕРИОДА(&ДатаНачалаПериодаДокумента, МЕСЯЦ)) КАК ПериодВыработка},
	|			ДЕНЬ,
	|			Сценарий = &Сценарий
	|				И Организация = &Организация) КАК ВыработкаВНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПараметрыАмортизацииВНАМСФО КАК втПоследниеСобытия
	|		ПО ВыработкаВНА.ВНА = втПоследниеСобытия.ВНА
	|			И (втПоследниеСобытия.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.МСФО))
	|ГДЕ
	|	ВЫБОР
	|			КОГДА НЕ ЕСТЬNULL(втПоследниеСобытия.ЕстьИзмененияМесяца, ЛОЖЬ)
	|				ТОГДА ИСТИНА
	|			КОГДА &АлгоритмРСБУ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВыработкаВНА.Период МЕЖДУ втПоследниеСобытия.ДатаПоследнегоСобытия И &ДатаРасчета
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыработкаВНА.ВНА,
	|	ВыработкаВНА.ПараметрВыработки,
	|	ВыработкаВНА.ВидУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВыработкаВНА.ВНА,
	|	ВыработкаВНА.ПараметрВыработки,
	|	ВыработкаВНА.ВидУчета";
	
КонецФункции

Функция ТекстЗапроса_втБазыРасчета(НомераТаблиц)
	
	НомераТаблиц.Вставить("втБазыРасчета", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	втПараметрыУчетаВНАМСФО.ВНА КАК ВНА,
	|	втПараметрыУчетаВНАМСФО.ГруппаВНА КАК ГруппаВНА,
	|	ВЫБОР
	|		КОГДА втПараметрыАмортизацииВНАМСФО.НачислятьАмортизацию = ЛОЖЬ
	|			ТОГДА 0
	|		КОГДА втПараметрыАмортизацииВНАМСФО.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияАмортизацииВНА.Линейный)
	|			ТОГДА ВЫБОР
	|					КОГДА &АлгоритмРСБУ
	|						ТОГДА втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации
	|					ИНАЧЕ РАЗНОСТЬДАТ(&ДатаРасчета, ДОБАВИТЬКДАТЕ(&ДатаРасчета, МЕСЯЦ, ЦЕЛ(втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации)), ДЕНЬ) + ОКР(30 * (втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации - ЦЕЛ(втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации)), 0)
	|				КОНЕЦ
	|		КОГДА втПараметрыАмортизацииВНАМСФО.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияАмортизацииВНА.ПропорциональноОбъемуПродукции)
	|			ТОГДА ЕСТЬNULL(втПараметрыАмортизацииВНАМСФО.ОбъемПродукцииРабот, 0)
	|		КОГДА втПараметрыАмортизацииВНАМСФО.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияАмортизацииВНА.УменьшаемогоОстатка)
	|			ТОГДА ВЫБОР
	|					КОГДА &АлгоритмРСБУ
	|						ТОГДА втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации
	|					ИНАЧЕ РАЗНОСТЬДАТ(&ДатаРасчета, ДОБАВИТЬКДАТЕ(&ДатаРасчета, МЕСЯЦ, ЦЕЛ(втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации)), ДЕНЬ) + ОКР(30 * (втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации - ЦЕЛ(втПараметрыАмортизацииВНАМСФО.СрокИспользованияДляВычисленияАмортизации)), 0)
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК БазаРасчета,
	|	втВыработкаВНА.Количество КАК Количество
	|ПОМЕСТИТЬ втБазыРасчета
	|ИЗ
	|	втПараметрыАмортизацииВНАМСФО КАК втПараметрыАмортизацииВНАМСФО
	|		{ЛЕВОЕ СОЕДИНЕНИЕ втВыработкаВНА КАК втВыработкаВНА
	|		ПО втПараметрыАмортизацииВНАМСФО.ВНА = втВыработкаВНА.ВНА
	|			И втПараметрыАмортизацииВНАМСФО.ВидУчета = втВыработкаВНА.ВидУчета
	|			И втПараметрыАмортизацииВНАМСФО.ПараметрВыработки = втВыработкаВНА.ПараметрВыработки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПараметрыУчетаВНАМСФО КАК втПараметрыУчетаВНАМСФО
	|		ПО втПараметрыАмортизацииВНАМСФО.ВНА = втПараметрыУчетаВНАМСФО.ВНА
	|			И (втПараметрыАмортизацииВНАМСФО.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.МСФО))
	|			И (втПараметрыУчетаВНАМСФО.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.МСФО))}
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВНА,
	|	ГруппаВНА";
	
КонецФункции

Функция ТекстЗапроса_ТаблицаПараметрыВНА(НомераТаблиц, ТаблицаДляПомещения = Неопределено)

	НомераТаблиц.Вставить("ТаблицаПараметрыВНА", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	втСтоимостьВНАМСФО.ВНА КАК ВНА,
	|	втСтоимостьВНАМСФО.ВидУчета КАК ВидУчета,
	|	втСтоимостьВНАМСФО.ГруппаВНА КАК ГруппаВНА,
	|	ЕСТЬNULL(втПараметрыАмортизацииВНАМСФО.НачислятьАмортизацию, ЛОЖЬ) КАК НачислятьАмортизацию,
	|	втПараметрыАмортизацииВНАМСФО.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	втПараметрыАмортизацииВНАМСФО.ПрофильРаспределения КАК ПрофильРаспределения,
