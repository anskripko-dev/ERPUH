	|			{ЛЕВОЕ СОЕДИНЕНИЕ втБазыРасчета КАК втБазыРасчета
	|			ПО втПараметрыАмортизацииВНАМСФО.ВНА = втБазыРасчета.ВНА
	|				И (втПараметрыАмортизацииВНАМСФО.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.МСФО))}
	|			{ЛЕВОЕ СОЕДИНЕНИЕ втВыработкаВНА КАК втВыработкаВНА
	|			ПО втПараметрыАмортизацииВНАМСФО.ВНА = втВыработкаВНА.ВНА
	|				И втПараметрыАмортизацииВНАМСФО.ВидУчета = втВыработкаВНА.ВидУчета
	|				И втПараметрыАмортизацииВНАМСФО.ПараметрВыработки = втВыработкаВНА.ПараметрВыработки}
	|		ПО втСтоимостьВНАМСФО.ВНА = втПараметрыАмортизацииВНАМСФО.ВНА
	|			И втСтоимостьВНАМСФО.ВидУчета = втПараметрыАмортизацииВНАМСФО.ВидУчета}";

	ТекстЗамены = "";
	Если ЗначениеЗаполнено(ТаблицаДляПомещения) Тогда
		ТекстЗамены = "ПОМЕСТИТЬ " + ТаблицаДляПомещения;
	КонецЕсли;
	
	Возврат СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ втПараметрыВНА", ТекстЗамены);
	 
КонецФункции

#КонецОбласти 

Функция ПолучитьДатыЗапросаПараметровВНА(ДокументДата, ДокументСсылка, АлгоритмРСБУ = Неопределено)

	Если АлгоритмРСБУ = Неопределено Тогда
		АлгоритмРСБУ = Константы.АлгоритмНачиcленияАмортизацииАналогичноРСБУ.Получить();
	КонецЕсли;
	
	Если АлгоритмРСБУ Тогда	
		Результат = ПолучитьДатыЗапросаАлгоритмРСБУ(ДокументДата, ДокументСсылка);
	Иначе 
		Результат = ПолучитьДатыЗапросаАлгоритмМСФО(ДокументДата, ДокументСсылка);
	КонецЕсли;
	
	Результат.Вставить("АлгоритмРСБУ", АлгоритмРСБУ);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатыЗапросаАлгоритмРСБУ(ДокументДата, ДокументСсылка)
	
	Результат = Новый Структура;
		
	ДатаРасчета = ?(ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВыбытиеВНАМСФО"), КонецМесяца(ДокументДата), КонецМесяца(ДобавитьМесяц(ДокументДата, -1)));
	
	//Расчет амортизации: если Документ: 
	//	НачислениеАмортизации - по правилам предыдущего месяца(но выработка текущего),
	//  Выбытие - за текущий месяц
	//  для других документов расчет не проводится
	
	Результат.Вставить("ДатаРасчета",					ДатаРасчета);//не используется в алгоритмеРСБУ
	Результат.Вставить("ГраницаДоДокумента",			Новый Граница(ДатаРасчета, ВидГраницы.Включая));
	Результат.Вставить("ДатаНачалаПериодаДокумента",	НачалоМесяца(ДокументДата));// используется для получения объема выработки за период
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатыЗапросаАлгоритмМСФО(ДокументДата, ДокументСсылка)
	
	Результат = Новый Структура;
	
	ДатаРасчета = ДокументДата;
	
	//рассчитывает амортизацию от макс(ДатаНачалаНачисления,ДатаПоследнегоСобытия) до ДатаРасчета
	Результат.Вставить("ДатаРасчета",					ДатаРасчета);
	Результат.Вставить("ГраницаДоДокумента", 			МСФОВызовСервераУХ.ПолучитьГраницуДоДокумента(ДатаРасчета, ДокументСсылка));
	Результат.Вставить("ДатаНачалаПериодаДокумента",	НачалоМесяца(ДатаРасчета));
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли