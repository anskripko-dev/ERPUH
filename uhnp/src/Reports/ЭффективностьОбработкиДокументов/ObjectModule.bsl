
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДокументыБД = ПолучитьДокументыБД(КомпоновщикНастроек.ПолучитьНастройки());
	
	Если ДокументыБД.Строки.Количество() = 0 Тогда
		
		Сообщить("Для документов БД не указаны участки учета!");
		Возврат;
		
	КонецЕсли;
		
	ПараметрыЗапроса = ПолучитьТекстЗапросаПоДокументамБД(ДокументыБД);
	
	СхемаКД = ПолучитьСКД(ПараметрыЗапроса);
	
	НастройкиИсточник = КомпоновщикНастроек.ПолучитьНастройки();
	НастройкиСКД = ПолучитьНастройкиСКД(НастройкиИсточник, ПараметрыЗапроса);
	
	МакетКД = ТиповыеОтчетыУХ.ПолучитьМакетКомпоновкиДанныхКоллекции(
								СхемаКД, 
								НастройкиСКД, 
								ДанныеРасшифровки,,, 
								Тип("ГенераторМакетаКомпоновкиДанных"));
	
    ПроцессорКД = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКД.Инициализировать(МакетКД,, ДанныеРасшифровки);
	
    ПроцессорВыводаСКД = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВыводаСКД.УстановитьДокумент(ДокументРезультат);	
	
	Попытка
		ПроцессорВыводаСКД.Вывести(ПроцессорКД);	
	Исключение
	    Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры

Функция ПолучитьСКД(ПараметрыЗапроса)
    
    СхемаКД = ТиповыеОтчетыУХ.ПолучитьСхемуКомпоновкиДанных(ПараметрыЗапроса.Текст);
    
	КопируемыеСвойства = Новый Структура("Параметры, ВычисляемыеПоля, ПоляИтога");
	
	Для каждого КопируемоеСвойство Из КопируемыеСвойства Цикл		
		Для каждого ПараметрИстоник Из СхемаКомпоновкиДанных[КопируемоеСвойство.Ключ] Цикл
			
			ПараметрСКД = СхемаКД[КопируемоеСвойство.Ключ].Добавить();
			ЗаполнитьЗначенияСвойств(ПараметрСКД, ПараметрИстоник);
			
		КонецЦикла;		
	КонецЦикла;
	
	Для каждого ПолеНабора Из СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля Цикл
		
		ПолеСКД = СхемаКД.НаборыДанных.НаборДанных1.Поля.Добавить(ТипЗнч(ПолеНабора));
		ЗаполнитьЗначенияСвойств(ПолеСКД, ПолеНабора);
		
	КонецЦикла;		
	
	Для каждого ПараметрСКД Из ПараметрыЗапроса.Параметры Цикл        
				
		ПараметрКД = ТиповыеОтчетыУХ.ДобавитьПараметрВСхему(СхемаКД, ПараметрСКД.Ключ, ПараметрСКД.Значение);
		
		ПараметрКД.ТипЗначения 				= Новый ОписаниеТипов("СправочникСсылка.ДокументыБД");
		ПараметрКД.ВключатьВДоступныеПоля	= Ложь;
		ПараметрКД.ОграничениеИспользования	= Истина;
		
    КонецЦикла;
		
    Возврат СхемаКД;

КонецФункции

Функция ПолучитьНастройкиСКД(НастройкиИсточник, ПараметрыЗапроса)
	
	НастройкиСКД = Новый НастройкиКомпоновкиДанных;
	
	ТиповыеОтчетыУХ.СкопироватьНастройкиКомпоновкиДанных(НастройкиСКД, НастройкиИсточник);
	
	Для каждого ЭлементПараметр Из НастройкиИсточник.ПараметрыДанных.Элементы Цикл
	
		ЭлементПриемник = НастройкиСКД.ПараметрыДанных.Элементы.Добавить();
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементПараметр);
			
	КонецЦикла;
	
    Для каждого ПараметрСКД Из ПараметрыЗапроса.Параметры Цикл        
		ПараметрКД = ТиповыеОтчетыУХ.ДобавитьПараметр(НастройкиСКД, ПараметрСКД.Ключ, ПараметрСКД.Значение);		
	КонецЦикла;
	
	СтандартныйПериодОтчета = НастройкиИсточник.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период")).Значение;
	
	НастройкиСКД.ПараметрыДанных.УстановитьЗначениеПараметра("Периодичность", ПолучитьПериодичность(СтандартныйПериодОтчета)-1);

	Возврат НастройкиСКД;
	
КонецФункции

Функция ПолучитьПериодичность(СтандартныйПериодОтчета)

	ВидПериода = ВыборПериодаКлиентСервер.ПолучитьВидПериода(СтандартныйПериодОтчета.ДатаНачала, СтандартныйПериодОтчета.ДатаОкончания);
	
	Если ВидПериода = Перечисления.ДоступныеПериодыОтчета.День Тогда		
		Возврат 6;
	ИначеЕсли ВидПериода = Перечисления.ДоступныеПериодыОтчета.Неделя Тогда		
		Возврат 7;	
	ИначеЕсли ВидПериода = Перечисления.ДоступныеПериодыОтчета.Декада Тогда		
		Возврат 8;	
	ИначеЕсли ВидПериода = Перечисления.ДоступныеПериодыОтчета.Месяц Тогда		
		Возврат 9;			
	ИначеЕсли ВидПериода = Перечисления.ДоступныеПериодыОтчета.Квартал Тогда		
		Возврат 10;			
	ИначеЕсли ВидПериода = Перечисления.ДоступныеПериодыОтчета.Полугодие Тогда		
		Возврат 11;
	ИначеЕсли ВидПериода = Перечисления.ДоступныеПериодыОтчета.Год Тогда		
		Возврат 12;
	Иначе
		Возврат 12
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДокументыБД(Знач НастройкиСКД)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДокументыБД.Ссылка КАК ВидДокумента,
	|	ДокументыБД.Наименование КАК ИмяДокумента,
	|	ТабличныеЧастиБД.Имя КАК ИмяТЧ
	|ИЗ
	|	Справочник.ДокументыБД КАК ДокументыБД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТабличныеЧастиБД КАК ТабличныеЧастиБД
	|		ПО (ТабличныеЧастиБД.Владелец = ДокументыБД.Ссылка)
	|ГДЕ
	|	ДокументыБД.УчастокУчета <> ЗНАЧЕНИЕ(Справочник.УчасткиУчета.ПустаяСсылка)";
	
	НастройкиСКД.Выбор.Элементы.Очистить();		
	ТиповыеОтчетыУХ.ДобавитьВыбранныеПоля(НастройкиСКД.Выбор, Новый Структура("ВидДокумента,ИмяТЧ,ИмяДокумента"));
	
	НастройкиСКД.Структура.Очистить();
	Группировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НастройкиСКД, "ВидДокумента");
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ИмяДокумента");

	ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(Группировка);
	
	Возврат ТиповыеОтчетыУХ.ПолучитьКоллекциюПоНастройкамКомпоновкиДанных(ТекстЗапроса, НастройкиСКД,,,,,, Новый ДеревоЗначений);

КонецФункции

#Область ТекстЗапросаКД

Функция ПолучитьТекстЗапросаПоДокументамБД(ДокументыБД)
	
	мдДокументы = Метаданные.Документы;
	
	ПараметрыЗапроса = Новый Структура;
	
	ТекстЗапроса_втДокументы = "";
	ТекстЗапроса_втКоличествоСтрок = "";
		
	Для каждого ДокументБД Из ДокументыБД.Строки Цикл
		
		мдДокумент = мдДокументы.Найти(ДокументБД.ИмяДокумента);
		Если мдДокумент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыЗапроса.Вставить(ДокументБД.ИмяДокумента, ДокументБД.ВидДокумента);
		
		ПервыйЗапрос = ТекстЗапроса_втДокументы = "";
		ТекстЗапроса_втДокументы = ТекстЗапроса_втДокументы + ТекстЗапроса_втДокументы(ПервыйЗапрос, ДокументБД.ИмяДокумента);

		Для каждого ИмяТЧ Из ДокументБД.Строки Цикл
			
			Если мдДокумент.ТабличныеЧасти.Найти(ИмяТЧ.ИмяТЧ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПервыйЗапрос = ПервыйЗапрос И (ТекстЗапроса_втКоличествоСтрок = "");			
			ТекстЗапроса_втКоличествоСтрок = ТекстЗапроса_втКоличествоСтрок + ТекстЗапроса_втКоличествоСтрок(ПервыйЗапрос, ДокументБД.ИмяДокумента, ИмяТЧ.ИмяТЧ);
		
		КонецЦикла;
		
	КонецЦикла;

	ТекстЗапроса = ТекстЗапроса_втДокументы + ";" + ТекстЗапросаВнутренний(ТекстЗапроса_втКоличествоСтрок) + ";" + ТекстЗапроса_Результат();

	Возврат Новый Структура("Параметры,Текст", ПараметрыЗапроса, ТекстЗапроса);
	
КонецФункции

Функция ТекстЗапросаВнутренний(ТекстЗапроса_КоличествоСтрок)

	Возврат
	"ВЫБРАТЬ
	|	т.Документ КАК Документ,
	|	СУММА(т.КоличествоСтрок) КАК КоличествоСтрок
	|ПОМЕСТИТЬ втКоличествоСтрок
	|ИЗ
	|	(" + ТекстЗапроса_КоличествоСтрок + ") КАК т
	|СГРУППИРОВАТЬ ПО
	|	т.Документ
	|";
	
КонецФункции

Функция ТекстЗапроса_втДокументы(ПервыйЗапрос, ИмяДокумента)

	Возврат
	
	?(ПервыйЗапрос, "", " ОБЪЕДИНИТЬ ВСЕ ")
	+ "
	|ВЫБРАТЬ
	|	т.Ссылка КАК Документ,
	|	&" + ИмяДокумента + " КАК ВидДокумента"
	+ ?(ПервыйЗапрос, " ПОМЕСТИТЬ втДокументы ", "") +
	"
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК т
	|ГДЕ 
	|	т.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода";

КонецФункции

Функция ТекстЗапроса_втКоличествоСтрок(ПервыйЗапрос, ИмяДокумента, ИмяТЧ)

	Возврат
	
	?(ПервыйЗапрос, "", " ОБЪЕДИНИТЬ ВСЕ ")
	+ "
	|ВЫБРАТЬ
	|	т.Ссылка КАК Документ,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок 
	|ИЗ
	|	Документ." + ИмяДокумента + "." + ИмяТЧ + " КАК т
	|
	|СГРУППИРОВАТЬ ПО 
	|	т.Ссылка
	|";

КонецФункции

Функция ТекстЗапроса_Результат()

	Возврат
	"ВЫБРАТЬ
	|	НормативыОтработкиДокументов.Организация,
	|	НормативыОтработкиДокументов.ДокументБД КАК ВидДокумента,
	|	НормативыОтработкиДокументов.Норматив
	|ПОМЕСТИТЬ втНормативы
	|ИЗ
	|	РегистрСведений.НормативыОтработкиДокументов КАК НормативыОтработкиДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ДанныеПользователя.Ссылка КАК Пользователь,
	|	МАКСИМУМ(ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение) КАК Подразделение,
	|	МАКСИМУМ(ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация) КАК Организация
	|ПОМЕСТИТЬ втСотрудники
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ДанныеПользователя
	|		ПО (ДанныеПользователя.Ссылка В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					т.Документ.Ответственный
	|				ИЗ
	|					втДокументы КАК т
	|				ГДЕ
	|					НЕ т.Документ.Ответственный ЕСТЬ NULL ))
	|			И ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = ДанныеПользователя.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо,
	|	ДанныеПользователя.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДокументы.Документ КАК Документ,
	|	втДокументы.Документ.Дата КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА &Периодичность < 6 + 1
	|			ТОГДА втДокументы.Документ.Дата
	|		КОГДА &Периодичность = 6 + 1
	|			ТОГДА НАЧАЛОПЕРИОДА(втДокументы.Документ.Дата, ДЕНЬ)
	|		КОГДА &Периодичность = 7 + 1
	|			ТОГДА НАЧАЛОПЕРИОДА(втДокументы.Документ.Дата, НЕДЕЛЯ)
	|		КОГДА &Периодичность = 8 + 1
	|			ТОГДА НАЧАЛОПЕРИОДА(втДокументы.Документ.Дата, ДЕКАДА)
	|		КОГДА &Периодичность = 9 + 1
	|			ТОГДА НАЧАЛОПЕРИОДА(втДокументы.Документ.Дата, МЕСЯЦ)
	|		КОГДА &Периодичность = 10 + 1
	|			ТОГДА НАЧАЛОПЕРИОДА(втДокументы.Документ.Дата, КВАРТАЛ)
	|		КОГДА &Периодичность = 11 + 1
	|			ТОГДА НАЧАЛОПЕРИОДА(втДокументы.Документ.Дата, ПОЛУГОДИЕ)
	|		КОГДА &Периодичность = 12 + 1
	|			ТОГДА НАЧАЛОПЕРИОДА(втДокументы.Документ.Дата, ГОД)
	|	КОНЕЦ КАК ПериодДокумента,
	|	втДокументы.Документ.Организация КАК ОрганизацияПоДокументу,
	|	втСотрудники.Организация КАК ОрганизацияПоСотруднику,
	|	втСотрудники.Подразделение КАК ПодразделениеОрганизации,
	|	втДокументы.ВидДокумента КАК ВидДокумента,
	|	ВЫРАЗИТЬ(втДокументы.ВидДокумента КАК Справочник.ДокументыБД).УчастокУчета КАК УчастокУчета,
	|	втДокументы.Документ.Ответственный КАК Ответственный,
	|	втКоличествоСтрок.КоличествоСтрок КАК КоличествоСтрок,
	|	втНормативы.Норматив КАК Норматив
	|ИЗ
	|	втДокументы КАК втДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКоличествоСтрок КАК втКоличествоСтрок
	|		ПО втДокументы.Документ = втКоличествоСтрок.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНормативы КАК втНормативы
	|		ПО втДокументы.Документ.Организация = втНормативы.Организация
	|			И втДокументы.ВидДокумента = втНормативы.ВидДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСотрудники КАК втСотрудники
	|		ПО втДокументы.Документ.Ответственный = втСотрудники.Пользователь"

КонецФункции

#КонецОбласти
