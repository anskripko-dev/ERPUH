КонецФункции

Функция ТекстЗапроса_ДанныеОрганизаций()

	Возврат
	"ВЫБРАТЬ
	|	т.ОрганизацияВГО КАК ОрганизацияВГО,
	|	т.Регистратор КАК Регистратор,
	|	т.НомерСтроки КАК НомерСтроки,
	|	т.Счет КАК Счет,
	|	втВозможныеОрганизации.ОрганизацияВГО КАК ОрганизацияСверкиВГО,
	|	т.Сумма КАК Сумма,
	|	т.СуммаДт КАК СуммаДт,
	|	т.СуммаКт КАК СуммаКт,
	|	т.Остатки КАК Остатки
	|ПОМЕСТИТЬ втДанныеОрганизаций
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.ОрганизацияВГО КАК ОрганизацияВГО,
	|		т.Счет КАК Счет,
	|		т.КонтрагентВГО КАК КонтрагентВГО,
	|		т.Сумма КАК Сумма,
	|		т.СуммаДт КАК СуммаДт,
	|		т.СуммаКт КАК СуммаКт,
	|		NULL КАК Регистратор,
	|		NULL КАК НомерСтроки,
	|		ИСТИНА КАК Остатки
	|	ИЗ
	|		втОстатки КАК т
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.ОрганизацияВГО,
	|		т.Счет,
	|		т.КонтрагентВГО,
	|		т.Сумма,
	|		т.СуммаДт,
	|		т.СуммаКт,
	|		NULL,
	|		NULL КАК НомерСтроки,
	|		ИСТИНА
	|	ИЗ
	|		втОстаткиДополнение КАК т
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.ОрганизацияВГО,
	|		т.Счет,
	|		т.КонтрагентВГО,
	|		т.Сумма,
	|		т.СуммаДт,
	|		т.СуммаКт,
	|		т.Регистратор,
	|		т.НомерСтроки КАК НомерСтроки,
	|		ЛОЖЬ
	|	ИЗ
	|		втОбороты КАК т
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.ОрганизацияВГО,
	|		т.Счет,
	|		т.КонтрагентВГО,
	|		т.Сумма,
	|		т.СуммаДт,
	|		т.СуммаКт,
	|		т.Регистратор,
	|		т.НомерСтроки,
	|		ЛОЖЬ
	|	ИЗ
	|		втОборотыДополнение КАК т) КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОрганизацииВГО КАК втВозможныеОрганизации
	|		ПО т.КонтрагентВГО = втВозможныеОрганизации.КонтрагентВГО
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	т.Счет,
	|	т.Остатки";

КонецФункции

Функция ТекстЗапроса_СверкаВГО()

	Возврат
	"ВЫБРАТЬ
	|	т.Остатки КАК ОстаткиОбороты,
	|	т.Регистратор КАК Регистратор,
	|	т.Регистратор.Дата КАК Дата,
	|	т.Регистратор.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	т.НомерСтроки КАК НомерСтроки,
	|	т.Счет КАК СчетОрганизации,
	|	NULL КАК СчетКонтрагента,
	|	т.ОрганизацияВГО КАК Организация,
	|	т.ОрганизацияСверкиВГО КАК ОрганизацияСверки,
	|	т.Сумма КАК СуммаОрганизации,
	|	т.СуммаДт КАК СуммаОрганизацииДт,
	|	т.СуммаКт КАК СуммаОрганизацииКт,
	|	0 КАК СуммаКонтрагента,
	|	0 КАК СуммаКонтрагентаДт,
	|	0 КАК СуммаКонтрагентаКт,
	|	т.Сумма КАК Расхождение
	|ИЗ
	|	втДанныеОрганизаций КАК т
	|{ГДЕ
	|	т.ОрганизацияВГО КАК ОрганизацияВГО,
	|	т.ОрганизацияСверкиВГО КАК ОрганизацияСверкиВГО}
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Остатки,
	|	т.Регистратор,
	|	т.Регистратор.Дата КАК Дата,
	|	т.Регистратор.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	т.НомерСтроки,
	|	NULL,
	|	т.Счет,
	|	т.ОрганизацияСверкиВГО,
	|	т.ОрганизацияВГО,
	|	0,
	|	0,
	|	0,
	|	т.Сумма,
	|	т.СуммаДт,
	|	т.СуммаКт,
	|	т.Сумма
	|ИЗ
	|	втДанныеОрганизаций КАК т
	|{ГДЕ
	|	т.ОрганизацияВГО КАК ОрганизацияСверкиВГО,
	|	т.ОрганизацияСверкиВГО КАК ОрганизацияВГО}";

КонецФункции

Функция ДоработатьЗапросПоПлануСчетов(ТекстЗапроса, ТаблицаПОМЕСТИТЬ, МСФО = Истина)

	Если МСФО Тогда
		Возврат ПреобразоватьТекстЗапросаМСФО(ТекстЗапроса);
	КонецЕсли;

	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		Возврат ТекстЗапроса;//в ЕРП контрагенты вместо учредителей	
	КонецЕсли;	

	Возврат 
	ТекстЗапроса 
	+ "
	|
	|ОБЪЕДИНИТЬ ВСЕ 
	|
	|" 
	+ ПреобразоватьТекстЗапроса_Учредители(ТекстЗапроса, ТаблицаПОМЕСТИТЬ);	
	
КонецФункции

Функция ПреобразоватьТекстЗапросаМСФО(ТекстЗапроса)
	 	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрБухгалтерии.Хозрасчетный", "РегистрБухгалтерии.МСФО");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВидыСубконтоХозрасчетные.Контрагенты", "ВидыСубконтоКорпоративные.СправочникКонтрагенты");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "т.Сумма", "т.СуммаВВалютеУчета");
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ПреобразоватьТекстЗапроса_Учредители(ТекстЗапроса, ТаблицаПОМЕСТИТЬ)
	
	ТекстНовый = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ " + ТаблицаПОМЕСТИТЬ, "");
	
	Возврат СтрЗаменить(ТекстНовый, 
						"ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты)",
					    "ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Учредители)"
					);

КонецФункции

#КонецОбласти

#КонецЕсли
