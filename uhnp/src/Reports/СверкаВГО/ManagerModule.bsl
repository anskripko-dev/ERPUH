#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ТекстЗапроса

Функция ТекстЗапроса_Отчет(ПланСчетовМСФО = Истина, ОтборПоРегламенту = Ложь) Экспорт
	
	ТекстЗапроса = Новый Массив;
	ТекстЗапроса.Добавить(ТекстЗапроса_Счета(ПланСчетовМСФО = Ложь));
	
	Если ОтборПоРегламенту Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_Регламент());
	КонецЕсли;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_Организации());
	ТекстЗапроса.Добавить(ТекстЗапроса_ОрганизацииСверки());
	ТекстЗапроса.Добавить(ТекстЗапроса_ОрганизацииВГО());
	
	ТекстЗапроса.Добавить(ТекстЗапроса_Остатки(ПланСчетовМСФО));
	ТекстЗапроса.Добавить(ТекстЗапроса_ОстаткиДополнение(ПланСчетовМСФО));
	ТекстЗапроса.Добавить(ТекстЗапроса_Обороты(ПланСчетовМСФО));
	ТекстЗапроса.Добавить(ТекстЗапроса_ОборотыДополнение(ПланСчетовМСФО));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_ДанныеОрганизаций());
	ТекстЗапроса.Добавить(ТекстЗапроса_СверкаВГО());
		
	ТекстЗамены = "ИСТИНА";
	Если ОтборПоРегламенту Тогда
		ТекстЗамены = "т.ОрганизационнаяЕдиница В (ВЫБРАТЬ т.ОрганизацияВГО ИЗ втРегламент КАК т)";
	КонецЕсли;
	
	ТекстРазделителя = ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета();
	
	Возврат СтрЗаменить(СтрСоединить(ТекстЗапроса, ТекстРазделителя), "&ОтборПоРегламенту", ТекстЗамены);
	
КонецФункции

Функция ТекстЗапроса_Счета(ПустыеРазделыПланаСчетов = Ложь)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Ссылка.СчетСсылка КАК Счет,
	|	МАКСИМУМ(т.НомерСтроки) КАК НомерСубконто,
	|	МАКСИМУМ(СубконтоДоговоры.НомерСтроки) КАК НомерСубконтоДоговоры
	|ПОМЕСТИТЬ втСчета
	|ИЗ
	|	Справочник.СчетаБД.ВидыСубконто КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК СубконтоДоговоры
	|		ПО т.Ссылка = СубконтоДоговоры.Ссылка
	|			И (СубконтоДоговоры.ТипДанных ПОДОБНО ""%Справочник.Договоры%"")
	|ГДЕ
	|	т.ТипДанных ПОДОБНО ""%Справочник.Контрагенты%""
	|	И т.Ссылка.РазделПланаСчетов В (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.Взаиморасчеты), ЛОЖЬ)
	|	И т.Ссылка.Владелец = &ПланСчетов
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Ссылка,
	|	т.Ссылка.СчетСсылка";
	
	Если ПустыеРазделыПланаСчетов Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЛОЖЬ", "ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапроса_Регламент()

	Возврат
	"ВЫБРАТЬ
	|	т.ОрганизационнаяЕдиница КАК ОрганизацияВГО
	|ПОМЕСТИТЬ втРегламент
	|ИЗ
	|	Справочник.ВерсииРегламентовПодготовкиОтчетности.ОрганизационныеЕдиницы КАК т
	|ГДЕ
	|	т.Ссылка = &Регламент"; 

КонецФункции

Функция ТекстЗапроса_Организации()

	Возврат
	"ВЫБРАТЬ
	|	МАКСИМУМ(т.Ссылка) КАК КонтрагентВГО,
	|	т.ОрганизационнаяЕдиница КАК ОрганизацияВГО
	|ПОМЕСТИТЬ втОрганизации
	|ИЗ
	|	Справочник.Контрагенты КАК т
	|ГДЕ
	|	т.ОрганизационнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И &ОтборПоРегламенту
	|{ГДЕ
	|	т.ОрганизационнаяЕдиница КАК Организация}
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ОрганизационнаяЕдиница";

КонецФункции

Функция ТекстЗапроса_ОрганизацииСверки()

	Возврат
	"ВЫБРАТЬ
	|	МАКСИМУМ(т.Ссылка) КАК КонтрагентВГО,
	|	т.ОрганизационнаяЕдиница КАК ОрганизацияСверкиВГО
	|ПОМЕСТИТЬ втОрганизацииСверки
	|ИЗ
	|	Справочник.Контрагенты КАК т
	|ГДЕ
	|	т.ОрганизационнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И &ОтборПоРегламенту
	|{ГДЕ
	|	т.ОрганизационнаяЕдиница КАК ОрганизацияСверки}
	|
	|СГРУППИРОВАТЬ ПО
	|	т.ОрганизационнаяЕдиница";

КонецФункции

Функция ТекстЗапроса_ОрганизацииВГО()

	Возврат
	"ВЫБРАТЬ
	|	ЕСТЬNULL(втОрганизации.ОрганизацияВГО, втОрганизацииСверки.ОрганизацияСверкиВГО) КАК ОрганизацияВГО,
	|	ЕСТЬNULL(втОрганизации.КонтрагентВГО, втОрганизацииСверки.КонтрагентВГО) КАК КонтрагентВГО,
	|	НЕ втОрганизации.ОрганизацияВГО ЕСТЬ NULL КАК ОтборПоОрганизации
	|ПОМЕСТИТЬ втОрганизацииВГО
	|ИЗ
	|	втОрганизации КАК втОрганизации
	|		ПОЛНОЕ СОЕДИНЕНИЕ втОрганизацииСверки КАК втОрганизацииСверки
	|		ПО втОрганизации.ОрганизацияВГО = втОрганизацииСверки.ОрганизацияСверкиВГО
	|{ГДЕ
	|	втОрганизации.ОрганизацияВГО КАК ОрганизацияВГО,
	|	втОрганизацииСверки.ОрганизацияСверкиВГО КАК ОрганизацияСверкиВГО}
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОтборПоОрганизации";

КонецФункции

Функция ТекстЗапроса_Остатки(МСФО = Истина)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Организация КАК ОрганизацияВГО,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК КонтрагентВГО,
	|	т.СуммаКонечныйОстаток КАК Сумма,
	|	т.СуммаКонечныйРазвернутыйОстатокДт КАК СуммаДт,
	|	т.СуммаКонечныйРазвернутыйОстатокКт КАК СуммаКт
	|ПОМЕСТИТЬ втОстатки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|			{(&НачалоПериода)},
	|			{(&КонецПериода)},
	|			,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.Счет
	|				ИЗ
	|					втСчета КАК т),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты),
	|			Организация В
	|					(ВЫБРАТЬ
	|						т.ОрганизацияВГО
	|					ИЗ
	|						втОрганизации КАК т)
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						т.КонтрагентВГО
	|					ИЗ
	|						втОрганизацииВГО КАК т) {(Организация).* КАК ОрганизацияВГО}) КАК т";
	
	Возврат ДоработатьЗапросПоПлануСчетов(ТекстЗапроса, "втОстатки", МСФО);
	
КонецФункции

Функция ТекстЗапроса_ОстаткиДополнение(МСФО = Истина)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.Организация КАК ОрганизацияВГО,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК КонтрагентВГО,
	|	т.СуммаКонечныйОстаток КАК Сумма,
	|	т.СуммаКонечныйРазвернутыйОстатокДт КАК СуммаДт,
	|	т.СуммаКонечныйРазвернутыйОстатокКт КАК СуммаКт
	|ПОМЕСТИТЬ втОстаткиДополнение
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|			{(&НачалоПериода)},
	|			{(&КонецПериода)},
	|			,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.Счет
	|				ИЗ
	|					втСчета КАК т),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты),
	|			Организация В
	|					(ВЫБРАТЬ
	|						т.ОрганизацияВГО
	|					ИЗ
	|						втОрганизацииВГО КАК т
	|					ГДЕ
	|						НЕ т.ОтборПоОрганизации)
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						т.КонтрагентВГО
	|					ИЗ
	|						втОрганизацииВГО КАК т
	|					ГДЕ
	|						т.ОтборПоОрганизации) {(Организация).* КАК ОрганизацияВГО}) КАК т";
	
	Возврат ДоработатьЗапросПоПлануСчетов(ТекстЗапроса, "втОстаткиДополнение", МСФО);
	
КонецФункции

Функция ТекстЗапроса_Обороты(МСФО = Истина)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Организация КАК ОрганизацияВГО,
	|	т.Счет КАК Счет,
	|	т.КорСубконто1 КАК КонтрагентВГО,
	|	т.СуммаОборот КАК Сумма,
	|	т.СуммаОборотДт КАК СуммаДт,
	|	т.СуммаОборотКт КАК СуммаКт,
	|	т.Регистратор КАК Регистратор,
	|	т.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ втОбороты
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			{(&НачалоПериода)},
	|			{(&КонецПериода)},
	|			Авто,
	|			НЕ Счет В
	|					(ВЫБРАТЬ
	|						т.Счет
	|					ИЗ
	|						втСчета КАК т),
	|			,
	|			Организация В
	|					(ВЫБРАТЬ
	|						т.ОрганизацияВГО
	|					ИЗ
	|						втОрганизации КАК т)
	|				И КорСубконто1 В
	|					(ВЫБРАТЬ
	|						т.КонтрагентВГО
	|					ИЗ
	|						втОрганизацииВГО КАК т) {(Организация).* КАК ОрганизацияВГО},
	|			КорСчет В
	|				(ВЫБРАТЬ
	|					т.Счет
	|				ИЗ
	|					втСчета КАК т),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты)) КАК т";
	
	Возврат ДоработатьЗапросПоПлануСчетов(ТекстЗапроса, "втОбороты", МСФО);

КонецФункции

