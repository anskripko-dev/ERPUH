Функция ПолучитьНастройкиЗапроса()

	Результат = Новый Структура;
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПараметрСКД = Новый ПараметрКомпоновкиДанных("ПланСчетов");
	ЗначениеПараметра = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрСКД).Значение;	
	Результат.Вставить("МСФО", ЗначениеПараметра.Наименование = "МСФО");
	
	ПараметрСКД = Новый ПараметрКомпоновкиДанных("ВыводитьНаименованиеСчета");
	ЗначениеПараметра = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрСКД).Значение;	
	Результат.Вставить("ВыводитьНаименованиеСчета", ЗначениеПараметра = Истина);
	
	ПараметрСКД = Новый ПараметрКомпоновкиДанных("Период");
	ЗначениеПараметра = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрСКД).Значение;	
	Результат.Вставить("Период", ЗначениеПараметра);
		
	ПараметрСКД = Новый ПараметрКомпоновкиДанных("Регламент");
	ЗначениеПараметра = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрСКД);
	Если ЗначениеПараметра.Использование Тогда
		Результат.Вставить("Регламент", ЗначениеПараметра.Значение);
	Иначе 
		Результат.Вставить("Регламент", ПредопределенноеЗначение("Справочник.ВерсииРегламентовПодготовкиОтчетности.ПустаяСсылка"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

