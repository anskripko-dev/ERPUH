Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	НастройкиЗапроса = ПолучитьНастройкиЗапроса();
	
	//Организация, ОрганизацияСверки - поля для отборов СКД
	//ОрганизацияВГО, ОрганизацияСверкиВГО, КонтрагентВГО - поля не доступны для отборов и пользователя
	ОтборПоРегламенту = ЗначениеЗаполнено(НастройкиЗапроса.Регламент);
	
	МСФОУХ.СКД_Поля_Счет(СхемаКомпоновкиДанных, НастройкиЗапроса.ВыводитьНаименованиеСчета, "СчетОрганизации,СчетКонтрагента");
	
	Набор = СхемаКомпоновкиДанных.НаборыДанных.СверкаВГО;
	
	Выражение = НСтр("ru = '""Организационная единица: "" + '");
	Набор.Поля.Найти("Организация").ВыражениеПредставления = Выражение + "Организация.Наименование";
	Выражение = НСтр("ru = '""Организационная единица для сверки: "" + '");
	Набор.Поля.Найти("ОрганизацияСверки").ВыражениеПредставления = Выражение + "ОрганизацияСверки.Наименование";
	
	Набор.Запрос = Отчеты.СверкаВГО.ТекстЗапроса_Отчет(НастройкиЗапроса.МСФО, ОтборПоРегламенту);
	
	Если ОбщегоНазначенияКлиентСервер.РежимОтладки() Тогда
		ТекстДляКонсолиЗапросов = ТиповыеОтчетыУХ.МакетКомпоновкиВXML(ТиповыеОтчетыУХ.ПолучитьМакетКомпоновкиДанныхКоллекции(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки()));
	КонецЕсли;	
	
КонецПроцедуры

