	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтчетЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда       
		Возврат;      
	Иначе       
		Очистить();       
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить() Экспорт
	ОчиститьТабличноеПолеНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ОчиститьТабличноеПолеНаСервере()
	
	// Список ячеек, которые очищать не нужно.
	Перем СписокПоказателейНеПодлежащихОчистке;

	ВыбТабличноеПоле = ПолеТабличногоДокументаФормаОтчета;
	
	СписокПоказателейНеПодлежащихОчистке = Новый СписокЗначений;
	СписокПоказателейНеПодлежащихОчистке.Добавить(ВыбТабличноеПоле.Области["НомерКорректировки"].Значение,       "НомерКорректировки");
	СписокПоказателейНеПодлежащихОчистке.Добавить(ВыбТабличноеПоле.Области["Период"].Значение,       "Период");

	ВыбТабличноеПоле.Очистить();
	ВыбТабличноеПоле.Вывести(ОбъектОтчета(ИмяФормы).ПолучитьМакет("ФормаОтчета2020Кв1_ФормаОтчета"));
	ПолеТабличногоДокументаФормаОтчета = ВыбТабличноеПоле;
	РегламентированнаяОтчетность.НачальныеОперацииСМногострочнымиБлоками(ЭтаФорма);
	
	Для каждого ЭлементСписка Из СписокПоказателейНеПодлежащихОчистке Цикл
		ВыбТабличноеПоле.Области[ЭлементСписка.Представление].Значение = ЭлементСписка.Значение;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьБланкЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Команда = ДополнительныеПараметры.Команда;
		
	Если Команда <> Неопределено Тогда
		Печать(Команда.Имя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(ВидПечати, НеИзФормыОтчета = Ложь) Экспорт
	
	Состояние(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1. Формируется печатная форма...';
																			|en = '%1. Формируется печатная форма...'"), Заголовок), , , БиблиотекаКартинок.Печать);
	
	Если НЕ ПечатьНаСервере(ВидПечати) Тогда
		Возврат;
	КонецЕсли;
	
	РегламентированнаяОтчетностьКлиент.ОткрытьФормуПредварительногоПросмотра(ЭтаФорма, ВидПечати, , СтруктураРеквизитовФормы.СписокПечатаемыхЛистов);
	
КонецПроцедуры

&НаСервере
Процедура СтрокаВКвадраты(Строка, ИмяПараметра, Область)
	ИмяПараметраИтог = ИмяПараметра + "_";
	Для Инд = 1 По СтрДлина(Строка) Цикл 
		Обл = Область.Области.Найти(ИмяПараметраИтог + Формат(Инд, "ЧГ="));
		Если Обл = Неопределено Тогда 
			Прервать;
		КонецЕсли;
		
		Обл.Значение = Сред(Строка, Инд, 1);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере(ВидПечати)
	Если НЕ РегламентированнаяОтчетность.ПринтерДоступен() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Перед формированием печатных форм необходимо определить в системе принтер и задать его в качестве используемого по умолчанию!';
													|en = 'Перед формированием печатных форм необходимо определить в системе принтер и задать его в качестве используемого по умолчанию!'"));
		Возврат Ложь;
	КонецЕсли;
	
	ТабличныйДокумент = ЭтаФорма["ПолеТабличногоДокументаФормаОтчета"];
	Области = ПолеТабличногоДокументаФормаОтчета.Области;
	СтруктураРеквизитовФормы.мПечатныеФормы.Очистить();
	
	ПечатнаяФормаМакет = ОбъектОтчета(ИмяФормы).ПолучитьМакет("ПечатнаяФорма2020Кв1");
	Страница = ПечатнаяФормаМакет.ПолучитьОбласть("Страница01_Начало");
	Подвал = ПечатнаяФормаМакет.ПолучитьОбласть("Страница02_Подвал");
	
	СтрокаВКвадраты(СокрЛП(ПолеТабличногоДокументаФормаОтчета.Области.ИНН.Значение) + "-----------------------", "ИНН", Страница);
	СтрокаВКвадраты(СокрЛП(ПолеТабличногоДокументаФормаОтчета.Области.КПП.Значение) + "-----------------------", "КПП", Страница);
	СтрокаВКвадраты(СокрЛП(ПолеТабличногоДокументаФормаОтчета.Области.ОГРН.Значение) + "-----------------------", "ОГРН", Страница);
	СтрокаВКвадраты(Формат(ПолеТабличногоДокументаФормаОтчета.Области.ДатаРегистрации.Значение, "ДФ=ddMMyyyy; ДП=--------"), "ДатаРегистрации", Страница);
	
	Для Каждого О Из ПолеТабличногоДокументаФормаОтчета.Области Цикл 
		Если О.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник
			Или Не О.СодержитЗначение = Истина Тогда 
			
			Продолжить;
		КонецЕсли;
		
		Обл = Страница.Области.Найти(О.Имя);
		Если ТипЗнч(Обл) = Тип("ОбластьЯчеекТабличногоДокумента") 
			И Обл.СодержитЗначение = Истина Тогда 
			
			Обл.Значение = О.Значение;
		КонецЕсли;
		Обл = Подвал.Области.Найти(О.Имя);
		Если ТипЗнч(Обл) = Тип("ОбластьЯчеекТабличногоДокумента") 
			И Обл.СодержитЗначение = Истина Тогда 
			
			Обл.Значение = О.Значение;
		КонецЕсли;
	КонецЦикла;
	
	нСтр = РегламентированнаяОтчетность.НоваяСтраница();
	нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	нСтр.Вывести(Страница);
	нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Стр1"));
	
	МнгСтрШаблон = ПечатнаяФормаМакет.ПолучитьОбласть("МнгСтрШаблон");
	ГраницаСверху = ПечатнаяФормаМакет.ПолучитьОбласть("ОбластьГраницаСверху");
	ГраницаСнизу = ПечатнаяФормаМакет.ПолучитьОбласть("ОбластьГраницаСнизу");
	
	Для Инд = 1 По 4 Цикл 
		СтрЗаг = ПечатнаяФормаМакет.ПолучитьОбласть("Стр1" + Инд);
		Если Не нСтр.ПроверитьВывод(СтрЗаг) Тогда 
			нСтр.Вывести(ГраницаСверху);
			СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
			нСтр = РегламентированнаяОтчетность.НоваяСтраница();
			нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
			нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр1"));
			нСтр.Вывести(ГраницаСнизу);
		КонецЕсли;
		нСтр.Вывести(СтрЗаг);
		Итер = 0;
		Пока Истина Цикл 
			Итер = Итер + 1;
			ИтерСтр = Формат(Итер, "ЧГ=");
			Если ПолеТабличногоДокументаФормаОтчета.Области.Найти("П010" + Инд + "00000001_" + ИтерСтр) = Неопределено Тогда 
				Прервать;
			КонецЕсли;
			
			МнгСтрШаблон.Области.П00.Значение = "";
			МнгСтрШаблон.Области.П01.Значение = "1." + Инд + "." + ИтерСтр;
			МнгСтрШаблон.Области.П02.Значение = ПолеТабличногоДокументаФормаОтчета.Области.Найти("П010" + Инд + "00000001_" + ИтерСтр).Значение;
			МнгСтрШаблон.Области.П03.Значение = ПолеТабличногоДокументаФормаОтчета.Области.Найти("П010" + Инд + "00000002_" + ИтерСтр).Значение;
			Если Не нСтр.ПроверитьВывод(МнгСтрШаблон) Тогда 
				нСтр.Вывести(ГраницаСверху);
				СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
				нСтр = РегламентированнаяОтчетность.НоваяСтраница();
				нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
				нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр1"));
				нСтр.Вывести(ГраницаСнизу);
			КонецЕсли;
			нСтр.Вывести(МнгСтрШаблон);
		КонецЦикла;
	КонецЦикла;
	
	нСтр.Вывести(ГраницаСверху);
	СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
	нСтр = РегламентированнаяОтчетность.НоваяСтраница();
	нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
	
	Для Инд = 1 По 2 Цикл 
		СтрЗаг = ПечатнаяФормаМакет.ПолучитьОбласть("Стр2" + Инд);
		Если Не нСтр.ПроверитьВывод(СтрЗаг) Тогда 
			нСтр.Вывести(ГраницаСверху);
			СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
			нСтр = РегламентированнаяОтчетность.НоваяСтраница();
			нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
			нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
			нСтр.Вывести(ГраницаСнизу);
		КонецЕсли;
		нСтр.Вывести(СтрЗаг);
		Итер = 0;
		Пока Истина Цикл 
			Итер = Итер + 1;
			ИтерСтр = Формат(Итер, "ЧГ=");
			Если ПолеТабличногоДокументаФормаОтчета.Области.Найти("П020" + Инд + "00000001_" + ИтерСтр) = Неопределено Тогда 
				Прервать;
			КонецЕсли;
			
			МнгСтрШаблон.Области.П00.Значение = "";
			Если Итер = 1 И Инд = 1 Тогда 
				МнгСтрШаблон.Области.П00.Значение = "2.1";
			КонецЕсли;
			МнгСтрШаблон.Области.П01.Значение = "2." + Инд + "." + ИтерСтр;
			МнгСтрШаблон.Области.П02.Значение = ПолеТабличногоДокументаФормаОтчета.Области.Найти("П020" + Инд + "00000001_" + ИтерСтр).Значение;
			МнгСтрШаблон.Области.П03.Значение = ПолеТабличногоДокументаФормаОтчета.Области.Найти("П020" + Инд + "00000002_" + ИтерСтр).Значение;
			Если Не нСтр.ПроверитьВывод(МнгСтрШаблон) Тогда 
				нСтр.Вывести(ГраницаСверху);
				СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
				нСтр = РегламентированнаяОтчетность.НоваяСтраница();
				нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
				нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
				нСтр.Вывести(ГраницаСнизу);
			КонецЕсли;
			нСтр.Вывести(МнгСтрШаблон);
		КонецЦикла;
	КонецЦикла;
	
	СтрЗаг = ПечатнаяФормаМакет.ПолучитьОбласть("Стр3");
	Если Не нСтр.ПроверитьВывод(СтрЗаг) Тогда 
		нСтр.Вывести(ГраницаСверху);
		СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
		нСтр = РегламентированнаяОтчетность.НоваяСтраница();
		нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
		нСтр.Вывести(ГраницаСнизу);
	КонецЕсли;
	нСтр.Вывести(СтрЗаг);
		
	Для Инд1 = 1 По 3 Цикл
		СтрЗаг = ПечатнаяФормаМакет.ПолучитьОбласть("Стр3" + Инд1);
		Если Не нСтр.ПроверитьВывод(СтрЗаг) Тогда 
			нСтр.Вывести(ГраницаСверху);
			СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
			нСтр = РегламентированнаяОтчетность.НоваяСтраница();
			нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
			нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
			нСтр.Вывести(ГраницаСнизу);
		КонецЕсли;
		нСтр.Вывести(СтрЗаг);
		Для Инд2 = 1 По 2 Цикл
			Итер = 0;
			Пока Истина Цикл 
				Если Итер = 0 Тогда 
					МнгСтрШаблон.Области.П00.Значение = "";
					МнгСтрШаблон.Области.П01.Значение = "3." + Инд1 + "." + Инд2;
					Если Инд2 = 1 Тогда 
						МнгСтрШаблон.Области.П02.Значение = "Основные средства (указать наименование):";
					Иначе
						МнгСтрШаблон.Области.П02.Значение = "Иное имущество (указать наименование, сгруппировав по назначению):";
					КонецЕсли;
					МнгСтрШаблон.Области.П03.Значение = Неопределено;
					Если Не нСтр.ПроверитьВывод(МнгСтрШаблон) Тогда 
						нСтр.Вывести(ГраницаСверху);
						СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
						нСтр = РегламентированнаяОтчетность.НоваяСтраница();
						нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
						нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
						нСтр.Вывести(ГраницаСнизу);
					КонецЕсли;
					нСтр.Вывести(МнгСтрШаблон);
				КонецЕсли;
				Итер = Итер + 1;
				ИтерСтр = Формат(Итер, "ЧГ=");
				Если ПолеТабличногоДокументаФормаОтчета.Области.Найти("П030" + Инд1 + "0" + Инд2 + "000001_" + ИтерСтр) = Неопределено Тогда 
					Прервать;
				КонецЕсли;
				
				МнгСтрШаблон.Области.П00.Значение = "";
				МнгСтрШаблон.Области.П01.Значение = "3." + Инд1 + "." + Инд2 + "." + ИтерСтр;
				МнгСтрШаблон.Области.П02.Значение = ПолеТабличногоДокументаФормаОтчета.Области.Найти("П030" + Инд1 + "0" + Инд2 + "000001_" + ИтерСтр).Значение;
				МнгСтрШаблон.Области.П03.Значение = ПолеТабличногоДокументаФормаОтчета.Области.Найти("П030" + Инд1 + "0" + Инд2 + "000002_" + ИтерСтр).Значение;
				Если Не нСтр.ПроверитьВывод(МнгСтрШаблон) Тогда 
					нСтр.Вывести(ГраницаСверху);
					СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
					нСтр = РегламентированнаяОтчетность.НоваяСтраница();
					нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
					нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
					нСтр.Вывести(ГраницаСнизу);
				КонецЕсли;
				нСтр.Вывести(МнгСтрШаблон);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	нСтр.Вывести(ГраницаСверху);
	Если Не нСтр.ПроверитьВывод(Подвал) Тогда 
		СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
		нСтр = РегламентированнаяОтчетность.НоваяСтраница();
		нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Заголовок_Стр2"));
	КонецЕсли;
	нСтр.Вывести(Подвал);
	СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
	
	нСтр = РегламентированнаяОтчетность.НоваяСтраница();
	нСтр.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	нСтр.Вывести(ПечатнаяФормаМакет.ПолучитьОбласть("Расписка"));
	СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(нСтр, "ОН00002");
	
	РегламентированнаяОтчетностьКлиентСервер.ПроставлениеНомеровЛистов(ЭтаФорма, , СтруктураРеквизитовФормы.СписокПечатаемыхЛистов);
	Возврат Истина;
КонецФункции

