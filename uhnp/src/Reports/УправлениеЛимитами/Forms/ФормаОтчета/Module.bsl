#Область ПараметрыЛимитирования 

&НаСервере
Функция ПараметрыЛимитированияПериода(Знач ВидБюджета, Знач ОтчетнаяДата, Знач Направление)
	
	Возврат КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(ВидБюджета, ОтчетнаяДата, Направление);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыЛимитированияБюджетаНаДату(ВидБюджета, Дата)
	
	Результат = Новый Структура("ВидБюджета, Период, ИспользоватьЛимитирование, ИспользоватьРезервирование, СпособОпределенияВалютыЛимитирования, 
								|ВалютаПоУмолчанию, ПериодичностьЛимитирования, ПериодичностьПланирования, КоличествоПериодовЛимитирования");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("НаДату",     Дата);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитирования.ПериодичностьПланирования КАК ПериодичностьПланирования,
	|	ПараметрыЛимитирования.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	ПараметрыЛимитирования.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
	|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитирования.КоличествоПериодовЛимитирования КАК КоличествоПериодовЛимитирования,
	|	ПараметрыЛимитирования.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитирования.КонтрольРезервов КАК КонтрольРезервов,
	|	ПараметрыЛимитирования.УчитыватьАналитикиСтатьиБюджетаПриКонтроле КАК УчитыватьАналитикиСтатьиБюджетаПриКонтроле,
	|	ПараметрыЛимитирования.ВалютаПоУмолчанию КАК ВалютаПоУмолчанию
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
	|	И ПараметрыЛимитирования.Период = &НаДату";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции   

&НаСервереБезКонтекста
Функция ПолучитьПараметрыЛимитированияБюджетаНаДатуПоНаправлению(ВидБюджета, Дата, Направление)
	
	Результат = Новый Структура("ВидБюджета, Период, ИспользоватьЛимитирование, ИспользоватьРезервирование, СпособОпределенияВалютыЛимитирования, 
								|ВалютаПоУмолчанию, ПериодичностьЛимитирования, ПериодичностьПланирования, КоличествоПериодовЛимитирования");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("НаДату",     Дата);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитирования.ПериодичностьПланирования КАК ПериодичностьПланирования,
	|	ПараметрыЛимитирования.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	ПараметрыЛимитирования.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
	|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитирования.КоличествоПериодовЛимитирования КАК КоличествоПериодовЛимитирования,
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитирования.КонтрольРезервов КАК КонтрольРезервов,
	|	ПараметрыЛимитирования.УчитыватьАналитикиСтатьиБюджетаПриКонтроле КАК УчитыватьАналитикиСтатьиБюджетаПриКонтроле,
	|	ПараметрыЛимитирования.ВалютаПоУмолчанию КАК ВалютаПоУмолчанию
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
	|	И &НаДату
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";             
	
	Если Направление = -1 Тогда  
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НаДату", "ПараметрыЛимитирования.Период < &НаДату");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " УБЫВ", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НаДату", "ПараметрыЛимитирования.Период > &НаДату");	
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыЗаполнения(ВидБюджета, Период) Экспорт
	
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПараметрыЛимитирования) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ВидБюджета", ВидБюджета);
	ПараметрыЗаполнения.Вставить("Период", НачалоГода(Период));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБюджета", ПараметрыЗаполнения.ВидБюджета);
	Запрос.УстановитьПараметр("НаДату",     ПараметрыЗаполнения.Период);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&НаДату КАК Период,
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияСрезПоследних.ПериодичностьПланирования КАК ПериодичностьПланирования,
	|	ПараметрыЛимитированияСрезПоследних.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КоличествоПериодовЛимитирования КАК КоличествоПериодовЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
	|	ПараметрыЛимитированияСрезПоследних.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольРезервов КАК КонтрольРезервов,
	|	ПараметрыЛимитированияСрезПоследних.ВалютаПоУмолчанию КАК ВалютаПоУмолчанию,
	|	ПараметрыЛимитированияСрезПоследних.ПланированиеЗакупок КАК ПланированиеЗакупок
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования.СрезПоследних(&НаДату, ВидБюджета = &ВидБюджета) КАК ПараметрыЛимитированияСрезПоследних";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ПараметрыЗаполнения;
	КонецЕсли;
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Если НЕ ПараметрыЗаполнения.Свойство(Колонка.Имя) Тогда
			ПараметрыЗаполнения.Вставить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат ПараметрыЗаполнения;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, Выборка);
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

&НаКлиенте
Процедура СпроситьПользователяОСозданииПериодаЛимитирования(Результат, Направление, ВыводитьСообщения)
	
	ЗначенияЗаполнения = ПолучитьПараметрыЗаполнения(Результат.ВидБюджета, Результат.ОтчетнаяДата);
	Если ЗначенияЗаполнения = Неопределено Тогда
		Шаблон = НСтр("ru = 'Параметры лимитирования на %1 год незаполнены.'");
		ПоказатьПредупреждение(, СтрШаблон(Шаблон, Формат(Год(Результат.ОтчетнаяДата),"ЧГ=0")));
		Возврат;
	КонецЕсли;
	
	Если Не ВыводитьСообщения Тогда
		ЗаполнитьЗначенияСвойств(Отчет, ЗначенияЗаполнения); 
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ДопПараметры.Вставить("Направление", 		Направление);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВопросОСозданииПериодаЛимитированияЗавершение", ЭтотОбъект, ДопПараметры);
	
	Шаблон = НСтр("ru = 'Параметры лимитирования на период не заполнены. Заполнить?'");
	ПоказатьВопрос(ОписаниеОповещения, Шаблон, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОСозданииПериодаЛимитированияЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;  
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеЗаписиПериодаЛимитирования", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитирования.ФормаЗаписи", 
				ДопПараметры, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиПериодаЛимитирования(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.ЗаписанПериод <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	СкопироватьНастройкиНаНовыйПериод(Результат.ВидБюджета, Отчет.ОтчетнаяДата, Результат.Период);
	ИзменитьПериод(ДопПараметры.Направление, Ложь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СкопироватьНастройкиНаНовыйПериод(ВидБюджета, ПериодИсточник, ПериодПолучатель)
	
	РегистрыСведений.ПараметрыЛимитирования.СкопироватьНастройкиПериода(ВидБюджета, ПериодИсточник, ПериодПолучатель);
	
КонецПроцедуры

#КонецОбласти  
 
#Область ОбработчикиСобытийТабличногоДокумента

 &НаКлиенте
Функция ВыполнитьАнализВыбранныхЯчеек(ДанныеЯчеек)
	
	ПараметрыКоманд = Новый Структура;
	
	ВыбраныЯчейкиСПолнымПериодом(ДанныеЯчеек, ПараметрыКоманд);
	ВыбраныЯчейкиСОрганизациями(ДанныеЯчеек, ПараметрыКоманд);
	
	Возврат ПараметрыКоманд;
	
КонецФункции

&НаКлиенте
Процедура ВыбраныЯчейкиСПолнымПериодом(ДанныеЯчеек, ДопПараметры)
	
	Если ТипЗнч(ДопПараметры) <> Тип("Структура") Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Данные", Новый Массив);
	ПараметрыКоманды.Вставить("ДанныеВыбрано", Новый Массив);
	ПараметрыКоманды.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ПараметрыКоманды.Вставить("ПериодичностьЛимитирования", Отчет.ПериодичностьЛимитирования);
	ПараметрыКоманды.Вставить("Предназначение", Отчет.Предназначение);
	ПараметрыКоманды.Вставить("НачалоПериода", НачалоГода(Отчет.ОтчетнаяДата));
	ПараметрыКоманды.Вставить("ОкончаниеПериода", НачалоДня(КонецГода(Отчет.ОтчетнаяДата)));
	
	ИменаСвойств = "ВидБюджета, ПериодЛимитирования, ЦФО, Проект, УОП, Сценарий";
	
	Для Каждого Ячейка Из ДанныеЯчеек Цикл
		
		Если Ячейка.Количество() <> 2 ИЛИ НЕ Ячейка.Свойство("ВидБюджета") ИЛИ НЕ Ячейка.Свойство("ПериодЛимитирования") Тогда
			Продолжить;
		КонецЕсли;
		
		Свойства = Новый Структура(ИменаСвойств);
		ЗаполнитьЗначенияСвойств(Свойства, Ячейка);
		ПараметрыКоманды.ДанныеВыбрано.Добавить(Свойства);
		
		Для Каждого ЦФОПроект Из Отчет.ЦФОПроекты Цикл
			Свойства = Новый Структура(ИменаСвойств);
			ЗаполнитьЗначенияСвойств(Свойства, Ячейка);
			ЗаполнитьЗначенияСвойств(Свойства, ЦФОПроект);
			ПараметрыКоманды.Данные.Добавить(Свойства);
		КонецЦикла;
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ВыбранныеПериоды", ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраныЯчейкиСОрганизациями(ДанныеЯчеек, ДопПараметры)
	
	Если ТипЗнч(ДопПараметры) <> Тип("Структура") Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Данные", Новый Массив);
	ПараметрыКоманды.Вставить("ДанныеВыбрано", Новый Массив);
	ПараметрыКоманды.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ПараметрыКоманды.Вставить("ПериодичностьЛимитирования", Отчет.ПериодичностьЛимитирования);
	ПараметрыКоманды.Вставить("Предназначение", Отчет.Предназначение);
	ПараметрыКоманды.Вставить("НачалоПериода", НачалоГода(Отчет.ОтчетнаяДата));
	ПараметрыКоманды.Вставить("ОкончаниеПериода", НачалоДня(КонецГода(Отчет.ОтчетнаяДата)));
	
	ЦФОПроектПериод.Очистить(); // Через этот реквизит формы устраняем дубли
	Для Каждого Ячейка Из ДанныеЯчеек Цикл
		
		Если Ячейка.Свойство("ВидБюджета")
			И Ячейка.Свойство("ПериодЛимитирования")
			И Ячейка.Свойство("ЦФО")
			И Ячейка.Свойство("Проект") Тогда
			
			Если ДобавитьВДанныеЦФОПроектПериод(Ячейка) Тогда
				ПараметрыКоманды.Данные.Добавить(Ячейка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	ПараметрыКоманды.ДанныеВыбрано = ПараметрыКоманды.Данные;
	
	ДопПараметры.Вставить("ВыбранныеЦФОПроект", ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольИсполненияВыбраныЯчейкиСПолнымПериодом(ДанныеЯчеек, ДопПараметры)
	
	Если ТипЗнч(ДопПараметры) <> Тип("Структура") Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Данные", Новый Массив);
	ПараметрыКоманды.Вставить("ДанныеВыбрано", Новый Массив);
	ПараметрыКоманды.Вставить("Валюты", Новый Массив);
	ПараметрыКоманды.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ПараметрыКоманды.Вставить("ПериодичностьЛимитирования", Отчет.ПериодичностьЛимитирования);
	ПараметрыКоманды.Вставить("Предназначение", Отчет.Предназначение);
	ПараметрыКоманды.Вставить("НачалоПериода", НачалоГода(Отчет.ОтчетнаяДата));
	ПараметрыКоманды.Вставить("ОкончаниеПериода", НачалоДня(КонецГода(Отчет.ОтчетнаяДата)));
	
	ИменаСвойств = "ВидБюджета, ПериодЛимитирования, Валюта, ЦФО, Проект";
	
	Для Каждого Ячейка Из ДанныеЯчеек Цикл
		
		Если Ячейка.Количество() <> 1 ИЛИ НЕ Ячейка.Свойство("ПериодЛимитирования") Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаНачалаПериода = ПолучитьНачалоПериода(Ячейка.ПериодЛимитирования);
		Если ДатаНачалаПериода = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Свойства = Новый Структура("ВидБюджета, ПериодЛимитирования", Отчет.ВидБюджета, Ячейка.ПериодЛимитирования);
		ПараметрыКоманды.ДанныеВыбрано.Добавить(Свойства);
		
		Для Каждого ЦФОПроект Из Отчет.ЦФОПроектыПериодыЛимитированияВалюты Цикл
			
			Если ЦФОПроект.ДатаНачала >= ДатаНачалаПериода Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыКоманды.Валюты.Добавить(ЦФОПроект.Валюта);
			
			Данные = Новый Структура(ИменаСвойств);
			ЗаполнитьЗначенияСвойств(Данные, Свойства);
			ЗаполнитьЗначенияСвойств(Данные, ЦФОПроект, "ЦФО, Проект, Валюта");
			ПараметрыКоманды.Данные.Добавить(Данные);
		КонецЦикла;
		
	КонецЦикла;
	
	ПараметрыКоманды.Валюты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ПараметрыКоманды.Валюты);
	
	ДопПараметры.Вставить("ВыбранныеПериоды", ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольИсполненияВыбраныЯчейкиПолнымНаборомАналитикЛимитирования(ДанныеЯчеек, ДопПараметры)
	
	Если ТипЗнч(ДопПараметры) <> Тип("Структура") Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ПараметрыКоманды.Вставить("Данные", Новый Массив);
	ПараметрыКоманды.Вставить("ДанныеВыбрано", Новый Массив);
	
	ОбязательныеСвойства = "ЦФО,Проект,СтатьяБюджета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6,ПериодЛимитирования,Валюта,Доступно";
	
	СтруктураЭталон = Новый Структура(ОбязательныеСвойства);
	
	Для Каждого Ячейка Из ДанныеЯчеек Цикл
		
		Если НЕ СтруктураСоответствуетЭталону(Ячейка, СтруктураЭталон) Тогда
			Продолжить;
		КонецЕсли;
		
		Свойства = Новый Структура(ОбязательныеСвойства);
		ЗаполнитьЗначенияСвойств(Свойства, Ячейка);
		ПараметрыКоманды.Данные.Добавить(Свойства);
		ПараметрыКоманды.ДанныеВыбрано.Добавить(Свойства);
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ПолныйНаборАналитик", ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураСоответствуетЭталону(Структура, СтруктураЭталон)
	
	Результат = Истина;
	Для Каждого КлючЗначение Из СтруктураЭталон Цикл
		Результат = Результат И Структура.Свойство(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьНачалоПериода(ПериодЛимитирования)
	
	СтруктураПоиска = Новый Структура("ПериодЛимитирования", ПериодЛимитирования);
	
	Строки = Отчет.Периоды.НайтиСтроки(СтруктураПоиска);
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Строки[0].НачалоПериода;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЯчейкиДляУстановкиЛимитов(АдресДанныеРасшифровки, МассивИдентификаторовРасшифровки, ВидБюджета)
	
	ДанныеВыделенныхЯчеек = ДанныеРасшифровкиПолей(АдресДанныеРасшифровки, МассивИдентификаторовРасшифровки);
	
	ЯчейкиДляУстановки = Новый Массив;	
	Для каждого ДанныеЯчейки Из ДанныеВыделенныхЯчеек Цикл		
		ДанныеЯчейки.Вставить("ВидБюджета", ВидБюджета);
		ЯчейкиДляУстановки.Добавить(ДанныеЯчейки);
	КонецЦикла;
	
	Возврат ЯчейкиДляУстановки;
	
КонецФункции

&НаКлиенте
Функция ИдентификаторыРасшифровкиВыделенныхОбластей(ТабДок)
	
	МассивИдентификаторовРасшифровки = Новый Массив;
	Для Каждого ВыделеннаяОбласть Из ТабДок.ВыделенныеОбласти Цикл
		Если ТипЗнч(ВыделеннаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Для НомерСтолбца = ВыделеннаяОбласть.Лево По ВыделеннаяОбласть.Право Цикл
				Для НомерСтроки = ВыделеннаяОбласть.Верх По ВыделеннаяОбласть.Низ Цикл
					Ячейка = ТабДок.Область(НомерСтроки, НомерСтолбца, НомерСтроки, НомерСтолбца);
					Если Ячейка.ТипОбласти <> ПредопределенноеЗначение("ТипОбластиЯчеекТабличногоДокумента.Прямоугольник") Тогда
						Продолжить;
					КонецЕсли;
					Если Ячейка.Расшифровка <> Неопределено Тогда
						МассивИдентификаторовРасшифровки.Добавить(Ячейка.Расшифровка);
					КонецЕсли;	
				КонецЦикла;
			КонецЦикла;	
		КонецЕсли;		
	КонецЦикла;
	
	Возврат МассивИдентификаторовРасшифровки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеРасшифровкиПолей(АдресРасшифровки, МассивИдентификаторовРасшифровки)
	
	МассивДанных = Новый Массив;
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровки);
	Для каждого Идентификатор Из МассивИдентификаторовРасшифровки Цикл
		ДанныеПоля = ДанныеРасшифровкиПоля(ДанныеРасшифровки, Идентификатор);
		МассивДанных.Добавить(ДанныеПоля);
	КонецЦикла;
	
	Возврат МассивДанных;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеРасшифровкиПоля(ДанныеРасшифровки, ИдентификаторРасшифровки)
		
	СтруктураПолей = Новый Структура;
	
	ЭлементыРасшифровки = ДанныеРасшифровки.Элементы[ИдентификаторРасшифровки];
	Для каждого Элемент Из ЭлементыРасшифровки.ПолучитьПоля() Цикл
		СтруктураПолей.Вставить(Элемент.Поле, Элемент.Значение);
	КонецЦикла;
	
	Возврат СтруктураПолей;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеРасшифровки(АдресДанныеРасшифровки, ИДРасшифровки)
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресДанныеРасшифровки);
	
	Результат = Новый Структура;
	
	ДанныеРасшифровкиПоляРекурсивно(ДанныеРасшифровки, ИДРасшифровки, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДанныеРасшифровкиПоляРекурсивно(ДанныеРасшифровки, ИДРасшифровки, Результат)
	
	ЭлементРасшифровки = ДанныеРасшифровки.Элементы[ИДРасшифровки];
	
	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		// Получаем данные поля
		Для каждого Элемент Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			Результат.Вставить(Элемент.Поле, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	
	// Получаем данные родителей
	Для Каждого Родитель Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		ДанныеРасшифровкиПоляРекурсивно(ДанныеРасшифровки, Родитель.Идентификатор, Результат);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ДобавитьВДанныеЦФОПроектПериод(Данные)
	
	СтруктураПоиска = Новый Структура("ПериодЛимитирования, ВидБюджета, ЦФО, Проект");
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, Данные);
	
	Если ЦФОПроектПериод.НайтиСтроки(СтруктураПоиска).Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЦФОПроектПериод.Добавить(), СтруктураПоиска);
	
	Возврат Истина;
	
КонецФункции  

&НаКлиенте
Процедура ОбработкаДополнительнойРасшифровкиКонтрольИсполненияЗавершение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
		
	Если ВыполненноеДействие = Неопределено Тогда
		Возврат;
	ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Оформить Тогда
		// Оформление
		//КомпоновщикНастроекКонтрольИсполнения.ЗагрузитьНастройки(ПараметрВыполненногоДействия);
		СформироватьОтчетКонтрольИсполненияНаСервере();
	ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		// Открытие значений
		ПоказатьЗначение(, ПараметрВыполненногоДействия);
	ИначеЕсли ВыполненноеДействие = "СоздатьКорректировкуЛимитов" Тогда
		СоздатьКорректировкуЛимитовПоДаннымРасшифровки(
			Отчет.ВидБюджета,
			ДополнительныеПараметры.ПараметрыКоманд.ПолныйНаборАналитик);
	ИначеЕсли ВыполненноеДействие = "СоздатьЗаявкуНаКорректировкуЛимитов" Тогда
		СоздатьЗаявкуНаКорректировкуЛимитовПоДаннымРасшифровки(
			Отчет.ВидБюджета,
			ДополнительныеПараметры.ПараметрыКоманд.ПолныйНаборАналитик);
	КонецЕсли;

КонецПроцедуры

