&НаКлиенте
Процедура ВалютаУправленческогоУчетаНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка 	= Ложь;
	ОписаниеОповещения 		= Новый ОписаниеОповещения("ОбработкаНастройкиВалютаРегламентированногоУчета", ЭтотОбъект); 
	ПараметрыОткрытияОбработки = Новый Структура;
	ПараметрыОткрытияОбработки.Вставить("НеОбновлятьИнтерфейс");
 	ОткрытьФорму("Обработка.ПанельАдминистрированияУХ.Форма.ОбщиеНастройки", ПараметрыОткрытияОбработки,,,,, ОписаниеОповещения);
 
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьПланированияПриИзменении(Элемент)

	ПериодичностьПланированияПриИзмененииНаСервере();
	
КонецПроцедуры   

&НаСервере
Процедура ПериодичностьПланированияПриИзмененииНаСервере()
	
	Перем ОшибкаСравнения;       
	
	ПериодичностьЛимитирования = КонтрольЛимитовУХ.ПериодичностьЛимитирования(Отчет.ВидБюджета, Отчет.ОтчетнаяДата); 
	КонтрольЛимитовУХ.СравнитьПериодичностьПланированияЛимитирования(Отчет.ПериодичностьПланирования, ПериодичностьЛимитирования, ОшибкаСравнения); 
	                                                   
	Если ОшибкаСравнения = Истина Тогда 
		Отчет.ПериодичностьПланирования = ТекущаяПериодичностьПланирования;   
	Иначе
		ИзменениеПараметровЛимитированияНаСервере();  
		
		СписокПериодичностиЛимитирования = КонтрольЛимитовУХ.ДоступныеПериодичностиЛимитирования(Отчет.ВидБюджета, Отчет.ОтчетнаяДата);
		Элементы.ПериодичностьЛимитирования.СписокВыбора.ЗагрузитьЗначения(СписокПериодичностиЛимитирования); 	
		
		ТекущаяПериодичностьПланирования = Отчет.ПериодичностьПланирования;
	КонецЕсли;  		
	
КонецПроцедуры   

&НаКлиенте
Процедура ПараметрыБюджетаПриИзменении(Элемент)

	Если Элемент.Имя = "РежимКонтроляЛимитов" Тогда
		Отчет.КонтрольРезервов = Отчет.КонтрольЛимитов;
	КонецЕсли;
	
	ИзменениеПараметровЛимитированияНаСервере();   
	ИзменитьПериод(0);
	
КонецПроцедуры   

&НаКлиенте
Процедура РежимКонтроляРезервовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ДанныеВыбора = Новый СписокЗначений;
	Если Отчет.КонтрольЛимитов = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.НеКонтролировать") Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.НеКонтролировать"));
	ИначеЕсли Отчет.КонтрольЛимитов = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Информировать") Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.НеКонтролировать"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Информировать"));
	ИначеЕсли Отчет.КонтрольЛимитов = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Блокировать") Тогда
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.НеКонтролировать"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Информировать"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Блокировать"));
	КонецЕсли;
	
КонецПроцедуры

