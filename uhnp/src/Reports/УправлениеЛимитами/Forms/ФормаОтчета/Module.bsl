&НаСервере
Функция СписокВыбораРежимаКонтроляРезервов(РежимКонтроляЛимитов, КакВБюджете = Ложь)
	
	ДанныеВыбора1 = Неопределено;
	СтандартнаяОбработка1 = Истина;
	Параметры1 = Новый Структура;
	Параметры1.Вставить("КонтрольЛимитов", РежимКонтроляЛимитов);
	Параметры1.Вставить("КакВБюджете", КакВБюджете);
	
	Перечисления.РежимыКонтроляДокументов.ОбработкаПолученияДанныхВыбора(ДанныеВыбора1, Параметры1, СтандартнаяОбработка1);
	
	Возврат ДанныеВыбора1;
	
КонецФункции
	
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Действие = ДействиеВыбор.Получить(Поле.Имя);
	
	ВыполнитьДействиеДляТекущейСтроки(ВыбраннаяСтрока, Действие, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьРедактированиеСтатьи(Статья)
	
	Если РазрешенныеСтатьи.НайтиПоЗначению(Статья) = Неопределено Тогда
		РазрешенныеСтатьи.Добавить(Статья);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
										СписокСтатей, 
										"РазрешенныеСтатьи", 
										РазрешенныеСтатьи.ВыгрузитьЗначения());
		Элементы.СписокСтатей.Обновить();
	КонецЕсли;
	
	Оповестить("ИзменениеГодаФормыСтатьи");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеДляТекущейСтроки(Знач ВыбраннаяСтрока, Знач Действие, Знач Элемент, СтандартнаяОбработка = Истина)
	
	Если Действие = Неопределено 
		Или Элемент.ТекущиеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеОписание = "ИсточникДляЛимитовВидБюджета, КонтрольЛимитов, КонтрольРезервов, Ссылка, " 
							+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("КонтролироватьАналитику%1");
	ТекущиеДанные = Новый Структура(ТекущиеДанныеОписание);
	
	Выбор = Новый СписокЗначений;

	Если Действие = "ИзменениеКонтроля" И Элемент.ТекущиеДанные.МожноИзменятьДействие = Ложь Тогда
		Выбор.Добавить(НСтр("ru = 'Статья входит в группу статей. Изменить параметры контроля можно только для всей группы статей в целом.'"));
	ИначеЕсли (Элемент.ТекущиеДанные.ЗапретРедактирования = 0)Тогда
		Если ДоступнаНастройкаПараметровЛимитирования Тогда
			Выбор.Добавить(НСтр("ru = 'Включить возможность редактирования параметров контроля статьи?'"));
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("СтатьяБюджета", ВыбраннаяСтрока);
			ДопПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);
			Оповещение = Новый ОписаниеОповещения("ВключитьРедактированиеСтатьиЗавершение", ЭтотОбъект, ДопПараметры);
		Иначе
			Выбор.Добавить(НСтр("ru = 'Параметры контроля статьи изменить нельзя, так как она уже использована в периоде.'"));	
		КонецЕсли;
	КонецЕсли;
	
	Если Выбор.Количество() > 0 Тогда
		
		Если Оповещение = Неопределено Тогда
			Оповещение = Новый ОписаниеОповещения();
		КонецЕсли;
		
		ПоказатьВыборИзСписка(Оповещение, Выбор, Элементы.СписокСтатейКонтрольЛимитов);
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, Элемент.ТекущиеДанные, ТекущиеДанныеОписание);
	ТекущиеДанные.Вставить("ВидБюджета", 	Отчет.ВидБюджета);
	ТекущиеДанные.Вставить("ОтчетнаяДата", 	Отчет.ОтчетнаяДата);
	
	Если Действие = "ИзменениеКонтроля" Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("СтатьяБюджета", ВыбраннаяСтрока);
		ДопПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);
		
		Оповещение = Новый ОписаниеОповещения("ВыборКонтрольЛимитовЗавершение", ЭтотОбъект, ДопПараметры);
		
		КонтрольЛимитов = "ВсеЗначения";
		Выбор = СпискиВыбораКонтрольРезервов[КонтрольЛимитов];
		ТекущееЗначение = Выбор.НайтиПоЗначению(Элемент.ТекущиеДанные.КонтрольЛимитов);
		
		ПоказатьВыборИзСписка(Оповещение, Выбор, Элементы.СписокСтатейКонтрольЛимитов, ТекущееЗначение);
		
	ИначеЕсли Действие = "ИзменениеРезерва" Тогда
		
		ТекущиеДанныеОписание = "ИсточникДляЛимитовВидБюджета, КонтрольЛимитов, КонтрольРезервов";
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("СтатьяБюджета", ВыбраннаяСтрока);
		ДопПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);
		
		Оповещение = Новый ОписаниеОповещения("ВыборКонтрольРезервовЗавершение", ЭтотОбъект, ДопПараметры);
		
		КонтрольЛимитов = "ВсеЗначения";
		Выбор = СпискиВыбораКонтрольРезервов[КонтрольЛимитов];
		ТекущееЗначение = Выбор.НайтиПоЗначению(Элемент.ТекущиеДанные.КонтрольРезервов);
		
		ПоказатьВыборИзСписка(Оповещение, Выбор, Элементы.СписокСтатейКонтрольРезервов, ТекущееЗначение);
		
	ИначеЕсли Действие = "КонтрольАналитики1" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные["ВидАналитики"+"1"]) Тогда
			УстановитьПараметрСтатьиБюджета(ТекущиеДанные, Ложь, "КонтролироватьАналитику1", Не ТекущиеДанные.КонтролироватьАналитику1); 
			Элементы.СписокСтатей.Обновить(); 
			Оповестить("ИзменениеГодаФормыСтатьи");
		КонецЕсли;
	ИначеЕсли Действие = "КонтрольАналитики2" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные["ВидАналитики"+"2"]) Тогда
			УстановитьПараметрСтатьиБюджета(ТекущиеДанные, Ложь, "КонтролироватьАналитику2", Не ТекущиеДанные.КонтролироватьАналитику2); 
			Элементы.СписокСтатей.Обновить(); 
			Оповестить("ИзменениеГодаФормыСтатьи");
		КонецЕсли;
	ИначеЕсли Действие = "КонтрольАналитики3" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные["ВидАналитики"+"3"]) Тогда
			УстановитьПараметрСтатьиБюджета(ТекущиеДанные, Ложь, "КонтролироватьАналитику3", Не ТекущиеДанные.КонтролироватьАналитику3); 
			Элементы.СписокСтатей.Обновить(); 
			Оповестить("ИзменениеГодаФормыСтатьи");
		КонецЕсли;
	ИначеЕсли Действие = "КонтрольАналитики4" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные["ВидАналитики"+"4"]) Тогда
			УстановитьПараметрСтатьиБюджета(ТекущиеДанные, Ложь, "КонтролироватьАналитику4", Не ТекущиеДанные.КонтролироватьАналитику4); 
			Элементы.СписокСтатей.Обновить();  
			Оповестить("ИзменениеГодаФормыСтатьи");
		КонецЕсли;
	ИначеЕсли Действие = "КонтрольАналитики5" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные["ВидАналитики"+"5"]) Тогда
			УстановитьПараметрСтатьиБюджета(ТекущиеДанные, Ложь, "КонтролироватьАналитику5", Не ТекущиеДанные.КонтролироватьАналитику5);  
			Элементы.СписокСтатей.Обновить();     
			Оповестить("ИзменениеГодаФормыСтатьи");
		КонецЕсли;
	ИначеЕсли Действие = "КонтрольАналитики6" Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные["ВидАналитики"+"6"]) Тогда
			УстановитьПараметрСтатьиБюджета(ТекущиеДанные, Ложь, "КонтролироватьАналитику6", Не ТекущиеДанные.КонтролироватьАналитику6); 
			Элементы.СписокСтатей.Обновить();  
			Оповестить("ИзменениеГодаФормыСтатьи");
		КонецЕсли;  
	ИначеЕсли Действие = "ИзменениеСтатей" Тогда		

		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("СтатьяБюджета", ВыбраннаяСтрока);
		ДопПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);
			
		Оповещение = Новый ОписаниеОповещения("ВыборГруппаСтатейЗавершение", ЭтотОбъект, ДопПараметры);
		
		Выбор = СписокГруппСтатей;
		ТекущееЗначение = Выбор.НайтиПоЗначению(Элемент.ТекущиеДанные.ГруппаСтатей);
		
		ПоказатьВыборИзСписка(Оповещение, Выбор, Элементы.СписокСтатейГруппаСтатей, ТекущееЗначение);

	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ВключитьРедактированиеСтатьиЗавершение(Результат, ДопПараметры) Экспорт
	ВключитьРедактированиеСтатьи(ДопПараметры.СтатьяБюджета);
КонецПроцедуры

&НаКлиенте
Процедура ДействиеСоСпискомСтатей(Команда)
	Действие = СтрЗаменить(Команда.Имя, "ДействиеСоСпискомСтатей", "");
	Элемент = Элементы.СписокСтатей;
	ВыполнитьДействиеДляТекущейСтроки(Элементы.СписокСтатей.ТекущаяСтрока, 
										Действие, 
										Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВыборКонтрольЛимитовЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовоеЗначение = Результат.Значение;
	ТекущиеДанные = ДопПараметры.ТекущиеДанные; 
	
	КонтрольУХКлиентСервер.ПриИзмененииКонтроляЛимитов(НовоеЗначение, ТекущиеДанные.КонтрольРезервов);
	
	ИмяПараметра = "КонтрольЛимитов, КонтрольРезервов";		  
	УстановитьПараметрСтатьиБюджета(ДопПараметры.ТекущиеДанные,
									Результат.Значение = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка"),
									ИмяПараметра,
									Результат.Значение);
	
	Элементы.СписокСтатей.Обновить();

	Оповестить("ИзменениеГодаФормыСтатьи");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборГруппаСтатейЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтатьяБюджета = ДопПараметры.СтатьяБюджета;
	ТекущиеДанные = ДопПараметры.ТекущиеДанные; 
	
	УстановитьПараметрЛимитированияГруппыСтатейСостав(СтатьяБюджета, Отчет.ВидБюджета, Отчет.ОтчетнаяДата, Результат.Значение);
	
	Элементы.СписокСтатей.Обновить();
	
	Оповестить("ИзменениеГодаФормыСтатьи");
	
КонецПроцедуры  

&НаСервереБезКонтекста
Процедура УстановитьПараметрЛимитированияГруппыСтатейСостав(СтатьяБюджета, ВидБюджета, Период, ГруппаСтатей)
		
	РегистрыСведений.ПараметрыЛимитированияГруппыСтатейСостав.ВыполнитьУстановкуПараметрыЛимитированияГруппыСтатей(ВидБюджета,
																								СтатьяБюджета,
																								Период,
																								ГруппаСтатей);
КонецПроцедуры 

&НаКлиенте
Процедура ВыборКонтрольРезервовЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовоеЗначение = Результат.Значение;
	ТекущиеДанные = ДопПараметры.ТекущиеДанные; 
	
	КонтрольУХКлиентСервер.ПриИзмененииКонтроляРезервов(ТекущиеДанные.КонтрольЛимитов, НовоеЗначение);
	УстановитьПараметрСтатьиБюджета(ТекущиеДанные,
									Результат.Значение = ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка"),
									"КонтрольРезервов",
									Результат.Значение);
	
	Элементы.СписокСтатей.Обновить();

	Оповестить("ИзменениеГодаФормыСтатьи");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьПараметрСтатьиБюджета(ДанныеСтроки, ИсточникДляЛимитовВидБюджета, ИмяПараметра, Значение)
	
	КонтролироватьСоставАналитикСтатейНаУровнеГруппы = ПолучитьФункциональнуюОпцию("КонтролироватьСоставАналитикСтатейНаУровнеГруппы");
	ПараметрыМассивом = СтрРазделить(ИмяПараметра, ",", Ложь);
	
	ПараметрыСтатьи = РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.ОписаниеПараметровСтатьи();
	ЗаполнитьЗначенияСвойств(ПараметрыСтатьи, ДанныеСтроки);
	ПараметрыСтатьи.ИсточникДляЛимитовВидБюджета = ИсточникДляЛимитовВидБюджета;    
	
	Для Каждого ЭлементПараметр Из ПараметрыМассивом Цикл
		Если КонтролироватьСоставАналитикСтатейНаУровнеГруппы И СтрНайти(АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("КонтролироватьАналитику%1"), ЭлементПараметр) > 0 И Значение = Истина Тогда
			НомерАналитики = Прав(ЭлементПараметр, 1);
			ГруппаСтатей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.Ссылка, "Родитель"); 
			Если ЗначениеЗаполнено(ГруппаСтатей) И НЕ ЗначениеЗаполнено(ГруппаСтатей["ВидАналитики" + НомерАналитики]) Тогда
				ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Контроль возможен только по аналитикам, определенным на уровне группы статей!'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
		ПараметрыСтатьи[СокрЛП(ЭлементПараметр)] = Значение;            
	КонецЦикла;                                                      
	
	РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.ВыполнитьУстановкуПараметровСтатьи(ДанныеСтроки.ВидБюджета,
																								ДанныеСтроки.Ссылка,
																								ДанныеСтроки.ОтчетнаяДата,
																								ПараметрыСтатьи);
КонецПроцедуры    
																							
#КонецОбласти 

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокГрупп

&НаКлиенте
Процедура СписокГруппВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  

	ТекущиеДанныеОписание = "Владелец, ГруппаСтатей, ИнаяПериодичность, Периодичность, " 
							+ "ИноеДействие, КонтрольПоГруппе, КонтрольЛимитов, КонтрольРезервов";
							
	ТекущиеДанные = Новый Структура(ТекущиеДанныеОписание);  
	Действие = ДействиеГруппыВыбор.Получить(Поле.Имя);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, Элемент.ТекущиеДанные, ТекущиеДанныеОписание);
	ТекущиеДанные.Вставить("ОтчетнаяДата", 	Отчет.ОтчетнаяДата); 
	ТекущиеДанные.Вставить("Действие", 		Действие);
	ТекущиеДанные.Вставить("ЭлементТекущиеДанные", Элемент.ТекущиеДанные);
	ТекущиеДанные.Вставить("ВидБюджета", 	Отчет.ВидБюджета);
	
	Если Действие = "ИзменениеПериодичности" Тогда
				
		Оповещение = Новый ОписаниеОповещения("ИзменениеПараметровСтатей", ЭтотОбъект, ТекущиеДанные);  
		ТекущееЗначение = СписокВыбораПериодичностьГруппСтатей.НайтиПоЗначению(ТекущиеДанные.Периодичность);
		ПоказатьВыборИзСписка(Оповещение, СписокВыбораПериодичностьГруппСтатей, Элемент, ТекущееЗначение); 
		
	ИначеЕсли Действие = "ОткрытиеГруппы" Тогда  
		
		ПоказатьЗначение(, ТекущиеДанные.ГруппаСтатей);
		
	ИначеЕсли Действие = "КонтрольПоГруппе" Тогда
		
		Оповещение = Новый ОписаниеОповещения("ИзменениеПараметровСтатей", ЭтотОбъект, ТекущиеДанные); 
		ВыполнитьОбработкуОповещения(Оповещение, Истина);
		
	ИначеЕсли Действие = "КонтрольЛимитов" Тогда   
		
		Оповещение = Новый ОписаниеОповещения("ИзменениеПараметровСтатей", ЭтотОбъект, ТекущиеДанные);
		Выбор = Новый СписокЗначений;
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка"), Нстр("ru = '<Как в бюджете>'"));
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Блокировать"));
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Информировать"));
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.НеКонтролировать"));
		
		ТекущееЗначение = Выбор.НайтиПоЗначению(ТекущиеДанные.КонтрольЛимитов);   
		ПоказатьВыборИзСписка(Оповещение, Выбор, Элемент, ТекущееЗначение);

	ИначеЕсли Действие = "КонтрольРезервов" Тогда  
		
		Оповещение = Новый ОписаниеОповещения("ИзменениеПараметровСтатей", ЭтотОбъект, ТекущиеДанные);
		Выбор = Новый СписокЗначений;
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка"), Нстр("ru = '<Как в бюджете>'"));
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Блокировать"));
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.Информировать"));
		Выбор.Добавить(ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.НеКонтролировать"));
		
		ТекущееЗначение = Выбор.НайтиПоЗначению(ТекущиеДанные.КонтрольЛимитов);   
		ПоказатьВыборИзСписка(Оповещение, Выбор, Элемент, ТекущееЗначение);
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокГруппПриАктивизацииСтроки(Элемент)
	
	СоставГруппы.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	Если Элементы.СписокГрупп.ТекущиеДанные = Неопределено Тогда           
		ГруппаСтатей = Неопределено;
	Иначе
		ГруппаСтатей = Элементы.СписокГрупп.ТекущиеДанные.Ссылка;
	КонецЕсли;    
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СоставГруппы,
														"Период", 
														Отчет.ОтчетнаяДата, 
														ВидСравненияКомпоновкиДанных.Равно,
														"Период",
														Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СоставГруппы,
														"ВидБюджета", 
														Отчет.ВидБюджета, 
														ВидСравненияКомпоновкиДанных.Равно,
														"ВидБюджета",
														Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СоставГруппы,
														"ГруппаСтатей", 
														ГруппаСтатей, 
														ВидСравненияКомпоновкиДанных.Равно,
														"ГруппаСтатей",
														Истина);  

	Если Элементы.ГруппаСоставГруппы.Видимость = Истина 
		И Элементы.СоставГруппы.Видимость = Истина Тогда
		Элементы.СоставГруппы.Обновить();
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокГруппСтатей()
	
	СписокГруппСтатей = Справочники.ГруппыСтатейБюджета.СписокЗначенийГруппСтатей(Отчет.ВидБюджета);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставГруппыПослеУдаления(Элемент)
	
	Оповестить("ИзменениеГодаФормыСтатьи");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокГруппОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ДопПараметры.Вставить("ОтчетнаяДата", Отчет.ОтчетнаяДата);
	ДопПараметры.Вставить("ГруппаСтатей", НовыйОбъект);
	ДопПараметры.Вставить("Периодичность", ПредопределенноеЗначение("Перечисление.Периодичность.ПустаяСсылка"));
	ДопПараметры.Вставить("КонтрольПоГруппе", Ложь);
	ДопПараметры.Вставить("КонтрольЛимитов", ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка"));
	ДопПараметры.Вставить("КонтрольРезервов",ПредопределенноеЗначение("Перечисление.РежимыКонтроляДокументов.ПустаяСсылка"));
	
	УстановитьПараметрГруппыСтатейБюджета(ДопПараметры);
	
КонецПроцедуры

#КонецОбласти    

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставГруппы 

&НаКлиенте
Процедура СоставГруппыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь; 
	
	ТекущаяСтрока = Элементы.СписокГрупп.ТекущиеДанные;     
	
	Если ТекущаяСтрока = Неопределено Тогда            
		Возврат;
	КонецЕсли;  

	ЗначенияЗаполнения = Новый Структура;  
	ЗначенияЗаполнения.Вставить("ВидБюджета", ТекущаяСтрока.Владелец);         
	
	ПараметрыКлюча = Новый Массив;
	ПараметрыКлюча.Добавить(Новый Структура("Период, ВидБюджета, СтатьяБюджета",
			ТекущаяСтрока.Период, ТекущаяСтрока.Владелец, Элементы.СоставГруппы.ТекущиеДанные.СтатьяБюджета));
	
	КлючЗаписиРегистра = Новый ("РегистрСведенийКлючЗаписи.ПараметрыЛимитированияГруппыСтатейСостав", ПараметрыКлюча);
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав.Форма.ФормаЗаписи", 
					Новый Структура("Ключ, ЗначенияЗаполнения", КлючЗаписиРегистра, ЗначенияЗаполнения));  
	
КонецПроцедуры

#КонецОбласти   

#Область ОбработчикиСобытийЭлементовСписокЗаявокНаКорректировку

&НаКлиенте
Процедура СписокЗаявокНаКорректировкуПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборКорректировокПоЗаявке();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьКорректировкиПоЗаявке(Команда)

	Кнопка = Элементы.СписокЗаявокНаКорректировкуПоказыватьКорректировкиПоЗаявке;
	Кнопка.Пометка = Не Кнопка.Пометка;
	ПоказыватьКорректировкиПоЗаявке = Кнопка.Пометка;
	
	Если Не ПоказыватьКорректировкиПоЗаявке Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокКорректировок,
				"Основание", Неопределено, ВидСравненияКомпоновкиДанных.Равно, , 
				Ложь, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			КонецЕсли; 
			
	УстановитьОтборКорректировокПоЗаявке();
			
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборКорректировокПоЗаявке()
	
	Если ПоказыватьКорректировкиПоЗаявке Тогда
		ТД = Элементы.СписокЗаявокНаКорректировку.ТекущиеДанные;
		Если ТД = Неопределено Тогда
			Основание = Неопределено;
		Иначе
			Основание = ТД.Ссылка;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокКорректировок,
				"Основание", Основание, ВидСравненияКомпоновкиДанных.Равно, , 
				Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовТабличныйДокументКонтрольИсполнения

&НаКлиенте
Процедура ТабличныйДокументКонтрольИсполненияПриАктивизации(Элемент)
	
	ПодключитьОбработчикОжидания("ДоступностьКнопокКонтрольИсполнения", 0.1, Истина);

КонецПроцедуры  

&НаКлиенте
Процедура ТабличныйДокументКонтрольИсполненияОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	ОбработатьРасшифровкуКонтрольИсполнения(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры);
	
КонецПроцедуры 

&НаКлиенте
Процедура ТабличныйДокументКонтрольИсполненияОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	ОбработатьРасшифровкуКонтрольИсполнения(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРасшифровкуКонтрольИсполнения(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Перем ПараметрыКоманды;
	
	// Новое
	ДанныеЯчеек = ВыделенныеЯчейкиДляКонтроляИсполнения();
	Если ДанныеЯчеек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(
		АдресДанныеРасшифровкиКонтрольИсполнения, 
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемаКомпоновкиДанныхКонтрольИсполнения));
	
	ДоступныеДействия = Новый Массив;
	ДополнительныеПунктыМеню = Новый СписокЗначений;
	
	ДопПараметрыКоманд = Новый Соответствие;
	
	ПараметрыКоманд = КонтрольИсполненияВыполнитьАнализДанныхЯчеек(ДанныеЯчеек);
	Если ПараметрыКоманд.Свойство("ПолныйНаборАналитик", ПараметрыКоманды)
		И ПараметрыКоманды.ДанныеВыбрано.Количество() > 0 Тогда
		
		// Корректировка лимитов
		Шаблон = НСтр("ru = 'Создать корректировку лимитов (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманды.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("СоздатьКорректировкуЛимитов", Текст);
		//
		// Заявка на корректировку лимитов
		Шаблон = НСтр("ru = 'Создать заявку на корректировку лимитов (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманды.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("СоздатьЗаявкуНаКорректировкуЛимитов", Текст);

	КонецЕсли;
		
	Если ДополнительныеПунктыМеню.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	
	ДополнительныеПараметры.Вставить("ДанныеЯчеек", ДанныеЯчеек);
	ДополнительныеПараметры.Вставить("ПараметрыКоманд", ПараметрыКоманд);
	ДополнительныеПараметры.Вставить("ДопПараметрыКоманд", ДопПараметрыКоманд);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаДополнительнойРасшифровкиКонтрольИсполненияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещения, Расшифровка, ДоступныеДействия, ДополнительныеПунктыМеню,,Элемент);
	
КонецПроцедуры


