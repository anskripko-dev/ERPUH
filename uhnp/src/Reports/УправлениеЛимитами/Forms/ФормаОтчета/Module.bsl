	НастроитьКнопку(Элементы.СоздатьЗаявкуНаКорректировкуЛимитов,	НСтр("ru = 'Создать заявку на корректировку лимитов'"), "ПолныйНаборАналитик", ПараметрыКоманд);
	
КонецПроцедуры 

&НаКлиенте
Процедура СоздатьЗаявкуНаКорректировкуЛимитовПоДаннымРасшифровки(ВидБюджета, ПараметрыКоманды)
	
	Если НЕ СоздатьЗаявкуНаКорректировкуЛимитовДанныеКорректны(ПараметрыКоманды) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Создание заявки на корректировку в разных валютах невозможно.'"));
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВидБюджета", ПараметрыКоманды.ВидБюджета);
	ЗначенияЗаполнения.Вставить("ПланыПоБюджетам", ПараметрыКоманды.Данные);
	Для Каждого Строка Из ПараметрыКоманды.Данные Цикл
		
		Строка.Вставить("НачалоПериода", Строка.ПериодЛимитирования); 
		Если Строка.Свойство("Доступно") Тогда
			Доступно = Строка.Доступно; 
			Строка.Вставить("Свободно", Доступно);
			Если Доступно < 0 Тогда
				Доступно = - Доступно;
			Иначе
				Доступно = 0;
			КонецЕсли;
		Иначе
			Доступно = 0;
		КонецЕсли;
			
		Строка.Вставить("Сумма", Доступно);
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	Оповещение = Новый ОписаниеОповещения("СоздатьЗаявкуНаКорректировкуЛимитовПоДаннымРасшифровкиЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.ЗаявкаНаКорректировкуПланов.Форма.ФормаДокумента", ДопПараметры, ЭтотОбъект,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаКорректировкуЛимитовПоДаннымРасшифровкиЗавершение(Результат, ДопПараметры) Экспорт
	
	УстановитьСтраницуПоВидуОперации();
	
КонецПроцедуры                      
  
