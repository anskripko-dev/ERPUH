	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
КонецПроцедуры

&НаСервере
Процедура ИзменениеПараметровЛимитированияНаСервере()
	
	Менеджер = РегистрыСведений.ПараметрыЛимитирования.СоздатьМенеджерЗаписи();
	Менеджер.Период 	= Отчет.ОтчетнаяДата;
	Менеджер.ВидБюджета = Отчет.ВидБюджета;

	Менеджер.Прочитать();                   
	
	Менеджер.ВидБюджета = Отчет.ВидБюджета;
	Менеджер.Период 	= Отчет.ОтчетнаяДата;   
	
	Менеджер.ПериодичностьПланирования  				= Отчет.ПериодичностьПланирования;
	Менеджер.ПериодичностьЛимитирования 				= Отчет.ПериодичностьЛимитирования; 
	Менеджер.СпособОпределенияВалютыЛимитирования 		= Отчет.СпособОпределенияВалютыЛимитирования; 
	Менеджер.УчитыватьАналитикиСтатьиБюджетаПриКонтроле = Отчет.УчитыватьАналитикиСтатьиБюджетаПриКонтроле;
	
	Менеджер.КонтрольЛимитов 	= Отчет.КонтрольЛимитов;
	Менеджер.КонтрольРезервов 	= Отчет.КонтрольРезервов; 
	Менеджер.ВалютаПоУмолчанию	= Отчет.ВалютаПоУмолчанию;  
	
	Менеджер.ПланированиеЗакупок = Отчет.ПланированиеЗакупок; 
	
	Менеджер.РезервированиеВПериодичностиПланирования = Отчет.РезервированиеВПериодичностиПланирования;
	
	Менеджер.Записать(Истина); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДС()
	
	РазрешенныеСтатьи.Очистить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка КАК Ссылка,
	|	СтатьиДвиженияДенежныхСредств.ЭтоГруппа КАК ЭтоГруппа,
	|	1 КАК ПолеРедактирования,
	|	СтатьиДвиженияДенежныхСредств.ВидАналитики1 КАК ВидАналитики1,
	|	СтатьиДвиженияДенежныхСредств.ВидАналитики2 КАК ВидАналитики2,
	|	СтатьиДвиженияДенежныхСредств.ВидАналитики3 КАК ВидАналитики3,
	|	СтатьиДвиженияДенежныхСредств.ВидАналитики4 КАК ВидАналитики4,
	|	СтатьиДвиженияДенежныхСредств.ВидАналитики5 КАК ВидАналитики5,
	|	СтатьиДвиженияДенежныхСредств.ВидАналитики6 КАК ВидАналитики6,
	|	СтатьиДвиженияДенежныхСредств.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	СтатьиДвиженияДенежныхСредств.ПриходРасход КАК ПриходРасход,
	|	СтатьиДвиженияДенежныхСредств.Приоритет КАК Приоритет,
	|	ВЫБОР
	|		КОГДА НЕ ГруппыСтатейСостав.ГруппаСтатей ЕСТЬ NULL
	|				И ЕСТЬNULL(ГруппыСтатейПараметры.ИноеДействие, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК МожноИзменятьДействие,
	|	ВЫБОР
	|		КОГДА НЕ ГруппыСтатейСостав.ГруппаСтатей ЕСТЬ NULL
	|				И ЕСТЬNULL(ГруппыСтатейПараметры.ИноеДействие, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ГруппыСтатейПараметры.КонтрольЛимитов
	|		ИНАЧЕ ЕСТЬNULL(НастройкиСтатьи.КонтрольЛимитов, ПараметрыБюджета.КонтрольЛимитов)
	|	КОНЕЦ КАК КонтрольЛимитов,
	|	ВЫБОР
	|		КОГДА НЕ ГруппыСтатейСостав.ГруппаСтатей ЕСТЬ NULL
	|				И ЕСТЬNULL(ГруппыСтатейПараметры.ИноеДействие, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ГруппыСтатейПараметры.КонтрольРезервов
	|		ИНАЧЕ ЕСТЬNULL(НастройкиСтатьи.КонтрольРезервов, ПараметрыБюджета.КонтрольРезервов)
	|	КОНЕЦ КАК КонтрольРезервов,
	|	ЕСТЬNULL(НастройкиСтатьи.КонтролироватьАналитику1, ВЫБОР
	|			КОГДА СтатьиДвиженияДенежныхСредств.ВидАналитики1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ПараметрыБюджета.УчитыватьАналитикиСтатьиБюджетаПриКонтроле
	|		КОНЕЦ) КАК КонтролироватьАналитику1,
	|	ЕСТЬNULL(НастройкиСтатьи.КонтролироватьАналитику2, ВЫБОР
	|			КОГДА СтатьиДвиженияДенежныхСредств.ВидАналитики2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ПараметрыБюджета.УчитыватьАналитикиСтатьиБюджетаПриКонтроле
	|		КОНЕЦ) КАК КонтролироватьАналитику2,
	|	ЕСТЬNULL(НастройкиСтатьи.КонтролироватьАналитику3, ВЫБОР
	|			КОГДА СтатьиДвиженияДенежныхСредств.ВидАналитики3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ПараметрыБюджета.УчитыватьАналитикиСтатьиБюджетаПриКонтроле
	|		КОНЕЦ) КАК КонтролироватьАналитику3,
	|	ЕСТЬNULL(НастройкиСтатьи.КонтролироватьАналитику4, ВЫБОР
	|			КОГДА СтатьиДвиженияДенежныхСредств.ВидАналитики4 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ПараметрыБюджета.УчитыватьАналитикиСтатьиБюджетаПриКонтроле
	|		КОНЕЦ) КАК КонтролироватьАналитику4,
	|	ЕСТЬNULL(НастройкиСтатьи.КонтролироватьАналитику5, ВЫБОР
	|			КОГДА СтатьиДвиженияДенежныхСредств.ВидАналитики5 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ПараметрыБюджета.УчитыватьАналитикиСтатьиБюджетаПриКонтроле
	|		КОНЕЦ) КАК КонтролироватьАналитику5,
	|	ЕСТЬNULL(НастройкиСтатьи.КонтролироватьАналитику6, ВЫБОР
	|			КОГДА СтатьиДвиженияДенежныхСредств.ВидАналитики6 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ПараметрыБюджета.УчитыватьАналитикиСтатьиБюджетаПриКонтроле
	|		КОНЕЦ) КАК КонтролироватьАналитику6,
	|	ВЫБОР
	|		КОГДА НастройкиСтатьи.СтатьяБюджета ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИсточникДляЛимитовВидБюджета,
	|	1 КАК ЗапретРедактирования,
	|	ВЫБОР
	|		КОГДА НЕ ГруппыСтатейСостав.ГруппаСтатей ЕСТЬ NULL
	|				И ЕСТЬNULL(ГруппыСтатейПараметры.ИнаяПериодичность, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ГруппыСтатейПараметры.Периодичность
	|		ИНАЧЕ ПараметрыБюджета.ПериодичностьЛимитирования
	|	КОНЕЦ КАК ПериодичностьЛимитирования,
	|	ПараметрыБюджета.ПериодичностьПланирования КАК ПериодичностьПланирования,
	|	ВЫБОР
	|		КОГДА ГруппыСтатейСостав.ГруппаСтатей ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьГруппаСтатей,
	|	ГруппыСтатейСостав.ГруппаСтатей КАК ГруппаСтатей,
	|	ЕСТЬNULL(ГруппыСтатейПараметры.КонтрольПоГруппе, ЛОЖЬ) КАК КонтрольПоГруппе,
	|	"""" КАК Терминатор
	|ИЗ
	|	ВТ_Справочник_Статей КАК СтатьиДвиженияДенежныхСредств
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК НастройкиСтатьи
	|		ПО СтатьиДвиженияДенежныхСредств.Ссылка = НастройкиСтатьи.СтатьяБюджета
	|			И (НастройкиСтатьи.ВидБюджета = &ВидБюджета)
	|			И (НастройкиСтатьи.Период = &ПериодЛимитирования)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитирования КАК ПараметрыБюджета
	|		ПО (ПараметрыБюджета.ВидБюджета = &ВидБюджета)
	|			И (ПараметрыБюджета.Период = &ПериодЛимитирования)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав КАК ГруппыСтатейСостав
	|		ПО (ГруппыСтатейСостав.ВидБюджета = &ВидБюджета)
	|			И (ГруппыСтатейСостав.Период = &ПериодЛимитирования)
	|			И (ГруппыСтатейСостав.СтатьяБюджета = СтатьиДвиженияДенежныхСредств.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияГруппыСтатей КАК ГруппыСтатейПараметры
	|		ПО (ГруппыСтатейПараметры.ВидБюджета = &ВидБюджета)
	|			И (ГруппыСтатейПараметры.Период = &ПериодЛимитирования)
	|			И (ГруппыСтатейПараметры.ГруппаСтатей = ГруппыСтатейСостав.ГруппаСтатей)";
	
	ПараметрыСписка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СправочникСтатейБюджета, "Имя, ПолноеИмя");
	
	СписокСтатей.ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_Справочник_Статей", "Справочник." + ПараметрыСписка.Имя);
	
	СписокСтатей.ОсновнаяТаблица = ПараметрыСписка.ПолноеИмя; 
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СписокСтатей, "ВидБюджета", Отчет.ВидБюджета);
		
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СписокСтатей, "РазрешенныеСтатьи", РазрешенныеСтатьи.ВыгрузитьЗначения());
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СписокСтатей, "ПериодЛимитирования", Отчет.ОтчетнаяДата);
		
	ЭтотОбъект.СписокГрупп.Параметры.УстановитьЗначениеПараметра("Период", 		Отчет.ОтчетнаяДата);   
	ЭтотОбъект.СписокГрупп.Параметры.УстановитьЗначениеПараметра("ВидБюджета", 	Отчет.ВидБюджета); 
	
	ОбновитьВидимостьГруппаВВалютеЛимитированияЦФО();
	ОбновитьВидимостьГруппаПараметрыЛимитированияКурсыВалют();
	
	ЭтотОбъект.СписокГрупп.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Очистить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЭтотОбъект.СписокГрупп,
														"Владелец", 
														Отчет.ВидБюджета, 
														ВидСравненияКомпоновкиДанных.Равно,
														"Владелец",
														Истина);  
	
КонецПроцедуры

Процедура ИнтеграцияСПочтойРассылкой(Отказ, СтандартнаяОбработка)
	
	// Тесная интеграция с почтой и рассылкой.
	ДоступнаОтправкаПисем = Ложь;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
		ДоступнаОтправкаПисем = МодульРаботаСПочтовымиСообщениями.ДоступнаОтправкаПисем();
	КонецЕсли;
	Если ДоступнаОтправкаПисем Тогда
		Если НастройкиОтчета.РазрешеноИзменятьВарианты
			И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РассылкаОтчетов")
			И Не НастройкиОтчета.СкрытьКомандыРассылки Тогда
			МодульРассылкаОтчетов = ОбщегоНазначения.ОбщийМодуль("РассылкаОтчетов");
			МодульРассылкаОтчетов.ФормаОтчетаДобавитьКоманды(ЭтотОбъект, Отказ, СтандартнаяОбработка);
		Иначе // Если в подменю одна команда, то выпадающий список не отображается.
			Элементы.ОтправитьПоПочте.Заголовок = Элементы.ГруппаОтправить.Заголовок + "...";
			Элементы.Переместить(Элементы.ОтправитьПоПочте, Элементы.ГруппаОтправить.Родитель, Элементы.ГруппаОтправить);
		КонецЕсли;
	Иначе
		Элементы.ГруппаОтправить.Видимость = Ложь;
	КонецЕсли;  

КонецПроцедуры

&НаКлиенте
Процедура ИзменениеПараметровСтатей(Результат, ДопПараметры) Экспорт 
	
 	Если Результат = Неопределено Тогда
		Возврат;       		
	Иначе    		
		Если ДопПараметры.Действие = "ИзменениеПериодичности" Тогда
			
			ДопПараметры.Периодичность = Результат.Значение;  
			УстановитьПараметрГруппыСтатейБюджета(ДопПараметры);     
			
		ИначеЕсли ДопПараметры.Действие = "КонтрольПоГруппе" Тогда  
			
			ДопПараметры.КонтрольПоГруппе = Не ДопПараметры.КонтрольПоГруппе;  
			УстановитьПараметрГруппыСтатейБюджета(ДопПараметры);	
			
		ИначеЕсли ДопПараметры.Действие = "КонтрольЛимитов" Тогда  
			
			ДопПараметры.КонтрольЛимитов = Результат.Значение;  
			ДопПараметры.КонтрольРезервов = Результат.Значение;
			
			УстановитьПараметрГруппыСтатейБюджета(ДопПараметры);  
			
		ИначеЕсли ДопПараметры.Действие = "КонтрольРезервов" Тогда 
			
			ДопПараметры.КонтрольРезервов = Результат.Значение;  
			УстановитьПараметрГруппыСтатейБюджета(ДопПараметры);
			
		КонецЕсли;
	КонецЕсли;
	
	Элементы.СписокГрупп.Обновить();
	Элементы.СписокСтатей.Обновить();
	
	Оповестить("ИзменениеГодаФормыСтатьи");
	
КонецПроцедуры  

&НаСервереБезКонтекста
Процедура УстановитьПараметрГруппыСтатейБюджета(ДанныеСтроки)
	
	ИноеДействие = ЗначениеЗаполнено(ДанныеСтроки.КонтрольЛимитов);
	
	РегистрыСведений.ПараметрыЛимитированияГруппыСтатей.УстановитьПараметрыКонтроляСтатейБюджетаПакетно(
		ДанныеСтроки.ВидБюджета, ДанныеСтроки.ОтчетнаяДата, ДанныеСтроки.ГруппаСтатей,
		ДанныеСтроки.Периодичность, ДанныеСтроки.КонтрольПоГруппе,
		ИноеДействие, ДанныеСтроки.КонтрольЛимитов, ДанныеСтроки.КонтрольРезервов);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьГруппаПараметрыЛимитированияКурсыВалют()
	
	ЗаголовокЛимитированияПредупреждение = "";
	Если Не Отчет.СпособОпределенияВалютыЛимитирования = Перечисления.СпособыОпределенияВалютыЛимитирования.ВалютаОперации Тогда 
		ВалютыЛимитирования = ПараметрыВалютыЛимитирования();	
		ЗаголовокЛимитированияПредупреждение = ПараметрыЛимитированияКурсыВалют(ВалютыЛимитирования);
	КонецЕсли;
	
	Элементы.ДекорацияПараметрыЛимитированияПредупреждение.Заголовок = ЗаголовокЛимитированияПредупреждение;   
	Элементы.ГруппаПараметрыЛимитированияКурсыВалют.Видимость = Не ПустаяСтрока(ЗаголовокЛимитированияПредупреждение);
	
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ПараметрыВалютыЛимитирования()

	ВалютаРегламентированногоУчета = ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуРегламентированногоУчета();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДАТАВРЕМЯ(3999, 12, 31) КАК Период,
	|	Валюты.Ссылка КАК ВалютаЛимитирования
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	НЕ Валюты.ПометкаУдаления
	|	И НЕ Валюты.Ссылка = &ВалютаРегламентированногоУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	Валюты.Наименование";  
	
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

&НаСервереБезКонтекста  
Функция ТаблицаВалютыЛимитирования(ВалютаЛимитирования)

	ТаблицаВалютыЛимитирования = Новый ТаблицаЗначений; 
	ТаблицаВалютыЛимитирования.Колонки.Добавить("ВалютаЛимитирования", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Валюты"));
	
	НоваяСтрока = ТаблицаВалютыЛимитирования.Добавить();
	НоваяСтрока.ВалютаЛимитирования = ВалютаЛимитирования;   
	
	Возврат ТаблицаВалютыЛимитирования;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыЛимитированияКурсыВалют(ВалютыЛимитирования) 	
	
	ЗаголовокЛимитированияПредупреждение = "";  

	РезультатЗапроса = КонтрольЛимитовУХ.ПараметрыЛимитированияКонтрольВалют(ВалютыЛимитирования);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ЗаголовокЛимитированияПредупреждение;	
	КонецЕсли;    
	
	СписокВалют = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ВалютаЛимитирования");

	ЗаголовокЛимитированияПредупреждение = НСтр("ru='Для целей планирования/лимитирования не задан курс для валют: %1'"); 
	ЗаголовокЛимитированияПредупреждение = СтрШаблон(ЗаголовокЛимитированияПредупреждение, СтрСоединить(СписокВалют, ", "));
	
	Возврат СокрЛП(ЗаголовокЛимитированияПредупреждение);    
	
КонецФункции    

