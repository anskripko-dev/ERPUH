&НаКлиенте
Процедура ОткрытьСписокДокументовУстановкиЛимитов(ВыбранныеЦФОПроект)
	
	Если ВыбранныеЦФОПроект.Данные.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ВыбранныеЦФОПроект.Данные[0];
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику"));
	Отбор.Вставить("ВидБюджета", Данные.ВидБюджета);
	Отбор.Вставить("ПериодЛимитирования", Данные.ПериодЛимитирования);
	Отбор.Вставить("ЦФО", Данные.ЦФО);
	Отбор.Вставить("Проект", Данные.Проект);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Отбор", Отбор);
	ДопПараметры.Вставить("КлючПользовательскихНастроек", "СписокДокументовУправлениеЛимитамиСОтборами");
	
	ОткрытьФорму("Документ.УправлениеЛимитами.Форма.ФормаСписка", ДопПараметры, ЭтотОбъект);
	
