	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "СписокГрупп.КонтрольРезервов", ВидСравненияКомпоновкиДанных.Равно, Перечисления.РежимыКонтроляДокументов.ПустаяСсылка(),,Истина);
