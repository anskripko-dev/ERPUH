&НаКлиенте
Процедура ДоступностьКнопокКонтрольИсполнения()
	
	//
	ДанныеЯчеек = ВыделенныеЯчейкиДляКонтроляИсполнения();
	ПараметрыКоманд = КонтрольИсполненияВыполнитьАнализДанныхЯчеек(ДанныеЯчеек);
	
	// Создать корректировку
	НастроитьКнопку(Элементы.СоздатьКорректировкуЛимитов,	НСтр("ru = 'Создать корректировку лимитов'"), "ПолныйНаборАналитик", ПараметрыКоманд);
	
