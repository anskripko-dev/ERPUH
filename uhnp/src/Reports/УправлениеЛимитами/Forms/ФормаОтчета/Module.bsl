&НаКлиенте
Процедура ВыбранРесурсВПодменюУправленияРесурсами(Команда)
	
	ОписаниеРесурса = КонтрольИсполненияКнопкиРесурсы[Команда.Имя];
	Кнопка = Элементы[Команда.Имя];
	КомпоновщикНастроек = ПолучитьКомпоновщикНастроекПоИмениРеквизита(ЭтотОбъект, ОписаниеРесурса.ИмяКомпоновщикаНастроек);
	ВыбранноеПоле = ВыбранноеПолеСКДПоИмени(КомпоновщикНастроек, ОписаниеРесурса.ИмяРесурса);
	Если ВыбранноеПоле <> Неопределено Тогда
		Кнопка.Пометка = НЕ Кнопка.Пометка;
		ВыбранноеПоле.Использование = Кнопка.Пометка;
	КонецЕсли;
	СформироватьОтчеты();
	
КонецПроцедуры

// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Подключаемый_Команда(Команда)       
	
	Если ВидОперации = 4 Тогда
		
		ПараметрЛимитированияПредупреждение = Элементы.ДекорацияПараметрыЛимитированияПредупреждение.Заголовок;  
		
		Если Не ПустаяСтрока(ПараметрЛимитированияПредупреждение) Тогда
			ПоказатьПредупреждение(, ПараметрЛимитированияПредупреждение);	  
		Иначе     		
			 ПостоянныеКомандыПриИзменении(Команда)			
		КонецЕсли;
		
	Иначе  	
		 ПостоянныеКомандыПриИзменении(Команда);		
	КонецЕсли;    
	
КонецПроцедуры 

&НаКлиенте
Процедура ПостоянныеКомандыПриИзменении(Команда)
	
	ПостояннаяКоманда = ПостоянныеКоманды.НайтиПоЗначению(Команда.Имя);
	Если ПостояннаяКоманда <> Неопределено И ЗначениеЗаполнено(ПостояннаяКоманда.Представление) Тогда
		МассивПодстрок = СтрРазделить(ПостояннаяКоманда.Представление, ".");
		КлиентскийМодуль = ОбщегоНазначенияКлиент.ОбщийМодуль(МассивПодстрок[0]);
		Обработчик = Новый ОписаниеОповещения(МассивПодстрок[1], КлиентскийМодуль, Команда);
		ВыполнитьОбработкуОповещения(Обработчик, ЭтотОбъект);
	Иначе
		ИнтеграцияПодсистемБСПКлиент.ПриОбработкеКоманды(ЭтотОбъект, Команда, Ложь);
		ОтчетыКлиентПереопределяемый.ОбработчикКоманды(ЭтотОбъект, Команда, Ложь);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтатьюВГруппуНастройки(Команда)

	ТекущаяСтрока = Элементы.СписокГрупп.ТекущиеДанные;     
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ЗначенияЗаполнения = Новый Структура;  
	ЗначенияЗаполнения.Вставить("Период", Отчет.ОтчетнаяДата);
	ЗначенияЗаполнения.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ЗначенияЗаполнения.Вставить("ГруппаСтатей", ТекущаяСтрока.ГруппаСтатей);

	ПараметрыОткрытия = Новый Структура;   
	ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав.Форма.ФормаЗаписи", 
				ПараметрыОткрытия, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКорректировкуЛимитов(Команда)
	
	ДанныеЯчеек = ВыделенныеЯчейкиДляКонтроляИсполнения();
	Если ДанныеЯчеек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПараметрыКоманд = КонтрольИсполненияВыполнитьАнализДанныхЯчеек(ДанныеЯчеек);
	
	Если ПараметрыКоманд.ПолныйНаборАналитик.Данные.Количество() > 0 Тогда
		СоздатьКорректировкуЛимитовПоДаннымРасшифровки(
			Отчет.ВидБюджета,
			ПараметрыКоманд.ПолныйНаборАналитик);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаКорректировкуЛимитов(Команда)
	
	ДанныеЯчеек = ВыделенныеЯчейкиДляКонтроляИсполнения();
	Если ДанныеЯчеек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПараметрыКоманд = КонтрольИсполненияВыполнитьАнализДанныхЯчеек(ДанныеЯчеек);
	
	Если ПараметрыКоманд.ПолныйНаборАналитик.Данные.Количество() > 0 Тогда
		СоздатьЗаявкуНаКорректировкуЛимитовПоДаннымРасшифровки(
			Отчет.ВидБюджета,
			ПараметрыКоманд.ПолныйНаборАналитик);
		КонецЕсли;
		
КонецПроцедуры

