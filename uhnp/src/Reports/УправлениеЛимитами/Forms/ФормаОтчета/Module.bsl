	КлючЗаписи = РегистрыСведений.ПараметрыЛимитирования.СоздатьКлючЗаписи(ДанныеКлюча);
	Возврат КлючЗаписи;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьПериод(Направление, ВыводитьСообщения = Истина)
	
	Результат = РегулированиеОтчетнойДаты(Направление);
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Результат = "ОтсутствуетОписаниеПериодаЛимитирования" Тогда
			СпроситьПользователяОСозданииПериодаЛимитирования(Результат, Направление, ВыводитьСообщения);
		ИначеЕсли Результат.Результат = "ОтсутствуютПериоды" Тогда
			СформироватьПериодыПоНастройкамЛимитирования(Результат);
			СформироватьОтчеты();
		КонецЕсли;
	Иначе
		СформироватьОтчеты();
	КонецЕсли;
	
	Если ПослеФормированияОтчетаТребуетсяВыполнитьНаКлиенте Тогда
		ПодключитьОбработчикОжидания("УстановитьДоступностьКнопокПоВыделеннымЯчейкам", 0.1, Истина);	
	КонецЕсли;
	
	Элементы.ОтчетнаяДатаКоманда.Заголовок = Формат(Отчет.ОтчетнаяДата, "ДФ='dd.MM.yyyy ''г.'");
	Элементы.ПланированиеЗакупок.Видимость = Отчет.ПланированиеЗакупок;
	
	УстановитьПараметрыДС(); 
	ЗаполнитьСписокВыбораПериодичность();
	
КонецПроцедуры

&НаСервере
Функция РегулированиеОтчетнойДаты(Направление)
	
	ПараметрыЛимитирования = ПараметрыЛимитированияПериода(Отчет.ВидБюджета, Отчет.ОтчетнаяДата, Направление);
    
	Если ПараметрыЛимитирования = Неопределено Тогда  
		                              
		Результат = Новый Структура;
		Результат.Вставить("ВидБюджета", 	Отчет.ВидБюджета);
		Результат.Вставить("ОтчетнаяДата", 	Отчет.ОтчетнаяДата);
		Результат.Вставить("Результат", 	"ОтсутствуетОписаниеПериодаЛимитирования");
		
		Возврат Результат;    
		
	Иначе        
		
		Отчет.ОтчетнаяДата = ПараметрыЛимитирования.Период; 
		ЗаполнитьЗначенияСвойств(Отчет, ПараметрыЛимитирования); 
		ТекущаяПериодичностьПланирования = ПараметрыЛимитирования.ПериодичностьПланирования;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Периодичность", ПараметрыЛимитирования.ПериодичностьЛимитирования);
	Запрос.УстановитьПараметр("ТребуемыйГод", Год(ПараметрыЛимитирования.Период));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Периоды.Ссылка КАК ПериодЛимитирования,
	|	Периоды.ДатаНачала КАК НачалоПериода,
	|	Периоды.ДатаОкончания КАК ОкончаниеПериода
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.Произвольный = ЛОЖЬ
	|	И Периоды.Периодичность = &Периодичность
	|	И ГОД(Периоды.ДатаНачала) = &ТребуемыйГод
	|
	|УПОРЯДОЧИТЬ ПО
	|	Периоды.ДатаНачала";
	
	НовыеПериоды = Запрос.Выполнить().Выгрузить();
	Если НовыеПериоды.Количество() <> ПараметрыЛимитирования.КоличествоПериодовЛимитирования Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("ВидБюджета", Отчет.ВидБюджета);
		Результат.Вставить("ОтчетнаяДата", Отчет.ОтчетнаяДата);
		Результат.Вставить("Результат", "ОтсутствуютПериоды");
		
		Результат.Вставить("Периодичность", ПараметрыЛимитирования.ПериодичностьЛимитирования);
		Результат.Вставить("ТребуемыйГод", Год(ПараметрыЛимитирования.Период));
		
		Возврат Результат;
		
	КонецЕсли;
	
	Отчет.Периоды.Загрузить(НовыеПериоды);
	
КонецФункции 

&НаСервере
Процедура СформироватьПериодыПоНастройкамЛимитирования(ДопПараметры)
	
	ДатаПериода = ДопПараметры.ОтчетнаяДата;
	
	Пока Год(ДатаПериода) = ДопПараметры.ТребуемыйГод Цикл
		ПериодЛимитирования = КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(ДатаПериода, ДопПараметры.Периодичность, 0);
		ДатаПериода = НачалоДня(ПериодЛимитирования.ДатаОкончания + 60*60*24);
	КонецЦикла;
	
КонецПроцедуры

// Выполняет расчет и вывод показателей выделенной области ячеек.
