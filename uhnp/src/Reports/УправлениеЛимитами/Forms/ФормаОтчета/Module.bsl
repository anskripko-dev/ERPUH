&НаКлиенте
Процедура РассчитатьПоказателиДинамически()
	
	ОписаниеТекущегоОтчета = ОписаниеОтчетов.Получить(ВидОперации);
	Если ОписаниеТекущегоОтчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличногоДокумента = ОписаниеТекущегоОтчета.ТабДок;
	ОбщегоНазначенияСлужебныйКлиент.РассчитатьПоказатели(ЭтотОбъект, ИмяТабличногоДокумента);
	
	// 
	Элементы.ПоказательЗаявкиНаКорректировку.ФорматРедактирования = Элементы.Показатель.ФорматРедактирования;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументУправленияЛимитами(ВыбранноеДействие, ДанныеВыбранныхЯчеек)
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВидОперации", ВыбранноеДействие);
	ЗначенияЗаполнения.Вставить("НачалоГода", Отчет.ОтчетнаяДата);
	ЗначенияЗаполнения.Вставить("УОП", Отчет.УОП);
	ЗначенияЗаполнения.Вставить("Данные", ДанныеВыбранныхЯчеек.Данные);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.УправлениеЛимитами.Форма.ФормаДокумента", ДопПараметры, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуПоВидуОперации()

	Элементы.ГруппаОтборы.Видимость = Истина; 
	Элементы.ГруппаКоманд.Видимость = Истина;
	
	Если ЭтаФорма.Окно <> Неопределено Тогда
		АвтоЗаголовок = Ложь;
		ЭтаФорма.Заголовок = Элементы.ВидОперации.СписокВыбора.НайтиПоЗначению(ВидОперации).Представление;
	КонецЕсли;
	
	Если ВидОперации = 1 Тогда
		
	ИначеЕсли ВидОперации = 2 Тогда

	ИначеЕсли ВидОперации = 3 Тогда
		// Список корректировок и заявок
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаКорректировкиЛимитов; 
		Элементы.ГруппаКоманд.Видимость = Ложь;      
	ИначеЕсли ВидОперации = 4 Тогда
		// Настройка параметров лимитирования статей бюджетов 
		Элементы.ГруппаОтборы.Видимость = Ложь;
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаНастройкиПараметровЛимитированияСтатейБюджетов; 
	ИначеЕсли ВидОперации = 5 Тогда
		// Контроль исполнения   
		Элементы.ГруппаКоманд.Видимость = Ложь;
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаКонтрольИсполнения;
	Иначе
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаУстановкаЛимитовПоДаннымБюджетирования;
	КонецЕсли;

	СформироватьОтчеты();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьПараметрыОтчетов()   	
	
	ОтчетКонтрольИсполнения = Новый Структура;
	ОтчетКонтрольИсполнения.Вставить("ТабДок", "ТабличныйДокументКонтрольИсполнения");
	
	Описание = Новый Соответствие;
	Описание.Вставить(5, ОтчетКонтрольИсполнения);
	
	ОписаниеОтчетов = Новый ФиксированноеСоответствие(Описание);
	
	// Инициализация компоновщиков настроек дополнительных отчетов    
	ОбъектОтчет = РеквизитФормыВЗначение("Отчет");
	
	// Контроль исполнения
	СхемаКомпоновкиДанных = ОбъектОтчет.ПолучитьМакет("СКД_КонтрольИсполнения");
	АдресСхемаКомпоновкиДанныхКонтрольИсполнения = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтотОбъект.УникальныйИдентификатор);
	
	КомпоновщикНастроекКонтрольИсполнения = Новый КомпоновщикНастроекКомпоновкиДанных();
    КомпоновщикНастроекКонтрольИсполнения.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемаКомпоновкиДанныхКонтрольИсполнения));
    КомпоновщикНастроекКонтрольИсполнения.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьНастройки(ПользовательскиеНастройки)
	
	// Заполнить отборы по основному отчету
	НастройкиМастерОтчета = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Для Поз = 0 По 1 Цикл
		МастерОтбор = НастройкиМастерОтчета[Поз];
		Отбор = ПользовательскиеНастройки[Поз];
		
		Отбор.ВидСравнения = МастерОтбор.ВидСравнения;
		Отбор.ПравоеЗначение = МастерОтбор.ПравоеЗначение;
		Отбор.Использование = МастерОтбор.Использование;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетыПриОжидании() 
	СформироватьОтчеты();
КонецПроцедуры

&НаСервере
Процедура СформироватьМенюУправленияРесурсами()
	
	КнопкиРесурсы = Новый Соответствие;
			
	// Установка лимитов по данным бюджетирования
	РесурсыУстановкаЛимитов = Новый Массив;
	РесурсыУстановкаЛимитов.Добавить("Сценарий");
	РесурсыУстановкаЛимитов.Добавить("Состояние");
	РесурсыУстановкаЛимитов.Добавить("Актуальность");
	РесурсыУстановкаЛимитов.Добавить("Лимит");
	РесурсыУстановкаЛимитов.Добавить("Корректировка");
	РесурсыУстановкаЛимитов.Добавить("ЕстьЛимит");
	РесурсыУстановкаЛимитов.Добавить("ЕстьКорректировка");
	РесурсыУстановкаЛимитов.Добавить("УОП");
	
	СформироватьЭлементыМенюУправленияРесурсами(
		КнопкиРесурсы, Элементы.ПодменюРесурсовУстановкаЛимитовПоДаннымБюджетирования,
		РесурсыУстановкаЛимитов, "РесурсыУстановкаЛимитов_%1", "Отчет.КомпоновщикНастроек");
		
	// Контроль исполнения
	РесурсыКонтрольИсполнения = Новый Массив;
	РесурсыКонтрольИсполнения.Добавить("Лимит");
	РесурсыКонтрольИсполнения.Добавить("Корректировка");
	РесурсыКонтрольИсполнения.Добавить("ЛимитВсего");
	РесурсыКонтрольИсполнения.Добавить("Зарезервировано");
	РесурсыКонтрольИсполнения.Добавить("Заявлено");
	РесурсыКонтрольИсполнения.Добавить("Исполнено");
	РесурсыКонтрольИсполнения.Добавить("ИспользованоВсего");
	РесурсыКонтрольИсполнения.Добавить("Доступно");
	РесурсыКонтрольИсполнения.Добавить("КОбеспечению");
	
	СформироватьЭлементыМенюУправленияРесурсами(
		КнопкиРесурсы, Элементы.ПодменюРесурсовКонтрольИсполнения,
		РесурсыКонтрольИсполнения, "РесурсыКонтрольИсполнения_%1", "КомпоновщикНастроекКонтрольИсполнения");
		
	КонтрольИсполненияКнопкиРесурсы = Новый ФиксированноеСоответствие(КнопкиРесурсы);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЭлементыМенюУправленияРесурсами(КнопкиРесурсы, Подменю, Ресурсы, ШаблонИмени, ИмяКомпоновщикаНастроек)
	
	КомпоновщикНастроек = ПолучитьКомпоновщикНастроекПоИмениРеквизита(ЭтотОбъект, ИмяКомпоновщикаНастроек);
	
	ЗаголовкиКнопок = Новый Соответствие;
	ЗаголовкиКнопок.Вставить("ЕстьКорректировка", НСтр("ru = 'Есть корректировки лимитов'"));
	ЗаголовкиКнопок.Вставить("ЕстьЛимит", НСтр("ru = 'Есть установленные лимиты'"));
	ЗаголовкиКнопок.Вставить("Актуальность", НСтр("ru = 'Соответствие установленных лимитов данным документов бюджетирования'"));
	ЗаголовкиКнопок.Вставить("Лимит", НСтр("ru = 'Сумма лимитов'"));
	ЗаголовкиКнопок.Вставить("Корректировка", НСтр("ru = 'Сумма корректировок'"));
	ЗаголовкиКнопок.Вставить("УОП", НСтр("ru = 'Управление периодом сценария'"));
	
	//
	ИмяДействия = "ВыбранРесурсВПодменюУправленияРесурсами";
	Для Каждого Ресурс Из Ресурсы Цикл
		
		ВыбранноеПоле = ВыбранноеПолеСКДПоИмени(КомпоновщикНастроек, Ресурс);
		Если ВыбранноеПоле = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКнопкиКоманды = СтрШаблон(ШаблонИмени, Ресурс);
		
		ЗаголовокКнопки = ЗаголовкиКнопок[Ресурс];
		Если ЗаголовокКнопки = Неопределено Тогда
			ЗаголовокКнопки = "";
		КонецЕсли;
		
		ФормыУХ.СоздатьКоманду(ЭтотОбъект, ИмяКнопкиКоманды, ВыбранноеПоле.Заголовок, ИмяДействия);
		Кнопка = ФормыУХ.СоздатьКнопкуФормы(Элементы, ИмяКнопкиКоманды, ЗаголовокКнопки, ИмяКнопкиКоманды, ВидКнопкиФормы.КнопкаКоманднойПанели, Подменю);
		Кнопка.Пометка = ВыбранноеПоле.Использование;
		
		ОписаниеРесурса = Новый Структура("ИмяКомпоновщикаНастроек, ИмяРесурса", ИмяКомпоновщикаНастроек, Ресурс);
		КнопкиРесурсы.Вставить(ИмяКнопкиКоманды, ОписаниеРесурса);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВыбранноеПолеСКДПоИмени(КомпоновщикНастроекКонтрольИсполнения, ИмяРесурса)
	
	ИскомоеПоле = Новый ПолеКомпоновкиДанных(ИмяРесурса);
	Для Каждого Строка Из КомпоновщикНастроекКонтрольИсполнения.Настройки.Выбор.Элементы Цикл
		Если Строка.Поле = ИскомоеПоле Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКомпоновщикНастроекПоИмениРеквизита(Форма, ИмяКомпоновщикаНастроек)
	
	Путь = СтрРазделить(ИмяКомпоновщикаНастроек, ".");
	Если Путь.Количество() = 1 Тогда
		Возврат Форма[Путь[0]];
	Иначе
		Возврат Форма[Путь[0]][Путь[1]];
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура НастроитьКнопку(Кнопка, Заголовок, ИмяКоманды, ПараметрыКоманд)
	
	ПараметрыКоманды = Неопределено;
	Кнопка.Доступность = ПараметрыКоманд.Свойство(ИмяКоманды, ПараметрыКоманды) И ПараметрыКоманды.ДанныеВыбрано.Количество();
	Если Кнопка.Доступность Тогда
		ТекстСообщения = СтрШаблон(Заголовок + НСтр("ru = ' (%1 шт)'"), ПараметрыКоманды.ДанныеВыбрано.Количество());
	Иначе
		ТекстСообщения = Заголовок;
	КонецЕсли;
	Кнопка.Заголовок = ТекстСообщения;
	
КонецПроцедуры

&НаСервере
Функция ИдентификаторСтатьиБюджета(ЭлементыДерева, СтатьяБюджета)

	ИдентификаторСтроки = 0;
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если ЭлементДерева.СтатьяБюджета = СтатьяПозиционирования Тогда
			ИдентификаторСтроки = ЭлементДерева.ПолучитьИдентификатор();
			Возврат ИдентификаторСтроки;
		Иначе
			ИдентификаторСтроки = ИдентификаторСтатьиБюджета(ЭлементДерева.ПолучитьЭлементы(), СтатьяБюджета);
			Если ИдентификаторСтроки <> 0 Тогда
				Возврат ИдентификаторСтроки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ИдентификаторСтроки;

КонецФункции // ИдентификаторСтатьиБюджета()
 
&НаКлиенте
Процедура УстановитьКонтрольПоДаннымБюджета(ДанныеСтроки)
	
	ДанныеСтроки.КонтрольЛимитов = ДанныеСтроки.КонтрольЛимитовБюджета;
	ДанныеСтроки.КонтрольРезервов = ДанныеСтроки.КонтрольРезервовБюджета;
	ДанныеСтроки.ИсточникДляЛимитовВидБюджета = Истина;
	
	Для Номер = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
		
		ИмяВидАналитики = СтрШаблон("ВидАналитики%1", Номер);
		ИмяКонтролироватьАналитику = СтрШаблон("КонтролироватьАналитику%1", Номер);
		
		ДанныеСтроки[ИмяКонтролироватьАналитику] = ?(ЗначениеЗаполнено(ДанныеСтроки[ИмяВидАналитики]),
			ДанныеСтроки.УчитыватьАналитикиСтатьиБюджетаПриКонтроле, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетКонтрольИсполненияНаСервере()
	
	СинхронизироватьНастройки(КомпоновщикНастроекКонтрольИсполнения.ПользовательскиеНастройки.Элементы);
	
	СхемаКомпоновкиДанных = Отчеты.ОтчетПоЛимитам.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");   
				
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных; 	
	Макет = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, СхемаКомпоновкиДанных.НастройкиПоУмолчанию);     
	
	//  
	Запрос = Новый Запрос();
	Запрос.Текст = Макет.НаборыДанных.НаборДанных.Запрос; 	
	
	Запрос.Параметры.Вставить("ВидБюджета", Отчет.ВидБюджета); 
	Запрос.Параметры.Вставить("ТипыЗаявокКОбеспечению", КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению());    
	Запрос.Параметры.Вставить("ТипыЗаявокНаОперации", КонтрольЛимитовУХ.ТипыЗаявокНаОперации());
	Запрос.Параметры.Вставить("ТипыКорректировкиЛимитов", КонтрольЛимитовУХ.ТипыКорректировкиЛимитов());
	Запрос.Параметры.Вставить("ТипыРезервирования", КонтрольЛимитовУХ.ТипыРезервирования()); 
	Запрос.Параметры.Вставить("П", НачалоГода(Отчет.ОтчетнаяДата));
	Запрос.Параметры.Вставить("П2", НачалоДня(КонецГода(Отчет.ОтчетнаяДата)));
	Запрос.Параметры.Вставить("ИспользоватьРезервирование", КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования());

	Данные = Запрос.Выполнить().Выгрузить();
	
	// Получаем схему компоновки данных
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемаКомпоновкиДанныхКонтрольИсполнения);
	
	// 
	Настройки = КомпоновщикНастроекКонтрольИсполнения.ПолучитьНастройки();

	// Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	// Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	// Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанных"));
	
	ВнешниеНаборыДанных = Новый Структура("ДанныеКонтрольИсполнения", Данные);
	
	// Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ТабличныйДокументКонтрольИсполнения.Очистить();
	
	// Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокументКонтрольИсполнения);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	//
	АдресДанныеРасшифровкиКонтрольИсполнения = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтотОбъект.УникальныйИдентификатор);
	
	КонтрольИсполненияФормировался = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ВыделенныеЯчейкиДляКонтроляИсполнения()
	
	//
	ИдентификаторыРасшифровки = ИдентификаторыРасшифровкиВыделенныхОбластей(ТабличныйДокументКонтрольИсполнения);
	Если ИдентификаторыРасшифровки.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат ЯчейкиДляКонтроляИсполнения(АдресДанныеРасшифровкиКонтрольИсполнения, ИдентификаторыРасшифровки, Отчет.ВидБюджета);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЯчейкиДляКонтроляИсполнения(АдресДанныеРасшифровки, МассивИдентификаторовРасшифровки, ВидБюджета)
	
	ДанныеРасшифровки = Новый Массив;
	Для Каждого Расшифровка Из МассивИдентификаторовРасшифровки Цикл
		Данные = ПолучитьДанныеРасшифровки(АдресДанныеРасшифровки, Расшифровка);
		ДанныеРасшифровки.Добавить(Данные);
	КонецЦикла;
	Возврат ДанныеРасшифровки;
	
КонецФункции

&НаКлиенте
Процедура СоздатьКорректировкуЛимитовПоДаннымРасшифровки(ВидБюджета, ПараметрыКоманды)
	
	Если НЕ СоздатьКорректировкуЛимитовДанныеКорректны(ПараметрыКоманды) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Создание корректировок в разных валютах невозможно.'"));
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийКорректировкаЛимитов.Перенос"));
	ЗначенияЗаполнения.Вставить("ВидБюджета", ПараметрыКоманды.ВидБюджета);
	ЗначенияЗаполнения.Вставить("Валюта", ПараметрыКоманды.Валюта);
	ЗначенияЗаполнения.Вставить("Требуется", ПараметрыКоманды.Данные);
	ЗначенияЗаполнения.Вставить("ГодЛимитирования", Отчет.ОтчетнаяДата);
	
	Для Каждого Строка Из ПараметрыКоманды.Данные Цикл
		
		Строка.Вставить("НачалоПериода", Строка.ПериодЛимитирования); 
		Если Строка.Свойство("Доступно") Тогда
			Доступно = Строка.Доступно; 
			Строка.Вставить("Свободно", Доступно);
			Если Доступно < 0 Тогда
				Доступно = - Доступно;
			Иначе
				Доступно = 0;
			КонецЕсли;
		Иначе
			Доступно = 0;
		КонецЕсли;
			
		Строка.Вставить("Сумма", Доступно);
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	Оповещение = Новый ОписаниеОповещения("СоздатьКорректировкуЛимитовПоДаннымРасшифровкиЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.КорректировкаПланов.Форма.ФормаДокумента", ДопПараметры, ЭтотОбъект,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКорректировкуЛимитовПоДаннымРасшифровкиЗавершение(Результат, ДопПараметры) Экспорт
	
	УстановитьСтраницуПоВидуОперации();
	
КонецПроцедуры

&НаКлиенте
Функция СоздатьКорректировкуЛимитовДанныеКорректны(ПараметрыКоманды)
	
	Результат = Истина;
	
	// Создание корректировок возможно только в одной валюте
	Валюта = неопределено;
	Для Каждого Строка Из ПараметрыКоманды.Данные Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Валюта) Тогда
			Продолжить;
		ИначеЕсли Валюта = неопределено Тогда
			Валюта = Строка.Валюта;
		ИначеЕсли Строка.Валюта <> Валюта Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат И ЗначениеЗаполнено(Валюта) Тогда
		ПараметрыКоманды.Вставить("Валюта", Валюта);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
