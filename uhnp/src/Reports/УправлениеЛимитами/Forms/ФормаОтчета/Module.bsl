&НаКлиентеНаСервереБезКонтекста
Процедура СинхронизироватьНастройкиДинамическихСписков(Форма)
	
	Отчет = Форма.Отчет;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокЗаявокНаКорректировку,
				"ВидБюджета", Отчет.ВидБюджета, ВидСравненияКомпоновкиДанных.Равно, , 
				Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокКорректировок,
				"ВидБюджета", Отчет.ВидБюджета, ВидСравненияКомпоновкиДанных.Равно, , 
				Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный); 			

	// Заполнить отбор ЦФО по основному отчету
	ОтборЦФО = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0];
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокЗаявокНаКорректировку,
				"Планы.ЦФО", ОтборЦФО.ПравоеЗначение, ОтборЦФО.ВидСравнения, , 
				ОтборЦФО.Использование, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокКорректировок,
				"Требуется.ЦФО", ОтборЦФО.ПравоеЗначение, ОтборЦФО.ВидСравнения, , 
				ОтборЦФО.Использование, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	// Заполнить отбор Проект по основному отчету
	ОтборПроект = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1];
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокЗаявокНаКорректировку,
				"Планы.Проект", ОтборПроект.ПравоеЗначение, ОтборПроект.ВидСравнения, , 
				ОтборПроект.Использование, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокКорректировок,
				"Требуется.Проект", ОтборПроект.ПравоеЗначение, ОтборПроект.ВидСравнения, , 
				ОтборПроект.Использование, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчеты()
	
	Если ВидОперации = 4 Тогда
		Элементы.СписокСтатей.Обновить();  
	ИначеЕсли ВидОперации = 5 Тогда
		СформироватьОтчетКонтрольИсполненияНаСервере();
	КонецЕсли;
	
	// Установить отборы динамических списков
	СинхронизироватьНастройкиДинамическихСписков(ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыФормыЗаписиПараметровЛимитирования(Период, ВидБюджета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.Период = &Период
	|	И ПараметрыЛимитирования.ВидБюджета = &ВидБюджета";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Возврат Новый Структура("Ключ", ПолучитьКлючЗаписиПараметровЛимитирования(Период, ВидБюджета));
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ИСТИНА КАК Использовать,
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияСрезПоследних.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КоличествоПериодовЛимитирования КАК КоличествоПериодовЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
	|	ПараметрыЛимитированияСрезПоследних.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольРезервов КАК КонтрольРезервов
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования.СрезПоследних(&Период, ВидБюджета = &ВидБюджета) КАК ПараметрыЛимитированияСрезПоследних";

	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	Для Каждого Колонка Из Результат.Колонки Цикл
		ЗначенияЗаполнения.Вставить(Колонка.Имя);
	КонецЦикла;
	ЗначенияЗаполнения.Период = Период;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
	
	Возврат Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКлючЗаписиПараметровЛимитирования(Период, ВидБюджета)
	
