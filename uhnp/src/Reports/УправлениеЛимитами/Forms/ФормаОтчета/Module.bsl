
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("УОП") 
		И ЗначениеЗаполнено(Параметры.УОП) Тогда
		Отчет.УОП = Параметры.УОП;
	КонецЕсли;
	
	БюджетДвиженияДенежныхСредств = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
	БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов; 
	ВалютаУправленческогоУчета = Константы.ВалютаУправленческогоУчета.Получить();
		
	Отчет.ВидБюджета = БюджетДвиженияДенежныхСредств;  

	ДоступнаНастройкаПараметровЛимитирования = РольДоступна("НастройкаПараметровЛимитирования");
	РазрешенныеСтатьи = Новый СписокЗначений;
	
	УстановитьПараметрыВложенныхФорм();
	
	ИнициализироватьПараметрыОтчетов();	
	
	ОтчетНаименованиеТекущегоВарианта = НСтр("ru = 'Управление установкой лимитами'");
	
	Если ОбщегоНазначения.ЭтоВебКлиент() Тогда 
		Элементы.ПредварительныйПросмотр.Видимость = Ложь;
	КонецЕсли;
		
	ПриИзмененииВидаБюджетаНаСервере();
	
	ТипыЗначений = Отчет.ВидБюджета.ТипЗначения.Типы();
	ИдентификаторыТипов = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ТипыЗначений);
	Элементы.СправочникСтатейБюджета.РежимВыбораИзСписка = Истина;
	Элементы.СправочникСтатейБюджета.СписокВыбора.Очистить();
	
	Для Каждого ТипСправочника Из ИдентификаторыТипов Цикл
		Элементы.СправочникСтатейБюджета.СписокВыбора.Добавить(ТипСправочника.Значение);	
	КонецЦикла;
	Если Элементы.СправочникСтатейБюджета.СписокВыбора.Количество() = 1 Тогда
		Элементы.СправочникСтатейБюджета.Видимость = Ложь;
		СправочникСтатейБюджета = Элементы.СправочникСтатейБюджета.СписокВыбора[0].Значение;
	Иначе
		Элементы.СправочникСтатейБюджета.Видимость = Истина;	
	КонецЕсли;
	
	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить("ПолноеИмя", "");
	НастройкиОтчета.Вставить("СкрытьКомандыРассылки", Истина);
	НастройкиОтчета.Вставить("РазрешеноИзменятьВарианты", Истина);
	НастройкиОтчета.Вставить("События", Новый Структура);
	НастройкиОтчета.События.Вставить("ПриОпределенииСвойствЭлементовФормыНастроек", Ложь);
	НастройкиОтчета.События.Вставить("ПослеЗаполненияПанелиБыстрыхНастроек", Ложь);
		
	ИнтеграцияСПочтойРассылкой(Отказ, СтандартнаяОбработка);	
	Элементы.УОП.Видимость = ЗначениеЗаполнено(Отчет.УОП);
	
	// Создать пользовательские настройки динамических списков
	Элементы.СписокЗаявокНаКорректировку.СоздатьЭлементыФормыПользовательскихНастроек(
		Элементы.ЗаявкиНаКорректировкуПользовательскиеНастройки,
		РежимОтображенияНастроекКомпоновкиДанных.БыстрыйДоступ, 2);
	Элементы.СписокКорректировок.СоздатьЭлементыФормыПользовательскихНастроек(
		Элементы.ГруппаКорректировкиПользовательскиеНастройки,
		РежимОтображенияНастроекКомпоновкиДанных.БыстрыйДоступ, 2);
	
	//
	ПараметрыОткрытия = Неопределено;
	Если Параметры.Свойство("ПараметрыОткрытия", ПараметрыОткрытия) Тогда
		Если ПараметрыОткрытия.Свойство("ВидОперации") Тогда
			ВидОперации = ПараметрыОткрытия.ВидОперации;
		КонецЕсли;	
		Если ПараметрыОткрытия.Свойство("Статья") Тогда
			СтатьяПозиционирования = ПараметрыОткрытия.Статья;
		КонецЕсли;	
	КонецЕсли;
	
	ИспользоватьРезервированиеФО = КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования();
	Элементы.ПериодичностьРезервирования.Видимость = ИспользоватьРезервированиеФО;
	
	ПриСозданииНаСервереНастройкаСтатей(Отказ, СтандартнаяОбработка);
	
	Элементы.УстановитьВидБюджетаБюджетДвиженияДенежныхСредств.Пометка 
						= (ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств = Отчет.ВидБюджета);
	Элементы.УстановитьВидБюджетаБюджетДоходовИРасходов.Пометка 
						= (ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов = Отчет.ВидБюджета);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьСтраницуПоВидуОперации();
	ИзменитьПериод(0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписанаКорректировкаЛимитов" Тогда
		ПодключитьОбработчикОжидания("СформироватьОтчетыПриОжидании", 0.2, Истина);
	ИначеЕсли ИмяСобытия = "ЗаписанДокументУправлениеЛимитами" Тогда
		ПодключитьОбработчикОжидания("СформироватьОтчетыПриОжидании", 0.2, Истина);
	ИначеЕсли ИмяСобытия = "ИзмененыПараметрыЛимитированияБюджета" Тогда
		ПодключитьОбработчикОжидания("СформироватьОтчетыПриОжидании", 0.2, Истина);
	КонецЕсли;
	
	Если ИмяСобытия = "НавигационнаяКомандаВложеннойФормы" И Источник = ЭтаФорма Тогда
		ВидОперации = ВложенныеФормы.Индекс(ВложенныеФормы.НайтиПоЗначению(Параметр.Имя));
		КомандаФормы = Элементы[Параметр.Имя];
		Для Каждого КомандаПанели Из КомандаФормы.Родитель.ПодчиненныеЭлементы Цикл
			КомандаПанели.Пометка = Ложь;
		КонецЦикла;
		КомандаФормы.Пометка = Истина;
		УстановитьСтраницуПоВидуОперации();
	ИначеЕсли ИмяСобытия = "ОтчетнаяДатаКомандаЗавершение" И Источник = ЭтаФорма Тогда
		Отчет.ОтчетнаяДата = Параметр.Период; 
		Отчет.ПериодичностьЛимитирования = Параметр.ПериодичностьЛимитирования;
		ИзменитьПериод(0);	
	ИначеЕсли ИмяСобытия = "ОбновитьПараметрыЛимитированияКурсыВалют" Тогда
		ОбновитьВидимостьГруппаПараметрыЛимитированияКурсыВалют();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки, ИспользуютсяСтандартныеНастройки)
	
	СформироватьМенюУправленияРесурсами();  
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидБюджетаПриИзменении(Элемент)
	
	ПриИзмененииВидаБюджетаНаСервере();
	ИзменитьПериод(0);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидБюджетаБюджетДвиженияДенежныхСредств(Команда)
	
	ПараметрЛимитированияПредупреждение = Элементы.ДекорацияПараметрыЛимитированияПредупреждение.Заголовок;  

	Если Не ПустаяСтрока(ПараметрЛимитированияПредупреждение) Тогда
		ПоказатьПредупреждение(, ПараметрЛимитированияПредупреждение);	  
	Иначе  	
		Элементы.УстановитьВидБюджетаБюджетДвиженияДенежныхСредств.Пометка = Истина;
		Элементы.УстановитьВидБюджетаБюджетДоходовИРасходов.Пометка = Ложь;
		
		Отчет.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств");
		ПриИзмененииВидаБюджетаНаСервере();
		ИзменитьПериод(0); 
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВидБюджетаБюджетДоходовИРасходов(Команда)
	
	ПараметрЛимитированияПредупреждение = Элементы.ДекорацияПараметрыЛимитированияПредупреждение.Заголовок;    
	
	Если Не ПустаяСтрока(ПараметрЛимитированияПредупреждение) Тогда
		ПоказатьПредупреждение(, ПараметрЛимитированияПредупреждение);	  
	Иначе
		Элементы.УстановитьВидБюджетаБюджетДвиженияДенежныхСредств.Пометка = Ложь;
		Элементы.УстановитьВидБюджетаБюджетДоходовИРасходов.Пометка = Истина;
		
		Отчет.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов");
		ПриИзмененииВидаБюджетаНаСервере();
		ИзменитьПериод(0);    	
	КонецЕсли;      
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаБюджетаНаСервере()
	
	ПараметрыЛимитирования = ПолучитьПараметрыЛимитированияБюджетаНаДатуПоНаправлению(Отчет.ВидБюджета, ТекущаяДатаСеанса(), -1);  

	// Если на текущую дату параметров нет, но есть на будущую
	Если ПараметрыЛимитирования = Неопределено Тогда
		ПараметрыЛимитирования = ПолучитьПараметрыЛимитированияБюджетаНаДатуПоНаправлению(Отчет.ВидБюджета, ТекущаяДатаСеанса(), 1);	
	КонецЕсли;
	
	Отчет.ОтчетнаяДата = ?(ПараметрыЛимитирования = Неопределено, НачалоГода(ТекущаяДатаСеанса()), ПараметрыЛимитирования.Период);
	
	Отчет.Предназначение = Отчет.ВидБюджета.Предназначение;
	
	ИменаФорм = Новый Соответствие;
	
	// Имя формы при редактировании статьи
	ТипыСтатейБюджета = Отчет.ВидБюджета.ТипЗначения.Типы();
	Для Каждого Тип Из ТипыСтатейБюджета Цикл
		ПустоеЗначение = Новый (Тип);
		ИменаФорм.Вставить(Тип, Стршаблон("%1.ФормаОбъекта", ПустоеЗначение.Метаданные().ПолноеИмя()));
	КонецЦикла;
	
	ФормыСтатьиБюджетаПоТипу = Новый ФиксированноеСоответствие(ИменаФорм);
	
	ТипыЗначений = Отчет.ВидБюджета.ТипЗначения.Типы();
	ИдентификаторыТипов = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ТипыЗначений);
	Элементы.СправочникСтатейБюджета.РежимВыбораИзСписка = Истина;
	Элементы.СправочникСтатейБюджета.СписокВыбора.Очистить();
	
	Для Каждого ТипСправочника Из ИдентификаторыТипов Цикл
		Элементы.СправочникСтатейБюджета.СписокВыбора.Добавить(ТипСправочника.Значение);	
	КонецЦикла;

	Если Элементы.СправочникСтатейБюджета.СписокВыбора.Количество() = 1 Тогда
		Элементы.СправочникСтатейБюджета.Видимость = Ложь;
		СправочникСтатейБюджета = Элементы.СправочникСтатейБюджета.СписокВыбора[0].Значение;
	Иначе
		Элементы.СправочникСтатейБюджета.Видимость = Истина;	
	КонецЕсли;
	
	УстановитьПараметрыДС();
	
	СписокГруппСтатей = Справочники.ГруппыСтатейБюджета.СписокЗначенийГруппСтатей(Отчет.ВидБюджета);    
	
	//ЗаполнитьСписокВыбораПериодичность();

КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьСписокВыбораПериодичность()
	
	ПараметрыОП = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(Отчет.ВидБюджета, Отчет.ОтчетнаяДата);         
	Отчет.ПериодичностьПланирования  = ПараметрыОП.ПериодичностьОперативногоПланирования;
	Отчет.ПериодичностьЛимитирования = ПараметрыОП.ПериодичностьЛимитирования;
	Отчет.РезервированиеВПериодичностиПланирования = ПараметрыОП.РезервированиеВПериодичностиПланирования;
	
	СписокПериодичностиПланирования = ОперативноеПланированиеПовтИспУХ.ДоступныеПериодичностиПланирования();
	Элементы.ПериодичностьПланирования.СписокВыбора.ЗагрузитьЗначения(СписокПериодичностиПланирования);

	СписокПериодичностиЛимитирования = КонтрольЛимитовУХ.ДоступныеПериодичностиЛимитирования(Отчет.ВидБюджета, Отчет.ОтчетнаяДата);
	Элементы.ПериодичностьЛимитирования.СписокВыбора.ЗагрузитьЗначения(СписокПериодичностиЛимитирования);  
	   
	ПериодичностьЛимитирования = КонтрольЛимитовУХ.ПериодичностьЛимитирования(Отчет.ВидБюджета, Отчет.ОтчетнаяДата); 
	КонтрольЛимитовУХ.СравнитьПериодичностьПланированияЛимитирования(Отчет.ПериодичностьПланирования, ПериодичностьЛимитирования);

	ПериодичностьРезервирования = ?(Отчет.РезервированиеВПериодичностиПланирования, 1, 0);
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтчетнаяДатаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьПараметрыКонтроляПериода();
	
КонецПроцедуры    

&НаКлиенте
Процедура ОткрытьПараметрыКонтроляПериода()
	
	ДопПараметры = ПолучитьПараметрыФормыЗаписиПараметровЛимитирования(Отчет.ОтчетнаяДата, Отчет.ВидБюджета);
	Если ДопПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимВыбора", 			Истина);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", 	Истина);
	ПараметрыОткрытия.Вставить("Отбор", 				Новый Структура("ВидБюджета", Отчет.ВидБюджета));   
	
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитирования.Форма.ФормаВыбораПериода", ПараметрыОткрытия, 
																					ЭтаФорма,,,,,
																					РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
КонецПроцедуры

&НаКлиенте
Процедура ОтчетнаяДатаКоманда(Команда)
	
	ОткрытьПараметрыКонтроляПериода();   
	
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущийПериод(Команда)
	
	ИзменитьПериод(-1);
	
КонецПроцедуры

&НаКлиенте
Процедура СледующийПериод(Команда)
	
	ИзменитьПериод(1);
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьОтборыУФОПроектПриИзмененииНастроек(Элемент)
	
	СинхронизироватьНастройкиДинамическихСписков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	УстановитьСтраницуПоВидуОперации();   
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПериод(Команда)
	
	ПараметрыЛимитирования = ПараметрыЛимитированияПериода(Отчет.ВидБюджета, Отчет.ОтчетнаяДата, 1);
    
	Если ПараметрыЛимитирования = Неопределено Тогда
		ЗначенияЗаполнения = ПолучитьПараметрыЗаполнения(Отчет.ВидБюджета, Отчет.ОтчетнаяДата);
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		ДопПараметры.Вставить("Направление", 		1);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеЗаписиПериодаЛимитирования", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("РегистрСведений.ПараметрыЛимитирования.ФормаЗаписи", 
					ДопПараметры, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	Иначе
		ТекстПредупреждения = НСтр("ru = 'Открытия периода не требуется'");
		ПоказатьПредупреждение(, ТекстПредупреждения);      	
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура СтруктураПлана(Команда)
	
	ДопПараметры = Новый Структура("Отбор", Новый Структура("ВидБюджета", Отчет.ВидБюджета));
	ОткрытьФорму("РегистрСведений.СтруктураОперативногоПланирования.Форма.ФормаСпискаДляПанелиАдминистрирования", 
				 ДопПараметры, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры    

&НаКлиенте
Процедура ВариантыНастроек(Команда)

	ДопПараметры = Новый Структура("Отбор", Новый Структура("ВидБюджета", Отчет.ВидБюджета));
