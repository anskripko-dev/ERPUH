
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "ВидБюджета, Предназначение, ПериодичностьЛимитирования, НачалоПериода, ОкончаниеПериода");
	
	Объект.ВидБюджета = ВидБюджета;
	
	Для Каждого Строка Из Параметры.Данные Цикл
		ЗаполнитьЗначенияСвойств(Объект.КУстановкеУОП.Добавить(), Строка, "ЦФО, Проект, ПериодЛимитирования, Сценарий, УОП");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ШаблонСообщения = НСтр("ru = 'В строке %1 не не заполнено поле ""%2""'");
	ШаблонПутиПоля = "Объект.КУстановкеУОП[%1]";
	Для Каждого Строка Из Объект.КУстановкеУОП Цикл
		
		ПутьКПолю = СтрШаблон(ШаблонПутиПоля, Строка.НомерСтроки-1);
		Если НЕ ЗначениеЗаполнено(Строка.ЦФО) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонСообщения, Строка.НомерСтроки, НСтр("ru = 'ЦФО'")), , ПутьКПолю + ".ЦФО", , Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Строка.ПериодЛимитирования) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонСообщения, Строка.НомерСтроки, НСтр("ru = 'Период лимитирования'")), , ПутьКПолю + ".ПериодЛимитирования", , Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Строка.УОП) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонСообщения, Строка.НомерСтроки, НСтр("ru = 'Сценарий'")), , ПутьКПолю + ".УОП", , Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверка наличия дублей
	ИменаРеквизитов = "ЦФО, Проект, ПериодЛимитирования";
	Данные = Объект.КУстановкеУОП.Выгрузить();
	ЦФОПроектПериод = Данные.Скопировать(, ИменаРеквизитов);
	ЦФОПроектПериод.Свернуть(ИменаРеквизитов, "");
	
	ШаблонСообщения = НСтр("ru = 'Значения строки %1 совпадают со значениями  одной или нескольких других строк. Устраните дублирование данных и повторите операцию.'");
	
	СтруктураПоиска = Новый Структура(ИменаРеквизитов);
	Для Каждого Строка Из ЦФОПроектПериод Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка);
		
		СтрокиДанных = Данные.НайтиСтроки(СтруктураПоиска);
		Если СтрокиДанных.Количество() >1 Тогда
			Для Каждого СтрокаДанных Из СтрокиДанных Цикл
				ПутьКПолю = СтрШаблон(ШаблонПутиПоля, СтрокаДанных.НомерСтроки-1);
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонСообщения, СтрокаДанных.НомерСтроки), , ПутьКПолю+".Сценарий", , Отказ);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъектКУстановкеУОП

&НаКлиенте
Процедура ОбъектКУстановкеУОПСценарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	//
	ДопПараметры = Новый Структура("ВидБюджета, Предназначение, НачалоПериода, ОкончаниеПериода");
	ЗаполнитьЗначенияСвойств(ДопПараметры, ЭтотОбъект);
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьУОПДляСтрокиЗавершение", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Отчет.УправлениеЛимитами.Форма.ФормаВыбораСценарияДляУстановкиЛимита", ДопПараметры, ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКУстановкеУОПСценарийОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.ОбъектКУстановкеУОП.ТекущиеДанные.УОП = ПредопределенноеЗначение("Документ.УправлениеПериодомСценария.ПустаяСсылка");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьУОП(Команда)
	
	ДопПараметры = Новый Структура("ВидБюджета, Предназначение, НачалоПериода, ОкончаниеПериода");
	ЗаполнитьЗначенияСвойств(ДопПараметры, ЭтотОбъект);
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьУОПЗавершение", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Отчет.УправлениеЛимитами.Форма.ФормаВыбораСценарияДляУстановкиЛимита", ДопПараметры, ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУстановкуЛимитов(Команда)
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть(ПолучитьРезультат());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьРезультат()
	
	Возврат Объект.КУстановкеУОП;
	
КонецФункции

#Область ОбработкаВыбораУОПСценарий
	
&НаКлиенте
Процедура ВыбратьУОПЗавершение(Результат, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗаполнитьУОПДляВыбранныхПозиций(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУОПДляСтрокиЗавершение(Результат, ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьУОПДляТекущейСтрокиНаСервере(Результат);
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУОПДляВыбранныхПозиций(Результат)
	
	ДанныеУОП = ПолучитьДанныеУОП(Результат.УОП);
	Для Каждого Строка Из Объект.КУстановкеУОП Цикл
		ЗаполнитьУОПСценарийДляСтроки(Строка, Результат, ДанныеУОП);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУОПДляТекущейСтрокиНаСервере(Результат)
	ДанныеУОП = ПолучитьДанныеУОП(Результат.УОП);
	ТекущаяСтрока = Объект.КУстановкеУОП.НайтиПоИдентификатору(Элементы.ОбъектКУстановкеУОП.ТекущаяСтрока);
	ЗаполнитьУОПСценарийДляСтроки(ТекущаяСтрока, Результат, ДанныеУОП);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУОПСценарийДляСтроки(Строка, Результат, ДанныеУОП)
	
	Если ЦФОПроектПериодЕстьВУОП(Строка.ЦФО, Строка.Проект, Строка.ПериодЛимитирования, ДанныеУОП) Тогда
		Строка.УОП = Результат.УОП;
		Строка.Сценарий = Результат.Сценарий;
	Иначе
		Строка.УОП = Документы.УправлениеПериодомСценария.ПустаяСсылка();
		Строка.Сценарий = Справочники.Сценарии.ПустаяСсылка();
		ШаблонСообщения = НСтр("ru = 'В строке %1 сценарий не установлен, так как в нем отсутствуют данные по ЦФО, Проекту и Периоду лимитирования'");
		ШаблонПутиПоля = "Объект.КУстановкеУОП[%1]";
		ПутьКПолю = СтрШаблон(ШаблонПутиПоля, Строка.НомерСтроки-1);
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонСообщения, Строка.НомерСтроки), , ПутьКПолю + ".Сценарий");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеУОП(УОП)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Предназначение", Предназначение);
	Запрос.УстановитьПараметр("НачалоУстановки", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеУстановки", ОкончаниеПериода);
	Запрос.УстановитьПараметр("УОП", УОП);
	Запрос.УстановитьПараметр("Периодичность", ПериодичностьЛимитирования);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", ОкончаниеПериода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Периоды.Ссылка КАК ПериодЛимитирования
	|ПОМЕСТИТЬ ВТ_ПериодыЛимитирования
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.Периодичность = &Периодичность
	|	И Периоды.ДатаНачала >= &ДатаНачала
	|	И Периоды.ДатаОкончания <= &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыОтчетовПараметрыУстановкиЛимитов.Ссылка КАК ВидОтчета
	|ПОМЕСТИТЬ ВТ_ВидыОтчетовСЛимитированием
	|ИЗ
	|	Справочник.ВидыОтчетов.ПараметрыУстановкиЛимитов КАК ВидыОтчетовПараметрыУстановкиЛимитов
	|ГДЕ
	|	ВидыОтчетовПараметрыУстановкиЛимитов.Ссылка.МожетИспользоватьсяДляУстановкиЛимитов = ИСТИНА
	|	И ВидыОтчетовПараметрыУстановкиЛимитов.ВидБюджета = &Предназначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Запрос.ЦФО КАК ЦФО,
	|	Запрос.Проект КАК Проект,
	|	Запрос.ПериодЛимитирования КАК ПериодЛимитирования
	|ИЗ
	|	(ВЫБРАТЬ
	|		НастраиваемыйОтчет.Организация КАК ЦФО,
	|		НастраиваемыйОтчет.Проект КАК Проект,
	|		ВТ_ПериодыЛимитирования.ПериодЛимитирования КАК ПериодЛимитирования
	|	ИЗ
	|		Документ.НастраиваемыйОтчет КАК НастраиваемыйОтчет,
	|		ВТ_ПериодыЛимитирования КАК ВТ_ПериодыЛимитирования
	|	ГДЕ
	|		НастраиваемыйОтчет.УправлениеПериодом = &УОП
	|		И НастраиваемыйОтчет.УправлениеПериодом.УстанавливатьЛимиты = ИСТИНА
	|		И НастраиваемыйОтчет.ВидОтчета В
	|				(ВЫБРАТЬ
	|					Данные.ВидОтчета КАК ВидОтчета
	|				ИЗ
	|					ВТ_ВидыОтчетовСЛимитированием КАК Данные)
	|		И НастраиваемыйОтчет.УправлениеПериодом.ПометкаУдаления = ЛОЖЬ
	|		И НастраиваемыйОтчет.УправлениеПериодом.ПериодСценария.ДатаНачала <= &НачалоУстановки
	|		И НастраиваемыйОтчет.УправлениеПериодом.ПериодСценарияОкончание.ДатаОкончания >= &ОкончаниеУстановки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РакурсДанных.Организация,
	|		РакурсДанных.Проект,
	|		ВТ_ПериодыЛимитирования.ПериодЛимитирования
	|	ИЗ
	|		Документ.РакурсДанных КАК РакурсДанных
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УправлениеПериодомСценария КАК УправлениеПериодомСценария
	|			ПО РакурсДанных.Сценарий = УправлениеПериодомСценария.Сценарий
	|				И РакурсДанных.ПериодОтчета = УправлениеПериодомСценария.ПериодСценария,
	|		ВТ_ПериодыЛимитирования КАК ВТ_ПериодыЛимитирования
	|	ГДЕ
	|		УправлениеПериодомСценария.Ссылка = &УОП
	|		И УправлениеПериодомСценария.Ссылка.УстанавливатьЛимиты = ИСТИНА
	|		И РакурсДанных.Область.Владелец В
	|				(ВЫБРАТЬ
	|					Данные.ВидОтчета КАК ВидОтчета
	|				ИЗ
	|					ВТ_ВидыОтчетовСЛимитированием КАК Данные)
	|		И УправлениеПериодомСценария.Ссылка.ПометкаУдаления = ЛОЖЬ
	|		И УправлениеПериодомСценария.Ссылка.ПериодСценария.ДатаНачала <= &НачалоУстановки
	|		И УправлениеПериодомСценария.Ссылка.ПериодСценарияОкончание.ДатаОкончания >= &ОкончаниеУстановки) КАК Запрос";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Возврат Результат.Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ЦФОПроектПериодЕстьВУОП(ЦФО, Проект, ПериодЛимитирования, ДанныеУОП)
	
	СтруктураПоиска = Новый Структура("ЦФО, Проект, ПериодЛимитирования", ЦФО, Проект, ПериодЛимитирования);
	Возврат ДанныеУОП.НайтиСтроки(СтруктураПоиска).Количество() > 0;
	
КонецФункции

#КонецОбласти 

#КонецОбласти
 
