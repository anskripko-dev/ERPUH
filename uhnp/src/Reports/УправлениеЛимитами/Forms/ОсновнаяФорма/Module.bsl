#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("УОП") И ЗначениеЗаполнено(Параметры.УОП) Тогда
		Отчет.УОП = Параметры.УОП;
	КонецЕсли;
	
	ВидОперации = 4;
	Если Параметры.Свойство("ОткрытьОперацию") Тогда
		Если Параметры.ОткрытьОперацию = "УстановкаЛимитов" Тогда
			ВидОперации = 0;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПараметрыВложенныхФорм();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОткрытьАктивнуюФорму", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		
	Если ИмяСобытия = "НавигационнаяКомандаВложеннойФормы" И Источник = ЭтаФорма Тогда
		ПараметрыФормы = ВложенныеФормы.НайтиПоЗначению(Параметр.Имя);
		Если ПараметрыФормы <> Неопределено Тогда
			ВидОперации = ВложенныеФормы.Индекс(ПараметрыФормы);
			УстановитьСтраницуПоВидуОперации();
		ИначеЕсли Параметр.Имя = "УправлениеЛимитамиСправка" Тогда
			ОткрытьСправкуФормы();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьАктивнуюФорму()
	
	ЭтаФорма.АвтоЗаголовок = Ложь;
	//ВидОперации = 4;
	УстановитьСтраницуПоВидуОперации();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВложенныхФорм()
	
	ВложенныеФормы = Новый СписокЗначений;
	ВложенныеФормы.Добавить("УстановкаЛимитовПредварительная", 		"Отчет.УстановкаЛимитовПредварительная.Форма");
	ВложенныеФормы.Добавить("УправлениеЛимитамиКонтроль", 			"Отчет.ОтчетПоЛимитам.Форма");
	ВложенныеФормы.Добавить("УправлениеЛимитамиЗаявка", 			"Отчет.УправлениеЛимитами.Форма.ФормаОтчета");
	ВложенныеФормы.Добавить("УправлениеЛимитамиКорректировка", 		"Отчет.УправлениеЛимитами.Форма.ФормаОтчета");
	ВложенныеФормы.Добавить("УправлениеЛимитамиНастройка", 			"Отчет.УправлениеЛимитами.Форма.ФормаОтчета");
	ВложенныеФормы.Добавить("УправлениеЛимитамиКонтрольИсполнения", "Отчет.УправлениеЛимитами.Форма.ФормаОтчета");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуПоВидуОперации()
	
	Если ЭтаФорма.Окно <> Неопределено Тогда
		Для Каждого ФормаОкна Из ЭтаФорма.Окно.Содержимое Цикл
			Если ФормаОкна.ИмяФормы = ВложенныеФормы[ВидОперации].Представление Тогда
				ФормаОкна.Активизировать();
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыВложеннойФормы = УправлениеЛимитамиУХКлиентСервер.ПараметрыВложеннойФормы();
	ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы.ПараметрыПанели.ПередЭлементом = Неопределено;
	КоманднаяПанельВложеннойФормы = ПараметрыВложеннойФормы.КоманднаяПанельВложеннойФормы;
	ДобавитьНавигационныеКомандыВложенныхФорм(КоманднаяПанельВложеннойФормы, ВложенныеФормы[ВидОперации].Значение);
	
	Если ВидОперации = 0 Тогда
		КоманднаяПанельВложеннойФормы.ПараметрыПанели.Родитель = "ГруппаВидыОпераций";
		ПараметрыВложеннойФормы.Вставить("КлючВарианта", "Вариант1");	
	ИначеЕсли ВидОперации = 2 Или ВидОперации = 3 Или ВидОперации = 4 Тогда
		КоманднаяПанельВложеннойФормы.ПараметрыПанели.Родитель = "ГруппаВидыОпераций";
		ПараметрыВложеннойФормы.Вставить("КлючВарианта", "ЛимитыБюджетов");
	КонецЕсли;
	Если ВидОперации = 0 Тогда
		ПараметрыВложеннойФормы.Вставить("УОП", Отчет.УОП);
	КонецЕсли;
	
	ФормаОтчетаПоЛимитам = ОткрытьФорму(ВложенныеФормы[ВидОперации].Представление, 
										ПараметрыВложеннойФормы, 
										ЭтаФорма,, 
										ЭтаФорма.Окно);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьНавигационныеКомандыВложенныхФорм(Знач КоманднаяПанельВложеннойФормы, ИмяАктивнойКоманды)
	
	КоманднаяПанельВложеннойФормы.ДобавленныеКоманды.Добавить(УправлениеЛимитамиУХКлиентСервер.КомандаВложеннойФормы(
																"УправлениеЛимитамиНастройка",
																Нстр("ru = 'Настройка'"),
																"КнопкаКоманднойПанели",
																ИмяАктивнойКоманды = "УправлениеЛимитамиНастройка",
																"АналитикиСтатейБюджетовУХКлиент.НавигационнаяКомандаВложеннойФормы",
																"ГруппаНастроекГода"));
	КоманднаяПанельВложеннойФормы.ДобавленныеКоманды.Добавить(УправлениеЛимитамиУХКлиентСервер.КомандаВложеннойФормы(
																"УстановкаЛимитовПредварительная",
																Нстр("ru = 'Установка лимитов'"),
																"КнопкаКоманднойПанели",  
																ИмяАктивнойКоманды = "УстановкаЛимитовПредварительная",
																"АналитикиСтатейБюджетовУХКлиент.НавигационнаяКомандаВложеннойФормы",
																"ГруппаНастроекГода"));
	КоманднаяПанельВложеннойФормы.ДобавленныеКоманды.Добавить(УправлениеЛимитамиУХКлиентСервер.КомандаВложеннойФормы(
																"УправлениеЛимитамиКонтрольИсполнения",
																Нстр("ru = 'Контроль исполнения'"),
																"КнопкаКоманднойПанели",  
																ИмяАктивнойКоманды = "УправлениеЛимитамиКонтрольИсполнения",
																"АналитикиСтатейБюджетовУХКлиент.НавигационнаяКомандаВложеннойФормы",
																"ГруппаНастроекГода"));
	КоманднаяПанельВложеннойФормы.ДобавленныеКоманды.Добавить(УправлениеЛимитамиУХКлиентСервер.КомандаВложеннойФормы(
																"УправлениеЛимитамиКорректировка",
																Нстр("ru = 'Корректировка'"),
																"КнопкаКоманднойПанели",  
																ИмяАктивнойКоманды = "УправлениеЛимитамиКорректировка",
																"АналитикиСтатейБюджетовУХКлиент.НавигационнаяКомандаВложеннойФормы",
																"ГруппаНастроекГода")); 
	КоманднаяПанельВложеннойФормы.ДобавленныеКоманды.Добавить(УправлениеЛимитамиУХКлиентСервер.КомандаВложеннойФормы(
																"УправлениеЛимитамиСправка",
																"?",
																"КнопкаКоманднойПанели",  
																ИмяАктивнойКоманды = "УправлениеЛимитамиСправка",
																"АналитикиСтатейБюджетовУХКлиент.НавигационнаяКомандаВложеннойФормы",
																"ГруппаНастроекГода"));

КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	УстановитьСтраницуПоВидуОперации();
КонецПроцедуры

#КонецОбласти
