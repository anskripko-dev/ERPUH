#Область ОписаниеПеременных

&НаКлиенте
Перем ПоследнееВыделение;

#КонецОбласти


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЧислоДопАналитик = ПараметрыСеанса.ЧислоДопАналитик;
	Параметры.Свойство("УправлениеПериодом", Отчет.УправлениеПериодом);
	
	ЦветФонаВыделения = Метаданные.ЭлементыСтиля.ЦветВыделенияВТабличномДокументе.Значение;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойВариантаНаСервере(Настройки)
	
	Если Параметры.Свойство("Расшифровка")
		И ТипЗнч(Параметры.Расшифровка) = Тип("ОписаниеОбработкиРасшифровкиКомпоновкиДанных") Тогда
		
		// Обработка расшифровки отчета
		// Для данного отчета возможен только один вид расшифровки "Отфильтровать"
		СтруктураНастроекКомпоновкиДанных  = Параметры.Расшифровка.ПрименяемыеНастройки.Структура;
		Для Каждого ЭлементСтруктуры Из СтруктураНастроекКомпоновкиДанных Цикл
			Если ЭлементСтруктуры.Использование Тогда
				Для Каждого ЭлементПереданногоОтбора Из ЭлементСтруктуры.Отбор.Элементы Цикл
					ОтборУстановлен = Ложь;
					Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
						Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
							И ЭлементОтбора.Родитель = Неопределено
							И ЭлементОтбора.ЛевоеЗначение = ЭлементПереданногоОтбора.ЛевоеЗначение Тогда
							// Отбор совпадает
							ЗаполнитьЗначенияСвойств(ЭлементОтбора, ЭлементПереданногоОтбора);
							ОтборУстановлен = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ ОтборУстановлен Тогда
						ЭлементОтбора = Настройки.Отбор.Элементы.Добавить();
						ЗаполнитьЗначенияСвойств(ЭлементОтбора, ЭлементПереданногоОтбора);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки, ИспользуютсяСтандартныеНастройки)
	
	ПараметрУправлениеПериодом = Настройки.Элементы.Получить(0);
	
	Если ЗначениеЗаполнено(Отчет.УправлениеПериодом) Тогда
		ПараметрУправлениеПериодом.Значение = Отчет.УправлениеПериодом;
	Иначе
		Отчет.УправлениеПериодом = ПараметрУправлениеПериодом.Значение;
	КонецЕсли;
	
	ОбновитьДанныеУправленияПериодом();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененОбъектОтчетности_НастраиваемыйОтчет" Тогда
		
		СкомпоноватьРезультат();
		
	ИначеЕсли ИмяСобытия = "ИзмененОбъектОтчетности_УправлениеПериодомСценария"
		И Параметр = Отчет.УправлениеПериодом Тогда
		
		УправлениеПериодом = Неопределено;
		СкомпоноватьРезультат();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УправлениеПериодомПриИзменении(Элемент)
	
	ОбновитьДанныеУправленияПериодом();
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(0).Значение = Отчет.УправлениеПериодом;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "Неактуальность");
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизации(Элемент)
	
	Если Результат.ВыделенныеОбласти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.1);
	ПодключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизации", ИнтервалОжидания, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначениеРасшифровки = ЗначениеТекущегоПоляРасшифровкиНаСервере(Расшифровка, ДанныеРасшифровки);
	Если ЗначениеЗаполнено(ЗначениеРасшифровки) Тогда
		ПоказатьЗначение(, ЗначениеРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Расшифровка", Расшифровка);
	
	МассивДействий = Новый Массив;
	МассивДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	МассивДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать);
	
	ДополнительныеДействия = Новый СписокЗначений;
	
	Если НЕ Отчет.ПериодЗакрыт Тогда
	
		// Получим значения расшифровки
		МассивРасшифровок = ПолучитьДанныеРасшифровки();
		ЗаполненыВидыОтчетов = Истина;
		ЗаполненыОрганизации = Истина;
		ЗаполненыДокументы = Истина;
		НеЗаполненыДокументы = Истина;
		Для Каждого СтруктураДанныхРасшифровки Из МассивРасшифровок Цикл
			Если НЕ ЗначениеЗаполнено(СтруктураДанныхРасшифровки.ВидОтчета) Тогда
				ЗаполненыВидыОтчетов = Ложь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтруктураДанныхРасшифровки.Организация) Тогда
				ЗаполненыОрганизации = Ложь;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтруктураДанныхРасшифровки.Документ) Тогда
				НеЗаполненыДокументы = Ложь;
			Иначе
				ЗаполненыДокументы = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗаполненыВидыОтчетов И ЗаполненыОрганизации Тогда
			// Есть данные для создания документов
			Если НЕ ЗаполненыДокументы Тогда
				Если МассивРасшифровок.Количество() = 1 Тогда
					ДополнительныеДействия.Добавить("СоздатьДокумент", НСтр("ru = 'Создать документ вручную'"), , БиблиотекаКартинок.СинтаксическийКонтроль);
				КонецЕсли;
				ДополнительныеДействия.Добавить("СоздатьДокументы", НСтр("ru = 'Создать документы'"), , БиблиотекаКартинок.СоздатьЭлементСписка);
				ДополнительныеДействия.Добавить("СоздатьИЗаполнитьДокументы", НСтр("ru = 'Создать и заполнить документы'"), , БиблиотекаКартинок.СкопироватьЭлементСписка);
			КонецЕсли;
			Если НЕ НеЗаполненыДокументы Тогда
				ДополнительныеДействия.Добавить("ЗаполнитьДокументы", НСтр("ru = 'Заполнить документы'"), , БиблиотекаКартинок.ОбновлениеРО16);
			
				ДополнительныеДействияСостояния = Новый СписокЗначений;
				ДополнительныеДействияСостояния.Добавить("УстановитьСостояниеЗапланирован", НСтр("ru = 'Установить статус ""Не заполнен""'"), , БиблиотекаКартинок.ОтчетЗапланирован);
				ДополнительныеДействияСостояния.Добавить("УстановитьСостояниеВыполняется", НСтр("ru = 'Установить статус ""Черновик""'"), , БиблиотекаКартинок.ОтчетВыполняется);
				ДополнительныеДействияСостояния.Добавить("УстановитьСостояниеПодготовлен", НСтр("ru = 'Установить статус ""Проверен, на утверждении""'"), , БиблиотекаКартинок.ОтчетПодготовлен);
				ДополнительныеДействияСостояния.Добавить("УстановитьСостояниеВозвращен", НСтр("ru = 'Установить статус ""Отправлен на уточнение""'"), , БиблиотекаКартинок.ОтчетВозвращен);
				ДополнительныеДействияСостояния.Добавить("УстановитьСостояниеУтвержден", НСтр("ru = 'Установить статус ""Утвержден""'"), , БиблиотекаКартинок.ОтчетУтвержден_БезГалочки);
				ДополнительныеДействияСостояния.Добавить("УстановитьСостояниеЗаписанСОшибкой", НСтр("ru = 'Установить статус ""Заполнен с ошибками""'"), , БиблиотекаКартинок.ОтчетЗаписанСОшибкой);
				ДополнительныеДействия.Добавить(ДополнительныеДействияСостояния, НСтр("ru = 'Установить статус'"));
			КонецЕсли;
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("МассивРасшифровок", МассивРасшифровок);
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораДействияРасшифровки", ЭтотОбъект, ДополнительныеПараметры);
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет));
	ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещения, Расшифровка, МассивДействий, ДополнительныеДействия);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДействияРасшифровки(ВыбранноеДействие, ПараметрВыбранногоДействия, ДополнительныеПараметры) Экспорт
	
	МассивСообщений = Новый Массив;
	
	Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		
		ПоказатьЗначение(,ПараметрВыбранногоДействия);
		Возврат;
		
	ИначеЕсли ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать Тогда
		
		ОписаниеОбработкиРасшифровки = Новый ОписаниеОбработкиРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, ДополнительныеПараметры.Расшифровка, ПараметрВыбранногоДействия);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормы.Вставить("Расшифровка", ОписаниеОбработкиРасшифровки);
		
		ОткрытьФорму("Отчет.МатрицаЭкземпляровОтчетов.Форма.ФормаОтчета", ПараметрыФормы, , Новый УникальныйИдентификатор);
		Возврат;
		
	ИначеЕсли ВыбранноеДействие = "СоздатьДокумент" Тогда
		
		Расшифровка = ДополнительныеПараметры.МассивРасшифровок.Получить(0);
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Сценарий", Отчет.Сценарий);
		ЗначенияЗаполнения.Вставить("ПериодОтчета", Отчет.ПериодОтчета);
		ЗначенияЗаполнения.Вставить("ПериодОкончания", Отчет.ПериодОкончания);
		ЗначенияЗаполнения.Вставить("ВидОтчета", Расшифровка.ВидОтчета);
		ЗначенияЗаполнения.Вставить("Организация", Расшифровка.Организация);
		ЗначенияЗаполнения.Вставить("Проект", Расшифровка.Проект);
		Для Сч = 1 По ЧислоДопАналитик Цикл
			ЗначенияЗаполнения.Вставить("Аналитика" + Сч, Расшифровка["Аналитика" + Сч]);
		КонецЦикла;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("Документ.НастраиваемыйОтчет.ФормаОбъекта", ПараметрыФормы);
		Возврат;
		
	ИначеЕсли ВыбранноеДействие = "СоздатьДокументы" Тогда
		
		СоздатьДокументыНаСервере(ДополнительныеПараметры.МассивРасшифровок, МассивСообщений);
		
	ИначеЕсли ВыбранноеДействие = "СоздатьИЗаполнитьДокументы" Тогда
		
		СоздатьИЗаполнитьДокументыНаСервере(ДополнительныеПараметры.МассивРасшифровок, МассивСообщений);
		
	ИначеЕсли ВыбранноеДействие = "ЗаполнитьДокументы" Тогда
		
		ЗаполнитьДокументыНаСервере(ДополнительныеПараметры.МассивРасшифровок, МассивСообщений);
		
	ИначеЕсли ВыбранноеДействие = "УстановитьСостояниеЗапланирован" Тогда
		
		ИзменитьСостояниеНаСервере(ДополнительныеПараметры.МассивРасшифровок, ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.Запланирован"));
		
	ИначеЕсли ВыбранноеДействие = "УстановитьСостояниеВыполняется" Тогда
		
		ИзменитьСостояниеНаСервере(ДополнительныеПараметры.МассивРасшифровок, ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.Выполняется"));
		
	ИначеЕсли ВыбранноеДействие = "УстановитьСостояниеПодготовлен" Тогда
		
		ИзменитьСостояниеНаСервере(ДополнительныеПараметры.МассивРасшифровок, ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.Подготовлен"));
		
	ИначеЕсли ВыбранноеДействие = "УстановитьСостояниеВозвращен" Тогда
		
		ИзменитьСостояниеНаСервере(ДополнительныеПараметры.МассивРасшифровок, ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.Возвращен"));
		
	ИначеЕсли ВыбранноеДействие = "УстановитьСостояниеУтвержден" Тогда
		
		ИзменитьСостояниеНаСервере(ДополнительныеПараметры.МассивРасшифровок, ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.Утвержден"));
		
	ИначеЕсли ВыбранноеДействие = "УстановитьСостояниеЗаписанСОшибкой" Тогда
		
		ИзменитьСостояниеНаСервере(ДополнительныеПараметры.МассивРасшифровок, ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.ЗаписанСОшибкой"));
		
	КонецЕсли;
	
	СкомпоноватьРезультат();
	
	Для Каждого Сообщение Из МассивСообщений Цикл
		Сообщение.Сообщить();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Настройки(Команда)
	
	Элементы.ФормаНастройки.Пометка = НЕ Элементы.ФормаНастройки.Пометка;
	Элементы.ГруппаНастройки.Видимость = Элементы.ФормаНастройки.Пометка;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДанныеУправленияПериодом()
	
	ДанныеУОП = БюджетированиеИОтчетностьПовтИсп.ДанныеУправленияПериодомСценария(Отчет.УправлениеПериодом);
	
	Отчет.УправлениеПериодом = ДанныеУОП.УправлениеПериодом;
	Отчет.ПериодОтчета = ДанныеУОП.ПериодСценария;
	Отчет.ПериодОкончания = ДанныеУОП.ПериодСценарияОкончание;
	Отчет.Сценарий = ДанныеУОП.Сценарий;
	Отчет.Периодичность = ДанныеУОП.Периодичность;
	Отчет.ПериодЗакрыт = ДанныеУОП.ПериодЗакрыт = Истина;
	
	Элементы.НадписьПериодЗакрыт.Видимость = Отчет.ПериодЗакрыт;
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(0).Значение = Отчет.УправлениеПериодом;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеРасшифровки()
	
	МассивРасшифровок = Новый Массив;
	
	Для Каждого ВыделеннаяОбласть Из Результат.ВыделенныеОбласти Цикл
		Если ТипЗнч(ВыделеннаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Для СчСтолбцы = ВыделеннаяОбласть.Лево По ВыделеннаяОбласть.Право Цикл
				Для СчСтроки = ВыделеннаяОбласть.Верх По ВыделеннаяОбласть.Низ Цикл
					
					ТекущаяОбласть = Результат.Область(СчСтроки, СчСтолбцы, СчСтроки, СчСтолбцы);
					Если ТекущаяОбласть.Расшифровка = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					СтруктураДанныхРасшифровки = СтруктураДанныхРасшифровки();
					
					ДанныеРасшифровкиНаСервере(ТекущаяОбласть.Расшифровка, ДанныеРасшифровки, СтруктураДанныхРасшифровки);
					
					МассивРасшифровок.Добавить(СтруктураДанныхРасшифровки);
					
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивРасшифровок;
	
КонецФункции

&НаКлиенте
Функция СтруктураДанныхРасшифровки()

	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВидОтчета");
	СтруктураДанных.Вставить("Организация");
	СтруктураДанных.Вставить("Проект");
	СтруктураДанных.Вставить("Документ");
	Для Сч = 1 По ЧислоДопАналитик Цикл
		СтруктураДанных.Вставить("Аналитика" + Сч);
	КонецЦикла;
	
	СтруктураДанных.Вставить("УправлениеПериодом", Отчет.УправлениеПериодом);
	СтруктураДанных.Вставить("ПериодОтчета", Отчет.ПериодОтчета);
	СтруктураДанных.Вставить("ПериодОкончания", Отчет.ПериодОкончания);
	СтруктураДанных.Вставить("Сценарий", Отчет.Сценарий);
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеТекущегоПоляРасшифровкиНаСервере(Расшифровка, ДанныеРасшифровки)
	
	ДанныеРасшифровкиЗначение = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	
	МассивПолей = ДанныеРасшифровкиЗначение.Элементы[Расшифровка].ПолучитьПоля();
	Если МассивПолей.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат МассивПолей.Получить(0).Значение;
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Процедура ДанныеРасшифровкиНаСервере(Расшифровка, ДанныеРасшифровки, СтруктураДанныхРасшифровки)
	
	ДанныеРасшифровкиЗначение = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	
	МассивПолей = ДанныеРасшифровкиЗначение.Элементы[Расшифровка].ПолучитьПоля();
	Для Каждого Поле Из МассивПолей Цикл
		СтруктураДанныхРасшифровки.Вставить(Поле.Поле, Поле.Значение);
	КонецЦикла;
	
	// Значения всех вышестоящих группировок
	ПолучитьЗначениеГруппировки(ДанныеРасшифровкиЗначение, Расшифровка, СтруктураДанныхРасшифровки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьЗначениеГруппировки(ДанныеРасшифровкиЗначение, Расшифровка, СтруктураДанныхРасшифровки)
	
	МассивРодителей = ДанныеРасшифровкиЗначение.Элементы[Расшифровка].ПолучитьРодителей();
	Для СчРодителей = 1 По МассивРодителей.Количество() Цикл
		
		ПолеРодитель = МассивРодителей[СчРодителей-1];
		Если Число(ПолеРодитель.Идентификатор) > 0 Тогда
			
			// Получим текущее поле
			Если ТипЗнч(ПолеРодитель) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
				МассивПолей = ПолеРодитель.ПолучитьПоля();
			ИначеЕсли ТипЗнч(ПолеРодитель) = Тип("ЭлементРасшифровкиКомпоновкиДанныхГруппировка") Тогда
				МассивПолей = ПолеРодитель.ПолучитьРодителей()[0].ПолучитьПоля();
			КонецЕсли;
			
			Для Каждого Поле Из МассивПолей Цикл
				Если НЕ ЗначениеЗаполнено(СтруктураДанныхРасшифровки[Поле.Поле]) Тогда
					СтруктураДанныхРасшифровки.Вставить(Поле.Поле, Поле.Значение);
				КонецЕсли;
			КонецЦикла;
			
			// Рекурсивный вызов процедуры 
			РасшифровкиВыше = ПолеРодитель.ПолучитьРодителей()[0].Идентификатор;
			ПолучитьЗначениеГруппировки(ДанныеРасшифровкиЗначение, РасшифровкиВыше, СтруктураДанныхРасшифровки);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьДокументыНаСервере(МассивРасшифровок, МассивСообщений)
	
	Для Каждого Расшифровка Из МассивРасшифровок Цикл
		Если НЕ ЗначениеЗаполнено(Расшифровка.Документ) Тогда
			СоздатьНастраиваемыйОтчет(Расшифровка, МассивСообщений);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю() Цикл
		МассивСообщений.Добавить(Сообщение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьИЗаполнитьДокументыНаСервере(МассивРасшифровок, МассивСообщений)
	
	Для Каждого Расшифровка Из МассивРасшифровок Цикл
		Если ЗначениеЗаполнено(Расшифровка.Документ) Тогда
			ДокументОбъект = Расшифровка.Документ.ПолучитьОбъект();
		Иначе
			ДокументОбъект = СоздатьНастраиваемыйОтчет(Расшифровка, МассивСообщений);
		КонецЕсли;
		Если ДокументОбъект <> Неопределено Тогда
			ЗаполнитьНастраиваемыйОтчет(ДокументОбъект, МассивСообщений);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю() Цикл
		МассивСообщений.Добавить(Сообщение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьДокументыНаСервере(МассивРасшифровок, МассивСообщений)

	Для Каждого Расшифровка Из МассивРасшифровок Цикл
		Если ЗначениеЗаполнено(Расшифровка.Документ) Тогда
			ЗаполнитьНастраиваемыйОтчет(Расшифровка.Документ.ПолучитьОбъект(), МассивСообщений);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю() Цикл
		МассивСообщений.Добавить(Сообщение);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьНастраиваемыйОтчет(ВходныеДанные, МассивСообщений)
	
	Если НЕ ЗначениеЗаполнено(ВходныеДанные.Организация)
		ИЛИ НЕ ЗначениеЗаполнено(ВходныеДанные.ВидОтчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = Документы.НастраиваемыйОтчет.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ВходныеДанные);
	ДокументОбъект.Заполнить(ДокументОбъект.ВидОтчета);
	
	Попытка
		ДокументОбъект.Записать();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось записать документ ""%1"", по причине: %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			ДокументОбъект, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ДокументОбъект;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьНастраиваемыйОтчет(ДокументОбъект, МассивСообщений)
	
	// Заполняем отчет по регламенту
	ОбработкаРасчета = Обработки.РасчетИЗаписьПоказателей.Создать();
	Результат = ОбработкаРасчета.ЗаполнитьДанныеПоПериодам(ДокументОбъект, , , Истина);
	
	Если Результат Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ ""%1"" рассчитан по регламенту'"), ДокументОбъект);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЕстьОписаниеВерсии = ЗначениеЗаполнено(МодульУправленияПроцессамиУХ
			.ВернутьТекущееОписаниеВерсииДляЭкземпляраОтчета(ДокументОбъект.Ссылка));
		
		Если ЕстьОписаниеВерсии Тогда
			НовоеСостояние = Перечисления.СостоянияОтчетов.Выполняется;
		Иначе // Формально рассчитан, но данных для заполнения нет
			НовоеСостояние = Перечисления.СостоянияОтчетов.Запланирован;
		КонецЕсли;
		
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось рассчитать документ ""%1"" по регламенту'"), ДокументОбъект);
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		НовоеСостояние = Перечисления.СостоянияОтчетов.ЗаписанСОшибкой;
	КонецЕсли;
	
	РасширениеПроцессыИСогласованиеУХ.ПеревестиЗаявкуВПроизвольноеСостояние(ДокументОбъект.Ссылка, НовоеСостояние);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьСостояниеНаСервере(МассивРасшифровок, Состояние)
	
	Для Каждого Расшифровка Из МассивРасшифровок Цикл
		Если ЗначениеЗаполнено(Расшифровка.Документ) Тогда
			УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(Расшифровка.Документ, Состояние);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область Выделение

&НаКлиенте
Процедура Подключаемый_РезультатПриАктивизации()
	
	ВосстановитьФонПредудущихОбластей();
	
	ИдентификаторыОбластей = ИдентификаторыРасшифровкиВыделенныхОбластей();
	ПолучитьИдентификаторыВыделения(ИдентификаторыОбластей, ДанныеРасшифровки);
	УстановитьФонВыделения(ИдентификаторыОбластей);
	
КонецПроцедуры

&НаКлиенте
Функция ИдентификаторыРасшифровкиВыделенныхОбластей()
	
	ИдентификаторыОбластей = Новый Массив;
	
	Для Каждого ВыделеннаяОбласть Из Результат.ВыделенныеОбласти Цикл
		Если ТипЗнч(ВыделеннаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Для НомерСтолбца = ВыделеннаяОбласть.Лево По ВыделеннаяОбласть.Право Цикл
				Для НомерСтроки = ВыделеннаяОбласть.Верх По ВыделеннаяОбласть.Низ Цикл
					Ячейка = Результат.Область(НомерСтроки, НомерСтолбца, НомерСтроки, НомерСтолбца);
					Если Ячейка.ТипОбласти <> ПредопределенноеЗначение("ТипОбластиЯчеекТабличногоДокумента.Прямоугольник") Тогда
						Продолжить;
					КонецЕсли;
					Если Ячейка.Расшифровка <> Неопределено Тогда
						
						ДанныеВыделения = Новый Структура;
						ДанныеВыделения.Вставить("Идентификатор", Ячейка.Расшифровка);
						ДанныеВыделения.Вставить("Верх", НомерСтроки);
						ДанныеВыделения.Вставить("Лево", НомерСтолбца);
						
						ИдентификаторыОбластей.Добавить(ДанныеВыделения);
						
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИдентификаторыОбластей;
	
КонецФункции

&НаСервере
Процедура ПолучитьИдентификаторыВыделения(ИдентификаторыОбластей, ДанныеРасшифровки)
	
	Если ДанныеРасшифровки = "" Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторыВыделения = Новый Массив;
	
	ДанныеРасшифровкиЗначение = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	Для Каждого Элемент Из ИдентификаторыОбластей Цикл
		
		МассивПолей = ДанныеРасшифровкиЗначение.Элементы[Элемент.Идентификатор].ПолучитьПоля(); //
		Для Каждого Поле Из МассивПолей Цикл
			Если Поле.Поле = "Документ" И Поле.Значение <> Неопределено Тогда
				
				ИдентификаторыВыделения.Добавить(Элемент);
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ИдентификаторыОбластей = ИдентификаторыВыделения;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФонВыделения(ИдентификаторыВыделения)
	
	ПоследнееВыделение = Новый Соответствие;
	
	Для Каждого Элемент Из ИдентификаторыВыделения Цикл
		
		ОбластьВыделения = Результат.Область(Элемент.Верх, Элемент.Лево, Элемент.Верх, Элемент.Лево);
		ЗапомнитьФонОбласти(Элемент.Верх, Элемент.Лево);
		ОбластьВыделения.ЦветФона = ЦветФонаВыделения;
		
		// Выделим организацию
		ОбластьВыделения = Результат.Область(1, Элемент.Лево, 1, Элемент.Лево);
		ЗапомнитьФонОбласти(1, Элемент.Лево);
		ОбластьВыделения.ЦветФона = ЦветФонаВыделения;
		
		ОбластьВыделения = Результат.Область(2, Элемент.Лево, 2, Элемент.Лево);
		ЗапомнитьФонОбласти(2, Элемент.Лево);
		ОбластьВыделения.ЦветФона = ЦветФонаВыделения;
		
		// Выделим аналитики
		ОбластьВыделения = Результат.Область(Элемент.Верх, 1, Элемент.Верх, Отчет.СдвигЗаголовков);
		Для Сч = 1 По Отчет.СдвигЗаголовков Цикл
			ЗапомнитьФонОбласти(Элемент.Верх, Сч);
		КонецЦикла;
		ОбластьВыделения.ЦветФона = ЦветФонаВыделения;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьФонПредудущихОбластей()

	Если ПоследнееВыделение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяОбластиЦвет Из ПоследнееВыделение Цикл 
		
		Область = Результат.Область(ИмяОбластиЦвет.Ключ);
		Область.ЦветФона = ИмяОбластиЦвет.Значение;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьФонОбласти(НомерСтроки, НомерКолонки)

	Область = Результат.Область(НомерСтроки, НомерКолонки);
	Если ПоследнееВыделение.Получить(Область.Имя) = Неопределено Тогда
		ПоследнееВыделение.Вставить(Область.Имя, Область.ЦветФона);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
