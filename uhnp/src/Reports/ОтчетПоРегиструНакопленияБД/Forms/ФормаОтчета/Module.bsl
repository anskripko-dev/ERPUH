&НаКлиенте
Процедура ТабРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Если ТипЗнч(Расшифровка)=Тип("Структура") Тогда
		
		ДанныеРасшифровки=Расшифровка;
		
		СтандартнаяОбработка=Ложь;
		
		// Определим последнюю группировку расшифровки
		
		ПараметрыРасшифровки=Неопределено;
		ИмяГруппировки="";
		СписокДополнительныхПолей=Новый СписокЗначений;
		СписокПропускаемыхПолей=Новый СписокЗначений;
		
		Для Каждого Элемент ИЗ Расшифровка Цикл
			
			ИмяГруппировки=Элемент.Ключ;
			
			Если Элемент.Ключ="Регистратор" Тогда
				Продолжить;
			КонецЕсли;
			
			СписокПропускаемыхПолей.Добавить(Элемент.Ключ);			
						
		КонецЦикла;
		
		ДанныеГруппировки=Расшифровка[ИмяГруппировки];
		
		Если ИмяГруппировки="Регистратор" Тогда
			
			ДанныеОбъекта=ОткрытьФормуОбъектаБД(ДанныеГруппировки);
			
			Если ДанныеОбъекта=Неопределено Тогда // Открылась форма в толстом клиенте
				
				Возврат;
			
			ИначеЕсли ДанныеОбъекта.Свойство("ИмяОбъектаМетаданных") Тогда
				
				ОткрытьФорму(ДанныеОбъекта.ИмяОбъектаМетаданных+".ФормаОбъекта",ДанныеОбъекта.СтруктураПараметров);
				
			Иначе
				
				Если ТипЗнч(ДанныеОбъекта)=Тип("Структура") Тогда
					
					Имя = "ОбщаяФорма.ОтображениеЭлементаWS_Управляемая";
					ОткрытьФорму(Имя, Новый Структура("Расшифровка, ИспользуемаяИБ", ДанныеОбъекта, Отчет.ИспользуемаяИБ));
					
				КонецЕсли;
				
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
		
		////////////////////////////////////////////////////////////
		// Возможно открытие формы объекта
		
		Если ТипЗнч(ДанныеГруппировки)=Тип("Структура") И ДанныеГруппировки.Свойство("ТипОбъектаМетаданных") Тогда
			
			Если ДанныеГруппировки.ТипОбъектаМетаданных="Справочник" Тогда
				
				СписокДополнительныхПолей.Добавить("ОткрытьОбъект",Нстр("ru = 'Открыть элемент справочника'; en = 'Open catalog item';tr = 'Katalog öğesini aç'"));
				
			ИначеЕсли ДанныеГруппировки.ТипОбъектаМетаданных="Документ" Тогда
				
				СписокДополнительныхПолей.Добавить("ОткрытьОбъект",Нстр("ru = 'Открыть форму документа'; en = 'Open document form';tr = 'Belge formunu aç'"));
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ Расшифровка.Свойство("Регистратор") Тогда
			
			СписокДополнительныхПолей.Добавить("Регистратор",Нстр("ru = 'По документам движения'; en = 'By movement documents';tr = 'Hareket belgelerine göre'"));
			
		КонецЕсли;
		
		Для Каждого СтрОтбор ИЗ Отчет.ТабПравилаВычисленияПараметров Цикл
			
			ПоложениеРазделителя = СтрНайти(СтрОтбор.ИмяПараметра,".");
			
			Если ПоложениеРазделителя=0 Тогда
				СписокПропускаемыхПолей.Добавить(СтрОтбор.ИмяПараметра);
			Иначе
				СписокПропускаемыхПолей.Добавить(Лев(СтрОтбор.ИмяПараметра,ПоложениеРазделителя-1));
			КонецЕсли;
			
		КонецЦикла;	
		
		ОбновитьОбъектПоТаблицамФормы();
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("РабочийОбъектАдрес",			РабочийОбъектАдрес);
		СтруктураПараметров.Вставить("ТекстОповещения",				"ВыбраноПолеРасшифровки");
		СтруктураПараметров.Вставить("СписокДополнительныхПолей",	СписокДополнительныхПолей);
		СтруктураПараметров.Вставить("СписокПропускаемыхПолей",		СписокПропускаемыхПолей);
		СтруктураПараметров.Вставить("ИдентификаторВладельца",		ЭтаФорма.УникальныйИдентификатор);

		ОткрытьФорму("Отчет.ОтчетПоРегиструНакопленияБД.Форма.ФормаВыбораПолей",СтруктураПараметров,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
						
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборРасшифровки(ПараметрыРасшифровки)
	
	Если ПараметрыРасшифровки=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыРасшифровки.ПолеБД="ОткрытьОбъект" Тогда
		
		ДанныеОбъекта=ОткрытьФормуОбъектаБД(ДанныеГруппировки);
		
		Если ТипЗнч(ДанныеОбъекта)=Тип("Структура") Тогда
			
			Имя = "ОбщаяФорма.ОтображениеЭлементаWS_Управляемая";
			ОткрытьФорму(Имя, Новый Структура("Расшифровка, ИспользуемаяИБ", ДанныеОбъекта, Отчет.ИспользуемаяИБ));
			
		КонецЕсли;	
		
	Иначе	
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("ДатаНач",					Отчет.ДатаНач);
		СтруктураПараметров.Вставить("ДатаКон",					Отчет.ДатаКон);
		СтруктураПараметров.Вставить("РегистрБД",				Отчет.РегистрБД);
		СтруктураПараметров.Вставить("ИспользуемаяИБ",			Отчет.ИспользуемаяИБ);
		СтруктураПараметров.Вставить("ФормироватьПриОткрытии",	Истина);
		СтруктураПараметров.Вставить("СписокПоказателей",		СписокПоказателей);
		СтруктураПараметров.Вставить("ПоДокументамДвижения",	(ПараметрыРасшифровки.ПолеБД="Регистратор"));
		СтруктураПараметров.Вставить("ОсновнаяТаблицаРегистра", Отчет.ОсновнаяТаблицаРегистра);
		СтруктураПараметров.Вставить("ВидДвижения", 			Отчет.ВидДвижения);
		СтруктураПараметров.Вставить("ТекстОтбораИсточник", 	Отчет.ТекстОтбораИсточник);
		СтруктураПараметров.Вставить("ИсточникДанных", 			Отчет.ИсточникДанных);
		
		МассивОтбор=Новый Массив;
		МассивДетализация=Новый Массив;
		МассивПроизводные=Новый Массив;
		
		Для Каждого Элемент ИЗ ДанныеРасшифровки Цикл
			
			Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(Элемент.Значение)=Тип("Структура") Тогда
				
				Если Элемент.Значение.Свойство("ДанныеДляПоиска") Тогда
					
					СтрПолеДетализации=Отчет.ТабПоляДетализации.НайтиСтроки(Новый Структура("ПсевдонимПоля",Элемент.Ключ))[0];
					
					СтруктураОтбора=Новый Структура;
					СтруктураОтбора.Вставить("ИмяПараметра","П_"+СтрПолеДетализации.ИмяПоля);
					СтруктураОтбора.Вставить("ПолеБД",СтрПолеДетализации.ИмяПоля);
					СтруктураОтбора.Вставить("ПредставлениеПараметра",СтрПолеДетализации.ПредставлениеПоля);
					СтруктураОтбора.Вставить("СпособВычисленияПараметра",ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение"));
					СтруктураОтбора.Вставить("УточнениеСпособаОпределения",Элемент.Значение.ДанныеДляПоиска);
					СтруктураОтбора.Вставить("НастройкаСоответствия",Неопределено);
					
					МассивОтбор.Добавить(СтруктураОтбора);
					
				КонецЕсли;
				
			Иначе
				
				СтрПолеДетализации=Отчет.ТабПоляДетализации.НайтиСтроки(Новый Структура("ПсевдонимПоля",Элемент.Ключ))[0];
				
				СтруктураОтбора=Новый Структура;
				СтруктураОтбора.Вставить("ИмяПараметра","П_"+СтрПолеДетализации.ИмяПоля);
				СтруктураОтбора.Вставить("ПолеБД",СтрПолеДетализации.ИмяПоля);
  				СтруктураОтбора.Вставить("ПредставлениеПараметра",СтрПолеДетализации.ПредставлениеПоля);
				СтруктураОтбора.Вставить("СпособВычисленияПараметра",ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение"));
				СтруктураОтбора.Вставить("УточнениеСпособаОпределения",Элемент.Значение);
				СтруктураОтбора.Вставить("НастройкаСоответствия",Неопределено);
				
				МассивОтбор.Добавить(СтруктураОтбора);
				
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрПараметр ИЗ Отчет.ТабПравилаВычисленияПараметров Цикл
			
			Если НЕ (СтрПараметр.СпособВычисленияПараметра=ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеИспользуется")
				ИЛИ ДанныеРасшифровки.Свойство(СтрЗаменить(СтрПараметр.ИмяПараметра,".",""))) Тогда
				
				СтруктураОтбора=Новый Структура;
				СтруктураОтбора.Вставить("ИмяПараметра",СтрПараметр.ИмяПараметра);
				СтруктураОтбора.Вставить("ПолеБД",СтрПараметр.ПолеБД);
				СтруктураОтбора.Вставить("ПредставлениеПараметра",СтрПараметр.ПредставлениеПараметра);
				СтруктураОтбора.Вставить("СпособВычисленияПараметра",СтрПараметр.СпособВычисленияПараметра);
				СтруктураОтбора.Вставить("УточнениеСпособаОпределения",СтрПараметр.УточнениеСпособаОпределения);
				СтруктураОтбора.Вставить("НастройкаСоответствия",СтрПараметр.НастройкаСоответствия);
				
				МассивОтбор.Добавить(СтруктураОтбора);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Строка ИЗ Отчет.ТабПоляДетализации Цикл
			
			СтруктураДетализация=Новый Структура("ИмяПоля,ПсевдонимПоля,ПредставлениеПоля,ТипМетаДанных,ИмяОбъектаМетаданных");
			ЗаполнитьЗначенияСвойств(СтруктураДетализация,Строка);				
			МассивДетализация.Добавить(СтруктураДетализация);
			
		КонецЦикла;
		
		//Если ЗначениеЗаполнено(ПараметрыРасшифровки.ТипМетаДанных) Тогда
			
			СтруктураДетализация=Новый Структура;
			СтруктураДетализация.Вставить("ИмяПоля",ПараметрыРасшифровки.ПолеБД);
			СтруктураДетализация.Вставить("ПсевдонимПоля",СтрЗаменить(ПараметрыРасшифровки.ПолеБД,".",""));
			СтруктураДетализация.Вставить("ТипМетаДанных",ПараметрыРасшифровки.ТипМетаДанных);
			СтруктураДетализация.Вставить("ПредставлениеПоля",ПараметрыРасшифровки.ПредставлениеПоля);
			
			МассивДетализация.Добавить(СтруктураДетализация);
			
		//КонецЕсли;
		
		Для Каждого Строка ИЗ мТаблицаПроизводныхБД Цикл
			
			СтруктураПроизводных=Новый Структура("ПолеБД,НаименованиеБД,ТипЗначения,ТипМетаДанных,ТипДанныхПоля,ТолькоОбороты,ПризнакиУчетаСубконто,Измерение,Дебетовый,СправочникБД,Балансовый,ПризнакУчета");
			ЗаполнитьЗначенияСвойств(СтруктураПроизводных,Строка);
			
			МассивПроизводные.Добавить(СтруктураПроизводных);
			
		КонецЦикла;
		
		СтруктураПараметров.Вставить("МассивДетализация",МассивДетализация);
		СтруктураПараметров.Вставить("МассивОтбор",МассивОтбор);
		СтруктураПараметров.Вставить("МассивПроизводные",МассивПроизводные);
		
		ОткрытьФорму("Отчет.ОтчетПоРегиструНакопленияБД.Форма.ФормаОтчета",СтруктураПараметров,,Новый УникальныйИдентификатор);
		
	КонецЕсли;
	
	ДанныеГруппировки=Неопределено;
	Расшифровка		=Неопределено;
		
КонецПроцедуры // ОбработатьВыборРасшифровки() 

