&НаСервереБезКонтекста
Процедура ПроверитьНаличиеОписанийРегистров(ТипБД,ИмяСправочника)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОписаниеРегистров.Ссылка
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК ОписаниеРегистров
	|ГДЕ
	|	ОписаниеРегистров.Владелец = &ТипБД";
	
	Запрос.УстановитьПараметр("ТипБД",ТипБД);
	
	Результат=Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		РаботаСОбъектамиМетаданныхУХ.ЗаполнитьСписокРегистровБД(ТипБД,,Истина,Истина,Истина);
		
	КонецЕсли;
				 	
КонецПроцедуры // ПроверитьНаличиеОписанийРегистров()
 
&НаСервере
Процедура ОбновитьТипВИБ()
	
	Отчет.ТипБД=Отчет.ИспользуемаяИБ.ТипБД;
			
КонецПроцедуры // ОбновитьТипВИБ()

&НаСервереБезКонтекста
Функция ПолучитьДанныеДляВыбора(НастройкаСоответствия)
	
	СтруктураДляВыбора=Новый Структура;
	СтруктураДлявыбора.Вставить("ТипОбъектаКонсолидации",НастройкаСоответствия.ТипОбъектаКонсолидации);
	СтруктураДлявыбора.Вставить("ИмяОбъектаМетаданных",НастройкаСоответствия.ИмяОбъектаМетаданных);
	
	Если НастройкаСоответствия.ТипОбъектаКонсолидации="ВидСубконто" Тогда 
		
		СтруктураДляВыбора.Вставить("ТипЗначения",НастройкаСоответствия.ИмяОбъектаМетаданных.ТипЗначения);
		СтруктураДляВыбора.Вставить("Тип",НастройкаСоответствия.ИмяОбъектаМетаданных.ТипЗначения.Типы()[0]);
		СтруктураДляВыбора.Вставить("ТаблицаАналитики", Метаданные.НайтиПоТипу(СтруктураДляВыбора.Тип).ПолноеИмя());
		
	КонецЕсли;
	
	Возврат СтруктураДляВыбора;
	
КонецФункции // ПолучитьДанныеДляВыбора()

&НаСервереБезКонтекста
Функция ПолучитьНастройкуСоответствияРеквизитов(ТипБД,СправочникКонсолидации,СправочникБД,ТипМетаДанных,ПервыйЭлемент=Истина);
	
	ТаблицаНастроек=УправлениеОтчетамиУХ.ПолучитьНастройкуСоответствияРеквизитов(ТипБД,СправочникКонсолидации,СправочникБД,ТипМетаДанных,ПервыйЭлемент);
	
	СписокНастроек=Новый СписокЗначений;
	СписокНастроек.ТипЗначения=ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.СоответствиеВнешнимИБ");
	СписокНастроек.ЗагрузитьЗначения(ТаблицаНастроек.ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокНастроек;
	
КонецФункции // ПолучитьНастройкуСоответствияРеквизитов()

&НаСервере
Функция ОткрытьФормуОбъектаБД(Расшифровка)
	
	Если Отчет.ВнешняяИБ=0 Тогда
		
		Если ТипЗнч(Расшифровка)=Тип("Структура") Тогда
			
			СтруктураОбъекта=Новый Структура;
			СтруктураОбъекта.Вставить("ИмяОбъектаМетаданных",Расшифровка.ДанныеДляПоиска.Метаданные().ПолноеИмя());
			СтруктураОбъекта.Вставить("СтруктураПараметров",Новый Структура("Ключ",Расшифровка.ДанныеДляПоиска));
			
		Иначе
			
			МетаданныеОбъекта=Расшифровка.Метаданные().ПолноеИмя();
			СтруктураОбъекта=Новый Структура;
			СтруктураОбъекта.Вставить("ИмяОбъектаМетаданных",МетаданныеОбъекта);
			СтруктураОбъекта.Вставить("СтруктураПараметров",Новый Структура("Ключ",Расшифровка));
			
		КонецЕсли;
		
		
		Возврат СтруктураОбъекта;
		
	Иначе
		
		Возврат Новый Структура("ТипЗначения, Значение", Расшифровка.ТипОбъектаМетаданных+"Ссылка."+Расшифровка.ИмяОбъектаМетаданных, Расшифровка.Ссылка);
		
	КонецЕсли;
	
КонецФункции // ОткрытьДокументОперации()

&НаСервере
Процедура ВывестиОтчет()
	
	Если Отчет.ДатаНач > Отчет.ДатаКон И Отчет.ДатаКон <> '00010101000000' Тогда

		Отчет.ДатаНач=Отчет.ДатаКон;
		
	КонецЕсли;
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ДеревоПоказателей=РеквизитФормыВЗначение("Отчет.Показатели");
	ОтчетОбъект.мТаблицаПоказателейБД		= РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ОтчетОбъект.мТаблицаПроизводныхБД		= РеквизитФормыВЗначение("мТаблицаПроизводныхБД");
	ОтчетОбъект.ТабличноеПолеИзмеренийБД 	= РеквизитФормыВЗначение("ТабличноеПолеИзмеренийБД");
	
	ТабРезультат.Очистить();
	
	ДанныеДляВывода=ОтчетОбъект.СформироватьОтчет();
		
	ТабРезультат.Вывести(ДанныеДляВывода.ТаблицаДляОтображения);
	
	СписокПоказателей.Очистить();
	
	МассивПоказателей=ОтчетОбъект.ДеревоПоказателей.Строки.НайтиСтроки(Новый Структура("Выводить",Истина),Истина);
	
	Для Каждого СтрПоказатель ИЗ МассивПоказателей Цикл
		СписокПоказателей.Добавить(СтрПоказатель.Имя);
	КонецЦикла;
	
	Элементы.ОсновнаяПанель.ТекущаяСтраница=Элементы.ОсновнаяПанель.ПодчиненныеЭлементы.Отчет;
	
	Заголовок=СтрШаблон(Нстр("ru = 'Отчет по регистру накопления %1, %2'; en = 'Accumulation register report %1, %2';tr = '%1Birikim kayıt raporu,%2'"), Отчет.РегистрБД.Наименование, Отчет.ИспользуемаяИБ);
	
КонецПроцедуры // ВывестиОтчет()

&НаСервере
Процедура ИзменитьРегистрНакопленияВИБ()
	
	Отчет.ТабПоляДетализации.Очистить();
	Отчет.ТабПравилаВычисленияПараметров.Очистить();
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ПриИзмененииРегистраНакопления(ОтчетОбъект);
		
КонецПроцедуры // ИзменитьРеквизитБухгалтерии()

&НаСервере
Процедура ПриИзмененииРегистраНакопления(ОтчетОбъект)
	
	Если ОтчетОбъект.РегистрБД.Измерения.Количество()=0 Тогда
		
		РегистрОбъект=ОтчетОбъект.РегистрБД.ПолучитьОбъект();
		РегистрОбъект.ЗаполнитьРеквизитыОбъекта();
		РегистрОбъект.Записать();
		
	КонецЕсли;
	
	ОтчетОбъект.ЗаполнитьИзмеренияРегистраБД();
	ОтчетОбъект.ЗаполнитьДеревоПоРегиструНакопленияБД();
	
	ЗначениеВРеквизитФормы(ОтчетОбъект.мТаблицаПоказателейБД,"мТаблицаПоказателейБД");
	
	мТаблицаПроизводныхБД.Очистить();	
	ЗначениеВРеквизитФормы(ОтчетОбъект.ТабличноеПолеИзмеренийБД,"ТабличноеПолеИзмеренийБД");
	
	ОбновитьВыводимыеПоказатели();
				
КонецПроцедуры

&НаСервере
Процедура ОбновитьВыводимыеПоказатели()
	
	ПолеСиноним=РаботаСОбъектамиМетаданныхУХ.ПолучитьПолеСиноним();
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	РегистрыНакопленияБДРесурсы.Имя КАК Имя,
	             |	РегистрыНакопленияБДРесурсы.Синоним КАК Синоним
	             |ИЗ
	             |	Справочник.РегистрыНакопленияБД.Ресурсы КАК РегистрыНакопленияБДРесурсы
	             |ГДЕ
	             |	РегистрыНакопленияБДРесурсы.Ссылка = &РегистрБД";
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,".Синоним","."+ПолеСиноним);
	Запрос.УстановитьПараметр("РегистрБД",Отчет.РегистрБД);
	
	Отчет.Показатели.ПолучитьЭлементы().Очистить();
	ВидРегистра=Отчет.РегистрБД.ВидРегистра;
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=Отчет.Показатели.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Имя=Результат.Имя;
		НоваяСтрока.Представление=Результат.Синоним;
		
		Если НЕ СписокПоказателей.НайтиПоЗначению(НоваяСтрока.Имя)=Неопределено Тогда
			НоваяСтрока.Выводить=Истина;
		КонецЕсли;
		
		Если Отчет.ОсновнаяТаблицаРегистра Тогда
			
			Продолжить;
		
		ИначеЕсли ВидРегистра="Остатки" Тогда
			
			СтрокаОстаток=НоваяСтрока.ПолучитьЭлементы().Добавить();
			СтрокаОстаток.Имя=Результат.Имя+"НачальныйОстаток";
			СтрокаОстаток.Представление=Нстр("ru = 'Остаток на начало'; en = 'Opening balance';tr = 'Dönem başı bakiyesi'");
			Если НЕ СписокПоказателей.НайтиПоЗначению(СтрокаОстаток.Имя)=Неопределено Тогда
				СтрокаОстаток.Выводить=Истина;
			КонецЕсли;
			
			СтрокаОстаток=НоваяСтрока.ПолучитьЭлементы().Добавить();
			СтрокаОстаток.Имя=Результат.Имя+"Приход";
			СтрокаОстаток.Представление="Приход";
			
			Если (НЕ СписокПоказателей.НайтиПоЗначению(СтрокаОстаток.Имя)=Неопределено)
				ИЛИ (НоваяСтрока.Выводить И Отчет.ВидДвижения="Приход") Тогда
				
				СтрокаОстаток.Выводить=Истина;
				
			КонецЕсли;
			
			СтрокаОстаток=НоваяСтрока.ПолучитьЭлементы().Добавить();
			СтрокаОстаток.Имя=Результат.Имя+"Расход";
			СтрокаОстаток.Представление="Расход";
			
			Если (НЕ СписокПоказателей.НайтиПоЗначению(СтрокаОстаток.Имя)=Неопределено)
				ИЛИ (НоваяСтрока.Выводить И Отчет.ВидДвижения="Расход") Тогда
				
				СтрокаОстаток.Выводить=Истина;
				
			КонецЕсли;
			
			СтрокаОстаток=НоваяСтрока.ПолучитьЭлементы().Добавить();
			СтрокаОстаток.Имя=Результат.Имя+"КонечныйОстаток";
			СтрокаОстаток.Представление=Нстр("ru = 'Остаток на конец'; en = 'Closing balance';tr = 'Dönem sonu bakiyesi'");
			Если НЕ СписокПоказателей.НайтиПоЗначению(СтрокаОстаток.Имя)=Неопределено Тогда
				СтрокаОстаток.Выводить=Истина;
			КонецЕсли;
			
			СтрокаОстаток=НоваяСтрока.ПолучитьЭлементы().Добавить();
			СтрокаОстаток.Имя=Результат.Имя+"Оборот";
			СтрокаОстаток.Представление="Оборот";
			Если НЕ СписокПоказателей.НайтиПоЗначению(СтрокаОстаток.Имя)=Неопределено Тогда
				СтрокаОстаток.Выводить=Истина;
			КонецЕсли;
			
		Иначе
			
			СтрокаОстаток=НоваяСтрока.ПолучитьЭлементы().Добавить();
			СтрокаОстаток.Имя=Результат.Имя+"Оборот";
			СтрокаОстаток.Представление=СтрШаблон(Нстр("ru = '%1: оборот'; en = '%1: turnover';tr = '%1: ciro'"), Результат.Синоним);
			Если НЕ СписокПоказателей.НайтиПоЗначению(СтрокаОстаток.Имя)=Неопределено Тогда
				СтрокаОстаток.Выводить=Истина;
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВидРегистра="Остатки" И Отчет.ОсновнаяТаблицаРегистра Тогда
		
		Элементы.ВидДвижения.Видимость=Истина;
		
	Иначе
		
		Отчет.ВидДвижения="";
		Элементы.ВидДвижения.Видимость=Ложь;
		
	КонецЕсли;
	
КонецПроцедуры // ОбновитьВыводимыеПоказатели()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(Отчет,Параметры);
	
	Отчет.ТипБД=Параметры.РегистрБД.Владелец;
	Отчет.ИспользуемаяИБ=?(Отчет.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ,"",Параметры.ИспользуемаяИБ);
	СписокПоказателей=Параметры.СписокПоказателей;
	
	Если НЕ ЗначениеЗаполнено(Отчет.ТипБД) Тогда
		
		Отчет.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ;
		
	КонецЕсли;
	
	Отчет.ВнешняяИБ=?(Отчет.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ,0,1);
		
	Если ЗначениеЗаполнено(Отчет.РегистрБД) Тогда
		
		ИзменитьРегистрНакопленияВИБ();
			
	КонецЕсли;
	
	Если ТипЗнч(Параметры.МассивДетализация)=Тип("Массив") Тогда // Производится расшифровка значения отчета
		
		Для Каждого СтрДетализация ИЗ Параметры.МассивДетализация Цикл
			
			НоваяСтрока=Отчет.ТабПоляДетализации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрДетализация);
			
		КонецЦикла;
		
		Для Каждого СтрОтбор ИЗ Параметры.МассивОтбор Цикл
			
			НоваяСтрока=Отчет.ТабПравилаВычисленияПараметров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрОтбор);
			
		КонецЦикла;
		
		Для Каждого Строка ИЗ Параметры.МассивПроизводные Цикл
			
			НоваяСтрока=мТаблицаПроизводныхБД.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
		КонецЦикла;
		
		Если ТипЗнч(Параметры.МассивДополнительныйОтбор)=Тип("Массив") Тогда
			
			Для Каждого СтрОтбор ИЗ Параметры.МассивДополнительныйОтбор Цикл
				
				Если НЕ СтрОтбор.Свойство("ПолеБД") Тогда
					
					СтрОтбор.Вставить("ПолеБД",СтрОтбор.ИмяПараметра);
					
				КонецЕсли;
				
				МассивПараметр=Отчет.ТабПравилаВычисленияПараметров.НайтиСтроки(Новый Структура("ИмяПараметра",СтрОтбор.ИмяПараметра));
				
				Если МассивПараметр.Количество()=0 Тогда
					
					СтрокаДопОтбор=Отчет.ТабПравилаВычисленияПараметров.Добавить();
					
				Иначе
					
					СтрокаДопОтбор=МассивПараметр[0];
					
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(СтрокаДопОтбор,СтрОтбор);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПоместитьРабочийОбъект(РеквизитФормыВЗначение("Отчет"));
	УстановитьВидимость();
	
	Если Параметры.ФормироватьПриОткрытии Тогда
		
         ВывестиОтчет();
		 
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьРабочийОбъект()
	
	РабочийОбъект=РеквизитФормыВЗначение("Отчет");
	РабочийОбъект.АдресХранилищаПеременныхДляРасчета=РабочийОбъектАдрес;
	РабочийОбъект.ВосстановитьПеременныеДляРасчета();
	
	Возврат РабочийОбъект;
		
КонецФункции // ПолучитьРабочийОбъект()

&НаСервере
Процедура ПоместитьРабочийОбъект(РабочийОбъект)
	
	РабочийОбъектАдрес=ПоместитьВоВременноеХранилище(РабочийОбъект.ПодготовитьСтруктуруПеременныхДляРасчета(),ЭтаФорма.УникальныйИдентификатор);
	ЗначениеВРеквизитФормы(РабочийОбъект,"Отчет");
				
КонецПроцедуры // ПолучитьРабочийОбъект()

&НаСервере
Процедура ОбновитьТаблицыФормыПоОбъекту()

    РабочийОбъект=ПолучитьРабочийОбъект();

	ЗначениеВРеквизитФормы(РабочийОбъект.мТаблицаПоказателейБД,	"мТаблицаПоказателейБД");
	ЗначениеВРеквизитФормы(РабочийОбъект.мТаблицаПроизводныхБД,	"мТаблицаПроизводныхБД");	
	ЗначениеВРеквизитФормы(РабочийОбъект.ТабличноеПолеИзмеренийБД,	"ТабличноеПолеИзмеренийБД");

КонецПроцедуры // ОбновитьОтчетОбъект() 

&НаСервере
Процедура ОбновитьОбъектПоТаблицамФормы()
	
	РабочийОбъект=ПолучитьРабочийОбъект();
	
	РабочийОбъект.мТаблицаПоказателейБД	= РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	РабочийОбъект.мТаблицаПроизводныхБД	= РеквизитФормыВЗначение("мТаблицаПроизводныхБД");
	РабочийОбъект.ТабличноеПолеИзмеренийБД	= РеквизитФормыВЗначение("ТабличноеПолеИзмеренийБД");

	ПоместитьРабочийОбъект(РабочийОбъект);
	
КонецПроцедуры // ОбновитьОтчетОбъект()

&НаСервереБезКонтекста
Функция ПолучитьСписокСпособовВычисления(ТипМетаДанных)

	СписокВыбора=Новый СписокЗначений;
	
	Если ТипМетаДанных="Простой" Тогда
		
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, Нстр("ru = 'Фиксированное значение'; en = 'Fixed value';tr = 'Sabit değer'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению, Нстр("ru = 'Не равно фиксированному значению'; en = 'Not equal to a fixed value';tr = 'Sabit bir değere eşit değil'"));																								   
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Нстр("ru = 'Список фиксированных значений'; en = 'Fixed value list';tr = 'Sabit değer listesi'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений, Нстр("ru = 'Не в списке фиксированных значений'; en = 'Not in the fixed value list';tr = 'Sabit değer listesinde değil'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется, Нстр("ru = 'Отбор не производится'; en = 'Not filtered';tr = 'Filtrelenmemiş'"));
		
	Иначе
		
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, Нстр("ru = 'Фиксированное значение'; en = 'Fixed value';tr = 'Sabit değer'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению, Нстр("ru = 'Не равно фиксированному значению'; en = 'Not equal to a fixed value';tr = 'Sabit bir değere eşit değil'"));																								   
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Нстр("ru = 'Список фиксированных значений'; en = 'Fixed value list';tr = 'Sabit değer listesi'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокПоИерархии, Нстр("ru = 'Список с учетом иерархии'; en = 'List considering hierarchy';tr = 'Hiyerarşiyi dikkate alan liste'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений, Нстр("ru = 'Не в списке фиксированных значений'; en = 'Not in the fixed value list';tr = 'Sabit değer listesinde değil'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии, Нстр("ru = 'Не в списке с учетом иерархии'; en = 'Not in the list considering hierarchy';tr = 'Hiyerarşi dikkate alınan listede yok'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется, Нстр("ru = 'Отбор не производится'; en = 'Not filtered';tr = 'Filtrelenmemiş'"));
		
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции // ПолучитьСписокСпособовВычисления() 

