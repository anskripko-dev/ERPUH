&НаКлиенте
Процедура ТабПравилаВычисленияПараметровПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ=Истина;
	
	ОбновитьОбъектПоТаблицамФормы();	
	ОткрытьФорму("Отчет.ОтчетПоРегиструНакопленияБД.Форма.ФормаВыбораПолей",Новый Структура("РабочийОбъектАдрес,ТекстОповещения,ИдентификаторВладельца",РабочийОбъектАдрес,"ВыбраноПолеОтбора",ЭтаФорма.УникальныйИдентификатор),,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (СтрНайти(ИмяСобытия,"ВыбраноПолеОтбора")>0
		ИЛИ СтрНайти(ИмяСобытия,"ВыбраноПолеДетализации")
		ИЛИ СтрНайти(ИмяСобытия,"ВыбраноПолеРасшифровки"))
		И Параметр.ИдентификаторВладельца=ЭтаФорма.УникальныйИдентификатор Тогда
		
		РабочийОбъектАдрес=Параметр.РабочийОбъектАдрес;
		
		ОбновитьТаблицыФормыПоОбъекту();
		
		ДанныеСтроки=Параметр.ДанныеСтроки;
		
		Если ИмяСобытия="ВыбраноПолеОтбора" Тогда
			
			НоваяСтрока=Отчет.ТабПравилаВычисленияПараметров.Добавить();
			НоваяСтрока.ИмяПараметра=СтрЗаменить(ДанныеСтроки.ПолеБД,".","");
			НоваяСтрока.ПредставлениеПараметра=НоваяСтрока.ИмяПараметра;
			НоваяСтрока.СпособВычисленияПараметра=ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеИспользуется");
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ДанныеСтроки);
						
		ИначеЕсли ИмяСобытия="ВыбраноПолеДетализации" Тогда
			
			НоваяСтрока=Отчет.ТабПоляДетализации.Добавить();
			НоваяСтрока.ИмяПоля=ДанныеСтроки.ПолеБД;
			НоваяСтрока.ПсевдонимПоля=СтрЗаменить(ДанныеСтроки.ПолеБД,".","");
			НоваяСтрока.ТипМетаДанных=ДанныеСтроки.ТипМетаДанных;
			НоваяСтрока.ПредставлениеПоля=ДанныеСтроки.ПредставлениеПоля;
			
		ИначеЕсли ИмяСобытия="ВыбраноПолеРасшифровки" Тогда
						 
			 ОбработатьВыборРасшифровки(ДанныеСтроки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПравилаВычисленияПараметровСпособВычисленияПараметраНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	СтрокаПараметр=НайтиСтрокуДанныхВИБПоПолю(Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ИмяПараметра);
	СписокВыбора=Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы.СпособВычисленияПараметра.СписокВыбора;
	СписокВыбора.Очистить();
	
	ТекСписокВыбора=ПолучитьСписокСпособовВычисления(СтрокаПараметр.ТипМетаДанных);
	
	Для Каждого Строка ИЗ ТекСписокВыбора Цикл
		
		СписокВыбора.Добавить(Строка.Значение,Строка.Представление);
		
	КонецЦикла;
			
КонецПроцедуры
 
