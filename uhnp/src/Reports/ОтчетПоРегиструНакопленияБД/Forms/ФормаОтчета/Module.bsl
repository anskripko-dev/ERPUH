Процедура ТабПоляДетализацииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ=Истина;
	
	ОбновитьОбъектПоТаблицамФормы();	
	ОткрытьФорму("Отчет.ОтчетПоРегиструНакопленияБД.Форма.ФормаВыбораПолей",Новый Структура("РабочийОбъектАдрес,ТекстОповещения,ИдентификаторВладельца",РабочийОбъектАдрес,"ВыбраноПолеДетализации",ЭтаФорма.УникальныйИдентификатор),,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешняяИБПриИзменении(Элемент)
	
	ПриИзмененииВидаБазы();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаБазы()
	
	Если Отчет.ВнешняяИБ=0 Тогда
		
		Отчет.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ;
		Отчет.ИспользуемаяИБ=Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ;
		
	Иначе
		
		Отчет.ТипБД=Справочники.ТипыБазДанных.ПустаяСсылка();
		Отчет.ИспользуемаяИБ=Справочники.ВнешниеИнформационныеБазы.ПустаяСсылка();
		
	КонецЕсли;
	
	Отчет.РегистрБД=Справочники.РегистрыНакопленияБД.ПустаяСсылка();
	УстановитьВидимость();
				
КонецПроцедуры // ПриИзмененииВидаБазы() 

&НаСервере
Процедура УстановитьВидимость()

	Элементы.ИспользуемаяИБ.Видимость=(Отчет.ВнешняяИБ=1);
	
	Если ЗначениеЗаполнено(Отчет.ИсточникДанных) Тогда
		
		Элементы.ГруппаДетализацияОтбор.ОтображениеСтраниц=ОтображениеСтраницФормы.Нет;
		Элементы.ГруппаВИБ.ТолькоПросмотр=Истина;
		Элементы.ГруппаРегистр.ТолькоПросмотр=Истина;
		Элементы.ГруппаИсточник.Видимость=Истина; 
				
	Иначе
		
		Элементы.ГруппаДетализацияОтбор.ОтображениеСтраниц=ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.ГруппаВИБ.ТолькоПросмотр=Ложь;
		Элементы.ГруппаРегистр.ТолькоПросмотр=Ложь;
		Элементы.ГруппаИсточник.Видимость=Ложь;
				
	КонецЕсли;
	
КонецПроцедуры // УстановитьВидимость() 

&НаКлиенте
Процедура ТабПоляДетализацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ПолеБД=Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ИмяПараметра;
	
КонецПроцедуры

&НаКлиенте
Процедура СпособВычисленияПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтрокаПараметр=НайтиСтрокуДанныхВИБПоПолю(Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ПолеБД);
	СписокВыбора=Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы.СпособВычисленияПараметра.СписокВыбора;
	СписокВыбора.Очистить();
	
	ТекСписокВыбора=ПолучитьСписокСпособовВычисления(СтрокаПараметр.ТипМетаДанных);
	
	Для Каждого Строка ИЗ ТекСписокВыбора Цикл
		
		СписокВыбора.Добавить(Строка.Значение,Строка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьДанныеОбъекта()
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("РабочийОбъектАдрес",		РабочийОбъектАдрес);
	ДанныеОбъекта.Вставить("УникальныйИдентификатор",	ЭтаФорма.УникальныйИдентификатор);
	ДанныеОбъекта.Вставить("ТипБД",						Отчет.ТипБД);
	ДанныеОбъекта.Вставить("ТекСоединениеВИБ",			);
	ДанныеОбъекта.Вставить("Отказ",						ЛОЖЬ);
	ДанныеОбъекта.Вставить("Использование77",			ЛОЖЬ);
	ДанныеОбъекта.Вставить("ВнутренниеДанные",			(Отчет.ВнешняяИБ=0));
	ДанныеОбъекта.Вставить("СпособПолучения",			);
	ДанныеОбъекта.Вставить("СпособИспользования",		);
	
	Возврат ДанныеОбъекта;
	
КонецФункции // СформироватьСтруктуруСтрокиВИБ()


&НаКлиенте
Процедура СпособВычисленияПараметраПриИзменении(Элемент)
	
	ТекущиеДанные=Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные;
	
	Если ТекущиеДанные.ТипЗначения.Количество()>0 Тогда
		
		ДанныеОбъекта=СформироватьДанныеОбъекта();
		ДанныеОбъекта.Вставить("ИмяПараметра",				ТекущиеДанные.ПолеБД);
		ДанныеОбъекта.Вставить("ТипДанныхПоля",				ТекущиеДанные.ТипДанныхПоля);
		ДанныеОбъекта.Вставить("ТипЗначения",				ТекущиеДанные.ТипЗначения);
		ДанныеОбъекта.Вставить("СпособВычисленияПараметра",	Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.СпособВычисленияПараметра);
		
		ДанныеДляОграничения=ПолучитьДанныеДляОграниченияТипа(ДанныеОбъекта);
		
		Для Каждого СтрОграничение ИЗ ДанныеДляОграничения Цикл
			
			УстановитьОграничениеТипа(СтрОграничение);
			
		КонецЦикла;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеДляОграниченияТипа(ДанныеОбъекта)
	
	Возврат РаботаСПолямиАналитикиУХ.ПолучитьДанныеДляОграниченияТипа(ДанныеОбъекта);
			
КонецФункции // ПолучитьДанныеДляОграниченияТипа()

&НаКлиенте
Процедура УстановитьОграничениеТипа(ДанныеДляОграничения)
	
	Если Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы.Найти(ДанныеДляОграничения.ИмяКолонки)=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЭлементУправления = Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы[ДанныеДляОграничения.ИмяКолонки];
	
	Если ДанныеДляОграничения.Свойство("ТипЗначения") Тогда
		
		Если НЕ ТипЗнч(ДанныеДляОграничения.ТипЗначения)=Тип("Массив") Тогда
			
			Массив = Новый Массив;
			Массив.Добавить(ДанныеДляОграничения.ТипЗначения);
			
		Иначе
			
			Массив=ДанныеДляОграничения.ТипЗначения;
			
		КонецЕсли;
		
		ЭлементУправления.Доступность = Истина;
		ЭлементУправления.ОграничениеТипа = Новый ОписаниеТипов(Массив);
		
		Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные[ДанныеДляОграничения.ИмяКолонки] = ЭлементУправления.ОграничениеТипа.ПривестиЗначение();
		
		Если ДанныеДляОграничения.Свойство("ТипДанныхСписка") Тогда
			
			Массив = Новый Массив;
			Массив.Добавить(ДанныеДляОграничения.ТипДанныхСписка);
			
			Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные[ДанныеДляОграничения.ИмяКолонки].ТипЗначения=Новый ОписаниеТипов(Массив);

						
		КонецЕсли;
		
	Иначе
		
		Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные[ДанныеДляОграничения.ИмяКолонки]=Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьОграничениеТипа()

&НаКлиенте
Процедура ОсновнаяТаблицаРегистраПриИзменении(Элемент)
	
	ИзменитьРегистрНакопленияВИБ();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОчиститьИсточник(Команда)
	
	Отчет.ИсточникДанных="";
	Отчет.ТекстОтбораИсточник="";
	УстановитьВидимость();
		
КонецПроцедуры
