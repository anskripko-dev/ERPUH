&НаКлиенте
Функция ПолучитьНаименованиеСсылочногоТипа(Тип)
	
	Если СтрНайти(Тип,"Справочник")>0 Тогда
		Возврат "Справочник";
	ИначеЕсли СтрНайти(Тип,"Перечисление")>0 Тогда
		Возврат "Перечисление";
	ИначеЕсли СтрНайти(Тип,"Документ")>0 Тогда
		Возврат "Документ";
	ИначеЕсли СтрНайти(Тип,"ПланСчетов")>0 Тогда
		Возврат "ПланСчетов";
	Иначе
		Возврат "НеПоддерживается";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПримитивныйТип(Тип)
	
	Возврат (Тип = Тип("Строка") ИЛИ Тип = Тип("Дата") ИЛИ Тип = Тип("Булево") ИЛИ Тип = Тип("Число"));	
	
КонецФункции

&НаКлиенте
Функция НайтиСтрокуДанныхВИБПоПолю(ПолеБД)
	
	Если СтрНайти(ПолеБД,".")>0 Тогда
		
		МассивПоказателейВИБ=мТаблицаПроизводныхБД.НайтиСтроки(Новый Структура("ПолеБД",ПолеБД));
		
	Иначе
	    
		МассивПоказателейВИБ=мТаблицаПоказателейБД.НайтиСтроки(Новый Структура("ПолеБД",ПолеБД));
		
	КонецЕсли;
	
	Если МассивПоказателейВИБ.Количество()=0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат МассивПоказателейВИБ[0];
	КонецЕсли;
	
КонецФункции // НайтиСтрокуДанныхВИБПоПолю()
 
