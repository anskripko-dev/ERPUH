// Процедура добавляет в таблицу значений мТаблицаПоказателейБД данные по измерениям
// выбранного регистра бухгалтерии.
//
Процедура ЗаполнитьИзмеренияРегистраБД() Экспорт
	
	мТаблицаПоказателейБД.Очистить();
	мТаблицаПроизводныхБД.Очистить();
	
	Если ОсновнаяТаблицаРегистра Тогда
		
		СтрокаПоказателей                 	= мТаблицаПоказателейБД.Добавить();
		СтрокаПоказателей.ПолеБД         	= "Регистратор";
		СтрокаПоказателей.НаименованиеБД 	= Нстр("ru = 'Регистратор'; en = 'Recorder';tr = 'Kayıt cihazı'");
		СтрокаПоказателей.ПредставлениеПоля = "["+СтрокаПоказателей.НаименованиеБД+"]";
		
		РаботаСПолямиАналитикиУХ.ЗаполнитьПоляТиповРеквизитовБД(СтрокаПоказателей, РегистрБД.Регистраторы,ТипБД);
		
	КонецЕсли;	
	
	Для Каждого СтрИзмерение ИЗ РегистрБД.Измерения Цикл
		
		СтрокаПоказателей                 	= мТаблицаПоказателейБД.Добавить();
		СтрокаПоказателей.ПолеБД         	= СтрИзмерение.Имя;
		СтрокаПоказателей.НаименованиеБД 	= СтрИзмерение[ПолеСиноним];
		СтрокаПоказателей.ПредставлениеПоля = "["+СтрокаПоказателей.НаименованиеБД+"]";
		СтрокаПоказателей.Измерение       	= Истина;
		
		РаботаСПолямиАналитикиУХ.ЗаполнитьПоляТиповРеквизитовБД(СтрокаПоказателей, СтрИзмерение.ТипДанных,ТипБД);
		
	КонецЦикла;
	
	Если ОсновнаяТаблицаРегистра Тогда
		
		Для Каждого СтрРеквизит ИЗ РегистрБД.Реквизиты Цикл
			
			СтрокаПоказателей                 	= мТаблицаПоказателейБД.Добавить();
			СтрокаПоказателей.ПолеБД         	= СтрРеквизит.Имя;
			СтрокаПоказателей.НаименованиеБД 	= СтрРеквизит[ПолеСиноним];
			СтрокаПоказателей.ПредставлениеПоля = "["+СтрокаПоказателей.НаименованиеБД+"]";
			
			РаботаСПолямиАналитикиУХ.ЗаполнитьПоляТиповРеквизитовБД(СтрокаПоказателей, СтрРеквизит.ТипДанных,ТипБД);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДеревоПоРегиструНакопленияБД() Экспорт
	
	ТабличноеПолеИзмеренийБД = Новый ДеревоЗначений;
	ТабличноеПолеИзмеренийБД.Колонки.Добавить("НаименованиеБД"		, мОписаниеТиповСтрока);
	ТабличноеПолеИзмеренийБД.Колонки.Добавить("ПредставлениеПоля"	, мОписаниеТиповСтрока);
	ТабличноеПолеИзмеренийБД.Колонки.Добавить("ПолеБД"				, мОписаниеТиповСтрока);
	ТабличноеПолеИзмеренийБД.Колонки.Добавить("СправочникБД"   		, мОписаниеТиповСтрока);
	ТабличноеПолеИзмеренийБД.Колонки.Добавить("ТипМетаДанных" 		, мОписаниеТиповСтрока);
	ТабличноеПолеИзмеренийБД.Колонки.Добавить("ТипЗначения"			, мОписаниеТиповСписокЗначений);
	ТабличноеПолеИзмеренийБД.Колонки.Добавить("ТипДанныхПоля"		, мОписаниеТиповСписокЗначений);
		
	Для Каждого Элемент Из мТаблицаПоказателейБД Цикл
				
		ТекущаяСтрока = ТабличноеПолеИзмеренийБД.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока,Элемент);
		
		Если (ТекущаяСтрока.ТипМетаДанных="Справочник" 
			ИЛИ ТекущаяСтрока.ТипМетаДанных="Документ" 
			ИЛИ ТекущаяСтрока.ТипМетаДанных="ПланВидовХарактеристик" 
			ИЛИ ТекущаяСтрока.ТипЗначения.Количество()>1) Тогда 
			
			НоваяСтрока=ТекущаяСтрока.Строки.Добавить();
			
		КонецЕсли;
			
	КонецЦикла;
		
КонецПроцедуры // ЗаполнитьДеревоПоРегиструНакопления()

Функция НайтиСтрокуДанныхВИБПоПолю(ПолеБД) Экспорт;
	
	Если СтрНайти(ПолеБД,".")>0 Тогда
		Возврат мТаблицаПроизводныхБД.Найти(ПолеБД,"ПолеБД");
	Иначе
	    Возврат мТаблицаПоказателейБД.Найти(ПолеБД,"ПолеБД");
	КонецЕсли;
	
КонецФункции // НайтиСтрокуДанныхВИБПоПолю()

