Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	РеквизитыЗаявки = ЗаявкиНаОперации.РеквизитыДокументаЗаявка(Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств"));
	
	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстВалютаДокумента", "РазмещениеЗаявок.ЗаявкаНаОперацию."+РеквизитыЗаявки.ВалютаДокумента.ИмяРеквизита);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстОтветственный", "РазмещениеЗаявок.ЗаявкаНаОперацию."+РеквизитыЗаявки.Ответственный.ИмяРеквизита);
	
	СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос = ТекстЗапроса;
	
КонецПроцедуры

