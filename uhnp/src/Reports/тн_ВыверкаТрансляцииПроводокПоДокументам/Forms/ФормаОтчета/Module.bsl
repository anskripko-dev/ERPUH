// Отчет разработан на основании типового отчета "ВыверкаТрансляцииПроводок".
// Варианты отчета:
//  - По счетам - выбирает данные аналогично функционалу типовго отчета с типом "По корреспонденциям",
//                т.е. сравнение данных представляется в виде отчета по проводкам,
//                но данный отчет формируется до регистраторов РСБУ и МСФО.
//                Примечание: по МСФО учитываются только документы "Трансляци".
//
//  - По документам - в отличии от варианта "По счетам" формируется в разрезе документа РСБУ, 
//                    с учетом и документов "Трансляци", и документов "ТрансформационнаяКорректировка".
//
//  Отчет формируется на данных РБ "Международный" и "МСФО" с учетом настроек трансляций по счетам.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантОтчета = "По документам";
	
	ЗаполнитьЗначенияСвойств(Отчет,Параметры);
	
	Если ЗначениеЗаполнено(Параметры.ДокументТрансляции) Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	Трансляция.Организация КАК Организация,
		|	Трансляция.ПериодОтчета КАК ПериодОтчета,
		|	Трансляция.Сценарий КАК Сценарий,
		|	Трансляция.ШаблонКорректировки КАК ШаблонКорректировки,
		|	Трансляция.ИспользуемаяИБ КАК ИспользуемаяИБ,
		|	Трансляция.ИсходныйДокумент КАК ИсходныйДокумент,
		|	Трансляция.ПравилоОбработки КАК ПравилоОбработки,
		|	Трансляция.ПериодОтражения КАК ПериодОтражения
		|ИЗ
		|	Документ.Трансляция КАК Трансляция
		|ГДЕ
		|	Трансляция.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",Параметры.ДокументТрансляции);
		Результат=Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		
		ЗаполнитьЗначенияСвойств(Отчет,Результат);
				
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.Сценарий) Тогда
		
		Отчет.Сценарий=Константы.СценарийМСФО.Получить();
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ОпределитьШаблонКорректировки();
		
	КонецЕсли;
	
	ПриИзмененииШаблонаКорректировки();
			
	Если ЗначениеЗаполнено(Параметры.Период) И ЗначениеЗаполнено(Параметры.ИсходнаяПериодичность) Тогда
		
		Отчет.ПериодОтчета=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(Параметры.Период,Параметры.ИсходнаяПериодичность,0);
		
	КонецЕсли;
		
	Отчет.Периодичность=Параметры.НоваяПериодичность;
	ПериодичностьТрансляции=КэшируемыеПроцедурыУХ.ПолучитьПериодичностьТрансляцииПроводок();
	
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		
		Элементы.ИсходныйДокумент.Видимость=Истина;
		
		Если ЗначениеЗаполнено(Отчет.ПериодОтражения) И (НЕ Отчет.ПериодОтражения=Отчет.ПериодОтчета) Тогда
			
			Элементы.ПериодОтчета.Заголовок=НСтр("ru = 'Период исходных данных с'");
			Элементы.ПериодОтражения.Видимость=Истина;
			
		Иначе
			
			Элементы.ПериодОтчета.Заголовок=НСтр("ru = 'Период с'");
			Элементы.ПериодОтражения.Видимость=Ложь;
			
		КонецЕсли;	 
		
	Иначе
		
		//Элементы.ИсходныйДокумент.Видимость=Ложь;
		Элементы.ПериодОтчета.Заголовок=НСтр("ru = 'Период с'");
		Элементы.ПериодОтражения.Видимость=Ложь;
		
	КонецЕсли;	
	 
	 ТипОтчета=Параметры.ТипОтчета;
	 
	 Если Не ЗначениеЗаполнено(ТипОтчета) Тогда
		 
		 ТипОтчета="Корреспонденция";
		 
	 КонецЕсли;

	Если ЗначениеЗаполнено(Отчет.ПериодОтчета) Тогда
		
		ПриИзмененииПериода(НЕ ЗначениеЗаполнено(Отчет.ДокументТрансляции));
		
	КонецЕсли;
	
	Элементы.Дополнительно.Пометка = (ЗначениеЗаполнено(Отчет.СчетДтИсточник) ИЛИ ЗначениеЗаполнено(Отчет.СчетКтИсточник));
	Элементы.ОтборПоКорреспонденции.Видимость=(ТипОтчета="Корреспонденция");
	ОтобразитьПанельНастроек();
	
	СформироватьЗаголовокФормы();
	
	Если Параметры.ФормироватьОтчет Тогда
		
		СформироватьОтчетНаСервере(ВариантОтчета = "По документам");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПриИзмененииОрганизации();	
	
КонецПроцедуры // ОрганизацияПриИзменении() 

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	ПриИзмененииКлючевогоПараметра();
	
КонецПроцедуры 

&НаКлиенте
Процедура ШаблонКорректировкиПриИзменении(Элемент)
	
	ПриИзмененииШаблонаКорректировки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОтчетаПриИзменении(Элемент)
	
	ПриИзмененииПериода();
		
КонецПроцедуры

&НаКлиенте
Процедура ТабДокОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Если Не ТипЗнч(Расшифровка)=Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
		
	СтандартнаяОбработка=Ложь;
	
	ОбработкаРасшифровкиКорреспонденция(Расшифровка);
						
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	Если НЕ ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не указан шаблон корректировки'"));
		Возврат;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ВариантОтчета) Тогда
		ВариантОтчета = "По документам";
	КонецЕсли;
	
	СформироватьОтчетНаСервере(ВариантОтчета = "По документам");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериод(Команда)
	
	ДатыПериода = ВернутьДатыСтандартногоПериода(Отчет.ПериодОтчета,Отчет.ПериодОкончания);
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();	
	Диалог.Период.ДатаНачала	 = ДатыПериода.ДатаНачала;
	Диалог.Период.ДатаОкончания	 = ДатыПериода.ДатаОкончания;
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Дополнительно(Команда)
	
	Элементы.Дополнительно.Пометка= НЕ Элементы.Дополнительно.Пометка;
	ОтобразитьПанельНастроек();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьРасшифровкуДтКт(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
    
    Расшифровка = ДополнительныеПараметры.Расшифровка;    
    ВыбранноеДействие = ВыбранныйЭлемент;
    
    Если ВыбранноеДействие = Неопределено Тогда
        
        Возврат;
		
	ИначеЕсли СтрНайти(ВыбранноеДействие.Значение,"ОткрытьНастройкуСоответствия")>0 Тогда
		
		 ОткрытьНастройкуСоответствия(ВыбранноеДействие.Значение,Расшифровка);	
        
    ИначеЕсли ТипЗнч(ВыбранноеДействие.Значение) = Тип("ПеречислениеСсылка.Периодичность") Тогда
        
        СтруктураПараметров=Новый Структура;
        СтруктураПараметров.Вставить("Организация",				Отчет.Организация);
        СтруктураПараметров.Вставить("Сценарий",				Отчет.Сценарий);
        СтруктураПараметров.Вставить("ПериодОтчета",			Отчет.ПериодОтчета);
        СтруктураПараметров.Вставить("ШаблонКорректировки",		Отчет.ШаблонКорректировки);
        СтруктураПараметров.Вставить("ИспользуемаяИБ",			Отчет.ИспользуемаяИБ);
		СтруктураПараметров.Вставить("ИсходныйДокумент",		Отчет.ИсходныйДокумент);
        СтруктураПараметров.Вставить("НоваяПериодичность",		ВыбранноеДействие.Значение);
        СтруктураПараметров.Вставить("ИсходнаяПериодичность",	Отчет.Периодичность);
        СтруктураПараметров.Вставить("СчетДтИсточник",			Расшифровка.СчетДтИсточник);
        СтруктураПараметров.Вставить("СчетКтПриемник",			Расшифровка.СчетКтИсточник);
        
        Если Расшифровка.Свойство("Период") Тогда
            
            СтруктураПараметров.Вставить("Период",Расшифровка.Период);
            
        КонецЕсли;
        
        СтруктураПараметров.Вставить("ФормироватьОтчет", Истина);
        
        ОткрытьФорму("Отчет.ВыверкаТрансляцииПроводок.ФормаОбъекта", СтруктураПараметров,,Новый УникальныйИдентификатор);
        
    ИначеЕсли СтрНайти(ВыбранноеДействие.Значение,"ОтчетПоПроводкам")>0
        ИЛИ СтрНайти(ВыбранноеДействие.Значение, "КарточкаСчета")>0 Тогда
		
		ПараметрыФормы = ПолучитьСтруктуруПараметровДляРасшифровки(Расшифровка,ВыбранноеДействие.Значение);
        ОткрытьФорму("Отчет.ОтчетПоРегиструБухгалтерииБД.Форма.ФормаОтчета", ПараметрыФормы,, Истина);
        
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФормированиеОтчета

&НаСервере
Процедура СформироватьОтчетНаСервере(ПоДокументам)
	
	ТабДок.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = Обработки.КорректировкиЗначенийПоказателей.ПолучитьИсточникТрансляции();
	Запрос.УстановитьПараметр("НазначениеРасчетов", ПравилоОбработки);
	
	мОперанды = Запрос.Выполнить().Выгрузить();
	
	// обрезаем коды
	мОперанды.Колонки.Код.Имя = "Имя";
	мОперанды.Колонки.Добавить("Код");
	
	Для Каждого Стр Из мОперанды Цикл
		Стр.Код = СокрЛП(Стр.Имя);
	КонецЦикла;
	
	мОперанды.Колонки.Удалить(мОперанды.Колонки.Имя);	
	мОперанды.Индексы.Добавить("Код");
	
	мОперанды.Колонки.Добавить("АналитикВидаОтчета",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0));
	мОперанды.Колонки.Добавить("Ресурс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	мОперанды.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
	
	СтрОперанд = мОперанды[0];
	СтрОперанд.ПравилаИспользованияПолейЗапроса.Очистить();
	
	ТекстРесурсыИсточник = "";
	
	Для Каждого СтрРесурс ИЗ РесурсыДляОтображения Цикл
		
		Если НЕ СтрРесурс.Отображать Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрРесурс.РесурсИсточникБалансовый Тогда
			
			ТекстРесурсыИсточник=ТекстРесурсыИсточник+",
			|СУММА("+СтрРесурс.РесурсИсточник+") КАК "+СтрРесурс.РесурсИсточник;
			
			ПолеРесурс = СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
			ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник;
			ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник;
			ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник;
		
		Иначе
			
			ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
			ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник+"Дт";
			ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник+"Дт";
			ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник+"Дт";
			
			ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
			ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник+"Кт";
			ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник+"Кт";
			ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник+"Кт";
			
			ТекстРесурсыИсточник = ТекстРесурсыИсточник+",
			|СУММА("+СтрРесурс.РесурсИсточник+"Дт) КАК "+СтрРесурс.РесурсИсточник+"Дт,
			|СУММА("+СтрРесурс.РесурсИсточник+"Кт) КАК "+СтрРесурс.РесурсИсточник+"Кт";
								
		КонецЕсли;
		
	КонецЦикла;
	
	СтрОперанд.ТекстЗапросаМодуля="ВЫБРАТЬ "+Сред(ТекстРесурсыИсточник,2)+" {ВЫБРАТЬ "+?(ЗначениеЗаполнено(Отчет.Периодичность),"Период,","")+"СчетДт.*,СчетКт.*"
	+ ",Регистратор.*"           
	// НАЧАЛО Николаев Павел 29.03.2024 Выполнение задач №000049053
	//+?(ЗначениеЗаполнено(Отчет.ИсходныйДокумент),",Регистратор","")+"} ИЗ РегистрБухгалтерии."+ РегистрБухгалтерииИсточник + ".ДвиженияССубконто({&ДатаНач}, {&ДатаКон},Активность "+?(ПустаяСтрока(СтрОперанд.ТекстОтбора),""," И "+СтрОперанд.ТекстОтбора)+?(ЗначениеЗаполнено(Отчет.ИсходныйДокумент)," И Регистратор=&Регистратор","")+")";
	+?(ЗначениеЗаполнено(Отчет.ИсходныйДокумент),",Регистратор","")+"} ИЗ РегистрБухгалтерии."+ РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто({&ДатаНач}, {&ДатаКон},Активность "+?(ПустаяСтрока(СтрОперанд.ТекстОтбора),""," И "+СтрОперанд.ТекстОтбора)+?(ЗначениеЗаполнено(Отчет.ИсходныйДокумент)," И Регистратор=&Регистратор","")+")";
	// КОНЕЦ Николаев Павел 29.03.2024 Выполнение задач №000049053
	
	// НАЧАЛО Николаев Павел 29.03.2024 Выполнение задач №000049053 : временная заплатка до адаптации под редакцию 3.2
	//ДанныеРасчета = УправлениеОтчетамиУХ.ПодготовитьОперандыДляПолученияДанных(мОперанды,Ложь,,,Ложь);
	ДанныеРасчета = тн_ПодготовитьОперандыДляПолученияДанных(мОперанды,Ложь,,,Ложь);
	// КОНЕЦ Николаев Павел 29.03.2024 Выполнение задач №000049053	
	СтрЗапрос = ДанныеРасчета.мТабПоказателиЗапросы[0];
	
	Если Обработки.КорректировкиЗначенийПоказателей.ТекущаяИБ(Отчет.ИспользуемаяИБ) Тогда
		
		Обработки.КорректировкиЗначенийПоказателей.ДобавитьТаблицуОтборомПоРегистратору(Отчет,СтрЗапрос.ПравилаВычисленияПараметров); 
		
		// НАЧАЛО Николаев Павел 29.03.2024 Выполнение задач №000049053 : временная заплатка до адаптации под редакцию 3.2
		//ТаблицаДанныхИсточник=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрРегистрНакопления(СформироватьДанныеОбъекта(),СтрЗапрос);
		ТаблицаДанныхИсточник=тн_ПолучитьТаблицуПоИсточникуВнутрРегистрНакопления(СформироватьДанныеОбъекта(),СтрЗапрос);
		// КОНЕЦ Николаев Павел 29.03.2024 Выполнение задач №000049053
		
		МассивИсключаемыхВНА.ЗагрузитьЗначения(ВстраиваниеУХ.ПолучитьВнаУчитываемыеПараллельно());
		
		Если МассивИсключаемыхВНА.Количество()>0 Тогда
			
			//ДополнитьТаблицуДанныхПараллельныйУчет(ТаблицаДанныхИсточник,СтрЗапрос);
			
		Иначе
			
			ТаблицаДанныхИсточник.Колонки.Добавить("СуммаИсключения",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
			
		КонецЕсли;	
		
	Иначе
		
		СтруктураЗапроса 		= РасширениеИнтеграцииУХ.ПодготовитьСтруктуруЗапроса(СформироватьДанныеОбъекта(),СтрЗапрос);	
		ТаблицаДанныхИсточник	= РасширениеИнтеграцииУХ.ПолучитьТаблицуДанныхПоЗапросу(СтруктураЗапроса);
		
	КонецЕсли;
	
	ЕстьПериод = Ложь;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ПоДокументам Тогда
		Запрос.Текст = ТекстЗапросаИсточникПоДокументам();
	Иначе
		Запрос.Текст = ТекстЗапросаИсточникПоСчетам();
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Организация"       , Отчет.Организация);
	Запрос.УстановитьПараметр("Сценарий"          , Отчет.Сценарий);
	Запрос.УстановитьПараметр("ПланСчетовПриемник", ПланСчетовПриемник);

	Если ЗначениеЗаполнено(Отчет.ПериодОтражения) И (НЕ Отчет.ПериодОтражения=Отчет.ПериодОтчета) Тогда
		
		Запрос.УстановитьПараметр("ДатаНач", Отчет.ПериодОтражения.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаКон", КонецДня(Отчет.ПериодОтражения.ДатаОкончания));
		
	Иначе
		
		Запрос.УстановитьПараметр("ДатаНач", Отчет.ДатаНач);
		Запрос.УстановитьПараметр("ДатаКон", Отчет.ДатаКон);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПланСчетовИсточник"   , ПланСчетовИсточник);
	Запрос.УстановитьПараметр("ИсходныйДокумент"     , Отчет.ИсходныйДокумент);
	Запрос.УстановитьПараметр("ДокументТрансляции"   , Отчет.ДокументТрансляции);
	Запрос.УстановитьПараметр("ТаблицаДанныхИсточник", ТаблицаДанныхИсточник);
	Запрос.УстановитьПараметр("ШаблонОперации"       , Отчет.ШаблонКорректировки);
	
	Запрос.Выполнить();
	
	Если ВариантОтчета = "По документам" Тогда
		ОтобразитьВыверкуПоДокументам(Запрос, ТаблицаДанныхИсточник);
	Иначе
		ОтобразитьВыверкуПоСчетам(Запрос, ТаблицаДанныхИсточник);
	КонецЕсли;
			
КонецПроцедуры // СформироватьОтчетНаСервере()

&НаСервереБезКонтекста
Функция ТекстЗапросаИсточникПоДокументам()

	ТекстЗапроса = "ВЫБРАТЬ
	             |	ТаблицаДанныхИсточник.Счет КАК СчетДтИсточникКод,
	             |	ТаблицаДанныхИсточник.КоррСчет КАК СчетКтИсточникКод,
	             |	ТаблицаДанныхИсточник.Сумма КАК Сумма,
	             |	ТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения,
	             |	ТаблицаДанныхИсточник.Регистратор КАК ДокументРСБУ
	             |ПОМЕСТИТЬ ТаблицаДанныхИсточник
	             |ИЗ
	             |	&ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СчетаБД.Ссылка КАК СчетБД,
	             |	СчетаБД.СчетСсылка КАК СчетСсылка
	             |ПОМЕСТИТЬ СчетаПриемник
	             |ИЗ
	             |	Справочник.СчетаБД КАК СчетаБД
	             |ГДЕ
	             |	СчетаБД.Владелец = &ПланСчетовПриемник
	             |
	             |ИНДЕКСИРОВАТЬ ПО
	             |	СчетаБД.СчетСсылка
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СчетаБД.Ссылка КАК СчетБД,
	             |	СчетаБД.Код КАК СчетКод
	             |ПОМЕСТИТЬ СчетаИсточник
	             |ИЗ
	             |	Справочник.СчетаБД КАК СчетаБД
	             |ГДЕ
	             |	СчетаБД.Владелец = &ПланСчетовИсточник
	             |
	             |ИНДЕКСИРОВАТЬ ПО
	             |	СчетаБД.Код
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ОтражениеДокументовПоШаблонам.ДокументРСБУ КАК ДокументРСБУ,
	             |	ОтражениеДокументовПоШаблонам.ДокументМСФО КАК ДокументМСФО
	             |ПОМЕСТИТЬ ОДПШ
	             |ИЗ
	             |	(ВЫБРАТЬ
	             |		ТаблицаДанныхИсточник.ДокументРСБУ КАК ДокументРСБУ,
	             |		ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения КАК ДокументМСФО
	             |	ИЗ
	             |		ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	             |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.МСФО КАК МСФО
	             |				ПО ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения = МСФО.Регистратор
	             |					И (МСФО.НомерСтроки = 1)
	             |			ПО ТаблицаДанныхИсточник.ДокументРСБУ = ОтражениеДокументовПоШаблонам.ИсходныйДокумент
	             |	ГДЕ
	             |		ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения <> НЕОПРЕДЕЛЕНО
	             |		И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения = НЕОПРЕДЕЛЕНО
	             |	
	             |	ОБЪЕДИНИТЬ ВСЕ
	             |	
	             |	ВЫБРАТЬ
	             |		ТаблицаДанныхИсточник.ДокументРСБУ,
	             |		ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения
	             |	ИЗ
	             |		ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	             |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.МСФО КАК МСФО
	             |				ПО ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения = МСФО.Регистратор
	             |					И (МСФО.НомерСтроки = 1)
	             |			ПО ТаблицаДанныхИсточник.ДокументРСБУ = ОтражениеДокументовПоШаблонам.ИсходныйДокумент
	             |	ГДЕ
	             |		(ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения <> НЕОПРЕДЕЛЕНО
	             |					И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения <> НЕОПРЕДЕЛЕНО
	             |				ИЛИ ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения = НЕОПРЕДЕЛЕНО
	             |					И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения = НЕОПРЕДЕЛЕНО)
	             |		И ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения <> НЕОПРЕДЕЛЕНО) КАК ОтражениеДокументовПоШаблонам"; 
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстЗапросаИсточникПоСчетам()

	ТекстЗапроса= "ВЫБРАТЬ
	              |	ТаблицаДанныхИсточник.Счет КАК СчетДтИсточникКод,
	              |	ТаблицаДанныхИсточник.КоррСчет КАК СчетКтИсточникКод,
	              |	ТаблицаДанныхИсточник.Сумма КАК Сумма,
	              |	ТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения,
	              |	ТаблицаДанныхИсточник.Регистратор КАК ДокументРСБУ
	              |ПОМЕСТИТЬ мТаблицаДанныхИсточник
	              |ИЗ
	              |	&ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	СчетаБД.Ссылка КАК СчетБД,
	              |	СчетаБД.СчетСсылка КАК СчетСсылка
	              |ПОМЕСТИТЬ СчетаПриемник
	              |ИЗ
	              |	Справочник.СчетаБД КАК СчетаБД
	              |ГДЕ
	              |	СчетаБД.Владелец = &ПланСчетовПриемник
	              |
	              |ИНДЕКСИРОВАТЬ ПО
	              |	СчетаБД.СчетСсылка
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	СчетаБД.Ссылка КАК СчетБД,
	              |	СчетаБД.Код КАК СчетКод
	              |ПОМЕСТИТЬ СчетаИсточник
	              |ИЗ
	              |	Справочник.СчетаБД КАК СчетаБД
	              |ГДЕ
	              |	СчетаБД.Владелец = &ПланСчетовИсточник
	              |
	              |ИНДЕКСИРОВАТЬ ПО
	              |	СчетаБД.Код
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ РАЗЛИЧНЫЕ
	              |	мТаблицаДанныхИсточник.СчетДтИсточникКод КАК СчетДтИсточникКод,
	              |	мТаблицаДанныхИсточник.СчетКтИсточникКод КАК СчетКтИсточникКод,
	              |	мТаблицаДанныхИсточник.Сумма КАК Сумма,
	              |	мТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения,
	              |	мТаблицаДанныхИсточник.ДокументРСБУ КАК ДокументРСБУ,
	              |	ЕСТЬNULL(ОтражениеДокументовПоШаблонам.ДокументМСФО, мТаблицаДанныхИсточник.ДокументРСБУ) КАК ДокументМСФО
	              |ПОМЕСТИТЬ ТаблицаДанныхИсточник
	              |ИЗ
	              |	мТаблицаДанныхИсточник КАК мТаблицаДанныхИсточник
	              |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	              |			мТаблицаДанныхИсточник.ДокументРСБУ КАК ДокументРСБУ,
	              |			ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения КАК ДокументМСФО
	              |		ИЗ
	              |			мТаблицаДанныхИсточник КАК мТаблицаДанныхИсточник
	              |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	              |					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.МСФО КАК МСФО
	              |					ПО ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения = МСФО.Регистратор
	              |						И (МСФО.НомерСтроки = 1)
	              |				ПО мТаблицаДанныхИсточник.ДокументРСБУ = ОтражениеДокументовПоШаблонам.ИсходныйДокумент
	              |		ГДЕ
	              |			ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения <> НЕОПРЕДЕЛЕНО
	              |			И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения = НЕОПРЕДЕЛЕНО
	              |			И ОтражениеДокументовПоШаблонам.ШаблонОперации = &ШаблонОперации
	              |		
	              |		ОБЪЕДИНИТЬ ВСЕ
	              |		
	              |		ВЫБРАТЬ
	              |			мТаблицаДанныхИсточник.ДокументРСБУ,
	              |			ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения
	              |		ИЗ
	              |			мТаблицаДанныхИсточник КАК мТаблицаДанныхИсточник
	              |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	              |					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.МСФО КАК МСФО
	              |					ПО ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения = МСФО.Регистратор
	              |						И (МСФО.НомерСтроки = 1)
	              |				ПО мТаблицаДанныхИсточник.ДокументРСБУ = ОтражениеДокументовПоШаблонам.ИсходныйДокумент
	              |		ГДЕ
	              |			(ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения <> НЕОПРЕДЕЛЕНО
	              |						И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения <> НЕОПРЕДЕЛЕНО
	              |					ИЛИ ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения = НЕОПРЕДЕЛЕНО
	              |						И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения = НЕОПРЕДЕЛЕНО)
	              |			И ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения <> НЕОПРЕДЕЛЕНО
	              |			И ОтражениеДокументовПоШаблонам.ШаблонОперации = &ШаблонОперации) КАК ОтражениеДокументовПоШаблонам
	              |		ПО мТаблицаДанныхИсточник.ДокументРСБУ = ОтражениеДокументовПоШаблонам.ДокументРСБУ";
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Процедура ОтобразитьВыверкуПоДокументам(Запрос, ТаблицаДанныхИсточник) 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	СравнениеОборотов.СчетДтИсточник КАК СчетДтИсточник,
	|	СравнениеОборотов.СчетКтИсточник КАК СчетКтИсточник,
	|	СравнениеОборотов.СчетДтПриемник КАК СчетДтПриемник,
	|	СравнениеОборотов.СчетКтПриемник КАК СчетКтПриемник,
	|	СравнениеОборотов.Сумма КАК Сумма,
	|	СравнениеОборотов.СуммаИсключения КАК СуммаИсключения,
	|	СравнениеОборотов.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	СравнениеОборотов.Расхождение_Сумма_СуммаВВалютеУчета КАК Расхождение_Сумма_СуммаВВалютеУчета,
	|	СравнениеОборотов.СчетДтИсточник.Код,
	|	СравнениеОборотов.СчетКтИсточник.Код,
	|	СравнениеОборотов.СчетДтПриемник.Код,
	|	СравнениеОборотов.СчетКтПриемник.Код,
	|	СравнениеОборотов.Регистратор КАК ДокументМСФО,
	|	СравнениеОборотов.ДокументРСБУ КАК ДокументРСБУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОбъединениеДанных.СчетДтИсточник КАК СчетДтИсточник,
	|		ОбъединениеДанных.СчетКтИсточник КАК СчетКтИсточник,
	|		ОбъединениеДанных.СчетДтПриемник КАК СчетДтПриемник,
	|		ОбъединениеДанных.СчетКтПриемник КАК СчетКтПриемник,
	|		СУММА(ОбъединениеДанных.Сумма) КАК Сумма,
	|		СУММА(ОбъединениеДанных.СуммаИсключения) КАК СуммаИсключения,
	|		СУММА(ОбъединениеДанных.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
	|		СУММА(ОбъединениеДанных.Сумма - ОбъединениеДанных.СуммаВВалютеУчета) КАК Расхождение_Сумма_СуммаВВалютеУчета,
	
	|		ОбъединениеДанных.Регистратор КАК Регистратор,
	|		ОбъединениеДанных.ДокументРСБУ КАК ДокументРСБУ
	
	|	ИЗ
	|		(ВЫБРАТЬ
	|			СчетаБДИсточникДт.Ссылка КАК СчетДтИсточник,
	|			СчетаБДИсточникКт.Ссылка КАК СчетКтИсточник,
	|			ТаблицаДанныхИсточник.Сумма КАК Сумма,
	|			ТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения,
	|			0 КАК СуммаВВалютеУчета,
	|			NULL КАК СчетДтПриемник,
	|			NULL КАК СчетКтПриемник,
	
	|			ТаблицаДанныхИсточник.ДокументРСБУ КАК Регистратор,
	|			ТаблицаДанныхИсточник.ДокументРСБУ КАК ДокументРСБУ
	
	|		ИЗ
	|			ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДИсточникДт
	|				ПО ТаблицаДанныхИсточник.СчетДтИсточникКод = СчетаБДИсточникДт.Код
	|					И (СчетаБДИсточникДт.Владелец = &ПланСчетовИсточник)
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДИсточникКт
	|				ПО ТаблицаДанныхИсточник.СчетКтИсточникКод = СчетаБДИсточникКт.Код
	|					И (СчетаБДИсточникКт.Владелец = &ПланСчетовИсточник)
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			РегистрБухгалтерииПриемник.СчетДтИсточник,
	|			РегистрБухгалтерииПриемник.СчетКтИсточник,
	|			0,
	|			0,
	|			СУММА(РегистрБухгалтерииПриемник.СуммаВВалютеУчета),
	|			СчетаДт.СчетБД,
	|			СчетаКт.СчетБД, 
    
	|			ВЫРАЗИТЬ(РегистрБухгалтерииПриемник.Регистратор КАК Документ.Трансляция),
	|			ОДПШ.ДокументРСБУ
	
	|		ИЗ
	|			РегистрБухгалтерии.МСФО.ДвиженияССубконто(
	|					&ДатаНач,
	|					&ДатаКон,
	|					Организация = &Организация
	|						И Сценарий = &Сценарий
	|						И Активность
	|						И (НЕ (СчетДтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка) ИЛИ СчетКтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка)))"
						+?(ЗначениеЗаполнено(Отчет.ИсходныйДокумент)," И Регистратор.ИсходныйДокумент=&ИсходныйДокумент","");
						
						Если ЗначениеЗаполнено(Отчет.ДокументТрансляции) Тогда
							
							Запрос.Текст=Запрос.Текст+"
							|И Регистратор=&ДокументТрансляции";
							Запрос.УстановитьПараметр("ДокументТрансляции", Отчет.ДокументТрансляции);
							
						Иначе
							
							Запрос.Текст=Запрос.Текст+"
							|И (Регистратор Ссылка Документ.Трансляция И Регистратор.ШаблонКорректировки=&ШаблонКорректировки)";
							Запрос.УстановитьПараметр("ШаблонКорректировки", Отчет.ШаблонКорректировки);
							
						КонецЕсли;							
												
	Запрос.Текст = Запрос.Текст+"	
	|					,
	|					) КАК РегистрБухгалтерииПриемник
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаДт
