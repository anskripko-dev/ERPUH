&НаСервере
Процедура ОтобразитьВыверкуПоСчетам(Запрос, ТаблицаДанныхИсточник) 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	СравнениеОборотов.СчетДтИсточник КАК СчетДтИсточник,
	|	СравнениеОборотов.СчетКтИсточник КАК СчетКтИсточник,
	|	СравнениеОборотов.СчетДтПриемник КАК СчетДтПриемник,
	|	СравнениеОборотов.СчетКтПриемник КАК СчетКтПриемник,
	|	СравнениеОборотов.Сумма КАК Сумма,
	|	СравнениеОборотов.СуммаИсключения КАК СуммаИсключения,
	|	СравнениеОборотов.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	СравнениеОборотов.Расхождение_Сумма_СуммаВВалютеУчета КАК Расхождение_Сумма_СуммаВВалютеУчета,
	|	СравнениеОборотов.СчетДтИсточник.Код,
	|	СравнениеОборотов.СчетКтИсточник.Код,
	|	СравнениеОборотов.СчетДтПриемник.Код,
	|	СравнениеОборотов.СчетКтПриемник.Код,
	
	|	СравнениеОборотов.Регистратор КАК ДокументМСФО,
	|	ТаблицаДанныхИсточник.ДокументРСБУ КАК ДокументРСБУ
	
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОбъединениеДанных.СчетДтИсточник КАК СчетДтИсточник,
	|		ОбъединениеДанных.СчетКтИсточник КАК СчетКтИсточник,
