		КолонкаРесурс="РесурсИсточник";
		
	ИначеЕсли  ТипОтчетаПоРегистру="ОтчетПоПроводкамПриемник" Тогда
		
		ОтборПоИзмерениям.Добавить(Новый Структура("ИмяПараметра,Значение","Сценарий",Отчет.Сценарий));	
		
		СтруктураПараметров.Вставить("ТипБД",				Справочники.ТипыБазДанных.ТекущаяИБ);
		СтруктураПараметров.Вставить("РегистрБД",			Отчет.ШаблонКорректировки.РегистрБухгалтерииПриемник);
		СтруктураПараметров.Вставить("ПланСчетовБД",		Отчет.ШаблонКорректировки.ПланСчетовПриемник);
		СтруктураПараметров.Вставить("Счет",				Расшифровка.СчетДтПриемник);
		СтруктураПараметров.Вставить("КоррСчет",			Расшифровка.СчетКтПриемник);
		СтруктураПараметров.Вставить("ВидОтчета",			"ОтчетПоПроводкам");
		
		КолонкаРесурс="РесурсПриемник";
		
	ИначеЕсли  ТипОтчетаПоРегистру="КарточкаСчетаПриемникДт" Тогда
		
		ОтборПоИзмерениям.Добавить(Новый Структура("ИмяПараметра,Значение","Сценарий",Отчет.Сценарий));	
		
		СтруктураПараметров.Вставить("ТипБД",				Справочники.ТипыБазДанных.ТекущаяИБ);
