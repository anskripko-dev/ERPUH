&НаСервере
Процедура ОпределитьПараметрыВыверки()
	
	ТипБД = Отчет.ШаблонКорректировки.ПланСчетовИсточник.Владелец;
	
	РегистрБухгалтерииИсточник	= Отчет.ШаблонКорректировки.РегистрБухгалтерииИсточник;
	РегистрБухгалтерииПриемник	= Отчет.ШаблонКорректировки.РегистрБухгалтерииПриемник;
	ПланСчетовИсточник			= Отчет.ШаблонКорректировки.ПланСчетовИсточник;
	ПланСчетовПриемник			= Отчет.ШаблонКорректировки.ПланСчетовПриемник;
	
	Элементы.ИспользуемаяИБ.Видимость=(НЕ ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	РегистрыБухгалтерииБДРесурсы.Имя КАК РесурсИсточник,
	|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК Отображать,
	|	ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник,
	|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК РесурсИсточникБалансовый
	|ИЗ
	|	Справочник.ШаблоныТрансляций.СоответствиеРесурсов КАК ШаблоныТрансляцийСоответствиеРесурсов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрыБухгалтерииБД.Ресурсы КАК РегистрыБухгалтерииБДРесурсы
	|		ПО ШаблоныТрансляцийСоответствиеРесурсов.Ссылка.РегистрБухгалтерииИсточник = РегистрыБухгалтерииБДРесурсы.Ссылка
	|			И ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = РегистрыБухгалтерииБДРесурсы.Имя
	|ГДЕ
	|	ШаблоныТрансляцийСоответствиеРесурсов.Ссылка = &Ссылка
	|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = """"
	|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник = """"";
	
	Запрос.УстановитьПараметр("Ссылка",Отчет.ШаблонКорректировки);
	
	РесурсыДляОтображения.Очистить();
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=РесурсыДляОтображения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
		
	КонецЦикла;
					
КонецПроцедуры // ПриИзмененииШаблонаКорректировки()

&НаСервере
Процедура ОпределитьПравилоОбработки()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПравилаОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаОбработки КАК ПравилаОбработки
	|ГДЕ
	|	ПравилаОбработки.НаправлениеТрансляции = &НаправлениеТрансляции
	|	И ПравилаОбработки.Владелец = &Владелец
	|	И НЕ ПравилаОбработки.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НаправлениеТрансляции",Перечисления.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии);
	Запрос.УстановитьПараметр("Владелец",Отчет.ШаблонКорректировки);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ПравилоОбработки=Результат.Ссылка;
				
	КонецЕсли;
					
КонецПроцедуры // ПриИзмененииШаблонаКорректировки()

&НаСервере
Процедура СформироватьЗаголовокФормы()
	
	Если ЗначениеЗаполнено(Отчет.Организация) И ЗначениеЗаполнено(Отчет.ПериодОтчета) Тогда
		
		ТекстЗаголовка = СтрШаблон(Нстр("ru = 'Выверка трансляции по документам: %1, %2 - %3'"), Отчет.Организация, Отчет.ПериодОтчета, Отчет.ПериодОкончания);	
		
	ИначеЕсли ЗначениеЗаполнено(Отчет.Организация) Тогда
		
		ТекстЗаголовка = СтрШаблон(Нстр("ru = 'Выверка трансляции по документам: %1'"), Отчет.Организация);
		
	ИначеЕсли ЗначениеЗаполнено(Отчет.ПериодОтчета) Тогда
		
		ТекстЗаголовка = СтрШаблон(Нстр("ru = 'Выверка трансляции по документам: %1 - %2'"), Отчет.ПериодОтчета, Отчет.ПериодОкончания);	
		
	Иначе
		ТекстЗаголовка = Нстр("ru = 'Выверка трансляции по документам'");	
	КонецЕсли;
	
	ЭтаФорма.Заголовок = ТекстЗаголовка;
		
КонецПроцедуры // СформироватьЗаголовокФормы()

&НаКлиенте
Процедура ИзменитьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
		
	Если ТипЗнч(РезультатВыбора) = Тип("СтандартныйПериод") Тогда
		
		ПриВыбореСтандартногоПериода(РезультатВыбора);
					
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриВыбореСтандартногоПериода(РезультатВыбора)
		
	ВыбраннаяПериодичность = ПериодичностьТрансляции;
	
	РезультатДатаНачала 		= РезультатВыбора.ДатаНачала;
	РезультатДатаОкончания 		= РезультатВыбора.ДатаОкончания;
	
	Если (ЗначениеЗаполнено(РезультатДатаНачала)) И (ЗначениеЗаполнено(РезультатДатаОкончания)) Тогда
		
		ПериодыУХПовтИсп.ПроверитьИнтервалПериодов(РезультатДатаНачала, РезультатДатаОкончания);
		
		Отчет.ПериодОтчета		 = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(РезультатДатаНачала, ВыбраннаяПериодичность);
		Отчет.ПериодОкончания	 = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(РезультатДатаОкончания, ВыбраннаяПериодичность);
		
		ПриИзмененииПериода();
		
	Иначе
		// Не изменяем периоды.
	КонецЕсли;	
	
КонецПроцедуры // ПриВыбореПериода() 

&НаСервере
Функция СформироватьДанныеОбъекта()
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("Организация",	Отчет.Организация);
	ДанныеОбъекта.Вставить("ПериодОтчета",	Новый Структура("ДатаНачала,ДатаОкончания",Отчет.ДатаНач,Отчет.ДатаКон));
	ДанныеОбъекта.Вставить("Сценарий",		Отчет.Сценарий);
	ДанныеОбъекта.Вставить("ИспользуемаяИБ",Отчет.ИспользуемаяИБ);
	ДанныеОбъекта.Вставить("Регистратор",	Отчет.ИсходныйДокумент);
	ДанныеОбъекта.Вставить("АнализЧувствительности",	Ложь);
	
	Возврат ДанныеОбъекта;
		
КонецФункции // СформироватьДанныеОбъекта()

&НаСервере
Процедура ПриИзмененииПериода(ОбновитьШаблонКорректировки=Истина)
	
	Если НЕ ЗначениеЗаполнено(Отчет.ПериодОкончания) Тогда
		
		Отчет.ПериодОкончания=Отчет.ПериодОтчета;
		
	КонецЕсли;
	
	Отчет.ДатаНач=Отчет.ПериодОтчета.ДатаНачала;
	Отчет.ДатаКон=КонецДня(Отчет.ПериодОкончания.ДатаОкончания);
	
	Если ОбновитьШаблонКорректировки Тогда
		ПриИзмененииКлючевогоПараметра();
	КонецЕсли;
	
	//ОтобразитьПанельСостояния(ПолучитьСводноеСостояние(Отчет.ПериодОтчета,Отчет.ПериодОкончания));
			
КонецПроцедуры // ПриИзмененииПериода()

&НаСервере
Процедура ОтобразитьПанельСостояния(ТекстСостояния)
	
	Если ПустаяСтрока(ТекстСостояния) Тогда
		
		Элементы.ДекорацияНастройка.Видимость=Ложь;
		
	Иначе
		
		Элементы.ДекорацияНастройка.Заголовок=ТекстСостояния;
		Элементы.ДекорацияНастройка.Видимость=Истина;
		
	КонецЕсли;		
	
КонецПроцедуры // ОтобразитьПанельСостояния() 

&НаСервере
Процедура ОтобразитьПанельНастроек()
	
	Элементы.ПанельНастройки.Видимость=Элементы.Дополнительно.Пометка;
	
КонецПроцедуры // ОтобразитьПанельНастроек()

&НаСервереБезКонтекста
Функция ВернутьДатыСтандартногоПериода(ПериодОтчета,ПериодОкончания)
	
	ПустаяДата = Дата(1, 1, 1);
	
	ДатыПериода = Новый Структура("ДатаНачала,ДатаОкончания");
	
	Если ЗначениеЗаполнено(ПериодОтчета) Тогда
		ДатыПериода.ДатаНачала = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодОтчета, "ДатаНачала");
	Иначе
		ДатыПериода.ДатаНачала = ПустаяДата;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодОкончания) Тогда
		ДатыПериода.ДатаОкончания = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодОкончания, "ДатаОкончания");
	Иначе
		ДатыПериода.ДатаОкончания = ДатыПериода.ДатаНачала;
	КонецЕсли;
	
	Возврат ДатыПериода; 
	
КонецФункции // ВернутьДатыСтандартногоПериода()

&НаКлиенте
Процедура ОткрытьНастройкуСоответствия(ТекстНастройки,Расшифровка)
	
	Перем СчетДтИсточник;
	Перем СчетКтИсточник;
	Перем СчетДтПриемник;
	Перем СчетКтПриемник;
	
	Расшифровка.Свойство("СчетДтИсточник",СчетДтИсточник);
	Расшифровка.Свойство("СчетКтИсточник",СчетКтИсточник);
	Расшифровка.Свойство("СчетДтПриемник",СчетДтПриемник);
	Расшифровка.Свойство("СчетКтПриемник",СчетКтПриемник);
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ШаблонТрансляции",Отчет.ШаблонКорректировки);
	
	Если ТекстНастройки="ОткрытьНастройкуСоответствияДт" Тогда	
		
		СтруктураПараметров.Вставить("СчетИсточник",СчетДтИсточник);
		СтруктураПараметров.Вставить("СчетПриемник",СчетДтПриемник);
		
	Иначе
			
		СтруктураПараметров.Вставить("СчетИсточник",СчетКтИсточник);
		СтруктураПараметров.Вставить("СчетПриемник",СчетКтПриемник);
		
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("СчетПриемник") Тогда
		
		ОткрытьФорму("Обработка.УстановкаСоответствияСчетов.Форма.ФормаНастройкиСоответствия",СтруктураПараметров,ЭтотОбъект);
		
	Иначе
		
		ОткрытьФорму("Обработка.УстановкаСоответствияСчетов.Форма",СтруктураПараметров,ЭтотОбъект);
		
	КонецЕсли;	
			
КонецПроцедуры // ОткрытьНастройкуСоответствия()

&НаСервере
Функция ПолучитьСтруктуруПараметровДляРасшифровки(Расшифровка,ТипОтчетаПоРегистру)
	
	СтруктураПараметров=Новый Структура;
	
	Если Расшифровка.Свойство("Период") Тогда
		
		СтруктураПараметров.Вставить("ДатаНач",ОбщегоНазначенияУХ.ДатаНачалаПериода(Расшифровка.Период,Отчет.Периодичность));
		СтруктураПараметров.Вставить("ДатаКон",ОбщегоНазначенияУХ.ДатаКонцаПериода(Расшифровка.Период,Отчет.Периодичность));
		
	Иначе
		
		СтруктураПараметров.Вставить("ДатаНач",Отчет.ДатаНач);
		СтруктураПараметров.Вставить("ДатаКон",Отчет.ДатаКон);
		
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ФормироватьПриОткрытии",Истина);
	СтруктураПараметров.Вставить("ПоСубсчетам",Истина);
			
	ОтборПоИзмерениям=Новый Массив;
	ОтборПоИзмерениям.Добавить(Новый Структура("ИмяПараметра,Значение","Организация",Отчет.Организация));
			
	Если ТипОтчетаПоРегистру="ОтчетПоПроводкамИсточник" Тогда
		
		СтруктураПараметров.Вставить("ТипБД",				ТипБД);
		СтруктураПараметров.Вставить("ИспользуемаяИБ",		Отчет.ИспользуемаяИБ);
		СтруктураПараметров.Вставить("РегистрБД",			Отчет.ШаблонКорректировки.РегистрБухгалтерииИсточник);
		СтруктураПараметров.Вставить("ПланСчетовБД",		Отчет.ШаблонКорректировки.ПланСчетовИсточник);

		СтруктураПараметров.Вставить("Счет",				Расшифровка.СчетДтИсточник);
		СтруктураПараметров.Вставить("КоррСчет",			Расшифровка.СчетКтИсточник);	
		СтруктураПараметров.Вставить("ВидОтчета",			"ОтчетПоПроводкам");
		
		КолонкаРесурс="РесурсИсточник";
		
	ИначеЕсли ТипОтчетаПоРегистру="АнализСчета" Тогда
		
		СтруктураПараметров.Вставить("ТипБД",				ТипБД);
		СтруктураПараметров.Вставить("ИспользуемаяИБ",		Отчет.ИспользуемаяИБ);
		СтруктураПараметров.Вставить("РегистрБД",			Отчет.ШаблонКорректировки.РегистрБухгалтерииИсточник);
		СтруктураПараметров.Вставить("ПланСчетовБД",		Отчет.ШаблонКорректировки.ПланСчетовИсточник);
		СтруктураПараметров.Вставить("Счет",				Расшифровка.СчетИсточник);	
		СтруктураПараметров.Вставить("ВидОтчета",			"АнализСчета");
		
		КолонкаРесурс="РесурсИсточник";
		
	ИначеЕсли ТипОтчетаПоРегистру="КарточкаСчетаИсточникДт" Тогда
		
		СтруктураПараметров.Вставить("ТипБД",				ТипБД);
		СтруктураПараметров.Вставить("ИспользуемаяИБ",		Отчет.ИспользуемаяИБ);
		СтруктураПараметров.Вставить("РегистрБД",			Отчет.ШаблонКорректировки.РегистрБухгалтерииИсточник);
		СтруктураПараметров.Вставить("ПланСчетовБД",		Отчет.ШаблонКорректировки.ПланСчетовИсточник);
		СтруктураПараметров.Вставить("Счет",				Расшифровка.СчетДтИсточник);	
		СтруктураПараметров.Вставить("ВидОтчета",			"КарточкаСчета");
		
		КолонкаРесурс="РесурсИсточник";
		
	ИначеЕсли ТипОтчетаПоРегистру="КарточкаСчетаИсточникКт" Тогда
		
		СтруктураПараметров.Вставить("ТипБД",				ТипБД);
		СтруктураПараметров.Вставить("ИспользуемаяИБ",		Отчет.ИспользуемаяИБ);
