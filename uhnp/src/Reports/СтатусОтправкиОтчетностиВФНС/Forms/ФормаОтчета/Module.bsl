
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПредыдущийПериод(Команда)
	
	ИзменитьПериод(-1);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСледующийПериод(Команда)
	
	ИзменитьПериод(1);
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериод(Шаг)
	
	мДатаКонцаПериодаОтчета  = КонецКвартала(ДобавитьМесяц(мДатаКонцаПериодаОтчета, Шаг * 3));
	мДатаНачалаПериодаОтчета = НачалоГода(мДатаКонцаПериодаОтчета);
	
	ПриИзмененииПериода();
	
	СкомпоноватьРезультат();
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПериода()
	
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	Для каждого Настройка Из Настройки.ПараметрыДанных.Элементы Цикл
		Если Настройка.Параметр = Новый ПараметрКомпоновкиДанных("ПериодОтчета") Тогда
			Настройка.Значение.ДатаНачала = НачалоДня(мДатаНачалаПериодаОтчета);
			Настройка.Значение.ДатаОкончания = КонецДня(мДатаКонцаПериодаОтчета);
			Настройка.Использование = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
	ПолеВыбораПериодичностиПоказаПериода = ПредставлениеПериода(
		НачалоДня(мДатаНачалаПериодаОтчета), КонецДня(мДатаКонцаПериодаОтчета), "ФП = Истина");
		
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	мПериодичность = Перечисления.Периодичность.Квартал;
	
	Если ЗначениеЗаполнено(Параметры.мДатаНачалаПериодаОтчета) И ЗначениеЗаполнено(Параметры.мДатаКонцаПериодаОтчета) Тогда
		мДатаНачалаПериодаОтчета = НачалоГода(Параметры.мДатаНачалаПериодаОтчета);
		мДатаКонцаПериодаОтчета  = КонецГода(Параметры.мДатаКонцаПериодаОтчета);
	Иначе
		Период = ОбщегоНазначения.РабочаяДатаПользователя();
		Если Не ЗначениеЗаполнено(Период) Тогда
			Период = ТекущаяДатаСеанса();
		КонецЕсли;
		мДатаНачалаПериодаОтчета = НачалоГода(ДобавитьМесяц(Период, -12));
		мДатаКонцаПериодаОтчета  = КонецГода(мДатаНачалаПериодаОтчета);
	КонецЕсли;
	ПриИзмененииПериода();
КонецПроцедуры

&НаКлиенте
Процедура СкрытыеОтчеты(Команда)
	ОткрытьФорму("Отчет.СтатусОтправкиОтчетностиВФНС.Форма.ФормаСкрытыеРегламентированныеОтчеты", , ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СкомпоноватьРезультат();
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	Перем ВыбранноеДействие;
	Перем ПараметрыВыбранногоДействия;
    СтандартнаяОбработка = Ложь;
	ЗначенияРасшифровки = ПолучитьДанныеРасшифровки(ДанныеРасшифровки, Расшифровка);
	РегламентированныйОтчет = Неопределено;
	Если ЗначенияРасшифровки.Свойство("РегламентированныйОтчет", РегламентированныйОтчет) Тогда
		Если ЗначениеЗаполнено(РегламентированныйОтчет) Тогда
			ПоказатьЗначение(, РегламентированныйОтчет);
			Возврат;
		Иначе
			ИсточникОтчета = Неопределено;
			Организация = Неопределено;
			Если ЗначенияРасшифровки.Свойство("ИсточникОтчета", ИсточникОтчета) И ЗначенияРасшифровки.Свойство("Организация", Организация) Тогда
				ОткрытьФорму("Отчет." + ИсточникОтчета + ".Форма", Новый Структура("Организация", Организация), ЭтаФорма);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СтандартнаяОбработка = Истина;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеРасшифровки(ДанныеРасшифровки, Расшифровка)
	ДанныеРасшифровкиОбъект = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	Результат = Новый Структура;
	Для каждого Элемент Из ДанныеРасшифровкиОбъект.Элементы[Расшифровка].ПолучитьПоля() Цикл
		Результат.Вставить(Элемент.Поле, Элемент.Значение);
	КонецЦикла;
	Для каждого Родитель Из ДанныеРасшифровкиОбъект.Элементы[Расшифровка].ПолучитьРодителей() Цикл
		Для каждого Элемент Из ДанныеРасшифровкиОбъект.Элементы[Родитель.Идентификатор].ПолучитьПоля() Цикл
			Результат.Вставить(Элемент.Поле, Элемент.Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции
