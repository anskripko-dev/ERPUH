Функция ПолучитьТаблицуПримененияФорматов() Экспорт 
	Результат = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюТаблицуПримененияФорматов();
	
	Стр = Результат.Добавить();
	Стр.ИмяФормы = "Форма2021_1";
	Стр.КНД = "1110301";
	Стр.ВерсияФормата = "5.03";
	
	Возврат Результат;
КонецФункции

Функция ДанноеУведомлениеДоступноДляОрганизации() Экспорт 
	Возврат Истина;
КонецФункции

Функция ДанноеУведомлениеДоступноДляИП() Экспорт 
	Возврат Ложь;
КонецФункции

Функция ПолучитьОсновнуюФорму() Экспорт 
	Возврат "";
КонецФункции

Функция ПолучитьФормуПоУмолчанию() Экспорт 
	Возврат "";
КонецФункции

Функция ПолучитьТаблицуФорм() Экспорт 
	Результат = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюТаблицуФормУведомления();
	
	Стр = Результат.Добавить();
	Стр.ИмяФормы = "Форма2021_1";
	Стр.ОписаниеФормы = "Форма заявления о проведении налогового мониторинга в формате 5.03";
	Стр.ДатаНачала = '20201001';
	Стр.ДатаКонца = '20991231';
	
	Возврат Результат;
КонецФункции

Функция ЭлектронноеПредставление(Объект, ИмяФормы, УникальныйИдентификатор) Экспорт
	Если ИмяФормы = "Форма2021_1" Тогда
		Возврат ЭлектронноеПредставление_Форма2021_1(Объект, УникальныйИдентификатор);
	КонецЕсли;
КонецФункции

Функция СформироватьСписокЛистов(Объект) Экспорт
	Если Объект.ИмяФормы = "Форма2021_1" Тогда 
		Возврат СформироватьСписокЛистовФорма2021(Объект);
	ИначеЕсли Объект.ИмяФормы = "Форма2020_1" Тогда 
		Возврат СформироватьСписокЛистовФормаФорма2020(Объект);
	КонецЕсли;
КонецФункции

Функция ПроверитьДокументСВыводомВТаблицу(Объект, ИмяФормы, УникальныйИдентификатор) Экспорт 
	Если ИмяФормы = "Форма2021_1" Тогда 
		Возврат ПроверитьДокументСВыводомВТаблицу_Форма2021_1(
			Объект, УведомлениеОСпецрежимахНалогообложения.ДанныеУведомленияДляВыгрузки(Объект), УникальныйИдентификатор);
	КонецЕсли;
КонецФункции

Функция ИдентификаторФайлаЭлектронногоПредставления(СведенияОтправки)
	Префикс = "ON_ZVNALMON";
	Возврат Документы.УведомлениеОСпецрежимахНалогообложения.ИдентификаторФайлаЭлектронногоПредставления(Префикс, СведенияОтправки);
КонецФункции

Функция ПроверитьДокументСВыводомВТаблицу_Форма2021_1(Объект, Данные, УникальныйИдентификатор)
	ТаблицаОшибок = Новый СписокЗначений;
	УведомлениеОСпецрежимахНалогообложения.ПроверкаАктуальностиФормыПриВыгрузке(
		Данные.Объект.ИмяФормы, ТаблицаОшибок, ПолучитьТаблицуФорм());
	
	Титульная = Данные.ДанныеУведомления.Титульная;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(Титульная.КодНО, ТаблицаОшибок, "Титульная");
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаГода(Титульная, ТаблицаОшибок, "Титульная", "ГодНМ", Истина);
	
	Если Не ЗначениеЗаполнено(Титульная.Наименование) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано наименование организации/ФИО физлица", "Титульная", "Наименование"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.ДАТА_ПОДПИСИ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата формирования документа", "Титульная", "ДАТА_ПОДПИСИ"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаИННКПП(Истина, Титульная, ТаблицаОшибок);
	Если Не ЗначениеЗаполнено(Титульная.ПРИЗНАК_НП_ПОДВАЛ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак подписанта", "Титульная", "ПРИЗНАК_НП_ПОДВАЛ"));
	ИначеЕсли Не (Титульная.ПРИЗНАК_НП_ПОДВАЛ = "1" Или Титульная.ПРИЗНАК_НП_ПОДВАЛ = "2") Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Неправильно указан признак подписанта", "Титульная", "ПРИЗНАК_НП_ПОДВАЛ"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаПодписантаНалоговойОтчетности(Данные, ТаблицаОшибок, "Титульная", Истина);
	Если Не ЗначениеЗаполнено(Титульная.Долж) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана должность подписанта", "Титульная", "Долж"));
	КонецЕсли;
	
	Если Титульная.ПРИЗНАК_НП_ПОДВАЛ = "2" И Не ЗначениеЗаполнено(Титульная.НаимДок) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан документ подписанта", "Титульная", "НаимДок"));
	КонецЕсли;
	
	Лист002 = Данные.ДанныеУведомления.Лист002;
	
	Если Лист002.УчКГН <> "1" И Лист002.УчКГН <> "2" Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Неправильно указан признак (Участник консолидированной группы налогоплательщиков)", "Лист002", "УчКГН"));
	КонецЕсли;
	Если Лист002.РИВ <> "1" И Лист002.РИВ <> "2" Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Неправильно указан признак (Регламент информационного взаимодействия)", "Лист002", "РИВ"));
	КонецЕсли;
	Если Лист002.УчПол <> "1" И Лист002.УчПол <> "2" Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Неправильно указан признак (Учетная политика)", "Лист002", "УчПол"));
	КонецЕсли;
	Если Лист002.ИнфУч <> "1" И Лист002.ИнфУч <> "2" Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Неправильно указан признак (Информация об организациях)", "Лист002", "ИнфУч"));
	КонецЕсли;
	Если Лист002.СВК <> "1" И Лист002.СВК <> "2" Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Неправильно указан признак (Внутренние документы)", "Лист002", "СВК"));
	КонецЕсли;
	
	
	ПроверятьИтог = Ложь;
	
	Если ЗначениеЗаполнено(Лист002.СумНалГод) Или ЗначениеЗаполнено(Лист002.СумНалИт) Тогда 
		ПроверятьИтог = Истина;
	Иначе
		Для Каждого Стр Из Данные.ДанныеДопСтрокБД.МнгСтр Цикл 
			Для Каждого Кол Из Данные.ДанныеДопСтрокБД.МнгСтр.Колонки Цикл 
				Если Кол.Имя <> "УИД" И ЗначениеЗаполнено(Стр[Кол.Имя]) Тогда 
					ПроверятьИтог = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если ПроверятьИтог Тогда 
		УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаГода(Лист002, ТаблицаОшибок, "Лист002", "СумНалГод", Истина);
		
		Инд = 0;
		Для Каждого Стр Из Данные.ДанныеДопСтрокБД.МнгСтр Цикл
			Инд = Инд + 1;
			Если Не ЗначениеЗаполнено(Стр.КНД) 
				Или СтрДлина(СокрЛП(Стр.КНД)) <> 7 
				Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Стр.КНД) Тогда 
				
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан / неправильно указан КНД", "Лист002", "КНД___" + Формат(Инд, "ЧГ=")));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Стр.КодНО) 
				Или СтрДлина(СокрЛП(Стр.КодНО)) <> 4 
				Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Стр.КодНО) Тогда 
				
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан / неправильно указан код налогового органа", "Лист002", "КодНО___" + Формат(Инд, "ЧГ=")));
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Стр.КБК) 
				Или СтрДлина(СокрЛП(Стр.КБК)) <> 20 Тогда 
				
				ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
					"Не указан / неправильно указан КБК", "Лист002", "КБК___" + Формат(Инд, "ЧГ=")));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	УведомлениеОСпецрежимахНалогообложения.ПроверкаДатВУведомлении(Данные, ТаблицаОшибок);
	
	Возврат ТаблицаОшибок;
КонецФункции

Функция ОсновныеСведенияЭлектронногоПредставления(Объект, УникальныйИдентификатор)
	ОсновныеСведения = Документы.УведомлениеОСпецрежимахНалогообложения.НачальнаяИнициализацияОбщихРеквизитовВыгрузки(Объект);
	ИдентификаторФайла = ИдентификаторФайлаЭлектронногоПредставления(ОсновныеСведения);
	ОсновныеСведения.Вставить("ИдФайл", ИдентификаторФайла);
	Возврат ОсновныеСведения;
КонецФункции

Функция ЭлектронноеПредставление_Форма2021_1(Объект, УникальныйИдентификатор)
	СведенияЭлектронногоПредставления = УведомлениеОСпецрежимахНалогообложения.СведенияЭлектронногоПредставления();
	ДанныеУведомления = УведомлениеОСпецрежимахНалогообложения.ДанныеУведомленияДляВыгрузки(Объект);
	Ошибки = ПроверитьДокументСВыводомВТаблицу_Форма2021_1(Объект, ДанныеУведомления, УникальныйИдентификатор);
	УведомлениеОСпецрежимахНалогообложения.СообщитьОшибкиПриПроверкеВыгрузки(Объект, Ошибки, ДанныеУведомления);
	
	ОсновныеСведения = ОсновныеСведенияЭлектронногоПредставления(Объект, УникальныйИдентификатор);
	СтруктураВыгрузки = Документы.УведомлениеОСпецрежимахНалогообложения.ИзвлечьСтруктуруXMLУведомления(Объект.ИмяОтчета, "СхемаВыгрузкиФорма2021_1");
	УведомлениеОСпецрежимахНалогообложения.ТиповоеЗаполнениеДанными(ДанныеУведомления, ОсновныеСведения, СтруктураВыгрузки);
	УведомлениеОСпецрежимахНалогообложения.ВыгрузитьДеревоВТаблицу(СтруктураВыгрузки, ОсновныеСведения, СведенияЭлектронногоПредставления);
	Возврат СведенияЭлектронногоПредставления;
КонецФункции

Функция СформироватьМакет(Объект, ИмяФормы) Экспорт
	ОбщегоНазначения.СообщитьПользователю("Печать отчета не предусмотрена");
	Возврат Новый ТабличныйДокумент;
КонецФункции

Функция СформироватьСписокЛистовФорма2021(Объект) Экспорт
	Листы = Новый СписокЗначений;
	ПечатнаяФорма = УведомлениеОСпецрежимахНалогообложения.НовыйПустойЛист();
	МакетПФ = УведомлениеОСпецрежимахНалогообложения.ПолучитьМакетТабличногоДокумента(Новый Структура("Объект", Объект), "ПечатныйБланк_2021");
	Заголовок = МакетПФ.ПолучитьОбласть("Заголовок");
	Строка = МакетПФ.ПолучитьОбласть("Строка");
	СтрокаИтого = МакетПФ.ПолучитьОбласть("СтрокаИтого");
	Подвал = МакетПФ.ПолучитьОбласть("Подвал");

	ДанныеУведомления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеУведомления").Получить();
	Титульная = ДанныеУведомления.ДанныеУведомления.Титульная;
	Лист002 = ДанныеУведомления.ДанныеУведомления.Лист002;
	ДопСтроки = ДанныеУведомления.ДанныеДопСтрокБД.МнгСтр;
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.ИНН, "ИНН", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КПП, "КПП", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КодНО, "КодНО", Заголовок.Области, "-");
	
	Заголовок.Параметры.Наименование = Титульная.Наименование;
	Заголовок.Области["Текст1"].Текст = Символы.Таб + "Прошу провести в соответствии со статьей 10529 Налогового" 
			+ " кодекса Российской Федерации (далее – Кодекс) за " + Титульная.ГодНМ + " год налоговый мониторинг по " 
			+ "вопросам <2> правильности исчисления (удержания), полноты и своевременности уплаты (перечисления) налогов," 
			+ " сборов, страховых взносов, обязанность по уплате (перечислению) которых в соответствии с Кодексом возложена на:";
	Заголовок.Области["Текст2"].Текст = Символы.Таб + "Подтверждаю соответствие условиям, установленным пунктом 3" 
			+ " статьи 105.26 Кодекса<4> , в том числе:" + Символы.ПС + Символы.Таб + "1) совокупная сумма налогов, сборов, страховых" 
			+ " взносов, подлежащая уплате<5> за " + Титульная.ГодНМ + " г.:";
			
	Заголовок.Области["УчКГНДа"].Текст = ?(Лист002.УчКГН = "1", "V", "");
	Заголовок.Области["УчКГННет"].Текст = ?(Лист002.УчКГН = "2", "V", "");
	ПечатнаяФорма.Вывести(Заголовок);
	
	НомПП = 0;
	Для Каждого Стр Из ДопСтроки Цикл 
		НомПП = НомПП + 1;
		ЗаполнитьЗначенияСвойств(Строка.Параметры, Стр);
		Строка.Параметры.НомПП = НомПП;
		ПечатнаяФорма.Вывести(Строка);
	КонецЦикла;
	СтрокаИтого.Параметры.СумНалИт = Лист002.СумНалИт;
	СтрокаИтого.Области["Текст3"].Текст = Символы.Таб + "2) суммарный объем полученных доходов по данным годовой" 
			+ " бухгалтерской (финансовой) отчетности за " + Лист002.СумНалГод 
			+ " год в размере " + Лист002.СумДох + " тысяч рублей;" + Символы.ПС + Символы.Таб 
			+ "3) совокупную стоимость активов по данным бухгалтерской (финансовой) отчетности" 
			+ " по состоянию на 31 декабря " + Лист002.СумНалГод 
			+ " года в размере " + Лист002.СумАкт + " тысяч рублей.";
	ПечатнаяФорма.Вывести(СтрокаИтого);
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 1, Ложь);
	
	Подвал.Параметры.Должность = Титульная.Долж;
	Подвал.Параметры.Документ = Титульная.НаимДок;
	Подвал.Параметры.Дата = Формат(Титульная.ДАТА_ПОДПИСИ, "ДЛФ=DD");
	ПечатнаяФорма.Вывести(Подвал);
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 2, Ложь);
	Возврат Листы;
КонецФункции

Функция СформироватьСписокЛистовФормаФорма2020(Объект) Экспорт
	СписокИспользуемыхМакетов = УведомлениеОСпецрежимахНалогообложения.ЗагрузитьМакетыИзАрхива(Объект, , "ТабличныеДокументы");
	Листы = Новый СписокЗначений;
	СохраненныеДанные = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеУведомления").Получить();
	
	ПечатнаяФорма = УведомлениеОСпецрежимахНалогообложения.НовыйПустойЛист();
	ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "Титульная"));
	УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, СохраненныеДанные.ДанныеУведомления.Титульная);
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 1);
	
	Лист002 = УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "Лист002");
	ПечатнаяФорма.Вывести(Лист002.ПолучитьОбласть("ОсновнаяЧасть"));
	УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, СохраненныеДанные.ДанныеУведомления.Лист002);
	
	ПечатнаяФорма.Вывести(Лист002.ПолучитьОбласть("Header_МнгСтр"));
	Для Каждого Стр Из СохраненныеДанные.ДанныеДопСтрокБД["МнгСтр"] Цикл 
		ТабДокСтр = Лист002.ПолучитьОбласть("Str_МнгСтр");
		УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(
			ТабДокСтр, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Стр));
		ПечатнаяФорма.Вывести(ТабДокСтр);
	КонецЦикла;
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 2);
	
	Возврат Листы;
КонецФункции

