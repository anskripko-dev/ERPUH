Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
КонецПроцедуры

// Климов Антон 10.11.2022 Выполнение задач №000043309
Функция ДобавитьКомандуОтчета(КомандыОтчетов, КлючВарианта = "") Экспорт
	
	Результат = Неопределено;
	КомандаОтчет 				= КомандыОтчетов.Добавить();
	КомандаОтчет.Менеджер 		= Метаданные.Отчеты.тн_БухгалтерскаяСправкаПоНачислениюПроцентов.ПолноеИмя();
	Если ЗначениеЗаполнено(КлючВарианта) Тогда
		КомандаОтчет.КлючВарианта = КлючВарианта;
	КонецЕсли;

	Если ЗначениеЗаполнено(КлючВарианта) И КлючВарианта = "БухСправкаПоНачислениюПроцентов" Тогда
		КомандаОтчет.Представление 	= НСтр("ru = 'Бухгалтерская справка по начислению процентов'");
	КонецЕсли;                                                              
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.ДоговорыКредитовИДепозитов")); 
	МассивТипов.Добавить(Тип("ДокументСсылка.НачисленияКредитовИДепозитов"));
	КомандаОтчет.ТипПараметра			= Новый ОписаниеТипов(МассивТипов);
	КомандаОтчет.МножественныйВыбор 	= Ложь;
	КомандаОтчет.Важность 				= "Обычное";
	КомандаОтчет.ИмяПараметраФормы 		= "Отбор.Источник";
	мУсловияВидимости = Новый Массив;
	мУсловияВидимости.Добавить(Справочники.ВидыДоговоровКонтрагентовУХ.ЗаемВыданный);
	мУсловияВидимости.Добавить(Справочники.ВидыДоговоровКонтрагентовУХ.ЗаемПолученный);
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаОтчет, "ВидДоговораУХ", мУсловияВидимости,ВидСравненияКомпоновкиДанных.ВСписке);
	Результат = КомандаОтчет;
	
	Возврат Результат;
	
КонецФункции

