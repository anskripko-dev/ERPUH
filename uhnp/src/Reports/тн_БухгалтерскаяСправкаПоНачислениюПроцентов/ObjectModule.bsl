// Климов Антон 10.11.2022 Выполнение задач №000043309
// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
// Форма - УправляемаяФорма, Неопределено - Форма отчета или форма настроек отчета.
// Неопределено когда вызов без контекста.
// КлючВарианта - Строка, Неопределено - Имя предопределенного
// или уникальный идентификатор пользовательского варианта отчета.
// Неопределено когда вызов без контекста.
// Настройки - Структура - см. возвращаемое значение
// ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт  
	Настройки.События.ПередЗаполнениемПанелиБыстрыхНастроек = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Климов Антон 10.11.2022 Выполнение задач №000043309
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;

	ТД = Новый ТабличныйДокумент;

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных ,Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	МаксНомСтр = ДокументРезультат.ВысотаТаблицы;
	
	Если МаксНомСтр = 0 Тогда        
		ОбластьЯчейкаТД = ДокументРезультат.ПолучитьОбласть("R1C1");
		ТекстСообщения = НСтр("ru='Пустая справка.'");
		ОбластьЯчейкаТД.Область("R1C1").Текст = ТекстСообщения;
		ОбластьЯчейкаТД.Область("R1C1").Шрифт = Новый Шрифт(,12,,Истина);
		ДокументРезультат.Вывести(ОбластьЯчейкаТД);
		Возврат;	
	КонецЕсли;
	
	Разделитель = ДокументРезультат.ПолучитьОбласть("R"+Формат(МаксНомСтр, "ЧГ=0")+"C1");
	ОбластьРазделитель = Разделитель.Область("R1");
	
	НомСтр = 1;
	Пока НомСтр<=МаксНомСтр Цикл
		ТекстЯч = ДокументРезультат.Область("R"+Формат(НомСтр,"ЧГ=0")+"C1").Текст;
		Если ТекстЯч = "Разделить" Тогда
			ТекОбласть = ДокументРезультат.Область("R"+Формат(НомСтр,"ЧГ=0")+"C1");
			ДокументРезультат.ВставитьОбласть(ОбластьРазделитель,ТекОбласть,ТипСмещенияТабличногоДокумента.БезСмещения);
		КонецЕсли;
		НомСтр = НомСтр+1;
	КонецЦикла;  
	ОбластьУдаления = ДокументРезультат.Область("R"+Формат(НомСтр-1,"ЧГ=0")+":R"+Формат(НомСтр,"ЧГ=0"));
	ДокументРезультат.УдалитьОбласть(ОбластьУдаления);
	
КонецПроцедуры

// Климов Антон 10.11.2022 Выполнение задач №000043309
Процедура ПередЗаполнениемПанелиБыстрыхНастроек(Форма, ПараметрыЗаполнения) Экспорт
	// Устанавливаем отбор
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Для Каждого ЭлОтб Из Настройки.Отбор.Элементы Цикл
		Если ЭлОтб.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Источник") Тогда
			Источник = ЭлОтб.ПравоеЗначение;
			Если ТипЗнч(Источник) = Тип("ДокументСсылка.НачисленияКредитовИДепозитов") Тогда
				ТекущаяДата = Источник.Дата;
				МассивДоговоров = ПолучитьДоговорыДокументаНачисления(Источник);
			ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
				ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
				Если ТекущаяДата > Источник.ВерсияСоглашения.ДатаОкончанияДействия Тогда
					ТекущаяДата = Источник.ВерсияСоглашения.ДатаНачалаДействия;
				КонецЕсли;
				МассивДоговоров = Новый Массив;
				МассивДоговоров.Добавить(Источник);
			КонецЕсли;           
			ЭлОтб.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлОтб.ПравоеЗначение = МассивДоговоров;
			ЭлОтб.Использование = Истина;
		КонецЕсли;
	КонецЦикла;                          

	// Устанавливаем параметры
	ЗначениеПараметраТекущаяДата = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекущаяДата"));
	Если ЗначениеПараметраТекущаяДата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИдТекущаяДата = ЗначениеПараметраТекущаяДата.ИдентификаторПользовательскойНастройки;
	ЗначениеПараметраПНТекущаяДата = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдТекущаяДата);
	Если ЗначениеПараметраПНТекущаяДата = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата);
	ЗначениеПараметраПНТекущаяДата.Значение = ТекущаяДата;

	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Календарь", Справочники.Календари.НайтиПоНаименованию("Российская федерация"));
	
КонецПроцедуры

// Климов Антон 10.11.2022 Выполнение задач №000043309
Функция ПолучитьДоговорыДокументаНачисления(ДокументСсылка)

	ТаблицаДоговоров = ДокументСсылка.Начисления.Выгрузить(,"Договор");
	ТаблицаДоговоров.Свернуть("Договор");
	МассивДоговоров = ТаблицаДоговоров.ВыгрузитьКолонку("Договор");
	Возврат МассивДоговоров;

КонецФункции

#КонецОбласти

#КонецЕсли
