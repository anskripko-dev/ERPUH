#Область ПрограммныйИнтерфейс

// Возвращает строковое представление позиции заказа давальца.
//
// Параметры:
//	Номенклатура       - СправочникСсылка.Номенклатура - продукция
//	Характеристика     - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика продукции
//	Заказ              - ДокументСсылка - заказ давальца.
//
// Возвращаемое значение:
//	Строка - представление позиции заказа.
//
Функция ПредставлениеПродукции(Номенклатура, Характеристика, Заказ) Экспорт
	
	Результат = НСтр("ru = '%1, %2';
					|en = '%1, %2'");
	
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		Результат,
		НоменклатураКлиентСервер.ПредставлениеНоменклатуры(Номенклатура, Характеристика),
		Заказ);
	
	Возврат Результат;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// Задает расширенные настройки отчета
//
// Параметры:
//   Настройки - см. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.Настройки.
//
Процедура НастроитьВариантыОтчета(Настройки) Экспорт
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.РасшифровкаСтоимостиПереработки);
	ОписаниеОтчета.ОпределитьНастройкиФормы = Истина;
	ВариантыОтчетовУТПереопределяемый.ОтключитьОтчет(ОписаниеОтчета);
	
КонецПроцедуры

