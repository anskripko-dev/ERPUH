
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтоВнешнийПользователь = ПользователиСлужебныйПовтИсп.ЭтоСеансВнешнегоПользователя();
	
	Если ЭтоВнешнийПользователь Тогда
		ТекущийПользователь = Пользователи.АвторизованныйПользователь();
		АнкетаПоставщика = АккредитацияПоставщиковУХ.ПолучитьАнектуПоставщикаВнешнегоПользователя(ТекущийПользователь);
		Если НЕ ЗначениеЗаполнено(АнкетаПоставщика) Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Внешнему пользователю должна быть назначена анекта поставщика!'");
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		Параметры.Отбор.Вставить("АнкетаПоставщика", АнкетаПоставщика);
	Иначе
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
									Параметры.Отбор, "АнкетаПоставщика") Тогда
			АнкетаПоставщика = Параметры.Отбор.АнкетаПоставщика;
		Иначе
			АнкетаПоставщика = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АнкетаПоставщика)
				И НЕ ЗначениеЗаполнено(АнкетаПоставщика.Контрагент) Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Внешнему пользователю должн быть назначен контрагент!'");
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
	Параметры.СформироватьПриОткрытии = Истина;
КонецПроцедуры
