
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ПараметрПериод = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение; // СтандартныйПериод
	Если ТипЗнч(ПараметрПериод) = Тип("СтандартнаяДатаНачала") Тогда
		ДатаОтчета = ПараметрПериод.Дата;
	Иначе
		ДатаОтчета = ПараметрПериод;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаОтчета) Тогда
		ПараметрПериод = КонецДня(ДатаОтчета);
		ПараметрПериодРБ = Новый Граница(ПараметрПериод, ВидГраницы.Включая); 
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ПараметрПериод);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПериодРБ", ПараметрПериодРБ);
	КонецЕсли;
	
КонецПроцедуры
