Функция ПолучитьИдентификаторЗапросаДанныхСервер()
	
	Возврат Обработки.тн_АвтосверкаПоКлючевымПолям.ПолучитьИдентификаторЗапросаДанных();
	
КонецФункции

Процедура СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура)
	
	Если ПараметрыСтруктура.ПоДокументам Тогда
		ОбработкаОбъект.СообщениеЗапросERP_В_ОКС_ПоДокументам = ОбработкаОбъект.СформироватьТекстСообщенияЗапросДанных(ПараметрыСтруктура);
	Иначе
		ОбработкаОбъект.СообщениеЗапросERP_В_ОКС = ОбработкаОбъект.СформироватьТекстСообщенияЗапросДанных(ПараметрыСтруктура);
	КонецЕсли;
	
	ОбработкаОбъект.ЭтоОтладка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыСтруктура, "ЭтоОтладка", Ложь);
	
КонецПроцедуры    
  
 Процедура ОбработатьРезультатВыполнения(СтруктураРезультат, ДокументРезультат)
		
	ОбработкаОбъект.СообщениеОтветERP_От_ОКС = СтруктураРезультат.Результат;
	ОбработкаОбъект.ПоДокументам = СтруктураРезультат.ПоДокументам;
		
	СтруктураОбработка = ОбработкаОбъект.СформироватьСтруктуруОбработкаОтветаНаЗапрос(ДокументРезультат);
	СтруктураРезультат.Вставить("ТребуетсяДетализация", СтруктураОбработка.ТребуетсяДетализация);
	Если СтруктураОбработка.ТребуетсяДетализация = Истина Тогда
		ОбработкаОбъект.СтруктураСообщенияСверкаПоОстаткам = ЗначениеВСтрокуВнутр(СтруктураОбработка);
	КонецЕсли;
	
КонецПроцедуры	

