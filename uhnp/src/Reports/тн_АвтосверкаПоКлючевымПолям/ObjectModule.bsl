Процедура СформироватьРезультат(ДокументРезультат = Неопределено) Экспорт
	
	//1. Формируем и отправляем сообщение-запрос
	ИдентификаторЗапроса = ПолучитьИдентификаторЗапросаДанныхСервер();
	
	ПараметрыСтруктура = Новый Структура();
	ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	ПараметрыСтруктура.Вставить("ИдентификаторФормы", Строка(УникальныйИдентификатор));
	ПараметрыСтруктура.Вставить("ПоДокументам", Ложь);
	ПараметрыСтруктура.Вставить("ОтправкаЗапроса", Истина);
	ПараметрыСтруктура.Вставить("КомпоновщикНастроек", КомпоновщикНастроек);
	
	ЗаполнитьЗначенияСвойств(ОбработкаОбъект, ЭтотОбъект);  
	ОбработкаОбъект.ИзОтчета = Истина;

	СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура);
	
	Если ОбработкаОбъект.ОтправитьСообщениеЗапрос() Тогда
		
		ОбработкаОбъект.ДобавитьЗаписьДанныеАвтосверка(ПараметрыСтруктура);

		//2. Ожидаем ответа
		ПараметрыВыполнения = Новый Структура;
		ПараметрыВыполнения.Вставить("НормативноеВремяОжиданияОтветаСекунд", ОбработкаОбъект.НормативноеВремяОжиданияОтветаСекунд);
		ПараметрыВыполнения.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура.ИдентификаторЗапроса);
		ПараметрыВыполнения.Вставить("ПоДокументам", ПараметрыСтруктура.ПоДокументам);		
		// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
		ПараметрыВыполнения.Вставить("КлючМаршрутизации", ОбработкаОбъект.КлючМаршрутизации);
		// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911
		
		Результат = Отчеты.тн_АвтосверкаПоКлючевымПолям.ПолучитьСтруктуруРезультат(ПараметрыВыполнения);
	    ПриЗавершенииОбработкиОтветногоСообщения(Результат, ДокументРезультат);	
		
	КонецЕсли;	

КонецПроцедуры  

Процедура ПриЗавершенииОбработкиОтветногоСообщения(Результат, ДокументРезультат = Неопределено) Экспорт
	
	//1. Отменено пользователем
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//2. Возникла ошибка
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;	
	КонецЕсли;
	
	ЗаданиеВыполнено = (Результат.Статус = "Выполнено");
	
	//3. Обрабатываем результат
	Если ЗаданиеВыполнено Тогда
		ОбработатьРезультатВыполнения(Результат, ДокументРезультат);
	КонецЕсли;
	
	//4. Анализируем требуется ли детализация по документам
	Если Результат.ТребуетсяДетализация = Истина Тогда
		ПараметрыСтруктура = Новый Структура();
		ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
		ПараметрыСтруктура.Вставить("ИдентификаторФормы", Строка(УникальныйИдентификатор));
		ПараметрыСтруктура.Вставить("ПоДокументам", Истина);
		ПараметрыСтруктура.Вставить("ОтправкаЗапроса", Истина);
		
		СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура);
		
		Если ОтправитьСообщениеЗапрос() Тогда
			
			ОбработкаОбъект.ДобавитьЗаписьДанныеАвтосверка(ПараметрыСтруктура);
			
			ПараметрыВыполнения = Новый Структура;
			ПараметрыВыполнения.Вставить("НормативноеВремяОжиданияОтветаСекунд", ОбработкаОбъект.НормативноеВремяОжиданияОтветаСекунд);
			ПараметрыВыполнения.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура.ИдентификаторЗапроса);
			ПараметрыВыполнения.Вставить("ПоДокументам", ПараметрыСтруктура.ПоДокументам);  
			// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
			ПараметрыВыполнения.Вставить("КлючМаршрутизации", ОбработкаОбъект.КлючМаршрутизации);
			// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911
			Результат =	Отчеты.тн_АвтосверкаПоКлючевымПолям.ПолучитьСтруктуруРезультат(ПараметрыВыполнения);
			ПриЗавершенииОбработкиОтветногоСообщения(Результат, ДокументРезультат);		
			
		КонецЕсли;	
	КонецЕсли;	
		
КонецПроцедуры

