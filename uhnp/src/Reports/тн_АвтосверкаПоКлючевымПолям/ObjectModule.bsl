	НС.СтатьяДоходов = СформироватьНаименованиеКолонки(НС, "НастройкиКомпоновки_ПД_СтатьяДоходов");
	НС.Пользователь = СформироватьНаименованиеКолонки(НС, "НастройкиКомпоновки_ПД_Пользователь");		
	НС.Подразделение = СформироватьНаименованиеКолонки(НС, "НастройкиКомпоновки_ПД_Подразделение");   
	
