#Область Формирование_И_ОбработкаСообщений

Функция ОтправитьСообщениеЗапрос() Экспорт
	
	Если ОбработкаОбъект.ПоДокументам Тогда
		ТекстЗапроса = ОбработкаОбъект.СообщениеЗапросERP_В_ОКС_ПоДокументам;
	Иначе	
		ТекстЗапроса = ОбработкаОбъект.СообщениеЗапросERP_В_ОКС;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстЗапроса);
	
	ПараметрыОтправки = Новый Структура();
			
	// - транспорт (RabbitMQ)
	ПараметрыОтправки.Вставить("Профиль"			, Справочники.тн_ПрофилиПодключений.ERP_УХ);
	ПараметрыОтправки.Вставить("ФорматСообщения"	, "JSON");
	ПараметрыОтправки.Вставить("ТочкаОбменаRabbitMQ", Справочники.ТочкиОбменаRMQ.ТекущаяБаза);
	// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
	//ПараметрыОтправки.Вставить("КлючМаршрутизации"	, XMLСтрока(Справочники.тн_ПроизводственныеПодразделения.ОКС_Сбыт));
	ПараметрыОтправки.Вставить("КлючМаршрутизации"	, XMLСтрока(ОбработкаОбъект.КлючМаршрутизации));
	// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911	
	ПараметрыОтправки.Вставить("ИмяПакетаXDTO"		,"tn_integrationERP");
	// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
	//ПараметрыОтправки.Вставить("УзелПланаОбмена"	, тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_ОКС());
	ПараметрыОтправки.Вставить("УзелПланаОбмена"	, тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбменаПоКлючуМаршрутизации(ОбработкаОбъект.КлючМаршрутизации));
	// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911
	
	// - логирование
	ПараметрыОтправки.Вставить("Лог_ВидСообщения"	, Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена);
	ПараметрыОтправки.Вставить("Лог_ВидИнтеграции"	, Перечисления.тн_ВидыИнтеграций.ERP_УХ_Отправка);	ПараметрыОтправки.Вставить("КонтейнерXDTO", ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON));
	
	ОбщегоНазначения.ОбщийМодуль("тн_Интеграция_УПП").ОтправитьПакет(ТекстЗапроса, ПараметрыОтправки, "dataVerificationRequest");
	Возврат Истина;
	
КонецФункции

#КонецОбласти //Формирование_И_ОбработкаСообщений

