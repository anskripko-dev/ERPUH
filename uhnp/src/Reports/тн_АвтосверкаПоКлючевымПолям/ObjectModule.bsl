#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ИдентификаторЗапроса;    
Перем УникальныйИдентификатор;
Перем ОбработкаОбъект;

#Область Работа_С_Компоновкой_Данных
 
Функция ПолучитьАдресНастроекКомпоновкиКолонки(ИмяКолонки)
	
	СтрокаАдресСКД = ПолучитьURL_СКД_КолонкиНастроек(ИмяКолонки);
	КомпоновщикНастроекНовый = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроекНовый.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СтрокаАдресСКД));
	НастройкиКомпоновщикаНовые = КомпоновщикНастроекНовый.ПолучитьНастройки();
	Возврат ПоместитьВоВременноеХранилище(НастройкиКомпоновщикаНовые, Новый УникальныйИдентификатор());
	
КонецФункции

Функция СформироватьНаименованиеКолонки(ДанныеСтроки, ИмяКолонки)
	
	ИмяКолонкиСКД = ПолучитьИмяКолонкиДляСКД(ИмяКолонки);
	Возврат СтрШаблон("<%1 %2>", ИмяКолонкиСКД, ДанныеСтроки.НомерСтроки);
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;    
	
	ОбработкаОбъект = Обработки.тн_АвтосверкаПоКлючевымПолям.Создать();	

	ЗаполнитьНастройкиКомпоновки();  
	
	Если Не (ОбработкаОбъект.Активно_ОТН 
		Или ОбработкаОбъект.Активно_ВРЧ 
		Или ОбработкаОбъект.Активно_ЗТР 
		Или ОбработкаОбъект.Активно_ДС 
		//НАЧАЛО Блинова М.А. 09.04.2024 Выполнение задач №000048144  
		Или ОбработкаОбъект.Активно_ВРЧ_отб 
		Или ОбработкаОбъект.Активно_ЗТР_отб 
		//КОНЕЦ Блинова М.А. 09.04.2024 Выполнение задач №000048144
		// НАЧАЛО Егоров Петр 27.02.2024 Выполнение задач №000048625
		// НАЧАЛО Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
		//Или ОбработкаОбъект.Активно_ПД 
		// КОНЕЦ  Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
		// КОНЕЦ  Егоров Петр 27.02.2024 Выполнение задач №000048625  
		// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341   
		Или ОбработкаОбъект.Активно_ПД
		Или ОбработкаОбъект.Активно_РСК  
		Или ОбработкаОбъект.Активно_ОТН_отб 
		// КОНЕЦ Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341
		) Тогда   
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для формирования должен быть выбран хотя бы один из разделов!");		
		Возврат;
	КонецЕсли;  
	
	 СформироватьРезультат(ДокументРезультат);
	
КонецПроцедуры  

Процедура ЗаполнитьНастройкиКомпоновки() 
	
	ПервоначальныеНастройки = КомпоновщикНастроек.ПолучитьНастройки();	
	
	ЗаполнитьНастройкиСКД_ЗапросДанных();
	ЗаполнитьСоответствиеКолонокИ_МакетовСКД();
	ЗаполнитьНеСохраняемыеНастройки();
	
	КомпоновшикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновшикМакета.Выполнить(СхемаКомпоновкиДанных, ПервоначальныеНастройки);
	
	Для Каждого СтрПарам из МакетКомпоновки.ЗначенияПараметров Цикл
		Если СтрПарам.Имя = "Период" Тогда 
			
			П =	СтрПарам.Значение; 
			Если П.ДатаОкончания = Дата(1,1,1) Тогда  
				// НАЧАЛО Егоров Петр 27.02.2024 Выполнение задач №000048625
				// НАЧАЛО Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
				//ОбработкаОбъект.ДатаСверкиКон_ПД = Дата(3999,12,31);
				// КОНЕЦ  Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
				// КОНЕЦ  Егоров Петр 27.02.2024 Выполнение задач №000048625  
				// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341  
				//ОбработкаОбъект.ДатаСверкиКон_ОТН = Дата(3999,12,31); 
				ОбработкаОбъект.ДатаСверкиКон_ОТН_отб = Дата(3999,12,31);   
				// КОНЕЦ Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341
				//НАЧАЛО Блинова М.А. 09.04.2024 Выполнение задач №000048144
				//ОбработкаОбъект.ДатаСверкиКон_ВРЧ = Дата(3999,12,31);
				//ОбработкаОбъект.ДатаСверкиКон_ЗТР = Дата(3999,12,31);   
				ОбработкаОбъект.ДатаСверкиКон_ВРЧ_отб = Дата(3999,12,31);
				ОбработкаОбъект.ДатаСверкиКон_ЗТР_отб = Дата(3999,12,31);
                //КОНЕЦ Блинова М.А. 09.04.2024 Выполнение задач №000048144
				ОбработкаОбъект.ДатаСверкиКон_ДС = Дата(3999,12,31); 
				// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341  
				ОбработкаОбъект.ДатаСверкиКон_ПД = Дата(3999,12,31);
				ОбработкаОбъект.ДатаСверкиКон_РСК = Дата(3999,12,31);
				// КОНЕЦ Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341
			Иначе
				// НАЧАЛО Егоров Петр 27.02.2024 Выполнение задач №000048625
				// НАЧАЛО Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
				//ОбработкаОбъект.ДатаСверкиКон_ПД = П.ДатаОкончания; 
				// КОНЕЦ  Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
				// КОНЕЦ  Егоров Петр 27.02.2024 Выполнение задач №000048625   
				// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341  
				//ОбработкаОбъект.ДатаСверкиКон_ОТН = П.ДатаОкончания;
                ОбработкаОбъект.ДатаСверкиКон_ОТН_отб = П.ДатаОкончания; 
				// КОНЕЦ Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341
				//НАЧАЛО Блинова М.А. 09.04.2024 Выполнение задач №000048144
				//ОбработкаОбъект.ДатаСверкиКон_ВРЧ = П.ДатаОкончания;
				//ОбработкаОбъект.ДатаСверкиКон_ЗТР = П.ДатаОкончания; 
				ОбработкаОбъект.ДатаСверкиКон_ВРЧ_отб = П.ДатаОкончания;
				ОбработкаОбъект.ДатаСверкиКон_ЗТР_отб = П.ДатаОкончания;
				//КОНЕЦ Блинова М.А. 09.04.2024 Выполнение задач №000048144
				ОбработкаОбъект.ДатаСверкиКон_ДС = П.ДатаОкончания;
				// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341  
				ОбработкаОбъект.ДатаСверкиКон_ПД = П.ДатаОкончания;
				ОбработкаОбъект.ДатаСверкиКон_РСК = П.ДатаОкончания;
				// КОНЕЦ Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341
			КонецЕсли;  
			// НАЧАЛО Егоров Петр 27.02.2024 Выполнение задач №000048625
			// НАЧАЛО Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
