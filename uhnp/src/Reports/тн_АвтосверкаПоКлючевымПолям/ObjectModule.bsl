			ОбработкаОбъект.ДатаСверкиНач_ЗТР_отб = П.ДатаНачала;
            //КОНЕЦ Блинова М.А. 09.04.2024 Выполнение задач №000048144
			ОбработкаОбъект.ДатаСверкиНач_ДС = П.ДатаНачала;    
			// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341  
			ОбработкаОбъект.ДатаСверкиНач_ПД = П.ДатаНачала;
			ОбработкаОбъект.ДатаСверкиНач_РСК = П.ДатаНачала;
			// КОНЕЦ Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341
							
		ИначеЕсли (СтрПарам.Имя = "ОТН"  			
			Или СтрПарам.Имя = "ВРЧ"
			Или СтрПарам.Имя = "ЗТР"
			Или СтрПарам.Имя = "ДС" 
			//НАЧАЛО Блинова М.А. 09.04.2024 Выполнение задач №000048144  
			Или СтрПарам.Имя = "ВРЧ_отб"
			Или СтрПарам.Имя = "ЗТР_отб"
			//КОНЕЦ Блинова М.А. 09.04.2024 Выполнение задач №000048144
			// НАЧАЛО Егоров Петр 27.02.2024 Выполнение задач №000048625
			// НАЧАЛО Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
			//Или  СтрПарам.Имя = "ПД" 
			// КОНЕЦ  Гутарова Екатерина 23.06.2023 Выполнение задач №000045946
			// КОНЕЦ  Егоров Петр 27.02.2024 Выполнение задач №000048625
			// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341 
			Или СтрПарам.Имя = "ОТН_отб"
			Или  СтрПарам.Имя = "ПД" 
			Или  СтрПарам.Имя = "РСК" 
			// КОНЕЦ Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341
			) И СтрПарам.Значение Тогда
			
			ОбработкаОбъект["Активно_" + СтрПарам.Имя] = Истина;  
			
		ИначеЕсли СтрПарам.Имя = "НормативноеВремяОжиданияОтветаСекунд" Тогда	
			
			ОбработкаОбъект.НормативноеВремяОжиданияОтветаСекунд = ?(СтрПарам.Значение = 0, 900, СтрПарам.Значение);
			
		// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
		ИначеЕсли СтрПарам.Имя = "КлючМаршрутизации" Тогда
			ОбработкаОбъект.КлючМаршрутизации = ?(ЗначениеЗаполнено(СтрПарам.Значение), СтрПарам.Значение, Справочники.тн_ПроизводственныеПодразделения.ОКС_Сбыт);
		// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911
		КонецЕсли;
	КонецЦикла;
	
	// НАЧАЛО Юдина (Гутарова) Екатерина 25.04.2024 Выполнение задач №000049341  
