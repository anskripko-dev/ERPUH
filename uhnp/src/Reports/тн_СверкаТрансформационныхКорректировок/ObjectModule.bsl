#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровкиОбъект, СтандартнаяОбработка, АдресХранилища)
		
	СтандартнаяОбработка = Ложь;
	
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	ПериодОтчета = НастройкиОтчета.ПараметрыДанных.Элементы.Найти("ПериодОтчета").Значение;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровкиОбъект);
	
	ДанныеОтчета = ДанныеМетаданныхДокументов(ПериодОтчета);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ДанныеОтчета, ДанныеРасшифровкиОбъект, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат); 
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеМетаданныхДокументов(ПериодОтчета)

	МассивТексты = Новый Массив;
	
	Для каждого Документ Из Метаданные.Документы Цикл
		
		ПолноеИмяДокумента = Документ.ПолноеИмя();
		ИмяДокумента       = СтрЗаменить(ПолноеИмяДокумента, "Документ.", "");
		
		Текст = 
			"ВЫБРАТЬ
			|	""" + ИмяДокумента + """ КАК ИмяДокумента,
			|	ТИП(Документ." + ИмяДокумента + ") КАК ТипДокумента,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТаблицаДокумента.Ссылка) КАК КоличествоДокументов
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК ТаблицаДокумента
			|ГДЕ
			|	ТаблицаДокумента.Дата МЕЖДУ &ДатаНач И &ДатаКон
			|	И ТаблицаДокумента.Проведен";
		
		МассивТексты.Добавить(Текст);
		
	КонецЦикла; 
	
	ТекстЗапроса = СтрСоединить(МассивТексты, Разделитель());
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("ДатаНач", ПериодОтчета.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ПериодОтчета.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаМетаданных = РезультатЗапроса.Выгрузить();
	
	Возврат Новый Структура("ТаблицаМетаданных", ТаблицаМетаданных);
	
КонецФункции

Функция Разделитель()

	Возврат "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";	
	
КонецФункции

