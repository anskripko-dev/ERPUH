Процедура ПроверитьТитульная(Данные, ТаблицаОшибок)
	Титульная = Данные.ДанныеУведомления.Титульная;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(Титульная.КодНО, ТаблицаОшибок, "Титульная");
	Если Титульная.Свойство("Наименование") И Не ЗначениеЗаполнено(Титульная.Наименование) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано наименование организации", "Титульная", "Наименование"));
	ИначеЕсли Титульная.Свойство("НаимОрг") И Не ЗначениеЗаполнено(Титульная.НаимОрг) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано наименование организации", "Титульная", "НаимОрг"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.ДАТА_ПОДПИСИ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата формирования документа", "Титульная", "ДАТА_ПОДПИСИ"));
	КонецЕсли;
	
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаИННКПП(Истина, Титульная, ТаблицаОшибок);
	Если Не ЗначениеЗаполнено(Титульная.ПРИЗНАК_НП_ПОДВАЛ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак подписанта", "Титульная", "ПРИЗНАК_НП_ПОДВАЛ"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаПодписантаНалоговойОтчетности(Данные, ТаблицаОшибок, "Титульная", Истина);
	Если Не ЗначениеЗаполнено(Титульная.Долж) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана должность подписанта", "Титульная", "Долж"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Титульная.НаимДокПервичный) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указано имя файла мотивированного мнения налогового органа", "Титульная", "НаимДокПервичный"));
	КонецЕсли;
	
	Если Титульная.ПРИЗНАК_НП_ПОДВАЛ = "2" И Не ЗначениеЗаполнено(Титульная.НаимДок) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан документ подписанта", "Титульная", "НаимДок"));
	КонецЕсли;
	
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаГода(Титульная, ТаблицаОшибок, "Титульная", "ГодНМ", Истина);
КонецПроцедуры

Процедура ПроверитьУведСоглММ_2024(Данные, ТаблицаОшибок)
	УведСоглММ = Данные.ДанныеУведомления.УведСоглММ;
	Если Не ЗначениеЗаполнено(УведСоглММ.НомУвед) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан номер уведомления", "УведСоглММ", "НомУвед"));
	КонецЕсли;
	УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(УведСоглММ.КодНО_ММ, ТаблицаОшибок, "УведСоглММ", "КодНО_ММ");
	Если Не ЗначениеЗаполнено(УведСоглММ.ДатаММ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указана дата мотивированного мнения налогового органа", "УведСоглММ", "ДатаММ"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(УведСоглММ.НомММ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан номер мотивированного мнения налогового органа", "УведСоглММ", "НомММ"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(УведСоглММ.ПризнММ) Тогда 
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не указан признак мотивированного мнения", "УведСоглММ", "ПризнММ"));
	КонецЕсли;
	Если УведСоглММ.ПризнММ = "2" Тогда 
		Если Не ЗначениеЗаполнено(УведСоглММ.ДатаЗапрММ) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указана дата запроса мотивированного мнения налогового органа", "УведСоглММ", "ДатаЗапрММ"));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(УведСоглММ.НомЗапрММ) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан номер запроса мотивированного мнения налогового органа", "УведСоглММ", "НомЗапрММ"));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСвПредНД(Данные, ТаблицаОшибок)
	Для Каждого Элт Из Данные.ДанныеМногостраничныхРазделов.СвПредНД Цикл 
		СвПредНД = Элт.Значение;
		Если Не УведомлениеОСпецрежимахНалогообложенияКлиентСервер.СтраницаЗаполнена(СвПредНД) Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СвПредНД.КНД)
			Или СтрДлина(СвПредНД.КНД) <> 7 
			Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СвПредНД.КНД) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан/неправильно указан КНД", "СвПредНД", "КНД", СвПредНД.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СвПредНД.ДатаПредНД) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указана дата представления налоговой декларации", "СвПредНД", "ДатаПредНД", СвПредНД.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СвПредНД.РегНомНД) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан регистрационный номер налоговой декларации", "СвПредНД", "РегНомНД", СвПредНД.УИД));
		КонецЕсли;
		УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКПП(СвПредНД, ТаблицаОшибок, "СвПредНД", "КПП", Истина);
		УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаКодаНО(СвПредНД.КодНО, ТаблицаОшибок, "СвПредНД", "КодНО", СвПредНД.УИД);
		Если Не ЗначениеЗаполнено(СвПредНД.КБК)
			Или СтрДлина(СвПредНД.КБК) <> 20 Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан / неправильно указан КБК", "СвПредНД", "КБК", СвПредНД.УИД));
		КонецЕсли;
		УведомлениеОСпецрежимахНалогообложенияСлужебный.ПроверкаОКТМО(СвПредНД, ТаблицаОшибок, "СвПредНД", "ОКТМО", Истина);
		Если Не ЗначениеЗаполнено(СвПредНД.ОтчетГод)
			Или СтрДлина(СвПредНД.ОтчетГод) <> 4
			Или Не  СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СвПредНД.ОтчетГод) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан / неправильно указан отчетный год", "СвПредНД", "ОтчетГод", СвПредНД.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СвПредНД.Период)
			Или СтрДлина(СвПредНД.Период) <> 2
			Или Не  СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СвПредНД.Период) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан / неправильно указан отчетный период", "СвПредНД", "Период", СвПредНД.УИД));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СвПредНД.ПризнСум) Тогда 
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"Не указан признак суммы по расчету", "СвПредНД", "ПризнСум", СвПредНД.УИД));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПроверитьДокументСВыводомВТаблицу_Форма2024_1(Данные, УникальныйИдентификатор)
	ТаблицаОшибок = Новый СписокЗначений;
	УведомлениеОСпецрежимахНалогообложения.ПроверкаАктуальностиФормыПриВыгрузке(
		Данные.Объект.ИмяФормы, ТаблицаОшибок, ПолучитьТаблицуФорм());
	
	ПроверитьТитульная(Данные, ТаблицаОшибок);
	ПроверитьУведСоглММ_2024(Данные, ТаблицаОшибок);
	ПроверитьСвПредНД(Данные, ТаблицаОшибок);
	
	УведомлениеОСпецрежимахНалогообложения.ПроверкаДатВУведомлении(Данные, ТаблицаОшибок);
	УведомлениеОСпецрежимахНалогообложения.ПолнаяПроверкаЗаполненныхПоказателейНаСоотвествиеСписку("СпискиВыбора2024_1",
		"СхемаВыгрузкиФорма2024_1", Данные.Объект.ИмяОтчета, ТаблицаОшибок, Данные);
		
	Для Каждого Стр Из Данные.ПриложенныеФайлы.Строки Цикл 
		Если Стр.Строки.Количество() = 0 Тогда
			ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
				"К каждому документу необходимо приложить файлы", "ПриложенныеФайлы", ""));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ТаблицаОшибок;
КонецФункции

Функция ОсновныеСведенияЭлектронногоПредставления_Форма2024_1(Объект, УникальныйИдентификатор)
	ОсновныеСведения = Документы.УведомлениеОСпецрежимахНалогообложения.НачальнаяИнициализацияОбщихРеквизитовВыгрузки(Объект);
	ОсновныеСведения.Вставить("КолФайл", 0);
	
	Данные = Объект.ДанныеУведомления.Получить();
	ИдентификаторФайла = ИдентификаторФайлаЭлектронногоПредставления(ОсновныеСведения);
	ОсновныеСведения.Вставить("ИдФайл", ИдентификаторФайла);
	Для Каждого Стр1 Из Данные.ПриложенныеФайлы.Строки Цикл 
		ОсновныеСведения.КолФайл = ОсновныеСведения.КолФайл + Стр1.Строки.Количество();
	КонецЦикла;
	
	Возврат ОсновныеСведения;
КонецФункции

Функция ЭлектронноеПредставление_Форма2024_1(Объект, УникальныйИдентификатор)
	СписокФайлов = Новый СписокЗначений;
	ИменаФайлов = Новый СписокЗначений;
	СведенияЭлектронногоПредставления = УведомлениеОСпецрежимахНалогообложения.СведенияЭлектронногоПредставления();
	ДанныеУведомления = УведомлениеОСпецрежимахНалогообложения.ДанныеУведомленияДляВыгрузки(Объект);
	Ошибки = ПроверитьДокументСВыводомВТаблицу_Форма2024_1(ДанныеУведомления, УникальныйИдентификатор);
	УведомлениеОСпецрежимахНалогообложения.СообщитьОшибкиПриПроверкеВыгрузки(Объект, Ошибки, ДанныеУведомления);
	
	ОсновныеСведения = ОсновныеСведенияЭлектронногоПредставления_Форма2024_1(Объект, УникальныйИдентификатор);
	СтруктураВыгрузки = Документы.УведомлениеОСпецрежимахНалогообложения.ИзвлечьСтруктуруXMLУведомления(Объект.ИмяОтчета, "СхемаВыгрузкиФорма2024_1");
	ЗаполнитьДанными_Форма2024_1(Объект, ОсновныеСведения, СтруктураВыгрузки, СписокФайлов, ИменаФайлов);
	УведомлениеОСпецрежимахНалогообложения.ВыгрузитьДеревоВТаблицу(СтруктураВыгрузки, ОсновныеСведения, СведенияЭлектронногоПредставления);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		Для Инд = 0 По СписокФайлов.Количество() - 1 Цикл 
			Файл = СписокФайлов[Инд];
			ИмяФайлаПрод = ИменаФайлов[Инд];
			СтрокаСведенийЭлектронногоПредставления = СведенияЭлектронногоПредставления.Добавить();
			СтрокаСведенийЭлектронногоПредставления.ИмяФайла = ИмяФайлаПрод;
			СтрокаСведенийЭлектронногоПредставления.ДвоичныеДанныеФайла = МодульРаботаСФайлами.ДвоичныеДанныеФайла(Файл.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СведенияЭлектронногоПредставления;
КонецФункции

Процедура ЗаполнитьДанными_Форма2024_1(Объект, Параметры, ДеревоВыгрузки, СписокФайлов, ИменаФайлов)
	Документы.УведомлениеОСпецрежимахНалогообложения.ОбработатьУсловныеЭлементы(Параметры, ДеревоВыгрузки);
	Документы.УведомлениеОСпецрежимахНалогообложения.ЗаполнитьПараметрыСРазделами(Параметры, ДеревоВыгрузки);
	ДанныеУведомления = Объект.ДанныеУведомления.Получить();
	УведомлениеОСпецрежимахНалогообложения.ЗаполнитьДаннымиУзелНов(ДанныеУведомления, ДеревоВыгрузки);
	
	ДатаИмФайла = Формат(ТекущаяДатаСеанса(), "ДФ=_yyyyMMdd_");
	Узел_Документ = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(ДеревоВыгрузки, "Документ");
	Узел_УведСоглММ = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(Узел_Документ, "УведСоглММ");
	Узел_ДокСкан = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(Узел_УведСоглММ, "ДокСкан");
	Для Каждого Стр0 Из ДанныеУведомления.ПриложенныеФайлы.Строки Цикл
		УИД1 = Строка(Новый УникальныйИдентификатор);
		НовУзел_ДокСкан = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ДокСкан);
		Документы.УведомлениеОСпецрежимахНалогообложения.УстановитьЗначениеЭлемента(НовУзел_ДокСкан, "НаимДок", Стр0.Документ);
		
		Узел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(НовУзел_ДокСкан, "ИмяФайл");
		Для Каждого Стр1 Из Стр0.Строки Цикл
			УИД2 = Строка(Новый УникальныйИдентификатор);
			НовУзел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ИмяФайл);
			ИмяФайлаПрод = "1125336_" + Параметры.ИННЮЛ + Параметры.КПП + "_"  + Параметры.КодНО 
							+ "_" + УИД1 + ДатаИмФайла + УИД2 + ".pdf";
			РегламентированнаяОтчетность.ВывестиПоказательСтатистикиВXML(НовУзел_ИмяФайл, ИмяФайлаПрод);
			ИменаФайлов.Добавить(ИмяФайлаПрод);
			СписокФайлов.Добавить(Стр1.ПрисоединенныйФайл);
		КонецЦикла;
		РегламентированнаяОтчетность.УдалитьУзел(Узел_ИмяФайл);
	КонецЦикла;
	РегламентированнаяОтчетность.УдалитьУзел(Узел_ДокСкан);
	
	Документы.УведомлениеОСпецрежимахНалогообложения.ОтсечьНезаполненныеНеобязательныеУзлы(ДеревоВыгрузки);
КонецПроцедуры

Функция СформироватьСписокЛистовФормаФорма2021_1(Объект) Экспорт
	СписокИспользуемыхМакетов = УведомлениеОСпецрежимахНалогообложения.ЗагрузитьМакетыИзАрхива(Объект, , "ТабличныеДокументы");
	Листы = Новый СписокЗначений;
	СохраненныеДанные = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеУведомления").Получить();
	
	ПечатнаяФорма = УведомлениеОСпецрежимахНалогообложения.НовыйПустойЛист();
	ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "Титульная_2021"));
	УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, СохраненныеДанные.ДанныеУведомления.Титульная);
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 1);
	
	ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "УведСоглММ_2021"));
	УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, СохраненныеДанные.ДанныеУведомления.УведСоглММ);
	УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, 2);
	
	НомСтр = 2;
	Для Каждого Стр Из СохраненныеДанные.ДанныеМногостраничныхРазделов.СвПредНД Цикл 
		НомСтр = НомСтр + 1;
		ПечатнаяФорма.Вывести(УведомлениеОСпецрежимахНалогообложения.ПустойМакетИзСписка(Объект, СписокИспользуемыхМакетов, "СвПредНД_2021"));
		УведомлениеОСпецрежимахНалогообложенияСлужебный.СтруктураДанныхВОбластиПечатнойФормы(ПечатнаяФорма, Стр.Значение);
		УведомлениеОСпецрежимахНалогообложения.ПоложитьПФВСписокЛистов(Объект, Листы, ПечатнаяФорма, НомСтр);
	КонецЦикла;
	
	Возврат Листы;
КонецФункции

#КонецОбласти
#КонецЕсли
