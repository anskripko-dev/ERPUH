Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ЕстьРасчет = ОбщегоНазначенияПовтИспУХ.РассчитыватьРасхожденияПорталаВГО();
	Если ЕстьРасчет Тогда
		СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = ТекстЗапроса_СверкаЕстьРасчет();
		Возврат;
	КонецЕсли;
	
	ПодготовитьДопАналитикиВГО(СхемаКомпоновкиДанных, Ложь);//ДопАналитики удалились
	//КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);//ДопАналитики дб доступны в КН
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	ИменаГруппировок = СтрСоединить(ТиповыеОтчетыУХ.ПолучитьПоляГруппировок(КомпоновщикНастроек).ВыгрузитьЗначения(), ",");
	
	Отбор = Новый Структура("ПериодСценария, Сценарий, ПоВерсии, ИменаГруппировок, ИменаОтборов");
	Отбор.Вставить("ПериодСценария",	ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "ПериодСценария") );
	Отбор.Вставить("Сценарий", 			ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "Сценарий") );
	Отбор.Вставить("ПоВерсии", 			СтрНайти(ИменаГруппировок, "Регистратор") > 0 );
	Отбор.Вставить("ИменаГруппировок", 	ИменаГруппировок);
	Отбор.Вставить("ИменаОтборов", 		СтрСоединить(ТиповыеОтчетыУХ.ПолучитьПоляОтборов(НастройкиСКД.Отбор), ","));
	
	ТекстО = СверкаВГОУХ.ТекстЗапроса_ОтборВГО(НастройкиСКД, "Организация");
	ТекстК = СверкаВГОУХ.ТекстЗапроса_ОтборВГО(НастройкиСКД, "Контрагент");
	
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = СверкаВГОУХ.ТекстЗапроса_ОтчетВГО(Отбор,, ТекстО, ТекстК);
	
КонецПроцедуры

Процедура ПодготовитьДопАналитикиВГО(НоваяСКД, ДополнитьЗапрос = Ложь)
	
	ндВГО = НоваяСКД.НаборыДанных.Найти("СверкаВГО");
	
	ПолеИсточник = ндВГО.Поля.Найти("АналитикиВГО.Аналитика1");
	ДопАналитикиВГО = Новый Массив;
	НомерУникальности = 1;
	
	Запрос = Новый Запрос(СверкаВГОУХ.ТекстЗапроса_ВозможныеДопАналитики());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Поле = ндВГО.Поля.Добавить(ТипЗнч(ПолеИсточник));
		ЗаполнитьЗначенияСвойств(Поле, ПолеИсточник);
		
		Поле.Поле = СтрШаблон("%1_%2",  Выборка.Имя, НомерУникальности);
		Поле.ПутьКДанным = "АналитикиВГО." + Поле.Поле;
		Поле.Заголовок = Выборка.Имя + НСтр("ru = ' (Аналитика ВГО)'");
		Поле.ТипЗначения = Выборка.ВидАналитики.ТипЗначения;
		НомерУникальности = НомерУникальности + 1;
		
		Если Поле.ТипЗначения.Типы().Количество() = 1 Тогда
			ИмяТипа = Метаданные.НайтиПоТипу(Поле.ТипЗначения.Типы()[0]).ПолноеИмя();
			ДопАналитикиВГО.Добавить(СтрШаблон("ЗНАЧЕНИЕ(%1.ПустаяСсылка) КАК %2", ИмяТипа, Поле.Поле));
		Иначе 
			ДопАналитикиВГО.Добавить("т.Аналитика1 КАК " + Поле.Поле);//все типы
		КонецЕсли;
		
	КонецЦикла;
	ДопАналитикиВГО.Добавить("ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)");
	
	Если ДополнитьЗапрос Тогда
	
		ТекстДопАналитикиВГО = СтрСоединить(ДопАналитикиВГО, ", ");
		ндВГО.Запрос = СтрЗаменить(ндВГО.Запрос, "ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)", ТекстДопАналитикиВГО);
	
	КонецЕсли;
	
КонецПроцедуры

