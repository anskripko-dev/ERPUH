
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
    Настройки = КомпоновщикНастроек.ПолучитьНастройки();

    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ОформитьТабДокВФорматеМСФО(ДокументРезультат);
	
КонецПроцедуры 

Функция ОформитьТабДокВФорматеМСФО(ТабличныйДокумент)
	
	// Удаляем лишние области
	ОбластьЗаголовок = ТабличныйДокумент.Области.Найти("Заголовок");
	Если ОбластьЗаголовок <> Неопределено Тогда
		ТабличныйДокумент.УдалитьОбласть(ОбластьЗаголовок, ТипСмещенияТабличногоДокумента.ПоВертикали);		
	КонецЕсли;
		
	НомерСтроки = 1;
	ВсегоСтрок = ТабличныйДокумент.ВысотаТаблицы; 
	Пока НомерСтроки <= ВсегоСтрок  Цикл
		ОбластьВывода = ТабличныйДокумент.Область("R2");
		Если ВРег(ОбластьВывода.Текст) = "ИНН" Тогда
			Прервать
		Иначе
			НомерСтроки = НомерСтроки + 1;
			ТабличныйДокумент.УдалитьОбласть(ТабличныйДокумент.Область("R1"), ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
	КонецЦикла;
	// Добавляется лишняя строка между группировками, ее тоже удаляем
	// Основные данные должны начинаться с 18ой строки
		
	ОбластьВывода = ТабличныйДокумент.Область("R15");
	ТабличныйДокумент.УдалитьОбласть(ОбластьВывода, ТипСмещенияТабличногоДокумента.ПоВертикали);
			
КонецФункции

