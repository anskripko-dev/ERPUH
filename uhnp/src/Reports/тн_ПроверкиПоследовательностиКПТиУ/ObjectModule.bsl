#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновшикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновшикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиСКД);//, ДанныеРасшифровки);
	
	//Сформируем доп набор данных
	ТЗ = СформироватьТЗ(МакетКомпоновки.ЗначенияПараметров);
	
	ВнешнийНабор = Новый Структура;
	ВнешнийНабор.Вставить("ТЗ", ТЗ);
	
	ПроцессорКомпановки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпановки.Инициализировать(МакетКомпоновки, ВнешнийНабор);//,ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент ;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпановки, Истина);
	
	
КонецПроцедуры

Функция СформироватьТЗ(ПараметрыЗапроса)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КорректировкаПриобретения.Ссылка КАК Корректировка,
		|	КорректировкаПриобретения.ДокументОснование КАК КорректируемыйДокумент,
		|	КорректировкаПриобретения.ДокументОснование КАК ДокументПоступления,
		|	КорректировкаПриобретения.СуммаДокумента КАК СуммаДокументаКорректировки,
		|	КорректировкаПриобретения.ДокументОснование.СуммаДокумента КАК СуммаОснования,
		|	КорректировкаПриобретения.Номер КАК Номер,
		|	КорректировкаПриобретения.Дата КАК Дата,
		|	КорректировкаПриобретения.ДокументОснование.Номер КАК НомерОснования,
		|	КорректировкаПриобретения.ДокументОснование.Дата КАК ДатаОснования,
		|	КорректировкаПриобретения.Партнер КАК Контрагент
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.КорректировкаПриобретения КАК КорректировкаПриобретения
		|ГДЕ
		|	КорректировкаПриобретения.Проведен
		|	И КорректировкаПриобретения.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И &УсловиеОрганизации
		|	И &УсловиеКонтрагента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ДокументПоступления КАК ДокументПоступления,
		|	ВТ.Корректировка КАК Корректировка
		|ИЗ
		|	ВТ КАК ВТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументПоступления,
		|	ВТ.Корректировка.МоментВремени
		|ИТОГИ ПО
		|	ДокументПоступления";
		
		//Установим параметры
		Для Каждого СтрПарам из ПараметрыЗапроса Цикл
			
			Если СтрПарам.Имя = "НачалоПериода" ИЛИ СтрПарам.Имя = "КонецПериода" Тогда
				Если СтрПарам.Имя = "КонецПериода" и СтрПарам.Значение = Дата(1,1,1) тогда
					Запрос.УстановитьПараметр(СтрПарам.Имя, Дата(3999,12,31));
				Иначе
					Запрос.УстановитьПараметр(СтрПарам.Имя, СтрПарам.Значение);
				КонецЕсли;
			ИначеЕсли СтрПарам.Имя = "Организация" Тогда
				Запрос.УстановитьПараметр(СтрПарам.Имя, СтрПарам.Значение);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизации", "КорректировкаПриобретения.Организация = &Организация");
			ИначеЕсли СтрПарам.Имя = "Контрагент" Тогда
				Запрос.УстановитьПараметр(СтрПарам.Имя, СтрПарам.Значение);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагента", "КорректировкаПриобретения.Партнер = &Контрагент");
			КонецЕсли;
			
		КонецЦикла;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизации", "Истина");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагента", "Истина");
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			ТЗ = Новый ТаблицаЗначений;
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
			МассивТипов.Добавить(Тип("ДокументСсылка.КорректировкаПриобретения"));
			МассивТипов.Добавить(Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов"));
			
			ТЗ.Колонки.Добавить("ДокументПоступления", Новый ОписаниеТипов(МассивТипов));
			ТЗ.Колонки.Добавить("Корректировка", Новый ОписаниеТипов("ДокументСсылка.КорректировкаПриобретения"));
			ВыборкаДокументПоступления = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДокументПоступления.Следующий() Цикл
				Первый = Истина;
				ВыборкаДетальныеЗаписи = ВыборкаДокументПоступления.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					НоваяСтрока = ТЗ.Добавить();
					Если Первый Тогда
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
						ДокументПоступления = ВыборкаДетальныеЗаписи.Корректировка; 
					Иначе
						НоваяСтрока.ДокументПоступления = ДокументПоступления;	
						НоваяСтрока.Корректировка = ВыборкаДетальныеЗаписи.Корректировка;	
						ДокументПоступления = ВыборкаДетальныеЗаписи.Корректировка; 
					КонецЕсли;
					Первый = ложь;
				КонецЦикла;
			КонецЦикла;
			
			Запрос.Текст = "ВЫБРАТЬ
			|	ДокументыОснования.ДокументПоступления КАК ДокументПоступления,
			|	ДокументыОснования.Корректировка КАК Корректировка
			|ПОМЕСТИТЬ ВТ_Основания
			|ИЗ
			|	&ДокументыОснования КАК ДокументыОснования
			|;
			|ВЫБРАТЬ 
			|	ВТ.Корректировка КАК Корректировка,
			|	ВТ_Основания.ДокументПоступления КАК КорректируемыйДокумент,
			|	ВТ.ДокументПоступления КАК ДокументПоступления,
			|	ВТ.СуммаДокументаКорректировки КАК СуммаДокументаКорректировки,
			|	ВТ_Основания.ДокументПоступления.СуммаДокумента КАК СуммаОснования,
			|	ВТ.Номер КАК Номер,
			|	ВТ.Дата КАК Дата,
			|	ВТ_Основания.ДокументПоступления.Номер КАК НомерОснования,
			|	ВТ_Основания.ДокументПоступления.Дата КАК ДатаОснования,
			|	ВТ.Контрагент КАК Контрагент
			|ИЗ
			|	ВТ ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Основания ПО ВТ.Корректировка = ВТ_Основания.Корректировка";
			Запрос.УстановитьПараметр("ДокументыОснования",ТЗ);
			РезультатЗапроса1 = Запрос.Выполнить();
			ТЗ1 = РезультатЗапроса1.Выгрузить();
		Иначе
			ТЗ1 = Новый ТаблицаЗначений;
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
			МассивТипов.Добавить(Тип("ДокументСсылка.КорректировкаПриобретения"));
			ТЗ1.Колонки.Добавить("КорректируемыйДокумент", Новый ОписаниеТипов(МассивТипов));
			ТЗ1.Колонки.Добавить("ДокументПоступления", Новый ОписаниеТипов(МассивТипов));
			ТЗ1.Колонки.Добавить("Корректировка", Новый ОписаниеТипов("ДокументСсылка.КорректировкаПриобретения"));
			ТЗ1.Колонки.Добавить("СуммаДокументаКорректировки", Новый ОписаниеТипов("Число"));
			ТЗ1.Колонки.Добавить("СуммаОснования", Новый ОписаниеТипов("Число"));
			ТЗ1.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
			ТЗ1.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
			ТЗ1.Колонки.Добавить("НомерОснования", Новый ОписаниеТипов("Строка"));
			ТЗ1.Колонки.Добавить("ДатаОснования", Новый ОписаниеТипов("Дата"));
			ТЗ1.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
		КонецЕсли;
		Возврат ТЗ1;   
	КонецФункции
#КонецЕсли
