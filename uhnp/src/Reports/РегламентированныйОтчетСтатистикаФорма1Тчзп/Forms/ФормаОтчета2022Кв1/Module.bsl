	КонецЕсли;
	
	ВыборКод  = СокрЛП(РезультатВыбора["Код"]);
	ВыборНазв = СокрЛП(РезультатВыбора["Название"]);
	
	ПолеТабличногоДокументаФормаОтчета.Области[Лев(Область.Имя, 11) + "01"].Значение = ?(ВыборКод <> "", ВыборНазв, "");
	ПолеТабличногоДокументаФормаОтчета.Области[Лев(Область.Имя, 11) + "02"].Значение = ВыборКод;
	
	Модифицированность = Истина;
КонецПроцедуры

