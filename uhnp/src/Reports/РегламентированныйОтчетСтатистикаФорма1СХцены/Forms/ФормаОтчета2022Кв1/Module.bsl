		НСтр("ru = 'Внимание! Отчет будет очищен.%1Продолжить операцию?';
			|en = 'Внимание! Отчет будет очищен.%1Продолжить операцию?'"), Символы.ПС);
	ОписаниеОповещения = Новый ОписаниеОповещения("ОчиститьОтчетЗавершение", ЭтотОбъект);
