
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ВерсияРегламента = Неопределено;
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ВерсииРегламентовПодготовкиОтчетности") Тогда
		ВерсияРегламента = ПараметрКоманды;
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.УправлениеПериодомСценария") Тогда
		ВерсияРегламента = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПараметрКоманды, "ВерсияОрганизационнойСтруктуры");
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВерсияРегламента", 	ВерсияРегламента);
	Отбор.Вставить("ВыводДиаграммы", 	Истина);

	ПараметрыФормы = Новый Структура("СформироватьПриОткрытии, ПечатьОрганизационнаяСтруктураКратко, Отбор", 
						Истина, "ПечатьОрганизационнаяСтруктураКратко", Отбор);
	ОткрытьФорму("Отчет.ОрганизационныеСтруктурыРегламента.Форма", ПараметрыФормы);
		
КонецПроцедуры

