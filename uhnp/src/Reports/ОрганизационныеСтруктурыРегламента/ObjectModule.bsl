
Перем КолонкиДиаграммы;

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	ЗначениеПараметра = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводДиаграммы"));
	Если (ЗначениеПараметра = Неопределено) Или ЗначениеПараметра.Значение <> Истина Тогда
		Возврат; 
	КонецЕсли;
	
	// вывод диаграммы
	СтандартнаяОбработка = Ложь;		
	РезультатДерево = ТиповыеОтчетыУХ.ВывестиСКД(ЭтотОбъект.СхемаКомпоновкиДанных, НастройкиСКД, ДанныеРасшифровки,, Истина);	
	//
	КолонкиДиаграммы = Новый Массив;
	Для каждого КолонкаДерева Из РезультатДерево.Колонки Цикл
		КолонкиДиаграммы.Добавить(КолонкаДерева.Имя);
	КонецЦикла;
	
	ДокументРезультат.Очистить();
	//ДокументРезультат.Вывести(ПолучитьМакет("ОформлениеДиаграммы"));
	ДокументРезультат.Вывести(ПолучитьПредставлениеДереваЗначений(РезультатДерево));
	
КонецПроцедуры

Функция ПолучитьПредставлениеДереваЗначений(Строки, Результат = Неопределено, Уровень = 0, Макеты = Неопределено, НачалоСтроки = Неопределено, КонецСтроки = Неопределено) Экспорт
	
	Если ТипЗнч(Строки) = Тип("ДеревоЗначений") Тогда
		
		Результат = Новый ТабличныйДокумент;
		
		Макет = ПолучитьМакет("ОформлениеДиаграммы");
		Макеты = Новый Структура;
		Для Каждого Область Из Макет.Области Цикл
			Макеты.Вставить(Область.Имя, Макет.ПолучитьОбласть(Область.Имя));
		КонецЦикла;
		
		НачалоСтроки = Новый Массив;
		
		Возврат ПолучитьПредставлениеДереваЗначений(Строки.Строки, Результат, Уровень, Макеты, НачалоСтроки, КонецСтроки);;
		
	КонецЕсли;
	
	НачалоНовойСтроки = Новый Массив;
	Для сч = 1 По НачалоСтроки.Количество() Цикл
		НачалоНовойСтроки.Добавить(НачалоСтроки[сч-1]);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КонецСтроки) Тогда
		Если КонецСтроки = "Середина" Тогда
			НачалоНовойСтроки.Добавить("Продолжение");
		Иначе
			НачалоНовойСтроки.Добавить("Начало");
		КонецЕсли;
	КонецЕсли;
	
	Если Уровень Тогда 
		НачалоНовойСтроки.Добавить("Начало");
	КонецЕсли;
	
	МассивВыведенныхСтрок = Новый Массив;
	МаксимальнаяДлинаСтроки = 0;
	
	Для Каждого Строка Из Строки Цикл
		
		Если Уровень > 0 ИЛИ Строки.Индекс(Строка) > 0 Тогда
			Результат.Вывести(Макеты["НачалоСтроки_"]);
			Для Каждого ИмяОбласти Из НачалоНовойСтроки Цикл
				Результат.Присоединить(Макеты[ИмяОбласти+"_"]);
			КонецЦикла;
			Если Уровень > 0 Тогда
				Если Строки.Индекс(Строка) = Строки.Количество()-1 Тогда
					ИмяОбласти = "Конец_";
				Иначе
					ИмяОбласти = "Середина_";
				КонецЕсли;
				Результат.Присоединить(Макеты[ИмяОбласти]);
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			Если НЕ Результат.ПроверитьВывод(Макеты["НачалоСтроки"]) Тогда
				Результат.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		Исключение
			// не удалось определить принтер
		КонецПопытки;
		
		Результат.Вывести(Макеты["НачалоСтроки"]);
		
		Для Каждого ИмяОбласти Из НачалоНовойСтроки Цикл
			Результат.Присоединить(Макеты[ИмяОбласти]);
		КонецЦикла;
			
		Если Уровень > 0 Тогда
			Если Строки.Индекс(Строка) = Строки.Количество()-1 Тогда
				ИмяОбласти = "Конец";
			Иначе
				ИмяОбласти = "Середина";
			КонецЕсли;
			Результат.Присоединить(Макеты[ИмяОбласти]);
		КонецЕсли;
		
		Описание = "";
		
		Для каждого КолонкаДиаграммы Из КолонкиДиаграммы Цикл		
			Если ЗначениеЗаполнено(Строка[КолонкаДиаграммы]) И (КолонкаДиаграммы <> "ОрганизационнаяЕдиница") Тогда
				Описание = Описание + ?(ПустаяСтрока(Описание), "", ", ") + Строка[КолонкаДиаграммы];
			КонецЕсли;		
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(Описание) Тогда
			Описание = " (" + Описание + ")";
		КонецЕсли;
		Описание = Строка(Строка.ОрганизационнаяЕдиница) + Описание;
		
		ИмяОбластиЗначения = ?(Строка.Строки.Количество() > 0, "Группа", "Элемент");
		
		Макеты[ИмяОбластиЗначения].Параметры.Текст = Описание;
		Макеты[ИмяОбластиЗначения].Параметры.Расшифровка = Строка.ОрганизационнаяЕдиница;
		
		Результат.Присоединить(Макеты[ИмяОбластиЗначения]);
		
		ШиринаКолонки = 3;
		Результат.Область(, 1,, Результат.ШиринаТаблицы).ШиринаКолонки = ШиринаКолонки;
		
		МассивВыведенныхСтрок.Добавить(Результат.ВысотаТаблицы);
		Если СтрДлина(Описание) > МаксимальнаяДлинаСтроки Тогда
			МаксимальнаяДлинаСтроки = СтрДлина(Описание);
		КонецЕсли;
		
		Результат.НачатьГруппуСтрок();
		
		ПолучитьПредставлениеДереваЗначений(Строка.Строки, Результат, Уровень + 1, Макеты, НачалоНовойСтроки, ИмяОбласти);
	
		Результат.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
	
	КоличествоСимволовВКолонке = 3.5;
	КоличествоСтрокВОбласти = 2;
	
	ШиринаЯчейки = Цел(МаксимальнаяДлинаСтроки/КоличествоСимволовВКолонке) + 2;
	НачалоЯчейки = 1 + НачалоНовойСтроки.Количество() + ?(Уровень > 0, 1, 0) + 1;
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	Для Каждого ВыведеннаяСтрока Из МассивВыведенныхСтрок Цикл
		
		Область = Результат.Область(ВыведеннаяСтрока-КоличествоСтрокВОбласти+1, НачалоЯчейки, ВыведеннаяСтрока, НачалоЯчейки + ШиринаЯчейки);
		Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Область.ШиринаКолонки = 3;
		Область.Объединить();
		Область.Обвести(Линия, Линия, Линия, Линия);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

