
&НаСервере
Процедура СформироватьОтчетНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.Год.ДатаНачала КАК ДатаНачала,
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.Процент КАК Процент,
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.ОКПД2 КАК ОКПД2
	               |ИЗ
	               |	РегистрСведений.ДоляЗакупокТоваровРоссийскогоПроисхождения КАК ДоляЗакупокТоваровРоссийскогоПроисхождения";
	Выборка = Запрос.Выполнить().Выгрузить();
	Справочник = Справочники.КлассификаторОКПД2.Выбрать();
	Пока Справочник.Следующий() Цикл
		Если Выборка.НайтиСтроки(Новый Структура("ОКПД2",Справочник)).Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОКПД2 = Справочник.Код;
		Длина = СтрДлина(Справочник.Код);
		Символ = 1;
		Классификатор = Неопределено;
		Пока Классификатор = Неопределено И НЕ СтрНайти(ОКПД2,".") = 0 Цикл
			ОКПД2 = Лев(ОКПД2,Длина-Символ); 
			Родитель = Справочники.КлассификаторОКПД2.НайтиПоКоду(ОКПД2);
			Если Выборка.НайтиСтроки(Новый Структура("ОКПД2",Родитель)).Количество() > 1 Тогда
				ЭлементыВыборки = Выборка.НайтиСтроки(Новый Структура("ОКПД2",Родитель));
				Для Каждого Элемент ИЗ ЭлементыВыборки Цикл
					Строка = Выборка.Добавить();
					Строка.ОКПД2 = Справочник.Ссылка;
					Строка.ДатаНачала = Элемент.ДатаНачала;
					Строка.Процент = Элемент.Процент;
				КонецЦикла;
			КонецЕсли;	
			Символ = Символ +1;
		КонецЦикла;
	КонецЦикла;	
	ДоляЗакупокТоваровРоссийскогоПроисхождения = Новый ТаблицаЗначений();
	ДоляЗакупокТоваровРоссийскогоПроисхождения.Колонки.Добавить("ОКПД2",Новый ОписаниеТипов("СправочникСсылка.КлассификаторОКПД2"));
	ДоляЗакупокТоваровРоссийскогоПроисхождения.Колонки.Добавить("Процент",Новый ОписаниеТипов("Число"));
	ДоляЗакупокТоваровРоссийскогоПроисхождения.Колонки.Добавить("ДатаНачала",Новый ОписаниеТипов("Дата"));
	Для Каждого Строка ИЗ Выборка Цикл
		ДобСтрока = ДоляЗакупокТоваровРоссийскогоПроисхождения.Добавить();
		ЗаполнитьЗначенияСвойств(ДобСтрока,Строка);
	КонецЦикла;	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.ОКПД2 КАК ОКПД2,
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.Процент КАК Процент,
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.ДатаНачала КАК ДатаНачала
	               |ПОМЕСТИТЬ ДоляЗакупокТоваровРоссийскогоПроисхождения
	               |ИЗ
	               |	&ДоляЗакупокТоваровРоссийскогоПроисхождения КАК ДоляЗакупокТоваровРоссийскогоПроисхождения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.ОКПД2 КАК ОКПД2,
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.Процент КАК Процент
	               |ПОМЕСТИТЬ ДанныеПоДолям
	               |ИЗ
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения КАК ДоляЗакупокТоваровРоссийскогоПроисхождения
	               |ГДЕ
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.ДатаНачала >= &ДатаНачала
	               |	И ДоляЗакупокТоваровРоссийскогоПроисхождения.ДатаНачала <= &ДатаОкончания
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.ОКПД2,
	               |	ДоляЗакупокТоваровРоссийскогоПроисхождения.Процент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПотребностиВНоменклатуре.Номенклатура.КодОКПД2 КАК ПотребностиОКПД2,
	               |	СУММА(ПотребностиВНоменклатуре.СуммаВОбеспечении + ПотребностиВНоменклатуре.СуммаВнеПлана) КАК Сумма
	               |ПОМЕСТИТЬ ПланПотребности
	               |ИЗ
	               |	РегистрНакопления.ПотребностиВНоменклатуре КАК ПотребностиВНоменклатуре
	               |ГДЕ
	               |	ПотребностиВНоменклатуре.Период >= &ДатаНачала
	               |	И ПотребностиВНоменклатуре.Период <= &ДатаОкончания
	               |	И ПотребностиВНоменклатуре.Организация = &Организация
	               |	И ПотребностиВНоменклатуре.Номенклатура.КодОКПД2 <> ЗНАЧЕНИЕ(Справочник.КлассификаторОКПД2.ПустаяСсылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПотребностиВНоменклатуре.Номенклатура.КодОКПД2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПланПоставокПоДоговорам.Номенклатура.КодОКПД2 КАК ПланПоставкиОКПД2,
	               |	СУММА(ВЫБОР
	               |			КОГДА ПланПоставокПоДоговорам.СтраныПроисхождения = &Страна
	               |				ТОГДА ПланПоставокПоДоговорам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаПоРоссии,
	               |	СУММА(ВЫБОР
	               |			КОГДА ПланПоставокПоДоговорам.СтраныПроисхождения <> &Страна
	               |				ТОГДА ПланПоставокПоДоговорам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаПоОстальным
	               |ПОМЕСТИТЬ ДанныеПоПлануПоставки
	               |ИЗ
	               |	РегистрНакопления.ПланПоставокПоДоговорам КАК ПланПоставокПоДоговорам
	               |ГДЕ
	               |	ПланПоставокПоДоговорам.СтраныПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	               |	И ПланПоставокПоДоговорам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |	И ПланПоставокПоДоговорам.Период >= &ДатаНачала
	               |	И ПланПоставокПоДоговорам.Период <= &ДатаОкончания
	               |	И ПланПоставокПоДоговорам.Организация = &Организация
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПланПоставокПоДоговорам.Номенклатура.КодОКПД2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказыПоставщикамУХ.Номенклатура.КодОКПД2 КАК ЗаказыОКПД2,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказыПоставщикамУХ.СтраныПроисхождения = &Страна
	               |				ТОГДА ЗаказыПоставщикамУХ.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаПоРоссии,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказыПоставщикамУХ.СтраныПроисхождения <> &Страна
	               |				ТОГДА ЗаказыПоставщикамУХ.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаПоОстальным,
	               |	СУММА(ЗаказыПоставщикамУХ.Сумма) КАК СуммаОбщее
	               |ПОМЕСТИТЬ ПоступлениеПоПлануПоставок
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПоставщикамУХ КАК ЗаказыПоставщикамУХ
	               |ГДЕ
	               |	ЗаказыПоставщикамУХ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |	И ЗаказыПоставщикамУХ.Период >= &ДатаНачала
	               |	И ЗаказыПоставщикамУХ.Период <= &ДатаОкончания
	               |	И ЗаказыПоставщикамУХ.Номенклатура.КодОКПД2 <> ЗНАЧЕНИЕ(Справочник.КлассификаторОКПД2.ПустаяСсылка)
	               |	И ЗаказыПоставщикамУХ.СтраныПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	               |	И ЗаказыПоставщикамУХ.Организация = &Организация
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыПоставщикамУХ.Номенклатура.КодОКПД2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПрослеживаемыеТоварыПоОКПД2.Номенклатура.КодОКПД2 КАК ОбщееПоступлениеОКПД2,
	               |	СУММА(ПрослеживаемыеТоварыПоОКПД2.СуммаОборот) КАК ОбщаяСумма,
	               |	СУММА(ВЫБОР
	               |			КОГДА ПрослеживаемыеТоварыПоОКПД2.СтраныПроисхождения = &Страна
	               |				ТОГДА ПрослеживаемыеТоварыПоОКПД2.СуммаОборот
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаПоРоссии,
	               |	СУММА(ВЫБОР
	               |			КОГДА ПрослеживаемыеТоварыПоОКПД2.СтраныПроисхождения <> &Страна
	               |				ТОГДА ПрослеживаемыеТоварыПоОКПД2.СуммаОборот
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаПоОстальным,
	               |	СУММА(ВЫБОР
	               |			КОГДА ДоговорыТовары.Договор ЕСТЬ NULL
	               |				ТОГДА ПрослеживаемыеТоварыПоОКПД2.СуммаОборот
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаБезГрафика,
	               |	СУММА(ВЫБОР
	               |			КОГДА ДоговорыТовары.Договор ЕСТЬ NULL
	               |					И ПрослеживаемыеТоварыПоОКПД2.СтраныПроисхождения = &Страна
	               |				ТОГДА ПрослеживаемыеТоварыПоОКПД2.СуммаОборот
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаБезГрафикаПоРоссии,
	               |	СУММА(ВЫБОР
	               |			КОГДА НЕ ДоговорыТовары.Договор ЕСТЬ NULL
	               |					И ПрослеживаемыеТоварыПоОКПД2.СтраныПроисхождения = &Страна
	               |				ТОГДА ПрослеживаемыеТоварыПоОКПД2.СуммаОборот
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаПоГрафикаПоРоссии
	               |ПОМЕСТИТЬ ОбщееПоступление
	               |ИЗ
	               |	РегистрНакопления.ПрослеживаемыеТоварыПоОКПД2.Обороты(&ДатаНачала, &ДатаОкончания, , Организация = &Организация) КАК ПрослеживаемыеТоварыПоОКПД2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ПланПоставокПоДоговорам.Договор КАК Договор
	               |		ИЗ
	               |			РегистрНакопления.ПланПоставокПоДоговорам КАК ПланПоставокПоДоговорам
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ПланПоставокПоДоговорам.Договор) КАК ДоговорыТовары
	               |		ПО (ДоговорыТовары.Договор = ПрослеживаемыеТоварыПоОКПД2.Договор)
	               |ГДЕ
	               |	ПрослеживаемыеТоварыПоОКПД2.СтраныПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПрослеживаемыеТоварыПоОКПД2.Номенклатура.КодОКПД2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеПоДолям.ОКПД2 КАК ОКПД2,
	               |	ВЫРАЗИТЬ(ПланПотребности.Сумма КАК ЧИСЛО(15, 2)) КАК Запланировано,
				   |    ДанныеПоПлануПоставки.СуммаПоРоссии КАК ЗаконтрактованоРФ,
	               |	ДанныеПоПлануПоставки.СуммаПоОстальным + ДанныеПоПлануПоставки.СуммаПоРоссии КАК Законтрактовано,
	               |	ДанныеПоДолям.Процент КАК Норма,
	               |	ДанныеПоПлануПоставки.СуммаПоРоссии / (ДанныеПоПлануПоставки.СуммаПоОстальным + ДанныеПоПлануПоставки.СуммаПоРоссии) * 100 КАК ФактПоЗапланированному,
	               |	ОбщееПоступление.ОбщаяСумма КАК ПоставленоВсего,
	               |	ОбщееПоступление.СуммаПоГрафикаПоРоссии КАК ПоступлениеПоГрафикуПоставок,
	               |	ОбщееПоступление.СуммаБезГрафикаПоРоссии КАК ПоставленоБезГрафикаПоРоссии,
	               |	ДанныеПоДолям.Процент КАК НормаПоставок,
				   |	ОбщееПоступление.СуммаПоРоссии как ПоступлениеВсегоРФ,
	               |	ОбщееПоступление.СуммаПоРоссии / ОбщееПоступление.ОбщаяСумма * 100 КАК Факт
	               |ИЗ
	               |	ДанныеПоДолям КАК ДанныеПоДолям
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПоступлениеПоПлануПоставок КАК ПоступлениеПоПлануПоставок
	               |		ПО ДанныеПоДолям.ОКПД2 = ПоступлениеПоПлануПоставок.ЗаказыОКПД2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланПотребности КАК ПланПотребности
	               |		ПО ДанныеПоДолям.ОКПД2 = ПланПотребности.ПотребностиОКПД2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОбщееПоступление КАК ОбщееПоступление
	               |		ПО ДанныеПоДолям.ОКПД2 = ОбщееПоступление.ОбщееПоступлениеОКПД2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоПлануПоставки КАК ДанныеПоПлануПоставки
	               |		ПО ДанныеПоДолям.ОКПД2 = ДанныеПоПлануПоставки.ПланПоставкиОКПД2
	               |ГДЕ
	               |	(ПоступлениеПоПлануПоставок.ЗаказыОКПД2 <> ЗНАЧЕНИЕ(Справочник.КлассификаторОКПД2.ПустаяСсылка)
	               |			ИЛИ ПланПотребности.ПотребностиОКПД2 <> ЗНАЧЕНИЕ(Справочник.КлассификаторОКПД2.ПустаяСсылка)
	               |			ИЛИ ОбщееПоступление.ОбщееПоступлениеОКПД2 <> ЗНАЧЕНИЕ(Справочник.КлассификаторОКПД2.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ДоляЗакупокТоваровРоссийскогоПроисхождения",ДоляЗакупокТоваровРоссийскогоПроисхождения);
	Запрос.УстановитьПараметр("ДатаНачала",Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",Отчет.ДатаОкончания);          
	Запрос.УстановитьПараметр("Организация",Отчет.Организация);
	Запрос.УстановитьПараметр("Страна",Справочники.СтраныМира.Россия);
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ТабличныйДокумент.Очистить();
	Макет = ОтчетОбъект.ПолучитьМакет("Макет");
	ЗаголовокМакета = Макет.ПолучитьОбласть("ЗаголовокМакета");
	
	ТабличныйДокумент.Вывести(ЗаголовокМакета);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Макет.ПолучитьОбласть("Строка");
		Строка.Параметры.Заполнить(Выборка);
		ТабличныйДокумент.Вывести(Строка);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	СформироватьОтчетНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Отчет.ДатаНачала = НачалоГода(ТекущаяДата());
	Отчет.ДатаОкончания = КонецГода(ТекущаяДата());
	
КонецПроцедуры
