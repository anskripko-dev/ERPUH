			СтруктураПараметров.Вставить("ОбъектУчетаИсточникКт",ВыборкаОбъектУчетаИсточникКт.ОбъектУчетаИсточникКт);
			
			ОбластьДанных.Параметры.РасшифровкаИсточник=СтруктураПараметров;
			ОбластьДанных.Параметры.РасшифровкаПриемник=СтруктураПараметров;
			
			ЕстьСоответствиеСчетов=Истина;
			
			СтрокаИсточникДт=ТаблицаСоответствия.Найти(ВыборкаОбъектУчетаИсточникКт.ОбъектУчетаИсточникДтНаименование,"ОбъектУчетаИсточникНаименование");
			СтрокаИсточникКт=ТаблицаСоответствия.Найти(ВыборкаОбъектУчетаИсточникКт.ОбъектУчетаИсточникКтНаименование,"ОбъектУчетаИсточникНаименование");
			
