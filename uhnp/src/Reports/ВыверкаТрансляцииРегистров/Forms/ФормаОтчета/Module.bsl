				ИначеЕсли ТаблицаСчетовПриемникКорр.Количество()=1 Тогда
					
					СтрокаПриемник=ТаблицаСчетовПриемникКорр[0];	
					ЗаполнитьПараметрыОбластиДанныхКорр(ОбластьДанных,СтрокаПриемник);
					
				КонецЕсли;
				
			КонецЕсли;
			
			ТабДок.Присоединить(ОбластьДанных);
						
			Если ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетДтПриемник) И ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетКтПриемник) Тогда
				
				ВывестиДополнительнуюИнформацию(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ТаблицаСоответствия);
										
			КонецЕсли;
				
			Если ТаблицаСчетовПриемникКорр.Количество()>1 Тогда 
				
				ТабДок.НачатьГруппуСтрок(""+ВыборкаОбъектУчетаИсточникКт.ОбъектУчетаИсточникДтНаименование,Отчет.ПодробнаяИнформация);
				
				Для Каждого СтрокаПриемник ИЗ ТаблицаСчетовПриемникКорр Цикл
				
						ТабДок.Вывести(ОбластьОтступ);
						
						ОбластьДанных.Параметры.ОбъектУчетаИсточникДт	= "";
						ОбластьДанных.Параметры.ОбъектУчетаИсточникКт	= "";
						ОбластьДанных.Параметры.ЗначениеИсточник= 0;
						ОбластьДанных.Параметры.Расхождение		= 0;
						
						ЗаполнитьПараметрыОбластиДанныхКорр(ОбластьДанных,СтрокаПриемник);
												
						ТабДок.Присоединить(ОбластьДанных);
												
						ВывестиДополнительнуюИнформацию(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ТаблицаСоответствия);
						
					КонецЦикла;
					
					ТабДок.ЗакончитьГруппуСтрок();
					
			КонецЕсли;
			
			ТабДок.Область(ТабДок.ВысотаТаблицы,2,ТабДок.ВысотаТаблицы,ТабДок.ШиринаТаблицы).ГраницаСнизу=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
						
		КонецЦикла;
		
	КонецЦикла;
	
	ОбластьИтого.Параметры.ИтогоРасхождение=ИтогоРасхождение;
	ОбластьИтого.Параметры.ИтогоЗначениеИсточник=ИтогоЗначениеИсточник;
	ОбластьИтого.Параметры.ИтогоЗначениеПриемник=ИтогоЗначениеПриемник;
	
	ТабДок.Вывести(ОбластьОтступ);
	ТабДок.Присоединить(ОбластьИтого);
			
КонецПроцедуры // ВывестиОтчет_Корр() 

Процедура ПолучитьТаблицуСчетовПриемникОб(ВыборкаОбъектУчетаИсточник,ИтогоЗначениеПриемникДт,ИтогоЗначениеПриемникКт)
	
	ТаблицаСчетовПриемникОб.Очистить();
	
	ВыборкаСчетПриемник=ВыборкаОбъектУчетаИсточник.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСчетПриемник.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаСчетПриемник.СчетПриемник) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока=ТаблицаСчетовПриемникОб.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаСчетПриемник);
		
		НоваяСтрока.ЗначениеПриемникДт = ВыборкаСчетПриемник.СуммаВВалютеУчетаДт;
		НоваяСтрока.ЗначениеПриемникКт = ВыборкаСчетПриемник.СуммаВВалютеУчетаКт;
		
		ИтогоЗначениеПриемникДт=ИтогоЗначениеПриемникДт+НоваяСтрока.ЗначениеПриемникДт;
		ИтогоЗначениеПриемникКт=ИтогоЗначениеПриемникКт+НоваяСтрока.ЗначениеПриемникКт;
		
	КонецЦикла;
		
КонецПроцедуры // ПолучитьТаблицуСчетовПриемникОб()

&НаСервере
Процедура ДополнитьРасшифровкуПериодом(СтруктураПараметров,СтрокаПриемник)
	
	Если ЗначениеЗаполнено(СтрокаПриемник.Период) Тогда
		
		СтруктураПараметров.Вставить("Период",СтрокаПриемник.Период);
		
	КонецЕсли;
	
КонецПроцедуры // ДополнитьРасшифровкуПериодом() 

&НаСервере
Процедура ЗаполнитьПараметрыОбластиДанныхОбороты(ОбластьДанных,СтрокаПриемник)
	
	ОбластьДанных.Параметры.СчетПриемник	= СтрокаПриемник.СчетПриемник;
		
	ОбластьДанных.Параметры.ЗначениеПриемникДт = СтрокаПриемник.ЗначениеПриемникДт;
	ОбластьДанных.Параметры.ЗначениеПриемникКт = СтрокаПриемник.ЗначениеПриемникКт;
	
	СтруктураПараметровДт=Новый Структура("ДтКт","Дт");
	ДополнитьРасшифровкуПериодом(СтруктураПараметровДт,СтрокаПриемник);
	
	СтруктураПараметровКт=Новый Структура("ДтКт","Кт");
	ДополнитьРасшифровкуПериодом(СтруктураПараметровКт,СтрокаПриемник);
	
	СтруктураПараметровДт.Вставить("ОбъектУчетаИсточник",СтрокаПриемник.ОбъектУчетаИсточник);
	СтруктураПараметровКт.Вставить("ОбъектУчетаИсточник",СтрокаПриемник.ОбъектУчетаИсточник);
	
	ОбластьДанных.Параметры.РасшифровкаИсточникДт=СтруктураПараметровДт;
	ОбластьДанных.Параметры.РасшифровкаИсточникКт=СтруктураПараметровКт;
	
	СтруктураПараметровДт=Новый Структура("ДтКт","Дт");
	СтруктураПараметровДт.Вставить("ОбъектУчетаИсточник",СтрокаПриемник.ОбъектУчетаИсточник);	
	СтруктураПараметровДт.Вставить("СчетПриемник",СтрокаПриемник.СчетПриемник);
	ДополнитьРасшифровкуПериодом(СтруктураПараметровДт,СтрокаПриемник);
	
	СтруктураПараметровКт=Новый Структура("ДтКт","Кт");
	СтруктураПараметровКт.Вставить("ОбъектУчетаИсточник",СтрокаПриемник.ОбъектУчетаИсточник);	
	СтруктураПараметровКт.Вставить("СчетПриемник",СтрокаПриемник.СчетПриемник);
	ДополнитьРасшифровкуПериодом(СтруктураПараметровКт,СтрокаПриемник);
	
	ОбластьДанных.Параметры.РасшифровкаПриемникДт=СтруктураПараметровДт;
	ОбластьДанных.Параметры.РасшифровкаПриемникКт=СтруктураПараметровКт;	
	
КонецПроцедуры // ЗаполнитьПараметрыОбластиДанныОбороты()
	
&НаСервере
Процедура ВывестиОтчет_Об(Запрос)
	
	Макет=Отчеты.ВыверкаТрансляцииРегистров.ПолучитьМакет("МакетОборотыДтКт_ВНА");
	
	ТаблицаСоответствия=ПолучитьТаблицуСоответствияСчетов();
	
	ОбластьДанных		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьДанных");
	ОбластьОтступ		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьОтступ");
		
	ОбластьИтого        	= Макет.ПолучитьОбласть("СтрокаИтого|ОбластьДанных");
	
	ОбластьПодробно        		= Макет.ПолучитьОбласть("СтрокаПодробно|ОбластьДанных");
	
	ИтогоРасхождениеДт=0;
	ИтогоРасхождениеКт=0;
	
	ИтогоЗначениеИсточникДт=0;
	ИтогоЗначениеИсточникКт=0;
	
	ИтогоЗначениеПриемникДт=0;
	ИтогоЗначениеПриемникКт=0;
	
	ВыборкаОбъектУчетаИсточник=Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОбъектУчетаИсточник.Следующий() Цикл
		
		Если Отчет.ВыводитьТолькоОшибочные 
			И ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаДт=0
			И ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаКт=0 Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьОтступ);
		
		ОбластьДанных.Параметры.СчетПриемник	= "";
		
		ОбластьДанных.Параметры.ОбъектУчетаИсточник	= ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник;
		
		ОбластьДанных.Параметры.ЗначениеИсточникДт= ВыборкаОбъектУчетаИсточник.СуммаДт;
		ОбластьДанных.Параметры.ЗначениеИсточникКт= ВыборкаОбъектУчетаИсточник.СуммаКт;
		
		ОбластьДанных.Параметры.ЗначениеПриемникДт= ВыборкаОбъектУчетаИсточник.СуммаВВалютеУчетаДт;
		ОбластьДанных.Параметры.ЗначениеПриемникКт= ВыборкаОбъектУчетаИсточник.СуммаВВалютеУчетаКт;
		
		ОбластьДанных.Параметры.РасхождениеДт	= ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаДт;
		ОбластьДанных.Параметры.РасхождениеКт	= ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаКт;
		
		ИтогоРасхождениеДт=ИтогоРасхождениеДт+ОбластьДанных.Параметры.РасхождениеДт;
		ИтогоРасхождениеКт=ИтогоРасхождениеКт+ОбластьДанных.Параметры.РасхождениеКт;
		
		ИтогоЗначениеИсточникДт=ИтогоЗначениеИсточникДт+ОбластьДанных.Параметры.ЗначениеИсточникДт;
		ИтогоЗначениеИсточникКт=ИтогоЗначениеИсточникКт+ОбластьДанных.Параметры.ЗначениеИсточникКт;
		
		СтруктураПараметровДт=Новый Структура("ДтКт","Дт");
		СтруктураПараметровКт=Новый Структура("ДтКт","Кт");

		
		СтруктураПараметровДт.Вставить("ОбъектУчетаИсточник",ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник);
		СтруктураПараметровКт.Вставить("ОбъектУчетаИсточник",ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник);
		
		ОбластьДанных.Параметры.РасшифровкаИсточникДт=СтруктураПараметровДт;
		ОбластьДанных.Параметры.РасшифровкаИсточникКт=СтруктураПараметровКт;
		
		ОбластьДанных.Параметры.РасшифровкаПриемникДт=СтруктураПараметровДт;
		ОбластьДанных.Параметры.РасшифровкаПриемникКт=СтруктураПараметровКт;
		
		ЕстьСоответствиеСчетов=Истина;
		
		СтрокаИсточник=ТаблицаСоответствия.Найти(ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточникНаименование,"ОбъектУчетаИсточникНаименование");
		
		Если СтрокаИсточник=Неопределено Тогда
			
			ЕстьСоответствиеСчетов=Ложь;
			ОбластьДанных.Параметры.СчетПриемник=НСтр("ru = 'Нет мэппинга'");
			ОбластьДанных.Параметры.РасшифровкаИсточникДт.Вставить("СчетПриемник","");
			ОбластьДанных.Параметры.РасшифровкаИсточникКт.Вставить("СчетПриемник","");
	
		КонецЕсли;
		
		Если ЕстьСоответствиеСчетов Тогда
			
			ПолучитьТаблицуСчетовПриемникОб(ВыборкаОбъектУчетаИсточник,ИтогоЗначениеПриемникДт,ИтогоЗначениеПриемникКт);
			
			Если ТаблицаСчетовПриемникОб.Количество()=0  Тогда
				
				ОбластьДанных.Параметры.СчетПриемник=СтрокаИсточник.СчетПриемник;
				
			ИначеЕсли ТаблицаСчетовПриемникОб.Количество()=1 Тогда
				
				СтрокаПриемник=ТаблицаСчетовПриемникОб[0];
				ЗаполнитьПараметрыОбластиДанныхОбороты(ОбластьДанных,СтрокаПриемник);
				
			КонецЕсли;
			
		КонецЕсли;

		ТабДок.Присоединить(ОбластьДанных);
		
		Если ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетПриемник) Тогда
			
			ВывестиДополнительнуюИнформациюОбороты(ТабДок,
				ОбластьОтступ,
				ОбластьДанных,
				ОбластьПодробно,
				ТаблицаСоответствия);
				
		КонецЕсли;
		
		Если ТаблицаСчетовПриемникОб.Количество()>1 Тогда 
			
			ТабДок.НачатьГруппуСтрок(""+ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник,Отчет.ПодробнаяИнформация);
			
			Для Каждого СтрокаПриемник ИЗ ТаблицаСчетовПриемникОб Цикл
								
				ТабДок.Вывести(ОбластьОтступ);
				
				ОбластьДанных.Параметры.ОбъектУчетаИсточник	= "";
				ОбластьДанных.Параметры.ЗначениеИсточникДт= 0;
				ОбластьДанных.Параметры.ЗначениеИсточникКт= 0;
				
				ОбластьДанных.Параметры.РасхождениеДт		= 0;
				ОбластьДанных.Параметры.РасхождениеКт		= 0;

				ЗаполнитьПараметрыОбластиДанныхОбороты(ОбластьДанных,СтрокаПриемник);
																
				ТабДок.Присоединить(ОбластьДанных);

				ВывестиДополнительнуюИнформациюОбороты(ТабДок,
				ОбластьОтступ,
				ОбластьДанных,
				ОбластьПодробно,
				ТаблицаСоответствия);
				
			КонецЦикла;
			
			ТабДок.ЗакончитьГруппуСтрок();
						
		КонецЕсли;
		
		ТабДок.Область(ТабДок.ВысотаТаблицы,2,ТабДок.ВысотаТаблицы,ТабДок.ШиринаТаблицы).ГраницаСнизу=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
		
	КонецЦикла;
	
	ОбластьИтого.Параметры.ИтогоРасхождениеДт=ИтогоРасхождениеДт;
	ОбластьИтого.Параметры.ИтогоРасхождениеКт=ИтогоРасхождениеКт;
	
	ОбластьИтого.Параметры.ИтогоЗначениеИсточникДт=ИтогоЗначениеИсточникДт;
	ОбластьИтого.Параметры.ИтогоЗначениеИсточникКт=ИтогоЗначениеИсточникКт;
	
	ОбластьИтого.Параметры.ИтогоЗначениеПриемникДт=ИтогоЗначениеПриемникДт;
	ОбластьИтого.Параметры.ИтогоЗначениеПриемникКт=ИтогоЗначениеПриемникКт;

	ТабДок.Вывести(ОбластьОтступ);
	ТабДок.Присоединить(ОбластьИтого);
	
		
КонецПроцедуры // ВывестиОтчет_Об()

&НаСервере
Процедура ВывестиОтчетСГруппировкойПоПериодам_Об(Запрос)
	
	Макет=Отчеты.ВыверкаТрансляцииРегистров.ПолучитьМакет("МакетОборотыДтКт_ВНА");
	
	ТаблицаСоответствия=ПолучитьТаблицуСоответствияСчетов();
	
	ОбластьДанных		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьДанных");
	ОбластьОтступ		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьОтступ");
	
	ОбластьСтрокаПериод		= Макет.ПолучитьОбласть("СтрокаПериод|ОбластьДанных");
	ОбластьСтрокаСостояние	= Макет.ПолучитьОбласть("СтрокаСостояние|ОбластьДанных");
	
	ОбластьИтого        = Макет.ПолучитьОбласть("СтрокаИтого|ОбластьДанных");
	
	ОбластьПодробно     = Макет.ПолучитьОбласть("СтрокаПодробно|ОбластьДанных");
	
	ИтогоРасхождениеДт=0;
	ИтогоРасхождениеКт=0;
	
	ИтогоЗначениеИсточникДт=0;
	ИтогоЗначениеИсточникКт=0;
	
	ИтогоЗначениеПриемникДт=0;
	ИтогоЗначениеПриемникКт=0;
	
	ВыборкаПериод=Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПериод.Следующий() Цикл
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("Период",ВыборкаПериод.Период);
		
		ТабДок.Вывести(ОбластьОтступ);
		
		ОбластьСтрокаПериод.Параметры.Период			= ОбщегоНазначенияУХ.ПолучитьПериодСтрокой(ВыборкаПериод.Период,XMLСтрока(Отчет.Периодичность));
		ОбластьСтрокаПериод.Параметры.ЗначениеИсточникДт= ВыборкаПериод.СуммаДт;
		ОбластьСтрокаПериод.Параметры.ЗначениеИсточникКт= ВыборкаПериод.СуммаКт;
		
		ОбластьСтрокаПериод.Параметры.ЗначениеПриемникДт= ВыборкаПериод.СуммаВВалютеУчетаДт;
		ОбластьСтрокаПериод.Параметры.ЗначениеПриемникКт= ВыборкаПериод.СуммаВВалютеУчетаКт;
		
		ОбластьСтрокаПериод.Параметры.РасхождениеДт		= ВыборкаПериод.Расхождение_Сумма_СуммаВВалютеУчетаДт;
		ОбластьСтрокаПериод.Параметры.РасхождениеКт		= ВыборкаПериод.Расхождение_Сумма_СуммаВВалютеУчетаКт;
		
		ТабДок.Присоединить(ОбластьСтрокаПериод);
		
		ТекстСостояния=ПолучитьСводноеСостояние(ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ВыборкаПериод.Период,ПериодичностьТрансляции,0));
		
		Если Не ПустаяСтрока(ТекстСостояния) Тогда
			
			ТабДок.Вывести(ОбластьОтступ);
			ОбластьСтрокаСостояние.Параметры.Состояние=ТекстСостояния;
			ТабДок.Присоединить(ОбластьСтрокаСостояние);
						
		КонецЕсли;
			
		ТабДок.НачатьГруппуСтрок(""+ОбластьСтрокаПериод.Параметры.Период,Ложь);
		
		ВыборкаОбъектУчетаИсточник=ВыборкаПериод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОбъектУчетаИсточник.Следующий() Цикл
		
		Если Отчет.ВыводитьТолькоОшибочные 
			И ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаДт=0
			И ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаКт=0 Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьОтступ);
		
		ОбластьДанных.Параметры.СчетПриемник	= "";
		
		ОбластьДанных.Параметры.ОбъектУчетаИсточник	= ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник;
		
		ОбластьДанных.Параметры.ЗначениеИсточникДт= ВыборкаОбъектУчетаИсточник.СуммаДт;
		ОбластьДанных.Параметры.ЗначениеИсточникКт= ВыборкаОбъектУчетаИсточник.СуммаКт;
		
		ОбластьДанных.Параметры.ЗначениеПриемникДт= ВыборкаОбъектУчетаИсточник.СуммаВВалютеУчетаДт;
		ОбластьДанных.Параметры.ЗначениеПриемникКт= ВыборкаОбъектУчетаИсточник.СуммаВВалютеУчетаКт;
		
		ОбластьДанных.Параметры.РасхождениеДт	= ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаДт;
		ОбластьДанных.Параметры.РасхождениеКт	= ВыборкаОбъектУчетаИсточник.Расхождение_Сумма_СуммаВВалютеУчетаКт;
		
		ИтогоРасхождениеДт=ИтогоРасхождениеДт+ОбластьДанных.Параметры.РасхождениеДт;
		ИтогоРасхождениеКт=ИтогоРасхождениеКт+ОбластьДанных.Параметры.РасхождениеКт;
		
		ИтогоЗначениеИсточникДт=ИтогоЗначениеИсточникДт+ОбластьДанных.Параметры.ЗначениеИсточникДт;
		ИтогоЗначениеИсточникКт=ИтогоЗначениеИсточникКт+ОбластьДанных.Параметры.ЗначениеИсточникКт;
		
		СтруктураПараметровДт=Новый Структура("ДтКт","Дт");
		СтруктураПараметровКт=Новый Структура("ДтКт","Кт");

		
		СтруктураПараметровДт.Вставить("ОбъектУчетаИсточник",ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник);
		СтруктураПараметровКт.Вставить("ОбъектУчетаИсточник",ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник);
		
		ОбластьДанных.Параметры.РасшифровкаИсточникДт=СтруктураПараметровДт;
		ОбластьДанных.Параметры.РасшифровкаИсточникКт=СтруктураПараметровКт;
		
		ОбластьДанных.Параметры.РасшифровкаПриемникДт=СтруктураПараметровДт;
		ОбластьДанных.Параметры.РасшифровкаПриемникКт=СтруктураПараметровКт;
		
		ЕстьСоответствиеСчетов=Истина;
		
		СтрокаИсточник=ТаблицаСоответствия.Найти(ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточникНаименование,"ОбъектУчетаИсточникНаименование");
		
		Если СтрокаИсточник=Неопределено Тогда
			
			ЕстьСоответствиеСчетов=Ложь;
			ОбластьДанных.Параметры.СчетПриемник=НСтр("ru = 'Нет мэппинга'");
			ОбластьДанных.Параметры.РасшифровкаИсточникДт.Вставить("СчетПриемник","");
			ОбластьДанных.Параметры.РасшифровкаИсточникКт.Вставить("СчетПриемник","");
	
		КонецЕсли;
				
		Если ЕстьСоответствиеСчетов Тогда
			
			ПолучитьТаблицуСчетовПриемникОб(ВыборкаОбъектУчетаИсточник,ИтогоЗначениеПриемникДт,ИтогоЗначениеПриемникКт);
			
			Если ТаблицаСчетовПриемникОб.Количество()=0  Тогда
				
				ОбластьДанных.Параметры.СчетПриемник=СтрокаИсточник.СчетПриемник;
				
			ИначеЕсли ТаблицаСчетовПриемникОб.Количество()=1 Тогда
				
				СтрокаПриемник=ТаблицаСчетовПриемникОб[0];
				ЗаполнитьПараметрыОбластиДанныхОбороты(ОбластьДанных,СтрокаПриемник);
				
			КонецЕсли;
			
		КонецЕсли;

		ТабДок.Присоединить(ОбластьДанных);
		
		Если ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетПриемник) Тогда
			
			ВывестиДополнительнуюИнформациюОбороты(ТабДок,
				ОбластьОтступ,
				ОбластьДанных,
				ОбластьПодробно,
				ТаблицаСоответствия);
				
		КонецЕсли;
		
		Если ТаблицаСчетовПриемникОб.Количество()>1 Тогда 
			
			ТабДок.НачатьГруппуСтрок(""+ВыборкаОбъектУчетаИсточник.ОбъектУчетаИсточник,Отчет.ПодробнаяИнформация);
			
			Для Каждого СтрокаПриемник ИЗ ТаблицаСчетовПриемникОб Цикл
								
				ТабДок.Вывести(ОбластьОтступ);
				
				ОбластьДанных.Параметры.ОбъектУчетаИсточник	= "";
				ОбластьДанных.Параметры.ЗначениеИсточникДт= 0;
				ОбластьДанных.Параметры.ЗначениеИсточникКт= 0;
				
				ОбластьДанных.Параметры.РасхождениеДт		= 0;
				ОбластьДанных.Параметры.РасхождениеКт		= 0;

				ЗаполнитьПараметрыОбластиДанныхОбороты(ОбластьДанных,СтрокаПриемник);
																
				ТабДок.Присоединить(ОбластьДанных);

				ВывестиДополнительнуюИнформациюОбороты(ТабДок,
				ОбластьОтступ,
				ОбластьДанных,
				ОбластьПодробно,
				ТаблицаСоответствия);
				
			КонецЦикла;
			
			ТабДок.ЗакончитьГруппуСтрок();
						
		КонецЕсли;
		
		ТабДок.Область(ТабДок.ВысотаТаблицы,2,ТабДок.ВысотаТаблицы,ТабДок.ШиринаТаблицы).ГраницаСнизу=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
		
	КонецЦикла;
	
	 ТабДок.ЗакончитьГруппуСтрок();
		
КонецЦикла;

ОбластьИтого.Параметры.ИтогоРасхождениеДт=ИтогоРасхождениеДт;
	ОбластьИтого.Параметры.ИтогоРасхождениеКт=ИтогоРасхождениеКт;
	
	ОбластьИтого.Параметры.ИтогоЗначениеИсточникДт=ИтогоЗначениеИсточникДт;
	ОбластьИтого.Параметры.ИтогоЗначениеИсточникКт=ИтогоЗначениеИсточникКт;
	
	ОбластьИтого.Параметры.ИтогоЗначениеПриемникДт=ИтогоЗначениеПриемникДт;
	ОбластьИтого.Параметры.ИтогоЗначениеПриемникКт=ИтогоЗначениеПриемникКт;
	
	ТабДок.Вывести(ОбластьОтступ);
	ТабДок.Присоединить(ОбластьИтого);
	
КонецПроцедуры // ВывестиОтчетСГруппировкойПоПериодам_Об()

&НаСервере
Процедура ВывестиДополнительнуюИнформацию(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ТаблицаСоответствия)
										
	Перем ОбъектУчетаИсточникДт;
	Перем СчетДтПриемник;
	Перем ОбъектУчетаИсточникКт;
	Перем СчетКтПриемник; 
	
	Если НЕ Отчет.ПодробнаяИнформация Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураПараметров=ОбластьДанных.Параметры.РасшифровкаПриемник;									
	СтруктураПараметров.Свойство("ОбъектУчетаИсточникДт",ОбъектУчетаИсточникДт);
	СтруктураПараметров.Свойство("СчетДтПриемник",СчетДтПриемник);
	СтруктураПараметров.Свойство("ОбъектУчетаИсточникКт",ОбъектУчетаИсточникКт);
	СтруктураПараметров.Свойство("СчетКтПриемник",СчетКтПриемник);
	
	СтрокиПодробноДт=ТаблицаСоответствия.НайтиСтроки(Новый Структура("ОбъектУчетаИсточник,СчетПриемник",ОбъектУчетаИсточникДт,СчетДтПриемник));
	СтрокиПодробноКт=ТаблицаСоответствия.НайтиСтроки(Новый Структура("ОбъектУчетаИсточник,СчетПриемник",ОбъектУчетаИсточникКт,СчетКтПриемник));
	
	ЕстьПодробнаяИнформация=Ложь;
	
	Если СтрокиПодробноДт.Количество()>0 Тогда
		
		ОбластьПодробно.Параметры.ОтборДт=СтрокиПодробноДт[0].ОтборПодробно;
		ОбластьПодробно.Параметры.СоответствиеДт=СтрокиПодробноДт[0].СоответствиеПодробно;
		ЕстьПодробнаяИнформация=Истина;
		
	КонецЕсли;
	
	Если СтрокиПодробноКт.Количество()>0 Тогда
		
		ОбластьПодробно.Параметры.ОтборКт=СтрокиПодробноКт[0].ОтборПодробно;
		ОбластьПодробно.Параметры.СоответствиеКт=СтрокиПодробноКт[0].СоответствиеПодробно;
		ЕстьПодробнаяИнформация=Истина;
		
	КонецЕсли;
	
	Если Не ЕстьПодробнаяинформация Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОбластьПодробно.Параметры.РасшифровкаПриемник=СтруктураПараметров;
	
	ТабДок.Вывести(ОбластьОтступ);
	ТабДок.Присоединить(ОбластьПодробно);	
										
КонецПроцедуры // ВывестиДополнительнуюИнформацию()

&НаСервере
Процедура ВывестиДополнительнуюИнформациюОбороты(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ТаблицаСоответствия)
										
	Перем ОбъектУчетаИсточник;
	Перем СчетПриемник;
		
	Если НЕ Отчет.ПодробнаяИнформация Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураПараметров=ОбластьДанных.Параметры.РасшифровкаПриемникДт;									
	СтруктураПараметров.Свойство("ОбъектУчетаИсточник",ОбъектУчетаИсточник);
	СтруктураПараметров.Свойство("СчетПриемник",СчетПриемник);
		
	СтрокиПодробно=ТаблицаСоответствия.НайтиСтроки(Новый Структура("ОбъектУчетаИсточник,СчетПриемник",ОбъектУчетаИсточник,СчетПриемник));
	
	ЕстьПодробнаяИнформация=Ложь;
	
	Если СтрокиПодробно.Количество()>0 Тогда
		
		ОбластьПодробно.Параметры.Отбор=СтрокиПодробно[0].ОтборПодробно;
		ОбластьПодробно.Параметры.Соответствие=СтрокиПодробно[0].СоответствиеПодробно;
		ЕстьПодробнаяИнформация=Истина;
		
	КонецЕсли;
		
	Если Не ЕстьПодробнаяинформация Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОбластьПодробно.Параметры.РасшифровкаПриемникДт=СтруктураПараметров;
	
	ТабДок.Вывести(ОбластьОтступ);
	ТабДок.Присоединить(ОбластьПодробно);
		
										
КонецПроцедуры // ВывестиДополнительнуюИнформациюОбороты()
										
										
										
										
 

&НаКлиенте
Процедура ПериодОтчетаПриИзменении(Элемент)
	
	ПриИзмененииПериода();
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиМэппинга(Команда)
	
	Если НЕ ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не указан шаблон корректировки'"));
		Возврат;
		
	КонецЕсли;
		
	 ОткрытьФорму("Обработка.УстановкаСоответствияРегистров.Форма",Новый Структура("ШаблонТрансляции,НаправлениеТрансляции",Отчет.ШаблонКорректировки,ПредопределенноеЗначение("Перечисление.НаправленияТрансляцииДанных.ФинансовыеРегистрыВРегистрБухгалтерии")));
	
 КонецПроцедуры
 
