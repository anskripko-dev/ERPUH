	ОпределитьПравилоОбработки();
		
КонецПроцедуры // ПриИзмененииШаблонаКорректировки()

&НаСервере
Процедура ПерезаполнитьДокументыНаСервере()

	СпособТрансляции=ОпределитьСпособТрансляции();
	
	Если ЗначениеЗаполнено(Отчет.ДокументТрансляции) Тогда
		
		МассивДокументов=Новый Массив;
		МассивДокументов.Добавить(Отчет.ДокументТрансляции);
		Обработки.КорректировкиЗначенийПоказателей.ОбновитьДокументыТрансляции(МассивДокументов,Неопределено);
		
	ИначеЕсли СпособТрансляции=Перечисления.СпособыТрансляции.ПоДокументамОбработка
		ИЛИ СпособТрансляции=Перечисления.СпособыТрансляции.ПоДокументамПриПроведении
		ИЛИ СпособТрансляции=Перечисления.СпособыТрансляции.ПоДокументамФоновоеЗадание Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	Трансляция.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Трансляция КАК Трансляция
		|ГДЕ
		|	Трансляция.ПериодОтчета.ДатаНачала >= &ДатаНачала
		|	И Трансляция.ПериодОтчета.ДатаОкончания <= &ДатаОкончания
		|	И Трансляция.ШаблонКорректировки = &ШаблонКорректировки
		|	И Трансляция.Организация = &Организация";
		
		Запрос.УстановитьПараметр("ДатаНачала",			Отчет.ПериодОтчета.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",		Отчет.ПериодОкончания.ДатаОкончания);
		Запрос.УстановитьПараметр("ШаблонКорректировки",Отчет.ШаблонКорректировки);
		Запрос.УстановитьПараметр("Организация",		Отчет.Организация);
		
		МассивДокументов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Обработки.КорректировкиЗначенийПоказателей.ОбновитьДокументыТрансляции(МассивДокументов,Неопределено);
				
	Иначе
			
		ПериодыКорреспонденции=ПолучитьПериодыКорреспонденцииИсточник();
		
		Для Каждого СтрПериод ИЗ ПериодыКорреспонденции Цикл
			
			ПериодТрансляции=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(СтрПериод.Период,ПериодичностьТрансляции,0);
			
		    КорректировкиЗначенийПоказателей32.ОбработатьКорректировкиПоПараметрам(Перечисления.ВидыДокументовЭтапа.ДокументыТрансляции,
			ПериодТрансляции,
			Отчет.Сценарий,
			Отчет.Организация,
			Отчет.ШаблонКорректировки,
			СтрПериод.Период);
			
		КонецЦикла;
			
	КонецЕсли;
	
    СформироватьОтчетНаСервере();
	ОтобразитьПанельСостояния("");
			
КонецПроцедуры

