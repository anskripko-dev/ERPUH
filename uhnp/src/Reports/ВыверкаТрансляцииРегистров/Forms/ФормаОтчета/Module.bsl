&НаКлиенте
Процедура ТабДокОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Если Не ТипЗнч(Расшифровка)=Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
		
	СтандартнаяОбработка=Ложь;
	
	Если ТипОтчета="Корреспонденция" Тогда
		
		ОбработкаРасшифровкиКорреспонденция(Расшифровка);
		
	Иначе
		
		ОбработкаРасшифровкиОбороты(Расшифровка);
		
	КонецЕсли;
						
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРасшифровкиКорреспонденция(Расшифровка)
	
	СписокДействий=Новый СписокЗначений;		
	
	СписокДействий=Новый СписокЗначений;
	СписокДействий.Добавить("ОткрытьНастройкуСоответствияДт",Нстр("ru = 'Открыть настройку соответствия (дт.)'"));
	СписокДействий.Добавить("ОткрытьНастройкуСоответствияКт",Нстр("ru = 'Открыть настройку соответствия (кт.)'"));
	
	Если Расшифровка.Свойство("ОбъектУчетаИсточникДт") Тогда
		
		СписокДействий.Добавить("АнализКорреспонденции",СтрШаблон(Нстр("ru = 'Анализ корреспонденции %1 - %2'"), Расшифровка.ОбъектУчетаИсточникДт,Расшифровка.ОбъектУчетаИсточникКт));
		
		Если Расшифровка.Свойство("СчетДтПриемник") И Расшифровка.Свойство("СчетКтПриемник") Тогда
			
			СписокДействий.Добавить("ОтчетПоПроводкамПриемник",СтрШаблон(Нстр("ru = 'Отчет по проводкам %1: Дт %2 - Кт %3'"), ПланСчетовПриемник, 
				Расшифровка.СчетДтПриемник, Расшифровка.СчетКтПриемник));
			СписокДействий.Добавить("КарточкаСчетаПриемникДт",СтрШаблон(Нстр("ru = 'Карточка счета %1 %2'"), ПланСчетовПриемник, Расшифровка.СчетДтПриемник));
			СписокДействий.Добавить("КарточкаСчетаПриемникКт",СтрШаблон(Нстр("ru = 'Карточка счета %1 %2'"), ПланСчетовПриемник, Расшифровка.СчетКтприемник));
			
		КонецЕсли;
		
	КонецЕсли;
			
	ДопПараметры = Новый Структура("Расшифровка", Расшифровка);
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработатьРасшифровкуДтКт", ЭтотОбъект, ДопПараметры);
	ПоказатьВыборИзСписка(Оповещение, СписокДействий);
	
	
КонецПроцедуры // ОбработкаРасшифровкиКорреспонденция() 

&НаКлиенте
Процедура ОбработкаРасшифровкиОбороты(Расшифровка)
	
	Если НЕ Расшифровка.Свойство("ОбъектУчетаИсточник") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СписокДействий=Новый СписокЗначений;
	
	Если Расшифровка.Свойство("ОбъектУчетаИсточник") И Расшифровка.Свойство("СчетПриемник") Тогда 
		
		СписокДействий.Добавить("ОткрытьНастройкуСоответствия",Нстр("ru = 'Открыть настройку соответствия'"));
		
	КонецЕсли;
	
	СписокДействий.Добавить("РасшифроватьПоКорреспонденции",Нстр("ru = 'Расшифровать по корреспонденции'"));
	СписокДействий.Добавить("АнализКорреспонденции",СтрШаблон(Нстр("ru = 'Движения по объекту учета %1'"), Расшифровка.ОбъектУчетаИсточник));
		
	ДопПараметры = Новый Структура("Расшифровка", Расшифровка);
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработатьРасшифровкуОбороты", ЭтотОбъект, ДопПараметры);
	ПоказатьВыборИзСписка(Оповещение, СписокДействий);
		
КонецПроцедуры // ОбработкаРасшифровкиОбороты()

&НаКлиенте
Процедура ОткрытьНастройкуСоответствия(ТекстНастройки,Расшифровка)
	
	Перем ОбъектУчетаИсточникДт;
	Перем ОбъектУчетаИсточникКт;
	Перем СчетДтПриемник;
	Перем СчетКтПриемник;
	
	Расшифровка.Свойство("ОбъектУчетаИсточникДт",ОбъектУчетаИсточникДт);
	Расшифровка.Свойство("ОбъектУчетаИсточникКт",ОбъектУчетаИсточникКт);
	Расшифровка.Свойство("СчетДтПриемник",СчетДтПриемник);
	Расшифровка.Свойство("СчетКтПриемник",СчетКтПриемник);
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ШаблонТрансляции",Отчет.ШаблонКорректировки);
	
	Если ТекстНастройки="ОткрытьНастройкуСоответствияДт" Тогда
		
		СтруктураПараметров.Вставить("ОбъектУчетаИсточник",ОбъектУчетаИсточникДт);
		СтруктураПараметров.Вставить("СчетПриемник",СчетДтПриемник);
		
	Иначе
		
		СтруктураПараметров.Вставить("ОбъектУчетаИсточник",ОбъектУчетаИсточникКт);
		СтруктураПараметров.Вставить("СчетПриемник",СчетКтПриемник);
		
	КонецЕсли;
	
	ОткрытьФорму("Обработка.УстановкаСоответствияРегистров.Форма.ФормаНастройкиСоответствия",СтруктураПараметров,,ЭтаФорма);
			
КонецПроцедуры // ОткрытьНастройкуСоответствия()

&НаКлиенте
Процедура Подключаемый_ОбработатьРасшифровкуДтКт(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
    
    Расшифровка = ДополнительныеПараметры.Расшифровка;    
    ВыбранноеДействие = ВыбранныйЭлемент;
    
    Если ВыбранноеДействие = Неопределено Тогда
        
        Возврат;
		
	ИначеЕсли СтрНайти(ВыбранноеДействие.Значение,"ОткрытьНастройкуСоответствия")>0 Тогда
		
		 ОткрытьНастройкуСоответствия(ВыбранноеДействие.Значение,Расшифровка);	
        
    ИначеЕсли ВыбранноеДействие.Значение="АнализКорреспонденции" Тогда
			
		ПараметрыФормы = ПолучитьПараметрыОтчетаПоРегистрам(Расшифровка);
        ОткрытьФорму("Отчет.АнализКорреспонденцийОперативногоУчета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
		
	 ИначеЕсли СтрНайти(ВыбранноеДействие.Значение,"ОтчетПоПроводкам")>0
        ИЛИ СтрНайти(ВыбранноеДействие.Значение, "КарточкаСчета")>0 Тогда
		
		ПараметрыФормы = ПолучитьСтруктуруПараметровДляРасшифровки(Расшифровка,ВыбранноеДействие.Значение);
        ОткрытьФорму("Отчет.ОтчетПоРегиструБухгалтерииБД.Форма.ФормаОтчета", ПараметрыФормы,, Истина);	
        
    КонецЕсли;

КонецПроцедуры 

&НаСервере
Функция ПолучитьПараметрыОтчетаПоРегистрам(Расшифровка,ДтКт="")
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "АнализКорреспонденцийПоДокументам");
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	
	ЗначенияПользовательскихНастроек = Новый Структура();
	ЗначенияПользовательскихНастроек.Вставить("Организация", Отчет.Организация);
	ЗначенияПользовательскихНастроек.Вставить("ПериодОтчета", Новый СтандартныйПериод(НачалоМесяца(Отчет.ДатаНач), КонецМесяца(Отчет.ДатаКон)));
	
	Если Расшифровка.Свойство("ОбъектУчетаИсточникДт") Тогда
		ЗначенияПользовательскихНастроек.Вставить("ОбъектУчетаДт", Расшифровка.ОбъектУчетаИсточникДт.ОбъектУчета); 
	КонецЕсли; 
	
	Если Расшифровка.Свойство("ОбъектУчетаИсточникКт") Тогда
		ЗначенияПользовательскихНастроек.Вставить("ОбъектУчетаКт", Расшифровка.ОбъектУчетаИсточникКт.ОбъектУчета); 
	КонецЕсли; 
	
	Если Расшифровка.Свойство("ОбъектУчетаИсточник") Тогда 
		
		Если Расшифровка.ДтКт="Дт" Тогда
			
			ЗначенияПользовательскихНастроек.Вставить("ОбъектУчетаДт", Расшифровка.ОбъектУчетаИсточник.ОбъектУчета); 
			
		Иначе
			
			ЗначенияПользовательскихНастроек.Вставить("ОбъектУчетаКт", Расшифровка.ОбъектУчетаИсточник.ОбъектУчета);
			
		КонецЕсли;
			
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		ПараметрОтбор = Новый Структура();
		ПараметрОтбор.Вставить("Регистратор", Отчет.ИсходныйДокумент);
		ПараметрыФормы.Вставить("Отбор",ПараметрОтбор);
	КонецЕсли;
		
	ПараметрыФормы.Вставить("ПользовательскиеНастройки",
					МеждународныйУчетПоДаннымФинансовыхРегистровВызовСервера.ПользовательскиеНастройкиАнализаОперативногоУчета("АнализКорреспонденцийОперативногоУчета",ЗначенияПользовательскихНастроек));

	Возврат ПараметрыФормы;					
		
КонецФункции // ПолучитьПараметрыОтчетаПоПроводкам()

&НаКлиенте
Функция ПолучитьПараметрыОтчетаДляРасшифровки()
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("Организация",				Отчет.Организация);
	СтруктураПараметров.Вставить("Сценарий",				Отчет.Сценарий);
	СтруктураПараметров.Вставить("ПериодОтчета",			Отчет.ПериодОтчета);
	СтруктураПараметров.Вставить("ШаблонКорректировки",		Отчет.ШаблонКорректировки);
	СтруктураПараметров.Вставить("ИспользуемаяИБ",			Отчет.ИспользуемаяИБ);
	СтруктураПараметров.Вставить("ИсходныйДокумент",		Отчет.ИсходныйДокумент);
	СтруктураПараметров.Вставить("ДокументТрансляции",		Отчет.ДокументТрансляции);
	СтруктураПараметров.Вставить("ПериодОтражения",			Отчет.ПериодОтражения);
	СтруктураПараметров.Вставить("ПодробнаяИнформация",		Отчет.ПодробнаяИнформация);
	СтруктураПараметров.Вставить("ВыводитьТолькоОшибочные",	Отчет.ВыводитьТолькоОшибочные);

	Возврат СтруктураПараметров;
	
КонецФункции // ПолучитьПараметрыОтчетаДляРасшифровки() 

&НаКлиенте
Процедура Подключаемый_ОбработатьРасшифровкуОбороты(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
    
    Расшифровка = ДополнительныеПараметры.Расшифровка;    
    ВыбранноеДействие = ВыбранныйЭлемент;
    
    Если ВыбранноеДействие = Неопределено Тогда
        
        Возврат;
		
	ИначеЕсли ВыбранноеДействие.Значение="ОткрытьНастройкуСоответствия" Тогда
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("ШаблонТрансляции",Отчет.ШаблонКорректировки);
		СтруктураПараметров.Вставить("ОбъектУчетаИсточник",Расшифровка.ОбъектУчетаИсточник);
		СтруктураПараметров.Вставить("СчетПриемник",Расшифровка.СчетПриемник);
			
		ОткрытьФорму("Обработка.УстановкаСоответствияСчетов.Форма.ФормаНастройкиСоответствия",СтруктураПараметров,,ЭтаФорма);
		
	ИначеЕсли ВыбранноеДействие.Значение="РасшифроватьПоКорреспонденции" Тогда	
		
		ДанныеОтчета=ПолучитьПараметрыОтчетаДляРасшифровки();
		
		Если Расшифровка.ДтКт="Дт" Тогда
			
			ДанныеОтчета.Вставить("ОбъектУчетаИсточникДт",Расшифровка.ОбъектУчетаИсточник);
			
		Иначе
			
			ДанныеОтчета.Вставить("ОбъектУчетаИсточникКт",Расшифровка.ОбъектУчетаИсточник);
			
		КонецЕсли;
				
		ДанныеОтчета.Вставить("ТипОтчета","Корреспонденция");
		ДанныеОтчета.Вставить("ФормироватьОтчет", Истина);
        
        ОткрытьФорму("Отчет.ВыверкаТрансляцииРегистров.ФормаОбъекта", ДанныеОтчета,,Новый УникальныйИдентификатор);
					
    ИначеЕсли ТипЗнч(ВыбранноеДействие.Значение) = Тип("ПеречислениеСсылка.Периодичность") Тогда
		
		ДанныеОтчета=ПолучитьПараметрыОтчетаДляРасшифровки();
		
        ДанныеОтчета.Вставить("НоваяПериодичность",		ВыбранноеДействие.Значение);
        ДанныеОтчета.Вставить("ИсходнаяПериодичность",	Отчет.Периодичность);
        ДанныеОтчета.Вставить("ОбъектУчетаИсточник",	Расшифровка.ОбъектУчетаИсточник);
		ДанныеОтчета.Вставить("ТипОтчета",				ТипОтчета);
         
        Если Расшифровка.Свойство("Период") Тогда
            
            ДанныеОтчета.Вставить("Период",Расшифровка.Период);
            
        КонецЕсли;
        
        ДанныеОтчета.Вставить("ФормироватьОтчет", Истина);
        
        ОткрытьФорму("Отчет.ВыверкаТрансляцииРегистров.ФормаОбъекта", ДанныеОтчета,,Новый УникальныйИдентификатор);
        
    ИначеЕсли ВыбранноеДействие.Значение="АнализСчета" Тогда
		
		ПараметрыФормы = ПолучитьСтруктуруПараметровДляРасшифровки(Расшифровка,ВыбранноеДействие.Значение);
        ОткрытьФорму("Отчет.ОтчетПоРегиструБухгалтерииБД.Форма.ФормаОтчета", ПараметрыФормы,, Истина);
		
	 ИначеЕсли ВыбранноеДействие.Значение="АнализКорреспонденции" Тогда
			
		ПараметрыФормы = ПолучитьПараметрыОтчетаПоРегистрам(Расшифровка);
        ОткрытьФорму("Отчет.АнализКорреспонденцийОперативногоУчета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);	
		
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПараметровДляРасшифровки(Расшифровка,ТипОтчетаПоРегистру)
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("РегистрБД",Отчет.ШаблонКорректировки.РегистрБухгалтерииПриемник);
	СтруктураПараметров.Вставить("ПланСчетовБД",Отчет.ШаблонКорректировки.ПланСчетовПриемник);
	
	Если Расшифровка.Свойство("Период") Тогда
		
		СтруктураПараметров.Вставить("ДатаНач",ОбщегоНазначенияУХ.ДатаНачалаПериода(Расшифровка.Период,Отчет.Периодичность));
		СтруктураПараметров.Вставить("ДатаКон",ОбщегоНазначенияУХ.ДатаКонцаПериода(Расшифровка.Период,Отчет.Периодичность));
		
	Иначе
		
		СтруктураПараметров.Вставить("ДатаНач",Отчет.ДатаНач);
		СтруктураПараметров.Вставить("ДатаКон",Отчет.ДатаКон);
		
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ФормироватьПриОткрытии",Истина);
	СтруктураПараметров.Вставить("ПоСубсчетам",Истина);
			
	ОтборПоИзмерениям=Новый Массив;
	ОтборПоИзмерениям.Добавить(Новый Структура("ИмяПараметра,Значение","Организация",Отчет.Организация));
			
	Если  ТипОтчетаПоРегистру="ОтчетПоПроводкамПриемник" Тогда
		
		ОтборПоИзмерениям.Добавить(Новый Структура("ИмяПараметра,Значение","Сценарий",Отчет.Сценарий));	
		
		СтруктураПараметров.Вставить("ТипБД",				Справочники.ТипыБазДанных.ТекущаяИБ);
		СтруктураПараметров.Вставить("Счет",				Расшифровка.СчетДтПриемник);
		СтруктураПараметров.Вставить("КоррСчет",			Расшифровка.СчетКтПриемник);
		СтруктураПараметров.Вставить("ВидОтчета",			"ОтчетПоПроводкам");
		
		КолонкаРесурс="РесурсПриемник";
		
	ИначеЕсли  ТипОтчетаПоРегистру="КарточкаСчетаПриемникДт" Тогда
		
		ОтборПоИзмерениям.Добавить(Новый Структура("ИмяПараметра,Значение","Сценарий",Отчет.Сценарий));	
		
		СтруктураПараметров.Вставить("ТипБД",				Справочники.ТипыБазДанных.ТекущаяИБ);
		СтруктураПараметров.Вставить("Счет",				Расшифровка.СчетДтПриемник);
		СтруктураПараметров.Вставить("ВидОтчета",			"КарточкаСчета");
		
		КолонкаРесурс="РесурсПриемник";
		
	ИначеЕсли  ТипОтчетаПоРегистру="КарточкаСчетаПриемникКт" Тогда
		
		ОтборПоИзмерениям.Добавить(Новый Структура("ИмяПараметра,Значение","Сценарий",Отчет.Сценарий));	
		
		СтруктураПараметров.Вставить("ТипБД",				Справочники.ТипыБазДанных.ТекущаяИБ);
		СтруктураПараметров.Вставить("Счет",				Расшифровка.СчетКтПриемник);
		СтруктураПараметров.Вставить("ВидОтчета",			"КарточкаСчета");
		
		КолонкаРесурс="РесурсПриемник";
	
	КонецЕсли;	
	
	СтруктураПараметров.Вставить("ОтборПоИзмерениям",ОтборПоИзмерениям);
	
	СписокПоказателей=Новый СписокЗначений;
	
	Для Каждого СтрРесурс ИЗ Отчет.ШаблонКорректировки.СоответствиеРесурсов Цикл
		
		Если ЗначениеЗаполнено(СтрРесурс.РесурсИсточник) 
			И ЗначениеЗаполнено(СтрРесурс.РесурсПриемник) Тогда
			
			СписокПоказателей.Добавить(СтрРесурс[КолонкаРесурс]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураПараметров.Вставить("СписокПоказателей",СписокПоказателей);
	
	Возврат СтруктураПараметров;
		
КонецФункции // ПолучитьСтруктуруПараметровДляРасшифровки()

