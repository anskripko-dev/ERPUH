		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры		// ВыбратьОтборДиаграммыПоМетрике()

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	НастройкиКомпоновщика = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрМетрика = Новый ПараметрКомпоновкиДанных("Метрика");
	НайденнаяМетрика = "";
	Для Каждого ТекЭлементы Из НастройкиКомпоновщика.ПараметрыДанных.Элементы Цикл
		Если ТекЭлементы.Параметр = ПараметрМетрика Тогда
			НайденнаяМетрика = ТекЭлементы.Значение;
		Иначе
			// Продолжаем поиск.
		КонецЕсли;	
	КонецЦикла;	
	Если НЕ ЗначениеЗаполнено(НайденнаяМетрика) Тогда
		НайденнаяМетрика = "ЗатратыНаМероприятия";
	Иначе
		// Выполняем далее.
	КонецЕсли;
	ВыбратьПолеДиаграммыПоМетрике(НастройкиКомпоновщика, НайденнаяМетрика);
	ВыбратьОтборДиаграммыПоМетрике(НастройкиКомпоновщика, НайденнаяМетрика);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновщика);
КонецПроцедуры

