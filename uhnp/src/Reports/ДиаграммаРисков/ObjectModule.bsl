// Устанавливает выбранные поля в диаграмме с настройками НастройкиВход
// согласно метрике МетрикаВход.
Процедура ВыбратьПолеДиаграммыПоМетрике(НастройкиВход, МетрикаВход)
	ПолеЗатратыНаИнциденты = Новый ПолеКомпоновкиДанных("ЗатратыНаИнциденты");
	ПолеЗатратыНаИнцидентыПредыдущегоПериода = Новый ПолеКомпоновкиДанных("ЗатратыНаИнцидентыПредыдущегоПериода");
	ПолеЗатратыНаМероприятия = Новый ПолеКомпоновкиДанных("ЗатратыНаМероприятия");
	ПолеКоличествоИнцидентов = Новый ПолеКомпоновкиДанных("КоличествоИнцидентов");
	ПолеКоличествоМероприятий = Новый ПолеКомпоновкиДанных("КоличествоМероприятий");
	ПолеКоличествоРеакций = Новый ПолеКомпоновкиДанных("КоличествоРеакций");
	ПолеМаксимальноВозможныйУбыток = Новый ПолеКомпоновкиДанных("МаксимальноВозможныйУбыток");
	ПолеУровеньВероятности = Новый ПолеКомпоновкиДанных("УровеньВероятности");
	ПолеО1 = Новый ПолеКомпоновкиДанных("Отн1");
	ПолеО2 = Новый ПолеКомпоновкиДанных("Отн2");
	ПолеО3 = Новый ПолеКомпоновкиДанных("Отн3");
	ПолеО4 = Новый ПолеКомпоновкиДанных("Отн4");
	ПолеО5 = Новый ПолеКомпоновкиДанных("Отн5");
	ПолеПлановыеЗатратыМероприятий = Новый ПолеКомпоновкиДанных("ПлановыеЗатратыМероприятий");
	ПолеПлановыеЗатратыРеакций = Новый ПолеКомпоновкиДанных("ПлановыеЗатратыРеакций");
	ПолеПризнанныйУбыток = Новый ПолеКомпоновкиДанных("ПризнанныйУбыток");
	ПолеПризнанныйУбытокПред = Новый ПолеКомпоновкиДанных("ПризнанныйУбытокПред");
	ПолеПрогнозныйУбыток = Новый ПолеКомпоновкиДанных("ПрогнозныйУбыток");
	ПолеСуммаЗатратПланТек = Новый ПолеКомпоновкиДанных("СуммаЗатратПланТек");
	ПолеСуммаЗатратФактТек = Новый ПолеКомпоновкиДанных("СуммаЗатратФактТек");
	ПолеФактическиеЗатратыМероприятий = Новый ПолеКомпоновкиДанных("ФактическиеЗатратыМероприятий");
	ПолеФактическиеЗатратыРеакцииПредыдущегоПериода = Новый ПолеКомпоновкиДанных("ФактическиеЗатратыРеакцииПредыдущегоПериода");
	ПолеФактическиеЗатратыРеакций = Новый ПолеКомпоновкиДанных("ФактическиеЗатратыРеакций");
	Для Каждого ТекСтруктура Из НастройкиВход.Структура Цикл
		Если ТекСтруктура.Имя = "ДиаграммаАнализ" Тогда
			Для Каждого ТекЭлементы Из ТекСтруктура.Выбор.Элементы Цикл
				Если ТекЭлементы.Поле = ПолеО1 Тогда 
					ТекЭлементы.Использование = (МетрикаВход = О1Представление());
				ИначеЕсли ТекЭлементы.Поле = ПолеО2 Тогда 
					ТекЭлементы.Использование = (МетрикаВход = О2Представление());
				ИначеЕсли ТекЭлементы.Поле = ПолеО3 Тогда 
					ТекЭлементы.Использование = (МетрикаВход = О3Представление());
				ИначеЕсли ТекЭлементы.Поле = ПолеО4 Тогда 
					ТекЭлементы.Использование = (МетрикаВход = О4Представление());
				ИначеЕсли ТекЭлементы.Поле = ПолеО5 Тогда 
					ТекЭлементы.Использование = (МетрикаВход = О5Представление());
				ИначеЕсли ТекЭлементы.Поле = ПолеЗатратыНаИнциденты Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ЗатратыНаИнцидентыПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеЗатратыНаИнцидентыПредыдущегоПериода Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ЗатратыНаИнцидентыПредыдущегоПериодаПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеЗатратыНаМероприятия Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ЗатратыНаМероприятияПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеКоличествоИнцидентов Тогда 
					ТекЭлементы.Использование = (МетрикаВход = КоличествоИнцидентовПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеКоличествоМероприятий Тогда 
					ТекЭлементы.Использование = (МетрикаВход = КоличествоМероприятийПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеКоличествоРеакций Тогда 
					ТекЭлементы.Использование = (МетрикаВход = КоличествоРеакцийПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеМаксимальноВозможныйУбыток Тогда 
					ТекЭлементы.Использование = (МетрикаВход = МаксимальноВозможныйУбытокПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеУровеньВероятности Тогда 
					ТекЭлементы.Использование = Истина;
				ИначеЕсли ТекЭлементы.Поле = ПолеПлановыеЗатратыМероприятий Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ПлановыеЗатратыМероприятийПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеПлановыеЗатратыРеакций Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ПлановыеЗатратыРеакцийПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеПризнанныйУбыток Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ПризнанныйУбытокПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеПризнанныйУбытокПред Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ПризнанныйУбытокПредПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеПрогнозныйУбыток Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ПрогнозныйУбытокПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеСуммаЗатратПланТек Тогда 
					ТекЭлементы.Использование = (МетрикаВход = СуммаЗатратПланТекПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеСуммаЗатратФактТек Тогда 
					ТекЭлементы.Использование = (МетрикаВход = СуммаЗатратФактТекПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеФактическиеЗатратыМероприятий Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ФактическиеЗатратыМероприятийПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеФактическиеЗатратыРеакцииПредыдущегоПериода Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ФактическиеЗатратыРеакцииПредыдущегоПериодаПредставление());
				ИначеЕсли ТекЭлементы.Поле = ПолеФактическиеЗатратыРеакций Тогда 
					ТекЭлементы.Использование = (МетрикаВход = ФактическиеЗатратыРеакцийПредставление());	
				Иначе
					// Выполняем поиск далее.
				КонецЕсли;	
			КонецЦикла;	
		Иначе
			// Не диаграмма. Не выбираем используемое поле.
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры		// ВыбратьПолеДиаграммыПоМетрике()

// Устанавливает отбор в диаграмме с настройками НастройкиВход
// согласно метрике МетрикаВход.
Процедура ВыбратьОтборДиаграммыПоМетрике(НастройкиВход, МетрикаВход)
	ПолеЗатратыНаИнциденты = Новый ПолеКомпоновкиДанных("ЗатратыНаИнциденты");
	ПолеЗатратыНаИнцидентыПредыдущегоПериода = Новый ПолеКомпоновкиДанных("ЗатратыНаИнцидентыПредыдущегоПериода");
	ПолеЗатратыНаМероприятия = Новый ПолеКомпоновкиДанных("ЗатратыНаМероприятия");
	ПолеКоличествоИнцидентов = Новый ПолеКомпоновкиДанных("КоличествоИнцидентов");
	ПолеКоличествоМероприятий = Новый ПолеКомпоновкиДанных("КоличествоМероприятий");
	ПолеКоличествоРеакций = Новый ПолеКомпоновкиДанных("КоличествоРеакций");
	ПолеМаксимальноВозможныйУбыток = Новый ПолеКомпоновкиДанных("МаксимальноВозможныйУбыток");
	ПолеУровеньВероятности = Новый ПолеКомпоновкиДанных("УровеньВероятности");
	ПолеО1 = Новый ПолеКомпоновкиДанных("Отн1");
	ПолеО2 = Новый ПолеКомпоновкиДанных("Отн2");
	ПолеО3 = Новый ПолеКомпоновкиДанных("Отн3");
	ПолеО4 = Новый ПолеКомпоновкиДанных("Отн4");
	ПолеО5 = Новый ПолеКомпоновкиДанных("Отн5");
	ПолеПлановыеЗатратыМероприятий = Новый ПолеКомпоновкиДанных("ПлановыеЗатратыМероприятий");
	ПолеПлановыеЗатратыРеакций = Новый ПолеКомпоновкиДанных("ПлановыеЗатратыРеакций");
	ПолеПризнанныйУбыток = Новый ПолеКомпоновкиДанных("ПризнанныйУбыток");
	ПолеПризнанныйУбытокПред = Новый ПолеКомпоновкиДанных("ПризнанныйУбытокПред");
	ПолеПрогнозныйУбыток = Новый ПолеКомпоновкиДанных("ПрогнозныйУбыток");
	ПолеСуммаЗатратПланТек = Новый ПолеКомпоновкиДанных("СуммаЗатратПланТек");
	ПолеСуммаЗатратФактТек = Новый ПолеКомпоновкиДанных("СуммаЗатратФактТек");
	ПолеФактическиеЗатратыМероприятий = Новый ПолеКомпоновкиДанных("ФактическиеЗатратыМероприятий");
	ПолеФактическиеЗатратыРеакцииПредыдущегоПериода = Новый ПолеКомпоновкиДанных("ФактическиеЗатратыРеакцииПредыдущегоПериода");
	ПолеФактическиеЗатратыРеакций = Новый ПолеКомпоновкиДанных("ФактическиеЗатратыРеакций");
	Для Каждого ТекЭлементы Из НастройкиВход.Отбор.Элементы Цикл
		Если ТекЭлементы.ЛевоеЗначение = ПолеЗатратыНаИнциденты Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ЗатратыНаИнцидентыПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеЗатратыНаИнцидентыПредыдущегоПериода Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ЗатратыНаИнцидентыПредыдущегоПериодаПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеЗатратыНаМероприятия Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ЗатратыНаМероприятияПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеКоличествоИнцидентов Тогда 
			ТекЭлементы.Использование = (МетрикаВход = КоличествоИнцидентовПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеКоличествоМероприятий Тогда 
			ТекЭлементы.Использование = (МетрикаВход = КоличествоМероприятийПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеКоличествоРеакций Тогда 
			ТекЭлементы.Использование = (МетрикаВход = КоличествоРеакцийПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеМаксимальноВозможныйУбыток Тогда 
			ТекЭлементы.Использование = (МетрикаВход = МаксимальноВозможныйУбытокПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеУровеньВероятности Тогда 
			ТекЭлементы.Использование = Истина;
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеПлановыеЗатратыМероприятий Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ПлановыеЗатратыМероприятийПредставление());
