	Настройки.События.Вставить("ПриСозданииНаСервере", Истина);
КонецПроцедуры

// Управляет доступностью элементов на форме Форма.
Процедура УправлениеДоступностью(Форма)
	Если Форма.Элементы.Найти("ГруппаРаботаВТаблице") <> Неопределено Тогда
		Форма.Элементы.ГруппаРаботаВТаблице.Видимость = Ложь;
	Иначе
		// Нет элемента группы команд работы с таблицей.
	КонецЕсли;
КонецПроцедуры		// УправлениеДоступностью()

Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
