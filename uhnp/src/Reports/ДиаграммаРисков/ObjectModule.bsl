		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеФактическиеЗатратыМероприятий Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ФактическиеЗатратыМероприятийПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеФактическиеЗатратыРеакцииПредыдущегоПериода Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ФактическиеЗатратыРеакцииПредыдущегоПериодаПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеФактическиеЗатратыРеакций Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ФактическиеЗатратыРеакцийПредставление());	
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеО1 Тогда 
			ТекЭлементы.Использование = (МетрикаВход = О1Представление());	
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеО2 Тогда 
