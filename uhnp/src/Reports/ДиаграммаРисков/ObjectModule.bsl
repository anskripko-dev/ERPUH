			ТекЭлементы.Использование = (МетрикаВход = ПризнанныйУбытокПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеПризнанныйУбытокПред Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ПризнанныйУбытокПредПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеПрогнозныйУбыток Тогда 
			ТекЭлементы.Использование = (МетрикаВход = ПрогнозныйУбытокПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеСуммаЗатратПланТек Тогда 
			ТекЭлементы.Использование = (МетрикаВход = СуммаЗатратПланТекПредставление());
		ИначеЕсли ТекЭлементы.ЛевоеЗначение = ПолеСуммаЗатратФактТек Тогда 
