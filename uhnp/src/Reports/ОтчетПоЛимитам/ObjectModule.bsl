#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	НастройкиСхемы = КомпоновщикНастроек.ПолучитьНастройки();
    ПараметрыДанных = НастройкиСхемы.ПараметрыДанных.Элементы;   
	
	ЭлементПараметр = ПараметрыДанных.Найти("ТипыЗаявокКОбеспечению");
	Если ЭлементПараметр <> Неопределено Тогда
		ЭлементПараметр.Использование = Истина;
		ЭлементПараметр.Значение = КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению();
	КонецЕсли;
	
	ЭлементПараметр = ПараметрыДанных.Найти("ТипыЗаявокНаОперации");
	Если ЭлементПараметр <> Неопределено Тогда
		ЭлементПараметр.Использование = Истина;
		ЭлементПараметр.Значение = КонтрольЛимитовУХ.ТипыЗаявокНаОперации();
	КонецЕсли;
	
	ЭлементПараметр = ПараметрыДанных.Найти("ТипыКорректировкиЛимитов");
	Если ЭлементПараметр <> Неопределено Тогда
		ЭлементПараметр.Использование = Истина;
		ЭлементПараметр.Значение = КонтрольЛимитовУХ.ТипыКорректировкиЛимитов();
	КонецЕсли;   
	
	ЭлементПараметр = ПараметрыДанных.Найти("ТипыРезервирования");
	Если ЭлементПараметр <> Неопределено Тогда
		ЭлементПараметр.Использование = Истина;
		ЭлементПараметр.Значение = КонтрольЛимитовУХ.ТипыРезервирования();
	КонецЕсли;   
	
	ИспользоватьРезервирование = КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования();
	ЭлементПараметр = ПараметрыДанных.Найти("ИспользоватьРезервирование");
	Если ЭлементПараметр <> Неопределено Тогда
		ЭлементПараметр.Использование = Истина;
		ЭлементПараметр.Значение = ИспользоватьРезервирование;
	КонецЕсли;
	
	КоличествоАналитикСтатьи = АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи();   
	
	АналитикиОтбора = Новый Массив;
	Для НомерАналитики = 1 По КоличествоАналитикСтатьи Цикл
		АналитикиОтбора.Добавить(Новый ПолеКомпоновкиДанных("Аналитика" + НомерАналитики));	 
	КонецЦикла;
	
	ОтборыДанных = НастройкиСхемы.Отбор.Элементы;
	Для Каждого ЭлементОтбора Из ОтборыДанных Цикл
		
		Если Не АналитикиОтбора.Найти(ЭлементОтбора.ЛевоеЗначение) = Неопределено
			И Не ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) 
			И Не ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено
			И Не ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено
			И ЭлементОтбора.Использование = Истина Тогда
			ЭлементОтбора.Использование = Ложь;	
		КонецЕсли; 
		
	КонецЦикла;        
	
	УстановитьМакетОформления(НастройкиСхемы);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных; 	
	Макет = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиСхемы, ДанныеРасшифровки);	
	
	МакетОформленияОтчета = БухгалтерскиеОтчетыКлиентСервер.ПолучитьПараметрВывода(НастройкиСхемы, "МакетОформления");
	
	Если Не МакетОформленияОтчета.Использование Тогда
		БухгалтерскиеОтчетыВызовСервера.УстановитьМакетОформленияОтчета(Новый Структура, НастройкиСхемы);	
	КонецЕсли;
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;   
	ПроцессорКомпоновки.Инициализировать(Макет, , ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;  
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);  
	
КонецПроцедуры

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьМакетОформления(НовыеНастройкиКД)
	
	Если КлиентскоеПриложение.ТекущийВариантИнтерфейса() = ВариантИнтерфейсаКлиентскогоПриложения.Такси Тогда
		
		Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда 
			ИмяМакетаПоУмолчанию = БухгалтерскиеОтчетыКлиентСервер.ИмяМакетаОформленияПоУмолчанию();
		Иначе    
			ИмяМакетаПоУмолчанию = "ОформлениеОтчетовБежевый";
		КонецЕсли;
		ПараметрМакетОформления = НовыеНастройкиКД.ПараметрыВывода.Элементы.Найти("МакетОформления");
		Если ПараметрМакетОформления.Значение = "Main" Или ПараметрМакетОформления.Значение = "Основной" Тогда
			ПараметрМакетОформления.Значение      = ИмяМакетаПоУмолчанию;
			ПараметрМакетОформления.Использование = Истина;
		КонецЕсли;
		
		Для Каждого ЭлементСтруктуры Из НовыеНастройкиКД.Структура Цикл
			
			Если ТипЗнч(ЭлементСтруктуры) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") Тогда
				
				ПараметрМакетОформления = ЭлементСтруктуры.Настройки.ПараметрыВывода.Элементы.Найти("МакетОформления");
				Если ПараметрМакетОформления.Значение = "Main" 
					Или ПараметрМакетОформления.Значение = "Основной" Тогда
					ПараметрМакетОформления.Значение      = ИмяМакетаПоУмолчанию;
					ПараметрМакетОформления.Использование = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ИнициализироватьОтчет() Экспорт
	
	ИспользоватьРезервированиеФО = КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования();

	Если НЕ ИспользоватьРезервированиеФО Тогда
		МассивНеиспользуемыхПолей = Новый Массив;
		МассивНеиспользуемыхПолей.Добавить("Зарезервировано");
		МассивНеиспользуемыхПолей.Добавить("РезервСвободный");
		
		Для каждого Элемент из МассивНеиспользуемыхПолей Цикл
			ПолеКомпоновкиДанных = СхемаКомпоновкиДанных.НаборыДанных[0].Поля.Найти(Элемент);
			Если ПолеКомпоновкиДанных <> Неопределено Тогда
				ПолеКомпоновкиДанных.ОграничениеИспользования.Группировка = Истина;
				ПолеКомпоновкиДанных.ОграничениеИспользования.Поле = Истина;
				ПолеКомпоновкиДанных.ОграничениеИспользования.Порядок = Истина;
				ПолеКомпоновкиДанных.ОграничениеИспользования.Условие = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения схемы компоновки.
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	Если КлючСхемы <> КлючВарианта Тогда
		
		ИнициализироватьОтчет();
		ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, СхемаКомпоновкиДанных, КлючСхемы);
		
		КлючСхемы = КлючВарианта;
		
	КонецЕсли;
	
КонецПроцедуры


