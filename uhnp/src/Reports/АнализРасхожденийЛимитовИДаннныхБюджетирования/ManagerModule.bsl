Функция ПолучитьТаблицуДанныхБюджетирования(ПериодОтчета) 
			
	Инфо = ПолучитьДанныеДляУстановкиЛимитов(ПериодОтчета.ДатаНачала, ПериодОтчета.ДатаОкончания); 
 
	ПоискПоказателей = Новый Структура("Предназначение, ВидОтчета, Область");
	ПоискПериодов = Новый Структура("ДокументБюджетирования");
	
	РаскрываемыеАналитики = Новый Структура;
	Для Инд = 1 По ОперативноеПланированиеКонтроль.ПараметрСеанса_ЧислоДопАналитик() Цикл
		РаскрываемыеАналитики.Вставить("Аналитика" + Инд);
	КонецЦикла;	
	РаскрываемыеАналитики.Вставить("АналитикаВалюта");
	
	ТаблицаДанныхБюджетирования = Документы.УправлениеЛимитами.ИнициализироватьТаблицуЗначенияПоказателей();
	
	СтруктураПараметров = Новый Структура("Организация, Проект, Сценарий, ВидОтчета");
	Для Каждого СтрокаДокумент Из Инфо.ДокументыБюджетирования Цикл
		
		ЗаполнитьЗначенияСвойств(ПоискПоказателей, СтрокаДокумент);
		ЗаполнитьЗначенияСвойств(ПоискПериодов, СтрокаДокумент);
		
		ПоказателиДокумента = Инфо.Показатели.Скопировать(ПоискПоказателей, "Показатель, ПоказательПометкаУдаления, ЕстьЗначениеВВалютеРаскрытия, СтатьяБюджета, СтрокаОтчета");
		Показатели = ПоказателиДокумента.ВыгрузитьКолонку("Показатель");
		Периоды = Инфо.ПериодыПланирования.Скопировать(ПоискПериодов, "ПериодПланирования").ВыгрузитьКолонку("ПериодПланирования");
		
		Если Показатели.Количество() = 0 Или Периоды.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, СтрокаДокумент);
		СтруктураПараметров.Вставить("ПоказательОтчета", Показатели);
		СтруктураПараметров.Вставить("ПериодОтчета", Периоды);
		
		ТаблицаПоказателей = СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей(СтруктураПараметров, РаскрываемыеАналитики);
		
		ТаблицаПоказателей.Колонки.ПоказательОтчета.Имя = "Показатель";
		ДобавитьВТаблицу(ТаблицаДанныхБюджетирования, СтрокаДокумент, ПоказателиДокумента, ТаблицаПоказателей);
			
	КонецЦикла;
	
	СкорректироватьТаблицуПоНастройкамУстановкиЛимитовИзАналитик(ТаблицаДанныхБюджетирования);
	
	Возврат ТаблицаДанныхБюджетирования;
	
КонецФункции

Функция ПолучитьДанныеДляУстановкиЛимитов(ДатаНачала, ДатаОкончания)
		 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УправлениеЛимитамиДанные.Ссылка КАК Ссылка,
	|	УправлениеЛимитамиДанные.ВидБюджета КАК ВидБюджета,
	|	УправлениеЛимитамиДанные.ЦФО КАК ЦФО,
	|	УправлениеЛимитамиДанные.Проект КАК Проект,
	|	УправлениеЛимитамиДанные.УОП КАК УОП,
	|	ВЫРАЗИТЬ(УправлениеЛимитамиДанные.ПериодЛимитирования КАК Справочник.Периоды) КАК ПериодЛимитирования
	|ПОМЕСТИТЬ ВТ_ДанныеДокумента
	|ИЗ
	|	Документ.УправлениеЛимитами.Данные КАК УправлениеЛимитамиДанные
	|ГДЕ
	|	УправлениеЛимитамиДанные.Ссылка.Проведен = ИСТИНА
	|	И УправлениеЛимитамиДанные.ПериодЛимитирования.ДатаНачала >= &ДатаНачала
	|	И УправлениеЛимитамиДанные.ПериодЛимитирования.ДатаОкончания <= &ДатаОкончания
	|	И УправлениеЛимитамиДанные.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год) КАК ПериодичностьЛимитирования,
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год) КАК ПериодичностьПланирования
	|ПОМЕСТИТЬ ВТ_ДопустимаяПериодичностьЛимитирования
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.День)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
