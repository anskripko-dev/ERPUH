
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает таблицу значений по текущему отчету для передачи в СКД.
Функция ПолучитьДанныеДляФормированияОтчета(ПараметрыДанных) Экспорт
	
	Запрос = Новый Запрос;    
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеРегистра.Регистратор КАК Регистратор,
		|	ДанныеРегистра.Период КАК Период,
		|	ДанныеРегистра.ВидБюджета КАК ВидБюджета,
		|	ДанныеРегистра.ОбъектПланирования КАК ОбъектПланирования,
		|	ДанныеРегистра.АналитикаСтруктуры.ЦФО КАК ЦФО,
		|	ДанныеРегистра.АналитикаСтруктуры.Проект КАК Проект,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
		|	ДанныеРегистра.АналитикаСтатейБюджетов.ПриходРасход КАК ПриходРасход,
		|	ДанныеРегистра.ВалютаЛимитирования КАК ВалютаЛимитирования,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И НЕ ТИПЗНАЧЕНИЯ(ДанныеРегистра.Регистратор) В (&ТипыКорректировкиЛимитов)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Лимит,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокКОбеспечению)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КОбеспечению,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ТИПЗНАЧЕНИЯ(ДанныеРегистра.Регистратор) В (&ТипыКорректировкиЛимитов)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Корректировка,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) = ТИП(Справочник.ДоговорыКонтрагентов)
		|				И ДанныеРегистра.Регистратор.ИспользованиеГрафикаРасчетовБДДС = ЗНАЧЕНИЕ(Перечисление.РежимыИспользованияГрафика.АвтоматическоеСозданиеПлатежныхПозиций)
		|			ТОГДА 0
		|		КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И НЕ ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокНаОперации)
		|				И НЕ ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокКОбеспечению)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Зарезервировано,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) = ТИП(Справочник.ДоговорыКонтрагентов)
		|				И ДанныеРегистра.Регистратор.ИспользованиеГрафикаРасчетовБДДС = ЗНАЧЕНИЕ(Перечисление.РежимыИспользованияГрафика.АвтоматическоеСозданиеПлатежныхПозиций)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыЗаявокНаОперации)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Заявлено,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования <> ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ТИПЗНАЧЕНИЯ(ДанныеРегистра.ОбъектПланирования.Объект) В (&ТипыРезервирования)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РезервСвободный,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ТИПЗНАЧЕНИЯ(ДанныеРегистра.Регистратор) = ТИП(Документ.ОперативныйПлан)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЛимитОперПлан,
		|	ВЫБОР
		|		КОГДА ДанныеРегистра.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
		|				И ТИПЗНАЧЕНИЯ(ДанныеРегистра.Регистратор) = ТИП(Документ.УправлениеЛимитами)
		|			ТОГДА ДанныеРегистра.ЛимитОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЛимитДанныеБюджетирования,
		|	ДанныеРегистра.ЛимитИсполненоОборот КАК Исполнено
		|ПОМЕСТИТЬ ВТ_Операции
		|ИЗ
		|	РегистрНакопления.ОперацииБюджетов.Обороты(&ДатаНачала,&ДатаОкончания , Регистратор, ВидБюджета = &ВидБюджета) КАК ДанныеРегистра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОперацииБюджетов2Обороты.Период КАК Период,
		|	ОперацииБюджетов2Обороты.ВидБюджета КАК ВидБюджета
		|ПОМЕСТИТЬ ВТ_ВидыБюджетовДаты
		|ИЗ
		|	ВТ_Операции КАК ОперацииБюджетов2Обороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
		|	ПараметрыЛимитирования.Период КАК Период,
		|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
		|	ПараметрыЛимитирования.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
		|	ПараметрыЛимитирования.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
		|	ПараметрыЛимитирования.КонтрольЛимитов КАК КонтрольЛимитов,
		|	ВЫБОР
		|		КОГДА ПараметрыЛимитирования.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
		|				ИЛИ ПараметрыЛимитирования.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Контролировать,
		|	ПараметрыЛимитирования.КонтрольРезервов КАК КонтрольРезервов,
		|	ПараметрыЛимитирования.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
		|	КонстантаВалютаУправленческогоУчета.Значение КАК ВалютаУправленческогоУчета
		|ПОМЕСТИТЬ ВТ_ПараметрыЛимитирования
		|ИЗ
		|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования,
		|	Константа.ВалютаУправленческогоУчета КАК КонстантаВалютаУправленческогоУчета
		|ГДЕ
		|	ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВидыБюджетовДаты.Период КАК Период,
		|	ВТ_ВидыБюджетовДаты.ВидБюджета КАК ВидБюджета,
		|	МАКСИМУМ(ВТ_ПараметрыЛимитирования.Период) КАК НачалоДействияПараметровЛимитирования
		|ПОМЕСТИТЬ ВТ_НачалоДействияПараметровЛимитирования
		|ИЗ
		|	ВТ_ВидыБюджетовДаты КАК ВТ_ВидыБюджетовДаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыЛимитирования КАК ВТ_ПараметрыЛимитирования
		|		ПО ВТ_ВидыБюджетовДаты.ВидБюджета = ВТ_ПараметрыЛимитирования.ВидБюджета
		|			И ВТ_ВидыБюджетовДаты.Период >= ВТ_ПараметрыЛимитирования.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВидыБюджетовДаты.ВидБюджета,
		|	ВТ_ВидыБюджетовДаты.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета КАК ВидБюджета,
		|	ВТ_ПараметрыЛимитированияБюджетов.Период КАК НачалоДействия,
		|	ПараметрыСтатей.СтатьяБюджета КАК СтатьяБюджета,
		|	ВЫБОР
		|		КОГДА ПараметрыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
		|				ИЛИ ПараметрыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Контролировать,
		|	ПараметрыСтатей.КонтролироватьАналитику1 КАК КонтролироватьАналитику1,
		|	ПараметрыСтатей.КонтролироватьАналитику2 КАК КонтролироватьАналитику2,
		|	ПараметрыСтатей.КонтролироватьАналитику3 КАК КонтролироватьАналитику3,
		|	ПараметрыСтатей.КонтролироватьАналитику4 КАК КонтролироватьАналитику4,
		|	ПараметрыСтатей.КонтролироватьАналитику5 КАК КонтролироватьАналитику5,
		|	ПараметрыСтатей.КонтролироватьАналитику6 КАК КонтролироватьАналитику6,
		|	ПараметрыСтатей.КонтрольЛимитов КАК КонтрольЛимитов,
		|	ПараметрыСтатей.КонтрольРезервов КАК КонтрольРезервов
		|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияСтатейБюджетов
		|ИЗ
		|	ВТ_ПараметрыЛимитирования КАК ВТ_ПараметрыЛимитированияБюджетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК ПараметрыСтатей
		|		ПО ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета = ПараметрыСтатей.ВидБюджета
		|			И ВТ_ПараметрыЛимитированияБюджетов.Период = ПараметрыСтатей.Период
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета,
		|	ВТ_ПараметрыЛимитированияБюджетов.Период,
		|	ВТ_ВсеСтатьиБюджетов.СтатьяБюджета,
		|	ВЫБОР
		|		КОГДА ВТ_ПараметрыЛимитированияБюджетов.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
		|				ИЛИ ВТ_ПараметрыЛимитированияБюджетов.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ВТ_ПараметрыЛимитированияБюджетов.КонтрольЛимитов,
		|	ВТ_ПараметрыЛимитированияБюджетов.КонтрольРезервов
		|ИЗ
		|	ВТ_ПараметрыЛимитирования КАК ВТ_ПараметрыЛимитированияБюджетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Операции КАК ВТ_ВсеСтатьиБюджетов
		|		ПО ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета = ВТ_ВсеСтатьиБюджетов.ВидБюджета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК ПараметрыСтатей
		|		ПО (ПараметрыСтатей.ВидБюджета = &ВидБюджета)
		|			И ВТ_ПараметрыЛимитированияБюджетов.Период = ПараметрыСтатей.Период
		|			И (ВТ_ВсеСтатьиБюджетов.СтатьяБюджета = ПараметрыСтатей.СтатьяБюджета)
		|ГДЕ
		|	ПараметрыСтатей.СтатьяБюджета ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПараметрыЛимитированияБюджетов.ВидБюджета КАК ВидБюджета,
		|	ВТ_ПараметрыЛимитированияБюджетов.Период КАК НачалоДействия,
		|	ПараметрыЛимитированияГруппыСтатейСостав.ГруппаСтатей КАК ГруппаСтатей,
		|	ПараметрыЛимитированияГруппыСтатейСостав.СтатьяБюджета КАК СтатьяБюджета,
		|	ПараметрыЛимитированияГруппыСтатей.ИнаяПериодичность КАК ИнаяПериодичность,
		|	ПараметрыЛимитированияГруппыСтатей.Периодичность КАК Периодичность,
		|	ПараметрыЛимитированияГруппыСтатей.КонтрольПоГруппе КАК КонтрольПоГруппе,
		|	ПараметрыЛимитированияГруппыСтатей.ИноеДействие КАК ИноеДействие,
		|	ПараметрыЛимитированияГруппыСтатей.КонтрольЛимитов КАК КонтрольЛимитов,
		|	ПараметрыЛимитированияГруппыСтатей.КонтрольРезервов КАК КонтрольРезервов,
		|	ВЫБОР
		|		КОГДА ПараметрыЛимитированияГруппыСтатей.ИноеДействие
		|				И (ПараметрыЛимитированияГруппыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Блокировать)
		|					ИЛИ ПараметрыЛимитированияГруппыСтатей.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Контролировать
		|ПОМЕСТИТЬ ВТ_ПараметрыЛимитированияГруппСтатей
		|ИЗ
		|	РегистрСведений.ПараметрыЛимитированияГруппыСтатей КАК ПараметрыЛимитированияГруппыСтатей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав КАК ПараметрыЛимитированияГруппыСтатейСостав
		|		ПО ПараметрыЛимитированияГруппыСтатей.ВидБюджета = ПараметрыЛимитированияГруппыСтатейСостав.ВидБюджета
		|			И ПараметрыЛимитированияГруппыСтатей.Период = ПараметрыЛимитированияГруппыСтатейСостав.Период
		|			И ПараметрыЛимитированияГруппыСтатей.ГруппаСтатей = ПараметрыЛимитированияГруппыСтатейСостав.ГруппаСтатей
