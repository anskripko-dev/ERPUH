		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА ВТ_ОперацииИтог.Аналитика6 = НЕОПРЕДЕЛЕНО
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_ОперацииИтог.Аналитика6 = ДанныеБюджетирования.Аналитика6
		|			КОНЕЦ)
		|			И ВТ_ОперацииИтог.ПериодЛимитирования = ДанныеБюджетирования.ПериодОтчета.ДатаНачала
		|			И ВТ_ОперацииИтог.ВалютаЛимитирования = ДанныеБюджетирования.Валюта";
	
	ВидБюджетаПараметр = ПараметрыДанных.Найти("ВидБюджета");
	Если ВидБюджетаПараметр <> Неопределено Тогда
		ВидБюджета = ВидБюджетаПараметр.Значение;
	Иначе
		ВидБюджета = ПланыВидовхарактеристик.ВидыБюджетов.ПустаяСсылка();
	КонецЕсли; 
	
	ПериодОтчета = Новый СтандартныйПериод;
	ПериодПараметр = ПараметрыДанных.Найти("ПериодОтчета");
	Если ПериодПараметр <> Неопределено Тогда
		ПериодОтчета = ПериодПараметр.Значение;
	КонецЕсли;
	
    Запрос.УстановитьПараметр("ДатаНачала", ПериодОтчета.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодОтчета.ДатаОкончания);
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("ТипыЗаявокКОбеспечению", КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению());
	Запрос.УстановитьПараметр("ТипыЗаявокНаОперации", КонтрольЛимитовУХ.ТипыЗаявокНаОперации());
	Запрос.УстановитьПараметр("ТипыКорректировкиЛимитов", КонтрольЛимитовУХ.ТипыКорректировкиЛимитов());
	Запрос.УстановитьПараметр("ТипыРезервирования", КонтрольЛимитовУХ.ТипыРезервирования());
	Запрос.УстановитьПараметр("ТаблицаДанныхБюджетирования", ПолучитьТаблицуДанныхБюджетирования(ПериодОтчета));
	
	Возврат Запрос.Выполнить().Выгрузить();
		
