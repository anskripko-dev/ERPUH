
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ЕстьУА = Ложь;
	ЕстьМСФО = Ложь;
	ЕстьНСБУ = Ложь;
	НастройкиСКД  = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПараметрСКД = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДанныеУправленияАктивами"));
	Если ПараметрСКД <> Неопределено И ПараметрСКД.Использование Тогда
		ЕстьУА = ПараметрСКД.Значение И УчетМСФОПовтИспУХ.ЕстьРСБУ();
	КонецЕсли;
	
	ПараметрСКД = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДанныеМСФО"));
	Если ПараметрСКД <> Неопределено И ПараметрСКД.Использование Тогда
		ЕстьМСФО = ПараметрСКД.Значение;
	КонецЕсли;
		
	ПараметрСКД = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДанныеНСБУ"));
	Если ПараметрСКД <> Неопределено И ПараметрСКД.Использование Тогда
		ЕстьНСБУ = ПараметрСКД.Значение;
	КонецЕсли;
	
	ВидимостьПолей = Новый Соответствие;
	
	ВидимостьПолей.Вставить(НСтр("ru = 'Управление активами - Основные параметры'"), 	ЕстьУА);
	ВидимостьПолей.Вставить(НСтр("ru = 'Управление активами - дополнительно'"), 		ЕстьУА);
	
	ВидимостьПолей.Вставить("СПИМСФО",												ЕстьМСФО);	
	ВидимостьПолей.Вставить("ОписаниеПараметровАмортизацииМСФО",					ЕстьМСФО);	
	ВидимостьПолей.Вставить("ИнвентарныйНомерМСФО",									ЕстьМСФО);	
	ВидимостьПолей.Вставить("ДатаВводаВЭксплуатациюМСФО",							ЕстьМСФО);	
	ВидимостьПолей.Вставить("ДатаМодернизацииМСФО",									ЕстьМСФО);	
	ВидимостьПолей.Вставить("ДатаВыбытияМСФО",										ЕстьМСФО);	
	ВидимостьПолей.Вставить("ПервоначальнаяСтоимостьНаНачалоПериодаМСФО",			ЕстьМСФО);	
	ВидимостьПолей.Вставить("АмортизацияНаНачалоПериодаМСФО",						ЕстьМСФО);	
	ВидимостьПолей.Вставить("ПереоценкаНаНачалоПериодаМСФО",						ЕстьМСФО);	
	ВидимостьПолей.Вставить("БалансоваяСтоимостьНаНачалоМСФО",						ЕстьМСФО);	
	ВидимостьПолей.Вставить("ПриобретеноМСФО",										ЕстьМСФО);	
	ВидимостьПолей.Вставить("ВводВЭксплуатациюМСФО",								ЕстьМСФО);	
	ВидимостьПолей.Вставить("МодернизацияМСФО",										ЕстьМСФО);	
	ВидимостьПолей.Вставить("НачисленнаяАмортизацияЗаПериодМСФО",					ЕстьМСФО);	
	ВидимостьПолей.Вставить("ПереоценкаМСФО",										ЕстьМСФО);	
	ВидимостьПолей.Вставить("РеклассМСФО",											ЕстьМСФО);	
	ВидимостьПолей.Вставить("ВыбытиеМСФО",											ЕстьМСФО);	
	ВидимостьПолей.Вставить("ПервоначальнаяСтоимостьНаКонецПериодаМСФО",			ЕстьМСФО);	
	ВидимостьПолей.Вставить("НакопленнаяАмортизацияНаКонецОтчетногоПериодаМСФО",	ЕстьМСФО);	
	ВидимостьПолей.Вставить("ПереоценкаНаКонецПериодаМСФО",							ЕстьМСФО);	
	ВидимостьПолей.Вставить("БалансоваяСтоимостьНаКонецМСФО",						ЕстьМСФО);	
	ВидимостьПолей.Вставить("ОбесценениеНаНачалоПериодаМСФО",						ЕстьМСФО);	
	ВидимостьПолей.Вставить("ОбесценениеМСФО",										ЕстьМСФО);	
	ВидимостьПолей.Вставить("ОбесценениеНаКонецПериодаМСФО",						ЕстьМСФО);	
	ВидимостьПолей.Вставить("ВыбытиеАмортизацииЗаПериодМСФО",						ЕстьМСФО);	
	ВидимостьПолей.Вставить("Подразделение",										ЕстьМСФО);	
	ВидимостьПолей.Вставить("НаправлениеДеятельности",						 		ЕстьМСФО);	
	
	ВидимостьПолей.Вставить("СПИНСБУ",												ЕстьНСБУ);
	ВидимостьПолей.Вставить("ИнвентарныйНомерНСБУ",									ЕстьНСБУ);
	ВидимостьПолей.Вставить("ДатаВводаВЭксплуатациюНСБУ",							ЕстьНСБУ);
	ВидимостьПолей.Вставить("ДатаМодернизацииНСБУ",									ЕстьНСБУ);
	ВидимостьПолей.Вставить("ДатаВыбытияНСБУ",										ЕстьНСБУ);
	ВидимостьПолей.Вставить("ПервоначальнаяСтоимостьНаНачалоПериодаНСБУ",			ЕстьНСБУ);
	ВидимостьПолей.Вставить("АмортизацияНаНачалоПериодаНСБУ",						ЕстьНСБУ);
	ВидимостьПолей.Вставить("ПереоценкаНаНачалоПериодаНСБУ",						ЕстьНСБУ);
	ВидимостьПолей.Вставить("БалансоваяСтоимостьНаНачалоНСБУ",						ЕстьНСБУ);
	ВидимостьПолей.Вставить("ПриобретеноНСБУ",										ЕстьНСБУ);
	ВидимостьПолей.Вставить("ВводВЭксплуатациюНСБУ",								ЕстьНСБУ);
	ВидимостьПолей.Вставить("МодернизацияНСБУ",										ЕстьНСБУ);
	ВидимостьПолей.Вставить("НачисленнаяАмортизацияЗаПериодНСБУ",					ЕстьНСБУ);
	ВидимостьПолей.Вставить("ПереоценкаНСБУ",										ЕстьНСБУ);
	ВидимостьПолей.Вставить("ПриобретеноНСБУ",										ЕстьНСБУ);
	ВидимостьПолей.Вставить("РеклассНСБУ",											ЕстьНСБУ);
	ВидимостьПолей.Вставить("ВыбытиеНСБУ",											ЕстьНСБУ);
	ВидимостьПолей.Вставить("ПервоначальнаяСтоимостьНаКонецПериодаНСБУ",			ЕстьНСБУ);
	ВидимостьПолей.Вставить("НакопленнаяАмортизацияНаКонецОтчетногоПериодаНСБУ",	ЕстьНСБУ);
	ВидимостьПолей.Вставить("ПереоценкаНаКонецПериодаНСБУ",							ЕстьНСБУ);
	ВидимостьПолей.Вставить("БалансоваяСтоимостьНаКонецНСБУ",						ЕстьНСБУ);
	ВидимостьПолей.Вставить("ОбесценениеНаНачалоПериодаНСБУ",						ЕстьНСБУ);	
	ВидимостьПолей.Вставить("ОбесценениеНСБУ",										ЕстьНСБУ);	
	ВидимостьПолей.Вставить("ОбесценениеНаКонецПериодаНСБУ",						ЕстьНСБУ);	
	ВидимостьПолей.Вставить("ВыбытиеАмортизацииЗаПериодНСБУ",						ЕстьНСБУ);
	
	Для каждого ЭлементВыбора Из КомпоновщикНастроек.Настройки.Выбор.Элементы Цикл
		
		Если ЭлементВыбора.Поле <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Использование = ВидимостьПолей.Получить(ЭлементВыбора.Заголовок);
		Исключение
			Использование = Неопределено;
		КонецПопытки;
		
		Если Использование <> Неопределено Тогда
			ЭлементВыбора.Использование = Использование;
		КонецЕсли;
		
		Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			Для каждого ЭлементВыбораДетальные Из ЭлементВыбора.Элементы Цикл
			
				Попытка
					ИспользованиеДетальные = ВидимостьПолей.Получить(Строка(ЭлементВыбораДетальные.Поле));
				Исключение
					ИспользованиеДетальные = Неопределено;
				КонецПопытки;
				
				Если ИспользованиеДетальные <> Неопределено Тогда
					ЭлементВыбораДетальные.Использование = ИспользованиеДетальные;
				КонецЕсли;
			КонецЦикла;
		Иначе
			// Не требуется получение дочерних элементов.
		КонецЕсли;
	КонецЦикла;
	
	//ТиповыеОтчетыУХ.МакетКомпоновкиВXML(ТиповыеОтчетыУХ.ПолучитьМакетКомпоновкиДанныхКоллекции(ЭтотОбъект.СхемаКомпоновкиДанных, ЭтотОбъект.КомпоновщикНастроек.ПолучитьНастройки()));
	
КонецПроцедуры

СценарийМСФО = Константы.СценарийМСФО.Получить();
Если ЗначениеЗаполнено(СценарийМСФО) Тогда
	
	ВидСравненияРавно = ВидСравненияКомпоновкиДанных.Равно;
	Для каждого ТекущийВариант Из ЭтотОбъект.СхемаКомпоновкиДанных.ВариантыНастроек Цикл
		ОтборТекВарианта = ТекущийВариант.Настройки.Отбор;
		ОбщегоНазначенияКлиентСерверУХ.УстановитьЭлементОтбора(
			ОтборТекВарианта, "Сценарий", СценарийМСФО, ВидСравненияРавно, , Истина);
	КонецЦикла;
		
КонецЕсли;





