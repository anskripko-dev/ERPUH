#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	Если Модифицированность Тогда
		ЗаписатьНаСервере();
	КонецЕсли;
	
	Если Команда = Команды.Найти("ЗаписатьИЗакрыть") Тогда
		ПараметрыЗакрытия = Модифицированность;
		Модифицированность = Ложь;
		Закрыть(ПараметрыЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	ПараметрыЗаписи = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов();
	ПараметрыЗаписи.Вставить("ВерсияРегламента", ВерсияРегламента);
	ПараметрыЗаписи.Вставить("УправлениеПериодом", УправлениеПериодом);
	
	ЭтоЗаполнениеПоШаблонамДокумента = (НЕ ЗначениеЗаполнено(ШаблонДокумента) И ЗначениеЗаполнено(ШаблоныДокументов));
	
	Для Каждого ЭлементШаблонДокумента Из ШаблоныДокументов Цикл
		ПараметрыЗаписи.Вставить("ШаблонДокумента", ЭлементШаблонДокумента.Значение);
		
		Для Каждого ЭлементОрганизация Из Организации Цикл
			ПараметрыЗаписи.Вставить("Организация", ЭлементОрганизация.Значение);
			
			Если РазделениеПоПроектам Тогда
				Для Каждого ЭлементПроект Из Проекты Цикл
					ПараметрыЗаписи.Вставить("Проект", ЭлементПроект.Значение);
					
					Если ЭтоЗаполнениеПоШаблонамДокумента Тогда
						ЗначенияНастроек = УправлениеОтчетамиУХ.НастройкиОбработкиШаблонов(ПараметрыЗаписи);
						ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияНастроек,, "ВнешняяИнформационнаяБаза");
					КонецЕсли;
					ЦиклПоАналитикам(ПараметрыЗаписи, 1);
					
				КонецЦикла;
			Иначе
				
				Если ЭтоЗаполнениеПоШаблонамДокумента Тогда
					ЗначенияНастроек = УправлениеОтчетамиУХ.НастройкиОбработкиШаблонов(ПараметрыЗаписи);
					ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияНастроек,, "ВнешняяИнформационнаяБаза");
				КонецЕсли;
				ЦиклПоАналитикам(ПараметрыЗаписи, 1);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЦиклПоАналитикам(ПараметрыЗаписи, Сч)
	
	Если Сч > МаксКлючевыхАналитик Тогда
		УправлениеОтчетамиУХ.УстановитьНастройкиОбработкиШаблонов(ПараметрыЗаписи, ЭтаФорма);
	Иначе
		Для Каждого ЭлементАналитика Из ЭтаФорма["Аналитики" + Сч] Цикл
			ПараметрыЗаписи.Вставить("Аналитика" + Сч, ЭлементАналитика.Значение);
			ЦиклПоАналитикам(ПараметрыЗаписи, Сч + 1);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПолучитьЗначенияНастроек()
	
	ПараметрыНастроек = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов(ЭтаФорма);
	ЗначенияНастроек = УправлениеОтчетамиУХ.НастройкиОбработкиШаблонов(ПараметрыНастроек);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияНастроек);
	
	Модифицированность = Ложь;
	
	ЗаполнитьСпособыФормированияОтчета();
	СпособФормированияОтчетаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпособыФормированияОтчета()
	
	Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.РучноеЗаполнение);
	Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.ПоПравилуОбработки);
	Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.Импорт);

	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(ВерсияРегламента) Тогда
		
		// Можем установить доступные способы заполнения
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиницаРодитель) КАК ЕстьКонсолидирующиеОрганизации,
			|	ЕСТЬNULL(МАКСИМУМ(ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.Ссылка.ИспользоватьРасширенныеНастройкиПериметра), ЛОЖЬ) КАК ИспользоватьРасширенныеНастройкиПериметра
			|ИЗ
			|	Справочник.ВерсииРегламентовПодготовкиОтчетности.СтруктураГруппы КАК ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы
			|ГДЕ
			|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.Ссылка = &ВерсияРегламента
			|	И ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиницаРодитель = &Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Организации.ЭлиминирующаяОрганизация КАК ЭлиминирующаяОрганизация
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.Ссылка = &Организация";
		
		Запрос.УстановитьПараметр("ВерсияРегламента", ВерсияРегламента);
		Запрос.УстановитьПараметр("Организация", Организация);
		
		ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
		
		// Консолидация
		РезультатЗапроса = ПакетРезультатовЗапроса.Получить(0);
		Если НЕ РезультатЗапроса.Пустой() Тогда
	
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			Если Выборка.ЕстьКонсолидирующиеОрганизации Тогда
				Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.Консолидация);
			КонецЕсли;
			
		КонецЕсли;
		
		// Элиминация
		РезультатЗапроса = ПакетРезультатовЗапроса.Получить(1);
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Если Выборка.ЭлиминирующаяОрганизация Тогда
				Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.Элиминация);
			КонецЕсли;
			
		КонецЕсли;
	
	Иначе
		Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.Консолидация);
		Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.Элиминация);
	КонецЕсли;

	Для Сч = 1 По МаксКлючевыхАналитик Цикл
		Если НЕ ЗначениеЗаполнено(ЭтаФорма["Аналитика" + Сч]) Тогда
			Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.СвернувПоАналитикам);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.СпособФормированияОтчета.СписокВыбора.Добавить(Перечисления.СпособыФормированияОтчетов.СвернувПоПериоду);
	
	Если Элементы.СпособФормированияОтчета.СписокВыбора.НайтиПоЗначению(СпособФормированияОтчета) = Неопределено Тогда
		СпособФормированияОтчета = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПараметр(ИмяЕдЧисло, ИмяМнЧисло)

	Если Параметры.Свойство(ИмяЕдЧисло) Тогда
		Параметр = Параметры[ИмяЕдЧисло];
		Если ТипЗнч(Параметр) = Тип("Массив") Тогда
			ЭтаФорма[ИмяМнЧисло].ЗагрузитьЗначения(Параметр);
			Элементы[ИмяЕдЧисло].Видимость = Ложь;
			Элементы[ИмяМнЧисло].Видимость = Истина;
		Иначе
			ЭтаФорма[ИмяЕдЧисло] = Параметр;
			ЭтаФорма[ИмяМнЧисло].Добавить(ЭтаФорма[ИмяЕдЧисло]);
			Элементы[ИмяЕдЧисло].Видимость = Истина;
			Элементы[ИмяМнЧисло].Видимость = Ложь;
		КонецЕсли;
	Иначе
		Элементы[ИмяЕдЧисло].Видимость = Истина;
		Элементы[ИмяМнЧисло].Видимость = Ложь;
		ЭтаФорма[ИмяМнЧисло].Добавить(ЭтаФорма[ИмяЕдЧисло]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСписокЗначений(ИмяРеквизита)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Заголовок", ИмяРеквизита);
	ПараметрыОткрытия.Вставить("МассивЗначений", ЭтаФорма[ИмяРеквизита].ВыгрузитьЗначения());
	
	ОткрытьФорму("ВнешнийОтчет.НастройкаОбработкиШаблоновДокументов.Форма.ФормаПросмотраСпискаЗначений", 
		ПараметрыОткрытия, ЭтаФорма);

КонецПроцедуры
	
&НаКлиенте
Процедура ЗначениеВСписок(ИмяЕдЧисло, ИмяМнЧисло)
	
	ЭтаФорма[ИмяМнЧисло].Очистить();
	ЭтаФорма[ИмяМнЧисло].Добавить(ЭтаФорма[ИмяЕдЧисло]);

КонецПроцедуры

#КонецОбласти









