КонецПроцедуры

&НаСервере
Процедура ШаблонДокументаПриИзмененииНаСервере()
	
	МаксКлючевыхАналитик = 0;
	РазделениеПоПроектам = Ложь;
	ТипШаблона = "";
	
	Если ШаблонДокумента = Неопределено Тогда
		Элементы.ШаблонДокумента.Заголовок = НСтр("ru = 'Шаблон документа'");
	ИначеЕсли ТипЗнч(ШаблонДокумента) = Тип("СправочникСсылка.ШаблоныКорректировокЗначенийПоказателей") Тогда
		Элементы.ШаблонДокумента.Заголовок = НСтр("ru = 'Шаблон корректировок значений показателей'");
		ТипШаблона = "ШаблоныКорректировокЗначенийПоказателей";
	ИначеЕсли ТипЗнч(ШаблонДокумента) = Тип("СправочникСсылка.ШаблоныТрансляций") Тогда
		Элементы.ШаблонДокумента.Заголовок = НСтр("ru = 'Шаблон трансляций'");
		ТипШаблона = "ШаблоныТрансляций";
	ИначеЕсли ТипЗнч(ШаблонДокумента) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") Тогда
		Элементы.ШаблонДокумента.Заголовок = НСтр("ru = 'Шаблон операций'");
		ТипШаблона = "ШаблоныТрансформационныхКорректировок";
	ИначеЕсли ТипЗнч(ШаблонДокумента) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		Элементы.ШаблонДокумента.Заголовок = НСтр("ru = 'Вид отчета'");
		ТипШаблона = "ВидыОтчетов";
		ДанныеВидаОтчета = БюджетированиеИОтчетностьПовтИсп.ДанныеВидаОтчета(ШаблонДокумента);
		РазделениеПоПроектам = ДанныеВидаОтчета.РазделениеПоПроектам;
		МаксКлючевыхАналитик = ДанныеВидаОтчета.МаксКлючевыхАналитик;
	КонецЕсли;
	
	Элементы.ГруппаВидОтчета.Видимость = ТипШаблона = "ВидыОтчетов";
	Элементы.ВнешняяИнформационнаяБаза.РежимВыбораИзСписка = ТипШаблона = "ВидыОтчетов";
	
	Если РазделениеПоПроектам Тогда
		Элементы.Проект.Видимость = Проекты.Количество() = 1;
		Элементы.Проекты.Видимость = НЕ Проекты.Количество() = 1;
	Иначе
		Проект = Неопределено;
		Проекты.Очистить();
		Элементы.Проект.Видимость = Ложь;
		Элементы.Проекты.Видимость = Ложь;
	КонецЕсли;
	
	Для Сч = 1 По МаксКлючевыхАналитик Цикл
		ТекущийЭлемент = Элементы["Аналитика"+Сч];
		ТекущийЭлемент.Видимость = ЭтаФорма["Аналитики"+Сч].Количество() = 1;
		Элементы["Аналитики"+Сч].Видимость = НЕ ЭтаФорма["Аналитики"+Сч].Количество() = 1;
		ТипЗначенияАналитики = ДанныеВидаОтчета["ТипЗначенияАналитики"+Сч];
		Если ТипЗначенияАналитики.Типы().Количество() = 1 Тогда
			ТекущийЭлемент.ВыбиратьТип = Ложь;
		КонецЕсли;
		ТекущийЭлемент.ОграничениеТипа = ТипЗначенияАналитики;
		Если ТипЗначенияАналитики.СодержитТип(Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ")) Тогда
			БюджетированиеИОтчетность.УстановитьПараметрыВыбора(ТекущийЭлемент, "Отбор.Владелец", ДанныеВидаОтчета["ВидАналитики"+Сч]);
		КонецЕсли;
	КонецЦикла;
	Для Сч = МаксКлючевыхАналитик+1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ЭтаФорма["Аналитика"+Сч] = Неопределено;
		ЭтаФорма["Аналитики"+Сч].Очистить();
		Элементы["Аналитика"+Сч].Видимость = Ложь;
		Элементы["Аналитики"+Сч].Видимость = Ложь;
	КонецЦикла;
	
	ПолучитьЗначенияНастроек();
	
КонецПроцедуры

