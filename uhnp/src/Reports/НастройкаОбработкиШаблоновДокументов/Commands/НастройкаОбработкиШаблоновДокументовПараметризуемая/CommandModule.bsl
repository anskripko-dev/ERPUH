
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда
		ТекстПредупреждения = НСтр("ru = 'Данные еще не записаны.
			|Выполнение действия возможно только после записи данных.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("КомпактныйРежим", Ложь);
	ПараметрыФормы.Вставить("ИерархияВидовОтчетов", Ложь);
	ПараметрыФормы.Вставить("ОграничитьКлючевыеНастройки", Истина);
	
	Если ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.УправлениеПериодомСценария") Тогда
		ПараметрыФормы.Вставить("ВерсияРегламента",
			ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ПараметрКоманды, "ВерсияОрганизационнойСтруктуры"));
		ПараметрыФормы.Вставить("УправлениеПериодом", ПараметрКоманды);
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ВерсииРегламентовПодготовкиОтчетности") Тогда
		ПараметрыФормы.Вставить("ВерсияРегламента", ПараметрКоманды);
		ПараметрыФормы.Вставить("УправлениеПериодом", Неопределено);
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.НастраиваемыйОтчет") Тогда
		СформироватьПараметрыПоНастраиваемомуОтчету(ПараметрыФормы, ПараметрКоманды);
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ЭтапыУниверсальныхПроцессов") Тогда
		СформироватьПараметрыПоЭтапуПроцессаПодготовкиОтчетности(ПараметрыФормы, ПараметрКоманды);
	КонецЕсли;
	
	ОткрытьФорму("Отчет.НастройкаОбработкиШаблоновДокументов.ФормаОбъекта",
		ПараметрыФормы, ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);

КонецПроцедуры

&НаСервере
Процедура СформироватьПараметрыПоНастраиваемомуОтчету(ПараметрыФормы, ПараметрКоманды)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ПараметрКоманды);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастраиваемыйОтчет.УправлениеПериодом КАК УправлениеПериодом,
		|	НастраиваемыйОтчет.УправлениеПериодом.ВерсияОрганизационнойСтруктуры КАК ВерсияРегламента,
		|	НастраиваемыйОтчет.ВидОтчета КАК ВидОтчета,
		|	НастраиваемыйОтчет.Организация КАК Организация,
		|	НастраиваемыйОтчет.Проект КАК Проект,
		|	НастраиваемыйОтчет.Аналитика1 КАК Аналитика1,
		|	НастраиваемыйОтчет.Аналитика2 КАК Аналитика2,
		|	НастраиваемыйОтчет.Аналитика3 КАК Аналитика3,
		|	НастраиваемыйОтчет.Аналитика4 КАК Аналитика4,
		|	НастраиваемыйОтчет.Аналитика5 КАК Аналитика5,
		|	НастраиваемыйОтчет.Аналитика6 КАК Аналитика6,
		|	ВидыОтчетов.РазделениеПоПроектам КАК РазделениеПоПроектам,
		|	ВидыОтчетов.КоличествоАналитик КАК КоличествоАналитик
		|ИЗ
		|	Документ.НастраиваемыйОтчет КАК НастраиваемыйОтчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
		|		ПО НастраиваемыйОтчет.ВидОтчета = ВидыОтчетов.Ссылка
		|ГДЕ
		|	НастраиваемыйОтчет.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ВидОтчета", ВыборкаДетальныеЗаписи.ВидОтчета);
	СтруктураОтбора.Вставить("Организация", ВыборкаДетальныеЗаписи.Организация);
	
	Если ВыборкаДетальныеЗаписи.РазделениеПоПроектам Тогда
		СписокЗначений = Новый СписокЗначений;
		СписокЗначений.Добавить(Справочники.Проекты.ПустаяСсылка());
		СписокЗначений.Добавить(ВыборкаДетальныеЗаписи.Проект);
		СтруктураОтбора.Вставить("Проект", СписокЗначений);
	КонецЕсли;
	
	Для Сч = 1 По ВыборкаДетальныеЗаписи.КоличествоАналитик Цикл
		СписокЗначений = Новый СписокЗначений;
		СписокЗначений.Добавить(Неопределено);
		СписокЗначений.Добавить(ВыборкаДетальныеЗаписи["Аналитика" + Сч]);
		СтруктураОтбора.Вставить("Аналитика" + Сч, СписокЗначений);
	КонецЦикла;
	
	ПараметрыФормы.Вставить("ЗначенияОтбора", СтруктураОтбора);
	ПараметрыФормы.Вставить("УправлениеПериодом", ВыборкаДетальныеЗаписи.УправлениеПериодом);
	ПараметрыФормы.Вставить("ВерсияРегламента", ВыборкаДетальныеЗаписи.ВерсияРегламента);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПараметрыПоЭтапуПроцессаПодготовкиОтчетности(ПараметрыФормы, ПараметрКоманды)
	
	// Попробуем найти регламент
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсииРегламентовПодготовкиОтчетности.Ссылка КАК ВерсияРегламента
		|ИЗ
		|	Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииРегламентовПодготовкиОтчетности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныУниверсальныхПроцессов КАК ШаблоныУниверсальныхПроцессов
		|		ПО ВерсииРегламентовПодготовкиОтчетности.ШаблонПроцесса = ШаблоныУниверсальныхПроцессов.Ссылка
		|			И (ВерсииРегламентовПодготовкиОтчетности.ИспользоватьПроцесс)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
		|		ПО (ЭтапыУниверсальныхПроцессов.Владелец = ШаблоныУниверсальныхПроцессов.Ссылка)
		|ГДЕ
		|	ЭтапыУниверсальныхПроцессов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрКоманды);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() = 1 Тогда
		ПараметрыФормы.Вставить("ВерсияРегламента", РезультатЗапроса.Получить(0).ВерсияРегламента);
	Иначе
		ПараметрыФормы.Вставить("ВерсияРегламента", Справочники.ВерсииРегламентовПодготовкиОтчетности.ПустаяСсылка());
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Этап", ПараметрКоманды);
	
	ПараметрыФормы.Вставить("ЗначенияОтбора", СтруктураОтбора);
	
КонецПроцедуры
