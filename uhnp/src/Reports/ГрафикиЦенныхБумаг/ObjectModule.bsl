#Область ОбработчикиСобытий

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   Отказ - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если Форма.Параметры.Свойство("ПараметрКоманды") Тогда
		
		Ссылка = Форма.Параметры.ПараметрКоманды[0];
		ФИ = Неопределено;
		
		Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ЦенныеБумаги") Тогда
			
			ФИ = Ссылка;
			ВидФИ = Ссылка.ВидФинансовогоИнструмента;
			Отбор = Новый Структура("ПредметГрафика, Период, План", 
								Ссылка, 
								ТекущаяДатаСеанса(),
								Ложь
							);
							
		ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.НачисленияПоФинансовымИнструментам") Тогда
			
			ВидФИ = Неопределено;
			Отбор = Новый Структура("Организация, Период, План", 
								Ссылка.Организация,
								Ссылка.Дата,
								Ложь
							);
			
		Иначе //документы по ЦБ
			
			ФИ = Ссылка.ФинансовыйИнструмент;
			ВидФИ = Ссылка.ФинансовыйИнструмент.ВидФинансовогоИнструмента;
			Отбор = Новый Структура("ПредметГрафика, Период, Организация, План", 
								Ссылка.ФинансовыйИнструмент, 
								Ссылка.Дата, 
								Ссылка.Организация,
								(Ссылка.Метаданные().Реквизиты.Найти("План") <> Неопределено) И Ссылка.План
							);
			
		КонецЕсли;

		Компоновщик = Форма.Отчет.КомпоновщикНастроек;
		ТиповыеОтчетыУХ.УстановитьЗначенияПолей(Компоновщик, Отбор);
		Форма.Параметры.ПользовательскиеНастройки = Компоновщик.ПользовательскиеНастройки;
		Форма.Параметры.КлючВарианта = "Основной";
		Если ВидФИ = Перечисления.ВидыФинансовыхИнструментов.Облигация Тогда
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК ЭтоВыпущенная
			|ИЗ
			|	Документ.ВыпускЦеннойБумаги КАК т
			|ГДЕ
			|	т.ФинансовыйИнструмент = &ФИ");
			Запрос.УстановитьПараметр("ФИ", ФИ);
			
			Если Запрос.Выполнить().Пустой() Тогда
				Форма.Параметры.КлючВарианта = "ГрафикиОблигаций";//для полученных
			Иначе 
				Форма.Параметры.КлючВарианта = "ГрафикиЦенныхБумаг";//для выпущенных
			КонецЕсли;
			
		ИначеЕсли ВидФИ = Перечисления.ВидыФинансовыхИнструментов.Вексель Тогда
			Форма.Параметры.КлючВарианта = "ГрафикиВекселей";
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

