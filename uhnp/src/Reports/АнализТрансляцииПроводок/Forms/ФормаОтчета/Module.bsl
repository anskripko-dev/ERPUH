
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(Отчет,Параметры);
	Параметры.Свойство("СтруктураОтборПриемник",СтруктураОтборПриемник);
	
	Если ЗначениеЗаполнено(Параметры.ДокументТрансляции) Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	Трансляция.Организация КАК Организация,
		             |	Трансляция.ШаблонКорректировки КАК ШаблонКорректировки,
		             |	Трансляция.ИспользуемаяИБ КАК ИспользуемаяИБ,
		             |	Трансляция.ИсходныйДокумент КАК ИсходныйДокумент,
		             |	Трансляция.НачалоПериода КАК ДатаНач,
		             |	Трансляция.ОкончаниеПериода КАК ДатаКон
		             |ИЗ
		             |	Документ.Трансляция КАК Трансляция
		             |ГДЕ
		             |	Трансляция.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",Параметры.ДокументТрансляции);
		Результат=Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		
		ЗаполнитьЗначенияСвойств(Отчет,Результат);
				
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ОпределитьШаблонКорректировки();
		
	Иначе
		
		ПриИзмененииШаблонаКорректировки();
		
	КонецЕсли;
								 	 
	 Если Параметры.Свойство("ДатаНач") Тогда
		 
		 Отчет.ДатаНач=Параметры.ДатаНач;
		 Отчет.ДатаКон=Параметры.ДатаКон;
				 		
	 КонецЕсли; 
	 
	 Если ЗначениеЗаполнено(Отчет.Организация) Тогда
		 
		 ПолучитьДанныеУчетнойПолитики();
		 
	 КонецЕсли;
	 
	 ОбновитьДанныеПоСубконто();
	 
	СформироватьЗаголовокФормы();
	УстановитьВидимость();
	
	Элементы.ПанельНастройка.Видимость=Ложь;
	СформироватьЗаголовокНастройки();
	
	ПоместитьРабочийОбъект(РеквизитФормыВЗначение("Отчет"));
	
	Если Параметры.ФормироватьОтчет Тогда
		
		СформироватьОтчетНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗаголовокНастройки(ТекстОтбораИтог="")
	
	ТекстНастройки="";
	
	Если ЗначениеЗаполнено(Отчет.СчетДтИсточник) Тогда
		
		ТекстНастройки=ТекстНастройки+","+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Счет дт (%1): %2'"),Отчет.ПланСчетовИсточник,Отчет.СчетДтИсточник);
				
	КонецЕсли;
			
	Если ЗначениеЗаполнено(Отчет.СчетКтИсточник) Тогда
		
		ТекстНастройки=ТекстНастройки+","+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Счет кт (%1): %2'"),Отчет.ПланСчетовИсточник,Отчет.СчетКтИсточник);
				
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчет.СчетДтПриемник) Тогда
		
		ТекстНастройки=ТекстНастройки+","+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Счет Дт (%1): %2'"),ПланСчетовПриемник,Отчет.СчетДтПриемник);
				
	КонецЕсли;
			
	Если ЗначениеЗаполнено(Отчет.СчетКтПриемник) Тогда
		
		ТекстНастройки=ТекстНастройки+","+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Счет Кт (%1): %2'"),ПланСчетовПриемник,Отчет.СчетКтПриемник);
				
	КонецЕсли; 
			
	Если ТипЗнч(СтруктураОтборПриемник)=Тип("Структура") Тогда
		
		Для Каждого КлючИЗначение ИЗ СтруктураОтборПриемник Цикл
			
			ТекстНастройки=ТекстНастройки+","+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1 (%2): %3'"),КлючИЗначение.Ключ,ПланСчетовПриемник,КлючИЗначение.Значение);
				
		КонецЦикла;
			
	КонецЕсли;			
			
	Если ПустаяСтрока(ТекстНастройки) Тогда
		
		Элементы.ДекорацияНастройка.Заголовок=НСтр("ru = 'Настройки'");
		
	Иначе
		
		Элементы.ДекорацияНастройка.Заголовок=Сред(ТекстНастройки,2);
		
	КонецЕсли;
			
КонецПроцедуры // СформироватьЗаголовокНастройки() 

&НаСервере
Процедура СформироватьЗаголовокФормы()
	
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) тогда
		
		ТекстЗаголовка=СтрШаблон(Нстр("ru = 'Анализ трансляции: %1, %2, %3'"),Отчет.ШаблонКорректировки,Отчет.Организация,Отчет.ИсходныйДокумент);	
		
	Иначе
		
		ТекстЗаголовка=СтрШаблон(Нстр("ru = 'Анализ трансляции: %1, %2, %3 - %4'"),Отчет.ШаблонКорректировки,Отчет.Организация,Отчет.ДатаНач,Отчет.ДатаКон);	
		
	КонецЕсли;

	ЭтаФорма.Заголовок=ТекстЗаголовка;
		
КонецПроцедуры // СформироватьЗаголовокФормы()

&НаСервере
Процедура УстановитьВидимость()
	
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		
		Элементы.ГруппаНастройкаПериод.Видимость=Ложь;
		Элементы.ИсходныйДокумент.Видимость=Истина;
		
	ИначеЕсли ЗначениеЗаполнено(Отчет.ДокументТрансляции) Тогда
		
		Элементы.ГруппаНастройкаПериод.ТолькоПросмотр=Истина;
		
	КонецЕсли;
			
	Элементы.ИсходныйДокумент.Видимость=ЗначениеЗаполнено(Отчет.ИсходныйДокумент);
	Элементы.ДокументТрансляции.Видимость=ЗначениеЗаполнено(Отчет.ДокументТрансляции); 
	
	Если ТипЗнч(СтруктураОтборПриемник)=Тип("Структура") Тогда
		
		Элементы.ГруппаОтбор.Видимость=Ложь;
		Элементы.ТолькоНесопоставленные.Видимость=Ложь;
		Элементы.ГруппаНастройка.ТолькоПросмотр=Истина;
		Элементы.ГруппаОсновные.ТолькоПросмотр=Истина;
		
	Иначе
		
		Элементы.ГруппаОтбор.Видимость=ЗначениеЗаполнено(Отчет.СчетДтИсточник) ИЛИ ЗначениеЗаполнено(Отчет.СчетКтИсточник);
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьВидимость() 

&НаСервере
Процедура ОпределитьПараметрыВыверки()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ШаблоныТрансляций.ПланСчетовИсточник КАК ПланСчетовИсточник,
	|	ШаблоныТрансляций.ПланСчетовПриемник КАК ПланСчетовПриемник,
	|	ШаблоныТрансляций.РегистрБухгалтерииИсточник КАК РегистрБухгалтерииИсточник,
	|	ШаблоныТрансляций.РегистрБухгалтерииПриемник КАК РегистрБухгалтерииПриемник,
	|	ШаблоныТрансляций.ПланСчетовИсточник.Владелец КАК ТипБД
	|ИЗ
	|	Справочник.ШаблоныТрансляций КАК ШаблоныТрансляций
	|ГДЕ
	|	ШаблоныТрансляций.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Отчет.ШаблонКорректировки);

	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
		
	ТипБД=Результат.ТипБД;
	РегистрБухгалтерииИсточник	= Результат.РегистрБухгалтерииИсточник;
	РегистрБухгалтерииПриемник	= Результат.РегистрБухгалтерииПриемник;
	Отчет.ПланСчетовИсточник	= Результат.ПланСчетовИсточник;
	ПланСчетовПриемник			= Результат.ПланСчетовПриемник;
	
	Элементы.ГруппаИспользуемаяИБ.Видимость=(НЕ ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ);
	
	Запрос.Текст="ВЫБРАТЬ
	|	РегистрыБухгалтерииБДРесурсы.Имя КАК РесурсИсточник,
	|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК Отображать,
	|	ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник,
	|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК РесурсИсточникБалансовый
	|ИЗ
	|	Справочник.ШаблоныТрансляций.СоответствиеРесурсов КАК ШаблоныТрансляцийСоответствиеРесурсов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрыБухгалтерииБД.Ресурсы КАК РегистрыБухгалтерииБДРесурсы
	|		ПО ШаблоныТрансляцийСоответствиеРесурсов.Ссылка.РегистрБухгалтерииИсточник = РегистрыБухгалтерииБДРесурсы.Ссылка
	|			И ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = РегистрыБухгалтерииБДРесурсы.Имя
	|ГДЕ
	|	ШаблоныТрансляцийСоответствиеРесурсов.Ссылка = &Ссылка
	|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = """"
	|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник = """"";
	
		
	РесурсыДляОтображения.Очистить();
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=РесурсыДляОтображения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
		
	КонецЦикла; 
						
КонецПроцедуры // ПриИзмененииШаблонаКорректировки() 

&НаСервере
Процедура ОпределитьПравилоОбработки()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПравилаОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаОбработки КАК ПравилаОбработки
	|ГДЕ
	|	ПравилаОбработки.НаправлениеТрансляции = &НаправлениеТрансляции
	|	И ПравилаОбработки.Владелец = &Владелец
	|	И НЕ ПравилаОбработки.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НаправлениеТрансляции",Перечисления.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии);
	Запрос.УстановитьПараметр("Владелец",Отчет.ШаблонКорректировки);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ПравилоОбработки=Результат.Ссылка;
				
	КонецЕсли;
					
КонецПроцедуры // ПриИзмененииШаблонаКорректировки()

&НаСервере
Процедура ПриИзмененииКлючевогоПараметра()
	
	ОпределитьШаблонКорректировки(); 
	СформироватьЗаголовокФормы();
	УстановитьВидимость();
	
КонецПроцедуры // ПриИзмененииКлючевогоПараметра() 


&НаКлиенте
Процедура ШаблонКорректировкиПриИзменении(Элемент)
	
	ПриИзмененииШаблонаКорректировки();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииШаблонаКорректировки()
	
	ОпределитьПараметрыВыверки();
	ОпределитьПравилоОбработки();
	СформироватьЗаголовокФормы();
		
КонецПроцедуры // ПриИзмененииШаблонаКорректировки()

&НаСервере
Процедура ОпределитьШаблонКорректировки()
	
	Если ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПолучитьДанныеУчетнойПолитики();
	
	Отчет.ШаблонКорректировки=ДанныеУчетнойПолитики.ШаблонТрансляции;
		
	Если ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ПриИзмененииШаблонаКорректировки();
		
	КонецЕсли;
		
КонецПроцедуры // ОпределитьШаблонКорректировки()

&НаСервере
Процедура ПолучитьДанныеУчетнойПолитики()
	
	ДанныеУчетнойПолитики=Новый ФиксированнаяСтруктура(КорректировкиЗначенийПоказателей32.ПолучитьДанныеУчетнойПолитики(Отчет.Организация,,Отчет.ДатаНач));
	
КонецПроцедуры // ПолучитьДанныеУчетнойПолитики()

&НаСервере
Процедура ПриИзмененииОрганизации()
	
	ПриИзмененииКлючевогоПараметра();
		
КонецПроцедуры // ПриИзмененииОрганизации()

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПриИзмененииОрганизации();	
	
КонецПроцедуры // ОрганизацияПриИзменении() 

&НаКлиенте
Процедура ИзменитьПериод(Команда)
		
	ПараметрыВыбора = Новый Структура("НачалоПериода,КонецПериода", Отчет.ДатаНач, Отчет.ДатаКон);
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыВыбора, Элементы.ИзменитьПериод, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
		
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		
		ПриВыбореПериода(РезультатВыбора);
					
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриВыбореПериода(РезультатВыбора)
		
	Отчет.ДатаНач=РезультатВыбора.НачалоПериода;
	Отчет.ДатаКон=РезультатВыбора.КонецПериода; 
	
	Отчет.ПериодОтчета=ОбщегоНазначенияУХ.ПолучитьПроизвольныйПериод(Отчет.ДатаНач, НачалоДня(Отчет.ДатаКон));
	
	ПриИзмененииКлючевогоПараметра();
		
КонецПроцедуры // ПриВыбореПериода()

&НаСервере
Функция ПолучитьПредставлениеПравила(Правило,КэшПредставлений,ДтКт)
	
	ПредставлениеПравила=КэшПредставлений.Получить(Правило);
	
	Если ПредставлениеПравила=Неопределено Тогда
		
		ПредставлениеПравила=Обработки.КорректировкиЗначенийПоказателей.ПолучитьПодробнуюИнформацию(Правило,РегистрБухгалтерииИсточник,ДтКт);
		КэшПредставлений.Вставить(Правило,ПредставлениеПравила);
		
	КонецЕсли;
				
	Возврат ПредставлениеПравила;
	
КонецФункции // ПолучитьПредставлениеПравила()

&НаСервере
Функция ПолучитьДопОтборыИсточник() 
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.мТаблицаПоказателейБД			= РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ОтчетОбъект.мТаблицаПроизводныхБД			= РеквизитФормыВЗначение("мТаблицаПроизводныхБД");	
	ОтчетОбъект.ТабличноеПолеИзмеренийБД 		= РеквизитФормыВЗначение("ТабличноеПолеИзмеренийБД");
	ОтчетОбъект.мТабПравилаВычисленияПараметров	= ОтчетОбъект.ТабПравилаВычисленияПараметров.Скопировать();
	
	Возврат ОтчетОбъект.ПолучитьДопОтборыИсточник();
		
КонецФункции // ПолучитьДопОтборыИсточник() 

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("ИсходныйДокумент",			Отчет.ИсходныйДокумент);
	ДанныеОбъекта.Вставить("ШаблонКорректировки",		Отчет.ШаблонКорректировки);
	ДанныеОбъекта.Вставить("ИспользуемаяИБ",			Отчет.ИспользуемаяИБ);
	ДанныеОбъекта.Вставить("РегистрБухгалтерииИсточник",РегистрБухгалтерииИсточник);
	ДанныеОбъекта.Вставить("ПланСчетовИсточник",		Отчет.ПланСчетовИсточник);
	ДанныеОбъекта.Вставить("Организация",				Отчет.Организация);
	ДанныеОбъекта.Вставить("ДатаНач",					Отчет.ДатаНач);
	ДанныеОбъекта.Вставить("ДатаКон",					Отчет.ДатаКон);
	ДанныеОбъекта.Вставить("СчетДтИсточник",			Отчет.СчетДтИсточник);
	ДанныеОбъекта.Вставить("СчетКтИсточник",			Отчет.СчетКтИсточник);
	ДанныеОбъекта.Вставить("СчетДтПриемник",			);
	ДанныеОбъекта.Вставить("СчетКтПриемник",			);
	ДанныеОбъекта.Вставить("ДетальнаяТрансляция",		Истина);
	ДанныеОбъекта.Вставить("ПериодОтчета",				Новый Структура("ДатаНачала,ДатаОкончания",Отчет.ДатаНач,НачалоДня(Отчет.ДатаКон)));
	ДанныеОбъекта.Вставить("АнализЧувствительности",	Ложь);
	ДанныеОбъекта.Вставить("ПравилоОбработки",			ПравилоОбработки);
	ДанныеОбъекта.Вставить("УчетнаяПолитика",			Новый Структура("БезКорреспонденции",Ложь));
	ДанныеОбъекта.Вставить("ПланСчетов",				ПланСчетовПриемник);
	ДанныеОбъекта.Вставить("РегистрБухгалтерии",		РегистрБухгалтерииПриемник);
	ДанныеОбъекта.Вставить("ВалютаУчетаИсточник",			ДанныеУчетнойПолитики.ВалютаИсточник);
	ДанныеОбъекта.Вставить("ВалютаПредставленияИсточник",	ДанныеУчетнойПолитики.ВалютаИсточникДоп);
	ДанныеОбъекта.Вставить("ВалютаУчетаПриемник",			ДанныеУчетнойПолитики.ВалютаУчета);
	ДанныеОбъекта.Вставить("ВалютаПредставленияПриемник",	ДанныеУчетнойПолитики.ВалютаУчетаДоп);
	ДанныеОбъекта.Вставить("РесурсыДляОтображения",         РеквизитФормыВЗначение("РесурсыДляОтображения"));
	ДанныеОбъекта.Вставить("База",							Неопределено);
	ДанныеОбъекта.Вставить("ТолькоПроверка",				НЕ ЗагружатьОбъектыВИБ);
	
	Если Отчет.ТабПравилаВычисленияПараметров.Количество()>0 Тогда	
		
		ДанныеОбъекта.Вставить("ДопОтборИсточник",ПолучитьДопОтборыИсточник());
		СформироватьЗаголовокНастройки(ДанныеОбъекта.ДопОтборИсточник.СтрокаОтборовИтог);
		
	КонецЕсли;
		
	СтрокаКолонокИсточник="";
	ТаблицаПроводок=Обработки.КорректировкиЗначенийПоказателей.ПолучитьТаблицуДетальнойТрансляции(ДанныеОбъекта,СтрокаКолонокИсточник);
	
	Если ТипЗнч(СтруктураОтборПриемник)=Тип("Структура") И СтруктураОтборПриемник.Количество()>0 Тогда
		
		ТаблицаПроводок=ТаблицаПроводок.Скопировать(СтруктураОтборПриемник);
		
	Иначе
		
		ОтборПриемник=Новый Структура;
		
		Если ЗначениеЗаполнено(Отчет.СчетДтПриемник) Тогда
			
			ОтборПриемник.Вставить("СчетДт",Отчет.СчетДтПриемник);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отчет.СчетКтПриемник) Тогда
			
			ОтборПриемник.Вставить("СчетКт",Отчет.СчетКтПриемник);
			
		КонецЕсли; 
		
		Если ОтборПриемник.Количество()>0 Тогда
			
			ТаблицаПроводок=ТаблицаПроводок.Скопировать(ОтборПриемник);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТабДокВсеАдрес="";
	ТабДокНесопоставленныеАдрес="";
	
	ТаблицаПроводокАдрес=ПоместитьВоВременноеХранилище(ТаблицаПроводок,ЭтаФорма.УникальныйИдентификатор);
	
	ОтобразитьТаблицуПроводок();
	
		
		
КонецПроцедуры // СформироватьОтчетНаСервере() 

&НаСервере
Процедура ОтобразитьТаблицуПроводок()
	
	ТабДок.Очистить();
	
	Если Отчет.ТолькоНесопоставленные  Тогда
		
		Если ЗначениеЗаполнено(ТабДокНесопоставленныеАдрес) Тогда
			
			ТабДок.Вывести(ПолучитьИзВременногоХранилища(ТабДокНесопоставленныеАдрес));
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(ТабДокВсеАдрес) Тогда
			
			ТабДок.Вывести(ПолучитьИзВременногоХранилища(ТабДокВсеАдрес));
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаПроводок=ПолучитьИзВременногоХранилища(ТаблицаПроводокАдрес);
	
	Макет=Отчеты.АнализТрансляцииПроводок.ПолучитьМакет("Макет");
	СтруктураОбластей=Новый Структура;
	ЕстьОтметкаВНА=Ложь;
		
	Если Отчет.ТолькоНесопоставленные Тогда
		
		СтруктураОбластей.Вставить("ОбластьЗаголовок",	Макет.ПолучитьОбласть("ОбластьЗаголовокНесопоставленные"));
        СтруктураОбластей.Вставить("ОбластьСчета",		Макет.ПолучитьОбласть("ОбластьНесопоставленныеСчета"));
		СтруктураОбластей.Вставить("ОбластьСубконто",	Макет.ПолучитьОбласть("ОбластьНесопоставленныеСубконто"));
		СтруктураОбластей.Вставить("ОбластьИтого",		Макет.ПолучитьОбласть("ОбластьИтогоНесопоставленные"));
		СтруктураОбластей.Вставить("ОбластьГруппировка",Макет.ПолучитьОбласть("ОбластьГруппировка"));

		
		РабочаяТаблица=ТаблицаПроводок.Скопировать(Новый Структура("НеТранслируется",Истина));
		РабочаяТаблица.Свернуть(Сред(СтрокаКолонокИсточник,2),"Сумма_Источник,Значение");
		РабочаяТаблица.Сортировать("СчетДтИсточникКод,СчетКтИсточникКод");
		ВывестиТолькоНеСопоставленные(РабочаяТаблица,СтруктураОбластей);

		
	Иначе
		
		СтруктураОбластей.Вставить("ОбластьЗаголовок",					Макет.ПолучитьОбласть("ОбластьЗаголовок"));
        СтруктураОбластей.Вставить("ОбластьСчета",						Макет.ПолучитьОбласть("ОбластьСчета"));
		СтруктураОбластей.Вставить("ОбластьПодразделение",				Макет.ПолучитьОбласть("ОбластьПодразделение"));
		СтруктураОбластей.Вставить("ОбластьНаправлениеДеятельности",	Макет.ПолучитьОбласть("ОбластьНаправлениеДеятельности"));
		СтруктураОбластей.Вставить("ОбластьСубконто",					Макет.ПолучитьОбласть("ОбластьСубконто"));
		СтруктураОбластей.Вставить("ОбластьИтого",						Макет.ПолучитьОбласть("ОбластьИтого"));
		
		РабочаяТаблица=ТаблицаПроводок;
		РабочаяТаблица.Сортировать("НеТранслируется,Период,СчетДтИсточникКод,СчетКтИсточникКод");
		ВывестиВсе(РабочаяТаблица,СтруктураОбластей);
		
	КонецЕсли;
	
	
КонецПроцедуры // ОтобразитьТаблицуПроводок() 

&НаСервере
Функция ПолучитьПричину(НеТранслируетсяПричина,ДтКт)

	Если СтрНайти(НеТранслируетсяПричина,"НетМэппинга"+ДтКт)>0 Тогда
		
		Возврат НСтр("ru = 'Нет мэппинга'");
		
	КонецЕсли;
			
	Если СтрНайти(НеТранслируетсяПричина,"Субконто"+ДтКт)>0 Тогда
		
		Возврат НСтр("ru = 'Исключаемые ВНА'");
		
	КонецЕсли;
	
	Если СтрНайти(НеТранслируетсяПричина,"ДополнительныеОтборы"+ДтКт)>0 Тогда
		
		Возврат НСтр("ru = 'Дополнительные отборы'");
		
	КонецЕсли;
		
КонецФункции // ПолучитьПричину()

&НаСервере
Функция ПолучитьМассивЦветов()
	
    МассивЦветов=Новый Массив;
	МассивЦветов.Добавить(Новый Цвет(255,255,255));
	МассивЦветов.Добавить(Новый Цвет(245,251,247));
	
	Возврат МассивЦветов;
	
КонецФункции // ПолучитьМассивЦветов()

&НаСервере
Процедура ВывестиВсе(РабочаяТаблица,СтруктураОбластей)
	
	ТабДокВсе=Новый ТабличныйДокумент;
	
	ИтогоИсточник=0;
	ИтогоПриемник=0;

	СтруктураОбластей.ОбластьЗаголовок.Параметры.ПланСчетовИсточник=Отчет.ПланСчетовИсточник;
	СтруктураОбластей.ОбластьЗаголовок.Параметры.ПланСчетовПриемник=ПланСчетовПриемник;
	
	СтруктураОбластей.ОбластьЗаголовок.Параметры.ЗаголовокЗначениеИсточник=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Значение (%1)'"),Отчет.ПланСчетовИсточник);
	СтруктураОбластей.ОбластьЗаголовок.Параметры.ЗаголовокЗначениеПриемник=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Значение (%1)'"),ПланСчетовПриемник);			
	
	ТабДокВсе.Вывести(СтруктураОбластей.ОбластьЗаголовок); 
	ТабДок.ФиксацияСверху=2;
		
	КэшПредставлений=Новый Соответствие;
	МассивЦветов=ПолучитьМассивЦветов();
	ИндексЦвета=0;
	
	Для Каждого Строка ИЗ РабочаяТаблица Цикл 
		
		ЦветПоУмолчанию=МассивЦветов[ИндексЦвета];
		
		Для Каждого КлючИЗначение ИЗ СтруктураОбластей Цикл
			
			Если КлючИЗначение.Ключ="ОбластьЗаголовок"
				ИЛИ КлючИЗначение.Ключ="ОбластьИтого" Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Для Каждого Область ИЗ КлючИЗначение.Значение.Области Цикл 
				
				Область.ЦветФона=ЦветПоУмолчанию;
				
			КонецЦикла;
			
		КонецЦикла; 
		
		ИтогоИсточник=ИтогоИсточник+Строка.Сумма_Источник;
		ИтогоПриемник=ИтогоПриемник+Строка.Значение; 
		ИндексЦвета=?(ИндексЦвета=0,1,0); 
				
		ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьСчета.Параметры,Строка,,?(ЗначениеЗаполнено(Отчет.ИсходныйДокумент),"Регистратор",""));
		СтруктураОбластей.ОбластьСчета.Параметры.ДанныеДляОтчета=ПолучитьДанныеДляОтчетаОПроводках(Строка);
			
		ТекстНеТранслируетсяДт="";
		ТекстНеТранслируетсяКт="";
		
		Если НЕ ПустаяСтрока(Строка.НеТранслируетсяПричина) Тогда
			
			ТекстНеТранслируетсяДт=ПолучитьПричину(Строка.НеТранслируетсяПричина,"Дт");
			ТекстНеТранслируетсяКт=ПолучитьПричину(Строка.НеТранслируетсяПричина,"Кт");
			
			Если СтрНайти(Строка.НеТранслируетсяПричина,"НетМэппинга")>0 Тогда
				
				СтруктураОбластей.ОбластьСчета.Параметры.ОтборДт=ТекстНеТранслируетсяДт;
				СтруктураОбластей.ОбластьСчета.Параметры.ОтборКт=ТекстНеТранслируетсяКт;
				
				СтруктураОбластей.ОбластьСчета.Параметры.ПравилоДт=?(ПустаяСтрока(СтруктураОбластей.ОбластьСчета.Параметры.ОтборДт),
					Неопределено,Строка.СчетДтИсточникКод);
				СтруктураОбластей.ОбластьСчета.Параметры.ПравилоКт=?(ПустаяСтрока(СтруктураОбластей.ОбластьСчета.Параметры.ОтборКт),
					Неопределено,Строка.СчетКтИсточникКод);
							
				ТабДокВсе.Вывести(СтруктураОбластей.ОбластьСчета);
				
				Продолжить;
				
			КонецЕсли;	
			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Строка.СчетДт) Тогда
			
			ПредставлениеДт=ПолучитьПредставлениеПравила(Строка.ПравилоДт,КэшПредставлений,"Дт");
			ПредставлениеКт=ПолучитьПредставлениеПравила(Строка.ПравилоКт,КэшПредставлений,"Кт");				
				
			СтруктураОбластей.ОбластьСчета.Параметры.ОтборДт=?(ЗначениеЗаполнено(ПредставлениеДт.ОтборПодробно),
						НСтр("ru = 'Отбор: '")+ПредставлениеДт.ОтборПодробно,"");
			СтруктураОбластей.ОбластьСчета.Параметры.ОтборКт=?(ЗначениеЗаполнено(ПредставлениеКт.ОтборПодробно),
						НСтр("ru = 'Отбор: '")+ПредставлениеКт.ОтборПодробно,"");
	
			ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьСубконто.Параметры,ПредставлениеДт.СтруктураСоответствия);
			ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьСубконто.Параметры,ПредставлениеКт.СтруктураСоответствия);
	
			СоответствиеДт=ПредставлениеДт.СоответствиеПодробно;
			СоответствиеКт=ПредставлениеКт.СоответствиеПодробно; 
			
		Иначе
			
			СтруктураОбластей.ОбластьСчета.Параметры.ОтборДт=ТекстНеТранслируетсяДт;
			
			Если Не ПустаяСтрока(ТекстНеТранслируетсяДт) Тогда
				
				СтруктураОбластей.ОбластьСчета.Параметры.ПравилоДт=Строка.СчетДтИсточникКод;
				
			Иначе
				
				СтруктураОбластей.ОбластьСчета.Параметры.ПравилоДт=Неопределено;
				
			КонецЕсли;
			
			СтруктураОбластей.ОбластьСчета.Параметры.ОтборКт=ТекстНеТранслируетсяКт;
			
			Если Не ПустаяСтрока(ТекстНеТранслируетсяКт) Тогда
				
				СтруктураОбластей.ОбластьСчета.Параметры.ПравилоКт=Строка.СчетКтИсточникКод;
				
			Иначе
				
				СтруктураОбластей.ОбластьСчета.Параметры.ПравилоКт=Неопределено;
				
			КонецЕсли;
			
			Для Индекс = 1 по 3 Цикл
				СтруктураОбластей.ОбластьСубконто.Параметры["СубконтоДт"+Индекс+"_Заполнение"]="";
				СтруктураОбластей.ОбластьСубконто.Параметры["СубконтоКт"+Индекс+"_Заполнение"]="";
			КонецЦикла;
			
			СоответствиеДт="";
			СоответствиеКт="";
	
		КонецЕсли; 
		
		ТабДокВсе.Вывести(СтруктураОбластей.ОбластьСчета);
		
		Если СтрНайти(СтруктураОбластей.ОбластьСчета.Параметры.ОтборДт,"Подразделение")>0
			ИЛИ СтрНайти(СтруктураОбластей.ОбластьСчета.Параметры.ОтборКт,"Подразделение")>0
			ИЛИ СтрНайти(СоответствиеДт,"Подразделение")>0
			ИЛИ СтрНайти(СоответствиеКт,"Подразделение")>0 Тогда
			
			ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьПодразделение.Параметры,Строка);
			ТабДокВсе.Вывести(СтруктураОбластей.ОбластьПодразделение);
			
		КонецЕсли;
		
		Если СтрНайти(СтруктураОбластей.ОбластьСчета.Параметры.ОтборДт,"НаправлениеДеятельности")>0
			ИЛИ СтрНайти(СтруктураОбластей.ОбластьСчета.Параметры.ОтборКт,"НаправлениеДеятельности")>0
			ИЛИ СтрНайти(СоответствиеДт,"НаправлениеДеятельности")>0
			ИЛИ СтрНайти(СоответствиеКт,"НаправлениеДеятельности")>0 Тогда
			
			ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьНаправлениеДеятельности.Параметры,Строка);
			ТабДокВсе.Вывести(СтруктураОбластей.ОбластьНаправлениеДеятельности);
			
		КонецЕсли;
		
		ОтметитьНеТранслируемыеВНА(СтруктураОбластей.ОбластьСубконто,Строка,ЦветПоУмолчанию);
		ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьСубконто.Параметры,Строка);
		ТабДокВсе.Вывести(СтруктураОбластей.ОбластьСубконто);
		
	КонецЦикла;
	
	
	СтруктураОбластей.ОбластьИтого.Параметры.ИтогоИсточник=ИтогоИсточник;
	СтруктураОбластей.ОбластьИтого.Параметры.ИтогоПриемник=ИтогоПриемник;
	СтруктураОбластей.ОбластьИтого.Параметры.Отклонение=ИтогоИсточник-ИтогоПриемник;
	ТабДокВсе.Вывести(СтруктураОбластей.ОбластьИтого);
	
	ТабДокВсеАдрес=ПоместитьВоВременноеХранилище(ТабДокВсе,ЭтаФорма.УникальныйИдентификатор);
	ТабДок.Вывести(ТабДокВсе);
	
КонецПроцедуры // ВывестиВсе()

&НаСервере
Функция ПолучитьДанныеДляОтчетаОПроводках(СтрокаПроводки)

	СтруктураДанных=Новый Структура; 
	
	СтруктураДанных.Вставить("Период",?(Отчет.ТолькоНесопоставленные,"",СтрокаПроводки.Период));
	СтруктураДанных.Вставить("СчетДтИсточникКод",СтрокаПроводки.СчетДтИсточникКод);
	СтруктураДанных.Вставить("СчетКтИсточникКод",СтрокаПроводки.СчетКтИсточникКод); 
	
	Для Индекс=1 По 3 Цикл
		
		СтруктураДанных.Вставить("СубконтоДтИсточник"+Индекс,СтрокаПроводки["СубконтоДтИсточник"+Индекс]);
		СтруктураДанных.Вставить("СубконтоКтИсточник"+Индекс,СтрокаПроводки["СубконтоКтИсточник"+Индекс]); 
		
		СтруктураДанных.Вставить("СубконтоДтИсточник"+Индекс+"Представление",СтрокаПроводки["СубконтоДтИсточник"+Индекс+"Представление"]);
		СтруктураДанных.Вставить("СубконтоКтИсточник"+Индекс+"Представление",СтрокаПроводки["СубконтоКтИсточник"+Индекс+"Представление"]);
		
	КонецЦикла;
	
	Возврат СтруктураДанных; 
	
КонецФункции // ПолучитьДанныеДляОтчетаОПроводках()

&НаСервере
Процедура ВывестиТолькоНеСопоставленные(РабочаяТаблица,СтруктураОбластей)
	
	ТабДокНесопоставленные=Новый ТабличныйДокумент;
	
	ИтогоИсточник=0;
	
	РабочаяТаблица.Колонки.Добавить("НетМэппинга",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	РабочаяТаблица.Колонки.Добавить("ДополнительныеОтборы",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	РабочаяТаблица.Колонки.Добавить("ИсключаемыеВНА",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	
	НетМэппинга=0;
	ДополнительныеОтборы=0;
	ИсключаемыеВНА=0;
		
	Для Каждого Строка ИЗ РабочаяТаблица Цикл
		
		Если СтрНайти(Строка.НеТранслируетсяПричина,"НетМэппинга")>0 Тогда
			
			Строка.НетМэппинга=Истина;
			
		ИначеЕсли СтрНайти(Строка.НеТранслируетсяПричина,"Субконто")>0 Тогда
			
			 Строка.ИсключаемыеВНА=Истина;
			 
		 ИначеЕсли СтрНайти(Строка.НеТранслируетсяПричина,"ДополнительныеОтборы")>0 Тогда
			 
			 Строка.ДополнительныеОтборы=Истина;
			 
		КонецЕсли;
					
		НетМэппинга			= НетМэппинга+?(Строка.НетМэппинга,Строка.Сумма_Источник,0);
		ДополнительныеОтборы= ДополнительныеОтборы+?(Строка.ДополнительныеОтборы,Строка.Сумма_Источник,0); 
		ИсключаемыеВНА		= ИсключаемыеВНА+?(Строка.ИсключаемыеВНА,Строка.Сумма_Источник,0); 
			
	КонецЦикла;
				
	СтруктураОбластей.ОбластьЗаголовок.Параметры.ПланСчетовИсточник=Отчет.ПланСчетовИсточник;

	
	СтруктураОбластей.ОбластьЗаголовок.Параметры.ЗаголовокЗначениеИсточник=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Значение (%1)'"),Отчет.ПланСчетовИсточник);
		
	ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьЗаголовок);
	ТабДокНесопоставленные.ФиксацияСверху=2;
	
	
	Если НетМэппинга>0 Тогда
		
		СтруктураОбластей.ОбластьГруппировка.Параметры.ИмяГруппировки=НСтр("ru = 'Нет мэппинга'");
		СтруктураОбластей.ОбластьГруппировка.Параметры.ИтогоГруппировка=НетМэппинга;	
		ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьГруппировка);
		
		МассивСтрок=РабочаяТаблица.НайтиСтроки(Новый Структура("НетМэппинга",Истина));
		
		ВывестиГруппировкуНесопоставленные(МассивСтрок,ТабДокНесопоставленные,СтруктураОбластей);
		
	КонецЕсли;
	
	Если ДополнительныеОтборы>0 Тогда
		
		СтруктураОбластей.ОбластьГруппировка.Параметры.ИмяГруппировки=НСтр("ru = 'Дополнительные отборы'");
		СтруктураОбластей.ОбластьГруппировка.Параметры.ИтогоГруппировка=ДополнительныеОтборы;	
		ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьГруппировка);
		
		МассивСтрок=РабочаяТаблица.НайтиСтроки(Новый Структура("ДополнительныеОтборы,ИсключаемыеВНА",Истина,Ложь));
		
		ВывестиГруппировкуНесопоставленные(МассивСтрок,ТабДокНесопоставленные,СтруктураОбластей);
		
	КонецЕсли;
	
	Если ИсключаемыеВНА>0 Тогда
		
		СтруктураОбластей.ОбластьГруппировка.Параметры.ИмяГруппировки=НСтр("ru = 'Исключаемые ВНА'");
		СтруктураОбластей.ОбластьГруппировка.Параметры.ИтогоГруппировка=ИсключаемыеВНА;	
		ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьГруппировка);
		
		МассивСтрок=РабочаяТаблица.НайтиСтроки(Новый Структура("ДополнительныеОтборы,ИсключаемыеВНА",Ложь,Истина));
		
		ВывестиГруппировкуНесопоставленные(МассивСтрок,ТабДокНесопоставленные,СтруктураОбластей);
		
	КонецЕсли;
		
	СтруктураОбластей.ОбластьИтого.Параметры.ИтогоИсточник=РабочаяТаблица.Итог("Сумма_Источник");
	ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьИтого);
	
	ТабДокНесопоставленныеАдрес=ПоместитьВоВременноеХранилище(ТабДокНесопоставленные,ЭтаФорма.УникальныйИдентификатор);
	ТабДок.Вывести(ТабДокНесопоставленные);
	
	
КонецПроцедуры // ВывестиВсе()

&НаСервере
Процедура ВывестиГруппировкуНесопоставленные(МассивСтрок,ТабДокНесопоставленные,СтруктураОбластей)
	
	МассивЦветов=ПолучитьМассивЦветов();
	ИндексЦвета=0;
	
	ТабДокНесопоставленные.НачатьГруппуСтрок(,Ложь);
	
	Для Каждого Строка ИЗ МассивСтрок Цикл
		
		ЦветПоУмолчанию=МассивЦветов[ИндексЦвета];
		
		Для Каждого КлючИЗначение ИЗ СтруктураОбластей Цикл
			
			Если КлючИЗначение.Ключ="ОбластьЗаголовок"
				ИЛИ КлючИЗначение.Ключ="ОбластьИтого"
				ИЛИ КлючИЗначение.Ключ="ОбластьГруппировка" Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Для Каждого Область ИЗ КлючИЗначение.Значение.Области Цикл 
				
				Область.ЦветФона=ЦветПоУмолчанию;
				
			КонецЦикла;					
			
		КонецЦикла;
		
		ИндексЦвета=?(ИндексЦвета=0,1,0);
		
		ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьСчета.Параметры,Строка,,?(ЗначениеЗаполнено(Отчет.ИсходныйДокумент),"Регистратор",""));
		СтруктураОбластей.ОбластьСчета.Параметры.ДанныеДляОтчета=ПолучитьДанныеДляОтчетаОПроводках(Строка);
			
		Если НЕ ПустаяСтрока(Строка.НеТранслируетсяПричина) Тогда
						
			СтруктураОбластей.ОбластьСчета.Параметры.ПричинаДт=ПолучитьПричину(Строка.НеТранслируетсяПричина,"Дт");
			СтруктураОбластей.ОбластьСчета.Параметры.ПричинаКт=ПолучитьПричину(Строка.НеТранслируетсяПричина,"Кт");
			
			Если СтруктураОбластей.ОбластьСчета.Параметры.ПричинаДт=НСтр("ru = 'Исключаемые ВНА'") Тогда
				
				СтруктураОбластей.ОбластьСчета.Параметры.ПричинаКт="";
				
			ИначеЕсли СтруктураОбластей.ОбластьСчета.Параметры.ПричинаКт=НСтр("ru = 'Исключаемые ВНА'") Тогда
				
				СтруктураОбластей.ОбластьСчета.Параметры.ПричинаДт="";
				
			КонецЕсли;			
			
			Если СтрНайти(Строка.НеТранслируетсяПричина,"НетМэппинга")>0 Тогда
								
				ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьСчета);
				
				Продолжить;
				
			КонецЕсли; 
			
		Иначе
			
			СтруктураОбластей.ОбластьСчета.Параметры.ПричинаДт="";
			СтруктураОбластей.ОбластьСчета.Параметры.ПричинаКт="";
			
		КонецЕсли; 
				
		ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьСчета);
		ОтметитьНеТранслируемыеВНА(СтруктураОбластей.ОбластьСубконто,Строка,ЦветПоУмолчанию,"Н");
		
		ЗаполнитьЗначенияСвойств(СтруктураОбластей.ОбластьСубконто.Параметры,Строка);
		ТабДокНесопоставленные.Вывести(СтруктураОбластей.ОбластьСубконто);
				
	КонецЦикла;

	ТабДокНесопоставленные.ЗакончитьГруппуСтрок();
	
КонецПроцедуры // ВывестиГруппировкуНесопоставленные() 

&НаСервере
Процедура ОтметитьНеТранслируемыеВНА(ОбластьСубконто,Строка,ЦветПоУмолчанию,Постфикс="")
	
	ЦветНеТранслируемый=Новый Цвет(255,0,0);
	
	Если СтрНайти(Строка.НеТранслируетсяПричина,"Субконто")=0 Тогда
	
		Если ЕстьОтметкаВНА Тогда 
			
			Для Индекс=1 По 3 Цикл
				
				ОбластьСубконто.Области["СубконтоДтИсточник"+Индекс+Постфикс].ЦветФона=ЦветПоУмолчанию;
				ОбластьСубконто.Области["СубконтоКтИсточник"+Индекс+Постфикс].ЦветФона=ЦветПоУмолчанию;
				
			КонецЦикла;
			
			ЕстьОтметкаВНА=Ложь;
			
		КонецЕсли;
		
	Иначе
			
		Для Индекс=1 По 3 Цикл 
			
			Если СтрНайти(Строка.НеТранслируетсяПричина,"СубконтоДтИсточник"+Индекс)>0 Тогда 	
				ОбластьСубконто.Области["СубконтоДтИсточник"+Индекс+Постфикс].ЦветФона=ЦветНеТранслируемый;
			Иначе
				ОбластьСубконто.Области["СубконтоДтИсточник"+Индекс+Постфикс].ЦветФона=ЦветПоУмолчанию;
			КонецЕсли;
			
			Если СтрНайти(Строка.НеТранслируетсяПричина,"СубконтоКтИсточник"+Индекс)>0 Тогда 	
				ОбластьСубконто.Области["СубконтоКтИсточник"+Индекс+Постфикс].ЦветФона=ЦветНеТранслируемый;
			Иначе
				ОбластьСубконто.Области["СубконтоКтИсточник"+Индекс+Постфикс].ЦветФона=ЦветПоУмолчанию;
			КонецЕсли;
			
		КонецЦикла;
		
		ЕстьОтметкаВНА=Истина;
			
	КонецЕсли;
	
КонецПроцедуры // ОтметитьНеТранслируемыеВНА() 

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	СформироватьОтчетНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТабДокОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка)=Тип("Строка") Тогда
		
		СтандартнаяОбработка=Ложь;
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("ШаблонТрансляции",Отчет.ШаблонКорректировки); 
		СтруктураПараметров.Вставить("СчетИсточникКод",Расшифровка);
		
		ОткрытьФорму("Обработка.УстановкаСоответствияСчетов.Форма",СтруктураПараметров);
		
	ИначеЕсли ТипЗнч(Расшифровка)=Тип("Структура") Тогда
		
		СтандартнаяОбработка=Ложь;
		
		Если Расшифровка.Свойство("ТипЗначения") Тогда
			
			ФормаРасшифровки="ОбщаяФорма.ОтображениеЭлементаWS_Управляемая";
			
			ОткрытьФорму(ФормаРасшифровки, Новый Структура("Расшифровка, ИспользуемаяИБ", Расшифровка,Отчет.ИспользуемаяИБ));
			
		Иначе
			
			СтруктураОтчета=ПодготовитьПараметрыОтчетаОПроводках(Расшифровка);
			ОткрытьФорму("Отчет.ОтчетПоРегиструБухгалтерииБД.Форма",СтруктураОтчета,,Новый УникальныйИдентификатор);
			
		КонецЕсли;
		
	КонецЕсли;
		
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьДанныеСчетаИсточник(СчетИсточникКод)
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СчетаБДВидыСубконто.Ссылка КАК СчетБД,
	             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СчетаБДВидыСубконто.ВидСубконто) КАК КоличествоСубконто
	             |ПОМЕСТИТЬ ВидыСубконтоКоличество
	             |ИЗ
	             |	Справочник.СчетаБД.ВидыСубконто КАК СчетаБДВидыСубконто
	             |ГДЕ
	             |	СчетаБДВидыСубконто.Ссылка.Владелец = &Владелец
	             |	И СчетаБДВидыСубконто.Ссылка.Код = &Код
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	СчетаБДВидыСубконто.Ссылка
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СчетаБД.Ссылка КАК СчетБД,
	             |	ЕСТЬNULL(ВидыСубконтоКоличество.КоличествоСубконто, 0) КАК КоличествоСубконто
	             |ИЗ
	             |	Справочник.СчетаБД КАК СчетаБД
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ВидыСубконтоКоличество КАК ВидыСубконтоКоличество
	             |		ПО СчетаБД.Ссылка = ВидыСубконтоКоличество.СчетБД
	             |ГДЕ
	             |	СчетаБД.Ссылка.Владелец = &Владелец
	             |	И СчетаБД.Код = &Код";
	
	Запрос.УстановитьПараметр("Владелец",Отчет.ПланСчетовИсточник);
	Запрос.УстановитьПараметр("Код",	 СчетИсточникКод);
	
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	Возврат Новый Структура("СчетБД,КоличествоСубконто",Результат.СчетБД,Результат.КоличествоСубконто);
	
КонецФункции // ПолучитьДанныеСчетаИсточник()

&НаСервере
Функция ПодготовитьПараметрыОтчетаОПроводках(Расшифровка)
	
	ПараметрыОтчета=Новый Структура;
	ПараметрыОтчета.Вставить("ВидОтчета","ОтчетПоПроводкам");
	ПараметрыОтчета.Вставить("РегистрБД",		РегистрБухгалтерииИсточник);
	ПараметрыОтчета.Вставить("ПланСчетовБД",	Отчет.ПланСчетовИсточник);
	ПараметрыОтчета.Вставить("ИспользуемаяИБ",	Отчет.ИспользуемаяИБ);
	
	Если ЗначениеЗаполнено(Расшифровка.Период) Тогда 
		
		ПараметрыОтчета.Вставить("ДатаНач",			Расшифровка.Период);
		ПараметрыОтчета.Вставить("ДатаКон",			Расшифровка.Период);
		
	Иначе
		
		ПараметрыОтчета.Вставить("ДатаНач",			Отчет.ДатаНач);
		ПараметрыОтчета.Вставить("ДатаКон",			Отчет.ДатаКон);
		
	КонецЕсли;
	
	ПараметрыОтчета.Вставить("ФормироватьПриОткрытии",Истина); 
	
	ДанныеСчета		=ПолучитьДанныеСчетаИсточник(Расшифровка.СчетДтИсточникКод);
	ДанныеКоррСчета	=ПолучитьДанныеСчетаИсточник(Расшифровка.СчетКтИсточникКод);
	
	ПараметрыОтчета.Вставить("Счет",			ДанныеСчета.СчетБД);
   	ПараметрыОтчета.Вставить("КоррСчет",		ДанныеКоррСчета.СчетБД);
	
	ПараметрыОтчета.Вставить("ПоСубсчетам",Истина);
	ПараметрыОтчета.Вставить("ПоСубсчетамИСубконто",Истина);	
	
	ЭтоВнешняяИБ=ЗначениеЗаполнено(Отчет.ИспользуемаяИБ) И (НЕ Отчет.ИспользуемаяИБ=Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ);
	ОтборПоИзмерениям=Новый Массив;
	
	Если ЭтоВнешняяИБ Тогда
		
		ОтборПоИзмерениям.Добавить(Новый Структура("ПолеБД,ИмяПараметра,ПредставлениеПараметра,Значение,НастройкаСоответствия","Организация","Организация","Организация",Отчет.Организация,УправлениеОтчетамиУХ.ПолучитьНастройкуСоответствияРеквизитов(ТипБД,"Организации","Организации","Справочник")));
		
	Иначе
				
		ОтборПоИзмерениям.Добавить(Новый Структура("ПолеБД,ИмяПараметра,ПредставлениеПараметра,Значение","Организация","Организация","Организация",Отчет.Организация));
		
	КонецЕсли;
	
	ПараметрыОтчета.Вставить("ОтборПоИзмерениям",ОтборПоИзмерениям);
	ПараметрыОтчета.Вставить("МассивДетализация",Новый Массив);
	ПараметрыОтчета.Вставить("ОтборПоСубконто",Новый Массив);
    ПараметрыОтчета.Вставить("МассивПроизводные",Новый Массив);

	
	
	МассивДополнительныйОтбор = Новый Массив; 
	
	Для Индекс=1 По ДанныеСчета.КоличествоСубконто Цикл
		
		СтруктураОтбора=Новый Структура;
		СтруктураОтбора.Вставить("ИмяПараметра","СубконтоДт"+Индекс);
		СтруктураОтбора.Вставить("ПредставлениеПараметра","СубконтоДт"+Индекс);
		СтруктураОтбора.Вставить("СпособВычисленияПараметра",Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение);
		
		Если ТипЗнч(Расшифровка["СубконтоДтИсточник"+Индекс])=Тип("Структура") Тогда
			
			Расшифровка["СубконтоДтИсточник"+Индекс].Вставить("ПредставлениеЗначения",Расшифровка["СубконтоДтИсточник"+Индекс+"Представление"]);
			
		КонецЕсли;
		
		СтруктураОтбора.Вставить("УточнениеСпособаОпределения",Расшифровка["СубконтоДтИсточник"+Индекс]);
		
		МассивДополнительныйОтбор.Добавить(СтруктураОтбора);
		
	КонецЦикла;
	
	Для Индекс=1 По ДанныеКоррСчета.КоличествоСубконто Цикл
		
		СтруктураОтбора=Новый Структура;
		СтруктураОтбора.Вставить("ИмяПараметра","СубконтоКт"+Индекс);
		СтруктураОтбора.Вставить("ПредставлениеПараметра","СубконтоКт"+Индекс);
		СтруктураОтбора.Вставить("СпособВычисленияПараметра",Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение);
		
		Если ТипЗнч(Расшифровка["СубконтоКтИсточник"+Индекс])=Тип("Структура") Тогда
			
			Расшифровка["СубконтоКтИсточник"+Индекс].Вставить("ПредставлениеЗначения",Расшифровка["СубконтоКтИсточник"+Индекс+"Представление"]);
			
		КонецЕсли;
		
		СтруктураОтбора.Вставить("УточнениеСпособаОпределения",Расшифровка["СубконтоКтИсточник"+Индекс]);
		
		МассивДополнительныйОтбор.Добавить(СтруктураОтбора); 
		
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		
		СтруктураОтбора=Новый Структура;
		СтруктураОтбора.Вставить("ИмяПараметра","Регистратор");
		СтруктураОтбора.Вставить("ПредставлениеПараметра","Регистратор");
		СтруктураОтбора.Вставить("ПолеБД","Регистратор");
		СтруктураОтбора.Вставить("СпособВычисленияПараметра",	Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение);
		СтруктураОтбора.Вставить("УточнениеСпособаОпределения",	Отчет.ИсходныйДокумент);
		
		МассивДополнительныйОтбор.Добавить(СтруктураОтбора);
		
	КонецЕсли;
	
	ПараметрыОтчета.Вставить("ПолнаяДетализация",Истина);
	ПараметрыОтчета.Вставить("ТолькоПросмотр",Истина);
    ПараметрыОтчета.Вставить("МассивДополнительныйОтбор",МассивДополнительныйОтбор);
	
	Возврат ПараметрыОтчета;
	
КонецФункции // ПодготовитьПараметрыОтчетаОПроводках() 
	

&НаСервере
Функция ПолучитьРабочийОбъект()
	
	РабочийОбъект=РеквизитФормыВЗначение("Отчет");
	РабочийОбъект.АдресХранилищаПеременныхДляРасчета=РабочийОбъектАдрес;
	РабочийОбъект.ВосстановитьПеременныеДляРасчета();
	
	Возврат РабочийОбъект;
		
КонецФункции // ПолучитьРабочийОбъект()

&НаСервере
Процедура ПоместитьРабочийОбъект(РабочийОбъект)
	
	РабочийОбъектАдрес=ПоместитьВоВременноеХранилище(РабочийОбъект.ПодготовитьСтруктуруПеременныхДляРасчета(),ЭтаФорма.УникальныйИдентификатор);
	ЗначениеВРеквизитФормы(РабочийОбъект,"Отчет");
				
КонецПроцедуры // ПолучитьРабочийОбъект()

&НаСервере
Процедура ОбновитьДанныеПоСубконто()
	
	Если ЗначениеЗаполнено(Отчет.СчетДтИсточник) Тогда
		ИзменитьСчет();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчет.СчетКтИсточник) Тогда
		ИзменитьКоррСчет();
	КонецЕсли;
			
КонецПроцедуры // ОбновитьДанныеПоСубконто()

&НаСервере
Процедура ИзменитьСчет()
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.мТаблицаПоказателейБД=РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ПриИзмененииСчета(Истина,ОтчетОбъект);
		
КонецПроцедуры // ИзменитьРеквизитБухгалтерии()

&НаСервере
Процедура ПриИзмененииСчета(Дебетовый,ОтчетОбъект)
	
	ОтчетОбъект.УдалитьАналитикуПоСчету(Дебетовый);		
	ОтчетОбъект.ЗаполнитьАналитикуСчетаБД(Дебетовый);
	ОтчетОбъект.ЗаполнитьДеревоПоРегиструБухгалтерии();
	
	ЗначениеВРеквизитФормы(ОтчетОбъект.мТаблицаПоказателейБД,"мТаблицаПоказателейБД");
	мТаблицаПроизводныхБД.Очистить();
	
	ЗначениеВРеквизитФормы(ОтчетОбъект.ТабличноеПолеИзмеренийБД,"ТабличноеПолеИзмеренийБД");
	
	Отчет.ТабПравилаВычисленияПараметров.Очистить();
	
	Элементы.ГруппаОтбор.Видимость=ЗначениеЗаполнено(Отчет.СчетДтИсточник) ИЛИ ЗначениеЗаполнено(Отчет.СчетКтИсточник);
	
	СформироватьЗаголовокНастройки();
	
КонецПроцедуры // ПриИзмененииСчета

&НаСервере
Процедура ИзменитьКоррСчет()
	
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.мТаблицаПоказателейБД=РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ПриИзмененииСчета(Ложь,ОтчетОбъект);

КонецПроцедуры // ИзменитьРеквизитБухгалтерии()

&НаКлиенте
Процедура СчетДтИсточникПриИзменении(Элемент)
	
	ИзменитьСчет();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетКтИсточникПриИзменении(Элемент)
	
	ИзменитьКоррСчет();
	
КонецПроцедуры   

&НаСервере
Процедура ОбновитьТаблицыФормыПоОбъекту()

    ОтчетОбъект=ПолучитьРабочийОбъект();

	ЗначениеВРеквизитФормы(ОтчетОбъект.мТаблицаПоказателейБД,"мТаблицаПоказателейБД");
	ЗначениеВРеквизитФормы(ОтчетОбъект.мТаблицаПроизводныхБД,"мТаблицаПроизводныхБД");	
	ЗначениеВРеквизитФормы(ОтчетОбъект.ТабличноеПолеИзмеренийБД,"ТабличноеПолеИзмеренийБД");

КонецПроцедуры // ОбновитьОтчетОбъект() 

&НаСервере
Процедура ОбновитьОбъектПоТаблицамФормы()

    ОтчетОбъект=ПолучитьРабочийОбъект();

	ОтчетОбъект.мТаблицаПоказателейБД		= РеквизитФормыВЗначение("мТаблицаПоказателейБД");
	ОтчетОбъект.мТаблицаПроизводныхБД		= РеквизитФормыВЗначение("мТаблицаПроизводныхБД");
	ОтчетОбъект.ТабличноеПолеИзмеренийБД 	= РеквизитФормыВЗначение("ТабличноеПолеИзмеренийБД");

	ПоместитьРабочийОбъект(ОтчетОбъект);
			
КонецПроцедуры // ОбновитьОтчетОбъект()

&НаКлиенте
Процедура ТабПравилаВычисленияПараметровПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ=Истина;
	
	ОбновитьОбъектПоТаблицамФормы();	
	ОткрытьФорму("Отчет.АнализТрансляцииПроводок.Форма.ФормаВыбораПолей",Новый Структура("РабочийОбъектАдрес,ТекстОповещения",РабочийОбъектАдрес,"ВыбраноПолеСубконтоОтбора"),,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия="ВыбраноПолеСубконтоОтбора" Тогда
		
		РабочийОбъектАдрес=Параметр.РабочийОбъектАдрес;
		
		ОбновитьТаблицыФормыПоОбъекту();
		
		ДанныеСтроки=Параметр.ДанныеСтроки;
		
		НоваяСтрока=Отчет.ТабПравилаВычисленияПараметров.Добавить();
		НоваяСтрока.ПолеБД=ДанныеСтроки.ПолеБД;
		НоваяСтрока.ПредставлениеПараметра=ДанныеСтроки.НаименованиеБД;
		НоваяСтрока.СпособВычисленияПараметра=ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеИспользуется");
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ДанныеСтроки);
		
		НоваяСтрока.ПолеБД=НоваяСтрока.ПолеБД;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПравилаВычисленияПараметровПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ПолеБД=Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ПолеБД;

	
КонецПроцедуры

&НаКлиенте
Процедура СпособВычисленияПараметраПриИзменении(Элемент)
	
	СтрПоле=Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные;
	
	Если СтрПоле.ТипЗначения.Количество()>0 Тогда
		
		ДанныеОбъекта=СформироватьДанныеОбъекта();
		ДанныеОбъекта.Вставить("ИмяПараметра",				СтрПоле.ПолеБД);
		ДанныеОбъекта.Вставить("ПолеБД",					СтрПоле.ПолеБД);
		ДанныеОбъекта.Вставить("ТипДанныхПоля",				СтрПоле.ТипДанныхПоля);
		ДанныеОбъекта.Вставить("ТипЗначения",				СтрПоле.ТипЗначения);
		ДанныеОбъекта.Вставить("СпособВычисленияПараметра",	Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.СпособВычисленияПараметра);
		
		ДанныеДляОграничения=ПолучитьДанныеДляОграниченияТипа(ДанныеОбъекта);
		
		Для Каждого СтрОграничение ИЗ ДанныеДляОграничения Цикл
			
			УстановитьОграничениеТипа(СтрОграничение);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Функция НайтиСтрокуДанныхВИБПоПолю(ПолеБД)
	
	Если СтрНайти(ПолеБД,".")>0 Тогда
		
		МассивПоказателейВИБ=мТаблицаПроизводныхБД.НайтиСтроки(Новый Структура("ПолеБД",ПолеБД));
		
	Иначе
	    
		МассивПоказателейВИБ=мТаблицаПоказателейБД.НайтиСтроки(Новый Структура("ПолеБД",ПолеБД));
		
	КонецЕсли;
	
	Если МассивПоказателейВИБ.Количество()=0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат МассивПоказателейВИБ[0];
	КонецЕсли;
	
КонецФункции // НайтиСтрокуДанныхВИБПоПолю()

&НаКлиенте
Процедура СпособВычисленияПараметраНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
		
	СтрокаПараметр=НайтиСтрокуДанныхВИБПоПолю(Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ПолеБД);
	СписокВыбора=Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы.СпособВычисленияПараметра.СписокВыбора;
	СписокВыбора.Очистить();
	
	ТекСписокВыбора=ПолучитьСписокСпособовВычисления(СтрокаПараметр.ТипМетаДанных);
	
	Для Каждого Строка ИЗ ТекСписокВыбора Цикл
		
		СписокВыбора.Добавить(Строка.Значение,Строка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СпособВычисленияПараметраНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	СтрокаПараметр=НайтиСтрокуДанныхВИБПоПолю(Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные.ПолеБД);
	СписокВыбора=Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы.СпособВычисленияПараметра.СписокВыбора;
	СписокВыбора.Очистить();
	
	ТекСписокВыбора=ПолучитьСписокСпособовВычисления(СтрокаПараметр.ТипМетаДанных);
	
	Для Каждого Строка ИЗ ТекСписокВыбора Цикл
		
		СписокВыбора.Добавить(Строка.Значение,Строка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ПолучитьСписокСпособовВычисления(ТипМетаДанных)

	СписокВыбора=Новый СписокЗначений;
	
	Если ТипМетаДанных="Простой" Тогда
		
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, Нстр("ru = 'Фиксированное значение'; en = 'Fixed value';tr = 'Sabit değer'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению, Нстр("ru = 'Не равно фиксированному значению'; en = 'Not equal to a fixed value';tr = 'Sabit bir değere eşit değil'"));																								   
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Нстр("ru = 'Список фиксированных значений'; en = 'Fixed value list';tr = 'Sabit değer listesi'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений, Нстр("ru = 'Не в списке фиксированных значений'; en = 'Not in the fixed value list';tr = 'Sabit değer listesinde değil'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется, Нстр("ru = 'Отбор не производится'; en = 'Not filtered';tr = 'Filtrelenmemiş'"));
		
	Иначе
		
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, Нстр("ru = 'Фиксированное значение'; en = 'Fixed value';tr = 'Sabit değer'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению, Нстр("ru = 'Не равно фиксированному значению'; en = 'Not equal to a fixed value';tr = 'Sabit bir değere eşit değil'"));																								   
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Нстр("ru = 'Список фиксированных значений'; en = 'Fixed value list';tr = 'Sabit değer listesi'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.СписокПоИерархии, Нстр("ru = 'Список с учетом иерархии'; en = 'List considering hierarchy';tr = 'Hiyerarşiyi dikkate alan liste'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений, Нстр("ru = 'Не в списке фиксированных значений'; en = 'Not in the fixed value list';tr = 'Sabit değer listesinde değil'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии, Нстр("ru = 'Не в списке с учетом иерархии'; en = 'Not in the list considering hierarchy';tr = 'Hiyerarşi dikkate alınan listede yok'"));
		СписокВыбора.Добавить(Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется, Нстр("ru = 'Отбор не производится'; en = 'Not filtered';tr = 'Filtrelenmemiş'"));
		
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции // ПолучитьСписокСпособовВычисления()

&НаКлиенте
Процедура УстановитьОграничениеТипа(ДанныеДляОграничения)
	
	Если Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы.Найти(ДанныеДляОграничения.ИмяКолонки)=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЭлементУправления = Элементы.ТабПравилаВычисленияПараметров.ПодчиненныеЭлементы[ДанныеДляОграничения.ИмяКолонки];
	
	Если ДанныеДляОграничения.Свойство("ТипЗначения") Тогда
		
		Если НЕ ТипЗнч(ДанныеДляОграничения.ТипЗначения)=Тип("Массив") Тогда
			
			Массив = Новый Массив;
			Массив.Добавить(ДанныеДляОграничения.ТипЗначения);
			
		Иначе
			
			Массив=ДанныеДляОграничения.ТипЗначения;
			
		КонецЕсли;
		
		ЭлементУправления.Доступность = Истина;
		ЭлементУправления.ОграничениеТипа = Новый ОписаниеТипов(Массив);
		
		Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные[ДанныеДляОграничения.ИмяКолонки] = ЭлементУправления.ОграничениеТипа.ПривестиЗначение();
		
		Если ДанныеДляОграничения.Свойство("ТипДанныхСписка") Тогда
			
			Массив = Новый Массив;
			Массив.Добавить(ДанныеДляОграничения.ТипДанныхСписка);
			
			Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные[ДанныеДляОграничения.ИмяКолонки].ТипЗначения=Новый ОписаниеТипов(Массив);

						
		КонецЕсли;
		
	Иначе
		
		Элементы.ТабПравилаВычисленияПараметров.ТекущиеДанные[ДанныеДляОграничения.ИмяКолонки]=Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьОграничениеТипа() 

