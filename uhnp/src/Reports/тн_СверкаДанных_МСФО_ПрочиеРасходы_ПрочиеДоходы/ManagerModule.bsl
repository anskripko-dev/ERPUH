// Для подсистемы "Варианты отчетов" при работе в модели сервиса.
// 
// Возвращаемое значение:
//  Массив - Варианты настроек
//
Функция ВариантыНастроек() Экспорт
	
	Результат = Новый Массив;
	
	Вариант = Новый Структура;
	Вариант.Вставить("Имя",           "Основной");
	Вариант.Вставить("Представление", "Сверка данных МСФО РН Прочие расходы РН Прочие доходы");
	Результат.Добавить(Вариант);
	
	Возврат Результат;
	
КонецФункции

