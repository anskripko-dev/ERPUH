
#Область ПеременныеФормы

&НаКлиенте
Перем мФормаФормированияЛинейногоМаршрута;

&НаКлиенте
Перем ПредупреждениеЗапущенногоПроцессаВыведено;

#КонецОбласти


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ШаблонПроцесса", Отчет.ШаблонПроцесса);
	
	НазначениеПроцесса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет.ШаблонПроцесса, "НазначениеПроцесса");
	
	СформироватьОтчетНаСервере();
	
	Элементы.ВидыЭтаповПроцесса.Видимость = Ложь;

	Если НазначениеПроцесса = Перечисления.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности Тогда
		Элементы.ОтобразитьПанельЭтапов.Видимость = Ложь;
		Элементы.ОтобразитьПанельЭтапов.Пометка = Истина;
	Иначе
		Элементы.ОтобразитьПанельЭтапов.Пометка = Ложь;
	КонецЕсли;
	
	ЗаполнитьСписокВозможныхЭтапов();
	ДобавитьЭтапыВМенюВыбора();

	УправлениеДоступность();
	
	ОтобразитьКоличествоЗапущенныхПроцессов();
	
	СтрокаШаблона = Нстр("ru = 'Редактирование этапов процесса: %1'");
	
	СтрокаЗаголовка = "";
	Если Не ПустаяСтрока(СтрокаШаблона) тогда
		СтрокаЗаголовка = СтрШаблон(СтрокаШаблона, Отчет.ШаблонПроцесса);
	Иначе
		СтрокаЗаголовка = Отчет.ШаблонПроцесса;
	КонецЕсли;

	Заголовок = СтрокаЗаголовка;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПредупреждениеЗапущенногоПроцессаВыведено = Ложь;
	ПредупредитьОбИзмененииЗапущенногоПроцесса(Отчет.ШаблонПроцесса);
	
	УстановитьВидимостьПанелиЭтапов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если Настройки["Отчет.ВключенРежимПроверки"] <> Неопределено Тогда
		ВключенРежимПроверки = Настройки["Отчет.ВключенРежимПроверки"];
	Иначе
		Отчет.ВключенРежимПроверки = Ложь;
		ВключенРежимПроверки = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьПанелиПроверки(ВключенРежимПроверки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ФормаЗакрыта" И Источник = мФормаФормированияЛинейногоМаршрута Тогда
		мФормаФормированияЛинейногоМаршрута = Неопределено;
	ИначеЕсли ИмяСобытия = "ОбновитьОтчет" И Источник = Отчет.ШаблонПроцесса Тогда
		СформироватьОтчетНаСервере();
		ЗаполнитьСписокВозможныхЭтапов();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ВспомогательныеПроцедурыФункции

#Область КомандыПанелиМаршрута

&НаКлиенте
Процедура ОткрытьСвойстваПроцесса(Команда)
	
	ПредупредитьОбИзмененииЗапущенногоПроцесса(Отчет.ШаблонПроцесса);
	ПараметрыОткрытия = Новый Структура("Ключ", Отчет.ШаблонПроцесса);
		
	ОткрытьФорму("Справочник.ШаблоныУниверсальныхПроцессов.Форма.ФормаЭлемента", 
		ПараметрыОткрытия, , , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере(ОчиститьПолеНачальныхНастроек = Ложь)
	
	ПолеТабличногоДокумента.Очистить();
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Если ОчиститьПолеНачальныхНастроек Тогда
		ОтчетОбъект.ТабличноеПолеНачальныхНастроек.Очистить();
	КонецЕсли;
	
	РезультатРасчета = ОтчетОбъект.Сформировать(АдресТаблицыЭтапов, УникальныйИдентификатор, ВыбранныйЭтапПроцесса);
	МакетОтчета = Отчеты.СетеваяДиаграммаШаблонаУниверсальногоПроцесса.ПолучитьМакет("Макет");
	ОбластьЗаголовок = МакетОтчета.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.ШаблонПроцесса = Отчет.ШаблонПроцесса;
	ПолеТабличногоДокумента.Вывести(ОбластьЗаголовок);
	ПолеТабличногоДокумента.Вывести(РезультатРасчета);
	ЗначениеВРеквизитФормы(ОтчетОбъект, "Отчет");
	
	ОтобразитьКоличествоЗапущенныхПроцессов();
	Если НазначениеПроцесса = Перечисления.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности Тогда
		ОтобразитьКоличествоДокументов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЭтап(Команда)
		
	СоздатьИОтобразитьЭтап(ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов." + СтрЗаменить(Команда.Имя, "ДобавитьЭтап_", "")));
	
КонецПроцедуры

#Область РедактированиеЭтапов

&НаКлиенте
Процедура Редактировать(Команда)
	
	ОбработкаЭтапа(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура Скопировать(Команда)
	
	ОбработкаЭтапа(Команда.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдаление(Команда)
	
	ОбработкаЭтапа(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЭтапа(ИмяКоманды)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", Неопределено);
	ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКоманды);
	
	ВыделенныеОбласти = Элементы.ПолеТабличногоДокумента.ПолучитьВыделенныеОбласти();
	Если ВыделенныеОбласти.Количество() > 0 Тогда
		ДополнительныеПараметры.Этап = ВернутьВыбранныйЭтап(ВыделенныеОбласти[0]);
	КонецЕсли;
	
	Если ДополнительныеПараметры.Этап = Неопределено Тогда
		ТекстЗаголовка = НСтр("ru = 'Выберите этап'");
		ПоказатьФормуВыбораЭтапа(ТекстЗаголовка, "ОбработкаЭтапаВыборЭтапа", ДополнительныеПараметры);
	Иначе
		ОбработкаЭтапаЗавершение(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЭтапаВыборЭтапа(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		
		ДополнительныеПараметры.Этап = РезультатЗакрытия;
		ОбработкаЭтапаЗавершение(ДополнительныеПараметры);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЭтапаЗавершение(ДополнительныеПараметры)
	
	ИмяКоманды = ДополнительныеПараметры.ИмяКоманды;
	Этап = ДополнительныеПараметры.Этап;
	
	Если ИмяКоманды = "Редактировать" Тогда
		ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.ФормаОбъекта", Новый Структура("Ключ", Этап));
	ИначеЕсли ИмяКоманды = "Скопировать" Тогда
		ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.ФормаОбъекта", Новый Структура("ЗначениеКопирования, ЗначениеЗаполнения", Этап, Новый Структура("Владелец", Отчет.ШаблонПроцесса)));
	ИначеЕсли ИмяКоманды = "ПометитьНаУдаление" Тогда
		
		ТекстВопроса = НСтр("ru = 'Действительно пометить на удаление этап: %Этап%?'");
		ТекстВопроса = СтрЗаменить(ТекстВопроса, "%Этап%", Строка(Этап));
		Режим = РежимДиалогаВопрос.ДаНет;

		Оповещение = Новый ОписаниеОповещения("ПодтверждениеУдалениеЭтапа", ЭтаФорма, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеУдалениеЭтапа(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПометитьНаУдалениеЭтап(Параметры.Этап);
		ПредупредитьОбИзмененииЗапущенногоПроцесса(Отчет.ШаблонПроцесса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПометитьНаУдалениеЭтап(Этап)
	
	ЭтапОбъект = Этап.ПолучитьОбъект();
	ЭтапОбъект.УстановитьПометкуУдаления(НЕ ЭтапОбъект.ПометкаУдаления);
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СвязиЭтапов

&НаКлиенте
Процедура ДобавитьСвязь(Команда)
	
	ОбработкаСвязи(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСвязь(Команда)
	
	ОбработкаСвязи(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСвязи(ИмяКоманды)
	
	МассивЭтапов = Новый Массив;
	
	ВыделенныеОбласти = Элементы.ПолеТабличногоДокумента.ПолучитьВыделенныеОбласти();
	Для Каждого ВыделеннаяОбласть Из ВыделенныеОбласти Цикл
		
		Этап = ВернутьВыбранныйЭтап(ВыделеннаяОбласть);
		Если Этап <> неопределено Тогда
			МассивЭтапов.Добавить(Этап);
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивЭтапов", МассивЭтапов);
	ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКоманды);
	
	Если МассивЭтапов.Количество() = 0 Тогда

		// Сначала выберем начальный этап
		ТекстЗаголовка = НСтр("ru = 'Выберите начальный этап связи'");
		ПоказатьФормуВыбораЭтапа(ТекстЗаголовка, "ДобавитьСвязьВыборЭтапа", ДополнительныеПараметры);
		
	Иначе
		ОбработкаСвязиЗавершение(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСвязьВыборЭтапа(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
	
		ДополнительныеПараметры.МассивЭтапов.Добавить(РезультатЗакрытия);
		
		// Теперь выберем конечный этап
		ТекстЗаголовка = НСтр("ru = 'Выберите конечный этап связи'");
		ПоказатьФормуВыбораЭтапа(ТекстЗаголовка, "ДобавитьСвязьВыборЭтапаЗавершение", ДополнительныеПараметры);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСвязьВыборЭтапаЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
	
		ДополнительныеПараметры.МассивЭтапов.Вставить(0, РезультатЗакрытия);
		
		ОбработкаСвязиЗавершение(ДополнительныеПараметры);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСвязиЗавершение(ДополнительныеПараметры) Экспорт

	Если ДополнительныеПараметры.МассивЭтапов.Количество() <> 2 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Для выполнения команды необходимо выбрать два этапа!'"));
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ИмяКоманды = "ДобавитьСвязь" Тогда
		ДобавитьСвязьСервер(ДополнительныеПараметры.МассивЭтапов);
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "УдалитьСвязь" Тогда
		УдалитьСвязьСервер(ДополнительныеПараметры.МассивЭтапов);
	КонецЕсли;
	
	ПредупредитьОбИзмененииЗапущенногоПроцесса(Отчет.ШаблонПроцесса);
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСвязьСервер(МассивДанных)
	
	ЭтапПредшественник = МассивДанных[1].ПолучитьОбъект();
	ЭтапПоследователь =  МассивДанных[0].ПолучитьОбъект();
	
	Если ЭтапПредшественник.ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход ИЛИ ЭтапПредшественник.ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.ЦиклПока Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Для данного этапа связь с последователем задается условием!'"));
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЭтапПредшественник.УсловияСогласования.Получить()) = Тип("ДеревоЗначений") Тогда
		ТабличноеПолеПерехода = ЭтапПредшественник.УсловияСогласования.Получить();
	Иначе
		ТабличноеПолеПерехода = Новый ДеревоЗначений;
		ТабличноеПолеПерехода.Колонки.Добавить("ОтображениеДействия",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,0));
		ТабличноеПолеПерехода.Колонки.Добавить("УсловиеДействие");
		ТабличноеПолеПерехода.Колонки.Добавить("Значение");
		ТабличноеПолеПерехода.Колонки.Добавить("ЗначениеОтбора");
		ТабличноеПолеПерехода.Колонки.Добавить("ОбработкаУсловия",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,0));
		ТабличноеПолеПерехода.Колонки.Добавить("ЯвляетсяУсловием",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,0));
	КонецЕсли;
	
	// Проверим существование такой связи и добавим, если она уникальна.
	СвязьСуществует = СуществуетСвязьПерейтиКЭтапу(ТабличноеПолеПерехода.Строки, ЭтапПоследователь.Ссылка);
	Если НЕ СвязьСуществует Тогда
		НСтр = ТабличноеПолеПерехода.Строки.Добавить();
		НСтр.Значение = ЭтапПоследователь.Ссылка;
		НСтр.ЗначениеОтбора = Неопределено;
		НСтр.ОбработкаУсловия = 0;
		НСтр.ОтображениеДействия = 1;
		НСтр.УсловиеДействие = Перечисления.ДействияЭтапа.ПерейтиКЭтапу;
		НСтр.ЯвляетсяУсловием = 0;
		
		ЭтапПредшественник.УсловияСогласования= Новый ХранилищеЗначения(ТабличноеПолеПерехода);
		ЭтапПредшественник.Записать();
		
		НЭ = ЭтапПоследователь.ЭтапыПредшественники.Добавить();	
		НЭ.Этап =  ЭтапПредшественник.Ссылка;
		ЭтапПоследователь.Записать();
	Иначе
		ТекстСообщения = НСтр("ru = 'Связь между этапами %ЭтапПредшественник% и %ЭтапПоследователь% уже существует. Операция отменена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЭтапПредшественник%", Строка(ЭтапПредшественник));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЭтапПоследователь%", Строка(ЭтапПоследователь));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

// Определяет наличие в строка дерева перехода СтрокиВход наличие
// перехода к этапу ЭтапВход.
&НаСервереБезКонтекста
Функция СуществуетСвязьПерейтиКЭтапу(СтрокиВход, ЭтапВход)
	
	РезультатФункции = Ложь;
	
	Если СтрокиВход.Количество() = 0 Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Значение",			 ЭтапВход);
	СтруктураОтбора.Вставить("ЗначениеОтбора",		 Неопределено);
	СтруктураОтбора.Вставить("ОбработкаУсловия",	 0);
	СтруктураОтбора.Вставить("ОтображениеДействия",	 1);
	СтруктураОтбора.Вставить("УсловиеДействие",		 Перечисления.ДействияЭтапа.ПерейтиКЭтапу);
	СтруктураОтбора.Вставить("ЯвляетсяУсловием",	 0); 
	
	НайденныеСтроки = СтрокиВход.НайтиСтроки(СтруктураОтбора);
	РезультатФункции = (НайденныеСтроки.Количество() <> 0);
	
	Возврат РезультатФункции;
	
КонецФункции		// СуществуетСвязьПерейтиКЭтапу()

&НаСервереБезКонтекста
Процедура УдалитьСвязьСервер(МассивДанных)

	// Получим данные этапов
	ЭтапПредшественник = МассивДанных[1];
	ЭтапПоследователь =  МассивДанных[0];
	
	// Удалим прямую связь
	УдалитьСвязьМеждуЭтапами(ЭтапПредшественник, ЭтапПоследователь);
	
	// Удалим связь в обратную сторону
	Если ЭтапПоследователь.ТипЭтапа <> Перечисления.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход Тогда
		УдалитьСвязьМеждуЭтапами(ЭтапПоследователь, ЭтапПредшественник);
	КонецЕсли;
	
КонецПроцедуры

// Удаляет связь от этапа ЭтапПредшественникВход к этапу ЭтапПоследовательВход.
&НаСервереБезКонтекста
Процедура УдалитьСвязьМеждуЭтапами(ЭтапПредшественникВход, ЭтапПоследовательВход)
	
	Попытка
		
		ЭтапПредшественник = ЭтапПредшественникВход.ПолучитьОбъект();
		ЭтапПоследователь = ЭтапПоследовательВход.ПолучитьОбъект();
		
		Если ЭтапПредшественник.ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход Тогда
			ТекстСообщения = НСтр("ru = 'Этап-предшественник (%ЭтапПредшественник%) не должен быть условным переходом. Для удаления связи отредактируйте условия перехода.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЭтапПредшественник%", Строка(ЭтапПредшественник));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Иначе
			
			СвязьНайдена = Ложь;
			
			ТабличноеПолеПерехода = ЭтапПредшественник.УсловияСогласования.Получить();
			Если ТабличноеПолеПерехода <> Неопределено Тогда
				Для Каждого Переход Из ТабличноеПолеПерехода.Строки Цикл
					Если Переход.Значение =  ЭтапПоследователь.Ссылка Тогда
						ТабличноеПолеПерехода.Строки.Удалить(Переход);
						СвязьНайдена = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если Не СвязьНайдена Тогда
				Возврат;
			КонецЕсли;
			
			ЭтапПредшественник.УсловияСогласования = Новый ХранилищеЗначения(ТабличноеПолеПерехода);
			ЭтапПредшественник.Записать();
			
			ЭтапыПоследователи = ЭтапПоследователь.ЭтапыПредшественники;
			Для Каждого ЭП Из ЭтапыПоследователи Цикл
				Если ЭП.Этап = ЭтапПредшественник.Ссылка Тогда
					ЭтапыПоследователи.Удалить(ЭП);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ЭтапПоследователь.Записать();
			
		КонецЕсли;
		
	Исключение
		
		ТекстСообщения = НСтр("ru = 'Не удалось удалить связь между %ЭтапПредшественник% и %ЭтапПоследователь% : %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЭтапПредшественник%", Строка(ЭтапПредшественникВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЭтапПоследователь%", Строка(ЭтапПоследовательВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры
	
#КонецОбласти

&НаКлиенте
Процедура ПроверитьМаршрут(Команда)
	
	Отчет.ВключенРежимПроверки = Не Отчет.ВключенРежимПроверки;
	УстановитьВидимостьПанелиПроверки();
	
КонецПроцедуры

