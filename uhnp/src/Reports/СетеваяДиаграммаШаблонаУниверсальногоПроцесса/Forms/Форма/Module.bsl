&НаКлиенте
Процедура ПолеТабличногоДокументаВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Перем АдресДеревоОтборов, АдресТабличноеПолеПереходов, АдресКэшВидовСубконто, АдресТаблицаДоступныхПараметров, ОбычныйЭтап;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("АдресДеревоОтборов",                   АдресДеревоОтборов);
	ПараметрыОткрытияФормы.Вставить("АдресТабличноеПолеПереходов",          АдресТабличноеПолеПереходов); 
	ПараметрыОткрытияФормы.Вставить("АдресКэшВидовСубконто",                АдресКэшВидовСубконто); 
	ПараметрыОткрытияФормы.Вставить("ОбычныйЭтап",                          ОбычныйЭтап);
	ПараметрыОткрытияФормы.Вставить("СписокВыбораУсловий",                  Новый СписокЗначений); 
	ПараметрыОткрытияФормы.Вставить("СписокВыбораДействий",                 Новый СписокЗначений); 
	ПараметрыОткрытияФормы.Вставить("ШаблонПроцесса",                       Неопределено);
	ПараметрыОткрытияФормы.Вставить("ТипЭтапа",                             Неопределено);
	ПараметрыОткрытияФормы.Вставить("АдресТаблицаДоступныхПараметров",      Неопределено);
	ПараметрыОткрытияФормы.Вставить("ЗаписыватьЭтапУниверсальногоПроцесса", Ложь);
	
	Этап = ВернутьВыбранныйЭтап(Область);
	Если Этап <> Неопределено Тогда
		Если Не ЭтоУсловныйПереход(Этап, ПараметрыОткрытияФормы) Тогда
			ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.ФормаОбъекта", Новый Структура("Ключ", Этап));
		Иначе
			ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.Форма.ФормаНастройкиУсловногоПерехода", ПараметрыОткрытияФормы, ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияУсловийСогласования(Этап, ПараметрыОткрытияФормы)
		
	СохраненныеУсловия = Этап.УсловияСогласования.Получить();
	// Проверим наличие необходимых колонок в дереве.
	Если ТипЗнч(СохраненныеУсловия) = Тип("ДеревоЗначений") Тогда
		Если СохраненныеУсловия.Колонки.Найти("ИмяТипа") = Неопределено Тогда
			СохраненныеУсловия.Колонки.Добавить("ИмяТипа");
		Иначе
			// Колонка ИмяТипа уже присутствует.
		КонецЕсли;
		Если СохраненныеУсловия.Колонки.Найти("ИдентификаторПерехода") = Неопределено Тогда
			СохраненныеУсловия.Колонки.Добавить("ИдентификаторПерехода");
		Иначе
			// Колонка ИдентификаторПерехода уже присутствует.
		КонецЕсли;
		Если СохраненныеУсловия.Колонки.Найти("ИсточникСсылка") = Неопределено Тогда
			СохраненныеУсловия.Колонки.Добавить("ИсточникСсылка");
		Иначе
			// Колонка ИдентификаторПерехода уже присутствует.
		КонецЕсли;
		Если СохраненныеУсловия.Колонки.Найти("Значение") = Неопределено Тогда
			СохраненныеУсловия.Колонки.Добавить("Значение");
		Иначе
			// Колонка ИдентификаторПерехода уже присутствует.
		КонецЕсли;
	Иначе
		// Не требуется проверка.
	КонецЕсли;
	// Считаем дерево.
	Если СохраненныеУсловия <> Неопределено Тогда
		
		ПараметрыОткрытияФормы.Вставить("АдресТабличноеПолеПереходов",
			ПоместитьВоВременноеХранилище(СохраненныеУсловия, УникальныйИдентификатор));
		
	КонецЕсли;
		
	ПараметрыОткрытияФормы.Вставить("ОбычныйЭтап", Ложь);
	СписокВыбораДействий = Новый СписокЗначений;
	СписокВыбораДействий.Добавить(Перечисления.ДействияЭтапа.ПерейтиКЭтапу);
	ПараметрыОткрытияФормы.Вставить("СписокВыбораДействий",  СписокВыбораДействий);
	ПараметрыОткрытияФормы.Вставить("ШаблонПроцесса",             Этап.Владелец);
	ПараметрыОткрытияФормы.Вставить("ТипЭтапа",                   Этап.ТипЭтапа);
	ПараметрыОткрытияФормы.Вставить("ЭтапУниверсальногоПроцесса", Этап);
	ПараметрыОткрытияФормы.Вставить("ЗаписыватьЭтапУниверсальногоПроцесса", Истина);
	ПараметрыОткрытияФормы.Вставить("АдресТаблицаДоступныхПараметров",
		ПоместитьВоВременноеХранилище(Этап.ЗначенияПараметров.Выгрузить(), УникальныйИдентификатор));
	
КонецПроцедуры

&НаСервере
Функция ЭтоУсловныйПереход(Этап, ПараметрыОткрытияФормы)
	
	ТипЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Этап, "ТипЭтапа");
	
	Если ТипЭтапа <> Перечисления.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход Тогда
		Возврат Ложь;
	Иначе
		ИнициализацияУсловийСогласования(Этап, ПараметрыОткрытияФормы);
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ШаблонПроцессаПриИзменении(Элемент)
	
	СформироватьОтчетНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеНачальныхНастроекЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТД = Элементы.ТабличноеПолеНачальныхНастроек.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТД.Значение) <> Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ") Тогда
		СтандартнаяОбработка = Истина;
	Иначе
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Справочник.ПроизвольныйКлассификаторУХ.ФормаВыбора", Новый Структура("Отбор", Новый Структура("Владелец", ТД.Условие)), Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаМаршрута(Команда)
	
	ОтобразитьХодМаршрутаПоВыбраннымУсловиям();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыбранныйЭтап(Команда)
	
	ВыделенныеОбласти = ТабличноеПолеВозможныхЭтапов.ВыделенныеОбласти;
	Если ВыделенныеОбласти.Количество() > 0 Тогда
		ПерваяОбласть = ВыделенныеОбласти[0];
		ИмяОбласти = ПерваяОбласть.Имя;
		НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ПустаяСсылка");
		Если СокрЛП(ИмяОбласти) = "ЭтапСогласования" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЭтапСогласования");
		ИначеЕсли СокрЛП(ИмяОбласти) = "ЭтапПроцессаПодготовкиОтчетности" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЭтапПроцессаПодготовкиОтчетности");
		ИначеЕсли СокрЛП(ИмяОбласти) = "УсловныйПереход" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход");
		ИначеЕсли СокрЛП(ИмяОбласти) = "Автоутверждение" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.Автоутверждение");
		ИначеЕсли СокрЛП(ИмяОбласти) = "Автоотклонение" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.Автоотклонение");
		ИначеЕсли СокрЛП(ИмяОбласти) = "ДочернийМаршрут" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ДочернийМаршрут");
		ИначеЕсли СокрЛП(ИмяОбласти) = "ОбработкаУниверсальногоПроцесса" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ОбработкаУниверсальногоПроцесса");
		ИначеЕсли СокрЛП(ИмяОбласти) = "Оповещение" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.Оповещение");
		ИначеЕсли СокрЛП(ИмяОбласти) = "ЦиклПока" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЦиклПока");
		ИначеЕсли СокрЛП(ИмяОбласти) = "ЭтапУниверсальногоИмпорта" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЭтапУниверсальногоИмпорта");
		ИначеЕсли СокрЛП(ИмяОбласти) = "ЭтапУниверсальногоЭкспорта" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЭтапУниверсальногоЭкспорта");
		ИначеЕсли СокрЛП(ИмяОбласти) = "Пауза" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.Пауза");
		ИначеЕсли СокрЛП(ИмяОбласти) = "РучнойПереход" Тогда
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.РучнойПереход");
		Иначе
			НовыйТипЭтапа = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.ПустаяСсылка");
		КонецЕсли;
		СоздатьИОтобразитьЭтап(НовыйТипЭтапа);
	Иначе
		ТекстСообщения = НСтр("ru = 'Не выбран тип нового этапа. Создание отменено.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВозможныхЭтапов()
	
	ТаблицаВозможныхЭтапов.Очистить();
	ТабличноеПолеВозможныхЭтапов.Очистить();
	Лево = 5;
	Верх = 2;
	ЧетныйЭтап = Ложь;
	
	Для Каждого ТипЭтапа из Метаданные.Перечисления.ТипыЭтаповУниверсальныхПроцессов.ЗначенияПеречисления Цикл
		
		ИмяЭтапа = ТипЭтапа.Имя;
		ПредставлениеЭтапа = ТипЭтапа.Представление();
		
		Если НазначениеПроцесса = Перечисления.НазначенияУниверсальныхПроцессов.МаршрутСогласования Тогда
			
			Если ИмяЭтапа <> "ЭтапПроцессаПодготовкиОтчетности" И ИмяЭтапа <> "ЭтапУниверсальногоИмпорта" И ИмяЭтапа <> "ЭтапУниверсальногоЭкспорта" Тогда
				
				Нстр = ТаблицаВозможныхЭтапов.Добавить();
				Нстр.ЗначениеЭтапаСтрока = ПредставлениеЭтапа;
				Нстр.ЗначениеЭтапа = ИмяЭтапа;
				Нстр.ИндексСтроки = 0;
				НарисоватьШаблонЭтапа(ТабличноеПолеВозможныхЭтапов, ИмяЭтапа, , Лево, Верх);
				Если ЧетныйЭтап Тогда 
					Лево = 5;
					Верх = Верх+25;
				Иначе
					Лево = Лево+33;
				КонецЕсли;
				ЧетныйЭтап = НЕ ЧетныйЭтап;
				
			КонецЕсли;
			
		ИначеЕсли НазначениеПроцесса = Перечисления.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности Тогда
			
			Если ИмяЭтапа = "ЭтапПроцессаПодготовкиОтчетности" Тогда
				
				Нстр = ТаблицаВозможныхЭтапов.Добавить();
				Нстр.ЗначениеЭтапаСтрока = ПредставлениеЭтапа;
				Нстр.ЗначениеЭтапа = ИмяЭтапа;
				Нстр.ИндексСтроки = 0;
				НарисоватьШаблонЭтапа(ТабличноеПолеВозможныхЭтапов, ИмяЭтапа, , Лево, Верх);
				Если ЧетныйЭтап Тогда 
					Лево = 5;
					Верх = Верх+25;
				Иначе
					Лево = Лево+33;
				КонецЕсли;
				ЧетныйЭтап = НЕ ЧетныйЭтап;
				
			КонецЕсли;
			
		ИначеЕсли НазначениеПроцесса = Перечисления.НазначенияУниверсальныхПроцессов.ПроизвольныйПроцесс Тогда
			
			Если ИмяЭтапа <> "ЭтапПроцессаПодготовкиОтчетности" И ИмяЭтапа <> "ЭтапСогласования" ИЛИ ИмяЭтапа="ОбработкаУниверсальногоПроцесса" Тогда
				
				Нстр = ТаблицаВозможныхЭтапов.Добавить();
				Нстр.ЗначениеЭтапаСтрока = ПредставлениеЭтапа;
				Нстр.ЗначениеЭтапа = ИмяЭтапа;
				Нстр.ИндексСтроки = 0;
				НарисоватьШаблонЭтапа(ТабличноеПолеВозможныхЭтапов, ИмяЭтапа, , Лево, Верх);
				Если ЧетныйЭтап Тогда
					Лево = 5;
					Верх = Верх+25;
				Иначе
					Лево = Лево+33;
				КонецЕсли;
				ЧетныйЭтап = НЕ ЧетныйЭтап;
			
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
		
	ТабличноеПолеВозможныхЭтапов.ТекущаяОбласть= ТабличноеПолеВозможныхЭтапов.Область(1,1,1,1);
	
КонецПроцедуры

&НаКлиенте
