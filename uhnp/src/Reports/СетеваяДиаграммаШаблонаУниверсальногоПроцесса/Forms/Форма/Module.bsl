// Функция выводит рисунок типа "текст" в табличный документ 
//
Функция НарисоватьТекст(ТабличныйДокумент, Текст, Расшифровка, Лево, Верх, Ширина, Высота)

	Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
	Рисунок.Лево   = Лево;
	Рисунок.Верх   = Верх;
	Рисунок.Ширина = Ширина;
	Рисунок.Высота = Высота;
	
	Рисунок.Расшифровка = Расшифровка;
	Рисунок.Текст = Текст;
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСнизу  = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.ГраницаСлева  = Ложь;
	
	Рисунок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Рисунок.ВертикальноеПоложение = ВертикальноеПоложение.Центр;

	Возврат Рисунок;
	
КонецФункции

Процедура НарисоватьШаблонЭтапа(ТабличныйДокумент, Этап, Расшифровка="", Лево, Верх)
	
	Рисунок = ТабличноеПолеВозможныхЭтапов.Рисунки.ДОбавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = БиблиотекаКартинок["Процессы_"+Этап];
	Рисунок.Лево = Лево;
	Рисунок.Верх = Верх;
	Рисунок.Ширина = 20;
	Рисунок.Высота = 20;
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСнизу  = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.ГраницаСлева  = Ложь;
	Рисунок.РазмерКартинки=РазмерКартинки.РеальныйРазмер;	
	Рисунок.Имя  = Этап;
	
	ТекстЗаголовкаЭтапа = "";
	Если Этап="ЭтапСогласования" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Согласование'");
	ИначеЕсли  Этап="УсловныйПереход" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Переход по условию'");
	ИначеЕсли  Этап="Автоутверждение" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Объект утвержден'");
	ИначеЕсли  Этап="Автоотклонение" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Объект отклонен'");
	ИначеЕсли  Этап="ДочернийМаршрут" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Вложенный процесс'");
	ИначеЕсли  Этап="ОбработкаУниверсальногоПроцесса" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Обработка'");
	ИначеЕсли  Этап="Оповещение" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Оповещение'");
	ИначеЕсли  Этап="ЦиклПока" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Ожидание события'");
	ИначеЕсли  Этап="ЭтапУниверсальногоИмпорта" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Импорт из ВИБ'");
	ИначеЕсли  Этап="ЭтапУниверсальногоЭкспорта" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Экспорт в ВИБ'");
	ИначеЕсли  Этап="ЭтапПроцессаПодготовкиОтчетности" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Подготовка отчетов'");
	ИначеЕсли  Этап="Пауза" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Пауза'");
	ИначеЕсли  Этап="РучнойПереход" Тогда
		ТекстЗаголовкаЭтапа = Нстр("ru = 'Переход по выбору'");
	КонецЕсли;
		
	НарисоватьТекст(ТабличныйДокумент, ТекстЗаголовкаЭтапа, Расшифровка, Лево, Верх+16, 21, 9)
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДоступностьОбъектаСогласования()
	
	   Запрос = Новый Запрос;
	   Запрос.Текст = "ВЫБРАТЬ
	                  |	ЭкземплярПроцесса.Ссылка
	                  |ИЗ
	                  |	Документ.ЭкземплярПроцесса КАК ЭкземплярПроцесса
	                  |ГДЕ
	                  |	ЭкземплярПроцесса.ШаблонПроцесса = &ШаблонПроцесса
	                  |	И ЭкземплярПроцесса.ПометкаУдаления = Ложь";
	   

	   Запрос.УстановитьПараметр("ШаблонПроцесса",Отчет.ШаблонПроцесса);
	   
	   Результат = Запрос.Выполнить();
	   Выборка = Результат.Выбрать();
	   
	   Пока Выборка.Следующий() Цикл
	   
	   	    Возврат Ложь;
	   
	   КонецЦикла;
	   
	   Возврат Истина;
		
КонецФункции

