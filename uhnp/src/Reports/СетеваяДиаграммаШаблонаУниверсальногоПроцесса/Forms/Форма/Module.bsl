Процедура ОтобразитьПанельЭтапов(Команда)
	
	УстановитьВидимостьПанелиЭтапов();
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПанелиЭтапов()
		
	Элементы.ОтобразитьПанельЭтапов.Пометка	 = НЕ Элементы.ОтобразитьПанельЭтапов.Пометка;
	Элементы.ВидыЭтаповПроцесса.Видимость	 = Элементы.ОтобразитьПанельЭтапов.Пометка;
		
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьПроцессы(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ШаблонПроцесса", Отчет.ШаблонПроцесса);
	СтруктураПараметров.Вставить("СостояниеПроцесса", ПредопределенноеЗначение("Перечисление.СостоянияПроцесса.Вработе"));
	ОткрытьФорму("Документ.ЭкземплярПроцесса.Форма.ФормаПроцессов", СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьМатрицуПолномочий(Команда)
	
	СтруктураПараметров = Новый Структура;
	ТипОбъектаСогласования = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Отчет.ШаблонПроцесса, "ТипОбъектаСогласования");
	СтруктураПараметров.Вставить("ОбъектБД", ТипОбъектаСогласования);
	ОткрытьФорму("Обработка.МатрицаПолномочий.Форма.ФормаУправленияМатрицейПолномочий", СтруктураПараметров);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте 
Процедура ПоказатьФормуВыбораЭтапа(ЗаголовокФормыВыбора, ОписаниеОповещенияИмя, ДополнительныеПараметры)
	
	Оповещение = Новый ОписаниеОповещения(ОписаниеОповещенияИмя, ЭтаФорма, ДополнительныеПараметры);
		
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ЗапретитьИзменениеШаблона", Истина);
	ПараметрыВыбора.Вставить("ШаблонПроцесса", Отчет.ШаблонПроцесса);
	ПараметрыВыбора.Вставить("Заголовок", ЗаголовокФормыВыбора);
	
	ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.Форма.ФормаВыбора",
		ПараметрыВыбора, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
	
&НаСервере
Процедура ДобавитьЭтапыВМенюВыбора()
	
	Для Каждого ВозможныйЭтап Из ТаблицаВозможныхЭтапов Цикл
	
		ИмяКоманды = "ДобавитьЭтап_" + ВозможныйЭтап.ЗначениеЭтапа;
		
		НоваяКоманда = Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "ДобавитьЭтап";
		НоваяКоманда.Заголовок = ВозможныйЭтап.ЗначениеЭтапаСтрока;
		
		НовыйЭлемент = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы.ГруппаДобавитьЭтап);
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;
		
	КонецЦикла;
	
	Если ТаблицаВозможныхЭтапов.Количество() = 1 Тогда
		ДобавитьЭтапКоманда = Команды.Найти("ДобавитьЭтап");
		НоваяКоманда.Заголовок = ДобавитьЭтапКоманда.Заголовок;
		НоваяКоманда.Картинка = ДобавитьЭтапКоманда.Картинка;
		НоваяКоманда.Отображение = ДобавитьЭтапКоманда.Отображение;
		Элементы.ГруппаДобавитьЭтап.Вид = ВидГруппыФормы.ГруппаКнопок;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВернутьВыбранныйЭтап(Область)
	
	Если ТипЗнч(Область) <> Тип("РисунокТабличногоДокумента") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяОбласти = Сред(Область.Имя, 3);
	
	Попытка
		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИмяОбласти) Тогда
			ТекУникальныйИдентификатор = Новый УникальныйИдентификатор(ИмяОбласти);
			НайденныеСтроки = Отчет.СоответствиеРисунковИЭтапов.НайтиСтроки(Новый Структура("ИмяРисунка", ТекУникальныйИдентификатор));
			Если НайденныеСтроки.Количество() > 0 Тогда
				Возврат НайденныеСтроки[0].Этап;
			Иначе
				Возврат Неопределено;
			КонецЕсли;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытьФормуЛинейногоМаршрута()
	
	Если мФормаФормированияЛинейногоМаршрута <> Неопределено Тогда
		
		Если мФормаФормированияЛинейногоМаршрута.Открыта() Тогда
			мФормаФормированияЛинейногоМаршрута.Закрыть();
		КонецЕсли;
		
		мФормаФормированияЛинейногоМаршрута = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПанелиПроверки(ВключенРежимПроверки = Неопределено)
	
	Если ВключенРежимПроверки = Неопределено Тогда
		
		ВключенРежимПроверки = Отчет.ВключенРежимПроверки;
		
	КонецЕсли;
	
	Элементы.ПроверкаМаршрута.Видимость = ВключенРежимПроверки;
	Элементы.ПроверитьМаршрут.Пометка   = ВключенРежимПроверки;
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьСогласующихПользователей(ВключенРежимПроверки)
	
	Запрос = Новый Запрос;
	Если ВключенРежимПроверки Тогда 
		Запрос.УстановитьПараметр("ТекстПользователь", НСтр("ru = 'Пользователь:'"));
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЭтапыУниверсальныхПроцессов.Ссылка КАК ЭтапСогласования,
			|	&ТекстПользователь КАК ЗаголовокПользователя,
			|	ВЫБОР
			|		КОГДА ЭтапыУниверсальныхПроцессовУтверждающие.Пользователь ССЫЛКА Справочник.Пользователи
			|			ТОГДА ЭтапыУниверсальныхПроцессовУтверждающие.Пользователь
			|		КОГДА ОтветственныеОрганизаций.Пользователь ЕСТЬ NULL 
			|			ТОГДА ОтветственныеОрганизаций.Пользователь
			|		ИНАЧЕ ОтветственныеОрганизаций.Пользователь
			|	КОНЕЦ КАК Пользователь,
			|	ВЫБОР
			|		КОГДА ЭтапыУниверсальныхПроцессовУтверждающие.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА &ОрганизацияОтчета
			|		ИНАЧЕ ЭтапыУниверсальныхПроцессовУтверждающие.Организация
			|	КОНЕЦ КАК Организация
			|ИЗ
			|	Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов.Утверждающие КАК ЭтапыУниверсальныхПроцессовУтверждающие
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеОрганизаций КАК ОтветственныеОрганизаций
			|			ПО ЭтапыУниверсальныхПроцессовУтверждающие.Пользователь = ОтветственныеОрганизаций.Роль
			|				И (ОтветственныеОрганизаций.Организация = ВЫБОР
			|					КОГДА ЭтапыУниверсальныхПроцессовУтверждающие.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|						ТОГДА &ОрганизацияОтчета
			|					ИНАЧЕ ЭтапыУниверсальныхПроцессовУтверждающие.Организация
			|				КОНЕЦ)
			|		ПО (ЭтапыУниверсальныхПроцессовУтверждающие.Ссылка = ЭтапыУниверсальныхПроцессов.Ссылка)
			|ГДЕ
			|	ЭтапыУниверсальныхПроцессов.ТипЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЭтапСогласования)
			|	И ЭтапыУниверсальныхПроцессов.Владелец = &ШаблонПроцесса
			|	И ЭтапыУниверсальныхПроцессов.ПометкаУдаления = ЛОЖЬ
			|ИТОГИ ПО
			|	ЭтапСогласования";
	Иначе    
		Запрос.УстановитьПараметр("ТекстПользователь", 	НСтр("ru = 'Пользователь:'"));     
		Запрос.УстановитьПараметр("ТекстРоль", 			НСтр("ru = 'Роль:'"));
		Запрос.УстановитьПараметр("ТекстОрганизация", 	НСтр("ru = 'Текущая организация'"));
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЭтапыУниверсальныхПроцессов.Ссылка КАК ЭтапСогласования,
			|	ВЫБОР
			|		КОГДА ЭтапыУниверсальныхПроцессовУтверждающие.Пользователь ССЫЛКА Справочник.РолиКонтактныхЛиц
			|			ТОГДА &ТекстРоль
			|		ИНАЧЕ &ТекстПользователь
			|	КОНЕЦ КАК ЗаголовокПользователя,
			|	ЭтапыУниверсальныхПроцессовУтверждающие.Пользователь КАК Пользователь,
			|	ВЫБОР
			|		КОГДА ЭтапыУниверсальныхПроцессовУтверждающие.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ТОГДА &ТекстОрганизация
			|		ИНАЧЕ ЭтапыУниверсальныхПроцессовУтверждающие.Организация
			|	КОНЕЦ КАК Организация
			|ИЗ
			|	Справочник.ЭтапыУниверсальныхПроцессов КАК ЭтапыУниверсальныхПроцессов
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов.Утверждающие КАК ЭтапыУниверсальныхПроцессовУтверждающие
			|		ПО (ЭтапыУниверсальныхПроцессовУтверждающие.Ссылка = ЭтапыУниверсальныхПроцессов.Ссылка)
			|ГДЕ
			|	ЭтапыУниверсальныхПроцессов.ТипЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыЭтаповУниверсальныхПроцессов.ЭтапСогласования)
			|	И ЭтапыУниверсальныхПроцессов.Владелец = &ШаблонПроцесса
			|	И ЭтапыУниверсальныхПроцессов.ПометкаУдаления = ЛОЖЬ
			|ИТОГИ ПО
			|	ЭтапСогласования";

	КонецЕсли;
	Запрос.УстановитьПараметр("ШаблонПроцесса", Отчет.ШаблонПроцесса);
	Запрос.УстановитьПараметр("ОрганизацияОтчета", Отчет.ОрганизацияОтчета);
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		
		НайденныеСтроки = Отчет.СоответствиеРисунковИЭтапов.НайтиСтроки(Новый Структура("Этап", Выборка.ЭтапСогласования));
		
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРисунка = НайденныеСтроки[0].ИмяРисунка;
		
		Текст = "";
		ВыборкаПользователей = Выборка.Выбрать();
		Пока ВыборкаПользователей.Следующий() Цикл
			
			Текст = Текст + "
			|" + ВыборкаПользователей.ЗаголовокПользователя + " " + ВыборкаПользователей.Пользователь + "(" + ВыборкаПользователей.Организация + ")";
		КонецЦикла;
		
		ПолеТабличногоДокумента.Рисунки["3_" + ИмяРисунка].Текст = Текст;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьКоличествоДокументов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЭтапыУниверсальныхПроцессовФормируемыеДокументы.Ссылка КАК ЭтапСогласования,
			|	КОЛИЧЕСТВО(ЭтапыУниверсальныхПроцессовФормируемыеДокументы.ДокументБД) КАК КоличествоДокументов
			|ИЗ
			|	Справочник.ЭтапыУниверсальныхПроцессов.ФормируемыеДокументы КАК ЭтапыУниверсальныхПроцессовФормируемыеДокументы
			|ГДЕ
			|	ЭтапыУниверсальныхПроцессовФормируемыеДокументы.Ссылка.Владелец = &ШаблонПроцесса
			|
			|СГРУППИРОВАТЬ ПО
			|	ЭтапыУниверсальныхПроцессовФормируемыеДокументы.Ссылка";
			
	Запрос.УстановитьПараметр("ШаблонПроцесса", Отчет.ШаблонПроцесса);
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		
		НайденныеСтроки = Отчет.СоответствиеРисунковИЭтапов.НайтиСтроки(Новый Структура("Этап", Выборка.ЭтапСогласования));
		
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРисунка = НайденныеСтроки[0].ИмяРисунка;
		
		СтрокаШаблона = Нстр("ru = 'Документов: %1'");  //Количество документов
		
		СтрокаСообщения = "";
		Если Не ПустаяСтрока(СтрокаШаблона) тогда								
			СтрокаСообщения = СтрШаблон(СтрокаШаблона, Выборка.КоличествоДокументов);
		Иначе
			СтрокаСообщения = Строка(Выборка.КоличествоДокументов);
		КонецЕсли;
				
		ПолеТабличногоДокумента.Рисунки["3_" + ИмяРисунка].Текст = СтрокаСообщения;
		
	КонецЦикла;
	
КонецПроцедуры

// Выводит в заголовок команды открытия списка процессов
// количество запущенных процессов
&НаСервере
Процедура ОтобразитьКоличествоЗапущенныхПроцессов()
	МассивЗапущенныхПроцессов = УправлениеПроцессамиСогласованияУХ.ПолучитьМассивЗапущенныхПроцессов(Отчет.ШаблонПроцесса);
	КоличествоЗапущенныхПроцессов = МассивЗапущенныхПроцессов.Количество();
	ТекстЗаголовкаКоманды = НСтр("ru = 'Процесс (%КоличествоПроцессов%)'");
	ТекстЗаголовкаКоманды = СтрЗаменить(ТекстЗаголовкаКоманды, "%КоличествоПроцессов%", Строка(КоличествоЗапущенныхПроцессов));
	Элементы.ОтобразитьПроцессы.Заголовок = ТекстЗаголовкаКоманды;
КонецПроцедуры		// ОтобразитьКоличествоЗапущенныхПроцессов()

// Управляет доступностью элементов формы.
&НаСервере
Процедура УправлениеДоступность()
	
	// Проверка на пометку удаления.
	Если Отчет.ШаблонПроцесса.ПометкаУдаления Тогда
		ТекстРисунка = НСтр("ru = 'Текущий шаблон процесса помечен на удаление. Работа с этапами недоступна.'");
		СводнаяТаблицаУХ.ВернутьРисунокПустойТаблицы(ПолеТабличногоДокумента, ТекстРисунка);
		ЭтаФорма.Доступность = Ложь;
	Иначе
		// Проверка пройдена.
	КонецЕсли;
	// Проверка на предопределённый маршрут.
	Если Отчет.ШаблонПроцесса = Справочники.ШаблоныУниверсальныхПроцессов.Автоутверждение Тогда
		ТекстСообщения = НСтр("ru = 'Шаблон процесса %Шаблон% является системным. Редактирование вручную запрещено.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Шаблон%", Строка(Отчет.ШаблонПроцесса));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		ЭтаФорма.Доступность = Ложь;
	Иначе
		// Проверка пройдена.
	КонецЕсли;	
	// Видимость команды Матрица полномочий.
	ЭтоШаблонПроцессаСогласования = Ложь;
	Если ЗначениеЗаполнено(НазначениеПроцесса) Тогда
		ЭтоШаблонПроцессаСогласования = (НазначениеПроцесса = Перечисления.НазначенияУниверсальныхПроцессов.МаршрутСогласования);
	Иначе
		ЭтоШаблонПроцессаСогласования = Ложь;
	КонецЕсли;
	Элементы.ОткрытьМатрицуПолномочий.Видимость = ЭтоШаблонПроцессаСогласования;
	
КонецПроцедуры

// Проверяет, есть ли запущенные процессы по шаблону ШаблонПроцессаВход,
// и выводит предупреждение в случае их наличия.
&НаКлиенте
Процедура ПредупредитьОбИзмененииЗапущенногоПроцесса(ШаблонПроцессаВход)
	
	Если ПредупреждениеЗапущенногоПроцессаВыведено = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если НазначениеПроцесса = ПредопределенноеЗначение("Перечисление.НазначенияУниверсальныхПроцессов.ПроцессПодготовкиОтчетности") Тогда
		ПредупреждениеЗапущенногоПроцессаВыведено = Истина;
		Возврат;
	КонецЕсли;
	
	МассивЗапущенныйхПроцессов = УправлениеПроцессамиСогласованияУХ.ПолучитьМассивЗапущенныхПроцессов(ШаблонПроцессаВход);
	КоличествоПроцессов = МассивЗапущенныйхПроцессов.Количество();
	Если КоличествоПроцессов > 0 Тогда
		ТекстСообщения = НСтр("ru = 'По шаблону %ШаблонПроцесса% имеются запущенные процессы в количестве: %КоличествоПроцессов% шт. Рекомендуется перезапустить исполняющиеся процессы после завершения настройки маршрута, чтобы избежать ошибок их исполнения.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ШаблонПроцесса%", Строка(ШаблонПроцессаВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КоличествоПроцессов%", Строка(КоличествоПроцессов));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		ПредупреждениеЗапущенногоПроцессаВыведено = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Создаёт, размещает в схеме процесса и отображает пользователю этап с типом ТипЭтапаВход.
&НаКлиенте
Процедура СоздатьИОтобразитьЭтап(ТипЭтапаВход)
	
	Перем АдресДеревоОтборов, АдресТабличноеПолеПереходов, АдресКэшВидовСубконто, АдресТаблицаДоступныхПараметров, ОбычныйЭтап;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("АдресДеревоОтборов",                   АдресДеревоОтборов);
	ПараметрыОткрытияФормы.Вставить("АдресТабличноеПолеПереходов",          АдресТабличноеПолеПереходов); 
	ПараметрыОткрытияФормы.Вставить("АдресКэшВидовСубконто",                АдресКэшВидовСубконто); 
	ПараметрыОткрытияФормы.Вставить("ОбычныйЭтап",                          ОбычныйЭтап);
	ПараметрыОткрытияФормы.Вставить("СписокВыбораУсловий",                  Новый СписокЗначений); 
	ПараметрыОткрытияФормы.Вставить("СписокВыбораДействий",                 Новый СписокЗначений); 
	ПараметрыОткрытияФормы.Вставить("ШаблонПроцесса",                       Неопределено);
	ПараметрыОткрытияФормы.Вставить("ТипЭтапа",                             Неопределено);
	ПараметрыОткрытияФормы.Вставить("АдресТаблицаДоступныхПараметров",      Неопределено);
	ПараметрыОткрытияФормы.Вставить("ЗаписыватьЭтапУниверсальногоПроцесса", Ложь);
	
	Если ЗначениеЗаполнено(ТипЭтапаВход) Тогда
		НовыйЭтапСсылка = СоздатьИДобавитьЭтап(ТипЭтапаВход, ПараметрыОткрытияФормы);
		СформироватьОтчетНаСервере();
		Элементы.ПолеТабличногоДокумента.Редактирование = Ложь;
		// Предупредим о изменении запущенного маршрута.
		ПредупредитьОбИзмененииЗапущенногоПроцесса(Отчет.ШаблонПроцесса);
		// Откроем созданный этап, если пользователь ввёл соответственную настройку.
		Если ЗначениеЗаполнено(НовыйЭтапСсылка) Тогда
			Если ТипЭтапаВход = ПредопределенноеЗначение("Перечисление.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход") Тогда
				ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.Форма.ФормаНастройкиУсловногоПерехода", ПараметрыОткрытияФормы, ЭтотОбъект);
			Иначе
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Ключ", НовыйЭтапСсылка);
				ПараметрыФормы.Вставить("ТихийРежим", Истина);
				ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.ФормаОбъекта", ПараметрыФормы);
			КонецЕсли;
		Иначе
			// Этап не был создан, либо пользователь не установил настройку. Не требуется открытие.
		КонецЕсли;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось получить тип нового этапа. Создание этапа отменено.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ ПРОВЕРКИ МАРШРУТА.
//

&НаСервере
Процедура ОтобразитьХодМаршрутаПоВыбраннымУсловиям()
	
	Если НЕ ЭтоАдресВременногоХранилища(АдресТаблицыЭтапов) Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'При отображении возникла ошибка. Попробуйте обновить отчет и повторить операцию'"));
		Возврат;
	КонецЕсли;
	
	Этапы = ПолучитьИзВременногоХранилища(АдресТаблицыЭтапов);
	
	МассивПройденныхЭтапов = Новый Массив;
	НачальныеЭтапы = Этапы.НайтиСтроки(Новый Структура("КоличествоПредшественников", 0));
	
	МассивПереходов = Новый Массив;
	
	Для Каждого Строка Из НачальныеЭтапы Цикл
		МассивПройденныхЭтапов.Добавить(Строка.Этап);
	КонецЦикла;
	
	ОпределитьЭтапыПоследователи(Этапы, МассивПереходов, МассивПройденныхЭтапов);
	
	Для Каждого Рисунок Из Отчет.СоответствиеРисунковИЭтапов Цикл
		ПолеТабличногоДокумента.Рисунки["4_" + Рисунок.ИмяРисунка].ЦветФона = ?(МассивПереходов.Найти(Рисунок.Этап) = Неопределено, Новый Цвет(245,245, 200), Новый Цвет(125, 250, 125));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьЭтапыПоследователи(Этапы, МассивПереходов, Знач МассивПройденныхЭтапов)
	
	ВнутрМассивПройденныхЭтапов = Новый Массив;
	
	Для Каждого Этап Из МассивПройденныхЭтапов Цикл
		Строка = Этапы.Найти(Этап, "Этап");
		МассивПереходов.Добавить(Этап);
		ОбработатьСпособПерехода(Строка.УсловияСогласования.Строки, ВнутрМассивПройденныхЭтапов);
	КонецЦикла;
	
	Если ВнутрМассивПройденныхЭтапов.Количество() > 0 Тогда
		ОпределитьЭтапыПоследователи(Этапы, МассивПереходов, ВнутрМассивПройденныхЭтапов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьСпособПерехода(Строки, МассивЭтапов)
	
	СледующийЭтап = Неопределено;
	
	Для Каждого Строка Из Строки Цикл
		Если Строка.ЯвляетсяУсловием Тогда
			Если Строка.ОбработкаУсловия = 0 Тогда
				Если ПроверкаУсловияПерехода(Строка) Тогда
					ТекСтрока = Строка.Строки.Найти(1, "ОбработкаУсловия");
				Иначе
					ТекСтрока = Строка.Строки.Найти(2, "ОбработкаУсловия");
				КонецЕсли;
				
			ИначеЕсли Строка.ОбработкаУсловия = 6 Тогда //Цикл	
				Если ПроверкаУсловияПерехода(Строка) Тогда
					ТекСтрока = Строка.Строки.Найти(7, "ОбработкаУсловия");		
				Иначе	
					ТекСтрока = Строка.Строки.Найти(2, "ОбработкаУсловия");
				КонецЕсли;
				
			Иначе
				Для Каждого ВнутрСтрока Из Строка.Строки Цикл
					Если ВнутрСтрока.ОбработкаУсловия = 4 И ПроверкаУсловияПерехода(ВнутрСтрока) Тогда
						ТекСтрока = ВнутрСтрока;
						Прервать;
					ИначеЕсли ВнутрСтрока.ОбработкаУсловия = 5 Тогда
						ТекСтрока = ВнутрСтрока;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ОбработатьСпособПерехода(ТекСтрока.Строки, МассивЭтапов);
			
		ИначеЕсли Строка.УсловиеДействие = Перечисления.ДействияЭтапа.ПерейтиКЭтапу Тогда
			МассивЭтапов.Добавить(Строка.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверкаУсловияПерехода(Строка)
	
	ТабличноеПолеНачальныхНастроек = Отчет.ТабличноеПолеНачальныхНастроек.Выгрузить();
	
	Если Строка.УсловиеДействие = Перечисления.УсловияЭтапа.ПараметрическоеУсловие Тогда
		СтрокаУсловия = ТабличноеПолеНачальныхНастроек.Найти(Строка.ЗначениеОтбора, "Условие");
	Иначе
		СтрокаУсловия = ТабличноеПолеНачальныхНастроек.Найти(Строка.УсловиеДействие, "Условие");
	КонецЕсли;
	
	ТекЗначение = СтрокаУсловия.Значение;
	
	ПодсистемаКорпоративноеКазначейство = ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.КорпоративноеКазначейство");
		
	Если Строка.УсловиеДействие = Перечисления.УсловияЭтапа.ПараметрическоеУсловие Тогда
		СтрокаУсловия = ТабличноеПолеНачальныхНастроек.Найти(Строка.ЗначениеОтбора, "Условие");
		Если СтрокаУсловия = Неопределено Тогда
			Возврат Истина;
		Иначе
			Возврат СтрокаУсловия.Значение;
		КонецЕсли;
	ИначеЕсли Строка.УсловиеДействие = Перечисления.УсловияЭтапа.СуммаПлатежа Тогда
		Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, СтрокаУсловия.Значение, Строка.ЗначениеОтбора);
	ИначеЕсли Строка.УсловиеДействие = Перечисления.УсловияЭтапа.Взаиморасчеты Тогда
		
		Если ПодсистемаКорпоративноеКазначейство Тогда
			
			Если Строка.Значение = Перечисления["ВидСравненияЛимитовЗаявок"]["АбсолютноеПревышениеЛимитаНа"] Тогда
				
				СтрокаКонтроля = ТабличноеПолеНачальныхНастроек.Найти(12, "ВидУсловия");
				Возврат СтрокаУсловия.Значение - СтрокаКонтроля.Значение > Строка.ЗначениеОтбора;
				
			ИначеЕсли Строка.Значение = Перечисления["ВидСравненияЛимитовЗаявок"]["ОтносительноеПревышениеЛимитаНа"] Тогда
				
				СтрокаКонтроля = ТабличноеПолеНачальныхНастроек.Найти(12, "ВидУсловия");
				Возврат СтрокаУсловия.Значение - СтрокаКонтроля.Значение > СтрокаКонтроля.Значение * Строка.ЗначениеОтбора / 100;
				
			Иначе
				
				Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, Строка.ЗначениеОтбора, СтрокаУсловия.Значение);
				
			КонецЕсли;
			
		Иначе
			
			Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, Строка.ЗначениеОтбора, СтрокаУсловия.Значение);
			
		КонецЕсли;
		
	ИначеЕсли Строка.УсловиеДействие = Перечисления.УсловияЭтапа.ПланыДДС Тогда
		
		Если ПодсистемаКорпоративноеКазначейство Тогда
			
			Если Строка.Значение = Перечисления["ВидСравненияЛимитовЗаявок"]["АбсолютноеПревышениеЛимитаНа"] Тогда
				
				СтрокаКонтроля = ТабличноеПолеНачальныхНастроек.Найти(13, "ВидУсловия");
				Возврат СтрокаУсловия.Значение - СтрокаКонтроля.Значение > Строка.ЗначениеОтбора;
				
			ИначеЕсли Строка.Значение = Перечисления["ВидСравненияЛимитовЗаявок"]["ОтносительноеПревышениеЛимитаНа"] Тогда
				
				СтрокаКонтроля = ТабличноеПолеНачальныхНастроек.Найти(13, "ВидУсловия");
				Возврат СтрокаУсловия.Значение - СтрокаКонтроля.Значение > СтрокаКонтроля.Значение * Строка.ЗначениеОтбора / 100;
				
			Иначе
				
				Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, Строка.ЗначениеОтбора, СтрокаУсловия.Значение);
				
			КонецЕсли;
			
		Иначе
			
			Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, Строка.ЗначениеОтбора, СтрокаУсловия.Значение);
			
		КонецЕсли;
		
	ИначеЕсли Строка.УсловиеДействие = Перечисления.УсловияЭтапа.ОстаткиДС Тогда
		
		Если ПодсистемаКорпоративноеКазначейство Тогда
			
			Если Строка.Значение = Перечисления["ВидСравненияЛимитовЗаявок"]["АбсолютноеПревышениеЛимитаНа"] Тогда
				
				СтрокаКонтроля = ТабличноеПолеНачальныхНастроек.Найти(14, "ВидУсловия");
				Возврат СтрокаУсловия.Значение - СтрокаКонтроля.Значение > Строка.ЗначениеОтбора;
				
			ИначеЕсли Строка.Значение = Перечисления["ВидСравненияЛимитовЗаявок"]["ОтносительноеПревышениеЛимитаНа"] Тогда
				
				СтрокаКонтроля = ТабличноеПолеНачальныхНастроек.Найти(14, "ВидУсловия");
				Возврат СтрокаУсловия.Значение - СтрокаКонтроля.Значение > СтрокаКонтроля.Значение * Строка.ЗначениеОтбора / 100;
				
			Иначе
				
				Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, Строка.ЗначениеОтбора, СтрокаУсловия.Значение);
				
			КонецЕсли;
			
		Иначе
			
			Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, Строка.ЗначениеОтбора, СтрокаУсловия.Значение);
			
		КонецЕсли;

	КонецЕсли;
	
	Если Строка.Значение = ВидСравнения.Равно Тогда
		Возврат Строка.ЗначениеОтбора = ТекЗначение;
	ИначеЕсли Строка.Значение = ВидСравнения.НеРавно Тогда
		Возврат Строка.ЗначениеОтбора <> ТекЗначение;
	ИначеЕсли Строка.Значение = ВидСравнения.ВСписке Тогда
		Возврат Строка.ЗначениеОтбора.НайтиПоЗначению(ТекЗначение) <> Неопределено;
	ИначеЕсли Строка.Значение = ВидСравнения.НеВСписке Тогда
		Возврат Строка.ЗначениеОтбора.НайтиПоЗначению(ТекЗначение) = Неопределено;
	ИначеЕсли Строка.Значение = ВидСравнения.Больше Тогда
		Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, СтрокаУсловия.Значение, Строка.ЗначениеОтбора);
	ИначеЕсли Строка.Значение = ВидСравнения.Меньше Тогда
		Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, СтрокаУсловия.Значение, Строка.ЗначениеОтбора);
	ИначеЕсли Строка.Значение = ВидСравнения.БольшеИлиРавно Тогда
		Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, СтрокаУсловия.Значение, Строка.ЗначениеОтбора);
	ИначеЕсли Строка.Значение = ВидСравнения.МеньшеИлиРавно Тогда
		Возврат МодульСогласованияДокументовУХ.СравнитьЧислаПоВидуСравнения(Строка.Значение, СтрокаУсловия.Значение, Строка.ЗначениеОтбора);
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции


