&НаКлиенте
Процедура ТаблицаВозможныхЭтаповОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Элемент.Имя = "ПолеТабличногоДокумента" Тогда
		СоздатьИДобавитьЭтап(ПараметрыПеретаскивания.Значение[0].ЗначениеЭтапа);
		СформироватьОтчетНаСервере();
		Элементы.ПолеТабличногоДокумента.Редактирование = Ложь;	
	Иначе	
		ЗаполнитьСписокВозможныхЭтапов();
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция СоздатьИДобавитьЭтап(ТипЭтапа, ПараметрыОткрытияФормы = Неопределено)
	
	РезультатФункции = Справочники.ЭтапыУниверсальныхПроцессов.ПустаяСсылка();
	
	Попытка
		Если ТипЗнч(ТипЭтапа) = Тип("Строка") Тогда
			ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов[ТипЭтапа];
		КонецЕсли;
		
		НЭтап = Справочники.ЭтапыУниверсальныхПроцессов.СоздатьЭлемент();
		НЭтап.Владелец = Отчет.ШаблонПроцесса;
		НЭтап.ТипЭтапа = ТипЭтапа;
		НЭтап.Наименование = Строка(ТипЭтапа);
		Если ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.ЭтапПроцессаПодготовкиОтчетности Тогда
			НЭтап.ТипОрганизацийЭтапа = Перечисления.ТипыОрганизационныхЕдиниц.Обычная;
			НЭтап.КритерийУтвержденияЭтапа = Перечисления.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УтвержденыВсеДокументы;
		КонецЕсли;
		
		// Установка статусов для этапов по умолчанию из настройки документа/справочника.
		ТипОбъектаСогласования = Отчет.ШаблонПроцесса.ТипОбъектаСогласования;
		Если ЗначениеЗаполнено(ТипОбъектаСогласования) Тогда
			Если ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.ЭтапСогласования Тогда
				НЭтап.СтатусСогласованияОбъекта = ТипОбъектаСогласования.ЗначениеРеквизитаСостоянияНаУтверждении;
			ИначеЕсли ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.РучнойПереход Тогда
				НЭтап.СтатусСогласованияОбъекта = ТипОбъектаСогласования.ЗначениеРеквизитаСостоянияНаУтверждении;
			ИначеЕсли ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.ОбработкаУниверсальногоПроцесса Тогда
				НЭтап.СтатусСогласованияОбъекта = ТипОбъектаСогласования.ЗначениеРеквизитаСостоянияНаУтверждении;
			ИначеЕсли ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.Автоотклонение Тогда
				НЭтап.СтатусСогласованияОбъекта = ТипОбъектаСогласования.ЗначениеРеквизитаСостоянияОтклонен;
			ИначеЕсли ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.Автоутверждение Тогда
				НЭтап.СтатусСогласованияОбъекта = ТипОбъектаСогласования.ЗначениеРеквизитаСостоянияУтвержден;
			Иначе
				// Для прочих типов этапов не устанавливаем статус по умолчанию.
			КонецЕсли;
		Иначе
			// Не определён объект для согласования. Ничего не делаем.
		КонецЕсли;
		
		Если ТипЭтапа = Перечисления.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход Тогда
			НЭтап.УсловияСогласования = Новый ХранилищеЗначения(РеквизитФормыВЗначение("ТабличноеПолеПерехода"));
		КонецЕсли;
		
		НЭтап.Записать();
		РезультатФункции = НЭтап.Ссылка;
		
		Если ПараметрыОткрытияФормы <> Неопределено Тогда
			ИнициализацияУсловийСогласования(НЭтап.Ссылка, ПараметрыОткрытияФормы);
		КонецЕсли;
		
	Исключение
		ТекстСообщения = НСтр("ru = 'Возникли ошибки при создании этапа %ТипЭтапа%: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТипЭтапа%", Строка(ТипЭтапа));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		РезультатФункции = Справочники.ЭтапыУниверсальныхПроцессов.ПустаяСсылка();
	КонецПопытки;
	
	Возврат РезультатФункции;
	
КонецФункции

