#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	УстановитьПараметрыДанных();
	
	//Выводим свернутые группировки
	СтандартнаяОбработка = Ложь;
	
	МакетКомпоновки = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = МакетКомпоновки.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет,,ДанныеРасшифровки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ДокументРезультат.ПоказатьУровеньГруппировокСтрок(1);
	
КонецПроцедуры

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПриЗагрузкеПользовательскихНастроекНаСервере = Истина;
	
КонецПроцедуры

Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Форма, НовыеПользовательскиеНастройкиКД) Экспорт
	
	УстановитьПараметрыДанных();

	//ПользовательскиеНастройки
	Параметры = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	Для каждого эл Из Параметры.Элементы Цикл
		
		Если ЗначениеЗаполнено(эл.ИдентификаторПользовательскойНастройки) Тогда
			ПользовательскийПараметр = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(эл.ИдентификаторПользовательскойНастройки);
			Если ТипЗнч(ПользовательскийПараметр) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
				ПользовательскийПараметр.Значение = эл.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьПараметрыДанных()

	УстановитьПривилегированныйРежим(Истина);
	
	ДатаНачала = Константы.тн_ВремяПоследнейСводкиОСостоянииВходящихСообщений.Получить();
	ДатаКонца = ТекущаяДатаСеанса();
	
	Параметры = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	Параметры.УстановитьЗначениеПараметра("ДатаСводки", ДатаКонца);
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		Параметры.УстановитьЗначениеПараметра("ВремяПоследнейСводкиОСостоянииВходящихСообщений", ДатаНачала);
	Иначе
		Параметры.УстановитьЗначениеПараметра("ВремяПоследнейСводкиОСостоянииВходящихСообщений", НачалоМесяца(ДатаКонца));
	КонецЕсли; 
	
	Параметры.УстановитьЗначениеПараметра("КоличествоПопытокПовторнойОбработкиСообщенийRMQ", Константы.тн_Интеграция_КоличествоПопытокПовторнойОбработкиСообщенийRMQ.Получить());
	

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

#КонецЕсли
