
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ПоляСКД = СхемаКомпоновкиДанных.НаборыДанных[0].Поля;
	
	ШаблонПоля = 
	"ВЫБОР 
	|	КОГДА МАКСИМУМ(ОбщаяУчетнаяПолитика) ЕСТЬ NULL 
	|		ТОГДА СТРОКА(Сценарий) 
	|	ИНАЧЕ 
	|		СТРОКА(Сценарий) + "" (%1: "" + СТРОКА(МАКСИМУМ(ОбщаяУчетнаяПолитика)) + "")""  
	|КОНЕЦ";
	ПоляСКД.Найти("Сценарий").ВыражениеПредставления = СтрШаблон(ШаблонПоля, НСтр("ru = 'по умолчанию'"));
	
	ШаблонПоля = 
	"ВЫБОР 
	|	КОГДА %1 ЕСТЬ NULL ТОГДА 
	|		""<...>""
	|	ИНАЧЕ ПРЕДСТАВЛЕНИЕ(%1) + "" %2 "" + ФОРМАТ(%3, ""ДЛФ=D"")
	|КОНЕЦ";
	ПоляСКД.Найти("УчетнаяПолитика").ВыражениеПредставления 
		= СтрШаблон(ШаблонПоля, "УчетнаяПолитика", НСтр("ru = 'применяется с'"), "ПрименяетсяС");
	
	СхемаКомпоновкиДанных.ПоляИтога.Найти("УчетнаяПолитика").Выражение 
		= СтрШаблон(ШаблонПоля, "МАКСИМУМ(УчетнаяПолитика)", НСтр("ru = 'применяется с'"), "МАКСИМУМ(ПрименяетсяС)");
	
КонецПроцедуры
	
