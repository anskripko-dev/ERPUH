&НаКлиенте
Процедура ПредставлениеУведомленияВыбор(Элемент, Область, СтандартнаяОбработка)
	Если УведомлениеОСпецрежимахНалогообложенияКлиент.ТиповойВыбор(ЭтотОбъект, Область, СтандартнаяОбработка) Или ЭтотОбъект["РучнойВвод"] Тогда 
		Возврат;
	КонецЕсли;
	
	Если СтандартнаяОбработка И Область.Защита = Ложь Тогда 
		ОО = Новый ОписаниеОповещения("ПредставлениеУведомленияВыборЗавершение", ЭтотОбъект, Новый Структура("Область", Область));
		УведомлениеОСпецрежимахНалогообложенияКлиент.ПредставлениеУведомленияВыбор(ЭтотОбъект, Область, СтандартнаяОбработка, Истина, Истина, ОО);
	КонецЕсли;
	
	Если Область.Имя = "КодНО" Тогда 
		СтандартнаяОбработка = Ложь;
		РегламентированнаяОтчетностьКлиент.ОткрытьФормуВыбораРегистрацииВИФНС(ЭтотОбъект, Область.Имя);
	КонецЕсли;
	
	Если СтандартнаяОбработка И ЭтоОбластьОКСМ(Область) И Область.Защита = Ложь Тогда
		УведомлениеОСпецрежимахНалогообложенияКлиент.ВыборКодаСтраныИзСправочника(ЭтотОбъект, Область, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеУведомленияВыборЗавершение(Результат, ДопПараметры) Экспорт 
	Если ДопПараметры.Область.Имя = "ТипУчастника" Тогда 
		ДоступностьПолейФЛИОРО();
	ИначеЕсли ДопПараметры.Область.Имя = "ТипУчастникаИнфУчаст" Тогда 
		ДоступностьПолейИОРО();
	КонецЕсли;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьПолейФЛИОРО()
	_Модифицированность = Модифицированность;
	Область = ПредставлениеУведомления.Области["ТипУчастника"];
	ЭтоРО = (Область.Значение = "1");
	ЭтоИО = (Область.Значение = "2");
	ЭтоФЛ = (Область.Значение = "3");
	
	Для Каждого Обл Из ПредставлениеУведомления.Области Цикл 
		Если СтрНачинаетсяС(Обл.Имя, "РО_") Тогда 
			Обл.Защита = Не ЭтоРО;
			Обл.ЦветФона = ?(ЭтоРО, ЭтотОбъект["ЦФЖ"], ЭтотОбъект["ЦФБ"]);
			Если Не ЭтоРО Тогда 
				Обл.Значение = Неопределено;
				УведомлениеОСпецрежимахНалогообложенияКлиент.ПриИзмененииСодержимогоОбласти(ЭтотОбъект, Обл, Истина);
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Обл.Имя, "ИО_") Тогда 
			Обл.Защита = Не ЭтоИО;
			Обл.ЦветФона = ?(ЭтоИО, ЭтотОбъект["ЦФЖ"], ЭтотОбъект["ЦФБ"]);
			Если Не ЭтоИО Тогда 
				Обл.Значение = Неопределено;
				УведомлениеОСпецрежимахНалогообложенияКлиент.ПриИзмененииСодержимогоОбласти(ЭтотОбъект, Обл, Истина);
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Обл.Имя, "ФЛ_") Тогда 
			Обл.Защита = Не ЭтоФЛ;
			Обл.ЦветФона = ?(ЭтоФЛ, ЭтотОбъект["ЦФЖ"], ЭтотОбъект["ЦФБ"]);
			Если Не ЭтоФЛ Тогда 
				Обл.Значение = Неопределено;
				УведомлениеОСпецрежимахНалогообложенияКлиент.ПриИзмененииСодержимогоОбласти(ЭтотОбъект, Обл, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Модифицированность = _Модифицированность;
КонецПроцедуры

