
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = Новый Массив;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втТипыОбъектовУчета(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПВХВНА(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПВХЗатраты(НомераТаблиц));
	
	ТекстЗапросаИтог = Новый Массив;
	ТекстЗапросаИтог.Добавить(ТекстЗапроса_ПроверкаСчетаУчетаВНА());
	ТекстЗапросаИтог.Добавить(ТекстЗапроса_ПроверкаСчетаОбесценения());
	ТекстЗапросаИтог.Добавить(ТекстЗапроса_ПроверкаСчетаАмортизации());
	ТекстЗапросаИтог.Добавить(ТекстЗапроса_ПроверкаОборотныхЗатрат());
	ТекстЗапросаИтог.Добавить(ТекстЗапроса_ПроверкаОПУ());
	
	НомераТаблиц.Вставить("Проверки", НомераТаблиц.Количество());
	ТекстЗапроса.Добавить(СтрСоединить(ТекстЗапросаИтог, " ОБЪЕДИНИТЬ ВСЕ "));
	
	СхемаКомпоновкиДанных.НаборыДанных.Получить(0).Запрос 
		= СтрСоединить(ТекстЗапроса, ОбщегоНазначенияУХВызовСервера.ТекстРазделителяЗапросовПакета());
	
КонецПроцедуры
	
#Область Проверки

Функция ТекстЗапроса_ПроверкаСчетаУчетаВНА()

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ТипПроверки КАК ТипПроверки,
	|	&Предупреждение КАК Предупреждение,
	|	ИСТИНА КАК Исправить,
	|	&ВозможноеИсправление КАК ВозможноеИсправление
	|ИЗ
	|	втТипыОбъектовУчета КАК т
	|ГДЕ
	|	т.ОбъектУчета В (""ОС"", ""НМА"", ""НЗС"")
	|	И НЕ т.ОбъектУчета В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					втПВХВНА.ОбъектУчета
	|				ИЗ
	|					втПВХВНА КАК втПВХВНА
	|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.МСФО.ВидыСубконто КАК ВидыСубконтоМСФО
	|						ПО
	|							втПВХВНА.пвх = ВидыСубконтоМСФО.ВидСубконто
	|								И ВидыСубконтоМСФО.Ссылка В
	|									(ВЫБРАТЬ
	|										т.Ссылка
	|									ИЗ
	|										ПланСчетов.МСФО КАК т
	|									ГДЕ
	|										т.ПланСчетовБД = &ПланСчетовБД
	|										И т.Вид В (ЗНАЧЕНИЕ(ВидСчета.Пассивный), ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный))
	|										И т.РазделПланаСчетов В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ВнеоборотныеАктивы))))";
	
	тПараметр = " "" + т.ОбъектУчетаТип + "" ";
	
	ЗаменитьПараметр(ТекстЗапроса, "&ТипПроверки", 			НСтр("ru = 'Для каждого типа ВНА должны быть счета учета'"));
	ЗаменитьПараметр(ТекстЗапроса, "&Предупреждение", 		НСтр("ru = 'Для типа <%1> не найден счет учета'"), тПараметр);
	ЗаменитьПараметр(ТекстЗапроса, "&ВозможноеИсправление",	НСтр("ru = 'Создать активный счет с субконто <%1> с категорией счета <Внеоборотные активы>'"), тПараметр);
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапроса_ПроверкаСчетаАмортизации()

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ТипПроверки КАК ТипПроверки,
	|	&Предупреждение КАК Предупреждение,
	|	ИСТИНА КАК Исправить,
	|	&ВозможноеИсправление КАК ВозможноеИсправление
	|ИЗ
	|	втТипыОбъектовУчета КАК т
	|ГДЕ
	|	т.ОбъектУчета В (""ОС"", ""НМА"")
	|	И НЕ т.ОбъектУчета В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					втПВХВНА.ОбъектУчета
	|				ИЗ
	|					втПВХВНА КАК втПВХВНА
	|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.МСФО.ВидыСубконто КАК ВидыСубконтоМСФО
	|						ПО
	|							втПВХВНА.пвх = ВидыСубконтоМСФО.ВидСубконто
	|								И ВидыСубконтоМСФО.Ссылка В
	|									(ВЫБРАТЬ
	|										т.Ссылка
	|									ИЗ
	|										ПланСчетов.МСФО КАК т
	|									ГДЕ
	|										т.ПланСчетовБД = &ПланСчетовБД
	|										И т.Вид В (ЗНАЧЕНИЕ(ВидСчета.Пассивный), ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный))
	|										И т.РазделПланаСчетов В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ВнеоборотныеАктивы))))";                                                                               
	
	тПараметр = " "" + т.ОбъектУчетаТип + "" ";
	
	ЗаменитьПараметр(ТекстЗапроса, "&ТипПроверки", 			НСтр("ru = 'Для типов ОС и НМА должны быть счета амортизации'"));
	ЗаменитьПараметр(ТекстЗапроса, "&Предупреждение", 		НСтр("ru = 'Для типа <%1> не найден счет амортизации'"), тПараметр);
	ЗаменитьПараметр(ТекстЗапроса, "&ВозможноеИсправление",	НСтр("ru = 'Создать пассивный счет с субконто <%1> с категорией счета <Внеоборотные активы>'"), тПараметр);

	Возврат ТекстЗапроса;

КонецФункции

