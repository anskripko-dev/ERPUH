КонецФункции

Функция ТекстЗапроса_ПроверкаОборотныхЗатрат()

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&ТипПроверки КАК ТипПроверки,
	|	&Предупреждение КАК Предупреждение,
	|	ИСТИНА КАК Исправить,
	|	&ВозможноеИсправление КАК ВозможноеИсправление
	|ИЗ
	|	ПланСчетов.МСФО.ВидыСубконто КАК т
	|ГДЕ
	|	т.Ссылка.ПланСчетовБД = &ПланСчетовБД
	|	И т.ВидСубконто В
	|			(ВЫБРАТЬ
	|				т.пвх
	|			ИЗ
	|				втПВХЗатраты КАК т)
	|	И НЕ т.ТолькоОбороты";                                                                               
	
	тПараметр = " "" + т.Ссылка.Код + "" ";
	тПараметр2 = " "" + т.ВидСубконто.Наименование + "" ";
	
	ЗаменитьПараметр(ТекстЗапроса, "&ТипПроверки", 			НСтр("ru = 'Субконто с типами <Статьи затрат>, <Элементы затрат> рекомендуется делать оборотными'"));
	ЗаменитьПараметр(ТекстЗапроса, "&Предупреждение", 		НСтр("ru = 'Для счета <%1> субконто <%2> не указано <Только обороты>'"), тПараметр, тПараметр2);
	ЗаменитьПараметр(ТекстЗапроса, "&ВозможноеИсправление",	НСтр("ru = 'В счете для вида субконто указать <Только обороты>'"));
	
	Возврат ТекстЗапроса;

КонецФункции 

