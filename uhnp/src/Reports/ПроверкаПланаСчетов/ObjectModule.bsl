#Область Вспомогательные

Функция ТекстЗапроса_втТипыОбъектовУчета(НомераТаблиц)
	
	ОбъектыУчета = Новый СписокЗначений;
	ОбъектыУчета.Добавить("ДКЗ", НСтр("ru = 'Договоры контрагентов'"));
	ОбъектыУчета.Добавить("МПЗ", НСтр("ru = 'Номенклатура'"));
	ОбъектыУчета.Добавить("НГ", НСтр("ru = 'Номенклатурные группы'"));
	ОбъектыУчета.Добавить("НЗС", НСтр("ru = 'объекты строительства'"));
	ОбъектыУчета.Добавить("НМА", НСтр("ru = 'Нематериальные активы'"));
	ОбъектыУчета.Добавить("ОС", НСтр("ru = 'Основные средства'"));
	ОбъектыУчета.Добавить("ПДР", НСтр("ru = 'Прочие доходы и расходы'"));
	ОбъектыУчета.Добавить("СЗ", НСтр("ru = 'Статьи затрат'"));
	ОбъектыУчета.Добавить("ЦБ", НСтр("ru = 'Ценные бумаги'"));
	ОбъектыУчета.Добавить("ЭЗ", НСтр("ru = 'Элементы затрат'"));
	
	ТекстЗапроса = Новый Массив;
	ШаблонЗапроса = 
	"ВЫБРАТЬ
	|	""%1"" КАК ОбъектУчетаТип,
	|	""%2"" КАК ОбъектУчета";
	
	ПервыйЗапрос = Истина;
	Для каждого ОбъектУчета Из ОбъектыУчета Цикл
		
		ТекущийТекст = СтрШаблон(ШаблонЗапроса, ОбъектУчета.Представление, ОбъектУчета.Значение);
		Если ПервыйЗапрос Тогда
			ТекущийТекст = ТекущийТекст + " ПОМЕСТИТЬ втТипыОбъектовУчета";
			ПервыйЗапрос = Ложь;
		КонецЕсли;
		ТекстЗапроса.Добавить(ТекущийТекст);
		
	КонецЦикла;
	
	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ");

КонецФункции

Функция ТекстЗапроса_втПВХВНА(НомераТаблиц)

	Возврат 
	"ВЫБРАТЬ
	|	т.Ссылка КАК пвх,
	|	ВЫБОР
	|		КОГДА т.ПредставлениеТипа ПОДОБНО ""%Справочник.ОсновныеСредства%""
	|			ТОГДА ""ОС""
	|		КОГДА т.ПредставлениеТипа ПОДОБНО ""%Справочник.НематериальныеАктивы%""
	|			ТОГДА ""НМА""
	|		КОГДА т.ПредставлениеТипа ПОДОБНО ""%Справочник.ОбъектыСтроительства%""
	|			ТОГДА ""НЗС""
	|		КОГДА т.ПредставлениеТипа ПОДОБНО ""%Справочник.Номенклатура%""
	|			ТОГДА ""МПЗ""
	|	КОНЕЦ КАК ОбъектУчета
	|ПОМЕСТИТЬ втПВХВНА
	|ИЗ
	|	ПланВидовХарактеристик.ВидыСубконтоКорпоративные КАК т
	|ГДЕ
	|	(т.ПредставлениеТипа ПОДОБНО ""%Справочник.ОсновныеСредства%""
	|			ИЛИ т.ПредставлениеТипа ПОДОБНО ""%Справочник.НематериальныеАктивы%""
	|			ИЛИ т.ПредставлениеТипа ПОДОБНО ""%Справочник.НезавершенноеСтроительство%""
	|			ИЛИ т.ПредставлениеТипа ПОДОБНО ""%Справочник.Номенклатура%"")";

КонецФункции

Функция ТекстЗапроса_втПВХЗатраты(НомераТаблиц)

	Возврат 
	"ВЫБРАТЬ
	|	т.Ссылка КАК пвх,
	|	ВЫБОР
	|		КОГДА т.ПредставлениеТипа ПОДОБНО ""%Справочник.СтатьиЗатрат%""
	|			ТОГДА ""ОС""
	|		КОГДА т.ПредставлениеТипа ПОДОБНО ""%Перечисление.ЭлементыЗатрат%""
	|			ТОГДА ""НМА""
	|	КОНЕЦ КАК ОбъектУчета
	|ПОМЕСТИТЬ втПВХЗатраты
	|ИЗ
	|	ПланВидовХарактеристик.ВидыСубконтоКорпоративные КАК т
	|ГДЕ
	|	(т.ПредставлениеТипа ПОДОБНО ""%Справочник.СтатьиЗатрат%""
	|			ИЛИ т.ПредставлениеТипа ПОДОБНО ""%Перечисление.ЭлементыЗатрат%"")";

КонецФункции

Процедура ЗаменитьПараметр(ТекстЗапроса, ЧтоЗаменить, НаЧтоЗаменить, ПараметрЗамены = Неопределено, ПараметрЗамены2 = Неопределено)

	Если ПараметрЗамены = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЧтоЗаменить, """" + НаЧтоЗаменить + """");
	ИначеЕсли  ПараметрЗамены2 = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЧтоЗаменить, СтрШаблон("""" + НаЧтоЗаменить + """", ПараметрЗамены));
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЧтоЗаменить, СтрШаблон("""" + НаЧтоЗаменить + """", ПараметрЗамены, ПараметрЗамены2));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
