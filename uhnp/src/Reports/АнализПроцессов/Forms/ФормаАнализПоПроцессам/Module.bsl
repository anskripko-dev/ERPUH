// Возвращает цвет из таблицы градаций ТаблицаГрадацийВход по значению КоэффициентВход.
&НаСервереБезКонтекста
Функция ПолучитьЦветИзТаблицыГрадаций(ТаблицаГрадацийВход, КоэффициентВход)
	РезультатФункции = Новый Цвет(127, 127, 127);
	Для Каждого ТекТаблицаГрадацийВход Из ТаблицаГрадацийВход Цикл
		Если (ТекТаблицаГрадацийВход.МинимальноеЗначение <= КоэффициентВход) И (ТекТаблицаГрадацийВход.МаксимальноеЗначение > КоэффициентВход) Тогда
			РезультатФункции = ТекТаблицаГрадацийВход.Цвет;
			Прервать;
		Иначе
			// Продолжаем поиск.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьЦветИзТаблицыГрадаций()

// Получает цвет для этапа с длительностью ДлительностьЭтапаВход, согласно таблице градаций
// цветов ТаблицаГрадацийВход
&НаСервереБезКонтекста
Функция ВычислитьЦветФонаЭтапа(КорридорРазбросаВход, МинимальноеЗначениеВход, ТаблицаГрадацийВход, ДлительностьЭтапаВход)
	РезультатФункции = Новый Цвет(127, 127, 127);
	// Определение коэффициента и итогового цвета.
	Если КорридорРазбросаВход <> 0 Тогда
		Коэффициент = (ДлительностьЭтапаВход - МинимальноеЗначениеВход) / КорридорРазбросаВход;
	Иначе
		Коэффициент = 0;
	КонецЕсли;
	РезультатФункции = ПолучитьЦветИзТаблицыГрадаций(ТаблицаГрадацийВход, Коэффициент);
	Возврат РезультатФункции;
КонецФункции		// ВычислитьЦветФонаЭтапа()

// Формирует табличный документ вывода этапов и возвращает его.
&НаСервере
Функция ПолучитьТабДокДиаграммаЭтапов(Этапы, Уровни)
	РезультатФункции = Новый ТабличныйДокумент;
	ЭкземплярПроцесса = Документы.ЭкземплярПроцесса.ПустаяСсылка();
	СоответствиеРисунковИЭтапов.Очистить();
	РезультатФункции = МодульУправленияПроцессамиУХ.ВывестиДиаграммуЭтапов(Этапы, Уровни, СоответствиеРисунковИЭтапов, ЭкземплярПроцесса);
	Возврат РезультатФункции;
КонецФункции		// ПолучитьТабДокДиаграммаЭтапов()

// Возвращает таблицу вывода этапов по шаблону процесса ШаблонаПроцессаВход.
// В параметр Уровни будут записаны данные по координатам этапов.
&НаСервере
Функция ПолучитьТаблицуЭтапов(ШаблонаПроцессаВход, Уровни)
	РезультатФункции = Неопределено;
	// Формирование таблицы Линейная связь.
	ТабличноеПоле_ЛинейнаяСвязь = Новый ТаблицаЗначений;
	ТабличноеПоле_ЛинейнаяСвязь.Колонки.Добавить("ЭтапПроцесса");
	// Формирование таблицы Начальных настроек.
	ТабличноеПолеНачальныхНастроек = Новый ТаблицаЗначений;
	ТабличноеПолеНачальныхНастроек.Колонки.Добавить("ВидУсловия");
	ТабличноеПолеНачальныхНастроек.Колонки.Добавить("Условие");
	ТабличноеПолеНачальныхНастроек.Колонки.Добавить("Значение");
	ТабличноеПолеНачальныхНастроек.Колонки.Добавить("ПредставлениеУсловия");
	// Непосредственное получение таблицы этапов.
	РезультатФункции = МодульУправленияПроцессамиУХ.ПолучитьТаблицуЭтапов(ШаблонаПроцессаВход, Уровни, ТабличноеПоле_ЛинейнаяСвязь, ТабличноеПолеНачальныхНастроек);
	Возврат РезультатФункции;
КонецФункции		// ПолучитьТаблицуЭтапов()	

// Возвращает пустую таблицу анализа.
&НаСервереБезКонтекста
Функция СформироватьПустуюТаблицуАнализа()
	РезультатФункции = Новый ТаблицаЗначений;
	РезультатФункции.Колонки.Добавить("ДлительностьКоличество");
	РезультатФункции.Колонки.Добавить("ДлительностьСумма");
	РезультатФункции.Колонки.Добавить("ДлительностьПлановая");
	РезультатФункции.Колонки.Добавить("ОтклонениеОтПлана");
	РезультатФункции.Колонки.Добавить("ПроцентОтклонения");
	РезультатФункции.Колонки.Добавить("ЭтапПроцесса");
	РезультатФункции.Колонки.Добавить("КоличествоОтклонений");
	Возврат РезультатФункции;
КонецФункции		// СформироватьПустуюТаблицуАнализа()

// Возвращает максимальное значение в колонке НаименованиеКолонкиВход
// таблицы ТаблицаВход.
&НаСервереБезКонтекста
Функция МаксимумПоКолонке(ТаблицаВход, НаименованиеКолонкиВход, ЗначениеЗаменыВход = -999999)
	РезультатФункции = -999999;
	МаксимумНайден = Ложь;
	Попытка
		Для Каждого ТекТаблицаВход Из ТаблицаВход Цикл
			ТекЗначениеКолонки = ТекТаблицаВход[НаименованиеКолонкиВход];
			Если ТекЗначениеКолонки > РезультатФункции Тогда
				РезультатФункции = ТекЗначениеКолонки;
				МаксимумНайден = Истина;
			Иначе
				// Выполняем поиск далее.
			КонецЕсли;
		КонецЦикла;
	Исключение
		ТекстСообщения = НСтр("ru = 'При нахождении максимума в таблице %Таблица% по колонке %НаименованиеКолонки% произошли ошибки: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Таблица%", Строка(ТаблицаВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НаименованиеКолонки%", Строка(НаименованиеКолонкиВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки;
	Если Не МаксимумНайден Тогда
		РезультатФункции = ЗначениеЗаменыВход;
	Иначе
		// Не изменяем максимум.
	КонецЕсли;	
	Возврат РезультатФункции;
КонецФункции		// МаксимумПоКолонке()

// Возвращает копию таблицы анализа ТаблицаАнализВход, в которой исключены строки с этапами, 
//выполняемые системой без участия пользователя. 
&НаСервере
Функция ИсключитьАвтоЭтапы(ТаблицаАнализВход)
	// Инициализация.
	РезультатФункции = ТаблицаАнализВход.СкопироватьКолонки();
	ИсключаемыеТипыЭтапов = Новый Массив;
	ИсключаемыеТипыЭтапов.Добавить(Перечисления.ТипыЭтаповУниверсальныхПроцессов.Автоотклонение);
	ИсключаемыеТипыЭтапов.Добавить(Перечисления.ТипыЭтаповУниверсальныхПроцессов.Автоутверждение);
	ИсключаемыеТипыЭтапов.Добавить(Перечисления.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход);
	Для Каждого ТекТаблицаАнализВход Из ТаблицаАнализВход Цикл
		// Определим возможность переноса этапа.
		ТекЭтап = ТекТаблицаАнализВход.ЭтапПроцесса;
		МожноДобавлять = Истина;
		Если ЗначениеЗаполнено(ТекЭтап) Тогда
			ТекТипЭтапа = ТекЭтап.ТипЭтапа;
			МожноДобавлять = (ИсключаемыеТипыЭтапов.Найти(ТекТипЭтапа) = Неопределено);
		Иначе
			МожноДобавлять = Истина;
		КонецЕсли;
		// Добавим строку в таблицу.
		Если МожноДобавлять Тогда
			НоваяСтрока = РезультатФункции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекТаблицаАнализВход);
		Иначе
			// Пропускаем строку анализа.
		КонецЕсли;
	КонецЦикла;	
	// Возврат результата.
	Возврат РезультатФункции;		
КонецФункции		// ИсключитьАвтоЭтапы(ЭтапПроцесса)

// Выполняет анализ таблицы ТаблицаИсходныхДанныхВход и возвращает структуру
// данных анализа по метрике МетрикаВход. Когда параметр БезАвтоЭтаповВход, из
// анализа будут исключены этапы, выполняемые системой без участия пользователя.
&НаСервере
Функция ПроанализироватьТаблицуИсходныхДанных(ТаблицаИсходныхДанныхВход, МетрикаВход, БезАвтоЭтаповВход = Ложь)
	// Инициализация.
	РезультатФункции = Новый Структура;
	ТаблицаАнализ = СформироватьПустуюТаблицуАнализа();
	Если ТипЗнч(ТаблицаИсходныхДанныхВход) = Тип("ТаблицаЗначений") Тогда
		ТаблицаАнализ = ТаблицаИсходныхДанныхВход.Скопировать();
	ИначеЕсли ТипЗнч(ТаблицаИсходныхДанныхВход) = Тип("ДанныеФормыКоллекция")  Тогда
		ТаблицаАнализ = ТаблицаИсходныхДанныхВход.Выгрузить();
	ИначеЕсли ТипЗнч(ТаблицаИсходныхДанныхВход) = Тип("Массив")	Тогда
		Для Каждого ТекТаблицаИсходныхДанныхВход Из ТаблицаИсходныхДанныхВход Цикл
			НоваяСтрока = ТаблицаАнализ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекТаблицаИсходныхДанныхВход);
		КонецЦикла;
	Иначе
		ТаблицаАнализ = СформироватьПустуюТаблицуАнализа();
		ТекстСообщения = НСтр("ru = 'Неизвестный вариант таблицы исходных данных для анализа: %Таблица%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Таблица%", Строка(ТаблицаИсходныхДанныхВход));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли; 
	// Свёртка и отбор автоэтапов.
	ТаблицаАнализ.Свернуть("ЭтапПроцесса, ДлительностьПлановая", "ДлительностьСумма, ДлительностьКоличество, КоличествоОтклонений");
	ТребуетсяИсключитьАвтоЭтапы = (БезАвтоЭтаповВход) И (МетрикаВход <> Перечисления.МетрикиАнализаПроцессов.КоличествоВыполнений);
	Если ТребуетсяИсключитьАвтоЭтапы Тогда
		ТаблицаАнализ = ИсключитьАвтоЭтапы(ТаблицаАнализ);
	Иначе
		// Для метрики Количество выполнения, а также, когда отбор не требуется, оставляем авто этапы.
	КонецЕсли;
	// Заполнение дополнительных полей.
	ТаблицаАнализ.Колонки.Добавить("ДлительностьСредняя");
	ТаблицаАнализ.Колонки.Добавить("ОтклонениеОтПлана");
	ТаблицаАнализ.Колонки.Добавить("ПроцентОтклонения");
	Для Каждого ТекТаблицаАнализ Из ТаблицаАнализ Цикл
		// Средняя длительность.
		Если ТекТаблицаАнализ.ДлительностьКоличество <> 0 Тогда
			ТекТаблицаАнализ.ДлительностьСредняя = ТекТаблицаАнализ.ДлительностьСумма / ТекТаблицаАнализ.ДлительностьКоличество;
		Иначе
			ТекТаблицаАнализ.ДлительностьСредняя = 0;
		КонецЕсли;
		// Отклонение от плана.
		Если ТекТаблицаАнализ.ДлительностьПлановая <> 0 Тогда
			ТекТаблицаАнализ.ОтклонениеОтПлана = ТекТаблицаАнализ.ДлительностьСредняя - ТекТаблицаАнализ.ДлительностьПлановая;
		Иначе
			ТекТаблицаАнализ.ОтклонениеОтПлана = 0;
		КонецЕсли;
		// Процент отклонения.
		Если ТекТаблицаАнализ.ДлительностьПлановая <> 0 Тогда
			ТекТаблицаАнализ.ПроцентОтклонения = Окр(100*(ТекТаблицаАнализ.ДлительностьСредняя - ТекТаблицаАнализ.ДлительностьПлановая)/ТекТаблицаАнализ.ДлительностьПлановая, 2);
		Иначе
			ТекТаблицаАнализ.ПроцентОтклонения = 0;
		КонецЕсли;
	КонецЦикла;
	// Вычисление максимального и минимального значения.
	РезультатФункции = ПолучитьСтатистикуВыполненияПоМетрике(ТаблицаАнализ, МетрикаВход);
	РезультатФункции.Вставить("ТаблицаАнализ", ТаблицаАнализ);
	// Добавление дополнительной статистики.
	ИтогДлительностьСумма = ТаблицаАнализ.Итог("ДлительностьСумма");
	ИтогКоличество = ТаблицаАнализ.Итог("ДлительностьКоличество");
	ОбщаяСредняяДлительность = 0;
	Если ИтогКоличество <> 0 Тогда
		ОбщаяСредняяДлительность = ИтогДлительностьСумма / ИтогКоличество;
	Иначе
		ОбщаяСредняяДлительность = 0;
	КонецЕсли;	
	РезультатФункции.Вставить("ОбщаяСредняяДлительность", ОбщаяСредняяДлительность);
	ИтогДлительностьКоличество = ТаблицаАнализ.Итог("ДлительностьКоличество");
	РезультатФункции.Вставить("ОбщаяДлительностьКоличество", ИтогДлительностьКоличество);
	МаксимальнаяПлановаяДлительность = МаксимумПоКолонке(ТаблицаАнализ, "ДлительностьПлановая", 0);
	РезультатФункции.Вставить("ПлановаяДлительностьМакс", МаксимальнаяПлановаяДлительность);
	МаксимальноеОтклонениеОтПлана = МаксимумПоКолонке(ТаблицаАнализ, "ОтклонениеОтПлана", 0);
	РезультатФункции.Вставить("ОбщееОтклонениеОтПлана", МаксимальноеОтклонениеОтПлана);
	МаксимальныйПроцентОтклоенияОтПлана = МаксимумПоКолонке(ТаблицаАнализ, "ПроцентОтклонения", 0);
	РезультатФункции.Вставить("ОбщийПроцентОтклонения", МаксимальныйПроцентОтклоенияОтПлана);
	КоличествоОтклонений = ТаблицаАнализ.Итог("КоличествоОтклонений");
	РезультатФункции.Вставить("ОбщееКоличествоОтклонений", КоличествоОтклонений);
	Возврат РезультатФункции;
КонецФункции		// ПроанализироватьТаблицуИсходныхДанных()

// Возвращает структуру отбранных данных из таблицы исходных данных для этапа ЭтапВход.
&НаСервере
Функция ПолучитьСтруктуруДанныхЭтапа(ЭтапВход, МетрикаВход)
	РезультатФункции = Новый Структура;
	ТаблицаВрем = ТаблицаИсходныеДанные.Выгрузить();
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ЭтапПроцесса", ЭтапВход);
	НайденныеСтроки = ТаблицаВрем.НайтиСтроки(СтруктураПоиска);
	РезультатФункции = ПроанализироватьТаблицуИсходныхДанных(НайденныеСтроки, МетрикаВход);
	Возврат РезультатФункции;
КонецФункции		// ПолучитьСтруктуруДанныхЭтапа()

// Выводит данные анализа по этапу ЭтапВход в подвал.
&НаСервере
Процедура ВывестиДанныеПоЭтапуВПодвал(ЭтапВход, МетрикаВход)
	// Исходные данные.
	СтруктураДанныхЭтапа = ПолучитьСтруктуруДанныхЭтапа(ЭтапВход, МетрикаВход);
	// Средняя длительность.
	ОтображениеДлительностьСредняя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбщаяСредняяДлительность", 0);
	ПредставлениеДлительностьСредняя = ПреобразоватьСекундыВСтроку(ОтображениеДлительностьСредняя);
	// Количество выполнения.
	ОтображениеКоличествоВыполнения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбщаяДлительностьКоличество", 0);
	// Плановая длительность.
	ОтображениеПлановаяДлительностьМакс = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ПлановаяДлительностьМакс", 0);
	ПредставлениеПлановаяДлительность = ПреобразоватьСекундыВСтроку(ОтображениеПлановаяДлительностьМакс);
	// Отклонение от плана.
	ОтображениеОтклонениеОтПланаСумма = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбщееОтклонениеОтПлана", 0);
	ПредставлениеОтклонениеОтПлана = ПреобразоватьСекундыВСтроку(ОтображениеОтклонениеОтПланаСумма);
	// Процент отклонения.
	ОтображениеПроцентОтклонения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбщийПроцентОтклонения", 0);
	ПредставлениеПроцентОтклонения = Строка(ОтображениеПроцентОтклонения) + "%";
	// Количество отклонений.
	ПредставлениеКоличествоОтклонений = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхЭтапа, "ОбщееКоличествоОтклонений", 0);	
	// Обновление формы.
	УправлениеДоступностью();
КонецПроцедуры		// ВывестиДанныеПоЭтапуВПодвал()

// Возвращает значение метрики МетрикаВход из строки таблицы СтрокаТаблицыВход.
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЗначениеМетрикиВСтрокеТаблицы(СтрокаТаблицыВход, МетрикаВход)
	РезультатФункции = 0;
	Если МетрикаВход = ПредопределенноеЗначение("Перечисление.МетрикиАнализаПроцессов.ДлительностьСредняя") Тогда
		РезультатФункции = СтрокаТаблицыВход.ДлительностьСредняя;
	ИначеЕсли МетрикаВход = ПредопределенноеЗначение("Перечисление.МетрикиАнализаПроцессов.КоличествоВыполнений") Тогда
		РезультатФункции = СтрокаТаблицыВход.ДлительностьКоличество;
	ИначеЕсли МетрикаВход = ПредопределенноеЗначение("Перечисление.МетрикиАнализаПроцессов.ДлительностьПлановая") Тогда
		РезультатФункции = СтрокаТаблицыВход.ДлительностьПлановая;
	ИначеЕсли МетрикаВход = ПредопределенноеЗначение("Перечисление.МетрикиАнализаПроцессов.ОтклнениеОтПланаСумма") Тогда
		РезультатФункции = СтрокаТаблицыВход.ОтклонениеОтПлана;		
	ИначеЕсли МетрикаВход = ПредопределенноеЗначение("Перечисление.МетрикиАнализаПроцессов.ПроцентОтклонения") Тогда
		РезультатФункции = СтрокаТаблицыВход.ПроцентОтклонения;		
	ИначеЕсли МетрикаВход = ПредопределенноеЗначение("Перечисление.МетрикиАнализаПроцессов.КоличествоОтклонений") Тогда
		РезультатФункции = СтрокаТаблицыВход.КоличествоОтклонений;		
	ИначеЕсли Не ЗначениеЗаполнено(МетрикаВход) Тогда
		РезультатФункции = СтрокаТаблицыВход.ДлительностьСредняя;		// По умолчанию будем считать среднюю длительность.
	Иначе
		РезультатФункции = 0;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьЗначениеМетрикиВСтрокеТаблицы()

// По таблице анализа ТаблицаАнализаВход возвращает структуру статистики
// для метрики МетрикаВход.
&НаСервереБезКонтекста
Функция ПолучитьСтатистикуВыполненияПоМетрике(ТаблицаАнализаВход, МетрикаВход)
	РезультатФункции = Новый Структура;
	// Получим минимальные и максимальные значения по таблице.
	МинимальноеЗначениеМетрики = 9999999;
	МинимальноеНайдено = Ложь;
	МаксимальноеЗначениеМетрики = -9999999;
	МаксимальноеНайдено = Ложь;
	КорридорРазброса = 0;
	Для Каждого ТекТаблицаАнализ Из ТаблицаАнализаВход Цикл
		// Определим текущее значение метрики.
		ТекЗначениеМетрики = ПолучитьЗначениеМетрикиВСтрокеТаблицы(ТекТаблицаАнализ, МетрикаВход);
		// Сравним текущее значение метрики с максимальным и минимальным.
		Если ТекЗначениеМетрики < МинимальноеЗначениеМетрики Тогда
			МинимальноеЗначениеМетрики = ТекЗначениеМетрики;
			МинимальноеНайдено = Истина;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
		Если ТекЗначениеМетрики > МаксимальноеЗначениеМетрики Тогда
			МаксимальноеЗначениеМетрики = ТекЗначениеМетрики;
			МаксимальноеНайдено = Истина;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
	// Сформируем итоговую структуру.
	Если (МинимальноеНайдено И МаксимальноеНайдено) Тогда
		КорридорРазброса = МаксимальноеЗначениеМетрики - МинимальноеЗначениеМетрики;
	Иначе
		МаксимальноеЗначениеМетрики = 0;
		МинимальноеЗначениеМетрики = 0;
		КорридорРазброса = 0;
	КонецЕсли;
	РезультатФункции.Вставить("МинимальноеЗначение", МинимальноеЗначениеМетрики);
	РезультатФункции.Вставить("МаксимальноеЗначениеМетрики", МаксимальноеЗначениеМетрики);
	РезультатФункции.Вставить("КорридорРазброса", КорридорРазброса);
	Возврат РезультатФункции;
КонецФункции		// ПолучитьСтатистикуВыполненияПоМетрике()
	
// Добавляет в таблицу ТаблицаКоличестваПереходовВход процент количества переходов на кажду ветку.
&НаСервереБезКонтекста
Процедура РассчитатьПроцентКоличестваПереходов(ТаблицаКоличестваПереходовВход)
	ТаблицаКоличестваПереходовВход.Колонки.Добавить("ПроцентПереходов");
	МассивПредшественников = ТаблицаКоличестваПереходовВход.ВыгрузитьКолонку("ЭтапПредшественник");
	МассивПредшественников = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПредшественников);
	МассивПредшественников = ОбщегоНазначенияКлиентСерверУХ.УдалитьПустыеЭлементыМассива(МассивПредшественников);
	Для Каждого ТекМассивПредшественников Из МассивПредшественников Цикл
		// Определение общей суммы переходов по предшественнику.
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ЭтапПредшественник", ТекМассивПредшественников);
		НайденныеСтроки = ТаблицаКоличестваПереходовВход.НайтиСтроки(СтруктураПоиска);
		ОбщееКоличествоПереходов = 0;
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			ОбщееКоличествоПереходов = ОбщееКоличествоПереходов + ТекНайденныеСтроки.КоличествоПереходов;
		КонецЦикла;
		// Вычисление процента для каждого последователя с использование общей суммы по предшественнику.
		Для Каждого ТекТаблицаКоличестваПереходовВход Из ТаблицаКоличестваПереходовВход Цикл
			Если ТекТаблицаКоличестваПереходовВход.ЭтапПредшественник = ТекМассивПредшественников Тогда
				Если ОбщееКоличествоПереходов <> 0 Тогда
					ТекТаблицаКоличестваПереходовВход.ПроцентПереходов = 100 * ТекТаблицаКоличестваПереходовВход.КоличествоПереходов / ОбщееКоличествоПереходов;
				Иначе	
					ТекТаблицаКоличестваПереходовВход.ПроцентПереходов = 0;
				КонецЕсли;
			Иначе
				Продолжить;		// Другой этап предшественник. Ищем далее.
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры		// РассчитатьПроцентКоличестваПереходов()

// Устанавливает ширину линий перехода в таблицах вывода этапов Этапы согласно
// данным количества переходов ТаблицаКоличестваПереходовВход.
&НаСервереБезКонтекста
Процедура УстановитьШиринуЛинийПереходов(Этапы, ТаблицаКоличестваПереходовВход)
	// Получим соответствие данных о коридоре для каждого этапа предшественника.
	МассивПредшественников = ТаблицаКоличестваПереходовВход.ВыгрузитьКолонку("ЭтапПредшественник");
	МассивПредшественников = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПредшественников);
	МассивПредшественников = ОбщегоНазначенияКлиентСерверУХ.УдалитьПустыеЭлементыМассива(МассивПредшественников);
	СоответствиеДанныхСтатистикиПредшественника = Новый Соответствие;
	Для Каждого ТекМассивПредшественников Из МассивПредшественников Цикл
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ЭтапПредшественник", ТекМассивПредшественников);
		НайденныеСтроки = ТаблицаКоличестваПереходовВход.НайтиСтроки(СтруктураПоиска);
		СтруктураДанныхЭтапа = Новый Структура;
		Если НайденныеСтроки.Количество() > 0 Тогда
			МинимальноеЗначение = 999999;
			МаксимальноеЗначение = -999999;
			Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
				ТекКоличествоПереходов = ТекНайденныеСтроки.КоличествоПереходов;
				Если ТекКоличествоПереходов > МаксимальноеЗначение Тогда
					МаксимальноеЗначение = ТекКоличествоПереходов;
				Иначе
					// Выполянем далее.
				КонецЕсли;
				Если ТекКоличествоПереходов < МинимальноеЗначение Тогда
					МинимальноеЗначение = ТекКоличествоПереходов;
				Иначе
					// Выполянем далее.
				КонецЕсли;
			КонецЦикла;
			Коридор = МаксимальноеЗначение - МинимальноеЗначение;
			СтруктураДанныхЭтапа.Вставить("МинимальноеЗначение", МинимальноеЗначение);
			СтруктураДанныхЭтапа.Вставить("МаксимальноеЗначение", МаксимальноеЗначение);
			СтруктураДанныхЭтапа.Вставить("Коридор", Коридор);
			СтруктураДанныхЭтапа.Вставить("СреднееЗначение", МинимальноеЗначение + Коридор/2);
		Иначе
			СтруктураДанныхЭтапа.Вставить("МинимальноеЗначение", 0);
			СтруктураДанныхЭтапа.Вставить("МаксимальноеЗначение", 0);
			СтруктураДанныхЭтапа.Вставить("Коридор", 0);
			СтруктураДанныхЭтапа.Вставить("СреднееЗначение", 0);
		КонецЕсли;
		СоответствиеДанныхСтатистикиПредшественника.Вставить(ТекМассивПредшественников, СтруктураДанныхЭтапа);
	КонецЦикла;
	// Обойдём таблицу и добавим толщину линий, согласно статистике.
	ТаблицаКоличестваПереходовВход.Колонки.Добавить("ТолщинаЛинии");
	Для Каждого ТекТаблицаКоличестваПереходовВход Из ТаблицаКоличестваПереходовВход Цикл
		ТекПредшественник = ТекТаблицаКоличестваПереходовВход.ЭтапПредшественник;
		ДанныеПредшественника = СоответствиеДанныхСтатистикиПредшественника.Получить(ТекПредшественник);
		Если ДанныеПредшественника <> Неопределено Тогда
			ТекКоридор = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПредшественника, "Коридор", 0);
			Если ТекКоридор <> 0 Тогда
				ТекСреднее = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПредшественника, "СреднееЗначение", 0);
				Если ТекСреднее < ТекТаблицаКоличестваПереходовВход.КоличествоПереходов Тогда
					ТекТаблицаКоличестваПереходовВход.ТолщинаЛинии = 3;
				Иначе
					ТекТаблицаКоличестваПереходовВход.ТолщинаЛинии = 0;
				КонецЕсли;
			Иначе
				ТекТаблицаКоличестваПереходовВход.ТолщинаЛинии = 0;		// Нулевой коридор, все значения совпадают.
			КонецЕсли;
		Иначе
			ТекТаблицаКоличестваПереходовВход.ТолщинаЛинии = 0;		// Нет исходных данных.
		КонецЕсли;
	КонецЦикла;
	ТаблицаКоличестваПереходовВход.Свернуть("ТолщинаЛинии, ЭтапПредшественник, ЭтапПриемник, ПроцентПереходов");
	// Расставим получившуюся ширину в таблицу Этапы.
	Для Каждого ТекЭтапы Из Этапы Цикл
		ТекЭтапы.ЭтапыПредшественники.Колонки.Добавить("ТолщинаЛинии");
		ТекЭтапы.ЭтапыПредшественники.Колонки.Добавить("ПодписьЛинии");
		ТекЭтапПоследователь = ТекЭтапы.Этап;
		Для Каждого ТекЭтапыПредшественники Из ТекЭтапы.ЭтапыПредшественники Цикл
			ТекЭтапПрредшественник = ТекЭтапыПредшественники.ЭтапПроцесса;
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ЭтапПредшественник", ТекЭтапПрредшественник);
			СтруктураПоиска.Вставить("ЭтапПриемник", ТекЭтапПоследователь);
			НайденныеСтроки = ТаблицаКоличестваПереходовВход.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ПерваяСтрока = НайденныеСтроки[0];
				ТекЭтапыПредшественники.ТолщинаЛинии = ПерваяСтрока.ТолщинаЛинии;
				ТекЭтапыПредшественники.ПодписьЛинии = Строка(Цел(ПерваяСтрока.ПроцентПереходов)) + "%";
			Иначе
				// Строка не найдена. Пропускаем.
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры		// УстановитьШиринуЛинийПереходов()

// Преобразует данные времени в таблице ТаблицаРазвернутыеДанныеВход в соответствии
// с периодичностью ПериодичностьВход.
&НаСервереБезКонтекста
Функция ПреобразоватьПериодичностьВРазвернутыхДанных(ТаблицаРазвернутыеДанныеВход, ПериодичностьВход)
	РезультатФункции = ТаблицаРазвернутыеДанныеВход.Скопировать();
	Для Каждого ТекРезультатФункции Из РезультатФункции Цикл
		ТекРезультатФункции.ДлительностьМаксимум	 = УправлениеПроцессамиСогласованияУХ.ПреобразоватьВремяПоПериодичности(ТекРезультатФункции.ДлительностьМаксимум, ПериодичностьВход);
		ТекРезультатФункции.ДлительностьМинимум		 = УправлениеПроцессамиСогласованияУХ.ПреобразоватьВремяПоПериодичности(ТекРезультатФункции.ДлительностьМинимум, ПериодичностьВход);
		ТекРезультатФункции.ДлительностьПлановая	 = УправлениеПроцессамиСогласованияУХ.ПреобразоватьВремяПоПериодичности(ТекРезультатФункции.ДлительностьПлановая, ПериодичностьВход);
		ТекРезультатФункции.ДлительностьСредняя		 = УправлениеПроцессамиСогласованияУХ.ПреобразоватьВремяПоПериодичности(ТекРезультатФункции.ДлительностьСредняя, ПериодичностьВход);
		ТекРезультатФункции.ДлительностьСумма		 = УправлениеПроцессамиСогласованияУХ.ПреобразоватьВремяПоПериодичности(ТекРезультатФункции.ДлительностьСумма, ПериодичностьВход);
		ТекРезультатФункции.ОтклонениеОтПлана		 = УправлениеПроцессамиСогласованияУХ.ПреобразоватьВремяПоПериодичности(ТекРезультатФункции.ОтклонениеОтПлана, ПериодичностьВход);
	КонецЦикла;	
	Возврат РезультатФункции;
КонецФункции		// ПреобразоватьПериодичностьВРазвернутыхДанных()	

// Обновялет диаграмму этапов на форме по данным таблицы ТаблицаРазвернутыеДанныеВход.
// Возвращает успешность выполнения.
&НаСервере
Функция ВывестиДиаграммуЭтапов(ТаблицаРазвернутыеДанныеВход)
	РезультатФункции = Истина;
	Попытка
		МетрикаРабочая = Перечисления.МетрикиАнализаПроцессов.ДлительностьСредняя;
		Если ЗначениеЗаполнено(Метрика) Тогда
			МетрикаРабочая = Метрика;
		Иначе
			МетрикаРабочая = Перечисления.МетрикиАнализаПроцессов.ДлительностьСредняя;
		КонецЕсли;
		ТаблицаИсходныеДанные.Загрузить(ТаблицаРазвернутыеДанныеВход);
		// Считывание данных перехода.
		ТаблицаКоличестваПереходов = ПолучитьТаблицуКоличестваПереходов(Объект.ШаблонПроцесса, Объект.ДатаНачалаАнализа, Объект.ДатаОкончанияАнализа, ОтборОрганизация);
		РассчитатьПроцентКоличестваПереходов(ТаблицаКоличестваПереходов);
		// Преобразование исходных данных.
		СтруктураСтатистикиМетрики = ПроанализироватьТаблицуИсходныхДанных(ТаблицаИсходныеДанные, МетрикаРабочая, Истина);
		МинимальноеЗначение		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСтатистикиМетрики, "МинимальноеЗначение", 0);
		МаксимальноеЗначение	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСтатистикиМетрики, "МаксимальноеЗначение", 0);
		КорридорРазброса		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСтатистикиМетрики, "КорридорРазброса", 0);
		ТаблицаАнализ			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСтатистикиМетрики, "ТаблицаАнализ", Новый ТаблицаЗначений);
		// Вывод результата.
		Уровни = Неопределено;
		Этапы = ПолучитьТаблицуЭтапов(Объект.ШаблонПроцесса, Уровни);
		// Раскрашивание этапов.
		Этапы.Колонки.Добавить("ЦветФона");
		Этапы.Колонки.Добавить("ДополнительнаяПодпись");
		ТаблицаГрадаций = СформироватьТаблицуГрадаций();
		ЭтоМетрикаОтклонениеОтПлана		 = (МетрикаРабочая = Перечисления.МетрикиАнализаПроцессов.ОтклнениеОтПланаСумма);
		ЭтоМетрикаДлительностьПлановая	 = (МетрикаРабочая = Перечисления.МетрикиАнализаПроцессов.ДлительностьПлановая);
		ЭтоМетрикаДлительностьСредняя	 = (МетрикаРабочая = Перечисления.МетрикиАнализаПроцессов.ДлительностьСредняя);
		ЭтоМетрикаСоВременем = (ЭтоМетрикаОтклонениеОтПлана ИЛИ ЭтоМетрикаДлительностьПлановая ИЛИ ЭтоМетрикаДлительностьСредняя);
		Для Каждого ТекЭтапы Из Этапы Цикл
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ЭтапПроцесса", ТекЭтапы.Этап);
			НайденныеСтроки = ТаблицаАнализ.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ПерваяСтрока = НайденныеСтроки[0];
				ТекЗначениеМетрики = ПолучитьЗначениеМетрикиВСтрокеТаблицы(ПерваяСтрока, МетрикаРабочая);
				ТекЭтапы.ЦветФона				 = ВычислитьЦветФонаЭтапа(КорридорРазброса, МинимальноеЗначение, ТаблицаГрадаций, ТекЗначениеМетрики);
				// Установка текста дополнительной подписи.
				ТекстДополнительнойПодписи = "";
				Если ЭтоМетрикаСоВременем Тогда
					ТекстДополнительнойПодписи = "(" + ПреобразоватьСекундыВСтроку(ТекЗначениеМетрики) + ")";
				Иначе
					ТекстДополнительнойПодписи = "(" + Строка(ТекЗначениеМетрики) + ")";
				КонецЕсли;
				ТекЭтапы.ДополнительнаяПодпись	 = ТекстДополнительнойПодписи;
			Иначе
				ТекЭтапы.ЦветФона = Неопределено;		// Оставляем фон по умолчанию.
			КонецЕсли;
		КонецЦикла;
		// Установка толщины линий.
		УстановитьШиринуЛинийПереходов(Этапы, ТаблицаКоличестваПереходов);
		// Вывод результата.
		ТабДокРезультат = ПолучитьТабДокДиаграммаЭтапов(Этапы, Уровни);
	Исключение
		ТекстСообщения = НСтр("ru = 'При выводе диаграммы этапов возники ошибки: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		РезультатФункции = Ложь;
	КонецПопытки;
	Возврат РезультатФункции;	
КонецФункции		// ВывестиДиаграммуЭтапов()

// Выводит на форме гиустограмму распределения метрик по данным таблицы ТаблицаРазвернутыеДанныеВход. 
&НаСервере
Функция ВывестиДиаграммуРаспределения(ТаблицаРазвернутыеДанныеВход)
	РезультатФункции = Истина;
	Попытка
		ТабДокРаспределение.Очистить();
		ОбъектОбработки = РеквизитФормыВЗначение("Объект");
		ТаблицаАнализа = ПреобразоватьПериодичностьВРазвернутыхДанных(ТаблицаРазвернутыеДанныеВход, Объект.Периодичность);
		ТаблицаАнализа = ОбъектОбработки.ПроанализироватьРаспределениеМетрик(ТаблицаАнализа, Метрика);
		ТаблицаАнализРаспределения.Загрузить(ТаблицаАнализа);
		НоваяТаблицаРаспределения = ОбъектОбработки.ВернутьТаблицуРаспределенияПоТаблицеАнализа(ТаблицаАнализа, Метрика);
		ТаблицаРаспределения.Загрузить(НоваяТаблицаРаспределения);
		СформироватьДиаграмму_Сервер(ТабДокРаспределение, НоваяТаблицаРаспределения);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось вывести таблицу распределения: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		РезультатФункции = Ложь;
	КонецПопытки;
	Возврат РезультатФункции;		
КонецФункции		// ВывестиДиаграммуРаспределения()	

// Серверная обёртка команды АнализироватьПроцесс(). Параметры ФормироватьДиаграммуЭтаповВход 
// и ФормироватьРаспределениеМетрикВход указывают на необходимость переформирования диаграммы
// этапов и диаграммы распределения метрик соответственно.
&НаСервере
Процедура АнализироватьПроцесс_Сервер(ФормироватьДиаграммуЭтаповВход = Истина, ФормироватьРаспределениеМетрикВход = Истина)
	// Считывание данных анализа.
	ТаблицаРазвернутыеДанные = ПолучитьРазвернутыеДанныеПоПроцессам(Объект.ШаблонПроцесса, Объект.ДатаНачалаАнализа, Объект.ДатаОкончанияАнализа, ОтборОрганизация);
	// Диаграмма этапов.
	Если ФормироватьДиаграммуЭтаповВход Тогда
		РезультатВыводаДиаграммыЭтапов = ВывестиДиаграммуЭтапов(ТаблицаРазвернутыеДанные);
	Иначе
		// Не требуется формирования диаграммы этапов.
	КонецЕсли;
	// Диаграмма распределения.
	Если ФормироватьРаспределениеМетрикВход Тогда
		РезультатВыводаРаспределения = ВывестиДиаграммуРаспределения(ТаблицаРазвернутыеДанные);
	Иначе
		// Не требуется формирования распределения метрик.
	КонецЕсли;
КонецПроцедуры		// АнализироватьПроцесс_Сервер()

// Выполянет расшифровку табличного документа Распределение.
&НаСервере
Функция РасшифровкаРаспределение_Сервер(РасшифровкаВход)
	// Инициализация.
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("НижняяГраница", 0);
	РезультатФункции.Вставить("ВерхняяГраница", 0);
	Попытка
		// Получим идентификатор выбранного промежутка.
		ДанныеРасшифровкиКомпоновки = ПолучитьИзВременногоХранилища(АдресХранилищаДанныеРасшифровкиРаспределение);	
		СтруктураИдентификатора = ТиповыеОтчетыУХ.ПолучитьЗначенияИзРасшифровки(АдресХранилищаСхемаКомпоновкиРаспределение, АдресХранилищаДанныеРасшифровкиРаспределение, РасшифровкаВход, "ИдентификаторПромежутка");
		ИдентификаторПромежутка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИдентификатора, "ИдентификаторПромежутка", "");
		// Найдём промежуток в таблице распределения.
		Если ЗначениеЗаполнено(ИдентификаторПромежутка) Тогда
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ИдентификаторПромежутка", ИдентификаторПромежутка);
			НайденныеСтроки = ТаблицаРаспределения.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				// Вернём структуру границ.
				ПерваяСтрока = НайденныеСтроки[0];
				НижняяГраница = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПерваяСтрока, "НижняяГраница", 0);
				ВерхняяГраница = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПерваяСтрока, "ВерхняяГраница", 0);
				РезультатФункции.Вставить("НижняяГраница", НижняяГраница);
				РезультатФункции.Вставить("ВерхняяГраница", ВерхняяГраница);
			Иначе
				// Промежуток не найден. Вернём пустую структуру.
				ТекстСообщения = НСтр("ru = 'Не удалось найти расшифровываемый промежуток. Операция отменена.'");
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
				РезультатФункции.Вставить("НижняяГраница", 0);
				РезультатФункции.Вставить("ВерхняяГраница", 0);
			КонецЕсли;
		Иначе
			// Идентификатор не найден. Ничего не делаем.
			РезультатФункции.Вставить("НижняяГраница", 0);
			РезультатФункции.Вставить("ВерхняяГраница", 0);
		КонецЕсли;
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить расшифровку по причине: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		РезультатФункции.Вставить("НижняяГраница", 0);
		РезультатФункции.Вставить("ВерхняяГраница", 0);
	КонецПопытки;
	Возврат РезультатФункции;
КонецФункции		// Расшифровка_Сервер()

// Управляет доступностью элементов на форме.
&НаСервере
Процедура УправлениеДоступностью()
	ЗаголовокПодвала = НСтр("ru = 'Данные этапа: %Этап%'");
	ЗаголовокПодвала = СтрЗаменить(ЗаголовокПодвала, "%Этап%", Строка(ТекущийЭтап));
	Элементы.ГруппаПодвал.Заголовок = ЗаголовокПодвала;
КонецПроцедуры		// УправлениеДоступностью()

// Отменяет загрузку пользовательской настойки с именем НаименованиеНастройкиВход
// из набора настроек НастройкиВход на форме для реквизита ОбъектНастройкиВход.
&НаСервере
Процедура УдалитьЗаполненныеНастройкиПользователя(НастройкиВход, ОбъектНастройкиВход, НаименованиеНастройкиВход)
	ЕстьЗначениеРеквизита = ЗначениеЗаполнено(ОбъектНастройкиВход);
	Если ЕстьЗначениеРеквизита Тогда
		НастройкиВход.Удалить(НаименованиеНастройкиВход);
	Иначе
		// Загружаем сохранённые настройки.
	КонецЕсли;
КонецПроцедуры		// УдалитьЗаполненныеНастройкиПользователя()

// Возврщает таблицу расшифровки распределения по границам НижняяГраницаВход и 
// ВерхняяГраницаВход.
&НаСервере
Функция ВернутьАдресТаблицыРашифровкиРаспределения(НижняяГраницаВход, ВерхняяГраницаВход)
	РезультатФункции = "";
	// Получим массив процессов по границам.	
	ТаблицаВрем = ТаблицаИсходныеДанные.Выгрузить();
	ТаблицаРезультат = ТаблицаВрем.СкопироватьКолонки();
	МассивПроцессов = Новый Массив;
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("НижняяГраница", НижняяГраницаВход);
	СтруктураПоиска.Вставить("ВерхняяГраница", ВерхняяГраницаВход);
	НайденныеСтроки = ТаблицаАнализРаспределения.НайтиСтроки(СтруктураПоиска);
	Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
		Если ЗначениеЗаполнено(ТекНайденныеСтроки.ДокументПроцесса) Тогда
			МассивПроцессов.Добавить(ТекНайденныеСтроки.ДокументПроцесса);
		Иначе
			// Документ процесса не указан. Пропускаем строку.
		КонецЕсли;
	КонецЦикла;
	// Отберём из таблицы данных строки по найденным процессам.
	Для Каждого ТекМассивПроцессов Из МассивПроцессов Цикл
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ДокументПроцесса", ТекМассивПроцессов);
		НайденныеСтроки = ТаблицаИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекНайденныеСтроки);
		КонецЦикла;
	КонецЦикла;	
	РезультатФункции = ПоместитьВоВременноеХранилище(ТаблицаРезультат, Новый УникальныйИдентификатор);
	Возврат РезультатФункции;
КонецФункции		// ВернутьАдресТаблицыРашифровкиРаспределения()

// Возвращает адрес таблицы значений исходных данных, отобранной 
// по этапу ЭтапВход.
&НаСервере
Функция ВернутьАдресРасшифровкиЭтапа(ЭтапВход)
	РезультатФункции = "";
	Если ЗначениеЗаполнено(ЭтапВход) Тогда
		ТаблицаВрем = ТаблицаИсходныеДанные.Выгрузить();
		ТаблицаРезультат = ТаблицаВрем.СкопироватьКолонки();
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ЭтапПроцесса", ЭтапВход);
		НайденныеСтроки = ТаблицаВрем.НайтиСтроки(СтруктураПоиска);
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекНайденныеСтроки);
		КонецЦикла;
		РезультатФункции = ПоместитьВоВременноеХранилище(ТаблицаРезультат, Новый УникальныйИдентификатор);
	Иначе
		РезультатФункции = "";
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ВернутьАдресРасшифровкиЭтапа()

// Возвращает текстовое представление количества секунд КоличествоСекунд.
// Например, "1 час. 2 мин. 3 сек".
&НаКлиентеНаСервереБезКонтекста
Функция ПреобразоватьСекундыВСтроку(КоличествоСекундВход)
	РезультатФункции = "";
	// Опаределим знак входного значения
	Если КоличествоСекундВход >= 0 Тогда
		КоличествоСекундРабочее = КоличествоСекундВход;
	Иначе
		КоличествоСекундРабочее = (-КоличествоСекундВход);
	КонецЕсли;
	// Секунды.
	ОтображаемоеКоличество = Цел(КоличествоСекундРабочее % 60);
	Если ОтображаемоеКоличество <> 0 Тогда
		РезультатФункции = Строка(ОтображаемоеКоличество) + НСтр("ru = ' сек.'") + РезультатФункции;
	КонецЕсли;
	// Минуты.
	Если КоличествоСекундРабочее > 60 Тогда
		ОтображаемоеКоличество = Цел(КоличествоСекундРабочее / 60) % (60);
		Если ОтображаемоеКоличество <> 0 Тогда
			РезультатФункции = Строка(ОтображаемоеКоличество) + НСтр("ru = ' мин. '") + РезультатФункции;
		КонецЕсли;
		// Часы.
		Если КоличествоСекундРабочее > 60*60 Тогда
			ОтображаемоеКоличество = Цел(КоличествоСекундРабочее / (60*60)) % (24);
			Если ОтображаемоеКоличество <> 0 Тогда
				РезультатФункции = Строка(ОтображаемоеКоличество) + НСтр("ru = ' час. '") + РезультатФункции;
			КонецЕсли;
			// Дни.
			Если КоличествоСекундРабочее > 24*60*60 Тогда
				ОтображаемоеКоличество = (Цел(КоличествоСекундРабочее / (24*60*60)));
				Если ОтображаемоеКоличество <> 0 Тогда
					РезультатФункции = Строка(ОтображаемоеКоличество) + НСтр("ru = ' дн. '") + РезультатФункции;
				КонецЕсли;
			Иначе
				// Останавливаем заполнение.
			КонецЕсли;
		Иначе
			// Останавливаем заполнение.
		КонецЕсли;
	Иначе
		// Останавливаем заполнение.
	КонецЕсли;
	// Выведем знак текстового предеставления.
	Если КоличествоСекундВход > 0 Тогда
		// Не изменяем выходное значение.
	ИначеЕсли КоличествоСекундВход < 0 Тогда	
		РезультатФункции = "-" + РезультатФункции;
	Иначе
		РезультатФункции = "-";
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПреобразоватьСекундыВСтроку()

// Выводит в табличный документ на форме надпись, информирующую, что отчёт не сформирован.
&НаКлиенте
Функция ОтобразитьНадписьОтчетНеСформирован()
	Элементы.ТабДокРезультат.ОтображениеСостояния.Текст = НСтр("ru = 'Отчет не сформирован. Нажмите ""Сформировать"" для получения отчета.'");
	Элементы.ТабДокРезультат.ОтображениеСостояния.Видимость = Истина; 	
	Элементы.ТабДокРезультат.Доступность = Ложь;
КонецФункции		// ОтобразитьНадписьОтчетНеСформирован()

// Возвращает этап, выбранный пользователем в диаграмме этапов.
&НаКлиенте
Функция ВернутьВыбранныйЭтап()
	РезультатФункции = Неопределено;
	ВыделенныеОбласти = Элементы.ТабДокРезультат.ПолучитьВыделенныеОбласти();
	Если ВыделенныеОбласти.Количество() <> 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нужно выбрать один этап процесса для обработки.'"));
		РезультатФункции = Неопределено;
	Иначе
		ПерваяОбласть = ВыделенныеОбласти[0];
		Если ТипЗнч(ПерваяОбласть) = Тип("РисунокТабличногоДокумента") Тогда
			РезультатФункции = ПерваяОбласть.Расшифровка;
		ИначеЕсли ТипЗнч(ПерваяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда	
			Если ПерваяОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
				РезультатФункции = ПерваяОбласть.Расшифровка;
			Иначе	
				РезультатФункции = Неопределено;
			КонецЕсли;
		Иначе
			РезультатФункции = ПерваяОбласть.Расшифровка;
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ВернутьВыбранныйЭтап()

&НаКлиенте
Процедура АнализироватьПроцесс(Команда)
	Элементы.ТабДокРезультат.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
	Элементы.ТабДокРезультат.ОтображениеСостояния.Видимость = Ложь; 
	Элементы.ТабДокРезультат.Доступность = Истина;
	АнализироватьПроцесс_Сервер();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Получение параметров формы.
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		ОтборОрганизация = Параметры.Организация;
	Иначе
		// Не изменяем отбор.
	КонецЕсли;	
	Если ЗначениеЗаполнено(Параметры.ДатаНачалаАнализа) Тогда
		Объект.ДатаНачалаАнализа = Параметры.ДатаНачалаАнализа;
	Иначе
		// Не изменяем отбор.
	КонецЕсли;	
	Если ЗначениеЗаполнено(Параметры.ДатаОкончанияАнализа) Тогда
		Объект.ДатаОкончанияАнализа = Параметры.ДатаОкончанияАнализа;
	Иначе
		// Не изменяем отбор.
	КонецЕсли;	
	Если ЗначениеЗаполнено(Параметры.Метрика) Тогда
		Метрика = Параметры.Метрика;
	Иначе
		// Не изменяем отбор.
	КонецЕсли;	
	Если ЗначениеЗаполнено(Параметры.ШаблонПроцесса) Тогда
		Объект.ШаблонПроцесса = Параметры.ШаблонПроцесса;
	Иначе
		// Не изменяем отбор.
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.Периодичность) Тогда
		Объект.Периодичность = Перечисления.ПериодичностиАнализаПроцессов.Часы;
	Иначе
		// Значение установлено.
	КонецЕсли;
	// Обновление формы.
	УправлениеДоступностью();
	// Формирование.
	ФормироватьАвтоматически = Параметры.ФормироватьАвтоматически;
КонецПроцедуры

&НаКлиенте
Процедура ТабДокРезультатПриАктивизацииОбласти(Элемент)
	ТекущийЭтап = ВернутьВыбранныйЭтап();
	ЭтоЭтапУниверсальныхПроцессов = (ТипЗнч(ТекущийЭтап) = Тип("СправочникСсылка.ЭтапыУниверсальныхПроцессов"));
	Если (ЗначениеЗаполнено(ТекущийЭтап)) И (ЭтоЭтапУниверсальныхПроцессов) Тогда
		ВывестиДанныеПоЭтапуВПодвал(ТекущийЭтап, Метрика);
	Иначе	
		// Этап не выбран. Не обновляем статистику.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьПроцессы(Команда)
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ШаблонПроцесса", Объект.ШаблонПроцесса);
	ОткрытьФорму("Документ.ЭкземплярПроцесса.Форма.ФормаПроцессов", СтруктураПараметров);
КонецПроцедуры

&НаКлиенте
Процедура ШаблонПроцессаПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаАнализаПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияАнализаПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

&НаКлиенте
Процедура МетрикаПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	УдалитьЗаполненныеНастройкиПользователя(Настройки, Метрика, "Метрика");
	УдалитьЗаполненныеНастройкиПользователя(Настройки, Объект.ДатаНачалаАнализа, "Объект.ДатаНачалаАнализа");
	УдалитьЗаполненныеНастройкиПользователя(Настройки, Объект.ДатаОкончанияАнализа, "Объект.ДатаОкончанияАнализа");
	УдалитьЗаполненныеНастройкиПользователя(Настройки, Объект.ШаблонПроцесса, "Объект.ШаблонПроцесса");
	УдалитьЗаполненныеНастройкиПользователя(Настройки, ОтборОрганизация, "ОтборОрганизация");
КонецПроцедуры

&НаКлиенте
Процедура ТабДокРаспределениеОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СтандартнаяОбработка = Ложь;
	СтруктураРасшифровки = РасшифровкаРаспределение_Сервер(Расшифровка);
	НижняяГраница = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураРасшифровки, "НижняяГраница", 0);
	ВерхняяГраница = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураРасшифровки, "ВерхняяГраница", 0);
	АдресТаблицыРасшифровки = ВернутьАдресТаблицыРашифровкиРаспределения(НижняяГраница, ВерхняяГраница);
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("АдресТаблицыРасшифровки", АдресТаблицыРасшифровки);
	СтруктураПараметров.Вставить("Метрика", Метрика);
	ОткрытьФорму("Отчет.АнализПроцессов.Форма.ФормаРасшифровкиРаспределения", СтруктураПараметров, , , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	Если ФормироватьАвтоматически Тогда
		АнализироватьПроцесс_Сервер();
	Иначе
		// Не требуется формирование.
	КонецЕсли;
КонецПроцедуры

