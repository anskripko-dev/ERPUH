// Возвращает полную исходную таблицу с данными по выполнению процессов
// по шаблону ШаблонПроцессаВход в периоде от ДатаНачалаАнализаВход
// до ДатаОкончанияАнализаВход с отбором по группе организаций ОрганизацияВход. 
&НаСервере
Функция ПолучитьРазвернутыеДанныеПоПроцессам(ШаблонПроцессаВход, ДатаНачалаАнализаВход, ДатаОкончанияАнализаВход, ОрганизацияВход)
	РезультатФункции = Новый ТаблицаЗначений;
	Попытка
		ОбъектОбработки = РеквизитФормыВЗначение("Объект");       
		РезультатФункции = ОбъектОбработки.ПолучитьРазвернутыеДанныеПоПроцессам(ШаблонПроцессаВход, ДатаНачалаАнализаВход, ДатаОкончанияАнализаВход, ОрганизацияВход);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось вывести отчет: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьРазвернутыеДанныеПоПроцессам()

// Выводит в табличный документ ТабДокВход диаграмму распределения метрики из
// исходных данных таблицы ТаблицаРаспределенияВход.
&НаСервере
Процедура СформироватьДиаграмму_Сервер(ТабДокВход, ТаблицаРаспределенияВход) Экспорт
	Попытка
		ДанныеРасшифровки = Неопределено;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		ОбъектОбработки = РеквизитФормыВЗначение("Объект");       
		МакетДокумента = ОбъектОбработки.ПолучитьМакет("МакетРаспределениеМетрики");
		КомпоновщикАнализ = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикАнализ.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(МакетДокумента));
		КомпоновщикАнализ.ЗагрузитьНастройки(МакетДокумента.НастройкиПоУмолчанию);
		НастройкиКомпоновщика = КомпоновщикАнализ.ПолучитьНастройки();
		МакетКомпоновки = КомпоновщикМакета.Выполнить(МакетДокумента, НастройкиКомпоновщика, ДанныеРасшифровки);
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ВнешниеДанные = Новый Структура("ТЗ_ДанныеРаспределения", ТаблицаРаспределенияВход);
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеДанные, ДанныеРасшифровки);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ТабДокВход);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		АдресХранилищаДанныеРасшифровкиРаспределение = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, УникальныйИдентификатор);
		АдресХранилищаСхемаКомпоновкиРаспределение = ПоместитьВоВременноеХранилище(МакетДокумента, УникальныйИдентификатор);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось вывести отчет: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки;
КонецПроцедуры			// СформироватьДиаграмму_Сервер()

// Возвращает таблицу значений, содержащую данные по количеству переходов между этапами
// при анализе шаблона процесса ШаблонПроцессаВход в периоде ДатаНачалаАнализаВход и ДатаОкончанияАнализаВход.
&НаСервереБезКонтекста
Функция ПолучитьТаблицуКоличестваПереходов(ШаблонПроцессаВход, ДатаНачалаАнализаВход, ДатаОкончанияАнализаВход, ОрганизацияВход)
	РезультатФункции = Новый ТаблицаЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыполнениеПроцессов.Период КАК Период,
		|	ВыполнениеПроцессов.ДокументПроцесса КАК ДокументПроцесса,
		|	ВыполнениеПроцессов.ЭтапПроцесса КАК ЭтапПроцесса,
		|	ВыполнениеПроцессов.СостояниеЭтапа КАК СостояниеЭтапа,
		|	ВыполнениеПроцессов.ДатаНачала КАК ДатаНачала,
		|	ВыполнениеПроцессов.ДатаОкончания КАК ДатаОкончания,
		|	ТекущийМаршрутПроцесса.ЭтапПриемник КАК ЭтапПриемник
		|ПОМЕСТИТЬ ВТ_Последователи
		|ИЗ
		|	РегистрСведений.ВыполнениеПроцессов КАК ВыполнениеПроцессов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТекущийМаршрутПроцесса КАК ТекущийМаршрутПроцесса
		|		ПО ВыполнениеПроцессов.ДокументПроцесса = ТекущийМаршрутПроцесса.ДокументПроцесса
		|			И ВыполнениеПроцессов.ЭтапПроцесса = ТекущийМаршрутПроцесса.ЭтапИсточник
		|ГДЕ
		|	ВыполнениеПроцессов.ЭтапПроцесса.ТипЭтапа В(&ТипЭтапаУсловия)
		|	И ВыполнениеПроцессов.Период >= &ДатаНачала
		|	И ВыполнениеПроцессов.Период <= &ДатаОкончания
		|	И ВыполнениеПроцессов.ДатаНачала <> &ПустаяДата
		|	И ВыполнениеПроцессов.ДатаОкончания <> &ПустаяДата
		|	И ВыполнениеПроцессов.ДокументПроцесса.СостояниеВыполнения <> &СостояниеВРаботе
		|	И НЕ ВыполнениеПроцессов.ЭтапПроцесса.ПометкаУдаления
		|	И ВыполнениеПроцессов.ЭтапПроцесса.Владелец = &ШаблонПроцессаВход
		|	И ВыполнениеПроцессов.ДокументПроцесса.Организация В ИЕРАРХИИ(&Организация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВТ_Последователи.ДокументПроцесса КАК ДокументПроцесса,
		|	ВТ_Последователи.ЭтапПроцесса КАК ЭтапПроцесса,
		|	ВТ_Последователи.ДатаНачала КАК ДатаНачала,
		|	ВТ_Последователи.ДатаОкончания КАК ДатаОкончания,
		|	ВТ_Последователи.ЭтапПриемник КАК ЭтапПриемник
		|ПОМЕСТИТЬ ВТ_БезПовторов
		|ИЗ
		|	ВТ_Последователи КАК ВТ_Последователи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеПроцессов КАК ВыполнениеПроцессов
		|		ПО ВТ_Последователи.ДокументПроцесса = ВыполнениеПроцессов.ДокументПроцесса
		|			И ВТ_Последователи.ЭтапПриемник = ВыполнениеПроцессов.ЭтапПроцесса
		|			И ВТ_Последователи.ДатаОкончания = ВыполнениеПроцессов.ДатаНачала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_БезПовторов.ЭтапПроцесса КАК ЭтапПроцесса,
		|	ВТ_БезПовторов.ЭтапПриемник КАК ЭтапПриемник,
		|	КОЛИЧЕСТВО(ВТ_БезПовторов.ДокументПроцесса) КАК КоличествоПереходов
		|ПОМЕСТИТЬ ВТ_КоличествоПар
		|ИЗ
		|	ВТ_БезПовторов КАК ВТ_БезПовторов
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_БезПовторов.ЭтапПроцесса,
		|	ВТ_БезПовторов.ЭтапПриемник
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Этап,
		|	ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Ссылка,
		|	0
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов.ЭтапыПредшественники КАК ЭтапыУниверсальныхПроцессовЭтапыПредшественники
		|ГДЕ
		|	ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Этап.Владелец = &ШаблонПроцессаВход
		|	И ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Этап.ТипЭтапа В(&ТипЭтапаУсловия)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КоличествоПар.ЭтапПроцесса КАК ЭтапПредшественник,
		|	ВТ_КоличествоПар.ЭтапПриемник КАК ЭтапПриемник,
		|	СУММА(ВТ_КоличествоПар.КоличествоПереходов) КАК КоличествоПереходов
		|ИЗ
		|	ВТ_КоличествоПар КАК ВТ_КоличествоПар
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_КоличествоПар.ЭтапПроцесса,
		|	ВТ_КоличествоПар.ЭтапПриемник";
	СписокТипЭтапаУсловия = Новый СписокЗначений;
	СписокТипЭтапаУсловия.Добавить(Перечисления.ТипыЭтаповУниверсальныхПроцессов.УсловныйПереход);
	СписокТипЭтапаУсловия.Добавить(Перечисления.ТипыЭтаповУниверсальныхПроцессов.РучнойПереход);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаАнализаВход);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияАнализаВход);
	Запрос.УстановитьПараметр("Организация", ОрганизацияВход);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Запрос.УстановитьПараметр("СостояниеВРаботе", Перечисления.СостоянияПроцесса.Вработе);
	Запрос.УстановитьПараметр("ТипЭтапаУсловия", СписокТипЭтапаУсловия);
	Запрос.УстановитьПараметр("ШаблонПроцессаВход", ШаблонПроцессаВход);
	РезультатЗапроса = Запрос.Выполнить();
	РезультатФункции = РезультатЗапроса.Выгрузить();
	Возврат РезультатФункции;
КонецФункции		// ПолучитьТаблицуКоличестваПереходов()

// Формирует исходную таблицу градаций цветов с заданием границ действия.
