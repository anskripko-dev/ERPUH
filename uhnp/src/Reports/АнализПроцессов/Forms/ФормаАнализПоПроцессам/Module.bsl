	// [0.4; 0.5]
	НоваяСтрока = РезультатФункции.Добавить();
	НоваяСтрока.МинимальноеЗначение = 0.4;
	НоваяСтрока.МаксимальноеЗначение = 0.5;
	НоваяСтрока.Цвет = Новый Цвет(228, 211, 150);		// e4d396
	// [0.5; 0.6]
	НоваяСтрока = РезультатФункции.Добавить();
	НоваяСтрока.МинимальноеЗначение = 0.5;
	НоваяСтрока.МаксимальноеЗначение = 0.6;
	НоваяСтрока.Цвет = Новый Цвет(229, 208, 153);		// e5d099
	// [0.6; 0.7]
	НоваяСтрока = РезультатФункции.Добавить();
	НоваяСтрока.МинимальноеЗначение = 0.6;
	НоваяСтрока.МаксимальноеЗначение = 0.7;
	НоваяСтрока.Цвет = Новый Цвет(229, 198, 153);		// e5c699
	// [0.7; 0.8]
	НоваяСтрока = РезультатФункции.Добавить();
	НоваяСтрока.МинимальноеЗначение = 0.7;
	НоваяСтрока.МаксимальноеЗначение = 0.8;
	НоваяСтрока.Цвет = Новый Цвет(228, 185, 150);		// e4b996
	// [0.8; 0.9]
