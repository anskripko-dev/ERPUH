	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	// Инициализация.
	СтандартнаяОбработка = Ложь;
	ПустаяОрганизация = ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка");
	ПустойШаблон = ПредопределенноеЗначение("Справочник.ШаблоныУниверсальныхПроцессов.ПустаяСсылка");
	// Получение данных расшифровки.
	СтруктураРасшифровки = Расшифровка_Сервер(Расшифровка);
	МетрикаРезультат		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураРасшифровки, "Метрика", ПредопределенноеЗначение("Перечисление.МетрикиАнализаПроцессов.ПустаяСсылка"));
	ОрганизацияРезультат	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураРасшифровки, "Организация", ПустаяОрганизация);
	ШаблонРезультат			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураРасшифровки, "ШаблонПроцесса", ПустойШаблон);
	МетрикаРабочая = "";
	Если ЗначениеЗаполнено(МетрикаРезультат) Тогда
		МетрикаРабочая = МетрикаРезультат;
	Иначе
		МетрикаРабочая = Отчет.Метрика;
	КонецЕсли;
	// Открытие формы расшифровки.
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаНачалаАнализа",			 Отчет.ДатаНачалаАнализа);
	СтруктураПараметров.Вставить("ДатаОкончанияАнализа",		 Отчет.ДатаОкончанияАнализа);
	СтруктураПараметров.Вставить("Метрика",						 МетрикаРабочая);
	СтруктураПараметров.Вставить("Организация",					 ОрганизацияРезультат);
	СтруктураПараметров.Вставить("ФормироватьАвтоматически",	 Истина);
	СтруктураПараметров.Вставить("ШаблонПроцесса",				 ШаблонРезультат);
	ФормаАнализ = ПолучитьФорму("Отчет.АнализПроцессов.Форма.ФормаАнализПоПроцессам", СтруктураПараметров);
	ФормаАнализ.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Получение параметров.
	Если ЗначениеЗаполнено(Параметры.ДатаНачалаАнализа) Тогда
		Отчет.ДатаНачалаАнализа = Параметры.ДатаНачалаАнализа;
	Иначе
		// Пропускаем заполнение из параметра.
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.ДатаОкончанияАнализа) Тогда
		Отчет.ДатаОкончанияАнализа = Параметры.ДатаОкончанияАнализа;
	Иначе
		// Пропускаем заполнение из параметра.
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.Метрика) Тогда
