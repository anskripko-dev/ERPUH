// Определяет шаблон процесса для объекта бд ТипОбъектаВход по организации ОрганизацияВход.
// Когда определить однозначно невозможно - будет возвращена пустая ссылка.
&НаСервереБезКонтекста
Функция ОпределитьШаблонПроцесса(ОрганизацияВход, ТипОбъектаВход) 
	РезультатФункции = Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка();
	ПустойРегламент = Справочники.ВерсииРегламентовПодготовкиОтчетности.ПустаяСсылка();
	ПустойПроект = Справочники.Проекты.ПустаяСсылка();
	Если ЗначениеЗаполнено(ТипОбъектаВход) Тогда
		ТаблицаОтветственных = МодульУправленияПроцессамиУХ.ПолучитьТаблицуОтветственныхПоМатрицеПолномочий(ТипОбъектаВход.РазделятьПоОрганизациям, ТипОбъектаВход.РазделятьПоПроектам, ОрганизацияВход, ПустойПроект, ТипОбъектаВход, ТипОбъектаВход, ПустойРегламент);
		МассивСогласование = ТаблицаОтветственных.ВыгрузитьКолонку("Согласование");
		МассивСогласование = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСогласование);
		МассивСогласование = ОбщегоНазначенияКлиентСерверУХ.УдалитьПустыеЭлементыМассива(МассивСогласование);
		Если МассивСогласование.Количество() = 1 Тогда
			РезультатФункции = МассивСогласование[0];
			Если ТипЗнч(РезультатФункции) <> Тип("СправочникСсылка.ШаблоныУниверсальныхПроцессов") Тогда
				// Согласуется пользователем, либо ролью. Вернём пустой шаблон.
				РезультатФункции = Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка();		
			Иначе
				// Согласуется шаблоном процесса. Не заменяем результат.
			КонецЕсли;
		Иначе
			РезультатФункции = Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка();
		КонецЕсли;
	Иначе
		РезультатФункции = Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ОпределитьШаблонПроцесса()

// Возвращает тип объекта БД для элемента расшифровки ВыбранныйЭлементВход.
&НаСервере
Функция НайтиТипОбъектаВыбранногоЭлемента(ВыбранныйЭлементВход)
	// Поиск типа объекта.
	РезультатФункции = Справочники.ДокументыБД.ПустаяСсылка();
	Для Каждого ТекРодители1 Из ВыбранныйЭлементВход.ПолучитьРодителей() Цикл
		Для Каждого ТекРодители2 Из ТекРодители1.ПолучитьРодителей() Цикл
			Для Каждого ТекПоляВерхнейГруппировки Из ТекРодители2.ПолучитьПоля() Цикл
				Если ТекПоляВерхнейГруппировки.Поле = "ТипОбъектаСогласования" Тогда
					РезультатФункции = ТекПоляВерхнейГруппировки.Значение;
				Иначе
					// Выполняем поиск далее.
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// НайтиТипОбъектаВыбранногоЭлемента()

// Возвращает метрику, сопоставленную ресурсу СКД ПолеВход.
&НаСервереБезКонтекста
Функция ПреобразоватьПолеВМетрику(ПолеВход)
	РезультатФункции = Перечисления.МетрикиАнализаПроцессов.ПустаяСсылка();
	Если ПолеВход = "ОтклонениеОтПлана" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.ОтклнениеОтПланаСумма;
	ИначеЕсли ПолеВход = "ДлительностьСредняя" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.ДлительностьСредняя;
	ИначеЕсли ПолеВход = "ДлительностьПлановая" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.ДлительностьПлановая;
	ИначеЕсли ПолеВход = "ПроцентОтклонения" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.ПроцентОтклонения;
	ИначеЕсли ПолеВход = "ДлительностьКоличество" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.КоличествоВыполнений;
	ИначеЕсли ПолеВход = "КонсервативнаяДлительность" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.КонсервативнаяДлительность;
	ИначеЕсли ПолеВход = "КоличествоОтклонений" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.КоличествоОтклонений;
	ИначеЕсли ПолеВход = "ДлительностьСумма" Тогда
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.ДлительностьСумма;
	Иначе
		РезультатФункции = Перечисления.МетрикиАнализаПроцессов.ПустаяСсылка();
	КонецЕсли;	
	Возврат РезультатФункции;	
КонецФункции		// ПреобразоватьПолеВМетрику()

// Возвращает структуру, содержащую сценарий и период по расшифровке РасшифровкаВход 
// табличного документа на форме.
&НаСервере
Функция Расшифровка_Сервер(РасшифровкаВход)
	// Инициализация.
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Метрика",		 Перечисления.МетрикиАнализаПроцессов.ПустаяСсылка());
	РезультатФункции.Вставить("Организация",	 Справочники.Организации.ПустаяСсылка());
	РезультатФункции.Вставить("ТипОбъекта",		 Справочники.ДокументыБД.ПустаяСсылка());
	РезультатФункции.Вставить("ШаблонПроцесса",	 Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка());
	Попытка
		// Считывание расшифровки.
		ДанныеРасшифровкиКомпоновки = ПолучитьИзВременногоХранилища(Отчет.АдресХранилищаДанныеРасшифровки);	
		ЭлементыДанныхРасшифровки = ДанныеРасшифровкиКомпоновки.Элементы;
		ЭлементРасшифровкиКомпоновки = ЭлементыДанныхРасшифровки[РасшифровкаВход];
		// Получение полей группировки.
		СтруктураПолей = Новый Структура;
		СтруктураПолей.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
		СтруктураПолей.Вставить("ОрганизацияРасш", Справочники.Организации.ПустаяСсылка());
		СтруктураПолей.Вставить("ШаблонПроцесса", Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка());
		СтруктураПолей.Вставить("ЭтапПроцесса", Справочники.ЭтапыУниверсальныхПроцессов.ПустаяСсылка());
		СводнаяТаблицаУХ.ПолучитьРасшифровкуГруппировок(ЭлементРасшифровкиКомпоновки, СтруктураПолей);
		НайденнаяОрганизация	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПолей, "ОрганизацияРасш", Справочники.Организации.ПустаяСсылка());
		НайденныйШаблонПроцесса	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПолей, "ШаблонПроцесса", Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка());		
		НайденныйЭтап			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПолей, "ЭтапПроцесса", Справочники.ЭтапыУниверсальныхПроцессов.ПустаяСсылка());	
		// Дополнительное определение шаблона процесса.
		Если НЕ ЗначениеЗаполнено(НайденныйШаблонПроцесса) Тогда
			Если ЗначениеЗаполнено(НайденныйЭтап) Тогда
				НайденныйШаблонПроцесса = НайденныйЭтап.Владелец;
			Иначе	
				РодителиРасшифровки = ЭлементРасшифровкиКомпоновки.ПолучитьРодителей(); 	//Получим расшифровку заголовочных ячеек
				// Обход данных расшифровки.
				НайденныйТипОбъекта = Справочники.ДокументыБД.ПустаяСсылка();
				Для Каждого ТекРодителиРасшифровки Из РодителиРасшифровки Цикл
					 // Поиск типа объекта.
					ВыбранныйЭлемент = ЭлементыДанныхРасшифровки[ТекРодителиРасшифровки.Идентификатор];
					НайденныйТипОбъекта = НайтиТипОбъектаВыбранногоЭлемента(ВыбранныйЭлемент);
				КонецЦикла;	
				НайденныйШаблонПроцесса = ОпределитьШаблонПроцесса(НайденнаяОрганизация, НайденныйТипОбъекта);
			КонецЕсли;
		Иначе
			// Значение получено.
		КонецЕсли;
		// Выбранный ресурс.
		ПоляРасшифровки = ЭлементРасшифровкиКомпоновки.ПолучитьПоля();
		НайденнаяМетрика = Перечисления.МетрикиАнализаПроцессов.ПустаяСсылка();
		МассивМетрик = Новый Массив;
		МассивМетрик.Добавить("ДлительностьКоличество");
		МассивМетрик.Добавить("ДлительностьПлановая");
		МассивМетрик.Добавить("ДлительностьСредняя");
		МассивМетрик.Добавить("ДлительностьСумма");
		МассивМетрик.Добавить("ОтклонениеОтПлана");
		МассивМетрик.Добавить("КоличествоОтклонений");
		МассивМетрик.Добавить("КонсервативнаяДлительность");
		МассивМетрик.Добавить("ПроцентОтклонения");
		Для Каждого ТекПоляРасшифровки Из ПоляРасшифровки Цикл
			ТекПоле = СокрЛП(ТекПоляРасшифровки.Поле);
			МетрикаНайдена = (МассивМетрик.Найти(ТекПоле) <> Неопределено);
			Если МетрикаНайдена Тогда
				НайденнаяМетрика = ТекПоле;
			Иначе
				// Выполняем поиск далее.
			КонецЕсли;
		КонецЦикла;	
		МетрикаРезультат = ПреобразоватьПолеВМетрику(НайденнаяМетрика);
		// Формирование итоговой структуры.    
		РезультатФункции.Вставить("Метрика",		 МетрикаРезультат);
		РезультатФункции.Вставить("Организация",	 НайденнаяОрганизация);
		РезультатФункции.Вставить("ТипОбъекта",		 НайденныйТипОбъекта);
		РезультатФункции.Вставить("ШаблонПроцесса",	 НайденныйШаблонПроцесса);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить расшифровку по причине: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		РезультатФункции.Вставить("Метрика",		 "");
		РезультатФункции.Вставить("Организация",	 Справочники.Организации.ПустаяСсылка());
		РезультатФункции.Вставить("ТипОбъекта",		 Справочники.ДокументыБД.ПустаяСсылка());
		РезультатФункции.Вставить("ШаблонПроцесса",	 Справочники.ШаблоныУниверсальныхПроцессов.ПустаяСсылка());
	КонецПопытки;
	Возврат РезультатФункции;
КонецФункции		// Расшифровка_Сервер()

// Выводит в табличный документ на форме надпись, информирующую, что отчёт не сформирован.
&НаКлиенте
Функция ОтобразитьНадписьОтчетНеСформирован()
	Элементы.Результат.ОтображениеСостояния.Текст = НСтр("ru = 'Отчет не сформирован. Нажмите ""Сформировать"" для получения отчета.'");
	Элементы.Результат.ОтображениеСостояния.Видимость = Истина; 	
КонецФункции		// ОтобразитьНадписьОтчетНеСформирован()

// Преобразует поле расшифровки дерева анализа в поле для выбора в расшифровочной форме.
&НаКлиенте
Функция ПреобразоватьМетрику(ИсходноеПредставлениеМетрикиВход)
	РезультатФункции = "";
	Если СокрЛП(ИсходноеПредставлениеМетрикиВход) = "ОтклонениеОтПлана" Тогда
		РезультатФункции = "МетрикаОтклнениеОтПланаСумма";
	ИначеЕсли СокрЛП(ИсходноеПредставлениеМетрикиВход) = "ДлительностьСредняя" Тогда
		РезультатФункции = "МетрикаДлительностьСредняя";
	ИначеЕсли СокрЛП(ИсходноеПредставлениеМетрикиВход) = "ДлительностьПлановая" Тогда
		РезультатФункции = "МетрикаДлительностьПлановая";
	ИначеЕсли СокрЛП(ИсходноеПредставлениеМетрикиВход) = "ПроцентОтклонения" Тогда
		РезультатФункции = "МетрикаПроцентОтклонения";
	ИначеЕсли СокрЛП(ИсходноеПредставлениеМетрикиВход) = "ДлительностьКоличество" Тогда
		РезультатФункции = "МетрикаКоличествоВыполнений";
	Иначе
		РезультатФункции = "";
	КонецЕсли;
	Возврат РезультатФункции;		
КонецФункции		// ПреобразоватьМетрику()	

&НаКлиенте
Процедура ДатаНачалаАнализаПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры

