Процедура Настройки_ВыбранныеПоля_ВыводимыеРесурсыОстаткиОбороты(Настройки, НоваяСКД, ТолькоОбороты = Ложь)
	
	Выбор = Настройки.Выбор;
	Выбор.Элементы.Очистить();
	
	Недоступный = Новый Структура("РежимОтображения", РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	НедоступныйВертикально = Новый Структура("РежимОтображения,Расположение", РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный, РасположениеПоляКомпоновкиДанных.Вертикально);
	
	Ресурсы = НоваяСКД.Параметры.ВыводимыеРесурсы.Значение.ВыгрузитьЗначения();
	
	Префикс = "Ресурсы.%1";
	ПоляПоказатели	= ПолучитьИменаПолей(Ресурсы, "Заголовки.%1");
	ПоляСНД 		= ПолучитьИменаПолей(Ресурсы, Префикс + "НачальныйОстатокДт");
	ПоляСНК 		= ПолучитьИменаПолей(Ресурсы, Префикс + "НачальныйОстатокКт");
	ПоляДО 			= ПолучитьИменаПолей(Ресурсы, Префикс + "ОборотДт");
	ПоляКО 			= ПолучитьИменаПолей(Ресурсы, Префикс + "ОборотКт");
	ПоляСКД 		= ПолучитьИменаПолей(Ресурсы, Префикс + "КонечныйОстатокДт");
	ПоляСКК 		= ПолучитьИменаПолей(Ресурсы, Префикс + "КонечныйОстатокКт");

	ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Показатели'"), НедоступныйВертикально, ПоляПоказатели);
	
	Если ТолькоОбороты Тогда
	
		ТекГруппа = Настройки.Выбор;
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Дебет'"), НедоступныйВертикально, ПоляДО);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Кредит'"), НедоступныйВертикально, ПоляКО);
		
	Иначе //Остатки и обороты
		
		ТекГруппа = ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Сальдо на начало периода'"), Недоступный);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Дебет'"), НедоступныйВертикально, ПоляСНД);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Кредит'"), НедоступныйВертикально, ПоляСНК);
		
		ТекГруппа = ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Обороты за период'"), Недоступный);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Дебет'"), НедоступныйВертикально, ПоляДО);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Кредит'"), НедоступныйВертикально, ПоляКО);
		
		ТекГруппа = ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Сальдо на конец периода'"), Недоступный);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Дебет'"), НедоступныйВертикально, ПоляСКД);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(ТекГруппа, НСтр("ru = 'Кредит'"), НедоступныйВертикально, ПоляСКК);
	
	КонецЕсли;

КонецПроцедуры

Процедура Настройки_ВыбранныеПоля_ИспользоватьПервыйРесурс(Настройки)
	
	ВыбранныеГруппы = ТиповыеОтчетыУХ.ПолучитьВыбранныеПоля(Настройки.Выбор, Истина);
	
	Для каждого ВыбраннаяГруппа Из ВыбранныеГруппы Цикл
		
		Использование = Истина;//по умолчанию используем только первый ресурс
		Для каждого ТекущийЭлемент Из ВыбраннаяГруппа.Элементы Цикл
			
			Если ТипЗнч(ТекущийЭлемент) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
				Прервать;
			КонецЕсли;
			
			ТекущийЭлемент.Использование = Использование;
			Использование = Ложь;
			
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура Настройки_ВыбранныеПоля_ВыводимыеРесурсы(Настройки, НоваяСКД)
	
	СчетДт = Новый ПолеКомпоновкиДанных("СчетДт");
	СчетКт = Новый ПолеКомпоновкиДанных("СчетКт");
	
	ВыбранныеПоля = ТиповыеОтчетыУХ.ПолучитьВыбранныеПоля(Настройки.Выбор, Ложь);
	Для каждого ВыбранноеПоле Из ВыбранныеПоля Цикл
		
		Если (ТипЗнч(ВыбранноеПоле) = Тип("ВыбранноеПолеКомпоновкиДанных")) 
			И (ТипЗнч(ВыбранноеПоле.Родитель) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных"))
			И (Не СтрНачинаетсяС(Строка(ВыбранноеПоле.Поле), "СуммаВВалютеУчета")) 
			И (ВыбранноеПоле.Поле <> СчетДт) 
			И (ВыбранноеПоле.Поле <> СчетКт)
			Тогда
			
			ВыбранноеПоле.Использование = Ложь;	// по умолчанию видны только ресурсы "СуммаВВалютеУчета", остальные ресурсы скрыты
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура Настройки_ВыбранныеПоля_Детали(Настройки, НоваяСКД, ВыводитьСальдо = Истина)

	Настройки.Выбор.Элементы.Очистить();
	
	ТиповыеОтчетыУХ.ДобавитьВыбранныеПоля(Настройки.Выбор, Новый Структура("Период,Регистратор,АналитикаДт,АналитикаКт"));
	
	Ресурсы = НоваяСКД.Параметры.ВыводимыеРесурсы.Значение.ВыгрузитьЗначения();
	
	ПоляПоказатели	= ПолучитьИменаПолей(Ресурсы, "Заголовки.%1");
	РесурсыДт 		= ПолучитьИменаПолей(Ресурсы, "Ресурсы.Оборот.%1Дт");
	РесурсыКт 		= ПолучитьИменаПолей(Ресурсы, "Ресурсы.Оборот.%1Кт");
	
	Если ВыводитьСальдо Тогда
		Сальдо			= ПолучитьИменаПолей(Ресурсы, "Ресурсы.КонечныйОстаток.%1ТекущееСальдо");
		СтороныСальдо	= ПолучитьИменаПолей(Ресурсы, "Ресурсы.КонечныйОстаток.%1СторонаСальдо");
	КонецЕсли;

	Вертикально = Новый Структура("Расположение", РасположениеПоляКомпоновкиДанных.Вертикально);
	Горизонтально = Новый Структура("Расположение", РасположениеПоляКомпоновкиДанных.Горизонтально);
	
	ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Показатели'"), Вертикально, ПоляПоказатели);
	
	Группа = ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Дебет'"), Горизонтально);
	ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Группа, НСтр("ru = 'Счет Дт'"), Вертикально, Новый Структура("СчетДт"));
	ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Группа, "_Дт", Вертикально, РесурсыДт);
	
	Группа = ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Кредит'"), Горизонтально);
	ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Группа, НСтр("ru = 'Счет Кт'"), Вертикально, Новый Структура("СчетКт"));
	ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Группа, "_Кт", Вертикально, РесурсыКт);
	
	Если ВыводитьСальдо Тогда
		
		Группа = ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Настройки.Выбор, НСтр("ru = 'Текущее сальдо'"), Горизонтально);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Группа, "_" + НСтр("ru = 'Сторона сальдо'"), Вертикально, СтороныСальдо);
		ТиповыеОтчетыУХ.ДобавитьГруппуПолейВыбора(Группа, "_" + НСтр("ru = 'Сальдо'"), Вертикально, Сальдо);
	
	КонецЕсли;
	
КонецПроцедуры

