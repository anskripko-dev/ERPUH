Функция ЗаполнитьТекущиеПараметрыПН(НастройкиСКД, КлючВариантаПредопределенный, ПользовательскиеНастройки = Неопределено, Контекст = Неопределено)
	
	ТекЗначение = Неопределено;
	ОтборФормы = Новый Структура;
	Если ТипЗнч(Контекст) = Тип("ФормаКлиентскогоПриложения") И Контекст.ФормаПараметры.Свойство("Отбор") Тогда
		ОтборФормы = Контекст.ФормаПараметры.Отбор;
	КонецЕсли;
	
	ИсточникПН = Новый Структура(
		"Сценарий, ПланСчетовБД, РегистрБухгалтерии, Счет, ВидСубконто, ФормироватьПроводкиМСФО", 
		Истина, Истина, Истина, , , , Истина);
		
	ТекущиеПараметрыПН = Новый Структура;
	
	Для каждого т Из ИсточникПН Цикл
		
		ОтборФормы.Свойство(т.Ключ, ТекЗначение);// заполняем из переданного отбора
		ЗначениеПН = ПолучитьПН(т.Ключ, НастройкиСКД, ПользовательскиеНастройки);
		
		Если ЗначениеЗаполнено(ТекЗначение) Тогда
			//уже заполнено из переданного отбора
		ИначеЕсли (ЗначениеПН <> Неопределено) И ЗначениеЗаполнено(ЗначениеПН.Значение) Тогда
			ТекЗначение = ЗначениеПН.Значение;//перезаполняем из переданного отбора
		ИначеЕсли т.Ключ = "Сценарий" Тогда
			ТекЗначение = Константы.СценарийМСФО.Получить();
		ИначеЕсли т.Ключ = "ПланСчетовБД" Тогда
			ТекЗначение = Константы.ПланСчетовПоУмолчанию.Получить();
		ИначеЕсли т.Ключ = "Счет" Тогда
			ТекЗначение = ПланыСчетов.МСФО.Вспомогательный;
		ИначеЕсли т.Ключ = "ВидСубконто" Тогда
			ТекЗначение = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникКонтрагенты;
		ИначеЕсли т.Ключ = "РегистрБухгалтерии" Тогда
			ТекЗначение = ИмяРегистраПоПлануСчетов(ТекущиеПараметрыПН.ПланСчетовБД);
		КонецЕсли;
		
		Если (т.Значение = Истина) ИЛИ (ЗначениеПН <> Неопределено) Тогда
			ТекущиеПараметрыПН.Вставить(т.Ключ, ТекЗначение);
		Иначе 
			ТекущиеПараметрыПН.Вставить(т.Ключ, Неопределено);//"Счет, ВидСубконто" могут не использоваться
		КонецЕсли;

		Если (ЗначениеПН <> Неопределено) И (ЗначениеПН.Значение <> ТекЗначение) Тогда
			ЗначениеПН.Значение = ТекЗначение;//Заменяем значение в ПН на умолчания или переданный отбор
		КонецЕсли;

	КонецЦикла;
	
	НастройкиСКД.ДополнительныеСвойства.Вставить("ТекущиеПараметрыПН", ТекущиеПараметрыПН);
	
КонецФункции

Функция ПолучитьПН(ИмяПараметра, НастройкиСКД, ПользовательскиеНастройки = Неопределено)

	Результат = Неопределено;
	
	ПН = ПользовательскиеНастройки;

	ПоИмени = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	ПараметрНастроек = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(ПоИмени);
	
	Если ПараметрНастроек <> Неопределено Тогда //в ПН, когда быстрые настройки
		Результат = ПользовательскаяНастройка(ПН, ПараметрНастроек);
	КонецЕсли;
	
	Если (Результат = Неопределено)
		И (ПараметрНастроек <> Неопределено)
		И (ПараметрНастроек.Значение <> Неопределено)
		И (ПараметрНастроек.РежимОтображения 
			= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный)
		Тогда
		
		Результат = ПараметрНастроек;//из обычных настроек, если нет в ПН
		
	КонецЕсли;
	
	Если Результат = Неопределено Тогда // в ПН по имени
		ТиповыеОтчетыУХ.ЗначениеПараметраПользовательскихНастроек(ПН, ИмяПараметра);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьФиксированныеПараметры(КлючВарианта, НастройкиСКД)
	
	РБ = НастройкиСКД.ДополнительныеСвойства.ТекущиеПараметрыПН.РегистрБухгалтерии;
	
	ФиксированныеНастройки = Новый Структура;
	ФиксированныеНастройки.Вставить("ТипОбъектаМетаданных",	"РегистрыБухгалтерии");
	ФиксированныеНастройки.Вставить("ИмяОбъектаМетаданных",	РБ);
	ФиксированныеНастройки.Вставить("Период", ТиповыеОтчетыУХ.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение);
	ФиксированныеНастройки.Вставить("ФормироватьПроводкиМСФО", ТиповыеОтчетыУХ.ПолучитьПараметр(КомпоновщикНастроек, "ФормироватьПроводкиМСФО").Значение);
	
	Если КлючВарианта = "АнализСчета" Тогда	 
		ФиксированныеНастройки.Вставить("ИмяТаблицы", "Обороты");
	ИначеЕсли (КлючВарианта = "КарточкаСчета") Или (КлючВарианта = "КарточкаСубконто") Или (КлючВарианта = "ОтчетПоПроводкам") Тогда
		ФиксированныеНастройки.Вставить("ИмяТаблицы", "ОстаткиИОбороты");//+ДвиженияССубконто
	ИначеЕсли КлючВарианта = "Примечание" Тогда	 
		ФиксированныеНастройки.Вставить("ИмяТаблицы", "Обороты");
	Иначе 
		ФиксированныеНастройки.Вставить("ИмяТаблицы", "ОстаткиИОбороты");
	КонецЕсли;
	
	Возврат ФиксированныеНастройки;
	
КонецФункции

Функция ПользовательскаяНастройка(ПользовательскиеНастройки, ЭлементНастроек)

	Если Не ЗначениеЗаполнено(ЭлементНастроек.ИдентификаторПользовательскойНастройки) Тогда
		Возврат Неопределено; 
	КонецЕсли;
	
	Если ПользовательскиеНастройки = Неопределено Тогда
		Возврат Неопределено; 
	КонецЕсли;
	
	Возврат ПользовательскиеНастройки.Элементы.Найти(ЭлементНастроек.ИдентификаторПользовательскойНастройки);
	
КонецФункции

Процедура ПриИзмененииСчета_НастроитьПоказателиСчета(Настройки, СвойстваСчета, СхемаКД, ПользовательскиеНастройки = Неопределено)
	
	ПараметрКД = Новый ПараметрКомпоновкиДанных("ВыводимыеРесурсы");
	ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКД);
	Если ЗначениеПараметра = Неопределено Тогда
		ЗначениеПараметра = ТиповыеОтчетыУХ.ДобавитьПараметр(СхемаКД, ПараметрКД, Неопределено);
	КонецЕсли;
	
	ОчиститьОтНедоступныхРесурсов(ЗначениеПараметра.Значение, Настройки, СвойстваСчета, СхемаКД);
	
	Если ПользовательскиеНастройки <> Неопределено Тогда
		
		ЭлементПН = ПользовательскиеНастройки.Элементы.Найти(ЗначениеПараметра.ИдентификаторПользовательскойНастройки);
		Если (ЭлементПН <> Неопределено) Тогда
			
			ЗаполнитьНовымСпискомПоказателиРБ(ЭлементПН, ЗначениеПараметра.Значение);
			
			Если ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("КэшЗначенийОтборов") Тогда
				
				ТекущийИД = ЭлементПН.ИдентификаторПользовательскойНастройки;
				ПользовательскиеНастройки.ДополнительныеСвойства.КэшЗначенийОтборов.Удалить(ТекущийИД);

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ОчиститьОтНедоступныхРесурсов(ВыводимыеРесурсы, Настройки, СвойстваСчета, СхемаКД)
	
	Если Настройки.ДополнительныеСвойства.Свойство("НеЗаполнятьВыводимыеРесурсы") Тогда
		
		Настройки.ДополнительныеСвойства.Удалить("НеЗаполнятьВыводимыеРесурсы");
		Если ТипЗнч(ВыводимыеРесурсы) <> Тип("СписокЗначений") Тогда
			РесурсыНовые = СтрРазделить(Строка(ВыводимыеРесурсы), ",");
			ВыводимыеРесурсы = Новый СписокЗначений;
			ВыводимыеРесурсы.ЗагрузитьЗначения(РесурсыНовые);
		КонецЕсли
		
	Иначе 
		ПолныйСписок = СхемаКД.Параметры.ВыводимыеРесурсы.Значение;
		ВыводимыеРесурсы = ОбщегоНазначенияКлиентСервер.СкопироватьСписокЗначений(ПолныйСписок);
	КонецЕсли;
	
	ПоляРБ = ПолучитьПоляСПризнакамиРегистра(Настройки);
	КоличествоЭлементов = ВыводимыеРесурсы.Количество();
	СчетУказан = СвойстваСчета.Количество() > 0;//например, анализСубконто
	Для й = 1 По КоличествоЭлементов Цикл
		
		ТекЭлемент = ВыводимыеРесурсы[КоличествоЭлементов - й];
		Если ЗначениеЗаполнено(ТекЭлемент.Значение) 
			И ПоляРБ.Свойство(ТекЭлемент.Значение) 
			И СчетУказан
			И СвойстваСчета[ПоляРБ[ТекЭлемент.Значение]] <> Истина Тогда
			ВыводимыеРесурсы.Удалить(ТекЭлемент);//удаляем ресурс по признаку счета
		КонецЕсли;
		
	КонецЦикла;
 
КонецФункции

Процедура ЗаполнитьНовымСпискомПоказателиРБ(ЭлементПН, НовыйСписок)
	
	Если ЗначениеЗаполнено(ЭлементПН.Значение) Тогда
		
		Если ТипЗнч(ЭлементПН.Значение) = Тип("СписокЗначений") Тогда
			
			СтароеКоличество = ЭлементПН.Значение.Количество();
			Для ОбратныйИндекс = 1 По СтароеКоличество Цикл
				СтарыйЭлемент = ЭлементПН.Значение.Получить(СтароеКоличество - ОбратныйИндекс);
				Если НовыйСписок.НайтиПоЗначению(СтарыйЭлемент.Значение) = Неопределено Тогда
					ЭлементПН.Значение.Удалить(СтарыйЭлемент);
				КонецЕсли;
			КонецЦикла;
			
			Если ЭлементПН.Значение.Количество() Тогда
				Возврат;//остались элементы
			КонецЕсли;
			
		ИначеЕсли НовыйСписок.НайтиПоЗначению(Строка(ЭлементПН.Значение)) <> Неопределено Тогда
			Возврат;//один элемент, он в списке
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлементПН.Значение = Новый СписокЗначений;
	ЭлементПН.Значение.Добавить(НовыйСписок[0].Значение, , Истина);
	
КонецПроцедуры

Функция ПолучитьПоляСПризнакамиРегистра(НастройкиСКД)

	ИмяРБ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиСКД.ДополнительныеСвойства, "РегистрБухгалтерии");
	
	Если ИмяРБ = "Хозрасчетный" Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("ВалютнаяСумма",	"Валютный");
		Результат.Вставить("Валюта", 		"Валютный");
		Результат.Вставить("Количество", 	"Количественный");
		
		Возврат Результат;
	
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("СуммаВВалюте",	"Валютный");	
	Результат.Вставить("Валюта", 		"Валютный");
	Результат.Вставить("Количество", 	"Количественный");
	
	Возврат Результат;

КонецФункции

Функция ДобавитьГруппировкуСИерархией(ЭлементСтруктуры, Поле, НоваяСКД, ТипИерархия = Истина, ТолькоОбороты = Ложь)
	
	Настройки = НоваяСКД.ВариантыНастроек.Основной.Настройки;
	
	НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(ЭлементСтруктуры, Поле);
	ТипГруппировки = ?(ТипИерархия, ТипГруппировкиКомпоновкиДанных.Иерархия, ТипГруппировкиКомпоновкиДанных.Элементы);
	Для каждого ТекГруппировка Из НоваяГруппировка.ПоляГруппировки.Элементы Цикл
		ТекГруппировка.ТипГруппировки = ТипГруппировки;
	КонецЦикла;
	
	Настройки_ВыбранныеПоля_ВыводимыеРесурсыОстаткиОбороты(
		Настройки, НоваяСКД, ТолькоОбороты);
		
	Настройки_ВыбранныеПоля_ИспользоватьПервыйРесурс(Настройки);
	
	Возврат НоваяГруппировка;
	
КонецФункции

Функция ПолучитьИменаПолей(Ресурсы, ШаблонПоля)

	Результат = Новый Соответствие;
	Для каждого _ Из Ресурсы Цикл
		Результат.Вставить(СтрШаблон(ШаблонПоля, _));
	КонецЦикла;
		
	Возврат Результат;

КонецФункции

Функция ИмяПланаСчетовМД(НастройкиСКД)
	
	ПланСчетовБД = ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "ПланСчетовБД");
	Если Не ЗначениеЗаполнено(ПланСчетовБД) 
		Или Не ЗначениеЗаполнено(ПланСчетовБД.ПланСчетовМетаданные) Тогда
	
		Возврат "МСФО";
	
	КонецЕсли;
	
	Возврат ПланСчетовБД.ПланСчетовМетаданные;
	
КонецФункции

Функция ИмяРегистраПоПлануСчетов(ПланСчетовБД)
	
	РегистрБухгалтерии = "МСФО";
	
	Если Не ЗначениеЗаполнено(ПланСчетовБД) Тогда
		Возврат РегистрБухгалтерии;
	КонецЕсли;
	
	Если ПланСчетовБД.ОтсутствуетВКонфигурации Тогда
		Возврат РегистрБухгалтерии;
	КонецЕсли;
	
	СсылкаРБ = Справочники.РегистрыБухгалтерииБД.ПолучитьПоПлануСчетовБД(ПланСчетовБД);
	Если ЗначениеЗаполнено(СсылкаРБ) Тогда
		Возврат СсылкаРБ.Наименование;
	КонецЕсли;

	Возврат РегистрБухгалтерии;	

КонецФункции

Функция НайтиПоЗаголовкуПодчиненный(Заголовок, ЭлементРодитель)
	
	Если ТипЗнч(ЭлементРодитель) = Тип("ПолеФормы") 
		И ЭлементРодитель.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто Тогда
		ЭлементРодитель.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	КонецЕсли;
	
	Если ТипЗнч(ЭлементРодитель) = Тип("ГруппаФормы") Тогда // не декорация, поле
		Для каждого _Элемент Из ЭлементРодитель.ПодчиненныеЭлементы Цикл
			
			Результат = НайтиПоЗаголовкуПодчиненный(Заголовок, _Элемент);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если ЭлементРодитель.Заголовок = Заголовок Тогда
		Возврат ЭлементРодитель;
	КонецЕсли;

КонецФункции

Функция ОформитьПН(ЭлементПН, КартинкаПН, ПодсказкаВводаПН, РастягиватьПоГоризонтали = Ложь)

	ЭлементПН.Ширина 					= 10;
	ЭлементПН.Высота 					= 1;
	ЭлементПН.РастягиватьПоГоризонтали 	= РастягиватьПоГоризонтали;
	ЭлементПН.КнопкаОчистки 			= Ложь;
	ЭлементПН.ПоложениеЗаголовка 		= ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлементПН.КартинкаКнопкиВыбора 		= КартинкаПН;
	ЭлементПН.ПодсказкаВвода 			= ПодсказкаВводаПН;
	
КонецФункции

Процедура ОбновитьСписокВыводимыеРесурсы(Форма)
	
	Элементы = Форма.Элементы;
	ПН = Форма.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки;
	ФН = Форма.Отчет.КомпоновщикНастроек.ФиксированныеНастройки;
	
	ПараметрСКД = Новый ПараметрКомпоновкиДанных("ВыводимыеРесурсы");
	ЗначениеПН = ТиповыеОтчетыУХ.ЗначениеПараметраПользовательскихНастроек(ПН, ПараметрСКД);
	Если ЗначениеПН = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = Форма.ПутьКДаннымЭлементов.ПоИндексу.Получить(ПН.Элементы.Индекс(ЗначениеПН));
	Если ИмяЭлемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеФН = ФН.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрСКД);	 
	Если ЗначениеФН = Неопределено
		Или ОбщегоНазначенияКлиентСервер.СпискиЗначенийИдентичны(Форма[ИмяЭлемента], ЗначениеФН.Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Форма[ИмяЭлемента] = ЗначениеФН.Значение;
	Если Форма[ИмяЭлемента].Количество() Тогда
		Форма[ИмяЭлемента][0].Пометка = Истина;
	КонецЕсли;
	
	СписокВыбора = Элементы[ИмяЭлемента + "Значение"].СписокВыбора;
	СписокВыбора.Очистить();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Форма[ИмяЭлемента], СписокВыбора);
	
КонецПроцедуры

#Область НастройкиСКД

Функция ПолучитьЗаголовок(Отбор)
	
	Если Не УчетМСФОПовтИспУХ.ЕстьРСБУ() Тогда
		Возврат ""; //в ПФ нет заголовков
	КонецЕсли;
	
	ЗначенияШаблона = Новый Структура("Счет, Организация, Период, ВидСубконто, МодельУчета");
	ЗаполнитьЗначенияСвойств(ЗначенияШаблона, Отбор);
	
	МодельУчетаКратко = ?(Отбор.ФормироватьПроводкиМСФО, 
		НСтр("ru = 'ТУ'"), 
		НСтр("ru = 'ТК'")); // ТранзакционныйУчет/ТрансформационныеКорректировки
		
	ЗначенияШаблона.Вставить("МодельУчета", МодельУчетаКратко);
	
	ЗначенияШаблона.Период = ПредставлениеПериода(Отбор.Период.ДатаНачала, Отбор.Период.ДатаОкончания);
	
	Результат = Отбор.ШаблонЗаголовка;
	
	Для каждого ТекущееЗначение Из ЗначенияШаблона Цикл
		ШаблонЗамены = "%" + ТекущееЗначение.Ключ + "%";
		Результат = СтрЗаменить(Результат, ШаблонЗамены, ?(ЗначениеЗаполнено(ТекущееЗначение.Значение), ТекущееЗначение.Значение, ""));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РасшифровкаРСБУ

Процедура СКД_МакетыПолей_РасшифровкаРСБУ(СхемаКД, ПоДеталям)

	Если Не ПоДеталям Тогда
		Возврат;
	КонецЕсли;
	
	ВыраженияПолейРасшифровки = Новый Структура("Регистратор,НомерСтроки", "Регистратор", "НомерСтроки");
	
	Для каждого ПолеИтога Из СхемаКД.ПоляИтога Цикл
		
		Если Не СтрНачинаетсяС(ПолеИтога.ПутьКДанным, "Оборот") Тогда
			Если Не СтрНачинаетсяС(ПолеИтога.ПутьКДанным, "Сумма") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ИмяПоля = ПолеИтога.ПутьКДанным;
		ИмяМакета = "Поле_" + СтрЗаменить(ПолеИтога.ПутьКДанным, ".", "_");
		
		МакетПоля = СхемаКД.МакетыПолей.Найти(ИмяПоля);
		Если МакетПоля <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МакетПоля = СхемаКД.МакетыПолей.Добавить();
		МакетПоля.Поле = ИмяПоля;
		МакетПоля.Макет = ИмяМакета;
		
		Макет = СхемаКД.Макеты.Добавить();
		Макет.Имя = ИмяМакета;		
		
		ДобавитьПараметрОбластиВыражения(Макет, ИмяПоля, ИмяПоля);
		ДобавитьПараметрОбластиРасшифровки(Макет, "Расшифровка", ВыраженияПолейРасшифровки);
		
		Макет.Макет = Новый МакетОбластиКомпоновкиДанных;
		
		СтрокаОбл = Макет.Макет.Добавить(Тип("СтрокаТаблицыОбластиКомпоновкиДанных"));
		
		Ячейка = СтрокаОбл.Ячейки.Добавить();		
		Ячейка.Оформление.УстановитьЗначениеПараметра("Расшифровка", Новый ПараметрКомпоновкиДанных("Расшифровка"));
		
		Если Ячейка.Элементы.Количество() Тогда
			Ячейка.Элементы[0].Значение = Новый ПараметрКомпоновкиДанных(ИмяПоля);
		Иначе 
			Ячейка.Элементы.Добавить(Тип("ПолеОбластиКомпоновкиДанных")).Значение = Новый ПараметрКомпоновкиДанных(ИмяПоля);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавитьПараметрОбластиРасшифровки(МакетСКД, ИмяПараметраОбласти, СтруктураВыраженияПолей)
	
	ПараметрРасшифровки = МакетСКД.Параметры.Добавить(Тип("ПараметрОбластиРасшифровкаКомпоновкиДанных"));
	ПараметрРасшифровки.Имя = ИмяПараметраОбласти;
	
	Для каждого ВыраженияПоля Из СтруктураВыраженияПолей Цикл
		
		ВыражениеПоля = ПараметрРасшифровки.ВыраженияПолей.Добавить();
		ВыражениеПоля.Поле = Новый ПолеКомпоновкиДанных(ВыраженияПоля.Ключ);
		ВыражениеПоля.Выражение = ?(ЗначениеЗаполнено(ВыраженияПоля.Значение), ВыраженияПоля.Значение, ВыраженияПоля.Ключ);

	КонецЦикла;
	
	Возврат ПараметрРасшифровки;
	
КонецФункции

Функция ДобавитьПараметрОбластиВыражения(МакетСКД, ИмяПараметраОбласти, Выражение)
	
	ПараметрРасшифровки = МакетСКД.Параметры.Добавить(Тип("ПараметрОбластиВыражениеКомпоновкиДанных"));
	ПараметрРасшифровки.Имя = ИмяПараметраОбласти;
	ПараметрРасшифровки.Выражение = Выражение;
	
	Возврат ПараметрРасшифровки;
	
КонецФункции

