КонецФункции

Функция ВыражениеПредставленияПериода(ИмяПоля)

	Если ИмяПоля = "ПериодГод" Тогда
		Возврат "Формат(Периоды.ПериодГод, ""ДФ = 'yyyy'"")";
	ИначеЕсли (ИмяПоля = "ПериодДень") Тогда 
		Возврат "Формат(Периоды.ПериодДень, ""ДФ='dd.MM.yy'"")";
	ИначеЕсли ИмяПоля = "ПериодКвартал" Тогда
		Возврат "СТРОКА(КВАРТАЛ(Периоды.ПериодКвартал)) + "" кв. "" + Формат(Периоды.ПериодКвартал, ""ДФ = 'yyyy'"")";
	ИначеЕсли (ИмяПоля = "ПериодНеделя") Тогда 
		Возврат "Формат(КонецПериода(Периоды.ПериодНеделя, ""Неделя""), ""ДФ='dd.MM.yy'"")";
	ИначеЕсли (ИмяПоля = "ПериодДекада") Тогда 
		Возврат "Формат(КонецПериода(Периоды.ПериодДекада, ""Декада""), ""ДФ='dd.MM.yy'"")";
	ИначеЕсли (ИмяПоля = "ПериодМесяц") Тогда 
		Возврат "Формат(Периоды.ПериодМесяц, ""ДФ='MMM yy'"")";
	ИначеЕсли (ИмяПоля = "ПериодПолугодие") Тогда 
		
		Полугодие1 = НСтр("ru = '1-е полугодие'");
		Полугодие2 = НСтр("ru = '2-е полугодие'");
		
		Шаблон = 
			"ВЫБОР КОГДА КВАРТАЛ(Периоды.ПериодПолугодие)>2 ТОГДА ""%1 "" ИНАЧЕ ""%2 "" КОНЕЦ 
			|+ Формат(Периоды.ПериодПолугодие, ""ДФ = 'yyyy'"")";
		
		Возврат СтрШаблон(Шаблон, Полугодие1, Полугодие2);
		
	Иначе 
		Возврат СтрШаблон("Периоды.%1", ИмяПоля);
	КонецЕсли;

КонецФункции

#Область РесурсыРегистра

Функция ПолучитьОписаниеРегистра(Отбор, ФиксированныеПараметры)

	Результат = Новый Структура("Ресурсы, Измерения, ТипыПараметров, ЕстьСценарий", 
						Новый СписокЗначений, Новый СписокЗначений, Новый Структура, Ложь);
	
	мд = Метаданные.РегистрыБухгалтерии[ФиксированныеПараметры.ИмяОбъектаМетаданных];
	
	ПервыйПараметр = Истина;
	Для каждого ТекущийРесурс Из мд.Ресурсы Цикл
		
		Если Не ФиксированныеПараметры.ФормироватьПроводкиМСФО И
			ТекущийРесурс.Имя = "Количество" Тогда
			Продолжить;//Количества нет в АОСВ
		КонецЕсли;
		
		Результат.Ресурсы.Добавить(ТекущийРесурс.Имя, ТекущийРесурс.Синоним, ПервыйПараметр);
	
	КонецЦикла;
	
	Для каждого ТекущийРесурс Из мд.Измерения Цикл
		
		ПризнакУчета = ?(ТекущийРесурс.ПризнакУчета = Неопределено, "", ТекущийРесурс.ПризнакУчета.Имя);
		ОписаниеИзмерения = Новый Структура("Имя,Балансовый,ПризнакУчета",
				ТекущийРесурс.Имя, ТекущийРесурс.Балансовый, ПризнакУчета);
		
		Результат.Измерения.Добавить(ОписаниеИзмерения, ТекущийРесурс.Синоним);
		ПервыйПараметр = Ложь;
	
	КонецЦикла;
	
	Результат.Вставить("ЕстьСценарий", мд.Измерения.Найти("Сценарий") <> Неопределено И Константы.УчетПоСценариям.Получить());
	
	отСчет = Новый ОписаниеТипов("ПланСчетовСсылка." + мд.ПланСчетов.Имя);
	мдВидСубконто = мд.ПланСчетов.ВидыСубконто;
	отПВХ = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка." + мдВидСубконто.Имя);
	
	Результат.ТипыПараметров.Вставить("Счет", 			отСчет);
	Результат.ТипыПараметров.Вставить("Счета",			отСчет);
	Результат.ТипыПараметров.Вставить("ВидСубконто", 	отПВХ);
	Результат.ТипыПараметров.Вставить("Субконто", 		мдВидСубконто.Тип);
	
	Возврат Результат;

КонецФункции

Функция ЗаголовокВалютный(КлючВарианта)
	
	Если КлючВарианта = "КарточкаСчета" Тогда
		
		Возврат
		"ВЫБОР 
		|     КОГДА ЗНАЧЕНИЕЗАПОЛНЕНО(ВалютаДт) 
		|            ТОГДА  ПРЕДСТАВЛЕНИЕ(ВалютаДт) 
		|     КОГДА ЗНАЧЕНИЕЗАПОЛНЕНО(ВалютаКт)
		|            ТОГДА ПРЕДСТАВЛЕНИЕ(ВалютаКт) 
		|     ИНАЧЕ """"
		|КОНЕЦ";
	
	КонецЕсли;
	
	Возврат
	"ВЫБОР 
	|     КОГДА ЗНАЧЕНИЕЗАПОЛНЕНО(Валюта) 
	|            ТОГДА  ПРЕДСТАВЛЕНИЕ(Валюта)
	|     ИНАЧЕ """"
	|КОНЕЦ";
		
