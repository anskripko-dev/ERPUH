Процедура ТабДок_ОбъединитьЗаголовки(ДокументРезультат, НастройкиСКД, Отбор, КлючВарианта)
	
	Если Не ЗначениеЗаполнено(Отбор.ВыводимыеРесурсы) Тогда
		Возврат;// простые ресурсы (как в БП) - не используются 
	КонецЕсли;
	
	Для каждого ВыбранноеПоле Из НастройкиСКД.Выбор.Элементы Цикл
		Если ТипЗнч(ВыбранноеПоле) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			
			ЕстьДочерние = Ложь;
			Для каждого ДочернееВыбранноеПоле Из ВыбранноеПоле.Элементы Цикл
				Если ТипЗнч(ДочернееВыбранноеПоле) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
					
					МСФОУХ.ОбъединитьЗаголовкиПолей(ДокументРезультат, ДочернееВыбранноеПоле.Заголовок);
					Если СтрНачинаетсяС(ДочернееВыбранноеПоле.Заголовок, "_") Тогда
						
						ЗаголовокЯчейки = ДокументРезультат.НайтиТекст(ДочернееВыбранноеПоле.Заголовок, , , , Истина);
						Если ЗаголовокЯчейки <> Неопределено Тогда
							ЗаголовокЯчейки.Текст = "";
						КонецЕсли;
						
					Иначе 
						ЕстьДочерние = Истина;
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЕстьДочерние Тогда
				МСФОУХ.ОбъединитьЗаголовкиПолей(ДокументРезультат, ВыбранноеПоле.Заголовок);
				Если СтрНачинаетсяС(ВыбранноеПоле.Заголовок, "_") Тогда
					ЗаголовокЯчейки = ДокументРезультат.НайтиТекст(ВыбранноеПоле.Заголовок, , , , Истина);
					ЗаголовокЯчейки.Текст = "";
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	СкрытиеНиз = ДокументРезультат.ФиксацияСверху;
	ТекстГруппировки = ДокументРезультат.Область(СкрытиеНиз, 1, СкрытиеНиз, 1).Текст;//
	Если СкрытиеНиз > 0 И Не ЗначениеЗаполнено(ТекстГруппировки) Тогда
		ДокументРезультат.Область(СкрытиеНиз, , СкрытиеНиз).ВысотаСтроки = 1;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПриОпределенииСвойствЭлементовФормыНастроек

Процедура ПодготовитьГруппыЭлементов(ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки)
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СвойстваЭлементов.Группы.Вставить("ПерваяСтрока", СвойстваГруппы);
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СвойстваЭлементов.Группы.Вставить("ВтораяСтрока", СвойстваГруппы);
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СвойстваЭлементов.Группы.Вставить("ТретьяСтрока", СвойстваГруппы);
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	СвойстваГруппы.Отображение = ОтображениеОбычнойГруппы.Нет;	
	СвойстваЭлементов.Группы.Вставить("СчетСубконто", СвойстваГруппы);
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Вставить("Видимость", Ложь);
	СвойстваЭлементов.Группы.Вставить("СкрытыеПараметры", СвойстваГруппы);
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Вставить("Поведение", ПоведениеОбычнойГруппы.Свертываемая);
	СвойстваГруппы.Вставить("Заголовок", НСтр("ru = 'Оформление'"));
	СвойстваЭлементов.Группы.Вставить("Дополнительно", СвойстваГруппы);
		
КонецПроцедуры

Процедура УстановитьИдентификаторыГрупп(МестаПолей, ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки)
	
	Для Каждого ЭлементНастройки Из ПользовательскиеНастройки Цикл
		
		СвойстваПоля = СвойстваЭлементов.Поля.Найти(
			ЭлементНастройки.ИдентификаторПользовательскойНастройки, "ИдентификаторНастройки");
		Если СвойстваПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваПоля.РастягиватьПоГоризонтали = Ложь;
		
		ПолеПоиска = ПолучитьПолеПоиска(ЭлементНастройки, ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки);
		МестоПоля = МестаПолей.Получить(ПолеПоиска);
		
		Если МестоПоля = Неопределено Тогда
			//СвойстваПоля.ИдентификаторГруппы = "СкрытыеПараметры";
		Иначе 
			СвойстваПоля.ИдентификаторГруппы = МестоПоля;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПолеПоиска(ЭлементНастройки, ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки)

	СвойстваПоля = СвойстваЭлементов.Поля.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки, "ИдентификаторНастройки");				
	Если СвойстваПоля = Неопределено Тогда
		Возврат "СкрытыйЭлемент";//
	КонецЕсли;
	
	Если ТипЗнч(ЭлементНастройки) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда 		
		
		Если СвойстваПоля.ОписаниеНастройки = Неопределено Тогда
			Возврат "СкрытыйЭлемент";//скроем недоступные(субконто1 для ОСВ в настройках)
		ИначеЕсли СвойстваПоля.Настройки.ДоступныеПоляОтбора.НайтиПоле(СвойстваПоля.ОписаниеНастройки.Поле) = Неопределено Тогда
			Возврат "СкрытыйЭлемент";//скроем недоступные(субконто1 для ОСВ)
		КонецЕсли;
		
		Возврат Строка(СвойстваПоля.ОписаниеНастройки.Поле);
		
	ИначеЕсли ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
		
		Если СвойстваПоля.ОписаниеНастройки = Неопределено Тогда
			Возврат "СкрытыйЭлемент";
		Иначе
			Возврат Строка(ЭлементНастройки.Параметр);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЭлементНастройки) = Тип("ОтборКомпоновкиДанных") Тогда 
		Возврат "ОтборКомпоновкиДанных";
	ИначеЕсли ТипЗнч(ЭлементНастройки) = Тип("СтруктураНастроекКомпоновкиДанных") Тогда 
		Возврат "СтруктураНастроекКомпоновкиДанных"; //группировки
	КонецЕсли;
	
	Возврат "";// например условное оформление 

