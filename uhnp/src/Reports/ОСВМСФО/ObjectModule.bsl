Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Удалить("РасшифровкиРаскрытий");
	
	Если КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Свойство("КлючВариантаПредопределенный") Тогда
		КлючВарианта = КомпоновщикНастроек.Настройки.ДополнительныеСвойства.КлючВариантаПредопределенный;
	Иначе 
		КлючВарианта = "ОСВПоСчету";//ошибка
	КонецЕсли;
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	Отбор = ПолучитьЗначенияПараметров(НастройкиСКД, КлючВарианта);
	ВидыПоказателей = СхемаКомпоновкиДанных.Параметры.ВыводимыеРесурсы.Значение.ВыгрузитьЗначения();

	//Доработка СКД
	МСФОВызовСервераУХ.СКД_ДоработатьЗапрос(СхемаКомпоновкиДанных, НастройкиСКД, Отбор);
	МСФОУХ.СКД_Поля_Счет(СхемаКомпоновкиДанных, Отбор.ВыводитьНаименованиеСчета, ?(Отбор.ВариантДетали, "СчетДт,СчетКт", "Счет"));
	СКД_ВычисляемыеПоля_СальдоАналитика(Отбор);
	
	//Доработка НастройкиСКД
	Компоновщик_ПараметрыДанных(НастройкиСКД, Отбор, КлючВарианта);
	Компоновщик_Отбор(НастройкиСКД, Отбор, КлючВарианта);
	МСФОУХ.Компоновщик_Поля_Показатели(НастройкиСКД, Отбор, ВидыПоказателей);
	Компоновщик_Заголовок_Заполнить(НастройкиСКД, Отбор);
	Компоновщик_Структура(НастройкиСКД, Отбор, КлючВарианта);

	МСФОУХ.ПриКомпоновкеРезультата(СхемаКомпоновкиДанных, НастройкиСКД, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
	
	ТабДок_ОбъединитьЗаголовки(ДокументРезультат, НастройкиСКД, Отбор, КлючВарианта);
	
КонецПроцедуры

#Область ПередЗагрузкойНастроекВКомпоновщик

Функция ПодготовитьНовуюСКД(Контекст, Настройки, ПользовательскиеНастройки, ПараметрыПодготовки)
	
	ФиксированныеПараметры 			= ПараметрыПодготовки.ФиксированныеПараметры;
	КлючВариантаПредопределенный 	= ПараметрыПодготовки.КлючВариантаПредопределенный;
	ЭтоПользовательскийВариант		= ПараметрыПодготовки.ЭтоПользовательскийВариант;
	
	НоваяСКД = ПолучитьСКД(ФиксированныеПараметры, КлючВариантаПредопределенный);
	ДонастроитьСКД(НоваяСКД, Настройки, ФиксированныеПараметры, КлючВариантаПредопределенный);
	ЗаполнитьНастройки(НоваяСКД, Настройки, ФиксированныеПараметры, ЭтоПользовательскийВариант);
	ДонастроитьНастройки(НоваяСКД, ПользовательскиеНастройки, КлючВариантаПредопределенный, ЭтоПользовательскийВариант);
	ДонастроитьНастройкиПоОтбору(Контекст, НоваяСКД, ПользовательскиеНастройки);
	
	Настройки = НоваяСКД.ВариантыНастроек.Основной.Настройки;//замена переданных настроек
	
	ПриИзмененииСчета(НоваяСКД, Настройки, ПользовательскиеНастройки, КлючВариантаПредопределенный);
		
	Если ЗначениеЗаполнено(Настройки.ДополнительныеСвойства.ВидСубконто)
		И Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
			Новый ПараметрКомпоновкиДанных("ВидСубконто")).Использование Тогда
		ПриИзмененииСубконто(Настройки, НоваяСКД);
	КонецЕсли;
	
	Настройки.ДополнительныеСвойства.Вставить("КлючВариантаПредопределенный", КлючВариантаПредопределенный);

	Возврат НоваяСКД; 
	
КонецФункции

Функция ПолучитьАдресСхемы(Контекст, Настройки)
	
	СтараяСКД = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Настройки.ДополнительныеСвойства, "АдресСхемы");
		
	Если ЭтоАдресВременногоХранилища(СтараяСКД)
		И (ПолучитьИзВременногоХранилища(СтараяСКД) <> Неопределено) Тогда
		
		Возврат СтараяСКД;
		
	КонецЕсли;
		
	СтараяСКД = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Возврат Контекст.АдресСхемы;
	КонецЕсли;
			
	РеквизитыФормы = Контекст.ПолучитьРеквизиты("");
	Для каждого ТекущийРеквизит Из РеквизитыФормы Цикл
		Если ТекущийРеквизит.Имя = "АдресСхемы" Тогда
			
			Если ЭтоАдресВременногоХранилища(Контекст.АдресСхемы) 
				Или (ПолучитьИзВременногоХранилища(Контекст.АдресСхемы) <> Неопределено) Тогда
				Возврат Контекст.АдресСхемы;
			КонецЕсли;
			
		ИначеЕсли ТекущийРеквизит.Имя = "НастройкиОтчета" Тогда
			
			АдресСхемы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Контекст.НастройкиОтчета, "АдресСхемы");
			Если ЭтоАдресВременногоХранилища(АдресСхемы) 
				Или (ПолучитьИзВременногоХранилища(АдресСхемы) <> Неопределено) Тогда
				Возврат АдресСхемы;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;

	Возврат СтараяСКД;

КонецФункции

Функция ПолучитьСКД(ФиксированныеПараметры, КлючВарианта)
	
	НоваяСКД = Отчеты.УниверсальныйОтчет.СхемаКомпоновкиДанных(ФиксированныеПараметры);
	
	НоваяСКД.ВычисляемыеПоля.Очистить();//удаляем КоличествоПодчиненныхЗаписей
	
	НоваяСКД.Параметры.ТипОбъектаМетаданных.ОграничениеИспользования = Истина;
	НоваяСКД.Параметры.ИмяОбъектаМетаданных.ОграничениеИспользования = Истина;
	НоваяСКД.Параметры.ИмяТаблицы.ОграничениеИспользования = Истина;
	
	НоваяСКД.Параметры.КонецПериода.Выражение = "&Период.ДатаОкончания";//точная дата окончания - в запросе
	
	//Метод дополнения периодов(Движения) установим по условию
	НаборОСВ = НоваяСКД.НаборыДанных.НаборДанных1;
	НаборОСВ.Запрос = СтрЗаменить(НаборОСВ.Запрос, ", ДвиженияИГраницыПериода", "");
	НаборОСВ.Запрос = СтрЗаменить(НаборОСВ.Запрос, ", Движения", "");
	НаборОСВ.Запрос = СтрЗаменить(НаборОСВ.Запрос, "*", " 2 КАК БухИтог, *");
	
	ТекстЗапроса = НаборОСВ.Запрос;
	
	Если КлючВарианта = "КарточкаСчета" Тогда
		
		НаборДанных_ДобавитьОбщийИтог(НоваяСКД, КлючВарианта, ФиксированныеПараметры);
		НаборОСВ.Запрос = ТекстЗапросаОстаткиПоДокументам(
			НаборОСВ.Запрос, КлючВарианта, ФиксированныеПараметры);
		ДобавитьПоляДвиженийССубконто(НоваяСКД, ФиксированныеПараметры);
		
	ИначеЕсли КлючВарианта = "КарточкаСубконто" Тогда
		
		НаборДанных_ДобавитьОбщийИтог(НоваяСКД, КлючВарианта, ФиксированныеПараметры);
		НаборОСВ.Запрос = ТекстЗапросаОстаткиПоДокументам(
			НаборОСВ.Запрос, КлючВарианта, ФиксированныеПараметры);
		ДобавитьПоляДвиженийССубконто(НоваяСКД, ФиксированныеПараметры);
		
	ИначеЕсли КлючВарианта = "ОтчетПоПроводкам" Тогда
		
		НаборОСВ.Запрос = ТекстЗапросаОстаткиПоДокументам(
			НаборОСВ.Запрос, КлючВарианта, ФиксированныеПараметры);
		ДобавитьПоляДвиженийССубконто(НоваяСКД, ФиксированныеПараметры);
		
	ИначеЕсли СтрНайти(КлючВарианта, "АнализСчета") > 0 Тогда
		
		НаборОСВ.Запрос = СтрЗаменить(НаборОСВ.Запрос, "Авто", "Авто, &УсловиеСчета, ");	//Обороты
		
	ИначеЕсли СтрНайти(КлючВарианта, "АнализСубконто") > 0 Тогда
		НаборОСВ.Запрос = СтрЗаменить(НаборОСВ.Запрос, "Авто", "Авто,  , , &ВидСубконто, ");	//ОстаткиИОбороты
	ИначеЕсли СтрНайти(КлючВарианта, "Субконто") > 0 Тогда
		НаборОСВ.Запрос = СтрЗаменить(НаборОСВ.Запрос, "Авто", "Авто, , , &ВидСубконто,"); //ОстаткиИОбороты
	ИначеЕсли (СтрНайти(КлючВарианта, "Счет") > 0) Или (КлючВарианта = "ОСВ") Или (КлючВарианта = "КОСВ") Тогда
		НаборОСВ.Запрос = СтрЗаменить(НаборОСВ.Запрос, "Авто", "Авто, ,&УсловиеСчета, "); //ОстаткиИОбороты
	ИначеЕсли СтрНайти(КлючВарианта, "Примечание") > 0 Тогда
		НаборОСВ.Запрос = ТекстЗапроса_Примечания(НаборОСВ.Запрос);//Обороты
	КонецЕсли;
	
	ТекстЗапросаАОСВ = Отчеты.ОСВМСФО.ТекстЗапросаАОСВ(ФиксированныеПараметры, КлючВарианта);
	Если ЗначениеЗаполнено(ТекстЗапросаАОСВ) Тогда
		НаборОСВ.Запрос = ТекстЗапросаАОСВ;
	КонецЕсли;
	
	Возврат НоваяСКД;

КонецФункции

Процедура ДонастроитьСКД(НоваяСКД, Настройки, ФиксированныеПараметры, КлючВарианта)

	ПоСчету = КлючПоСчету(КлючВарианта);
	ПоСубконто = КлючПоСубконто(КлючВарианта) Или КлючПоПримечанию(КлючВарианта);
	ПоДеталям = КлючДвижения(КлючВарианта);
	
	ОписаниеРегистра = ПолучитьОписаниеРегистра(Настройки, ФиксированныеПараметры);
	НоваяСКД.ВариантыНастроек.Основной.Настройки.ДополнительныеСвойства.Вставить("ОписаниеРегистра", ОписаниеРегистра);

	#Область НаборыДанных
	НаборыДанных_ДоработатьПоля(НоваяСКД, ОписаниеРегистра, КлючВарианта);
	НаборыДанных_ПереработатьДляБухИтогов(НоваяСКД, ФиксированныеПараметры, КлючВарианта);
	НаборыДанных_ДобавитьЗависимыеНаборы(НоваяСКД, ФиксированныеПараметры, КлючВарианта);
	#КонецОбласти

	#Область СКД_ВычисляемыеПоля
	ВычисляемыеПоля_ДобавитьПоРесурсам(НоваяСКД, ОписаниеРегистра.Ресурсы, КлючВарианта, ФиксированныеПараметры);
	ВычисляемыеПоля_ДобавитьАналитику(НоваяСКД, ПоДеталям);
	#КонецОбласти
	
	ПоляИтогов_ДозаполнитьПоВарианту(НоваяСКД, ПоДеталям);
	
	#Область СКД_Параметры

	Для каждого ПараметрИсточник Из СхемаКомпоновкиДанных.Параметры Цикл
		
		ПараметрПриемник = НоваяСКД.Параметры.Найти(ПараметрИсточник.Имя);
		Если ПараметрПриемник = Неопределено Тогда
			
			НовыйПараметр = НоваяСКД.Параметры.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйПараметр, ПараметрИсточник);
			Если ОписаниеРегистра.ТипыПараметров.Свойство(НовыйПараметр.Имя) Тогда
				НовыйПараметр.ТипЗначения = ОписаниеРегистра.ТипыПараметров[НовыйПараметр.Имя];
			КонецЕсли;
			НовыйПараметр.УстановитьДоступныеЗначения(ПараметрИсточник.ПолучитьДоступныеЗначения());
			
			ТиповыеОтчетыУХ.ЗаполнитьЭлементы(
				НовыйПараметр.ПараметрыРедактирования,
				ПараметрИсточник.ПараметрыРедактирования);

		КонецЕсли;

	КонецЦикла;
	
	МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "Счет", 						ПоСчету);
	МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "ОграничитьУровниСчетов", 	Не ПоДеталям);
	МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "ВидСубконто", 				ПоСубконто);
	МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "ВыводитьЗабалансовыеСчета", КлючОСВ(КлючВарианта));
	МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "ПланСчетовБД", 				Истина);
	МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "Сценарий", 					ОписаниеРегистра.ЕстьСценарий);
	МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "ВалютаУчетаДоп", 			Не ФиксированныеПараметры.ФормироватьПроводкиМСФО);

	ПараметрАналитика = МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "ВыводимыеРесурсы", Истина);
	ПараметрАналитика.УстановитьДоступныеЗначения(ОписаниеРегистра.Ресурсы);
	ПараметрАналитика.Значение = ОписаниеРегистра.Ресурсы;
	
	ПараметрыСхемы_ЗаполнитьСоставАналитики(НоваяСКД, ОписаниеРегистра, ПоДеталям);
	
	#КонецОбласти
	
	СКД_МакетыПолей_РасшифровкаРСБУ(НоваяСКД, ПоДеталям);

КонецПроцедуры

Процедура ЗаполнитьНастройки(НоваяСКД, Настройки, ФиксированныеПараметры, ЭтоПользовательскийВариант)
	
	НастройкиПриемник = НоваяСКД.НастройкиПоУмолчанию;
		
	ТекущиеПараметрыПН = Настройки.ДополнительныеСвойства.ТекущиеПараметрыПН;
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(НастройкиПриемник.ДополнительныеСвойства, ТекущиеПараметрыПН, Истина);
	
	ТиповыеОтчетыУХ.ЗаполнитьЭлементы(НастройкиПриемник.ПараметрыВывода, Настройки.ПараметрыВывода);
	
	ДобавитьОтборИзКомпоновщика	= Истина;
	//ВыбранныеПоля:ДобавитьПоказатели, Структура:СформироватьСтруктуру
	Если ЭтоПользовательскийВариант Тогда

		ОтчетИнициализирован = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
					НастройкиПриемник.ДополнительныеСвойства, "ОтчетИнициализирован", Ложь);

		Если Не ОтчетИнициализирован Тогда 
			
			ТиповыеОтчетыУХ.СкопироватьНастройкиКомпоновкиДанных(НастройкиПриемник, Настройки);
			ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(НастройкиПриемник.ДополнительныеСвойства, Настройки.ДополнительныеСвойства, Истина);
			ДобавитьОтборИзКомпоновщика = Ложь;//уже было в СкопироватьНастройкиКомпоновкиДанных
			
			Для каждого Источник Из Настройки.ПараметрыДанных.Элементы Цикл
			
				Если НастройкиПриемник.ПараметрыДанных.НайтиЗначениеПараметра(Источник.Параметр) = Неопределено Тогда
					 ЗначениеПриемник = НастройкиПриемник.ПараметрыДанных.Элементы.Добавить();
					 ЗаполнитьЗначенияСвойств(ЗначениеПриемник, Источник);
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе 
		
		КонтекстУО = Новый Структура("СхемаКомпоновкиДанных,КомпоновщикНастроек", 
									НоваяСКД, Новый КомпоновщикНастроекКомпоновкиДанных);

		Отчеты.УниверсальныйОтчет.УстановитьСтандартныеНастройки(
			КонтекстУО, ФиксированныеПараметры, Настройки, Неопределено);
			
		ТиповыеОтчетыУХ.СкопироватьНастройкиКомпоновкиДанных(
			НастройкиПриемник, КонтекстУО.КомпоновщикНастроек.Настройки);
		
	КонецЕсли;
	
	Если ДобавитьОтборИзКомпоновщика И КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество() Тогда
		ТиповыеОтчетыУХ.СкопироватьЭлементы(НастройкиПриемник.Отбор, КомпоновщикНастроек.Настройки.Отбор, Ложь, Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДонастроитьНастройки(НоваяСКД, ПользовательскиеНастройки, КлючВарианта, ЭтоПользовательскийВариант)
	
	Если ЭтоПользовательскийВариант Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = НоваяСКД.ВариантыНастроек.Основной.Настройки;
	
	НастройкиВарианта = СхемаКомпоновкиДанных.ВариантыНастроек.Найти(КлючВарианта);
	Если НастройкиВарианта = Неопределено Тогда
		МСФОКлиентСерверУХ.ДонастроитьНастройкиПоВарианту(Настройки, СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		МСФОКлиентСерверУХ.ДонастроитьНастройкиПоВарианту(Настройки, НастройкиВарианта.Настройки);
	КонецЕсли;
	
	Настройки_Отбор(Настройки);

	Настройки.Структура.Очистить();
	
	Если КлючВарианта = "ОСВ" Тогда
		
		НоваяГруппировка = ДобавитьГруппировкуСИерархией(Настройки, "Счет", НоваяСКД, Истина);
		Настройки_ВыбранныеПоля_ВыводимыеРесурсы(Настройки, НоваяСКД);
		
	ИначеЕсли КлючВарианта = "ОСВпоСчету" Тогда 
		
		НоваяГруппировка = ДобавитьГруппировкуСИерархией(Настройки, "Счет", НоваяСКД, Ложь);
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НоваяГруппировка, "Субконто1");
		
	ИначеЕсли КлючВарианта = "КарточкаСчета" Тогда 
		
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(Настройки, "СальдоНаНачало");
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НоваяГруппировка, Неопределено);
		Настройки_ВыбранныеПоля_Детали(Настройки, НоваяСКД);
		Настройки_ВыбранныеПоля_ВыводимыеРесурсы(Настройки, НоваяСКД);
		Настройки_УсловноеОформление_Период(Настройки, НоваяСКД);
		
	ИначеЕсли КлючВарианта = "АнализСчета" Тогда
		
		НоваяГруппировка = ДобавитьГруппировкуСИерархией(Настройки, "БухИтог", НоваяСКД, Ложь, Истина);
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НоваяГруппировка, "Счет");
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НоваяГруппировка, "Субконто1");
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НоваяГруппировка, "КорСчет");
		
		Для каждого ТекущаяГруппа Из Настройки.Выбор.Элементы Цикл
			Если СтрНайти(ТекущаяГруппа.Заголовок, "Сальдо") > 0 Тогда
				ТекущаяГруппа.Использование = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли КлючВарианта = "КарточкаСубконто" Тогда
		
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(Настройки, "СальдоНаНачало");
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НоваяГруппировка, Неопределено);

		Настройки_ВыбранныеПоля_Детали(Настройки, НоваяСКД);
		Настройки_ВыбранныеПоля_ВыводимыеРесурсы(Настройки, НоваяСКД);
		Настройки_УсловноеОформление_Период(Настройки, НоваяСКД);
		
	ИначеЕсли КлючВарианта = "АнализСубконто" Тогда 
		
		НоваяГруппировка = ДобавитьГруппировкуСИерархией(Настройки, "Счет", НоваяСКД, Ложь);
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(НоваяГруппировка, "Субконто1");

	ИначеЕсли КлючВарианта = "ОтчетПоПроводкам" Тогда 
		
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(Настройки, Неопределено);
		
		Настройки_ВыбранныеПоля_Детали(Настройки, НоваяСКД, Ложь);
		Настройки_ВыбранныеПоля_ВыводимыеРесурсы(Настройки, НоваяСКД);
		Настройки_УсловноеОформление_Период(Настройки, НоваяСКД);
		
	ИначеЕсли КлючВарианта = "КОСВ" Тогда
		
		ЭлементТаблица = Настройки.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
		НоваяГруппировка = ДобавитьГруппировкуСИерархией(ЭлементТаблица.Строки, "Счет", НоваяСКД, Истина);
		НоваяГруппировка = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(ЭлементТаблица.Колонки, "Организация");
		
		Если (НастройкиВарианта <> Неопределено)
			И НастройкиВарианта.Настройки.Структура.Количество()
			И ТипЗнч(НастройкиВарианта.Настройки.Структура[0]) = Тип("ТаблицаКомпоновкиДанных") Тогда
		
			ЭлементТаблица.Строки.ИдентификаторПользовательскойНастройки 
				= НастройкиВарианта.Настройки.Структура[0].Строки.ИдентификаторПользовательскойНастройки;
				
		Иначе 
			ЭлементТаблица.Строки.ИдентификаторПользовательскойНастройки = "ГруппировкаСтроки";
		КонецЕсли;

		Настройки_ВыбранныеПоля_ВыводимыеРесурсы(Настройки, НоваяСКД);
		
	ИначеЕсли КлючВарианта = "Примечание" Тогда
		
		Настройки_Структура_Примечания(Настройки, НоваяСКД);
		Настройки_ВыбранныеПоля_Примечания(Настройки, НоваяСКД, Истина);
		
	КонецЕсли;

КонецПроцедуры

Процедура ДонастроитьНастройкиПоОтбору(Контекст, НоваяСКД, ПользовательскиеНастройки)

	Если ТипЗнч(Контекст) <> Тип("ФормаКлиентскогоПриложения") Тогда
		Возврат; 
	КонецЕсли;
	
	Если Не Контекст.ФормаПараметры.Свойство("Отбор") Или (Контекст.ФормаПараметры.Отбор.Количество() = 0) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиКД = НоваяСКД.ВариантыНастроек.Основной.Настройки;
	
	ПараметрыКД = НастройкиКД.ПараметрыДанных;
	ОтборыКД = НастройкиКД.Отбор;
	
	Для Каждого КлючИЗначение Из Контекст.ФормаПараметры.Отбор Цикл
		
 		Если КлючИЗначение.Ключ = "Группировка" Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = КлючИЗначение.Ключ;
		Значение = ПолучитьЗначениеОтбора(КлючИЗначение.Значение);
		
		ПараметрКД = ПараметрыКД.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
		Если (ТипЗнч(ПараметрКД) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных")) 
			И (ПараметрКД.РежимОтображения <> РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный) Тогда
			
			ПараметрКД.Использование	= Значение <> NULL;
			ПараметрКД.Значение			= Значение;
			
			Если ЗначениеЗаполнено(ПараметрКД.ИдентификаторПользовательскойНастройки) Тогда
				
				ЗначениеПН = ПользовательскиеНастройки.Элементы.Найти(ПараметрКД.ИдентификаторПользовательскойНастройки);
				Если ЗначениеПН <> Неопределено Тогда
					ЗначениеПН.Значение = Значение;
					ЗначениеПН.Использование = Значение <> NULL;
				КонецЕсли;
				
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		ИмяРеквизита = СтрРазделить(Имя, ".")[0];
		Если НоваяСКД.НаборыДанных[0].Поля.Найти(ИмяРеквизита) = Неопределено
			И НоваяСКД.ВычисляемыеПоля.Найти(ИмяРеквизита) = Неопределено Тогда
			
			Если Имя = "Отборы" Тогда
				Для каждого ЭлементОтбора Из Значение Цикл
					
					Если ТипЗнч(ЭлементОтбора.Значение) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
						Продолжить;
					КонецЕсли;
					
					ИмяОтбора = Строка(ЭлементОтбора.Значение.ЛевоеЗначение);
					Если НоваяСКД.НаборыДанных[0].Поля.Найти(СтрРазделить(ИмяОтбора, ".")[0]) <> Неопределено  Тогда
						ДобавитьИзменитьЭлементОтбора(НастройкиКД, ПользовательскиеНастройки, 
							ИмяОтбора, ЭлементОтбора.Значение.ПравоеЗначение, ЭлементОтбора.Значение.ВидСравнения);
					КонецЕсли;
						
				КонецЦикла;
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		ТипЗначенияОтбора = ТипЗнч(Значение);
		Если ТипЗначенияОтбора = Тип("СписокЗначений") Тогда
			Если Значение.Количество() Тогда
				ТипЗначенияОтбора = ТипЗнч(Значение.Получить(0).Значение);
			Иначе 
				ТипЗначенияОтбора = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТипЗначенияОтбора) И ОбщегоНазначения.ВидОбъектаПоТипу(ТипЗначенияОтбора) = "ПланСчетов" Тогда
			ВидСравненияКД = ВидСравненияКомпоновкиДанных.ВИерархии;
		Иначе 
			ВидСравненияКД = ПолучитьВидСравненияКД(Значение);
		КонецЕсли;
		
		ДобавитьИзменитьЭлементОтбора(НастройкиКД, ПользовательскиеНастройки, Имя, Значение, ВидСравненияКД);

	КонецЦикла;

	НастроитьГруппировки(Контекст.ФормаПараметры.Отбор, НастройкиКД, ПользовательскиеНастройки);
	
	НастройкиКД.ДополнительныеСвойства.Вставить("НеЗаполнятьВыводимыеРесурсы");
	
	Контекст.ФормаПараметры.Отбор.Очистить();// чтобы отбор не попал в фиксированные настройки
	
КонецПроцедуры

Функция ПолучитьВидСравненияКД(Значение)
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		ВидСравненияКД = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Значение, "ВидСравнения", ВидСравненияКомпоновкиДанных.Равно);
		Значение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Значение, "ПравоеЗначение");
	ИначеЕсли ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		ВидСравненияКД = ВидСравненияКомпоновкиДанных.ВСписке;
	Иначе
		ВидСравненияКД = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;
	
	Возврат ВидСравненияКД;

КонецФункции

Функция ПолучитьЗначениеОтбора(ЗначениеОтбора)
	
	Результат = ЗначениеОтбора;
	
	Если ТипЗнч(Результат) = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив(Результат);
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(Результат);
		
		Результат = Список;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ДобавитьИзменитьЭлементОтбора(НастройкиКД, ПользовательскиеНастройки, ИмяПоля, ЗначениеПоля, ВидСравненияКД)

	ОтборыКД = НастройкиКД.Отбор;
	
	ОтборУстановлен = Ложь;
	
	ЭлементыОтбора = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ОтборыКД, ИмяПоля);
	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если Не ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
			
			ОтборПН = ПользовательскиеНастройки.Элементы.Найти(ОтборыКД.ИдентификаторПользовательскойНастройки);
			Если ОтборПН <> Неопределено Тогда
				МСФОКлиентСерверУХ.ДобавитьИзменитьЭлементОтбора(ОтборПН, ИмяПоля, , ЗначениеПоля, ВидСравненияКД, ЗначениеПоля <> NULL);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		ЭлементОтбораПН = ПользовательскиеНастройки.Элементы.Найти(ЭлементОтбора.ИдентификаторПользовательскойНастройки);
		Если ЭлементОтбораПН = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементОтбораПН.ПравоеЗначение = ЗначениеПоля;
		ЭлементОтбораПН.Использование = ЗначениеПоля <> NULL;
		ЭлементОтбораПН.ВидСравнения = ВидСравненияКД;
		
	КонецЦикла;

	Если Не ОтборУстановлен Тогда
		МСФОКлиентСерверУХ.ДобавитьИзменитьЭлементОтбора(ОтборыКД, ИмяПоля, , ЗначениеПоля, ВидСравненияКД, Истина);
	КонецЕсли;

КонецФункции

Процедура НастроитьГруппировки(Отбор, НастройкиКД, ПользовательскиеНастройки)
	
	Если Не Отбор.Свойство("Группировка") Или (Отбор.Группировка = Неопределено) Тогда
		Возврат;
	КонецЕсли;
		
	ЭлементПН = ПользовательскаяНастройка(ПользовательскиеНастройки, НастройкиКД.Структура);
	Если ЭлементПН = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьПН = Истина;
	
	Для каждого Группировка Из Отбор.Группировка Цикл
		
		Если Не ЗначениеЗаполнено(Группировка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОчиститьПН Тогда
			ЭлементПН.Структура.Очистить();
			ОчиститьПН = Ложь;
		КонецЕсли;
		
		ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(ЭлементПН, Группировка);
		
	КонецЦикла;

КонецПроцедуры

Процедура ПриИзмененииСчета(НоваяСКД, НовыеНастройки, ПользовательскиеНастройки = Неопределено, КлючВарианта)
	
	ИмяПланаСчетов = ИмяПланаСчетовМД(НовыеНастройки);
	
	Счет = ПланыСчетов[ИмяПланаСчетов].ПустаяСсылка();
	ПараметрСчет = Новый ПараметрКомпоновкиДанных("Счет");
	ДвиженияССубконто = МСФОУХ.ЭтоВариантДвиженияССубконто(КлючВарианта);
	ЭтоОСВ = (КлючВарианта = "ОСВ") Или (КлючВарианта = "КОСВ");
	
	ТекущиеПН = ?(ПользовательскиеНастройки = Неопределено, КомпоновщикНастроек.ПользовательскиеНастройки, ПользовательскиеНастройки);
	Если ТекущиеПН <> Неопределено Тогда
		Для каждого ЭлементПН Из ТекущиеПН.Элементы Цикл
			Если ТипЗнч(ЭлементПН) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда 
				
				Если ЭлементПН.Параметр = ПараметрСчет Тогда
					Счет = ЭлементПН.Значение;
					Прервать;
				КонецЕсли;

			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Счет = ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НовыеНастройки, "Счет");//из расшифровки
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		НоваяСКД.Параметры.Счета.Значение.ЗагрузитьЗначения(УчетМСФОПовтИспУХ.ПолучитьСчетаВИерархии(Счет));
	Иначе
		НоваяСКД.Параметры.Счета.Значение.ЗагрузитьЗначения(Новый Массив);
	КонецЕсли;
	
	//для счета
	ЗначениеПараметра = НовыеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрСчет);
	Если (ЗначениеПараметра <> Неопределено)
		И ЗначениеПараметра.Использование 
		И (ЗначениеПараметра.РежимОтображения 
			<> РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный) Тогда
			
		// донастроим видимость субконто, если счет доступен в настройках
		МСФОВызовСервераУХ.ДоработатьСубконтоПоСчету(НоваяСКД, Счет);
	
	КонецЕсли;
	
	СвойстваСчета = УчетМСФОПовтИспУХ.ПолучитьСвойстваСчета(Счет);
	
	ОтборСКД = НовыеНастройки.Отбор;

	МаксСубконто = УчетМСФОПовтИспУХ.ПолучитьМаксКоличествоСубконто("МСФО");
	ЕстьСубконто = СвойстваСчета.Свойство("КоличествоСубконто");
	Для Индекс = 1 По МаксСубконто Цикл
		
		ПолеСКД = Новый ПолеКомпоновкиДанных("Субконто" + Индекс);
		МасОтборы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ОтборСКД, "Субконто" + Индекс);
		ДоступенОтборСубконто = ЕстьСубконто И (Индекс >= СвойстваСчета.КоличествоСубконто);
		Если Не ДоступенОтборСубконто Тогда
			
			Для каждого ТекЭлемент Из МасОтборы Цикл
				НовыеНастройки.Отбор.Элементы.Удалить(ТекЭлемент);
			КонецЦикла;
			
		ИначеЕсли МасОтборы.Количество() = 0 Тогда
			
			ОбщегоНазначенияКлиентСервер
				.УстановитьЭлементОтбора(
					ОтборСКД, 
					"Субконто" + Индекс,
					,
					ВидСравненияКомпоновкиДанных.Равно,
					,
					Ложь,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный,
					"ОтборСубконто" + Индекс);

		КонецЕсли;
		
		Если (ПользовательскиеНастройки <> Неопределено) 
			И (Индекс = 1) 
			И Не ДвиженияССубконто
			И Не ЭтоОСВ Тогда
			
			ПользовательскиеНастройки_ДобавитьГруппировкуСубконто(
				ПользовательскиеНастройки, НовыеНастройки, ПолеСКД, СвойстваСчета, Индекс);
			
		КонецЕсли;

	КонецЦикла;
	
	ПриИзмененииСчета_НастроитьПоказателиСчета(НовыеНастройки, СвойстваСчета, НоваяСКД, ПользовательскиеНастройки);
	
КонецПроцедуры

Процедура ПриИзмененииСубконто(Настройки, НоваяСКД)
	
	Перем ОписаниеРегистра, ВидСубконто;
	
	Настройки.ДополнительныеСвойства.Свойство("ОписаниеРегистра", ОписаниеРегистра);
	Настройки.ДополнительныеСвойства.Свойство("ВидСубконто", ВидСубконто);
	
	Если ЗначениеЗаполнено(ОписаниеРегистра) Тогда
		
		НоваяСКД.Параметры.ВидСубконто.ТипЗначения = ОписаниеРегистра.ТипыПараметров.ВидСубконто;
		НоваяСКД.Параметры.Субконто.ТипЗначения = ОписаниеРегистра.ТипыПараметров.Субконто;
		Если Не ОписаниеРегистра.ТипыПараметров.ВидСубконто.СодержитТип(ТипЗнч(ВидСубконто)) Тогда
			ТипПВХ = ОписаниеРегистра.ТипыПараметров.ВидСубконто.Типы()[0];
			Настройки.ДополнительныеСвойства.Вставить("ВидСубконто", Новый(ТипПВХ));
		КонецЕсли;
		
	КонецЕсли;
	
	ПолеСубконто1 = НоваяСКД.НаборыДанных.Получить(0).Поля.Найти("Субконто1");
	Отчеты.ОСВМСФО.ТипизироватьПолеСКД(ПолеСубконто1, ВидСубконто, НСтр("ru = 'Субконто 1'"));	
	Отчеты.ОСВМСФО.ТипизироватьПолеСКД(НоваяСКД.Параметры.Субконто, ВидСубконто, НСтр("ru = 'Субконто 1'"));
	
	Отчеты.ОСВМСФО.НастроитьОграниченияЗависимыхНаборов(НоваяСКД, ВидСубконто);
	
КонецПроцедуры

Функция ЕстьИзменениеПараметраПН(НастройкиСКД, ИмяПараметра)
	
	дс = НастройкиСКД.ДополнительныеСвойства;
	ПараметрНовый = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(дс.ТекущиеПараметрыПН, ИмяПараметра);
	ПараметрСтарый = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(дс, ИмяПараметра);

	Если ПараметрНовый = ПараметрСтарый Тогда
		Возврат Ложь;//не было изменения
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрНовый) Тогда
		Возврат Ложь;//Параметр не используется (например для ОСВ не используется "Счет")
	КонецЕсли;
	
	НастройкиСКД.ДополнительныеСвойства.Вставить(ИмяПараметра, ПараметрНовый);

	Возврат Истина;

КонецФункции

Процедура ДонастроитьПользовательскиеНастройки(КлючВариантаПредопределенный)
	
	Если СтрНайти(КлючВариантаПредопределенный, "Субконто") > 0 Тогда
		
		ПараметрКД = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Субконто"));
		ЗначениеПН = ПользовательскаяНастройка(КомпоновщикНастроек.ПользовательскиеНастройки, ПараметрКД);
		Если (ЗначениеПН <> Неопределено) И (ЗначениеПН.Значение = Неопределено) Тогда
			
			ПараметрКД1 = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВидСубконто"));
			ЗначениеПН1 = ПользовательскаяНастройка(КомпоновщикНастроек.ПользовательскиеНастройки, ПараметрКД1);
			Если ЗначениеПН1 <> Неопределено Тогда
				ЗначениеПН.Значение = Новый(ЗначениеПН1.Значение.ТипЗначения.Типы()[0]);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли СтрНайти(КлючВариантаПредопределенный, "Счет") > 0 Тогда
		
		ПараметрКД = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Счет"));
		ЗначениеПН = ПользовательскаяНастройка(КомпоновщикНастроек.ПользовательскиеНастройки, ПараметрКД);
		//Если ЗначениеПН.Значение = Неопределено Тогда
		//	ПараметрКД1 = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВидСубконто"));
		//	ЗначениеПН1 = ПользовательскаяНастройка(КомпоновщикНастроек.ПользовательскиеНастройки, ПараметрКД1);
		//	ЗначениеПН.Значение = Новый(ЗначениеПН1.Значение.Типы()[0]);
		//КонецЕсли;
		//
	КонецЕсли;

КонецПроцедуры

#Область СКД

Процедура ДобавитьПоляДвиженийССубконто(НоваяСКД, ФиксированныеПараметры)

	ПараметрыДетали = Новый Структура("ИмяТаблицы,ИмяОбъектаМетаданных,ТипОбъектаМетаданных");
	ЗаполнитьЗначенияСвойств(ПараметрыДетали, ФиксированныеПараметры);
	ПараметрыДетали.Вставить("ИмяТаблицы", "ДвиженияССубконто");
	
	ДеталиСКД = Отчеты.УниверсальныйОтчет.СхемаКомпоновкиДанных(ФиксированныеПараметры);
	
	ПоляПриемник = НоваяСКД.НаборыДанных.НаборДанных1.Поля;
	Для каждого ПолеИсточник Из ДеталиСКД.НаборыДанных.НаборДанных1.Поля Цикл
		
		Если ТипЗнч(ПолеИсточник) = Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных") Тогда
			Продолжить;
		ИначеЕсли ПоляПриемник.Найти(ПолеИсточник.ПутьКДанным) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НовоеПоле = ПоляПриемник.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НовоеПоле, ПолеИсточник);
		ЗаполнитьЗначенияСвойств(НовоеПоле.Роль, ПолеИсточник.Роль);
		
	КонецЦикла;
	
	Для каждого ПолеИтогаИсточник Из ДеталиСКД.ПоляИтога Цикл
		Если НоваяСКД.ПоляИтога.Найти(ПолеИтогаИсточник.ПутьКДанным) = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСКД.ПоляИтога.Добавить(), ПолеИтогаИсточник);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаОстаткиПоДокументам(ТекстЗапроса, КлючВарианта, ФиксированныеПараметры)
	
	ЕстьПсевдоним = СтрНайти(ТекстЗапроса, "ПсевдонимЗаданнойТаблицы") > 0;
	
	ТекстЗапросаДоработка 
	= СтрЗаменить(ТекстЗапроса, "Авто", "Авто, Движения, %2, %3")
	+ ?(СтрНайти(ТекстЗапроса, "втОстаткиИОбороты") > 0 ИЛИ ЕстьПсевдоним, "", " КАК втОстаткиИОбороты ")
	+ "
	|	{ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.%1.ДвиженияССубконто({&НачалоПериода}, {&КонецПериода} , %2 %4) КАК Детали
	|	ПО втОстаткиИОбороты.Регистратор = Детали.Регистратор
	|	И втОстаткиИОбороты.НомерСтроки = Детали.НомерСтроки}
	|	";
	
	Если ЕстьПсевдоним Тогда
		ТекстЗапросаДоработка = СтрЗаменить(ТекстЗапросаДоработка, "втОстаткиИОбороты", "ПсевдонимЗаданнойТаблицы");
	КонецЕсли;
	
	ОтборВидСубконто = "ВидСубконто1 В (&ВидСубконто) ИЛИ ВидСубконто2 В (&ВидСубконто) ИЛИ ВидСубконто3 В (&ВидСубконто)";
	
	ТекстСчет = ?(КлючВарианта = "КарточкаСчета", "&УсловиеСчета", "");
	ТекстСубконто = ?(КлючВарианта = "КарточкаСубконто", "&ВидСубконто", "");
	ТекстСубконтоДетали = ?(КлючВарианта = "КарточкаСубконто", ОтборВидСубконто, "");
	
	Если КлючВарианта = "ОтчетПоПроводкам" Тогда
		ТекстЗапросаДоработка = СтрЗаменить(ТекстЗапросаДоработка, 
			"{ЛЕВОЕ СОЕДИНЕНИЕ", "{ВНУТРЕННЕЕ СОЕДИНЕНИЕ");
	КонецЕсли;
	
	Возврат СтрШаблон(ТекстЗапросаДоработка, ФиксированныеПараметры.ИмяОбъектаМетаданных, 
				ТекстСчет, ТекстСубконто, ТекстСубконтоДетали);
	
КонецФункции

Функция ТекстЗапроса_Примечания(ТекстЗапроса)
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Авто", "Авто, &УсловиеСчета, ");
	Возврат ТекстЗапроса;// уберем заголовки полей корресподенций

	ТекстПоле = 
	"*, 
	|	ПоДт.ВидДвижения КАК ВидДвиженияДт, 
	|	ПоКт.ВидДвижения КАК ВидДвиженияКт,
	|	ЕстьNULL(ПоДт.ВидДвижения, ПоКт.ВидДвижения) КАК ВидДвижения
	|";

	ТекстСоединение =
	" КАК втОстаткиИОбороты
	|	{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КорреспонденцииВидовДвиженийМСФО КАК ПоДт
	|	ПО ПоДт.ПланСчетовБД = &ПланСчетовБД
	|	И втОстаткиИОбороты.Счет = ПоДт.СчетДт.СчетСсылка
	|	И втОстаткиИОбороты.КорСчет = ПоДт.СчетКт.СчетСсылка}
	|	{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КорреспонденцииВидовДвиженийМСФО КАК ПоКт
	|	ПО ПоКт.ПланСчетовБД = &ПланСчетовБД
	|	И втОстаткиИОбороты.Счет = ПоКт.СчетКт.СчетСсылка
	|	И втОстаткиИОбороты.КорСчет = ПоКт.СчетДт.СчетСсылка}
	|	";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Авто", "Авто, , &ВидСубконто, ");
	Возврат СтрЗаменить(ТекстЗапроса, "*", ТекстПоле) + ТекстСоединение;

КонецФункции

//устарела. НаборДанных_ДобавитьОбщийИтог
Функция ДобавитьНаборДанныхОбщиеИтоги(НоваяСКД, КлючВарианта, ФиксированныеПараметры)

	НаборИсточник = НоваяСКД.НаборыДанных.НаборДанных1;
	
	ндОстатки = НоваяСКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	ЗаполнитьЗначенияСвойств(ндОстатки, НаборИсточник, , "Имя,Поля");
	
	ндОстатки.Имя = "ОбщиеИтоги";
	
	Для каждого ПолеИсточник Из НаборИсточник.Поля Цикл
		
		Поле = ндОстатки.Поля.Добавить(ТипЗнч(ПолеИсточник));
		ЗаполнитьЗначенияСвойств(Поле, ПолеИсточник);
		
		ОбщееПоле = СтрНачинаетсяС(Поле.ПутьКДанным, "Период");
		Поле.ПутьКДанным = ?(ОбщееПоле, "", "ОбщиеИтоги.") + Поле.ПутьКДанным;// пути с основным НД не должны пересекаться
		
		Поле.ОграничениеИспользования.Поле = Истина;
		Поле.ОграничениеИспользования.Группировка = Истина;
		Поле.ОграничениеИспользования.Порядок = Истина;
		
	КонецЦикла;
	
	ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(ндОстатки, "Регистратор", НСтр("ru = 'Документ'"), "ОбщиеИтоги.Регистратор");
	ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(ндОстатки, "НомерСтроки",, "ОбщиеИтоги.НомерСтроки");
	
	ндОстатки.Запрос = СтрЗаменить(ндОстатки.Запрос, "Авто", "Авто, , %2, %3");

	ТекстСчет = ?(КлючВарианта = "КарточкаСчета", "&УсловиеСчета", "");
	ТекстСубконто = ?(КлючВарианта = "КарточкаСубконто", "&ВидСубконто", "");

	ндОстатки.Запрос = СтрШаблон(ндОстатки.Запрос, ФиксированныеПараметры.ИмяОбъектаМетаданных, ТекстСчет, ТекстСубконто);
	ндОстатки.Запрос = СтрЗаменить(ндОстатки.Запрос, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ 1 ");

	Связь = НоваяСКД.СвязиНаборовДанных.Добавить();
	Связь.НаборДанныхИсточник = "ОбщиеИтоги";
	Связь.НаборДанныхПриемник = "НаборДанных1";
	Связь.ВыражениеИсточник = "ИСТИНА";
	Связь.ВыражениеПриемник = "ИСТИНА";
	
КонецФункции

Функция НаборДанных_ДобавитьОбщийИтог(НоваяСКД, КлючВарианта, ФиксированныеПараметры)

	НаборИсточник = НоваяСКД.НаборыДанных.НаборДанных1;
	ТекстЗапроса_Итоги = НаборИсточник.Запрос;
	
	Текст_ПоляИтога = Новый Массив;
	Для каждого ПолеИсточник Из НаборИсточник.Поля Цикл
		
		Если ТипЗнч(ПолеИсточник) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
			Продолжить;
		ИначеЕсли (ПолеИсточник.Роль.ТипОстатка <> ТипОстаткаКомпоновкиДанных.НачальныйОстаток) 
			И (ПолеИсточник.Роль.ТипОстатка <> ТипОстаткаКомпоновкиДанных.КонечныйОстаток) Тогда
			Продолжить;
		ИначеЕсли СтрНачинаетсяС(ПолеИсточник.Поле, "ОбщиеИтоги_") Тогда
			Продолжить;
		КонецЕсли;
		
		Текст_ПоляИтога.Добавить(СтрШаблон("%1 КАК ОбщиеИтоги_%1", ПолеИсточник.ПутьКДанным));
		
		Поле = НаборИсточник.Поля.Добавить(ТипЗнч(ПолеИсточник));
		Поле.Поле = "ОбщиеИтоги_" + ПолеИсточник.Поле;
		ЗаполнитьЗначенияСвойств(Поле, ПолеИсточник,, "Поле");
		
		Поле.ПутьКДанным = "ОбщиеИтоги." + Поле.ПутьКДанным;// пути с основным НД не должны пересекаться
		
		Поле.ОграничениеИспользования.Поле = Истина;
		Поле.ОграничениеИспользования.Группировка = Истина;
		Поле.ОграничениеИспользования.Порядок = Истина;
		
	КонецЦикла;
	
	ТекстЗапроса_Итоги = СтрЗаменить(ТекстЗапроса_Итоги, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ 1 ");
	ТекстЗапроса_Итоги = СтрЗаменить(ТекстЗапроса_Итоги, "*",  СтрСоединить(Текст_ПоляИтога, "," + Символы.ПС) + " ПОМЕСТИТЬ втОбщиеИтоги");
	
	ТекстСоединение = " ПРАВОЕ СОЕДИНЕНИЕ втОбщиеИтоги КАК втОбщиеИтоги ПО ИСТИНА";
	Если СтрНайти(НаборИсточник.Запрос, "ПсевдонимЗаданнойТаблицы") = 0 Тогда
		ТекстСоединение = " КАК втОстаткиИОбороты" + ТекстСоединение;
	КонецЕсли;
	
	НаборИсточник.Запрос = СтрШаблон(
	"%1 
	|; 
	|%2 
	|%3", 
	ТекстЗапроса_Итоги, НаборИсточник.Запрос, ТекстСоединение);
		
КонецФункции

Функция ДобавитьПараметрОтбор(СхемаКД, ИмяПараметра, Использование = Истина, ЗначениеПоУмолчанию = Неопределено, ТипПараметра = Неопределено)
	
	ПараметрСчет = СхемаКД.Параметры.Найти(ИмяПараметра);
	Если ПараметрСчет = Неопределено Тогда
		Счет = ПланыСчетов.МСФО.ПустаяСсылка();
		ПараметрСчет = ТиповыеОтчетыУХ.ДобавитьПараметрВСхему(СхемаКД.Параметры, ИмяПараметра, ЗначениеПоУмолчанию);
	Иначе 
		ПараметрСчет.Значение = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ПараметрСчет.ТипЗначения				= ТипПараметра;
	ПараметрСчет.Использование 				= ?(Использование, ИспользованиеПараметраКомпоновкиДанных.Всегда, ИспользованиеПараметраКомпоновкиДанных.Авто);
	ПараметрСчет.ВключатьВДоступныеПоля 	= Использование;
	ПараметрСчет.ОграничениеИспользования 	= Не Использование;
		
	НовыеНастройки = СхемаКД.ВариантыНастроек.Основной.Настройки;
	
	НовыйПараметр = ТиповыеОтчетыУХ.ДобавитьПараметр(НовыеНастройки, ИмяПараметра, ЗначениеПоУмолчанию);
	НовыйПараметр.Использование = Использование;
	НовыйПараметр.РежимОтображения = ?(Использование, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	НовыйПараметр.ИдентификаторПользовательскойНастройки = ("ПараметрОтбор" + ИмяПараметра);

	МСФОКлиентСерверУХ.ДобавитьИзменитьЭлементОтбора(
			НовыеНастройки.Отбор, 
			ИмяПараметра, 
			, 
			Новый ПолеКомпоновкиДанных("ПараметрыДанных." + ИмяПараметра),
			ВидСравненияКомпоновкиДанных.ВИерархии,
			Использование,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный,
			
		);

	Если СтрНайти(ИмяПараметра, "Субконто") <> 0 Тогда
		//** связи параметров выбора
		Возврат ПараметрСчет;
	КонецЕсли;

	Возврат ПараметрСчет;
	
КонецФункции

Процедура ВычисляемыеПоля_ДобавитьПоРесурсам(СхемаКД, ДоступныеРесурсы, КлючВарианта, ФиксированныеПараметры)

	ПоДеталям = МСФОУХ.ЭтоВариантДвиженияССубконто(КлючВарианта);
	ПоляНД = Отчеты.ОСВМСФО.ОсновнойНаборДанных(СхемаКД).Поля;
	
	Если ПоДеталям Тогда
		
		ЗаголовокСальдоНаНачало = НСтр("ru = '""Сальдо на начало""'");
		Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, "СальдоНаНачало", ЗаголовокСальдоНаНачало, " ");
		
		Поле.ВыражениеПредставления = ЗаголовокСальдоНаНачало;
		Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 10);
		Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Формат"), "ДЛФ=D");
		
	КонецЕсли;
	
	ПараметрыРесурсов = ПолучитьПараметрыРесурсов(КлючВарианта, ФиксированныеПараметры);	
	Выражение = Неопределено;
	ГруппировкиРесурса = Неопределено;
	
	РесурсыРБ = Метаданные.РегистрыБухгалтерии[ФиксированныеПараметры.ИмяОбъектаМетаданных].Ресурсы;
	
	Для каждого ТекущийРесурс Из РесурсыРБ Цикл
		
		Если НЕ ПараметрыРесурсов.Заголовки.Свойство(ТекущийРесурс.Имя, Выражение) Тогда
			Выражение = СтрШаблон("""%1""", ТекущийРесурс.Синоним);
		КонецЕсли;
		
		Ресурс = ДоступныеРесурсы.НайтиПоЗначению(ТекущийРесурс.Имя);
		Если Ресурс = Неопределено И Не ФиксированныеПараметры.ФормироватьПроводкиМСФО Тогда
			Продолжить;//для АОСВ - количество не выводим в заголовках
		КонецЕсли;
		
		ЕстьПризнакУчета = (ТекущийРесурс.ПризнакУчета <> Неопределено);
		
		ПараметрыРесурсов.Группировки.Свойство(ТекущийРесурс.Имя, ГруппировкиРесурса);
		
		ВычисляемыеПоля_ДобавитьЗаголовокРесурса(СхемаКД, ТекущийРесурс, Выражение, ГруппировкиРесурса, ЕстьПризнакУчета);

		Если Не ПоДеталям Тогда
			Продолжить;
		КонецЕсли;
		
		Если Ресурс = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ВычисляемыеПоля_ДобавитьОборотыРесурсов(	СхемаКД, ТекущийРесурс, ПараметрыРесурсов, ЕстьПризнакУчета, ГруппировкиРесурса, КлючВарианта);		
		ВычисляемыеПоля_ДобавитьСтороныСальдо(		СхемаКД, ТекущийРесурс, ПараметрыРесурсов, ЕстьПризнакУчета);
		ВычисляемыеПоля_ДобавитьСальдоПоказателя(	СхемаКД, ТекущийРесурс, ПараметрыРесурсов, ЕстьПризнакУчета);
		
	КонецЦикла;
	
КонецПроцедуры

#Область ВычисляемыеПоля_ДобавитьПоРесурсам

Функция ПолучитьПараметрыРесурсов(КлючВарианта, ФиксированныеПараметры)

	Если ФиксированныеПараметры.ИмяОбъектаМетаданных = "Хозрасчетный" Тогда
		Возврат ПолучитьПараметрыРесурсовРСБУ(КлючВарианта, ФиксированныеПараметры);
	КонецЕсли;
	
	Группировки = Новый Структура;
	Группировки.Вставить("Ресурсов", 	Новый Структура("СуммаВВалюте", СтрРазделить("Валюта", ",")));
	Группировки.Вставить("Начало", 		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("СальдоНаНачало"));
	Группировки.Вставить("Конец", 		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ОбщийИтог"));

	ЗаголовкиПоказателей = Новый Структура;
	ЗаголовкиПоказателей.Вставить("СуммаВВалютеУчета", 		СтрШаблон("""%1""", НСтр("ru = 'ФВ'; en = 'FC'")));
	ЗаголовкиПоказателей.Вставить("СуммаВВалютеОтчетности", СтрШаблон("""%1""", НСтр("ru = 'ОВ'; en = 'RC'")));
	ЗаголовкиПоказателей.Вставить("СуммаВВалюте", 			ЗаголовокВалютный(КлючВарианта));
	ЗаголовкиПоказателей.Вставить("Количество", 			НСтр("ru = '""Кол.""'; en = 'Qty.'"));

	Шаблоны = Новый Структура;
	
	Шаблоны.Вставить("Сумма", 		"СУММА(%1)");	
	Шаблоны.Вставить("Максимум", 	"МАКСИМУМ(%1)");
	Шаблоны.Вставить("ИтогСальдо",  "ВЫЧИСЛИТЬВЫРАЖЕНИЕ(""МАКСИМУМ(%1)"",,,""%2"",""%2"")");
	Шаблоны.Вставить("Сторона", 	"ВЫБОР КОГДА %1 <> 0 ТОГДА ""Д"" КОГДА %2 <> 0 ТОГДА ""К"" КОНЕЦ");
	Шаблоны.Вставить("Сальдо", 		"ВЫБОР КОГДА %1 <> 0 ТОГДА %1 КОГДА %2 <> 0 ТОГДА %2 КОНЕЦ");
	Шаблоны.Вставить("ПолеОстатка", "Остатки.%1%2");
	
	Возврат Новый Структура("Группировки,Заголовки,Шаблоны", Группировки, ЗаголовкиПоказателей, Шаблоны);

КонецФункции

Функция ПолучитьПараметрыРесурсовРСБУ(КлючВарианта, ФиксированныеПараметры)

	Группировки = Новый Структура;
	Группировки.Вставить("Ресурсов", 	Новый Структура("ВалютнаяСумма", СтрРазделить("Валюта", ",")));
	Группировки.Вставить("Начало", 		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("СальдоНаНачало"));
	Группировки.Вставить("Конец", 		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ОбщийИтог"));

	ЗаголовкиПоказателей = Новый Структура;
	ЗаголовкиПоказателей.Вставить("Сумма", 			СтрШаблон("""%1""", НСтр("ru = 'ФВ'; en = 'FC'")));
