Процедура Настройки_Структура_Примечания(Настройки, НоваяСКД)
	
	ВидСубконто = Настройки.ДополнительныеСвойства.ВидСубконто;
	ТипСубконто = Тип("СправочникСсылка.Контрагенты");//по умолчанию
	Если ЗначениеЗаполнено(ВидСубконто) Тогда
		ТипСубконто = ВидСубконто.ТипЗначения.Типы()[0];
	КонецЕсли;
	
	ПутьКласса = МСФОКлиентСерверУХ.ПутьКлассОбъектаУчета(ТипСубконто);
	ПутьКласса = ?(ЗначениеЗаполнено(ПутьКласса), "Субконто1." + ПутьКласса, "Субконто1");
	
	Узел = Настройки.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
	Узел.Строки.ИдентификаторПользовательскойНастройки = "СтрокиПримечания";
	Узел.Колонки.ИдентификаторПользовательскойНастройки = "КолонкиПримечания";
	
	ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(Узел.Строки, "ВидОперации");
	ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(Узел.Колонки, ПутьКласса);

КонецПроцедуры

Процедура Настройки_Порядок_Период(Настройки, НоваяСКД)

	ЭлементПорядок = ТиповыеОтчетыУХ.ДобавитьПорядок(Настройки, "Период", Истина);
	ЭлементПорядок.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

КонецПроцедуры

Процедура ПользовательскиеНастройки_ДобавитьГруппировкуСубконто(
	ПользовательскиеНастройки, НовыеНастройки, ПолеСКД, СвойстваСчета, Индекс)
	
	ЕстьСубконто = СвойстваСчета.Свойство("КоличествоСубконто");//счет не указан, напр. АнализСчета
	ДоступнаГруппировкаСубконто = ЕстьСубконто И (СвойстваСчета.КоличествоСубконто >= Индекс);
	СтруктурыСоСчетами = ПользовательскаяНастройка(ПользовательскиеНастройки, НовыеНастройки.Структура);
	Если СтруктурыСоСчетами <> Неопределено Тогда
		ГруппировкаСубконто1 = ТиповыеОтчетыУХ.НайтиЭлементСтруктурыПоПолюГруппировки(СтруктурыСоСчетами.Структура, ПолеСКД);	
	КонецЕсли;		
	
	Если СтруктурыСоСчетами = Неопределено Тогда
		Возврат;//сохраненный вариант 
	ИначеЕсли ДоступнаГруппировкаСубконто И (ГруппировкаСубконто1 = Неопределено) Тогда
		ГруппировкаСубконто = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(СтруктурыСоСчетами, ПолеСКД);
	ИначеЕсли Не ДоступнаГруппировкаСубконто И (ГруппировкаСубконто1 <> Неопределено) Тогда
		СтруктурыСоСчетами.Структура.Удалить(ГруппировкаСубконто1);
	КонецЕсли;

КонецПроцедуры

Процедура Настройки_УсловноеОформление_Период(Настройки, НоваяСКД)

	ЭлементУО = Настройки.УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Период");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("АвтоОтступ", 0);
		
КонецПроцедуры

