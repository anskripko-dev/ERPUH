	Шаблоны = Новый Структура;
	
	Шаблоны.Вставить("Сумма", 		"СУММА(%1)");
	Шаблоны.Вставить("Максимум", 	"МАКСИМУМ(%1)");
	Шаблоны.Вставить("ИтогСальдо",  "ВЫЧИСЛИТЬВЫРАЖЕНИЕ(""МАКСИМУМ(%1)"",,,""%2"",""%2"")");
	Шаблоны.Вставить("Сторона", 	"ВЫБОР КОГДА %1 <> 0 ТОГДА ""Д"" КОГДА %2 <> 0 ТОГДА ""К"" КОНЕЦ");
	Шаблоны.Вставить("Сальдо", 		"ВЫБОР КОГДА %1 <> 0 ТОГДА %1 КОГДА %2 <> 0 ТОГДА %2 КОНЕЦ");
	Шаблоны.Вставить("ПолеОстатка", "Остатки.%1%2");
	
	Возврат Новый Структура("Группировки,Заголовки,Шаблоны", Группировки, ЗаголовкиПоказателей, Шаблоны);

КонецФункции

Процедура ВычисляемыеПоля_ДобавитьЗаголовокРесурса(СхемаКД, ТекущийРесурс, Выражение, ГруппировкиРесурса, ЕстьПризнакУчета)
	
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, "Заголовки." + ТекущийРесурс.Имя, Выражение, ТекущийРесурс.Синоним);
	Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 9);
	
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, "Заголовки." + ТекущийРесурс.Имя, Выражение, ГруппировкиРесурса);

КонецПроцедуры

Процедура ВычисляемыеПоля_ДобавитьОборотыРесурсов(СхемаКД, ТекущийРесурс, ПараметрыРесурсов, ЕстьПризнакУчета, ГруппировкиРесурса, КлючВарианта)
	
	Шаблоны = ПараметрыРесурсов.Шаблоны;
	ПутьИсточник = "Ресурсы." + ТекущийРесурс.Имя;
	
	Если КлючВарианта = "ОтчетПоПроводкам" Тогда
		
		ВыражениеДт = ТекущийРесурс.Имя + ?(ЕстьПризнакУчета, "ОборотДт", "");
		ВыражениеКт = ТекущийРесурс.Имя + ?(ЕстьПризнакУчета, "ОборотКт", "");
		
	ИначеЕсли КлючВарианта = "КарточкаСубконто" Тогда
		
		Шаблон = "ВЫБОР КОГДА ВидСубконто%(1)1 В (&ВидСубконто) ИЛИ ВидСубконто%(1)2 В (&ВидСубконто) ИЛИ ВидСубконто%(1)2 В (&ВидСубконто) ТОГДА %2 ИНАЧЕ 0 КОНЕЦ";
		ВыражениеДт = СтрШаблон(Шаблон, "Дт", ПутьИсточник + "ОборотДт");
		ВыражениеКт = СтрШаблон(Шаблон, "Кт", ПутьИсточник + "ОборотКт");
		
	Иначе 
		
		Шаблон = "ВЫБОР КОГДА Счет%1 В (&Счета) ТОГДА %2 ИНАЧЕ 0 КОНЕЦ";
		ВыражениеДт = СтрШаблон(Шаблон, "Дт", ПутьИсточник + "ОборотДт");
		ВыражениеКт = СтрШаблон(Шаблон, "Кт", ПутьИсточник + "ОборотКт");
		
	КонецЕсли;
	
	Путь = "Ресурсы.Оборот." + ТекущийРесурс.Имя + "Дт";
	Заголовок = ТекущийРесурс.Синоним + НСтр("ru = ' Дебет'");
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, Путь, ВыражениеДт, Заголовок);
	ОформитьПолеРесурсаНабораДанных(Поле);
	
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", СтрШаблон(Шаблоны.Сумма, Путь)), ГруппировкиРесурса);
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, """""", ПараметрыРесурсов.Группировки.Начало);
	
	Путь = "Ресурсы.Оборот." + ТекущийРесурс.Имя + "Кт";
	Заголовок = ТекущийРесурс.Синоним + НСтр("ru = ' Кредит'");
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, Путь, ВыражениеКт, Заголовок);
	ОформитьПолеРесурсаНабораДанных(Поле);
	
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", СтрШаблон(Шаблоны.Сумма, Путь)), ГруппировкиРесурса);
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, """""", ПараметрыРесурсов.Группировки.Начало);

КонецПроцедуры

Процедура ВычисляемыеПоля_ДобавитьСальдоПоказателя(СхемаКД, ТекущийРесурс, ПараметрыРесурсов, ЕстьПризнакУчета)
	
	Шаблоны = ПараметрыРесурсов.Шаблоны;
	
	ПутьИсточник = "Ресурсы." + ТекущийРесурс.Имя;
	ПутьИтог = "Ресурсы.ОбщиеИтоги." + ТекущийРесурс.Имя;
	Путь = "Ресурсы.КонечныйОстаток." + ТекущийРесурс.Имя + "ТекущееСальдо";
	Заголовок = ТекущийРесурс.Синоним + НСтр("ru = ' текущее сальдо на конец'");
	Выражение = СтрШаблон(Шаблоны.Сальдо, ПутьИсточник + "КонечныйОстатокДт", ПутьИсточник + "КонечныйОстатокКт");
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, Путь, Выражение, Заголовок);
	ОформитьПолеРесурсаНабораДанных(Поле);
	
	ВыражениеОстатка = СтрШаблон(Шаблоны.Сальдо, ПутьИсточник + "КонечныйОстатокДт", ПутьИсточник + "КонечныйОстатокКт");
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", ВыражениеОстатка));
	
	ВыражениеОстатка = СтрШаблон(Шаблоны.Сальдо, ПутьИтог + "КонечныйОстатокДт", ПутьИтог + "КонечныйОстатокКт");
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", СтрШаблон(Шаблоны.Максимум, ВыражениеОстатка)), ПараметрыРесурсов.Группировки.Конец);
	
	ВыражениеОстатка = СтрШаблон(Шаблоны.Сальдо, ПутьИтог + "НачальныйОстатокДт", ПутьИтог + "НачальныйОстатокКт");
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", СтрШаблон(Шаблоны.Максимум, ВыражениеОстатка)), ПараметрыРесурсов.Группировки.Начало);

КонецПроцедуры

Процедура ВычисляемыеПоля_ДобавитьСтороныСальдо(СхемаКД, ТекущийРесурс, ПараметрыРесурсов, ЕстьПризнакУчета)
	
	Шаблоны = ПараметрыРесурсов.Шаблоны;
	
	ПутьИсточник = "Ресурсы." + ТекущийРесурс.Имя;
	ПутьИтог = "Ресурсы.ОбщиеИтоги." + ТекущийРесурс.Имя;
	Путь = "Ресурсы.КонечныйОстаток." + ТекущийРесурс.Имя + "СторонаСальдо";
	Заголовок = ТекущийРесурс.Синоним + НСтр("ru = ' сторона сальдо на конец'");
	
	Выражение = СтрШаблон(Шаблоны.Сторона, ПутьИсточник + "КонечныйОстатокДт", ПутьИсточник + "КонечныйОстатокКт");
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, Путь, Выражение, Заголовок);
	Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 2);
	
	ВыражениеОстатка = СтрШаблон(Шаблоны.Сторона, ПутьИсточник + "КонечныйОстатокДт", ПутьИсточник + "КонечныйОстатокКт");
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", ВыражениеОстатка));
		
	ВыражениеОстатка = СтрШаблон(Шаблоны.Сторона, ПутьИтог + "КонечныйОстатокДт", ПутьИтог + "КонечныйОстатокКт");
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", СтрШаблон(Шаблоны.Максимум, ВыражениеОстатка)), ПараметрыРесурсов.Группировки.Конец);
	
	ВыражениеОстатка = СтрШаблон(Шаблоны.Сторона, ПутьИтог + "НачальныйОстатокДт", ПутьИтог + "НачальныйОстатокКт");
	ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(СхемаКД, Путь, ?(ЕстьПризнакУчета, """""", СтрШаблон(Шаблоны.Максимум, ВыражениеОстатка)), ПараметрыРесурсов.Группировки.Начало);
	
КонецПроцедуры

Процедура ВычисляемыеПоля_ДобавитьАналитику(СхемаКД, ПоДеталям)
	
	ФорматТипОперации = СтрШаблон("БЛ='%1'; БИ='%2'", НСтр("ru = 'Корректировка МСФО'"), НСтр("ru = 'Трансляция НСБУ'"));
	
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, "ТипОперации", "", НСтр("ru = 'Тип операции'"));
	Поле.Выражение = "ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Трансляция)";
	Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 16);
	Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Формат"), ФорматТипОперации);
	
	Если Не ПоДеталям Тогда
		Возврат;
	КонецЕсли;
	
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, "АналитикаДт", "", НСтр("ru = 'Аналитика Дт'"));
	Поле.Выражение = "Регистратор";
	Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 16);
		
	Поле = ТиповыеОтчетыУХ.ДобавитьВычисляемоеПоле(СхемаКД, "АналитикаКт", "", НСтр("ru = 'Аналитика Кт'"));
	Поле.Выражение = "Регистратор";
	Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 16);
	
	ВычисляемыеМакета = Новый Массив;
	ВычисляемыеМакета.Добавить(СхемаКомпоновкиДанных.ВычисляемыеПоля.Найти("ЗабалансовыйСчет"));
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ВычисляемыеМакета, СхемаКД.ВычисляемыеПоля);
		
КонецПроцедуры

Процедура ОформитьПолеРесурсаНабораДанных(ПолеНабораДанных)
	ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 16);
КонецПроцедуры

#КонецОбласти

Процедура ПоляИтогов_ДозаполнитьПоВарианту(НоваяСКД, ПоДеталям)
	
	Если ПоДеталям Тогда
		
		//чтобы счета были между ресурсами СКД - они тоже должны быть ресурсами СКД  
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, "СчетДт", """""");
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, "СчетКт", """""");
		
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, "Регистратор", """""");
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, "НомерСтроки", "МАКСИМУМ(НомерСтроки)");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПараметрыСхемы_ЗаполнитьСоставАналитики(НоваяСКД, ОписаниеРегистра, ПоДеталям = Истина)

	ПараметрАналитика = МСФОВызовСервераУХ.УстановитьИспользованиеПараметраСхемы(НоваяСКД, "СоставАналитики", ПоДеталям);
	
	Если Не ПоДеталям Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеЗначения = Новый СписокЗначений;
	
	Для каждого _ Из ОписаниеРегистра.Измерения Цикл
		
		Если (_.Значение.Балансовый = Ложь) 
			И ЗначениеЗаполнено(_.Значение.ПризнакУчета) 
			И (_.Значение.Имя <> "Валюта") Тогда
		
			ДоступныеЗначения.Добавить(_.Значение.Имя, _.Представление, Истина);
		
		КонецЕсли;

	КонецЦикла;
	
	Для _ = 1 По УчетМСФОПовтИспУХ.ПолучитьМаксКоличествоСубконто("МСФО") Цикл
		ДоступныеЗначения.Добавить("Субконто" + _, НСтр("ru = 'Субконто '") + _, Истина);
	КонецЦикла;

	ПараметрАналитика.УстановитьДоступныеЗначения(ДоступныеЗначения);
	ПараметрАналитика.Значение = ДоступныеЗначения;

КонецПроцедуры

Процедура НаборыДанных_ДобавитьЗависимыеНаборы(НоваяСКД, ФиксированныеПараметры, КлючВарианта)
	
	ЭтоДетали = (КлючВарианта = "КарточкаСчета") 
				Или (КлючВарианта = "КарточкаСубконто") 
				Или (КлючВарианта = "ОтчетПоПроводкам");

	Если ЭтоДетали Тогда
		Отчеты.ОСВМСФО.ДобавитьЗависимыйНаборДетали(НоваяСКД, ФиксированныеПараметры);
	Иначе 
		Отчеты.ОСВМСФО.ДобавитьЗависимыйНаборОстатки(НоваяСКД, ФиксированныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура НаборыДанных_ПереработатьДляБухИтогов(НоваяСКД, ФиксированныеПараметры, КлючВарианта)
	
	КлючПоПримечанию = КлючПоПримечанию(КлючВарианта);
	ЭтоАнализСчета = СтрНайти(КлючВарианта, "АнализСчета") > 0;
	
	Если Не КлючПоПримечанию И Не ЭтоАнализСчета Тогда
		Возврат;
	КонецЕсли;
	
	ИсточникДанныхОСВ = НоваяСКД.ИсточникиДанных[0];
	НаборОСВ = НоваяСКД.НаборыДанных.НаборДанных1;
	
 	НаборБухИтоги = ТиповыеОтчетыУХ.ДобавитьНаборДанныхОбъединение(
		НоваяСКД.НаборыДанных, Неопределено, "НаборБухИтоги");
		
	ТипПолеНабора = Тип("ПолеНабораДанныхСхемыКомпоновкиДанных");
	
	Для каждого ПолеИсточник Из НаборОСВ.Поля Цикл
		
		ПолеПриемник = НаборыДанных_СкопироватьПоле(НаборБухИтоги, ПолеИсточник);
		
		//у полей через точку дб поля как пути
		Если СтрНачинаетсяС(ПолеПриемник.ПутьКДанным, "Периоды") 
			И ТипЗнч(ПолеПриемник) = ТипПолеНабора Тогда
			ПолеПриемник.Поле = ПолеПриемник.ПутьКДанным;
		КонецЕсли;
		
	КонецЦикла;
	
	НаборОборот = ТиповыеОтчетыУХ.ДобавитьНаборДанныхЗапрос(
		НаборБухИтоги.Элементы,
		ИсточникДанныхОСВ,
		"НаборОборот");
	
	ЗаполнитьЗначенияСвойств(НаборОборот, НаборОСВ, , "Имя, Поля");
	
	Для каждого ПолеИсточник Из НаборОСВ.Поля Цикл
		ПолеПриемник = НаборыДанных_СкопироватьПоле(НаборОборот, ПолеИсточник);
		Если СтрНачинаетсяС(ПолеПриемник.ПутьКДанным, "Ресурсы.") Тогда
			ПолеПриемник.ПутьКДанным = СтрЗаменить(ПолеПриемник.ПутьКДанным, "Ресурсы.", "");
		КонецЕсли;
	КонецЦикла;
	
	НаборыДанных_ДобавитьНаборыОстатки(
		НаборБухИтоги,
		НаборОСВ,
		ФиксированныеПараметры,
		ИсточникДанныхОСВ);
		
	НоваяСКД.НаборыДанных.Удалить(НаборОСВ);
	
КонецПроцедуры

Процедура НаборыДанных_ДобавитьНаборыОстатки(НаборБухИтоги, НаборОСВ, ФиксированныеПараметры, ИсточникДанныхОСВ)
	
	ФиксированныеПараметрыОстатки = ОбщегоНазначенияКлиентСервер
		.СкопироватьРекурсивно(ФиксированныеПараметры);
		
	ФиксированныеПараметрыОстатки.Вставить("ИмяТаблицы", "Остатки");
	
	СКД_Остатки = Отчеты.УниверсальныйОтчет
		.СхемаКомпоновкиДанных(ФиксированныеПараметрыОстатки);
	
	НаборОстатки = СКД_Остатки.НаборыДанных.НаборДанных1;
	НаборОстатки.Запрос = СтрЗаменить(НаборОстатки.Запрос, ")", "&УсловиеСчета)");
	Для каждого ПолеОстаток Из НаборОстатки.Поля Цикл
		ПолеОстаток.ПутьКДанным = СтрЗаменить(ПолеОстаток.ПутьКДанным, "Остаток", "Оборот");
	КонецЦикла;
	
	ИмяБухИтога = 1;
	НаборПриемник = ТиповыеОтчетыУХ.ДобавитьНаборДанныхЗапрос(
		НаборБухИтоги.Элементы, ИсточникДанныхОСВ, "НаборНачальныйОстаток");
	НаборыДанных_ДоработатьОстаток(НаборПриемник, НаборОстатки, ИмяБухИтога);
	НаборПриемник.Запрос = СтрЗаменить(НаборПриемник.Запрос, "&КонецПериода", "&НачалоПериода");
	НаборПриемник.Запрос = СтрЗаменить(НаборПриемник.Запрос, "&УсловиеСчета", "&УсловиеСчета И &ЕстьБухИтоги");
	
	ИмяБухИтога = 3;
	НаборПриемник = ТиповыеОтчетыУХ.ДобавитьНаборДанныхЗапрос(
		НаборБухИтоги.Элементы, ИсточникДанныхОСВ, "НаборКонечныйОстаток");
	НаборыДанных_ДоработатьОстаток(НаборПриемник, НаборОстатки, ИмяБухИтога);
	НаборПриемник.Запрос = СтрЗаменить(НаборПриемник.Запрос, "&КонецПериода", "ДОБАВИТЬКДАТЕ(&КонецПериода,СЕКУНДА,1)");//Особенность "РБ.Остатки("
	НаборПриемник.Запрос = СтрЗаменить(НаборПриемник.Запрос, "&УсловиеСчета", "&УсловиеСчета И &ЕстьБухИтоги");
	
КонецПроцедуры

Процедура НаборыДанных_ДоработатьОстаток(НаборПриемник, НаборОстатки, ИмяБухИтога)
		
	ЗаполнитьЗначенияСвойств(НаборПриемник, НаборОстатки, , "Имя, Поля");

	ТекстЗамена = СтрШаблон(" %1 КАК БухИтог, *", ИмяБухИтога);
	НаборПриемник.Запрос = СтрЗаменить(НаборОстатки.Запрос, "*", ТекстЗамена);
	
	Для каждого ПолеИсточник Из НаборОстатки.Поля Цикл
		НаборыДанных_СкопироватьПоле(НаборПриемник, ПолеИсточник);
	КонецЦикла;

КонецПроцедуры

Процедура НаборыДанных_ДоработатьПоля(НоваяСКД, ОписаниеРегистра, КлючВарианта)
	
	Измерения = ПолучитьПоляИзмерений(ОписаниеРегистра);
	ЭтоДетали = МСФОУХ.ЭтоВариантДвиженияССубконто(КлючВарианта);
	
	СписокПериодов = ПолучитьПоляПериодов();
	ТипПериода = ТипПериодаКомпоновкиДанных.Основной;
	
	НаборыДанных_ДобавитьПоля(НоваяСКД, ЭтоДетали);
		
	Для каждого НаборДанных Из НоваяСКД.НаборыДанных Цикл
		
		Если НаборДанных.Имя = "ОбщиеИтоги" Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ПолеНабораДанных Из НаборДанных.Поля Цикл
			
			Если ТипЗнч(ПолеНабораДанных) = Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных") Тогда
				Продолжить;
			ИначеЕсли ПолеНабораДанных.ПутьКДанным = "Счет" Тогда
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 35);
			ИначеЕсли (ПолеНабораДанных.ПутьКДанным = "СчетДт") или ПолеНабораДанных.ПутьКДанным = "СчетКт" Тогда
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 11);
			ИначеЕсли ПолеНабораДанных.ПутьКДанным = "Регистратор" Тогда
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 18);
			ИначеЕсли СтрНачинаетсяС(ПолеНабораДанных.ПутьКДанным, "Субконто") Тогда
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 40);
				ПолеНабораДанных.Роль.ИгнорироватьЗначенияNULL = Ложь;//если группировка по Субконто2-субконто1 и субконто2 нет на субчете - надо вывести все равно и субконто2 и субконто1
			ИначеЕсли Измерения.Получить(ПолеНабораДанных.ПутьКДанным) <> Неопределено Тогда
				ОформитьПолеИзмерения(ПолеНабораДанных, Измерения);
			ИначеЕсли ПолеНабораДанных.ПутьКДанным = "Период" Тогда
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 10);
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Формат"), "ДЛФ=D");
			ИначеЕсли ПолеНабораДанных.ПутьКДанным = "КорСчет" Тогда
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 35);
			ИначеЕсли ПолеНабораДанных.ПутьКДанным = "БухИтог" Тогда
				ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 10);
			Иначе
				
				ОписаниеПериода = СписокПериодов.НайтиПоЗначению(ПолеНабораДанных.Поле);
				Если ОписаниеПериода <> Неопределено Тогда
					ОформитьПолеПериода(ПолеНабораДанных, ТипПериода, ОписаниеПериода, СписокПериодов);
				Иначе //ресурс
					
					ОформитьПолеРесурсаНабораДанных(ПолеНабораДанных);
					
					Если ЭтоДетали Тогда
						
						ДоработатьРесурсВариантаДетали(ПолеНабораДанных);
						
					ИначеЕсли (КлючВарианта = "ОСВ") Или (КлючВарианта = "КОСВ") Тогда // в ОСВ важны не свернутые сальдо, для остальных остатки по периодам

						ЭтоСвернутыйОстаток = СтрНайти(ПолеНабораДанных.Поле, "Остаток") > 0 
							И СтрНайти(ПолеНабораДанных.Поле, "Развернутый") = 0;
							
						//для свернутого остатка оставляем настройки из УнОтч, остальным устанавливаем роль - для БухОстатков
						Если Не ЭтоСвернутыйОстаток Тогда

							ПолеНабораДанных.Роль.Остаток = Ложь;
							ПолеНабораДанных.Роль.ГруппаОстатка = "";
							ПолеНабораДанных.Роль.ТипОстатка = ТипОстаткаКомпоновкиДанных.Нет;
							ПолеНабораДанных.Роль.ТипБухгалтерскогоОстатка = ТипБухгалтерскогоОстаткаКомпоновкиДанных.Нет;
							ПолеНабораДанных.Роль.ПолеСчета = "";

						КонецЕсли;

					ИначеЕсли ЗначениеЗаполнено(ПолеНабораДанных.Роль.ПолеСчета) И СтрЗаканчиваетсяНа(ПолеНабораДанных.ПутьКДанным, "Дт") Тогда 
						ПолеНабораДанных.Роль.ТипБухгалтерскогоОстатка = ТипБухгалтерскогоОстаткаКомпоновкиДанных.Дебет;
					ИначеЕсли ЗначениеЗаполнено(ПолеНабораДанных.Роль.ПолеСчета) И СтрЗаканчиваетсяНа(ПолеНабораДанных.ПутьКДанным, "Кт") Тогда 
						ПолеНабораДанных.Роль.ТипБухгалтерскогоОстатка = ТипБухгалтерскогоОстаткаКомпоновкиДанных.Кредит;
					КонецЕсли;
					
					СтарыйПуть = ПолеНабораДанных.ПутьКДанным;
					НовыйПуть = "Ресурсы." + ПолеНабораДанных.ПутьКДанным;
					
					ПолеНабораДанных.ПутьКДанным = НовыйПуть;
					ПолеИтога = НоваяСКД.ПоляИтога.Найти(СтарыйПуть);
					Если ПолеИтога <> Неопределено Тогда
						ПолеИтога.ПутьКДанным = НовыйПуть;
						ПолеИтога.Выражение = СтрЗаменить(ПолеИтога.Выражение, СтарыйПуть, НовыйПуть);
					КонецЕсли;
					
				КонецЕсли;

			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура НаборыДанных_ДобавитьПоля(НоваяСКД, ЭтоДетали)

	НаборОСВ = НоваяСКД.НаборыДанных[0];
	
	Если НаборОСВ.Поля.Найти("Регистратор") = Неопределено Тогда
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НаборОСВ, "Регистратор", НСтр("ru = 'Документ'"));
	КонецЕсли;
	
	ПолеНомерСтроки = ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НаборОСВ, "НомерСтроки", НСтр("ru = 'Запись'"));
	ПолеНомерСтроки.ВыражениеПредставления = "ПРЕДСТАВЛЕНИЕ(Регистратор)";
	
	Если ЭтоДетали Тогда
		
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НаборОСВ, "СчетДт",	НСтр("ru = 'Счет Дт'"));
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НаборОСВ, "СчетКт",	НСтр("ru = 'Счет Кт'"));
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НаборОСВ, "КорСчет",	НСтр("ru = 'Корр счет'"));
		
		ПолеНД = ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НаборОСВ, "Период", 	НСтр("ru = 'Дата'"));
		
		//ПолеНД.Роль.ТипПериода		= ТипПериодаКомпоновкиДанных.Дополнительный;
		//ПолеНД.Роль.НомерПериода	= 1;
		ПолеНД.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("АвтоОтступ"), 0);
		
	КонецЕсли;

	НаборыДанных_ДобавитьПолеБухИтог(НаборОСВ);
	
КонецПроцедуры

Процедура НаборыДанных_ДобавитьПолеБухИтог(НаборОСВ)
	
	ПолеБИ = ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НаборОСВ, "БухИтог", 	НСтр("ru = 'Бух. итог'"));
	Выражение = "ВЫБОР БухИтог КОГДА 1 ТОГДА ""%1"" КОГДА 2 ТОГДА ""%2"" КОГДА 3 ТОГДА ""%3"" КОНЕЦ";
	
	ПолеБИ.ВыражениеПредставления = СтрШаблон(Выражение,
		НСтр("ru = 'Начальный остаток'"),
		НСтр("ru = 'Оборот'"),
		НСтр("ru = 'Конечный остаток'"));
		
	ПолеБИ.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("АвтоОтступ"), 0);
	ПолеБИ.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 10);

КонецПроцедуры

Функция НаборыДанных_СкопироватьПоле(НаборДанныхПриемник, ПолеИсточник)

	ПолеПриемник = НаборДанныхПриемник.Поля.Добавить(Тип(ПолеИсточник));
	ЗаполнитьЗначенияСвойств(ПолеПриемник, ПолеИсточник);
	
	Возврат ПолеПриемник;
	
КонецФункции 

Процедура ДоработатьРесурсВариантаДетали(ПолеНабораДанных)

	Суффикс = "";
	
	Если СтрНайти(ПолеНабораДанных.ПутьКДанным, "Оборот") Тогда
		ПолеНабораДанных.Роль.Остаток = Ложь;
		Возврат;
	ИначеЕсли СтрНайти(ПолеНабораДанных.ПутьКДанным, "Развернутый") Тогда
		ПолеНабораДанных.Роль.Остаток = Ложь;
		Возврат;
	ИначеЕсли СтрНайти(ПолеНабораДанных.ПутьКДанным, "НачальныйОстаток") > 0 Тогда
		
		ПолеНабораДанных.Роль.ТипОстатка = ТипОстаткаКомпоновкиДанных.НачальныйОстаток;
		Суффикс = Суффикс + "НачальныйОстаток";
		
		ПолеНабораДанных.Роль.ПолеСчета = "Счет";
	
	ИначеЕсли СтрНайти(ПолеНабораДанных.ПутьКДанным, "КонечныйОстаток") > 0 Тогда
		
		ПолеНабораДанных.Роль.ТипОстатка = ТипОстаткаКомпоновкиДанных.КонечныйОстаток;
		Суффикс = Суффикс + "КонечныйОстаток";
		
		ПолеНабораДанных.Роль.ПолеСчета = "Счет";

	ИначеЕсли СтрНайти(ПолеНабораДанных.ПутьКДанным, "Оборот") Тогда 
		Суффикс = Суффикс + "Оборот";
	Иначе 
		Возврат;
	КонецЕсли;
		
	Если СтрЗаканчиваетсяНа(ПолеНабораДанных.ПутьКДанным, "Дт") Тогда
		ПолеНабораДанных.Роль.ТипБухгалтерскогоОстатка = ТипБухгалтерскогоОстаткаКомпоновкиДанных.Дебет;
		Суффикс = Суффикс + "Дт";
	ИначеЕсли СтрЗаканчиваетсяНа(ПолеНабораДанных.ПутьКДанным, "Кт") Тогда
		ПолеНабораДанных.Роль.ТипБухгалтерскогоОстатка = ТипБухгалтерскогоОстаткаКомпоновкиДанных.Кредит;
		Суффикс = Суффикс + "Кт";
	Иначе 
		ПолеНабораДанных.Роль.Остаток = Ложь;
		Возврат;
	КонецЕсли;
	
	ПолеНабораДанных.Роль.Остаток = Истина;
	ПолеНабораДанных.Роль.ГруппаОстатка = СтрЗаменить(ПолеНабораДанных.ПутьКДанным, Суффикс, "");
		
КонецПроцедуры

Процедура ДобавитьПоляИтогиСальдо(НоваяСКД, ОписаниеРегистра)
	
	ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НоваяСКД.НаборыДанных[0], "Период");
	
	Для каждого Ресурс Из ОписаниеРегистра.Ресурсы Цикл
		
		ИмяПоля = Ресурс.Значение + "КонечныйОстатокДт";
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НоваяСКД.НаборыДанных[0], ИмяПоля, НСтр("ru = 'Сальдо дебет '") + Ресурс.Представление);
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, ИмяПоля, СтрШаблон("СУММА(%1)", ИмяПоля) );
		
		ИмяПоля = Ресурс.Значение + "КонечныйОстатокКт";
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НоваяСКД.НаборыДанных[0], ИмяПоля, НСтр("ru = 'Сальдо кредит '") + Ресурс.Представление);
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, ИмяПоля, СтрШаблон("СУММА(%1)", ИмяПоля) );
		
		ИмяПоля = Ресурс.Значение + "НачальныйОстатокДт";
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НоваяСКД.НаборыДанных[0], ИмяПоля, НСтр("ru = 'Остаток на начало дебет '") + Ресурс.Представление);
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, ИмяПоля, СтрШаблон("СУММА(%1)", ИмяПоля) );
		
		ИмяПоля = Ресурс.Значение + "НачальныйОстатокКт";
		ТиповыеОтчетыУХ.ДобавитьПолеНабораДанных(НоваяСКД.НаборыДанных[0], ИмяПоля, НСтр("ru = 'Остаток на начало кредит '") + Ресурс.Представление);
		ТиповыеОтчетыУХ.ДобавитьПолеИтогаСКД(НоваяСКД, ИмяПоля, СтрШаблон("СУММА(%1)", ИмяПоля) );
		
	КонецЦикла;

КонецПроцедуры

Процедура ОформитьПолеИзмерения(Поле, Измерения)
	
	Поле.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 40);
	Если Измерения.Получить(Поле.ПутьКДанным) Тогда
		//Поле.ПутьКДанным = "Измерения." + Поле.ПутьКДанным;
		Поле.Роль.ИгнорироватьЗначенияNULL = Истина;//см. ОбновитьВыводНулл
	КонецЕсли;

КонецПроцедуры

Процедура ОформитьПолеПериода(ПолеНабораДанных, ТипПериода, Период, СписокПериодов)
	
	ПолеНабораДанных.Заголовок   			= Период.Представление;
	ПолеНабораДанных.ПутьКДанным 			= "Периоды." + Период.Значение;
	ПолеНабораДанных.Роль.ТипПериода 		= ТипПериода;
	ПолеНабораДанных.Роль.НомерПериода 		= СписокПериодов.Индекс(Период)+1;
	
	Если Период.Значение = "Регистратор" Или Период.Значение = "НомерСтроки" Тогда
		ПолеНабораДанных.ПутьКДанным = Период.Значение;
		ПолеНабораДанных.Оформление.УстановитьЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МаксимальнаяШирина"), 21);
	Иначе 
		ПолеНабораДанных.ВыражениеПредставления	= НСтр("ru = '""Обороты за "" + '") + ВыражениеПредставленияПериода(Период.Значение);
	КонецЕсли;
	
	ТипПериода = ТипПериодаКомпоновкиДанных.Дополнительный;

КонецПроцедуры

Функция ПолучитьПоляИзмерений(ОписаниеРегистра)
	
	Измерения = Новый Соответствие;
	Для каждого _ Из ОписаниеРегистра.Измерения Цикл
		Измерения.Вставить(_.Значение.Имя, _.Значение.ПризнакУчета <> "");
	КонецЦикла;
	
	Возврат Измерения;

КонецФункции

