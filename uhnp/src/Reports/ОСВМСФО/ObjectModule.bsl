#Область ПриКомпоновкеРезультата

Функция ПолучитьЗначенияПараметров(НастройкиСКД, КлючВарианта)

	Результат = Новый Структура(
		"ВыводимыеРесурсы, ВариантДетали, РазвернутоеСальдо,
		|ВыводитьЗабалансовыеСчета, Период, СоставАналитики, Счет,
		|Организация, ВыводитьНаименованиеСчета, ШаблонЗаголовка,
		|ОграничитьУровниСчетов, ФормироватьПроводкиМСФО",
			Новый СписокЗначений, Ложь, Ложь,
			Ложь,,,,
			, Ложь, ,
			0, Истина);
	
	Для каждого _ Из Результат Цикл	
		
		ПараметрСКД = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(_.Ключ));
		Если (ПараметрСКД <> Неопределено) И ПараметрСКД.Использование Тогда
			
			Если ТипЗнч(ПараметрСКД.Значение) = Тип("Строка") И (_.Ключ = "СоставАналитики" Или _.Ключ = "ВыводимыеРесурсы") Тогда
				СписокЗначений = Новый СписокЗначений;
				СписокЗначений.Добавить(ПараметрСКД.Значение);
				Результат.Вставить(_.Ключ, СписокЗначений);
			Иначе
				Результат.Вставить(_.Ключ, ПараметрСКД.Значение);
			КонецЕсли;

			Продолжить;

		КонецЕсли;
		
		ЭлементыОтбора = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(НастройкиСКД.Отбор, _.Ключ);
		Если ЭлементыОтбора.Количество() И ЭлементыОтбора[0].Использование Тогда
			Результат.Вставить(_.Ключ, ЭлементыОтбора[0].ПравоеЗначение);
		КонецЕсли;
	
	КонецЦикла;
	
	Корень 				= НастройкиСКД.Структура;
	ПолеБухИтог 		= Новый ПолеКомпоновкиДанных("БухИтог");
	ГруппировкаБухИтог	= ТиповыеОтчетыУХ.НайтиЭлементСтруктурыПоПолюГруппировки(Корень, ПолеБухИтог);
	
	ЕстьБухИтоги = ГруппировкаБухИтог <> Неопределено 
		И ГруппировкаБухИтог.Использование = Истина
		И ГруппировкаБухИтог.Состояние = СостояниеЭлементаНастройкиКомпоновкиДанных.Включен;
	Результат.Вставить("ЕстьБухИтоги", ЕстьБухИтоги);
	Результат.Вставить("ВариантДетали", МСФОУХ.ЭтоВариантДвиженияССубконто(КлючВарианта));
	
	Возврат Результат;
	
КонецФункции

Процедура СКД_ВычисляемыеПоля_СальдоАналитика(Отбор)

	Если Не Отбор.ВариантДетали Или Не ЗначениеЗаполнено(Отбор.СоставАналитики) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонВыраженияАналитики = СтрЗаменить(МСФОУХ.ПолучитьШаблонВыраженияАналитики(Отбор.СоставАналитики), "Проводка.", "");
	//ШаблонСальдо = "ВычислитьВыражение(""ЕСТЬNULL(СУММА(%1Дт),0) - ЕСТЬNULL(СУММА(%1Кт),0)"" ,,, ""Первая"", ""Текущая"")  + ЕСТЬNULL(%1НачальныйОстаток,0)";
	
	Для каждого ВычисляемоеПоле Из СхемаКомпоновкиДанных.ВычисляемыеПоля Цикл
		
		Если ВычисляемоеПоле.ПутьКДанным = "АналитикаДт" Тогда
		    ВычисляемоеПоле.ВыражениеПредставления = ШаблонВыраженияАналитики;
		ИначеЕсли ВычисляемоеПоле.ПутьКДанным = "АналитикаКт" Тогда 
			ВычисляемоеПоле.ВыражениеПредставления = СтрЗаменить(ШаблонВыраженияАналитики, "Дт", "Кт");
		//ИначеЕсли СтрНачинаетсяС(ВычисляемоеПоле.ПутьКДанным, "Сальдо.") Тогда
		//	
		//	ВидСальдо = Сред(ВычисляемоеПоле.ПутьКДанным, 8);			
		//	ВычисляемоеПоле.Выражение = СтрШаблон(ШаблонСальдо, ВидСальдо);
		//	
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура Компоновщик_Структура(НастройкиСКД, Отбор, КлючВарианта)
	
	Корень = НастройкиСКД.Структура;
	ДолжнаБытьВалюта = (Отбор.ВыводимыеРесурсы.НайтиПоЗначению("СуммаВВалюте") <> Неопределено);
	
	ПерваяГруппировка = Корень.Получить(0);
	УдаленПользователем = СостояниеЭлементаНастройкиКомпоновкиДанных.УдаленПользователем;
	Если МСФОКлиентСерверУХ.ПоляОбъекта(ПерваяГруппировка, "Состояние").Состояние = УдаленПользователем Тогда
		//Структура была перенастроена в обычных настройках и стала различаться с пользовательскими - поэтому она была удалена
		//Соглашение - у обычных приоритет, поэтому их восстанавливаем, пользовательские теперь неактуальны
		ПерваяГруппировка.Состояние = СостояниеЭлементаНастройкиКомпоновкиДанных.Включен;
	КонецЕсли;
	
	ПолеВалюта 			= Новый ПолеКомпоновкиДанных("Валюта");
	ПолеСчет 			= Новый ПолеКомпоновкиДанных("Счет");
	ГруппировкаВалюта 	= ТиповыеОтчетыУХ.НайтиЭлементСтруктурыПоПолюГруппировки(Корень, ПолеВалюта);
	ГруппировкаСчет 	= ТиповыеОтчетыУХ.НайтиЭлементСтруктурыПоПолюГруппировки(Корень, ПолеСчет);
	
	Компоновщик_Структура_ГруппировкаСчет(КлючВарианта, Отбор, НастройкиСКД, ГруппировкаСчет);

	Если ДолжнаБытьВалюта И (ГруппировкаВалюта = Неопределено) 
		И (КлючВарианта <> "Примечание") Тогда
		
		Группировки = ТиповыеОтчетыУХ.ПолучитьГруппировки(Новый Структура("Настройки", НастройкиСКД));
		
		Родитель = ?(Группировки.Количество(), Группировки[Группировки.Количество()-1].Значение, НастройкиСКД);
		Если Родитель.ПоляГруппировки.Элементы.Количество() Тогда //добавить Валюту в конец группировок
			ГруппировкаВалюта = ДобавитьГруппировкуВалюта(Родитель, ПолеВалюта, Отбор, НастройкиСКД);
		Иначе
			ГруппировкаВалюта = Родитель;
		КонецЕсли;
		
		Для каждого Группировка Из Родитель.Структура Цикл
			Если Группировка <> ГруппировкаВалюта Тогда
				ПеренестиЭлементСтруктуры(ГруппировкаВалюта, Группировка);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Не ДолжнаБытьВалюта И (ГруппировкаВалюта <> Неопределено) Тогда
		
		Если ГруппировкаВалюта.Родитель = Неопределено Тогда
			НастройкиСКД.Структура.Удалить(ГруппировкаВалюта);
		Иначе
			ГруппировкаВалюта.Родитель.Элементы.Удалить(ГруппировкаВалюта);
		КонецЕсли;
		
	КонецЕсли;
	
	Компоновщик_Порядок_Период(НастройкиСКД);
	Компоновщик_Структура_БухИтог(НастройкиСКД, Отбор, КлючВарианта)

КонецПроцедуры

Процедура ПеренестиЭлементСтруктуры(РодительПриемник, ЭлементИсточник)

	ГруппировкаНовая = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(
		РодительПриемник, ЭлементИсточник.ПоляГруппировки.Элементы[0].Поле);
		
	ГруппировкаНовая.Выбор.Элементы.Очистить();
	ГруппировкаНовая.ПоляГруппировки.Элементы.Очистить();
	
	ТиповыеОтчетыУХ.СкопироватьНастройкиКомпоновкиДанных(ГруппировкаНовая, ЭлементИсточник);
	ЭлементИсточник.Родитель.Структура.Удалить(ЭлементИсточник);

КонецПроцедуры

Процедура Компоновщик_Структура_ГруппировкаСчет(КлючВарианта, Отбор, НастройкиСКД, ГруппировкаСчет)
	
	Если ГруппировкаСчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоДеталям = МСФОУХ.ЭтоВариантДвиженияССубконто(КлючВарианта);
	Если ПоДеталям Тогда
		Возврат;
	КонецЕсли;
	
	ГруппировкаСчет.ПараметрыВывода.УстановитьЗначениеПараметра(
		"ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	
	//освПоСчету и остальные выводят неправильные суммы вверх по иерархии
	ОграничитьУровниСчетов = Отбор.ОграничитьУровниСчетов;
	ЕстьУровни = ЗначениеЗаполнено(ОграничитьУровниСчетов);
	Если ЕстьУровни Тогда
		Для каждого ПолеГруппировки Из ГруппировкаСчет.ПоляГруппировки.Элементы Цикл
			ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
		КонецЦикла;
	КонецЕсли;
		
	ОтборСчета = ГруппировкаСчет.Отбор;
	ПолеПоиска = "SystemFields.LevelInGroup";
	ПредставлениеОтбора = НСтр("ru = 'Ограничить вывод уровней счетов до '") + ОграничитьУровниСчетов;
	
	ЭлементыОтбора = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ОтборСчета, ПолеПоиска);
	Если Не ЗначениеЗаполнено(ЭлементыОтбора) Тогда
		
		ЭлементОтбора = ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
			ОтборСчета, ПолеПоиска, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, 
			ОграничитьУровниСчетов, ПредставлениеОтбора, ЕстьУровни, 
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			
		ЭлементОтбора.Применение = ТипПримененияОтбораКомпоновкиДанных.Иерархия;
		ОтборСчета.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	Иначе
		Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
			ЭлементОтбора.Использование = ЕстьУровни;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Компоновщик_Порядок_Период(НастройкиСКД)

	Если НастройкиСКД.Порядок.Элементы.Количество() Тогда
		Возврат; //уже добавлено
	КонецЕсли;
	
	ПолеПериод = Новый ПолеКомпоновкиДанных("Период");
	ПолеПорядка = НастройкиСКД.ДоступныеПоляПорядка.НайтиПоле(ПолеПериод);
	Если ПолеПорядка = Неопределено Тогда 
		Возврат; //период не доступен
	КонецЕсли;
	
	ПолеПорядка = ТиповыеОтчетыУХ.ДобавитьПорядок(НастройкиСКД, ПолеПериод, Истина);
	ПолеПорядка.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры

Процедура Компоновщик_Структура_БухИтог(НастройкиСКД, Отбор, КлючВарианта)
	
	Корень 				= НастройкиСКД.Структура;
	ПолеБухИтог 		= Новый ПолеКомпоновкиДанных("БухИтог");
	ГруппировкаБухИтог	= ТиповыеОтчетыУХ.НайтиЭлементСтруктурыПоПолюГруппировки(Корень, ПолеБухИтог);
	ЕстьБухИтог 		= (ГруппировкаБухИтог <> Неопределено)
							И ГруппировкаБухИтог.Использование = Истина
							И ГруппировкаБухИтог.Состояние = СостояниеЭлементаНастройкиКомпоновкиДанных.Включен;
	
	Контекст = Новый Структура("Настройки", НастройкиСКД);
	ГруппировкиБухИтогов = ТиповыеОтчетыУХ.ПолучитьГруппировки(Контекст);
	Для каждого ГруппировкаБухИтогов Из ГруппировкиБухИтогов Цикл
		
		ЭлементыОтбора = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(
			ГруппировкаБухИтогов.Значение.Отбор, "БухИтог");
			
		Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
			ЭлементОтбора.Родитель.Элементы.Удалить(ЭлементОтбора);
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЕстьБухИтог Тогда
		Для каждого ДочернийБухИтог Из ГруппировкаБухИтог.Структура Цикл
			
			Узел = ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
				ДочернийБухИтог.Отбор,
				"БухИтог",
				ВидСравненияКомпоновкиДанных.Равно,
				2,
				"ОтборБухИтог",
				Истина,
				РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			
		КонецЦикла;
	КонецЕсли;
	
	РасположениеОбщихИтогов = РасположениеИтоговКомпоновкиДанных.Авто;
	ВыводитьОтбор = ТипВыводаТекстаКомпоновкиДанных.Авто;
	
	Если ЕстьБухИтог Тогда
		
		РасположениеОбщихИтогов = РасположениеИтоговКомпоновкиДанных.Нет;
		ВыводитьОтбор = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
		
	КонецЕсли;
	
	НастройкиСКД.ПараметрыВывода.УстановитьЗначениеПараметра(
		"ГоризонтальноеРасположениеОбщихИтогов", РасположениеОбщихИтогов);
	НастройкиСКД.ПараметрыВывода.УстановитьЗначениеПараметра(
		"ВертикальноеРасположениеОбщихИтогов", РасположениеОбщихИтогов);
	
	Если ЕстьБухИтог Тогда
		Для каждого ГруппировкаДочерняя Из ГруппировкаБухИтог.Структура Цикл
			ГруппировкаДочерняя.ПараметрыВывода.УстановитьЗначениеПараметра(
				"ВыводитьОтбор", ВыводитьОтбор);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьГруппировкуВалюта(СтруктураРодитель, ПолеВалюта, Отбор, СтруктураКорень)
	
	ГруппировкаВалюта = ТиповыеОтчетыУХ.ДобавитьГруппировкуСтруктуры(СтруктураРодитель, ПолеВалюта);
	ГруппировкаВалюта.Выбор.Элементы.Очистить();
	
	ТиповыеОтчетыУХ.СкопироватьЭлементы(ГруппировкаВалюта.Выбор, СтруктураКорень.Выбор, , Ложь);
	
	ВыбранныеПоля = ТиповыеОтчетыУХ.ПолучитьВыбранныеПоля(ГруппировкаВалюта.Выбор, Ложь);
	ШаблоныПолей = МСФОУХ.ПолучитьШаблоныПолейРесурса(Неопределено, Отбор.ВариантДетали);
	ПоляПоказателя = СтрРазделить(СтрШаблон(ШаблоныПолей, "СуммаВВалюте"), ",");//привязка к рб
	Для каждого Поле Из ВыбранныеПоля Цикл
		Если (Поле.Использование = Ложь) И (ПоляПоказателя.Найти(Строка(Поле.Поле)) <> Неопределено) Тогда
			Поле.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ГруппировкаВалюта; 

КонецФункции

Процедура Компоновщик_ПараметрыДанных(НастройкиСКД, Отбор, КлючВарианта)
	
	ТиповыеОтчетыУХ.УстановитьПараметр(НастройкиСКД, "ЕстьБухИтоги", Отбор.ЕстьБухИтоги);
	
	Если Отбор.ФормироватьПроводкиМСФО Тогда //для ТУ - ПериодОтчета нужен только для ДанныеРегламента 
		
		ВыбранныеПоля = ТиповыеОтчетыУХ.ПолучитьВыбранныеПоля(НастройкиСКД.Выбор);
		ЕстьДанныеРегламента = Ложь;
		
		Для каждого ВыбранноеПоле Из ВыбранныеПоля Цикл
			Если ВыбранноеПоле.Использование И СтрНачинаетсяС(ВыбранноеПоле.Поле, "Организация") Тогда
				ЕстьДанныеРегламента = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьДанныеРегламента Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Период = ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "Период");
	Сценарий = ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "Сценарий");
	ПериодыОтчета = МСФОВызовСервераУХ.ПериодыОтчетаПоДатам(Период.ДатаНачала, Период.ДатаОкончания, Сценарий);
	
	ТиповыеОтчетыУХ.УстановитьПараметр(НастройкиСКД, "ПериодыОтчета", ПериодыОтчета);
	
	Если ПериодыОтчета.Количество() Тогда
		
		ТиповыеОтчетыУХ.УстановитьПараметр(
			НастройкиСКД, "ПериодСценарияНачало", ПериодыОтчета[0]);
			
		ТиповыеОтчетыУХ.УстановитьПараметр(
			НастройкиСКД, "ПериодСценарияОкончание", ПериодыОтчета[ПериодыОтчета.ВГраница()]);
			
	КонецЕсли;
	
КонецПроцедуры

Процедура Компоновщик_Отбор(НастройкиСКД, Отбор, КлючВарианта)

	Параметр = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("Субконто"));
		
	Если (Параметр <> Неопределено) И (Параметр.Использование) Тогда
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкиСКД.Отбор,
			"Субконто1", ВидСравненияКомпоновкиДанных.Равно, Параметр.Значение, , 
			Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			
	КонецЕсли;
	
	пСценарий = СхемаКомпоновкиДанных.Параметры.Найти("Сценарий");
	ЕстьСценарий = (пСценарий.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда);
	
