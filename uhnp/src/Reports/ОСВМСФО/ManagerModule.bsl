// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;

	МодульВариантыОтчетов = ОбщегоНазначения.ОбщийМодуль("ВариантыОтчетов");
	МодульВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Ложь);
	
	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	Для каждого ТекущийВариант Из Схема.ВариантыНастроек Цикл
		
		НастройкиВарианта = МодульВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, ТекущийВариант.Имя);
		НастройкиВарианта.Описание = ТекущийВариант.Представление;

	КонецЦикла;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

// Добавляет команду отчета в список команд.
// 
// Параметры:
//   КомандыОтчетов - см. ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.КомандыОтчетов
// Возвращаемое значение:
//   СтрокаТаблицыЗначений - новая команда отчета.
Функция ДобавитьКомандуОтчета(КомандыОтчетов, КлючВарианта = "") Экспорт
	
	Результат = Неопределено;
	КомандаОтчет 				= КомандыОтчетов.Добавить();
	КомандаОтчет.Менеджер 		= Метаданные.Отчеты.ОСВМСФО.ПолноеИмя();
	Если ЗначениеЗаполнено(КлючВарианта) Тогда
		КомандаОтчет.КлючВарианта = КлючВарианта;
	КонецЕсли;

	КомандаОтчет.Представление 	= НСтр("ru = 'Анализ субконто (МСФО)'");
	КомандаОтчет.МножественныйВыбор 	= Ложь;
	КомандаОтчет.Важность 				= "Обычное";
	КомандаОтчет.ИмяПараметраФормы 		= "Отбор.Субконто1";
	ПараметрыФормы = Новый Структура;
	ДатаНачала = НачалоГода(ТекущаяДата());
	ПериодОтчета = Новый СтандартныйПериод(ДатаНачала, КонецГода(ТекущаяДата()));
	ПараметрыФормы.Вставить("Период", 			ПериодОтчета);
	ПараметрыФормы.Вставить("Сценарий", 		Константы.СценарийМСФО.Получить());
	ПараметрыФормы.Вставить("ВидСубконто", 		ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникДоговораКонтрагентов);
	//	
	//Результат.Вставить("Организация", 	Ссылка.Организация);
	КомандаОтчет.ПараметрыФормы 		= ПараметрыФормы;
		
	Возврат КомандаОтчет;
	
КонецФункции

#КонецОбласти

#Область ЗависимыеНаборы

Функция ДобавитьЗависимыйНаборДетали(НоваяСКД, ФиксированныеПараметры) Экспорт
	
	//удалим НаборыОстатки если есть
	УдалитьНаборыПоПрефиксу(НоваяСКД, "ДанныеНаНачалоПериода");
	УдалитьНаборыПоПрефиксу(НоваяСКД, "ДанныеНаКонецПериода");
	
	Дт = НСтр("ru = 'По дебету'");
	Кт = НСтр("ru = 'По кредиту'");
	Нач = НСтр("ru = 'На начало периода'");
	Кон = НСтр("ru = 'На конец периода'");

	НаборОСВ = НоваяСКД.НаборыДанных[0];
	ДобавитьПапкиЗависимыхНаборов(НаборОСВ, "ПоДебету", Дт);
	ДобавитьПапкиЗависимыхНаборов(НаборОСВ, "ПоКредиту", Кт);
	
	ПапкиНаборов = Новый Структура("ДанныеДебет, ДанныеКредит", 
		ЗаменыНачало(Нач), ЗаменыКонец(Кон));
		
	МакетРСБУ = ПолучитьМакетОСВРСБУ();
	Для каждого ПапкаНабора Из ПапкиНаборов Цикл
		ДобавитьЗависимыеРСБУ(НоваяСКД, МакетРСБУ, ПапкаНабора.Ключ, ПапкаНабора.Значение);
	КонецЦикла;
	
	//МСФО
	МакетМСФО = ПолучитьМакетОСВМСФО();
	
	Для каждого ПапкаНабора Из ПапкиНаборов Цикл
		ДобавитьЗависимыеМСФО(НоваяСКД, МакетМСФО, ПапкаНабора.Ключ, ПапкаНабора.Значение);
	КонецЦикла;
	
	ДобавитьВидДвиженияТУ(НоваяСКД, МакетМСФО, ФиксированныеПараметры);
	
КонецФункции

Функция ДобавитьЗависимыйНаборОстатки(НоваяСКД, ФиксированныеПараметры) Экспорт
	
	//удалим НаборыДетали если есть
	УдалитьНаборыПоПрефиксу(НоваяСКД, "ДанныеДебет");
	УдалитьНаборыПоПрефиксу(НоваяСКД, "ДанныеКредит");
	
	Нач = НСтр("ru = 'На начало периода'");
	Кон = НСтр("ru = 'На конец периода'");
	
	НаборОСВ = НоваяСКД.НаборыДанных[0];
	ДобавитьПапкиЗависимыхНаборов(НаборОСВ, "НаНачалоПериода", Нач);
	ДобавитьПапкиЗависимыхНаборов(НаборОСВ, "НаКонецПериода", Кон);
		
	ПапкиНаборов = Новый Структура("НаНачалоПериода, НаКонецПериода", 
		ЗаменыНачало(Нач), ЗаменыКонец(Кон));
		
	//РСБУ
	МакетРСБУ = ПолучитьМакетОСВРСБУ();
	Для каждого ПапкаНабора Из ПапкиНаборов Цикл
		ДобавитьЗависимыеРСБУ(НоваяСКД, МакетРСБУ, ПапкаНабора.Ключ, ПапкаНабора.Значение);
	КонецЦикла;
	
	//МСФО
	МакетМСФО = ПолучитьМакетОСВМСФО();
	Для каждого ПапкаНабора Из ПапкиНаборов Цикл
		ДобавитьЗависимыеМСФО(НоваяСКД, МакетМСФО, ПапкаНабора.Ключ, ПапкаНабора.Значение);
	КонецЦикла;
	
	ДобавитьВидДвиженияТУ(НоваяСКД, МакетМСФО, ФиксированныеПараметры);
	
КонецФункции

Процедура НастроитьОграниченияЗависимыхНаборов(НоваяСКД, ВидСубконто) Экспорт
	
	ТипыСубконто = Неопределено;
	Если ВидСубконто <> Неопределено Тогда
		ТипыСубконто = ВидСубконто.ТипЗначения.Типы();
	КонецЕсли;
	
	НаборОСВ = ОсновнойНаборДанных(НоваяСКД);
	ПолеСубконто1 = НаборОСВ.Поля.Найти("Субконто1");
	
	Для каждого Связь Из НоваяСКД.СвязиНаборовДанных Цикл
		
		Если Связь.ВыражениеПриемник <> "Субконто1" Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеСКД = ПолеСКД(НоваяСКД, Связь.НаборДанныхПриемник, Связь.ВыражениеПриемник);
		Если ПолеСКД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Скрыть = Ложь;
		Если ВидСубконто <> Неопределено Тогда
			Скрыть = Не ЕстьТипВОписанииТипов(ПолеСКД.ТипЗначения, ТипыСубконто);
		КонецЕсли;
		
		УстановитьОграниченияПоля(ПолеСКД, Скрыть, Скрыть, Скрыть, Скрыть);
		
		Если Скрыть ИЛИ ПолеСубконто1 = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеСКД.Заголовок = ПолеСубконто1.Заголовок;
		ПолеСКД.ТипЗначения = ПолеСубконто1.ТипЗначения;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область АОСВ

Функция ТекстЗапросаАОСВ(ФиксированныеПараметры, КлючВарианта) Экспорт
	
	Если ФиксированныеПараметры.ФормироватьПроводкиМСФО Тогда
		Возврат "";
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = Новый Массив;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_Регламенты(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втВЗП(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втПоказателиОтчета(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втОСВМСФО_ТК(НомераТаблиц));
	
	Возврат СтрСоединить(ТекстЗапроса, 
		ПроведениеСерверУХ.РазделительЗапросовВПакете());
	
КонецФункции

#КонецОбласти

Функция ОсновнойНаборДанных(НоваяСКД) Экспорт

	Результат = НоваяСКД.НаборыДанных.Найти("НаборБухИтоги");//АнализСчета,Расшифровки
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат НоваяСКД.НаборыДанных.Найти("НаборДанных1");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СКД

Функция ПолеСКД(СКД, ИмяНабораДанных, ПутьКДаннымПоля) Экспорт
	
	Набор = СКД.НаборыДанных.Найти(ИмяНабораДанных);
	Если Набор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Поле = Набор.Поля.Найти(ПутьКДаннымПоля);
	Если Поле = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Возврат Поле;
	
КонецФункции

Функция ТипизироватьПолеСКД(ПолеСКД = Неопределено, ВидСубконто = Неопределено, ЗаголовокПустого = Неопределено) Экспорт
	
	Если ПолеСКД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидСубконто) Тогда
		
		ПолеСКД.ТипЗначения = ВидСубконто.ТипЗначения;
		ПолеСКД.Заголовок = Строка(ВидСубконто);
		
	Иначе 
		
		ПолеСКД.ТипЗначения = Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип;
		ПолеСКД.Заголовок = ?(ЗаголовокПустого = Неопределено, ПолеСКД.Имя, ЗаголовокПустого);
		
	КонецЕсли;

КонецФункции

Функция УстановитьОграниченияПоля(ПолеПриемник, Группировка = Ложь, Поле = Ложь, Порядок = Ложь, Условие = Ложь) Экспорт

	ПолеПриемник.ОграничениеИспользования.Группировка	= Группировка;
	ПолеПриемник.ОграничениеИспользования.Поле			= Поле;
	ПолеПриемник.ОграничениеИспользования.Порядок		= Порядок;
	ПолеПриемник.ОграничениеИспользования.Условие		= Условие;
	
	Если ТипЗнч(ПолеПриемник) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных")  Тогда
		Возврат ПолеПриемник;
	КонецЕсли;
	
	ПолеПриемник.ОграничениеИспользованияРеквизитов.Группировка	= Группировка;
	ПолеПриемник.ОграничениеИспользованияРеквизитов.Поле		= Поле;
	ПолеПриемник.ОграничениеИспользованияРеквизитов.Порядок		= Порядок;
	ПолеПриемник.ОграничениеИспользованияРеквизитов.Условие		= Условие;
	
КонецФункции	

Функция ЕстьТипВОписанииТипов(ОписаниеТиповИсточник, ТипыПроверки) Экспорт
	
	Для каждого ТипПроверки Из ТипыПроверки Цикл
		Если ОписаниеТиповИсточник.СодержитТип(ТипПроверки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область ЗависимыеНаборы

Функция ДобавитьЗависимыеМСФО(НоваяСКД, ИсточникСКД, ПапкаНаборов, Замены)
	
	Имя = "ДанныеПоВНАМСФО";
	ОписаниеНабора = ОписаниеНабора(Имя, "Субконто1", ПапкаНаборов, Замены);
	ДобавитьНабор(НоваяСКД, ИсточникСКД, ОписаниеНабора);
	
	Если Метаданные.РегистрыСведений.Найти("СтатусыОбъектовИнвестирования") <> Неопределено Тогда
		
		Имя = "ДанныеПоОбъектуИнвестированияМСФО";
		ОписаниеНабора = ОписаниеНабора(Имя, "Субконто1", ПапкаНаборов, Замены);
		ДобавитьНабор(НоваяСКД, ИсточникСКД, ОписаниеНабора);
	
	КонецЕсли;
	
	Имя = "МестонахождениеВНА";
	ОписаниеНабора = ОписаниеНабора(Имя, "Субконто1", ПапкаНаборов, Замены);
	ДобавитьНабор(НоваяСКД, ИсточникСКД, ОписаниеНабора);
	
	Имя = "ДанныеПоФИМСФО";
	ОписаниеНабора = ОписаниеНабора(Имя, "Субконто1", ПапкаНаборов, Замены);
	ДобавитьНабор(НоваяСКД, ИсточникСКД, ОписаниеНабора);
	
	Имя = "ДанныеРегламента";
	ОписаниеНабора = ОписаниеНабора(Имя, "Организация", ПапкаНаборов, Замены);
	ДобавитьНабор(НоваяСКД, ИсточникСКД, ОписаниеНабора);
	
	Имя = "ПараметрыРасчетаРезервовКонтрагенты";
	ОписаниеНабора = ОписаниеНабора(Имя, "Субконто1", ПапкаНаборов, Замены);
	ДобавитьНабор(НоваяСКД, ИсточникСКД, ОписаниеНабора);

