Функция УдалитьНаборыПоПрефиксу(НоваяСКД, Префикс)

	Имена = ОбщегоНазначения.ВыгрузитьКолонку(НоваяСКД.НаборыДанных, "Имя");
	Для каждого ИмяНабора Из Имена Цикл
		Если СтрНайти(ИмяНабора, Префикс) > 0 Тогда
			НоваяСКД.НаборыДанных.Удалить(НоваяСКД.НаборыДанных[ИмяНабора]);
		КонецЕсли;
	КонецЦикла;
	
