Процедура ДобавитьПапкиЗависимыхНаборов(НаборДанныхОСВ, ИмяПапки, ЗаголовокПапки)

	МестаДобавления = Новый Структура("Организация, Субконто1");
	ПервыйПоПорядку = "!";// первым в порядке полей настроек 
	
	Для каждого Место Из МестаДобавления Цикл
	
		Папка = НаборДанныхОСВ.Поля.Добавить(Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных"));
		Папка.ПутьКДанным = Место.Ключ + "." + ИмяПапки;//Организация.НаНачалоПериода
		Папка.Заголовок = ПервыйПоПорядку + ЗаголовокПапки;//Организация.НаНачалоПериода

	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ТекстЗапросаАОСВ

Функция ТекстЗапроса_Регламенты(НомераТаблиц)
	
	НомераТаблиц.Вставить("втРегламенты", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	МАКСИМУМ(т.УправлениеПериодомСценария) КАК УОП,
	|	т.Периоды КАК ПериодСценария,
	|	т.Периоды = &ПериодСценарияНачало КАК ЭтоНачало,
	|	т.Периоды = &ПериодСценарияОкончание КАК ЭтоОкончание,
	|	т.Сценарии КАК Сценарий,
	|	ВЫРАЗИТЬ(&ПланСчетовБД КАК Справочник.ПланыСчетовБД).ВидОтчетаОСВ КАК ВидОтчетаОСВ,
	|	МАКСИМУМ(т.ВерсияРегламента) КАК Регламент
	|ПОМЕСТИТЬ втРегламенты
	|ИЗ
	|	РегистрСведений.СтатусыПериодовСценариев КАК т
	|ГДЕ
	|	т.Периоды В(&ПериодыОтчета)
	|	И т.Периоды.Периодичность = ВЫРАЗИТЬ(&ПериодСценарияОкончание КАК Справочник.Периоды).Периодичность
	|	И т.Сценарии = &Сценарий
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Сценарии,
	|	т.Периоды";

КонецФункции

Функция ТекстЗапроса_втВЗП(НомераТаблиц)
	
	НомераТаблиц.Вставить("втВЗП", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	втРегламенты.ЭтоНачало КАК ЭтоНачало,
	|	втРегламенты.ЭтоОкончание КАК ЭтоОкончание,
	|	т.Ссылка КАК Версия,
	|	т.Регистратор КАК Регистратор,
	|	т.Организация КАК Организация,
	|	т.Сценарий КАК Сценарий,
	|	т.Валюта КАК Валюта,
	|	НЕ т.ЗаписьВДополнительнойВалюте КАК ЭтоФВ,
	|	т.Валюта = &ВалютаУчетаДоп КАК ЭтоВО,
	|	т.ВидОперации КАК ВидОперации,
	|	т.ЭкземплярОтчета КАК ЭкземплярОтчета,
	|	т.ВидОтчета КАК ВидОтчета,
	|	т.ПериодОтчета.ДатаОкончания КАК ПериодДень,
	|	т.ПериодОтчета КАК ПериодОтчета
	|ПОМЕСТИТЬ втВЗП
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРегламенты КАК втРегламенты
	|		ПО т.ВидОтчета = втРегламенты.ВидОтчетаОСВ
	|			И т.Сценарий = втРегламенты.Сценарий
	|			И т.ПериодОтчета = втРегламенты.ПериодСценария
	|ГДЕ
	|	НЕ т.ЧерноваяВерсия
	|	И ВЫБОР
	|			КОГДА НЕ т.ЗаписьВДополнительнойВалюте
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ т.Валюта = &ВалютаУчетаДоп
	|		КОНЕЦ
	|{ГДЕ
	|	т.Организация.*}
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	т.Ссылка,
	|	ЭтоОкончание,
	|	ЭтоНачало";

КонецФункции

Функция ТекстЗапроса_втПоказателиОтчета(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПоказателиОтчета", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	п.ПоказательОтчета КАК ПоказательОтчета,
	|	п.Счет КАК Счет,
	|	п.СчетБД КАК СчетБД,
	|	п.ВидИтогаПоСчету КАК ВидИтогаПоСчету,
	|	п.ТипОстаткаКонНач КАК ТипОстаткаКонНач,
	|	п.БухТипДтКт КАК БухТипДтКт,
	|	п.НомерАналитикиВидыДвижений КАК НомерАналитикиВидыДвижений,
	|	п.НомерАналитикиВидСубконтоОтбор КАК НомерАналитикиВидСубконтоОтбор,
	|	п.НомерРегистра КАК НомерРегистра,
	|	п.ВидАналитики1 КАК ВидАналитики1,
	|	п.ВидАналитики2 КАК ВидАналитики2,
	|	п.ВидАналитики3 КАК ВидАналитики3
	|ПОМЕСТИТЬ втПоказателиОтчета
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.Ссылка КАК ПоказательОтчета,
	|		т.СчетБД.СчетСсылка КАК Счет,
	|		т.СчетБД КАК СчетБД,
	|		т.ВидИтогаПоСчету КАК ВидИтогаПоСчету,
	|		ВЫБОР
	|			КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СКД), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СКК))
	|				ТОГДА ИСТИНА
	|			КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНД), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНК))
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК ТипОстаткаКонНач,
	|		ВЫБОР
	|			КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СКД), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.ДО), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНД))
	|				ТОГДА ИСТИНА
	|			КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СКК), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.КО), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНК))
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК БухТипДтКт,
	|		ВЫБОР
	|			КОГДА т.СчетБД.ДетализацияКорреспонденцииСчета В (ЗНАЧЕНИЕ(Перечисление.СпособыДетализацииКорреспонденцииСчета.ПустаяСсылка), ЗНАЧЕНИЕ(Перечисление.СпособыДетализацииКорреспонденцииСчета.НеРаскрывать))
	|				ТОГДА 0
	|			КОГДА НЕ т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.ДО), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.КО))
	|				ТОГДА 0
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики1.ПредставлениеТипа ПОДОБНО ""%Справочник.ВидыДвижений%""
	|				ТОГДА 1
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики2.ПредставлениеТипа ПОДОБНО ""%Справочник.ВидыДвижений%""
	|				ТОГДА 2
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики3.ПредставлениеТипа ПОДОБНО ""%Справочник.ВидыДвижений%""
	|				ТОГДА 3
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики4.ПредставлениеТипа ПОДОБНО ""%Справочник.ВидыДвижений%""
	|				ТОГДА 4
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики5.ПредставлениеТипа ПОДОБНО ""%Справочник.ВидыДвижений%""
	|				ТОГДА 5
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики6.ПредставлениеТипа ПОДОБНО ""%Справочник.ВидыДвижений%""
	|				ТОГДА 6
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НомерАналитикиВидыДвижений,
	|		ВЫБОР &ВидСубконто
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики1
	|				ТОГДА 1
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики2
	|				ТОГДА 2
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики3
	|				ТОГДА 3
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики4
	|				ТОГДА 4
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики5
	|				ТОГДА 5
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики6
	|				ТОГДА 6
	|		КОНЕЦ КАК НомерАналитикиВидСубконтоОтбор,
	|		ВЫБОР
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики6 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 6
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики5 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 5
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики4 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 4
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики3 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 3
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики2 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 2
	|			КОГДА т.ГруппаРаскрытия.ВидАналитики1 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 1
	|			КОГДА т.Владелец.ВидАналитики6 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 6
	|			КОГДА т.Владелец.ВидАналитики5 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 5
	|			КОГДА т.Владелец.ВидАналитики4 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 4
	|			КОГДА т.Владелец.ВидАналитики3 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 3
	|			КОГДА т.Владелец.ВидАналитики2 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 2
	|			КОГДА т.Владелец.ВидАналитики1 <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НомерРегистра,
	|		т.ГруппаРаскрытия.ВидАналитики1 КАК ВидАналитики1,
	|		т.ГруппаРаскрытия.ВидАналитики2 КАК ВидАналитики2,
	|		т.ГруппаРаскрытия.ВидАналитики3 КАК ВидАналитики3
	|	ИЗ
	|		Справочник.ПоказателиОтчетов КАК т
	|	ГДЕ
	|		т.Владелец В
	|				(ВЫБРАТЬ
	|					т.ВидОтчетаОСВ
	|				ИЗ
	|					втРегламенты КАК т)
	|		И т.СчетБД <> ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)
	|		И т.ВидИтогаПоСчету <> ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.ПустаяСсылка)) КАК п
	|ГДЕ
	|	&УсловиеСчета
	|	И ВЫБОР
	|			КОГДА &ВидСубконто В (ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка), НЕОПРЕДЕЛЕНО)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ п.НомерАналитикиВидСубконтоОтбор ЕСТЬ NULL
	|		КОНЕЦ
	|{ГДЕ
	|	п.Счет.* КАК Счет}
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	п.ПоказательОтчета,
	|	п.НомерРегистра,
	|	ТипОстаткаКонНач"
	
КонецФункции

Функция ТекстЗапроса_втОСВМСФО_ТК(НомераТаблиц)
	
	НомераТаблиц.Вставить("втОСВМСФО", НомераТаблиц.Количество());

	ТекстЗапроса = Новый Массив;
	
	МаксАналитик = 6;
	
	Для й = 1 По МаксАналитик Цикл
		ТекстЗапроса.Добавить(Шаблон_ЗначенияПоказателей(й, МаксАналитик));
	КонецЦикла;
	
	Возврат Шаблон_СводОСВТК(СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ "));
	
КонецФункции

Функция Шаблон_СводОСВТК(ЧастиОСВ)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	тОСВ.ТипОстаткаКонНач КАК ТипОстаткаКонНач,
	|	тОСВ.БухТипДтКт КАК БухТипДтКт,
	|	тОСВ.ПоказательОтчета КАК ПоказательОтчета,
	|	тОСВ.Сценарий КАК Сценарий,
	|	тОСВ.Организация КАК Организация,
	|	тОСВ.АналитикаВалюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА тОСВ.ТипОстаткаКонНач = НЕОПРЕДЕЛЕНО
	|				И тОСВ.БухТипДтКт = ИСТИНА
	|			ТОГДА тОСВ.АналитикаВалюта
	|	КОНЕЦ КАК ВалютаДт,
	|	ВЫБОР
	|		КОГДА тОСВ.ТипОстаткаКонНач = НЕОПРЕДЕЛЕНО
	|				И тОСВ.БухТипДтКт = ЛОЖЬ
	|			ТОГДА тОСВ.АналитикаВалюта
	|	КОНЕЦ КАК ВалютаКт,
	|	тОСВ.ВидОперации КАК ВидОперации,
	|	тОСВ.ВидДвижения КАК ВидДвижения,
	|	тОСВ.Регистратор КАК Регистратор,
	|	тОСВ.ВидДвижения КАК НомерСтроки,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	NULL КАК ПодразделениеДт,
	|	NULL КАК НаправлениеДеятельностиДт,
	|	NULL КАК ПодразделениеКт,
	|	NULL КАК НаправлениеДеятельностиКт,
	|	тОСВ.ПериодДень КАК ПериодДень,
	|	тОСВ.ПериодДень КАК ПериодНеделя,
	|	тОСВ.ПериодДень КАК ПериодДекада,
	|	тОСВ.ПериодДень КАК ПериодМесяц,
	|	тОСВ.ПериодДень КАК ПериодКвартал,
	|	тОСВ.ПериодДень КАК ПериодПолугодие,
	|	тОСВ.ПериодДень КАК ПериодГод,
	|	тОСВ.Счет КАК Счет,
	|	ЕСТЬNULL(ЕСТЬNULL(ВидДт.СчетКт.СчетСсылка, ВидКт.СчетДт.СчетСсылка), тОСВ.Счет.РазделПланаСчетов) КАК КорСчет,
	|	ЕСТЬNULL(ВидКт.СчетДт.СчетСсылка, тОСВ.Счет) КАК СчетДт,
	|	ЕСТЬNULL(ВидДт.СчетКт.СчетСсылка, тОСВ.Счет) КАК СчетКт,
	|	тОСВ.Аналитика1 КАК СубконтоДт1,
	|	тОСВ.Аналитика2 КАК СубконтоДт2,
	|	тОСВ.Аналитика3 КАК СубконтоДт3,
	|	тОСВ.Аналитика1 КАК СубконтоКт1,
	|	тОСВ.Аналитика2 КАК СубконтоКт2,
	|	тОСВ.Аналитика3 КАК СубконтоКт3,
	|	тОСВ.ВидАналитики1 КАК ВидСубконтоДт1,
	|	тОСВ.ВидАналитики2 КАК ВидСубконтоДт2,
	|	тОСВ.ВидАналитики3 КАК ВидСубконтоДт3,
	|	тОСВ.ВидАналитики1 КАК ВидСубконтоКт1,
	|	тОСВ.ВидАналитики2 КАК ВидСубконтоКт2,
	|	тОСВ.ВидАналитики3 КАК ВидСубконтоКт3,
	|	ЕстьNULL(тОСВ.ВидСубконтоОтбор, тОСВ.Аналитика1) КАК Субконто1,
	|	тОСВ.Аналитика2 КАК Субконто2,
	|	тОСВ.Аналитика3 КАК Субконто3
	|ИЗ
	|	ПараметрОСВ КАК тОСВ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КорреспонденцииВидовДвиженийМСФО КАК ВидДт
	|		ПО (тОСВ.БухТипДтКт = ИСТИНА)
	|			И (тОСВ.ТипОстаткаКонНач = НЕОПРЕДЕЛЕНО)
	|			И (ВидДт.ПланСчетовБД = &ПланСчетовБД)
	|			И тОСВ.Счет = ВидДт.СчетДт
	|			И тОСВ.ВидДвижения = ВидДт.ВидДвижения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КорреспонденцииВидовДвиженийМСФО КАК ВидКт
	|		ПО (тОСВ.БухТипДтКт = ЛОЖЬ)
	|			И (тОСВ.ТипОстаткаКонНач = НЕОПРЕДЕЛЕНО)
	|			И (ВидКт.ПланСчетовБД = &ПланСчетовБД)
	|			И тОСВ.Счет = ВидКт.СчетКт
	|			И тОСВ.ВидДвижения = ВидКт.ВидДвижения";
	
	ШаблонПолей = ШаблонПолейОстатка();
	
	ИсточникФВ = "ВЫБОР КОГДА тОСВ.ЭтоФВ ТОГДА тОСВ.Значение КОНЕЦ";
	ИсточникВО = "ВЫБОР КОГДА тОСВ.ЭтоВО ТОГДА тОСВ.Значение КОНЕЦ";
	ИсточникВД = "ВЫБОР КОГДА тОСВ.ЭтоФВ ТОГДА тОСВ.ЗначениеВалюта КОНЕЦ";
	ИсточникКол = "0";
	
	Ресурсы = Новый Массив;
	Ресурсы.Добавить(СтрШаблон(ШаблонПолей, "СуммаВВалютеУчета",		ИсточникФВ));
	Ресурсы.Добавить(СтрШаблон(ШаблонПолей, "СуммаВВалютеОтчетности",	ИсточникВО));
	Ресурсы.Добавить(СтрШаблон(ШаблонПолей, "СуммаВВалюте",				ИсточникВД));
	Ресурсы.Добавить(СтрШаблон(ШаблонПолей, "Количество",				ИсточникКол));
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ " + СтрСоединить(Ресурсы, ",") + ", ");
	
	Возврат СтрЗаменить(ТекстЗапроса, "ПараметрОСВ", "(" + ЧастиОСВ + ")");

КонецФункции

Функция ШаблонПолейОстатка(Балансовый = Истина)
	
	Поля = Новый Массив;
	
	Поля.Добавить(ПолеОСВ("НачальныйОстаток",				Ложь, Неопределено, Ложь));
	Поля.Добавить(ПолеОСВ("НачальныйОстатокДт",				Ложь, Истина, Ложь));
	Поля.Добавить(ПолеОСВ("НачальныйОстатокКт",				Ложь, Ложь, Ложь));
	Поля.Добавить(ПолеОСВ("НачальныйРазвернутыйОстатокДт",	Ложь, Истина, Истина));
	Поля.Добавить(ПолеОСВ("НачальныйРазвернутыйОстатокКт",	Ложь, Ложь, Истина));
	
	Если Балансовый Тогда
		Поля.Добавить(ПолеОСВ("",	Неопределено, Неопределено, Ложь));
	Иначе 
		Поля.Добавить(ПолеОСВ("Дт",	Неопределено, Истина, Ложь));
		Поля.Добавить(ПолеОСВ("Кт",	Неопределено, Ложь, Ложь));
	КонецЕсли;
	
	Поля.Добавить(ПолеОСВ("Оборот",		Неопределено, Неопределено, Ложь));
	Поля.Добавить(ПолеОСВ("ОборотДт",	Неопределено, Истина, Ложь));
	Поля.Добавить(ПолеОСВ("ОборотКт",	Неопределено, Ложь, Ложь));
	
	Поля.Добавить(ПолеОСВ("КонечныйОстаток", 				Истина, Неопределено, Ложь));
	Поля.Добавить(ПолеОСВ("КонечныйОстатокДт",				Истина, Истина, Ложь));
	Поля.Добавить(ПолеОСВ("КонечныйОстатокКт",				Истина, Ложь, Ложь));
	Поля.Добавить(ПолеОСВ("КонечныйРазвернутыйОстатокДт",	Истина, Истина, Истина));
	Поля.Добавить(ПолеОСВ("КонечныйРазвернутыйОстатокКт",	Истина, Ложь, Истина));
	
	Возврат СтрСоединить(Поля, ", ");
	
КонецФункции

Функция ПолеОСВ(ПрефиксРесурса, ТипОстатка = Истина, БухТип = Истина, Развернутый = Ложь)
	
	Если БухТип = Неопределено Тогда
		
		ТекстЗапроса =
		" (ВЫБОР
		|			КОГДА тОСВ.ТипОстаткаКонНач = ""%4"" И тОСВ.БухТипДтКт = ИСТИНА 
		|				ТОГДА %2
		|			КОГДА тОСВ.ТипОстаткаКонНач = ""%4"" И тОСВ.БухТипДтКт = ЛОЖЬ 
		|				- ТОГДА %2
		|			КОГДА %5 <> %5 
		|				ТОГДА 0
		|		КОНЕЦ) КАК %1%3";
	
	КонецЕсли;
	
	ТекстЗапроса =
	" (ВЫБОР
	|			КОГДА тОСВ.ТипОстаткаКонНач = %4 И тОСВ.БухТипДтКт = %5
	|				ТОГДА %2
	|		КОНЕЦ) КАК %1%3";
	
	БухТипДебет = БулевоЗапроса(БухТип);
	Если ПрефиксРесурса = "" Тогда
		БухТипДебет = "тОСВ.БухТипДтКт";
	ИначеЕсли БухТип = Неопределено Тогда
		БухТипДебет = "тОСВ.БухТипДтКт";
	КонецЕсли;
	
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, 
		"%1", //Поле-приемник, "СуммаВВалюте"
		"%2", //Поле-источник "тОСВ.ЗначениеВалюта"
		ПрефиксРесурса,// "КонечныйРазвернутыйОстатокДт"
		БулевоЗапроса(ТипОстатка), //Истина - Конечное сальдо
		БухТипДебет); //Истина - Дебет
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция БулевоЗапроса(БулевоПеременная)

	Если БулевоПеременная = Истина Тогда
		Возврат "ИСТИНА"
	ИначеЕсли БулевоПеременная = Ложь Тогда
		Возврат "ЛОЖЬ"
	Иначе 
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;

КонецФункции

Функция Шаблон_ЗначенияПоказателей(ЧислоАналитик = 6, МаксАналитик = 6)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	втВЗП.Сценарий КАК Сценарий,
	|	втВЗП.Организация КАК Организация,
	|	втВЗП.ВидОперации КАК ВидОперации,
	|	втВЗП.ПериодДень КАК ПериодДень,
	|	втВЗП.ЭтоФВ КАК ЭтоФВ,
	|	втВЗП.ЭтоВО КАК ЭтоВО,
	|	втВЗП.Регистратор КАК Регистратор,
	|	п.Счет КАК Счет,
	|	п.ВидАналитики1 КАК ВидАналитики1,
	|	п.ВидАналитики2 КАК ВидАналитики2,
	|	п.ВидАналитики3 КАК ВидАналитики3,
	|	п.ТипОстаткаКонНач КАК ТипОстаткаКонНач,
	|	п.БухТипДтКт КАК БухТипДтКт,
	|	ВЫБОР
	|		КОГДА втВЗП.ЭтоФВ
	|			ТОГДА т.ЗначениеВалюта
	|	КОНЕЦ КАК ЗначениеВалюта,
	|	ВЫБОР п.НомерАналитикиВидыДвижений
	|		КОГДА 1
	|			ТОГДА т.Аналитика1
	|		КОГДА 2
	|			ТОГДА т.Аналитика2
	|		КОГДА 3
	|			ТОГДА т.Аналитика3
	|		КОГДА 4
	|			ТОГДА т.Аналитика4
	|		КОГДА 5
	|			ТОГДА т.Аналитика5
	|		КОГДА 6
	|			ТОГДА т.Аналитика6
	|	КОНЕЦ КАК ВидДвижения,
	|	ВЫБОР п.НомерАналитикиВидСубконтоОтбор
	|		КОГДА 1
	|			ТОГДА т.Аналитика1
	|		КОГДА 2
	|			ТОГДА т.Аналитика2
	|		КОГДА 3
	|			ТОГДА т.Аналитика3
	|		КОГДА 4
	|			ТОГДА т.Аналитика4
	|		КОГДА 5
	|			ТОГДА т.Аналитика5
	|		КОГДА 6
	|			ТОГДА т.Аналитика6
	|	КОНЕЦ КАК ВидСубконтоОтбор,
	|	т.Показатель КАК ПоказательОтчета,
	|	т.Значение КАК Значение,
	|	т.АналитикаВалюта КАК АналитикаВалюта,
	|	т.Аналитика1 КАК Аналитика1,
	|	т.Аналитика2 КАК Аналитика2,
	|	т.Аналитика3 КАК Аналитика3,
	|	т.Аналитика4 КАК Аналитика4,
	|	т.Аналитика5 КАК Аналитика5,
	|	т.Аналитика6 КАК Аналитика6
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов6 КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказателиОтчета КАК п
	|		ПО т.Показатель = п.ПоказательОтчета
	|			И (п.НомерРегистра = &НомерРегистра)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВЗП КАК втВЗП
	|		ПО т.Версия = втВЗП.Версия
	|ГДЕ
	|	НЕ т.ИтоговоеЗначение
	|	И ВЫБОР
	|			КОГДА втВЗП.ЭтоОкончание
	|					И втВЗП.ЭтоНачало
	|				ТОГДА ИСТИНА
	|			КОГДА п.ТипОстаткаКонНач = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			КОГДА НЕ втВЗП.ЭтоОкончание
	|					И НЕ втВЗП.ЭтоНачало
	|				ТОГДА ЛОЖЬ
	|			КОГДА НЕ втВЗП.ЭтоОкончание
	|					И втВЗП.ЭтоНачало
	|				ТОГДА п.ТипОстаткаКонНач = ЛОЖЬ
	|			ИНАЧЕ п.ТипОстаткаКонНач = ИСТИНА
	|		КОНЕЦ";
	
	//|			И (п.НомерРегистра = &НомерРегистра)

	ИмяРегистра = "ЗначенияПоказателейОтчетов" + ЧислоАналитик;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗначенияПоказателейОтчетов6", ИмяРегистра);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерРегистра", ЧислоАналитик);
	
	Для й = ЧислоАналитик + 1 По МаксАналитик Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "т.Аналитика" + й, "NULL");
	КонецЦикла;
	
	Возврат ТекстЗапроса;

