Функция ПолучитьМакетОСВМСФО()
	
	МакетМСФО = Отчеты.ОСВМСФО.ПолучитьМакет("ЗависимыеНаборыМСФО");
	НаборВНА = МакетМСФО.НаборыДанных.Найти("ДанныеПоВНАМСФО");
	
	ТекстЗапроса = Отчеты.ПараметрыВНА.ТекстЗапроса_ПараметрыВНА(Неопределено);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&АлгоритмРСБУ", "ИСТИНА");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидыУчета", "ЗНАЧЕНИЕ(Перечисление.ВидыУчета.МСФО)");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВсеОрганизации", "ИСТИНА");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВНА", "ИСТИНА");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВсеВНА", "ИСТИНА");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаРасчета", "&ПараметрПериод");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ГраницаДоДокумента", "&ПараметрПериод");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачалоПериода", "&ПараметрПериод");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаНачалаПериодаДокумента", "&ПараметрПериод");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ЛОЖЬ", "И ЛОЖЬ" + СкрытьСубконтоЗапросаВНА());//Параметры вт рб.МСФО
	
	НаборВНА.Запрос = ТекстЗапроса;
	
	Возврат МакетМСФО;
	
КонецФункции

Функция СкрытьСубконтоЗапросаВНА()

	 Возврат
	 "{(Субконто1).* КАК СкрытьСубконто1,
	 |(Субконто2).* КАК СкрытьСубконто2, 
	 |(Субконто3).* КАК СкрытьСубконто3, 
	 |(Сценарий).* КАК СкрытьСценарий, 
	 |(Валюта).* КАК СкрытьВалюта, 
	 |(ВидОперации).* КАК СкрытьВидОперации, 
	 |(Подразделение).* КАК СкрытьПодразделение, 
	 |(НаправлениеДеятельности).* КАК СкрытьНаправлениеДеятельности}";

КонецФункции

Функция ПолучитьМакетОСВРСБУ() 
	
	Если Метаданные.Отчеты.Найти("ОборотноСальдоваяВедомостьПоСчету") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СКД = Отчеты["ОборотноСальдоваяВедомостьПоСчету"].ПолучитьМакет("СхемаКомпоновкиДанных");
	
	ТипыНаборов = Новый Структура("ДанныеОС, ДанныеНМА, ДанныеФизЛица",
		ВстраиваниеУХКлиентСервер.ПолучитьТипОС(),
		Тип("СправочникСсылка.НематериальныеАктивы"),
		Тип("СправочникСсылка.ФизическиеЛица"));
	
	Для каждого _ Из ТипыНаборов Цикл
		СКД.НаборыДанных[_.Ключ].Поля.Найти("Субконто1").ТипЗначения 
			= Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(_.Значение));
	КонецЦикла;
	
	Возврат СКД;

КонецФункции

Функция ДобавитьНабор(НоваяСКД, ИсточникСКД, ОписаниеНабора)
	
	Если ИсточникСКД = Неопределено Тогда
		Возврат Неопределено;//например в ВЕ нет Отчет.ОборотноСальдоваяВедомостьПоСчету
	КонецЕсли;
	
	НаборОСВ = НоваяСКД.НаборыДанных[0];
	
	Результат = НоваяСКД.НаборыДанных.Найти(ОписаниеНабора.ИмяНовогоНабора);
	Если (Результат <> Неопределено) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Источник = ИсточникСКД.НаборыДанных.Найти(ОписаниеНабора.ИмяСтарогоНабора);
	Если Источник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = НоваяСКД.НаборыДанных.Добавить(ТипЗнч(Источник));
	ЗаполнитьЗначенияСвойств(Результат, Источник, , "Поля, ИсточникДанных");
	
	Результат.Имя				= ОписаниеНабора.ИмяНовогоНабора;
	Результат.Запрос			= ТекстЗапросаНабора(Источник.Запрос, ОписаниеНабора.ЗаменыПараметров);
	Результат.ИсточникДанных	= НоваяСКД.ИсточникиДанных[0].Имя;
	
	//замена префикса полей, 
	//	например, замена пути "Субконто1.СвязанноеПолеМОЛ_ОС" 
	//	на "НаНачалоПериода.ДанныеПоОСРСБУ.СвязанноеПолеМОЛ_ОС"
	ПутьНабора = ОписаниеНабора.ПутьЗамена + "." + ОписаниеНабора.ИмяСтарогоНабора;
	Поиск = ОписаниеНабора.ПутьПоиск + "."; 
	Замена = ПутьНабора + ".";
	
	Для каждого ПолеИсточник Из Источник.Поля Цикл
		
		Поле = Результат.Поля.Добавить(ТипЗнч(ПолеИсточник));
		ЗаполнитьЗначенияСвойств(Поле, ПолеИсточник);
		
		Если ТипЗнч(ПолеИсточник) = Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
			
			ЗаполнитьЗначенияСвойств(Поле.ОграничениеИспользования, ПолеИсточник.ОграничениеИспользования);
			ЗаполнитьЗначенияСвойств(Поле.ОграничениеИспользованияРеквизитов, ПолеИсточник.ОграничениеИспользованияРеквизитов);
			
		КонецЕсли;
	
		Если Поле.ПутьКДанным = "Заголовок" Тогда
			
			Поле.ПутьКДанным = ПутьНабора;
			//Поле.Заголовок = "!" + ОписаниеНабора.ЗаменыПараметров.Папка;//сместим в начало всех полей-реквизитов
			
		Иначе

			Поле.ПутьКДанным = СтрЗаменить(Поле.ПутьКДанным, Поиск, Замена);
			Если СтрНачинаетсяС(Поле.Заголовок, "Субконто1.") Тогда
				Поле.Заголовок = СтрЗаменить(Поле.Заголовок, "Субконто1.", "");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого Связь Из ИсточникСКД.СвязиНаборовДанных Цикл
		
		Если Связь.НаборДанныхПриемник <> ОписаниеНабора.ИмяСтарогоНабора Тогда
			Продолжить;
		КонецЕсли;

		ВыражениеИсточник = Связь.ВыражениеИсточник;//** замена Субконто1 на Субконто2.ОрганизационнаяЕдиница
		
		НоваяСвязьСКД(НоваяСКД, НаборОСВ.Имя, ВыражениеИсточник,
			ОписаниеНабора.ИмяНовогоНабора, Связь.ВыражениеПриемник);
		
	КонецЦикла;
		
	Возврат Результат;

КонецФункции

Функция НоваяСвязьСКД(НоваяСКД, НаборДанныхИсточник, ВыражениеИсточник, 
							НаборДанныхПриемник, ВыражениеПриемник)

	Связь = НоваяСКД.СвязиНаборовДанных.Добавить();
	
	Связь.НаборДанныхИсточник = НаборДанныхИсточник;
	Связь.НаборДанныхПриемник = НаборДанныхПриемник;
	Связь.ВыражениеИсточник = ВыражениеИсточник;
	Связь.ВыражениеПриемник = ВыражениеПриемник;
	
	Возврат Связь;
	
