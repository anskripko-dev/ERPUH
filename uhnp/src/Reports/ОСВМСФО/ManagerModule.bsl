Функция ОписаниеНабора(ИмяСтарогоНабора, ПутьПоиск, ПапкаНабора, ЗаменыПараметров)
	
	//ПутьПоиск ;//Ищем "Субконто1" - Путь для присоединения
	ПутьЗамена = ПутьПоиск + "." + ПапкаНабора;//Заменяем на "Субконто1.НаКонецПериода"
	ИмяНовогоНабора = ПапкаНабора + ИмяСтарогоНабора;//Заменяем на "НаКонецПериодаРегламент"
	
	Возврат Новый Структура(
		"ИмяСтарогоНабора, ИмяНовогоНабора, ПапкаНабора, ПутьПоиск, ПутьЗамена, ЗаменыПараметров",
		ИмяСтарогоНабора, ИмяНовогоНабора, ПапкаНабора, ПутьПоиск, ПутьЗамена, ЗаменыПараметров);

