#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.ИсполнениеПлатежныхПозиций);
	ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, ОписаниеОтчета, Ложь);
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОписаниеВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, ОписаниеОтчета, "Основной");
	ОписаниеВарианта.Описание = НСтр("ru= 'Исполнение платежных позиций за период.'");
	
	ОписаниеВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, ОписаниеОтчета, "Дополнительный");
	ОписаниеВарианта.Описание = НСтр("ru= 'Исполнение платежных позиций документа.'");
	
	//ВариантыОтчетовУТПереопределяемый.ОтключитьВариантОтчета(Настройки, ОписаниеОтчета, "Дополнительный");	
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#Область КомандыПодменюОтчеты

// Добавляет команду отчета в список команд.
// 
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - состав полей см. в функции МенюОтчеты.СоздатьКоллекциюКомандОтчетов.
//
Функция ДобавитьКомандуОтчета(КомандыОтчетов) Экспорт
	
	Если Не ПравоДоступа("Просмотр", Метаданные.Отчеты.ИсполнениеПлатежныхПозиций) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Команда = КомандыОтчетов.Добавить();
	Команда.Представление	   = НСтр("ru = 'Исполнение платежных позиций документа';
										|en = 'Execution of payment items of a document'");
	Команда.МножественныйВыбор = Ложь;
	Команда.Важность           = "СмТакже";
	Команда.КлючВарианта       = "Дополнительный";
	Команда.Менеджер		   = Метаданные.Отчеты.ИсполнениеПлатежныхПозиций.ПолноеИмя();
	Команда.СочетаниеКлавиш    = Новый СочетаниеКлавиш(Клавиша.E, Ложь, Истина, Истина);
	
	Возврат Команда;
	
КонецФункции

#КонецОбласти

#КонецОбласти
		
#КонецЕсли