#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПодготовитьНастройки(НастройкиСКД);
	
	Реквизиты = ПолучитьРеквизиты(КомпоновщикНастроек.Настройки);
	
	СхемаКомпоновкиДанных.НаборыДанных.Получить(0).Запрос 
		= Отчеты.ИзменениеВалютныхКурсовМСФО.ТекстЗапроса_Отчет(Реквизиты);
	//(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки())
	
КонецПроцедуры  

Функция ПодготовитьНастройки(НастройкиСКД)
	
	Организация 	= ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "Организация");
	Сценарий 		= ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "Сценарий");
	Период 			= ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "Период");
	КонецПериода 	= КонецДня(Период.ДатаОкончания);
	
	ИменаРеквизитов = "ФункциональнаяВалюта, ВалютаПредоставленияОтчетности, ВалютаИсточник, 
						|УчетнаяПолитика, ФормироватьПроводкиМСФО, ПланСчетовМСФО";
	ПутиУП = МСФОВызовСервераУХ.ПутиРеквизитовУП(ИменаРеквизитов);
	РеквизитыТаб = МСФОВызовСервераУХ.ЗначенияУП(ПутиУП, Организация, КонецПериода, Сценарий);
	Реквизиты = МСФОВызовСервераУХ.ЗначенияПоОрганизацииУП(РеквизитыТаб);
	
	пд = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	
	ИзменениеФВ = (Реквизиты.ФункциональнаяВалюта <> Реквизиты.ВалютаИсточник);
	ИВизВО = (Реквизиты.ВалютаПредоставленияОтчетности = Реквизиты.ВалютаИсточник);
	
	пд.УстановитьЗначениеПараметра("ФункциональнаяВалюта",		Реквизиты.ФункциональнаяВалюта);
	пд.УстановитьЗначениеПараметра("ВалютаПредставления",		Реквизиты.ВалютаПредоставленияОтчетности);
	пд.УстановитьЗначениеПараметра("ВалютаИсточник",			Реквизиты.ВалютаИсточник);
	пд.УстановитьЗначениеПараметра("ИзменениеФВ",				ИзменениеФВ);
	пд.УстановитьЗначениеПараметра("ВОизИВ",					ИВизВО);
	
	пд.УстановитьЗначениеПараметра("УчетнаяПолитика",			Реквизиты.УчетнаяПолитика);
	пд.УстановитьЗначениеПараметра("ПланСчетовМСФО",			Реквизиты.ПланСчетовМСФО);
	пд.УстановитьЗначениеПараметра("ФормироватьПроводкиМСФО",	Реквизиты.ФормироватьПроводкиМСФО);

	Если Не Реквизиты.ФормироватьПроводкиМСФО Тогда
		
		ПериодОтчета = ОбщегоНазначенияУХ.ПолучитьПроизвольныйПериод(
			Период.ДатаНачала, НачалоДня(Период.ДатаОкончания));
		
		пд.УстановитьЗначениеПараметра("ПериодОтчета", ПериодОтчета);
		пд.УстановитьЗначениеПараметра("ВидОтчетаАОСВ",
			Справочники.ВидыОтчетов.ПолучитьВидОтчетаОСВ(Реквизиты.ПланСчетовМСФО));
	
	КонецЕсли;

КонецФункции

Функция ПолучитьРеквизиты(НастройкиСКД)
	
	Результат = Новый Структура("ФормироватьПроводкиМСФО", Истина);
	
	Результат.Вставить("ФормироватьПроводкиМСФО", 
		ТиповыеОтчетыУХ.ПолучитьЗначениеПараметра(НастройкиСКД, "ФормироватьПроводкиМСФО"));
	
	Возврат Результат;

КонецФункции	

#КонецЕсли 
