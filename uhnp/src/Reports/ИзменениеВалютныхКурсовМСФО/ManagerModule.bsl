	|		ЕСТЬNULL(ЗаменитьКоррСчет.СчетУчетаУбыткаСубконто2, т.СубконтоДт2) КАК СубконтоДт2,
	|		ЕСТЬNULL(ЗаменитьКоррСчет.СчетУчетаУбыткаСубконто3, т.СубконтоДт3) КАК СубконтоДт3,
	|		т.СчетКт КАК СчетКт,
	|		т.СубконтоКт1 КАК СубконтоКт1,
	|		т.СубконтоКт2 КАК СубконтоКт2,
	|		т.СубконтоКт3 КАК СубконтоКт3,
	|		ВЫБОР
	|			КОГДА ЗаменитьКоррСчет.Счет ЕСТЬ NULL
	|				ТОГДА т.ВалютаДт
	|			КОГДА ЗаменитьКоррСчет.СчетУчетаУбыткаВалютный
	|				ТОГДА т.ВалютаДт
	|		КОНЕЦ КАК ВалютаДт,
