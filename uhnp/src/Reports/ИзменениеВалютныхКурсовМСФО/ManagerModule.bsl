	|		ЕСТЬNULL(ЗаменитьКоррСчет.СчетУчетаПрибыли, т.СчетКт),
	|		ЕСТЬNULL(ЗаменитьКоррСчет.СчетУчетаПрибылиСубконто1, т.СубконтоКт1),
	|		ЕСТЬNULL(ЗаменитьКоррСчет.СчетУчетаПрибылиСубконто2, т.СубконтоКт2),
	|		ЕСТЬNULL(ЗаменитьКоррСчет.СчетУчетаПрибылиСубконто3, т.СубконтоКт3),
