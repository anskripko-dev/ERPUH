	|				И (ЕСТЬNULL(т.ПодразделениеДт = КорРасчет.Подразделение, ИСТИНА))
	|				И (ЕСТЬNULL(т.НаправлениеДеятельностиДт = КорРасчет.НаправлениеДеятельности, ИСТИНА))
	|				И (КорРасчет.Субконто1 В (т.СубконтоДт1, НЕОПРЕДЕЛЕНО))
	|				И (КорРасчет.Субконто2 В (т.СубконтоДт2, НЕОПРЕДЕЛЕНО))
	|				И (КорРасчет.Субконто3 В (т.СубконтоДт3, НЕОПРЕДЕЛЕНО))
	|				И (ЕстьNULL(КорРасчет.ЭтоРКР, ЛОЖЬ) В (ЛОЖЬ, НЕОПРЕДЕЛЕНО))
	|				И (ЗаменитьКоррСчет.Счет ЕСТЬ NULL)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		втРасчет.НомерРасчета,
	|		КорРасчет.НомерРасчета,
	|		втРасчет.ИзменениеФВ,
	|		втРасчет.ИзменениеВО,
	|		втРасчет.СуммаДоФВ,
	|		втРасчет.СуммаДоВО,
	|		втРасчет.СуммаВВалютеУчетаОборотДт,
	|		втРасчет.СуммаВВалютеОтчетностиОборотДт,
	|		втРасчет.КурсФВ,
