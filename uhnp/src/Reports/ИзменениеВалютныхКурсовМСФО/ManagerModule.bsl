#Область ДанныеТУ

Функция ТекстЗапроса_втОСВНСБУ_ТУ(НомераТаблиц, ЭтоМСФО = Ложь)

	НомераТаблиц.Вставить("втОСВНСБУ", НомераТаблиц.Количество());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СУММА(тОСВ.СуммаНачальныйОстаток) КАК СуммаНачальныйОстаток,
	|	СУММА(тОСВ.СуммаОборотДт) КАК СуммаОборотДт,
	|	СУММА(тОСВ.СуммаОборотКт) КАК СуммаОборотКт,
	|	СУММА(тОСВ.СуммаКонечныйОстаток) КАК СуммаКонечныйОстаток,
	|	втСчетаНСБУ.СчетСсылкаМСФО КАК Счет,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ тОСВ.Счет) КАК СчетНСБУ,
	|	тОСВ.Субконто1 КАК Субконто1,
	|	тОСВ.Субконто2 КАК Субконто2,
	|	тОСВ.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ втОСВНСБУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.Счет КАК Счет,
	|		т.Субконто1 КАК Субконто1,
	|		НЕОПРЕДЕЛЕНО КАК Субконто2,
	|		НЕОПРЕДЕЛЕНО КАК Субконто3,
	|		т.СуммаВВалютеУчетаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|		т.СуммаВВалютеУчетаОборотДт КАК СуммаОборотДт,
	|		т.СуммаВВалютеУчетаОборотКт КАК СуммаОборотКт,
	|		т.СуммаВВалютеУчетаКонечныйОстаток КАК СуммаКонечныйОстаток
	|	ИЗ
	|		РегистрБухгалтерии.МСФО.ОстаткиИОбороты(
	|				{&НачалоПериода},
	|				{&КонецПериода},
	|				,
	|				,
	|				Счет В
	|					(ВЫБРАТЬ
	|						т.СчетСсылкаНСБУ
	|					ИЗ
	|						втСчетаНСБУ КАК т
	|					ГДЕ
	|						т.ЕстьСубконто1
	|						И НЕ т.ЕстьСубконто2),
	|				,
	|				Организация = &Организация
	|					И Сценарий = &Сценарий) КАК т
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.Счет,
	|		т.Субконто1,
	|		т.Субконто2,
	|		НЕОПРЕДЕЛЕНО,
	|		т.СуммаВВалютеУчетаНачальныйОстаток,
	|		т.СуммаВВалютеУчетаОборотДт,
	|		т.СуммаВВалютеУчетаОборотКт,
	|		т.СуммаВВалютеУчетаКонечныйОстаток
	|	ИЗ
	|		РегистрБухгалтерии.МСФО.ОстаткиИОбороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				,
	|				Счет В
	|					(ВЫБРАТЬ
	|						т.СчетСсылкаНСБУ
	|					ИЗ
	|						втСчетаНСБУ КАК т
	|					ГДЕ
	|						т.ЕстьСубконто1
	|						И т.ЕстьСубконто2
	|						И НЕ т.ЕстьСубконто3),
	|				,
	|				Организация = &Организация
	|					И Сценарий = &Сценарий) КАК т
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.Счет,
	|		т.Субконто1,
	|		т.Субконто2,
	|		т.Субконто3,
	|		т.СуммаВВалютеУчетаНачальныйОстаток,
	|		т.СуммаВВалютеУчетаОборотДт,
	|		т.СуммаВВалютеУчетаОборотКт,
	|		т.СуммаВВалютеУчетаКонечныйОстаток
	|	ИЗ
	|		РегистрБухгалтерии.МСФО.ОстаткиИОбороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				,
	|				Счет В
	|					(ВЫБРАТЬ
	|						т.СчетСсылкаНСБУ
	|					ИЗ
	|						втСчетаНСБУ КАК т
	|					ГДЕ
	|						т.ЕстьСубконто1
	|						И т.ЕстьСубконто2
	|						И т.ЕстьСубконто3),
	|				,
	|				Организация = &Организация
	|					И Сценарий = &Сценарий) КАК т) КАК тОСВ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчетаНСБУ КАК втСчетаНСБУ
	|		ПО тОСВ.Счет = втСчетаНСБУ.СчетСсылкаНСБУ
	|
	|СГРУППИРОВАТЬ ПО
	|	втСчетаНСБУ.СчетСсылкаМСФО,
	|	тОСВ.Субконто1,
	|	тОСВ.Субконто2,
	|	тОСВ.Субконто3
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Субконто1,
	|	Счет,
	|	Субконто2,
	|	Субконто3";
	
	Если ЭтоМСФО Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	Возврат МСФОВызовСервераУХ.ПреобразоватьВРСБУ(ТекстЗапроса, "т");

КонецФункции

Функция ТекстЗапроса_втОСВМСФО_ТУ(НомераТаблиц, Реквизиты)

	НомераТаблиц.Вставить("втОСВМСФО", НомераТаблиц.Количество());
	
	Шаблон = Новый Массив;
	
	ВидТР = "ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Трансляция)";
	ВидНеТР = "ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Трансляция)";
	
	СчетТР = "т.КорректировкаФВ В (""МонетарныеНеВалютныеНСБУ"", ""НемонетарныеНеКоличественные"", ""_КорректироватьВО"")";
	СчетНеТР = "НЕ " + СчетТР;
	
	ЧислоСубконто = УчетМСФОПовтИспУХ.ПолучитьМаксКоличествоСубконто("МСФО");
	Для й = 0 По ЧислоСубконто Цикл
		
		Шаблон.Добавить(Шаблон_ОСВМСФО(й, "ИСТИНА",	СчетНеТР,	"ИСТИНА",	Реквизиты));
		Шаблон.Добавить(Шаблон_ОСВМСФО(й, "ИСТИНА",	СчетТР,		ВидТР,		Реквизиты));
		Шаблон.Добавить(Шаблон_ОСВМСФО(й, "ЛОЖЬ",	СчетТР,		ВидНеТР,	Реквизиты));
		
	КонецЦикла;
	
	Возврат Шаблон_СводОСВМСФО(СтрСоединить(Шаблон, " ОБЪЕДИНИТЬ ВСЕ "), Истина);

КонецФункции

Функция Шаблон_СводОСВМСФО(ЧастиОСВ, ДопПоля = Истина)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
	|	МАКСИМУМ(втСчета.ИзменениеАктивногоСчета) КАК ИзменениеАктивногоСчета,
	|	МАКСИМУМ(втСчета.ПересчетВФВ) КАК ПересчетВФВ,
	|	МАКСИМУМ(втСчета.КорректировкаФВ) КАК КорректировкаФВ,
	|	МАКСИМУМ(втСчета.КорректироватьВО) КАК КорректироватьВО,
	|	МАКСИМУМ(втСчета.КорректировкаФВ В (""МонетарныеНеВалютныеНСБУ"", ""НемонетарныеНеКоличественные"")) КАК ПолучитьНСБУ,
	|	СУММА(тОСВ.КурсоваяРазницаДОФВ) КАК КурсоваяРазницаДОФВ,
	|	СУММА(тОСВ.КурсоваяРазницаКОФВ) КАК КурсоваяРазницаКОФВ,
	|	СУММА(тОСВ.РеализованнаяКурсоваяРазницаДОФВ) КАК РеализованнаяКурсоваяРазницаДОФВ,
	|	СУММА(тОСВ.РеализованнаяКурсоваяРазницаКОФВ) КАК РеализованнаяКурсоваяРазницаКОФВ,
	|	СУММА(тОСВ.КурсоваяРазницаВО) КАК КурсоваяРазницаВО,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|				ТОГДА тОСВ.СуммаВВалютеУчетаНачальныйОстаток
	|		КОНЕЦ) КАК СуммаТрансляцияНачальныйОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|				ТОГДА тОСВ.СуммаВВалютеУчетаОборотДт
	|		КОНЕЦ) КАК СуммаТрансляцияОборотДт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|				ТОГДА тОСВ.СуммаВВалютеУчетаОборотКт
	|		КОНЕЦ) КАК СуммаТрансляцияОборотКт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|				ТОГДА тОСВ.СуммаВВалютеУчетаКонечныйОстаток
	|		КОНЕЦ) КАК СуммаТрансляцияКонечныйОстаток,
	|	МАКСИМУМ(втСчета.СчетБД) КАК СчетБД,
	|	тОСВ.Счет КАК Счет,
	|	тОСВ.Субконто1 КАК Субконто1,
	|	тОСВ.Субконто2 КАК Субконто2,
	|	тОСВ.Субконто3 КАК Субконто3,
	|	тОСВ.Подразделение КАК Подразделение,
	|	тОСВ.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	тОСВ.Валюта КАК Валюта,
	|	СУММА(тОСВ.СуммаВВалютеУчетаНачальныйОстаток) КАК СуммаВВалютеУчетаНачальныйОстаток,
	|	СУММА(тОСВ.СуммаВВалютеУчетаОборотДт) КАК СуммаВВалютеУчетаОборотДт,
	|	СУММА(тОСВ.СуммаВВалютеУчетаОборотКт) КАК СуммаВВалютеУчетаОборотКт,
	|	СУММА(тОСВ.СуммаВВалютеУчетаКонечныйОстаток) КАК СуммаВВалютеУчетаКонечныйОстаток,
	|	СУММА(тОСВ.КоличествоНачальныйОстаток) КАК КоличествоНачальныйОстаток,
	|	СУММА(тОСВ.КоличествоОборотДт) КАК КоличествоОборотДт,
	|	СУММА(тОСВ.КоличествоОборотКт) КАК КоличествоОборотКт,
	|	СУММА(тОСВ.КоличествоКонечныйОстаток) КАК КоличествоКонечныйОстаток,
	|	СУММА(тОСВ.СуммаВВалютеОтчетностиНачальныйОстаток) КАК СуммаВВалютеОтчетностиНачальныйОстаток,
	|	СУММА(тОСВ.СуммаВВалютеОтчетностиОборотДт) КАК СуммаВВалютеОтчетностиОборотДт,
	|	СУММА(тОСВ.СуммаВВалютеОтчетностиОборотКт) КАК СуммаВВалютеОтчетностиОборотКт,
	|	СУММА(тОСВ.СуммаВВалютеОтчетностиКонечныйОстаток) КАК СуммаВВалютеОтчетностиКонечныйОстаток,
	|	СУММА(тОСВ.СуммаВВалютеНачальныйОстаток) КАК СуммаВВалютеНачальныйОстаток,
	|	СУММА(тОСВ.СуммаВВалютеОборотДт) КАК СуммаВВалютеОборотДт,
	|	СУММА(тОСВ.СуммаВВалютеОборотКт) КАК СуммаВВалютеОборотКт,
	|	СУММА(тОСВ.СуммаВВалютеКонечныйОстаток) КАК СуммаВВалютеКонечныйОстаток
	|ПОМЕСТИТЬ втОСВМСФО
	|ИЗ
	|	ПараметрОСВ КАК тОСВ
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО тОСВ.Счет = втСчета.Счет
	|
	|СГРУППИРОВАТЬ ПО
	|	тОСВ.Счет,
	|	тОСВ.Субконто1,
	|	тОСВ.Субконто2,
	|	тОСВ.Субконто3,
	|	тОСВ.Подразделение,
	|	тОСВ.НаправлениеДеятельности,
	|	тОСВ.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПолучитьНСБУ,
	|	тОСВ.Субконто1,
	|	тОСВ.Счет,
	|	тОСВ.Субконто2,
	|	тОСВ.Субконто3";
	
	Возврат СтрЗаменить(ТекстЗапроса, "ПараметрОСВ", "(" + ЧастиОСВ + ")");

КонецФункции

Функция Шаблон_ОСВМСФО(КоличествоНеоборотных = 3, ДанныеНСБУ = "ИСТИНА", 
		СчетТрансляция = "ИСТИНА", ВидОперацииТрансляция = "ИСТИНА", Реквизиты = Неопределено)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.Счет КАК Счет,
	|	&КурсоваяРазницаДОФВ КАК КурсоваяРазницаДОФВ,
	|	&КурсоваяРазницаКОФВ КАК КурсоваяРазницаКОФВ,
	|	&РеализованнаяКурсоваяРазницаДОФВ КАК РеализованнаяКурсоваяРазницаДОФВ,
	|	&РеализованнаяКурсоваяРазницаКОФВ КАК РеализованнаяКурсоваяРазницаКОФВ,
	|	&КурсоваяРазницаВО КАК КурсоваяРазницаВО,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.СуммаВВалютеУчетаНачальныйОстаток КАК СуммаВВалютеУчетаНачальныйОстаток,
	|	т.СуммаВВалютеУчетаОборотДт КАК СуммаВВалютеУчетаОборотДт,
	|	т.СуммаВВалютеУчетаОборотКт КАК СуммаВВалютеУчетаОборотКт,
	|	т.СуммаВВалютеУчетаКонечныйОстаток КАК СуммаВВалютеУчетаКонечныйОстаток,
	|	т.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	|	т.КоличествоОборотДт КАК КоличествоОборотДт,
	|	т.КоличествоОборотКт КАК КоличествоОборотКт,
	|	т.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
	|	т.СуммаВВалютеОтчетностиНачальныйОстаток КАК СуммаВВалютеОтчетностиНачальныйОстаток,
	|	т.СуммаВВалютеОтчетностиОборотДт КАК СуммаВВалютеОтчетностиОборотДт,
	|	т.СуммаВВалютеОтчетностиОборотКт КАК СуммаВВалютеОтчетностиОборотКт,
	|	т.СуммаВВалютеОтчетностиКонечныйОстаток КАК СуммаВВалютеОтчетностиКонечныйОстаток,
	|	т.Валюта КАК Валюта,
	|	т.СуммаВВалютеНачальныйОстаток КАК СуммаВВалютеНачальныйОстаток,
	|	т.СуммаВВалютеОборотДт КАК СуммаВВалютеОборотДт,
	|	т.СуммаВВалютеОборотКт КАК СуммаВВалютеОборотКт,
	|	т.СуммаВВалютеКонечныйОстаток КАК СуммаВВалютеКонечныйОстаток,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	&ДанныеНСБУ КАК ДанныеНСБУ
	|ИЗ
	|	РегистрБухгалтерии.МСФО.ОстаткиИОбороты(
	|			{&НачалоПериода},
	|			{&КонецПериода},
	|			,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.Счет
	|				ИЗ
	|					втСчета КАК т
	|				ГДЕ
	|					т.КоличествоНеоборотных = &КоличествоНеоборотных
	|					И &СчетТрансляция),
	|			,
	|			Организация = &Организация
	|				И Сценарий = &Сценарий
	|				И &ВидОперацииТрансляция) КАК т";
	
	ЕстьКурсоваяРазница = (Реквизиты <> Неопределено) И (Реквизиты.ВыводОтчета = Истина);
	
	КурсоваяРазницаДОФВ = "ВЫБОР КОГДА т.ВидОперации В (ВЫБРАТЬ т.ВидОперации ИЗ втВидОперацииКР КАК т) ТОГДА т.СуммаВВалютеУчетаОборотДт ИНАЧЕ 0 КОНЕЦ";
	КурсоваяРазницаКОФВ = "ВЫБОР КОГДА т.ВидОперации В (ВЫБРАТЬ т.ВидОперации ИЗ втВидОперацииКР КАК т) ТОГДА т.СуммаВВалютеУчетаОборотКт ИНАЧЕ 0 КОНЕЦ";
	РеализованнаяКурсоваяРазницаДОФВ = "ВЫБОР КОГДА т.ВидОперации В (ЗНАЧЕНИЕ(Справочник.ВидыОпераций.РеализованныеКурсовыеРазницы)) ТОГДА т.СуммаВВалютеУчетаОборотДт ИНАЧЕ 0 КОНЕЦ";
	РеализованнаяКурсоваяРазницаКОФВ = "ВЫБОР КОГДА т.ВидОперации В (ЗНАЧЕНИЕ(Справочник.ВидыОпераций.РеализованныеКурсовыеРазницы)) ТОГДА т.СуммаВВалютеУчетаОборотКт ИНАЧЕ 0 КОНЕЦ";
	КурсоваяРазницаВО = "ВЫБОР КОГДА т.ВидОперации В (ВЫБРАТЬ т.ВидОперации ИЗ втВидОперацииКР КАК т) ТОГДА т.СуммаВВалютеОтчетностиОборотДт - т.СуммаВВалютеОтчетностиОборотКт ИНАЧЕ 0 КОНЕЦ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДанныеНСБУ", 			ДанныеНСБУ);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КоличествоНеоборотных",	КоличествоНеоборотных);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетТрансляция", 		СчетТрансляция);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидОперацииТрансляция", 	ВидОперацииТрансляция);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КурсоваяРазницаДОФВ",	?(ЕстьКурсоваяРазница, КурсоваяРазницаДОФВ, "0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КурсоваяРазницаКОФВ",	?(ЕстьКурсоваяРазница, КурсоваяРазницаКОФВ, "0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеализованнаяКурсоваяРазницаДОФВ",	?(ЕстьКурсоваяРазница, РеализованнаяКурсоваяРазницаДОФВ, "0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеализованнаяКурсоваяРазницаКОФВ",	?(ЕстьКурсоваяРазница, РеализованнаяКурсоваяРазницаКОФВ, "0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КурсоваяРазницаВО",		?(ЕстьКурсоваяРазница, КурсоваяРазницаВО, "0"));
	
	Для й = КоличествоНеоборотных+1 По 3 Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "т.Субконто" + й, 	"НЕОПРЕДЕЛЕНО");
	КонецЦикла;

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_втОстаткиНаНачалоНКР(НомераТаблиц)

	НомераТаблиц.Вставить("втОстаткиНаНачалоНКР", НомераТаблиц.Количество());
	
	//на монетарном счете сумма НКР на начало периода с обратным знаком
	
	Возврат 
	"ВЫБРАТЬ
	|	т.СуммаВВалютеУчетаОборот КАК СНДНКРФВ,
	|	т.СуммаВВалютеОтчетностиОборот КАК СНДНКРВО,
	|	т.Счет КАК Счет,
	|	ЕСТЬNULL(т.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
	|	ЕСТЬNULL(т.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
	|	ЕСТЬNULL(т.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
	|	т.Валюта КАК Валюта,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ПОМЕСТИТЬ втОстаткиНаНачалоНКР
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Обороты(
	|			НАЧАЛОПЕРИОДА(&НачалоПериода, ГОД),
	|			{(&НачалоПериода)},
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					т.Счет
	|				ИЗ
	|					втСчета КАК т
	|				ГДЕ
	|					т.Монетарный
	|					И т.ВыделятьРКР
	|					И т.ПогашатьНКР),
	|			,
	|			Организация = &Организация
	|				И Сценарий = &Сценарий
	|				И ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций._02ПереоценкаВалютныхАктивовИОбязательств),
	|			,
	|			) КАК т";

КонецФункции

Функция ТекстЗапроса_втОперацииСписаниеНКР(НомераТаблиц)

	НомераТаблиц.Вставить("втОперацииСписаниеНКР", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ИСТИНА КАК ЭтоСторно,
	|	-1 КАК Коэффициент,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций._02ПереоценкаВалютныхАктивовИОбязательств) КАК ВидОперации,
	|	&Комментарий1 КАК Комментарий
	|ПОМЕСТИТЬ втОперацииСписаниеНКР
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЛОЖЬ,
	|	1,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.РеализованныеКурсовыеРазницы),
	|	&Комментарий2";
	
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();

	Содержание = НСтр("ru = 'Сторно начисленной ранее нереализованной курсовой разницы для отражения реализованной'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий1", СтрШаблон(" ""%1"" ", Содержание));
	Содержание = НСтр("ru = 'Отражение реализованной курсовой разницы, которая отражена ранее как нереализованная'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий2", СтрШаблон(" ""%1"" ", Содержание));
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ДанныеТК

Функция ТекстЗапроса_втВЗП(НомераТаблиц, Реквизиты)
	
	НомераТаблиц.Вставить("втВЗП", НомераТаблиц.Количество());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.Ссылка КАК Версия,
	|	т.Регистратор КАК Регистратор,
	|	т.Организация КАК Организация,
	|	т.Валюта КАК Валюта,
	|	т.ЗаписьВДополнительнойВалюте КАК ЗаписьВДополнительнойВалюте,
	|	&ЭтоКурсоваяРазница КАК ЭтоКурсоваяРазница,
	|	ВЫБОР
	|		КОГДА т.ЗаписьВДополнительнойВалюте
	|			ТОГДА т.Валюта В
	|					(ВЫБРАТЬ ПЕРВЫЕ 1
	|						доп.Валюта
	|					ИЗ
	|						Документ.НастраиваемыйОтчет.ДополнительныеВалюты КАК доп
	|					ГДЕ
	|						т.ЭкземплярОтчета = доп.Ссылка
	|						И доп.НомерСтроки = 1)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоВО,
	|	т.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Трансляция) КАК ДанныеНСБУ
	|ПОМЕСТИТЬ втВЗП
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК т
	|ГДЕ
	|	т.Сценарий = &Сценарий
	|	И т.ВидОтчета = &ВидОтчетаАОСВ
	|	И т.Организация В(&Организация)
	|	И т.ПериодОтчета = &ПериодОтчета
	|	И НЕ т.Регистратор В (&Ссылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	т.Ссылка,
	|	ДанныеНСБУ";
	
	ЕстьКурсоваяРазница = (Реквизиты <> Неопределено) И (Реквизиты.ВыводОтчета = Истина);
	ЭтоКурсоваяРазница = "т.ВидОперации В (ВЫБРАТЬ т.ВидОперации ИЗ втВидОперацииКР КАК т)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоКурсоваяРазница", ?(ЕстьКурсоваяРазница, ЭтоКурсоваяРазница, "NULL"));
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_втПоказателиОтчета(НомераТаблиц)
	
	НомераТаблиц.Вставить("втПоказателиОтчета", НомераТаблиц.Количество());
		
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК ПоказательОтчета,
	|	втСчета.СчетБД КАК СчетБД,
	|	т.ВидИтогаПоСчету КАК ВидИтогаПоСчету,
	|	ВЫБОР
	|		КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНК), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СКК))
	|			ТОГДА -1
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Коэффициент,
	|	ВЫБОР
	|		КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНД), ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.СНК))
	|			ТОГДА ""Нач""
	|		КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.ДО))
	|			ТОГДА ""Дт""
	|		КОГДА т.ВидИтогаПоСчету В (ЗНАЧЕНИЕ(Перечисление.ВидыБухгалтерскихИтогов.КО))
	|			ТОГДА ""Кт""
	|		ИНАЧЕ ""Кон""
	|	КОНЕЦ КАК ВидОСВ,
	|	ВЫБОР ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики1
	|			ТОГДА 0
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики2
	|			ТОГДА 1
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики3
	|			ТОГДА 2
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики4
	|			ТОГДА 3
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики5
	|			ТОГДА 4
	|		КОГДА т.ГруппаРаскрытия.ВидАналитики6
	|			ТОГДА 5
	|		ИНАЧЕ 6
	|	КОНЕЦ КАК НомерРегистра
	|ПОМЕСТИТЬ втПоказателиОтчета
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО (т.Владелец = &ВидОтчетаАОСВ)
	|			И т.СчетБД = втСчета.СчетБД
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПоказательОтчета,
	|	НомерРегистра"
	
КонецФункции

Функция ТекстЗапроса_втОСВМСФО_ТК(НомераТаблиц, Реквизиты)
	
	НомераТаблиц.Вставить("втОСВМСФО", НомераТаблиц.Количество());

	ТекстЗапроса = Новый Массив;
	
	МаксАналитик = 6;
	
	Для й = 1 По МаксАналитик Цикл
		ТекстЗапроса.Добавить(Шаблон_ЗначенияПоказателей(й, МаксАналитик));
	КонецЦикла;
	
	Возврат Шаблон_СводОСВТК(
		СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ "),
		Реквизиты);
	
КонецФункции

Функция Шаблон_СводОСВТК(ЧастиОСВ, Реквизиты)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
	|	МАКСИМУМ(втСчета.ИзменениеАктивногоСчета) КАК ИзменениеАктивногоСчета,
	|	МАКСИМУМ(втСчета.ПересчетВФВ) КАК ПересчетВФВ,
	|	МАКСИМУМ(втСчета.КорректировкаФВ) КАК КорректировкаФВ,
	|	МАКСИМУМ(втСчета.КорректироватьВО) КАК КорректироватьВО,
	|	МАКСИМУМ(втСчета.КорректировкаФВ В (""МонетарныеНеВалютныеНСБУ"", ""НемонетарныеНеКоличественные"")) КАК ПолучитьНСБУ,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|					И тОСВ.ВидОСВ = ""Нач""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаТрансляцияНачальныйОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|					И тОСВ.ВидОСВ = ""Дт""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаТрансляцияОборотДт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|					И тОСВ.ВидОСВ = ""Кт""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаТрансляцияОборотКт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ДанныеНСБУ
	|					И тОСВ.ВидОСВ = ""Кон""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаТрансляцияКонечныйОстаток,
	|	МАКСИМУМ(втСчета.СчетБД) КАК СчетБД,
	|	втСчета.Счет КАК Счет,
	|	тОСВ.Субконто1 КАК Субконто1,
	|	тОСВ.Субконто2 КАК Субконто2,
	|	тОСВ.Субконто3 КАК Субконто3,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	тОСВ.Валюта КАК Валюта,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Нач""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаВВалютеУчетаНачальныйОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Дт""
	|				ТОГДА тОСВ.СуммаВВалюте
	|		КОНЕЦ) КАК СуммаВВалютеУчетаОборотДт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Кт""
	|				ТОГДА тОСВ.СуммаВВалюте
	|		КОНЕЦ) КАК СуммаВВалютеУчетаОборотКт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Кон""
	|				ТОГДА тОСВ.СуммаВВалюте
	|		КОНЕЦ) КАК СуммаВВалютеУчетаКонечныйОстаток,
	|	СУММА(тОСВ.КурсоваяРазницаДОФВ) КАК КурсоваяРазницаДОФВ,
	|	СУММА(тОСВ.КурсоваяРазницаКОФВ) КАК КурсоваяРазницаКОФВ,
	|	СУММА(тОСВ.РеализованнаяКурсоваяРазницаДОФВ) КАК РеализованнаяКурсоваяРазницаДОФВ,
	|	СУММА(тОСВ.РеализованнаяКурсоваяРазницаКОФВ) КАК РеализованнаяКурсоваяРазницаКОФВ,
	|	0 КАК КурсоваяРазницаВО,
	|	0 КАК КоличествоНачальныйОстаток,
	|	0 КАК КоличествоОборотДт,
	|	0 КАК КоличествоОборотКт,
	|	0 КАК КоличествоКонечныйОстаток,
	|	0 КАК СуммаВВалютеОтчетностиНачальныйОстаток,
	|	0 КАК СуммаВВалютеОтчетностиОборотДт,
	|	0 КАК СуммаВВалютеОтчетностиОборотКт,
	|	0 КАК СуммаВВалютеОтчетностиКонечныйОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Нач""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаВВалютеНачальныйОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Дт""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаВВалютеОборотДт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Кт""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаВВалютеОборотКт,
	|	СУММА(ВЫБОР
	|			КОГДА тОСВ.ВидОСВ = ""Кон""
	|				ТОГДА тОСВ.СуммаВВалютеУчета
	|		КОНЕЦ) КАК СуммаВВалютеКонечныйОстаток
	|ПОМЕСТИТЬ втОСВМСФО
	|ИЗ
	|	ПараметрОСВ КАК тОСВ
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО тОСВ.СчетБД = втСчета.СчетБД
	|
	|СГРУППИРОВАТЬ ПО
	|	втСчета.Счет,
	|	тОСВ.Субконто1,
	|	тОСВ.Субконто2,
	|	тОСВ.Субконто3,
	|	тОСВ.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПолучитьНСБУ,
	|	тОСВ.Субконто1,
	|	втСчета.Счет,
	|	тОСВ.Субконто2,
	|	тОСВ.Субконто3";

	ЕстьКурсоваяРазница = (Реквизиты <> Неопределено) И (Реквизиты.ВыводОтчета = Истина);
	ЭтоКурсоваяРазница = "ВЫБОР КОГДА втВЗП.ЭтоКурсоваяРазница ТОГДА т.Значение * п.Коэффициент ИНАЧЕ 0 КОНЕЦ";
	ЧастиОСВ = СтрЗаменить(ЧастиОСВ, "&КурсоваяРазницаДОФВ", ?(ЕстьКурсоваяРазница, ЭтоКурсоваяРазница, "0"));
	
	Возврат СтрЗаменить(ТекстЗапроса, "ПараметрОСВ", "(" + ЧастиОСВ + ")");

КонецФункции

Функция Шаблон_ЗначенияПоказателей(ЧислоАналитик = 6, МаксАналитик = 6)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.АналитикаВалюта КАК Валюта,
	|	&КурсоваяРазницаДОФВ КАК КурсоваяРазницаДОФВ,
	|	0 КАК КурсоваяРазницаКОФВ,
	|	0 КАК РеализованнаяКурсоваяРазницаДОФВ,
	|	0 КАК РеализованнаяКурсоваяРазницаКОФВ,
	|	т.ЗначениеВалюта * п.Коэффициент КАК СуммаВВалюте,
	|	т.Значение * п.Коэффициент КАК СуммаВВалютеУчета,
	|	п.ВидОСВ КАК ВидОСВ,
	|	втВЗП.ДанныеНСБУ КАК ДанныеНСБУ,
	|	п.СчетБД КАК СчетБД,
	|	т.Аналитика1 КАК Субконто1,
	|	т.Аналитика2 КАК Субконто2,
	|	т.Аналитика3 КАК Субконто3,
	|	т.Аналитика4 КАК Субконто4,
	|	т.Аналитика5 КАК Субконто5,
	|	т.Аналитика6 КАК Субконто6
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов6 КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказателиОтчета КАК п
	|		ПО т.Показатель = п.ПоказательОтчета
	|			И (п.НомерРегистра = &НомерРегистра)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВЗП КАК втВЗП
	|		ПО т.Версия = втВЗП.Версия
	|ГДЕ
	|	НЕ т.ИтоговоеЗначение";
	
	ИмяРегистра = "ЗначенияПоказателейОтчетов" + ЧислоАналитик;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗначенияПоказателейОтчетов6", ИмяРегистра);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерРегистра", ЧислоАналитик);
	
	Для й = ЧислоАналитик + 1 По МаксАналитик Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "т.Аналитика" + й, "NULL");
	КонецЦикла;
	
	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

#Область РаспределениеНемонетарных

Функция ТекстЗапроса_втСчетаИсключения(НомераТаблиц)

	НомераТаблиц.Вставить("втСчетаИсключения", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	т.Ссылка КАК Счет
	|ПОМЕСТИТЬ втСчетаИсключения
	|ИЗ
	|	ПланСчетов.МСФО КАК т
	|ГДЕ
	|	т.ПланСчетовБД = &ПланСчетовМСФО
	|	И т.РазделПланаСчетов В (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ДенежныеСредства), ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.Налоги))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет";

КонецФункции

Функция ТекстЗапроса_втСписанияНемонетарных(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСписанияНемонетарных", НомераТаблиц.Количество());

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСписания,
	|	р.НомерРасчетаСчетИсточник КАК НомерРасчетаСчетИсточник,
	|	р.НомерРасчетаПриемник КАК НомерРасчетаПриемник,
	|	р.ИзменениеФВ КАК ИзменениеФВ,
	|	р.ИзменениеВО КАК ИзменениеВО,
	|	р.СуммаСписанияФВ КАК СуммаСписанияФВ,
	|	р.СуммаСписанияВО КАК СуммаСписанияВО,
	|	ВЫБОР
	|		КОГДА НЕ р.Количество ЕСТЬ NULL
	|				И р.СуммаВВалютеУчета <> 0
	|			ТОГДА ВЫРАЗИТЬ(р.Количество * р.КурсФВ - р.СуммаВВалютеУчета КАК ЧИСЛО(18, 2))
	|		КОГДА р.Количество ЕСТЬ NULL
	|				И ЕСТЬNULL(р.СуммаДоФВ, 0) <> 0
	|			ТОГДА р.ИзменениеФВ * р.СуммаВВалютеУчета / р.СуммаДоФВ
	|	КОНЕЦ КАК Доля,
	|	ВЫБОР
	|		КОГДА НЕ р.Количество ЕСТЬ NULL
	|				И р.СуммаВВалютеОтчетности <> 0
	|			ТОГДА ВЫРАЗИТЬ(р.Количество * р.КурсВО - р.СуммаВВалютеОтчетности КАК ЧИСЛО(18, 2))
	|		КОГДА р.Количество ЕСТЬ NULL
	|				И ЕСТЬNULL(р.СуммаДоВО, 0) <> 0
	|			ТОГДА р.ИзменениеВО * р.СуммаВВалютеОтчетности / р.СуммаДоВО
	|	КОНЕЦ КАК ДоляВО,
	|	р.СчетДт КАК СчетДт,
	|	р.СубконтоДт1 КАК СубконтоДт1,
	|	р.СубконтоДт2 КАК СубконтоДт2,
	|	р.СубконтоДт3 КАК СубконтоДт3,
	|	р.СчетКт КАК СчетКт,
	|	р.СубконтоКт1 КАК СубконтоКт1,
	|	р.СубконтоКт2 КАК СубконтоКт2,
	|	р.СубконтоКт3 КАК СубконтоКт3,
	|	р.ВалютаДт КАК ВалютаДт,
	|	р.ВалютаКт КАК ВалютаКт,
	|	р.ВидОперации КАК ВидОперации,
	|	р.ПодразделениеДт КАК ПодразделениеДт,
	|	р.ПодразделениеКт КАК ПодразделениеКт,
