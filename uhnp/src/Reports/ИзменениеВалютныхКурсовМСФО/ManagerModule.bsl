Функция ТекстЗапроса_втКорректировкиМонетарныхПоНемонетарным()

	Возврат
	"ВЫБРАТЬ
	|	т.НомерСписания КАК НомерСписания,
	|	т.НомерРасчетаСчетИсточник КАК НомерРасчетаСчетИсточник,
	|	т.НомерРасчетаПриемник КАК НомерРасчетаПриемник,
	|	ВЫБОР
	|		КОГДА т.СуммаСписанияФВ <> 0
	|			ТОГДА т.ИзменениеФВ * т.СуммаВВалютеУчета / т.СуммаСписанияФВ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КорректировкаФВ,
	|	ВЫБОР
	|		КОГДА т.СуммаСписанияФВ <> 0
	|			ТОГДА т.ИзменениеВО * т.СуммаВВалютеОтчетности / т.СуммаСписанияВО
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КорректировкаВО,
	|	т.ИзменениеФВ КАК ИзменениеФВ,
	|	т.ИзменениеВО КАК ИзменениеВО,
	|	т.СуммаСписанияФВ КАК СуммаСписанияФВ,
	|	т.СуммаСписанияВО КАК СуммаСписанияВО,
	|	т.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	т.СуммаВВалютеОтчетности КАК СуммаВВалютеОтчетности
	|ПОМЕСТИТЬ втКорректировкиМонетарныхПоНемонетарным
	|ИЗ
	|	втСписанияНемонетарных КАК т
	|ГДЕ
	|	НЕ т.НомерРасчетаПриемник ЕСТЬ NULL";

КонецФункции

Процедура ДобавитьТекстыЗапросов_РаспределениеСписаний(ТекстЗапроса, НомераТаблиц, УничтожатьТаблицы = Истина)
	
	ПутиСумм = "КорректировкаФВ:ИзменениеФВ;КорректировкаВО:ИзменениеВО";
	
	НастройкиРаспределения = МСФОЗапросыУХ.НастройкиРаспределения(
			ТекстЗапроса_втКорректировкиМонетарныхПоНемонетарным(),
			"втКорректировкиМонетарныхПоНемонетарным",
			"НомерРасчетаСчетИсточник",
			ПутиСумм,
			"НомерСписания",
			УничтожатьТаблицы
		);
	
	МСФОЗапросыУХ.ДобавитьТекстыЗапросовРаспределений(
		ТекстЗапроса, НомераТаблиц, НастройкиРаспределения);

КонецПроцедуры

Функция ТекстЗапроса_втКорректировкиНемонетарныхДляПриемника(НомераТаблиц)
	
	НомераТаблиц.Вставить("втКорректировкиНемонетарныхДляПриемника", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	СУММА(т.КорректировкаФВ) КАК КорректировкаФВ,
	|	СУММА(т.КорректировкаВО) КАК КорректировкаВО,
	|	т.НомерРасчетаПриемник КАК НомерРасчетаПриемник
	|ПОМЕСТИТЬ втКорректировкиНемонетарныхДляПриемника
	|ИЗ
	|	втКорректировкиМонетарныхПоНемонетарным КАК т
	|
	|СГРУППИРОВАТЬ ПО
	|	т.НомерРасчетаПриемник
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерРасчетаПриемник";

КонецФункции

Функция ТекстЗапроса_втКорректировкиНемонетарныхДляПриемникаТК(НомераТаблиц)
	
	НомераТаблиц.Вставить("втКорректировкиНемонетарныхДляПриемника", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	0 КАК КорректировкаФВ,
	|	0 КАК КорректировкаВО,
	|	0 КАК НомерРасчетаПриемник
	|ПОМЕСТИТЬ втКорректировкиНемонетарныхДляПриемника
	|ГДЕ
	|	ЛОЖЬ";

КонецФункции

#КонецОбласти

#Область Расчет

Функция ТекстЗапроса_втРасчет(НомераТаблиц, ВыводОтчета = Истина)

	НомераТаблиц.Вставить("втРасчет", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.ИзменениеАктивногоСчета КАК ИзменениеАктивногоСчета,
	|	т.ПересчетВФВ КАК ПересчетВФВ,
	|	т.ЭтоРКР КАК ЭтоРКР,
	|	т.БазаФВ КАК БазаФВ,
	|	т.СуммаДоФВ КАК СуммаДоФВ,
	|	0 КАК СуммаДоВО,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(т.КратностьФВ, 0) <> 0
	|			ТОГДА т.КурсФВ / т.КратностьФВ
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КурсФВ,
	|	т.КурсФВ КАК МножительФВ,
	|	т.КратностьФВ КАК ДелительФВ,
	|	т.СуммаВВалютеУчетаКонечныйОстаток + ЕСТЬNULL(ВЫРАЗИТЬ(ВЫБОР
	|				КОГДА ЕСТЬNULL(т.КратностьФВ, 0) <> 0
	|					ТОГДА т.БазаФВ * т.КурсФВ / т.КратностьФВ - т.СуммаДоФВ
	|			КОНЕЦ КАК ЧИСЛО(18, 2)), 0) КАК БазаВО,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(т.КратностьВО, 0) <> 0
	|			ТОГДА т.КурсВО / т.КратностьВО
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КурсВО,
	|	т.КурсоваяРазницаДОФВ КАК КурсоваяРазницаДОФВ,
	|	т.КурсоваяРазницаКОФВ КАК КурсоваяРазницаКОФВ,
	|	ВЫБОР т.ЭтоРКР
	|		КОГДА ИСТИНА
	|			ТОГДА т.РасчетРКР
	|		КОГДА ЛОЖЬ
	|			ТОГДА т.КурсоваяРазницаФВ - т.РасчетРКР
	|		ИНАЧЕ т.КурсоваяРазницаФВ
	|	КОНЕЦ КАК КурсоваяРазницаФВ,
	|	т.КурсоваяРазницаВО КАК КурсоваяРазницаВО,
	|	ВЫБОР т.ЭтоРКР
	|		КОГДА ИСТИНА
	|			ТОГДА (ВЫРАЗИТЬ(ВЫБОР
	|						КОГДА ЕСТЬNULL(т.КратностьФВ, 0) <> 0
	|							ТОГДА т.БазаФВ * т.КурсФВ / т.КратностьФВ - т.СуммаДоФВ
	|					КОНЕЦ КАК ЧИСЛО(18, 2))) - т.РасчетРКР
	|		КОГДА ЛОЖЬ
	|			ТОГДА (ВЫРАЗИТЬ(ВЫБОР
	|						КОГДА ЕСТЬNULL(т.КратностьФВ, 0) <> 0
	|							ТОГДА т.БазаФВ * т.КурсФВ / т.КратностьФВ - т.СуммаДоФВ
	|					КОНЕЦ КАК ЧИСЛО(18, 2))) - (т.КурсоваяРазницаФВ - т.РасчетРКР)
	|		ИНАЧЕ ВЫРАЗИТЬ(ВЫБОР
	|					КОГДА ЕСТЬNULL(т.КратностьФВ, 0) <> 0
	|						ТОГДА т.БазаФВ * т.КурсФВ / т.КратностьФВ - т.СуммаДоФВ
	|				КОНЕЦ КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК ИзменениеФВ,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА т.КорректироватьВО
	|					И ЕСТЬNULL(т.КратностьВО, 0) <> 0
	|				ТОГДА (т.СуммаВВалютеУчетаКонечныйОстаток + ЕСТЬNULL(ВЫБОР
	|							КОГДА ЕСТЬNULL(т.КратностьФВ, 0) <> 0
	|								ТОГДА т.БазаФВ * т.КурсФВ / т.КратностьФВ - т.СуммаДоФВ
	|						КОНЕЦ, 0)) * т.КурсВО / т.КратностьВО - т.СуммаВВалютеОтчетностиКонечныйОстаток
	|		КОНЕЦ КАК ЧИСЛО(18, 2)) КАК ИзменениеВО,
	|	т.СчетБД КАК СчетБД,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Валюта КАК Валюта,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	т.ПересчетВФВ В (ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.Немонетарный), ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.НемонетарныйСпрС)) КАК Немонетарный,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерРасчета,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|				И т.ИзменениеАктивногоСчета
	|				И т.СуммаВВалютеОборотКт > 0
	|				И т.СуммаВВалютеНачальныйОстаток > 0
	|			ТОГДА ВЫБОР
	|					КОГДА т.СуммаВВалютеКонечныйОстаток = 0
	|						ТОГДА 1
	|					ИНАЧЕ т.СуммаВВалютеОборотКт / т.СуммаВВалютеНачальныйОстаток
	|				КОНЕЦ
	|		КОГДА т.ЭтоРКР
	|				И НЕ т.ИзменениеАктивногоСчета
	|				И т.СуммаВВалютеОборотДт > 0
	|				И -1 * т.СуммаВВалютеНачальныйОстаток > 0
	|			ТОГДА ВЫБОР
	|					КОГДА т.СуммаВВалютеКонечныйОстаток = 0
	|						ТОГДА 1
	|					ИНАЧЕ -1 * т.СуммаВВалютеОборотДт / т.СуммаВВалютеНачальныйОстаток
	|				КОНЕЦ
	|	КОНЕЦ КАК КоэффициентСписанияНКР,
	|	т.СуммаВВалютеКонечныйОстаток КАК СуммаВВалютеКонечныйОстаток,
	|	т.СуммаВВалютеУчетаОборотДт КАК СуммаВВалютеУчетаОборотДт,
	|	т.СуммаВВалютеУчетаОборотКт КАК СуммаВВалютеУчетаОборотКт,
	|	т.СуммаВВалютеОтчетностиОборотДт КАК СуммаВВалютеОтчетностиОборотДт,
	|	т.СуммаВВалютеОтчетностиОборотКт КАК СуммаВВалютеОтчетностиОборотКт
	|ПОМЕСТИТЬ втРасчет
	|ИЗ
	|	ВложенныйРасчет КАК т";
	
	Если ВыводОтчета Тогда
		
		Замена = "," + ДопПоляОтчета();
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ втРасчет", Замена);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "АВТОНОМЕРЗАПИСИ()", "NULL");
	Иначе 
		ТекстЗапроса = ТекстЗапроса + " ИНДЕКСИРОВАТЬ ПО Немонетарный, Счет, Подразделение, Субконто1, НаправлениеДеятельности, Субконто2, Субконто3";
	КонецЕсли;
	
	Возврат СтрЗаменить(ТекстЗапроса, "ВложенныйРасчет", "(" + ТекстЗапроса_ВложенныйРасчет() + ")");
	
КонецФункции

Функция ДопПоляОтчета()
	
	Возврат
	"
	|	т.СуммаВВалютеУчетаНачальныйОстаток КАК СуммаВВалютеУчетаНачальныйОстаток,
	|	т.СуммаВВалютеУчетаКонечныйОстаток КАК СуммаВВалютеУчетаКонечныйОстаток,
	|	т.СуммаВВалютеОтчетностиНачальныйОстаток КАК СуммаВВалютеОтчетностиНачальныйОстаток,
	|	т.СуммаВВалютеОтчетностиКонечныйОстаток КАК СуммаВВалютеОтчетностиКонечныйОстаток,
	|	т.СуммаВВалютеНачальныйОстаток КАК СуммаВВалютеНачальныйОстаток,
	|	т.СуммаВВалютеОборотДт КАК СуммаВВалютеОборотДт,
	|	т.СуммаВВалютеОборотКт КАК СуммаВВалютеОборотКт,
	|	т.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	|	т.КоличествоОборотДт КАК КоличествоОборотДт,
	|	т.КоличествоОборотКт КАК КоличествоОборотКт,
	|	т.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток";

КонецФункции

Функция ТекстЗапроса_ВложенныйРасчет()
	
	//втРасчет: т.БазаФВ * т.КурсФВ / т.КратностьФВ - т.СуммаДоФВ
	//монетарные+валютные:
	//1=ВД_СКД_МСФО * КурсВД_ФВ - ФВ_СКД_МСФО, (мб ВД = ФВ)(втОстаткиВД)
	//монетарные+валютные+РКР(П):
	//1РКР=ВД_КО_МСФО*(ФВ_СНД + ФВ_ДО)/(ВД_СНД + ВД_ДО) - ФВ_КО_МСФО
	//1НКР=ВД_СКД_МСФО * КурсВД_ФВ - (ФВ_СКД_МСФО - 1РКР),
	//монетарные+невалютные:
	//2=0, (ИВ=ФВ)
	//3=ВО_СКД_МСФО * КурсВО_ФВ - ФВ_СКД_МСФО, (ИВ=ВО)(втОстВО)
	//4=ИВ_СКД_НСБУ * КурсИВ_ФВ - ФВ_СКД_МСФО_ТУ, (ИВ не в(ФВ,ВО))(только ТР и НСБУ)(втОстНСБУ)
	
	//немонетарные+количественные:
	//5=(ФВ_СНД_МСФО + ФВ_ДО_МСФО)/(Кол_СНД_МСФО + Кол_ДО_МСФО) * Кол_КО_МСФО - ФВ_КО_МСФО, (АналитикаКО)(втОСВМСФО)
	//немонетарные+Неколичественный:
	//6=(ФВ_СНД_ТУ + ФВ_ДО_ТУ)/(ИВ_СНД_НСБУ + ИВ_ДО_НСБУ) * ИВ_КО_НСБУ - ФВ_КО_МСФО_ТУ, (АналитикаКО)(втОСВНСБУ+втОСВМСФО)

	Возврат
	"ВЫБРАТЬ
	|	т.ИзменениеАктивногоСчета КАК ИзменениеАктивногоСчета,
	|	т.ПересчетВФВ КАК ПересчетВФВ,
	|	т.КорректироватьВО КАК КорректироватьВО,
	|	СтрокиРКР.ЭтоРКР КАК ЭтоРКР,
	|	ВЫБОР т.КорректировкаФВ
	|		КОГДА ""МонетарныеВалютные""
	|			ТОГДА т.СуммаВВалютеКонечныйОстаток
	|		КОГДА ""МонетарныеВалютныеВыделятьРКР""
	|			ТОГДА ВЫБОР
	|					КОГДА СтрокиРКР.ЭтоРКР
	|							И т.ИзменениеАктивногоСчета
	|						ТОГДА -т.СуммаВВалютеОборотКт
	|					КОГДА СтрокиРКР.ЭтоРКР
	|						ТОГДА т.СуммаВВалютеОборотДт
	|					ИНАЧЕ т.СуммаВВалютеКонечныйОстаток
	|				КОНЕЦ
	|		КОГДА ""МонетарныеНевалютныеВО""
	|			ТОГДА т.СуммаВВалютеОтчетностиКонечныйОстаток
	|		КОГДА ""МонетарныеНеВалютныеНСБУ""
	|			ТОГДА втОСВНСБУ.СуммаКонечныйОстаток
	|		КОГДА ""НемонетарныеКоличественные""
	|			ТОГДА ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.КоличествоОборотКт
	|					ИНАЧЕ -т.КоличествоОборотДт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеВалютные""
	|			ТОГДА ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаВВалютеОборотКт
	|					ИНАЧЕ -т.СуммаВВалютеОборотДт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеНеКоличественные""
	|			ТОГДА т.СуммаТрансляцияНачальныйОстаток + ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаТрансляцияОборотДт
	|					ИНАЧЕ -т.СуммаТрансляцияОборотКт
	|				КОНЕЦ
	|	КОНЕЦ КАК БазаФВ,
	|	ВЫБОР т.КорректировкаФВ
	|		КОГДА ""МонетарныеВалютные""
	|			ТОГДА т.СуммаВВалютеУчетаКонечныйОстаток
	|		КОГДА ""МонетарныеВалютныеВыделятьРКР""
	|			ТОГДА ВЫБОР
	|					КОГДА СтрокиРКР.ЭтоРКР
	|						ТОГДА ВЫБОР
	|								КОГДА т.ИзменениеАктивногоСчета
	|									ТОГДА -т.СуммаВВалютеУчетаОборотКт - ЕСТЬNULL(-т.КурсоваяРазницаКОФВ, 0)
	|								ИНАЧЕ т.СуммаВВалютеУчетаОборотДт + ЕСТЬNULL(-т.КурсоваяРазницаДОФВ, 0)
	|							КОНЕЦ
	|					ИНАЧЕ т.СуммаВВалютеУчетаКонечныйОстаток + (ЕСТЬNULL(-т.КурсоваяРазницаДОФВ, 0) - ЕСТЬNULL(-т.КурсоваяРазницаКОФВ, 0)) + ВЫБОР
	|							КОГДА т.ИзменениеАктивногоСчета
	|									И т.СуммаВВалютеНачальныйОстаток + т.СуммаВВалютеОборотДт <> 0
	|								ТОГДА -т.СуммаВВалютеОборотКт * (т.СуммаВВалютеУчетаНачальныйОстаток + т.СуммаВВалютеУчетаОборотДт + ЕСТЬNULL(-т.КурсоваяРазницаДОФВ, 0)) / (т.СуммаВВалютеНачальныйОстаток + т.СуммаВВалютеОборотДт) + т.СуммаВВалютеУчетаОборотКт + ЕСТЬNULL(-т.КурсоваяРазницаКОФВ, 0)
	|							КОГДА НЕ т.ИзменениеАктивногоСчета
	|									И т.СуммаВВалютеНачальныйОстаток - т.СуммаВВалютеОборотКт <> 0
	|								ТОГДА т.СуммаВВалютеОборотДт * (т.СуммаВВалютеУчетаНачальныйОстаток - т.СуммаВВалютеУчетаОборотКт - ЕСТЬNULL(-т.КурсоваяРазницаКОФВ, 0)) / (т.СуммаВВалютеНачальныйОстаток - т.СуммаВВалютеОборотКт) - т.СуммаВВалютеУчетаОборотДт - ЕСТЬNULL(-т.КурсоваяРазницаДОФВ, 0)
	|							ИНАЧЕ 0
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОГДА ""МонетарныеНевалютныеВО""
	|			ТОГДА т.СуммаВВалютеУчетаКонечныйОстаток
	|		КОГДА ""МонетарныеНеВалютныеНСБУ""
	|			ТОГДА т.СуммаТрансляцияКонечныйОстаток
	|		КОГДА ""НемонетарныеКоличественные""
	|			ТОГДА ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаВВалютеУчетаОборотКт
	|					ИНАЧЕ -т.СуммаВВалютеУчетаОборотДт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеВалютные""
	|			ТОГДА ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаВВалютеУчетаОборотКт
	|					ИНАЧЕ -т.СуммаВВалютеУчетаОборотДт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеНеКоличественные""
	|			ТОГДА ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаТрансляцияОборотКт
	|					ИНАЧЕ -т.СуммаТрансляцияОборотДт
	|				КОНЕЦ
	|	КОНЕЦ КАК СуммаДоФВ,
	|	ВЫБОР т.КорректировкаФВ
	|		КОГДА ""МонетарныеВалютные""
	|			ТОГДА втКурсы.КурсФВ
	|		КОГДА ""МонетарныеВалютныеВыделятьРКР""
	|			ТОГДА ВЫБОР
	|					КОГДА СтрокиРКР.ЭтоРКР
	|						ТОГДА т.СуммаВВалютеУчетаНачальныйОстаток + ВЫБОР
	|								КОГДА т.ИзменениеАктивногоСчета
	|									ТОГДА т.СуммаВВалютеУчетаОборотДт + ЕСТЬNULL(-т.КурсоваяРазницаДОФВ, 0)
	|								ИНАЧЕ -т.СуммаВВалютеУчетаОборотКт - ЕСТЬNULL(-т.КурсоваяРазницаКОФВ, 0)
	|							КОНЕЦ
	|					ИНАЧЕ втКурсы.КурсФВ
	|				КОНЕЦ
	|		КОГДА ""МонетарныеНевалютныеВО""
	|			ТОГДА втКурсы.КурсФВ
	|		КОГДА ""МонетарныеНеВалютныеНСБУ""
	|			ТОГДА втКурсы.КурсФВ
	|		КОГДА ""НемонетарныеКоличественные""
	|			ТОГДА т.СуммаВВалютеУчетаНачальныйОстаток + ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаВВалютеУчетаОборотДт
	|					ИНАЧЕ -т.СуммаВВалютеУчетаОборотКт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеВалютные""
	|			ТОГДА т.СуммаВВалютеУчетаНачальныйОстаток + ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаВВалютеУчетаОборотДт
	|					ИНАЧЕ -т.СуммаВВалютеУчетаОборотКт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеНеКоличественные""
	|			ТОГДА втОСВНСБУ.СуммаНачальныйОстаток + ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА втОСВНСБУ.СуммаОборотКт
	|					ИНАЧЕ -втОСВНСБУ.СуммаОборотДт
	|				КОНЕЦ
	|	КОНЕЦ КАК КурсФВ,
	|	ВЫБОР т.КорректировкаФВ
	|		КОГДА ""МонетарныеВалютные""
	|			ТОГДА втКурсы.КратностьФВ
	|		КОГДА ""МонетарныеВалютныеВыделятьРКР""
	|			ТОГДА ВЫБОР
	|					КОГДА СтрокиРКР.ЭтоРКР
	|						ТОГДА т.СуммаВВалютеНачальныйОстаток + ВЫБОР
	|								КОГДА т.ИзменениеАктивногоСчета
	|									ТОГДА т.СуммаВВалютеОборотДт
	|								ИНАЧЕ -т.СуммаВВалютеОборотКт
	|							КОНЕЦ
	|					ИНАЧЕ втКурсы.КратностьФВ
	|				КОНЕЦ
	|		КОГДА ""МонетарныеНевалютныеВО""
	|			ТОГДА втКурсы.КратностьФВ
	|		КОГДА ""МонетарныеНеВалютныеНСБУ""
	|			ТОГДА втКурсы.КратностьФВ
	|		КОГДА ""НемонетарныеКоличественные""
	|			ТОГДА т.КоличествоНачальныйОстаток + ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.КоличествоНачальныйОстаток + т.КоличествоОборотДт
	|					ИНАЧЕ т.КоличествоНачальныйОстаток - т.КоличествоОборотКт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеВалютные""
	|			ТОГДА т.СуммаВВалютеНачальныйОстаток + ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА т.СуммаВВалютеОборотДт
	|					ИНАЧЕ - т.СуммаВВалютеОборотКт
	|				КОНЕЦ
	|		КОГДА ""НемонетарныеНеКоличественные""
	|			ТОГДА втОСВНСБУ.СуммаНачальныйОстаток + ВЫБОР
	|					КОГДА т.ИзменениеАктивногоСчета
	|						ТОГДА втОСВНСБУ.СуммаОборотДт
	|					ИНАЧЕ -втОСВНСБУ.СуммаОборотКт
	|				КОНЕЦ
	|	КОНЕЦ КАК КратностьФВ,
	|	втКурсы.КурсВО КАК КурсВО,
	|	втКурсы.КратностьВО КАК КратностьВО,
	|	т.СчетБД КАК СчетБД,
	|	т.Счет КАК Счет,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	ЕСТЬNULL(т.Валюта, &ВалютаИсточник) КАК Валюта,
	|	т.Подразделение КАК Подразделение,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ЕСТЬNULL(втОСВНСБУ.СуммаНачальныйОстаток, т.СуммаВВалютеНачальныйОстаток) КАК СуммаВВалютеНачальныйОстаток,
	|	ЕСТЬNULL(втОСВНСБУ.СуммаКонечныйОстаток, т.СуммаВВалютеКонечныйОстаток) КАК СуммаВВалютеКонечныйОстаток,
	|	ЕСТЬNULL(втОСВНСБУ.СуммаОборотДт, т.СуммаВВалютеОборотДт) КАК СуммаВВалютеОборотДт,
	|	ЕСТЬNULL(втОСВНСБУ.СуммаОборотКт, т.СуммаВВалютеОборотКт) КАК СуммаВВалютеОборотКт,
	|	т.КурсоваяРазницаДОФВ КАК КурсоваяРазницаДОФВ,
	|	т.КурсоваяРазницаКОФВ КАК КурсоваяРазницаКОФВ,
	|	т.КурсоваяРазницаДОФВ -	т.КурсоваяРазницаКОФВ КАК КурсоваяРазницаФВ,
	|	т.КурсоваяРазницаВО КАК КурсоваяРазницаВО,
	|	т.РеализованнаяКурсоваяРазницаДОФВ - т.РеализованнаяКурсоваяРазницаКОФВ КАК РасчетРКР,
	|	т.СуммаВВалютеУчетаНачальныйОстаток КАК СуммаВВалютеУчетаНачальныйОстаток,
	|	т.СуммаВВалютеУчетаКонечныйОстаток КАК СуммаВВалютеУчетаКонечныйОстаток,
	|	т.СуммаВВалютеУчетаОборотДт КАК СуммаВВалютеУчетаОборотДт,
	|	т.СуммаВВалютеУчетаОборотКт КАК СуммаВВалютеУчетаОборотКт,
	|	т.СуммаВВалютеОтчетностиНачальныйОстаток КАК СуммаВВалютеОтчетностиНачальныйОстаток,
	|	т.СуммаВВалютеОтчетностиКонечныйОстаток КАК СуммаВВалютеОтчетностиКонечныйОстаток,
	|	т.СуммаВВалютеОтчетностиОборотДт КАК СуммаВВалютеОтчетностиОборотДт,
	|	т.СуммаВВалютеОтчетностиОборотКт КАК СуммаВВалютеОтчетностиОборотКт,
	|	т.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	|	т.КоличествоОборотДт КАК КоличествоОборотДт,
	|	т.КоличествоОборотКт КАК КоличествоОборотКт,
	|	т.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
	|ИЗ
	|	втОСВМСФО КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК втКурсы
	|		ПО (ЕСТЬNULL(т.Валюта, &ВалютаИсточник) = втКурсы.Валюта)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОСВНСБУ КАК втОСВНСБУ
	|		ПО (т.ПолучитьНСБУ)
	|			И т.Счет = втОСВНСБУ.Счет
	|			И (втОСВНСБУ.Субконто1 В (т.Субконто1, НЕОПРЕДЕЛЕНО))
	|			И (втОСВНСБУ.Субконто2 В (т.Субконто2, НЕОПРЕДЕЛЕНО))
	|			И (втОСВНСБУ.Субконто3 В (т.Субконто3, НЕОПРЕДЕЛЕНО))
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ИСТИНА КАК ЭтоРКР
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ЛОЖЬ) КАК СтрокиРКР
	|		ПО (т.КорректировкаФВ = ""МонетарныеВалютныеВыделятьРКР"")";

КонецФункции

#КонецОбласти

#Область Вывод

Функция ТекстЗапроса_ТаблицаПроводок(НомераТаблиц, ФормироватьПроводкиМСФО)

	НомераТаблиц.Вставить("ТаблицаПроводок", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Валюта КАК ВалютаДт,
	|	0 КАК СуммаВВалютеДт,
	|	т.Счет КАК СчетДт,
	|	т.Субконто1 КАК СубконтоДт1,
	|	т.Субконто2 КАК СубконтоДт2,
	|	т.Субконто3 КАК СубконтоДт3,
	|	т.Подразделение КАК ПодразделениеДт,
	|	т.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаПрибыли.Валютный
	|			ТОГДА т.Валюта
	|	КОНЕЦ КАК ВалютаКт,
	|	0 КАК СуммаВВалютеКт,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаПрибылиРКР
	|		ИНАЧЕ втСчета.СчетУчетаПрибыли
	|	КОНЕЦ КАК СчетКт,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаПрибылиРКРСубконто1
	|		ИНАЧЕ втСчета.СчетУчетаПрибылиСубконто1
	|	КОНЕЦ КАК СубконтоКт1,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаПрибылиРКРСубконто2
	|		ИНАЧЕ втСчета.СчетУчетаПрибылиСубконто2
	|	КОНЕЦ КАК СубконтоКт2,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаПрибылиРКРСубконто3
	|		ИНАЧЕ втСчета.СчетУчетаПрибылиСубконто3
	|	КОНЕЦ КАК СубконтоКт3,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаПрибылиУчетПоПодразделениям
	|			ТОГДА т.Подразделение
	|	КОНЕЦ КАК ПодразделениеКт,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаПрибылиУчетПоНаправлениямДеятельности
	|			ТОГДА т.НаправлениеДеятельности
	|	КОНЕЦ КАК НаправлениеДеятельностиКт,
	|	т.ИзменениеФВ - ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаФВ, 0) КАК СуммаВФункциональнойВалюте,
	|	ВЫБОР
	|		КОГДА &ФункциональнаяВалюта = &ВалютаПредставления
	|			ТОГДА т.ИзменениеФВ - ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаФВ, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаВВалютеОтчетности,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.ВидОперацииРКР
	|		ИНАЧЕ втСчета.ВидОперации
	|	КОНЕЦ КАК ВидОперации,
	|	&Комментарий1 КАК Событие
	|ИЗ
	|	втРасчет КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.Счет = втСчета.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКорректировкиНемонетарныхДляПриемника КАК втКорректировкиНемонетарныхДляПриемника
	|		ПО т.НомерРасчета = втКорректировкиНемонетарныхДляПриемника.НомерРасчетаПриемник
	|ГДЕ
	|	т.ИзменениеФВ - ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаФВ, 0) > 0
	|	И т.ПересчетВФВ = ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.Монетарный)
	|	И НЕ втСчета.ПустоеИсключение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаУбытка.Валютный
	|			ТОГДА т.Валюта
	|	КОНЕЦ,
	|	0,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаУбыткаРКР
	|		ИНАЧЕ втСчета.СчетУчетаУбытка
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаУбыткаРКРСубконто1
	|		ИНАЧЕ втСчета.СчетУчетаУбыткаСубконто1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаУбыткаРКРСубконто2
	|		ИНАЧЕ втСчета.СчетУчетаУбыткаСубконто2
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.СчетУчетаУбыткаРКРСубконто3
	|		ИНАЧЕ втСчета.СчетУчетаУбыткаСубконто3
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаУбыткаУчетПоПодразделениям
	|			ТОГДА т.Подразделение
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаУбыткаУчетПоНаправлениямДеятельности
	|			ТОГДА т.НаправлениеДеятельности
	|	КОНЕЦ,
	|	т.Валюта,
	|	0,
	|	т.Счет,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности,
	|	-т.ИзменениеФВ + ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаФВ, 0),
	|	-ВЫБОР
	|		КОГДА &ФункциональнаяВалюта = &ВалютаПредставления
	|			ТОГДА т.ИзменениеФВ - ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаФВ, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА т.ЭтоРКР
	|			ТОГДА втСчета.ВидОперацииРКР
	|		ИНАЧЕ втСчета.ВидОперации
	|	КОНЕЦ,
	|	&Комментарий2
	|ИЗ
	|	втРасчет КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.Счет = втСчета.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКорректировкиНемонетарныхДляПриемника КАК втКорректировкиНемонетарныхДляПриемника
	|		ПО т.НомерРасчета = втКорректировкиНемонетарныхДляПриемника.НомерРасчетаПриемник
	|ГДЕ
	|	т.ИзменениеФВ - ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаФВ, 0) < 0
	|	И т.ПересчетВФВ = ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.Монетарный)
	|	И НЕ втСчета.ПустоеИсключение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Валюта,
	|	0,
	|	т.Счет,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА втСчета.СчетВОВалютный
	|			ТОГДА т.Валюта
	|	КОНЕЦ,
	|	0,
	|	втСчета.СчетВО,
	|	втСчета.СчетВОСубконто1,
	|	втСчета.СчетВОСубконто2,
	|	втСчета.СчетВОСубконто3,
	|	ВЫБОР
	|		КОГДА втСчета.СчетВОУчетПоПодразделениям
	|			ТОГДА т.Подразделение
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА втСчета.СчетВОУчетПоНаправлениямДеятельности
	|			ТОГДА т.НаправлениеДеятельности
	|	КОНЕЦ,
	|	0,
	|	т.ИзменениеВО - ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаВО, 0),
	|	втСчета.ВидОперации,
	|	&Комментарий3
	|ИЗ
	|	втРасчет КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.Счет = втСчета.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКорректировкиНемонетарныхДляПриемника КАК втКорректировкиНемонетарныхДляПриемника
	|		ПО т.НомерРасчета = втКорректировкиНемонетарныхДляПриемника.НомерРасчетаПриемник
	|ГДЕ
	|	т.ИзменениеВО > 0
	|	И &ФункциональнаяВалюта <> &ВалютаПредставления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА втСчета.СчетВОВалютный
	|			ТОГДА т.Валюта
	|	КОНЕЦ,
	|	0,
	|	втСчета.СчетВО,
	|	втСчета.СчетВОСубконто1,
	|	втСчета.СчетВОСубконто2,
	|	втСчета.СчетВОСубконто3,
	|	ВЫБОР
	|		КОГДА втСчета.СчетВОУчетПоПодразделениям
	|			ТОГДА т.Подразделение
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА втСчета.СчетВОУчетПоНаправлениямДеятельности
	|			ТОГДА т.НаправлениеДеятельности
	|	КОНЕЦ,
	|	т.Валюта,
	|	0,
	|	т.Счет,
	|	т.Субконто1,
	|	т.Субконто2,
	|	т.Субконто3,
	|	т.Подразделение,
	|	т.НаправлениеДеятельности,
	|	0,
	|	-т.ИзменениеВО + ЕстьNULL(втКорректировкиНемонетарныхДляПриемника.КорректировкаВО, 0),
	|	втСчета.ВидОперации,
	|	&Комментарий4
	|ИЗ
	|	втРасчет КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.Счет = втСчета.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКорректировкиНемонетарныхДляПриемника КАК втКорректировкиНемонетарныхДляПриемника
	|		ПО т.НомерРасчета = втКорректировкиНемонетарныхДляПриемника.НомерРасчетаПриемник
	|ГДЕ
	|	т.ИзменениеВО < 0
	|	И &ФункциональнаяВалюта <> &ВалютаПредставления";
	
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	
	Содержание = НСтр("ru = 'Увеличение валютного курса при пересчете в функциональную валюту монетарного счета'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий1", СтрШаблон(" ""%1"" ", Содержание));
	Содержание = НСтр("ru = 'Уменьшение валютного курса при пересчете в функциональную валюту монетарного счета'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий2", СтрШаблон(" ""%1"" ", Содержание));
	Содержание = НСтр("ru = 'Увеличение валютного курса при пересчете в валюту представления'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий3", СтрШаблон(" ""%1"" ", Содержание));
	Содержание = НСтр("ru = 'Уменьшение валютного курса при пересчете в валюту представления'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий4", СтрШаблон(" ""%1"" ", Содержание));

	Если ФормироватьПроводкиМСФО Тогда
		
		МассивЗапрос = Новый Массив;
		МассивЗапрос.Добавить(ТекстЗапроса);
		МассивЗапрос.Добавить(ТекстЗапроса_ПроводкиРаспределения());
		МассивЗапрос.Добавить(ТекстЗапроса_ПроводкиПереносаНаРКР_СторноПрибыли());
		МассивЗапрос.Добавить(ТекстЗапроса_ПроводкиПереносаНаРКР_СторноУбытка());
		
		ТекстЗапроса = СтрСоединить(МассивЗапрос, 
			ПроведениеСерверУХ.РазделительЗапросовВОбъединении());
	
	КонецЕсли;

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ПроводкиРаспределения()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.ВалютаДт КАК ВалютаДт,
	|	0 КАК СуммаВВалютеДт,
	|	т.СчетДт КАК СчетДт,
	|	т.СубконтоДт1 КАК СубконтоДт1,
	|	т.СубконтоДт2 КАК СубконтоДт2,
	|	т.СубконтоДт3 КАК СубконтоДт3,
	|	т.ПодразделениеДт КАК ПодразделениеДт,
	|	т.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	т.ВалютаКт КАК ВалютаКт,
	|	0 КАК СуммаВВалютеКт,
	|	т.СчетКт КАК СчетКт,
	|	т.СубконтоКт1 КАК СубконтоКт1,
	|	т.СубконтоКт2 КАК СубконтоКт2,
	|	т.СубконтоКт3 КАК СубконтоКт3,
	|	т.ПодразделениеКт КАК ПодразделениеКт,
	|	т.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт,
	|	ЕСТЬNULL(втКорректировкиМонетарныхПоНемонетарным.КорректировкаФВ, 0) КАК СуммаФВ,
	|	ЕСТЬNULL(втКорректировкиМонетарныхПоНемонетарным.КорректировкаВО, 0) КАК СуммаВО,
	|	т.ВидОперации КАК ВидОперации,
	|	&Комментарий КАК Комментарий
	|ИЗ
	|	втСписанияНемонетарных КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКорректировкиМонетарныхПоНемонетарным КАК втКорректировкиМонетарныхПоНемонетарным
	|		ПО т.НомерСписания = втКорректировкиМонетарныхПоНемонетарным.НомерСписания
	|ГДЕ
	|	(ЕСТЬNULL(втКорректировкиМонетарныхПоНемонетарным.КорректировкаФВ, 0) <> 0
	|			ИЛИ ЕСТЬNULL(втКорректировкиМонетарныхПоНемонетарным.КорректировкаВО, 0) <> 0)";

	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();

	Содержание = НСтр("ru = 'Изменение валютного курса при пересчете в функциональную валюту немонетарного счета'", КодЯзыка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Комментарий", СтрШаблон(" ""%1"" ", Содержание));

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ПроводкиПереносаНаРКР_СторноПрибыли()
	
	//Была прибыль(Дт62_Кт97п): когда НКР>0
	// Дт 62 Кт 98(НКР,д) = -СуммаНКР
	// Дт 62 Кт 91(РКР,д) = СуммаНКР
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	втРасчет.Валюта КАК ВалютаДт,
	|	0 КАК СуммаВВалютеДт,
	|	втРасчет.Счет КАК СчетДт,
	|	втРасчет.Субконто1 КАК СубконтоДт1,
	|	втРасчет.Субконто2 КАК СубконтоДт2,
	|	втРасчет.Субконто3 КАК СубконтоДт3,
	|	втРасчет.Подразделение КАК ПодразделениеДт,
	|	втРасчет.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	втРасчет.Валюта КАК ВалютаКт,
	|	0 КАК СуммаВВалютеКт,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаПрибыли
	|		ИНАЧЕ втСчета.СчетУчетаПрибылиРКР
	|	КОНЕЦ КАК СчетКт,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаПрибылиСубконто1
	|		ИНАЧЕ втСчета.СчетУчетаПрибылиРКРСубконто1
	|	КОНЕЦ КАК СубконтоКт1,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаПрибылиСубконто2
	|		ИНАЧЕ втСчета.СчетУчетаПрибылиРКРСубконто2
	|	КОНЕЦ КАК СубконтоКт2,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаПрибылиСубконто3
	|		ИНАЧЕ втСчета.СчетУчетаПрибылиРКРСубконто3
	|	КОНЕЦ КАК СубконтоКт3,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаПрибылиУчетПоПодразделениям
	|			ТОГДА т.Подразделение
	|	КОНЕЦ КАК ПодразделениеКт,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаПрибылиУчетПоНаправлениямДеятельности
	|			ТОГДА т.НаправлениеДеятельности
	|	КОНЕЦ КАК НаправлениеДеятельностиКт,
	|	т.СНДНКРФВ * втРасчет.КоэффициентСписанияНКР * втОперацииСписаниеНКР.Коэффициент КАК СуммаФВ,
	|	т.СНДНКРВО * втРасчет.КоэффициентСписанияНКР * втОперацииСписаниеНКР.Коэффициент КАК СуммаВО,
	|	втОперацииСписаниеНКР.ВидОперации КАК ВидОперации,
	|	втОперацииСписаниеНКР.Комментарий КАК Комментарий
	|ИЗ
	|	втОстаткиНаНачалоНКР КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРасчет КАК втРасчет
	|		ПО т.Счет = втРасчет.Счет
	|			И (ЕСТЬNULL(т.Подразделение = втРасчет.Подразделение, ИСТИНА))
	|			И (ЕСТЬNULL(т.НаправлениеДеятельности = втРасчет.НаправлениеДеятельности, ИСТИНА))
	|			И (втРасчет.ЭтоРКР)
	|			И т.Валюта = втРасчет.Валюта
	|			И (втРасчет.Субконто1 В (т.Субконто1, НЕОПРЕДЕЛЕНО))
	|			И (втРасчет.Субконто2 В (т.Субконто2, НЕОПРЕДЕЛЕНО))
	|			И (втРасчет.Субконто3 В (т.Субконто3, НЕОПРЕДЕЛЕНО))
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОперацииСписаниеНКР КАК втОперацииСписаниеНКР
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.Счет = втСчета.Счет
	|ГДЕ
	|	(т.СНДНКРФВ > 0
	|			ИЛИ т.СНДНКРВО > 0)
	|	И втРасчет.КоэффициентСписанияНКР > 0";

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ПроводкиПереносаНаРКР_СторноУбытка()
	
	//Был убыток(Дт97у_Кт60): когда НКР<0, СуммаДО>0
	// Дт 97у Кт 60 = -СуммаНКР
	// Дт 91 Кт 60 = СуммаНКР
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	втРасчет.Валюта КАК ВалютаДт,
	|	0 КАК СуммаВВалютеДт,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаУбытка
	|		ИНАЧЕ втСчета.СчетУчетаУбыткаРКР
	|	КОНЕЦ КАК СчетДт,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаУбыткаСубконто1
	|		ИНАЧЕ втСчета.СчетУчетаУбыткаРКРСубконто1
	|	КОНЕЦ КАК СубконтоДт1,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаУбыткаСубконто2
	|		ИНАЧЕ втСчета.СчетУчетаУбыткаРКРСубконто2
	|	КОНЕЦ КАК СубконтоДт2,
	|	ВЫБОР
	|		КОГДА втОперацииСписаниеНКР.ЭтоСторно
	|			ТОГДА втСчета.СчетУчетаУбыткаСубконто3
	|		ИНАЧЕ втСчета.СчетУчетаУбыткаРКРСубконто3
	|	КОНЕЦ КАК СубконтоДт3,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаУбыткаУчетПоПодразделениям
	|			ТОГДА т.Подразделение
	|	КОНЕЦ КАК ПодразделениеДт,
	|	ВЫБОР
	|		КОГДА втСчета.СчетУчетаУбыткаУчетПоНаправлениямДеятельности
	|			ТОГДА т.НаправлениеДеятельности
	|	КОНЕЦ КАК НаправлениеДеятельностиДт,
	|	втРасчет.Валюта КАК ВалютаКт,
	|	0 КАК СуммаВВалютеКт,
	|	втРасчет.Счет КАК СчетКт,
	|	втРасчет.Субконто1 КАК СубконтоКт1,
	|	втРасчет.Субконто2 КАК СубконтоКт2,
	|	втРасчет.Субконто3 КАК СубконтоКт3,
	|	втРасчет.Подразделение КАК ПодразделениеКт,
	|	втРасчет.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	-т.СНДНКРФВ * втРасчет.КоэффициентСписанияНКР * втОперацииСписаниеНКР.Коэффициент КАК СуммаФВ,
	|	-т.СНДНКРВО * втРасчет.КоэффициентСписанияНКР * втОперацииСписаниеНКР.Коэффициент КАК СуммаВО,
	|	втОперацииСписаниеНКР.ВидОперации КАК ВидОперации,
	|	втОперацииСписаниеНКР.Комментарий КАК Комментарий
	|ИЗ
	|	втОстаткиНаНачалоНКР КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРасчет КАК втРасчет
	|		ПО т.Счет = втРасчет.Счет
	|			И (ЕСТЬNULL(т.Подразделение = втРасчет.Подразделение, ИСТИНА))
	|			И (ЕСТЬNULL(т.НаправлениеДеятельности = втРасчет.НаправлениеДеятельности, ИСТИНА))
	|			И (втРасчет.ЭтоРКР)
	|			И т.Валюта = втРасчет.Валюта
	|			И (втРасчет.Субконто1 В (т.Субконто1, НЕОПРЕДЕЛЕНО))
	|			И (втРасчет.Субконто2 В (т.Субконто2, НЕОПРЕДЕЛЕНО))
	|			И (втРасчет.Субконто3 В (т.Субконто3, НЕОПРЕДЕЛЕНО))
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОперацииСписаниеНКР КАК втОперацииСписаниеНКР
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.Счет = втСчета.Счет
	|ГДЕ
	|	(-1 * т.СНДНКРФВ > 0
	|			ИЛИ -1 * т.СНДНКРВО > 0)
	|	И втРасчет.КоэффициентСписанияНКР > 0";

	Возврат ТекстЗапроса;
	
КонецФункции

