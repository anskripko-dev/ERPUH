	|				И (ЕстьNULL(КорРасчет.ЭтоРКР, ЛОЖЬ) В (ЛОЖЬ, НЕОПРЕДЕЛЕНО))
	|				И (ЗаменитьКоррСчет.Счет ЕСТЬ NULL)) КАК р";
	
	Возврат ТекстЗапроса;
	
