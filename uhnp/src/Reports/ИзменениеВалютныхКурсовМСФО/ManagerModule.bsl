
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ТекстЗапроса_Отчет(Реквизиты) Экспорт

	НомераТаблиц = Новый Структура; 
	ТекстЗапроса = Новый Массив;
	
	Реквизиты.Вставить("ВыводОтчета", Истина);
	
	ДобавитьТекстыЗапросов(ТекстЗапроса, НомераТаблиц, Реквизиты);
	
	Возврат СтрСоединить(ТекстЗапроса,
		ПроведениеСерверУХ.РазделительЗапросовВПакете());

КонецФункции

Функция ТекстЗапроса_Документ(Реквизиты, НомераТаблиц) Экспорт

	ТекстЗапроса = Новый Массив;
	Реквизиты.Вставить("ВыводОтчета", Ложь);
	
	ДобавитьТекстыЗапросов(ТекстЗапроса, НомераТаблиц, Реквизиты);
	
	Если Реквизиты.ФормироватьПроводкиМСФО Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаИсключения(НомераТаблиц));
		ТекстЗапроса.Добавить(ТекстЗапроса_втСписанияНемонетарных(НомераТаблиц));
		
		ДобавитьТекстыЗапросов_РаспределениеСписаний(ТекстЗапроса, НомераТаблиц, Ложь);
		
		ТекстЗапроса.Добавить(ТекстЗапроса_втКорректировкиНемонетарныхДляПриемника(НомераТаблиц));
	Иначе 
		ТекстЗапроса.Добавить(ТекстЗапроса_втКорректировкиНемонетарныхДляПриемникаТК(НомераТаблиц));
	КонецЕсли;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_ТаблицаПроводок(
		НомераТаблиц, Реквизиты.ФормироватьПроводкиМСФО));
	
	ТекстЗапроса = СтрСоединить(ТекстЗапроса, 
		ПроведениеСерверУХ.РазделительЗапросовВПакете());
	
	Возврат СтроковыеФункцииКлиентСервер
		.ЗаменитьОдниСимволыДругими("{}", ТекстЗапроса, "");
	
КонецФункции

#КонецОбласти

#Область ТекстЗапроса

Процедура ДобавитьТекстыЗапросов(ТекстЗапроса, НомераТаблиц, Реквизиты)
	
	ЕстьРСБУ = УчетМСФОПовтИспУХ.ЕстьРСБУ();
	
	ТекстЗапроса.Добавить(ТекстЗапроса_ВалютаСтраны(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_КотировкиСтраны(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_ЗначенияКотировокСтраны(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_КурсыВалют(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_Курсы(НомераТаблиц));
	
	ТекстЗапроса.Добавить(ТекстЗапроса_СчетВО(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчета(НомераТаблиц));
	ТекстЗапроса.Добавить(ТекстЗапроса_втСчетаНСБУ(НомераТаблиц));
	
	Если Реквизиты.ВыводОтчета = Истина Тогда
		ТекстЗапроса.Добавить(ТекстЗапроса_ВидОперацииКР(НомераТаблиц));
	КонецЕсли;
	
	Если Реквизиты.ФормироватьПроводкиМСФО Тогда
		
		ТекстЗапроса.Добавить(ТекстЗапроса_втОСВНСБУ_ТУ(НомераТаблиц, Не ЕстьРСБУ));
		ТекстЗапроса.Добавить(ТекстЗапроса_втОСВМСФО_ТУ(НомераТаблиц, Реквизиты));
		
		ТекстЗапроса.Добавить(ТекстЗапроса_втОперацииСписаниеНКР(НомераТаблиц));
		ТекстЗапроса.Добавить(ТекстЗапроса_втОстаткиНаНачалоНКР(НомераТаблиц));
		
	Иначе
		
		ТекстЗапроса.Добавить(ТекстЗапроса_втОСВНСБУ_ТУ(НомераТаблиц, Не ЕстьРСБУ));
		
		ТекстЗапроса.Добавить(ТекстЗапроса_втВЗП(НомераТаблиц, Реквизиты));
		ТекстЗапроса.Добавить(ТекстЗапроса_втПоказателиОтчета(НомераТаблиц));
		ТекстЗапроса.Добавить(ТекстЗапроса_втОСВМСФО_ТК(НомераТаблиц, Реквизиты));
		
	КонецЕсли;
	
	ТекстЗапроса.Добавить(ТекстЗапроса_втРасчет(НомераТаблиц, Реквизиты.ВыводОтчета));
	
КонецПроцедуры

#Область СчетаКурсы

Функция ТекстЗапроса_ВалютаСтраны(НомераТаблиц)

	НомераТаблиц.Вставить("ВалютаСтраны", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВалютыСтран.Валюта КАК ВалютаБанкаСтраны,
	|	ВалютаРегл.Значение КАК ВалютаРУ,
	|	ВалютаРегл.Значение <> ЕСТЬNULL(ВалютыСтран.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ЕстьВалютаСтраны,
	|	ВалютаРегл.Значение <> &ФункциональнаяВалюта КАК ЕстьКроссКурс,
	|	ВалютыСтран.Страна КАК Страна
	|ПОМЕСТИТЬ ВалютаСтраны
	|ИЗ
	|	Константа.ВалютаРегламентированногоУчета КАК ВалютаРегл
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВалютыСтран КАК ВалютыСтран
	|		ПО (ВалютыСтран.Страна = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).СтранаРегистрации)";
	
КонецФункции

Функция ТекстЗапроса_КотировкиСтраны(НомераТаблиц)

	НомераТаблиц.Вставить("КотировкиСтраны", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК ВидКотировки,
	|	т.Валюта КАК Валюта,
	|	т.ФункциональнаяВалюта КАК ФункциональнаяВалюта
	|ПОМЕСТИТЬ КотировкиСтраны
	|ИЗ
	|	Справочник.ВидыКотировокФинансовыхИнструментов КАК т
	|ГДЕ
	|	т.ТипКотировки = ЗНАЧЕНИЕ(Перечисление.ТипыКотировокФинансовыхИнструментов.КурсВалюты)
	|	И т.Страна В
	|			(ВЫБРАТЬ
	|				ВалютаСтраны.Страна
	|			ИЗ
	|				ВалютаСтраны КАК ВалютаСтраны
	|			ГДЕ
	|				ВалютаСтраны.ЕстьВалютаСтраны)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидКотировки";

КонецФункции

Функция ТекстЗапроса_ЗначенияКотировокСтраны(НомераТаблиц)

	НомераТаблиц.Вставить("ЗначенияКотировокСтраны", НомераТаблиц.Количество());
	
	Возврат
	"ВЫБРАТЬ
	|	КотировкиСтраны.Валюта КАК Валюта,
	|	КотировкиСтраны.ФункциональнаяВалюта КАК ФункциональнаяВалюта,
	|	т.Период КАК Период,
	|	т.ВидКотировки КАК ВидКотировки,
	|	т.Значение КАК Курс,
	|	т.Кратность КАК Кратность
	|ПОМЕСТИТЬ ЗначенияКотировокСтраны
	|ИЗ
	|	РегистрСведений.ЗначенияКотировокФИ.СрезПоследних(
	|			{(&КонецПериода)},
	|			ВидКотировки В
	|				(ВЫБРАТЬ
	|					КотировкиСтраны.ВидКотировки
	|				ИЗ
	|					КотировкиСтраны КАК КотировкиСтраны)) КАК т ЛЕВОЕ СОЕДИНЕНИЕ КотировкиСтраны КАК КотировкиСтраны ПО т.ВидКотировки = КотировкиСтраны.ВидКотировки";

КонецФункции

Функция ТекстЗапроса_КурсыВалют(НомераТаблиц)

	НомераТаблиц.Вставить("КурсыВалют", НомераТаблиц.Количество());

	Возврат
	"ВЫБРАТЬ
	|	т.Период КАК Период,
	|	т.Валюта КАК Валюта,
	|	т.Курс КАК Курс,
	|	т.Кратность КАК Кратность
	|ПОМЕСТИТЬ втКурсыВалют
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(
	|			{(&КонецПериода)},
	|			НЕ ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							ЗначенияКотировокСтраны КАК ЗначенияКотировокСтраны)
	|				И НЕ Валюта В
	|						(ВЫБРАТЬ
	|							ВалютаСтраны.ВалютаРУ
	|						ИЗ
	|							ВалютаСтраны КАК ВалютаСтраны)) КАК т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	ВалютаСтраны.ВалютаРУ,
	|	1,
	|	1
	|ИЗ
	|	ВалютаСтраны КАК ВалютаСтраны
	|ГДЕ
	|	НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					ЗначенияКотировокСтраны КАК ЗначенияКотировокСтраны)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Период,
	|	т.Валюта,
	|	т.Курс,
	|	т.Кратность
	|ИЗ
	|	ЗначенияКотировокСтраны КАК т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта";
	
КонецФункции

Функция ТекстЗапроса_Курсы(НомераТаблиц)
	
	НомераТаблиц.Вставить("Курсы", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	КурсСчета.Валюта КАК Валюта,
	|	КурсСчета.Курс * ЕСТЬNULL(КурсФВ.Кратность, 1) КАК КурсФВ,
	|	КурсСчета.Кратность * ЕСТЬNULL(КурсФВ.Курс, 1) КАК КратностьФВ,
	|	КурсФВ.Курс * ЕСТЬNULL(КурсВО.Кратность, 1) КАК КурсВО,
	|	КурсФВ.Кратность * ЕСТЬNULL(КурсВО.Курс, 1) КАК КратностьВО
	|ПОМЕСТИТЬ втКурсы
	|ИЗ
	|	втКурсыВалют КАК КурсСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсыВалют КАК КурсФВ
	|		ПО (КурсФВ.Валюта = &ФункциональнаяВалюта)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсыВалют КАК КурсВО
	|		ПО (КурсВО.Валюта = &ВалютаПредставления)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта";

КонецФункции

Функция ТекстЗапроса_СчетВО(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСчетВО", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.Счет КАК СчетБД,
	|	т.Счет.СчетСсылка КАК СчетСсылка,
	|	т.Субконто1 КАК Субконто1,
	|	т.Субконто2 КАК Субконто2,
	|	т.Субконто3 КАК Субконто3,
	|	т.Счет.Валютный КАК Валютный,
	|	т.Счет.СчетСсылка.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	т.Счет.СчетСсылка.УчетПоНаправлениямДеятельности КАК УчетПоНаправлениямДеятельности
	|ПОМЕСТИТЬ втСчетВО
	|ИЗ
	|	Справочник.ФиксированныеСчетаУчетаБД КАК т
	|ГДЕ
	|	т.Ссылка = ЗНАЧЕНИЕ(Справочник.ФиксированныеСчетаУчетаБД.ТрансляционныйРезерв)
	|	И т.Счет <> ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)";
	
	Возврат Документы.УчетнаяПолитикаМСФО
		.ЗаменитьФиксированныеСчетаУчетаБД(ТекстЗапроса);

КонецФункции

Функция ТекстЗапроса_втСчета(НомераТаблиц)
	
	НомераТаблиц.Вставить("втСчета", НомераТаблиц.Количество());

	Возврат 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &ФормироватьПроводкиМСФО
	|			ТОГДА СчетаБД.СчетСсылка
	|		ИНАЧЕ МАКСИМУМ(СчетаБД.Ссылка)
	|	КОНЕЦ КАК Счет,
	|	МАКСИМУМ(СчетаБД.Ссылка) КАК СчетБД,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(СчетаБД.ПересчетВФВ) = ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.Монетарный)
	|			ТОГДА ВЫБОР
	|					КОГДА МАКСИМУМ(СчетаБД.Валютный)
	|							И МАКСИМУМ(НастройкиКурсов.ВыделятьРКР)
	|							И МАКСИМУМ(СчетаБД.РазделПланаСчетов) <> ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.ДенежныеСредства)
	|						ТОГДА ""МонетарныеВалютныеВыделятьРКР""
	|					КОГДА МАКСИМУМ(СчетаБД.Валютный)
	|						ТОГДА ""МонетарныеВалютные""
	|					КОГДА &ИзменениеФВ
	|							И &ВОизИВ
	|						ТОГДА ""МонетарныеНевалютныеВО""
	|					КОГДА &ИзменениеФВ
	|						ТОГДА ""МонетарныеНеВалютныеНСБУ""
	|					КОГДА &ФункциональнаяВалюта <> &ВалютаПредставления
	|							И МАКСИМУМ(СчетаБД.ПересчетВВО) = ИСТИНА
	|							И НЕ МАКСИМУМ(втСчетВО.СчетСсылка) ЕСТЬ NULL
	|						ТОГДА ""_КорректироватьВО""
	|				КОНЕЦ
	|		КОГДА МАКСИМУМ(СчетаБД.ПересчетВФВ) В (ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.НеМонетарный), ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.НеМонетарныйСпрС))
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ &ИзменениеФВ
	|							И НЕ МАКСИМУМ(СчетаБД.СчетСсылка.Валютный)
	|						ТОГДА NULL
	|					КОГДА ЛОЖЬ
	|						ТОГДА ""_ЗакрытиеСчетов""
	|					КОГДА МАКСИМУМ(СчетаБД.СчетСсылка.Количественный)
	|						ТОГДА ""НемонетарныеКоличественные""
	|					КОГДА МАКСИМУМ(СчетаБД.СчетСсылка.Валютный)
	|						ТОГДА ""НемонетарныеВалютные""
	|					КОГДА &ИзменениеФВ
	|						ТОГДА ""НемонетарныеНеКоличественные""
	|					КОГДА &ФункциональнаяВалюта <> &ВалютаПредставления
	|							И ЕСТЬNULL(МАКСИМУМ(СчетаБД.ПересчетВВО), ЛОЖЬ) = ИСТИНА
	|							И НЕ МАКСИМУМ(втСчетВО.СчетСсылка) ЕСТЬ NULL
	|						ТОГДА ""_КорректироватьВО""
	|				КОНЕЦ
	|		КОГДА &ФункциональнаяВалюта <> &ВалютаПредставления
	|				И ЕСТЬNULL(МАКСИМУМ(СчетаБД.ПересчетВВО), ЛОЖЬ) = ИСТИНА
	|				И НЕ МАКСИМУМ(втСчетВО.СчетСсылка) ЕСТЬ NULL
	|			ТОГДА ""_КорректироватьВО""
	|	КОНЕЦ КАК КорректировкаФВ,
	|	МАКСИМУМ(СчетаБД.ПересчетВВО) = ИСТИНА
	|		И НЕ МАКСИМУМ(втСчетВО.СчетСсылка) ЕСТЬ NULL КАК КорректироватьВО,
	|	МАКСИМУМ(СчетаБД.Валютный) КАК Валютный,
	|	МАКСИМУМ(СчетаБД.Вид) <> ЗНАЧЕНИЕ(Перечисление.ВидыСчетовБД.Пассивный) КАК ИзменениеАктивногоСчета,
	|	МАКСИМУМ(СчетаБД.РазделПланаСчетов) В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.Баланс)) КАК СчетБаланса,
	|	ВЫБОР МАКСИМУМ(СчетаБД.ПересчетВФВ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.Монетарный)
	|			ТОГДА ИСТИНА
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.НеМонетарный)
	|			ТОГДА ЛОЖЬ
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.НеМонетарныйСпрС)
	|			ТОГДА ЛОЖЬ
	|	КОНЕЦ КАК Монетарный,
	|	ЕСТЬNULL(МАКСИМУМ(ВЫБОР
	|				КОГДА НЕ СчетаБДВидыСубконто.ТолькоОбороты
	|					ТОГДА СчетаБДВидыСубконто.Номер
	|			КОНЕЦ), 0) КАК КоличествоНеоборотных,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СчетаБДВидыСубконто.Номер = 1
	|				ТОГДА НЕ СчетаБДВидыСубконто.ТолькоОбороты
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконто1,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СчетаБДВидыСубконто.Номер = 2
	|				ТОГДА НЕ СчетаБДВидыСубконто.ТолькоОбороты
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконто2,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СчетаБДВидыСубконто.Номер = 3
	|				ТОГДА НЕ СчетаБДВидыСубконто.ТолькоОбороты
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконто3,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СчетаБДВидыСубконто.Номер = 1
	|					И НЕ СчетаБДВидыСубконто.ТолькоОбороты
	|				ТОГДА ВЫРАЗИТЬ(СчетаБДВидыСубконто.ТипДанных КАК СТРОКА(500))
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ТипСубконто1,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СчетаБДВидыСубконто.Номер = 2
	|					И НЕ СчетаБДВидыСубконто.ТолькоОбороты
	|				ТОГДА ВЫРАЗИТЬ(СчетаБДВидыСубконто.ТипДанных КАК СТРОКА(500))
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ТипСубконто2,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СчетаБДВидыСубконто.Номер = 3
	|					И НЕ СчетаБДВидыСубконто.ТолькоОбороты
	|				ТОГДА ВЫРАЗИТЬ(СчетаБДВидыСубконто.ТипДанных КАК СТРОКА(500))
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ТипСубконто3,
	|	ЛОЖЬ КАК ОборотнаяАналитикаСписания,
	|	ЕСТЬNULL(МАКСИМУМ(НЕ ИсключенияУП.УчетнаяПолитика ЕСТЬ NULL
	|				И ИсключенияУП.НастройкаКурсовыхРазниц = ЗНАЧЕНИЕ(Справочник.СчетаУчетаКурсовыхРазниц.ПустаяСсылка)), ЛОЖЬ) КАК ПустоеИсключение,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибыли) КАК СчетУчетаПрибыли,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибыли.СчетСсылка.Валютный) КАК СчетУчетаПрибылиВалютный,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибыли.СчетСсылка.УчетПоПодразделениям) КАК СчетУчетаПрибылиУчетПоПодразделениям,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибыли.СчетСсылка.УчетПоНаправлениямДеятельности) КАК СчетУчетаПрибылиУчетПоНаправлениямДеятельности,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиСубконто1) КАК СчетУчетаПрибылиСубконто1,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиСубконто2) КАК СчетУчетаПрибылиСубконто2,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиСубконто3) КАК СчетУчетаПрибылиСубконто3,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбытка) КАК СчетУчетаУбытка,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбытка.СчетСсылка.Валютный) КАК СчетУчетаУбыткаВалютный,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбытка.СчетСсылка.УчетПоПодразделениям) КАК СчетУчетаУбыткаУчетПоПодразделениям,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбытка.СчетСсылка.УчетПоНаправлениямДеятельности) КАК СчетУчетаУбыткаУчетПоНаправлениямДеятельности,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаСубконто1) КАК СчетУчетаУбыткаСубконто1,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаСубконто2) КАК СчетУчетаУбыткаСубконто2,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаСубконто3) КАК СчетУчетаУбыткаСубконто3,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиРКР) КАК СчетУчетаПрибылиРКР,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиРКР.СчетСсылка.Валютный) КАК СчетУчетаПрибылиРКРВалютный,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиРКР.СчетСсылка.УчетПоПодразделениям) КАК СчетУчетаПрибылиРКРУчетПоПодразделениям,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиРКР.СчетСсылка.УчетПоНаправлениямДеятельности) КАК СчетУчетаПрибылиРКРУчетПоНаправлениямДеятельности,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиРКРСубконто1) КАК СчетУчетаПрибылиРКРСубконто1,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиРКРСубконто2) КАК СчетУчетаПрибылиРКРСубконто2,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаПрибылиРКРСубконто3) КАК СчетУчетаПрибылиРКРСубконто3,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаРКР) КАК СчетУчетаУбыткаРКР,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаРКР.СчетСсылка.Валютный) КАК СчетУчетаУбыткаРКРВалютный,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаРКР.СчетСсылка.УчетПоПодразделениям) КАК СчетУчетаУбыткаРКРУчетПоПодразделениям,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаРКР.СчетСсылка.УчетПоНаправлениямДеятельности) КАК СчетУчетаУбыткаРКРУчетПоНаправлениямДеятельности,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаРКРСубконто1) КАК СчетУчетаУбыткаРКРСубконто1,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаРКРСубконто2) КАК СчетУчетаУбыткаРКРСубконто2,
	|	МАКСИМУМ(НастройкиКурсов.СчетУчетаУбыткаРКРСубконто3) КАК СчетУчетаУбыткаРКРСубконто3,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(НастройкиКурсов.ВидОперации) = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОпераций._02ПереоценкаВалютныхАктивовИОбязательств)
	|		ИНАЧЕ МАКСИМУМ(НастройкиКурсов.ВидОперации)
	|	КОНЕЦ КАК ВидОперации,
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.РеализованныеКурсовыеРазницы) КАК ВидОперацииРКР,
	|	МАКСИМУМ(НастройкиКурсов.ВыделятьРКР) КАК ВыделятьРКР,
	|	МАКСИМУМ(НастройкиКурсов.ВыделятьРКР) И ИСТИНА КАК ПогашатьНКР,
	|	МАКСИМУМ(СчетаБД.ПересчетВФВ) КАК ПересчетВФВ,
	|	МАКСИМУМ(втСчетВО.СчетСсылка) КАК СчетВО,
	|	МАКСИМУМ(втСчетВО.Валютный) КАК СчетВОВалютный,
	|	МАКСИМУМ(втСчетВО.УчетПоПодразделениям) КАК СчетВОУчетПоПодразделениям,
	|	МАКСИМУМ(втСчетВО.УчетПоНаправлениямДеятельности) КАК СчетВОУчетПоНаправлениямДеятельности,
	|	МАКСИМУМ(втСчетВО.Субконто1) КАК СчетВОСубконто1,
	|	МАКСИМУМ(втСчетВО.Субконто2) КАК СчетВОСубконто2,
	|	МАКСИМУМ(втСчетВО.Субконто3) КАК СчетВОСубконто3
	|ПОМЕСТИТЬ втСчета
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиКурсовыхРазниц КАК ИсключенияУП
	|		ПО СчетаБД.Ссылка = ИсключенияУП.Счет
	|			И (ИсключенияУП.УчетнаяПолитика = &УчетнаяПолитика)
	|			И (СчетаБД.ПересчетВФВ = ЗНАЧЕНИЕ(Перечисление.ПересчетыВФВ.Монетарный))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаУчетаКурсовыхРазниц КАК НастройкиКурсов
	|		ПО (ЕСТЬNULL(ИсключенияУП.НастройкаКурсовыхРазниц, СчетаБД.СчетаУчетаКурсовыхРазниц) = НастройкиКурсов.Ссылка)
	|			И СчетаБД.Владелец = НастройкиКурсов.ПланСчетовБД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК СчетаБДВидыСубконто
	|		ПО СчетаБД.Ссылка = СчетаБДВидыСубконто.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСчетВО КАК втСчетВО
	|		ПО (ИСТИНА)
	|ГДЕ
	|	СчетаБД.Владелец = &ПланСчетовМСФО
	|	И ВЫБОР
	|			КОГДА СчетаБД.СчетаУчетаКурсовыхРазниц = ЗНАЧЕНИЕ(Справочник.СчетаУчетаКурсовыхРазниц.ПустаяСсылка)
	|				ТОГДА СчетаБД.РазделПланаСчетов В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.РазделыПланаСчетов.Баланс))
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетаБД.СчетСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет";

КонецФункции

Функция ТекстЗапроса_ВидОперацииКР(НомераТаблиц)

	НомераТаблиц.Вставить("втВидОперацииКР", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	т.ВидОперации КАК ВидОперации
	|ПОМЕСТИТЬ втВидОперацииКР
	|ИЗ
	|	втСчета КАК т
	|ГДЕ
	|	т.ВидОперации ССЫЛКА Справочник.ВидыОпераций
	|	И т.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ВидыОпераций.РеализованныеКурсовыеРазницы)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидОперации";

КонецФункции

Функция ТекстЗапроса_втСчетаНСБУ(НомераТаблиц)

	НомераТаблиц.Вставить("втСчетаНСБУ", НомераТаблиц.Количество());
	
	Возврат 
	"ВЫБРАТЬ
	|	втСчета.ИзменениеАктивногоСчета КАК ИзменениеАктивногоСчета,
	|	т.СчетИсточник КАК СчетНСБУ,
	|	т.СчетПриемник КАК СчетМСФО,
	|	т.СчетИсточник.СчетСсылка КАК СчетСсылкаНСБУ,
	|	т.СчетПриемник.СчетСсылка КАК СчетСсылкаМСФО,
	|	втСчета.КорректировкаФВ = ""МонетарныеНеВалютныеНСБУ"" КАК МонетарныеНеВалютныеНСБУ,
	|	ИСТИНА В
	|		(ВЫБРАТЬ
	|			ИСТИНА
	|		ИЗ
	|			Справочник.СчетаБД.ВидыСубконто КАК вс
	|		ГДЕ
	|			вс.Ссылка = т.СчетИсточник
	|			И вс.НомерСтроки = 1
	|			И (ВЫРАЗИТЬ(вс.ТипДанных КАК СТРОКА(500))) = втСчета.ТипСубконто1
	|			И втСчета.ЕстьСубконто1) КАК ЕстьСубконто1,
	|	ИСТИНА В
	|		(ВЫБРАТЬ
	|			ИСТИНА
	|		ИЗ
	|			Справочник.СчетаБД.ВидыСубконто КАК вс
	|		ГДЕ
	|			вс.Ссылка = т.СчетИсточник
	|			И вс.НомерСтроки = 2
	|			И (ВЫРАЗИТЬ(вс.ТипДанных КАК СТРОКА(500))) = втСчета.ТипСубконто2
	|			И втСчета.ЕстьСубконто2) КАК ЕстьСубконто2,
	|	ИСТИНА В
	|		(ВЫБРАТЬ
	|			ИСТИНА
	|		ИЗ
	|			Справочник.СчетаБД.ВидыСубконто КАК вс
	|		ГДЕ
	|			вс.Ссылка = т.СчетИсточник
	|			И вс.НомерСтроки = 3
	|			И (ВЫРАЗИТЬ(вс.ТипДанных КАК СТРОКА(500))) = втСчета.ТипСубконто3
	|			И втСчета.ЕстьСубконто3) КАК ЕстьСубконто3
	|ПОМЕСТИТЬ втСчетаНСБУ
	|ИЗ
	|	Справочник.СоответствияСчетовДляТрансляции КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСчета КАК втСчета
	|		ПО т.СчетПриемник = втСчета.СчетБД
	|			И (втСчета.КорректировкаФВ В (""МонетарныеНеВалютныеНСБУ"", ""НемонетарныеНеКоличественные""))
	|ГДЕ
	|	т.Владелец = ВЫРАЗИТЬ(&УчетнаяПолитика КАК Документ.УчетнаяПолитикаМСФО).ШаблонТрансляции
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	МонетарныеНеВалютныеНСБУ,
	|	СчетМСФО";

КонецФункции

