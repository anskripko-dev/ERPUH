	|			ЛЕВОЕ СОЕДИНЕНИЕ втРасчет КАК КорРасчет
	|			ПО т.СчетКт = КорРасчет.Счет
	|				И (ЕСТЬNULL(т.ПодразделениеКт = КорРасчет.Подразделение, ИСТИНА))
	|				И (ЕСТЬNULL(т.НаправлениеДеятельностиКт = КорРасчет.НаправлениеДеятельности, ИСТИНА))
	|				И (КорРасчет.Субконто1 В (т.СубконтоКт1, НЕОПРЕДЕЛЕНО))
