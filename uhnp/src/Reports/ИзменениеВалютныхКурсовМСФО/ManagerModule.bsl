	|					И Сценарий = &Сценарий
	|					И ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Трансляция)) КАК т
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРасчет КАК втРасчет
	|			ПО т.СчетДт = втРасчет.Счет
	|				И (ЕСТЬNULL(т.ПодразделениеДт = втРасчет.Подразделение, ИСТИНА))
	|				И (ЕСТЬNULL(т.НаправлениеДеятельностиДт = втРасчет.НаправлениеДеятельности, ИСТИНА))
	|				И (втРасчет.ИзменениеФВ <> 0
	|					ИЛИ втРасчет.ИзменениеВО <> 0)
	|				И (втРасчет.Субконто1 В (т.СубконтоДт1, НЕОПРЕДЕЛЕНО))
	|				И (втРасчет.Субконто2 В (т.СубконтоДт2, НЕОПРЕДЕЛЕНО))
	|				И (втРасчет.Субконто3 В (т.СубконтоДт3, НЕОПРЕДЕЛЕНО))
	|			ЛЕВОЕ СОЕДИНЕНИЕ втСчета КАК ЗаменитьКоррСчет
	|			ПО т.СчетДт = ЗаменитьКоррСчет.Счет
	|				И (т.СчетКт В
	|					(ВЫБРАТЬ
	|						с.Счет
	|					ИЗ
