	ТЗ.Колонки.Добавить("ЦенаНаЭкспорт", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	ТЗ.Колонки.Добавить("СтатусКонтрагентаПоМСФО", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОтношенийКГруппе"));
