	ТЗ.Колонки.Добавить("Завод", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда 
		
		ТЗОбработанныхРеализаций = 	ТЗ.СкопироватьКолонки("Номенклатура,ВходящееКоличествоГПОтЗавода");	
		ТЗОбработанныхРеализаций.Колонки.Добавить("ДокументПоступления", Новый ОписаниеТипов("ДокументСсылка.ПриобретениеТоваровУслуг"));
		
		ВыборкаНоменклатура = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаНоменклатура.Следующий() Цикл
			ВыборкаДокументРеализации = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДокументРеализации.Следующий() Цикл
				
				ОсталосьСписать = ВыборкаДокументРеализации.КоличествоРеализованнойНаЭкспортГП;		
				ВыборкаДетальныеЗаписи = ВыборкаДокументРеализации.Выбрать();
				ТЗОстаток = ТЗ.СкопироватьКолонки();
				Пока ВыборкаДетальныеЗаписи.Следующий() И ОсталосьСписать <> 0 Цикл
							
					МассивОбработанныхСтрок = ТЗОбработанныхРеализаций.НайтиСтроки(Новый Структура("Номенклатура, ДокументПоступления",
					ВыборкаДетальныеЗаписи.Номенклатура, ВыборкаДетальныеЗаписи.ДокументПоступления));		
					
					ВходящееКоличествоГПОтЗавода = ВыборкаДетальныеЗаписи.ВходящееКоличествоГПОтЗавода;
					Если МассивОбработанныхСтрок.Количество() > 0 Тогда  
						// НАЧАЛО Гутарова Екатерина 17.04.2023 Выполнение задач №000045202
						//Если МассивОбработанныхСтрок[0].ВходящееКоличествоГПОтЗавода = ВходящееКоличествоГПОтЗавода Тогда
						Если МассивОбработанныхСтрок[0].ВходящееКоличествоГПОтЗавода > ВходящееКоличествоГПОтЗавода Тогда   
						// КОНЕЦ Гутарова Екатерина 17.04.2023 Выполнение задач №000045202
							ТЗОстаток.Очистить();
							НСОст = ТЗОстаток.Добавить();
							ЗаполнитьЗначенияСвойств(НСОст,ВыборкаДетальныеЗаписи);
							Продолжить;
						Иначе
							ВходящееКоличествоГПОтЗавода =  ВходящееКоличествоГПОтЗавода - МассивОбработанныхСтрок[0].ВходящееКоличествоГПОтЗавода;
						КонецЕсли;	
					КонецЕсли;
					
					НС = ТЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НС, ВыборкаДетальныеЗаписи);   
					Если Не ВыборкаДетальныеЗаписи.ДокументПоступления = Документы.ПриобретениеТоваровУслуг.ПустаяСсылка() Тогда
						
						НС.ВходящееКоличествоГПОтЗавода = Окр(Мин(ОсталосьСписать, ВходящееКоличествоГПОтЗавода),3);    	
						НС.КоличествоРеализованнойНаЭкспортГП =  Окр(НС.ВходящееКоличествоГПОтЗавода,3);  
						
					КонецЕсли;
					
					ОсталосьСписать = ОсталосьСписать - НС.ВходящееКоличествоГПОтЗавода;	
					
					НСТЗ = ТЗОбработанныхРеализаций.Добавить();
					ЗаполнитьЗначенияСвойств(НСТЗ, ВыборкаДетальныеЗаписи);
					НСТЗ.ВходящееКоличествоГПОтЗавода = НС.ВходящееКоличествоГПОтЗавода; 
					
					ТЗОбработанныхРеализаций.Свернуть("Номенклатура, ДокументПоступления", "ВходящееКоличествоГПОтЗавода");
					
				КонецЦикла;
				
				// НАЧАЛО Гутарова Екатерина 25.07.2022 Выполнение задач №000042010
				//Если ОсталосьСписать <> 0 Тогда
				//	Если ТЗОстаток.Количество() > 0 Тогда 
				//		НС = ТЗ.Добавить();
				//		ЗаполнитьЗначенияСвойств(НС, НСОст);
				//	КонецЕсли;	
				//	НС.КоличествоРеализованнойНаЭкспортГП = ОсталосьСписать;
				//КонецЕсли;
				Если ОсталосьСписать <> 0 Тогда
					Если ТЗОстаток.Количество() > 0 Тогда 
						НСновая = ТЗ.Добавить();
						ЗаполнитьЗначенияСвойств(НСновая, НСОст); 
					Иначе
						Если ОсталосьСписать = НС.КоличествоРеализованнойНаЭкспортГП Тогда
							Продолжить;
						КонецЕсли;
						НСновая = ТЗ.Добавить();
						ЗаполнитьЗначенияСвойств(НСновая, НС);
						НСновая.ВходящееКоличествоГПОтЗавода = 0;
						НСновая.Завод = Справочники.Контрагенты.ПустаяСсылка();
						НСновая.ВходящаяЦенаОтЗавода = 0;
					КонецЕсли;	
					НСновая.КоличествоРеализованнойНаЭкспортГП = ОсталосьСписать;
				КонецЕсли;	
				// КОНЕЦ Гутарова Екатерина 25.07.2022 Выполнение задач №000042010
				
			КонецЦикла;
			
		КонецЦикла; 
		
	    // НАЧАЛО Гутарова Екатерина 17.04.2023 Выполнение задач №000045202	
		ПустыеСтроки = ТЗ.НайтиСтроки(Новый Структура("КоличествоРеализованнойНаЭкспортГП, ВходящееКоличествоГПОтЗавода",0,0)); 
		Для Каждого Строка Из ПустыеСтроки Цикл
			ТЗ.Удалить(Строка);
		КонецЦикла;	
	    // КОНЕЦ Гутарова Екатерина 17.04.2023 Выполнение задач №000045202
		
	КонецЕсли; 
	
	Возврат ТЗ;  
	
КонецФункции 
	
#КонецЕсли