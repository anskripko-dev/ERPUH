			П =	СтрПарам.Значение; 
			Если П.ДатаОкончания = Дата(1,1,1) Тогда
				Запрос.УстановитьПараметр("КонецПериода", Дата(3999,12,31));
			Иначе
				Запрос.УстановитьПараметр("КонецПериода", П.ДатаОкончания);
