			|			И ВТ_ДанныеКалендаря.Валюта = ВТ_СрезКурсов.Валюта
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведенияПлатежногоКалендаря КАК ДополнительныеСведенияПлатежногоКалендаря
			|		ПО ВТ_ДанныеКалендаря.БанковскийСчетКасса = ДополнительныеСведенияПлатежногоКалендаря.БанковскийСчет
			|			И (&ВерсияПлатежногоКалендаря = ДополнительныеСведенияПлатежногоКалендаря.ВерсияПлатежногоКалендаря)
			|			И (&Пользователь = ДополнительныеСведенияПлатежногоКалендаря.Пользователь)
			|ГДЕ
			|	(&ВТ_ДанныеКалендаряУсловиеСчетЗакрыт
			|			ИЛИ ВТ_ЕстьДвиженияПоСчетам.ЕстьДвижения)
			|	И ВТ_ДанныеКалендаря.Дата = &НачалоПериодаОтбора
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ДанныеКалендаря.БанковскийСчетКасса,
			|	ВТ_ДанныеКалендаря.Валюта,
			|	ВТ_ДанныеКалендаря.Банк,
			|	ВТ_ДанныеКалендаря.Дата,
			|	ВТ_ДанныеКалендаря.Организация,
			|	ВТ_ДанныеКалендаря.ПулЛиквидности,
			|	ВТ_ДанныеКалендаря.ВидДенежныхСредств,
			|	ВТ_ДанныеКалендаря.ЭтоРабочийДень,
			|	ЕСТЬNULL(ВТ_ДанныеКалендаря.НаИсполнении * ВТ_СрезКурсов.Коэффициент, ВТ_ДанныеКалендаря.НаИсполнении),
			|	ДополнительныеСведенияПлатежногоКалендаря.СреднийСрокОвердрафта,
			|	ДополнительныеСведенияПлатежногоКалендаря.ОвердрафтМНО,
			|	ДополнительныеСведенияПлатежногоКалендаря.ГлубинаОвердрафта,
			|	ЕСТЬNULL(ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток * ВТ_СрезКурсов.Коэффициент, ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток),
			|	ВТ_ДанныеКалендаря.ЕстьПросрочки > 0";
						
		Иначе
		
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ВТ_ВходящиеОстатки.БанковскийСчетКасса КАК БанковскийСчетКасса,
			|	ВТ_ВходящиеОстатки.Валюта КАК Валюта,
			|	ВТ_ВходящиеОстатки.Банк КАК Банк,
			|	ВТ_ВходящиеОстатки.Дата КАК Дата,
			|	ВТ_ВходящиеОстатки.Организация КАК Организация,
			|	ВТ_ВходящиеОстатки.ПулЛиквидности КАК ПулЛиквидности,
			|	ВТ_ВходящиеОстатки.ВидДенежныхСредств КАК ВидДенежныхСредств,
			|	ВТ_ВходящиеОстатки.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|	СУММА(ВТ_ВходящиеОстатки.ВходящийОстаток) КАК ВходящийОстаток
			|ПОМЕСТИТЬ ВТ_ВходящиеОстаткиПланированиеОднимДнем
			|ИЗ
			|	ВТ_ВходящиеОстатки КАК ВТ_ВходящиеОстатки
			|ГДЕ
			|	ВТ_ВходящиеОстатки.Дата < &НачалоПериодаОтбора
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ВходящиеОстатки.БанковскийСчетКасса,
			|	ВТ_ВходящиеОстатки.Валюта,
			|	ВТ_ВходящиеОстатки.Банк,
			|	ВТ_ВходящиеОстатки.Дата,
			|	ВТ_ВходящиеОстатки.Организация,
			|	ВТ_ВходящиеОстатки.ПулЛиквидности,
			|	ВТ_ВходящиеОстатки.ВидДенежныхСредств,
			|	ВТ_ВходящиеОстатки.СтатьяДвиженияДенежныхСредств
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ДанныеКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
			|	ВТ_ДанныеКалендаря.Валюта КАК Валюта,
			|	ВТ_ДанныеКалендаря.Банк КАК Банк,
			|	ВТ_ДанныеКалендаря.Дата КАК Дата,
			|	СУММА(ВТ_ДанныеКалендаря.ВходящийОстаток) КАК СуммаВВалютеОперации,
			|	СУММА(ВТ_ДанныеКалендаря.Поступление) КАК ПоступлениеВВалютеОперации,
			|	СУММА(ВТ_ДанныеКалендаря.Списание) КАК СписаниеВВалютеОперации,
			|	ВТ_ДанныеКалендаря.Организация КАК Организация,
			|	ВТ_ДанныеКалендаря.ПулЛиквидности КАК ПулЛиквидности,
			|	ВТ_ДанныеКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
			|	ВТ_ДанныеКалендаря.ЕстьПросрочки > 0 КАК ЕстьПросрочки,
			|	СУММА(ВТ_ДанныеКалендаря.ВходящийОстаток) КАК Сумма,
			|	СУММА(ВТ_ДанныеКалендаря.Поступление) КАК Поступление,
			|	СУММА(ВТ_ДанныеКалендаря.Списание) КАК Списание,
			|	СУММА(ВТ_ДанныеКалендаря.СуммаБезОвердрафта) КАК СуммаБезОвердрафта,
			|	СУММА(ВТ_ДанныеКалендаря.СуммаСМно) КАК СуммаСМно,
			|	ВТ_ДанныеКалендаря.ЭтоРабочийДень КАК ЭтоРабочийДень,
			|	ДЕНЬНЕДЕЛИ(ВТ_ДанныеКалендаря.Дата) КАК ДеньНедели,
			|	ВЫБОР
			|		КОГДА ДЕНЬНЕДЕЛИ(ВТ_ДанныеКалендаря.Дата) В (&ПлатежныеДниНедели)
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ПлатежныйДень,
			|	&ВТ_ДанныеКалендаряСчетЗакрыт КАК СчетЗакрыт,
			|	ВТ_ДанныеКалендаря.НаИсполнении КАК НаИсполнении,
			|	МАКСИМУМ(ЕСТЬNULL(ВТ_ВходящиеОстаткиПланированиеОднимДнем.ВходящийОстаток, 0)) КАК ВходящийОстаток,
			|	СУММА(ВТ_ДанныеКалендаря.ВходящийОстаток + ВТ_ДанныеКалендаря.Поступление + ВТ_ДанныеКалендаря.Списание) КАК ИсходящийОстаток,
			|	СУММА(ВТ_ДанныеКалендаря.СуммаПросрочки) КАК СуммаПросрочки,
			|	МАКСИМУМ(ВТ_ДанныеКалендаря.СтатьяДвиженияДенежныхСредств) КАК СтатьяДвиженияДенежныхСредств,
			|	ДополнительныеСведенияПлатежногоКалендаря.СреднийСрокОвердрафта КАК СреднийСрокОвердрафта,
			|	ДополнительныеСведенияПлатежногоКалендаря.ОвердрафтМНО КАК ОвердрафтМНО,
			|	ДополнительныеСведенияПлатежногоКалендаря.ГлубинаОвердрафта КАК ГлубинаОвердрафта,
			|	ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток КАК СреднедневнойОстаток
			|ИЗ
			|	ВТ_ДанныеКалендаря КАК ВТ_ДанныеКалендаря
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕстьДвиженияПоСчетам КАК ВТ_ЕстьДвиженияПоСчетам
			|		ПО ВТ_ДанныеКалендаря.БанковскийСчетКасса = ВТ_ЕстьДвиженияПоСчетам.БанковскийСчетКасса
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВходящиеОстаткиПланированиеОднимДнем КАК ВТ_ВходящиеОстаткиПланированиеОднимДнем
			|		ПО ВТ_ДанныеКалендаря.БанковскийСчетКасса = ВТ_ВходящиеОстаткиПланированиеОднимДнем.БанковскийСчетКасса
			|			И ВТ_ДанныеКалендаря.Валюта = ВТ_ВходящиеОстаткиПланированиеОднимДнем.Валюта
			|			И ВТ_ДанныеКалендаря.Банк = ВТ_ВходящиеОстаткиПланированиеОднимДнем.Банк
			|			И ВТ_ДанныеКалендаря.Организация = ВТ_ВходящиеОстаткиПланированиеОднимДнем.Организация
			|			И ВТ_ДанныеКалендаря.ПулЛиквидности = ВТ_ВходящиеОстаткиПланированиеОднимДнем.ПулЛиквидности
			|			И ВТ_ДанныеКалендаря.ВидДенежныхСредств = ВТ_ВходящиеОстаткиПланированиеОднимДнем.ВидДенежныхСредств
			|			И ВТ_ДанныеКалендаря.СтатьяДвиженияДенежныхСредств = ВТ_ВходящиеОстаткиПланированиеОднимДнем.СтатьяДвиженияДенежныхСредств
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведенияПлатежногоКалендаря КАК ДополнительныеСведенияПлатежногоКалендаря
			|		ПО ВТ_ДанныеКалендаря.БанковскийСчетКасса = ДополнительныеСведенияПлатежногоКалендаря.БанковскийСчет
			|			И (&ВерсияПлатежногоКалендаря = ДополнительныеСведенияПлатежногоКалендаря.ВерсияПлатежногоКалендаря)
			|			И (&Пользователь = ДополнительныеСведенияПлатежногоКалендаря.Пользователь)
			|ГДЕ
			|	(&ВТ_ДанныеКалендаряУсловиеСчетЗакрыт
			|			ИЛИ ВТ_ЕстьДвиженияПоСчетам.ЕстьДвижения)
			|	И ВТ_ДанныеКалендаря.Дата = &НачалоПериодаОтбора
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ДанныеКалендаря.БанковскийСчетКасса,
			|	ВТ_ДанныеКалендаря.Валюта,
			|	ВТ_ДанныеКалендаря.Банк,
			|	ВТ_ДанныеКалендаря.Дата,
			|	ВТ_ДанныеКалендаря.Организация,
			|	ВТ_ДанныеКалендаря.ПулЛиквидности,
			|	ВТ_ДанныеКалендаря.ВидДенежныхСредств,
			|	ВТ_ДанныеКалендаря.ЭтоРабочийДень,
			|	ВТ_ДанныеКалендаря.НаИсполнении,
			|	ДополнительныеСведенияПлатежногоКалендаря.СреднийСрокОвердрафта,
			|	ДополнительныеСведенияПлатежногоКалендаря.ОвердрафтМНО,
			|	ДополнительныеСведенияПлатежногоКалендаря.ГлубинаОвердрафта,
			|	ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток,
			|	ВТ_ДанныеКалендаря.ЕстьПросрочки > 0";
            		
		КонецЕсли;	
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ВТ_ДанныеКалендаряСчетЗакрыт",ТекстПоляСчетЗакрытДляЗапроса("ВТ_ДанныеКалендаря")); 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ВТ_ДанныеКалендаряУсловиеСчетЗакрыт",ТекстУсловияСчетЗакрытДляЗапроса("ВТ_ДанныеКалендаря")); 
	
	ДобавитьСтатьюДвиженияДенежныхСредствВЗапрос(ТекстЗапроса, Параметры);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ВТ_ДанныеКалендаряУсловиеСчетЗакрыт",ТекстУсловияСчетЗакрытДляЗапроса("ВТ_ДанныеКалендаря")); 
	
	Возврат ТекстЗапроса;

КонецФункции // ИтоговыйТекстЗапросаДляВариантаОтчета()      

Процедура ДобавитьСтатьюДвиженияДенежныхСредствВЗапрос(ТекстЗапроса, Параметры)
	
	Если Параметры.РежимВыводаОборотов = Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьПоСтатьямДДС Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_ДанныеКалендаря.ЭтоРабочийДень КАК ЭтоРабочийДень", "ВТ_ДанныеКалендаря.ЭтоРабочийДень КАК ЭтоРабочийДень,
																										|ВТ_ДанныеКалендаря.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств"); 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_ДанныеПодготовленные.ЭтоРабочийДень КАК ЭтоРабочийДень", "ВТ_ДанныеПодготовленные.ЭтоРабочийДень КАК ЭтоРабочийДень,
																										|ВТ_ДанныеПодготовленные.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств"); 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВТ_ДанныеКалендаря.ЭтоРабочийДень","ВТ_ДанныеКалендаря.ЭтоРабочийДень,
																					|ВТ_ДанныеКалендаря.СтатьяДвиженияДенежныхСредств");
	КонецЕсли;

КонецПроцедуры 

Функция ТекстЗапросаКурсовВалют()

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЗ_ПлановыеКурсы.Валюта КАК Справочник.Валюты) КАК Валюта,
		|	ВЫРАЗИТЬ(ТЗ_ПлановыеКурсы.Период КАК ДАТА) КАК Период,
		|	ВЫРАЗИТЬ(ТЗ_ПлановыеКурсы.Курс КАК ЧИСЛО(15, 4)) КАК Курс,
		|	ВЫРАЗИТЬ(ТЗ_ПлановыеКурсы.Кратность КАК ЧИСЛО(15, 0)) КАК Кратность
		|ПОМЕСТИТЬ ТЗ_ПлановыеКурсы
		|ИЗ
		|	&ТЗ_ПлановыеКурсы КАК ТЗ_ПлановыеКурсы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ДанныеКалендаря.Валюта КАК Валюта,
		|	ВТ_ДанныеКалендаря.Дата КАК ДатаКалендарь
		|ПОМЕСТИТЬ ВТ_Валюты
		|ИЗ
		|	ВТ_ДанныеКалендаря КАК ВТ_ДанныеКалендаря
		|ГДЕ
		|	НЕ ВТ_ДанныеКалендаря.Валюта ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалют.Период КАК Период,
		|	КурсыВалют.Валюта КАК Валюта,
		|	КурсыВалют.Курс КАК Курс,
		|	КурсыВалют.Кратность КАК Кратность
		|ПОМЕСТИТЬ ВТ_ДанныеКурсов
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Период МЕЖДУ &НачалоПериодаОтбора И &ОкончаниеПериодаОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ТЗ_ПлановыеКурсы.Период, ВТ_ДанныеКурсов.Период) КАК Период,
		|	ЕСТЬNULL(ТЗ_ПлановыеКурсы.Валюта, ВТ_ДанныеКурсов.Валюта) КАК Валюта,
		|	ЕСТЬNULL(ТЗ_ПлановыеКурсы.Курс, ВТ_ДанныеКурсов.Курс) КАК Курс,
		|	ЕСТЬNULL(ТЗ_ПлановыеКурсы.Кратность, ВТ_ДанныеКурсов.Кратность) КАК Кратность
		|ПОМЕСТИТЬ ВТ_АктуальныеКурсы
		|ИЗ
		|	ВТ_ДанныеКурсов КАК ВТ_ДанныеКурсов
		|		ПОЛНОЕ СОЕДИНЕНИЕ ТЗ_ПлановыеКурсы КАК ТЗ_ПлановыеКурсы
		|		ПО ВТ_ДанныеКурсов.Валюта = ТЗ_ПлановыеКурсы.Валюта
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КурсыВалютСрезПоследних.Период,
		|	КурсыВалютСрезПоследних.Валюта,
		|	КурсыВалютСрезПоследних.Курс,
		|	КурсыВалютСрезПоследних.Кратность
		|ИЗ
		|	РегистрСведений.КурсыВалют.СрезПоследних(ДОБАВИТЬКДАТЕ(&НачалоПериодаОтбора, ДЕНЬ, -1), ) КАК КурсыВалютСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыКурсов.Валюта КАК Валюта,
		|	ДатыКурсов.ДатаКалендарь КАК ДатаКалендарь,
		|	ВЫБОР
		|		КОГДА ДатыКурсов.Валюта = &ВалютаОтображения
		|			ТОГДА 1
		|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ВТ_АктуальныеКурсы.Курс * АктуальныйКурсВалютыОтображения.Кратность / (ВТ_АктуальныеКурсы.Кратность * АктуальныйКурсВалютыОтображения.Курс), 1) КАК ЧИСЛО(15, 8))
		|	КОНЕЦ КАК Коэффициент
		|ПОМЕСТИТЬ ВТ_СрезКурсов
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ВТ_Валюты.Валюта КАК Валюта,
		|		ВТ_Валюты.ДатаКалендарь КАК ДатаКалендарь,
		|		МАКСИМУМ(ВТ_АктуальныеКурсы.Период) КАК Период,
		|		МАКСИМУМ(АктуальныйКурсВалютыОтображения.Период) КАК ПериодОтображения
		|	ИЗ
		|		ВТ_Валюты КАК ВТ_Валюты
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АктуальныеКурсы КАК ВТ_АктуальныеКурсы
		|			ПО (ВТ_АктуальныеКурсы.Валюта = ВТ_Валюты.Валюта)
		|				И (ВТ_АктуальныеКурсы.Период <= ВТ_Валюты.ДатаКалендарь)
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АктуальныеКурсы КАК АктуальныйКурсВалютыОтображения
		|			ПО (АктуальныйКурсВалютыОтображения.Валюта = &ВалютаОтображения)
		|				И (АктуальныйКурсВалютыОтображения.Период <= ВТ_Валюты.ДатаКалендарь)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_Валюты.ДатаКалендарь,
		|		ВТ_Валюты.Валюта) КАК ДатыКурсов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АктуальныеКурсы КАК ВТ_АктуальныеКурсы
		|		ПО ДатыКурсов.Валюта = ВТ_АктуальныеКурсы.Валюта
		|			И ДатыКурсов.Период = ВТ_АктуальныеКурсы.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АктуальныеКурсы КАК АктуальныйКурсВалютыОтображения
		|		ПО (АктуальныйКурсВалютыОтображения.Валюта = &ВалютаОтображения)
		|			И ДатыКурсов.ПериодОтображения = АктуальныйКурсВалютыОтображения.Период";
	
	ТекстЗапроса = ТекстЗапроса+
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
	Возврат ТекстЗапроса;

КонецФункции // ТекстЗапросаПлановыхКурсов()

Функция ПериодичностьВЗапросе(Периодичность, ПериодПоУмолчанию) Экспорт
	
	СоответствиеПериодов = Новый Соответствие;
	СоответствиеПериодов.Вставить(Перечисления.Периодичность.Год, "ГОД");
	СоответствиеПериодов.Вставить(Перечисления.Периодичность.Полугодие, "ПОЛУГОДИЕ");
	СоответствиеПериодов.Вставить(Перечисления.Периодичность.Квартал, "КВАРТАЛ");
	СоответствиеПериодов.Вставить(Перечисления.Периодичность.Месяц, "МЕСЯЦ");
	СоответствиеПериодов.Вставить(Перечисления.Периодичность.Декада, "ДЕКАДА");
	СоответствиеПериодов.Вставить(Перечисления.Периодичность.Неделя, "НЕДЕЛЯ");
	СоответствиеПериодов.Вставить(Перечисления.Периодичность.День, "ДЕНЬ");
	
	ПериодВЗапросе = СоответствиеПериодов[Периодичность];
	Если ПериодВЗапросе = Неопределено Тогда
		ПериодВЗапросе = ПериодПоУмолчанию;
	КонецЕсли;
	
	Возврат ПериодВЗапросе;
	
КонецФункции	

