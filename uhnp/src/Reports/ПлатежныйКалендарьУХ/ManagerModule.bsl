Функция ПредставлениеРазделаПлатежногоКалендаря(РазделПлатежногоКалендаря) Экспорт
	
	ПредставлениеРаздела = "";	
	
	Если РазделПлатежногоКалендаря = Перечисления.РазделыПлатежногоКалендаря.СписаниеСредств Тогда
		ПредставлениеРаздела = НСтр("ru = 'К списанию'");	
