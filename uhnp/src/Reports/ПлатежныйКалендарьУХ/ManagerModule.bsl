#Область ПрограммныйИнтерфейс

Функция СтруктураИнструмента() Экспорт

	Результат = Новый Структура;
	
	Результат.Вставить("Активна");
	Результат.Вставить("ИдентификаторОперации");
	Результат.Вставить("ВидОперации");
	Результат.Вставить("УточнениеОперации");
	Результат.Вставить("ПредставлениеОперации");
	Результат.Вставить("ОрганизацияСписания");
	Результат.Вставить("ОрганизацияЗачисления");
	Результат.Вставить("БанкСписания");
	Результат.Вставить("БанкЗачисления");
	Результат.Вставить("БанковскийСчетКассаСписания");
	Результат.Вставить("БанковскийСчетКассаЗачисления");
	Результат.Вставить("ВалютаСписания");
	Результат.Вставить("ВалютаЗачисления");
	Результат.Вставить("ДатаСписания");
	Результат.Вставить("ДатаЗачисления");
	Результат.Вставить("ДатаВыплатыПроцентов");

	Результат.Вставить("Оптимизация", Ложь);
	
	Возврат Результат;
	
КонецФункции // СтруктураИнструмента()

// Возвращает таблицу значений по текущему отчету для передачи в СКД.
Функция ПолучитьДанныеДляФормированияОтчета(ПараметрыОтчетаВход) Экспорт
	
	// Инициализация.
	ПустаяВерсия = Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка();
	ПустаяВалюта = Справочники.Валюты.ПустаяСсылка();
	// Получение параметров.
	ПериодОтбораРабочий							 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "ПериодОтбора", Новый СтандартныйПериод);
	СохраненнаяВерсияПлатежногоКалендаряРабочая	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "СохраненнаяВерсияПлатежногоКалендаря", ПустаяВерсия);
	ВалютаОтображенияРабочая					 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "ВалютаОтображения", ПустаяВалюта);
	ПлановыеКурсыРабочая						 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "ПлановыеКурсы", Новый ТаблицаЗначений);
	ВыводитьОстаткиСУчетомОвердрафтовРабочий	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "ВыводитьОстаткиСУчетомОвердрафтов", Ложь);
	МатрицаВесовЛиквидности						 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "МатрицаВесовЛиквидности", Новый ТаблицаЗначений);
	ДатаНачалаПериода		 = ПериодОтбораРабочий.ДатаНачала;
	ДатаОкончанияПериода	 = ПериодОтбораРабочий.ДатаОкончания;
	ГоризонтОперативногоПланирования = ПараметрыОтчетаВход.ГоризонтОперативногоПланирования;
	ГоризонтДолгосрочногоПланирования = ПараметрыОтчетаВход.ГоризонтДолгосрочногоПланирования;
	ВыводитьДанныеВВалютеОтображения = ПараметрыОтчетаВход.ВыводитьДанныеВВалютеОтображения;
	ГоризонтТактическогоПланирования = ПараметрыОтчетаВход.ГоризонтТактическогоПланирования;
	ВариантПлатежногоКалендаря		 = ПараметрыОтчетаВход.ВариантПлатежногоКалендаря;
	ПериодичностьОперативногоПланирования = ПараметрыОтчетаВход.ПериодичностьОперативногоПланирования;
	ИсточникВходящихОстатков = ПараметрыОтчетаВход.ИсточникВходящихОстатков;
	ВыводитьТолькоКассовыеРазрывы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "ВыводитьТолькоКассовыеРазрывы", Ложь);
	ЭтоОборотыПоДДС = ЭтоОборотыПоДДС(ПараметрыОтчетаВход.РежимВыводаОборотов, ВариантПлатежногоКалендаря);
	ПараметрыОтчетаВход.Вставить("ПорогНекритичногоНедостатка",Константы.ПорогНекритичногоНедостатка.Получить());
	ПараметрыОтчетаВход.Вставить("ПорогНормыОстатка",Константы.ПорогНормыОстатка.Получить());
	ПараметрыОтчетаВход.Вставить("ПорогКритичногоИзлишка",Константы.ПорогКритичногоИзлишка.Получить());
	// Выполнение запроса и вывод результата.
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПустойБанковскийСчет", 				ДенежныеСредстваВстраиваниеУХКлиентСервер.ПолучитьПустойБанковскийСчет());
	Запрос.УстановитьПараметр("ВерсияПлатежногоКалендаря", 			СохраненнаяВерсияПлатежногоКалендаряРабочая);
	Запрос.УстановитьПараметр("ГоризонтОперативногоПланирования", 	ГоризонтОперативногоПланирования);
	Запрос.УстановитьПараметр("ГоризонтДолгосрочногоПланирования", 	ГоризонтДолгосрочногоПланирования);
	Запрос.УстановитьПараметр("ГоризонтТактическогоПланирования", 	ГоризонтТактическогоПланирования);
	Запрос.УстановитьПараметр("НачалоПериодаОтбора", 				ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериодаОтбора", 			ДатаОкончанияПериода);
	Запрос.УстановитьПараметр("Пользователь", 						ПользователиКлиентСервер.ТекущийПользователь());
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь", 			ПараметрыОтчетаВход.ПроизводственныйКалендарь);
	Запрос.УстановитьПараметр("ВалютаОтображения", 					ВалютаОтображенияРабочая);
	Запрос.УстановитьПараметр("ТЗ_ПлановыеКурсы", 					ПлановыеКурсыРабочая);
	Запрос.УстановитьПараметр("УчитыватьОвердрафты", 				ПараметрыОтчетаВход.ВыводитьОстаткиСУчетомОвердрафтов);
	Запрос.УстановитьПараметр("МатрицаВесовЛиквидности", 			ПараметрыОтчетаВход.МатрицаВесовЛиквидности);
	Запрос.УстановитьПараметр("ПлатежныеДниНедели",					ПлатежныеДниНедели());
	Запрос.УстановитьПараметр("ДатаОперативныхОстатков", 			ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ИсточникВходящихОстатков", 			ИсточникВходящихОстатков);
	Запрос.УстановитьПараметр("ПорогНекритичногоНедостатка", 		ПараметрыОтчетаВход.ПорогНекритичногоНедостатка);
	Запрос.УстановитьПараметр("ПорогНормыОстатка", 					ПараметрыОтчетаВход.ПорогНормыОстатка);
	Запрос.УстановитьПараметр("ПорогКритичногоИзлишка", 			ПараметрыОтчетаВход.ПорогКритичногоИзлишка);
	Запрос.УстановитьПараметр("ЭтоОборотыПоДДС", 					ЭтоОборотыПоДДС);
	
	ДанныеДляФормированияОтчета = Новый Структура;
	
	ПроверитьВозможностьФормированияОтчета(ПараметрыОтчетаВход,ДанныеДляФормированияОтчета);
	
	Если Не ДанныеДляФормированияОтчета.МожноСформироватьОтчет Тогда
		Возврат ДанныеДляФормированияОтчета;
	КонецЕсли;
	
	ПараметрыГенерацииЗапроса = ПараметрыГенерацииЗапросаОстаткиИОбороты();
	ПараметрыГенерацииЗапроса.ВыводитьТолькоКассовыеРазрывы = ВыводитьТолькоКассовыеРазрывы;
	ПараметрыГенерацииЗапроса.ПериодичностьОперативногоПланирования = ПериодичностьОперативногоПланирования;
	ПараметрыГенерацииЗапроса.ВыводитьВВалютеОтображения = ВыводитьДанныеВВалютеОтображения;
	ПараметрыГенерацииЗапроса.ВариантПлатежногоКалендаря = ВариантПлатежногоКалендаря;
	ПараметрыГенерацииЗапроса.РежимВыводаОборотов = ПараметрыОтчетаВход.РежимВыводаОборотов;
	
	Запрос.Текст = ПолучитьТекстЗапросаОстаткиИОбороты(ПараметрыГенерацииЗапроса);
	ТаблицаОстатковИОборотов = Запрос.Выполнить().Выгрузить();
	
	ДанныеДляФормированияОтчета.Вставить("ТаблицаОстатковИОборотов", ТаблицаОстатковИОборотов);
	
	Возврат ДанныеДляФормированияОтчета;    
	                                                       
КонецФункции

Функция ПолучитьДанныеБанковскогоСчетаКассы(БанковскийСчетКасса) Экспорт
	
	ДанныеБанковскогоСчетаКассы = Новый Структура;
	
	Если ТипЗнч(БанковскийСчетКасса) = ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций() Тогда
		
		ДанныеБанковскогоСчетаКассы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БанковскийСчетКасса,Новый Структура("Организация,Валюта,ПулЛиквидности,Банк,","Владелец","ВалютаДенежныхСредств"));
		
		ДанныеБанковскогоСчетаКассы.Вставить("БанковскийСчетКасса",	БанковскийСчетКасса);
		ДанныеБанковскогоСчетаКассы.Вставить("ВидДенежныхСредств",	Перечисления.ФормыОплаты.Безналичная);
		
	ИначеЕсли ТипЗнч(БанковскийСчетКасса) = Тип("СправочникСсылка.Кассы") Тогда	
		
		ДанныеБанковскогоСчетаКассы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БанковскийСчетКасса,Новый Структура("Организация,Валюта","Владелец","ВалютаДенежныхСредств"));
		
		ДанныеБанковскогоСчетаКассы.Вставить("БанковскийСчетКасса",БанковскийСчетКасса);
		ДанныеБанковскогоСчетаКассы.Вставить("ВидДенежныхСредств",Перечисления.ФормыОплаты.Наличная);
		ДанныеБанковскогоСчетаКассы.Вставить("Банк",Справочники.КлассификаторБанков.ПустаяСсылка());
		ДанныеБанковскогоСчетаКассы.Вставить("ПулЛиквидности",Справочники.ПулыЛиквидности.ПустаяСсылка());
		
	КонецЕсли;
	
	Возврат ДанныеБанковскогоСчетаКассы;

КонецФункции // ПолучитьДанныеБанковскогоСчетаКассы()

Процедура ОчиститьСлужебныеРегистры(Параметры) Экспорт  
	
	НаборЗаписей = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВерсияПлатежногоКалендаря.Установить(Параметры.СохраненнаяВерсияПлатежногоКалендаря);
	НаборЗаписей.Отбор.Пользователь.Установить(Параметры.Пользователь);
	НаборЗаписей.Записать();  
	
	НаборЗаписей = РегистрыСведений.ДополнительныеСведенияПлатежногоКалендаря.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВерсияПлатежногоКалендаря.Установить(Параметры.СохраненнаяВерсияПлатежногоКалендаря);
	НаборЗаписей.Отбор.Пользователь.Установить(Параметры.Пользователь);
	НаборЗаписей.Записать();  

КонецПроцедуры   

Процедура ПоднятьДанныеПлатежногоКалендаря(ПараметрыОтчета, СохранитьОперации = Ложь) Экспорт  
	
	ОтчетОбъект = Отчеты.ПлатежныйКалендарьУХ.Создать();  
	ЗаполнитьЗначенияСвойств(ОтчетОбъект, ПараметрыОтчета);
	
	ОтчетОбъект.ПоднятьДанныеПлатежногоКалендаря(СохранитьОперации);	 

КонецПроцедуры   

Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	МодульВариантыОтчетов = ОбщегоНазначения.ОбщийМодуль("ВариантыОтчетов");
	
	НастройкиВарианта = МодульВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ПерспективноеПланирование");
	НастройкиВарианта.Включен = Ложь;
	
	НастройкиВарианта = МодульВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ПерспективноеПланированиеОбороты");
	НастройкиВарианта.Включен = Ложь;
	
	НастройкиВарианта = МодульВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ПланированиеОднимДнем");
	НастройкиВарианта.Включен = Ложь;
	
	НастройкиВарианта = МодульВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ОборотыПоСтатьямДДС");
	НастройкиВарианта.Описание = НСтр("ru = 'Платежный календарь (Обороты по статьям ДДС)'");
	НастройкиВарианта.Включен = Истина;		

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СобратьПредставлениеДоговора(ВидДоговора, СуммаДоговора, Валюта, ПроцентнаяСтавка) Экспорт
	
	Возврат ВидДоговора + " "+СуммаДоговора+" "+Валюта +" "+ПроцентнаяСтавка+"%";
	
КонецФункции

Функция ЭтоОборотыПоДДС(РежимВыводаОборотов, ВариантПлатежногоКалендаря) Экспорт

	Возврат РежимВыводаОборотов = Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьПоСтатьямДДС 
			И ВариантПлатежногоКалендаря = Перечисления.ВариантыПлатежногоКалендаря.ПерспективноеПланирование;

КонецФункции 

Процедура ПроверитьВозможностьФормированияОтчета(ПараметрыОтчетаВход,ДанныеДляФормированияОтчета)

	ДанныеДляФормированияОтчета.Вставить("МожноСформироватьОтчет",Истина);
	ДанныеДляФормированияОтчета.Вставить("ТекстОшибки","");
	
	ПериодОтбораРабочий		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "ПериодОтбора", Новый СтандартныйПериод);
	ДатаНачалаПериода		 = ПериодОтбораРабочий.ДатаНачала;
	
	Если ЗначениеЗаполнено(ПараметрыОтчетаВход.ИсточникСобытияФормированияОтчета) Тогда
		
		Если  ПараметрыОтчетаВход.ИсточникСобытияФормированияОтчета = "ИзменениеИсточникаВходящихОстатков" Тогда
			
			Если ПараметрыОтчетаВход.ИсточникВходящихОстатков = "ПоОперативнымДанным" Тогда
				
				Если Не ЕстьОперативныеОстаткиНаДату(ПараметрыОтчетаВход) Тогда
					
					ДанныеДляФормированияОтчета.МожноСформироватьОтчет = Ложь;
					ДанныеДляФормированияОтчета.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не найдены оперативные остатки на дату %1'"),Формат(ДатаНачалаПериода,"ДФ=dd.MM.yyyy"));
					
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;   
	
КонецПроцедуры

Функция ЕстьОперативныеОстаткиНаДату(ПараметрыОтчетаВход)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрСведений.ОстаткиНаБанковскихСчетахПоДаннымВыписок.СрезПоследних(&ДатаОперативныхОстатков, ) КАК ОстаткиНаБанковскихСчетахПоДаннымВыписокСрезПоследних
	|ГДЕ
	|	&ИсточникВходящихОстатков = ""ПоОперативнымДанным""";	
	
	ПериодОтбораРабочий		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчетаВход, "ПериодОтбора", Новый СтандартныйПериод);

	Запрос.УстановитьПараметр("ИсточникВходящихОстатков",ПараметрыОтчетаВход.ИсточникВходящихОстатков);
	Запрос.УстановитьПараметр("ДатаОперативныхОстатков",ПериодОтбораРабочий.ДатаНачала);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();

КонецФункции // ЕстьОперативныеОстаткиНаДату()

Функция ТекстУсловияСчетЗакрытДляЗапроса(ИмяТаблицы = "ПредставлениеПлатежногоКалендаря" ) Экспорт

	ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса = ДенежныеСредстваВстраиваниеУХКлиентСервер.ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса();
	
	ТекстУсловия = 
	"ВЫБОР
	|	КОГДА "+ИмяТаблицы+".БанковскийСчетКасса ССЫЛКА "+ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса+"
	|		ТОГДА НЕ ЕСТЬNULL(ВЫРАЗИТЬ("+ИмяТаблицы+".БанковскийСчетКасса КАК "+ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса+").Закрыт, ЛОЖЬ)
	|	ИНАЧЕ ИСТИНА
	|КОНЕЦ";
	
	Возврат ТекстУсловия;
	
КонецФункции // ПолучитьТекстУсловияСчетЗакрыт()

Функция ОписаниеТипаБанковскиеСчетаКассы() Экспорт
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций());
	МассивТипов.Добавить(Тип("СправочникСсылка.Кассы"));
	
	ТипБанковскийСчетКасса = Новый ОписаниеТипов(МассивТипов);

	Возврат ТипБанковскийСчетКасса;
	
КонецФункции

Функция ТекстПоляСчетЗакрытДляЗапроса(ИмяТаблицы = "ПредставлениеПлатежногоКалендаря") Экспорт

	ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса = ДенежныеСредстваВстраиваниеУХКлиентСервер.ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса();
	
	ТекстПоля =
	"ВЫБОР
	|	КОГДА "+ИмяТаблицы+".БанковскийСчетКасса ССЫЛКА "+ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса+"
	|		ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ("+ИмяТаблицы+".БанковскийСчетКасса КАК "+ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса+").Закрыт, ЛОЖЬ)
	|	ИНАЧЕ ЛОЖЬ
	|КОНЕЦ";

	Возврат ТекстПоля;
	
КонецФункции

Функция ТекстУсловияСоединенияПоБанковскомуСчетуДляЗапроса(ИмяТаблицы) Экспорт
	
	ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса = ДенежныеСредстваВстраиваниеУХКлиентСервер.ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса();
	
	ТекстУсловияСоединения = "(ВЫРАЗИТЬ("+ИмяТаблицы+".БанковскийСчетКасса КАК "+ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса+"))";
	
	Возврат ТекстУсловияСоединения;
	
КонецФункции

Функция ПараметрыГенерацииЗапросаОстаткиИОбороты()
	
	ПараметрыГенерацииЗапроса = Новый Структура;
	ПараметрыГенерацииЗапроса.Вставить("ВыводитьВВалютеОтображения", Истина);
	ПараметрыГенерацииЗапроса.Вставить("ПериодичностьОперативногоПланирования", Неопределено);
	ПараметрыГенерацииЗапроса.Вставить("ВыводитьТолькоКассовыеРазрывы", Ложь);
	ПараметрыГенерацииЗапроса.Вставить("ВариантПлатежногоКалендаря");
	ПараметрыГенерацииЗапроса.Вставить("ВыводитьОбороты");
	ПараметрыГенерацииЗапроса.Вставить("РежимВыводаОборотов");
	
	Возврат ПараметрыГенерацииЗапроса;
	
КонецФункции

// Возвращает текст запроса для основной компоновки отчета.
//
// Параметры:
//  Параметры	 - Структура см. Отчет.ПлатежныйКалендарьУХ.ПараметрыГенерацииЗапросаОстаткиИОбороты() - параметры генерации запроса
// 
// Возвращаемое значение:
//   - Строка - Текст запроса
//
Функция ПолучитьТекстЗапросаОстаткиИОбороты(Параметры)
		
	МассивПодзапросы = Новый Массив;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МатрицаВесовЛиквидности.Источник КАК Источник,
	|	МатрицаВесовЛиквидности.ПриходРасход КАК ПриходРасход,
	|	МатрицаВесовЛиквидности.ГоризонтПланированияЛиквидности КАК ГоризонтПланированияЛиквидности,
	|	МатрицаВесовЛиквидности.Вес КАК Вес
	|ПОМЕСТИТЬ ВТ_МатрицаВесовЛиквидности
	|ИЗ
	|	&МатрицаВесовЛиквидности КАК МатрицаВесовЛиквидности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика КАК ПредметГрафика,
	|	ВерсииРасчетовСрезПоследних.Организация КАК Организация,
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика.ДатаПервогоТранша КАК ДатаНачала,
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика.ДатаПоследнегоПлатежа КАК СрокДействия,
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика.СуммаТраншей КАК Стоимость,
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика.БанковскийСчет КАК СчетОрганизации,
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика.ВидДоговораУХ = ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.Овердрафт) КАК ЭтоОвердрафт,
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика.ВидДоговораУХ = ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.МинимальныйНеснижаемыйОстаток) КАК ЭтоМНО
	|ПОМЕСТИТЬ ВТ_ОвердрафтыИМНО
	|ИЗ
	|	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних КАК ВерсииРасчетовСрезПоследних
	|ГДЕ
	|	ВерсииРасчетовСрезПоследних.ПредметГрафика.ВидДоговораУХ В (ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.Овердрафт), ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.МинимальныйНеснижаемыйОстаток))
	|	И ВерсииРасчетовСрезПоследних.ПредметГрафика ССЫЛКА Справочник.ДоговорыКредитовИДепозитов
	|	И ВерсииРасчетовСрезПоследних.ПредметГрафика.БанковскийСчет <> &ПустойБанковскийСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВходныеДанныеНесгруппированные.Организация КАК Организация,
	|	ВходныеДанныеНесгруппированные.ПулЛиквидности КАК ПулЛиквидности,
	|	ВходныеДанныеНесгруппированные.Валюта КАК Валюта,
	|	ВходныеДанныеНесгруппированные.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ВходныеДанныеНесгруппированные.Банк КАК Банк,
	|	ВходныеДанныеНесгруппированные.ДатаПредставление КАК ДатаПредставление,
	|	СУММА(ВходныеДанныеНесгруппированные.Поступление) КАК Поступление,
	|	-СУММА(ВходныеДанныеНесгруппированные.Списание) КАК Списание,
	|	СУММА(ВходныеДанныеНесгруппированные.ЕстьПросрочки) КАК ЕстьПросрочки,
	|	СУММА(ВходныеДанныеНесгруппированные.СуммаБезОвердрафта) КАК СуммаБезОвердрафта,
	|	СУММА(ВходныеДанныеНесгруппированные.СуммаСМно) КАК СуммаСМно,
	|	ВходныеДанныеНесгруппированные.ВидДенежныхСредств КАК ВидДенежныхСредств,
	|	СУММА(ВходныеДанныеНесгруппированные.НаИсполнении) КАК НаИсполнении,
	|	СУММА(ВходныеДанныеНесгруппированные.СуммаПросрочки) КАК СуммаПросрочки,
	|	ВходныеДанныеНесгруппированные.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|ПОМЕСТИТЬ ВТ_ВходныеДанные
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
	|		ПредставлениеПлатежногоКалендаря.ПулЛиквидности КАК ПулЛиквидности,
	|		ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
	|		ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|		ПредставлениеПлатежногоКалендаря.Банк КАК Банк,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Дата < &НачалоПериодаОтбора
	|				ТОГДА ДОБАВИТЬКДАТЕ(&НачалоПериодаОтбора, ДЕНЬ, -1)
	|			КОГДА ПредставлениеПлатежногоКалендаря.Дата > &ГоризонтТактическогоПланирования
	|				ТОГДА НАЧАЛОПЕРИОДА(ПредставлениеПлатежногоКалендаря.Дата, МЕСЯЦ)
	|			КОГДА ПредставлениеПлатежногоКалендаря.Дата > &ГоризонтОперативногоПланирования
	|				ТОГДА ДОБАВИТЬКДАТЕ(&ГоризонтОперативногоПланирования, ДЕНЬ, 1)
	|			ИНАЧЕ ПредставлениеПлатежногоКалендаря.Дата
	|		КОНЕЦ КАК ДатаПредставление,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|				ТОГДА ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Поступление,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма < 0
	|				ТОГДА -ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Списание,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря <> ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.ВходящийОстаток)
	|						И ПредставлениеПлатежногоКалендаря.Дата < &НачалоПериодаОтбора
	|					ИЛИ ПредставлениеПлатежногоКалендаря.КрайняяДата <> ДАТАВРЕМЯ(1, 1, 1)
	|						И ПредставлениеПлатежногоКалендаря.Дата > ПредставлениеПлатежногоКалендаря.КрайняяДата
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ЕстьПросрочки,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|				ТОГДА ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|			ИНАЧЕ -ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|		КОНЕЦ КАК СуммаБезОвердрафта,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|				ТОГДА ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|			ИНАЧЕ -ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|		КОНЕЦ КАК СуммаСМно,
	|		ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|				ТОГДА ВЫБОР
	|						КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|							ТОГДА ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|						ИНАЧЕ -ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НаИсполнении,
	|		ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря <> ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.ВходящийОстаток)
	|						И ПредставлениеПлатежногоКалендаря.Дата < &НачалоПериодаОтбора
	|					ИЛИ ПредставлениеПлатежногоКалендаря.КрайняяДата <> ДАТАВРЕМЯ(1, 1, 1)
	|						И ПредставлениеПлатежногоКалендаря.Дата > ПредставлениеПлатежногоКалендаря.КрайняяДата
	|				ТОГДА ВЫБОР
	|						КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|							ТОГДА ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|						ИНАЧЕ -ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СуммаПросрочки,
	|		ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|	ИЗ
	|		РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МатрицаВесовЛиквидности КАК ВТ_МатрицаВесовЛиквидности
	|			ПО ПредставлениеПлатежногоКалендаря.ИсточникДанных = ВТ_МатрицаВесовЛиквидности.Источник
	|				И (ВЫБОР
	|					КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|				КОНЕЦ = ВТ_МатрицаВесовЛиквидности.ПриходРасход)
	|				И (ВЫБОР
	|					КОГДА ПредставлениеПлатежногоКалендаря.Дата > &ГоризонтТактическогоПланирования
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ГоризонтыПланированияЛиквидности.ПерспективноеПланирование)
	|					КОГДА ПредставлениеПлатежногоКалендаря.Дата > &ГоризонтОперативногоПланирования
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ГоризонтыПланированияЛиквидности.ТактическоеПланирование)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ГоризонтыПланированияЛиквидности.ОперативноеПланирование)
	|				КОНЕЦ = ВТ_МатрицаВесовЛиквидности.ГоризонтПланированияЛиквидности)
	|	ГДЕ
	|		ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 1) <> 0
	|		И ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь
	|		И ПредставлениеПлатежногоКалендаря.Активна
	|		И ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = &ВерсияПлатежногоКалендаря
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_ОвердрафтыИМНО.Организация,
	|		ВТ_ОвердрафтыИМНО.СчетОрганизации.ПулЛиквидности,
	|		ВТ_ОвердрафтыИМНО.СчетОрганизации.ВалютаДенежныхСредств,
	|		ВТ_ОвердрафтыИМНО.СчетОрганизации,
	|		ВТ_ОвердрафтыИМНО.СчетОрганизации.Банк,
	|		ВЫБОР
	|			КОГДА ВТ_ОвердрафтыИМНО.ДатаНачала > &ГоризонтТактическогоПланирования
	|				ТОГДА НАЧАЛОПЕРИОДА(ВТ_ОвердрафтыИМНО.ДатаНачала, МЕСЯЦ)
	|			КОГДА ВТ_ОвердрафтыИМНО.ДатаНачала > &ГоризонтОперативногоПланирования
	|				ТОГДА ДОБАВИТЬКДАТЕ(&ГоризонтОперативногоПланирования, ДЕНЬ, 1)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВТ_ОвердрафтыИМНО.ДатаНачала < &НачалоПериодаОтбора
	|						ТОГДА ДОБАВИТЬКДАТЕ(&НачалоПериодаОтбора, ДЕНЬ, -1)
	|					ИНАЧЕ ВТ_ОвердрафтыИМНО.ДатаНачала
	|				КОНЕЦ
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &УчитыватьОвердрафты
	|					И ВТ_ОвердрафтыИМНО.ЭтоОвердрафт
	|				ТОГДА ВТ_ОвердрафтыИМНО.Стоимость
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &УчитыватьОвердрафты
	|					И ВТ_ОвердрафтыИМНО.ЭтоМНО
	|				ТОГДА ВТ_ОвердрафтыИМНО.Стоимость
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		0,
	|		0,
	|		ВЫБОР
	|			КОГДА ВТ_ОвердрафтыИМНО.ЭтоМНО
	|				ТОГДА -ВТ_ОвердрафтыИМНО.Стоимость
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная),
	|		0,
	|		0,
