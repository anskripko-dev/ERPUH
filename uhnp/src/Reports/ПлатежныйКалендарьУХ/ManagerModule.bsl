	|	ВТ_ОборотыСгруппированные КАК ВТ_ОборотыСгруппированные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОборотыСгруппированные КАК ВходящиеОстатки
	|		ПО ВТ_ОборотыСгруппированные.Организация = ВходящиеОстатки.Организация
	|			И ВТ_ОборотыСгруппированные.ПулЛиквидности = ВходящиеОстатки.ПулЛиквидности
	|			И ВТ_ОборотыСгруппированные.Валюта = ВходящиеОстатки.Валюта
	|			И ВТ_ОборотыСгруппированные.БанковскийСчетКасса = ВходящиеОстатки.БанковскийСчетКасса
	|			И ВТ_ОборотыСгруппированные.Банк = ВходящиеОстатки.Банк
	|			И ВТ_ОборотыСгруппированные.Дата > ВходящиеОстатки.Дата
	|			И ВТ_ОборотыСгруппированные.ВидДенежныхСредств = ВходящиеОстатки.ВидДенежныхСредств
	|			И ВТ_ОборотыСгруппированные.СтатьяДвиженияДенежныхСредств = ВходящиеОстатки.СтатьяДвиженияДенежныхСредств
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОборотыСгруппированные.Дата,
	|	ВТ_ОборотыСгруппированные.ЭтоРабочийДень,
	|	ВТ_ОборотыСгруппированные.Организация,
	|	ВТ_ОборотыСгруппированные.ПулЛиквидности,
	|	ВТ_ОборотыСгруппированные.Валюта,
	|	ВТ_ОборотыСгруппированные.БанковскийСчетКасса,
	|	ВТ_ОборотыСгруппированные.Банк,
	|	ВТ_ОборотыСгруппированные.ВидДенежныхСредств,
	|	ВТ_ОборотыСгруппированные.СтатьяДвиженияДенежныхСредств
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОборотыСгруппированные.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ВТ_ОборотыСгруппированные.Валюта КАК Валюта,
	|	ВТ_ОборотыСгруппированные.Банк КАК Банк,
	|	ВТ_ОборотыСгруппированные.Дата КАК Дата,
	|	ВТ_ОборотыСгруппированные.ЭтоРабочийДень КАК ЭтоРабочийДень,
	|	ВТ_ОборотыСгруппированные.Организация КАК Организация,
	|	ВТ_ОборотыСгруппированные.ПулЛиквидности КАК ПулЛиквидности,
	|	ВЫБОР
	|		КОГДА ВТ_ОборотыСгруппированные.Дата < &НачалоПериодаОтбора
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_ОборотыСгруппированные.Поступление
	|	КОНЕЦ КАК Поступление,
	|	ВЫБОР
	|		КОГДА ВТ_ОборотыСгруппированные.Дата < &НачалоПериодаОтбора
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_ОборотыСгруппированные.Списание
	|	КОНЕЦ КАК Списание,
	|	ВТ_ОборотыСгруппированные.ЕстьПросрочки КАК ЕстьПросрочки,
	|	ЕСТЬNULL(СУММА(ВТ_ВходящиеОстатки.ВходящийОстаток), 0) КАК ВходящийОстаток,
	|	ЕСТЬNULL(СУММА(ВТ_ИсходящиеОстатки.ИсходящийОстаток), 0) КАК ИсходящийОстаток,
	|	ЕСТЬNULL(СУММА(ВТ_ОборотыСгруппированные.СуммаБезОвердрафта), 0) КАК СуммаБезОвердрафта,
	|	ЕСТЬNULL(СУММА(ВТ_ОборотыСгруппированные.СуммаСМно), 0) КАК СуммаСМно,
	|	ВТ_ОборотыСгруппированные.ВидДенежныхСредств КАК ВидДенежныхСредств,
	|	ЕСТЬNULL(СУММА(ВТ_ОборотыСгруппированные.НаИсполнении), 0) КАК НаИсполнении,
	|	ЕСТЬNULL(СУММА(ВТ_ОборотыСгруппированные.СуммаПросрочки), 0) КАК СуммаПросрочки,
	|	ВТ_ОборотыСгруппированные.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|ПОМЕСТИТЬ ВТ_ДанныеКалендаря
	|ИЗ
	|	ВТ_ОборотыСгруппированные КАК ВТ_ОборотыСгруппированные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВходящиеОстатки КАК ВТ_ВходящиеОстатки
	|		ПО ВТ_ОборотыСгруппированные.БанковскийСчетКасса = ВТ_ВходящиеОстатки.БанковскийСчетКасса
	|			И ВТ_ОборотыСгруппированные.Валюта = ВТ_ВходящиеОстатки.Валюта
	|			И ВТ_ОборотыСгруппированные.Организация = ВТ_ВходящиеОстатки.Организация
	|			И ВТ_ОборотыСгруппированные.Банк = ВТ_ВходящиеОстатки.Банк
	|			И ВТ_ОборотыСгруппированные.ПулЛиквидности = ВТ_ВходящиеОстатки.ПулЛиквидности
	|			И ВТ_ОборотыСгруппированные.Дата = ВТ_ВходящиеОстатки.Дата
	|			И ВТ_ОборотыСгруппированные.ВидДенежныхСредств = ВТ_ВходящиеОстатки.ВидДенежныхСредств
	|			И ВТ_ОборотыСгруппированные.СтатьяДвиженияДенежныхСредств = ВТ_ВходящиеОстатки.СтатьяДвиженияДенежныхСредств
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсходящиеОстатки КАК ВТ_ИсходящиеОстатки
	|		ПО ВТ_ОборотыСгруппированные.БанковскийСчетКасса = ВТ_ИсходящиеОстатки.БанковскийСчетКасса
	|			И ВТ_ОборотыСгруппированные.Валюта = ВТ_ИсходящиеОстатки.Валюта
	|			И ВТ_ОборотыСгруппированные.Организация = ВТ_ИсходящиеОстатки.Организация
	|			И ВТ_ОборотыСгруппированные.Банк = ВТ_ИсходящиеОстатки.Банк
	|			И ВТ_ОборотыСгруппированные.ПулЛиквидности = ВТ_ИсходящиеОстатки.ПулЛиквидности
	|			И ВТ_ОборотыСгруппированные.Дата = ВТ_ИсходящиеОстатки.Дата
	|			И ВТ_ОборотыСгруппированные.ВидДенежныхСредств = ВТ_ИсходящиеОстатки.ВидДенежныхСредств
	|			И ВТ_ОборотыСгруппированные.СтатьяДвиженияДенежныхСредств = ВТ_ИсходящиеОстатки.СтатьяДвиженияДенежныхСредств
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОборотыСгруппированные.БанковскийСчетКасса,
	|	ВТ_ОборотыСгруппированные.Валюта,
	|	ВТ_ОборотыСгруппированные.Банк,
	|	ВТ_ОборотыСгруппированные.Дата,
	|	ВТ_ОборотыСгруппированные.Организация,
	|	ВТ_ОборотыСгруппированные.ПулЛиквидности,
	|	ВТ_ОборотыСгруппированные.ЭтоРабочийДень,
	|	ВТ_ОборотыСгруппированные.Поступление,
	|	ВТ_ОборотыСгруппированные.Списание,
	|	ВТ_ОборотыСгруппированные.ЕстьПросрочки,
	|	ВТ_ОборотыСгруппированные.ВидДенежныхСредств,
	|	ВТ_ОборотыСгруппированные.СтатьяДвиженияДенежныхСредств
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма <> 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьДвижения
	|ПОМЕСТИТЬ ВТ_ЕстьДвиженияПоСчетам
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь
	|	И ПредставлениеПлатежногоКалендаря.Активна
	|	И ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = &ВерсияПлатежногоКалендаря
	|
	|СГРУППИРОВАТЬ ПО
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	БанковскийСчетКасса";
	
	МассивПодзапросы.Добавить(ТекстЗапроса);

	ТекстЗапроса = ИтоговыйТекстЗапросаПоВариантуОтчета(Параметры);

	МассивПодзапросы.Добавить(ТекстЗапроса);

	ТекстЗапроса = СтрСоединить(МассивПодзапросы, ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета());
	
	СтрПериодичность = ПериодичностьВЗапросе(Параметры.ПериодичностьОперативногоПланирования, "МЕСЯЦ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "МЕСЯЦ", СтрПериодичность);
	
	Если Параметры.ВыводитьТолькоКассовыеРазрывы Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КассовыеРазрывыУсловие", "
																			|ВТ_ДанныеПодготовленные.ИсходящийОстаток < 0" );
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КассовыеРазрывыУсловие", "Истина" );
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ИтоговыйТекстЗапросаПоВариантуОтчета(Параметры)
	
	Если Параметры.ВариантПлатежногоКалендаря = Перечисления.ВариантыПлатежногоКалендаря.ПерспективноеПланирование Тогда

		Если Параметры.ВыводитьВВалютеОтображения Тогда
			
			ТекстЗапроса = ТекстЗапросаКурсовВалют();
			ТекстЗапроса = ТекстЗапроса+
			"ВЫБРАТЬ
			|	ВТ_ДанныеКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
			|	ВТ_ДанныеКалендаря.Валюта КАК Валюта,
			|	ВТ_ДанныеКалендаря.Банк КАК Банк,
			|	ВТ_ДанныеКалендаря.Дата КАК Дата,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.ИсходящийОстаток, 0)) КАК СуммаВВалютеОперации,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.ВходящийОстаток * ВТ_СрезКурсов.Коэффициент, 0)) КАК ВходящийОстаток,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.ИсходящийОстаток * ВТ_СрезКурсов.Коэффициент, 0)) КАК ИсходящийОстаток,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.Поступление, 0)) КАК ПоступлениеВВалютеОперации,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.Списание, 0)) КАК СписаниеВВалютеОперации,
			|	ВТ_ДанныеКалендаря.Организация КАК Организация,
			|	ВТ_ДанныеКалендаря.ПулЛиквидности КАК ПулЛиквидности,
			|	ВТ_ДанныеКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
			|	МАКСИМУМ(ЕСТЬNULL(ВТ_ДанныеКалендаря.ЕстьПросрочки, 0) > 0) КАК ЕстьПросрочки,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.ИсходящийОстаток * ВТ_СрезКурсов.Коэффициент, ВТ_ДанныеКалендаря.ИсходящийОстаток)) КАК Сумма,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.Поступление * ВТ_СрезКурсов.Коэффициент, ВТ_ДанныеКалендаря.Поступление)) КАК Поступление,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.Списание * ВТ_СрезКурсов.Коэффициент, ВТ_ДанныеКалендаря.Списание)) КАК Списание,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.СуммаБезОвердрафта, 0)) КАК СуммаБезОвердрафта,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.СуммаСМно, 0)) КАК СуммаСМно,
			|	ВТ_ДанныеКалендаря.ЭтоРабочийДень КАК ЭтоРабочийДень,
			|	ДЕНЬНЕДЕЛИ(ВТ_ДанныеКалендаря.Дата) КАК ДеньНедели,
			|	МАКСИМУМ(ВЫБОР
			|			КОГДА ДЕНЬНЕДЕЛИ(ВТ_ДанныеКалендаря.Дата) В (&ПлатежныеДниНедели)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ) КАК ПлатежныйДень,
			|	&ВТ_ДанныеКалендаряСчетЗакрыт КАК СчетЗакрыт,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.НаИсполнении * ВТ_СрезКурсов.Коэффициент, ВТ_ДанныеКалендаря.НаИсполнении)) КАК НаИсполнении,
			|	СУММА(ЕСТЬNULL(ВТ_ДанныеКалендаря.СуммаПросрочки * ВТ_СрезКурсов.Коэффициент, ВТ_ДанныеКалендаря.СуммаПросрочки)) КАК СуммаПросрочки,
			|	СУММА(ЕСТЬNULL(ДополнительныеСведенияПлатежногоКалендаря.СреднийСрокОвердрафта, 0)) КАК СреднийСрокОвердрафта,
			|	МАКСИМУМ(ДополнительныеСведенияПлатежногоКалендаря.ОвердрафтМНО) КАК ОвердрафтМНО,
			|	СУММА(ЕСТЬNULL(ДополнительныеСведенияПлатежногоКалендаря.ГлубинаОвердрафта, 0)) КАК ГлубинаОвердрафта,
			|	СУММА(ЕСТЬNULL(ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток * ВТ_СрезКурсов.Коэффициент, ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток)) КАК СреднедневнойОстаток
			|ПОМЕСТИТЬ ВТ_ДанныеПодготовленные
			|ИЗ
			|	ВТ_ДанныеКалендаря КАК ВТ_ДанныеКалендаря
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СрезКурсов КАК ВТ_СрезКурсов
			|		ПО ВТ_ДанныеКалендаря.Дата = ВТ_СрезКурсов.ДатаКалендарь
			|			И ВТ_ДанныеКалендаря.Валюта = ВТ_СрезКурсов.Валюта
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕстьДвиженияПоСчетам КАК ВТ_ЕстьДвиженияПоСчетам
			|		ПО ВТ_ДанныеКалендаря.БанковскийСчетКасса = ВТ_ЕстьДвиженияПоСчетам.БанковскийСчетКасса
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведенияПлатежногоКалендаря КАК ДополнительныеСведенияПлатежногоКалендаря
			|		ПО ВТ_ДанныеКалендаря.БанковскийСчетКасса = ДополнительныеСведенияПлатежногоКалендаря.БанковскийСчет
			|			И (&ВерсияПлатежногоКалендаря = ДополнительныеСведенияПлатежногоКалендаря.ВерсияПлатежногоКалендаря)
			|			И (&Пользователь = ДополнительныеСведенияПлатежногоКалендаря.Пользователь)
			|ГДЕ
			|	(&ВТ_ДанныеКалендаряУсловиеСчетЗакрыт
			|			ИЛИ ВТ_ЕстьДвиженияПоСчетам.ЕстьДвижения)
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ДанныеКалендаря.БанковскийСчетКасса,
			|	ВТ_ДанныеКалендаря.Валюта,
			|	ВТ_ДанныеКалендаря.Банк,
			|	ВТ_ДанныеКалендаря.Дата,
			|	ВТ_ДанныеКалендаря.Организация,
			|	ВТ_ДанныеКалендаря.ПулЛиквидности,
			|	ВТ_ДанныеКалендаря.ВидДенежныхСредств,
			|	ДЕНЬНЕДЕЛИ(ВТ_ДанныеКалендаря.Дата),
			|	ВТ_ДанныеКалендаря.ЭтоРабочийДень
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ДанныеПодготовленные.БанковскийСчетКасса КАК БанковскийСчетКасса,
			|	ВТ_ДанныеПодготовленные.Валюта КАК Валюта,
			|	ВТ_ДанныеПодготовленные.Банк КАК Банк,
			|	ВТ_ДанныеПодготовленные.Дата КАК Дата,
			|	ВТ_ДанныеПодготовленные.СуммаВВалютеОперации КАК СуммаВВалютеОперации,
			|	ВТ_ДанныеПодготовленные.ВходящийОстаток КАК ВходящийОстаток,
			|	ВТ_ДанныеПодготовленные.ИсходящийОстаток КАК ИсходящийОстаток,
			|	ВТ_ДанныеПодготовленные.ПоступлениеВВалютеОперации КАК ПоступлениеВВалютеОперации,
			|	ВТ_ДанныеПодготовленные.СписаниеВВалютеОперации КАК СписаниеВВалютеОперации,
			|	ВТ_ДанныеПодготовленные.Организация КАК Организация,
			|	ВТ_ДанныеПодготовленные.ПулЛиквидности КАК ПулЛиквидности,
			|	ВТ_ДанныеПодготовленные.ВидДенежныхСредств КАК ВидДенежныхСредств,
			|	ВТ_ДанныеПодготовленные.ЕстьПросрочки КАК ЕстьПросрочки,
			|	ВТ_ДанныеПодготовленные.Сумма КАК Сумма,
			|	ВТ_ДанныеПодготовленные.Поступление КАК Поступление,
			|	ВТ_ДанныеПодготовленные.Списание КАК Списание,
			|	ВТ_ДанныеПодготовленные.СуммаБезОвердрафта КАК СуммаБезОвердрафта,
			|	ВТ_ДанныеПодготовленные.СуммаСМно КАК СуммаСМно,
