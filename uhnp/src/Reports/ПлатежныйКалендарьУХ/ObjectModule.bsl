#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
// Предварительное заполнение регистров, данные которых используются для формирования платежного календаря
//
Процедура ПоднятьДанныеПлатежногоКалендаря(СохранитьОперации = Ложь) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	СведенияОЗапросе = ДенежныеСредстваВстраиваниеУХ.СведенияОЗапросеПодъемаДанных();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = СведенияОЗапросе.ТекстЗапроса; 
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ЭтоБазоваяФункциональность", ЭтоБазоваяФункциональность);
	ПараметрыЗапроса.Вставить("НачалоПериодаОтбора",ПериодОтбора.ДатаНачала);
	ПараметрыЗапроса.Вставить("ОкончаниеПериодаОтбора",ПериодОтбора.ДатаОкончания);     
	
	ПараметрыЗапроса.Вставить("НачалоПериодаАнализПрогнозирования",
											ОбщегоНазначенияУХ.ДобавитьИнтервал(ПериодОтбора.ДатаНачала, ПериодичностьОперативногоПланирования, -ГлубинаАнализаЭкстраполяцииДенежныхПотоков, Ложь));
	ПараметрыЗапроса.Вставить("ОкончаниеПериодаАнализПрогнозирования",ПериодОтбора.ДатаНачала);
	ПараметрыЗапроса.Вставить("ГлубинаОтображенияПросроченныхПлатежей",ГлубинаОтображенияПросроченныхПлатежей);
	ПараметрыЗапроса.Вставить("Пользователь", Пользователь);
	ПараметрыЗапроса.Вставить("ПроизводственныйКалендарь", ПроизводственныйКалендарь);
	ПараметрыЗапроса.Вставить("ДатаТактическогоПланирования", ГоризонтОперативногоПланирования + 86400);       
	ПараметрыЗапроса.Вставить("ИсточникВходящихОстатков", ИсточникВходящихОстатков);
	ПараметрыЗапроса.Вставить("Календарь", Константы.ПроизводственныйКалендарьПоУмолчанию.Получить());
	ПараметрыЗапроса.Вставить("ВыводитьДополнительныеДанные", ВыводитьДополнительныеСведения);  
	ПараметрыЗапроса.Вставить("ИспользоватьДоверительныеКоэффициенты", ИспользоватьДоверительныеКоэффициентыПриПланированииПоступлений);  
	ПараметрыЗапроса.Вставить("ИсточникСобытияФормированияОтчета", ИсточникСобытияФормированияОтчета);  
	ПараметрыЗапроса.Вставить("ПериодичностьОперативногоПланированияСтрокой", ПериодичностьОперативногоПланированияСтрокой());  
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл  
		Запрос.УстановитьПараметр(Параметр.Ключ, ПараметрыЗапроса[Параметр.Ключ]);	
	КонецЦикла;
	
	ТаблицаПоказателейБюджетирования = ЗначенияПоказателейБюджетирования();
	СоздатьВТ_ДанныеБюджетированияИзЗначенийПоказателей(ТаблицаПоказателейБюджетирования, МенеджерВТ);
	
	УстановитьПривилегированныйРежим(Истина);
    РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеПредставлениеПлатежногоКалендаря = РезультатЗапроса[РезультатЗапроса.Количество()-5].Выгрузить();
	ДанныеДополнительныеСведенияПлатежногоКалендаря = РезультатЗапроса[РезультатЗапроса.Количество()-4].Выгрузить();
	ДанныеДоговоров = РезультатЗапроса[РезультатЗапроса.Количество()-3].Выгрузить();  

	ДанныеДляРасчетаСреднегоСрокаОвердрафтаПоступление = РезультатЗапроса[РезультатЗапроса.Количество()-2].Выгрузить();
	ДанныеДляРасчетаСреднегоСрокаОвердрафтаВыбытие = РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить();
	                           
	ДобавитьДанныеЭкстраполяцииДенежныхПотоков(ДанныеПредставлениеПлатежногоКалендаря, ПараметрыЗапроса);
	
	Если СохранитьОперации И ЗначениеЗаполнено(ДанныеПредставлениеПлатежногоКалендаря) Тогда
		ДобавленныеЗаписи = ДобавленныеЗаписи(Пользователь); 
		ДанныеПредставлениеПлатежногоКалендаря.Колонки.Добавить("ИдентификаторОтменившейОперации");
		ДанныеПредставлениеПлатежногоКалендаря.Колонки.Добавить("ИдентификаторДобавившейОперации");
		Для каждого СтрокаДобавленные Из ДобавленныеЗаписи Цикл
			Если Не ЗначениеЗаполнено(СтрокаДобавленные.ИдентификаторЗаписи) Тогда
				Продолжить;					
			КонецЕсли;
			СтрокиДанных = ДанныеПредставлениеПлатежногоКалендаря.НайтиСтроки(Новый Структура("ИдентификаторЗаписи", СтрокаДобавленные.ИдентификаторЗаписи));	
			Для каждого СтрокаДанных Из СтрокиДанных Цикл
				СтрокаДанных.Активна = Ложь;
				СтрокаДанных.ИдентификаторОтменившейОперации  = СтрокаДобавленные.ИдентификаторДобавившейОперации;
			КонецЦикла;
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДобавленныеЗаписи, ДанныеПредставлениеПлатежногоКалендаря); 
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВерсияПлатежногоКалендаря.Установить(Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	
	НаборЗаписей.Загрузить(ДанныеПредставлениеПлатежногоКалендаря);  
	НаборЗаписей.Записать();  
	
	НаборЗаписей = РегистрыСведений.ДополнительныеСведенияПлатежногоКалендаря.СоздатьНаборЗаписей();  
	НаборЗаписей.Отбор.ВерсияПлатежногоКалендаря.Установить(Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Записать();
	
	ДанныеДляРасчетаСреднегоСрокаОвердрафта = Новый Структура;
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Вставить("ДанныеПоступление",ДанныеДляРасчетаСреднегоСрокаОвердрафтаПоступление);
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Вставить("ДанныеВыбытие",ДанныеДляРасчетаСреднегоСрокаОвердрафтаВыбытие);
	
	ТаблицаСреднихСроковОвердрафта = ПодготовитьТаблицуСреднихСроковОвердрафта(ДанныеДляРасчетаСреднегоСрокаОвердрафта);
	
	Для каждого СтрокаТаблицы Из ДанныеДополнительныеСведенияПлатежногоКалендаря Цикл
		
		НаборЗаписей = РегистрыСведений.ДополнительныеСведенияПлатежногоКалендаря.СоздатьНаборЗаписей(); 
		НаборЗаписей.Отбор.ВерсияПлатежногоКалендаря.Установить(Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
		НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
		НаборЗаписей.Отбор.БанковскийСчет.Установить(СтрокаТаблицы.БанковскийСчет); 
		
		НовЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НовЗапись, СтрокаТаблицы);
		
		НовЗапись.ОвердрафтМНО 			= ПредставлениеДоговоровПоБанковскомуСчету(НовЗапись.БанковскийСчет, ДанныеДоговоров); 
		НовЗапись.СреднийСрокОвердрафта = СреднийСрокОвердрафта(НовЗапись.БанковскийСчет, ТаблицаСреднихСроковОвердрафта); 

		НаборЗаписей.Записать();                 
		
	КонецЦикла;  
	
	ПоместитьВоВременноеХранилище(ДанныеДоговоров,АдресХранилищаДанныхДоговоров);	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ДокументРезультат.Очистить();
	
	СтруктураРеквизитыОтчета = РеквизитыОтчетаВСтруктуру();
	
	ДанныеДляФормированияОтчета =  Отчеты.ПлатежныйКалендарьУХ.ПолучитьДанныеДляФормированияОтчета(СтруктураРеквизитыОтчета);

	Если Не ДанныеДляФормированияОтчета.МожноСформироватьОтчет Тогда
		ВызватьИсключение ДанныеДляФормированияОтчета.ТекстОшибки;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(ДанныеДляФормированияОтчета.ТаблицаОстатковИОборотов, АдресХранилищаТаблицыОстатковИОборотов);
	ТаблицаДанных =  ДанныеДляФормированияОтчета.ТаблицаОстатковИОборотов;
	ВнешниеНаборыДанных = Новый Структура("ТЗ_Источник",ТаблицаДанных);

	СтандартнаяОбработка = Ложь;
		
	МакетОформления = ПолучитьИзВременногоХранилища(АдресМакетаОформления);
	
	Настройки = НастроитьОтчет(СтруктураРеквизитыОтчета);
	
	УстановитьПараметрыКомпоновщика(Настройки);
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки, МакетОформления);

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	ДокументРезультат.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
  	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных); 
  
	НастроитьТабличныйДокумент(ДокументРезультат,ДанныеРасшифровки,ТаблицаДанных);
	
	ИсточникСобытияФормированияОтчета = "";
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастройкиЗапросаЭкстраполяцииДенежныхПотоков()
	
	МассивДополнительныхГруппировок = Новый Массив;
	
	ГруппировкаБанковскийСчетКасса = ГруппировкиОтчета.НайтиПоЗначению("БанковскийСчетКасса");
	
	// Обязательные группировки
	ПоляГруппировок = Новый Массив;    
	ПоляГруппировок.Добавить("Валюта");
	ПоляГруппировок.Добавить("Организация");
	ПоляГруппировок.Добавить("ПриходРасход"); 
	
	Если ГруппировкаБанковскийСчетКасса <> Неопределено И ГруппировкаБанковскийСчетКасса.Пометка Тогда 
		МассивДополнительныхГруппировок.Добавить("БанковскийСчетКасса");
		ПоляГруппировок.Добавить("БанковскийСчетКасса");
	КонецЕсли;   
	
	Если ЭтоОборотыПоДДС() Тогда  
		МассивДополнительныхГруппировок.Добавить("СтатьяДвиженияДенежныхСредств");
		ПоляГруппировок.Добавить("СтатьяДвиженияДенежныхСредств");
	КонецЕсли;
	
	ТекстПоляЗаменыПакет1 = "";	
	ТекстГруппировкиЗаменыПакет1 = ""; 
	ТекстПоляЗаменыПакет2 = "";
	ТекстПоляЗаменыПакет3 = "";
	ТекстУсловияСвязиПакет4 = "";
	
	Если МассивДополнительныхГруппировок.Количество() Тогда
		
		Если МассивДополнительныхГруппировок.Найти("БанковскийСчетКасса") <> Неопределено Тогда  
			ТекстПоляЗаменыПакет1 = "ДвиженияДенежныхСредствУХОбороты.ДенежныеСредства КАК БанковскийСчетКасса,";	
			ТекстГруппировкиЗаменыПакет1 = "ДвиженияДенежныхСредствУХОбороты.ДенежныеСредства,";                    
			
			ТекстПоляЗаменыПакет2 = "ВТ_Движения.БанковскийСчетКасса КАК БанковскийСчетКасса,";
			ТекстПоляЗаменыПакет3 = "ВТ_Группировка.БанковскийСчетКасса КАК БанковскийСчетКасса,";
			ТекстУсловияСвязиПакет4 = "ВТ_Группировка.БанковскийСчетКасса = ВТ_Движения.БанковскийСчетКасса";
		КонецЕсли;
		
		Если МассивДополнительныхГруппировок.Найти("СтатьяДвиженияДенежныхСредств") <> Неопределено Тогда  
			ТекстПоляЗаменыПакет1 = ТекстПоляЗаменыПакет1+ "ДвиженияДенежныхСредствУХОбороты.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,";	
			ТекстГруппировкиЗаменыПакет1 = ТекстГруппировкиЗаменыПакет1 + "ДвиженияДенежныхСредствУХОбороты.СтатьяДвиженияДенежныхСредств,"; 
			ТекстПоляЗаменыПакет2 = ТекстПоляЗаменыПакет2 + "ВТ_Движения.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,";
			ТекстПоляЗаменыПакет3 = ТекстПоляЗаменыПакет3 + "ВТ_Группировка.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,"; 
			ТекстУсловияСвязиПакет4 = "ВТ_Группировка.СтатьяДвиженияДенежныхСредств = ВТ_Движения.СтатьяДвиженияДенежныхСредств";

		КонецЕсли;
		
	Иначе
		
		ТекстПоляЗаменыПакет1 = "Истина,";
		ТекстГруппировкиЗаменыПакет1 = "Истина,";
		ТекстПоляЗаменыПакет2 = "Истина,";
		ТекстПоляЗаменыПакет3 = "Истина,";
		ТекстУсловияСвязиПакет4 = "Истина";
		
	КонецЕсли;
	
	НастройкиЗапросаЭкстраполяции = Новый Структура;
	НастройкиЗапросаЭкстраполяции.Вставить("ТекстПоляЗаменыПакет1", ТекстПоляЗаменыПакет1);
	НастройкиЗапросаЭкстраполяции.Вставить("ТекстГруппировкиЗаменыПакет1", ТекстГруппировкиЗаменыПакет1);
	НастройкиЗапросаЭкстраполяции.Вставить("ТекстПоляЗаменыПакет2", ТекстПоляЗаменыПакет2);
	НастройкиЗапросаЭкстраполяции.Вставить("ТекстПоляЗаменыПакет3", ТекстПоляЗаменыПакет3);
	НастройкиЗапросаЭкстраполяции.Вставить("ТекстУсловияСвязиПакет4", ТекстУсловияСвязиПакет4);
	НастройкиЗапросаЭкстраполяции.Вставить("ПоляГруппировок", ПоляГруппировок);
	
	Возврат НастройкиЗапросаЭкстраполяции;
	
КонецФункции

Функция КоличествоБудущихПериодовЭкстраполяции(Параметры)

	ПериодичностьОперативногоПланированияСтрокой = Параметры.ПериодичностьОперативногоПланированияСтрокой;
	
	Возврат ОбщегоНазначенияКлиентСерверУХ.РазностьДат(Параметры.ОкончаниеПериодаОтбора,Параметры.НачалоПериодаОтбора,ПериодичностьОперативногоПланированияСтрокой);
			
КонецФункции

Функция ПериодичностьОперативногоПланированияСтрокой() 
	
	СоответствиеПериодичности = Новый Соответствие;
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.Год,"ГОД");	
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.ДевятьМесяцев,"МЕСЯЦ");	
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.Декада,"ДЕКАДА");	
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.День,"ДЕНЬ");	
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.Квартал,"КВАРТАЛ");	
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.Месяц,"МЕСЯЦ");	
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.Неделя,"НЕДЕЛЯ");	
	СоответствиеПериодичности.Вставить(Перечисления.Периодичность.Полугодие,"ПОЛУГОДИЕ");	

	Возврат СоответствиеПериодичности.Получить(ПериодичностьОперативногоПланирования); 
	
КонецФункции

Процедура ДобавитьДанныеЭкстраполяцииДенежныхПотоков(ДанныеПредставлениеПлатежногоКалендаря, Параметры)
	
	// Особенность запроса: Поле контрагент - служебное, заменяется на другие поля,
	// взависимости от настроек группировки отчета или  режима вывода оборотов 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиХозяйственныхОпераций.ХозяйственнаяОперация КАК ХозяйственнаяОперация
	|ПОМЕСТИТЬ ОперацииПриход
	|ИЗ
	|	Справочник.НастройкиХозяйственныхОпераций КАК НастройкиХозяйственныхОпераций
	|ГДЕ
	|	НастройкиХозяйственныхОпераций.ИсточникДанных = ""ДвиженияДенежныеСредстваКонтрагент""
	|	И НастройкиХозяйственныхОпераций.Приход = ЗНАЧЕНИЕ(Перечисление.ТипыДанныхУчета.ДенежныеСредства)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НастройкиХозяйственныхОпераций.ХозяйственнаяОперация КАК ХозяйственнаяОперация
	|ПОМЕСТИТЬ ОперацииРасход
	|ИЗ
	|	Справочник.НастройкиХозяйственныхОпераций КАК НастройкиХозяйственныхОпераций
	|ГДЕ
	|	НастройкиХозяйственныхОпераций.ИсточникДанных = ""ДвиженияДенежныеСредстваКонтрагент""
	|	И НастройкиХозяйственныхОпераций.Расход = ЗНАЧЕНИЕ(Перечисление.ТипыДанныхУчета.ДенежныеСредства)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НАЧАЛОПЕРИОДА(КалендарныеГрафики.ДатаГрафика, ПОЛУГОДИЕ) КАК ДатаГрафика
	|ПОМЕСТИТЬ ВТ_Периоды
	|ИЗ
	|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	|ГДЕ
	|	КалендарныеГрафики.Календарь.ПроизводственныйКалендарь = &Календарь
	|	И КалендарныеГрафики.ДатаГрафика МЕЖДУ &НачалоПериодаАнализПрогнозирования И &ОкончаниеПериодаАнализПрогнозирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДвиженияДенежныхСредствУХОбороты.Контрагент КАК Контрагент,
	|	ДвиженияДенежныхСредствУХОбороты.Период КАК Дата,
	|	СУММА(ДвиженияДенежныхСредствУХОбороты.СуммаОплатыВВалютеПлатежаОборот) КАК Сумма,
	|	ДвиженияДенежныхСредствУХОбороты.ВалютаПлатежа КАК Валюта,
	|	ДвиженияДенежныхСредствУХОбороты.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(перечисление.ВидыДвиженийПриходРасход.Приход) КАК ПриходРасход
	|ПОМЕСТИТЬ ВТ_Движения
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныеСредстваКонтрагент.Обороты(
	|			&НачалоПериодаАнализПрогнозирования,
	|			&ОкончаниеПериодаАнализПрогнозирования,
	|			ПОЛУГОДИЕ,
	|			ХозяйственнаяОперация В
	|					(ВЫБРАТЬ
	|						ОперацииПриход.ХозяйственнаяОперация
	|					ИЗ
	|						ОперацииПриход)
	|				И ТипДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные), ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные))) КАК ДвиженияДенежныхСредствУХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияДенежныхСредствУХОбороты.Контрагент,
	|	ДвиженияДенежныхСредствУХОбороты.Период,
	|	ДвиженияДенежныхСредствУХОбороты.Организация,
	|	ДвиженияДенежныхСредствУХОбороты.ВалютаПлатежа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДвиженияДенежныхСредствУХОбороты.Контрагент,
	|	ДвиженияДенежныхСредствУХОбороты.Период,
	|	СУММА(ДвиженияДенежныхСредствУХОбороты.СуммаОплатыВВалютеПлатежаОборот),
	|	ДвиженияДенежныхСредствУХОбороты.ВалютаПлатежа,
	|	ДвиженияДенежныхСредствУХОбороты.Организация,
	|	ЗНАЧЕНИЕ(перечисление.ВидыДвиженийПриходРасход.Расход)
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныеСредстваКонтрагент.Обороты(
	|			&НачалоПериодаАнализПрогнозирования,
	|			&ОкончаниеПериодаАнализПрогнозирования,
	|			ПОЛУГОДИЕ,
	|			ХозяйственнаяОперация В
	|					(ВЫБРАТЬ
	|						ОперацииРасход.ХозяйственнаяОперация
	|					ИЗ
	|						ОперацииРасход)
	|				И ТипДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные), ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные))) КАК ДвиженияДенежныхСредствУХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияДенежныхСредствУХОбороты.Контрагент,
	|	ДвиженияДенежныхСредствУХОбороты.Период,
	|	ДвиженияДенежныхСредствУХОбороты.Организация,
	|	ДвиженияДенежныхСредствУХОбороты.ВалютаПлатежа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Движения.Контрагент КАК Контрагент,
	|	ВТ_Движения.Валюта КАК Валюта,
	|	ВТ_Движения.Организация КАК Организация,
	|	ВТ_Движения.ПриходРасход КАК ПриходРасход,
	|	ВТ_Периоды.ДатаГрафика КАК ДатаГрафика
	|ПОМЕСТИТЬ ВТ_Группировка
	|ИЗ
	|	ВТ_Движения КАК ВТ_Движения,
	|	ВТ_Периоды КАК ВТ_Периоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Группировка.Контрагент КАК Контрагент,
	|	ВТ_Группировка.Валюта КАК Валюта,
	|	ВТ_Группировка.Организация КАК Организация,
	|	ВТ_Группировка.ДатаГрафика КАК Дата,
	|	ВТ_Группировка.ПриходРасход КАК ПриходРасход,
	|	ЕСТЬNULL(ВТ_Движения.Сумма, 0) КАК Сумма
	|ИЗ
	|	ВТ_Группировка КАК ВТ_Группировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Движения КАК ВТ_Движения
	|		ПО ВТ_Группировка.Валюта = ВТ_Движения.Валюта
	|			И ВТ_Группировка.Контрагент = ВТ_Движения.Контрагент
	|			И ВТ_Группировка.Организация = ВТ_Движения.Организация
	|			И ВТ_Группировка.ДатаГрафика = ВТ_Движения.Дата";
	
	НастройкиЗапроса = НастройкиЗапросаЭкстраполяцииДенежныхПотоков();
	
	ПоляГруппировок = НастройкиЗапроса.ПоляГруппировок;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ДвиженияДенежныхСредствУХОбороты.Контрагент КАК Контрагент,",НастройкиЗапроса.ТекстПоляЗаменыПакет1);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ДвиженияДенежныхСредствУХОбороты.Контрагент,",НастройкиЗапроса.ТекстГруппировкиЗаменыПакет1);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ВТ_Движения.Контрагент КАК Контрагент,",НастройкиЗапроса.ТекстПоляЗаменыПакет2);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ВТ_Группировка.Контрагент КАК Контрагент,",НастройкиЗапроса.ТекстПоляЗаменыПакет3);

	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ВТ_Группировка.Контрагент = ВТ_Движения.Контрагент",НастройкиЗапроса.ТекстУсловияСвязиПакет4);
	
	ПериодичностьОперативногоПланированияСтрокой = Параметры.ПериодичностьОперативногоПланированияСтрокой;
	
	Для Каждого Параметр Из Параметры Цикл  
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметры[Параметр.Ключ]);	
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПОЛУГОДИЕ",ПериодичностьОперативногоПланированияСтрокой);
	
	РезультатЗапроса = Запрос.Выполнить();    
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	ТаблицаДанныхУчета = РезультатЗапроса.Выгрузить();
	
	ТаблицаГруппировокЭкстраполяции 	= ТаблицаДанныхУчета.Скопировать();
	ТаблицаГруппировокЭкстраполяции.Свернуть(СтрСоединить(ПоляГруппировок,","));
	
	ДанныеЭкстраполяции = ТаблицаДанныхУчета.СкопироватьКолонки();
	
	КоличествоБудущихПериодов = КоличествоБудущихПериодовЭкстраполяции(Параметры);
	
	Для Каждого СтрокаГруппировка Из ТаблицаГруппировокЭкстраполяции Цикл
		
		СтруктураОтбора = Новый Структура;
		Для Каждого ПолеГруппировки Из ПоляГруппировок Цикл   
			СтруктураОтбора.Вставить(ПолеГруппировки,СтрокаГруппировка[ПолеГруппировки]);	
		КонецЦикла;
		
		ДанныеГруппировки = ТаблицаДанныхУчета.Скопировать(СтруктураОтбора);
		ДанныеГруппировки.Сортировать("Дата УБЫВ");
		Базис = Новый Структура("ДатаНачала, Период, КоличествоПериодов", ДанныеГруппировки[0].Дата, ТипЕдиницыИнтервалаВремениАнализаДанных[ПериодичностьОперативногоПланированияСтрокой],1);
		
		УправлениеОтчетамиУХ.РасчетТренда(ДанныеГруппировки, 
  			"Дата", "Сумма", , Базис, ГлубинаАнализаЭкстраполяцииДенежныхПотоков, КоличествоБудущихПериодов, Истина );
		
		Для Каждого ПолеГруппировки Из ПоляГруппировок Цикл   
			ДанныеГруппировки.ЗаполнитьЗначения(СтрокаГруппировка[ПолеГруппировки],	ПолеГруппировки);
		КонецЦикла;	
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеГруппировки, ДанныеЭкстраполяции);

	КонецЦикла;   
	
	ДанныеПредставлениеКоличествоСтрок = ДанныеПредставлениеПлатежногоКалендаря.Количество();
	
	Для Каждого СтрокаДанныхЭкстраполяции Из ДанныеЭкстраполяции Цикл  
		
		Если СтрокаДанныхЭкстраполяции.Дата >= Параметры.НачалоПериодаОтбора Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаДанныхЭкстраполяции.Сумма) Или СтрокаДанныхЭкстраполяции.Сумма < 0  Тогда
				Продолжить;
			КонецЕсли;
			
			НовСтр = ДанныеПредставлениеПлатежногоКалендаря.Добавить();	
			ЗаполнитьЗначенияСвойств(НовСтр, СтрокаДанныхЭкстраполяции);
			НовСтр.Активна = Истина;	 
			НовСтр.ИсточникДанных = Перечисления.ИсточникиДанныхПлатежногоКалендаря.ПрогнозДенежныхПотоков;
			НовСтр.Пользователь = Пользователи.ТекущийПользователь();    
			НовСтр.ВидДенежныхСредств = Перечисления.ФормыОплаты.Безналичная;    
			НовСтр.Инструмент = НСтр("ru = 'Прогноз денежных потоков'");    
			
			Если СтрокаДанныхЭкстраполяции.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход Тогда
				НовСтр.РазделПлатежногоКалендаря = Перечисления.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств;
			Иначе
				НовСтр.РазделПлатежногоКалендаря = Перечисления.РазделыПлатежногоКалендаря.НеуправляемоеПоступлениеСредств;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;  
	
	Если ДанныеПредставлениеКоличествоСтрок = ДанныеПредставлениеПлатежногоКалендаря.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	КолонкиТаблицыДанныхПлатежногоКалендаря = ДанныеПредставлениеПлатежногоКалендаря.Колонки;
	
	СуммируемыеКолонки = Новый Массив;
	СуммируемыеКолонки.Добавить("Сумма");
	
	КолонкиГруппировка = Новый Массив;
	КолонкиСумма = Новый Массив;
	Для Каждого Колонка Из КолонкиТаблицыДанныхПлатежногоКалендаря Цикл 
		
		Если СуммируемыеКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			КолонкиГруппировка.Добавить(Колонка.Имя);
		Иначе
			КолонкиСумма.Добавить(Колонка.Имя);
		КонецЕсли;
		
	КонецЦикла;   
	
	ДанныеПредставлениеПлатежногоКалендаря.Свернуть(СтрСоединить(КолонкиГруппировка,","),СтрСоединить(КолонкиСумма,",")); 
	
КонецПроцедуры

Процедура ВывестиПримечанияКБанковскимСчетам(ДокументРезультат, ДанныеРасшифровки, ТаблицаДанных)
	
	ГруппировкаБанковскийСчетКасса = ГруппировкиОтчета.НайтиПоЗначению("БанковскийСчетКасса");
	
	Если ГруппировкаБанковскийСчетКасса <> Неопределено Тогда
		Если Не ГруппировкаБанковскийСчетКасса.Пометка Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток КАК СреднедневнойОстаток,
		|	ДополнительныеСведенияПлатежногоКалендаря.ГлубинаОвердрафта КАК ГлубинаОвердрафта,
		|	ДополнительныеСведенияПлатежногоКалендаря.СреднийСрокОвердрафта КАК СреднийСрокОвердрафта,
		|	ДополнительныеСведенияПлатежногоКалендаря.ОвердрафтМНО КАК ОвердрафтМНО,
		|	ДополнительныеСведенияПлатежногоКалендаря.БанковскийСчет КАК БанковскийСчет,
		|	ДополнительныеСведенияПлатежногоКалендаря.БанковскийСчет.ВалютаДенежныхСредств КАК Валюта
		|ИЗ
		|	РегистрСведений.ДополнительныеСведенияПлатежногоКалендаря КАК ДополнительныеСведенияПлатежногоКалендаря
		|ГДЕ
		|	ДополнительныеСведенияПлатежногоКалендаря.ВерсияПлатежногоКалендаря = &ВерсияПлатежногоКалендаря
		|	И ДополнительныеСведенияПлатежногоКалендаря.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("ВерсияПлатежногоКалендаря", Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	
	ТаблицаДополнительныхДанных = Запрос.Выполнить().Выгрузить();
	
	Для НомерСтроки = 1 По ДокументРезультат.ВысотаТаблицы Цикл
		
		ТекОбласть = ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C" + 1);
		ТекРасшифровка = ТекОбласть.Расшифровка;
		
		Если ТекРасшифровка <> Неопределено Тогда
			Поля = ДанныеРасшифровки.Элементы.Получить(ТекРасшифровка).ПолучитьПоля();
			
			ПолеБанковскийСчет = Поля.Найти("БанковскийСчетКасса"); 
			 
			Если ПолеБанковскийСчет <> Неопределено Тогда 
				
				БанковскийСчет = ПолеБанковскийСчет.Значение; 
				
				Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(БанковскийСчет) = Тип("СправочникСсылка.БанковскиеСчетаОрганизаций") Тогда
					
					НайдСтроки = ТаблицаДополнительныхДанных.НайтиСтроки(Новый Структура("БанковскийСчет",БанковскийСчет));
					
					Если НайдСтроки.Количество() Тогда
						
						ДопДанныеСчета = НайдСтроки[0]; 
						
						МассивСтрок = Новый Массив;
						
						МассивСтрок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Среднедневной остаток: %1 %2'"),ДопДанныеСчета.СреднедневнойОстаток, ДопДанныеСчета.Валюта)); 
						МассивСтрок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Глубина овердрафта: %1 %2'"),ДопДанныеСчета.ГлубинаОвердрафта, ДопДанныеСчета.Валюта)); 
						МассивСтрок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Средний срок овердрафта: %1 %2'"),
																			ДопДанныеСчета.СреднийСрокОвердрафта,ПериодыУХ.ПросклонятьПериодичность(Перечисления.Периодичность.День,ДопДанныеСчета.СреднийСрокОвердрафта))); 
						МассивСтрок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Овердрафт / МНО: %1'")+" ",
																			?(ЗначениеЗаполнено(ДопДанныеСчета.ОвердрафтМНО),Символы.ПС+ДопДанныеСчета.ОвердрафтМНО,НСтр("ru = 'Нет данных'")))); 
						
						ТекОбласть.Примечание.Текст = СтрСоединить(МассивСтрок,Символы.ПС); 
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;     
			
		КонецЕсли;
			
	КонецЦикла;

КонецПроцедуры

Процедура НастроитьТабличныйДокумент(ДокументРезультат, ДанныеРасшифровки, ТаблицаДанных)

	Если ВыводитьДиаграмму Тогда
		ДокументРезультат.Рисунки.D1.Объект.ОбластьПостроения.ШкалаЗначений.ФорматПодписей = "ЧН=0; ЧГ=3,0";
	КонецЕсли;
	
	Если ЭтоОборотыПоДДС() Тогда
		
		УдаляемаяОбласть = ДокументРезультат.НайтиТекст("Статья движения денежных средств поступление");
		ДокументРезультат.УдалитьОбласть(ДокументРезультат.Область("R"+УдаляемаяОбласть.Верх),ТипСмещенияТабличногоДокумента.ПоВертикали);	
		
		УдаляемаяОбласть = ДокументРезультат.НайтиТекст("Статья движения денежных средств списание");
		ДокументРезультат.УдалитьОбласть(ДокументРезультат.Область("R"+УдаляемаяОбласть.Верх),ТипСмещенияТабличногоДокумента.ПоВертикали);	
		
		ДокументРезультат.ФиксацияСверху = ДокументРезультат.ФиксацияСверху - 2;
		
	КонецЕсли;
	
	ДокументРезультат.ФиксацияСлева = КоличествоЗафиксированныхКолонок();
	
	ВывестиПримечанияКБанковскимСчетам(ДокументРезультат, ДанныеРасшифровки, ТаблицаДанных);
	
КонецПроцедуры

Функция КоличествоЗафиксированныхКолонок()

	КоличествоДополнительныхГруппировок = 1;	
	
	Если ВыводитьДополнительныеСведения И ФиксироватьДополнительныеСведения Тогда
		Для Каждого СтрокаСписка Из ДополнительныеСведения Цикл
			Если СтрокаСписка.Пометка Тогда	
				КоличествоДополнительныхГруппировок = КоличествоДополнительныхГруппировок + 1;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;   
	
	Возврат КоличествоДополнительныхГруппировок;
	
КонецФункции

Функция ПредставлениеДоговоровПоБанковскомуСчету(БанковскийСчет, ДанныеДоговоров)

	МассивСтрок = Новый Массив;

	ПредставлениеДоговоров = "";
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		НайдСтроки = ДанныеДоговоров.НайтиСтроки(Новый Структура("БанковскийСчет",БанковскийСчет));
		
		Для Каждого НайдСтрока Из НайдСтроки Цикл
			МассивСтрок.Добавить(Отчеты.ПлатежныйКалендарьУХ.СобратьПредставлениеДоговора(НайдСтрока.ВидДоговора,
																								НайдСтрока.СуммаДоговора,
																								НайдСтрока.Валюта,
																								НайдСтрока.ПроцентнаяСтавка));
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат СтрСоединить(МассивСтрок,Символы.ПС);
	
КонецФункции  

Функция СреднийСрокОвердрафта(БанковскийСчет, ТаблицаСреднихСроковОвердрафта)
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		НайдСтроки = ТаблицаСреднихСроковОвердрафта.НайтиСтроки(Новый Структура("БанковскийСчет",БанковскийСчет));
		
		Если НайдСтроки.Количество() Тогда
			Возврат НайдСтроки[0].СреднийСрокОвердрафта;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат 0;
	
КонецФункции    

Функция ПодготовитьТаблицуСреднихСроковОвердрафта(ДанныеДляРасчетаСреднегоСрокаОвердрафта)
	
	ДанныеПоступление = ДанныеДляРасчетаСреднегоСрокаОвердрафта.ДанныеПоступление;
	ДанныеВыбытие = ДанныеДляРасчетаСреднегоСрокаОвердрафта.ДанныеВыбытие;
	
	ДанныеДляРасчетаСреднегоСрокаОвердрафта= Новый ТаблицаЗначений;
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Колонки.Добавить("БанковскийСчет");
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Колонки.Добавить("ЧислоДней");
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Колонки.Добавить("КоличествоСтрок");
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Колонки.Добавить("ДатаВыбытия");
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Колонки.Добавить("ДатаПоступления");

	ТаблицаСреднихСроковОвердрафта = Новый ТаблицаЗначений;
	ТаблицаСреднихСроковОвердрафта.Колонки.Добавить("БанковскийСчет");	
	ТаблицаСреднихСроковОвердрафта.Колонки.Добавить("СреднийСрокОвердрафта");	

	Для Каждого СтрокаТаблицы Из ДанныеПоступление Цикл
		
		НакопленнаяСумма = 0;

		НайдСтроки = ДанныеВыбытие.НайтиСтроки(Новый Структура("БанковскийСчет", СтрокаТаблицы.БанковскийСчет));
		
		Для Каждого НайдСтрока Из НайдСтроки Цикл 
			
			Если НайдСтрока.ДатаВыбытия >= СтрокаТаблицы.ДатаПоступления Тогда   
				
				НакопленнаяСумма = НакопленнаяСумма + НайдСтрока.СуммаВыбытие;
				
				Если НакопленнаяСумма >= СтрокаТаблицы.СуммаПоступление Тогда 
					
					НовСтр = ДанныеДляРасчетаСреднегоСрокаОвердрафта.Добавить();
					НовСтр.БанковскийСчет = СтрокаТаблицы.БанковскийСчет;
					НовСтр.ДатаВыбытия = НайдСтрока.ДатаВыбытия;
					НовСтр.ДатаПоступления = СтрокаТаблицы.ДатаПоступления;
					НовСтр.ЧислоДней = ОбщегоНазначенияКлиентСерверУХ.РазностьДатВДнях(НовСтр.ДатаВыбытия,НовСтр.ДатаПоступления)+1;
					НовСтр.КоличествоСтрок = 1; 
					
					Прервать;
					
				КонецЕсли;

			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;	
	
	ДанныеДляРасчетаСреднегоСрокаОвердрафта.Свернуть("БанковскийСчет","ЧислоДней,КоличествоСтрок");
	
	Для Каждого СтрокаТаблицы Из ДанныеДляРасчетаСреднегоСрокаОвердрафта Цикл  
		
		НовСтрИтог = ТаблицаСреднихСроковОвердрафта.Добавить();
		НовСтрИтог.БанковскийСчет = СтрокаТаблицы.БанковскийСчет;	
		НовСтрИтог.СреднийСрокОвердрафта = СтрокаТаблицы.ЧислоДней / СтрокаТаблицы.КоличествоСтрок;	
		
	КонецЦикла;	   
	
	Возврат ТаблицаСреднихСроковОвердрафта;
	
КонецФункции 

Процедура СкорректироватьВыводДополнительныхДанныхВПланированииОднимДнем(Настройки)
	
	ПоказателиДополнительныхСведений = Отчеты.ПлатежныйКалендарьУХ.ПоказателиДополнительныхСведений();
	
	Для Каждого СтрокаСписка Из ПоказателиДополнительныхСведений Цикл
		
		Для Каждого ЭлементКоллекции Из Настройки.Выбор.Элементы Цикл
			
			Если Строка(ЭлементКоллекции.Поле) = СтрокаСписка.Значение Тогда  
				ЭлементКоллекции.Использование = ВыводДополнительныхСведенийВключен(СтрокаСписка.Значение);	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 

КонецПроцедуры

Функция ВыводДополнительныхСведенийВключен(Показатель)
	
	НайдЗначение = ДополнительныеСведения.НайтиПоЗначению(Показатель);	
	
	Если НайдЗначение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ВыводитьДополнительныеСведения И НайдЗначение.Пометка;

КонецФункции

Процедура УстановитьПараметрыКомпоновщика(Настройки)

	Если Не ВыводитьДанныеВВалютеОтображения Тогда
		// убираем итоги, т.к. нет смысла складывать суммы в разных валютах
		Параметр = Настройки.ПараметрыВывода.Элементы.Найти("ВертикальноеРасположениеОбщихИтогов");
		Параметр.Значение = РасположениеИтоговКомпоновкиДанных.Нет;
	КонецЕсли;

	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПериодОтбора", ПериодОтбора);
	НачалоПериодаОтбора = ПериодОтбора.ДатаНачала;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоОтбораПросроченныхЗаявок", 		НачалоОтбораПросроченныхЗаявок);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ГоризонтОперативногоПланирования", 		ГоризонтОперативногоПланирования);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериодаОтбора", 					НачалоПериодаОтбора);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПериодичностьОперативногоПланирования", 	ПериодичностьОперативногоПланирования);    
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПорогНекритичногоНедостатка", 			Константы.ПорогНекритичногоНедостатка.Получить()); 
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПорогКритичногоИзлишка",		 			Константы.ПорогКритичногоИзлишка.Получить()); 
	
КонецПроцедуры

Функция ЗначенияПоказателейБюджетирования()
	
	ПоказателиБюджетирования = ПоказателиБюджетирования();
	Сценарий = Константы.СценарийБюджетированияПлатежногоКалендаря.Получить();
	
	Если ЗначениеЗаполнено(ПоказателиБюджетирования) И ЗначениеЗаполнено(Сценарий) Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Сценарий", Сценарий);
		СтруктураПараметров.Вставить("ПоказательОтчета", ПоказателиБюджетирования);	
		
		Периодичность = ЭтотОбъект.ПериодичностьОперативногоПланирования;
		ДатаНачала = ОбщегоНазначенияУХ.ДатаНачалаПериода(ЭтотОбъект.ПериодОтбора.ДатаНачала, Периодичность);
		ДатаОкончания = ЭтотОбъект.ПериодОтбора.ДатаОкончания;
		МассивПериодов = ПериодыУХ.ПолучитьПодчиненныеПериоды(ДатаНачала, ДатаОкончания, Периодичность);
		
		СтруктураПараметров.Вставить("ПериодОтчета", МассивПериодов);	
		
		РаскрываемыеАналитики = Новый Структура;
		Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			РаскрываемыеАналитики.Вставить("Аналитика"+Инд);
		КонецЦикла;	
		
		РаскрываемыеАналитики.Вставить("АналитикаВалюта");
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВОсновнойВалюте", Истина);
		
		ТаблицаПоказателей = СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей(СтруктураПараметров, РаскрываемыеАналитики, ДополнительныеПараметры);	
	
	Иначе
		
		ТаблицаПоказателей = ПустаяТаблицаПоказателейБюджетирования(); 
		
	КонецЕсли;

	Возврат ТаблицаПоказателей;
	
КонецФункции

Функция ПоказателиБюджетирования()
	Возврат РегистрыСведений.СоответствиеДанныхБюджетированияПлатежномуКалендарю.ПоказателиБюджетирования();
КонецФункции

Процедура СоздатьВТ_ДанныеБюджетированияИзЗначенийПоказателей(ТаблицаЗначенийПоказателей, МенеджерВТ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТаблицаПоказателейБюджетирования", ТаблицаЗначенийПоказателей);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаПоказателейБюджетирования.ПоказательОтчета КАК ПоказательОтчета,
	|	ТаблицаПоказателейБюджетирования.Организация КАК Организация,
	|	ТаблицаПоказателейБюджетирования.ЗначениеВалюта КАК ЗначениеВалюта,
	|	ТаблицаПоказателейБюджетирования.АналитикаВалюта КАК АналитикаВалюта,
	|	ТаблицаПоказателейБюджетирования.Значение КАК Значение,
	|	ТаблицаПоказателейБюджетирования.Валюта КАК Валюта,
	|	ТаблицаПоказателейБюджетирования.Аналитика1 КАК Аналитика1,
	|	ТаблицаПоказателейБюджетирования.Аналитика2 КАК Аналитика2,
	|	ТаблицаПоказателейБюджетирования.Аналитика3 КАК Аналитика3,
	|	ТаблицаПоказателейБюджетирования.Аналитика4 КАК Аналитика4,
	|	ТаблицаПоказателейБюджетирования.Аналитика5 КАК Аналитика5,
	|	ТаблицаПоказателейБюджетирования.Аналитика6 КАК Аналитика6,
	|	ВЫРАЗИТЬ(ТаблицаПоказателейБюджетирования.ПериодОтчета КАК Справочник.Периоды) КАК ПериодОтчета
	|ПОМЕСТИТЬ ВТ_ПоказателиБюджетирования
	|ИЗ
	|	&ТаблицаПоказателейБюджетирования КАК ТаблицаПоказателейБюджетирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.Дата КАК Дата,
	|	Данные.Организация КАК Организация,
	|	Данные.Валюта КАК Валюта,
	|	Данные.Инструмент КАК Инструмент,
	|	Данные.ИсточникДанных КАК ИсточникДанных,
	|	СУММА(Данные.Сумма) КАК Сумма,
	|	Данные.ПулЛиквидности КАК ПулЛиквидности,
	|	Данные.Банк КАК Банк,
	|	Данные.БанковскийСчет КАК БанковскийСчет,
	|	Данные.ПриходРасход КАК ПриходРасход,
	|	ВЫБОР
	|		КОГДА Данные.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеПоступлениеСредств)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|	КОНЕЦ КАК РазделПлатежногоКалендаря,
	|	Данные.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|ПОМЕСТИТЬ ВТ_ДанныеБюджетирования
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Формула_Организация КАК Организация,
	|		&Формула_ПулЛиквидности КАК ПулЛиквидности,
	|		&Формула_Банк КАК Банк,
	|		&Формула_БанковскийСчет КАК БанковскийСчет,
	|		&Формула_ПриходРасход КАК ПриходРасход,
	|		ЗНАЧЕНИЕ(Перечисление.ИсточникиДанныхПлатежногоКалендаря.ДанныеБюджетирования) КАК ИсточникДанных,
	|		ВЫБОР
	|			КОГДА ВТ_ПоказателиБюджетирования.АналитикаВалюта ЕСТЬ NULL
	|				ТОГДА ВТ_ПоказателиБюджетирования.Значение
	|			ИНАЧЕ ВТ_ПоказателиБюджетирования.ЗначениеВалюта
	|		КОНЕЦ КАК Сумма,
	|		ЕСТЬNULL(ВТ_ПоказателиБюджетирования.АналитикаВалюта, ВТ_ПоказателиБюджетирования.Валюта) КАК Валюта,
	|		ВТ_ПоказателиБюджетирования.ПериодОтчета.ДатаОкончания КАК Дата,
	|		""Данные бюджетирования"" КАК Инструмент,
	|		СоответствиеДанныхБюджетированияПлатежномуКалендарю.ПоказательОтчета.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|	ИЗ
	|		ВТ_ПоказателиБюджетирования КАК ВТ_ПоказателиБюджетирования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеДанныхБюджетированияПлатежномуКалендарю КАК СоответствиеДанныхБюджетированияПлатежномуКалендарю
	|			ПО ВТ_ПоказателиБюджетирования.ПоказательОтчета = СоответствиеДанныхБюджетированияПлатежномуКалендарю.ПоказательОтчета) КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Валюта,
	|	Данные.Инструмент,
	|	Данные.Дата,
	|	Данные.ИсточникДанных,
	|	Данные.Организация,
	|	Данные.Банк,
	|	Данные.БанковскийСчет,
	|	Данные.ПулЛиквидности,
	|	Данные.ПриходРасход,
	|	ВЫБОР
	|		КОГДА Данные.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеПоступлениеСредств)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|	КОНЕЦ,
	|	Данные.СтатьяДвиженияДенежныхСредств"; 	
	РеквизитыКалендаря = Новый Массив;
	// получаем реквизиты календаря и их значение по умолчанию
	Мет = Метаданные.РегистрыСведений.СоответствиеДанныхБюджетированияПлатежномуКалендарю;
	Для каждого Ресурс Из Мет.Ресурсы Цикл
		
		ЗначениеПоУмолчанию = Неопределено;
		Типы = Ресурс.Тип.Типы();
		Для каждого Тип Из Типы Цикл
			Если Тип <> Тип("ПеречислениеСсылка.РеквизитыПоказателейОтчетов") Тогда
				ЗначениеПоУмолчанию = Новый (Тип);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Запрос.УстановитьПараметр("ПустоеЗначение_" + Ресурс.Имя, ЗначениеПоУмолчанию);
		
		РеквизитыКалендаря.Добавить(Ресурс.Имя);
	КонецЦикла;
	
	РеквизитыПоказателей = Новый Массив;
	Мет = Метаданные.Перечисления.РеквизитыПоказателейОтчетов;
	Для каждого ЗначениеПеречисления Из Мет.ЗначенияПеречисления Цикл
		 РеквизитыПоказателей.Добавить(ЗначениеПеречисления.Имя);
	КонецЦикла;
		
	Для каждого РеквизитКалендаря Из РеквизитыКалендаря Цикл
		
		ФормулаРасчета = "
		|		ВЫБОР
		|			КОГДА СоответствиеДанныхБюджетированияПлатежномуКалендарю." + РеквизитКалендаря + " ССЫЛКА Перечисление.РеквизитыПоказателейОтчетов ТОГДА
		|				ВЫБОР";
		
		Для каждого РеквизитПоказателя Из РеквизитыПоказателей Цикл
			  ФормулаРасчета = ФормулаРасчета + "
		|				КОГДА СоответствиеДанныхБюджетированияПлатежномуКалендарю." + РеквизитКалендаря + " = ЗНАЧЕНИЕ(Перечисление.РеквизитыПоказателейОтчетов." + РеквизитПоказателя + ")" +
			  						" ТОГДА ВТ_ПоказателиБюджетирования." + РеквизитПоказателя;
		КонецЦикла;
		  
		ФормулаРасчета = ФормулаРасчета + "
		| 					ИНАЧЕ &ПустоеЗначение_" + РеквизитКалендаря + "
		|				КОНЕЦ";
		
		ФормулаРасчета = ФормулаРасчета + "
		|			КОГДА СоответствиеДанныхБюджетированияПлатежномуКалендарю." + РеквизитКалендаря + " = Неопределено ТОГДА &ПустоеЗначение_" + РеквизитКалендаря;
		
		ФормулаРасчета = ФормулаРасчета + "
		|			ИНАЧЕ СоответствиеДанныхБюджетированияПлатежномуКалендарю." + РеквизитКалендаря + "
		|		КОНЕЦ ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Формула_" + РеквизитКалендаря + " ", ФормулаРасчета);
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПустаяТаблицаПоказателейБюджетирования()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ПоказательОтчета", Новый ОписаниеТипов("СправочникСсылка.ПоказателиОтчетов"));
	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Таблица.Колонки.Добавить("АналитикаВалюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Таблица.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 5)));
	Таблица.Колонки.Добавить("ЗначениеВалюта", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 5)));
	Таблица.Колонки.Добавить("ПериодОтчета", Новый ОписаниеТипов("СправочникСсылка.Периоды"));
	
	Для ном = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Таблица.Колонки.Добавить("Аналитика" + Формат(ном, "ЧГ="), Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип));
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Возвращает структуру, содержащую значения реквизитов ответа, необходимых
// для исполнения основной схемы компоновки данных.
Функция РеквизитыОтчетаВСтруктуру() Экспорт
	
	РезультатФункции = Новый Структура;
	Для Каждого ТекРеквизит Из Метаданные().Реквизиты Цикл
		РезультатФункции.Вставить(ТекРеквизит.Имя);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(РезультатФункции, ЭтотОбъект);
	
	ТаблицаМатрицаВесовЛиквидности = МатрицаВесовЛиквидности.Выгрузить();
	ДенежныеСредстваВстраиваниеУХ.ДополнитьМатрицуВесовЛиквидности(ТаблицаМатрицаВесовЛиквидности);  
	
	РезультатФункции.Вставить("ПлановыеКурсы", ПлановыеКурсы.Выгрузить());  	
	РезультатФункции.Вставить("МатрицаВесовЛиквидности", ТаблицаМатрицаВесовЛиквидности);  	
	
	Возврат РезультатФункции;
	
КонецФункции

Функция НастроитьОтчет(РеквизитыОтчета)
	
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	
	Если РежимВыводаОборотов = Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьСводно Тогда  
		ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек["ПерспективноеПланированиеОбороты"];
	ИначеЕсли РежимВыводаОборотов = Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьПоСтатьямДДС Тогда
		ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек["ОборотыПоСтатьямДДС"];
	Иначе
		ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек[ОбщегоНазначения.ИмяЗначенияПеречисления(ВариантПлатежногоКалендаря)];
	КонецЕсли;
		
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);   
	КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(ПользовательскиеНастройки); 
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	Если ВариантПлатежногоКалендаря = Перечисления.ВариантыПлатежногоКалендаря.ПерспективноеПланирование Тогда
		 НастроитьОтчетПерспективноеПланирование(Настройки,РеквизитыОтчета);	
	ИначеЕсли ВариантПлатежногоКалендаря =  Перечисления.ВариантыПлатежногоКалендаря.ПланированиеОднимДнем Тогда
		 НастроитьОтчетПланированиеОднимДнем(Настройки,РеквизитыОтчета);	
	КонецЕсли; 
	
	Возврат Настройки;
	
КонецФункции  

Функция ИмяВариантаОтчета()

	Если ВариантПлатежногоКалендаря = Перечисления.ВариантыПлатежногоКалендаря.ПерспективноеПланирование Тогда
		Если ЭтоОборотыПоДДС() Тогда
			Возврат "ОборотыПоСтатьямДДС";
		ИначеЕсли РежимВыводаОборотов = Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьСводно Тогда    
			Возврат "ПерспективноеПланированиеОбороты";
		Иначе
			Возврат "ПерспективноеПланирование";
		КонецЕсли;
	ИначеЕсли ВариантПлатежногоКалендаря =  Перечисления.ВариантыПлатежногоКалендаря.ПланированиеОднимДнем Тогда
		Возврат "ПланированиеОднимДнем";
	КонецЕсли; 

КонецФункции

Функция ГруппировкиСтрокОтчета(ДополнительныеПараметры)
	
	ТаблицаГруппировок = НовыйТаблицаГруппировок();
	ГруппировкаРодитель = Неопределено;
	Для Каждого СтрокаСписка Из ГруппировкиОтчета Цикл
		Если СтрокаСписка.Пометка Тогда	
			ДобавитьГруппировку(ТаблицаГруппировок, СтрокаСписка.Значение, СтрокаСписка.Пометка,ДополнительныеПараметры,,ГруппировкаРодитель);
			ГруппировкаРодитель = СтрокаСписка.Значение;	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ТаблицаГруппировок;
	
КонецФункции 

Функция ГруппировкиКолонокОтчета(ДополнительныеПараметры)
	
	ТаблицаГруппировок = НовыйТаблицаГруппировок();

	Если ВыводитьДополнительныеСведения Тогда
		Для Каждого СтрокаСписка Из ДополнительныеСведения Цикл
			Если СтрокаСписка.Пометка Тогда	
				ДобавитьГруппировку(ТаблицаГруппировок, "Группировка"+СтрокаСписка.Значение, СтрокаСписка.Пометка, ДополнительныеПараметры);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	ДобавитьГруппировкиКолонокВариантаОтчета(ТаблицаГруппировок, ДополнительныеПараметры);
	
	Возврат ТаблицаГруппировок;
	
КонецФункции   

Функция ГруппировкиСтрокОтчетаПоСтатьямДДС(ДополнительныеПараметры)
	
	ТаблицаГруппировок = НовыйТаблицаГруппировок();

	ПараметрыВывода = Новый Структура;
	ПараметрыВывода.Вставить("ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	
	ДополнительныеПараметры.Вставить("ПараметрыВывода",ПараметрыВывода);	

	ДобавитьГруппировку(ТаблицаГруппировок, "ВхОстатокГруппировка", Истина, ДополнительныеПараметры);
	ДобавитьГруппировку(ТаблицаГруппировок, "ПоступленияВсегоГруппировка", Истина, ДополнительныеПараметры);
	ДобавитьГруппировку(ТаблицаГруппировок, "СтатьяДвиженияДенежныхСредствПоступление", Истина, ДополнительныеПараметры,"БезЗаголовка","ПоступленияВсегоГруппировка",Ложь);
	ДобавитьГруппировку(ТаблицаГруппировок, "СписанияВсегоГруппировка", Истина, ДополнительныеПараметры);
	ДобавитьГруппировку(ТаблицаГруппировок, "СтатьяДвиженияДенежныхСредствСписание", Истина, ДополнительныеПараметры,"БезЗаголовка","СписанияВсегоГруппировка",Ложь);
	ДобавитьГруппировку(ТаблицаГруппировок, "ИсхОстатокГруппировка", Истина, ДополнительныеПараметры);
	
	Возврат ТаблицаГруппировок;
	
КонецФункции

Процедура ДобавитьГруппировкиКолонокВариантаОтчета(ТаблицаГруппировок, ДополнительныеПараметры)
	
	ИмяВариантаОтчета = ИмяВариантаОтчета();
	ДобавитьГруппировку(ТаблицаГруппировок, "Дата", Истина, ДополнительныеПараметры, "ВходящийОстаток");
	ДобавитьГруппировку(ТаблицаГруппировок, "Дата", Истина, ДополнительныеПараметры, "Просрочка");

	Если ИмяВариантаОтчета = "ПерспективноеПланированиеОбороты" Тогда
		ДобавитьГруппировку(ТаблицаГруппировок, "Дата", Истина, ДополнительныеПараметры, "ДатаОбороты");
	Иначе
		ДобавитьГруппировку(ТаблицаГруппировок, "Дата", Истина, ДополнительныеПараметры, "Дата");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьГруппировку(ТаблицаГруппировок,
								Группировка,
								Использование,
								ДополнительныеПараметры,
								Имя = Неопределено,
								ГруппировкаРодитель = Неопределено,
								Автоупорядочивание = Истина)
	
	НовСтр = ТаблицаГруппировок.Добавить();
	НовСтр.Группировка = Группировка;
	НовСтр.Использование = Использование;
	НовСтр.Автоупорядочивание = Автоупорядочивание;
	
	Если Не ЗначениеЗаполнено(Имя) Тогда
	   НовСтр.Имя = ИмяГруппировки(Группировка); 
   	Иначе
	   НовСтр.Имя = Имя; 
    КонецЕсли;  
    НовСтр.ГруппировкаРодитель = ГруппировкаРодитель; 
	
	НовСтр.ВыбранныеПоля = ВыбранныеПоля(ДополнительныеПараметры.ТаблицаСоответствияВыбранныхПолей, НовСтр.Группировка, НовСтр.Имя); 
	НовСтр.Отбор = Отбор(ДополнительныеПараметры.ТаблицаСоответствияОтборов, НовСтр.Группировка, НовСтр.Имя); 
	
	Если Не ДополнительныеПараметры.Свойство("ПараметрыВывода") Тогда
		ДополнительныеПараметры.Вставить("ПараметрыВывода");
	КонецЕсли;
	
	НовСтр.ПараметрыВывода = ДополнительныеПараметры.ПараметрыВывода; 

КонецПроцедуры

Функция ИмяГруппировки(Группировка)
	
	СоответствиеИменГруппировок = Новый Соответствие;
	СоответствиеИменГруппировок.Вставить("ГруппировкаСреднедневнойОстаток","СреднедневнойОстаток");	
	СоответствиеИменГруппировок.Вставить("ГруппировкаГлубинаОвердрафта","ГлубинаОвердрафта");	
	СоответствиеИменГруппировок.Вставить("ГруппировкаСреднийСрокОвердрафта","СреднийСрокОвердрафта");	
	СоответствиеИменГруппировок.Вставить("ГруппировкаОвердрафтМНО","ОвердрафтМНО");	
	
	ИмяГруппировки = СоответствиеИменГруппировок.Получить(Группировка); 
	
	Если ЗначениеЗаполнено(ИмяГруппировки) Тогда
		Возврат ИмяГруппировки;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ВыбранныеПоля(ТаблицаСоответствияВыбранныхПолей, Группировка,Имя)
	
	НайдСтроки = ТаблицаСоответствияВыбранныхПолей.НайтиСтроки(Новый Структура("Группировка,Имя",Группировка,Имя));
	
	Если НайдСтроки.Количество() Тогда
		Возврат НайдСтроки[0].ВыбранныеПоля;
	КонецЕсли;	
	
КонецФункции

Функция Отбор(ТаблицаСоответствияОтборов, Группировка,Имя)
	
	НайдСтроки = ТаблицаСоответствияОтборов.НайтиСтроки(Новый Структура("Группировка,Имя",Группировка,Имя));
	
	Если НайдСтроки.Количество() Тогда
		Возврат НайдСтроки[0].Отбор;
	КонецЕсли;	
	
КонецФункции

Функция ТаблицаСоответствияВыбранныхПолей() 

	ТаблицаСоответствияВыбранныхПолей = Новый ТаблицаЗначений;
	ТаблицаСоответствияВыбранныхПолей.Колонки.Добавить("Группировка");	
	ТаблицаСоответствияВыбранныхПолей.Колонки.Добавить("Имя");	
	ТаблицаСоответствияВыбранныхПолей.Колонки.Добавить("ВыбранныеПоля");	

	НовСтр = ТаблицаСоответствияВыбранныхПолей.Добавить();
	НовСтр.Группировка = "Дата";
	НовСтр.Имя = "Просрочка";
	ВыбранныеПоля = "СуммаПросрочки";
	НовСтр.ВыбранныеПоля = СтрРазделить(ВыбранныеПоля,",");

	НовСтр = ТаблицаСоответствияВыбранныхПолей.Добавить();
	НовСтр.Группировка = "Дата";
	НовСтр.Имя = "ВходящийОстаток";
	ВыбранныеПоля = "ВходящийОстаток";
	НовСтр.ВыбранныеПоля = СтрРазделить(ВыбранныеПоля,",");

	НовСтр = ТаблицаСоответствияВыбранныхПолей.Добавить();
	НовСтр.Группировка = "Дата";
	НовСтр.Имя = "ДатаОбороты";
	ВыбранныеПоля = "Разделитель,Поступление,Списание,ИсходящийОстаток,ЭтоРабочийДень";
	НовСтр.ВыбранныеПоля = СтрРазделить(ВыбранныеПоля,",");
	
	НовСтр = ТаблицаСоответствияВыбранныхПолей.Добавить();
	НовСтр.Группировка = "ГруппировкаСреднедневнойОстаток";
	НовСтр.Имя = "СреднедневнойОстаток";
	ВыбранныеПоля = "СреднедневнойОстаток";
	НовСтр.ВыбранныеПоля = СтрРазделить(ВыбранныеПоля,",");
	
	НовСтр = ТаблицаСоответствияВыбранныхПолей.Добавить();
	НовСтр.Группировка = "ГруппировкаГлубинаОвердрафта";
	НовСтр.Имя = "ГлубинаОвердрафта";
	ВыбранныеПоля = "ГлубинаОвердрафта";
	НовСтр.ВыбранныеПоля = СтрРазделить(ВыбранныеПоля,",");

