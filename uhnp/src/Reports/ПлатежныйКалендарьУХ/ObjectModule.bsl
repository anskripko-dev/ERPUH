КонецФункции

Процедура ЗаполнитьПараметрыВыводаГруппировки(Группировка,ПараметрыВывода)

	Если ПараметрыВывода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыводаЭлементы = Группировка.ПараметрыВывода.Элементы;
	
	Для Каждого КлючЗначение Из ПараметрыВывода Цикл
	
		НайдПараметр = ПараметрыВыводаЭлементы.Найти(КлючЗначение.Ключ);
		
		Если Не НайдПараметр = Неопределено Тогда
			
			НайдПараметр.Использование = Истина;
			НайдПараметр.Значение = КлючЗначение.Значение;
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОтборГруппировки(Группировка, Отбор)
	
	Если Отбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтруктураОтбора Из Отбор Цикл 
		
		ЭлементыОтбора = Группировка.Отбор.Элементы;
		                                          
		НовыйОтбор = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		НовыйОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтруктураОтбора.ЛевоеЗначение);
		
		Если ЗначениеЗаполнено(СтруктураОтбора.ПравоеЗначение) Тогда
			Если СтруктураОтбора.ПравоеЗначениеПолеКомпоновки Тогда
				НовыйОтбор.ПравоеЗначение = Новый ПолеКомпоновкиДанных(СтруктураОтбора.ПравоеЗначение);	
			Иначе
				НовыйОтбор.ПравоеЗначение = СтруктураОтбора.ПравоеЗначение;
			КонецЕсли; 
		КонецЕсли;
		
		НовыйОтбор.Использование = Истина;	
		НовыйОтбор.ВидСравнения  = ВидСравненияКомпоновкиДанных[СтруктураОтбора.ВидСравнения];	
		
	КонецЦикла;

КонецПроцедуры

Процедура НастроитьОтчетПерспективноеПланирование(Настройки,РеквизитыОтчета)

	Если Не ВыводитьДиаграмму Тогда
		Настройки.Структура[0].Использование = Ложь;
	КонецЕсли;
	
	ТаблицаСоответствияВыбранныхПолей = ТаблицаСоответствияВыбранныхПолей();
	ТаблицаСоответствияОтборов = ТаблицаСоответствияОтборов();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТаблицаСоответствияВыбранныхПолей",ТаблицаСоответствияВыбранныхПолей);
	ДополнительныеПараметры.Вставить("ТаблицаСоответствияОтборов",ТаблицаСоответствияОтборов);

	НастроитьСтруктуруОтчета(Настройки,Истина,ДополнительныеПараметры);
	НастроитьСтруктуруОтчета(Настройки,Ложь,ДополнительныеПараметры);
	
	УстановитьУсловноеОформлениеПерспективноеПланирование(Настройки,РеквизитыОтчета);

КонецПроцедуры	

Процедура НастроитьОтчетПланированиеОднимДнем(Настройки,РеквизитыОтчета)

	КоллекцияГруппировок =  Настройки.Структура;
	КоллекцияГруппировок.Очистить();

	ТаблицаСоответствияВыбранныхПолей = ТаблицаСоответствияВыбранныхПолей();
	ТаблицаСоответствияОтборов = ТаблицаСоответствияОтборов();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТаблицаСоответствияВыбранныхПолей",ТаблицаСоответствияВыбранныхПолей);
	ДополнительныеПараметры.Вставить("ТаблицаСоответствияОтборов",ТаблицаСоответствияОтборов);

	ТаблицаГруппировок = ГруппировкиСтрокОтчета(ДополнительныеПараметры);
	
	СформироватьСтруктуруОтчета(ТаблицаГруппировок,КоллекцияГруппировок);
	
	СкорректироватьВыводДополнительныхДанныхВПланированииОднимДнем(Настройки);
	
	УстановитьУсловноеОформлениеПланированиеОднимДнем(Настройки,РеквизитыОтчета);

КонецПроцедуры	

Процедура НастроитьСтруктуруОтчета(Настройки, ПрименениеДляСтрок, ДополнительныеПараметры)

	Если ПрименениеДляСтрок Тогда
		КоллекцияГруппировок = Настройки.Структура[1].Строки;	
	Иначе
		КоллекцияГруппировок = Настройки.Структура[1].Колонки;	
	КонецЕсли;        
	
	КоллекцияГруппировок.Очистить();
	
	Родитель = КоллекцияГруппировок;
	
	Если ПрименениеДляСтрок Тогда
		ТаблицаГруппировок = ГруппировкиСтрокОтчета(ДополнительныеПараметры);
	Иначе 
		ТаблицаГруппировок = ГруппировкиКолонокОтчета(ДополнительныеПараметры);
	КонецЕсли;
	
	Результат = СформироватьСтруктуруОтчета(ТаблицаГруппировок, КоллекцияГруппировок);
	
	Если ПрименениеДляСтрок Тогда 
		ВывестиОборотыПоДДСПодПоследнейГруппировкой(Результат.ПоследняяГруппировка, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры                                                

Функция СформироватьСтруктуруОтчета(ТаблицаГруппировок, КоллекцияГруппировок)
	
	Для каждого ЭлементГруппировки Из ТаблицаГруппировок Цикл
		
		Если ЭлементГруппировки.Использование Тогда
			
			Если ЗначениеЗаполнено(ЭлементГруппировки.ГруппировкаРодитель) Тогда
				ГруппировкаРодитель = НайтиГруппировку(КоллекцияГруппировок, ЭлементГруппировки.ГруппировкаРодитель);
				Родитель = ГруппировкаРодитель.Структура;  
			Иначе
				Родитель = КоллекцияГруппировок;  
			КонецЕсли;
			
			Если ТипЗнч(Родитель) = Тип("КоллекцияЭлементовСтруктурыТаблицыКомпоновкиДанных") Тогда 
				ГруппировкаСКД = Родитель.Добавить();
			Иначе 
				ГруппировкаСКД = Родитель.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			КонецЕсли;
			
			ПоследняяГруппировка = ГруппировкаСКД; 
			                                                                                  
			ЗаполнитьЗначенияСвойств(ГруппировкаСКД,ЭлементГруппировки);
			
			ДобавитьПолеГруппировки(ГруппировкаСКД,ЭлементГруппировки.Группировка,ЭлементГруппировки.Автоупорядочивание,ЭлементГруппировки.ВыбранныеПоля);
			
			ДобавитьОтборГруппировки(ГруппировкаСКД,ЭлементГруппировки.Отбор); 
			
			ЗаполнитьПараметрыВыводаГруппировки(ГруппировкаСКД,ЭлементГруппировки.ПараметрыВывода);

		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат Новый Структура("ПоследняяГруппировка",ПоследняяГруппировка);
	
КонецФункции

Функция НайтиГруппировку(КоллекцияГруппировок, Группировка)
	
	Для Каждого ЭлементКоллекции Из КоллекцияГруппировок Цикл
		
		Для Каждого ПолеГруппировки Из ЭлементКоллекции.ПоляГруппировки.Элементы Цикл
			
			Если Строка(ПолеГруппировки.Поле) = Группировка Тогда
				Возврат ЭлементКоллекции;
			КонецЕсли;
			
		КонецЦикла;
		
		Результат =  НайтиГруппировку(ЭлементКоллекции.Структура, Группировка);	
		
		Если Не Результат = Неопределено Тогда
			Возврат Результат;
		Иначе
			НайтиГруппировку(ЭлементКоллекции.Структура, Группировка);
		КонецЕсли;
		
	КонецЦикла; 
	
КонецФункции

Процедура УстановитьУсловноеОформлениеПерспективноеПланирование(Настройки,РеквизитыОтчета)
	
	УсловноеОформление = Настройки.Структура[1].УсловноеОформление;
	УсловноеОформление.Элементы.Очистить();

	УстановитьУсловноеОформлениеДляВариантаОтчета(Настройки, УсловноеОформление, РеквизитыОтчета, Истина);   
	
