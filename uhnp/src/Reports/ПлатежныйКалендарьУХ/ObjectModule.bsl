	МассивОбластейПрименения.Добавить("ИспользоватьВОбщемИтоге");
	МассивОбластейПрименения.Добавить("ИспользоватьВОтборе");
	МассивОбластейПрименения.Добавить("ИспользоватьВПараметрах");
	
	НеобходимыеОбластиПрименения = СтрРазделить(ОбластьПрименения,",");
	
	Для каждого ТекОбластьПрименения Из МассивОбластейПрименения Цикл
		
		Если Не НеобходимыеОбластиПрименения.Найти(ТекОбластьПрименения) = Неопределено Тогда
			ИспользованиеУсловногоОформления = ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
		Иначе
			ИспользованиеУсловногоОформления = ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
		КонецЕсли;	
		
		ЭлементУО[ТекОбластьПрименения] = ИспользованиеУсловногоОформления; 
		
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолеГруппировки(Группировка, ИмяПоля, Автоупорядочивание = Истина, ПоляВыбора = Неопределено)

	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Использование = Истина;
	
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля); 
	
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.ТипДополнения = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;

	Если Не ПоляВыбора = Неопределено Тогда
	
		Для Каждого ИмяПоляВыбора Из ПоляВыбора Цикл
				
			ПолеВыбора = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ПолеВыбора.Использование = Истина;
			ПолеВыбора.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляВыбора);
			
			Если ИмяПоляВыбора = "ЭтоРабочийДень" Тогда
				ПолеВыбора.Использование = Ложь;  
			КонецЕсли;
			
		КонецЦикла;

	Иначе
		
		ПолеВыбора = Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбора.Использование = Истина;
		
	КонецЕсли;
	
	Если Автоупорядочивание Тогда
	
		ПолеПорядка = Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
		ПолеПорядка.Использование = Истина;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ВывестиОборотыПоДДСПодПоследнейГруппировкой(ПоследняяГруппировка, ДополнительныеПараметры)

	Если ЭтоОборотыПоДДС() Тогда
		
		КоллекцияГруппировок = ПоследняяГруппировка.Структура;
		
		ТаблицаГруппировок = ГруппировкиСтрокОтчетаПоСтатьямДДС(ДополнительныеПараметры);
		
		СформироватьСтруктуруОтчета(ТаблицаГруппировок,КоллекцияГруппировок); 
		
	КонецЕсли;

КонецПроцедуры

Функция ЭтоОборотыПоДДС()
	
	Возврат Отчеты.ПлатежныйКалендарьУХ.ЭтоОборотыПоДДС(РежимВыводаОборотов, ВариантПлатежногоКалендаря);

КонецФункции

