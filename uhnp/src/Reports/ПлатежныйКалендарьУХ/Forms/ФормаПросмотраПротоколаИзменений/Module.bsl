#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТаблицаПротоколИзменений = ПолучитьИзВременногоХранилища(Параметры.АдресПротоколИзменений);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаПротоколИзменений.Операция КАК СТРОКА(255)) КАК Операция,
	|	ТаблицаПротоколИзменений.ОбъектСистемы КАК ОбъектСистемы,
	|	ТаблицаПротоколИзменений.ЕстьОшибка КАК ЕстьОшибка,
	|	ТаблицаПротоколИзменений.ТекстОшибки КАК ТекстОшибки
	|ПОМЕСТИТЬ ВТ_ТаблицаПротоколИзменений
	|ИЗ
	|	&ТаблицаПротоколИзменений КАК ТаблицаПротоколИзменений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаПротоколИзменений.Операция КАК Операция,
	|	ВТ_ТаблицаПротоколИзменений.ОбъектСистемы КАК ОбъектСистемы,
	|	ВТ_ТаблицаПротоколИзменений.ЕстьОшибка КАК ЕстьОшибка,
	|	ВТ_ТаблицаПротоколИзменений.ТекстОшибки КАК ТекстОшибки
	|ИЗ
	|	ВТ_ТаблицаПротоколИзменений КАК ВТ_ТаблицаПротоколИзменений
	|ИТОГИ
	|	МАКСИМУМ(ЕстьОшибка)
	|ПО
	|	Операция";
	
	Запрос.УстановитьПараметр("ТаблицаПротоколИзменений", ТаблицаПротоколИзменений);
	РезультатЗапроса = Запрос.Выполнить(); 
	
	ВыборкаОперация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПротоколИзмененийДерево = РеквизитФормыВЗначение("ПротоколИзменений");
	
	Пока ВыборкаОперация.Следующий() Цикл  
		
		СтрокаОперация = ПротоколИзмененийДерево.Строки.Добавить();
		СтрокаОперация.ОбъектСистемы = 	СокрП(ВыборкаОперация.Операция);
		СтрокаОперация.ЕстьОшибка = 	ВыборкаОперация.ЕстьОшибка;
		СтрокаОперация.Уровень = 1;
		
		ВыборкаОбъектСистемы =  ВыборкаОперация.Выбрать();
		
		Пока ВыборкаОбъектСистемы.Следующий() Цикл
			
			СтрокаОбъектСистемы = СтрокаОперация.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбъектСистемы, ВыборкаОбъектСистемы);
			СтрокаОперация.Уровень = 2;
	
		КонецЦикла;
		
	КонецЦикла; 
	
	ЗначениеВРеквизитФормы(ПротоколИзмененийДерево,"ПротоколИзменений");

КонецПроцедуры

  &НаКлиенте
Процедура ПриОткрытии(Отказ)
	РазвернутьСвернутьТаблицу(Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПротоколИзменений

&НаКлиенте
Процедура ПротоколИзмененийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ПротоколИзменений.ТекущиеДанные;
	
	Если Поле.Имя = "ПротоколИзмененийОбъектСистемы" И ЗначениеЗаполнено(ТекущиеДанные.ОбъектСистемы) Тогда    
		ПоказатьЗначение(,ТекущиеДанные.ОбъектСистемы); 
	ИначеЕсли Поле.Имя = "ПротоколИзмененийТекстОшибки" И ЗначениеЗаполнено(ТекущиеДанные.ТекстОшибки) Тогда   
		ПоказатьЗначение(,ТекущиеДанные.ТекстОшибки); 
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	РазвернутьСвернутьТаблицу(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	РазвернутьСвернутьТаблицу();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

&НаКлиенте
Процедура РазвернутьСвернутьТаблицу(Развернуть = Ложь)

	Для Каждого СтрокаТаблицы Из ПротоколИзменений.ПолучитьЭлементы() Цикл   
		
		Если Развернуть Тогда
			Элементы.ПротоколИзменений.Развернуть(СтрокаТаблицы.ПолучитьИдентификатор());
		Иначе     
			Элементы.ПротоколИзменений.Свернуть(СтрокаТаблицы.ПолучитьИдентификатор());
		КонецЕсли;
		
	КонецЦикла;      	
                
КонецПроцедуры 

#КонецОбласти