
#Область ОбработчикиСобытийФормы   

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИсточникиДанных.Загрузить(Параметры.ИсточникиДанных.Выгрузить()); 
	СортироватьИсточникиДанных();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Модифицированность Тогда 
		ТекстПредупреждения = НСтр("ru = 'Данные были изменены, внесенные изменения будут отменены.
										 |Отменить и закрыть?'");
		ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияПроизвольнойФормы(
					ЭтотОбъект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, "ДействиеВыбрано");
	КонецЕсли;
КонецПроцедуры
	  
#КонецОбласти	  

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отмена(Команда)
	ДействиеВыбрано = Истина;
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)  
	ДействиеВыбрано = Истина;
	Закрыть(ПоместитьВоВременноеХранилищеИсточникиДанных(ИсточникиДанных));
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	УстановитьЗначенияФлажков(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	УстановитьЗначенияФлажков(Ложь);
КонецПроцедуры

#КонецОбласти	  
	  
#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПоместитьВоВременноеХранилищеИсточникиДанных(Знач ИсточникиДанных)
	
	Возврат ПоместитьВоВременноеХранилище(ИсточникиДанных.Выгрузить());
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗначенияФлажков(ЗначениеФлажка)
	
	Для Каждого СтрокаТаблицы Из ИсточникиДанных Цикл   
		СтрокаТаблицы.Поступления = ЗначениеФлажка;	
		СтрокаТаблицы.Списания = ЗначениеФлажка;	
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СортироватьИсточникиДанных()
	
	Для Каждого СтрокаТаблицы Из ИсточникиДанных Цикл 
		СтрокаТаблицы.Порядок = ПорядокИсточникаДанных(СтрокаТаблицы.ИсточникДанных);	
	КонецЦикла;
	
	ИсточникиДанных.Сортировать("Порядок");

КонецПроцедуры

&НаСервере
Функция ПорядокИсточникаДанных(ИсточникДанных) 
	
	Порядки = Новый Соответствие;
	Порядки.Вставить(Перечисления.ИсточникиДанныхПлатежногоКалендаря.ЗаявкиУтвержденные, 1);
	Порядки.Вставить(Перечисления.ИсточникиДанныхПлатежногоКалендаря.ЗаявкиНеутвержденные, 2);
	Порядки.Вставить(Перечисления.ИсточникиДанныхПлатежногоКалендаря.РезервУтвержденный, 3);
	Порядки.Вставить(Перечисления.ИсточникиДанныхПлатежногоКалендаря.ДанныеБюджетирования, 4);
	Порядки.Вставить(Перечисления.ИсточникиДанныхПлатежногоКалендаря.ПрогнозДенежныхПотоков, 5);
	
	Возврат Порядки.Получить(ИсточникДанных);
	
КонецФункции

#КонецОбласти
