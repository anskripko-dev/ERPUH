#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ДанныеЗаполнения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
	|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	СУММА(ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|				ТОГДА ПредставлениеПлатежногоКалендаря.Сумма
	|			ИНАЧЕ -ПредставлениеПлатежногоКалендаря.Сумма
	|		КОНЕЦ) КАК Сумма,
	|	СУММА(ПредставлениеПлатежногоКалендаря.Сумма) < 0 КАК ЭтоРасход
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи = &ИдентификаторЗаписи
	|	И ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь
	|
	|СГРУППИРОВАТЬ ПО
	|	ПредставлениеПлатежногоКалендаря.Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта,
	|	ПредставлениеПлатежногоКалендаря.Дата,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса";
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", 	Параметры.ДанныеЗаполнения.ИдентификаторЗаписи);
	Запрос.УстановитьПараметр("Пользователь", 			Параметры.ДанныеЗаполнения.Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	КонецЕсли;
	
	СформироватьНадписьИсходнаяОперация();
	УстановитьУсловноеОформление();	
	РаспределитьПропорционально(2);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаРазделить(Команда)
	
	Если ОстатокКРаспределению <> 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Сумма распределения должна совпадать с суммой исходной операции'"));
		Возврат;
	КонецЕсли;
	
	Результат = Новый Массив;
	Для Каждого ТекСтр Из Распределение Цикл
		Результат.Добавить(ТекСтр.Сумма * ?(ЭтоРасход, -1, 1));
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПриИзменении(Элемент)
	
	ОбновитьИтогиРаспределения(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиРаспределения(Форма)
	
	ТаблицаРаспределение = Форма.Распределение;
	
	Форма.Распределено = ТаблицаРаспределение.Итог("Сумма");
	Форма.ОстатокКРаспределению = Форма.Сумма - Форма.Распределено;
	
	Если Форма.ОстатокКРаспределению <> 0 Тогда
		
		Если Не ТаблицаРаспределение.Количество() Тогда
			НоваяСтрока = ТаблицаРаспределение.Добавить();
		КонецЕсли;
		
		ПоследняяСтрока = ТаблицаРаспределение[ТаблицаРаспределение.Количество() - 1];
		Если (Форма.ОстатокКРаспределению + ПоследняяСтрока.Сумма) > 0 Тогда
			ПоследняяСтрока.Сумма = Форма.ОстатокКРаспределению + ПоследняяСтрока.Сумма;
			Форма.Распределено = Форма.Сумма;
			Форма.ОстатокКРаспределению = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьПропорционально(Знач КоличествоЧастей)
	
	Если КоличествоЧастей = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Распределение.Очистить();
	
	ОднаЧасть = Окр(Сумма / КоличествоЧастей, 2);
	Остаток = Сумма - (ОднаЧасть * (КоличествоЧастей-1));
	
	Для Сч = 1 По (КоличествоЧастей - 1) Цикл
		НовСтрока = Распределение.Добавить();
		НовСтрока.Сумма = ОднаЧасть;
	КонецЦикла;
	
	НовСтрока = Распределение.Добавить();
	НовСтрока.Сумма = Остаток;
	
	ОбновитьИтогиРаспределения(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспределитьНа2(Команда)
	РаспределитьПропорционально(2);
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспределитьНа3(Команда)
	РаспределитьПропорционально(3);
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспределитьНаN(Команда)
	РаспределитьПропорционально(Распределение.Количество());
КонецПроцедуры

&НаСервере
Процедура СформироватьНадписьИсходнаяОперация()
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(?(ЭтоРасход, НСтр("ru = 'Списание'"), НСтр("ru = 'Зачисление'")));
	МассивСтрок.Добавить("<b>" + Строка(Сумма));
	МассивСтрок.Добавить(Строка(Валюта) + "</b>");
	МассивСтрок.Добавить(НСтр("ru = 'в дату'"));
	МассивСтрок.Добавить("<b>" + Формат(Дата, "ДЛФ=D") + "</b>");
	МассивСтрок.Добавить(?(ЭтоРасход, НСтр("ru = 'со счета'"), НСтр("ru = 'на счет'")));
	МассивСтрок.Добавить("<b>" + Строка(БанковскийСчетКасса) + "</b>");
	
	НадписьИсходнаяОперация = СтроковыеФункцииКлиентСервер.ФорматированнаяСтрока(СтрСоединить(МассивСтрок, " "));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОстатокКРаспределению.Имя);

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ОстатокКРаспределению", ВидСравненияКомпоновкиДанных.Заполнено);

	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПросроченныеДанныеЦвет);
	
КонецПроцедуры

#КонецОбласти