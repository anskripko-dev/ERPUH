
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ДанныеЗаполнения);
	
	НастроитьДинамическийСписок();
	
	НадписьОписаниеОперации =  СтроковыеФункцииКлиентСервер.ФорматированнаяСтрока(
		СтрШаблон(НСтр("ru = 'Размещение <b>%1</b> заявок. Остаток счета %2 на <b>%3 %4</b>.'"), 
			КоличествоЗаявок, 
			?(СуммаЗаявок < 0, НСтр("ru = 'уменьшится'"), НСтр("ru = 'возрастет'")), 
			Макс(СуммаЗаявок, -СуммаЗаявок), 
			Валюта));
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДинамическийСписок()

	Если ВидДенежныхСредств = Перечисления.ФормыОплаты.Безналичная Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СправочникБанковскиеСчета.Ссылка КАК Ссылка,
		|	СправочникБанковскиеСчета.Владелец КАК Владелец,
		|	СправочникБанковскиеСчета.Наименование КАК Наименование,
		|	СправочникБанковскиеСчета.ВалютаДенежныхСредств КАК ВалютаДенежныхСредств,
		|	СправочникБанковскиеСчета.Банк КАК Банк
		|ИЗ    
		// ЕРПУХ ++
		|	Справочник.БанковскиеСчетаОрганизаций КАК СправочникБанковскиеСчета
		// ЕРПУХ --
		|ГДЕ
		|	НЕ СправочникБанковскиеСчета.Закрыт";
		
		БанковскиеСчетаКассы.ОсновнаяТаблица = ДенежныеСредстваВстраиваниеУХКлиентСервер.ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса();

		НоваяГруппировка 		= БанковскиеСчетаКассы.Группировка.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		НоваяГруппировка.Поле 	= Новый ПолеКомпоновкиДанных("Банк");
		
	Иначе
		
		ТекстЗапроса = 
		
		"ВЫБРАТЬ
		|	Кассы.Ссылка КАК Ссылка,
		|	Кассы.Владелец КАК Владелец,
		|	Кассы.Наименование КАК Наименование,
		|	Кассы.ВалютаДенежныхСредств КАК ВалютаДенежныхСредств
		|ИЗ
		|	Справочник.Кассы КАК Кассы";
		
		БанковскиеСчетаКассы.ОсновнаяТаблица = "Справочник.Кассы";
		
		БанковскиеСчетаКассы.Группировка.Элементы.Очистить();
		
	КонецЕсли;
	
	БанковскиеСчетаКассы.ТекстЗапроса = ТекстЗапроса;

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(БанковскиеСчетаКассы.Отбор, "Владелец", Организация, ВидСравненияКомпоновкиДанных.Равно, ,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(БанковскиеСчетаКассы.Отбор, "ВалютаДенежныхСредств", Валюта, ВидСравненияКомпоновкиДанных.Равно, ,Истина);
	
КонецПроцедуры 
