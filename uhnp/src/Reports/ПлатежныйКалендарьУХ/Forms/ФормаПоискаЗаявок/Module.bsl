&НаСервере
Функция ВидСравненияПоУмолчанию(ИмяОтбора)
	ЧастьИмениРеквизита = ЧастьИмениРеквизитаБыстрогоОтбора(ИмяОтбора);
	СписокВыбора = Элементы[ЧастьИмениРеквизита+"ВидСравнения"].СписокВыбора;
	
	Если СписокВыбора.Количество() > 0 Тогда
		Возврат СписокВыбора[0].Значение;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьВидыСравненийОтборов()

	ЗаполнитьСписокВидовСравнения("Приоритет",Элементы.ОтборПриоритетВидСравнения.СписокВыбора);
	ЗаполнитьСписокВидовСравнения("Сумма",Элементы.ОтборСуммаВидСравнения.СписокВыбора);

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокВидовСравнения(ИмяОтбора,ВидыСравнений)
	
	ЧастьИмениРеквизита = ЧастьИмениРеквизитаБыстрогоОтбора(ИмяОтбора);
	РеквизитФормы = НайтиРеквизитФормы(ЧастьИмениРеквизита+"ЛевоеЗначение");	
	ОписаниеТипаЗначенияОтбора = ТипЗначенияОтбора(РеквизитФормы.ТипЗначения);
	
	ПредставленияВидовСравнений = ПредставленияВидовСравненийДляОтбора(ОписаниеТипаЗначенияОтбора);
	
	Для Каждого ПредставлениеВидСравнения Из ПредставленияВидовСравнений Цикл
		
		ВидыСравнений.Добавить(ПредставлениеВидСравнения);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПредставленияВидовСравненийДляОтбора(ОписаниеТипаОтбора)
	
	ПредставленияВидовСравнений = Новый Массив;
	
	ЕстьИерархия = Ложь;
	ЕстьТипЧисло = Ложь;
	ЕстьТипСтрока = Ложь;
	ЕстьТипБулево = Ложь;
	ЕстьСправочник = Ложь;
	ЕстьДокумент = Ложь;
	
	Для Каждого ТипЗначения Из ОписаниеТипаОтбора.Типы() Цикл
		
		Если ТипЗначения =  Тип("Число") Тогда
			ЕстьТипЧисло = Истина;
		ИначеЕсли ТипЗначения =  Тип("Строка") Тогда
			ЕстьТипСтрока = Истина;
		ИначеЕсли ТипЗначения =  Тип("Булево") Тогда
			ЕстьТипБулево = Истина;
		Иначе
			
			ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
			
			Если ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных) Тогда
				Если ОбъектМетаданных.Иерархический Тогда
					ЕстьИерархия = Истина;
				КонецЕсли;
				ЕстьСправочник = Истина;
			ИначеЕсли ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных) Тогда
				ЕстьДокумент = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВидСравненияДляСсылки =  "Равно,НеРавно,ВСписке,НеВСписке,Заполнено,НеЗаполнено";
	
	Если ЕстьТипСтрока Тогда
		ВидыСравненийСтрока = "Содержит,НачинаетсяС,Подобно,Заполнено,НеЗаполнено,НеСодержит,НеНачинаетсяС,НеПодобно,НеСодержит";
	ИначеЕсли ЕстьСправочник Тогда
		Если ЕстьИерархия Тогда
			ВидыСравненийСтрока = "Равно,НеРавно,ВСписке,ВСпискеПоИерархии,ВИерархии,НеВСписке,НеВСпискеПоИерархии,НеВИерархии,Заполнено,НеЗаполнено";
		Иначе
			ВидыСравненийСтрока = ВидСравненияДляСсылки;
		КонецЕсли;
	ИначеЕсли ЕстьДокумент Тогда
			ВидыСравненийСтрока = ВидСравненияДляСсылки;
	ИначеЕсли ЕстьТипЧисло Тогда
		ВидыСравненийСтрока = "Равно,Больше,БольшеИлиРавно,Меньше,МеньшеИлиРавно,Между";
	ИначеЕсли ЕстьТипБулево Тогда
		ВидыСравненийСтрока = "Равно,НеРавно,Заполнено,НеЗаполнено";
	КонецЕсли;
	
	МассивВидовСравнений = СтрРазделить(ВидыСравненийСтрока,",");
	
	Для Каждого ЗначениеВидаСравнения Из МассивВидовСравнений Цикл
		ПредставленияВидовСравнений.Добавить(ПредставлениеВидаСравнения(ЗначениеВидаСравнения));
	КонецЦикла;
	
	Возврат ПредставленияВидовСравнений;

КонецФункции

&НаСервере
Функция ПредставлениеВидаСравнения(ЗначениеВидаСравнения)
	
	НайдСтроки = ТаблицаВидовСравнений.НайтиСтроки(Новый Структура("ЗначениеВидаСравнения",ЗначениеВидаСравнения));

	Если НайдСтроки.Количество() > 0 Тогда
		Возврат НайдСтроки[0].ПредставлениеВидаСравнения;
	КонецЕсли;

КонецФункции 

&НаСервере
Функция ЗначениеВидаСравнения(ПредставлениеВидаСравнения)

	НайдСтроки = ТаблицаВидовСравнений.НайтиСтроки(Новый Структура("ПредставлениеВидаСравнения",ПредставлениеВидаСравнения));

	Если НайдСтроки.Количество() > 0 Тогда
		Возврат НайдСтроки[0].ЗначениеВидаСравнения;
	КонецЕсли;

КонецФункции 

&НаКлиенте
Процедура ПеренестиНаНовуюДатуПродолжение(НоваяДатаЗаявки,ИдентификаторыЗаписей) Экспорт
	
	Если Не ЗначениеЗаполнено(НоваяДатаЗаявки) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторыЗаписей",ИдентификаторыЗаписей);
	ПараметрыОповещения.Вставить("Дата",НоваяДатаЗаявки);
	
	Оповестить("ПеренесеныДатыЗаявок",ПараметрыОповещения);

	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьИсполнениеНаСервере(МассивИдентификаторов, ОтменаСогласования = Ложь) 
	
	Обработки.ОтменаИсполненияПлатежныхПозиций.ОтменитьИсполнениеПоЗаявкам(МассивИдентификаторов, ОтменаСогласования);

КонецПроцедуры

