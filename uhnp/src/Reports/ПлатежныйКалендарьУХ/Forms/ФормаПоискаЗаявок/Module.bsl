	ЗаполнитьТаблицуВидовСравнений();
	
	ЗаполнитьВидыСравненийОтборов();
	
	СостояниеИсполненияВРеестреПлатежей 	= Истина;
	СостояниеИсполненияНаИсполнении  		= Истина;
	СостояниеИсполненияОжидаетИсполнение 	= Истина;
	СостояниеИсполненияСнятьУстановитьВсе 	= Истина;
	СрокРазмещения = НСтр("ru = 'Любой'");
	
	ОтборПриоритетВидСравнения = ВидСравненияПоУмолчанию("Приоритет");
	ОтборСуммаВидСравнения = ВидСравненияПоУмолчанию("Сумма");

	УстановитьТипЗначенияОтбора("Приоритет");
