#Область ОбработчикиСобытийКомандФормы

&НаКлиенте
Процедура ПеренестиНаНовуюДату(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	КоличествоВыделенныхСтрок = ВыделенныеСтроки.Количество();
	
	Если КоличествоВыделенныхСтрок = 0 Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана ни одна заявка.'"));
		Возврат;
		
	КонецЕсли;
	
	ИдентификаторыЗаписей = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		
		ИдентификаторыЗаписей.Добавить(ТекущиеДанные.ИдентификаторЗаписи);
		
	КонецЦикла;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПеренестиНаНовуюДатуПродолжение", ЭтотОбъект, ИдентификаторыЗаписей);
	
	ПоказатьВводДаты(ОписаниеОповещения, ТекущаяДата(), НСтр("ru = 'Укажите новую дату размещения'"), ЧастиДаты.Дата);
		
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВКалендарь(Команда)
	
	ПерейтиВКалендарьНаВыбраннуюЗаявку();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИсполнение(Команда)
	МассивСтрок = Элементы.Список.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	МассивЗаявок = Новый Массив;
	Для Каждого Строка Из МассивСтрок Цикл
		МассивЗаявок.Добавить(Элементы.Список.ДанныеСтроки(Строка).ИдентификаторЗаписи);
	КонецЦикла;

	ОтменитьИсполнениеНаСервере(МассивЗаявок);

	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИсполнениеИСогласование(Команда)
	МассивСтрок = Элементы.Список.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	МассивЗаявок = Новый Массив;
	Для Каждого Строка Из МассивСтрок Цикл
		МассивЗаявок.Добавить(Элементы.Список.ДанныеСтроки(Строка).ИдентификаторЗаписи);
	КонецЦикла;

	ОтменитьИсполнениеНаСервере(МассивЗаявок, Истина);

	Элементы.Список.Обновить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПерейтиВКалендарьНаВыбраннуюЗаявку()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если  ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать заявку'"));
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.СуммаПриход <> 0 Тогда
		РазделПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.РазделыПлатежногоКалендаря.ПоступлениеСредств");  
	ИначеЕсли ТекущиеДанные.СуммаРасход <> 0 Тогда
		РазделПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.РазделыПлатежногоКалендаря.СписаниеСредств");
	КонецЕсли;	
	
	КлючЗаписи = Новый Структура;
	КлючЗаписи.Вставить("Банк");
	КлючЗаписи.Вставить("БанковскийСчетКасса");
	КлючЗаписи.Вставить("Валюта");
	КлючЗаписи.Вставить("ИдентификаторЗаписи");
	КлючЗаписи.Вставить("Организация");
	КлючЗаписи.Вставить("ПулЛиквидности");
	КлючЗаписи.Вставить("СтатьяДвиженияДенежныхСредств");
	КлючЗаписи.Вставить("СуммаПриход");
	КлючЗаписи.Вставить("СуммаРасход");
	КлючЗаписи.Вставить("Дата", ТекущиеДанные.ДатаРазмещения);
	КлючЗаписи.Вставить("РазделПлатежногоКалендаря", РазделПлатежногоКалендаря);

	ЗаполнитьЗначенияСвойств(КлючЗаписи,ТекущиеДанные);
	
	Закрыть(КлючЗаписи);

КонецПроцедуры 

&НаКлиенте
Процедура УстановитьИспользованиеОтбора(ИмяОтбора)

	ЧастьИмениРеквизита = ЧастьИмениРеквизитаБыстрогоОтбора(ИмяОтбора);
	ЭтаФорма[ЧастьИмениРеквизита+"Использование"] = Истина;

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическогоСписка(ИмяОтбора)

	Если ИмяОтбора = "Приоритет" ИЛИ ИмяОтбора = "Сумма" Тогда
		
		ЧастьИмениРеквизита = ЧастьИмениРеквизитаБыстрогоОтбора(ИмяОтбора);
		
		ЗначениеВидаСравнения = ЗначениеВидаСравнения(ЭтаФорма[ЧастьИмениРеквизита+"ВидСравнения"]);
		
		ИмяРеквизитаЛевоеЗначение = ЧастьИмениРеквизита+"ЛевоеЗначение";
		ИмяРеквизитаПравоеЗначение = ЧастьИмениРеквизита+"ПравоеЗначение";
		ИмяРеквизитаИспользование =  ЧастьИмениРеквизита+"Использование";
		
		Если Не НайтиРеквизитФормы(ИмяРеквизитаЛевоеЗначение) = Неопределено Тогда
			ЛевоеЗначение = ЭтаФорма[ИмяРеквизитаЛевоеЗначение];
		КонецЕсли;
		
		Если Не НайтиРеквизитФормы(ИмяРеквизитаПравоеЗначение) = Неопределено Тогда
			ПравоеЗначение = ЭтаФорма[ИмяРеквизитаПравоеЗначение];
		КонецЕсли;
		
		Использование = ЭтаФорма[ИмяРеквизитаИспользование];
		ОтборыСписковКлиентСерверУХ.УдалитьЭлементОтбораСписка(Список,ИмяОтбора);
		
		Если ВидСравненияМежду(ЗначениеВидаСравнения) Тогда
			ОтборыСписковКлиентСерверУХ.УстановитьОтборСпискаМежду(Список,ИмяОтбора,ЛевоеЗначение,ПравоеЗначение,Использование,Ложь);
		Иначе
			ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(Список,ИмяОтбора,ЛевоеЗначение,Использование,ВидСравненияКомпоновкиДанных[ЗначениеВидаСравнения]);			
		КонецЕсли;
		
	ИначеЕсли ИмяОтбора = "ПросроченнаяОперация" Тогда
		
		ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(Список, ИмяОтбора, 
				Истина, СрокРазмещения = НСтр("ru = 'ПросроченныеПозиции'"));
				
	ИначеЕсли ИмяОтбора = "СостояниеИсполнения" Тогда
		
		СостоянияИсполнения = СостоянияИсполненияДляОтбора();	
		ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(Список, ИмяОтбора, СостоянияИсполнения,Истина,ВидСравненияКомпоновкиДанных.ВСписке);

	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Функция СостоянияИсполненияДляОтбора()

	МассивСостояний = Новый Массив;
	
	Если СостояниеИсполненияВРеестреПлатежей Тогда
	 	МассивСостояний.Добавить(Перечисления.СостоянияИсполненияЗаявки.ВключенаВРеестрПлатежей);
	КонецЕсли;
	
	Если СостояниеИсполненияНаИсполнении Тогда
	 	МассивСостояний.Добавить(Перечисления.СостоянияИсполненияЗаявки.НаИсполнении);
	КонецЕсли;
	
	Если СостояниеИсполненияОжидаетИсполнение Тогда
	 	МассивСостояний.Добавить(Перечисления.СостоянияИсполненияЗаявки.НеОбработана);
	КонецЕсли;
	
	Возврат МассивСостояний;

КонецФункции

&НаСервере
Процедура ПриИзмененииБыстрогоОтбора(ИмяОтбора)

	УстановитьТипЗначенияОтбора(ИмяОтбора);
	УстановитьСвойстваЗначенияПолейОтбора(ИмяОтбора);
	УстановитьОтборДинамическогоСписка(ИмяОтбора);
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьТипЗначенияОтбора(ИмяОтбора)

	ЧастьИмениРеквизита = ЧастьИмениРеквизитаБыстрогоОтбора(ИмяОтбора);
	
	ПредставлениеВидаСравнения = ЭтаФорма[ЧастьИмениРеквизита+"ВидСравнения"];
	ЗначениеВидаСравнения = ЗначениеВидаСравнения(ПредставлениеВидаСравнения);
	
	РеквизитФормыЛевоеЗначение = НайтиРеквизитФормы(ЧастьИмениРеквизита+"ЛевоеЗначение");
	РеквизитФормыПравоеЗначение = НайтиРеквизитФормы(ЧастьИмениРеквизита+"ПравоеЗначение");
	
	Если РеквизитФормыЛевоеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначенияОтбораЛевоеЗначение = ТипЗначенияОтбора(РеквизитФормыЛевоеЗначение.ТипЗначения);
	
	ЕстьПравоеЗначение = Не РеквизитФормыПравоеЗначение = Неопределено;
	
	Если ЕстьПравоеЗначение Тогда
		ТипЗначенияОтбораПравоеЗначение = ТипЗначенияОтбора(РеквизитФормыПравоеЗначение.ТипЗначения);
	КонецЕсли;
	
	Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ВыборГруппИЭлементов = ГруппыИЭлементы.Авто;
	
	Если ВидСравненияСписок(ЗначениеВидаСравнения) Тогда
		
		Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ОграничениеТипа = Новый ОписаниеТипов("СписокЗначений");          
		ЭтаФорма[ЧастьИмениРеквизита+"ЛевоеЗначение"] = Новый СписокЗначений;
		ЭтаФорма[ЧастьИмениРеквизита+"ЛевоеЗначение"].ТипЗначения = ТипЗначенияОтбораЛевоеЗначение;
		Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ВыбиратьТип = Ложь;
		
		Если ВидСравненияСписокГрупп(ЗначениеВидаСравнения) Тогда
			Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ВыборГруппИЭлементов = ГруппыИЭлементы.Группы;
		КонецЕсли;
		
	ИначеЕсли ВидСравненияМежду(ЗначениеВидаСравнения) Тогда
		
		Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ОграничениеТипа = ТипЗначенияОтбораЛевоеЗначение;
		Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ВыбиратьТип = Истина;
		
		Если ЕстьПравоеЗначение Тогда
			Элементы[ЧастьИмениРеквизита+"ПравоеЗначение"].ОграничениеТипа = ТипЗначенияОтбораПравоеЗначение;
			Элементы[ЧастьИмениРеквизита+"ПравоеЗначение"].ВыбиратьТип = Истина;
		КонецЕсли;

	Иначе
		
		Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ОграничениеТипа = ТипЗначенияОтбораЛевоеЗначение;
		Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ВыбиратьТип = Истина;
		Если ВидСравненияГруппа(ЗначениеВидаСравнения) Тогда
			Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ВыборГруппИЭлементов = ГруппыИЭлементы.Группы;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьТипЗначенияОтбора()

&НаСервере
Функция ВидСравненияСписок(ЗначениеВидаСравнения)
	
	МассивВидовСравненийСписок =  Новый Массив;
	МассивВидовСравненийСписок.Добавить("ВСписке");
	МассивВидовСравненийСписок.Добавить("НеВСписке");
	МассивВидовСравненийСписок.Добавить("ВСпискеПоИерархии");
	МассивВидовСравненийСписок.Добавить("НеВСпискеПоИерархии");
	
	Возврат Не МассивВидовСравненийСписок.Найти(ЗначениеВидаСравнения) = Неопределено;
	
КонецФункции

&НаСервере
Функция ВидСравненияГруппа(ЗначениеВидаСравнения)

	МассивВидовСравненийГруппа =  Новый Массив;
	МассивВидовСравненийГруппа.Добавить("ВИерархии");
	МассивВидовСравненийГруппа.Добавить("НеВИерархии");
	
	Возврат Не МассивВидовСравненийГруппа.Найти(ЗначениеВидаСравнения) = Неопределено;

КонецФункции 

&НаСервере
Функция ВидСравненияСписокГрупп(ЗначениеВидаСравнения)

	МассивВидовСравненийСписокГрупп =  Новый Массив;
	МассивВидовСравненийСписокГрупп.Добавить("ВСпискеПоИерархии");
	МассивВидовСравненийСписокГрупп.Добавить("НеВСпискеПоИерархии");
	
	Возврат Не МассивВидовСравненийСписокГрупп.Найти(ЗначениеВидаСравнения) = Неопределено;

КонецФункции 

&НаСервере
Функция ВидСравненияЗаполнено(ЗначениеВидаСравнения)

	МассивВидовСравненийСписокГрупп =  Новый Массив;
	МассивВидовСравненийСписокГрупп.Добавить("Заполнено");
	МассивВидовСравненийСписокГрупп.Добавить("НеЗаполнено");
	
	Возврат Не МассивВидовСравненийСписокГрупп.Найти(ЗначениеВидаСравнения) = Неопределено;

КонецФункции 

&НаСервере
Функция ВидСравненияМежду(ЗначениеВидаСравнения)

	Возврат ЗначениеВидаСравнения = "Между";

КонецФункции 

&НаСервере
Функция НайтиРеквизитФормы(ИмяРеквизита)

	РеквизитыФормы = ПолучитьРеквизиты();
	
	РеквизитНайден = Ложь;
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		Если РеквизитФормы.Имя = ИмяРеквизита Тогда
			Возврат  РеквизитФормы;
		КонецЕсли;
	КонецЦикла;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧастьИмениРеквизитаБыстрогоОтбора(ИмяОтбора)

	Возврат "Отбор"+ИмяОтбора;

КонецФункции

&НаСервере
Функция ТипЗначенияОтбора(ОписаниеТипаРеквизита)
	
	МассивТипов = Новый Массив;
	ВсеТипыРеквизита = ОписаниеТипаРеквизита.Типы();
	Для Каждого ТипРеквизита Из ВсеТипыРеквизита Цикл
		
		Если ТипРеквизита = Тип("СписокЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		МассивТипов.Добавить(ТипРеквизита);
		
	КонецЦикла;
	
	Возврат Новый ОписаниеТипов(МассивТипов,,,ОписаниеТипаРеквизита.КвалификаторыЧисла,ОписаниеТипаРеквизита.КвалификаторыСтроки,ОписаниеТипаРеквизита.КвалификаторыДаты);
	
КонецФункции 

&НаСервере
Процедура УстановитьСвойстваЗначенияПолейОтбора(ИмяОтбора)

	ЧастьИмениРеквизита = ЧастьИмениРеквизитаБыстрогоОтбора(ИмяОтбора);
	ПредставлениеВидаСравнения = ЭтаФорма[ЧастьИмениРеквизита+"ВидСравнения"];
	ЗначениеВидаСравнения = ЗначениеВидаСравнения(ПредставлениеВидаСравнения);
	
	ИмяЭлемента = "Группа"+ИмяОтбора+"ПравоеЗначение"; 
	Если Не Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		Элементы[ИмяЭлемента].Видимость = ВидСравненияМежду(ЗначениеВидаСравнения);
	КонецЕсли;
	
	ЗаблокироватьПолеОтбора = Ложь;
	Если ВидСравненияЗаполнено(ЗначениеВидаСравнения) Тогда
		ЗаблокироватьПолеОтбора = Истина;	
		ЭтаФорма[ЧастьИмениРеквизита+"ЛевоеЗначение"] = Неопределено;		
	КонецЕсли;
	
	Элементы[ЧастьИмениРеквизита+"ЛевоеЗначение"].ТолькоПросмотр = ЗаблокироватьПолеОтбора;
	
	ЛевоеЗначение = ЭтотОбъект[ЧастьИмениРеквизита+"ЛевоеЗначение"];
	Если ЗначениеВидаСравнения = "Равно" И ТипЗнч(ЛевоеЗначение) = Тип("СписокЗначений") Тогда
		Если ЛевоеЗначение.Количество() > 0 Тогда
			ЭтотОбъект[ЧастьИмениРеквизита+"ЛевоеЗначение"] = ЛевоеЗначение[0].Значение;	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры 

