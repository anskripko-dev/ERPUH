
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Параметры.Свойство("Пользователь") ИЛИ Не ЗначениеЗаполнено(Параметры.Пользователь) Тогда
		
		ВызватьИсключение НСтр("ru = 'Форма поиска заявок не предназначена для непосредственного открытия'");
		
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("Пользователь", 		Параметры.Пользователь);
	Список.Параметры.УстановитьЗначениеПараметра("НачалоПериодаОтбора", Параметры.НачалоПериодаОтбора);
	Список.Параметры.УстановитьЗначениеПараметра("ЭтоОборотыПоДДС", 	Параметры.ЭтоОборотыПоДДС);
	
	Элементы.УстановленныйОтбор.Видимость = Ложь;
	Элементы.ФормаОтменаИсполнения.Видимость = Пользователи.РолиДоступны("ОтменаИсполненияПлатежныхПозиций");
	Элементы.СтатьяДвиженияДенежныхСредств.Видимость = Параметры.ЭтоОборотыПоДДС;
	
	Если Параметры.Свойство("ФиксированныеНастройки") Тогда
		
		УстановленныйОтбор = Строка(Параметры.ФиксированныеНастройки.Отбор);
		Если Не ПустаяСтрока(УстановленныйОтбор) Тогда
			Элементы.УстановленныйОтбор.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	УправлениеОтборами();  
	
КонецПроцедуры

#КонецОбласти

