#Область ОбработчикиСобытийФормы    

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	БанковскийСчет = Параметры.БанковскийСчет; 
	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БанковскийСчет,"ВалютаДенежныхСредств");
	ДанныеДоговоров = ПолучитьИзВременногоХранилища(Параметры.АдресХранилищаДанныхДоговоров); 
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ДополнительныеСведенияПлатежногоКалендаря.СреднедневнойОстаток КАК СреднедневнойОстаток,
		|	ДополнительныеСведенияПлатежногоКалендаря.ГлубинаОвердрафта КАК ГлубинаОвердрафта,
		|	ДополнительныеСведенияПлатежногоКалендаря.СреднийСрокОвердрафта КАК СреднийСрокОвердрафта
		|ИЗ
		|	РегистрСведений.ДополнительныеСведенияПлатежногоКалендаря КАК ДополнительныеСведенияПлатежногоКалендаря
		|ГДЕ
		|	ДополнительныеСведенияПлатежногоКалендаря.ВерсияПлатежногоКалендаря = &ВерсияПлатежногоКалендаря
		|	И ДополнительныеСведенияПлатежногоКалендаря.Пользователь = &Пользователь
		|	И ДополнительныеСведенияПлатежногоКалендаря.БанковскийСчет = &БанковскийСчет"; 
	
	Запрос = Новый Запрос;    
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("ВерсияПлатежногоКалендаря", Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ВыборкаДетальныеЗаписи);
		
	КонецЦикла;
	
	Элементы.НадписьСреднийСрокОвердрафтаПериод.Заголовок = ПериодыУХ.ПросклонятьПериодичность(ПредопределенноеЗначение("Перечисление.Периодичность.День"),СреднийСрокОвердрафта);

	Заголовок = СтрШаблон(НСтр("ru = 'Дополнительные сведения по счету %1'"),БанковскийСчет);

	ВывестиДанныеПоДоговорамОвердрафтМНО(ДанныеДоговоров, БанковскийСчет);
	
КонецПроцедуры   

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаОвердрафтМНО                  

&НаКлиенте
Процедура ТаблицаОвердрафтМНОВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ТаблицаОвердрафтМНО.ТекущиеДанные;
	
	ПоказатьЗначение(,ТекущиеДанные.ДоговорКонтрагента);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВывестиДанныеПоДоговорамОвердрафтМНО(ДанныеДоговоров, БанковскийСчет)
	
	НайдСтроки = ДанныеДоговоров.НайтиСтроки(Новый Структура("БанковскийСчет",БанковскийСчет));
	
	Элементы.ДекорацияОвердрафтМНО.Видимость = НайдСтроки.Количество();

	ИдентификаторЭлемента = 0;
	
	Для Каждого НайдСтрока Из НайдСтроки Цикл
		
		ИдентификаторЭлемента = ИдентификаторЭлемента + 1;
		
		НовСтр = ТаблицаОвердрафтМНО.Добавить();
		НовСтр.ДоговорКонтрагента = НайдСтрока.ДоговорКонтрагента; 
		НовСтр.ИдентификаторЭлемента = ИдентификаторЭлемента;
		НовСтр.Представление = Отчеты.ПлатежныйКалендарьУХ.СобратьПредставлениеДоговора(НайдСтрока.ВидДоговора,
																						НайдСтрока.СуммаДоговора,
																						НайдСтрока.Валюта,
																						НайдСтрока.ПроцентнаяСтавка);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаОвердрафтМНО Цикл 
	
		НовЭлемент = Элементы.Добавить("Элемент_"+СтрокаТаблицы.ИдентификаторЭлемента,Тип("ДекорацияФормы"),Элементы.ГруппаДоговоры);
		НовЭлемент.Заголовок = СтрокаТаблицы.Представление;
		НовЭлемент.Гиперссылка = Истина;
		НовЭлемент.УстановитьДействие("Нажатие", "Подключаемый_ПриНажатииНаДоговор");
		
	КонецЦикла;	

КонецПроцедуры  

&НаКлиенте
Процедура Подключаемый_ПриНажатииНаДоговор(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	ИдентификаторЭлемента = Сред(ИмяЭлемента,СтрНайти(ИмяЭлемента,"_")+1,СтрДлина(ИмяЭлемента));
	
	НайдСтроки = ТаблицаОвердрафтМНО.НайтиСтроки(Новый Структура("ИдентификаторЭлемента",ИдентификаторЭлемента));
	
	Если НайдСтроки.Количество() Тогда 
		ПоказатьЗначение(,НайдСтроки[0].ДоговорКонтрагента);
	КонецЕсли;

КонецПроцедуры 

#КонецОбласти
