
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаРеестра = ТекущаяДатаСеанса();
	
	УстановитьУсловноеОформление();
	
	ЗаполнитьТаблицуОрганизаций();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОрганизацииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаРеестраПриИзменении(Элемент)
	
	ЗаполнитьТаблицуОрганизаций();

КонецПроцедуры 

&НаКлиенте
Процедура ДекорацияДоступныеДатыНажатие(Элемент)
	
	СписокДат = СписокДатНеобработанныхПлатежей();  
	
	Если Не СписокДат.Количество() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необработанные заявки не найдены'"));
		Возврат;	
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораДатыПлатежаВСписке", ЭтотОбъект);
	СписокДат.ПоказатьВыборЭлемента(Оповещение,НСтр("ru = 'Выберите дату реестра'"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаОрганизаций

&НаКлиенте
Процедура ОткрытьРеестрПлатежей(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаОрганизаций.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.РеестрПлатежей) Тогда
		ПоказатьЗначение(,ТекущиеДанные.РеестрПлатежей);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьРеестрПлатежей(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаРеестра) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо указать дату реестра платежей'"));
		Возврат;
	КонецЕсли; 
	
	Если ДатаРеестра < НачалоДня(ТекущаяДатаСервера()) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Создание реестра платежей за предыдущий период недоступно'"));
		Возврат;
	КонецЕсли; 
	
	СоздатьРеестрПлатежейНаСервере();
	
КонецПроцедуры

&НаКлиенте    
Процедура УстановитьФлажки(Команда)
	УстановитьЗначенияФлажков(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	УстановитьЗначенияФлажков(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()

 Элемент = УсловноеОформление.Элементы.Добавить();

 ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
 ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТаблицаОрганизаций");

 ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
 ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаОрганизаций.РеестрСоздан");
 ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
 ОтборЭлемента.ПравоеЗначение = Истина;

 Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.НейтральноЗеленый);
КонецПроцедуры

