//	
//	Возврат ТекущаяДатаСеанса();
//	
//КонецФункции 
 
&НаСервереБезКонтекста
Функция СписокДатНеобработанныхПлатежей()
	
	ДатыНеобработанныхПлатежей = Документы.РеестрПлатежей.ДатыНеобработанныхПлатежей(НачалоДня(ТекущаяДатаСеанса()));
	
	СписокДат =  Новый СписокЗначений; 
	
	Для Каждого ДатаПлатежа Из ДатыНеобработанныхПлатежей Цикл
		
		ДатаПлатежаСтрокой = Формат(ДатаПлатежа,"ДЛФ=D"); 
		
		Если ДатаПлатежа < ТекущаяДатаСеанса() Тогда
			ПредставлениеДатыПлатежа = ДатаПлатежаСтрокой + " " + НСтр("ru = '(создание реестра недоступно)'");
		Иначе 
			ПредставлениеДатыПлатежа = ДатаПлатежаСтрокой;
		КонецЕсли;
		
		СписокДат.Добавить(ДатаПлатежа, ПредставлениеДатыПлатежа);	
		
	КонецЦикла;
	
	Возврат СписокДат; 

КонецФункции 

&НаКлиенте
Процедура ПослеВыбораДатыПлатежаВСписке(Результат,Параметры) Экспорт

	Если Результат <> Неопределено Тогда 
		
		ВыбраннаяДата = Результат.Значение;
		
		ДатаРеестра = ВыбраннаяДата;
		ЗаполнитьТаблицуОрганизаций();

	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОрганизаций()
	
	ТаблицаОрганизаций.Очистить();
	
	ОрганизацииПлатежей = Документы.РеестрПлатежей.ОрганизацииПлатежей(ДатаРеестра);
	
	Если ОрганизацииПлатежей.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не обработанные заявки на дату %1 не найдены'"),Формат(ДатаРеестра,"ДЛФ=D")));
		Возврат;	
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ОрганизацииПлатежей Цикл 
		
		НовСтр = ТаблицаОрганизаций.Добавить();
		НовСтр.Организация = СтрокаТаблицы.Организация;
		НовСтр.КоличествоЗаявок = СтрокаТаблицы.КоличествоЗаявок;
		НовСтр.СоздаватьРеестрПлатежей = Истина; 
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияФлажков(ЗначениеФлажка)
	
	Для Каждого СтрокаТаблицы Из ТаблицаОрганизаций Цикл   
		СтрокаТаблицы.СоздаватьРеестрПлатежей = ЗначениеФлажка;	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СоздатьРеестрПлатежейНаСервере() 
	
	ВыбранныеОрганизации = ТаблицаОрганизаций.НайтиСтроки(Новый Структура("СоздаватьРеестрПлатежей",Истина));
	
	Если ВыбранныеОрганизации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ВыбранныеОрганизации Цикл
	
		СогласованныеПлатежи = Документы.РеестрПлатежей.СписокСогласованныхПлатежей(СтрокаТаблицы.Организация, ДатаРеестра);
		
		Если СогласованныеПлатежи.Количество() Тогда
			
			Заявки = Новый Массив;
			
			ДокументОбъект = Документы.РеестрПлатежей.СоздатьДокумент();
			
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("ДатаОплаты",ДатаРеестра);
			ДанныеЗаполнения.Вставить("Организация",СтрокаТаблицы.Организация);
			
			ДокументОбъект.Заполнить(ДанныеЗаполнения);
			
			Если ДокументОбъект.ЗаявкиНаОплату.Количество() Тогда 
				
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				СтрокаТаблицы.РеестрСоздан = Истина;
				СтрокаТаблицы.РеестрПлатежей = ДокументОбъект.Ссылка;
					
			КонецЕсли;
		Иначе
			
			ОбщегоНазначения.СообщитьПользователю(
										СтрШаблон(НСтр("ru = 'Не обработанные заявки на дату %1 по организации %2 не найдены'"),Формат(ДатаРеестра,"ДЛФ=D"),СтрокаТаблицы.Организация));
			
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры

#КонецОбласти
