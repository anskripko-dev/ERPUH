&НаСервере
Процедура ОбновитьПредставлениеНаСервере(ОчищатьПрогнозныеОперации =  Истина)
	
	ПоднятьДанныеПлатежногоКалендаряЗапуститьВФоне();
	
    Если ОчищатьПрогнозныеОперации Тогда
		ПрогнозныеОперации.Очистить();
	КонецЕсли;
	ПриИзмененииПрогнозныхОпераций();
	Модифицированность = Ложь;
	ПлатежныеДниНедели.ЗагрузитьЗначения(Отчеты.ПлатежныйКалендарьУХ.ПлатежныеДниНедели());   
	
КонецПроцедуры

&НаСервере
Процедура ПриЗакрытииНаСервере()

	Если ПредставлениеТекущегоВарианта <> "Расшифровка" 
		И Не ЗначениеЗаполнено(Отчет.СохраненнаяВерсияПлатежногоКалендаря) Тогда
		
		// Очистим данные сеанса пользователя. 
		НаименованиеЗадания = НСтр("ru = 'Очистить служебные регистры Платежного календаря'");
		ВыполняемыйМетод = "Отчеты.ПлатежныйКалендарьУХ.ОчиститьСлужебныеРегистры";
               	
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;  
		
		ПараметрыПроцедуры = Новый Структура("СохраненнаяВерсияПлатежногоКалендаря, Пользователь", 
							 Отчет.СохраненнаяВерсияПлатежногоКалендаря, Отчет.Пользователь);
		
		ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, ВыполняемыйМетод, ПараметрыПроцедуры);     
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПереключитьВидимостьЭлемента(Кнопка, Элемент)
	
	Кнопка.Пометка = НЕ Кнопка.Пометка;
	Элемент.Видимость = Кнопка.Пометка;
	
КонецПроцедуры

&НаСервере
Процедура РазделитьПоВидамДенежныхСредствИРазместитьЗаявкиНаСервере(Знач ИдентификаторыСтрокОпераций)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
		|ГДЕ
		|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная)
		|	И ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи В (&МассивИдентификаторов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
		|ГДЕ
		|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
		|	И ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи В(&МассивИдентификаторов)";
	
	ИдентификаторыЗаписей = ИдентификаторыЗаписейВыделенныхСтрок(ИдентификаторыСтрокОпераций);
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", ИдентификаторыЗаписей);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ИдентификаторыЗаписейБезналичнаяФормаОплаты =  РезультатЗапроса[0].Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");
	ИдентификаторыЗаписейНаличнаяФормаОплаты =  РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");
	
	РазместитьЗаявкиНаСервере(ИдентификаторыЗаписейБезналичнаяФормаОплаты, , ВернутьПустойБанковскийСчетОрганизации());
	РазместитьЗаявкиНаСервере(ИдентификаторыЗаписейНаличнаяФормаОплаты, , ВернутьПустуюКассуОрганизации());

КонецПроцедуры

&НаСервере
