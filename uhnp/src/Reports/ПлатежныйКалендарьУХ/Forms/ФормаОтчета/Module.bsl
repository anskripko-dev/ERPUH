	Запрос.УстановитьПараметр("ПустойУИД", ОбщегоНазначенияКлиентСерверУХ.ПустойУникальныйИдентификатор());
	
	Если БанковскийСчетКасса <> Неопределено Тогда
		
		УсловиеПоСчету = "НЕ ПредставлениеПлатежногоКалендаря.ФиксированныйБанковскийСчет";
		Если ЗначениеЗаполнено(БанковскийСчетКасса) Тогда
			УсловиеПоСчету = УсловиеПоСчету + Символы.ПС + 
