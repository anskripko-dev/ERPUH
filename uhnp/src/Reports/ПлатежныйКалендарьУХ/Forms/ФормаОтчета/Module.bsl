Процедура ДобавитьОперациюВПротокол(РезультатВыполненияОперации)
	
	Операция = РезультатВыполненияОперации.Операция;
	
	НовСтр = ПротоколИзменений.Добавить();
	НовСтр.Операция = Операция;	
	НовСтр.ОбъектСистемы = РезультатВыполненияОперации.ОбъектСистемы;
	НовСтр.ЕстьОшибка = РезультатВыполненияОперации.ЕстьОшибка;
	НовСтр.ТекстОшибки = РезультатВыполненияОперации.ТекстОшибки;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИспользуемыеИсточникиДанных()

	ИспользуемыеИсточникиДанных = РегистрыСведений.МатрицаВесовЛиквидности.ИспользуемыеИсточникиДанных(Отчет.ЭтоБазоваяФункциональность);
	
	ИсточникиДанных.Очистить();
	
	Для Каждого ТекИсточникДанныхПлатежногоКалендаря Из ИспользуемыеИсточникиДанных Цикл  
		
		НовСтр = ИсточникиДанных.Добавить();	
		НовСтр.ИсточникДанных = ТекИсточникДанныхПлатежногоКалендаря;
		НовСтр.Поступления = Истина;
		НовСтр.Списания = Истина;
		
	КонецЦикла;   

КонецПроцедуры   

&НаСервере
Функция ИспользуемыеИсточникиДанныхИзменены(СохраненныеИсточникиДанных)
	
	ИспользуемыеИсточникиДанных = РегистрыСведений.МатрицаВесовЛиквидности.ИспользуемыеИсточникиДанных(Отчет.ЭтоБазоваяФункциональность);
	
	Возврат СохраненныеИсточникиДанных.Количество() <> ИспользуемыеИсточникиДанных.Количество();

КонецФункции

&НаСервере
Процедура УстановитьВариантОтчета()
	
	ПользовательскиеНастройки = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки;

	СКД = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	
	Если Отчет.РежимВыводаОборотов = Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьСводно Тогда  
		ВариантНастройки = СКД.ВариантыНастроек["ПерспективноеПланированиеОбороты"];
	ИначеЕсли Отчет.РежимВыводаОборотов = Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьПоСтатьямДДС Тогда
		ВариантНастройки = СКД.ВариантыНастроек["ОборотыПоСтатьямДДС"];
	Иначе
		ВариантНастройки = СКД.ВариантыНастроек[ОбщегоНазначения.ИмяЗначенияПеречисления(Отчет.ВариантПлатежногоКалендаря)];
	КонецЕсли;
		
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);

	Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(ПользовательскиеНастройки);
	
КонецПроцедуры

&НаСервере
Функция ИдентификаторыЗаписейВыделенныхСтрок(ИдентификаторыСтрокОпераций,ОперацииИзСтопЛиста = Ложь)

	ИдентификаторыЗаписей = Новый Массив;
	
	Для Каждого ТекИдентификатор Из ИдентификаторыСтрокОпераций Цикл
		
		Если ТипЗнч(ТекИдентификатор) = Тип("УникальныйИдентификатор") Тогда
			ИдентификаторыЗаписей.Добавить(ТекИдентификатор);
		Иначе  
			ИмяТаблицы = "";
			Если ОперацииИзСтопЛиста Тогда  
				СтрокаТаблицы = СтопЛист.НайтиПоИдентификатору(ТекИдентификатор);
			Иначе
				СтрокаТаблицы = ДетализацияОборотов.НайтиПоИдентификатору(ТекИдентификатор);  
			КонецЕсли;
			Если СтрокаТаблицы <> Неопределено Тогда
				ИдентификаторыЗаписей.Добавить(СтрокаТаблицы.ИдентификаторЗаписи);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;  
	
	Возврат ИдентификаторыЗаписей; 
	
КонецФункции

&НаСервере
Функция ПолучитьВидОперацииДляПереводаСобственныхСредств(Операция)

	Если ТипЗнч(Операция.БанковскийСчетКассаСписания) 			= ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций()
			И ТипЗнч(Операция.БанковскийСчетКассаЗачисления) 	= ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций() Тогда
			
		ВидОперации = Справочники.ВидыОперацийУХ.ПереводНаДругойСчетОрганизации;
		
	ИначеЕсли ТипЗнч(Операция.БанковскийСчетКассаСписания) 		= Тип("СправочникСсылка.Кассы")
			И ТипЗнч(Операция.БанковскийСчетКассаЗачисления) 	= Тип("СправочникСсылка.Кассы") Тогда
			
		ВидОперации = Справочники.ВидыОперацийУХ.ВыдачаДенежныхСредствВДругуюКассу;
		
	ИначеЕсли ТипЗнч(Операция.БанковскийСчетКассаСписания) 		= ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций()
			И ТипЗнч(Операция.БанковскийСчетКассаЗачисления) 	= Тип("СправочникСсылка.Кассы") Тогда
			
		ВидОперации = Справочники.ВидыОперацийУХ.СнятиеНаличныхВКассу;
		
	ИначеЕсли ТипЗнч(Операция.БанковскийСчетКассаСписания) 		= Тип("СправочникСсылка.Кассы")
			И ТипЗнч(Операция.БанковскийСчетКассаЗачисления) 	=  ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций() Тогда
			
		ВидОперации = Справочники.ВидыОперацийУХ.ВзносНаличнымиВБанк;
		
	КонецЕсли;
	
	Возврат ВидОперации;	

КонецФункции

&НаСервере
Функция ПолучитьВидОперацииДляВнутригрупповогоПеремещения(Операция)
	
	Если ТипЗнч(Операция.УточнениеОперации) = Тип("Структура") 
		И Операция.УточнениеОперации.Свойство("ДоговорКонтрагента")
		И ЗначениеЗаполнено(Операция.УточнениеОперации.ДоговорКонтрагента) Тогда
		ВерсияСоглашения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция.УточнениеОперации.ДоговорКонтрагента, "ВерсияСоглашения"); 
		ВидДоговораУХ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВерсияСоглашения, "ВидДоговораУХ"); 
		ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДоговораУХ, "ВидОперацииУХСписание");	
	Иначе                                     
		ВидОперации = Справочники.ВидыОперацийУХ.ОплатаПоставщику;      
	КонецЕсли;
	
	Возврат ВидОперации;

КонецФункции

&НаСервере
Функция ОперацияИзмененаНовойОперацией(ИдентификаторОперации)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря КАК ВерсияПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Пользователь КАК Пользователь,
	|	ПредставлениеПлатежногоКалендаря.Активна КАК Активна,
	|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
	|	ПредставлениеПлатежногоКалендаря.ПулЛиквидности КАК ПулЛиквидности,
	|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
	|	ПредставлениеПлатежногоКалендаря.Банк КАК Банк,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Инструмент КАК Инструмент,
	|	ПредставлениеПлатежногоКалендаря.Приоритет КАК Приоритет,
	|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации КАК ИдентификаторДобавившейОперации,
	|	ПредставлениеПлатежногоКалендаря.Сумма КАК Сумма,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации КАК ИдентификаторОтменившейОперации,
	|	ПредставлениеПлатежногоКалендаря.КрайняяДата КАК КрайняяДата,
	|	ПредставлениеПлатежногоКалендаря.ФиксированныйБанковскийСчет КАК ФиксированныйБанковскийСчет,
	|	ПредставлениеПлатежногоКалендаря.ИсточникДанных КАК ИсточникДанных,
	|	ПредставлениеПлатежногоКалендаря.Оптимизация КАК Оптимизация
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации = &ИдентификаторДобавившейОперации
	|	И ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = &ВерсияПлатежногоКалендаря
	|	И ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь"
	);
	Запрос.УстановитьПараметр("ИдентификаторДобавившейОперации", ИдентификаторОперации);
	Запрос.УстановитьПараметр("ВерсияПлатежногоКалендаря", Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	
	Результат = Новый Структура("ОперацияИзменена, ПредставлениеОперации", Ложь, "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ИдентификаторОтменившейОперации) Тогда
			 Строки = ПрогнозныеОперации.НайтиСтроки(Новый Структура("ИдентификаторОперации", Выборка.ИдентификаторОтменившейОперации));
			 Если Строки.Количество() > 0 Тогда
				 Результат.ПредставлениеОперации = Строки[0].ПредставлениеОперации;
				 Результат.ОперацияИзменена = Истина;
			 КонецЕсли;
			 
			 Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоднятьДанныеПлатежногоКалендаряЗапуститьВФоне(СохранитьОперации = Ложь) 
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ПараметрыОтчета = ОтчетОбъект.РеквизитыОтчетаВСтруктуру();
	
	НаименованиеЗадания = НСтр("ru = 'Поднять данные платежного календаря'", ОбщегоНазначения.КодОсновногоЯзыка());
	ВыполняемыйМетод = "Отчеты.ПлатежныйКалендарьУХ.ПоднятьДанныеПлатежногоКалендаря";
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	ДлительнаяОперацияПоднятьДанные = ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, ВыполняемыйМетод, ПараметрыОтчета, СохранитьОперации);

КонецПроцедуры  

&НаКлиенте
Процедура ПараметрыОжиданияПодготовкиДанных(ДополнительныеПараметры = Неопределено) 
	
	Если Не ЗначениеЗаполнено(ДлительнаяОперацияПоднятьДанные) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Осуществляется подготовка данных'");  
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииПодготовкиДанных", ЭтотОбъект, ДополнительныеПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперацияПоднятьДанные, ОписаниеОповещения, ПараметрыОжидания); 
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриЗавершенииПодготовкиДанных(ДлительнаяОперация, ДополнительныеПараметры) Экспорт 

	Статус = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДлительнаяОперация, "Статус");   
	Если Статус = "Ошибка" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибка при подготовке данных платежного календаря: %1'"), ДлительнаяОперация.КраткоеПредставлениеОшибки);	
	КонецЕсли;
	
	Если ДополнительныеПараметры = "ОткрытиеОтчета" 
		И ДлительнаяОперация = Неопределено Тогда  		
		Закрыть();		
	КонецЕсли; 
	
	Если ДополнительныеПараметры = "АктуализироватьДанные" Тогда
		АктуализироватьДанныеНаСервере();
	КонецЕсли;     
	
КонецПроцедуры    

&НаСервере  
Процедура ПереопределитьРеквизитыСУчетомФункциональности()
	
	Если Отчет.ЭтоБазоваяФункциональность Тогда
		Отчет.КоличествоПериодовДолгосрочногоПланирования = 0;	
		Отчет.ВыводитьДополнительныеСведения = Ложь;  
		Отчет.ВыводитьДиаграмму = Ложь;
	КонецЕсли;     
	
КонецПроцедуры

#КонецОбласти

#Область ОптимизацияПлатежногоКалендаря
&НаКлиенте
Процедура ОптимизироватьПлатежныйКалендарь(Команда)
	
	ДлительнаяОперация = ОптимизироватьПлатежныйКалендарьНаСервере();
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибка оптимизации платежного календаря: %1'"), ДлительнаяОперация.КраткоеПредставлениеОшибки);	
		
	Иначе
		НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		НастройкиОжидания.ВыводитьОкноОжидания = Истина;
		НастройкиОжидания.ТекстСообщения = НСтр("ru = 'Выполняется оптимизация платежного календаря'");
		
		Обработчик = Новый ОписаниеОповещения("ПослеОптимизацииПлатежногоКалендаря", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Обработчик, НастройкиОжидания);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОптимизироватьПлатежныйКалендарьНаСервере()
		
	НастройкиОптимизации = НастройкиОптимизации();	
	Если НЕ ЗначениеЗаполнено(НастройкиОптимизации.ВариантыОптимизации) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбраны варианты оптимизации'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"НастройкаВариантовОптимизации", "Отчет");
		Возврат Неопределено;
	КонецЕсли;	
	
	// делаем чтобы возврат кредита отображался в конце месяца в отчете
	ЕстьКредит = (НастройкиОптимизации.ВариантыОптимизации.Найти(Перечисления.ВариантыОптимизацииПлатежногоКалендаря.Кредит) <> Неопределено);
	ЕстьОвердрафт = (НастройкиОптимизации.ВариантыОптимизации.Найти(Перечисления.ВариантыОптимизацииПлатежногоКалендаря.Овердрафт) <> Неопределено);
	Если ЕстьКредит ИЛИ ЕстьОвердрафт Тогда
		Если Отчет.ГоризонтОперативногоПланирования > НачалоДня(Отчет.ПериодОтбора.ДатаОкончания) Тогда
			Отчет.ЧислоДнейОперативногоПланирования = (Отчет.ГоризонтОперативногоПланирования - Отчет.ПериодОтбора.ДатаНачала) / 86400 + 1;
		КонецЕсли;
		
		Если НачалоДня(Отчет.ПериодОтбора.ДатаОкончания) <= Отчет.ГоризонтОперативногоПланирования Тогда
			Отчет.ПериодОтбора.ДатаОкончания = КонецДня(Отчет.ГоризонтОперативногоПланирования + 86400);
		КонецЕсли;
	КонецЕсли;
	
	НастройкиЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	НастройкиЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Оптимизация платежного календаря'", ОбщегоНазначения.КодОсновногоЯзыка());
	НастройкиЗапуска.ЗапуститьВФоне = Истина;
	НастройкиЗапуска.ОжидатьЗавершение = 0;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НастройкиОптимизации", НастройкиОптимизации);
	СтруктураПараметров.Вставить("ПараметрыОтчета", ПараметрыОтчета());
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ОптимизацияПлатежногоКалендаря.ВыполнитьОптимизациюПлатежногоКалендаряВФоне",
		СтруктураПараметров,
		НастройкиЗапуска);
	
КонецФункции

&НаКлиенте
Процедура ПослеОптимизацииПлатежногоКалендаря(ДлительнаяОперация, ДополнительныеПараметры) Экспорт
	
	Если ДлительнаяОперация = Неопределено Тогда // отмена пользователем
		// очищаем от возможных остатков оптимизации
		УдалитьТекущуюОптимизациюКалендаря();
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		
		ПослеОптимизацииПлатежногоКалендаряСервер(ДлительнаяОперация.АдресРезультата);
		ПослеФормированияНаКлиенте(); // обновляем отображение календаря после оптимизации
		
		ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");
		
	ИначеЕсли ДлительнаяОперация.Статус = "Ошибка" Тогда	
		
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибка оптимизации платежного календаря: %1'"), ДлительнаяОперация.КраткоеПредставлениеОшибки);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеОптимизацииПлатежногоКалендаряСервер(АдресРезультата)
	
	УдалитьПрогнозныеОперацииОптимизации();
	
	НовыеОперации = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Для Каждого НоваяОперация Из НовыеОперации Цикл
		СтрокаОперации = ПрогнозныеОперации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОперации, НоваяОперация);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НовыеОперации) Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	ПриИзмененииПрогнозныхОпераций();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьТекущуюОптимизациюКалендаря()
	
	ОптимизацияПлатежногоКалендаря.ОтменитьОптимизациюКалендаря(Пользователи.ТекущийПользователь());
	УдалитьПрогнозныеОперацииОптимизации();
		
КонецПроцедуры

&НаСервере
Процедура УдалитьПрогнозныеОперацииОптимизации()
	
	ОтборОптимизация = Новый Структура("Оптимизация", Истина);	
	МассивОперацийОптимизации = ПрогнозныеОперации.НайтиСтроки(ОтборОптимизация);
	Для каждого СтрокаОперация Из МассивОперацийОптимизации Цикл
		ПрогнозныеОперации.Удалить(СтрокаОперация);
	КонецЦикла;
	
	ПриИзмененииПрогнозныхОпераций();
	
КонецПроцедуры

&НаСервере
Функция ТаблицаЗапланированныхКредитов()
	
	ТабРезультат = Новый ТаблицаЗначений;
	ТабРезультат.Колонки.Добавить("ДоговорКонтрагента", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТабРезультат.Колонки.Добавить("Сумма", ОбщегоНазначения.ОписаниеТипаЧисло(18, 2));
	ТабРезультат.Колонки.Добавить("ДатаНачала", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТабРезультат.Колонки.Добавить("ДатаОкончания", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
	// Найдем активные операции соответствующего вида.
	СтруктураОтбораОпераций = Новый Структура;
	СтруктураОтбораОпераций.Вставить("Активна", Истина);
	СтруктураОтбораОпераций.Вставить("ВидОперации", Перечисления.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования);
	
	Операции = ПрогнозныеОперации.НайтиСтроки(СтруктураОтбораОпераций);
	
	Для Каждого ТекОперация Из Операции Цикл
		Сделка = ТабРезультат.Добавить();
		Сделка.ДоговорКонтрагента = ТекОперация.УточнениеОперации.ФинансовыйИнструмент;
		Сделка.Сумма = ТекОперация.УточнениеОперации.Сумма;
		Сделка.ДатаНачала = ТекОперация.УточнениеОперации.ПериодИспользования.ДатаНачала;
		Сделка.ДатаОкончания = ТекОперация.УточнениеОперации.ПериодИспользования.ДатаОкончания;
	КонецЦикла;
	
	Возврат ТабРезультат;

КонецФункции

&НаСервере
Функция ПараметрыОтчета()
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ПериодОтбора", Отчет.ПериодОтбора);	
	ПараметрыОтчета.Вставить("СохраненнаяВерсияПлатежногоКалендаря", Отчет.СохраненнаяВерсияПлатежногоКалендаря);
	ПараметрыОтчета.Вставить("ГоризонтОперативногоПланирования", Отчет.ГоризонтОперативногоПланирования);
    ПараметрыОтчета.Вставить("ПроизводственныйКалендарь", Отчет.ПроизводственныйКалендарь);
	ПараметрыОтчета.Вставить("ПлановыеКурсы", Отчет.ПлановыеКурсы.Выгрузить());
	ПараметрыОтчета.Вставить("МатрицаВесовЛиквидности", Отчет.МатрицаВесовЛиквидности.Выгрузить());
	ПараметрыОтчета.Вставить("ЗапланированныеКредиты", ТаблицаЗапланированныхКредитов());
	
	НастройкиОтчета = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыОтчета.Вставить("НастройкаОтбора", НастройкиОтчета.Отбор);
	
	ПараметрыОтчета.Вставить("ТекущийПользователь", Пользователи.ТекущийПользователь());
	
	Возврат ПараметрыОтчета;
	
КонецФункции

&НаСервере
Функция НастройкиОптимизации()
	
	НастройкиОптимизации = ОптимизацияПлатежногоКалендаря.НовыеНастройкиОптимизации();
	ВариантыОптимизации = НастройкиОптимизации.ВариантыОптимизации;
	Для Каждого Строка Из Отчет.НастройкаВариантовОптимизации Цикл
		Если Строка.Используется Тогда
			 ВариантыОптимизации.Добавить(Строка.ВариантОптимизации);
		КонецЕсли;
	КонецЦикла;	
	
	НастройкиОптимизации.СтоимостьПереводаМеждуСчетами = Отчет.СтоимостьПереводаМеждуСчетами;
	НастройкиОптимизации.ПроцентКомиссииПриКонвертацииВалюты = Отчет.ПроцентКомиссииПриКонвертацииВалюты;
	НастройкиОптимизации.СущественнаяРазницаСтоимостиКредитов = Отчет.СущественнаяРазницаСтоимостиКредитов;
	
	Возврат НастройкиОптимизации;
	
КонецФункции	

&НаСервереБезКонтекста
Процедура ВыполнитьОптимизациюПлатежногоКалендаря(СостояниеКалендаря, НастройкиОптимизации)
	
	ОптимизацияПлатежногоКалендаря.ВыполнитьОптимизациюПлатежногоКалендаря(СостояниеКалендаря, НастройкиОптимизации);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиОптимизации()
	
	МассивВариантов = ОптимизацияПлатежногоКалендаря.МассивДоступныхВариантовОптимизации();
	Для каждого Вариант Из МассивВариантов Цикл
		СтрокаВариант = Отчет.НастройкаВариантовОптимизации.Добавить();
		СтрокаВариант.ВариантОптимизации = Вариант;
		СтрокаВариант.Используется = Истина;
	КонецЦикла;
	
	Отчет.СтоимостьПереводаМеждуСчетами = Константы.СтоимостьПереводаМеждуСчетами.Получить();
	Отчет.ПроцентКомиссииПриКонвертацииВалюты = Константы.ПроцентКомиссииПриКонвертацииВалюты.Получить();
	Отчет.СущественнаяРазницаСтоимостиКредитов = Константы.СущественнаяРазницаСтоимостиКредитов.Получить();
	
	НаименованиеВалюты = СокрЛП(Константы.ВалютаРегламентированногоУчета.Получить().Наименование);
	Элементы.ДекорацияСтоимостьПереводаМеждуСчетамиВалюта.Заголовок = НаименованиеВалюты;
	Элементы.ДекорацияСущественнаяРазницаСтоимостиКредитовВалюта.Заголовок = НаименованиеВалюты;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантыОптимизации(СохраненныеВариантыОптимизации)
	
	Если СохраненныеВариантыОптимизации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из Отчет.НастройкаВариантовОптимизации Цикл
		СохрСтрока = СохраненныеВариантыОптимизации.Найти(Строка.ВариантОптимизации, "ВариантОптимизации");
		Если СохрСтрока <> Неопределено Тогда
			Строка.Используется = СохрСтрока.Используется;
		Иначе
			Строка.Используется = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьИсточникиДанных(СохраненныеИсточникиДанных = Неопределено)
	
	Если СохраненныеИсточникиДанных = Неопределено Тогда
		
		ЗаполнитьИспользуемыеИсточникиДанных();
		
	ИначеЕсли ТипЗнч(СохраненныеИсточникиДанных) = Тип("Строка") Тогда
		
		ИсточникиДанных.Загрузить(ПолучитьИзВременногоХранилища(СохраненныеИсточникиДанных));	
		
	Иначе
		
		Если ИспользуемыеИсточникиДанныхИзменены(СохраненныеИсточникиДанных) Тогда
			ЗаполнитьИспользуемыеИсточникиДанных();
		КонецЕсли;
		
	КонецЕсли;
	
	ВывестиИсточникиДанных();
	
	ТаблицаВесов = РегистрыСведений.МатрицаВесовЛиквидности.ЛинейнаяТаблицаВесовЛиквидности(ИсточникиДанных);  
	ВосстановитьТаблицуВесов(ТаблицаВесов, МатрицаВесов.Выгрузить());
	
	Отчет.МатрицаВесовЛиквидности.Загрузить(ТаблицаВесов);
	МатрицаВесов.Загрузить(РегистрыСведений.МатрицаВесовЛиквидности.КроссТаблицаВесовЛиквидности(ТаблицаВесов));
	
КонецПроцедуры  

&НаСервере
Процедура ВосстановитьТаблицуВесов(ТаблицаВесов, МатрицаВесов)
	
	Если Не МатрицаВесов.Количество() = 0 Тогда
		
		Для Каждого СтрокаТаблицы Из ТаблицаВесов Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.Вес) Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяГоризонта = ОбщегоНазначения.ИмяЗначенияПеречисления(СтрокаТаблицы.ГоризонтПланированияЛиквидности);	
			ИмяПриходРасход = ОбщегоНазначения.ИмяЗначенияПеречисления(СтрокаТаблицы.ПриходРасход);
			
			ИмяКолонки = ИмяГоризонта + "_" + ИмяПриходРасход;			
			КолонкаПоиска = МатрицаВесов.Колонки.Найти(ИмяКолонки);
			
			Если КолонкаПоиска = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НайденнаяСтрока = МатрицаВесов.Найти(СтрокаТаблицы.Источник, "Источник");
			
			Если НайденнаяСтрока = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НайденнаяСтрока[ИмяКолонки]) Тогда
				НайденнаяСтрока[ИмяКолонки] = СтрокаТаблицы.Вес;	
			КонецЕсли;			
			
		КонецЦикла;
		
	КонецЕсли;	
	
	КроссТаблицаВесов = РегистрыСведений.МатрицаВесовЛиквидности.ПреобразоватьКроссТаблицуВЛинейнуюТаблицу(МатрицаВесов);
	
	Для Каждого СтрокаТаблицы Из ТаблицаВесов Цикл  
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Источник");
		СтруктураОтбора.Вставить("ПриходРасход");
		СтруктураОтбора.Вставить("ГоризонтПланированияЛиквидности");
		
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаТаблицы);
		
		НайдСтроки = КроссТаблицаВесов.НайтиСтроки(СтруктураОтбора);
		Если НайдСтроки.Количество() Тогда 			
			СтрокаТаблицы.Вес = НайдСтроки[0].Вес;			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиИсточникиДанных()
	
	МассивИсточниковДанных = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ИсточникиДанных Цикл
		
		Если СтрокаТаблицы.Поступления Или СтрокаТаблицы.Списания Тогда 
			
			МассивИсточниковДанных.Добавить(СтрокаТаблицы.ИсточникДанных);	
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИсточникиДанныхСтрока = СтрСоединить(МассивИсточниковДанных,","); 	
	
	Если Не ЗначениеЗаполнено(ИсточникиДанныхСтрока) Тогда 
		ИсточникиДанныхСтрока = НСтр("ru = '<Источники данных не выбраны>'");	
	КонецЕсли;
	
	ИсточникиДанныхПредставление = ИсточникиДанныхСтрока;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОптимизациюПлатежногоКалендаря(Команда)
	
	ДлительнаяОперация = ОтменитьОптимизациюПлатежногоКалендаряНаСервере();
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибка отмены оптимизации платежного календаря: %1'"), ДлительнаяОперация.КраткоеПредставлениеОшибки);	
		
	Иначе
		НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		НастройкиОжидания.ВыводитьОкноОжидания = Истина;
		НастройкиОжидания.ТекстСообщения = НСтр("ru = 'Выполняется отмена оптимизация платежного календаря'");
		
		Обработчик = Новый ОписаниеОповещения("ПослеОтменыОптимизацииПлатежногоКалендаря", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Обработчик, НастройкиОжидания);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОтменитьОптимизациюПлатежногоКалендаряНаСервере()
	
	НастройкиЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	НастройкиЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Отмена оптимизации платежного календаря'", ОбщегоНазначения.КодОсновногоЯзыка());
	НастройкиЗапуска.ЗапуститьВФоне = Истина;
	НастройкиЗапуска.ОжидатьЗавершение = 0;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТекущийПользователь", Пользователи.ТекущийПользователь());
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ОптимизацияПлатежногоКалендаря.ОтменитьОптимизациюПлатежногоКалендаряВФоне",
		СтруктураПараметров,
		НастройкиЗапуска);
		
КонецФункции

&НаСервере
Процедура УдалитьОптимизациюСинхронно()
	
	УдалитьТекущуюОптимизациюКалендаря();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтменыОптимизацииПлатежногоКалендаря(ДлительнаяОперация, ДополнительныеПараметры) Экспорт
	
	Если ДлительнаяОперация = Неопределено Тогда // отмена пользователем
		// удаляем принудительно оптимизацию для согласованного состояния календаря
		УдалитьОптимизациюСинхронно();
		ПослеФормированияНаКлиенте();  
		ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность"); 
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		
		ПослеОтменыОптимизацииПлатежногоКалендаряСервер();
		ПослеФормированияНаКлиенте(); // обновляем отображение календаря после оптимизации
		ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность"); 
		
	ИначеЕсли ДлительнаяОперация.Статус = "Ошибка" Тогда	
		
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибка отмены оптимизации платежного календаря: %1'"), ДлительнаяОперация.КраткоеПредставлениеОшибки);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеОтменыОптимизацииПлатежногоКалендаряСервер()
	
	УдалитьПрогнозныеОперацииОптимизации();

КонецПроцедуры

&НаСервере
Процедура ОстановитьПлатежиНаСервере(АдресМассиваПлатежей, Знач Расшифровка)
	
	Данные = ПолучитьИзВременногоХранилища(АдресМассиваПлатежей);
	
	ОтправитьВСтопЛистНаСервере(Данные.ПозицииВСтопЛист, Расшифровка);
	
	Для Каждого ТекПозицияКПереносу Из Данные.ПозицииКПереносу Цикл
		
		Позиции = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекПозицияКПереносу.ИдентификаторПозиции);
		РазместитьПозиции(Позиции, ТекПозицияКПереносу.ДатаПереноса);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеОперации(СтруктураПараметров)
	
	ВидОперации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "ВидОперации");
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.НовыйДоговорКредита") Тогда
		ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Новый договор кредита на сумму %1 %2 сроком %3'"),
								СтруктураПараметров.Сумма, 
								СтруктураПараметров.Валюта, 
								СтроковыеФункцииКлиентСервер.ЧислоЦифрамиПредметИсчисленияПрописью(СтруктураПараметров.КоличествоДней, НСтр("ru = 'день,дня,дней'"))		
								);
								
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.НовыйДоговорДепозита") Тогда
		ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Новый договор депозита на сумму %1 %2 сроком %3'"),
								СтруктураПараметров.Сумма, 
								СтруктураПараметров.Валюта, 
								СтроковыеФункцииКлиентСервер.ЧислоЦифрамиПредметИсчисленияПрописью(СтруктураПараметров.КоличествоДней, НСтр("ru = 'день,дня,дней'"))		
								);

	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПогашениеКредита") Тогда
		
		ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Погашение кредита %1 на сумму %2 %3'"),
		                        СтруктураПараметров.ФинансовыйИнструмент,
								СтруктураПараметров.Сумма,
								СтруктураПараметров.Валюта
								);
								
	Иначе
		ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Транш инструмента %1 на сумму %2 %3 сроком %4'"),
								СтруктураПараметров.ФинансовыйИнструмент,
								СтруктураПараметров.Сумма, 
								СтруктураПараметров.Валюта, 
								СтроковыеФункцииКлиентСервер.ЧислоЦифрамиПредметИсчисленияПрописью(СтруктураПараметров.КоличествоДней, НСтр("ru = 'день,дня,дней'")
								));
		
	КонецЕсли;
	
	Возврат ПредставлениеОперации;
	
КонецФункции

&НаСервере
Процедура СоздатьНовыйДоговорКредита(Операция,УспешныеОперации)
	
	Если ИспользоватьЗаявкиНаПривлечениеФинансирования Тогда
	    СоздатьПокрытиеПотребностиВФинансировании(Операция,УспешныеОперации);
	Иначе
		СоздатьНовыйВерсияСоглашенияКредит(Операция,УспешныеОперации);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьНовыйВерсияСоглашенияКредит(Операция,УспешныеОперации)
	
	СтруктураЗаполнения = СтруктураЗаполненияКредита(Операция);	
	
	ВерсияСоглашения = Документы.ВерсияСоглашенияКредит.СоздатьДокумент();
	ВерсияСоглашения.Дата = ТекущаяДатаСеанса();
	ВерсияСоглашения.Заполнить(СтруктураЗаполнения);
	ВерсияСоглашения.ДополнительныеСвойства.Вставить(
		"ЗначенияЗаполненияДоговора",
		Новый Структура("Наименование", Операция.УточнениеОперации.НаименованиеДоговора));    
    ВерсияСоглашения.ГрафикРасчетов.Очистить();
	СтруктураДействий = Новый Структура;
	Секции = Новый Массив;
	Секции.Добавить("ОсновнойДолг");
	Секции.Добавить("Проценты");
	СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика", Секции));
	ОписаниеГрафика = Документы.ВерсияСоглашенияКредит.ОписаниеГрафика(ВерсияСоглашения.ВидДоговораУХ);
	ОперацииГрафика = РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафика, ВерсияСоглашения);
	ФинансовыеИнструментыУХ.ПересчетГрафика(ВерсияСоглашения, 0, ОписаниеГрафика, ОперацииГрафика, СтруктураДействий);
			
	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = НСтр("ru = 'Создание договора кредита'");	
	
	Попытка              
		ВерсияСоглашения.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполненияОперации.ОбъектСистемы = ВерсияСоглашения.Ссылка; 
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);		
		
	УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВСостояниеУтверждена(ВерсияСоглашения.Ссылка); 
	
КонецПроцедуры

&НаСервере
Процедура СоздатьПокрытиеПотребностиВФинансировании(Операция,УспешныеОперации)
	
	СтруктураЗаполнения = СтруктураЗаполненияКредита(Операция);	

	ДокументПокрытия 		= Документы.ПокрытиеПотребностиВФинансировании.СоздатьДокумент();
	ДокументПокрытия.Дата 	= ТекущаяДатаСеанса();
	ЗаполнитьЗначенияСвойств(ДокументПокрытия, СтруктураЗаполнения);
	ДокументПокрытия.СуммаДокумента 		= СтруктураЗаполнения.Сумма;
	ДокументПокрытия.Записать();
		
	ДокументПокрытия.ОсновнойВариантФинансирования = Справочники.ВариантыФинансирования.СоздатьВариантФинансированияПокрытия(ДокументПокрытия.Ссылка, 
															СтруктураЗаполнения, Операция.УточнениеОперации.НаименованиеДоговора);
	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = НСтр("ru = 'Создание договора покрытия потребностей финансирования'");	
	
	Попытка              
		ДокументПокрытия.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполненияОперации.ОбъектСистемы = ДокументПокрытия.Ссылка; 
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);		
		
	УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВСостояниеУтверждена(ДокументПокрытия.Ссылка); 
	
КонецПроцедуры

&НаСервере
Функция СтруктураЗаполненияКредита(Операция)
	
	СтруктураЗаполнения = Новый Структура;
	
	СтруктураЗаполнения.Вставить("ВидДоговораУХ", 			Справочники.ВидыДоговоровКонтрагентовУХ.Кредит);
	СтруктураЗаполнения.Вставить("Организация", 			Операция.УточнениеОперации.Организация);
	СтруктураЗаполнения.Вставить("Контрагент", 				Операция.УточнениеОперации.Контрагент);
	СтруктураЗаполнения.Вставить("ДатаНачалаДействия", 		Операция.УточнениеОперации.ПериодИспользования.ДатаНачала);
	СтруктураЗаполнения.Вставить("ДатаОкончанияДействия", 	Операция.УточнениеОперации.ПериодИспользования.ДатаОкончания);
	СтруктураЗаполнения.Вставить("Сумма", 					Операция.УточнениеОперации.Сумма);
	СтруктураЗаполнения.Вставить("ПроцентнаяСтавка", 		Операция.УточнениеОперации.ПроцентнаяСтавка);
	СтруктураЗаполнения.Вставить("БанковскийСчет", 			Операция.УточнениеОперации.БанковскийСчетКасса);
	СтруктураЗаполнения.Вставить("ВалютаДокумента",			Операция.УточнениеОперации.Валюта);
	СтруктураЗаполнения.Вставить("ВалютаВзаиморасчетов",	Операция.УточнениеОперации.Валюта);
	СтруктураЗаполнения.Вставить("ОсновнаяВалютаПлатежей",	Операция.УточнениеОперации.Валюта);
	СтруктураЗаполнения.Вставить("ИспользоватьГрафикРасчетов", Истина);
	
	Возврат СтруктураЗаполнения;   
	
КонецФункции

