	РезультатПроверки = ОперацияИзмененаНовойОперацией(ТекДанные.ИдентификаторОперации);
	Если РезультатПроверки.ОперацияИзменена Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Текущая операция изменена новой операцией: %1
                   							  |Cначала удалите новую операцию для редактирования текущей'"), РезультатПроверки.ПредставлениеОперации);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ТекДанные.Активна = НЕ ТекДанные.Активна;
		Возврат;
	КонецЕсли;
	
	ИзменитьАктивностьДвиженийИнструмента(ТекДанные.ИдентификаторОперации);
	ОбновитьДанныеНаСервере();
	
	АктивизироватьТекущуюОбласть();
	
КонецПроцедуры

