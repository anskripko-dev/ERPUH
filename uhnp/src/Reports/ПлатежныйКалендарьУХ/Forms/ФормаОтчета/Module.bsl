	ВсегоОпераций = ИдентификаторыЗаписей.Количество();
	МожноПеренести = ВыборкаЗаявокКПеремещению.Количество();
	
	Если ТипЗнч(БанковскийСчетКасса) = ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций() Тогда
		НовыйСчетЗакрыт = ?(ЗначениеЗаполнено(БанковскийСчетКасса), 
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БанковскийСчетКасса, "Закрыт"),
			Неопределено);
	Иначе
		НовыйСчетЗакрыт = Ложь;	
	КонецЕсли;
	
	Пока ВыборкаЗаявки.Следующий() Цикл
		
		Если НЕ ПроверитьДопустимостьПеремещенияЗаявки(ВыборкаЗаявки.Инструмент, БанковскийСчетКасса, НовыйСчетЗакрыт) Тогда
			МожноПеренести = МожноПеренести - 1;
			Продолжить;
		КонецЕсли;
			
		ИсходнаяЗапись = Неопределено;
		Если ЗначениеЗаполнено(ВыборкаЗаявки.ИдентификаторДобавившейОперации) Тогда
			ИсходнаяЗапись = ТаблицаИсходныхОпераций.Найти(ВыборкаЗаявки.ИдентификаторДобавившейОперации, "ИдентификаторОтменившейОперации");
		КонецЕсли;
		
		Если ИсходнаяЗапись <> Неопределено Тогда
			
			НоваяЗапись = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаЗаявки);
			НоваяЗапись.Прочитать();
						
			ИзменитьДатуСчетЗаписиЗаявки(НоваяЗапись, Сдвиг, БанковскийСчетКасса, РеквизитыСчетаКассы);
			Операция = НайтиОперациюПоИдентификатору(НоваяЗапись.ИдентификаторДобавившейОперации);
			Если Не Операция = Неопределено И Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПеремещениеЗаявки Тогда
				Если НоваяЗапись.Дата = ИсходнаяЗапись.Дата И НоваяЗапись.БанковскийСчетКасса = ИсходнаяЗапись.БанковскийСчетКасса Тогда
					// удаляем операцию и восстанавливаем исходную запись, так как ничего не поменялось
					ПрогнозныеОперации.Удалить(Операция);
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаЗаявки);
					НоваяЗапись.Удалить();
					
					СтараяЗапись = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(СтараяЗапись, ИсходнаяЗапись);
					
					СтараяЗапись.Прочитать();
					СтараяЗапись.ИдентификаторОтменившейОперации = ОбщегоНазначенияКлиентСерверУХ.ПустойУникальныйИдентификатор();
					СтараяЗапись.Активна = Истина;   
					ПереоценитьПредставлениеПлатежногоКалендаря(СтараяЗапись);
					СтараяЗапись.Записать();
				Иначе
					ЗаполнитьОперациюПеремещения(Операция, ИсходнаяЗапись, НоваяЗапись); 
					ПереоценитьПредставлениеПлатежногоКалендаря(НоваяЗапись); 
					НоваяЗапись.Записать();
				КонецЕсли;
			Иначе
				// сохраняем название другой операции, например разделение заявки
				НоваяЗапись.Записать();
			КонецЕсли;
			
		Иначе
			
			ИдентификаторОперации = Новый УникальныйИдентификатор;
			
			СтараяЗапись = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(СтараяЗапись, ВыборкаЗаявки);
			СтараяЗапись.Прочитать();
						
			НоваяЗапись = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтараяЗапись);
			НоваяЗапись.ИдентификаторДобавившейОперации = ИдентификаторОперации;
			
			ИзменитьДатуСчетЗаписиЗаявки(НоваяЗапись, Сдвиг, БанковскийСчетКасса, РеквизитыСчетаКассы);
			Если НоваяЗапись.Дата = СтараяЗапись.Дата И НоваяЗапись.БанковскийСчетКасса = СтараяЗапись.БанковскийСчетКасса Тогда
				Продолжить; // ничего не поменялось
			КонецЕсли; 
			
			ПереоценитьПредставлениеПлатежногоКалендаря(НоваяЗапись);
			
			НоваяЗапись.Оптимизация = Истина;

			НоваяЗапись.Записать();
			
			СтараяЗапись.ИдентификаторОтменившейОперации = ИдентификаторОперации;
			СтараяЗапись.Активна = Ложь;
			СтараяЗапись.Записать();
			
			Операция = ПрогнозныеОперации.Добавить();
			ЗаполнитьОперациюПеремещения(Операция, СтараяЗапись, НоваяЗапись);
			
			// если у текущей записи есть новая запись и она не активна, то удаляем ее и операцию
			Если ЗначениеЗаполнено(ВыборкаЗаявки.ИдентификаторОтменившейОперации) Тогда
				НоваяНеактивнаяЗапись = ТаблицаНовыхНеАктивныхОпераций.Найти(ВыборкаЗаявки.ИдентификаторОтменившейОперации, "ИдентификаторДобавившейОперации");	
				Если НоваяНеактивнаяЗапись <> Неопределено Тогда	
					МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(МЗ, НоваяНеактивнаяЗапись);
					МЗ.Удалить();
					
					Операция = НайтиОперациюПоИдентификатору(НоваяНеактивнаяЗапись.ИдентификаторДобавившейОперации);
					ПрогнозныеОперации.Удалить(Операция);	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	ОписаниеВозможныхОшибок = НСтр("ru = 'Вероятные причины:
	|- операция является неуправляемой (например, уже помещена в реестр платежей, или же денежные средства будут списаны безакцептно); 
	|- операция не может быть размещена на выбранном счете (не совпадают валюты, счет принадлежит другой организации, счет закрыт или же платеж обязательно должен быть отправлен с текущего счета).'");
	
	Если МожноПеренести = 0 Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Невозможно перенести ни одну выбранную операцию.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ШаблонТекстаОшибки + Символы.ПС + ОписаниеВозможныхОшибок);
	ИначеЕсли МожноПеренести <> ВсегоОпераций Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Перенесены только допустимые операции (%1 из %2)'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонТекстаОшибки, МожноПеренести, ВсегоОпераций) + Символы.ПС + ОписаниеВозможныхОшибок);
	КонецЕсли;
	
	Если МожноПеренести > 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	ПриИзмененииПрогнозныхОпераций();
	ОбновитьДанныеНаСервере(); 
	
КонецПроцедуры

&НаСервере
Процедура ВернутьЗаявкиИзСтопЛиста(Знач ИдентификаторыСтрокОпераций, Знач ЦелеваяДата, Знач ЦелевойБанковскийСчетКасса = Неопределено, Знач Расшифровка = Неопределено)
	
	ОперацииКОтмене = Новый Массив;
	ИдентификаторыПозицийКДобавлению = Новый Массив;
	КоличествоНекорректныхПозиций = 0;
	
	Если ЦелевойБанковскийСчетКасса <> Неопределено Тогда
		ПараметрыЦелевогоСчетаКассы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦелевойБанковскийСчетКасса, Новый Структура("Организация,Валюта","Владелец","ВалютаДенежныхСредств"));
	КонецЕсли;
	
	Для Каждого ТекИД Из ИдентификаторыСтрокОпераций Цикл
		ДанныеСтроки = СтопЛист.НайтиПоИдентификатору(ТекИД); 		
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;		
		Если ПараметрыЦелевогоСчетаКассы <> Неопределено И (ДанныеСтроки.Организация <> ПараметрыЦелевогоСчетаКассы.Организация Или ДанныеСтроки.Валюта <> ПараметрыЦелевогоСчетаКассы.Валюта) Тогда
			// Позицию на этот счет вернуть нельзя.
			КоличествоНекорректныхПозиций = КоличествоНекорректныхПозиций + 1;
			
		ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторОперации) Тогда
			ОперацииКОтмене.Добавить(ДанныеСтроки.ИдентификаторОперации);
		Иначе
			ИдентификаторыПозицийКДобавлению.Добавить(ДанныеСтроки.ИдентификаторЗаписи);
		КонецЕсли;
	КонецЦикла;
	
	КоличествоПозицийВсего = ИдентификаторыСтрокОпераций.Количество();
	ПозицийКОбработке = КоличествоПозицийВсего - КоличествоНекорректныхПозиций;
	Если ПозицийКОбработке = 0 Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Невозможно перенести на выбранный счет ни одну выбранную операцию - не совпадает организация или валюта.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ШаблонТекстаОшибки);
		Возврат;
	ИначеЕсли ПозицийКОбработке <> КоличествоПозицийВсего Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Перенесены только допустимые операции (%1 из %2)- не совпадает организация или валюта.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонТекстаОшибки, ПозицийКОбработке, КоличествоПозицийВсего));
	КонецЕсли;
	
	Для Каждого ИдентификаторОперации Из ОперацииКОтмене Цикл
		
		ОперацииВТаблице = ПрогнозныеОперации.НайтиСтроки(Новый Структура("ИдентификаторОперации", ИдентификаторОперации));
		Если ОперацииВТаблице.Количество() Тогда
			ОперацииВТаблице[0].Активна = НЕ ОперацииВТаблице[0].Активна;
			ИзменитьАктивностьДвиженийИнструмента(ИдентификаторОперации, ЦелеваяДата, ЦелевойБанковскийСчетКасса);
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьПлатежиИзСтопЛиста(ИдентификаторыПозицийКДобавлению, ЦелеваяДата, ЦелевойБанковскийСчетКасса);
	
	Модифицированность = Истина;
	
	ОбновитьДанныеНаСервере(); 
	
	ВывестиДеталиНаСервере(Расшифровка);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПлатежиИзСтопЛиста(ИдентификаторыПозицийКДобавлению, ЦелеваяДата, ЦелевойБанковскийСчетКасса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИСТИНА КАК Активна,
	|	&Пользователь КАК Пользователь,
	|	ДокументЗаявка.Ссылка КАК Инструмент,
	|	&ЦелевойБанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ДокументЗаявка.ВалютаОплаты КАК Валюта,
	|	&Банк КАК Банк,
	|	&ЦелеваяДата КАК Дата,
	|	&ПулЛиквидности КАК ПулЛиквидности,
	|	ВЫБОР
	|		КОГДА РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|			ТОГДА РазмещениеЗаявок.Сумма
	|		ИНАЧЕ -РазмещениеЗаявок.Сумма
	|	КОНЕЦ КАК Сумма,
	|	ДокументЗаявка.Организация КАК Организация,
	|	ДокументЗаявка.Приоритет КАК Приоритет,
	|	ВЫБОР
	|		КОГДА РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.ПоступлениеСредств)
	|		КОГДА ДокументЗаявка.БезакцептноеСписание
	|				ИЛИ ЕСТЬNULL(СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения, ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.НеОбработана)) <> ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.НеОбработана)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.СписаниеСредств)
	|	КОНЕЦ КАК РазделПлатежногоКалендаря,
	|	ДокументЗаявка.КрайняяДата КАК КрайняяДата,
	|	ДокументЗаявка.ФиксированныйСчетОрганизации КАК ФиксированныйБанковскийСчет,
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторЗаписи,
	|	ВЫБОР
	|		КОГДА РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта = ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Утверждена)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиДанныхПлатежногоКалендаря.ЗаявкиУтвержденные)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ИсточникиДанныхПлатежногоКалендаря.ЗаявкиНеутвержденные)
	|	КОНЕЦ КАК ИсточникДанных,
	|	СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения КАК СостояниеИсполнения,
	|	ВЫБОР
	|		КОГДА РазмещениеЗаявок.БанковскийСчетКасса ССЫЛКА Справочник.Кассы
	|			ТОГДА ЗНАЧЕНИЕ(перечисление.ФормыОплаты.Наличная)
	|		ИНАЧЕ ЗНАЧЕНИЕ(перечисление.ФормыОплаты.Безналичная)
	|	КОНЕЦ КАК ВидДенежныхСредств
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ДокументЗаявка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних КАК РегистрСостоянийОбъектовСрезПоследних
	|		ПО ДокументЗаявка.Ссылка = РегистрСостоянийОбъектовСрезПоследних.Объект
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних КАК СостоянияИсполненияДокументовПланированияСрезПоследних
	|			ПО РазмещениеЗаявок.ИдентификаторПозиции = СостоянияИсполненияДокументовПланированияСрезПоследних.ИдентификаторПозиции
	|				И РазмещениеЗаявок.ЗаявкаНаОперацию = СостоянияИсполненияДокументовПланированияСрезПоследних.ДокументПланирования
	|		ПО ДокументЗаявка.Ссылка = РазмещениеЗаявок.ЗаявкаНаОперацию
	|ГДЕ
	|	РазмещениеЗаявок.ИдентификаторПозиции В(&ИдентификаторыПозиций)
	|	И &ДопУсловие";
		
	Если ЗначениеЗаполнено(ЦелевойБанковскийСчетКасса) Тогда
		
		РеквизитыБанковскогоСчетаКассы = Отчеты.ПлатежныйКалендарьУХ.ПолучитьДанныеБанковскогоСчетаКассы(ЦелевойБанковскийСчетКасса);
		
		Запрос.УстановитьПараметр("ЦелевойБанковскийСчетКасса", ЦелевойБанковскийСчетКасса);
		Запрос.УстановитьПараметр("Банк", РеквизитыБанковскогоСчетаКассы.Банк);  
		Запрос.УстановитьПараметр("Валюта", РеквизитыБанковскогоСчетаКассы.Валюта);
		Запрос.УстановитьПараметр("Организация", РеквизитыБанковскогоСчетаКассы.Организация);
		Запрос.УстановитьПараметр("ПулЛиквидности", РеквизитыБанковскогоСчетаКассы.ПулЛиквидности);   

		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДопУсловие","ДокументЗаявка.ВалютаОплаты = &Валюта
																|	И ДокументЗаявка.Организация = &Организация");

	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДопУсловие","ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ЦелевойБанковскийСчетКасса","РазмещениеЗаявок.БанковскийСчетКасса");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Банк","РазмещениеЗаявок.БанковскийСчетКасса.Банк");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ПулЛиквидности","РазмещениеЗаявок.БанковскийСчетКасса.ПулЛиквидности");

	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЦелеваяДата", ЦелеваяДата);
	Запрос.УстановитьПараметр("ИдентификаторыПозиций", ИдентификаторыПозицийКДобавлению);
	Запрос.УстановитьПараметр("Пользователь", Отчет.Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяОперация = ПрогнозныеОперации.Добавить();
		НоваяОперация.Активна = истина;
		НоваяОперация.ИдентификаторОперации = Новый УникальныйИдентификатор;
		НоваяОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ВозвратИзСтопЛиста;
		НоваяОперация.УточнениеОперации = Выборка.ИдентификаторЗаписи;
		НоваяОперация.ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Возврат из стоп-листа %1'"), Выборка.Инструмент);
		НоваяОперация.ОрганизацияСписания = Выборка.Организация;
		НоваяОперация.БанкСписания = Выборка.Банк;
		НоваяОперация.БанковскийСчетКассаСписания = Выборка.БанковскийСчетКасса;
		НоваяОперация.ВалютаСписания = Выборка.Валюта;
		НоваяОперация.ДатаСписания = Выборка.Дата;
		НоваяОперация.ВидДенежныхСредств = Выборка.ВидДенежныхСредств;
		
		МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Выборка);
		МЗ.ИдентификаторДобавившейОперации = НоваяОперация.ИдентификаторОперации;
		МЗ.Записать();
	КонецЦикла;
	
	ПриИзмененииПрогнозныхОпераций(); 
	ОбновитьСтопЛист();
	
КонецПроцедуры

// Записывает ТаблицаПлановыхКурсовВход в таблицу отображения курсов на форме.
&НаСервере
Процедура ЗаписатьТаблицуПлановыхКурсовВОтображение(ТаблицаПлановыхКурсовВход)
	// Инициализация.
	ОписаниеТиповЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(10, 4);
	ОписаниеТиповСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Добавление колонок в таблицу отображение.
	ВыгрузкаСверткаДаты = ТаблицаПлановыхКурсовВход.Скопировать(,"Период");
	ВыгрузкаСверткаДаты.Свернуть("Период");
	
	// Найдем, какие колонки надо удалить.
	РеквизитыФормыКУдалению = Новый Массив;
	ЭлементыСоответствияКУдалению = Новый Массив;
	
	Для Каждого ТекЭлементСоответствия Из ТаблицаСоответствияДатСтолбцам Цикл
		Если ВыгрузкаСверткаДаты.Найти(ТекЭлементСоответствия.ДатаТаблицы,"Период") = Неопределено Тогда
			РеквизитыФормыКУдалению.Добавить("ОтображениеПлановыхКурсов." + ТекЭлементСоответствия.ИмяПоляТаблицы);
			ЭлементыСоответствияКУдалению.Добавить(ТекЭлементСоответствия);
		КонецЕсли;
	КонецЦикла;
	
	// Удалим ненужные элементы формы и элементы соответствия. Удаление реквизитов произведем позднее.
	Для Каждого ТекЭлементСоответствия Из ЭлементыСоответствияКУдалению Цикл
		ТаблицаСоответствияДатСтолбцам.Удалить(ТекЭлементСоответствия);
	КонецЦикла;
	ЭлементыФормыКУдалению = Новый Массив;
	Для Каждого ТекЭлементФормы Из Элементы.ОтображениеПлановыхКурсов.ПодчиненныеЭлементы Цикл
		Если ТекЭлементФормы <> Элементы.ОтображениеПлановыхКурсовВалюта
			И ТекЭлементФормы <> Элементы.ОтображениеПлановыхКурсовКратность Тогда
			ЭлементыФормыКУдалению.Добавить(ТекЭлементФормы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекЭлементФормы Из ЭлементыФормыКУдалению Цикл
		Элементы.Удалить(ТекЭлементФормы);
	КонецЦикла;
	
	РеквизитыФормыКДобавлению = Новый Массив;
			
	Для Каждого ТекВыгрузкаСверткаДаты Из ВыгрузкаСверткаДаты Цикл
		ТекПериодСверткиДаты = ТекВыгрузкаСверткаДаты.Период;	
		
		Если ТаблицаСоответствияДатСтолбцам.НайтиСтроки(Новый Структура("ДатаТаблицы",ТекПериодСверткиДаты)).Количество() Тогда
			// Реквизит уже есть, элементы тоже.
			Продолжить;
		КонецЕсли;
		// Получим необходимые поля.
		ИмяПоляТек = "Период" + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
		
		ЗаголовокПоляТек = Отчеты.ПлатежныйКалендарьУХ.ПредставлениеДаты(ТекПериодСверткиДаты, Отчет, "ДЛФ=D");
		
		// Добавим соответствие в таблицу.
		НоваяСтрокаТаблицаСоответствие = ТаблицаСоответствияДатСтолбцам.Добавить();
		НоваяСтрокаТаблицаСоответствие.ДатаТаблицы			 = ТекПериодСверткиДаты;
		НоваяСтрокаТаблицаСоответствие.ИмяПоляТаблицы		 = ИмяПоляТек;
		
		// Сгенерируем реквизит для последующего добавления.
		РеквизитыФормыКДобавлению.Добавить(Новый РеквизитФормы(ИмяПоляТек, ОписаниеТиповЧисло, "ОтображениеПлановыхКурсов", ЗаголовокПоляТек, Ложь)); 
	КонецЦикла;
	
	// Добавим колонку отступ
	ИмяПоляТек = "ОтображениеПлановыхКурсовОтступ";
	РеквизитыФормыКДобавлению.Добавить(Новый РеквизитФормы(ИмяПоляТек, ОписаниеТиповСтрока, "ОтображениеПлановыхКурсов", , Ложь));

	// Создадим реквизиты формы
	ИзменитьРеквизиты(РеквизитыФормыКДобавлению,РеквизитыФормыКУдалению);
	ТаблицаСоответствияДатСтолбцам.Сортировать("ДатаТаблицы"); 
	
	НоваяСтрокаТаблицаСоответствие = ТаблицаСоответствияДатСтолбцам.Добавить();
	НоваяСтрокаТаблицаСоответствие.ИмяПоляТаблицы = ИмяПоляТек;

	// Добавим новые элементы.
	Для Каждого ТекРеквизит Из ТаблицаСоответствияДатСтолбцам Цикл
		НоваяКолонкаТаблицы = Элементы.Добавить("ОтображениеПлановыхКурсов" + ТекРеквизит.ИмяПоляТаблицы, Тип("ПолеФормы"), Элементы.ОтображениеПлановыхКурсов);
		
		Если ТекРеквизит.ИмяПоляТаблицы = ИмяПоляТек Тогда
			НоваяКолонкаТаблицы.Вид = ВидПоляФормы.ПолеНадписи;  
			НоваяКолонкаТаблицы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Иначе
			НоваяКолонкаТаблицы.Вид = ВидПоляФормы.ПолеВвода;
			НоваяКолонкаТаблицы.АвтоМаксимальнаяШирина = Ложь;
			НоваяКолонкаТаблицы.МаксимальнаяШирина = 9;
		КонецЕсли;
		НоваяКолонкаТаблицы.ПутьКДанным = "ОтображениеПлановыхКурсов."+ТекРеквизит.ИмяПоляТаблицы;
	КонецЦикла;
	
	// Заполнение таблицы отображение.
	СверткаВалюты = ТаблицаПлановыхКурсовВход.Скопировать();
	СверткаВалюты.Свернуть("Валюта,Кратность");
	
	ОтображениеПлановыхКурсов.Очистить();
	// Обойдём каждую валюту и создадим по ним отдельные строки в таблице отображения.
	Для Каждого ТекСверткаВалюты Из СверткаВалюты Цикл
		ЭтоПустаяВалюта = НЕ ЗначениеЗаполнено(ТекСверткаВалюты.Валюта);
		ЭтоВалютаРеглУчета = (ТекСверткаВалюты.Валюта = ВалютаРеглУчета);
		Если ЭтоПустаяВалюта ИЛИ ЭтоВалютаРеглУчета Тогда
			Продолжить; 				// Не заполняем такие строки, т.к не несут смысловой нагрузки.
		Иначе	
			НоваяСтрокаТаблицаКурсов = ОтображениеПлановыхКурсов.Добавить();
			НоваяСтрокаТаблицаКурсов.Валюта = ТекСверткаВалюты.Валюта;  
			НоваяСтрокаТаблицаКурсов.Кратность = ТекСверткаВалюты.Кратность;
			// Получим по каждой валюте список дат с курсами
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Валюта", ТекСверткаВалюты.Валюта);
			НайденныеСтрокиКурсы = ТаблицаПлановыхКурсовВход.НайтиСтроки(СтруктураПоиска);
			Для Каждого ТекНайденныеСтрокиКурсы Из НайденныеСтрокиКурсы Цикл
				НайденныеСтрокиСоответствиеДат = ТаблицаСоответствияДатСтолбцам.НайтиСтроки(Новый Структура("ДатаТаблицы", ТекНайденныеСтрокиКурсы.Период));
				// Найденные курсы перенесём в таблицу отображения.
				Если НайденныеСтрокиСоответствиеДат.Количество() > 0 Тогда
					ИмяПоля = НайденныеСтрокиСоответствиеДат[0].ИмяПоляТаблицы;
					ПриведенныйКурс = ТекНайденныеСтрокиКурсы.Курс;
					НоваяСтрокаТаблицаКурсов[ИмяПоля] = ПриведенныйКурс;
				Иначе
					// Нет исходного значения даты. Не заполняем в таблицу.
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;   
	
КонецПроцедуры

// Считывает текущие курсы валют из базы и записывает в соответствующую таблицу формы.
&НаСервере
Процедура СчитатьТаблицуПлановыхКурсов()

	Запрос = Новый Запрос;   
	Запрос.Текст = ДенежныеСредстваВстраиваниеУХ.ПолучитьТекстЗапросаПлановыхКурсовПлатежногоКалендаря(Отчет.ПериодичностьОперативногоПланирования);
	
	Запрос.УстановитьПараметр("НачалоПериодаОтбора", 				Отчет.ПериодОтбора.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериодаОтбора", 			Отчет.ПериодОтбора.ДатаОкончания);
	Запрос.УстановитьПараметр("ПустаяВалюта", 						Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("ГоризонтОперативногоПланирования", 	Отчет.ГоризонтОперативногоПланирования);
	Запрос.УстановитьПараметр("ГоризонтТактическогоПланирования", 	Отчет.ГоризонтТактическогоПланирования);
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь", 			Отчет.ПроизводственныйКалендарь);
	Запрос.УстановитьПараметр("ВалютаОтображения", 					Отчет.ВалютаОтображения);
	Запрос.УстановитьПараметр("ТабПлановыеКурсы", 					Отчет.ПлановыеКурсы.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить();
	
	ЗаписатьТаблицуПлановыхКурсовВОтображение(Выгрузка);    
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйТаблицаПлановыхКурсов()
	
	Результат = Новый ТаблицаЗначений;
	Колонки = Результат.Колонки;
	Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Колонки.Добавить("Курс", ОбщегоНазначения.ОписаниеТипаЧисло(10,4,ДопустимыйЗнак.Неотрицательный));
	Колонки.Добавить("Кратность", ОбщегоНазначения.ОписаниеТипаЧисло(10,0, ДопустимыйЗнак.Неотрицательный));
	
	Возврат Результат;
	
КонецФункции

// Преобразует таблицу отображения курсов на форме в таблицу значений и возвращает её.
&НаСервере
Функция СчитатьОтображениеПлановыхКурсов()
	
	РезультатФункции = НовыйТаблицаПлановыхКурсов();
	
	Выгрузка = ОтображениеПлановыхКурсов.Выгрузить();
	ВалютаРеглУчета = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	
	Для Каждого ТекВыгрузка Из Выгрузка Цикл
		ЭтоПустаяВалюта = Не ЗначениеЗаполнено(ТекВыгрузка.Валюта);
		ЭтоВалютаРеглУчета = (ТекВыгрузка.Валюта = ВалютаРеглУчета);
		Если ЭтоПустаяВалюта ИЛИ ЭтоВалютаРеглУчета Тогда
			Продолжить; 				// Не заполняем такие строки, т.к не несут смысловой нагрузки.
		Иначе	
			Для Каждого ТекКолонки Из Выгрузка.Колонки Цикл
				ТекЗначениеВЯчейке = ТекВыгрузка[ТекКолонки.Имя];
				Если ЗначениеЗаполнено(ТекЗначениеВЯчейке) Тогда
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("ИмяПоляТаблицы", ТекКолонки.Имя);
					НайденныеСтроки = ТаблицаСоответствияДатСтолбцам.НайтиСтроки(СтруктураОтбора);
					Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
						НоваяСтрока = РезультатФункции.Добавить();
						НоваяСтрока.Период		 = ТекНайденныеСтроки.ДатаТаблицы;
						НоваяСтрока.Валюта		 = ТекВыгрузка.Валюта;
						НоваяСтрока.Курс		 = ТекЗначениеВЯчейке;
						НоваяСтрока.Кратность	 = ТекВыгрузка.Кратность;
					КонецЦикла;
				Иначе
					// Пустое значение. Не добавляем.
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатФункции;    
	
КонецФункции

// Проверяет на заполненность число ЧислоВход. В случае успеха возвращает
// строковое его представление, иначе - "0". Когда ТочностьВход задана - будет
// возвращено представление с соответственной точностью
&НаКлиентеНаСервереБезКонтекста
Функция ТекстовоеПредставлениеЧисла(ЧислоВход, ТочностьВход = Неопределено)

	РезультатФункции = "";
	Если ЗначениеЗаполнено(ЧислоВход) Тогда
		Если (ТочностьВход = Неопределено) ИЛИ (Цел(ЧислоВход) = ЧислоВход) Тогда
			РезультатФункции = Строка(ЧислоВход);
		Иначе
			РезультатФункции = Формат(ЧислоВход, "ЧДЦ=" + Строка(ТочностьВход));
		КонецЕсли;
	Иначе
		РезультатФункции = "0";
	КонецЕсли;
	
	Возврат РезультатФункции;  
	
КонецФункции

// Процедура выставляет на границы периода отбора значения по умолчанию,
// если они не заданы явно.
&НаКлиентеНаСервереБезКонтекста
Процедура ДозаполнитьПериодОтбора(Форма, ДатаСеанса)
	
	Отчет = Форма.Отчет;
	ПериодОтбора = Отчет.ПериодОтбора;
	
	ДатаНачалаИзменена = Ложь;
	
	Если Не ЗначениеЗаполнено(ПериодОтбора.ДатаНачала) ИЛИ ПериодОтбора.ДатаНачала < НачалоДня(ДатаСеанса) Тогда
		
		ПериодОтбора.ДатаНачала = НачалоДня(ДатаСеанса);
		ДатаНачалаИзменена = Истина;  
		
	КонецЕсли;
	
	Отчет.ГоризонтОперативногоПланирования = ПериодОтбора.ДатаНачала + 86400 *(Отчет.ЧислоДнейОперативногоПланирования - 1);         
	Отчет.ГоризонтТактическогоПланирования = ГоризонтТактическогоПланирования(Отчет.ГоризонтОперативногоПланирования, Отчет.ПериодичностьОперативногоПланирования);
	Отчет.ГоризонтДолгосрочногоПланирования = ГоризонтДолгосрочногоПланирования(Отчет.ГоризонтОперативногоПланирования, Отчет.ПериодичностьОперативногоПланирования, 
																Отчет.КоличествоПериодовДолгосрочногоПланирования, Отчет.ЭтоБазоваяФункциональность);
	Отчет.НачалоОтбораПросроченныхЗаявок = ПериодОтбора.ДатаНачала - Отчет.ГлубинаОтображенияПросроченныхПлатежей * 86400;
	
	Если Не ЗначениеЗаполнено(ПериодОтбора.ДатаОкончания)
		ИЛИ	ДатаНачалаИзменена 
		ИЛИ ПериодОтбора.ДатаОкончания <> Отчет.ГоризонтДолгосрочногоПланирования Тогда
		
		Если Отчет.ВариантПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.ВариантыПлатежногоКалендаря.ПланированиеОднимДнем") Тогда
         	Отчет.ПериодОтбора.ДатаОкончания = Отчет.ПериодОтбора.ДатаНачала;
		Иначе
			УстановитьДатуОкончанияПериодаОтбора(Форма);
		КонецЕсли;
		                                                                                         
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоказателиВыделенныхЯчеек()
	
	ДанныеРасчета = ОбщегоНазначенияКлиентСерверУХ.РасчетныеПоказателиЯчеек(МакетОстатки, МакетОстатки.ВыделенныеОбласти);
	
	СтрокаРазделитель = ";    ";
	
	МассивПодстрок = Новый Массив;
	Если ВыводитьСреднее Тогда
		Среднее = ?(ДанныеРасчета.КоличествоЧисловых = 0, 0, ДанныеРасчета.Сумма / ДанныеРасчета.КоличествоЧисловых);
		МассивПодстрок.Добавить(НСтр("ru = 'Среднее: '") + ТекстовоеПредставлениеЧисла(Среднее, 2));
	КонецЕсли;
	
	Если ВыводитьКоличество Тогда
		МассивПодстрок.Добавить(НСтр("ru = 'Количество: '") + ТекстовоеПредставлениеЧисла(ДанныеРасчета.Количество));
	КонецЕсли;
	
	Если ВыводитьКоличествоЧисел Тогда
		МассивПодстрок.Добавить(НСтр("ru = 'Количество чисел: '") + ТекстовоеПредставлениеЧисла(ДанныеРасчета.КоличествоЧисловых));
	КонецЕсли;
	
	Если ВыводитьМинимум Тогда
		МассивПодстрок.Добавить(НСтр("ru = 'Минимум: '") + ТекстовоеПредставлениеЧисла(ДанныеРасчета.Минимум));
	КонецЕсли;
	
	Если ВыводитьМаксимум Тогда
		МассивПодстрок.Добавить(НСтр("ru = 'Максимум: '") + ТекстовоеПредставлениеЧисла(ДанныеРасчета.Максимум));
	КонецЕсли;
	
	Если ВыводитьСумму Тогда
		МассивПодстрок.Добавить(НСтр("ru = 'Сумма: '") + ТекстовоеПредставлениеЧисла(ДанныеРасчета.Сумма));
	КонецЕсли;
	
	ДанныеВыделенныхЯчеек = СтрСоединить(МассивПодстрок,СтрокаРазделитель);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкуОтображенияПоказателяВыделенныхЯчеек(Настройка, Элемент)
	
	Настройка = НЕ Настройка;
	Элемент.Пометка = Настройка;
	РассчитатьПоказателиВыделенныхЯчеек();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеПометкамиКомандСправочнойИнформации()
	
	Элементы.ДанныеВыделенныхЯчеекКонтекстноеМенюВыводитьСреднее.Пометка = ВыводитьСреднее;	
	Элементы.ДанныеВыделенныхЯчеекКонтекстноеМенюВыводитьКоличество.Пометка = ВыводитьКоличество;
	Элементы.ДанныеВыделенныхЯчеекКонтекстноеМенюВыводитьКоличествоЧисел.Пометка = ВыводитьКоличествоЧисел;
	Элементы.ДанныеВыделенныхЯчеекКонтекстноеМенюВыводитьМинимум.Пометка = ВыводитьМинимум;
	Элементы.ДанныеВыделенныхЯчеекКонтекстноеМенюВыводитьМаксимум.Пометка = ВыводитьМаксимум;
	Элементы.ДанныеВыделенныхЯчеекКонтекстноеМенюВыводитьСумму.Пометка = ВыводитьСумму;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	// Перенесём плановые курсы.
	ТаблицаПлановыхКурсов = СчитатьОтображениеПлановыхКурсов();
	Отчет.ПлановыеКурсы.Загрузить(ТаблицаПлановыхКурсов);
	
	СкомпоноватьРезультат(РежимКомпоновкиРезультата.Авто);
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "ФормированиеОтчета");

	ОбновитьДанныеНаСервере();
	ПослеФормированияНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеФормированияНаКлиенте()
	
	ОбновитьОтображениеДанных(); // Для платформы.
	
	ОформлениеТекущейОбласти();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиалогОтправкиПоЭлектроннойПочте()
	
	ОтчетНаименованиеТекущегоВарианта = СтрШаблон(НСтр("ru = 'Платежный календарь по состоянию на %1'"), Формат(ТекущаяДатаСервера(), ""));
	
	ПараметрыОтправки = Новый Структура("Тема", ОтчетНаименованиеТекущегоВарианта);
	
	Вложение = Новый Структура;
	Вложение.Вставить("АдресВоВременномХранилище", ПоместитьВоВременноеХранилище(МакетОстатки, УникальныйИдентификатор));
	Вложение.Вставить("Представление", ОтчетНаименованиеТекущегоВарианта);
	
	СписокВложений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);
	
	ПараметрыОтправки = РаботаСПочтовымиСообщениямиКлиент.ПараметрыОтправкиПисьма();
	
	ДопПараметры = Новый Структура("Вложения", СписокВложений);
	Контекст = Новый Структура;
	Контекст.Вставить("ТабличныйДокумент", МакетОстатки);
	Контекст.Вставить("Заголовок"        , ОтчетНаименованиеТекущегоВарианта);
	ПараметрыОтправкиБП = ОтправкаПочтовыхСообщенийВызовСервера.ПараметрыЭлектронногоПисьмаДляОтчетов(Контекст, ДопПараметры);
	ПараметрыОтправки.Вставить("Получатель"                 , ПараметрыОтправкиБП.Получатель);
	ПараметрыОтправки.Вставить("Тема"                       , ПараметрыОтправкиБП.Тема);
	ПараметрыОтправки.Вставить("Текст"                      , ПараметрыОтправкиБП.Текст);
	ПараметрыОтправки.Вставить("АдресПолучателяСкрытойКопии", ПараметрыОтправкиБП.АдресПолучателяСкрытойКопии);
	ПараметрыОтправки.Вставить("Отправитель"                , ПараметрыОтправкиБП.Отправитель);
	
	ПараметрыОтправки.Вложения = СписокВложений;
	РаботаСПочтовымиСообщениямиКлиент.СоздатьНовоеПисьмо(ПараметрыОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПоЭлектроннойПочте(Команда)
	
	ПоказатьДиалогОтправкиПоЭлектроннойПочте();
	
КонецПроцедуры

&НаСервере
Процедура ПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	ПользовательскиеНастройки = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки;
	
	ОчиститьЭлементыБыстрыхНастроек();
	
	ЗаполнитьБыстрыеОтборы();
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБыстрыеОтборы()
	
	Для Каждого ТекЭлементОтбора Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если ПустаяСтрока(ТекЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьБыстрыйОтбор(ТекЭлементОтбора);
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОчиститьЭлементыБыстрыхНастроек()
	
	ГруппыДляОчистки = Новый Массив;
	ГруппыДляОчистки.Добавить(Элементы.ГруппаБыстрыеОтборы);

	ЭлементыКУдалению = Новый Массив;
	
	Для Каждого ТекГруппаДляОчистки Из ГруппыДляОчистки Цикл
		
		Для Каждого ТекЭлемент Из ТекГруппаДляОчистки.ПодчиненныеЭлементы Цикл
			
			ЭлементыКУдалению.Добавить(ТекЭлемент);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ТекЭлемент Из ЭлементыКУдалению Цикл
		Элементы.Удалить(ТекЭлемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьБыстрыйОтбор(ТекЭлементОтбора)
	
	ИмяОтбора = "";
	
	ЭлементыПользовательскихНастроек = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	
	ИндексНастройки = -1;
	Для Инд = 0 По ЭлементыПользовательскихНастроек.Количество() Цикл
		
		Если ЭлементыПользовательскихНастроек[Инд].ИдентификаторПользовательскойНастройки = ТекЭлементОтбора.ИдентификаторПользовательскойНастройки Тогда
			ИндексНастройки = Инд;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИндексНастройки < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяОтбора = Строка(ТекЭлементОтбора.ЛевоеЗначение);
	ПредставлениеОтбора = ?(ЗначениеЗаполнено(ТекЭлементОтбора.ПредставлениеПользовательскойНастройки),
				ТекЭлементОтбора.ПредставлениеПользовательскойНастройки,
				ИмяОтбора);	
	
	ШаблонПутьКДанным = "Отчет.КомпоновщикНастроек.ПользовательскиеНастройки[%1].%2";
	
	// Добавим горизонтальную группу, в которую поместим описание отбора.
	ГруппаБыстрыйОтбор = Элементы.Добавить("ГруппаОтбор"+ИмяОтбора, Тип("ГруппаФормы"), Элементы.ГруппаБыстрыеОтборы);
	ГруппаБыстрыйОтбор.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаБыстрыйОтбор.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаБыстрыйОтбор.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаБыстрыйОтбор.ОтображатьЗаголовок = Ложь;
	
	// Добавим флажок "Использование"
	НовыйЭлемент = Элементы.Добавить(ИмяОтбора + "Использование", Тип("ПолеФормы"), ГруппаБыстрыйОтбор);
	НовыйЭлемент.Заголовок = ПредставлениеОтбора;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = СтрШаблон(ШаблонПутьКДанным, ИндексНастройки, "Использование");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииБыстройНастройки");
	
	// Добавим поле ввода "Вид сравнения"
	НовыйЭлемент = Элементы.Добавить(ИмяОтбора + "ВидСравнения", Тип("ПолеФормы"), ГруппаБыстрыйОтбор);
	НовыйЭлемент.Заголовок = ПредставлениеОтбора;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;

	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.МаксимальнаяШирина = 17;

	НовыйЭлемент.ПутьКДанным = СтрШаблон(ШаблонПутьКДанным, ИндексНастройки, "ВидСравнения");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииБыстройНастройки");
	
	// Добавим поле ввода "Значение"
	НовыйЭлемент = Элементы.Добавить(ИмяОтбора + "Значение", Тип("ПолеФормы"), ГруппаБыстрыйОтбор);
	НовыйЭлемент.Заголовок = ПредставлениеОтбора;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = СтрШаблон(ШаблонПутьКДанным, ИндексНастройки, "Значение");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииБыстройНастройки");
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииБыстройНастройки()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность"); 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокФормы(Форма)
	
	Отчет = Форма.Отчет;
	Форма.Заголовок = СтрШаблон(НСтр("ru = 'Платежный календарь (%1)'"), Строка(Отчет.ПериодОтбора));
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьНаДругойСчетКассу()
	
	ВыделенныеСтроки = Элементы.ДетализацияОборотов.ВыделенныеСтроки;
	
	Если Не ВыделенныеСтроки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляПереноса = Новый Структура("СуммаЗаявок,КоличествоЗаявок");
	
	ОрганизацияПеренос			= Элементы.ДетализацияОборотов.ДанныеСтроки(ВыделенныеСтроки[0]).Организация;
	ВалютаПеренос				= Элементы.ДетализацияОборотов.ДанныеСтроки(ВыделенныеСтроки[0]).Валюта;
	ВидДенежныхСредствПеренос	= Элементы.ДетализацияОборотов.ДанныеСтроки(ВыделенныеСтроки[0]).ВидДенежныхСредств;
	СуммаКПереносу = 0;
	РазличаютсяДанныеВыделенныхСтрок = Ложь;
		
	Для Каждого ТекСтрока Из Элементы.ДетализацияОборотов.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Элементы.ДетализацияОборотов.ДанныеСтроки(ТекСтрока);
		
		СуммаКПереносу = СуммаКПереносу + ДанныеСтроки.СуммаПриход - ДанныеСтроки.СуммаРасход;
		
		Если ДанныеСтроки.Организация <> ОрганизацияПеренос 
			ИЛИ ДанныеСтроки.Валюта <> ВалютаПеренос 
			ИЛИ ДанныеСтроки.ВидДенежныхСредств <> ВидДенежныхСредствПеренос Тогда
		
			РазличаютсяДанныеВыделенныхСтрок = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РазличаютсяДанныеВыделенныхСтрок Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Невозможно перенести операции, у которых различаются валюты,организации или виды денежных средств'"));
		Возврат;
	КонецЕсли;
	
	ДанныеДляПереноса.Вставить("Организация", ОрганизацияПеренос);
	ДанныеДляПереноса.Вставить("Валюта", ВалютаПеренос);
	ДанныеДляПереноса.Вставить("ВидДенежныхСредств", ВидДенежныхСредствПеренос);
	ДанныеДляПереноса.Вставить("СуммаЗаявок", СуммаКПереносу);
	ДанныеДляПереноса.Вставить("КоличествоЗаявок", ВыделенныеСтроки.Количество());
	
	ПараметрыФормы = Новый Структура("ДанныеЗаполнения", ДанныеДляПереноса);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПереместитьНаДругойСчетКассуЗавершение", ЭтотОбъект);
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаРазмещенияЗаявок", 
		ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьНаДругойСчетКассуЗавершение(СчетКасса, Параметры) Экспорт
	
	Если СчетКасса = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ДанныеОперации = СобратьДанныеОперацииДляПроверки(СчетКасса);
	
	Если Не ПроверитьДопустимостьОперацииНаКлиенте(ДанныеОперации) Тогда
		Возврат;
	КонецЕсли;
	
	РазместитьЗаявкиНаСервере(Элементы.ДетализацияОборотов.ВыделенныеСтроки,,СчетКасса);

КонецПроцедуры

&НаКлиенте
Процедура ПереместитьНаУказаннуюДату(Сдвиг = Неопределено)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПереместитьНаУказаннуюДатуПродолжение", ЭтотОбъект);
	
	Если Сдвиг <> Неопределено Тогда
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Сдвиг);
		
	Иначе
		
		ПоказатьВводДаты(ОписаниеОповещения,ТекущаяДатаСервера() + 86400, ,ЧастиДаты.Дата);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьДопустимостьПлатежногоДня(ДатаПлатежа, ПлатежныеДниНедели, ТекстОшибки)
	
	Если НЕ ДопустимыйПлатежныйДень(ДатаПлатежа, ПлатежныеДниНедели) Тогда
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Указанный день %1 (%2) не является допустимым платежным днем (%3).
				|Операция отменена.'"), 
					Формат(ДатаПлатежа, НСтр("ДЛФ=D")), 
					ДеньНеделиПредставление(ДеньНедели(ДатаПлатежа)), 
					ПлатежныеДниПредставление(ПлатежныеДниНедели));
					
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПереместитьНаУказаннуюДатуПродолжение(Результат, Параметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Дата") Тогда  // перемещение на указанную дату		
		ТекстОшибки = "";
		Если НЕ ПроверитьДопустимостьПлатежногоДня(Результат, ПлатежныеДниНедели, ТекстОшибки) Тогда
			ПоказатьПредупреждение(, ТекстОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	РазместитьЗаявкиНаСервере(Элементы.ДетализацияОборотов.ВыделенныеСтроки, Результат,,ТекОбласть.Расшифровка);
	
	ОформлениеТекущейОбласти();
    
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДеньНеделиПредставление(ДеньНедели)
	
	Дни = Новый Соответствие;
	Дни.Вставить(1, НСтр("ru = 'пн'"));
	Дни.Вставить(2, НСтр("ru = 'вт'"));
	Дни.Вставить(3, НСтр("ru = 'ср'"));
	Дни.Вставить(4, НСтр("ru = 'чт'"));
	Дни.Вставить(5, НСтр("ru = 'пт'"));
	Дни.Вставить(6, НСтр("ru = 'сб'"));
	Дни.Вставить(7, НСтр("ru = 'вс'"));
	
	Результат = Дни[ДеньНедели];
	Результат = ?(Результат <> Неопределено, Результат, "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПлатежныеДниПредставление(ПлатежныеДниНедели)
	
	Представление = "";
	Для каждого ЭлДни Из ПлатежныеДниНедели Цикл
		Представление = Представление + ?(Представление <> "", ", ", "")
			+ ДеньНеделиПредставление(ЭлДни.Значение);
	КонецЦикла;
	
	Возврат Представление;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДопустимыйПлатежныйДень(День, ПлатежныеДни)
	
	Возврат (ПлатежныеДни.НайтиПоЗначению(ДеньНедели(День)) <> Неопределено);
	
КонецФункции	
	
// Определяет количество вхождений валюты ВалютаВход в таблицу плановых курсов.
