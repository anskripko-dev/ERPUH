	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = ЗНАЧЕНИЕ(Справочник.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка)
	|	И ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь
	|	И ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи В(&ИдентификаторыОпераций)
	|	И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря В (ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.ПоступлениеСредств), ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.СписаниеСредств))";

	Запрос.УстановитьПараметр("Пользователь", Отчет.Пользователь);
	Запрос.УстановитьПараметр("ИдентификаторыОпераций", ИдентификаторыОпераций);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
	
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Инструмент = ПрогнозныеОперации.Добавить();
			Инструмент.Активна = Истина;
			Инструмент.ИдентификаторОперации = Новый УникальныйИдентификатор;
			Инструмент.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПомещениеВСтопЛист;
			Инструмент.УточнениеОперации = Выборка.ИдентификаторЗаписи;
			Инструмент.ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Помещение в стоп-лист %1'"), Выборка.Инструмент);
			Инструмент.ОрганизацияСписания = Выборка.Организация;
			Инструмент.БанковскийСчетКассаСписания = Выборка.БанковскийСчетКасса;
			Инструмент.БанкСписания = Выборка.Банк;
			Инструмент.ДатаСписания = Выборка.Дата;
			Инструмент.ВалютаСписания = Выборка.Валюта;
			Инструмент.ВидДенежныхСредств = Выборка.ВидДенежныхСредств;
					
			МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Выборка);
			МЗ.Прочитать();
			МЗ.Активна = Ложь;
			МЗ.ИдентификаторОтменившейОперации = Инструмент.ИдентификаторОперации;
			
			МЗ.Записать();
		КонецЦикла;
		
		ПриИзмененииПрогнозныхОпераций();
		ОбновитьДанныеНаСервере();
		ОбновитьСтопЛист();         
		
	Иначе     
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Помещение в стоп-лист не выполнено. Помещать можно только управляемые операции'"));
		
	КонецЕсли;
	
	ВывестиДеталиНаСервере(Расшифровка);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Область)

	СтандартнаяОбработка = Ложь;
	
	Если Область.Расшифровка <> Неопределено И ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Структура") Тогда
		
		ОперацииИзСтопЛиста = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПеретаскивания.Значение, "ОперацииИзСтопЛиста", Ложь);
		
		РезультатПеретаскиваниеОбработатьНаСервере(ПараметрыПеретаскивания.Значение.ДанныеСтрок, Область.Расшифровка, ОперацииИзСтопЛиста);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РезультатПеретаскиваниеОбработатьНаСервере(МассивОпераций, Знач Расшифровка, Знач ОперацииИзСтопЛиста)
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, ИсточникНастроек);
	НастройкаРасшифровки = ОбработкаРасшифровки.Расшифровать(Расшифровка, Новый ПолеКомпоновкиДанных("БанковскийСчетКасса"));
	
	ЦелевойБанковскийСчет = Неопределено;
	ЦелевойВидДенежныхСредств = Неопределено;
	ЦелеваяДата = Неопределено;
		
	Для Каждого ТекОтбор Из НастройкаРасшифровки.Отбор.Элементы Цикл
		
		Если ТекОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("БанковскийСчетКасса") Тогда
			ЦелевойБанковскийСчет = ТекОтбор.ПравоеЗначение;
		ИначеЕсли ТекОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидДенежныхСредств") Тогда
			ЦелевойВидДенежныхСредств = ТекОтбор.ПравоеЗначение;
		ИначеЕсли ТекОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата") И ТекОтбор.ПравоеЗначение >= Отчет.ПериодОтбора.ДатаНачала Тогда
			ЦелеваяДата = ТекОтбор.ПравоеЗначение;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЦелеваяДата = Неопределено И Отчет.ВариантПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.ВариантыПлатежногоКалендаря.ПерспективноеПланирование") Тогда
		ЦелеваяДата = Отчет.ПериодОтбора.ДатаНачала;	
	КонецЕсли;
	
	Если ЦелеваяДата = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не выбрана дата размещения'"));
	КонецЕсли;
	
	Если ЦелевойБанковскийСчет = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не выбран банковский счет размещения'"));
	КонецЕсли;
	
	Если ЦелевойВидДенежныхСредств = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не выбран вид денежных средств размещения'"));
	КонецЕсли;
    
	Если ЦелеваяДата = Неопределено Или ЦелевойБанковскийСчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ТекстОшибки = "";
	Если Не ПроверитьДопустимостьПлатежногоДня(ЦелеваяДата, ПлатежныеДниНедели, ТекстОшибки) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьДопустимостьОперацииПоБанковскомуСчетуНаСервере(ЦелевойБанковскийСчет) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьПереносОперацийПоВидуДенежныхСредств(МассивОпераций,ЦелевойВидДенежныхСредств,ОперацииИзСтопЛиста) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОперацииИзСтопЛиста Тогда
		
		ВернутьЗаявкиИзСтопЛиста(МассивОпераций, ЦелеваяДата, ЦелевойБанковскийСчет, Расшифровка);
		
	Иначе
		
		РазместитьЗаявкиНаСервере(МассивОпераций, ЦелеваяДата, ЦелевойБанковскийСчет, Расшифровка);
		
	КонецЕсли;
	
	ПриИзмененииПрогнозныхОпераций();
	ОбновитьДанныеНаСервере();  
	
КонецПроцедуры

&НаКлиенте                                              
Процедура ДетализацияОборотовНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	СтруктураПараметрПеретаскивания = Новый Структура("ДанныеСтрок", ПараметрыПеретаскивания.Значение);
	ПараметрыПеретаскивания.Значение = СтруктураПараметрПеретаскивания;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатВыбор(Элемент, Область, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Элементы.ГруппаДетальнаяИнформация.ТекущаяСтраница = Элементы.СтраницаОбороты;
	
	ТекОбласть = Элементы.Остатки.ТекущаяОбласть;

	ТекРасшифровка = ТекОбласть.Расшифровка;
	
	Если ТекРасшифровка <> Неопределено Тогда
		БанковскийСчет =  ПолучитьДанныеРасшифровки(ТекРасшифровка);  
		
		Если ЗначениеЗаполнено(БанковскийСчет) Тогда 
			
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("БанковскийСчет",БанковскийСчет);
			ПараметрыОткрытия.Вставить("АдресХранилищаДанныхДоговоров",Отчет.АдресХранилищаДанныхДоговоров);  

			ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПросмотраДополнительныхСведений",ПараметрыОткрытия,ЭтотОбъект,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьДанныеРасшифровки(Расшифровка)

	Данные = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	Поля = Данные.Элементы.Получить(Расшифровка).ПолучитьПоля();
	ПолеБанковскийСчет = Поля.Найти("БанковскийСчетКасса"); 
	 
	Если ПолеБанковскийСчет <> Неопределено Тогда 
		
		Если ТипЗнч(ПолеБанковскийСчет.Значение) = Тип("СправочникСсылка.БанковскиеСчетаОрганизаций") Тогда
		
			Возврат ПолеБанковскийСчет.Значение; 
			
		КонецЕсли;
		
	КонецЕсли;     
	
КонецФункции

&НаКлиенте
Процедура СтопЛистНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ОперацииИзСтопЛиста", Истина);
	СтруктураДанных.Вставить("ДанныеСтрок", ПараметрыПеретаскивания.Значение);
	
	ПараметрыПеретаскивания.Значение = СтруктураДанных;    
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьМакетИВывестиОтчет()
	
	РасшифровкаПараметра = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Расшифровка", Неопределено);
	Если РасшифровкаПараметра = Неопределено Тогда
		
		Если Параметры.Свойство("Ключ") И ЗначениеЗаполнено(Параметры.Ключ) Тогда
			
			ЗаполнитьОтчетПоСохраненномуВарианту(Параметры.Ключ);
			Элементы.СохраненнаяВерсияПлатежногоКалендаря.Видимость = Истина;
			ТолькоПросмотр = Истина;
		Иначе
			
			Если НЕ ЗначениеЗаполнено(Отчет.ПериодОтбора.Вариант) Тогда
				Отчет.ПериодОтбора.Вариант = ВариантСтандартногоПериода.ДоКонцаЭтогоМесяца;
			Иначе
				
			КонецЕсли;    
			
			ОбновитьПредставлениеНаСервере();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформлениеТекущейОбласти()
	
	Если ТекОбласть <> Неопределено И ТекОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
		ТекОбласть.ЦветУзора = WebЦвета.Желтый;
		ТекОбласть.Узор = ТипУзораТабличногоДокумента.Узор2;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьСРазмещения(Команда)
	
	РазделитьПоВидамДенежныхСредствИРазместитьЗаявкиНаСервере(Элементы.ДетализацияОборотов.ВыделенныеСтроки);

КонецПроцедуры

