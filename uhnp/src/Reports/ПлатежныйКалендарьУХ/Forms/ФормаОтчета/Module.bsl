&НаКлиенте
Процедура ДетализацияОборотовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ЗначениеДляПоказа = Элемент.ДанныеСтроки(ВыбраннаяСтрока).Инструмент;
	Если ТипЗнч(ЗначениеДляПоказа) <> Тип("Строка") Тогда
		ПоказатьЗначение(,ЗначениеДляПоказа);
	КонецЕсли;

