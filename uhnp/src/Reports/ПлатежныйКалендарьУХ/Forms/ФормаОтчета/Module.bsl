&НаКлиенте
Процедура РазделитьДокументНачало()
	
	ТекДанные = Элементы.ДетализацияОборотов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.РазделПлатежногоКалендаря <> ПредопределенноеЗначение("Перечисление.РазделыПлатежногоКалендаря.СписаниеСредств") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Операция разделения применима только к управляемым списаниям.'"));
		Возврат;
	КонецЕсли;
	
	РазделяемыйИнструмент = ТекДанные.Инструмент;
	Если ТипЗнч(РазделяемыйИнструмент) <> Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств")
		И ТипЗнч(РазделяемыйИнструмент) <> Тип("ДокументСсылка.ОжидаемоеПоступлениеДенежныхСредств") Тогда
		
		ИнструментРазделения = ПолучитьЗаявкуРазделения(ТекДанные.ИдентификаторЗаписи);
		Если ЗначениеЗаполнено(ИнструментРазделения) Тогда
			РазделяемыйИнструмент = ИнструментРазделения;			// Делим уже разделенную заявку.
		Иначе	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Операция разделения применима только к заявкам на операции.'"));
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СостояниеОбъекта = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(РазделяемыйИнструмент);
	Если СостояниеОбъекта <> ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Утверждена") Тогда
		ТекстСообщения = НСтр("ru = '%Заявка% находится в статусе %ТекущийСтатус%. Для разделения требуется статус Утверждена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Заявка%", Строка(РазделяемыйИнструмент));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТекущийСтатус%", Строка(СостояниеОбъекта));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДеталиОперации = Новый Структура("Инструмент,ИдентификаторЗаписи,Пользователь");
	ДеталиОперации.ИдентификаторЗаписи 	= ТекДанные.ИдентификаторЗаписи;
	ДеталиОперации.Инструмент 			= РазделяемыйИнструмент;
	ДеталиОперации.Пользователь 		= Отчет.Пользователь;
	
	ПараметрыФормы = Новый Структура("ДанныеЗаполнения", ДеталиОперации);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РазделитьДокументПродолжение", ЭтотОбъект, ДеталиОперации);
	
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаРазделенияОперации", 
		ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура РазделитьДокументПродолжение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	РазделитьДокументЗавершениеНаСервере(Результат, Параметры);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");  
	
	АктивизироватьТекущуюОбласть();
	
КонецПроцедуры

&НаСервере
Процедура РазделитьДокументЗавершениеНаСервере(МассивСумм, ДополнительныеПараметры)
	// Инициализация.
	НачатьТранзакцию();
	ЕстьОшибки = Ложь;
	МетаданныеРегистраПлатежногоКалендаря = Метаданные.РегистрыСведений.ПредставлениеПлатежногоКалендаря;
	Попытка
		// 1. Отключим активность записей.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря КАК ВерсияПлатежногоКалендаря,
		|	ПредставлениеПлатежногоКалендаря.Пользователь КАК Пользователь,
		|	ПредставлениеПлатежногоКалендаря.Активна КАК Активна,
		|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
		|	ПредставлениеПлатежногоКалендаря.ПулЛиквидности КАК ПулЛиквидности,
		|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
		|	ПредставлениеПлатежногоКалендаря.Банк КАК Банк,
		|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
		|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
		|	ПредставлениеПлатежногоКалендаря.Инструмент КАК Инструмент,
		|	ПредставлениеПлатежногоКалендаря.Приоритет КАК Приоритет,
		|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации КАК ИдентификаторДобавившейОперации,
		|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
		|	ПредставлениеПлатежногоКалендаря.Сумма КАК Сумма,
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации КАК ИдентификаторОтменившейОперации,
		|	ПредставлениеПлатежногоКалендаря.КрайняяДата КАК КрайняяДата,
		|	ПредставлениеПлатежногоКалендаря.ФиксированныйБанковскийСчет КАК ФиксированныйБанковскийСчет,
		|	ПредставлениеПлатежногоКалендаря.ИсточникДанных КАК ИсточникДанных,
		|	ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
		|ИЗ
		|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
		|ГДЕ
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи = &ИдентификаторЗаписи
		|	И ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = ЗНАЧЕНИЕ(Справочник.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка)
		|	И ПредставлениеПлатежногоКалендаря.Пользователь = &ТекущийПользователь";
		
		Запрос.УстановитьПараметр("ИдентификаторЗаписи", ДополнительныеПараметры.ИдентификаторЗаписи);
		Запрос.УстановитьПараметр("ТекущийПользователь", Отчет.Пользователь);
		
		Выборка = Запрос.Выполнить().Выбрать();
		НовыйИдентификатор = Новый УникальныйИдентификатор;
		СтруктураОтключаемойЗаписи =  Новый Структура;	
		Пока Выборка.Следующий() Цикл
			
			МенеджерОтключаемойЗаписи = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерОтключаемойЗаписи, Выборка);
			МенеджерОтключаемойЗаписи.Прочитать();
			ИдентификаторОперации = МенеджерОтключаемойЗаписи.ИдентификаторДобавившейОперации;
			ИдентификаторОтключеннойЗаписи = МенеджерОтключаемойЗаписи.ИдентификаторЗаписи;
			// Закешируем значения перед удалением.
			СтруктураОтключаемойЗаписи = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерОтключаемойЗаписи, МетаданныеРегистраПлатежногоКалендаря);
			ЗаполнитьЗначенияСвойств(СтруктураОтключаемойЗаписи, МенеджерОтключаемойЗаписи);
			Если ЗначениеЗаполнено(МенеджерОтключаемойЗаписи.ИдентификаторДобавившейОперации) Тогда
				
				// Это промежуточная операция - вырежем ее, чтобы не мешалась.
				МенеджерОтключаемойЗаписи.Удалить();
				
			Иначе
				
				МенеджерОтключаемойЗаписи.ИдентификаторОтменившейОперации = НовыйИдентификатор;
				МенеджерОтключаемойЗаписи.Активна = Ложь;
				МенеджерОтключаемойЗаписи.Записать();
				
			КонецЕсли;			
		КонецЦикла;
		
		// 2. Напишем наши новые записи
		
		Если ЗначениеЗаполнено(ИдентификаторОперации) Тогда
			ИзменяетсяСуществующееРазделение = Истина;
		Иначе
			ИзменяетсяСуществующееРазделение = Ложь;
			ИдентификаторОперации = НовыйИдентификатор;
		КонецЕсли;
		
		Сч = 0;
		
		МассивИдентификаторов = Новый Массив;
		КоличествоЧастей = МассивСумм.Количество();
		
		Для Каждого ТекЭлементМассива Из МассивСумм Цикл
			
			сч = Сч + 1;
			
			МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, СтруктураОтключаемойЗаписи);
			МЗ.Активна = Истина;
			МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
			МЗ.Сумма = ТекЭлементМассива;
			МЗ.ИдентификаторДобавившейОперации = ИдентификаторОперации;
			МЗ.Записать();
			
			МассивИдентификаторов.Добавить(МЗ.ИдентификаторЗаписи);
		КонецЦикла;
		
		// 3. Ну и добавим операцию.
		Если ИзменяетсяСуществующееРазделение Тогда
			Операции = ПрогнозныеОперации.НайтиСтроки(Новый Структура("ИдентификаторОперации", ИдентификаторОперации));
			Если НЕ Операции.Количество() Тогда
				Возврат;
			КонецЕсли;
			
			ДеталиОперации = Операции[0].УточнениеОперации;
			НовыеОперации = ДеталиОперации.НовыеИнструменты;
			
			ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(НовыеОперации, ИдентификаторОтключеннойЗаписи);
			
			Для Каждого Идентификатор Из МассивИдентификаторов Цикл
				НовыеОперации.Добавить(Идентификатор);
			КонецЦикла;
			
			КоличествоЧастей = НовыеОперации.Количество();
			Сч = 0;
			Для Каждого Идентификатор Из НовыеОперации Цикл
				Сч = Сч + 1;
				НаборЗаписей = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(Идентификатор);
				НаборЗаписей.Прочитать();
				Для Каждого ТекЗапись Из НаборЗаписей Цикл
					ТекЗапись.Инструмент = ДеталиОперации.ИсходныйИнструмент;
				КонецЦикла;
				НаборЗаписей.Записать();
			КонецЦикла;
			
		Иначе
			
			НоваяОперация = ПрогнозныеОперации.Добавить();
			НоваяОперация.Активна = Истина;
			НоваяОперация.ИдентификаторОперации = ИдентификаторОперации;
			НоваяОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.РазделениеОперации;
			НоваяОперация.ОрганизацияСписания = СтруктураОтключаемойЗаписи.Организация;
			НоваяОперация.ДатаСписания = СтруктураОтключаемойЗаписи.Дата;
			НоваяОперация.БанкСписания = СтруктураОтключаемойЗаписи.Банк;
			НоваяОперация.БанковскийСчетКассаСписания = СтруктураОтключаемойЗаписи.БанковскийСчетКасса;
			НоваяОперация.ВалютаСписания = СтруктураОтключаемойЗаписи.Валюта;
			
			УточнениеОперации = Новый Структура;
			УточнениеОперации.Вставить("ИсходныйИнструмент", ДополнительныеПараметры.Инструмент);
			УточнениеОперации.Вставить("НовыеИнструменты", Новый Массив);
			УточнениеОперации.Вставить("ИсходныйИдентификаторПозиции",ДополнительныеПараметры.ИдентификаторЗаписи);
			Для Каждого Идентификатор Из МассивИдентификаторов Цикл
				УточнениеОперации.НовыеИнструменты.Добавить(Идентификатор);
			КонецЦикла;
			НоваяОперация.УточнениеОперации = УточнениеОперации;
			НоваяОперация.ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Разделение инструмента %1 на %2 частей'"), 
			УточнениеОперации.ИсходныйИнструмент,
			УточнениеОперации.НовыеИнструменты.Количество());
		КонецЕсли;    
		
	Исключение
		ТекстСообщения = НСтр("ru = 'Во время разделения заявки возникли ошибки: %ОписаниеОшибки%. Операция отменена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		ЕстьОшибки = Истина;
	КонецПопытки;                                                            
	// Завершение транзакции.
	Если ЕстьОшибки Тогда
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	ПриИзмененииПрогнозныхОпераций();
	
КонецПроцедуры

&НаКлиенте
Процедура СтопЛист(Команда)
	СтопЛистНаСервере();
КонецПроцедуры

&НаСервере
Процедура СтопЛистНаСервере()
	
	ПереключитьВидимостьЭлемента(Элементы.КнопкаСтопЛист, Элементы.СтопЛист);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеестрПлатежей(Команда)
	
	МассивНезаполненныхПолей = Новый Массив;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		МассивНезаполненныхПолей.Добавить(НСтр("ru = 'организацию'"));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		МассивНезаполненныхПолей.Добавить(НСтр("ru = 'дату'"));		
	КонецЕсли;
	
	Если МассивНезаполненныхПолей.Количество() Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось однозначно определить '") + СтрСоединить(МассивНезаполненныхПолей, НСтр("ru = ' и '"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", Организация);
	ДанныеЗаполнения.Вставить("ДатаОплаты", Дата);
	
	СтруктураПараметров = Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
	
	Если Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьРеестрПлатежейПродолжение", ЭтотОбъект, СтруктураПараметров);
		ТекстВопроса = НСтр("ru = 'Создание реестра платежей возможно только после сохранения внесенных изменений.
                            |Данные будут записаны.'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	Иначе
		ОткрытьФорму("Документ.РеестрПлатежей.ФормаОбъекта", СтруктураПараметров, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеестрПлатежейПродолжение(Результат = Неопределено, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьИзмененияНаСервере();
	ОткрытьФорму("Документ.РеестрПлатежей.ФормаОбъекта", Параметры, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаДетализацииОборотов(Команда)
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Объект", Отчет);
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаНастройкаДетализации", СтруктураПараметров,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьЗаголовки(Команда)
	
	Элементы.ФормаОтображатьЗаголовки.Пометка = Не Элементы.ФормаОтображатьЗаголовки.Пометка;
	Элементы.Остатки.ОтображатьЗаголовки = Элементы.ФормаОтображатьЗаголовки.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРежимМасштабированияПросмотра(Команда)
	
	Элементы.ФормаПереключитьРежимМасштабированияПросмотра.Пометка = НЕ Элементы.ФормаПереключитьРежимМасштабированияПросмотра.Пометка;
	
	Если Элементы.ФормаПереключитьРежимМасштабированияПросмотра.Пометка Тогда
		
		Элементы.Остатки.РежимМасштабированияПросмотра = РежимМасштабированияПросмотра.Обычный;
	Иначе
		Элементы.Остатки.РежимМасштабированияПросмотра = РежимМасштабированияПросмотра.Крупный;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискЗаявок(Команда)
		
	ОборотыПоСтатьямДДС = Отчет.РежимВыводаОборотов = ПредопределенноеЗначение("Перечисление.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьПоСтатьямДДС"); 
	
	ЭтоОборотыПоДДС = ЭтоОборотыПоДДС(ЭтотОбъект);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПоискЗаявокПродолжение", ЭтотОбъект);
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Пользователь", Отчет.Пользователь);
	СтруктураПараметров.Вставить("НачалоПериодаОтбора", Отчет.ПериодОтбора.ДатаНачала);
	СтруктураПараметров.Вставить("ЭтоОборотыПоДДС", ЭтоОборотыПоДДС);
	
	МассивОтбора = ПолучитьПараметрыОтбораНаСервере();
	ФиксНастройки = Новый НастройкиКомпоновкиДанных;
	
	Для Каждого ТекЭлементОтбора Из МассивОтбора Цикл
		
		НовыйЭлементОтбора = ФиксНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НовыйЭлементОтбора, ТекЭлементОтбора);
		НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТекЭлементОтбора.ИмяПоля);
		НовыйЭлементОтбора.Использование = Истина;
	КонецЦикла;
	
	СтруктураПараметров.Вставить("ФиксированныеНастройки", ФиксНастройки);
	
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПоискаЗаявок",СтруктураПараметров, ЭтотОбъект,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискЗаявокПродолжение(Результат, Параметры) Экспорт

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ПоискЗаявокЗавершениеНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоискЗаявокЗавершениеНаСервере(КлючЗаписи)
		
	Результат = ВыделитьЯчейкуКалендаряНаСервере(КлючЗаписи);
	Если Результат.Успешно Тогда
		ИдентификаторЗаписиДляПозиционирования = КлючЗаписи.ИдентификаторЗаписи;
	Иначе
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Невозможно определить положение выбранной заявки: %1'"), Результат.ТекстОшибки);	
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрогнозныеОперацииПерейтиКЯчейкам(Команда)
	ОткрытьФормуВыбораЗависимыхЯчеекОперации();	
КонецПроцедуры

&НаКлиенте
Процедура ПрогнозныеОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОткрытьФормуВыбораЗависимыхЯчеекОперации();
КонецПроцедуры

&НаКлиенте
Процедура ПрогнозныеОперацииПерейтиКЯчейкамЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		 РезультатВыделения = ВыделитьЯчейкуКалендаряНаСервере(Результат);
		 Если НЕ РезультатВыделения.Успешно Тогда
			 ТекстОшибки = СтрШаблон(НСтр("ru = 'Невозможно определить положение выбранной ячейки: %1'"), РезультатВыделения.ТекстОшибки);	
			 ВызватьИсключение ТекстОшибки;
		КонецЕсли;	 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьОперациюКалендаря(Команда)
	
	ТекущаяСтрока = Элементы.ПрогнозныеОперации.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущиеДанные = Элементы.ПрогнозныеОперации.ТекущиеДанные;
		ОткрытьОперациюНаРедактирование(ТекущиеДанные);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите операцию в списке.'"));
	КонецЕсли;
 	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьДанные(Команда)
	АктуализироватьДанныеССохранениемОпераций();
КонецПроцедуры

&НаКлиенте
Процедура МоделироватьОстановкуПлатежей(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("МоделироватьОстановкуПлатежейПродолжение", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПериодОтбора", Отчет.ПериодОтбора);
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаМоделированиеОстановкиПлатежей", 
		ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте 
Процедура МоделироватьОстановкуПлатежейПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЭтоАдресВременногоХранилища(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ОстановитьПлатежиНаСервере(Результат, ТекОбласть.Расшифровка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПереоценитьПредставлениеПлатежногоКалендаря(Запись)
	
	ПараметрыКурса = ПлатежныеПозицииКлиентСервер.СтруктураПараметровРасчетаКурса();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РазмещениеЗаявок.ВалютаВзаиморасчетов КАК ВалютаДокумента,
		|	РазмещениеЗаявок.ВалютаОплаты КАК ВалютаОплаты,
		|	РазмещениеЗаявок.СпособОпределенияКурсаПлатежа КАК СпособОпределенияКурсаПлатежа,
		|	РазмещениеЗаявок.СдвигДатыФиксацииКурсаПлатежа КАК СдвигДатыФиксацииКурсаПлатежа,
		|	ВЫБОР
		|		КОГДА РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
		|			ТОГДА -ЕСТЬNULL(ДвиженияБюджетированияПоПозициям.СуммаВзаиморасчетов, РазмещениеЗаявок.СуммаВзаиморасчетов)
		|		ИНАЧЕ ЕСТЬNULL(ДвиженияБюджетированияПоПозициям.СуммаВзаиморасчетов, РазмещениеЗаявок.СуммаВзаиморасчетов)
		|	КОНЕЦ КАК СуммаВзаиморасчетов,
		|	РазмещениеЗаявок.КурсПлатежа КАК КурсПлатежа,
		|	РазмещениеЗаявок.КратностьПлатежа КАК КратностьПлатежа,
		|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию
		|ИЗ
		|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДвиженияБюджетированияПоПозициям КАК ДвиженияБюджетированияПоПозициям
		|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = ДвиженияБюджетированияПоПозициям.ЗаявкаНаОперацию
		|			И РазмещениеЗаявок.ИдентификаторПозиции = ДвиженияБюджетированияПоПозициям.ИдентификаторПозиции
		|			И (&СтатьяДвиженияДенежныхСредств = ДвиженияБюджетированияПоПозициям.СтатьяДвиженияДенежныхСредств)
		|ГДЕ
		|	РазмещениеЗаявок.ИдентификаторПозиции = &ИдентификаторПозиции
		|	И РазмещениеЗаявок.ЗаявкаНаОперацию = &Инструмент
		|	И НЕ РазмещениеЗаявок.КурсУстановленВЗаявке";
	
	Запрос.УстановитьПараметр("ИдентификаторПозиции", Запись.ИдентификаторЗаписи);
	Запрос.УстановитьПараметр("Инструмент", Запись.Инструмент);
	Запрос.УстановитьПараметр("СтатьяДвиженияДенежныхСредств", Запись.СтатьяДвиженияДенежныхСредств);
	
	РезультатЗапроса = Запрос.Выполнить();    
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл    
		ПараметрыКурса.Вставить("ДатаПлатежа", Запись.Дата); 
		ЗаполнитьЗначенияСвойств(ПараметрыКурса, ВыборкаДетальныеЗаписи);  
		ПлатежныеПозиции.ЗаполнитьПараметрыКурса(ПараметрыКурса, ВыборкаДетальныеЗаписи.ЗаявкаНаОперацию);
		СуммаВзаиморасчетов = ВыборкаДетальныеЗаписи.СуммаВзаиморасчетов;
	КонецЦикла;
	
	Если ПараметрыКурса.СпособОпределенияКурсаПлатежа = Перечисления.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс Тогда

		КратностьПлатежа = ПараметрыКурса.КратностьПлатежа;  
		КурсПлатежа = ПараметрыКурса.КурсПлатежа;  
		РезультирующийКурс = КурсПлатежа / КратностьПлатежа;   

    Иначе  
		
		Если ПараметрыКурса.ВалютаДокумента =  ПараметрыКурса.ВалютаОплаты Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеПлановыхКурсов = ПлатежныеПозиции.ДанныеБлижайшегоПлановогоКурса(Отчет.ПлановыеКурсы.Выгрузить(), ПараметрыКурса.ДатаПлатежа, ПараметрыКурса.ВалютаДокумента);
		
		КурсВалютыДокумента = ПлатежныеПозиции.ДанныеБлижайшегоПлановогоКурса(Отчет.ПлановыеКурсы.Выгрузить(), ПараметрыКурса.ДатаПлатежа, ПараметрыКурса.ВалютаДокумента);
		КурсВалютыОплаты = ПлатежныеПозиции.ДанныеБлижайшегоПлановогоКурса(Отчет.ПлановыеКурсы.Выгрузить(), ПараметрыКурса.ДатаПлатежа, ПараметрыКурса.ВалютаОплаты);
		
		Если КурсВалютыДокумента.Курс = 0 
				ИЛИ КурсВалютыДокумента.Кратность = 0 
				ИЛИ КурсВалютыОплаты.Курс = 0  
				ИЛИ КурсВалютыОплаты.Кратность = 0 Тогда   
				
			СтруктураКурса = ДвиженияБюджетированиеУХ.ПолучитьАктуальныйКурсПоПараметрам(ПараметрыКурса);
			РезультирующийКурс = СтруктураКурса.РезультирующийКурс;  
			
		Иначе
			РезультирующийКурс = Окр((КурсВалютыДокумента.Курс * КурсВалютыОплаты.Кратность) / (КурсВалютыДокумента.Кратность * КурсВалютыОплаты.Курс),8);   
		КонецЕсли;
		
	КонецЕсли;
	
	Запись.Сумма = СуммаВзаиморасчетов * РезультирующийКурс;

КонецПроцедуры

&НаСервере
Функция ПериодичностьОперативногоПланирования(ПараметрыБюджета)

	Если ПараметрыБюджета.ПериодичностьОперативногоПланирования = Перечисления.Периодичность.ДевятьМесяцев Тогда
