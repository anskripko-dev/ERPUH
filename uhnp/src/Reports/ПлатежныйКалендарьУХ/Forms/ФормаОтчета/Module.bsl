#Область ПроверкаДопустимостиОперации
&НаКлиенте
Функция ПроверитьДопустимостьОперацииНаКлиенте(ДанныеОперации)
		
	Если ДанныеОперации.ВидДенежныхСредств = ПредопределенноеЗначение("Перечисление.ФормыОплаты.Наличная") Тогда     	
		Результат = ВыполнитьПроверкуДопустимостиОперацииПоНаличнымДенежнымСредствам(ДанныеОперации);   	
	Иначе    	
		Результат = ВыполнитьПроверкуДопустимостиОперацииПоБезналичнымДенежнымСредствам(ДанныеОперации.БанковскийСчетКасса);  	
	КонецЕсли;
	
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(,Результат.ТекстОшибки);
	КонецЕсли;
	
	Возврат Результат.Успех;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьПроверкуДопустимостиОперацииПоНаличнымДенежнымСредствам(ДанныеОперации)
	
	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");
	
	Если  ДанныеОперации.ЭтоКонвертацияВалюты 
		ИЛИ ДанныеОперации.ЭтоВнутригрупповоеПеремещение
		ИЛИ  ДанныеОперации.ЭтоПривлечениеСредств Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Операция для наличных денежных средств недоступна'");
	Иначе
		Результат.Успех = Истина;	
	КонецЕсли;
	
	Возврат  Результат;

КонецФункции 

&НаСервере
Функция ПроверитьДопустимостьОперацииПоБанковскомуСчетуНаСервере(БанковскийСчетКасса)
	
	// Если на входе касса, проверку не делаем, т.к. у кассы нет реквизита "Закрыт"
	Если ТипЗнч(БанковскийСчетКасса) = Тип("СправочникСсылка.Кассы") Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Результат = ВыполнитьПроверкуДопустимостиОперацииПоБезналичнымДенежнымСредствам(БанковскийСчетКасса);
	Если Не Результат.Успех Тогда
		ОбщегоНазначения.СообщитьПользователю(Результат.ТекстОшибки);
	КонецЕсли;
	
	Возврат Результат.Успех;
	
КонецФункции

&НаСервере
Функция ПроверитьПереносОперацийПоВидуДенежныхСредств(ИдентификаторыСтрокОпераций,ЦелевойВидДенежныхСредств,ОперацииИзСтопЛиста)

	ИдентификаторыЗаписей = ИдентификаторыЗаписейВыделенныхСтрок(ИдентификаторыСтрокОпераций,ОперацииИзСтопЛиста);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА РазмещениеЗаявок.БанковскийСчетКасса ССЫЛКА Справочник.Кассы
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная)
		|	КОНЕЦ КАК ВидДенежныхСредств
		|ИЗ
		|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
		|ГДЕ
		|	РазмещениеЗаявок.ИдентификаторПозиции В(&ИдентификаторыЗаписей)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА РазмещениеЗаявок.БанковскийСчетКасса ССЫЛКА Справочник.Кассы
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная)
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("ИдентификаторыЗаписей", ИдентификаторыЗаписей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество()> 1 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Запрещено переносить операции с разными видам денежных средств'"));
		Возврат Ложь; 
	Иначе
		ВыборкаДетальныеЗаписи.Следующий();
		
		ВыбранныйВидДенежныхСредств = ВыборкаДетальныеЗаписи.ВидДенежныхСредств;
		
		Если  ЦелевойВидДенежныхСредств <> ВыбранныйВидДенежныхСредств Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Запрещено переносить операции с видом денежных средств: ""%1"" в ячейку с видом денежных средств:""%2""'"),
																ПредставлениеВидаДенежныхСредств(ВыбранныйВидДенежныхСредств),
																ПредставлениеВидаДенежныхСредств(ЦелевойВидДенежныхСредств)));
			Возврат Ложь; 
		КонецЕсли;
		
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьПроверкуДопустимостиОперацииПоБезналичнымДенежнымСредствам(БанковскийСчет)
	
	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		Данные = ДанныеПроверкиДопустимостиОперацииПоБанковскомуСчету(БанковскийСчет);
		Если Данные.БанковскийСчетЗакрыт Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Счет закрыт, операция не возможна'");
			Возврат Результат;	
		КонецЕсли;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеПроверкиДопустимостиОперацииПоБанковскомуСчету(БанковскийСчет)
	
	Данные = Новый Структура;
	РеквизитыБанковскогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БанковскийСчет, "Закрыт");
	Данные.Вставить("БанковскийСчетЗакрыт", РеквизитыБанковскогоСчета.Закрыт);
	Возврат Данные;
	 
 КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДопустимостьПеремещенияЗаявки(Заявка, БанковскийСчет, СчетЗакрыт)
	
	Если ЗначениеЗаполнено(БанковскийСчет) И СчетЗакрыт Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Запрещено размещать %1 в закрытом счете %2, операция отменена'"),
			Заявка,
			БанковскийСчет));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДопустимостьВосстановленияОперации(ПредставлениеОперации, БанковскийСчет, СчетЗакрыт)
	
	Если СчетЗакрыт Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Запрещено привлекать, списывать средства и размещать заявки на закрытом счете %1.
				|Операция % 2 отменена'"),
			БанковскийСчет,
			ПредставлениеОперации));
		Возврат Ложь;			
	КонецЕсли;
	
	Возврат Истина;  
	
КонецФункции					
#КонецОбласти

&НаКлиенте
Процедура ПоказатьПомощникВводаПереброскиКонверсии(ЭтоПополнениеСчетаКассы, ЭтоКонвертацияВалюты, ЭтоВнутригрупповоеПеремещение)
	
	ДанныеЯчейки = ТиповыеОтчетыУХ.ПолучитьЗначенияИзРасшифровки(АдресСхемыКомпоновкиДанных, ДанныеРасшифровки, МакетОстатки.ТекущаяОбласть.Расшифровка, "БанковскийСчетКасса,Дата,ВидДенежныхСредств");
	
	ДополнитьДанныеЯчейки(ДанныеЯчейки);
	
	Если Не (ЗначениеЗаполнено(ДанныеЯчейки.БанковскийСчетКасса) И ЗначениеЗаполнено(ДанныеЯчейки.Дата)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось однозначно определить дату и банковский счет / кассу операции.'"));
		Возврат;
	КонецЕсли;
	
	ДанныеОперации = СобратьДанныеОперацииДляПроверки(ДанныеЯчейки,ЭтоКонвертацияВалюты, ЭтоВнутригрупповоеПеремещение);
	
	Если Не ПроверитьДопустимостьОперацииНаКлиенте(ДанныеОперации) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("БанковскийСчетКасса", ДанныеЯчейки.БанковскийСчетКасса);
	ДанныеЗаполнения.Вставить("ВидДенежныхСредств", ДанныеЯчейки.ВидДенежныхСредств);
	ДанныеЗаполнения.Вставить("ДатаНачалаПланирования", Отчет.ПериодОтбора.ДатаНачала);
	ДанныеЗаполнения.Вставить("ДатаОперации", Макс(ДанныеЯчейки.Дата, ДанныеЗаполнения.ДатаНачалаПланирования));
	ДанныеЗаполнения.Вставить("ЭтоПополнениеСчетаКассы", ЭтоПополнениеСчетаКассы);
	ДанныеЗаполнения.Вставить("ЭтоКонвертацияВалюты", ЭтоКонвертацияВалюты);
	ДанныеЗаполнения.Вставить("ЭтоВнутригрупповоеПеремещение", ЭтоВнутригрупповоеПеремещение);
	ДанныеЗаполнения.Вставить("КонечныйОстаток", КонечныйОстаток);
	ДанныеЗаполнения.Вставить("АдресМатрицыВесовЛиквидности", АдресМатрицыВесовЛиквидности(Отчет.МатрицаВесовЛиквидности));
	ДанныеЗаполнения.Вставить("ГоризонтОперативногоПланирования", 	Отчет.ГоризонтОперативногоПланирования);
	ДанныеЗаполнения.Вставить("ГоризонтТактическогоПланирования", 	Отчет.ГоризонтТактическогоПланирования);
	ДанныеЗаполнения.Вставить("ВыводитьОстаткиСУчетомОвердрафтов", 	Отчет.ВыводитьОстаткиСУчетомОвердрафтов);
	ДанныеЗаполнения.Вставить("ОкончаниеПериодаОтбора",				Отчет.ПериодОтбора.ДатаОкончания);  
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьПомощникВводаПереброскиКонверсииЗавершение", ЭтаФорма);
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПереводаКонверсии", Новый Структура("ДанныеЗаполнения", ДанныеЗаполнения),ЭтаФорма,,,,ОписаниеОповещения);
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция АдресМатрицыВесовЛиквидности(Знач МатрицаВесовЛиквидности)
	
	Возврат ПоместитьВоВременноеХранилище(МатрицаВесовЛиквидности.Выгрузить());

КонецФункции

&НаКлиенте
Процедура ПоказатьПомощникВводаПереброскиКонверсииЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	НоваяОперация = ПрогнозныеОперации.Добавить(); 
	ЗаполнитьЗначенияСвойств(НоваяОперация, Результат);
	ЗаполнитьЗначенияСвойств(НоваяОперация, Результат.УточнениеОперации, "ОрганизацияСписания, ОрганизацияЗачисления, БанковскийСчетКассаСписания, БанковскийСчетКассаЗачисления, ВалютаСписания, ВалютаЗачисления,
		| ДатаЗачисления, ДатаСписания, БанкЗачисления, БанкСписания");
		
	ПриИзмененииПрогнозныхОпераций();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность"); 
	
КонецПроцедуры

