	Запрос.УстановитьПараметр("Пользователь", Отчет.Пользователь);
	
	ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса = ДенежныеСредстваВстраиваниеУХКлиентСервер.ИмяТипаБанковскиеСчетаОрганизацийДляЗапроса();
	
	ИсточникиДанныхЗапроса = Новый Массив;
	ИсточникиДанныхЗапроса.Добавить("ПредставлениеПлатежногоКалендаря");
	ИсточникиДанныхЗапроса.Добавить("ВТ_НовоеРазмещениеЗаявок");
	
	Для Каждого ИмяИсточникаДанныхЗапроса Из ИсточникиДанныхЗапроса Цикл
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&"+ИмяИсточникаДанныхЗапроса+"ПолеСчетЗакрыт"
											,Отчеты.ПлатежныйКалендарьУХ.ТекстПоляСчетЗакрытДляЗапроса(ИмяИсточникаДанныхЗапроса));
	КонецЦикла;
						
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	НомерЗапроса = РезультатЗапроса.Количество();	
	НомерЗапроса = НомерЗапроса - 1;
	ВыборкаОперации = РезультатЗапроса[НомерЗапроса].Выбрать();
	
	НомерЗапроса = НомерЗапроса - 1;
	ТабНовыеЗаписи = РезультатЗапроса[НомерЗапроса].Выгрузить();
	ТабНовыеЗаписи.Индексы.Добавить("ИдентификаторДобавившейОперации");
	
	НомерЗапроса = НомерЗапроса - 1;
	ТабОтмененныеЗаписи = РезультатЗапроса[НомерЗапроса].Выгрузить();
	ТабОтмененныеЗаписи.Индексы.Добавить("ИдентификаторОтменившейОперации");

	Пока ВыборкаОперации.Следующий() Цикл
		НовыеЗаписи = ТабНовыеЗаписи.НайтиСтроки(Новый Структура(
			"ИдентификаторДобавившейОперации", ВыборкаОперации.ИдентификаторОперации));
		
		Успех = Истина;
		НачатьТранзакцию();
		Для каждого Запись Из НовыеЗаписи Цикл		
						
			Если НЕ ПроверитьДопустимостьВосстановленияОперации(ВыборкаОперации.ПредставлениеОперации, 
					Запись.БанковскийСчетКасса, Запись.СчетЗакрыт) Тогда
					
				Успех = Ложь;	 
				Прервать;
			КонецЕсли;
			
			МенеджерЗаписи = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Запись);
			МенеджерЗаписи.Пользователь = Отчет.Пользователь;
			МенеджерЗаписи.Записать();
			
		КонецЦикла;
		
		Если Успех Тогда
			ОтмененныеЗаписи = ТабОтмененныеЗаписи.НайтиСтроки(Новый Структура(
				"ИдентификаторОтменившейОперации", ВыборкаОперации.ИдентификаторОперации));
			
			Для каждого Запись Из ОтмененныеЗаписи Цикл	
				МенеджерЗаписи = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();		
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Запись);
				МенеджерЗаписи.Прочитать();
				МенеджерЗаписи.Активна = Запись.АктивнаВариант;
				МенеджерЗаписи.ИдентификаторОтменившейОперации = Запись.ИдентификаторОтменившейОперацииВариант;
				МенеджерЗаписи.Записать();
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
			НоваяОперация = ПрогнозныеОперации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяОперация, ВыборкаОперации,,"УточнениеОперации");
			НоваяОперация.УточнениеОперации = ВыборкаОперации.УточнениеОперации.Получить();

		Иначе
			ОтменитьТранзакцию();
		КонецЕсли;
				
	КонецЦикла;
	
	ПриИзмененииПрогнозныхОпераций();
	
	УстановитьТекстПериодичностиСУчетомСклонения();

