#Область ПеременныеФормы
&НаКлиенте
Перем ПеременныеКлиента;

&НаКлиенте
Перем ОтветПередЗакрытием;

&НаКлиенте
Перем ТекОбласть;
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	// Адрес СКД должен быть всегда.
	ОтчетМенеджер = Отчеты.ПлатежныйКалендарьУХ;
	АдресСхемыКомпоновкиДанных 	= ПоместитьВоВременноеХранилище(ОтчетМенеджер.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"), УникальныйИдентификатор);
	Отчет.АдресМакетаОформления = ПоместитьВоВременноеХранилище(ОтчетМенеджер.ПолучитьМакет("МакетОформления"), УникальныйИдентификатор);
	Отчет.АдресХранилищаТаблицыОстатковИОборотов = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	Отчет.АдресХранилищаДанныхДоговоров = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	УстановитьУсловноеОформление();
	ВыводитьСумму 					= Истина;
	РежимВыводаПанелиДетали 		= "Справа";
	Отчет.ИсточникВходящихОстатков 	= "ПоВыписке";
	ИспользоватьДоверительныеКоэффициенты 			= ПолучитьФункциональнуюОпцию("ИспользоватьДоверительныеКоэффициенты"); 
	ИспользоватьЗаявкиНаПривлечениеФинансирования 	= ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаПривлечениеФинансирования");
	
	Функциональность = Константы.ФункциональностьПлатежногоКалендаря.Получить();			
	Отчет.ЭтоБазоваяФункциональность = (Функциональность = Перечисления.ФункциональностьПлатежногоКалендаря.Базовая); 
	
	Отчет.РежимВыводаОборотов 			= Перечисления.РежимыВыводаОборотовПлатежногоКалендаря.НеВыводить;
	Отчет.ВариантПлатежногоКалендаря 	= Перечисления.ВариантыПлатежногоКалендаря.ПерспективноеПланирование;
	Отчет.ВалютаОтображения 			= ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуУправленческогоУчета();
	Отчет.ЧислоДнейОперативногоПланирования 			= Макс(Константы.ГоризонтПодневногоПланирования.Получить(), 1);
	Отчет.ГлубинаОтображенияПросроченныхПлатежей 		= Константы.ГлубинаОтображенияПросроченныхПлатежей.Получить();
	Отчет.Пользователь 					= Пользователи.ТекущийПользователь();
	Отчет.ПроизводственныйКалендарь		= КалендарныеГрафикиУХВызовСервераПовтИсп.ОсновнойПроизводственныйКалендарь();
	Отчет.СценарийСтрессТестированияЛиквидности 		= Справочники.СценарииСтрессТестированияЛиквидности.РучнаяНастройка;
	
	Если Не Отчет.ЭтоБазоваяФункциональность Тогда
		Отчет.КоличествоПериодовДолгосрочногоПланирования = Макс(Константы.КоличествоПериодовДолгосрочногоПланирования.Получить(), 1);	
	КонецЕсли;
	
	ПараметрыБюджета = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств);
	Отчет.ПериодичностьОперативногоПланирования = ПериодичностьОперативногоПланирования(ПараметрыБюджета);
	
	ОбновитьПлановыеКурсы();
	
	ОбновитьЗаголовокФормы(ЭтаФорма);
	
	Если ХранилищеСистемныхНастроек.ПолучитьОписание("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаОтчета/ТекущиеДанные") = Неопределено Тогда
		ДозаполнитьПериодОтбора(ЭтаФорма, ТекущаяДатаСеанса());
		ПолучитьМакетИВывестиОтчет();  
		ЗаполнитьИсточникиДанных();
	КонецЕсли;
	
	ОбновитьЗаголовокФормы(ЭтаФорма);
	
	ЗаполнитьНастройкиОптимизации();             
	
	ОтображениеВсехОперацийИлиПоЯчейке = Истина;
	
	ПриИзмененииПрогнозныхОпераций();
	
	ПлатежныеДниНедели.ЗагрузитьЗначения(ОтчетМенеджер.ПлатежныеДниНедели());
		
	ЗаполнитьГруппировкиОтчета(Отчет.ГруппировкиОтчета);
	
	УстановитьТекстПериодичностиСУчетомСклонения();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПрогнозныхОпераций() Экспорт
	
	УстановитьОтборОперацийНаСервере();
	КоличествоПрогнозныхОпераций = ПрогнозныеОперации.Количество(); 
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДетализацииОборотов()
	
	КоличествоДетализацииОборотов = ДетализацияОборотов.Количество();  
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	// Если группировка поменялась в коде, то вернем сохраненную группировку к значению по умолчанию
	СохраненныеГруппировкиОтчета = Настройки.Получить("Отчет.ГруппировкиОтчета");
	
	Если Не СохраненныеГруппировкиОтчета = Неопределено Тогда
		
		Если Не ОбщегоНазначенияКлиентСервер.СпискиЗначенийИдентичны(СохраненныеГруппировкиОтчета,Отчет.ГруппировкиОтчета) Тогда
			
			Настройки.Вставить("Отчет.ГруппировкиОтчета",Отчет.ГруппировкиОтчета);	
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ПереопределитьРеквизитыСУчетомФункциональности();
	УстановитьВариантОтчета();
	УстановитьРасположениеПанелиДетали();
	ДозаполнитьПериодОтбора(ЭтаФорма, ТекущаяДатаСеанса());
	ПолучитьМакетИВывестиОтчет();
	СчитатьТаблицуПлановыхКурсов();
	ОбновитьЗаголовокФормы(ЭтотОбъект);
	УстановитьВидимостьДоступность(ЭтотОбъект);
	ПриИзмененииГруппировокОтчета();
	ВывестиНадписьВалютаОтображения(ЭтотОбъект);
	
	ЗаполнитьВариантыОптимизации(Настройки["НастройкаВариантовОптимизации"]);
	ЗаполнитьИсточникиДанных(Настройки["ИсточникиДанных"]);
	                
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ПеременныеКлиента = Новый Структура;
	ПеременныеКлиента.Вставить("ИнтервалОжидания", ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.2));
	
	УправлениеПометкамиКомандСправочнойИнформации();
	
	ПараметрыОжиданияПодготовкиДанных("ОткрытиеОтчета");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		ОтветПередЗакрытием = Истина;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'При закрытии несохраненные данные будут потеряны. Закрыть форму?'");
	
	Если Не ЗавершениеРаботы Тогда
		Если ОтветПередЗакрытием <> Истина Тогда
			Отказ = Истина;
			Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	Иначе
		Отказ = Истина;
		ТекстПредупреждения = ТекстВопроса;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтветПередЗакрытием = Истина;
		Закрыть();
	 Иначе
        ОтветПередЗакрытием = Неопределено;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если Не ЗавершениеРаботы Тогда
		ПриЗакрытииНаСервере();
	Иначе
		// Не очищаем данные, т.к. серверные вызовы запрещены в подобной ситуации. Данные будут заменены при следующим обращении пользователя к ним.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеНастроекДетализации" И Источник = ЭтотОбъект Тогда
		
		ЗаполнитьЗначенияСвойств(Отчет, Параметр);
		ОбновитьТаблицуОборотов();
		
	ИначеЕсли ИмяСобытия = "ПроведенРеестрПлатежей" Тогда	
		
		ОбработатьИзменениеРеестраПлатежейНаСервере(Источник);
		
	ИначеЕсли ИмяСобытия = "ПеренесеныДатыЗаявок" Тогда	
		
		Если ТипЗнч(Параметр.Дата) = Тип("Дата")  Тогда
			ТекстОшибки = "";
			Если Не ПроверитьДопустимостьПлатежногоДня(Параметр.Дата, ПлатежныеДниНедели, ТекстОшибки) Тогда
				ПоказатьПредупреждение(, ТекстОшибки);
				Возврат;
			КонецЕсли;
		КонецЕсли; 
		
		РазместитьПозиции(Параметр.ИдентификаторыЗаписей,Параметр.Дата);
		
	ИначеЕсли ИмяСобытия = "ОбновитьПлатежныхКалендарь" Тогда
		
		Если Отчет.ИсточникВходящихОстатков = "ПоОперативнымДанным" И Отчет.ПериодОтбора.ДатаНачала = НачалоДня(Параметр) Тогда
			АктуализироватьДанныеССохранениемОпераций();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	Настройки.Вставить("НастройкаВариантовОптимизации", Отчет.НастройкаВариантовОптимизации.Выгрузить());
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияДополнительныеСведенияНажатие(Элемент)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДополнительныеСведения",Отчет.ДополнительныеСведения);
	ПараметрыОткрытия.Вставить("ФиксироватьДополнительныеСведения",Отчет.ФиксироватьДополнительныеСведения);
	
	Оповещение = Новый ОписаниеОповещения("ПослеНастройкиДополнительныхСведений",ЭтотОбъект);
	
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаНастроекДополнительныхСведений",ПараметрыОткрытия,ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ГлубинаАнализаЭкстраполяцииДенежныхПотоковПриИзменении(Элемент)
	
	АктуализироватьДанныеССохранениемОпераций();  
	УстановитьТекстПериодичностиСУчетомСклонения();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиДанныхПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьПослеИзмененияИсточниковДанных", ЭтотОбъект);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ИсточникиДанных", ИсточникиДанных);	
	
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаВыбораИсточниковДанных",
			ПараметрыОткрытияФормы, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеИзмененияИсточниковДанных(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьИсточникиДанных(Результат);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");
	
КонецПроцедуры          

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
 	ТекущаяОбластьОстатки = Элементы.Остатки.ТекущаяОбласть;
	
	Если ТипЗнч(ТекущаяОбластьОстатки) = Тип("РисунокТабличногоДокумента") Тогда
		Возврат;
	КонецЕсли;       
	
	КонОстаток = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ТекущаяОбластьОстатки.Текст);
	РассчитыватьОстатокВДетализации = (КонОстаток <> Неопределено);
	
	Если ТекОбласть = Неопределено
		ИЛИ ТекОбласть <> ТекущаяОбластьОстатки Тогда

		Если ТипЗнч(ТекОбласть) = Тип("ОбластьЯчеекТабличногоДокумента")  Тогда
			ТекОбластьЛево = ТекущаяОбластьОстатки.Лево;
			ТекОбластьВерх = ТекущаяОбластьОстатки.Верх;
			ТекОбласть.Узор = ТипУзораТабличногоДокумента.БезУзора;
		КонецЕсли;
		
		ТекОбласть = ТекущаяОбластьОстатки; 
		
		ОформлениеТекущейОбласти();
        	
		ПодключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииОбласти", ПеременныеКлиента.ИнтервалОжидания, Истина);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РезультатПриАктивизацииОбласти()
	
	Если ТекОбласть <> Неопределено Тогда
		
		РассчитатьПоказателиВыделенныхЯчеек();
		Если ТекОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			ТекРасшифровка = ТекОбласть.Расшифровка;
			Если ТекРасшифровка <> Неопределено Тогда
				ВывестиДеталиНаСервере(ТекРасшифровка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки,
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет));
		
	// Ограничим доступные действия расшифровки
	ДоступныеДействия = Новый Массив();
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	
	ДополнительныеПараметры = Новый Структура("Расшифровка", Расшифровка);
	ОписаниеОповещения = Новый ОписаниеОповещения("РезультатОбработкаДополнительнойРасшифровкиПродолжение", ЭтаФорма, ДополнительныеПараметры);
	
	// Осуществим выбор действия расшифровки пользователем.
	ОбработкаРасшифровки.ПоказатьВыборДействия (
		ОписаниеОповещения,
		Расшифровка, 
		ДоступныеДействия,
		ДополнительныеПунктыМеню(),
		,
		Элементы.Остатки);
		
КонецПроцедуры

&НаКлиенте
Функция ДополнительныеПунктыМеню()
	
	СписокДействийПривлечь = Новый СписокЗначений;
	СписокДействийПривлечь.Добавить(СтруктураПараметровФункцииОперации(Истина, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПереводСобственныхСредств")), 
									НСтр("ru = 'Перевод собственных средств'"),, БиблиотекаКартинок.ПополнениеСчета);
	СписокДействийПривлечь.Добавить(СтруктураПараметровФункцииОперации(Истина, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты")), 
									НСтр("ru = 'Приобретение валюты счета'"),, БиблиотекаКартинок.ПокупкаВалюты);
	СписокДействийПривлечь.Добавить(СтруктураПараметровФункцииОперации(Истина, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение")), 
									НСтр("ru = 'Внутригрупповое финансирование'"),, БиблиотекаКартинок.ВозвратВыданногоЗайма16);
	СписокДействийПривлечь.Добавить(СтруктураПараметровФункцииОперации(Истина, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования")), 
									НСтр("ru = 'Привлечение кредита'"),, БиблиотекаКартинок.ПолучениеКредита16);
	
	СписокДействийРазместить = Новый СписокЗначений;
	СписокДействийРазместить.Добавить(СтруктураПараметровФункцииОперации(Ложь, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПереводСобственныхСредств")), 
									НСтр("ru = 'Перевод собственных средств'"),, БиблиотекаКартинок.СписаниеСоСчета);
	СписокДействийРазместить.Добавить(СтруктураПараметровФункцииОперации(Ложь, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты")), 
									НСтр("ru = 'Продажа валюты счета'"),, БиблиотекаКартинок.ПродажаВалюты);
	СписокДействийРазместить.Добавить(СтруктураПараметровФункцииОперации(Ложь, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение")), 
									НСтр("ru = 'Внутригрупповое финансирование'"),, БиблиотекаКартинок.ВыдачаЗайма16);
	СписокДействийРазместить.Добавить(СтруктураПараметровФункцииОперации(Ложь, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.РазмещениеСредств")), 
									НСтр("ru = 'Размещение на депозите'"),, БиблиотекаКартинок.ПогашениеПолученногоКредита16);
	СписокДействийРазместить.Добавить(СтруктураПараметровФункцииОперации(Ложь, ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПогашениеКредита")), 
									НСтр("ru = 'Погашение кредита'"),, БиблиотекаКартинок.ПогашениеПолученногоКредита16);
	
	СписокРезультат = Новый СписокЗначений;
	СписокРезультат.Добавить(СписокДействийПривлечь, НСтр("ru = 'Пополнить'"),,БиблиотекаКартинок.ЗначокПлюс);
	СписокРезультат.Добавить(СписокДействийРазместить, НСтр("ru = 'Списать'"),,БиблиотекаКартинок.ЗначокМинус);
	
	Возврат СписокРезультат; 
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураПараметровФункцииОперации(ЭтоПополнениеСчетаКассы, ВидОперации)
	
	Возврат Новый Структура("ЭтоПополнениеСчетаКассы, ВидОперации",
		ЭтоПополнениеСчетаКассы,
		ВидОперации);
	
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровкиПродолжение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ВыполненноеДействие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		
		ПоказатьЗначение(,ПараметрВыполненногоДействия);
		
	ИначеЕсли ТипЗнч(ВыполненноеДействие) = Тип("Структура") Тогда
		
		Если ВыполненноеДействие.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПогашениеКредита") Тогда
			
			ПоказатьФормуЗакрытияКредитов();
			
		ИначеЕсли ВыполненноеДействие.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.РазмещениеСредств") Тогда
			
			ЭтоПополнениеСчетаКассы = Ложь;
			ФинансовыеИнструментыСоздать(ЭтоПополнениеСчетаКассы);
			
		ИначеЕсли ВыполненноеДействие.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования") Тогда
			
			ЭтоПополнениеСчетаКассы = Истина;
			ФинансовыеИнструментыСоздать(ЭтоПополнениеСчетаКассы);
			
		Иначе
			
			ЭтоКонвертацияВалюты = (ВыполненноеДействие.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты"));
			ЭтоВнутригрупповоеПеремещение = (ВыполненноеДействие.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение"));
			
			ПоказатьПомощникВводаПереброскиКонверсии(
				ВыполненноеДействие.ЭтоПополнениеСчетаКассы, 
				ЭтоКонвертацияВалюты, 
				ЭтоВнутригрупповоеПеремещение);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоВидуОперацииПриИзменении(Элемент)
		
	УстановитьОтборОперацийНаСервере();
	
