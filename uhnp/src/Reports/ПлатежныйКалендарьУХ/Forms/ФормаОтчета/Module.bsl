&НаКлиенте
Процедура ДополнитьДанныеЯчейки(ДанныеЯчейки)
	
	Если Отчет.ВариантПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.ВариантыПлатежногоКалендаря.ПланированиеОднимДнем") Тогда
		
		ДанныеЯчейки.Вставить("Дата",Отчет.ПериодОтбора.ДатаНачала);	
		
	КонецЕсли;
	
	Если ДанныеЯчейки.Свойство("БанковскийСчетКасса") 
		И ЗначениеЗаполнено(ДанныеЯчейки.БанковскийСчетКасса)
		И ДанныеЯчейки.Свойство("ВидДенежныхСредств")  
		И Не ЗначениеЗаполнено(ДанныеЯчейки.ВидДенежныхСредств) Тогда
		
		Если ТипЗнч(ДанныеЯчейки.БанковскийСчетКасса) = Тип("СправочникСсылка.Кассы") Тогда
			ВидДенежныхСредств = ПредопределенноеЗначение("Перечисление.ФормыОплаты.Наличная");
		Иначе 
			ВидДенежныхСредств = ПредопределенноеЗначение("Перечисление.ФормыОплаты.Безналичная");
		КонецЕсли;
		
		ДанныеЯчейки.Вставить("ВидДенежныхСредств", ВидДенежныхСредств);	
		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьРежимВыводаОборотов()

	Если ВыводитьОбороты(Отчет.РежимВыводаОборотов) 
		И Отчет.ВариантПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.ВариантыПлатежногоКалендаря.ПланированиеОднимДнем") Тогда
		
		Отчет.РежимВыводаОборотов = ПредопределенноеЗначение("Перечисление.РежимыВыводаОборотовПлатежногоКалендаря.НеВыводить");	
	КонецЕсли;
	
	Элементы.РежимВыводаОборотов.Видимость = 
		Отчет.ВариантПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.ВариантыПлатежногоКалендаря.ПерспективноеПланирование");
	
КонецПроцедуры

