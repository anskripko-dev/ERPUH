&НаКлиенте
Процедура ПоказатьФормуЗакрытияКредитов()
	
	ДеталиОперации = ТиповыеОтчетыУХ.ПолучитьЗначенияИзРасшифровки(АдресСхемыКомпоновкиДанных, ДанныеРасшифровки, 
		Элементы.Остатки.ТекущаяОбласть.Расшифровка, "БанковскийСчетКасса,Дата,Организация,Валюта");
	
	Если ДеталиОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДеталиОперации.Валюта) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не определена валюта'"));
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДеталиОперации.Организация) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не определена организация'"));
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДеталиОперации.Дата) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не определена дата'"));
		Возврат;
		
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Организация", ДеталиОперации.Организация);
	СтруктураПараметров.Вставить("ДатаНачала", Макс(ДеталиОперации.Дата, Отчет.ПериодОтбора.ДатаНачала));
	СтруктураПараметров.Вставить("Валюта", ДеталиОперации.Валюта);
	СтруктураПараметров.Вставить("БанковскийСчетКасса", ДеталиОперации.БанковскийСчетКасса);
	СтруктураПараметров.Вставить("КонечныйОстаток", КонечныйОстаток);

	ОписаниеОповещения = Новый ОписаниеОповещения("ПогашениеКредитаПродолжение", ЭтотОбъект, ДеталиОперации);
	
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПогашенияКредита",
		Новый Структура("ДанныеЗаполнения", СтруктураПараметров), ЭтотОбъект,,,,ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ПогашениеКредитаПродолжение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьПогашениеКредита(Результат);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");   
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПогашениеКредита(СтруктураПараметров, СтрокаТекущейОперации = Неопределено)
	
	// Добавим новую операцию.  
	ПредставлениеОперации = ПолучитьПредставлениеОперации(СтруктураПараметров);
		
	НоваяОперация = ДобавитьОперациюПогашенияКредита(
		СтруктураПараметров.ВидОперации,
		СтруктураПараметров, 
		ПредставлениеОперации,,,СтрокаТекущейОперации);
	
	СтруктураПараметров.Вставить("Пользователь", Отчет.Пользователь);
	СтруктураПараметров.Вставить("Активна", НоваяОперация.Активна);
	СтруктураПараметров.Вставить("Банк", СтруктураПараметров.БанковскийСчетКасса.Банк);
	СтруктураПараметров.Вставить("ПулЛиквидности", СтруктураПараметров.БанковскийСчетКасса.ПулЛиквидности);
	СтруктураПараметров.Вставить("ИдентификаторДобавившейОперации", НоваяОперация.ИдентификаторОперации);
	СтруктураПараметров.Вставить("Инструмент", ПредставлениеОперации);		
			
	МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, СтруктураПараметров);
	МЗ.РазделПлатежногоКалендаря = Перечисления.РазделыПлатежногоКалендаря.СписаниеСредств;		
	МЗ.Дата = СтруктураПараметров.ДатаПогашения;
	МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
	МЗ.Сумма = -СтруктураПараметров.Сумма;
	МЗ.Записать();		
	
	ОтменитьИмеющиесяОперацииПоКредиту(СтруктураПараметров.ФинансовыйИнструмент, НоваяОперация.ИдентификаторОперации); 
	
	ПриИзмененииПрогнозныхОпераций();	

КонецПроцедуры

&НаСервере
Процедура ОтменитьИмеющиесяОперацииПоКредиту(ДоговорКредита, ИдентификаторОтменившейОперации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|		ПО ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи = РазмещениеЗаявок.ИдентификаторПозиции
	|			И ПредставлениеПлатежногоКалендаря.Инструмент = РазмещениеЗаявок.ЗаявкаНаОперацию
	|ГДЕ
	|	РазмещениеЗаявок.ДоговорКонтрагента = &ДоговорКредита";
	Запрос.УстановитьПараметр("ДоговорКредита", ДоговорКредита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(Выборка.ИдентификаторЗаписи);
		НаборЗаписей.Прочитать();
		Для Каждого ТекЗапись Из НаборЗаписей Цикл
			ТекЗапись.Активна = Ложь;
			ТекЗапись.ИдентификаторОтменившейОперации = ИдентификаторОтменившейОперации;
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьОперациюПогашенияКредита(Знач ВидОперации, Знач УточнениеОперации, Знач ПредставлениеОперации, Знач ИдентификаторОперации = Неопределено, Оптимизация = Ложь, СтрокаОперации = Неопределено)
	
	Если ИдентификаторОперации = Неопределено Тогда
		ИдентификаторОперации = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если СтрокаОперации <> Неопределено Тогда
		НоваяОперация = СтрокаОперации;
	Иначе	
		НоваяОперация = ПрогнозныеОперации.Добавить();
		НоваяОперация.Активна = Истина;
	КонецЕсли;	
	
	НоваяОперация.ВидОперации = ВидОперации;
	НоваяОперация.УточнениеОперации = УточнениеОперации;
	НоваяОперация.ПредставлениеОперации = ПредставлениеОперации;
	НоваяОперация.ИдентификаторОперации = ИдентификаторОперации;
	НоваяОперация.ОрганизацияЗачисления = УточнениеОперации.Организация;
	НоваяОперация.БанковскийСчетКассаЗачисления = УточнениеОперации.БанковскийСчетКасса;
	НоваяОперация.ВалютаЗачисления = УточнениеОперации.Валюта;
	НоваяОперация.БанкЗачисления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УточнениеОперации.БанковскийСчетКасса, "Банк");
	НоваяОперация.ДатаСписания = НачалоДня(УточнениеОперации.ДатаПогашения);
	
	Возврат НоваяОперация;
	
КонецФункции

&НаСервере
Процедура ЗапланироватьДосрочноеПогашениеКредита(Операция,УспешныеОперации)
	
	ВерсияСоглашения = Документы.ВерсияСоглашенияКредит.СоздатьДокумент();
	ВерсияСоглашения.Дата = ТекущаяДатаСеанса();  
	ВерсияСоглашения.Реструктуризован = Истина;
	ВерсияСоглашения.Заполнить(Операция.УточнениеОперации.ФинансовыйИнструмент);
	
	ОписаниеГрафика = Документы.ВерсияСоглашенияКредит.ОписаниеГрафика(ВерсияСоглашения.ВидДоговораУХ);
	
	ОперацииГрафика = РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафика, ВерсияСоглашения);
	
	ДатаПогашения = Операция.ДатаСписания;
		
	РаботаСДоговорамиКонтрагентовУХ.ДобавитьПозициюВГрафик(ВерсияСоглашения.ГрафикРасчетов, 
															?(ЗначениеЗаполнено(Операция.УточнениеОперации.СуммаСписания),Операция.УточнениеОперации.СуммаСписания,Операция.УточнениеОперации.Сумма),
															ДатаПогашения,
															,
															ОперацииГрафика[Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат]);   														
															
	ВерсияСоглашения.ГрафикРасчетов.Сортировать("Дата");
	ВерсияСоглашения.БанковскийСчет = Операция.УточнениеОперации.БанковскийСчетКасса;
	СтруктураДействий = Новый Структура;
	СекцииОсновнойДолг = Новый Массив;
	СекцииОсновнойДолг.Добавить("ОсновнойДолг");
	СтруктураДействий.Вставить("Замкнуть", Новый Структура("СекцииГрафика", СекцииОсновнойДолг));
	
	СекцииПроценты = Новый Массив;
	СекцииПроценты.Добавить("Проценты");
	ДопПараметры = Новый Структура("ДатаНачалаПересчета", ДатаПогашения);
	СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика, ДопПараметры", СекцииПроценты, ДопПараметры));														
	
	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = Операция.ВидОперации;	
	
	Попытка
		ФинансовыеИнструментыУХ.ПересчетГрафика(ВерсияСоглашения, 0, ОписаниеГрафика, ОперацииГрафика, СтруктураДействий);
		ВерсияСоглашения.Записать(РежимЗаписиДокумента.Проведение);  
		РезультатВыполненияОперации.ОбъектСистемы = ВерсияСоглашения.Ссылка;
		УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВСостояниеУтверждена(ВерсияСоглашения.Ссылка);   
		
		// Создаем заявки на оплату по новому графику на дату погашения    
		СоздатьЗаявкуНаОплатуПоГрафикуРасчетовДоговора(ВерсияСоглашения, ДатаПогашения, Операция);
		
		УспешныеОперации.Добавить(Операция);
	Исключение   
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки; 
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);	
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаявкуНаОплатуПоГрафикуРасчетовДоговора(ВерсияСоглашения, ДатаПогашения, Операция)

	ПараметрыСозданияЗаявки = Новый Структура;

	ПараметрыСозданияЗаявки.Вставить("Ссылка", ВерсияСоглашения.Ссылка);
	ПараметрыСозданияЗаявки.Вставить("ДоговорКонтрагента", ВерсияСоглашения.ДоговорКонтрагента);  
	ПараметрыСозданияЗаявки.Вставить("ДатаНачалаДействия", ДатаПогашения);  
	ПараметрыСозданияЗаявки.Вставить("ДатаОкончанияДействия", ДатаПогашения);        
	ПараметрыСозданияЗаявки.Вставить("ВызовИзПлатежногоКалендаря");        
	ПараметрыСозданияЗаявки.Вставить("Результат");        
	
	ДоговорыКонтрагентовФормыУХ.ОбновитьЗаявкиПоГрафикуОплаты(ПараметрыСозданияЗаявки);
	
	Если ТипЗнч(ПараметрыСозданияЗаявки.Результат) = Тип("Массив") Тогда 
		Для Каждого Заявка Из ПараметрыСозданияЗаявки.Результат Цикл   
			РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();  
			РезультатВыполненияОперации.ОбъектСистемы = Заявка;
			РезультатВыполненияОперации.Операция = Операция.ВидОперации;	
			ДобавитьОперациюВПротокол(РезультатВыполненияОперации);		
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ГруппировкиОтчета
&НаСервере
Процедура ЗаполнитьГруппировкиОтчета(ГруппировкиОтчета)
	
	ГруппировкиОтчета.Очистить();
	ГруппировкиОтчета.Добавить("Валюта", НСтр("ru = 'Валюта'"), Истина);
	ГруппировкиОтчета.Добавить("ВидДенежныхСредств", НСтр("ru = 'Вид денежных средств'"), Истина);
	ГруппировкиОтчета.Добавить("ПулЛиквидности", НСтр("ru = 'Пул ликвидности'"), Истина);
	ГруппировкиОтчета.Добавить("Организация", НСтр("ru = 'Организация'"), Истина);
	ГруппировкиОтчета.Добавить("Банк", НСтр("ru = 'Банк'"), Истина);
	ГруппировкиОтчета.Добавить("БанковскийСчетКасса", НСтр("ru = 'Банковский счет / Касса'"), Истина);
	
	ДобавитьКомандыСвернутьДоУровня(ГруппировкиОтчета);
	
	ПредставлениеГруппировокОтчета = ПредставлениеГруппировокОтчета(ЭтотОбъект, "ГруппировкиОтчета");
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеГруппировокОтчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	                                         
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ГруппировкиОтчета", Отчет.ГруппировкиОтчета);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПредставлениеГруппировокОтчетаНачалоВыбораЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаНастройкиГруппировок", ПараметрыОткрытия, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеГруппировокОтчетаНачалоВыбораЗавершение(СписокГруппировок, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(СписокГруппировок) = Тип("СписокЗначений") Тогда
		
		Отчет.ГруппировкиОтчета = СписокГруппировок.Скопировать();
		ПриИзмененииГруппировокОтчета(); 

		ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГруппировокОтчета()
	
	ВыполнитьИсправлениеГруппировокОтчета(ЭтотОбъект, Отчет);
	ЗаполнитьМенюСвернутьДоУровня(Отчет.ГруппировкиОтчета);
	ЭтотОбъект.ПредставлениеГруппировокОтчета = ПредставлениеГруппировокОтчета(ЭтотОбъект, "ГруппировкиОтчета");  
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВыполнитьИсправлениеГруппировокОтчета(ЭтаФорма, Отчет)
	
	ГруппировкиИзменены = Ложь;
	
	Если Не Отчет.ВыводитьДанныеВВалютеОтображения Тогда
		// первой должна быть валюта, для корректных итогов
		Если Отчет.ГруппировкиОтчета[0].Значение <> "Валюта" ИЛИ НЕ Отчет.ГруппировкиОтчета[0].Пометка Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'При выводе данных в валюте операции первая группировка должна быть ""Валюта"".
                      |Группировки скорректированы'"),,"ПредставлениеГруппировокОтчета");
			Элемент = Отчет.ГруппировкиОтчета.НайтиПоЗначению("Валюта");
			Индекс = Отчет.ГруппировкиОтчета.Индекс(Элемент);
			Если Индекс <> 0 Тогда
				Отчет.ГруппировкиОтчета.Сдвинуть(Элемент, -Индекс);
			КонецЕсли;
			
			Элемент.Пометка = Истина;
			ГруппировкиИзменены = Истина;
					
		КонецЕсли;

	КонецЕсли;
	
	Возврат ГруппировкиИзменены;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеГруппировокОтчета(Форма, ИмяСпискаГруппировок)
	
	Группировки = Форма.Отчет[ИмяСпискаГруппировок];
	
	Представление = "";
	Для каждого ЭлГруппировка Из Группировки Цикл
		Если ЭлГруппировка.Пометка Тогда
			Представление = Представление + "," + ЭлГруппировка.Представление;
		КонецЕсли;	
	КонецЦикла;
	
	Представление = Сред(Представление, СтрДлина(",") + 1);
	
	Возврат Представление;
	
КонецФункции

&НаКлиенте
Процедура ИсправитьГруппировкиОтчета() 
	
	ГруппировкиИзменены = ВыполнитьИсправлениеГруппировокОтчета(ЭтотОбъект, Отчет);
	
	Если ГруппировкиИзменены Тогда
		ЗаполнитьМенюСвернутьДоУровня(Отчет.ГруппировкиОтчета);
		ЭтотОбъект.ПредставлениеГруппировокОтчета = ПредставлениеГруппировокОтчета(ЭтотОбъект, "ГруппировкиОтчета");
	КонецЕсли; 
	 
КонецПроцедуры	 

&НаСервере
Процедура ЗаполнитьМенюСвернутьДоУровня(ГруппировкиОтчета)
	
	ГруппаСвернуть = Элементы.ГруппаСвернутьДоУровня;
	Пока ГруппаСвернуть.ПодчиненныеЭлементы.Количество() > 0 Цикл
		 Элементы.Удалить(ГруппаСвернуть.ПодчиненныеЭлементы[0]);
	КонецЦикла;
	 
	Для каждого ЭлГруппировка Из ГруппировкиОтчета Цикл
		Если ЭлГруппировка.Пометка Тогда
			Кнопка = Элементы.Добавить("КнопкаСвернутьДоУровня" + ЭлГруппировка.Значение, Тип("КнопкаФормы"),
				ГруппаСвернуть);
			Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
			Кнопка.Заголовок = СтрШаблон(НСтр("ru = 'Свернуть до группировки [%1]'"), ЭлГруппировка.Представление);
			Кнопка.ИмяКоманды = ИмяКомандыСвернутьДоУровня(ЭлГруппировка.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяКомандыСвернутьДоУровня(ИмяГруппировки)
	 Возврат "СвернутьДоУровня" + ИмяГруппировки;
КонецФункции

&НаСервере
Процедура ДобавитьКомандыСвернутьДоУровня(ГруппировкиОтчета)
		
	Для каждого ЭлГруппировка Из ГруппировкиОтчета Цикл
		Команда = ЭтотОбъект.Команды.Добавить(
		 	ИмяКомандыСвернутьДоУровня(ЭлГруппировка.Значение));
		Команда.Действие = "Подключаемый_СвернутьДоУровня";	
	КонецЦикла;
	
	ЗаполнитьМенюСвернутьДоУровня(ГруппировкиОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвернутьДоУровня(Команда)
		
	Уровень = УровеньГруппировкиКомандыСвернуть(Команда.Имя, Отчет.ГруппировкиОтчета);
	Если Уровень <> Неопределено Тогда
		 СвернутьТабДокДоУровняГруппировки(МакетОстатки, Уровень);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция УровеньГруппировкиКомандыСвернуть(ИмяКоманды, ГруппировкиОтчета)
	
	Уровень = 0;
	Для каждого ЭлГруппировки Из ГруппировкиОтчета Цикл
		Если ЭлГруппировки.Пометка Тогда
			Если ИмяКоманды = ИмяКомандыСвернутьДоУровня(ЭлГруппировки.Значение) Тогда
				Возврат Уровень;
			КонецЕсли;
			Уровень = Уровень + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура СвернутьТабДокДоУровняГруппировки(ТабДок, Уровень)
	
	ТекУровень = ТабДок.КоличествоУровнейГруппировокСтрок() - 1;
    Пока ТекУровень > Уровень Цикл
        ТабДок.ПоказатьУровеньГруппировокСтрок(ТекУровень);
        ТекУровень = ТекУровень - 1;
    КонецЦикла;
	
	ТабДок.ПоказатьУровеньГруппировокСтрок(Уровень);
	
КонецПроцедуры	

#КонецОбласти