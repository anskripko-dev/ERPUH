	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря КАК ВерсияПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Пользователь КАК Пользователь,
	|	ПредставлениеПлатежногоКалендаря.Активна КАК Активна,
	|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
	|	ПредставлениеПлатежногоКалендаря.Банк КАК Банк,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Инструмент КАК Инструмент,
	|	ПредставлениеПлатежногоКалендаря.Приоритет КАК Приоритет,
	|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации КАК ИдентификаторДобавившейОперации,
	|	ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	ПредставлениеПлатежногоКалендаря.ПулЛиквидности КАК ПулЛиквидности,
	|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
	|	ПредставлениеПлатежногоКалендаря.Сумма КАК Сумма,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации КАК ИдентификаторОтменившейОперации,
	|	ПредставлениеПлатежногоКалендаря.Оптимизация КАК Оптимизация
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации = &ИдентификаторОперации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Пользователь,
	|	ПредставлениеПлатежногоКалендаря.Активна,
	|	ПредставлениеПлатежногоКалендаря.Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта,
	|	ПредставлениеПлатежногоКалендаря.Банк,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса,
	|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Инструмент,
	|	ПредставлениеПлатежногоКалендаря.Приоритет,
	|	ПредставлениеПлатежногоКалендаря.Дата,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации,
	|	ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств,
	|	ПредставлениеПлатежногоКалендаря.ПулЛиквидности,
	|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств,
	|	ПредставлениеПлатежногоКалендаря.Сумма,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации,
	|	ПредставлениеПлатежногоКалендаря.Оптимизация
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации = &ИдентификаторОперации";
	
	Запрос.УстановитьПараметр("ИдентификаторОперации", ИдентификаторОперации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Выборка);
		МЗ.Прочитать();
		МЗ.Активна = НЕ МЗ.Активна;
		Если МЗ.Активна Тогда
			Если ЦелеваяДата <> Неопределено Тогда
				МЗ.Дата = ЦелеваяДата;
			КонецЕсли;
			
			Если ЦелевойСчетКасса <> Неопределено Тогда
				МЗ.БанковскийСчетКасса = ЦелевойСчетКасса;
			КонецЕсли;
		КонецЕсли;
		МЗ.Записать();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();    
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ПрогнозныеОперацииПредставлениеОперации.Имя);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ПрогнозныеОперацииОптимизация.Имя);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ПрогнозныеОперацииОрганизацияСписания.Имя);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ПрогнозныеОперацииОрганизацияЗачисления.Имя);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"ПрогнозныеОперации.Активна", ВидСравненияКомпоновкиДанных.Равно,Ложь,,Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(Элементы.ПрогнозныеОперацииПредставлениеОперации.Шрифт,,,,,,Истина));// Зачеркнутый
	
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ДетализацияОборотовПриоритет.Имя);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"ДетализацияОборотов.Приоритет", ВидСравненияКомпоновкиДанных.НеЗаполнено,,,Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Не указан>'"));
	
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ДетализацияОборотовСуммаОстаток.Имя);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"РассчитыватьОстатокВДетализации", ВидСравненияКомпоновкиДанных.Равно,Ложь,,Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаТолькоПросмотр);
	
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	Для Каждого ТекЭлемент Из Элементы.ДетализацияОборотов.ПодчиненныеЭлементы Цикл
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ТекЭлемент.Имя);
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"ДетализацияОборотов.ПросроченнаяОперация", ВидСравненияКомпоновкиДанных.Равно,Истина,,Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПросроченныеДанныеЦвет);
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыеИнструментыПривлечь(Команда)
	
	ФинансовыеИнструментыСоздать(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыеИнструментыСоздать(ЭтоПривлечениеСредств)
	
	ДеталиОперации = ТиповыеОтчетыУХ.ПолучитьЗначенияИзРасшифровки(АдресСхемыКомпоновкиДанных, ДанныеРасшифровки, 
		Элементы.Остатки.ТекущаяОбласть.Расшифровка, "БанковскийСчетКасса,Дата,Организация,Валюта,ВидДенежныхСредств");
	
	Если ДеталиОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДеталиОперации.Валюта) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не определена валюта инструмента'"));
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДеталиОперации.Организация) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не определена организация'"));
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДеталиОперации.Дата) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не определена дата'"));
		Возврат;
		
	КонецЕсли;
	
	ДанныеОперации = СобратьДанныеОперацииДляПроверки(ДеталиОперации,,,ЭтоПривлечениеСредств);
	
	Если НЕ ПроверитьДопустимостьОперацииНаКлиенте(ДанныеОперации) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Организация", ДеталиОперации.Организация);
	СтруктураПараметров.Вставить("ДатаНачала", Макс(ДеталиОперации.Дата, Отчет.ПериодОтбора.ДатаНачала));
	СтруктураПараметров.Вставить("Валюта", ДеталиОперации.Валюта);
	СтруктураПараметров.Вставить("БанковскийСчетКасса", ДеталиОперации.БанковскийСчетКасса);
	СтруктураПараметров.Вставить("ВидДенежныхСредств", ДеталиОперации.ВидДенежныхСредств);
	СтруктураПараметров.Вставить("ЭтоПривлечениеСредств", ЭтоПривлечениеСредств);
	СтруктураПараметров.Вставить("АдресТаблицыЗапланированныхСделок", АдресТаблицыЗапланированныхСделок(ЭтоПривлечениеСредств));
	СтруктураПараметров.Вставить("КонечныйОстаток", КонечныйОстаток);

	ПараметрыФормы = Новый Структура("ДанныеЗаполнения", СтруктураПараметров);
	ОписаниеОповещения = Новый ОписаниеОповещения("ФинансовыеИнструментыСоздатьПродолжение", ЭтотОбъект, ДеталиОперации);
	
	ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПодбораФинансовыхИнструментов",
		ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыеИнструментыСоздатьПродолжение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьФинансовыйИнструмент(Результат);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность"); 
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыеИнструментыРазместить(Команда)
	
	ФинансовыеИнструментыСоздать(Ложь);

КонецПроцедуры

&НаСервере
Процедура ДобавитьФинансовыйИнструмент(Знач СтруктураПараметров, СтрокаТекущейОперации = Неопределено)
	
	// Добавим новую операцию. 
	ПредставлениеОперации = ПолучитьПредставлениеОперации(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("СуммаПроцентов", (СтруктураПараметров.Сумма * СтруктураПараметров.КоличествоДней * СтруктураПараметров.ПроцентнаяСтавка)/(100 * 365));
	
	Если СтруктураПараметров.ЭтоПривлечениеСредств Тогда
		
		РазделКалендаряНачало = Перечисления.РазделыПлатежногоКалендаря.ПоступлениеСредств;
		ЗнакНачало = 1;
		
		РазделКалендаряОкончание = Перечисления.РазделыПлатежногоКалендаря.СписаниеСредств;
		ЗнакОкончание = -1;
		
		ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования;
		
	Иначе
		
		РазделКалендаряНачало = Перечисления.РазделыПлатежногоКалендаря.СписаниеСредств;
		ЗнакНачало = -1;
		
		РазделКалендаряОкончание = Перечисления.РазделыПлатежногоКалендаря.ПоступлениеСредств;
		ЗнакОкончание = 1;
		
		ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.РазмещениеСредств;
		
	КонецЕсли;
	
	Если НЕ СтруктураПараметров.Свойство("ВидОперации") Тогда
		СтруктураПараметров.Вставить("ВидОперации", ВидОперации);
	КонецЕсли;
	
	НоваяОперация = ДобавитьОперациюФинансовогоИнструмента(
		СтруктураПараметров.ВидОперации,
		СтруктураПараметров, 
		ПредставлениеОперации,,,СтрокаТекущейОперации);
		
	ДанныеБанковскогоСчетаКассы = Отчеты.ПлатежныйКалендарьУХ.ПолучитьДанныеБанковскогоСчетаКассы(СтруктураПараметров.БанковскийСчетКасса);
	
	СтруктураПараметров.Вставить("Пользователь", Отчет.Пользователь);
	СтруктураПараметров.Вставить("Активна", НоваяОперация.Активна);
	СтруктураПараметров.Вставить("Банк", ДанныеБанковскогоСчетаКассы.Банк);
	СтруктураПараметров.Вставить("ПулЛиквидности", ДанныеБанковскогоСчетаКассы.ПулЛиквидности);
	СтруктураПараметров.Вставить("ИдентификаторДобавившейОперации", НоваяОперация.ИдентификаторОперации);
	СтруктураПараметров.Вставить("Инструмент", ПредставлениеОперации);		
	
	// Строка 1: начало.
	МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, СтруктураПараметров);
	МЗ.РазделПлатежногоКалендаря = РазделКалендаряНачало;
	МЗ.Дата = СтруктураПараметров.ПериодИспользования.ДатаНачала;
	МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
	МЗ.Сумма = ЗнакНачало * СтруктураПараметров.Сумма;
	МЗ.Записать();
	
	// Строка 2: Завершение.
	МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, СтруктураПараметров);
	МЗ.РазделПлатежногоКалендаря = РазделКалендаряОкончание;		
	МЗ.Дата = СтруктураПараметров.ПериодИспользования.ДатаОкончания;
	МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
	МЗ.Сумма = ЗнакОкончание * СтруктураПараметров.Сумма;
	МЗ.Записать();		
	
	// Строка 3: Проценты.
	МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, СтруктураПараметров);
	МЗ.РазделПлатежногоКалендаря = РазделКалендаряОкончание;			
	МЗ.Дата = СтруктураПараметров.ПериодИспользования.ДатаОкончания;
	МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
	МЗ.Сумма = ЗнакОкончание * СтруктураПараметров.СуммаПроцентов;
	МЗ.Записать();		
	
	ПриИзмененииПрогнозныхОпераций();
		
КонецПроцедуры

&НаСервере
Функция ДобавитьОперациюФинансовогоИнструмента(Знач ВидОперации, Знач УточнениеОперации, Знач ПредставлениеОперации, Знач ИдентификаторОперации = Неопределено, Оптимизация = Ложь, СтрокаОперации = Неопределено)
	
	Если ИдентификаторОперации = Неопределено Тогда
		ИдентификаторОперации = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если СтрокаОперации <> Неопределено Тогда
		НоваяОперация = СтрокаОперации;
	Иначе	
		НоваяОперация = ПрогнозныеОперации.Добавить();
		НоваяОперация.Активна = Истина;
	КонецЕсли;	
	
	ДанныеБанковскогоСчетаКассы = Отчеты.ПлатежныйКалендарьУХ.ПолучитьДанныеБанковскогоСчетаКассы(УточнениеОперации.БанковскийСчетКасса);
	
	НоваяОперация.ВидОперации = ВидОперации;
	НоваяОперация.УточнениеОперации = УточнениеОперации;
	НоваяОперация.ПредставлениеОперации = ПредставлениеОперации;
	НоваяОперация.ИдентификаторОперации = ИдентификаторОперации;
	НоваяОперация.ОрганизацияЗачисления = УточнениеОперации.Организация;
	НоваяОперация.БанковскийСчетКассаЗачисления = УточнениеОперации.БанковскийСчетКасса;
	НоваяОперация.ВалютаЗачисления = УточнениеОперации.Валюта;
	НоваяОперация.ВидДенежныхСредств = УточнениеОперации.ВидДенежныхСредств;
	НоваяОперация.БанкЗачисления = ДанныеБанковскогоСчетаКассы.Банк;
	НоваяОперация.ДатаЗачисления = УточнениеОперации.ПериодИспользования.ДатаНачала;
	НоваяОперация.ДатаСписания = НачалоДня(УточнениеОперации.ПериодИспользования.ДатаОкончания);
	
	Возврат НоваяОперация;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИндексПользовательскойНастройки(Знач ПутьКДанным)
	
	Позиция1 = СтрНайти(ПутьКДанным, "[");
	Позиция2 = СтрНайти(ПутьКДанным, "]");
	
	Если Позиция1 = 0 ИЛИ Позиция2 = 0 Тогда
		Возврат -1;
	КонецЕсли;
	
	Возврат Число(Сред(ПутьКДанным, Позиция1 + 1, Позиция2 - Позиция1 - 1));
	
КонецФункции

&НаКлиенте
Процедура СохранитьВерсиюПлатежногоКалендаря(Команда)
	
	СтруктураЗаполнения = СтруктураЗаполненияСохраненнойВерсии();
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", СтруктураЗаполнения);
	
	ОткрытьФорму("Справочник.СохраненныеВерсииПлатежногоКалендаря.ФормаОбъекта", 
		ПараметрыФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция СтруктураЗаполненияСохраненнойВерсии()
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Ответственный", Отчет.Пользователь);
	ДанныеЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());
	ДанныеЗаполнения.Вставить("ПериодОтбораДатаНачала", Отчет.ПериодОтбора.ДатаНачала);
	ДанныеЗаполнения.Вставить("ПериодОтбораДатаОкончания", Отчет.ПериодОтбора.ДатаОкончания);
	ДанныеЗаполнения.Вставить("НастройкиКомпоновки", ЗначениеВСтрокуВнутр(Отчет.КомпоновщикНастроек.ПолучитьНастройки()));
	
	ДанныеЗаполнения.Вставить("ЧислоДнейОперативногоПланирования", Отчет.ЧислоДнейОперативногоПланирования);
	ДанныеЗаполнения.Вставить("ГлубинаОтображенияПросроченныхПлатежей", Отчет.ГлубинаОтображенияПросроченныхПлатежей);
	
	ДанныеЗаполнения.Вставить("СписокОпераций", ПоместитьВоВременноеХранилище(ПрогнозныеОперации.Выгрузить(), УникальныйИдентификатор));
	ДанныеЗаполнения.Вставить("ПлановыеКурсы", ПоместитьВоВременноеХранилище(Отчет.ПлановыеКурсы.Выгрузить(), УникальныйИдентификатор));
	ДанныеЗаполнения.Вставить("МатрицаВесовЛиквидности", ПоместитьВоВременноеХранилище(Отчет.МатрицаВесовЛиквидности.Выгрузить(), УникальныйИдентификатор));
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОтчетПоСохраненномуВарианту(Вариант)
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Вариант,"Ответственный") Тогда 
		Возврат;
	КонецЕсли;

	Отчет.Пользователь = Вариант.Ответственный;
	Отчет.ПериодОтбора.ДатаНачала = Вариант.ПериодОтбораДатаНачала;
	Отчет.ПериодОтбора.ДатаОкончания = Вариант.ПериодОтбораДатаОкончания;
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ЗначениеИзСтрокиВнутр(Вариант.НастройкиКомпоновки));
	Отчет.СохраненнаяВерсияПлатежногоКалендаря = Вариант;
	Отчет.ЧислоДнейОперативногоПланирования = Вариант.ЧислоДнейОперативногоПланирования;
	Отчет.ГлубинаОтображенияПросроченныхПлатежей = Вариант.ГлубинаОтображенияПросроченныхПлатежей;
	
	ТаблицаВесов = Вариант.МатрицаВесовЛиквидности.Выгрузить();
	Отчет.МатрицаВесовЛиквидности.Загрузить(ТаблицаВесов);
	МатрицаВесов.Загрузить(РегистрыСведений.МатрицаВесовЛиквидности.КроссТаблицаВесовЛиквидности(ТаблицаВесов));	
	
	Отчет.ПлановыеКурсы.Загрузить(Вариант.ПлановыеКурсы.Выгрузить());
	ЗаписатьТаблицуПлановыхКурсовВОтображение(Отчет.ПлановыеКурсы.Выгрузить());
	
	Для Каждого ТекОперация Из Вариант.СписокОпераций Цикл
		НоваяСтрока = ПрогнозныеОперации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекОперация);
	КонецЦикла;
	
	СформироватьНаСервере();
	ПриИзмененииПрогнозныхОпераций();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьИзмененияНаСервере()
	
	ПротоколИзменений.Очистить();
	
	УспешныеОперации = Новый Массив;
	
	Для Каждого ТекОперация Из ПрогнозныеОперации Цикл
		
		Если Не ТекОперация.Активна Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.РазделениеОперации Тогда
			
			СохранитьРазделение(ТекОперация,УспешныеОперации);
			
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования
				ИЛИ ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.РазмещениеСредств Тогда
			
			СохранитьФинансовыйИнструмент(ТекОперация,УспешныеОперации);
			
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПомещениеВСтопЛист Тогда
			
			СохранитьДобавлениеВСтопЛист(ТекОперация,УспешныеОперации);
			
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ВозвратИзСтопЛиста Тогда
			                                          
			СохранитьВозвратИзСтопЛиста(ТекОперация,УспешныеОперации);
			
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.НовыйДоговорКредита Тогда
			
			СоздатьНовыйДоговорКредита(ТекОперация,УспешныеОперации);
			
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.НовыйДоговорДепозита Тогда
			
			СоздатьНовыйДоговорДепозита(ТекОперация,УспешныеОперации);
			
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПогашениеКредита Тогда
			
			ЗапланироватьДосрочноеПогашениеКредита(ТекОперация,УспешныеОперации); 		
			
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПеремещениеЗаявки Тогда
			
			СохранитьПереразмещение(ТекОперация,УспешныеОперации);
		// ЕРПУХ ++	
		ИначеЕсли ТекОперация.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПереводСобственныхСредств Тогда
			
			СохранитьПереводСобственныхСредств(ТекОперация, УспешныеОперации);
		// ЕРПУХ --	
	
		Иначе
			
			СохранитьЗаявкуПеремещение(ТекОперация,УспешныеОперации);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Операция Из УспешныеОперации Цикл   
		
		НайдСтроки = ПрогнозныеОперации.НайтиСтроки(Новый Структура("ИдентификаторОперации",Операция.ИдентификаторОперации));
		
		Для Каждого НайдСтрока Из НайдСтроки Цикл  
			
			ПрогнозныеОперации.Удалить(ПрогнозныеОперации.Индекс(НайдСтрока));	
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПриИзмененииПрогнозныхОпераций();
	Модифицированность = Ложь;
	
	ПараметрыОтбора = Новый Структура("ЕстьОшибка", Истина);
	Ошибки = ПротоколИзменений.НайтиСтроки(ПараметрыОтбора);
	
	Если Ошибки.Количество() = 0 Тогда
		ПоднятьДанныеПлатежногоКалендаряЗапуститьВФоне();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПереразмещение(Операция, УспешныеОперации)
	
	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = Операция.ВидОперации;	
	РезультатВыполненияОперации.Вставить("ПлановыеКурсы", Отчет.ПлановыеКурсы);
	
	УточнениеОперации = Операция.УточнениеОперации; 
	
	ПлатежныеПозиции.ПереместитьПозицию(УточнениеОперации.ИдентификаторЗаписи,
										УточнениеОперации.ДатаРазмещения,
										УточнениеОперации.СчетРазмещения,
										РезультатВыполненияОперации); 
										
	Если Не РезультатВыполненияОперации.ЕстьОшибка Тогда									
		УспешныеОперации.Добавить(Операция);
	КонецЕсли;
			
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);	
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРазделение(Операция, УспешныеОперации)
	
	Запрос = Новый Запрос;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	               |	&ИсходныйИнструмент КАК ЗаявкаНаОперацию,
	               |	ПредставлениеПлатежногоКалендаря.Дата КАК ДатаИсполнения,
	               |	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторПозиции,
	               |	ВЫБОР
	               |		КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	               |			ТОГДА ПредставлениеПлатежногоКалендаря.Сумма
	               |		ИНАЧЕ -ПредставлениеПлатежногоКалендаря.Сумма
	               |	КОНЕЦ / ЕСТЬNULL(РазмещениеЗаявок.КурсПлатежа, 1) КАК СуммаВзаиморасчетов,
	               |	ВЫБОР
	               |		КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	               |			ТОГДА ПредставлениеПлатежногоКалендаря.Сумма
	               |		ИНАЧЕ -ПредставлениеПлатежногоКалендаря.Сумма
	               |	КОНЕЦ КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	               |	КОНЕЦ КАК ПриходРасход,
	               |	ЕСТЬNULL(РазмещениеЗаявок.КурсПлатежа, 1) КАК КурсПлатежа,
	               |	ЕСТЬNULL(РазмещениеЗаявок.КратностьПлатежа, 1) КАК КратностьПлатежа,
	               |	ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная) КАК ФормаОплаты,
	               |	ПредставлениеПлатежногоКалендаря.Валюта КАК ВалютаОплаты,
	               |	РазмещениеЗаявок.Организация КАК Организация,
	               |	РазмещениеЗаявок.Контрагент КАК Контрагент,
	               |	РазмещениеЗаявок.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	РазмещениеЗаявок.СчетКонтрагента КАК СчетКонтрагента,
	               |	РазмещениеЗаявок.ВидОперацииУХ КАК ВидОперацииУХ,
	               |	РазмещениеЗаявок.СпособОпределенияКурсаПлатежа КАК СпособОпределенияКурсаПлатежа,
	               |	РазмещениеЗаявок.КурсПлатежаНеБолее КАК КурсПлатежаНеБолее,
	               |	РазмещениеЗаявок.КурсПлатежаНеМенее КАК КурсПлатежаНеМенее,
	               |	РазмещениеЗаявок.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	               |	РазмещениеЗаявок.Приоритет КАК Приоритет,
	               |	РазмещениеЗаявок.Проведен КАК Проведен
	               |ИЗ
	               |	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	               |		ПО (&ИсходныйИдентификаторПозиции = РазмещениеЗаявок.ИдентификаторПозиции)
	               |ГДЕ
	               |	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи В(&МассивИдентификаторов)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	РазмещениеЗаявок.БанковскийСчетКасса,
	               |	РазмещениеЗаявок.ЗаявкаНаОперацию,
	               |	РазмещениеЗаявок.ДатаИсполнения,
	               |	РазмещениеЗаявок.ИдентификаторПозиции,
	               |	РазмещениеЗаявок.СуммаВзаиморасчетов,
	               |	РазмещениеЗаявок.Сумма,
	               |	РазмещениеЗаявок.ПриходРасход,
	               |	РазмещениеЗаявок.КурсПлатежа,
	               |	РазмещениеЗаявок.КратностьПлатежа,
	               |	РазмещениеЗаявок.ФормаОплаты,
	               |	РазмещениеЗаявок.ВалютаОплаты,
	               |	РазмещениеЗаявок.Организация,
	               |	РазмещениеЗаявок.Контрагент,
	               |	РазмещениеЗаявок.ДоговорКонтрагента,
	               |	РазмещениеЗаявок.СчетКонтрагента,
	               |	РазмещениеЗаявок.ВидОперацииУХ,
	               |	РазмещениеЗаявок.СпособОпределенияКурсаПлатежа,
	               |	РазмещениеЗаявок.КурсПлатежаНеБолее,
	               |	РазмещениеЗаявок.КурсПлатежаНеМенее,
	               |	РазмещениеЗаявок.ВалютаВзаиморасчетов,
	               |	РазмещениеЗаявок.Приоритет,
	               |	РазмещениеЗаявок.Проведен
	               |ИЗ
	               |	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	               |		ИЗ
	               |			РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	               |		ГДЕ
	               |			НЕ ПредставлениеПлатежногоКалендаря.Активна
	               |			И ПредставлениеПлатежногоКалендаря.Инструмент = &ИсходныйИнструмент) КАК ОтключенныеЗаписи
	               |		ПО РазмещениеЗаявок.ИдентификаторПозиции = ОтключенныеЗаписи.ИдентификаторЗаписи
	               |ГДЕ
	               |	РазмещениеЗаявок.ЗаявкаНаОперацию = &ИсходныйИнструмент
	               |	И ОтключенныеЗаписи.ИдентификаторЗаписи ЕСТЬ NULL";

	Запрос.УстановитьПараметр("МассивИдентификаторов", Операция.УточнениеОперации.НовыеИнструменты);
	Запрос.УстановитьПараметр("ИсходныйИнструмент", Операция.УточнениеОперации.ИсходныйИнструмент);
	Запрос.УстановитьПараметр("ИсходныйИдентификаторПозиции", Операция.УточнениеОперации.ИсходныйИдентификаторПозиции);

	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = Операция.ВидОперации;	

	ТабПозиция = Запрос.Выполнить().Выгрузить(); 
	
	Попытка
		ПлатежныеПозиции.ЗаписатьПлатежнуюПозициюЗаявки(Операция.УточнениеОперации.ИсходныйИнструмент, ТабПозиция); 
		РезультатВыполненияОперации.ОбъектСистемы = Операция.УточнениеОперации.ИсходныйИнструмент; 
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки; 
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);	
	
КонецПроцедуры

&НаСервере
Процедура СохранитьФинансовыйИнструмент(Операция, УспешныеОперации)
	
	Если ТипЗнч(Операция.УточнениеОперации.ФинансовыйИнструмент) = Тип("СправочникСсылка.ДоговорыКонтрагентов") 
		ИЛИ ТипЗнч(Операция.УточнениеОперации.ФинансовыйИнструмент) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
		ИмяРеквизита = "ВидФинансовогоИнструмента";
	Иначе
		ИмяРеквизита = "ТипПериодическихПлатежей";
	КонецЕсли;
	
	ВидФинансовогоИнструмента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция.УточнениеОперации.ФинансовыйИнструмент, ИмяРеквизита);
	
	Если УправлениеДоговорамиУХКлиентСерверПовтИсп.ЭтоДоходныйИнструмент(ВидФинансовогоИнструмента) Тогда		
		МенеджерДокументаНачало = Документы.ЗаявкаНаРасходованиеДенежныхСредств;
		МенеджерДокументаВозврат = Документы.ОжидаемоеПоступлениеДенежныхСредств;
	Иначе
		МенеджерДокументаНачало = Документы.ОжидаемоеПоступлениеДенежныхСредств;
		МенеджерДокументаВозврат = Документы.ЗаявкаНаРасходованиеДенежныхСредств;		
	КонецЕсли;
	
	// Привлечение / Размещение
	НастройкиОперацииНачало = ФинансовыеИнструментыУХ.НастройкиОперацииФинансовогоИнструмента(
		ВидФинансовогоИнструмента,
		Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг,
		Перечисления.ВидыДвиженийПриходРасход.Приход);
		
	// Возврат
	НастройкиОперацииВозврат = ФинансовыеИнструментыУХ.НастройкиОперацииФинансовогоИнструмента(
		ВидФинансовогоИнструмента,
		Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг,
		Перечисления.ВидыДвиженийПриходРасход.Расход);
		
	НастройкиОперацииПроценты = ФинансовыеИнструментыУХ.НастройкиОперацииФинансовогоИнструмента(
		ВидФинансовогоИнструмента,
		Перечисления.ЭлементыСтруктурыЗадолженности.Проценты,
		Перечисления.ВидыДвиженийПриходРасход.Расход);
		
	// Более точечная настройка		
	Если ИмяРеквизита = "ВидФинансовогоИнструмента" Тогда
		
		ФинансовыйИнструмент = Операция.УточнениеОперации.ФинансовыйИнструмент;
		ГрафикРасчетов = ФинансовыйИнструмент.ВерсияСоглашения.ГрафикРасчетов;	
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидБюджета", ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
		
		// Привлечение / Размещение (уточнение)	
		ПараметрыОтбора.Вставить("ВидОперацииУХ", НастройкиОперацииНачало.ВидОперацииУХ);
		ПараметрыОтбора.Вставить("КолонкаСекции", Перечисления.ВидыДвиженийПриходРасход.Приход);
		ПараметрыОтбора.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг);
		
		НайденныеСтроки = ГрафикРасчетов.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 И ЗначениеЗаполнено(НайденныеСтроки[0].СтатьяБюджета) Тогда
			НастройкиОперацииНачало.СтатьяБюджета = НайденныеСтроки[0].СтатьяБюджета;	
		КонецЕсли;
		
		// Возврат (уточнение)
		ПараметрыОтбора.Вставить("ВидОперацииУХ", НастройкиОперацииВозврат.ВидОперацииУХ);
		ПараметрыОтбора.Вставить("КолонкаСекции", Перечисления.ВидыДвиженийПриходРасход.Расход);
		ПараметрыОтбора.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг);

		НайденныеСтроки = ГрафикРасчетов.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 И ЗначениеЗаполнено(НайденныеСтроки[0].СтатьяБюджета) Тогда
			НастройкиОперацииВозврат.СтатьяБюджета = НайденныеСтроки[0].СтатьяБюджета;	
		КонецЕсли;
		
		// Проценты (уточнение)
		ПараметрыОтбора.Вставить("ВидОперацииУХ", НастройкиОперацииПроценты.ВидОперацииУХ);
		ПараметрыОтбора.Вставить("КолонкаСекции", Перечисления.ВидыДвиженийПриходРасход.Расход);
		ПараметрыОтбора.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.Проценты);

		НайденныеСтроки = ГрафикРасчетов.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 И ЗначениеЗаполнено(НайденныеСтроки[0].СтатьяБюджета) Тогда
			НастройкиОперацииПроценты.СтатьяБюджета = НайденныеСтроки[0].СтатьяБюджета;	
		КонецЕсли;
		
	КонецЕсли;	
	
	ЕстьОшибка = Ложь;
	
	ТекстОшибки = НСтр("ru = 'Поле ""Статья движения денежных средств"" не заполнено. Проверьте настройки договора или Настройки операций финансовых инструментов.'");
	
	Если Не ЗначениеЗаполнено(НастройкиОперацииНачало.СтатьяБюджета) Тогда		
		РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
		РезультатВыполненияОперации.Операция = НастройкиОперацииНачало.ВидОперацииУХ;
		РезультатВыполненияОперации.ТекстОшибки = ТекстОшибки;
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		
		ДобавитьОперациюВПротокол(РезультатВыполненияОперации);
		
		ЕстьОшибка = Истина;
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(НастройкиОперацииВозврат.СтатьяБюджета) Тогда		
		РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
		РезультатВыполненияОперации.Операция = НастройкиОперацииВозврат.ВидОперацииУХ;
		РезультатВыполненияОперации.ТекстОшибки = ТекстОшибки;
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		
		ДобавитьОперациюВПротокол(РезультатВыполненияОперации);
		
		ЕстьОшибка = Истина;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(НастройкиОперацииПроценты.СтатьяБюджета) Тогда		
		РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
		РезультатВыполненияОперации.Операция = НастройкиОперацииПроценты.ВидОперацииУХ;
		РезультатВыполненияОперации.ТекстОшибки = ТекстОшибки;
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		
		ДобавитьОперациюВПротокол(РезультатВыполненияОперации);
		
		ЕстьОшибка = Истина;
	КонецЕсли;
		
	Если ЕстьОшибка Тогда
		Возврат;
	КонецЕсли;
		
	СтруктураПараметров = Операция.УточнениеОперации;
	
	СтруктураЗаполнения = Новый Структура;
	Если ТипЗнч(СтруктураПараметров.ФинансовыйИнструмент) = Тип("СправочникСсылка.НастройкиПериодическихОпераций") Тогда
		СтруктураЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураПараметров.ФинансовыйИнструмент, 
										"ЦФО,Контрагент,ДоговорКонтрагента,СчетКонтрагента");
	ИначеЕсли ТипЗнч(СтруктураПараметров.ФинансовыйИнструмент) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		СтруктураЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураПараметров.ФинансовыйИнструмент, 
			Новый Структура("ЦФО,Контрагент,ДоговорКонтрагента,СчетКонтрагента",
							"ОсновнойЦФО","Владелец","Ссылка","БанковскийСчетКонтрагента"));
	ИначеЕсли ТипЗнч(СтруктураПараметров.ФинансовыйИнструмент) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
		СтруктураЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураПараметров.ФинансовыйИнструмент, 
			Новый Структура("Контрагент,СчетКонтрагента,ВерсияСоглашения", 
									"Контрагент","БанковскийСчетКонтрагента"));
		СтруктураЗаполнения.Вставить("ЦФО", СтруктураЗаполнения.ВерсияСоглашения.ОсновнойЦФО);
		СтруктураЗаполнения.Вставить("Проект", СтруктураЗаполнения.ВерсияСоглашения.ОсновнойПроект);
		СтруктураЗаполнения.Вставить("ЭлементСтруктурыЗадолженности", Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг);
		Если Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования Тогда
			СтруктураЗаполнения.Вставить("ВалютаОплаты", Операция.УточнениеОперации.ВалютаОплаты);
			СтруктураЗаполнения.Вставить("СуммаОплаты",  Операция.УточнениеОперации.СуммаОплаты);
		КонецЕсли;
	КонецЕсли;
	СтруктураЗаполнения.Вставить("ДоговорКредитаДепозита", СтруктураПараметров.ФинансовыйИнструмент);	
	
	СтруктураЗаполнения.Вставить("Организация", Операция.УточнениеОперации.Организация);
	СтруктураЗаполнения.Вставить("ВалютаДокумента", Операция.УточнениеОперации.Валюта);
	СтруктураЗаполнения.Вставить("БанковскийСчетКасса", Операция.УточнениеОперации.БанковскийСчетКасса);

	// 1. Исходная операция.
	СтруктураЗаполнения.Вставить("ВидОперацииУХ", НастройкиОперацииНачало.ВидОперацииУХ);
	СтруктураЗаполнения.Вставить("СтатьяБюджета", НастройкиОперацииНачало.СтатьяБюджета);
	СтруктураЗаполнения.Вставить("СуммаДокумента", Операция.УточнениеОперации.Сумма);
	СтруктураЗаполнения.Вставить("ДатаНачала", Операция.УточнениеОперации.ПериодИспользования.ДатаНачала); 
	СтруктураЗаполнения.Вставить("ДатаПлатежа", Операция.УточнениеОперации.ПериодИспользования.ДатаНачала);
	
	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = НастройкиОперацииНачало.ВидОперацииУХ;	
	
	ЗаявкаНачало = МенеджерДокументаНачало.СоздатьДокумент();
	ЗаявкаНачало.Заполнить(СтруктураЗаполнения);
	ЗаявкаНачало.Записать(РежимЗаписиДокумента.Запись);
	Попытка              
		ЗаявкаНачало.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполненияОперации.ОбъектСистемы = ЗаявкаНачало.Ссылка; 
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);	
		
	// 2. Операция возврата.
	СтруктураЗаполнения.Вставить("ВидОперацииУХ", НастройкиОперацииВозврат.ВидОперацииУХ);
	СтруктураЗаполнения.Вставить("СтатьяБюджета", НастройкиОперацииВозврат.СтатьяБюджета);
	СтруктураЗаполнения.Вставить("СуммаДокумента", Операция.УточнениеОперации.Сумма);
    СтруктураЗаполнения.Вставить("ЭлементСтруктурыЗадолженности", ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг"));
	СтруктураЗаполнения.Вставить("ДатаНачала", Операция.УточнениеОперации.ПериодИспользования.ДатаОкончания);
	СтруктураЗаполнения.Вставить("ЖелательнаяДатаПлатежа", Операция.УточнениеОперации.ПериодИспользования.ДатаОкончания);   
	СтруктураЗаполнения.Вставить("ДоговорКредитаДепозита", СтруктураПараметров.ФинансовыйИнструмент);   
	СтруктураЗаполнения.Вставить("СчетКассаОрганизации", Операция.УточнениеОперации.БанковскийСчетКасса);

	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = НастройкиОперацииВозврат.ВидОперацииУХ;	
	
	ЗаявкаВозврат = МенеджерДокументаВозврат.СоздатьДокумент();
	ЗаявкаВозврат.Заполнить(СтруктураЗаполнения);
	ЗаявкаВозврат.Записать(РежимЗаписиДокумента.Запись);
	Попытка              
		ЗаявкаВозврат.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполненияОперации.ОбъектСистемы = ЗаявкаВозврат.Ссылка; 
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);		
	
	// 3. Операция получения/возврата процентов.
	СтруктураЗаполнения.Вставить("ВидОперацииУХ", НастройкиОперацииПроценты.ВидОперацииУХ);
	СтруктураЗаполнения.Вставить("СтатьяБюджета", НастройкиОперацииПроценты.СтатьяБюджета);
	СтруктураЗаполнения.Вставить("СуммаДокумента", Операция.УточнениеОперации.СуммаПроцентов);
	СтруктураЗаполнения.Вставить("ДатаНачала", Операция.УточнениеОперации.ПериодИспользования.ДатаОкончания);
    СтруктураЗаполнения.Вставить("ЖелательнаяДатаПлатежа", Операция.УточнениеОперации.ПериодИспользования.ДатаОкончания);
    СтруктураЗаполнения.Вставить("ЭлементСтруктурыЗадолженности", ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.Проценты"));

	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = НастройкиОперацииПроценты.ВидОперацииУХ;	
	
	ЗаявкаПроценты = МенеджерДокументаВозврат.СоздатьДокумент();
	ЗаявкаПроценты.Заполнить(СтруктураЗаполнения);
	ЗаявкаПроценты.Записать(РежимЗаписиДокумента.Запись);
	Попытка              
		ЗаявкаПроценты.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполненияОперации.ОбъектСистемы = ЗаявкаПроценты.Ссылка; 
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);		
	
КонецПроцедуры

&НаСервере
Процедура СохранитьЗаявкуПеремещение(Операция, УспешныеОперации)
	
	УточнениеОперации = Операция.УточнениеОперации;
	
	ПринудительноСоздаватьОжидаемоеПоступлениеДенежныхСредств = Ложь;
	
	Если Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение Тогда
		ВидОперации = ПолучитьВидОперацииДляВнутригрупповогоПеремещения(Операция);     
		ПринудительноСоздаватьОжидаемоеПоступлениеДенежныхСредств = Истина;
	ИначеЕсли Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ПереводСобственныхСредств Тогда
		ВидОперации = ПолучитьВидОперацииДляПереводаСобственныхСредств(Операция);
	ИначеЕсли Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты Тогда
		Если УточнениеОперации.ЭтоПополнениеСчетаКассы Тогда
			ВидОперации = Справочники.ВидыОперацийУХ.ПриобретениеВалюты;
		Иначе
			ВидОперации = Справочники.ВидыОперацийУХ.ПродажаВалюты;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если УточнениеОперации.Свойство("ЦФО") Тогда
		ЦФО = УточнениеОперации.ЦФО;
	ИначеЕсли  УточнениеОперации.Свойство("ОрганизацияСписания") Тогда
		ЦФО = УточнениеОперации.ОрганизацияСписания;
	КонецЕсли;
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ВидОперацииУХ", ВидОперации);
	СтруктураЗаполнения.Вставить("Валюта", УточнениеОперации.ВалютаСписания);
	СтруктураЗаполнения.Вставить("ВалютаВзаиморасчетов", УточнениеОперации.ВалютаСписания);
	СтруктураЗаполнения.Вставить("ВалютаОплаты", УточнениеОперации.ВалютаСписания);
	СтруктураЗаполнения.Вставить("ВалютаКонвертации", УточнениеОперации.ВалютаЗачисления);
	СтруктураЗаполнения.Вставить("КурсПлатежа", ?(УточнениеОперации.КурсКонвертации = 0, 1, УточнениеОперации.КурсКонвертации));
	СтруктураЗаполнения.Вставить("КратностьПлатежа", ?(УточнениеОперации.КратностьКонвертации = 0, 1, УточнениеОперации.КратностьКонвертации));
	СтруктураЗаполнения.Вставить("СуммаДокумента", УточнениеОперации.СуммаСписания);
	СтруктураЗаполнения.Вставить("СуммаКонвертации" , УточнениеОперации.СуммаЗачисления);
	СтруктураЗаполнения.Вставить("Организация", УточнениеОперации.ОрганизацияСписания);
	СтруктураЗаполнения.Вставить("ЦФО" , ЦФО);
	
	Если Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты Тогда
		СтруктураЗаполнения.Вставить("ДоговорКонтрагента", 	УточнениеОперации.ДоговорКонтрагента);
		СтруктураЗаполнения.Вставить("Контрагент", 			УточнениеОперации.Контрагент);     
		// ЕРПУХ ++ 
		СтруктураЗаполнения.Вставить("КурсКонвертации" , 			УточнениеОперации.КурсКонвертации);
		СтруктураЗаполнения.Вставить("КратностьКурсаКонвертации" ,	УточнениеОперации.КратностьКонвертации);
		СтруктураЗаполнения.Вставить("БанковскийСчет" , 			УточнениеОперации.БанковскийСчетКассаСписания);
		СтруктураЗаполнения.Вставить("БанковскийСчетПолучатель" , 	УточнениеОперации.БанковскийСчетКассаЗачисления);
		СтруктураЗаполнения.Вставить("БанковскийСчетКонтрагента" , 	УточнениеОперации.БанковскийСчетКонтрагента);
		// ЕРПУХ --
	Иначе
		СтруктураЗаполнения.Вставить("ДоговорКонтрагента",		УточнениеОперации.ДоговорКонтрагента); 
		СтруктураЗаполнения.Вставить("ОрганизацияПолучатель", 	УточнениеОперации.ОрганизацияЗачисления);
		СтруктураЗаполнения.Вставить("Контрагент", 				УточнениеОперации.ДоговорКонтрагента.Контрагент); 		
	КонецЕсли;   
	
	// ЕРПУХ ++ 
	Если Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение Тогда
		СтруктураЗаполнения.Вставить("БанковскийСчет" , 			УточнениеОперации.БанковскийСчетКассаСписания);
		СтруктураЗаполнения.Вставить("БанковскийСчетПолучатель" , 	УточнениеОперации.БанковскийСчетКассаЗачисления);
		СтруктураЗаполнения.Вставить("БанковскийСчетКонтрагента" , 	УправлениеДенежнымиСредствамиУХ.БанковскийСчетКонтрагента(УточнениеОперации.БанковскийСчетКассаЗачисления));
		СтруктураЗаполнения.Вставить("ДоговорКонтрагента",			УточнениеОперации.ДоговорКонтрагента);    
		СтруктураЗаполнения.Вставить("Договор",						УточнениеОперации.ДоговорКонтрагента); 
		Если ТипЗнч(УточнениеОперации.ДоговорКонтрагента) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда
			СтруктураЗаполнения.Вставить("ДоговорКредитаДепозита",	УточнениеОперации.ДоговорКонтрагента); 
		КонецЕсли;
	КонецЕсли;	
	// ЕРПУХ --
		
	СтруктураЗаполнения.Вставить("СчетКонтрагента", 
		УправлениеДенежнымиСредствамиУХ.БанковскийСчетКонтрагента(УточнениеОперации.БанковскийСчетКассаЗачисления));
	СтруктураЗаполнения.Вставить("ДатаНачала", УточнениеОперации.ДатаСписания);
	СтруктураЗаполнения.Вставить("ВнеМаршрута", Истина);
	СтруктураЗаполнения.Вставить("ЖелательнаяДатаПлатежа", Операция.ДатаСписания);
	СтруктураЗаполнения.Вставить("ДатаЗачисления" , Операция.ДатаЗачисления);
	СтруктураЗаполнения.Вставить("СчетКассаОрганизации" , Операция.БанковскийСчетКассаСписания);
	СтруктураЗаполнения.Вставить("СчетКассаЗачисления" , Операция.БанковскийСчетКассаЗачисления);
	
	Если УточнениеОперации.Свойство("ВидДенежныхСредств") Тогда
		СтруктураЗаполнения.Вставить("ФормаОплаты" , УточнениеОперации.ВидДенежныхСредств);
	КонецЕсли;  
	
	// Аналитики бюджетирования
	ДобавитьАналитикиБюджетированияВСтруктуру(СтруктураЗаполнения, УточнениеОперации);

	ДокументОбъект = Документы.ЗаявкаНаРасходованиеДенежныхСредств.СоздатьДокумент();
	
	Если НЕ Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьЗаполнениеОбъектаПоСтатистике", Истина);	
	КонецЕсли;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("СтруктураЗаполнения", СтруктураЗаполнения);
	Если ПринудительноСоздаватьОжидаемоеПоступлениеДенежныхСредств Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПринудительноСоздаватьОжидаемоеПоступлениеДенежныхСредств");
	КонецЕсли;
	
	ДокументОбъект.Заполнить(СтруктураЗаполнения);
	
	Если НЕ Операция.ВидОперации = Перечисления.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты Тогда
		ДокументОбъект.ВнеМаршрута = Истина;
	КонецЕсли;
	
	Для Каждого Строка Из ДокументОбъект.РасшифровкаПлатежа Цикл		
		ЗаполнитьЗначенияСвойств(Строка, СтруктураЗаполнения, 
			"СтатьяДвиженияДенежныхСредств, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6");
	КонецЦикла;
	
	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = Операция.ВидОперации;	
	
	Попытка              
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполненияОперации.ОбъектСистемы = ДокументОбъект.Ссылка;
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);	
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПереводСобственныхСредств(Операция, УспешныеОперации)
	
	УточнениеОперации = Операция.УточнениеОперации;
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ВидОперацииУХ", УточнениеОперации.ВидОперацииУХ);
	СтруктураЗаполнения.Вставить("ВидОперацииУХВстречный", УточнениеОперации.ВидОперацииУХВстречный);	
	СтруктураЗаполнения.Вставить("Организация" , 	УточнениеОперации.ОрганизацияСписания);
	СтруктураЗаполнения.Вставить("СуммаДокумента" , УточнениеОперации.СуммаСписания);
	СтруктураЗаполнения.Вставить("Валюта" , 		УточнениеОперации.ВалютаСписания);
	СтруктураЗаполнения.Вставить("БанковскийСчет" , УточнениеОперации.БанковскийСчетКассаСписания);
	СтруктураЗаполнения.Вставить("БанковскийСчетПолучатель", УточнениеОперации.БанковскийСчетКассаЗачисления);
	СтруктураЗаполнения.Вставить("Касса", УточнениеОперации.БанковскийСчетКассаСписания);
	СтруктураЗаполнения.Вставить("КассаПолучатель", УточнениеОперации.БанковскийСчетКассаЗачисления);
	СтруктураЗаполнения.Вставить("ДатаПлатежа", УточнениеОперации.ДатаСписания);
	
	// Аналитики бюджетирования
	ДобавитьАналитикиБюджетированияВСтруктуру(СтруктураЗаполнения, УточнениеОперации);
	
	СтруктураЗаполнения.Вставить("ПлатежиПо275ФЗ", УточнениеОперации.ПлатежиПо275ФЗ);
	СтруктураЗаполнения.Вставить("ТипПлатежаФЗ275", УточнениеОперации.ТипПлатежаФЗ275);
	СтруктураЗаполнения.Вставить("ДоговорСЗаказчиком", УточнениеОперации.ДоговорСЗаказчиком);
	
	ДокументОбъект = Документы.РаспоряжениеНаПеремещениеДенежныхСредств.СоздатьДокумент();
	ДокументОбъект.Заполнить(СтруктураЗаполнения);
	// Реквизиты, которые не заполняются из данных заполнения
	ДокументОбъект.Дата = ТекущаяДата();
	ДокументОбъект.ДоговорСЗаказчиком = СтруктураЗаполнения.ДоговорСЗаказчиком;
	ДокументОбъект.Статус = Перечисления.СтатусыРаспоряженийНаПеремещениеДенежныхСредств.КОплате;
	
	РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
	РезультатВыполненияОперации.Операция = Операция.ВидОперации;
	
	Попытка              
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполненияОперации.ОбъектСистемы = ДокументОбъект.Ссылка;
		УспешныеОперации.Добавить(Операция);
	Исключение
		РезультатВыполненияОперации.ЕстьОшибка = Истина;
		РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ДобавитьОперациюВПротокол(РезультатВыполненияОперации);	
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДобавлениеВСтопЛист(Операция, УспешныеОперации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию
	|ИЗ
	|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|ГДЕ
	|	РазмещениеЗаявок.ИдентификаторПозиции = &ИдентификаторПозиции";
	Запрос.УстановитьПараметр("ИдентификаторПозиции", Операция.УточнениеОперации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда

		РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
		РезультатВыполненияОперации.Операция = НСтр("ru = 'Помещение в стоп-лист'");	
		
		Попытка                                                                    
			УправлениеДенежнымиСредствамиУХ.УстановитьСостояниеИсполненияДокумента(Выборка.ЗаявкаНаОперацию, Операция.УточнениеОперации, Перечисления.СостоянияИсполненияЗаявки.Отложена,,,,РезультатВыполненияОперации);
			РезультатВыполненияОперации.ОбъектСистемы = Выборка.ЗаявкаНаОперацию; 
			
			Если ЗначениеЗаполнено(РезультатВыполненияОперации.ТекстОшибки) Тогда 
				РезультатВыполненияОперации.ЕстьОшибка = Истина;   
			Иначе
				УспешныеОперации.Добавить(Операция);
			КонецЕсли;
			
		Исключение
			РезультатВыполненияОперации.ЕстьОшибка = Истина;
			РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;	
		
		ДобавитьОперациюВПротокол(РезультатВыполненияОперации);		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьВозвратИзСтопЛиста(Операция, УспешныеОперации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
	|	ПредставлениеПлатежногоКалендаря.Инструмент КАК Инструмент
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи = &ИдентификаторЗаписи
	|	И ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = ЗНАЧЕНИЕ(Справочник.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка)
	|	И ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь";

	Запрос.УстановитьПараметр("ИдентификаторЗаписи", Операция.УточнениеОперации);
	Запрос.УстановитьПараметр("Пользователь", Отчет.Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		
		РезультатВыполненияОперации = НовыйРезультатВыполненияОперации();
		РезультатВыполненияОперации.Операция = НСтр("ru = 'Возврат из стоп-листа'");	
		
		Попытка              
			ПлатежныеПозиции.ВернутьПозициюНаИсполнение(Выборка.ИдентификаторЗаписи, Выборка.Дата, Выборка.БанковскийСчетКасса,,РезультатВыполненияОперации);
			РезультатВыполненияОперации.ОбъектСистемы = Выборка.Инструмент;
			
			Если ЗначениеЗаполнено(РезультатВыполненияОперации.ТекстОшибки) Тогда 
				РезультатВыполненияОперации.ЕстьОшибка = Истина;
			Иначе
				УспешныеОперации.Добавить(Операция);
			КонецЕсли;
			
		Исключение
			РезультатВыполненияОперации.ЕстьОшибка = Истина;
			РезультатВыполненияОперации.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;	
		
		ДобавитьОперациюВПротокол(РезультатВыполненияОперации);		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИзменения(Команда)

	Если ПрогнозныеОперации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	ПрименитьИзмененияНаСервере(); 
	
	ПараметрыОжиданияПодготовкиДанных("ПрименитьИзменения");
	
	ВывестиРезультатПринятияИзменений();  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВерсиюПлатежногоКалендаря(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьВерсиюПлатежногоКалендаряПродолжение", ЭтотОбъект);
	ОткрытьФорму(
		"Справочник.СохраненныеВерсииПлатежногоКалендаря.ФормаВыбора",,
		ЭтотОбъект,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВерсиюПлатежногоКалендаряПродолжение(Результат, Параметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьОперацииСохраненнойВерсии(Результат);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОперацииСохраненнойВерсии(СохраненнаяВерсия)

	ПрогнозныеОперации.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокОпераций.Активна КАК Активна,
	|	СписокОпераций.ИдентификаторОперации КАК ИдентификаторОперации,
	|	СписокОпераций.ВидОперации КАК ВидОперации,
	|	СписокОпераций.УточнениеОперации КАК УточнениеОперации,
	|	СписокОпераций.ПредставлениеОперации КАК ПредставлениеОперации,
	|	СписокОпераций.Оптимизация КАК Оптимизация,
