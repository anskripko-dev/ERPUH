КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьДоверительныеКоэффициентыПриПланированииПоступленийПриИзменении(Элемент) 
	
	АктуализироватьДанныеССохранениемОпераций("ИзменениеПризнакаИспользоватьДоверительныеКоэффициенты");
	
КонецПроцедуры

&НаСервере
Функция ТаблицаЗапланированныхСделок(ЭтоПривлечениеСредств, ИдентификаторТекущейОперации = Неопределено)
	
	ТабРезультат = Новый ТаблицаЗначений;
	ТабРезультат.Колонки.Добавить("ФинансовыйИнструмент");
	ТабРезультат.Колонки.Добавить("Сумма");
	ТабРезультат.Колонки.Добавить("ДатаНачала");
	ТабРезультат.Колонки.Добавить("ДатаОкончания");
	
	// Найдем активные операции соответствующего вида.
	СтруктураОтбораОпераций = Новый Структура;
	СтруктураОтбораОпераций.Вставить("Активна", Истина);
	СтруктураОтбораОпераций.Вставить("ВидОперации", ?(ЭтоПривлечениеСредств, 
		Перечисления.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования, 
		Перечисления.ВидыОперацийПлатежногоКалендаря.РазмещениеСредств));
	
	Операции = ПрогнозныеОперации.НайтиСтроки(СтруктураОтбораОпераций);
	
	Для Каждого ТекОперация Из Операции Цикл
		Если ТекОперация.ИдентификаторОперации <> ИдентификаторТекущейОперации Тогда 
			Сделка = ТабРезультат.Добавить();
			Сделка.ФинансовыйИнструмент = ТекОперация.УточнениеОперации.ФинансовыйИнструмент;
			Сделка.Сумма = ТекОперация.УточнениеОперации.Сумма;
			Сделка.ДатаНачала = ТекОперация.УточнениеОперации.ПериодИспользования.ДатаНачала;
			Сделка.ДатаОкончания = ТекОперация.УточнениеОперации.ПериодИспользования.ДатаОкончания;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТабРезультат;
	
КонецФункции

&НаСервере
Процедура УстановитьРасположениеПанелиДетали()
	
	Элементы.ОтображатьДеталиСправа.Пометка = Ложь;
	Элементы.ОтображатьДеталиСнизу.Пометка = Ложь;
	Элементы.ОтображатьДеталиСверху.Пометка = Ложь;
	Элементы.НеОтображатьДетали.Пометка = Ложь;
	
	// Сброс расположения элементов по умолчанию
	ПереместитьЭлементФормы("ГруппаОсновнаяТаблица","ГруппаОсновныеДанные","ГруппаДетальнаяИнформация");
	
	Если РежимВыводаПанелиДетали = "Справа" Тогда
		Элементы.ГруппаДетальнаяИнформация.Видимость = Истина;
		Элементы.ГруппаОсновныеДанные.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		Элементы.СтраницаОбороты.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.СтраницаНастройки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.ОтображатьДеталиСправа.Пометка = Истина;
	ИначеЕсли РежимВыводаПанелиДетали = "Снизу" Тогда
		Элементы.ГруппаДетальнаяИнформация.Видимость = Истина;
		Элементы.ГруппаОсновныеДанные.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.СтраницаОбороты.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		Элементы.СтраницаНастройки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		Элементы.ОтображатьДеталиСнизу.Пометка = Истина;
	ИначеЕсли РежимВыводаПанелиДетали = "Сверху" Тогда
		ПереместитьЭлементФормы("ГруппаДетальнаяИнформация","ГруппаОсновныеДанные","ГруппаОсновнаяТаблица");
		Элементы.ГруппаДетальнаяИнформация.Видимость = Истина;
		Элементы.ГруппаОсновныеДанные.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.СтраницаОбороты.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		Элементы.СтраницаНастройки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		Элементы.ОтображатьДеталиСверху.Пометка = Истина;
	Иначе
		Элементы.ГруппаДетальнаяИнформация.Видимость = Ложь;
		Элементы.НеОтображатьДетали.Пометка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьЭлементФормы(ИмяЭлемента,ИмяРодителя,ИмяМестаРасположения)

	Элементы.Переместить(Элементы[ИмяЭлемента],Элементы[ИмяРодителя],Элементы[ИмяМестаРасположения]);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстЗапросаОбороты()
	
	Возврат 
	"ВЫБРАТЬ
	|	МатрицаВесовЛиквидности.Источник КАК Источник,
	|	МатрицаВесовЛиквидности.ПриходРасход КАК ПриходРасход,
	|	МатрицаВесовЛиквидности.ГоризонтПланированияЛиквидности КАК ГоризонтПланированияЛиквидности,
	|	МатрицаВесовЛиквидности.Вес КАК Вес
	|ПОМЕСТИТЬ ВТ_МатрицаВесовЛиквидности
	|ИЗ
	|	&МатрицаВесовЛиквидности КАК МатрицаВесовЛиквидности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА &СворачиватьНеуправляемыеСписания
	|				И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|			ТОГДА ""К списанию""
	|		ИНАЧЕ ПредставлениеПлатежногоКалендаря.Инструмент
	|	КОНЕЦ КАК Инструмент,
	|	ПредставлениеПлатежногоКалендаря.Приоритет КАК Приоритет,
	|	СУММА(ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|				ТОГДА ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПриход,
	|	СУММА(ВЫБОР
	|			КОГДА ПредставлениеПлатежногоКалендаря.Сумма < 0
	|				ТОГДА -ПредставлениеПлатежногоКалендаря.Сумма * ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаРасход,
	|	ВЫБОР
	|		КОГДА &СворачиватьНеуправляемыеСписания
	|				И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи
	|	КОНЕЦ КАК ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.Дата < &НачалоПериодаОтбора
	|		ИЛИ ПредставлениеПлатежногоКалендаря.КрайняяДата <> ДАТАВРЕМЯ(1, 1, 1)
	|			И ПредставлениеПлатежногоКалендаря.Дата > ПредставлениеПлатежногоКалендаря.КрайняяДата КАК ПросроченнаяОперация,
	|	ВЫБОР
	|		КОГДА ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|				ИЛИ ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеПоступлениеСредств)
	|			ТОГДА 0
	|		КОГДА ПредставлениеПлатежногоКалендаря.ФиксированныйБанковскийСчет
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинки,
	|	ВЫБОР
	|		КОГДА ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|			ТОГДА 10000
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА &ОтображатьПоступленияПередСписаниями
	|				И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря В (ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.ПоступлениеСредств), ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеПоступлениеСредств))
	|			ТОГДА 1000
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА НЕ &ОтображатьПоступленияПередСписаниями
	|				И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.СписаниеСредств)
	|			ТОГДА 1000
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПолеУпорядочиванияРаздел,
	|	ПредставлениеПлатежногоКалендаря.Приоритет.РеквизитДопУпорядочивания КАК ПолеУпорядочиванияПриоритет,
	|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
	|	ВЫБОР
	|		КОГДА ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
	|			ТОГДА ""Наличные средства""
	|		ИНАЧЕ ""Безналичные средства""
	|	КОНЕЦ КАК ВидДенежныхСредствПредставление,
	|	ВЫБОР
	|		КОГДА &ЭтоОборотыПоДДС
	|			ТОГДА ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяДвиженияДенежныхСредств
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МатрицаВесовЛиквидности КАК ВТ_МатрицаВесовЛиквидности
	|		ПО ПредставлениеПлатежногоКалендаря.ИсточникДанных = ВТ_МатрицаВесовЛиквидности.Источник
	|			И (ВЫБОР
	|				КОГДА ПредставлениеПлатежногоКалендаря.Сумма > 0
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|			КОНЕЦ = ВТ_МатрицаВесовЛиквидности.ПриходРасход)
	|			И (ВЫБОР
	|				КОГДА ПредставлениеПлатежногоКалендаря.Дата > &ГоризонтТактическогоПланирования
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ГоризонтыПланированияЛиквидности.ПерспективноеПланирование)
	|				КОГДА ПредставлениеПлатежногоКалендаря.Дата > &ГоризонтОперативногоПланирования
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ГоризонтыПланированияЛиквидности.ТактическоеПланирование)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ГоризонтыПланированияЛиквидности.ОперативноеПланирование)
	|			КОНЕЦ = ВТ_МатрицаВесовЛиквидности.ГоризонтПланированияЛиквидности)
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь
	|	И ПредставлениеПлатежногоКалендаря.Активна
	|	И ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = &ВерсияПлатежногоКалендаря
	|	И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря В (ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.ПоступлениеСредств), ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.СписаниеСредств), ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств), ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеПоступлениеСредств))
	|	И &ДополнительныеОтборы
	|	И ЕСТЬNULL(ВТ_МатрицаВесовЛиквидности.Вес, 0) <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ПредставлениеПлатежногоКалендаря.Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта,
	|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Приоритет,
	|	ПредставлениеПлатежногоКалендаря.Дата < &НачалоПериодаОтбора
	|		ИЛИ ПредставлениеПлатежногоКалендаря.КрайняяДата <> ДАТАВРЕМЯ(1, 1, 1)
	|			И ПредставлениеПлатежногоКалендаря.Дата > ПредставлениеПлатежногоКалендаря.КрайняяДата,
	|	ВЫБОР
	|		КОГДА ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|				ИЛИ ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеПоступлениеСредств)
	|			ТОГДА 0
	|		КОГДА ПредставлениеПлатежногоКалендаря.ФиксированныйБанковскийСчет
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СворачиватьНеуправляемыеСписания
	|				И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|			ТОГДА ""К списанию""
	|		ИНАЧЕ ПредставлениеПлатежногоКалендаря.Инструмент
	|	КОНЕЦ,
	|	ПредставлениеПлатежногоКалендаря.Приоритет.РеквизитДопУпорядочивания,
	|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств,
	|	ВЫБОР
	|		КОГДА ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Наличная)
	|			ТОГДА ""Наличные средства""
	|		ИНАЧЕ ""Безналичные средства""
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ЭтоОборотыПоДДС
	|			ТОГДА ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СворачиватьНеуправляемыеСписания
	|				И ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря = ЗНАЧЕНИЕ(Перечисление.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолеУпорядочиванияРаздел УБЫВ";

КонецФункции

&НаКлиенте
Процедура Подключаемый_ПриАктивизацииСтрокиОбороты()
	
	СуммаВыбранныхПозиций = 0;
	Для Каждого ТекСтрока Из Элементы.ДетализацияОборотов.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.ДетализацияОборотов.ДанныеСтроки(ТекСтрока);
		СуммаВыбранныхПозиций = СуммаВыбранныхПозиций + ДанныеСтроки.СуммаПриход - ДанныеСтроки.СуммаРасход;
	КонецЦикла;
	ОстатокПослеПеремещенияВыбранных = КонечныйОстаток - СуммаВыбранныхПозиций;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьНарастающийИтогОбороты()
	
	МаксимальныйИндекс = ДетализацияОборотов.Количество() - 1;
	Остаток = КонечныйОстаток;
	Для Сч = 0 По МаксимальныйИндекс Цикл
		
		ТекСтрока = ДетализацияОборотов[Сч];
		Остаток = Остаток - ТекСтрока.СуммаПриход + ТекСтрока.СуммаРасход;
		ТекСтрока.СуммаОстаток = Остаток;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиДеталиНаСервере(Знач Расшифровка)
	
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, ИсточникНастроек);
	НастройкаРасшифровки = ОбработкаРасшифровки.Расшифровать(Расшифровка, Новый ПолеКомпоновкиДанных("Сумма"));
	
	Валюта = Справочники.Валюты.ПустаяСсылка();
	Организация = Справочники.Организации.ПустаяСсылка();
	Дата = "";
	ДанныеВыбраннойЯчейки.Очистить();
	
	ТаблицаОстатковИОборотов = ПолучитьИзВременногоХранилища(Отчет.АдресХранилищаТаблицыОстатковИОборотов);
	КолонкиТаблицыОстатковИОборотов = ТаблицаОстатковИОборотов.Колонки;
	
	СтруктураПоиска = Новый Структура;
	
	Для Каждого ТекЭлементОтбора Из НастройкаРасшифровки.Отбор.Элементы Цикл
		
		ИмяПоля = ""; 
		ВидСравненияКомпоновки = ТекЭлементОтбора.ВидСравнения;
		ЛевоеЗначениеКомпоновки = ТекЭлементОтбора.ЛевоеЗначение; 
		ПравоеЗначениеКомпоновки = ТекЭлементОтбора.ПравоеЗначение; 
		
		СвоеПоле = Ложь;
		
		Если СтрНайти(ТекЭлементОтбора.ЛевоеЗначение, "ПоступленияВсегоГруппировка")>0 Тогда
			ИмяПоля = "Сумма";
			ВидСравненияКомпоновки = ВидСравненияКомпоновкиДанных.Больше;
			ПравоеЗначениеКомпоновки = 0;
			ИскатьПолеВТаблицеОстатков = Ложь;   
			СвоеПоле = Истина;
		КонецЕсли;   
		
		Если СтрНайти(ТекЭлементОтбора.ЛевоеЗначение, "СписанияВсегоГруппировка")>0 Тогда
			ИмяПоля = "Сумма";
			ВидСравненияКомпоновки = ВидСравненияКомпоновкиДанных.Меньше;
			ПравоеЗначениеКомпоновки = 0;
			СвоеПоле = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИмяПоля) Тогда
		
			Если СтрНайти(ТекЭлементОтбора.ЛевоеЗначение, "СтатьяДвиженияДенежныхСредств")>0  Тогда
				ИмяПоля = "СтатьяДвиженияДенежныхСредств";
			Иначе
				ИмяПоля = Строка(ТекЭлементОтбора.ЛевоеЗначение);
			КонецЕсли;  
			
		КонецЕсли;	
		
		Если Не СвоеПоле И КолонкиТаблицыОстатковИОборотов.Найти(ИмяПоля) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекЭлементОтбора.Использование Тогда      
			
			НовыйЭлемент = ДанныеВыбраннойЯчейки.Добавить();
			НовыйЭлемент.ИмяПоля = ИмяПоля;
			НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновки;
			НовыйЭлемент.Значение = ПравоеЗначениеКомпоновки;
			
			Если Не СвоеПоле Тогда
				СтруктураПоиска.Вставить(ИмяПоля, ПравоеЗначениеКомпоновки);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЛевоеЗначениеКомпоновки = Новый ПолеКомпоновкиДанных("Валюта") Тогда
			Валюта = ПравоеЗначениеКомпоновки;
		ИначеЕсли ЛевоеЗначениеКомпоновки = Новый ПолеКомпоновкиДанных("Организация") Тогда
			Организация = ПравоеЗначениеКомпоновки;
		ИначеЕсли ЛевоеЗначениеКомпоновки = Новый ПолеКомпоновкиДанных("Дата") Тогда
			Дата = ПравоеЗначениеКомпоновки;
		КонецЕсли;
		
	КонецЦикла;
	
	// Установим конечный остаток на дату.
	КонечныйОстаток = 0;
	Если ТаблицаОстатковИОборотов <> Неопределено Тогда
		
		Если Отчет.ВариантПлатежногоКалендаря = Перечисления.ВариантыПлатежногоКалендаря.ПерспективноеПланирование Тогда
			КонечныйОстаток = ТаблицаОстатковИОборотов.Скопировать(СтруктураПоиска, "СуммаВВалютеОперации").Итог("СуммаВВалютеОперации");
		Иначе
			Таблица = ТаблицаОстатковИОборотов.Скопировать(СтруктураПоиска, 
								"СуммаВВалютеОперации, ПоступлениеВВалютеОперации, СписаниеВВалютеОперации");
			КонечныйОстаток = Таблица.Итог("СуммаВВалютеОперации") 
				+ Таблица.Итог("ПоступлениеВВалютеОперации") + Таблица.Итог("СписаниеВВалютеОперации");
		КонецЕсли;		
		
	КонецЕсли;
	
	ОбновитьТаблицуОборотов();
	
	Если ФильтрОперацийПоЯчейке Тогда
		УстановитьОтборОперацийНаСервере();
	КонецЕсли;	
	
	ОбновитьСтопЛист();  
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуОборотов()
	
	Если Не ДанныеВыбраннойЯчейки.Количество() Тогда
		ДетализацияОборотов.Очистить();
		ПриИзмененииДетализацииОборотов();
		ОборотыИтогоПриход = 0;
		ОборотыИтогоРасход = 0;
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("ГоризонтТактическогоПланирования", Отчет.ГоризонтТактическогоПланирования);
	Запрос.УстановитьПараметр("ГоризонтОперативногоПланирования", Отчет.ГоризонтОперативногоПланирования);
	Запрос.УстановитьПараметр("НачалоПериодаОтбора", Отчет.ПериодОтбора.ДатаНачала);
	Запрос.УстановитьПараметр("Пользователь", Отчет.Пользователь);
	Запрос.УстановитьПараметр("ВерсияПлатежногоКалендаря", Отчет.СохраненнаяВерсияПлатежногоКалендаря);
	Запрос.УстановитьПараметр("СворачиватьНеуправляемыеСписания", Отчет.СворачиватьНеуправляемыеСписания);
	Запрос.УстановитьПараметр("ОтображатьПоступленияПередСписаниями", Отчет.ОтображатьПоступленияПередСписаниями);
	Запрос.УстановитьПараметр("ЭтоОборотыПоДДС", ЭтоОборотыПоДДС(ЭтотОбъект));
	
	ТаблицаМатрицаВесовЛиквидности = Отчет.МатрицаВесовЛиквидности.Выгрузить();
	ДенежныеСредстваВстраиваниеУХ.ДополнитьМатрицуВесовЛиквидности(ТаблицаМатрицаВесовЛиквидности);  
	Запрос.УстановитьПараметр("МатрицаВесовЛиквидности", ТаблицаМатрицаВесовЛиквидности);
	
	ТекстОсновногоЗапроса = ТекстЗапросаОбороты();
	МассивДопОтборов = Новый Массив;
	
	Разделитель = Символы.ПС + "И ";
	Для Каждого ТекЭлементОтбора Из ДанныеВыбраннойЯчейки Цикл
		Если ТекЭлементОтбора.ИмяПоля = "Дата" И ТекЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
			И ТекЭлементОтбора.Значение > Отчет.ГоризонтОперативногоПланирования Тогда
			
			ПериодичностьВЗапросе = Отчеты.ПлатежныйКалендарьУХ.ПериодичностьВЗапросе(Отчет.ПериодичностьОперативногоПланирования, "МЕСЯЦ");
			ТекстДопОтбора = СтрШаблон("ПредставлениеПлатежногоКалендаря.Дата МЕЖДУ &Дата И КОНЕЦПЕРИОДА(&Дата, %1)", ПериодичностьВЗапросе);
			МассивДопОтборов.Добавить(ТекстДопОтбора);
			Запрос.УстановитьПараметр("Дата", ТекЭлементОтбора.Значение);

		Иначе
			МассивДопОтборов.Добавить(СформироватьУсловиеЗапроса(ТекЭлементОтбора.ИмяПоля, ТекЭлементОтбора.ВидСравнения));
			Запрос.УстановитьПараметр(ТекЭлементОтбора.ИмяПоля, ПолучитьЗначениеПараметра(ТекЭлементОтбора));
		КонецЕсли;                                       
	КонецЦикла;
	
	Если МассивДопОтборов.Количество() Тогда
		ТекстОсновногоЗапроса = СтрЗаменить(ТекстОсновногоЗапроса, "&ДополнительныеОтборы", СтрСоединить(МассивДопОтборов, Разделитель));
	Иначе
		Запрос.УстановитьПараметр("ДополнительныеОтборы", Истина);
	КонецЕсли;
	
	РазделительУпорядочивание = ","+Символы.ПС;
	МассивЗапросУпорядочивание = Новый Массив;
	МассивЗапросУпорядочивание.Добавить(ТекстОсновногоЗапроса);
	Если Отчет.СортироватьУправляемыеСписанияПоПриоритету Тогда
		ТекстСортировки = "ПолеУпорядочиванияПриоритет" + ?(Отчет.СортироватьУправляемыеСписанияПоПриоритетуПоУбыванию," УБЫВ", "");
		МассивЗапросУпорядочивание.Добавить(ТекстСортировки);
	КонецЕсли;
	
	Если Отчет.СортироватьУправляемыеСписанияПоСумме Тогда
		ТекстСортировки = "СуммаРасход" + ?(Отчет.СортироватьУправляемыеСписанияПоСуммеПоУбыванию," УБЫВ", "");
		МассивЗапросУпорядочивание.Добавить(ТекстСортировки);
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(МассивЗапросУпорядочивание, РазделительУпорядочивание);
	
	ДетализацияОборотов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Если РассчитыватьОстатокВДетализации Тогда
		ПересчитатьНарастающийИтогОбороты();
	КонецЕсли;
	
	ОборотыИтогоПриход = ДетализацияОборотов.Итог("СуммаПриход");
	ОборотыИтогоРасход = ДетализацияОборотов.Итог("СуммаРасход");
	
	Если ЗначениеЗаполнено(ИдентификаторЗаписиДляПозиционирования) Тогда
		СтрокиПозиционирования = ДетализацияОборотов.НайтиСтроки(Новый Структура("ИдентификаторЗаписи", ИдентификаторЗаписиДляПозиционирования));
		Если СтрокиПозиционирования.Количество() Тогда
			
			Элементы.ДетализацияОборотов.ТекущаяСтрока = СтрокиПозиционирования[0].ПолучитьИдентификатор();
			
		КонецЕсли;
		ИдентификаторЗаписиДляПозиционирования = ОбщегоНазначенияКлиентСерверУХ.ПустойУникальныйИдентификатор();
	КонецЕсли;
	
	Если ДетализацияОборотов.Количество() > 0 Тогда
		Если Элементы.ДетализацияОборотов.ТекущаяСтрока = Неопределено Тогда
			Элементы.ДетализацияОборотов.ТекущаяСтрока = 0;
		КонецЕсли;	
	КонецЕсли;
	
	ПриИзмененииДетализацииОборотов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтопЛист()
	
	ОперацииДобавленияВСтопЛист = ПрогнозныеОперации.Выгрузить(Новый Структура("Активна,ВидОперации", Истина, Перечисления.ВидыОперацийПлатежногоКалендаря.ПомещениеВСтопЛист)).ВыгрузитьКолонку("ИдентификаторОперации");
	
	ОперацииИсключенияИзСтопЛиста = ПрогнозныеОперации.Выгрузить(Новый Структура("Активна,ВидОперации", Истина, Перечисления.ВидыОперацийПлатежногоКалендаря.ВозвратИзСтопЛиста)).ВыгрузитьКолонку("УточнениеОперации");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазмещениеЗаявок.Сумма,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК Инструмент,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.Организация КАК Организация,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.ВалютаОплаты КАК Валюта,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.ФормаОплаты КАК ВидДенежныхСредств,
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторЗаписи,
	|	"""" КАК ИдентификаторОперации,
	|	1 КАК ИндексКартинки
	|ИЗ
	|	РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних(, НЕ ИдентификаторПозиции В (&ИдентификаторыИсключения)) КАК СостоянияИсполненияДокументовПланированияСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|		ПО СостоянияИсполненияДокументовПланированияСрезПоследних.ДокументПланирования = РазмещениеЗаявок.ЗаявкаНаОперацию
	|			И СостоянияИсполненияДокументовПланированияСрезПоследних.ИдентификаторПозиции = РазмещениеЗаявок.ИдентификаторПозиции
	|ГДЕ
	|	СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения = ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.Отложена)
	|	И РазмещениеЗаявок.ЗаявкаНаОперацию.Проведен
	|	//%%ОТБОР1%% 
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.Сумма,
	|	ПредставлениеПлатежногоКалендаря.Инструмент,
	|	ПредставлениеПлатежногоКалендаря.Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта,
	|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации,
	|	0
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	НЕ ПредставлениеПлатежногоКалендаря.Активна
	|	И ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации В(&ИдентификаторыОпераций)
	|	//%%ОТБОР2%%";

	Запрос.УстановитьПараметр("ИдентификаторыИсключения", ОперацииИсключенияИзСтопЛиста);
	Запрос.УстановитьПараметр("ИдентификаторыОпераций", ОперацииДобавленияВСтопЛист);
	
	СтрокаОтбора1 = "";
	СтрокаОтбора2 = "";
	Если ЗначениеЗаполнено(Валюта) Тогда
		СтрокаОтбора1 = "И РазмещениеЗаявок.ЗаявкаНаОперацию.ВалютаОплаты = &Валюта" + Символы.ПС;
		СтрокаОтбора2 = "И ПредставлениеПлатежногоКалендаря.Валюта = &Валюта" + Символы.ПС;
		Запрос.УстановитьПараметр("Валюта", Валюта);
	КонецЕсли;
	Если ЗначениеЗаполнено(Организация) Тогда
		СтрокаОтбора1 = СтрокаОтбора1 + "И РазмещениеЗаявок.ЗаявкаНаОперацию.Организация = &Организация" + Символы.ПС;
		СтрокаОтбора2 = СтрокаОтбора2 + "И ПредставлениеПлатежногоКалендаря.Организация = &Организация" + Символы.ПС;
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%%ОТБОР1%%", СтрокаОтбора1);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%%ОТБОР2%%", СтрокаОтбора2);
	
	СтопЛист.Загрузить(Запрос.Выполнить().Выгрузить());
	
	СтопЛистИтого = СтопЛист.Итог("Сумма");
	
	КоличествоПозицийВСтопЛисте = СтопЛист.Количество(); 
	
	Если КоличествоПозицийВСтопЛисте > 0 Тогда
		Элементы.КнопкаСтопЛист.Заголовок = СтрШаблон(НСтр("ru = 'Отложенные (%1)'"), КоличествоПозицийВСтопЛисте);
	Иначе
		Элементы.КнопкаСтопЛист.Заголовок = НСтр("ru = 'Отложенные'");
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеРеестраПлатежейНаСервере(РеестрПлатежей)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗаявкиВРеестрахПлатежей КАК ЗаявкиВРеестрахПлатежей
	|		ПО ПредставлениеПлатежногоКалендаря.Инструмент = ЗаявкиВРеестрахПлатежей.ЗаявкаНаОперацию
	|			И ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи = ЗаявкиВРеестрахПлатежей.ИдентификаторПозиции
	|ГДЕ
	|	ЗаявкиВРеестрахПлатежей.РеестрПлатежей = &РеестрПлатежей
	|	И ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = Значение(Справочник.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка)
	|	И ПредставлениеПлатежногоКалендаря.Пользователь = &ТекущийПользователь";

	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	Запрос.УстановитьПараметр("ТекущийПользователь", Отчет.Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВерсияПлатежногоКалендаря.Установить(Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
		НаборЗаписей.Отбор.Пользователь.Установить(Отчет.Пользователь);
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(Выборка.ИдентификаторЗаписи);
		
		НаборЗаписей.Прочитать();
		Для Каждого ТекЗапись Из НаборЗаписей Цикл
			ТекЗапись.РазделПлатежногоКалендаря = Перечисления.РазделыПлатежногоКалендаря.НеуправляемоеСписаниеСредств;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	ОбновитьТаблицуОборотов();
	
КонецПроцедуры

// Возвращает разделенную заявку по идентификатору операции ИдентификаторОперацииВход. Когда таких
// заявок нет, или их несколько - возвращает пустую ссылку.
&НаСервереБезКонтекста
Функция ПолучитьЗаявкуРазделения(ИдентификаторОперацииВход)
	
	РезультатФункции = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи,
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации
		|ПОМЕСТИТЬ ВТ_ИдентификаторДобавившейЗаписи
		|ИЗ
		|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
		|ГДЕ
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи = &ИдентификаторЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПредставлениеПлатежногоКалендаря.Инструмент,
		|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации
		|ИЗ
		|	ВТ_ИдентификаторДобавившейЗаписи КАК ВТ_ИдентификаторДобавившейЗаписи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
		|		ПО ВТ_ИдентификаторДобавившейЗаписи.ИдентификаторДобавившейОперации = ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации
		|ГДЕ
		|	ПредставлениеПлатежногоКалендаря.Инструмент ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
		|	ИЛИ ПредставлениеПлатежногоКалендаря.Инструмент ССЫЛКА Документ.ОжидаемоеПоступлениеДенежныхСредств";
	
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторОперацииВход);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Выгрузить().Количество() <> 1 Тогда
		РезультатФункции = Неопределено;
	Иначе	
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			РезультатФункции = ВыборкаДетальныеЗаписи.Инструмент;
		КонецЦикла;
	КонецЕсли;
	
	Возврат РезультатФункции;  
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьУсловиеЗапроса(ИмяПоля, ВидСравнения)
	
	ТекстШаблона = "";
	
	ИмяТаблицы = "ПредставлениеПлатежногоКалендаря";	

	Если ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
		ТекстШаблона = ИмяТаблицы+".%1 <> &%1
						|	И "+ИмяТаблицы+".%1 ЕСТЬ НЕ NULL";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		ТекстШаблона = "("+ИмяТаблицы+".%1 = &%1
						|	ИЛИ "+ИмяТаблицы+".%1 ЕСТЬ NULL)";
	Иначе
		ПодстрокиУсловия = Новый Массив;
		
		Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
			Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
			
			ПодстрокиУсловия.Добавить("НЕ");
		КонецЕсли;
		
		ПодстрокиУсловия.Добавить(ИмяТаблицы+".%1");
		
		Если ВидСравнения = ВидСравненияКомпоновкиДанных.Равно ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
			ПодстрокиУсловия.Добавить("= &%1");
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
			ПодстрокиУсловия.Добавить("В (&%1)");
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии
			ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
			ПодстрокиУсловия.Добавить("В ИЕРАРХИИ (&%1)");  
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
			ПодстрокиУсловия.Добавить("> (&%1)");
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
			ПодстрокиУсловия.Добавить("< (&%1)");
		КонецЕсли;
		
		ТекстШаблона = СтрСоединить(ПодстрокиУсловия, " ");
		
	КонецЕсли;
	
	Возврат СтрШаблон(ТекстШаблона, ИмяПоля);

КонецФункции

&НаСервере
Функция ПолучитьЗначениеПараметра(ЭлементОтбора)
	
	Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Поле = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных).НаборыДанных.НаборДанных.Поля.Найти(ЭлементОтбора.ИмяПоля);
		Если Поле = Неопределено Тогда
			// Очень некорректная ситуация.
			Возврат Неопределено;
		Иначе
			Возврат Поле.ТипЗначения.ПривестиЗначение(Неопределено);
		КонецЕсли;
	Иначе
		Возврат ЭлементОтбора.Значение;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПриИзмененииСценарияСтрессТестированияЛиквидностиНаСервере()
	
	Если ЗначениеЗаполнено(Отчет.СценарийСтрессТестированияЛиквидности)
		И Отчет.СценарийСтрессТестированияЛиквидности <> ПредопределенноеЗначение("Справочник.СценарииСтрессТестированияЛиквидности.РучнаяНастройка") Тогда
		Элементы.МатрицаВесов.ТолькоПросмотр = Истина;
		ПроцентПоступлений = Отчет.СценарийСтрессТестированияЛиквидности.ПроцентПоступлений / 100;
		ПроцентПлатежей = Отчет.СценарийСтрессТестированияЛиквидности.ПроцентПлатежей / 100;
		// Обновим представление.
		Для Каждого ТекСтрока Из МатрицаВесов Цикл 
			ТекСтрока.ОперативноеПланирование_Приход 	= ПроцентПоступлений;
			ТекСтрока.ТактическоеПланирование_Приход 	= ПроцентПоступлений;
			ТекСтрока.ПерспективноеПланирование_Приход 	= ПроцентПоступлений;
			
			ТекСтрока.ОперативноеПланирование_Расход 	= ПроцентПлатежей;
			ТекСтрока.ТактическоеПланирование_Расход 	= ПроцентПлатежей;
			ТекСтрока.ПерспективноеПланирование_Расход 	= ПроцентПлатежей;
		КонецЦикла;
		// Обновим саму табличку.
		Для Каждого ТекСтрока Из Отчет.МатрицаВесовЛиквидности Цикл
			Если ТекСтрока.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Приход Тогда
				ТекСтрока.Вес = ПроцентПоступлений;
			Иначе
				ТекСтрока.Вес = ПроцентПлатежей;
			КонецЕсли;
		КонецЦикла;

	Иначе 
		Элементы.МатрицаВесов.ТолькоПросмотр = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СтроковоеПредставлениеДаты(Дата, Отчет)
	
	Возврат Отчеты.ПлатежныйКалендарьУХ.ПредставлениеДаты(Дата, Отчет);
	
КонецФункции // ПредставлениеДаты()

&НаСервереБезКонтекста
Функция СтроковоеПредставлениеРазделаПлатежногоКалендаря(КлючЗаписи,Отчет)

	ТекстЗаголовокСтолбца = СтроковоеПредставлениеДаты(КлючЗаписи.Дата, Отчет);

	Если ТекстЗаголовокСтолбца = ДенежныеСредстваВстраиваниеУХ.ПредставлениеВходящегоОстаткаПлатежногоКалендаря() Тогда
		Возврат ТекстЗаголовокСтолбца;
	Иначе
	    Возврат Отчеты.ПлатежныйКалендарьУХ.ПредставлениеРазделаПлатежногоКалендаря(КлючЗаписи.РазделПлатежногоКалендаря);
	КонецЕсли;

КонецФункции // СтроковоеПредставлениеРазделаПлатежногоКалендаря()

&НаСервере
Функция ПолучитьПараметрыОтбораНаСервере() 
	
	Результат = Новый Массив;
	
	Для Каждого ТекЭлементОтбора Из Отчет.КомпоновщикНастроек.ПолучитьНастройки().Отбор.Элементы Цикл
		Если ТекЭлементОтбора.Использование Тогда
			ДобавитьПараметрОтбора(Результат, ТекЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьПараметрОтбора(Результат, ЭлементОтбора) 
	
	ПараметрОтбора = Новый Структура;
	ПараметрОтбора.Вставить("ИмяПоля", Строка(ЭлементОтбора.ЛевоеЗначение));
	ПараметрОтбора.Вставить("ВидСравнения", ЭлементОтбора.ВидСравнения);
	ПараметрОтбора.Вставить("ПравоеЗначение", ЭлементОтбора.ПравоеЗначение);
	
	Результат.Добавить(ПараметрОтбора);
	
КонецПроцедуры

// Возвращает пустую ссылку на банковский счет организации.
&НаСервереБезКонтекста
Функция ВернутьПустойБанковскийСчетОрганизации()
	
	РезультатФункции = Неопределено;
	
	ТипСчет = Метаданные.ОпределяемыеТипы.БанковскийСчетОрганизации.Тип;
	РезультатФункции = ТипСчет.ПривестиЗначение(Неопределено);
	
	Возврат РезультатФункции;   
	
КонецФункции

// Возвращает пустую ссылку на банковский счет организации.
&НаСервереБезКонтекста
Функция ВернутьПустуюКассуОрганизации()
	
	РезультатФункции = Неопределено;

	ТипСчет = Метаданные.ОпределяемыеТипы.Касса.Тип;
	РезультатФункции = ТипСчет.ПривестиЗначение(Неопределено);
	
	Возврат РезультатФункции;  
	
КонецФункции

&НаКлиенте
Процедура ОткрытьОперациюНаРедактирование(ДанныеОперации)
	
	Если ДанныеОперации.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПереводСобственныхСредств") ИЛИ
		ДанныеОперации.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение") ИЛИ 
		ДанныеОперации.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты") Тогда
				
		Если ДанныеОперации.Активна Тогда
			// чтобы не влияла на остатки
			ИзменитьАктивностьДвиженийИнструмента(ДанныеОперации.ИдентификаторОперации);
		КонецЕсли;
	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РедактированиеТекущейОперации", Истина);
		
		СтруктураОперации = Новый Структура;
		СтруктураОперации.Вставить("ИдентификаторОперации", ДанныеОперации.ИдентификаторОперации);
		СтруктураОперации.Вставить("Активна", ДанныеОперации.Активна);
		СтруктураОперации.Вставить("ВидОперации", ДанныеОперации.ВидОперации);
		СтруктураОперации.Вставить("УточнениеОперации", ДанныеОперации.УточнениеОперации);
		СтруктураОперации.Вставить("ЭтоПополнениеСчетаКассы", ДанныеОперации.УточнениеОперации.ЭтоПополнениеСчетаКассы);
		СтруктураОперации.Вставить("ЭтоКонвертацияВалюты", ДанныеОперации.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты"));
		СтруктураОперации.Вставить("ЭтоВнутригрупповоеПеремещение", ДанныеОперации.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение"));
		ПараметрыФормы.Вставить("ДанныеТекущейОперации", СтруктураОперации);
		
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("АдресМатрицыВесовЛиквидности", АдресМатрицыВесовЛиквидности(Отчет.МатрицаВесовЛиквидности));
		ПараметрыФормы.Вставить("ДанныеЗаполнения", ДанныеЗаполнения);
		
		ПараметрыОповещения = Новый Структура("ТекущаяОперация", СтруктураОперации);
		ОписаниеОповещения = Новый ОписаниеОповещения("РедактироватьОперациюКалендаряЗавершение", ЭтаФорма, ПараметрыОповещения);
		ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПереводаКонверсии", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения);
	
	ИначеЕсли ДанныеОперации.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования")
		ИЛИ ДанныеОперации.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.РазмещениеСредств") Тогда
		
		Если ДанныеОперации.Активна Тогда
			// чтобы не влияла на остатки
			ИзменитьАктивностьДвиженийИнструмента(ДанныеОперации.ИдентификаторОперации);
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Активна", ДанныеОперации.Активна);
		СтруктураПараметров.Вставить("ВидОперации", ДанныеОперации.ВидОперации);
		СтруктураПараметров.Вставить("ИдентификаторОперации", ДанныеОперации.ИдентификаторОперации);
		СтруктураПараметров.Вставить("РедактированиеТекущейОперации", Истина);
		СтруктураПараметров.Вставить("УточнениеОперации", ДанныеОперации.УточнениеОперации);
		СтруктураПараметров.Вставить("АдресТаблицыЗапланированныхСделок", АдресТаблицыЗапланированныхСделок(Истина, ДанныеОперации.ИдентификаторОперации));
		СтруктураПараметров.Вставить("ОстатокНаСчете", ОстатокПоСчетуНаДату(ДанныеОперации.УточнениеОперации.БанковскийСчетКасса, ДанныеОперации.УточнениеОперации.ПериодИспользования.ДатаНачала));
			
		ПараметрыОповещения = Новый Структура("ТекущаяОперация", СтруктураПараметров);
		ОписаниеОповещения = Новый ОписаниеОповещения("РедактироватьОперациюКалендаряЗавершение", ЭтаФорма, ПараметрыОповещения);
		
		ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПодбораФинансовыхИнструментов", СтруктураПараметров, ЭтотОбъект,,,,ОписаниеОповещения);
		
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Данный вид операции не редактируется'"),, "Отчет.ПрогнозныеОперации"); 
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьОперациюКалендаряЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		// восстанавливаем активность исходной операции
		Если Параметры.ТекущаяОперация.Активна Тогда
			ИзменитьАктивностьДвиженийИнструмента(Параметры.ТекущаяОперация.ИдентификаторОперации);
 		КонецЕсли;	
		
		Возврат;
	КонецЕсли;
	
	РедактироватьОперациюКалендаряЗавершениеСервер(Результат, Параметры.ТекущаяОперация);
	
	ПослеФормированияНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура РедактироватьОперациюКалендаряЗавершениеСервер(НоваяОперация, ТекущаяОперация)
	
	УдалитьДвиженияИнструмента(ТекущаяОперация.ИдентификаторОперации);
	Операция = ПрогнозныеОперации.НайтиСтроки(Новый Структура("ИдентификаторОперации", ТекущаяОперация.ИдентификаторОперации))[0];
	
	Если ТекущаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПереводСобственныхСредств") ИЛИ
		ТекущаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ВнутригрупповоеПеремещение") ИЛИ 
		ТекущаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.КонвертацияВалюты") Тогда 
	
		ЗаполнитьЗначенияСвойств(Операция, НоваяОперация,,"Оптимизация");
		ЗаполнитьЗначенияСвойств(Операция, НоваяОперация.УточнениеОперации, "ОрганизацияСписания, ОрганизацияЗачисления, БанковскийСчетКассаСписания, БанковскийСчетКассаЗачисления, ВалютаСписания, ВалютаЗачисления,
			| ДатаЗачисления, ДатаСписания, БанкЗачисления, БанкСписания");
		
		ПриИзмененииПрогнозныхОпераций();
		
	ИначеЕсли ТекущаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПривлечениеФинансирования") 
		ИЛИ ТекущаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.РазмещениеСредств") Тогда
		
		ДобавитьФинансовыйИнструмент(НоваяОперация, Операция);
		
	КонецЕсли;
	
	ОбновитьДанныеНаСервере();

КонецПроцедуры

&НаСервере 
Функция НайтиОперациюПоИдентификатору(ИдентификаторОперации)
	
	Отбор = Новый Структура("ИдентификаторОперации", ИдентификаторОперации);
	Строки = ПрогнозныеОперации.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		Возврат Строки[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

&НаСервере
Процедура ИзменитьДатуСчетЗаписиЗаявки(НоваяЗапись, Сдвиг, БанковскийСчетКасса, РеквизитыСчета)
	
	МассивПлатежныеДни = ПлатежныеДниНедели.ВыгрузитьЗначения();
	
	Если ТипЗнч(Сдвиг) = Тип("Число") Тогда
		НоваяДатаСоСдвигом = КалендарныеГрафикиУХ.ПолучитьДатуПоКалендарю(Отчет.ПроизводственныйКалендарь, НоваяЗапись.Дата, Сдвиг, Истина, МассивПлатежныеДни); 
		НоваяЗапись.Дата = НоваяДатаСоСдвигом;
				
	ИначеЕсли ТипЗнч(Сдвиг) = Тип("Дата") Тогда
		НоваяЗапись.Дата = Сдвиг;
				
	ИначеЕсли Сдвиг = "Максимум" Тогда
		Если ЗначениеЗаполнено(НоваяЗапись.КрайняяДата) Тогда
			// ближайшая к крайней дата являющаяся рабочим днем и входящая в платежные дни
			НоваяДата = КалендарныеГрафикиУХ.БлижайшийРабочийДеньДо(Отчет.ПроизводственныйКалендарь, НоваяЗапись.Дата, НоваяЗапись.КрайняяДата, МассивПлатежныеДни);
			Если ЗначениеЗаполнено(НоваяДата) Тогда
				НоваяЗапись.Дата = НоваяДата;
			Иначе
				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон(НСтр("ru = 'Не удалось переместить %1 на крайнюю дату %2, т.к. не найден допустимый платежный день с %3 по %2'"),
					НоваяЗапись.Инструмент,
					Формат(НоваяЗапись.КрайняяДата, НСтр("ru = 'ДЛФ=D'")),
					Формат(НоваяЗапись.Дата, НСтр("ru = 'ДЛФ=D'"))
				));
			КонецЕсли;
		КонецЕсли;	
		
	КонецЕсли;
	
	Если БанковскийСчетКасса <> Неопределено Тогда
		
		НоваяЗапись.БанковскийСчетКасса = БанковскийСчетКасса;
		
		Если ЗначениеЗаполнено(БанковскийСчетКасса) Тогда
			НоваяЗапись.Банк = РеквизитыСчета.Банк;
			НоваяЗапись.ПулЛиквидности = РеквизитыСчета.ПулЛиквидности;
		КонецЕсли;
		
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОперациюПеремещения(Операция, СтараяЗапись, НоваяЗапись)
	
	Операция.Активна = НоваяЗапись.Активна;
	Операция.ИдентификаторОперации = НоваяЗапись.ИдентификаторДобавившейОперации;
	Операция.ВидОперации =  Перечисления.ВидыОперацийПлатежногоКалендаря.ПеремещениеЗаявки;	
	Операция.ПредставлениеОперации = ПредставлениеОперацииПеремещенияЗаявки(НоваяЗапись, СтараяЗапись);	
	
	Операция.ОрганизацияЗачисления = СтараяЗапись.Организация;
	Операция.БанкЗачисления = СтараяЗапись.Банк;
	Операция.БанковскийСчетКассаЗачисления = СтараяЗапись.БанковскийСчетКасса;
	Операция.ВалютаЗачисления = СтараяЗапись.Валюта;
	Операция.ДатаЗачисления = СтараяЗапись.Дата;
	Операция.ОрганизацияСписания = НоваяЗапись.Организация;
	Операция.БанкСписания = НоваяЗапись.Банк;
	Операция.БанковскийСчетКассаСписания = НоваяЗапись.БанковскийСчетКасса;
	Операция.ВалютаСписания = НоваяЗапись.Валюта;
	Операция.ДатаСписания = НоваяЗапись.Дата;	
	Операция.ВидДенежныхСредств = НоваяЗапись.ВидДенежныхСредств;	
	Операция.СтатьяДвиженияДенежныхСредств = НоваяЗапись.СтатьяДвиженияДенежныхСредств;	
	
	ЗаполнитьУточнениеОперацииПеремещения(Операция,НоваяЗапись);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУточнениеОперацииПеремещения(Операция,ДанныеОперации)

	УточнениеОперации = НовыйУточнениеОперацииПеремещения();
	УточнениеОперации.ИдентификаторЗаписи = ДанныеОперации.ИдентификаторЗаписи;
	УточнениеОперации.ДатаРазмещения =  ДанныеОперации.Дата;
	УточнениеОперации.СчетРазмещения =  ДанныеОперации.БанковскийСчетКасса;
	
	Операция.УточнениеОперации = УточнениеОперации;
	
КонецПроцедуры

&НаСервере
Функция НовыйУточнениеОперацииПеремещения()

	УточнениеОперации = Новый Структура;
	УточнениеОперации.Вставить("ИдентификаторЗаписи");
	УточнениеОперации.Вставить("ДатаРазмещения");
	УточнениеОперации.Вставить("СчетРазмещения");

	Возврат УточнениеОперации;
	
КонецФункции 

&НаСервере
Функция ПредставлениеОперацииПеремещенияЗаявки(НовыеПараметрыЗаявки, СтарыеПараметрыЗаявки)
	
	ПредставлениеОперации = ""; 
	ФорматДаты = "ДЛФ=D";
	
	ДанныеОперацииПеремещенияЗаявкиДляШаблона = Отчеты.ПлатежныйКалендарьУХ.ДанныеОперацииПеремещенияЗаявкиДляШаблона(СтарыеПараметрыЗаявки.БанковскийСчетКасса,НовыеПараметрыЗаявки.БанковскийСчетКасса);

	Если СтарыеПараметрыЗаявки.БанковскийСчетКасса <> НовыеПараметрыЗаявки.БанковскийСчетКасса Тогда
		Если ЗначениеЗаполнено(СтарыеПараметрыЗаявки.БанковскийСчетКасса) И ЗначениеЗаполнено(НовыеПараметрыЗаявки.БанковскийСчетКасса) Тогда
			
			Если СтарыеПараметрыЗаявки.Дата = НовыеПараметрыЗаявки.Дата Тогда
				ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Перемещение ""%1"" %4 %2 %5 %3'"),
													СтарыеПараметрыЗаявки.Инструмент,
													СтарыеПараметрыЗаявки.БанковскийСчетКасса,
													НовыеПараметрыЗаявки.БанковскийСчетКасса,
													ДанныеОперацииПеремещенияЗаявкиДляШаблона.Источник,
													ДанныеОперацииПеремещенияЗаявкиДляШаблона.Приемник);
												
			Иначе
				ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Перемещение ""%1"" %6 %2 %7 %3 с %4 на %5'"),
													СтарыеПараметрыЗаявки.Инструмент,
													СтарыеПараметрыЗаявки.БанковскийСчетКасса,
													НовыеПараметрыЗаявки.БанковскийСчетКасса,
													Формат(СтарыеПараметрыЗаявки.Дата, ФорматДаты),
													Формат(НовыеПараметрыЗаявки.Дата, ФорматДаты),
													ДанныеОперацииПеремещенияЗаявкиДляШаблона.Источник,
													ДанныеОперацииПеремещенияЗаявкиДляШаблона.Приемник);								
			КонецЕсли;
												
		ИначеЕсли ЗначениеЗаполнено(НовыеПараметрыЗаявки.БанковскийСчетКасса) Тогда
			
			ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Размещение ""%1"" %3 %2'"),
												СтарыеПараметрыЗаявки.Инструмент,
												НовыеПараметрыЗаявки.БанковскийСчетКасса,
												ДанныеОперацииПеремещенияЗаявкиДляШаблона.Приемник);
												
		ИначеЕсли ЗначениеЗаполнено(СтарыеПараметрыЗаявки.БанковскийСчетКасса) Тогда
			
			 ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Отмена размещения ""%1"" %3 %2'"),
												СтарыеПараметрыЗаявки.Инструмент,
												СтарыеПараметрыЗаявки.БанковскийСчетКасса,
												ДанныеОперацииПеремещенияЗаявкиДляШаблона.Приемник);
												
		КонецЕсли;
		
	ИначеЕсли СтарыеПараметрыЗаявки.Дата <> НовыеПараметрыЗаявки.Дата Тогда
				
		ПредставлениеОперации = СтрШаблон(НСтр("ru = 'Изменение даты ""%1"" с %2 на %3'"),
												СтарыеПараметрыЗаявки.Инструмент,
												Формат(СтарыеПараметрыЗаявки.Дата, ФорматДаты),
												Формат(НовыеПараметрыЗаявки.Дата, ФорматДаты));
	КонецЕсли;
	
	Возврат ПредставлениеОперации;
	
КонецФункции

&НаСервере
Процедура УдалитьДвиженияИнструмента(ИдентификаторОперации)
	
	НачатьТранзакцию();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря КАК ВерсияПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Пользователь КАК Пользователь,
	|	ПредставлениеПлатежногоКалендаря.Активна КАК Активна,
	|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
	|	ПредставлениеПлатежногоКалендаря.Банк КАК Банк,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Инструмент КАК Инструмент,
	|	ПредставлениеПлатежногоКалендаря.Приоритет КАК Приоритет,
	|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации КАК ИдентификаторДобавившейОперации,
	|	ПредставлениеПлатежногоКалендаря.Сумма КАК Сумма,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации КАК ИдентификаторОтменившейОперации,
	|	ПредставлениеПлатежногоКалендаря.ПулЛиквидности КАК ПулЛиквидности,
	|	ПредставлениеПлатежногоКалендаря.Оптимизация КАК Оптимизация,
	|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
	|	ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации = &ИдентификаторОперации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря КАК ВерсияПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Пользователь КАК Пользователь,
	|	ПредставлениеПлатежногоКалендаря.Активна КАК Активна,
	|	ПредставлениеПлатежногоКалендаря.Организация КАК Организация,
	|	ПредставлениеПлатежногоКалендаря.Валюта КАК Валюта,
	|	ПредставлениеПлатежногоКалендаря.Банк КАК Банк,
	|	ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ПредставлениеПлатежногоКалендаря.РазделПлатежногоКалендаря КАК РазделПлатежногоКалендаря,
	|	ПредставлениеПлатежногоКалендаря.Инструмент КАК Инструмент,
	|	ПредставлениеПлатежногоКалендаря.Приоритет КАК Приоритет,
	|	ПредставлениеПлатежногоКалендаря.Дата КАК Дата,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторДобавившейОперации КАК ИдентификаторДобавившейОперации,
	|	ПредставлениеПлатежногоКалендаря.Сумма КАК Сумма,
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации КАК ИдентификаторОтменившейОперации,
	|	ПредставлениеПлатежногоКалендаря.ПулЛиквидности КАК ПулЛиквидности,
	|	ПредставлениеПлатежногоКалендаря.Оптимизация КАК Оптимизация,
	|	ПредставлениеПлатежногоКалендаря.ВидДенежныхСредств КАК ВидДенежныхСредств,
	|	ПредставлениеПлатежногоКалендаря.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ИдентификаторОтменившейОперации = &ИдентификаторОперации";
	
	Запрос.УстановитьПараметр("ИдентификаторОперации", ИдентификаторОперации);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаНовыеОперации = РезультатЗапроса[0].Выбрать();
	Пока ВыборкаНовыеОперации.Следующий() Цикл
		МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, ВыборкаНовыеОперации);
		МЗ.Удалить();
	КонецЦикла;
	
	ВыборкаОтмененныеОперации = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаОтмененныеОперации.Следующий() Цикл
		МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, ВыборкаОтмененныеОперации);
		МЗ.Прочитать();
		МЗ.Активна = Истина;
		МЗ.ИдентификаторОтменившейОперации = ОбщегоНазначенияКлиентСерверУХ.ПустойУникальныйИдентификатор();
		МЗ.Записать();
	КонецЦикла;

	ЗафиксироватьТранзакцию();  
	
КонецПроцедуры

&НаСервере
Функция АдресТаблицыЗапланированныхСделок(ЭтоПривлечениеСредств, ИдентификаторТекущейОперации = Неопределено)
	
	Таблица = ТаблицаЗапланированныхСделок(ЭтоПривлечениеСредств, ИдентификаторТекущейОперации);	
	АдресВХранилище = ПоместитьВоВременноеХранилище(Таблица, УникальныйИдентификатор);
	
	Возврат АдресВХранилище;

КонецФункции

&НаСервере
Процедура УстановитьОтборОперацийНаСервере()
	
	Если ФильтрОперацийПоЯчейке Тогда
		СтруктураОтбора = СтруктураОтбораОперацийПоДаннымЯчейки(ДанныеВыбраннойЯчейки);
	Иначе	
		СтруктураОтбора = Новый Структура("ВидОперации, Организация", ОтборПоВидуОперации, ОтборОперацийПоОрганизации);
	КонецЕсли;
	
	ЗаполнитьЗначениеОтбораОпераций(СтруктураОтбора);
	Элементы.ПрогнозныеОперации.ОтборСтрок = Новый ФиксированнаяСтруктура("УсловиеОтбора", Истина);
	
КонецПроцедуры

&НаСервере
Функция СтруктураОтбораОперацийПоДаннымЯчейки(ДанныеВыбраннойЯчейки)
	
	СтруктураОтбора = Новый Структура;
	Для каждого СтрокаДанных Из ДанныеВыбраннойЯчейки Цикл
		Если СтрокаДанных.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно	Тогда
			СтруктураОтбора.Вставить(СтрокаДанных.ИмяПоля, СтрокаДанных.Значение);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат СтруктураОтбора;
	
КонецФункции

&НаСервере 
Процедура ЗаполнитьЗначениеОтбораОпераций(СтруктураОтбора)
	
	Для Каждого СтрокаОперации Из ПрогнозныеОперации Цикл
		
		СтрокаОперации.УсловиеОтбора = Истина;
		
		Если СтруктураОтбора.Свойство("ВидОперации") И ЗначениеЗаполнено(СтруктураОтбора.ВидОперации) Тогда
			Если СтрокаОперации.ВидОперации <> СтруктураОтбора.ВидОперации Тогда
			 	СтрокаОперации.УсловиеОтбора = Ложь;
			КонецЕсли;	
		КонецЕсли;
		
		Если СтруктураОтбора.Свойство("Организация") И ЗначениеЗаполнено(СтруктураОтбора.Организация) Тогда
			Если СтрокаОперации.ОрганизацияСписания <> СтруктураОтбора.Организация И СтрокаОперации.ОрганизацияЗачисления <> СтруктураОтбора.Организация Тогда
				СтрокаОперации.УсловиеОтбора = Ложь;
			КонецЕсли;	
		КонецЕсли;
		
		Если СтруктураОтбора.Свойство("Валюта") И ЗначениеЗаполнено(СтруктураОтбора.Валюта) Тогда
			Если СтрокаОперации.ВалютаСписания <> СтруктураОтбора.Валюта И СтрокаОперации.ВалютаЗачисления <> СтруктураОтбора.Валюта Тогда
				СтрокаОперации.УсловиеОтбора = Ложь;
			КонецЕсли;	
		КонецЕсли;
		
		Если СтруктураОтбора.Свойство("БанковскийСчетКасса") И ЗначениеЗаполнено(СтруктураОтбора.БанковскийСчетКасса) Тогда 
			Если СтрокаОперации.БанковскийСчетКассаСписания <> СтруктураОтбора.БанковскийСчетКасса И СтрокаОперации.БанковскийСчетКассаЗачисления <> СтруктураОтбора.БанковскийСчетКасса Тогда
				СтрокаОперации.УсловиеОтбора = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если СтруктураОтбора.Свойство("Дата") И ЗначениеЗаполнено(СтруктураОтбора.Дата) Тогда
			Если СтрокаОперации.ДатаЗачисления <> СтруктураОтбора.Дата И СтрокаОперации.ДатаСписания <> СтруктураОтбора.Дата И СтрокаОперации.ДатаВыплатыПроцентов <> СтруктураОтбора.Дата Тогда
				 СтрокаОперации.УсловиеОтбора = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуВыбораЗависимыхЯчеекОперации()
	
	ТекущаяСтрока = Элементы.ПрогнозныеОперации.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущиеДанные = Элементы.ПрогнозныеОперации.ТекущиеДанные;
		ДанныеОперации = Новый Структура;
		ДанныеОперации.Вставить("ИдентификаторОперации", ТекущиеДанные.ИдентификаторОперации);
		ДанныеОперации.Вставить("ПредставлениеОперации", ТекущиеДанные.ПредставлениеОперации);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПрогнозныеОперацииПерейтиКЯчейкамЗавершение", ЭтотОбъект);
		ОткрытьФорму("Отчет.ПлатежныйКалендарьУХ.Форма.ФормаПереходаКЯчейкамОперации", ДанныеОперации, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите операцию в списке.'"));
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Функция ВыделитьЯчейкуКалендаряНаСервере(КлючЗаписи) 
	
	Результат = Новый Структура("Успешно, ТекстОшибки", Истина, "");
	
	Если Отчет.ВариантПлатежногоКалендаря = Перечисления.ВариантыПлатежногоКалендаря.ПерспективноеПланирование Тогда
 		ТекстЗаголовокСтолбца = СтроковоеПредставлениеДаты(КлючЗаписи.Дата, Отчет);
	Иначе
 		ТекстЗаголовокСтолбца = СтроковоеПредставлениеРазделаПлатежногоКалендаря(КлючЗаписи, Отчет);
	КонецЕсли;
	// Ищем самую нижнюю группировку
	НайденноеПоле = Неопределено;  
	КоличествоГруппировок = Отчет.ГруппировкиОтчета.Количество();
	Для Сч = 1 По КоличествоГруппировок Цикл
		ЭлГруппировки = Отчет.ГруппировкиОтчета.Получить(КоличествоГруппировок - Сч);
		Если ЭлГруппировки.Пометка Тогда
			НайденноеПоле = ЭлГруппировки.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденноеПоле = Неопределено Тогда
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'некорректная структура платежного календаря'");
	КонецЕсли; 
	
	НайденноеЗначение = КлючЗаписи[НайденноеПоле];
	Если Не ЗначениеЗаполнено(НайденноеЗначение) Тогда
		
		Если НайденноеПоле = "БанковскийСчетКасса" Тогда
			НайденноеЗначение = НСтр("ru = '<Банковский счет / касса не определен>'");
		ИначеЕсли НайденноеПоле = "Банк" Тогда
			НайденноеЗначение = НСтр("ru = '<Банк не определен>'");
		ИначеЕсли НайденноеПоле = "Организация" Тогда
			НайденноеЗначение = НСтр("ru = '<Организация не определена>'");
		ИначеЕсли НайденноеПоле = "ПулЛиквидности" Тогда
			НайденноеЗначение = НСтр("ru = '<Не объединены в пул>'");
		КонецЕсли;
	КонецЕсли;
	
	ОблСтрока = МакетОстатки.НайтиТекст(Строка(НайденноеЗначение),,,Ложь);
	ОблСтолбец = МакетОстатки.НайтиТекст(ТекстЗаголовокСтолбца);
	
	Если ОблСтрока <> Неопределено И ОблСтолбец <> Неопределено Тогда
		НайденнаяОбласть = МакетОстатки.Область(ОблСтрока.Верх, ОблСтолбец.Лево);
		Элементы.Остатки.УстановитьВыделенныеОбласти(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НайденнаяОбласть));		
	Иначе
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'некорректно определено значение аналитик поиска.'");		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОстатокПоСчетуНаДату(БанковскийСчетКасса, Дата)
	
	Остаток = 0;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СУММА(ПредставлениеПлатежногоКалендаря.Сумма) КАК Сумма
	|ИЗ
	|	РегистрСведений.ПредставлениеПлатежногоКалендаря КАК ПредставлениеПлатежногоКалендаря
	|ГДЕ
	|	ПредставлениеПлатежногоКалендаря.ВерсияПлатежногоКалендаря = &ВерсияПлатежногоКалендаря
	|	И ПредставлениеПлатежногоКалендаря.Пользователь = &Пользователь
	|	И ПредставлениеПлатежногоКалендаря.Активна
	|	И ПредставлениеПлатежногоКалендаря.БанковскийСчетКасса = &БанковскийСчетКасса
	|	И ПредставлениеПлатежногоКалендаря.Дата <= &Дата"
	);
	Запрос.УстановитьПараметр("ВерсияПлатежногоКалендаря", Справочники.СохраненныеВерсииПлатежногоКалендаря.ПустаяСсылка());
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("БанковскийСчетКасса", БанковскийСчетКасса);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Остаток = Выборка.Сумма;
	КонецЕсли;
	
	Возврат Остаток;
	
КонецФункции

