&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДоступность(Форма)

	Отчет = Форма.Отчет;
	Элементы = Форма.Элементы;
	
	ЭтоПерспективноеПланирование =  Отчет.ВариантПлатежногоКалендаря = ПредопределенноеЗначение("Перечисление.ВариантыПлатежногоКалендаря.ПерспективноеПланирование");
	
	Элементы.ПериодОтбора.Видимость = ЭтоПерспективноеПланирование;
	Элементы.ПлатежнаяДата.Видимость = Не ЭтоПерспективноеПланирование;
	Элементы.ВыводитьДиаграмму.Видимость = ЭтоПерспективноеПланирование И Не Отчет.ЭтоБазоваяФункциональность;
	Элементы.ГруппаГоризонтыПланирования.Видимость = ЭтоПерспективноеПланирование;
	Элементы.ГруппаГоризонтДолгосрочногоПланирования.Видимость 
						= ЭтоПерспективноеПланирование И Не Отчет.ЭтоБазоваяФункциональность;  
	Элементы.МатрицаВесовГруппаПерспективноеПланирование.Видимость = ЭтоПерспективноеПланирование;
	Элементы.МатрицаВесовГруппаТактическоеПланирование.Видимость = ЭтоПерспективноеПланирование;
	Элементы.ВалютаОтображения.Доступность = Отчет.ВыводитьДанныеВВалютеОтображения;
	Элементы.НадписьВалютаОтображения.Видимость =  Отчет.ВыводитьДанныеВВалютеОтображения;
	Элементы.ГруппаДополнительныеСведения.Видимость = Не Отчет.ЭтоБазоваяФункциональность;
	Элементы.ДекорацияДополнительныеСведения.Видимость =  Отчет.ВыводитьДополнительныеСведения;
	Элементы.ОперативноеПланирование_Приход.Видимость = Не Форма.ИспользоватьДоверительныеКоэффициенты; 
	Элементы.ИспользоватьДоверительныеКоэффициентыПриПланированииПоступлений.Видимость 
							= Форма.ИспользоватьДоверительныеКоэффициенты И Не Отчет.ЭтоБазоваяФункциональность; 
	Элементы.ДетализацияОборотовСтатьяДвиженияДенежныхСредств.Видимость = ЭтоОборотыПоДДС(Форма); 
	
	Если Отчет.РежимВыводаОборотов = ПредопределенноеЗначение("Перечисление.РежимыВыводаОборотовПлатежногоКалендаря.ВыводитьПоСтатьямДДС") Тогда 
		Отчет.ВыводитьТолькоКассовыеРазрывы = Ложь;
		Элементы.ВыводитьТолькоКассовыеРазрывы.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ВыводитьТолькоКассовыеРазрывы.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Элементы.ИсточникиДанныхПредставление.Видимость = Не Отчет.ЭтоБазоваяФункциональность;     
	Элементы.ГруппаПлановыеКурсы.Видимость = Не Отчет.ЭтоБазоваяФункциональность; 
	Элементы.ГруппаМатрицаВесовЛиквидности.Видимость = Не Отчет.ЭтоБазоваяФункциональность;
	Элементы.ГруппаЭкстраполяцияДенежныхПотоков.Видимость = Не Отчет.ЭтоБазоваяФункциональность;
	
КонецПроцедуры 

&НаКлиенте
Функция СобратьДанныеОперацииДляПроверки(ВходящиеДанные,ЭтоКонвертацияВалюты = Ложь,ЭтоВнутригрупповоеПеремещение = Ложь,ЭтоПривлечениеСредств = Ложь)
	
	ДанныеОперации = Новый Структура;
	
	Если ТипЗнч(ВходящиеДанные) = Тип("Структура") Тогда
	
		ДанныеОперации.Вставить("БанковскийСчетКасса",ВходящиеДанные.БанковскийСчетКасса);
		ДанныеОперации.Вставить("ВидДенежныхСредств",ВходящиеДанные.ВидДенежныхСредств);
		
	ИначеЕсли ТипЗнч(ВходящиеДанные) = Тип("СправочникСсылка.Кассы") Тогда
		
		ДанныеОперации.Вставить("БанковскийСчетКасса",ВходящиеДанные);
		ДанныеОперации.Вставить("ВидДенежныхСредств",ПредопределенноеЗначение("Перечисление.ФормыОплаты.Наличная"));

	ИначеЕсли ТипЗнч(ВходящиеДанные) = ДенежныеСредстваВстраиваниеУХКлиентСервер.ТипБанковскиеСчетаОрганизаций() Тогда
		
		ДанныеОперации.Вставить("БанковскийСчетКасса",ВходящиеДанные);
		ДанныеОперации.Вставить("ВидДенежныхСредств",ПредопределенноеЗначение("Перечисление.ФормыОплаты.Безналичная"));
		
	КонецЕсли;
	
	ДанныеОперации.Вставить("ЭтоКонвертацияВалюты",ЭтоКонвертацияВалюты);
	ДанныеОперации.Вставить("ЭтоВнутригрупповоеПеремещение",ЭтоВнутригрупповоеПеремещение);
	ДанныеОперации.Вставить("ЭтоПривлечениеСредств",ЭтоПривлечениеСредств);

	Возврат ДанныеОперации;

КонецФункции 

&НаКлиенте
Процедура АктуализироватьДанныеССохранениемОпераций(ИсточникСобытияФормированияОтчета = "")
	
	Отчет.ИсточникСобытияФормированияОтчета = ИсточникСобытияФормированияОтчета;
	
	ПоднятьДанныеПлатежногоКалендаряЗапуститьВФоне(Истина); 
	ПараметрыОжиданияПодготовкиДанных("АктуализироватьДанные");

	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");    
	
КонецПроцедуры

&НаСервере
Процедура АктуализироватьДанныеНаСервере() 
	
	НачатьТранзакцию();
	Попытка
		
		ТаблицаЗаписейОпераций = ТаблицаЗаписейПредставленийТекущихОпераций();
		ТаблицаЗаписейОпераций.Индексы.Добавить("ИдентификаторОтменившейОперации");
		
		ТаблицаИдентификаторовЗаписей = ТаблицаЗаписейОпераций.Скопировать(, "ИдентификаторЗаписи");
		ТаблицаИдентификаторовЗаписей.Свернуть("ИдентификаторЗаписи");
		МассивИдентификаторовЗаписей = ТаблицаИдентификаторовЗаписей.ВыгрузитьКолонку("ИдентификаторЗаписи");
		ПустойУИД = ОбщегоНазначенияКлиентСерверУХ.ПустойУникальныйИдентификатор();
		Номер = МассивИдентификаторовЗаписей.Найти(ПустойУИД);
		Если Номер <> Неопределено Тогда
			МассивИдентификаторовЗаписей.Удалить(Номер);
		КонецЕсли;	
		
		ТаблицаАктуальныхЗаписей = ТаблицаЗаписейПредставленийПоИдентификаторамЗаписей(МассивИдентификаторовЗаписей);
		ТаблицаАктуальныхЗаписей.Индексы.Добавить("ИдентификаторЗаписи");
		
		ИсключаемыеРеквизиты = "Активна, ИдентификаторДобавившейОперации, ИдентификаторОтменившейОперации, Оптимизация";
		
		МетРегистр = Метаданные.РегистрыСведений.ПредставлениеПлатежногоКалендаря;
		ТабРеквизитыДляСверки = Новый ТаблицаЗначений;
		ТабРеквизитыДляСверки.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));
		ТабРеквизитыДляСверки.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));
		
		Для каждого Реквизит Из МетРегистр.Измерения Цикл
			Если Найти(ИсключаемыеРеквизиты, Реквизит.Имя) = 0 Тогда
				Строка = ТабРеквизитыДляСверки.Добавить();
				Строка.Имя = Реквизит.Имя;
				Строка.Представление = Реквизит.Синоним;
			КонецЕсли;	
		КонецЦикла;
		Для каждого Реквизит Из МетРегистр.Ресурсы Цикл
			Если Найти(ИсключаемыеРеквизиты, Реквизит.Имя) = 0 Тогда
				Строка = ТабРеквизитыДляСверки.Добавить();
				Строка.Имя = Реквизит.Имя;
				Строка.Представление = Реквизит.Синоним;
			КонецЕсли;
		КонецЦикла;
		Для каждого Реквизит Из МетРегистр.Реквизиты Цикл
			Если Найти(ИсключаемыеРеквизиты, Реквизит.Имя) = 0 Тогда
				Строка = ТабРеквизитыДляСверки.Добавить();
				Строка.Имя = Реквизит.Имя;
				Строка.Представление = Реквизит.Синоним;
			КонецЕсли;
		КонецЦикла;
		
		ОперацииКУдалению = Новый Массив;
		Для каждого Операция Из ПрогнозныеОперации Цикл
			
			ИсходнаяЗапись = ТаблицаЗаписейОпераций.Найти(Операция.ИдентификаторОперации, "ИдентификаторОтменившейОперации"); // перемещение, разделение заявки
			Если ИсходнаяЗапись <> Неопределено Тогда
				
				// операция сторнирует другую операцию, ищем саму первую операцию и проверяем ее уже
				СторнирующаяОперация = (ИсходнаяЗапись.ИдентификаторДобавившейОперации <> ПустойУИД);
				Пока ИсходнаяЗапись.ИдентификаторДобавившейОперации <> ПустойУИД Цикл
					ИсходнаяЗапись = ТаблицаЗаписейОпераций.Найти(ИсходнаяЗапись.ИдентификаторДобавившейОперации, "ИдентификаторОтменившейОперации");
				КонецЦикла;
				
				// проверка совпадения реквизитов прошлой и текущей записи по заявке
				АктуальнаяЗапись = ТаблицаАктуальныхЗаписей.Найти(ИсходнаяЗапись.ИдентификаторЗаписи, "ИдентификаторЗаписи");
				Если АктуальнаяЗапись = Неопределено Тогда
					// нет такой заявки
					ОперацииКУдалению.Добавить(Операция);
					Продолжить;
				КонецЕсли;
				
				ОтличающиесяРеквизиты = "";
				Для каждого СтрокаРеквизит Из ТабРеквизитыДляСверки Цикл
					Если ИсходнаяЗапись[СтрокаРеквизит.Имя] <> АктуальнаяЗапись[СтрокаРеквизит.Имя] Тогда
						ОтличающиесяРеквизиты = ОтличающиесяРеквизиты + ", " + СтрокаРеквизит.Представление;
					КонецЕсли;
				КонецЦикла;
				
				ОтличающиесяРеквизиты = Сред(ОтличающиесяРеквизиты, СтрДлина(", ") + 1);
				
				Если ЗначениеЗаполнено(ОтличающиесяРеквизиты) Тогда
					ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон(НСтр("ru = 'Операция %1 удалена, т.к. отличаются реквизиты исходной и актуальной записи: %2'"), 
					Операция.ПредставлениеОперации, ОтличающиесяРеквизиты));
					
					ОперацииКУдалению.Добавить(Операция);			
					Продолжить;		
				КонецЕсли;
				
				Если НЕ СторнирующаяОперация Тогда // уже изменена более ранней операцией
					МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(МЗ, АктуальнаяЗапись);
					МЗ.Прочитать();
					МЗ.Активна = ИсходнаяЗапись.Активна;
					МЗ.ИдентификаторОтменившейОперации = ИсходнаяЗапись.ИдентификаторОтменившейОперации;
					МЗ.Записать();
				КонецЕсли;
			КонецЕсли;
			
			ДобавленныеЗаписиОперации = ТаблицаЗаписейОпераций.НайтиСтроки(Новый Структура("ИдентификаторДобавившейОперации", Операция.ИдентификаторОперации));
			Для каждого Запись Из ДобавленныеЗаписиОперации Цикл
				МЗ = РегистрыСведений.ПредставлениеПлатежногоКалендаря.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МЗ, Запись);
				МЗ.Записать();
			КонецЦикла;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Актуализация данных платежного календаря'"), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	Для каждого Операция Из ОперацииКУдалению Цикл
		ПрогнозныеОперации.Удалить(Операция);
	КонецЦикла;
	
	ПлатежныеДниНедели.ЗагрузитьЗначения(Отчеты.ПлатежныйКалендарьУХ.ПлатежныеДниНедели());
	ПриИзмененииПрогнозныхОпераций();
	
КонецПроцедуры

