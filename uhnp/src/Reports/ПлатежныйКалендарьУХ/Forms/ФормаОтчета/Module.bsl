#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМатрицаВесов

&НаКлиенте
Процедура МатрицаВесовПриИзменении(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	ИмяТекущейКолонки = Элемент.ТекущийЭлемент.Имя;
	КлючевыеЗначения = СтрРазделить(ИмяТекущейКолонки, "_");
	Если КлючевыеЗначения.Количество() <> 2 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Источник", ТекДанные.Источник);
	СтруктураПоиска.Вставить("ГоризонтПланированияЛиквидности", ПредопределенноеЗначение("Перечисление.ГоризонтыПланированияЛиквидности." + КлючевыеЗначения[0]));
	СтруктураПоиска.Вставить("ПриходРасход", ПредопределенноеЗначение("Перечисление.ВидыДвиженийПриходРасход." + КлючевыеЗначения[1]));
	
	НайденныеСтроки = Отчет.МатрицаВесовЛиквидности.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() Тогда
		НайденныеСтроки[0].Вес = ТекДанные[ИмяТекущейКолонки];
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Остатки, "НеАктуальность");
	
КонецПроцедуры

