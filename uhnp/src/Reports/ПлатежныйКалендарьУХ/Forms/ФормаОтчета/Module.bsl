	НайденныеСтроки = ОтображениеПлановыхКурсов.НайтиСтроки(Новый Структура("Валюта", ВалютаВход));
	РезультатФункции = НайденныеСтроки.Количество();
	
	Возврат РезультатФункции;   
	
КонецФункции

