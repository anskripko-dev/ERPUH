
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("РедактированиеТекущейОперации") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.УточнениеОперации);
		НачальныйОстатокНаСчете = Параметры.ОстатокНаСчете;
		ПересчитатьКонечныйОстаток(ЭтотОбъект);
	Иначе		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ДанныеЗаполнения);  
		ДатаПогашения = Параметры.ДанныеЗаполнения.ДатаНачала;
		Сумма = ?(КонечныйОстаток < 0, -КонечныйОстаток, КонечныйОстаток);
		НачальныйОстатокНаСчете = КонечныйОстаток;	
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	ЗаполнитьДоступныеИнструменты();
	
	// установить отметку на договор
	Если ЗначениеЗаполнено(ФинансовыйИнструмент) Тогда
		ПомеченныеСтроки = ДоступныеИнструменты.НайтиСтроки(Новый Структура("ДоговорКонтрагента",ФинансовыйИнструмент));
		Для Каждого ТекСтрока Из ПомеченныеСтроки Цикл
			ТекСтрока.Пометка = Истина;
		КонецЦикла;
	КонецЕсли;
	
	УстановитьДоступностьВалют(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ДоступныеИнструменты.Количество() Тогда
		
		ТекстОшибки = НСтр("ru = 'Нет активных кредитных договоров'");
		
		ПоказатьПредупреждение(, ТекстОшибки);
		Закрыть();

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	МассивНепроверяемыхРеквизитов.Добавить("Сумма");
	Если НЕ ЗначениеЗаполнено(Сумма) Тогда
		
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,"Сумма");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,"Сумма",,Отказ);
		
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов.Добавить("ФинансовыйИнструмент");
	
	Если Не ЗначениеЗаполнено(ФинансовыйИнструмент) И ЭтоПодборДоговора Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо выбрать инструмент из списка доступных.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"ГруппаТабличныйДокумент",,Отказ);
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	ПересчитатьКонечныйОстаток(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СуммаСписанияПриИзменении(Элемент)
	Сумма = СуммаСписания*Курс;
    ПересчитатьКонечныйОстаток(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДатаПогашенияПриИзменении(Элемент)

	ЗаполнитьДоступныеИнструменты();
	ПомеченныеСтроки = ДоступныеИнструменты.НайтиСтроки(Новый Структура("ДоговорКонтрагента",ФинансовыйИнструмент));
	Для Каждого ТекСтрока Из ПомеченныеСтроки Цикл
		ТекСтрока.Пометка = Истина; 
		Курс = ТекСтрока.Курс;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СуммаСписания) Тогда
	    Сумма = СуммаСписания*Курс;
	КонецЕсли;	
 	ПересчитатьКонечныйОстаток(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДоступныеИнструменты

&НаКлиенте
Процедура ДоступныеИнструментыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	ПомеченныеСтроки = ДоступныеИнструменты.НайтиСтроки(Новый Структура("ДоговорКонтрагента",ФинансовыйИнструмент));
	Для Каждого ТекСтрока Из ПомеченныеСтроки Цикл
		ТекСтрока.Пометка = Ложь;
	КонецЦикла;
	
	ФинансовыйИнструмент = ТекДанные.ДоговорКонтрагента;
	Сумма = ТекДанные.Задолженность;
	ТекДанные.Пометка = Истина;
	
	ПересчитатьКонечныйОстаток(ЭтотОбъект);
	// Управление валютами 
	ВалютаСписания = ТекДанные.Валюта;
	Курс = ТекДанные.Курс;
	Если ЗначениеЗаполнено(ВалютаСписания)
		 И ВалютаСписания <> Валюта И ЗначениеЗаполнено(Курс) Тогда
		СуммаСписания = Сумма/Курс;
		Сумма = СуммаСписания*Курс;
	Иначе
		СуммаСписания = 0;	
	КонецЕсли; 
   
    УстановитьДоступностьВалют(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	 Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьПомеченные = ДоступныеИнструменты.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество();
	
	Если Не ЕстьПомеченные Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать договор'"));
		Возврат;
	КонецЕсли;
	
	Закрыть(СтруктураВозвращаемыхЗначений());  
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДоговор(Команда)
	
	ТекДанные = Элементы.ДоступныеИнструменты.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(,ТекДанные.ДоговорКонтрагента);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДоступныеИнструменты()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	               	|	РасчетыСКонтрагентамиГрафикиОстатки.Организация КАК Организация,
	               	|	РасчетыСКонтрагентамиГрафикиОстатки.Контрагент КАК Контрагент,
	               	|	РасчетыСКонтрагентамиГрафикиОстатки.Валюта КАК Валюта,  
					|	&Валюта КАК ВалютаСчета,
	               	|	-РасчетыСКонтрагентамиГрафикиОстатки.СуммаОстаток * (ВЫРАЗИТЬ(ЕСТЬNULL(КурсыВалютДоговора.Курс * КурсыВалютПлатежа.Кратность, 0) / ЕСТЬNULL(КурсыВалютДоговора.Кратность * КурсыВалютПлатежа.Курс, 1) КАК ЧИСЛО(10, 4))) КАК Задолженность,
	               	|	ВЫРАЗИТЬ(ЕСТЬNULL(КурсыВалютДоговора.Курс * КурсыВалютПлатежа.Кратность, 0) / ЕСТЬNULL(КурсыВалютДоговора.Кратность * КурсыВалютПлатежа.Курс, 1) КАК ЧИСЛО(10, 4)) КАК Курс,
	               	|	ВЫРАЗИТЬ(РасчетыСКонтрагентамиГрафикиОстатки.ВерсияГрафика КАК Документ.ВерсияСоглашенияКредит).ПроцентнаяСтавка КАК ПроцентнаяСтавка,
	               	|	ВЫРАЗИТЬ(РасчетыСКонтрагентамиГрафикиОстатки.ВерсияГрафика КАК Документ.ВерсияСоглашенияКредит).ДатаОкончанияДействия КАК СрокКредита,
	               	|	РасчетыСКонтрагентамиГрафикиОстатки.ПредметГрафика КАК ДоговорКонтрагента
	               	|ИЗ
	               	|	РегистрНакопления.РасчетыСКонтрагентамиГрафики.Остатки(
	               	|			&ДатаПогашения,
	               	|			(ПредметГрафика, ВерсияГрафика) В
	               	|				(ВЫБРАТЬ
	               	|					ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	               	|					ДоговорыКонтрагентов.ВерсияСоглашения КАК ВерсияСоглашения
	               	|				ИЗ
	               	|					Справочник.ДоговорыКредитовИДепозитов КАК ДоговорыКонтрагентов
	               	|				ГДЕ
	               	|					ДоговорыКонтрагентов.ВидДоговораУХ = ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.Кредит)
	               	|					И ДоговорыКонтрагентов.ОсновнаяВалютаПлатежей = &Валюта
	               	|					И ДоговорыКонтрагентов.Организация = &Организация)) КАК РасчетыСКонтрагентамиГрафикиОстатки
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаПогашения, ) КАК КурсыВалютДоговора
	               	|		ПО РасчетыСКонтрагентамиГрафикиОстатки.Валюта = КурсыВалютДоговора.Валюта
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаПогашения, ) КАК КурсыВалютПлатежа
	               	|		ПО (&Валюта = КурсыВалютПлатежа.Валюта)
	               	|ГДЕ
	               	|	РасчетыСКонтрагентамиГрафикиОстатки.СуммаОстаток < 0
	               	|	И ВЫБОР
	               	|			КОГДА РасчетыСКонтрагентамиГрафикиОстатки.ВерсияГрафика ССЫЛКА Документ.ВерсияСоглашенияКредит
	               	|				ТОГДА НЕ ВЫРАЗИТЬ(РасчетыСКонтрагентамиГрафикиОстатки.ВерсияГрафика КАК Документ.ВерсияСоглашенияКредит).Реструктуризован
	               	|			ИНАЧЕ ИСТИНА
	               	|		КОНЕЦ";
	Запрос.Параметры.Вставить("ДатаПогашения", 	ДатаПогашения);
	Запрос.Параметры.Вставить("Организация", 	Организация);
	Запрос.УстановитьПараметр("Валюта", 		Валюта);
	
	ДоступныеИнструменты.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

&НаКлиенте
Функция СтруктураВозвращаемыхЗначений()
	
	Результат = Новый Структура("Сумма,СуммаСписания, ВалютаСписания,Валюта,ДатаПогашения,БанковскийСчетКасса,
								|Организация,ФинансовыйИнструмент,ВидОперации,ВидДенежныхСредств");
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма);
	Результат.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежногоКалендаря.ПогашениеКредита");
	Результат.ВидДенежныхСредств = ?(ТипЗнч(Результат.БанковскийСчетКасса) = Тип("СправочникСсылка.Кассы"),
										ПредопределенноеЗначение("Перечисление.ФормыОплаты.Наличная"),
										ПредопределенноеЗначение("Перечисление.ФормыОплаты.Безналичная"));  
										
	Возврат Результат;

КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Цвет фона выбранного договора
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	Для Каждого ТекЭлемент Из Элементы.ДоступныеИнструменты.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда
			Для Каждого ТекПоле Из ТекЭлемент.ПодчиненныеЭлементы Цикл
				КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ТекПоле.Имя);
			КонецЦикла;
		Иначе
			КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ТекЭлемент.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ДоступныеИнструменты.ДоговорКонтрагента", ВидСравненияКомпоновкиДанных.Равно,Новый ПолеКомпоновкиДанных("ФинансовыйИнструмент"),,Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ГиперссылкаЦвет);
	
	// Цвет шрифта неподходящих договоров
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	Для Каждого ТекЭлемент Из Элементы.ДоступныеИнструменты.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда
			Для Каждого ТекПоле Из ТекЭлемент.ПодчиненныеЭлементы Цикл
				КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ТекПоле.Имя);
			КонецЦикла;
		Иначе
			КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ТекЭлемент.Имя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьКонечныйОстаток(Форма)

	Форма.КонечныйОстатокНаСчете = Форма.НачальныйОстатокНаСчете - Форма.Сумма;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьВалют(Форма)
    Элементы = Форма.Элементы;
	ЭтоМультивалютныйПлатеж = ЗначениеЗаполнено(Форма.Валюта) И 
								ЗначениеЗаполнено(Форма.ВалютаСписания)  И
								Форма.Валюта <> Форма.ВалютаСписания;
	Элементы.ГруппаСуммаСписания.Видимость = ЭтоМультивалютныйПлатеж;
	Элементы.ГруппаСуммаОперации.Доступность = НЕ ЭтоМультивалютныйПлатеж;
	
	ЗаголовокСумма = ?(ЭтоМультивалютныйПлатеж, НСтр("ru = 'Сумма к списанию'"), НСтр("ru = 'Сумма погашения'"));
	ЗаголовокСуммаСписания = ?(ЭтоМультивалютныйПлатеж,  НСтр("ru = 'Сумма погашения'"),НСтр("ru = 'Сумма к списанию'"));
	
	Элементы.Сумма.Заголовок = ЗаголовокСумма;
	Элементы.СуммаСписания.Заголовок = ЗаголовокСуммаСписания;
		
КонецПроцедуры

#КонецОбласти
