&НаКлиенте
Процедура ОтправитьПоПочте(Команда)
	ОтображениеСостояния = Элементы.ТабличныйДокументУстановкаЛимитов.ОтображениеСостояния;
	Если ОтображениеСостояния.Видимость = Истина
		И ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность Тогда
		ТекстВопроса = НСтр("ru = 'Отчет не сформирован. Сформировать?'");
		Обработчик = Новый ОписаниеОповещения("СформироватьПередОтправкойПоПочте", ЭтотОбъект);
		ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да);
	Иначе
		ПоказатьДиалогОтправкиПоПочте();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранРесурсВПодменюУправленияРесурсами(Команда)
	
	ОписаниеРесурса = КнопкиРесурсыРеквизит[Команда.Имя];
	Кнопка = Элементы[Команда.Имя];
	КомпоновщикНастроек = ПолучитьКомпоновщикНастроекПоИмениРеквизита(ЭтотОбъект, ОписаниеРесурса.ИмяКомпоновщикаНастроек);
	ВыбранноеПоле = ВыбранноеПолеСКДПоИмени(КомпоновщикНастроек, ОписаниеРесурса.ИмяРесурса);
	Если ВыбранноеПоле <> неопределено Тогда
		Кнопка.Пометка = НЕ Кнопка.Пометка;
		ВыбранноеПоле.Использование = Кнопка.Пометка;
	КонецЕсли;
	СформироватьОтчеты();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Команда(Команда)
	ПостояннаяКоманда = ПостоянныеКоманды.НайтиПоЗначению(Команда.Имя);
	Если ПостояннаяКоманда <> Неопределено И ЗначениеЗаполнено(ПостояннаяКоманда.Представление) Тогда
		МассивПодстрок = СтрРазделить(ПостояннаяКоманда.Представление, ".");
		КлиентскийМодуль = ОбщегоНазначенияКлиент.ОбщийМодуль(МассивПодстрок[0]);
		Обработчик = Новый ОписаниеОповещения(МассивПодстрок[1], КлиентскийМодуль, Команда);
		ВыполнитьОбработкуОповещения(Обработчик, ЭтотОбъект);
	Иначе
		ИнтеграцияПодсистемБСПКлиент.ПриОбработкеКоманды(ЭтотОбъект, Команда, Ложь);
		ОтчетыКлиентПереопределяемый.ОбработчикКоманды(ЭтотОбъект, Команда, Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидБюджетаКоманда(Команда)
	ИмяКоманды = Команда.Имя;
	Если ИмяКоманды = "ВидБюджетаБДДС" Тогда
		Отчет.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств"); 
	ИначеЕсли ИмяКоманды = "ВидБюджетаБДР" Тогда    
		Отчет.ВидБюджета = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов");
	Иначе
		Возврат;
	КонецЕсли;   
	Для Каждого ЭлементКоманда Из Элементы.ГруппаКнопокВидБюджета.ПодчиненныеЭлементы Цикл
		ЭлементКоманда.Пометка = ЭлементКоманда.Имя = ИмяКоманды;
	КонецЦикла;              
	ПриИзмененииВидаБюджетаНаСервере();
	ИзменитьПериод(0);

КонецПроцедуры

&НаКлиенте
Процедура КомандаГод(Команда)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимВыбора", 			Истина);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", 	Истина);
	ПараметрыОткрытия.Вставить("Отбор", 				Новый Структура("ВидБюджета", Отчет.ВидБюджета)); 
	
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитирования.Форма.ФормаВыбораПериода", 
							ПараметрыОткрытия, 
							ЭтаФорма,,,, 
							Новый ОписаниеОповещения("КомандаГодЗавершение", ЭтотОбъект), 
							РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

