&НаСервере
Процедура СформироватьМенюУправленияРесурсами()
	
	КнопкиРесурсы = Новый Соответствие;
	
	// Установка лимитов по данным бюджетирования
	РесурсыУстановкаЛимитов = Новый Массив;
	РесурсыУстановкаЛимитов.Добавить("Сценарий");
	РесурсыУстановкаЛимитов.Добавить("Состояние");
	РесурсыУстановкаЛимитов.Добавить("Актуальность");
	РесурсыУстановкаЛимитов.Добавить("Лимит");
	РесурсыУстановкаЛимитов.Добавить("Корректировка");
	РесурсыУстановкаЛимитов.Добавить("ЕстьЛимит");
	РесурсыУстановкаЛимитов.Добавить("ЕстьКорректировка");
	РесурсыУстановкаЛимитов.Добавить("УОП");
	
	СформироватьЭлементыМенюУправленияРесурсами(
		КнопкиРесурсы, Элементы.ПодменюРесурсовУстановкаЛимитовПоДаннымБюджетирования,
		РесурсыУстановкаЛимитов, "РесурсыУстановкаЛимитов_%1", "Отчет.КомпоновщикНастроек");
		
	КнопкиРесурсыРеквизит = Новый ФиксированноеСоответствие(КнопкиРесурсы);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЭлементыМенюУправленияРесурсами(КнопкиРесурсы, Подменю, Ресурсы, ШаблонИмени, ИмяКомпоновщикаНастроек)
	
	КомпоновщикНастроек = ПолучитьКомпоновщикНастроекПоИмениРеквизита(ЭтотОбъект, ИмяКомпоновщикаНастроек);
	
	ЗаголовкиКнопок = Новый Соответствие;
	ЗаголовкиКнопок.Вставить("ЕстьКорректировка", НСтр("ru = 'Есть корректировки лимитов'"));
	ЗаголовкиКнопок.Вставить("ЕстьЛимит", НСтр("ru = 'Есть установленные лимиты'"));
	ЗаголовкиКнопок.Вставить("Актуальность", НСтр("ru = 'Соответствие установленных лимитов данным документов бюджетирования'"));
	ЗаголовкиКнопок.Вставить("Лимит", НСтр("ru = 'Сумма лимитов'"));
	ЗаголовкиКнопок.Вставить("Корректировка", НСтр("ru = 'Сумма корректировок'"));
	ЗаголовкиКнопок.Вставить("УОП", НСтр("ru = 'Управление периодом сценария'"));
	
	//
	ИмяДействия = "ВыбранРесурсВПодменюУправленияРесурсами";
	Для Каждого Ресурс Из Ресурсы Цикл
		
		ВыбранноеПоле = ВыбранноеПолеСКДПоИмени(КомпоновщикНастроек, Ресурс);
		Если ВыбранноеПоле = неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКнопкиКоманды = СтрШаблон(ШаблонИмени, Ресурс);
		
		ЗаголовокКнопки = ЗаголовкиКнопок[Ресурс];
		Если ЗаголовокКнопки = неопределено Тогда
			ЗаголовокКнопки = "";
		КонецЕсли;
		
		ФормыУХ.СоздатьКоманду(ЭтотОбъект, ИмяКнопкиКоманды, ВыбранноеПоле.Заголовок, ИмяДействия);
		Кнопка = ФормыУХ.СоздатьКнопкуФормы(Элементы, ИмяКнопкиКоманды, ЗаголовокКнопки, ИмяКнопкиКоманды, ВидКнопкиФормы.КнопкаКоманднойПанели, Подменю);
		Кнопка.Пометка = ВыбранноеПоле.Использование;
		
		ОписаниеРесурса = Новый Структура("ИмяКомпоновщикаНастроек, ИмяРесурса", ИмяКомпоновщикаНастроек, Ресурс);
		КнопкиРесурсы.Вставить(ИмяКнопкиКоманды, ОписаниеРесурса);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВыбранноеПолеСКДПоИмени(КомпоновщикНастроекКонтрольИсполнения, ИмяРесурса)
	
	ИскомоеПоле = Новый ПолеКомпоновкиДанных(ИмяРесурса);
	Для Каждого Строка Из КомпоновщикНастроекКонтрольИсполнения.Настройки.Выбор.Элементы Цикл
		Если Строка.Поле = ИскомоеПоле Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКомпоновщикНастроекПоИмениРеквизита(Форма, ИмяКомпоновщикаНастроек)
	
	Путь = СтрРазделить(ИмяКомпоновщикаНастроек, ".");
	Если Путь.Количество() = 1 Тогда
		Возврат Форма[Путь[0]];
	Иначе
		Возврат Форма[Путь[0]][Путь[1]];
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКнопокПоВыделеннымЯчейкам()
	
	//
	ДанныеЯчеек = ВыделенныеЯчейкиДляУстановкиЛимитов();
	ПараметрыКоманд = ВыполнитьАнализВыбранныхЯчеек(ДанныеЯчеек);
	
	// УСТАНОВИТЬ ЛИМИТЫ
	НастроитьКнопку(Элементы.УстановитьЛимитыПоПериодам,	НСтр("ru = 'по периоду'"), 						"ВыбранныеПериоды", ПараметрыКоманд);
	НастроитьКнопку(Элементы.УстановитьЛимитыПоЦФО,			НСтр("ru = 'по выбранным ЦФО и проектам'"),			"ВыбранныеЦФОПроект", ПараметрыКоманд);
	Элементы.ГруппаУстановитьЛимиты.Доступность = Элементы.УстановитьЛимитыПоПериодам.Доступность ИЛИ Элементы.УстановитьЛимитыПоЦФО.Доступность;
	
	// ОТМЕНИТЬ УСТАНОВКУ ЛИМИТОВ
	НастроитьКнопку(Элементы.ОтменитьУстановкуЛимитовПоПериодам,	НСтр("ru = 'по периоду'"),				"ВыбранныеПериоды", ПараметрыКоманд);
	НастроитьКнопку(Элементы.ОтменитьУстановкуЛимитыПоЦФО,			НСтр("ru = 'по выбранным ЦФО и проектам'"),	"ВыбранныеЦФОПроект", ПараметрыКоманд);
	Элементы.ГруппаОтменитьУстановкуЛимитов.Доступность = Элементы.ОтменитьУстановкуЛимитовПоПериодам.Доступность ИЛИ Элементы.ОтменитьУстановкуЛимитыПоЦФО.Доступность;
	
	// ЗАКРЫТИЕ ПЕРИОДА
	НастроитьКнопку(Элементы.ПериодЛимитированияЗакрытьПоПериодам,	НСтр("ru = 'по периоду'"),				"ВыбранныеПериоды", ПараметрыКоманд);
	НастроитьКнопку(Элементы.ПериодЛимитированияЗакрытьПоЦФО,		НСтр("ru = 'по выбранным ЦФО и проектам'"), "ВыбранныеЦФОПроект", ПараметрыКоманд);
	Элементы.ГруппаЗаблокироватьПериодыЛимитирования.Доступность = Элементы.ПериодЛимитированияЗакрытьПоПериодам.Доступность ИЛИ Элементы.ПериодЛимитированияЗакрытьПоЦФО.Доступность;
	
	// ОТКРЫТЬ ПЕРИОДА
	НастроитьКнопку(Элементы.ПериодЛимитированияОткрытьПоПериодам,	НСтр("ru = 'по периоду'"),				"ВыбранныеПериоды", ПараметрыКоманд);
	НастроитьКнопку(Элементы.ПериодЛимитированияОткрытьПоЦФО,		НСтр("ru = 'по выбранным ЦФО и проектам'"), "ВыбранныеЦФОПроект", ПараметрыКоманд);
	Элементы.ГруппаРазблокироватьПериодыЛимитирования.Доступность = Элементы.ПериодЛимитированияОткрытьПоПериодам.Доступность ИЛИ Элементы.ПериодЛимитированияОткрытьПоЦФО.Доступность;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьКнопку(Кнопка, Заголовок, ИмяКоманды, ПараметрыКоманд)
	
	ПараметрыКоманды = неопределено;
	Кнопка.Доступность = ПараметрыКоманд.Свойство(ИмяКоманды, ПараметрыКоманды) И ПараметрыКоманды.ДанныеВыбрано.Количество();
	Если Кнопка.Доступность Тогда
		ТекстСообщения = Заголовок+" "+СтрШаблон(НСтр("ru = '(%1 шт)'"), ПараметрыКоманды.ДанныеВыбрано.Количество());
	Иначе
		ТекстСообщения = Заголовок;
	КонецЕсли;
	Кнопка.Заголовок = ТекстСообщения;
	
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьАнализВыбранныхЯчеек(ДанныеЯчеек)
	
	ПараметрыКоманд = Новый Структура;
	
	ВыбраныЯчейкиСПолнымПериодом(ДанныеЯчеек, ПараметрыКоманд);
	ВыбраныЯчейкиСОрганизациями(ДанныеЯчеек, ПараметрыКоманд);
	
	Возврат ПараметрыКоманд;
	
КонецФункции

&НаКлиенте
Процедура ВыбраныЯчейкиСПолнымПериодом(ДанныеЯчеек, ДопПараметры)
	
	Если ТипЗнч(ДопПараметры) <> Тип("Структура") Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Данные", Новый Массив);
	ПараметрыКоманды.Вставить("ДанныеВыбрано", Новый Массив);
	ПараметрыКоманды.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ПараметрыКоманды.Вставить("ПериодичностьЛимитирования", Периодичность);
	ПараметрыКоманды.Вставить("Предназначение", Отчет.Предназначение);
	ПараметрыКоманды.Вставить("НачалоПериода", НачалоГода(Отчет.ОтчетнаяДата));
	ПараметрыКоманды.Вставить("ОкончаниеПериода", НачалоДня(КонецГода(Отчет.ОтчетнаяДата)));
	
	ИменаСвойств = "ВидБюджета, ПериодЛимитирования, ЦФО, Проект, УОП, Сценарий";
	
	Для Каждого Ячейка Из ДанныеЯчеек Цикл
		
		Если Ячейка.Количество() <> 2 ИЛИ НЕ Ячейка.Свойство("ВидБюджета") ИЛИ НЕ Ячейка.Свойство("ПериодЛимитирования") Тогда
			Продолжить;
		КонецЕсли;
		
		Свойства = Новый Структура(ИменаСвойств);
		ЗаполнитьЗначенияСвойств(Свойства, Ячейка);
		ПараметрыКоманды.ДанныеВыбрано.Добавить(Свойства);
		
		Для Каждого ЦФОПроект Из Отчет.ЦФОПроекты Цикл
			Свойства = Новый Структура(ИменаСвойств);
			ЗаполнитьЗначенияСвойств(Свойства, Ячейка);
			ЗаполнитьЗначенияСвойств(Свойства, ЦФОПроект);
			ПараметрыКоманды.Данные.Добавить(Свойства);
		КонецЦикла;
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ВыбранныеПериоды", ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраныЯчейкиСОрганизациями(ДанныеЯчеек, ДопПараметры)
	
	Если ТипЗнч(ДопПараметры) <> Тип("Структура") Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Данные", Новый Массив);
	ПараметрыКоманды.Вставить("ДанныеВыбрано", Новый Массив);
	ПараметрыКоманды.Вставить("ВидБюджета", Отчет.ВидБюджета);
	ПараметрыКоманды.Вставить("ПериодичностьЛимитирования", Периодичность);
	ПараметрыКоманды.Вставить("Предназначение", Отчет.Предназначение);
	ПараметрыКоманды.Вставить("НачалоПериода", НачалоГода(Отчет.ОтчетнаяДата));
	ПараметрыКоманды.Вставить("ОкончаниеПериода", НачалоДня(КонецГода(Отчет.ОтчетнаяДата)));
	
	ЦФОПроектПериод.Очистить(); // Через этот реквизит формы устраняем дубли
	Для Каждого Ячейка Из ДанныеЯчеек Цикл
		
		Если Ячейка.Свойство("ВидБюджета")
			И Ячейка.Свойство("ПериодЛимитирования")
			И Ячейка.Свойство("ЦФО")
			И Ячейка.Свойство("Проект") Тогда
			
			Если ДобавитьВДанныеЦФОПроектПериод(Ячейка) Тогда
				ПараметрыКоманды.Данные.Добавить(Ячейка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	ПараметрыКоманды.ДанныеВыбрано = ПараметрыКоманды.Данные;
	
	ДопПараметры.Вставить("ВыбранныеЦФОПроект", ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураСоответствуетЭталону(Структура, СтруктураЭталон)
	
	Результат = Истина;
	Для Каждого КлючЗначение Из СтруктураЭталон Цикл
		Результат = Результат И Структура.Свойство(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСписокДокументовУстановкиЛимитов(ВыбранныеЦФОПроект)
	
	Если ВыбранныеЦФОПроект.Данные.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ВыбранныеЦФОПроект.Данные[0];
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику"));
	Отбор.Вставить("ВидБюджета", Данные.ВидБюджета);
	Отбор.Вставить("ПериодЛимитирования", Данные.ПериодЛимитирования);
	Отбор.Вставить("ЦФО", Данные.ЦФО);
	Отбор.Вставить("Проект", Данные.Проект);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Отбор", Отбор);
	ДопПараметры.Вставить("КлючПользовательскихНастроек", "СписокДокументовУправлениеЛимитамиСОтборами");
	
	ОткрытьФорму("Документ.УправлениеЛимитами.Форма.ФормаСписка", ДопПараметры, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПоАнализуРасхождений(ВыбранныеЦФОПроект)
	
	Если ВыбранныеЦФОПроект.Данные.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ВыбранныеЦФОПроект.Данные[0];

	Отборы = Новый Структура;
	Отборы.Вставить("ЦФО", Данные.ЦФО);  
	Отборы.Вставить("Проект", Данные.Проект);  
	Отборы.Вставить("ВидБюджета", Данные.ВидБюджета);
	
	ДатыНачалаИОкончанияПериода = ПолучитьДатыНачалаИОкончанияПериода(Данные.ПериодЛимитирования);
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ПериодОтчета", Новый СтандартныйПериод(ДатыНачалаИОкончанияПериода.ДатаНачала, ДатыНачалаИОкончанияПериода.ДатаОкончания));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("КлючВарианта", "АнализРасхожденийЛимитовИДаннныхБюджетирования");
	ПараметрыФормы.Вставить("Отбор", Отборы);	
	ПараметрыФормы.Вставить("ПользовательскиеНастройки",
		ОбщегоНазначенияУХВызовСервера.ЗаполнитьПользовательскиеНастройкиОтчета("АнализРасхожденийЛимитовИДаннныхБюджетирования", ПараметрыОтчета,"АнализРасхожденийЛимитовИДаннныхБюджетирования"));	
	
	ОткрытьФорму("Отчет.АнализРасхожденийЛимитовИДаннныхБюджетирования.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатыНачалаИОкончанияПериода(ПериодСсылка)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПериодСсылка, "ДатаНачала, ДатаОкончания");
	
КонецФункции

&НаКлиенте
Функция ПолучитьНачалоПериода(ПериодЛимитирования)
	
	СтруктураПоиска = Новый Структура("ПериодЛимитирования", ПериодЛимитирования);
	
	Строки = Отчет.Периоды.НайтиСтроки(СтруктураПоиска);
	Если Строки.Количество() = 0 Тогда
		Возврат неопределено;
	КонецЕсли;
	
	Возврат Строки[0].НачалоПериода;
	
КонецФункции

&НаКлиенте
Процедура КомандаГодЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда         
		Если ТипЗнч(ВыбранныйЭлемент) = Тип("Структура") Тогда   
			Отчет.ОтчетнаяДата = ВыбранныйЭлемент.Период;
			Отчет.ПериодичностьЛимитирования = ВыбранныйЭлемент.ПериодичностьЛимитирования;
		Иначе
			Отчет.ОтчетнаяДата = ВыбранныйЭлемент.Значение; 
			Отчет.ПериодичностьЛимитирования = Неопределено;
		КонецЕсли;
		Элементы.КомандаГод.Заголовок = Формат(Отчет.ОтчетнаяДата, "ДФ='dd.MM.yyyy ''г.'");	 
		СформироватьОтчеты();
	КонецЕсли;	
	
КонецПроцедуры       

&НаКлиенте
Процедура СдвинутьПериодОтчета(Знач Направление)
	
	Перем ПараметрыЛимитирования;
	
	ПараметрыЛимитирования = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(Отчет.ВидБюджета, Отчет.ОтчетнаяДата, Направление);
	Если ПараметрыЛимитирования <> Неопределено Тогда
		
		Отчет.ОтчетнаяДата = ПараметрыЛимитирования.Период;          
		Отчет.ПериодичностьЛимитирования = ПараметрыЛимитирования.ПериодичностьЛимитирования;
		
		Элементы.КомандаГод.Заголовок = Формат(Отчет.ОтчетнаяДата, "ДФ='dd.MM.yyyy ''г.'");	  
		
		ЗаполнитьПериоды();
		
		СформироватьОтчеты();    
		
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПериоды()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Периоды.Ссылка КАК ПериодЛимитирования,
	|	Периоды.ДатаНачала КАК НачалоПериода,
	|	Периоды.ДатаОкончания КАК ОкончаниеПериода
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.Произвольный = ЛОЖЬ
	|	И Периоды.Периодичность = &Периодичность
	|	И ГОД(Периоды.ДатаНачала) = &ТребуемыйГод
	|
	|УПОРЯДОЧИТЬ ПО
	|	Периоды.ДатаНачала";
	
	Запрос.УстановитьПараметр("Периодичность", Отчет.ПериодичностьЛимитирования);
	Запрос.УстановитьПараметр("ТребуемыйГод", Год(Отчет.ОтчетнаяДата));

	НовыеПериоды = Запрос.Выполнить().Выгрузить();
    Отчет.Периоды.Загрузить(НовыеПериоды);

КонецПроцедуры

#КонецОбласти

