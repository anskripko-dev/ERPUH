	|	ЕСТЬNULL(ВТ_ДанныеУстановкиЛимитов.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияУстановкиЛимитов.НеУстановлен)) КАК Состояние,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ДанныеУстановкиЛимитов.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияУстановкиЛимитов.НеУстановлен)) = ЗНАЧЕНИЕ(Перечисление.СостоянияУстановкиЛимитов.НеУстановлен)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ДанныеУстановкиЛимитов.Актуальность, ЛОЖЬ)
	|	КОНЕЦ КАК Актуальность,
	|	ЕСТЬNULL(СостояниеПериодовЛимитирования.Закрыт, ЛОЖЬ) КАК ПериодЛимитированияЗакрыт
	|ИЗ
	|	ВТ_ГруппировкиСтрок КАК ВТ_ГруппировкиСтрок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Данные КАК ВТ_Данные
	|		ПО ВТ_ГруппировкиСтрок.ЦФО = ВТ_Данные.ЦФО
	|			И ВТ_ГруппировкиСтрок.Проект = ВТ_Данные.Проект
	|			И ВТ_ГруппировкиСтрок.НачалоПериода = ВТ_Данные.НачалоПериода
	|			И ВТ_ГруппировкиСтрок.Периодичность = ВТ_Данные.Периодичность
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеУстановкиЛимитов КАК ВТ_ДанныеУстановкиЛимитов
	|		ПО ВТ_ГруппировкиСтрок.ЦФО = ВТ_ДанныеУстановкиЛимитов.ЦФО
	|			И ВТ_ГруппировкиСтрок.Проект = ВТ_ДанныеУстановкиЛимитов.Проект
	|			И ВТ_ГруппировкиСтрок.НачалоПериода = ВТ_ДанныеУстановкиЛимитов.НачалоПериода
	|			И ВТ_ГруппировкиСтрок.Периодичность = ВТ_ДанныеУстановкиЛимитов.Периодичность
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПериодовЛимитирования.СрезПоследних(, ВидБюджета = &ВидБюджета) КАК СостояниеПериодовЛимитирования
	|		ПО (&ВидБюджета = СостояниеПериодовЛимитирования.ВидБюджета)
	|			И ВТ_ГруппировкиСтрок.ЦФО = СостояниеПериодовЛимитирования.ЦФО
	|			И ВТ_ГруппировкиСтрок.Проект = СостояниеПериодовЛимитирования.Проект
	|			И ВТ_ГруппировкиСтрок.Периодичность = СостояниеПериодовЛимитирования.Периодичность
	|			И ВТ_ГруппировкиСтрок.НачалоПериода = СостояниеПериодовЛимитирования.НачалоПериода";
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	// Все ЦФО
	ВсеЦФО = Данные.Скопировать(, "ЦФО, Проект");
	ВсеЦФО.Свернуть("ЦФО, Проект", "");
	Отчет.ЦФОПроекты.Загрузить(ВсеЦФО);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	// Получаем схему из макета
	Обработка = РеквизитФормыВЗначение("Отчет");
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет("СКД_УправлениеЛимитами");
	
	//// Из схемы возьмем настройки по умолчанию
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	
	// Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	// Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	// Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанных"));
	
	ВнешниеНаборыДанных = Новый Структура("УстановкаЛимитовПоДаннымБюджетирования", Данные);
	
	// Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ТабличныйДокументУстановкаЛимитов.Очистить();
	
	// Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокументУстановкаЛимитов);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	АдресДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтотОбъект.УникальныйИдентификатор);
	
	// Выводим картинки
	Для НомерСтроки = 1 По ТабличныйДокументУстановкаЛимитов.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По ТабличныйДокументУстановкаЛимитов.ШиринаСтраницы Цикл
			
			Область = ТабличныйДокументУстановкаЛимитов.Область(НомерСтроки, НомерКолонки);
			Расшифровка = Область.Расшифровка;
			Если ТипЗнч(Расшифровка) <> Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;
			
			ПоляРасшифровки = ДанныеРасшифровки.Элементы.Получить(Расшифровка).ПолучитьПоля();
			НайденноеПоле = ПоляРасшифровки.Найти("ПериодЛимитированияЗакрыт");
			Если НайденноеПоле = неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если НайденноеПоле.Значение = Истина Тогда
				Область.Картинка = БиблиотекаКартинок.ЗамокЗакрыт;
				Область.РазмерКартинки = РазмерКартинки.РеальныйРазмер;
				Область.ВертикальноеПоложениеКартинки = ВертикальноеПоложение.Центр;
				Область.ГоризонтальноеПоложениеКартинки = ГоризонтальноеПоложение.Лево;
			КонецЕсли;
		
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыФормыЗаписиПараметровЛимитирования(Период, ВидБюджета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.Период = &Период
	|	И ПараметрыЛимитирования.ВидБюджета = &ВидБюджета";
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Возврат Новый Структура("Ключ", ПолучитьКлючЗаписиПараметровЛимитирования(Период, ВидБюджета));
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияСрезПоследних.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КоличествоПериодовЛимитирования КАК КоличествоПериодовЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьЛимитирование КАК ИспользоватьЛимитирование,
	|	ПараметрыЛимитированияСрезПоследних.ИспользоватьРезервирование КАК ИспользоватьРезервирование,
	|	ПараметрыЛимитированияСрезПоследних.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитированияСрезПоследних.КонтрольРезервов КАК КонтрольРезервов
	|ИЗ
	|	 РегистрСведений.ПараметрыЛимитирования.СрезПоследних(&Период, ВидБюджета = &ВидБюджета) КАК ПараметрыЛимитированияСрезПоследних
	|";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат неопределено;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	Для Каждого Колонка Из Результат.Колонки Цикл
		ЗначенияЗаполнения.Вставить(Колонка.Имя);
	КонецЦикла;
	ЗначенияЗаполнения.Период = Период;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
	
	Возврат Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
КонецФункции

