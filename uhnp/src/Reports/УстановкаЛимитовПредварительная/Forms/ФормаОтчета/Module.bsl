
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//
	Если Параметры.Свойство("УОП") И ЗначениеЗаполнено(Параметры.УОП) Тогда
		Отчет.УОП = Параметры.УОП;
	КонецЕсли;
	
	ИнициализироватьПараметрыОтчетов();	
	
	ОтчетНаименованиеТекущегоВарианта = НСтр("ru = 'Управление установкой лимитами'");
	
	Если ОбщегоНазначения.ЭтоВебКлиент() Тогда 
		Элементы.ПредварительныйПросмотр.Видимость = Ложь;
		Элементы.ПредварительныйПросмотрКонтрольИсполнения.Видимость = Ложь;
		Элементы.ПредварительныйПросмотрЗаявкиНаКорректировку.Видимость = Ложь;
	КонецЕсли;
	
	ПараметрыЛимитирования = ПолучитьПараметрыЛимитированияНаДату(ТекущаяДатаСеанса());
	
	Если ПараметрыЛимитирования = Неопределено Тогда 
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Отсутствуют открытые периоды планирования/лимитирования.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Отчет.ВидБюджета = ПараметрыЛимитирования.ВидБюджета;
	Отчет.Предназначение = ?(Отчет.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств, Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств, Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов);
	
	ОтчетнаяДата = ?(ЗначениеЗаполнено(ПараметрыЛимитирования.Период), 
				ПараметрыЛимитирования.Период, НачалоГода(ТекущаяДатаСеанса()));
	Отчет.ОтчетнаяДата = ОтчетнаяДата;
	
	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить("ПолноеИмя", "");
	НастройкиОтчета.Вставить("СкрытьКомандыРассылки", Истина);
	НастройкиОтчета.Вставить("РазрешеноИзменятьВарианты", Истина);
	НастройкиОтчета.Вставить("События", Новый Структура);
	НастройкиОтчета.События.Вставить("ПриОпределенииСвойствЭлементовФормыНастроек", Ложь);
	НастройкиОтчета.События.Вставить("ПослеЗаполненияПанелиБыстрыхНастроек", Ложь);
	
	// Параметры по умолчанию.
	Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиОтчета, "ВыводитьСуммуВыделенныхЯчеек", Истина) Тогда
		Элементы.ГруппаПоказатель.Видимость = Ложь;
		Элементы.ОбластьПоказателей.Видимость = Ложь;
		Элементы.КомандыВидовПоказателейЕще.Видимость = Ложь;
		Элементы.ТабличныйДокументУстановкаЛимитов.УстановитьДействие("ПриАктивизацииОбласти", "");
	КонецЕсли;
	
	// Тесная интеграция с почтой и рассылкой.
	ДоступнаОтправкаПисем = Ложь;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
		ДоступнаОтправкаПисем = МодульРаботаСПочтовымиСообщениями.ДоступнаОтправкаПисем();
	КонецЕсли;
	Если ДоступнаОтправкаПисем Тогда
		Если НастройкиОтчета.РазрешеноИзменятьВарианты
			И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РассылкаОтчетов")
			И Не НастройкиОтчета.СкрытьКомандыРассылки Тогда
			МодульРассылкаОтчетов = ОбщегоНазначения.ОбщийМодуль("РассылкаОтчетов");
			МодульРассылкаОтчетов.ФормаОтчетаДобавитьКоманды(ЭтотОбъект, Отказ, СтандартнаяОбработка);
		Иначе // Если в подменю одна команда, то выпадающий список не отображается.
			Элементы.ОтправитьПоПочте.Заголовок = Элементы.ГруппаОтправить.Заголовок + "...";
			Элементы.Переместить(Элементы.ОтправитьПоПочте, Элементы.ГруппаОтправить.Родитель, Элементы.ГруппаОтправить);
		КонецЕсли;
	Иначе
		Элементы.ГруппаОтправить.Видимость = Ложь;
	КонецЕсли;
	
	//
	//СформироватьМенюУправленияРесурсами();
	
	//
	Элементы.УОП.Видимость = ЗначениеЗаполнено(Отчет.УОП);    
	
	Если Отчет.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда
		ИмяКоманды = "ВидБюджетаБДДС"; 
	ИначеЕсли Отчет.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов Тогда    
		ИмяКоманды = "ВидБюджетаБДР";
	Иначе
		ИмяКоманды = "НетКоманды";
	КонецЕсли;   
	Для Каждого ЭлементКоманда Из Элементы.ГруппаКнопокВидБюджета.ПодчиненныеЭлементы Цикл
		ЭлементКоманда.Пометка = ЭлементКоманда.Имя = ИмяКоманды;
	КонецЦикла;        
	Элементы.КомандаГод.Заголовок = Формат(Отчет.ОтчетнаяДата, "ДФ='dd.MM.yyyy ''г.'");
	
	Если ЭтаФорма.Параметры.Свойство("КоманднаяПанельВложеннойФормы") Тогда
		УправлениеЛимитамиУХ.ОбрабткаВложеннойФормы(ЭтаФорма, ЭтаФорма.Параметры); 
		Элементы.КоманднаяПанельФормы.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИзменитьПериод(0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписанаКорректировкаЛимитов" Тогда
		ПодключитьОбработчикОжидания("СформироватьОтчетыПриОжидании", 0.2, Истина);
	ИначеЕсли ИмяСобытия = "ЗаписанДокументУправлениеЛимитами" Тогда
		ПодключитьОбработчикОжидания("СформироватьОтчетыПриОжидании", 0.2, Истина);  
	ИначеЕсли ИмяСобытия = "ИзмененыПараметрыЛимитированияБюджета" Тогда
		ПодключитьОбработчикОжидания("СформироватьОтчетыПриОжидании", 0.2, Истина);    
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки, ИспользуютсяСтандартныеНастройки)
	СформироватьМенюУправленияРесурсами();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтчетнаяДатаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДопПараметры = ПолучитьПараметрыФормыЗаписиПараметровЛимитирования(Отчет.ОтчетнаяДата, Отчет.ВидБюджета);
	Если ДопПараметры = неопределено Тогда
		ШаблонСообщения = НСтр("ru = '%1: планирование отключено. 
			|Изменить параметры планирования или лимитирования можно в разделе ""Планирование и контроль"" в пункте ""Настройки планирования и лимитирования"".'");
		ТестСообщения = СтрШаблон(ШаблонСообщения, Отчет.ВидБюджета);
		ПоказатьПредупреждение(, ТестСообщения);
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитирования.ФормаЗаписи", ДопПараметры, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидБюджетаПриИзменении(Элемент)
	ПриИзмененииВидаБюджетаНаСервере();
	ИзменитьПериод(0);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличныйДокументУстановкаЛимитов

&НаКлиенте
Процедура ТабличныйДокументУстановкаЛимитовПриАктивизации(Элемент)
	ПодключитьОбработчикОжидания("УстановитьДоступностьКнопокПоВыделеннымЯчейкам", 0.1, Истина);	
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументУстановкаЛимитовОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	ОбработатьРасшифровку(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументУстановкаЛимитовОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	ОбработатьРасшифровку(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРасшифровку(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	ДанныеЯчеек = ВыделенныеЯчейкиДляУстановкиЛимитов();
	Если ДанныеЯчеек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(
		АдресДанныеРасшифровки,	Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет));
	
	ДоступныеДействия = Новый Массив;
	ДополнительныеПунктыМеню = Новый СписокЗначений;
	
	//
	ПараметрыКоманд = ВыполнитьАнализВыбранныхЯчеек(ДанныеЯчеек);
	Если ПараметрыКоманд.Свойство("ВыбранныеПериоды")
		И ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Установить лимиты по периоду (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("УстановитьЛимитыПоПериоду", Текст, , БиблиотекаКартинок.ПереместитьВправо);
	КонецЕсли;
	Если ПараметрыКоманд.Свойство("ВыбранныеЦФОПроект")
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Установить лимиты по выбранным ЦФО и проектам (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("УстановитьЛимитыПоЦФО", Текст, , БиблиотекаКартинок.ПереместитьВправо);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеПериоды")
		И ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Отменить установку лимитов по периоду (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("ОтменитьУстановкуЛимитовПоПериоду", Текст, , БиблиотекаКартинок.Удалить);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеЦФОПроект")
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Отменить установку лимитов по выбранным ЦФО и проектам (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("ОтменитьУстановкуЛимитовПоЦФО", Текст, , БиблиотекаКартинок.Удалить);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеПериоды")
		И ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Заблокировать периоды лимитирования (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("ЗакрытьПериодПоПериоду", Текст, , БиблиотекаКартинок.ЗакрытьПроцесс);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеПериоды")
		И ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Разблокировать периоды лимитирования (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеПериоды.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("ОткрытьПериодПоПериоду", Текст,, БиблиотекаКартинок.ОсвободитьФайл);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеЦФОПроект")
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Заблокировать периоды лимитирования по выбранным ЦФО и проектам (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("ЗакрытьПериодПоЦФО", Текст, , БиблиотекаКартинок.ЗакрытьПроцесс);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеЦФОПроект")
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Разблокировать периоды лимитирования по выбранным ЦФО и проектам (%1 шт)'");
		Текст = СтрШаблон(Шаблон, ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество());
		ДополнительныеПунктыМеню.Добавить("ОткрытьПериодПоЦФО", Текст,, БиблиотекаКартинок.ОсвободитьФайл);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеЦФОПроект")
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество() = 1 Тогда
		Текст = НСтр("ru = 'Открыть список документов установки лимитов по данным бюджетирования'");
		ДополнительныеПунктыМеню.Добавить("ОткрытьСписокДокументовУстановки", Текст,, БиблиотекаКартинок.ОткрытьФайл);
	КонецЕсли;
	
	Если ПараметрыКоманд.Свойство("ВыбранныеЦФОПроект")
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано.Количество() = 1
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано[0].Свойство("Актуальность")
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано[0].Актуальность = Ложь  
		И ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано[0].Свойство("Состояние")
		И (ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано[0].Состояние = ПредопределенноеЗначение("Перечисление.СостоянияУстановкиЛимитов.Установлен") 
			ИЛИ ПараметрыКоманд.ВыбранныеЦФОПроект.ДанныеВыбрано[0].Состояние = ПредопределенноеЗначение("Перечисление.СостоянияУстановкиЛимитов.УстановленПоНеутвержденнымДанным"))  Тогда
		Текст = НСтр("ru = 'Открыть отчет по анализу расхождений'");
		ДополнительныеПунктыМеню.Добавить("ОткрытьОтчетПоАнализуРасхождений", Текст,, БиблиотекаКартинок.Отчет);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДанныеЯчеек", ДанныеЯчеек);
	ДополнительныеПараметры.Вставить("ПараметрыКоманд", ПараметрыКоманд);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаДополнительнойРасшифровкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещения, Расшифровка, ДоступныеДействия, ДополнительныеПунктыМеню,,Элемент);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДополнительнойРасшифровкиЗавершение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ВыполненноеДействие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКоманд = ДополнительныеПараметры.ПараметрыКоманд;
	
	Если ВыполненноеДействие = "УстановитьЛимитыПоЦФО" Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику"),
			ПараметрыКоманд.ВыбранныеЦФОПроект);
	ИначеЕсли ВыполненноеДействие = "УстановитьЛимитыПоПериоду"	Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.УстановкаЛимитовПоИсточнику"),
			ПараметрыКоманд.ВыбранныеПериоды);
	ИначеЕсли ВыполненноеДействие = "ОтменитьУстановкуЛимитовПоЦФО" Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.ОтменаУстановкиЛимитов"),
			ПараметрыКоманд.ВыбранныеЦФОПроект);
	ИначеЕсли ВыполненноеДействие = "ОтменитьУстановкуЛимитовПоПериоду" Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.ОтменаУстановкиЛимитов"),
			ПараметрыКоманд.ВыбранныеПериоды);
	ИначеЕсли ВыполненноеДействие = "ЗакрытьПериодПоПериоду" Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.ЗакрытиеПериодовЛимитирования"),
			ПараметрыКоманд.ВыбранныеПериоды);
	ИначеЕсли ВыполненноеДействие = "ОткрытьПериодПоПериоду" Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.ОткрытиеПериодовЛимитирования"),
			ПараметрыКоманд.ВыбранныеПериоды);
	ИначеЕсли ВыполненноеДействие = "ЗакрытьПериодПоЦФО" Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.ЗакрытиеПериодовЛимитирования"),
			ПараметрыКоманд.ВыбранныеЦФОПроект);
	ИначеЕсли ВыполненноеДействие = "ОткрытьПериодПоЦФО" Тогда
		СоздатьДокументУправленияЛимитами(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийУправлениеЛимитами.ОткрытиеПериодовЛимитирования"),
			ПараметрыКоманд.ВыбранныеЦФОПроект);
	ИначеЕсли ВыполненноеДействие = "ОткрытьСписокДокументовУстановки" Тогда
		ОткрытьСписокДокументовУстановкиЛимитов(ПараметрыКоманд.ВыбранныеЦФОПроект);
	ИначеЕсли ВыполненноеДействие = "ОткрытьОтчетПоАнализуРасхождений" Тогда
		ОткрытьОтчетПоАнализуРасхождений(ПараметрыКоманд.ВыбранныеЦФОПроект);
	КонецЕсли;
	
КонецПроцедуры

