&НаКлиенте
Процедура СформироватьОтчеты()
	
	ЗаполнитьПериоды();
	
	СформироватьОтчетУстановкаЛимитовНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетУстановкаЛимитовНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ВидБюджета", Отчет.ВидБюджета);
	Запрос.УстановитьПараметр("Предназначение", Отчет.ВидБюджета.Предназначение);
	Запрос.УстановитьПараметр("Периодичность", Отчет.ПериодичностьЛимитирования);
	Запрос.УстановитьПараметр("НачалоУстановки", НачалоГода(Отчет.ОтчетнаяДата));
	Запрос.УстановитьПараметр("ОкончаниеУстановки", НачалоДня(КонецГода(Отчет.ОтчетнаяДата)));
	Запрос.УстановитьПараметр("ТипыКорректировкиЛимитов", КонтрольЛимитовУХ.ТипыКорректировкиЛимитов());

	ОбщегоНазначенияОПК.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_ПериодыЛимитирования", Отчет.Периоды.Выгрузить(, "ПериодЛимитирования"));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОтчетовПараметрыУстановкиЛимитов.Ссылка КАК ВидОтчета
