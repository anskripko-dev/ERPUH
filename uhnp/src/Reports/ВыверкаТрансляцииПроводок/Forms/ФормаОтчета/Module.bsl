
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(Отчет,Параметры);
	
	Если ЗначениеЗаполнено(Параметры.ДокументТрансляции) Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	Трансляция.Организация КАК Организация,
		|	Трансляция.ПериодОтчета КАК ПериодОтчета,
		|	Трансляция.Сценарий КАК Сценарий,
		|	Трансляция.ШаблонКорректировки КАК ШаблонКорректировки,
		|	Трансляция.ИспользуемаяИБ КАК ИспользуемаяИБ,
		|	Трансляция.ИсходныйДокумент КАК ИсходныйДокумент,
		|	Трансляция.ПравилоОбработки КАК ПравилоОбработки,
		|	Трансляция.ПериодОтражения КАК ПериодОтражения
		|ИЗ
		|	Документ.Трансляция КАК Трансляция
		|ГДЕ
		|	Трансляция.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",Параметры.ДокументТрансляции);
		Результат=Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		
		ЗаполнитьЗначенияСвойств(Отчет,Результат);
				
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.Сценарий) Тогда
		
		Отчет.Сценарий=Константы.СценарийМСФО.Получить();
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ОпределитьШаблонКорректировки();
		
	КонецЕсли;
	
	ПриИзмененииШаблонаКорректировки();
			
	Если ЗначениеЗаполнено(Параметры.Период) И ЗначениеЗаполнено(Параметры.ИсходнаяПериодичность) Тогда
		
		Отчет.ПериодОтчета=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(Параметры.Период,Параметры.ИсходнаяПериодичность,0);
		
	КонецЕсли;
		
	Отчет.Периодичность=Параметры.НоваяПериодичность;
	ПериодичностьТрансляции=КэшируемыеПроцедурыУХ.ПолучитьПериодичностьТрансляцииПроводок();
	
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		
		Элементы.ИсходныйДокумент.Видимость=Истина;
		
		Если ЗначениеЗаполнено(Отчет.ПериодОтражения) И (НЕ Отчет.ПериодОтражения=Отчет.ПериодОтчета) Тогда
			
			Элементы.ПериодОтчета.Заголовок=НСтр("ru = 'Период исходных данных с'");
			Элементы.ПериодОтражения.Видимость=Истина;
			
		Иначе
			
			Элементы.ПериодОтчета.Заголовок=НСтр("ru = 'Период с'");
			Элементы.ПериодОтражения.Видимость=Ложь;
			
		КонецЕсли;	 
		
	Иначе
		
		Элементы.ИсходныйДокумент.Видимость=Ложь;
		Элементы.ПериодОтчета.Заголовок=НСтр("ru = 'Период с'");
		Элементы.ПериодОтражения.Видимость=Ложь;
		
	КонецЕсли;	
	 
	 ТипОтчета=Параметры.ТипОтчета;
	 
	 Если Не ЗначениеЗаполнено(ТипОтчета) Тогда
		 
		 ТипОтчета="Корреспонденция";
		 
	 КонецЕсли; 
	 
	 Если Параметры.Свойство("ДатаНач") Тогда
		 
		 Отчет.ДатаНач=Параметры.ДатаНач;
		 Отчет.ДатаКон=Параметры.ДатаКон;
		 Отчет.ПериодОтчета=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(Отчет.ДатаНач,ПериодичностьТрансляции,0);
		 Отчет.ПериодОкончания=ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(Отчет.ДатаКон,ПериодичностьТрансляции,0);
		 
	ИначеЕсли ЗначениеЗаполнено(Отчет.ПериодОтчета) Тогда
		
		ПриИзмененииПериода(НЕ ЗначениеЗаполнено(Отчет.ДокументТрансляции));
		
	КонецЕсли;
	
	Элементы.Дополнительно.Пометка= (ЗначениеЗаполнено(Отчет.СчетДтИсточник) ИЛИ ЗначениеЗаполнено(Отчет.СчетКтИсточник));
	Отчет.ПодробнаяИнформация=Элементы.Дополнительно.Пометка;
	Элементы.ОтборПоКорреспонденции.Видимость=(ТипОтчета="Корреспонденция");
	ОтобразитьПанельНастроек();
	
	СформироватьЗаголовокФормы();
	УстановитьВидимостьКолонокТрансляции();
	УстановитьВидимость();
	
	Если Параметры.ФормироватьОтчет Тогда
		
		ПолучитьДанныеУчетнойПолитики();
		СформироватьОтчетНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.ПоПериодамТрансляции.Видимость=ЗначениеЗаполнено(Отчет.Организация);
	
	Элементы.ГруппаНастройкаПериод.Видимость=Не ЗначениеЗаполнено(Отчет.ИсходныйДокумент);
	Элементы.ИсходныйДокумент.Видимость=ЗначениеЗаполнено(Отчет.ИсходныйДокумент);
	
	
КонецПроцедуры // УстановитьВидимость() 

&НаСервере
Процедура УстановитьВидимостьКолонокТрансляции() 
	
	Элементы.ТаблицаТрансляцииПериодСтрока.Видимость=Отчет.ПоПериодамТрансляции;
	
	Если ТипОтчета="Обороты" Тогда
		
		Элементы.ТаблицаТрансляцииСчетКтИсточник.Видимость=Ложь;
		Элементы.ТаблицаТрансляцииРасхождениеКт.Видимость=Истина;
		Элементы.ТаблицаТрансляцииРасхождениеДт.Заголовок=НСтр("ru = 'Расхождение (дт.)'");
		Элементы.ТаблицаТрансляцииРасхождениеКт.Заголовок=НСтр("ru = 'Расхождение (кт.)'");
		Элементы.ТаблицаТрансляцииСчетДтИсточник.Заголовок=НСтр("ru = 'Счет'");
		
	Иначе
		
		Элементы.ТаблицаТрансляцииСчетКтИсточник.Видимость=Истина;
		Элементы.ТаблицаТрансляцииРасхождениеКт.Видимость=Ложь;
		Элементы.ТаблицаТрансляцииРасхождениеДт.Заголовок=НСтр("ru = 'Расхождение'");
		Элементы.ТаблицаТрансляцииСчетДтИсточник.Заголовок=НСтр("ru = 'Счет дт.'");
		Элементы.ТаблицаТрансляцииСчетКтИсточник.Заголовок=НСтр("ru = 'Счет кт.'");
		
	КонецЕсли;	
	
КонецПроцедуры // УстановитьВидимостьКолонокТрансляции() 

Функция ПолучитьСводноеСостояние(ПериодНачала,Знач ПериодОкончания=Неопределено)
	
	ЕстьДокументыТрансляции=Ложь;
	ИзмененыИсходныеДанные=Ложь;
	ИзмененШаблонКорректировки=Ложь;
	
	Если ПериодОкончания=Неопределено Тогда
		
		ПериодНачалаКорр=ПериодНачала.ДатаНачала;
		ПериодОкончанияКорр=ПериодНачала.ДатаОкончания;
			
		ПериодОкончания=ПериодНачала;
		КоличествоПериодов=1;
		
	Иначе
		
		ТаблицаПериодов=ПолучитьПериодыКорреспонденцииИсточник();
		КоличествоПериодов=ТаблицаПериодов.Количество();
		
		Если ТаблицаПериодов.Количество()>0 Тогда
			
			ПериодНачалаКорр=ТаблицаПериодов[0].Период;
			ПериодОкончанияКорр=ТаблицаПериодов[ТаблицаПериодов.Количество()-1].Период;
			
		Иначе
			
			ПериодНачалаКорр	= Неопределено;
			ПериодОкончанияКорр	= Неопределено;
			
		КонецЕсли;

	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ШаблонКорректировки",Отчет.ШаблонКорректировки);
	Запрос.УстановитьПараметр("Организация",		Отчет.Организация);
	Запрос.УстановитьПараметр("Сценарий",			Отчет.Сценарий);
	
	Если ПериодНачалаКорр=Неопределено Тогда // Нет движений, не проверяем наличие документов
		
		ЕстьДокументыТрансляции=Истина;
		
	Иначе
	
		Запрос.Текст="ВЫБРАТЬ
		|	МАКСИМУМ(Трансляция.ПериодОтчета.ДатаОкончания) КАК МаксДатаОкончания,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Трансляция.Ссылка) КАК Ссылка
		|ИЗ
		|	Документ.Трансляция КАК Трансляция
		|ГДЕ
		|	Трансляция.ПериодОтчета.ДатаОкончания >= &ДатаНачала
		|	И Трансляция.ШаблонКорректировки = &ШаблонКорректировки
		|	И Трансляция.Организация = &Организация
		|	И Трансляция.Сценарий = &Сценарий 
		|	И Трансляция.Проведен
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Трансляция.Ссылка) > 0";
		
		Запрос.УстановитьПараметр("ДатаНачала",ПериодНачалаКорр);
		
		Результат= Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			Если Результат.МаксДатаОкончания>=ПериодОкончанияКорр Тогда
				
				ЕстьДокументыТрансляции=Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	Если Константы.КонтролироватьСостояниеДокументаТрансляции.Получить() И 
		(НЕ ЗначениеЗаполнено(Отчет.ИсходныйДокумент)) Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		             |	СУММА(ДанныеИзменений.ИзмененыИсходныеДанные) КАК ИзмененыИсходныеДанные,
		             |	СУММА(ДанныеИзменений.ИзмененШаблонКорректировки) КАК ИзмененШаблонКорректировки,
		             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИзменений.ДокументТрансляции) КАК ДокументТрансляции
		             |ИЗ
		             |	(ВЫБРАТЬ
		             |		ВЫБОР
		             |			КОГДА ДокументыСводнойТрансляции.ИзмененыИсходныеДанные
		             |				ТОГДА 1
		             |			ИНАЧЕ 0
		             |		КОНЕЦ КАК ИзмененыИсходныеДанные,
		             |		ВЫБОР
		             |			КОГДА ДокументыСводнойТрансляции.ИзмененШаблонКорректировки
		             |				ТОГДА 1
		             |			ИНАЧЕ 0
		             |		КОНЕЦ КАК ИзмененШаблонКорректировки,
		             |		ДокументыСводнойТрансляции.ДокументТрансляции КАК ДокументТрансляции
		             |	ИЗ
		             |		РегистрСведений.ДокументыСводнойТрансляции КАК ДокументыСводнойТрансляции
		             |	ГДЕ
		             |		ДокументыСводнойТрансляции.ШаблонТрансляции = &ШаблонКорректировки
		             |		И ДокументыСводнойТрансляции.ДокументТрансляции.Сценарий = &Сценарий
					 |		И ДокументыСводнойТрансляции.ДокументТрансляции.Проведен
		             |		И ДокументыСводнойТрансляции.Организация = &Организация
		             |		И &ПараметрОтборСводная
		             |	
		             |	ОБЪЕДИНИТЬ ВСЕ
		             |	
		             |	ВЫБРАТЬ
		             |		0,
		             |		1,
		             |		ДокументыДляПовторнойТрансляции.ДокументТрансляции
		             |	ИЗ
		             |		РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции
		             |	ГДЕ
		             |		ДокументыДляПовторнойТрансляции.ШаблонТрансляции = &ШаблонКорректировки
		             |		И ДокументыДляПовторнойТрансляции.ДокументТрансляции.Сценарий = &Сценарий 
					 |		И ДокументыДляПовторнойТрансляции.ДокументТрансляции.Проведен
		             |		И ДокументыДляПовторнойТрансляции.Организация = &Организация
		             |		И &ПараметрОтборПодокументная) КАК ДанныеИзменений
		             |
		             |ИМЕЮЩИЕ
		             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИзменений.ДокументТрансляции) > 0";
		
		Если ЗначениеЗаполнено(Отчет.ДокументТрансляции) Тогда
			
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОтборСводная","ДокументыСводнойТрансляции.ДокументТрансляции = &ДокументТрансляции");
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОтборПодокументная","ЛОЖЬ");
			
			Запрос.УстановитьПараметр("ДокументТрансляции",Отчет.ДокументТрансляции);		
		
		ИначеЕсли ПериодОкончания=Неопределено Тогда
			
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОтборСводная","ДокументыСводнойТрансляции.ПериодОтчета = &ПериодОтчета");
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОтборПодокументная","ДокументыДляПовторнойТрансляции.ДокументТрансляции.ПериодОтчета = &ПериодОтчета");

			Запрос.УстановитьПараметр("ПериодОтчета",ПериодНачала);
			
		Иначе
			
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОтборСводная","	
			|	ДокументыСводнойТрансляции.ПериодОтчета.ДатаНачала >= &НачалоПериода
			|	И ДокументыСводнойТрансляции.ПериодОтчета.ДатаОкончания <= &ОкончаниеПериода");
			
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОтборПодокументная","	
			|	ДокументыДляПовторнойТрансляции.ДокументТрансляции.НачалоПериода >= &НачалоПериода
			|	И ДокументыДляПовторнойТрансляции.ДокументТрансляции.ОкончаниеПериода <= &ОкончаниеПериода");
			
			Запрос.УстановитьПараметр("НачалоПериода",		ПериодНачала.ДатаНачала);
			Запрос.УстановитьПараметр("ОкончаниеПериода",	ПериодОкончания.ДатаОкончания);
			
		КонецЕсли;
				
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			ИзмененыИсходныеДанные		=Результат.ИзмененыИсходныеДанные>0;
			ИзмененШаблонКорректировки  =Результат.ИзмененШаблонКорректировки>0;
			
		КонецЕсли;
		
	КонецЕсли;
		
	ТекстСостояние="";
	
	Если НЕ ЕстьДокументыТрансляции Тогда
		
		ТекстСостояние=ТекстСостояние+", "+ НСтр("ru = 'присутствуют не все документы трансляции'");
		
	КонецЕсли;
				
	Если ИзмененШаблонКорректировки Тогда
		
		ТекстСостояние=ТекстСостояние+", "+НСтр("ru = 'изменен шаблон трансляции '");
		
	КонецЕсли;
	
	Если ИзмененыИсходныеДанные Тогда
		
		ТекстСостояние=ТекстСостояние+", "+НСтр("ru = 'изменены исходные данные '");
		
	КонецЕсли;
	
	ТекстСостояние= Сред(ТекстСостояние,3);
						
	Если НЕ ПустаяСтрока(ТекстСостояние) Тогда
		
		Возврат НСтр("ru = 'Требуется выполнение трансляции: '")+ТекстСостояние;
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции // ПолучитьСводноеСостояние()

&НаСервере
Процедура ОпределитьПараметрыВыверки()
	
	ТипБД=Отчет.ШаблонКорректировки.ПланСчетовИсточник.Владелец;
	
	РегистрБухгалтерииИсточник	= Отчет.ШаблонКорректировки.РегистрБухгалтерииИсточник;
	РегистрБухгалтерииПриемник	= Отчет.ШаблонКорректировки.РегистрБухгалтерииПриемник;
	ПланСчетовИсточник			= Отчет.ШаблонКорректировки.ПланСчетовИсточник;
	ПланСчетовПриемник			= Отчет.ШаблонКорректировки.ПланСчетовПриемник;
	
	Элементы.ИспользуемаяИБ.Видимость=(НЕ ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	РегистрыБухгалтерииБДРесурсы.Имя КАК РесурсИсточник,
	|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК Отображать,
	|	ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник,
	|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК РесурсИсточникБалансовый
	|ИЗ
	|	Справочник.ШаблоныТрансляций.СоответствиеРесурсов КАК ШаблоныТрансляцийСоответствиеРесурсов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрыБухгалтерииБД.Ресурсы КАК РегистрыБухгалтерииБДРесурсы
	|		ПО ШаблоныТрансляцийСоответствиеРесурсов.Ссылка.РегистрБухгалтерииИсточник = РегистрыБухгалтерииБДРесурсы.Ссылка
	|			И ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = РегистрыБухгалтерииБДРесурсы.Имя
	|ГДЕ
	|	ШаблоныТрансляцийСоответствиеРесурсов.Ссылка = &Ссылка
	|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = """"
	|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник = """"";
	
	Запрос.УстановитьПараметр("Ссылка",Отчет.ШаблонКорректировки);
	
	РесурсыДляОтображения.Очистить();
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=РесурсыДляОтображения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
		
	КонецЦикла;
					
КонецПроцедуры // ПриИзмененииШаблонаКорректировки()

&НаСервере
Процедура ОпределитьПравилоОбработки()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПравилаОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаОбработки КАК ПравилаОбработки
	|ГДЕ
	|	ПравилаОбработки.НаправлениеТрансляции = &НаправлениеТрансляции
	|	И ПравилаОбработки.Владелец = &Владелец
	|	И НЕ ПравилаОбработки.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НаправлениеТрансляции",Перечисления.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии);
	Запрос.УстановитьПараметр("Владелец",Отчет.ШаблонКорректировки);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ПравилоОбработки=Результат.Ссылка;
				
	КонецЕсли;
					
КонецПроцедуры // ПриИзмененииШаблонаКорректировки()

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	Если НЕ ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не указан шаблон корректировки'"));
		Возврат;
		
	КонецЕсли;
	
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

&НаСервере
Функция СформироватьДанныеОбъекта()
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("Организация",	Отчет.Организация);
	ДанныеОбъекта.Вставить("ПериодОтчета",	Новый Структура("ДатаНачала,ДатаОкончания",Отчет.ДатаНач,Отчет.ДатаКон));
	ДанныеОбъекта.Вставить("Сценарий",		Отчет.Сценарий);
	ДанныеОбъекта.Вставить("ИспользуемаяИБ",Отчет.ИспользуемаяИБ);
	ДанныеОбъекта.Вставить("Регистратор",	Отчет.ИсходныйДокумент);
	ДанныеОбъекта.Вставить("ПравилоОбработки",	ПравилоОбработки);

	ДанныеОбъекта.Вставить("АнализЧувствительности",	Ложь);
	ДанныеОбъекта.Вставить("База",			Неопределено);
	
	Возврат ДанныеОбъекта;
		
КонецФункции // СформироватьДанныеОбъекта()

&НаСервере
Процедура ПриИзмененииПериода(ОбновитьШаблонКорректировки=Истина)
	
	Если НЕ ЗначениеЗаполнено(Отчет.ПериодОкончания) Тогда
		
		Отчет.ПериодОкончания=Отчет.ПериодОтчета;
		
	КонецЕсли;
	
	Отчет.ДатаНач=Отчет.ПериодОтчета.ДатаНачала;
	Отчет.ДатаКон=КонецДня(Отчет.ПериодОкончания.ДатаОкончания);
	
	Если ОбновитьШаблонКорректировки Тогда
		ПриИзмененииКлючевогоПараметра();
	КонецЕсли;
	
	ОтобразитьПанельСостояния(ПолучитьСводноеСостояние(Отчет.ПериодОтчета,Отчет.ПериодОкончания));
			
КонецПроцедуры // ПриИзмененииПериода()

&НаСервере
Процедура ПриИзмененииКлючевогоПараметра()
	
	ОпределитьШаблонКорректировки();
	СформироватьЗаголовокФормы();
	УстановитьВидимость();
	
КонецПроцедуры // ПриИзмененииКлючевогоПараметра()

&НаСервере
Процедура ОтобразитьПанельСостояния(ТекстСостояния)
	
	Если ПустаяСтрока(ТекстСостояния) Тогда
		
		Элементы.ГруппаТрансляцияПриИзменении.Видимость=Ложь;
		
	Иначе
		
		Элементы.ДекорацияНастройка.Заголовок=ТекстСостояния;
		Элементы.ГруппаТрансляцияПриИзменении.Видимость=Истина;
		
	КонецЕсли;		
	
КонецПроцедуры // ОтобразитьПанельСостояния() 

&НаКлиенте
Функция ПроверитьНаличиеШаблона()
	
	Если НЕ ЗначениеЗаполнено(Отчет.ШаблонКорректировки) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не указан шаблон корректировки'"));
		
		Элементы.Дополнительно.Пометка=Истина;
		ОтобразитьПанельНастроек();
		
		Элементы.ГруппаНастройка.ТекущаяСтраница=Элементы.ГруппаНастройка.ПодчиненныеЭлементы.КлючевыеРеквизиты;
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции // ПроверитьНаличиеШаблона() 

&НаСервере
Функция ПолучитьПериодыКорреспонденцииИсточник()
	
	Запрос=Новый Запрос;
	Запрос.Текст=Обработки.КорректировкиЗначенийПоказателей.ПолучитьИсточникТрансляции();
	Запрос.УстановитьПараметр("НазначениеРасчетов",ПравилоОбработки);
	
	мОперанды=Запрос.Выполнить().Выгрузить(); 
	
	Если мОперанды.Количество()=0 Тогда
		
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для шаблона трансляции %1 не обнаружено установленных соответствий счетов.'"),Отчет.ШаблонКорректировки));
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;
	
	// обрезаем коды
	мОперанды.Колонки.Код.Имя = "Имя";
	мОперанды.Колонки.Добавить("Код");
	
	Для Каждого Стр Из мОперанды Цикл
		Стр.Код = СокрЛП(Стр.Имя);
	КонецЦикла;
	
	мОперанды.Колонки.Удалить(мОперанды.Колонки.Имя);	
	мОперанды.Индексы.Добавить("Код");
	
	мОперанды.Колонки.Добавить("АналитикВидаОтчета",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0));
	мОперанды.Колонки.Добавить("Ресурс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	мОперанды.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
	
	СтрОперанд=мОперанды[0];
	СтрОперанд.ПравилаИспользованияПолейЗапроса.Очистить();
	
	ТекстРесурсыИсточник="";
	
	Для Каждого СтрРесурс ИЗ РесурсыДляОтображения Цикл
		
		Если НЕ СтрРесурс.Отображать Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрРесурс.РесурсИсточникБалансовый Тогда
			
			ТекстРесурсыИсточник=ТекстРесурсыИсточник+",
			|СУММА("+СтрРесурс.РесурсИсточник+") КАК "+СтрРесурс.РесурсИсточник;
			
			ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
			ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник;
			ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник;
			ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник;
		
		Иначе
			
			ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
			ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник+"Дт";
			ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник+"Дт";
			ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник+"Дт";
			
			ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
			ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник+"Кт";
			ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник+"Кт";
			ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник+"Кт";
			
			ТекстРесурсыИсточник=ТекстРесурсыИсточник+",
			|СУММА("+СтрРесурс.РесурсИсточник+"Дт) КАК "+СтрРесурс.РесурсИсточник+"Дт,
			|СУММА("+СтрРесурс.РесурсИсточник+"Кт) КАК "+СтрРесурс.РесурсИсточник+"Кт";
								
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапросаМодуля="ВЫБРАТЬ "+Сред(ТекстРесурсыИсточник,2)+",НАЧАЛОПЕРИОДА(РегистрБухгалтерии.Период,"+XMLСтрока(ПериодичностьТрансляции)+") КАК Период ИЗ РегистрБухгалтерии."+ РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто(&ДатаНач, &ДатаКон,Активность "+?(ПустаяСтрока(СтрОперанд.ТекстОтбора),""," И "+СтрОперанд.ТекстОтбора)+") КАК РегистрБухгалтерии
	|СГРУППИРОВАТЬ ПО НАЧАЛОПЕРИОДА(РегистрБухгалтерии.Период,"+XMLСтрока(ПериодичностьТрансляции)+")";
	
	ДанныеРасчета=УправлениеОтчетамиУХ.ПодготовитьОперандыДляПолученияДанных(мОперанды,Ложь,,,,Ложь);
	
	СтрЗапрос=ДанныеРасчета.мТабПоказателиЗапросы[0];
	СтрЗапрос.ТекстЗапроса=ТекстЗапросаМодуля;
	
	Если Обработки.КорректировкиЗначенийПоказателей.ТекущаяИБ(Отчет.ИспользуемаяИБ) Тогда
		
		ТаблицаПериоды=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрПроизвольный(СформироватьДанныеОбъекта(),СтрЗапрос);
		
	Иначе
		
		СтруктураЗапроса 		= РасширениеИнтеграцииУХ.ПодготовитьСтруктуруЗапроса(СформироватьДанныеОбъекта(),СтрЗапрос,Истина);	
		СтруктураДанных	 		= РасширениеИнтеграцииУХ.ПолучитьТаблицуДанныхПоЗапросу(СтруктураЗапроса);
		ТаблицаПериоды      	= РасширениеИнтеграцииУХ.ПолучитьРабочуюТаблицуПоДаннымПереноса(Отчет.ИспользуемаяИБ,СтруктураДанных);
		
	КонецЕсли;
	
	ТаблицаПериоды.Сортировать("Период Возр");
	
	Возврат ТаблицаПериоды;
	
КонецФункции // ПолучитьПериодыКорреспонденцииИсточник() 

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	ТабДок.Очистить();
	
	Если Отчет.ПоПериодамТрансляции Тогда
		
		Отчет.Периодичность=ПериодичностьТрансляции;
		
	КонецЕсли;
	
	ТаблицаДанныхИсточник=ПолучитьТаблицуИсточник(СформироватьДанныеОбъекта());
	
	Если ТаблицаДанныхИсточник.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос=Новый Запрос;
		
	Запрос.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
	
	Если ТаблицаДанныхИсточник.Колонки.Найти("Период")=Неопределено Тогда
		
		ТаблицаДанныхИсточник.Колонки.Добавить("Период",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя));
		
	КонецЕсли;
	
	Если ТаблицаДанныхИсточник.Колонки.Найти("Организация")=Неопределено Тогда
		
		ТаблицаДанныхИсточник.Колонки.Добавить("Организация",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Организации"));
		
	КонецЕсли;
	
	Запрос.Текст="ВЫБРАТЬ
	|	ТаблицаДанныхИсточник.Период КАК Период,
	|	ТаблицаДанныхИсточник.Организация КАК Организация,
	|	ТаблицаДанныхИсточник.Счет КАК СчетДтИсточникКод,
	|	ТаблицаДанныхИсточник.КоррСчет КАК СчетКтИсточникКод,
	|	ТаблицаДанныхИсточник.Сумма КАК Сумма,
	|	ТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения
	|ПОМЕСТИТЬ ТаблицаДанныхИсточник
	|ИЗ
	|	&ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	|;
	|ВЫБРАТЬ СчетаБД.Ссылка КАК СчетБД,
	|СчетаБД.СчетСсылка КАК СчетСсылка
	|ПОМЕСТИТЬ СчетаПриемник
	|ИЗ Справочник.СчетаБД КАК СчетаБД
	|ГДЕ СчетаБД.Владелец=&ПланСчетовПриемник
	|ИНДЕКСИРОВАТЬ ПО СчетаБД.СчетСсылка
	|;
	|ВЫБРАТЬ СчетаБД.Ссылка КАК СчетБД,
	|СчетаБД.Код КАК СчетКод
	|ПОМЕСТИТЬ СчетаИсточник
	|ИЗ Справочник.СчетаБД КАК СчетаБД
	|ГДЕ СчетаБД.Владелец=&ПланСчетовИсточник
	|ИНДЕКСИРОВАТЬ ПО СчетаБД.Код
	|;";
	
	Если ЗначениеЗаполнено(Отчет.Организация) Тогда
		
		Запрос.УстановитьПараметр("Организация",Отчет.Организация);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Сценарий",Отчет.Сценарий);
	Запрос.УстановитьПараметр("ПланСчетовПриемник",ПланСчетовПриемник);

	Если ЗначениеЗаполнено(Отчет.ПериодОтражения) И (НЕ Отчет.ПериодОтражения=Отчет.ПериодОтчета) Тогда
		
		Запрос.УстановитьПараметр("ДатаНач",Отчет.ПериодОтражения.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Отчет.ПериодОтражения.ДатаОкончания));
		
	Иначе
		
		Запрос.УстановитьПараметр("ДатаНач",Отчет.ДатаНач);
		Запрос.УстановитьПараметр("ДатаКон",Отчет.ДатаКон);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПланСчетовИсточник",ПланСчетовИсточник);
	Запрос.УстановитьПараметр("ИсходныйДокумент",Отчет.ИсходныйДокумент);
	Запрос.УстановитьПараметр("ДокументТрансляции",Отчет.ДокументТрансляции);
	Запрос.УстановитьПараметр("ТаблицаДанныхИсточник",ТаблицаДанныхИсточник);
	
	Запрос.Выполнить();
	
	Если ТипОтчета="Корреспонденция" Тогда
		
		ОтобразитьВыверкуПоКорреспонденции(Запрос);
		
	Иначе
		
		ОтобразитьВыверкуПоОборотамДтКт(Запрос);
		
	КонецЕсли;
	
КонецПроцедуры // СформироватьОтчетНаСервере()

&НаСервере
Функция ПолучитьТаблицуИсточник(ДанныеОбъекта) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("НазначениеРасчетов",ДанныеОбъекта.ПравилоОбработки);
			
	//////////////////////////////////////////////////////////////////////////////////////////////
	// Получаем все корреспонденции счетов за период
	
	Запрос.Текст=Обработки.КорректировкиЗначенийПоказателей.ПолучитьИсточникТрансляции();
	
	мОперанды=Запрос.Выполнить().Выгрузить(); 
	
	Если мОперанды.Количество()=0 Тогда
		
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для шаблона трансляции %1 не обнаружено установленных соответствий счетов.'"),Отчет.ШаблонКорректировки));
		Возврат Новый таблицаЗначений;
		
	КонецЕсли;			
	
	// обрезаем коды
	мОперанды.Колонки.Код.Имя = "Имя";
	мОперанды.Колонки.Добавить("Код");
	
	Для Каждого Стр Из мОперанды Цикл
		Стр.Код = СокрЛП(Стр.Имя);
	КонецЦикла;
	
	мОперанды.Колонки.Удалить(мОперанды.Колонки.Имя);	
	мОперанды.Индексы.Добавить("Код");
	
	мОперанды.Колонки.Добавить("АналитикВидаОтчета",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0));
	мОперанды.Колонки.Добавить("Ресурс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	мОперанды.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
	
	мОперанды[0].СпособПолучения=?(Обработки.КорректировкиЗначенийПоказателей.ТекущаяИБ(Отчет.ИспользуемаяИБ),Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии,Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос);	
				
	ТекстРесурсыИсточник="";
	
	Для Каждого СтрРесурс ИЗ РесурсыДляОтображения Цикл
		
		Если НЕ СтрРесурс.Отображать Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрРесурс.РесурсИсточникБалансовый Тогда
			
			ТекстРесурсыИсточник=ТекстРесурсыИсточник+",
			|СУММА("+СтрРесурс.РесурсИсточник+") КАК "+?(СтрРесурс.РесурсПриемник="СуммаВВалютеУчета","Сумма",СтрРесурс.РесурсИсточник);
					
		Иначе
						
			ТекстРесурсыИсточник=ТекстРесурсыИсточник+",
			|СУММА("+СтрРесурс.РесурсИсточник+"Дт) КАК "+СтрРесурс.РесурсИсточник+"Дт,
			|СУММА("+СтрРесурс.РесурсИсточник+"Кт) КАК "+СтрРесурс.РесурсИсточник+"Кт";
								
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьПериод=ЗначениеЗаполнено(Отчет.Периодичность);
	ЕстьОрганизации=НЕ ЗначениеЗаполнено(Отчет.Организация);
	
	ПолучитьДанныеУчетнойПолитики();
	ЕстьПересчетВалют=ЗначениеЗаполнено(ДанныеУчетнойПолитики.ВалютаИсточник) И ЗначениеЗаполнено(ДанныеУчетнойПолитики.ВалютаУчета) И (НЕ ДанныеУчетнойПолитики.ВалютаИсточник=ДанныеУчетнойПолитики.ВалютаУчета);
	
	ТекстГруппировки="";
	ТекстОтбора=мОперанды[0].ТекстОтбора;
		
	Если ЕстьПериод ИЛИ ЕстьПересчетВалют Тогда
		
		ТекстГруппировки=",Период";
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		ТекстГруппировки=",Организация";
		
		СтрОрганизация=мОперанды[0].ТаблицаПараметровОтбораБД.Найти("Организация","ПолеБД");
		
		Если НЕ СтрОрганизация=Неопределено Тогда
			
			мОперанды[0].ТаблицаПараметровОтбораБД.Удалить(СтрОрганизация);
			
		КонецЕсли;
		
		ПолеОрганизация=мОперанды[0].ПравилаИспользованияПолейЗапроса.Добавить();
		ПолеОрганизация.Поле			= "Организация";
		ПолеОрганизация.Синоним			= "Организация";
		ПолеОрганизация.КодАналитики	= "Организация";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		
		ТекстГруппировки=ТекстГруппировки+",Регистратор";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчет.Организация) Тогда
		 
		ПроверитьУстановитьОтборОрганизация(мОперанды[0],ТекстОтбора);
		
	Иначе
		
		ТекстОтбора="";
		
	КонецЕсли;
	
	СтрЗапрос=Обработки.КорректировкиЗначенийПоказателей.ПодготовитьДанныеДляЗапроса(мОперанды[0],мОперанды);
		
	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		
		СтрЗапрос.ТекстЗапроса="ВЫБРАТЬ "+Сред(ТекстРесурсыИсточник,2)+ТекстГруппировки+",СчетДт.Код КАК Счет,СчетКт.Код КАК КоррСчет ИЗ РегистрБухгалтерии."+ РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто(,,Активность И Регистратор=&Регистратор"+?(ПустаяСтрока(ТекстОтбора),""," И "+ТекстОтбора)+")
		|ГДЕ ИСТИНА СГРУППИРОВАТЬ ПО СчетДт.Код,СчетКт.Код"+ТекстГруппировки;
		
	Иначе
		
		СтрЗапрос.ТекстЗапроса="ВЫБРАТЬ "+Сред(ТекстРесурсыИсточник,2)+ТекстГруппировки+",СчетДт.Код КАК Счет,СчетКт.Код КАК КоррСчет ИЗ РегистрБухгалтерии."+ РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто(&ДатаНач, &ДатаКон,Активность "+?(ПустаяСтрока(ТекстОтбора),""," И "+ТекстОтбора)+")
		|ГДЕ ИСТИНА СГРУППИРОВАТЬ ПО СчетДт.Код,СчетКт.Код"+ТекстГруппировки;
		
	КонецЕсли;
	
	Если Обработки.КорректировкиЗначенийПоказателей.ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ) Тогда
		
		Обработки.КорректировкиЗначенийПоказателей.ДобавитьТаблицуОтборомПоРегистратору(Отчет,СтрЗапрос.ПравилаВычисленияПараметров);	
		ТаблицаДанныхИсточник=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрПроизвольный(ДанныеОбъекта,СтрЗапрос); 
		
		МассивИсключаемыхВНА.ЗагрузитьЗначения(ВстраиваниеУХ.ПолучитьВнаУчитываемыеПараллельно());
		
		Если МассивИсключаемыхВНА.Количество()>0 Тогда
			
			ДополнитьТаблицуДанныхПараллельныйУчет(ТаблицаДанныхИсточник,СтрЗапрос);
			
		Иначе
			
			ТаблицаДанныхИсточник.Колонки.Добавить("СуммаИсключения",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
			
		КонецЕсли;
		
	Иначе
		
		СтруктураЗапроса 			= РасширениеИнтеграцииУХ.ПодготовитьСтруктуруЗапроса(ДанныеОбъекта,СтрЗапрос,Истина);
		СтруктураДанных	 			= РасширениеИнтеграцииУХ.ПолучитьТаблицуДанныхПоЗапросу(СтруктураЗапроса);
		
		СтруктураДанных.Вставить("ПодготовитьДляПомещенияВЗапрос",Истина);
		ТаблицаДанныхИсточник      	= РасширениеИнтеграцииУХ.ПолучитьРабочуюТаблицуПоДаннымПереноса(Отчет.ИспользуемаяИБ,СтруктураДанных);	
		
		ТаблицаДанныхИсточник.Колонки.Добавить("СуммаИсключения",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
		
	КонецЕсли; 
	
	Если ЕстьПересчетВалют Тогда
		
		ПересчитатьПоКурсуПриемника(ТаблицаДанныхИсточник);
		
	КонецЕсли;
			
	Возврат ТаблицаДанныхИсточник 
		
КонецФункции // ПолучитьТаблицуКорреспонденций()

&НаСервере
Процедура ПроверитьУстановитьОтборОрганизация(ДанныеОперанда,ТекстОтбора)
	
	Если СтрНайти(ТекстОтбора,"Организация=")>0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОперандОбъект=ДанныеОперанда.Ссылка.ПолучитьОбъект();
	ОперандОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
	ОперандОбъект.УстановитьОтбор("Организация",Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,Отчет.Организация);
	ОперандОбъект.мМодифицированность=Истина;
	ОперандОбъект.СохранитьНастройкиОперанда();
	
	ДанныеОперанда.ТаблицаПараметровОтбораБД=ОперандОбъект.ТаблицаПараметровОтбораБД.Выгрузить(); 
	ДанныеОперанда.УточненияСпособовОпределения=ОперандОбъект.УточненияСпособовОпределения.Выгрузить();
	ТекстОтбора=ОперандОбъект.ТекстОтбора; 
	
КонецПроцедуры // ПроверитьУстановитьОтборОрганизация()

&НаСервере
Процедура ПересчитатьПоКурсуПриемника(ТаблицаДанныхИсточник) 
	
	КэшТаблицыКурсов=Новый ТаблицаЗначений;
	КэшТаблицыКурсов.Колонки.Добавить("Валюта",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Валюты"));
	КэшТаблицыКурсов.Колонки.Добавить("Период",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	КэшТаблицыКурсов.Колонки.Добавить("Курс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,4));
	КэшТаблицыКурсов.Колонки.Добавить("Кратность",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
	
	КэшТаблицыКурсов.Индексы.Добавить("Валюта,Период"); 
	
	ЗапросКурсов=Новый Запрос;
	ЗапросКурсов.Текст="ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс КАК Курс,
	|	КурсыВалютСрезПоследних.Кратность КАК Кратность
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Период, Валюта = &Валюта) КАК КурсыВалютСрезПоследних"; 
	
	Для Каждого СтрокаДанные ИЗ ТаблицаДанныхИсточник Цикл
		
		СтрокаДанные.Сумма=Обработки.КорректировкиЗначенийПоказателей.ПолучитьЗначениеПриемник(СтрокаДанные.Период,
														СтрокаДанные.Сумма,
														ДанныеУчетнойПолитики.ВалютаИсточник,
														ДанныеУчетнойПолитики.ВалютаУчета,
														КэшТаблицыКурсов,ЗапросКурсов);
														
		СтрокаДанные.СуммаИсключения=Обработки.КорректировкиЗначенийПоказателей.ПолучитьЗначениеПриемник(СтрокаДанные.Период,
														СтрокаДанные.СуммаИсключения,
														ДанныеУчетнойПолитики.ВалютаИсточник,
														ДанныеУчетнойПолитики.ВалютаУчета,
														КэшТаблицыКурсов,ЗапросКурсов);
														
	КонецЦикла;
													
	Если НЕ ЕстьПериод Тогда
		
		ТекстСумма="Сумма,СуммаИсключения";
		ТекстГруппировки="Счет,КоррСчет";
		
		Если ЕстьОрганизации Тогда
			
			ТекстГруппировки=ТекстГруппировки+",Организация";
			
		КонецЕсли;
		
		ТаблицаДанныхИсточник.Свернуть(ТекстГруппировки,ТекстСумма);
		
	КонецЕсли;
			
КонецПроцедуры // ПересчитатьПоКурсуПриемника() 

&НаСервере
Процедура ОтобразитьВыверкуПоКорреспонденции(Запрос) 
	
	Запрос.Текст="ВЫБРАТЬ";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|СравнениеОборотов.Период КАК Группировка,";
	
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|СравнениеОборотов.Организация КАК Группировка,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|	СравнениеОборотов.СчетДтИсточник КАК СчетДтИсточник,
	|	СравнениеОборотов.СчетКтИсточник КАК СчетКтИсточник,
	|	СравнениеОборотов.СчетДтПриемник КАК СчетДтПриемник,
	|	СравнениеОборотов.СчетКтПриемник КАК СчетКтПриемник,
	|	СравнениеОборотов.Сумма КАК Сумма,
	|	СравнениеОборотов.СуммаИсключения КАК СуммаИсключения,
	|	СравнениеОборотов.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
	|	СравнениеОборотов.Расхождение_Сумма_СуммаВВалютеУчета КАК Расхождение_Сумма_СуммаВВалютеУчета,
	|	СравнениеОборотов.СчетДтИсточник.Код,
	|	СравнениеОборотов.СчетКтИсточник.Код,
	|	СравнениеОборотов.СчетДтПриемник.Код,
	|	СравнениеОборотов.СчетКтПриемник.Код
	|ИЗ
	|	(ВЫБРАТЬ";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ОбъединениеДанных.Период КАК Период,";
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ОбъединениеДанных.Организация КАК Организация,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|		ОбъединениеДанных.СчетДтИсточник КАК СчетДтИсточник,
	|		ОбъединениеДанных.СчетКтИсточник КАК СчетКтИсточник,
	|		ОбъединениеДанных.СчетДтПриемник КАК СчетДтПриемник,
	|		ОбъединениеДанных.СчетКтПриемник КАК СчетКтПриемник,
	|		СУММА(ОбъединениеДанных.Сумма) КАК Сумма,
	|		СУММА(ОбъединениеДанных.СуммаИсключения) КАК СуммаИсключения,
	|		СУММА(ОбъединениеДанных.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
	|		СУММА(ОбъединениеДанных.Сумма - ОбъединениеДанных.СуммаВВалютеУчета) КАК Расхождение_Сумма_СуммаВВалютеУчета
	|	ИЗ
	|		(ВЫБРАТЬ";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+" НАЧАЛОПЕРИОДА(ТаблицаДанныхИсточник.Период,"+XMLСтрока(Отчет.Периодичность)+") КАК Период,";
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+" ТаблицаДанныхИсточник.Организация КАК Организация,";
		
	КонецЕсли;

	Запрос.Текст=Запрос.Текст+"
	|			СчетаБДИсточникДт.Ссылка КАК СчетДтИсточник,
	|			СчетаБДИсточникКт.Ссылка КАК СчетКтИсточник,
	|			ТаблицаДанныхИсточник.Сумма КАК Сумма,
	|			ТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения,
	|			0 КАК СуммаВВалютеУчета,
	|			NULL КАК СчетДтПриемник,
	|			NULL КАК СчетКтПриемник
	|		ИЗ
	|			ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДИсточникДт
	|				ПО ТаблицаДанныхИсточник.СчетДтИсточникКод = СчетаБДИсточникДт.Код
	|				И СчетаБДИсточникДт.Владелец=&ПланСчетовИсточник
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДИсточникКт
	|				ПО ТаблицаДанныхИсточник.СчетКтИсточникКод = СчетаБДИсточникКт.Код
	|				И СчетаБДИсточникКт.Владелец=&ПланСчетовИсточник
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+" НАЧАЛОПЕРИОДА(РегистрБухгалтерииПриемник.Период,"+XMLСтрока(Отчет.Периодичность)+") КАК Период,";
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+" РегистрБухгалтерииПриемник.Организация КАК Организация,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|			РегистрБухгалтерииПриемник.СчетДтИсточник,
	|			РегистрБухгалтерииПриемник.СчетКтИсточник,
	|			0,
	|			0,
	|			СУММА(РегистрБухгалтерииПриемник.СуммаВВалютеУчета),
	|			СчетаДт.СчетБД,
	|			СчетаКт.СчетБД
	|		ИЗ
	|&ТекстПриемник КАК РегистрБухгалтерииПриемник
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаДт ПО РегистрБухгалтерииПриемник.СчетДт=СчетаДт.СчетСсылка
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаКт ПО РегистрБухгалтерииПриемник.СчетКт=СчетаКт.СчетСсылка		
	|		СГРУППИРОВАТЬ ПО"; 
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ТекстПриемник",ПолучитьТекстПриемник(Запрос));
						
	Если ЕстьОрганизации Тогда
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОрганизация","ИСТИНА"); 
		Запрос.Текст=Запрос.Текст+" РегистрБухгалтерииПриемник.Организация,";
	
	Иначе
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОрганизация","Организация = &Организация");
		
	КонецЕсли;
						
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+" НАЧАЛОПЕРИОДА(РегистрБухгалтерииПриемник.Период,"+XMLСтрока(Отчет.Периодичность)+"),";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|			СчетаДт.СчетБД,
	|			РегистрБухгалтерииПриемник.СчетДтИсточник,
	|			СчетаКт.СчетБД,
	|			РегистрБухгалтерииПриемник.СчетКтИсточник) КАК ОбъединениеДанных
	|	
	|	СГРУППИРОВАТЬ ПО";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ОбъединениеДанных.Период,"; 
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ОбъединениеДанных.Организация,";
		
	КонецЕсли;
			
	Запрос.Текст=Запрос.Текст+"
	|		ОбъединениеДанных.СчетДтИсточник,
	|		ОбъединениеДанных.СчетКтИсточник,
	|		ОбъединениеДанных.СчетДтПриемник,
	|		ОбъединениеДанных.СчетКтПриемник) КАК СравнениеОборотов";
	
	ДополнитьТекстИПараметрыОтборов(Запрос);		
			
	Запрос.Текст=Запрос.Текст+"
	|
	|УПОРЯДОЧИТЬ ПО";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|Период,";
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|Организация,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|	СчетДтИсточник,
	|	СчетКтИсточник
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаИсключения),
	|	СУММА(СуммаВВалютеУчета),
	|	СУММА(Расхождение_Сумма_СуммаВВалютеУчета)
	|ПО";
	
	Если ЕстьПериод ИЛИ ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|Группировка,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|	СчетДтИсточник,
	|	СчетКтИсточник,
	|	СчетДтПриемник,
	|	СчетКтПриемник";
	
	
	Макет=Отчеты.ВыверкаТрансляцииПроводок.ПолучитьМакет("МакетКорреспонденция");
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка|ОбластьОтступ"));
	
	ОбластьШапка=Макет.ПолучитьОбласть("Шапка|ОбластьДанных");
	ОбластьШапка.Параметры.ПланСчетовИсточник=ПланСчетовИсточник;
	ОбластьШапка.Параметры.ПланСчетовПриемник=ПланСчетовПриемник;
	
	ОбластьШапка.Параметры.ТекстЗначениеИсточник=НСтр("ru = 'Значение'")+Символы.ПС+"("+НРег(ОбластьШапка.Параметры.ПланСчетовИсточник)+")";
	ОбластьШапка.Параметры.ТекстЗначениеПриемник=НСтр("ru = 'Значение'")+Символы.ПС+"("+НРег(ОбластьШапка.Параметры.ПланСчетовПриемник)+")";

	
	ТабДок.Присоединить(ОбластьШапка);
	
	Если МассивИсключаемыхВНА.Количество()>0 Тогда
		
		ТабДок.Присоединить(Макет.ПолучитьОбласть("Шапка|ПараллельныйУчет"));
		
	КонецЕсли;
	
	ТабДок.ФиксацияСверху=ТабДок.ВысотаТаблицы;
			
	Если ЕстьПериод ИЛИ ЕстьОрганизации Тогда
		
		ВывестиОтчетСДополнительнойГруппировкой_Корр(Запрос);
		
	Иначе
		
		ВывестиОтчет_Корр(Запрос);
		
	КонецЕсли;
					
КонецПроцедуры

Функция ПолучитьТекстПриемник(Запрос)

	Если ЗначениеЗаполнено(Отчет.ИсходныйДокумент) Тогда
		
		ТекстПриемник="РегистрБухгалтерии.МСФО.ДвиженияССубконто(
		|					,
		|					,
		|					
		|						Сценарий = &Сценарий
		|						И Активность И Регистратор.ИсходныйДокумент=&ИсходныйДокумент
		|						И (НЕ (СчетДтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка) ИЛИ СчетКтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка)))";
		
		Запрос.УстановитьПараметр("ИсходныйДокумент",Отчет.ИсходныйДокумент);
		
		Если ЗначениеЗаполнено(Отчет.ДокументТрансляции) Тогда
			
			ТекстПриемник=ТекстПриемник+"
			|И Регистратор=&ДокументТрансляции";
			Запрос.УстановитьПараметр("ДокументТрансляции",Отчет.ДокументТрансляции);
			
		Иначе
			
			ТекстПриемник=ТекстПриемник+"
			|И (Регистратор Ссылка Документ.Трансляция И Регистратор.ШаблонКорректировки=&ШаблонКорректировки)";
			Запрос.УстановитьПараметр("ШаблонКорректировки",Отчет.ШаблонКорректировки);
			
		КонецЕсли;							
		
		ТекстПриемник=ТекстПриемник+"	
		|					,
		|					)";
		
	Иначе
		
		ТекстПриемник="РегистрБухгалтерии.МСФО.ДвиженияССубконто(
		|					&ДатаНач,
		|					&ДатаКон,
		|					&ПараметрОрганизация
		|						И Сценарий = &Сценарий
		|						И Активность
		|						И (НЕ (СчетДтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка) ИЛИ СчетКтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка)))";
		
		Если ЗначениеЗаполнено(Отчет.ДокументТрансляции) Тогда
			
			ТекстПриемник=ТекстПриемник+"
			|И Регистратор=&ДокументТрансляции";
			Запрос.УстановитьПараметр("ДокументТрансляции",Отчет.ДокументТрансляции);
			
		Иначе
			
			ТекстПриемник=ТекстПриемник+"
			|И (Регистратор Ссылка Документ.Трансляция И Регистратор.ШаблонКорректировки=&ШаблонКорректировки)";
			Запрос.УстановитьПараметр("ШаблонКорректировки",Отчет.ШаблонКорректировки);
			
		КонецЕсли;							
		
		ТекстПриемник=ТекстПриемник+"	
		|					,
		|					)";
		
	КонецЕсли;					
	
	Возврат ТекстПриемник;
	
КонецФункции // ПолучитьТекстПриемник() 

&НаСервере
Процедура ОтобразитьВыверкуПоОборотамДтКт(Запрос) 
	
	Запрос.Текст="ВЫБРАТЬ	
	|ОборотыИсточникДтКт.СчетИсточник КАК СчетИсточник,";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+" НАЧАЛОПЕРИОДА(ОборотыИсточникДтКт.Период,"+XMLСтрока(Отчет.Периодичность)+") КАК Период,";
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+" НЕОПРЕДЕЛЕНО КАК Период,";
		
	КонецЕсли;
		
	Если ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+" ОборотыИсточникДтКт.Организация КАК Организация,";
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+" ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|СУММА(ОборотыИсточникДтКт.СуммаДт) КАК СуммаДт,
	|СУММА(ОборотыИсточникДтКт.СуммаКт) КАК СуммаКт,
	|СУММА(ОборотыИсточникДтКт.СуммаИсключенияДт) КАК СуммаИсключенияДт,
	|СУММА(ОборотыИсточникДтКт.СуммаИсключенияКт) КАК СуммаИсключенияКт
	|ПОМЕСТИТЬ ТаблицаДанныхИсточникДтКт
	|ИЗ (ВЫБРАТЬ
	|			СчетаБДИсточникДт.СчетБД КАК СчетИсточник,
	|			ТаблицаДанныхИсточникДт.Период КАК Период,
	|			ТаблицаДанныхИсточникДт.Организация КАК Организация,
	|			ТаблицаДанныхИсточникДт.Сумма КАК СуммаДт,
	|			ТаблицаДанныхИсточникДт.СуммаИсключения КАК СуммаИсключенияДт,
	|			0 КАК СуммаКт,
	|			0 КАК СуммаИсключенияКт
	|		ИЗ
	|			ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточникДт
	|			Внутреннее соединение СчетаИсточник КАК СчетаБДИсточникДт
	|			ПО ТаблицаДанныхИсточникДт.СчетДтИсточникКод=СчетаБДИсточникДт.СчетКод
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|			СчетаБДИсточникКт.СчетБД КАК СчетИсточник,
	|			ТаблицаДанныхИсточникКт.Период КАК Период,
	|			ТаблицаДанныхИсточникКт.Организация КАК Организация,
	|			0,
	|			0,
	|			ТаблицаДанныхИсточникКт.Сумма КАК СуммаКт,
	|			ТаблицаДанныхИсточникКт.СуммаИсключения КАК СуммаИсключенияКт
	|		ИЗ
	|			ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточникКт
	|			Внутреннее соединение СчетаИсточник КАК СчетаБДИсточникКт
	|			ПО ТаблицаДанныхИсточникКт.СчетКтИсточникКод=СчетаБДИсточникКт.СчетКод)
	|КАК ОборотыИсточникДтКт
	|СГРУППИРОВАТЬ ПО
	|ОборотыИсточникДтКт.СчетИсточник";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+", НАЧАЛОПЕРИОДА(ОборотыИсточникДтКт.Период,"+XMLСтрока(Отчет.Периодичность)+")";
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+", ОборотыИсточникДтКт.Организация";	
		
	КонецЕсли;
		
	Запрос.Текст=Запрос.Текст+"
	|;
	|ВЫБРАТЬ";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+" НАЧАЛОПЕРИОДА(РегистрБухгалтерииПриемник.Период,"+XMLСтрока(Отчет.Периодичность)+") КАК Период,";
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+" НЕОПРЕДЕЛЕНО КАК Период,";
		
	КонецЕсли;
	
		
	Если ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+" РегистрБухгалтерииПриемник.Организация КАК Организация,";	
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+" ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|			РегистрБухгалтерииПриемник.СчетДтИсточник,
	|			РегистрБухгалтерииПриемник.СчетКтИсточник,
	|			СУММА(РегистрБухгалтерииПриемник.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
	|			СчетаДт.СчетБД КАК СчетДтПриемник,
	|			СчетаКт.СчетБД КАК СчетКтПриемник
	|ПОМЕСТИТЬ ТаблицаДанныхПриемникОбороты
	|		ИЗ &ТекстПриемник КАК РегистрБухгалтерииПриемник
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаДт ПО РегистрБухгалтерииПриемник.СчетДт=СчетаДт.СчетСсылка
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаКт ПО РегистрБухгалтерииПриемник.СчетКт=СчетаКт.СчетСсылка		
	|		СГРУППИРОВАТЬ ПО";
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ТекстПриемник",ПолучитьТекстПриемник(Запрос));
						
	Если ЕстьОрганизации Тогда
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОрганизация","ИСТИНА"); 
		Запрос.Текст=Запрос.Текст+" РегистрБухгалтерииПриемник.Организация,";
	
	Иначе
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПараметрОрганизация","Организация = &Организация");
		
	КонецЕсли;
						
	Если ЕстьПериод Тогда
		
		Запрос.Текст=Запрос.Текст+" НАЧАЛОПЕРИОДА(РегистрБухгалтерииПриемник.Период,"+XMLСтрока(Отчет.Периодичность)+"),";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|			СчетаДт.СчетБД,
	|			РегистрБухгалтерииПриемник.СчетДтИсточник,
	|			СчетаКт.СчетБД,
	|			РегистрБухгалтерииПриемник.СчетКтИсточник
	|;
	|ВЫБРАТЬ	
	|ОборотыПриемникДтКт.СчетИсточник КАК СчетИсточник,
	|ОборотыПриемникДтКт.СчетПриемник КАК СчетПриемник,
	|ОборотыПриемникДтКт.Период КАК Период,
	|ОборотыПриемникДтКт.Организация КАК Организация,
	|СУММА(ОборотыПриемникДтКт.СуммаВВалютеУчетаДт) КАК СуммаВВалютеУчетаДт,
	|СУММА(ОборотыПриемникДтКт.СуммаВВалютеУчетаКт) КАК СуммаВВалютеУчетаКт
	|ПОМЕСТИТЬ ТаблицаДанныхПриемникДтКт
	|ИЗ (ВЫБРАТЬ
	|			ТаблицаДанныхПриемникОборотыДт.СчетДтИсточник КАК СчетИсточник,
	|			ТаблицаДанныхПриемникОборотыДт.СчетДтПриемник КАК СчетПриемник,
	|			ТаблицаДанныхПриемникОборотыДт.Период КАК Период,
	|			ТаблицаДанныхПриемникОборотыДт.Организация КАК Организация,
	|			ТаблицаДанныхПриемникОборотыДт.СуммаВВалютеУчета КАК СуммаВВалютеУчетаДт,
	|			0 КАК СуммаВВалютеУчетаКт
	|		ИЗ
	|			ТаблицаДанныхПриемникОбороты КАК ТаблицаДанныхПриемникОборотыДт
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|			ТаблицаДанныхПриемникОборотыКт.СчетКтИсточник КАК СчетИсточник,
	|			ТаблицаДанныхПриемникОборотыКт.СчетКтПриемник КАК СчетПриемник,
	|			ТаблицаДанныхПриемникОборотыКт.Период КАК Период,
	|			ТаблицаДанныхПриемникОборотыКт.Организация КАК Организация,
	|			0 КАК СуммаВВалютеУчетаДт,
	|			ТаблицаДанныхПриемникОборотыКт.СуммаВВалютеУчета КАК СуммаВВалютеУчетаКт
	|		ИЗ
	|			ТаблицаДанныхПриемникОбороты КАК ТаблицаДанныхПриемникОборотыКт)
	|КАК ОборотыПриемникДтКт
	|СГРУППИРОВАТЬ ПО
	|ОборотыПриемникДтКт.СчетИсточник,
	|ОборотыПриемникДтКт.СчетПриемник,
	|ОборотыПриемникДтКт.Период,
	|ОборотыПриемникДтКт.Организация
	|;
	|ВЫБРАТЬ
	|	СравнениеОборотов.СчетИсточник КАК СчетИсточник,
	|	СравнениеОборотов.СчетПриемник КАК СчетПриемник,
	|	&Группировка КАК Группировка, 
	|	СравнениеОборотов.СуммаДт КАК СуммаДт,
	|	СравнениеОборотов.СуммаКт КАК СуммаКт,
	|	СравнениеОборотов.СуммаИсключенияДт КАК СуммаИсключенияДт,
	|	СравнениеОборотов.СуммаИсключенияКт КАК СуммаИсключенияКт,
	|	СравнениеОборотов.СуммаВВалютеУчетаДт КАК СуммаВВалютеУчетаДт,
	|	СравнениеОборотов.СуммаВВалютеУчетаКт КАК СуммаВВалютеУчетаКт,
	|	СравнениеОборотов.Расхождение_Сумма_СуммаВВалютеУчетаДт КАК Расхождение_Сумма_СуммаВВалютеУчетаДт,
	|	СравнениеОборотов.Расхождение_Сумма_СуммаВВалютеУчетаКт КАК Расхождение_Сумма_СуммаВВалютеУчетаКт,
	|	СравнениеОборотов.СчетИсточник.Код КАК СчетИсточникКод,
	|	СравнениеОборотов.СчетПриемник.Код КАК СчетПриемникКод
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОбъединениеДанных.Период КАК Период,
	|		ОбъединениеДанных.Организация КАК Организация,
	|		ОбъединениеДанных.СчетИсточник КАК СчетИсточник,
	|		ОбъединениеДанных.СчетПриемник КАК СчетПриемник,
	|		СУММА(ОбъединениеДанных.СуммаДт) КАК СуммаДт,
	|		СУММА(ОбъединениеДанных.СуммаКт) КАК СуммаКт,
	|		СУММА(ОбъединениеДанных.СуммаИсключенияДт) КАК СуммаИсключенияДт,
	|		СУММА(ОбъединениеДанных.СуммаИсключенияКт) КАК СуммаИсключенияКт,
	|		СУММА(ОбъединениеДанных.СуммаВВалютеУчетаДт) КАК СуммаВВалютеУчетаДт,
	|		СУММА(ОбъединениеДанных.СуммаВВалютеУчетаКт) КАК СуммаВВалютеУчетаКт,
	|		СУММА(ОбъединениеДанных.СуммаДт - ОбъединениеДанных.СуммаВВалютеУчетаДт) КАК Расхождение_Сумма_СуммаВВалютеУчетаДт,
	|		СУММА(ОбъединениеДанных.СуммаКт - ОбъединениеДанных.СуммаВВалютеУчетаКт) КАК Расхождение_Сумма_СуммаВВалютеУчетаКт
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ТаблицаДанныхИсточникДтКт.Период КАК Период,
	|			ТаблицаДанныхИсточникДтКт.Организация КАК Организация,
	|			ТаблицаДанныхИсточникДтКт.СчетИсточник КАК СчетИсточник,
	|			ТаблицаДанныхИсточникДтКт.СуммаДт КАК СуммаДт,
	|			ТаблицаДанныхИсточникДтКт.СуммаКт КАК СуммаКт,
	|			ТаблицаДанныхИсточникДтКт.СуммаИсключенияДт КАК СуммаИсключенияДт,
	|			ТаблицаДанныхИсточникДтКт.СуммаИсключенияКт КАК СуммаИсключенияКт,
	|			0 КАК СуммаВВалютеУчетаДт,
	|			0 КАК СуммаВВалютеУчетаКт,
	|			NULL КАК СчетПриемник
	|		ИЗ
	|			ТаблицаДанныхИсточникДтКт КАК ТаблицаДанныхИсточникДтКт
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ТаблицаДанныхПриемникДтКт.Период КАК Период,
	|			ТаблицаДанныхПриемникДтКт.Организация КАК Организация,
	|			ТаблицаДанныхПриемникДтКт.СчетИсточник КАК СчетИсточник,
	|			0,
	|			0,
	|			0,
	|			0,
	|			ТаблицаДанныхПриемникДтКт.СуммаВВалютеУчетаДт,
	|			ТаблицаДанныхПриемникДтКт.СуммаВВалютеУчетаКт,
	|			ТаблицаДанныхПриемникДтКт.СчетПриемник
	|		ИЗ
	|			ТаблицаДанныхПриемникДтКт КАК ТаблицаДанныхПриемникДтКт) КАК ОбъединениеДанных
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ОбъединениеДанных.Период,
	|		ОбъединениеДанных.Организация,
	|		ОбъединениеДанных.СчетИсточник,
	|		ОбъединениеДанных.СчетПриемник) КАК СравнениеОборотов";	
			
	Запрос.Текст=Запрос.Текст+"
	|
	|УПОРЯДОЧИТЬ ПО";
	
	Если ЕстьПериод Тогда
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"&Группировка","СравнениеОборотов.Период");
		
		Запрос.Текст=Запрос.Текст+"
		|Группировка,";
		
	ИначеЕсли ЕстьОрганизации Тогда
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"&Группировка","СравнениеОборотов.Организация");
		
		Запрос.Текст=Запрос.Текст+"
		|Группировка,";	
		
	Иначе
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"&Группировка","ИСТИНА");
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|	СчетИсточник
	|ИТОГИ
	|	СУММА(СуммаДт),
	|	СУММА(СуммаКт),
	|	СУММА(СуммаИсключенияДт),
	|	СУММА(СуммаИсключенияКт),
	|	СУММА(СуммаВВалютеУчетаДт),
	|	СУММА(СуммаВВалютеУчетаКт),
	|	СУММА(Расхождение_Сумма_СуммаВВалютеУчетаДт),
	|	СУММА(Расхождение_Сумма_СуммаВВалютеУчетаКт)
	|ПО";
	
	Если ЕстьПериод ИЛИ ЕстьОрганизации Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|Группировка,";
		
	КонецЕсли;
	
	Запрос.Текст=Запрос.Текст+"
	|	СчетИсточник,
	|	СчетПриемник";
		
	Макет=Отчеты.ВыверкаТрансляцииПроводок.ПолучитьМакет("МакетОборотыДтКт_ВНА");
		
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка|ОбластьОтступ"));
		
	ОбластьШапка=Макет.ПолучитьОбласть("Шапка|ОбластьДанных");
	ОбластьШапка.Параметры.ПланСчетовИсточник=ПланСчетовИсточник;
	ОбластьШапка.Параметры.ПланСчетовПриемник=ПланСчетовПриемник;
	
	ОбластьШапка.Параметры.ТекстЗначениеИсточник=НСтр("ru = 'Значение'")+Символы.ПС+"("+НРег(ОбластьШапка.Параметры.ПланСчетовИсточник)+")";
	ОбластьШапка.Параметры.ТекстЗначениеПриемник=НСтр("ru = 'Значение'")+Символы.ПС+"("+НРег(ОбластьШапка.Параметры.ПланСчетовПриемник)+")";
	
	ТабДок.Присоединить(ОбластьШапка);
		
	ТабДок.ФиксацияСверху=ТабДок.ВысотаТаблицы;
			
	Если ЕстьПериод ИЛИ ЕстьОрганизации Тогда
		
		ВывестиОтчетСДополнительнойГруппировкой_Об(Запрос);
		
	Иначе
		
		ВывестиОтчет_Об(Запрос);
		
	КонецЕсли;
					
КонецПроцедуры

&НаСервере
Процедура ДополнитьТекстИПараметрыОтборов(Запрос,ДтКт="")
	
	ТекстОтбор="";
	
	Если ПустаяСтрока(ДтКт) Тогда
		
		Если ЗначениеЗаполнено(Отчет.СчетДтИсточник) Тогда
			
			ТекстОтбор=ТекстОтбор+" И СравнениеОборотов.СчетДтИсточник в Иерархии(&СчетДтИсточник)";
			Запрос.УстановитьПараметр("СчетДтИсточник",Отчет.СчетДтИсточник);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отчет.СчетКтИсточник) Тогда
			
			ТекстОтбор=ТекстОтбор+" И СравнениеОборотов.СчетКтИсточник в Иерархии(&СчетКтИсточник)";
			Запрос.УстановитьПараметр("СчетКтИсточник",Отчет.СчетКтИсточник);
			
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(Отчет.СчетДтИсточник) Тогда
			
			ТекстОтбор=ТекстОтбор+" И СравнениеОборотов.СчетИсточник в Иерархии(&СчетИсточник)";
			Запрос.УстановитьПараметр("СчетИсточник",Отчет.СчетДтИсточник);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отчет.СчетКтИсточник) Тогда
			
			ТекстОтбор=ТекстОтбор+" И СравнениеОборотов.СчетИсточник в Иерархии(&СчетИсточник)";
			Запрос.УстановитьПараметр("СчетИсточник",Отчет.СчетКтИсточник);
			
		КонецЕсли;
		
	КонецЕсли;
			
	Если Не ПустаяСтрока(ТекстОтбор) Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ГДЕ "+Сред(ТекстОтбор,СтрДлина("И")+2);
		
	КонецЕсли;
		
КонецПроцедуры // ДополнитьТекстИПараметрыОтборов() 

Функция ПолучитьТаблицуСоответствияСчетов()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиПравилТрансляции.СоответствиеСчетов.СчетИсточник.Код КАК СчетИсточникКод,
	|	НастройкиПравилТрансляции.СоответствиеСчетов.СчетПриемник.Код КАК СчетПриемникКод,
	|	НастройкиПравилТрансляции.СоответствиеСчетов.СчетИсточник КАК СчетИсточник,
	|	НастройкиПравилТрансляции.СоответствиеСчетов.СчетПриемник КАК СчетПриемник,
	|	НастройкиПравилТрансляции.СоответствиеСчетов КАК НастройкаСоответствия
	|ПОМЕСТИТЬ СоответствияСчетов
	|ИЗ
	|	РегистрСведений.НастройкиПравилТрансляции КАК НастройкиПравилТрансляции
	|ГДЕ
	|	НастройкиПравилТрансляции.ШаблонТрансляции = &ШаблонТрансляции
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НастройкаСоответствия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсточникиДанныхДляРасчетов.Ссылка КАК ИсточникСсылка,
	|	ИсточникиДанныхДляРасчетов.ПотребительРасчета КАК ПотребительРасчета
	|ПОМЕСТИТЬ ИсточникиДанных
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
	|ГДЕ
	|	ИсточникиДанныхДляРасчетов.НазначениеРасчетов = &ПравилоОбработки
	|	И НЕ ИсточникиДанныхДляРасчетов.ПометкаУдаления
	|	И ИсточникиДанныхДляРасчетов.ТрансляцияДебет
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПотребительРасчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоответствияСчетов.СчетИсточникКод КАК СчетИсточникКод,
	|	СоответствияСчетов.СчетПриемникКод КАК СчетПриемникКод,
	|	СоответствияСчетов.СчетИсточник КАК СчетИсточник,
	|	СоответствияСчетов.СчетПриемник КАК СчетПриемник,
	|	СоответствияСчетов.НастройкаСоответствия КАК НастройкаСоответствия,
	|	ЕСТЬNULL(ИсточникиДанных.ИсточникСсылка, НЕОПРЕДЕЛЕНО) КАК ИсточникСсылка
	|ИЗ
	|	СоответствияСчетов КАК СоответствияСчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИсточникиДанных КАК ИсточникиДанных
	|		ПО СоответствияСчетов.НастройкаСоответствия = ИсточникиДанных.ПотребительРасчета";
	
	Запрос.УстановитьПараметр("ШаблонТрансляции",Отчет.ШаблонКорректировки);
	Запрос.УстановитьПараметр("ПравилоОбработки",ПравилоОбработки);

	ТаблицаНастроек=Запрос.Выполнить().Выгрузить();
	ТаблицаНастроек.Колонки.Добавить("ОтборПодробно",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(0));
	ТаблицаНастроек.Колонки.Добавить("СоответствиеПодробно",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(0));
	
	Если Отчет.ПодробнаяИнформация Тогда
		
		Для Каждого Строка ИЗ ТаблицаНастроек Цикл
			
			Если ЗначениеЗаполнено(Строка.ИсточникСсылка) Тогда
				
				ЗаполнитьЗначенияСвойств(Строка,Обработки.КорректировкиЗначенийПоказателей.ПолучитьПодробнуюИнформацию(Строка.ИсточникСсылка,РегистрБухгалтерииИсточник));
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
			
	Возврат ТаблицаНастроек; 	
	
КонецФункции // ПолучитьТаблицуСоответствияСчетов() 

Процедура ДополнитьТаблицуДанныхПараллельныйУчет(ТаблицаДанныхИсточник,СтрЗапрос)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ТаблицаДанныхИсточник.*
	|ПОМЕСТИТЬ ТаблицаДанныхИсточник
	|ИЗ
	|	&ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаБД.Ссылка КАК Ссылка,
	|	СчетаБД.Код КАК Код
	|ПОМЕСТИТЬ СчетаБД
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|ГДЕ
	|	СчетаБД.Владелец = &ПланСчетовИсточник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанныхИсточник.*,
	|	СчетаДт.Ссылка КАК СчетДтИсточник,
	|	СчетаКт.Ссылка КАК СчетКтИсточник
	|ИЗ
	|	ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаБД КАК СчетаДт
	|		ПО ТаблицаДанныхИсточник.Счет = СчетаДт.Код
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаБД КАК СчетаКт
	|		ПО ТаблицаДанныхИсточник.КоррСчет = СчетаКт.Код";
	
	Запрос.УстановитьПараметр("ТаблицаДанныхИсточник",	ТаблицаДанныхИсточник);
	Запрос.УстановитьПараметр("ПланСчетовИсточник",		ПланСчетовИсточник);
	МассивТиповВНА=Справочники.ГруппыВНАМСФО.ПолучитьТипыОбъектовВНА();
	
	ТаблицаДанныхИсточник=Запрос.Выполнить().Выгрузить();
	
	ТаблицаДанныхИсточник.Колонки.Добавить("СуммаИсключения",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	ТаблицаДанныхИсточник.Колонки.Добавить("ТекстОтбораДт",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(200));
	ТаблицаДанныхИсточник.Колонки.Добавить("ТекстОтбораКт",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(200));
	
	ПравилаВычисленияПараметровСтар=СтрЗапрос.ПравилаВычисленияПараметров;
	
	ШаблонТекста="ВЫБРАТЬ
	|	СУММА(ХозрасчетныйДвиженияССубконто.Сумма) КАК Сумма	                        
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&ДатаНач, &ДатаКон, Активность И Организация=&Организация И СчетДт.Код=&Счет И СчетКт.Код=&КоррСчет, , ) КАК ХозрасчетныйДвиженияССубконто
	|ГДЕ
	|	ИСТИНА";
		
	Для Каждого Строка ИЗ ТаблицаДанныхИсточник Цикл
		
		ЕстьСубконто=Ложь;		
		МассивВидовСубконтоВНА=Новый Массив;
		
		Обработки.КорректировкиЗначенийПоказателей.ДополнитьТекстОтбораИсключаемыхВНА(Строка,ЕстьСубконто,МассивТиповВНА,МассивВидовСубконтоВНА);
		
		Если ЕстьСубконто Тогда
			
			ТекстОтбор="";
			
			Если НЕ ПустаяСтрока(Строка.ТекстОтбораДт) Тогда
				
				ТекстОтбор=ТекстОтбор+" ИЛИ "+СтрЗаменить(Строка.ТекстОтбораДт," НЕ ","");
				
			КонецЕсли;
			
			Если НЕ ПустаяСтрока(Строка.ТекстОтбораКт) Тогда
				
				ТекстОтбор=ТекстОтбор+" ИЛИ "+СтрЗаменить(Строка.ТекстОтбораКт," НЕ ","");
				
			КонецЕсли;
			
			СтрЗапрос.ТекстЗапроса=СтрЗаменить(ШаблонТекста,"ИСТИНА",Сред(ТекстОтбор,СтрДлина("ИЛИ")+2));
			
			ПравилаВычисленияПараметровТек=ПравилаВычисленияПараметровСтар.Скопировать();
			
			НоваяСтрока=ПравилаВычисленияПараметровТек.Добавить();
			НоваяСтрока.ИмяПараметра=		"Счет";
			НоваяСтрока.НаименованиеБД=		"Счет";
			НоваяСтрока.ПолеБД=				"Счет";
			НоваяСтрока.ТипРасчета=			"Простой";
			НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НоваяСтрока.УточнениеСпособаОпределения=Строка.Счет;
			
			НоваяСтрока=ПравилаВычисленияПараметровТек.Добавить();
			НоваяСтрока.ИмяПараметра=		"КоррСчет";
			НоваяСтрока.НаименованиеБД=		"КоррСчет";
			НоваяСтрока.ПолеБД=				"КоррСчет";
			НоваяСтрока.ТипРасчета=			"Простой";
			НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НоваяСтрока.УточнениеСпособаОпределения=Строка.КоррСчет;
			
			Обработки.КорректировкиЗначенийПоказателей.ДобавитьПараметрыОтбораИсключаемыхВНА(ПравилаВычисленияПараметровТек,МассивИсключаемыхВНА.ВыгрузитьЗначения(),МассивВидовСубконтоВНА);
			
			СтрЗапрос.ПравилаВычисленияПараметров=ПравилаВычисленияПараметровТек;
			
			КонтекстОтчета=СформироватьДанныеОбъекта();
			
			Если НЕ ТаблицаДанныхИсточник.Колонки.Найти("Период")=Неопределено Тогда
				
				КонтекстОтчета.Вставить("ПериодОтчета",	Новый Структура("ДатаНачала,ДатаОкончания",НачалоДня(Строка.Период),КонецДня(Строка.Период)));
				
			КонецЕсли;				
			
			НоваяСтрока=ПравилаВычисленияПараметровТек.Добавить();
			НоваяСтрока.ИмяПараметра=		"Организация";
			НоваяСтрока.НаименованиеБД=		"Организация";
			НоваяСтрока.ПолеБД=				"Организация";
			НоваяСтрока.ТипРасчета=			"Простой";
			НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			
			Если НЕ ТаблицаДанныхИсточник.Колонки.Найти("Организация")=Неопределено Тогда
				НоваяСтрока.УточнениеСпособаОпределения=Строка.Организация;
			Иначе
				НоваяСтрока.УточнениеСпособаОпределения=Отчет.Организация;
			КонецЕсли;
			
				
				
			
			ТаблицаДанных=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрПроизвольный(КонтекстОтчета,СтрЗапрос);
			
			Если ТаблицаДанных.Количество()>0 Тогда
				
				Строка.СуммаИсключения=ТаблицаДанных[0].Сумма;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
		
 КонецПроцедуры // ДополнитьТаблицуДанныхПараллельныйУчет() 	
	

&НаСервере
Процедура ВывестиОтчетСДополнительнойГруппировкой_Корр(Запрос)
	
	Макет=Отчеты.ВыверкаТрансляцииПроводок.ПолучитьМакет("МакетКорреспонденция");
	ТаблицаСоответствия=ПолучитьТаблицуСоответствияСчетов();
	
	ОбластьСтрокаГруппировка	= Макет.ПолучитьОбласть("СтрокаГруппировка|ОбластьДанных");
	ОбластьИсключениеПериод 	= Макет.ПолучитьОбласть("СтрокаГруппировка|ПараллельныйУчет");
	
	ОбластьСтрокаСостояние			= Макет.ПолучитьОбласть("СтрокаСостояние|ОбластьДанных");
	ОбластьИсключениеСостояние 		= Макет.ПолучитьОбласть("СтрокаСостояние|ПараллельныйУчет");
	
	ОбластьДанных=Макет.ПолучитьОбласть("СтрокаДанные|ОбластьДанных");
	ОбластьОтступ=Макет.ПолучитьОбласть("СтрокаДанные|ОбластьОтступ");

	ОбластьИсключения	= Макет.ПолучитьОбласть("СтрокаДанные|ПараллельныйУчет");
	
	ОбластьИтого        	= Макет.ПолучитьОбласть("СтрокаИтого|ОбластьДанных");
	ОбластьИсключениеИтого 	= Макет.ПолучитьОбласть("СтрокаИтого|ПараллельныйУчет");

	ОбластьПодробно        		= Макет.ПолучитьОбласть("СтрокаПодробно|ОбластьДанных");
	ОбластьИсключениеПодробно 	= Макет.ПолучитьОбласть("СтрокаПодробно|ПараллельныйУчет");
	
	ИтогоРасхождение=0;
	ИтогоЗначениеИсточник=0;
	ИтогоЗначениеПриемник=0;
	ИтогоСуммаИсключения=0;
	ТаблицаТрансляции.Очистить();
	
	ВыборкаГруппировка=Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГруппировка.Следующий() Цикл
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("Группировка",ВыборкаГруппировка.Группировка);
		
		ТабДок.Вывести(ОбластьОтступ);
		
		Если ТипЗнч(ВыборкаГруппировка.Группировка)=Тип("СправочникСсылка.Организации") Тогда
			
			ОбластьСтрокаГруппировка.Параметры.Группировка=ВыборкаГруппировка.Группировка;
			
		Иначе
			
			ОбластьСтрокаГруппировка.Параметры.Группировка		= ОбщегоНазначенияУХ.ПолучитьПериодСтрокой(ВыборкаГруппировка.Группировка,XMLСтрока(Отчет.Периодичность));
			
		КонецЕсли;
		
		ОбластьСтрокаГруппировка.Параметры.ЗначениеИсточник	= ВыборкаГруппировка.Сумма;
		ОбластьСтрокаГруппировка.Параметры.ЗначениеПриемник	= ВыборкаГруппировка.СуммаВВалютеУчета;
		ОбластьСтрокаГруппировка.Параметры.Расхождение		= ВыборкаГруппировка.Расхождение_Сумма_СуммаВВалютеУчета;
		
		ТабДок.Присоединить(ОбластьСтрокаГруппировка);
		
		Если МассивИсключаемыхВНА.Количество()>0 Тогда
			
			ОбластьИсключениеПериод.Параметры.СуммаИсключения=ВыборкаГруппировка.СуммаИсключения;				
			ТабДок.Присоединить(ОбластьИсключениеПериод);
			
		КонецЕсли;
		
		ТекстСостояния="";
		
		Если НЕ ТипЗнч(ВыборкаГруппировка.Группировка)=Тип("СправочникСсылка.Организации") Тогда
			
			
			ТекстСостояния=ПолучитьСводноеСостояние(ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ВыборкаГруппировка.Группировка,ПериодичностьТрансляции,0));
			
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстСостояния) Тогда
			
			ТабДок.Вывести(ОбластьОтступ);
			ОбластьСтрокаСостояние.Параметры.Состояние=ТекстСостояния;
			ТабДок.Присоединить(ОбластьСтрокаСостояние);
			
			Если МассивИсключаемыхВНА.Количество()>0 Тогда
							
				ТабДок.Присоединить(ОбластьИсключениеСостояние);
				
			КонецЕсли;
			
		КонецЕсли;
			
		ТабДок.НачатьГруппуСтрок(""+ОбластьСтрокаГруппировка.Параметры.Группировка,Ложь);
		
		ВыборкаСчетИсточникДт=ВыборкаГруппировка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетИсточникДт.Следующий() Цикл
		
		ВыборкаСчетИсточникКт=ВыборкаСчетИсточникДт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетИсточникКт.Следующий() Цикл
			
			НоваяСтрока=ТаблицаТрансляции.Добавить();
			НоваяСтрока.СчетДтИсточник=ВыборкаСчетИсточникКт.СчетДтИсточник;
			НоваяСтрока.СчетКтИсточник=ВыборкаСчетИсточникКт.СчетКтИсточник;
			НоваяСтрока.РасхождениеДт=ВыборкаСчетИсточникКт.Расхождение_Сумма_СуммаВВалютеУчета;
			
			Если ТипЗнч(ВыборкаГруппировка.Группировка)=Тип("СправочникСсылка.Организации") Тогда
				
				НоваяСтрока.Организация=ВыборкаГруппировка.Группировка;
				
			Иначе
				
				НоваяСтрока.ПериодСтрока=ОбластьСтрокаГруппировка.Параметры.Группировка;
				НоваяСтрока.Период=ВыборкаГруппировка.Группировка;
				
			КонецЕсли;
			
			НоваяСтрока.Периодичность=Отчет.Периодичность;
			
			Если Отчет.ВыводитьТолькоОшибочные И ВыборкаСчетИсточникКт.Расхождение_Сумма_СуммаВВалютеУчета=0 Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ТабДок.Вывести(ОбластьОтступ);
				
			ОбластьДанных.Параметры.СчетДтПриемник	= "";
			ОбластьДанных.Параметры.СчетКтПриемник	= "";

			ОбластьДанных.Параметры.СчетДтИсточник	= ВыборкаСчетИсточникКт.СчетДтИсточникКод;
			ОбластьДанных.Параметры.СчетКтИсточник	= ВыборкаСчетИсточникКт.СчетКтИсточникКод;
			ОбластьДанных.Параметры.ЗначениеИсточник= ВыборкаСчетИсточникКт.Сумма;
			ОбластьДанных.Параметры.ЗначениеПриемник= ВыборкаСчетИсточникКт.СуммаВВалютеУчета;
	
			ОбластьДанных.Параметры.Расхождение		= ВыборкаСчетИсточникКт.Расхождение_Сумма_СуммаВВалютеУчета;

			ИтогоРасхождение=ИтогоРасхождение+ОбластьДанных.Параметры.Расхождение;
			ИтогоЗначениеИсточник=ИтогоЗначениеИсточник+ОбластьДанных.Параметры.ЗначениеИсточник;
			
			СтруктураПараметров.Вставить("СчетДтИсточник",ВыборкаСчетИсточникКт.СчетДтИсточник);
			СтруктураПараметров.Вставить("СчетКтИсточник",ВыборкаСчетИсточникКт.СчетКтИсточник);
			
			ОбластьДанных.Параметры.РасшифровкаИсточник=СтруктураПараметров;
			
			ОбластьДанных.Параметры.РасшифровкаПриемник=ОбщегоНазначенияУХ.СкопироватьУниверсальнуюКоллекцию(СтруктураПараметров);
			ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("Приемник",Истина);
			
			ЕстьСоответствиеСчетов=Истина;
			
			СтрокаИсточникДт=ТаблицаСоответствия.Найти(ВыборкаСчетИсточникКт.СчетДтИсточникКод,"СчетИсточникКод");
			СтрокаИсточникКт=ТаблицаСоответствия.Найти(ВыборкаСчетИсточникКт.СчетКтИсточникКод,"СчетИсточникКод");
			
			Если СтрокаИсточникДт=Неопределено ИЛИ СтрокаИсточникКт=Неопределено Тогда
				
				ЕстьСоответствиеСчетов=Ложь;
				
				Если СтрокаИсточникДт=Неопределено И СтрокаИсточникКт=Неопределено Тогда

					ОбластьДанных.Параметры.СчетДтПриемник=НСтр("ru = 'Нет мэппинга'");
					ОбластьДанных.Параметры.СчетКтПриемник=НСтр("ru = 'Нет мэппинга'");
				
				ИначеЕсли НЕ СтрокаИсточникДт=Неопределено Тогда
					
					ОбластьДанных.Параметры.СчетДтПриемник=СтрокаИсточникДт.СчетПриемникКод;
					ОбластьДанных.Параметры.СчетКтПриемник=НСтр("ru = 'Нет мэппинга'");
					ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("СчетДтПриемник",СтрокаИсточникДт.СчетПриемник);
					
				Иначе
					
					ОбластьДанных.Параметры.СчетКтПриемник=СтрокаИсточникКт.СчетПриемникКод;
					ОбластьДанных.Параметры.СчетДтПриемник=НСтр("ru = 'Нет мэппинга'");
					ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("СчетКтПриемник",СтрокаИсточникКт.СчетПриемник);
	
				КонецЕсли;
				
			КонецЕсли;
			
			ПолучитьТаблицуСчетовПриемникКорр(ВыборкаСчетИсточникКт,ИтогоЗначениеПриемник);
			
			Если ТаблицаСчетовПриемникКорр.Количество()=0 Тогда
				
				Если ЕстьСоответствиеСчетов Тогда
				
					ОбластьДанных.Параметры.СчетДтПриемник=СтрокаИсточникДт.СчетПриемник;
					ОбластьДанных.Параметры.СчетКтПриемник=СтрокаИсточникКт.СчетПриемник;
					
				КонецЕсли;
				
			ИначеЕсли ТаблицаСчетовПриемникКорр.Количество()=1 Тогда
				
				СтрокаПриемник=ТаблицаСчетовПриемникКорр[0];	
				ЗаполнитьПараметрыОбластиДанныхКорр(ОбластьДанных,СтрокаПриемник,ВыборкаГруппировка.Группировка);
					
			КонецЕсли;
			
			ТабДок.Присоединить(ОбластьДанных);
			
			Если МассивИсключаемыхВНА.Количество()>0 Тогда
				
				ОбластьИсключения.Параметры.СуммаИсключения=ВыборкаСчетИсточникКт.СуммаИсключения;
				ОбластьИсключения.Параметры.РасшифровкаИсточник=СтруктураПараметров;
				
				ИтогоСуммаИсключения=ИтогоСуммаИсключения+ОбластьИсключения.Параметры.СуммаИсключения;
				
				ТабДок.Присоединить(ОбластьИсключения);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетДтПриемник) И ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетКтПриемник) Тогда
				
				ВывестиДополнительнуюИнформацию(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ОбластьИсключениеПодробно,
										ТаблицаСоответствия,
										МассивИсключаемыхВНА.Количество()>0);
										
			КонецЕсли;
				
			Если ТаблицаСчетовПриемникКорр.Количество()>1 Тогда 
				
				ТабДок.НачатьГруппуСтрок(""+ВыборкаСчетИсточникКт.СчетДтИсточникКод,Отчет.ПодробнаяИнформация);
				
				Для Каждого СтрокаПриемник ИЗ ТаблицаСчетовПриемникКорр Цикл
				
						ТабДок.Вывести(ОбластьОтступ);
						
						ОбластьДанных.Параметры.СчетДтИсточник	= "";
						ОбластьДанных.Параметры.СчетКтИсточник	= "";
						ОбластьДанных.Параметры.ЗначениеИсточник= 0;
						ОбластьДанных.Параметры.Расхождение		= 0;
						
						ЗаполнитьПараметрыОбластиДанныхКорр(ОбластьДанных,СтрокаПриемник,ВыборкаГруппировка.Группировка);
												
						ТабДок.Присоединить(ОбластьДанных);
						
						Если МассивИсключаемыхВНА.Количество()>0 Тогда
							
							ОбластьИсключения.Параметры.РасшифровкаИсточник=СтруктураПараметров;
							ОбластьИсключения.Параметры.СуммаИсключения=0;
							ТабДок.Присоединить(ОбластьИсключения);
							
						КонецЕсли;
						
						ВывестиДополнительнуюИнформацию(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ОбластьИсключениеПодробно,
										ТаблицаСоответствия,
										МассивИсключаемыхВНА.Количество()>0);
						
					КонецЦикла;
					
					ТабДок.ЗакончитьГруппуСтрок();
					
			КонецЕсли;
			
			ТабДок.Область(ТабДок.ВысотаТаблицы,2,ТабДок.ВысотаТаблицы,ТабДок.ШиринаТаблицы).ГраницаСнизу=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
						
		КонецЦикла;
			
	КонецЦикла;
	
	ТабДок.ЗакончитьГруппуСтрок();	
	
КонецЦикла;

ОбластьИтого.Параметры.ИтогоРасхождение=ИтогоРасхождение;
ОбластьИтого.Параметры.ИтогоЗначениеИсточник=ИтогоЗначениеИсточник;
ОбластьИтого.Параметры.ИтогоЗначениеПриемник=ИтогоЗначениеПриемник;

ТабДок.Вывести(ОбластьОтступ);
ТабДок.Присоединить(ОбластьИтого);

Если МассивИсключаемыхВНА.Количество()>0 Тогда
	
	ОбластьИсключениеИтого.Параметры.ИтогоСуммаИсключения=ИтогоСуммаИсключения;	
	ТабДок.Присоединить(ОбластьИсключениеИтого);
	
КонецЕсли;
	
КонецПроцедуры // ВывестиОтчетСГруппировкойПоПериодам_Корр() 

&НаСервере
Процедура ПолучитьТаблицуСчетовПриемникКорр(ВыборкаСчетИсточникКт,ИтогоЗначениеПриемник)
	
	ТаблицаСчетовПриемникКорр.Очистить();
	
	ВыборкаСчетПриемникДт=ВыборкаСчетИсточникКт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Пока ВыборкаСчетПриемникДт.Следующий() Цикл
		
		ВыборкаСчетПриемникКт=ВыборкаСчетПриемникДт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетПриемникКт.Следующий() Цикл
			
			Если НЕ (ЗначениеЗаполнено(ВыборкаСчетПриемникКт.СчетДтПриемникКод) И ЗначениеЗаполнено(ВыборкаСчетПриемникКт.СчетКтПриемникКод)) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			НоваяСтрока=ТаблицаСчетовПриемникКорр.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаСчетПриемникКт);
			
			НоваяСтрока.ЗначениеПриемник=ВыборкаСчетПриемникКт.СуммаВВалютеУчета;
			ИтогоЗначениеПриемник=ИтогоЗначениеПриемник+НоваяСтрока.ЗначениеПриемник;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры  // ПолучитьТаблицуСчетовПриемникКорр()

&НаСервере
Процедура ЗаполнитьПараметрыОбластиДанныхКорр(ОбластьДанных,СтрокаПриемник,Группировка=Неопределено)
	
	ОбластьДанных.Параметры.СчетДтПриемник	= СтрокаПриемник.СчетДтПриемник;
	ОбластьДанных.Параметры.СчетКтПриемник	= СтрокаПриемник.СчетКтПриемник;
	
	ОбластьДанных.Параметры.ЗначениеПриемник= СтрокаПриемник.ЗначениеПриемник;
				
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("СчетДтИсточник",СтрокаПриемник.СчетДтИсточник);
	СтруктураПараметров.Вставить("СчетКтИсточник",СтрокаПриемник.СчетКтИсточник);
	
	Если ЗначениеЗаполнено(Группировка) Тогда
					
		СтруктураПараметров.Вставить("Группировка",Группировка); 
			
	КонецЕсли;
		
	Если ЗначениеЗаполнено(СтрокаПриемник.Период) Тогда
		
		СтруктураПараметров.Вставить("Период",СтрокаПриемник.Период);
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(СтрокаПриемник.Организация) Тогда
		
		СтруктураПараметров.Вставить("Организация",СтрокаПриемник.Организация);
		
	КонецЕсли;
		
	ОбластьДанных.Параметры.РасшифровкаИсточник=СтруктураПараметров;
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("СчетДтИсточник",СтрокаПриемник.СчетДтИсточник);
	СтруктураПараметров.Вставить("СчетКтИсточник",СтрокаПриемник.СчетКтИсточник);
	
	СтруктураПараметров.Вставить("СчетДтПриемник",СтрокаПриемник.СчетДтПриемник);
	СтруктураПараметров.Вставить("СчетКтПриемник",СтрокаПриемник.СчетКтПриемник);
	
	Если ЗначениеЗаполнено(СтрокаПриемник.Период) Тогда
		
		СтруктураПараметров.Вставить("Период",СтрокаПриемник.Период);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Группировка) Тогда
					
		СтруктураПараметров.Вставить("Группировка",Группировка); 
			
	КонецЕсли;
	
	ОбластьДанных.Параметры.РасшифровкаПриемник=СтруктураПараметров;
		
КонецПроцедуры // ЗаполнитьПараметрыОбластиДанных()


&НаСервере
Процедура ВывестиОтчет_Корр(Запрос)
	
	Макет=Отчеты.ВыверкаТрансляцииПроводок.ПолучитьМакет("МакетКорреспонденция");
	
	
	ТаблицаСоответствия=ПолучитьТаблицуСоответствияСчетов();
	
	ОбластьДанных		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьДанных");
	ОбластьОтступ		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьОтступ");
	ОбластьИсключения	= Макет.ПолучитьОбласть("СтрокаДанные|ПараллельныйУчет");
	
	ОбластьИтого        	= Макет.ПолучитьОбласть("СтрокаИтого|ОбластьДанных");
	ОбластьИсключениеИтого 	= Макет.ПолучитьОбласть("СтрокаИтого|ПараллельныйУчет");
	
	ОбластьПодробно        		= Макет.ПолучитьОбласть("СтрокаПодробно|ОбластьДанных");
	ОбластьИсключениеПодробно 	= Макет.ПолучитьОбласть("СтрокаПодробно|ПараллельныйУчет");
	
	ИтогоРасхождение=0;
	ИтогоЗначениеИсточник=0;
	ИтогоЗначениеПриемник=0;
	ИтогоСуммаИсключения=0;
	ТаблицаТрансляции.Очистить();
		
	ВыборкаСчетИсточникДт=Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСчетИсточникДт.Следующий() Цикл
		
		ВыборкаСчетИсточникКт=ВыборкаСчетИсточникДт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетИсточникКт.Следующий() Цикл
			
			НоваяСтрока=ТаблицаТрансляции.Добавить();
			НоваяСтрока.СчетДтИсточник=ВыборкаСчетИсточникКт.СчетДтИсточник;
			НоваяСтрока.СчетКтИсточник=ВыборкаСчетИсточникКт.СчетКтИсточник;
			НоваяСтрока.РасхождениеДт=ВыборкаСчетИсточникКт.Расхождение_Сумма_СуммаВВалютеУчета;
						
			Если Отчет.ВыводитьТолькоОшибочные И ВыборкаСчетИсточникКт.Расхождение_Сумма_СуммаВВалютеУчета=0 Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ТабДок.Вывести(ОбластьОтступ);
				
			ОбластьДанных.Параметры.СчетДтПриемник	= "";
			ОбластьДанных.Параметры.СчетКтПриемник	= "";

			ОбластьДанных.Параметры.СчетДтИсточник	= ВыборкаСчетИсточникКт.СчетДтИсточникКод;
			ОбластьДанных.Параметры.СчетКтИсточник	= ВыборкаСчетИсточникКт.СчетКтИсточникКод;
			ОбластьДанных.Параметры.ЗначениеИсточник= ВыборкаСчетИсточникКт.Сумма;
			ОбластьДанных.Параметры.ЗначениеПриемник= ВыборкаСчетИсточникКт.СуммаВВалютеУчета;
	
			ОбластьДанных.Параметры.Расхождение		= ВыборкаСчетИсточникКт.Расхождение_Сумма_СуммаВВалютеУчета;

			ИтогоРасхождение=ИтогоРасхождение+ОбластьДанных.Параметры.Расхождение;
			ИтогоЗначениеИсточник=ИтогоЗначениеИсточник+ОбластьДанных.Параметры.ЗначениеИсточник;
			
			СтруктураПараметров=Новый Структура;
			СтруктураПараметров.Вставить("СчетДтИсточник",ВыборкаСчетИсточникКт.СчетДтИсточник);
			СтруктураПараметров.Вставить("СчетКтИсточник",ВыборкаСчетИсточникКт.СчетКтИсточник);
			
			ОбластьДанных.Параметры.РасшифровкаИсточник=СтруктураПараметров;
			ОбластьДанных.Параметры.РасшифровкаПриемник=ОбщегоНазначенияУХ.СкопироватьУниверсальнуюКоллекцию(СтруктураПараметров);
			ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("Приемник",Истина);
			
			ЕстьСоответствиеСчетов=Истина;
			
			СтрокаИсточникДт=ТаблицаСоответствия.Найти(ВыборкаСчетИсточникКт.СчетДтИсточникКод,"СчетИсточникКод");
			СтрокаИсточникКт=ТаблицаСоответствия.Найти(ВыборкаСчетИсточникКт.СчетКтИсточникКод,"СчетИсточникКод");
			
			Если СтрокаИсточникДт=Неопределено ИЛИ СтрокаИсточникКт=Неопределено Тогда
				
				ЕстьСоответствиеСчетов=Ложь;
				
				Если СтрокаИсточникДт=Неопределено И СтрокаИсточникКт=Неопределено Тогда

					ОбластьДанных.Параметры.СчетДтПриемник=НСтр("ru = 'Нет мэппинга'");
					ОбластьДанных.Параметры.СчетКтПриемник=НСтр("ru = 'Нет мэппинга'");
				
				ИначеЕсли НЕ СтрокаИсточникДт=Неопределено Тогда
					
					ОбластьДанных.Параметры.СчетДтПриемник=СтрокаИсточникДт.СчетПриемникКод;
					ОбластьДанных.Параметры.СчетКтПриемник=НСтр("ru = 'Нет мэппинга'");
					ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("СчетДтПриемник",СтрокаИсточникДт.СчетПриемник);
					
				Иначе
					
					ОбластьДанных.Параметры.СчетКтПриемник=СтрокаИсточникКт.СчетПриемникКод;
					ОбластьДанных.Параметры.СчетДтПриемник=НСтр("ru = 'Нет мэппинга'");
					ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("СчетКтПриемник",СтрокаИсточникКт.СчетПриемник);
	
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЕстьСоответствиеСчетов Тогда
				
				ПолучитьТаблицуСчетовПриемникКорр(ВыборкаСчетИсточникКт,ИтогоЗначениеПриемник);
				
				Если ТаблицаСчетовПриемникКорр.Количество()=0 Тогда
					
					ОбластьДанных.Параметры.СчетДтПриемник=СтрокаИсточникДт.СчетПриемник;
					ОбластьДанных.Параметры.СчетКтПриемник=СтрокаИсточникКт.СчетПриемник;
					ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("СчетДтПриемник",СтрокаИсточникДт.СчетПриемник);
					ОбластьДанных.Параметры.РасшифровкаПриемник.Вставить("СчетКтПриемник",СтрокаИсточникКт.СчетПриемник);
	
				ИначеЕсли ТаблицаСчетовПриемникКорр.Количество()=1 Тогда
					
					СтрокаПриемник=ТаблицаСчетовПриемникКорр[0];	
					ЗаполнитьПараметрыОбластиДанныхКорр(ОбластьДанных,СтрокаПриемник);
					
				КонецЕсли;
				
			КонецЕсли;
			
			ТабДок.Присоединить(ОбластьДанных);
			
			Если МассивИсключаемыхВНА.Количество()>0 Тогда
				
				ОбластьИсключения.Параметры.СуммаИсключения=ВыборкаСчетИсточникКт.СуммаИсключения;
				ОбластьИсключения.Параметры.РасшифровкаИсточник=СтруктураПараметров;
				
				ИтогоСуммаИсключения=ИтогоСуммаИсключения+ОбластьИсключения.Параметры.СуммаИсключения;
				
				ТабДок.Присоединить(ОбластьИсключения);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетДтПриемник) И ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетКтПриемник) Тогда
				
				ВывестиДополнительнуюИнформацию(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ОбластьИсключениеПодробно,
										ТаблицаСоответствия,
										МассивИсключаемыхВНА.Количество()>0);
										
			КонецЕсли;
				
			Если ТаблицаСчетовПриемникКорр.Количество()>1 Тогда 
				
				ТабДок.НачатьГруппуСтрок(""+ВыборкаСчетИсточникКт.СчетДтИсточникКод,Отчет.ПодробнаяИнформация);
				
				Для Каждого СтрокаПриемник ИЗ ТаблицаСчетовПриемникКорр Цикл
				
						ТабДок.Вывести(ОбластьОтступ);
						
						ОбластьДанных.Параметры.СчетДтИсточник	= "";
						ОбластьДанных.Параметры.СчетКтИсточник	= "";
						ОбластьДанных.Параметры.ЗначениеИсточник= 0;
						ОбластьДанных.Параметры.Расхождение		= 0;
						
						ЗаполнитьПараметрыОбластиДанныхКорр(ОбластьДанных,СтрокаПриемник);
												
						ТабДок.Присоединить(ОбластьДанных);
						
						Если МассивИсключаемыхВНА.Количество()>0 Тогда
							
							ОбластьИсключения.Параметры.РасшифровкаИсточник=СтруктураПараметров;
							ОбластьИсключения.Параметры.СуммаИсключения=0;
							ТабДок.Присоединить(ОбластьИсключения);
							
						КонецЕсли;
						
						ВывестиДополнительнуюИнформацию(ТабДок,
										ОбластьОтступ,
										ОбластьДанных,
										ОбластьПодробно,
										ОбластьИсключениеПодробно,
										ТаблицаСоответствия,
										МассивИсключаемыхВНА.Количество()>0);
						
					КонецЦикла;
					
					ТабДок.ЗакончитьГруппуСтрок();
					
			КонецЕсли;
			
			ТабДок.Область(ТабДок.ВысотаТаблицы,2,ТабДок.ВысотаТаблицы,ТабДок.ШиринаТаблицы).ГраницаСнизу=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
						
		КонецЦикла;
		
	КонецЦикла;
	
	ОбластьИтого.Параметры.ИтогоРасхождение=ИтогоРасхождение;
	ОбластьИтого.Параметры.ИтогоЗначениеИсточник=ИтогоЗначениеИсточник;
	ОбластьИтого.Параметры.ИтогоЗначениеПриемник=ИтогоЗначениеПриемник;
	
	ТабДок.Вывести(ОбластьОтступ);
	ТабДок.Присоединить(ОбластьИтого);
	
	Если МассивИсключаемыхВНА.Количество()>0 Тогда
						
		ОбластьИсключениеИтого.Параметры.ИтогоСуммаИсключения=ИтогоСуммаИсключения;	
		ТабДок.Присоединить(ОбластьИсключениеИтого);
						
	КонецЕсли;
		
КонецПроцедуры // ВывестиОтчет_Корр() 

Процедура ПолучитьТаблицуСчетовПриемникОб(ВыборкаСчетИсточник,ИтогоЗначениеПриемникДт,ИтогоЗначениеПриемникКт)
	
	ТаблицаСчетовПриемникОб.Очистить();
	
	ВыборкаСчетПриемник=ВыборкаСчетИсточник.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСчетПриемник.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаСчетПриемник.СчетПриемник) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока=ТаблицаСчетовПриемникОб.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаСчетПриемник);
		
		НоваяСтрока.ЗначениеПриемникДт = ВыборкаСчетПриемник.СуммаВВалютеУчетаДт;
		НоваяСтрока.ЗначениеПриемникКт = ВыборкаСчетПриемник.СуммаВВалютеУчетаКт;
		
		ИтогоЗначениеПриемникДт=ИтогоЗначениеПриемникДт+НоваяСтрока.ЗначениеПриемникДт;
		ИтогоЗначениеПриемникКт=ИтогоЗначениеПриемникКт+НоваяСтрока.ЗначениеПриемникКт;
		
	КонецЦикла;
		
КонецПроцедуры // ПолучитьТаблицуСчетовПриемникОб()

&НаСервере
Процедура ДополнитьРасшифровкуПериодом(СтруктураПараметров,СтрокаПриемник)
	
	Если ЗначениеЗаполнено(СтрокаПриемник.Период) Тогда
		
		СтруктураПараметров.Вставить("Период",СтрокаПриемник.Период);
		
	КонецЕсли;
	
КонецПроцедуры // ДополнитьРасшифровкуПериодом() 

&НаСервере
Процедура ЗаполнитьПараметрыОбластиДанныхОбороты(ОбластьДанных,СтрокаПриемник,Группировка=Неопределено)
	
	ОбластьДанных.Параметры.СчетПриемник	= СтрокаПриемник.СчетПриемник;
		
	ОбластьДанных.Параметры.ЗначениеПриемникДт = СтрокаПриемник.ЗначениеПриемникДт;
	ОбластьДанных.Параметры.ЗначениеПриемникКт = СтрокаПриемник.ЗначениеПриемникКт;
	
	СтруктураПараметровДт=Новый Структура("ДтКт","Дт");
	ДополнитьРасшифровкуПериодом(СтруктураПараметровДт,СтрокаПриемник);
	
	СтруктураПараметровКт=Новый Структура("ДтКт","Кт");
	ДополнитьРасшифровкуПериодом(СтруктураПараметровКт,СтрокаПриемник);
	
	СтруктураПараметровДт.Вставить("СчетИсточник",СтрокаПриемник.СчетИсточник);
	СтруктураПараметровКт.Вставить("СчетИсточник",СтрокаПриемник.СчетИсточник); 
	
	Если ЗначениеЗаполнено(Группировка) Тогда
		
		СтруктураПараметровДт.Вставить("Группировка",Группировка);
		СтруктураПараметровКт.Вставить("Группировка",Группировка); 
		
	КонецЕсли;
			
	ОбластьДанных.Параметры.РасшифровкаИсточникДт=СтруктураПараметровДт;
	ОбластьДанных.Параметры.РасшифровкаИсточникКт=СтруктураПараметровКт;
	
	СтруктураПараметровДт=Новый Структура("ДтКт","Дт");
	СтруктураПараметровДт.Вставить("СчетИсточник",СтрокаПриемник.СчетИсточник);	
	СтруктураПараметровДт.Вставить("СчетПриемник",СтрокаПриемник.СчетПриемник);
	ДополнитьРасшифровкуПериодом(СтруктураПараметровДт,СтрокаПриемник);
	
	СтруктураПараметровКт=Новый Структура("ДтКт","Кт");
	СтруктураПараметровКт.Вставить("СчетИсточник",СтрокаПриемник.СчетИсточник);	
	СтруктураПараметровКт.Вставить("СчетПриемник",СтрокаПриемник.СчетПриемник);
	ДополнитьРасшифровкуПериодом(СтруктураПараметровКт,СтрокаПриемник);
	
	Если ЗначениеЗаполнено(Группировка) Тогда
		
		СтруктураПараметровДт.Вставить("Группировка",Группировка);
		СтруктураПараметровКт.Вставить("Группировка",Группировка); 
		
	КонецЕсли;
	
	ОбластьДанных.Параметры.РасшифровкаПриемникДт=СтруктураПараметровДт;
	ОбластьДанных.Параметры.РасшифровкаПриемникКт=СтруктураПараметровКт;	
	
КонецПроцедуры // ЗаполнитьПараметрыОбластиДанныОбороты()
	
&НаСервере
Процедура ВывестиОтчет_Об(Запрос)
	
	Макет=Отчеты.ВыверкаТрансляцииПроводок.ПолучитьМакет("МакетОборотыДтКт_ВНА");
	
	ТаблицаСоответствия=ПолучитьТаблицуСоответствияСчетов();
	
	ОбластьДанных		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьДанных");
	ОбластьОтступ		= Макет.ПолучитьОбласть("СтрокаДанные|ОбластьОтступ");
		
	ОбластьИтого        	= Макет.ПолучитьОбласть("СтрокаИтого|ОбластьДанных");
	
	ОбластьПодробно        	= Макет.ПолучитьОбласть("СтрокаПодробно|ОбластьДанных");
	
	ИтогоРасхождениеДт=0;
	ИтогоРасхождениеКт=0;
	
	ИтогоЗначениеИсточникДт=0;
	ИтогоЗначениеИсточникКт=0;
	
	ИтогоЗначениеПриемникДт=0;
	ИтогоЗначениеПриемникКт=0;

	ИтогоСуммаИсключенияДт=0;
	ИтогоСуммаИсключенияКт=0;
	
	ВыборкаСчетИсточник=Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаТрансляции.Очистить();
	
	Пока ВыборкаСчетИсточник.Следующий() Цикл
		
		НоваяСтрока=ТаблицаТрансляции.Добавить();
		НоваяСтрока.СчетДтИсточник=ВыборкаСчетИсточник.СчетИсточник;
		НоваяСтрока.РасхождениеДт=ВыборкаСчетИсточник.Расхождение_Сумма_СуммаВВалютеУчетаДт;
		НоваяСтрока.РасхождениеКт=ВыборкаСчетИсточник.Расхождение_Сумма_СуммаВВалютеУчетаКт;
			
		Если Отчет.ВыводитьТолькоОшибочные 
			И ВыборкаСчетИсточник.Расхождение_Сумма_СуммаВВалютеУчетаДт=0
			И ВыборкаСчетИсточник.Расхождение_Сумма_СуммаВВалютеУчетаКт=0 Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьОтступ);
		
		ОбластьДанных.Параметры.СчетПриемник	= "";
		
		ОбластьДанных.Параметры.СчетИсточник	= ВыборкаСчетИсточник.СчетИсточник;
		
		ОбластьДанных.Параметры.ЗначениеИсточникДт= ВыборкаСчетИсточник.СуммаДт;
		ОбластьДанных.Параметры.ЗначениеИсточникКт= ВыборкаСчетИсточник.СуммаКт;
		
		ОбластьДанных.Параметры.ЗначениеПриемникДт= ВыборкаСчетИсточник.СуммаВВалютеУчетаДт;
		ОбластьДанных.Параметры.ЗначениеПриемникКт= ВыборкаСчетИсточник.СуммаВВалютеУчетаКт;
		
		ОбластьДанных.Параметры.РасхождениеДт	= ВыборкаСчетИсточник.Расхождение_Сумма_СуммаВВалютеУчетаДт;
		ОбластьДанных.Параметры.РасхождениеКт	= ВыборкаСчетИсточник.Расхождение_Сумма_СуммаВВалютеУчетаКт;
		
		ИтогоРасхождениеДт=ИтогоРасхождениеДт+ОбластьДанных.Параметры.РасхождениеДт;
		ИтогоРасхождениеКт=ИтогоРасхождениеКт+ОбластьДанных.Параметры.РасхождениеКт;
		
		ИтогоЗначениеИсточникДт=ИтогоЗначениеИсточникДт+ОбластьДанных.Параметры.ЗначениеИсточникДт;
		ИтогоЗначениеИсточникКт=ИтогоЗначениеИсточникКт+ОбластьДанных.Параметры.ЗначениеИсточникКт;
		
		СтруктураПараметровДт=Новый Структура("ДтКт","Дт");
		СтруктураПараметровКт=Новый Структура("ДтКт","Кт");

		
		СтруктураПараметровДт.Вставить("СчетИсточник",ВыборкаСчетИсточник.СчетИсточник);
		СтруктураПараметровКт.Вставить("СчетИсточник",ВыборкаСчетИсточник.СчетИсточник);
		
		ОбластьДанных.Параметры.РасшифровкаИсточникДт=СтруктураПараметровДт;
		ОбластьДанных.Параметры.РасшифровкаИсточникКт=СтруктураПараметровКт;
		
		ОбластьДанных.Параметры.РасшифровкаПриемникДт=СтруктураПараметровДт;
		ОбластьДанных.Параметры.РасшифровкаПриемникКт=СтруктураПараметровКт;
		
		ЕстьСоответствиеСчетов=Истина;
		
		СтрокаИсточник=ТаблицаСоответствия.Найти(ВыборкаСчетИсточник.СчетИсточникКод,"СчетИсточникКод");
		
		Если СтрокаИсточник=Неопределено Тогда
			
			ЕстьСоответствиеСчетов=Ложь;
			ОбластьДанных.Параметры.СчетПриемник=НСтр("ru = 'Нет мэппинга'");
			ОбластьДанных.Параметры.РасшифровкаИсточникДт.Вставить("СчетПриемник","");
			ОбластьДанных.Параметры.РасшифровкаИсточникКт.Вставить("СчетПриемник","");
	
		КонецЕсли;
		
		Если МассивИсключаемыхВНА.Количество()>0 Тогда
			
			ОбластьДанных.Параметры.СуммаИсключенияДт=ВыборкаСчетИсточник.СуммаИсключенияДт;
			ОбластьДанных.Параметры.СуммаИсключенияКт=ВыборкаСчетИсточник.СуммаИсключенияКт;

			ИтогоСуммаИсключенияДт=ИтогоСуммаИсключенияДт+ОбластьДанных.Параметры.СуммаИсключенияДт;
			ИтогоСуммаИсключенияКт=ИтогоСуммаИсключенияКт+ОбластьДанных.Параметры.СуммаИсключенияКт;	
			
		КонецЕсли;
		
		Если ЕстьСоответствиеСчетов Тогда
			
			ПолучитьТаблицуСчетовПриемникОб(ВыборкаСчетИсточник,ИтогоЗначениеПриемникДт,ИтогоЗначениеПриемникКт);
			
			Если ТаблицаСчетовПриемникОб.Количество()=0  Тогда
				
				ОбластьДанных.Параметры.СчетПриемник=СтрокаИсточник.СчетПриемник;
				
			ИначеЕсли ТаблицаСчетовПриемникОб.Количество()=1 Тогда
				
				СтрокаПриемник=ТаблицаСчетовПриемникОб[0];
				ЗаполнитьПараметрыОбластиДанныхОбороты(ОбластьДанных,СтрокаПриемник);
				
			КонецЕсли;
			
		КонецЕсли;

		ТабДок.Присоединить(ОбластьДанных);
		
		Если ЗначениеЗаполнено(ОбластьДанных.Параметры.СчетПриемник) Тогда
			
			ВывестиДополнительнуюИнформациюОбороты(ТабДок,
				ОбластьОтступ,
				ОбластьДанных,
				ОбластьПодробно,
				ТаблицаСоответствия);
				
		КонецЕсли;
		
		Если ТаблицаСчетовПриемникОб.Количество()>1 Тогда 
			
			ТабДок.НачатьГруппуСтрок(""+ВыборкаСчетИсточник.СчетИсточник,Отчет.ПодробнаяИнформация);
			
