&НаСервере
Функция ПолучитьОтборДанныхТрансляции() 
	
	ВыборТрансляции=РеквизитФормыВЗначение("ТаблицаТрансляции").Скопировать(Новый Структура("Транслировать",Истина),"СчетДтИсточник,СчетКтИсточник");
	
	Если ТипОтчета="Обороты" Тогда
		
		Возврат ВыборТрансляции.ВыгрузитьКолонку("СчетДтИсточник");
		
	Иначе
		
		Возврат ВыборТрансляции;
		
	КонецЕсли;	
	
КонецФункции // ПолучитьОтборДанныхТрансляция() 

&НаСервере
Функция ПерезаполнитьДокументыНаСервере(ОтбиратьПроводки=Истина)
	
	Если ОтбиратьПроводки Тогда
		
		ОтборПроводок=ПолучитьОтборДанныхТрансляции();
		
	Иначе	
		
		ОтборПроводок=Неопределено;
		
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Отчет.ДокументТрансляции) Тогда
		
		МассивДокументов=Новый Массив;
		МассивДокументов.Добавить(Отчет.ДокументТрансляции);
		
	Иначе
		
		Запрос=Новый Запрос;
		
		Если ТипЗнч(ОтборПроводок)=Тип("ТаблицаЗначений") Тогда 
			
			Запрос.Текст="ВЫБРАТЬ
			|	ОтборПроводок.СчетДтИсточник КАК СчетДтИсточник,
			|	ОтборПроводок.СчетКтИсточник КАК СчетКтИсточник
			|ПОМЕСТИТЬ ОтборПроводок
			|ИЗ
			|	&ОтборПроводок КАК ОтборПроводок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТрансляцияПроводки.Ссылка КАК Ссылка,
			|	ТрансляцияПроводки.СчетДтИсточник КАК СчетДтИсточник,
			|	ТрансляцияПроводки.СчетКтИсточник КАК СчетКтИсточник
			|ПОМЕСТИТЬ ТрансляцияПроводки
			|ИЗ
			|	Документ.Трансляция.Проводки КАК ТрансляцияПроводки
			|ГДЕ
			|	&ПроводкиОтборОрганизация
			|	И ТрансляцияПроводки.Ссылка.НачалоПериода >= &ДатаНачала
			|	И ТрансляцияПроводки.Ссылка.ОкончаниеПериода <= &ДатаОкончания
			|	И ТрансляцияПроводки.Ссылка.ШаблонКорректировки = &ШаблонКорректировки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ТрансляцияПроводки.Ссылка КАК Ссылка
			|ИЗ
			|	ТрансляцияПроводки КАК ТрансляцияПроводки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборПроводок КАК ОтборПроводок
			|		ПО ТрансляцияПроводки.СчетДтИсточник = ОтборПроводок.СчетДтИсточник
			|			И ТрансляцияПроводки.СчетКтИсточник = ОтборПроводок.СчетКтИсточник";
			
			Запрос.УстановитьПараметр("ОтборПроводок",ОтборПроводок);
			
		ИначеЕсли ТипЗнч(ОтборПроводок)=Тип("Массив") Тогда
			
			Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ТрансляцияПроводки.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Трансляция.Проводки КАК ТрансляцияПроводки
			|ГДЕ
			|	&ПроводкиОтборОрганизация
			|	И ТрансляцияПроводки.Ссылка.НачалоПериода >= &ДатаНачала
			|	И ТрансляцияПроводки.Ссылка.ОкончаниеПериода <= &ДатаОкончания
			|	И ТрансляцияПроводки.Ссылка.ШаблонКорректировки = &ШаблонКорректировки
			|	И (ТрансляцияПроводки.СчетДтИсточник В (&ОтборПроводок)
			|			ИЛИ ТрансляцияПроводки.СчетКтИсточник В (&ОтборПроводок))";
			
			Запрос.УстановитьПараметр("ОтборПроводок",ОтборПроводок);
			
		Иначе
			
			Запрос.Текст="ВЫБРАТЬ
			             |	ДокументыТрансляции.ДокументТрансляции КАК Ссылка
			             |ИЗ
			             |	РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыТрансляции
			             |ГДЕ
			             |	&ОтборОрганизация
			             |	И ДокументыТрансляции.ШаблонТрансляции = &ШаблонКорректировки
			             |	И ДокументыТрансляции.ДокументТрансляции.НачалоПериода >= &ДатаНачала
			             |	И ДокументыТрансляции.ДокументТрансляции.ОкончаниеПериода <= &ДатаОкончания
			             |
			             |ОБЪЕДИНИТЬ ВСЕ
			             |
			             |ВЫБРАТЬ
			             |	ДокументыТрансляции.ДокументТрансляции
			             |ИЗ
			             |	РегистрСведений.ДокументыСводнойТрансляции КАК ДокументыТрансляции
			             |ГДЕ
			             |	&ОтборОрганизация
			             |	И ДокументыТрансляции.ШаблонТрансляции = &ШаблонКорректировки
			             |	И ДокументыТрансляции.ДокументТрансляции.НачалоПериода >= &ДатаНачала
			             |	И ДокументыТрансляции.ДокументТрансляции.ОкончаниеПериода <= &ДатаОкончания";
			
		КонецЕсли;	
		
		Запрос.УстановитьПараметр("ДатаНачала",			Отчет.ПериодОтчета.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",		Отчет.ПериодОкончания.ДатаОкончания);
		Запрос.УстановитьПараметр("ШаблонКорректировки",Отчет.ШаблонКорректировки);
		
		Если ЗначениеЗаполнено(Отчет.Организация) Тогда
			
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ОтборОрганизация","ДокументыТрансляции.Организация = &Организация");	
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ПроводкиОтборОрганизация","ТрансляцияПроводки.Ссылка.Организация = &Организация");
			
			Запрос.УстановитьПараметр("Организация",		Отчет.Организация);
			
		Иначе
			
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ОтборОрганизация","ИСТИНА");
			Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ОтборОрганизацияПроводки","ИСТИНА");
			
		КонецЕсли; 		
			
		МассивДокументов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	КонецЕсли;
	
	Возврат КорректировкиЗначенийПоказателей32.ОбработатьМассивДокументов(МассивДокументов,Новый Структура("ОтборПроводок",ОтборПроводок));

		
КонецФункции

&НаКлиенте
Процедура ПерезаполнитьДокументы(Команда) 
	
	Если ТаблицаТрансляции.НайтиСтроки(Новый Структура("Транслировать",Истина)).Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьПовторнуюОбработкуДокументов(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПовторнуюОбработкуДокументов(ОтбиратьПроводки=Истина)
	
	ДлительнаяОперация=ПерезаполнитьДокументыНаСервере(ОтбиратьПроводки);	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновитьДанныеОтчета", ЭтотОбъект);
	
	Если ДлительнаяОперация.Статус = "Выполнено"
		Или ДлительнаяОперация.Статус = "Отменено" Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, ДлительнаяОперация);
		
	Иначе
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания             = Истина; 
		ПараметрыОжидания.ТекстСообщения                   = НСтр("ru = 'Выполняется повторная трансляция данных'");
		ПараметрыОжидания.ОповещениеПользователя.Показать  = Истина;
		ПараметрыОжидания.ОповещениеПользователя.Текст     = НСтр("ru = 'Выполняется повторная трансляция данных'");
		ПараметрыОжидания.ОповещениеПользователя.Пояснение = НСтр("ru = 'Выполняется повторная трансляция данных'");
				
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

