#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
// Функция возвращает кол-во позиций потребностей готовые к унификации
Функция ПолучитьКолвоПозицийБезОКПД2(Автор, ПериодЗакупки, Отборы = Неопределено) экспорт   
	
	Если Отборы = Неопределено Тогда
		Отборы = Новый Массив;
	КонецЕсли;
	
	 //Получаем схему из макета
	СхемаКомпоновкиДанных = Отчеты.ПозицииПотребностейБезКодаОКПД2.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	//
	ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("Основной");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);
	//Из схемы возьмем настройки по умолчанию
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();  
	
	Если ТипЗнч(ПериодЗакупки) = Тип("Структура") Тогда
		ПараметрыПериода = ПериодЗакупки;
	Иначе
		ПараметрыПериода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПериодЗакупки, "ДатаНачала, ДатаОкончания");
	КонецЕсли;
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НачалоПериода"));  
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ДатаНачала; 
		Параметр.Использование = Истина;	
	КонецЕсли;
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("КонецПериода")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ДатаОкончания;
		Параметр.Использование = Истина;
	КонецЕсли;   
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодЗакупки")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение.ДатаНачала 	= ПараметрыПериода.ДатаНачала;
		Параметр.Значение.ДатаОкончания = ПараметрыПериода.ДатаОкончания;
		Параметр.Значение.Вариант 		= ВариантСтандартногоПериода.ПроизвольныйПериод;
		Параметр.Использование = Истина;
	КонецЕсли;   
	
	Для Каждого КлючИЗнчение Из Отборы Цикл
		Если СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Найти(КлючИЗнчение.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолеОтбораСубъекты = Новый ПолеКомпоновкиДанных(КлючИЗнчение.Ключ);
		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение = ПолеОтбораСубъекты;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных[КлючИЗнчение.Значение.ВидСравнения];
		ЭлементОтбора.Использование = Истина;     
		Если ЗначениеЗаполнено(КлючИЗнчение.Значение.Значение) Тогда
			ЭлементОтбора.ПравоеЗначение = КлючИЗнчение.Значение.Значение;
		КонецЕсли;
	КонецЦикла; 
	
	//Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	//Выводим результат в табличный документ
	Таблица = Новый ТаблицаЗначений;
	ПроцессорВыводаВТЗ = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаВТЗ.УстановитьОбъект(Таблица);
	
	ПроцессорВыводаВТЗ.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат Таблица.Количество()-1;
	
КонецФункции

#КонецЕсли
