
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отчет.ВысотаОтступа = 4;
	Отчет.ШиринаОтступа = 4;
	Отчет.ШиринаИзгиба  = 1.2;
	Отчет.ШиринаПроекта   = 40;
	Отчет.ВысотаПроекта   = 28;
	
	Если ЗначениеЗаполнено(Параметры.Проект) Тогда
		
		Если Параметры.Проект.ЭтоГруппа Тогда
			
			Отчет.ГруппаПроектов=Параметры.Проект;
			
		КонецЕсли;
		
		СформироватьОтчет();
		
	КонецЕсли;
	
		
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчет()
	
	ТекОБъект = РеквизитФормыВЗначение("Отчет");
	ТекОбъект.СформироватьОтчет(ПолеТабличногоДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьОтчет();
	
КонецПроцедуры
