// ЭКСПОРТИРУЕМЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура формирует отчет
//
Процедура СформироватьОтчет(ПолеТабличногоДокумента) Экспорт
	
	Перем Уровни;
	
	Проекты = ПолучитьТаблицуПроектов(ГруппаПроектов, Уровни);
	ВывестиДиаграммуПроектов(ПолеТабличногоДокумента, Проекты, Уровни);
	Проекты = Неопределено;
	Уровни = Неопределено;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ, ВЫЗЫВАЕМЫЕ ИЗ ОБРАБОТЧИКОВ

// Функция определяет положение проекта на графике по оси Y
// 
Функция ОпределитьНовуюПозициюВУровнеY(СтрокаПроекта, ЗанятыеУровниПоУ, Предпочтение = Неопределено)
	
	Если Не Предпочтение = Неопределено и ПолучитьДанныеУровня(ЗанятыеУровниПоУ,Предпочтение) = Неопределено Тогда
		Результат = Предпочтение;
	Иначе
		Результат = 0;
		
		Пока Не ПолучитьДанныеУровня(ЗанятыеУровниПоУ,Результат) = Неопределено Цикл
			Результат = Результат + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	ДобавитьВТаблицуУровней(ЗанятыеУровниПоУ,Результат, Истина);
	
	Возврат Результат;
	
КонецФункции

// Процедура расчитывает положение проекта на графике по оси Х
// 
Процедура РассчитатьУровеньX(СтрокаПроекта, Проекты)
	
	Если Не СтрокаПроекта.УровеньХ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПроекта.ПроектыПредшественники.Колонки.Добавить("СтрокаПроектаПредшественника");
	Если СтрокаПроекта.ПроектыПредшественники.Количество()>0 Тогда
		МаксУровень = 0;
		
		Для Индекс=0 По СтрокаПроекта.ПроектыПредшественники.Количество()-1 Цикл 
			
			СтрокаПредшественника=СтрокаПроекта.ПроектыПредшественники[Индекс];
						
			СтрокаПредшественника.СтрокаПроектаПредшественника = Проекты.Найти(СтрокаПредшественника.Проект, "Проект");
			РассчитатьУровеньX(СтрокаПредшественника.СтрокаПроектаПредшественника, Проекты);
			МаксУровень = Макс(МаксУровень, СтрокаПредшественника.СтрокаПроектаПредшественника.УровеньХ);
			
		КонецЦикла;
		СтрокаПроекта.УровеньХ = МаксУровень + 1;
	Иначе
		СтрокаПроекта.УровеньХ = 0;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуПроектаПредшественника(ТаблицаПроектов,Проект, Сценарий=Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Проекты.Ссылка КАК Проект,
	|	Проекты.ПроектыПредшественники.(
	|		Проект
	|	),
	|	1 КАК Счетчик,
	|	Проекты.Родитель,
	|	АтрибутыПроектов.ДатаНачала КАК ДлительностьДней,
	|	АтрибутыПроектов.ДатаОкончания КАК ДатаНачала,
	|	АтрибутыПроектов.ДлительностьДней КАК ДатаОкончания
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АтрибутыПроектов КАК АтрибутыПроектов
	|		ПО (АтрибутыПроектов.Проект = Проекты.Ссылка
	|				И АтрибутыПроектов.Сценарий = &Сценарий)
	|ГДЕ
	|	Проекты.Ссылка = &Проект";
	
	Запрос.УстановитьПараметр("Проект",Проект);
	Запрос.УстановитьПараметр("Сценарий", ?(ЗначениеЗаполнено(Сценарий), Сценарий, Справочники.Сценарии.План));
	
	ТабПроекты=Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка ИЗ ТабПроекты Цикл
		
		НоваяСтрока=ТаблицаПроектов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
	КонецЦикла;	
	
КонецПроцедуры // ДобавитьСтрокуПроектаПредшественника()

Функция ПодготовитьТаблицуУровней()
	
	ТаблицаУровней=Новый ТаблицаЗначений;
	ТаблицаУровней.Колонки.Добавить("Ключ");
	ТаблицаУровней.Колонки.Добавить("Значение");
	
	Возврат ТаблицаУровней;	
	
КонецФункции // ПодготовитьТаблицуУровней()

Процедура ДобавитьВТаблицуУровней(ТаблицаУровней,Ключ,Значение)
	
	НоваяСтрока=ТаблицаУровней.Добавить();
	НоваяСтрока.Ключ=Ключ;
	НоваяСтрока.Значение=Значение;
	
КонецПроцедуры // ДобавитьВТаблицуУровней() 

Функция ПолучитьДанныеУровня(ТаблицаУровней,Ключ)
	
	СтрокаУровня=ТаблицаУровней.Найти(Ключ,"Ключ");
	
	Если СтрокаУровня=Неопределено Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Возврат СтрокаУровня.Значение;
		
	КонецЕсли;
	
КонецФункции // ПолучитьСтрокуУровня()

// Функция возвращает таблицу проектов по шаблону процесса, 
// с дополнительными промежуточными данными
//
Функция ПолучитьТаблицуПроектов(ГруппаПроектов, Уровни, Сценарий=Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Проекты.Ссылка КАК Проект,
	|	Проекты.ПроектыПредшественники КАК ПроектыПредшественники,
	|	1 КАК Счетчик,
	|	Проекты.Родитель КАК Родитель,
	|	ЕСТЬNULL(АтрибутыПроектов.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачала,
	|	ЕСТЬNULL(АтрибутыПроектов.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончания,
	|	ЕСТЬNULL(АтрибутыПроектов.ДлительностьДней, 0) КАК ДлительностьДней
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АтрибутыПроектов КАК АтрибутыПроектов
	|		ПО (АтрибутыПроектов.Проект = Проекты.Ссылка)
	|			И (АтрибутыПроектов.Сценарий = &Сценарий)";
	
	Если ЗначениеЗаполнено(ГруппаПроектов) Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ГДЕ Проекты.Ссылка В Иерархии(&ГруппаПроектов)";
		Запрос.УстановитьПараметр("ГруппаПроектов", ГруппаПроектов);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Сценарий", ?(ЗначениеЗаполнено(Сценарий), Сценарий, Справочники.Сценарии.План));
	
	Проекты = Запрос.Выполнить().Выгрузить();
	Проекты.Колонки.Добавить("УровеньХ");
	Проекты.Колонки.Добавить("КоличествоПредшественников");
	Проекты.Колонки.Добавить("ДлительностьНарастающая", Новый ОписаниеТипов("Число"));
		
	Для Индекс=0 ПО Проекты.Количество()-1 Цикл	
		
		СтрокаПроекта=Проекты[Индекс];
		
		Для Индекс_1=0 ПО СтрокаПроекта.ПроектыПредшественники.Количество()-1 Цикл	
			
			СтрокаПредшественник=СтрокаПроекта.ПроектыПредшественники[Индекс_1];
			
			Если Проекты.Найти(СтрокаПредшественник.Проект,"Проект")=Неопределено Тогда
				
				ДобавитьСтрокуПроектаПредшественника(Проекты,СтрокаПредшественник.Проект, Сценарий);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Индекс=0 ПО Проекты.Количество()-1 Цикл	
		
		СтрокаПроекта=Проекты[Индекс];
		РассчитатьУровеньX(СтрокаПроекта, Проекты);
		СтрокаПроекта.КоличествоПредшественников = СтрокаПроекта.ПроектыПредшественники.Количество();
		
	КонецЦикла;
	
	Проекты.Сортировать("УровеньХ, КоличествоПредшественников, Родитель");
	
	Проекты.Колонки.Добавить("УровеньУ");
	
	Уровни = Новый Структура("Х, У", ПодготовитьТаблицуУровней(), ПодготовитьТаблицуУровней());
	УровеньХ = 0;
	СтрокиУровня = Проекты.НайтиСтроки(Новый Структура("УровеньХ", УровеньХ));
	Пока СтрокиУровня.Количество() Цикл
		СтруктураХ = Новый Структура("ОтступХ, ЗанятыеУровниПоУ", 0, ПодготовитьТаблицуУровней());
		
		ДобавитьВТаблицуУровней(Уровни.Х,УровеньХ,СтруктураХ);
		
		УровеньУ = -1;
		
		Для Индекс=0 ПО СтрокиУровня.Количество()-1 Цикл 
			
			СтрокаПроекта=СтрокиУровня[Индекс];
			
			СтрокаПроекта.ПроектыПредшественники.Колонки.Добавить("ОтступХ", Новый ОписаниеТипов("Число"));
			СтрокаПроекта.ПроектыПредшественники.Колонки.Добавить("ОтступУ", Новый ОписаниеТипов("Число"));
			Если СтрокаПроекта.ПроектыПредшественники.Количество() = 0 Тогда
				СтрокаПроекта.ДлительностьНарастающая = СтрокаПроекта.ДлительностьДней;
				УровеньУ = УровеньУ + 1;
			Иначе
				
				Если СтрокаПроекта.ПроектыПредшественники.Количество() = 1 Тогда
					Предпочтение =СтрокаПроекта.ПроектыПредшественники[0].СтрокаПроектаПредшественника.УровеньУ;
				Иначе
					Предпочтение = Неопределено;
				КонецЕсли;
				
				УровеньУ = ОпределитьНовуюПозициюВУровнеY(СтрокаПроекта, СтруктураХ.ЗанятыеУровниПоУ, Предпочтение);
				
				Для Индекс_1=0 ПО СтрокаПроекта.ПроектыПредшественники.Количество()-1 Цикл 
					
					СтрокаПредшественника=СтрокаПроекта.ПроектыПредшественники[Индекс_1];
					
					СтрокаПроекта.ДлительностьНарастающая = Макс(СтрокаПроекта.ДлительностьНарастающая, СтрокаПредшественника.СтрокаПроектаПредшественника.ДлительностьНарастающая + СтрокаПроекта.ДлительностьДней);
					
					СтруктураХ.ОтступХ = СтруктураХ.ОтступХ + 1;
					
					Если Не СтрокаПроекта.УровеньХ = СтрокаПредшественника.СтрокаПроектаПредшественника.УровеньХ + 1 Тогда
												
						СтруктураУ = ПолучитьДанныеУровня(Уровни.У,СтрокаПредшественника.СтрокаПроектаПредшественника.УровеньУ);
						СтруктураУ.ОтступУ = СтруктураУ.ОтступУ + 1;
						СтрокаПредшественника.ОтступУ = СтруктураУ.ОтступУ;
						
					КонецЕсли;
					
					СтрокаПредшественника.ОтступХ = СтруктураХ.ОтступХ;
					
				КонецЦикла;
				
			КонецЕсли;
				
			СтруктураУ=ПолучитьДанныеУровня(Уровни.У,УровеньУ);
				
			Если СтруктураУ = Неопределено Тогда
				СтруктураУ = Новый Структура("ОтступУ", 0);
				
				ДобавитьВТаблицуУровней(Уровни.У,УровеньУ,СтруктураУ);
				
			КонецЕсли;
			
			СтрокаПроекта.УровеньУ = УровеньУ;
			
		КонецЦикла;
		
		УровеньХ = УровеньХ + 1;
		СтрокиУровня = Проекты.НайтиСтроки(Новый Структура("УровеньХ", УровеньХ));
	КонецЦикла;
	
	Возврат Проекты;
	
КонецФункции

// Процедура выводит диаграмму проектов в поле табличного документа
//
Процедура ВывестиДиаграммуПроектов(ПолеТабличногоДокумента, Проекты, Уровни)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ЛевоПроекта = ШиринаОтступа;
	
	Для Индекс=0 ПО Уровни.Х.Количество()-1 Цикл 
		
		СтруктураХ=Уровни.Х[Индекс];
		
		Если СтруктураХ.Ключ Тогда
			ЛевоПроекта = ЛевоПроекта + Макс(СтруктураХ.Значение.ОтступХ + 1, 2) * ШиринаОтступа + ШиринаПроекта;
		КонецЕсли;
		
		СтруктураХ.Значение.Вставить("ЛевоПроекта", ЛевоПроекта);
		
	КонецЦикла;
	
	ВерхПроекта = ВысотаОтступа; 
	
	Для Индекс=0 ПО Уровни.У.Количество()-1 Цикл 
		
		СтруктураУ=Уровни.У[Индекс]; 
		
		Если СтруктураУ.Ключ Тогда
			ВерхПроекта = ВерхПроекта + Макс(ПолучитьДанныеУровня(Уровни.У,СтруктураУ.Ключ - 1).ОтступУ + 1, 1) * ВысотаОтступа + ВысотаПроекта;
		КонецЕсли;
		
		СтруктураУ.Значение.Вставить("ВерхПроекта", ВерхПроекта);
		
	КонецЦикла;
	
	Для Индекс=0 ПО Уровни.Х.Количество()-1 Цикл 
		
		СтруктураХ=Уровни.Х[Индекс];
		
		СтрокиУровня = Проекты.НайтиСтроки(Новый Структура("УровеньХ", СтруктураХ.Ключ)); 
		
		Для Индекс_1=0 ПО СтрокиУровня.Количество()-1 Цикл 
			
			СтрокаПроекта=СтрокиУровня[Индекс_1];
			
			НарисоватьСвязи(ТабличныйДокумент, СтрокаПроекта, Уровни);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ДлительностьНарастающая = 0;
	
	Для Индекс=0 ПО Уровни.Х.Количество()-1 Цикл 
		
		СтруктураХ=Уровни.Х[Индекс];
		
		СтрокиУровня = Проекты.НайтиСтроки(Новый Структура("УровеньХ", СтруктураХ.Ключ));
		
		Для Индекс_1=0 ПО СтрокиУровня.Количество()-1 Цикл 
			
			СтрокаПроекта=СтрокиУровня[Индекс_1];
			
			НарисоватьПроект(ТабличныйДокумент, СтрокаПроекта, Уровни);
			ДлительностьНарастающая = Макс(ДлительностьНарастающая, СтрокаПроекта.ДлительностьНарастающая)
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПолеТабличногоДокумента.Очистить();
	
	Макет = ПолучитьМакет("Макет");
	Макет.Параметры.ГруппаПроектов          = ГруппаПроектов;
	Макет.Параметры.ДлительностьНарастающая = ДлительностьНарастающая;
	
	ПолеТабличногоДокумента.Вывести(Макет.ПолучитьОбласть("Заголовок"));
	ПолеТабличногоДокумента.Вывести(ТабличныйДокумент);

	
КонецПроцедуры

// Процедура рисует проект на поле табличного документа
//
Процедура НарисоватьПроект(ТабличныйДокумент, СтрокаПроекта, Уровни)
	
	ВерхПроекта=ПолучитьДанныеУровня(Уровни.У,СтрокаПроекта.УровеньУ).ВерхПроекта;
	
	ЛевоПроекта=ПолучитьДанныеУровня(Уровни.Х,СтрокаПроекта.УровеньХ).ЛевоПроекта;
	
	Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямоугольник);
	Рисунок.Лево = ЛевоПроекта;
	Рисунок.Верх = ВерхПроекта;
	Рисунок.Ширина = ШиринаПроекта;
	Рисунок.Высота = ВысотаПроекта;
	
	Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 2);
	
	ВысотаСтрокиТекста = 4;
	
	Расшифровка = СтрокаПроекта.Проект;
	
	Текст = "" + СтрокаПроекта.Проект;
	Рисунок = НарисоватьТекст(ТабличныйДокумент, Текст, Расшифровка, ЛевоПроекта, ВерхПроекта, ШиринаПроекта, ВысотаСтрокиТекста * 3);
	Рисунок.Шрифт = Новый Шрифт(Рисунок.Шрифт,,,Истина);
	
	Текст = СтрШаблон(Нстр("ru = 'Длит.: %1 дн.'"), СтрокаПроекта.ДлительностьДней);
	Рисунок = НарисоватьТекст(ТабличныйДокумент, Текст, Расшифровка, ЛевоПроекта, ВерхПроекта + ВысотаСтрокиТекста * 3, ШиринаПроекта, ВысотаСтрокиТекста * 2);
	
	Текст = "" + Формат(СтрокаПроекта.ДатаНачала, "ДФ=dd.MM.yy") + "-" + Формат(СтрокаПроекта.ДатаОкончания, "ДФ=dd.MM.yy");
	Рисунок = НарисоватьТекст(ТабличныйДокумент, Текст, Расшифровка, ЛевоПроекта, ВерхПроекта + ВысотаСтрокиТекста * 5, ШиринаПроекта, ВысотаПроекта - ВысотаСтрокиТекста * 5);
	Рисунок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
	
КонецПроцедуры

// Процедура рисует связи проекта на поле табличного документа
//
Процедура НарисоватьСвязи(ТабличныйДокумент, СтрокаПроекта, Уровни)
	
	ВерхПроекта=ПолучитьДанныеУровня(Уровни.У,СтрокаПроекта.УровеньУ).ВерхПроекта;
	
	ЛевоПроекта=ПолучитьДанныеУровня(Уровни.Х,СтрокаПроекта.УровеньХ).ЛевоПроекта;
	
	Для Индекс=0 ПО СтрокаПроекта.ПроектыПредшественники.Количество()-1 Цикл 
		
		СтрокаПредшественника=СтрокаПроекта.ПроектыПредшественники[Индекс];
		
		СтрокаПроектаПредшественника = СтрокаПредшественника.СтрокаПроектаПредшественника;
		
		ВерхПредшественника=ПолучитьДанныеУровня(Уровни.У,СтрокаПроектаПредшественника.УровеньУ).ВерхПроекта;			
		ЛевоПредшественника=ПолучитьДанныеУровня(Уровни.Х,СтрокаПроектаПредшественника.УровеньХ).ЛевоПроекта;
		
		Расшифровка = Новый Структура("Проект, ПроектПредшественник", СтрокаПроекта.Проект, СтрокаПредшественника.Проект);
		Флаг = ?(СтрокаПроектаПредшественника.УровеньУ > СтрокаПроекта.УровеньУ, -1, 1);
		Если СтрокаПроектаПредшественника.УровеньХ + 1 = СтрокаПроекта.УровеньХ Тогда
			ЛевоЛинии   = ЛевоПредшественника + ШиринаПроекта;
			ВерхЛинии   = ВерхПредшественника + ВысотаПроекта / 4;
			
			НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ЛевоПроекта - ЛевоЛинии - СтрокаПредшественника.ОтступХ*ШиринаОтступа - ШиринаИзгиба, 0);
			Если СтрокаПроектаПредшественника.УровеньУ = СтрокаПроекта.УровеньУ Тогда
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, ШиринаИзгиба);
				НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, 0, ВысотаПроекта / 2 - ШиринаИзгиба * 2);
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, ШиринаИзгиба);
			Иначе
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, Флаг * ШиринаИзгиба);
				НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, 0, ВерхПроекта + ВысотаПроекта / 4 * 3 - ВерхЛинии - Флаг * ШиринаИзгиба);
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, Флаг * ШиринаИзгиба);
			КонецЕсли;
			
			НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ЛевоПроекта - ЛевоЛинии, 0);
			НарисоватьСтрелку(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии);
			
		Иначе
			
			ЛевоЛинии   = ЛевоПредшественника + ШиринаПроекта / 4 * 3;
			ВерхЛинии   = ВерхПредшественника + ВысотаПроекта;
			
			НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, 0, ВысотаОтступа* СтрокаПредшественника.ОтступУ - ШиринаИзгиба);
			НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, ШиринаИзгиба);
			
			НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ЛевоПроекта - ЛевоЛинии - СтрокаПредшественника.ОтступХ*ШиринаОтступа - ШиринаИзгиба, 0);
			
			Если СтрокаПроектаПредшественника.УровеньУ = СтрокаПроекта.УровеньУ Тогда
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, - ШиринаИзгиба);
				НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, 0, ВерхПроекта + ВысотаПроекта / 4 * 3 - ВерхЛинии + ШиринаИзгиба);
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, - ШиринаИзгиба);
			Иначе
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, Флаг * ШиринаИзгиба);
				НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, 0, ВерхПроекта + ВысотаПроекта / 4 * 3 - ВерхЛинии - Флаг * ШиринаИзгиба);
				НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаИзгиба, Флаг * ШиринаИзгиба);
			КонецЕсли;
			
			НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ЛевоПроекта - ЛевоЛинии, 0);
			НарисоватьСтрелку(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии);
			
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция выводит рисунок типа "текст" в табличный документ 
//
Функция НарисоватьТекст(ТабличныйДокумент, Текст, Расшифровка, Лево, Верх, Ширина, Высота)

	Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
	Рисунок.Лево   = Лево;
	Рисунок.Верх   = Верх;
	Рисунок.Ширина = Ширина;
	Рисунок.Высота = Высота;
	
	Рисунок.Расшифровка = Расшифровка;
	Рисунок.Текст = Текст;
	
	Возврат Рисунок;
	
КонецФункции // ()

// Функция выводит рисунок типа "линия" в табличный документ
//
Процедура НарисоватьЛинию(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаЛинии, ВысотаЛинии);
	
	Линия = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.Лево   = ЛевоЛинии;
	Линия.Верх   = ВерхЛинии;
	Линия.Ширина = ШиринаЛинии;
	Линия.Высота = ВысотаЛинии;
	
	Линия.Расшифровка = Расшифровка;
	Линия.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 2);
	
	ЛевоЛинии = ЛевоЛинии + ШиринаЛинии;
	ВерхЛинии = ВерхЛинии + ВысотаЛинии;
	
КонецПроцедуры

// Функция выводит рисунок из линий, в виде изгиба, в табличный документ
//
Процедура НарисоватьИзгиб(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии, ШиринаЛинии, ВысотаЛинии);
	
	Отступ = 0.1;
	СдвигЛево = ?(ШиринаЛинии > 0, Отступ, -Отступ);
	СдвигВерх = ?(ВысотаЛинии > 0, Отступ, -Отступ);
	
	Линия = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.Лево   = ЛевоЛинии + СдвигЛево;
	Линия.Верх   = ВерхЛинии + СдвигВерх;
	Линия.Ширина = ШиринаЛинии - СдвигЛево * 2;
	Линия.Высота = ВысотаЛинии - СдвигВерх * 2;
	
	Линия.Расшифровка = Расшифровка;
	Линия.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 2);
	
	ЛевоЛинии = ЛевоЛинии + ШиринаЛинии;
	ВерхЛинии = ВерхЛинии + ВысотаЛинии;
	
КонецПроцедуры

// Функция выводит рисунок из линий, в виде стрелки, в табличный документ
//
Процедура НарисоватьСтрелку(ТабличныйДокумент, Расшифровка, ЛевоЛинии, ВерхЛинии)
	
	Линия = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.Лево   = ЛевоЛинии - 2;
	Линия.Верх   = ВерхЛинии - 1.5;
	Линия.Ширина = 1.5;
	Линия.Высота = 1.5;
	
	Линия.Расшифровка = Расшифровка;
	Линия.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 2);
	
	Линия = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.Лево   = ЛевоЛинии - 2;
	Линия.Верх   = ВерхЛинии + 1.5;
	Линия.Ширина = 1.5;
	Линия.Высота = -1.5;
	
	Линия.Расшифровка = Расшифровка;
	Линия.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 2);
	
КонецПроцедуры

#КонецЕсли
