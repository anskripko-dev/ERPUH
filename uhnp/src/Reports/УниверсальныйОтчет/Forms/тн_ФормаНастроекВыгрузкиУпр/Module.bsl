&НаКлиенте
Процедура ОткрытьРСНастроекНажатие(Элемент)
	
	ОткрытьФорму("РегистрСведений.тн_НастройкиВыгрузкиЗатрат.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьНаКлиенте()
	
	МассивСтруктурТаблицаПодразделений = ПолучитьДанныеПоПодразделениюВыгрузки(); 
	Если МассивСтруктурТаблицаПодразделений.Количество()> 0 Тогда
		Для Каждого СтруктураПодразделение Из МассивСтруктурТаблицаПодразделений Цикл   
			ТД = Новый ТабличныйДокумент;
			СтруктураСТД = СформироватьИВыгрузитьНаСервере(СтруктураПодразделение.Подразделение, ПутьВыгрузки); 
			ТД = СтруктураСТД.ТД;
			ТД.Записать(СтруктураСТД.ПутьВыгрузкиСИменем, ТипФайлаТабличногоДокумента.XLSX);  
			
			ОбщегоНазначенияКлиент.СообщитьПользователю("Выгружено по подразделению " + СтруктураПодразделение.Подразделение);	
			
		КонецЦикла; 
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПоПодразделениюВыгрузки()
	
	МассивСтруктурТаблицаПодразделений = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тн_НастройкиВыгрузкиЗатрат.Подразделение КАК Подразделение,
	|	тн_НастройкиВыгрузкиЗатрат.Выгружать КАК Выгружать
	|ИЗ
	|	РегистрСведений.тн_НастройкиВыгрузкиЗатрат КАК тн_НастройкиВыгрузкиЗатрат
	|ГДЕ
	|	тн_НастройкиВыгрузкиЗатрат.Выгружать";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТаблицаПодразделений = РезультатЗапроса.Выбрать();
	Пока ВыборкаТаблицаПодразделений.Следующий() Цикл 
		СтруктураПодразделения = Новый Структура ("Подразделение", ВыборкаТаблицаПодразделений.Подразделение);
		МассивСтруктурТаблицаПодразделений.Добавить(СтруктураПодразделения);
	КонецЦикла;
	Возврат МассивСтруктурТаблицаПодразделений;
	
КонецФункции

&НаСервере
Функция СформироватьИВыгрузитьНаСервере(ВыбПодразделение, ПутьВыгрузки)
	
	СтруктураСТД = Новый Структура;
	ПараметрыСхемы = ВариантыОтчетов.ПараметрыФормированияОтчета();
	ПараметрыСхемы.СсылкаВарианта = ВариантОтчета;   
	ПараметрыСхемы.ИдентификаторФормы = Новый УникальныйИдентификатор();  
	ПроверятьЗаполнение  = Ложь;
	ПолучатьФлажокПустой = Ложь;    
	НастройкиКД = ВариантОтчета.Настройки.Получить();
	
	//НАЧАЛО Сафиуллина З.Р. 11.07.2025 Выполнение задач №000054354
	Если НастройкиКД = Неопределено Тогда 
		НастройкиКД = КомпоновщикНастроекОсновногоОтчета.Настройки;
		//удаляем прошлый отбор по подразделению из регистра
		ПолеОтбораПодразделение = Новый ПолеКомпоновкиДанных("Подразделение"); 
		Для Каждого ЭлементОтбора Из НастройкиКД.Отбор.Элементы Цикл
   			Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
             	И ЭлементОтбора.ЛевоеЗначение = ПолеОтбораПодразделение
				И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии
				И ЭлементОтбора.ИдентификаторПользовательскойНастройки = "" Тогда
      				НастройкиКД.Отбор.Элементы.Удалить(ЭлементОтбора);
      				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ПараметрыСхемы.СсылкаВарианта.Отчет.ПолноеИмя = "Отчет.тн_РасшифровкаПрочихРасходов" Тогда
		ПараметрыСхемы.ПользовательскиеНастройкиКД = КомпоновщикНастроекОсновногоОтчета.ПользовательскиеНастройки;
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 11.07.2025 Выполнение задач №000054354
	
	НовыйЭлементОтбора = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ПолеОтбора = Новый ПолеКомпоновкиДанных("Подразделение");
	НовыйЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
	НовыйЭлементОтбора.Использование = Истина;
	НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
	НовыйЭлементОтбора.ПравоеЗначение = ВыбПодразделение;  
	Для Каждого СтрокаОтбора Из КомпоновщикНастроекФормы.Настройки.Отбор.Элементы Цикл 
		ТакойОтборУжеЕсть = Ложь;
		Для Каждого СтрокаОтбораВарианта Из НастройкиКД.Отбор.Элементы Цикл		
			Если СтрокаОтбора.ИдентификаторПользовательскойНастройки = СтрокаОтбораВарианта.ИдентификаторПользовательскойНастройки Тогда
				ТакойОтборУжеЕсть = Истина; 
				СтрокаОтбораВарианта.Использование = СтрокаОтбора.Использование;
			КонецЕсли;		
		КонецЦикла; 
		Если НЕ ТакойОтборУжеЕсть Тогда
			НовыйЭлементОтбора = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлементОтбора, СтрокаОтбора); 
		КонецЕсли;
	КонецЦикла;	
	ПараметрыСхемы.НастройкиКД = НастройкиКД; 	
	
	СтруктураСформированногоОтчета = СформироватьОтчет(ПараметрыСхемы, ПроверятьЗаполнение, ПолучатьФлажокПустой, ВыбПодразделение); 
	ТД = СтруктураСформированногоОтчета.ТабличныйДокумент;
	Разделитель = "_";
	
	НаименованиеПодразделения = ВыбПодразделение.Наименование;
	НаименованиеПодразделения = СтрЗаменить(НаименованиеПодразделения, """", "'");
	ШаблонИмениФайла = СтрШаблон("%1 %2 %3 %4 %5", НаименованиеПодразделения, Разделитель, Формат(ЭтотОбъект.НачДата, "ДЛФ=Д"),Разделитель,Формат(ЭтотОбъект.КонДата, "ДЛФ=Д")+".xlsx");
	ПутьВыгрузкиСИменем = ПутьВыгрузки+"\"+ШаблонИмениФайла;
	СтруктураСТД.Вставить("ПутьВыгрузкиСИменем", ПутьВыгрузкиСИменем);
	СтруктураСТД.Вставить("ТД", ТД);
	Возврат СтруктураСТД;
	
КонецФункции

// Формирует отчет с указанными параметрами.
//
// Параметры:
//   Параметры - см. ПараметрыФормированияОтчета.
//   ПроверятьЗаполнение - Булево - если Истина, то перед формированием будет проведена проверка заполнения параметров отчета.
//   ПолучатьФлажокПустой - Булево - если Истина, то будет возвращен признак, сформирован ли отчет пустым.
//
// Возвращаемое значение:
//   Структура - результат формирования.
//
Функция СформироватьОтчет(Знач Параметры, Знач ПроверятьЗаполнение, Знач ПолучатьФлажокПустой, ВыбПодразделение) Экспорт
	Результат = Новый Структура("ТабличныйДокумент, Расшифровка,
		|СсылкаВарианта, СсылкаОтчета, КлючВарианта,
		|Объект, Метаданные, ПолноеИмя,
		|СхемаКД, АдресСхемы, СхемаМодифицирована, НастройкиФормы,
		|НастройкиКД, ВариантМодифицирован,
		|ПользовательскиеНастройкиКД, ПользовательскиеНастройкиМодифицированы,
		|ТекстОшибки, Успех, ДанныеЕщеОбновляются");
	
	Результат.Успех = Ложь;
	Результат.ТабличныйДокумент = Новый ТабличныйДокумент;
	Результат.ВариантМодифицирован = Ложь;
	Результат.ПользовательскиеНастройкиМодифицированы = Ложь;
	Результат.ДанныеЕщеОбновляются = Ложь;
	
	Если ПолучатьФлажокПустой Тогда
		Результат.Вставить("Пустой", Ложь);
	КонецЕсли;
	
	ПараметрыФормированияОтчета = ВариантыОтчетов.ПараметрыФормированияОтчета();
	ЗаполнитьЗначенияСвойств(ПараметрыФормированияОтчета, Параметры);
	Параметры = ПараметрыФормированияОтчета;
	
	Подключение = ?(Параметры.Подключение <> Неопределено, Параметры.Подключение, 
		ВариантыОтчетов.ПодключитьОтчетИЗагрузитьНастройки(Параметры));
	ЗаполнитьЗначенияСвойств(Результат, Подключение); // "Объект, Метаданные, ПолноеИмя, КлючВарианта, СхемаКД, АдресСхемы, СхемаМодифицирована, НастройкиФормы"
	
	Если Не Подключение.Успех Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось сформировать отчет:';
									|en = 'Cannot generate the report:'") + Символы.ПС + Подключение.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	ОтчетОбъект = Результат.Объект;
	КомпоновщикНастроекКД = ОтчетОбъект.КомпоновщикНастроек;
	
	ДопСвойства = КомпоновщикНастроекКД.ПользовательскиеНастройки.ДополнительныеСвойства;
	ДопСвойства.Вставить("КлючВарианта", Результат.КлючВарианта);
	ДопСвойства.Вставить("ИспользуемыеТаблицы", Параметры.ИспользуемыеТаблицы);
	
	Если ПроверятьЗаполнение Тогда
		ИсходныеСообщенияПользователю = ВариантыОтчетов.ПолучитьСообщенияПользователю(Истина);
		ПроверкаПройдена = ОтчетОбъект.ПроверитьЗаполнение();
		СообщенияПользователю = ВариантыОтчетов.ПолучитьСообщенияПользователю(Истина);
		
		Для Каждого Сообщение Из ИсходныеСообщенияПользователю Цикл
			Сообщение.Сообщить();
		КонецЦикла;
		
		Если Не ПроверкаПройдена Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Отчет не прошел проверку заполнения:';
										|en = 'Population check failed:'");
			Для Каждого Сообщение Из СообщенияПользователю Цикл
				Результат.ТекстОшибки = Результат.ТекстОшибки + Символы.ПС + Сообщение.Текст;
			КонецЦикла;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		ИспользуемыеТаблицы = ВариантыОтчетов.ИспользуемыеТаблицы(Результат.СхемаКД);
		ИспользуемыеТаблицы.Добавить(Результат.ПолноеИмя);
		
		Если Результат.НастройкиФормы.События.ПриОпределенииИспользуемыхТаблиц Тогда
			ОтчетОбъект.ПриОпределенииИспользуемыхТаблиц(Результат.КлючВарианта, ИспользуемыеТаблицы);
		КонецЕсли;
		
		Результат.ДанныеЕщеОбновляются = ВариантыОтчетов.ПроверитьИспользуемыеТаблицы(ИспользуемыеТаблицы, Ложь);
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось определить используемые таблицы:';
							|en = 'Cannot identify referenced tables:'");
		ТекстОшибки = ТекстОшибки + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВариантыОтчетов.ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки, Результат.СсылкаВарианта);
	КонецПопытки;
	
	ПользовательскиеНастройки = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;  
	ПараметрПериод = ПользовательскиеНастройки[0];
	ПараметрПериод.Значение.ДатаНачала = НачДата;
	ПараметрПериод.Значение.ДатаОкончания = КонДата;   
	
    ПараметрыДанныхВарианта = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы; 
	ИменаПараметров = Новый Массив;
	ИменаПараметров.Добавить("ТипОбъектаМетаданных");
	ИменаПараметров.Добавить("ИмяОбъектаМетаданных");
	ИменаПараметров.Добавить("ИмяТаблицы");	
	Для Каждого ИмяПараметра Из ИменаПараметров Цикл 
		ПараметрНастроек = ПараметрыДанныхВарианта.Найти(ИмяПараметра);
		Если ПараметрНастроек = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ПользовательскийЭлемент   Из   ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
			Если ТипЗнч(ПользовательскийЭлемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") И ПараметрНастроек.Параметр = ПользовательскийЭлемент.Параметр Тогда
				 ПользовательскийЭлемент.Значение = ПараметрНастроек.Значение ;
				КонецЕсли;
		КонецЦикла;	
	КонецЦикла; 
	
	Попытка
		ОтчетОбъект.СкомпоноватьРезультат(Результат.ТабличныйДокумент, Результат.Расшифровка);
	Исключение
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Успех = Ложь;
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Варианты отчетов.Формирование отчета';
				|en = 'Report options.Generate report'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Результат.Метаданные,
			Результат.СсылкаВарианта,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат Результат;
	КонецПопытки;
		
	Если ДопСвойства <> КомпоновщикНастроекКД.ПользовательскиеНастройки.ДополнительныеСвойства Тогда
		НовыеДопСвойства = КомпоновщикНастроекКД.ПользовательскиеНастройки.ДополнительныеСвойства;
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(НовыеДопСвойства, ДопСвойства, Ложь);
		ДопСвойства = НовыеДопСвойства;
	КонецЕсли;
	
	Модифицирован = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопСвойства, "ВариантМодифицирован");
	Если Модифицирован = Истина Тогда
		Результат.ВариантМодифицирован = Истина;
		Результат.НастройкиКД = КомпоновщикНастроекКД.Настройки;
	КонецЕсли;
	
	Модифицированы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопСвойства, "ПользовательскиеНастройкиМодифицированы");
	Если Результат.ВариантМодифицирован Или Модифицированы = Истина Тогда
		Результат.ПользовательскиеНастройкиМодифицированы = Истина;
		Результат.ПользовательскиеНастройкиКД = КомпоновщикНастроекКД.ПользовательскиеНастройки;
	КонецЕсли;
	
	Если ПолучатьФлажокПустой Тогда
		Если ДопСвойства.Свойство("ОтчетПустой") Тогда
			Пустой = ДопСвойства.ОтчетПустой;
		ИначеЕсли Результат.ТабличныйДокумент.ВысотаТаблицы = 0
			И Результат.ТабличныйДокумент.ШиринаТаблицы = 0 Тогда 
			Пустой = Истина
		Иначе
			Пустой = ОтчетыСервер.ОтчетПустой(ОтчетОбъект);
		КонецЕсли;
		Результат.Вставить("Пустой", Пустой);
	КонецЕсли;
	
	НастройкиПечати = Результат.НастройкиФормы.Печать;
	НастройкиПечати.Вставить("КлючПараметровПечати", ОтчетыКлиентСервер.КлючУникальности(Результат.ПолноеИмя, 
		Результат.КлючВарианта));
	ЗаполнитьЗначенияСвойств(Результат.ТабличныйДокумент, НастройкиПечати);
	
	// Установка колонтитулов.
	
	НастройкиКолонтитулов = Неопределено;
	Если Результат.НастройкиКД <> Неопределено Тогда 
		Результат.НастройкиКД.ДополнительныеСвойства.Свойство("НастройкиКолонтитулов", НастройкиКолонтитулов);
	КонецЕсли;
	
	НазваниеОтчета = "";
	Если ЗначениеЗаполнено(Результат.СсылкаВарианта) Тогда 
		НазваниеОтчета = Строка(Результат.СсылкаВарианта);
	ИначеЕсли Результат.Метаданные <> Неопределено Тогда 
		НазваниеОтчета = Результат.Метаданные.Синоним;
	КонецЕсли;
	
	Если Не ОбщегоНазначения.РазделениеВключено()
		Или ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда 
		
		УправлениеКолонтитулами.УстановитьКолонтитулы(Результат.ТабличныйДокумент, НазваниеОтчета,, НастройкиКолонтитулов);
	КонецЕсли;
	
	Результат.Успех = Истина;
	
	// Чистка мусора.
	
	ДопСвойства.Удалить("ВариантМодифицирован");
	ДопСвойства.Удалить("ПользовательскиеНастройкиМодифицированы");
	ДопСвойства.Удалить("КлючВарианта");
	ДопСвойства.Удалить("ОтчетПустой");
