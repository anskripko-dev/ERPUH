&НаСервере
Функция ДатаИзСтроки(Стр)
	Если СтрДлина(Стр) = 5 И СтрНайти(Стр, ".") = 3 Тогда 
		Возврат ЭтотОбъект["ОТД"].ПривестиЗначение("2020" + Прав(Стр, 2) + Лев(Стр, 2));
	Иначе 
		Возврат Неопределено;
	КонецЕсли
КонецФункции

&НаСервере
Функция ВремяИзСтроки(Стр)
	Если СтрДлина(Стр) = 5 И СтрНайти(Стр, ".") = 3 Тогда 
		Возврат ЭтотОбъект["ОТД"].ПривестиЗначение("20200101" + Лев(Стр, 2) + Прав(Стр, 2) + "00");
	Иначе 
		Возврат Неопределено;
	КонецЕсли
КонецФункции

&НаСервере
Процедура ОсобаяОбработкаЭлементов(Путь, СтрЗагружаемоеЗначение, Страница) Экспорт 
	Если Путь = "Файл/Документ/РИВ/ИнфВнесИзм/СрокВнесИзм" Тогда
		Страница.СрокВнесИзм = ДатаИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
	ИначеЕсли Путь = "Файл/Документ/РИВ/ПорВзаим/ПредДокСВК/ПорПредДок/ПорДоступИС/ДоступИСНП/ВрДостИСРаб/Начал_С" Тогда
		Страница.ВрДостИСРабНачал_С = ВремяИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
	ИначеЕсли Путь = "Файл/Документ/РИВ/ПорВзаим/ПредДокСВК/ПорПредДок/ПорДоступИС/ДоступИСНП/ВрДостИСРаб/Оконч_По" Тогда
		Страница.ВрДостИСРабОконч_По = ВремяИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
	ИначеЕсли Путь = "Файл/Документ/РИВ/ПорВзаим/ПредДокСВК/ПорПредДок/ПорДоступИС/ДоступИСНП/ВрДостИСВых/Начал_С" Тогда
		Страница.ВрДостИСВыхНачал_С = ВремяИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
	ИначеЕсли Путь = "Файл/Документ/РИВ/ПорВзаим/ПредДокСВК/ПорПредДок/ПорДоступИС/ДоступИСНП/ВрДостИСВых/Оконч_По" Тогда
		Страница.ВрДостИСВыхОконч_По = ВремяИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
	ИначеЕсли Путь = "Файл/Документ/РИВ/ПорВзаим/ПредДокСВК/ПорПредДок/ПорДоступИС/ДоступИСНП/ТехПерРаб/Начал_С" Тогда
		Страница.ТехПерРабНачал_С = ВремяИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
	ИначеЕсли Путь = "Файл/Документ/РИВ/ПорВзаим/ПредДокСВК/ПорПредДок/ПорДоступИС/ДоступИСНП/ТехПерРаб/Оконч_По" Тогда
		Страница.ТехПерРабОконч_По = ВремяИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
	ИначеЕсли Путь = "Файл/Документ/РИВ/ПорВзаим/ПредДокСВК/ПорПредДок/ПорДоступИС/ДоступИСНП/ТехПерВых/Начал_С" Тогда
		Страница.ТехПерВыхНачал_С = ВремяИзСтроки(СтрЗагружаемоеЗначение.ЗначениеЭлемента);
