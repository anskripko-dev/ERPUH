	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КПП, "КПП", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КодНО, "КодНО", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.ГодНМ, "ГодНМ", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.ГодНМ, "ГодНМ2", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Формат(Титульная.ДатаИнф, "ДФ=ddMMyyyy"), "ДатаИнф", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Формат(Титульная.ПорНом, "ЧЦ=2; ЧН=00; ЧВН="), "ПорНом", Заголовок.Области, "-");
	ЗаполнитьЗначенияСвойств(Заголовок.Параметры, ОргСведения);
	ПечатнаяФорма.Вывести(Заголовок);
	
	ПечатнаяФорма.Вывести(МакетПФ.ПолучитьОбласть("ШапкаПриложение1"));
	Строка = МакетПФ.ПолучитьОбласть("СтрокаПриложение1");
	СтруктураОтбора.ИДНаименования = "ПредДокСВК";
	СтруктураОтбора.ИмяПоля = "ВидИСОрг";
	Для Каждого Стр Из ДанныеУведомления.ДанныеМногостраничныхРазделов.ПредДокСВК Цикл 
		ПредДокСВК = Стр.Значение;
		Если Не УведомлениеОСпецрежимахНалогообложенияКлиентСервер.СтраницаЗаполнена(ПредДокСВК) Тогда 
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка.Параметры, ПредДокСВК);
