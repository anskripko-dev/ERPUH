#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДокументУправлениеЛимитами = ПолучитьДокументУправленияЛимитами();

	Если НЕ ЗначениеЗаполнено(ДокументУправлениеЛимитами) Тогда
		ВызватьИсключение НСтр("ru = 'Ошибка формирования отчета. Не указан документ ""Управление лимитами"".'"); 
	КонецЕсли;
	
	Если ДокументУправлениеЛимитами.Проведен Тогда
		ВызватьИсключение НСтр("ru = 'Ошибка формирования отчета. Для предварительного просмотра лимитов необходимо выбрать непроведенный документ ""Управление лимитами"".'"); 
	КонецЕсли;
	
	ТаблицаОперацииБюджетов =  Отчеты.ЛимитыПоДокументуУправлениеЛимитами.ПолучитьДанныеДляФормированияОтчета(ДокументУправлениеЛимитами);
	
	ВнешниеНаборыДанных = Новый Структура("ТЗ_Источник",ТаблицаОперацииБюджетов);
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ДокументРезультат.Очистить();
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
КонецПроцедуры  

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

Функция ПолучитьДокументУправленияЛимитами()
	
	ДокументУправлениеЛимитами = Документы.УправлениеЛимитами.ПустаяСсылка();
	
	Если ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Количество() > 0 Тогда
		ДокументУправлениеЛимитами = ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(0).Значение;
	КонецЕсли;	
	
	Возврат ДокументУправлениеЛимитами;
	
КонецФункции   

#КонецОбласти

#КонецЕсли 