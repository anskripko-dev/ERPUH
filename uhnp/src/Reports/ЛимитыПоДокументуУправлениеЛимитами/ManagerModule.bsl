#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс 

// Возвращает таблицу значений по текущему отчету для передачи в СКД.
Функция ПолучитьДанныеДляФормированияОтчета(ДокументУправлениеЛимитами) Экспорт
	
	ДополнительныеСвойства = Новый Структура();
	
	ДополнительныеСвойства.Вставить("ТаблицыДляДвижений", Новый Структура);
	ДополнительныеСвойства.Вставить("СтруктураВременныеТаблицы", Новый Структура("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц));
	ДополнительныеСвойства.Вставить("МетаданныеДокумента",       ДокументУправлениеЛимитами.Метаданные());
	ДополнительныеСвойства.Вставить("Ссылка",                    ДокументУправлениеЛимитами);
	Документы.УправлениеЛимитами.ИнициализироватьДанныеДокумента(ДокументУправлениеЛимитами, ДополнительныеСвойства);
		
	ТаблицаОперацииБюджетов = Новый ТаблицаЗначений();
	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния = Новый ТаблицаЗначений();
	
	Если ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаОперацииБюджетов") Тогда 
		ТаблицаОперацииБюджетов = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОперацииБюджетов;
	КонецЕсли;
	Если ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния") Тогда 
		ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния;
	КонецЕсли;
	
	ДополнитьТаблицуОперацииБюджетовДаннымиОПериодичностиИВыделитьАналитики(ТаблицаОперацииБюджетов, ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния);
	
	Возврат ТаблицаОперацииБюджетов;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;

	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.ЛимитыПоДокументуУправлениеЛимитами);
	ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, ОписаниеОтчета, Ложь);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОписаниеВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, ОписаниеОтчета, "Основной");
	ОписаниеВарианта.Описание = НСтр("ru= 'Предварительный просмотр лимитов.'");
   	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции  

Процедура ДополнитьТаблицуОперацииБюджетовДаннымиОПериодичностиИВыделитьАналитики(ТаблицаОперацииБюджетов, ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаОперацииБюджетов.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ТаблицаОперацииБюджетов.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ТаблицаОперацииБюджетов.Валюта КАК Валюта,
	|	ТаблицаОперацииБюджетов.ВидБюджета КАК ВидБюджета,
	|	ТаблицаОперацииБюджетов.ДатаРегистрации КАК ДатаРегистрации,
	|	ТаблицаОперацииБюджетов.ОбъектПланирования КАК ОбъектПланирования,
	|	ТаблицаОперацииБюджетов.Период КАК Период,
	|	ТаблицаОперацииБюджетов.ПриходРасход КАК ПриходРасход,
	|	ТаблицаОперацииБюджетов.Регистратор КАК Регистратор,
	|	ТаблицаОперацииБюджетов.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ОперацииБюджетов
	|ИЗ
	|	&ТаблицаОперацииБюджетов КАК ТаблицаОперацииБюджетов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидБюджета,
	|	Период,
	|	АналитикаСтатейБюджетов,
	|	АналитикаСтруктуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.ВидБюджета КАК ВидБюджета,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.ВидОперации КАК ВидОперации,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.НачалоПериода КАК НачалоПериода,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.Период КАК Период,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.Периодичность КАК Периодичность,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.Проект КАК Проект,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.Регистратор КАК Регистратор,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.Состояние КАК Состояние,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.Сценарий КАК Сценарий,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.УОП КАК УОП,
	|	ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния.ЦФО КАК ЦФО
	|ПОМЕСТИТЬ ВТ_УстановкаЛимитовПоДаннымБюджетированияСостояния
	|ИЗ
	|	&ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния КАК ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НачалоПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КлючиАналитикиПланированияСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	КлючиАналитикиПланированияСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|	КлючиАналитикиПланированияСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|	КлючиАналитикиПланированияСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|	КлючиАналитикиПланированияСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|	КлючиАналитикиПланированияСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|	КлючиАналитикиПланированияСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|	КлючиАналитикиПланированияСтруктуры.ЦФО КАК ЦФО,
	|	ВТ_ОперацииБюджетов.Валюта КАК Валюта,
	|	ВТ_ОперацииБюджетов.ВидБюджета КАК ВидБюджета,
	|	ВТ_ОперацииБюджетов.ДатаРегистрации КАК ДатаРегистрации,
	|	ВТ_ОперацииБюджетов.ОбъектПланирования КАК ОбъектПланирования,
	|	ВТ_ОперацииБюджетов.Период КАК Период,
	|	ВТ_ОперацииБюджетов.ПриходРасход КАК ПриходРасход,
	|	ВТ_ОперацииБюджетов.Регистратор КАК Регистратор,
	|	ВТ_ОперацииБюджетов.Сумма КАК Сумма,
	|	ВТ_УстановкаЛимитовПоДаннымБюджетированияСостояния.Периодичность КАК Периодичность,
	|	ВЫБОР ВТ_УстановкаЛимитовПоДаннымБюджетированияСостояния.Периодичность
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
	|			ТОГДА НАЧАЛОПЕРИОДА(ВТ_ОперацииБюджетов.Период, НЕДЕЛЯ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
	|			ТОГДА НАЧАЛОПЕРИОДА(ВТ_ОперацииБюджетов.Период, ДЕКАДА)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
	|			ТОГДА НАЧАЛОПЕРИОДА(ВТ_ОперацииБюджетов.Период, МЕСЯЦ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
	|			ТОГДА НАЧАЛОПЕРИОДА(ВТ_ОперацииБюджетов.Период, КВАРТАЛ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
	|			ТОГДА НАЧАЛОПЕРИОДА(ВТ_ОперацииБюджетов.Период, ПОЛУГОДИЕ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
	|			ТОГДА НАЧАЛОПЕРИОДА(ВТ_ОперацииБюджетов.Период, ГОД)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПериодЛимитирования
	|ИЗ
	|	ВТ_ОперацииБюджетов КАК ВТ_ОперацииБюджетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УстановкаЛимитовПоДаннымБюджетированияСостояния КАК ВТ_УстановкаЛимитовПоДаннымБюджетированияСостояния
	|		ПО ВТ_ОперацииБюджетов.ВидБюджета = ВТ_УстановкаЛимитовПоДаннымБюджетированияСостояния.ВидБюджета
	|			И ВТ_ОперацииБюджетов.Период = ВТ_УстановкаЛимитовПоДаннымБюджетированияСостояния.НачалоПериода
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПланированияСтатейБюджетов КАК КлючиАналитикиПланированияСтатейБюджетов
	|		ПО ВТ_ОперацииБюджетов.АналитикаСтатейБюджетов = КлючиАналитикиПланированияСтатейБюджетов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПланированияСтруктуры КАК КлючиАналитикиПланированияСтруктуры
	|		ПО ВТ_ОперацииБюджетов.АналитикаСтруктуры = КлючиАналитикиПланированияСтруктуры.Ссылка";

	Запрос.УстановитьПараметр("ТаблицаОперацииБюджетов", ТаблицаОперацииБюджетов); 
	Запрос.УстановитьПараметр("ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния", ТаблицаУстановкаЛимитовПоДаннымБюджетированияСостояния);

	ТаблицаОперацииБюджетов = Запрос.Выполнить().Выгрузить();

КонецПроцедуры
	
#КонецОбласти
#КонецЕсли