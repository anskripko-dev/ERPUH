
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; // отключаем стандартный вывод отчета - будем выводить программно 

	Настройки = КомпоновщикНастроек.ПолучитьНастройки() ;// Получаем настройки отчета 
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных; // Создаем данные расшифровки 
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных; // Создаем компоновщик макета   
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстЯнварь"));
	Параметр.Значение = НСтр("ru = 'Январь'");  
	Параметр.Использование = Истина;
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстФевраль")); 
	Параметр.Значение = НСтр("ru = 'Февраль'");   
	Параметр.Использование = Истина; 
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстМарт")); 
	Параметр.Значение = НСтр("ru = 'Март'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстАпрель")); 
	Параметр.Значение = НСтр("ru = 'Апрель'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстМай")); 
	Параметр.Значение = НСтр("ru = 'Май'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстИюнь")); 
	Параметр.Значение = НСтр("ru = 'Июнь'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстИюль")); 
	Параметр.Значение = НСтр("ru = 'Июль'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстАвгуст")); 
	Параметр.Значение = НСтр("ru = 'Август'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстСентябрь")); 
	Параметр.Значение = НСтр("ru = 'Сентябрь'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстОктябрь")); 
	Параметр.Значение = НСтр("ru = 'Октябрь'");   
	Параметр.Использование = Истина; 
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстНоябрь")); 
	Параметр.Значение = НСтр("ru = 'Ноябрь'");  
	Параметр.Использование = Истина;  
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстДекабрь")); 
	Параметр.Значение = НСтр("ru = 'Декабрь'");  
	Параметр.Использование = Истина;   
	
	// Инициализируем макет компоновки используя схему компоновки данных 
	// и созданные ранее настройки и данные расшифровки
	СхемаКомпоновкиДанных = ПолучитьМакет("Макет");
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	// Скомпонуем результат
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	ДокументРезультат.Очистить();
	
	// Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры
