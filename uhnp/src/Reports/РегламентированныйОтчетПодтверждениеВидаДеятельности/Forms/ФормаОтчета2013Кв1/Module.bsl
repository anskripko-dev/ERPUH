&НаКлиенте
Процедура ЗаполнитьАвто(Команда)
	
	Отказ = Ложь;
	
	РегламентированнаяОтчетностьКлиентПереопределяемый.ПроверитьВозможностьАвтоЗаполненияРеглОтчета(ИмяФормы, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Команда", Команда);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьАвтоЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОнлайнСервисыРегламентированнойОтчетностиКлиент.ПередЗаполнениемРегламентированногоОтчета(ОписаниеОповещения, ЭтотОбъект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвтоЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = ЗаполнитьАвтоНаСервере();
	Если НЕ РезультатВыполнения.ЗаданиеВыполнено Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьАвтоЗавершениеПослеЗаполнения", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Выполняется заполнение по данным информационной базы';
												|en = 'Выполняется заполнение по данным информационной базы'");
		ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
		Возврат;
	КонецЕсли;
	
	Если Элементы.Расшифровать.Видимость Тогда
		Элементы.Расшифровать.Доступность = Истина;
		Элементы.ТабличныйДокументКонтекстноеМенюРасшифровать.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвтоЗавершениеПослеЗаполнения(РезультатЗагрузки, ДополнительныеПараметры) Экспорт
	Доступность = Истина;
	
	Если РезультатЗагрузки = Неопределено Или РезультатЗагрузки.Статус <> "Выполнено" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось выполнить автозаполнение...';
														|en = 'Не удалось выполнить автозаполнение...'"));
		Возврат;
	КонецЕсли;
	
	ЗагрузитьПодготовленныеДанные();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПодготовленныеДанные()
	Контейнер = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если Контейнер = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Контейнер.Свойство("ТаблицаРасшифровки") Тогда 
		ПоместитьВоВременноеХранилище(Контейнер.ТаблицаРасшифровки, СтруктураРеквизитовФормы.АдресВременногоХранилищаРасшифровки);
	КонецЕсли;
	Контейнер = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Контейнер, "Контейнер", Контейнер);
	
	ЗначениеВДанныеФормы(Контейнер.Приложение2_ДанныеДопСтрок, П0000200001);
	ЗначениеВДанныеФормы(Контейнер.Приложение3_ДанныеДопСтрок, П0000300001);
	
	ЗаполнитьЗначенияСвойств(СтруктураДанныхПриложение1, Контейнер.Приложение1);
	ЗаполнитьЗначенияСвойств(СтруктураДанныхПриложение2, Контейнер.Приложение2);
	ЗаполнитьЗначенияСвойств(СтруктураДанныхПриложение3, Контейнер.Приложение3);
	
	ЗаполнитьПустыеСтруктурыДанных();
	Если П0000200001.Количество() = 0 Тогда
		П0000200001.Добавить();
	КонецЕсли;
	
	Для каждого СтрокаТЗ Из П0000200001 Цикл
		СтрокаТЗ.П000020000103 = Окр(СтрокаТЗ.П000020000103 / 1000);
		СтрокаТЗ.П000020000104 = Окр(СтрокаТЗ.П000020000104 / 1000);
	КонецЦикла;
	
	Если П0000300001.Количество() = 0 Тогда
		П0000300001.Добавить();
	КонецЕсли;
	
	ОбъектОтчета(ИмяФормы).ЗаполнитьСтруктурыДанныхРазделовЗначениямиИзДопСтрок(
		СтруктураРеквизитовФормы.мВыбраннаяФорма, Контейнер);
		
	ВывестиМакетВТаблДокНаСервере(СтруктураРеквизитовФормы.НаимТекущегоРаздела, 1);
	РасчетНаСервере(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	УстановитьВидДеятельностиВПриложениях(ЭтаФорма);
	
	Для Каждого Страница Из мДеревоСтраницОтчета.ПолучитьЭлементы() Цикл
		ВключитьПечатьЗаполненногоНеобязательногоРаздела(ЭтаФорма, Страница.ИмяСтраницы);
	КонецЦикла;
	
	Модифицированность = Истина;
	
	Если Элементы.Расшифровать.Видимость Тогда
		Элементы.Расшифровать.Доступность = Истина;
		Элементы.ТабличныйДокументКонтекстноеМенюРасшифровать.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьАвтоНаСервере()
	СохранитьДанныеРаздела(СтруктураРеквизитовФормы.НаимТекущегоРаздела, Ложь);
	СтруктураРеквизитовФормы.Вставить("АдресВременногоХранилищаРасшифровки", ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));
	ЗаполнитьПустыеСтруктурыДанных();
	
	ПараметрыОтчета = Новый Структура();
	ПараметрыОтчета.Вставить("Организация", СтруктураРеквизитовФормы.Организация);
	ПараметрыОтчета.Вставить("ДатаНачалаПериодаОтчета", СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
	ПараметрыОтчета.Вставить("ДатаКонцаПериодаОтчета",  СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	ПараметрыОтчета.Вставить("АдресВременногоХранилищаРасшифровки",  СтруктураРеквизитовФормы.АдресВременногоХранилищаРасшифровки);
	
	Контейнер = Новый Структура();
	Контейнер.Вставить("Приложение1", СтруктураДанныхПриложение1);
	Контейнер.Вставить("Приложение2", СтруктураДанныхПриложение2);
	Контейнер.Вставить("Приложение2_ДанныеДопСтрок", ДанныеФормыВЗначение(П0000200001, Тип("ТаблицаЗначений")));
	Контейнер.Вставить("Приложение3", СтруктураДанныхПриложение3);
	Контейнер.Вставить("Приложение3_ДанныеДопСтрок", ДанныеФормыВЗначение(П0000300001, Тип("ТаблицаЗначений")));
	
	ПараметрыВыполненияВФоне = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполненияВФоне.ЗапуститьВФоне = Истина;
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне("РегламентированнаяОтчетностьПереопределяемый.ЗаполнитьОтчетВФоне",
		Новый Структура("ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета, Контейнер",
		СтрРазделить(ИмяФормы, ".")[1], СтрРазделить(ИмяФормы, ".")[3], ПараметрыОтчета, Контейнер), ПараметрыВыполненияВФоне);
	
	РезультатВыполнения.Вставить("ЗаданиеВыполнено", НРег(РезультатВыполнения.Статус) = "выполнено");
	АдресХранилища       = РезультатВыполнения.АдресРезультата;
	ИдентификаторЗадания = РезультатВыполнения.ИдентификаторЗадания;
	
	Если РезультатВыполнения.ЗаданиеВыполнено Тогда
		ЗагрузитьПодготовленныеДанные();
	КонецЕсли;
	
	Возврат РезультатВыполнения;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидДеятельностиВПриложениях(Форма)
	
	НекоммерческаяОрганизация = Ложь;
	
	Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение1" Тогда
		НекоммерческаяОрганизация = ЗначениеЗаполнено(Форма.ТабличныйДокумент.Области["НекоммерческаяОрганизация"].Значение);
	ИначеЕсли Форма.СтруктураДанныхПриложение1.Свойство("НекоммерческаяОрганизация") Тогда
		НекоммерческаяОрганизация = ЗначениеЗаполнено(Форма.СтруктураДанныхПриложение1["НекоммерческаяОрганизация"]);
	КонецЕсли;
	
	ИмяГрафыПоиска = ?(НекоммерческаяОрганизация, "П000020000106", "П000020000105");
	
	СтрокаМаксимума = 0;
	ЗначениеМаксимума = Неопределено;
	НомерСтроки = 1;
	
	Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение2" Тогда
		
		Пока Форма.ТабличныйДокумент.Области.Найти("П000020000101" + Постфикс(НомерСтроки))<> Неопределено Цикл
			Графа5 = Форма.ТабличныйДокумент.Области[ИмяГрафыПоиска + Постфикс(НомерСтроки)].Значение;
			Если ЗначениеМаксимума = Неопределено Тогда
				СтрокаМаксимума = НомерСтроки;
				ЗначениеМаксимума = Графа5;
			ИначеЕсли Графа5 > ЗначениеМаксимума Тогда
				СтрокаМаксимума = НомерСтроки;
				ЗначениеМаксимума = Графа5;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		Если СтрокаМаксимума <> 0 Тогда
			ОКВЭД = Форма.ТабличныйДокумент.Области["П000020000101" + Постфикс(СтрокаМаксимума)].Значение;
			НаименованиеВЭД = Форма.ТабличныйДокумент.Области["П000020000102" + Постфикс(СтрокаМаксимума)].Значение;
		Иначе
			ОКВЭД = "";
			НаименованиеВЭД = "";
		КонецЕсли;
		
		Форма.СтруктураДанныхПриложение1.Вставить("ВидЭкономическойДеятельности", НаименованиеВЭД);
		Форма.СтруктураДанныхПриложение1.Вставить("ОКВЭД", ОКВЭД);
		
		Форма.ТабличныйДокумент.Области["НаименованиеВЭД"].Значение = НаименованиеВЭД;
		Форма.ТабличныйДокумент.Области["ОКВЭД"].Значение = ОКВЭД;
		
		Форма.СтруктураДанныхПриложение3.Вставить("ВидЭкономическойДеятельности", НаименованиеВЭД);
		Форма.СтруктураДанныхПриложение3.Вставить("ОКВЭД", ОКВЭД);
		
	ИначеЕсли Форма.СтруктураДанныхПриложение2.Количество() > 0 Тогда
		
		Для каждого СтрокаТаблицы Из Форма.П0000200001 Цикл
			Графа5 = СтрокаТаблицы[ИмяГрафыПоиска];
			Если ЗначениеМаксимума = Неопределено Тогда
				СтрокаМаксимума = НомерСтроки;
				ЗначениеМаксимума = Графа5;
			ИначеЕсли Графа5 > ЗначениеМаксимума Тогда
				СтрокаМаксимума = НомерСтроки;
				ЗначениеМаксимума = Графа5;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		Если СтрокаМаксимума <> 0 Тогда
			ОКВЭД = Форма.П0000200001[СтрокаМаксимума - 1]["П000020000101"];
			НаименованиеВЭД = Форма.П0000200001[СтрокаМаксимума - 1]["П000020000102"];
		Иначе
			ОКВЭД = "";
			НаименованиеВЭД = "";
		КонецЕсли;
		
		Форма.СтруктураДанныхПриложение2.Вставить("НаименованиеВЭД", НаименованиеВЭД);
		Форма.СтруктураДанныхПриложение2.Вставить("ОКВЭД", ОКВЭД);
		
		Форма.ТабличныйДокумент.Области["ВидЭкономическойДеятельности"].Значение = НаименованиеВЭД;
		Форма.ТабличныйДокумент.Области["ОКВЭД"].Значение = ОКВЭД;
		
		Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение1" Тогда
			
			Форма.СтруктураДанныхПриложение3.Вставить("ВидЭкономическойДеятельности", НаименованиеВЭД);
			Форма.СтруктураДанныхПриложение3.Вставить("ОКВЭД", ОКВЭД);
			
		ИначеЕсли Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение3" Тогда
			
			Форма.СтруктураДанныхПриложение1.Вставить("ВидЭкономическойДеятельности", НаименованиеВЭД);
			Форма.СтруктураДанныхПриложение1.Вставить("ОКВЭД", ОКВЭД);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расшифровать(Команда)
	
	ПараметрыОтчета = Новый Структура();
	ПараметрыОтчета.Вставить("Организация", СтруктураРеквизитовФормы.Организация);
	ПараметрыОтчета.Вставить("ДатаНачалаПериодаОтчета", СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
	ПараметрыОтчета.Вставить("ДатаКонцаПериодаОтчета", СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	
	ИДИменПоказателей = Новый Массив();
	ИДИменПоказателей.Добавить(Элементы.ТабличныйДокумент.ТекущаяОбласть.Имя);
	
	РегламентированнаяОтчетностьКлиент.ОткрытьРасшифровкуОтчета(
	ИмяОтчета(ИмяФормы), ИмяФормыОтчета(ИмяФормы), ИДИменПоказателей, ПараметрыОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура АктивизироватьЯчейку(Ячейка) Экспорт
	
	РегламентированнаяОтчетностьКлиент.АктивизироватьЯчейку(ЭтаФорма, Ячейка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПоказатель(Элемент, Область, КодПоказателя, Знач ЭтоСумма, Знач ТекстВыбора, ТаблицаВыбора, СтандартнаяОбработка, КолонкаПоиска = "Код") Экспорт
	
	Если ТаблицаВыбора = Неопределено ИЛИ СтруктураРеквизитовФормы.мАвтоВыборКодов Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Область.Имя = "НаименованиеОрганаФСС" ИЛИ Область.Имя = "КодПодчиненности" Тогда
		
		Если Область.Имя = "НаименованиеОрганаФСС" Тогда
			КолонкаПоиска = "Название";
		КонецЕсли;
		ИсходноеЗначение = СокрЛП(Область.Значение);
		
	ИначеЕсли Область.Имя = КодПоказателя ИЛИ РегламентированнаяОтчетностьКлиентСервер.МногострочнаяЧастьТекущейОбласти(
		СтруктураРеквизитовФормы, Область.Имя) <> Неопределено Тогда
		ИсходноеЗначение = ?(ТипЗнч(Область.Значение) = Тип("Строка"), СокрЛП(Область.Значение), Область.Значение);
	Иначе
		Разделитель = ?(Лев(Область.Имя, СтрДлина(КодПоказателя) + 1) = КодПоказателя + "_", "_", "");
		ИндексОбласти = 1;
		ИсходноеЗначение = "";
		Пока ЭтаФорма[ТекущийЭлемент.Имя].Области.Найти(КодПоказателя + Разделитель + Формат(ИндексОбласти, "ЧГ="))
			<> Неопределено Цикл
			ИсходноеЗначение = ИсходноеЗначение + Строка(ЭтаФорма[ТекущийЭлемент.Имя].Области[КодПоказателя
			+ Разделитель + Формат(ИндексОбласти, "ЧГ=")].Значение);
			ИндексОбласти = ИндексОбласти + 1;
		КонецЦикла;
		ИсходноеЗначение = СокрЛП(ИсходноеЗначение);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок",          ТекстВыбора);
	ПараметрыФормы.Вставить("ТаблицаЗначений",    ТаблицаВыбора);
	ПараметрыФормы.Вставить("СтруктураДляПоиска", Новый Структура(КолонкаПоиска, ИсходноеЗначение));
	
	ДополнительныеПараметры = Новый Структура(
	"ИндексОбласти, КодПоказателя, КолонкаПоиска, Область, Разделитель, Элемент",
	ИндексОбласти, КодПоказателя, КолонкаПоиска, Область, Разделитель, Элемент);
	Оп = Новый ОписаниеОповещения("ВвестиПоказательЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Обработка.ОбщиеОбъектыРеглОтчетности.Форма.ФормаВыбораЗначенияИзТаблицы",
	ПараметрыФормы, ЭтаФорма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПоказательЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	ИндексОбласти = ДополнительныеПараметры.ИндексОбласти;
	КодПоказателя = ДополнительныеПараметры.КодПоказателя;
	КолонкаПоиска = ДополнительныеПараметры.КолонкаПоиска;
	Область = ДополнительныеПараметры.Область;
	Разделитель = ДополнительныеПараметры.Разделитель;
	Элемент = ДополнительныеПараметры.Элемент;
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Область.Имя = "НаименованиеОрганаФСС" ИЛИ Область.Имя = "КодПодчиненности" Тогда
		
		ТДО = ТабличныйДокумент.Области;
		
		Обл = ТДО.Найти("КодПодчиненности");
		Если Обл <> Неопределено Тогда
			Обл.Значение = СокрЛП(РезультатВыбора["Код"]);
			Если СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение1" Тогда
				Если СтруктураДанныхПриложение3.Свойство("КодПодчиненности") Тогда
					СтруктураДанныхПриложение3["КодПодчиненности"] = СокрЛП(Обл.Значение);
				КонецЕсли;
			ИначеЕсли СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение3" Тогда
				Если СтруктураДанныхПриложение1.Свойство("КодПодчиненности") Тогда
					СтруктураДанныхПриложение1["КодПодчиненности"] = СокрЛП(Обл.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Обл = ТДО.Найти("НаименованиеОрганаФСС");
		Если Обл <> Неопределено Тогда
			Обл.Значение = СокрЛП(СтрЗаменить(РезультатВыбора["Название"], "Пустое значение", ""));
			Если СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение1" Тогда
				Если СтруктураДанныхПриложение3.Свойство("НаименованиеОрганаФСС") Тогда
					СтруктураДанныхПриложение3["НаименованиеОрганаФСС"] = СокрЛП(Обл.Значение);
				КонецЕсли;
			ИначеЕсли СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Приложение3" Тогда
				Если СтруктураДанныхПриложение1.Свойство("НаименованиеОрганаФСС") Тогда
					СтруктураДанныхПриложение1["НаименованиеОрганаФСС"] = СокрЛП(Обл.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Область.Имя = КодПоказателя ИЛИ РегламентированнаяОтчетностьКлиентСервер.МногострочнаяЧастьТекущейОбласти(
		СтруктураРеквизитовФормы, Область.Имя) <> Неопределено Тогда
		Область.Значение = РезультатВыбора[КолонкаПоиска];
	Иначе
		СтрокаРезультатВыбора = Строка(РезультатВыбора[КолонкаПоиска]);
		Для Инд = СтрДлина(СтрокаРезультатВыбора) + 1 По ИндексОбласти - 1 Цикл
			СтрокаРезультатВыбора = " " + РезультатВыбора[КолонкаПоиска];
		КонецЦикла;
		Для Инд = 1 По ИндексОбласти - 1 Цикл
			ЭтаФорма[ТекущийЭлемент.Имя].Области[КодПоказателя + Разделитель + Формат(Инд, "ЧГ=")].Значение
			= СокрЛП(Сред(РезультатВыбора[КолонкаПоиска], Инд, 1));
		КонецЦикла;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ТабличныйДокументПриИзмененииСодержимогоОбласти(Элемент, Область);
	
КонецПроцедуры

#Область ДействияСФайломПояснительнойЗаписки

&НаКлиенте
Процедура ДобавитьФайл()
	
	АдресФайла  = "";
	ВыбИмяФайла = "";
	
	Оп = Новый ОписаниеОповещения("ДобавитьФайлЗавершение", ЭтотОбъект);
	
	Попытка
		
		НачатьПомещениеФайла(Оп, АдресФайла, ВыбИмяФайла, Истина, УникальныйИдентификатор);
		
	Исключение
		
		ШаблонСообщения = НСтр("ru = 'При загрузке файла возникла ошибка.
									 |%1';
									 |en = 'При загрузке файла возникла ошибка.
									 |%1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСообщения, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПоказатьПредупреждение(, ТекстСообщения, , НСтр("ru = 'Ошибка';
														|en = 'Ошибка'"));
		
		Возврат;
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлЗавершение(Результат, АдресФайла, ВыбИмяФайла, Парам) Экспорт
	
	Если НЕ Результат Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТекстПредупреждения = "";
	
	ВозможныеРасширения = Новый Массив;
	ВозможныеРасширения.Добавить(".DOC");
	ВозможныеРасширения.Добавить(".DOCX");
	ВозможныеРасширения.Добавить(".TXT");
	ВозможныеРасширения.Добавить(".XLS");
	ВозможныеРасширения.Добавить(".XLSX");
	ВозможныеРасширения.Добавить(".PDF");
	ВозможныеРасширения.Добавить(".TIF");
	ВозможныеРасширения.Добавить(".TIFF");
	ВозможныеРасширения.Добавить(".PNG");
	ВозможныеРасширения.Добавить(".JPG");
	ВозможныеРасширения.Добавить(".JPEG");
	ВозможныеРасширения.Добавить(".BMP");
	ВозможныеРасширения.Добавить(".ZIP");
	ВозможныеРасширения.Добавить(".RAR");
	
	РасшДл4 = ВРег(Прав(ВыбИмяФайла, 4));
	РасшДл5 = ВРег(Прав(ВыбИмяФайла, 5));
	
	Если ВозможныеРасширения.Найти(РасшДл4) = Неопределено
		И ВозможныеРасширения.Найти(РасшДл5) = Неопределено Тогда
		СтрокаРасширений = СтрСоединить(ВозможныеРасширения, ",");
		СтрокаРасширений = СтрЗаменить(СтрокаРасширений, ".", " ");
		ШаблонТекста = НСтр(
			"ru = 'Файл должен иметь одно из допустимых расширений:%1';
			|en = 'Файл должен иметь одно из допустимых расширений:%1'");
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекста, СтрокаРасширений);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ДлинаРасширения = ?(ВозможныеРасширения.Найти(РасшДл4) <> Неопределено, 4, 5);
	
	Каталог = "";
	СтрокаПоиска = ВыбИмяФайла;
	
	Пока СтрДлина(СтрокаПоиска) > 0 Цикл
		Если Прав(СтрокаПоиска, 1) = "\" ИЛИ Прав(СтрокаПоиска, 1) = "/" Тогда
			Каталог = Лев(СтрокаПоиска, СтрДлина(СтрокаПоиска));
			Прервать;
		Иначе
			СтрокаПоиска = Лев(СтрокаПоиска, СтрДлина(СтрокаПоиска) - 1);
		КонецЕсли;
	КонецЦикла;
	
	ИмяФайла = СтрЗаменить(ВыбИмяФайла, Каталог, "");
	
	Попытка
		ЗаполнитьСтруктуруДанныхФайла(АдресФайла, ИмяФайла, ТекстПредупреждения);
	Исключение
		ШаблонТекста = НСтр("ru = 'При загрузке файла возникла ошибка.
		|%1';
		|en = 'При загрузке файла возникла ошибка.
		|%1'");
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекста, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПоказатьПредупреждение(, ТекстПредупреждения, , НСтр("ru = 'Ошибка';
															|en = 'Ошибка'"));
		Возврат;
	КонецПопытки;
	Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтруктуруДанныхФайла(АдресФайла, ИмяФайла, ТекстПредупреждения = "")
	
	СтруктураХранения = Новый Структура("Имя,Адрес,Размер",
		ИмяФайла, АдресФайла, РазмерФайла(АдресФайла, ИмяФайла));
	
	СтруктураРеквизитовФормы.Вставить("АдресВоВрХранилищеФайлПояснительнойЗаписки",
		ПоместитьВоВременноеХранилище(СтруктураХранения, УникальныйИдентификатор));
	
	ПереопределитьЗначенияСвойствЯчеекТабличногоДокумента(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьВременныйФайл(ИмяУдаляемогоФайла)
	
	УдаляемыйФайл = Новый Файл(ИмяУдаляемогоФайла);
	Если УдаляемыйФайл.Существует() Тогда
		УдалитьФайлы(ИмяУдаляемогоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьФайл()
	
	ОчиститьСтруктуруХраненияФайлаПояснительнойЗаписки();
	
	ПереопределитьЗначенияСвойствЯчеекТабличногоДокумента(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНаДискФайл()
	
	СтруктураХранения = ПолучитьИзВременногоХранилища(
		СтруктураРеквизитовФормы["АдресВоВрХранилищеФайлПояснительнойЗаписки"]);
	
	Попытка
		
		Если Не ЗначениеЗаполнено(СтруктураХранения["Имя"]) Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
		ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите путь для сохранения файла';
											|en = 'Выберите путь для сохранения файла'");
		
		НачатьПолучениеФайлаССервера(СтруктураХранения["Адрес"], СтруктураХранения["Имя"], ПараметрыДиалога);
		
	Исключение
		
		ШаблонТекста = НСтр("ru = 'При выгрузке файла возникла ошибка.
		|%1';
		|en = 'При выгрузке файла возникла ошибка.
		|%1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекста, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПоказатьПредупреждение(, ТекстСообщения, , НСтр("ru = 'Ошибка';
														|en = 'Ошибка'"));
		
		Возврат;
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция РазмерФайла(АдресФайла, ИмяФайла)
	
	ФайлЗагрузки = ПолучитьИмяВременногоФайла();
	ФайлЗагрузкиДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ФайлЗагрузкиДвоичныеДанные.Записать(ФайлЗагрузки);
	Файл = Новый Файл(ФайлЗагрузки);
	
	РазмерФайла = Файл.Размер();
	
	УдалитьВременныйФайл(ФайлЗагрузки);
	
	Возврат РазмерФайла;
	
КонецФункции

&НаСервере
Процедура ПереопределитьЗначенияСвойствЯчеекТабличногоДокумента(ИмяРаздела)
	
	Если ИмяРаздела = "Приложение1" Тогда
		
		СтруктураХранения = ПолучитьИзВременногоХранилища(
			СтруктураРеквизитовФормы["АдресВоВрХранилищеФайлПояснительнойЗаписки"]);
		
		Если СтруктураХранения = Неопределено Тогда
			Обл = ТабличныйДокумент.Области.Найти("ФайлПояснительнойЗаписки");
			Если Обл <> Неопределено Тогда
				Обл.Значение = "Добавить";
			КонецЕсли;
			Обл = ТабличныйДокумент.Области.Найти("УдалитьФайлПояснительнойЗаписки");
			Если Обл <> Неопределено Тогда
				Обл.Гиперссылка = Ложь;
				Обл.Текст = "";
			КонецЕсли;
		Иначе
			Обл = ТабличныйДокумент.Области.Найти("ФайлПояснительнойЗаписки");
			Если Обл <> Неопределено Тогда
				Обл.Значение = СтруктураХранения["Имя"];
			КонецЕсли;
			Обл = ТабличныйДокумент.Области.Найти("УдалитьФайлПояснительнойЗаписки");
			Если Обл <> Неопределено Тогда
				Обл.Гиперссылка = Истина;
				Обл.Текст = "х";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

