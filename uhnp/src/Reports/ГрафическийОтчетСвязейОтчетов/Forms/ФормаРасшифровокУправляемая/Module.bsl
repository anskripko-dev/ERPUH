
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СформироватьОтчет(ПолучитьИзВременногоХранилища(Параметры.мКэшРасшифровокАдрес),Параметры.ВидОтчета,Параметры.ВидОтчетаДочерний)
	
КонецПроцедуры

Процедура СформироватьОтчет(КэшРасшифровок,ВидОтчета,ВидОтчетаДочерний) 
	
	Макет = Отчеты.ГрафическийОтчетСвязейОтчетов.ПолучитьМакет("МакетРасшифровки");
	
	ТипРасшифровки = 3;
	
	НайденныеСтроки = КэшРасшифровок.НайтиСтроки(Новый Структура("ВидОтчета, ВидОтчетаДочерний", ВидОтчета, ВидОтчетаДочерний));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПравилаОбработки.Ссылка КАК ПравилоОбработкиРасшифровка,
		|	ПравилаОбработки.Представление КАК ПравилоОбработки,
		|	ОперандыПоказателей.ПотребительРасчета.Ссылка КАК ПоказательРасшифровка,
		|	ОперандыПоказателей.ПотребительРасчета.Наименование КАК Показатель,
		|	ОперандыПоказателей.Ссылка КАК ОперандРасшифровка,
		|	ОперандыПоказателей.Код КАК Операнд,
		|	ОперандыПоказателей.ПоказательОтбор.Ссылка КАК ПоказательОтборРасшифровка,
		|	ОперандыПоказателей.ПоказательОтбор.Представление КАК ПоказательОтбор
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИсточникиДанныхДляРасчетов КАК ОперандыПоказателей
		|		ПО (ОперандыПоказателей.НазначениеРасчетов = ПравилаОбработки.Ссылка)
		|ГДЕ
		|	ПравилаОбработки.Владелец = &ВидОтчетаДочерний
		|	И ОперандыПоказателей.ПоказательОтбор.Владелец = &ВидОтчета
		|	И (НЕ ОперандыПоказателей.ПометкаУдаления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПравилоОбработкиРасшифровка,
		|	ПоказательРасшифровка";
		
		Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
		Запрос.УстановитьПараметр("ВидОтчетаДочерний", ВидОтчетаДочерний);
		ТекСтрока                   = КэшРасшифровок.Добавить();
		ТекСтрока.ВидОтчета         = ВидОтчета;
		ТекСтрока.ВидОтчетаДочерний = ВидОтчетаДочерний;
		ТекСтрока.ТаблицаСоответствий = Запрос.Выполнить().Выгрузить();
		
	Иначе
		ТекСтрока = НайденныеСтроки[0];
	КонецЕсли;
	
	ТабличныйДокумент       = ПолеРасшифровки;
	ТекПравилоОбработки     = Неопределено;
	
	Если ТипРасшифровки = 3 Тогда
		ОбластьЗаголовок        = Макет.ПолучитьОбласть("Заголовок");
		ОбластьПравилоОбработки = Макет.ПолучитьОбласть("ПравилоОбработки");
		ОбластьСтроки           = Макет.ПолучитьОбласть("Строки");
	ИначеЕсли ТипРасшифровки = 1 Тогда
		ОбластьЗаголовок        = Макет.ПолучитьОбласть("Заголовок_Отчет_Источник");
		ОбластьСтроки           = Макет.ПолучитьОбласть("Строки_Отчет_Источник");
	Иначе
		ОбластьЗаголовок        = Макет.ПолучитьОбласть("Заголовок_Отчет_Приемник");
		ОбластьСтроки           = Макет.ПолучитьОбласть("Строки_Отчет_Приемник");
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.ВидОтчета = ВидОтчета.Наименование;
	ОбластьЗаголовок.Параметры.ВидОтчетаРасшифровка = ВидОтчета;
	ОбластьЗаголовок.Параметры.ВидОтчетаДочерний = ВидОтчетаДочерний.Наименование;
	ОбластьЗаголовок.Параметры.ВидОтчетаДочернийРасшифровка = ВидОтчетаДочерний;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
	Для Каждого Строка Из ТекСтрока.ТаблицаСоответствий Цикл
		
		Если ТипРасшифровки = 3 Тогда
			Если Строка.ПравилоОбработки <> ТекПравилоОбработки Тогда
				ОбластьПравилоОбработки.Параметры.Заполнить(Строка);
				ТабличныйДокумент.Вывести(ОбластьПравилоОбработки);
				ТекПравилоОбработки = Строка.ПравилоОбработки;
			КонецЕсли;
		КонецЕсли;
		
		ОбластьСтроки.Параметры.Заполнить(Строка);
		
		Если ТипРасшифровки <> 3 Тогда
			ОбластьСтроки.Параметры.ПоказательКод          = СокрЛП(Строка.ПоказательКод);
			ОбластьСтроки.Параметры.ПоказательНаименование = СокрЛП(Строка.ПоказательНаименование);
		КонецЕсли;
		
		Если ТипРасшифровки = 1 Тогда
			ОбластьСтроки.Параметры.ОперандКод          = СокрЛП(Строка.ОперандКод);
			ОбластьСтроки.Параметры.ОперандНаименование = СокрЛП(Строка.ОперандНаименование);
		ИначеЕсли ТипРасшифровки = 2 Тогда
			
			СтруктураЗаписи = Новый Структура("ВидОтчета, ВидПоказателя, Показатель, ПроизвольныйКод, Процедура"
			, ВидОтчетаДочерний
			, Строка.ВидПоказателя
			, Строка.Показатель
			, Строка.ПроизвольныйКод
			, Строка.Формула);
			ОбластьСтроки.Параметры.ФормулаРасшифровка = Новый Структура("ВидРучнойОперации, ШаблонРучнойОперации, СтруктураЗаписи"
			, Строка.ВидРучнойОперации
			, ВидОтчета
			, СтруктураЗаписи);
			ОбластьСтроки.Параметры.Дебет  = ?(Строка.Дебет, "V", "");
			ОбластьСтроки.Параметры.Кредит = ?(Строка.Кредит, "V", "");
			
		Иначе
			
			СтруктураЗаписи=Новый Структура("Показатель,ПравилоОбработки",Строка.ПоказательРасшифровка,Строка.ПравилоОбработкиРасшифровка);
			ОбластьСтроки.Параметры.ПоказательРасшифровка = СтруктураЗаписи;
			
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеРасшифровкиОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
		
	Если ТипЗнч(Расшифровка)=Тип("Структура") Тогда
		
		СтандартнаяОбработка=Ложь;
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("НазначениеРасчетов",Расшифровка.ПравилоОбработки);
		СтруктураПараметров.Вставить("ПотребительРасчета",Расшифровка.Показатель);
		СтруктураПараметров.Вставить("СпособИспользования",ПредопределенноеЗначение("Перечисление.СпособыИспользованияОперандов.ДляФормулРасчета"));
		
		ОткрытьФорму("ОбщаяФорма.ФормаНастройкиФормулРасчета",СтруктураПараметров);
		
	КонецЕсли;	
	
КонецПроцедуры
