// Выводит в табличный документ на форме надпись, информирующую, что отчёт не сформирован.
&НаКлиенте
Функция ОтобразитьНадписьОтчетНеСформирован()
	Элементы.Результат.ОтображениеСостояния.Текст = НСтр("ru = 'Отчет не сформирован. Нажмите ""Сформировать"" для получения отчета.'");
	Элементы.Результат.ОтображениеСостояния.Видимость = Истина; 	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Получение параметров.
	Если ЗначениеЗаполнено(Параметры.Мероприятие) Тогда
		Отчет.Мероприятие = Параметры.Мероприятие;
	Иначе
		// Параметр не установлен. Пропускаем.
	КонецЕсли;
	ФормироватьАвтоматически = Параметры.ФормироватьАвтоматически;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если (ФормироватьАвтоматически) И (ЗначениеЗаполнено(Отчет.Мероприятие)) Тогда
		СкомпоноватьРезультат();
	Иначе
		// Не требуется автоматического формирования отчета. Ничего не делаем.
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура МероприятиеПриИзменении(Элемент)
	ОтобразитьНадписьОтчетНеСформирован();
КонецПроцедуры
