#Область ОбработчикиСобытий   

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТаблицаДанныхОтчета = ПолучитьДанные_Сервер(Мероприятие);
	ДанныеРасшифровки = Неопределено;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетДокумента = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	НовыеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(МакетДокумента, НовыеНастройки, ДанныеРасшифровки);
	ВнешниеДанные = Новый Структура;
	ВнешниеДанные.Вставить("ТЗ_ДанныеСтадий", ТаблицаДанныхОтчета);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеДанные, ДанныеРасшифровки);
	ДокументРезультат.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
КонецПроцедуры

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции


// Возвращает таблицу, содержащую плановые даты стадий по мероприятию
// МероприятиеВход.
Функция ПолучитьТаблицуПланПоМероприятию(МероприятиеВход, ТаблицаФакт)
	РезультатФункции = Новый ТаблицаЗначений;
	РезультатФункции.Колонки.Добавить("Стадия");
	РезультатФункции.Колонки.Добавить("ДатаНачалаПлан");
	Если ЗначениеЗаполнено(МероприятиеВход.ШаблонМероприятия) И ЗначениеЗаполнено(МероприятиеВход.ДатаНачала) Тогда   
		
		Если ТаблицаФакт.Количество() Тогда
			ТекДата = ТаблицаФакт[0].ДатаНачалаФакт;
		Иначе
			ТекДата = МероприятиеВход.ДатаНачала;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ТаблицаФакт", ТаблицаФакт.Скопировать());
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ШаблоныМероприятийСтадии.Ссылка КАК Мероприятие,
		|	ШаблоныМероприятийСтадии.Стадия КАК Стадия,
		|	ШаблоныМероприятийСтадии.Стадия.Длительность КАК Длительность,
		|	ТаблицаФакт.ДатаНачалаФакт КАК ДатаНачалаФакт
		|ИЗ
		|	Справочник.ШаблоныМероприятий.Стадии КАК ШаблоныМероприятийСтадии
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаФакт КАК ТаблицаФакт
		|		ПО ШаблоныМероприятийСтадии.Стадия = ТаблицаФакт.Стадия
		|ГДЕ
		|	ШаблоныМероприятийСтадии.Ссылка = &ШаблонМероприятия
		|	И НЕ ШаблоныМероприятийСтадии.ГруппирующаяСтрока
		|	И ШаблоныМероприятийСтадии.Стадия В
		|			(ВЫБРАТЬ
		|				ТаблицаФакт.Стадия
		|			ИЗ
		|				ТаблицаФакт КАК ТаблицаФакт)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаФакт.ДатаНачалаФакт";
		Запрос.УстановитьПараметр("ШаблонМероприятия", МероприятиеВход.ШаблонМероприятия);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НоваяСтрока = РезультатФункции.Добавить();
			НоваяСтрока.Стадия			 = ВыборкаДетальныеЗаписи.Стадия;
			НоваяСтрока.ДатаНачалаПлан	 = ТекДата;
			Сдвиг = ВыборкаДетальныеЗаписи.Длительность*60*60*24;
			ТекДата = ТекДата + Сдвиг;
		КонецЦикла;
	Иначе
		// Недостаточно исходных данных. Плана нет, вернём пустую таблицу.
	КонецЕсли;	
	Возврат РезультатФункции;	
КонецФункции		// ПолучитьТаблицуПланПоМероприятию()

// Возвращает таблицу, содержащую фактические даты стадий по мероприятию
// МероприятиеВход.
Функция ПолучитьТаблицуФактПоМероприятию(МероприятиеВход)  
	
	РезультатФункции = Новый ТаблицаЗначений;
	РезультатФункции.Колонки.Добавить("Стадия");
	РезультатФункции.Колонки.Добавить("ДатаНачалаФакт", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));  
	
	МассивСтадийПодготовка = ВернутьСтадииНачалоПодготовкиЗакупкиКПубликации(); 
	МассивСтадийОфициальноеОбъявление = ВернутьСтадииОфициальноеОбъявлениеЗакупки();
	
	Для Каждого ТекСтадии Из МероприятиеВход.Стадии Цикл
		Если НЕ ТекСтадии.ГруппирующаяСтрока И ДатыСтадийОпределеныВЗакупочнойПроцедуре(ТекСтадии.Действие, МассивСтадийПодготовка, МассивСтадийОфициальноеОбъявление) = Ложь Тогда
			НоваяСтрока = РезультатФункции.Добавить();
			НоваяСтрока.Стадия			 = ТекСтадии.Действие;
			НоваяСтрока.ДатаНачалаФакт	 = ТекСтадии.ДатаИзменения;
		Иначе
			// Пропускаем группу.
		КонецЕсли;
	КонецЦикла;	 
	РезультатФункции.Сортировать("ДатаНачалаФакт"); 
	Возврат РезультатФункции;	
КонецФункции		// ПолучитьТаблицуФактПоМероприятию()

Функция НайтиМинимальнуюДатуСтадии(ТаблицаИтоговаяВход, СтадияВход)
	РезультатФункции = Дата(1, 1, 1);
	Для Каждого ТекТаблицаИтоговаяВход Из ТаблицаИтоговаяВход Цикл
		СтадииСовпадают = (ТекТаблицаИтоговаяВход.Стадия = СтадияВход);
		СтадияЗаполнена = ЗначениеЗаполнено(ТекТаблицаИтоговаяВход.Стадия);
		ДатаПланЗаполнена = ЗначениеЗаполнено(ТекТаблицаИтоговаяВход.ДатаНачалаПлан);
		ДатаФактЗаполнена = ЗначениеЗаполнено(ТекТаблицаИтоговаяВход.ДатаНачалаФакт);
		Если (СтадияЗаполнена) И (СтадииСовпадают) И (ДатаПланЗаполнена) И (НЕ ДатаФактЗаполнена) Тогда
			РезультатФункции = ТекТаблицаИтоговаяВход.ДатаНачалаПлан;
			Прервать;		// Значение найдено.
		Иначе
			// Выполняем поиска далее.
		КонецЕсли;
	КонецЦикла;	
	Возврат РезультатФункции;
КонецФункции		// НайтиМинимальнуюДатуСтадии()

// Возвращает таблицу данных для вывода отчета по мероприятию МероприятиеВход.
Функция ПолучитьДанные_Сервер(МероприятиеВход)
	// Инициализация.
	РезультатФункции = Новый ТаблицаЗначений;
	РезультатФункции.Колонки.Добавить("Стадия");	
	РезультатФункции.Колонки.Добавить("ДатаНачалаПлан");	
	РезультатФункции.Колонки.Добавить("ДатаНачалаФакт");	
	РезультатФункции.Колонки.Добавить("ДатаНачалаЗапись");	
	РезультатФункции.Колонки.Добавить("ОтставаниеНач");	
	РезультатФункции.Колонки.Добавить("ОтставаниеКон");	
	ПустаяДата = Дата(1, 1, 1);
	// Получение данных по плану и факту.
	
	ТаблицаФакт = ПолучитьТаблицуФактПоМероприятию(МероприятиеВход);
	ТаблицаПлан = ПолучитьТаблицуПланПоМероприятию(МероприятиеВход, ТаблицаФакт);
	
	ТаблицаПлан.Сортировать("ДатаНачалаПлан Возр");
	// Разнесение факта на план.
	ТаблицаИтоговая = ТаблицаПлан.Скопировать();
	ТаблицаИтоговая.Колонки.Добавить("ДатаНачалаФакт");
	ТаблицаИтоговая.Колонки.Добавить("ОтставаниеНач");	
	ТаблицаИтоговая.Колонки.Добавить("ОтставаниеКон");	
	ТаблицаИтоговая.ЗаполнитьЗначения(ПустаяДата, "ДатаНачалаФакт"); 
	Для Каждого ТекТаблицаФакт Из ТаблицаФакт Цикл
		// Поиск стадии в плане.
		МинимальнаяНайденнаяДата = НайтиМинимальнуюДатуСтадии(ТаблицаИтоговая, ТекТаблицаФакт.Стадия);
		// Добавление фактической даты.
		Если ЗначениеЗаполнено(МинимальнаяНайденнаяДата) Тогда
			// Дата план найдена. Добавим дату факт в эту дату.
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Стадия", ТекТаблицаФакт.Стадия);
			СтруктураПоиска.Вставить("ДатаНачалаПлан", МинимальнаяНайденнаяДата);
			НайденныеСтроки = ТаблицаИтоговая.НайтиСтроки(СтруктураПоиска);
			Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
				ТекНайденныеСтроки.ДатаНачалаФакт = ТекТаблицаФакт.ДатаНачалаФакт;
			КонецЦикла;	
		Иначе
			// Дата план не найдена. Добавим стадию в конец таблицы.
			НоваяСтрока = ТаблицаИтоговая.Добавить();
			НоваяСтрока.Стадия			 = ТекТаблицаФакт.Стадия;
			НоваяСтрока.ДатаНачалаПлан	 = ПустаяДата;
			НоваяСтрока.ДатаНачалаФакт	 = ТекТаблицаФакт.ДатаНачалаФакт;
		КонецЕсли;
	КонецЦикла;	
	// Постобработка полученной таблицы и вывод результата.
	ТаблицаИтоговая.Колонки.Добавить("ДатаНачалаЗапись");
	ТаблицаИтоговая.ЗаполнитьЗначения(ПустаяДата, "ДатаНачалаЗапись");
	Для Каждого ТекТаблицаИтоговая Из ТаблицаИтоговая Цикл
		ТекДатаНачалаПлан = ТекТаблицаИтоговая.ДатаНачалаПлан;
		ТекДатаНачалаФакт = ТекТаблицаИтоговая.ДатаНачалаФакт;
		// Заполнение поля Дата начала запись.
		Если ЗначениеЗаполнено(ТекДатаНачалаФакт) Тогда
			ТекТаблицаИтоговая.ДатаНачалаЗапись = ТекДатаНачалаФакт;
		Иначе
			ТекТаблицаИтоговая.ДатаНачалаЗапись = ТекДатаНачалаПлан;
		КонецЕсли; 
		// Заполнение поля Отставание.
		Если ЗначениеЗаполнено(ТекДатаНачалаПлан) И ЗначениеЗаполнено(ТекДатаНачалаФакт) Тогда
			ТекТаблицаИтоговая.ОтставаниеНач = 0;	
			ТекТаблицаИтоговая.ОтставаниеКон = Окр((ТекДатаНачалаФакт - ТекДатаНачалаПлан)/(24*60*60));
		Иначе
			ТекТаблицаИтоговая.ОтставаниеНач = 0;	
			ТекТаблицаИтоговая.ОтставаниеКон = 0;	
		КонецЕсли;
	КонецЦикла;	
	ТаблицаИтоговая.Сортировать("ДатаНачалаЗапись Возр");	
	РезультатФункции = ТаблицаИтоговая.Скопировать();
	Возврат РезультатФункции;
КонецФункции		// ПолучитьДанные_Сервер()

Процедура ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Объект, ИмяВТ, Таблица)
	
	КолонкиУдаление = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл  	
		Если Колонка.ТипЗначения = Новый ОписаниеТипов Тогда
			КолонкиУдаление.Добавить(Колонка.Имя);	
		КонецЕсли;   	
	КонецЦикла; 
	
	Если Не КолонкиУдаление.Количество() = 0 Тогда
		ОписаниеТиповЛюбаяСсылка = ПолучитьОписаниеТиповЛюбаяСсылка();
		Для Каждого Колонка Из КолонкиУдаление Цикл  
			Таблица.Колонки.Добавить(Колонка + "_1", ОписаниеТиповЛюбаяСсылка);
			Таблица.ЗагрузитьКолонку(Таблица.ВыгрузитьКолонку(Колонка), Колонка + "_1");
			Таблица.Колонки.Удалить(Колонка);  
			Таблица.Колонки[Колонка + "_1"].Имя = Колонка;
		КонецЦикла;  
	КонецЕсли;
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("Запрос") Тогда
		Запрос = Объект;
		Если Запрос.МенеджерВременныхТаблиц = неопределено Тогда
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		КонецЕсли;
	ИначеЕсли ТипОбъекта = Тип("МенеджерВременныхТаблиц") Тогда
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Объект;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ * ПОМЕСТИТЬ "+ИмяВТ+" ИЗ &Таблица КАК Таблица";
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.Выполнить();
	
КонецПроцедуры    

Функция ПолучитьОписаниеТиповЛюбаяСсылка()

	ДобавляемыеТипы = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, Справочники.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, Документы.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, Перечисления.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, ПланыСчетов.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, Задачи.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, ПланыВидовРасчета.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДобавляемыеТипы, ПланыОбмена.ТипВсеСсылки().Типы());
	
	ОписаниеТипов = Новый ОписаниеТипов;		
	ОписаниеТипов = Новый ОписаниеТипов(ОписаниеТипов, ДобавляемыеТипы);  
	
	Возврат ОписаниеТипов;

КонецФункции 

// Проверяет, определены ли даты стадии СтадияВход в контексте закупочной процедуры.
Функция ДатыСтадийОпределеныВЗакупочнойПроцедуре(СтадияВход, МассивСтадийПодготовка, МассивСтадийОфициальноеОбъявление) Экспорт    
	
	РезультатФункции = Ложь;
	// Подготовка закупки.
	
	Если МассивСтадийПодготовка.Найти(СтадияВход) <> Неопределено Тогда
		РезультатФункции = Истина;
	Иначе
		// Проверка пройдена.
	КонецЕсли;          
	
	// Официальное объявление.
	Если МассивСтадийОфициальноеОбъявление.Найти(СтадияВход) <> Неопределено Тогда
		РезультатФункции = Истина;
	Иначе
		// Проверка пройдена.
	КонецЕсли;   
	
	Возврат РезультатФункции; 
	
КонецФункции        

// Возвращает предопределенные стадии, связанные с официальным объявлением закупки.
Функция ВернутьСтадииОфициальноеОбъявлениеЗакупки() Экспорт
	РезультатФункции = Новый Массив;                                         
	РезультатФункции.Добавить(Справочники.СтадииМероприятий.Аукцион_ОфициальноеОбъявлениеЗакупки);
	РезультатФункции.Добавить(Справочники.СтадииМероприятий.ЗакупкаУЕдинственногоПоставщика_ОфициальноеОбъявлениеЗакупки);
	РезультатФункции.Добавить(Справочники.СтадииМероприятий.ЗапросКотировок_ОфициальноеОбъявлениеЗакупки);
	РезультатФункции.Добавить(Справочники.СтадииМероприятий.ЗапросПредложений_ОфициальноеОбъявлениеЗакупки);
	РезультатФункции.Добавить(Справочники.СтадииМероприятий.КвалификационныйОтбор_ОфициальноеОбъявлениеЗакупки);
	РезультатФункции.Добавить(Справочники.СтадииМероприятий.КонкурентныеПереговоры_ОфициальноеОбъявлениеЗакупки);
