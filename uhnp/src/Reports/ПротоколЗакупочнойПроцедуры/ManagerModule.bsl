		|
		|УПОРЯДОЧИТЬ ПО
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.СуммаДокумента";
	
	Запрос.УстановитьПараметр("Ссылка", ПротоколСсылка);
	РезультатЗапроса = Запрос.Выполнить();
