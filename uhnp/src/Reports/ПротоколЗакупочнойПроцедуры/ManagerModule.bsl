								СтрокаРаспределенияПобедителейЗонтичнойЗакупки.Параметры.Победитель = СОКРЛП(ТекВыгрузка.Поставщик) +", Номер заявки:" + СОКРЛП(ТекВыгрузка.Номер);
								СтрокаРаспределенияПобедителейЗонтичнойЗакупки.Параметры.ЦенаЗаявки	= ТекВыгрузка.СуммаДокумента;
								ЗапросМестПоЛотам = Новый Запрос;
								ЗапросМестПоЛотам.УстановитьПараметр("Лот",ТекТаблицаСвертка.Лот);
								ЗапросМестПоЛотам.УстановитьПараметр("Номенклатура",ТекВыгрузка.Номенклатура);
								ЗапросМестПоЛотам.УстановитьПараметр("МестоПоставки",ТекВыгрузка.МестоПоставки);
								ЗапросМестПоЛотам.УстановитьПараметр("ЕдиницаИзмерения",ТекВыгрузка.ЕдиницаИзмерения);
								ЗапросМестПоЛотам.УстановитьПараметр("Характеристика",ТекВыгрузка.Характеристика);
								ЗапросМестПоЛотам.УстановитьПараметр("МестоПобедителя",МестоПобедителя);
								ЗапросМестПоЛотам.Текст =  "ВЫБРАТЬ
								                           |	СУММА(ЛотыУсловияРаспределенияЗонтичнойЗакупки.Количество) КАК Количество,
								                           |	ЛотыУсловияРаспределенияЗонтичнойЗакупки.Процент КАК Процент
								                           |ИЗ
								                           |	Документ.Лот.УсловияРаспределенияЗонтичнойЗакупки КАК ЛотыУсловияРаспределенияЗонтичнойЗакупки
								                           |ГДЕ
								                           |	ЛотыУсловияРаспределенияЗонтичнойЗакупки.Ссылка = &Лот
								                           |	И ЛотыУсловияРаспределенияЗонтичнойЗакупки.Номенклатура = &Номенклатура
								                           |	И ЛотыУсловияРаспределенияЗонтичнойЗакупки.МестоПоставки = &МестоПоставки
								                           |	И ЛотыУсловияРаспределенияЗонтичнойЗакупки.ЕдиницаИзмерения = &ЕдиницаИзмерения
								                           |	И ЛотыУсловияРаспределенияЗонтичнойЗакупки.Характеристика = &Характеристика
								                           |	И ЛотыУсловияРаспределенияЗонтичнойЗакупки.МестоПобедителя = &МестоПобедителя
								                           |    И ЛотыУсловияРаспределенияЗонтичнойЗакупки.Ссылка.Проведен
								                           |СГРУППИРОВАТЬ ПО
								                           |	ЛотыУсловияРаспределенияЗонтичнойЗакупки.Процент";
								ВыборкаПобедителей = ЗапросМестПоЛотам.Выполнить().Выбрать();
								Пока ВыборкаПобедителей.Следующий() Цикл 
									СтрокаРаспределенияПобедителейЗонтичнойЗакупки.Параметры.КоличествоПроцент = ?(ТипЗнч(ТекВыгрузка.Номенклатура) = Тип("СправочникСсылка.Номенклатура"),ВыборкаПобедителей.Количество,Строка(ВыборкаПобедителей.Процент)+"%");	
								КонецЦикла;	

								ТД.Вывести(СтрокаРаспределенияПобедителейЗонтичнойЗакупки);
								МестоПобедителя = МестоПобедителя + 1;
								Если МестоПобедителя > ТекВыгрузка.Лот.КоличествоПобедителейЗонтичнойЗакупки Тогда
									Прервать;
								КонецЕсли;	
								
							КонецЕсли;
						КонецЦикла;
						
						ТД.Область(НомерСтрокиНачало, 2, ТД.ВысотаТаблицы,4).Объединить();
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
		КонецЕсли;
		
		
КонецПроцедуры	


Процедура ЗаполнитьТаблицуПредложенийПоставщиков(Лот, ВыводитьНоменклатуру, ТД, УчастникиЗаявка,
		УчастникиНоменклатураЗаголовок, УчастникиНоменклатура, УчастникиНоменклатураПодвал,
		УчастникиОтсутствуют)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПредложениеПоставщика.Номер КАК Номер,
		|	ПредложениеПоставщика.Дата КАК Дата,
		|	ПредложениеПоставщика.Контрагент,
		|	ВЫБОР
		|		КОГДА ПредложениеПоставщика.ЦенаВключаетНДС
		|			ТОГДА ПредложениеПоставщика.СуммаДокумента
		|		ИНАЧЕ ПредложениеПоставщика.СуммаДокумента + ПредложениеПоставщика.СуммаНДС
		|	КОНЕЦ КАК СуммаДокумента,
		|	ПредложениеПоставщика.УсловияПоставки,
		|	ПредложениеПоставщика.УсловияОплаты,
		|	ПредложениеПоставщика.СрокПоставки,
		|	ПредложениеПоставщика.СрокиВыполненияДоговора,
		|	ПредложениеПоставщика.Ссылка КАК Ссылка,
		|	ПредложениеПоставщика.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
		|	ПредложениеПоставщика.ВалютаДокумента КАК ВалютаДокумента
		|ИЗ
		|	Документ.ПредложениеПоставщика КАК ПредложениеПоставщика
		|ГДЕ
		|	ПредложениеПоставщика.Проведен
		|	И ПредложениеПоставщика.ДопущенКУчастию
		|	И ПредложениеПоставщика.Лот = &Лот
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Номер; ";
		
	Если ВыводитьНоменклатуру Тогда
		Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.Ссылка КАК Ссылка,
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.Номенклатура КАК Номенклатура,
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	СУММА(ПредложениеПоставщикаУсловияПоНоменклатуре.Количество) КАК Количество,
			|	СУММА(ПредложениеПоставщикаУсловияПоНоменклатуре.Сумма) КАК Сумма,
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.СтавкаНДС КАК СтавкаНДС,
			|	СУММА(ПредложениеПоставщикаУсловияПоНоменклатуре.СуммаНДС) КАК СуммаНДС
			|ИЗ
			|	Документ.ПредложениеПоставщика.УсловияПоНоменклатуре КАК ПредложениеПоставщикаУсловияПоНоменклатуре
			|ГДЕ
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.Ссылка.Лот = &Лот
			|	И ПредложениеПоставщикаУсловияПоНоменклатуре.Ссылка.Проведен
			|	И ПредложениеПоставщикаУсловияПоНоменклатуре.Ссылка.ДопущенКУчастию
			|
			|СГРУППИРОВАТЬ ПО
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.Ссылка,
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.Номенклатура,
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.ЕдиницаИзмерения,
			|	ПредложениеПоставщикаУсловияПоНоменклатуре.СтавкаНДС
			|ИТОГИ ПО
			|	Ссылка";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Лот", Лот);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать();
	
	Если ВыводитьНоменклатуру Тогда
		ВыборкаНоменклатуры = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	Если РезультатЗапроса[0].Пустой() И Лот.ТребуетсяКвалификационныйОтбор Тогда
		ТД.Вывести(УчастникиОтсутствуют);
		Возврат;
	КонецЕсли;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		УчастникиЗаявка.Параметры.НомерЗаявки = ВыборкаДетальныеЗаписи.Номер;
		УчастникиЗаявка.Параметры.ДатаЗаявки = Формат(ВыборкаДетальныеЗаписи.Дата, "ДФ=dd.MM.yyyy");
		УчастникиЗаявка.Параметры.Участник = ПредставлениеПоставщикаДляОтчета(ВыборкаДетальныеЗаписи.Контрагент);
		УчастникиЗаявка.Параметры.ЦенаЗаявки = Строка(ВыборкаДетальныеЗаписи.СуммаДокумента) + " " + ВыборкаДетальныеЗаписи.ВалютаДокумента;
		УчастникиЗаявка.Параметры.УсловияПоставки = ВыборкаДетальныеЗаписи.УсловияПоставки;
		УчастникиЗаявка.Параметры.СрокиВыполненияДоговора = ВыборкаДетальныеЗаписи.СрокиВыполненияДоговора;
		УчастникиЗаявка.Параметры.СрокиПоставки = ?(ВыборкаДетальныеЗаписи.СрокПоставки>0,Строка(ВыборкаДетальныеЗаписи.СрокПоставки)+" дней","");
		УчастникиЗаявка.Параметры.УсловияОплаты = ВыборкаДетальныеЗаписи.УсловияОплаты;
		ТД.Вывести(УчастникиЗаявка);
		
		Если ВыводитьНоменклатуру Тогда
			ТД.Вывести(УчастникиНоменклатураЗаголовок);
			
			НомерСтроки = 1;
			ЦенаВключаетНДС = ВыборкаДетальныеЗаписи.ЦенаВключаетНДС;
			ВыборкаНоменклатуры.Сбросить();
			ВыборкаНоменклатуры.НайтиСледующий(ВыборкаДетальныеЗаписи.Ссылка, "Ссылка");
			ВыборкаНоменклатурыДетальныеЗаписи = ВыборкаНоменклатуры.Выбрать(ОбходРезультатаЗапроса.Прямой);
			Пока ВыборкаНоменклатурыДетальныеЗаписи.Следующий() Цикл
				УчастникиНоменклатура.Параметры.НомерНоменклатуры = НомерСтроки;
				УчастникиНоменклатура.Параметры.Номенклатура = ВыборкаНоменклатурыДетальныеЗаписи.Номенклатура;
				УчастникиНоменклатура.Параметры.ЕдиницаИзмерения = ВыборкаНоменклатурыДетальныеЗаписи.ЕдиницаИзмерения;
				УчастникиНоменклатура.Параметры.Количество = ВыборкаНоменклатурыДетальныеЗаписи.Количество;
				УчастникиНоменклатура.Параметры.СтавкаНДС = ВыборкаНоменклатурыДетальныеЗаписи.СтавкаНДС;
				УчастникиНоменклатура.Параметры.СуммаНДС = ВыборкаНоменклатурыДетальныеЗаписи.СуммаНДС;
				УчастникиНоменклатура.Параметры.Сумма = ВыборкаНоменклатурыДетальныеЗаписи.Сумма;
				Если НЕ ЦенаВключаетНДС Тогда
					УчастникиНоменклатура.Параметры.Сумма = УчастникиНоменклатура.Параметры.Сумма + ВыборкаНоменклатурыДетальныеЗаписи.СуммаНДС;
				КонецЕсли;
				
				ТД.Вывести(УчастникиНоменклатура);
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
			
			ТД.Вывести(УчастникиНоменклатураПодвал);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьТаблицуПобедителейВыборПоКритериям(ПротоколСсылка, Лот, ТД, ПобедительСтрока)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоставщикиПоЛотам.ПредложениеПоставщика.Контрагент КАК Поставщик,
	               |	ПоставщикиПоЛотам.ПредложениеПоставщика.Номер КАК Номер,
	               |	ПоставщикиПоЛотам.ПредложениеПоставщика.Дата КАК Дата,
	               |	СУММА(ПоставщикиПоЛотам.Сумма) КАК СуммаДокумента,
	               |	ПоставщикиПоЛотам.Лот.ВалютаДокумента КАК ЛотВалютаДокумента
	               |ИЗ
	               |	РегистрСведений.ПоставщикиПоЛотам КАК ПоставщикиПоЛотам
	               |ГДЕ
	               |	ПоставщикиПоЛотам.Лот = &Лот
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоставщикиПоЛотам.ПредложениеПоставщика.Номер,
	               |	ПоставщикиПоЛотам.ПредложениеПоставщика.Контрагент,
	               |	ПоставщикиПоЛотам.ПредложениеПоставщика.Дата,
	               |	ПоставщикиПоЛотам.Лот.ВалютаДокумента";
	Запрос.УстановитьПараметр("Лот", Лот);
	Запрос.УстановитьПараметр("ПротоколСсылка", ПротоколСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.Прямой);
	Место = 1;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПобедительСтрока.Параметры.Победитель = ВыборкаДетальныеЗаписи.Поставщик;
		ПобедительСтрока.Параметры.НомерЗаявки = ВыборкаДетальныеЗаписи.Номер;
		ПобедительСтрока.Параметры.ДатаЗаявки = Формат(ВыборкаДетальныеЗаписи.Дата, "ДФ=dd.MM.yyyy");
		ПобедительСтрока.Параметры.ЦенаЗаявки = ВыборкаДетальныеЗаписи.СуммаДокумента;     
		ПобедительСтрока.Параметры.Валюта = ВыборкаДетальныеЗаписи.ЛотВалютаДокумента;
		
		ТД.Вывести(ПобедительСтрока);
		Место = Место + 1;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьТаблицуПобедителейВыборПоЦенам(ПротоколСсылка, Лот, ТД, ПобедительСтрока)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Поставщик КАК Поставщик,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Место КАК Место,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика КАК ПредложениеПоставщика,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Номер КАК Номер,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Дата КАК Дата,
		|	СУММА(ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.СуммаДокумента) КАК СуммаДокумента,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот КАК Лот,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот.ВалютаДокумента КАК ЛотВалютаДокумента
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ПротоколВыбораПобедителей.ПредложенияПобедителей КАК ПротоколВыбораПобедителейПредложенияПобедителей
		|ГДЕ
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Ссылка = &ПротоколСсылка
		|	И ПротоколВыбораПобедителейПредложенияПобедителей.Лот = &Лот
		|	И ПротоколВыбораПобедителейПредложенияПобедителей.Победитель = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Место,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Поставщик,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Номер,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Дата,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот.ВалютаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Место КАК Место,
		|	ВТ.Поставщик КАК Поставщик,
		|	СУММА(ПротоколВыбораПобедителейРаспределениеПоПотребностям.Сумма) КАК СуммаДокумента,
		|	ВТ.Номер КАК Номер,
		|	ВТ.Дата КАК Дата,
		|	ВТ.ЛотВалютаДокумента КАК ЛотВалютаДокумента
		|ИЗ
		|	РегистрСведений.ПоставщикиПоЛотам КАК ПротоколВыбораПобедителейРаспределениеПоПотребностям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
		|		ПО ПротоколВыбораПобедителейРаспределениеПоПотребностям.ПредложениеПоставщика = ВТ.ПредложениеПоставщика
		|			И (ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот = ВТ.Лот
		|				ИЛИ ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот = ЗНАЧЕНИЕ(Справочник.Лоты.ПустаяСсылка))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.Дата,
		|	ВТ.Поставщик,
		|	ВТ.Номер,
		|	ВТ.Место,
		|	ВТ.ЛотВалютаДокумента
		|
		|УПОРЯДОЧИТЬ ПО
		|	СуммаДокумента";
	
	Запрос.УстановитьПараметр("ПротоколСсылка", ПротоколСсылка);
	Запрос.УстановитьПараметр("Лот", Лот);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.Прямой);
	Место = 1;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПобедительСтрока.Параметры.Победитель = (ВыборкаДетальныеЗаписи.Поставщик);
		ПобедительСтрока.Параметры.НомерЗаявки = ВыборкаДетальныеЗаписи.Номер;
		ПобедительСтрока.Параметры.ДатаЗаявки = Формат(ВыборкаДетальныеЗаписи.Дата, "ДФ=dd.MM.yyyy");
		ПобедительСтрока.Параметры.ЦенаЗаявки = ВыборкаДетальныеЗаписи.СуммаДокумента;
		ПобедительСтрока.Параметры.Валюта = ВыборкаДетальныеЗаписи.ЛотВалютаДокумента;

		ТД.Вывести(ПобедительСтрока);
		Место = Место + 1;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьТаблицуПобедителей(ПротоколСсылка, Лот, ТД, ПобедительСтрока)
	Если Лот.МетодОценкиПредложенийПоставщиков = Перечисления.МетодыОценкиПредложенийПоставщиков.ПоКритериям Тогда
		ЗаполнитьТаблицуПобедителейВыборПоКритериям(ПротоколСсылка, Лот, ТД, ПобедительСтрока);
	Иначе
		ЗаполнитьТаблицуПобедителейВыборПоЦенам(ПротоколСсылка, Лот, ТД, ПобедительСтрока);
	КонецЕсли;
КонецПроцедуры

Функция СформироватьОписаниеКомиссии(ЗакупочнаяКомиссия)
	ОписаниеКомиссии = Новый Структура;
	ТЧленов = Новый ТаблицаЗначений;
	ТЧленов.Колонки.Добавить("ЧленКомиссии", Новый ОписаниеТипов("Строка"));
	ТЧленов.Колонки.Добавить("Должность", Новый ОписаниеТипов("Строка"));
	
	ЧислоЧленовКомиссии = ?(ЗначениеЗаполнено(ЗакупочнаяКомиссия),
		ЗакупочнаяКомиссия.Количество(), 0);
	Если ЧислоЧленовКомиссии = 0 Тогда
		ЧислоЧленовКомиссии = "___"
	КонецЕсли;
	
	ОписаниеКомиссии.Вставить("ЧислоЧленовКомиссии", ЧислоЧленовКомиссии);
	ОписаниеКомиссии.Вставить("ПрисутствуетЧленовКомиссии", ЧислоЧленовКомиссии);
	
	СтрокаПодчеркивания = "__________________";
	ОписаниеКомиссии.Вставить("ПредседательКомиссии", СтрокаПодчеркивания);
	ОписаниеКомиссии.Вставить("ДолжностьПредседателя", СтрокаПодчеркивания);
	ОписаниеКомиссии.Вставить("СекретарьКомиссии", СтрокаПодчеркивания);
	ОписаниеКомиссии.Вставить("ДолжностьСекретаря", СтрокаПодчеркивания);
	ОписаниеКомиссии.Вставить("РядовыеЧленыКомиссии", ТЧленов);
	
	Если ЗначениеЗаполнено(ЗакупочнаяКомиссия) Тогда
		Для Каждого Строка_ Из ЗакупочнаяКомиссия Цикл
			Если ТипЗнч(Строка_.Сотрудник) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
				ФИО = Строка_.Сотрудник.ФИО;
			ИначеЕсли ТипЗнч(Строка_.Сотрудник) = Тип("СправочникСсылка.Сотрудники") Тогда
				ФИО = Строка_.Сотрудник.ФизическоеЛицо.ФИО;
			Иначе
				ФИО = Строка(Строка_.Сотрудник);
			КонецЕсли;
			Если Строка_.Роль = Перечисления.РолиЧленовКомиссии.СекретарьКомиссии Тогда
				ОписаниеКомиссии.СекретарьКомиссии = ФИО;
				ОписаниеКомиссии.ДолжностьСекретаря = Строка_.Должность;
			ИначеЕсли Строка_.Роль = Перечисления.РолиЧленовКомиссии.ПредседательКомиссии Тогда
				ОписаниеКомиссии.ПредседательКомиссии = ФИО;
				ОписаниеКомиссии.ДолжностьПредседателя = Строка_.Должность;
			Иначе
				НоваяСтрока = ТЧленов.Добавить();
				НоваяСтрока.ЧленКомиссии = ФИО;
				НоваяСтрока.Должность = Строка_.Должность;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	Возврат ОписаниеКомиссии;
КонецФункции

Функция ПолучитьПараметрСтруктуры(СтруктураИсточник, ИмяПараметра, ЗначениеПоУмолчанию)
	_ЗначениеИзСтруктуры = Неопределено;
	Если СтруктураИсточник.Свойство(ИмяПараметра, _ЗначениеИзСтруктуры) Тогда
		Возврат _ЗначениеИзСтруктуры;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Процедура ЗаполнитьТаблицуПриложение1ВыборПоКритериям(ПротоколСсылка, Лот, ТД, Макет,Приложение1Заголовок)
