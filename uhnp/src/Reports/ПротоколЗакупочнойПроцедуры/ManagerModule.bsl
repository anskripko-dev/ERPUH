Процедура ЗаполнитьПункт5(ЗакупочнаяПроцедура,КонтекстПечати, ТД, Пункт5,НМЦЛота, ЗаголовокНоменклатурыПункт5, НоменклатураПункт5, ИтоговыйПротокол,Лот = Неопределено)
	
	Если Лот <> Неопределено Тогда
		
		Возврат;	
	КонецЕсли; 
	
	Если ТипЗнч(КонтекстПечати.ПротоколСсылка) = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
		ЛотыДокумента = ЛотыЗакупочнойПроцедуры(КонтекстПечати.ПротоколСсылка);
	Иначе
		ЛотыДокумента = КонтекстПечати.ПротоколСсылка.ПредложенияПобедителей.Выгрузить();
	КонецЕсли;

	ЛотыДокумента.Свернуть("Лот");  
	ПервыйНомер = "5.";
	Для Каждого Лот ИЗ ЛотыДокумента Цикл     
		Если Лот.Лот.ВидЗакупки = ПредопределенноеЗначение("Перечисление.ВидЛотовойЗакупки.ЛотоваяЗакупка") Тогда
			Пункт5.Параметры.ЛотВидЗакупки = ПервыйНомер + Строка(Лот.Лот.ВидЗакупки)+ ", НМЦ договора";	 
			НМЦЛота.Параметры.НМЦЛота = "По лоту "+Строка(Лот.Лот.Номер) +" от "+ Строка(Лот.Лот.Дата)+" "+Строка(Лот.Лот.СуммаЛота)+" "+ строка(Лот.Лот.ВалютаДокумента);
			ТД.Вывести(Пункт5);
			ТД.Вывести(НМЦЛота);
		Иначе
			Пункт5.Параметры.ЛотВидЗакупки = ПервыйНомер + Строка(Лот.Лот.ВидЗакупки)+ ", НМЦ позиции";	 
			НМЦЛота.Параметры.НМЦЛота = "По лоту "+Строка(Лот.Лот.Номер) +" от "+ Строка(Лот.Лот.Дата)+" "+Строка(Лот.Лот.СуммаЛота)+" "+ строка(Лот.Лот.ВалютаДокумента);
			ТД.Вывести(Пункт5);
			ТД.Вывести(НМЦЛота);
			ТД.Вывести(ЗаголовокНоменклатурыПункт5);
			Для Каждого Строка ИЗ Лот.Лот.Номенклатура Цикл
				НоменклатураПункт5.Параметры.НомерСтроки = Строка.НомерСтроки;
				НоменклатураПункт5.Параметры.Номенклатура = Строка.Номенклатура;
				НоменклатураПункт5.Параметры.Сумма = Строка.Сумма;
				ТД.Вывести(НоменклатураПункт5);
			КонецЦикла;	
		КонецЕсли;	                                                                                 	
		
		ПервыйНомер = "";
	КонецЦикла;	
	
КонецПроцедуры  

Функция ЛотыЗакупочнойПроцедуры(ЗакупочнаяПроцедура)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лот.Ссылка КАК Лот
		|ИЗ
		|	Документ.Лот КАК Лот
		|ГДЕ
		|	Лот.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура";
	
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура", ЗакупочнаяПроцедура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Возврат ВыборкаДетальныеЗаписи; 
	

КонецФункции // ЛотыЗакупочнойПроцедуры()

	
Процедура ЗаполнитьТаблицуПриложение1ВыборПоЦенам(ПротоколСсылка, Лот, ТД, Макет,Приложение1Заголовок)
