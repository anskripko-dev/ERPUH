		Приложение1Номенклатура = Макет.ПолучитьОбласть("Приложение1Номенклатура");
		Приложение1НоменклатураПодвал = Макет.ПолучитьОбласть("Приложение1НоменклатураПодвал");
		
		ЗапросНоменклатураПоставщика = Новый Запрос;
		ЗапросНоменклатураПоставщика.Текст = 
		"ВЫБРАТЬ
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Контрагент КАК Поставщик,
