	              |					И НастройкиПроцессаВыбораКритерииОценки.КритерийОценки = МаксимальныеЗначения.Критерий
	              |			ПО НастройкиПроцессаВыбора.НастройкаПроцессаВыбора = НастройкиПроцессаВыбораКритерииОценки.Ссылка
	              |				И (НЕ НастройкиПроцессаВыбораКритерииОценки.РассчитатьЗначение)
	              |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиПроцессаВыбора.ОценочнаяКомиссия КАК НастройкиПроцессаВыбораОценочнаяКомиссия
	              |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФункциональныеНаправленияФизическихЛиц КАК ФункциональныеНаправленияФизическихЛиц
	              |				ПО НастройкиПроцессаВыбораОценочнаяКомиссия.Сотрудник = ФункциональныеНаправленияФизическихЛиц.ФизическоеЛицо
	              |			ПО НастройкиПроцессаВыбора.НастройкаПроцессаВыбора = НастройкиПроцессаВыбораОценочнаяКомиссия.Ссылка
	              |		ПО (ОбъектыВыбора.Владелец.Владелец = &Владелец)
	              |ГДЕ
	              |	(НастройкиПроцессаВыбораКритерииОценки.КритерийОценки.ФункциональноеНаправление = ЕСТЬNULL(ФункциональныеНаправленияФизическихЛиц.ФункциональноеНаправление, ЗНАЧЕНИЕ(Справочник.ФункциональныеНаправления.ПустаяСсылка))
	              |			ИЛИ НастройкиПроцессаВыбораКритерииОценки.КритерийОценки.ФункциональноеНаправление = ЗНАЧЕНИЕ(Справочник.ФункциональныеНаправления.ПустаяСсылка))
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ЕСТЬNULL(ЗначенияКритериевОценки.Значение, 0) КАК Оценка,
	              |	ВЫБОР
	              |		КОГДА КритерииСотрудники.ЭтапОценки = ЗНАЧЕНИЕ(Справочник.ЭтапыОценки.ПоследующаяОценка)
	              |			ТОГДА ЛОЖЬ
	              |		ИНАЧЕ ВЫБОР
	              |				КОГДА ЗначенияКритериевОценки.Ответственный ЕСТЬ NULL
	              |					ТОГДА ИСТИНА
	              |				ИНАЧЕ ЗначенияКритериевОценки.НеЗаполнен
	              |			КОНЕЦ
	              |	КОНЕЦ КАК НеЗаполнен,
	              |	ВЫБОР
	              |		КОГДА ЗначенияКритериевОценки.НеЗаполнен ЕСТЬ NULL
	              |			ТОГДА 0
	              |		ИНАЧЕ ВЫБОР
	              |				КОГДА ЗначенияКритериевОценки.НеЗаполнен
	              |					ТОГДА 0
	              |				ИНАЧЕ ВЫБОР
	              |						КОГДА КритерииСотрудники.НеИспользоватьПреобразованиеВБаллы
	              |							ТОГДА ЗначенияКритериевОценки.Значение / КритерииСотрудники.К1 + КритерииСотрудники.К0
	              |						ИНАЧЕ ЗначенияКритериевОценки.БалльноеЗначение / 5
	              |					КОНЕЦ * ЗначенияКритериевОценки.Вес
	              |			КОНЕЦ
	              |	КОНЕЦ КАК ИнтегральнаяОценка,
	              |	КритерииСотрудники.Сотрудник КАК Ответственный,
	              |	КритерииСотрудники.КритерийОценки КАК КритерийОценки,
	              |	КритерииСотрудники.ЭтапОценки КАК ЭтапОценки,
	              |	КритерииСотрудники.ОбъектВыбора КАК ОбъектВыбора,
	              |	КритерииСотрудники.Выбран КАК Выбран,
	              |	КритерииСотрудники.Вес КАК Вес,
	              |	ЗначенияКритериевОценки.Владелец КАК Владелец,
	              |	ЛОЖЬ КАК Расчетный,
	              |	ВЫБОР
	              |		КОГДА ЕСТЬNULL(СостояниеПроцессовВыбора.ТекущийЭтапВыбора, ЗНАЧЕНИЕ(Справочник.ЭтапыОценки.ПустаяСсылка)) = КритерииСотрудники.ЭтапОценки
	              |			ТОГДА ИСТИНА
	              |		ИНАЧЕ ЛОЖЬ
	              |	КОНЕЦ КАК ЭтоТекущийЭтап,
	              |	СостояниеПроцессовВыбора.ПроцессВыбораЗавершен КАК ПроцессВыбораЗавершен,
	              |	ЗначенияКритериевОценки.БалльноеЗначение КАК Балл,
	              |	ЕСТЬNULL(НомераЭтаповПоПорядку.НомерСтроки, 0) КАК НомерЭтапа,
	              |	КритерииСотрудники.НомерСтроки КАК НомерКритерия
	              |ПОМЕСТИТЬ ВТИтогов
	              |ИЗ
	              |	КритерииСотрудники КАК КритерииСотрудники
	              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияКритериевОценки КАК ЗначенияКритериевОценки
	              |		ПО (ЗначенияКритериевОценки.Владелец.Владелец = &Владелец)
	              |			И КритерииСотрудники.Сотрудник = ЗначенияКритериевОценки.Ответственный
	              |			И КритерииСотрудники.КритерийОценки = ЗначенияКритериевОценки.Критерий
	              |			И КритерииСотрудники.ЭтапОценки = ЗначенияКритериевОценки.ЭтапОценки
	              |			И КритерииСотрудники.ОбъектВыбора = ЗначенияКритериевОценки.ОбъектОценки
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПроцессовВыбора КАК СостояниеПроцессовВыбора
	              |		ПО (СостояниеПроцессовВыбора.Владелец.Владелец = &Владелец)
	              |		ЛЕВОЕ СОЕДИНЕНИЕ НомераЭтаповПоПорядку КАК НомераЭтаповПоПорядку
	              |		ПО КритерииСотрудники.ЭтапОценки = НомераЭтаповПоПорядку.Этап
	              |
	              |ОБЪЕДИНИТЬ ВСЕ
	              |
	              |ВЫБРАТЬ
	              |	ЕСТЬNULL(ЗначенияКритериевОценки.Значение, 0),
	              |	ЕСТЬNULL(ЗначенияКритериевОценки.НеЗаполнен, ИСТИНА),
	              |	ВЫБОР
	              |		КОГДА ЗначенияКритериевОценки.НеЗаполнен ЕСТЬ NULL
	              |			ТОГДА 0
	              |		ИНАЧЕ ВЫБОР
	              |				КОГДА ЗначенияКритериевОценки.НеЗаполнен
	              |					ТОГДА 0
	              |				ИНАЧЕ ВЫБОР
	              |						КОГДА РасчетныеКритерии.НеИспользоватьПреобразованиеВБаллы
	              |							ТОГДА ЗначенияКритериевОценки.Значение / РасчетныеКритерии.К1 + РасчетныеКритерии.К0
	              |						ИНАЧЕ ЗначенияКритериевОценки.БалльноеЗначение / 5
	              |					КОНЕЦ * ЗначенияКритериевОценки.Вес
	              |			КОНЕЦ
	              |	КОНЕЦ,
	              |	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	              |	РасчетныеКритерии.КритерийОценки,
	              |	РасчетныеКритерии.ЭтапОценки,
	              |	РасчетныеКритерии.ОбъектВыбора,
	              |	РасчетныеКритерии.Выбран,
	              |	РасчетныеКритерии.Вес,
	              |	ЗначенияКритериевОценки.Владелец,
	              |	ИСТИНА,
	              |	ВЫБОР
	              |		КОГДА ЕСТЬNULL(СостояниеПроцессовВыбора.ТекущийЭтапВыбора, ЗНАЧЕНИЕ(Справочник.ЭтапыОценки.ПустаяСсылка)) = РасчетныеКритерии.ЭтапОценки
	              |			ТОГДА ИСТИНА
	              |		ИНАЧЕ ЛОЖЬ
	              |	КОНЕЦ,
	              |	СостояниеПроцессовВыбора.ПроцессВыбораЗавершен,
	              |	ЗначенияКритериевОценки.БалльноеЗначение,
	              |	ЕСТЬNULL(НомераЭтаповПоПорядку.НомерСтроки, 0),
	              |	РасчетныеКритерии.НомерСтроки
	              |ИЗ
	              |	РасчетныеКритерии КАК РасчетныеКритерии
	              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияКритериевОценки КАК ЗначенияКритериевОценки
	              |		ПО (ЗначенияКритериевОценки.Владелец.Владелец = &Владелец)
	              |			И РасчетныеКритерии.КритерийОценки = ЗначенияКритериевОценки.Критерий
	              |			И РасчетныеКритерии.ЭтапОценки = ЗначенияКритериевОценки.ЭтапОценки
	              |			И РасчетныеКритерии.ОбъектВыбора = ЗначенияКритериевОценки.ОбъектОценки
	              |			И (ЗначенияКритериевОценки.Ответственный = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПроцессовВыбора КАК СостояниеПроцессовВыбора
	              |		ПО (СостояниеПроцессовВыбора.Владелец.Владелец = &Владелец)
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НомераЭтаповПоПорядку КАК НомераЭтаповПоПорядку
	              |		ПО РасчетныеКритерии.ЭтапОценки = НомераЭтаповПоПорядку.Этап
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ ПЕРВЫЕ 999
	              |	СУММА(ВТИтогов.ИнтегральнаяОценка) КАК Оценка,
	              |	ВТИтогов.ОбъектВыбора.Контрагент КАК Поставщик,
	              |	ВТИтогов.ОбъектВыбора.Номер КАК Номер,
	              |	ВТИтогов.ОбъектВыбора.Дата КАК Дата,
	              |	ВЫБОР
	              |		КОГДА ВТИтогов.ОбъектВыбора.ЦенаВключаетНДС
	              |			ТОГДА ВТИтогов.ОбъектВыбора.СуммаДокумента
	              |		ИНАЧЕ ВТИтогов.ОбъектВыбора.СуммаДокумента + ВТИтогов.ОбъектВыбора.СуммаНДС
	              |	КОНЕЦ КАК СуммаДокумента,
	              |	ВТИтогов.КритерийОценки КАК Критерий,
	              |	ВТИтогов.ЭтапОценки КАК Этап
	              |ИЗ
	              |	ВТИтогов КАК ВТИтогов
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПротоколВыбораПобедителей.ПредложенияПобедителей КАК ПротоколВыбораПобедителейПредложенияПобедителей
	              |		ПО (ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика = ВТИтогов.ОбъектВыбора)
	              |			И (ПротоколВыбораПобедителейПредложенияПобедителей.Победитель = ИСТИНА)
	              |			И (ПротоколВыбораПобедителейПредложенияПобедителей.Ссылка = &ПротоколСсылка)
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	ВТИтогов.ОбъектВыбора,
	              |	ВЫБОР
	              |		КОГДА ВТИтогов.ОбъектВыбора.ЦенаВключаетНДС
	              |			ТОГДА ВТИтогов.ОбъектВыбора.СуммаДокумента
	              |		ИНАЧЕ ВТИтогов.ОбъектВыбора.СуммаДокумента + ВТИтогов.ОбъектВыбора.СуммаНДС
	              |	КОНЕЦ,
	              |	ВТИтогов.ОбъектВыбора.Контрагент,
	              |	ВТИтогов.ОбъектВыбора.Номер,
	              |	ВТИтогов.ОбъектВыбора.Дата,
	              |	ВТИтогов.КритерийОценки,
	              |	ВТИтогов.ЭтапОценки
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Оценка УБЫВ,
	              |	ВТИтогов.ОбъектВыбора.Дата
	              |ИТОГИ
	              |	СУММА(Оценка)
	              |ПО
	              |	Поставщик"; 
	Запрос.УстановитьПараметр("Владелец", Лот);
	Запрос.УстановитьПараметр("ПротоколСсылка", ПротоколСсылка);
	
	Запрос.УстановитьПараметр("Лот", Лот);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаПобедителей = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ТД.Вывести(Приложение1Заголовок);
	КонецЕсли;	
	Место = 1;
	
	Приложение1ПоставщикЦена = Макет.ПолучитьОбласть("Приложение1ПоставщикЦена1");
	Приложение1Номенклатура = Макет.ПолучитьОбласть("Приложение1Номенклатура");
	Приложение1НоменклатураПодвал = Макет.ПолучитьОбласть("Приложение1НоменклатураПодвал");
	МестоПоОценке = Макет.ПолучитьОбласть("МестоПоОценке");
	Пока ВыборкаПобедителей.Следующий() Цикл
		
		МестоПоОценке.Параметры.Место = Место;
		МестоПоОценке.Параметры.Поставщик = ПредставлениеПоставщикаДляОтчета(ВыборкаПобедителей.Поставщик);
		ТД.Вывести(МестоПоОценке);
		ЗапросНоменклатураПоставщика = Новый Запрос;
		ЗапросНоменклатураПоставщика.Текст = 
		"ВЫБРАТЬ
		|	ПредложениеПоставщика.Ссылка.Контрагент КАК Поставщик,
		|	ПредложениеПоставщика.Номенклатура КАК Номенклатура,
		|	ПредложениеПоставщика.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СУММА(ПредложениеПоставщика.Количество) КАК Количество,
		|	СУММА(ПредложениеПоставщика.СуммаНДС) КАК СуммаНДС,
		|	ПредложениеПоставщика.СтавкаНДС КАК СтавкаНДС,
		|	СУММА(ПредложениеПоставщика.Сумма) КАК Сумма
		|ИЗ
		|	Документ.ПредложениеПоставщика.УсловияПоНоменклатуре КАК ПредложениеПоставщика
		|ГДЕ
		|	ПредложениеПоставщика.Ссылка.Контрагент = &Поставщик
		|	И ПредложениеПоставщика.Ссылка.Лот.Владелец = &Лот
		|
		|СГРУППИРОВАТЬ ПО
		|	ПредложениеПоставщика.СтавкаНДС,
		|	ПредложениеПоставщика.Ссылка.Контрагент,
		|	ПредложениеПоставщика.ЕдиницаИзмерения,
		|	ПредложениеПоставщика.Номенклатура
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	Поставщик";
		
		ЗапросНоменклатураПоставщика.УстановитьПараметр("ПротоколСсылка", ПротоколСсылка);
		ЗапросНоменклатураПоставщика.УстановитьПараметр("Лот", Лот);
		ЗапросНоменклатураПоставщика.УстановитьПараметр("Поставщик",ВыборкаПобедителей.Поставщик);
		РезультатЗапросаПопредложениям = ЗапросНоменклатураПоставщика.Выполнить();
		ВыборкаПобедителейПредлоежения = РезультатЗапросаПоПредложениям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПобедителейПредлоежения.Следующий() Цикл
			
			//ТД.Вывести(Приложение1ПоставщикЦена);
			
			ВыборкаНоменклатурыДетальныеЗаписи = ВыборкаПобедителейПредлоежения.Выбрать(ОбходРезультатаЗапроса.Прямой);
			НомерСтрокиНоменклатуры = 1;
			Пока ВыборкаНоменклатурыДетальныеЗаписи.Следующий() Цикл
				Приложение1Номенклатура.Параметры.НомерНоменклатуры = НомерСтрокиНоменклатуры;
				Приложение1Номенклатура.Параметры.Номенклатура = ВыборкаНоменклатурыДетальныеЗаписи.Номенклатура;
				Приложение1Номенклатура.Параметры.ЕдиницаИзмерения = ВыборкаНоменклатурыДетальныеЗаписи.ЕдиницаИзмерения;
				Приложение1Номенклатура.Параметры.Количество = ВыборкаНоменклатурыДетальныеЗаписи.Количество;
				Приложение1Номенклатура.Параметры.СтавкаНДС = ВыборкаНоменклатурыДетальныеЗаписи.СтавкаНДС;
				Приложение1Номенклатура.Параметры.СуммаНДС = ВыборкаНоменклатурыДетальныеЗаписи.СуммаНДС;
				Приложение1Номенклатура.Параметры.Сумма = ВыборкаНоменклатурыДетальныеЗаписи.Сумма;
				
				//ТД.Вывести(Приложение1Номенклатура);
				
				НомерСтрокиНоменклатуры = НомерСтрокиНоменклатуры + 1;
			КонецЦикла;
			
			//ТД.Вывести(Приложение1НоменклатураПодвал);
		КонецЦикла;
		
		
		Приложение1КритерийПобедитель.Параметры.Оценка = ВыборкаПобедителей.Оценка;
		//ТД.Вывести(Приложение1КритерийПобедитель);
		
		ВыборкаКритериев = ВыборкаПобедителей.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пока ВыборкаКритериев.Следующий() Цикл
			Приложение1КритерийКритерий.Параметры.Этап = ВыборкаКритериев.Этап;
			Приложение1КритерийКритерий.Параметры.Критерий = ВыборкаКритериев.Критерий;
			Приложение1КритерийКритерий.Параметры.Оценка = ВыборкаКритериев.Оценка;
			//ТД.Вывести(Приложение1КритерийКритерий);
		КонецЦикла;
		
