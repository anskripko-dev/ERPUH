	НовоеНаименованиеПротокола = СтрЗаменить(НовоеНаименованиеПротокола, "%СпособВыбораПоставщика%", НРег(Перечисления.СпособыВыбораПоставщика.РодительныйПадеж(КонтекстПечати.СпособВыбораПоставщика)));
	НовоеНаименованиеПротокола = СтрЗаменить(НовоеНаименованиеПротокола, "%ВЭлектроннойФорме%", Строка(?(ЗакупочнаяПроцедура.ВЭлектроннойФорме, НСтр("ru = ' в электронной форме'"), "")));
	НовоеНаименованиеПротокола = СтрЗаменить(НовоеНаименованиеПротокола, "%НомерПротокола%", Строка(?(ЗначениеЗаполнено(ПротоколСсылка.НомерПротокола), ПротоколСсылка.НомерПротокола, ПротоколСсылка.Номер)));
	НовоеНаименованиеПротокола = СтрЗаменить(НовоеНаименованиеПротокола, "%ДатаПротокола%", Формат(ПротоколСсылка.Дата, "ДФ=dd.MM.yyyy"));
	Приложение1Заголовок = Макет.ПолучитьОбласть("ПриложениеЗаголовок");
	Приложение1Заголовок.Параметры.НаименованиеПротокола = НовоеНаименованиеПротокола;
	Приложение1Заголовок.Параметры.НомерПриложения = НомерПриложения;
	
	флПоКритериям = Истина;
	Если флПоКритериям Тогда
		Приложение1Заголовок.Параметры.СпособОценки = НСтр("ru = 'Заявки на участие в запросе предложений оценивались в соответствии с критериями, их значимостью и содержанием, указанными в закупочной документации.'");
	Иначе
		Приложение1Заголовок.Параметры.СпособОценки = НСтр("ru = 'Заявки на участие оценивались на основании единственного критерия - цена.'");
	КонецЕсли;
	//ЗаполнитьТаблицуПриложение1ВыборПоКритериям(ПротоколСсылка, ЗакупочнаяПроцедура, ТД, Макет,Приложение1Заголовок);
	//ЗаполнитьТаблицуПриложение1ВыборПоЦенам(ПротоколСсылка, ЗакупочнаяПроцедура, ТД, Макет,Приложение1Заголовок);
	//ТД.Вывести(ПодписиУчастников);
	//ПодписиЗаголовок.Параметры.ПредседательКомиссии = ОписаниеКомиссии.ПредседательКомиссии;
	//ТД.Вывести(ПодписиЗаголовок);

	
	//Для Каждого Строка_ Из ОписаниеКомиссии.РядовыеЧленыКомиссии Цикл
	//	ПодписиЧленКомиссии.Параметры.ЧленКомиссии = Строка_.ЧленКомиссии;
	//	ТД.Вывести(ПодписиЧленКомиссии);
	//КонецЦикла;
	//ПодписиСекретарьКомиссии.Параметры.СекретарьКомиссии = ОписаниеКомиссии.СекретарьКомиссии;
	//
	//ТД.Вывести(ПодписиСекретарьКомиссии);
КонецПроцедуры

Процедура ЗаполнитьТаблицуАнкетыКвалификации(ПротоколСсылка, ТД, Макет)
	АнкетаКвалификацииЗаголовок = Макет.ПолучитьОбласть("АнкетаКвалификацииЗаголовок");
	АнкетаКвалификацииТребование = Макет.ПолучитьОбласть("АнкетаКвалификацииТребование");
	АнектаКвалификацииПодвал = Макет.ПолучитьОбласть("АнектаКвалификацииПодвал");
	
	ТД.Вывести(АнкетаКвалификацииЗаголовок);
	
	Для Каждого Строка_ Из ПротоколСсылка.ТребованияЛота Цикл
		АнкетаКвалификацииТребование.Параметры.НомерСтроки = Строка_.НомерСтроки;
		АнкетаКвалификацииТребование.Параметры.ТребованиеКПоставщику = Строка_.ТребованиеКПоставщику;
		АнкетаКвалификацииТребование.Параметры.Критерий = Строка_.Критерий;
		АнкетаКвалификацииТребование.Параметры.Значение = Строка_.ЗначениеМножества;
		АнкетаКвалификацииТребование.Параметры.РешениеПоложительно = ?(Строка_.РешениеПоложительно, НСтр("ru = 'Соотвествует требованию'"), НСтр("ru = 'Не соотвествует требованию'"));
		ТД.Вывести(АнкетаКвалификацииТребование);
	КонецЦикла;
	
	ТД.Вывести(АнектаКвалификацииПодвал);
КонецПроцедуры

Функция ЗаполнитьТаблицуУчастниковКвалификации(Лот, ТД, Макет)
	мПредставленийКонтрагентов = Новый Массив;
	
	УчастникКвалификацииШапка = Макет.ПолучитьОбласть("УчастникКвалификацииШапка");
	УчастникКвалификацииСтрока = Макет.ПолучитьОбласть("УчастникКвалификацииСтрока");
	УчастникКвалификацииПодвал = Макет.ПолучитьОбласть("УчастникКвалификацииПодвал");
	
	ТД.Вывести(УчастникКвалификацииШапка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвалификацияПоставщика.Номер,
		|	КвалификацияПоставщика.Дата,
		|	КвалификацияПоставщика.ФормаПодачи,
		|	КвалификацияПоставщика.РешениеПоДокументу,
		|	КвалификацияПоставщика.АнкетаПоставщика.Контрагент КАК Контрагент
		|ИЗ
		|	Документ.КвалификацияПоставщика КАК КвалификацияПоставщика
		|ГДЕ
		|	КвалификацияПоставщика.Проведен
		|	И КвалификацияПоставщика.ЗакупочнаяПроцедура = &Лот";

	Запрос.УстановитьПараметр("Лот", Лот);	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НомерУчастника = 1;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПредставлениеКонтрагента = ПредставленияКонтрагентаИННКПП(ВыборкаДетальныеЗаписи.Контрагент);
		мПредставленийКонтрагентов.Добавить(ПредставлениеКонтрагента);
		УчастникКвалификацииСтрока.Параметры.НомерУчастника = НомерУчастника;
		УчастникКвалификацииСтрока.Параметры.Контрагент = ПредставлениеКонтрагента;
		УчастникКвалификацииСтрока.Параметры.ДатаПоступления = Формат(ВыборкаДетальныеЗаписи.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'");
		УчастникКвалификацииСтрока.Параметры.НомерЗаявки = ВыборкаДетальныеЗаписи.Номер;
		УчастникКвалификацииСтрока.Параметры.ФормаПодачи = ?(ВыборкаДетальныеЗаписи.ФормаПодачи, НСтр("ru = 'Электронная'"), НСтр("ru = 'Бумажная'"));
		УчастникКвалификацииСтрока.Параметры.Решение = ?(ВыборкаДетальныеЗаписи.РешениеПоДокументу = Перечисления.ВидыРешенийПоДокументуКвалификации.ПоложительноеРешение, НСтр("ru = 'Соотвествует'"), НСтр("ru = 'Не соотвествует требованию'"));
		ТД.Вывести(УчастникКвалификацииСтрока);
		НомерУчастника = НомерУчастника + 1;
	КонецЦикла;
	
	ТД.Вывести(УчастникКвалификацииПодвал);
	
	Возврат мПредставленийКонтрагентов;
КонецФункции

Функция ВывестиЗаголовокПункта(ТД, Макет, ИмяРаздела, НомерПункта, Значения)
	РезультатФункции = НомерПункта + 1;
	РазделТД = Макет.ПолучитьОбласть(ИмяРаздела);
	
	Если ЗначениеЗаполнено(Значения) Тогда
		ЗаполнитьЗначенияСвойств(РазделТД.Параметры, Значения);
	КонецЕсли;
	
	РазделТД.Параметры.НомерПункта = РезультатФункции;
	ТД.Вывести(РазделТД);
	
	УчастникиСписокЗаголовок = Макет.ПолучитьОбласть("УчастникиСписокЗаголовок");	
	
	Возврат РезультатФункции;
КонецФункции

Процедура ВывестиПредложенияУчастников(ТД,Макет,Протокол) Экспорт
	
	УчастникиСписокЗаголовок = Макет.ПолучитьОбласть("УчастникиСписокЗаголовок");
	ТД.Вывести(УчастникиСписокЗаголовок);
	
	УчастникиСписок = Макет.ПолучитьОбласть("УчастникиСписок");
	Для Каждого Строка ИЗ Протокол.ПредложенияПобедителей Цикл
		УчастникиСписок.Параметры.Организация = Строка.Поставщик;
		УчастникиСписок.Параметры.Предложение = Строка.ПредложениеПоставщика;
		ТД.Вывести(УчастникиСписок);	
	КонецЦикла;	
	
КонецПроцедуры
	
Процедура ЗаполнитьТаблицуРешенияПротоколаКвалификации(Лот, ТД, Макет, НомерПункта, ПредставленияКонтрагентов)
	РешениеПротоколКвалификацииВводная = Макет.ПолучитьОбласть("РешениеПротоколКвалификацииВводная");
	ТД.Вывести(РешениеПротоколКвалификацииВводная);
	
	Если ПредставленияКонтрагентов.Количество() = 0 Тогда
		РешениеПротоколКвалификацииОтказ = Макет.ПолучитьОбласть("РешениеПротоколКвалификацииОтказ");
		ТД.Вывести(РешениеПротоколКвалификацииОтказ);
	Иначе
		УчастникиСтрокой = "";
		Для Каждого ПредставлениеКонтрагента Из ПредставленияКонтрагентов Цикл
			УчастникиСтрокой = УчастникиСтрокой + ?(ПустаяСтрока(УчастникиСтрокой), "", Символы.ПС) + ПредставлениеКонтрагента;
		КонецЦикла;
		РешениеПротоколКвалификацииДопущены = Макет.ПолучитьОбласть("РешениеПротоколКвалификацииДопущены");
		РешениеПротоколКвалификацииДопущены.Параметры.ДопущенныеУчастники = УчастникиСтрокой;
		ТД.Вывести(РешениеПротоколКвалификацииДопущены);
	КонецЕсли;
	РешениеПротоколКвалификацииПодвал = Макет.ПолучитьОбласть("РешениеПротоколКвалификацииПодвал");
	РешениеПротоколКвалификацииПодвал.Параметры.НомерПункта = НомерПункта;
	ТД.Вывести(РешениеПротоколКвалификацииПодвал);
КонецПроцедуры

Функция ЗаполнитьТаблицуПриложениеКвалификацииПоставщиков(КонтекстПечати, ТД, Макет, НомерПриложения)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КвалификацияПоставщика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КвалификацияПоставщика КАК КвалификацияПоставщика
		|ГДЕ
		|	КвалификацияПоставщика.Проведен
		|	И КвалификацияПоставщика.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура";
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура", КонтекстПечати.ЗакупочнаяПроцедура);	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	КонтекстПечатиКвалификаций = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(
		КонтекстПечати);
	КонтекстПечатиКвалификаций.ТипПротокола = "КвалификацияПоставщика";
	КонтекстПечатиКвалификаций.ВыводитьНоменклатуруПоставщиков = Ложь;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТД.ВывестиГоризонтальныйРазделительСтраниц();
		КонтекстПечатиКвалификаций.ПротоколСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		ЗаполнитьТаблицуПротокола(
			КонтекстПечатиКвалификаций,
			Истина,
			НомерПриложения,
			ТД,
			Макет);
		НомерПриложения = НомерПриложения + 1;
	КонецЦикла;
	Возврат НомерПриложения;
КонецФункции

// Выводит в табличный документ ТабличныйДокументРезультат данные НМЦ лотов,
// принадлежащих закупочной процедуре ЗакупочнаяПроцедураВход, используя область
// ОбластьСтрокаНМЦ.
Процедура ЗаполнитьДанныеНмцЗакупочнойПроцедуры(ЗакупочнаяПроцедураВход, ТабличныйДокументРезультат, ОбластьСтрокаНМЦ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Лоты.Ссылка КАК Ссылка,
	|	Лоты.СуммаЛота КАК СуммаЛота,
	|	Лоты.ВалютаДокумента КАК ВалютаДокумента
	|ИЗ
	|	Документ.Лот КАК Лоты
	|ГДЕ
	|	Лоты.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура
	|	И НЕ Лоты.ПометкаУдаления
	| 	И Лоты.Проведен";
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура", ЗакупочнаяПроцедураВход);
	РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить();
	Для Каждого ТекВыгрузка Из Выгрузка Цикл
		ОбластьСтрокаНМЦ.Параметры.Лот		 = ТекВыгрузка.Ссылка;
		ОбластьСтрокаНМЦ.Параметры.СуммаНМЦ	 = Формат(ТекВыгрузка.СуммаЛота, "ЧДЦ=2") +" "+ ТекВыгрузка.ВалютаДокумента;
		ТабличныйДокументРезультат.Вывести(ОбластьСтрокаНМЦ);
	КонецЦикла;					
КонецПроцедуры		// ЗаполнитьДанныеНмцЗакупочнойПроцедуры()

// Выводит в табличный документ ТабличныйДокументИзм данные по победителям закупочной процедуры 
// ЗакупочнаяПроцедураВход, согласно протоколу выбора победителей ПротоколВход по макетам
// МакетРешениеВыборПобедителяЗаголовокСтрокиВход, МакетРешениеВыборПобедителяЛотВход, 
// МакетПобедительСтрокаВход.
Процедура ВывестиРешениеПобедительПоЗакупочнойПроцедуре(ПротоколВход, ЗакупочнаяПроцедураВход, ТабличныйДокументИзм, МакетРешениеВыборПобедителяЗаголовокСтрокиВход, МакетРешениеВыборПобедителяЛотВход, МакетПобедительСтрокаВход)
	// Получение лотов, сопоставленных закупочной процедуре.
	МассивЛотов = Справочники.ЗакупочныеПроцедуры.ПолучитьЛотыЗакупочнойПроцедуры(ЗакупочнаяПроцедураВход);
	Для Каждого ТекМассивЛотов Из МассивЛотов Цикл
		// Вывод наименования лота и шапки таблицы победителей.
		МакетРешениеВыборПобедителяЛотВход.Параметры.Лот = ТекМассивЛотов;
		ТабличныйДокументИзм.Вывести(МакетРешениеВыборПобедителяЛотВход);
		ТабличныйДокументИзм.Вывести(МакетРешениеВыборПобедителяЗаголовокСтрокиВход);
		// Вывод строк таблицы победителей.
		ЗаполнитьТаблицуПобедителей(ПротоколВход, ТекМассивЛотов, ТабличныйДокументИзм, МакетПобедительСтрокаВход);
	КонецЦикла;	
КонецПроцедуры		// ВывестиРешениеПобедительПоЗакупочнойПроцедуре()

Процедура ЗаполнитьТаблицуПротокола(КонтекстПечати, КакПриложение, НомерПриложения, ТД, Макет)
	ЗакупочнаяПроцедура = КонтекстПечати.ЗакупочнаяПроцедура;
	ПротоколСсылка = КонтекстПечати.ПротоколСсылка;
	ТипПротокола = КонтекстПечати.ТипПротокола;
	ОписаниеКомиссии = КонтекстПечати.ОписаниеКомиссии;
	ВыводитьНоменклатуруПоставщиков = КонтекстПечати.ВыводитьНоменклатуруПоставщиков;
	флТребуетсяКвалификационныйОтбор = КонтекстПечати.ТребуетсяКвалификационныйОтбор;
	
	Раздел1_5 = Макет.ПолучитьОбласть("Раздел1_5");
	
	ОбластьЗаголовокЛота = Макет.ПолучитьОбласть("ЗаголовокЛота");
	ЗаголовокНоменклатуры = Макет.ПолучитьОбласть("ЗаголовокНоменклатуры");
	СтрокаНоменклатуры = Макет.ПолучитьОбласть("СтрокаНоменклатуры");
	ОбластьЗаголовокЛотаЗонтичнойЗакупки = Макет.ПолучитьОбласть("ЗаголовокРаспределениеЛотаПоЗонтичнойЗакупке");	
	ШапкаРаспределенияЗонтичнойНоменклатуры = Макет.ПолучитьОбласть("ШапкаРаспределенияЗонтичнойНоменклатуры");
	НоменклатураЗонтичногоРаспределения = Макет.ПолучитьОбласть("НоменклатураЗонтичногоРаспределения");
	
	Раздел6 = Макет.ПолучитьОбласть("Раздел6");
	ОбластьРаздел6_Строка = Макет.ПолучитьОбласть("Раздел6_Строка");
	ОбластьСтрокаНМЦ = Макет.ПолучитьОбласть("СтрокаНМЦ");
	ЧленКомиссии = Макет.ПолучитьОбласть("ЧленКомиссии");
	ПодвалКомиссии = Макет.ПолучитьОбласть("ПодвалКомиссии");
	РешениеПодвал = Макет.ПолучитьОбласть("РешениеПодвал");
	ПодписиЧленКомиссии = Макет.ПолучитьОбласть("ПодписиЧленКомиссии");
	ПодписиСекретарьКомиссии = Макет.ПолучитьОбласть("ПодписиСекретарьКомиссии");
	
	Если КакПриложение Тогда
		ПротоколЗаголовок = Макет.ПолучитьОбласть("ПриложениеЗаголовок");
		ПротоколЗаголовок.Параметры.НомерПриложения = НомерПриложения;
	Иначе
		ПротоколЗаголовок = Макет.ПолучитьОбласть("ПротоколЗаголовок");
	КонецЕсли;
	ПротоколЗаголовок.Параметры.НаименованиеПротокола =
		СформироватьНаименованиеПротокола(КонтекстПечати);
	ТД.Вывести(ПротоколЗаголовок);
		
	АдресЗакупкиНаЕИС = "";
	НомерЗакупкиНаЕИС = "";
	Если ЗначениеЗаполнено(ЗакупочнаяПроцедура.ЭТП) Тогда
		ЕИС = Справочники.ЭлектронныеТорговыеПлощадки.СсылкаНаЕИС();
		АдресЗакупкиНаЕИС = ИнтеграцияЦУЗсЭТПСерверУХ.ПолучитьАдресЗакупкиНаСайтеЭТП(
			ЕИС, ЗакупочнаяПроцедура);
		НомерЗакупкиНаЕИС = ИнтеграцияЦУЗсЭТПСерверУХ.ПолучитьНомерЗакупкиНаЭТП(
			ЕИС, ЗакупочнаяПроцедура);
	КонецЕсли;
	
	НомерЛота = "";
	Если ТипЗнч(ЗакупочнаяПроцедура) = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
		Если ЗначениеЗаполнено(ЗакупочнаяПроцедура.РегистрационныйНомер) Тогда
			НомерЛота = ЗакупочнаяПроцедура.РегистрационныйНомер;
		Иначе
			НомерЛота = ЗакупочнаяПроцедура.Код;
		КонецЕсли;
	Иначе	
		НомерЛота = ?(ЗначениеЗаполнено(ЗакупочнаяПроцедура.НомерЛотаВГПЗ), ЗакупочнаяПроцедура.НомерЛотаВГПЗ, ЗакупочнаяПроцедура.Код);
	КонецЕсли;
	
	ЛотНМЦ = НСтр("ru = 'Не установлены'");
	НомерПротокола = "";
	ДатаПротокола = '00010101';
	Если ТипПротокола = "ПротоколКвалификации" Тогда
		НомерПротокола = НомерЛота;
		ДатаПротокола =
			Справочники.ЗакупочныеПроцедуры.ПолучитьДатуОкончанияКвалификационногоОтбора(
				ЗакупочнаяПроцедура);
	ИначеЕсли (ТипПротокола = "КвалификацияПоставщика") Тогда
		НомерПротокола = ПротоколСсылка.Номер;
		ДатаПротокола = ПротоколСсылка.Дата;
	ИначеЕсли (ТипПротокола = "ИтоговыйПротокол")
				ИЛИ (ТипПротокола = "ПротоколОтмены") Тогда
		НомерПротокола = ?(ЗначениеЗаполнено(ПротоколСсылка.НомерПротокола),
			ПротоколСсылка.НомерПротокола,
			ПротоколСсылка.Номер);
		ДатаПротокола = ПротоколСсылка.Дата;
	КонецЕсли;
	
	Раздел1_5.Параметры.НомерПротокола = НомерПротокола;
	Раздел1_5.Параметры.ДатаПротокола = Формат(ДатаПротокола, "ДФ=dd.MM.yyyy");
	Раздел1_5.Параметры.АдресПодведенияИтогов  = ЗакупочнаяПроцедура.АдресПодведенияИтогов;
	Раздел1_5.Параметры.Заказчик = ПредставлениеОрганизацииДляОтчета(ЗакупочнаяПроцедура.ОрганизацияДляЗаключенияДоговора);
	Раздел1_5.Параметры.ОрганизаторЗакупки = ПредставлениеОрганизацииДляОтчета(ЗакупочнаяПроцедура.ОрганизаторЗакупки);
	
	Если ТипЗнч(ПротоколСсылка) = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
		Если ЗакупочнаяПроцедура.СпособПубликации = Перечисления.СпособПубликацииЗакупки.НаЭТП Тогда
			Раздел1_5.Параметры.МестоПроведения = ЗакупочнаяПроцедура.ЭТП;
		Иначе
			Раздел1_5.Параметры.МестоПроведения = ЗакупочнаяПроцедура.АдресПодведенияИтогов;
		КонецЕсли;
	Иначе
		Раздел1_5.Параметры.МестоПроведения = ПротоколСсылка.МестоПроведенияПроцедуры;
	КонецЕсли;
	
	Раздел1_5.Параметры.ПредметДоговора = СокрЛП(ЗакупочнаяПроцедура.ПредметДоговора);
	
	ТД.Вывести(Раздел1_5);
	
	ИтоговыйПротокол = Истина;
	
	Пункт5 = Макет.ПолучитьОбласть("Пункт5");
	ЗаголовокНоменклатурыПункт5 = Макет.ПолучитьОбласть("ЗаголовокНоменклатурыПункт5");
	НоменклатураПункт5 = Макет.ПолучитьОбласть("НоменклатураПункт5");                                                 
	НМЦЛота = Макет.ПолучитьОбласть("НМЦЛота");
	
	ЗаполнитьПункт5(ЗакупочнаяПроцедура,КонтекстПечати, ТД, Пункт5,НМЦЛота, ЗаголовокНоменклатурыПункт5, НоменклатураПункт5, ИтоговыйПротокол);

	// Дальше номера выводимых пунктов меняются в зависимости от типа печатной формы
	НомерПункта = 5;
	
	Если НЕ (ТипПротокола = "КвалификацияПоставщика" ИЛИ ТипПротокола = "ПротоколКвалификации") Тогда
		ДанныеЗаполнения = Новый Структура();
		ДанныеЗаполнения.Вставить("ИсточникФинансирования", ЗакупочнаяПроцедура.ИсточникФинансирования);
		НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "ИсточникФинансирования", НомерПункта, ДанныеЗаполнения);
						
		ДанныеЗаполнения = Новый Структура();
		ДанныеЗаполнения.Вставить("НомерНаЕИС", ?(ЗначениеЗаполнено(ЗакупочнаяПроцедура.РегистрационныйНомер), ЗакупочнаяПроцедура.РегистрационныйНомер, "____"));
		ДанныеЗаполнения.Вставить("МестоРазмещения", НСтр("ru = 'на официальном сайте www.zakupki.gov.ru'"));
		ДанныеЗаполнения.Вставить("ДатаРазмещения", Формат(ЗакупочнаяПроцедура.ДатаОфициальногоОбъявленияЗакупки, "ДФ=dd.MM.yyyy"));
		НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "ИнформацияОРазмещении", НомерПункта, ДанныеЗаполнения);
	КонецЕсли;
		
	//ДанныеЗаполнения = Новый Структура();
	//ДанныеЗаполнения.Вставить("ПредседательКомиссии", ОписаниеКомиссии.ПредседательКомиссии);
	//ДанныеЗаполнения.Вставить("Должность", ОписаниеКомиссии.ДолжностьПредседателя);
	//НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "КомиссияЗаголовок", НомерПункта, ДанныеЗаполнения);
	НомерПункта = НомерПункта +1;
	КомиссияЗаголовок = Макет.ПолучитьОбласть("КомиссияЗаголовок"); 
	КомиссияЗаголовок.Параметры.НомерПункта = Строка(НомерПункта);
	ТД.Вывести(КомиссияЗаголовок);
	ЗаголовокСтрокиКомиссии = Макет.ПолучитьОбласть("ЗаголовокСтрокиКомиссии");
	ТД.Вывести(ЗаголовокСтрокиКомиссии);  
	СтрокаКомиссии = Макет.ПолучитьОбласть("СтрокаКомиссии");    
	НомерСтрокиКомиссии = 1;
	СтрокаКомиссии.Параметры.НомерСтроки = НомерСтрокиКомиссии;
	СтрокаКомиссии.Параметры.ЧленКомиссии = ОписаниеКомиссии.ПредседательКомиссии;
	СтрокаКомиссии.Параметры.Роль = "Председатель комиссии";
	СтрокаКомиссии.Параметры.Должность = ОписаниеКомиссии.ДолжностьПредседателя;
	ТД.Вывести(СтрокаКомиссии);  

	//НомерСтрокиКомиссии = 2;
	//СтрокаКомиссии.Параметры.НомерСтроки = НомерСтрокиКомиссии;
	//СтрокаКомиссии.Параметры.ЧленКомиссии = ОписаниеКомиссии.СекретарьКомиссии;
	//СтрокаКомиссии.Параметры.Роль = "Секретарь комиссии";
	//СтрокаКомиссии.Параметры.Должность = ОписаниеКомиссии.ДолжностьСекретаря;
	//ТД.Вывести(СтрокаКомиссии);  
	
	Для Каждого Строка_ Из ОписаниеКомиссии.РядовыеЧленыКомиссии Цикл
		НомерСтрокиКомиссии = НомерСтрокиКомиссии+1; 
		СтрокаКомиссии.Параметры.НомерСтроки = НомерСтрокиКомиссии;
		СтрокаКомиссии.Параметры.ЧленКомиссии = Строка_.ЧленКомиссии;
		СтрокаКомиссии.Параметры.Должность = Строка_.Должность;   
		СтрокаКомиссии.Параметры.Роль = "Член комиссии";   
		ТД.Вывести(СтрокаКомиссии);
	КонецЦикла;
	
	//ПодвалКомиссии.Параметры.СекретарьКомиссии = ОписаниеКомиссии.СекретарьКомиссии;
	//ПодвалКомиссии.Параметры.Должность = ОписаниеКомиссии.ДолжностьСекретаря;
	ПодвалКомиссии.Параметры.ЧислоЧленовКомиссии = ОписаниеКомиссии.ЧислоЧленовКомиссии;
	ПодвалКомиссии.Параметры.ПрисутствуетЧленовКомиссии = ОписаниеКомиссии.ПрисутствуетЧленовКомиссии;
	ТД.Вывести(ПодвалКомиссии);
	
	Если ТипПротокола = "КвалификацияПоставщика" Тогда
		// Сведения об участнике квалификации
		ДанныеЗаполнения = Новый Структура();
		ДанныеЗаполнения.Вставить("Участник", ПредставлениеПоставщикаДляОтчета(?(ТИПЗнч(ПротоколСсылка.АнкетаПоставщика) = Тип("СправочникСсылка.Контрагенты"),ПротоколСсылка.АнкетаПоставщика,ПротоколСсылка.АнкетаПоставщика.Контрагент)));
		НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "УчастникКвалификацииЗаголовок", НомерПункта, ДанныеЗаполнения);
		ЗаполнитьТаблицуАнкетыКвалификации(ПротоколСсылка, ТД, Макет);
	Иначе
		// Сведения об участниках квалификации
		Если флТребуетсяКвалификационныйОтбор Тогда
			НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "УчастникиКвалификацииЗаголовок", НомерПункта, Неопределено);
			мПредставлениеКонтрагентов = ЗаполнитьТаблицуУчастниковКвалификации(ЗакупочнаяПроцедура, ТД, Макет);
		Иначе
			мПредставлениеКонтрагентов = Новый ТаблицаЗначений;
		КонецЕсли;
		
		// Сведения об участниках торгов
		Если ТипПротокола = "ИтоговыйПротокол" ИЛИ ТипПротокола = "ПротоколОтмены" Тогда
			
			НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "УчастникиЗакупокЗаголовок", НомерПункта, Неопределено);
			
			ВывестиПредложенияУчастников(ТД,Макет,КонтекстПечати.ПротоколСсылка);
			
			
			Если флТребуетсяКвалификационныйОтбор Тогда
				УчастникиКвалификация = Макет.ПолучитьОбласть("УчастникиКвалификация");
				ТД.Вывести(УчастникиКвалификация);
			КонецЕсли;
			
			УчастникиОтсутствуют = Макет.ПолучитьОбласть("УчастникиОтсутствуют");
			УчастникиЗаявка = Макет.ПолучитьОбласть("УчастникиЗаявка");
			УчастникиНоменклатураЗаголовок = Макет.ПолучитьОбласть("УчастникиНоменклатураЗаголовок");
			УчастникиНоменклатура = Макет.ПолучитьОбласть("УчастникиНоменклатура");
			УчастникиНоменклатураПодвал = Макет.ПолучитьОбласть("УчастникиНоменклатураПодвал");
			
			ЗаполнитьТаблицуПредложенийПоставщиков(ЗакупочнаяПроцедура, ВыводитьНоменклатуруПоставщиков, ТД, УчастникиЗаявка,
				УчастникиНоменклатураЗаголовок, УчастникиНоменклатура, УчастникиНоменклатураПодвал, УчастникиОтсутствуют);
		КонецЕсли;
	КонецЕсли;
	
	// Решение по протоколу
	НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "РешениеЗаголовок", НомерПункта, Неопределено);
	
	Если ТипПротокола = "ПротоколОтмены" Тогда
		РешениеОтмена = Макет.ПолучитьОбласть("РешениеОтмена");
		РешениеОтмена.Параметры.ПричинаОтмены = ПротоколСсылка.ПричинаОтказаОтПроведения;
		ТД.Вывести(РешениеОтмена);
		
	ИначеЕсли ТипПротокола = "ИтоговыйПротокол" Тогда
		Если ПротоколСсылка.ТоргиСостоялись Тогда
			флВывестиПриложениеСПобедителями = Истина;
			РешениеВыборПобедителя1					 = Макет.ПолучитьОбласть("РешениеВыборПобедителя1");
			РешениеВыборПобедителяЗаголовокСтроки	 = Макет.ПолучитьОбласть("РешениеВыборПобедителяЗаголовокСтроки");
			РешениеВыборПобедителяЛот				 = Макет.ПолучитьОбласть("РешениеВыборПобедителяЛот");
			ПобедительСтрока						 = Макет.ПолучитьОбласть("ПобедительСтрока");
			РешениеВыборПобедителя2					 = Макет.ПолучитьОбласть("РешениеВыборПобедителя2");    
			
			РешениеВыборПобедительЛотаЗонтичнойЗакупки = Макет.ПолучитьОбласть("РешениеВыборПобедительЛотаЗонтичнойЗакупки");
			ШапкаРаспределенияЛотаЗонтичнойНоменклатуры = Макет.ПолучитьОбласть("ШапкаРаспределенияЛота");
			СтрокаРаспределенияПобедителейЗонтичнойЗакупки = Макет.ПолучитьОбласть("СтрокаРаспределенияПобедителейЗонтичнойЗакупки");
			
				
			
			Если ТипЗнч(ЗакупочнаяПроцедура) = Тип("СправочникСсылка.Лоты") Тогда
				Если ЗакупочнаяПроцедура.МетодОценкиПредложенийПоставщиков = Перечисления.МетодыОценкиПредложенийПоставщиков.ПоКритериям Тогда
					//РешениеВыборПобедителя1.Параметры.СпособОценки = НСтр("ru = 'Заявки на участие в запросе предложений оценивались в соответствии с критериями, их значимостью и содержанием, указанными в закупочной документации.'");
				Иначе
					//РешениеВыборПобедителя1.Параметры.СпособОценки = НСтр("ru = 'Заявки на участие оценивались на основании единственного критерия - цена.'");
				КонецЕсли;
			ИначеЕсли ТипЗнч(ЗакупочнаяПроцедура) = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
				Если Справочники.ЗакупочныеПроцедуры.ПолучитьМетодОценкиПредложенийПоставщиков(ЗакупочнаяПроцедура) = Перечисления.МетодыОценкиПредложенийПоставщиков.ПоКритериям Тогда
					//РешениеВыборПобедителя1.Параметры.СпособОценки = НСтр("ru = 'Заявки на участие в запросе предложений оценивались в соответствии с критериями, их значимостью и содержанием, указанными в закупочной документации.'");
				Иначе
					//РешениеВыборПобедителя1.Параметры.СпособОценки = НСтр("ru = 'Заявки на участие оценивались на основании единственного критерия - цена.'");
				КонецЕсли;
			КонецЕсли;   
			
			
			РешениеВыборПобедителя1.Параметры.НомерПункта = НомерПункта;
			ТД.Вывести(РешениеВыборПобедителя1);

			
			Если ТипЗнч(ЗакупочнаяПроцедура) = Тип("ДокументСсылка.Лот") Тогда
				ЗаполнитьТаблицуПобедителей(ПротоколСсылка, ЗакупочнаяПроцедура, ТД, ПобедительСтрока);
			ИначеЕсли ТипЗнч(ЗакупочнаяПроцедура) = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
				ВывестиРешениеПобедительПоЗакупочнойПроцедуре(ПротоколСсылка, ЗакупочнаяПроцедура, ТД, РешениеВыборПобедителяЗаголовокСтроки, РешениеВыборПобедителяЛот, ПобедительСтрока);
			КонецЕсли;                          
			
			ЗаполнитьНоменклатуруПоНеЛотовойЗакупке(КонтекстПечати.ПротоколСсылка,ТД,Макет);

			РешениеВыборПобедителя2.Параметры.НомерПункта = НомерПункта;
		 	ТД.Вывести(РешениеВыборПобедителя2);
			Если  ТипЗнч(ПротоколСсылка) = Тип("ДокументСсылка.ПротоколВыбораПобедителей") Тогда        
				Если ПротоколСсылка.ОрганизаторЗакупки.ЗакупкаПоФЗ223 Тогда
					РешениеВыборПобедителя3					 = Макет.ПолучитьОбласть("РешениеВыборПобедителя3"); 
					РешениеВыборПобедителя3.Параметры.НомерПункта = НомерПункта;
					ТД.Вывести(РешениеВыборПобедителя3);
				КонецЕсли;
				//ЗаполнитьТаблицуПобедителейЗонтичнойЗакупкиПоОценкеПоЦенам(ПротоколСсылка, ЗакупочнаяПроцедура, ТД, РешениеВыборПобедительЛотаЗонтичнойЗакупки, ШапкаРаспределенияЛотаЗонтичнойНоменклатуры,СтрокаРаспределенияПобедителейЗонтичнойЗакупки );
			КонецЕсли;                
			
			

		Иначе
			ТоргиНеСостоялись = Макет.ПолучитьОбласть("ТоргиНеСостоялись");
			ТоргиНеСостоялись.Параметры.ПричинаПризнанияТорговНесостоявшимися = ПротоколСсылка.ПричинаПризнанияТорговНесостоявшимися;
			
			ТД.Вывести(ТоргиНеСостоялись);
		КонецЕсли;
		
	ИначеЕсли ТипПротокола = "КвалификацияПоставщика" Тогда
		РешениеКвалификацияПоставщика = Макет.ПолучитьОбласть("РешениеКвалификацияПоставщика");
		РешениеКвалификацияПоставщика.Параметры.ДопуститьНеДопустить = ?(ПротоколСсылка.РешениеПоДокументу = Перечисления.ВидыРешенийПоДокументуКвалификации.ПоложительноеРешение, НСтр("ru = 'допустить'"), НСтр("ru = 'не допускать'"));
		РешениеКвалификацияПоставщика.Параметры.ОбоснованиеРешения = СокрЛП(ПротоколСсылка.ОбоснованиеРешения);
		ТД.Вывести(РешениеКвалификацияПоставщика);
		
	ИначеЕсли ТипПротокола = "ПротоколКвалификации" Тогда
		ЗаполнитьТаблицуРешенияПротоколаКвалификации(ЗакупочнаяПроцедура, ТД, Макет, НомерПункта, мПредставлениеКонтрагентов);
	КонецЕсли;
	ТД.Вывести(РешениеПодвал);
	
	ДанныеЗаполнения = Новый Структура();
	ДанныеЗаполнения.Вставить("ПредседательКомиссии", ОписаниеКомиссии.ПредседательКомиссии);
	НомерПункта = ВывестиЗаголовокПункта(ТД, Макет, "ПодписиЗаголовок", НомерПункта, ДанныеЗаполнения);
	
	Для Каждого Строка_ Из ОписаниеКомиссии.РядовыеЧленыКомиссии Цикл
		ПодписиЧленКомиссии.Параметры.ЧленКомиссии = Строка_.ЧленКомиссии;
		ТД.Вывести(ПодписиЧленКомиссии);
	КонецЦикла;
	ПодписиСекретарьКомиссии.Параметры.СекретарьКомиссии = ОписаниеКомиссии.СекретарьКомиссии;
	ТД.Вывести(ПодписиСекретарьКомиссии);
КонецПроцедуры

Процедура ЗаполнитьНоменклатуруПоНеЛотовойЗакупке(Протокол,ТД,Макет)
	
	Лоты = Протокол.ПредложенияПобедителей.Выгрузить();
	Лоты.Свернуть("Лот");
	Для Каждого Строка ИЗ Лоты Цикл   
		Если Строка.Лот.ВидЗакупки = ПредопределенноеЗначение("Перечисление.ВидЛотовойЗакупки.ЛотоваяЗакупка") Тогда
			Продолжить;
		КонецЕсли;	
		ПобедительНеЛотовой = Макет.ПолучитьОбласть("ПобедительНеЛотовой");
		ПобедительНеЛотовой.Параметры.НаименованиеЛота = "Лот "+Строка(Строка.Лот.Номер);
		ТД.Вывести(ПобедительНеЛотовой);
		
		Запрос = Новый Запрос;      
		Запрос.УстановитьПараметр("РаспределениеПоПотребностям",Протокол.РаспределениеПоПотребностям.Выгрузить());
		Запрос.УстановитьПараметр("Лот",Строка.Лот);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Номенклатура КАК Номенклатура,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.МестоПоставки КАК МестоПоставки,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Количество КАК Количество,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Цена КАК Цена,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Сумма КАК Сумма,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Характеристика КАК Характеристика,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ПредложениеПоставщика КАК ПредложениеПоставщика,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Назначение КАК Назначение,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ПериодПотребности КАК ПериодПотребности,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ЦФО КАК ЦФО,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Организация КАК Организация,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Проект КАК Проект,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот КАК Лот,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ПобедительПоПозиционномуРаспределению КАК ПобедительПоПозиционномуРаспределению
		               |ПОМЕСТИТЬ РаспределениеПоПотребностям
		               |ИЗ
		               |	&РаспределениеПоПотребностям КАК ПротоколВыбораПобедителейРаспределениеПоПотребностям
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Номенклатура КАК Номенклатура,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.МестоПоставки КАК МестоПоставки,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Количество КАК Количество,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Цена КАК Цена,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Сумма КАК Сумма,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Характеристика КАК Характеристика,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ПредложениеПоставщика КАК ПредложениеПоставщика,
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ЛотНоменклатура.Цена КАК ЦенаЛота,
		               |	ЛотНоменклатура.ДатаПоставки КАК ДатаПоставки,
		               |	ЛотНоменклатура.Сумма КАК СуммаЛота,
		               |	ЛотНоменклатура.Количество КАК КоличествоЛота
		               |ПОМЕСТИТЬ ВременнаяТаблица
		               |ИЗ
		               |	РаспределениеПоПотребностям КАК ПротоколВыбораПобедителейРаспределениеПоПотребностям
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лот.Номенклатура КАК ЛотНоменклатура
		               |		ПО ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот = ЛотНоменклатура.Ссылка
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.Номенклатура = ЛотНоменклатура.Номенклатура
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.МестоПоставки = ЛотНоменклатура.МестоПоставки
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.Характеристика = ЛотНоменклатура.Характеристика
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.Назначение = ЛотНоменклатура.Назначение
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.ЦФО = ЛотНоменклатура.ЦФО
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.ЕдиницаИзмерения = ЛотНоменклатура.ЕдиницаИзмерения
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.Организация = ЛотНоменклатура.Организация
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.Проект = ЛотНоменклатура.Проект
		               |			И ПротоколВыбораПобедителейРаспределениеПоПотребностям.ПериодПотребности = ЛотНоменклатура.ПериодПотребности
		               |ГДЕ
		               |	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ПобедительПоПозиционномуРаспределению = ИСТИНА
		               |	И ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот = &Лот
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВременнаяТаблица.Номенклатура КАК Номенклатура,
		               |	ВременнаяТаблица.МестоПоставки КАК МестоПоставки,
		               |	СУММА(ВременнаяТаблица.Количество) КАК Количество,
		               |	ВременнаяТаблица.Цена КАК Цена,
		               |	СУММА(ВременнаяТаблица.Сумма) КАК Сумма,
		               |	ВременнаяТаблица.ПредложениеПоставщика КАК ПредложениеПоставщика,
		               |	ВременнаяТаблица.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ВременнаяТаблица.ЦенаЛота КАК ЦенаЛота,
		               |	ВременнаяТаблица.Характеристика КАК Характеристика,
		               |	ВременнаяТаблица.ДатаПоставки КАК ДатаПоставки,
		               |	ВременнаяТаблица.СуммаЛота КАК СуммаЛота,
		               |	ВременнаяТаблица.КоличествоЛота КАК КоличествоЛота
		               |ИЗ
		               |	ВременнаяТаблица КАК ВременнаяТаблица
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВременнаяТаблица.Характеристика,
		               |	ВременнаяТаблица.ДатаПоставки,
		               |	ВременнаяТаблица.Цена,
		               |	ВременнаяТаблица.МестоПоставки,
		               |	ВременнаяТаблица.ПредложениеПоставщика,
		               |	ВременнаяТаблица.Номенклатура,
		               |	ВременнаяТаблица.ЕдиницаИзмерения,
		               |	ВременнаяТаблица.ЦенаЛота,
		               |	ВременнаяТаблица.СуммаЛота,
		               |	ВременнаяТаблица.КоличествоЛота
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Номенклатура,
		               |	ДатаПоставки,
		               |	МестоПоставки,
		               |	ЕдиницаИзмерения,
		               |	Цена,
		               |	Количество УБЫВ,
		               |	Сумма
		               |ИТОГИ
		               |	СУММА(Количество),
		               |	СУММА(Сумма)
		               |ПО
		               |	Номенклатура,
		               |	МестоПоставки,
		               |	ЕдиницаИзмерения,
		               |	ЦенаЛота,СуммаЛота,КоличествоЛота,
		               |	ДатаПоставки"; 

		Выборка = Запрос.Выполнить();         
		
		Результат = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Результат.Следующий() Цикл 
			ВыборкаРезультат = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаРезультат.Следующий() Цикл
				ВыборкаРезультатЦены =  ВыборкаРезультат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
				Пока ВыборкаРезультатЦены.Следующий() Цикл            
					ВыборкаРезультатВсе =  ВыборкаРезультатЦены.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаРезультатВсе.Следующий() Цикл
						ВыборкаРезультатНоменклатураСумма = ВыборкаРезультатВсе.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока ВыборкаРезультатНоменклатураСумма.Следующий() Цикл
							ВыборкаРезультатНоменклатураКоличество = ВыборкаРезультатНоменклатураСумма.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
                            Пока ВыборкаРезультатНоменклатураКоличество.Следующий() Цикл

							ВыборкаРезультатНоменклатура = ВыборкаРезультатНоменклатураКоличество.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							Пока ВыборкаРезультатНоменклатура.Следующий() Цикл
								СтрокиНоменклатурПобедителейОстальные = Макет.ПолучитьОбласть("СтрокиНоменклатурыНеЛотовой"); 
								СтрокиНоменклатурПобедителейОстальные.Параметры.Номенклатура = Строка(ВыборкаРезультатНоменклатура.Номенклатура) +
								", "+ Строка(ВыборкаРезультатНоменклатура.ЕдиницаИзмерения)
								+ ", "+Строка(ВыборкаРезультатНоменклатура.Характеристика)
								+", "+Строка(ВыборкаРезультатНоменклатура.МестоПоставки);          
								СтрокиНоменклатурПобедителейОстальные.Параметры.Цена = ВыборкаРезультатНоменклатура.ЦенаЛота;  
								СтрокиНоменклатурПобедителейОстальные.Параметры.СуммаПлановая = ВыборкаРезультатНоменклатура.СуммаЛота; 
								СтрокиНоменклатурПобедителейОстальные.Параметры.СуммаПредложения = ВыборкаРезультатНоменклатура.Сумма;
								СтрокиНоменклатурПобедителейОстальные.Параметры.Экономия = ВыборкаРезультатНоменклатура.СуммаЛота -ВыборкаРезультатНоменклатура.Сумма ;
								СтрокиНоменклатурПобедителейОстальные.Параметры.Валюта = Строка.Лот.ВалютаДокумента ;
								СтрокиНоменклатурПобедителейОстальные.Параметры.Датапоставки = ВыборкаРезультатНоменклатура.Датапоставки ;
								
								СтрокиНоменклатурПобедителейОстальные.Параметры.Количество = ВыборкаРезультатНоменклатура.КоличествоЛота;
								СтрокиНоменклатурПобедителейОстальные.Параметры.ДатаПоставки = ВыборкаРезультатНоменклатура.ДатаПоставки;	
								ТД.Вывести(СтрокиНоменклатурПобедителейОстальные);     
								ВыборкаРезультатНоменклатураПредложения = ВыборкаРезультатНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
								Пока ВыборкаРезультатНоменклатураПредложения.Следующий() Цикл
									УчастникиПобедителей = Макет.ПолучитьОбласть("СтрокиПобедителяНеЛотовой"); 
									УчастникиПобедителей.Параметры.Экономия = ВыборкаРезультатНоменклатураПредложения.СуммаЛота -ВыборкаРезультатНоменклатураПредложения.Сумма ;
									УчастникиПобедителей.Параметры.Датапоставки = ВыборкаРезультатНоменклатура.Датапоставки ;
									
									УчастникиПобедителей.Параметры.Цена = ВыборкаРезультатНоменклатураПредложения.Цена;
									УчастникиПобедителей.Параметры.Количество = ВыборкаРезультатНоменклатураПредложения.Количество; 	
									Если ТипЗнч(ВыборкаРезультатНоменклатураПредложения.Номенклатура) = ТИП("СправочникСсылка.Номенклатура") Тогда 
										//УчастникиПобедителей.Параметры.СуммаПлановая = ВыборкаРезультатНоменклатураПредложения.Количество*ВыборкаРезультатНоменклатураПредложения.ЦенаЛота;
										УчастникиПобедителей.Параметры.Экономия = ВыборкаРезультатНоменклатураПредложения.Количество*ВыборкаРезультатНоменклатураПредложения.ЦенаЛота - ВыборкаРезультатНоменклатураПредложения.Количество*ВыборкаРезультатНоменклатураПредложения.Цена; 	
									Иначе
										УчастникиПобедителей.Параметры.Экономия = ВыборкаРезультатНоменклатураПредложения.СуммаЛота -ВыборкаРезультатНоменклатураПредложения.Сумма ; 
										//УчастникиПобедителей.Параметры.СуммаПлановая = ВыборкаРезультатНоменклатураПредложения.СуммаЛота;
									КонецЕсли;     
									
									СтрокиНоменклатурПобедителейОстальные.Параметры.ДатаПоставки = ВыборкаРезультатНоменклатураПредложения.ДатаПоставки;	
									УчастникиПобедителей.Параметры.Валюта = ВыборкаРезультатНоменклатураПредложения.ПредложениеПоставщика.ВалютаДокумента;
									УчастникиПобедителей.Параметры.СуммаПредложения = ВыборкаРезультатНоменклатураПредложения.Сумма;
									УчастникиПобедителей.Параметры.Предложение	 = Строка(ВыборкаРезультатНоменклатураПредложения.ПредложениеПоставщика.Контрагент)+", "+Строка(ВыборкаРезультатНоменклатураПредложения.ПредложениеПоставщика);
									ТД.Вывести(УчастникиПобедителей);     
								КонецЦикла; 
								КонецЦикла; 
								
							КонецЦикла;	
						КонецЦикла; 
					КонецЦикла;
					
				КонецЦикла;
			КонецЦикла;	
		КонецЦикла;	
		
	КонецЦикла;	
	
КонецПроцедуры

// Получить табличную часть протокола для документа по ссылке.
Функция ПолучитьТабличныйДокументПротокола(КонтекстПечати)
	ТД = Новый ТабличныйДокумент;
	// Заполняем таб. док.
	Макет = Отчеты.ПротоколЗакупочнойПроцедуры.ПолучитьМакет("Протокол");
	ЗаполнитьТаблицуПротокола(КонтекстПечати, Ложь, 0, ТД, Макет);
	Если КонтекстПечати.ТоргиСостоялись Тогда
		ТД.ВывестиГоризонтальныйРазделительСтраниц();
		ЗаполнитьТаблицуПриложениеПобедителей(КонтекстПечати, ТД, Макет, 1);
	ИначеЕсли КонтекстПечати.ТипПротокола = "ПротоколКвалификации" Тогда
		ЗаполнитьТаблицуПриложениеКвалификацииПоставщиков(КонтекстПечати, ТД, Макет, 1);
	КонецЕсли;
	Возврат ТД;
КонецФункции

Функция ПолучитьЗакупочнуюКомиссию(Контекст)
	Если Контекст.ТипПротокола = "КвалификацияПоставщика" Тогда
		ПриказОНазначении = Контекст.ПротоколСсылка.ПриказОНазначенииКомиссии;
	Иначе
		ПриказОНазначении = Контекст.ЗакупочнаяПроцедура.ПриказОНазначенииЗакупочнойКомиссии;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПриказОНазначении) Тогда
		Возврат ПриказОНазначении.ЗакупочнаяКомиссия.Выгрузить();
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СформироватьНаименованиеПротокола(КонтекстПечати)
	НаименованиеПротокола = "";
	ТипПротокола = КонтекстПечати.ТипПротокола;
	ЗакупочнаяПроцедура = КонтекстПечати.ЗакупочнаяПроцедура;
	Если КонтекстПечати.ТипПротокола = "ПротоколОтмены" Тогда
		Возврат НСтр("ru='отмены '");
	ИначеЕсли ТипПротокола = "ИтоговыйПротокол" Тогда
		Возврат НСтр("ru='подведения итогов '");
	ИначеЕсли ТипПротокола = "КвалификацияПоставщика" Тогда
		Возврат НСтр("ru='квалификации поставщика '");
	ИначеЕсли ТипПротокола = "ПротоколКвалификации" Тогда
		Возврат НСтр("ru='подведение итогов проведения квалификационного отбора '");
	КонецЕсли;
	
	Если ТипПротокола <> "ПротоколКвалификации" Тогда
		ПредставлениеСпособаВыбораПоставщика = 
			НРег(Перечисления.СпособыВыбораПоставщика.РодительныйПадеж(КонтекстПечати.СпособВыбораПоставщика));
		НовоеНаименование = НСтр("ru = '%НаименованиеПротокола% %ЗакрытаяЗакупка% %ПредставлениеСпособаВыбораПоставщика% %ВЭлектроннойФорме%'");
		НовоеНаименование = СтрЗаменить(НовоеНаименование, "%НаименованиеПротокола%", Строка(НаименованиеПротокола));
		НовоеНаименование = СтрЗаменить(НовоеНаименование, "%ЗакрытаяЗакупка%", Строка(?(ЗакупочнаяПроцедура.ЗакрытаяЗакупка, НСтр("ru = 'закрытого '"), НСтр("ru = 'открытого '"))));
		НовоеНаименование = СтрЗаменить(НовоеНаименование, "%ПредставлениеСпособаВыбораПоставщика%", Строка(ПредставлениеСпособаВыбораПоставщика));
		НовоеНаименование = СтрЗаменить(НовоеНаименование, "%ВЭлектроннойФорме%", НСтр("ru = ' в электронной форме'"));
	КонецЕсли;
	Возврат "";
КонецФункции


#КонецОбласти


