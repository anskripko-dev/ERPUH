		|	ПротоколВыбораПобедителейПредложенияПобедителей.СтавкаНДС КАК СтавкаНДС,
		|	СУММА(ПротоколВыбораПобедителейПредложенияПобедителей.Сумма) КАК Сумма
		|ИЗ
		|	РегистрСведений.ПоставщикиПоЛотам КАК ПротоколВыбораПобедителейПредложенияПобедителей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПротоколВыбораПобедителей.ПредложенияПобедителей КАК ПротоколВыбораПобедителейПредложенияПобедителей1
		|		ПО ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика = ПротоколВыбораПобедителейПредложенияПобедителей1.ПредложениеПоставщика
		|			И (ПротоколВыбораПобедителейПредложенияПобедителей1.Победитель = ИСТИНА)
		|ГДЕ
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Контрагент = &Поставщик
		|	И ПротоколВыбораПобедителейПредложенияПобедителей.Лот.Владелец = &Лот
		|	И ПротоколВыбораПобедителейПредложенияПобедителей1.Ссылка = &ПротоколСсылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПротоколВыбораПобедителейПредложенияПобедителей.СтавкаНДС,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Контрагент,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.ВалютаДокумента,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ЕдиницаИзмерения,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Номенклатура
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	Поставщик";
		
		ЗапросНоменклатураПоставщика.УстановитьПараметр("ПротоколСсылка", ПротоколСсылка);
		ЗапросНоменклатураПоставщика.УстановитьПараметр("Лот", Лот);
		ЗапросНоменклатураПоставщика.УстановитьПараметр("Поставщик",ВыборкаПобедителей.Поставщик);
		РезультатЗапросаПопредложениям = ЗапросНоменклатураПоставщика.Выполнить();
		Если НЕ РезультатЗапросаПопредложениям.Пустой() Тогда
			ВыборкаПобедителейПредлоежения = РезультатЗапросаПоПредложениям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПобедителейПредлоежения.Следующий() Цикл
				
				ТД.Вывести(Приложение1ПоставщикЦенаВыбраннаяНоменклатура);
				
				ВыборкаНоменклатурыДетальныеЗаписи = ВыборкаПобедителейПредлоежения.Выбрать(ОбходРезультатаЗапроса.Прямой);
				НомерСтрокиНоменклатуры = 1;
				Пока ВыборкаНоменклатурыДетальныеЗаписи.Следующий() Цикл
					Приложение1Номенклатура.Параметры.НомерНоменклатуры = НомерСтрокиНоменклатуры;
					Приложение1Номенклатура.Параметры.Номенклатура = ВыборкаНоменклатурыДетальныеЗаписи.Номенклатура;
					Приложение1Номенклатура.Параметры.ЕдиницаИзмерения = ВыборкаНоменклатурыДетальныеЗаписи.ЕдиницаИзмерения;
					Приложение1Номенклатура.Параметры.Количество = ВыборкаНоменклатурыДетальныеЗаписи.Количество;
					Приложение1Номенклатура.Параметры.СтавкаНДС = ВыборкаНоменклатурыДетальныеЗаписи.СтавкаНДС;
					Приложение1Номенклатура.Параметры.СуммаНДС = ВыборкаНоменклатурыДетальныеЗаписи.СуммаНДС;
					Приложение1Номенклатура.Параметры.Сумма = ВыборкаНоменклатурыДетальныеЗаписи.Сумма;
					
					ТД.Вывести(Приложение1Номенклатура);
					
					НомерСтрокиНоменклатуры = НомерСтрокиНоменклатуры + 1;
				КонецЦикла;
				
				ТД.Вывести(Приложение1НоменклатураПодвал);
			КонецЦикла;
		Иначе
			ДоговорНеЗаключается = Макет.ПолучитьОбласть("ДоговорНеЗаключается");
			ТД.Вывести(ДоговорНеЗаключается);
		КонецЕСли;
		
		
	КонецЦикла;
	
КонецПроцедуры
		
