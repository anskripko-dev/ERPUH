#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

	
#Область ПрограммныйИнтерфейс


// Сформировать табличный документ для указанного протокола закупки.
//
// Параметры:
//  ПротоколСсылка - ДокументСсылка.ПротоколВыбораПобедителей
//				   | ДокументСсылка.ПротоколОтменыЗакупочнойПроцедуры
//				   | ДокументСсылка.КвалификацияПоставщика - протокол,
//			для которого нужно сформировать печатную форму.
//  НастройкиПечати - Структура - свойства:
//		- ВыводитьНоменклатуруПоставщиков - Булево - показывать номенклатуру поставщиков.
//		- ТолькоПросмотр - Булево - настройка табличного документа.
//		- ОтображатьЗаголовки - Булево - настройка табличного документа.
//		- ОтображатьСетку - Булево - настройка табличного документа. 
//		- ОриентацияСтраницы - ОриентацияСтраницы - настройка табличного документа.
//		- АвтоМасштаб - Булево - настройка табличного документа. 
// 
// Возвращаемое значение:
//	- ТабличныйДокумент - печатная форма документа.
//	- Неопределено - возникла ошибки заполнения печатной формы. Пользователю
//		выдается сообщение(я) об ошибке.
//
Функция СформироватьПечатнуюФормуПротоколаПоДокументу(ПротоколСсылка, НастройкиПечати) Экспорт 
	Если НЕ ЗначениеЗаполнено(ПротоколСсылка) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не заполнена ссылка на протокол закупки!'");
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	ТипПротокола = ПолучитьТипПротокола(ПротоколСсылка);
	ЗакупочнаяПроцедура = ПротоколСсылка.ЗакупочнаяПроцедура;
	КонтекстПечати = СоздатьКонтекстПечати(
		ПротоколСсылка, ЗакупочнаяПроцедура, ТипПротокола, НастройкиПечати);
	Возврат ПроверитьСформироватьТабличныйДокумент(КонтекстПечати, НастройкиПечати);
КонецФункции

// Сформировать табличный документ для протокола.
//
// Параметры:
//  ЗакупочнаяПроцедура - СправочникСсылка.ЗакупочныеПроцедуры - закупка,
//			для которой будет сформирован протокол.
//	ТипПротокола - Строка - имя протокола для отображения:
//				- "ИтоговыйПротокол" - протокол выбора победителей;
//				- "ПротоколОтмены" - протокол отмены закупки;
//				- "КвалификацияПоставщика" - протокол квалификации поставщика;
//				- "ПротоколКвалификации" - итоговый протокол квалификации
//						в рамках закупочной процедуры.
//  НастройкиПечати - Структура - свойства:
//		- ВыводитьНоменклатуруПоставщиков - Булево - показывать номенклатуру поставщиков.
//		- ТолькоПросмотр - Булево - настройка табличного документа.
//		- ОтображатьЗаголовки - Булево - настройка табличного документа.
//		- ОтображатьСетку - Булево - настройка табличного документа. 
//		- ОриентацияСтраницы - ОриентацияСтраницы - настройка табличного документа.
//		- АвтоМасштаб - Булево - настройка табличного документа. 
// 
// Возвращаемое значение:
//	- ТабличныйДокумент - печатная форма документа.
//	- Неопределено - возникла ошибки заполнения печатной формы. Пользователю
//		выдается сообщение(я) об ошибке.
//
Функция СформироватьПечатнуюФормуПротоколаПоТипу(ЗакупочнаяПроцедура,
												 ТипПротокола,
												 НастройкиПечати) Экспорт
	Если НЕ ЗначениеЗаполнено(ЗакупочнаяПроцедура) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не указана закупка!'");
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	ПротоколСсылка = ПолучитьПротоколДляЗакупки(
		ЗакупочнаяПроцедура, ТипПротокола);
	КонтекстПечати = СоздатьКонтекстПечати(
		ПротоколСсылка, ЗакупочнаяПроцедура, ТипПротокола, НастройкиПечати);
	Возврат ПроверитьСформироватьТабличныйДокумент(КонтекстПечати, НастройкиПечати);
КонецФункции


#КонецОбласти


#Область ВнутреннийПрограммныйИнтерфейс


// Заполняет контекст формирования протокола данными. Частично
// из аргументов, частично из данных БД.
//
// Возвращает:
//	- ФиксированнаяСтруктура:
//		- ПротоколСсылка - ДокументСсылка | СправочникСсылка.ЗакупочныеПроцедуры -
//				источник данных протокола.
//		- ЗакупочнаяПроцедура - СправочникСсылка.ЗакупочныеПроцедуры.
//		- ТипПротокола - Строка.
//		- ВыводитьНоменклатуруПоставщиков - Булево.
//		- ОписаниеКомиссии - Неопределено | ТаблицаЗначений - описание
//				членов комиссии.
//		- ТоргиСостоялись - Булево - если печатаем протокол выбора победителя
//				и у него установлена соотвествующая пометка.
//		- ТребуетсяКвалификационныйОтбор - Булево - для закупки предусмотрен
//				квалификационный отбор.
//		- СпособВыбораПоставщика - ПеречислениеСсылка.СпособыВыбораПоставщиков -
//				способ выбора поставщика в рамках закупки.
//
Функция СоздатьКонтекстПечати(ПротоколСсылка,
							  ЗакупочнаяПроцедура,
							  ТипПротокола,
							  НастройкиПечати)
	КонтекстПечати = Новый Структура;
	флЕстьЗакупка = ЗначениеЗаполнено(ЗакупочнаяПроцедура);
	КонтекстПечати.Вставить("ПротоколСсылка", ПротоколСсылка);
	КонтекстПечати.Вставить("ЗакупочнаяПроцедура", ЗакупочнаяПроцедура);
	КонтекстПечати.Вставить("ТипПротокола", ТипПротокола);
	КонтекстПечати.Вставить("ВыводитьНоменклатуруПоставщиков",
		ПолучитьПараметрСтруктуры(НастройкиПечати,
			"ВыводитьНоменклатуруПоставщиков", Ложь));
	КонтекстПечати.Вставить("ОписаниеКомиссии",
		СформироватьОписаниеКомиссии(
			ПолучитьЗакупочнуюКомиссию(КонтекстПечати)));
	КонтекстПечати.Вставить("ТоргиСостоялись",
		ТипПротокола = "ИтоговыйПротокол"
		И ПротоколСсылка.ТоргиСостоялись);
	КонтекстПечати.Вставить("ТребуетсяКвалификационныйОтбор", 
		флЕстьЗакупка И ЗакупочнаяПроцедура.ТребуетсяКвалификационныйОтбор);
	КонтекстПечати.Вставить("СпособВыбораПоставщика",
		?(флЕстьЗакупка, ЗакупочнаяПроцедура.СпособВыбораПоставщика, Неопределено));
	Возврат Новый ФиксированнаяСтруктура(КонтекстПечати);
КонецФункции

Функция ПолучитьПротоколДляЗакупки(ЗакупочнаяПроцедура, ТипПротокола)
	Если ТипПротокола = "ПротоколКвалификации" Тогда
		// Закупка сейчас является единственным представителем итогового
		// протокола квалификации.
		Возврат ЗакупочнаяПроцедура;
	ИначеЕсли ТипПротокола = "ИтоговыйПротокол" Тогда
		Возврат Документы.ПротоколВыбораПобедителей.ПолучитьДляЗакупки(
			ЗакупочнаяПроцедура);
	ИначеЕсли ТипПротокола = "ПротоколОтмены" Тогда
		Возврат Документы.ПротоколОтменыЗакупочнойПроцедуры.ПолучитьДляЗакупки(
			ЗакупочнаяПроцедура);
	КонецЕсли;
	// В частности, протокол квалификации поставщика мы не можем
	// получить по закупочной процедуре.
	Возврат Неопределено;
КонецФункции

Функция ПроверитьСформироватьТабличныйДокумент(КонтекстПечати, НастройкиПечати)
	Если НЕ ПроверитьСообщитьПротоколКорректен(КонтекстПечати) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПечатнаяФорма = ПолучитьТабличныйДокументПротокола(КонтекстПечати);
	ОтформатироватьПоНастройкам(ПечатнаяФорма, НастройкиПечати);
	Возврат ПечатнаяФорма;
КонецФункции

// Проверяет протокол и его тип. Если есть ошибки, выводит их пользователю.
// Возвращает:
//	Булево - Если Истина - протокол корректен, можно формировать печ. форму.
//			 Если Ложь - печатную форму формировать нельзя.
//
Функция ПроверитьСообщитьПротоколКорректен(Контекст)
	Ошибки = Неопределено;
	Если НЕ ЗначениеЗаполнено(Контекст.ПротоколСсылка) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			Ошибки,
			,
			НСтр("ru='Печать невозможна. Не удалось определить протокол!'"),
			Неопределено);
	ИначеЕсли Контекст.ПротоколСсылка.ПометкаУдаления Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			Ошибки,
			,
			НСтр("ru='Печать невозможна. Протокол помечен на удаление!'"),
			Неопределено);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Контекст.ЗакупочнаяПроцедура) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			Ошибки,
			,
			НСтр("ru='Печать невозможна. Не удалось определить закупочную процедуру!'"),
			Неопределено);
	ИначеЕсли Контекст.ЗакупочнаяПроцедура.ПометкаУдаления Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			Ошибки,
			,
			НСтр("ru='Печать невозможна. Закупка помечена на удаление!'"),
			Неопределено);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Контекст.ТипПротокола) Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			Ошибки,
			,
			НСтр("ru='Печать невозможна. Не удалось определить тип протокола!'"),
			Неопределено);
	ИначеЕсли (Контекст.ТипПротокола = "КвалификацияПоставщика"
					ИЛИ Контекст.ТипПротокола = "ПротоколКвалификации")
				И НЕ Контекст.ТребуетсяКвалификационныйОтбор Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
			Ошибки,
			,
			НСтр("ru='Квалификация не предусмотрена для данной закупки!'"),
			Неопределено);
	КонецЕсли;
		
		
	Если Ошибки <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура ОтформатироватьПоНастройкам(ПечатнаяФорма, НастройкиФормирования)
	ПечатнаяФорма.ТолькоПросмотр = ПолучитьПараметрСтруктуры(НастройкиФормирования,
		"ТолькоПросмотр", Истина);
	ПечатнаяФорма.ОтображатьЗаголовки = ПолучитьПараметрСтруктуры(НастройкиФормирования,
		"ОтображатьЗаголовки", Ложь);
	ПечатнаяФорма.ОтображатьСетку = ПолучитьПараметрСтруктуры(НастройкиФормирования,
		"ОтображатьСетку", Ложь);
	ПечатнаяФорма.ОриентацияСтраницы = ПолучитьПараметрСтруктуры(НастройкиФормирования,
		"ОриентацияСтраницы", ОриентацияСтраницы.Портрет);
	ПечатнаяФорма.АвтоМасштаб = ПолучитьПараметрСтруктуры(НастройкиФормирования,
		"АвтоМасштаб", Истина);
КонецПроцедуры

// Получить тип протокола по ссылке.
//
Функция ПолучитьТипПротокола(ПротоколСсылка)
	ТипДокумента = ТипЗнч(ПротоколСсылка);
	Если ТипДокумента = Тип("ДокументСсылка.ПротоколВыбораПобедителей") Тогда
		Возврат "ИтоговыйПротокол";
	ИначеЕсли ТипЗнч(ПротоколСсылка) =
				Тип("ДокументСсылка.ПротоколОтменыЗакупочнойПроцедуры") Тогда	
		Возврат "ПротоколОтмены";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КвалификацияПоставщика") Тогда
		Возврат "КвалификацияПоставщика";
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НаименованиеОрганизации(Организация)
	Возврат ?(ПустаяСтрока(Организация.НаименованиеПолное), Организация.Наименование, Организация.НаименованиеПолное);
КонецФункции

Функция ПредставлениеОрганизацииДляОтчета(Организация)
	ПредставлениеЗаказчика = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		ПредставлениеОрганизации = НаименованиеОрганизации(Организация);
		АдресОрганизации = 
			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Организация, 
				УправлениеКонтактнойИнформациейВстраиваниеПереопределяемыйУХ.ВидКонтактнойИнформацииЮрАдресОрганизации(),
				'00010101');
		ПочтовыйАдресОрганизации = 
			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Организация, 
				УправлениеКонтактнойИнформациейВстраиваниеПереопределяемыйУХ.ВидКонтактнойИнформацииПочтовыйАдресОрганизации(),
				'00010101');
		ТелефонОрганизации = 
			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Организация, 
				УправлениеКонтактнойИнформациейВстраиваниеПереопределяемыйУХ.ВидКонтактнойИнформацииТелефонОрганизации(),
				'00010101');
		
		Если ЗначениеЗаполнено(АдресОрганизации) Тогда
			ПредставлениеАдреса = НСтр("ru = 'Юридический адрес: %АдресОрганизации%'");
			ПредставлениеАдреса = СтрЗаменить(ПредставлениеАдреса, "%АдресОрганизации%", Строка(АдресОрганизации));
			ПредставлениеОрганизации = ПредставлениеОрганизации + Символы.ПС + ПредставлениеАдреса;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПочтовыйАдресОрганизации) Тогда
			ПредставлениеАдреса = НСтр("ru = 'Почтовый адрес: %АдресОрганизации%'");
			ПредставлениеАдреса = СтрЗаменить(ПредставлениеАдреса, "%АдресОрганизации%", Строка(ПочтовыйАдресОрганизации));
			ПредставлениеОрганизации = ПредставлениеОрганизации + Символы.ПС + ПредставлениеАдреса;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТелефонОрганизации) Тогда
			ПредставлениеТелефона = НСтр("ru = ' Телефон: %ТелефонОрганизации%'");
			ПредставлениеТелефона = СтрЗаменить(ПредставлениеТелефона, "%ТелефонОрганизации%", Строка(ТелефонОрганизации));
			ПредставлениеОрганизации = ПредставлениеОрганизации + Символы.ПС + ПредставлениеТелефона;
		КонецЕсли;
	КонецЕсли;
		
	Возврат ПредставлениеОрганизации;
КонецФункции

Функция ПредставлениеПоставщикаДляОтчета(Контрагент)
	ПредставлениеКонтрагента = "";
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ПредставлениеКонтрагента = СокрЛП(Контрагент);
		АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент,
			УправлениеКонтактнойИнформациейВстраиваниеПереопределяемыйУХ.ВидКонтактнойИнформацииЮрАдресКонтрагента(),
			'00010101');
		ПочтовыйАдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, 
			УправлениеКонтактнойИнформациейВстраиваниеПереопределяемыйУХ.ВидКонтактнойИнформацииПочтовыйАдресКонтрагента(),
			'00010101');
		ТелефонКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, 
			УправлениеКонтактнойИнформациейВстраиваниеПереопределяемыйУХ.ВидКонтактнойИнформацииТелефонКонтрагента(),
			'00010101');
		
		Если ЗначениеЗаполнено(АдресКонтрагента) Тогда
			ПредставлениеАдреса = НСтр("ru = 'Юридический адрес: %АдресКонтрагента%'");
			ПредставлениеАдреса = СтрЗаменить(ПредставлениеАдреса, "%АдресКонтрагента%", Строка(АдресКонтрагента));
			ПредставлениеКонтрагента = ПредставлениеКонтрагента + Символы.ПС + ПредставлениеАдреса;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПочтовыйАдресКонтрагента) Тогда
			ПредставлениеАдреса = НСтр("ru = 'Почтовый адрес: %АдресКонтрагента%'");
			ПредставлениеАдреса = СтрЗаменить(ПредставлениеАдреса, "%АдресКонтрагента%", Строка(ПочтовыйАдресКонтрагента));
			ПредставлениеКонтрагента = ПредставлениеКонтрагента +  Символы.ПС + ПредставлениеАдреса;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТелефонКонтрагента) Тогда
			ПредставлениеТеоефона = НСтр("ru = 'Телефон %АдресКонтрагента%'");
			ПредставлениеТеоефона = СтрЗаменить(ПредставлениеТеоефона, "%АдресКонтрагента%", Строка(ТелефонКонтрагента));
			ПредставлениеКонтрагента = ПредставлениеКонтрагента +  Символы.ПС + ПредставлениеТеоефона;
		КонецЕсли;
	КонецЕсли;
		
	Возврат ПредставлениеКонтрагента;
КонецФункции

Функция ПредставленияКонтрагентаИННКПП(Контрагент)
	ПредставлениеКонтрагента = "";
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ПредставлениеКонтрагента = (Контрагент);
		ИНН = Контрагент.ИНН;
		КПП = Контрагент.КПП;
		
		Если ЗначениеЗаполнено(ИНН) Тогда
			ПредставлениеКонтрагента = СокрЛП(ПредставлениеКонтрагента) + "(" + ИНН;
			Если ЗначениеЗаполнено(КПП) Тогда
				ПредставлениеКонтрагента = ПредставлениеКонтрагента + "/" + КПП;
			КонецЕсли;
			ПредставлениеКонтрагента = ПредставлениеКонтрагента + ")";
		КонецЕсли;
	КонецЕсли;
		
	Возврат ПредставлениеКонтрагента;
КонецФункции

Процедура ЗаполнитьТаблицуНоменклатуры(Лот, ТД, ЗаголовокНоменклатуры, СтрокаНоменклатуры, ОбластьЗаголовокЛота)
	Если ТипЗнч(Лот) = Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЛотыНоменклатура.Номенклатура КАК Номенклатура,
		|	ЛотыНоменклатура.МестоПоставки КАК МестоПоставки,
		|	СУММА(ЛотыНоменклатура.Количество) КАК Количество,
		|	ЛотыНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЛотыНоменклатура.Ссылка КАК Ссылка,
		|	СУММА(ЛотыНоменклатура.Сумма) КАК Сумма
		|ИЗ
		|	Документ.Лот.Номенклатура КАК ЛотыНоменклатура
		|ГДЕ
		|	ЛотыНоменклатура.Ссылка.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура
		|	И НЕ ЛотыНоменклатура.Ссылка.ПометкаУдаления
		|	И ЛотыНоменклатура.Ссылка.Проведен
		|СГРУППИРОВАТЬ ПО
		|	ЛотыНоменклатура.Номенклатура,
		|	ЛотыНоменклатура.МестоПоставки,
		|	ЛотыНоменклатура.ЕдиницаИзмерения,
		|	ЛотыНоменклатура.Ссылка";
		
		Запрос.УстановитьПараметр("ЗакупочнаяПроцедура", Лот);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выгрузка = РезультатЗапроса.Выгрузить();
			ТаблицаСвертка = Выгрузка.Скопировать();
			ТаблицаСвертка.Свернуть("Ссылка");
			Для Каждого ТекТаблицаСвертка Из ТаблицаСвертка Цикл
				ОбластьЗаголовокЛота.Параметры.НаименованиеЛота = Строка(ТекТаблицаСвертка.Ссылка);
				ТД.Вывести(ОбластьЗаголовокЛота);
				ТД.Вывести(ЗаголовокНоменклатуры);
				НомерСтроки = 1;
				Для Каждого ТекВыгрузка Из Выгрузка Цикл
					Если ТекВыгрузка.Ссылка = ТекТаблицаСвертка.Ссылка Тогда
						СтрокаНоменклатуры.Параметры.НомерНоменклатуры	 = НомерСтроки;
						СтрокаНоменклатуры.Параметры.Номенклатура		 = ТекВыгрузка.Номенклатура;
						СтрокаНоменклатуры.Параметры.МестоПоставки		 = ТекВыгрузка.МестоПоставки;
						СтрокаНоменклатуры.Параметры.ЕдиницаИзмерения	 = ТекВыгрузка.ЕдиницаИзмерения;
						СтрокаНоменклатуры.Параметры.Количество			 = ТекВыгрузка.Количество;
						СтрокаНоменклатуры.Параметры.Сумма			 	 = ТекВыгрузка.Сумма;
						ТД.Вывести(СтрокаНоменклатуры);
						НомерСтроки = НомерСтроки + 1;
					КонецЕсли;
				КонецЦикла;					
			КонецЦикла;	
		КонецЕсли;
	Иначе
		Если Лот.Номенклатура.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТД.Вывести(ЗаголовокНоменклатуры);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛотыНоменклатура.Номенклатура КАК Номенклатура,
		|	ЛотыНоменклатура.МестоПоставки КАК МестоПоставки,
		|	СУММА(ЛотыНоменклатура.Количество) КАК Количество,
		|	ЛотыНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	Документ.Лот.Номенклатура КАК ЛотыНоменклатура
		|ГДЕ
		|	ЛотыНоменклатура.Ссылка = &Лот
		|	И ЛотыНоменклатура.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛотыНоменклатура.Номенклатура,
		|	ЛотыНоменклатура.МестоПоставки,
		|	ЛотыНоменклатура.ЕдиницаИзмерения";
		
		Запрос.УстановитьПараметр("Лот", Лот);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		НомерСтроки = 1;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СтрокаНоменклатуры.Параметры.НомерНоменклатуры = НомерСтроки;
			СтрокаНоменклатуры.Параметры.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			СтрокаНоменклатуры.Параметры.МестоПоставки = ВыборкаДетальныеЗаписи.МестоПоставки;
			СтрокаНоменклатуры.Параметры.ЕдиницаИзмерения = ВыборкаДетальныеЗаписи.ЕдиницаИзмерения;
			СтрокаНоменклатуры.Параметры.Количество = ВыборкаДетальныеЗаписи.Количество;
			ТД.Вывести(СтрокаНоменклатуры);
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры


Процедура ЗаполнитьТаблицуНоменклатурыЗонтичнойЗакупки(Лот, ТД, ОбластьЗаголовокЛотаЗонтичнойЗакупки, ШапкаРаспределенияЗонтичнойНоменклатуры, НоменклатураЗонтичногоРаспределения)
	
		Запрос = Новый Запрос;                        
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияРаспределенияЗонтичнойЗакупки.Номенклатура КАК Номенклатура,
		|	УсловияРаспределенияЗонтичнойЗакупки.МестоПоставки КАК МестоПоставки,
		|	УсловияРаспределенияЗонтичнойЗакупки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	УсловияРаспределенияЗонтичнойЗакупки.Ссылка КАК Ссылка,
		|	СУММА(УсловияРаспределенияЗонтичнойЗакупки.Количество) КАК Количество,
		|	УсловияРаспределенияЗонтичнойЗакупки.МестоПобедителя КАК МестоПобедителя,
		|	УсловияРаспределенияЗонтичнойЗакупки.Характеристика КАК Характеристика,
		|	УсловияРаспределенияЗонтичнойЗакупки.Процент КАК Процент
		|ИЗ
		|	Документ.Лот.УсловияРаспределенияЗонтичнойЗакупки КАК УсловияРаспределенияЗонтичнойЗакупки
		|ГДЕ
		|	УсловияРаспределенияЗонтичнойЗакупки.Ссылка.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура
		|	И НЕ УсловияРаспределенияЗонтичнойЗакупки.Ссылка.ПометкаУдаления   
		|	И УсловияРаспределенияЗонтичнойЗакупки.Ссылка.Проведен
		|	И УсловияРаспределенияЗонтичнойЗакупки.Ссылка.ВидЗакупки = ЗНАЧЕНИЕ(Перечисление.ВидЛотовойЗакупки.Зонтичная)
		|   И (УсловияРаспределенияЗонтичнойЗакупки.Процент > 0 ИЛИ УсловияРаспределенияЗонтичнойЗакупки.Количество > 0)
		|СГРУППИРОВАТЬ ПО
		|	УсловияРаспределенияЗонтичнойЗакупки.Номенклатура,
		|	УсловияРаспределенияЗонтичнойЗакупки.МестоПоставки,
		|	УсловияРаспределенияЗонтичнойЗакупки.ЕдиницаИзмерения,
		|	УсловияРаспределенияЗонтичнойЗакупки.Ссылка,
		|	УсловияРаспределенияЗонтичнойЗакупки.МестоПобедителя,
		|	УсловияРаспределенияЗонтичнойЗакупки.Характеристика,
		|	УсловияРаспределенияЗонтичнойЗакупки.Процент";
		
		Запрос.УстановитьПараметр("ЗакупочнаяПроцедура", Лот);
		Если ТипЗнч(Лот) <> Тип("СправочникСсылка.ЗакупочныеПроцедуры") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"Ссылка.Владелец","Ссылка");
		КонецЕсли;	
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выгрузка = РезультатЗапроса.Выгрузить();
			ТаблицаСвертка = Выгрузка.Скопировать();
			ТаблицаСвертка.Свернуть("Ссылка");
			ТаблицаСверткаНоменклатуры = Выгрузка.Скопировать();
			ТаблицаСверткаНоменклатуры.Свернуть("Ссылка,Номенклатура,МестоПоставки,ЕдиницаИзмерения,Характеристика");
			Для Каждого ТекТаблицаСвертка Из ТаблицаСвертка Цикл
				ОбластьЗаголовокЛотаЗонтичнойЗакупки.Параметры.НаименованиеЛота = Строка(ТекТаблицаСвертка.Ссылка);
				ТД.Вывести(ОбластьЗаголовокЛотаЗонтичнойЗакупки);
				ТД.Вывести(ШапкаРаспределенияЗонтичнойНоменклатуры);
				Для Каждого СтрокаСверткиНоменклатуры Из ТаблицаСверткаНоменклатуры Цикл
					Если СтрокаСверткиНоменклатуры.Ссылка = ТекТаблицаСвертка.Ссылка Тогда
						НоменклатураЗонтичногоРаспределения.Параметры.Номенклатура = Строка(СтрокаСверткиНоменклатуры.Номенклатура) + "; " +
						Строка(СтрокаСверткиНоменклатуры.ЕдиницаИзмерения) + "; " +
						Строка(СтрокаСверткиНоменклатуры.Характеристика) + "; " +
						Строка(СтрокаСверткиНоменклатуры.МестоПоставки) + "; ";
						НомерСтрокиНачало = ТД.ВысотаТаблицы + 1;
						Для Каждого ТекВыгрузка Из Выгрузка Цикл
							Если ТекВыгрузка.Ссылка = ТекТаблицаСвертка.Ссылка
								И ТекВыгрузка.Номенклатура = СтрокаСверткиНоменклатуры.Номенклатура
								И ТекВыгрузка.МестоПоставки = СтрокаСверткиНоменклатуры.МестоПоставки
								И ТекВыгрузка.ЕдиницаИзмерения = СтрокаСверткиНоменклатуры.ЕдиницаИзмерения
								И ТекВыгрузка.Характеристика = СтрокаСверткиНоменклатуры.Характеристика
								Тогда
								НоменклатураЗонтичногоРаспределения.Параметры.МестоПобедителя = ТекВыгрузка.МестоПобедителя;
								НоменклатураЗонтичногоРаспределения.Параметры.КоличествоПоПобедителю	= 
								?(ТипЗнч(ТекВыгрузка.Номенклатура) = Тип("СправочникСсылка.Номенклатура"),ТекВыгрузка.Количество,Строка(ТекВыгрузка.Процент)+"%");
								ТД.Вывести(НоменклатураЗонтичногоРаспределения);
							КонецЕсли;
						КонецЦикла;
						ТД.Область(НомерСтрокиНачало, 2, ТД.ВысотаТаблицы,7).Объединить();
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
		КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьТаблицуПобедителейЗонтичнойЗакупкиПоОценкеПоЦенам(ПротоколСсылка, ЗакупочнаяПроцедура, ТД, РешениеВыборПобедительЛотаЗонтичнойЗакупки, ШапкаРаспределенияЛота,СтрокаРаспределенияПобедителейЗонтичнойЗакупки )
		Запрос = Новый Запрос;                        
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Поставщик КАК Поставщик,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика КАК ПредложениеПоставщика,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Номер КАК Номер,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Дата КАК Дата,
		|	СУММА(ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.СуммаДокумента) КАК СуммаДокумента,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот КАК Лот
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ПротоколВыбораПобедителей.ПредложенияПобедителей КАК ПротоколВыбораПобедителейПредложенияПобедителей
		|ГДЕ
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Ссылка = &ПротоколСсылка
		|	И ПротоколВыбораПобедителейПредложенияПобедителей.Победитель = ИСТИНА
		|	И ПротоколВыбораПобедителейПредложенияПобедителей.Лот.ВидЗакупки = ЗНАЧЕНИЕ(Перечисление.ВидЛотовойЗакупки.Зонтичная)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Поставщик,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Номер,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика.Дата,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.Лот,
		|	ПротоколВыбораПобедителейПредложенияПобедителей.ПредложениеПоставщика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(УсловияПоНоменклатуре.Сумма) КАК Сумма,
		|	УсловияПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	УсловияПоНоменклатуре.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ СуммыПредложений
		|ИЗ
		|	Документ.ПредложениеПоставщика.УсловияПоНоменклатуре КАК УсловияПоНоменклатуре
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
		|		ПО УсловияПоНоменклатуре.Ссылка = ВТ.ПредложениеПоставщика
		|
		|СГРУППИРОВАТЬ ПО
		|	УсловияПоНоменклатуре.Номенклатура,
		|	УсловияПоНоменклатуре.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Номенклатура КАК Номенклатура,
		|	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Характеристика КАК Характеристика,
		|	ПротоколВыбораПобедителейРаспределениеПоПотребностям.МестоПоставки КАК МестоПоставки,
		|	ПротоколВыбораПобедителейРаспределениеПоПотребностям.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ.Поставщик КАК Поставщик,
		|	ВТ.Номер КАК Номер,
		|	СУММА(ПротоколВыбораПобедителейРаспределениеПоПотребностям.Сумма) КАК СуммаДокумента,
		|	СУММА(ПротоколВыбораПобедителейРаспределениеПоПотребностям.Количество) КАК Количество,
		|	ВТ.Дата КАК Дата,
		|	ПротоколВыбораПобедителейРаспределениеПоПотребностям.Лот КАК Лот,
