
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтотОбъект.СкомпоноватьРезультат();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СтандартнаяОбработка = Ложь;
	ВыборМенеджера(Расшифровка);
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет));
    
    ДоступныеДействия = Новый Массив;      
    ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
    
    ДополнительныеДействия = Новый СписокЗначений;
    ДополнительныеДействия.Добавить("ВыбратьМенеджера", Нстр("ru = 'Выбрать менеджера'"));
    ДополнительныеДействия.Добавить("ОчиститьМенеджера", Нстр("ru = 'Очистить менеджера'"));
    
    Оп = Новый ОписаниеОповещения("РезультатОбработкаРасшифровки_Продолжение", ЭтаФорма, Расшифровка);
    ОбработкаРасшифровки.ПоказатьВыборДействия(Оп, Расшифровка, ДоступныеДействия, ДополнительныеДействия, Ложь);
    
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки_Продолжение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
    Если ВыполненноеДействие = "ВыбратьМенеджера" Тогда
        ВыбратьМенеджера(Неопределено);
    ИначеЕсли ВыполненноеДействие = "ОчиститьМенеджера" Тогда
        ОчиститьМенеджера(Неопределено);
    ИначеЕсли ВыполненноеДействие=ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
        ПоказатьЗначение(Неопределено, ПараметрВыполненногоДействия);
    КонецЕсли;    
КонецПроцедуры    

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьМенеджера(Команда)
	ТабДокумент = Элементы.Результат;
	Если ТабДокумент.ТекущаяОбласть.Лево <> ТабДокумент.ТекущаяОбласть.Право ИЛИ ТабДокумент.ТекущаяОбласть.Верх <> ТабДокумент.ТекущаяОбласть.Низ Тогда	  
		ВыборМенеджера(ПолучитьМассивРасшифровок());
	Иначе
		ВыборМенеджера(ТабДокумент.ТекущаяОбласть.Расшифровка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьМенеджера(Команда)
	ТабДокумент = Элементы.Результат;
	Если ТабДокумент.ТекущаяОбласть.Лево <> ТабДокумент.ТекущаяОбласть.Право ИЛИ ТабДокумент.ТекущаяОбласть.Верх <> ТабДокумент.ТекущаяОбласть.Низ Тогда	  
		Если НЕ ПолучитьДанныеПоля(ПолучитьМассивРасшифровок()) Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Если НЕ ПолучитьДанныеПоля(ТабДокумент.ТекущаяОбласть.Расшифровка) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Для каждого ЭлементМассива Из ПереченьДанных Цикл
		ОчиститьМенеджераВБазе(ЭлементМассива.Организация, ЭлементМассива.КатегорияЗакупок);
	КонецЦикла;
	ЭтотОбъект.СкомпоноватьРезультат();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьДанныеПоля(ИдентификаторРасшифровки)
	Если ИдентификаторРасшифровки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	МассивДанныхРасшифровки = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	МассивДанных = Новый Массив;
	Если ТипЗнч(ИдентификаторРасшифровки) = Тип("Массив") Тогда
		Для каждого ЭлементРасшифровки Из ИдентификаторРасшифровки Цикл
			Элемент = МассивДанныхРасшифровки.Элементы[ЭлементРасшифровки];
			Если Элемент.ПолучитьРодителей().Количество() < 2 Тогда 
				Продолжить;
			КонецЕсли;
			СтруктураПолей = Новый Структура("Организация", "ТоварнаяКатегория");
			Родитель1 = Элемент.ПолучитьРодителей()[0].ПолучитьПоля()[0];
			Родитель2 = Элемент.ПолучитьРодителей()[1].ПолучитьПоля()[0];
			СтруктураПолей.Вставить(Родитель1.Поле, Родитель1.Значение);
			СтруктураПолей.Вставить(Родитель2.Поле, Родитель2.Значение);
			МассивДанных.Добавить(СтруктураПолей);
		КонецЦикла;
	Иначе
		Элемент = МассивДанныхРасшифровки.Элементы[ИдентификаторРасшифровки];
		Если Элемент.ПолучитьРодителей().Количество() < 2 Тогда 
			Возврат Ложь;
		КонецЕсли;
		СтруктураПолей = Новый Структура("Организация", "ТоварнаяКатегория");
		Родитель1 = Элемент.ПолучитьРодителей()[0].ПолучитьПоля()[0];
		Родитель2 = Элемент.ПолучитьРодителей()[1].ПолучитьПоля()[0];
		СтруктураПолей.Вставить(Родитель1.Поле, Родитель1.Значение);
		СтруктураПолей.Вставить(Родитель2.Поле, Родитель2.Значение);
		МассивДанных.Добавить(СтруктураПолей);
	КонецЕсли;
	ПереченьДанных = Новый ФиксированныйМассив(МассивДанных);
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ВыборМенеджера(Расшифровка)
	Если ПолучитьДанныеПоля(Расшифровка) Тогда
		ПараметрыФормы  = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Истина);
    	ОбработкаВыбора = Новый ОписаниеОповещения("ВыбратьЭлементСправочникаКонец", ЭтаФорма);
        ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , ОбработкаВыбора);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЭлементСправочникаКонец(Значение, ДопПараметры) Экспорт
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для каждого ЭлементМассива Из ПереченьДанных Цикл
		ЗаписатьМенеджераВБазе(ЭлементМассива.Организация, ЭлементМассива.КатегорияЗакупок, Значение);
	КонецЦикла;
	ЭтотОбъект.СкомпоноватьРезультат();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьМенеджераВБазе(Организация, Категория, Менеджер)
	МенеджерЗаписи = РегистрыСведений.ПолномочияКатегорийныхМенеджеров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.ТоварнаяКатегория = Категория;
	МенеджерЗаписи.Менеджер = Менеджер;
	МенеджерЗаписи.Записать();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьМенеджераВБазе(Организация, Категория)
	Набор = РегистрыСведений.ПолномочияКатегорийныхМенеджеров.СоздатьНаборЗаписей();
	Набор.Отбор.Организация.Установить(Организация);
	Набор.Отбор.ТоварнаяКатегория.Установить(Категория);
	Набор.Записать();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивРасшифровок()
	МассивИдентификаторовРасшифровки = Новый Массив;
	Для каждого ВыделеннаяОбласть Из Результат.ВыделенныеОбласти Цикл
		Если ТипЗнч(ВыделеннаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Для НомерСтолбца = ВыделеннаяОбласть.Лево По ВыделеннаяОбласть.Право Цикл
				Для НомерСтроки = ВыделеннаяОбласть.Верх По ВыделеннаяОбласть.Низ Цикл
					Ячейка = Результат.Область(НомерСтроки, НомерСтолбца, НомерСтроки, НомерСтолбца);
					Если Ячейка.ТипОбласти <> ПредопределенноеЗначение("ТипОбластиЯчеекТабличногоДокумента.Прямоугольник") Тогда
						Продолжить;
					КонецЕсли;
					Если Ячейка.Расшифровка <> Неопределено Тогда
						МассивИдентификаторовРасшифровки.Добавить(Ячейка.Расшифровка);
					КонецЕсли;	
				КонецЦикла;
			КонецЦикла;	
		КонецЕсли;		
	КонецЦикла;
	Возврат МассивИдентификаторовРасшифровки;
КонецФункции

#КонецОбласти

