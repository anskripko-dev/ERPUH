#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда	
	
#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// Для общей формы "Форма отчета" подсистемы "Варианты отчетов".
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	
	Настройки.События.ПриОпределенииПараметровВыбора = Истина;
	                                                                      
	Настройки.События.ПослеЗаполненияПанелиБыстрыхНастроек = Истина;
	
	Настройки.События.ПриЗагрузкеВариантаНаСервере = Истина;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	РазрешеноИзменятьВарианты = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Форма.НастройкиОтчета, "РазрешеноИзменятьВарианты", Ложь);
	
	Если РазрешеноИзменятьВарианты Тогда
		Форма.НастройкиОтчета.Вставить("ФормаНастроекРасширенныйРежим", 1);
	КонецЕсли;
	
	ИмяКоманды = "ПодключаемыйРасшифровать";
	Заголовок = "Действия";
	Если Форма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = Форма.Команды.Добавить(ИмяКоманды);
		Команда.Действие  = "УправлениеЛимитамиУХКлиент.ОтчетПоЛимитамРасшифровать";
		Команда.Заголовок = Заголовок;
		#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда		
		ОтчетыСервер.ВывестиКоманду(Форма, Команда, "Главное", , , );
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

// См. ОтчетыПереопределяемый.ПриОпределенииПараметровВыбора.
Процедура ПриОпределенииПараметровВыбора(Форма, СвойстваНастройки) Экспорт
	
	СвойстваНастройки.Глобальная = Ложь;
	СвойстваНастройки.ВыводРазрешен = Ложь;

	
	Если СвойстваНастройки.ПолеКД = Новый ПолеКомпоновкиДанных("ПараметрыДанных.Год") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПараметрыЛимитирования.Период КАК Период
			|ИЗ
			|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период УБЫВ";
		
		РезультатЗапроса = Запрос.Выполнить();
		ПериодыЛимитирования = РезультатЗапроса.Выбрать();
		СвойстваНастройки.ЗначенияДляВыбора.Очистить();
		Пока ПериодыЛимитирования.Следующий() Цикл
			СвойстваНастройки.ЗначенияДляВыбора.Добавить(ПериодыЛимитирования.Период,
															Формат(ПериодыЛимитирования.Период, "ДФ='dd.MM.yyyy ''г.'"));												
		КонецЦикла; 

		СвойстваНастройки.ПользовательскаяНастройкаКД.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		Если Не ЗначениеЗаполнено(СвойстваНастройки["ПользовательскаяНастройкаКД"]["Значение"]) И СвойстваНастройки.ЗначенияДляВыбора.Количество() Тогда
			ЗначениеТекущегоГода = СвойстваНастройки.ЗначенияДляВыбора.НайтиПоЗначению(Год(НачалоГода(ТекущаяДата())));
			Если ЗначениеТекущегоГода = Неопределено Тогда
				СвойстваНастройки["ПользовательскаяНастройкаКД"]["Значение"] = СвойстваНастройки.ЗначенияДляВыбора[0].Значение;	
			Иначе
				СвойстваНастройки["ПользовательскаяНастройкаКД"]["Значение"] = ЗначениеТекущегоГода.Значение;	
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СвойстваНастройки.ПолеКД = Новый ПолеКомпоновкиДанных("ПараметрыДанных.ВидБюджета") Тогда
		СвойстваНастройки.ПользовательскаяНастройкаКД.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗагрузкеВариантаНаСервере(Форма, НовыеНастройкиКД) Экспорт
	ОбновитьЭлементыФормы(Форма);
	ОбновитьЗаголовкиОтборов(Форма);
КонецПроцедуры

Процедура ПослеЗаполненияПанелиБыстрыхНастроек(Форма, ПараметрыЗаполнения) Экспорт
	ОбновитьЭлементыФормы(Форма);
	ОбновитьЗаголовкиОтборов(Форма);
КонецПроцедуры

Процедура ОбновитьЗаголовкиОтборов(Знач Форма)
	
	ШаблонИмениРеквизита = "КомпоновщикНастроекПользовательскиеНастройкиЭлемент%1Значение";
	КоличествоПользовательскихНастроек = 15;
	Для Номер = 0 По КоличествоПользовательскихНастроек Цикл
		ИмяЭлемента = СтрШаблон(ШаблонИмениРеквизита, Номер);
		Элемент = Форма.Элементы.Найти(ИмяЭлемента);
		Если Элемент <> неопределено Тогда
			Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьЭлементыФормы(Знач Форма)
	
	Если Форма.ИмяФормы <> "Отчет." + Метаданные().Имя + ".Форма" Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементНастроек Из Форма.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастроек) <> Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
			
		ПараметрКомпоновкиДанныхГод 		= Новый ПараметрКомпоновкиДанных("Год");
		ПараметрКомпоновкиДанныхВидБюджета 	= Новый ПараметрКомпоновкиДанных("ВидБюджета");
		Если ЭлементНастроек.Параметр = ПараметрКомпоновкиДанныхГод Тогда
			
			ЭлементНастройкиЗаголовок = Неопределено;
            ЭлементНастройкиЗначение = Неопределено;
			
            ОбновитьСтандартныеЭлементыФормы(Форма, ЭлементНастроек, ЭлементНастройкиЗаголовок, ЭлементНастройкиЗначение);
			Если ЭлементНастройкиЗначение <> Неопределено Тогда
				ОбновитьГруппыФормы(Форма, ЭлементНастройкиЗаголовок, ЭлементНастройкиЗначение);
			КонецЕсли;
			
			Для Каждого ЭлементПараметр Из Форма.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.ДоступныеПараметры.Элементы Цикл
				Если ЭлементПараметр.Параметр = ПараметрКомпоновкиДанныхГод Тогда
					ДоступныеЗначения = ЭлементПараметр.ДоступныеЗначения;	
				КонецЕсли;
			КонецЦикла;
			
			Если ЭлементНастройкиЗначение <> Неопределено Тогда 
				ТекущееЗначение = ЭлементНастройкиЗначение.СписокВыбора.НайтиПоЗначению(ЭлементНастроек.Значение);
			Иначе
				ТекущееЗначение = ДоступныеЗначения.НайтиПоЗначению(ЭлементНастроек.Значение); 
			КонецЕсли;
			
			Если ТекущееЗначение <> Неопределено Тогда
				ЗаголовокГода = ТекущееЗначение.Представление;
			Иначе
				ЗаголовокГода = Формат(ЭлементНастроек.Значение, "ДФ='dd.MM.yyyy ''г.'");	
			КонецЕсли;
			
			ДобавитьКомандуВГруппу(Форма, 
									Форма.Элементы.ГруппаНастроекГода, 
									"КомандаСтрелкаВлево", 	
									НСтр("ru = '<<'"), 
									ВидКнопкиФормы.Гиперссылка);
			ДобавитьКомандуВГруппу(Форма, 
									Форма.Элементы.ГруппаНастроекГода, 
									"КомандаГод", 			
									ЗаголовокГода, 
									ВидКнопкиФормы.Гиперссылка);
			ДобавитьКомандуВГруппу(Форма, 
									Форма.Элементы.ГруппаНастроекГода, 
									"КомандаСтрелкаВправо", 	
									НСтр("ru = '>>'"), 
									ВидКнопкиФормы.Гиперссылка);
									
			Шрифт = Новый Шрифт(, 11, Истина);
			Форма.Элементы.КомандаГод.Шрифт = Шрифт;
							
		ИначеЕсли ЭлементНастроек.Параметр = ПараметрКомпоновкиДанныхВидБюджета Тогда
			
			ЭлементНастройкиЗаголовок = Неопределено;
            ЭлементНастройкиЗначение = Неопределено;
			
            ОбновитьСтандартныеЭлементыФормы(Форма, ЭлементНастроек, ЭлементНастройкиЗаголовок, ЭлементНастройкиЗначение);
			
			ОбновитьГруппыФормы(Форма, ЭлементНастройкиЗаголовок, ЭлементНастройкиЗначение);
			
			ТекущееЗначение = ЭлементНастроек.Значение;
			Если ТекущееЗначение = Неопределено Тогда
				ЭлементНастроек.Значение = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
				ТекущееЗначение = ЭлементНастроек.Значение;
			КонецЕсли;
			
			ДобавитьКомандуВГруппу(Форма, 
									Форма.Элементы.ГруппаКнопокНастройкиБюджетаПанельКоманднаяПанель, 
									"БюджетДвиженияДенежныхСредств", 	
									НСтр("ru = 'БДДС'"), 
									ВидКнопкиФормы.ОбычнаяКнопка);
			ДобавитьКомандуВГруппу(Форма, 
									Форма.Элементы.ГруппаКнопокНастройкиБюджетаПанельКоманднаяПанель, 
									"БюджетДоходовИРасходов", 			
									НСтр("ru = 'БДР'"), 
									ВидКнопкиФормы.ОбычнаяКнопка);
									
			Форма.Элементы.БюджетДвиженияДенежныхСредств.Пометка 	= (ТекущееЗначение = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
			Форма.Элементы.БюджетДоходовИРасходов.Пометка 			= (ТекущееЗначение = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
				
		КонецЕсли;
		
	КонецЦикла;
	
	УправлениеЛимитамиУХ.ОбрабткаВложеннойФормы(Форма, Форма.Параметры);

КонецПроцедуры

Процедура ОбновитьСтандартныеЭлементыФормы(Знач Форма, ЭлементНастроек, ЭлементНастройкиЗаголовок, ЭлементНастройкиЗначение)
	
	ИндексНастроек = Форма.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Индекс(ЭлементНастроек);
	ЭлементНастроек.Использование = Истина;
	
	ЭлементНастройкиЗначение = Форма.Элементы.Найти(СтрШаблон("КомпоновщикНастроекПользовательскиеНастройкиЭлемент%1Значение", ИндексНастроек));
	Если ЭлементНастройкиЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементНастройкиЗаголовок = Форма.Элементы.Найти(СтрШаблон("КомпоновщикНастроекПользовательскиеНастройкиЭлемент%1Использование", ИндексНастроек));
	ЭлементНастройкиЗаголовок.Видимость = Ложь;
	ЭлементНастройкиЗначение.Видимость = Ложь;

КонецПроцедуры

Процедура ОбновитьГруппыФормы(Знач Форма, Знач ЭлементНастройкиЗаголовок, Знач ЭлементНастройкиЗначение)
	
	ПанельПараметров = Форма.Элементы.Найти("ПанельУправленияПараметрами");   
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	Если ПанельПараметров = Неопределено Тогда
			Родитель = Неопределено;
			ПередЭлементом = Форма.Элементы.Найти("ПанельБыстрыхНастроек");  
			ПанельПараметров = ФормыУХ.СоздатьГруппуФормы(Форма.Элементы, 
									"ПанельУправленияПараметрами", 
									"Панель настройки параметров", 
									ВидГруппыФормы.ОбычнаяГруппа,
									Родитель, 
									ПередЭлементом,
									Новый Структура("РастягиватьПоГоризонтали, ОтображатьЗаголовок", Истина, Ложь)); 
	КонецЕсли;
								
	ПанельПараметровЛеваяКолонка = Форма.Элементы.Найти("ПанельУправленияПараметрамиЛеваяКолонка");
	Если ПанельПараметровЛеваяКолонка = Неопределено Тогда
			Родитель = ПанельПараметров;
			ПередЭлементом = Неопределено;   
			ПанельПараметровЛеваяКолонка = ФормыУХ.СоздатьГруппуФормы(Форма.Элементы, 
									"ПанельУправленияПараметрамиЛеваяКолонка", 
									"Панель настройки параметров (левая колонка)", 
									ВидГруппыФормы.ОбычнаяГруппа,
									Родитель, 
									ПередЭлементом,
									Новый Структура("РастягиватьПоГоризонтали, ОтображатьЗаголовок", Истина, Ложь));
	КонецЕсли;
							
		
	ГруппаНастроекГода = Форма.Элементы.Найти("ГруппаНастроекГода");
	Если ГруппаНастроекГода = Неопределено Тогда
		ГруппаНастроекГода = ФормыУХ.СоздатьГруппуФормы(Форма.Элементы,
														"ГруппаНастроекГода",,
														ВидГруппыФормы.ОбычнаяГруппа, 
														ПанельПараметровЛеваяКолонка,,
														Новый Структура("РастягиватьПоГоризонтали, ОтображатьЗаголовок", Истина, Ложь));
	КонецЕсли;  
	
	ДекорацияДействуетС = Форма.Элементы.Найти("ДекорацияДействуетС");  
	Если ДекорацияДействуетС = Неопределено Тогда
		ДекорацияДействуетС = ФормыУХ.СоздатьДекорациюФормы(Форма.Элементы, 
													"ДекорацияДействуетС", 
													Нстр("ru = 'Действует с'"), 
													Неопределено, 
													ГруппаНастроекГода);
	КонецЕсли;  
		
	ГруппаКнопокНастройкиБюджетаПанель = Форма.Элементы.Найти("ГруппаКнопокНастройкиБюджетаПанель");
	Если ГруппаКнопокНастройкиБюджетаПанель = Неопределено Тогда
		ГруппаКнопокНастройкиБюджетаПанель = ФормыУХ.СоздатьГруппуФормы(Форма.Элементы,
																		"ГруппаКнопокНастройкиБюджетаПанель",,
																		ВидГруппыФормы.КоманднаяПанель, 
																		ПанельПараметровЛеваяКолонка, 
																		ГруппаНастроекГода);
		ГруппаКнопокНастройкиБюджетаПанель.РастягиватьПоГоризонтали = Ложь; 
		
		ГруппаКнопокНастройкиБюджетаПанельКоманднаяПанель = ФормыУХ.СоздатьГруппуФормы(Форма.Элементы,
																		"ГруппаКнопокНастройкиБюджетаПанельКоманднаяПанель",,
																		ВидГруппыФормы.ГруппаКнопок, 
																		ГруппаКнопокНастройкиБюджетаПанель, 
																		Неопределено);
		ГруппаКнопокНастройкиБюджетаПанельКоманднаяПанель.Отображение = ОтображениеГруппыКнопок.Компактное;
		
	КонецЕсли;  
	#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьКомандуВГруппу(Форма, ГруппаНастроекГода, ИмяКоманды, Заголовок, Вид)
	
	Перем Кнопка, Команда;
	
	Если Форма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = Форма.Команды.Добавить(ИмяКоманды);
		Команда.Действие  = "Подключаемый_Команда";
		Команда.Заголовок = Заголовок;
	КонецЕсли;
	Если Форма.Элементы.Найти(ИмяКоманды) = Неопределено Тогда
		Кнопка = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ГруппаНастроекГода);
		Кнопка.ИмяКоманды = ИмяКоманды;
		Кнопка.Вид = Вид;
		Кнопка.Заголовок = Заголовок; 
	Иначе
		Форма.Элементы[ИмяКоманды].Заголовок = Заголовок;	
	КонецЕсли;
	Если Форма.ПостоянныеКоманды.НайтиПоЗначению(ИмяКоманды) = Неопределено Тогда
		Форма.ПостоянныеКоманды.Добавить(Команда.Имя, "КонтрольУХКлиент.ОбработкаКомандыОтчетПоЛимитам");
	КонецЕсли;

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;  
	
	ДокументРезультат.Очистить();
	ПараметрКомпоновкиДанныхВидБюджета = Новый ПараметрКомпоновкиДанных("ВидБюджета");
	ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.ПустаяСсылка();
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
