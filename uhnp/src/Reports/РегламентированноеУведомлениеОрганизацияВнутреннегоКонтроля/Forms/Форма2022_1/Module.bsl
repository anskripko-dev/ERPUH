&НаСервере
Функция ТаблицаЗаменИменМногострочныхЧастей()
	Замены = Новый Соответствие;
	Макет = Отчеты.РегламентированноеУведомлениеОрганизацияВнутреннегоКонтроля.ПолучитьМакет("СоответствиеПроверочныхЛистов_2022");
	Для Инд = 1 По Макет.ВысотаТаблицы Цикл 
		Замены.Вставить("МнгСтр" + (Инд + 2), Макет.Область(Инд, 1, Инд, 1).Текст);
	КонецЦикла;

	Возврат Замены;
КонецФункции

&НаКлиенте
Процедура ПриложенныеФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПриложенныеФайлыВыборАсинх(Элемент, ВыбраннаяСтрока, Поле);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПриложенныеФайлыВыборАсинх(Элемент, ВыбраннаяСтрока, Поле)
	ТекущиеДанные = ПриложенныеФайлы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если УведомлениеОСпецрежимахНалогообложенияКлиент.УровеньГруппировкиВДереве(ТекущиеДанные) = 0 Тогда
		РезультатВопроса = Ждать ВвестиСтрокуАсинх(ТекущиеДанные.Документ, "Введите наименование, реквизиты и прочие признаки документа");
		Если ЗначениеЗаполнено(РезультатВопроса) Тогда 
			ТекущиеДанные.Документ = РезультатВопроса;
			Модифицированность = Истина;
		КонецЕсли;
	Иначе
		РаботаСФайламиКлиент.ОткрытьФайл(УведомлениеОСпецрежимахНалогообложенияВызовСервера.ДанныеФайла(ТекущиеДанные.ПрисоединенныйФайл), Ложь);
	КонецЕсли;
КонецПроцедуры

