	Стр = Результат.Добавить();
	Стр.ИмяФормы = "Форма2021_1";
	Стр.ОписаниеФормы = "Форма информации об организации системы внутреннего контроля в формате 5.04";
	Стр.ДатаНачала = '20201001';
	Стр.ДатаКонца = '20991231';

	Стр = Результат.Добавить();
