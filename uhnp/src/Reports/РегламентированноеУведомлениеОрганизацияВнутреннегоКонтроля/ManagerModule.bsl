Процедура ЗаполнитьДанными_Форма2021_1(Объект, Параметры, ДеревоВыгрузки, СписокФайлов, ИменаФайлов)
	Документы.УведомлениеОСпецрежимахНалогообложения.ОбработатьУсловныеЭлементы(Параметры, ДеревоВыгрузки);
	Документы.УведомлениеОСпецрежимахНалогообложения.ЗаполнитьПараметрыСРазделами(Параметры, ДеревоВыгрузки);
	ДанныеУведомления = Объект.ДанныеУведомления.Получить();
	УведомлениеОСпецрежимахНалогообложения.ЗаполнитьДаннымиУзелНов(ДанныеУведомления, ДеревоВыгрузки);
	
	ДатаИмФайла = Формат(ТекущаяДатаСеанса(), "ДФ=_yyyyMMdd_");
	Узел_Документ = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(ДеревоВыгрузки, "Документ");
	Узел_ОргСВК = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(Узел_Документ, "ОргСВК");
	Узел_ДокСкан = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(Узел_ОргСВК, "ДокСкан");
	Для Каждого Стр0 Из ДанныеУведомления.ПриложенныеФайлы.Строки Цикл
		УИД1 = Строка(Новый УникальныйИдентификатор);
		НовУзел_ДокСкан = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ДокСкан);
		Документы.УведомлениеОСпецрежимахНалогообложения.УстановитьЗначениеЭлемента(НовУзел_ДокСкан, "НаимДок", Стр0.Документ);
		Документы.УведомлениеОСпецрежимахНалогообложения.УстановитьЗначениеЭлемента(НовУзел_ДокСкан, "КНДДок", "1125315");
		
		Узел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПодчиненныйЭлемент(НовУзел_ДокСкан, "ИмяФайл");
		Для Каждого Стр1 Из Стр0.Строки Цикл
			УИД2 = Строка(Новый УникальныйИдентификатор);
			НовУзел_ИмяФайл = Документы.УведомлениеОСпецрежимахНалогообложения.НовыйУзелИзПрототипа(Узел_ИмяФайл);
			ИмяФайлаПрод = "1125315_" + Параметры.ИННЮЛ + Параметры.КПП + "_"  + Параметры.КодНО 
							+ "_" + УИД1 + ДатаИмФайла + УИД2 + ".pdf";
			РегламентированнаяОтчетность.ВывестиПоказательСтатистикиВXML(НовУзел_ИмяФайл, ИмяФайлаПрод);
			
			ИменаФайлов.Добавить(ИмяФайлаПрод);
			СписокФайлов.Добавить(Стр1.ПрисоединенныйФайл);
		КонецЦикла;
	КонецЦикла;
	РегламентированнаяОтчетность.УдалитьУзел(Узел_ДокСкан);
	Документы.УведомлениеОСпецрежимахНалогообложения.ОтсечьНезаполненныеНеобязательныеУзлы(ДеревоВыгрузки);
КонецПроцедуры

Процедура ВыводТитульнойСтраницы(Объект, МакетПФ, ПечатнаяФорма, ДанныеУведомления)
	Заголовок = МакетПФ.ПолучитьОбласть("Заголовок");
	Титульная = ДанныеУведомления.ДанныеУведомления.Титульная;
	ЗаполнитьЗначенияСвойств(Заголовок.Параметры,
		РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Объект.Организация, ТекущаяДатаСеанса(), "НаимЮЛПол,НаимЮЛСокр"));
	ЗаполнитьЗначенияСвойств(Заголовок.Параметры, Титульная);
	
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.ИНН, "ИНН", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КПП, "КПП", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(Титульная.КодНО, "КодНО", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(
		Формат(Титульная.ДАТА_ПОДПИСИ, "ДФ=ddMMyyyy"), "ДатаПодписи", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титульная, "ГодНМ"), "ГодНМ", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титульная, "ГодНМ"), "Период", Заголовок.Области, "-");
	УведомлениеОСпецрежимахНалогообложения.ВывестиСтрокуНаПечать(
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титульная, "НомерРед"), "НомерРед", Заголовок.Области, "-");
	
	ПечатнаяФорма.Вывести(Заголовок);
КонецПроцедуры

Функция СформироватьСписокЛистовФорма2021_1(Объект) Экспорт
	ОТЧ = Новый ОписаниеТипов("Число");
	СоответствиеПроверочныхЛистов = Отчеты[Объект.ИмяОтчета].ПолучитьМакет("СоответствиеПроверочныхЛистов");
	
	Листы = Новый СписокЗначений;
	ПечатнаяФорма = УведомлениеОСпецрежимахНалогообложения.НовыйПустойЛист();
	ПечатнаяФорма.ОриентацияСтраницы  = ОриентацияСтраницы.Ландшафт;
	МакетПФ = Отчеты[Объект.ИмяОтчета].ПолучитьМакет("ПечатныйБланк_2021");
	ДанныеУведомления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеУведомления").Получить();
	
	ВыводТитульнойСтраницы(Объект, МакетПФ, ПечатнаяФорма, ДанныеУведомления);
	
	Приложение1 = МакетПФ.ПолучитьОбласть("Приложение1");
	ЗаполнитьЗначенияСвойств(Приложение1.Параметры, ДанныеУведомления.ДанныеУведомления.ОбщПолож);
	ПечатнаяФорма.Вывести(Приложение1);
	
	СчетчикВМакетеСоответствия = 0;
	МассивСтрокПФ = Новый Массив;
	МассивСтрокПФ.Вставить(1, Новый Структура("Верх, Низ", 41, 43));
	МассивСтрокПФ.Вставить(2, Новый Структура("Верх, Низ", 45, 49));
	МассивСтрокПФ.Вставить(3, Новый Структура("Верх, Низ", 51, 55));
	МассивСтрокПФ.Вставить(4, Новый Структура("Верх, Низ", 57, 62));
	МассивСтрокПФ.Вставить(5, Новый Структура("Верх, Низ", 65, 67));
	МассивСтрокПФ.Вставить(6, Новый Структура("Верх, Низ", 69, 71));
	МассивСтрокПФ.Вставить(7, Новый Структура("Верх, Низ", 73, 73));
	МассивСтрокПФ.Вставить(8, Новый Структура("Верх, Низ", 75, 88));
	МассивСтрокПФ.Вставить(9, Новый Структура("Верх, Низ", 90, 94));
	МассивСтрокПФ.Вставить(10, Новый Структура("Верх, Низ", 96, 101));
	МассивСтрокПФ.Вставить(11, Новый Структура("Верх, Низ", 103, 105));
	ПечатнаяФорма.Вывести(МакетПФ.ПолучитьОбласть("Приложение2Шапка"));
	СтрокаМнг = МакетПФ.ПолучитьОбласть("Приложение2ДополнительнаяСтрока");
	Для Инд = 1 По 11 Цикл
		ПечатнаяФорма.Вывести(МакетПФ.ПолучитьОбласть("Приложение2Заголовок" + Инд));
		Для Стр = МассивСтрокПФ[Инд].Верх По МассивСтрокПФ[Инд].Низ Цикл 
			СчетчикВМакетеСоответствия = СчетчикВМакетеСоответствия + 1;
			СтрокаТек = МакетПФ.ПолучитьОбласть(Стр, ,Стр);
			ИмяВДереве = СоответствиеПроверочныхЛистов.Область(СчетчикВМакетеСоответствия, 1, СчетчикВМакетеСоответствия, 1).Текст;
			ЗаполнитьЗначенияСвойств(СтрокаТек.Параметры, ДанныеУведомления.ДанныеУведомления[ИмяВДереве]);
			Ит = 0;
			Для Каждого МнгСтр Из ДанныеУведомления.ДанныеДопСтрокБД["МнгСтр" + (2 + СчетчикВМакетеСоответствия)] Цикл 
				Ит = Ит + 1;
				Если Ит = 1 Тогда 
					ЗаполнитьЗначенияСвойств(СтрокаТек.Параметры, МнгСтр);
					ПечатнаяФорма.Вывести(СтрокаТек);
				Иначе
					ЗаполнитьЗначенияСвойств(СтрокаМнг.Параметры, МнгСтр);
