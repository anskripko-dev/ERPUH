	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"условие","");
		
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		
		Возврат Результат;
		
	КонецЕсли;
КонецФункции   

