Функция ПоискВЗагруженныеПоОбменуДокументу(Организация,Документ,ПоискПоИсходной = Ложь)
	
	РезультатПоиска = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	тн_ДокументыЗагруженныеПоОбмену.Документ КАК Документ,
	               |	МАКСИМУМ(тн_ДокументыЗагруженныеПоОбмену.ДатаПоследнейЗагрузки) КАК ДатаПоследнейЗагрузки
	               |ИЗ
	               |	РегистрСведений.тн_ДокументыЗагруженныеПоОбмену КАК тн_ДокументыЗагруженныеПоОбмену
	               |ГДЕ
	               |	тн_ДокументыЗагруженныеПоОбмену.Организация = &Организация
	               |	И тн_ДокументыЗагруженныеПоОбмену.Документ = &Документ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	тн_ДокументыЗагруженныеПоОбмену.Документ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	//НАЧАЛО Качикина 20.03.2026 Выполнение задач №000057091
	//Если ЗначениеЗаполнено(ПоискПоИсходной) Тогда
	Если ПоискПоИсходной Тогда
	//КОНЕЦ Качикина 20.03.2026 Выполнение задач №000057091
		
		ТекстПоиска = "тн_ДокументыЗагруженныеПоОбмену.Организация = &Организация";
		ТекстЗамены = "тн_ДокументыЗагруженныеПоОбмену.ИсходнаяОрганизация = &Организация";
		Запрос.Текст = СтрЗаменить(Запрос.Текст,ТекстПоиска,ТекстЗамены);
		
	КонецЕсли;
	
	РезультатПоиска = Запрос.Выполнить().Выбрать();
	
	Если РезультатПоиска.Следующий() Тогда
		Возврат Истина; 
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции       

