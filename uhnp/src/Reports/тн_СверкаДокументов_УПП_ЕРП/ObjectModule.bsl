#Область ПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения, Неопределено - Форма отчета или форма настроек отчета.
//       Неопределено когда вызов без контекста.
//   КлючВарианта - Строка, Неопределено - Имя предопределенного
//       или уникальный идентификатор пользовательского варианта отчета.
//       Неопределено когда вызов без контекста.
//   Настройки - Структура - Настройки общей формы отчета (для изменения).
//       См. ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию.
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытий

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Форма отчета.
//   Отказ - Булево - Признак отказа от создания формы.
//      См. описание одноименного параметра "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//   СтандартнаяОбработка - Булево - Признак выполнения стандартной (системной) обработки события.
//      См. описание одноименного параметра "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//
// См. также:
//   Процедура для вывода добавленных команд в форму: ОтчетыСервер.ВывестиКоманду().
//   Глобальный обработчик этого события: ОтчетыПереопределяемый.ПриСозданииНаСервере().
//
// Пример добавления команды:
//    Команда = Форма.Команды.Добавить("<ИмяКоманды>");
//    Команда.Действие  = "Подключаемый_Команда";
//    Команда.Заголовок = НСтр("ru = '<Представление команды...>'");
//    ОтчетыСервер.ВывестиКоманду(Форма, Команда, "<ВидГруппы>");
// Обработчик команды пишется в процедуре ОтчетыКлиентПереопределяемый.ОбработчикКоманды.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Команда 				= Форма.Команды.Добавить("ВыбратьФайлСверкиУПП");
	Команда.Действие  		= "тн_ОбщегоНазначенияКлиент.ВыбратьФайлСверкиУПП";
	Команда.Картинка  		= БиблиотекаКартинок.ФорматExcel2007;
	Команда.Отображение  	= ОтображениеКнопки.КартинкаИТекст;
	Команда.Заголовок 		= "Выбрать файл сверки";

	ОтчетыСервер.ВывестиКоманду(Форма, Команда, "Главное");
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НастройкиСКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновшикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновшикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиСКД, ДанныеРасшифровки);
	
	ФайлДанных = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(НастройкиСКД, "ФайлДанных").Значение;
	
	ДвоичныеДанные = ФайлДанных.Получить();
	
	Если ДвоичныеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокументРезультат = Новый ТабличныйДокумент;
	ТабличныйДокументРезультат.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокументРезультат.Область(4,2, ТабличныйДокументРезультат.ВысотаТаблицы, ТабличныйДокументРезультат.ШиринаТаблицы));
	Построитель.Выполнить();
	
	Попытка
		УдалитьФайлы(ВремИмяФайла);
	Исключение
		ЗаписьЖурналаРегистрации("Не удалось удалить временный файл " + ВремИмяФайла, УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	
	ЗаполнитьРезультатВТаблицуЗначений(ТаблицаЗначений);
	
	ВнешнийНабор = Новый Структура;
	ВнешнийНабор.Вставить("ТЗ_Данные", ТаблицаЗначений);
	
	ПроцессорКомпановки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпановки.Инициализировать(МакетКомпоновки, ВнешнийНабор, ДанныеРасшифровки);	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент ;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпановки, Истина);
		
КонецПроцедуры 

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьРезультатВТаблицуЗначений(ТаблицаЗначений)
	
	КвалификаторЧисла = Новый КвалификаторыЧисла(10, 0);
	
	ТаблицаЗначений.Колонки.Добавить("СсылкаЕРП"); 
	ТаблицаЗначений.Колонки.Добавить("ПроведенУПП", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначений.Колонки.Добавить("ПометкаУдаленияУПП", Новый ОписаниеТипов("Булево")); 
	ТаблицаЗначений.Колонки.Добавить("ЭтоДокумент", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначений.Колонки.Добавить("КоличествоДокументовУПП", Новый ОписаниеТипов("Число",,, КвалификаторЧисла));
	ТаблицаЗначений.Колонки.Добавить("КоличествоДокументовЕРП", Новый ОписаниеТипов("Число",,, КвалификаторЧисла)); 
	ТаблицаЗначений.Колонки.Добавить("УУ_УПП", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначений.Колонки.Добавить("БУ_УПП", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначений.Колонки.Добавить("НУ_УПП", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначений.Колонки.Добавить("БУ_ОУ_УПП", Новый ОписаниеТипов("Булево")); 
	// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
	ТаблицаЗначений.Колонки.Добавить("ОрганизацияУПП", Новый ОписаниеТипов("СправочникСсылка.Организации")); 
	// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
	ТаблицаЗначений.Колонки.Добавить("ДатаДок_УПП", Новый ОписаниеТипов("Дата")); 
	
	// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
	ТаблицаЗначенийДляПодмены = ТаблицаЗначений.Скопировать();
	ТаблицаЗначенийДляПодмены.Свернуть("ОтборОрганизации");
	ТекущаяОрганизация= Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(ТаблицаЗначенийДляПодмены[0].ОтборОрганизации));
	СписокОрганизацииПодмены = ПолучитьСписокОрганизацииПодмены(ТекущаяОрганизация);
	МассивОрганизаций = Новый Массив;
	
	МассивОтборПоОрганизациям = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТаблицаЗначений[0].ОтборОрганизации, ";", Истина);
	Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(МассивОтборПоОрганизациям[0]));
	
	МассивОтборПоДате = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТаблицаЗначений[0].ОтборДата, ";", Истина);
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДатаНач = ТекущаяДата();
	//ДатаКон = ТекущаяДата();
	ДатаНач = ТекущаяДатаСервера();
	ДатаКон = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501

	Если МассивОтборПоДате.Количество() = 2 Тогда
		ДатаНач = НачалоДня(Дата(МассивОтборПоДате[0]));
		ДатаКон = КонецДня(Дата(МассивОтборПоДате[1]));
	КонецЕсли; 

	
	// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
	
	МассивВсехТиповДокументов = Новый Массив;
	КолСтрокТаблицы = ТаблицаЗначений.Количество();
	
	Для Сч = 0 По КолСтрокТаблицы - 1 Цикл
		
		Стр = ТаблицаЗначений[Сч];
		
		Если ПустаяСтрока(Стр[0]) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьОсновныеРеквизиты(Стр);
		
		Если ЗначениеЗаполнено(Стр.СсылкаЕРП) Тогда
			Продолжить;
		КонецЕсли; 
		
		ОтборПоОрганизациям = Стр.ОтборОрганизации;
		ОтборПоДате = Стр.ОтборДата; 
		
		ЭтоПустаяСтрокаНастроек = Ложь;
		Если Не ЗначениеЗаполнено(Стр.Оригинал_ГУИД_УПП) Тогда
			ЭтоПустаяСтрокаНастроек = Истина;
		КонецЕсли;	
		
		ТекущаяСсылка = Неопределено;
		ТекущийТип = "";
		
		Если СтрНайти(Стр.ТипЕРП, "Справочник.") > 0 Тогда
			ТекущийТип = СтрЗаменить(Стр.ТипЕРП, "Справочник.", "");
			
			МассивТипов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущийТип, ";", Истина);
			
			Для Каждого СтрТип Из МассивТипов Цикл
				Если ТекущаяСсылка = Неопределено Или Не ОбщегоНазначения.СсылкаСуществует(ТекущаяСсылка) Тогда
					ТекущаяСсылка = Справочники[СтрТип].ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ГУИД_УПП));
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли СтрНайти(Стр.ТипЕРП, "Документ.") > 0 Тогда
			ТекущийТип = СтрЗаменить(Стр.ТипЕРП, "Документ.", "");
			
			МассивТипов 			= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущийТип, ";", Истина);
			МассивВариантовСверки 	= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Стр.ВариантСверки, ";", Истина);
				
			МассивСсылок = Новый Массив;  						
			Индекс = 0;
			Для Каждого СтрТип Из МассивТипов Цикл
				
				Если Не ЭтоПустаяСтрокаНастроек Тогда			
					Если МассивВариантовСверки[Индекс] = "ПоНомеруДате" Тогда 
						// Поиск по номеру		
						// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
						//ТекущаяСсылка = ПоискДокументаПоНомеруИДате(СтрТип, СокрЛП(Стр.Номер), Дата(Стр.Дата)); 	
						РезультатПоиска = ПоискДокументаПоНомеруИДате(СтрТип, СокрЛП(Стр.Номер), Дата(Стр.Дата),Организация,СписокОрганизацииПодмены,ДатаНач); 	
						Если  ТипЗнч(РезультатПоиска) = Тип("Структура") И РезультатПоиска.ДокументОбмена <> Документы[СтрТип].ПустаяСсылка()  Тогда
							
							ТекущаяСсылка = РезультатПоиска.ДокументОбмена;
							
						Иначе 
							 ТекущаяСсылка = Документы[СтрТип].ПустаяСсылка();
						КонецЕсли;
						// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
					ИначеЕсли МассивВариантовСверки[Индекс] = "ГУИД" Тогда // Стандартный поиск по гуиду	
						ТекущаяСсылка = Документы[СтрТип].ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ГУИД_УПП)); 
                        // НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056624
						Если СтрТип = "ПроизводствоБезЗаказа" Тогда  
							МассивСсылокПБЗ = ПолучитьСписокСвязанныхДокументовПроизводствоБезЗаказа(Стр.ГУИД_УПП);	
							Если МассивСсылокПБЗ.Количество() > 0 Тогда
								ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСсылок, МассивСсылокПБЗ);    
							КонецЕсли;
						КонецЕсли;
                        // КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056624
						
					КонецЕсли;
					МассивСсылок.Добавить(ТекущаяСсылка);
				КонецЕсли;
				
				Индекс = Индекс + 1;
				
				МассивВсехТиповДокументов.Добавить(СтрТип);
				
			КонецЦикла;
		КонецЕсли;	
		
		Количество = 0;
		ИндексСледСтроки = Сч + 1;
		Для Каждого ТекущаяСсылка Из МассивСсылок Цикл
			
			Если ЗначениеЗаполнено(ТекущаяСсылка) И ОбщегоНазначения.СсылкаСуществует(ТекущаяСсылка) Тогда
				Количество = Количество + 1;			
				 
				СтрСледСтроки = Неопределено;
				
				Если ИндексСледСтроки <= КолСтрокТаблицы - 1 Тогда
					СтрСледСтроки = ТаблицаЗначений[ИндексСледСтроки]; 
				КонецЕсли;
				
				Если Количество = 1 Тогда
					Стр.СсылкаЕРП = ТекущаяСсылка;
					Стр.КоличествоДокументовЕРП = 1;  
				ИначеЕсли СтрСледСтроки <> Неопределено И СтрСледСтроки.Оригинал_ГУИД_УПП = Стр.Оригинал_ГУИД_УПП Тогда
					СтрСледСтроки.СсылкаЕРП = ТекущаяСсылка;
					СтрСледСтроки.КоличествоДокументовЕРП = 1;
					ИндексСледСтроки = ИндексСледСтроки + 1;
				Иначе
					НовСтрока = ТаблицаЗначений.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрока, Стр);
					
					Стр.СсылкаЕРП = ТекущаяСсылка;
					Стр.КоличествоДокументовЕРП = 1;
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла; 
				
	КонецЦикла;	
	
	// Удалим пустые строки
	СтрокиДляУдаления = Новый Массив;
	Для Каждого Строка Из ТаблицаЗначений Цикл
				
		Если Не ЗначениеЗаполнено(Строка.ТипУПП) Или Не ЗначениеЗаполнено(Строка.Оригинал_ГУИД_УПП) Тогда 
			СтрокиДляУдаления.Добавить(Строка);
		КонецЕсли;  
				
	КонецЦикла;
	
	Для Каждого Строка Из СтрокиДляУдаления Цикл
		ТаблицаЗначений.Удалить(Строка);
	КонецЦикла;
	
	// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
	ТаблицаЗначений.ЗаполнитьЗначения(Организация,"ОрганизацияУПП");
	// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
	
	МассивВсехТиповДокументов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивВсехТиповДокументов);
	// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
	//ДополнитьТаблицуДокументамиERP(ТаблицаЗначений, МассивВсехТиповДокументов, ОтборПоОрганизациям, ОтборПоДате);
	ДополнитьТаблицуДокументамиERP(ТаблицаЗначений, МассивВсехТиповДокументов, ОтборПоОрганизациям, ОтборПоДате,СписокОрганизацииПодмены);
	// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
	ЗаменитьСсылкиERP(ТаблицаЗначений);
	
	ДополнительнаяОбработкаТЗ(ТаблицаЗначений);
	
КонецПроцедуры

Процедура ДополнительнаяОбработкаТЗ(ТаблицаЗначений);
	
	// Уберем дубли строк
	КолонкаГруппировок = ""; 
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		
		Если Колонка.Имя = "Номер"
			Или Колонка.Имя = "Дата" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(КолонкаГруппировок) Тогда
			КолонкаГруппировок = КолонкаГруппировок + ", ";	
		КонецЕсли;
		
		КолонкаГруппировок = КолонкаГруппировок + Колонка.Имя;
	КонецЦикла;  
	
	ТаблицаЗначений.Свернуть(КолонкаГруппировок);
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеРеквизиты(Стр)
	
	МассивВидовУчета = Новый Массив;
	МассивВидовУчета.Добавить("УУ");
	МассивВидовУчета.Добавить("БУ");
	МассивВидовУчета.Добавить("НУ");
	МассивВидовУчета.Добавить("БУ_ОУ");
	
	Стр.КоличествоДокументовУПП = 1;
	
	Если СтрНайти(Стр.ТипЕРП, "Документ.") > 0 Тогда
		Стр.ЭтоДокумент = Истина;
	КонецЕсли;
	
	Для Каждого ВидУчета Из МассивВидовУчета Цикл
		Если Стр[ВидУчета] = "Да" Тогда
			Стр["" + ВидУчета + "_УПП"] = Истина;
		Иначе
			Стр["" + ВидУчета + "_УПП"] = Ложь;
		КонецЕсли;
	КонецЦикла; 
	
	Попытка
		Стр.ДатаДок_УПП = Дата(Стр.Дата);
	Исключение
		Стр.ДатаДок_УПП = Дата(1, 1, 1);
	КонецПопытки;  
	
	Если Стр.Проведен = "Да" Тогда
		Стр.ПроведенУПП = Истина;
	Иначе
		Стр.ПроведенУПП = Ложь;
	КонецЕсли;
		
	Если Стр.ПометкаУдаления = "Да" Тогда
		Стр.ПометкаУдаленияУПП = Истина;
	Иначе
		Стр.ПометкаУдаленияУПП = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

// Егоров Петр 05.02.2026 Выполнение задач №000056658 + парам СписокОрганизацииПодмены
//Процедура ДополнитьТаблицуДокументамиERP(ТЗ, МассивВсехТиповДокументов, ОтборПоОрганизациям, ОтборПоДате)
Процедура ДополнитьТаблицуДокументамиERP(ТЗ, МассивВсехТиповДокументов, ОтборПоОрганизациям, ОтборПоДате,СписокОрганизацииПодмены)
	
	МассивОрганизаций = Новый Массив;
	
	МассивОтборПоОрганизациям = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОтборПоОрганизациям, ";", Истина);
	Для Каждого Стр Из МассивОтборПоОрганизациям Цикл
		Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр));
		МассивОрганизаций.Добавить(Организация);
	КонецЦикла;
	
	ЕстьОтборПоОрганизациям = Ложь;
	Если МассивОрганизаций.Количество() > 0 Тогда
		ЕстьОтборПоОрганизациям = Истина;		
	КонецЕсли;
	
	МассивОтборПоДате = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОтборПоДате, ";", Истина);
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДатаНач = ТекущаяДата();
	//ДатаКон = ТекущаяДата();
	ДатаНач = ТекущаяДатаСервера();
	ДатаКон = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Если МассивОтборПоДате.Количество() = 2 Тогда
		ДатаНач = НачалоДня(Дата(МассивОтборПоДате[0]));
		ДатаКон = КонецДня(Дата(МассивОтборПоДате[1]));
	КонецЕсли; 
	
	// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
	ТаблицаЗначенийДляПодмены = ТЗ.Скопировать();
	ТаблицаЗначенийДляПодмены.Свернуть("ОтборОрганизации");
	ТекущаяОрганизация= Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(ТаблицаЗначенийДляПодмены[0].ОтборОрганизации));
	Если СписокОрганизацииПодмены <> Неопределено Тогда
		МассивОрганизаций[0] = СписокОрганизацииПодмены.ГоловнаяОрганизация;
	КонецЕсли; 
	
	// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
	
	МассивДокументовИсключений = ТЗ.ВыгрузитьКолонку("СсылкаЕРП");
	МассивДокументовИсключений = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивДокументовИсключений);
	
	Запрос = Новый Запрос;
	Тексты = Новый Массив;
	
	Для Каждого СтрокаТипа Из МассивВсехТиповДокументов Цикл
		
		ТекТип = "Документ." + СтрокаТипа;
		
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ТекТип);
		Если МетаданныеОбъекта = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю("Не найден объект метаданных в системе: " + ТекТип);
			Продолжить;
		КонецЕсли;;
		
		ТекстЗапроса = "";
		
		МассивРеквизитов = Новый Массив;
		
		ТекстРеквизиты = "ВЫБРАТЬ
						|	ОбъектМетаданных.Ссылка КАК СсылкаЕРП,
						|	ОбъектМетаданных.Проведен КАК Проведен,
						|	ОбъектМетаданных.Номер КАК Номер,
						|	ОбъектМетаданных.Дата КАК Дата,
						|	ОбъектМетаданных.Организация КАК Организация,";
		
		МассивРеквизитов.Добавить(ТекстРеквизиты);	
		
		ТекстЗапроса = СтрСоединить(МассивРеквизитов);
		
		ТекстЗапроса = ТекстЗапроса + СтрШаблон("
			|	""%1"" КАК ТипЕРП
			|ИЗ
			|	%1 КАК ОбъектМетаданных",
			ТекТип);
			
		ТекстЗапроса = ТекстЗапроса + "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.тн_ЗагруженныеОбъекты КАК тн_ЗагруженныеОбъекты
			|		ПО ОбъектМетаданных.Ссылка = тн_ЗагруженныеОбъекты.Объект";
		
		ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ 
			|	ОбъектМетаданных.Дата МЕЖДУ &ДатаНач И &ДатаКон
			|	И ОбъектМетаданных.Ссылка НЕ В (&МассивДокументовИсключений)";
		
		Если ЕстьОтборПоОрганизациям Тогда
			ТекстЗапроса = ТекстЗапроса + "
				|	И ОбъектМетаданных.Организация В (&МассивОрганизаций)";
		КонецЕсли;
				
		Тексты.Добавить(ТекстЗапроса);
	КонецЦикла;
	
	ТекстЗапросаОбщий = СтрСоединить(Тексты, РазделительОбъединить());
		
	Запрос.Текст = ТекстЗапросаОбщий;
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
	Запрос.УстановитьПараметр("МассивДокументовИсключений", МассивДокументовИсключений);
	// НАЧАЛО Юдина Екатерина 20.03.2026 Выполнение задач №000057112 
	Запрос.Текст = тн_ОбщегоНазначения.СделатьЗапросРазрешенным(Запрос.Текст);
	// КОНЕЦ Юдина Екатерина 20.03.2026 Выполнение задач №000057112

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		// Поиск по номеру		
		// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
		РезультатПоиска = ПоискДокументаСопоставление(Выборка.СсылкаЕРП,ТекущаяОрганизация,СписокОрганизацииПодмены,ДатаНач); 	
		Если  ТипЗнч(РезультатПоиска) = Тип("Структура") И РезультатПоиска.ДокументОбмена <> Ложь  Тогда
			
		// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
		НоваяСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ТипУПП = "Не сопоставленные";
		НоваяСтрока.КоличествоДокументовЕРП = 1;
		НоваяСтрока.КоличествоДокументовУПП = 0;
		НоваяСтрока.ЭтоДокумент = Истина;
		
		// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
		Иначе 
			Продолжить;
		КонецЕсли;

		// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
	КонецЦикла; 
	
КонецПроцедуры

Функция РазделительОбъединить()
	Возврат	"
		|ОБЪЕДИНИТЬ ВСЕ
		|";
КонецФункции

Процедура ЗаменитьСсылкиERP(ТЗ)
	
	МассивЗаменяемыхСсылок = Новый Массив;
		
	Для Каждого Стр Из ТЗ Цикл
		Если ТипЗнч(Стр.СсылкаЕРП) = Тип("ДокументСсылка.ПроизводствоБезЗаказа") Тогда
			МассивЗаменяемыхСсылок.Добавить(Стр.СсылкаЕРП);	
		КонецЕсли;
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроизводствоБезЗаказа.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ вт_ЗаменяемыеСсылки
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа КАК ПроизводствоБезЗаказа
		|ГДЕ
		|	ПроизводствоБезЗаказа.Ссылка В(&МассивЗаменяемыхСсылок)
		|	И ПроизводствоБезЗаказа.тн_РежимВИнтеграционнойСхеме = ЗНАЧЕНИЕ(Перечисление.тн_РежимыВИнтеграционнойСхеме.Промежуточный)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ЗаменяемыеСсылки.Ссылка КАК СсылкаЗамены,
		|	ПроизводствоБезЗаказаВыходныеИзделия.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ вт_ДокументыЗамены
		|ИЗ
		|	вт_ЗаменяемыеСсылки КАК вт_ЗаменяемыеСсылки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК ПроизводствоБезЗаказаВыходныеИзделия
		|		ПО вт_ЗаменяемыеСсылки.Ссылка = ПроизводствоБезЗаказаВыходныеИзделия.тн_ПромежуточныйДокумент
		|ГДЕ
		|	ПроизводствоБезЗаказаВыходныеИзделия.Ссылка.тн_РежимВИнтеграционнойСхеме = ЗНАЧЕНИЕ(Перечисление.тн_РежимыВИнтеграционнойСхеме.Учетный)
		|	И НЕ ПроизводствоБезЗаказаВыходныеИзделия.Ссылка.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_ЗаменяемыеСсылки.Ссылка,
		|	ПроизводствоБезЗаказаПобочныеИзделия.Ссылка
		|ИЗ
		|	вт_ЗаменяемыеСсылки КАК вт_ЗаменяемыеСсылки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПроизводствоБезЗаказа.ПобочныеИзделия КАК ПроизводствоБезЗаказаПобочныеИзделия
		|		ПО вт_ЗаменяемыеСсылки.Ссылка = ПроизводствоБезЗаказаПобочныеИзделия.тн_ПромежуточныйДокумент
		|ГДЕ
		|	ПроизводствоБезЗаказаПобочныеИзделия.Ссылка.тн_РежимВИнтеграционнойСхеме = ЗНАЧЕНИЕ(Перечисление.тн_РежимыВИнтеграционнойСхеме.Учетный)
		|	И НЕ ПроизводствоБезЗаказаПобочныеИзделия.Ссылка.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_ЗаменяемыеСсылки.Ссылка,
		|	ПроизводствоБезЗаказаМатериалыИРаботы.Ссылка
		|ИЗ
		|	вт_ЗаменяемыеСсылки КАК вт_ЗаменяемыеСсылки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПроизводствоБезЗаказа.МатериалыИРаботы КАК ПроизводствоБезЗаказаМатериалыИРаботы
		|		ПО вт_ЗаменяемыеСсылки.Ссылка = ПроизводствоБезЗаказаМатериалыИРаботы.тн_ПромежуточныйДокумент
		|ГДЕ
		|	ПроизводствоБезЗаказаМатериалыИРаботы.Ссылка.тн_РежимВИнтеграционнойСхеме = ЗНАЧЕНИЕ(Перечисление.тн_РежимыВИнтеграционнойСхеме.Учетный)
		|	И НЕ ПроизводствоБезЗаказаМатериалыИРаботы.Ссылка.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ДокументыЗамены.СсылкаЗамены КАК СсылкаЗамены,
		|	вт_ДокументыЗамены.Ссылка КАК Ссылка
		|ИЗ
		|	вт_ДокументыЗамены КАК вт_ДокументыЗамены
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ДокументыЗамены.СсылкаЗамены,
		|	вт_ДокументыЗамены.Ссылка";
	
	Запрос.УстановитьПараметр("МассивЗаменяемыхСсылок", МассивЗаменяемыхСсылок);
	// НАЧАЛО Юдина Екатерина 20.03.2026 Выполнение задач №000057112 
	Запрос.Текст = тн_ОбщегоНазначения.СделатьЗапросРазрешенным(Запрос.Текст);
	// КОНЕЦ Юдина Екатерина 20.03.2026 Выполнение задач №000057112
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокиТЗ = ТЗ.НайтиСтроки(Новый Структура("СсылкаЕРП", Выборка.СсылкаЗамены));
		Для Каждого СтрокаТЗ Из СтрокиТЗ Цикл
			СтрокаТЗ.СсылкаЕРП = Выборка.Ссылка;	
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

//  Егоров Петр 05.02.2026 Выполнение задач №000056658 + парам Организация,СписокОрганизацииПодмены
Функция ПоискДокументаПоНомеруИДате(ТипДокумента, Номер, Дата,Организация,СписокОрганизацииПодмены,ОтборПоДате)
//Функция ПоискДокументаПоНомеруИДате(ТипДокумента, Номер, Дата)


НайденоПоОбменуПоОрганизации = Ложь;

НайденоПоОбменуИсходнойПоОрганизации = Ложь;

	Запрос = Новый Запрос;
	
	ТекстЗапроса = 
		СтрШаблон("
		|ВЫБРАТЬ
		|	ОбъектМетаданных.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.%1 КАК ОбъектМетаданных
		|ГДЕ
		|	ОбъектМетаданных.Номер = &Номер
		|	И НАЧАЛОПЕРИОДА(ОбъектМетаданных.Дата, ДЕНЬ) = &ДатаНачалоДня",		
		ТипДокумента); 
		
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ДатаНачалоДня", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Номер", Номер);
	// НАЧАЛО Юдина Екатерина 20.03.2026 Выполнение задач №000057112 
	Запрос.Текст = тн_ОбщегоНазначения.СделатьЗапросРазрешенным(Запрос.Текст);
	// КОНЕЦ Юдина Екатерина 20.03.2026 Выполнение задач №000057112
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
		Если  СписокОрганизацииПодмены = Неопределено Тогда
			
			НайденоПоФилиалу = ПоискВЗагруженныеПоОбменуДокументу(Организация,Выборка.Ссылка);
			
			Если НайденоПоФилиалу = Истина Тогда
				
				РезультатПоискаВЗагруженныхПоОбмену = Новый Структура;
				
				РезультатПоискаВЗагруженныхПоОбмену.Вставить("Организация",Организация);
				
				РезультатПоискаВЗагруженныхПоОбмену.Вставить("ДокументОбмена",Выборка.Ссылка);
				
				Возврат РезультатПоискаВЗагруженныхПоОбмену; 
				
			КонецЕсли;	
			
		Иначе
			
			Если ОтборПоДате < СписокОрганизацииПодмены.ДатаНачалаВыгрузкиКакОбособленногоПодразделения Тогда
				
				НайденоПоОбменуПоОрганизации = ПоискВЗагруженныеПоОбменуДокументу(Организация,Выборка.Ссылка);
				
				 ИтогНайденоПоОбменуПоОрганизации = Новый Структура;
				
				ИтогНайденоПоОбменуПоОрганизации.Вставить("Организация",Организация);
				
				Если Не НайденоПоОбменуПоОрганизации Тогда
					
				ИтогНайденоПоОбменуПоОрганизации.Вставить("ДокументОбмена",Документы[ТипДокумента].ПустаяСсылка());	
					
				Иначе
					
					ИтогНайденоПоОбменуПоОрганизации.Вставить("ДокументОбмена",Выборка.Ссылка);
					
				КонецЕсли;  

				Возврат ИтогНайденоПоОбменуПоОрганизации;
				
			КонецЕсли;  
			
			Если ОтборПоДате >= СписокОрганизацииПодмены.ДатаНачалаВыгрузкиКакОбособленногоПодразделения Тогда
				
				НайденоПоОбменуИсходнойПоОрганизации = ПоискВЗагруженныеПоОбменуДокументу(Организация,Выборка.Ссылка,Истина);
				
