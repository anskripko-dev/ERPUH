// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   Отказ - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если Форма.Параметры.Свойство("ПараметрКоманды") Тогда
		
		ИсточникКоманды = Форма.Параметры.ПараметрКоманды[0];
		Если ТипЗнч(ИсточникКоманды) = Тип("СправочникСсылка.ЦенныеБумаги") Тогда
		    ФинансовыйИнструмент = ИсточникКоманды;
			Отбор = Новый Структура("ФинансовыйИнструмент, ПериодОтчета", ФинансовыйИнструмент, Новый СтандартныйПериод);
		
		ИначеЕсли ТипЗнч(ИсточникКоманды) = Тип("ДокументСсылка.НачисленияПоФинансовымИнструментам") Тогда
		    ФинансовыйИнструмент = Неопределено;
			Отбор = Новый Структура("Организация, ПериодОтчета", ИсточникКоманды.Организация, Новый СтандартныйПериод(ИсточникКоманды.ДатаНачала, КонецДня(ИсточникКоманды.Дата)));
		
		Иначе	
			ФинансовыйИнструмент = ИсточникКоманды.ФинансовыйИнструмент;
			Отбор = Новый Структура("ФинансовыйИнструмент, ПериодОтчета", ФинансовыйИнструмент, Новый СтандартныйПериод);
		
		КонецЕсли;
		
		
		Компоновщик = Форма.Отчет.КомпоновщикНастроек;
		ТиповыеОтчетыУХ.УстановитьЗначенияПолей(Компоновщик, Отбор);
		Форма.Параметры.ПользовательскиеНастройки = Компоновщик.ПользовательскиеНастройки;
		
	КонецЕсли;
	
КонецПроцедуры

