	<dataSet xsi:type="DataSetQuery">
		<name>ЭлементыСправочника</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Элемент справочника</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Код</dataPath>
			<field>Код</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Наименование</dataPath>
			<field>Наименование</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Родитель</dataPath>
			<field>Родитель</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Группа</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЭтоГруппа</dataPath>
			<field>ЭтоГруппа</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Это группа</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПометкаУдаления</dataPath>
			<field>ПометкаУдаления</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Пометка удаления</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Артикул</dataPath>
			<field>Артикул</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИНН</dataPath>
			<field>ИНН</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1000
	Справочник.Ссылка КАК Ссылка,
	Справочник.Код КАК Код,
	Справочник.Наименование КАК Наименование,
	Справочник.Родитель КАК Родитель,
	Справочник.ЭтоГруппа КАК ЭтоГруппа,
	Справочник.ПометкаУдаления КАК ПометкаУдаления,
	Справочник.Артикул КАК Артикул,
	"""" КАК ИНН
ИЗ
	Справочник.Номенклатура КАК Справочник
{ХАРАКТЕРИСТИКИ
	ТИП(Справочник.Номенклатура)
	ВИДЫХАРАКТЕРИСТИК (ВЫБРАТЬ
		Свойства.Свойство КАК Свойство,
		Свойства.Свойство.Заголовок КАК Наименование,
		Свойства.Свойство.ТипЗначения КАК ТипЗначения
	ИЗ
		(ВЫБРАТЬ РАЗЛИЧНЫЕ
			Наборы.Свойство КАК Свойство
		ИЗ
			Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК Наборы
		ГДЕ
			НЕ Наборы.ПометкаУдаления
			И (Наборы.ИмяПредопределенногоНабора = "Справочник_Номенклатура"
				ИЛИ Наборы.Ссылка В
					(ВЫБРАТЬ
						ВидыНоменклатуры.НаборСвойств
					ИЗ
						Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры))) КАК Свойства)
	ПОЛЕКЛЮЧА Свойство
	ПОЛЕИМЕНИ Наименование
	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	ЗНАЧЕНИЯХАРАКТЕРИСТИК (ВЫБРАТЬ
		ДополнительныеРеквизиты.Ссылка КАК Ссылка,
		ДополнительныеРеквизиты.Свойство КАК Свойство,
		ДополнительныеРеквизиты.Значение КАК Значение
	ИЗ
		Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты)
	ПОЛЕОБЪЕКТА Ссылка
	ПОЛЕВИДА Свойство
	ПОЛЕЗНАЧЕНИЯ Значение
}</query>
	</dataSet>
