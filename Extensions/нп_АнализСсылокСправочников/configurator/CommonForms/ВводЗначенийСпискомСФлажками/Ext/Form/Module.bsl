#Область ОписаниеПеременных

&НаКлиенте
Перем нп_ИзменениеПометкиВыделенныхВПроцессе;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
&После("ПриСозданииНаСервере")
Процедура нп_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	нп_ДобавитьКомандыПометкиВыделенных();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура нп_УстановитьПометкиВыделенных(Команда)
	нп_УстановитьПометкуВыделенныхСтрок(Истина);
КонецПроцедуры

&НаКлиенте
Процедура нп_СнятьПометкиВыделенных(Команда)
	нп_УстановитьПометкуВыделенныхСтрок(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура нп_ДобавитьКомандыПометкиВыделенных()
	
	Если Команды.Найти("УстановитьПометкиВыделенных") <> Неопределено
		Или Команды.Найти("нп_УстановитьПометкиВыделенных") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Список.МножественныйВыбор = Истина;
	Элементы.Список.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Авто;
	
	нп_ДобавитьКомандуПометкиВыделенных(
		"нп_УстановитьПометкиВыделенных",
		НСтр("ru = 'Отметить выделенные'"),
		НСтр("ru = 'Установить флажки только для выделенных строк'"),
		"УстановитьФлажки");
	нп_ДобавитьКомандуПометкиВыделенных(
		"нп_СнятьПометкиВыделенных",
		НСтр("ru = 'Снять отметку с выделенных'"),
		НСтр("ru = 'Снять флажки только с выделенных строк'"),
		"СнятьФлажки");
	
	нп_ПодключитьОбработчикПометкиСписка();
	
КонецПроцедуры

&НаСервере
Процедура нп_ДобавитьКомандуПометкиВыделенных(ИмяКоманды, ЗаголовокКоманды, ПодсказкаКоманды, ИмяКартинки)
	
	КомандаФормы = Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие = ИмяКоманды;
	КомандаФормы.Заголовок = ЗаголовокКоманды;
	КомандаФормы.Подсказка = ПодсказкаКоманды;
	КомандаФормы.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
	Попытка
		КомандаФормы.Картинка = БиблиотекаКартинок[ИмяКартинки];
	Исключение
		// Картинка платформы или БСП может отсутствовать.
	КонецПопытки;
	
	Кнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы.Список.КоманднаяПанель);
	Кнопка.ИмяКоманды = ИмяКоманды;
	Кнопка.ТолькоВоВсехДействиях = Ложь;
	
	КнопкаКонтекст = Элементы.Добавить(ИмяКоманды + "Контекст", Тип("КнопкаФормы"), Элементы.Список.КонтекстноеМеню);
	КнопкаКонтекст.ИмяКоманды = ИмяКоманды;
	
КонецПроцедуры

&НаСервере
Процедура нп_ПодключитьОбработчикПометкиСписка()
	
	Для Каждого ПодчиненныйЭлемент Из Элементы.Список.ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(ПодчиненныйЭлемент) <> Тип("ПолеФормы") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПодчиненныйЭлемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
			ПодчиненныйЭлемент.УстановитьДействие("ПриИзменении", "нп_СписокПометкаПриИзменении");
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура нп_СписокПометкаПриИзменении(Элемент)
	
	Если нп_ИзменениеПометкиВыделенныхВПроцессе = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	нп_УстановитьПометкуВыделенныхСтрок(ТекущиеДанные.Пометка);
	
КонецПроцедуры

&НаКлиенте
Процедура нп_УстановитьПометкуВыделенныхСтрок(Пометка)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	нп_ИзменениеПометкиВыделенныхВПроцессе = Истина;
	
	Попытка
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			ЭлементСписка = Список.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если ЭлементСписка <> Неопределено Тогда
				ЭлементСписка.Пометка = Пометка;
			КонецЕсли;
		КонецЦикла;
	Исключение
		нп_ИзменениеПометкиВыделенныхВПроцессе = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
	нп_ИзменениеПометкиВыделенныхВПроцессе = Ложь;
	
КонецПроцедуры

#КонецОбласти
