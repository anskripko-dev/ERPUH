#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// Задать настройки формы отчета.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения, Неопределено
//  КлючВарианта - Строка, Неопределено
//  Настройки - см. ОтчетыКлиентСервер.НастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.ФормироватьСразу = Ложь;
	Настройки.РазрешеноИзменятьВарианты = Истина;
	Настройки.РазрешеноИзменятьСтруктуру = Истина;
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	
	ПараметрыПерезагрузки = Новый Массив;
	ПараметрыПерезагрузки.Добавить(Новый ПараметрКомпоновкиДанных("ВидСправочника"));
	Настройки.ЗагрузитьНастройкиПриИзмененииПараметров = ПараметрыПерезагрузки;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Подменяет запрос схемы под выбранный справочник,
// чтобы в отборе были его поля и дополнительные реквизиты.
//
// Параметры:
//  Контекст - Произвольный
//  КлючСхемы - Строка
//  КлючВарианта - Строка, Неопределено
//  НовыеНастройкиКД - НастройкиКомпоновкиДанных, Неопределено
//  НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных, Неопределено
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	ВидСправочника = ВидСправочникаИзНастроек(НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД);
	НовыйКлючСхемы = ВидСправочника;
	
	Если КлючСхемы = НовыйКлючСхемы Тогда
		Возврат;
	КонецЕсли;
	
	КлючСхемы = НовыйКлючСхемы;
	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	УстановитьЗапросЭлементовСправочника(Схема, ВидСправочника);
	
	Если Метаданные.ОбщиеМодули.Найти("ОтчетыСервер") <> Неопределено Тогда
		ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, Схема, КлючСхемы);
	Иначе
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	КонецЕсли;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ВидСправочника = ВидСправочникаИзНастроек(Настройки, Неопределено);
	
	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	УстановитьЗапросЭлементовСправочника(Схема, ВидСправочника);
	
	ЭлементыСправочника = ЭлементыСправочникаПоНастройкам(Настройки);
	МестаИспользования = ТаблицаМестИспользования(ЭлементыСправочника, Настройки);
	
	ВнешниеНаборыДанных = Новый Структура("МестаИспользования", МестаИспользования);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьЗапросЭлементовСправочника(Схема, ВидСправочника)
	
	НаборДанных = Схема.НаборыДанных.Найти("ЭлементыСправочника");
	Если НаборДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборДанных.Запрос = ТекстЗапросаЭлементовСправочника(ВидСправочника);
	
КонецПроцедуры

Функция ТекстЗапросаЭлементовСправочника(ВидСправочника)
	
	Если ВидСправочника = "Контрагенты" Тогда
		ИмяСправочника = "Контрагенты";
		ИмяНабораСвойств = "Справочник_Контрагенты";
		ДополнительноеПоле = "	"""" КАК Артикул,
		|	Справочник.ИНН КАК ИНН";
		ТекстСпискаСвойств = ТекстСпискаСвойствПоИмениНабора(ИмяНабораСвойств);
	Иначе
		ИмяСправочника = "Номенклатура";
		ИмяНабораСвойств = "Справочник_Номенклатура";
		ДополнительноеПоле = "	Справочник.Артикул КАК Артикул,
		|	"""" КАК ИНН";
		ТекстСпискаСвойств = ТекстСпискаСвойствНоменклатуры(ИмяНабораСвойств);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Справочник.Ссылка КАК Ссылка,
	|	Справочник.Код КАК Код,
	|	Справочник.Наименование КАК Наименование,
	|	Справочник.Родитель КАК Родитель,
	|	Справочник.ЭтоГруппа КАК ЭтоГруппа,
	|	Справочник.ПометкаУдаления КАК ПометкаУдаления,
	|	#ДополнительноеПоле
	|ИЗ
	|	Справочник.#ИмяСправочника КАК Справочник
	|{ХАРАКТЕРИСТИКИ
	|	ТИП(Справочник.#ИмяСправочника)
	|	ВИДЫХАРАКТЕРИСТИК (#ТекстСпискаСвойств)
	|	ПОЛЕКЛЮЧА Свойство
	|	ПОЛЕИМЕНИ Наименование
	|	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	|	ЗНАЧЕНИЯХАРАКТЕРИСТИК (ВЫБРАТЬ
	|			ДополнительныеРеквизиты.Ссылка КАК Ссылка,
	|			ДополнительныеРеквизиты.Свойство КАК Свойство,
	|			ДополнительныеРеквизиты.Значение КАК Значение
	|		ИЗ
	|			Справочник.#ИмяСправочника.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты)
	|	ПОЛЕОБЪЕКТА Ссылка
	|	ПОЛЕВИДА Свойство
	|	ПОЛЕЗНАЧЕНИЯ Значение
	|}";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДополнительноеПоле", ДополнительноеПоле);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ТекстСпискаСвойств", ТекстСпискаСвойств);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСправочника", ИмяСправочника);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстСпискаСвойствПоИмениНабора(ИмяНабораСвойств)
	
	Возврат
	"ВЫБРАТЬ
	|		Свойства.Свойство КАК Свойство,
	|		Свойства.Свойство.Заголовок КАК Наименование,
	|		Свойства.Свойство.ТипЗначения КАК ТипЗначения
	|	ИЗ
	|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			Наборы.Свойство КАК Свойство
	|		ИЗ
	|			Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК Наборы
	|		ГДЕ
	|			НЕ Наборы.ПометкаУдаления
	|			И Наборы.ИмяПредопределенногоНабора = """ + ИмяНабораСвойств + """) КАК Свойства";
	
КонецФункции

Функция ТекстСпискаСвойствНоменклатуры(ИмяНабораСвойств)
	
	Возврат
	"ВЫБРАТЬ
	|		Свойства.Свойство КАК Свойство,
	|		Свойства.Свойство.Заголовок КАК Наименование,
	|		Свойства.Свойство.ТипЗначения КАК ТипЗначения
	|	ИЗ
	|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			Наборы.Свойство КАК Свойство
	|		ИЗ
	|			Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК Наборы
	|		ГДЕ
	|			НЕ Наборы.ПометкаУдаления
	|			И (Наборы.ИмяПредопределенногоНабора = """ + ИмяНабораСвойств + """
	|				ИЛИ Наборы.Ссылка В
	|					(ВЫБРАТЬ
	|						ВидыНоменклатуры.НаборСвойств
	|					ИЗ
	|						Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры))) КАК Свойства";
	
КонецФункции

Функция ЭлементыСправочникаПоНастройкам(Настройки)
	
	СхемаОтбора = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	УстановитьЗапросЭлементовСправочника(СхемаОтбора, ВидСправочникаИзНастроек(Настройки, Неопределено));
	
	НаборМест = СхемаОтбора.НаборыДанных.Найти("МестаИспользования");
	Если НаборМест <> Неопределено Тогда
		СхемаОтбора.НаборыДанных.Удалить(НаборМест);
	КонецЕсли;
	
	Пока СхемаОтбора.СвязиНаборовДанных.Количество() > 0 Цикл
		СхемаОтбора.СвязиНаборовДанных.Удалить(СхемаОтбора.СвязиНаборовДанных[0]);
	КонецЦикла;
	
	НастройкиОтбора = Настройки.Скопировать();
	НастройкиОтбора.Структура.Очистить();
	
	Группировка = НастройкиОтбора.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Выбор.Элементы.Очистить();
	Группировка.Порядок.Элементы.Очистить();
	
	ПолеСсылка = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеСсылка.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
	ПолеСсылка.Использование = Истина;
	
	ПолеПорядокНаименование = Группировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядокНаименование.Поле = Новый ПолеКомпоновкиДанных("Наименование");
	ПолеПорядокНаименование.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	ПолеПорядокНаименование.Использование = Истина;
	
	ПолеПорядокКод = Группировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядокКод.Поле = Новый ПолеКомпоновкиДанных("Код");
	ПолеПорядокКод.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	ПолеПорядокКод.Использование = Истина;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		СхемаОтбора,
		НастройкиОтбора,
		,
		,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультата);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ТаблицаМестИспользования(ЭлементыСправочника, Настройки)
	
	Результат = НовыйТаблицаМестИспользования();
	
	Если ЭлементыСправочника.Колонки.Найти("Ссылка") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	Для Каждого СтрокаЭлемента Из ЭлементыСправочника Цикл
		Если ЗначениеЗаполнено(СтрокаЭлемента.Ссылка) Тогда
			МассивСсылок.Добавить(СтрокаЭлемента.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	ЛимитЭлементов = ЛимитЭлементовИзНастроек(Настройки);
	ИсходноеКоличество = МассивСсылок.Количество();
	Если ЛимитЭлементов > 0 И ИсходноеКоличество > ЛимитЭлементов Тогда
		ОтобранныеСсылки = Новый Массив;
		Для Индекс = 0 По ЛимитЭлементов - 1 Цикл
			ОтобранныеСсылки.Добавить(МассивСсылок[Индекс]);
		КонецЦикла;
		МассивСсылок = ОтобранныеСсылки;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Отобраны первые %1 элементов из %2. Уточните отбор или увеличьте лимит элементов.'"),
			ЛимитЭлементов,
			ИсходноеКоличество);
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Сообщить();
	КонецЕсли;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	НайденныеСсылки = МестаИспользованияСсылок(МассивСсылок);
	ЕстьКолонкаПредставления = НайденныеСсылки.Колонки.Найти("ПредставлениеДанных") <> Неопределено;
	
	Для Каждого СтрокаНайденных Из НайденныеСсылки Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ЭлементСправочника = СтрокаНайденных.Ссылка;
		НоваяСтрока.ТипЗначения = ПредставлениеТипаЗначения(СтрокаНайденных);
		НоваяСтрока.ИмяТипаЗначения = ИмяТипаЗначения(СтрокаНайденных);
		НоваяСтрока.СсылающийсяОбъект = СтрокаНайденных.Данные;
		Если ЕстьКолонкаПредставления И ЗначениеЗаполнено(СтрокаНайденных.ПредставлениеДанных) Тогда
			НоваяСтрока.ПредставлениеСсылки = СтрокаНайденных.ПредставлениеДанных;
		Иначе
			НоваяСтрока.ПредставлениеСсылки = Строка(СтрокаНайденных.Данные);
		КонецЕсли;
		НоваяСтрока.КоличествоСсылок = 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция МестаИспользованияСсылок(МассивСсылок)
	
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") <> Неопределено Тогда
		Возврат ОбщегоНазначения.МестаИспользования(МассивСсылок);
	КонецЕсли;
	
	Возврат НайтиПоСсылкам(МассивСсылок);
	
КонецФункции

Функция ПредставлениеТипаЗначения(СтрокаНайденных)
	
	Если ТипЗнч(СтрокаНайденных.Метаданные) = Тип("ОбъектМетаданных") Тогда
		Возврат СтрокаНайденных.Метаданные.Представление();
	КонецЕсли;
	
	Возврат Строка(ТипЗнч(СтрокаНайденных.Данные));
	
КонецФункции

Функция ИмяТипаЗначения(СтрокаНайденных)
	
	Если ТипЗнч(СтрокаНайденных.Метаданные) = Тип("ОбъектМетаданных") Тогда
		Возврат СтрокаНайденных.Метаданные.ПолноеИмя();
	КонецЕсли;
	
	Возврат Строка(ТипЗнч(СтрокаНайденных.Данные));
	
КонецФункции

Функция НовыйТаблицаМестИспользования()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЭлементСправочника");
	Результат.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("ИмяТипаЗначения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("СсылающийсяОбъект");
	Результат.Колонки.Добавить("ПредставлениеСсылки", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	Результат.Колонки.Добавить("КоличествоСсылок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	
	Возврат Результат;
	
КонецФункции

Функция ВидСправочникаИзНастроек(НастройкиКД, ПользовательскиеНастройкиКД)
	
	ЗначениеПараметра = ЗначениеПараметраКомпоновки(НастройкиКД, ПользовательскиеНастройкиКД, "ВидСправочника");
	Если ЗначениеПараметра = "Контрагенты" Тогда
		Возврат "Контрагенты";
	КонецЕсли;
	
	Возврат "Номенклатура";
	
КонецФункции

Функция ЛимитЭлементовИзНастроек(НастройкиКД)
	
	ЗначениеПараметра = ЗначениеПараметраКомпоновки(НастройкиКД, Неопределено, "ЛимитЭлементов");
	Если ТипЗнч(ЗначениеПараметра) = Тип("Число") И ЗначениеПараметра > 0 Тогда
		Возврат ЗначениеПараметра;
	КонецЕсли;
	
	Возврат 1000;
	
КонецФункции

Функция ЗначениеПараметраКомпоновки(НастройкиКД, ПользовательскиеНастройкиКД, ИмяПараметра)
	
	Параметр = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	
	Если ПользовательскиеНастройкиКД <> Неопределено Тогда
		Для Каждого ЭлементНастройки Из ПользовательскиеНастройкиКД.Элементы Цикл
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных")
				И ЭлементНастройки.Параметр = Параметр
				И ЭлементНастройки.Использование Тогда
				Возврат ЭлементНастройки.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НастройкиКД <> Неопределено Тогда
		ЗначениеПараметра = НастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Параметр);
		Если ЗначениеПараметра <> Неопределено И ЗначениеПараметра.Использование Тогда
			Возврат ЗначениеПараметра.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

