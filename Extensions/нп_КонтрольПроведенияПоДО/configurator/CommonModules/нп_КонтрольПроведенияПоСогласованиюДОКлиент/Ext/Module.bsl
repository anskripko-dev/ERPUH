#Область ПрограммныйИнтерфейс

// Обработчик ПередЗаписью формы документа: подтверждение изменений при согласовании в ДО.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  Отказ - Булево - признак отказа от записи.
//  ПараметрыЗаписи - Структура - параметры записи формы.
//
Процедура ПередЗаписью(Форма, Отказ, ПараметрыЗаписи) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("нп_ПодтвержденоПересогласованиеДО")
		И ПараметрыЗаписи.нп_ПодтвержденоПересогласованиеДО = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ОбъектФормы = Форма.Объект;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(ОбъектФормы) <> Тип("ДанныеФормыСтруктура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбъектФормы.Свойство("Ссылка") Или Не ЗначениеЗаполнено(ОбъектФормы.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Форма.Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	Если Не нп_КонтрольПроведенияПоСогласованиюДО.ТребуетсяПодтверждениеПересогласованияПриЗаписи(ОбъектФормы) Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеПодтвержденияПересогласованияПриЗаписи",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ТекстВопроса = НСтр("ru = 'Документ находится на согласовании в 1С:Документооборот.
		|Если вы подтвердите изменения, согласование будет прервано и запущено заново.
		|Проведённый документ будет распроведён; провести снова можно после нового согласования.
		|
		|Продолжить?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПослеПодтвержденияПересогласованияПриЗаписи(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
	ПараметрыЗаписи = ДополнительныеПараметры.ПараметрыЗаписи;
	
	ПараметрыЗаписи.Вставить("нп_ПодтвержденоПересогласованиеДО", Истина);
	
	ДокументПроведен = Ложь;
	Попытка
		ДокументПроведен = Форма.Объект.Проведен;
	Исключение
		ДокументПроведен = Ложь;
	КонецПопытки;
	
	БылоПроведение = ПараметрыЗаписи.Свойство("РежимЗаписи")
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение;
	
	Если ДокументПроведен Тогда
		ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	ИначеЕсли БылоПроведение Тогда
		ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;
	
	Если Не Форма.Записать(ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументПроведен Или БылоПроведение Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Изменения сохранены. Документ распроведён (или не проведён), согласование в 1С:Документооборот прервано и запущено заново.
				|Проведите документ после нового согласования.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
