#Область ПрограммныйИнтерфейс

// Возвращает признак разрешения проведения по правилам согласования в 1С:Документооборот.
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на документ.
//
// Возвращаемое значение:
//  Булево - Истина, если проведение разрешено контролем ДО.
//
Функция РазрешеноПроведениеПоСогласованиюДО(СсылкаНаОбъект) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПолноеИмя = СсылкаНаОбъект.Метаданные().ПолноеИмя();
	Организация = ОрганизацияДокумента(СсылкаНаОбъект);
	ДатаДокумента = ДатаДокумента(СсылкаНаОбъект);
	РезультатПроверки = РезультатПроверкиПроведения(СсылкаНаОбъект, ПолноеИмя, Организация, ДатаДокумента);
	Возврат РезультатПроверки.Разрешено;
	
КонецФункции

// Возвращает состояние согласования объекта в ДО по типовому регистру (без веб-вызова).
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на объект ERP.
//
// Возвращаемое значение:
//  Структура:
//    * ЕстьСвязьСДО - Булево
//    * Состояние - ПеречислениеСсылка.СостоянияСогласованияВДокументообороте, Неопределено
//    * Представление - Строка
//
Функция СостояниеСогласованияДО(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьСвязьСДО", Ложь);
	Результат.Вставить("Состояние", Неопределено);
	Результат.Вставить("Представление", НСтр("ru = 'Нет связи с Документооборотом'"));
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО КАК ИдентификаторОбъектаДО,
		|	СостоянияСогласованияВДокументообороте.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированныеС1СДокументооборотом
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСогласованияВДокументообороте КАК СостоянияСогласованияВДокументообороте
		|		ПО ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО = СостоянияСогласованияВДокументообороте.ИдентификаторОбъектаДО
		|ГДЕ
		|	ОбъектыИнтегрированныеС1СДокументооборотом.Объект = &СсылкаНаОбъект");
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЕстьСвязьСДО = Истина;
	Результат.Состояние = Выборка.Состояние;
	
	Если Не ЗначениеЗаполнено(Выборка.Состояние) Тогда
		Результат.Представление = НСтр("ru = 'Связан с ДО, состояние не задано'");
	Иначе
		Результат.Представление = Строка(Выборка.Состояние);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает настройку контроля по типу документа и организации.
//
// Параметры:
//  ПолноеИмя - Строка - например, "Документ.ПеремещениеТоваров".
//  Организация - СправочникСсылка.Организации - организация документа.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если записи нет.
//
Функция НастройкаКонтроля(ПолноеИмя, Организация) Экспорт
	
	Возврат нп_КонтрольПроведенияПоСогласованиюДОПовтИсп.НастройкаКонтроля(ПолноеИмя, Организация);
	
КонецФункции

// Обработчик подписки ПередЗаписью документа: запрет проведения до согласования в ДО.
//
// Параметры:
//  Источник - ДокументОбъект - записываемый документ.
//  Отказ - Булево - признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПроверитьПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмя = Источник.Метаданные().ПолноеИмя();
	Если Не нп_КонтрольПроведенияПоСогласованиюДОПовтИсп.ТипДокументаУчаствуетВКонтроле(ПолноеИмя) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОрганизацияДокумента(Источник);
	
	СсылкаДляПроверки = Источник.Ссылка;
	Если Не ЗначениеЗаполнено(СсылкаДляПроверки) Тогда
		СсылкаДляПроверки = Источник.ПолучитьСсылкуНового();
	КонецЕсли;
	
	ОбработатьПризнакПересогласованияПриЗаписи(Источник, ПолноеИмя, Организация);
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбработатьПересогласованиеПриПроведении(Источник, СсылкаДляПроверки, ПолноеИмя, Организация, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = РезультатПроверкиПроведения(СсылкаДляПроверки, ПолноеИмя, Организация, Источник.Дата);
	Если РезультатПроверки.Разрешено Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(РезультатПроверки.ТекстСообщения, Источник, , , Отказ);
	
КонецПроцедуры

// Список документов конфигурации для выбора в настройках (значение = полное имя, представление = синоним).
//
// Возвращаемое значение:
//  СписокЗначений
//
Функция СписокДокументовДляВыбора() Экспорт
	
	Результат = Новый СписокЗначений;
	
	Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
		Результат.Добавить(МетаданныеДокумента.ПолноеИмя(), МетаданныеДокумента.Представление());
	КонецЦикла;
	
	Результат.СортироватьПоПредставлению();
	Возврат Результат;
	
КонецФункции

// Список реквизитов и реквизитов ТЧ документа для белого списка.
//
// Параметры:
//  ПолноеИмя - Строка - например, "Документ.ПеремещениеТоваров".
//
// Возвращаемое значение:
//  СписокЗначений
//
Функция СписокРеквизитовДокументаДляВыбора(ПолноеИмя) Экспорт
	
	Результат = Новый СписокЗначений;
	
	Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Добавить("Дата", НСтр("ru = 'Дата'"));
	Результат.Добавить("Номер", НСтр("ru = 'Номер'"));
	
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Результат.Добавить(Реквизит.Имя, Реквизит.Представление());
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
			Ключ = ТабличнаяЧасть.Имя + "." + РеквизитТЧ.Имя;
			Представление = ТабличнаяЧасть.Представление() + "." + РеквизитТЧ.Представление();
			Результат.Добавить(Ключ, Представление);
		КонецЦикла;
	КонецЦикла;
	
	Результат.СортироватьПоПредставлению();
	Возврат Результат;
	
КонецФункции

// Признак существенных изменений объекта относительно данных БД (с учётом белого списка).
//
Функция ЕстьСущественныеИзмененияДляПересогласования(Источник) Экспорт
	
	Если Источник = Неопределено Или Источник.ЭтоНовый() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолноеИмя = Источник.Метаданные().ПолноеИмя();
	Организация = ОрганизацияДокумента(Источник);
	Разрешенные = нп_КонтрольПроведенияПоСогласованиюДОПовтИсп.РазрешенныеРеквизиты(ПолноеИмя, Организация);
	
	Возврат ЕстьСущественныеОтличияОтДанныхБД(Источник, Разрешенные);
	
КонецФункции

// Прерывает и перезапускает обработку объекта в ДО 3.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка
//
// Возвращаемое значение:
//  Структура:
//    * Успешно - Булево
//    * ТекстОшибки - Строка
//
Функция ВыполнитьПерезапускОбработкиДО3(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура("Успешно, ТекстОшибки", Ложь, "");
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не указан документ для перезапуска обработки ДО.'");
		Возврат Результат;
	КонецЕсли;
	
	ДанныеСвязи = ДанныеСвязиСДокументооборотом(СсылкаНаОбъект);
	Если Не ЗначениеЗаполнено(ДанныеСвязи.ИдентификаторОбъектаДО) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Документ не связан с 1С:Документооборот.'");
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Прокси = ИнтеграцияС1СДокументооборотБазоваяФункциональностьПовтИсп.ПолучитьПрокси();
	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	ДанныеОбработки = ИнтеграцияС1СДокументооборот3КлиентСервер.ДанныеОбработки(
		ДанныеСвязи.ИдентификаторОбъектаДО,
		ДанныеСвязи.ТипОбъектаДО,,
		НСтр("ru = 'Изменение документа в ERP: повторное согласование'"));
	
	ЗапросыПакета = Новый Массив;
	ЗапросыПакета.Добавить(ИнтеграцияС1СДокументооборот3.ПрерватьОбработкуЗапрос(Прокси, ДанныеОбработки));
	ЗапросыПакета.Добавить(ИнтеграцияС1СДокументооборот3.ПерезапуститьОбработкуЗапрос(Прокси, ДанныеОбработки));
	
	ОтветНаЗапросыПакета = ИнтеграцияС1СДокументооборотБазоваяФункциональность.ВыполнитьПакетныйЗапрос(
		Прокси,
		ЗапросыПакета);
	
	Для Каждого Ответ Из ОтветНаЗапросыПакета.responses Цикл
		Если ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, Ответ, "DMError") Тогда
			Результат.ТекстОшибки = СокрЛП(Ответ.description);
			ИнтеграцияС1СДокументооборотБазоваяФункциональность.ЗаписатьОшибкуXDTO(Ответ);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПризнакТребуетсяПересогласование(СсылкаНаОбъект, Ложь);
	Результат.Успешно = Истина;
	Возврат Результат;
	
КонецФункции

// Выводит на форме документа состояние согласования в ДО для типов с включённым контролем.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//
Процедура ПриСозданииФормыДокумента(Форма) Экспорт
	
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ОбъектФормы = Форма.Объект;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(ОбъектФормы) <> Тип("ДанныеФормыСтруктура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбъектФормы.Свойство("Ссылка") Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНаОбъект = ОбъектФормы.Ссылка;
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбщегоНазначения.ЭтоДокумент(СсылкаНаОбъект.Метаданные()) Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмя = СсылкаНаОбъект.Метаданные().ПолноеИмя();
	Организация = Неопределено;
	Если ОбъектФормы.Свойство("Организация") Тогда
		Организация = ОбъектФормы.Организация;
	Иначе
		Организация = ОрганизацияДокумента(СсылкаНаОбъект);
	КонецЕсли;
	
	Настройка = НастройкаКонтроля(ПолноеИмя, Организация);
	Если Настройка = Неопределено Или Не Настройка.КонтролироватьПроведение Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИспользуетсяСогласованиеЧерезДО() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние = СостояниеСогласованияДО(СсылкаНаОбъект);
	ДобавитьОтображениеСостоянияНаФорму(Форма, Состояние.Представление);
	
КонецПроцедуры

// Создаёт или обновляет настройку контроля для Документ.ПеремещениеТоваров по организации.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация, для которой создаётся настройка.
//  ДатаНачалаДействия - Дата - с какой даты документа действует контроль (по реквизиту Дата).
//                       Если не указана — начало текущего дня сеанса.
//
Процедура УстановитьНастройкуПоУмолчаниюДляПеремещенияТоваров(Организация, ДатаНачалаДействия = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана организация для настройки контроля проведения по ДО.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачалаДействия) Тогда
		ДатаНачалаДействия = НачалоДня(ТекущаяДатаСеанса());
	Иначе
		ДатаНачалаДействия = НачалоДня(ДатаНачалаДействия);
	КонецЕсли;
	
	ПолноеИмя = "Документ.ПеремещениеТоваров";
	
	МенеджерЗаписи = РегистрыСведений.нп_НастройкиКонтроляПроведенияПоДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПолноеИмяОбъектаМетаданных = ПолноеИмя;
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.Прочитать();
	
	МенеджерЗаписи.ПолноеИмяОбъектаМетаданных = ПолноеИмя;
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.КонтролироватьПроведение = Истина;
	МенеджерЗаписи.ДатаНачалаДействия = ДатаНачалаДействия;
	МенеджерЗаписи.Записать();
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИспользуетсяСогласованиеЧерезДО()
	
	Если Не Константы.ИспользоватьСогласованиеЧерез1СДокументооборот.Получить() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИспользуетсяИнтеграция =
		Константы.ИспользоватьИнтеграциюС1СДокументооборот.Получить()
		Или Константы.ИспользоватьИнтеграциюС1СДокументооборот3.Получить();
	
	Возврат ИспользуетсяИнтеграция;
	
КонецФункции

Функция ЕстьПравоОбходаКонтроля()
	
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат РольДоступна(Метаданные.Роли.нп_ПроведениеБезСогласованияДО);
	
КонецФункции

Функция ОрганизацияДокумента(Документ)
	
	Если Документ = Неопределено Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	МетаданныеДокумента = Документ.Метаданные();
	Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", МетаданныеДокумента) Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Документ)) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Организация");
	КонецЕсли;
	
	Возврат Документ.Организация;
	
КонецФункции

Функция ДатаДокумента(Документ)
	
	Если Документ = Неопределено Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Документ)) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Дата");
	КонецЕсли;
	
	Возврат Документ.Дата;
	
КонецФункции

Функция РезультатПроверкиПроведения(СсылкаНаОбъект, ПолноеИмя, Организация, ДатаДокумента)
	
	Результат = Новый Структура("Разрешено, ТекстСообщения", Истина, "");
	
	Если Не ИспользуетсяСогласованиеЧерезДО() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Настройка = НастройкаКонтроля(ПолноеИмя, Организация);
	Если Настройка = Неопределено Или Не Настройка.КонтролироватьПроведение Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.ДатаНачалаДействия)
		И НачалоДня(ДатаДокумента) < НачалоДня(Настройка.ДатаНачалаДействия) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЕстьПравоОбходаКонтроля() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Состояние = СостояниеСогласованияДО(СсылкаНаОбъект);
	Согласован = (Состояние.Состояние = Перечисления.СостоянияСогласованияВДокументообороте.Согласован);
	
	Если Согласован Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Разрешено = Ложь;
	Результат.ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Проведение запрещено: документ не согласован в 1С:Документооборот (текущее состояние: %1).'"),
		Состояние.Представление);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьОтображениеСостоянияНаФорму(Форма, ПредставлениеСостояния)
	
	ИмяРеквизита = "нп_СостояниеСогласованияДО";
	ИмяЭлемента = "нп_СостояниеСогласованияДО";
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	ЕстьРеквизит = Ложь;
	Для Каждого РеквизитФормы Из Форма.ПолучитьРеквизиты() Цикл
		Если РеквизитФормы.Имя = ИмяРеквизита Тогда
			ЕстьРеквизит = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьРеквизит Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200))));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	Форма[ИмяРеквизита] = ПредставлениеСостояния;
	
	Если Форма.Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		
		Родитель = Неопределено;
		Если Форма.Элементы.Найти("ГруппаШапка") <> Неопределено Тогда
			Родитель = Форма.Элементы.ГруппаШапка;
		ИначеЕсли Форма.Элементы.Найти("Шапка") <> Неопределено Тогда
			Родитель = Форма.Элементы.Шапка;
		КонецЕсли;
		
		Если Родитель = Неопределено Тогда
			Поле = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"));
		Иначе
			Поле = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		КонецЕсли;
		
		Поле.Вид = ВидПоляФормы.ПолеНадписи;
		Поле.ПутьКДанным = ИмяРеквизита;
		Поле.Заголовок = НСтр("ru = 'Согласование ДО'");
		Поле.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Защищённое окно: есть связь с ДО и состояние ещё не «Не согласован»
// (пустое / НаСогласовании / Согласован) — закрывает рассинхрон до прихода статуса из обмена.
//
Функция ДокументВЗащищенномОкнеСогласования(ДанныеСостояния)
	
	Если ДанныеСостояния = Неопределено Или Не ДанныеСостояния.ЕстьСвязьСДО Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДанныеСостояния.Состояние = Перечисления.СостоянияСогласованияВДокументообороте.НеСогласован Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция КонтрольПересогласованияПрименим(СсылкаНаОбъект)
	
	Если Не ИспользуетсяСогласованиеЧерезДО() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Константы.ИспользоватьИнтеграциюС1СДокументооборот3.Получить() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолноеИмя = СсылкаНаОбъект.Метаданные().ПолноеИмя();
	Организация = ОрганизацияДокумента(СсылкаНаОбъект);
	Настройка = НастройкаКонтроля(ПолноеИмя, Организация);
	Если Настройка = Неопределено Или Не Настройка.КонтролироватьПроведение Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.ДатаНачалаДействия)
		И НачалоДня(ДатаДокумента(СсылкаНаОбъект)) < НачалоДня(Настройка.ДатаНачалаДействия) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОбработатьПризнакПересогласованияПриЗаписи(Источник, ПолноеИмя, Организация)
	
	Если ЕстьПравоОбходаКонтроля() Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Настройка = НастройкаКонтроля(ПолноеИмя, Организация);
	Если Настройка = Неопределено Или Не Настройка.КонтролироватьПроведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.ДатаНачалаДействия)
		И НачалоДня(Источник.Дата) < НачалоДня(Настройка.ДатаНачалаДействия) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСостояния = СостояниеСогласованияДО(Источник.Ссылка);
	Если Не ДокументВЗащищенномОкнеСогласования(ДанныеСостояния) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьСущественныеИзмененияДляПересогласования(Источник) Тогда
		УстановитьПризнакТребуетсяПересогласование(Источник.Ссылка, Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьПересогласованиеПриПроведении(Источник, СсылкаДляПроверки, ПолноеИмя, Организация, Отказ)
	
	Если ЕстьПравоОбходаКонтроля() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Настройка = НастройкаКонтроля(ПолноеИмя, Организация);
	Если Настройка = Неопределено Или Не Настройка.КонтролироватьПроведение Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.ДатаНачалаДействия)
		И НачалоДня(Источник.Дата) < НачалоДня(Настройка.ДатаНачалаДействия) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеСостояния = СостояниеСогласованияДО(СсылкаДляПроверки);
	НужноПересогласование = ПризнакТребуетсяПересогласование(СсылкаДляПроверки)
		Или (ДокументВЗащищенномОкнеСогласования(ДанныеСостояния)
			И Не Источник.ЭтоНовый()
			И ЕстьСущественныеИзмененияДляПересогласования(Источник));
	
	Если Не НужноПересогласование Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Контроль только при проведении: перезапуск ДО 3 и отказ до нового согласования (без привязки к форме).
	РезультатПерезапуска = ВыполнитьПерезапускОбработкиДО3(СсылкаДляПроверки);
	Если Не РезультатПерезапуска.Успешно Тогда
		Отказ = Истина;
		ТекстОшибки = РезультатПерезапуска.ТекстОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось перезапустить обработку в 1С:Документооборот.'");
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Источник,,, Отказ);
		Возврат Истина;
	КонецЕсли;
	
	Отказ = Истина;
	ОбщегоНазначения.СообщитьПользователю(
		НСтр("ru = 'Документ изменён после согласования. Обработка в 1С:Документооборот прервана и запущена заново. Проведите документ после нового согласования.'"),
		Источник,,,
		Отказ);
	Возврат Истина;
	
КонецФункции

Функция ПризнакТребуетсяПересогласование(СсылкаНаОбъект)
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.нп_ПризнакиПересогласованияДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = СсылкаНаОбъект;
	МенеджерЗаписи.Прочитать();
	Результат = МенеджерЗаписи.Выбран() И МенеджерЗаписи.ТребуетсяПересогласование;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПризнакТребуетсяПересогласование(СсылкаНаОбъект, Требуется)
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.нп_ПризнакиПересогласованияДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = СсылкаНаОбъект;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Документ = СсылкаНаОбъект;
	МенеджерЗаписи.ТребуетсяПересогласование = Требуется;
	МенеджерЗаписи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ДанныеСвязиСДокументооборотом(СсылкаНаОбъект)
	
	Результат = Новый Структура("ИдентификаторОбъектаДО, ТипОбъектаДО", "", "");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Связи.ИдентификаторОбъектаДО КАК ИдентификаторОбъектаДО,
		|	Связи.ТипОбъектаДО КАК ТипОбъектаДО
		|ИЗ
		|	РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК Связи
		|ГДЕ
		|	Связи.Объект = &СсылкаНаОбъект");
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ИдентификаторОбъектаДО = Выборка.ИдентификаторОбъектаДО;
		Результат.ТипОбъектаДО = Выборка.ТипОбъектаДО;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьСущественныеОтличияОтДанныхБД(Источник, Разрешенные)
	
	МетаданныеДокумента = Источник.Метаданные();
	Ссылка = Источник.Ссылка;
	
	ИменаРеквизитов = Новый Массив;
	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		Если Разрешенные.Получить(Реквизит.Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		ИменаРеквизитов.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Если ИменаРеквизитов.Количество() > 0 Тогда
		ЗначенияБД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ИменаРеквизитов);
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			Если Источник[ИмяРеквизита] <> ЗначенияБД[ИмяРеквизита] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Разрешенные.Получить("Дата") <> Истина И Источник.Дата <> Ссылка.Дата Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
		КолонкиСравнения = Новый Массив;
		Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
			Ключ = ТабличнаяЧасть.Имя + "." + РеквизитТЧ.Имя;
			Если Разрешенные.Получить(Ключ) = Истина Тогда
				Продолжить;
			КонецЕсли;
			КолонкиСравнения.Добавить(РеквизитТЧ.Имя);
		КонецЦикла;
		
		Если КолонкиСравнения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаОбъекта = Источник[ТабличнаяЧасть.Имя].Выгрузить(, СтрСоединить(КолонкиСравнения, ","));
		ТаблицаБД = Ссылка[ТабличнаяЧасть.Имя].Выгрузить(, СтрСоединить(КолонкиСравнения, ","));
		
		Если Не ОбщегоНазначения.ДанныеСовпадают(ТаблицаОбъекта, ТаблицаБД) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
