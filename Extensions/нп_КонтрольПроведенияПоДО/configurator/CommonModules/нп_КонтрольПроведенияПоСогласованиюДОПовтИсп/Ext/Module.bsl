#Область СлужебныйПрограммныйИнтерфейс

// Возвращает настройку контроля по типу документа и организации (кэш на время сеанса).
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//  Организация - СправочникСсылка.Организации - организация.
//
// Возвращаемое значение:
//  Структура, Неопределено
//
Функция НастройкаКонтроля(ПолноеИмя, Организация) Экспорт
	
	Если Не ЗначениеЗаполнено(ПолноеИмя) Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.ПолноеИмяОбъектаМетаданных КАК ПолноеИмяОбъектаМетаданных,
		|	Настройки.Организация КАК Организация,
		|	Настройки.КонтролироватьПроведение КАК КонтролироватьПроведение,
		|	Настройки.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	Настройки.ОтборПоРеквизитам КАК ОтборПоРеквизитам,
		|	Настройки.УчастникиКонтроля КАК УчастникиКонтроля
		|ИЗ
		|	РегистрСведений.нп_НастройкиКонтроляПроведенияПоДО КАК Настройки
		|ГДЕ
		|	Настройки.ПолноеИмяОбъектаМетаданных = &ПолноеИмя
		|	И Настройки.Организация = &Организация");
	Запрос.УстановитьПараметр("ПолноеИмя", ПолноеИмя);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ПолноеИмяОбъектаМетаданных", Выборка.ПолноеИмяОбъектаМетаданных);
	Результат.Вставить("Организация", Выборка.Организация);
	Результат.Вставить("КонтролироватьПроведение", Выборка.КонтролироватьПроведение);
	Результат.Вставить("ДатаНачалаДействия", Выборка.ДатаНачалаДействия);
	Результат.Вставить("ОтборКомпоновки", ОтборКомпоновкиИзХранилища(Выборка.ОтборПоРеквизитам));
	Результат.Вставить("Участники", УчастникиИзХранилища(Выборка.УчастникиКонтроля));
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие разрешённых имён реквизитов (ключ = имя или ТЧ.Реквизит).
//
Функция РазрешенныеРеквизиты(ПолноеИмя, Организация) Экспорт
	
	Результат = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(ПолноеИмя) Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	РазрешенныеРеквизиты.ИмяРеквизита КАК ИмяРеквизита
		|ИЗ
		|	РегистрСведений.нп_РазрешенныеРеквизитыПриСогласованииДО КАК РазрешенныеРеквизиты
		|ГДЕ
		|	РазрешенныеРеквизиты.ПолноеИмяОбъектаМетаданных = &ПолноеИмя
		|	И РазрешенныеРеквизиты.Организация = &Организация");
	Запрос.УстановитьПараметр("ПолноеИмя", ПолноеИмя);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ИмяРеквизита, Истина);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Признак: для типа документа есть хотя бы одна запись настроек контроля (кэш сеанса).
//
Функция ТипДокументаУчаствуетВКонтроле(ПолноеИмя) Экспорт
	
	Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьНастройка
		|ИЗ
		|	РегистрСведений.нп_НастройкиКонтроляПроведенияПоДО КАК Настройки
		|ГДЕ
		|	Настройки.ПолноеИмяОбъектаМетаданных = &ПолноеИмя
		|	И Настройки.КонтролироватьПроведение");
	Запрос.УстановитьПараметр("ПолноеИмя", ПолноеИмя);
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Группы текущего пользователя из РС СоставыГруппПользователей (кэш сеанса).
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ГруппыПользователей
//
Функция ГруппыТекущегоПользователя() Экспорт
	
	Результат = Новый Массив;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СоставыГруппПользователей.ГруппаПользователей КАК ГруппаПользователей
		|ИЗ
		|	РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
		|ГДЕ
		|	СоставыГруппПользователей.Пользователь = &ТекущийПользователь
		|	И СоставыГруппПользователей.Используется");
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ГруппаПользователей);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтборКомпоновкиИзХранилища(Хранилище)
	
	Если Хранилище = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ЗначениеХранилища = Хранилище.Получить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ЗначениеХранилища = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отбор = Неопределено;
	Если ТипЗнч(ЗначениеХранилища) = Тип("НастройкиКомпоновкиДанных") Тогда
		Отбор = ЗначениеХранилища.Отбор;
	ИначеЕсли ТипЗнч(ЗначениеХранилища) = Тип("ОтборКомпоновкиДанных") Тогда
		Отбор = ЗначениеХранилища;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не нп_КонтрольПроведенияПоСогласованиюДОКлиентСервер.ЕстьАктивныеЭлементыОтбора(Отбор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Отбор;
	
КонецФункции

Функция УчастникиИзХранилища(Хранилище)
	
	Результат = Новый Массив;
	
	Если Хранилище = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ЗначениеХранилища = Хранилище.Получить();
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Если ЗначениеХранилища = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеХранилища) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаТаблицы Из ЗначениеХранилища Цикл
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.Участник) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Новый Структура("Участник, ВидСтроки",
				СтрокаТаблицы.Участник, ВидСтрокиУчастникаИзСтрокиХранилища(СтрокаТаблицы)));
		КонецЦикла;
	ИначеЕсли ТипЗнч(ЗначениеХранилища) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из ЗначениеХранилища Цикл
			Если ТипЗнч(ЭлементМассива) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Участник = Неопределено;
			ЭлементМассива.Свойство("Участник", Участник);
			Если Не ЗначениеЗаполнено(Участник) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Новый Структура("Участник, ВидСтроки",
				Участник, ВидСтрокиУчастникаИзСтруктуры(ЭлементМассива)));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВидСтрокиУчастникаИзСтрокиХранилища(СтрокаТаблицы)
	
	Если СтрокаТаблицы.Владелец().Колонки.Найти("ВключаяИсключая") <> Неопределено
		И ЗначениеЗаполнено(СтрокаТаблицы.ВключаяИсключая) Тогда
		Возврат СтрокаТаблицы.ВключаяИсключая;
	КонецЕсли;
	
	Если СтрокаТаблицы.Владелец().Колонки.Найти("ВидСтроки") <> Неопределено
		И ЗначениеЗаполнено(СтрокаТаблицы.ВидСтроки) Тогда
		Возврат СтрокаТаблицы.ВидСтроки;
	КонецЕсли;
	
	Возврат Перечисления.нп_ВидыСтрокУчастниковКонтроля.Включая;
	
КонецФункции

Функция ВидСтрокиУчастникаИзСтруктуры(ЭлементМассива)
	
	ВидСтроки = Неопределено;
	Если ЭлементМассива.Свойство("ВключаяИсключая", ВидСтроки) И ЗначениеЗаполнено(ВидСтроки) Тогда
		Возврат ВидСтроки;
	КонецЕсли;
	
	Если ЭлементМассива.Свойство("ВидСтроки", ВидСтроки) И ЗначениеЗаполнено(ВидСтроки) Тогда
		Возврат ВидСтроки;
	КонецЕсли;
	
	Возврат Перечисления.нп_ВидыСтрокУчастниковКонтроля.Включая;
	
КонецФункции

#КонецОбласти
