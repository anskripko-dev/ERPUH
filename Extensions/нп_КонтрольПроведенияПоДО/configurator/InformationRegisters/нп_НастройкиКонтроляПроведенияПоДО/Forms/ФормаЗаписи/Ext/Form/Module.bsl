#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокВыбораДокументов();
	ИнициализироватьРеквизитыОтборов();
	ОбновитьДоступныеПоляОтбора();
	ЗагрузитьОтборИзХранилища();
	ЗагрузитьУчастниковИзХранилища();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ОтборПоРеквизитам = Новый ХранилищеЗначения(КомпоновщикОтбора.Настройки);
	ТекущийОбъект.УчастникиКонтроля = Новый ХранилищеЗначения(ТаблицаУчастниковВЗначение());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолноеИмяОбъектаМетаданныхПриИзменении(Элемент)
	
	ОбновитьДоступныеПоляОтбора();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораДокументов()
	
	Элементы.ПолноеИмяОбъектаМетаданных.СписокВыбора.Очистить();
	
	Для Каждого ЭлементСписка Из нп_КонтрольПроведенияПоСогласованиюДО.СписокДокументовДляВыбора() Цикл
		Элементы.ПолноеИмяОбъектаМетаданных.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьРеквизитыОтборов()
	
	Если Элементы.Найти("ГруппаОтборы") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаОтборы = Элементы.Добавить("ГруппаОтборы", Тип("ГруппаФормы"));
	ГруппаОтборы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтборы.Заголовок = НСтр("ru = 'Условия применимости'");
	ГруппаОтборы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаОтборы.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	
	ГруппаСКД = Элементы.Добавить("ГруппаОтбораПоРеквизитам", Тип("ГруппаФормы"), ГруппаОтборы);
	ГруппаСКД.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСКД.Заголовок = НСтр("ru = 'Отбор по реквизитам'");
	ГруппаСКД.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ТаблицаОтбора = Элементы.Добавить("ТаблицаОтбора", Тип("ТаблицаФормы"), ГруппаСКД);
	ТаблицаОтбора.ПутьКДанным = "КомпоновщикОтбора.Настройки.Отбор";
	ТаблицаОтбора.ВысотаВСтрокахТаблицы = 6;
	
	ГруппаУчастники = Элементы.Добавить("ГруппаУчастников", Тип("ГруппаФормы"), ГруппаОтборы);
	ГруппаУчастники.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаУчастники.Заголовок = НСтр("ru = 'Участники (пусто = все)'");
	ГруппаУчастники.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ТаблицаУчастников = Элементы.Добавить("Участники", Тип("ТаблицаФормы"), ГруппаУчастники);
	ТаблицаУчастников.ПутьКДанным = "Участники";
	ТаблицаУчастников.ВысотаВСтрокахТаблицы = 5;
	
	ПолеВида = Элементы.Добавить("УчастникиВидСтроки", Тип("ПолеФормы"), ТаблицаУчастников);
	ПолеВида.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВида.ПутьКДанным = "Участники.ВидСтроки";
	
	ПолеУчастника = Элементы.Добавить("УчастникиУчастник", Тип("ПолеФормы"), ТаблицаУчастников);
	ПолеУчастника.Вид = ВидПоляФормы.ПолеВвода;
	ПолеУчастника.ПутьКДанным = "Участники.Участник";
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступныеПоляОтбора()
	
	ПолноеИмя = Запись.ПолноеИмяОбъектаМетаданных;
	Если ПустаяСтрока(ПолноеИмя) Тогда
		КомпоновщикОтбора = Новый КомпоновщикНастроекКомпоновкиДанных;
		Возврат;
	КонецЕсли;
	
	СнимокНастроек = Неопределено;
	Если нп_КонтрольПроведенияПоСогласованиюДОКлиентСервер.ЕстьАктивныеЭлементыОтбора(КомпоновщикОтбора.Настройки.Отбор) Тогда
		СнимокНастроек = Новый ХранилищеЗначения(КомпоновщикОтбора.Настройки);
	КонецЕсли;
	
	Схема = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = Схема.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "ОсновнойНабор";
	НаборДанных.Запрос = "ВЫБРАТЬ * ИЗ " + ПолноеИмя + " КАК ОсновнаяТаблица";
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	Схема.ПоляИтога.Очистить();
	
	АдресСхемы = ПоместитьВоВременноеХранилище(Схема, УникальныйИдентификатор);
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	
	КомпоновщикОтбора = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикОтбора.Инициализировать(Источник);
	
	Если СнимокНастроек <> Неопределено Тогда
		Попытка
			ВосстановленныеНастройки = СнимокНастроек.Получить();
			КомпоновщикОтбора.ЗагрузитьНастройки(ВосстановленныеНастройки);
		Исключение
			ЗагрузитьОтборИзХранилища();
		КонецПопытки;
	Иначе
		ЗагрузитьОтборИзХранилища();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОтборИзХранилища()
	
	ОтборПоРеквизитам = Запись.ОтборПоРеквизитам;
	Если Не ЗначениеЗаполнено(ОтборПоРеквизитам) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		СохраненныеНастройки = ОтборПоРеквизитам.Получить();
		Если ТипЗнч(СохраненныеНастройки) = Тип("НастройкиКомпоновкиДанных") Тогда
			КомпоновщикОтбора.ЗагрузитьНастройки(СохраненныеНастройки);
		КонецЕсли;
	Исключение
		// повреждённое хранилище — оставляем пустой отбор
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьУчастниковИзХранилища()
	
	Участники.Очистить();
	
	Хранилище = Запись.УчастникиКонтроля;
	Если Не ЗначениеЗаполнено(Хранилище) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗначениеХранилища = Хранилище.Получить();
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(ЗначениеХранилища) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ЗначениеХранилища Цикл
		НоваяСтрока = Участники.Добавить();
		НоваяСтрока.Участник = СтрокаТаблицы.Участник;
		НоваяСтрока.ВидСтроки = СтрокаТаблицы.ВидСтроки;
		Если Не ЗначениеЗаполнено(НоваяСтрока.ВидСтроки) Тогда
			НоваяСтрока.ВидСтроки = Перечисления.нп_ВидыСтрокУчастниковКонтроля.Включая;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаУчастниковВЗначение()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Участник");
	Результат.Колонки.Добавить("ВидСтроки");
	
	Для Каждого СтрокаФормы Из Участники Цикл
		Если Не ЗначениеЗаполнено(СтрокаФормы.Участник) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Участник = СтрокаФормы.Участник;
		НоваяСтрока.ВидСтроки = СтрокаФормы.ВидСтроки;
		Если Не ЗначениеЗаполнено(НоваяСтрока.ВидСтроки) Тогда
			НоваяСтрока.ВидСтроки = Перечисления.нп_ВидыСтрокУчастниковКонтроля.Включая;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
