#Область ПрограммныйИнтерфейс

// Проверяет, удовлетворяют ли Данные корневому элементу/группе отбора компоновки данных.
//
// Параметры:
//   ЭлементОтбора - ОтборКомпоновкиДанных
//                  - ГруппаЭлементовОтбораКомпоновкиДанных
//                  - ЭлементОтбораКомпоновкиДанных
//   Данные        - Произвольный - объект с реквизитами (СправочникОбъект,
//                    ДокументОбъект, строка табличной секции/набора записей)
//
// Возвращаемое значение:
//   Булево
Функция ОтборВыполняется(Знач ЭлементОтбора, Знач Данные) Экспорт

	Если ЭлементОтбора = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(ЭлементОтбора) = Тип("ОтборКомпоновкиДанных") Тогда
		Возврат ГруппаВыполняется(ЭлементОтбора, Данные);
	ИначеЕсли Не ЭлементОтбораИспользуется(ЭлементОтбора) Тогда
		Возврат Истина; // отключенный элемент/группа не влияет на результат
	ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		Возврат ГруппаВыполняется(ЭлементОтбора, Данные);
	Иначе
		Возврат УсловиеВыполняется(ЭлементОтбора, Данные);
	КонецЕсли;

КонецФункции

// Универсальное получение значения по точечному пути реквизита,
// например "Контрагент.ЮрФизЛицо" или "Организация.ГоловнаяОрганизация.Наименование".
//
// Параметры:
//   Данные - Произвольный - объект с реквизитами.
//   Путь   - Строка - точечный путь к реквизиту.
//
// Возвращаемое значение:
//   Произвольный - значение по пути; Неопределено, если путь не найден.
Функция ПолучитьЗначениеПоПути(Знач Данные, Знач Путь) Экспорт

	Если Данные = Неопределено Или ПустаяСтрока(Путь) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = СтрРазделить(Путь, ".", Ложь);
	Текущее = Данные;

	Для Каждого Часть Из Части Цикл

		Если Текущее = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Попытка
			Текущее = Текущее[Часть];
		Исключение
			Возврат Неопределено;
		КонецПопытки;

	КонецЦикла;

	Возврат Текущее;

КонецФункции

// Сравнивает Значение с ЗначениеСравнения согласно виду сравнения компоновки данных.
//
// Параметры:
//   Значение           - Произвольный
//   ВидСравнения       - ВидСравненияКомпоновкиДанных
//   ЗначениеСравнения  - Произвольный
//
// Возвращаемое значение:
//   Булево
Функция ЗначениеУдовлетворяетУсловию(Знач Значение, Знач ВидСравнения, Знач ЗначениеСравнения) Экспорт

	Если ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
		Возврат Значение = ЗначениеСравнения;

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
		Возврат Значение <> ЗначениеСравнения;

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
		Возврат Значение > ЗначениеСравнения;

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
		Возврат Значение >= ЗначениеСравнения;

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
		Возврат Значение < ЗначениеСравнения;

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
		Возврат Значение <= ЗначениеСравнения;

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
		Возврат ЗначениеЗаполнено(Значение);

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Возврат Не ЗначениеЗаполнено(Значение);

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит Тогда
		Возврат (Значение <> Неопределено)
			И (СтрНайти(Строка(Значение), Строка(ЗначениеСравнения)) > 0);

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
		Возврат (Значение = Неопределено)
			Или (СтрНайти(Строка(Значение), Строка(ЗначениеСравнения)) = 0);

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
		Возврат ЗначениеВСписке(Значение, ЗначениеСравнения);

	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
		Возврат Не ЗначениеВСписке(Значение, ЗначениеСравнения);

	Иначе
		// Виды сравнения, требующие иерархии (ВИерархии/НеВИерархии/ВГруппе и т.п.),
		// упрощенным обходчиком в памяти не поддерживаются - при необходимости
		// точной семантики использовать прогон через ПроцессорКомпоновкиДанных
		// (см. design.md, Решение 5).
		Возврат Ложь;

	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает Истина, если в дереве отбора есть хотя бы одно используемое условие.
//
// Параметры:
//   ЭлементОтбора - ОтборКомпоновкиДанных
//                 - ГруппаЭлементовОтбораКомпоновкиДанных
//                 - ЭлементОтбораКомпоновкиДанных
//
// Возвращаемое значение:
//   Булево
Функция ЕстьАктивныеЭлементыОтбора(Знач ЭлементОтбора) Экспорт

	Если ЭлементОтбора = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(ЭлементОтбора) = Тип("ОтборКомпоновкиДанных")
		Или ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда

		Для Каждого Дочерний Из ЭлементОтбора.Элементы Цикл
			Если ЕстьАктивныеЭлементыОтбора(Дочерний) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;

		Возврат Ложь;

	КонецЕсли;

	Возврат ЭлементОтбораИспользуется(ЭлементОтбора);

КонецФункции

// Корневой ОтборКомпоновкиДанных не имеет реквизита Использование — только
// элементы и вложенные группы.
Функция ЭлементОтбораИспользуется(Элемент)

	Если Элемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Элемент) = Тип("ОтборКомпоновкиДанных") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Элемент.Использование <> Ложь;

КонецФункции

// Проверяет условие группы элементов отбора компоновки данных.
// Для типа «И» условия по одной табличной части проверяются на одной строке ТЧ.
//
// Параметры:
//   Группа - ГруппаЭлементовОтбораКомпоновкиДанных, ОтборКомпоновкиДанных - группа отбора.
//   Данные - Произвольный - проверяемый объект или строка набора.
//
// Возвращаемое значение:
//   Булево - Истина, если группа отбора выполняется для данных.
Функция ГруппаВыполняется(Группа, Данные)

	Если Не ЭлементОтбораИспользуется(Группа) Тогда
		Возврат Истина;
	КонецЕсли;

	// ОтборКомпоновкиДанных (корень) ведет себя как группа с типом "И".
	ТипГруппы = Неопределено;
	Если ТипЗнч(Группа) <> Тип("ОтборКомпоновкиДанных") Тогда
		ТипГруппы = Группа.ГруппаЭлементов;
	КонецЕсли;

	ЭтоГруппаИ = (ТипГруппы = Неопределено
		Или ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);

	Если ЭтоГруппаИ Тогда
		Возврат ГруппаИВыполняется(Группа, Данные);
	КонецЕсли;

	КоличествоАктивных = 0;
	ЕстьИстинный = Ложь;
	ЕстьЛожный   = Ложь;

	Для Каждого Дочерний Из Группа.Элементы Цикл

		ЭтоГруппа = (ТипЗнч(Дочерний) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		Если Не ЭлементОтбораИспользуется(Дочерний) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоАктивных = КоличествоАктивных + 1;

		Если ЭтоГруппа Тогда
			Результат = ГруппаВыполняется(Дочерний, Данные);
		Иначе
			Результат = УсловиеВыполняется(Дочерний, Данные);
		КонецЕсли;

		Если Результат Тогда
			ЕстьИстинный = Истина;
		Иначе
			ЕстьЛожный = Истина;
		КонецЕсли;

	КонецЦикла;

	Если КоличествоАктивных = 0 Тогда
		Возврат Истина; // пустая/полностью отключенная группа не ограничивает
	КонецЕсли;

	Если ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли Тогда
		Возврат ЕстьИстинный;
	ИначеЕсли ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда
		Возврат Не ЕстьИстинный;
	Иначе
		Возврат Не ЕстьЛожный;
	КонецЕсли;

КонецФункции

// Проверяет группу «И»: шапка — по объекту; поля одной ТЧ — по одной строке ТЧ.
Функция ГруппаИВыполняется(Группа, Данные)

	УсловияПоТабличнымЧастям = Новый Соответствие;
	ЕстьЛожный = Ложь;
	КоличествоАктивных = 0;

	Для Каждого Дочерний Из Группа.Элементы Цикл

		ЭтоГруппа = (ТипЗнч(Дочерний) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		Если Не ЭлементОтбораИспользуется(Дочерний) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоАктивных = КоличествоАктивных + 1;

		Если ЭтоГруппа Тогда
			Если Не ГруппаВыполняется(Дочерний, Данные) Тогда
				ЕстьЛожный = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		ПутьПоля = ПутьПоляОтбора(Дочерний.ЛевоеЗначение);
		ИмяТЧ = ИмяТабличнойЧастиИзПути(Данные, ПутьПоля);

		Если ПустаяСтрока(ИмяТЧ) Тогда
			Если Не УсловиеВыполняется(Дочерний, Данные) Тогда
				ЕстьЛожный = Истина;
			КонецЕсли;
		Иначе
			УсловияТЧ = УсловияПоТабличнымЧастям.Получить(ИмяТЧ);
			Если УсловияТЧ = Неопределено Тогда
				УсловияТЧ = Новый Массив;
				УсловияПоТабличнымЧастям.Вставить(ИмяТЧ, УсловияТЧ);
			КонецЕсли;
			УсловияТЧ.Добавить(Дочерний);
		КонецЕсли;

	КонецЦикла;

	Если КоличествоАктивных = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЕстьЛожный Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючИЗначение Из УсловияПоТабличнымЧастям Цикл
		Если Не ЕстьСтрокаТабличнойЧастиПоУсловиям(Данные, КлючИЗначение.Ключ, КлючИЗначение.Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет условие одного элемента отбора компоновки данных.
// Для пути вида «Товары.Номенклатура» — Истина, если хотя бы одна строка ТЧ подходит.
//
// Параметры:
//   Элемент - ЭлементОтбораКомпоновкиДанных - элемент отбора.
//   Данные - Произвольный - проверяемый объект или строка набора.
//
// Возвращаемое значение:
//   Булево - Истина, если условие элемента выполняется.
Функция УсловиеВыполняется(Элемент, Данные)

	ПутьПоля = ПутьПоляОтбора(Элемент.ЛевоеЗначение);
	Если ПустаяСтрока(ПутьПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяТЧ = ИмяТабличнойЧастиИзПути(Данные, ПутьПоля);
	Если Не ПустаяСтрока(ИмяТЧ) Тогда
		УсловияТЧ = Новый Массив;
		УсловияТЧ.Добавить(Элемент);
		Возврат ЕстьСтрокаТабличнойЧастиПоУсловиям(Данные, ИмяТЧ, УсловияТЧ);
	КонецЕсли;

	Значение = ПолучитьЗначениеПоПути(Данные, ПутьПоля);
	ЗначениеСравнения = ЗначениеОтбора(Элемент.ПравоеЗначение);

	Попытка
		Возврат ЗначениеУдовлетворяетУсловию(Значение, Элемент.ВидСравнения, ЗначениеСравнения);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает имя ТЧ, если первый сегмент пути — табличная часть объекта; иначе "".
Функция ИмяТабличнойЧастиИзПути(Данные, ПутьПоля)

	Если Данные = Неопределено Или ПустаяСтрока(ПутьПоля) Тогда
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(ПутьПоля, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	ИмяТЧ = Части[0];
	Попытка
		ЗначениеТЧ = Данные[ИмяТЧ];
	Исключение
		Возврат "";
	КонецПопытки;

	Если ЭтоТабличнаяЧасть(ЗначениеТЧ) Тогда
		Возврат ИмяТЧ;
	КонецЕсли;

	Возврат "";

КонецФункции

// Истина, если значение — коллекция строк ТЧ объекта или данных формы.
Функция ЭтоТабличнаяЧасть(Значение)

	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ПредставлениеТипа = ВРег(Строка(ТипЗнч(Значение)));
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если СтрНайти(ПредставлениеТипа, ВРег("ТабличнаяЧасть")) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	// На форме документ/справочник представлен данными формы: ТЧ = ДанныеФормыКоллекция.
	Если СтрНайти(ПредставлениеТипа, ВРег("ДанныеФормыКоллекция")) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Истина, если в ТЧ есть строка, удовлетворяющая всем условиям (пути без имени ТЧ).
Функция ЕстьСтрокаТабличнойЧастиПоУсловиям(Данные, ИмяТЧ, Условия)

	Попытка
		ТабличнаяЧасть = Данные[ИмяТЧ];
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если Не ЭтоТабличнаяЧасть(ТабличнаяЧасть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПрефиксТЧ = ИмяТЧ + ".";
	ДлинаПрефикса = СтрДлина(ПрефиксТЧ);

	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл

		СтрокаПодходит = Истина;

		Для Каждого Элемент Из Условия Цикл

			ПутьПоля = ПутьПоляОтбора(Элемент.ЛевоеЗначение);
			Если СтрНачинаетсяС(ПутьПоля, ПрефиксТЧ) Тогда
				ПутьВСтроке = Сред(ПутьПоля, ДлинаПрефикса + 1);
			Иначе
				ПутьВСтроке = ПутьПоля;
			КонецЕсли;

			Значение = ПолучитьЗначениеПоПути(СтрокаТЧ, ПутьВСтроке);
			ЗначениеСравнения = ЗначениеОтбора(Элемент.ПравоеЗначение);

			Попытка
				УсловиеОк = ЗначениеУдовлетворяетУсловию(
					Значение, Элемент.ВидСравнения, ЗначениеСравнения);
			Исключение
				УсловиеОк = Ложь;
			КонецПопытки;

			Если Не УсловиеОк Тогда
				СтрокаПодходит = Ложь;
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если СтрокаПодходит Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает путь реквизита объекта из левого значения элемента отбора СКД.
// Префикс псевдонима набора данных (например, "ОсновнаяТаблица.") отбрасывается.
Функция ПутьПоляОтбора(ЛевоеЗначение)

	Если ЛевоеЗначение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Путь = ИзвлечьПутьИзЛевогоЗначенияОтбора(ЛевоеЗначение);
	Если ПустаяСтрока(Путь) Тогда
		Попытка
			Путь = Строка(ЛевоеЗначение);
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;

	Возврат НормализоватьПутьПоляОтбора(Путь);

КонецФункции

// Извлекает строковый путь поля из ЛевоеЗначение элемента отбора СКД.
// После ХранилищеЗначения тип может отличаться от ПолеКомпоновкиДанных.
Функция ИзвлечьПутьИзЛевогоЗначенияОтбора(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Значение.Поле;
	Исключение
		// Платформа/XDTO: свойство Поле недоступно напрямую — пробуем другие формы.
	КонецПопытки;

	Если ТипЗнч(Значение) = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда

		ЗначениеПоля = Неопределено;
		Если Значение.Свойство("Поле", ЗначениеПоля) Тогда
			Возврат Строка(ЗначениеПоля);
		КонецЕсли;

	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда

		ЗначениеПоля = Значение.Получить("Поле");
		Если ЗначениеПоля <> Неопределено Тогда
			Возврат Строка(ЗначениеПоля);
		КонецЕсли;

	КонецЕсли;

	Возврат "";

КонецФункции

// Убирает обрамление и префикс псевдонима набора данных в пути поля отбора.
// Срезается только известный псевдоним «ОсновнаяТаблица», чтобы не терять имя ТЧ.
Функция НормализоватьПутьПоляОтбора(Путь)

	Путь = СокрЛП(Путь);
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Если СтрНачинаетсяС(Путь, "{") И СтрЗаканчиваетсяНа(Путь, "}") Тогда
		Путь = Сред(Путь, 2, СтрДлина(Путь) - 2);
	КонецЕсли;

	ПрефиксНабора = "ОсновнаяТаблица.";
	Если СтрНачинаетсяС(Путь, ПрефиксНабора) Тогда
		Путь = Сред(Путь, СтрДлина(ПрефиксНабора) + 1);
	КонецЕсли;

	Возврат Путь;

КонецФункции

// Нормализует правое значение элемента отбора для сравнения.
Функция ЗначениеОтбора(ПравоеЗначение)

	Если ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементСписка Из ПравоеЗначение Цикл
			Результат.Добавить(ЭлементСписка.Значение);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат ПравоеЗначение;

КонецФункции

// Проверяет вхождение значения в список сравнения компоновки данных.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//   ЗначениеСравнения - СписокЗначений, Массив, Произвольный - эталон сравнения.
//
// Возвращаемое значение:
//   Булево - Истина, если значение входит в список сравнения.
Функция ЗначениеВСписке(Значение, ЗначениеСравнения)

	Если ТипЗнч(ЗначениеСравнения) = Тип("СписокЗначений") Тогда
		Возврат ЗначениеСравнения.НайтиПоЗначению(Значение) <> Неопределено;
	ИначеЕсли ТипЗнч(ЗначениеСравнения) = Тип("Массив") Тогда
		Возврат ЗначениеСравнения.Найти(Значение) <> Неопределено;
	Иначе
		Возврат Значение = ЗначениеСравнения;
	КонецЕсли;

КонецФункции

#КонецОбласти
