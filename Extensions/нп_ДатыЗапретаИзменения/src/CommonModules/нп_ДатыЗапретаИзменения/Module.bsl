#Область ПрограммныйИнтерфейс

// Регламентное задание нп_СдвигДатЗапретаИзменения.
// Сначала возвращает истёкшие открытые периоды, затем применяет включённые настройки.
//
Процедура СдвигДатЗапретаИзменения() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Ошибки = Новый Массив;
	
	Попытка
		ВосстановитьИстекшиеОткрытыеПериоды(Ошибки);
	Исключение
		Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
			НСтр("ru = 'Восстановление истёкших открытых периодов'"),
			ИнформацияОбОшибке()));
	КонецПопытки;
	
	ПрименитьВключенныеНастройки(Ошибки);
	
	Если Ошибки.Количество() > 0 Тогда
		ОтправитьУведомлениеОбОшибках(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик смены состояния согласования в ДО 3.
//
// Параметры:
//  ПредметСогласования - ЛюбаяСсылка
//  Состояние - ПеречислениеСсылка.СостоянияСогласованияВДокументообороте
//  ДатаУстановки - Дата
//
Процедура ОбработатьИзменениеСостоянияСогласования(ПредметСогласования, Состояние, ДатаУстановки) Экспорт
	
	Если ТипЗнч(ПредметСогласования) <> Тип("ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода") Тогда
		Возврат;
	КонецЕсли;
	
	Если Состояние <> Перечисления.СостоянияСогласованияВДокументообороте.Согласован Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ОткрытьПериодПоЗаявке(ПредметСогласования, ДатаУстановки);
	Исключение
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			СтрШаблон(НСтр("ru = 'Не удалось открыть период по заявке %1'"), ПредметСогласования),
			ПредметСогласования,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Записывает отсечку по согласованной заявке и строки регистра состояния.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода
//  ДатаСогласования - Дата
//
Процедура ОткрытьПериодПоЗаявке(ДокументСсылка, ДатаСогласования) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"ПериодС, СрокДействия, РазделДатыЗапрета, Пользователь");
	
	Комбинации = РазвернутыеКомбинацииЗаявки(ДокументСсылка);
	Если Комбинации.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В заявке нет комбинаций для открытия периода.'");
	КонецЕсли;
	
	ДатаСогласованияДень = НачалоДня(ДатаСогласования);
	Если Не ЗначениеЗаполнено(ДатаСогласованияДень) Тогда
		ДатаСогласованияДень = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ДатаОкончания = ДатаСогласованияДень + (Реквизиты.СрокДействия - 1) * 86400;
	Отсечка = НачалоДня(Реквизиты.ПериодС) - 1;
	Адресат = КаноническийПользователь(Реквизиты.Пользователь);
	
	ВыполнитьЗаписьТиповогоРегистра(Истина);
	Попытка
		Для Каждого Комбинация Из Комбинации Цикл
			ПрименитьОткрытиеПоКомбинации(Комбинация, Адресат, Отсечка, ДатаОкончания, ДокументСсылка);
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ВыполнитьЗаписьТиповогоРегистра(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
	ВыполнитьЗаписьТиповогоРегистра(Ложь);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(
			НСтр("ru = 'Открыт период по заявке %1: отсечка %2, окончание %3'"),
			ДокументСсылка,
			Формат(Отсечка, "ДЛФ=D"),
			Формат(ДатаОкончания, "ДЛФ=D")),
		ДокументСсылка);
	
КонецПроцедуры

// Немедленный возврат границы по заявке (команда «Закрыть период досрочно»).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода
//
Процедура ЗакрытьПериодДосрочно(ДокументСсылка) Экспорт
	
	Если Не ЭтоПолноправныйПользовательСеанса() Тогда
		ВызватьИсключение НСтр("ru = 'Досрочное закрытие периода доступно только полноправному пользователю.'");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Состояние.Пользователь КАК Пользователь,
		|	Состояние.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Состояние.ДатаЗапретаДоОткрытия КАК ДатаЗапретаДоОткрытия
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ЗаявкаНаОткрытиеПериода = &Заявка");
	Запрос.УстановитьПараметр("Заявка", ДокументСсылка);
	ТаблицаСостояний = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаСостояний.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет действующего открытого периода по этой заявке (возможно, период уже закрыт или заявкой-основанием является другая заявка).'");
	КонецЕсли;
	
	ВыполнитьЗаписьТиповогоРегистра(Истина);
	Попытка
		Для Каждого СтрокаСостояния Из ТаблицаСостояний Цикл
			ВосстановитьТиповуюЗапись(
				СтрокаСостояния.РазделДатыЗапрета,
				СтрокаСостояния.ОбъектДатыЗапрета,
				СтрокаСостояния.Пользователь,
				СтрокаСостояния.ДатаЗапретаДоОткрытия);
			УдалитьСостояние(
				СтрокаСостояния.РазделДатыЗапрета,
				СтрокаСостояния.ОбъектДатыЗапрета,
				СтрокаСостояния.Пользователь);
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ВыполнитьЗаписьТиповогоРегистра(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	ВыполнитьЗаписьТиповогоРегистра(Ложь);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(НСтр("ru = 'Период по заявке %1 закрыт досрочно'"), ДокументСсылка),
		ДокументСсылка);
	
КонецПроцедуры

// Абсолютная дата запрета: текущий день минус N календарных дней, включая текущий.
//
// Параметры:
//  ЧислоДней - Число
//  ДатаРасчета - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаЗапретаПоЧислуДней(ЧислоДней, ДатаРасчета) Экспорт
	
	Возврат НачалоДня(ДатаРасчета) - ЧислоДней;
	
КонецФункции

// Возвращает Истина, если заявка согласована в ДО 3.
//
Функция ДокументСогласован(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Состояние = СостояниеСогласованияДО(ДокументСсылка);
	Возврат Состояние.Состояние = Перечисления.СостоянияСогласованияВДокументообороте.Согласован;
	
КонецФункции

// Возвращает Истина, если по заявке есть строки регистра состояния.
//
Функция ЕстьДействующееСостояниеПоЗаявке(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьЗапись
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ЗаявкаНаОткрытиеПериода = &Заявка");
	Запрос.УстановитьПараметр("Заявка", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Текст постоянного пояснения на форме заявки.
//
Функция ТекстПоясненияЗаявки() Экспорт
	
	Возврат НСтр("ru = 'Отсечка открывает все данные после даты «Период с минус 1 день», а не только целевой интервал. Фактический возврат границы выполняется ближайшим ночным запуском задания (ежедневно в 23:00), если срок действия к этому моменту истёк.'");
	
КонецФункции

// Состояние согласования объекта в ДО по типовым регистрам (без веб-вызова).
//
Функция СостояниеСогласованияДО(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьСвязьСДО", Ложь);
	Результат.Вставить("Состояние", Неопределено);
	Результат.Вставить("Представление", НСтр("ru = 'Нет связи с Документооборотом'"));
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО КАК ИдентификаторОбъектаДО,
		|	СостоянияСогласованияВДокументообороте.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированныеС1СДокументооборотом
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСогласованияВДокументообороте КАК СостоянияСогласованияВДокументообороте
		|		ПО ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО = СостоянияСогласованияВДокументообороте.ИдентификаторОбъектаДО
		|ГДЕ
		|	ОбъектыИнтегрированныеС1СДокументооборотом.Объект = &СсылкаНаОбъект");
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЕстьСвязьСДО = Истина;
	Результат.Состояние = Выборка.Состояние;
	
	Если Не ЗначениеЗаполнено(Выборка.Состояние) Тогда
		Результат.Представление = НСтр("ru = 'Связан с ДО, состояние не задано'");
	Иначе
		Результат.Представление = Строка(Выборка.Состояние);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет запись регистра настроек: запрет пустой пары объект+раздел и несовместимых типов.
//
Процедура ПроверитьЗаписьНастройки(ОбъектДатыЗапрета, РазделДатыЗапрета) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ВызватьИсключение НСтр("ru = 'Нельзя записывать настройку с незаполненными объектом и разделом одновременно. Такая запись дала бы общую дату адресата и перекрыла бы детальные даты того же адресата.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ИменаРазделов = ИменаРазделовДляТипаОбъекта(ТипЗнч(ОбъектДатыЗапрета));
		ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
		Если ИменаРазделов.Найти(ИмяРаздела) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Раздел «%1» недопустим для типа объекта «%2».'"),
				Строка(РазделДатыЗапрета),
				Строка(ТипЗнч(ОбъектДатыЗапрета)));
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Если Не ЗначениеЗаполнено(ИмяРазделаПоСсылке(РазделДатыЗапрета)) Тогда
			ВызватьИсключение НСтр("ru = 'Указанный раздел не входит в закрытый перечень доработки.'");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет реквизиты заявки перед записью.
//
Процедура ПроверитьЗаявкуПередЗаписью(ДокументОбъект) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь (или группа пользователей) обязателен. Заявка открывает период только для указанного адресата, не «для всех».'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ПериодС) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен реквизит «Период с».'");
	КонецЕсли;
	
	Если ДокументОбъект.СрокДействия < 1 Тогда
		ВызватьИсключение НСтр("ru = 'Срок действия должен быть не меньше 1 дня.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ПричинаОткрытия) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена причина открытия периода.'");
	КонецЕсли;
	
	Если ДокументОбъект.Объекты.Количество() = 0 И Не ЗначениеЗаполнено(ДокументОбъект.РазделДатыЗапрета) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите объекты в табличной части или раздел даты запрета.'");
	КонецЕсли;
	
	Для Каждого СтрокаОбъекта Из ДокументОбъект.Объекты Цикл
		ПроверитьЗаписьНастройки(СтрокаОбъекта.ОбъектДатыЗапрета, ДокументОбъект.РазделДатыЗапрета);
	КонецЦикла;
	
	Если ДокументОбъект.Объекты.Количество() = 0 Тогда
		ПроверитьЗаписьНастройки(Неопределено, ДокументОбъект.РазделДатыЗапрета);
	КонецЕсли;
	
КонецПроцедуры

// Истина, если текущий пользователь полноправный.
//
Функция ЭтоПолноправныйПользовательСеанса() Экспорт
	
	Возврат Пользователи.ЭтоПолноправныйПользователь();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВосстановитьИстекшиеОткрытыеПериоды(Ошибки)
	
	ДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Состояние.Пользователь КАК Пользователь,
		|	Состояние.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Состояние.ДатаЗапретаДоОткрытия КАК ДатаЗапретаДоОткрытия,
		|	Состояние.ЗаявкаНаОткрытиеПериода КАК ЗаявкаНаОткрытиеПериода,
		|	Состояние.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ДатаОкончанияДействия < &ДатаСеанса");
	Запрос.УстановитьПараметр("ДатаСеанса", ДатаСеанса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыполнитьЗаписьТиповогоРегистра(Истина);
	Попытка
		Пока Выборка.Следующий() Цикл
			Попытка
				ВосстановитьТиповуюЗапись(
					Выборка.РазделДатыЗапрета,
					Выборка.ОбъектДатыЗапрета,
					Выборка.Пользователь,
					Выборка.ДатаЗапретаДоОткрытия);
				УдалитьСостояние(
					Выборка.РазделДатыЗапрета,
					Выборка.ОбъектДатыЗапрета,
					Выборка.Пользователь);
				ЗаписатьВЖурнал(
					УровеньЖурналаРегистрации.Информация,
					СтрШаблон(
						НСтр("ru = 'Возвращена граница: раздел %1, объект %2, пользователь %3, заявка %4'"),
						Выборка.РазделДатыЗапрета,
						Выборка.ОбъектДатыЗапрета,
						Выборка.Пользователь,
						Выборка.ЗаявкаНаОткрытиеПериода),
					Выборка.ЗаявкаНаОткрытиеПериода);
			Исключение
				Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
					СтрШаблон(
						НСтр("ru = 'Возврат границы: объект %1, раздел %2, пользователь %3'"),
						Выборка.ОбъектДатыЗапрета,
						Выборка.РазделДатыЗапрета,
						Выборка.Пользователь),
					ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ВыполнитьЗаписьТиповогоРегистра(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	ВыполнитьЗаписьТиповогоРегистра(Ложь);
	
КонецПроцедуры

Процедура ПрименитьВключенныеНастройки(Ошибки)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Настройки.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Настройки.Пользователь КАК Пользователь,
		|	Настройки.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Настройки.ЧислоДней КАК ЧислоДней
		|ИЗ
		|	РегистрСведений.нп_НастройкиАвтоматическойУстановкиДатЗапрета КАК Настройки
		|ГДЕ
		|	Настройки.Включено");
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДатаСеанса = ТекущаяДатаСеанса();
	
	ВыполнитьЗаписьТиповогоРегистра(Истина);
	Попытка
		Пока Выборка.Следующий() Цикл
			Попытка
				ПрименитьОднуНастройку(Выборка, ДатаСеанса);
			Исключение
				Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
					СтрШаблон(
						НСтр("ru = 'Настройка: объект %1, раздел %2, пользователь %3, N=%4'"),
						Выборка.ОбъектДатыЗапрета,
						Выборка.РазделДатыЗапрета,
						Выборка.Пользователь,
						Выборка.ЧислоДней),
					ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ВыполнитьЗаписьТиповогоРегистра(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	ВыполнитьЗаписьТиповогоРегистра(Ложь);
	
КонецПроцедуры

Процедура ПрименитьОднуНастройку(Настройка, ДатаСеанса)
	
	Комбинации = РазвернутыеКомбинацииНастройки(
		Настройка.ОбъектДатыЗапрета,
		Настройка.РазделДатыЗапрета);
	Адресат = КаноническийПользователь(Настройка.Пользователь);
	ДатаЗапрета = ДатаЗапретаПоЧислуДней(Настройка.ЧислоДней, ДатаСеанса);
	Комментарий = КомментарийАвтозаписи(Адресат, Настройка.ЧислоДней);
	
	Для Каждого Комбинация Из Комбинации Цикл
		Если ЕстьДействующееСостояниеКомбинации(Комбинация.Раздел, Комбинация.Объект, Адресат) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьТиповуюДатуЗапрета(Комбинация.Раздел, Комбинация.Объект, Адресат, ДатаЗапрета, Комментарий);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрименитьОткрытиеПоКомбинации(Комбинация, Адресат, Отсечка, ДатаОкончания, ДокументСсылка)
	
	ТекущееСостояние = ПрочитатьСостояние(Комбинация.Раздел, Комбинация.Объект, Адресат);
	ТекущаяТиповая = ПрочитатьТиповуюЗапись(Комбинация.Раздел, Комбинация.Объект, Адресат);
	
	Если ТекущееСостояние = Неопределено Тогда
		ДатаДоОткрытия = ТекущаяТиповая.ДатаЗапрета;
		БылаАвто = СтрНачинаетсяС(Строка(ТекущаяТиповая.Комментарий), ПрефиксАвтоКомментария());
		ЗаписатьТиповуюДатуЗапрета(
			Комбинация.Раздел,
			Комбинация.Объект,
			Адресат,
			Отсечка,
			КомментарийОткрытия(ДокументСсылка));
		ЗаписатьСостояние(
			Комбинация.Раздел,
			Комбинация.Объект,
			Адресат,
			ДокументСсылка,
			ДатаОкончания,
			ДатаДоОткрытия,
			БылаАвто);
		Возврат;
	КонецЕсли;
	
	НоваяОтсечка = Отсечка;
	Если ЗначениеЗаполнено(ТекущаяТиповая.ДатаЗапрета) Тогда
		НоваяОтсечка = Мин(ТекущаяТиповая.ДатаЗапрета, Отсечка);
	КонецЕсли;
	НовоеОкончание = Макс(ТекущееСостояние.ДатаОкончанияДействия, ДатаОкончания);
	
	ЗаписатьТиповуюДатуЗапрета(
		Комбинация.Раздел,
		Комбинация.Объект,
		Адресат,
		НоваяОтсечка,
		КомментарийОткрытия(ТекущееСостояние.ЗаявкаНаОткрытиеПериода));
	
	ЗаписатьСостояние(
		Комбинация.Раздел,
		Комбинация.Объект,
		Адресат,
		ТекущееСостояние.ЗаявкаНаОткрытиеПериода,
		НовоеОкончание,
		ТекущееСостояние.ДатаЗапретаДоОткрытия,
		ТекущееСостояние.ЗаписьБылаУстановленаАвтоматически);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(
			НСтр("ru = 'Пересечение заявок: основание %1, новая %2, отсечка %3, окончание %4'"),
			ТекущееСостояние.ЗаявкаНаОткрытиеПериода,
			ДокументСсылка,
			Формат(НоваяОтсечка, "ДЛФ=D"),
			Формат(НовоеОкончание, "ДЛФ=D")),
		ДокументСсылка);
	
КонецПроцедуры

Функция РазвернутыеКомбинацииНастройки(ОбъектДатыЗапрета, РазделДатыЗапрета)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ДобавитьКомбинацию(Результат, РазделДатыЗапрета, ОбъектДатыЗапрета);
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ДобавитьКомбинацию(Результат, РазделДатыЗапрета, РазделДатыЗапрета);
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Для Каждого ИмяРаздела Из ИменаРазделовДляТипаОбъекта(ТипЗнч(ОбъектДатыЗапрета)) Цикл
			СсылкаРаздела = СсылкаРазделаПоИмени(ИмяРаздела);
			Если ЗначениеЗаполнено(СсылкаРаздела) Тогда
				ДобавитьКомбинацию(Результат, СсылкаРаздела, ОбъектДатыЗапрета);
			КонецЕсли;
		КонецЦикла;
		Если Результат.Количество() = 0 Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Не найдены разделы закрытого перечня для типа объекта «%1».'"),
				Строка(ТипЗнч(ОбъектДатыЗапрета)));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	ВызватьИсключение НСтр("ru = 'Пустые объект и раздел одновременно недопустимы.'");
	
КонецФункции

Функция РазвернутыеКомбинацииЗаявки(ДокументСсылка)
	
	Результат = Новый Массив;
	РазделЗаявки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "РазделДатыЗапрета");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Объекты.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета
		|ИЗ
		|	Документ.нп_ЗаявкаНаОткрытиеПериода.Объекты КАК Объекты
		|ГДЕ
		|	Объекты.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	ОбъектыЗаявки = Запрос.Выполнить().Выгрузить();
	
	Если ОбъектыЗаявки.Количество() = 0 Тогда
		Возврат РазвернутыеКомбинацииНастройки(Неопределено, РазделЗаявки);
	КонецЕсли;
	
	Для Каждого СтрокаОбъекта Из ОбъектыЗаявки Цикл
		КомбинацииСтроки = РазвернутыеКомбинацииНастройки(СтрокаОбъекта.ОбъектДатыЗапрета, РазделЗаявки);
		Для Каждого Комбинация Из КомбинацииСтроки Цикл
			Результат.Добавить(Комбинация);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКомбинацию(МассивКомбинаций, Раздел, Объект)
	
	Комбинация = Новый Структура("Раздел, Объект", Раздел, Объект);
	МассивКомбинаций.Добавить(Комбинация);
	
КонецПроцедуры

Функция КаноническийПользователь(ПользовательНастройки)
	
	Если Не ЗначениеЗаполнено(ПользовательНастройки) Тогда
		Возврат Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
	КонецЕсли;
	
	Если ТипЗнч(ПользовательНастройки) = Тип("ПеречислениеСсылка.ВидыНазначенияДатЗапрета") Тогда
		Возврат ПользовательНастройки;
	КонецЕсли;
	
	Возврат ПользовательНастройки;
	
КонецФункции

Функция КомментарийАвтозаписи(Адресат, ЧислоДней)
	
	Если ТипЗнч(Адресат) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
		Возврат ПрефиксАвтоКомментария() + "|" + Формат(ЧислоДней, "ЧЦ=5; ЧВН=; ЧГ=0");
	КонецЕсли;
	
	Возврат ПрефиксАвтоКомментария();
	
КонецФункции

Функция КомментарийОткрытия(ДокументСсылка)
	
	Возврат "нп_открытие|" + Строка(ДокументСсылка.УникальныйИдентификатор());
	
