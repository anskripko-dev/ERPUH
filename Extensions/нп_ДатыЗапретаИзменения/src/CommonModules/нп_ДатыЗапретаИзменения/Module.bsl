	Если Не ЗначениеЗаполнено(СсылкаРаздела) Тогда
		Возврат "";
	КонецЕсли;
	
	ИдентификаторСтрокой = Строка(СсылкаРаздела.УникальныйИдентификатор());
	Для Каждого ИмяРаздела Из ВсеИменаРазделов() Цикл
		Если ИдентификаторРазделаПоИмени(ИмяРаздела) = ИдентификаторСтрокой Тогда
			Возврат ИмяРаздела;
