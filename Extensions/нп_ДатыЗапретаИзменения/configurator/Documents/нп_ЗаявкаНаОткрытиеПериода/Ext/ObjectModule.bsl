#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		нп_ДатыЗапретаИзменения.ПроверитьЗаявкуПередЗаписью(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	Если ПометкаУдаления И нп_ДатыЗапретаИзменения.ЕстьДействующееСостояниеПоЗаявке(Ссылка) Тогда
		ВызватьИсключение НСтр("ru = 'Пометка на удаление запрещена, пока открытый период действует. Сначала выполните «Закрыть период досрочно».'");
	КонецЕсли;
	
	Если нп_ДатыЗапретаИзменения.ДокументСогласован(Ссылка)
		Или нп_ДатыЗапретаИзменения.ЕстьДействующееСостояниеПоЗаявке(Ссылка) Тогда
		ВызватьИсключение НСтр("ru = 'Согласованную заявку изменять нельзя. Чтобы изменить параметры, закройте период досрочно и создайте новую заявку.'");
	КонецЕсли;
	
	нп_ДатыЗапретаИзменения.ПроверитьЗаявкуПередЗаписью(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если нп_ДатыЗапретаИзменения.ЕстьДействующееСостояниеПоЗаявке(Ссылка) Тогда
		ВызватьИсключение НСтр("ru = 'Удаление запрещено, пока открытый период действует. Сначала выполните «Закрыть период досрочно».'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
