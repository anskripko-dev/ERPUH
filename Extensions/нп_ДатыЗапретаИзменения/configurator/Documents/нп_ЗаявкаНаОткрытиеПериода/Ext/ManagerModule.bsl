// СтандартныеПодсистемы.Печать

// Определяет настройки печати документа.
//
// Параметры:
//  Настройки - Структура
//
Процедура ПриОпределенииНастроекПечати(Настройки) Экспорт
	
	Настройки.ПриДобавленииКомандПечати = Истина;
	
КонецПроцедуры

// Заполняет список команд печати.
//
// Параметры:
//  КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.нп_ЗаявкаНаОткрытиеПериода";
	КомандаПечати.Идентификатор = "ЗаявкаНаОткрытиеПериода";
	КомандаПечати.Представление = НСтр("ru = 'Заявка на открытие периода'");
	КомандаПечати.Картинка = БиблиотекаКартинок.Печать;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода
//  ПараметрыПечати - Структура
//  КоллекцияПечатныхФорм - ТаблицаЗначений
//  ОбъектыПечати - СписокЗначений
//  ПараметрыВывода - Структура
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если Не УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаявкаНаОткрытиеПериода") Тогда
		Возврат;
	КонецЕсли;
	
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ЗаявкаНаОткрытиеПериода",
		НСтр("ru = 'Заявка на открытие периода'"),
		СформироватьПечатнуюФормуЗаявки(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.нп_ЗаявкаНаОткрытиеПериода.ПФ_MXL_ЗаявкаНаОткрытиеПериода");
	
	// PDF для ДО 3 не должен срывать превью: БСП при исключении подменяет
	// табличный документ пустым, и форма печати показывает «Печатная форма недоступна».
	Для Каждого ДокументСсылка Из МассивОбъектов Цикл
		Попытка
			ПрисоединитьПечатнуюФормуКДокументу(ДокументСсылка);
		Исключение
			ЗаписатьОшибкуПечати(ИнформацияОбОшибке(), ДокументСсылка);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиФайлПечатнойФормы(ДокументСсылка, ИмяБезРасширения)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВладелецФайла", ДокументСсылка);
	Запрос.УстановитьПараметр("Наименование", ИмяБезРасширения);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Файлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.нп_ЗаявкаНаОткрытиеПериодаПрисоединенныеФайлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла = &ВладелецФайла
	|	И Файлы.Наименование = &Наименование
	|	И НЕ Файлы.ПометкаУдаления
	|	И НЕ Файлы.ЭтоГруппа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СформироватьПечатнуюФормуЗаявки(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = НовыйТабличныйДокументПечати();
	
	Попытка
		ВывестиЗаявкиПоМакету(ТабличныйДокумент, МассивОбъектов, ОбъектыПечати);
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			Возврат ТабличныйДокумент;
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуПечати(ИнформацияОбОшибке());
	КонецПопытки;
	
	ОбъектыПечати.Очистить();
	ТабличныйДокумент = НовыйТабличныйДокументПечати();
	ВывестиЗаявкиБезМакета(ТабличныйДокумент, МассивОбъектов, ОбъектыПечати);
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция НовыйТабличныйДокументПечати()
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_нп_ЗаявкаНаОткрытиеПериода";
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция МакетПечатнойФормыЗаявки()
	
	Попытка
		Возврат УправлениеПечатью.МакетПечатнойФормы(
			"Документ.нп_ЗаявкаНаОткрытиеПериода.ПФ_MXL_ЗаявкаНаОткрытиеПериода");
	Исключение
		Возврат ПолучитьМакет("ПФ_MXL_ЗаявкаНаОткрытиеПериода");
	КонецПопытки;
	
КонецФункции

Процедура ВывестиЗаявкиПоМакету(ТабличныйДокумент, МассивОбъектов, ОбъектыПечати)
	
	Макет = МакетПечатнойФормыЗаявки();
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьСтрокаПустая = Макет.ПолучитьОбласть("СтрокаПустая");
	
	ВыборкаДокументов = ВыборкаДокументовПечати(МассивОбъектов);
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачала = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьЗаголовок.Параметры.Номер = НомерДокументаНаПечать(ВыборкаДокументов.Номер);
		ОбластьЗаголовок.Параметры.Дата = Формат(ВыборкаДокументов.Дата, "ДЛФ=D");
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьШапка.Параметры.Пользователь = ВыборкаДокументов.Пользователь;
		ОбластьШапка.Параметры.ПериодС = Формат(ВыборкаДокументов.ПериодС, "ДЛФ=D");
		ОбластьШапка.Параметры.СрокДействия = ВыборкаДокументов.СрокДействия;
		ОбластьШапка.Параметры.СпособУказания = ПредставлениеСпособаУказанияДляПечати(
			ВыборкаДокументов.СпособУказания);
		ОбластьШапка.Параметры.ПричинаОткрытия = ВыборкаДокументов.ПричинаОткрытия;
		ОбластьШапка.Параметры.Ответственный = ВыборкаДокументов.Ответственный;
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		ВыборкаСтрок = ВыборкаДокументов.Выбрать();
		НомерВыведенной = 0;
		Пока ВыборкаСтрок.Следующий() Цикл
			Если ВыборкаСтрок.НомерСтроки = Null Тогда
				Продолжить;
			КонецЕсли;
			НомерВыведенной = НомерВыведенной + 1;
			ЗаполнитьСтрокуПечати(
				ОбластьСтрока,
				НомерВыведенной,
				ВыборкаСтрок.РазделДатыЗапрета,
				ВыборкаСтрок.ОбъектДатыЗапрета,
				ВыборкаДокументов.РазделШапки);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		Если НомерВыведенной = 0 Тогда
			ЗаполнитьСтрокуПечати(
				ОбластьСтрока,
				1,
				ВыборкаДокументов.РазделШапки,
				Неопределено,
				ВыборкаДокументов.РазделШапки);
			Если ЗначениеЗаполнено(ВыборкаДокументов.РазделШапки) Тогда
				ТабличныйДокумент.Вывести(ОбластьСтрока);
			Иначе
				ТабличныйДокумент.Вывести(ОбластьСтрокаПустая);
			КонецЕсли;
		КонецЕсли;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабличныйДокумент, НомерСтрокиНачала, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиЗаявкиБезМакета(ТабличныйДокумент, МассивОбъектов, ОбъектыПечати)
	
	ВыборкаДокументов = ВыборкаДокументовПечати(МассивОбъектов);
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачала = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ВывестиСтрокуПечатиБезМакета(
			ТабличныйДокумент,
			СтрШаблон(
				НСтр("ru = 'Заявка на открытие периода № %1 от %2'"),
				НомерДокументаНаПечать(ВыборкаДокументов.Номер),
				Формат(ВыборкаДокументов.Дата, "ДЛФ=D")),
			Истина,
			3);
		ВывестиПодписьИЗначениеПечати(
			ТабличныйДокумент,
			НСтр("ru = 'Пользователь (кому)'"),
			Строка(ВыборкаДокументов.Пользователь));
		ВывестиПодписьИЗначениеПечати(
			ТабличныйДокумент,
			НСтр("ru = 'Открыть период с'"),
			Формат(ВыборкаДокументов.ПериодС, "ДЛФ=D"));
		ВывестиПодписьИЗначениеПечати(
			ТабличныйДокумент,
			НСтр("ru = 'Срок действия, дней'"),
			Строка(ВыборкаДокументов.СрокДействия));
		ВывестиПодписьИЗначениеПечати(
			ТабличныйДокумент,
			НСтр("ru = 'Открывается'"),
			ПредставлениеСпособаУказанияДляПечати(ВыборкаДокументов.СпособУказания));
		ВывестиПодписьИЗначениеПечати(
			ТабличныйДокумент,
			НСтр("ru = 'Причина открытия'"),
			Строка(ВыборкаДокументов.ПричинаОткрытия));
		ВывестиПодписьИЗначениеПечати(
			ТабличныйДокумент,
			НСтр("ru = 'Ответственный'"),
			Строка(ВыборкаДокументов.Ответственный));
		
		ВывестиСтрокуПечатиБезМакета(ТабличныйДокумент, "", Ложь, 3);
		ВывестиСтрокуПечатиБезМакета(
			ТабличныйДокумент,
			НСтр("ru = '№'"),
			Истина,
			1);
		Область = ТабличныйДокумент.Область(ТабличныйДокумент.ВысотаТаблицы, 2);
		Область.Текст = НСтр("ru = 'Раздел'");
		Область.Шрифт = Новый Шрифт(, 9, Истина);
		Область = ТабличныйДокумент.Область(ТабличныйДокумент.ВысотаТаблицы, 3);
		Область.Текст = НСтр("ru = 'Объект'");
		Область.Шрифт = Новый Шрифт(, 9, Истина);
		
		ВыборкаСтрок = ВыборкаДокументов.Выбрать();
		НомерВыведенной = 0;
		Пока ВыборкаСтрок.Следующий() Цикл
			Если ВыборкаСтрок.НомерСтроки = Null Тогда
				Продолжить;
			КонецЕсли;
			НомерВыведенной = НомерВыведенной + 1;
			ВывестиСтрокуТаблицыБезМакета(
				ТабличныйДокумент,
				НомерВыведенной,
				ВыборкаСтрок.РазделДатыЗапрета,
				ВыборкаСтрок.ОбъектДатыЗапрета,
				ВыборкаДокументов.РазделШапки);
		КонецЦикла;
		
		Если НомерВыведенной = 0 Тогда
			ВывестиСтрокуТаблицыБезМакета(
				ТабличныйДокумент,
				1,
				ВыборкаДокументов.РазделШапки,
				Неопределено,
				ВыборкаДокументов.РазделШапки);
		КонецЕсли;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабличныйДокумент, НомерСтрокиНачала, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Если ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
		ВывестиСтрокуПечатиБезМакета(
			ТабличныйДокумент,
			НСтр("ru = 'Заявка на открытие периода'"),
			Истина,
			3);
	КонецЕсли;
	
КонецПроцедуры

Функция ВыборкаДокументовПечати(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявка.Ссылка КАК Ссылка,
	|	Заявка.Номер КАК Номер,
	|	Заявка.Дата КАК Дата,
	|	Заявка.Пользователь КАК Пользователь,
	|	Заявка.ПериодС КАК ПериодС,
	|	Заявка.СрокДействия КАК СрокДействия,
	|	Заявка.СпособУказания КАК СпособУказания,
	|	Заявка.ПричинаОткрытия КАК ПричинаОткрытия,
	|	Заявка.Ответственный КАК Ответственный,
	|	Заявка.РазделДатыЗапрета КАК РазделШапки,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.РазделДатыЗапрета КАК РазделДатыЗапрета,
	|	Строки.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета
	|ИЗ
	|	Документ.нп_ЗаявкаНаОткрытиеПериода КАК Заявка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.нп_ЗаявкаНаОткрытиеПериода.Объекты КАК Строки
	|		ПО Строки.Ссылка = Заявка.Ссылка
	|ГДЕ
	|	Заявка.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заявка.Дата,
	|	Заявка.Номер,
	|	НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(Номер),
	|	МАКСИМУМ(Дата),
	|	МАКСИМУМ(Пользователь),
	|	МАКСИМУМ(ПериодС),
	|	МАКСИМУМ(СрокДействия),
	|	МАКСИМУМ(СпособУказания),
	|	МАКСИМУМ(ПричинаОткрытия),
	|	МАКСИМУМ(Ответственный),
	|	МАКСИМУМ(РазделШапки)
	|ПО
	|	Ссылка";
	
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция НомерДокументаНаПечать(Номер)
	
	Попытка
		Возврат ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер);
	Исключение
		Возврат СокрЛП(Номер);
	КонецПопытки;
	
КонецФункции

Функция ПредставлениеСпособаУказанияДляПечати(СпособУказания)
	
	Если СпособУказания = Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделам Тогда
		Возврат НСтр("ru = 'по разделам учёта'");
	КонецЕсли;
	
	Возврат НСтр("ru = 'по разделам учёта и выбранным объектам'");
	
КонецФункции

Процедура ВывестиПодписьИЗначениеПечати(ТабличныйДокумент, Подпись, Значение)
	
	НомерСтроки = ТабличныйДокумент.ВысотаТаблицы + 1;
	ОбластьПодпись = ТабличныйДокумент.Область(НомерСтроки, 1);
	ОбластьПодпись.Текст = Подпись;
	ОбластьЗначение = ТабличныйДокумент.Область(НомерСтроки, 2, НомерСтроки, 3);
	ОбластьЗначение.Объединить();
	ОбластьЗначение.Текст = Значение;
	
КонецПроцедуры

Процедура ВывестиСтрокуПечатиБезМакета(ТабличныйДокумент, Текст, Жирный, ШиринаКолонок)
	
	НомерСтроки = ТабличныйДокумент.ВысотаТаблицы + 1;
	Область = ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, ШиринаКолонок);
	Если ШиринаКолонок > 1 Тогда
		Область.Объединить();
	КонецЕсли;
	Область.Текст = Текст;
	Если Жирный Тогда
		Область.Шрифт = Новый Шрифт(, 12, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСтрокуТаблицыБезМакета(ТабличныйДокумент, НомерСтроки, Раздел, ОбъектДатыЗапрета, РазделШапки)
	
	ПараметрыСтроки = Новый Структура("НомерСтроки, Раздел, Объект");
	ЗаполнитьСтрокуПечати(ПараметрыСтроки, НомерСтроки, Раздел, ОбъектДатыЗапрета, РазделШапки);
	
	НомерВывода = ТабличныйДокумент.ВысотаТаблицы + 1;
	ТабличныйДокумент.Область(НомерВывода, 1).Текст = Строка(ПараметрыСтроки.НомерСтроки);
	ТабличныйДокумент.Область(НомерВывода, 2).Текст = Строка(ПараметрыСтроки.Раздел);
	ТабличныйДокумент.Область(НомерВывода, 3).Текст = Строка(ПараметрыСтроки.Объект);
	
КонецПроцедуры

Процедура ЗаписатьОшибкуПечати(Информация, ДокументСсылка = Неопределено)
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'нп_ЗаявкаНаОткрытиеПериода.Печать'"),
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Документы.нп_ЗаявкаНаОткрытиеПериода,
		ДокументСсылка,
		ПодробноеПредставлениеОшибки(Информация));
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуПечати(Приемник, НомерСтроки, Раздел, ОбъектДатыЗапрета, РазделШапки)
	
	РазделПечати = Раздел;
	Если Не ЗначениеЗаполнено(РазделПечати) Тогда
		РазделПечати = РазделШапки;
	КонецЕсли;
	
	ПараметрыСтроки = Приемник;
	Если ТипЗнч(Приемник) <> Тип("Структура") Тогда
		ПараметрыСтроки = Приемник.Параметры;
	КонецЕсли;
	
	ПараметрыСтроки.НомерСтроки = НомерСтроки;
	Если Не ЗначениеЗаполнено(РазделПечати) И Не ЗначениеЗаполнено(ОбъектДатыЗапрета) Тогда
		ПараметрыСтроки.Раздел = НСтр("ru = 'Все разделы/объекты'");
		ПараметрыСтроки.Объект = "";
		Возврат;
	КонецЕсли;
	
	ПараметрыСтроки.Раздел = РазделПечати;
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) Тогда
		ПараметрыСтроки.Объект = ОбъектДатыЗапрета;
	Иначе
		ПараметрыСтроки.Объект = НСтр("ru = 'общая дата раздела'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
