#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ПояснениеОтсечки.Заголовок = нп_ДатыЗапретаИзменения.ТекстПоясненияЗаявки();
	ЗаполнитьСпособУказанияПоДаннымДокумента();
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособУказанияПриИзменении(Элемент)
	
	НастроитьОтображениеСпособаУказания();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ИнтеграцияС1СДокументооборот3Клиент.НачатьОбработку(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПериодДосрочно(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Документ ещё не записан.'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытьПериодДосрочноЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		НСтр("ru = 'Вернуть прежнюю дату запрета и удалить состояние открытого периода?'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПериодДосрочноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьПериодДосрочноНаСервере();
	Прочитать();
	ПоказатьПредупреждение(, НСтр("ru = 'Период закрыт досрочно.'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСпособУказанияПоДаннымДокумента()
	
	Если Не ЗначениеЗаполнено(Объект.СпособУказания) Тогда
		ЕстьОбъект = Ложь;
		Для Каждого СтрокаОбъекта Из Объект.Объекты Цикл
			Если ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) Тогда
				ЕстьОбъект = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьОбъект Тогда
			Объект.СпособУказания = Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделамИОбъектам;
		Иначе
			Объект.СпособУказания = Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделам;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.РазделДатыЗапрета) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаОбъекта Из Объект.Объекты Цикл
		Если Не ЗначениеЗаполнено(СтрокаОбъекта.РазделДатыЗапрета) Тогда
			СтрокаОбъекта.РазделДатыЗапрета = Объект.РазделДатыЗапрета;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуПоСостоянию()
	
	Согласован = нп_ДатыЗапретаИзменения.ДокументСогласован(Объект.Ссылка);
	ЕстьСостояние = нп_ДатыЗапретаИзменения.ЕстьДействующееСостояниеПоЗаявке(Объект.Ссылка);
	Полноправный = нп_ДатыЗапретаИзменения.ЭтоПолноправныйПользовательСеанса();
	
	ТолькоПросмотрДокумента = Согласован Или ЕстьСостояние;
	
	Элементы.ПериодС.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.СрокДействия.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.Пользователь.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.ПричинаОткрытия.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.СпособУказания.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.Объекты.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.Ответственный.ТолькоПросмотр = Истина;
	
	Элементы.ОтправитьНаСогласование.Доступность = Не ТолькоПросмотрДокумента;
	Элементы.ЗакрытьПериодДосрочно.Видимость = Полноправный;
	Элементы.ЗакрытьПериодДосрочно.Доступность = Полноправный И ЕстьСостояние;
	
	СостояниеДО = нп_ДатыЗапретаИзменения.СостояниеСогласованияДО(Объект.Ссылка);
	Элементы.СостояниеСогласования.Заголовок = СостояниеДО.Представление;
	
	НастроитьОтображениеСпособаУказанияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтображениеСпособаУказания()
	
	ПоРазделам = (Объект.СпособУказания
		= ПредопределенноеЗначение("Перечисление.нп_СпособыУказанияОткрытияПериода.ПоРазделам"));
	Элементы.ОбъектыОбъектДатыЗапрета.Видимость = Не ПоРазделам;
	Элементы.Объекты.Заголовок = ?(ПоРазделам,
		НСтр("ru = 'Разделы'"),
		НСтр("ru = 'Разделы и объекты'"));
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтображениеСпособаУказанияНаСервере()
	
	ПоРазделам = (Объект.СпособУказания
		= Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделам);
	Элементы.ОбъектыОбъектДатыЗапрета.Видимость = Не ПоРазделам;
	Элементы.Объекты.Заголовок = ?(ПоРазделам,
		НСтр("ru = 'Разделы'"),
		НСтр("ru = 'Разделы и объекты'"));
	
КонецПроцедуры

&НаСервере
Процедура ЗакрытьПериодДосрочноНаСервере()
	
	Документы.нп_ЗаявкаНаОткрытиеПериода.ЗакрытьПериодДосрочно(Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти
