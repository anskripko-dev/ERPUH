#Область ОписаниеПеременных

&НаКлиенте
Перем ОсталосьПопытокБлокировки;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	Элементы.ПояснениеОтсечки.Заголовок = нп_ДатыЗапретаИзменения.ТекстПоясненияЗаявки();
	ЗаполнитьСписокРазделовЗаявки();
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	ОсталосьПопытокБлокировки = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	Если ЭтоОповещениеСвязиДокументооборота(ИмяСобытия, Параметр) Тогда
		НастроитьФормуПоСостоянию();
		ПодключитьОбработчикОжидания("ОтложенноНастроитьФормуПоСостоянию", 1, Истина);
	КонецЕсли;
	
	Если ЭтоОповещениеНачалаОбработкиЗаявки(ИмяСобытия, Параметр) Тогда
		ОсталосьПопытокБлокировки = 20;
		ПодключитьОбработчикОжидания("ОжидатьБлокировкуПоДокументообороту", 0.5, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если нп_ДатыЗапретаИзменения.ИзменениеЗаявкиЗапрещено(Объект.Ссылка) Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(, нп_ДатыЗапретаИзменения.ТекстЗапретаИзмененияЗаявки(Объект.Ссылка));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если нп_ДатыЗапретаИзменения.ИзменениеЗаявкиЗапрещено(ТекущийОбъект.Ссылка) Тогда
		Отказ = Истина;
		ВызватьИсключение нп_ДатыЗапретаИзменения.ТекстЗапретаИзмененияЗаявки(ТекущийОбъект.Ссылка);
	КонецЕсли;
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектыПриАктивизацииСтроки(Элемент)
	
	ОбновитьОписаниеТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыРазделДатыЗапретаПриИзменении(Элемент)
	
	ОбъектыРазделДатыЗапретаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыОбъектДатыЗапретаПриИзменении(Элемент)
	
	ОбновитьОписаниеТекущейСтроки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьПериодДосрочно(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Документ ещё не записан.'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытьПериодДосрочноЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		НСтр("ru = 'Вернуть прежнюю дату запрета и удалить состояние открытого периода?'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПериодДосрочноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьПериодДосрочноНаСервере();
	Прочитать();
	ПоказатьПредупреждение(, НСтр("ru = 'Период закрыт досрочно.'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

