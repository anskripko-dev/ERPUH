// Конец СтандартныеПодсистемы.РаботаСФайлами

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(
		Команда, ЭтотОбъект, Объект);
	ПодключитьОбработчикОжидания("ОтложенноНастроитьФормуПоСостоянию", 1, Истина);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

&НаСервере
Процедура НастроитьФормуПоСостоянию()
	
	ЕстьСостояние = нп_ДатыЗапретаИзменения.ЕстьДействующееСостояниеПоЗаявке(Объект.Ссылка);
	Полноправный = нп_ДатыЗапретаИзменения.ЭтоПолноправныйПользовательСеанса();
	ДоступнаДетализация = нп_ДатыЗапретаИзменения.ДоступнаДетализацияЗаявки();
	
	ИзменениеЗаявкиЗапрещено = нп_ДатыЗапретаИзменения.ИзменениеЗаявкиЗапрещено(Объект.Ссылка);
	Если ИзменениеЗаявкиЗапрещено Тогда
		Модифицированность = Ложь;
	КонецЕсли;
	
	Элементы.Номер.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.Дата.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.ПериодС.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.СрокДействия.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.Пользователь.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.Организация.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.ПричинаОткрытия.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.Объекты.ТолькоПросмотр = ИзменениеЗаявкиЗапрещено;
	Элементы.Ответственный.ТолькоПросмотр = Истина;
	Элементы.ГруппаДетализация.Видимость = ДоступнаДетализация;
	
	Элементы.ЗакрытьПериодДосрочно.Видимость = Полноправный;
	Элементы.ЗакрытьПериодДосрочно.Доступность = Полноправный И ЕстьСостояние;
	
	СостояниеДО = нп_ДатыЗапретаИзменения.СостояниеСогласованияДО(Объект.Ссылка);
	СостояниеСогласованияДО = СостояниеДО.Представление;
	
	НастроитьПолеОбъектаТекущейСтроки();
	ОбновитьОписаниеТекущейСтрокиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоОповещениеСвязиДокументооборота(ИмяСобытия, Параметр)
	
	Если ИмяСобытия = "Документооборот_ДобавлениеСвязи"
		Или ИмяСобытия = "Документооборот_УдалениеСвязи" Тогда
		Возврат ТипЗнч(Параметр) = Тип("Структура")
			И Параметр.Свойство("Объект")
			И Параметр.Объект = Объект.Ссылка;
	КонецЕсли;
	
	Если ИмяСобытия = "Документооборот_ЗапущеноСогласование"
		Или ИмяСобытия = "Документооборот_ПрерваноСогласование"
		Или ИмяСобытия = "Документооборот_НеСогласовано"
		Или ИмяСобытия = "Документооборот_Согласовано" Тогда
		Возврат Параметр = Объект.Ссылка;
	КонецЕсли;
	
	// ДО 3: «Начать обработку» не шлёт ЗапущеноСогласование, статус в ERP приходит позже.
	Если ИмяСобытия = "Документооборот_ДействиеСОбработкой" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ЭтоОповещениеНачалаОбработкиЗаявки(ИмяСобытия, Параметр)
	
	Если ИмяСобытия <> "нп_ДатыЗапрета_НачатаОбработкаЗаявки" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Параметр = Объект.Ссылка Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Параметр) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Параметр.Найти(Объект.Ссылка) <> Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ОтложенноНастроитьФормуПоСостоянию()
	
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаКлиенте
Процедура ОжидатьБлокировкуПоДокументообороту()
	
	НастроитьФормуПоСостоянию();
	ОсталосьПопытокБлокировки = ОсталосьПопытокБлокировки - 1;
	Если ИзменениеЗаявкиЗапрещено Или ОсталосьПопытокБлокировки <= 0 Тогда
		ОтключитьОбработчикОжидания("ОжидатьБлокировкуПоДокументообороту");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОписаниеТекущейСтроки()
	
	ОбновитьОписаниеТекущейСтрокиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбъектыРазделДатыЗапретаПриИзмененииНаСервере()
	
	ТекущаяСтрока = Элементы.Объекты.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОбъекта = Объект.Объекты.НайтиПоИдентификатору(ТекущаяСтрока);
	Если СтрокаОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если нп_ДатыЗапретаИзменения.ЭтоОрганизационныйРаздел(СтрокаОбъекта.РазделДатыЗапрета)
		Или Не нп_ДатыЗапретаИзменения.ЭтоРазделБезОрганизации(СтрокаОбъекта.РазделДатыЗапрета) Тогда
		СтрокаОбъекта.ОбъектДатыЗапрета = Неопределено;
	ИначеЕсли ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) Тогда
		ОписаниеТипа = нп_ДатыЗапретаИзменения.ОписаниеТипаОбъектаРаздела(СтрокаОбъекта.РазделДатыЗапрета);
		Если Не ОписаниеТипа.СодержитТип(ТипЗнч(СтрокаОбъекта.ОбъектДатыЗапрета)) Тогда
			СтрокаОбъекта.ОбъектДатыЗапрета = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	НастроитьПолеОбъектаТекущейСтроки();
	ОбновитьОписаниеТекущейСтрокиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРазделовЗаявки()
	
	Элементы.ОбъектыРазделДатыЗапрета.СписокВыбора.Очистить();
	Для Каждого СсылкаРаздела Из нп_ДатыЗапретаИзменения.СсылкиРазделовДляВыбора(Ложь) Цикл
		Элементы.ОбъектыРазделДатыЗапрета.СписокВыбора.Добавить(СсылкаРаздела);
	КонецЦикла;
	Элементы.ОбъектыРазделДатыЗапрета.РежимВыбораИзСписка = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПолеОбъектаТекущейСтроки()
	
	ТекущаяСтрока = Элементы.Объекты.ТекущаяСтрока;
	ПоказыватьОбъект = Ложь;
	ЗаголовокОбъекта = НСтр("ru = 'Объект'");
	ОписаниеТипа = Новый ОписаниеТипов;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		СтрокаОбъекта = Объект.Объекты.НайтиПоИдентификатору(ТекущаяСтрока);
		Если СтрокаОбъекта <> Неопределено
			И нп_ДатыЗапретаИзменения.ЭтоРазделБезОрганизации(СтрокаОбъекта.РазделДатыЗапрета) Тогда
			ПоказыватьОбъект = Истина;
			ЗаголовокОбъекта = нп_ДатыЗапретаИзменения.ЗаголовокОбъектаРаздела(СтрокаОбъекта.РазделДатыЗапрета);
			ОписаниеТипа = нп_ДатыЗапретаИзменения.ОписаниеТипаОбъектаРаздела(СтрокаОбъекта.РазделДатыЗапрета);
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ОбъектыОбъектДатыЗапрета.Видимость = ПоказыватьОбъект;
	Элементы.ОбъектыОбъектДатыЗапрета.Заголовок = ЗаголовокОбъекта;
	Элементы.ОбъектыОбъектДатыЗапрета.ОграничениеТипа = ОписаниеТипа;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОписаниеТекущейСтрокиНаСервере()
	
	НастроитьПолеОбъектаТекущейСтроки();
	
	ТекущаяСтрока = Элементы.Объекты.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		ОписаниеРаздела = нп_ДатыЗапретаИзменения.ТекстОписанияРаздела(Неопределено, Ложь);
		Возврат;
	КонецЕсли;
	
	СтрокаОбъекта = Объект.Объекты.НайтиПоИдентификатору(ТекущаяСтрока);
	Если СтрокаОбъекта = Неопределено Тогда
		ОписаниеРаздела = "";
		Возврат;
	КонецЕсли;
	
	ОписаниеРаздела = нп_ДатыЗапретаИзменения.ТекстОписанияРаздела(
		СтрокаОбъекта.РазделДатыЗапрета,
		ЗначениеЗаполнено(Объект.Организация));
	
	Если нп_ДатыЗапретаИзменения.ЭтоРазделБезОрганизации(СтрокаОбъекта.РазделДатыЗапрета)
		И Не ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) Тогда
		ПредупреждениеПустого = нп_ДатыЗапретаИзменения.ТекстПредупрежденияПустогоОбъектаРаздела(
			СтрокаОбъекта.РазделДатыЗапрета);
		Если ЗначениеЗаполнено(ПредупреждениеПустого) Тогда
			ОписаниеРаздела = СокрЛП(ОписаниеРаздела + Символы.ПС + ПредупреждениеПустого);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗакрытьПериодДосрочноНаСервере()
	
	Документы.нп_ЗаявкаНаОткрытиеПериода.ЗакрытьПериодДосрочно(Объект.Ссылка);
	
КонецПроцедуры

