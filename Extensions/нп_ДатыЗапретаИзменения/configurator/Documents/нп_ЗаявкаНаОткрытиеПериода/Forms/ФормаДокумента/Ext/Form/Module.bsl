#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ПояснениеОтсечки.Заголовок = нп_ДатыЗапретаИзменения.ТекстПоясненияЗаявки();
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НастроитьФормуПоСостоянию();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ИнтеграцияС1СДокументооборот3Клиент.НачатьОбработку(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПериодДосрочно(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Документ ещё не записан.'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытьПериодДосрочноЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		НСтр("ru = 'Вернуть прежнюю дату запрета и удалить состояние открытого периода?'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПериодДосрочноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьПериодДосрочноНаСервере();
	Прочитать();
	ПоказатьПредупреждение(, НСтр("ru = 'Период закрыт досрочно.'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьФормуПоСостоянию()
	
	Согласован = нп_ДатыЗапретаИзменения.ДокументСогласован(Объект.Ссылка);
	ЕстьСостояние = нп_ДатыЗапретаИзменения.ЕстьДействующееСостояниеПоЗаявке(Объект.Ссылка);
	Полноправный = нп_ДатыЗапретаИзменения.ЭтоПолноправныйПользовательСеанса();
	
	ТолькоПросмотрДокумента = Согласован Или ЕстьСостояние;
	
	Элементы.ПериодС.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.СрокДействия.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.РазделДатыЗапрета.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.Пользователь.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.ПричинаОткрытия.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.Объекты.ТолькоПросмотр = ТолькоПросмотрДокумента;
	Элементы.Ответственный.ТолькоПросмотр = Истина;
	
	Элементы.ОтправитьНаСогласование.Доступность = Не ТолькоПросмотрДокумента И ЗначениеЗаполнено(Объект.Ссылка);
	Элементы.ЗакрытьПериодДосрочно.Видимость = Полноправный;
	Элементы.ЗакрытьПериодДосрочно.Доступность = Полноправный И ЕстьСостояние;
	
	СостояниеДО = нп_ДатыЗапретаИзменения.СостояниеСогласованияДО(Объект.Ссылка);
	Элементы.СостояниеСогласования.Заголовок = СостояниеДО.Представление;
	
КонецПроцедуры

&НаСервере
Процедура ЗакрытьПериодДосрочноНаСервере()
	
	Документы.нп_ЗаявкаНаОткрытиеПериода.ЗакрытьПериодДосрочно(Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти
