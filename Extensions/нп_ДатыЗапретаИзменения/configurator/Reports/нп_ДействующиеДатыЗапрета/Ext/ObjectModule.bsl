#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// Задать настройки формы отчета.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения, Неопределено
//  КлючВарианта - Строка, Неопределено
//  Настройки - см. ОтчетыКлиентСервер.НастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.ФормироватьСразу = Ложь;
	Настройки.РазрешеноИзменятьВарианты = Истина;
	Настройки.РазрешеноИзменятьСтруктуру = Истина;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиКД = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКД, ДанныеРасшифровки);
	
	ВнешниеНаборы = Новый Структура("ДатыЗапрета", ТаблицаДействующихДатЗапрета());
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаДействующихДатЗапрета()
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДействующихДатЗапрета();
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.ОписаниеДатыЗапрета = нп_ДатыЗапретаИзменения.ПредставлениеОписанияДатыЗапретаОтчета(
			СтрокаТаблицы.ОписаниеДатыЗапрета,
			СтрокаТаблицы.ОписаниеНастройки,
			СтрокаТаблицы.КоличествоДнейРазрешенияНастройки,
			СтрокаТаблицы.СпособРасчетаНастройки,
			СтрокаТаблицы.ЧислоДней);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ТекстЗапросаДействующихДатЗапрета()
	
	Возврат
		"ВЫБРАТЬ
		|	ДатыЗапрета.Пользователь КАК Пользователь,
		|	ДатыЗапрета.Раздел КАК Раздел,
		|	ДатыЗапрета.Объект КАК Объект,
		|	ДатыЗапрета.ДатаЗапрета КАК ДатаЗапрета,
		|	ДатыЗапрета.ОписаниеДатыЗапрета КАК ОписаниеДатыЗапрета,
		|	ДатыЗапрета.Комментарий КАК Комментарий,
		|	ВЫБОР
		|		КОГДА НЕ Состояние.ЗаявкаНаОткрытиеПериода ЕСТЬ NULL
		|			ТОГДА ""Временно открытый период""
		|		КОГДА НЕ ПодобраннаяНастройка.Пользователь ЕСТЬ NULL
		|				ИЛИ ДатыЗапрета.Комментарий ПОДОБНО ""нп_авто%""
		|			ТОГДА ""Автоматическая установка""
		|		ИНАЧЕ ""Установлено вручную""
		|	КОНЕЦ КАК Источник,
		|	ПодобраннаяНастройка.ЧислоДней КАК ЧислоДней,
		|	ПодобраннаяНастройка.ОписаниеДатыЗапрета КАК ОписаниеНастройки,
		|	ПодобраннаяНастройка.КоличествоДнейРазрешения КАК КоличествоДнейРазрешенияНастройки,
		|	ПодобраннаяНастройка.СпособРасчета КАК СпособРасчетаНастройки,
		|	Состояние.ЗаявкаНаОткрытиеПериода КАК ЗаявкаНаОткрытиеПериода,
		|	Состояние.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	Состояние.ЗаявкаНаОткрытиеПериода.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапрета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|		ПО ДатыЗапрета.Раздел = Состояние.РазделДатыЗапрета
		|			И ДатыЗапрета.Объект = Состояние.ОбъектДатыЗапрета
		|			И ДатыЗапрета.Пользователь = Состояние.Пользователь
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ДатыЗапретаВнутр.Пользователь КАК Пользователь,
		|			ДатыЗапретаВнутр.Раздел КАК Раздел,
		|			ДатыЗапретаВнутр.Объект КАК Объект,
		|			МАКСИМУМ(Настройки.ЧислоДней) КАК ЧислоДней,
		|			МАКСИМУМ(Настройки.ОписаниеДатыЗапрета) КАК ОписаниеДатыЗапрета,
		|			МАКСИМУМ(Настройки.КоличествоДнейРазрешения) КАК КоличествоДнейРазрешения,
		|			МАКСИМУМ(Настройки.СпособРасчета) КАК СпособРасчета
		|		ИЗ
		|			РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаВнутр
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.нп_НастройкиАвтоматическойУстановкиДатЗапрета КАК Настройки
		|				ПО Настройки.Включено
		|					И (ВЫБОР
		|						КОГДА Настройки.Пользователь = НЕОПРЕДЕЛЕНО
		|								ИЛИ Настройки.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|								ИЛИ Настройки.Пользователь = ЗНАЧЕНИЕ(Справочник.ГруппыПользователей.ПустаяСсылка)
		|								ИЛИ Настройки.Пользователь = ЗНАЧЕНИЕ(Перечисление.ВидыНазначенияДатЗапрета.ПустаяСсылка)
		|								ИЛИ Настройки.Пользователь = ЗНАЧЕНИЕ(Перечисление.ВидыНазначенияДатЗапрета.ДляВсехПользователей)
		|							ТОГДА ДатыЗапретаВнутр.Пользователь = ЗНАЧЕНИЕ(Перечисление.ВидыНазначенияДатЗапрета.ДляВсехПользователей)
		|						ИНАЧЕ Настройки.Пользователь = ДатыЗапретаВнутр.Пользователь
		|					КОНЕЦ)
		|					И (ВЫБОР
		|						КОГДА Настройки.ВсеРазделыБезОрганизации
		|							ТОГДА ДатыЗапретаВнутр.Объект = ДатыЗапретаВнутр.Раздел
		|								И ДатыЗапретаВнутр.Раздел.ИмяПредопределенныхДанных В (""Банк"", ""Касса"", ""СкладскиеОперации"", ""Бюджетирование"", ""Планирование"")
		|						КОГДА Настройки.ОбъектДатыЗапрета = НЕОПРЕДЕЛЕНО
		|								ИЛИ Настройки.ОбъектДатыЗапрета = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|								ИЛИ Настройки.ОбъектДатыЗапрета = ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
		|								ИЛИ Настройки.ОбъектДатыЗапрета = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|								ИЛИ Настройки.ОбъектДатыЗапрета = ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
		|								ИЛИ Настройки.ОбъектДатыЗапрета = ЗНАЧЕНИЕ(Справочник.Сценарии.ПустаяСсылка)
		|								ИЛИ Настройки.ОбъектДатыЗапрета = ЗНАЧЕНИЕ(Справочник.СценарииТоварногоПланирования.ПустаяСсылка)
		|							ТОГДА ДатыЗапретаВнутр.Раздел = Настройки.РазделДатыЗапрета
		|								И ДатыЗапретаВнутр.Объект = ДатыЗапретаВнутр.Раздел
		|						КОГДА Настройки.РазделДатыЗапрета = НЕОПРЕДЕЛЕНО
		|								ИЛИ Настройки.РазделДатыЗапрета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка)
		|							ТОГДА ДатыЗапретаВнутр.Объект = Настройки.ОбъектДатыЗапрета
		|						ИНАЧЕ ДатыЗапретаВнутр.Объект = Настройки.ОбъектДатыЗапрета
		|							И ДатыЗапретаВнутр.Раздел = Настройки.РазделДатыЗапрета
		|					КОНЕЦ)
		|		СГРУППИРОВАТЬ ПО
		|			ДатыЗапретаВнутр.Пользователь,
		|			ДатыЗапретаВнутр.Раздел,
		|			ДатыЗапретаВнутр.Объект) КАК ПодобраннаяНастройка
		|		ПО ДатыЗапрета.Раздел = ПодобраннаяНастройка.Раздел
		|			И ДатыЗапрета.Объект = ПодобраннаяНастройка.Объект
		|			И ДатыЗапрета.Пользователь = ПодобраннаяНастройка.Пользователь";
	
КонецФункции

#КонецОбласти

