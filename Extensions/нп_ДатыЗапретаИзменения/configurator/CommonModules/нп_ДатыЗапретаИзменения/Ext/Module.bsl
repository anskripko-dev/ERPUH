Функция ИмяРазделаПоСсылке(СсылкаРаздела)
	
	Если Не ЗначениеЗаполнено(СсылкаРаздела) Тогда
		Возврат "";
	КонецЕсли;
	
	ИдентификаторСтрокой = НРег(Строка(СсылкаРаздела.УникальныйИдентификатор()));
	Для Каждого ИмяРаздела Из ВсеИменаРазделов() Цикл
		ИдентификаторРаздела = ИдентификаторРазделаПоИмени(ИмяРаздела);
		Если ИдентификаторРаздела <> Неопределено
			И НРег(ИдентификаторРаздела) = ИдентификаторСтрокой Тогда
			Возврат ИмяРаздела;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
