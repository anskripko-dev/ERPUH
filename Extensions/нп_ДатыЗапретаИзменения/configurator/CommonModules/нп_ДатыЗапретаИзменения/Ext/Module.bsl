#Область ПрограммныйИнтерфейс

// Регламентное задание нп_СдвигДатЗапретаИзменения.
// Сначала возвращает истёкшие открытые периоды, затем актуализирует автоматические
// записи типового регистра по включённым настройкам. Ручные записи не изменяет.
//
Процедура СдвигДатЗапретаИзменения() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Ошибки = Новый Массив;
	
	Попытка
		ВосстановитьИстекшиеОткрытыеПериоды(Ошибки);
	Исключение
		Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
			НСтр("ru = 'Восстановление истёкших открытых периодов'"),
			ИнформацияОбОшибке()));
	КонецПопытки;
	
	ПрименитьВключенныеНастройки(Ошибки);
	
	Если Ошибки.Количество() > 0 Тогда
		ОтправитьУведомлениеОбОшибках(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик смены состояния согласования в ДО 3.
//
// Параметры:
//  ПредметСогласования - ЛюбаяСсылка
//  Состояние - ПеречислениеСсылка.СостоянияСогласованияВДокументообороте
//  ДатаУстановки - Дата
//
Процедура ОбработатьИзменениеСостоянияСогласования(ПредметСогласования, Состояние, ДатаУстановки) Экспорт
	
	Если ТипЗнч(ПредметСогласования) <> Тип("ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода") Тогда
		Возврат;
	КонецЕсли;
	
	Если Состояние <> Перечисления.СостоянияСогласованияВДокументообороте.Согласован Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ОткрытьПериодПоЗаявке(ПредметСогласования, ДатаУстановки);
	Исключение
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			СтрШаблон(НСтр("ru = 'Не удалось открыть период по заявке %1'"), ПредметСогласования),
			ПредметСогласования,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Записывает отсечку по согласованной заявке и строки регистра состояния.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода
//  ДатаСогласования - Дата
//
Процедура ОткрытьПериодПоЗаявке(ДокументСсылка, ДатаСогласования) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"ПериодС, СрокДействия, РазделДатыЗапрета, Пользователь");
	
	Если Не ЗначениеЗаполнено(Реквизиты.Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь (или группа пользователей) обязателен. Заявка открывает период только для указанного адресата, не «для всех».'");
	КонецЕсли;
	
	Комбинации = РазвернутыеКомбинацииЗаявки(ДокументСсылка);
	Если Комбинации.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В заявке нет комбинаций для открытия периода.'");
	КонецЕсли;
	
	ДатаСогласованияДень = НачалоДня(ДатаСогласования);
	Если Не ЗначениеЗаполнено(ДатаСогласованияДень) Тогда
		ДатаСогласованияДень = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ДатаОкончания = ДатаСогласованияДень + (Реквизиты.СрокДействия - 1) * 86400;
	Отсечка = НачалоДня(Реквизиты.ПериодС) - 86400;
	Адресат = КаноническийПользователь(Реквизиты.Пользователь);
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		Для Каждого Комбинация Из Комбинации Цикл
			ПрименитьОткрытиеПоКомбинации(Комбинация, Адресат, Отсечка, ДатаОкончания, ДокументСсылка);
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(
			НСтр("ru = 'Открыт период по заявке %1: отсечка %2, окончание %3'"),
			ДокументСсылка,
			Формат(Отсечка, "ДЛФ=D"),
			Формат(ДатаОкончания, "ДЛФ=D")),
		ДокументСсылка);
	
КонецПроцедуры

// Немедленный возврат границы по заявке (команда «Закрыть период досрочно»).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода
//
Процедура ЗакрытьПериодДосрочно(ДокументСсылка) Экспорт
	
	Если Не ЭтоПолноправныйПользовательСеанса() Тогда
		ВызватьИсключение НСтр("ru = 'Досрочное закрытие периода доступно только полноправному пользователю.'");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Состояние.Пользователь КАК Пользователь,
		|	Состояние.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Состояние.ДатаЗапретаДоОткрытия КАК ДатаЗапретаДоОткрытия,
		|	Состояние.ЗаписьБылаУстановленаАвтоматически КАК ЗаписьБылаУстановленаАвтоматически
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ЗаявкаНаОткрытиеПериода = &Заявка");
	Запрос.УстановитьПараметр("Заявка", ДокументСсылка);
	ТаблицаСостояний = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаСостояний.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет действующего открытого периода по этой заявке (возможно, период уже закрыт или заявкой-основанием является другая заявка).'");
	КонецЕсли;
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		Для Каждого СтрокаСостояния Из ТаблицаСостояний Цикл
			ВосстановитьТиповуюЗапись(
				СтрокаСостояния.РазделДатыЗапрета,
				СтрокаСостояния.ОбъектДатыЗапрета,
				СтрокаСостояния.Пользователь,
				СтрокаСостояния.ДатаЗапретаДоОткрытия,
				СтрокаСостояния.ЗаписьБылаУстановленаАвтоматически);
			УдалитьСостояние(
				СтрокаСостояния.РазделДатыЗапрета,
				СтрокаСостояния.ОбъектДатыЗапрета,
				СтрокаСостояния.Пользователь);
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(НСтр("ru = 'Период по заявке %1 закрыт досрочно'"), ДокументСсылка),
		ДокументСсылка);
	
КонецПроцедуры

// Абсолютная дата запрета: текущий день минус N календарных дней, включая текущий.
//
// Параметры:
//  ЧислоДней - Число
//  ДатаРасчета - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаЗапретаПоЧислуДней(ЧислоДней, ДатаРасчета) Экспорт
	
	Возврат НачалоДня(ДатаРасчета) - ЧислоДней * 86400;
	
КонецФункции

// Возвращает Истина, если заявка согласована в ДО 3.
//
Функция ДокументСогласован(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Состояние = СостояниеСогласованияДО(ДокументСсылка);
	Возврат Состояние.Состояние = Перечисления.СостоянияСогласованияВДокументообороте.Согласован;
	
КонецФункции

// Возвращает Истина, если по заявке есть строки регистра состояния.
//
Функция ЕстьДействующееСостояниеПоЗаявке(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьЗапись
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ЗаявкаНаОткрытиеПериода = &Заявка");
	Запрос.УстановитьПараметр("Заявка", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Текст постоянного пояснения на форме заявки.
//
Функция ТекстПоясненияЗаявки() Экспорт
	
	Возврат НСтр("ru = 'Согласованная заявка разрешает менять документы с даты «Открыть период с» и более поздние. Срок — столько дней, сколько указано. Когда срок закончится, запрет вернётся сам.'");
	
КонецФункции

// Состояние согласования объекта в ДО по типовым регистрам (без веб-вызова).
//
Функция СостояниеСогласованияДО(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьСвязьСДО", Ложь);
	Результат.Вставить("Состояние", Неопределено);
	Результат.Вставить("Представление", НСтр("ru = 'Нет связи с Документооборотом'"));
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО КАК ИдентификаторОбъектаДО,
		|	СостоянияСогласованияВДокументообороте.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированныеС1СДокументооборотом
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСогласованияВДокументообороте КАК СостоянияСогласованияВДокументообороте
		|		ПО ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО = СостоянияСогласованияВДокументообороте.ИдентификаторОбъектаДО
		|ГДЕ
		|	ОбъектыИнтегрированныеС1СДокументооборотом.Объект = &СсылкаНаОбъект");
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЕстьСвязьСДО = Истина;
	Результат.Состояние = Выборка.Состояние;
	
	Если Не ЗначениеЗаполнено(Выборка.Состояние) Тогда
		Результат.Представление = НСтр("ru = 'Связан с ДО, состояние не задано'");
	Иначе
		Результат.Представление = Строка(Выборка.Состояние);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет запись регистра настроек: несовместимые типы объекта и раздела.
// Пустые объект и раздел одновременно допустимы: общая дата адресата в типовом РС.
//
Процедура ПроверитьЗаписьНастройки(ОбъектДатыЗапрета, РазделДатыЗапрета) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ИменаРазделов = ИменаРазделовДляТипаОбъекта(ТипЗнч(ОбъектДатыЗапрета));
		ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
		Если ИменаРазделов.Найти(ИмяРаздела) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Раздел «%1» недопустим для типа объекта «%2».'"),
				Строка(РазделДатыЗапрета),
				Строка(ТипЗнч(ОбъектДатыЗапрета)));
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Если Не ЗначениеЗаполнено(ИмяРазделаПоСсылке(РазделДатыЗапрета)) Тогда
			ВызватьИсключение НСтр("ru = 'Указанный раздел не входит в закрытый перечень доработки.'");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет реквизиты заявки перед записью.
// Пользователь обязателен. Пустые объект и раздел одновременно допустимы: общая дата адресата.
//
Процедура ПроверитьЗаявкуПередЗаписью(ДокументОбъект) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь (или группа пользователей) обязателен. Заявка открывает период только для указанного адресата, не «для всех».'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ПериодС) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен реквизит «Открыть период с».'");
	КонецЕсли;
	
	Если ДокументОбъект.СрокДействия < 1 Тогда
		ВызватьИсключение НСтр("ru = 'Срок действия должен быть не меньше 1 дня.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ПричинаОткрытия) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена причина открытия периода.'");
	КонецЕсли;
	
	ЕстьЗаполненнаяСтрока = Ложь;
	УказаниеПоРазделам = УказаниеЗаявкиПоРазделам(ДокументОбъект);
	
	Для Каждого СтрокаОбъекта Из ДокументОбъект.Объекты Цикл
		РазделСтроки = РазделСтрокиЗаявки(СтрокаОбъекта, ДокументОбъект.РазделДатыЗапрета);
		Если УказаниеПоРазделам Тогда
			Если Не ЗначениеЗаполнено(РазделСтроки) Тогда
				Продолжить;
			КонецЕсли;
			ЕстьЗаполненнаяСтрока = Истина;
			ПроверитьЗаписьНастройки(Неопределено, РазделСтроки);
		Иначе
			Если Не ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделСтроки) Тогда
				Продолжить;
			КонецЕсли;
			ЕстьЗаполненнаяСтрока = Истина;
			ПроверитьЗаписьНастройки(СтрокаОбъекта.ОбъектДатыЗапрета, РазделСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьЗаполненнаяСтрока Тогда
		ПроверитьЗаписьНастройки(Неопределено, ДокументОбъект.РазделДатыЗапрета);
	КонецЕсли;
	
КонецПроцедуры

// Истина, если текущий пользователь полноправный.
//
Функция ЭтоПолноправныйПользовательСеанса() Экспорт
	
	Возврат Пользователи.ЭтоПолноправныйПользователь();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВосстановитьИстекшиеОткрытыеПериоды(Ошибки)
	
	ДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Состояние.Пользователь КАК Пользователь,
		|	Состояние.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Состояние.ДатаЗапретаДоОткрытия КАК ДатаЗапретаДоОткрытия,
		|	Состояние.ЗаписьБылаУстановленаАвтоматически КАК ЗаписьБылаУстановленаАвтоматически,
		|	Состояние.ЗаявкаНаОткрытиеПериода КАК ЗаявкаНаОткрытиеПериода,
		|	Состояние.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ДатаОкончанияДействия < &ДатаСеанса");
	Запрос.УстановитьПараметр("ДатаСеанса", ДатаСеанса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		Пока Выборка.Следующий() Цикл
			Попытка
				ВосстановитьТиповуюЗапись(
					Выборка.РазделДатыЗапрета,
					Выборка.ОбъектДатыЗапрета,
					Выборка.Пользователь,
					Выборка.ДатаЗапретаДоОткрытия,
					Выборка.ЗаписьБылаУстановленаАвтоматически);
				УдалитьСостояние(
					Выборка.РазделДатыЗапрета,
					Выборка.ОбъектДатыЗапрета,
					Выборка.Пользователь);
				ЗаписатьВЖурнал(
					УровеньЖурналаРегистрации.Информация,
					СтрШаблон(
						НСтр("ru = 'Возвращена граница: раздел %1, объект %2, пользователь %3, заявка %4'"),
						Выборка.РазделДатыЗапрета,
						Выборка.ОбъектДатыЗапрета,
						Выборка.Пользователь,
						Выборка.ЗаявкаНаОткрытиеПериода),
					Выборка.ЗаявкаНаОткрытиеПериода);
			Исключение
				Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
					СтрШаблон(
						НСтр("ru = 'Возврат границы: объект %1, раздел %2, пользователь %3'"),
						Выборка.ОбъектДатыЗапрета,
						Выборка.РазделДатыЗапрета,
						Выборка.Пользователь),
					ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
КонецПроцедуры

Процедура ПрименитьВключенныеНастройки(Ошибки)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Настройки.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Настройки.Пользователь КАК Пользователь,
		|	Настройки.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Настройки.ЧислоДней КАК ЧислоДней
		|ИЗ
		|	РегистрСведений.нп_НастройкиАвтоматическойУстановкиДатЗапрета КАК Настройки
		|ГДЕ
		|	Настройки.Включено");
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДатаСеанса = ТекущаяДатаСеанса();
	АктуальныеКлючи = Новый Соответствие;
	ОшибокНастроек = 0;
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		Пока Выборка.Следующий() Цикл
			Попытка
				ПрименитьОднуНастройку(Выборка, ДатаСеанса, АктуальныеКлючи);
			Исключение
				ОшибокНастроек = ОшибокНастроек + 1;
				Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
					СтрШаблон(
						НСтр("ru = 'Настройка: объект %1, раздел %2, пользователь %3, N=%4'"),
						Выборка.ОбъектДатыЗапрета,
						Выборка.РазделДатыЗапрета,
						Выборка.Пользователь,
						Выборка.ЧислоДней),
					ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ДополнитьОбщиеДатыДетальнымАдресатам(АктуальныеКлючи);
		Если ОшибокНастроек = 0 Тогда
			УдалитьУстаревшиеАвтозаписи(АктуальныеКлючи);
		КонецЕсли;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
КонецПроцедуры

Процедура ПрименитьОднуНастройку(Настройка, ДатаСеанса, АктуальныеКлючи)
	
	Комбинации = РазвернутыеКомбинацииНастройки(
		Настройка.ОбъектДатыЗапрета,
		Настройка.РазделДатыЗапрета);
	Адресат = КаноническийПользователь(Настройка.Пользователь);
	ДатаЗапрета = ДатаЗапретаПоЧислуДней(Настройка.ЧислоДней, ДатаСеанса);
	Комментарий = КомментарийАвтозаписи(Адресат, Настройка.ЧислоДней);
	
	Для Каждого Комбинация Из Комбинации Цикл
		АктуальныеКлючи.Вставить(КлючТиповойЗаписи(Комбинация.Раздел, Комбинация.Объект, Адресат), Истина);
		Если ЕстьДействующееСостояниеКомбинации(Комбинация.Раздел, Комбинация.Объект, Адресат) Тогда
			Продолжить;
		КонецЕсли;
		ТекущаяТиповая = ПрочитатьТиповуюЗапись(Комбинация.Раздел, Комбинация.Объект, Адресат);
		Если ТекущаяТиповая.ЕстьЗапись И ЭтоРучнаяТиповаяЗапись(ТекущаяТиповая.Комментарий) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьТиповуюДатуЗапрета(Комбинация.Раздел, Комбинация.Объект, Адресат, ДатаЗапрета, Комментарий);
	КонецЦикла;
	
КонецПроцедуры

// БСП выбирает адресата целиком: личная запись по одному объекту отключает
// набор «для всех» / группы. Чтобы остальные разделы не остались без запрета,
// детальному адресату без своей общей даты копируется общая дата родителя.
//
Процедура ДополнитьОбщиеДатыДетальнымАдресатам(АктуальныеКлючи)
	
	ПустойРаздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
	
	Записи = ВсеЗаписиТиповогоРегистра();
	ОбщиеДаты = ОбщиеАвтодатыПоАдресатам(Записи);
	ДетальныеАдресаты = АдресатыСДетальнымиЗаписями(Записи);
	
	Для Каждого Адресат Из АдресатыГрупп(ДетальныеАдресаты) Цикл
		Если АктуальныеКлючи.Получить(КлючТиповойЗаписи(ПустойРаздел, ПустойРаздел, Адресат)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Родитель = ОбщиеДаты.Получить(Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей);
		Если Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Комментарий = МаксимальныйАвтоКомментарийАдресата(Записи, Адресат);
		Если ЗаписатьНаследуемуюОбщуюДату(Адресат, ПустойРаздел, Родитель.ДатаЗапрета, Комментарий, АктуальныеКлючи) Тогда
			ОбщиеДаты.Вставить(Адресат, Новый Структура("ДатаЗапрета, Комментарий", Родитель.ДатаЗапрета, Комментарий));
		КонецЕсли;
	КонецЦикла;
	
	ОбщиеДатыГруппПользователей = ОбщиеДатыВыигрывающихГрупп(ОбщиеДаты);
	
	Для Каждого Адресат Из АдресатыПользователей(ДетальныеАдресаты) Цикл
		Если АктуальныеКлючи.Получить(КлючТиповойЗаписи(ПустойРаздел, ПустойРаздел, Адресат)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Родитель = ОбщиеДатыГруппПользователей.Получить(Адресат);
		Если Родитель = Неопределено Тогда
			Родитель = ОбщиеДаты.Получить(Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей);
		КонецЕсли;
		Если Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьНаследуемуюОбщуюДату(
			Адресат,
			ПустойРаздел,
			Родитель.ДатаЗапрета,
			ПрефиксАвтоКомментария(),
			АктуальныеКлючи);
	КонецЦикла;
	
КонецПроцедуры

Функция ВсеЗаписиТиповогоРегистра()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Даты.Пользователь КАК Пользователь,
		|	Даты.Раздел КАК Раздел,
		|	Даты.Объект КАК Объект,
		|	Даты.ДатаЗапрета КАК ДатаЗапрета,
		|	Даты.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК Даты");
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОбщиеАвтодатыПоАдресатам(Записи)
	
	Результат = Новый Соответствие;
	Для Каждого СтрокаЗаписи Из Записи Цикл
		Если ЗначениеЗаполнено(СтрокаЗаписи.Раздел) Или ЗначениеЗаполнено(СтрокаЗаписи.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоАвтоматическаяТиповаяЗапись(СтрокаЗаписи.Комментарий) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(
			СтрокаЗаписи.Пользователь,
			Новый Структура("ДатаЗапрета, Комментарий", СтрокаЗаписи.ДатаЗапрета, СтрокаЗаписи.Комментарий));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция АдресатыСДетальнымиЗаписями(Записи)
	
	Результат = Новый Соответствие;
	Для Каждого СтрокаЗаписи Из Записи Цикл
		Если Не ЗначениеЗаполнено(СтрокаЗаписи.Раздел) И Не ЗначениеЗаполнено(СтрокаЗаписи.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(СтрокаЗаписи.Пользователь, Истина);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция АдресатыГрупп(ДетальныеАдресаты)
	
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ДетальныеАдресаты Цикл
		Если ТипЗнч(КлючИЗначение.Ключ) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция АдресатыПользователей(ДетальныеАдресаты)
	
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ДетальныеАдресаты Цикл
		Если ТипЗнч(КлючИЗначение.Ключ) = Тип("СправочникСсылка.Пользователи") Тогда
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция МаксимальныйАвтоКомментарийАдресата(Записи, Адресат)
	
	Комментарий = ПрефиксАвтоКомментария();
	Для Каждого СтрокаЗаписи Из Записи Цикл
		Если СтрокаЗаписи.Пользователь <> Адресат Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоАвтоматическаяТиповаяЗапись(СтрокаЗаписи.Комментарий) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаЗаписи.Комментарий > Комментарий Тогда
			Комментарий = СтрокаЗаписи.Комментарий;
		КонецЕсли;
	КонецЦикла;
	Возврат Комментарий;
	
КонецФункции

Функция ОбщиеДатыВыигрывающихГрупп(ОбщиеДаты)
	
	Результат = Новый Соответствие;
	ВыбраннаяГруппа = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состав.Пользователь КАК Пользователь,
		|	Состав.ГруппаПользователей КАК ГруппаПользователей,
		|	Даты.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(Состав.ГруппаПользователей.Наименование, """") КАК НаименованиеГруппы
		|ИЗ
		|	РегистрСведений.СоставыГруппПользователей КАК Состав
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаИзменения КАК Даты
		|		ПО Состав.ГруппаПользователей = Даты.Пользователь
		|ГДЕ
		|	Состав.ГруппаПользователей <> Состав.Пользователь
		|
		|УПОРЯДОЧИТЬ ПО
		|	Пользователь,
		|	Комментарий УБЫВ,
		|	НаименованиеГруппы УБЫВ");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВыбраннаяГруппа.Получить(Выборка.Пользователь) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВыбраннаяГруппа.Вставить(Выборка.Пользователь, Выборка.ГруппаПользователей);
		Родитель = ОбщиеДаты.Получить(Выборка.ГруппаПользователей);
		Если Родитель <> Неопределено Тогда
			Результат.Вставить(Выборка.Пользователь, Родитель);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьНаследуемуюОбщуюДату(Адресат, ПустойРаздел, ДатаЗапрета, Комментарий, АктуальныеКлючи)
	
	Если ЕстьДействующееСостояниеКомбинации(ПустойРаздел, ПустойРаздел, Адресат) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекущаяТиповая = ПрочитатьТиповуюЗапись(ПустойРаздел, ПустойРаздел, Адресат);
	Если ТекущаяТиповая.ЕстьЗапись И ЭтоРучнаяТиповаяЗапись(ТекущаяТиповая.Комментарий) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекущаяТиповая.ЕстьЗапись И ЭтоКомментарийОткрытия(ТекущаяТиповая.Комментарий) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаписатьТиповуюДатуЗапрета(ПустойРаздел, ПустойРаздел, Адресат, ДатаЗапрета, Комментарий);
	АктуальныеКлючи.Вставить(КлючТиповойЗаписи(ПустойРаздел, ПустойРаздел, Адресат), Истина);
	Возврат Истина;
	
КонецФункции

Процедура ПрименитьОткрытиеПоКомбинации(Комбинация, Адресат, Отсечка, ДатаОкончания, ДокументСсылка)
	
	ТекущееСостояние = ПрочитатьСостояние(Комбинация.Раздел, Комбинация.Объект, Адресат);
	ТекущаяТиповая = ПрочитатьТиповуюЗапись(Комбинация.Раздел, Комбинация.Объект, Адресат);
	
	Если ТекущееСостояние = Неопределено Тогда
		ДатаДоОткрытия = ТекущаяТиповая.ДатаЗапрета;
		БылаАвто = ЭтоАвтоматическаяТиповаяЗапись(ТекущаяТиповая.Комментарий);
		ЗаписатьТиповуюДатуЗапрета(
			Комбинация.Раздел,
			Комбинация.Объект,
			Адресат,
			Отсечка,
			КомментарийОткрытия(ДокументСсылка));
		ЗаписатьСостояние(
			Комбинация.Раздел,
			Комбинация.Объект,
			Адресат,
			ДокументСсылка,
			ДатаОкончания,
			ДатаДоОткрытия,
			БылаАвто);
		Возврат;
	КонецЕсли;
	
	НоваяОтсечка = Отсечка;
	Если ЗначениеЗаполнено(ТекущаяТиповая.ДатаЗапрета) Тогда
		НоваяОтсечка = Мин(ТекущаяТиповая.ДатаЗапрета, Отсечка);
	КонецЕсли;
	НовоеОкончание = Макс(ТекущееСостояние.ДатаОкончанияДействия, ДатаОкончания);
	
	ЗаписатьТиповуюДатуЗапрета(
		Комбинация.Раздел,
		Комбинация.Объект,
		Адресат,
		НоваяОтсечка,
		КомментарийОткрытия(ТекущееСостояние.ЗаявкаНаОткрытиеПериода));
	
	ЗаписатьСостояние(
		Комбинация.Раздел,
		Комбинация.Объект,
		Адресат,
		ТекущееСостояние.ЗаявкаНаОткрытиеПериода,
		НовоеОкончание,
		ТекущееСостояние.ДатаЗапретаДоОткрытия,
		ТекущееСостояние.ЗаписьБылаУстановленаАвтоматически);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(
			НСтр("ru = 'Пересечение заявок: основание %1, новая %2, отсечка %3, окончание %4'"),
			ТекущееСостояние.ЗаявкаНаОткрытиеПериода,
			ДокументСсылка,
			Формат(НоваяОтсечка, "ДЛФ=D"),
			Формат(НовоеОкончание, "ДЛФ=D")),
		ДокументСсылка);
	
КонецПроцедуры

Функция РазвернутыеКомбинацииНастройки(ОбъектДатыЗапрета, РазделДатыЗапрета)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ДобавитьКомбинацию(Результат, РазделДатыЗапрета, ОбъектДатыЗапрета);
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ДобавитьКомбинацию(Результат, РазделДатыЗапрета, РазделДатыЗапрета);
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Для Каждого ИмяРаздела Из ИменаРазделовДляТипаОбъекта(ТипЗнч(ОбъектДатыЗапрета)) Цикл
			СсылкаРаздела = СсылкаРазделаПоИмени(ИмяРаздела);
			Если ЗначениеЗаполнено(СсылкаРаздела) Тогда
				ДобавитьКомбинацию(Результат, СсылкаРаздела, ОбъектДатыЗапрета);
			КонецЕсли;
		КонецЦикла;
		Если Результат.Количество() = 0 Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Не найдены разделы закрытого перечня для типа объекта «%1».'"),
				Строка(ТипЗнч(ОбъектДатыЗапрета)));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	ПустойРаздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
	ДобавитьКомбинацию(Результат, ПустойРаздел, ПустойРаздел);
	Возврат Результат;
	
КонецФункции

Функция РазделСтрокиЗаявки(СтрокаОбъекта, РазделШапки)
	
	Если ЗначениеЗаполнено(СтрокаОбъекта.РазделДатыЗапрета) Тогда
		Возврат СтрокаОбъекта.РазделДатыЗапрета;
	КонецЕсли;
	
	Возврат РазделШапки;
	
КонецФункции

Функция УказаниеЗаявкиПоРазделам(ДокументОбъект)
	
	Если ДокументОбъект.СпособУказания = Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделам Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ДокументОбъект.СпособУказания = Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделамИОбъектам Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаОбъекта Из ДокументОбъект.Объекты Цикл
		Если ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция УказаниеСсылкиПоРазделам(СпособУказания, ОбъектыЗаявки)
	
	Если СпособУказания = Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделам Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СпособУказания = Перечисления.нп_СпособыУказанияОткрытияПериода.ПоРазделамИОбъектам Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаОбъекта Из ОбъектыЗаявки Цикл
		Если ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция РазвернутыеКомбинацииЗаявки(ДокументСсылка)
	
	Результат = Новый Массив;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "РазделДатыЗапрета, СпособУказания");
	РазделШапки = Реквизиты.РазделДатыЗапрета;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Объекты.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Объекты.РазделДатыЗапрета КАК РазделДатыЗапрета
		|ИЗ
		|	Документ.нп_ЗаявкаНаОткрытиеПериода.Объекты КАК Объекты
		|ГДЕ
		|	Объекты.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	ОбъектыЗаявки = Запрос.Выполнить().Выгрузить();
	
	УказаниеПоРазделам = УказаниеСсылкиПоРазделам(Реквизиты.СпособУказания, ОбъектыЗаявки);
	
	Для Каждого СтрокаОбъекта Из ОбъектыЗаявки Цикл
		РазделСтроки = РазделСтрокиЗаявки(СтрокаОбъекта, РазделШапки);
		Если УказаниеПоРазделам Тогда
			Если Не ЗначениеЗаполнено(РазделСтроки) Тогда
				Продолжить;
			КонецЕсли;
			КомбинацииСтроки = РазвернутыеКомбинацииНастройки(Неопределено, РазделСтроки);
		Иначе
			Если Не ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделСтроки) Тогда
				Продолжить;
			КонецЕсли;
			КомбинацииСтроки = РазвернутыеКомбинацииНастройки(СтрокаОбъекта.ОбъектДатыЗапрета, РазделСтроки);
		КонецЕсли;
		Для Каждого Комбинация Из КомбинацииСтроки Цикл
			Результат.Добавить(Комбинация);
		КонецЦикла;
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		Возврат РазвернутыеКомбинацииНастройки(Неопределено, РазделШапки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКомбинацию(МассивКомбинаций, Раздел, Объект)
	
	Комбинация = Новый Структура("Раздел, Объект", Раздел, Объект);
	МассивКомбинаций.Добавить(Комбинация);
	
КонецПроцедуры

Функция КаноническийПользователь(ПользовательНастройки)
	
