Процедура УдалитьУстаревшиеАвтозаписи(АктуальныеКлючи)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Даты.Раздел КАК Раздел,
		|	Даты.Объект КАК Объект,
		|	Даты.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК Даты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|		ПО Даты.Раздел = Состояние.РазделДатыЗапрета
		|			И Даты.Объект = Состояние.ОбъектДатыЗапрета
		|			И Даты.Пользователь = Состояние.Пользователь
		|ГДЕ
		|	Даты.Комментарий ПОДОБНО &ПрефиксАвто
		|	И Состояние.ЗаявкаНаОткрытиеПериода ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ПрефиксАвто", ПрефиксАвтоКомментария() + "%");
	
	Удалено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если АктуальныеКлючи.Получить(КлючТиповойЗаписи(Выборка.Раздел, Выборка.Объект, Выборка.Пользователь)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УдалитьТиповуюЗапись(Выборка.Раздел, Выборка.Объект, Выборка.Пользователь);
		Удалено = Удалено + 1;
	КонецЦикла;
	
	Если Удалено > 0 Тогда
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Информация,
			СтрШаблон(НСтр("ru = 'Удалены устаревшие автоматические записи типового регистра: %1'"), Удалено));
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьТиповуюЗапись(Раздел, Объект, Пользователь)
	
	НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Раздел.Установить(Раздел);
	НаборЗаписей.Отбор.Объект.Установить(Объект);
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Записать();
	
КонецПроцедуры

