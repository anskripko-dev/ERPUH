КонецПроцедуры

Функция НачатьЗаписьТиповогоРегистра()
	
	ПроверкаБылаОтключена = ДатыЗапретаИзменения.ПроверкаДатЗапретаОтключена();
	ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(Истина);
	Возврат ПроверкаБылаОтключена;
	
КонецФункции

Процедура ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена)
	
	ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(ПроверкаБылаОтключена);
	
КонецПроцедуры

Процедура ОтправитьУведомлениеОбОшибках(Ошибки)
	
	ТекстОшибок = СтрСоединить(Ошибки, Символы.ПС + Символы.ПС);
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Ошибка,
		НСтр("ru = 'Задание сдвига дат запрета завершилось с ошибками'"),
		Неопределено,
		ТекстОшибок);
	
	Адреса = СокрЛП(Строка(Константы.нп_ПолучателиУведомленийСдвигаДатЗапрета.Получить()));
	Если ПустаяСтрока(Адреса) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна() Тогда
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Предупреждение,
			НСтр("ru = 'Системная учётная запись почты недоступна, уведомление не отправлено'"));
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыПисьма = Новый Структура;
		ПараметрыПисьма.Вставить("Кому", Адреса);
		ПараметрыПисьма.Вставить("Тема", НСтр("ru = 'Ошибки сдвига дат запрета изменения'"));
		ПараметрыПисьма.Вставить("Тело", ТекстОшибок);
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(
			РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(),
			ПараметрыПисьма);
	Исключение
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Предупреждение,
			НСтр("ru = 'Не удалось отправить уведомление об ошибках сдвига дат запрета'"),
			Неопределено,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция КраткоеИПодробноеОписаниеОшибки(Контекст, Информация)
	
	ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка, Контекст, Неопределено, ПодробноеПредставлениеОшибки(Информация));
	Возврат Контекст + Символы.ПС + КраткоеПредставлениеОшибки(Информация);
	
КонецФункции

Процедура ЗаписатьВЖурнал(Уровень, Сообщение, Данные = Неопределено, Комментарий = "")
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурнала(),
		Уровень,
		,
		Данные,
		?(ПустаяСтрока(Комментарий), Сообщение, Сообщение + Символы.ПС + Комментарий));
	
КонецПроцедуры

Функция ИмяСобытияЖурнала()
	
	Возврат "нп_СдвигДатЗапретаИзменения";
	
КонецФункции

