#Область ПрограммныйИнтерфейс

// Регламентное задание нп_СдвигДатЗапретаИзменения.
// Сначала возвращает истёкшие открытые периоды, затем актуализирует автоматические
// записи типового регистра по включённым настройкам. Ручные записи не изменяет.
//
Процедура СдвигДатЗапретаИзменения() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Ошибки = Новый Массив;
	
	Попытка
		ВосстановитьИстекшиеОткрытыеПериоды(Ошибки);
	Исключение
		Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
			НСтр("ru = 'Восстановление истёкших открытых периодов'"),
			ИнформацияОбОшибке()));
	КонецПопытки;
	
	ПрименитьВключенныеНастройки(Ошибки);
	
	Если Ошибки.Количество() > 0 Тогда
		ОтправитьУведомлениеОбОшибках(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик смены состояния согласования в ДО 3.
//
// Параметры:
//  ПредметСогласования - ЛюбаяСсылка
//  Состояние - ПеречислениеСсылка.СостоянияСогласованияВДокументообороте
//  ДатаУстановки - Дата
//
Процедура ОбработатьИзменениеСостоянияСогласования(ПредметСогласования, Состояние, ДатаУстановки) Экспорт
	
	Если ТипЗнч(ПредметСогласования) <> Тип("ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода") Тогда
		Возврат;
	КонецЕсли;
	
	Если Состояние <> Перечисления.СостоянияСогласованияВДокументообороте.Согласован Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ОткрытьПериодПоЗаявке(ПредметСогласования, ДатаУстановки);
	Исключение
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			СтрШаблон(НСтр("ru = 'Не удалось открыть период по заявке %1'"), ПредметСогласования),
			ПредметСогласования,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Записывает отсечку по согласованной заявке и строки регистра состояния.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода
//  ДатаСогласования - Дата
//
Процедура ОткрытьПериодПоЗаявке(ДокументСсылка, ДатаСогласования) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"ПериодС, СрокДействия, Пользователь, Организация");
	
	Если Не ЗначениеЗаполнено(Реквизиты.Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь (или группа пользователей) обязателен. Заявка открывает период только для указанного адресата, не «для всех».'");
	КонецЕсли;
	
	Комбинации = РазвернутыеКомбинацииЗаявки(ДокументСсылка);
	Если Комбинации.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В заявке нет комбинаций для открытия периода.'");
	КонецЕсли;
	
	ДатаСогласованияДень = НачалоДня(ДатаСогласования);
	Если Не ЗначениеЗаполнено(ДатаСогласованияДень) Тогда
		ДатаСогласованияДень = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ДатаОкончания = ДатаСогласованияДень + (Реквизиты.СрокДействия - 1) * 86400;
	Отсечка = НачалоДня(Реквизиты.ПериодС) - 86400;
	Адресат = КаноническийПользователь(Реквизиты.Пользователь);
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		Для Каждого Комбинация Из Комбинации Цикл
			ПрименитьОткрытиеПоКомбинации(Комбинация, Адресат, Отсечка, ДатаОкончания, ДокументСсылка);
		КонецЦикла;
		НаследоватьНаборРодителяПослеОткрытия(Адресат, Комбинации);
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(
			НСтр("ru = 'Открыт период по заявке %1: отсечка %2, окончание %3'"),
			ДокументСсылка,
			Формат(Отсечка, "ДЛФ=D"),
			Формат(ДатаОкончания, "ДЛФ=D")),
		ДокументСсылка);
	
КонецПроцедуры

// Немедленный возврат границы по заявке (команда «Закрыть период досрочно»).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.нп_ЗаявкаНаОткрытиеПериода
//
Процедура ЗакрытьПериодДосрочно(ДокументСсылка) Экспорт
	
	Если Не ЭтоПолноправныйПользовательСеанса() Тогда
		ВызватьИсключение НСтр("ru = 'Досрочное закрытие периода доступно только полноправному пользователю.'");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Состояние.Пользователь КАК Пользователь,
		|	Состояние.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Состояние.ДатаЗапретаДоОткрытия КАК ДатаЗапретаДоОткрытия,
		|	Состояние.ЗаписьБылаУстановленаАвтоматически КАК ЗаписьБылаУстановленаАвтоматически
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ЗаявкаНаОткрытиеПериода = &Заявка");
	Запрос.УстановитьПараметр("Заявка", ДокументСсылка);
	ТаблицаСостояний = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаСостояний.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет действующего открытого периода по этой заявке (возможно, период уже закрыт или заявкой-основанием является другая заявка).'");
	КонецЕсли;
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		АдресатыЗакрытия = Новый Соответствие;
		Для Каждого СтрокаСостояния Из ТаблицаСостояний Цикл
			АдресатыЗакрытия.Вставить(СтрокаСостояния.Пользователь, Истина);
			ВосстановитьТиповуюЗапись(
				СтрокаСостояния.РазделДатыЗапрета,
				СтрокаСостояния.ОбъектДатыЗапрета,
				СтрокаСостояния.Пользователь,
				СтрокаСостояния.ДатаЗапретаДоОткрытия,
				СтрокаСостояния.ЗаписьБылаУстановленаАвтоматически);
			УдалитьСостояние(
				СтрокаСостояния.РазделДатыЗапрета,
				СтрокаСостояния.ОбъектДатыЗапрета,
				СтрокаСостояния.Пользователь);
		КонецЦикла;
		АктуализироватьНаследованиеПослеЗакрытия(АдресатыЗакрытия);
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(НСтр("ru = 'Период по заявке %1 закрыт досрочно'"), ДокументСсылка),
		ДокументСсылка);
	
КонецПроцедуры

// Абсолютная дата запрета: текущий день минус N календарных дней, включая текущий.
//
// Параметры:
//  ЧислоДней - Число
//  ДатаРасчета - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаЗапретаПоЧислуДней(ЧислоДней, ДатаРасчета) Экспорт
	
	Возврат НачалоДня(ДатаРасчета) - ЧислоДней * 86400;
	
КонецФункции

// Дата-заглушка типовой относительной записи БСП.
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаЗаглушкиОтносительнойДаты() Экспорт
	
	Возврат '39990202';
	
КонецФункции

// Внутреннее описание БСП: вариант + перевод строки + дни разрешения.
//
// Параметры:
//  ВариантОписания - Строка
//  КоличествоДнейРазрешения - Число
//
// Возвращаемое значение:
//  Строка
//
Функция ТиповоеВнутреннееОписаниеДатыЗапрета(ВариантОписания, КоличествоДнейРазрешения) Экспорт
	
	Если Не ЗначениеЗаполнено(ВариантОписания) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(ВариантОписания) + Символы.ПС + Формат(КоличествоДнейРазрешения, "ЧН=0; ЧГ=0");
	
КонецФункции

// Абсолютная дата по типовому описанию БСП на дату расчёта.
//
// Параметры:
//  ВариантОписания - Строка
//  КоличествоДнейРазрешения - Число
//  ДатаРасчета - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаЗапретаПоОтносительномуОписанию(ВариантОписания, КоличествоДнейРазрешения, ДатаРасчета) Экспорт
	
	Описание = ТиповоеВнутреннееОписаниеДатыЗапрета(ВариантОписания, КоличествоДнейРазрешения);
	Если Не ЗначениеЗаполнено(Описание) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Возврат НачалоДня(ДатыЗапретаИзмененияСлужебный.ДатаЗапретаПоОписанию(
		Описание,
		ДатаЗаглушкиОтносительнойДаты(),
		НачалоДня(ДатаРасчета)));
	
КонецФункции

// Одна абсолютная дата комбинированного правила: максимум скользящей и относительной.
//
// Параметры:
//  ЧислоДней - Число
//  ВариантОписания - Строка
//  КоличествоДнейРазрешения - Число
//  ДатаРасчета - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция КомбинированнаяАбсолютнаяДатаЗапрета(ЧислоДней, ВариантОписания, КоличествоДнейРазрешения, ДатаРасчета) Экспорт
	
	Возврат Макс(
		ДатаЗапретаПоЧислуДней(ЧислоДней, ДатаРасчета),
		ДатаЗапретаПоОтносительномуОписанию(ВариантОписания, КоличествоДнейРазрешения, ДатаРасчета));
	
КонецФункции

// Истина, если текущему пользователю видна таблица разделов заявки.
// Полноправный видит таблицу без маркерной роли.
//
Функция ДоступнаДетализацияЗаявки() Экспорт
	
	Если ЭтоПолноправныйПользовательСеанса() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат РольДоступна("нп_УказаниеРазделовИОбъектовЗаявки");
	
КонецФункции

// Истина, если раздел из 18 организационных.
//
Функция ЭтоОрганизационныйРаздел(РазделДатыЗапрета) Экспорт
	
	ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
	Возврат ЗначениеЗаполнено(ИмяРаздела) И ИменаРазделовДляТипаОбъекта(Тип("СправочникСсылка.Организации")).Найти(ИмяРаздела) <> Неопределено;
	
КонецФункции

// Истина, если раздел смотрит свой объект, а не организацию.
//
Функция ЭтоРазделБезОрганизации(РазделДатыЗапрета) Экспорт
	
	ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
	Возврат ИменаРазделовБезОрганизации().Найти(ИмяРаздела) <> Неопределено;
	
КонецФункции

// Текст справа от раздела на форме настройки и в строке заявки.
//
Функция ТекстОписанияРаздела(РазделДатыЗапрета, ОрганизацияЗаполнена) Экспорт
	
	Если Не ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Если ОрганизацияЗаполнена Тогда
			Возврат НСтр("ru = 'Закроет организационные разделы этой организации: продажи, бухучёт, закупки и остальные. Документы банка и кассы тоже закроются — при проведении их проверяет бухучёт. Склад и сценарии этим не закроются: для них выберите свой раздел или «Разделы без организации». Отдельная настройка по одному разделу этой организации перекроет этот раздел.'");
		КонецЕсли;
		Возврат НСтр("ru = 'Закроет все разделы и все объекты, в том числе банк, кассу и другие организации. Чтобы закрыть только банк, кассу, склад и сценарии, включите «Разделы без организации».'");
	КонецЕсли;
	
	Возврат ТекстДокументовРаздела(ИмяРазделаПоСсылке(РазделДатыЗапрета));
	
КонецФункции

// Текст, если включена настройка разделов без организации.
//
Функция ТекстОписанияВсехРазделовБезОрганизации() Экспорт
	
	Возврат НСтр("ru = 'Закроет банк, кассу, склад и сценарии всех организаций — общая дата каждого раздела. Продажи, бухучёт и остальные разделы организации не закроются.'");
	
КонецФункции

// Истина, если адресат — предопределённая группа «Все пользователи», а не «для всех».
//
Функция ЭтоГруппаВсеПользователи(Адресат) Экспорт
	
	Возврат ТипЗнч(Адресат) = Тип("СправочникСсылка.ГруппыПользователей")
		И Адресат = Справочники.ГруппыПользователей.ВсеПользователи;
	
КонецФункции

// Подсказка, если в поле выбрали группу «Все пользователи».
//
Функция ТекстОписанияГруппыВсеПользователи() Экспорт
	
	Возврат НСтр("ru = 'Это группа, а не правило «для всех пользователей». Она конкурирует с другими группами: выиграет одна целиком (по комментарию). Чтобы задать правило для всех, очистите поле «Пользователь» и оставьте его пустым — задание само запишет типовое «Для всех пользователей». Эту группу и перечисление «Виды назначения дат запрета» выбирать не нужно.'");
	
КонецФункции

// Подсказка, если пользователь в настройке пуст или выбран тип «для всех».
//
Функция ТекстОписанияДляВсехПользователейНастройки() Экспорт
	
	Возврат НСтр("ru = 'Пустое поле — правильный вариант «для всех пользователей». Задание запишет типовое правило для всех. Группу «Все пользователи» и перечисление «Виды назначения дат запрета» не выбирайте.'");
	
КонецФункции

// Истина, если адресат — типовое «для всех» или пустое поле настройки.
//
Функция ЭтоДляВсехПользователей(Адресат) Экспорт
	
	Если Не ЗначениеЗаполнено(Адресат) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ТипЗнч(Адресат) = Тип("ПеречислениеСсылка.ВидыНазначенияДатЗапрета")
		И Адресат = Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
	
КонецФункции

// Предупреждение, если у раздела без организации объект пуст.
//
Функция ТекстПредупрежденияПустогоОбъектаРаздела(РазделДатыЗапрета) Экспорт
	
	ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
	Если ИмяРаздела = "Банк" Тогда
		Возврат НСтр("ru = 'Без счёта закроются все банковские счета всех организаций.'");
	ИначеЕсли ИмяРаздела = "Касса" Тогда
		Возврат НСтр("ru = 'Без кассы закроются все кассы всех организаций.'");
	ИначеЕсли ИмяРаздела = "СкладскиеОперации" Тогда
		Возврат НСтр("ru = 'Без склада закроются все склады всех организаций.'");
	ИначеЕсли ИмяРаздела = "Бюджетирование" Или ИмяРаздела = "Планирование" Тогда
		Возврат НСтр("ru = 'Без сценария закроются все сценарии всех организаций.'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Заголовок поля объекта раздела.
//
Функция ЗаголовокОбъектаРаздела(РазделДатыЗапрета) Экспорт
	
	ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
	Если ИмяРаздела = "Банк" Тогда
		Возврат НСтр("ru = 'Банковский счет'");
	ИначеЕсли ИмяРаздела = "Касса" Тогда
		Возврат НСтр("ru = 'Касса'");
	ИначеЕсли ИмяРаздела = "СкладскиеОперации" Тогда
		Возврат НСтр("ru = 'Склад'");
	ИначеЕсли ИмяРаздела = "Бюджетирование" Тогда
		Возврат НСтр("ru = 'Сценарий'");
	ИначеЕсли ИмяРаздела = "Планирование" Тогда
		Возврат НСтр("ru = 'Сценарий товарного планирования'");
	КонецЕсли;
	
	Возврат НСтр("ru = 'Объект'");
	
КонецФункции

// Варианты описания как в типовой форме БСП, без «не установлена» и «произвольная дата».
//
// Возвращаемое значение:
//  СписокЗначений
//
Функция СписокОписанийДатыЗапретаБСП() Экспорт
	
	Список = Новый СписокЗначений;
	Список.Добавить("КонецПрошлогоГода", НСтр("ru = 'Конец прошлого года'"));
	Список.Добавить("КонецПрошлогоКвартала", НСтр("ru = 'Конец прошлого квартала'"));
	Список.Добавить("КонецПрошлогоМесяца", НСтр("ru = 'Конец прошлого месяца'"));
	Список.Добавить("КонецПрошлойНедели", НСтр("ru = 'Конец прошлой недели'"));
	Список.Добавить("ПредыдущийДень", НСтр("ru = 'Предыдущий день'"));
	Список.Добавить("ТекущийДень", НСтр("ru = 'Текущий день'"));
	Список.Добавить("КонецТекущейНедели", НСтр("ru = 'Конец текущей недели'"));
	Список.Добавить("КонецТекущегоМесяца", НСтр("ru = 'Конец текущего месяца'"));
	Список.Добавить("КонецТекущегоКвартала", НСтр("ru = 'Конец текущего квартала'"));
	Список.Добавить("КонецТекущегоГода", НСтр("ru = 'Конец текущего года'"));
	Возврат Список;
	
КонецФункции

// Возвращает Истина, если заявка согласована в ДО 3.
//
Функция ДокументСогласован(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Состояние = СостояниеСогласованияДО(ДокументСсылка);
	Возврат Состояние.Состояние = Перечисления.СостоянияСогласованияВДокументообороте.Согласован;
	
КонецФункции

// Возвращает Истина, если заявку нельзя менять. Защищённое окно как у контроля
// проведения по ДО: есть связь с ДО и состояние ещё не «Не согласован»
// (пустое / НаСогласовании / Согласован) — закрывает паузу, пока статус из обмена
// не прогрузился в ERP. После «Не согласован» правку снова можно.
//
Функция ИзменениеЗаявкиЗапрещено(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЕстьДействующееСостояниеПоЗаявке(ДокументСсылка) Тогда
		Возврат Истина;
	КонецЕсли;
	
	СостояниеДО = СостояниеСогласованияДО(ДокументСсылка);
	Если Не СостояниеДО.ЕстьСвязьСДО Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СостояниеДО.Состояние <> Перечисления.СостоянияСогласованияВДокументообороте.НеСогласован;
	
КонецФункции

// Текст исключения при попытке изменить заявку, связанную с ДО или согласованную.
//
Функция ТекстЗапретаИзмененияЗаявки(ДокументСсылка) Экспорт
	
	Если ДокументСогласован(ДокументСсылка)
		Или ЕстьДействующееСостояниеПоЗаявке(ДокументСсылка) Тогда
		Возврат НСтр("ru = 'Согласованную заявку изменять нельзя. Чтобы изменить параметры, закройте период досрочно и создайте новую заявку.'");
	КонецЕсли;
	
	Возврат НСтр("ru = 'Заявку, отправленную в Документооборот, изменять нельзя. Иначе согласующие утвердят уже неактуальные данные. Дождитесь решения или отзовите обработку в Документообороте.'");
	
КонецФункции

// Возвращает Истина, если по заявке есть строки регистра состояния.
//
Функция ЕстьДействующееСостояниеПоЗаявке(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьЗапись
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ЗаявкаНаОткрытиеПериода = &Заявка");
	Запрос.УстановитьПараметр("Заявка", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Текст постоянного пояснения на форме заявки.
//
Функция ТекстПоясненияЗаявки() Экспорт
	
	Возврат НСтр("ru = 'Согласованная заявка разрешает менять документы с даты «Открыть период с» и более поздние. Срок — столько дней, сколько указано. Когда срок закончится, запрет вернётся сам.'");
	
КонецФункции

// Состояние согласования объекта в ДО по типовым регистрам (без веб-вызова).
//
Функция СостояниеСогласованияДО(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьСвязьСДО", Ложь);
	Результат.Вставить("Состояние", Неопределено);
	Результат.Вставить("Представление", НСтр("ru = 'Нет связи с Документооборотом'"));
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО КАК ИдентификаторОбъектаДО,
		|	СостоянияСогласованияВДокументообороте.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированныеС1СДокументооборотом
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСогласованияВДокументообороте КАК СостоянияСогласованияВДокументообороте
		|		ПО ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО = СостоянияСогласованияВДокументообороте.ИдентификаторОбъектаДО
		|ГДЕ
		|	ОбъектыИнтегрированныеС1СДокументооборотом.Объект = &СсылкаНаОбъект");
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЕстьСвязьСДО = Истина;
	Результат.Состояние = Выборка.Состояние;
	
	Если Не ЗначениеЗаполнено(Выборка.Состояние) Тогда
		Результат.Представление = НСтр("ru = 'Связан с ДО, состояние не задано'");
	Иначе
		Результат.Представление = Строка(Выборка.Состояние);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Представления статуса согласования ДО для строк списка заявки.
//
Функция ПредставленияСостоянийСогласованияДО(СсылкиНаОбъекты) Экспорт
	
	Результат = Новый Соответствие;
	ПустоеПредставление = НСтр("ru = 'Нет связи с Документооборотом'");
	
	Если ТипЗнч(СсылкиНаОбъекты) <> Тип("Массив") Или СсылкиНаОбъекты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СсылкаНаОбъект Из СсылкиНаОбъекты Цикл
		Результат.Вставить(СсылкаНаОбъект, ПустоеПредставление);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ОбъектыИнтегрированныеС1СДокументооборотом.Объект КАК Объект,
		|	СостоянияСогласованияВДокументообороте.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированныеС1СДокументооборотом
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСогласованияВДокументообороте КАК СостоянияСогласованияВДокументообороте
		|		ПО ОбъектыИнтегрированныеС1СДокументооборотом.ИдентификаторОбъектаДО = СостоянияСогласованияВДокументообороте.ИдентификаторОбъектаДО
		|ГДЕ
		|	ОбъектыИнтегрированныеС1СДокументооборотом.Объект В (&СсылкиНаОбъекты)");
	Запрос.УстановитьПараметр("СсылкиНаОбъекты", СсылкиНаОбъекты);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Состояние) Тогда
			Результат.Вставить(Выборка.Объект, НСтр("ru = 'Связан с ДО, состояние не задано'"));
		Иначе
			Результат.Вставить(Выборка.Объект, Строка(Выборка.Состояние));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет запись регистра настроек: несовместимые типы объекта и раздела.
// Пустые объект и раздел одновременно допустимы: общая дата адресата в типовом РС.
// Организация вместе с Банком / кассой / складом / сценарием недопустима.
//
Процедура ПроверитьЗаписьНастройки(ОбъектДатыЗапрета, РазделДатыЗапрета, ВсеРазделыБезОрганизации = Ложь) Экспорт
	
	Если ВсеРазделыБезОрганизации Тогда
		Если ЗначениеЗаполнено(ОбъектДатыЗапрета) Или ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
			ВызватьИсключение НСтр("ru = 'Для разделов без организации очистите организацию, раздел и объект.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РазделДатыЗапрета) И Не ЗначениеЗаполнено(ИмяРазделаПоСсылке(РазделДатыЗапрета)) Тогда
		ВызватьИсключение НСтр("ru = 'Указанный раздел не входит в закрытый перечень доработки.'");
	КонецЕсли;
	
	Если ЭтоРазделБезОрганизации(РазделДатыЗапрета)
		И ТипЗнч(ОбъектДатыЗапрета) = Тип("СправочникСсылка.Организации")
		И ЗначениеЗаполнено(ОбъектДатыЗапрета) Тогда
		ВызватьИсключение НСтр("ru = 'Нельзя сочетать организацию с разделом Банк, касса, склад или сценарий. Выберите счёт, кассу, склад или сценарий либо очистите организацию.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ИменаРазделов = ИменаРазделовДляТипаОбъекта(ТипЗнч(ОбъектДатыЗапрета));
		ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
		Если ИменаРазделов.Найти(ИмяРаздела) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Раздел «%1» недопустим для типа объекта «%2».'"),
				Строка(РазделДатыЗапрета),
				Строка(ТипЗнч(ОбъектДатыЗапрета)));
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета)
		И Не ЗначениеЗаполнено(РазделДатыЗапрета)
		И ТипЗнч(ОбъектДатыЗапрета) <> Тип("СправочникСсылка.Организации") Тогда
		ВызватьИсключение НСтр("ru = 'Для кассы, склада, счёта или сценария сначала выберите раздел. Без раздела объект можно задать только как организацию.'");
	КонецЕсли;
	
КонецПроцедуры

// Проверяет способ расчёта настройки.
//
Процедура ПроверитьСпособРасчетаНастройки(СпособРасчета, ЧислоДней, ОписаниеДатыЗапрета) Экспорт
	
	Если Не ЗначениеЗаполнено(СпособРасчета)
		Или СпособРасчета = Перечисления.нп_СпособыРасчетаДатыЗапрета.СкользящееОкно Тогда
		Если ЧислоДней < 0 Тогда
			ВызватьИсключение НСтр("ru = 'Число дней не может быть отрицательным.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СпособРасчета = Перечисления.нп_СпособыРасчетаДатыЗапрета.ОтносительнаяДата Тогда
		Если Не ЗначениеЗаполнено(ОписаниеДатыЗапрета) Тогда
			ВызватьИсключение НСтр("ru = 'Для относительной даты выберите описание, как в типовой форме дат запрета.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СпособРасчета = Перечисления.нп_СпособыРасчетаДатыЗапрета.Комбинированная Тогда
		Если Не ЗначениеЗаполнено(ОписаниеДатыЗапрета) Тогда
			ВызватьИсключение НСтр("ru = 'Для комбинированного правила задайте относительное описание и число дней скользящего окна.'");
		КонецЕсли;
		Если ЧислоДней < 0 Тогда
			ВызватьИсключение НСтр("ru = 'Число дней не может быть отрицательным.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Значения полей после очистки реквизитов, которые выбранный способ не использует.
// Относительная дата обнуляет число дней скользящего окна.
// Скользящее окно (и пустой способ) очищает описание и дни разрешения.
// Комбинированный способ все поля оставляет.
//
// Параметры:
//  СпособРасчета - ПеречислениеСсылка.нп_СпособыРасчетаДатыЗапрета
//  ЧислоДней - Число
//  ОписаниеДатыЗапрета - Строка
//  КоличествоДнейРазрешения - Число
//
// Возвращаемое значение:
//  Структура:
//   * ЧислоДней - Число
//   * ОписаниеДатыЗапрета - Строка
//   * КоличествоДнейРазрешения - Число
//
Функция ОчищенныеПоляСпособаРасчета(СпособРасчета, ЧислоДней, ОписаниеДатыЗапрета, КоличествоДнейРазрешения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЧислоДней", ЧислоДней);
	Результат.Вставить("ОписаниеДатыЗапрета", ОписаниеДатыЗапрета);
	Результат.Вставить("КоличествоДнейРазрешения", КоличествоДнейРазрешения);
	
	Если СпособРасчета = Перечисления.нп_СпособыРасчетаДатыЗапрета.ОтносительнаяДата Тогда
		Результат.ЧислоДней = 0;
		Возврат Результат;
	КонецЕсли;
	
	Если СпособРасчета = Перечисления.нп_СпособыРасчетаДатыЗапрета.Комбинированная Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ОписаниеДатыЗапрета = "";
	Результат.КоличествоДнейРазрешения = 0;
	Возврат Результат;
	
КонецФункции

// Очищает у записи настройки поля, которые выбранный способ расчёта не использует.
//
// Параметры:
//  ЗаписьНастройки - РегистрСведенийЗапись.нп_НастройкиАвтоматическойУстановкиДатЗапрета
//
Процедура ОчиститьНеиспользуемыеПоляСпособаРасчета(ЗаписьНастройки) Экспорт
	
	ОчищенныеПоля = ОчищенныеПоляСпособаРасчета(
		ЗаписьНастройки.СпособРасчета,
		ЗаписьНастройки.ЧислоДней,
		ЗаписьНастройки.ОписаниеДатыЗапрета,
		ЗаписьНастройки.КоличествоДнейРазрешения);
	ЗаписьНастройки.ЧислоДней = ОчищенныеПоля.ЧислоДней;
	ЗаписьНастройки.ОписаниеДатыЗапрета = ОчищенныеПоля.ОписаниеДатыЗапрета;
	ЗаписьНастройки.КоличествоДнейРазрешения = ОчищенныеПоля.КоличествоДнейРазрешения;
	
КонецПроцедуры

// Проверяет реквизиты заявки перед записью.
// Пользователь и организация обязательны. Без таблицы разделов — общая дата адресата.
//
Процедура ПроверитьЗаявкуПередЗаписью(ДокументОбъект) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь (или группа пользователей) обязателен. Заявка открывает период только для указанного адресата, не «для всех».'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена организация.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ПериодС) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен реквизит «Открыть период с».'");
	КонецЕсли;
	
	Если ДокументОбъект.СрокДействия < 1 Тогда
		ВызватьИсключение НСтр("ru = 'Срок действия должен быть не меньше 1 дня.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ПричинаОткрытия) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена причина открытия периода.'");
	КонецЕсли;
	
	Если Не ДоступнаДетализацияЗаявки() Тогда
		ДокументОбъект.Объекты.Очистить();
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаОбъекта Из ДокументОбъект.Объекты Цикл
		Если Не ЗначениеЗаполнено(СтрокаОбъекта.РазделДатыЗапрета)
			И Не ЗначениеЗаполнено(СтрокаОбъекта.ОбъектДатыЗапрета) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаОбъекта.РазделДатыЗапрета) Тогда
			ВызватьИсключение НСтр("ru = 'В строке таблицы сначала выберите раздел.'");
		КонецЕсли;
		Если ЭтоОрганизационныйРаздел(СтрокаОбъекта.РазделДатыЗапрета) Тогда
			СтрокаОбъекта.ОбъектДатыЗапрета = Неопределено;
			ПроверитьЗаписьНастройки(ДокументОбъект.Организация, СтрокаОбъекта.РазделДатыЗапрета);
		Иначе
			ПроверитьЗаписьНастройки(СтрокаОбъекта.ОбъектДатыЗапрета, СтрокаОбъекта.РазделДатыЗапрета);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Истина, если текущий пользователь полноправный.
//
Функция ЭтоПолноправныйПользовательСеанса() Экспорт
	
	Возврат Пользователи.ЭтоПолноправныйПользователь();
	
КонецФункции

// Ссылки разделов закрытого перечня для списка выбора на форме.
//
Функция СсылкиРазделовДляВыбора(ТолькоОрганизационные) Экспорт
	
	Результат = Новый Массив;
	Если ТолькоОрганизационные Тогда
		Имена = ИменаРазделовДляТипаОбъекта(Тип("СправочникСсылка.Организации"));
	Иначе
		Имена = ВсеИменаРазделов();
	КонецЕсли;
	
	Для Каждого ИмяРаздела Из Имена Цикл
		СсылкаРаздела = СсылкаРазделаПоИмени(ИмяРаздела);
		Если ЗначениеЗаполнено(СсылкаРаздела) Тогда
			Результат.Добавить(СсылкаРаздела);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ограничение типа объекта по разделу. Пустое — у раздела нет своего уточнения.
//
Функция ОписаниеТипаОбъектаРаздела(РазделДатыЗапрета) Экспорт
	
	ИмяРаздела = ИмяРазделаПоСсылке(РазделДатыЗапрета);
	Если ИмяРаздела = "Банк" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчетаОрганизаций");
	ИначеЕсли ИмяРаздела = "Касса" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.Кассы");
	ИначеЕсли ИмяРаздела = "СкладскиеОперации" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.Склады");
	ИначеЕсли ИмяРаздела = "Бюджетирование" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.Сценарии");
	ИначеЕсли ИмяРаздела = "Планирование" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.СценарииТоварногоПланирования");
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВосстановитьИстекшиеОткрытыеПериоды(Ошибки)
	
	ДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Состояние.Пользователь КАК Пользователь,
		|	Состояние.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Состояние.ДатаЗапретаДоОткрытия КАК ДатаЗапретаДоОткрытия,
		|	Состояние.ЗаписьБылаУстановленаАвтоматически КАК ЗаписьБылаУстановленаАвтоматически,
		|	Состояние.ЗаявкаНаОткрытиеПериода КАК ЗаявкаНаОткрытиеПериода,
		|	Состояние.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние
		|ГДЕ
		|	Состояние.ДатаОкончанияДействия < &ДатаСеанса");
	Запрос.УстановитьПараметр("ДатаСеанса", ДатаСеанса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		Пока Выборка.Следующий() Цикл
			Попытка
				ВосстановитьТиповуюЗапись(
					Выборка.РазделДатыЗапрета,
					Выборка.ОбъектДатыЗапрета,
					Выборка.Пользователь,
					Выборка.ДатаЗапретаДоОткрытия,
					Выборка.ЗаписьБылаУстановленаАвтоматически);
				УдалитьСостояние(
					Выборка.РазделДатыЗапрета,
					Выборка.ОбъектДатыЗапрета,
					Выборка.Пользователь);
				ЗаписатьВЖурнал(
					УровеньЖурналаРегистрации.Информация,
					СтрШаблон(
						НСтр("ru = 'Возвращена граница: раздел %1, объект %2, пользователь %3, заявка %4'"),
						Выборка.РазделДатыЗапрета,
						Выборка.ОбъектДатыЗапрета,
						Выборка.Пользователь,
						Выборка.ЗаявкаНаОткрытиеПериода),
					Выборка.ЗаявкаНаОткрытиеПериода);
			Исключение
				Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
					СтрШаблон(
						НСтр("ru = 'Возврат границы: объект %1, раздел %2, пользователь %3'"),
						Выборка.ОбъектДатыЗапрета,
						Выборка.РазделДатыЗапрета,
						Выборка.Пользователь),
					ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
КонецПроцедуры

Процедура ПрименитьВключенныеНастройки(Ошибки)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Настройки.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Настройки.Пользователь КАК Пользователь,
		|	Настройки.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Настройки.ЧислоДней КАК ЧислоДней,
		|	Настройки.СпособРасчета КАК СпособРасчета,
		|	Настройки.ОписаниеДатыЗапрета КАК ОписаниеДатыЗапрета,
		|	Настройки.КоличествоДнейРазрешения КАК КоличествоДнейРазрешения,
		|	Настройки.ВсеРазделыБезОрганизации КАК ВсеРазделыБезОрганизации
		|ИЗ
		|	РегистрСведений.нп_НастройкиАвтоматическойУстановкиДатЗапрета КАК Настройки
		|ГДЕ
		|	Настройки.Включено");
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДатаСеанса = ТекущаяДатаСеанса();
	АктуальныеКлючи = Новый Соответствие;
	ДетальныеАдресаты = Новый Соответствие;
	Кандидаты = Новый Соответствие;
	ОшибокНастроек = 0;
	
	ПроверкаБылаОтключена = НачатьЗаписьТиповогоРегистра();
	Попытка
		Пока Выборка.Следующий() Цикл
			Попытка
				СобратьКандидатовНастройки(Выборка, ДатаСеанса, Кандидаты);
			Исключение
				ОшибокНастроек = ОшибокНастроек + 1;
				Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
					СтрШаблон(
						НСтр("ru = 'Настройка: объект %1, раздел %2, пользователь %3, N=%4'"),
						Выборка.ОбъектДатыЗапрета,
						Выборка.РазделДатыЗапрета,
						Выборка.Пользователь,
						Выборка.ЧислоДней),
					ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		Для Каждого КлючИКандидат Из Кандидаты Цикл
			Попытка
				ЗаписатьКандидатаТиповойЗаписи(КлючИКандидат.Значение, АктуальныеКлючи, ДетальныеАдресаты);
			Исключение
				ОшибокНастроек = ОшибокНастроек + 1;
				Ошибки.Добавить(КраткоеИПодробноеОписаниеОшибки(
					КлючИКандидат.Значение.ПредставлениеНастройки,
					ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ДополнитьДетальнымиАдресатамиОткрытыхПериодов(ДетальныеАдресаты);
		ДополнитьОбщиеДатыДетальнымАдресатам(АктуальныеКлючи, ДетальныеАдресаты);
		Если ОшибокНастроек = 0 Тогда
			УдалитьУстаревшиеАвтозаписи(АктуальныеКлючи);
		КонецЕсли;
		ДатыЗапретаИзмененияСлужебный.ОбновитьВерсиюДатЗапретаИзменения();
	Исключение
		ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
		ВызватьИсключение;
	КонецПопытки;
	ЗакончитьЗаписьТиповогоРегистра(ПроверкаБылаОтключена);
	
КонецПроцедуры

Процедура СобратьКандидатовНастройки(Настройка, ДатаСеанса, Кандидаты)
	
	ПроверитьЗаписьНастройки(
		Настройка.ОбъектДатыЗапрета,
		Настройка.РазделДатыЗапрета,
		Настройка.ВсеРазделыБезОрганизации);
	ПроверитьСпособРасчетаНастройки(
		Настройка.СпособРасчета,
		Настройка.ЧислоДней,
		Настройка.ОписаниеДатыЗапрета);
	
	Комбинации = РазвернутыеКомбинацииНастройки(
		Настройка.ОбъектДатыЗапрета,
		Настройка.РазделДатыЗапрета,
		Настройка.ВсеРазделыБезОрганизации);
	Адресат = КаноническийПользователь(Настройка.Пользователь);
	ПараметрыЗаписи = ПараметрыЗаписиПоСпособуРасчета(Настройка, ДатаСеанса, Адресат);
	ПредставлениеНастройки = СтрШаблон(
		НСтр("ru = 'Настройка: объект %1, раздел %2, пользователь %3, N=%4'"),
		Настройка.ОбъектДатыЗапрета,
		Настройка.РазделДатыЗапрета,
		Настройка.Пользователь,
		Настройка.ЧислоДней);
	
	Для Каждого Комбинация Из Комбинации Цикл
		УчестьКандидатаТиповойЗаписи(Кандидаты, Комбинация, Адресат, ПараметрыЗаписи, ПредставлениеНастройки);
	КонецЦикла;
	
КонецПроцедуры

// Если две настройки разворачиваются в один ключ типового РС, пишет более конкретную.
// Организация без раздела (18 записей) уступает организации + одному разделу.
// Раздел без объекта уступает разделу + объекту. Флажок «разделы без организации» уступает явному разделу Банк/касса/склад.
// При равной конкретности остаётся первая собранная настройка.
//
Процедура УчестьКандидатаТиповойЗаписи(Кандидаты, Комбинация, Адресат, ПараметрыЗаписи, ПредставлениеНастройки)
	
	Ключ = КлючТиповойЗаписи(Комбинация.Раздел, Комбинация.Объект, Адресат);
	Текущий = Кандидаты.Получить(Ключ);
	Если Текущий <> Неопределено И Текущий.Ранг >= Комбинация.Ранг Тогда
		Возврат;
	КонецЕсли;
	
	Кандидат = Новый Структура;
	Кандидат.Вставить("Ранг", Комбинация.Ранг);
	Кандидат.Вставить("Раздел", Комбинация.Раздел);
	Кандидат.Вставить("Объект", Комбинация.Объект);
	Кандидат.Вставить("Адресат", Адресат);
	Кандидат.Вставить("ДатаЗапрета", ПараметрыЗаписи.ДатаЗапрета);
	Кандидат.Вставить("Комментарий", ПараметрыЗаписи.Комментарий);
	Кандидат.Вставить("ОписаниеДатыЗапрета", ПараметрыЗаписи.ОписаниеДатыЗапрета);
	Кандидат.Вставить("ПредставлениеНастройки", ПредставлениеНастройки);
	Кандидаты.Вставить(Ключ, Кандидат);
	
КонецПроцедуры

Процедура ЗаписатьКандидатаТиповойЗаписи(Кандидат, АктуальныеКлючи, ДетальныеАдресаты)
	
	АктуальныеКлючи.Вставить(КлючТиповойЗаписи(Кандидат.Раздел, Кандидат.Объект, Кандидат.Адресат), Истина);
	ОтметитьДетальногоАдресата(Кандидат.Адресат, Кандидат.Раздел, Кандидат.Объект, ДетальныеАдресаты);
	Если ЕстьДействующееСостояниеКомбинации(Кандидат.Раздел, Кандидат.Объект, Кандидат.Адресат) Тогда
		Возврат;
	КонецЕсли;
	ТекущаяТиповая = ПрочитатьТиповуюЗапись(Кандидат.Раздел, Кандидат.Объект, Кандидат.Адресат);
	Если ТекущаяТиповая.ЕстьЗапись И ЭтоРучнаяТиповаяЗапись(ТекущаяТиповая.Комментарий) Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьТиповуюДатуЗапрета(
		Кандидат.Раздел,
		Кандидат.Объект,
		Кандидат.Адресат,
		Кандидат.ДатаЗапрета,
		Кандидат.Комментарий,
		Кандидат.ОписаниеДатыЗапрета);
	
КонецПроцедуры

Функция ПараметрыЗаписиПоСпособуРасчета(Настройка, ДатаСеанса, Адресат)
	
	Результат = Новый Структура("ДатаЗапрета, ОписаниеДатыЗапрета, Комментарий");
	СпособРасчета = Настройка.СпособРасчета;
	
	Если СпособРасчета = Перечисления.нп_СпособыРасчетаДатыЗапрета.ОтносительнаяДата Тогда
		Результат.ДатаЗапрета = ДатаЗаглушкиОтносительнойДаты();
		Результат.ОписаниеДатыЗапрета = ТиповоеВнутреннееОписаниеДатыЗапрета(
			Настройка.ОписаниеДатыЗапрета,
			Настройка.КоличествоДнейРазрешения);
		Результат.Комментарий = КомментарийАвтозаписи(Адресат, Настройка.КоличествоДнейРазрешения);
		Возврат Результат;
	КонецЕсли;
	
	Если СпособРасчета = Перечисления.нп_СпособыРасчетаДатыЗапрета.Комбинированная Тогда
		Результат.ДатаЗапрета = КомбинированнаяАбсолютнаяДатаЗапрета(
			Настройка.ЧислоДней,
			Настройка.ОписаниеДатыЗапрета,
			Настройка.КоличествоДнейРазрешения,
			ДатаСеанса);
		Результат.ОписаниеДатыЗапрета = "";
		Результат.Комментарий = КомментарийАвтозаписи(Адресат, Настройка.ЧислоДней);
		Возврат Результат;
	КонецЕсли;
	
	Результат.ДатаЗапрета = ДатаЗапретаПоЧислуДней(Настройка.ЧислоДней, ДатаСеанса);
	Результат.ОписаниеДатыЗапрета = "";
	Результат.Комментарий = КомментарийАвтозаписи(Адресат, Настройка.ЧислоДней);
	Возврат Результат;
	
КонецФункции

// БСП выбирает адресата целиком: личная детальная запись отключает набор
// группы и «для всех». Чтобы остальные комбинации остались как до этой записи
// (в том числе склад группы «Продажи», а не только пустая пара),
// на адресата копируется полный набор родителя (выигрывающая группа или «для всех»),
// кроме комбинаций, которые у него уже есть из своих настроек.
// Детальные адресаты — из включённых настроек этого прогона и из действующих
// открытых периодов (заявка тоже пишет личную запись). Иначе удалённая касса
// или закрытое открытие ещё лежит в типовом РС, родитель копируется снова,
// и унаследованные записи снимаются только на следующем задании.
//
Процедура ДополнитьОбщиеДатыДетальнымАдресатам(АктуальныеКлючи, ДетальныеАдресаты)
	
	ПустойРаздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
	ДляВсех = Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
	
	Записи = ВсеЗаписиТиповогоРегистра();
	Наборы = НаборыЗаписейПоАдресатам(Записи, АктуальныеКлючи);
	ВыигрывающиеГруппы = ВыигрывающиеГруппыПользователей();
	
	Для Каждого Адресат Из АдресатыГрупп(ДетальныеАдресаты) Цикл
		Если НельзяНаследоватьНаборРодителя(Адресат, ПустойРаздел, АктуальныеКлючи) Тогда
			Продолжить;
		КонецЕсли;
		СкопироватьНаборРодителяНаАдресата(
			Адресат,
			ДляВсех,
			Наборы,
			АктуальныеКлючи,
			МаксимальныйАвтоКомментарийАдресата(Записи, Адресат));
	КонецЦикла;
	
	Для Каждого Адресат Из АдресатыПользователей(ДетальныеАдресаты) Цикл
		Если НельзяНаследоватьНаборРодителя(Адресат, ПустойРаздел, АктуальныеКлючи) Тогда
			Продолжить;
		КонецЕсли;
		Родитель = ВыигрывающиеГруппы.Получить(Адресат);
		Если Родитель = Неопределено Тогда
			Родитель = ДляВсех;
		КонецЕсли;
		СкопироватьНаборРодителяНаАдресата(
			Адресат,
			Родитель,
			Наборы,
			АктуальныеКлючи,
			ПрефиксАвтоКомментария());
	КонецЦикла;
	
КонецПроцедуры

Функция ВсеЗаписиТиповогоРегистра()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Даты.Пользователь КАК Пользователь,
		|	Даты.Раздел КАК Раздел,
		|	Даты.Объект КАК Объект,
		|	Даты.ДатаЗапрета КАК ДатаЗапрета,
		|	Даты.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК Даты");
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция НаборыЗаписейПоАдресатам(Записи, АктуальныеКлючи)
	
	Результат = Новый Соответствие;
	Для Каждого СтрокаЗаписи Из Записи Цикл
		Если ЭтоАвтоматическаяТиповаяЗапись(СтрокаЗаписи.Комментарий)
			И (АктуальныеКлючи.Получить(
				КлючТиповойЗаписи(СтрокаЗаписи.Раздел, СтрокаЗаписи.Объект, СтрокаЗаписи.Пользователь)) = Неопределено) Тогда
			Продолжить;
		КонецЕсли;
		Набор = Результат.Получить(СтрокаЗаписи.Пользователь);
		Если Набор = Неопределено Тогда
			Набор = Новый Соответствие;
			Результат.Вставить(СтрокаЗаписи.Пользователь, Набор);
		КонецЕсли;
		Набор.Вставить(
			КлючКомбинацииРазделОбъект(СтрокаЗаписи.Раздел, СтрокаЗаписи.Объект),
			Новый Структура("Раздел, Объект, ДатаЗапрета",
				СтрокаЗаписи.Раздел, СтрокаЗаписи.Объект, СтрокаЗаписи.ДатаЗапрета));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция КлючКомбинацииРазделОбъект(Раздел, Объект)
	
	Возврат XMLСтрока(Раздел) + Символы.ПС + XMLСтрока(Объект);
	
КонецФункции

Процедура ОтметитьДетальногоАдресата(Адресат, Раздел, Объект, ДетальныеАдресаты)
	
	Если Не ЗначениеЗаполнено(Раздел) И Не ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;
	ДетальныеАдресаты.Вставить(Адресат, Истина);
	
КонецПроцедуры

Процедура НаследоватьНаборРодителяПослеОткрытия(Адресат, Комбинации)
	
	Если Не ЕстьДетальнаяКомбинацияВСписке(Комбинации) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальныеКлючи = Новый Соответствие;
	ДетальныеИзНастроек = Новый Соответствие;
	ЗаполнитьКлючиВключенныхНастроек(АктуальныеКлючи, ДетальныеИзНастроек);
	Нужные = ГруппыДетальныхАдресатов(ДетальныеИзНастроек);
	Нужные.Вставить(Адресат, Истина);
	ДополнитьОбщиеДатыДетальнымАдресатам(АктуальныеКлючи, Нужные);
	
КонецПроцедуры

Процедура АктуализироватьНаследованиеПослеЗакрытия(АдресатыЗакрытия)
	
	АктуальныеКлючи = Новый Соответствие;
	Детальные = Новый Соответствие;
	ЗаполнитьКлючиВключенныхНастроек(АктуальныеКлючи, Детальные);
	ДополнитьДетальнымиАдресатамиОткрытыхПериодов(Детальные);
	Нужные = ГруппыДетальныхАдресатов(Детальные);
	Для Каждого КлючИЗначение Из АдресатыЗакрытия Цикл
		Если Детальные.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
			Нужные.Вставить(КлючИЗначение.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	ДополнитьОбщиеДатыДетальнымАдресатам(АктуальныеКлючи, Нужные);
	Для Каждого КлючИЗначение Из АдресатыЗакрытия Цикл
		УдалитьУстаревшиеАвтозаписиАдресата(АктуальныеКлючи, КлючИЗначение.Ключ);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКлючиВключенныхНастроек(АктуальныеКлючи, ДетальныеАдресаты)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Настройки.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Настройки.Пользователь КАК Пользователь,
		|	Настройки.РазделДатыЗапрета КАК РазделДатыЗапрета,
		|	Настройки.ВсеРазделыБезОрганизации КАК ВсеРазделыБезОрганизации
		|ИЗ
		|	РегистрСведений.нп_НастройкиАвтоматическойУстановкиДатЗапрета КАК Настройки
		|ГДЕ
		|	Настройки.Включено");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Комбинации = РазвернутыеКомбинацииНастройки(
				Выборка.ОбъектДатыЗапрета,
				Выборка.РазделДатыЗапрета,
				Выборка.ВсеРазделыБезОрганизации);
			Адресат = КаноническийПользователь(Выборка.Пользователь);
			Для Каждого Комбинация Из Комбинации Цикл
				АктуальныеКлючи.Вставить(КлючТиповойЗаписи(Комбинация.Раздел, Комбинация.Объект, Адресат), Истина);
				ОтметитьДетальногоАдресата(Адресат, Комбинация.Раздел, Комбинация.Объект, ДетальныеАдресаты);
			КонецЦикла;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьДетальнымиАдресатамиОткрытыхПериодов(ДетальныеАдресаты)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.Пользователь КАК Пользователь,
		|	Состояние.РазделДатыЗапрета КАК Раздел,
		|	Состояние.ОбъектДатыЗапрета КАК Объект
		|ИЗ
		|	РегистрСведений.нп_СостояниеОткрытыхПериодов КАК Состояние");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОтметитьДетальногоАдресата(Выборка.Пользователь, Выборка.Раздел, Выборка.Объект, ДетальныеАдресаты);
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьДетальнаяКомбинацияВСписке(Комбинации)
	
	Для Каждого Комбинация Из Комбинации Цикл
		Если ЗначениеЗаполнено(Комбинация.Раздел) Или ЗначениеЗаполнено(Комбинация.Объект) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция ГруппыДетальныхАдресатов(ДетальныеАдресаты)
	
	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из ДетальныеАдресаты Цикл
		Если ТипЗнч(КлючИЗначение.Ключ) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
			Результат.Вставить(КлючИЗначение.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция АдресатыГрупп(ДетальныеАдресаты)
	
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ДетальныеАдресаты Цикл
		Если ТипЗнч(КлючИЗначение.Ключ) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция АдресатыПользователей(ДетальныеАдресаты)
	
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ДетальныеАдресаты Цикл
		Если ТипЗнч(КлючИЗначение.Ключ) = Тип("СправочникСсылка.Пользователи") Тогда
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ЕстьСвояОбщаяДатаНастройки(Адресат, ПустойРаздел, АктуальныеКлючи)
	
	Возврат АктуальныеКлючи.Получить(КлючТиповойЗаписи(ПустойРаздел, ПустойРаздел, Адресат)) <> Неопределено;
	
КонецФункции

// Своя пустая пара из настроек, ручная общая дата или действующее открытие
// уже делают адресата выбранным в БСП — набор родителя до детальной записи
// не действовал, копировать его нельзя.
//
Функция НельзяНаследоватьНаборРодителя(Адресат, ПустойРаздел, АктуальныеКлючи)
	
	Если ЕстьСвояОбщаяДатаНастройки(Адресат, ПустойРаздел, АктуальныеКлючи) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекущаяТиповая = ПрочитатьТиповуюЗапись(ПустойРаздел, ПустойРаздел, Адресат);
	Если Не ТекущаяТиповая.ЕстьЗапись Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЭтоРучнаяТиповаяЗапись(ТекущаяТиповая.Комментарий)
		Или ЭтоКомментарийОткрытия(ТекущаяТиповая.Комментарий);
	
КонецФункции

Функция МаксимальныйАвтоКомментарийАдресата(Записи, Адресат)
	
	Комментарий = ПрефиксАвтоКомментария();
	Для Каждого СтрокаЗаписи Из Записи Цикл
		Если СтрокаЗаписи.Пользователь <> Адресат Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоАвтоматическаяТиповаяЗапись(СтрокаЗаписи.Комментарий) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаЗаписи.Комментарий > Комментарий Тогда
			Комментарий = СтрокаЗаписи.Комментарий;
		КонецЕсли;
	КонецЦикла;
	Возврат Комментарий;
	
КонецФункции

Функция ВыигрывающиеГруппыПользователей()
	
	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состав.Пользователь КАК Пользователь,
		|	Состав.ГруппаПользователей КАК ГруппаПользователей,
		|	Даты.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(Состав.ГруппаПользователей.Наименование, """") КАК НаименованиеГруппы
		|ИЗ
		|	РегистрСведений.СоставыГруппПользователей КАК Состав
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаИзменения КАК Даты
		|		ПО Состав.ГруппаПользователей = Даты.Пользователь
		|ГДЕ
		|	Состав.ГруппаПользователей <> Состав.Пользователь
		|
		|УПОРЯДОЧИТЬ ПО
		|	Пользователь,
		|	Комментарий УБЫВ,
		|	НаименованиеГруппы УБЫВ");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Получить(Выборка.Пользователь) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Выборка.Пользователь, Выборка.ГруппаПользователей);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура СкопироватьНаборРодителяНаАдресата(Адресат, Родитель, Наборы, АктуальныеКлючи, Комментарий)
	
	Если Адресат = Родитель Тогда
		Возврат;
	КонецЕсли;
	
	НаборРодителя = Наборы.Получить(Родитель);
	Если НаборРодителя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборАдресата = Наборы.Получить(Адресат);
	Если НаборАдресата = Неопределено Тогда
		НаборАдресата = Новый Соответствие;
		Наборы.Вставить(Адресат, НаборАдресата);
	КонецЕсли;
	
	Для Каждого КлючИЗапись Из НаборРодителя Цикл
		СтрокаРодителя = КлючИЗапись.Значение;
		КлючТиповой = КлючТиповойЗаписи(СтрокаРодителя.Раздел, СтрокаРодителя.Объект, Адресат);
		Если АктуальныеКлючи.Получить(КлючТиповой) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗаписатьНаследуемуюЗапись(
			Адресат,
			СтрокаРодителя.Раздел,
			СтрокаРодителя.Объект,
			СтрокаРодителя.ДатаЗапрета,
			Комментарий,
			АктуальныеКлючи) Тогда
			Продолжить;
		КонецЕсли;
		НаборАдресата.Вставить(КлючИЗапись.Ключ, СтрокаРодителя);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаписатьНаследуемуюЗапись(Адресат, Раздел, Объект, ДатаЗапрета, Комментарий, АктуальныеКлючи)
	
	Если ЕстьДействующееСостояниеКомбинации(Раздел, Объект, Адресат) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекущаяТиповая = ПрочитатьТиповуюЗапись(Раздел, Объект, Адресат);
	Если ТекущаяТиповая.ЕстьЗапись И ЭтоРучнаяТиповаяЗапись(ТекущаяТиповая.Комментарий) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекущаяТиповая.ЕстьЗапись И ЭтоКомментарийОткрытия(ТекущаяТиповая.Комментарий) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаписатьТиповуюДатуЗапрета(Раздел, Объект, Адресат, ДатаЗапрета, Комментарий, "");
	АктуальныеКлючи.Вставить(КлючТиповойЗаписи(Раздел, Объект, Адресат), Истина);
	Возврат Истина;
	
КонецФункции

Процедура ПрименитьОткрытиеПоКомбинации(Комбинация, Адресат, Отсечка, ДатаОкончания, ДокументСсылка)
	
	ТекущееСостояние = ПрочитатьСостояние(Комбинация.Раздел, Комбинация.Объект, Адресат);
	ТекущаяТиповая = ПрочитатьТиповуюЗапись(Комбинация.Раздел, Комбинация.Объект, Адресат);
	
	Если ТекущееСостояние = Неопределено Тогда
		ДатаДоОткрытия = ТекущаяТиповая.ДатаЗапрета;
		БылаАвто = ЭтоАвтоматическаяТиповаяЗапись(ТекущаяТиповая.Комментарий);
		ЗаписатьТиповуюДатуЗапрета(
			Комбинация.Раздел,
			Комбинация.Объект,
			Адресат,
			Отсечка,
			КомментарийОткрытия(ДокументСсылка),
			"");
		ЗаписатьСостояние(
			Комбинация.Раздел,
			Комбинация.Объект,
			Адресат,
			ДокументСсылка,
			ДатаОкончания,
			ДатаДоОткрытия,
			БылаАвто);
		Возврат;
	КонецЕсли;
	
	НоваяОтсечка = Отсечка;
	Если ЗначениеЗаполнено(ТекущаяТиповая.ДатаЗапрета) Тогда
		НоваяОтсечка = Мин(ТекущаяТиповая.ДатаЗапрета, Отсечка);
	КонецЕсли;
	НовоеОкончание = Макс(ТекущееСостояние.ДатаОкончанияДействия, ДатаОкончания);
	
	ЗаписатьТиповуюДатуЗапрета(
		Комбинация.Раздел,
		Комбинация.Объект,
		Адресат,
		НоваяОтсечка,
		КомментарийОткрытия(ТекущееСостояние.ЗаявкаНаОткрытиеПериода),
		"");
	
	ЗаписатьСостояние(
		Комбинация.Раздел,
		Комбинация.Объект,
		Адресат,
		ТекущееСостояние.ЗаявкаНаОткрытиеПериода,
		НовоеОкончание,
		ТекущееСостояние.ДатаЗапретаДоОткрытия,
		ТекущееСостояние.ЗаписьБылаУстановленаАвтоматически);
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон(
			НСтр("ru = 'Пересечение заявок: основание %1, новая %2, отсечка %3, окончание %4'"),
			ТекущееСостояние.ЗаявкаНаОткрытиеПериода,
			ДокументСсылка,
			Формат(НоваяОтсечка, "ДЛФ=D"),
			Формат(НовоеОкончание, "ДЛФ=D")),
		ДокументСсылка);
	
КонецПроцедуры

Функция РазвернутыеКомбинацииНастройки(ОбъектДатыЗапрета, РазделДатыЗапрета, ВсеРазделыБезОрганизации = Ложь)
	
	Результат = Новый Массив;
	ПроверитьЗаписьНастройки(ОбъектДатыЗапрета, РазделДатыЗапрета, ВсеРазделыБезОрганизации);
	
	Если ВсеРазделыБезОрганизации Тогда
		Для Каждого ИмяРаздела Из ИменаРазделовБезОрганизации() Цикл
			СсылкаРаздела = СсылкаРазделаПоИмени(ИмяРаздела);
			Если ЗначениеЗаполнено(СсылкаРаздела) Тогда
				ДобавитьКомбинацию(Результат, СсылкаРаздела, СсылкаРаздела, 10);
			КонецЕсли;
		КонецЦикла;
		Если Результат.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Не найдены разделы без организации: банк, касса, склад, сценарии.'");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ДобавитьКомбинацию(Результат, РазделДатыЗапрета, ОбъектДатыЗапрета, 40);
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектДатыЗапрета) И ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		ДобавитьКомбинацию(Результат, РазделДатыЗапрета, РазделДатыЗапрета, 30);
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДатыЗапрета) И Не ЗначениеЗаполнено(РазделДатыЗапрета) Тогда
		Если ТипЗнч(ОбъектДатыЗапрета) <> Тип("СправочникСсылка.Организации") Тогда
			ВызватьИсключение НСтр("ru = 'Без раздела объект может быть только организацией: тогда пишутся 18 организационных разделов.'");
		КонецЕсли;
		Для Каждого ИмяРаздела Из ИменаРазделовДляТипаОбъекта(Тип("СправочникСсылка.Организации")) Цикл
			СсылкаРаздела = СсылкаРазделаПоИмени(ИмяРаздела);
			Если ЗначениеЗаполнено(СсылкаРаздела) Тогда
				ДобавитьКомбинацию(Результат, СсылкаРаздела, ОбъектДатыЗапрета, 20);
			КонецЕсли;
		КонецЦикла;
		Если Результат.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Не найдены организационные разделы закрытого перечня.'");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	ПустойРаздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
	ДобавитьКомбинацию(Результат, ПустойРаздел, ПустойРаздел, 0);
	Возврат Результат;
	
КонецФункции

Функция РазвернутыеКомбинацииЗаявки(ДокументСсылка)
	
	Результат = Новый Массив;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация");
	ОрганизацияШапки = Реквизиты.Организация;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Объекты.ОбъектДатыЗапрета КАК ОбъектДатыЗапрета,
		|	Объекты.РазделДатыЗапрета КАК РазделДатыЗапрета
		|ИЗ
		|	Документ.нп_ЗаявкаНаОткрытиеПериода.Объекты КАК Объекты
		|ГДЕ
		|	Объекты.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	ОбъектыЗаявки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаОбъекта Из ОбъектыЗаявки Цикл
		Если Не ЗначениеЗаполнено(СтрокаОбъекта.РазделДатыЗапрета) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоОрганизационныйРаздел(СтрокаОбъекта.РазделДатыЗапрета) Тогда
			КомбинацииСтроки = РазвернутыеКомбинацииНастройки(ОрганизацияШапки, СтрокаОбъекта.РазделДатыЗапрета);
		Иначе
			КомбинацииСтроки = РазвернутыеКомбинацииНастройки(
				СтрокаОбъекта.ОбъектДатыЗапрета,
				СтрокаОбъекта.РазделДатыЗапрета);
		КонецЕсли;
		Для Каждого Комбинация Из КомбинацииСтроки Цикл
			Результат.Добавить(Комбинация);
		КонецЦикла;
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		Возврат РазвернутыеКомбинацииНастройки(Неопределено, Неопределено);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКомбинацию(МассивКомбинаций, Раздел, Объект, Ранг)
	
	Комбинация = Новый Структура("Раздел, Объект, Ранг", Раздел, Объект, Ранг);
	МассивКомбинаций.Добавить(Комбинация);
	
КонецПроцедуры

Функция КаноническийПользователь(ПользовательНастройки)
	
