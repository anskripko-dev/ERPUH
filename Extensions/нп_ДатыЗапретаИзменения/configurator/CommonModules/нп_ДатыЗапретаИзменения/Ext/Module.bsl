Процедура ЗаписатьТиповуюДатуЗапрета(Раздел, Объект, Пользователь, ДатаЗапрета, Комментарий, ОписаниеДатыЗапрета = "")
	
	НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Раздел.Установить(Раздел);
	НаборЗаписей.Отбор.Объект.Установить(Объект);
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Запись = НаборЗаписей.Добавить();
		Запись.Раздел = Раздел;
		Запись.Объект = Объект;
		Запись.Пользователь = Пользователь;
	Иначе
		Запись = НаборЗаписей[0];
		Если Запись.ДатаЗапрета = ДатаЗапрета
			И Запись.ОписаниеДатыЗапрета = ОписаниеДатыЗапрета
			И Запись.Комментарий = Комментарий Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Запись.ДатаЗапрета = ДатаЗапрета;
	Запись.ОписаниеДатыЗапрета = ОписаниеДатыЗапрета;
	Запись.Комментарий = Комментарий;
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ВосстановитьТиповуюЗапись(Раздел, Объект, Пользователь, ДатаЗапретаДоОткрытия, БылаАвто)
	
	НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Раздел.Установить(Раздел);
	НаборЗаписей.Отбор.Объект.Установить(Объект);
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	
	Если ЗначениеЗаполнено(ДатаЗапретаДоОткрытия) Тогда
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.Раздел = Раздел;
			Запись.Объект = Объект;
			Запись.Пользователь = Пользователь;
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		Запись.ДатаЗапрета = ДатаЗапретаДоОткрытия;
		Запись.ОписаниеДатыЗапрета = "";
		Если БылаАвто Тогда
			Запись.Комментарий = ПрефиксАвтоКомментария();
		ИначеЕсли ЭтоКомментарийОткрытия(Запись.Комментарий) Тогда
			Запись.Комментарий = "";
		КонецЕсли;
		НаборЗаписей.Записать();
	Иначе
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьТиповуюЗапись(Раздел, Объект, Пользователь)
	
	Результат = Новый Структура("ДатаЗапрета, Комментарий, ЕстьЗапись", '00010101', "", Ложь);
	
	НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Раздел.Установить(Раздел);
	НаборЗаписей.Отбор.Объект.Установить(Объект);
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Результат.ЕстьЗапись = Истина;
		Результат.ДатаЗапрета = НаборЗаписей[0].ДатаЗапрета;
		Результат.Комментарий = НаборЗаписей[0].Комментарий;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьСостояние(Раздел, Объект, Пользователь)
	
	МенеджерЗаписи = РегистрыСведений.нп_СостояниеОткрытыхПериодов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.РазделДатыЗапрета = Раздел;
	МенеджерЗаписи.ОбъектДатыЗапрета = Объект;
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаявкаНаОткрытиеПериода", МенеджерЗаписи.ЗаявкаНаОткрытиеПериода);
	Результат.Вставить("ДатаОкончанияДействия", МенеджерЗаписи.ДатаОкончанияДействия);
	Результат.Вставить("ДатаЗапретаДоОткрытия", МенеджерЗаписи.ДатаЗапретаДоОткрытия);
	Результат.Вставить("ЗаписьБылаУстановленаАвтоматически", МенеджерЗаписи.ЗаписьБылаУстановленаАвтоматически);
	Возврат Результат;
	
КонецФункции

Функция ЕстьДействующееСостояниеКомбинации(Раздел, Объект, Пользователь)
	
	Возврат ПрочитатьСостояние(Раздел, Объект, Пользователь) <> Неопределено;
	
